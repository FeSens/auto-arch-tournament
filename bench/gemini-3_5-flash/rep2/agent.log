k   = byte_mask;\n123: \n124:     if (!mem_access) begin\n125:       mem_wait = 1'b0;\n126:     end else if (store_slot_valid) begin\n127:       // The slot has dmem-port priority while valid. Younger memory ops wait;\n128:       // younger non-memory instructions continue through MEM/WB.\n129:       mem_wait = 1'b1;\n130:     end else if (in.ctrl.mem_read) begin\n131:       mem_wait = !dmem_ready;\n132:     end else if (in.ctrl.mem_write) begin\n133:       mem_wait = store_bufferable ? 1'b0 : !dmem_ready;\n134:     end else begin\n135:       mem_wait = 1'b0;\n136:     end\n137: \n138:     // Load extraction: shift right then sign/zero-extend the low N bits.\n139:     shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\n140:     byte_val  = shifted[7:0];\n141:     hword_val = shifted[15:0];\n142:     case (in.ctrl.mem_width)\n143:       2'd0:    load_data = in.ctrl.mem_sext\n144:                          ? {{24{byte_val[7]}},  byte_val}\n145:                          : {24'b0,              byte_val};\n146:       2'd1:    load_data = in.ctrl.mem_sext\n147:                          ? {{16{hword_val[15]}}, hword_val}\n148:                          : {16'b0,               hword_val};\n149:       default: load_data = dmem_rdata;\n150:     endcase\n151: \n152:     // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n153:     aligned_addr = mem_access\n154:                  ? {in.alu_result[31:2], 2'b00}\n155:                  : 32'b0;\n156:   end\n157: \n158:   // ── MEM/WB register ───────────────────────────────────────────────────\n159:   mem_wb_t reg_q;\n160: \n161:   always_ff @(posedge clock) begin\n162:     if (reset) begin\n163:       reg_q <= '0;\n164:     end else if (hold_wb) begin\n165:       // Clear valid (no double-retire / no double-regfile-write), but\n166:       // KEEP every other field. Forwarding from MEM/WB to a stalled\n167:       // dependent in ID/EX needs the held LOAD's rd/read_data/ctrl\n168:       // alive for as many c