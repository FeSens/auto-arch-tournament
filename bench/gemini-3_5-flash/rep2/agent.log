.flush           (flush_if),\n141:     .redirect        (redirect),\n142:     .redirect_target (redirect_target),\n143:     .imem_addr       (io_imemAddr),\n144:     .imem_data       (io_imemData),\n145:     .imem_ready      (io_imemReady),\n146:     .fetch_ready     (if_fetch_ready),\n147:     .out             (if_id_w)\n148:   );\n149: \n150:   // ── ID + regfile ──────────────────────────────────────────────────────\n151:   id_stage u_id (\n152:     .clock    (clock),\n153:     .reset    (reset),\n154:     .stall    (stall_id),\n155:     .flush    (flush_id),\n156:     .in       (if_id_w),\n157:     .rs1_addr (rs1_addr_w),\n158:     .rs2_addr (rs2_addr_w),\n159:     .rs1_data (rs1_data_w),\n160:     .rs2_data (rs2_data_w),\n161:     .out      (id_ex_w)\n162:   );\n163: \n164:   reg_file u_rf (\n165:     .clock    (clock),\n166:     .reset    (reset),\n167:     .rs1_addr (rs1_addr_w),\n168:     .rs2_addr (rs2_addr_w),\n169:     .rs1_data (rs1_data_w),\n170:     .rs2_data (rs2_data_w),\n171:     .w_en     (wb_w_en),\n172:     .w_addr   (wb_w_addr),\n173:     .w_data   (wb_w_data)\n174:   );\n175: \n176:   // ── EX ────────────────────────────────────────────────────────────────\n177:   ex_stage u_ex (\n178:     .clock           (clock),\n179:     .reset           (reset),\n180:     .stall           (stall_ex_mem),\n181:     .in              (id_ex_w),\n182:     .fwd_rs1_sel     (fwd_rs1_sel),\n183:     .fwd_rs2_sel     (fwd_rs2_sel),\n184:     .fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\n185:     .fwd_mem_wb      (wb_w_data),            // WB-stage's write-mux output\n186:     .out             (ex_mem_w),\n187:     .ex_long_busy    (ex_long_busy),\n188:     .redirect        (redirect),\n189:     .redirect_target (redirect_target)\n190:   );\n191: \n192:   // ── MEM ───────────────────────────────────────────────────────────────\n193:   store_slot u_store_slot (\n194:     .clock         (clock),\n195:     .reset         (reset),\n196:   