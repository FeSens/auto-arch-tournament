ts/hypotheses/*.yml\n87: cores/*/experiments/hypotheses/*.yaml\n88: \n89: # Editor / OS\n90: .DS_Store\n91: *.swp\n92: .idea/\n93: .vscode/\n94: \n95: # Claude Code workspace\n96: .claude/\n97: docs/assets/\n98: \n99: # Local git worktrees (subagent-driven dev; not the orchestrator's experiments/worktrees)\n100: .worktrees/\n101: \n102: # Node deps for bench-fence pi extension (installed locally for typecheck;\n103: # pi handles installs at run time so the deps don't need to be committed).\n104: node_modules/\n105: \n106: # Pi-coding-agent session storage inside per-rep clones.\n107: .pi-sessions/\n108: \n109: # Per-rep agent telemetry inside bench/ is now tracked: log.jsonl carries\n110: # the full per-iteration data (LUT4, Fmax, IPC, error class) that the\n111: # rolled-up summary.json doesn't surface, and agent.log is the model's\n112: # verbatim transcript — both are essential for reproducibility and\n113: # postmortems. Combined they're ~3-4 MB per rep × 9 reps = ~35 MB; cheap.\n114: # (Previously gitignored as \"regenerable\", but they're only regenerable\n115: # by re-running the bench at considerable wall time and cost.)\n116: \n117: # Throwaway harness-verification runs (one-model YAMLs + their output\n118: # trees). These are reliability checks, not benchmark data — output is\n119: # regenerable and the YAMLs only encode \"rerun this single model to\n120: # confirm a fix landed\". Naming convention: `*-verify` for output dirs,\n121: # `models-*-verify.yaml` for the throwaway model YAML.\n122: bench/*-verify/\n123: bench/smoke-*/\n124: tools/bench/models-*-verify.yaml\n125: \n126: # Aborted/partial bench output preserved locally with a debug-tag suffix\n127: # (e.g. `gpt-5_5.failed-pwd-bug/`, `gpt-5_5.validate-v3/`, sibling\n128: # `results.jsonl.<tag>`). They document a known-broken state for the\n129: # author's own postmortem; the canonical results live in the un-suffixed\n130: # per-model dirs.\n131: bench/*.failed-*\n132: bench/*.validate-*\n133: bench