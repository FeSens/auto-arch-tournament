:   logic        rvfi_order_carry_lo;\n287:   logic        rvfi_order_carry_mid_lo;\n288:   logic        rvfi_order_carry_mid_hi;\n289:   logic        rd_wen;\n290: \n291:   always_comb begin\n292:     rvfi_order_carry_lo     = mem_wb_w.valid && (rvfi_order_lo_q     == 16'hffff);\n293:     rvfi_order_carry_mid_lo = rvfi_order_carry_lo\n294:                            && (rvfi_order_mid_lo_q == 16'hffff);\n295:     rvfi_order_carry_mid_hi = rvfi_order_carry_mid_lo\n296:                            && (rvfi_order_mid_hi_q == 16'hffff);\n297:   end\n298: \n299:   always_ff @(posedge clock) begin\n300:     if (reset) begin\n301:       rvfi_order_lo_q     <= 16'b0;\n302:       rvfi_order_mid_lo_q <= 16'b0;\n303:       rvfi_order_mid_hi_q <= 16'b0;\n304:       rvfi_order_hi_q     <= 16'b0;\n305:     end else begin\n306:       if (mem_wb_w.valid) begin\n307:         rvfi_order_lo_q <= rvfi_order_lo_q + 16'd1;\n308:       end\n309:       if (rvfi_order_carry_lo) begin\n310:         rvfi_order_mid_lo_q <= rvfi_order_mid_lo_q + 16'd1;\n311:       end\n312:       if (rvfi_order_carry_mid_lo) begin\n313:         rvfi_order_mid_hi_q <= rvfi_order_mid_hi_q + 16'd1;\n314:       end\n315:       if (rvfi_order_carry_mid_hi) begin\n316:         rvfi_order_hi_q <= rvfi_order_hi_q + 16'd1;\n317:       end\n318:     end\n319:   end\n320: \n321:   always_comb begin\n322:     rd_wen = mem_wb_w.ctrl.reg_write && (mem_wb_w.rd != 5'b0);\n323: \n324:     // Channel 0: the only retirement channel for the single-issue baseline.\n325:     io_rvfi_valid_0     = mem_wb_w.valid;\n326:     io_rvfi_order_0     = {rvfi_order_hi_q, rvfi_order_mid_hi_q,\n327:                            rvfi_order_mid_lo_q, rvfi_order_lo_q};\n328:     io_rvfi_insn_0      = mem_wb_w.instr;\n329:     io_rvfi_trap_0      = mem_wb_w.ctrl.is_illegal;\n330:     io_rvfi_halt_0      = 1'b0;\n331:     io_rvfi_intr_0      = 1'b0;\n332:     io_rvfi_mode_0      = 2'd3;     // M-mode only\n333:     io_rvfi_ixl_0       = 2'd1;     // 32-bit ISA\n334:     io_rvfi_rs1_addr_0  = mem_wb_w.rs1_addr;\n335:     io_rvfi_rs1_rdata_0 = mem_wb_w.rs1_val;\n336:     io_rvfi_rs2_addr_0  = mem_wb_w.rs2_addr;\n337:     io_rvfi_rs2_rdata_0 = mem_wb_w.rs2_val;\n338:     io_rvfi_rd_addr_0   = rd_wen ? mem_wb_w.rd : 5'b0;\n339:     io_rvfi_rd_wdata_0  = rd_wen ? wb_w_data   : 32'b0;\n340:     io_rvfi_pc_rdata_0  = mem_wb_w.pc;\n341:     io_rvfi_pc_wdata_0  = mem_wb_w.pc_next;\n342:     io_rvfi_mem_addr_0  = mem_wb_w.mem_addr;\n343:     io_rvfi_mem_rmask_0 = mem_wb_w.mem_rmask;\n344:     io_rvfi_mem_wmask_0 = mem_wb_w.mem_wmask;\n345:     io_rvfi_mem_rdata_0 = mem_wb_w.mem_rdata;\n346:     io_rvfi_mem_wdata_0 = mem_wb_w.mem_wdata;\n347: \n348:     // Channel 1: tied off — V0 is single-issue. valid=0 is the canonical\n349:     // \"this channel is unused\" signature; other fields driven to '0 to\n\n(Showing lines 250-349 of 374. Use offset=350 to continue.)\n</content>","metadata":{"preview":"  hazard_unit u_hazard (\n    .id_ex_mem_read (id_ex_w.ctrl.mem_read),\n    .id_ex_rd       (id_ex_w.rd),\n    .if_id_rs1      (if_id_w.instr[19:15]),\n    .if_id_rs2      (if_id_w.instr[24:20]),\n    .redirect       (redirect),\n    .imem_ready     (if_fetch_ready),\n    .ex_long_busy   (ex_long_busy),\n    .mem_wait       (mem_wait),\n    .stall_if       (stall_if),\n    .stall_id       (stall_id),\n    .flush_if       (flush_if),\n    .flush_id       (flush_id),\n    .stall_ex_mem   (stall_ex_mem),\n    .hold_mem_wb    (hold_mem_wb)\n  );\n\n  forward_unit u_fwd (\n    .id_ex_rs1   (id_ex_w.rs1_addr),\n    .id_ex_rs2   (id_ex_w.rs2_addr),","truncated":true,"loaded":[]},"title":"cores/v1/rtl/core.sv","time":{"start":1779280201956,"end":1779280201966}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"AY89a1/OyZZaYJb/R9yAtSpPsnNkmFuSeE3ACyJQqsrcb0PV2oak/wFdpismSJzkKdOosIdYbEVeuFY+jDszcwhz4hdxQvskWqw2IxD17W8+SC8KTPraczI3Vd45m9UR+bOC5kCtLHHXZVC3/mjoexckw/61KFq/JBvOz4hFnoDrrAOCm+KLRDh0aCmY683rMnb+