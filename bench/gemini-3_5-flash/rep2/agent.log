wmask),\n\n  Line 201:     .valid         (store_slot_valid),\n\n  Line 202:     .drain_addr    (store_slot_drain_addr),\n\n  Line 203:     .drain_wdata   (store_slot_drain_wdata),\n\n  Line 204:     .drain_wmask   (store_slot_drain_wmask)\n\n  Line 212:     .store_slot_valid   (store_slot_valid),\n\n  Line 219:     .store_slot_enqueue (store_slot_enqueue),\n\n  Line 220:     .store_slot_addr    (store_slot_enqueue_addr),\n\n  Line 221:     .store_slot_wdata   (store_slot_enqueue_wdata),\n\n  Line 222:     .store_slot_wmask   (store_slot_enqueue_wmask),\n\n  Line 228:     if (store_slot_valid) begin\n\n  Line 229:       io_dmemAddr  = store_slot_drain_addr;\n\n  Line 230:       io_dmemWData = store_slot_drain_wdata;\n\n  Line 231:       io_dmemWEn   = store_slot_drain_wmask;\n","metadata":{"matches":38,"truncated":false},"title":"store_slot","time":{"start":1779280192263,"end":1779280192279}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"","id":"tool_grep_wZkEG6KprznxbUBP11gl","format":"google-gemini-v1","index":0}]}},"id":"prt_e455d2301001lT1nn4f2pbqp5u","sessionID":"ses_1baa43cbeffe3Tj2jTU7G2nLIP","messageID":"msg_e455d18550015l57DFVl81d0rH"}}
