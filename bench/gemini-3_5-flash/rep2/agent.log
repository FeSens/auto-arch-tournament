{"type":"tool_use","timestamp":1779282683674,"sessionID":"ses_1ba7d2a8fffeaRs7VH30axjNA1","part":{"type":"tool","tool":"read","callID":"tool_read_T16jMf22i4gxl5H74hrf","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gemini-3_5-flash-rep2/cores/v1/rtl/if_stage.sv"},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gemini-3_5-flash-rep2/cores/v1/rtl/if_stage.sv</path>\n<type>file</type>\n<content>\n1: // rtl/if_stage.sv\n2: //\n3: // Instruction fetch stage. Holds the PC register; the IF/ID payload\n4: // (pc + instr + valid) is *combinational* — there is no separate IF/ID\n5: // flop in this microarchitecture, the next-stage's ID/EX register\n6: // captures everything one cycle later.\n7: //\n8: // On flush or EX redirect, the instruction emitted to ID is forced to NOP\n9: // (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n10: // observing a real rs1/rs2 from a wrong-path instruction and inserting\n11: // a spurious load-use stall after mispredict recovery.\n12: //\n13: // A decode-light static predictor recognizes legal B-type conditional\n14: // branches with a negative immediate and direct JALs, provided the predicted\n15: // target is word-aligned. JALR remains unpredicted and resolves in EX.\n16: // A two-bank direct-mapped replay table hides external imem stalls only\n17: // through a registered lookahead candidate for the current PC; the IF\n18: // decision path never reads or compares the table combinationally. Each\n19: // bank has 128 entries addressed by pc[8:2]. Entries store pc[31:9], a\n20: // valid bit, and the instruction word; a per-index MRU bit chooses which\n21: // bank to replace when neither bank already contains the fetched tag.\n22: //\n23: // Latency:        PC-reg update is synchronous; output is combinational.\n24: // RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n25: //                 EX-stage redirect).\n26: module if_stage (\n27:   input  logic              clock,\n28:   input  logic              reset,\n29:   input  logic              stall,            // hold PC (load-use)\n30:   input  logic              flush,            // emit NOP into ID this cycle\n31:   input  logic              redirect,         // EX has resolved a branch/jump\n32:   input  logic [31:0]       redirect_target,\n33:   output logic [31:0]       imem_addr,\n34:   input  logic [31:0]       imem_data,\n35:   input  logic              imem_ready,\n36:   output logic              fetch_ready,\n37:   output if_id_t  out\n38: );\n39: \n40:   localparam logic [31:0] RESET_PC = 32'h0000_0000;\n41:   localparam logic [31:0] NOP      = 32'h0000_0013;\n42:   localparam int unsigned REPLAY_INDEX_BITS = 7;\n43:   localparam int unsigned REPLAY_ENTRIES    = 1 << REPLAY_INDEX_BITS;\n44:   localparam int unsigned REPLAY_TAG_HI_LSB = REPLAY_INDEX_BITS + 2;\n45:   localparam int unsigned REPLAY_TAG_HI_BITS = 32 - REPLAY_TAG_HI_LSB;\n46: \n47:   logic [31:0] pc;\n48:   logic [31:0] next_pc;\n49:   logic [31:0] pc_plus4;\n50:   logic [31:0] fetch_instr;\n51:   logic [31:0] branch_imm;\n52:   logic [31:0] jal_imm;\n53:   logic [31:0] branch_target;\n54:   logic [31:0] jal_target;\n55:   logic [31:0] predicted_target;\n56:   logic        fetch_kill;\n57:   logic        predict_enable;\n58:   logic        branch_opcode;\n59:   logic        branch_funct_legal;\n60:   logic        branch_predict_taken;\n61:   logic        jal_opcode;\n62:   logic        jal_predict_taken;\n63:   logic        predicted_taken;\n64: \n65:   logic                              replay_valid_b0 [0:REPLAY_ENTRIES-1];\n66:   logic                              replay_valid_b1 [0:REPLAY_ENTRIES-1];\n67:   logic [REPLAY_TAG_HI_BITS-1:0]     replay_tag_hi_b0 [0:REPLAY_ENTRIES-1];\n68:   logic [REPLAY_TAG_HI_BITS-1:0]     replay_tag_hi_b1 [0:REPLAY_ENTRIES-1];\n69:   logic [31:0]                       replay_instr_b0 [0:REPLAY_ENTRIES-1];\n70:   logic [31:0]                       replay_instr_b1 [0:REPLAY_ENTRIES-1];\n71:   logic                              replay_mru [0:REPLAY_ENTRIES-1];\n72:   logic [REPLAY_INDEX_BITS-1:0]      replay_fill_idx;\n73:   logic [REPLAY_INDEX_BITS-1:0]      replay_lookup_idx;\n74:   logic [REPLAY_TAG_HI_BITS-1:0]     replay_fill_tag_hi;\n75:   logic [REPLAY_TAG_HI_BITS-1:0]     replay_lookup_tag_hi;\n76:   logic [31:0]                       replay_lookup_pc;\n77:   logic                              replay_fill_bank0_match;\n78:   logic                              replay_fill_bank1_match;\n79:   logic                              replay_fill_bank;\n80:   logic                              replay_lookup_bank0_hit;\n81:   logic                              replay_lookup_bank1_hit;\n82:   logic                              replay_lookup_hit;\n83:   logic [31:0]                       replay_lookup_instr;\n84:   logic                              replay_cand_valid_q;\n85:   logic [31:0]                       replay_cand_pc_q;\n86:   logic [31:0]                       replay_cand_instr_q;\n87:   logic                              replay_current_hit;\n88:   logic                              replay_fill_bypass;\n89: \n90:   assign replay_fill_idx    = pc[REPLAY_INDEX_BITS+1:2];\n91:   assign replay_lookup_idx  = replay_lookup_pc[REPLAY_INDEX_BITS+1:2];\n92:   assign replay_fill_tag_hi = pc[31:REPLAY_TAG_HI_LSB];\n93:   assign replay_lookup_tag_hi = replay_lookup_pc[31:REPLAY_TAG_HI_LSB];\n94:   assign replay_current_hit = replay_cand_valid_q && (replay_cand_pc_q == pc);\n95:   assign fetch_ready        = imem_ready || replay_current_hit;\n96:   assign fetch_instr        = imem_ready         ? imem_data :\n97:                               replay_current_hit ? replay_cand_instr_q :\n98:                                                    NOP;\n99:   assign replay_fill_bank0_match = replay_valid_b0[replay_fill_idx]\n100:                                 && (replay_tag_hi_b0[replay_fill_idx] == replay_fill_tag_hi);\n101:   assign replay_fill_bank1_match = replay_valid_b1[replay_fill_idx]\n102:                                 && (replay_tag_hi_b1[replay_fill_idx] == replay_fill_tag_hi);\n103:   assign replay_fill_bank = replay_fill_bank0_match ? 1'b0 :\n104:                             replay_fill_bank1_match ? 1'b1 :\n105:                                                        ~replay_mru[replay_fill_idx];\n106:   assign replay_lookup_bank0_hit = replay_valid_b0[replay_lookup_idx]\n107:                                 && (replay_tag_hi_b0[replay_lookup_idx] == replay_lookup_tag_hi);\n108:   assign replay_lookup_bank1_hit = replay_valid_b1[replay_lookup_idx]\n109:                                 && (replay_tag_hi_b1[replay_lookup_idx] == replay_lookup_tag_hi);\n110:   assign replay_lookup_hit = replay_lookup_bank0_hit || replay_lookup_bank1_hit;\n111:   assign replay_lookup_instr = replay_lookup_bank0_hit ? replay_instr_b0[replay_lookup_idx]\n112:                                                        : replay_instr_b1[replay_lookup_idx];\n113: \n114:   always_comb begin\n115:     pc_plus4           = pc + 32'd4;\n116:     branch_imm         = {{19{fetch_instr[31]}}, fetch_instr[31], fetch_instr[7],\n117:                           fetch_instr[30:25], fetch_instr[11:8], 1'b0};\n118:     jal_imm            = {{11{fetch_instr[31]}}, fetch_instr[31], fetch_instr[19:12],\n119:                           fetch_instr[20], fetch_instr[30:21], 1'b0};\n120:     branch_target      = pc + branch_imm;\n121:     jal_target         = pc + jal_imm;\n122:     fetch_kill         = reset || flush || redirect;\n123:     predict_enable     = !fetch_kill && !stall;\n124:     branch_opcode      = (fetch_instr[6:0] == 7'b1100011);\n125:     branch_funct_legal = (fetch_instr[14:12] != 3'd2) && (fetch_instr[14:12] != 3'd3);\n126:     branch_predict_taken = predict_enable\n127:                        && branch_opcode\n128:                        && branch_funct_legal\n129:                        && fetch_instr[31]\n130:                        && (branch_target[1:0] == 2'b00);\n131:     jal_opcode         = (fetch_instr[6:0] == 7'b1101111);\n132:     jal_predict_taken  = predict_enable\n133:                        && jal_opcode\n134:                        && (jal_target[1:0] == 2'b00);\n135:     predicted_taken    = branch_predict_taken || jal_predict_taken;\n136:     predicted_target   = jal_predict_taken ? jal_target : branch_target;\n137: \n138:     next_pc = redirect        ? redirect_target :\n139:               predicted_taken ? predicted_target :\n140:                                 pc_plus4;\n141:     replay_lookup_pc = redirect ? redirect_target :\n142:                        !stall   ? next_pc :\n143:                                   pc;\n144:     replay_fill_bypass = imem_ready\n145:                        && (replay_fill_idx == replay_lookup_idx)\n146:                        && (replay_fill_tag_hi == replay_lookup_tag_hi);\n147:   end\n148: \n149:   // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n150:   // redirect on the same cycle as imem_stall or dmem_stall — without\n151:   // this priority the redirect target would be silently dropped, the\n152:   // PC would hold its old (wrong-path) value, and execution would\n153:   // resume on the wrong path once the bus unstalls. Verified by the\n154:   // VexRiscv-binary CoreMark sweep with --istall enabled.\n155:   always_ff @(posedge clock) begin\n156:     if      (reset)    pc <= RESET_PC;\n157:     else if (redirect) pc <= redirect_target;\n158:     else if (!stall)   pc <= next_pc;\n159:   end\n160: \n161:   always_ff @(posedge clock) begin\n162:     if (reset) begin\n163:       replay_cand_valid_q <= 1'b0;\n164:       for (int i = 0; i < REPLAY_ENTRIES; i++) begin\n165:         replay_valid_b0[i] <= 1'b0;\n166:         replay_valid_b1[i] <= 1'b0;\n167:         replay_mru[i]      <= 1'b0;\n168:       end\n169:     end else begin\n170:       if (imem_ready) begin\n171:         if (replay_fill_bank) begin\n172:           replay_valid_b1[replay_fill_idx] <= 1'b1;\n173:           replay_tag_hi_b1[replay_fill_idx] <= replay_fill_tag_hi;\n174:           replay_instr_b1[replay_fill_idx] <= imem_data;\n175:         end else begin\n176:           replay_valid_b0[replay_fill_idx] <= 1'b1;\n177:           replay_tag_hi_b0[replay_fill_idx] <= replay_fill_tag_hi;\n178:           replay_instr_b0[replay_fill_idx] <= imem_data;\n179:         end\n180:         replay_mru[replay_fill_idx] <= replay_fill_bank;\n181:       end\n182: \n183:       replay_cand_pc_q <= replay_lookup_pc;\n184:       if (replay_fill_bypass) begin\n185:         replay_cand_valid_q <= 1'b1;\n186:         replay_cand_instr_q <= imem_data;\n187:       end else begin\n188:         replay_cand_valid_q <= replay_lookup_hit;\n189:         replay_cand_instr_q <= replay_lookup_instr;\n190:       end\n191:     end\n192:   end\n193: \n194:   assign imem_addr = pc;\n195: \n196:   always_comb begin\n197:     out.pc               = pc;\n198:     out.instr            = fetch_kill ? NOP : fetch_instr;\n199:     out.predicted_taken  = predicted_taken;\n200:     out.predicted_target = predicted_taken ? predicted_target : pc_plus4;\n201:     out.valid            = !fetch_kill;\n202:   end\n203: \n204: endmodule\n\n(End of file - total 204 lines)\n</content>","metadata":{"preview":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or EX redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall after mispredict recovery.\n//\n// A decode-light static predictor recognizes