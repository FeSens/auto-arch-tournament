data)\n247:   );\n248: \n249:   // ── Hazard / forwarding ───────────────────────────────────────────────\n\n(Showing lines 100-249 of 374. Use offset=250 to continue.)\n</content>","metadata":{"preview":"  // hazard / forward\n  logic       stall_if, stall_id, flush_if, flush_id;\n  logic       stall_ex_mem, hold_mem_wb;\n  logic       ex_long_busy;\n  logic       if_fetch_ready;\n  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\n\n  // Live MEM-stage dmem request plus the one-deep pending-store slot.\n  logic [31:0] live_dmem_addr;\n  logic [31:0] live_dmem_wdata;\n  logic [3:0]  live_dmem_wen;\n  logic        live_dmem_ren;\n  logic        store_slot_valid;\n  logic        store_slot_enqueue;\n  logic [31:0] store_slot_enqueue_addr;\n  logic [31:0] store_slot_enqueue_wdata;\n  logic [3:0]  store_slot_enqueue_wmask;\n  logic [31:0] store_slot_drain_addr;\n  logic [31:0] store_slot_drain_wdata;\n  logic [3:0]  store_slot_drain_wmask;","truncated":true,"loaded":[]},"title":"cores/v1/rtl/core.sv","time":{"start":1779280198632,"end":1779280198635}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"","id":"tool_read_oQkSxNUIRG0HEVLrlZHq","format":"google-gemini-v1","index":0}]}},"id":"prt_e455d3be60022EyC2m3peFZtjk","sessionID":"ses_1baa43cbeffe3Tj2jTU7G2nLIP","messageID":"msg_e455d2f89001JNn0C2dYnFYf6A"}}
