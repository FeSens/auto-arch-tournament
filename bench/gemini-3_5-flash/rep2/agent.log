       ctrl_with_trap.reg_write  = 1'b0;\n108:     end\n109: \n110:     // Combinational dmem outputs — gated off on misalign.\n111:     dmem_addr  = in.alu_result;\n112:     dmem_wdata = wdata_rep;\n113:     dmem_wen   = (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n114:     dmem_ren   = in.ctrl.mem_read  && !mem_misalign;\n115: \n116:     // Load extraction: shift right then sign/zero-extend the low N bits.\n117:     shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\n118:     byte_val  = shifted[7:0];\n119:     hword_val = shifted[15:0];\n120:     case (in.ctrl.mem_width)\n121:       2'd0:    load_data = in.ctrl.mem_sext\n122:                          ? {{24{byte_val[7]}},  byte_val}\n123:                          : {24'b0,              byte_val};\n124:       2'd1:    load_data = in.ctrl.mem_sext\n125:                          ? {{16{hword_val[15]}}, hword_val}\n126:                          : {16'b0,               hword_val};\n127:       default: load_data = dmem_rdata;\n128:     endcase\n129: \n130:     // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n131:     aligned_addr = (mem_op && !mem_misalign)\n132:                  ? {in.alu_result[31:2], 2'b00}\n133:                  : 32'b0;\n134:   end\n\n(Showing lines 75-134 of 171. Use offset=135 to continue.)\n</content>","metadata":{"preview":"  // riscv-formal's RISCV_FORMAL_ALIGNED_MEM contract demands rvfi_trap=1\n  // when the effective byte address is not aligned to the access width.\n  // On trap, the dmem ports are gated off and ctrl propagates is_illegal.\n  logic mem_misalign;\n  logic mem_op;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    // Byte/halfword replication for stores.\n    case (in.ctrl.mem_width)\n      2'd0:    wdata_rep = {4{in.write_data[7:0]}};\n      2'd1:    wdata_rep = {2{in.write_data[15:0]}};\n      default: wdata_rep = in.write_data;\n    endcase\n\n    // Byte-lane mask shifted to addr[1:0] * 1.\n    case (in.ctrl.mem_width)\n      2'd0:    byte_mask = (4'b0001 << in.alu_result[1:0]);\n      2'd1:    byte_mask = (4'b0011 << in.alu_result[1:0]);\n      default: byte_mask = 4'b1111;","truncated":true,"loaded":[]},"title":"cores/bench/rtl/mem_stage.sv","time":{"start":1779282967024,"end":1779282967032}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.encrypted","data":"","id":"tool_read_oWuf1MX312hXUKDtcUk0","format":"google-gemini-v1","index":0}]}},"id":"prt_e458779ea001brXqmYh2HhqKxb","sessionID":"ses_1ba7a1dc7ffeENx8ai3mJ0P6CY","messageID":"msg_e45876fa7001tamQCoincv0hgy"}}
