mpleted"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' cores/bench/test/test_alu.py\nsed -n '1,190p' cores/bench/test/test_ex_result_banks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' cores/bench/test/test_alu.py\nsed -n '1,190p' cores/bench/test/test_ex_result_banks.py\"","aggregated_output":"\"\"\"Unit tests for rtl/alu.sv.\n\nRV32I and multiply remain combinational. DIV/REM accept a request,\ncompute for exactly eight clocks, and hold a response until accepted.\nEvery original arithmetic vector is retained, including in the real build.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"TEST_ALTOPS\") == \"1\"\nALT_MASK = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n\n\ndef _expected(op, a, b, real):\n    if ALTOPS and op in ALT_MASK:\n        v = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        return (v ^ ALT_MASK[op]) & MASK32\n    return real & MASK32\n\n\ndef _signed(v):\n    v &= MASK32\n    return v - (1 << 32) if v & (1 << 31) else v\n\n\ndef _div_reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    remainder = op in (ALU_REM, ALU_REMU)\n    if b == 0:\n        return a if remainder else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        a, b = _signed(a), _signed(b)\n    q = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        q = -q\n    return ((a - q * b) if remainder else q) & MASK32\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_resp_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value) == 1\n    assert int(dut.div_resp_valid.value) == 0\n    assert int(dut.div_registered_result.value) == 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    is_div = op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n    actual = int((dut.div_resp_data if is_div else dut.out).value) & MASK32\n    if is_div:\n        assert int(dut.out.value) == 0, \"live divide leaked into the normal ALU path\"\n    expected = _expected(op, a, b, expected)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    \"\"\"Require exactly eight compute clocks, then consume once.\"\"\"\n    await _launch(dut, op, a, b)\n    await _compute(dut)\n    await _check(dut, op, a, b, expected)\n    assert int(dut.div_registered_result.value) == _expected(op, a, b, expected)\n    dut.div_resp_ready.value = 1\n    await _tick(dut)\n    assert int(dut.div_resp_valid.value) == 0\n    assert int(dut.div_req_ready.value) == 1\n    assert int(dut.div_registered_result.value) == _expected(op, a, b, expected)\n    dut.div_resp_ready.value = 0\n\n\nasync def _launch(dut, op, a, b):\n    previous = int(dut.div_registered_result.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value) == 1\n    await _tick(dut)\n    dut.div_req_valid.value = 0\n    assert int(dut.div_req_ready.value) == 0\n    assert int(dut.div_resp_valid.value) == 0\n    assert int(dut.div_registered_result.value) == previous, \"request destroyed the EX/MEM bank\"\n\n\nasync def _compute(dut):\n    offered = None\n    previous = int(dut.div_registered_result.value)\n    for cycle in range(1, 9):\n        await _tick(dut)\n        # After edge 7 we are in the eighth compute interval: its result\n        # can be consumed on edge 8, or registered and held on that edge.\n        assert int(dut.div_resp_valid.value) == (cycle >= 7), (\n            f\"DIV/REM response must be offered in compute interval 8, edge={cycle}\"\n        )\n        assert int(dut.div_req_ready.value) == 0\n        if cycle < 8:\n            assert int(dut.div_registered_result.value) == previous, \"registered port has a bypass\"\n        if cycle == 7:\n            offered = int(dut.div_resp_data.value)\n        if cycle == 8:\n            assert int(dut.div_resp_data.value) == offered\n            assert int(dut.div_registered_result.value) == offered\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)              # -1 < 0\n    await _check(dut, ALU_SLT, 1, 0, 0)\n    await _check(dut, ALU_SLT, 0x7FFFFFFF, 0x80000000, 0)     # MAX > MIN\n\n\n@cocotb.test()\nasync def sltu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n    await _check(dut, ALU_SLTU, 0, 1, 1)\n\n\n@cocotb.test()\nasync def sll(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLL, 1, 4, 16)\n    await _check(dut, ALU_SLL, 1, 31, 0x80000000)\n    await _check(dut, ALU_SLL, 1, 0x20, 1)                    # shamt = b[4:0] = 0\n\n\n@cocotb.test()\nasync def srl(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRL, 0x80000000, 1, 0x40000000)\n    await _check(dut, ALU_SRL, 0x80000000, 31, 1)\n    await _check(dut, ALU_SRL, 0xFFFFFFFF, 0x25, 0x07FFFFFF)   # shamt masked\n\n\n@cocotb.test()\nasync def sra(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRA, 0x80000000, 1, 0xC0000000)\n    await _check(dut, ALU_SRA, 0x80000000, 31, 0xFFFFFFFF)\n    await _check(dut, ALU_SRA, 0x7FFFFFFF, 1, 0x3FFFFFFF)\n\n\n@cocotb.test()\nasync def lui(dut):\n    await _setup(dut)\n    await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n\n\n@cocotb.test()\nasync def mul(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MUL, 3, 4, 12)\n    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\n\n\n@cocotb.test()\nasync def mulh(dut):\n    await _setup(dut)\n    # INT_MIN * 2 = -2^32; high half = -1\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    # INT_MIN * INT_MIN = 2^62; high half = 0x40000000\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 1, 1, 0)\n\n\n@cocotb.test()\nasync def mulhu(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n\n\n@cocotb.test()\nasync def mulhsu(dut):\n    await _setup(dut)\n    # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    # (-1) * unsigned -> high half is sign extension\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 10, 3, 3)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n\"\"\"Direct EX ownership checks, including holds unavailable from core's bus.\n\nThe real core stalls EX/MEM only for a memory instruction, so a divide\nowner normally advances immediately. This harness also holds that owner\nand blocks terminal acceptance to verify the EX interface's full contract.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_DIV, ALU_REM, run_cocotb\n\n\n# Packed bundle layouts from core_pkg.sv, listed MSB first.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n         (\"ctrl\", sum(w for _, w in CTRL)), (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32),\n          (\"ctrl\", sum(w for _, w in CTRL)), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, **values):\n    result = 0\n    for name, width in layout:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    return fields\n\n\ndef _ex_snapshot(ex):\n    return _unpack(EX_MEM, int(ex.out.value))\n\n\ndef _drive(dut, op=ALU_ADD, a=123, b=7, rd=3, pc=0x80, *, jump=False, memory=False):\n    ctrl = _pack(CTRL, alu_op=op, reg_write=1, is_jump=int(jump),\n                 mem_read=int(memory), mem_width=2)\n    funct3 = {ALU_DIV: 4, ALU_REM: 6}.get(op, 0)\n    instr = ((int(op != ALU_ADD) << 25) | (2 << 20) | (1 << 15) |\n             (funct3 << 12) | (rd << 7) | 0x33)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=pc, rs1_val=a, rs2_val=b,\n                                    rd=rd, rs1_addr=1, rs2_addr=2,\n                                    ctrl=ctrl, instr=instr, valid=1)\n\n\ndef _expected(op, a, b, real):\n    if os.environ.get(\"TEST_ALTOPS\") == \"1\":\n        return ((a - b) ^ {ALU_DIV: 0x7F8529EC, ALU_REM: 0x8DA68FA5}[op]) & 0xFFFFFFFF\n    return real & 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_ex_mem_load.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n    assert int(dut.div_result_sel_q.value) == 0\n    assert int(dut.div_registered_result.value) == 0\n    dut.reset.value = 0\n\n\nasync def _launch_and_offer(dut, op, a, b, real, *, rd=3):\n    previous = int(dut.div_registered_result.value)\n    _drive(dut, op, a, b, rd)\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_valid.value) == 1\n    assert int(dut.div_req_ready.value) == 1\n    await _tick(dut)\n    assert int(dut.div_result_sel_q.value) == 0\n    assert int(dut.out.value) == 0, \"older owner did not drain on launch\"\n    for edge in range(1, 8):\n        await _tick(dut)\n        assert int(dut.div_resp_valid.value) == (edge == 7)\n        assert int(dut.div_registered_result.value) == previous\n        assert int(dut.div_result_sel_q.value) == 0\n    expected = _expected(op, a, b, real)\n    assert int(dut.div_resp_data.value) == expected\n    return expected\n\n\n@cocotb.test()\nasync def bank_owner_hold_launch_bubble_and_link(dut):\n    await _reset(dut)\n    _drive(dut, a=0x120, b=0x14)\n    await _tick(dut)\n    assert _ex_snapshot(dut)[\"alu_result\"] == 0x134\n    assert int(dut.mem_addr.value) == 0x134\n    assert int(dut.div_result_sel_q.value) == 0\n\n    expected = await _launch_and_offer(dut, ALU_DIV, -101, 7, -14)\n    assert int(dut.div_accept.value) == 1\n    await _tick(dut)\n    owner = int(dut.out.value)\n    fields = _ex_snapshot(dut)\n    assert fields[\"alu_result\"] == expected\n    assert int(dut.mem_addr.value) == 0, \"divide result entered the memory address bank\"\n    assert fields[\"valid\"] == 1 and fields[\"rd\"] == 3\n    assert fields[\"rs1_val\"] == 0xFFFFFF9B and fields[\"rs2_val\"] == 7\n    assert int(dut.div_result_sel_q.value) == 1\n\n    # A newer divide must not launch or overwrite the bank while EX/MEM\n    # is held, even for longer than the entire divider latency.\n    dut.stall.value = 1\n    _drive(dut, ALU_REM, 123, 7, rd=4)\n    for _ in range(12):\n        await _tick(dut)\n        assert int(dut.div_req_valid.value) == 0\n        assert int(dut.div_active_q.value) == 0\n        assert int(dut.div_result_sel_q.value) == 1\n        assert int(dut.div_registered_result.value) == expected\n        assert int(dut.out.value) == owner\n    dut.stall.value = 0\n    next_expected = await _launch_and_offer(dut, ALU_REM, 123, 7, 4, rd=4)\n    assert next_expected != expected\n    await _tick(dut)\n    assert _ex_snapshot(dut)[\"alu_result\"] == next_expected\n    assert _ex_snapshot(dut)[\"rd\"] == 4\n\n    # Selecting the normal bank must use the existing PC+4 link result.\n    _drive(dut, pc=0x100, jump=True)\n    await _tick(dut)\n    assert int(dut.div_result_sel_q.value) == 0\n    assert _ex_snapshot(dut)[\"alu_result\"] == 0x104\n    getattr(dut, \"in\").value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n    assert int(dut.div_result_sel_q.value) == 0\n    assert int(dut.div_registered_result.value) == next_expected\n    expected = await _launch_and_offer(dut, ALU_DIV, 81, -9, -9)\n    await _tick(dut)\n    assert int(dut.div_result_sel_q.value) == 1\n    assert _ex_snapshot(dut)[\"alu_result\"] == expected\n    dut.stall.value = 1\n    dut.reset.value = 1\n    await _tick(dut)\n    assert int(dut.out.value) == 0 and int(dut.div_result_sel_q.value) == 0\n    assert int(dut.div_registered_result.value) == 0\n    await _reset(dut)\n\n\n@cocotb.test()\nasync def terminal_response_wait_and_reset_ownership(dut):\n    for cancel in (False, True):\n        await _reset(dut)\n        expected = await _launch_and_offer(dut, ALU_REM, -101, 7, -3, rd=0)\n        dut.stall.value = 1\n        await Timer(1, \"ns\")\n        assert int(dut.div_accept.value) == 0\n        await _tick(dut)\n        assert int(dut.div_registered_result.value) == expected\n        for _ in range(10):\n            await _tick(dut)\n            assert int(dut.div_resp_valid.value) == 1\n            assert int(dut.div_registered_result.value) == expected\n            assert int(dut.div_result_sel_q.value) == 0\n            assert int(dut.out.value) == 0\n        if cancel:\n            await _reset(dut)\n","exit_code":0,"status":"completed"}}
