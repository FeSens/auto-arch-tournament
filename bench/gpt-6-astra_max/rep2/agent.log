{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, random\nimport yaml, jsonschema\nMASK=(1<<32)-1\n\ndef step(q,r,d,width,count):\n    mask=(1<<width)-1\n    for _ in range(count):\n        trial=(r<<1)|(q>>(width-1))\n        diff=trial-d\n        take=diff>=0\n        r=diff if take else trial\n        q=((q<<1)|take)&mask\n    return q,r\n\ndef preload(a,d):\n    if d>=16:\n        hiq,hir=0,a>>28\n    else:\n        hiq,hir=step(a>>28,0,d,4,4)\n    return ((a<<4)|hiq)&MASK,hir\n\nchecks=0\nfor nibble in range(16):\n    for divisor in range(16):\n        a=nibble<<28\n        assert preload(a,divisor)==step(a,0,divisor,32,4)\n        checks+=1\nrng=random.Random(2026090600241)\nedges=[0,1,2,3,7,8,15,16,17,31,255,0x10000000,0x7fffffff,0x80000000,0x80000001,MASK]\npairs=[(a,b) for a in edges for b in edges]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000)]\nfor a,b in pairs:\n    for signed in (False,True):\n        aa= a-(1<<32) if signed and a>>31 else a\n        bb= b-(1<<32) if signed and b>>31 else b\n        am,bm=abs(aa),abs(bb)\n        q,r=preload(am,bm)\n        assert (q,r)==step(am,0,bm,32,4)\n        for _ in range(7):\n            q,r=step(q,r,bm,32,4)\n        for rem in (False,True):\n            if b==0:\n                actual=a if rem else MASK\n                expect=actual\n            else:\n                actual=(r if rem else q)\n                if (aa<0 if rem else ((aa<0)\"'!=(bb<0))):\n                    actual=-actual\n                eq=abs(aa)//abs(bb)\n                if (aa<0)!=(bb<0): eq=-eq\n                expect=(aa-eq*bb) if rem else eq\n            assert (actual&MASK)==(expect&MASK), (a,b,signed,rem)\n            checks+=1\nprint(json.dumps({'\"'arithmetic_model_checks_passed':checks,'yaml_and_jsonschema_available':True}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
