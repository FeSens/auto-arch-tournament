s/bench/rtl/if_stage.sv:39:  // this priority the redirect target would be silently dropped, the\ncores/bench/rtl/if_stage.sv:45:    else if (redirect) pc <= redirect_target;\ncores/bench/rtl/if_stage.sv:53:    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\ncores/bench/rtl/if_stage.sv:54:    out.valid = !(flush || redirect);\ncores/bench/rtl/ex_stage.sv:4:// MEM/WB), runs the ALU, resolves branches, computes the redirect\ncores/bench/rtl/ex_stage.sv:14:// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\ncores/bench/rtl/ex_stage.sv:27:  output logic               div_wait,     // hold ID/EX and fetch, drain MEM/WB\ncores/bench/rtl/ex_stage.sv:28:  output logic               redirect,\ncores/bench/rtl/ex_stage.sv:29:  output logic [31:0]        redirect_target\ncores/bench/rtl/ex_stage.sv:71:  assign div_wait = is_div && !div_accept;\ncores/bench/rtl/ex_stage.sv:132:  // instruction, suppress the redirect (PC stays linear), and clear\ncores/bench/rtl/ex_stage.sv:152:  assign redirect        = in.valid && (branch_taken || in.ctrl.is_jump) && !misalign_fault;\ncores/bench/rtl/ex_stage.sv:153:  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\ncores/bench/rtl/ex_stage.sv:165:    end else if (div_wait || !in.valid) begin\ncores/bench/rtl/ex_stage.sv:181:      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\ncores/bench/rtl/ex_stage.sv:183:      // consistent with the suppressed redirect.\ncores/bench/rtl/ex_stage.sv:184:      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\ncores/bench/test/test_reg_file.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/test_imm_gen.py\ncores/bench/test/test_decoder.py\ncores/bench/test/conftest.py\ncores/bench/test/test_alu.py\n","exit_code":0,"status":"completed"}}
