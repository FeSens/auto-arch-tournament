7d8c6d1b53b111497e5ae52.json\n.tmp/r7s1-multiply-banks/pipeline_traces/9d201de653c9743ca364b114e7eb2647aeca18d4719a209e40fe1604ac81cf4d.json\n.tmp/r7s1-multiply-banks/pipeline_traces/982766c4e8ab37b12d2e939455352f7ae131e44c3240a6ef28dc7aa9c9f285cb.json\n.tmp/r7s1-multiply-banks/pipeline_traces/70803103649413209ff889310198fc485265fecac2fdbb47e9c8cd3aa7f25949.json\n.tmp/r7s1-multiply-banks/pipeline_traces/bd97c234a1e8399d3e3087c1749f7ea3ce0450dd857b14966347dd3458fa81dd.json\n.tmp/r7s1-multiply-banks/pipeline_traces/58248e1cc2a6433071e7d81c10194d15972645d288524b6c3b8452e29d97c2eb.json\n.tmp/r7s1-multiply-banks/pipeline_traces/6eb421c326896a9effd3a0bd7ac57b64f05c765ea349d590d00c8c7575de59d6.json\n.tmp/r7s1-multiply-banks/pipeline_traces/a5e1cffc593cfac261be3afbcf7205cc075e6541cec2797d437ea5aed0316da5.json\n.tmp/r7s1-multiply-banks/synth.log\n.tmp/r7s1-multiply-banks/mapped_separation.json\n.tmp/r7s1-multiply-banks/starting_pipeline.log\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/div_unit.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/id_stage.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/mem_stage.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/reg_file.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/core_pkg.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/wb_stage.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/core.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/forward_unit.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/alu.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/if_stage.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/hazard_unit.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/ex_stage.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/imm_gen.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/rtl/decoder.sv\n.tmp/r7s1-multiply-banks/starting/cores/bench/core.yaml\n.tmp/r7s1-multiply-banks/starting/cores/bench/obj_dir/Vcore__ALL.cpp\n.tmp/r7s1-multiply-banks/starting/cores/bench/obj_dir/Vcore___024unit.h\n\"\"\"ID payload capture is independent of control flush and input validity.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_ex_result_banks import CTRL, ID_EX, _pack, _unpack, _tick\n\n\ndef _drive(dut, index, *, valid=True):\n    imm = -17 - index\n    rd, rs1 = 3 + index, 17 + index\n    instr = ((imm & 0xFFF) << 20) | (rs1 << 15) | (rd << 7) | 0x13\n    pc, a, b = 0x12340000 + index * 4, 0xABC00123 + index, 0xEDC45678 - index\n    getattr(dut, \"in\").value = (pc << 33) | (instr << 1) | int(valid)\n    dut.rs1_data.value, dut.rs2_data.value = a, b\n    return dict(pc=pc, instr=instr, rs1_val=a, rs2_val=b, imm=imm & 0xFFFFFFFF,\n                rd=rd, rs1_addr=rs1, rs2_addr=(instr >> 20) & 31)\n\n\ndef _snapshot(dut):\n    return _unpack(ID_EX, int(dut.out.value))\n\n\ndef _payload(fields):\n    return {k: v for k, v in fields.items() if k not in (\"valid\", \"ctrl\")}\n\n\n@cocotb.test()\nasync def capture_flush_invalid_hold_and_reset_precedence(dut):\n    dut.clock.value = 0\n    dut.reset.value, dut.stall.value, dut.flush.value = 1, 1, 1\n    _drive(dut, 0)\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n    dut.reset.value, dut.stall.value, dut.flush.value = 0, 0, 0\n\n    first = _drive(dut, 1)\n    await _tick(dut)\n    active = _snapshot(dut)\n    assert _payload(active) == first and active[\"valid\"] == 1\n    decoded = _unpack(CTRL, active[\"ctrl\"])\n    assert decoded[\"reg_write\"] == 1 and decoded[\"alu_src\"] == 1\n    assert decoded[\"is_illegal\"] == 0\n\n    # dmem/division holds preserve the complete active instruction.\n    dut.stall.value = 1\n    for index in range(2, 7):\n        _drive(dut, index, valid=bool(index & 1))\n        await _tick(dut)\n        assert _snapshot(dut) == active\n\n    # Load-use asserts flush and stall together: control clears but the\n    # distinct old payload retains. Flush must not become a data reset.\n    dut.flush.value = 1\n    _drive(dut, 7)\n    await _tick(dut)\n    bubble = _snapshot(dut)\n    assert _payload(bubble) == first\n    assert bubble[\"valid\"] == 0 and bubble[\"ctrl\"] == 0\n    dut.flush.value = 0\n    _drive(dut, 8)\n    await _tick(dut)\n    assert _snapshot(dut) == bubble\n\n    # An unstalled redirect still captures discarded payload.\n    dut.stall.value, dut.flush.value = 0, 1\n    discarded = _drive(dut, 9)\n    await _tick(dut)\n    bubble = _snapshot(dut)\n    assert _payload(bubble) == discarded\n    assert bubble[\"valid\"] == 0 and bubble[\"ctrl\"] == 0\n\n    # Unavailable input with a write-producing instruction must install\n    # zero control, despite accepting distinct payload without flush.\n    dut.flush.value = 0\n    invalid = _drive(dut, 10, valid=False)\n    await _tick(dut)\n    bubble = _snapshot(dut)\n    assert _payload(bubble) == invalid\n    assert bubble[\"valid\"] == 0 and bubble[\"ctrl\"] == 0\n    resumed = _drive(dut, 11)\n    await _tick(dut)\n    assert _payload(_snapshot(dut)) == resumed\n    assert _snapshot(dut)[\"ctrl\"] == active[\"ctrl\"]\n    assert _snapshot(dut)[\"valid\"] == 1\n\n    # Reset clears every bank, even when a hold and flush overlap.\n    dut.reset.value, dut.stall.value, dut.flush.value = 1, 1, 1\n    _drive(dut, 12)\n    await Timer(1, \"ns\")\n    assert _snapshot(dut)[\"valid\"] == 1, \"reset became asynchronous\"\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n\n\ndef test_id_stage_runner():\n    run_cocotb(toplevel=\"id_stage\", sources=[\"core_pkg.sv\", \"decoder.sv\",\n               \"imm_gen.sv\", \"id_stage.sv\"], test_module=\"test_id_stage\")\n\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, write-first\nbypass, and the synchronous-reset-clears-all property.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _reset(dut):\n    dut.reset.value    = 1\n    dut.w_en.value     = 0\n    dut.w_addr.value   = 0\n    dut.w_data.value   = 0\n    dut.rs1_addr.value = 0\n    dut.rs2_addr.value = 0\n    await RisingEdge(dut.clock)\n    await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n\n\nasync def _write(dut, addr, data):\n    dut.w_en.value   = 1\n    dut.w_addr.value = addr\n    dut.w_data.value = data\n    await RisingEdge(dut.clock)\n    dut.w_en.value = 0\n\n\nasync def _read(dut, rs1, rs2):\n    dut.rs1_addr.value = rs1\n    dut.rs2_addr.value = rs2\n    await Timer(1, \"ns\")\n    return int(dut.rs1_data.value), int(dut.rs2_data.value)\n\n\n@cocotb.test()\nasync def reset_clears_all(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    for r in range(32):\n        rs1, _ = await _read(dut, r, 0)\n        assert rs1 == 0, f\"x{r} after reset = 0x{rs1:08x}\"\n\n\n@cocotb.test()\nasync def write_and_read(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 5, 0xDEADBEEF)\n    await Timer(1, \"ns\")\n    rs1, _ = await _read(dut, 5, 0)\n    assert rs1 == 0xDEADBEEF\n\n\n@cocotb.test()\nasync def x0_hardwired(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 0, 0xCAFEBABE)\n    await Timer(1, \"ns\")\n    rs1, _ = await _read(dut, 0, 0)\n    assert rs1 == 0\n\n\n@cocotb.test()\nasync def write_first_bypass(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    # Combinational read of an addr that is being written this cycle:\n    # bypass returns the new write data.\n    dut.rs1_addr.value = 7\n    dut.w_en.value     = 1\n    dut.w_addr.value   = 7\n    dut.w_data.value   = 0x12345678\n    await Timer(1, \"ns\")\n    assert int(dut.rs1_data.value) == 0x12345678\n    dut.w_en.value = 0\n\n\n@cocotb.test()\nasync def two_read_ports(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 1, 0xAAAAAAAA)\n    await _write(dut, 2, 0xBBBBBBBB)\n    await Timer(1, \"ns\")\n    rs1, rs2 = await _read(dut, 1, 2)\n    assert rs1 == 0xAAAAAAAA\n    assert rs2 == 0xBBBBBBBB\n\n\ndef test_reg_file_runner():\n    run_cocotb(toplevel=\"reg_file\",\n               sources=[\"reg_file.sv\"],\n               test_module=\"test_reg_file\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nrows=[json.loads(s) for s in Path('cores/bench/experiments/log.jsonl').read_text().splitlines()]\nfor r in rows:\n if r.get('category')=='structural' or r.get('id') in ['hyp-20260906-001-r11s0','hyp-20260906-002-r12s1']:\n  print(json.dumps({k:r.get(k) for k in ['id','title','category','outcome','fitness','delta_pct','fmax_mhz','cycles','lut4','ff','error','lesson']},ensure_ascii=False))\n  n=r.get('implementation_notes','')\n  print('notes_chars='+str(len(n)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nrows=[json.loads(s) for s in Path('cores/bench/experiments/log.jsonl').read_text().splitlines()]\nfor r in rows:\n if r.get('category')=='structural' or r.get('id') in ['hyp-20260906-001-r11s0','hyp-20260906-002-r12s1']:\n  print(json.dumps({k:r.get(k) for k in ['id','title','category','outcome','fitness','delta_pct','fmax_mhz','cycles','lut4','ff','error','lesson']},ensure_ascii=False))\n  n=r.get('implementation_notes','')\n  print('notes_chars='+str(len(n)))\nPY\"","aggregated_output":"{\"id\": \"hyp-20260906-002-r1s1\", \"title\": \"Separate bounded multicycle division from the single-cycle execute path\", \"category\": \"structural\", \"outcome\": \"improvement\", \"fitness\": 372.62, \"delta_pct\": 31.75, \"fmax_mhz\": 167.36, \"cycles\": 4491485, \"lut4\": 5438, \"ff\": 2094, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r1s1 (improvement, +31.75%): Moving combinational DIV/REM off the single-cycle execute path into a shared blocking divider raised median Fmax 31.75% with no CoreMark cycle penalty because the timed region executed no DIV/REM, so the throughput gain depends on the workload's division frequency.\"}\nnotes_chars=7018\n{\"id\": \"hyp-20260906-002-r2s1\", \"title\": \"Retiming divide writeback into a separate EX/MEM result bank\", \"category\": \"structural\", \"outcome\": \"improvement\", \"fitness\": 375.78, \"delta_pct\": 0.85, \"fmax_mhz\": 168.78, \"cycles\": 4491485, \"lut4\": 5470, \"ff\": 2111, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r2s1 (improvement, +0.85%): Routing the post-register DIV/REM result-bank mux into mem_stage.address blocks Yosys BRAM address-register absorption, so memory addresses must use the normal EX/MEM bank directly to avoid expansion from four block RAMs to 1,024 RAM16SDP4 blocks and placement failure.\"}\nnotes_chars=9816\n{\"id\": \"hyp-20260906-002-r3s1\", \"title\": \"Two radix-4 quotient stages per divider clock\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 159.15, \"delta_pct\": -57.65, \"fmax_mhz\": 71.48, \"cycles\": 4491485, \"lut4\": 5651, \"ff\": 2127, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r3s1 (regression, -57.65%): Halving divider quotient stages does not guarantee better mapped timing: two radix-4 stages in div_unit.sv cascaded 35-bit trial subtraction and underflow-driven masked-OR selection into terminal sign correction, yielding a reported ~14 ns completion path with unchanged CoreMark cycles.\"}\nnotes_chars=9079\n{\"id\": \"hyp-20260906-002-r4s1\", \"title\": \"Retime divider finalization using a narrow request-edge prefix\", \"category\": \"structural\", \"outcome\": \"improvement\", \"fitness\": 382.48, \"delta_pct\": 1.78, \"fmax_mhz\": 171.79, \"cycles\": 4491485, \"lut4\": 5513, \"ff\": 2087, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r4s1 (improvement, +1.78%): Precomputing the first four restoring bits with a narrow request-edge prefix in div_unit.sv separates sign correction from the wide recurrence by using registered quotient_q/remainder_q, improving fitness without extending the eight-clock response schedule.\"}\nnotes_chars=0\n{\"id\": \"hyp-20260906-002-r5s1\", \"title\": \"Separate pipeline payload storage from bubble and divide control\", \"category\": \"structural\", \"outcome\": \"improvement\", \"fitness\": 409.8, \"delta_pct\": 7.14, \"fmax_mhz\": 184.06, \"cycles\": 4491485, \"lut4\": 5490, \"ff\": 2112, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r5s1 (improvement, +7.14%): Separating ID/EX and EX/MEM payload capture from bubble/flush and divide-completion control removed those decisions from wide data/reset/enable cones, raising reported median Fmax 7.14% with unchanged CoreMark cycles while requiring zero control on invalid entries and full payload/control retention during memory stalls.\"}\nnotes_chars=9507\n{\"id\": \"hyp-20260906-002-r6s1\", \"title\": \"Retime forwarding dependency comparisons into the ID/EX boundary\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 376.98, \"delta_pct\": -8.01, \"fmax_mhz\": 169.32, \"cycles\": 4491485, \"lut4\": 5502, \"ff\": 2093, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r6s1 (regression, -8.01%): Registering near/far forwarding matches at ID/EX removed live rd comparisons from EX, but alu_op-driven normal-result selection into EX/MEM became critical in all three seeds, lowering reported median Fmax from 184.06 to 169.32 MHz with identical CoreMark cycles; comparator retiming still requires checking other routed paths across seeds.\"}\nnotes_chars=9405\n{\"id\": \"hyp-20260906-002-r7s1\", \"title\": \"Give multiplication a separate EX/MEM result bank\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 382.21, \"delta_pct\": -6.73, \"fmax_mhz\": 171.67, \"cycles\": 4491485, \"lut4\": 5515, \"ff\": 2124, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r7s1 (regression, -6.73%): Separating MUL into an EX/MEM bank left EX/MEM rd-to-JALR forwarding and register-file reads limiting reported Fmax despite unchanged CoreMark cycles and one MULT36X36; missing result-bank mux arcs prevent attributing the regression to bank-to-EX/WB delay.\"}\nnotes_chars=11142\n{\"id\": \"hyp-20260906-002-r8s1\", \"title\": \"Absorb ID operand capture into synchronous register-file RAM banks\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 385.46, \"delta_pct\": -5.94, \"fmax_mhz\": 173.13, \"cycles\": 4491485, \"lut4\": 2824, \"ff\": 1105, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r8s1 (regression, -5.94%): Absorbing ID/EX operand capture into two synchronous SDPX9B register-file banks nearly halved LUT/DFF use without adding CoreMark cycles, but forwarding/JALR and ALU-result selection still limited reported Fmax; missing RAM address/output logic arcs prevent attributing the regression to RAM latency.\"}\nnotes_chars=10568\n{\"id\": \"hyp-20260906-002-r9s1\", \"title\": \"Register JALR targets in a two-cycle execute path\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 341.76, \"delta_pct\": -16.6, \"fmax_mhz\": 153.99, \"cycles\": 4505747, \"lut4\": 5605, \"ff\": 2191, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r9s1 (regression, -16.60%): Inserting jalr_target_q after the full forwarding and addition cone shifted a critical path to its input while divider operand enables and EX result selection limited other seeds, reducing reported median Fmax 16.34% despite only 0.32% more 2 KB CoreMark cycles.\"}\nnotes_chars=0\n{\"id\": \"hyp-20260906-002-r10s1\", \"title\": \"Split JALR forwarding from target addition with an operand register\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 354.26, \"delta_pct\": -13.55, \"fmax_mhz\": 159.62, \"cycles\": 4505747, \"lut4\": 5586, \"ff\": 2160, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r10s1 (regression, -13.55%): Registering raw forwarded JALR operands before target addition isolated completion from live forwarding, but PC+immediate alignment/squash to ID/EX alu_op and forwarding/load-availability to div_rs2_q CE became critical, lowering median Fmax from 184.06 to 159.62 MHz despite only 0.32% more 6 KB CoreMark cycles; a target-path cut must also account for shared squash and launch controls.\"}\nnotes_chars=9459\n{\"id\": \"hyp-20260906-001-r11s0\", \"title\": \"Remove launch qualification from idle divider operand storage\", \"category\": \"micro_opt\", \"outcome\": \"improvement\", \"fitness\": 411.53, \"delta_pct\": 0.42, \"fmax_mhz\": 184.84, \"cycles\": 4491485, \"lut4\": 5485, \"ff\": 2119, \"error\": null, \"lesson\": null}\nnotes_chars=10813\n{\"id\": \"hyp-20260906-002-r11s1\", \"title\": \"Decouple fetch from backend interlocks with a two-entry instruction queue\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 311.94, \"delta_pct\": -23.88, \"fmax_mhz\": 135.43, \"cycles\": 4341607, \"lut4\": 5615, \"ff\": 2223, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r11s1 (regression, -23.88%): A two-entry fall-through FIFO in if_stage.sv saved 3.08% of stalled 6 KB CoreMark cycles, but its live-head mux through register-file reads and load-use/decode_take-to-occupancy paths cut median routed Fmax from 184.06 to 135.43 MHz, showing that empty bypass can put queue selection and consumption control on the critical path.\"}\nnotes_chars=8874\n{\"id\": \"hyp-20260906-002-r12s1\", \"title\": \"Retime writeback selection into a unified MEM/WB result register\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 353.74, \"delta_pct\": -14.04, \"fmax_mhz\": 158.88, \"cycles\": 4491485, \"lut4\": 5496, \"ff\": 2062, \"error\": null, \"lesson\": null}\nnotes_chars=0\n{\"id\": \"hyp-20260906-002-r13s1\", \"title\": \"Move high-half multiplication behind the blocking M-extension boundary\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 393.5, \"delta_pct\": -4.38, \"fmax_mhz\": 176.74, \"cycles\": 4491485, \"lut4\": 5486, \"ff\": 2154, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r13s1 (regression, -4.38%): Moving MULH/MULHU/MULHSU into div_unit doubled MULT36X36 use without changing 2 KB/6 KB CoreMark cycles, but normal ALU selection remained critical in two routed seeds and LFSR-to-ID/EX capture in the third, lowering reported median Fmax from 184.84 to 176.74 MHz.\"}\nnotes_chars=0\n{\"id\": \"hyp-20260906-002-r14s1\", \"title\": \"Isolate all multiplication behind a registered operand boundary\", \"category\": \"structural\", \"outcome\": \"regression\", \"fitness\": 385.37, \"delta_pct\": -6.36, \"fmax_mhz\": 176.71, \"cycles\": 4585465, \"lut4\": 5437, \"ff\": 2037, \"error\": null, \"lesson\": \"- 2026-09-06 hyp-20260906-002-r14s1 (regression, -6.36%): Blocking all multiplication behind div_unit.sv operand registers retained one MULT36X36 but added 2.09%/3.86% cycles in 2 KB/6 KB CoreMark, while forwarding/JALR and LFSR-to-ID/EX capture still limited routed timing and reduced reported median Fmax 4.40%; DSP isolation must overcome both multiply bubbles and the remaining nonmultiply paths.\"}\nnotes_chars=0\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"Several prior timing changes exposed the same remaining paths. I’m checking whether moving store-data forwarding to MEM can remove load-to-store bubbles without adding another mux to the ALU path.\n"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' fpga/core_bench_si.sv; sed -n '1,210p' cores/bench/test/test_pipeline.py; sed -n '1,140p' cores/bench/test/conftest.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' fpga/core_bench_si.sv; sed -n '1,210p' cores/bench/test/test_pipeline.py; sed -n '1,140p' cores/bench/test/conftest.py\"","aggregated_output":"// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the full rationale on LFSR-driven imem, dmem\n// model, and the XOR-reduce LED that keeps RVFI fan-out alive through\n// dead-output elimination.\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI fan-out (NRET=1 contract).\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  core cpu (\n    .clock            (clock),\n    .reset            (reset),\n    .io_imemAddr      (imem_addr),\n    .io_imemData      (lfsr),\n    .io_imemReady     (1'b1),\n    .io_dmemAddr      (dmem_addr),\n    .io_dmemWData     (dmem_wdata),\n    .io_dmemRData     (dmem_rdata),\n    .io_dmemWEn       (dmem_wen),\n    .io_dmemREn       (dmem_ren),\n    .io_dmemReady     (1'b1),\n    .io_rvfi_valid_0    (rvfi_valid_0),\n    .io_rvfi_order_0    (rvfi_order_0),\n    .io_rvfi_insn_0     (rvfi_insn_0),\n    .io_rvfi_trap_0     (rvfi_trap_0),\n    .io_rvfi_halt_0     (rvfi_halt_0),\n    .io_rvfi_intr_0     (rvfi_intr_0),\n    .io_rvfi_mode_0     (rvfi_mode_0),\n    .io_rvfi_ixl_0      (rvfi_ixl_0),\n    .io_rvfi_rs1_addr_0 (rvfi_rs1_addr_0),\n    .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata_0),\n    .io_rvfi_rs2_addr_0 (rvfi_rs2_addr_0),\n    .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata_0),\n    .io_rvfi_rd_addr_0  (rvfi_rd_addr_0),\n    .io_rvfi_rd_wdata_0 (rvfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // XOR-reduce all CPU outputs to a single LED bit. Without this,\n  // dead-output elimination would prune the RVFI fan-out.\n  assign led = ^{rvfi_valid_0, rvfi_order_0, rvfi_insn_0, rvfi_trap_0, rvfi_halt_0, rvfi_intr_0,\n                 rvfi_mode_0, rvfi_ixl_0, rvfi_rs1_addr_0, rvfi_rs1_rdata_0,\n                 rvfi_rs2_addr_0, rvfi_rs2_rdata_0, rvfi_rd_addr_0, rvfi_rd_wdata_0,\n                 rvfi_pc_rdata_0, rvfi_pc_wdata_0, rvfi_mem_addr_0,\n                 rvfi_mem_rmask_0, rvfi_mem_wmask_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0,\n                 imem_addr, dmem_rdata};\n\nendmodule\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport random\nimport sys\nfrom pathlib import Path\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\nfrom test_ex_result_banks import _ex_snapshot, _unpack, ID_EX, CTRL\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\ndef DIV (rd, rs1, rs2): return _r(1, rs2, rs1, 4, rd, 0x33)\ndef DIVU(rd, rs1, rs2): return _r(1, rs2, rs1, 5, rd, 0x33)\ndef REM (rd, rs1, rs2): return _r(1, rs2, rs1, 6, rd, 0x33)\ndef REMU(rd, rs1, rs2): return _r(1, rs2, rs1, 7, rd, 0x33)\ndef MUL (rd, rs1, rs2): return _r(1, rs2, rs1, 0, rd, 0x33)\ndef LUI (rd, value): return (value & 0xFFFFF000) | ((rd & 31) << 7) | 0x37\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\nasync def _protocol_tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\ndef _rvfi_snapshot(dut):\n    fields = (\"order insn trap halt intr mode ixl rs1_addr rs1_rdata \"\n              \"rs2_addr rs2_rdata rd_addr rd_wdata pc_rdata pc_wdata \"\n              \"mem_addr mem_rmask mem_wmask mem_rdata mem_wdata\").split()\n    return {f: int(getattr(dut, f\"io_rvfi_{f}_0\").value) for f in fields}\n\n\ndef _compare_protocol_trace(scenario, timeline):\n    \"\"\"Optionally record starting-RTL evidence or compare it byte for byte.\n\n    Run identical tests with PIPELINE_TRACE_MODE=record on the starting\n    RTL, then =compare on the candidate, using the same PIPELINE_TRACE_DIR.\n    The ISS comparison remains mandatory regardless of these settings.\n    \"\"\"\n    mode = os.environ.get(\"PIPELINE_TRACE_MODE\")\n    if mode is None:\n        return\n    assert mode in (\"record\", \"compare\")\n    directory = Path(os.environ[\"PIPELINE_TRACE_DIR\"])\n    key = hashlib.sha256(json.dumps(scenario, sort_keys=True).encode()).hexdigest()\n    path = directory / f\"{key}.json\"\n    evidence = json.dumps(dict(scenario=scenario, timeline=timeline), sort_keys=True)\n    if mode == \"record\":\n        directory.mkdir(parents=True, exist_ok=True)\n        path.write_text(evidence)\n    else:\n        assert path.read_text() == evidence, f\"starting RTL cycle/operand/RVFI/bus mismatch: {path}\"\n\n\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n","exit_code":0,"status":"completed"}}
