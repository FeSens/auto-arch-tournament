{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport random\nM=(1<<32)-1\nrng=random.Random(2026090600231)\n# Independent proposal-level check of two radix-4 digits per compute edge.\ndef magnitude_div(a,b):\n    q,r=a,0\n    multiples=(0,b,2*b,3*b)\n    for _ in range(8):\n        for _ in range(2):\n            trial=(r<<2)|(q>>30)\n            differences=[((trial-m)&((1<<35)-1)) for m in multiples[1:]]\n            digit=next((k for k in (3,2,1) if differences[k-1]>>34==0),0)\n            r=trial-multiples[digit]\n            assert 0<=r<=M\n            if b: assert r<b\n            q=((q<<2)|digit)&M\n    return q,r\nedges=[0,1,2,3,4,7,15,16,31,255,256,0x3fffffff,0x40000000,0x55555555,0x7fffffff,0x80000000,0x80000001,0xaaaaaaaa,0xfffffffe,M]\ncases=[(a,b) for a in edges for b in edges]\ncases += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(20000)]\nchecked=0\nfor a,b in cases:\n    for signed in (False,True):\n        sa=a-(1<<32) if signed and a>>31 else a\n        sb=b-(1<<32) if signed and b>>31 else b\n        q,r=magnitude_div(abs(sa),abs(sb))\n        if b==0:\n            got=(M,a)\n            want=(M,a)\n        else:\n            got=((-q if (sa<0)\"'!=(sb<0) else q)&M,(-r if sa<0 else r)&M)\n            eq=abs(sa)//abs(sb)\n            if (sa<0)!=(sb<0): eq=-eq\n            want=(eq&M,(sa-eq*sb)&M)\n        assert got==want,(hex(a),hex(b),signed,got,want)\n        checked+=1\nprint(f'\"'Proposal arithmetic model: {checked} signed/unsigned operand cases pass quotient, remainder and per-digit bounds; RTL not changed or evaluated.')\ntry:\n    import yaml,jsonschema\n    print('YAML/schema validation dependencies available.')\nexcept ImportError as e:\n    print('Validation dependency:',e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
