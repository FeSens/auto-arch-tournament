ssert int(dut.div_registered_result.value) == _expected(op, a, b, expected)\ncores/bench/test/test_alu.py:110:    assert int(dut.div_registered_result.value) == _expected(op, a, b, expected)\ncores/bench/test/test_alu.py:115:    previous = int(dut.div_registered_result.value)\ncores/bench/test/test_alu.py:126:    assert int(dut.div_registered_result.value) == previous, \"request destroyed the EX/MEM bank\"\ncores/bench/test/test_alu.py:131:    previous = int(dut.div_registered_result.value)\ncores/bench/test/test_alu.py:134:        # After edge 7 we are in the eighth compute interval: its result\ncores/bench/test/test_alu.py:135:        # can be consumed on edge 8, or registered and held on that edge.\ncores/bench/test/test_alu.py:141:            assert int(dut.div_registered_result.value) == previous, \"registered port has a bypass\"\ncores/bench/test/test_alu.py:146:            assert int(dut.div_registered_result.value) == offered\ncores/bench/test/test_alu.py:325:    # Each operation exercises the same eight-clock compute schedule.\ncores/bench/test/test_alu.py:373:        assert int(dut.div_registered_result.value) == (expected if cycle == 7 else 0)\ncores/bench/test/test_alu.py:385:        assert int(dut.div_registered_result.value) == expected\ncores/bench/test/test_alu.py:388:        assert int(dut.div_registered_result.value) == expected\ncores/bench/test/test_alu.py:396:        assert int(dut.div_registered_result.value) == expected\ncores/bench/test/test_alu.py:401:async def accept_on_eighth_compute_edge(dut):\ncores/bench/test/test_alu.py:408:        assert int(dut.div_registered_result.value) == 0\ncores/bench/test/test_alu.py:413:    assert int(dut.div_registered_result.value) == _expected(ALU_DIV, -101, 7, -14)\ncores/bench/test/test_alu.py:436:    assert int(dut.div_registered_result.value) == _expected(ALU_DIVU, 123, 7, 17)\ncores/bench/test/test_alu.py:455:            assert int(dut.div_registered_result.value) == 0\ncores/bench/test/test_alu.py:475:            assert int(dut.div_registered_result.value) == previous\ncores/bench/test/test_alu.py:480:            assert int(dut.div_registered_result.value) == (expected if edge == 8 else previous)\ncores/bench/test/test_alu.py:487:def test_alu_runner():\ncores/bench/test/test_alu.py:494:def test_alu_altops_runner():\ncores/bench/test/test_alu.py:495:    \"\"\"Run the identical protocol/latency suite on the formal datapath.\"\"\"\ncores/bench/test/test_alu.py:496:    from cocotb_tools.runner import get_runner\ncores/bench/test/test_alu.py:498:    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\ncores/bench/test/test_alu.py:500:    runner.build(\ncores/bench/test/test_alu.py:506:    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\",\n","exit_code":0,"status":"completed"}}
