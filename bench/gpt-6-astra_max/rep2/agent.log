{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport random\nimport sys\nfrom pathlib import Path\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\nfrom test_ex_result_banks import _ex_snapshot, _unpack, ID_EX, CTRL\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\ndef DIV (rd, rs1, rs2): return _r(1, rs2, rs1, 4, rd, 0x33)\ndef DIVU(rd, rs1, rs2): return _r(1, rs2, rs1, 5, rd, 0x33)\ndef REM (rd, rs1, rs2): return _r(1, rs2, rs1, 6, rd, 0x33)\ndef REMU(rd, rs1, rs2): return _r(1, rs2, rs1, 7, rd, 0x33)\ndef MUL (rd, rs1, rs2): return _r(1, rs2, rs1, 0, rd, 0x33)\ndef LUI (rd, value): return (value & 0xFFFFF000) | ((rd & 31) << 7) | 0x37\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\nasync def _protocol_tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\ndef _rvfi_snapshot(dut):\n    fields = (\"order insn trap halt intr mode ixl rs1_addr rs1_rdata \"\n              \"rs2_addr rs2_rdata rd_addr rd_wdata pc_rdata pc_wdata \"\n              \"mem_addr mem_rmask mem_wmask mem_rdata mem_wdata\").split()\n    return {f: int(getattr(dut, f\"io_rvfi_{f}_0\").value) for f in fields}\n\n\ndef _compare_protocol_trace(scenario, timeline):\n    \"\"\"Optionally record starting-RTL evidence or compare it byte for byte.\n\n    Run identical tests with PIPELINE_TRACE_MODE=record on the starting\n    RTL, then =compare on the candidate, using the same PIPELINE_TRACE_DIR.\n    The ISS comparison remains mandatory regardless of these settings.\n    \"\"\"\n    mode = os.environ.get(\"PIPELINE_TRACE_MODE\")\n    if mode is None:\n        return\n    assert mode in (\"record\", \"compare\")\n    directory = Path(os.environ[\"PIPELINE_TRACE_DIR\"])\n    key = hashlib.sha256(json.dumps(scenario, sort_keys=True).encode()).hexdigest()\n    path = directory / f\"{key}.json\"\n    evidence = json.dumps(dict(scenario=scenario, timeline=timeline), sort_keys=True)\n    if mode == \"record\":\n        directory.mkdir(parents=True, exist_ok=True)\n        path.write_text(evidence)\n    else:\n        assert path.read_text() == evidence, f\"starting RTL cycle/operand/RVFI/bus mismatch: {path}\"\n\n\nasync def _run_protocol(dut, program, dmem_init=None, *, stalls=False, seed=1,\n                        hold_first_store=0, reset_busy_edge=None, max_cycles=20000,\n                        memory_holds=None, fetch_waits=None, required_events=()):\n    \"\"\"Edge-accurate buses and byte-exact comparison with the unchanged ISS.\n\n    Count accepted bus requests separately from RVFI, so replaying an older\n    store/load during a divide is detected even if its retirement is hidden.\n    Observe launch/dispatch to catch wrong-path launches and finish bubbles.\n    \"\"\"\n    sys.path.insert(0, str(Path(__file__).resolve().parents[3] / \"test/cosim\"))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nxs=[json.loads(l) for l in Path('cores/bench/experiments/log.jsonl').read_text().splitlines()]\nfor x in xs:\n if x.get('category')=='structural':\n  print(x['id'], x.get('delta_pct'), x['title'])\nfor x in xs:\n if x.get('id') in ['hyp-20260906-001-r1s0','hyp-20260906-002-r11s1','hyp-20260906-002-r12s1']:\n  print('\\\\nDETAIL', x['id'])\n  n=x.get('implementation_notes','')\n  for p in n.split('\\\\n\\\\n'):\n   if any(t in p.lower() for t in ['marker','critical','load-use','load use','cycles','fifo','profile']):\n    print(p[:1100])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nxs=[json.loads(l) for l in Path('cores/bench/experiments/log.jsonl').read_text().splitlines()]\nfor x in xs:\n if x.get('category')=='structural':\n  print(x['id'], x.get('delta_pct'), x['title'])\nfor x in xs:\n if x.get('id') in ['hyp-20260906-001-r1s0','hyp-20260906-002-r11s1','hyp-20260906-002-r12s1']:\n  print('\\\\nDETAIL', x['id'])\n  n=x.get('implementation_notes','')\n  for p in n.split('\\\\n\\\\n'):\n   if any(t in p.lower() for t in ['marker','critical','load-use','load use','cycles','fifo','profile']):\n    print(p[:1100])\nPY\"","aggregated_output":"hyp-20260906-002-r1s1 31.75 Separate bounded multicycle division from the single-cycle execute path\nhyp-20260906-002-r2s1 0.85 Retiming divide writeback into a separate EX/MEM result bank\nhyp-20260906-002-r3s1 -57.65 Two radix-4 quotient stages per divider clock\nhyp-20260906-002-r4s1 1.78 Retime divider finalization using a narrow request-edge prefix\nhyp-20260906-002-r5s1 7.14 Separate pipeline payload storage from bubble and divide control\nhyp-20260906-002-r6s1 -8.01 Retime forwarding dependency comparisons into the ID/EX boundary\nhyp-20260906-002-r7s1 -6.73 Give multiplication a separate EX/MEM result bank\nhyp-20260906-002-r8s1 -5.94 Absorb ID operand capture into synchronous register-file RAM banks\nhyp-20260906-002-r9s1 -16.6 Register JALR targets in a two-cycle execute path\nhyp-20260906-002-r10s1 -13.55 Split JALR forwarding from target addition with an operand register\nhyp-20260906-002-r11s1 -23.88 Decouple fetch from backend interlocks with a two-entry instruction queue\nhyp-20260906-002-r12s1 -14.04 Retime writeback selection into a unified MEM/WB result register\nhyp-20260906-002-r13s1 -4.38 Move high-half multiplication behind the blocking M-extension boundary\n\nDETAIL hyp-20260906-001-r1s0\nImplemented opcode-only source-use predecode for load-use detection in the\nbench core. OP (including all RV32M instructions), STORE, BRANCH, and unknown\nopcodes check both sources; OP-IMM, LOAD, and JALR check rs1; LUI, AUIPC, JAL,\nMISC-MEM, and SYSTEM check neither. The nonzero load-destination guard remains.\nDecoder legality, pipeline depth, bus/redirect priorities, MEM/WB hold behavior,\nand the nret=1 top-level port set are unchanged.\n- Exact requested Verilator lint: PASS, no warnings.\n- Formal: PASS, **53 passed / 0 failed**, after **one fix attempt** (two complete\n  invocations). Used the unchanged `formal/run_all.sh`, `wrapper_si.sv`,\n  `checks_si.cfg`, and upstream checks, with ALTOPS and the original depths.\n- Cocotb: PASS, **85 tests** across all five existing runners, including\n  18 pipeline tests and the actual RV32M arithmetic vectors.\n- Negative control: the new ADDI and EBREAK timing tests both fail on the\n  original bench RTL, reporting a two-cycle load/consumer gap instead of one.\n- Unchanged `test/cosim/run_cosim.py` selftest: PASS, **115 retirements**.\n  Repeating the same field-by-field comparison with both `--istall --dstall`\n  also passes all 115 retirements.\n- Fresh CoreMark build from unchanged sources: `COREMARK_SIZE=6000`,\n  `COREMARK_OPT=-O3`, `ITERATIONS=10`, both bus-stall flags. PASS: no OOB access,\n  EBREAK reached, `crclist=0xd4b0`, `crcmatrix=0xbe52`, `crcstate=0x5e47`, and\n  the literal `Correct operation validated.`. Timing markers are 56,393 and\n  32,893,064, giving **32,836,671 br\nValidation copies, builds, traces, and logs live under\n`$TMPDIR/load-use-hyp-20260906-001-r1s0/`; protected workspace files were not\nchanged. Final formal logs are in `formal/last_run-85124.log` and\n`formal/riscv-formal/cores/bench-85124/checks/` under that scratch directory.\nThe initial counterexample is retained in `formal-attempt1/`.\n\nDETAIL hyp-20260906-002-r11s1\n- `if_stage.sv` now holds two fixed PC/instruction slots, a two-bit occupancy, a one-bit head pointer, and a FENCE.I barrier bit. Empty bypass adds no fetch stage. Full simultaneous pop/push replaces the consumed slot and preserves order. Fetch acceptance independently fills free capacity during load-use, memory, and divider holds.\n- The fetch address remains the direct output of a dedicated registered PC. Reset and EX redirect override acceptance and capacity, discard the same-cycle response, and clear queue/barrier ownership. Slot payloads have write enables without reset or redirect data muxes. Repeated redirects from a memory-held EX instruction are harmless.\n- `core.sv` derives consumption from the actual valid ID/EX capture conditions. Hazard readiness uses selected-head availability, which depends only on occupancy, instruction-bus readiness, and the registered barrier. Availability has no dependency on consumption or squash outputs. Decode, immediate generation, raw-source hazard comparisons, and RVFI PC all consume the same head.\n- FENCE.I acceptance blocks younger fetch acc\n- Required Verilator lint command: PASS, zero warnings.\n- Existing unit suite: accepted 9 pytest runners / 140 cocotb cases PASS; candidate 9 runners / 145 cases PASS. Candidate includes 27 pipeline cases. The final pipeline rerun after adding an exact marker-window assertion passed all 27 cases.\n- Local formal: PASS, 53/53 checks on both accepted and candidate RTL, including `liveness`, `unique`, illegal-instruction, PC, and register checks. Candidate passed its first formal run; zero RTL formal fix retries. Ran unchanged `bash formal/run_all.sh` in isolated scratch copies with `CORE_NAME=bench RTL_DIR=cores/bench/rtl JOBS=6` and the existing Miniconda Python on PATH (the default Python lacks the required dependencies). Automatic selection retained `wrapper_si.sv`, `checks_si.cfg`, and their original depths/ALTOPS defines.\n- Unchanged Verilator harness / Python ISS selftest cosimulation: PASS on both cores for both-bus stall seeds `0xDEADBEEF`, 1, 42, and 99, 115 exact retirements each. Directed queue programs also compare all meaningful RVFI fields against the unchanged ISS and che\nIdentical ELFs: `TOTAL_DATA_SIZE=6000` and separately 2000, `ITERATIONS=10`, actual compiler flag `-O3`, RV32IM/ILP32. Both buses use the unchanged harness's approximately 22% random stalls. Only stop-minus-start MMIO marker cycles count.\n| Working set | Stall seed | Accepted marker cycles | Queue marker cycles | Saving |\n| --- | --- | ---: | ---: | ---: |\n| 6 KB | 0xDEADBEEF | 32,836,671 | 31,824,980 | 3.0810% |\n| 6 KB | 1 | 32,838,499 | 31,826,861 | 3.0806% |\n| 6 KB | 42 | 32,840,423 | 31,828,643 | 3.0809% |\n| 2 KB | 0xDEADBEEF | 4,491,485 | 4,341,607 | 3.3369% |\n| 2 KB | 1 | 4,490,174 | 4,339,252 | 3.3612% |\n| 2 KB | 42 | 4,493,775 | 4,343,014 | 3.3549% |\nAll twelve CoreMark runs completed with `ebreak:true`, `oob:false`, valid marker brackets, ten iterations, and the exact UART literal `Correct operation validated.`. Every 6 KB run has canonical `crclist=0xd4b0`, `crcmatrix=0xbe52`, `crcstate=0x5e47`, plus `seedcrc=0x8a02` and `crcfinal=0x5949`. Every 2 KB run passes the unchanged `validate_coremark_uart` evaluator. The port's printed compiler-flags string remains the existing hardcoded `-O2`; the captured build command actually used `-O3`. The 6 KB UART's `CoreMark Size: 2000` is the per-algorithm size and accompanies its `6k performance run parameters` banner.\nReviewed all three canonical routed reports. Accepted seeds 1/3 are limited by forwarding through JALR target arithmetic to the fetch-PC register (5.43/5.56 ns); accepted seed 2 by the live instruction-to-ID/register-file path (5.23 ns). Candidate seeds 1/3 are limited by live instruction selection through register-file read logic into ID payload (7.38/7.78 ns); candidate seed 2 by live instruction/load-use/consumption logic into queue occupancy (7.17 ns). The queue therefore exposes exactly the frontend mux and full/pop-control risks identified in the hypothesis. Backend arithmetic and forwarding source files remain byte-identical to the accepted snapshot.\nSupplementary routes with `--report --detailed-timing-report` reproduced each candidate seed's canonical Fmax exactly to reported precision. The reports include ID capture, queue occupancy, and the fetch-PC target destination in every seed. Synthesized net aliases confirm the critical ID endpoints in seeds 1/3 are `rs1_val[1]` / `rs1_val[3]`. Absolute net-arrival values were not substituted for the canonical clock-path Fmax. A preliminary attempt to reload an already routed JSON solely for reporting hit a nextpnr internal assertion; the supplementary reports instead came from complete successful routes with the original synthesis input and constraints.\n\nDETAIL hyp-20260906-002-r12s1\n","exit_code":0,"status":"completed"}}
