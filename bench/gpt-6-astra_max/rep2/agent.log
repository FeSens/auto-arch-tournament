{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport random\nimport yaml,jsonschema\ncurrent=Path('cores/bench/rtl')\nsaved=Path('.tmp/divider-idle-r11s0/candidate/cores/bench/rtl')\nassert all((saved/p.name).read_bytes()==p.read_bytes() for p in current.glob('*.sv'))\nprint('Saved r11s0 timing evidence matches current bench RTL byte-for-byte.')\nmask=(1<<32)-1\nsign32=lambda v:v-(1<<32) if v>>31 else v\nrng=random.Random(1200)\nbounds=[0,1,2,3,0x7fff,0x8000,0xffff,0x10000,0x7ffffffe,0x7fffffff,0x80000000,0x80000001,0xfffffffe,0xffffffff]\npairs=[(a,b) for a in bounds for b in bounds]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000)]\ncount=0\nfor a,b in pairs:\n    for op in [11,12,13,14]:\n        a33=(((a>>31)&(1-(op&1)))<<32)|a\n        b33=(((b>>31)&(1-(op&1))&(1-((op>>1)&1)))<<32)|b\n        aa=a33-(1<<33) if a33>>32 else a33\n        bb=b33-(1<<33) if b33>>32 else b33\n        product=(aa*bb)&((1<<66)-1)\n        got=(product>>(32 if op&4 else 0))&mask\n        expected={11:lambda:a*b,12:lambda:(sign32(a)*sign32(b))>>32,13:lambda:(a*b)>>32,14:lambda:(sign32(a)*b)>>32}[op]()&mask\n        assert got==expected,(op,a,b,got,expected)\n        count+=1\nprint(f'Explicit 33-bit product and partial-opcode mode formulas match {count} independent RV32M arithmetic checks.')\nprint('PyYAML and jsonschema are available for artifact validation.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
