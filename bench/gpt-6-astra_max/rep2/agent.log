_COUT_ALU_CIN_SUM[4] (15,16) -> (17,16)\nInfo:                          Sink cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1_I3_MUX2_LUT5_O_S0_MUX2_LUT5_O.S0\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.10  2.71 Source cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1_I3_MUX2_LUT5_O_S0_MUX2_LUT5_O.O\nInfo:    routing  0.38  3.09 Net cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1_I3_MUX2_LUT5_O_S0[4] (17,16) -> (17,15)\nInfo:                          Sink cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1_I3_MUX2_LUT5_O.S0\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.10  3.20 Source cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1_I3_MUX2_LUT5_O.O\nInfo:    routing  0.88  4.07 Net cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1_I3[3] (17,15) -> (17,15)\nInfo:                          Sink cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1.I3\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.37  4.45 Source cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3_LUT4_F_1.F\nInfo:    routing  0.40  4.85 Net cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F_I3[3] (17,15) -> (15,15)\nInfo:                          Sink cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F.I3\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.37  5.22 Source cpu.u_ex.reg_q_DFFR_Q_72_D_LUT4_F.F\nInfo:    routing  0.00  5.22 Net cpu.u_ex.reg_q_DFFR_Q_72_D (15,15) -> (15,15)\nInfo:                          Sink cpu.u_ex.reg_q_DFFR_Q_72.D\nInfo:      setup  0.04  5.25 Source cpu.u_ex.reg_q_DFFR_Q_72.D\nInfo: 2.35 ns logic, 2.90 ns routing\nInfo: Critical path report for clock 'cpu.clock' (posedge -> posedge):\nInfo:       type curr  total name\nInfo:   clk-to-q  0.23  0.23 Source cpu.u_mem.reg_q_DFFR_Q_133.Q\nInfo:    routing  0.40  0.63 Net rvfi_insn_0[8] (10,32) -> (8,31)\nInfo:                          Sink cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F_I2_MUX2_LUT5_O_I1_LUT4_F.I3\nInfo:                          Defined in:\nInfo:                               fpga/core_bench_si.sv:41.16-41.27\nInfo:      logic  0.37  1.00 Source cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F_I2_MUX2_LUT5_O_I1_LUT4_F.F\nInfo:    routing  0.00  1.00 Net cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F_I2_MUX2_LUT5_O_I1 (8,31) -> (8,31)\nInfo:                          Sink cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F_I2_MUX2_LUT5_O.I1\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:151.13-151.15\nInfo:      logic  0.27  1.27 Source cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F_I2_MUX2_LUT5_O.O\nInfo:    routing  0.91  2.18 Net cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F_I2[2] (8,31) -> (10,25)\nInfo:                          Sink cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F.I2\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.46  2.64 Source cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O_LUT4_F.F\nInfo:    routing  0.67  3.31 Net cpu.u_fwd.ex_mem_w_en_LUT3_I1_F_MUX2_LUT5_S0_1_O[4] (10,25) -> (8,20)\nInfo:                          Sink cpu.u_ex.u_alu.a_LUT3_F_16_I2_MUX2_LUT5_O.S0\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.10  3.42 Source cpu.u_ex.u_alu.a_LUT3_F_16_I2_MUX2_LUT5_O.O\nInfo:    routing  0.40  3.82 Net cpu.u_ex.u_alu.a_LUT3_F_16_I2[2] (8,20) -> (7,19)\nInfo:                          Sink cpu.u_if.pc_DFFRE_Q_31_D_LUT3_F_I1_LUT4_F_I3_ALU_SUM_1_CIN_ALU_COUT_CIN_ALU_COUT.I0\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.55  4.37 Source cpu.u_if.pc_DFFRE_Q_31_D_LUT3_F_I1_LUT4_F_I3_ALU_SUM_1_CIN_ALU_COUT_CIN_ALU_COUT.COUT\nInfo:    routing  0.00  4.37 Net cpu.u_if.pc_DFFRE_Q_31_D_LUT3_F_I1_LUT4_F_I3_ALU_SUM_1_CIN_ALU_COUT_CIN (7,19) -> (7,19)\nInfo:                          Sink cpu.u_if.pc_DFFRE_Q_31_D_LUT3_F_I1_LUT4_F_I3_ALU_SUM_1_CIN_ALU_COUT.CIN\nInfo:                          Defined in:\nInfo:                               cores/bench/rtl/ex_stage.sv:141.19-141.31\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/arith_map.v:57.7-63.5\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_sim.v:1033.25-1033.29\nInfo:      logic  0.47  4.84 Source cpu.u_if.pc_DFFRE_Q_31_D_LUT3_F_I1_LUT4_F_I3_ALU_SUM_1_CIN_ALU_COUT.SUM\nInfo:    routing  0.17  5.01 Net cpu.u_if.pc_DFFRE_Q_31_D_LUT3_F_I1_LUT4_F_I3_ALU_SUM_1_CIN_ALU_COUT_SUM[3] (7,19) -> (7,20)\nInfo:                          Sink cpu.u_if.pc_DFFRE_Q_D_LUT4_F.I3\nInfo:                          Defined in:\nInfo:                               /opt/homebrew/bin/../share/yosys/gowin/cells_map.v:130.20-130.21\nInfo:      logic  0.37  5.38 Source cpu.u_if.pc_DFFRE_Q_D_LUT4_F.F\nInfo:    routing  0.00  5.38 Net cpu.u_if.pc_DFFRE_Q_D (7,20) -> (7,20)\nInfo:                          Sink cpu.u_if.pc_DFFRE_Q.D\nInfo:      setup  0.04  5.41 Source cpu.u_if.pc_DFFRE_Q.D\nInfo: 2.86 ns logic, 2.55 ns routing\n\"\"\"Direct EX ownership checks, including holds unavailable from core's bus.\n\nThe real core stalls EX/MEM only for a memory instruction, so a divide\nowner normally advances immediately. This harness also holds that owner\nand blocks terminal acceptance to verify the EX interface's full contract.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\n\n# Packed bundle layouts from core_pkg.sv, listed MSB first.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n         (\"ctrl\", sum(w for _, w in CTRL)), (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32),\n          (\"ctrl\", sum(w for _, w in CTRL)), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, **values):\n    result = 0\n    for name, width in layout:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    return fields\n\n\ndef _ex_snapshot(ex):\n    return _unpack(EX_MEM, int(ex.out.value))\n\n\ndef _drive(dut, op=ALU_ADD, a=123, b=7, rd=3, pc=0x80, *, jump=False, memory=False,\n           valid=True):\n    ctrl = _pack(CTRL, alu_op=op, reg_write=1, is_jump=int(jump),\n                 mem_read=int(memory), mem_width=2)\n    funct3 = {ALU_DIV: 4, ALU_DIVU: 5, ALU_REM: 6, ALU_REMU: 7}.get(op, 0)\n    instr = ((int(op != ALU_ADD) << 25) | (2 << 20) | (1 << 15) |\n             (funct3 << 12) | (rd << 7) | 0x33)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=pc, rs1_val=a, rs2_val=b,\n                                    rd=rd, rs1_addr=1, rs2_addr=2,\n                                    ctrl=ctrl if valid else 0, instr=instr, valid=int(valid))\n\n\ndef _assert_bubble(dut):\n    fields = _ex_snapshot(dut)\n    assert fields[\"valid\"] == 0, \"inactive payload became an EX/MEM owner\"\n    assert fields[\"ctrl\"] == 0, \"bubble retained a write/request/forwarding control\"\n    assert int(dut.div_result_sel_q.value) == 0\n    assert fields[\"alu_result\"] == int(dut.mem_addr.value)\n\n\ndef _assert_div_snapshots(dut, a, b):\n    assert int(dut.div_rs1_q.value) == a & 0xFFFFFFFF\n    assert int(dut.div_rs2_q.value) == b & 0xFFFFFFFF\n\n\ndef _expected(op, a, b, real):\n    if os.environ.get(\"TEST_ALTOPS\") == \"1\":\n        masks = {ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n                 ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1}\n        return ((a - b) ^ masks[op]) & 0xFFFFFFFF\n    return real & 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_ex_mem_load.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n    assert int(dut.div_result_sel_q.value) == 0\n    assert int(dut.div_registered_result.value) == 0\n    _assert_div_snapshots(dut, 0, 0)\n    dut.reset.value = 0\n\n\nasync def _launch_and_offer(dut, op, a, b, real, *, rd=3):\n    previous = int(dut.div_registered_result.value)\n    _drive(dut, op, a, b, rd)\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_valid.value) == 1\n    assert int(dut.div_req_ready.value) == 1\n    await _tick(dut)\n    assert int(dut.div_result_sel_q.value) == 0\n    _assert_bubble(dut)  # older owner drains even though payload captures\n    assert int(dut.div_registered_result.value) == previous, \"prefix setup destroyed the old bank\"\n    for edge in range(1, 8):\n        # Forwarding sources may drain/change after the operand snapshot.\n        dut.fwd_rs1_sel.value = 1\n        dut.fwd_rs2_sel.value = 2\n        dut.fwd_ex_mem.value = (0xF1234567 * edge) & 0xFFFFFFFF\n        dut.fwd_mem_wb.value = edge & 3\n        await _tick(dut)\n        assert int(dut.div_resp_valid.value) == (edge == 7)\n        assert int(dut.div_registered_result.value) == previous\n        assert int(dut.div_result_sel_q.value) == 0\n        _assert_bubble(dut)\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    expected = _expected(op, a, b, real)\n    assert int(dut.div_resp_data.value) == expected\n    return expected\n\n\n@cocotb.test()\nasync def bank_owner_hold_launch_bubble_and_link(dut):\n    await _reset(dut)\n    _drive(dut, a=0x120, b=0x14)\n    await _tick(dut)\n    assert _ex_snapshot(dut)[\"alu_result\"] == 0x134\n    assert int(dut.mem_addr.value) == 0x134\n    assert int(dut.div_result_sel_q.value) == 0\n\n    expected = await _launch_and_offer(dut, ALU_DIV, -101, 7, -14)\n    assert int(dut.div_accept.value) == 1\n    await _tick(dut)\n    owner = int(dut.out.value)\n    fields = _ex_snapshot(dut)\n    assert fields[\"alu_result\"] == expected\n    assert int(dut.mem_addr.value) == 0, \"divide result entered the memory address bank\"\n    assert fields[\"valid\"] == 1 and fields[\"rd\"] == 3\n    assert fields[\"rs1_val\"] == 0xFFFFFF9B and fields[\"rs2_val\"] == 7\n    assert int(dut.div_result_sel_q.value) == 1\n\n    # A newer divide must not launch or overwrite the bank while EX/MEM\n    # is held, even for longer than the entire divider latency.\n    dut.stall.value = 1\n    _drive(dut, ALU_REM, 123, 7, rd=4)\n    for cycle in range(12):\n        _drive(dut, ALU_REM if cycle & 1 else ALU_DIV, 123 + cycle,\n               15 - cycle, rd=4 + cycle, pc=0x100 + 4 * cycle)\n        await _tick(dut)\n        assert int(dut.div_req_valid.value) == 0\n        assert int(dut.div_active_q.value) == 0\n        _assert_div_snapshots(dut, 123 + cycle, 15 - cycle)\n        assert int(dut.div_result_sel_q.value) == 1\n        assert int(dut.div_registered_result.value) == expected\n        assert int(dut.out.value) == owner\n    dut.stall.value = 0\n    next_expected = await _launch_and_offer(dut, ALU_REM, 123, 7, 4, rd=4)\n    assert next_expected != expected\n    await _tick(dut)\n    assert _ex_snapshot(dut)[\"alu_result\"] == next_expected\n    assert _ex_snapshot(dut)[\"rd\"] == 4\n\n    # Selecting the normal bank must use the existing PC+4 link result.\n\"\"\"Unit tests for rtl/alu.sv.\n\nRV32I and multiply remain combinational. DIV/REM accept a request,\ncompute for exactly eight clocks, and hold a response until accepted.\nEvery original arithmetic vector is retained, including in the real build.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"TEST_ALTOPS\") == \"1\"\nALT_MASK = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n\n\ndef _expected(op, a, b, real):\n    if ALTOPS and op in ALT_MASK:\n        v = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        return (v ^ ALT_MASK[op]) & MASK32\n    return real & MASK32\n\n\ndef _signed(v):\n    v &= MASK32\n    return v - (1 << 32) if v & (1 << 31) else v\n\n\ndef _div_reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    remainder = op in (ALU_REM, ALU_REMU)\n    if b == 0:\n        return a if remainder else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        a, b = _signed(a), _signed(b)\n    q = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        q = -q\n    return ((a - q * b) if remainder else q) & MASK32\n\n\ndef _check_magnitude_state(dut, op, a, b, bits):\n    \"\"\"Independent integer reference for the consumed dividend prefix.\"\"\"\n    if ALTOPS:\n        assert int(dut.u_div.alt_result_q.value) == _expected(op, a, b, 0)\n        return\n    a, b = a & MASK32, b & MASK32\n    signed = op in (ALU_DIV, ALU_REM)\n    magnitude = abs(_signed(a)) if signed else a\n    divisor = abs(_signed(b)) if signed else b\n    prefix = magnitude >> (32 - bits)\n    q, r = divmod(prefix, divisor) if divisor else ((1 << bits) - 1, prefix)\n    expected_q = ((magnitude << bits) | q) & MASK32\n    assert int(dut.u_div.quotient_q.value) == expected_q, (\n        f\"prefix Q: op={op} a={a:08x} b={b:08x} bits={bits} expected={expected_q:08x}\"\n    )\n    assert int(dut.u_div.remainder_q.value) == r, (\n        f\"prefix R: op={op} a={a:08x} b={b:08x} bits={bits} expected={r:08x}\"\n    )\n    assert int(dut.u_div.divisor_q.value) == divisor\n    assert int(dut.u_div.dividend_q.value) == a\n    assert int(dut.u_div.dividend_negative_q.value) == (signed and bool(a >> 31))\n    assert int(dut.u_div.divisor_negative_q.value) == (signed and bool(b >> 31))\n    assert int(dut.u_div.zero_divisor_q.value) == (b == 0)\n    assert int(dut.u_div.want_rem_q.value) == (op in (ALU_REM, ALU_REMU))\n\n\ndef _check_reset_storage(dut):\n","exit_code":0,"status":"completed"}}
