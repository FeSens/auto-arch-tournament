*************************+\nInfo: [ 79225,  79510) |************************************************************ \nInfo: [ 79510,  79795) |*****************************************+\nInfo: [ 79795,  80080) |*********+\nInfo: [ 80080,  80365) |*****+\nInfo: [ 80365,  80650) |******+\nInfo: [ 80650,  80935) |***+\nInfo: [ 80935,  81220) |*********+\nInfo: [ 81220,  81505) |**************+\nInfo: [ 81505,  81790) |************+\nInfo: [ 81790,  82075) |*************+\nInfo: [ 82075,  82360) |*************+\nInfo: [ 82360,  82645) |************+\nInfo: [ 82645,  82930) |*****+\n\nInfo: Program finished normally.\n\"\"\"Unit tests for rtl/alu.sv.\n\nRV32I and multiply remain combinational. DIV/REM accept a request,\ncompute for exactly eight clocks, and hold a response until accepted.\nEvery original arithmetic vector is retained, including in the real build.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"TEST_ALTOPS\") == \"1\"\nALT_MASK = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n\n\ndef _expected(op, a, b, real):\n    if ALTOPS and op in ALT_MASK:\n        v = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        return (v ^ ALT_MASK[op]) & MASK32\n    return real & MASK32\n\n\ndef _signed(v):\n    v &= MASK32\n    return v - (1 << 32) if v & (1 << 31) else v\n\n\ndef _div_reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    remainder = op in (ALU_REM, ALU_REMU)\n    if b == 0:\n        return a if remainder else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        a, b = _signed(a), _signed(b)\n    q = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        q = -q\n    return ((a - q * b) if remainder else q) & MASK32\n\n\ndef _check_magnitude_state(dut, op, a, b, bits):\n    \"\"\"Independent integer reference for the consumed dividend prefix.\"\"\"\n    if ALTOPS:\n        assert int(dut.u_div.alt_result_q.value) == _expected(op, a, b, 0)\n        return\n    a, b = a & MASK32, b & MASK32\n    signed = op in (ALU_DIV, ALU_REM)\n    magnitude = abs(_signed(a)) if signed else a\n    divisor = abs(_signed(b)) if signed else b\n    prefix = magnitude >> (32 - bits)\n    q, r = divmod(prefix, divisor) if divisor else ((1 << bits) - 1, prefix)\n    expected_q = ((magnitude << bits) | q) & MASK32\n    assert int(dut.u_div.quotient_q.value) == expected_q, (\n        f\"prefix Q: op={op} a={a:08x} b={b:08x} bits={bits} expected={expected_q:08x}\"\n    )\n    assert int(dut.u_div.remainder_q.value) == r, (\n        f\"prefix R: op={op} a={a:08x} b={b:08x} bits={bits} expected={r:08x}\"\n    )\n    assert int(dut.u_div.divisor_q.value) == divisor\n    assert int(dut.u_div.dividend_q.value) == a\n    assert int(dut.u_div.dividend_negative_q.value) == (signed and bool(a >> 31))\n    assert int(dut.u_div.divisor_negative_q.value) == (signed and bool(b >> 31))\n    assert int(dut.u_div.zero_divisor_q.value) == (b == 0)\n    assert int(dut.u_div.want_rem_q.value) == (op in (ALU_REM, ALU_REMU))\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_resp_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value) == 1\n    assert int(dut.div_resp_valid.value) == 0\n    assert int(dut.div_registered_result.value) == 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    is_div = op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n    actual = int((dut.div_resp_data if is_div else dut.out).value) & MASK32\n    if is_div:\n        assert int(dut.out.value) == 0, \"live divide leaked into the normal ALU path\"\n    expected = _expected(op, a, b, expected)\n    assert actual == (expected & MASK32), (\n","exit_code":0,"status":"completed"}}
