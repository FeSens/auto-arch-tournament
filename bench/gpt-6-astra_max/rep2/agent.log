t.b.value = b & MASK32\ncores/bench/test/test_alu.py:112:    dut.div_req_valid.value = 1\ncores/bench/test/test_alu.py:114:    assert int(dut.div_req_ready.value) == 1\ncores/bench/test/test_alu.py:116:    dut.div_req_valid.value = 0\ncores/bench/test/test_alu.py:117:    assert int(dut.div_req_ready.value) == 0\ncores/bench/test/test_alu.py:118:    assert int(dut.div_resp_valid.value) == 0\ncores/bench/test/test_pipeline.py:75:def LUI (rd, value): return (value & 0xFFFFF000) | ((rd & 31) << 7) | 0x37\ncores/bench/test/test_pipeline.py:84:    see the new value.\ncores/bench/test/test_pipeline.py:95:    dut.reset.value = 1\ncores/bench/test/test_pipeline.py:96:    dut.io_imemData.value = 0\ncores/bench/test/test_pipeline.py:97:    dut.io_dmemRData.value = 0\ncores/bench/test/test_pipeline.py:100:    dut.io_imemReady.value = 1\ncores/bench/test/test_pipeline.py:101:    dut.io_dmemReady.value = 1\ncores/bench/test/test_pipeline.py:106:    dut.reset.value = 0\ncores/bench/test/test_pipeline.py:107:    dut.io_imemData.value = imem.get(0, EBREAK())\ncores/bench/test/test_pipeline.py:114:        ia        = int(dut.io_imemAddr.value)\ncores/bench/test/test_pipeline.py:115:        da        = int(dut.io_dmemAddr.value)\ncores/bench/test/test_pipeline.py:116:        wen       = int(dut.io_dmemWEn.value)\ncores/bench/test/test_pipeline.py:117:        rvfi_v    = int(dut.io_rvfi_valid_0.value)\ncores/bench/test/test_pipeline.py:121:            wdata = int(dut.io_dmemWData.value)\ncores/bench/test/test_pipeline.py:134:                \"order\":     int(dut.io_rvfi_order_0.value),\ncores/bench/test/test_pipeline.py:135:                \"insn\":      int(dut.io_rvfi_insn_0.value),\ncores/bench/test/test_pipeline.py:136:                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\ncores/bench/test/test_pipeline.py:137:                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\ncores/bench/test/test_pipeline.py:138:                \"rd\":        int(dut.io_rvfi_rd_addr_0