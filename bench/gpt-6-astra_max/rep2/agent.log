2),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32),\n          (\"ctrl\", sum(w for _, w in CTRL)), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, **values):\n    result = 0\n    for name, width in layout:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    return fields\n\n\ndef _ex_snapshot(ex):\n    return _unpack(EX_MEM, int(ex.out.value))\n\n\ndef _drive(dut, op=ALU_ADD, a=123, b=7, rd=3, pc=0x80, *, jump=False, memory=False,\n           valid=True):\n    ctrl = _pack(CTRL, alu_op=op, reg_write=1, is_jump=int(jump),\n                 mem_read=int(memory), mem_width=2)\n    funct3 = {ALU_DIV: 4, ALU_DIVU: 5, ALU_REM: 6, ALU_REMU: 7}.get(op, 0)\n    instr = ((int(op != ALU_ADD) << 25) | (2 << 20) | (1 << 15) |\n             (funct3 << 12) | (rd << 7) | 0x33)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=pc, rs1_val=a, rs2_val=b,\n                                    rd=rd, rs1_addr=1, rs2_addr=2,\n                                    ctrl=ctrl if valid else 0, instr=instr, valid=int(valid))\n\n\ndef _assert_bubble(dut):\n    fields = _ex_snapshot(dut)\n    assert fields[\"valid\"] == 0, \"inactive payload became an EX/MEM owner\"\n    assert fields[\"ctrl\"] == 0, \"bubble retained a write/request/forwarding control\"\n    assert int(dut.div_result_sel_q.value) == 0\n    assert fields[\"alu_result\"] == int(dut.mem_addr.value)\n\n\ndef _assert_div_snapshots(dut, a, b):\n    assert int(dut.div_rs1_q.value) == a & 0xFFFFFFFF\n    assert int(dut.div_rs2_q.value) == b & 0xFFFFFFFF\n\n\ndef _expected(op, a, b, real):\n    if os.environ.get(\"TEST_ALTOPS\") == \"1\":\n        masks = {ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n                 ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1}\n        return ((a - b) ^ masks[op]) & 0xFFFFFFFF\n    return real & 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_ex_mem_load.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n    assert int(dut.div_result_sel_q.value) == 0\n194:    assert _ex_snapshot(dut)[\"alu_result\"] == expected\n210:        held_address = int(dut.mem_addr.value)\n225:            assert int(dut.mem_addr.value) == held_address\n239:        assert _ex_snapshot(dut)[\"alu_result\"] == expected\n244:        # A following memory instruction owns the normal bank throughout\n245:        # an actual memory-style hold; the retained divide bank is unused.\n249:        assert _ex_snapshot(dut)[\"alu_result\"] == 0x404\n250:        assert int(dut.mem_addr.value) == 0x404\n258:            assert int(dut.mem_addr.value) == 0x404\n264:async def normal_bank_captures_bubbles_computation_acceptance_and_consumer(dut):\n268:    assert int(dut.mem_addr.value) == 0x404\n271:    # the inactive normal bank on every compute/accept edge. Legal DIV\n272:    # normally produces constant zero in that bank; the integrated ISS\n278:    assert int(dut.mem_addr.value) == 0x104\n286:        assert int(dut.mem_addr.value) == pc + 4, \"normal capture was completion-gated\"\n295:            assert fields[\"alu_result\"] == expected\n298:    owner, address = int(dut.out.value), int(dut.mem_addr.value)\n304:        assert int(dut.mem_addr.value) == address\n310:    # The first dependent consumer uses the selected completion bank,\n317:    assert _ex_snapshot(dut)[\"alu_result\"] == (expected + 17) & 0xFFFFFFFF\n328:        assert int(dut.mem_addr.value) == 0x731 + 5 * edge\n337:    assert int(dut.mem_addr.value) == 0\n343:async def prefix_seventh_edge_and_corrected_bank_metadata(dut):\n372:        assert fields[\"alu_result\"] == expected\n375:        assert int(dut.mem_addr.value) == 0\n408:            assert int(dut.mem_addr.value) == 0x604\n416:            dut.fwd_ex_mem.value = 0x600 + edge * 4  # unavailable load address\n453:        held_owner, held_address = int(dut.out.value), int(dut.mem_addr.value)\n463:            assert int(dut.mem_addr.value) == held_address\n475:        assert fields[\"write_data\"] == b and fields[\"alu_result\"] == expected\n487:            assert int(dut.mem_addr.value) == 0\n493:def test_ex_result_banks_runner():\n496:               test_module=\"test_ex_result_banks\")\n499:def test_ex_result_banks_altops_runner():\n509:    runner.test(hdl_toplevel=\"ex_stage\", test_module=\"test_ex_result_banks\",\n","exit_code":0,"status":"completed"}}
