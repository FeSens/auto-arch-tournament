line.py:445:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\ncores/bench/test/test_pipeline.py:446:    [rj] = _by_insn(rets, JAL(1, 8))\ncores/bench/test/test_pipeline.py:459:        ADDI(6, 0, 99),        # PC=8;  wrong-path\ncores/bench/test/test_pipeline.py:551:               ADD(7, 3, 6), ADDI(8, 7, 1), EBREAK()]\ncores/bench/test/test_pipeline.py:554:        \"ordinary integer/multiply instructions gained latency\", cycles\ncores/bench/test/test_pipeline.py:565:        ADDI(7, 6, 1), MUL(8, 3, 2),\ncores/bench/test/test_pipeline.py:566:        DIV(9, 1, 2), BEQ(9, 3, 8),      # forward division into a taken branch\ncores/bench/test/test_pipeline.py:570:        DIV(15, 12, 14), SW(8, 15, 0),    # forward quotient into store address\ncores/bench/test/test_pipeline.py:585:    assert all(b - a == 9 for a, b in zip(divide_cycles, divide_cycles[1:]))\ncores/bench/test/test_pipeline.py:592:               JAL(0, 8), DIV(31, 0, 0), DIVU(5, 1, 2), EBREAK()]\ncores/bench/test/test_pipeline.py:603:        LW(4, 0, 0x404), SW(4, 0, 0x408), REM(5, 4, 2),\ncores/bench/test/test_pipeline.py:605:        REMU(8, 3, 7), BEQ(8, 8, 8), DIV(31, 0, 0), EBREAK(),\ncores/bench/test/test_pipeline.py:607:    for seed in (1, 2, 3, 10, 42, 99):\ncores/bench/test/test_pipeline.py:608:        await _run_protocol(dut, program, {0x400: 101, 0x404: 0xFFFFFF9B},\ncores/bench/test/test_pipeline.py:615:    program = [LUI(28, 0x1000)]\ncores/bench/test/test_pipeline.py:618:    edges = [0, 1, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0x80000001]\ncores/bench/test/test_pipeline.py:619:    for i in range(48):\ncores/bench/test/test_pipeline.py:620:        data[0x1000 + i * 8] = rng.getrandbits(32) if i >= 6 else edges[i]\ncores/bench/test/test_pipeline.py:621:        data[0x1004 + i * 8] = rng.getrandbits(32) if i >= 6 else edges[5 - i]\ncores/bench/test/test_pipeline.py:622:        program += [LW(1, 28, i * 8), LW(2, 28, i * 8 + 4),\ncores/bench/test/test_pipeline.py:624:       