{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat formal/checks_si.cfg; sed -n '1,120p' formal/riscv-formal/checks/rvfi_liveness_check.sv; rg --files --hidden .tmp/hyp-r6s2-check-n04i83l0 | rg 'liveness|implementation_notes|timing|result' | head -40\"","aggregated_output":"[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n// Copyright (C) 2017  Claire Xenia Wolf <claire@yosyshq.com>\n//\n// Permission to use, copy, modify, and/or distribute this software for any\n// purpose with or without fee is hereby granted, provided that the above\n// copyright notice and this permission notice appear in all copies.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\" AND THE AUTHOR DISCLAIMS ALL WARRANTIES\n// WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF\n// MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR\n// ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n// WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN\n// ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\nmodule rvfi_liveness_check (\n\tinput clock, reset, trig, check,\n\t`RVFI_INPUTS\n);\n\t`rvformal_rand_const_reg [63:0] insn_order;\n\treg found_next_insn = 0;\n\n\tinteger channel_idx;\n\talways @(posedge clock) begin\n\t\tif (reset) begin\n\t\t\tfound_next_insn = 0;\n\t\tend else begin\n\t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/src/rvfi_testbench.sv\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/src/liveness_ch0.sv\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/src/defines.sv\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/src/rvfi_channel.sv\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/src/rvfi_liveness_check.sv\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/src/rvfi_macros.vh\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/logfile.txt\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design.ys\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design.json\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design_smt2.log\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design_smt2.ys\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design.log\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design_prep.log\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design.il\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design_smt2.smt2\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design_prep.ys\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/model/design_prep.il\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/status\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/liveness_ch0.xml\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/config.sby\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/FAIL\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/status.sqlite\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch0/engine_0/logfile.txt\n.tmp/hyp-r6s2-check-n04i83l0/formal/riscv-formal/cores/bench-69349/checks/liveness_ch