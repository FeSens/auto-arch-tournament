{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'cat cores/bench/test/test_ex_result_banks.py cores/bench/test/conftest.py'","aggregated_output":"\"\"\"Direct EX ownership checks, including holds unavailable from core's bus.\n\nThe real core stalls EX/MEM only for a memory instruction, so a divide\nowner normally advances immediately. This harness also holds that owner\nand blocks terminal acceptance to verify the EX interface's full contract.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\n\n# Packed bundle layouts from core_pkg.sv, listed MSB first.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n         (\"ctrl\", sum(w for _, w in CTRL)), (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32),\n          (\"ctrl\", sum(w for _, w in CTRL)), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, **values):\n    result = 0\n    for name, width in layout:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    return fields\n\n\ndef _ex_snapshot(ex):\n    return _unpack(EX_MEM, int(ex.out.value))\n\n\ndef _drive(dut, op=ALU_ADD, a=123, b=7, rd=3, pc=0x80, *, jump=False, memory=False):\n    ctrl = _pack(CTRL, alu_op=op, reg_write=1, is_jump=int(jump),\n                 mem_read=int(memory), mem_width=2)\n    funct3 = {ALU_DIV: 4, ALU_DIVU: 5, ALU_REM: 6, ALU_REMU: 7}.get(op, 0)\n    instr = ((int(op != ALU_ADD) << 25) | (2 << 20) | (1 << 15) |\n             (funct3 << 12) | (rd << 7) | 0x33)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=pc, rs1_val=a, rs2_val=b,\n                                    rd=rd, rs1_addr=1, rs2_addr=2,\n                                    ctrl=ctrl, instr=instr, valid=1)\n\n\ndef _expected(op, a, b, real):\n    if os.environ.get(\"TEST_ALTOPS\") == \"1\":\n        masks = {ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n                 ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1}\n        return ((a - b) ^ masks[op]) & 0xFFFFFFFF\n    return real & 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_ex_mem_load.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n    assert int(dut.div_result_sel_q.value) == 0\n    assert int(dut.div_registered_result.value) == 0\n    dut.reset.value = 0\n\n\nasync def _launch_and_offer(dut, op, a, b, real, *, rd=3):\n    previous = int(dut.div_registered_result.value)\n    _drive(dut, op, a, b, rd)\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_valid.value) == 1\n    assert int(dut.div_req_ready.value) == 1\n    await _tick(dut)\n    assert int(dut.div_result_sel_q.value) == 0\n    assert int(dut.out.value) == 0, \"older owner did not drain on launch\"\n    assert int(dut.div_registered_result.value) == previous, \"prefix setup destroyed the old bank\"\n    for edge in range(1, 8):\n        # Forwarding sources may drain/change after the operand snapshot.\n        dut.fwd_rs1_sel.value = 1\n        dut.fwd_rs2_sel.value = 2\n        dut.fwd_ex_mem.value = (0xF1234567 * edge) & 0xFFFFFFFF\n        dut.fwd_mem_wb.value = edge & 3\n        await _tick(dut)\n        assert int(dut.div_resp_valid.value) == (edge == 7)\n        assert int(dut.div_registered_result.value) == previous\n        assert int(dut.div_result_sel_q.value) == 0\n        assert int(dut.out.value) == 0, \"divide metadata appeared before edge eight\"\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    expected = _expected(op, a, b, real)\n    assert int(dut.div_resp_data.value) == expected\n    return expected\n\n\n@cocotb.test()\nasync def bank_owner_hold_launch_bubble_and_link(dut):\n    await _reset(dut)\n    _drive(dut, a=0x120, b=0x14)\n    await _tick(dut)\n    assert _ex_snapshot(dut)[\"alu_result\"] == 0x134\n    assert int(dut.mem_addr.value) == 0x134\n    assert int(dut.div_result_sel_q.value) == 0\n\n    expected = await _launch_and_offer(dut, ALU_DIV, -101, 7, -14)\n    assert int(dut.div_accept.value) == 1\n    await _tick(dut)\n    owner = int(dut.out.value)\n    fields = _ex_snapshot(dut)\n    assert fields[\"alu_result\"] == expected\n    assert int(dut.mem_addr.value) == 0, \"divide result entered the memory address bank\"\n    assert fields[\"valid\"] == 1 and fields[\"rd\"] == 3\n    assert fields[\"rs1_val\"] == 0xFFFFFF9B and fields[\"rs2_val\"] == 7\n    assert int(dut.div_result_sel_q.value) == 1\n\n    # A newer divide must not launch or overwrite the bank while EX/MEM\n    # is held, even for longer than the entire divider latency.\n    dut.stall.value = 1\n    _drive(dut, ALU_REM, 123, 7, rd=4)\n    for cycle in range(12):\n        _drive(dut, ALU_REM if cycle & 1 else ALU_DIV, 123 + cycle,\n               15 - cycle, rd=4 + cycle, pc=0x100 + 4 * cycle)\n        await _tick(dut)\n        assert int(dut.div_req_valid.value) == 0\n        assert int(dut.div_active_q.value) == 0\n        assert int(dut.div_result_sel_q.value) == 1\n        assert int(dut.div_registered_result.value) == expected\n        assert int(dut.out.value) == owner\n    dut.stall.value = 0\n    next_expected = await _launch_and_offer(dut, ALU_REM, 123, 7, 4, rd=4)\n    assert next_expected != expected\n    await _tick(dut)\n    assert _ex_snapshot(dut)[\"alu_result\"] == next_expected\n    assert _ex_snapshot(dut)[\"rd\"] == 4\n\n    # Selecting the normal bank must use the existing PC+4 link result.\n    _drive(dut, pc=0x100, jump=True)\n    await _tick(dut)\n    assert int(dut.div_result_sel_q.value) == 0\n    assert _ex_snapshot(dut)[\"alu_result\"] == 0x104\n    getattr(dut, \"in\").value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0\n    assert int(dut.div_result_sel_q.value) == 0\n    assert int(dut.div_registered_result.value) == next_expected\n    expected = await _launch_and_offer(dut, ALU_DIV, 81, -9, -9)\n    await _tick(dut)\n    assert int(dut.div_result_sel_q.value) == 1\n    assert _ex_snapshot(dut)[\"alu_result\"] == expected\n    dut.stall.value = 1\n    dut.reset.value = 1\n    await _tick(dut)\n    assert int(dut.out.value) == 0 and int(dut.div_result_sel_q.value) == 0\n    assert int(dut.div_registered_result.value) == 0\n    await _reset(dut)\n\n\n@cocotb.test()\nasync def terminal_response_wait_and_reset_ownership(dut):\n    for cancel in (False, True):\n        await _reset(dut)\n        expected = await _launch_and_offer(dut, ALU_REM, -101, 7, -3, rd=0)\n        dut.stall.value = 1\n        await Timer(1, \"ns\")\n        assert int(dut.div_accept.value) == 0\n        await _tick(dut)\n        assert int(dut.div_registered_result.value) == expected\n        for cycle in range(10):\n            # The held instruction's metadata stays, while its live source\n            # values differ from the operands captured on the request edge.\n            _drive(dut, ALU_REM, cycle << 28, cycle, rd=0)\n            await _tick(dut)\n            assert int(dut.div_resp_valid.value) == 1\n            assert int(dut.div_registered_result.value) == expected\n            assert int(dut.div_result_sel_q.value) == 0\n            assert int(dut.out.value) == 0\n        if cancel:\n            await _reset(dut)\n            for _ in range(10):\n                await _tick(dut)\n                assert int(dut.div_resp_valid.value) == 0\n                assert int(dut.out.value) == 0\n            continue\n        dut.stall.value = 0\n        await Timer(1, \"ns\")\n        assert int(dut.div_accept.value) == 1\n        await _tick(dut)\n        assert int(dut.div_result_sel_q.value) == 1\n        assert int(dut.div_resp_valid.value) == 0\n        assert _ex_snapshot(dut)[\"alu_result\"] == expected\n        assert _ex_snapshot(dut)[\"valid\"] == 1 and _ex_snapshot(dut)[\"rd\"] == 0\n\n        # A following memory instruction owns the normal bank throughout\n        # an actual memory-style hold; the retained divide bank is unused.\n        _drive(dut, a=0x400, b=4, memory=True)\n        await _tick(dut)\n        memory_owner = int(dut.out.value)\n        assert _ex_snapshot(dut)[\"alu_result\"] == 0x404\n        assert int(dut.mem_addr.value) == 0x404\n        dut.stall.value = 1\n        _drive(dut, ALU_DIV, 81, -9)\n        for _ in range(12):\n            await _tick(dut)\n            assert int(dut.div_result_sel_q.value) == 0\n            assert int(dut.div_registered_result.value) == expected\n            assert int(dut.out.value) == memory_owner\n            assert int(dut.mem_addr.value) == 0x404\n            assert int(dut.div_req_valid.value) == 0\n        await _reset(dut)\n\n\n@cocotb.test()\nasync def prefix_seventh_edge_and_corrected_bank_metadata(dut):\n    await _reset(dut)\n    vectors = [(ALU_DIV, -0x70000001, 3), (ALU_REM, -0x70000001, -15),\n               (ALU_DIVU, 0xF1234567, 15), (ALU_REMU, 0xEFFFFFFF, 16),\n               (ALU_DIVU, 0xFFFFFFFF, 17), (ALU_DIVU, 0xFFFFFFFF, 0x80000000),\n               (ALU_DIV, 0x80000000, -1), (ALU_REM, 0x80000000, -1),\n               (ALU_DIV, -0x70000001, 0), (ALU_REM, -0x70000001, 0)]\n    for index, (op, a, b) in enumerate(vectors):\n        a, b = a & 0xFFFFFFFF, b & 0xFFFFFFFF\n        signed = op in (ALU_DIV, ALU_REM)\n        sa = a - (1 << 32) if signed and a >> 31 else a\n        sb = b - (1 << 32) if signed and b >> 31 else b\n        q, r = divmod(abs(sa), abs(sb)) if b else (0xFFFFFFFF, abs(sa))\n        real_q = -q if (sa < 0) != (sb < 0) else q\n        real_r = -r if sa < 0 else r\n        real = (real_r if op in (ALU_REM, ALU_REMU) else real_q) if b else (\n            a if op in (ALU_REM, ALU_REMU) else 0xFFFFFFFF)\n        rd = 0 if index & 1 else 3\n        expected = await _launch_and_offer(dut, op, a, b, real, rd=rd)\n        divider = dut.u_alu.u_div\n        assert int(divider.count_q.value) == 7 and int(divider.final_cycle.value) == 1\n        if os.environ.get(\"TEST_ALTOPS\") != \"1\":\n            assert int(divider.quotient_q.value) == q\n            assert int(divider.remainder_q.value) == r\n        await _tick(dut)  # unchanged eighth closing edge\n        fields = _ex_snapshot(dut)\n        assert fields[\"valid\"] == 1 and fields[\"rd\"] == rd\n        assert fields[\"pc\"] == 0x80 and fields[\"pc_next\"] == 0x84\n        assert fields[\"rs1_val\"] == a and fields[\"rs2_val\"] == b\n        assert fields[\"alu_result\"] == expected\n        assert int(dut.div_registered_result.value) == expected\n        assert int(dut.div_result_sel_q.value) == 1\n        assert int(dut.mem_addr.value) == 0\n        if os.environ.get(\"TEST_ALTOPS\") != \"1\":\n            assert int(divider.quotient_q.value) == q, \"Q advanced during final correction\"\n            assert int(divider.remainder_q.value) == r, \"R advanced during final correction\"\n\n\ndef test_ex_result_banks_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_result_banks\")\n\n\ndef test_ex_result_banks_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"ex_stage_altops\"\n    runner.build(sources=[str(RTL / s) for s in\n                          (\"core_pkg.sv\", \"div_unit.sv\", \"alu.sv\", \"ex_stage.sv\")],\n                 hdl_toplevel=\"ex_stage\", build_dir=str(build_dir), always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"ex_stage\", test_module=\"test_ex_result_banks\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir),\n                extra_env={\"TEST_ALTOPS\": \"1\"})\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nfor line in Path('cores/bench/experiments/log.jsonl').read_text().splitlines():\n    x=json.loads(line)\n    if x.get('category') \"'!= '\"'predictor': continue\n    print('\\\\n'+x['id'])\n    print(json.dumps({k:x.get(k) for k in ['title','outcome','fitness','delta_pct','fmax_mhz','cycles','lut4','ff','seeds']},indent=2))\n    if x['id'].endswith(('r2s2','r3s2')):\n        h=x['hypothesis']\n        print('PROPOSAL\\\\n'+(h.get('hypothesis','') if isinstance(h,dict) else h))\n        print('IMPLEMENTATION\\\\n'+x.get('implementation_notes',''))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nfor line in Path('cores/bench/experiments/log.jsonl').read_text().splitlines():\n    x=json.loads(line)\n    if x.get('category') \"'!= '\"'predictor': continue\n    print('\\\\n'+x['id'])\n    print(json.dumps({k:x.get(k) for k in ['title','outcome','fitness','delta_pct','fmax_mhz','cycles','lut4','ff','seeds']},indent=2))\n    if x['id'].endswith(('r2s2','r3s2')):\n        h=x['hypothesis']\n        print('PROPOSAL\\\\n'+(h.get('hypothesis','') if isinstance(h,dict) else h))\n        print('IMPLEMENTATION\\\\n'+x.get('implementation_notes',''))\nPY\"","aggregated_output":"\nhyp-20260906-003-r1s2\n{\n  \"title\": \"Small tagged bimodal predictor for repeated control transfers\",\n  \"outcome\": \"regression\",\n  \"fitness\": 291.2,\n  \"delta_pct\": 2.96,\n  \"fmax_mhz\": 122.77,\n  \"cycles\": 4215937,\n  \"lut4\": 10377,\n  \"ff\": 2069,\n  \"seeds\": [\n    129.95,\n    121.11,\n    122.77\n  ]\n}\n\nhyp-20260906-003-r2s2\n{\n  \"title\": \"Tagged branch prediction with registered training metadata\",\n  \"outcome\": \"regression\",\n  \"fitness\": 345.07,\n  \"delta_pct\": -7.39,\n  \"fmax_mhz\": 145.48,\n  \"cycles\": 4215937,\n  \"lut4\": 6287,\n  \"ff\": 3097,\n  \"seeds\": [\n    143.84,\n    145.48,\n    152.72\n  ]\n}\nPROPOSAL\nAdd one 16-entry, direct-mapped, full-width tagged bimodal BTB to the\ncurrent cores/bench RTL, with training computed exclusively from\nregistered fetch metadata and the instruction's resolved outcome.\nThis is one predictor experiment: keep the existing divider, ALU,\nforwarding, memory system, pipeline boundaries, and nret=1 interface.\n\nIndex the BTB by PC[5:2], store the full tag PC[31:6], aligned target\nbits [31:2], a two-bit saturating counter, and a valid bit. Lookup is\ncombinational and depends only on the fetch PC. A valid full-tag hit\nwith counter[1] set predicts the stored target; otherwise predict the\nfull-width PC+4. Reset clears valid bits; unreset payloads must never\naffect a miss. Do not introduce an instruction-data target adder or\nreduce architectural address widths.\n\nAlong with the exact predicted_next_pc, capture lookup_hit and the\nlookup_counter in ID/EX on the same edge that accepts the instruction.\nA hit includes entries whose direction counter predicts not taken.\nSupply a defined counter value on a miss. Hold all metadata with a\nstalled instruction and clear it with a bubble or flush. The predictor\narrays must have no resolving-PC read port: training must not use\ntag_q[train_index], counter_q[train_index], or valid_q[train_index]\nas an input to its next-state/write-enable logic.\n\nTrain once when a valid instruction actually advances from EX into\nEX/MEM: in.valid && !reset && !stall && !div_wait. For a legal aligned\nconditional branch with saved lookup_hit, saturate the saved counter\ntoward the resolved direction and write a complete entry using this\ninstruction's actual PC tag and branch target. On a saved miss,\nallocate only a taken aligned branch, initialized weakly taken (10).\nLegal aligned JAL/JALR always write the resolved target and counter\n11. If an instruction with saved lookup_hit is no longer a legal\ncontrol transfer, or has a misaligned control-transfer target, clear\nthe addressed valid bit. Invalid instructions and bubbles never\nallocate. Compute every payload write and enable without rereading\nresident predictor state at EX; use local index write decoding.\n\nDefine simultaneous lookup and training using the pre-edge table for\nboth the consumed next PC and its captured metadata. Deliberately\naccept a stale counter/hit snapshot when an older resolving instruction\nupdates the same index at that edge; do not add a training-to-fetch\nbypass that reconstructs the long feedback path. Such collisions may\nlose a counter update or evict a newer entry, affecting prediction\naccuracy only. Every allocation/update writes its own complete actual\ntag and target, so metadata from different instructions cannot be\ncombined into a fabricated entry. Full next-PC checking remains the\ncorrectness mechanism. This bounded approximation must be exercised\nby consecutive same-index branches and single-instruction loops.\n\nEX computes one actual_next_pc with the existing forwarded operands,\nJALR bit-zero clearing, and alignment/trap continuation rules. For\nevery advancing valid instruction, compare it with that instruction's\nsaved predicted_next_pc, including ordinary instructions with stale\nBTB hits and completed DIV/REM operations. Redirect only on a mismatch;\nrepair to actual_next_pc and squash younger work. Correct predictions\nintroduce no flush. RVFI pc_wdata always reports the resolved next PC;\nJAL/JALR link writes and trap suppression remain unchanged.\n\nAdvance the predicted fetch PC only when its instruction is accepted.\nPreserve load-use bubbles, invalid imem bubbles, dmem holds and retained\nWB forwarding data, and all divider request/response behavior. Defer\nrepairs and training while EX cannot advance. An eligible repair\noverrides instruction-bus backpressure and the younger prediction.\nKeep raw predictor lookup independent of stall/flush/redirect signals\nand avoid combinational cycles in hazard control.\n\nThe prediction benefit is an estimate, not a new measurement. Retaining\nabout 6% fewer cycles while losing at most about 1% Fmax would improve\nfitness by roughly 5%. Counter-snapshot collisions, the remaining\nlookup/repair paths, and FPGA mapping could reduce that gain. Compare\nagainst the current 372.62 winner using the unchanged marker-bracketed\nCoreMark and three-seed median-Fmax gates, with all existing formal,\ncosim, CRC, UART, OOB, and resource checks intact. Inspect routed timing\nto confirm that predictor training no longer contains a tag-RAM read\nfollowed by tag comparison and table write enable in the same cycle.\nKeep the official fixture and any supplemental 6 KB results distinct;\ndo not modify either the evaluator or benchmark sources.\n\nIMPLEMENTATION\nImplemented the 16-entry full-width tagged bimodal BTB in cores/bench. Fetch\nuses PC[5:2], the full PC[31:6] tag, an aligned 30-bit target, validity and a\ntwo-bit direction counter. A miss exports counter 00 and full-width PC+4.\nOnly valid bits reset; payloads cannot influence misses.\n\nID/EX captures the exact predicted next PC, hit (including not-taken hits),\nand counter with its instruction. All fields hold during dmem/divider stalls\nand clear on flushes or invalid advancing bubbles. EX computes one resolved\nnext PC, with forwarded operands, JALR bit-zero clearing and existing trap\ncontinuation. Every valid EX/MEM acceptance compares that PC with its saved\nprediction, including ordinary instructions and completed DIV/REM. Only a\nmismatch repairs fetch and squashes younger work. RVFI retains the resolved\nPC and the unchanged nret=1 channel-0 retirement/order interface.\n\nThe same in.valid && !reset && !stall && !div_wait event drives training.\nTraining uses only the registered hit/counter and resolved instruction:\nsaved-hit aligned branches saturate the snapshot, saved misses allocate only\ntaken aligned branches at 10, and legal aligned JAL/JALR write 11. Stale hits\non non-control/illegal instructions or misaligned targets invalidate their\nindex. Every payload update writes its own complete actual tag and target.\nConstant per-entry write decoding introduces no resolving-PC read port.\nSimultaneous lookup/training deliberately consumes the pre-edge table with\nno bypass; stale snapshots can lose updates or evict intervening entries.\n\nHazard equations are separate continuous assignments so EX's dmem hold is\nindependent of its qualified repair. Eligible repairs override imem\nbackpressure; dmem/divider holds defer both repair and training. Load-use\nbubbles, retained WB forwarding data, divider request/completion behavior,\nALU, decoder, memory stages, pipeline boundaries and all top-level ports\nremain unchanged.\n\nNo architectural deviation from the hypothesis. Local write decoding maps\nthe table payload into enabled flops rather than relying on a RAM primitive.\nThe new tests add an instruction-version-aware sparse fetch harness for\nstale-code scenarios; they use the existing Python ISS and RVFI comparator\nwithout changing either contract file. Existing tests/assertions remain.\n\nLocal formal status: PASS on the first run, 53 passed and 0 failed; no formal\nfix attempts were needed. The unchanged bash formal/run_all.sh auto-selected\nwrapper_si.sv/checks_si.cfg with CORE_NAME=bench and RTL_DIR=cores/bench/rtl.\nIt ran from an isolated copy under TMPDIR because the worktree's upstream\nformal directory is a shared symlink. No checks, depths or wrappers changed.\nFull non-ALTOPS formal-deep was not run; divider arithmetic is unchanged and\nboth real and ALTOPS arithmetic tests passed.\n\nThe exact requested glob-order Verilator lint command passes without\nwarnings, as does the ALTOPS variant. All seven pytest runners pass, covering\n129 cocotb cases: real ALU 30, ALTOPS ALU 30, decoder 30, immediate generator\n8, register file 5, predictor 3 and pipeline 23. Coverage includes all tag\nbits/indices/target bits, all saved counters, saved misses, coherent stale\nreplacement, pre-edge collisions, inactive training, reset, warm loops and\nexits, both direction errors, changing forwarded JALR targets, illegal and\nmisaligned stale hits, consecutive same-index branches, single-instruction\nloops, random imem/dmem stalls, 12-clock holds, retained WB data, deferred\nDIV/REM repairs, and killed stores/divides. Pipeline monitors check every\nmetadata capture/hold/bubble, accepted fetch PC, full-PC repair, EX training\nevent, retirement continuity/order and absence of correct-prediction bubbles.\n\nA mapped-netlist combinational-cone audit checked every D and CE input of\nall 944 predictor storage flops. None has a resident valid/tag/counter/target\nbit as a combinational input. This confirms the training feedback path was\nremoved in the mapped hardware, beyond the source-level read-port check.\n\nThe unchanged make fpga TARGET=bench gate, with NRET=1 and\nBENCH=fpga/core_bench_si.sv, completed all three routes. Final Fmax values\nwere 143.84, 145.48 and 152.72 MHz; median 145.48 MHz. Resource usage was\n6,287 LUT4 and 3,097 FF, within the 10,000-LUT target. The unchanged cosim\ngate also passed both selftest and CoreMark, including the official CRC,\nUART, EBREAK, OOB and marker checks. CoreMark used 4,215,937 bracketed cycles\nfor 10 iterations with the standard random instruction/data stalls.\n\nOfficial local fitness on the current divider-based core is 345.07\niterations/s versus the current winner's 372.62: a 7.394% regression.\nTimed cycles decreased 6.135%, but median Fmax decreased 13.074%. LUT4 usage\nincreased 15.612%. The cycle benefit survived; the estimated <=1% Fmax loss\ndid not. This implementation therefore does not beat the current winner.\n\nAll routed critical paths were inspected. Seed 1 has a 6.95 ns ID/EX\ncontrol-to-EX/MEM path (3.30 ns logic, 3.65 ns routing). Seed 2 has a 6.87 ns\npath from ID/EX PC through target-alignment/legal-control qualification to\na predictor target write enable (2.77 ns logic, 4.10 ns routing). Seed 3\nhas a 6.55 ns path from ID/EX branch control through resolved training\nqualification to a predictor target write enable (2.57 ns logic, 3.98 ns\nrouting). None contains a tag-table read followed by tag comparison and\ntable write enable. Training qualification and enable fanout remain timing\nlimitations after removing the original feedback path; the mapped-cone\naudit above confirms there is no hidden resident-state training dependency.\n\nThe official checked-in fixture/evaluator use TOTAL_DATA_SIZE=2000, -O3 and\nITERATIONS=10. They were copied unchanged for evaluation. The recorded\ncurrent winner is 372.62 iterations/s, 167.36 MHz, 4,491,485 bracketed cycles,\n5,438 LUT4 and 2,094 FF. These are the comparison values from the existing\nexperiment log, not new measurements of the baseline.\n\nSeparately, an unmodified scratch copy built with COREMARK_SIZE=6000 and -O3\ncompleted 10 iterations in 30,823,120 marker-bracketed cycles, versus the\nrecorded winner's supplemental 32,836,671 cycles (6.132% fewer). It reported\ncrclist=d4b0, crcmatrix=be52, crcstate=5e47, seedcrc=8a02 and crcfinal=5949,\nthe literal Correct operation validated., both markers, EBREAK and no OOB\naccess. At the candidate's 145.48 MHz median this is 47.20 iterations/s.\nThis is supplemental 6 KB evidence, separate from official fitness.\nThe UART compiler-flags string is hardcoded; the build command used -O3.\n\nEvidence directories, all under the authorized TMPDIR:\n\n- predictor-formal-mcapvt3h: run.log and formal/last_run-*.log, all per-check logs.\n- predictor-tests-qlavcwvr: seven runner XML files and Verilator builds.\n- predictor-fpga-667ih_e0: gate-*.log, training-cone-check.json, synth.json and\n  cores/bench/generated/pnr_seed*/nextpnr.log plus routed netlists.\n- predictor-supplemental-6k-gvvrkbrq: build.log, sim.log and result.json.\n\nTMPDIR is /Users/bonetto/bonetto/auto-arch-tournament/.claude/astra-max-20260905/bench-runs/gpt-6-astra_max-rep2/.tmp.\nOnly cores/bench/rtl/*.sv, cores/bench/test/test_*.py and this explicitly\nrequested note are changed in the submitted worktree. The orchestrator's\nacceptance remains independent of these local results.\n\n\nhyp-20260906-003-r3s2\n{\n  \"title\": \"Stateless backward-taken and direct-JAL prediction\",\n  \"outcome\": \"regression\",\n  \"fitness\": 361.83,\n  \"delta_pct\": -3.71,\n  \"fmax_mhz\": 154.13,\n  \"cycles\": 4259699,\n  \"lut4\": 5548,\n  \"ff\": 2092,\n  \"seeds\": [\n    157.95,\n    153.59,\n    154.13\n  ]\n}\nPROPOSAL\nAdd one static backward-taken/forward-not-taken predictor with direct JAL\nprediction to cores/bench. Use the current combinational fetch/decode\nboundary; do not add a pipeline stage. Predict legal conditional branches\nwith negative B-immediates as taken, and predict legal direct JALs as taken\nin either direction. Predict all other instructions sequentially, including\nJALR. This is a single stateless direct-control predictor: no BTB, history\ntable, direction counters, return stack, or training interface.\n\nIn if_stage, predecode the raw imem_data independently of flushed output,\nstall, and redirect. Recognize BRANCH opcode 0x63 only for funct3 values\n0, 1, 4, 5, 6, and 7; its immediate sign is instruction bit 31. Recognize\nJAL opcode 0x6f. Require an aligned fetch PC and aligned displacement before\npredicting taken. B-immediate bit 1 is instruction bit 8; J-immediate bit 1\nis instruction bit 21; bit 0 is zero for both. Check these low bits directly\nrather than putting a wide target-adder result on the prediction-enable\npath. Reserved branch encodings and all JALRs predict PC+4. This predecode\nonly chooses speculation; the existing decoder remains authoritative for\ninstruction legality, including the default-illegal and SYSTEM rules.\n\nConstruct the sign-extended B/J displacement from instruction wires and\nselect it before one PC-relative target adder. Compute PC+4 independently.\nPreserve full 32-bit address arithmetic and modulo-2^32 carry behavior;\ndo not truncate addresses to the benchmark's memory size. On an accepted\nfetch, choose the aligned direct target when predicted taken, otherwise\nPC+4. Keep imem_addr driven directly by the PC register. A prediction must\nnot flush the instruction that generated it.\n\nAdd only a predicted_taken bit to if_id_t and id_ex_t. Capture it on the\nsame edge as the instruction whose prediction actually advances the PC.\nHold the bit with ID/EX through dmem and divider stalls; clear it with\nreset, flushes, and invalid advancing bubbles. No predicted target or\n32-bit predicted_next_pc register is needed: every predicted target is\nthe exact PC-relative target of that same captured instruction, so there\nare no target aliases or stale table entries to repair. Preserve that\ncorrespondence even when instruction data changes while a fetch is held.\n\nEX retains its forwarded branch comparison, full target calculation,\nJALR bit-zero clearing, and existing misalignment/trap continuation.\nDefine resolved_taken as an aligned, nontrapping taken branch or jump.\nOn in.valid && !reset && !stall && !div_wait, redirect only when\npredicted_taken differs from resolved_taken. This one-bit comparison\nreplaces the unconditional taken-transfer redirect without adding a\nfull-next-PC equality cone. Correctly predicted branches and direct JALs\ndo not flush. A backward-branch exit repairs to PC+4; an unpredicted taken\nforward branch repairs to its target. An aligned JALR remains unpredicted\nand uses its existing EX redirect, even when its target happens to equal\nPC+4. A misaligned transfer retains its existing trap and PC+4 continuation.\nUse the architectural resolved next PC for RVFI and repairs; preserve\nJAL/JALR link writes and their suppression on a target-alignment trap.\n\nReset has highest PC priority, then an eligible EX repair, then an accepted\nfetch prediction, otherwise hold. Repairs are deferred while EX is held\nand override imem backpressure when EX advances. Preserve load-use bubbles,\nimem invalidation, dmem holds and retained WB forwarding data, and divider\nrequest/completion behavior. Keep the dmem-hold equations independent of\nredirect, using separate assignments if necessary to avoid combinational\nscheduling loops when redirect is qualified by EX advancement. A repair\nmust squash the younger slot before it can retire, store, or launch DIV/REM.\n\nExpected net fitness improvement is about 4%, not a measured result. A\nnominal 5% cycle reduction with a 1% Fmax reduction gives about 4.2% higher\nthroughput. Static direction errors may reduce that cycle benefit, and\nthe new instruction-to-PC target-adder path may become critical. Inspect\nall three routed timing reports and compare marker-window cycles times\nmedian Fmax against the current winner; cycle savings alone are not success.\nRun the unchanged formal, cosim, canonical CRC, UART, OOB, marker-window,\nand three-seed FPGA gates. Keep any supplemental workload results distinct\nfrom official fitness. Preserve nret=1, every invariant, the existing\ndivider/result banks and direct registered memory-address path, and all\nevaluation files. Only the predictor integration and its tests are in scope.\n\nIMPLEMENTATION\nImplemented stateless backward-taken/forward-not-taken branch prediction and\ndirect-JAL prediction. Local correctness gates pass, but measured throughput\nregresses: 361.83 iter/s versus the current winner's 375.78 iter/s (-3.71%).\nThe expected four-percent improvement was not achieved.\n\nChanges:\n\n- IF predecodes raw instruction data independently of flush, stall, and\n  redirect. Only legal BRANCH funct3 values with a negative displacement,\n  and JAL in either direction, can predict taken. Fetch-PC alignment and\n  instruction bits 8/21 qualify alignment before the target adder.\n- One selected, sign-extended B/J displacement feeds one full-width\n  PC-relative adder. PC+4 is independent. Both preserve modulo-2^32 address\n  arithmetic; imem_addr remains directly driven by the PC register.\n- Added only predicted_taken to IF/ID and ID/EX. ID captures it with the\n  accepted instruction, holds it through memory/divider stalls, and clears\n  it on reset, flush, and invalid advancing bubbles. No table, training\n  interface, saved target, or saved next-PC was added.\n- EX compares the saved bit with the aligned, nontrapping transfer outcome\n  only on in.valid && !reset && !stall && !div_wait. Repairs and RVFI share\n  the architectural resolved next PC. Correct predictions do not flush;\n  backward exits repair to PC+4. JALR remains unpredicted, including a\n  target equal to PC+4. Link writes and alignment-trap suppression remain.\n- Separated the dmem hold assignments from redirect-dependent hazard logic.\n  Reset takes PC priority, followed by eligible EX repair, accepted fetch,\n  and hold. An EX repair squashes the single younger combinational slot.\n- Updated the packed EX test layout and added pipeline and standalone IF\n  coverage. The decoder, divider, ALU/result banks, direct registered dmem\n  address path, core top-level ports, nret=1, and evaluation files are intact.\n\nValidation on the submitted RTL:\n\n- Requested Verilator lint: PASS, no warnings, both normal and ALTOPS modes.\n  git diff --check: PASS.\n- Local formal: PASS on the first attempt, 53 passed / 0 failed. No failed\n  checks, counterexamples, or fix retries. The unchanged run_all.sh used\n  wrapper_si.sv and checks_si.cfg. formal-deep was not run; divider and\n  multiplier RTL were not changed.\n- All nine pytest runners pass, totaling 135 cocotb cases. The initial full\n  suite passed, then the added IF suite and final pipeline reset coverage\n  passed. Every pre-existing assertion remains.\n- Directed tests cover all six branch conditions in both directions and\n  both outcomes, backward loops/exits, forward branches, JAL both directions,\n  self-JAL, forwarded/changing JALR, and JALR targeting PC+4. They check\n  reserved branches, illegal JALR/SYSTEM, target-alignment traps and link\n  suppression, B/J sign extension, full-address carry/wrap, and unaligned PCs.\n- Protocol checks compare each accepted prediction with the captured\n  instruction and actual PC advance. They verify ID/EX holds and bubbles,\n  fourteen-cycle memory holds with changing instruction data, retained WB\n  forwarding, load-dependent branches, divider waits/resets, repair despite\n  unavailable imem, and repair overriding a younger direct prediction.\n  Correct direct predictions have no added retirement bubble. RVFI order,\n  PC continuity, links, and all compared fields match the unchanged ISS;\n  accepted bus requests and divider launches exclude wrong-path operations.\n- Unchanged make cosim TARGET=bench NRET=1: PASS for selftest and CoreMark.\n  CoreMark reached EBREAK, passed canonical UART/CRC checks, produced valid\n  start/stop markers, and reported no OOB access.\n\nFPGA measurement uses the unchanged single-issue wrapper, constraints,\nsynthesis script, three seeds, and marker-window fitness calculation. The\nfirst complete gate used Yosys 0.64+149 (2dc69a757-dirty) and\nnextpnr-0.10-45-g98c18d7f. A second complete gate used the winner's recorded Yosys 0.64\n(d8dab5b32666564eca8e18f412973853ce006e61) and the same nextpnr. Both synthesized\nidentical cell types, parameters, connectivity, and net-bit mappings. Both\ngates completed all three routes successfully and returned identical\nper-seed Fmax, resources, marker-window cycles, and fitness.\n\n| Routed seed | Fmax MHz | Critical path | Logic / routing ns |\n| --- | ---: | --- | ---: |\n| 1 | 157.95 | ID/EX register through EX selection to EX/MEM data | 3.69 / 2.64 |\n| 2 | 153.59 | ID/EX register through hazard control to ID/EX reset | 2.67 / 3.84 |\n| 3 | 154.13 | ID/EX register through forwarding/request control to divider operand CE | 1.67 / 4.82 |\n\nAll three final routed critical-path reports were inspected. The endpoints\nare respectively cpu.u_ex.reg_q_DFFRE_Q_31.D,\ncpu.u_id.reg_q_DFFRE_Q_72.RESET, and cpu.u_ex.div_rs2_q_DFFRE_Q_6.CE.\nThe reports show approximately 6.33, 6.51, and 6.49 ns total delay. None of\nthese reported worst paths identifies the IF target-adder path as critical;\nthe headline reports do not establish complete timing coverage of every\nforwarding or memory path.\n\nMedian Fmax is 154.13 MHz versus 168.78 MHz (-8.68%). Resources are 5,548\nLUT4, 2,092 DFF, and four block RAMs, versus 5,470 LUT4, 2,111 DFF, and four\nblock RAMs for the winner. The cycle savings do not offset the Fmax loss.\nThe candidate needs\nmore than 160.07 MHz at its measured cycle count to exceed the winner.\n\nThe checked-in evaluator builds aggregate 2 KB CoreMark, despite the prompt's\naggregate 6 KB description. Its unchanged CRC contract is seedcrc=e9f5,\ncrclist=e714, crcmatrix=1fd7, crcstate=8e3a, crcfinal=fcaf. The requested 6 KB\nworkload was built separately with the unchanged Makefile's\nCOREMARK_SIZE=6000 COREMARK_OPT=-O3 options. It is supplemental, not official\nfitness. Each comparison below uses a fresh simulation of the starting\nHEAD RTL and the identical ELF, ten iterations, and --istall --dstall.\n\n| Workload | Starting cycles | Candidate cycles | Cycle reduction | Starting / candidate iter/s |\n| --- | ---: | ---: | ---: | ---: |\n| Evaluator 2 KB, -O3 | 4,491,485 | 4,259,699 | 5.16% | 375.78 / 361.83 |\n| Supplemental 6 KB, -O3 | 32,836,671 | 31,086,275 | 5.33% | 51.40 / 49.58 |\n\nThe rates use the winner's recorded 168.78 MHz and the candidate's measured\n154.13 MHz. The 6 KB throughput also regresses, by 3.54%.\n\nMarker windows (start, stop): 2 KB starting (15,801, 4,507,286), candidate\n(15,189, 4,274,888); 6 KB starting (56,393, 32,893,064), candidate\n(54,040, 31,140,315). Both 6 KB UARTs contain seedcrc=0x8a02,\ncrclist=0xd4b0, crcmatrix=0xbe52, crcstate=0x5e47, crcfinal=0x5949, ten\niterations, and the literal \"Correct operation validated.\" Both complete\nwith EBREAK, valid markers, and no OOB access. The unchanged UART compiler\ndescription says -O2; actual build commands use -O3.\n\nAll generated artifacts and unchanged evaluation scratch copies are under\n$TMPDIR/stateless-r3s2. Evidence includes formal-console.log, unit-tests.log,\nprediction-tests.log, core test result XMLs, cosim-gate.log, fpga-gate.log,\nstable/fpga-gate.log, both sets of cores/bench/generated/pnr_seed*/nextpnr.log,\ntiming-summary.json, workload-comparison.json, the individual CoreMark logs,\nand sixk/build.log. verified-source-sha256.json verifies 145 staged source\nfiles; the formal-stage RTL was also checked byte-for-byte against the\nsubmitted RTL. Only scoped bench RTL/tests and this requested notes file\nare modified in the worktree. Orchestrator acceptance remains separate.\n\n\nhyp-20260906-003-r4s2\n{\n  \"title\": \"Early direct-JAL prediction with decode-certified redirect suppression\",\n  \"outcome\": \"regression\",\n  \"fitness\": 345.59,\n  \"delta_pct\": -8.03,\n  \"fmax_mhz\": 153.52,\n  \"cycles\": 4442217,\n  \"lut4\": 5512,\n  \"ff\": 2096,\n  \"seeds\": [\n    164.07,\n    153.52,\n    151.88\n  ]\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"The earlier predictors saved cycles, but their added control paths reduced Fmax enough to erase the gain. I’m focusing on backward-branch prediction with simpler EX repair logic and a narrower squash signal, using those timing reports to guide the design."}}
