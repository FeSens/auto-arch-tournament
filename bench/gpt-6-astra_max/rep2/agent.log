{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'cat .tmp/hyp-20260906-003-r1s2-formal/cores/bench/rtl/branch_predictor.sv'","aggregated_output":"// 16-entry direct-mapped tagged BTB with bimodal direction counters.\n// Lookup uses only the fetch PC and the pre-edge table. Nonblocking\n// training writes cannot alter the prediction captured at that same edge.\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [31:0] lookup_pc,\n  output logic [31:0] predicted_next_pc,\n  input  logic        train_valid,  // one pulse per valid EX advance\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0] train_pc,     // instruction PCs are word aligned\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic [31:0] train_target,\n  input  logic        train_branch,\n  input  logic        train_jump,\n  input  logic        train_taken,\n  input  logic        train_legal\n);\n  logic [15:0] valid_q;\n  logic [25:0] tag_q [0:15];\n  logic [29:0] target_q [0:15];\n  logic [1:0] counter_q [0:15];\n  logic [3:0] lookup_index, train_index;\n  logic train_hit;\n\n  assign lookup_index = lookup_pc[5:2];\n  assign train_index = train_pc[5:2];\n  assign train_hit = valid_q[train_index]\n                  && tag_q[train_index] == train_pc[31:6];\n\n  always_comb begin\n    predicted_next_pc = lookup_pc + 32'd4;\n    if (valid_q[lookup_index] && tag_q[lookup_index] == lookup_pc[31:6]\n        && counter_q[lookup_index][1])\n      predicted_next_pc = {target_q[lookup_index], 2'b00};\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      // Payloads are intentionally unreset; valid gates every lookup/use.\n      valid_q <= '0;\n    end else if (train_valid) begin\n      if (!train_legal || !(train_branch || train_jump)\n          || train_target[1:0] != 2'b00) begin\n        if (train_hit) valid_q[train_index] <= 1'b0;\n      end else if (train_jump) begin\n        valid_q[train_index]   <= 1'b1;\n        tag_q[train_index]     <= train_pc[31:6];\n        target_q[train_index]  <= train_target[31:2];\n        counter_q[train_index] <= 2'b11;\n      end else if (train_hit) begin\n        target_q[train_index] <= train_target[31:2];\n        if (train_taken && counter_q[train_index] != 2'b11)\n          counter_q[train_index] <= counter_q[train_index] + 2'b01;\n        else if (!train_taken && counter_q[train_index] != 2'b00)\n          counter_q[train_index] <= counter_q[train_index] - 2'b01;\n      end else if (train_taken) begin\n        valid_q[train_index]   <= 1'b1;\n        tag_q[train_index]     <= train_pc[31:6];\n        target_q[train_index]  <= train_target[31:2];\n        counter_q[train_index] <= 2'b10;\n      end\n    end\n  end\nendmodule\n","exit_code":0,"status":"completed"}}
