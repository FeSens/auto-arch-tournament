st/test_pipeline.py:226:    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\ncores/bench/test/test_pipeline.py:235:        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\ncores/bench/test/test_pipeline.py:249:    would let a wrong-path retirement with rd=0 / trap=1 / different data\ncores/bench/test/test_pipeline.py:258:    # Strict: no retirement should originate from PC=4.\ncores/bench/test/test_pipeline.py:260:    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\ncores/bench/test/test_pipeline.py:261:    # Strict: no retirement carries the skipped instruction word at all.\ncores/bench/test/test_pipeline.py:266:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\ncores/bench/test/test_pipeline.py:282:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\ncores/bench/test/test_pipeline.py:302:    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\ncores/bench/test/test_pipeline.py:325:    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\ncores/bench/test/test_pipeline.py:328:    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\ncores/bench/test/test_pipeline.py:348:    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\ncores/bench/test/test_pipeline.py:360:    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\ncores/bench/test/test_pipeline.py:368:async def rvfi_order_strictly_monotonic(dut):\ncores/bench/test/test_pipeline.py:369:    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\ncores/bench/test/test_pipeline.py:573:async def predictor_imem_stall_does_not_consume_prediction(dut):\ncores/bench/test/test_pipeline.py:588:    stalled = [e for e in trace[\"cycles\"] if not e[\"imem_ready\"]]\ncores/bench/test/test_pipeline.py:589:    assert len(stalled) == 4\ncores/bench/test/test_pipeline.py:590:   