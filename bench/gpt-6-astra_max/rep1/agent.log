{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' cores/bench/test/test_decoder.py; sed -n '1,100p' cores/bench/test/test_hazard_unit.py; sed -n '385,430p' cores/bench/test/test_alu.py; sed -n '1,120p' cores/bench/test/test_id_stage.py\"","aggregated_output":"\"\"\"Unit tests for rtl/decoder.sv. Mirrors chisel/test/src/DecoderSpec.scala\n1:1. Includes every reserved-encoding case from CLAUDE.md invariant #10.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    BR_BEQ, BR_BNE, BR_BLT, BR_BGE, BR_BLTU, BR_BGEU,\n    run_cocotb,\n)\n\n\nasync def _poke(dut, instr):\n    dut.instr.value = instr & 0xFFFFFFFF\n    await Timer(1, \"ns\")\n\n\n# ── R-type ────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def add(dut):\n    # ADD x1,x2,x3 = 0x003100B3\n    await _poke(dut, 0x003100B3)\n    assert int(dut.alu_op.value) == ALU_ADD\n    assert int(dut.reg_write.value) == 1\n    assert int(dut.alu_src.value) == 0\n    assert int(dut.is_illegal.value) == 0\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _poke(dut, 0x403100B3)\n    assert int(dut.alu_op.value) == ALU_SUB\n    assert int(dut.is_illegal.value) == 0\n\n\n@cocotb.test()\nasync def r_type_ops(dut):\n    cases = [\n        (0x001010B3, ALU_SLL),\n        (0x001020B3, ALU_SLT),\n        (0x001030B3, ALU_SLTU),\n        (0x001040B3, ALU_XOR),\n        (0x001050B3, ALU_SRL),\n        (0x001060B3, ALU_OR),\n        (0x001070B3, ALU_AND),\n        (0x401050B3, ALU_SRA),\n    ]\n    for instr, op in cases:\n        await _poke(dut, instr)\n        assert int(dut.alu_op.value) == op, \\\n            f\"instr=0x{instr:08x}: expected aluOp={op}, got {int(dut.alu_op.value)}\"\n        assert int(dut.is_illegal.value) == 0\n\n\n@cocotb.test()\nasync def m_extension(dut):\n    cases = [\n        (0x023100B3, ALU_MUL),\n        (0x023110B3, ALU_MULH),\n        (0x023120B3, ALU_MULHSU),\n        (0x023130B3, ALU_MULHU),\n        (0x023140B3, ALU_DIV),\n        (0x023150B3, ALU_DIVU),\n        (0x023160B3, ALU_REM),\n        (0x023170B3, ALU_REMU),\n    ]\n    for instr, op in cases:\n        await _poke(dut, instr)\n        assert int(dut.alu_op.value) == op\n        assert int(dut.is_illegal.value) == 0\n\n\n@cocotb.test()\nasync def reserved_funct7_r_type(dut):\n    # funct7=0x3F is reserved; otherwise valid R-type encoding.\n    await _poke(dut, 0xFE3100B3)\n    assert int(dut.is_illegal.value) == 1\n\n\n@cocotb.test()\nasync def reserved_subsra_funct3(dut):\n    # funct7=0x20, funct3=1 is reserved (only funct3=0 SUB or 5 SRA valid).\n    await _poke(dut, 0x403110B3)\n    assert int(dut.is_illegal.value) == 1\n\n\n# ── I-type OP-IMM ─────────────────────────────────────────────────────────\n@cocotb.test()\nasync def addi(dut):\n    # ADDI x1, x0, 5 = 0x00500093\n    await _poke(dut, 0x00500093)\n    assert int(dut.alu_op.value) == ALU_ADD\n    assert int(dut.alu_src.value) == 1\n    assert int(dut.reg_write.value) == 1\n    assert int(dut.is_illegal.value) == 0\n\n\n@cocotb.test()\nasync def slli_legal(dut):\n    # SLLI x1, x0, 4 = 0x00401093\n    await _poke(dut, 0x00401093)\n    assert int(dut.alu_op.value) == ALU_SLL\n    assert int(dut.is_illegal.value) == 0\n\n\n@cocotb.test()\nasync def slli_with_funct7_illegal(dut):\n    # SLLI with funct7=0x20 is reserved.\n    await _poke(dut, 0x40401093)\n    assert int(dut.is_illegal.value) == 1\n\n\n@cocotb.test()\nasync def srli(dut):\n    await _poke(dut, 0x00405093)\n\"\"\"Exhaustive control combinations for load-use bubbles and backend holds.\"\"\"\nimport itertools\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n@cocotb.test()\nasync def bubble_and_hold_truth_table(dut):\n    for load, rd, rs1, rs2, redirect, ir, dr, mem, divide in itertools.product(\n        (0, 1), (0, 7), (0, 7, 8), (0, 7, 8), *((0, 1),) * 5\n    ):\n        for name, value in dict(id_ex_mem_read=load, id_ex_rd=rd,\n                                if_id_rs1=rs1, if_id_rs2=rs2, redirect=redirect,\n                                imem_ready=ir, dmem_ready=dr,\n                                ex_mem_mem_op=mem, div_wait=divide).items():\n            getattr(dut, name).value = value\n        await Timer(1, \"ns\")\n        hazard = load and rd != 0 and rd in (rs1, rs2)\n        memory_hold = mem and not dr\n        expected = dict(stall_if=hazard or not ir or memory_hold or divide,\n                        stall_id=memory_hold or divide, flush_if=redirect or not ir,\n                        flush_id=(hazard or redirect) and not memory_hold and not divide,\n                        stall_ex_mem=memory_hold, hold_mem_wb=memory_hold)\n        for name, value in expected.items():\n            assert int(getattr(dut, name).value) == value, (name, expected)\n\n\ndef test_hazard_unit_runner():\n    run_cocotb(toplevel=\"hazard_unit\", sources=[\"hazard_unit.sv\"],\n               test_module=\"test_hazard_unit\")\n            await _check(dut, ALU_MUL, edge, 19, edge * 19)\n            await _edge(dut)\n            assert int(dut.div_result_valid.value) == (edge == 8)\n        dut.op.value = op\n        await Timer(1, \"ns\")\n        assert int(dut.out.value) == _expected(op, 101, 7, _real_m(op, 101, 7))\n        await _edge(dut)\n        assert int(dut.div_result_valid.value) == 0\n        assert int(dut.div_req_ready.value) == 1\n\n\n@pytest.mark.parametrize(\"altops\", [False, True], ids=[\"real\", \"altops\"])\ndef test_alu_runner(altops):\n    \"\"\"Exercise the actual integrated ALU in both builds with identical tests.\"\"\"\n    here = Path(__file__).resolve().parent\n    build = Path(tempfile.mkdtemp(prefix=\"bench-alu-\", dir=os.environ.get(\"TMPDIR\")))\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    runner.build(\n        sources=[here.parent / \"rtl\" / name for name in (\"core_pkg.sv\", \"div_unit.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=build, always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1} if altops else {},\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=build,\n                build_dir=build, extra_env={\"ALU_ALTOPS\": \"1\" if altops else \"0\",\n                                           \"PYTHONPATH\": str(here),\n                                           \"PYTHONDONTWRITEBYTECODE\": \"1\"})\n\"\"\"ID/EX control priority and payload independence, including flush+hold.\"\"\"\nimport itertools\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADDI, BEQ, DIV, ECALL, JAL, LUI, LW, REM, SW, _id_fields\n\n\n@cocotb.test()\nasync def control_and_payload_priorities(dut):\n    rng = random.Random(0x1DEB0BB1)\n    instructions = [ADDI(9, 3, -17), LW(9, 3, 20), SW(9, 3, 24),\n                    DIV(9, 3, 7), REM(9, 3, 7), BEQ(3, 7, -20),\n                    JAL(9, 124), LUI(9, 0xABCDE000), 0xABCDE497, ECALL()]\n    previous = None\n    # Start with reset, then exercise every reset/flush/stall combination\n    # against nonzero operands, immediates, register addresses and metadata.\n    controls = [(1, 0, 0)] + list(itertools.product((0, 1), repeat=3))\n    for instr in instructions:\n        for reset, flush, stall in controls + [(0, 0, 0)]:\n            pc, prediction, rs1, rs2 = [rng.getrandbits(32) for _ in range(4)]\n            valid = rng.randrange(2)\n            dut.clock.value = 0\n            dut.reset.value = reset\n            dut.flush.value = flush\n            dut.stall.value = stall\n            dut[\"in\"].value = (pc << 65) | (prediction << 33) | (instr << 1) | valid\n            dut.rs1_data.value = rs1\n            dut.rs2_data.value = rs2\n            await Timer(5, \"ns\")\n            decoded = int(dut.ctrl_decoded.value)\n            payload = dict(pc=pc, predicted_next_pc=prediction, rs1_val=rs1,\n                           rs2_val=rs2, imm=int(dut.imm.value), rd=(instr >> 7) & 31,\n                           rs1_addr=(instr >> 15) & 31, rs2_addr=(instr >> 20) & 31,\n                           instr=instr)\n            dut.clock.value = 1\n            await Timer(5, \"ns\")\n            actual = _id_fields(int(dut.out.value))\n            if reset:\n                assert all(value == 0 for value in actual.values())\n            else:\n                for field, value in payload.items():\n                    assert actual[field] == (previous[field] if stall else value), (\n                        f\"{field}: flush={flush} stall={stall} payload mismatch\"\n                    )\n                assert actual[\"ctrl\"] == (0 if flush else previous[\"ctrl\"] if stall else decoded)\n                assert actual[\"valid\"] == (0 if flush else previous[\"valid\"] if stall else valid)\n            previous = actual\n\n\ndef test_id_stage_runner():\n    run_cocotb(toplevel=\"id_stage\",\n               sources=[\"core_pkg.sv\", \"decoder.sv\", \"imm_gen.sv\", \"id_stage.sv\"],\n               test_module=\"test_id_stage\")\n","exit_code":0,"status":"completed"}}
