{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,360p' cores/bench/test/test_pipeline.py\nsed -n '910,960p' cores/bench/test/test_pipeline.py\nsed -n '1090,1280p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, predictor recovery/training under bus\nbackpressure, and trap discipline (illegal / ECALL trap, EBREAK legal).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nimport random\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef BNE (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b001, 0b1100011)\ndef LUI (rd, imm):      return (imm & 0xFFFFF000) | (rd << 7) | 0x37\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\ndef MOP(funct3, rd, rs1, rs2): return _r(1, rs2, rs1, funct3, rd, 0x33)\ndef DIV (rd, rs1, rs2): return MOP(4, rd, rs1, rs2)\ndef DIVU(rd, rs1, rs2): return MOP(5, rd, rs1, rs2)\ndef REM (rd, rs1, rs2): return MOP(6, rd, rs1, rs2)\ndef REMU(rd, rs1, rs2): return MOP(7, rd, rs1, rs2)\n\n\ndef _id_fields(bundle):\n    \"\"\"Unpack core_pkg.id_ex_t, including otherwise unobservable payload.\"\"\"\n    fields = {}\n    for name, width in reversed([\n        (\"pc\", 32), (\"predicted_next_pc\", 32), (\"rs1_val\", 32),\n        (\"rs2_val\", 32), (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5),\n        (\"rs2_addr\", 5), (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1),\n    ]):\n        fields[name] = bundle & ((1 << width) - 1)\n        bundle >>= width\n    assert bundle == 0\n    return fields\n\n\ndef _bundle_ctrl(bundle):\n    # All three registered bundles end with ctrl, instr, valid.\n    return (bundle >> 33) & ((1 << 22) - 1)\n\n\nclass _TrainingReference:\n    \"\"\"Ordered resolution policy with one edge between acceptance and commit.\"\"\"\n\n    def __init__(self):\n        self.rows = {}\n        self.pending = None\n\n    def predict(self, pc):\n        entry = self.rows.get((pc >> 2) & 15)\n        if entry is not None and entry[0] == pc >> 6 and entry[2] >= 2:\n            return entry[1]\n        return (pc + 4) & 0xFFFFFFFF\n\n    def edge(self, event):\n        old = self.pending\n        if old is not None:\n            index, tag = (old[\"pc\"] >> 2) & 15, old[\"pc\"] >> 6\n            entry = self.rows.get(index)\n            hit = entry is not None and entry[0] == tag\n            if not old[\"legal\"] or not (old[\"jump\"] or old[\"branch\"]):\n                if hit:\n                    del self.rows[index]\n            elif old[\"jump\"]:\n                self.rows[index] = (tag, old[\"target\"] & ~3, 3)\n            elif old[\"taken\"]:\n                self.rows[index] = (tag, old[\"target\"] & ~3,\n                                    min(3, entry[2] + 1) if hit else 2)\n            elif hit:\n                self.rows[index] = (tag, entry[1], max(0, entry[2] - 1))\n        self.pending = event\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, *,\n               ready=None, on_retire=None, trace=None, retire_limit=None,\n               on_cycle=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    `ready(cycle, fetch_pc, data_addr)` supplies deterministic (imem, dmem)\n    ready values. Stores commit only at the accepting edge. `on_retire`\n    can change the instruction memory to exercise stale predictor entries.\n    `trace` collects pre-edge fetch/resolution events and accepted stores.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = dict(program) if isinstance(program, dict) else {\n        i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)\n    }\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    stores = []\n    reads = []\n    predictor = _TrainingReference()\n    issued = []\n    resolutions = []\n    if trace is not None:\n        trace.update(cycles=[], stores=stores, reads=reads)\n\n    # Manual clocking keeps bus acceptance and RVFI sampling unambiguous,\n    # and allows a second reset/run on the same DUT without another clock.\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        assert int(dut.id_ex_w.value) == 0, \"reset must clear every ID/EX field\"\n        dut.clock.value = 0\n\n    dut.reset.value = 0\n\n    for cycle in range(max_cycles):\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        ir, dr = ready(cycle, ia, da) if ready else (1, 1)\n        dut.io_imemReady.value = ir\n        dut.io_dmemReady.value = dr\n        dut.io_imemData.value = imem.get(ia, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        await Timer(5, \"ns\")\n\n        prediction = predictor.predict(ia)\n        assert int(dut.u_if.predicted_next_pc.value) == prediction, (\n            f\"cycle {cycle}: prediction bypassed or missed a committed event at {ia:#x}\"\n        )\n        resolving = int(dut.resolve_valid.value)\n        accepted = not (int(dut.stall_if.value) or int(dut.flush_if.value))\n        redirect = int(dut.redirect.value)\n        actual = int(dut.redirect_target.value)\n        event = None\n        if resolving:\n            assert len(issued) == 1, \"duplicate/unaccepted EX training event\"\n            accepted_pc, accepted_prediction, accepted_insn = issued[0]\n            assert int(dut.resolve_pc.value) == accepted_pc\n            assert (int(dut.id_ex_w.value) >> 1) & 0xFFFFFFFF == accepted_insn\n            assert redirect == (actual != accepted_prediction), \"lost exact accepted prediction\"\n            event = dict(pc=accepted_pc, insn=accepted_insn, actual=actual,\n                         target=int(dut.resolve_target.value),\n                         legal=int(dut.resolve_legal.value),\n                         jump=int(dut.resolve_jump.value),\n                         branch=int(dut.resolve_branch.value),\n                         taken=int(dut.resolve_taken.value))\n        else:\n            assert not redirect\n            assert not issued or int(dut.stall_ex_mem.value) or int(dut.div_wait.value), (\n                \"advancing instruction failed to supply one training event\"\n            )\n\n        id_before = int(dut.id_ex_w.value)\n        ex_before = int(dut.ex_mem_w.value)\n        wb_before = int(dut.mem_wb_w.value)\n        memory_hold = int(dut.stall_ex_mem.value)\n        divide_wait = int(dut.div_wait.value)\n        backend_hold = memory_hold or divide_wait\n        flushing = int(dut.flush_id.value)\n        if_bundle = int(dut.if_id_w.value)\n        input_insn = (if_bundle >> 1) & 0xFFFFFFFF\n        payload_input = dict(\n            pc=ia, predicted_next_pc=prediction,\n            rs1_val=int(dut.rs1_data_w.value), rs2_val=int(dut.rs2_data_w.value),\n            imm=int(dut.u_id.imm.value), rd=(input_insn >> 7) & 31,\n            rs1_addr=(input_insn >> 15) & 31, rs2_addr=(input_insn >> 20) & 31,\n            instr=input_insn,\n        )\n        if not (id_before & 1):\n            assert not resolving and not int(dut.u_ex.div_req_valid.value)\n            assert not int(dut.div_wait.value)\n\n        if trace is not None:\n            trace[\"cycles\"].append({\n                \"cycle\": cycle, \"pc\": ia, \"imem_ready\": ir, \"dmem_ready\": dr,\n                \"predicted\": int(dut.u_if.predicted_next_pc.value),\n                \"accepted\": not (int(dut.stall_if.value) or int(dut.flush_if.value)),\n                \"redirect\": int(dut.redirect.value),\n                \"actual\": int(dut.redirect_target.value),\n                \"resolve_valid\": int(dut.resolve_valid.value),\n                \"resolve_pc\": int(dut.resolve_pc.value),\n                \"resolve_taken\": int(dut.resolve_taken.value),\n                \"resolve_legal\": int(dut.resolve_legal.value),\n                \"commit\": predictor.pending,\n                \"ex_stall\": int(dut.stall_ex_mem.value),\n                \"id_stall\": int(dut.stall_id.value),\n                \"id_flush\": flushing,\n                \"load_use\": int(dut.u_hazard.load_use_hazard.value),\n                \"payload_input\": payload_input,\n                \"if_instr\": input_insn,\n                \"dmem_addr\": da,\n                \"dmem_ren\": int(dut.io_dmemREn.value),\n                \"dmem_wen\": int(dut.io_dmemWEn.value),\n                \"dmem_wdata\": int(dut.io_dmemWData.value),\n                \"div_wait\": int(dut.div_wait.value),\n                \"div_launch\": int(dut.u_ex.div_req_valid.value) and int(dut.u_ex.div_req_ready.value),\n                \"div_valid\": int(dut.u_ex.div_result_valid.value),\n                \"div_accept\": int(dut.u_ex.div_result_valid.value) and int(dut.u_ex.div_result_ready.value),\n                \"id_ex\": int(dut.id_ex_w.value),\n                \"ex_mem\": int(dut.ex_mem_w.value),\n                \"mem_wb\": int(dut.mem_wb_w.value),\n                \"fwd_rs1\": int(dut.fwd_rs1_sel.value),\n                \"fwd_rs2\": int(dut.fwd_rs2_sel.value),\n                \"wb_write\": int(dut.wb_w_en.value),\n                \"wb_rd\": int(dut.wb_w_addr.value),\n                \"wb_data\": int(dut.wb_w_data.value),\n            })\n\n        if on_cycle and on_cycle(cycle):\n            # A reset test can stop at a precise pre-edge controller state,\n            # then invoke _run again to reset and start a fresh program.\n            assert not stores, \"cannot abandon accepted stores before retirement\"\n            return retirements, dmem\n\n        if resolving:\n            issued.pop()\n            resolutions.append(event)\n        if accepted:\n            issued.append((ia, prediction, int(dut.io_imemData.value)))\n        assert len(issued) <= 1, \"unexpected additional younger issue slot\"\n        next_pc = actual if redirect else prediction if accepted else ia\n        predictor.edge(event)\n\n        if int(dut.io_dmemREn.value) and dr:\n            reads.append((da & ~3, int(dut.io_dmemRData.value)))\n\n        wen       = int(dut.io_dmemWEn.value)\n        if wen and dr:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            stores.append((wa, wen, wdata))\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        dut.clock.value = 1\n        await Timer(1, \"ns\")\n        id_after = int(dut.id_ex_w.value)\n        if backend_hold:\n            assert not flushing\n            assert id_after == id_before, \"backend hold changed ID/EX metadata or operands\"\n        if flushing:\n            assert not (id_after & 1) and _bundle_ctrl(id_after) == 0, (\n                \"flush must clear every control, even when valid is zero\"\n            )\n        if memory_hold:\n            assert int(dut.ex_mem_w.value) == ex_before\n            assert int(dut.mem_wb_w.value) == (wb_before & ~1)\n        elif divide_wait:\n            assert int(dut.ex_mem_w.value) == 0, \"divide wait must emit a full EX/MEM zero bubble\"\n        elif not (id_before & 1) and _bundle_ctrl(id_before) == 0:\n            assert _bundle_ctrl(int(dut.ex_mem_w.value)) == 0\n            assert not int(dut.io_dmemREn.value) and not int(dut.io_dmemWEn.value)\n        if trace is not None:\n            trace[\"cycles\"][-1][\"id_after\"] = id_after\n        assert int(dut.io_imemAddr.value) == next_pc, \"maintenance changed fetch advancement\"\n        assert int(dut.u_if.predicted_next_pc.value) == predictor.predict(next_pc), (\n            f\"cycle {cycle}: commit was held, repeated, or published a stale target\"\n        )\n        # Capture RVFI retirement.\n        done = False\n        if int(dut.io_rvfi_valid_0.value):\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"halt\":      int(dut.io_rvfi_halt_0.value),\n                \"intr\":      int(dut.io_rvfi_intr_0.value),\n                \"mode\":      int(dut.io_rvfi_mode_0.value),\n                \"ixl\":       int(dut.io_rvfi_ixl_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            assert r[\"order\"] == len(retirements), f\"RVFI order gap/duplicate: {r}\"\n            assert r[\"pc\"] == (retirements[-1][\"pc_next\"] if retirements else 0), (\n                f\"RVFI next-PC chain broken: {retirements[-1:]} -> {r}\"\n            )\n            assert r[\"pc\"] & 3 == 0\n            resolved = resolutions[len(retirements)]\n            assert (r[\"pc\"], r[\"insn\"], r[\"pc_next\"]) == (\n                resolved[\"pc\"], resolved[\"insn\"], resolved[\"actual\"]\n            ), \"retirement did not match its unique advancing-EX event\"\n            retirements.append(r)\n            if on_retire:\n                on_retire(r, imem)\n            done = r[\"insn\"] == EBREAK() or len(retirements) == retire_limit\n\n        await Timer(4, \"ns\")\n        dut.clock.value = 0\n        assert any(not e[\"imem_ready\"] for e in trace[\"cycles\"])\n        for a, b in zip(trace[\"cycles\"], trace[\"cycles\"][1:]):\n            if not a[\"accepted\"] and not a[\"redirect\"]:\n                assert b[\"pc\"] == a[\"pc\"], \"stalled fetch consumed a prediction\"\n            if a[\"ex_stall\"]:\n                assert not a[\"resolve_valid\"] and not a[\"redirect\"]\n\n\ndef _is_div(insn):\n    return insn & 0xFE00007F == 0x02000033 and (insn >> 12) & 7 >= 4\n\n\ndef _assert_div_flow(rets, trace, *, bounded=False):\n    \"\"\"Check exactly-once execution, full bubbles, saved metadata, and writes.\"\"\"\n    events = trace[\"cycles\"]\n    launches = [e for e in events if e[\"div_launch\"]]\n    accepts = [e for e in events if e[\"div_accept\"]]\n    divides = [r for r in rets if _is_div(r[\"insn\"])]\n    assert len(launches) == len(accepts) == len(divides)\n    for launch, accept, retired in zip(launches, accepts, divides):\n        assert launch[\"resolve_pc\"] == accept[\"resolve_pc\"] == retired[\"pc\"]\n        # Result appears after launch plus seven more edges and transfers\n        # into EX/MEM on the following edge, then into the one WB channel.\n        assert accept[\"cycle\"] - launch[\"cycle\"] == 8\n        assert retired[\"cycle\"] == accept[\"cycle\"] + 1\n        waiting = events[launch[\"cycle\"]:accept[\"cycle\"]]\n        assert all(e[\"div_wait\"] and not e[\"div_valid\"] for e in waiting)\n        assert all(not e[\"resolve_valid\"] and not e[\"redirect\"] for e in waiting)\n        assert all(not e[\"accepted\"] for e in waiting)\n        assert all(e[\"id_ex\"] == launch[\"id_ex\"] for e in waiting + [accept])\n        assert all(e[\"pc\"] == launch[\"pc\"] for e in waiting + [accept])\n        assert all(e[\"ex_mem\"] == 0 for e in events[launch[\"cycle\"] + 1:accept[\"cycle\"] + 1])\n        assert all(not e[\"wb_write\"] for e in events[launch[\"cycle\"] + 2:accept[\"cycle\"] + 1])\n        assert accept[\"resolve_valid\"] and not accept[\"ex_stall\"]\n        assert retired[\"trap\"] == 0 and retired[\"pc_next\"] == retired[\"pc\"] + 4\n    for e in events:\n        if e[\"ex_stall\"]:\n            assert not e[\"div_launch\"] and not e[\"div_accept\"]\n            assert not e[\"resolve_valid\"] and not e[\"redirect\"]\n    assert [(e[\"wb_rd\"], e[\"wb_data\"]) for e in events if e[\"wb_write\"] and e[\"wb_rd\"]] == [\n        (r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"rd\"]\n    ]\n    assert trace[\"reads\"] == [(r[\"mem_addr\"], r[\"mem_rdata\"]) for r in rets if r[\"mem_rmask\"]]\n    if bounded:\n        assert all(b[\"cycle\"] - a[\"cycle\"] <= 10 for a, b in zip(rets, rets[1:]))\n\n\n@cocotb.test()\nasync def divider_forwarded_sources_and_consecutive(dut):\n    trace = {}\n    rets, _ = await _run(dut, [\n                program[consumer_pc + 4] = EBREAK()\n            rets, mem = await _run(dut, program, {64: 0xA5A55A5A}, trace=trace)\n            _assert_div_flow(rets, trace, bounded=True)\n            [r] = [r for r in rets if r[\"pc\"] == consumer_pc]\n            if rd_expected is not None: assert r[\"rd_wdata\"] == rd_expected\n            if (consumer >> 15) & 31 == 3: assert r[\"rs1_rdata\"] == 64\n            if (consumer >> 20) & 31 == 3: assert r[\"rs2_rdata\"] == 64\n            if consumer == SW(3, 0, 0x180): assert mem[0x180] == 64\n            if consumer == SW(1, 3, 0): assert mem[64] == 256\n            assert 0x184 not in mem\n\n\n@cocotb.test()\nasync def divider_after_redirect_meets_successor_window(dut):\n    for divide in (DIV, DIVU, REM, REMU):\n        trace = {}\n        rets, mem = await _run(dut, {\n            0: ADDI(1, 0, -101), 4: ADDI(2, 0, 7),\n            8: BEQ(0, 0, 12), 12: SW(1, 0, 0x180),\n            20: divide(3, 1, 2), 24: ADD(4, 3, 3), 28: EBREAK(),\n        }, trace=trace)\n        _assert_div_flow(rets, trace, bounded=True)\n        assert [r[\"pc\"] for r in rets] == [0, 4, 8, 20, 24, 28]\n        assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 10\n        assert mem == {}\n\n\n@cocotb.test()\nasync def divider_stale_prediction_recovers_once(dut):\n    for divide in (DIV, DIVU, REM, REMU):\n        visits = 0\n\n        def patch(r, imem):\n            nonlocal visits\n            if r[\"pc\"] == 0:\n                visits += 1\n                if visits == 2: imem[0] = divide(7, 5, 0)\n\n        trace = {}\n        rets, mem = await _run(dut, {\n            0: JAL(5, 32), 4: EBREAK(), 32: NOP(), 36: JAL(0, -36),\n        }, on_retire=patch, trace=trace)\n        _assert_div_flow(rets, trace, bounded=True)\n        assert [r[\"pc\"] for r in rets] == [0, 32, 36] * 2 + [0, 4]\n        assert [e[\"predicted\"] for e in _fetches(trace, 0)] == [4, 32, 32]\n        assert [e[\"redirect\"] for e in _resolutions(trace, 0)] == [1, 0, 1]\n        assert rets[-2][\"rs1_rdata\"] == 4 and rets[-2][\"rs2_rdata\"] == 0\n        assert rets[-2][\"rd_wdata\"] == (0xFFFFFFFF if divide in (DIV, DIVU) else 4)\n        assert _next_gaps(rets, 0) == [2, 1, 2]\n        assert mem == {}\n\n\n@cocotb.test()\nasync def divider_memory_markers_and_simultaneous_stalls(dut):\n    program = [\n        LUI(10, 0x10000000), ADDI(1, 0, 101), ADDI(2, 0, 7),\n        SW(1, 10, 0x100), DIV(3, 1, 2), SW(3, 0, 0x180),\n        REM(4, 1, 2), SW(4, 0, 0x184),\n        LW(5, 0, 0x180), DIVU(6, 5, 2),\n        SW(6, 10, 0x104), EBREAK(),\n    ]\n    baseline = None\n    for phase in range(4):\n        stalled_start = 0\n\n        def ready(cycle, pc, da):\n            nonlocal stalled_start\n            if da == 0x10000100 and stalled_start < 5:\n                stalled_start += 1\n                return 0, 0\n            return ((cycle + phase) % 7 not in (1, 2),\n                    (cycle + phase) % 11 not in (2, 3, 4))\n\n        trace = {}\n        rets, mem = await _run(dut, program, trace=trace, ready=ready if phase else None,\n                             max_cycles=400)\n        _assert_div_flow(rets, trace, bounded=phase == 0)\n        assert mem == {0x10000100: 101, 0x180: 14, 0x184: 3, 0x10000104: 2}\n        assert trace[\"stores\"] == [(address, 15, value) for address, value in mem.items()]\n        normalized = [{k: v for k, v in r.items() if k != \"cycle\"} for r in rets]\n        if baseline is None: baseline = normalized\n        else:\n            assert normalized == baseline\n            assert stalled_start == 5\n            assert any(e[\"ex_stall\"] and e[\"div_wait\"] for e in trace[\"cycles\"])\n            assert any(e[\"div_wait\"] and not e[\"imem_ready\"] for e in trace[\"cycles\"])\n\n\n@cocotb.test()\nasync def divider_reset_during_execution(dut):\n    for cancel_after in (1, 4, 7, 8):\n        trace = {}\n        launch_cycle = None\n\n        def stop(cycle):\n            nonlocal launch_cycle\n            if trace[\"cycles\"][-1][\"div_launch\"]: launch_cycle = cycle\n            return launch_cycle is not None and cycle == launch_cycle + cancel_after\n\n        old, _ = await _run(dut, [ADDI(1, 0, 101), ADDI(2, 0, 7),\n                                  DIV(3, 1, 2), SW(3, 0, 0x180), EBREAK()],\n                            on_cycle=stop, trace=trace)\n        assert launch_cycle is not None\n        assert not any(_is_div(r[\"insn\"]) for r in old)\n        trace = {}\n        rets, mem = await _run(dut, [ADDI(1, 0, 35), ADDI(2, 0, 6),\n                                   REMU(4, 1, 2), ADDI(5, 4, 1), EBREAK()], trace=trace)\n        _assert_div_flow(rets, trace, bounded=True)\n        assert [r[\"rd\"] for r in rets] == [1, 2, 4, 5, 0]\n        assert rets[2][\"rd_wdata\"] == 5 and rets[3][\"rd_wdata\"] == 6\n        assert mem == {}\n\n\n@cocotb.test()\nasync def divider_only_launches_legal_valid_instructions(dut):\n    trace = {}\n    # Reserved funct7 looks like a DIV by funct3, but must trap at normal\n    # speed; a real divide on a flushed path must never enter the engine.\n    illegal = _r(3, 0, 0, 4, 3, 0x33)\n    rets, _ = await _run(dut, [illegal, BEQ(0, 0, 8), DIV(4, 0, 0),\n                              ADDI(5, 0, 7), EBREAK()], trace=trace)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 16]\n    assert rets[0][\"trap\"] and rets[0][\"rd\"] == 0\n    assert not any(e[\"div_launch\"] or e[\"div_wait\"] for e in trace[\"cycles\"])\n\n\ndef _assert_id_payload(trace):\n    \"\"\"Bubble control must never clear, mask or hold the payload registers.\"\"\"\n    for event in trace[\"cycles\"]:\n        backend_hold = event[\"ex_stall\"] or event[\"div_wait\"]\n        assert event[\"id_stall\"] == backend_hold\n        after = _id_fields(event[\"id_after\"])\n        if backend_hold:\n            assert event[\"id_after\"] == event[\"id_ex\"]\n        else:\n            for field, value in event[\"payload_input\"].items():\n                assert after[field] == value, (event[\"cycle\"], field, after, value)\n        if event[\"id_flush\"]:\n            assert after[\"ctrl\"] == 0 and after[\"valid\"] == 0\n\n\n@cocotb.test()\nasync def id_ex_nonzero_bubbles_and_overlapping_holds(dut):\n    \"\"\"Stores and DIV/REM copied into bubbles stay inert, then execute once.\"\"\"\n    for wrong_path in (SW(1, 10, 16), LW(11, 10, 16), DIV(11, 1, 2), REM(11, 1, 2)):\n        for stalled in (False, True):\n            holds = {0x100: 0, 0x10C: 0}\n\n            def ready(cycle, pc, da):\n                # Target real requests, since an inactive bubble's address\n                # deliberately differs from the old zero-payload bundle.\n                request = int(dut.io_dmemREn.value) or int(dut.io_dmemWEn.value)\n                if request and da in holds and holds[da] < 9:\n                    holds[da] += 1\n                    return 0, 0\n                return 1, 1\n\n            trace = {}\n            program = [\n                ADDI(10, 0, 0x100), ADDI(3, 0, 0x55), ADDI(1, 0, 101),\n                ADDI(2, 0, 7), LW(3, 10, 0), SW(3, 10, 8),\n                LW(4, 10, 8), DIV(5, 4, 2), LW(6, 10, 4), LW(7, 10, 12),\n                REM(8, 6, 2), BEQ(8, 8, 8), wrong_path, ADD(9, 5, 8),\n                SW(9, 10, 20), _r(3, 2, 1, 4, 11, 0x33), JAL(12, 2), EBREAK(),\n            ]\n            rets, mem = await _run(dut, program,\n                                  {0x100: 97, 0x104: 101, 0x10C: 0xFEED1234,\n                                   0x110: 0xCAFE0BAD}, trace=trace,\n                                  ready=ready if stalled else None, max_cycles=200)\n            _assert_id_payload(trace)\n            _assert_div_flow(rets, trace, bounded=not stalled)\n            assert [r[\"pc\"] for r in rets] == [pc for pc in range(0, 72, 4) if pc != 48]\n            assert [(r[\"pc\"], r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"])\n                    for r in rets if _is_div(r[\"insn\"])] == [(28, 97, 7, 13), (40, 101, 7, 3)]\n            assert [(r[\"pc\"], r[\"rd\"]) for r in rets if r[\"trap\"]] == [(60, 0), (64, 0)]\n            assert trace[\"stores\"] == [(0x108, 15, 97), (0x114, 15, 16)]\n            assert mem == {0x100: 97, 0x104: 101, 0x108: 97, 0x10C: 0xFEED1234,\n                           0x110: 0xCAFE0BAD, 0x114: 16}\n            events = trace[\"cycles\"]\n            bubbles = [e for e in events if e[\"load_use\"] and e[\"id_flush\"]]\n            assert [e[\"if_instr\"] for e in bubbles] == [SW(3, 10, 8), DIV(5, 4, 2)]\n            assert _id_fields(bubbles[0][\"id_after\"])[\"rs2_val\"] == 0x55\n            [recovery] = [e for e in events if e[\"redirect\"]]\n            killed = _id_fields(recovery[\"id_after\"])\n            assert recovery[\"resolve_pc\"] == 44 and killed[\"pc\"] == 48\n            assert killed[\"predicted_next_pc\"] == 52 and killed[\"instr\"] == NOP()\n            assert not any(e[\"resolve_valid\"] and e[\"resolve_pc\"] == 48 for e in events)\n            # Both the live load-use DIV and the younger REM launch once;\n            # wrong-path DIV/REM and invalid captured copies never launch.\n            assert [e[\"resolve_pc\"] for e in events if e[\"div_launch\"]] == [28, 40]\n            if stalled:\n","exit_code":0,"status":"completed"}}
