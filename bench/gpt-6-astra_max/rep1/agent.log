ncores/bench/test/test_alu.py:288:    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\ncores/bench/test/test_alu.py:298:    await _check_div(dut, ALU_DIVU, 100, 7, 14)\ncores/bench/test/test_alu.py:299:    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\ncores/bench/test/test_alu.py:300:    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\ncores/bench/test/test_alu.py:301:    await _check_div(dut, ALU_REM, 10, 3, 1)\ncores/bench/test/test_alu.py:302:    await _check_div(dut, ALU_REMU, 7, 3, 1)\ncores/bench/test/test_alu.py:311:    if op == ALU_MUL: return (a * b) & MASK32\ncores/bench/test/test_alu.py:312:    if op == ALU_MULH: return ((sa * sb) >> 32) & MASK32\ncores/bench/test/test_alu.py:313:    if op == ALU_MULHU: return ((a * b) >> 32) & MASK32\ncores/bench/test/test_alu.py:314:    if op == ALU_MULHSU: return ((sa * b) >> 32) & MASK32\ncores/bench/test/test_alu.py:315:    if op in (ALU_DIV, ALU_REM):\ncores/bench/test/test_alu.py:320:        value = quotient if op == ALU_DIV else (sa - quotient * sb)\ncores/bench/test/test_alu.py:322:        value = (a // b if b else MASK32) if op == ALU_DIVU else (a % b if b else a)\ncores/bench/test/test_alu.py:337:            check = _check_div if op >= ALU_DIV else _check\ncores/bench/test/test_alu.py:346:        dut.op.value = ALU_REM\ncores/bench/test/test_alu.py:361:        await _check_div(dut, ALU_DIV, -101, 7, -14)\ncores/bench/test/test_alu.py:367:    # Neither an ordinary operation nor a multiply may launch the divider.\ncores/bench/test/test_alu.py:369:    for op in (ALU_ADD, ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, 31):\ncores/bench/test/test_alu.py:375:    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\ncores/bench/test/test_alu.py:384:            await _check(dut, ALU_ADD, edge, 19, edge + 19)\ncores/bench/test/test_alu.py:385:            await _check(dut, ALU_MUL, edge, 19, edge * 19)\ncores/bench/test/test_alu.py:409:                build_dir=build, extra_env={\"ALU_ALTOPS\": \"1\" if altops else \"0\",\ncores/bench/test/test_pipeline.py:5:acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\ncores/bench/test/test_pipeline.py:6:SW+LW roundtrip, load-use stall, predictor recovery/training under bus\ncores/bench/test/test_pipeline.py:81:        (\"rs2_addr\", 5), (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1),\ncores/bench/test/test_pipeline.py:89:def _bundle_ctrl(bundle):\ncores/bench/test/test_pipeline.py:90:    # All three registered bundles end with ctrl, instr, valid.\ncores/bench/test/test_pipeline.py:186:        accepted = not (int(dut.stall_if.value) or int(dut.flush_if.value))\ncores/bench/test/test_pipeline.py:204:            assert not issued or int(dut.stall_ex_mem.value) or int(dut.div_wait.value), (\ncores/bench/test/test_pipeline.py:211:        memory_hold = int(dut.stall_ex_mem.value)\ncores/bench/test/test_pipeline.py:232:                \"accepted\": not (int(dut.stall_if.value) or int(dut.flush_if.value)),\ncores/bench/test/test_pipeline.py:240:                \"ex_stall\": int(dut.stall_ex_mem.value),\ncores/bench/test/test_pipeline.py:241:                \"id_stall\": int(dut.stall_id.value),\ncores/bench/test/test_pipeline.py:302:            assert not (id_after & 1) and _bundle_ctrl(id_after) == 0, (\ncores/bench/test/test_pipeline.py:310:        elif not (id_before & 1) and _bundle_ctrl(id_before) == 0:\ncores/bench/test/test_pipeline.py:311:            assert _bundle_ctrl(int(dut.ex_mem_w.value)) == 0\ncores/bench/test/test_pipeline.py:380:async def forwarding_ex_to_ex(dut):\ncores/bench/test/test_pipeline.py:381:    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\ncores/bench/test/test_pipeline.py:388:        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\ncores/bench/test/test_pipeline.py:396:async def forwarding_mem_to_ex(dut):\ncores/bench/test/test_pipeline.py:397:    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\ncores/bench/test/test_pipeline.py:405:async def load_use_stalls(dut):\ncores/bench/test/test_pipeline.py:406:    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\ncores/bench/test/test_pipeline.py:415:        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\ncores/bench/test/test_pipeline.py:592:async def predictor_forward_branch_and_direct_jump(dut):\ncores/bench/test/test_pipeline.py:757:async def predictor_imem_stall_does_not_consume_prediction(dut):\ncores/bench/test/test_pipeline.py:772:    stalled = [e for e in trace[\"cycles\"] if not e[\"imem_ready\"]]\ncores/bench/test/test_pipeline.py:773:    assert len(stalled) == 4\ncores/bench/test/test_pipeline.py:774:    assert all(e[\"pc\"] == 8 and e[\"predicted\"] == 4 and not e[\"accepted\"] for e in stalled)\ncores/bench/test/test_pipeline.py:775:    assert all(trace[\"cycles\"][e[\"cycle\"] + 1][\"pc\"] == 8 for e in stalled)\ncores/bench/test/test_pipeline.py:781:async def predictor_recovery_overrides_imem_stall(dut):\ncores/bench/test/test_pipeline.py:795:async def predictor_held_branch_trains_once_and_keeps_wb_forwarding(dut):\ncores/bench/test/test_pipeline.py:797:    stalls = 0\ncores/bench/test/test_pipeline.py:801:        nonlocal stalls, released\ncores/bench/test/test_pipeline.py:803:            if stalls < 4:\ncores/bench/test/test_pipeline.py:804:                stalls += 1\ncores/bench/test/test_pipeline.py:807:            return 0, 1  # data release and instruction stall on the same edge\ncores/bench/test/test_pipeline.py:817:    held = [e for e in trace[\"cycles\"] if e[\"ex_stall\"]]\ncores/bench/test/test_pipeline.py:865:    assert any(e[\"ex_stall\"] for e in commits)\ncores/bench/test/test_pipeline.py:867:    assert sum(e[\"ex_stall\"] for e in trace[\"cycles\"]) == 9\ncores/bench/test/test_pipeline.py:892:async def predictor_stalled_loop_matches_zero_wait_trace(dut):\ncores/bench/test/test_pipeline.py:909:        assert an