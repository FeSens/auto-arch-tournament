epted on the commit edge still takes the old prediction.\ncores/bench/test/test_if_stage.py:109:    _, _, predicted = await _cycle(dut, redirect=1, redirect_target=0)\ncores/bench/test/test_if_stage.py:115:    _, _, predicted = await _cycle(dut, redirect=1, redirect_target=0)\ncores/bench/test/test_if_stage.py:117:    # A bogus feedback payload with valid=0 cannot change the prediction.\ncores/bench/test/test_if_stage.py:122:    # old prediction advances the PC on that edge.\ncores/bench/test/test_if_stage.py:126:    _, _, predicted = await _cycle(dut, redirect=1, redirect_target=0)\ncores/bench/test/test_if_stage.py:133:    _, _, predicted = await _cycle(dut, redirect=1, redirect_target=0)\ncores/bench/test/test_if_stage.py:161:    # Jumps become strongly taken. A subsequent not-taken keeps prediction\ncores/bench/test/test_if_stage.py:176:        _, pc, predicted = await _cycle(dut, redirect=1, redirect_target=index * 4)\ncores/bench/test/test_if_stage.py:181:async def continuous_alias_events_commit_against_current_row(dut):\ncores/bench/test/test_if_stage.py:187:        alias = pc ^ 0x80000040\ncores/bench/test/test_if_stage.py:194:            (alias, dict(resolve_branch=1)),\ncores/bench/test/test_if_stage.py:195:            (alias, dict()),\ncores/bench/test/test_if_stage.py:196:            (alias, dict(resolve_jump=1)),\ncores/bench/test/test_if_stage.py:198:            (alias, dict(resolve_branch=1)),\ncores/bench/test/test_if_stage.py:202:            (alias, dict(resolve_branch=1, resolve_taken=1)),\ncores/bench/test/test_if_stage.py:204:            (alias, dict(resolve_legal=0, resolve_branch=1, resolve_taken=1)),\ncores/bench/test/test_if_stage.py:205:            (alias, dict(resolve_branch=1, resolve_taken=1)),\ncores/bench/test/test_if_stage.py:210:                         redirect=1, redirect_target=pc if step & 1 else alias,\ncores/bench/test/test_if_stage.py:216:        for victim in (pc, alias):\ncores/bench/test/test_if_stage.py:217:            await _cycle(dut, model, redirect=1, redirect_target=victim)\ncores/bench/test/test_if_stage.py:232:        await cycle(redirect=1, redirect_target=pc)\ncores/bench/test/test_if_stage.py:241:    aliases = [pc ^ 0x80000000 for pc in pcs]\ncores/bench/test/test_if_stage.py:245:    for pc in pcs + aliases:\ncores/bench/test/test_if_stage.py:248:    for index, (pc, alias) in enumerate(zip(pcs, aliases)):\ncores/bench/test/test_if_stage.py:260:            await train(alias, resolve_target=0xFFFFFFFC, **inputs)\ncores/bench/test/test_if_stage.py:264:        await fetch(alias)\ncores/bench/test/test_if_stage.py:267:        # Same-PC replacement and same-index alias allocation must advance\ncores/bench/test/test_if_stage.py:268:        # an accepted fetch using the prediction visible BEFORE the edge.\ncores/bench/test/test_if_stage.py:271:        await train(alias, stall=0, resolve_branch=1, resolve_taken=1,\ncores/bench/test/test_if_stage.py:274:        await fetch(alias)\ncores/bench/test/test_if_stage.py:275:        await train(alias, stall=0, resolve_jump=1, resolve_target=alias)\ncores/bench/test/test_if_stage.py:276:        await fetch(alias)\ncores/bench/test/test_if_stage.py:277:        await train(alias, stall=0, resolve_jump=1, resolve_target=pc)\ncores/bench/test/test_if_stage.py:280:        # ordinary instructions, illegal controls, and trapped controls.\ncores/bench/test/test_if_stage.py:282:                               (alias, dict(resolve_legal=0, resolve_jump=1)),\ncores/bench/test/test_if_stage.py:299:        alias = pc ^ (1 << bit)\ncores/bench/test/test_if_stage.py:301:        await train(alias, resolve_branch=1)\ncores/bench/test/test_if_stage.py:302:        await train(alias, resolve_legal=0, resolve_jump=1)\ncores/bench/test/test_if_stage.py:303:        await fetch(alias)\ncores/bench/test/test_if_stage.py:305:        await train(alias, resolve_jump=1, resolve_target=1 << bit)\ncores/bench/test/test_if_stage.py:306:        await fetch(alias)\ncores/bench/test/test_if_stage.py:320:    for stall, flush, redirect in ((0, 1, 0), (1, 0, 0), (0, 0, 1), (1, 1, 1)):\ncores/bench/test/test_if_stage.py:322:        await train(pcs[0], stall=stall, flush=flush, redirect=redirect,\ncores/bench/test/test_if_stage.py:323:                    redirect_target=pcs[1], resolve_jump=1, resolve_target=0xC1234560)\ncores/bench/test/test_if_stage.py:327:    # fetch/update activity, aliases, bubbles, and changing instruction data.\ncores/bench/test/test_if_stage.py:329:    resolved_pcs = set(pcs + aliases)\ncores/bench/test/test_if_stage.py:331:        pc = rng.choice(pcs + aliases)\ncores/bench/test/test_if_stage.py:333:                      redirect=rng.randrange(4) == 0, redirect_target=pc,\ncores/bench/test/test_if_stage.py:335:                      resolve_pc=rng.choice((pc, model.pc, rng.choice(pcs + aliases))),\ncores/bench/test/test_if_stage.py:355:    # to prove that payload left unreset cannot contribute to prediction.\ncores/bench/test/test_if_stage.py:358:    await cycle(reset=1, stall=0, flush=1, redirect=1, redirect_target=pcs[1],\ncores/bench/test/test_if_stage.py:360:    for pc in pcs + aliases:\n","exit_code":0,"status":"completed"}}
