{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json, re, subprocess\nfrom pathlib import Path\np=Path('cores/bench/experiments/hypotheses/hyp-20260905-003-r5s2.yaml')\nraw=subprocess.check_output(['/usr/bin/ruby','-ryaml','-rjson','-e','puts JSON.generate(YAML.safe_load(File.read(ARGV[0])))',str(p)],text=True)\ndoc=json.loads(raw)\nschema=json.loads(Path('schemas/hypothesis.schema.json').read_text())\n\ndef validate(value, rule, path='\"'$'\"'):\n    supported={'\"'$schema'\"','type','required','properties','description','pattern','minLength','enum','minItems','items'}\n    assert not set(rule)-supported, (path,'unsupported schema keys',set(rule)-supported)\n    types={'object':dict,'array':list,'string':str,'integer':int}\n    if 'type' in rule:\n        assert type(value) is types[rule['type']], (path,'type',rule['type'])\n    if 'enum' in rule:\n        assert value in rule['enum'], (path,'enum')\n    if isinstance(value,dict):\n        assert all(k in value for k in rule.get('required',[])), (path,'required')\n        for key,child in rule.get('properties',{}).items():\n            if key in value:\n                validate(value[key],child,path+'.'+key)\n    if isinstance(value,list):\n        assert len(value)>=rule.get('minItems',0), (path,'minItems')\n        if 'items' in rule:\n            for i,item in enumerate(value):\n                validate(item,rule['items'],f'{path}[{i}]')\n    if isinstance(value,str):\n        assert len(value)>=rule.get('minLength',0), (path,'minLength')\n        if 'pattern' in rule:\n            assert re.search(rule['pattern'],value), (path,'pattern')\n\nvalidate(doc,schema)\nassert doc['id']=='hyp-20260905-003-r5s2'\nassert doc['category']=='predictor'\nassert -50<=doc['expected_impact']['fitness_delta_pct']<=50\nfor change in doc['changes']:\n    assert (Path('cores/bench')/change['file']).is_file(), change['file']\nprint('PASS: YAML parsed; all constraints in hypothesis.schema.json checked; exact ID, category, integer bounds, and bench-relative paths verified.')\nprint(f'{p}: {len(doc[\\\"changes\\\"])} proposed file changes, expected fitness +{doc[\\\"expected_impact\\\"][\\\"fitness_delta_pct\\\"]}%.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
