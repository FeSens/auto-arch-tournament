r to PC+4.\"\"\"\ncores/bench/test/test_pipeline.py:668:        assert [e[\"predicted\"] for e in _fetches(trace, 0)][:4] == [4, 32, 32, 4]\ncores/bench/test/test_pipeline.py:680:async def predictor_not_taken_misaligned_target_is_legal(dut):\ncores/bench/test/test_pipeline.py:686:async def predictor_imem_stall_does_not_consume_prediction(dut):\ncores/bench/test/test_pipeline.py:703:    assert all(e[\"pc\"] == 8 and e[\"predicted\"] == 4 and not e[\"accepted\"] for e in stalled)\ncores/bench/test/test_pipeline.py:705:    assert [e[\"predicted\"] for e in _fetches(trace, 8)] == [12, 4, 4, 4]\ncores/bench/test/test_pipeline.py:710:async def predictor_recovery_overrides_imem_stall(dut):\ncores/bench/test/test_pipeline.py:724:async def predictor_held_branch_trains_once_and_keeps_wb_forwarding(dut):\ncores/bench/test/test_pipeline.py:752:    assert [e[\"predicted\"] for e in _fetches(trace, 8)][:3] == [12, 24, 12]\ncores/bench/test/test_pipeline.py:761:async def predictor_pending_commit_during_backend_and_fetch_holds(dut):\ncores/bench/test/test_pipeline.py:800:async def predictor_reset_cancels_captured_resolution(dut):\ncores/bench/test/test_pipeline.py:816:    assert [e[\"predicted\"] for e in _fetches(fresh, 0)] == [4]\ncores/bench/test/test_pipeline.py:821:async def predictor_stalled_loop_matches_zero_wait_trace(dut):\ncores/bench/test/test_pipeline.py:842:                assert b[\"pc\"] == a[\"pc\"], \"stalled fetch consumed a prediction\"\ncores/bench/test/test_pipeline.py:852:    \"\"\"Check exactly-once execution, full bubbles, saved metadata, and writes.\"\"\"\ncores/bench/test/test_pipeline.py:871:        assert all(not e[\"wb_write\"] for e in events[launch[\"cycle\"] + 2:accept[\"cycle\"] + 1])\ncores/bench/test/test_pipeline.py:878:    assert [(e[\"wb_rd\"], e[\"wb_data\"]) for e in events if e[\"wb_write\"] and e[\"wb_rd\"]] == [\ncores/bench/test/test_pipeline.py:1047:async def divider_stale_prediction_recovers_once(dut):\ncores/bench/test/test_pipeline.py