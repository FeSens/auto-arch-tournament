n\nvalidate(data, schema)\nassert data['id'] == 'hyp-20260906-001-r13s0'\nassert data['category'] == 'micro_opt'\nassert -50 <= data['expected_impact']['fitness_delta_pct'] <= 50\nfor change in data['changes']:\n    target = Path('cores/bench') / change['file']\n    assert target.is_file(), target\n    assert '..' not in Path(change['file']).parts\nprint(f'PASS: YAML parsed and all schema constraints validated; {len(data[\\\"changes\\\"])} permitted bench change paths.')\nprint(path.resolve())\nPY\ngit diff --check\ngit status --short --untracked-files=all\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
