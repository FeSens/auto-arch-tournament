h/test/test_pipeline.py:67:def ECALL():             return 0x00000073\ncores/bench/test/test_pipeline.py:68:def MOP(funct3, rd, rs1, rs2): return _r(1, rs2, rs1, funct3, rd, 0x33)\ncores/bench/test/test_pipeline.py:69:def DIV (rd, rs1, rs2): return MOP(4, rd, rs1, rs2)\ncores/bench/test/test_pipeline.py:70:def DIVU(rd, rs1, rs2): return MOP(5, rd, rs1, rs2)\ncores/bench/test/test_pipeline.py:71:def REM (rd, rs1, rs2): return MOP(6, rd, rs1, rs2)\ncores/bench/test/test_pipeline.py:72:def REMU(rd, rs1, rs2): return MOP(7, rd, rs1, rs2)\ncores/bench/test/test_pipeline.py:76:async def _run(dut, program, dmem_init=None, max_cycles=200, *,\ncores/bench/test/test_pipeline.py:222:def _by_insn(retirements, insn):\ncores/bench/test/test_pipeline.py:229:async def forwarding_ex_to_ex(dut):\ncores/bench/test/test_pipeline.py:245:async def forwarding_mem_to_ex(dut):\ncores/bench/test/test_pipeline.py:254:async def load_use_stalls(dut):\ncores/bench/test/test_pipeline.py:275:async def branch_taken_skips(dut):\ncores/bench/test/test_pipeline.py:301:async def jal_writes_pc_plus_4(dut):\ncores/bench/test/test_pipeline.py:320:async def jalr_target(dut):\ncores/bench/test/test_pipeline.py:337:async def sw_lw_roundtrip(dut):\ncores/bench/test/test_pipeline.py:353:async def illegal_traps(dut):\ncores/bench/test/test_pipeline.py:362:    Our reference.py and DUT both follow the zeroed-on-trap convention,\ncores/bench/test/test_pipeline.py:376:async def ecall_traps(dut):\ncores/bench/test/test_pipeline.py:388:async def ebreak_does_not_trap(dut):\ncores/bench/test/test_pipeline.py:397:async def rvfi_order_strictly_monotonic(dut):\ncores/bench/test/test_pipeline.py:411:def _fetches(trace, pc):\ncores/bench/test/test_pipeline.py:415:def _resolutions(trace, pc):\ncores/bench/test/test_pipeline.py:419:def _next_gaps(rets, pc):\ncores/bench/test/test_pipeline.py:424:async def predictor_backward_loop_and_exit(dut):\ncores/bench/test/test_pipeline.py:441:async def predictor_forward_branch_and_direc