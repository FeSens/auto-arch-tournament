x_mhz\": 142.29,\n        \"delay_ns\": 7.03,\n        \"source\": \"cpu.u_id.reg_q_DFFRE_Q_195.Q\",\n        \"source_alias\": [\n          [\n            \"cpu.u_id.reg_q\",\n            [\n              53\n            ]\n          ]\n        ],\n        \"destination\": \"cpu.u_ex.reg_q_DFFR_Q_66.D\",\n        \"destination_q_alias\": [\n          [\n            \"cpu.u_ex.reg_q\",\n            [\n              260\n            ]\n          ]\n        ],\n        \"breakdown\": \"3.52 ns logic, 3.51 ns routing\"\n      },\n      {\n        \"seed\": 2,\n        \"fmax_mhz\": 150.99,\n        \"delay_ns\": 6.62,\n        \"source\": \"cpu.u_if.metadata[0].tag_q_DFFE_Q_24.Q\",\n        \"source_alias\": [],\n        \"destination\": \"cpu.u_if.metadata[0].counter_q_DFFSE_Q_1.CE\",\n        \"destination_q_alias\": [],\n        \"breakdown\": \"2.15 ns logic, 4.47 ns routing\"\n      },\n      {\n        \"seed\": 3,\n        \"fmax_mhz\": 146.65,\n        \"delay_ns\": 6.82,\n        \"source\": \"cpu.u_id.reg_q_DFFRE_Q_195.Q\",\n        \"source_alias\": [\n          [\n            \"cpu.u_id.reg_q\",\n            [\n              53\n            ]\n          ]\n        ],\n        \"destination\": \"cpu.u_ex.reg_q_DFFR_Q_80.D\",\n        \"destination_q_alias\": [\n          [\n            \"cpu.u_ex.reg_q\",\n            [\n              246\n            ]\n          ]\n        ],\n        \"breakdown\": \"3.26 ns logic, 3.56 ns routing\"\n      }\n    ],\n    \"median_fmax_mhz\": 146.65\n  }\n}","exit_code":0,"status":"completed"}}
