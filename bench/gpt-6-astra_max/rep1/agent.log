or the target predictor\", \"outcome\": \"regression\", \"delta_pct\": -12.49, \"fmax_mhz\": 143.37, \"cycles\": 4215262, \"lut4\": 6080, \"ff\": 2595}\n{\"id\": \"hyp-20260905-003-r7s2\", \"title\": \"Eight-entry target predictor with shorter lookup and less training fanout\", \"outcome\": \"regression\", \"delta_pct\": -8.6, \"fmax_mhz\": 150.94, \"cycles\": 4249105, \"lut4\": 6158, \"ff\": 2732}\n{\"id\": \"hyp-20260905-003-r8s2\", \"title\": \"Train bimodal direction counters independently of target tags\", \"outcome\": \"regression\", \"delta_pct\": -33.64, \"fmax_mhz\": 108.97, \"cycles\": 4224967, \"lut4\": 6508, \"ff\": 3166}\n{\"id\": \"hyp-20260905-003-r9s2\", \"title\": \"Capture raw predictor events before update classification\", \"outcome\": \"regression\", \"delta_pct\": -23.41, \"fmax_mhz\": 125.47, \"cycles\": 4215262, \"lut4\": 6675, \"ff\": 3219}\n{\"id\": \"hyp-20260905-003-r10s2\", \"title\": \"Train the predictor from registered EX/MEM results\", \"outcome\": \"regression\", \"delta_pct\": -12.29, \"fmax_mhz\": 143.66, \"cycles\": 4214035, \"lut4\": 6636, \"ff\": 3175}\n{\"id\": \"hyp-20260905-003-r11s2\", \"title\": \"Prevalidate sequential and direct-target predictions in decode\", \"outcome\": \"regression\", \"delta_pct\": -65.45, \"fmax_mhz\": 56.61, \"cycles\": 4215262, \"lut4\": 6755, \"ff\": 3200}\n{\"id\": \"hyp-20260906-003-r12s2\", \"title\": \"XOR-folded PC indexing for the existing tagged target predictor\", \"outcome\": \"regression\", \"delta_pct\": -15.67, \"fmax_mhz\": 138.33, \"cycles\": 4220552, \"lut4\": 6608, \"ff\": 3194}\n{\"id\": \"hyp-20260906-003-r13s2\", \"title\": \"Validate sequential predictions from unflushed IF state\", \"outcome\": \"regression\", \"delta_pct\": -10.49, \"fmax_mhz\": 146.65, \"cycles\": 4215262, \"lut4\": 6661, \"ff\": 3199}\n","exit_code":0,"status":"completed"}}
