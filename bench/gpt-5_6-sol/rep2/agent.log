{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"''^([a-zA-Z0-9_-]+):|dstall|CORE_DIR\" Makefile cores/bench/test/_helpers.py test/cosim/run_cosim.py | head -180 && git diff -- cores/bench/rtl'","aggregated_output":"Makefile:75:help:\nMakefile:96:lint:\nMakefile:103:test:\nMakefile:106:test-infra:\nMakefile:109:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\nMakefile:112:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\nMakefile:118:formal:\nMakefile:126:formal-deep:\nMakefile:129:bench:\nMakefile:132:fpga: cosim-build bench/programs/coremark.elf $(GEN_DIR)/synth.json\nMakefile:146:next:\nMakefile:149:loop:\nMakefile:170:report:\nMakefile:173:clean:\ndiff --git a/cores/bench/rtl/hazard_unit.sv b/cores/bench/rtl/hazard_unit.sv\nindex 98177ff..3fb0832 100644\n--- a/cores/bench/rtl/hazard_unit.sv\n+++ b/cores/bench/rtl/hazard_unit.sv\n@@ -26,11 +26,10 @@ module hazard_unit (\n   // random ~22% stall in vex_main.cpp). When low, the corresponding\n   // memory request is NOT serviced this cycle.\n   input  logic       imem_ready,\n-  input  logic       dmem_ready,\n-  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n-  // would actually be holding up). Computed at top level from the\n-  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n-  input  logic       ex_mem_mem_op,\n+  // Memory-stage ordering/backpressure. This is low for a newly posted store,\n+  // allowing independent instructions to continue, and high for loads/MMIO or\n+  // a memory follower waiting behind the posted write.\n+  input  logic       mem_block,\n   input  logic       ex_div_wait,       // iterative divider owns ID/EX\n   output logic       stall_if,          // PC reg holds\n   output logic       stall_id,          // ID/EX register holds (vs. bubble)\n@@ -43,19 +42,14 @@ module hazard_unit (\n \n   logic load_use_hazard;\n   logic imem_stall;\n-  logic dmem_stall;\n \n   always_comb begin\n     load_use_hazard = id_ex_mem_read\n                    && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                    && (id_ex_rd != 5'b0);\n     imem_stall = !imem_ready;\n-    // dmem stall only matters if there's actually a memory op in EX/MEM\n-    // — otherwise bus-not-ready is irrelevant to the pipeline.\n-    dmem_stall = !dmem_ready && ex_mem_mem_op;\n-\n     // PC reg holds on any stall reason.\n-    stall_if      = load_use_hazard || imem_stall || dmem_stall || ex_div_wait;\n+    stall_if      = load_use_hazard || imem_stall || mem_block || ex_div_wait;\n     // IF/ID combinational payload: NOP whenever we wouldn't have a valid\n     // instruction this cycle (redirect target unknown to IF, or imem\n     // didn't deliver).\n@@ -68,16 +62,16 @@ module hazard_unit (\n     // dmem_stall takes precedence over load_use's bubble: re-evaluate\n     // load_use next cycle when the bus unblocks. flush_id is 1 only when\n     // we want bubble (not hold).\n-    stall_id      = dmem_stall || load_use_hazard || ex_div_wait;\n-    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !ex_div_wait;\n+    stall_id      = mem_block || load_use_hazard || ex_div_wait;\n+    flush_id      = (load_use_hazard || redirect) && !mem_block && !ex_div_wait;\n     // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n     // bus delivers).\n-    stall_ex_mem  = dmem_stall;\n+    stall_ex_mem  = mem_block;\n     // MEM/WB register: on dmem_stall the previously-retired instruction's\n     // data fields stay alive for forwarding (e.g. a held BNE needs the\n     // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n     // double-retire / double-write the regfile.\n-    hold_mem_wb   = dmem_stall;\n+    hold_mem_wb   = mem_block;\n   end\n \n endmodule\ndiff --git a/cores/bench/rtl/mem_stage.sv b/cores/bench/rtl/mem_stage.sv\nindex eb40d73..fd46689 100644\n--- a/cores/bench/rtl/mem_stage.sv\n+++ b/cores/bench/rtl/mem_stage.sv\n@@ -1,8 +1,8 @@\n // rtl/mem_stage.sv\n //\n-// Memory access stage. Drives the dmem read/write ports combinationally\n-// from the EX/MEM register, and sign/zero-extends the loaded data into\n-// the MEM/WB register.\n+// Memory access stage. Ordinary stalled stores are copied into a one-entry\n+// posted-write buffer so younger non-memory instructions can continue. Loads,\n+// later stores, and MMIO writes remain ordered behind the pending write.\n //\n // Byte-lane discipline:\n //   - Write data is replicated across all four byte lanes; the\n@@ -39,6 +39,10 @@ module mem_stage (\n   input  logic [31:0]        dmem_rdata,\n   output logic [3:0]         dmem_wen,\n   output logic               dmem_ren,\n+  input  logic               dmem_ready,\n+  // Blocks EX/MEM only when the current instruction cannot advance. A newly\n+  // posted ordinary store does not block; loads and ordered followers do.\n+  output logic               mem_block,\n   // MEM/WB register output\n   output mem_wb_t  out\n );\n@@ -55,6 +59,20 @@ module mem_stage (\n   logic [15:0] hword_val;\n   logic [31:0] load_data;\n \n+  // One-entry posted-store buffer. The buffered request owns the external bus\n+  // until its ready handshake. On that same edge an ordinary store waiting in\n+  // EX/MEM may refill the entry, preserving store order without a dead cycle.\n+  logic        store_buf_valid_q;\n+  logic [31:0] store_buf_addr_q;\n+  logic [31:0] store_buf_wdata_q;\n+  logic [3:0]  store_buf_wmask_q;\n+  logic        current_store;\n+  logic        current_load;\n+  logic        current_mmio_store;\n+  logic        current_postable_store;\n+  logic        store_buf_drain;\n+  logic        store_buf_fill;\n+\n   // Misaligned mem-access trap. RV32I requires word-aligned LW/SW and\n   // halfword-aligned LH/LHU/SH; byte ops are always aligned.\n   // riscv-formal's RISCV_FORMAL_ALIGNED_MEM contract demands rvfi_trap=1\n@@ -79,7 +97,7 @@ module mem_stage (\n       default: byte_mask = 4'b1111;\n     endcase\n \n-    mem_op       = in.ctrl.mem_read || in.ctrl.mem_write;\n+    mem_op       = in.valid && (in.ctrl.mem_read || in.ctrl.mem_write);\n     mem_misalign = mem_op && (\n                      (in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\n                      (in.ctrl.mem_width == 2'd1 && in.alu_result[0]   != 1'b0)\n@@ -92,11 +110,50 @@ module mem_stage (\n       ctrl_with_trap.reg_write  = 1'b0;\n     end\n \n-    // Combinational dmem outputs — gated off on misalign.\n-    dmem_addr  = in.alu_result;\n-    dmem_wdata = wdata_rep;\n-    dmem_wen   = (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n-    dmem_ren   = in.ctrl.mem_read  && !mem_misalign;\n+    current_store = in.valid && in.ctrl.mem_write && !mem_misalign;\n+    current_load  = in.valid && in.ctrl.mem_read  && !mem_misalign;\n+    // The UART and benchmark marker window is deliberately non-posted. In\n+    // particular, the start marker must handshake before benchmark execution\n+    // is allowed to proceed or the measured interval would be shortened.\n+    current_mmio_store = current_store\n+                       && (in.alu_result >= 32'h1000_0000)\n+                       && (in.alu_result <  32'h1000_0200);\n+    current_postable_store = current_store && !current_mmio_store;\n+    store_buf_drain = store_buf_valid_q && dmem_ready;\n+\n+    // A fill occurs either when a direct ordinary store first encounters\n+    // backpressure, or when an older buffered write drains while the next\n+    // ordinary store is waiting. In both cases the current store retires once\n+    // at this edge and the external write occurs later from the buffer.\n+    store_buf_fill = current_postable_store\n+                   && ((!store_buf_valid_q && !dmem_ready)\n+                       || (store_buf_valid_q && dmem_ready));\n+\n+    // Buffered writes have strict bus priority. A follower load cannot use the\n+    // drain cycle's read data because that cycle is still the older write's\n+    // handshake.\n+    if (store_buf_valid_q) begin\n+      dmem_addr  = store_buf_addr_q;\n+      dmem_wdata = store_buf_wdata_q;\n+      dmem_wen   = store_buf_wmask_q;\n+      dmem_ren   = 1'b0;\n+    end else begin\n+      dmem_addr  = in.alu_result;\n+      dmem_wdata = wdata_rep;\n+      dmem_wen   = current_store ? byte_mask : 4'b0000;\n+      dmem_ren   = current_load;\n+    end\n+\n+    if (store_buf_valid_q) begin\n+      // Non-memory instructions pass. A store may replace a draining entry;\n+      // a load or MMIO store waits one additional cycle for a direct access.\n+      mem_block = (current_load || current_store)\n+                && !(current_postable_store && dmem_ready);\n+    end else begin\n+      // Loads and non-posted MMIO stores retain the original ready interlock.\n+      // Misaligned accesses do not issue and therefore never wait on ready.\n+      mem_block = (current_load || current_mmio_store) && !dmem_ready;\n+    end\n \n     // Load extraction: shift right then sign/zero-extend the low N bits.\n     shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\n@@ -118,6 +175,24 @@ module mem_stage (\n                  : 32'b0;\n   end\n \n+  always_ff @(posedge clock) begin\n+    if (reset) begin\n+      store_buf_valid_q <= 1'b0;\n+      store_buf_addr_q  <= 32'b0;\n+      store_buf_wdata_q <= 32'b0;\n+      store_buf_wmask_q <= 4'b0;\n+    end else begin\n+      if (store_buf_fill) begin\n+        store_buf_valid_q <= 1'b1;\n+        store_buf_addr_q  <= in.alu_result;\n+        store_buf_wdata_q <= wdata_rep;\n+        store_buf_wmask_q <= byte_mask;\n+      end else if (store_buf_drain) begin\n+        store_buf_valid_q <= 1'b0;\n+      end\n+    end\n+  end\n+\n   // ── MEM/WB register ───────────────────────────────────────────────────\n   mem_wb_t reg_q;\n \ndiff --git a/cores/bench/rtl/zcore.sv b/cores/bench/rtl/zcore.sv\nindex 1360eb8..87c8d3b 100644\n--- a/cores/bench/rtl/zcore.sv\n+++ b/cores/bench/rtl/zcore.sv\n@@ -80,6 +80,7 @@ module core (\n   // hazard / forward\n   logic       stall_if, stall_id, flush_if, flush_id;\n   logic       stall_ex_mem, hold_mem_wb;\n+  logic       mem_block;\n   logic       ex_div_wait;\n   logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\n \n@@ -162,6 +163,8 @@ module core (\n     .dmem_rdata (io_dmemRData),\n     .dmem_wen   (io_dmemWEn),\n     .dmem_ren   (io_dmemREn),\n+    .dmem_ready (io_dmemReady),\n+    .mem_block  (mem_block),\n     .out        (mem_wb_w)\n   );\n \n@@ -181,8 +184,7 @@ module core (\n     .if_id_rs2      (if_id_w.instr[24:20]),\n     .redirect       (redirect),\n     .imem_ready     (io_imemReady),\n-    .dmem_ready     (io_dmemReady),\n-    .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\n+    .mem_block      (mem_block),\n     .ex_div_wait     (ex_div_wait),\n     .stall_if       (stall_if),\n     .stall_id       (stall_id),\n","exit_code":0,"status":"completed"}}
