{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"tail -80 cores/bench/test/test_pipeline.py && sed -n '1,130p' cores/bench/test/_helpers.py && rg -n \\\"pytest|cocotb\\\" cores/bench/Makefile Makefile | head -80\"","aggregated_output":"    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\n@cocotb.test()\nasync def dependent_divide_result(dut):\n    \"\"\"A consumer immediately behind DIV receives the completed EX/MEM value.\"\"\"\n    div = DIV(3, 1, 2)\n    add = ADD(4, 3, 2)\n    program = [ADDI(1, 0, 100), ADDI(2, 0, 7), div, add, EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=100)\n    [rd] = _by_insn(rets, div)\n    [ra] = _by_insn(rets, add)\n    assert rd[\"rd_wdata\"] == 14\n    assert rd[\"rs1_rdata\"] == 100 and rd[\"rs2_rdata\"] == 7\n    assert ra[\"rd_wdata\"] == 21\n    assert len(_by_insn(rets, div)) == 1\n\n\n@cocotb.test()\nasync def back_to_back_divide_remainder(dut):\n    \"\"\"Back-to-back M-unit requests retire once each and preserve ordering.\"\"\"\n    divu = DIVU(3, 1, 2)\n    remu = REMU(4, 1, 2)\n    program = [ADDI(1, 0, 100), ADDI(2, 0, 7), divu, remu, EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=140)\n    [rq] = _by_insn(rets, divu)\n    [rr] = _by_insn(rets, remu)\n    assert rq[\"rd_wdata\"] == 14 and rr[\"rd_wdata\"] == 2\n    assert rq[\"order\"] + 1 == rr[\"order\"]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n\n\n@cocotb.test()\nasync def divide_corner_cases(dut):\n    \"\"\"Signed overflow and divide-by-zero use the exact RV32M results.\"\"\"\n    # ADDI -1 followed by SLL via repeated doubling builds INT_MIN cheaply.\n    program = [\n        ADDI(1, 0, -1),\n        ADDI(2, 0, 0),\n        DIV(3, 1, 2),          # -1 / 0 = -1\n        REM(4, 1, 2),          # -1 % 0 = -1\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=100)\n    [rd] = _by_insn(rets, DIV(3, 1, 2))\n    [rr] = _by_insn(rets, REM(4, 1, 2))\n    assert rd[\"rd_wdata\"] == 0xFFFFFFFF\n    assert rr[\"rd_wdata\"] == 0xFFFFFFFF\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"zcore.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\nrg: cores/bench/Makefile: No such file or directory (os error 2)\nMakefile:78:\t@echo \"  make test TARGET=v1     — cocotb unit tests under cores/<TARGET>/test/\"\nMakefile:104:\tpytest -v $(TEST_DIR)/\nMakefile:107:\tpytest -v tools/\n","exit_code":0,"status":"completed"}}
