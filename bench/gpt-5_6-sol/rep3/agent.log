{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '55,330p' cores/bench/rtl/ex_stage.sv\"","aggregated_output":"    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  alu u_alu (\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );\n\n  // ── Long-latency RV32M units ──────────────────────────────────────────\n  // Capture post-forwarding operands and the complete payload once at\n  // launch. ID/EX remains held while EX/MEM receives bubbles, allowing older\n  // instructions to drain. Multiply and divide have distinct completion\n  // state but share the hazard unit's single long-operation interlock.\n  logic        is_mul_op;\n  logic        is_div_op;\n  logic        mul_request;\n  logic        div_request;\n  logic        mul_start;\n  logic        div_start;\n  logic        mul_busy;\n  logic        div_busy;\n  logic        mul_done;\n  logic        div_done;\n  logic [31:0] mul_result_w;\n  logic [31:0] div_result_w;\n  logic        mul_active_q;\n  logic        div_active_q;\n  logic        mul_result_valid_q;\n  logic        div_result_valid_q;\n  logic [31:0] mul_result_q;\n  logic [31:0] div_result_q;\n  /* verilator lint_off UNUSEDSIGNAL */\n  id_ex_t      mul_in_q;\n  id_ex_t      div_in_q;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] mul_rs1_q;\n  logic [31:0] mul_rs2_q;\n  logic [31:0] div_rs1_q;\n  logic [31:0] div_rs2_q;\n  logic        mul_complete;\n  logic        div_complete;\n  logic [31:0] mul_result_selected;\n  logic [31:0] div_result_selected;\n\n  always_comb begin\n    is_mul_op = (in.ctrl.alu_op == ALU_MUL)\n             || (in.ctrl.alu_op == ALU_MULH)\n             || (in.ctrl.alu_op == ALU_MULHU)\n             || (in.ctrl.alu_op == ALU_MULHSU);\n    is_div_op = (in.ctrl.alu_op == ALU_DIV)\n             || (in.ctrl.alu_op == ALU_DIVU)\n             || (in.ctrl.alu_op == ALU_REM)\n             || (in.ctrl.alu_op == ALU_REMU);\n    mul_request = in.valid && is_mul_op && !in.ctrl.is_illegal\n                && !mul_active_q && !div_active_q;\n    div_request = in.valid && is_div_op && !in.ctrl.is_illegal\n                && !div_active_q && !mul_active_q;\n    mul_start = mul_request && !stall;\n    div_start = div_request && !stall;\n    mul_complete = mul_active_q && (mul_result_valid_q || mul_done);\n    div_complete = div_active_q && (div_result_valid_q || div_done);\n    mul_result_selected = mul_result_valid_q ? mul_result_q : mul_result_w;\n    div_result_selected = div_result_valid_q ? div_result_q : div_result_w;\n\n    // Launch is included so IF and ID cannot advance on the acceptance edge.\n    // Completion is excluded so the held younger instruction advances when\n    // the completed long-operation result enters EX/MEM.\n    ex_long_busy = mul_start || div_start || mul_busy || div_busy\n                 || (mul_active_q && !mul_complete)\n                 || (div_active_q && !div_complete);\n  end\n\n  mul_unit u_mul (\n    .clock  (clock),\n    .reset  (reset),\n    .start  (mul_start),\n    .op     (in.ctrl.alu_op),\n    .a      (alu_a),\n    .b      (alu_b),\n    .busy   (mul_busy),\n    .done   (mul_done),\n    .result (mul_result_w)\n  );\n\n  div_unit u_div (\n    .clock  (clock),\n    .reset  (reset),\n    .start  (div_start),\n    .op     (in.ctrl.alu_op),\n    .a      (alu_a),\n    .b      (alu_b),\n    .busy   (div_busy),\n    .done   (div_done),\n    .result (div_result_w)\n  );\n\n  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] jump_target;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 != rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'b0;\n    endcase\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    jalr_sum    = rs1 + in.imm;\n    jump_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0}\n                                  : (in.pc + in.imm);\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n\n  // A dependent branch/JALR may be sitting in EX while an older load waits\n  // in MEM. Do not let speculative/invalid dmem data redirect the fetch PC;\n  // the held instruction is re-evaluated exactly once when the load completes.\n  assign redirect        = (branch_taken || in.ctrl.is_jump)\n                         && !misalign_fault && !stall;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      mul_active_q       <= 1'b0;\n      div_active_q       <= 1'b0;\n      mul_result_valid_q <= 1'b0;\n      div_result_valid_q <= 1'b0;\n      mul_result_q       <= 32'b0;\n      div_result_q       <= 32'b0;\n      mul_in_q           <= '0;\n      div_in_q           <= '0;\n      mul_rs1_q          <= 32'b0;\n      mul_rs2_q          <= 32'b0;\n      div_rs1_q          <= 32'b0;\n      div_rs2_q          <= 32'b0;\n    end else begin\n      if (mul_start) begin\n        mul_active_q       <= 1'b1;\n        mul_result_valid_q <= 1'b0;\n        mul_result_q       <= 32'b0;\n        mul_in_q           <= in;\n        mul_rs1_q          <= rs1;\n        mul_rs2_q          <= rs2;\n      end else if (mul_complete && !stall) begin\n        mul_active_q       <= 1'b0;\n        mul_result_valid_q <= 1'b0;\n      end else if (mul_done && mul_active_q) begin\n        mul_result_q       <= mul_result_w;\n        mul_result_valid_q <= 1'b1;\n      end\n\n      if (div_start) begin\n        div_active_q       <= 1'b1;\n        div_result_valid_q <= 1'b0;\n        div_result_q       <= 32'b0;\n        div_in_q           <= in;\n        div_rs1_q          <= rs1;\n        div_rs2_q          <= rs2;\n      end else if (div_complete && !stall) begin\n        div_active_q       <= 1'b0;\n        div_result_valid_q <= 1'b0;\n      end else if (div_done && div_active_q) begin\n        // Completion may coincide with MEM backpressure. Preserve the result\n        // until EX/MEM can accept it even though div_unit's done pulse ends.\n        div_result_q       <= div_result_w;\n        div_result_valid_q <= 1'b1;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (stall) begin\n      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n      // stays in MEM stage waiting on the bus.\n      reg_q <= reg_q;\n    end else if (mul_complete) begin\n      reg_q.pc            <= mul_in_q.pc;\n      reg_q.alu_result    <= mul_result_selected;\n      reg_q.write_data    <= mul_rs2_q;\n      reg_q.rd            <= mul_in_q.rd;\n      reg_q.rs1_addr      <= mul_in_q.rs1_addr;\n      reg_q.rs2_addr      <= mul_in_q.rs2_addr;\n      reg_q.rs1_val       <= mul_rs1_q;\n      reg_q.rs2_val       <= mul_rs2_q;\n      reg_q.pc_next       <= mul_in_q.pc + 32'd4;\n      reg_q.branch_taken  <= 1'b0;\n      reg_q.branch_target <= mul_in_q.pc + mul_in_q.imm;\n      reg_q.ctrl          <= mul_in_q.ctrl;\n      reg_q.instr         <= mul_in_q.instr;\n      reg_q.valid         <= mul_in_q.valid;\n    end else if (div_complete) begin\n      reg_q.pc            <= div_in_q.pc;\n      reg_q.alu_result    <= div_result_selected;\n      reg_q.write_data    <= div_rs2_q;\n      reg_q.rd            <= div_in_q.rd;\n      reg_q.rs1_addr      <= div_in_q.rs1_addr;\n      reg_q.rs2_addr      <= div_in_q.rs2_addr;\n      reg_q.rs1_val       <= div_rs1_q;\n      reg_q.rs2_val       <= div_rs2_q;\n      reg_q.pc_next       <= div_in_q.pc + 32'd4;\n      reg_q.branch_taken  <= 1'b0;\n      reg_q.branch_target <= div_in_q.pc + div_in_q.imm;\n      reg_q.ctrl          <= div_in_q.ctrl;\n      reg_q.instr         <= div_in_q.instr;\n      reg_q.valid         <= div_in_q.valid;\n    end else if (mul_start || mul_active_q || div_start || div_active_q) begin\n      // Do not replay the previous EX/MEM instruction while a long op runs.\n      reg_q <= '0;\n    end else begin\n      reg_q.pc            <= in.pc;\n      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n      // sum (which is the jump target). The MEM/WB register's read-data\n      // mux only kicks in for LOADs, so we route PC+4 here.\n      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= rs1;\n      reg_q.rs2_val       <= rs2;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : (in.pc + 32'd4);\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid;\n    end\n  end\n\n","exit_code":0,"status":"completed"}}
