\ncores/bench/rtl/alu.sv:66:      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\ncores/bench/rtl/alu.sv:67:      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\ncores/bench/rtl/alu.sv:68:      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\ncores/bench/rtl/alu.sv:69:      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\ncores/bench/rtl/alu.sv:70:      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\ncores/bench/rtl/alu.sv:72:      ALU_MUL:    out = mul_uu[31:0];\ncores/bench/rtl/alu.sv:73:      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\ncores/bench/rtl/alu.sv:74:      ALU_MULHU:  out = mul_uu[63:32];\ncores/bench/rtl/alu.sv:75:      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\ncores/bench/rtl/alu.sv:76:      ALU_DIV: begin\ncores/bench/rtl/alu.sv:84:      ALU_DIVU: out = (b == 32'b0) ? 32'hFFFFFFFF : (a / b);\ncores/bench/rtl/alu.sv:85:      ALU_REM: begin\ncores/bench/rtl/alu.sv:93:      ALU_REMU: out = (b == 32'b0) ? a : (a % b);\ncores/bench/rtl/core.sv:33:  // random ~22% backpressure model so CoreMark/MHz can be compared\ncores/bench/rtl/decoder.sv:89:            10'b0000001_000: alu_op = ALU_MUL;\ncores/bench/rtl/decoder.sv:90:            10'b0000001_001: alu_op = ALU_MULH;\ncores/bench/rtl/decoder.sv:91:            10'b0000001_010: alu_op = ALU_MULHSU;\ncores/bench/rtl/decoder.sv:92:            10'b0000001_011: alu_op = ALU_MULHU;\ncores/bench/rtl/decoder.sv:93:            10'b0000001_100: alu_op = ALU_DIV;\ncores/bench/rtl/decoder.sv:94:            10'b0000001_101: alu_op = ALU_DIVU;\ncores/bench/rtl/decoder.sv:95:            10'b0000001_110: alu_op = ALU_REM;\ncores/bench/rtl/decoder.sv:96:            10'b0000001_111: alu_op = ALU_REMU;\ncores/bench/rtl/if_stage.sv:42:  // VexRiscv-binary CoreMark sweep with --istall enabled.\ncores/bench/test/test_alu.py:3:The ALU is purely combinational (RV32IM). MUL / DIV / REM use the\ncores/bench/test/test_alu.py:16:    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\ncores/bench/test/test_alu.py:17:    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\ncores/bench/test/test_alu.py:43:async def _check_div(dut, op, a, b, expected):\ncores/bench/test/test_alu.py:44:    \"\"\"Combinational div/rem — alias for _check. Was a multi-cycle FSM\ncores/bench/test/test_alu.py:117:async def mul(dut):\ncores/bench/test/test_alu.py:119:    await _check(dut, ALU_MUL, 3, 4, 12)\ncores/bench/test/test_alu.py:120:    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\ncores/bench/test/test_alu.py:124:async def mulh(dut):\ncores/bench/test/test_alu.py:127:    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\ncores/bench/test/test_alu.py:129:    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\ncores/bench/test/test_alu.py:130:    await _check(dut, ALU_MULH, 1, 1, 0)\ncores/bench/test/test_alu.py:134:async def mulhu(dut):\ncores/bench/test/test_alu.py:136:    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\ncores/bench/test/test_alu.py:137:    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\ncores/bench/test/test_alu.py:141:async def mulhsu(dut):\ncores/bench/test/test_alu.py:144:    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\ncores/bench/test/test_alu.py:146:    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\ncores/bench/test/test_alu.py:150:async def div_signed(dut):\ncores/bench/test/test_alu.py:152:    await _check_div(dut, ALU_DIV, 10, 3, 3)\ncores/bench/test/test_alu.py:153:    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\ncores/bench/test/test_alu.py:154:    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\ncores/bench/test/test_alu.py:158:async def div_by_zero(dut):\ncores/bench/test/test_alu.py:160:    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\ncores/bench/test/test_alu.py:161:    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\ncores/bench/test/test_alu.py:165:async def div_overflow(dut):\ncores/bench/test/test_alu.py:168:    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\ncores/bench/test/test_alu.py:172:async def divu(dut):\ncores/bench/test/test_alu.py:174:    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\ncores/bench/test/test_alu.py:175:    await _check_div(dut, ALU_DIVU, 100, 7, 14)\ncores/bench/test/test_alu.py:179:async def divu_by_zero(dut):\ncores/bench/test/test_alu.py:181:    await _check_div(dut, ALU_DIVU, 42, 0, 0xFFFFFFFF)\ncores/bench/test/test_alu.py:187:    await _check_div(dut, ALU_REM, 10, 3, 1)\ncores/bench/test/test_alu.py:189:    await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\ncores/bench/test/test_alu.py:190:    # 10 % -3 trunc-to-zero: 10 = (-3)*(-3) + 1 -> rem = 1 (sign of dividend)\ncores/bench/test/test_alu.py:191:    await _check_div(dut, ALU_REM, 10, 0xFFFFFFFD, 1)\ncores/bench/test/test_alu.py:197:    await _check_div(dut, ALU_REM, 0xDEADBEEF, 0, 0xDEADBEEF)\ncores/bench/test/test_alu.py:204:    await _check_div(dut, ALU_REM, 0x80000000, 0xFFFFFFFF, 0)\ncores/bench/test/test_alu.py:210:    await _check_div(dut, ALU_REMU, 7, 3, 1)\ncores/bench/test/test_alu.py:216:    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\ncores/bench/test/test_alu.py:220:async def back_to_back_divides(dut):\ncores/bench/test/test_alu.py:222:    divides — no carry-over of operands or state from the previous op.\ncores/bench/test/test_alu.py:225:    # Real divides only (avoid edge-case short-circuit) so each pass\ncores/bench/test/test_alu.py:227:    await _check_div(dut, ALU_DIVU, 100, 7, 14)\ncores/bench/test/test_alu.py:228:    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\ncores/bench/test/test_alu.py:229:    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\ncores/bench/test/test_alu.py:230:    await _check_div(dut, ALU_REM, 10, 3, 1)\ncores/bench/test/test_alu.py:231:    await _check_div(dut, ALU_REMU, 7, 3, 1)\ncores/bench/rtl/core_pkg.sv:32:  localparam logic [4:0] ALU_MUL    = 5'd11;\ncores/bench/rtl/core_pkg.sv