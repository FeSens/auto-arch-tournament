 await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\ncores/bench/test/test_alu.py:229:    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\ncores/bench/test/test_alu.py:230:    await _check_div(dut, ALU_REM, 10, 3, 1)\ncores/bench/test/test_alu.py:231:    await _check_div(dut, ALU_REMU, 7, 3, 1)\n","exit_code":0,"status":"completed"}}
