to x0 are suppressed here so the qualified\n+// enable can also safely drive the regfile's same-cycle read bypass. The\n+// regfile retains its own no-write-to-x0 guard as a backstop.\n //\n // Latency:        combinational.\n // RVFI fields:    feeds rd_wdata (= w_data when w_en=1, else 0).\n@@ -19,7 +20,7 @@ module wb_stage (\n );\n \n   always_comb begin\n-    w_en   = in.ctrl.reg_write && in.valid;\n+    w_en   = in.ctrl.reg_write && in.valid && (in.rd != 5'b0);\n     w_addr = in.rd;\n     w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;\n   end\ndiff --git a/cores/bench/test/test_pipeline.py b/cores/bench/test/test_pipeline.py\nindex 95eef19..e17e041 100644\n--- a/cores/bench/test/test_pipeline.py\n+++ b/cores/bench/test/test_pipeline.py\n@@ -198,6 +198,33 @@ async def forwarding_mem_to_ex(dut):\n     assert r2[\"rd_wdata\"] == 8\n \n \n+@cocotb.test()\n+async def writeback_read_bypass_and_x0_suppression(dut):\n+    \"\"\"WB->ID is write-first for x1-x31, while an x0 WB never bypasses.\n+\n+    Two independent instructions place each final consumer in ID during the\n+    producer's WB cycle. This specifically exercises the regfile read bypass,\n+    rather than the EX/MEM or MEM/WB forwarding paths used by closer consumers.\n+    \"\"\"\n+    write_x1 = ADDI(1, 0, 0x345)\n+    read_x1 = ADDI(2, 1, 7)\n+    write_x0 = ADDI(0, 0, 0x7FF)\n+    read_x0 = ADDI(5, 0, 9)\n+    program = [\n+        write_x1, ADDI(3, 0, 1), ADDI(4, 0, 2), read_x1,\n+        write_x0, ADDI(6, 0, 3), ADDI(7, 0, 4), read_x0,\n+        EBREAK(),\n+    ]\n+    rets, _ = await _run(dut, program)\n+\n+    [r_x1] = _by_insn(rets, read_x1)\n+    [r_x0_write] = _by_insn(rets, write_x0)\n+    [r_x0_read] = _by_insn(rets, read_x0)\n+    assert r_x1[\"rs1_rdata\"] == 0x345 and r_x1[\"rd_wdata\"] == 0x34C\n+    assert r_x0_write[\"rd\"] == 0 and r_x0_write[\"rd_wdata\"] == 0\n+    assert r_x0_read[\"rs1_rdata\"] == 0 and r_x0_read[\"rd_wdata\"] == 9\n+\n+\n @cocotb.test()\n async def load_use_bypasses_without_bubble(dut):\n     \"\"\"An adjacent load consumer gets the completed MEM response directly.\n","exit_code":0,"status":"completed"}}
