div_active_q && (div_result_valid_q || div_done);\ncores/v1/rtl/ex_stage.sv:94:    ex_long_busy = div_start || div_busy || (div_active_q && !div_complete);\ncores/v1/rtl/ex_stage.sv:104:    .busy   (div_busy),\ncores/v1/rtl/ex_stage.sv:105:    .done   (div_done),\ncores/v1/rtl/ex_stage.sv:204:      end else if (div_done && div_active_q) begin\ncores/ibex/rtl/ibex_multdiv_slow.sv:67:  logic [32:0] next_quotient;\ncores/ibex/rtl/ibex_multdiv_slow.sv:169:  assign next_quotient  = is_greater_equal ? op_a_shift_q | one_shift : op_a_shift_q;\ncores/ibex/rtl/ibex_multdiv_slow.sv:205:              // quotient for division by 0 is specified to be -1\ncores/ibex/rtl/ibex_multdiv_slow.sv:230:          // quotient\ncores/ibex/rtl/ibex_multdiv_slow.sv:267:              op_a_shift_d   = next_quotient;\ncores/ibex/rtl/ibex_multdiv_slow.sv:292:              // this time we save the quotient in accum_window_q since we do not need anymore the\ncores/ibex/rtl/ibex_multdiv_slow.sv:294:              accum_window_d = next_quotient;\ncores/ibex/rtl/ibex_multdiv_slow.sv:298:              // this time we do not save the quotient anymore since we need only the remainder\ncores/ibex/rtl/ibex_alu.sv:181:  // Rotations and funnel shifts are implemented as multi-cycle instructions.\ncores/ibex/rtl/ibex_alu.sv:475:    // and moving to iteratively sum up all the sub-trees.\ncores/ibex/UPSTREAM.md:23:lowRISC. OpenTitan-deployed. Configurable (small / maxperf, with/without PMP, single-cycle / multi-cycle multiplier). Yosys+nextpnr-himbaechel may not synthesize all SystemVerilog features used (interfaces, generate, classes); fallback to citation-only is documented in §7 of the paper. Three CoreMark/MHz figures from upstream README depending on config: 0.904 (small), 2.47 (mid), 3.13 (maxperf). The `citation_only` field in `core.yaml` records the small-config figure (0.904) as the conservative baseline.\ncores/ibex/rtl/ibex_multdiv_fast.sv:70:  logic [31:0] op_quotient_q;\ncores/ibex/rtl/ibex_multdiv_fast.sv:73:  logic [31:0] op_quotient_d;\ncores/ibex/rtl/ibex_multdiv_fast.sv:75:  logic [32:0] next_quotient;\ncores/ibex/rtl/ibex_multdiv_fast.sv:106:      op_quotient_q    <= '0;\ncores/ibex/rtl/ibex_multdiv_fast.sv:111:      op_quotient_q    <= op_quotient_d;\ncores/ibex/rtl/ibex_multdiv_fast.sv:390:  assign next_quotient  = is_greater_equal ? {1'b0, op_quotient_q} | {1'b0, one_shift} :\ncores/ibex/rtl/ibex_multdiv_fast.sv:391:                                             {1'b0, op_quotient_q};\ncores/ibex/rtl/ibex_multdiv_fast.sv:415:    op_quotient_d    = op_quotient_q;\ncores/ibex/rtl/ibex_multdiv_fast.sv:429:          // quotient for division by 0 is specified to be -1\ncores/ibex/rtl/ibex_multdiv_fast.sv:454:        // quotient\ncores/ibex/rtl/ibex_multdiv_fast.sv:455:        op_quotient_d   = '0;\ncores/ibex/rtl/ibex_multdiv_fast.sv:479:        op_quotient_d   = next_quotient[31:0];\ncores/ibex/rtl/ibex_multdiv_fast.sv:488:          // this time we save the quotient in op_remainder_d (i.e. imd_val_q_i[0]) since\ncores/ibex/rtl/ibex_multdiv_fast.sv:490:          op_remainder_d = {1'b0, next_quotient};\ncores/ibex/rtl/ibex_multdiv_fast.sv:492:          // this time we do not save the quotient anymore since we need only the remainder\ncores/baseline/rtl/alu.sv:11://   REM  by 0       -> dividend\ncores/baseline/rtl/alu.sv:12://   REMU by 0       -> dividend\ncores/baseline/rtl/alu.sv:17:module alu (\ncores/v1/rtl/div_unit.sv:61:  logic [31:0] dividend_q;\ncores/v1/rtl/div_unit.sv:64:  logic [31:0] quotient_q;\ncores/v1/rtl/div_unit.sv:88:  logic [31:0] quotient_step;\ncores/v1/rtl/div_unit.sv:90:  logic [31:0] signed_quotient;\ncores/v1/rtl/div_unit.sv:111:    trial_remainder   = {remainder_q, dividend_q[31]};\ncores/v1/rtl/div_unit.sv:116:    quotient_step     = {quotient_q[30:0], trial_take};\ncores/v1/rtl/div_unit.sv:118:    signed_quotient   = quot_neg_q ? (~quotient_step + 32'd1)\ncores/v1/rtl/div_unit.sv:119:                                   : quotient_step;\ncores/v1/rtl/div_unit.sv:122:    final_result      = want_rem_q ? signed_remainder : signed_quotient;\ncores/v1/rtl/div_unit.sv:129:      dividend_q  <= 32'b0;\ncores/v1/rtl/div_unit.sv:131:      quotient_q  <= 32'b0;\ncores/v1/rtl/div_unit.sv:141:            quotient_q  <= 32'b0;\ncores/v1/rtl/div_unit.sv:148:              dividend_q <= 32'b0;\ncores/v1/rtl/div_unit.sv:152:              dividend_q <= abs_a;\ncores/v1/rtl/div_unit.sv:164:            dividend_q  <= {dividend_q[30:0], 1'b0};\ncores/v1/rtl/div_unit.sv:165:            quotient_q  <= quotient_step;\ncores/bench/rtl/alu.sv:11://   REM  by 0       -> dividend\ncores/bench/rtl/alu.sv:12://   REMU by 0       -> dividend\ncores/bench/rtl/alu.sv:17:module alu (\ncores/v1/rtl/ex_stage.sv:68:  logic div_busy;\ncores/v1/rtl/ex_stage.sv:69:  logic div_done;\ncores/v1/rtl/ex_stage.sv:89:    div_complete = div_active_q && (div_result_valid_q || div_done);\ncores/v1/rtl/ex_stage.sv:94:    ex_long_busy = div_start || div_busy || (div_active_q && !div_complete);\ncores/v1/rtl/ex_stage.sv:104:    .busy   (div_busy),\ncores/v1/rtl/ex_stage.sv:105:    .done   (div_done),\ncores/v1/rtl/ex_stage.sv:204:      end else if (div_done && div_active_q) begin\ncores/v1/rtl/alu.sv:9:module alu (\ncores/v1/rtl/hazard_unit.sv:28:  input  logic       ex_long_busy,      // EX has a multi-cycle op occupying ID/EX\nid: hyp-20260711-001-r1s0\ntitle: \"Share one multiplier across all RV32M multiply variants\"\ncategory: micro_opt\nmotivation: |\n  The combinational ALU currently describes three independent 64-bit products for\n  signed-signed, unsigned-unsigned, and signed-unsigned multiplication. All three\n  exist in the synthesized datapath even though a single-issue instruction can use\n  only one multiply result, consuming scarce LUTs and routing resources on a design\n  already at 9563 LUT4s and likely depressing Fmax.\nhypothesis: |\n  Compute one 64-bit unsigned product a*b and derive the signed high-half results\n  with the standard modulo-2^32 corrections: MULH subtracts b when a is negative\n  and a when b is negative, while MULHSU subtracts b only when a is negative.\n  MUL and MULHU select the low and high halves of the shared product directly.\n  Keeping the existing RISCV_FORMAL_ALTOPS branch unchanged preserves tractable\n  formal checks. This removes two full multipliers without adding pipeline stalls,\n  so CoreMark cycles should remain constant while reduced area and routing improve\n  median FPGA Fmax.\nexpected_impact:\n  fitness_delta_pct: 4\n  confidence: medium\nchanges:\n  - file: rtl/alu.sv\n    description: \"Replace the three parallel products with one unsigned 32x32 product and correction-subtractor logic for MULH and MULHSU, preserving all RV32M edge semantics and the ALTOPS branch.\"\n  - file: test/test_alu.py\n    description: \"Add focused sign-boundary and randomized multiply-high vectors that verify the shared-product correction formulas for MUL, MULH, MULHU, and MULHSU.\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' cores/v1/rtl/div_unit.sv && sed -n '1,290p' cores/v1/rtl/ex_stage.sv && sed -n '1,180p' cores/v1/rtl/hazard_unit.sv && sed -n '1,100p' cores/v1/core.yaml && if [ -f cores/v1/LESSONS.md ]; then sed -n '1,220p' cores/v1/LESSONS.md; fi && rg -n 'iterative|divider|div_unit|multi-cycle' cores/v1/experiments/log.jsonl | tail -40\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' cores/v1/rtl/div_unit.sv && sed -n '1,290p' cores/v1/rtl/ex_stage.sv && sed -n '1,180p' cores/v1/rtl/hazard_unit.sv && sed -n '1,100p' cores/v1/core.yaml && if [ -f cores/v1/LESSONS.md ]; then sed -n '1,220p' cores/v1/LESSONS.md; fi && rg -n 'iterative|divider|div_unit|multi-cycle' cores/v1/experiments/log.jsonl | tail -40\"","aggregated_output":"// rtl/div_unit.sv\n//\n// Iterative RV32M divider/remainder unit. The EX stage starts it only for\n// DIV/DIVU/REM/REMU and bubbles EX/MEM until done, keeping the cold divider\n// off the one-cycle ALU result path.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n\n  localparam logic [1:0] ST_IDLE = 2'd0;\n  localparam logic [1:0] ST_BUSY = 2'd1;\n  localparam logic [1:0] ST_DONE = 2'd2;\n\n  logic [1:0]  state_q;\n  logic [31:0] result_q;\n\n  assign busy   = (state_q == ST_BUSY);\n  assign done   = (state_q == ST_DONE);\n  assign result = result_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result;\n\n  always_comb begin\n    case (op)\n      ALU_DIV:  alt_result = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU: alt_result = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:  alt_result = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU: alt_result = (a - b) ^ 32'h3138d0e1;\n      default:  alt_result = 32'b0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q  <= ST_IDLE;\n      result_q <= 32'b0;\n    end else begin\n      case (state_q)\n        ST_IDLE: begin\n          if (start) begin\n            result_q <= alt_result;\n            state_q  <= ST_BUSY;\n          end\n        end\n        ST_BUSY: state_q <= ST_DONE;\n        ST_DONE: state_q <= ST_IDLE;\n        default: state_q <= ST_IDLE;\n      endcase\n    end\n  end\n`else\n  logic [31:0] dividend_q;\n  logic [31:0] divisor_q;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] quotient_q;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] remainder_q;\n  logic [5:0]  count_q;\n  logic        quot_neg_q;\n  logic        rem_neg_q;\n  logic        want_rem_q;\n\n  logic        signed_op;\n  logic        want_rem;\n  logic        a_neg;\n  logic        b_neg;\n  logic [31:0] abs_a;\n  logic [31:0] abs_b;\n  logic        divide_by_zero;\n  logic        signed_overflow;\n  logic [31:0] special_result;\n\n  logic [32:0] trial_remainder;\n  logic [32:0] trial_divisor;\n  logic        trial_take;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [32:0] remainder_step;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] quotient_step;\n  logic [31:0] unsigned_remainder;\n  logic [31:0] signed_quotient;\n  logic [31:0] signed_remainder;\n  logic [31:0] final_result;\n\n  always_comb begin\n    signed_op       = (op == ALU_DIV) || (op == ALU_REM);\n    want_rem        = (op == ALU_REM) || (op == ALU_REMU);\n    a_neg           = signed_op && a[31];\n    b_neg           = signed_op && b[31];\n    abs_a           = a_neg ? (~a + 32'd1) : a;\n    abs_b           = b_neg ? (~b + 32'd1) : b;\n    divide_by_zero  = (b == 32'b0);\n    signed_overflow = signed_op && (a == 32'h80000000) && (b == 32'hFFFFFFFF);\n\n    if (divide_by_zero)\n      special_result = want_rem ? a : 32'hFFFFFFFF;\n    else if (signed_overflow)\n      special_result = want_rem ? 32'b0 : 32'h80000000;\n    else\n      special_result = 32'b0;\n\n    trial_remainder   = {remainder_q, dividend_q[31]};\n    trial_divisor     = {1'b0, divisor_q};\n    trial_take        = (trial_remainder >= trial_divisor);\n    remainder_step    = trial_take ? (trial_remainder - trial_divisor)\n                                   : trial_remainder;\n    quotient_step     = {quotient_q[30:0], trial_take};\n    unsigned_remainder = remainder_step[31:0];\n    signed_quotient   = quot_neg_q ? (~quotient_step + 32'd1)\n                                   : quotient_step;\n    signed_remainder  = rem_neg_q ? (~unsigned_remainder + 32'd1)\n                                  : unsigned_remainder;\n    final_result      = want_rem_q ? signed_remainder : signed_quotient;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q     <= ST_IDLE;\n      result_q    <= 32'b0;\n      dividend_q  <= 32'b0;\n      divisor_q   <= 32'b0;\n      quotient_q  <= 32'b0;\n      remainder_q <= 32'b0;\n      count_q     <= 6'b0;\n      quot_neg_q  <= 1'b0;\n      rem_neg_q   <= 1'b0;\n      want_rem_q  <= 1'b0;\n    end else begin\n      case (state_q)\n        ST_IDLE: begin\n          if (start) begin\n            quotient_q  <= 32'b0;\n            remainder_q <= 32'b0;\n            want_rem_q  <= want_rem;\n            quot_neg_q  <= signed_op && (a[31] ^ b[31]);\n            rem_neg_q   <= signed_op && a[31];\n            if (divide_by_zero || signed_overflow) begin\n              result_q   <= special_result;\n              dividend_q <= 32'b0;\n              divisor_q  <= 32'b0;\n              count_q    <= 6'b0;\n            end else begin\n              dividend_q <= abs_a;\n              divisor_q  <= abs_b;\n              count_q    <= 6'd32;\n            end\n            state_q <= ST_BUSY;\n          end\n        end\n\n        ST_BUSY: begin\n          if (count_q == 6'b0) begin\n            state_q <= ST_DONE;\n          end else begin\n            dividend_q  <= {dividend_q[30:0], 1'b0};\n            quotient_q  <= quotient_step;\n            remainder_q <= remainder_step[31:0];\n            count_q     <= count_q - 6'd1;\n            if (count_q == 6'd1) begin\n              result_q <= final_result;\n              state_q  <= ST_DONE;\n            end\n          end\n        end\n\n        ST_DONE: state_q <= ST_IDLE;\n        default: state_q <= ST_IDLE;\n      endcase\n    end\n  end\n`endif\n\nendmodule\n// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, and redirects only when the\n// IF-stage prediction disagrees with the resolved next PC. Owns the EX/MEM\n// pipeline register.\n//\n// Forwarding select encoding (driven by forward_unit):\n//   00 = ID/EX register value (no forward)\n//   01 = EX/MEM aluResult (instruction immediately ahead in MEM)\n//   10 = MEM/WB result (instruction two ahead, post regfile-write mux)\n//\n// Latency:        1 cycle (EX/MEM register clocked here).\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  output ex_mem_t  out,\n  output logic               ex_long_busy,\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  alu u_alu (\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );\n\n  // ── Cold divide/remainder unit ────────────────────────────────────────\n  logic is_div_op;\n  logic div_request;\n  logic div_start;\n  logic div_busy;\n  logic div_done;\n  logic [31:0] div_result_w;\n  logic        div_active_q;\n  logic        div_result_valid_q;\n  logic [31:0] div_result_q;\n  /* verilator lint_off UNUSEDSIGNAL */\n  id_ex_t      div_in_q;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] div_rs1_q;\n  logic [31:0] div_rs2_q;\n  logic        div_complete;\n  logic [31:0] div_result_selected;\n\n  always_comb begin\n    is_div_op   = (in.ctrl.alu_op == ALU_DIV)\n               || (in.ctrl.alu_op == ALU_DIVU)\n               || (in.ctrl.alu_op == ALU_REM)\n               || (in.ctrl.alu_op == ALU_REMU);\n    div_request = in.valid && is_div_op && !in.ctrl.is_illegal && !div_active_q;\n    div_start   = div_request && !stall;\n    div_complete = div_active_q && (div_result_valid_q || div_done);\n    div_result_selected = div_result_valid_q ? div_result_q : div_result_w;\n    // Asserted on the launch cycle and every busy cycle. It deasserts on the\n    // completion cycle so IF/ID can advance while the completed DIV enters\n    // EX/MEM.\n    ex_long_busy = div_start || div_busy || (div_active_q && !div_complete);\n  end\n\n  div_unit u_div (\n    .clock  (clock),\n    .reset  (reset),\n    .start  (div_start),\n    .op     (in.ctrl.alu_op),\n    .a      (alu_a),\n    .b      (alu_b),\n    .busy   (div_busy),\n    .done   (div_done),\n    .result (div_result_w)\n  );\n\n  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] branch_next_pc;\n  logic [31:0] predicted_next_pc;\n  logic [31:0] jump_target;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 != rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'b0;\n    endcase\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    branch_next_pc = branch_taken ? branch_target : (in.pc + 32'd4);\n    predicted_next_pc = in.predicted_taken ? in.predicted_target\n                                           : (in.pc + 32'd4);\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    jalr_sum    = rs1 + in.imm;\n    jump_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0}\n                                  : (in.pc + in.imm);\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  logic branch_mispredict;\n  logic jump_redirect;\n  logic jal_mispredict;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n\n    branch_mispredict = in.valid\n                     && in.ctrl.is_branch\n                     && !misalign_fault\n                     && (branch_next_pc != predicted_next_pc);\n    jal_mispredict    = in.ctrl.is_jump\n                     && !in.ctrl.is_jalr\n                     && (jump_target != predicted_next_pc);\n    jump_redirect     = in.valid\n                     && in.ctrl.is_jump\n                     && !misalign_fault\n                     && (in.ctrl.is_jalr || jal_mispredict);\n  end\n\n  assign redirect        = branch_mispredict || jump_redirect;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_next_pc;\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      div_active_q       <= 1'b0;\n      div_result_valid_q <= 1'b0;\n      div_result_q       <= 32'b0;\n      div_in_q           <= '0;\n      div_rs1_q          <= 32'b0;\n      div_rs2_q          <= 32'b0;\n    end else begin\n      if (div_start) begin\n        div_active_q       <= 1'b1;\n        div_result_valid_q <= 1'b0;\n        div_result_q       <= 32'b0;\n        div_in_q           <= in;\n        div_rs1_q          <= rs1;\n        div_rs2_q          <= rs2;\n      end else if (div_complete && !stall) begin\n        div_active_q       <= 1'b0;\n        div_result_valid_q <= 1'b0;\n      end else if (div_done && div_active_q) begin\n        div_result_q       <= div_result_w;\n        div_result_valid_q <= 1'b1;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (stall) begin\n      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n      // stays in MEM stage waiting on the bus.\n      reg_q <= reg_q;\n    end else if (div_complete) begin\n      reg_q.pc            <= div_in_q.pc;\n      reg_q.alu_result    <= div_result_selected;\n      reg_q.write_data    <= div_rs2_q;\n      reg_q.rd            <= div_in_q.rd;\n      reg_q.rs1_addr      <= div_in_q.rs1_addr;\n      reg_q.rs2_addr      <= div_in_q.rs2_addr;\n      reg_q.rs1_val       <= div_rs1_q;\n      reg_q.rs2_val       <= div_rs2_q;\n      reg_q.pc_next       <= div_in_q.pc + 32'd4;\n      reg_q.branch_taken  <= 1'b0;\n      reg_q.branch_target <= div_in_q.pc + div_in_q.imm;\n      reg_q.ctrl          <= div_in_q.ctrl;\n      reg_q.instr         <= div_in_q.instr;\n      reg_q.valid         <= div_in_q.valid;\n    end else if (div_start || div_active_q) begin\n      // A divide-class instruction occupies EX until completion. EX/MEM gets\n      // bubbles while the unit is busy so older instructions are not replayed.\n      reg_q <= '0;\n    end else begin\n      reg_q.pc            <= in.pc;\n      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n      // sum (which is the jump target). The MEM/WB register's read-data\n      // mux only kicks in for LOADs, so we route PC+4 here.\n      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= rs1;\n      reg_q.rs2_val       <= rs2;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : (in.pc + 32'd4);\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n// rtl/hazard_unit.sv\n//\n// Detects the only data hazard the textbook 5-stage doesn't cover via\n// forwarding: load-use. A LOAD in EX produces its data only after MEM,\n// so an instruction immediately behind that consumes the LOAD's rd\n// must be stalled by exactly one cycle.\n//\n// Outputs:\n//   stall_if / stall_id : freeze the PC reg and the IF/ID combinational\n//                          payload (cleared by ID's flush input).\n//   flush_if / flush_id : on EX redirect (branch mispredict or jump), kill\n//                          the in-flight instructions ahead of the target.\n//   flush_id            : also kills ID's own register on load-use to\n//                          inject a single-cycle bubble between LOAD\n//                          and the dependent instruction.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       redirect,          // EX branch mispredict or jump redirect\n  // Effective fetch availability from IF. It is high for a live imem word\n  // or for a registered replay hit that can stand in for an external stall.\n  input  logic       imem_ready,\n  input  logic       ex_long_busy,      // EX has a multi-cycle op occupying ID/EX\n  // MEM-stage precise wait: live load/nonbufferable store waiting on dmem,\n  // or a younger memory operation blocked behind the pending-store slot.\n  input  logic       mem_wait,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_if,          // IF/ID comb output -> NOP\n  output logic       flush_id,          // ID/EX register captures '0\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic imem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_mem_read\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                   && (id_ex_rd != 5'b0);\n    imem_stall = !imem_ready;\n\n    // PC reg holds on any stall reason.\n    stall_if      = load_use_hazard || imem_stall || mem_wait || ex_long_busy;\n    // IF/ID combinational payload: NOP whenever we wouldn't have a valid\n    // instruction this cycle (mispredict/jump recovery, or imem didn't\n    // deliver).\n    flush_if      = redirect || imem_stall;\n    // ID/EX register:\n    //   - mem_wait    -> hold        (preserve in-flight pipeline state)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // mem_wait takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    stall_id      = mem_wait || load_use_hazard || ex_long_busy;\n    flush_id      = (load_use_hazard || redirect) && !mem_wait;\n    // EX/MEM register: holds on mem_wait (LOAD waits in MEM until the bus\n    // delivers, or a younger memory op waits behind the store slot).\n    stall_ex_mem  = mem_wait;\n    // MEM/WB register: on mem_wait the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = mem_wait;\n  end\n\nendmodule\n# cores/v1/core.yaml\nname: v1\ndescription: Current evolved RV32IM core (5-stage in-order with M-ext, store-slot, hazard/forward, banked I-fetch replay predictor).\nisa: rv32im\ntarget_fpga: tang-nano-20k\n\ntargets:\n  fmax_mhz: 90\n  lut4: 3000\n  coremark_iter_s: 400\n  coremark_per_mhz: 4.5\n\ncurrent:\n  fmax_mhz: 198.69\n  lut4: 5944\n  ff: 2235\n  coremark_iter_s: 577.76\n  coremark_per_mhz: 2.9078\n  source_id: hyp-20260428-054-r20s2\n  updated: 2026-04-28T08:24:46Z\n26:{\"id\": \"hyp-20260428-019-r9s0\", \"title\": \"Hot-Cold ALU Opcode Split\", \"category\": \"micro_opt\", \"motivation\": \"The current best design already moved DIV/REM out of the universal EX\\ndatapath and added the one-deep store slot, so the remaining micro-optimum\\nis likely in the hot single-cycle EX logic rather than in another stall\\nhiding structure. `rtl/alu.sv` still selects every RV32I operation and all\\nmultiply-class results through one dense ALU opcode case. Even though\\nDIV/REM now return dummy zero in the ALU, the common ADD/address/compare/\\nshift path still shares decode and mux structure with the cold M-extension\\nresult cases.\\n\\nA previous \\\"hot-bit ALU\\\" attempt was never architecturally evaluated because\\nthe implementation touched an off-limits non-RTL helper file. The idea\\nremains attractive after the divider win: leave every arithmetic primitive\\nand all pipeline control unchanged, but make the opcode encoding expose a\\nsimple hot/cold split that synthesis can map into a shallower mux for the\\ncommon RV32I path. This targets median Fmax with no CoreMark cycle-count\\nrisk and avoids the multiplier-primitive rewrites that previously regressed\\nbadly.\\n\", \"hypothesis\": {\"motivation\": \"The current best design already moved DIV/REM out of the universal EX\\ndatapath and added the one-deep store slot, so the remaining micro-optimum\\nis likely in the hot single-cycle EX logic rather than in another stall\\nhiding structure. `rtl/alu.sv` still selects every RV32I operation and all\\nmultiply-class results through one dense ALU opcode case. Even though\\nDIV/REM now return dummy zero in the ALU, the common ADD/address/compare/\\nshift path still shares decode and mux structure with the cold M-extension\\nresult cases.\\n\\nA previous \\\"hot-bit ALU\\\" attempt was never architecturally evaluated because\\nthe implementation touched an off-limits non-RTL helper file. The idea\\nremains attractive after the divider win: leave every arithmetic primitive\\nand all pipeline control unchanged, but make the opcode encoding expose a\\nsimple hot/cold split that synthesis can map into a shallower mux for the\\ncommon RV32I path. This targets median Fmax with no CoreMark cycle-count\\nrisk and avoids the multiplier-primitive rewrites that previously regressed\\nbadly.\\n\", \"hypothesis\": \"Re-encode the ALU operation constants so `alu_op[4]` is a registered\\nM-extension discriminator: all RV32I/simple operations keep `op[4]=0`, while\\n`MUL`, `MULH`, `MULHSU`, `MULHU`, `DIV`, `DIVU`, `REM`, and `REMU` use\\n`op[4]=1` with the low bits matching the RV32M funct3 order. Then refactor\\n`rtl/alu.sv` into two local result muxes: a hot simple mux for ADD/SUB,\\nlogic, compare, shift, and LUI, and a cold M mux for the existing multiply\\noutputs plus the existing dummy zero result for DIV/REM opcodes handled by\\n`div_unit.sv`.\\n\\nThe final ALU result becomes `op[4] ? m_out : simple_out`. No multiplier,\\ndivider, forwarding, stall, branch predictor, memory, RVFI, or top-level IO\\nbehavior changes. The `RISCV_FORMAL_ALTOPS` multiply substitutions remain in\\nthe cold M mux under the new constants, and the divide/remainder ALTOPS\\nformulas stay in `div_unit.sv`. The expected gain is a modest Fmax\\nimprovement from reducing decode/mux depth on the hot EX ALU path while\\npreserving the current CoreMark instruction count and exact RV32IM results.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Reassign the ALU_MUL through ALU_REMU constants to an `op[4]=1`\\nencoding, preferably `5'b10000` through `5'b10111` in RV32M funct3\\norder. Keep ADD/SUB/logic/compare/shift/LUI at `op[4]=0`. Do not\\nchange bundle widths, RVFI fields, architectural state, decoder legality\\ndefaults, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/alu.sv\", \"description\": \"Split the broad ALU result case into `simple_out` and `m_out` sub-muxes.\\n`simple_out` should cover the RV32I hot path only. `m_out` should reuse\\nthe existing MUL/MULH/MULHU/MULHSU arithmetic and ALTOPS formulas, while\\nDIV/DIVU/REM/REMU continue to return zero because the iterative divider\\nsupplies their real result. Select the final output only with `op[4]`.\\n\"}, {\"file\": \"rtl/decoder.sv\", \"description\": \"Keep the decoded operation semantics identical while emitting the new\\nALU constants for RV32M instructions. The decoder's illegal-default\\ndiscipline and validated opcode/funct matching must remain unchanged.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Update any divide-class or M-extension equality checks to the new ALU\\nconstants without changing the existing long-operation interlock, DIV\\nlaunch/completion behavior, forwarding muxes, redirect handling, or\\nRVFI metadata propagation.\\n\"}, {\"file\": \"rtl/div_unit.sv\", \"description\": \"Update opcode comparisons and ALTOPS divide/remainder case labels to the\\nnew ALU constants only. Preserve the iterative divider protocol, real\\nRV32M corner-case behavior, and short formal ALTOPS latency.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Reassign the ALU_MUL through ALU_REMU constants to an `op[4]=1`\\nencoding, preferably `5'b10000` through `5'b10111` in RV32M funct3\\norder. Keep ADD/SUB/logic/compare/shift/LUI at `op[4]=0`. Do not\\nchange bundle widths, RVFI fields, architectural state, decoder legality\\ndefaults, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/alu.sv\", \"description\": \"Split the broad ALU result case into `simple_out` and `m_out` sub-muxes.\\n`simple_out` should cover the RV32I hot path only. `m_out` should reuse\\nthe existing MUL/MULH/MULHU/MULHSU arithmetic and ALTOPS formulas, while\\nDIV/DIVU/REM/REMU continue to return zero because the iterative divider\\nsupplies their real result. Select the final output only with `op[4]`.\\n\"}, {\"file\": \"rtl/decoder.sv\", \"description\": \"Keep the decoded operation semantics identical while emitting the new\\nALU constants for RV32M instructions. The decoder's illegal-default\\ndiscipline and validated opcode/funct matching must remain unchanged.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Update any divide-class or M-extension equality checks to the new ALU\\nconstants without changing the existing long-operation interlock, DIV\\nlaunch/completion behavior, forwarding muxes, redirect handling, or\\nRVFI metadata propagation.\\n\"}, {\"file\": \"rtl/div_unit.sv\", \"description\": \"Update opcode comparisons and ALTOPS divide/remainder case labels to the\\nnew ALU constants only. Preserve the iterative divider protocol, real\\nRV32M corner-case behavior, and short formal ALTOPS latency.\\n\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"sandbox_violation: agent touched off-limits paths: ['test/_helpers.py']\", \"slot\": 0, \"round_id\": 9}\n27:{\"id\": \"hyp-20260428-020-r9s1\", \"title\": \"Store-Slot-Aware Fetch Skid Queue\", \"category\": \"structural\", \"motivation\": \"The current best design combines the two changes that have paid off most:\\ncold DIV/REM is off the universal EX path, and a one-deep pending-store slot\\nlets a stalled normal-RAM store retire while the physical dmem write drains\\nlater. That store slot reduced CoreMark cycles, but the frontend is still\\nstructurally brittle under the tournament's random imem stalls: `if_stage`\\npresents live imem data directly to decode, and `hazard_unit` still turns\\nraw `io_imemReady=0` into a global pipeline stall.\\n\\nA previous generic elastic fetch buffer regressed because it added permanent\\nfrontend queue/arbitration cost before the divider and store-slot timing\\nwins, and it tried to prefetch through all backend stalls. The better\\nstructural angle now is narrower: use a tiny fetch skid queue only to absorb\\ninstruction-memory backpressure and to keep fetch productive while the new\\nstore slot is draining for older stores. This targets the measured\\nstore-slot cycle win's remaining companion bottleneck without touching the\\nhot EX operand path, load data forwarding, branch predictor state, or RVFI\\nretirement width.\\n\", \"hypothesis\": {\"motivation\": \"The current best design combines the two changes that have paid off most:\\ncold DIV/REM is off the universal EX path, and a one-deep pending-store slot\\nlets a stalled normal-RAM store retire while the physical dmem write drains\\nlater. That store slot reduced CoreMark cycles, but the frontend is still\\nstructurally brittle under the tournament's random imem stalls: `if_stage`\\npresents live imem data directly to decode, and `hazard_unit` still turns\\nraw `io_imemReady=0` into a global pipeline stall.\\n\\nA previous generic elastic fetch buffer regressed because it added permanent\\nfrontend queue/arbitration cost before the divider and store-slot timing\\nwins, and it tried to prefetch through all backend stalls. The better\\nstructural angle now is narrower: use a tiny fetch skid queue only to absorb\\ninstruction-memory backpressure and to keep fetch productive while the new\\nstore slot is draining for older stores. This targets the measured\\nstore-slot cycle win's remaining companion bottleneck without touching the\\nhot EX operand path, load data forwarding, branch predictor state, or RVFI\\nretirement width.\\n\", \"hypothesis\": \"Add a two-entry instruction fetch skid queue between IF and ID with a direct\\nempty-queue bypass for the zero-wait no-stall path. The fetch side captures\\n`{pc, instr, predicted_taken, predicted_target}` whenever `io_imemReady` is\\nhigh and the queue has space. The decode side consumes exactly one entry\\nwhen ID is not stalled. When the queue is empty and both imem and decode are\\nready, keep the current combinational bypass so the normal predicted\\nbranch/JAL path does not gain an extra stage.\\n\\nUnlike the earlier broad elastic-fetch experiment, restrict decoupling to\\nfrontend availability and the existing pending-store drain case. Load-use\\ninterlocks, live loads waiting on dmem, nonbufferable/MMIO stores, divide\\nlong operations, and EX redirects still hold or flush the frontend exactly\\nas today. While a normal-RAM store has already retired into the pending\\nstore slot and the slot is draining, allow IF to fill the skid queue and\\nallow younger non-memory work to consume from it; younger memory operations\\nstill wait behind the slot in MEM, preserving memory order and marker\\nsemantics.\\n\\nRedirects flush all queued entries and restart fetch at the resolved target.\\nThe existing backward-branch and direct-JAL prediction metadata is stored\\nper queue entry and is still checked in EX through the resolved-next-PC\\nmismatch path. The expected benefit is lower random-iStall exposure and\\nbetter overlap between store-slot drains and instruction fetch, with only a\\nsmall FF/LUT cost and no new load-data-to-EX or learned-predictor timing\\npath.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a two-entry valid/ready fetch skid queue holding the existing IF/ID\\nmetadata. Preserve an empty-queue direct bypass from `io_imemData` to\\ndecode when imem and ID are both ready. Push fetched entries only when\\n`io_imemReady` is high and the queue is not full; pop only when decode\\naccepts an instruction. Flush queued entries on reset or EX redirect,\\nand keep the existing static backward-branch plus direct-JAL prediction\\nlogic on the fetch side.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Stop using raw `io_imemReady` as a global pipeline stall. Instead,\\naccept a frontend-empty/no-instruction-available indication from IF and\\nonly bubble ID when the queue cannot provide an instruction. Keep the\\nexisting load-use, divide-long-operation, redirect, and MEM wait\\nbehavior intact, including stalls for live loads, nonbufferable stores,\\nand younger memory operations blocked behind the pending store slot.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the fetch queue ready/valid controls between IF, ID, and the hazard\\nunit. Preserve the current pending-store slot arbitration, the top-level\\ncore IO shape, single-retire RVFI channel-0 behavior, strict\\n`rvfi_order` increments, and tied-off channel 1.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add or clarify only small IF/ID metadata comments or typedef fields\\nneeded for the queued fetch entries. Do not change RVFI field widths,\\narchitectural state, decoder legality defaults, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a two-entry valid/ready fetch skid queue holding the existing IF/ID\\nmetadata. Preserve an empty-queue direct bypass from `io_imemData` to\\ndecode when imem and ID are both ready. Push fetched entries only when\\n`io_imemReady` is high and the queue is not full; pop only when decode\\naccepts an instruction. Flush queued entries on reset or EX redirect,\\nand keep the existing static backward-branch plus direct-JAL prediction\\nlogic on the fetch side.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Stop using raw `io_imemReady` as a global pipeline stall. Instead,\\naccept a frontend-empty/no-instruction-available indication from IF and\\nonly bubble ID when the queue cannot provide an instruction. Keep the\\nexisting load-use, divide-long-operation, redirect, and MEM wait\\nbehavior intact, including stalls for live loads, nonbufferable stores,\\nand younger memory operations blocked behind the pending store slot.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the fetch queue ready/valid controls between IF, ID, and the hazard\\nunit. Preserve the current pending-store slot arbitration, the top-level\\ncore IO shape, single-retire RVFI channel-0 behavior, strict\\n`rvfi_order` increments, and tied-off channel 1.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add or clarify only small IF/ID metadata comments or typedef fields\\nneeded for the queued fetch entries. Do not change RVFI field widths,\\narchitectural state, decoder legality defaults, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 166.23, \"delta_pct\": -58.19, \"vs_baseline\": -44.78, \"fmax_mhz\": 70.25, \"ipc_coremark\": 2e-06, \"cycles\": 4226169, \"iterations\": 10, \"lut4\": 6199, \"ff\": 2417, \"seeds\": [70.25, 72.47, 68.64], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Added a two-entry fetch skid queue inside `rtl/if_stage.sv` for `{pc, instr, predicted_taken, predicted_target, valid}`.\\n- Preserved the empty-queue direct bypass from live `io_imemData` to decode when `io_imemReady` is high.\\n- Fetch now advances the PC only when a live imem word is captured by the bypass or queue; when imem is stalled and the queue is empty, IF emits an invalid NOP bubble.\\n- Redirect/reset/flush discard queued entries and restart fetch from the resolved redirect target.\\n- `rtl/hazard_unit.sv` no longer consumes raw `io_imemReady`; it uses `if_id_w.valid` to gate load-use detection and leaves imem unavailability to the IF queue valid path.\\n- `rtl/core.sv` wires `io_imemReady` into IF, wires decode readiness for queue pop, and wires `if_id_w.valid` into the hazard unit.\\n- `rtl/core_pkg.sv` comments now describe the IF/ID bundle as either bypassed or queued metadata.\\n\\n## Deviations\\n\\n- I did not add a new typedef for the fetch queue entry. The existing `if_id_t` already contains exactly the required metadata, including `valid`.\\n- I kept backend hold behavior conservative: load-use, long divide, and MEM waits still hold the fetch side instead of prefetching through those hazards. Store-slot drain only remains decoupled when it does not assert `mem_wait`, matching the existing pending-store ordering rule.\\n\\n## Concerns\\n\\n- The queue adds a small amount of IF-side control logic around the PC update path. The zero-wait empty-queue path still bypasses the queue storage, but synthesis/P&R will decide whether the added space/valid logic affects Fmax.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `pytest -q test/test_pipeline.py`: pass.\\n- Exact `bash formal/run_all.sh` from this worktree: blocked by sandbox permissions because `formal/riscv-formal` is a symlink to `/Users/bonetto/bonetto/auto-arch-tournament/formal/riscv-formal`, and the script stages files by deleting/writing inside that external tree.\\n- Equivalent formal run from a writable `/tmp` copy using the same RTL, wrapper, `checks.cfg`, and riscv-formal tree: pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T05:16:20.957349\", \"slot\": 1, \"round_id\": 9}\n29:{\"id\": \"hyp-20260428-022-r10s0\", \"title\": \"Collapse Redundant EX/MEM Metadata\", \"category\": \"micro_opt\", \"motivation\": \"The current best RTL already captured the large available wins: cold\\nDIV/REM is out of the one-cycle ALU path, and the pending store slot reduces\\nrandom dmem-stall exposure. The remaining micro-opt slot should therefore\\navoid new predictors, queues, or arithmetic units and instead trim logic that\\nis already proven unnecessary on the hot pipeline boundary.\\n\\nThe EX/MEM bundle still carries several fields that do not add architectural\\ninformation. `write_data` is always assigned the same post-forwarded rs2\\nvalue as `rs2_val`, while `branch_taken` and `branch_target` are registered\\nbut never consumed by MEM, WB, RVFI, forwarding, or hazard logic. Those bits\\nadd about 65 EX/MEM flops plus mux/load on the EX branch-target and rs2 data\\npaths, exactly where the post-DIV design is trying to preserve Fmax. Pruning\\nthis redundant metadata should not change CoreMark cycles, bus behavior,\\nbranch prediction, RVFI ordering, or any ISA-visible result.\\n\", \"hypothesis\": {\"motivation\": \"The current best RTL already captured the large available wins: cold\\nDIV/REM is out of the one-cycle ALU path, and the pending store slot reduces\\nrandom dmem-stall exposure. The remaining micro-opt slot should therefore\\navoid new predictors, queues, or arithmetic units and instead trim logic that\\nis already proven unnecessary on the hot pipeline boundary.\\n\\nThe EX/MEM bundle still carries several fields that do not add architectural\\ninformation. `write_data` is always assigned the same post-forwarded rs2\\nvalue as `rs2_val`, while `branch_taken` and `branch_target` are registered\\nbut never consumed by MEM, WB, RVFI, forwarding, or hazard logic. Those bits\\nadd about 65 EX/MEM flops plus mux/load on the EX branch-target and rs2 data\\npaths, exactly where the post-DIV design is trying to preserve Fmax. Pruning\\nthis redundant metadata should not change CoreMark cycles, bus behavior,\\nbranch prediction, RVFI ordering, or any ISA-visible result.\\n\", \"hypothesis\": \"Remove redundant EX/MEM payload fields and reuse the already-carried RVFI\\noperand value for store data. Specifically, delete `write_data`,\\n`branch_taken`, and `branch_target` from `ex_mem_t`. In EX, stop assigning\\nthose dead registers; keep the local branch_taken and branch_target signals\\nfor redirect, misalignment checks, and pc_next generation. In MEM, form store\\nwrite data from `in.rs2_val`, which is the same post-forwarded rs2 value that\\n`write_data` carried before.\\n\\nThis is intended as a pure synthesis and placement micro-optimization:\\nfewer EX/MEM register bits, less fanout from the branch target adder and rs2\\nforwarding mux, and no new combinational datapath. The top-level core IO,\\nNRET=2 RVFI fields, channel-0-only retirement convention, decoder legality\\ndiscipline, iterative divider protocol, pending-store slot semantics, and\\nCoreMark instruction stream all remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Remove `write_data`, `branch_taken`, and `branch_target` from `ex_mem_t`\\nand update the bundle comments to state that `rs2_val` is both the\\nRVFI-visible rs2 operand and the raw store-data source before byte-lane\\nreplication. Do not change any RVFI fields, top-level ports, ALU opcode\\nconstants, or decoder legality definitions.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Stop driving the removed EX/MEM fields in the normal, divide-complete,\\nand bubble paths. Keep the existing local `branch_taken` and\\n`branch_target` calculations for redirect decisions, misaligned target\\ntraps, and `pc_next`; only the unused registered copies are removed.\\nPreserve the divider interlock, forwarding muxes, JAL/JALR rd data, and\\nRVFI operand metadata.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Replace uses of `in.write_data` with `in.rs2_val` when building\\nreplicated store write data and RVFI `mem_wdata`. This should be\\nbit-identical because EX already records the post-forwarded rs2 operand\\nin `rs2_val`. Preserve all existing misalignment traps, dmem request\\ngating, pending-store enqueue behavior, load extraction, and MEM/WB\\nretirement fields.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Remove `write_data`, `branch_taken`, and `branch_target` from `ex_mem_t`\\nand update the bundle comments to state that `rs2_val` is both the\\nRVFI-visible rs2 operand and the raw store-data source before byte-lane\\nreplication. Do not change any RVFI fields, top-level ports, ALU opcode\\nconstants, or decoder legality definitions.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Stop driving the removed EX/MEM fields in the normal, divide-complete,\\nand bubble paths. Keep the existing local `branch_taken` and\\n`branch_target` calculations for redirect decisions, misaligned target\\ntraps, and `pc_next`; only the unused registered copies are removed.\\nPreserve the divider interlock, forwarding muxes, JAL/JALR rd data, and\\nRVFI operand metadata.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Replace uses of `in.write_data` with `in.rs2_val` when building\\nreplicated store write data and RVFI `mem_wdata`. This should be\\nbit-identical because EX already records the post-forwarded rs2 operand\\nin `rs2_val`. Preserve all existing misalignment traps, dmem request\\ngating, pending-store enqueue behavior, load extraction, and MEM/WB\\nretirement fields.\\n\"}], \"outcome\": \"regression\", \"fitness\": 386.64, \"delta_pct\": -2.74, \"vs_baseline\": 28.43, \"fmax_mhz\": 163.4, \"ipc_coremark\": 2e-06, \"cycles\": 4226169, \"iterations\": 10, \"lut4\": 5925, \"ff\": 2230, \"seeds\": [163.4, 167.45, 157.68], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes made\\n\\n- Removed `write_data`, `branch_taken`, and `branch_target` from `ex_mem_t` in `rtl/core_pkg.sv`.\\n- Updated the `ex_mem_t.rs2_val` comment to document that it is both the RVFI-visible post-forwarded rs2 operand and the raw store-data source before byte-lane replication.\\n- Removed all EX-stage assignments to the deleted EX/MEM fields in `rtl/ex_stage.sv`, including normal issue and divide-complete paths.\\n- Updated `rtl/mem_stage.sv` store-data replication and RVFI `mem_wdata` source to use `in.rs2_val` instead of `in.write_data`.\\n\\n## Deviations\\n\\n- No architectural deviations from the hypothesis. Local EX-stage `branch_taken` and `branch_target` signals remain for redirect, misalignment, and `pc_next` generation.\\n\\n## Concerns\\n\\n- No functional concerns found. Store write data remains bit-identical because EX already records the post-forwarded rs2 value in `rs2_val`.\\n- Directly running `bash formal/run_all.sh` in this sandbox failed before formal checks because `formal/riscv-formal` is a symlink to a shared tree outside the writable roots, so the script could not refresh `formal/riscv-formal/cores/auto-arch-researcher/*.sv`.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: pass when run from `/tmp/auto-arch-formal-r10s0`, a writable temporary copy containing the unchanged formal harness, copied current `rtl/`, and a writable copy of `formal/riscv-formal`. Result: `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T05:30:55.809018\", \"slot\": 0, \"round_id\": 10}\n32:{\"id\": \"hyp-20260428-025-r11s0\", \"title\": \"Segmented RVFI Order Counter\", \"category\": \"micro_opt\", \"motivation\": \"The current best design has already captured the large architectural wins:\\nDIV/REM is off the one-cycle EX path, and the one-deep store slot reduces\\nrandom dmem-stall exposure. Recent micro-opt attempts that reshaped hot\\ndatapaths, predictor target logic, or EX/MEM metadata mostly lost Fmax to\\nplacement noise or new muxing. The next micro-opt should therefore target a\\nguaranteed always-present timing structure without changing IPC.\\n\\nThe top-level RVFI order counter is currently a single 64-bit increment:\\n`rvfi_order_q <= rvfi_order_q + 64'b1` on every retirement. The FPGA\\nbenchmark wrapper intentionally retains RVFI fanout by XOR-reducing the RVFI\\noutputs into an LED, so this counter cannot be assumed dead in synthesis.\\nA 64-bit carry self-loop is not architectural work for the CoreMark datapath,\\nbut it can still consume carry-chain/routing budget and compete with the hot\\npipeline for median Fmax.\\n\", \"hypothesis\": {\"motivation\": \"The current best design has already captured the large architectural wins:\\nDIV/REM is off the one-cycle EX path, and the one-deep store slot reduces\\nrandom dmem-stall exposure. Recent micro-opt attempts that reshaped hot\\ndatapaths, predictor target logic, or EX/MEM metadata mostly lost Fmax to\\nplacement noise or new muxing. The next micro-opt should therefore target a\\nguaranteed always-present timing structure without changing IPC.\\n\\nThe top-level RVFI order counter is currently a single 64-bit increment:\\n`rvfi_order_q <= rvfi_order_q + 64'b1` on every retirement. The FPGA\\nbenchmark wrapper intentionally retains RVFI fanout by XOR-reducing the RVFI\\noutputs into an LED, so this counter cannot be assumed dead in synthesis.\\nA 64-bit carry self-loop is not architectural work for the CoreMark datapath,\\nbut it can still consume carry-chain/routing budget and compete with the hot\\npipeline for median Fmax.\\n\", \"hypothesis\": \"Replace the monolithic 64-bit RVFI order increment in `rtl/core.sv` with a\\nsegmented exact counter, for example four 16-bit chunks. The low chunk\\nincrements on every `mem_wb_w.valid` retirement. Each higher chunk increments\\nonly when all lower chunks overflow in the same retirement cycle. The\\nconcatenated `{hi, mid_hi, mid_lo, lo}` value still drives\\n`io_rvfi_order_0`, resets to zero, and advances by exactly one for every\\nsingle channel-0 retirement.\\n\\nThis preserves CLAUDE.md invariant 4 bit-for-bit: no gaps, no duplicates,\\nand the visible 64-bit RVFI order sequence is identical to the current\\nimplementation for every possible run length. It also leaves the top-level\\nIO, channel-1 tie-off, retirement point, pipeline control, memory behavior,\\nbranch prediction, divider protocol, and CoreMark cycle count unchanged. The\\nexpected gain is a modest median Fmax improvement by replacing one 64-bit\\ncarry feedback path with shorter chunk-local adders plus narrow overflow\\nenables.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core.sv\", \"description\": \"Replace the single `logic [63:0] rvfi_order_q` plus 64-bit `+ 1`\\nupdate with segmented order-counter registers. Increment the low\\nsegment on retirement and conditionally increment upper segments on\\nlower-segment overflow. Drive `io_rvfi_order_0` from the concatenated\\nsegments exactly as before, keep reset-to-zero semantics, and do not\\nchange any RVFI field names, widths, channel ordering, channel-1 tie-off,\\nor MEM/WB retirement logic.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core.sv\", \"description\": \"Replace the single `logic [63:0] rvfi_order_q` plus 64-bit `+ 1`\\nupdate with segmented order-counter registers. Increment the low\\nsegment on retirement and conditionally increment upper segments on\\nlower-segment overflow. Drive `io_rvfi_order_0` from the concatenated\\nsegments exactly as before, keep reset-to-zero semantics, and do not\\nchange any RVFI field names, widths, channel ordering, channel-1 tie-off,\\nor MEM/WB retirement logic.\\n\"}], \"outcome\": \"improvement\", \"fitness\": 422.77, \"delta_pct\": 6.34, \"vs_baseline\": 40.44, \"fmax_mhz\": 178.67, \"ipc_coremark\": 2e-06, \"cycles\": 4226169, \"iterations\": 10, \"lut4\": 5933, \"ff\": 2228, \"seeds\": [178.67, 188.47, 178.67], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes\\n\\n- Replaced the monolithic `logic [63:0] rvfi_order_q` increment in `rtl/core.sv` with four 16-bit RVFI order counter chunks.\\n- The low chunk increments on every `mem_wb_w.valid` retirement.\\n- Each upper chunk increments only when all lower chunks are `16'hffff` on the same retirement cycle.\\n- `io_rvfi_order_0` is still driven by the concatenated 64-bit value, and reset still clears all chunks to zero.\\n- No top-level IO, channel-1 tie-off, MEM/WB retirement logic, pipeline control, memory behavior, or RVFI field widths/names were changed.\\n\\n## Deviations\\n\\n- No RTL deviations from the hypothesis plan.\\n- Direct `bash formal/run_all.sh` in the worktree could not refresh the staged core directory because `formal/riscv-formal` is a symlink to a protected checkout and the sandbox rejected the script's `rm -f \\\"$CORE_DIR\\\"/*.sv` with `Operation not permitted`.\\n- To run the same gate without touching the protected tree, I created `/tmp/auto_arch_formal_run_87796`, copied the current `rtl/` and formal config files there, symlinked the read-only riscv-formal support directories, and ran `bash formal/run_all.sh` from that writable temporary project.\\n\\n## Concerns\\n\\n- None known. The segmented counter preserves the same visible 64-bit order sequence and only changes the internal update structure.\\n\\n## Local Verification\\n\\n- Lint: `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv` passed.\\n- Formal: `bash formal/run_all.sh` passed from the writable temporary project with `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T05:44:15.153603\", \"slot\": 0, \"round_id\": 11}\n35:{\"id\": \"hyp-20260428-028-r12s0\", \"title\": \"Byte-Segmented RVFI Order Counter\", \"category\": \"micro_opt\", \"motivation\": \"The current best result came from a pure timing micro-optimization: replacing\\nthe monolithic 64-bit RVFI order increment with four 16-bit counter chunks.\\nThat change did not alter CoreMark cycles, memory behavior, branch\\nprediction, divider latency, or retirement semantics, but it raised median\\nFmax enough to become the new best fitness. This strongly suggests the\\nRVFI-order feedback path is still visible to synthesis and placement because\\nthe FPGA wrapper keeps RVFI outputs alive.\\n\\nThe current implementation still has a 16-bit carry-chain self-loop in the\\nlow order chunk, and each retirement toggles that chunk. A narrower exact\\nchunk size is the most direct follow-up in the micro_opt slot: it targets the\\nsame measured timing structure that just paid off, avoids another datapath or\\npredictor rewrite, and should leave CoreMark iterations/cycle unchanged.\\n\", \"hypothesis\": {\"motivation\": \"The current best result came from a pure timing micro-optimization: replacing\\nthe monolithic 64-bit RVFI order increment with four 16-bit counter chunks.\\nThat change did not alter CoreMark cycles, memory behavior, branch\\nprediction, divider latency, or retirement semantics, but it raised median\\nFmax enough to become the new best fitness. This strongly suggests the\\nRVFI-order feedback path is still visible to synthesis and placement because\\nthe FPGA wrapper keeps RVFI outputs alive.\\n\\nThe current implementation still has a 16-bit carry-chain self-loop in the\\nlow order chunk, and each retirement toggles that chunk. A narrower exact\\nchunk size is the most direct follow-up in the micro_opt slot: it targets the\\nsame measured timing structure that just paid off, avoids another datapath or\\npredictor rewrite, and should leave CoreMark iterations/cycle unchanged.\\n\", \"hypothesis\": \"Refine the RVFI order counter in `rtl/core.sv` from four 16-bit chunks to\\neight 8-bit chunks. The lowest byte increments on every `mem_wb_w.valid`\\nretirement. Each higher byte increments only when every lower byte is\\n`8'hff` on that same retirement cycle. Concatenating the bytes still drives\\nthe exact 64-bit `io_rvfi_order_0` value, reset still produces zero, and the\\nvisible sequence still advances by exactly one per channel-0 retirement.\\n\\nThis preserves CLAUDE.md invariant 4 exactly: no skipped order values, no\\nduplicate order values, and no change to the single-retire channel-0 /\\nchannel-1-tied-off RVFI contract. It also leaves the top-level IO, MEM/WB\\nretirement point, store slot, divider interlock, branch predictor, memory\\nhandshake behavior, and CoreMark cycle count unchanged. The expected gain is\\na small additional Fmax improvement by shortening the always-active low-order\\ncounter carry path from 16 bits to 8 bits while keeping the upper-byte carry\\nenables narrow and exact.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core.sv\", \"description\": \"Replace the four 16-bit `rvfi_order_*_q` registers and carry signals\\nwith eight 8-bit order counter registers. Increment byte 0 on each\\nretirement and conditionally increment bytes 1 through 7 only on exact\\nlower-byte overflow. Drive `io_rvfi_order_0` from the concatenated bytes\\nin the same 64-bit order as today, preserve reset-to-zero behavior, and\\ndo not change any RVFI field names, widths, channel ordering, channel-1\\ntie-off, MEM/WB retirement logic, or pipeline control.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core.sv\", \"description\": \"Replace the four 16-bit `rvfi_order_*_q` registers and carry signals\\nwith eight 8-bit order counter registers. Increment byte 0 on each\\nretirement and conditionally increment bytes 1 through 7 only on exact\\nlower-byte overflow. Drive `io_rvfi_order_0` from the concatenated bytes\\nin the same 64-bit order as today, preserve reset-to-zero behavior, and\\ndo not change any RVFI field names, widths, channel ordering, channel-1\\ntie-off, MEM/WB retirement logic, or pipeline control.\\n\"}], \"outcome\": \"regression\", \"fitness\": 373.27, \"delta_pct\": -11.71, \"vs_baseline\": 23.99, \"fmax_mhz\": 157.75, \"ipc_coremark\": 2e-06, \"cycles\": 4226169, \"iterations\": 10, \"lut4\": 5926, \"ff\": 2221, \"seeds\": [163.29, 149.5, 157.75], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Replaced the four 16-bit RVFI order counter registers in `rtl/core.sv`\\n  with eight explicit 8-bit byte registers.\\n- Byte 0 increments on every `mem_wb_w.valid` retirement.\\n- Bytes 1 through 7 increment only when `mem_wb_w.valid` is asserted and\\n  every lower byte is `8'hff` in that same cycle.\\n- `io_rvfi_order_0` is still driven by the concatenated 64-bit counter value,\\n  now ordered `{b7, b6, b5, b4, b3, b2, b1, b0}`.\\n- Reset behavior remains all-zero. No RVFI field names, widths, channel\\n  ordering, channel-1 tie-off, pipeline control, memory, branch, divider, or\\n  writeback logic changed.\\n\\n## Deviations\\n\\n- No functional deviations from the hypothesis. I kept the byte counter logic\\n  inline in `rtl/core.sv` to match the existing segmented-counter style.\\n\\n## Concerns\\n\\n- The direct in-place `bash formal/run_all.sh` command could not stage files in\\n  this sandbox because `formal/riscv-formal` is a symlink to a shared checkout\\n  outside the writable worktree; the script failed before running any proof\\n  checks with `Operation not permitted` while removing staged `.sv` files.\\n- To verify the RTL anyway, I ran the same script from a temporary copy of the\\n  worktree with the `formal/riscv-formal` symlink dereferenced into `/tmp`.\\n\\n## Local verification status\\n\\n- Lint: pass\\n  - `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`\\n- Formal: pass in writable temporary worktree\\n  - `bash formal/run_all.sh`\\n  - Final tally: `Formal: 105 passed, 0 failed`\\n  - No formal counterexample was observed.\\n\", \"timestamp\": \"2026-04-28T06:01:51.815239\", \"slot\": 0, \"round_id\": 12}\n36:{\"id\": \"hyp-20260428-029-r12s1\", \"title\": \"MEM-Stage Load Replay Buffer\", \"category\": \"structural\", \"motivation\": \"The current best core has already captured the two strongest proven wins:\\ncold DIV/REM is off the universal EX path, and the one-deep pending-store\\nslot hides store-only dmem backpressure while preserving the ready-store fast\\npath. The next structural bottleneck is therefore load-side dmem stalls. A\\nload whose word was recently read still freezes the whole pipeline whenever\\n`io_dmemReady` is low, even though CoreMark repeatedly touches a compact 6 KB\\nworking set across list, matrix, state, stack, and CRC code.\\n\\nInstruction replay experiments showed that serving repeated hot accesses\\nduring random bus stalls can cut many cycles, but putting a wide replay table\\nin IF cost too much Fmax. A smaller load replay structure in MEM attacks the\\nsame random-stall problem on the data side, where the lookup is off the\\nbranch/JAL predictor path and does not add load data to the EX operand muxes.\\nThis is a structural stall-hiding change, not a broader predictor or\\narithmetic rewrite.\\n\", \"hypothesis\": {\"motivation\": \"The current best core has already captured the two strongest proven wins:\\ncold DIV/REM is off the universal EX path, and the one-deep pending-store\\nslot hides store-only dmem backpressure while preserving the ready-store fast\\npath. The next structural bottleneck is therefore load-side dmem stalls. A\\nload whose word was recently read still freezes the whole pipeline whenever\\n`io_dmemReady` is low, even though CoreMark repeatedly touches a compact 6 KB\\nworking set across list, matrix, state, stack, and CRC code.\\n\\nInstruction replay experiments showed that serving repeated hot accesses\\nduring random bus stalls can cut many cycles, but putting a wide replay table\\nin IF cost too much Fmax. A smaller load replay structure in MEM attacks the\\nsame random-stall problem on the data side, where the lookup is off the\\nbranch/JAL predictor path and does not add load data to the EX operand muxes.\\nThis is a structural stall-hiding change, not a broader predictor or\\narithmetic rewrite.\\n\", \"hypothesis\": \"Add a small normal-RAM load replay buffer in the MEM stage, for example a\\n16-entry direct-mapped table indexed by word address. Each entry holds a\\nvalid bit, word tag, and the raw 32-bit memory word returned by a previous\\nlegal aligned or byte/halfword load. On `io_dmemReady=1`, loads keep using\\nthe live `io_dmemRData` exactly as today and refresh the replay entry for the\\naligned word address. On `io_dmemReady=0`, a legal normal-RAM load may\\ncomplete from the replay buffer on a valid tag hit: suppress the external\\ndmem read, use the cached raw word for sign/zero extension and RVFI\\n`mem_rdata`, and do not assert `mem_wait`.\\n\\nReplay is deliberately conservative. It is disabled while the pending-store\\nslot is valid, for MMIO/marker/UART addresses, for trapping or misaligned\\naccesses, and for stores. Normal-RAM stores invalidate or update the matching\\nreplay entry before they retire or enqueue into the pending-store slot, so a\\nlater replayed load cannot observe stale data. Replay misses preserve the\\ncurrent dmem wait behavior exactly. The top-level IO, single-retire RVFI\\nchannel-0 convention, tied-off channel 1, divider interlock, branch\\nprediction, and pending-store ordering all remain unchanged. The expected win\\nis lower CoreMark cycle count under the 22% random dStall model with much\\nless Fmax risk than MEM-to-EX load forwarding or IF replay caches.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_replay.sv\", \"description\": \"Add a small direct-mapped normal-RAM replay table with valid, tag, and\\nraw-word data state. Provide lookup-hit/data outputs for legal load word\\naddresses, refresh entries from live dmem load responses, and invalidate\\nor byte-merge-update matching entries on legal normal-RAM stores. Reset\\nclears only valid bits.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Integrate the replay lookup into load handling. Select cached raw word\\ndata only when `dmem_ready` is low, the access is a legal non-trapping\\nnormal-RAM load, no pending store slot owns the port, and the replay tag\\nhits. On a replay hit, gate off `dmem_ren`, clear `mem_wait`, drive\\nload-data extraction and RVFI `mem_rdata` from the cached word, and keep\\nreplay misses plus all nonbufferable accesses on the existing wait path.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire any replay-buffer module instance or MEM-stage sideband signals\\nneeded for store invalidation/update and dmem request gating. Preserve\\nthe existing pending-store-slot arbitration, top-level core IO, RVFI\\nNRET=2 port layout, strict channel-0 order sequence, and tied-off\\nchannel 1 behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only comments or compact helper typedefs if needed to document\\nnormal-RAM replay eligibility and raw-word cache metadata. Do not change\\narchitectural state semantics, decoder legality defaults, RVFI field\\nwidths, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_replay.sv\", \"description\": \"Add a small direct-mapped normal-RAM replay table with valid, tag, and\\nraw-word data state. Provide lookup-hit/data outputs for legal load word\\naddresses, refresh entries from live dmem load responses, and invalidate\\nor byte-merge-update matching entries on legal normal-RAM stores. Reset\\nclears only valid bits.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Integrate the replay lookup into load handling. Select cached raw word\\ndata only when `dmem_ready` is low, the access is a legal non-trapping\\nnormal-RAM load, no pending store slot owns the port, and the replay tag\\nhits. On a replay hit, gate off `dmem_ren`, clear `mem_wait`, drive\\nload-data extraction and RVFI `mem_rdata` from the cached word, and keep\\nreplay misses plus all nonbufferable accesses on the existing wait path.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire any replay-buffer module instance or MEM-stage sideband signals\\nneeded for store invalidation/update and dmem request gating. Preserve\\nthe existing pending-store-slot arbitration, top-level core IO, RVFI\\nNRET=2 port layout, strict channel-0 order sequence, and tied-off\\nchannel 1 behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only comments or compact helper typedefs if needed to document\\nnormal-RAM replay eligibility and raw-word cache metadata. Do not change\\narchitectural state semantics, decoder legality defaults, RVFI field\\nwidths, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 442.54, \"delta_pct\": 4.68, \"vs_baseline\": 47.0, \"fmax_mhz\": 184.6, \"ipc_coremark\": 2e-06, \"cycles\": 4171413, \"iterations\": 10, \"lut4\": 5925, \"ff\": 2229, \"seeds\": [169.66, 193.35, 184.6], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What Changed\\n\\n- Added `rtl/load_replay.sv`, a 16-entry direct-mapped load replay table keyed by aligned word address. Each entry stores a valid bit, word tag, and raw 32-bit memory word. Reset clears valid bits.\\n- Updated `rtl/mem_stage.sv` to refresh the table from accepted normal-RAM loads when `dmem_ready` is high.\\n- Updated `rtl/mem_stage.sv` to replay legal normal-RAM loads only when `dmem_ready` is low, no pending store owns the port, and the replay tag hits. Replay hits suppress `dmem_ren`, clear `mem_wait`, and use the cached raw word for load extraction and RVFI `mem_rdata`.\\n- Updated normal-RAM store handling to byte-merge stores into an existing matching replay entry before the store retires or enqueues into the pending-store slot.\\n\\n## Deviations\\n\\n- No `rtl/core.sv` wiring was needed; the replay table is instantiated inside `mem_stage` because all eligibility, load data, and store-update sideband signals are local there.\\n- Stores update existing matching entries but do not allocate new entries. This avoids fabricating a full cached word for sub-word stores when no previous load populated the word.\\n- The checked-in `bash formal/run_all.sh` could not stage files because `formal/riscv-formal` is a symlink to a read-only location outside this writable sandbox. I mirrored the riscv-formal framework into `/tmp` and ran the same generated checks from there.\\n\\n## Concerns\\n\\n- The replay table is intentionally conservative and only helps words already populated by accepted loads. It will not create hits from store-only hot data.\\n- No top-level IO, RVFI channel layout, branch path, divider interlock, or pending-store arbitration contract was changed.\\n\\n## Local Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- Direct `bash formal/run_all.sh`: blocked before checks by read-only staging cleanup under `formal/riscv-formal/cores/auto-arch-researcher`.\\n- Mirrored formal run from `/tmp/riscv-formal-codex.itXm55` using the same `formal/checks.cfg` and generated file list: 105 passed, 0 failed.\\n- Formal fix attempts used: 0.\\n\", \"timestamp\": \"2026-04-28T06:07:18.650889\", \"slot\": 1, \"round_id\": 12}\n38:{\"id\": \"hyp-20260428-031-r13s0\", \"title\": \"Compressed Resetless I-Fetch Replay Tags\", \"category\": \"micro_opt\", \"motivation\": \"The current best fitness comes from the registered lookahead instruction\\nreplay predictor: it preserves most of the 256-entry replay table's large\\nrandom-iStall cycle reduction while moving the same-cycle tag lookup off the\\nIF decision path. That win also makes the replay table one of the remaining\\nhigh-leverage timing structures. The table still stores a full 32-bit PC tag\\nfor every entry even though the direct-mapped index already encodes\\n`pc[9:2]` and all reachable fetch PCs are word-aligned. It also resets the\\ntag and instruction arrays even though the valid bits alone determine\\nwhether those payloads can be consumed.\\n\\nRecent micro-opt results show that exact timing-only cleanups can matter:\\nthe 16-bit segmented RVFI order counter improved Fmax without changing\\nCoreMark cycles, while broader datapath rewrites and smaller replay tables\\nlost either hit rate or placement quality. Compressing and de-resetting the\\nexisting replay metadata is the same kind of narrow micro-optimization: keep\\nthe current replay behavior and cycle count, but reduce IF table width,\\nreset fanout, and registered-candidate comparison logic.\\n\", \"hypothesis\": {\"motivation\": \"The current best fitness comes from the registered lookahead instruction\\nreplay predictor: it preserves most of the 256-entry replay table's large\\nrandom-iStall cycle reduction while moving the same-cycle tag lookup off the\\nIF decision path. That win also makes the replay table one of the remaining\\nhigh-leverage timing structures. The table still stores a full 32-bit PC tag\\nfor every entry even though the direct-mapped index already encodes\\n`pc[9:2]` and all reachable fetch PCs are word-aligned. It also resets the\\ntag and instruction arrays even though the valid bits alone determine\\nwhether those payloads can be consumed.\\n\\nRecent micro-opt results show that exact timing-only cleanups can matter:\\nthe 16-bit segmented RVFI order counter improved Fmax without changing\\nCoreMark cycles, while broader datapath rewrites and smaller replay tables\\nlost either hit rate or placement quality. Compressing and de-resetting the\\nexisting replay metadata is the same kind of narrow micro-optimization: keep\\nthe current replay behavior and cycle count, but reduce IF table width,\\nreset fanout, and registered-candidate comparison logic.\\n\", \"hypothesis\": \"Keep the 256-entry registered lookahead replay predictor and its live-imem\\nfirst policy unchanged, but store only the non-index PC tag bits in each\\nentry. With `REPLAY_INDEX_BITS=8`, replace the full 32-bit `replay_tag`\\narray with a `replay_tag_hi` array holding `pc[31:10]`; `pc[9:2]` is already\\nthe array index, and `pc[1:0]` is always zero for architecturally reachable\\nfetches because misaligned branch/JAL/JALR targets trap and suppress the\\nredirect. The lookahead fill, lookup, and fill-bypass paths should compare\\nonly these high tag bits while retaining the existing guard that the\\nregistered candidate corresponds to the current fetch PC.\\n\\nAlso remove the reset writes to replay tag and instruction payload arrays.\\nReset clears only `replay_valid` plus the registered candidate state; invalid\\nentries may hold arbitrary tag/data bits because they are never selected.\\nLive `io_imemReady=1` cycles still use `io_imemData` and refresh the replay\\nentry. `io_imemReady=0` cycles still replay only on a valid matching\\nregistered candidate, otherwise preserving the current PC-hold and IF-bubble\\nbehavior. Branch/JAL prediction, redirect priority, hazard-unit fetch-ready\\nsemantics, RVFI instruction reporting, top-level IO, pending-store behavior,\\ndivider interlock, and channel-0-only retirement remain unchanged.\\n\\nThe expected gain is a modest Fmax improvement from shortening the replay\\ntag read/compare path, reducing table storage width, and removing reset\\npressure from the replay payload memories, with no intended change to\\nCoreMark iterations/cycle.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Compress the replay table tag from a full 32-bit PC to the high\\nnon-index bits `pc[31:10]`, and update the registered lookahead lookup,\\nfill, and fill-bypass comparisons accordingly. Clear only replay valid\\nbits and registered candidate state on reset; leave replay tag and\\ninstruction payload arrays resetless because invalid entries cannot be\\nselected. Preserve the 256-entry table size, live-imem priority,\\nregistered replay-hit behavior, static backward-branch/direct-JAL\\nprediction, redirect priority, and `fetch_ready` contract.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify only the IF/ID prediction comments to note that replay entries\\nare tagged by the high PC bits plus the direct-mapped index, and that\\nreplay tag/instruction payload arrays are resetless behind valid bits.\\nDo not change bundle widths, architectural state, decoder legality\\ndefaults, RVFI fields, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Compress the replay table tag from a full 32-bit PC to the high\\nnon-index bits `pc[31:10]`, and update the registered lookahead lookup,\\nfill, and fill-bypass comparisons accordingly. Clear only replay valid\\nbits and registered candidate state on reset; leave replay tag and\\ninstruction payload arrays resetless because invalid entries cannot be\\nselected. Preserve the 256-entry table size, live-imem priority,\\nregistered replay-hit behavior, static backward-branch/direct-JAL\\nprediction, redirect priority, and `fetch_ready` contract.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify only the IF/ID prediction comments to note that replay entries\\nare tagged by the high PC bits plus the direct-mapped index, and that\\nreplay tag/instruction payload arrays are resetless behind valid bits.\\nDo not change bundle widths, architectural state, decoder legality\\ndefaults, RVFI fields, or the NRET=2 contract.\\n\"}], \"outcome\": \"improvement\", \"fitness\": 505.65, \"delta_pct\": 6.91, \"vs_baseline\": 67.97, \"fmax_mhz\": 174.92, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5938, \"ff\": 2226, \"seeds\": [165.07, 188.82, 174.92], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Compressed the IF replay table tag storage in `rtl/if_stage.sv` from full\\n  32-bit PCs to the high non-index bits `pc[31:10]`.\\n- Kept the 256-entry direct-mapped replay table and the registered lookahead\\n  replay behavior unchanged.\\n- Updated replay fill, registered lookup, and fill-bypass matching to use the\\n  direct-mapped index plus the compressed high tag bits.\\n- Preserved the registered current-PC guard with `replay_cand_pc_q == pc`\\n  before a replayed instruction can be selected.\\n- Removed reset writes to replay tag and instruction payload arrays. Reset now\\n  clears only `replay_valid` and the registered replay candidate state.\\n- Updated the IF/ID bundle comment in `rtl/core_pkg.sv` to document compressed\\n  replay tags and resetless replay payload arrays.\\n\\n## Deviations\\n\\n- No architectural or interface deviations from the hypothesis.\\n- `bash formal/run_all.sh` could not stage files directly in this worktree\\n  because the sandbox blocks writes under the protected `formal/riscv-formal`\\n  staging path. I ran the same script in a dereferenced `/tmp` copy of the\\n  worktree so the formal staging writes occurred outside the protected tree.\\n\\n## Concerns\\n\\n- None known. Invalid replay entries remain unselectable because reset clears\\n  all valid bits, and replay payload/tag bits are only consumed after a valid\\n  indexed high-tag match and the registered current-PC guard.\\n\\n## Local verification\\n\\n- Verilator lint: pass\\n  `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`\\n- Formal: pass in `/tmp/auto-arch-formal.TSXDCE`\\n  `bash formal/run_all.sh`\\n  Result: `Formal: 105 passed, 0 failed`\\n\", \"timestamp\": \"2026-04-28T06:19:26.695091\", \"slot\": 0, \"round_id\": 13}\n42:{\"id\": \"hyp-20260428-035-r14s1\", \"title\": \"Registered MEM Load-Replay Candidate\", \"category\": \"structural\", \"motivation\": \"The current best core gets its largest IPC gain from registered lookahead\\ninstruction replay: repeated hot instructions can be supplied during random\\nimem stalls without putting a same-cycle replay-table lookup on the IF\\ndecision path. The analogous remaining structural loss is on the data side.\\nLoads still freeze the whole in-order pipeline whenever io_dmemReady is low,\\neven when the same normal-RAM word was recently returned by dmem.\\n\\nThe earlier MEM-stage load replay experiment showed the opportunity: it cut\\nCoreMark cycles, but the combinational replay-table lookup, tag compare, and\\nstore merge logic in MEM lowered Fmax enough to miss the current best. The\\npromising structural angle is to keep the replay behavior while moving the\\nlookup off the MEM critical path, just as the successful IF replay predictor\\ndid for instruction stalls.\\n\", \"hypothesis\": {\"motivation\": \"The current best core gets its largest IPC gain from registered lookahead\\ninstruction replay: repeated hot instructions can be supplied during random\\nimem stalls without putting a same-cycle replay-table lookup on the IF\\ndecision path. The analogous remaining structural loss is on the data side.\\nLoads still freeze the whole in-order pipeline whenever io_dmemReady is low,\\neven when the same normal-RAM word was recently returned by dmem.\\n\\nThe earlier MEM-stage load replay experiment showed the opportunity: it cut\\nCoreMark cycles, but the combinational replay-table lookup, tag compare, and\\nstore merge logic in MEM lowered Fmax enough to miss the current best. The\\npromising structural angle is to keep the replay behavior while moving the\\nlookup off the MEM critical path, just as the successful IF replay predictor\\ndid for instruction stalls.\\n\", \"hypothesis\": \"Add a small normal-RAM load replay table with a registered candidate for the\\ninstruction entering MEM. When EX computes an effective address for a legal\\nload, use that address to look up the replay table one cycle early and latch a\\ncandidate {hit, raw_word, tag/address} alongside the EX/MEM payload. In the\\nfollowing MEM cycle, if io_dmemReady is low and the candidate still matches a\\nvalid non-trapping normal-RAM load, complete the load from the registered raw\\nword: suppress the live dmem read, use the cached word for sign/zero\\nextension and RVFI mem_rdata, and do not assert mem_wait. If the candidate\\nmisses, or if dmem is ready, preserve the current live-memory behavior.\\n\\nReplay remains conservative. It is disabled while the pending store slot is\\nvalid, for MMIO/marker/UART addresses, for misaligned or trapping memory\\noperations, and for stores. Accepted normal-RAM loads refresh the replay\\ntable from live io_dmemRData. Normal-RAM stores either byte-merge-update or\\ninvalidate a matching replay entry before the store retires or enqueues into\\nthe pending store slot, so a replayed load cannot observe stale bytes.\\n\\nThis is a structural latency-hiding change, not a load-to-EX bypass: cached\\ndata is used only at the MEM retirement boundary, and dependent younger\\ninstructions still rely on the existing in-order load-use behavior. The\\ntop-level IO, RVFI NRET=2 contract, channel-0-only retirement convention,\\nstrict rvfi_order sequence, registered IF replay predictor, divider\\ninterlock, branch prediction, and pending-store ordering all remain\\nunchanged. The expected win is to recover much of the prior load-replay cycle\\nreduction with less Fmax loss because MEM sees only a registered hit/data\\ncandidate instead of a same-cycle table read.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_replay.sv\", \"description\": \"Add a small direct-mapped normal-RAM replay table with valid, tag, and\\nraw-word data state. Provide a one-cycle-early lookup interface that\\nlatches a replay candidate for the load entering MEM, refresh entries\\nfrom accepted live dmem load responses, and invalidate or byte-merge\\nmatching entries on legal normal-RAM stores. Reset clears only valid and\\ncandidate-valid state.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Expose the effective address and replay-eligible metadata for the\\ninstruction being launched into EX/MEM so the load replay table can\\nregister its lookup candidate one cycle before MEM uses it. Do not change\\nALU results, forwarding, branch/JAL prediction repair, divider launch,\\nor RVFI operand metadata.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Consume the registered replay candidate during load handling. Select\\ncached raw word data only when dmem_ready is low, the current access is a\\nvalid legal normal-RAM load, no pending store slot owns the port, and the\\nregistered candidate matches. On a hit, gate off dmem_ren, clear\\nmem_wait, and drive load extraction plus RVFI mem_rdata from the cached\\nword. Keep replay misses and all nonbufferable accesses on the existing\\nwait path, and update or invalidate replay entries for stores.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the one-cycle-early replay lookup sideband from EX to the replay\\ntable and the registered replay candidate into MEM, while preserving the\\nexisting registered IF replay wiring, pending-store-slot dmem arbitration,\\ntop-level core IO shape, RVFI channel layout, and channel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only compact helper typedefs or comments if useful for carrying the\\nregistered load-replay candidate and eligibility metadata. Do not change\\narchitectural state semantics, decoder legality defaults, RVFI field\\nwidths, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_replay.sv\", \"description\": \"Add a small direct-mapped normal-RAM replay table with valid, tag, and\\nraw-word data state. Provide a one-cycle-early lookup interface that\\nlatches a replay candidate for the load entering MEM, refresh entries\\nfrom accepted live dmem load responses, and invalidate or byte-merge\\nmatching entries on legal normal-RAM stores. Reset clears only valid and\\ncandidate-valid state.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Expose the effective address and replay-eligible metadata for the\\ninstruction being launched into EX/MEM so the load replay table can\\nregister its lookup candidate one cycle before MEM uses it. Do not change\\nALU results, forwarding, branch/JAL prediction repair, divider launch,\\nor RVFI operand metadata.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Consume the registered replay candidate during load handling. Select\\ncached raw word data only when dmem_ready is low, the current access is a\\nvalid legal normal-RAM load, no pending store slot owns the port, and the\\nregistered candidate matches. On a hit, gate off dmem_ren, clear\\nmem_wait, and drive load extraction plus RVFI mem_rdata from the cached\\nword. Keep replay misses and all nonbufferable accesses on the existing\\nwait path, and update or invalidate replay entries for stores.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the one-cycle-early replay lookup sideband from EX to the replay\\ntable and the registered replay candidate into MEM, while preserving the\\nexisting registered IF replay wiring, pending-store-slot dmem arbitration,\\ntop-level core IO shape, RVFI channel layout, and channel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only compact helper typedefs or comments if useful for carrying the\\nregistered load-replay candidate and eligibility metadata. Do not change\\narchitectural state semantics, decoder legality defaults, RVFI field\\nwidths, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 380.74, \"delta_pct\": -24.7, \"vs_baseline\": 26.47, \"fmax_mhz\": 130.14, \"ipc_coremark\": 3e-06, \"cycles\": 3418106, \"iterations\": 10, \"lut4\": 5928, \"ff\": 2237, \"seeds\": [140.23, 129.57, 130.14], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What Changed\\n\\n- Added `rtl/load_replay.sv`, a 16-entry direct-mapped normal-RAM load replay table with reset-cleared valid state and a registered MEM-stage replay candidate.\\n- Added `load_replay_cand_t` in `rtl/core_pkg.sv` to carry `{valid, word-aligned address, raw word}` from the replay table to MEM.\\n- Extended `rtl/ex_stage.sv` to expose a one-cycle-early effective-address lookup sideband for valid, legal, aligned normal-RAM loads.\\n- Extended `rtl/mem_stage.sv` to consume the registered candidate only when `io_dmemReady` is low, the current instruction is still a valid legal normal-RAM load, and the pending store slot is not valid. Replay hits suppress the live dmem read, clear `mem_wait`, and drive both load extraction and RVFI `mem_rdata` from the cached raw word.\\n- Wired the replay table through `rtl/core.sv` while leaving top-level IO, RVFI channel layout, channel-1 tie-off, IF replay, divider interlock, branch prediction, and store-slot dmem arbitration unchanged.\\n\\n## Deviations\\n\\n- Store handling invalidates a matching replay entry instead of byte-merge-updating it. This is conservative and prevents stale replayed bytes while keeping the store-side replay-table update path smaller.\\n- The exact in-tree `bash formal/run_all.sh` command could not stage files because `formal/riscv-formal` is a symlink to a sandbox-protected directory; it failed immediately with `Operation not permitted` while removing staged `.sv` files. I mirrored `rtl/` and `formal/` into `/tmp/codex-formal-load-replay-36775` with a writable `riscv-formal/cores` directory and ran the same script there.\\n\\n## Concerns\\n\\n- The replay table is intentionally small and direct-mapped; it may recover less IPC than a larger or merge-updating table.\\n- The lookup is off the MEM wait path, but it still adds an EX effective-address-to-candidate-register setup path. The FPGA fitness run will decide whether that is cheaper than the old same-cycle MEM replay lookup.\\n\\n## Local Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: in-place run blocked by sandbox permissions before proofs began.\\n- `/tmp` mirror `bash formal/run_all.sh`: pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T06:42:55.474038\", \"slot\": 1, \"round_id\": 14}\n43:{\"id\": \"hyp-20260428-036-r14s2\", \"title\": \"Phase-Aligned Replay Candidate\", \"category\": \"predictor\", \"motivation\": \"The current best result comes from the compressed, resetless registered\\nlookahead instruction replay predictor. It keeps the large random-iStall\\ncycle win of the 256-entry replay table while avoiding a same-cycle table\\nread in IF. The predictor experiments since then show that adding more\\nbranch-direction or return-target state is not attractive: those changes\\nsaved a few cycles but lost more Fmax than they recovered.\\n\\nThe remaining predictor timing cost is inside the replay fast decision\\nitself. `if_stage` still carries a full 32-bit `replay_cand_pc_q` and gates\\nreplay hits with `replay_cand_pc_q == pc` before asserting `fetch_ready`.\\nThat compare is on the current IF stall/PC-enable path even though the\\ncandidate is already generated from the exact same redirect/stall/next-PC\\nselection that updates the PC register. After a clock edge, the registered\\nreplay candidate is phase-aligned with the current PC by construction.\\n\\nRemoving the redundant current-PC equality check is a narrower predictor\\nimprovement than changing table capacity or direction policy. It preserves\\nthe current replay hit rate and CoreMark cycle count while shortening the\\nfetch-ready path and dropping the 32-bit candidate-PC register.\\n\", \"hypothesis\": {\"motivation\": \"The current best result comes from the compressed, resetless registered\\nlookahead instruction replay predictor. It keeps the large random-iStall\\ncycle win of the 256-entry replay table while avoiding a same-cycle table\\nread in IF. The predictor experiments since then show that adding more\\nbranch-direction or return-target state is not attractive: those changes\\nsaved a few cycles but lost more Fmax than they recovered.\\n\\nThe remaining predictor timing cost is inside the replay fast decision\\nitself. `if_stage` still carries a full 32-bit `replay_cand_pc_q` and gates\\nreplay hits with `replay_cand_pc_q == pc` before asserting `fetch_ready`.\\nThat compare is on the current IF stall/PC-enable path even though the\\ncandidate is already generated from the exact same redirect/stall/next-PC\\nselection that updates the PC register. After a clock edge, the registered\\nreplay candidate is phase-aligned with the current PC by construction.\\n\\nRemoving the redundant current-PC equality check is a narrower predictor\\nimprovement than changing table capacity or direction policy. It preserves\\nthe current replay hit rate and CoreMark cycle count while shortening the\\nfetch-ready path and dropping the 32-bit candidate-PC register.\\n\", \"hypothesis\": \"Replace the full-PC-guarded replay candidate with a phase-aligned valid\\ncandidate. In `if_stage`, compute `replay_lookup_pc` from the same priority\\nmux that determines the next value of `pc`: EX redirect target first, then\\npredicted/fallthrough next PC when fetch is not stalled, otherwise the held\\ncurrent PC. Use that lookup to register only `{valid, instr}` for the next\\ncycle. Because the PC register loads the same selected address on the same\\nclock edge, `replay_cand_valid_q` means the cached instruction candidate is\\nfor the current fetch PC on the following cycle.\\n\\nWith that invariant, drive `fetch_ready = io_imemReady || replay_cand_valid_q`\\nand select `replay_cand_instr_q` on an external imem stall whenever the\\ncandidate valid bit is set. Remove `replay_cand_pc_q` and the 32-bit\\nequality check from the current-cycle IF path. The replay table itself keeps\\nthe current 256-entry organization, compressed high-PC tags, resetless\\ntag/instruction payloads, live-imem-first fill policy, and same-index fill\\nbypass. Reset still clears the replay valid bits and candidate valid state;\\nredirects and held-PC cycles recompute the candidate from the same address\\nthe PC will hold or load.\\n\\nThis should be bit-equivalent for all architecturally reachable traces:\\nreplay contents are still selected only after a valid table lookup for the\\nselected next PC, live imem data still wins whenever ready, replay misses\\nstill hold the PC and inject the existing IF bubble, and EX still repairs\\nbranch/JAL prediction mistakes through resolved-next-PC mismatch recovery.\\nThe top-level IO, RVFI NRET=2 contract, channel-0 retirement order, pending\\nstore slot, divider interlock, decoder legality rules, and static\\nbackward-branch/direct-JAL prediction policy remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Remove `replay_cand_pc_q` and the full 32-bit\\n`replay_cand_pc_q == pc` replay-hit guard. Register the replay\\ncandidate from the same selected next-PC value that the PC register will\\nhold after the clock edge, so the candidate valid bit is phase-aligned\\nwith the current fetch PC. Drive effective `fetch_ready` from live imem\\nreadiness or this phase-aligned candidate valid bit, and preserve the\\nexisting replay table size, compressed high tags, resetless payload\\narrays, fill bypass, live-imem priority, redirect priority, and static\\nbranch/JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID prediction comments to document that replay candidates\\nare registered for the same next-PC value loaded by the IF PC register,\\nso candidate validity is phase-aligned with the current fetch PC. Do not\\nchange bundle widths, architectural state, decoder legality defaults,\\nRVFI fields, top-level IO, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Remove `replay_cand_pc_q` and the full 32-bit\\n`replay_cand_pc_q == pc` replay-hit guard. Register the replay\\ncandidate from the same selected next-PC value that the PC register will\\nhold after the clock edge, so the candidate valid bit is phase-aligned\\nwith the current fetch PC. Drive effective `fetch_ready` from live imem\\nreadiness or this phase-aligned candidate valid bit, and preserve the\\nexisting replay table size, compressed high tags, resetless payload\\narrays, fill bypass, live-imem priority, redirect priority, and static\\nbranch/JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID prediction comments to document that replay candidates\\nare registered for the same next-PC value loaded by the IF PC register,\\nso candidate validity is phase-aligned with the current fetch PC. Do not\\nchange bundle widths, architectural state, decoder legality defaults,\\nRVFI fields, top-level IO, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 300.23, \"delta_pct\": -40.62, \"vs_baseline\": -0.27, \"fmax_mhz\": 103.86, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5944, \"ff\": 2223, \"seeds\": [103.86, 112.33, 100.73], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What Changed\\n\\n- Updated `rtl/if_stage.sv` to remove the 32-bit `replay_cand_pc_q` register and the `replay_cand_pc_q == pc` replay-hit guard.\\n- `fetch_ready` is now driven by `imem_ready || replay_cand_valid_q`.\\n- During an external imem stall, IF now selects `replay_cand_instr_q` whenever `replay_cand_valid_q` is set.\\n- Kept the existing replay table organization: 256 direct-mapped entries, high-PC tags, resetless tag/instruction payloads, valid-bit reset, live-imem-first fill, and same-index fill bypass.\\n- Narrowed the replay lookup address storage used inside IF to `replay_lookup_pc_word[31:2]`, since the low two PC bits are architecturally zero for fetch and no longer feed a full-PC equality check.\\n- Updated the IF/ID comments in `rtl/core_pkg.sv` to document that replay candidates are registered for the same next-PC value loaded by IF's PC register.\\n\\n## Deviations\\n\\n- No architectural or bundle-width changes were made.\\n- No changes were made outside `rtl/` except this notes file.\\n- The normal `bash formal/run_all.sh` invocation could not stage files in this sandbox because `formal/riscv-formal` is a symlink to a shared tree outside the writable worktree. I ran the same script from a dereferenced `/tmp/auto-arch-formal-r14s2` copy containing the current `rtl/` instead.\\n\\n## Concerns\\n\\n- The change relies on the existing invariant that `replay_lookup_pc_word` is selected from the same redirect/stall/next-PC priority used by the PC register update. That invariant is now directly reflected in the remaining IF logic.\\n- No known functional concerns from lint or formal.\\n\\n## Local Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked in-place by sandbox permissions on the symlinked shared `formal/riscv-formal` staging directory before checks ran.\\n- Equivalent `/tmp` formal run using a copied `formal/` tree and current `rtl/`: pass, `105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T06:38:29.236296\", \"slot\": 2, \"round_id\": 14}\n44:{\"id\": \"hyp-20260428-037-r15s0\", \"title\": \"Valid-Only Pipeline Payload Reset\", \"category\": \"micro_opt\", \"motivation\": \"The current best design is dominated by timing-only wins that do not change\\nCoreMark cycles: the segmented RVFI order counter and the compressed\\nresetless IF replay metadata both improved Fmax by removing unnecessary\\ncarry, compare, and reset pressure from always-present logic. The remaining\\npipeline registers still use broad `<= '0` clears on reset, flush, and\\ninjected bubbles, even though most payload bits are architecturally\\nirrelevant whenever the stage valid bit is zero.\\n\\nThose full-bundle clears add synchronous reset/clear muxes and reset fanout\\nto wide ID/EX, EX/MEM, MEM/WB, divide-side metadata, and replay-candidate\\npayload registers. The data fields include PCs, instructions, operands,\\nimmediates, memory words, and RVFI metadata; only a small subset of valid\\nbits and side-effect controls must be known zero to prevent writes,\\nmemory requests, redirects, or incorrect forwarding. A valid-gated payload\\ncleanup is a narrow micro-optimization in the same class as the measured\\nreplay tag reset elision: preserve the exact instruction stream and\\nretirement behavior, but remove needless reset/clear logic from hot\\npipeline boundaries.\\n\", \"hypothesis\": {\"motivation\": \"The current best design is dominated by timing-only wins that do not change\\nCoreMark cycles: the segmented RVFI order counter and the compressed\\nresetless IF replay metadata both improved Fmax by removing unnecessary\\ncarry, compare, and reset pressure from always-present logic. The remaining\\npipeline registers still use broad `<= '0` clears on reset, flush, and\\ninjected bubbles, even though most payload bits are architecturally\\nirrelevant whenever the stage valid bit is zero.\\n\\nThose full-bundle clears add synchronous reset/clear muxes and reset fanout\\nto wide ID/EX, EX/MEM, MEM/WB, divide-side metadata, and replay-candidate\\npayload registers. The data fields include PCs, instructions, operands,\\nimmediates, memory words, and RVFI metadata; only a small subset of valid\\nbits and side-effect controls must be known zero to prevent writes,\\nmemory requests, redirects, or incorrect forwarding. A valid-gated payload\\ncleanup is a narrow micro-optimization in the same class as the measured\\nreplay tag reset elision: preserve the exact instruction stream and\\nretirement behavior, but remove needless reset/clear logic from hot\\npipeline boundaries.\\n\", \"hypothesis\": \"Convert the main pipeline and sidecar payload registers to valid-only or\\nside-effect-only reset discipline. Reset, redirect flushes, and long-op\\nbubbles should clear the stage `valid` bit and any control enables that can\\ncause an architectural side effect (`reg_write`, `mem_read`, `mem_write`,\\nbranch/jump redirect enables, and forwarding-visible write enables). The\\nwide payload fields behind those valid bits may remain resetless and do not\\nneed to be overwritten with zero on bubbles.\\n\\nConsumers must be made explicitly valid-aware wherever they are not already:\\nload-use detection should see `id_ex.valid && id_ex.ctrl.mem_read`;\\nEX/MEM forwarding should require a valid producer; MEM/WB forwarding must\\npreserve the existing held-load forwarding behavior during `hold_wb` while\\nstill being safe immediately after reset. MEM-stage dmem requests, WB\\nwrites, redirects, and RVFI retirement already key off valid and should keep\\nthat discipline. Channel 1 remains tied off, and channel 0 RVFI fields are\\nonly meaningful when `io_rvfi_valid_0` is asserted.\\n\\nThe visible 64-bit RVFI order sequence, `pc_wdata`, trap behavior, divider\\ninterlock, IF replay predictor, pending-store slot, memory ordering, and\\nCoreMark cycle count should remain bit-identical. The expected gain is a\\nmodest Fmax improvement from removing reset/clear muxes and reset routing on\\nseveral hundred nonarchitectural payload flops without adding new datapath\\nwork or predictor state.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/id_stage.sv\", \"description\": \"Change reset and flush handling for the ID/EX register so only\\n`valid` and side-effecting control bits are forced to a safe bubble.\\nLeave operand, PC, instruction, immediate, address, and prediction\\npayload fields resetless behind the cleared valid bit. Preserve decoder\\nillegal-default behavior and the existing capture path when the stage is\\nnot stalled.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Apply the same valid-only clear discipline to the EX/MEM register and\\ndivide metadata. Reset or bubble cycles should clear `valid` and any\\nforwarding-visible or memory/writeback side-effect controls, but should\\nnot zero wide payload fields that are ignored while invalid. Keep the\\ndivider launch/done protocol, branch/JAL/JALR repair logic, and RVFI\\noperand metadata semantics unchanged.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Convert MEM/WB reset to clear only `valid` and the minimal control\\nfields needed for safe post-reset forwarding/writeback behavior. Keep\\nthe existing `hold_wb` behavior that clears valid while retaining load\\nmetadata for forwarding during a dmem stall. Do not alter load\\nextraction, store-slot enqueue, dmem request gating, misalignment traps,\\nor RVFI memory fields for valid retirements.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"Make forwarding producer enables explicitly valid-aware for EX/MEM, and\\npreserve the current MEM/WB held-load forwarding case with a safe\\npost-reset enable. This prevents resetless invalid payloads from being\\nselected while keeping all existing true bypass behavior.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Gate hazard and forwarding inputs with the appropriate stage-valid or\\nheld-forwarding predicates so resetless payload fields cannot influence\\nstalls or operand selection. Preserve the top-level IO, RVFI NRET=2 port\\nlayout, strict channel-0 order counter, pending-store-slot arbitration,\\nIF replay wiring, and channel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update pipeline-bundle comments to document that many payload fields are\\nresetless and are only architecturally meaningful when the associated\\nvalid bit and side-effect controls are asserted. Do not change bundle\\nwidths, RVFI fields, decoder legality defaults, architectural state, or\\nthe NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/id_stage.sv\", \"description\": \"Change reset and flush handling for the ID/EX register so only\\n`valid` and side-effecting control bits are forced to a safe bubble.\\nLeave operand, PC, instruction, immediate, address, and prediction\\npayload fields resetless behind the cleared valid bit. Preserve decoder\\nillegal-default behavior and the existing capture path when the stage is\\nnot stalled.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Apply the same valid-only clear discipline to the EX/MEM register and\\ndivide metadata. Reset or bubble cycles should clear `valid` and any\\nforwarding-visible or memory/writeback side-effect controls, but should\\nnot zero wide payload fields that are ignored while invalid. Keep the\\ndivider launch/done protocol, branch/JAL/JALR repair logic, and RVFI\\noperand metadata semantics unchanged.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Convert MEM/WB reset to clear only `valid` and the minimal control\\nfields needed for safe post-reset forwarding/writeback behavior. Keep\\nthe existing `hold_wb` behavior that clears valid while retaining load\\nmetadata for forwarding during a dmem stall. Do not alter load\\nextraction, store-slot enqueue, dmem request gating, misalignment traps,\\nor RVFI memory fields for valid retirements.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"Make forwarding producer enables explicitly valid-aware for EX/MEM, and\\npreserve the current MEM/WB held-load forwarding case with a safe\\npost-reset enable. This prevents resetless invalid payloads from being\\nselected while keeping all existing true bypass behavior.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Gate hazard and forwarding inputs with the appropriate stage-valid or\\nheld-forwarding predicates so resetless payload fields cannot influence\\nstalls or operand selection. Preserve the top-level IO, RVFI NRET=2 port\\nlayout, strict channel-0 order counter, pending-store-slot arbitration,\\nIF replay wiring, and channel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update pipeline-bundle comments to document that many payload fields are\\nresetless and are only architecturally meaningful when the associated\\nvalid bit and side-effect controls are asserted. Do not change bundle\\nwidths, RVFI fields, decoder legality defaults, architectural state, or\\nthe NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 308.76, \"delta_pct\": -38.94, \"vs_baseline\": 2.56, \"fmax_mhz\": 106.81, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5949, \"ff\": 2255, \"seeds\": [95.9, 107.67, 106.81], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Converted ID/EX, EX/MEM, MEM/WB, divider side metadata, IF replay-candidate payload, and pending-store-slot payload reset handling toward valid-only discipline.\\n- Reset, redirect/bubble, and invalid-capture paths now clear `valid` plus side-effecting controls (`reg_write`, `mem_read`, `mem_write`, branch/jump redirect controls) while leaving wide payload fields resetless.\\n- Gated load-use detection with `id_ex.valid && id_ex.ctrl.mem_read`.\\n- Made EX/MEM forwarding valid-aware. MEM/WB forwarding keeps the existing held-writeback behavior by treating `mem_wb.ctrl.reg_write` as a forwarding-visible enable; reset and invalid captures now clear it, while `hold_wb` intentionally retains it.\\n- Updated bundle comments to document resetless payload validity rules.\\n\\n## Deviations\\n\\n- Also applied the same payload reset elision to `div_unit.sv`, `if_stage.sv` replay-candidate payload fields, and `store_slot.sv` payload fields. These are behind explicit valid/state bits and match the hypothesis intent even though they were not all in the advisory file list.\\n- Did not add any new architectural state, change bundle widths, alter top-level IO, or change the RVFI NRET=2 channel contract.\\n\\n## Concerns\\n\\n- Channel-0 RVFI payload fields may carry stale/resetless values when `io_rvfi_valid_0` is low. This is intentional; visible RVFI retirements remain valid-gated.\\n- The direct in-tree `bash formal/run_all.sh` invocation is blocked in this sandbox because `formal/riscv-formal` is a symlink to a protected path and the script cannot refresh `cores/auto-arch-researcher/*.sv` there.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: pass when run from a disposable `/tmp` copy of the same project inputs; final tally was `Formal: 105 passed, 0 failed`.\\n- No RTL formal counterexamples were observed, so no formal-driven fix attempts were needed.\\n\", \"timestamp\": \"2026-04-28T07:02:23.850439\", \"slot\": 0, \"round_id\": 15}\n45:{\"id\": \"hyp-20260428-038-r15s1\", \"title\": \"Two-Entry Pending Store Slot\", \"category\": \"structural\", \"motivation\": \"The current best core combines the proven structural pieces: cold DIV/REM is\\nout of the universal EX path, the one-deep pending-store slot hides some\\nnormal-RAM store backpressure, and the registered instruction replay table\\nremoves most random iStall loss. The remaining structural stalls are now\\nconcentrated on the data side. A single pending-store entry lets one stalled\\nRAM store retire, but the next store still freezes the whole pipeline while\\nthe older slot drains, even though both stores already have their address,\\nreplicated write data, byte mask, and RVFI memory metadata available in MEM.\\n\\nA two-entry store buffer was attempted before the large post-DIV and replay\\ntiming wins and failed placement on a much larger design. The current RTL is\\nsubstantially smaller and already has the timing-local one-entry direct fast\\npath, so revisiting only a second pending-store slot is the cleanest\\nstructural bet: it targets store bursts under the 22% random dStall model\\nwithout adding load data to EX, changing the branch predictor, widening\\nretirement, or touching the IF replay timing path.\\n\", \"hypothesis\": {\"motivation\": \"The current best core combines the proven structural pieces: cold DIV/REM is\\nout of the universal EX path, the one-deep pending-store slot hides some\\nnormal-RAM store backpressure, and the registered instruction replay table\\nremoves most random iStall loss. The remaining structural stalls are now\\nconcentrated on the data side. A single pending-store entry lets one stalled\\nRAM store retire, but the next store still freezes the whole pipeline while\\nthe older slot drains, even though both stores already have their address,\\nreplicated write data, byte mask, and RVFI memory metadata available in MEM.\\n\\nA two-entry store buffer was attempted before the large post-DIV and replay\\ntiming wins and failed placement on a much larger design. The current RTL is\\nsubstantially smaller and already has the timing-local one-entry direct fast\\npath, so revisiting only a second pending-store slot is the cleanest\\nstructural bet: it targets store bursts under the 22% random dStall model\\nwithout adding load data to EX, changing the branch predictor, widening\\nretirement, or touching the IF replay timing path.\\n\", \"hypothesis\": \"Extend the pending-store retirement slot into a two-entry oldest-first FIFO\\nfor legal, aligned normal-RAM stores only. When the FIFO is empty and\\n`io_dmemReady` is high, keep the existing direct ready-store path unchanged:\\nthe live MEM-stage store drives the external dmem port and retires normally.\\nWhen a bufferable store cannot use the port because `io_dmemReady` is low or\\nbecause an older pending store already owns the port, enqueue the store into\\nany free FIFO entry, retire it once through MEM/WB with its RVFI memory\\nfields, and allow younger non-memory instructions to continue.\\n\\nThe FIFO drains oldest-first onto the single external dmem port. While any\\npending store is valid, younger loads, younger stores that cannot enqueue,\\nand all MMIO/marker/UART stores must wait behind the buffered store stream.\\nThis preserves in-order memory visibility and keeps start/stop marker timing\\nexact. Misaligned, illegal, trapping, or non-normal-RAM stores never enter the\\nFIFO and keep the current wait-for-handshake behavior. If both entries are\\nfull, the MEM stage asserts the existing precise `mem_wait` interlock.\\n\\nThis should recover store-burst stall cycles that the one-entry slot cannot\\nabsorb while keeping the hot zero-wait memory path close to the current best\\nRTL. The top-level core IO, RVFI NRET=2 port set, channel-0-only single\\nretirement convention, strict `rvfi_order` sequence, divider interlock,\\nregistered IF replay predictor, and decoder legality invariants remain\\nunchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/store_slot.sv\", \"description\": \"Replace the one-entry pending-store slot with a two-entry oldest-first\\nFIFO. Expose valid/nonempty, full, enqueue-ready, and oldest drain\\nsignals. Support simultaneous drain and enqueue so a ready drain can\\nfree capacity for a younger store in the same cycle. Each entry holds\\nonly the byte address, replicated write data, and byte mask; RVFI\\nmetadata still retires through the normal MEM/WB path on enqueue.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Treat legal aligned normal-RAM stores as bufferable whenever the FIFO has\\nspace and the live dmem port is unavailable because `io_dmemReady` is low\\nor an older pending store is draining. Keep the direct ready-store path\\nunchanged when the FIFO is empty and `io_dmemReady` is high. Assert\\n`mem_wait` for loads and nonbufferable/MMIO stores behind any valid\\npending store, and for bufferable stores only when the FIFO is full.\\nPreserve misalignment traps, dmem gating, RVFI `mem_addr`, `mem_wmask`,\\nand `mem_wdata` semantics.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the two-entry store FIFO into the existing top-level dmem\\narbitration. Give the FIFO's oldest entry priority on the external port\\nwhile valid, route live MEM-stage requests directly only when the FIFO is\\nempty, and pass FIFO fullness/capacity back to MEM. Preserve the core\\nmodule IO shape, registered IF replay wiring, RVFI channel layout, strict\\nchannel-0 order counter behavior, and tied-off channel 1.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Keep consuming the MEM-stage `mem_wait` interlock, but update comments\\nand any naming if needed to reflect that a store can retire into either\\npending-store FIFO entry while younger non-memory work continues. Do not\\nchange load-use, imem replay readiness, EX long-operation, redirect, or\\nMEM/WB hold semantics.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/store_slot.sv\", \"description\": \"Replace the one-entry pending-store slot with a two-entry oldest-first\\nFIFO. Expose valid/nonempty, full, enqueue-ready, and oldest drain\\nsignals. Support simultaneous drain and enqueue so a ready drain can\\nfree capacity for a younger store in the same cycle. Each entry holds\\nonly the byte address, replicated write data, and byte mask; RVFI\\nmetadata still retires through the normal MEM/WB path on enqueue.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Treat legal aligned normal-RAM stores as bufferable whenever the FIFO has\\nspace and the live dmem port is unavailable because `io_dmemReady` is low\\nor an older pending store is draining. Keep the direct ready-store path\\nunchanged when the FIFO is empty and `io_dmemReady` is high. Assert\\n`mem_wait` for loads and nonbufferable/MMIO stores behind any valid\\npending store, and for bufferable stores only when the FIFO is full.\\nPreserve misalignment traps, dmem gating, RVFI `mem_addr`, `mem_wmask`,\\nand `mem_wdata` semantics.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the two-entry store FIFO into the existing top-level dmem\\narbitration. Give the FIFO's oldest entry priority on the external port\\nwhile valid, route live MEM-stage requests directly only when the FIFO is\\nempty, and pass FIFO fullness/capacity back to MEM. Preserve the core\\nmodule IO shape, registered IF replay wiring, RVFI channel layout, strict\\nchannel-0 order counter behavior, and tied-off channel 1.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Keep consuming the MEM-stage `mem_wait` interlock, but update comments\\nand any naming if needed to reflect that a store can retire into either\\npending-store FIFO entry while younger non-memory work continues. Do not\\nchange load-use, imem replay readiness, EX long-operation, redirect, or\\nMEM/WB hold semantics.\\n\"}], \"outcome\": \"placement_failed\", \"formal_passed\": true, \"cosim_passed\": true, \"error\": \"placement_failed\", \"seeds\": [null, null, null], \"slot\": 1, \"round_id\": 15}\n46:{\"id\": \"hyp-20260428-039-r15s2\", \"title\": \"Registered I-Fetch Replay Victim Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best design is driven by the registered lookahead instruction\\nreplay predictor with compressed, resetless tags. That predictor keeps the\\nlarge random-iStall cycle reduction of the 256-entry replay table while\\navoiding a same-cycle table read on the IF decision path. The experiment log\\nalso shows the boundary clearly: smaller replay tables gave up too much hit\\nrate, two-word replay lines recovered only a little cycle count while losing\\nFmax, and branch-direction or return predictors have consistently lost more\\nclock than their control-flow savings recovered.\\n\\nThe remaining replay misses are therefore most likely direct-mapped conflict\\nmisses in CoreMark's hot text footprint, not a lack of branch-direction\\nsophistication. A tiny victim predictor behind the existing 256-entry replay\\ntable targets those conflicts without widening the main table, adding a new\\nbranch update path, or putting a combinational lookup back onto current-cycle\\nfetch_ready.\\n\", \"hypothesis\": {\"motivation\": \"The current best design is driven by the registered lookahead instruction\\nreplay predictor with compressed, resetless tags. That predictor keeps the\\nlarge random-iStall cycle reduction of the 256-entry replay table while\\navoiding a same-cycle table read on the IF decision path. The experiment log\\nalso shows the boundary clearly: smaller replay tables gave up too much hit\\nrate, two-word replay lines recovered only a little cycle count while losing\\nFmax, and branch-direction or return predictors have consistently lost more\\nclock than their control-flow savings recovered.\\n\\nThe remaining replay misses are therefore most likely direct-mapped conflict\\nmisses in CoreMark's hot text footprint, not a lack of branch-direction\\nsophistication. A tiny victim predictor behind the existing 256-entry replay\\ntable targets those conflicts without widening the main table, adding a new\\nbranch update path, or putting a combinational lookup back onto current-cycle\\nfetch_ready.\\n\", \"hypothesis\": \"Keep the current 256-entry registered lookahead replay table, compressed\\nhigh-PC tags, resetless replay payload arrays, live-imem-first policy, and\\nregistered replay candidate semantics. Add a small fully-associative victim\\nreplay buffer, for example four entries, that stores recently evicted replay\\nwords as `{valid, word_pc_tag, instr}`. The victim entries are looked up only\\nwhile computing the registered lookahead candidate for the next fetch PC; the\\ncurrent IF cycle still selects only between live `io_imemData` and the\\npreviously registered replay candidate.\\n\\nOn a live `io_imemReady=1` fetch, refresh the direct-mapped replay entry for\\nthe current PC exactly as today. If that direct entry is valid for a different\\nhigh tag, move the evicted word into the victim buffer using a simple\\nround-robin or age pointer. If the live fetch PC already exists in the victim\\nbuffer, invalidate that victim copy after refreshing the direct entry so the\\ndirect table remains authoritative. On lookahead lookup, register a replay\\ncandidate on either a direct-table hit or a victim-buffer hit, with direct hit\\npriority. Replay misses still hold the PC and inject the existing IF bubble\\nwhen external imem is not ready.\\n\\nThis should recover hot-loop replay misses caused by a few PCs aliasing in\\nthe direct-mapped table while keeping the current-cycle IF path nearly\\nunchanged: `fetch_ready` is still driven from live imem readiness or the\\nregistered candidate hit, branch/JAL prediction still runs from the selected\\nlive or registered replay word, and EX still repairs any control prediction\\nmistake through resolved-next-PC mismatch recovery. Reset clears only valid\\nbits and candidate state; victim tags/instruction payloads can remain\\nresetless behind valid bits. Top-level IO, RVFI NRET=2 ports, strict\\nchannel-0 order, tied-off channel 1, pending-store behavior, divider\\ninterlock, and decoder legality rules remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a four-entry fully-associative victim replay buffer behind the\\nexisting 256-entry registered lookahead replay table. Store evicted\\nreplay words with a valid bit, full word-PC tag, and instruction data;\\nclear only valid bits on reset. During registered lookahead generation,\\nchoose a direct-table hit first and a victim hit second, then register\\nthe selected candidate exactly as the current replay path does. On live\\nimem fills, move displaced valid direct entries into the victim buffer,\\ninvalidate duplicate victim entries for the just-refreshed PC, and keep\\nlive imem data as the selected instruction whenever `io_imemReady` is\\nhigh. Preserve compressed direct tags, resetless payload arrays,\\nsame-index fill bypass, redirect priority, static backward-branch and\\ndirect-JAL prediction, and the existing `fetch_ready` contract.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that a replayed instruction\\nmay come from the direct-mapped table or from a small registered-lookahead\\nvictim predictor. Do not change bundle widths, architectural state,\\ndecoder legality defaults, RVFI fields, top-level IO, or the NRET=2\\ncontract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a four-entry fully-associative victim replay buffer behind the\\nexisting 256-entry registered lookahead replay table. Store evicted\\nreplay words with a valid bit, full word-PC tag, and instruction data;\\nclear only valid bits on reset. During registered lookahead generation,\\nchoose a direct-table hit first and a victim hit second, then register\\nthe selected candidate exactly as the current replay path does. On live\\nimem fills, move displaced valid direct entries into the victim buffer,\\ninvalidate duplicate victim entries for the just-refreshed PC, and keep\\nlive imem data as the selected instruction whenever `io_imemReady` is\\nhigh. Preserve compressed direct tags, resetless payload arrays,\\nsame-index fill bypass, redirect priority, static backward-branch and\\ndirect-JAL prediction, and the existing `fetch_ready` contract.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that a replayed instruction\\nmay come from the direct-mapped table or from a small registered-lookahead\\nvictim predictor. Do not change bundle widths, architectural state,\\ndecoder legality defaults, RVFI fields, top-level IO, or the NRET=2\\ncontract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 465.7, \"delta_pct\": -7.9, \"vs_baseline\": 54.7, \"fmax_mhz\": 161.06, \"ipc_coremark\": 3e-06, \"cycles\": 3458440, \"iterations\": 10, \"lut4\": 5921, \"ff\": 2225, \"seeds\": [161.06, 172.15, 144.68], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes Made\\n\\n- Added a four-entry fully-associative victim replay buffer in `rtl/if_stage.sv`.\\n- Victim entries store `{valid, pc[31:2], instr}` and are searched only for the registered lookahead replay candidate.\\n- Kept live imem priority and the existing current-cycle IF contract: `fetch_ready` is still driven only by `imem_ready` or a previously registered replay candidate hit.\\n- Preserved direct-table priority over victim hits, including same-index live fill bypass priority.\\n- On live imem fills, the direct-mapped replay table is refreshed as before. A valid displaced direct entry with a different compressed high tag is inserted into the victim buffer through a round-robin replacement pointer.\\n- On live imem fills, matching victim entries for the just-refreshed PC are invalidated so the direct table remains authoritative.\\n- Reset clears replay valid bits, victim valid bits, replacement pointer, and candidate state only; direct/victim tag and instruction payload arrays remain resetless behind valid bits.\\n- Updated the IF/ID replay comments in `rtl/core_pkg.sv` to document that replayed words may come from either the direct table or the victim buffer.\\n\\n## Deviations\\n\\n- No functional deviations from the hypothesis. The victim size is four entries and uses simple round-robin replacement.\\n- `bash formal/run_all.sh` could not run directly in the worktree because the sandbox blocked the script's staging cleanup under `formal/riscv-formal/cores/auto-arch-researcher`. I ran the same unmodified script from a writable `/tmp/aa-formal-run-r15s2` mirror containing the current `rtl/` files and symlinked read-only riscv-formal resources.\\n\\n## Concerns\\n\\n- Yosys reports that the four-entry victim arrays are replaced with lists of registers during formal elaboration. That is expected for the small fully-associative structure and is not a functional issue.\\n- The victim lookup adds four tag compares to the registered lookahead path, not the current-cycle `fetch_ready` path. Fmax impact should be limited, but FPGA P&R is still the real arbiter.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: pass via writable temp mirror, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T06:55:12.038574\", \"slot\": 2, \"round_id\": 15}\n47:{\"id\": \"hyp-20260428-040-r16s0\", \"title\": \"Resetless Replay Candidate Payloads\", \"category\": \"micro_opt\", \"motivation\": \"The current best result is built around the registered lookahead instruction\\nreplay predictor. The strongest recent micro-opt win came from compressing\\nreplay tags and making replay table payload arrays resetless behind valid\\nbits; broader attempts to remove the replay candidate PC guard or apply\\nvalid-only reset discipline across the whole pipeline regressed. That points\\nto a narrower follow-up in the same proven area.\\n\\n`if_stage` still synchronously resets the registered replay candidate PC and\\ninstruction payload to `RESET_PC` and `NOP`, even though those fields are\\nconsumed only when `replay_cand_valid_q` is asserted and the existing full-PC\\nguard matches the current fetch PC. Reset muxes and reset fanout on these\\n64 payload bits sit next to the IF replay/fetch-ready path that now matters\\nmost for Fmax. Clearing only the candidate valid bit should preserve the\\ncurrent replay hit rate and all visible behavior while trimming a small but\\ntiming-relevant reset structure.\\n\", \"hypothesis\": {\"motivation\": \"The current best result is built around the registered lookahead instruction\\nreplay predictor. The strongest recent micro-opt win came from compressing\\nreplay tags and making replay table payload arrays resetless behind valid\\nbits; broader attempts to remove the replay candidate PC guard or apply\\nvalid-only reset discipline across the whole pipeline regressed. That points\\nto a narrower follow-up in the same proven area.\\n\\n`if_stage` still synchronously resets the registered replay candidate PC and\\ninstruction payload to `RESET_PC` and `NOP`, even though those fields are\\nconsumed only when `replay_cand_valid_q` is asserted and the existing full-PC\\nguard matches the current fetch PC. Reset muxes and reset fanout on these\\n64 payload bits sit next to the IF replay/fetch-ready path that now matters\\nmost for Fmax. Clearing only the candidate valid bit should preserve the\\ncurrent replay hit rate and all visible behavior while trimming a small but\\ntiming-relevant reset structure.\\n\", \"hypothesis\": \"Make the registered replay candidate payload resetless while keeping the\\ncurrent correctness guard intact. On reset, clear `replay_cand_valid_q` and\\nthe replay table valid bits exactly as today, but do not assign reset values\\nto `replay_cand_pc_q` or `replay_cand_instr_q`. The replay candidate remains\\nselectable only when `replay_cand_valid_q && (replay_cand_pc_q == pc)`, so\\nresetless PC/instruction payload bits cannot affect fetch, decode, RVFI, or\\nbranch/JAL prediction until they have been written by a real lookahead\\nlookup or fill-bypass update.\\n\\nThis intentionally does not repeat the prior candidate-PC-compare removal:\\nthe full current-PC equality check stays in place, live `io_imemData` still\\nhas priority whenever `io_imemReady` is high, replay misses still create the\\nsame PC-hold and IF bubble, and the 256-entry compressed-tag replay table,\\nstatic backward-branch/direct-JAL predictor, redirect priority, divider\\ninterlock, pending-store slot, RVFI NRET=2 ports, channel-0-only retirement,\\nand strict `rvfi_order` sequence remain unchanged. CoreMark cycles should be\\nbit-identical; the expected gain is a modest median Fmax improvement from\\nremoving reset muxing and reset routing on the replay candidate payload\\nregisters in the timing-sensitive IF replay block.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Change the replay-candidate reset block so reset clears only\\n`replay_cand_valid_q` and the replay table valid bits. Leave\\n`replay_cand_pc_q` and `replay_cand_instr_q` resetless behind the\\nexisting candidate-valid and full-PC match guard. Preserve live-imem\\npriority, replay fill/update behavior, fill bypass, compressed replay\\ntags, static backward-branch/direct-JAL prediction, redirect priority,\\nand the current `fetch_ready` contract.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that the registered replay\\ncandidate payload is resetless behind its valid bit and current-PC guard.\\nDo not change bundle widths, architectural state, decoder legality\\ndefaults, RVFI fields, top-level IO, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Change the replay-candidate reset block so reset clears only\\n`replay_cand_valid_q` and the replay table valid bits. Leave\\n`replay_cand_pc_q` and `replay_cand_instr_q` resetless behind the\\nexisting candidate-valid and full-PC match guard. Preserve live-imem\\npriority, replay fill/update behavior, fill bypass, compressed replay\\ntags, static backward-branch/direct-JAL prediction, redirect priority,\\nand the current `fetch_ready` contract.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that the registered replay\\ncandidate payload is resetless behind its valid bit and current-PC guard.\\nDo not change bundle widths, architectural state, decoder legality\\ndefaults, RVFI fields, top-level IO, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 363.19, \"delta_pct\": -28.17, \"vs_baseline\": 20.65, \"fmax_mhz\": 125.64, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5929, \"ff\": 2229, \"seeds\": [125.64, 139.88, 124.46], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Updated `rtl/if_stage.sv` so reset clears only `replay_cand_valid_q` and the `replay_valid` table bits.\\n- Moved replay payload updates into a separate resetless clocked block. This leaves `replay_cand_pc_q`, `replay_cand_instr_q`, `replay_tag_hi`, and `replay_instr` behind their existing valid-bit protection.\\n- Preserved the existing live-imem priority, fill-bypass behavior, compressed replay tags, and full current-PC replay candidate guard.\\n- Updated the IF/ID replay comment in `rtl/core_pkg.sv` to document the resetless replay-candidate payload.\\n\\n## Deviations\\n\\n- No functional deviations from the hypothesis. The implementation uses a separate resetless payload block so synthesis does not need reset fanout or reset-driven hold muxing on the candidate PC/instruction payload flops.\\n\\n## Concerns\\n\\n- No known correctness concerns. During reset, replay payload contents may be arbitrary or continue updating, but replay selection remains blocked by `replay_cand_valid_q == 0` and the replay table valid bits are cleared.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh` from the worktree was blocked before checks ran because `formal/riscv-formal` is a symlink outside the writable sandbox and the script's staging cleanup uses `rm -f` there.\\n- To run the same gate without modifying the protected formal tree, I copied the formal harness to `/tmp/formal-run.8xxSkF`, symlinked its `rtl/` back to this worktree, and ran the unmodified copied `run_all.sh` there.\\n- Temporary-harness formal result: `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T07:15:06.858912\", \"slot\": 0, \"round_id\": 16}\n48:{\"id\": \"hyp-20260428-041-r16s1\", \"title\": \"Same-Cycle Store Slot Refill\", \"category\": \"structural\", \"motivation\": \"The current best core already has the two structural wins that matter most:\\nregistered instruction replay hides many random iStall cycles, and the\\none-deep pending-store slot lets a stalled normal-RAM store retire before\\nthe external dmem write is accepted. The remaining store-side bottleneck is\\nnarrower than a full second buffer entry. When the pending slot is valid, the\\nMEM stage currently treats every younger memory operation as blocked even on\\nthe exact cycle where `io_dmemReady` will drain the older buffered store.\\n\\nThat leaves a small but avoidable bubble for bursts of normal-RAM stores:\\nthe older store uses the physical dmem port, while the younger store already\\nhas its address, replicated data, byte mask, and RVFI-visible memory fields\\navailable in MEM and could refill the just-drained slot. A previous\\ntwo-entry FIFO targeted the same store-burst pressure but failed placement.\\nThe existing `store_slot` state machine already supports simultaneous drain\\nand enqueue, so the lower-risk structural angle is to expose that fast refill\\ncase without adding another entry or touching the IF replay path.\\n\", \"hypothesis\": {\"motivation\": \"The current best core already has the two structural wins that matter most:\\nregistered instruction replay hides many random iStall cycles, and the\\none-deep pending-store slot lets a stalled normal-RAM store retire before\\nthe external dmem write is accepted. The remaining store-side bottleneck is\\nnarrower than a full second buffer entry. When the pending slot is valid, the\\nMEM stage currently treats every younger memory operation as blocked even on\\nthe exact cycle where `io_dmemReady` will drain the older buffered store.\\n\\nThat leaves a small but avoidable bubble for bursts of normal-RAM stores:\\nthe older store uses the physical dmem port, while the younger store already\\nhas its address, replicated data, byte mask, and RVFI-visible memory fields\\navailable in MEM and could refill the just-drained slot. A previous\\ntwo-entry FIFO targeted the same store-burst pressure but failed placement.\\nThe existing `store_slot` state machine already supports simultaneous drain\\nand enqueue, so the lower-risk structural angle is to expose that fast refill\\ncase without adding another entry or touching the IF replay path.\\n\", \"hypothesis\": \"Allow a legal, aligned normal-RAM store in MEM to enqueue into the pending\\nstore slot on the same cycle that an older slot entry drains\\n(`store_slot_valid && io_dmemReady`). The top-level dmem port still gives the\\nolder slot entry priority for that cycle. The younger store retires once\\nthrough MEM/WB with its normal RVFI `mem_addr`, `mem_wmask`, and `mem_wdata`,\\nand the slot remains valid with the younger store's physical drain fields for\\na later external write.\\n\\nKeep all existing ordering constraints. If the slot is valid and the port is\\nnot ready, younger memory operations still wait. Loads, MMIO/marker/UART\\nstores, misaligned stores, illegal/trapping accesses, and any non-normal-RAM\\nstore still wait behind the slot and never enter it. If the slot is empty,\\nthe current direct ready-store path and low-ready enqueue path remain\\nunchanged. Younger non-memory instructions continue to pass while a buffered\\nstore drains, as they do today.\\n\\nThis should recover part of the store-burst stall cycles that motivated the\\nfailed two-entry FIFO, but with almost no additional placement pressure:\\nonly the MEM-stage enqueue/wait predicate changes, and the existing one-entry\\nslot already implements the simultaneous drain-plus-enqueue update. The\\ntop-level IO, RVFI NRET=2 channel layout, strict channel-0 order sequence,\\ntied-off channel 1, registered IF replay predictor, divider interlock, branch\\nprediction, and decoder legality invariants remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/mem_stage.sv\", \"description\": \"Refine pending-store backpressure so a bufferable normal-RAM store can\\nenqueue when the existing slot is valid and `dmem_ready` is high, because\\nthe older slot entry is draining on that same cycle. Preserve the direct\\nready-store path when the slot is empty, the existing low-ready enqueue\\npath when the slot is empty and the port stalls, and full waits for\\nloads, nonbufferable stores, MMIO/marker/UART stores, traps, and memory\\noperations behind a non-draining valid slot.\\n\"}, {\"file\": \"rtl/store_slot.sv\", \"description\": \"Keep the one-entry slot state machine, but document and, if needed,\\ntighten the simultaneous drain-plus-enqueue behavior so a draining older\\nstore can be replaced by a younger bufferable store in the same clock\\nedge. The slot still holds only physical drain fields; RVFI metadata\\nremains retired through MEM/WB on the enqueue cycle.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Preserve the current top-level dmem arbitration with pending-slot\\npriority while valid. Update comments or local naming only if needed to\\nmake clear that `store_slot_valid && io_dmemReady` represents available\\nenqueue capacity after the older store drains, without changing the core\\nmodule IO, RVFI ports, IF replay wiring, or channel-1 tie-off.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/mem_stage.sv\", \"description\": \"Refine pending-store backpressure so a bufferable normal-RAM store can\\nenqueue when the existing slot is valid and `dmem_ready` is high, because\\nthe older slot entry is draining on that same cycle. Preserve the direct\\nready-store path when the slot is empty, the existing low-ready enqueue\\npath when the slot is empty and the port stalls, and full waits for\\nloads, nonbufferable stores, MMIO/marker/UART stores, traps, and memory\\noperations behind a non-draining valid slot.\\n\"}, {\"file\": \"rtl/store_slot.sv\", \"description\": \"Keep the one-entry slot state machine, but document and, if needed,\\ntighten the simultaneous drain-plus-enqueue behavior so a draining older\\nstore can be replaced by a younger bufferable store in the same clock\\nedge. The slot still holds only physical drain fields; RVFI metadata\\nremains retired through MEM/WB on the enqueue cycle.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Preserve the current top-level dmem arbitration with pending-slot\\npriority while valid. Update comments or local naming only if needed to\\nmake clear that `store_slot_valid && io_dmemReady` represents available\\nenqueue capacity after the older store drains, without changing the core\\nmodule IO, RVFI ports, IF replay wiring, or channel-1 tie-off.\\n\"}], \"outcome\": \"placement_failed\", \"formal_passed\": true, \"cosim_passed\": true, \"error\": \"placement_failed\", \"seeds\": [null, null, null], \"slot\": 1, \"round_id\": 16}\n49:{\"id\": \"hyp-20260428-042-r16s2\", \"title\": \"Replay-Cached Next-PC Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best predictor is the compressed, resetless registered\\nlookahead instruction replay table. It keeps the large random-iStall cycle\\nwin of the 256-entry replay cache while avoiding a same-cycle table lookup\\non the IF decision path. Later predictor experiments show that adding new\\nbranch-direction tables, return predictors, victim entries, or wider replay\\nlines either saves very few cycles or loses more Fmax than it recovers.\\n\\nThe remaining promising predictor work is therefore inside the replay path\\nthat already wins. On a replay hit, the IF stage currently feeds the cached\\ninstruction word back through the same static branch/JAL decode and target\\nadders used for live imem data. That means an external imem stall served by\\nreplay still has a flop-to-flop path from `replay_cand_instr_q` through\\nbranch/JAL immediate reconstruction, target adders, the next-PC mux, and the\\nPC register. The replay table already knows the instruction for that PC from\\nan earlier live fetch, so its static next-PC prediction can be cached at fill\\ntime and replayed as metadata instead of recomputed in the hot stall path.\\n\", \"hypothesis\": {\"motivation\": \"The current best predictor is the compressed, resetless registered\\nlookahead instruction replay table. It keeps the large random-iStall cycle\\nwin of the 256-entry replay cache while avoiding a same-cycle table lookup\\non the IF decision path. Later predictor experiments show that adding new\\nbranch-direction tables, return predictors, victim entries, or wider replay\\nlines either saves very few cycles or loses more Fmax than it recovers.\\n\\nThe remaining promising predictor work is therefore inside the replay path\\nthat already wins. On a replay hit, the IF stage currently feeds the cached\\ninstruction word back through the same static branch/JAL decode and target\\nadders used for live imem data. That means an external imem stall served by\\nreplay still has a flop-to-flop path from `replay_cand_instr_q` through\\nbranch/JAL immediate reconstruction, target adders, the next-PC mux, and the\\nPC register. The replay table already knows the instruction for that PC from\\nan earlier live fetch, so its static next-PC prediction can be cached at fill\\ntime and replayed as metadata instead of recomputed in the hot stall path.\\n\", \"hypothesis\": \"Extend each instruction replay-table entry with compact static next-PC\\nprediction metadata: a predicted-taken bit and a predicted target or\\npredicted next-PC value computed from the live `io_imemData` and current PC\\nwhen the entry is filled. The existing instruction word, compressed high-PC\\ntag, valid bit, live-imem-first policy, resetless payload arrays, registered\\nlookahead candidate, and same-index fill bypass remain in place.\\n\\nWhen `io_imemReady=1`, IF still uses the live instruction word and the\\ncurrent static backward-branch/direct-JAL predictor exactly as it does\\ntoday; this preserves the formal-ready path and keeps live imem authoritative.\\nThe replay entry is refreshed with the live instruction plus the computed\\nmetadata. When `io_imemReady=0` and the registered replay candidate hits the\\ncurrent PC, IF should use the registered metadata to drive `predicted_taken`,\\n`predicted_target`, and the PC update, while still passing the cached\\ninstruction word into decode. Replay misses keep the current PC-hold and\\nIF-bubble behavior.\\n\\nThis should be bit-equivalent for all replayed instructions because the\\ncached metadata is just the current static predictor result computed at the\\nprevious live fetch of the same immutable instruction word. EX still checks\\nthe carried prediction against the resolved next PC, so any branch outcome\\nmismatch is repaired exactly as today. The expected gain is a modest Fmax\\nimprovement by removing branch/JAL immediate decode and target-add work from\\nthe replay-hit PC update path, with no intended CoreMark cycle-count change\\nand no top-level IO, RVFI, divider, memory, or retirement-contract changes.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add replay-table metadata arrays and registered candidate fields for the\\nstatic next-PC prediction associated with each cached instruction. Fill\\nthem on live `io_imemReady` fetches using the same backward-branch and\\ndirect-JAL prediction rule currently computed from `fetch_instr`. On a\\nreplay hit during an external imem stall, bypass the instruction decode\\nand target adders for PC prediction by using the registered metadata to\\ndrive `predicted_taken`, `predicted_target`, and `next_pc`. Keep live\\nimem cycles on the existing live decode path, preserve compressed replay\\ntags, resetless payload arrays, valid-bit reset, fill bypass, redirect\\npriority, `fetch_ready` semantics, and replay-miss stalls.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify the IF/ID prediction comments to state that replayed\\ninstructions may carry precomputed static next-PC metadata from the\\nregistered replay predictor, while live imem instructions still compute\\nprediction metadata directly from the live word. Do not change bundle\\nwidths, architectural state, decoder legality defaults, RVFI fields,\\ntop-level IO, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add replay-table metadata arrays and registered candidate fields for the\\nstatic next-PC prediction associated with each cached instruction. Fill\\nthem on live `io_imemReady` fetches using the same backward-branch and\\ndirect-JAL prediction rule currently computed from `fetch_instr`. On a\\nreplay hit during an external imem stall, bypass the instruction decode\\nand target adders for PC prediction by using the registered metadata to\\ndrive `predicted_taken`, `predicted_target`, and `next_pc`. Keep live\\nimem cycles on the existing live decode path, preserve compressed replay\\ntags, resetless payload arrays, valid-bit reset, fill bypass, redirect\\npriority, `fetch_ready` semantics, and replay-miss stalls.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify the IF/ID prediction comments to state that replayed\\ninstructions may carry precomputed static next-PC metadata from the\\nregistered replay predictor, while live imem instructions still compute\\nprediction metadata directly from the live word. Do not change bundle\\nwidths, architectural state, decoder legality defaults, RVFI fields,\\ntop-level IO, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 476.16, \"delta_pct\": -5.83, \"vs_baseline\": 58.17, \"fmax_mhz\": 164.72, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5955, \"ff\": 2228, \"seeds\": [164.72, 162.5, 165.98], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes\\n\\n- Extended the IF replay table with resetless static prediction metadata arrays:\\n  `replay_pred_taken` and `replay_pred_next_pc`.\\n- Added registered lookahead candidate fields for the replay metadata, including\\n  same-index fill bypass alongside the existing instruction bypass.\\n- Split IF static prediction so live imem cycles compute prediction from\\n  `imem_data` and `pc`, while replay-hit cycles select the registered metadata\\n  instead of decoding `replay_cand_instr_q` for branch/JAL immediates.\\n- Kept live imem authoritative: when `imem_ready` is high, IF uses the live\\n  instruction word and live-computed prediction metadata.\\n- Updated `core_pkg.sv` comments to describe live-computed versus replay-cached\\n  IF prediction metadata without changing bundle widths.\\n\\n## Deviations\\n\\n- The replay table stores predicted next PC rather than a separate target value.\\n  This matches the hypothesis allowance for either target or next-PC metadata and\\n  avoids recomputing the not-taken `pc+4` value on replay hits.\\n- The metadata is computed as the ungated static prediction at fill time. Runtime\\n  `flush`, `redirect`, and `stall` gating is still applied when metadata is used,\\n  preserving the previous IF behavior while avoiding stale false predictions from\\n  entries filled during a pipeline stall.\\n\\n## Concerns\\n\\n- The change adds 33 metadata bits per replay entry. This is intentional for the\\n  requested Fmax tradeoff and does not alter top-level IO, RVFI, decode legality,\\n  memory, divider, or retirement contracts.\\n- No known behavioral concerns. Replay misses still hold PC and bubble IF through\\n  the existing `fetch_ready` path.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- Direct `bash formal/run_all.sh` in the worktree could not stage files because\\n  `formal/riscv-formal` is a symlink outside the writable sandbox; the script\\n  failed before generating checks with `Operation not permitted` on the stale\\n  staged `.sv` cleanup.\\n- Equivalent local formal run from a writable `/tmp` copy of the project and\\n  riscv-formal framework: pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T07:19:06.776737\", \"slot\": 2, \"round_id\": 16}\n50:{\"id\": \"hyp-20260428-043-r17s0\", \"title\": \"RTL-Only Hot/Cold ALU Opcode Split\", \"category\": \"micro_opt\", \"motivation\": \"The current best core has already removed the cold DIV/REM arithmetic from\\nthe universal EX path and gained another large timing win from trimming the\\nregistered instruction replay metadata. The remaining micro-opt opportunity\\nshould therefore avoid new queues, predictors, reset rewrites, or\\nmulti-cycle units, and instead reshape logic that is already on the hot\\none-cycle EX datapath.\\n\\n`rtl/alu.sv` still uses a dense ALU operation encoding and a single broad\\nresult case for the common RV32I operations, the single-cycle multiply\\nresults, and dummy DIV/REM results that are now supplied by `div_unit.sv`.\\nThe two previous hot/cold ALU hypotheses never produced architectural data\\nbecause their implementations were rejected for touching an off-limits test\\nhelper, not because the RTL idea failed formal, cosim, or FPGA placement.\\nThe source still has the same dense opcode/mux shape, so this remains the\\ncleanest unevaluated micro-opt angle.\\n\", \"hypothesis\": {\"motivation\": \"The current best core has already removed the cold DIV/REM arithmetic from\\nthe universal EX path and gained another large timing win from trimming the\\nregistered instruction replay metadata. The remaining micro-opt opportunity\\nshould therefore avoid new queues, predictors, reset rewrites, or\\nmulti-cycle units, and instead reshape logic that is already on the hot\\none-cycle EX datapath.\\n\\n`rtl/alu.sv` still uses a dense ALU operation encoding and a single broad\\nresult case for the common RV32I operations, the single-cycle multiply\\nresults, and dummy DIV/REM results that are now supplied by `div_unit.sv`.\\nThe two previous hot/cold ALU hypotheses never produced architectural data\\nbecause their implementations were rejected for touching an off-limits test\\nhelper, not because the RTL idea failed formal, cosim, or FPGA placement.\\nThe source still has the same dense opcode/mux shape, so this remains the\\ncleanest unevaluated micro-opt angle.\\n\", \"hypothesis\": \"Re-encode the ALU operation constants so `alu_op[4]` is an explicit\\nM-extension discriminator. Keep every RV32I/simple operation at\\n`op[4]=0`, and move `MUL`, `MULH`, `MULHSU`, `MULHU`, `DIV`, `DIVU`,\\n`REM`, and `REMU` to `op[4]=1`, preferably `5'b10000` through\\n`5'b10111` in RV32M funct3 order.\\n\\nRefactor `rtl/alu.sv` into two local result muxes. The hot simple mux covers\\nADD/SUB, logic, compare, shift, and LUI only. The cold M mux covers the\\nexisting multiply results and the existing dummy zero result for DIV/REM\\nopcodes handled by the iterative divider. Drive the final ALU output with a\\nsingle `op[4] ? m_out : simple_out` select.\\n\\nThis does not change any arithmetic primitive, instruction latency,\\nforwarding path, branch predictor, memory behavior, divider protocol,\\ntop-level IO, RVFI field, retirement order, or CoreMark cycle count. The\\nRISCV_FORMAL_ALTOPS multiply substitutions stay in the cold M mux under the\\nnew constants, while divide/remainder ALTOPS behavior remains in\\n`div_unit.sv`. The expected benefit is a modest median Fmax improvement from\\nreducing decode and result-mux depth on the common RV32I EX result path.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Reassign ALU_MUL through ALU_REMU to an `op[4]=1` encoding, preferably\\ncontiguous values `5'b10000` through `5'b10111` matching RV32M funct3\\norder. Keep all ADD/SUB/logic/compare/shift/LUI operations at\\n`op[4]=0`. Do not change bundle widths, RVFI fields, architectural\\nstate, decoder legality defaults, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/alu.sv\", \"description\": \"Split the single broad ALU result case into `simple_out` and `m_out`\\nsub-muxes. `simple_out` should cover only the RV32I hot path. `m_out`\\nshould reuse the existing MUL/MULH/MULHU/MULHSU arithmetic and ALTOPS\\nformulas, while DIV/DIVU/REM/REMU continue to return zero because the\\niterative divider supplies their real result. Select the final output\\nonly with `op[4]`.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Reassign ALU_MUL through ALU_REMU to an `op[4]=1` encoding, preferably\\ncontiguous values `5'b10000` through `5'b10111` matching RV32M funct3\\norder. Keep all ADD/SUB/logic/compare/shift/LUI operations at\\n`op[4]=0`. Do not change bundle widths, RVFI fields, architectural\\nstate, decoder legality defaults, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/alu.sv\", \"description\": \"Split the single broad ALU result case into `simple_out` and `m_out`\\nsub-muxes. `simple_out` should cover only the RV32I hot path. `m_out`\\nshould reuse the existing MUL/MULH/MULHU/MULHSU arithmetic and ALTOPS\\nformulas, while DIV/DIVU/REM/REMU continue to return zero because the\\niterative divider supplies their real result. Select the final output\\nonly with `op[4]`.\\n\"}], \"outcome\": \"improvement\", \"fitness\": 529.35, \"delta_pct\": 4.69, \"vs_baseline\": 75.84, \"fmax_mhz\": 183.12, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5930, \"ff\": 2235, \"seeds\": [192.01, 171.94, 183.12], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes made\\n\\n- Re-encoded the RV32M ALU constants in `rtl/core_pkg.sv` so all M-extension\\n  operations have `alu_op[4] = 1`.\\n- Assigned the M-extension constants contiguously as `5'b10000` through\\n  `5'b10111`, matching RV32M `funct3` order:\\n  `MUL`, `MULH`, `MULHSU`, `MULHU`, `DIV`, `DIVU`, `REM`, `REMU`.\\n- Refactored `rtl/alu.sv` from one broad result `case` into two local result\\n  muxes:\\n  - `simple_out` covers ADD/SUB, logic, compare, shifts, and LUI.\\n  - `m_out` covers multiply results plus the existing zero result for\\n    DIV/DIVU/REM/REMU, whose real result still comes from `div_unit.sv`.\\n- The final ALU result is selected only by `op[4] ? m_out : simple_out`.\\n\\n## Deviations\\n\\n- No architectural or pipeline behavior was changed.\\n- No bundle widths, RVFI fields, decoder legality defaults, divider protocol,\\n  forwarding behavior, retirement order, top-level IO, or test/eval files were\\n  changed.\\n- `bash formal/run_all.sh` could not run directly in this sandbox because\\n  `formal/riscv-formal` is a symlink to a shared tree outside the writable\\n  worktree, and the script's staging cleanup hit `Operation not permitted`.\\n  I ran the unmodified script from a temporary writable copy of the project\\n  instead.\\n\\n## Concerns\\n\\n- None known. The change is intentionally limited to ALU op encoding and ALU\\n  result mux shape.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked in-place by sandbox permissions before any\\n  proof ran.\\n- Equivalent local formal self-check from temporary writable staging copy:\\n  pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T07:32:03.632312\", \"slot\": 0, \"round_id\": 17}\n51:{\"id\": \"hyp-20260428-044-r17s1\", \"title\": \"Tiny MRU Load Replay Latch\", \"category\": \"structural\", \"motivation\": \"The current best core already uses the two structural ideas that have paid\\nclearly: a one-deep pending-store slot for store-only dmem backpressure and\\na registered instruction replay table for random iStall. The remaining\\nstructural stalls are concentrated on normal-RAM loads. A load still freezes\\nthe whole in-order pipeline whenever io_dmemReady is low, even if the same\\naligned word was returned recently.\\n\\nThe prior 16-entry MEM-stage load replay buffer showed that this stall source\\nis real: it reduced CoreMark cycles on top of the instruction replay design.\\nIt missed the current best because the same-cycle table lookup, tag compare,\\nand store-update logic dropped Fmax too much. A much smaller MRU replay latch\\ntargets the same dmem-stall opportunity while keeping the MEM path close to\\nthe current best design.\\n\", \"hypothesis\": {\"motivation\": \"The current best core already uses the two structural ideas that have paid\\nclearly: a one-deep pending-store slot for store-only dmem backpressure and\\na registered instruction replay table for random iStall. The remaining\\nstructural stalls are concentrated on normal-RAM loads. A load still freezes\\nthe whole in-order pipeline whenever io_dmemReady is low, even if the same\\naligned word was returned recently.\\n\\nThe prior 16-entry MEM-stage load replay buffer showed that this stall source\\nis real: it reduced CoreMark cycles on top of the instruction replay design.\\nIt missed the current best because the same-cycle table lookup, tag compare,\\nand store-update logic dropped Fmax too much. A much smaller MRU replay latch\\ntargets the same dmem-stall opportunity while keeping the MEM path close to\\nthe current best design.\\n\", \"hypothesis\": \"Add a two-entry most-recently-used normal-RAM load replay latch in MEM. Each\\nentry stores a valid bit, an aligned word address tag, and the raw 32-bit word\\nreturned by a previously accepted legal normal-RAM load. On io_dmemReady=1,\\nloads keep using live io_dmemRData exactly as today and update the MRU latch\\nwith the aligned word and raw data. On io_dmemReady=0, a valid legal\\nnormal-RAM load may complete from the latch if either entry matches the\\naligned word address: suppress dmem_ren, use the cached raw word for\\nsign/zero extension and RVFI mem_rdata, and do not assert mem_wait.\\n\\nReplay remains conservative. It is disabled while the pending store slot is\\nvalid, for MMIO/marker/UART addresses, for misaligned or trapping accesses,\\nand for stores. Normal-RAM stores byte-merge any matching replay entry before\\nthey retire or enqueue into the pending-store slot; if a simple merge is not\\navailable for a corner case, invalidating the matching entry is acceptable.\\nReplay misses preserve the current dmem wait behavior exactly.\\n\\nThis is a structural latency-hiding change, not a MEM-to-EX bypass. Cached\\ndata is consumed only at the MEM retirement boundary, dependent younger\\ninstructions still use the existing load-use discipline, and the top-level IO,\\nRVFI NRET=2 channel layout, channel-0-only retirement order, divider\\ninterlock, registered IF replay predictor, branch prediction, pending-store\\nordering, and decoder legality invariants remain unchanged. The expected win\\nis a small cycle reduction from repeated normal-RAM loads during random\\ndmem stalls with much less Fmax cost than the earlier 16-entry load replay\\ntable.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_mru_replay.sv\", \"description\": \"Add a tiny two-entry MRU replay latch for normal-RAM load words. Entries\\nhold valid, aligned word address tag, and raw 32-bit data. Provide lookup\\nhit/data for the current MEM load, update from accepted live load\\nresponses, and byte-merge or invalidate matching entries on legal\\nnormal-RAM stores. Reset clears only valid bits.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Integrate the MRU replay lookup into load handling. Select cached raw word\\ndata only when dmem_ready is low, the current access is a valid legal\\nnormal-RAM load, no pending store slot is valid, and the latch hits. On a\\nhit, gate off dmem_ren, clear mem_wait, and drive load extraction plus\\nRVFI mem_rdata from the cached word. Keep replay misses and all\\nnonbufferable accesses on the existing wait path.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only comments or compact helper typedefs if useful to document the\\nMRU load replay eligibility and raw-word metadata. Do not change\\narchitectural state semantics, decoder legality defaults, RVFI field\\nwidths, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_mru_replay.sv\", \"description\": \"Add a tiny two-entry MRU replay latch for normal-RAM load words. Entries\\nhold valid, aligned word address tag, and raw 32-bit data. Provide lookup\\nhit/data for the current MEM load, update from accepted live load\\nresponses, and byte-merge or invalidate matching entries on legal\\nnormal-RAM stores. Reset clears only valid bits.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Integrate the MRU replay lookup into load handling. Select cached raw word\\ndata only when dmem_ready is low, the current access is a valid legal\\nnormal-RAM load, no pending store slot is valid, and the latch hits. On a\\nhit, gate off dmem_ren, clear mem_wait, and drive load extraction plus\\nRVFI mem_rdata from the cached word. Keep replay misses and all\\nnonbufferable accesses on the existing wait path.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only comments or compact helper typedefs if useful to document the\\nMRU load replay eligibility and raw-word metadata. Do not change\\narchitectural state semantics, decoder legality defaults, RVFI field\\nwidths, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 404.58, \"delta_pct\": -19.99, \"vs_baseline\": 34.39, \"fmax_mhz\": 139.0, \"ipc_coremark\": 3e-06, \"cycles\": 3435657, \"iterations\": 10, \"lut4\": 5909, \"ff\": 2224, \"seeds\": [139.0, 142.94, 131.86], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Added `rtl/load_mru_replay.sv`, a two-entry MRU latch for legal normal-RAM load words. Each entry tracks a valid bit, aligned word address tag, and raw 32-bit word data.\\n- Integrated the latch in `rtl/mem_stage.sv`.\\n  - Ready normal-RAM loads still use live `dmem_rdata` and fill the latch.\\n  - Stalled legal normal-RAM load hits suppress `dmem_ren`, clear `mem_wait`, and use cached raw data for load extraction and RVFI `mem_rdata`.\\n  - Replay is disabled while the pending-store slot is valid, and for stores, MMIO/marker/UART/OOB addresses, illegal accesses, and misaligned accesses.\\n  - Legal normal-RAM stores byte-merge matching latch entries when they retire or enqueue into the pending-store slot.\\n\\n## Deviations\\n\\n- No `core_pkg.sv` changes were needed; the replay eligibility stayed local to MEM.\\n- The implementation promotes an entry-1 replay hit to entry 0 so the two entries behave as a true MRU pair. This is a small sequential state update and does not add another table.\\n\\n## Concerns\\n\\n- No known functional concerns from lint or formal. The latch intentionally resets only valid bits; tags and data are ignored until valid.\\n- This still adds two 32-bit tag compares in the MEM decision path, so the final FPGA result will determine whether the small cycle win outweighs timing cost.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked before solver startup in this sandbox because `formal/riscv-formal` is a symlink to a shared checkout outside the writable worktree, and the script's staging cleanup could not remove stale files there (`Operation not permitted`).\\n- Equivalent local formal flow from a temporary writable mirror under `/tmp`, using the same `checks.cfg`, `wrapper.sv`, current `rtl/*.sv`, and riscv-formal framework files: pass, `105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T07:35:07.182987\", \"slot\": 1, \"round_id\": 17}\n52:{\"id\": \"hyp-20260428-045-r17s2\", \"title\": \"Registered Lookahead Agree Branch Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best predictor win is the compressed registered lookahead\\ninstruction replay table. It attacks random iStall cycles without putting a\\nsame-cycle replay lookup on the IF decision path. Other predictor attempts\\nshow the remaining tradeoff clearly: learned conditional-branch tables did\\nreduce CoreMark cycles, but their combinational IF table reads and EX update\\nrouting cost more Fmax than the saved redirects recovered. Return predictors\\nand replay capacity variants had the same problem or saved too few cycles.\\n\\nThe most promising predictor angle is therefore to revisit dynamic branch\\ndirection with the timing discipline that made instruction replay work.\\nKeep the existing static BTFNT plus direct-JAL predictor as the cold and\\ntarget-generation path, but move the learned direction-table lookup into a\\nregistered lookahead candidate for the next fetch PC. That preserves the\\ncurrent IF replay structure and avoids adding a current-cycle counter-array\\nread to the branch/JAL target and fetch-ready path.\\n\", \"hypothesis\": {\"motivation\": \"The current best predictor win is the compressed registered lookahead\\ninstruction replay table. It attacks random iStall cycles without putting a\\nsame-cycle replay lookup on the IF decision path. Other predictor attempts\\nshow the remaining tradeoff clearly: learned conditional-branch tables did\\nreduce CoreMark cycles, but their combinational IF table reads and EX update\\nrouting cost more Fmax than the saved redirects recovered. Return predictors\\nand replay capacity variants had the same problem or saved too few cycles.\\n\\nThe most promising predictor angle is therefore to revisit dynamic branch\\ndirection with the timing discipline that made instruction replay work.\\nKeep the existing static BTFNT plus direct-JAL predictor as the cold and\\ntarget-generation path, but move the learned direction-table lookup into a\\nregistered lookahead candidate for the next fetch PC. That preserves the\\ncurrent IF replay structure and avoids adding a current-cycle counter-array\\nread to the branch/JAL target and fetch-ready path.\\n\", \"hypothesis\": \"Add a small PC-indexed two-bit agree predictor for conditional branch\\ndirection, but read it one cycle ahead in IF. The table is indexed by the\\nsame selected next fetch PC used to maintain the registered instruction\\nreplay candidate. Each cycle registers the selected counter prediction for\\nthe PC expected to be current after the next clock edge. When IF later sees a\\nlegal aligned B-type branch at that PC, it combines the registered\\nagree/disagree bit with the existing static direction rule: cold counters\\nreset to strongly agree, so cold behavior is exactly the current backward\\ntaken / forward not-taken policy. Direct JAL prediction remains unchanged,\\nand JALR remains unpredicted.\\n\\nConditional branches update the agree table from EX when the branch advances\\ninto EX/MEM. The update trains toward whether the resolved branch outcome\\nagreed with the static direction for that branch PC, and is gated so dmem\\nholds cannot update the same branch repeatedly. Redirect recovery remains\\nthe existing resolved-next-PC mismatch check, so aliasing or a stale\\nregistered prediction can only cost redirect bubbles and cannot affect RVFI\\ncorrectness.\\n\\nThis targets the cycle-count signal seen in the earlier agree-predictor\\nexperiment while avoiding its biggest timing cost: the current-cycle IF\\ntable lookup. The design adds no BTB, RAS, replay capacity change, pipeline\\nstage, load-data bypass, top-level IO change, or retirement-width change.\\nThe existing registered IF replay predictor, pending-store slot, divider\\ninterlock, strict channel-0 RVFI order sequence, and tied-off channel 1\\nremain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a small two-bit agree-direction table, such as 64 entries indexed by\\nfetch PC bits, with counters reset to strongly agree. Read the selected\\ncounter into a registered lookahead prediction using the same next-PC\\npriority as the replay candidate: EX redirect target first, then the\\npredicted/fallthrough next PC when fetch advances, otherwise the held PC.\\nFor legal aligned B-type branches, combine the registered agree bit with\\nthe existing static direction rule to choose predicted_taken. Preserve\\ndirect-JAL prediction, JALR unpredicted behavior, compressed instruction\\nreplay tags, resetless replay payload arrays, live-imem priority,\\nreplay fill bypass, redirect priority, and fetch_ready semantics.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Emit one-cycle branch predictor update sideband signals for valid,\\nnon-misaligned conditional branches when EX/MEM is allowed to advance:\\nupdate_valid, update_pc, update_static_taken, and update_actual_taken.\\nKeep redirect generation based on resolved next PC versus the carried\\npredicted next PC, and do not change branch target calculation, trap\\nhandling, divider launch/completion, forwarding, or RVFI metadata.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the EX-stage conditional-branch update signals back to IF without\\nchanging the core module IO, RVFI NRET=2 field set, channel-0-only\\nsingle retirement convention, strict rvfi_order behavior, pending-store\\nslot arbitration, registered instruction replay wiring, or channel-1\\ntie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify the prediction metadata comments to document that conditional\\nbranch direction may come from a registered lookahead agree predictor,\\nwhile direct JAL and replayed instruction handling remain otherwise\\nunchanged. Do not change bundle widths, architectural state, decoder\\nlegality defaults, RVFI fields, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a small two-bit agree-direction table, such as 64 entries indexed by\\nfetch PC bits, with counters reset to strongly agree. Read the selected\\ncounter into a registered lookahead prediction using the same next-PC\\npriority as the replay candidate: EX redirect target first, then the\\npredicted/fallthrough next PC when fetch advances, otherwise the held PC.\\nFor legal aligned B-type branches, combine the registered agree bit with\\nthe existing static direction rule to choose predicted_taken. Preserve\\ndirect-JAL prediction, JALR unpredicted behavior, compressed instruction\\nreplay tags, resetless replay payload arrays, live-imem priority,\\nreplay fill bypass, redirect priority, and fetch_ready semantics.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Emit one-cycle branch predictor update sideband signals for valid,\\nnon-misaligned conditional branches when EX/MEM is allowed to advance:\\nupdate_valid, update_pc, update_static_taken, and update_actual_taken.\\nKeep redirect generation based on resolved next PC versus the carried\\npredicted next PC, and do not change branch target calculation, trap\\nhandling, divider launch/completion, forwarding, or RVFI metadata.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the EX-stage conditional-branch update signals back to IF without\\nchanging the core module IO, RVFI NRET=2 field set, channel-0-only\\nsingle retirement convention, strict rvfi_order behavior, pending-store\\nslot arbitration, registered instruction replay wiring, or channel-1\\ntie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify the prediction metadata comments to document that conditional\\nbranch direction may come from a registered lookahead agree predictor,\\nwhile direct JAL and replayed instruction handling remain otherwise\\nunchanged. Do not change bundle widths, architectural state, decoder\\nlegality defaults, RVFI fields, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 340.84, \"delta_pct\": -32.59, \"vs_baseline\": 13.22, \"fmax_mhz\": 115.73, \"ipc_coremark\": 3e-06, \"cycles\": 3395390, \"iterations\": 10, \"lut4\": 6327, \"ff\": 2368, \"seeds\": [115.73, 111.22, 121.67], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Registered Lookahead Agree Branch Predictor\\n\\n## What changed\\n\\n- Added a 64-entry PC-indexed two-bit agree predictor in `rtl/if_stage.sv`.\\n- The agree table resets counters to strongly agree (`2'b11`), so cold conditional-branch behavior remains the existing static backward-taken / forward-not-taken rule.\\n- IF reads the agree counter into a registered lookahead candidate using the same selected next-PC priority as the instruction replay candidate: EX redirect target, then predicted/fallthrough next PC when fetch advances, otherwise the held PC.\\n- Legal aligned B-type branches now combine the registered agree/disagree bit with the static direction rule. Direct JAL prediction and JALR-unpredicted behavior are unchanged.\\n- `rtl/ex_stage.sv` now emits one-cycle conditional-branch predictor update sideband signals when a valid non-misaligned branch is allowed to advance into EX/MEM.\\n- `rtl/core.sv` wires the EX update sideband back to IF without changing the top-level IO.\\n- `rtl/core_pkg.sv` comments now document that conditional branch direction may come from the registered lookahead agree predictor.\\n\\n## Deviations\\n\\n- The agree table uses 64 entries as suggested. It is direct-mapped and untagged; aliasing is intentionally handled by normal EX redirect recovery.\\n- Simultaneous update and lookahead read of the same agree-table entry uses the pre-update counter value for the registered candidate. This keeps the IF path simple and still only affects prediction quality.\\n- A Verilator `UNUSEDSIGNAL` pragma marks the unused high and low bits of `bp_update_pc` in IF, because the table intentionally indexes only `pc[7:2]`.\\n\\n## Concerns\\n\\n- Aliasing or a stale registered agree bit can train/predict the wrong direction, but any bad prediction is corrected by the existing resolved-next-PC mismatch redirect.\\n- The in-tree `bash formal/run_all.sh` could not stage files in this sandbox because `formal/riscv-formal` is a symlink to a protected path outside the writable worktree, causing `rm -f \\\"$CORE_DIR\\\"/*.sv` to fail with `Operation not permitted` before any checks ran.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked before checks by the sandbox staging issue described above.\\n- Equivalent formal run from a throwaway `/tmp` mirror of `formal/` and `rtl/`, using the same `run_all.sh`: pass, `105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T07:37:08.616973\", \"slot\": 2, \"round_id\": 17}\n53:{\"id\": \"hyp-20260428-046-r18s0\", \"title\": \"Source-Qualified Load-Use Interlock\", \"category\": \"micro_opt\", \"motivation\": \"The current best RTL has already harvested the high-leverage Fmax wins:\\nDIV/REM is cold and iterative, the IF replay predictor hides most random\\niStall loss, replay tags are compressed/resetless, the RVFI order counter is\\nsegmented, and the ALU result mux has a hot/cold split. The next micro-opt\\nshould therefore avoid new memories, predictors, queues, or arithmetic units.\\n\\nThe remaining always-present cycle loss in the control path is the\\nconservative load-use detector. It currently stalls whenever the load in\\nID/EX has a nonzero rd matching either raw rs1 or raw rs2 bitfield of the\\nIF/ID instruction. That is necessary for true consumers, but false for many\\nlegal RV32I encodings: OP-IMM, LOAD, and JALR do not read rs2; LUI, AUIPC,\\nJAL, FENCE, and EBREAK do not read either source. CoreMark has many pointer\\nupdates, immediate arithmetic, loads, and control instructions after loads,\\nso these false matches can still inject bubbles even after the instruction\\nreplay predictor improves frontend availability.\\n\", \"hypothesis\": {\"motivation\": \"The current best RTL has already harvested the high-leverage Fmax wins:\\nDIV/REM is cold and iterative, the IF replay predictor hides most random\\niStall loss, replay tags are compressed/resetless, the RVFI order counter is\\nsegmented, and the ALU result mux has a hot/cold split. The next micro-opt\\nshould therefore avoid new memories, predictors, queues, or arithmetic units.\\n\\nThe remaining always-present cycle loss in the control path is the\\nconservative load-use detector. It currently stalls whenever the load in\\nID/EX has a nonzero rd matching either raw rs1 or raw rs2 bitfield of the\\nIF/ID instruction. That is necessary for true consumers, but false for many\\nlegal RV32I encodings: OP-IMM, LOAD, and JALR do not read rs2; LUI, AUIPC,\\nJAL, FENCE, and EBREAK do not read either source. CoreMark has many pointer\\nupdates, immediate arithmetic, loads, and control instructions after loads,\\nso these false matches can still inject bubbles even after the instruction\\nreplay predictor improves frontend availability.\\n\", \"hypothesis\": \"Refine the load-use interlock so it only compares the ID/EX load destination\\nagainst source operands that the IF/ID instruction actually reads. Add a\\nsmall source-use predecode in the hazard path with conservative defaults:\\nrs1 is used by OP, OP-IMM, LOAD, STORE, BRANCH, and JALR; rs2 is used by OP,\\nSTORE, and BRANCH; LUI, AUIPC, JAL, FENCE, and the exact EBREAK encoding are\\nsource-free. Unknown opcodes and reserved/unclear SYSTEM encodings remain\\nconservative and are treated as using both raw source fields so illegal-trap\\nRVFI behavior is not weakened.\\n\\nGate the predicate with both stage valid bits: a bubble in ID/EX is not a\\nload producer, and an invalid IF/ID payload has no consumer sources. True\\nload-use dependencies keep the exact existing one-cycle bubble, including\\nload-to-store address dependencies and load-to-branch comparisons. The change\\ndoes not add a MEM-to-EX data path, alter forwarding, change memory ordering,\\ntouch the IF replay predictor, change the divider interlock, or modify any\\nRVFI field or top-level IO. The expected benefit is a small CoreMark cycle\\nreduction with limited Fmax risk because the added logic is only a compact\\nopcode/source-use filter in the existing hazard predicate.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Replace the raw rs1-or-rs2 load-use comparison with a source-qualified\\npredicate. Add inputs for IF/ID valid, ID/EX valid, and the IF/ID\\ninstruction or opcode/funct fields. Compute uses_rs1 and uses_rs2 from\\nthe opcode with conservative handling for unknown or unclear encodings,\\nand stall only when the load rd matches a source that is actually read.\\nPreserve the existing imem replay readiness, redirect flush, dmem wait,\\nEX long-operation, EX/MEM hold, and MEM/WB hold behavior.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire IF/ID valid, ID/EX valid, and the IF/ID instruction or needed\\nopcode/funct fields into the hazard unit. Keep the core module IO, RVFI\\nNRET=2 port set, channel-0-only retirement behavior, strict rvfi_order\\nsequence, registered IF replay wiring, pending-store-slot arbitration,\\nand tied-off channel 1 unchanged.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Replace the raw rs1-or-rs2 load-use comparison with a source-qualified\\npredicate. Add inputs for IF/ID valid, ID/EX valid, and the IF/ID\\ninstruction or opcode/funct fields. Compute uses_rs1 and uses_rs2 from\\nthe opcode with conservative handling for unknown or unclear encodings,\\nand stall only when the load rd matches a source that is actually read.\\nPreserve the existing imem replay readiness, redirect flush, dmem wait,\\nEX long-operation, EX/MEM hold, and MEM/WB hold behavior.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire IF/ID valid, ID/EX valid, and the IF/ID instruction or needed\\nopcode/funct fields into the hazard unit. Keep the core module IO, RVFI\\nNRET=2 port set, channel-0-only retirement behavior, strict rvfi_order\\nsequence, registered IF replay wiring, pending-store-slot arbitration,\\nand tied-off channel 1 unchanged.\\n\"}], \"outcome\": \"regression\", \"fitness\": 365.3, \"delta_pct\": -30.99, \"vs_baseline\": 21.35, \"fmax_mhz\": 126.37, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5997, \"ff\": 2240, \"seeds\": [126.37, 131.89, 117.63], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Source-Qualified Load-Use Interlock\\n\\n## What changed\\n\\n- Added `rtl/source_use_decode.sv`, a compact shared predecode for architectural source usage.\\n- Updated `rtl/hazard_unit.sv` so load-use stalls require:\\n  - a valid ID/EX load producer,\\n  - a valid IF/ID consumer,\\n  - a nonzero matching load destination,\\n  - and a match only against source operands the IF/ID instruction actually reads.\\n- Updated `rtl/core.sv` to wire IF/ID and ID/EX valid bits plus the IF/ID instruction into the hazard unit.\\n- Added a MEM-stage RVFI source-data repair path from the current WB value. This keeps the core's existing raw RVFI source-address convention intact for cosim while ensuring a false raw source match behind a load still reports the current architectural source data.\\n- Qualified EX/MEM forwarding so loads are not forwarded from EX/MEM. True load consumers still wait for the existing load-use bubble and receive data from MEM/WB; this prevents false consumers from recording a load address as raw RVFI source data.\\n\\n## Deviations\\n\\n- I added a small `source_use_decode` module instead of open-coding the opcode mask directly inside `hazard_unit`.\\n- I kept raw RVFI source addresses because the existing cosim reference compares them directly for every instruction. Instead of masking unused sources to x0/0, `mem_stage` repairs raw source data from the immediately older WB instruction when needed. This affects RVFI metadata only; it does not feed EX operands or add a load-data bypass for execution.\\n- EX/MEM forwarding for loads is now explicitly disabled. The old forwarding select was harmless only because the conservative load-use interlock kept true consumers away from that path; after source qualification, false consumers can reach EX while a load is in MEM, so forwarding the load address would corrupt raw RVFI source metadata.\\n\\n## Concerns\\n\\n- No known functional concerns after lint, formal, and cosim.\\n- The added source-use decode is combinational in the existing hazard path. The MEM-stage RVFI repair adds small compare/mux logic on source metadata; FPGA timing will determine the actual Fmax impact.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- Direct `bash formal/run_all.sh`: blocked before solver startup because `formal/riscv-formal` is a symlink to a protected checkout outside the writable sandbox, and the script's staging cleanup failed with `Operation not permitted`.\\n- Equivalent formal run from `/tmp/codex-formal-hyp-20260428-046-r18s0`, using the same `run_all.sh`, `checks.cfg`, `wrapper.sv`, current `rtl/*.sv`, and riscv-formal framework files: pass, `105 passed, 0 failed`.\\n- `make cosim`: pass, `elfs_tested: 2`.\\n- Intermediate formal attempts failed `reg_ch0` on false raw source dependencies. The first counterexample showed stale raw source data behind a load; the second showed an AUIPC recording a misaligned load's address through EX/MEM forwarding. The WB-to-MEM metadata repair plus load-qualified EX/MEM forwarding fixed those failures while preserving raw RVFI source addresses.\\n\", \"timestamp\": \"2026-04-28T07:58:39.012355\", \"slot\": 0, \"round_id\": 18}\n54:{\"id\": \"hyp-20260428-047-r18s1\", \"title\": \"Decode-Exact Load-Use Interlock\", \"category\": \"structural\", \"motivation\": \"The current best core has strong timing wins from the registered instruction\\nreplay predictor, segmented RVFI order counter, pending-store slot, and\\nhot/cold ALU split. The remaining structural improvement should therefore\\navoid another cache, queue, predictor table, or load-data forwarding path that\\ncould disturb Fmax.\\n\\nThe load-use interlock is still structurally conservative. It stalls whenever\\na load in ID/EX has a nonzero destination matching either raw rs1 or raw rs2\\nbitfield of the IF/ID instruction. That is correct for true consumers, but it\\ncreates false bubbles for instructions where one or both fields are not\\nsource operands: OP-IMM and LOAD do not read rs2, JAL/LUI/AUIPC read neither,\\nFENCE/EBREAK read neither, and JALR reads only rs1. CoreMark's optimized code\\nhas dense immediate arithmetic, address-generation loads, calls, and loop\\ncontrol, so these false one-cycle bubbles are a plausible remaining IPC loss.\\n\\nA prior operand-aware interlock attempt broke selftest, so this hypothesis is\\ndeliberately conservative: decode source-use exactly for known legal\\ninstruction classes, keep reserved or unknown encodings on the current\\nboth-source stall policy, and do not add any MEM-to-EX load-data path. The\\ngoal is to recover only provably false load-use stalls while leaving all true\\nload consumers, dmem waits, branch recovery, divider interlocks, and RVFI\\nordering unchanged.\\n\", \"hypothesis\": {\"motivation\": \"The current best core has strong timing wins from the registered instruction\\nreplay predictor, segmented RVFI order counter, pending-store slot, and\\nhot/cold ALU split. The remaining structural improvement should therefore\\navoid another cache, queue, predictor table, or load-data forwarding path that\\ncould disturb Fmax.\\n\\nThe load-use interlock is still structurally conservative. It stalls whenever\\na load in ID/EX has a nonzero destination matching either raw rs1 or raw rs2\\nbitfield of the IF/ID instruction. That is correct for true consumers, but it\\ncreates false bubbles for instructions where one or both fields are not\\nsource operands: OP-IMM and LOAD do not read rs2, JAL/LUI/AUIPC read neither,\\nFENCE/EBREAK read neither, and JALR reads only rs1. CoreMark's optimized code\\nhas dense immediate arithmetic, address-generation loads, calls, and loop\\ncontrol, so these false one-cycle bubbles are a plausible remaining IPC loss.\\n\\nA prior operand-aware interlock attempt broke selftest, so this hypothesis is\\ndeliberately conservative: decode source-use exactly for known legal\\ninstruction classes, keep reserved or unknown encodings on the current\\nboth-source stall policy, and do not add any MEM-to-EX load-data path. The\\ngoal is to recover only provably false load-use stalls while leaving all true\\nload consumers, dmem waits, branch recovery, divider interlocks, and RVFI\\nordering unchanged.\\n\", \"hypothesis\": \"Add a small decode-light source-use classifier for the IF/ID instruction and\\nuse it in the load-use hazard predicate. A load in ID/EX should stall the next\\ninstruction only when the next instruction is valid and actually reads the\\nmatching source:\\n\\n- rs1 is used by OP, OP-IMM, LOAD, STORE, BRANCH, and legal JALR.\\n- rs2 is used by OP, STORE, and BRANCH.\\n- JAL, LUI, AUIPC, FENCE/FENCE.I, and EBREAK use no integer source register.\\n- Reserved funct3/funct7 combinations and unknown opcodes remain\\n  conservative by treating both rs fields as possible sources.\\n\\nThe existing one-cycle bubble remains for every true load-use dependency,\\nincluding store address dependencies, branch compares, JALR bases, ALU\\nconsumers, and any conservative illegal/unknown instruction class. The change\\nshould not forward load data, alter the MEM stage, widen retirement, or\\nchange the top-level IO. It only refines when the frontend and ID/EX register\\nare stalled for a load in EX.\\n\\nThis preserves the hard invariants: decoder legality still defaults illegal,\\nRVFI traps and order remain generated at MEM/WB, channel 1 stays tied off, and\\nall memory and timing-marker behavior remains unchanged. The expected benefit\\nis a small CoreMark cycle reduction with minimal Fmax risk because the added\\nlogic is opcode/funct predecode on the existing hazard path, not a new data\\npath or stateful predictor.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Replace the raw load-use comparison against both IF/ID register fields\\nwith a source-use-aware predicate. Add conservative decode-light logic for\\nknown legal RV32IM instruction classes, defaulting unknown or reserved\\nencodings to uses_rs1=1 and uses_rs2=1. Gate the rs1 comparison with\\nuses_rs1 and the rs2 comparison with uses_rs2, while preserving the\\nexisting redirect, imem replay readiness, MEM wait, and EX long-operation\\nstall behavior.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Pass any additional IF/ID instruction validity or predecoded source-use\\nsideband needed by the hazard unit. Keep the core module IO unchanged,\\npreserve the registered IF replay wiring, pending-store-slot arbitration,\\ndivider interlock, RVFI NRET=2 field set, strict channel-0 order sequence,\\nand tied-off channel 1.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"If useful, add compact comments or bundle fields documenting IF/ID\\nsource-use metadata for hazard detection. Do not change RVFI fields,\\narchitectural state semantics, decoder legality defaults, ALU op\\nencodings, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Replace the raw load-use comparison against both IF/ID register fields\\nwith a source-use-aware predicate. Add conservative decode-light logic for\\nknown legal RV32IM instruction classes, defaulting unknown or reserved\\nencodings to uses_rs1=1 and uses_rs2=1. Gate the rs1 comparison with\\nuses_rs1 and the rs2 comparison with uses_rs2, while preserving the\\nexisting redirect, imem replay readiness, MEM wait, and EX long-operation\\nstall behavior.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Pass any additional IF/ID instruction validity or predecoded source-use\\nsideband needed by the hazard unit. Keep the core module IO unchanged,\\npreserve the registered IF replay wiring, pending-store-slot arbitration,\\ndivider interlock, RVFI NRET=2 field set, strict channel-0 order sequence,\\nand tied-off channel 1.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"If useful, add compact comments or bundle fields documenting IF/ID\\nsource-use metadata for hazard detection. Do not change RVFI fields,\\narchitectural state semantics, decoder legality defaults, ALU op\\nencodings, or the NRET=2 contract.\\n\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"cosim_failed: selftest.elf\", \"slot\": 1, \"round_id\": 18}\n55:{\"id\": \"hyp-20260428-048-r18s2\", \"title\": \"Kill-Gated I-Fetch Replay Fills\", \"category\": \"predictor\", \"motivation\": \"The current best design already has the predictor feature with the strongest\\nmeasured payoff: a 256-entry registered lookahead instruction replay table\\nwith compressed tags. It hides random iStall bubbles without putting a\\nsame-cycle table lookup on the IF decision path. Follow-up predictor attempts\\nthat added branch-direction state, return targets, victim entries, wider\\nreplay lines, or replay-cached next-PC metadata either saved too few cycles\\nor lost more Fmax than they recovered.\\n\\nThe next predictor slot should therefore keep the existing replay structure\\nand target replay quality rather than add another table. The current IF\\nstage refreshes the replay table on every live `io_imemReady` fetch, even\\nwhen that fetch is being killed by an EX redirect or IF flush. Those killed\\nwords are architecturally correct immutable instructions, but they are\\nwrong-path for the current execution and can evict useful hot-loop replay\\nentries in the direct-mapped table. Avoiding this pollution is a narrow\\nreplay-predictor improvement with little timing exposure: it changes the\\nreplay write-enable policy, not the current-cycle fetch-ready, branch/JAL\\ntarget, ALU, memory, or retirement paths.\\n\", \"hypothesis\": {\"motivation\": \"The current best design already has the predictor feature with the strongest\\nmeasured payoff: a 256-entry registered lookahead instruction replay table\\nwith compressed tags. It hides random iStall bubbles without putting a\\nsame-cycle table lookup on the IF decision path. Follow-up predictor attempts\\nthat added branch-direction state, return targets, victim entries, wider\\nreplay lines, or replay-cached next-PC metadata either saved too few cycles\\nor lost more Fmax than they recovered.\\n\\nThe next predictor slot should therefore keep the existing replay structure\\nand target replay quality rather than add another table. The current IF\\nstage refreshes the replay table on every live `io_imemReady` fetch, even\\nwhen that fetch is being killed by an EX redirect or IF flush. Those killed\\nwords are architecturally correct immutable instructions, but they are\\nwrong-path for the current execution and can evict useful hot-loop replay\\nentries in the direct-mapped table. Avoiding this pollution is a narrow\\nreplay-predictor improvement with little timing exposure: it changes the\\nreplay write-enable policy, not the current-cycle fetch-ready, branch/JAL\\ntarget, ALU, memory, or retirement paths.\\n\", \"hypothesis\": \"Gate instruction replay-table fills so only instructions that are eligible to\\nenter the frontend stream refresh the replay predictor. A live imem word\\nshould update the replay entry when `io_imemReady` is high and the IF payload\\nis not being killed by reset, flush, or EX redirect. Backend stalls that hold\\nthe current PC, such as load-use, divide-long, or MEM wait, should still be\\nallowed to refresh the held-PC replay entry because that instruction remains\\nthe next architectural fetch once the stall clears.\\n\\nOn redirect or flush cycles, suppress both the direct replay-table write and\\nany fill-bypass path that would seed the registered lookahead candidate from\\nthe killed live word. The next candidate should instead come from the\\nexisting table lookup for the selected redirect target or held PC. Live imem\\ndata still has priority whenever it is not killed, replay hits still use the\\nregistered candidate during external imem stalls, replay misses still hold\\nthe PC and inject the existing IF bubble, and the static backward-branch plus\\ndirect-JAL predictor policy remains unchanged.\\n\\nThis preserves correctness because replay entries are only a performance\\npredictor for immutable instruction words; suppressing a killed fill can only\\nturn a future replay hit into a miss. RVFI instruction reporting,\\nresolved-next-PC recovery, strict channel-0 `rvfi_order`, tied-off channel 1,\\npending-store-slot behavior, divider interlock, decoder legality rules, and\\ntop-level IO remain unchanged. The expected benefit is a modest CoreMark\\ncycle reduction from less direct-mapped replay pollution, with minimal Fmax\\nrisk because the added gating is on replay-table write/update enables rather\\nthan the hot current-cycle prediction datapath.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add an explicit `replay_fill_enable` derived from live imem readiness\\nand the existing IF kill conditions. Use it for replay-table writes and\\nfor the same-index fill-bypass candidate path so reset, flush, and EX\\nredirect cycles cannot seed replay state from a killed wrong-path word.\\nKeep fill enabled during ordinary backend stalls that hold the current\\nPC. Preserve the 256-entry compressed-tag replay table, resetless payload\\narrays, registered lookahead candidate with current-PC guard, live-imem\\npriority, replay-hit `fetch_ready` semantics, and the existing static\\nbackward-branch/direct-JAL prediction policy.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify only the IF/ID replay comments to document that replay entries\\nare refreshed from live imem words that are not killed by reset, flush,\\nor redirect, while held-PC backend stalls may still refresh the replay\\nentry. Do not change bundle widths, architectural state, decoder legality\\ndefaults, RVFI fields, top-level IO, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add an explicit `replay_fill_enable` derived from live imem readiness\\nand the existing IF kill conditions. Use it for replay-table writes and\\nfor the same-index fill-bypass candidate path so reset, flush, and EX\\nredirect cycles cannot seed replay state from a killed wrong-path word.\\nKeep fill enabled during ordinary backend stalls that hold the current\\nPC. Preserve the 256-entry compressed-tag replay table, resetless payload\\narrays, registered lookahead candidate with current-PC guard, live-imem\\npriority, replay-hit `fetch_ready` semantics, and the existing static\\nbackward-branch/direct-JAL prediction policy.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify only the IF/ID replay comments to document that replay entries\\nare refreshed from live imem words that are not killed by reset, flush,\\nor redirect, while held-PC backend stalls may still refresh the replay\\nentry. Do not change bundle widths, architectural state, decoder legality\\ndefaults, RVFI fields, top-level IO, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 337.32, \"delta_pct\": -36.28, \"vs_baseline\": 12.05, \"fmax_mhz\": 116.69, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5890, \"ff\": 2223, \"seeds\": [116.69, 123.72, 113.13], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes\\n\\n- Added `replay_fill_enable` in `rtl/if_stage.sv`, derived as `imem_ready && !fetch_kill`.\\n- Used `replay_fill_enable` for replay-table writes, so live imem words killed by reset, IF flush, or EX redirect no longer refresh replay state.\\n- Used `replay_fill_enable` for the same-index fill-bypass path, so killed live words cannot seed the registered lookahead replay candidate.\\n- Updated the IF/ID replay comments in `rtl/core_pkg.sv` to document killed-fill suppression and held-PC backend-stall refresh behavior.\\n\\n## Deviations\\n\\n- No structural changes were needed. The existing replay lookup target selection already chooses the redirect target on redirect and the held PC during stalls.\\n\\n## Concerns\\n\\n- No known RTL concerns. Backend stalls that hold the PC still allow live imem fills because they do not assert the IF kill conditions.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- Direct `bash formal/run_all.sh` from the worktree was blocked before checks by sandbox permissions because `formal/riscv-formal` is a symlink to a shared tree outside the writable roots and the script stages files under that tree.\\n- Re-ran the same `run_all.sh` from a temporary writable `/tmp/auto_arch_formal_r18s2` staging tree with this worktree's `rtl/` linked in: pass, `105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T07:49:32.640408\", \"slot\": 2, \"round_id\": 18}\n56:{\"id\": \"hyp-20260428-049-r19s0\", \"title\": \"Bitfield RV32M Control Decode\", \"category\": \"micro_opt\", \"motivation\": \"The current best result came from making the ALU opcode encoding expose a\\nhot RV32I path and a cold RV32M path. That change improved Fmax without\\nchanging CoreMark cycles, which suggests the next micro-opt should keep\\nexploiting the same encoding rather than adding another replay table,\\npredictor, queue, reset rewrite, or arithmetic unit.\\n\\nSome downstream control logic still decodes RV32M operations with explicit\\nequality trees. In particular, EX detects divide/remainder instructions with\\nfour full `alu_op == ALU_*` compares even though the current encoding makes\\nDIV/DIVU/REM/REMU exactly the `alu_op[4] && alu_op[2]` class. The divider\\nalso reclassifies signed versus unsigned and quotient versus remainder with\\nopcode equality checks even though those are now just low funct3 bits inside\\nthe divide group.\\n\\nThese compares are small, but they sit in always-present EX control and\\nlong-operation stall logic that feeds the frontend hold network. Recent\\nexperiments show broad datapath, reset, and replay changes often lose more\\nplacement quality than they recover, so a narrow decode cleanup in the\\nalready-proven ALU-op encoding is the most attractive micro_opt follow-up.\\n\", \"hypothesis\": {\"motivation\": \"The current best result came from making the ALU opcode encoding expose a\\nhot RV32I path and a cold RV32M path. That change improved Fmax without\\nchanging CoreMark cycles, which suggests the next micro-opt should keep\\nexploiting the same encoding rather than adding another replay table,\\npredictor, queue, reset rewrite, or arithmetic unit.\\n\\nSome downstream control logic still decodes RV32M operations with explicit\\nequality trees. In particular, EX detects divide/remainder instructions with\\nfour full `alu_op == ALU_*` compares even though the current encoding makes\\nDIV/DIVU/REM/REMU exactly the `alu_op[4] && alu_op[2]` class. The divider\\nalso reclassifies signed versus unsigned and quotient versus remainder with\\nopcode equality checks even though those are now just low funct3 bits inside\\nthe divide group.\\n\\nThese compares are small, but they sit in always-present EX control and\\nlong-operation stall logic that feeds the frontend hold network. Recent\\nexperiments show broad datapath, reset, and replay changes often lose more\\nplacement quality than they recover, so a narrow decode cleanup in the\\nalready-proven ALU-op encoding is the most attractive micro_opt follow-up.\\n\", \"hypothesis\": \"Replace redundant RV32M opcode equality decoders with bitfield tests derived\\nfrom the current hot/cold ALU encoding. In EX, compute divide-class detection\\nas `alu_op[4] && alu_op[2]` instead of OR-ing four equality comparisons for\\nDIV, DIVU, REM, and REMU. This remains exact because MUL/MULH/MULHSU/MULHU\\nare encoded as `5'b10000` through `5'b10011`, while DIV/DIVU/REM/REMU are\\nencoded as `5'b10100` through `5'b10111`.\\n\\nIn the real divider path, derive `want_rem` from `op[1]` and signedness from\\n`!op[0]` within the divide-class group, while keeping the existing ALTOPS\\ncase labels for formal substitutions. The divider still launches only from\\nEX's divide-class predicate and still preserves all RV32M corner cases:\\ndivide-by-zero, signed INT_MIN/-1 overflow, REM-by-zero, and signed\\nremainder sign correction.\\n\\nThis does not alter any arithmetic result, instruction latency, forwarding\\npath, branch predictor, memory behavior, pending-store slot, replay table,\\ntop-level IO, RVFI field, channel-0 retirement order, or channel-1 tie-off.\\nCoreMark cycle count should be unchanged. The expected gain is a small median\\nFmax improvement from replacing several full opcode comparators in EX and\\ndivider control with direct low-bit tests that match the current ALU encoding.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/ex_stage.sv\", \"description\": \"Replace the four-way DIV/DIVU/REM/REMU equality OR used for\\n`is_div_op` with the exact bitfield predicate\\n`in.ctrl.alu_op[4] && in.ctrl.alu_op[2]`. Preserve the existing\\n`in.valid`, illegal-instruction, stall, divider launch/completion,\\nEX/MEM bubble, forwarding, redirect, and RVFI metadata behavior.\\n\"}, {\"file\": \"rtl/div_unit.sv\", \"description\": \"In the real RV32M divider implementation, derive divide/remainder\\nclassification from the encoded funct3 low bits: `op[1]` selects\\nREM/REMU versus DIV/DIVU, and `!op[0]` selects signed DIV/REM versus\\nunsigned DIVU/REMU. Keep all existing special-case arithmetic semantics\\nand keep the RISCV_FORMAL_ALTOPS formulas keyed by the named ALU\\nconstants so formal behavior remains unchanged.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/ex_stage.sv\", \"description\": \"Replace the four-way DIV/DIVU/REM/REMU equality OR used for\\n`is_div_op` with the exact bitfield predicate\\n`in.ctrl.alu_op[4] && in.ctrl.alu_op[2]`. Preserve the existing\\n`in.valid`, illegal-instruction, stall, divider launch/completion,\\nEX/MEM bubble, forwarding, redirect, and RVFI metadata behavior.\\n\"}, {\"file\": \"rtl/div_unit.sv\", \"description\": \"In the real RV32M divider implementation, derive divide/remainder\\nclassification from the encoded funct3 low bits: `op[1]` selects\\nREM/REMU versus DIV/DIVU, and `!op[0]` selects signed DIV/REM versus\\nunsigned DIVU/REMU. Keep all existing special-case arithmetic semantics\\nand keep the RISCV_FORMAL_ALTOPS formulas keyed by the named ALU\\nconstants so formal behavior remains unchanged.\\n\"}], \"outcome\": \"regression\", \"fitness\": 383.8, \"delta_pct\": -27.5, \"vs_baseline\": 27.49, \"fmax_mhz\": 132.77, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5868, \"ff\": 2225, \"seeds\": [153.09, 125.3, 132.77], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes\\n- `rtl/ex_stage.sv`: replaced the four named DIV/DIVU/REM/REMU equality compares for `is_div_op` with the encoded divide-class predicate `in.ctrl.alu_op[4] && in.ctrl.alu_op[2]`.\\n- `rtl/div_unit.sv`: in the real divider path, replaced named-op equality classification with `op[1]` for quotient-vs-remainder and `!op[0]` for signed-vs-unsigned.\\n- Kept the `RISCV_FORMAL_ALTOPS` case labels keyed by the named `ALU_*` constants.\\n\\n## Deviations\\n- Added a local Verilator `UNUSEDSIGNAL` guard on the divider `op` input. In the real divider build, `op[4:2]` are now intentionally consumed by EX-stage launch decode, while the divider result control only needs `op[1:0]`. This keeps the required lint command warning-clean without adding decode logic back into the real divider path.\\n\\n## Concerns\\n- None known. The change assumes the existing decoder continues to be the only source of launched divider ops, matching the current `ALU_*` encoding.\\n\\n## Verification\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: the direct in-place run was blocked by sandbox permissions while deleting staged files under `formal/riscv-formal/cores/auto-arch-researcher`.\\n- Equivalent local formal run from a `/tmp` mirror excluding the protected `riscv-formal/cores` staging tree: pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:11:46.823672\", \"slot\": 0, \"round_id\": 19}\n57:{\"id\": \"hyp-20260428-050-r19s1\", \"title\": \"Backend-Stall Shadow I-Fetch Prefetcher\", \"category\": \"structural\", \"motivation\": \"The current best core gets its largest cycle-count win from the registered\\nlookahead instruction replay table: hot instructions can be supplied during\\nrandom imem stalls without a same-cycle replay lookup on the IF critical\\npath. The remaining structural stalls are now mostly backend stalls from\\ndmem waits and long operations. During those cycles the frontend PC is held,\\ndecode is not accepting a new instruction, and the independent imem port is\\nusually wasted refreshing the same held PC or sitting idle.\\n\\nPrior fetch queues tried to decouple fetch and decode directly, but they put\\nqueue control on the normal zero-wait frontend path and lost Fmax. A more\\ntargeted structural angle is to use backend-stall cycles only as replay-table\\nwarmup time. The architectural fetch/decode stream remains held exactly as it\\nis today, while a shadow prefetch PC walks ahead through the existing static\\nbranch/direct-JAL prediction policy and fills the replay table with future\\ninstruction words. When the backend releases, later external imem stalls are\\nmore likely to hit in the already-proven registered replay structure.\\n\", \"hypothesis\": {\"motivation\": \"The current best core gets its largest cycle-count win from the registered\\nlookahead instruction replay table: hot instructions can be supplied during\\nrandom imem stalls without a same-cycle replay lookup on the IF critical\\npath. The remaining structural stalls are now mostly backend stalls from\\ndmem waits and long operations. During those cycles the frontend PC is held,\\ndecode is not accepting a new instruction, and the independent imem port is\\nusually wasted refreshing the same held PC or sitting idle.\\n\\nPrior fetch queues tried to decouple fetch and decode directly, but they put\\nqueue control on the normal zero-wait frontend path and lost Fmax. A more\\ntargeted structural angle is to use backend-stall cycles only as replay-table\\nwarmup time. The architectural fetch/decode stream remains held exactly as it\\nis today, while a shadow prefetch PC walks ahead through the existing static\\nbranch/direct-JAL prediction policy and fills the replay table with future\\ninstruction words. When the backend releases, later external imem stalls are\\nmore likely to hit in the already-proven registered replay structure.\\n\", \"hypothesis\": \"Add a shadow instruction prefetch mode inside IF that activates only while a\\nbackend stall is holding the architectural frontend and the current IF/ID\\ninstruction is already safely held or replayable. On entry, capture the\\ncurrent architectural IF/ID metadata into a tiny hold register so the hazard\\nunit and decode-facing output continue to see the same instruction while\\nthe external imem address is repurposed for prefetch. The architectural PC\\nand pipeline-visible IF/ID payload remain frozen until the backend accepts\\nthem; only the replay table is updated by shadow fetches.\\n\\nWhile shadow prefetch is active, drive `io_imemAddr` from a `prefetch_pc`\\nrather than the architectural PC. On each `io_imemReady` prefetch response,\\nfill or refresh the existing 256-entry compressed-tag replay entry for\\n`prefetch_pc`, then advance `prefetch_pc` using the same zero-state static\\nnext-PC rule already used for normal fetch: backward conditional branches\\npredict taken, direct aligned JAL predicts its target, and JALR remains\\nunpredicted. Redirects, reset, and frontend flushes cancel shadow prefetch\\nimmediately and resume normal fetch at the resolved architectural target.\\n\\nThis is not a fetch queue and it does not let prefetched instructions enter\\ndecode early. It only converts cycles where the backend cannot accept an\\ninstruction into useful instruction replay-table fills. Live architectural\\nfetches still have priority when the backend is ready, replay hits still use\\nthe registered lookahead candidate, replay misses still hold the PC and\\ninject the existing IF bubble, and EX still repairs branch/JAL prediction\\nmistakes through resolved-next-PC mismatch recovery. The top-level IO, RVFI\\nNRET=2 port set, channel-0-only retirement convention, strict `rvfi_order`\\nsequence, pending-store slot, divider interlock, memory ordering, and decoder\\nlegality rules remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a backend-stall-only shadow prefetch mode. Capture the current\\narchitectural IF/ID metadata into a hold register before repurposing\\n`io_imemAddr`, keep the decode-facing output stable from that hold\\nregister while the backend is stalled, and use a separate `prefetch_pc`\\nto fill the existing compressed-tag replay table. Advance the shadow PC\\nwith the existing static branch/direct-JAL prediction rule, cancel it on\\nreset, flush, or EX redirect, and preserve live-imem priority plus the\\nregistered replay-hit `fetch_ready` contract for architectural fetches.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire a backend-prefetch-eligible signal into IF, derived from precise\\nbackend holds such as MEM wait and EX long-operation stalls rather than\\nraw imem misses. Keep the core module IO, RVFI channel layout, pending\\nstore-slot arbitration, hot/cold ALU wiring, divider interlock, and\\nchannel-1 tie-off unchanged.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"If needed, expose or document the distinction between frontend imem\\nunavailability and backend holds so IF only enters shadow prefetch when\\ndecode is blocked by the backend and the architectural IF/ID instruction\\nmust remain stable. Preserve existing load-use, redirect, MEM wait,\\nEX-long-operation, EX/MEM hold, and MEM/WB hold behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify IF/ID comments to document that during backend-stall shadow\\nprefetch the pipeline-visible IF/ID metadata remains held while the imem\\nport may be used only to warm the replay table. Do not change bundle\\nwidths, architectural state semantics, decoder legality defaults, RVFI\\nfields, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a backend-stall-only shadow prefetch mode. Capture the current\\narchitectural IF/ID metadata into a hold register before repurposing\\n`io_imemAddr`, keep the decode-facing output stable from that hold\\nregister while the backend is stalled, and use a separate `prefetch_pc`\\nto fill the existing compressed-tag replay table. Advance the shadow PC\\nwith the existing static branch/direct-JAL prediction rule, cancel it on\\nreset, flush, or EX redirect, and preserve live-imem priority plus the\\nregistered replay-hit `fetch_ready` contract for architectural fetches.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire a backend-prefetch-eligible signal into IF, derived from precise\\nbackend holds such as MEM wait and EX long-operation stalls rather than\\nraw imem misses. Keep the core module IO, RVFI channel layout, pending\\nstore-slot arbitration, hot/cold ALU wiring, divider interlock, and\\nchannel-1 tie-off unchanged.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"If needed, expose or document the distinction between frontend imem\\nunavailability and backend holds so IF only enters shadow prefetch when\\ndecode is blocked by the backend and the architectural IF/ID instruction\\nmust remain stable. Preserve existing load-use, redirect, MEM wait,\\nEX-long-operation, EX/MEM hold, and MEM/WB hold behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify IF/ID comments to document that during backend-stall shadow\\nprefetch the pipeline-visible IF/ID metadata remains held while the imem\\nport may be used only to warm the replay table. Do not change bundle\\nwidths, architectural state semantics, decoder legality defaults, RVFI\\nfields, or the NRET=2 contract.\\n\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"cosim_failed: coremark.elf\", \"slot\": 1, \"round_id\": 19}\n58:{\"id\": \"hyp-20260428-051-r19s2\", \"title\": \"XOR-Indexed I-Fetch Replay Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best predictor state is the compressed, resetless registered\\nlookahead instruction replay table. It preserves the large random-iStall\\ncycle reduction of the 256-entry replay predictor while keeping the\\ncurrent-cycle IF path free of a combinational table read. Follow-up\\npredictor attempts show the boundary clearly: extra branch-direction state,\\nreturn targets, replay victim entries, replay-line widening, and cached\\nnext-PC metadata either saved too few cycles or lost more Fmax than they\\nrecovered.\\n\\nThe remaining replay opportunity is likely direct-mapped conflict behavior.\\nThe table is indexed by `pc[9:2]`, so hot instructions separated by 1 KiB\\nalias even though the CoreMark timed region repeatedly visits several loop\\nbodies and helper routines. Smaller tables lost hit rate, and adding ways or\\nvictim entries added too much logic. A hashed direct-map index targets the\\nsame conflict misses while keeping the table size, registered lookahead\\ntiming model, live-imem-first policy, and compressed tag storage intact.\\n\", \"hypothesis\": {\"motivation\": \"The current best predictor state is the compressed, resetless registered\\nlookahead instruction replay table. It preserves the large random-iStall\\ncycle reduction of the 256-entry replay predictor while keeping the\\ncurrent-cycle IF path free of a combinational table read. Follow-up\\npredictor attempts show the boundary clearly: extra branch-direction state,\\nreturn targets, replay victim entries, replay-line widening, and cached\\nnext-PC metadata either saved too few cycles or lost more Fmax than they\\nrecovered.\\n\\nThe remaining replay opportunity is likely direct-mapped conflict behavior.\\nThe table is indexed by `pc[9:2]`, so hot instructions separated by 1 KiB\\nalias even though the CoreMark timed region repeatedly visits several loop\\nbodies and helper routines. Smaller tables lost hit rate, and adding ways or\\nvictim entries added too much logic. A hashed direct-map index targets the\\nsame conflict misses while keeping the table size, registered lookahead\\ntiming model, live-imem-first policy, and compressed tag storage intact.\\n\", \"hypothesis\": \"Replace the replay table's direct index `pc[9:2]` with a simple XOR-folded\\nindex, for example `pc[9:2] ^ pc[17:10]`, for both live fills and registered\\nlookahead lookups. Keep the existing 256-entry table, high-PC tag compare,\\nresetless tag/instruction payload arrays, registered candidate PC guard,\\nsame-entry fill bypass, and live `io_imemData` priority.\\n\\nFor a fixed stored high tag `pc[31:10]`, the XOR fold is still one-to-one\\nwith the low word index, so the existing compressed tag plus registered\\ncurrent-PC guard remains correctness-preserving. A hash collision can only\\nevict a useful replay word and create a future miss; it cannot inject an\\ninstruction for the wrong PC. Replay misses still hold the PC and inject the\\nexisting IF bubble, while replay hits continue to feed the cached instruction\\ninto the current static backward-branch and direct-JAL prediction path.\\n\\nThis is intended to recover iStall cycles lost to 1 KiB direct-map conflicts\\nwithout adding another table, way, victim search, branch update path, RAS,\\npipeline stage, or load-data bypass. The top-level IO, RVFI NRET=2 channel\\nlayout, strict channel-0 order sequence, tied-off channel 1, pending-store\\nslot, divider interlock, decoder legality rules, and branch/JAL resolved\\nnext-PC recovery remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Change the registered lookahead replay predictor index from the raw\\ndirect-mapped `pc[9:2]` bits to a small XOR-folded index such as\\n`pc[9:2] ^ pc[17:10]` for live fills, registered lookahead reads, and\\nsame-entry fill-bypass detection. Preserve the 256-entry table size,\\ncompressed `pc[31:10]` tags, resetless replay payload arrays, candidate\\nPC equality guard, live-imem priority, replay-hit `fetch_ready`\\nsemantics, redirect priority, and the existing static backward-branch\\nplus direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only the IF/ID replay comments to document that replay entries\\nuse an XOR-folded direct-map index plus the existing high-PC tag and\\nregistered current-PC guard. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Change the registered lookahead replay predictor index from the raw\\ndirect-mapped `pc[9:2]` bits to a small XOR-folded index such as\\n`pc[9:2] ^ pc[17:10]` for live fills, registered lookahead reads, and\\nsame-entry fill-bypass detection. Preserve the 256-entry table size,\\ncompressed `pc[31:10]` tags, resetless replay payload arrays, candidate\\nPC equality guard, live-imem priority, replay-hit `fetch_ready`\\nsemantics, redirect priority, and the existing static backward-branch\\nplus direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only the IF/ID replay comments to document that replay entries\\nuse an XOR-folded direct-map index plus the existing high-PC tag and\\nregistered current-PC guard. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 522.1, \"delta_pct\": -1.37, \"vs_baseline\": 73.43, \"fmax_mhz\": 180.64, \"ipc_coremark\": 3e-06, \"cycles\": 3459875, \"iterations\": 10, \"lut4\": 5912, \"ff\": 2228, \"seeds\": [178.44, 191.24, 180.64], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Changed the IF replay predictor direct-map index from raw `pc[9:2]` to\\n  `pc[9:2] ^ pc[17:10]` in `rtl/if_stage.sv`.\\n- Applied the same folded index to live fills, registered lookahead reads,\\n  and same-entry fill bypass detection.\\n- Kept the 256-entry table, compressed `pc[31:10]` tag compare, resetless\\n  tag/instruction payload arrays, registered candidate PC guard, live-imem\\n  priority, replay-hit `fetch_ready` behavior, redirect priority, and\\n  static backward-branch/direct-JAL prediction behavior unchanged.\\n- Updated the IF/ID replay comments in `rtl/core_pkg.sv` to document the\\n  XOR-folded index plus high-PC tag and registered current-PC guard.\\n\\n## Deviations\\n\\n- No architectural or structural deviations from the hypothesis.\\n- No top-level IO, RVFI, decoder, memory, branch recovery, or pipeline bundle\\n  changes were made.\\n\\n## Concerns\\n\\n- The hash may improve 1 KiB conflict behavior, but it can also introduce\\n  different conflict pairs. Correctness is preserved by the high-PC tag and\\n  registered full-PC guard; collisions only affect replay hit rate.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: the repository-local invocation was blocked by\\n  sandbox permissions before any checks ran, while trying to remove staged\\n  files under the symlinked `formal/riscv-formal/cores/auto-arch-researcher`\\n  directory.\\n- Equivalent local formal run from a writable `/tmp` copy of the same runner,\\n  checks config, wrapper, and current `rtl/*.sv` completed with\\n  `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:08:19.813594\", \"slot\": 2, \"round_id\": 19}\n59:{\"id\": \"hyp-20260428-052-r20s0\", \"title\": \"Funct3-Aligned Hot ALU Encoding\", \"category\": \"micro_opt\", \"motivation\": \"The current best result came from an RTL-only hot/cold ALU opcode split:\\nRV32M operations were moved behind `alu_op[4]`, letting the common RV32I\\nresult path avoid the cold M-extension mux. That improved Fmax without\\nchanging CoreMark cycles, so the most promising micro_opt follow-up is to\\nkeep refining the same hot EX datapath rather than adding new replay state,\\nqueues, reset rewrites, or arithmetic units.\\n\\nThe remaining RV32I/simple ALU encoding is still arbitrary and dense:\\nADD/SUB/logic/compare/shift/LUI are assigned sequential localparams, so the\\ndecoder emits constants unrelated to the instruction funct3 bits and the ALU\\nstill needs an 11-way simple-result case. RISC-V already groups the hot\\nOP/OP-IMM operations by funct3, with only SUB/SRA needing a modifier bit.\\nRe-encoding the simple ALU controls around that structure should shrink\\ndecode and mux logic on the single-cycle EX result path while preserving the\\nsuccessful `op[4]` M-extension discriminator.\\n\", \"hypothesis\": {\"motivation\": \"The current best result came from an RTL-only hot/cold ALU opcode split:\\nRV32M operations were moved behind `alu_op[4]`, letting the common RV32I\\nresult path avoid the cold M-extension mux. That improved Fmax without\\nchanging CoreMark cycles, so the most promising micro_opt follow-up is to\\nkeep refining the same hot EX datapath rather than adding new replay state,\\nqueues, reset rewrites, or arithmetic units.\\n\\nThe remaining RV32I/simple ALU encoding is still arbitrary and dense:\\nADD/SUB/logic/compare/shift/LUI are assigned sequential localparams, so the\\ndecoder emits constants unrelated to the instruction funct3 bits and the ALU\\nstill needs an 11-way simple-result case. RISC-V already groups the hot\\nOP/OP-IMM operations by funct3, with only SUB/SRA needing a modifier bit.\\nRe-encoding the simple ALU controls around that structure should shrink\\ndecode and mux logic on the single-cycle EX result path while preserving the\\nsuccessful `op[4]` M-extension discriminator.\\n\", \"hypothesis\": \"Re-encode the RV32I/simple ALU operations so `alu_op[2:0]` matches the\\nRISC-V funct3 value for ADD/SUB, SLL, SLT, SLTU, XOR, SRL/SRA, OR, and AND,\\nwhile `alu_op[3]` distinguishes the alternate ADD/SUB and SRL/SRA variants.\\nKeep `alu_op[4]=0` for every simple operation and keep all RV32M constants\\nat the current `alu_op[4]=1` contiguous encoding that produced the best\\nresult. Assign LUI to one otherwise-unused simple encoding, such as\\n`op[3]=1` with low bits `111`, and keep AUIPC as ADD with operand A = PC as\\ntoday.\\n\\nRefactor the hot simple ALU mux to decode mostly by `op[2:0]`: one case arm\\neach for ADD/SUB, SLL, SLT, SLTU, XOR, SRL/SRA, OR, and AND/LUI, with\\n`op[3]` only used inside the ADD/SUB, SRL/SRA, and LUI-vs-AND arms. The cold\\nM mux and final `op[4] ? m_out : simple_out` selection remain unchanged.\\n\\nDecoder behavior stays architecturally identical: legal OP and OP-IMM\\ninstructions emit the new funct3-aligned constants, reserved encodings still\\nleave `is_illegal=1`, and every RVFI-visible arithmetic result is unchanged.\\nNo instruction latency, divider protocol, forwarding path, branch predictor,\\nmemory behavior, replay table, top-level IO, RVFI field, channel-0\\nretirement ordering, or channel-1 tie-off changes. CoreMark cycles should be\\nidentical; the expected gain is a modest median Fmax improvement from a\\nshallower hot ALU control/mux path.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Reassign the RV32I/simple ALU localparams so the low three bits match\\ninstruction funct3 where possible, with bit 3 as the SUB/SRA/simple\\nspecial modifier. Preserve the current `alu_op[4]=1` RV32M constants\\nand do not change any bundle widths, RVFI fields, architectural state,\\ndecoder legality defaults, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/decoder.sv\", \"description\": \"Emit the new funct3-aligned ALU constants for OP and OP-IMM decode.\\nADD/ADDI and the logical/compare/shift operations should map directly\\nfrom funct3, while SUB and SRA/SRAI set the modifier bit. LUI keeps its\\ndedicated simple encoding, AUIPC remains the ADD path with `is_auipc`,\\nand all reserved opcode/funct combinations must retain the existing\\nillegal-default behavior.\\n\"}, {\"file\": \"rtl/alu.sv\", \"description\": \"Rewrite the `simple_out` mux around the new encoding: case primarily on\\n`op[2:0]`, use `op[3]` only for ADD-vs-SUB, SRL-vs-SRA, and\\nAND-vs-LUI, and keep the cold M-extension mux plus ALTOPS multiply\\nsubstitutions unchanged. The final output remains selected by\\n`op[4] ? m_out : simple_out`.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Reassign the RV32I/simple ALU localparams so the low three bits match\\ninstruction funct3 where possible, with bit 3 as the SUB/SRA/simple\\nspecial modifier. Preserve the current `alu_op[4]=1` RV32M constants\\nand do not change any bundle widths, RVFI fields, architectural state,\\ndecoder legality defaults, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/decoder.sv\", \"description\": \"Emit the new funct3-aligned ALU constants for OP and OP-IMM decode.\\nADD/ADDI and the logical/compare/shift operations should map directly\\nfrom funct3, while SUB and SRA/SRAI set the modifier bit. LUI keeps its\\ndedicated simple encoding, AUIPC remains the ADD path with `is_auipc`,\\nand all reserved opcode/funct combinations must retain the existing\\nillegal-default behavior.\\n\"}, {\"file\": \"rtl/alu.sv\", \"description\": \"Rewrite the `simple_out` mux around the new encoding: case primarily on\\n`op[2:0]`, use `op[3]` only for ADD-vs-SUB, SRL-vs-SRA, and\\nAND-vs-LUI, and keep the cold M-extension mux plus ALTOPS multiply\\nsubstitutions unchanged. The final output remains selected by\\n`op[4] ? m_out : simple_out`.\\n\"}], \"outcome\": \"regression\", \"fitness\": 334.55, \"delta_pct\": -36.8, \"vs_baseline\": 11.13, \"fmax_mhz\": 115.73, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5896, \"ff\": 2225, \"seeds\": [115.73, 122.94, 107.75], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes made\\n\\n- Re-encoded the RV32I/simple ALU constants in `rtl/core_pkg.sv` so\\n  `alu_op[2:0]` matches the RISC-V OP/OP-IMM `funct3` value for ADD/SUB,\\n  SLL, SLT, SLTU, XOR, SRL/SRA, OR, and AND.\\n- Assigned `alu_op[3]` as the simple-operation modifier for SUB and SRA, and\\n  placed LUI at the unused simple encoding `5'b0_1_111`.\\n- Preserved the existing RV32M hot/cold split: all M-extension constants keep\\n  `alu_op[4] = 1` and remain contiguous as `5'b10000` through `5'b10111`.\\n- Refactored OP and OP-IMM decode in `rtl/decoder.sv` to emit the new\\n  funct3-aligned encodings directly while retaining the illegal-default\\n  discipline for reserved opcode/funct combinations.\\n- Reworked `rtl/alu.sv` so the simple result mux cases primarily on\\n  `op[2:0]`, with `op[3]` used only for ADD/SUB, SRL/SRA, and AND/LUI.\\n  The cold M-extension mux and final `op[4] ? m_out : simple_out` select are\\n  otherwise unchanged.\\n\\n## Deviations\\n\\n- No architectural, pipeline, RVFI, divider, forwarding, memory, or top-level\\n  IO behavior was changed.\\n- I did not modify cocotb helper constants under `test/`; the hypothesis and\\n  requested implementation scope are RTL-only, and prior eval history in this\\n  worktree shows edits to `test/_helpers.py` were rejected as off-limits.\\n\\n## Concerns\\n\\n- Standalone cocotb ALU/decoder tests that import `test/_helpers.py` may still\\n  reflect old numeric ALU constants. The RTL and formal/cosim-facing behavior\\n  are the intended source of truth for this hypothesis.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked in-place before proof by sandbox\\n  permissions while clearing staged files under the shared\\n  `formal/riscv-formal/cores/auto-arch-researcher` symlink.\\n- Equivalent self-check from a writable `/tmp` copy using the unmodified\\n  `formal/run_all.sh`, current `rtl/*.sv`, `formal/checks.cfg`, and\\n  `formal/wrapper.sv`: pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:30:02.739526\", \"slot\": 0, \"round_id\": 20}\n60:{\"id\": \"hyp-20260428-053-r20s1\", \"title\": \"Same-Word Store Slot Coalescing\", \"category\": \"structural\", \"motivation\": \"The current best core already includes the structural wins that have survived\\nFPGA evaluation: a one-deep pending-store slot for normal-RAM store stalls\\nand a registered instruction replay table for random iStall. Broader store\\nbuffering attempts found the right bottleneck but were too expensive:\\ntwo-entry pending-store designs either failed placement, and the same-cycle\\nrefill variant also failed placement. That suggests the next structural\\nstore-side step should add capacity only for cases the existing single slot\\ncan handle locally.\\n\\nCoreMark updates list nodes, matrix cells, stack frames, and scalar state with\\nshort bursts of stores. When a pending normal-RAM store is already occupying\\nthe slot and dmem is not ready, a younger store to the same aligned word does\\nnot need a second physical buffer entry. It can be merged into the pending\\nslot because loads and MMIO are still held behind the slot, and there is no\\narchitectural observer between the two normal-RAM stores. This targets the\\nsame store-burst pressure as the failed two-entry FIFO, but with one address\\ncompare and one byte-mask merge instead of another queue entry or a wider\\ndmem arbiter.\\n\", \"hypothesis\": {\"motivation\": \"The current best core already includes the structural wins that have survived\\nFPGA evaluation: a one-deep pending-store slot for normal-RAM store stalls\\nand a registered instruction replay table for random iStall. Broader store\\nbuffering attempts found the right bottleneck but were too expensive:\\ntwo-entry pending-store designs either failed placement, and the same-cycle\\nrefill variant also failed placement. That suggests the next structural\\nstore-side step should add capacity only for cases the existing single slot\\ncan handle locally.\\n\\nCoreMark updates list nodes, matrix cells, stack frames, and scalar state with\\nshort bursts of stores. When a pending normal-RAM store is already occupying\\nthe slot and dmem is not ready, a younger store to the same aligned word does\\nnot need a second physical buffer entry. It can be merged into the pending\\nslot because loads and MMIO are still held behind the slot, and there is no\\narchitectural observer between the two normal-RAM stores. This targets the\\nsame store-burst pressure as the failed two-entry FIFO, but with one address\\ncompare and one byte-mask merge instead of another queue entry or a wider\\ndmem arbiter.\\n\", \"hypothesis\": \"Add same-word coalescing to the existing one-entry pending-store slot. When\\nthe slot is valid, io_dmemReady is low, and the MEM-stage instruction is a\\nlegal aligned normal-RAM store whose word-aligned address matches the pending\\nslot's word address, retire the younger store through MEM/WB and merge its\\nbyte lanes into the slot entry. For overlapping byte lanes, the younger store\\nwins; for disjoint lanes, keep the older bytes and add the younger mask bits.\\nThe physical dmem port remains idle until the slot later drains, at which\\npoint it writes the merged word/mask once.\\n\\nPreserve the current direct fast path when the slot is empty and dmem is\\nready, and preserve the current low-ready enqueue path when the slot is empty.\\nDo not merge stores while the older slot is draining on a ready cycle; that\\navoids the placement-heavy same-cycle refill case that already failed. Loads,\\nMMIO/marker/UART stores, non-normal-RAM stores, misaligned stores, illegal or\\ntrapping accesses, and stores to a different word still wait behind the valid\\nslot exactly as today. RVFI still retires every store once with that\\ninstruction's own mem_addr, mem_wmask, and mem_wdata; the later physical drain\\nof a coalesced slot produces no additional RVFI event.\\n\\nThis is a structural store-stall reduction, not a load-data bypass or a wider\\nretirement design. It keeps the top-level IO, RVFI NRET=2 port set,\\nchannel-0-only retirement convention, strict rvfi_order sequence, registered\\nIF replay predictor, divider interlock, branch prediction, decoder legality,\\nand timing-marker behavior unchanged. The expected benefit is a small cycle\\nreduction on same-word store bursts under random dStall with much lower\\nplacement risk than a second store-buffer entry.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/store_slot.sv\", \"description\": \"Extend the one-entry pending-store slot with a same-word merge input.\\nWhen merge is asserted while the slot is valid and not draining, update\\nthe stored replicated write data and byte mask so younger byte lanes\\noverride older lanes and disjoint lanes are ORed into the pending mask.\\nKeep the existing enqueue, valid, and drain behavior for all non-merge\\ncases; the slot still stores only physical drain fields, not RVFI\\nbookkeeping.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Detect merge-eligible stores: valid legal aligned normal-RAM stores whose\\nword-aligned address matches a valid pending store slot while dmem is not\\nready. Allow those stores to retire without asserting mem_wait, emit their\\nnormal RVFI memory fields, and request a slot merge instead of a new live\\ndmem write. Keep loads, nonbufferable stores, stores to other words,\\ntraps, and pending-slot ready-drain cases on the existing wait path.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the store-slot merge request/data/mask signals between MEM and the\\npending-store slot, and expose the slot's word address to MEM for the\\nsame-word comparison. Preserve the current dmem arbitration priority:\\na valid pending slot drives the external port, and live MEM-stage\\nrequests use the direct path only when the slot is empty.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Continue consuming the MEM-stage mem_wait interlock. Update comments if\\nneeded to document that a same-word normal-RAM store may retire by\\ncoalescing into a non-draining pending slot, while all other memory\\noperations behind a valid slot remain blocked. Do not change imem replay\\nreadiness, load-use behavior, EX long-operation stalls, redirect flushes,\\nEX/MEM holds, or MEM/WB hold semantics.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/store_slot.sv\", \"description\": \"Extend the one-entry pending-store slot with a same-word merge input.\\nWhen merge is asserted while the slot is valid and not draining, update\\nthe stored replicated write data and byte mask so younger byte lanes\\noverride older lanes and disjoint lanes are ORed into the pending mask.\\nKeep the existing enqueue, valid, and drain behavior for all non-merge\\ncases; the slot still stores only physical drain fields, not RVFI\\nbookkeeping.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Detect merge-eligible stores: valid legal aligned normal-RAM stores whose\\nword-aligned address matches a valid pending store slot while dmem is not\\nready. Allow those stores to retire without asserting mem_wait, emit their\\nnormal RVFI memory fields, and request a slot merge instead of a new live\\ndmem write. Keep loads, nonbufferable stores, stores to other words,\\ntraps, and pending-slot ready-drain cases on the existing wait path.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the store-slot merge request/data/mask signals between MEM and the\\npending-store slot, and expose the slot's word address to MEM for the\\nsame-word comparison. Preserve the current dmem arbitration priority:\\na valid pending slot drives the external port, and live MEM-stage\\nrequests use the direct path only when the slot is empty.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Continue consuming the MEM-stage mem_wait interlock. Update comments if\\nneeded to document that a same-word normal-RAM store may retire by\\ncoalescing into a non-draining pending slot, while all other memory\\noperations behind a valid slot remain blocked. Do not change imem replay\\nreadiness, load-use behavior, EX long-operation stalls, redirect flushes,\\nEX/MEM holds, or MEM/WB hold semantics.\\n\"}], \"outcome\": \"regression\", \"fitness\": 527.13, \"delta_pct\": -0.42, \"vs_baseline\": 75.1, \"fmax_mhz\": 182.35, \"ipc_coremark\": 3e-06, \"cycles\": 3459314, \"iterations\": 10, \"lut4\": 5910, \"ff\": 2225, \"seeds\": [182.35, 183.12, 173.43], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Extended `rtl/store_slot.sv` with a merge path for a younger store to the same aligned word while the slot is valid and not draining.\\n- The slot still holds only physical drain fields: byte address, replicated write data, and byte mask.\\n- Merge updates the stored byte lanes with `(old & ~younger_mask) | (younger & younger_mask)` and ORs the byte masks, so overlapping lanes take the younger store data.\\n- Exposed the slot's word-aligned address to `rtl/mem_stage.sv` for the same-word comparison.\\n- Updated `rtl/mem_stage.sv` to assert `store_slot_merge` for valid, legal, aligned normal-RAM stores when:\\n  - the pending slot is valid,\\n  - `io_dmemReady` is low,\\n  - the younger store's word address matches the slot word address.\\n- A coalesced store retires through MEM/WB with its own RVFI `mem_addr`, `mem_wmask`, and `mem_wdata`; the later physical drain creates no RVFI event.\\n- Loads, non-normal-RAM stores, MMIO/marker/UART stores, misaligned memory ops, and stores to other words continue to wait behind a valid slot.\\n- Updated `rtl/core.sv` wiring and the `rtl/hazard_unit.sv` comment for the refined `mem_wait` behavior.\\n\\n## Deviations\\n\\n- No new module or package type was needed.\\n- The top-level dmem arbitration remains unchanged: a valid store slot owns the external port, and live MEM-stage requests only use it while the slot is empty.\\n- I did not add same-cycle drain/refill behavior; merge is explicitly gated off when `io_dmemReady` is high.\\n\\n## Concerns\\n\\n- The formal wrapper drives `io_dmemReady` high, so formal does not exercise the low-ready merge path deeply. The orchestrator random-dStall cosim is the meaningful end-to-end coverage for this behavior.\\n- Direct `bash formal/run_all.sh` in this worktree is blocked by sandbox permissions because `formal/riscv-formal` is a symlink to `/Users/bonetto/bonetto/auto-arch-tournament/formal/riscv-formal`, outside the writable roots. It failed before generating checks while trying to remove staged `.sv` files.\\n\\n## Local Verification\\n\\n- Lint: `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv` passed.\\n- Formal: ran the same `formal/run_all.sh` from a temporary `/tmp/aa_formal_project` copy with `rtl` symlinked back to this worktree, avoiding writes to the protected shared formal tree. Result: `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:28:43.806384\", \"slot\": 1, \"round_id\": 20}\n61:{\"id\": \"hyp-20260428-054-r20s2\", \"title\": \"Banked Registered I-Fetch Replay Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best predictor structure is the 256-entry registered lookahead\\ninstruction replay table with compressed resetless tags. It is the only\\npredictor-family change with a large measured cycle signal, because it turns\\nrandom imem stalls into useful hot-instruction replays while keeping the\\ncurrent-cycle IF path free of a combinational table read. Follow-up\\npredictor attempts that added branch-direction state, return targets,\\nvictim entries, wider lines, cached next-PC metadata, or XOR indexing either\\nsaved too few cycles or lost more Fmax than they recovered.\\n\\nThe best remaining replay opportunity is to reduce direct-mapped conflict\\nmisses without adding an associative lookup or changing the current-cycle\\nfetch-ready path. A full victim buffer added several tag compares and\\nregressed. XOR indexing changed conflicts but did not improve the measured\\nhit-rate/Fmax product. A banked direct-mapped predictor is a narrower\\nalternative: keep two small direct-mapped replay banks and choose between\\nthem with a simple per-set MRU bit during registered lookahead generation.\\nThe current cycle still consumes only the already registered replay\\ncandidate, so any extra bank selection work stays off the IF replay-hit path.\\n\", \"hypothesis\": {\"motivation\": \"The current best predictor structure is the 256-entry registered lookahead\\ninstruction replay table with compressed resetless tags. It is the only\\npredictor-family change with a large measured cycle signal, because it turns\\nrandom imem stalls into useful hot-instruction replays while keeping the\\ncurrent-cycle IF path free of a combinational table read. Follow-up\\npredictor attempts that added branch-direction state, return targets,\\nvictim entries, wider lines, cached next-PC metadata, or XOR indexing either\\nsaved too few cycles or lost more Fmax than they recovered.\\n\\nThe best remaining replay opportunity is to reduce direct-mapped conflict\\nmisses without adding an associative lookup or changing the current-cycle\\nfetch-ready path. A full victim buffer added several tag compares and\\nregressed. XOR indexing changed conflicts but did not improve the measured\\nhit-rate/Fmax product. A banked direct-mapped predictor is a narrower\\nalternative: keep two small direct-mapped replay banks and choose between\\nthem with a simple per-set MRU bit during registered lookahead generation.\\nThe current cycle still consumes only the already registered replay\\ncandidate, so any extra bank selection work stays off the IF replay-hit path.\\n\", \"hypothesis\": \"Replace the single 256-entry direct-mapped instruction replay table in\\n`if_stage` with a two-bank banked replay predictor. Each bank has 128 direct\\nmapped entries indexed by `pc[8:2]`, with a compressed high-PC tag\\n`pc[31:9]`, a valid bit, and a 32-bit instruction word. A one-bit per-set\\nMRU selector records which bank most recently held the line for that index.\\n\\nOn live `io_imemReady=1` fetches, keep the current live-imem-first behavior:\\nuse `io_imemData` for the pipeline and refresh one bank entry for the current\\nPC. If either bank already matches the current tag, update that bank and set\\nthe MRU bit to it. If neither bank matches, fill the non-MRU bank and then\\nmark that bank MRU. This gives each low-index set two recent tags without a\\nfully-associative victim search.\\n\\nDuring registered lookahead generation for the selected next fetch PC, read\\nboth banks for that next PC's index, compare their compressed tags, and\\nregister the direct hit candidate with bank 0 preferred only if both banks\\nsomehow match. The current IF cycle still selects only between live\\n`io_imemData` and the previously registered candidate guarded by the full\\ncandidate PC match, so `fetch_ready` timing remains essentially the current\\nbest design. Same-cycle fill bypass should cover either bank when the\\nlookahead PC is the word just filled.\\n\\nReset clears only valid bits, MRU bits, and the registered candidate valid\\nstate; tag and instruction payload arrays remain resetless behind valid\\nbits. Redirects and reset flush only the in-flight IF payload and recompute\\nthe next candidate from the selected architectural PC. Replay misses keep\\nthe existing PC-hold and IF-bubble behavior, and EX continues to repair\\nbranch/JAL prediction mistakes through the resolved-next-PC mismatch path.\\nTop-level IO, RVFI NRET=2 ports, channel-0-only retirement, strict\\n`rvfi_order`, the pending-store slot, divider interlock, hot/cold ALU\\nencoding, decoder legality rules, and static backward-branch/direct-JAL\\nprediction policy remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Reorganize the registered lookahead instruction replay predictor into\\ntwo 128-entry direct-mapped banks with compressed high-PC tags and\\nresetless instruction payloads. Add one MRU bit per index to choose the\\nreplacement bank on live fills. During lookahead generation, read both\\nbanks for the selected next PC and register a candidate on a matching\\nbank hit; keep the current-cycle replay selection live-imem-first and\\ndependent only on the previously registered candidate. Preserve redirect\\npriority, fill bypass, fetch_ready semantics, and the existing static\\nbackward-branch/direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to describe the two-bank registered\\nlookahead replay predictor and its MRU replacement policy. Do not change\\nbundle widths, architectural state, decoder legality defaults, RVFI\\nfields, top-level IO, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Reorganize the registered lookahead instruction replay predictor into\\ntwo 128-entry direct-mapped banks with compressed high-PC tags and\\nresetless instruction payloads. Add one MRU bit per index to choose the\\nreplacement bank on live fills. During lookahead generation, read both\\nbanks for the selected next PC and register a candidate on a matching\\nbank hit; keep the current-cycle replay selection live-imem-first and\\ndependent only on the previously registered candidate. Preserve redirect\\npriority, fill bypass, fetch_ready semantics, and the existing static\\nbackward-branch/direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to describe the two-bank registered\\nlookahead replay predictor and its MRU replacement policy. Do not change\\nbundle widths, architectural state, decoder legality defaults, RVFI\\nfields, top-level IO, or the NRET=2 contract.\\n\"}], \"outcome\": \"improvement\", \"fitness\": 577.76, \"delta_pct\": 9.15, \"vs_baseline\": 91.92, \"fmax_mhz\": 198.69, \"ipc_coremark\": 3e-06, \"cycles\": 3438981, \"iterations\": 10, \"lut4\": 5944, \"ff\": 2235, \"seeds\": [202.51, 198.69, 182.82], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes\\n\\n- Replaced the single 256-entry IF replay table in `rtl/if_stage.sv` with two 128-entry direct-mapped banks.\\n- Each bank is indexed by `pc[8:2]`, tagged with `pc[31:9]`, and stores one 32-bit instruction word behind a per-bank valid bit.\\n- Added one MRU bit per index. Live `imem_ready` fills update a matching bank when possible; otherwise they replace the non-MRU bank and mark that bank MRU.\\n- Registered lookahead generation now checks both banks for the selected next fetch PC, with bank 0 preferred if both banks match.\\n- Kept the current IF-cycle replay path live-imem-first and gated only by the previously registered candidate plus full candidate-PC equality.\\n- Preserved same-cycle fill bypass for the just-filled word, redirect priority over stalls, PC-hold replay-miss behavior, and existing static backward-branch/direct-JAL prediction.\\n- Updated the IF/ID replay predictor comments in `rtl/core_pkg.sv`.\\n\\n## Deviations\\n\\n- No architectural or interface deviations from the hypothesis.\\n- The first fill after reset goes to bank 1 because MRU bits reset to 0 and replacement uses the non-MRU bank. This follows the specified MRU policy; the reset MRU value is arbitrary because both bank valid bits are clear.\\n\\n## Concerns\\n\\n- The two-bank lookahead path adds one extra tag compare and a small instruction mux during candidate registration. It remains off the current-cycle fetch-ready/replay-hit path.\\n- The original `bash formal/run_all.sh` command could not run in-place in this sandbox because `formal/riscv-formal` is a symlink to a shared tree outside the writable roots, and the script restages files there. I ran the same script from a writable `/tmp` mirror instead.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: pass from `/tmp/auto_arch_formal.1mIU9v` mirror, `105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:24:46.732378\", \"slot\": 2, \"round_id\": 20}\n62:{\"id\": \"hyp-20260428-055-r21s0\", \"title\": \"Bank-Aware Replay Fill Select\", \"category\": \"micro_opt\", \"motivation\": \"The current best core is dominated by the banked registered instruction\\nreplay predictor plus the hot/cold ALU split. The replay predictor is now\\nboth the largest remaining IPC win and one of the most timing-sensitive IF\\nstructures. Follow-up replay experiments show that changing capacity,\\nindexing, victim search, or cached next-PC metadata usually loses more Fmax\\nthan it recovers, so the next micro-opt should keep the successful two-bank\\norganization and trim redundant logic inside it.\\n\\nThe current banked replay table still does two same-cycle tag comparisons for\\nevery live imem fill:\\n`replay_fill_bank0_match` and `replay_fill_bank1_match` re-read the current\\nPC's indexed set to decide whether to refresh bank 0, refresh bank 1, or\\nreplace the non-MRU bank. But the registered lookahead candidate for the\\ncurrent fetch PC was produced by comparing exactly those two banks on the\\nprevious cycle. If that candidate hits and its PC guard matches the current\\nPC, it already identifies that the word is present and which bank supplied\\nit. If it misses, the previous lookup already proved that neither bank held\\nthe current tag, so replacement can use the non-MRU bank directly.\\n\\nReusing the registered candidate's bank for live fills should remove two\\ncurrent-PC tag compare trees and part of the fill-bank muxing from the IF\\nreplay block while keeping the current replay hit rate, table size, MRU\\npolicy, candidate PC guard, and live-imem-first behavior intact.\\n\", \"hypothesis\": {\"motivation\": \"The current best core is dominated by the banked registered instruction\\nreplay predictor plus the hot/cold ALU split. The replay predictor is now\\nboth the largest remaining IPC win and one of the most timing-sensitive IF\\nstructures. Follow-up replay experiments show that changing capacity,\\nindexing, victim search, or cached next-PC metadata usually loses more Fmax\\nthan it recovers, so the next micro-opt should keep the successful two-bank\\norganization and trim redundant logic inside it.\\n\\nThe current banked replay table still does two same-cycle tag comparisons for\\nevery live imem fill:\\n`replay_fill_bank0_match` and `replay_fill_bank1_match` re-read the current\\nPC's indexed set to decide whether to refresh bank 0, refresh bank 1, or\\nreplace the non-MRU bank. But the registered lookahead candidate for the\\ncurrent fetch PC was produced by comparing exactly those two banks on the\\nprevious cycle. If that candidate hits and its PC guard matches the current\\nPC, it already identifies that the word is present and which bank supplied\\nit. If it misses, the previous lookup already proved that neither bank held\\nthe current tag, so replacement can use the non-MRU bank directly.\\n\\nReusing the registered candidate's bank for live fills should remove two\\ncurrent-PC tag compare trees and part of the fill-bank muxing from the IF\\nreplay block while keeping the current replay hit rate, table size, MRU\\npolicy, candidate PC guard, and live-imem-first behavior intact.\\n\", \"hypothesis\": \"Extend the registered replay candidate with one bank bit indicating whether\\nthe registered instruction came from bank 0 or bank 1. During normal\\nregistered lookahead generation, set this bit from the bank hit selected for\\n`replay_lookup_pc`; during same-index fill bypass, set it to the bank chosen\\nfor the live fill.\\n\\nOn a live `io_imemReady=1` fetch, choose the replay fill bank without\\nrecomparing the current PC against both bank tags. If\\n`replay_cand_valid_q && replay_cand_pc_q == pc`, refresh the bank recorded in\\nthe registered candidate and update the MRU bit to that bank. Otherwise,\\ntreat the current PC as a replay miss and fill the non-MRU bank for that\\nindex, then mark that bank MRU. This preserves the existing policy: matching\\nentries are refreshed in place, and new tags replace the non-MRU bank.\\n\\nThe lookahead path still reads both banks for the selected next fetch PC and\\nregisters a full candidate PC, instruction word, valid bit, and bank bit. The\\ncurrent IF cycle still selects live `io_imemData` whenever it is ready, uses a\\nreplayed instruction only through the existing registered candidate and full\\nPC guard, and bubbles/holds on replay misses exactly as today. Reset still\\nclears bank valid bits, MRU bits, and candidate valid state; tag and\\ninstruction payload arrays remain resetless behind valid bits.\\n\\nThis is intended as a pure timing micro-optimization. It should not change\\nCoreMark cycles, branch/JAL prediction policy, replay contents visible to the\\npipeline, divider behavior, memory ordering, pending-store-slot semantics,\\ntop-level IO, RVFI field widths, channel-0-only retirement, strict\\n`rvfi_order`, or channel-1 tie-off. The expected gain is a small Fmax\\nimprovement from removing redundant live-fill tag compares and reducing\\nreplay fill-bank selection depth in the current best IF block.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a one-bit registered replay candidate bank field. Use the normal\\nlookahead bank-hit result or the same-index fill-bypass bank to populate\\nit. Replace the current live-fill `bank0_match` / `bank1_match`\\nrecomparisons against `pc` with a bank select based on the guarded\\nregistered candidate hit; use the candidate bank for refresh hits and\\nthe non-MRU bank for misses. Preserve the two 128-entry banks,\\ncompressed high-PC tags, resetless payload arrays, full candidate-PC\\nguard, MRU replacement semantics, live-imem priority, fill bypass,\\nredirect priority, `fetch_ready` behavior, and static backward-branch\\nplus direct-JAL prediction.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that the registered\\nlookahead replay candidate also records the bank that produced it, and\\nthat live fills reuse this candidate bank instead of recomparing the\\ncurrent PC against both bank tags. Do not change bundle widths,\\narchitectural state, decoder legality defaults, RVFI fields, top-level\\nIO, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a one-bit registered replay candidate bank field. Use the normal\\nlookahead bank-hit result or the same-index fill-bypass bank to populate\\nit. Replace the current live-fill `bank0_match` / `bank1_match`\\nrecomparisons against `pc` with a bank select based on the guarded\\nregistered candidate hit; use the candidate bank for refresh hits and\\nthe non-MRU bank for misses. Preserve the two 128-entry banks,\\ncompressed high-PC tags, resetless payload arrays, full candidate-PC\\nguard, MRU replacement semantics, live-imem priority, fill bypass,\\nredirect priority, `fetch_ready` behavior, and static backward-branch\\nplus direct-JAL prediction.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that the registered\\nlookahead replay candidate also records the bank that produced it, and\\nthat live fills reuse this candidate bank instead of recomparing the\\ncurrent PC against both bank tags. Do not change bundle widths,\\narchitectural state, decoder legality defaults, RVFI fields, top-level\\nIO, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 446.12, \"delta_pct\": -22.78, \"vs_baseline\": 48.19, \"fmax_mhz\": 153.42, \"ipc_coremark\": 3e-06, \"cycles\": 3438981, \"iterations\": 10, \"lut4\": 5868, \"ff\": 2228, \"seeds\": [158.48, 153.42, 147.3], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"## What changed\\n\\n- Added a one-bit registered replay candidate bank field in `rtl/if_stage.sv`.\\n- Removed the live-fill `pc` tag recomparisons for bank 0 and bank 1.\\n- Live imem fills now refresh `replay_cand_bank_q` when the registered candidate is valid and guarded by `replay_cand_pc_q == pc`; otherwise they replace the non-MRU bank for the current index.\\n- Normal lookahead generation records the selected lookup-hit bank, and same-index fill bypass records the live fill bank.\\n- Updated the IF replay comments in `rtl/core_pkg.sv` and `rtl/if_stage.sv`; no bundle widths, top-level IO, RVFI fields, decoder behavior, or architectural state changed.\\n\\n## Deviations\\n\\n- No behavioral deviation from the hypothesis was intentional.\\n- The requested in-place `bash formal/run_all.sh` command could not stage files in this sandbox because writes/removes under the original `formal/riscv-formal/cores/auto-arch-researcher` path were denied. I ran the same command in a dereferenced temporary copy under `/tmp` so the formal framework staging area was writable without modifying the protected source tree.\\n\\n## Concerns\\n\\n- No known RTL concerns. The change relies on the existing invariant that the registered replay candidate PC tracks the current fetch PC across normal advance, stalls, and redirects; the full PC guard remains in place.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: in-place attempt blocked by sandbox staging permissions before proofs ran.\\n- `bash formal/run_all.sh` in `/tmp/hyp-formal-deref.kqWX1z`: pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:45:01.931271\", \"slot\": 0, \"round_id\": 21}\n63:{\"id\": \"hyp-20260428-056-r21s1\", \"title\": \"Pending Store Slot Load Forwarding\", \"category\": \"structural\", \"motivation\": \"The current best core already has the structural pieces that have survived\\nFPGA evaluation: a one-deep pending-store slot hides normal-RAM store\\nbackpressure, and the banked registered instruction replay predictor hides\\nmost random iStall bubbles. The structural experiments since then show the\\nboundary clearly. Larger store buffers and same-cycle refill failed\\nplacement, same-word store coalescing did not reduce CoreMark cycles, and\\ndata replay tables recovered some load-stall cycles but cost too much Fmax.\\n\\nThe remaining store-slot bottleneck is narrower. When a normal-RAM store has\\nretired into the pending slot, the core currently blocks every younger memory\\noperation until the physical write drains, even if the younger operation is a\\nload of bytes that are already fully present in the pending store entry. That\\ncase does not require a second store-buffer entry or a dmem access: in\\nprogram order the store is already older and retired, so a same-word covered\\nload should read the store slot's bytes. CoreMark's stack, list, and state\\ncode can produce store/load reuse on nearby words, especially under random\\ndmem stalls that keep the slot valid for multiple cycles.\\n\", \"hypothesis\": {\"motivation\": \"The current best core already has the structural pieces that have survived\\nFPGA evaluation: a one-deep pending-store slot hides normal-RAM store\\nbackpressure, and the banked registered instruction replay predictor hides\\nmost random iStall bubbles. The structural experiments since then show the\\nboundary clearly. Larger store buffers and same-cycle refill failed\\nplacement, same-word store coalescing did not reduce CoreMark cycles, and\\ndata replay tables recovered some load-stall cycles but cost too much Fmax.\\n\\nThe remaining store-slot bottleneck is narrower. When a normal-RAM store has\\nretired into the pending slot, the core currently blocks every younger memory\\noperation until the physical write drains, even if the younger operation is a\\nload of bytes that are already fully present in the pending store entry. That\\ncase does not require a second store-buffer entry or a dmem access: in\\nprogram order the store is already older and retired, so a same-word covered\\nload should read the store slot's bytes. CoreMark's stack, list, and state\\ncode can produce store/load reuse on nearby words, especially under random\\ndmem stalls that keep the slot valid for multiple cycles.\\n\", \"hypothesis\": \"Add store-to-load forwarding from the existing pending normal-RAM store slot.\\nWhen the slot is valid and the MEM-stage instruction is a valid, legal,\\naligned normal-RAM load whose word-aligned address matches the pending slot\\nword, allow the load to retire from the slot if its byte read mask is a\\nsubset of the slot's pending write mask. The load must not drive the external\\ndmem port in that case; it uses the slot's replicated write data as the raw\\nword for sign/zero extension and RVFI `mem_rdata`, clears `mem_wait`, and\\nreports the load's own `mem_addr` and `mem_rmask` through MEM/WB.\\n\\nPreserve all existing ordering constraints. Loads whose requested bytes are\\nnot fully covered by the pending store, loads to a different word, younger\\nstores, MMIO/marker/UART accesses, misaligned or trapping memory operations,\\nand all non-normal-RAM accesses still wait behind a valid pending slot exactly\\nas today. The pending slot keeps priority on the physical dmem port while it\\ndrains, including on the same cycle a covered load forwards from it. The\\nlater physical drain of the store creates no extra RVFI event, and the\\nforwarded load retires once in normal channel-0 order.\\n\\nThis is a structural stall-hiding change, not a MEM-to-EX load-data bypass,\\nnot a second store-buffer entry, and not a replay table. It keeps cached data\\nconsumption at the MEM retirement boundary, so dependent younger\\ninstructions still use the existing load-use discipline. The top-level IO,\\nRVFI NRET=2 field set, tied-off channel 1, strict `rvfi_order` sequence,\\nbanked IF replay predictor, hot/cold ALU encoding, divider interlock, branch\\nrecovery, decoder legality defaults, and timing-marker behavior remain\\nunchanged. The expected benefit is a small CoreMark cycle reduction under the\\nrandom dStall model with much lower placement risk than adding another\\nbuffer entry or a data replay table.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/mem_stage.sv\", \"description\": \"Add a pending-store load-forward case to MEM-stage load handling. Accept\\nthe pending slot's byte address, replicated write data, and byte mask as\\ninputs. For valid legal aligned normal-RAM loads, compute the load read\\nmask and word-aligned address, then forward from the slot only when the\\nword address matches and `(load_rmask & ~slot_wmask) == 0`. On a forward\\nhit, suppress `dmem_ren`, clear `mem_wait`, drive load extraction and\\nRVFI `mem_rdata` from the slot data, and preserve the existing wait path\\nfor all misses, partial coverage, traps, MMIO, stores, and nonbufferable\\naccesses.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the pending store slot's drain address, replicated write data, and\\nbyte mask into `mem_stage` for same-word covered-load forwarding. Keep\\nthe existing dmem arbitration unchanged: a valid pending store slot still\\nowns the external dmem port, and live MEM-stage requests use the port\\nonly while the slot is idle or when MEM is not forwarding from the slot.\\nPreserve the core module IO, RVFI channel layout, banked IF replay\\nwiring, strict channel-0 order counter, and channel-1 tie-off.\\n\"}, {\"file\": \"rtl/store_slot.sv\", \"description\": \"Keep the one-entry pending store slot state machine and drain behavior,\\nbut document that its stored byte address, replicated write data, and\\nbyte mask are also used as a forwarding source for younger covered\\nnormal-RAM loads while the slot is valid. Do not add RVFI bookkeeping to\\nthe slot and do not change enqueue, drain, reset, or valid semantics.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Continue consuming the MEM-stage `mem_wait` interlock. Update comments if\\nneeded to clarify that MEM may clear `mem_wait` for a load fully covered\\nby the pending store slot, while all other memory operations behind a\\nvalid slot remain blocked. Do not change imem replay readiness,\\nload-use behavior, EX long-operation stalls, redirect flushes, EX/MEM\\nholds, or MEM/WB hold semantics.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/mem_stage.sv\", \"description\": \"Add a pending-store load-forward case to MEM-stage load handling. Accept\\nthe pending slot's byte address, replicated write data, and byte mask as\\ninputs. For valid legal aligned normal-RAM loads, compute the load read\\nmask and word-aligned address, then forward from the slot only when the\\nword address matches and `(load_rmask & ~slot_wmask) == 0`. On a forward\\nhit, suppress `dmem_ren`, clear `mem_wait`, drive load extraction and\\nRVFI `mem_rdata` from the slot data, and preserve the existing wait path\\nfor all misses, partial coverage, traps, MMIO, stores, and nonbufferable\\naccesses.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the pending store slot's drain address, replicated write data, and\\nbyte mask into `mem_stage` for same-word covered-load forwarding. Keep\\nthe existing dmem arbitration unchanged: a valid pending store slot still\\nowns the external dmem port, and live MEM-stage requests use the port\\nonly while the slot is idle or when MEM is not forwarding from the slot.\\nPreserve the core module IO, RVFI channel layout, banked IF replay\\nwiring, strict channel-0 order counter, and channel-1 tie-off.\\n\"}, {\"file\": \"rtl/store_slot.sv\", \"description\": \"Keep the one-entry pending store slot state machine and drain behavior,\\nbut document that its stored byte address, replicated write data, and\\nbyte mask are also used as a forwarding source for younger covered\\nnormal-RAM loads while the slot is valid. Do not add RVFI bookkeeping to\\nthe slot and do not change enqueue, drain, reset, or valid semantics.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Continue consuming the MEM-stage `mem_wait` interlock. Update comments if\\nneeded to clarify that MEM may clear `mem_wait` for a load fully covered\\nby the pending store slot, while all other memory operations behind a\\nvalid slot remain blocked. Do not change imem replay readiness,\\nload-use behavior, EX long-operation stalls, redirect flushes, EX/MEM\\nholds, or MEM/WB hold semantics.\\n\"}], \"outcome\": \"regression\", \"fitness\": 318.03, \"delta_pct\": -44.95, \"vs_baseline\": 5.64, \"fmax_mhz\": 109.37, \"ipc_coremark\": 3e-06, \"cycles\": 3438981, \"iterations\": 10, \"lut4\": 5951, \"ff\": 2226, \"seeds\": [108.52, 109.37, 125.72], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Pending Store Slot Load Forwarding\\n\\n## Changes\\n\\n- Added a pending-store forwarding path in `rtl/mem_stage.sv`.\\n- Wired the pending store slot drain address, replicated write data, and byte mask from `rtl/core.sv` into MEM.\\n- A MEM-stage load forwards when it is valid, legal, aligned, normal RAM, word-matches the pending store slot, and its byte read mask is fully covered by the slot write mask.\\n- Forwarded loads suppress the live dmem read, clear `mem_wait`, use the slot write data for load extraction and RVFI `mem_rdata`, and report the load's own aligned `mem_addr` and `mem_rmask`.\\n- Pending slot priority on the external dmem port is unchanged in `rtl/core.sv`.\\n- Updated comments in `rtl/store_slot.sv` and `rtl/hazard_unit.sv`.\\n\\n## Deviations\\n\\n- The implementation keeps the existing one-entry slot state machine unchanged.\\n- Misaligned legal memory operations now remain ordered behind a valid pending slot before retiring as traps, matching the hypothesis text that all non-forwarded memory operations behind the slot stay blocked.\\n\\n## Concerns\\n\\n- No known correctness concerns from lint or formal.\\n- The direct `bash formal/run_all.sh` invocation could not stage files because `formal/riscv-formal` is a symlink to a protected path in this sandbox. I ran the same generated-check flow from a `/tmp` copy of the riscv-formal tree instead.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked before proof checks by sandbox delete permissions in `formal/riscv-formal/cores/auto-arch-researcher`.\\n- Equivalent `/tmp` riscv-formal run with current `rtl/*.sv`, `formal/wrapper.sv`, and `formal/checks.cfg`: 105 passed, 0 failed.\\n\", \"timestamp\": \"2026-04-28T08:46:34.062230\", \"slot\": 1, \"round_id\": 21}\n64:{\"id\": \"hyp-20260428-057-r21s2\", \"title\": \"Skewed-Bank I-Fetch Replay Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best predictor is the two-bank registered lookahead instruction\\nreplay table. It is the only predictor-family structure that has delivered a\\nlarge CoreMark gain and a strong Fmax result: it hides random imem stalls by\\nreplaying hot instructions, while the current IF cycle still chooses only\\nbetween live imem data and an already registered candidate.\\n\\nThe remaining replay misses are likely conflict misses. The current two-bank\\ndesign stores two tags per raw `pc[8:2]` set, so any hot instructions spaced\\nby 512-byte multiples still contend for the same two physical slots. Earlier\\nalternatives show the tradeoff boundary: a single-bank XOR index changed the\\nconflict pattern but gave up the benefit of two-way capacity, and a victim\\nbuffer added associative compares that cost more Fmax than the extra hits\\nrecovered. A skewed second bank targets the same conflict class with no extra\\ntable entries, no victim search, and no current-cycle table read.\\n\", \"hypothesis\": {\"motivation\": \"The current best predictor is the two-bank registered lookahead instruction\\nreplay table. It is the only predictor-family structure that has delivered a\\nlarge CoreMark gain and a strong Fmax result: it hides random imem stalls by\\nreplaying hot instructions, while the current IF cycle still chooses only\\nbetween live imem data and an already registered candidate.\\n\\nThe remaining replay misses are likely conflict misses. The current two-bank\\ndesign stores two tags per raw `pc[8:2]` set, so any hot instructions spaced\\nby 512-byte multiples still contend for the same two physical slots. Earlier\\nalternatives show the tradeoff boundary: a single-bank XOR index changed the\\nconflict pattern but gave up the benefit of two-way capacity, and a victim\\nbuffer added associative compares that cost more Fmax than the extra hits\\nrecovered. A skewed second bank targets the same conflict class with no extra\\ntable entries, no victim search, and no current-cycle table read.\\n\", \"hypothesis\": \"Keep the current two-bank registered lookahead replay predictor, but use\\ndifferent indexes for the two banks. Bank 0 remains indexed by the raw\\n`pc[8:2]`. Bank 1 uses a small XOR-folded index such as\\n`pc[8:2] ^ pc[15:9]`. Both banks still store compressed high-PC tags\\n`pc[31:9]`, valid bits, and 32-bit instruction words behind resetless\\npayload arrays.\\n\\nOn live `io_imemReady=1` fetches, preserve live-imem-first behavior. If bank\\n0 at the raw index or bank 1 at the skewed index already matches the fetched\\nPC tag, refresh that matching bank. If neither bank matches, fill the\\npseudo-LRU/non-MRU choice for that PC's raw set, using the raw-index MRU bit\\nas a replacement hint while writing bank 1 at its skewed index. This retains\\nthe existing low-cost replacement state but lets the second candidate slot\\ncome from a different conflict class.\\n\\nDuring registered lookahead generation, read bank 0 at the raw index and\\nbank 1 at the skewed index for the selected next fetch PC, compare their\\ncompressed tags, and register a replay candidate on either hit. The current\\nIF cycle remains unchanged: `fetch_ready` is driven only by live imem\\nreadiness or the previously registered candidate guarded by the full\\ncandidate PC match. Same-cycle fill bypass must use the same bank-specific\\nindexes so a just-fetched word can seed the next candidate when appropriate.\\n\\nCorrectness is still protected by the compressed tag plus the existing full\\ncandidate-PC guard; a skew collision can only evict a useful replay word and\\ncause a miss. Static backward-branch and direct-JAL prediction, redirect\\nrecovery, pending-store behavior, divider interlock, hot/cold ALU encoding,\\ntop-level IO, RVFI NRET=2 ports, strict channel-0 order, and tied-off\\nchannel 1 remain unchanged. The expected benefit is a small iStall cycle\\nreduction with limited Fmax risk because the extra XOR is only in the\\nregistered lookahead/fill path, not the current-cycle replay-hit path.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Change the second replay bank to use a skewed index such as\\n`pc[8:2] ^ pc[15:9]`, while keeping bank 0 on the raw `pc[8:2]` index.\\nApply the bank-specific indexes consistently to live fills, matching,\\nregistered lookahead reads, and same-cycle fill bypass. Preserve the\\ntwo-bank table size, compressed high-PC tags, resetless payload arrays,\\nMRU replacement hint, registered candidate PC guard, live-imem priority,\\nreplay-hit `fetch_ready` semantics, redirect priority, and the existing\\nstatic backward-branch plus direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that the registered\\nlookahead replay predictor uses one raw-index bank and one skew-index\\nbank, both protected by compressed high-PC tags and the registered\\ncurrent-PC guard. Do not change bundle widths, architectural state,\\ndecoder legality defaults, RVFI fields, top-level IO, or the NRET=2\\ncontract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Change the second replay bank to use a skewed index such as\\n`pc[8:2] ^ pc[15:9]`, while keeping bank 0 on the raw `pc[8:2]` index.\\nApply the bank-specific indexes consistently to live fills, matching,\\nregistered lookahead reads, and same-cycle fill bypass. Preserve the\\ntwo-bank table size, compressed high-PC tags, resetless payload arrays,\\nMRU replacement hint, registered candidate PC guard, live-imem priority,\\nreplay-hit `fetch_ready` semantics, redirect priority, and the existing\\nstatic backward-branch plus direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that the registered\\nlookahead replay predictor uses one raw-index bank and one skew-index\\nbank, both protected by compressed high-PC tags and the registered\\ncurrent-PC guard. Do not change bundle widths, architectural state,\\ndecoder legality defaults, RVFI fields, top-level IO, or the NRET=2\\ncontract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 457.76, \"delta_pct\": -20.77, \"vs_baseline\": 52.06, \"fmax_mhz\": 157.6, \"ipc_coremark\": 3e-06, \"cycles\": 3442835, \"iterations\": 10, \"lut4\": 5923, \"ff\": 2225, \"seeds\": [157.6, 164.15, 150.13], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Updated `rtl/if_stage.sv` so replay bank 0 uses the raw `pc[8:2]` index and replay bank 1 uses the skewed `pc[8:2] ^ pc[15:9]` index.\\n- Applied the bank-specific indexes consistently for live-fill matching, fill writes, registered lookahead hits, replay instruction selection, and same-cycle fill bypass.\\n- Kept the existing table sizes, compressed `pc[31:9]` tags, resetless payload arrays, raw-index MRU replacement hint, live-imem priority, registered candidate PC guard, redirect behavior, and static branch/JAL prediction.\\n- Updated the IF/ID replay predictor comments in `rtl/core_pkg.sv` to document the raw/skew bank structure and current-PC guard.\\n\\n## Deviations\\n\\n- No RTL deviations from the hypothesis. The second bank uses the suggested XOR fold `pc[8:2] ^ pc[15:9]`.\\n\\n## Concerns\\n\\n- No known correctness concerns. Bank 1 collisions can evict useful replay entries, but compressed tag plus the registered full-PC candidate guard still protect correctness.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- Direct `bash formal/run_all.sh` from the worktree was blocked by the session sandbox because `formal/riscv-formal` is a symlink outside the writable roots and the script stages files under that tree.\\n- Re-ran the same formal script from a temporary writable mirror under `/tmp` with the updated `rtl/`, `formal/run_all.sh`, `checks.cfg`, `wrapper.sv`, and `riscv-formal` contents: `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:43:28.177000\", \"slot\": 2, \"round_id\": 21}\n65:{\"id\": \"hyp-20260428-058-r22s0\", \"title\": \"Resetless Replay MRU State\", \"category\": \"micro_opt\", \"motivation\": \"The current best design is dominated by the two-bank registered instruction\\nreplay predictor. It is the only predictor-family structure that has both\\nreduced random-iStall cycles and improved Fmax, and the successful\\ncompressed-tag follow-up showed that narrow timing cleanups inside this IF\\nreplay block can still move median fitness without changing CoreMark cycles.\\n\\nThe replay table already leaves tag and instruction payload arrays resetless\\nbehind valid bits, but the per-index MRU replacement bits are still\\nsynchronously reset. Those MRU bits are not architectural state and are not\\nneeded for correctness after reset: both replay-bank valid bits are cleared,\\nso the first live fill for a set may choose either bank. After that fill, the\\nMRU bit is immediately written to the bank that was filled and normal\\nreplacement behavior resumes.\\n\\nRemoving reset from this 128-bit replacement-state array is a narrower\\nversion of the reset-elision idea that has already worked for replay\\npayloads. It targets reset fanout and local IF replay placement pressure\\nwithout changing the current-cycle fetch-ready path, replay hit rate after\\nwarmup, branch/JAL prediction policy, ALU datapath, memory behavior, or RVFI\\nretirement.\\n\", \"hypothesis\": {\"motivation\": \"The current best design is dominated by the two-bank registered instruction\\nreplay predictor. It is the only predictor-family structure that has both\\nreduced random-iStall cycles and improved Fmax, and the successful\\ncompressed-tag follow-up showed that narrow timing cleanups inside this IF\\nreplay block can still move median fitness without changing CoreMark cycles.\\n\\nThe replay table already leaves tag and instruction payload arrays resetless\\nbehind valid bits, but the per-index MRU replacement bits are still\\nsynchronously reset. Those MRU bits are not architectural state and are not\\nneeded for correctness after reset: both replay-bank valid bits are cleared,\\nso the first live fill for a set may choose either bank. After that fill, the\\nMRU bit is immediately written to the bank that was filled and normal\\nreplacement behavior resumes.\\n\\nRemoving reset from this 128-bit replacement-state array is a narrower\\nversion of the reset-elision idea that has already worked for replay\\npayloads. It targets reset fanout and local IF replay placement pressure\\nwithout changing the current-cycle fetch-ready path, replay hit rate after\\nwarmup, branch/JAL prediction policy, ALU datapath, memory behavior, or RVFI\\nretirement.\\n\", \"hypothesis\": \"Make the two-bank instruction replay predictor's MRU replacement bits\\nresetless. On reset, continue clearing both replay-bank valid arrays and the\\nregistered replay-candidate valid bit, but do not assign replay_mru entries.\\nTag and instruction payload arrays remain resetless as today.\\n\\nThe fill-bank selection remains the same logical policy: refresh bank 0 or\\nbank 1 when the indexed high tag already matches, otherwise fill the\\nnon-MRU bank and mark the filled bank MRU. With both valid bits cleared by\\nreset, an arbitrary resetless MRU value can only choose which empty bank gets\\nthe first fill for a set. It cannot make a replay hit valid for the wrong PC,\\nbecause replay selection still requires a bank valid bit, compressed tag\\nmatch, registered candidate valid bit, and full candidate-PC guard.\\n\\nLive io_imemData still has priority whenever io_imemReady is high, replay\\nmisses still hold the PC and inject the existing IF bubble, and replay hits\\nstill feed the selected instruction through the existing static\\nbackward-branch/direct-JAL prediction path. The top-level IO, RVFI NRET=2\\nport set, channel-0-only retirement convention, strict rvfi_order sequence,\\npending-store slot, divider interlock, hot/cold ALU encoding, decoder\\nlegality rules, and channel-1 tie-off remain unchanged.\\n\\nCoreMark cycle count should be unchanged. The expected benefit is a small\\nmedian Fmax improvement from removing reset muxing and reset routing on the\\nreplay MRU bits in the timing-sensitive IF replay block.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Remove replay_mru from the reset loop so only replay_valid_b0,\\nreplay_valid_b1, and replay_cand_valid_q are reset. Keep replay_mru\\nupdated on every live imem fill exactly as today, and preserve the\\ntwo-bank table structure, compressed high-PC tags, resetless tag/data\\npayload arrays, registered candidate PC guard, live-imem priority,\\nsame-index fill bypass, redirect priority, fetch_ready semantics, and\\nstatic backward-branch/direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that replay bank tags,\\ninstruction payloads, and MRU replacement bits are resetless behind\\nreset-cleared valid bits. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Remove replay_mru from the reset loop so only replay_valid_b0,\\nreplay_valid_b1, and replay_cand_valid_q are reset. Keep replay_mru\\nupdated on every live imem fill exactly as today, and preserve the\\ntwo-bank table structure, compressed high-PC tags, resetless tag/data\\npayload arrays, registered candidate PC guard, live-imem priority,\\nsame-index fill bypass, redirect priority, fetch_ready semantics, and\\nstatic backward-branch/direct-JAL prediction behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document that replay bank tags,\\ninstruction payloads, and MRU replacement bits are resetless behind\\nreset-cleared valid bits. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 515.21, \"delta_pct\": -10.83, \"vs_baseline\": 71.14, \"fmax_mhz\": 177.18, \"ipc_coremark\": 3e-06, \"cycles\": 3438981, \"iterations\": 10, \"lut4\": 5964, \"ff\": 2223, \"seeds\": [189.54, 177.18, 176.21], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes\\n\\n- Removed the synchronous reset assignment for `replay_mru` in `rtl/if_stage.sv`.\\n- Kept reset clearing for `replay_valid_b0`, `replay_valid_b1`, and `replay_cand_valid_q`.\\n- Left replay tag and instruction payload arrays resetless.\\n- Preserved the existing fill policy: matching tags refresh their current bank, misses fill the non-MRU bank, and the filled bank becomes MRU.\\n- Updated replay comments in `rtl/if_stage.sv` and `rtl/core_pkg.sv` to document that MRU replacement bits are resetless behind reset-cleared valid state.\\n\\n## Deviations\\n\\n- No functional deviation from the hypothesis.\\n- `bash formal/run_all.sh` could not complete directly in this sandbox because `formal/riscv-formal` is a symlink to a shared checkout outside the writable worktree, and the script stages files under that tree. I ran the same staging, genchecks, make, and pass/fail tally flow from a writable `/tmp` copy of `riscv-formal`.\\n\\n## Concerns\\n\\n- No RTL concerns. After reset, both replay bank valid arrays are cleared, so the resetless MRU bit only chooses which empty bank receives the first post-reset fill for each set.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- Local formal equivalent to `bash formal/run_all.sh` from `/tmp` staging: pass, 105 passed / 0 failed.\\n\", \"timestamp\": \"2026-04-28T08:57:52.187641\", \"slot\": 0, \"round_id\": 22}\n66:{\"id\": \"hyp-20260428-059-r22s1\", \"title\": \"Replay-Assisted ALU Pair Dual Issue\", \"category\": \"structural\", \"motivation\": \"The current best core is now a fast single-issue design: cold DIV/REM is\\noff the EX datapath, the hot/cold ALU split improved Fmax, the one-entry\\nstore slot hides some dmem store stalls, and the two-bank registered\\ninstruction replay predictor hides most random iStall bubbles. The largest\\nremaining structural ceiling is therefore the single-retire backend. The\\ntop-level RVFI contract already exposes NRET=2, but channel 1 is unused.\\n\\nA normal dual-issue frontend would be unattractive because the external imem\\nport supplies only one 32-bit word per cycle. The banked replay predictor\\nchanges that tradeoff: after warmup, hot straight-line CoreMark code often\\nhas both the current instruction and the next sequential instruction in the\\nreplay table. That creates a narrow path to use RVFI channel 1 without\\nwidening the external memory interface or adding a full instruction cache.\\n\\nThe most promising structural angle is to issue a second instruction only\\nfor low-risk adjacent simple-integer pairs. This targets CoreMark's dense\\naddress, loop, CRC, and scalar arithmetic sequences while avoiding the\\nplacement failures seen from larger store buffers and the Fmax losses seen\\nfrom load replay tables, return predictors, and wider replay structures.\\n\", \"hypothesis\": {\"motivation\": \"The current best core is now a fast single-issue design: cold DIV/REM is\\noff the EX datapath, the hot/cold ALU split improved Fmax, the one-entry\\nstore slot hides some dmem store stalls, and the two-bank registered\\ninstruction replay predictor hides most random iStall bubbles. The largest\\nremaining structural ceiling is therefore the single-retire backend. The\\ntop-level RVFI contract already exposes NRET=2, but channel 1 is unused.\\n\\nA normal dual-issue frontend would be unattractive because the external imem\\nport supplies only one 32-bit word per cycle. The banked replay predictor\\nchanges that tradeoff: after warmup, hot straight-line CoreMark code often\\nhas both the current instruction and the next sequential instruction in the\\nreplay table. That creates a narrow path to use RVFI channel 1 without\\nwidening the external memory interface or adding a full instruction cache.\\n\\nThe most promising structural angle is to issue a second instruction only\\nfor low-risk adjacent simple-integer pairs. This targets CoreMark's dense\\naddress, loop, CRC, and scalar arithmetic sequences while avoiding the\\nplacement failures seen from larger store buffers and the Fmax losses seen\\nfrom load replay tables, return predictors, and wider replay structures.\\n\", \"hypothesis\": \"Add a replay-assisted two-wide issue mode for adjacent straight-line RV32I\\nsimple-integer instruction pairs. Lane 0 remains the existing older\\ninstruction path. Lane 1 is enabled only when the instruction at pc+4 is\\nalready available from the registered replay frontend and both instructions\\nare eligible simple operations: OP, OP-IMM, LUI, or AUIPC with no memory\\naccess, no branch or jump, no SYSTEM/FENCE side effects, no illegal decode,\\nand no M-extension or divider-long operation. If any eligibility check fails,\\nthe core falls back to the current single-issue behavior.\\n\\nThe pair issue predicate must be conservative. Do not issue lane 1 when\\nlane 1 reads lane 0's destination, when both lanes write the same nonzero\\ndestination, when either lane depends on a load-use interlock, when a MEM\\nwait or divider hold is active, or when a redirect/flush is pending. For a\\nvalid pair, fetch advances by pc+8; for every other cycle, the existing\\nstatic branch/direct-JAL prediction and replay-hit behavior continues to\\ndrive the next PC exactly as today. Since lane 1 is never control-flow or\\nmemory, no second dmem access or second branch redirect is introduced.\\n\\nAdd a second simple ALU lane and carry lane-1 metadata through EX/MEM and\\nMEM/WB beside lane 0. Both lanes retire together only when the shared MEM/WB\\nboundary is not held. RVFI channel 0 reports the older lane-0 instruction\\nwith order N, and RVFI channel 1 reports the younger lane-1 instruction\\nwith order N+1. Single-retire cycles still place the sole retirement on\\nchannel 0 with channel 1 fully driven to zero. The RVFI order counter must\\nincrement by two on dual-retire cycles and by one on single-retire cycles.\\n\\nThe register file should gain the minimal extra ports needed for lane-1\\noperands and dual writeback. If both lanes write in the same cycle, writes\\noccur in program order so lane 1 is architecturally younger; the pair\\npredicate may also simply disallow same-rd pairs to keep this path small.\\nExisting EX/MEM and MEM/WB forwarding remains authoritative for lane 0, and\\nlane 1 can use the same forwarding sources plus the conservative pair\\ndependency checks to avoid same-cycle lane0-to-lane1 bypassing.\\n\\nThis is intentionally not a general superscalar core. It is a replay-fed\\nALU-pair fast path that preserves the current single-issue behavior for all\\nmemory, control-flow, illegal, M-extension, stalled, and uncertain cases.\\nThe top-level IO shape, memory ordering, pending-store slot semantics,\\ndivider interlock, branch/JAL resolved-next-PC recovery, decoder\\nillegal-default discipline, and NRET=2 RVFI field widths remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add lane-1 pipeline metadata or paired bundle fields beside the existing\\nIF/ID, ID/EX, EX/MEM, and MEM/WB payloads. Include per-lane valid,\\ndecoded control, source/destination registers, operands, PC, instruction,\\nprediction metadata, and RVFI-visible source/result fields. Keep the\\nexisting lane-0 fields semantically unchanged and document that lane 1\\nis a restricted simple-integer younger instruction.\\n\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Extend the banked registered replay frontend to provide an optional\\npc+4 instruction candidate for lane 1. The second candidate may come\\nonly from replay, not from a second external imem read. Advance the PC\\nby pc+8 only when ID accepts a valid dual-issue pair; otherwise preserve\\nthe current live-imem/replay selection, pc+4, branch, direct-JAL, flush,\\nredirect, and replay-miss behavior.\\n\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Decode lane 0 as today and decode the optional lane-1 candidate with a\\nconservative simple-integer eligibility check. Generate a dual-issue\\naccept bit only for legal adjacent OP/OP-IMM/LUI/AUIPC pairs with no\\nlane-to-lane RAW or WAW hazard and no control, memory, M-extension,\\nSYSTEM, FENCE, or illegal instruction in either lane.\\n\"}, {\"file\": \"rtl/reg_file.sv\", \"description\": \"Add the extra read and write capability needed for the restricted\\nsecond lane. Preserve x0 hardwiring and write-first behavior. If two\\nnonzero writes occur in one cycle, commit them in program order with\\nlane 0 older and lane 1 younger, or rely on the pair predicate to\\nsuppress same-destination pairs.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add a second simple ALU execution path for lane 1 using the same RV32I\\nALU semantics as lane 0 but excluding memory, control-flow, and long\\nM-extension operations. Carry lane-1 metadata into EX/MEM only when the\\ndual-issue predicate is valid and the shared pipeline is not stalled.\\nKeep lane-0 divider, branch/JAL/JALR redirect, forwarding, and trap\\nbehavior unchanged.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"Extend forwarding decisions for the second lane using existing EX/MEM\\nand MEM/WB producer metadata, while preserving lane-0 priority and the\\ncurrent load-use discipline. The pair predicate should avoid requiring\\nsame-cycle lane0-to-lane1 forwarding.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add conservative dual-issue gating to the existing stall network. Any\\nload-use hazard, MEM wait, divider long operation, imem/replay miss,\\nredirect, flush, or uncertain lane-1 source dependency should suppress\\nlane 1 and fall back to single issue without changing the existing\\nlane-0 stall, flush, EX/MEM hold, or MEM/WB hold behavior.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Carry lane-1 simple-ALU results through the shared MEM/WB boundary\\nwithout adding a second dmem request. Lane 1 must be invalid whenever\\nlane 0 is a memory operation that is waiting, trapping, or otherwise\\nunable to retire. Preserve all existing load/store, misalignment,\\npending-store-slot, RVFI memory-field, and hold_wb behavior for lane 0.\\n\"}, {\"file\": \"rtl/wb_stage.sv\", \"description\": \"Add writeback selection for an optional second simple-ALU lane. Generate\\nindependent lane-0 and lane-1 write enables and data, preserving x0\\nsuppression and program-order write semantics.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the two-lane pipeline, dual writeback, and dual RVFI retirement.\\nChannel 0 must always carry the older retirement; channel 1 is valid\\nonly for accepted paired lane-1 instructions and is otherwise tied to\\nzero. Update the segmented RVFI order counter by two on dual-retire\\ncycles and by one on single-retire cycles while preserving the top-level\\ncore IO exactly.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add lane-1 pipeline metadata or paired bundle fields beside the existing\\nIF/ID, ID/EX, EX/MEM, and MEM/WB payloads. Include per-lane valid,\\ndecoded control, source/destination registers, operands, PC, instruction,\\nprediction metadata, and RVFI-visible source/result fields. Keep the\\nexisting lane-0 fields semantically unchanged and document that lane 1\\nis a restricted simple-integer younger instruction.\\n\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Extend the banked registered replay frontend to provide an optional\\npc+4 instruction candidate for lane 1. The second candidate may come\\nonly from replay, not from a second external imem read. Advance the PC\\nby pc+8 only when ID accepts a valid dual-issue pair; otherwise preserve\\nthe current live-imem/replay selection, pc+4, branch, direct-JAL, flush,\\nredirect, and replay-miss behavior.\\n\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Decode lane 0 as today and decode the optional lane-1 candidate with a\\nconservative simple-integer eligibility check. Generate a dual-issue\\naccept bit only for legal adjacent OP/OP-IMM/LUI/AUIPC pairs with no\\nlane-to-lane RAW or WAW hazard and no control, memory, M-extension,\\nSYSTEM, FENCE, or illegal instruction in either lane.\\n\"}, {\"file\": \"rtl/reg_file.sv\", \"description\": \"Add the extra read and write capability needed for the restricted\\nsecond lane. Preserve x0 hardwiring and write-first behavior. If two\\nnonzero writes occur in one cycle, commit them in program order with\\nlane 0 older and lane 1 younger, or rely on the pair predicate to\\nsuppress same-destination pairs.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add a second simple ALU execution path for lane 1 using the same RV32I\\nALU semantics as lane 0 but excluding memory, control-flow, and long\\nM-extension operations. Carry lane-1 metadata into EX/MEM only when the\\ndual-issue predicate is valid and the shared pipeline is not stalled.\\nKeep lane-0 divider, branch/JAL/JALR redirect, forwarding, and trap\\nbehavior unchanged.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"Extend forwarding decisions for the second lane using existing EX/MEM\\nand MEM/WB producer metadata, while preserving lane-0 priority and the\\ncurrent load-use discipline. The pair predicate should avoid requiring\\nsame-cycle lane0-to-lane1 forwarding.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add conservative dual-issue gating to the existing stall network. Any\\nload-use hazard, MEM wait, divider long operation, imem/replay miss,\\nredirect, flush, or uncertain lane-1 source dependency should suppress\\nlane 1 and fall back to single issue without changing the existing\\nlane-0 stall, flush, EX/MEM hold, or MEM/WB hold behavior.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Carry lane-1 simple-ALU results through the shared MEM/WB boundary\\nwithout adding a second dmem request. Lane 1 must be invalid whenever\\nlane 0 is a memory operation that is waiting, trapping, or otherwise\\nunable to retire. Preserve all existing load/store, misalignment,\\npending-store-slot, RVFI memory-field, and hold_wb behavior for lane 0.\\n\"}, {\"file\": \"rtl/wb_stage.sv\", \"description\": \"Add writeback selection for an optional second simple-ALU lane. Generate\\nindependent lane-0 and lane-1 write enables and data, preserving x0\\nsuppression and program-order write semantics.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the two-lane pipeline, dual writeback, and dual RVFI retirement.\\nChannel 0 must always carry the older retirement; channel 1 is valid\\nonly for accepted paired lane-1 instructions and is otherwise tied to\\nzero. Update the segmented RVFI order counter by two on dual-retire\\ncycles and by one on single-retire cycles while preserving the top-level\\ncore IO exactly.\\n\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"cosim_failed: selftest.elf\", \"slot\": 1, \"round_id\": 22}\n67:{\"id\": \"hyp-20260428-060-r22s2\", \"title\": \"Stream-Resistant Replay Insertion\", \"category\": \"predictor\", \"motivation\": \"The current best predictor is the two-bank registered lookahead instruction\\nreplay table, which reached 577.76 fitness by hiding random imem stalls\\nwithout putting a same-cycle table lookup on the IF decision path. Follow-up\\npredictor attempts show the remaining boundary clearly: adding more branch\\ndirection state, return prediction, victim search, skewed indexing, cached\\nnext-PC metadata, or bank-aware fill logic either saved too few cycles or\\ncost more Fmax than it recovered.\\n\\nThe least intrusive remaining replay opportunity is replacement policy. The\\ncurrent two-bank table uses a per-index MRU bit and marks every miss-filled\\nentry as MRU. That is a normal two-way cache policy, but it is vulnerable to\\none-shot or low-reuse instruction streams, wrong-path fetches, and cold helper\\ncode displacing hot-loop replay entries. CoreMark repeatedly executes compact\\nloops, so protecting the most recently hit replay word from streaming\\npollution may recover some random-iStall hits without adding a table, a tag\\ncompare, a branch update path, or any current-cycle fetch-ready logic.\\n\", \"hypothesis\": {\"motivation\": \"The current best predictor is the two-bank registered lookahead instruction\\nreplay table, which reached 577.76 fitness by hiding random imem stalls\\nwithout putting a same-cycle table lookup on the IF decision path. Follow-up\\npredictor attempts show the remaining boundary clearly: adding more branch\\ndirection state, return prediction, victim search, skewed indexing, cached\\nnext-PC metadata, or bank-aware fill logic either saved too few cycles or\\ncost more Fmax than it recovered.\\n\\nThe least intrusive remaining replay opportunity is replacement policy. The\\ncurrent two-bank table uses a per-index MRU bit and marks every miss-filled\\nentry as MRU. That is a normal two-way cache policy, but it is vulnerable to\\none-shot or low-reuse instruction streams, wrong-path fetches, and cold helper\\ncode displacing hot-loop replay entries. CoreMark repeatedly executes compact\\nloops, so protecting the most recently hit replay word from streaming\\npollution may recover some random-iStall hits without adding a table, a tag\\ncompare, a branch update path, or any current-cycle fetch-ready logic.\\n\", \"hypothesis\": \"Keep the current two-bank registered lookahead replay predictor exactly the\\nsame in size, indexing, compressed tags, resetless payload arrays, full\\ncandidate-PC guard, fill bypass, and live-imem-first behavior. Change only\\nthe per-set insertion policy.\\n\\nOn a live `io_imemReady=1` fetch that hits an existing bank entry, refresh\\nthat bank and mark it MRU as today. On a miss where one bank is invalid, fill\\nthe invalid bank and mark it MRU so cold startup still quickly populates both\\nways. On a miss where both banks are valid, fill the non-MRU bank but leave\\nthe MRU bit pointing at the older protected bank. The newly inserted line is\\ntherefore the replacement candidate until it proves reuse by a later hit.\\n\\nThis is a stream-resistant replay insertion policy, similar in spirit to a\\ntiny bimodal insertion policy but with no new counters or throttle state. It\\ncan only affect replay hit rate: tags and the existing registered candidate\\nPC guard still prevent wrong instructions from entering the pipeline, replay\\nmisses still hold the PC and inject the existing IF bubble, and live imem\\ndata remains authoritative whenever ready. Static backward-branch and direct\\nJAL prediction, EX resolved-next-PC repair, pending-store behavior, divider\\ninterlock, hot/cold ALU encoding, top-level IO, RVFI NRET=2 ports, strict\\nchannel-0 order, and tied-off channel 1 remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Modify only the two-bank replay predictor's MRU update policy. Keep the\\nexisting bank match detection and replacement bank selection, but on a\\nlive-fill miss with both banks valid, write the non-MRU bank without\\nchanging the MRU bit. Continue marking hit fills and invalid-bank fills\\nas MRU. Preserve both 128-entry banks, raw `pc[8:2]` indexing,\\ncompressed `pc[31:9]` tags, resetless payload arrays, registered\\ncandidate PC guard, same-index fill bypass, live-imem priority,\\nreplay-hit `fetch_ready` semantics, redirect priority, and static\\nbackward-branch plus direct-JAL prediction.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document the stream-resistant\\ninsertion policy: replay hits and cold invalid fills update the MRU bit,\\nwhile both-valid miss fills replace the non-MRU bank without immediately\\nmaking the new line MRU. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Modify only the two-bank replay predictor's MRU update policy. Keep the\\nexisting bank match detection and replacement bank selection, but on a\\nlive-fill miss with both banks valid, write the non-MRU bank without\\nchanging the MRU bit. Continue marking hit fills and invalid-bank fills\\nas MRU. Preserve both 128-entry banks, raw `pc[8:2]` indexing,\\ncompressed `pc[31:9]` tags, resetless payload arrays, registered\\ncandidate PC guard, same-index fill bypass, live-imem priority,\\nreplay-hit `fetch_ready` semantics, redirect priority, and static\\nbackward-branch plus direct-JAL prediction.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID replay comments to document the stream-resistant\\ninsertion policy: replay hits and cold invalid fills update the MRU bit,\\nwhile both-valid miss fills replace the non-MRU bank without immediately\\nmaking the new line MRU. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 390.36, \"delta_pct\": -32.44, \"vs_baseline\": 29.67, \"fmax_mhz\": 136.18, \"ipc_coremark\": 3e-06, \"cycles\": 3488613, \"iterations\": 10, \"lut4\": 5938, \"ff\": 2223, \"seeds\": [141.04, 136.18, 129.84], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Updated `rtl/if_stage.sv` so live imem fills still write the matched bank or the selected replacement bank, but the per-set MRU bit is only refreshed on replay-table hits or on misses where at least one bank is invalid.\\n- Both-valid live-fill misses continue to replace the non-MRU bank, but now preserve the existing MRU bit so the newly inserted line remains the next replacement candidate until it is hit later.\\n- Updated the IF/ID replay predictor comments in `rtl/core_pkg.sv` to document the stream-resistant insertion policy.\\n\\n## Deviations\\n\\n- No functional deviations from the hypothesis. The table size, indexing, compressed tags, resetless payload arrays, registered candidate PC guard, same-index fill bypass, live-imem priority, replay-hit fetch-ready behavior, redirect priority, and static branch/JAL prediction were left unchanged.\\n\\n## Concerns\\n\\n- No known RTL correctness concerns. The direct `bash formal/run_all.sh` command could not stage files in this sandbox because `formal/riscv-formal` is a symlink to a shared directory outside the writable worktree and `rm` returned `Operation not permitted`.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked before checks by sandbox permissions on the shared `formal/riscv-formal/cores/auto-arch-researcher` staging directory.\\n- Equivalent formal run from a writable `/tmp` mirror of `formal/run_all.sh` and riscv-formal support files, with this worktree's `rtl/` symlinked in: pass, `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T08:59:10.877288\", \"slot\": 2, \"round_id\": 22}\n68:{\"id\": \"hyp-20260428-061-r23s0\", \"title\": \"Power-of-Two RAM Range Decode\", \"category\": \"micro_opt\", \"motivation\": \"The current best design has already captured the large timing wins: cold\\nDIV/REM is off the EX datapath, the hot/cold ALU split simplified the common\\nresult mux, the RVFI order counter is segmented, and the banked registered\\ninstruction replay predictor hides most random iStall loss. Recent broader\\nmicro-opt attempts that changed replay replacement, reset policy, ALU\\nfunct3 encoding, or source-qualified hazards tended to lose Fmax through\\nplacement noise or extra muxing. The next micro_opt should therefore be a\\nvery narrow equivalence rewrite on logic that is still always present.\\n\\nThe MEM stage still classifies bufferable stores with an unsigned 32-bit\\ncomparison against `32'h0010_0000`. That limit is exactly 1 MiB, so for a\\n32-bit byte address the predicate is equivalent to `addr[31:20] == 0`.\\nThe result feeds store-slot enqueue and MEM backpressure, which in turn\\ndrives the global stall network. Replacing the generic less-than form with\\nan explicit high-bit decode should remove carry/comparator structure from\\nthe store-bufferable path without changing the direct ready-store behavior,\\npending-store semantics, memory ordering, or CoreMark cycle count.\\n\", \"hypothesis\": {\"motivation\": \"The current best design has already captured the large timing wins: cold\\nDIV/REM is off the EX datapath, the hot/cold ALU split simplified the common\\nresult mux, the RVFI order counter is segmented, and the banked registered\\ninstruction replay predictor hides most random iStall loss. Recent broader\\nmicro-opt attempts that changed replay replacement, reset policy, ALU\\nfunct3 encoding, or source-qualified hazards tended to lose Fmax through\\nplacement noise or extra muxing. The next micro_opt should therefore be a\\nvery narrow equivalence rewrite on logic that is still always present.\\n\\nThe MEM stage still classifies bufferable stores with an unsigned 32-bit\\ncomparison against `32'h0010_0000`. That limit is exactly 1 MiB, so for a\\n32-bit byte address the predicate is equivalent to `addr[31:20] == 0`.\\nThe result feeds store-slot enqueue and MEM backpressure, which in turn\\ndrives the global stall network. Replacing the generic less-than form with\\nan explicit high-bit decode should remove carry/comparator structure from\\nthe store-bufferable path without changing the direct ready-store behavior,\\npending-store semantics, memory ordering, or CoreMark cycle count.\\n\", \"hypothesis\": \"Replace the normal-RAM range check used for store buffering in\\n`rtl/mem_stage.sv` with an explicit power-of-two high-bit decode. A legal\\naligned normal-RAM store should be considered bufferable when the effective\\nbyte address has `in.alu_result[31:20] == 12'b0`; this is bit-identical to\\nthe existing unsigned check `in.alu_result < 32'h0010_0000` for the current\\nRAM window `[0x00000000, 0x00100000)`.\\n\\nKeep all other memory behavior unchanged. Misaligned or illegal memory\\noperations still trap and do not issue dmem requests. MMIO, UART, timing\\nmarker, and any other non-RAM stores remain nonbufferable and still wait for\\nthe external dmem handshake. The pending store slot still enqueues only on a\\nbufferable store when the slot is empty and `io_dmemReady` is low, and live\\nloads/stores still observe the same `mem_wait` behavior as today.\\n\\nThis is intended as a pure synthesis-shape micro-optimization. It does not\\nalter the top-level IO, RVFI NRET=2 field set, channel-0-only retirement\\nconvention, strict `rvfi_order` sequence, banked IF replay predictor,\\nhot/cold ALU encoding, divider interlock, branch recovery, load extraction,\\nstore byte masks, pending-store drain behavior, or decoder legality\\ndiscipline. The expected effect is a small median Fmax improvement from\\nreplacing a 32-bit range comparator in the MEM/stall path with a 12-bit\\nzero-detect, with no intended change to iterations per cycle.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/mem_stage.sv\", \"description\": \"Replace the `in.alu_result < NORMAL_RAM_LIMIT` store-bufferable test\\nwith an explicit upper-address zero check for the 1 MiB RAM window,\\ne.g. `in.alu_result[31:20] == 12'b0`. Keep `NORMAL_RAM_LIMIT` only if\\nit remains useful for comments, or replace it with a local upper-bit\\nconstant. Preserve all existing `mem_access`, misalignment trap,\\ndmem request gating, pending-store enqueue, `mem_wait`, MEM/WB, and\\nRVFI memory-field behavior.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 1, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/mem_stage.sv\", \"description\": \"Replace the `in.alu_result < NORMAL_RAM_LIMIT` store-bufferable test\\nwith an explicit upper-address zero check for the 1 MiB RAM window,\\ne.g. `in.alu_result[31:20] == 12'b0`. Keep `NORMAL_RAM_LIMIT` only if\\nit remains useful for comments, or replace it with a local upper-bit\\nconstant. Preserve all existing `mem_access`, misalignment trap,\\ndmem request gating, pending-store enqueue, `mem_wait`, MEM/WB, and\\nRVFI memory-field behavior.\\n\"}], \"outcome\": \"regression\", \"fitness\": 577.76, \"delta_pct\": 0.0, \"vs_baseline\": 91.92, \"fmax_mhz\": 198.69, \"ipc_coremark\": 3e-06, \"cycles\": 3438981, \"iterations\": 10, \"lut4\": 5944, \"ff\": 2235, \"seeds\": [202.51, 198.69, 182.82], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Updated `rtl/mem_stage.sv` so normal-RAM store buffering uses an explicit\\n  high-address decode:\\n  `in.alu_result[31:20] == 12'b0`.\\n- Removed the 32-bit unsigned `< 32'h0010_0000` comparator from the\\n  `store_bufferable` predicate.\\n- Kept the existing `mem_access`, misalignment trap, dmem request gating,\\n  pending-store enqueue, `mem_wait`, MEM/WB, and RVFI memory-field behavior\\n  unchanged.\\n\\n## Deviations\\n\\n- No RTL behavior deviations from the hypothesis.\\n- The direct in-worktree `bash formal/run_all.sh` invocation could not start\\n  proof work in this sandbox because `formal/riscv-formal` is a symlink to a\\n  shared read-only tree and the script must remove/copy staged core files\\n  under `formal/riscv-formal/cores/auto-arch-researcher`.\\n- To self-check the same gate, I copied the worktree to `/tmp`, replaced the\\n  riscv-formal symlink there with a writable copy of the framework excluding\\n  stale `cores/`, and ran the original `bash formal/run_all.sh` from that\\n  writable temp copy.\\n\\n## Concerns\\n\\n- No known implementation concerns. The decode is bit-equivalent to\\n  `addr < 32'h0010_0000` for 32-bit byte addresses.\\n\\n## Local verification status\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: pass in writable temp-copy staging,\\n  `Formal: 105 passed, 0 failed`.\\n- RTL fix attempts after formal: 0.\\n\", \"timestamp\": \"2026-04-28T11:48:35.228512\", \"slot\": 0, \"round_id\": 23}\n69:{\"id\": \"hyp-20260428-062-r23s1\", \"title\": \"MEM-Wait Simple-ALU Skid Slot\", \"category\": \"structural\", \"motivation\": \"The current best core is a fast single-issue design with the largest proven\\nwins already in place: cold DIV/REM is off the EX datapath, the hot/cold ALU\\nsplit improved Fmax, the one-entry pending-store slot hides some store-only\\ndmem stalls, and the banked registered instruction replay predictor hides\\nmost random imem stalls. The remaining structural loss is therefore mainly\\nbackend pressure from dmem waits, especially loads. Today a load in MEM with\\n`io_dmemReady=0` freezes IF, ID, and EX even when the younger instruction in\\nID/EX is an independent simple ALU operation whose operands are already\\navailable and whose execution has no memory or control-flow side effects.\\n\\nPrior attempts to attack this bottleneck by replaying load data or adding\\nbroader store buffering reduced cycles but cost too much Fmax or placement\\nquality. A smaller structural decoupling point is more promising: let EX do\\none cycle of useful independent simple-ALU work while the older MEM load or\\nnonbufferable store is waiting, but keep retirement strictly in order. This\\ntargets the exact full-pipeline freeze caused by random dmem backpressure\\nwithout adding load data to EX, another replay table, another store-buffer\\nentry, a branch predictor, or a general superscalar backend.\\n\", \"hypothesis\": {\"motivation\": \"The current best core is a fast single-issue design with the largest proven\\nwins already in place: cold DIV/REM is off the EX datapath, the hot/cold ALU\\nsplit improved Fmax, the one-entry pending-store slot hides some store-only\\ndmem stalls, and the banked registered instruction replay predictor hides\\nmost random imem stalls. The remaining structural loss is therefore mainly\\nbackend pressure from dmem waits, especially loads. Today a load in MEM with\\n`io_dmemReady=0` freezes IF, ID, and EX even when the younger instruction in\\nID/EX is an independent simple ALU operation whose operands are already\\navailable and whose execution has no memory or control-flow side effects.\\n\\nPrior attempts to attack this bottleneck by replaying load data or adding\\nbroader store buffering reduced cycles but cost too much Fmax or placement\\nquality. A smaller structural decoupling point is more promising: let EX do\\none cycle of useful independent simple-ALU work while the older MEM load or\\nnonbufferable store is waiting, but keep retirement strictly in order. This\\ntargets the exact full-pipeline freeze caused by random dmem backpressure\\nwithout adding load data to EX, another replay table, another store-buffer\\nentry, a branch predictor, or a general superscalar backend.\\n\", \"hypothesis\": \"Add a one-entry stall-only skid slot for an instruction that has completed EX\\nwhile the older EX/MEM instruction is held in MEM by `mem_wait`. On the first\\ncycle of a MEM wait, if ID/EX contains a valid independent simple RV32I ALU\\ninstruction, capture its fully resolved EX/MEM payload into the skid slot\\ninstead of discarding that cycle. Eligible skid instructions are limited to\\nside-effect-free, non-control, non-memory, non-M-extension operations such as\\nOP, OP-IMM, LUI, and AUIPC. The slot must not accept branches, jumps, loads,\\nstores, FENCE/SYSTEM, illegal instructions, DIV/REM, high-latency operations,\\nor anything whose source depends on the older waiting load.\\n\\nWhile the skid slot is valid, IF and ID remain stalled so no second younger\\ninstruction can overtake it. When the MEM wait clears, the older instruction\\nadvances and retires normally first; the skid entry is then injected into the\\nEX/MEM-to-MEM path as the next in-order instruction without re-executing it.\\nIf no skid entry is present, the pipeline behaves exactly as it does today.\\nThe no-stall fast path should remain structurally close to the current best:\\nEX writes directly into EX/MEM on normal cycles, and the skid slot is only\\nused when EX/MEM would otherwise be held by a precise MEM wait.\\n\\nThis is not out-of-order retirement and not dual issue. It is a single-entry\\nexecution skid buffer behind an older blocked MEM operation. RVFI channel 0\\nremains the only retirement channel, channel 1 stays tied off, and\\n`rvfi_order` still increments by one per visible retirement. Branch/JAL/JALR\\nrecovery, the banked IF replay predictor, pending-store slot ordering,\\ndivider interlock, decoder illegal-default discipline, top-level IO, memory\\naccess bounds, and timing-marker behavior remain unchanged. The expected\\nbenefit is a modest CoreMark cycle reduction under the random dStall model\\nwith less Fmax exposure than MEM-stage load replay or larger store buffers,\\nbecause the added state is one EX/MEM-shaped entry used only on stall cycles.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add a small skid payload typedef if useful, or document reuse of the\\nexisting `ex_mem_t` as the one-entry EX skid slot. Clarify that skid\\nentries are valid only for conservative simple-ALU instructions that\\nhave already completed EX and are waiting behind an older MEM-stage wait.\\nDo not change RVFI fields, top-level ports, decoder legality defaults,\\nALU op constants, architectural state semantics, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add stall-only capture of an eligible younger simple-ALU instruction into\\na one-entry skid slot when the normal EX/MEM register is held by\\n`mem_wait`. Capture the same post-forwarded operands, ALU result, rd,\\nsource metadata, instruction, PC, and control payload that would normally\\nenter EX/MEM. Provide controls to mark the ID/EX instruction consumed,\\nhold further younger work while the slot is full, and later inject the\\nskid entry into EX/MEM after the older MEM wait clears. Preserve normal\\nno-stall EX/MEM behavior, divider launch/completion, redirect generation,\\nforwarding inputs, and RVFI metadata for lane-0 single issue.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add precise control for the skid capture and drain states. During a MEM\\nwait, allow exactly one eligible ID/EX simple-ALU instruction to be\\nconsumed into the skid slot when the slot is empty; otherwise keep the\\ncurrent IF/ID stalls. Once the slot is valid, stall IF and ID until the\\nolder MEM wait clears and the skid entry can drain in order. Keep the\\nexisting load-use interlock, imem replay readiness, EX long-operation\\nstall, redirect flushes, EX/MEM hold, and MEM/WB hold semantics intact.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the skid-slot status and capture/drain controls between EX,\\nhazard, and the existing MEM wait path. Gate skid eligibility with valid\\nstage metadata and conservative control checks so resetless or invalid\\npayloads cannot be captured. Preserve the core module IO, RVFI NRET=2\\nchannel layout, strict channel-0 order counter, tied-off channel 1,\\npending-store-slot dmem arbitration, banked IF replay wiring, and\\nwriteback behavior.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"If needed, make the existing forwarding producer metadata aware of the\\ndrained skid entry exactly as it is aware of a normal EX/MEM producer.\\nDo not introduce load-data forwarding or lane-to-lane bypassing; the\\nskid entry should carry only a previously completed simple-ALU result and\\nshould preserve the current priority of EX/MEM over MEM/WB forwarding.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add a small skid payload typedef if useful, or document reuse of the\\nexisting `ex_mem_t` as the one-entry EX skid slot. Clarify that skid\\nentries are valid only for conservative simple-ALU instructions that\\nhave already completed EX and are waiting behind an older MEM-stage wait.\\nDo not change RVFI fields, top-level ports, decoder legality defaults,\\nALU op constants, architectural state semantics, or the NRET=2 contract.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add stall-only capture of an eligible younger simple-ALU instruction into\\na one-entry skid slot when the normal EX/MEM register is held by\\n`mem_wait`. Capture the same post-forwarded operands, ALU result, rd,\\nsource metadata, instruction, PC, and control payload that would normally\\nenter EX/MEM. Provide controls to mark the ID/EX instruction consumed,\\nhold further younger work while the slot is full, and later inject the\\nskid entry into EX/MEM after the older MEM wait clears. Preserve normal\\nno-stall EX/MEM behavior, divider launch/completion, redirect generation,\\nforwarding inputs, and RVFI metadata for lane-0 single issue.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add precise control for the skid capture and drain states. During a MEM\\nwait, allow exactly one eligible ID/EX simple-ALU instruction to be\\nconsumed into the skid slot when the slot is empty; otherwise keep the\\ncurrent IF/ID stalls. Once the slot is valid, stall IF and ID until the\\nolder MEM wait clears and the skid entry can drain in order. Keep the\\nexisting load-use interlock, imem replay readiness, EX long-operation\\nstall, redirect flushes, EX/MEM hold, and MEM/WB hold semantics intact.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the skid-slot status and capture/drain controls between EX,\\nhazard, and the existing MEM wait path. Gate skid eligibility with valid\\nstage metadata and conservative control checks so resetless or invalid\\npayloads cannot be captured. Preserve the core module IO, RVFI NRET=2\\nchannel layout, strict channel-0 order counter, tied-off channel 1,\\npending-store-slot dmem arbitration, banked IF replay wiring, and\\nwriteback behavior.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"If needed, make the existing forwarding producer metadata aware of the\\ndrained skid entry exactly as it is aware of a normal EX/MEM producer.\\nDo not introduce load-data forwarding or lane-to-lane bypassing; the\\nskid entry should carry only a previously completed simple-ALU result and\\nshould preserve the current priority of EX/MEM over MEM/WB forwarding.\\n\"}], \"outcome\": \"regression\", \"fitness\": 469.85, \"delta_pct\": -18.68, \"vs_baseline\": 56.08, \"fmax_mhz\": 161.58, \"ipc_coremark\": 3e-06, \"cycles\": 3438981, \"iterations\": 10, \"lut4\": 5908, \"ff\": 2225, \"seeds\": [158.88, 169.98, 161.58], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Added a one-entry MEM-wait skid slot inside `rtl/ex_stage.sv`, reusing the existing `ex_mem_t` payload shape.\\n- Added `skid_capture`, `skid_drain`, and `skid_valid` controls between `core`, `hazard_unit`, and `ex_stage`.\\n- During a precise `mem_wait`, hazard can consume one valid simple RV32I ALU instruction from ID/EX, clear ID/EX, and keep IF held behind it.\\n- When the MEM wait clears, EX injects the captured payload into the normal EX/MEM register so MEM/WB and RVFI retirement remain single-channel and in order.\\n- Added conservative skid eligibility in `rtl/core.sv`: OP, OP-IMM, LUI, and AUIPC only; no illegal, memory, control-flow, M-extension, or load-dependent source operands.\\n- Documented in `rtl/core_pkg.sv` that the skid slot reuses `ex_mem_t`.\\n\\n## Deviations\\n\\n- No new typedef was added. Reusing `ex_mem_t` keeps the skid payload identical to the normal EX/MEM register.\\n- IF/ID is released on the same clock edge that a valid skid entry drains into EX/MEM. The younger instruction cannot execute until the following cycle, so it still remains behind the drained skid instruction without adding an extra bubble.\\n\\n## Concerns\\n\\n- The eligibility gate is intentionally conservative and may miss some harmless captures, especially false rs2 dependencies on OP-IMM immediate bits are avoided but other uncommon safe cases are not pursued.\\n- This adds a small combinational eligibility/control path in `core.sv` and a second `ex_mem_t` register in EX; Fmax impact remains for the FPGA gate to measure.\\n\\n## Local verification\\n\\n- Lint: `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv` passed.\\n- Formal: direct `bash formal/run_all.sh` in this sandbox failed before proof because `formal/riscv-formal` points outside the writable root and the script could not clean its generated core directory.\\n- Formal workaround: staged the current `rtl/` plus formal wrapper/configs into `/tmp/autoarch-formal-r23s1` with a writable copy of the riscv-formal framework, then ran the same `bash formal/run_all.sh`. Result: `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T11:50:58.385213\", \"slot\": 1, \"round_id\": 23}\n70:{\"id\": \"hyp-20260428-063-r23s2\", \"title\": \"Low-Bit Static Target Alignment Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best result is the two-bank registered instruction replay\\npredictor plus the hot/cold ALU split. The replay predictor is the only\\npredictor-family structure that has produced a large CoreMark cycle win and\\na strong Fmax result. Follow-up predictor attempts that added more state,\\nchanged replacement, added victim/skewed indexing, cached next-PC metadata,\\nor added branch-direction tables generally lost more Fmax than they recovered.\\n\\nThe next predictor hypothesis should therefore avoid new predictor memories\\nand preserve the successful two-bank replay structure. The remaining\\nlow-risk predictor timing issue is in the zero-state static control\\npredictor itself: IF currently waits for the full branch and JAL target\\nadders to produce `[1:0]` before deciding whether the predicted target is\\nword-aligned. For B-type and J-type immediates, bit 0 is always zero and bit\\n1 of the target can be derived from `pc[1]` and one encoded immediate bit.\\n\\nA previous single-adder static-control rewrite removed a target adder but\\nintroduced a selected-immediate mux before the target add and regressed. This\\nhypothesis is narrower: keep the existing branch and JAL target adders, but\\nremove their low-bit outputs from the prediction-enable path. That should\\nkeep CoreMark cycles identical while shortening the IF predictor select path\\nin the current best frontend.\\n\", \"hypothesis\": {\"motivation\": \"The current best result is the two-bank registered instruction replay\\npredictor plus the hot/cold ALU split. The replay predictor is the only\\npredictor-family structure that has produced a large CoreMark cycle win and\\na strong Fmax result. Follow-up predictor attempts that added more state,\\nchanged replacement, added victim/skewed indexing, cached next-PC metadata,\\nor added branch-direction tables generally lost more Fmax than they recovered.\\n\\nThe next predictor hypothesis should therefore avoid new predictor memories\\nand preserve the successful two-bank replay structure. The remaining\\nlow-risk predictor timing issue is in the zero-state static control\\npredictor itself: IF currently waits for the full branch and JAL target\\nadders to produce `[1:0]` before deciding whether the predicted target is\\nword-aligned. For B-type and J-type immediates, bit 0 is always zero and bit\\n1 of the target can be derived from `pc[1]` and one encoded immediate bit.\\n\\nA previous single-adder static-control rewrite removed a target adder but\\nintroduced a selected-immediate mux before the target add and regressed. This\\nhypothesis is narrower: keep the existing branch and JAL target adders, but\\nremove their low-bit outputs from the prediction-enable path. That should\\nkeep CoreMark cycles identical while shortening the IF predictor select path\\nin the current best frontend.\\n\", \"hypothesis\": \"Refine the IF-stage static branch/JAL predictor so target word alignment is\\nchecked from encoded low bits instead of from the full target-adder result.\\nFor B-type branches, the predicted target is word-aligned when `pc[0] == 0`\\nand `(pc[1] ^ fetch_instr[8]) == 0`, because the branch immediate's bit 1 is\\nencoded in `instr[8]`. For JAL, the corresponding check is `pc[0] == 0` and\\n`(pc[1] ^ fetch_instr[21]) == 0`, because the J immediate's bit 1 is encoded\\nin `instr[21]`. The existing misaligned-target trap behavior in EX remains\\nauthoritative for all real control-flow instructions.\\n\\nKeep the prediction policy exactly the same as the current best design:\\nlegal backward conditional branches predict taken, direct aligned JALs\\npredict their encoded target, and JALR remains unpredicted. Keep the\\nexisting parallel branch and JAL target adders for the actual predicted\\ntarget value, so this does not repeat the earlier single-adder mux\\nexperiment. Only the alignment guard feeding `branch_predict_taken` and\\n`jal_predict_taken` changes.\\n\\nThis is correctness-neutral because the low-bit equations are exactly the\\nlow two bits of `pc + imm` for B/J immediates, whose bit 0 is fixed zero.\\nIf any future alias or unusual PC state violated the assumption, EX still\\nrepairs wrong control-flow with the existing resolved-next-PC mismatch path\\nand traps misaligned targets as today. The two-bank replay predictor,\\nreplay hit/miss behavior, live-imem priority, fill bypass, pending-store\\nslot, divider interlock, hot/cold ALU encoding, top-level IO, RVFI NRET=2\\nfields, strict channel-0 order sequence, and channel-1 tie-off remain\\nunchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Replace the `branch_target[1:0] == 2'b00` and\\n`jal_target[1:0] == 2'b00` prediction guards with low-bit predecode\\nbased on `pc[0]`, `pc[1]`, `fetch_instr[8]`, and `fetch_instr[21]`.\\nKeep the existing branch and JAL target adders for the selected\\npredicted target value, preserve the current legal-branch guard,\\nbackward-branch-taken policy, direct-JAL prediction, JALR-unpredicted\\nbehavior, two-bank replay predictor, candidate PC guard, fill bypass,\\nredirect priority, and `fetch_ready` semantics.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID prediction comments to document that the static\\nbranch/JAL predictor derives target alignment from encoded low immediate\\nbits while still carrying the same `predicted_taken` and\\n`predicted_target` metadata. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Replace the `branch_target[1:0] == 2'b00` and\\n`jal_target[1:0] == 2'b00` prediction guards with low-bit predecode\\nbased on `pc[0]`, `pc[1]`, `fetch_instr[8]`, and `fetch_instr[21]`.\\nKeep the existing branch and JAL target adders for the selected\\npredicted target value, preserve the current legal-branch guard,\\nbackward-branch-taken policy, direct-JAL prediction, JALR-unpredicted\\nbehavior, two-bank replay predictor, candidate PC guard, fill bypass,\\nredirect priority, and `fetch_ready` semantics.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Update only IF/ID prediction comments to document that the static\\nbranch/JAL predictor derives target alignment from encoded low immediate\\nbits while still carrying the same `predicted_taken` and\\n`predicted_target` metadata. Do not change bundle widths, architectural\\nstate, decoder legality defaults, RVFI fields, top-level IO, or the\\nNRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 490.61, \"delta_pct\": -15.08, \"vs_baseline\": 62.97, \"fmax_mhz\": 168.72, \"ipc_coremark\": 3e-06, \"cycles\": 3438981, \"iterations\": 10, \"lut4\": 5911, \"ff\": 2222, \"seeds\": [175.41, 168.38, 168.72], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What Changed\\n\\n- Updated `rtl/if_stage.sv` so IF static branch/JAL prediction no longer uses\\n  `branch_target[1:0]` or `jal_target[1:0]` in the prediction-enable path.\\n- Added low-bit alignment predecode:\\n  - B-type branch target word alignment: `pc[0] == 0` and\\n    `(pc[1] ^ fetch_instr[8]) == 0`.\\n  - JAL target word alignment: `pc[0] == 0` and\\n    `(pc[1] ^ fetch_instr[21]) == 0`.\\n- Kept the existing parallel branch and JAL target adders for\\n  `predicted_target`.\\n- Updated `rtl/core_pkg.sv` IF/ID and ID/EX prediction comments to document\\n  encoded-low-bit static alignment predecode while preserving the existing\\n  `predicted_taken` / `predicted_target` metadata contract.\\n\\n## Deviations\\n\\n- No RTL behavioral deviations from the hypothesis plan.\\n- The direct `bash formal/run_all.sh` command could not stage files because\\n  `formal/riscv-formal` is a symlink to a repository outside the writable\\n  worktree, and this sandbox denied its cleanup writes with\\n  `Operation not permitted`. To keep the self-check meaningful without\\n  modifying `formal/`, I copied the formal runner/framework to `/tmp`, symlinked\\n  the current `rtl/` directory into that temporary project root, and ran the\\n  same `run_all.sh` flow there.\\n\\n## Concerns\\n\\n- No implementation concerns. EX remains authoritative for resolved next-PC\\n  mismatch repair and misaligned-target traps.\\n\\n## Local Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked before checks by sandbox permission on the\\n  repository's symlinked formal staging directory.\\n- Equivalent temporary-workspace formal run using the same `run_all.sh`: pass,\\n  `Formal: 105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T11:46:33.299974\", \"slot\": 2, \"round_id\": 23}\n71:{\"id\": \"hyp-20260428-064-r24s0\", \"title\": \"Unsigned Multiplier With Signed High Correction\", \"category\": \"micro_opt\", \"motivation\": \"The current best core has already harvested the broad timing wins: DIV/REM is\\niterative, the ALU has a hot/cold RV32I/RV32M split, RVFI order is segmented,\\nand the banked registered instruction replay predictor hides most random\\niStall cycles. The next micro_opt should therefore avoid new predictor state,\\nqueues, reset rewrites, or latency changes and instead trim logic still\\npresent in the hot EX arithmetic block.\\n\\n`rtl/alu.sv` still builds three independent 64-bit products for RV32M\\nmultiply: unsigned*unsigned, signed*signed, and signed*unsigned. CoreMark's\\ntimed region needs low-half MUL, but high-half MULH/MULHU/MULHSU are cold.\\nPrior multiplier experiments showed what not to do: a muxed 33x33 shared\\nmultiplier badly hurt Fmax, and moving high-half multiply to a long-latency\\nunit also regressed. A better micro-optimization is to keep the existing\\nunsigned 32x32 product for the hot MUL path and derive the signed high halves\\nwith narrow correction subtracts after the product.\\n\", \"hypothesis\": {\"motivation\": \"The current best core has already harvested the broad timing wins: DIV/REM is\\niterative, the ALU has a hot/cold RV32I/RV32M split, RVFI order is segmented,\\nand the banked registered instruction replay predictor hides most random\\niStall cycles. The next micro_opt should therefore avoid new predictor state,\\nqueues, reset rewrites, or latency changes and instead trim logic still\\npresent in the hot EX arithmetic block.\\n\\n`rtl/alu.sv` still builds three independent 64-bit products for RV32M\\nmultiply: unsigned*unsigned, signed*signed, and signed*unsigned. CoreMark's\\ntimed region needs low-half MUL, but high-half MULH/MULHU/MULHSU are cold.\\nPrior multiplier experiments showed what not to do: a muxed 33x33 shared\\nmultiplier badly hurt Fmax, and moving high-half multiply to a long-latency\\nunit also regressed. A better micro-optimization is to keep the existing\\nunsigned 32x32 product for the hot MUL path and derive the signed high halves\\nwith narrow correction subtracts after the product.\\n\", \"hypothesis\": \"Replace the signed*signed and signed*unsigned multiplier expressions in\\n`rtl/alu.sv` with correction logic derived from the existing unsigned\\nproduct. Keep one unsigned product `mul_uu = {32'b0, a} * {32'b0, b}`.\\n`MUL` continues to return `mul_uu[31:0]`, and `MULHU` returns\\n`mul_uu[63:32]`.\\n\\nFor signed high-half operations, use the standard two's-complement correction\\nidentities on the high 32 bits of the unsigned product:\\n\\n- `MULH`: `mul_uu[63:32] - (a[31] ? b : 0) - (b[31] ? a : 0)`\\n- `MULHSU`: `mul_uu[63:32] - (a[31] ? b : 0)`\\n\\nThese formulas are bit-exact modulo 32 bits for RV32M because the omitted\\nsign*sign term is a multiple of 2^64 and does not affect the low 64 product\\nbits. The hot low-half MUL path remains a direct unsigned product with no\\noperand signedness mux and no extra latency. High-half variants remain\\nsingle-cycle and architecturally exact, avoiding the IPC risk of the prior\\nlong-latency high-half experiment.\\n\\nKeep the existing hot/cold `op[4] ? m_out : simple_out` ALU split, keep the\\nRISCV_FORMAL_ALTOPS multiply substitutions unchanged, and leave DIV/REM in\\nthe iterative divider. No forwarding, stall, branch prediction, memory,\\nreplay-table, RVFI, top-level IO, retirement-order, or channel-1 behavior\\nchanges. CoreMark cycles should be unchanged; the expected benefit is a\\nmodest Fmax improvement from removing two always-present wide multiplier\\nprimitives and their routing pressure while avoiding the failed 33x33\\npre-multiplier mux shape.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove the `mul_ss` and `mul_su` product expressions. Keep the existing\\nunsigned 32x32 product for `MUL` and `MULHU`, and compute `MULH` and\\n`MULHSU` high halves from `mul_uu[63:32]` with the signed correction\\nsubtracts described above. Preserve the current ALTOPS formulas, the\\ndummy zero result for DIV/REM opcodes handled by `div_unit.sv`, and the\\nfinal hot/cold `op[4]` result select.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove the `mul_ss` and `mul_su` product expressions. Keep the existing\\nunsigned 32x32 product for `MUL` and `MULHU`, and compute `MULH` and\\n`MULHSU` high halves from `mul_uu[63:32]` with the signed correction\\nsubtracts described above. Preserve the current ALTOPS formulas, the\\ndummy zero result for DIV/REM opcodes handled by `div_unit.sv`, and the\\nfinal hot/cold `op[4]` result select.\\n\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"sandbox_violation: agent touched off-limits paths: ['test/_helpers.py']\", \"slot\": 0, \"round_id\": 24}\n72:{\"id\": \"hyp-20260428-065-r24s1\", \"title\": \"Replay-Fed Memory Plus ADDI Pair Issue\", \"category\": \"structural\", \"motivation\": \"The current best core is a very strong single-issue design. The large wins\\nalready come from removing cold DIV/REM from the hot EX path, splitting the\\nALU hot/cold mux, adding a one-deep pending-store slot, segmenting the RVFI\\norder counter, and using a two-bank registered instruction replay predictor\\nto hide most random imem stalls. Recent structural attempts show that broad\\nbuffers, data replay tables, and general dual issue are too costly or too\\ndifficult, but they also point at the remaining ceiling: only one instruction\\ncan retire per cycle even when CoreMark presents simple pointer updates next\\nto memory operations.\\n\\nCoreMark's list, matrix, state, and stack code is dense with patterns such as\\na load or store followed by an independent ADDI pointer/index/stack update.\\nA full two-wide machine is risky, but this very narrow pair class uses only\\nthe existing single dmem access plus one younger simple immediate add. It\\ntargets a common structural bubble source without adding another memory port,\\nanother replay table, a load-data-to-EX bypass, a branch predictor, or a\\nsecond general ALU issue path.\\n\", \"hypothesis\": {\"motivation\": \"The current best core is a very strong single-issue design. The large wins\\nalready come from removing cold DIV/REM from the hot EX path, splitting the\\nALU hot/cold mux, adding a one-deep pending-store slot, segmenting the RVFI\\norder counter, and using a two-bank registered instruction replay predictor\\nto hide most random imem stalls. Recent structural attempts show that broad\\nbuffers, data replay tables, and general dual issue are too costly or too\\ndifficult, but they also point at the remaining ceiling: only one instruction\\ncan retire per cycle even when CoreMark presents simple pointer updates next\\nto memory operations.\\n\\nCoreMark's list, matrix, state, and stack code is dense with patterns such as\\na load or store followed by an independent ADDI pointer/index/stack update.\\nA full two-wide machine is risky, but this very narrow pair class uses only\\nthe existing single dmem access plus one younger simple immediate add. It\\ntargets a common structural bubble source without adding another memory port,\\nanother replay table, a load-data-to-EX bypass, a branch predictor, or a\\nsecond general ALU issue path.\\n\", \"hypothesis\": \"Add a restricted replay-fed pair issue mode for an older memory instruction\\nin lane 0 and a younger adjacent ADDI in lane 1. Lane 0 remains the existing\\nsingle-issue path and may be a legal aligned LOAD or STORE. Lane 1 is enabled\\nonly when the instruction at pc+4 is already available from the registered\\ninstruction replay frontend and decodes exactly as a legal ADDI that has no\\ncontrol-flow, memory, SYSTEM/FENCE, illegal, or M-extension behavior. If the\\nlane-1 replay candidate is absent or any check is uncertain, the core falls\\nback to the current single-issue behavior.\\n\\nThe pair predicate must be conservative. Do not issue lane 1 when it reads\\nthe lane-0 load destination, when both lanes write the same nonzero rd, when\\na load-use hazard, MEM wait, divider long operation, redirect, flush, or\\nreplay miss is active, or when lane 0 is a trapping/misaligned memory access.\\nIt is explicitly allowed for lane 1 to update the base register used by the\\nolder memory access, because lane 0's address and store data are computed\\nfrom the old operands before the younger ADDI writes back. Stores still use\\nthe single dmem port; loads still produce their data at MEM; both lanes wait\\ntogether under dmem backpressure and retire in order.\\n\\nFor accepted pairs, fetch advances to pc+8. Lane 0 carries normal memory\\nmetadata through EX/MEM and MEM/WB. Lane 1 carries only a simple ADDI result,\\nsource metadata, rd, instruction, pc, and pc+4/pc+8 next-PC metadata beside\\nlane 0; it never drives dmem and never redirects. At the MEM/WB boundary,\\nretire lane 0 on RVFI channel 0 with order N and lane 1 on channel 1 with\\norder N+1. Single-retire cycles remain exactly as today: channel 0 carries\\nthe sole retirement and channel 1 is fully tied to zero. The segmented RVFI\\norder counter increments by two only on a dual-retire cycle.\\n\\nThis is not a general superscalar core. It is a narrow memory-plus-ADDI\\nstructural fast path aimed at CoreMark pointer updates. The top-level IO,\\nmemory ordering, pending-store slot semantics, divider interlock,\\nbranch/JAL/JALR resolved-next-PC recovery, decoder illegal-default behavior,\\nRVFI NRET=2 field widths, and timing-marker behavior remain unchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Extend the registered two-bank replay frontend to provide an optional\\npc+4 instruction candidate for lane 1. The second word may come only from\\nreplay, not from a second external imem read. Advance the architectural\\nPC by pc+8 only when the downstream pair-issue accept signal is true;\\notherwise preserve the existing live-imem/replay selection, pc+4,\\nbranch, direct-JAL, flush, redirect, and replay-miss behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add compact lane-1 metadata beside the existing pipeline bundles for the\\nrestricted younger ADDI: valid, pc, instruction, rs1/rd, rs1 value,\\nimmediate, result, and RVFI-visible fields. Keep lane-0 bundle semantics\\nunchanged and document that lane 1 is only valid for replay-fed ADDI\\npairs behind an older memory instruction.\\n\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Decode the optional pc+4 candidate with the existing decoder and produce\\na conservative pair-eligible signal only for legal ADDI. Read the extra\\nlane-1 rs1 operand, reject all lane-to-lane hazards that would require a\\nsame-cycle bypass from a lane-0 load, and keep the current single-issue\\ndecode path unchanged when the pair is not accepted.\\n\"}, {\"file\": \"rtl/reg_file.sv\", \"description\": \"Add the minimal extra read and write capability for the lane-1 ADDI path.\\nPreserve x0 hardwiring and write-first behavior. On dual retirement,\\ncommit lane-0 and lane-1 writes in program order, or rely on the pair\\npredicate to suppress same-destination nonzero pairs so the final\\narchitectural register state is unambiguous.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add a small lane-1 ADDI adder and metadata path that advances only for an\\naccepted memory-plus-ADDI pair. Lane 0 keeps the existing ALU, memory\\naddress generation, forwarding, divider, and redirect behavior. Lane 1\\nnever issues memory or control-flow operations and is invalidated on any\\nlane-0 trap, redirect, long operation, or pipeline hold.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Carry lane-1 ADDI results through the MEM/WB boundary beside the lane-0\\nmemory operation without adding a second dmem request. If lane 0 waits\\nfor dmem or the pending-store slot, lane 1 waits with it and does not\\nretire early. Preserve all existing load/store, misalignment, store-slot,\\nMEM/WB hold, and RVFI memory-field behavior for lane 0.\\n\"}, {\"file\": \"rtl/wb_stage.sv\", \"description\": \"Generate independent writeback controls for lane 0 and the optional\\nlane-1 ADDI. Suppress x0 writes and preserve program-order write\\nsemantics on dual-retire cycles. Keep the existing single-lane writeback\\nbehavior bit-identical when lane 1 is invalid.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add pair-issue gating to the existing stall network. Suppress lane 1 on\\nany load-use hazard, MEM wait, EX long operation, redirect, flush, replay\\nmiss, or uncertain source dependency. The lane-0 stall, flush, EX/MEM\\nhold, and MEM/WB hold behavior remains the authority for precise\\nsingle-issue operation.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"Extend forwarding only as needed for lane-1 ADDI operands from existing\\nolder EX/MEM and MEM/WB producers. Do not add load-data forwarding from\\nMEM into EX and do not require a same-cycle lane0-to-lane1 bypass; the\\nconservative pair predicate should reject those cases.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the restricted pair pipeline, dual writeback, pair PC advance, and\\ndual RVFI retirement. Channel 0 must always report the older lane-0\\ninstruction; channel 1 is valid only for the younger lane-1 ADDI and is\\notherwise tied to zero. Update the segmented RVFI order counter by two on\\ndual-retire cycles and by one on single-retire cycles while preserving\\nthe top-level core IO exactly.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Extend the registered two-bank replay frontend to provide an optional\\npc+4 instruction candidate for lane 1. The second word may come only from\\nreplay, not from a second external imem read. Advance the architectural\\nPC by pc+8 only when the downstream pair-issue accept signal is true;\\notherwise preserve the existing live-imem/replay selection, pc+4,\\nbranch, direct-JAL, flush, redirect, and replay-miss behavior.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add compact lane-1 metadata beside the existing pipeline bundles for the\\nrestricted younger ADDI: valid, pc, instruction, rs1/rd, rs1 value,\\nimmediate, result, and RVFI-visible fields. Keep lane-0 bundle semantics\\nunchanged and document that lane 1 is only valid for replay-fed ADDI\\npairs behind an older memory instruction.\\n\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Decode the optional pc+4 candidate with the existing decoder and produce\\na conservative pair-eligible signal only for legal ADDI. Read the extra\\nlane-1 rs1 operand, reject all lane-to-lane hazards that would require a\\nsame-cycle bypass from a lane-0 load, and keep the current single-issue\\ndecode path unchanged when the pair is not accepted.\\n\"}, {\"file\": \"rtl/reg_file.sv\", \"description\": \"Add the minimal extra read and write capability for the lane-1 ADDI path.\\nPreserve x0 hardwiring and write-first behavior. On dual retirement,\\ncommit lane-0 and lane-1 writes in program order, or rely on the pair\\npredicate to suppress same-destination nonzero pairs so the final\\narchitectural register state is unambiguous.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add a small lane-1 ADDI adder and metadata path that advances only for an\\naccepted memory-plus-ADDI pair. Lane 0 keeps the existing ALU, memory\\naddress generation, forwarding, divider, and redirect behavior. Lane 1\\nnever issues memory or control-flow operations and is invalidated on any\\nlane-0 trap, redirect, long operation, or pipeline hold.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Carry lane-1 ADDI results through the MEM/WB boundary beside the lane-0\\nmemory operation without adding a second dmem request. If lane 0 waits\\nfor dmem or the pending-store slot, lane 1 waits with it and does not\\nretire early. Preserve all existing load/store, misalignment, store-slot,\\nMEM/WB hold, and RVFI memory-field behavior for lane 0.\\n\"}, {\"file\": \"rtl/wb_stage.sv\", \"description\": \"Generate independent writeback controls for lane 0 and the optional\\nlane-1 ADDI. Suppress x0 writes and preserve program-order write\\nsemantics on dual-retire cycles. Keep the existing single-lane writeback\\nbehavior bit-identical when lane 1 is invalid.\\n\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add pair-issue gating to the existing stall network. Suppress lane 1 on\\nany load-use hazard, MEM wait, EX long operation, redirect, flush, replay\\nmiss, or uncertain source dependency. The lane-0 stall, flush, EX/MEM\\nhold, and MEM/WB hold behavior remains the authority for precise\\nsingle-issue operation.\\n\"}, {\"file\": \"rtl/forward_unit.sv\", \"description\": \"Extend forwarding only as needed for lane-1 ADDI operands from existing\\nolder EX/MEM and MEM/WB producers. Do not add load-data forwarding from\\nMEM into EX and do not require a same-cycle lane0-to-lane1 bypass; the\\nconservative pair predicate should reject those cases.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the restricted pair pipeline, dual writeback, pair PC advance, and\\ndual RVFI retirement. Channel 0 must always report the older lane-0\\ninstruction; channel 1 is valid only for the younger lane-1 ADDI and is\\notherwise tied to zero. Update the segmented RVFI order counter by two on\\ndual-retire cycles and by one on single-retire cycles while preserving\\nthe top-level core IO exactly.\\n\"}], \"outcome\": \"placement_failed\", \"formal_passed\": true, \"cosim_passed\": true, \"error\": \"placement_failed\", \"seeds\": [49.43, null, null], \"slot\": 1, \"round_id\": 24}\n73:{\"id\": \"hyp-20260428-066-r24s2\", \"title\": \"Registered Lookahead JALR Target Predictor\", \"category\": \"predictor\", \"motivation\": \"The current best predictor structure is the two-bank registered instruction\\nreplay table. It is the only predictor-family mechanism that has produced a\\nlarge CoreMark cycle win without putting a same-cycle table lookup on the IF\\ndecision path. Follow-up replay changes, direction tables, return stacks,\\nvictim buffers, skewed indexes, and cached static next-PC metadata mostly\\nlost more Fmax than they recovered.\\n\\nThe remaining control-flow hole is narrower: JALR still resolves only in EX.\\nEvery return and indirect call therefore pays the wrong-path recovery cost\\neven when the target is stable from one execution of that JALR PC to the\\nnext. Earlier return predictors showed that JALR bubbles exist, but they put\\ncurrent-cycle compares or stack bookkeeping directly in IF. The successful\\nreplay predictor suggests a better timing shape: look up any target state one\\ncycle ahead, register a candidate for the current fetch PC, and keep the\\ncurrent IF cycle dependent only on that candidate plus the fetched\\ninstruction's opcode bits.\\n\", \"hypothesis\": {\"motivation\": \"The current best predictor structure is the two-bank registered instruction\\nreplay table. It is the only predictor-family mechanism that has produced a\\nlarge CoreMark cycle win without putting a same-cycle table lookup on the IF\\ndecision path. Follow-up replay changes, direction tables, return stacks,\\nvictim buffers, skewed indexes, and cached static next-PC metadata mostly\\nlost more Fmax than they recovered.\\n\\nThe remaining control-flow hole is narrower: JALR still resolves only in EX.\\nEvery return and indirect call therefore pays the wrong-path recovery cost\\neven when the target is stable from one execution of that JALR PC to the\\nnext. Earlier return predictors showed that JALR bubbles exist, but they put\\ncurrent-cycle compares or stack bookkeeping directly in IF. The successful\\nreplay predictor suggests a better timing shape: look up any target state one\\ncycle ahead, register a candidate for the current fetch PC, and keep the\\ncurrent IF cycle dependent only on that candidate plus the fetched\\ninstruction's opcode bits.\\n\", \"hypothesis\": \"Add a small registered lookahead target predictor for legal JALR\\ninstructions. Use a direct-mapped table, for example eight entries indexed by\\nJALR PC bits, with valid bits, full or non-index PC tags, and a 32-bit\\nresolved target. The table is read using the same selected next-fetch PC that\\nalready drives the registered instruction replay lookahead candidate:\\nredirect target first, then predicted/fallthrough next PC when fetch\\nadvances, otherwise the held PC. The current IF cycle may use only the\\nregistered JALR target candidate for the current PC; it must not perform a\\nfresh target-table read on the fetch-ready path.\\n\\nIF predicts a JALR only when the fetched instruction is a legal JALR encoding\\n(`opcode=1100111`, `funct3=000`), the registered target candidate matches the\\ncurrent PC, and the stored target is word-aligned. The prediction uses the\\nexisting `predicted_taken` and `predicted_target` metadata path. Conditional\\nbranch prediction, direct-JAL prediction, instruction replay hits, live-imem\\npriority, and replay-miss PC holds remain exactly as in the current best\\ndesign.\\n\\nEX updates the target table when a valid non-trapping JALR advances into\\nEX/MEM, storing that JALR PC and its resolved aligned target. JALR redirect\\ngeneration changes from unconditional redirect to the same resolved-next-PC\\nmismatch repair used by predicted branches and direct JALs. Uncached or\\nincorrectly cached JALRs still redirect in EX because their carried predicted\\nnext PC is `pc+4` or the wrong target. Correctly cached JALRs avoid the\\nrecovery flush. If a JALR resolves as a misaligned-target trap, EX treats the\\nresolved next PC as `pc+4` and redirects there if IF had used a stale cached\\ntarget, preserving RVFI `pc_wdata` and the next-retired-PC relation.\\n\\nThis is deliberately not a branch-direction table, BTB for all control flow,\\nor return-address stack. It targets only repeated JALR PCs with a registered\\nlookahead candidate. A tag alias or dynamically changing JALR target can only\\ncost a normal EX redirect; it cannot weaken decoder legality, RVFI traps,\\nretirement order, memory ordering, or the NRET=2 IO contract.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a small direct-mapped JALR target table and a registered lookahead\\ntarget candidate keyed by the same selected next fetch PC used for the\\ninstruction replay candidate. In the current IF cycle, predict only legal\\nJALR encodings whose registered candidate matches the current PC and has\\nan aligned target. Drive the existing `predicted_taken` and\\n`predicted_target` metadata for those JALRs, while preserving the current\\ntwo-bank replay predictor, live-imem priority, static backward-branch\\nprediction, direct-JAL prediction, redirect priority, and `fetch_ready`\\nsemantics.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Emit update metadata for valid, non-misaligned JALR instructions when\\nEX/MEM is allowed to advance: update valid, update PC, and resolved\\ntarget. Change JALR redirect handling to compare the resolved next PC\\nagainst the carried prediction, using `pc+4` as the resolved next PC for\\nmisaligned-target traps so stale predictions are repaired precisely.\\nPreserve branch resolution, direct-JAL handling, divider interlock,\\nforwarding, trap marking, and RVFI metadata propagation.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the EX-stage JALR target predictor update signals back to IF without\\nchanging the core module IO, RVFI NRET=2 field set, channel-0-only\\nretirement convention, strict `rvfi_order` sequence, pending-store-slot\\narbitration, banked instruction replay wiring, or channel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify the IF/ID and ID/EX prediction metadata comments to document that\\n`predicted_taken` and `predicted_target` may also carry a registered\\nlookahead JALR target prediction. Do not change bundle widths,\\narchitectural state semantics, decoder legality defaults, RVFI fields,\\ntop-level IO, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add a small direct-mapped JALR target table and a registered lookahead\\ntarget candidate keyed by the same selected next fetch PC used for the\\ninstruction replay candidate. In the current IF cycle, predict only legal\\nJALR encodings whose registered candidate matches the current PC and has\\nan aligned target. Drive the existing `predicted_taken` and\\n`predicted_target` metadata for those JALRs, while preserving the current\\ntwo-bank replay predictor, live-imem priority, static backward-branch\\nprediction, direct-JAL prediction, redirect priority, and `fetch_ready`\\nsemantics.\\n\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Emit update metadata for valid, non-misaligned JALR instructions when\\nEX/MEM is allowed to advance: update valid, update PC, and resolved\\ntarget. Change JALR redirect handling to compare the resolved next PC\\nagainst the carried prediction, using `pc+4` as the resolved next PC for\\nmisaligned-target traps so stale predictions are repaired precisely.\\nPreserve branch resolution, direct-JAL handling, divider interlock,\\nforwarding, trap marking, and RVFI metadata propagation.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the EX-stage JALR target predictor update signals back to IF without\\nchanging the core module IO, RVFI NRET=2 field set, channel-0-only\\nretirement convention, strict `rvfi_order` sequence, pending-store-slot\\narbitration, banked instruction replay wiring, or channel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Clarify the IF/ID and ID/EX prediction metadata comments to document that\\n`predicted_taken` and `predicted_target` may also carry a registered\\nlookahead JALR target prediction. Do not change bundle widths,\\narchitectural state semantics, decoder legality defaults, RVFI fields,\\ntop-level IO, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 154.53, \"delta_pct\": -73.25, \"vs_baseline\": -48.67, \"fmax_mhz\": 52.99, \"ipc_coremark\": 3e-06, \"cycles\": 3429014, \"iterations\": 10, \"lut4\": 6378, \"ff\": 2396, \"seeds\": [52.99, 52.58, 54.72], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## What changed\\n\\n- Added an 8-entry direct-mapped JALR target predictor in `rtl/if_stage.sv`.\\n- The JALR table is indexed by `pc[4:2]`, stores a full 32-bit PC tag and a 32-bit target, and produces a registered lookahead candidate from the same selected next-fetch PC used by the replay predictor.\\n- IF now predicts only legal JALR encodings (`opcode=1100111`, `funct3=000`) when the registered candidate matches the current PC and the stored target is word-aligned.\\n- Added EX-to-IF JALR update wiring through `rtl/core.sv`.\\n- Changed `rtl/ex_stage.sv` jump redirect handling so JALR uses the same resolved-next-PC mismatch repair as predicted branches and direct JALs. Misaligned jump targets resolve to `pc+4`, which repairs stale JALR predictions while preserving RVFI `pc_wdata`.\\n- Clarified the prediction metadata comments in `rtl/core_pkg.sv`.\\n\\n## Deviations\\n\\n- Used full 32-bit PC tags instead of non-index tags. This keeps the table simple, uses all update-PC bits cleanly under lint, and still leaves the table read on the registered lookahead side rather than the current IF decision path.\\n- Local `bash formal/run_all.sh` could not stage files in this sandbox because `formal/riscv-formal` is a symlink to a protected shared checkout outside the writable roots. I ran the same script from a temporary writable mirror under `/tmp` instead.\\n\\n## Concerns\\n\\n- The predictor is intentionally small and direct-mapped, so conflicting JALR PCs or changing indirect targets can still miss or mispredict. Those cases fall back to the normal EX redirect repair path.\\n- The full-PC table compare is in the lookahead-register input path, not the current fetch-ready decision path.\\n\\n## Local verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- `bash formal/run_all.sh`: blocked before checks by sandbox permission errors while removing staged files under the protected symlink target.\\n- Same `formal/run_all.sh` executed from a writable `/tmp` mirror: pass (`Formal: 105 passed, 0 failed`).\\n\", \"timestamp\": \"2026-04-28T12:08:33.826174\", \"slot\": 2, \"round_id\": 24}\n74:{\"id\": \"hyp-20260428-068-r25s1\", \"title\": \"Single-Entry Last-Load Replay Latch\", \"category\": \"structural\", \"motivation\": \"The current best core already has the structural wins that have survived the\\nFPGA gate: the one-deep pending-store slot hides some store backpressure, and\\nthe two-bank registered instruction replay predictor hides most random\\niStall bubbles. The remaining structural stalls are mainly data-side load\\nwaits. When a normal-RAM load reaches MEM and `io_dmemReady` is low, the\\nwhole in-order backend freezes even if the same aligned word was just read by\\nan earlier load.\\n\\nLarger load replay attempts proved that this opportunity is real because they\\nreduced CoreMark cycles, but their table lookups, tag compares, and store\\nupdate paths cost too much Fmax. The next structural bet should keep only the\\ncheapest useful form of that idea: one last-load replay entry. CoreMark's\\nstack, list, state, and matrix kernels often reload nearby or identical words\\nacross short loops, so a single MRU word can catch some random dStall cases\\nwithout a table, replacement policy, associative search, or load-data path\\ninto EX.\\n\", \"hypothesis\": {\"motivation\": \"The current best core already has the structural wins that have survived the\\nFPGA gate: the one-deep pending-store slot hides some store backpressure, and\\nthe two-bank registered instruction replay predictor hides most random\\niStall bubbles. The remaining structural stalls are mainly data-side load\\nwaits. When a normal-RAM load reaches MEM and `io_dmemReady` is low, the\\nwhole in-order backend freezes even if the same aligned word was just read by\\nan earlier load.\\n\\nLarger load replay attempts proved that this opportunity is real because they\\nreduced CoreMark cycles, but their table lookups, tag compares, and store\\nupdate paths cost too much Fmax. The next structural bet should keep only the\\ncheapest useful form of that idea: one last-load replay entry. CoreMark's\\nstack, list, state, and matrix kernels often reload nearby or identical words\\nacross short loops, so a single MRU word can catch some random dStall cases\\nwithout a table, replacement policy, associative search, or load-data path\\ninto EX.\\n\", \"hypothesis\": \"Add one normal-RAM last-load replay latch in the MEM stage. The latch holds a\\nvalid bit, one word-aligned byte address tag, and the raw 32-bit word returned\\nby the most recent accepted legal normal-RAM load. On `io_dmemReady=1`, loads\\nkeep using live `io_dmemRData` exactly as today and refresh the latch with\\ntheir aligned word address and raw data.\\n\\nOn `io_dmemReady=0`, a valid legal normal-RAM load may complete from the\\nlatch only when the pending store slot is not valid and the aligned word\\naddress matches the latch tag. A replayed load suppresses the external dmem\\nread, clears `mem_wait`, uses the cached raw word for sign/zero extension and\\nRVFI `mem_rdata`, and retires once through the normal channel-0 MEM/WB\\nboundary. Replay misses preserve the current dmem wait behavior exactly.\\n\\nKeep replay conservative. Disable it for MMIO, UART, timing markers,\\nnon-normal-RAM addresses, misaligned or trapping accesses, stores, and any\\ncycle where a pending store slot is valid. A legal normal-RAM store that\\nretires directly or enqueues into the pending slot should invalidate the\\nlatch on a matching word address; byte-merge updating is optional, but\\ninvalidation is the lower-timing-risk default. This prevents a later replayed\\nload from observing stale bytes.\\n\\nThis is not a cache and not a MEM-to-EX bypass. Cached data is consumed only\\nat the MEM retirement boundary, dependent younger instructions still use the\\nexisting load-use interlock, and all memory ordering behind the pending store\\nslot remains unchanged. The top-level IO, RVFI NRET=2 field set, channel-0\\nsingle-retire convention, strict `rvfi_order` sequence, channel-1 tie-off,\\nbanked IF replay predictor, hot/cold ALU encoding, divider interlock, branch\\nrecovery, timing-marker behavior, and decoder legality defaults remain\\nunchanged.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_last_replay.sv\", \"description\": \"Add a one-entry last-load replay latch with valid, word-address tag, and\\nraw 32-bit data state. Refresh it from accepted live normal-RAM loads,\\nproduce a hit/data result for the current MEM load address, and\\ninvalidate it on matching legal normal-RAM stores. Reset clears only the\\nvalid bit; tag and data payloads remain ignored until valid.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Integrate the last-load replay hit into load handling. Select cached raw\\ndata only when `dmem_ready` is low, the current access is a valid legal\\nnormal-RAM load, no pending store slot is valid, and the latch tag\\nmatches the aligned word address. On a hit, suppress `dmem_ren`, clear\\n`mem_wait`, and drive load extraction plus RVFI `mem_rdata` from the\\ncached word. Keep misses and all nonbufferable, trapping, misaligned,\\nstore, MMIO, UART, and marker accesses on the existing wait path.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the optional `load_last_replay` module if it is instantiated outside\\n`mem_stage`; otherwise no top-level wiring should be needed. Preserve the\\nexisting pending-store-slot dmem arbitration, banked IF replay wiring,\\ncore module IO, RVFI channel layout, strict channel-0 order behavior, and\\nchannel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only comments or compact helper typedefs if useful to document the\\nlast-load replay eligibility and raw-word metadata. Do not change\\narchitectural state semantics, decoder legality defaults, ALU op\\nencodings, RVFI field widths, or the NRET=2 contract.\\n\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/load_last_replay.sv\", \"description\": \"Add a one-entry last-load replay latch with valid, word-address tag, and\\nraw 32-bit data state. Refresh it from accepted live normal-RAM loads,\\nproduce a hit/data result for the current MEM load address, and\\ninvalidate it on matching legal normal-RAM stores. Reset clears only the\\nvalid bit; tag and data payloads remain ignored until valid.\\n\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Integrate the last-load replay hit into load handling. Select cached raw\\ndata only when `dmem_ready` is low, the current access is a valid legal\\nnormal-RAM load, no pending store slot is valid, and the latch tag\\nmatches the aligned word address. On a hit, suppress `dmem_ren`, clear\\n`mem_wait`, and drive load extraction plus RVFI `mem_rdata` from the\\ncached word. Keep misses and all nonbufferable, trapping, misaligned,\\nstore, MMIO, UART, and marker accesses on the existing wait path.\\n\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the optional `load_last_replay` module if it is instantiated outside\\n`mem_stage`; otherwise no top-level wiring should be needed. Preserve the\\nexisting pending-store-slot dmem arbitration, banked IF replay wiring,\\ncore module IO, RVFI channel layout, strict channel-0 order behavior, and\\nchannel-1 tie-off.\\n\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add only comments or compact helper typedefs if useful to document the\\nlast-load replay eligibility and raw-word metadata. Do not change\\narchitectural state semantics, decoder legality defaults, ALU op\\nencodings, RVFI field widths, or the NRET=2 contract.\\n\"}], \"outcome\": \"regression\", \"fitness\": 529.39, \"delta_pct\": -8.37, \"vs_baseline\": 75.85, \"fmax_mhz\": 181.79, \"ipc_coremark\": 3e-06, \"cycles\": 3433982, \"iterations\": 10, \"lut4\": 5916, \"ff\": 2227, \"seeds\": [180.93, 193.35, 181.79], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"# Implementation Notes\\n\\n## Changes\\n\\n- Added `rtl/load_last_replay.sv`, a one-entry last-load replay latch with a valid bit, word-address tag, and raw 32-bit data payload.\\n- Integrated the latch inside `rtl/mem_stage.sv`; no top-level `core` IO or RVFI channel wiring changed.\\n- Normal-RAM loads refresh the latch only when the live dmem port is actually usable: legal, aligned, non-trapping, address `< 0x0010_0000`, no pending store slot, and `dmem_ready=1`.\\n- When `dmem_ready=0`, a legal normal-RAM load may retire from the latch only if the pending-store slot is invalid and the word tag matches. On hit, `dmem_ren` is suppressed, `mem_wait` is cleared, and both load extraction and RVFI `mem_rdata` use the cached raw word.\\n- Legal normal-RAM stores invalidate a matching replay entry when they retire directly or enqueue into the pending-store slot.\\n\\n## Deviations\\n\\n- Store byte-merge updating was not implemented; matching stores invalidate the latch conservatively as proposed.\\n- The helper uses a 30-bit word-address input rather than a 32-bit byte address to avoid unused low-bit logic and lint warnings.\\n\\n## Concerns\\n\\n- The direct command `bash formal/run_all.sh` could not stage files in this sandbox because `formal/riscv-formal` points outside the writable worktree area and its core staging directory rejects writes. The same script was run from a `/tmp` mirror of the current RTL and formal harness instead.\\n\\n## Verification\\n\\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv rtl/*.sv`: pass.\\n- Formal self-check from `/tmp/llr_formal.g2j1qf` using the same `formal/run_all.sh`: pass, `105 passed, 0 failed`.\\n\", \"timestamp\": \"2026-04-28T13:30:43.017656\", \"slot\": 1, \"round_id\": 25}\n","exit_code":0,"status":"completed"}}
