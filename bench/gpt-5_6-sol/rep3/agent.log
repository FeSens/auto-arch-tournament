er in EX.\ncores/bench/test/test_reg_file.py:1:\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, write-first\ncores/bench/test/test_reg_file.py:2:bypass, and the synchronous-reset-clears-all property.\"\"\"\ncores/bench/test/test_reg_file.py:60:async def x0_hardwired(dut):\ncores/bench/test/test_reg_file.py:70:async def write_first_bypass(dut):\ncores/bench/test/test_reg_file.py:74:    # bypass returns the new write data.\ncores/bench/test/test_reg_file.py:96:def test_reg_file_runner():\ncores/bench/test/test_reg_file.py:97:    run_cocotb(toplevel=\"reg_file\",\ncores/bench/test/test_reg_file.py:98:               sources=[\"reg_file.sv\"],\ncores/bench/test/test_reg_file.py:99:               test_module=\"test_reg_file\")\ncores/bench/test/test_pipeline.py:67:def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ncores/bench/test/test_pipeline.py:68:def EBREAK():            return 0x00100073\ncores/bench/test/test_pipeline.py:69:def ECALL():             return 0x00000073\ncores/bench/test/test_pipeline.py:178:    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\ncores/bench/test/test_pipeline.py:194:    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\ncores/bench/test/test_pipeline.py:202:async def load_use_bypasses_without_bubble(dut):\ncores/bench/test/test_pipeline.py:212:        LW  (1, 0, 0),         # x1 = mem[0]; bypasses from MEM next cycle\ncores/bench/test/test_pipeline.py:318:    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\ncores/bench/test/test_pipeline.py:363:    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\ncores/bench/test/test_pipeline.py:485:            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\ncores/bench/rtl/forward_unit.sv:10:// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\ncores/bench/test/test_imm_gen.py:22:    # LW x0, 4(x0)  = 0x00402003 -> imm