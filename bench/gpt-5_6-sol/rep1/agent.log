{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' cores/bench/test/test_predictor.py && sed -n '1,220p' cores/bench/test/conftest.py 2>/dev/null || true && sed -n '1,120p' cores/bench/core.yaml\"","aggregated_output":"\"\"\"Directed tests for the one-entry taken-target instruction replay buffer.\"\"\"\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, ReadOnly, Timer\n\nfrom _helpers import run_cocotb\n\n\nTARGET_A = 0x20\nINSTR_A = 0x00108093  # addi x1,x1,1\nTARGET_B = 0x60\nINSTR_B = 0x00210113  # addi x2,x2,2\n\n\ndef _replay_fields(dut):\n    value = int(dut.replay.value)\n    return {\n        \"valid\": value & 1,\n        \"instr\": (value >> 1) & 0xFFFFFFFF,\n        \"pc\": (value >> 33) & 0xFFFFFFFF,\n    }\n\n\nasync def _init(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, unit=\"ns\").start())\n    dut.resolved_valid.value = 0\n    dut.resolved_target.value = 0\n    dut.resolved_taken_backward.value = 0\n    dut.resolved_advance.value = 1\n    dut.fetch_accept.value = 0\n    dut.fetch_pc.value = 0\n    dut.fetch_instr.value = 0\n    dut.reset.value = 1\n    await RisingEdge(dut.clock)\n    await RisingEdge(dut.clock)\n    dut.reset.value = 0\n\n\nasync def _resolve(dut, target, *, taken=True, advance=True):\n    dut.resolved_valid.value = 1\n    dut.resolved_target.value = target\n    dut.resolved_taken_backward.value = int(taken)\n    dut.resolved_advance.value = int(advance)\n    await RisingEdge(dut.clock)\n    dut.resolved_valid.value = 0\n    dut.resolved_taken_backward.value = 0\n\n\nasync def _accept(dut, pc, instr):\n    dut.fetch_pc.value = pc\n    dut.fetch_instr.value = instr\n    dut.fetch_accept.value = 1\n    await RisingEdge(dut.clock)\n    dut.fetch_accept.value = 0\n\n\nasync def _check_hit(dut, target, expected):\n    dut.resolved_valid.value = 1\n    dut.resolved_target.value = target\n    dut.resolved_taken_backward.value = 1\n    dut.resolved_advance.value = 1\n    await ReadOnly()\n    fields = _replay_fields(dut)\n    assert fields[\"valid\"] == expected\n    if expected:\n        assert fields[\"pc\"] == target\n        assert fields[\"instr\"] in (INSTR_A, INSTR_B)\n        assert int(dut.replay_next_pc.value) == target + 4\n    await Timer(1, unit=\"ns\")\n\n\n@cocotb.test()\nasync def cold_fill_and_repeated_hit(dut):\n    await _init(dut)\n    await _resolve(dut, TARGET_A)\n    await _accept(dut, TARGET_A, INSTR_A)\n    await _check_hit(dut, TARGET_A, 1)\n    assert _replay_fields(dut)[\"instr\"] == INSTR_A\n\n\n@cocotb.test()\nasync def same_target_reuses_entry_and_not_taken_does_not_replay(dut):\n    await _init(dut)\n    await _resolve(dut, TARGET_A)\n    await _accept(dut, TARGET_A, INSTR_A)\n    # The buffer has no owning-branch tag: a different branch resolving to\n    # the exact same target must reuse the cached target instruction.\n    await _check_hit(dut, TARGET_A, 1)\n    dut.resolved_taken_backward.value = 0\n    await ReadOnly()\n    assert _replay_fields(dut)[\"valid\"] == 0\n\n\n@cocotb.test()\nasync def replay_is_single_shot_and_stall_safe(dut):\n    await _init(dut)\n    await _resolve(dut, TARGET_A)\n    await _accept(dut, TARGET_A, INSTR_A)\n\n    # A held EX branch cannot replay until it is allowed to advance.\n    dut.resolved_valid.value = 1\n    dut.resolved_target.value = TARGET_A\n    dut.resolved_taken_backward.value = 1\n    dut.resolved_advance.value = 0\n    await ReadOnly()\n    assert _replay_fields(dut)[\"valid\"] == 0\n    await Timer(1, unit=\"ns\")\n    dut.resolved_advance.value = 1\n    await ReadOnly()\n    assert _replay_fields(dut)[\"valid\"] == 1\n\n    # Once that branch advances out of EX, replay drops without modifying\n    # the hot entry; a later confirmation can still hit it.\n    await Timer(1, unit=\"ns\")\n    await RisingEdge(dut.clock)\n    dut.resolved_valid.value = 0\n    dut.resolved_taken_backward.value = 0\n    await ReadOnly()\n    assert _replay_fields(dut)[\"valid\"] == 0\n    await Timer(1, unit=\"ns\")\n    await _check_hit(dut, TARGET_A, 1)\n\n\n@cocotb.test()\nasync def target_replacement(dut):\n    await _init(dut)\n    await _resolve(dut, TARGET_A)\n    await _accept(dut, TARGET_A, INSTR_A)\n    await _check_hit(dut, TARGET_B, 0)\n    await RisingEdge(dut.clock)\n    dut.resolved_valid.value = 0\n    dut.resolved_taken_backward.value = 0\n    await _accept(dut, TARGET_B, INSTR_B)\n    await _check_hit(dut, TARGET_A, 0)\n    await _check_hit(dut, TARGET_B, 1)\n    assert _replay_fields(dut)[\"instr\"] == INSTR_B\n\n\n@cocotb.test()\nasync def fill_waits_for_accepted_matching_fetch(dut):\n    await _init(dut)\n    # A held EX branch must not create pending state.\n    await _resolve(dut, TARGET_A, advance=False)\n    await _accept(dut, TARGET_A, INSTR_A)\n    await _check_hit(dut, TARGET_A, 0)\n    dut.resolved_valid.value = 0\n    dut.resolved_taken_backward.value = 0\n\n    await _resolve(dut, TARGET_A)\n    # Backpressure and an accepted non-target fetch cannot fill the entry.\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n    await _accept(dut, TARGET_A + 4, INSTR_B)\n    await _check_hit(dut, TARGET_A, 0)\n    dut.resolved_valid.value = 0\n    dut.resolved_taken_backward.value = 0\n    await _accept(dut, TARGET_A, INSTR_A)\n    await _check_hit(dut, TARGET_A, 1)\n\n\ndef test_predictor_runner():\n    run_cocotb(\n        toplevel=\"branch_target_buffer\",\n        sources=[\"core_pkg.sv\", \"branch_target_buffer.sv\"],\n        test_module=\"test_predictor\",\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 196.97\n  lut4: 10217\n  ff: 1956\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20260711-001-r8s0\n  updated: '2026-07-11T17:41:14.241985Z'\n","exit_code":0,"status":"completed"}}
