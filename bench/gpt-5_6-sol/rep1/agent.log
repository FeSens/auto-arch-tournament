{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"git status --short && git diff --check && git diff --stat && git diff -- cores/bench/rtl/reg_file.sv cores/bench/test/test_reg_file.py | sed -n '1,320p'\"","aggregated_output":" M cores/bench/rtl/reg_file.sv\n M cores/bench/test/test_reg_file.py\n cores/bench/rtl/reg_file.sv       | 88 +++++++++++++++++++++++++++++----------\n cores/bench/test/test_reg_file.py | 82 ++++++++++++++++++++++++++++++++++--\n 2 files changed, 143 insertions(+), 27 deletions(-)\ndiff --git a/cores/bench/rtl/reg_file.sv b/cores/bench/rtl/reg_file.sv\nindex 9dd38a4..ea60aee 100644\n--- a/cores/bench/rtl/reg_file.sv\n+++ b/cores/bench/rtl/reg_file.sv\n@@ -1,8 +1,10 @@\n // rtl/reg_file.sv\n //\n-// 32 x 32 RV32I integer register file.\n+// Replicated 32 x 32 RV32I integer register file.\n //   - x0 hardwired to zero (writes silently dropped, reads always 0).\n-//   - Two combinational read ports.\n+//   - Two physically independent 1R1W banks.  Architectural writes and\n+//     reset are broadcast to both, while each combinational read port only\n+//     touches its local bank.\n //   - Single synchronous write port.\n //   - Write-first bypass: a same-cycle write to the read address returns\n //     the new value. This matches the prior Chisel core's RegFile.scala\n@@ -15,16 +17,20 @@\n //\n // Latency:        write = 1 cycle (synchronous), read = combinational.\n // RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\n-module reg_file (\n+\n+// A hierarchy boundary is used in addition to keep/dont_touch attributes.\n+// Yosys can otherwise prove the two banks equal and merge corresponding\n+// flops after memory lowering, even when the original memory declarations\n+// were marked keep.  Keeping each instance hierarchical prevents that\n+// cross-bank optimization while still allowing local mux optimization.\n+(* keep_hierarchy = \"yes\", dont_touch = \"true\" *)\n+/* verilator lint_off DECLFILENAME */\n+module reg_file_bank (\n   input  logic        clock,\n   input  logic        reset,\n-\n-  input  logic [4:0]  rs1_addr,\n-  input  logic [4:0]  rs2_addr,\n-  output logic [31:0] rs1_data,\n-  output logic [31:0] rs2_data,\n-\n-  input  logic        w_en,\n+  input  logic [4:0]  r_addr,\n+  output logic [31:0] r_data,\n+  input  logic        w_en_qualified,\n   input  logic [4:0]  w_addr,\n   input  logic [31:0] w_data\n );\n@@ -34,25 +40,61 @@ module reg_file (\n   always_ff @(posedge clock) begin\n     if (reset) begin\n       for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n-    end else if (w_en && w_addr != 5'b0) begin\n+    end else if (w_en_qualified) begin\n       regs[w_addr] <= w_data;\n     end\n   end\n \n   always_comb begin\n-    if (rs1_addr == 5'b0)\n-      rs1_data = 32'b0;\n-    else if (w_en && w_addr == rs1_addr)\n-      rs1_data = w_data;\n-    else\n-      rs1_data = regs[rs1_addr];\n-\n-    if (rs2_addr == 5'b0)\n-      rs2_data = 32'b0;\n-    else if (w_en && w_addr == rs2_addr)\n-      rs2_data = w_data;\n+    if (r_addr == 5'b0)\n+      r_data = 32'b0;\n+    else if (w_en_qualified && w_addr == r_addr)\n+      r_data = w_data;\n     else\n-      rs2_data = regs[rs2_addr];\n+      r_data = regs[r_addr];\n   end\n \n endmodule\n+/* verilator lint_on DECLFILENAME */\n+\n+\n+module reg_file (\n+  input  logic        clock,\n+  input  logic        reset,\n+\n+  input  logic [4:0]  rs1_addr,\n+  input  logic [4:0]  rs2_addr,\n+  output logic [31:0] rs1_data,\n+  output logic [31:0] rs2_data,\n+\n+  input  logic        w_en,\n+  input  logic [4:0]  w_addr,\n+  input  logic [31:0] w_data\n+);\n+\n+  logic qualified_write;\n+  assign qualified_write = w_en && (w_addr != 5'b0);\n+\n+  (* keep = \"true\", keep_hierarchy = \"yes\", dont_touch = \"true\" *)\n+  reg_file_bank u_rs1_bank (\n+    .clock          (clock),\n+    .reset          (reset),\n+    .r_addr         (rs1_addr),\n+    .r_data         (rs1_data),\n+    .w_en_qualified (qualified_write),\n+    .w_addr         (w_addr),\n+    .w_data         (w_data)\n+  );\n+\n+  (* keep = \"true\", keep_hierarchy = \"yes\", dont_touch = \"true\" *)\n+  reg_file_bank u_rs2_bank (\n+    .clock          (clock),\n+    .reset          (reset),\n+    .r_addr         (rs2_addr),\n+    .r_data         (rs2_data),\n+    .w_en_qualified (qualified_write),\n+    .w_addr         (w_addr),\n+    .w_data         (w_data)\n+  );\n+\n+endmodule\ndiff --git a/cores/bench/test/test_reg_file.py b/cores/bench/test/test_reg_file.py\nindex 0cf54bf..e3fdc26 100644\n--- a/cores/bench/test/test_reg_file.py\n+++ b/cores/bench/test/test_reg_file.py\n@@ -1,7 +1,8 @@\n-\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, write-first\n-bypass, and the synchronous-reset-clears-all property.\"\"\"\n+\"\"\"Unit tests for the replicated 1R1W banks in rtl/reg_file.sv.\"\"\"\n from __future__ import annotations\n \n+import random\n+\n import cocotb\n from cocotb.clock import Clock\n from cocotb.triggers import RisingEdge, Timer\n@@ -42,8 +43,9 @@ async def reset_clears_all(dut):\n     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n     await _reset(dut)\n     for r in range(32):\n-        rs1, _ = await _read(dut, r, 0)\n-        assert rs1 == 0, f\"x{r} after reset = 0x{rs1:08x}\"\n+        rs1, rs2 = await _read(dut, r, r)\n+        assert rs1 == 0, f\"rs1 bank x{r} after reset = 0x{rs1:08x}\"\n+        assert rs2 == 0, f\"rs2 bank x{r} after reset = 0x{rs2:08x}\"\n \n \n @cocotb.test()\n@@ -73,11 +75,13 @@ async def write_first_bypass(dut):\n     # Combinational read of an addr that is being written this cycle:\n     # bypass returns the new write data.\n     dut.rs1_addr.value = 7\n+    dut.rs2_addr.value = 7\n     dut.w_en.value     = 1\n     dut.w_addr.value   = 7\n     dut.w_data.value   = 0x12345678\n     await Timer(1, \"ns\")\n     assert int(dut.rs1_data.value) == 0x12345678\n+    assert int(dut.rs2_data.value) == 0x12345678\n     dut.w_en.value = 0\n \n \n@@ -93,6 +97,76 @@ async def two_read_ports(dut):\n     assert rs2 == 0xBBBBBBBB\n \n \n+@cocotb.test()\n+async def back_to_back_writes_and_per_port_collisions(dut):\n+    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n+    await _reset(dut)\n+\n+    # Exercise uninterrupted broadcast writes, checking each bank's local\n+    # mux against a different address while the write-first path is active.\n+    expected = [0] * 32\n+    for addr in range(1, 32):\n+        data = (0x10203040 * addr) & 0xFFFFFFFF\n+        dut.rs1_addr.value = addr\n+        dut.rs2_addr.value = 32 - addr\n+        dut.w_en.value = 1\n+        dut.w_addr.value = addr\n+        dut.w_data.value = data\n+        await Timer(1, \"ns\")\n+        assert int(dut.rs1_data.value) == data\n+        if 32 - addr == addr:\n+            assert int(dut.rs2_data.value) == data\n+        else:\n+            assert int(dut.rs2_data.value) == expected[32 - addr]\n+        await RisingEdge(dut.clock)\n+        expected[addr] = data\n+\n+    dut.w_en.value = 0\n+    for rs1 in range(32):\n+        rs2 = 31 - rs1\n+        got1, got2 = await _read(dut, rs1, rs2)\n+        assert got1 == expected[rs1]\n+        assert got2 == expected[rs2]\n+\n+\n+@cocotb.test()\n+async def randomized_bank_coherence(dut):\n+    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n+    await _reset(dut)\n+    rng = random.Random(0x1A2B3C4D)\n+    expected = [0] * 32\n+\n+    for _ in range(300):\n+        rs1 = rng.randrange(32)\n+        rs2 = rng.randrange(32)\n+        write = rng.randrange(4) != 0\n+        w_addr = rng.randrange(32)\n+        w_data = rng.getrandbits(32)\n+\n+        dut.rs1_addr.value = rs1\n+        dut.rs2_addr.value = rs2\n+        dut.w_en.value = write\n+        dut.w_addr.value = w_addr\n+        dut.w_data.value = w_data\n+        await Timer(1, \"ns\")\n+\n+        qualified = write and w_addr != 0\n+        want1 = w_data if qualified and w_addr == rs1 else expected[rs1]\n+        want2 = w_data if qualified and w_addr == rs2 else expected[rs2]\n+        assert int(dut.rs1_data.value) == want1\n+        assert int(dut.rs2_data.value) == want2\n+\n+        await RisingEdge(dut.clock)\n+        if qualified:\n+            expected[w_addr] = w_data\n+\n+    dut.w_en.value = 0\n+    for addr in range(32):\n+        got1, got2 = await _read(dut, addr, addr)\n+        assert got1 == expected[addr]\n+        assert got2 == expected[addr]\n+\n+\n def test_reg_file_runner():\n     run_cocotb(toplevel=\"reg_file\",\n                sources=[\"reg_file.sv\"],\n","exit_code":0,"status":"completed"}}
