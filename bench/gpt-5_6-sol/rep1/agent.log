{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"fill_target_pc_q\" cores/bench || true\ngit diff --check\ngit diff -- cores/bench/rtl/branch_target_buffer.sv cores/bench/test/test_predictor.py\nbash formal/run_all.sh'","aggregated_output":"diff --git a/cores/bench/rtl/branch_target_buffer.sv b/cores/bench/rtl/branch_target_buffer.sv\nindex 258f43a..0dea1af 100644\n--- a/cores/bench/rtl/branch_target_buffer.sv\n+++ b/cores/bench/rtl/branch_target_buffer.sv\n@@ -31,9 +31,9 @@ module branch_target_buffer (\n   logic [31:0] entry_instr_q;\n \n   logic        fill_pending_q;\n-  logic [31:0] fill_target_pc_q;\n \n   logic hit;\n+  logic miss;\n   always_comb begin\n     hit = entry_valid_q\n        && resolved_valid\n@@ -41,6 +41,11 @@ module branch_target_buffer (\n        && resolved_advance\n        && (entry_target_pc_q == resolved_target);\n \n+    miss = resolved_valid\n+        && resolved_taken_backward\n+        && resolved_advance\n+        && !hit;\n+\n     replay.pc       = entry_target_pc_q;\n     replay.instr    = entry_instr_q;\n     replay.valid    = hit;\n@@ -53,24 +58,24 @@ module branch_target_buffer (\n       entry_target_pc_q <= 32'b0;\n       entry_instr_q     <= 32'b0;\n       fill_pending_q    <= 1'b0;\n-      fill_target_pc_q  <= 32'b0;\n     end else begin\n-      // A pending fill advances only with an instruction accepted into ID.\n-      if (fill_pending_q && fetch_accept &&\n-          (fetch_pc == fill_target_pc_q)) begin\n+      // A confirmed miss replaces the resident tag immediately.  The old\n+      // instruction is invalid while that tag is pending, so the resident\n+      // target register also serves as the exact-target fill tag.\n+      //\n+      // Replacement has priority over fill completion.  In particular, an\n+      // accepted fetch for an older pending target cannot become valid on\n+      // the same edge that a newer miss installs a different target.\n+      if (miss) begin\n+        entry_valid_q     <= 1'b0;\n+        entry_target_pc_q <= resolved_target;\n+        fill_pending_q    <= 1'b1;\n+      end else if (fill_pending_q && fetch_accept &&\n+                   (fetch_pc == entry_target_pc_q)) begin\n         entry_valid_q     <= 1'b1;\n-        entry_target_pc_q <= fill_target_pc_q;\n         entry_instr_q     <= fetch_instr;\n         fill_pending_q    <= 1'b0;\n       end\n-\n-      // A confirmed miss starts/replaces pending fill state.  Hits require\n-      // no state update and cannot perturb the hot entry.\n-      if (resolved_valid && resolved_taken_backward && resolved_advance &&\n-          !hit) begin\n-        fill_pending_q   <= 1'b1;\n-        fill_target_pc_q <= resolved_target;\n-      end\n     end\n   end\n \ndiff --git a/cores/bench/test/test_predictor.py b/cores/bench/test/test_predictor.py\nindex 95018b4..6fa2691 100644\n--- a/cores/bench/test/test_predictor.py\n+++ b/cores/bench/test/test_predictor.py\n@@ -159,6 +159,67 @@ async def fill_waits_for_accepted_matching_fetch(dut):\n     await _check_hit(dut, TARGET_A, 1)\n \n \n+@cocotb.test()\n+async def miss_invalidates_resident_until_replacement_fill(dut):\n+    await _init(dut)\n+    await _resolve(dut, TARGET_A)\n+    await _accept(dut, TARGET_A, INSTR_A)\n+    await _check_hit(dut, TARGET_A, 1)\n+\n+    # Installing B as the pending tag must make A unreachable immediately,\n+    # even before B's redirected fetch is accepted.\n+    dut.resolved_target.value = TARGET_B\n+    await RisingEdge(dut.clock)\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+    await _check_hit(dut, TARGET_A, 0)\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+    await _check_hit(dut, TARGET_B, 0)\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+\n+    await _accept(dut, TARGET_B, INSTR_B)\n+    await _check_hit(dut, TARGET_B, 1)\n+    assert _replay_fields(dut)[\"instr\"] == INSTR_B\n+\n+\n+@cocotb.test()\n+async def newer_miss_beats_simultaneous_old_fill_completion(dut):\n+    await _init(dut)\n+    await _resolve(dut, TARGET_A)\n+\n+    # Complete A's pending fill on the same edge that a newer miss replaces\n+    # it with B.  A's instruction must never be validated under B's tag.\n+    dut.fetch_pc.value = TARGET_A\n+    dut.fetch_instr.value = INSTR_A\n+    dut.fetch_accept.value = 1\n+    dut.resolved_valid.value = 1\n+    dut.resolved_target.value = TARGET_B\n+    dut.resolved_taken_backward.value = 1\n+    dut.resolved_advance.value = 1\n+    await RisingEdge(dut.clock)\n+    dut.fetch_accept.value = 0\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+\n+    await _check_hit(dut, TARGET_A, 0)\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+    await _check_hit(dut, TARGET_B, 0)\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+\n+    # A later stale accepted A fetch is ignored; only exact B completes.\n+    await _accept(dut, TARGET_A, INSTR_A)\n+    await _check_hit(dut, TARGET_B, 0)\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+    await _accept(dut, TARGET_B, INSTR_B)\n+    await _check_hit(dut, TARGET_B, 1)\n+    assert _replay_fields(dut)[\"instr\"] == INSTR_B\n+\n+\n def test_predictor_runner():\n     run_cocotb(\n         toplevel=\"branch_target_buffer\",\nERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\n  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\n","exit_code":2,"status":"failed"}}
