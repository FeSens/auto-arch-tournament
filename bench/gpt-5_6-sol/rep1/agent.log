{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,130p' cores/bench/test/test_reg_file.py; rg -n 'hyp-20260711-001-r3s0' -C 1 cores/bench/experiments/log.jsonl\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,130p' cores/bench/test/test_reg_file.py; rg -n 'hyp-20260711-001-r3s0' -C 1 cores/bench/experiments/log.jsonl\"","aggregated_output":"\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, write-first\nbypass, and the synchronous-reset-clears-all property.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _reset(dut):\n    dut.reset.value    = 1\n    dut.w_en.value     = 0\n    dut.w_addr.value   = 0\n    dut.w_data.value   = 0\n    dut.rs1_addr.value = 0\n    dut.rs2_addr.value = 0\n    await RisingEdge(dut.clock)\n    await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n\n\nasync def _write(dut, addr, data):\n    dut.w_en.value   = 1\n    dut.w_addr.value = addr\n    dut.w_data.value = data\n    await RisingEdge(dut.clock)\n    dut.w_en.value = 0\n\n\nasync def _read(dut, rs1, rs2):\n    dut.rs1_addr.value = rs1\n    dut.rs2_addr.value = rs2\n    await Timer(1, \"ns\")\n    return int(dut.rs1_data.value), int(dut.rs2_data.value)\n\n\n@cocotb.test()\nasync def reset_clears_all(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    for r in range(32):\n        rs1, _ = await _read(dut, r, 0)\n        assert rs1 == 0, f\"x{r} after reset = 0x{rs1:08x}\"\n\n\n@cocotb.test()\nasync def write_and_read(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 5, 0xDEADBEEF)\n    await Timer(1, \"ns\")\n    rs1, _ = await _read(dut, 5, 0)\n    assert rs1 == 0xDEADBEEF\n\n\n@cocotb.test()\nasync def x0_hardwired(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 0, 0xCAFEBABE)\n    await Timer(1, \"ns\")\n    rs1, _ = await _read(dut, 0, 0)\n    assert rs1 == 0\n\n\n@cocotb.test()\nasync def write_first_bypass(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    # Combinational read of an addr that is being written this cycle:\n    # bypass returns the new write data.\n    dut.rs1_addr.value = 7\n    dut.w_en.value     = 1\n    dut.w_addr.value   = 7\n    dut.w_data.value   = 0x12345678\n    await Timer(1, \"ns\")\n    assert int(dut.rs1_data.value) == 0x12345678\n    dut.w_en.value = 0\n\n\n@cocotb.test()\nasync def two_read_ports(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 1, 0xAAAAAAAA)\n    await _write(dut, 2, 0xBBBBBBBB)\n    await Timer(1, \"ns\")\n    rs1, rs2 = await _read(dut, 1, 2)\n    assert rs1 == 0xAAAAAAAA\n    assert rs2 == 0xBBBBBBBB\n\n\ndef test_reg_file_runner():\n    run_cocotb(toplevel=\"reg_file\",\n               sources=[\"reg_file.sv\"],\n               test_module=\"test_reg_file\")\n7-{\"id\": \"hyp-20260711-003-r2s2\", \"title\": \"EX-aligned registered BTB fetch bypass\", \"category\": \"predictor\", \"motivation\": \"The previous static predictor reduced CoreMark cycles, confirming that control\\nhazards are worth attacking, but its IF opcode decode, immediate generation,\\ntarget adders, and predicted-next-PC mux collapsed routed Fmax. The useful\\npredictor work must therefore be registered and kept out of the fetch PC\\nfeedback cone while preserving the cycle reduction on frequently taken loops.\\n\", \"hypothesis\": {\"motivation\": \"The previous static predictor reduced CoreMark cycles, confirming that control\\nhazards are worth attacking, but its IF opcode decode, immediate generation,\\ntarget adders, and predicted-next-PC mux collapsed routed Fmax. The useful\\npredictor work must therefore be registered and kept out of the fetch PC\\nfeedback cone while preserving the cycle reduction on frequently taken loops.\\n\", \"hypothesis\": \"Add a small direct-mapped BTB with tags, stored targets, and two-bit direction\\ncounters. Register its lookup result when the corresponding instruction enters\\nID/EX, holding and flushing that result in lockstep with ID/EX. In the following\\ncycle, while the control instruction is resolved in EX, a predicted-taken hit\\noverrides only the current imem address and IF payload PC; it does not feed the\\nPC register's same-cycle next-PC calculation. EX compares the prediction with\\nthe resolved architectural next PC, recovers through the existing redirect and\\nflush path on a miss, and trains the BTB after resolution.\\n\\nOn a correct taken prediction, the target instruction is fetched during the\\nbranch's EX cycle and may enter ID/EX immediately, eliminating the redirect\\nbubbles. On a correct not-taken prediction, fetch remains sequential. Because\\nthe critical lookup, tag comparison, and target selection are registered one\\ncycle before use, this should retain most of the current Fmax while recovering\\nthe cycle benefit demonstrated by the failed combinational predictor.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Add a compact direct-mapped tagged BTB with two-bit counters, registered lookup output, EX-resolution training, and explicit hold/flush controls matching ID/EX under hazards and bus stalls.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Instantiate and connect the BTB, align its registered prediction with the EX instruction, and route resolved control-flow information back for training.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Allow an EX-aligned predicted-taken hit to override the current imem address and emitted fetch PC, advance the sequential PC from that selected fetch address, and retain authoritative redirect-over-stall recovery priority.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Validate the aligned BTB prediction against the resolved next PC, redirect and flush only on misprediction, and expose legal resolved branch/JAL/JALR outcome and target data for predictor training without changing RVFI semantics.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Apply existing redirect flushing only to predictor recovery and provide predictor hold/flush behavior identical to the ID/EX instruction across load-use, imem, dmem, and redirect cases.\"}, {\"file\": \"test/test_predictor.py\", \"description\": \"Check BTB cold misses, counter training, taken-loop hits, target replacement, not-taken recovery, JAL/JALR behavior, alias tags, and prediction alignment during random instruction/data bus stalls.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Add a compact direct-mapped tagged BTB with two-bit counters, registered lookup output, EX-resolution training, and explicit hold/flush controls matching ID/EX under hazards and bus stalls.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Instantiate and connect the BTB, align its registered prediction with the EX instruction, and route resolved control-flow information back for training.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Allow an EX-aligned predicted-taken hit to override the current imem address and emitted fetch PC, advance the sequential PC from that selected fetch address, and retain authoritative redirect-over-stall recovery priority.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Validate the aligned BTB prediction against the resolved next PC, redirect and flush only on misprediction, and expose legal resolved branch/JAL/JALR outcome and target data for predictor training without changing RVFI semantics.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Apply existing redirect flushing only to predictor recovery and provide predictor hold/flush behavior identical to the ID/EX instruction across load-use, imem, dmem, and redirect cases.\"}, {\"file\": \"test/test_predictor.py\", \"description\": \"Check BTB cold misses, counter training, taken-loop hits, target replacement, not-taken recovery, JAL/JALR behavior, alias tags, and prediction alignment during random instruction/data bus stalls.\"}], \"outcome\": \"regression\", \"fitness\": 221.94, \"delta_pct\": -45.16, \"vs_baseline\": -21.53, \"fmax_mhz\": 93.97, \"ipc_coremark\": 2e-06, \"cycles\": 4234052, \"iterations\": 10, \"lut4\": 13089, \"ff\": 2982, \"seeds\": [93.97, 105.74, 93.41], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-07-11T13:23:20.366277Z\", \"slot\": 2, \"round_id\": 2, \"lesson\": \"- 2026-07-11 hyp-20260711-003-r2s2 (regression, -45.16%): Registering a BTB lookup does not protect FPGA Fmax when its EX-aligned 32-bit target still muxes directly onto imem_addr, so prediction must decouple or pipeline the instruction-memory request path as well as avoid the PC feedback cone.\"}\n8:{\"id\": \"hyp-20260711-001-r3s0\", \"title\": \"Gate load-use hazards by actual source operands\", \"category\": \"micro_opt\", \"motivation\": \"The load-use detector compares a pending load destination against both raw\\nsource-register bitfields of every following instruction. Several RV32IM\\nformats do not read one or either of those fields, so immediate bits or a\\ndestination field can accidentally match the load destination and insert a\\nneedless pipeline bubble. CoreMark contains frequent loads followed by\\nimmediate arithmetic, further loads, and control-flow instructions, making\\nthese false dependencies a direct IPC loss under the existing bus-stall model.\\n\", \"hypothesis\": {\"motivation\": \"The load-use detector compares a pending load destination against both raw\\nsource-register bitfields of every following instruction. Several RV32IM\\nformats do not read one or either of those fields, so immediate bits or a\\ndestination field can accidentally match the load destination and insert a\\nneedless pipeline bubble. CoreMark contains frequent loads followed by\\nimmediate arithmetic, further loads, and control-flow instructions, making\\nthese false dependencies a direct IPC loss under the existing bus-stall model.\\n\", \"hypothesis\": \"Decode only the inexpensive opcode-level rs1/rs2 usage predicates for the\\ninstruction currently in IF/ID, and qualify each load-use comparison with\\nwhether that source is architecturally read. R-type, branches, and stores use\\nboth sources; OP-IMM, loads, and JALR use rs1 only; JAL, LUI, AUIPC, FENCE,\\nand SYSTEM use neither for hazard purposes. This removes false stalls without\\naltering true load-use interlocks, forwarding, pipeline latency, retirement,\\nor the nret=1 interface. The added gates are local to hazard detection and\\nshould improve CoreMark iterations/cycle with little Fmax or area cost.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Qualify pending-load rd comparisons with opcode-derived rs1_used and rs2_used predicates so only architectural source operands cause a load-use bubble.\"}, {\"file\": \"test/test_hazard_unit.py\", \"description\": \"Add directed checks that true load dependencies still stall while false matches in unused instruction fields do not, covering each RV32IM opcode class.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 2, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Qualify pending-load rd comparisons with opcode-derived rs1_used and rs2_used predicates so only architectural source operands cause a load-use bubble.\"}, {\"file\": \"test/test_hazard_unit.py\", \"description\": \"Add directed checks that true load dependencies still stall while false matches in unused instruction fields do not, covering each RV32IM opcode class