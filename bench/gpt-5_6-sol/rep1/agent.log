\": \"rtl/core.sv\", \"description\": \"Wire the multiplier-sidecar handshake and localized pipeline hold signals while preserving the nret=1 top-level interface, forwarding rules, RVFI order, and existing replay behavior.\"}, {\"file\": \"test/test_multiplier.py\", \"description\": \"Add directed and randomized cycle-aware checks for all MUL variants, partial-product carry boundaries, mixed-sign high halves, dependent consumers, single retirement, and completion held across instruction/data bus stalls.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/multiplier.sv\", \"description\": \"Add a stallable two-stage MUL-family sidecar that registers four unsigned 16x16 partial products, combines them exactly into one 64-bit product, applies signed-high corrections, and exposes a single ready/accept completion handshake.\"}, {\"file\": \"rtl/alu.sv\", \"description\": \"Remove production MUL-family arithmetic from the ordinary combinational result cone while preserving the exact existing one-cycle RISCV_FORMAL_ALTOPS formulas and all non-M ALU behavior.\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Define the compact saved MUL request metadata needed to preserve destination, PC, instruction, operands, control, and RVFI source values until sidecar completion.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Dispatch MUL-family instructions into the sidecar only when EX/MEM can advance, suppress their ordinary EX/MEM write, and arbitrate each registered completion into EX/MEM exactly once without changing the normal execute path.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add the fixed-latency MUL dispatch/completion interlock with dmem-stall priority, holding younger fetch/decode state without duplicating or dropping the resident instruction.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the multiplier-sidecar handshake and localized pipeline hold signals while preserv