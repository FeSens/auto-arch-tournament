ead of raw instruction fields.\\nTrue dependencies retain the same one-cycle interlock, while false matches\\ndisappear and unused RVFI source fields remain self-consistent with x0.\\n\\nThis should reduce CoreMark cycles without adding qualifier gates after the\\nhazard comparators or changing forwarding, pipeline latency, bus behavior,\\nretirement, illegal-instruction trapping, or the nret=1 interface. Source-use\\nbits must default false and only assert within validated decoder arms so the\\ndefault-illegal discipline remains intact.\\n\",\n    \"expected_impact\": {\n      \"fitness_delta_pct\": 2,\n      \"confidence\": \"medium\"\n    },\n    \"changes\": [\n      {\n        \"file\": \"rtl/decoder.sv\",\n        \"description\": \"Emit validated uses_rs1 and uses_rs2 controls for each legal RV32IM instruction class, defaulting both false for illegal and source-free instructions.\"\n      },\n      {\n        \"file\": \"rtl/id_stage.sv\",\n        \"description\": \"Canonicalize unused register addresses and values to x0/zero before register-file reads and ID/EX capture so execution and RVFI observe the same source contract.\"\n      },\n      {\n        \"file\": \"rtl/core.sv\",\n        \"description\": \"Drive load-use detection from the ID stage's canonical source addresses rather than raw IF instruction bitfields, preserving replay and stall priorities.\"\n      },\n      {\n        \"file\": \"rtl/hazard_unit.sv\",\n        \"description\": \"Rename and document the source inputs as canonical architectural addresses while retaining the existing shallow equality-based load-use logic.\"\n      },\n      {\n        \"file\": \"test/test_hazard_unit.py\",\n        \"description\": \"Check true dependencies, false matches in unused fields, canonical RVFI source fields, illegal encodings, replay, and coincident instruction/data bus stalls.\"\n      }\n    ]\n  },\n  \"changes\": [\n    {\n      \"file\": \"rtl/decoder.sv\",\n      \"description\": \"Emit validated uses_rs1 and uses_rs2 controls for each legal RV32IM instruction class, defaulting both false for illegal and source-free instructions.\"\n    },\n    {\n      \"file\": \"rtl/id_stage.sv\",\n      \"description\": \"Canonicalize unused register addresses and values to x0/zero before register-file reads and ID/EX capture so execution and RVFI observe the same source contract.\"\n    },\n    {\n      \"file\": \"rtl/core.sv\",\n      \"description\": \"Drive load-use detection from the ID stage's canonical source addresses rather than raw IF instruction bitfields, preserving replay and stall priorities.\"\n    },\n    {\n      \"file\": \"rtl/hazard_unit.sv\",\n      \"description\": \"Rename and document the source inputs as canonical architectural addresses while retaining the existing shallow equality-based load-use logic.\"\n    },\n    {\n      \"file\": \"test/test_hazard_unit.py\",\n      \"description\": \"Check true dependencies, false matches in unused fields, canonical RVFI source fields, illegal encodings, replay, and coincident instruction/data bus stalls.\"\n    }\n  ],\n  \"outcome\": \"broken\",\n  \"error\": \"cosim_failed: selftest.elf\",\n  \"implementation_notes\": null\n}\n","exit_code":0,"status":"completed"}}
