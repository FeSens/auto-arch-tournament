{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'git status --short && git diff --check && git diff -- cores/bench/rtl/branch_target_buffer.sv cores/bench/test/test_predictor.py cores/bench/implementation_notes.md'","aggregated_output":" M cores/bench/rtl/branch_target_buffer.sv\n M cores/bench/test/test_predictor.py\ndiff --git a/cores/bench/rtl/branch_target_buffer.sv b/cores/bench/rtl/branch_target_buffer.sv\nindex 258f43a..8d45b55 100644\n--- a/cores/bench/rtl/branch_target_buffer.sv\n+++ b/cores/bench/rtl/branch_target_buffer.sv\n@@ -1,10 +1,12 @@\n // One-entry taken-target instruction replay buffer.\n //\n-// A legal, aligned, taken backward conditional branch starts a fill on a\n-// miss.  The instruction is captured only when the redirected target fetch\n-// is accepted by ID.  A later EX-confirmed hit supplies that instruction to\n-// ID/EX and lets IF resume at target+4.  There is no speculative lookup in\n-// the instruction-address path.\n+// While the entry is invalid, a legal, aligned, taken backward conditional\n+// branch starts a fill on a miss.  The instruction is captured only when the\n+// redirected target fetch is accepted by ID.  Once captured, the entry stays\n+// resident until reset: later conflicting misses neither replace it nor start\n+// pending fills.  A later EX-confirmed hit supplies that instruction to ID/EX\n+// and lets IF resume at target+4.  There is no speculative lookup in the\n+// instruction-address path.\n `ifndef CORE_PKG_DEFINED\n `include \"core_pkg.sv\"\n `endif\n@@ -56,18 +58,19 @@ module branch_target_buffer (\n       fill_target_pc_q  <= 32'b0;\n     end else begin\n       // A pending fill advances only with an instruction accepted into ID.\n+      // Give capture priority over a simultaneous resolving miss so the\n+      // newly-valid entry cannot leave stale pending state behind.\n       if (fill_pending_q && fetch_accept &&\n           (fetch_pc == fill_target_pc_q)) begin\n         entry_valid_q     <= 1'b1;\n         entry_target_pc_q <= fill_target_pc_q;\n         entry_instr_q     <= fetch_instr;\n         fill_pending_q    <= 1'b0;\n-      end\n-\n-      // A confirmed miss starts/replaces pending fill state.  Hits require\n-      // no state update and cannot perturb the hot entry.\n-      if (resolved_valid && resolved_taken_backward && resolved_advance &&\n-          !hit) begin\n+      end else if (!entry_valid_q && resolved_valid &&\n+                   resolved_taken_backward && resolved_advance) begin\n+        // Cold misses may start (or redirect) the pending fill.  Once the\n+        // first instruction is captured entry_valid_q remains set until\n+        // reset, so no later branch can write either entry or pending state.\n         fill_pending_q   <= 1'b1;\n         fill_target_pc_q <= resolved_target;\n       end\ndiff --git a/cores/bench/test/test_predictor.py b/cores/bench/test/test_predictor.py\nindex 95018b4..c81ebf8 100644\n--- a/cores/bench/test/test_predictor.py\n+++ b/cores/bench/test/test_predictor.py\n@@ -123,16 +123,38 @@ async def replay_is_single_shot_and_stall_safe(dut):\n \n \n @cocotb.test()\n-async def target_replacement(dut):\n+async def conflicting_miss_cannot_replace_resident_entry(dut):\n     await _init(dut)\n     await _resolve(dut, TARGET_A)\n     await _accept(dut, TARGET_A, INSTR_A)\n+\n+    # A later backward branch to another target redirects normally outside\n+    # this module, but must not start a pending replacement here.\n     await _check_hit(dut, TARGET_B, 0)\n     await RisingEdge(dut.clock)\n     dut.resolved_valid.value = 0\n     dut.resolved_taken_backward.value = 0\n     await _accept(dut, TARGET_B, INSTR_B)\n+    await _check_hit(dut, TARGET_A, 1)\n+    assert _replay_fields(dut)[\"instr\"] == INSTR_A\n+    await _check_hit(dut, TARGET_B, 0)\n+\n+\n+@cocotb.test()\n+async def reset_allows_a_new_first_fill(dut):\n+    await _init(dut)\n+    await _resolve(dut, TARGET_A)\n+    await _accept(dut, TARGET_A, INSTR_A)\n+\n+    dut.reset.value = 1\n+    await RisingEdge(dut.clock)\n+    dut.reset.value = 0\n     await _check_hit(dut, TARGET_A, 0)\n+    dut.resolved_valid.value = 0\n+    dut.resolved_taken_backward.value = 0\n+\n+    await _resolve(dut, TARGET_B)\n+    await _accept(dut, TARGET_B, INSTR_B)\n     await _check_hit(dut, TARGET_B, 1)\n     assert _replay_fields(dut)[\"instr\"] == INSTR_B\n \n","exit_code":0,"status":"completed"}}
