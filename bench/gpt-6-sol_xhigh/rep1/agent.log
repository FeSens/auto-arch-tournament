\", \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add the tagged 16-entry target/direction table, predict the fetch successor PC, and give EX recovery priority over fetch stalls. Reset entry valid bits and update entries only for accepted EX res\n…[6307 of 9379 chars elided by tools/bench/transcript.py; sha256:55db6f943f6f713a]…\ndicted and resolved successor PCs, redirect on mismatch, and report accepted control-flow outcomes for table updates.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire predictor lookup, EX update, recovery, and existing bus-stall controls while keeping the single-channel RVFI contract.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Flush younger instructions on misprediction and defer recovery while EX/MEM is held by a dmem stall.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Check repeated branches, JAL/JALR, stale and aliased entries, misaligned targets, wrong-path suppression, bus stalls, RVFI order, and retired PCs.\"}], \"outcome\": \"regression\", \"fitness\": 336.82, \"delta_pct\": -3.58, \"vs_baseline\": 19.09, \"fmax_mhz\": 142.61, \"ipc_coremark\": 2e-06, \"cycles\": 4234021, \"iterations\": 10, \"lut4\": 6042, \"ff\": 2385, \"seeds\": [143.0, 141.88, 142.61], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-09-23T16:10:01.497984Z\", \"slot\": 2, \"round_id\": 2}\n", "exit_code": 0, "status": "completed"}}
