{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,220p' cores/bench/test/test_div_unit.py\"","aggregated_output":"\"\"\"Exact RV32M results and the 32-step divider handshake.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK = 0xffffffff\n\n\ndef signed(x):\n    x &= MASK\n    return x - (1 << 32) if x & (1 << 31) else x\n\n\ndef expected(op, a, b):\n    a, b = a & MASK, b & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIVU, ALU_REMU):\n        return (a // b if op == ALU_DIVU else a % b) & MASK\n    sa, sb = signed(a), signed(b)\n    quotient = (abs(sa) // abs(sb)) * (-1 if (sa < 0) != (sb < 0) else 1)\n    return (quotient if op == ALU_DIV else sa - quotient * sb) & MASK\n\n\nasync def cycle(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def check(dut, op, a, b, want=None):\n    if want is None:\n        want = expected(op, a, b)\n    dut.op.value = op\n    dut.a.value = a & MASK\n    dut.b.value = b & MASK\n    dut.start.value = 1\n    await cycle(dut)\n    dut.start.value = 0\n    assert int(dut.busy.value) == 1 and int(dut.done.value) == 0\n    for _ in range(31):\n        await cycle(dut)\n        assert int(dut.done.value) == 0, \"divider completed before 32 steps\"\n    await cycle(dut)\n    assert int(dut.done.value) == 1 and int(dut.busy.value) == 0\n    got = int(dut.result.value) & MASK\n    assert got == want, f\"op={op} {a:#x}/{b:#x}: {got:#x} != {want:#x}\"\n    # A blocked EX/MEM boundary must hold done/result until accepted.\n    for _ in range(2):\n        await cycle(dut)\n        assert int(dut.done.value) == 1 and int(dut.result.value) == want\n    dut.consume.value = 1\n    await cycle(dut)\n    dut.consume.value = 0\n    assert int(dut.done.value) == 0 and int(dut.busy.value) == 0\n\n\n@cocotb.test()\nasync def div_rem_vectors_and_relaunch(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await cycle(dut)\n    await cycle(dut)\n    dut.reset.value = 0\n    # Migrated vectors from the former combinational ALU tests.\n    vectors = [\n        (ALU_DIV, 10, 3, 3),\n        (ALU_DIV, 0xfffffffc, 2, 0xfffffffe),\n        (ALU_DIV, 7, 0xfffffffe, 0xfffffffd),\n        (ALU_DIV, 123, 0, MASK), (ALU_DIV, 0, 0, MASK),\n        (ALU_DIV, 0x80000000, MASK, 0x80000000),\n        (ALU_DIVU, MASK, 2, 0x7fffffff),\n        (ALU_DIVU, 100, 7, 14), (ALU_DIVU, 42, 0, MASK),\n        (ALU_REM, 10, 3, 1), (ALU_REM, 0xfffffff6, 3, MASK),\n        (ALU_REM, 10, 0xfffffffd, 1),\n        (ALU_REM, 0xdeadbeef, 0, 0xdeadbeef),\n        (ALU_REM, 0x80000000, MASK, 0),\n        (ALU_REMU, 7, 3, 1),\n        (ALU_REMU, 0xcafebabe, 0, 0xcafebabe),\n    ]\n    for op, a, b, want in vectors:\n        await check(dut, op, a, b, want)\n    rng = random.Random(0x32d1)\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for _ in range(24):\n            await check(dut, op, rng.getrandbits(32), rng.getrandbits(32))\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\", sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n","exit_code":0,"status":"completed"}}
