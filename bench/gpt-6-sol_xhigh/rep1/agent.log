{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -c \"rg -n 'predict|branch|target|stall|flush' cores/bench/test/test_pipeline.py\"","aggregated_output":"5:acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\n6:SW+LW roundtrip, load-use stall, and the trap discipline (illegal /\n73:async def _run(dut, program, dmem_init=None, max_cycles=200, stall_pattern=False,\n115:        if stall_pattern == \"overlap\":\n119:            imem_ready = not stall_pattern or cycle % 9 not in (2, 6)\n120:            dmem_ready = not stall_pattern or cycle % 9 not in (1, 5)\n209:async def load_use_stalls(dut):\n210:    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n219:        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n232:async def bubbles_with_overlapping_bus_stalls(dut):\n233:    \"\"\"A load-use store and branch, with wrong-path memory and bus overlap.\"\"\"\n240:        BEQ(3, 1, 8),       # load-use on branch compare; taken\n250:                            max_cycles=200, stall_pattern=\"overlap\",\n266:async def branch_taken_skips(dut):\n274:        ADDI(2, 0, 42),        # PC=8;  branch target\n284:    # Sanity: the target instruction and the EBREAK do retire, in order.\n297:        ADDI(3, 0, 42),        # PC=8 — target\n311:async def jalr_target(dut):\n317:        ADDI(7, 0, 42),        # PC=12; target\n420:async def divide_with_instruction_and_data_bus_stalls(dut):\n426:    rets, dmem = await _run(dut, program, max_cycles=200, stall_pattern=True)\n","exit_code":0,"status":"completed"}}
