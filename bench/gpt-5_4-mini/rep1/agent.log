ycle.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Consume the latched fetch bundle as the decode input and keep the existing decode, operand read, and ID/EX semantics aligned to the new boundary.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Use the registered IF/ID view for load-use checks so stall generation no longer sits on the same combinational fetch path.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Rewire the top-level stage boundary for the new fetch register while preserving the RVFI and memory I/O contract.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence...","metadata":{"matches":1,"truncated":false},"title":"hyp-20260515-002-r10s1","time":{"start":1778879106120,"end":1778879106128}},"metadata":{"openai":{"itemId":"fc_01f66e9ff76ba084016a078a81fce8819ba925d5b9958f6fc1"}},"id":"prt_e2d750c3e001O71YNCcxyjYDjp","sessionID":"ses_1d28b9185ffeXmwKU9wUBHaVm1","messageID":"msg_e2d74fe27001kqmqvdN3WBGa0X"}}
