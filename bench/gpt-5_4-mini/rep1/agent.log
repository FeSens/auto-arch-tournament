: \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add static backward-branch prediction in fetch and choose the predicted next PC before EX resolves the branch.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Compare actual branch outcome against the IF prediction and redirect only on mispredict.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 8, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Add static backward-branch prediction in fetch and choose the predicted next PC before EX resolves the branch.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Compare actual branch outcome against the IF prediction and redirect only on mispredict.\"}], \"outcome\": \"regression\", \"fitness\": 306.86, \"delta_pct\": 8.5, \"vs_baseline\": 8.5, \"fmax_mhz\": 132.24, \"ipc_coremark\": 2e-06, \"cycles\": 4309463, \"iterations\": 10, \"lut4\"...\n  Line 7: {\"id\": \"hyp-20260515-003-r2s2\", \"title\": \"(slot 2 hypothesis-gen failed)\", \"category\": \"predictor\", \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"hypothesis_gen_failed: Hypothesis agent did not write a file for slot hyp-20260515-003-r2s2 (allowed_yaml_ids=['hyp-20260515-001-r2s0', 'hyp-20260515-002-r2s1', 'hyp-20260515-003-r2s2'])\", \"slot\": 2, \"round_id\": 2}\n","metadata":{"matches":4,"truncated":false},"title":"predictor|branch|taken predictor|static backward|BTB|BHT|BTFNT","time":{"start":1778854577501,"end":1778854577518}},"metadata":{"openai":{"itemId":"fc_09e1782bb40f28c7016a072ab15a908198830168ba5b7ace58"}},"id":"prt_e2bfec55a002zL1dPc0PE3HxZa","sessionID":"ses_1d401591bffeuKVrVJzOl0LPN4","messageID":"msg_e2bfea876001Czxi2az4OTe2dF"}}
