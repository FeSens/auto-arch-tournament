forward\\nconditional branches not taken, and always predict JALs taken from the\\nfetched instruction. This keeps the predictor update path trivial, avoids\\nspeculative training state, and should hide more of the branch penalty on\\nCoreMark's hot loops while preserving the existing mispredict redirect.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Use a static predictor to choose the speculative next PC before EX resolution.\"}, {\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Add a small combinational BTFNT predictor that decodes the fetched instruction and emits the predicted next PC.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Use a static predictor to choose the speculative next PC before EX resolution.\"}, {\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Add a small combinational BTFNT predictor that decodes the fetched instruction and emits the predicted next PC.\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_...","metadata":{"matches":5,"truncated":false},"title":"structural|branch|pc\\+4|precompute|BTB|predictor|ID","time":{"start":1778894643632,"end":1778894643670}},"metadata":{"openai":{"itemId":"fc_0c7eecffe8343fce016a07c73378d4819b982396765e1fb797"}},"id":"prt_e2e622188001IeJAh8RKxzlvki","sessionID":"ses_1d19e0286ffe5oIsxEMgu6V0XU","messageID":"msg_e2e61ff0d001XysGZy2VX40l9h"}}
