{"type":"tool_use","timestamp":1778887166238,"sessionID":"ses_1d210cfd8ffexrsWPM1YWdtADu","part":{"type":"tool","tool":"read","callID":"call_8JWXt2BMNSLUZaVrlOnlIfAe","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4-mini-rep2/cores/bench/test/test_decoder.py","offset":1,"limit":220},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4-mini-rep2/cores/bench/test/test_decoder.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Unit tests for rtl/decoder.sv. Mirrors chisel/test/src/DecoderSpec.scala\n2: 1:1. Includes every reserved-encoding case from CLAUDE.md invariant #10.\"\"\"\n3: from __future__ import annotations\n4: \n5: import cocotb\n6: from cocotb.triggers import Timer\n7: \n8: from _helpers import (\n9:     ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n10:     ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n11:     ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n12:     ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n13:     BR_BEQ, BR_BNE, BR_BLT, BR_BGE, BR_BLTU, BR_BGEU,\n14:     run_cocotb,\n15: )\n16: \n17: \n18: async def _poke(dut, instr):\n19:     dut.instr.value = instr & 0xFFFFFFFF\n20:     await Timer(1, \"ns\")\n21: \n22: \n23: # ── R-type ────────────────────────────────────────────────────────────────\n24: @cocotb.test()\n25: async def add(dut):\n26:     # ADD x1,x2,x3 = 0x003100B3\n27:     await _poke(dut, 0x003100B3)\n28:     assert int(dut.alu_op.value) == ALU_ADD\n29:     assert int(dut.reg_write.value) == 1\n30:     assert int(dut.alu_src.value) == 0\n31:     assert int(dut.is_illegal.value) == 0\n32: \n33: \n34: @cocotb.test()\n35: async def sub(dut):\n36:     await _poke(dut, 0x403100B3)\n37:     assert int(dut.alu_op.value) == ALU_SUB\n38:     assert int(dut.is_illegal.value) == 0\n39: \n40: \n41: @cocotb.test()\n42: async def r_type_ops(dut):\n43:     cases = [\n44:         (0x001010B3, ALU_SLL),\n45:         (0x001020B3, ALU_SLT),\n46:         (0x001030B3, ALU_SLTU),\n47:         (0x001040B3, ALU_XOR),\n48:         (0x001050B3, ALU_SRL),\n49:         (0x001060B3, ALU_OR),\n50:         (0x001070B3, ALU_AND),\n51:         (0x401050B3, ALU_SRA),\n52:     ]\n53:     for instr, op in cases:\n54:         await _poke(dut, instr)\n55:         assert int(dut.alu_op.value) == op, \\\n56:             f\"instr=0x{instr:08x}: expected aluOp={op}, got {int(dut.alu_op.value)}\"\n57:         assert int(dut.is_illegal.value) == 0\n58: \n59: \n60: @cocotb.test()\n61: async def m_extension(dut):\n62:     cases = [\n63:         (0x023100B3, ALU_MUL),\n64:         (0x023110B3, ALU_MULH),\n65:         (0x023120B3, ALU_MULHSU),\n66:         (0x023130B3, ALU_MULHU),\n67:         (0x023140B3, ALU_DIV),\n68:         (0x023150B3, ALU_DIVU),\n69:         (0x023160B3, ALU_REM),\n70:         (0x023170B3, ALU_REMU),\n71:     ]\n72:     for instr, op in cases:\n73:         await _poke(dut, instr)\n74:         assert int(dut.alu_op.value) == op\n75:         assert int(dut.is_illegal.value) == 0\n76: \n77: \n78: @cocotb.test()\n79: async def reserved_funct7_r_type(dut):\n80:     # funct7=0x3F is reserved; otherwise valid R-type encoding.\n81:     await _poke(dut, 0xFE3100B3)\n82:     assert int(dut.is_illegal.value) == 1\n83: \n84: \n85: @cocotb.test()\n86: async def reserved_subsra_funct3(dut):\n87:     # funct7=0x20, funct3=1 is reserved (only funct3=0 SUB or 5 SRA valid).\n88:     await _poke(dut, 0x403110B3)\n89:     assert int(dut.is_illegal.value) == 1\n90: \n91: \n92: # ── I-type OP-IMM ─────────────────────────────────────────────────────────\n93: @cocotb.test()\n94: async def addi(dut):\n95:     # ADDI x1, x0, 5 = 0x00500093\n96:     await _poke(dut, 0x00500093)\n97:     assert int(dut.alu_op.value) == ALU_ADD\n98:     assert int(dut.alu_src.value) == 1\n99:     assert int(dut.reg_write.value) == 1\n100:     assert int(dut.is_illegal.value) == 0\n101: \n102: \n103: @cocotb.test()\n104: async def slli_legal(dut):\n105:     # SLLI x1, x0, 4 = 0x00401093\n106:     await _poke(dut, 0x00401093)\n107:     assert int(dut.alu_op.value) == ALU_SLL\n108:     assert int(dut.is_illegal.value) == 0\n109: \n110: \n111: @cocotb.test()\n112: async def slli_with_funct7_illegal(dut):\n113:     # SLLI with funct7=0x20 is reserved.\n114:     await _poke(dut, 0x40401093)\n115:     assert int(dut.is_illegal.value) == 1\n116: \n117: \n118: @cocotb.test()\n119: async def srli(dut):\n120:     await _poke(dut, 0x00405093)\n121:     assert int(dut.alu_op.value) == ALU_SRL\n122:     assert int(dut.is_illegal.value) == 0\n123: \n124: \n125: @cocotb.test()\n126: async def srai(dut):\n127:     await _poke(dut, 0x40405093)\n128:     assert int(dut.alu_op.value) == ALU_SRA\n129:     assert int(dut.is_illegal.value) == 0\n130: \n131: \n132: # ── LOAD ──────────────────────────────────────────────────────────────────\n133: @cocotb.test()\n134: async def loads(dut):\n135:     cases = [\n136:         (0x00010083, 0, 1),  # LB    width=byte sext=1\n137:         (0x00011083, 1, 1),  # LH\n138:         (0x00012083, 2, 1),  # LW\n139:         (0x00014083, 0, 0),  # LBU   sext=0\n140:         (0x00015083, 1, 0),  # LHU\n141:     ]\n142:     for instr, mw, sext in cases:\n143:         await _poke(dut, instr)\n144:         assert int(dut.mem_read.value)   == 1\n145:         assert int(dut.reg_write.value)  == 1\n146:         assert int(dut.mem_to_reg.value) == 1\n147:         assert int(dut.alu_src.value)    == 1\n148:         assert int(dut.mem_width.value)  == mw, f\"instr=0x{instr:08x} mw={mw} got {int(dut.mem_width.value)}\"\n149:         assert int(dut.mem_sext.value)   == sext\n150:         assert int(dut.is_illegal.value) == 0\n151: \n152: \n153: @cocotb.test()\n154: async def reserved_load_funct3(dut):\n155:     for f3 in (3, 6, 7):\n156:         instr = (f3 << 12) | 0x03\n157:         await _poke(dut, instr)\n158:         assert int(dut.is_illegal.value) == 1, f\"LOAD funct3={f3} should be illegal\"\n159: \n160: \n161: # ── STORE ─────────────────────────────────────────────────────────────────\n162: @cocotb.test()\n163: async def stores(dut):\n164:     cases = [(0x00110023, 0), (0x00111023, 1), (0x00112023, 2)]\n165:     for instr, mw in cases:\n166:         await _poke(dut, instr)\n167:         assert int(dut.mem_write.value) == 1\n168:         assert int(dut.reg_write.value) == 0\n169:         assert int(dut.mem_width.value) == mw\n170:         assert int(dut.is_illegal.value) == 0\n171: \n172: \n173: @cocotb.test()\n174: async def reserved_store_funct3(dut):\n175:     for f3 in range(3, 8):\n176:         instr = (f3 << 12) | 0x23\n177:         await _poke(dut, instr)\n178:         assert int(dut.is_illegal.value) == 1, f\"STORE funct3={f3} should be illegal\"\n179: \n180: \n181: # ── BRANCH ────────────────────────────────────────────────────────────────\n182: @cocotb.test()\n183: async def branches(dut):\n184:     cases = [\n185:         (0x00208463, BR_BEQ),\n186:         (0x00209463, BR_BNE),\n187:         (0x0020C463, BR_BLT),\n188:         (0x0020D463, BR_BGE),\n189:         (0x0020E463, BR_BLTU),\n190:         (0x0020F463, BR_BGEU),\n191:     ]\n192:     for instr, op in cases:\n193:         await _poke(dut, instr)\n194:         assert int(dut.is_branch.value) == 1\n195:         assert int(dut.reg_write.value) == 0\n196:         assert int(dut.branch_op.value) == op\n197:         assert int(dut.is_illegal.value) == 0\n198: \n199: \n200: @cocotb.test()\n201: async def reserved_branch_funct3(dut):\n202:     for f3 in (2, 3):\n203:         instr = (f3 << 12) | 0x63\n204:         await _poke(dut, instr)\n205:         assert int(dut.is_illegal.value) == 1, f\"BRANCH funct3={f3} should be illegal\"\n206: \n207: \n208: # ── JAL / JALR / LUI / AUIPC ──────────────────────────────────────────────\n209: @cocotb.test()\n210: async def jal(dut):\n211:     # JAL x0, +4 = 0x0040006F\n212:     await _poke(dut, 0x0040006F)\n213:     assert int(dut.is_jump.value)    == 1\n214:     assert int(dut.reg_write.value)  == 1\n215:     assert int(dut.is_illegal.value) == 0\n216: \n217: \n218: @cocotb.test()\n219: async def jalr(dut):\n220:     # JALR x1, 0(x2) = 0x000100E7\n\n(Showing lines 1-220 of 335. Use offset=221 to continue.)\n</content>","metadata":{"preview":"\"\"\"Unit tests for rtl/decoder.sv. Mirrors chisel/test/src/DecoderSpec.scala\n1:1. Includes every reserved-encoding case from CLAUDE.md invariant #10.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    BR_BEQ, BR_BNE, BR_BLT, BR_BGE, BR_BLTU, BR_BGEU,\n    run_cocotb,\n)\n\n\nasync def _poke(dut, instr):\n    dut.instr.value = instr & 0xFFFFFFFF\n    await Timer(1, \"ns\")","truncated":true,"loaded":[]},"title":"cores/bench/test/test_decoder.py","time":{"start":1778887166217,"end":1778887166237}},"metadata":{"openai":{"itemId":"fc_0eb947872e26ad81016a07a9fe1a38819a81d7a1930d488fe6"}},"id":"prt_e2df00908001y88x1DNyJLRvey","sessionID":"ses_1d210cfd8ffexrsWPM1YWdtADu","messageID":"msg_e2defd0dd001JCEq3UslQiiSQR"}}
{"type":"tool_use","timestamp":1778887166240,"sessionID":"ses_1d210cfd8ffexrsWPM1YWdtADu","part":{"type":"tool","tool":"read","callID":"call_Zo5VSNC2G7suHWCP6JO5VtkK","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4-mini-rep2/cores/bench/test/test_pipeline.py","offset":1,"limit":260},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4-mini-rep2/cores/bench/test/test_pipeline.py</path>\n<type>file</type>\n<content>\n1: \"\"\"End-to-end pipeline tests for rtl/core.sv.\n2: \n3: Drives a minimal Python-side imem/dmem against the core's combinational\n4: fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n5: acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\n6: SW+LW roundtrip, load-use stall, and the trap discipline (illegal /\n7: ECALL trap, EBREAK does NOT trap).\n8: \"\"\"\n9: from __future__ import annotations\n10: \n11: import cocotb\n12: from cocotb.clock import Clock\n13: from cocotb.triggers import RisingEdge, Timer\n14: \n15: from _helpers import run_cocotb\n16: \n17: \n18: # ── RV32I instruction encoder helpers ──────────────────────────────────────\n19: def _r(funct7, rs2, rs1, funct3, rd, opcode):\n20:     return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n21:          | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n22: \n23: \n24: def _i(imm, rs1, funct3, rd, opcode):\n25:     return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n26:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n27: \n28: \n29: def _s(imm, rs2, rs1, funct3, opcode):\n30:     imm_hi = (imm >> 5) & 0x7F\n31:     imm_lo = imm & 0x1F\n32:     return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n33:          | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n34: \n35: \n36: def _b(imm, rs2, rs1, funct3, opcode):\n37:     # imm is a 13-bit signed number; bit 0 is implicitly zero.\n38:     b12  = (imm >> 12) & 1\n39:     b105 = (imm >> 5)  & 0x3F\n40:     b41  = (imm >> 1)  & 0xF\n41:     b11  = (imm >> 11) & 1\n42:     return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n43:          | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n44: \n45: \n46: def _j(imm, rd, opcode):\n47:     # 21-bit signed imm; bit 0 implicit zero.\n48:     b20    = (imm >> 20) & 1\n49:     b101   = (imm >> 1)  & 0x3FF\n50:     b11    = (imm >> 11) & 1\n51:     b1912  = (imm >> 12) & 0xFF\n52:     return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n53:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n54: \n55: \n56: def ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\n57: def ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\n58: def LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\n59: def SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\n60: def BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\n61: def JAL (rd, imm):       return _j(imm, rd, 0b1101111)\n62: def JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\n63: def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\n64: def EBREAK():            return 0x00100073\n65: def ECALL():             return 0x00000073\n66: \n67: \n68: # ── Harness ────────────────────────────────────────────────────────────────\n69: async def _run(dut, program, dmem_init=None, max_cycles=200):\n70:     \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n71: \n72:     imem is read combinationally each cycle from imemAddr; dmem similarly.\n73:     Stores get applied to the Python-side dmem dict so subsequent loads\n74:     see the new value.\n75: \n76:     Returns (retirements, dmem) where retirements is a list of dicts\n77:     sampled on every cycle that rvfi_valid=1.\n78:     \"\"\"\n79:     imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n80:     dmem = dict(dmem_init or {})\n81:     retirements: list[dict] = []\n82: \n83:     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n84: \n85:     dut.reset.value = 1\n86:     dut.io_imemData.value = 0\n87:     dut.io_dmemRData.value = 0\n88:     # Zero-wait bus model: ready always asserted. The stall-mode tests\n89:     # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n90:     dut.io_imemReady.value = 1\n91:     dut.io_dmemReady.value = 1\n92:     for _ in range(3):\n93:         await RisingEdge(dut.clock)\n94: \n95:     # Deassert reset and prime the imem read for the first PC=0 fetch.\n96:     dut.reset.value = 0\n97:     dut.io_imemData.value = imem.get(0, EBREAK())\n98: \n99:     for cycle in range(max_cycles):\n100:         await RisingEdge(dut.clock)\n101:         await Timer(1, \"ns\")  # let combinational signals settle\n102: \n103:         # Sample the post-edge state.\n104:         ia        = int(dut.io_imemAddr.value)\n105:         da        = int(dut.io_dmemAddr.value)\n106:         wen       = int(dut.io_dmemWEn.value)\n107:         rvfi_v    = int(dut.io_rvfi_valid_0.value)\n108: \n109:         # Apply dmem write side effects.\n110:         if wen:\n111:             wdata = int(dut.io_dmemWData.value)\n112:             wa = da & ~3\n113:             old = dmem.get(wa, 0)\n114:             new = old\n115:             for i in range(4):\n116:                 if (wen >> i) & 1:\n117:                     bv = (wdata >> (i * 8)) & 0xFF\n118:                     new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n119:             dmem[wa] = new\n120: \n121:         # Capture RVFI retirement.\n122:         if rvfi_v:\n123:             r = {\n124:                 \"order\":     int(dut.io_rvfi_order_0.value),\n125:                 \"insn\":      int(dut.io_rvfi_insn_0.value),\n126:                 \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n127:                 \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n128:                 \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n129:                 \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n130:                 \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n131:                 \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n132:                 \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n133:                 \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n134:                 \"trap\":      int(dut.io_rvfi_trap_0.value),\n135:                 \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n136:                 \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n137:                 \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n138:                 \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n139:                 \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n140:                 \"cycle\":     cycle,\n141:             }\n142:             retirements.append(r)\n143:             if r[\"insn\"] == EBREAK():\n144:                 break\n145: \n146:         # Drive next cycle's imem fetch and dmem read combinationally.\n147:         dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n148:         dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n149:     else:\n150:         raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n151: \n152:     return retirements, dmem\n153: \n154: \n155: def _by_insn(retirements, insn):\n156:     \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n157:     return [r for r in retirements if r[\"insn\"] == insn]\n158: \n159: \n160: # ── Tests ──────────────────────────────────────────────────────────────────\n161: @cocotb.test()\n162: async def forwarding_ex_to_ex(dut):\n163:     \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n164:     program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n165:     rets, _ = await _run(dut, program)\n166:     [r1] = _by_insn(rets, ADDI(1, 0, 5))\n167:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n168:     assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n169:     assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n170:         f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n171:     )\n172:     # Order must be strict +1.\n173:     orders = [r[\"order\"] for r in rets]\n174:     assert orders == list(range(orders[0], orders[0] + len(rets)))\n175: \n176: \n177: @cocotb.test()\n178: async def forwarding_mem_to_ex(dut):\n179:     \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n180:     program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n181:     rets, _ = await _run(dut, program)\n182:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n183:     assert r2[\"rd_wdata\"] == 8\n184: \n185: \n186: @cocotb.test()\n187: async def load_use_stalls(dut):\n188:     \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n189: \n190:     All immediates kept inside the signed 12-bit positive range so ADDI's\n191:     sign-extension doesn't muddy the expected values.\n192:     \"\"\"\n193:     program = [\n194:         ADDI(3, 0, 0x123),     # x3 = 0x123\n195:         ADDI(4, 0, 0x100),     # x4 = 0x100\n196:         SW  (3, 0, 0),         # mem[0] = x3\n197:         LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n198:         ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n199:         EBREAK(),\n200:     ]\n201:     rets, dmem = await _run(dut, program)\n202:     [r2] = _by_insn(rets, ADD(2, 1, 4))\n203:     assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n204:     assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n205: \n206: \n207: @cocotb.test()\n208: async def branch_taken_skips(dut):\n209:     \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n210:     not merely retire with rd_wdata != 99. Asserting only the side effect\n211:     would let a wrong-path retirement with rd=0 / trap=1 / different data\n212:     pass silently.\"\"\"\n213:     program = [\n214:         BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n215:         ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n216:         ADDI(2, 0, 42),        # PC=8;  branch target\n217:         EBREAK(),\n218:     ]\n219:     rets, _ = await _run(dut, program)\n220:     # Strict: no retirement should originate from PC=4.\n221:     leaked = [r for r in rets if r[\"pc\"] == 4]\n222:     assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n223:     # Strict: no retirement carries the skipped instruction word at all.\n224:     leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n225:     assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n226:     # Sanity: the target instruction and the EBREAK do retire, in order.\n227:     pcs = [r[\"pc\"] for r in rets]\n228:     assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n229:     [r2] = _by_insn(rets, ADDI(2, 0, 42))\n230:     assert r2[\"rd_wdata\"] == 42\n231: \n232: \n233: @cocotb.test()\n234: async def jal_writes_pc_plus_4(dut):\n235:     \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n236:     program = [\n237:         JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n238:         ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n239:         ADDI(3, 0, 42),        # PC=8 — target\n240:         EBREAK(),\n241:     ]\n242:     rets, _ = await _run(dut, program)\n243:     pcs = [r[\"pc\"] for r in rets]\n244:     assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n245:     [rj] = _by_insn(rets, JAL(1, 8))\n246:     assert rj[\"rd\"] == 1\n247:     assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n248:     [r3] = _by_insn(rets, ADDI(3, 0, 42))\n249:     assert r3[\"rd_wdata\"] == 42\n250: \n251: \n252: @cocotb.test()\n253: async def jalr_target(dut):\n254:     \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n255:     program = [\n256:         ADDI(5, 0, 12),        # PC=0;  x5 := 12\n257:         JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n258:         ADDI(6, 0, 99),        # PC=8;  wrong-path\n259:         ADDI(7, 0, 42),        # PC=12; target\n260:         EBREAK(),\n\n(Showing lines 1-260 of 356. Use offset=261 to continue.)\n</content>","metadata":{"preview":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\","truncated":true,"loaded":[]},"title":"cores/bench/test/test_pipeline.py","time":{"start":1778887166214,"end":1778887166239}},"metadata":{"openai":{"itemId":"fc_0eb947872e26ad81016a07a9fe1a28819a87583723f7c53641"}},"id":"prt_e2df008f6001NztgkbQOLI8MQs","sessionID":"ses_1d210cfd8ffexrsWPM1YWdtADu","messageID":"msg_e2defd0dd001JCEq3UslQiiSQR"}}
