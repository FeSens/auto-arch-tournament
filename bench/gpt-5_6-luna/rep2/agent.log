{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'hyp-20260710-001-r14s0' cores/bench || true; git status --short -- cores/bench/experiments/hypotheses cores/bench/rtl/if_stage.sv; sed -n '1,180p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic        prediction_valid;\n  logic [31:0] prediction_target;\n  logic [31:0] branch_imm;\n  logic [31:0] jal_imm;\n  logic [31:0] predicted_pc;\n\n  always_comb begin\n    branch_imm = {{19{imem_data[31]}}, imem_data[31], imem_data[7],\n                  imem_data[30:25], imem_data[11:8], 1'b0};\n    jal_imm    = {{11{imem_data[31]}}, imem_data[31], imem_data[19:12],\n                  imem_data[20], imem_data[30:21], 1'b0};\n\n    prediction_valid  = 1'b0;\n    prediction_target = pc + 32'd4;\n\n    // Predict valid backward conditional branches taken. The funct3 check\n    // prevents reserved branch encodings from affecting the fetch stream.\n    if (imem_data[6:0] == 7'b1100011 &&\n        imem_data[14:12] != 3'd2 && imem_data[14:12] != 3'd3 &&\n        imem_data[31]) begin\n      prediction_valid  = 1'b1;\n      prediction_target = pc + branch_imm;\n    end else if (imem_data[6:0] == 7'b1101111) begin\n      // Direct JAL target is available in IF. JALR remains unpredicted.\n      prediction_valid  = 1'b1;\n      prediction_target = pc + jal_imm;\n    end\n\n    predicted_pc = prediction_valid ? prediction_target : (pc + 32'd4);\n    next_pc      = redirect ? redirect_target : predicted_pc;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid = !(flush || redirect);\n    out.prediction_valid  = (!(flush || redirect)) && prediction_valid;\n    out.prediction_target = prediction_target;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
