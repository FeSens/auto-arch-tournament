{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba cores/bench/rtl/alu.sv | sed -n '18,50p'\"","aggregated_output":"    18\t  input  logic [4:0]  op,\n    19\t  input  logic [31:0] a,\n    20\t  input  logic [31:0] b,\n    21\t  output logic [31:0] out\n    22\t);\n    23\t\n    24\t  logic        [4:0]  shamt;\n    25\t\n    26\t  // Keep a single native-width unsigned multiplier for the complete product.\n    27\t  // The signed high-half variants differ from the unsigned product only by\n    28\t  // sign-dependent multiples of 2^32.  Thus the low half is shared directly,\n    29\t  // while the high half is corrected without instantiating another product.\n    30\t`ifndef RISCV_FORMAL_ALTOPS\n    31\t  logic [63:0] mul_uu;\n    32\t  logic [31:0] mul_high_ss;\n    33\t  logic [31:0] mul_high_su;\n    34\t\n    35\t  assign mul_uu = a * b;\n    36\t  assign mul_high_ss = mul_uu[63:32]\n    37\t                     - (a[31] ? b : 32'b0)\n    38\t                     - (b[31] ? a : 32'b0);\n    39\t  assign mul_high_su = mul_uu[63:32]\n    40\t                     - (a[31] ? b : 32'b0);\n    41\t`endif\n    42\t\n    43\t  always_comb begin\n    44\t    shamt = b[4:0];\n    45\t\n    46\t    case (op)\n    47\t      ALU_ADD:    out = a + b;\n    48\t      ALU_SUB:    out = a - b;\n    49\t      ALU_AND:    out = a & b;\n    50\t      ALU_OR:     out = a | b;\n","exit_code":0,"status":"completed"}}
