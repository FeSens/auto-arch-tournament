{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,310p' formal/riscv-formal/cores/bench-53729/mem_stage.sv; sed -n '1,420p' formal/riscv-formal/cores/bench-53729/core.sv | sed -n '90,270p'; sed -n '1,220p' formal/riscv-formal/cores/bench-53729/hazard_unit.sv 2>/dev/null || true\"","aggregated_output":"// rtl/mem_stage.sv\n//\n// Elastic completion backend for the single-issue core.\n//\n// EX2 produces one age-ordered entry per cycle.  Non-memory entries become\n// complete immediately; a memory entry occupies the single external request\n// slot until its ready handshake.  All entries stay in the four-entry queue\n// until the oldest complete entry retires.  This permits independent younger\n// instructions to execute while a data request is stalled without allowing a\n// younger memory operation to pass the outstanding request.\n/* verilator lint_off DECLFILENAME */\nmodule elastic_backend #(\n  parameter integer DEPTH = 4\n) (\n  input  logic        clock,\n  input  logic        reset,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t     in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic        issue_ready,\n\n  input  logic        dmem_ready,\n  output logic [31:0] dmem_addr,\n  input  logic [31:0] dmem_rdata,\n  output logic [31:0] dmem_wdata,\n  output logic [3:0]  dmem_wen,\n  output logic        dmem_ren,\n\n  output mem_wb_t     retire_entry,\n  output logic        retire_valid,\n\n  input  logic [4:0]  src_rs1,\n  input  logic [4:0]  src_rs2,\n\n  // Completed-but-unretired queue forwarding.  The backend returns the\n  // youngest matching queue writer for each source register; EX2 and the\n  // current EX/MEM result are younger and are selected ahead of these ports\n  // by forward_unit.\n  output logic        q_rs1_valid,\n  output logic [31:0] q_rs1_data,\n  output logic        q_rs2_valid,\n  output logic [31:0] q_rs2_data,\n\n  output logic        pending_load_valid,\n  output logic [4:0]  pending_load_rd\n);\n\n  localparam integer PTR_W = (DEPTH <= 2) ? 1 : $clog2(DEPTH);\n\n  mem_wb_t q [0:DEPTH-1];\n  logic    q_done [0:DEPTH-1];\n  logic [PTR_W-1:0] head_q;\n  logic [PTR_W-1:0] tail_q;\n  logic [PTR_W:0]   count_q;\n\n  logic        pending_q;\n  logic        pending_is_load_q;\n  logic [PTR_W-1:0] pending_slot_q;\n  logic [4:0]  pending_rd_q;\n  logic [31:0] pending_addr_q;\n  logic [31:0] pending_wdata_q;\n  logic [3:0]  pending_wen_q;\n  logic [1:0]  pending_width_q;\n  logic        pending_sext_q;\n\n  logic        in_mem_op;\n  logic        in_misalign;\n  logic        in_effective_mem;\n  logic [31:0] in_wdata_rep;\n  logic [3:0]  in_byte_mask;\n  logic [31:0] in_aligned_addr;\n  ctrl_t       in_ctrl;\n  mem_wb_t     new_entry;\n  logic        new_entry_done;\n\n  logic        queue_room;\n  logic        current_is_memory;\n  logic        issue_fire;\n  logic        retire_fire;\n  logic        mem_complete;\n  logic        head_done;\n  logic [31:0] completed_load_data;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] shifted_rdata;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [7:0]  completed_byte;\n  logic [15:0] completed_half;\n\n  localparam logic [PTR_W-1:0] LAST_PTR = PTR_W'(DEPTH - 1);\n  localparam logic [PTR_W:0]   DEPTH_COUNT = (PTR_W+1)'(DEPTH);\n  integer j;\n\n  // EX2 memory metadata is prepared before the entry is allocated.  The\n  // effective address remains byte-addressed on the external pins while the\n  // RVFI address is word aligned.\n  always_comb begin\n    case (in.ctrl.mem_width)\n      2'd0:    in_wdata_rep = {4{in.write_data[7:0]}};\n      2'd1:    in_wdata_rep = {2{in.write_data[15:0]}};\n      default: in_wdata_rep = in.write_data;\n    endcase\n\n    case (in.ctrl.mem_width)\n      2'd0:    in_byte_mask = 4'b0001 << in.alu_result[1:0];\n      2'd1:    in_byte_mask = 4'b0011 << in.alu_result[1:0];\n      default: in_byte_mask = 4'b1111;\n    endcase\n\n    in_mem_op = in.ctrl.mem_read || in.ctrl.mem_write;\n    in_misalign = in_mem_op &&\n                  ((in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\n                   (in.ctrl.mem_width == 2'd1 && in.alu_result[0] != 1'b0));\n    in_effective_mem = in_mem_op && !in_misalign;\n\n    in_ctrl = in.ctrl;\n    if (in_misalign) begin\n      in_ctrl.is_illegal = 1'b1;\n      in_ctrl.reg_write  = 1'b0;\n    end\n\n    in_aligned_addr = (in_effective_mem)\n                    ? {in.alu_result[31:2], 2'b00} : 32'b0;\n\n    new_entry = '0;\n    new_entry.pc         = in.pc;\n    new_entry.alu_result = in.alu_result;\n    new_entry.read_data  = 32'b0;\n    new_entry.rd         = in.rd;\n    new_entry.rs1_addr   = in.rs1_addr;\n    new_entry.rs2_addr   = in.rs2_addr;\n    new_entry.rs1_val    = in.rs1_val;\n    new_entry.rs2_val    = in.rs2_val;\n    new_entry.pc_next    = in.pc_next;\n    new_entry.mem_addr   = in_aligned_addr;\n    new_entry.mem_rdata  = 32'b0;\n    new_entry.mem_wdata  = in_effective_mem && in.ctrl.mem_write\n                         ? in_wdata_rep : 32'b0;\n    new_entry.mem_wmask  = in_effective_mem && in.ctrl.mem_write\n                         ? in_byte_mask : 4'b0;\n    new_entry.mem_rmask  = in_effective_mem && in.ctrl.mem_read\n                         ? in_byte_mask : 4'b0;\n    new_entry.ctrl       = in_ctrl;\n    new_entry.instr      = in.instr;\n    new_entry.valid      = in.valid;\n    new_entry_done       = !in_effective_mem;\n  end\n\n  assign current_is_memory = in.valid && in_effective_mem;\n  /* verilator lint_off UNUSEDSIGNAL */\n  mem_wb_t age0;\n  mem_wb_t age1;\n  mem_wb_t age2;\n  mem_wb_t age3;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic age_done0, age_done1, age_done2, age_done3;\n  mem_wb_t completed_entry0;\n  mem_wb_t completed_entry1;\n  mem_wb_t completed_entry2;\n  mem_wb_t completed_entry3;\n\n  always_comb begin\n    age0 = '0; age1 = '0; age2 = '0; age3 = '0;\n    age_done0 = 1'b0; age_done1 = 1'b0;\n    age_done2 = 1'b0; age_done3 = 1'b0;\n    case (head_q)\n      2'd0: begin\n        age0 = q[0]; age1 = q[1]; age2 = q[2]; age3 = q[3];\n        age_done0 = q_done[0]; age_done1 = q_done[1];\n        age_done2 = q_done[2]; age_done3 = q_done[3];\n      end\n      2'd1: begin\n        age0 = q[1]; age1 = q[2]; age2 = q[3]; age3 = q[0];\n        age_done0 = q_done[1]; age_done1 = q_done[2];\n        age_done2 = q_done[3]; age_done3 = q_done[0];\n      end\n      2'd2: begin\n        age0 = q[2]; age1 = q[3]; age2 = q[0]; age3 = q[1];\n        age_done0 = q_done[2]; age_done1 = q_done[3];\n        age_done2 = q_done[0]; age_done3 = q_done[1];\n      end\n      default: begin\n        age0 = q[3]; age1 = q[0]; age2 = q[1]; age3 = q[2];\n        age_done0 = q_done[3]; age_done1 = q_done[0];\n        age_done2 = q_done[1]; age_done3 = q_done[2];\n      end\n    endcase\n  end\n\n  always_comb begin\n    completed_entry0 = q[0];\n    completed_entry1 = q[1];\n    completed_entry2 = q[2];\n    completed_entry3 = q[3];\n    completed_entry0.mem_rdata = dmem_rdata;\n    completed_entry1.mem_rdata = dmem_rdata;\n    completed_entry2.mem_rdata = dmem_rdata;\n    completed_entry3.mem_rdata = dmem_rdata;\n    if (pending_is_load_q) begin\n      completed_entry0.read_data = completed_load_data;\n      completed_entry1.read_data = completed_load_data;\n      completed_entry2.read_data = completed_load_data;\n      completed_entry3.read_data = completed_load_data;\n    end\n  end\n\n  assign head_done = age_done0;\n  assign retire_valid = (count_q != 0) && head_done;\n  assign retire_entry = age0;\n  assign retire_fire = retire_valid;\n\n  // A full queue may accept one new instruction in the same cycle that its\n  // oldest completed entry retires.  A memory request additionally requires\n  // the dedicated request slot to be vacant; deliberately do not overlap the\n  // clear and refill of this externally visible single-channel slot.\n  assign queue_room = (count_q < DEPTH_COUNT) || retire_fire;\n  assign issue_ready = !in.valid || (queue_room &&\n                                     (!current_is_memory || !pending_q));\n  assign issue_fire = in.valid && issue_ready;\n\n  assign dmem_addr  = pending_q ? pending_addr_q  : 32'b0;\n  assign dmem_wdata = pending_q ? pending_wdata_q : 32'b0;\n  assign dmem_wen   = (pending_q && !pending_is_load_q) ? pending_wen_q : 4'b0;\n  assign dmem_ren   = pending_q && pending_is_load_q;\n  assign mem_complete = pending_q && dmem_ready;\n\n  /* verilator lint_off UNUSEDSIGNAL */\n  assign shifted_rdata = dmem_rdata >> (pending_addr_q[1:0] * 8);\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign completed_byte = shifted_rdata[7:0];\n  assign completed_half = shifted_rdata[15:0];\n\n  always_comb begin\n    case (pending_width_q)\n      2'd0: completed_load_data = pending_sext_q\n                                ? {{24{completed_byte[7]}}, completed_byte}\n                                : {24'b0, completed_byte};\n      2'd1: completed_load_data = pending_sext_q\n                                ? {{16{completed_half[15]}}, completed_half}\n                                : {16'b0, completed_half};\n      default: completed_load_data = dmem_rdata;\n    endcase\n  end\n\n  assign pending_load_valid = pending_q && pending_is_load_q;\n  assign pending_load_rd = pending_load_valid ? pending_rd_q : 5'b0;\n\n  // Find the youngest completed queue writer.  The loop walks from head to\n  // tail, so later matching entries overwrite older matches.  The queue is\n  // only four entries deep, keeping this bypass local to the backend rather\n  // than adding a long mux to the IF path.\n  always_comb begin\n    q_rs1_valid = 1'b0;\n    q_rs1_data  = 32'b0;\n    q_rs2_valid = 1'b0;\n    q_rs2_data  = 32'b0;\n    if ((count_q > 0) && age_done0 && age0.ctrl.reg_write && age0.rd != 5'b0) begin\n      if (age0.rd == src_rs1) begin\n          q_rs1_valid = 1'b1;\n          q_rs1_data  = age0.ctrl.mem_to_reg ? age0.read_data : age0.alu_result;\n      end\n      if (age0.rd == src_rs2) begin\n          q_rs2_valid = 1'b1;\n          q_rs2_data  = age0.ctrl.mem_to_reg ? age0.read_data : age0.alu_result;\n      end\n    end\n    if ((count_q > 1) && age_done1 && age1.ctrl.reg_write && age1.rd != 5'b0) begin\n      if (age1.rd == src_rs1) begin\n        q_rs1_valid = 1'b1;\n        q_rs1_data  = age1.ctrl.mem_to_reg ? age1.read_data : age1.alu_result;\n      end\n      if (age1.rd == src_rs2) begin\n        q_rs2_valid = 1'b1;\n        q_rs2_data  = age1.ctrl.mem_to_reg ? age1.read_data : age1.alu_result;\n      end\n    end\n    if ((count_q > 2) && age_done2 && age2.ctrl.reg_write && age2.rd != 5'b0) begin\n      if (age2.rd == src_rs1) begin\n        q_rs1_valid = 1'b1;\n        q_rs1_data  = age2.ctrl.mem_to_reg ? age2.read_data : age2.alu_result;\n      end\n      if (age2.rd == src_rs2) begin\n        q_rs2_valid = 1'b1;\n        q_rs2_data  = age2.ctrl.mem_to_reg ? age2.read_data : age2.alu_result;\n      end\n    end\n    if ((count_q > 3) && age_done3 && age3.ctrl.reg_write && age3.rd != 5'b0) begin\n      if (age3.rd == src_rs1) begin\n        q_rs1_valid = 1'b1;\n        q_rs1_data  = age3.ctrl.mem_to_reg ? age3.read_data : age3.alu_result;\n      end\n      if (age3.rd == src_rs2) begin\n        q_rs2_valid = 1'b1;\n        q_rs2_data  = age3.ctrl.mem_to_reg ? age3.read_data : age3.alu_result;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      head_q            <= '0;\n      tail_q            <= '0;\n      count_q           <= '0;\n      pending_q         <= 1'b0;\n      pending_is_load_q <= 1'b0;\n      pending_slot_q    <= '0;\n      pending_rd_q      <= 5'b0;\n      pending_addr_q    <= 32'b0;\n      pending_wdata_q   <= 32'b0;\n      pending_wen_q     <= 4'b0;\n      pending_width_q   <= 2'd2;\n  logic [31:0] ex_mem_forward_data;\n  logic       queue_rs1_valid, queue_rs2_valid;\n  logic [31:0] queue_rs1_data, queue_rs2_data;\n  logic       pending_load_valid;\n  logic [4:0] pending_load_rd;\n  logic       backend_issue_ready;\n  logic       retire_valid;\n\n  // EX redirect\n  logic        redirect;\n  logic [31:0] redirect_target;\n\n  // regfile interface (driven by ID + WB stages)\n  logic [4:0]  rs1_addr_w;\n  logic [4:0]  rs2_addr_w;\n  logic [31:0] rs1_data_w;\n  logic [31:0] rs2_data_w;\n  logic [31:0] ex_rs1_data_w;\n  logic [31:0] ex_rs2_data_w;\n  logic        wb_w_en;\n  logic [4:0]  wb_w_addr;\n  logic [31:0] wb_w_data;\n\n  // ── IF ────────────────────────────────────────────────────────────────\n  if_stage u_if (\n    .clock           (clock),\n    .reset           (reset),\n    .stall           (stall_if),\n    .flush           (flush_if),\n    .redirect        (redirect),\n    .redirect_target (redirect_target),\n    .imem_addr       (io_imemAddr),\n    .imem_data       (io_imemData),\n    .out             (if_id_w)\n  );\n\n  // ── ID + regfile ──────────────────────────────────────────────────────\n  id_stage u_id (\n    .clock    (clock),\n    .reset    (reset),\n    .stall    (stall_id),\n    .flush    (flush_id),\n    .in       (if_id_w),\n    .rs1_addr (rs1_addr_w),\n    .rs2_addr (rs2_addr_w),\n    .rs1_data (rs1_data_w),\n    .rs2_data (rs2_data_w),\n    .out      (id_ex_w)\n  );\n\n  reg_file u_rf (\n    .clock    (clock),\n    .reset    (reset),\n    .rs1_addr (rs1_addr_w),\n    .rs2_addr (rs2_addr_w),\n    .rs1_data (rs1_data_w),\n    .rs2_data (rs2_data_w),\n    .ex_rs1_addr (id_ex_w.rs1_addr),\n    .ex_rs2_addr (id_ex_w.rs2_addr),\n    .ex_rs1_data (ex_rs1_data_w),\n    .ex_rs2_data (ex_rs2_data_w),\n    .w_en     (wb_w_en),\n    .w_addr   (wb_w_addr),\n    .w_data   (wb_w_data)\n  );\n\n  // ── EX ────────────────────────────────────────────────────────────────\n  ex_stage u_ex (\n    .clock           (clock),\n    .reset           (reset),\n    .stall           (stall_ex_mem),\n    .bubble_ex1      (bubble_ex1),\n    .in              (id_ex_w),\n    .fwd_rs1_sel     (fwd_rs1_sel),\n    .fwd_rs2_sel     (fwd_rs2_sel),\n    .fwd_ex2         (ex2_result),           // current EX2 combinational result\n    .fwd_ex_mem      (ex_mem_forward_data), // current EX/MEM ALU result\n    .fwd_mem_wb      (wb_w_data),            // oldest completed queue result\n    .fwd_queue_rs1   (queue_rs1_data),\n    .fwd_queue_rs2   (queue_rs2_data),\n    .rf_rs1_current  (ex_rs1_data_w),\n    .rf_rs2_current  (ex_rs2_data_w),\n    .out             (ex_mem_w),\n    .redirect        (redirect),\n    .redirect_target (redirect_target),\n    .ex2_rd         (ex2_rd),\n    .ex2_w_en       (ex2_w_en),\n    .ex2_result     (ex2_result),\n    .ex1_mem_read   (ex1_mem_read),\n    .ex1_rd         (ex1_rd),\n    .ex1_valid      (ex1_valid)\n  );\n\n  assign ex_mem_forward_w_en = ex_mem_w.valid && ex_mem_w.ctrl.reg_write &&\n                               !ex_mem_w.ctrl.mem_to_reg;\n  assign ex_mem_forward_data = ex_mem_w.alu_result;\n\n  // ── Elastic MEM / completion queue ────────────────────────────────────\n  // The queue is the sole retirement boundary.  It retains memory metadata\n  // and the load response independently of the EX pipeline, so dmemReady=0\n  // does not freeze unrelated work already behind the request.\n  elastic_backend u_backend (\n    .clock              (clock),\n    .reset              (reset),\n    .in                 (ex_mem_w),\n    .issue_ready        (backend_issue_ready),\n    .dmem_ready         (io_dmemReady),\n    .dmem_addr          (io_dmemAddr),\n    .dmem_rdata         (io_dmemRData),\n    .dmem_wdata         (io_dmemWData),\n    .dmem_wen           (io_dmemWEn),\n    .dmem_ren           (io_dmemREn),\n    .retire_entry       (retire_entry_w),\n    .retire_valid       (retire_valid),\n    .src_rs1            (id_ex_w.rs1_addr),\n    .src_rs2            (id_ex_w.rs2_addr),\n    .q_rs1_valid        (queue_rs1_valid),\n    .q_rs1_data         (queue_rs1_data),\n    .q_rs2_valid        (queue_rs2_valid),\n    .q_rs2_data         (queue_rs2_data),\n    .pending_load_valid (pending_load_valid),\n    .pending_load_rd    (pending_load_rd)\n  );\n\n  // ── WB ────────────────────────────────────────────────────────────────\n  wb_stage u_wb (\n    .in     (retire_entry_w),\n    .w_en   (wb_w_en),\n    .w_addr (wb_w_addr),\n    .w_data (wb_w_data)\n  );\n\n  // ── Hazard / forwarding ───────────────────────────────────────────────\n  hazard_unit u_hazard (\n    .ex1_valid      (ex1_valid),\n    .ex1_mem_read   (ex1_mem_read),\n    .ex1_rd         (ex1_rd),\n    .ex_mem_valid   (ex_mem_w.valid),\n    .ex_mem_mem_read(ex_mem_w.ctrl.mem_read),\n    .ex_mem_rd      (ex_mem_w.rd),\n    .id_ex_valid    (id_ex_w.valid),\n    .id_ex_rs1      (id_ex_w.rs1_addr),\n    .id_ex_rs2      (id_ex_w.rs2_addr),\n    .pending_load_valid (pending_load_valid),\n    .pending_load_rd    (pending_load_rd),\n    .backend_stall  (!backend_issue_ready),\n    .redirect       (redirect),\n    .imem_ready     (io_imemReady),\n    .stall_if       (stall_if),\n    .stall_id       (stall_id),\n    .flush_if       (flush_if),\n    .flush_id       (flush_id),\n    .stall_ex_mem   (stall_ex_mem),\n    .bubble_ex1     (bubble_ex1)\n  );\n\n  forward_unit u_fwd (\n    .id_ex_rs1   (id_ex_w.rs1_addr),\n    .id_ex_rs2   (id_ex_w.rs2_addr),\n    .ex2_rd      (ex2_rd),\n    .ex2_w_en    (ex2_w_en),\n    .ex_mem_rd   (ex_mem_w.rd),\n    .ex_mem_w_en (ex_mem_forward_w_en),\n    .mem_wb_rd   (retire_entry_w.rd),\n    .mem_wb_w_en (retire_valid && retire_entry_w.ctrl.reg_write),\n    .queue_rs1_valid (queue_rs1_valid),\n    .queue_rs2_valid (queue_rs2_valid),\n    .fwd_rs1     (fwd_rs1_sel),\n    .fwd_rs2     (fwd_rs2_sel)\n  );\n\n  // ── RVFI ──────────────────────────────────────────────────────────────\n  // The MEM/WB register is the retirement boundary. rvfi_order increments\n  // every cycle rvfi_valid is high; CLAUDE.md invariant 4 (riscv-formal\n  // unique-check) requires strict +1.\n  logic [63:0] rvfi_order_q;\n  logic        rd_wen;\n\n  always_ff @(posedge clock) begin\n    if (reset)                rvfi_order_q <= 64'b0;\n    else if (retire_valid)    rvfi_order_q <= rvfi_order_q + 64'b1;\n// rtl/hazard_unit.sv\n//\n// Interlocks for the elastic backend.  Data-bus backpressure is intentionally\n// absent from the global stall equation: only a full completion queue or a\n// memory instruction that cannot enter the single request slot stalls issue.\n// A consumer of an outstanding load is held in ID until that load completes.\nmodule hazard_unit (\n  input  logic       ex1_valid,\n  input  logic       ex1_mem_read,\n  input  logic [4:0] ex1_rd,\n  input  logic       ex_mem_valid,\n  input  logic       ex_mem_mem_read,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       id_ex_valid,\n  input  logic [4:0] id_ex_rs1,\n  input  logic [4:0] id_ex_rs2,\n  input  logic       pending_load_valid,\n  input  logic [4:0] pending_load_rd,\n  input  logic       backend_stall,\n  input  logic       redirect,\n  input  logic       imem_ready,\n  output logic       stall_if,\n  output logic       stall_id,\n  output logic       flush_if,\n  output logic       flush_id,\n  output logic       stall_ex_mem,\n  output logic       bubble_ex1\n);\n\n  logic load_use_ex1;\n  logic pending_load_use;\n  logic entering_load_use;\n  logic imem_stall;\n\n  always_comb begin\n    load_use_ex1 = ex1_valid && ex1_mem_read && id_ex_valid &&\n                   (ex1_rd != 5'b0) &&\n                   ((ex1_rd == id_ex_rs1) || (ex1_rd == id_ex_rs2));\n    pending_load_use = pending_load_valid && id_ex_valid &&\n                       (pending_load_rd != 5'b0) &&\n                       ((pending_load_rd == id_ex_rs1) ||\n                        (pending_load_rd == id_ex_rs2));\n    entering_load_use = ex_mem_valid && ex_mem_mem_read && id_ex_valid &&\n                        (ex_mem_rd != 5'b0) &&\n                        ((ex_mem_rd == id_ex_rs1) ||\n                         (ex_mem_rd == id_ex_rs2));\n    imem_stall = !imem_ready;\n\n    stall_ex_mem = backend_stall;\n    stall_if     = imem_stall || backend_stall || load_use_ex1 ||\n                   pending_load_use || entering_load_use;\n    stall_id     = backend_stall || load_use_ex1 || pending_load_use ||\n                   entering_load_use;\n\n    // IF emits a bubble while its request is not accepted.  A redirect is\n    // suppressed only when EX itself is held by queue backpressure; otherwise\n    // an independent younger branch can redirect while an older memory waits.\n    flush_if     = imem_stall || redirect;\n    flush_id     = redirect && !backend_stall;\n    bubble_ex1   = (load_use_ex1 || pending_load_use || entering_load_use || redirect) &&\n                   !backend_stall;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,130p' formal/wrapper_si.sv; sed -n '1,180p' formal/checks_si.cfg; sed -n '260,390p' formal/riscv-formal/cores/bench-53729/mem_stage.sv; sed -n '1,170p' formal/riscv-formal/cores/bench-53729/forward_unit.sv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,130p' formal/wrapper_si.sv; sed -n '1,180p' formal/checks_si.cfg; sed -n '260,390p' formal/riscv-formal/cores/bench-53729/mem_stage.sv; sed -n '1,170p' formal/riscv-formal/cores/bench-53729/forward_unit.sv\"","aggregated_output":"// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n        .io_rvfi_trap_0     (rvfi_trap),\n        .io_rvfi_halt_0     (rvfi_halt),\n        .io_rvfi_intr_0     (rvfi_intr),\n        .io_rvfi_mode_0     (rvfi_mode),\n        .io_rvfi_ixl_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n      end\n      if (age0.rd == src_rs2) begin\n          q_rs2_valid = 1'b1;\n          q_rs2_data  = age0.ctrl.mem_to_reg ? age0.read_data : age0.alu_result;\n      end\n    end\n    if ((count_q > 1) && age_done1 && age1.ctrl.reg_write && age1.rd != 5'b0) begin\n      if (age1.rd == src_rs1) begin\n        q_rs1_valid = 1'b1;\n        q_rs1_data  = age1.ctrl.mem_to_reg ? age1.read_data : age1.alu_result;\n      end\n      if (age1.rd == src_rs2) begin\n        q_rs2_valid = 1'b1;\n        q_rs2_data  = age1.ctrl.mem_to_reg ? age1.read_data : age1.alu_result;\n      end\n    end\n    if ((count_q > 2) && age_done2 && age2.ctrl.reg_write && age2.rd != 5'b0) begin\n      if (age2.rd == src_rs1) begin\n        q_rs1_valid = 1'b1;\n        q_rs1_data  = age2.ctrl.mem_to_reg ? age2.read_data : age2.alu_result;\n      end\n      if (age2.rd == src_rs2) begin\n        q_rs2_valid = 1'b1;\n        q_rs2_data  = age2.ctrl.mem_to_reg ? age2.read_data : age2.alu_result;\n      end\n    end\n    if ((count_q > 3) && age_done3 && age3.ctrl.reg_write && age3.rd != 5'b0) begin\n      if (age3.rd == src_rs1) begin\n        q_rs1_valid = 1'b1;\n        q_rs1_data  = age3.ctrl.mem_to_reg ? age3.read_data : age3.alu_result;\n      end\n      if (age3.rd == src_rs2) begin\n        q_rs2_valid = 1'b1;\n        q_rs2_data  = age3.ctrl.mem_to_reg ? age3.read_data : age3.alu_result;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      head_q            <= '0;\n      tail_q            <= '0;\n      count_q           <= '0;\n      pending_q         <= 1'b0;\n      pending_is_load_q <= 1'b0;\n      pending_slot_q    <= '0;\n      pending_rd_q      <= 5'b0;\n      pending_addr_q    <= 32'b0;\n      pending_wdata_q   <= 32'b0;\n      pending_wen_q     <= 4'b0;\n      pending_width_q   <= 2'd2;\n      pending_sext_q    <= 1'b1;\n      for (j = 0; j < DEPTH; j = j + 1) begin\n        q[j]      <= '0;\n        q_done[j] <= 1'b0;\n      end\n    end else begin\n      if (retire_fire) begin\n        case (head_q)\n          2'd0: begin q[0] <= '0; q_done[0] <= 1'b0; end\n          2'd1: begin q[1] <= '0; q_done[1] <= 1'b0; end\n          2'd2: begin q[2] <= '0; q_done[2] <= 1'b0; end\n          default: begin q[3] <= '0; q_done[3] <= 1'b0; end\n        endcase\n        head_q         <= (head_q == LAST_PTR) ? '0 : head_q + 1'b1;\n      end\n\n      if (issue_fire) begin\n        q[tail_q]      <= new_entry;\n        q_done[tail_q] <= new_entry_done;\n        if (current_is_memory) begin\n          pending_q         <= 1'b1;\n          pending_is_load_q <= in.ctrl.mem_read;\n          pending_slot_q    <= tail_q;\n          pending_rd_q      <= in.rd;\n          pending_addr_q    <= in.alu_result;\n          pending_wdata_q   <= in_wdata_rep;\n          pending_wen_q     <= in_byte_mask;\n          pending_width_q   <= in.ctrl.mem_width;\n          pending_sext_q    <= in.ctrl.mem_sext;\n        end\n        tail_q <= (tail_q == LAST_PTR) ? '0 : tail_q + 1'b1;\n      end\n\n      if (mem_complete) begin\n        case (pending_slot_q)\n          2'd0: begin\n            q_done[0]       <= 1'b1;\n            q[0]            <= completed_entry0;\n          end\n          2'd1: begin\n            q_done[1]       <= 1'b1;\n            q[1]            <= completed_entry1;\n          end\n          2'd2: begin\n            q_done[2]       <= 1'b1;\n            q[2]            <= completed_entry2;\n          end\n          default: begin\n            q_done[3]       <= 1'b1;\n            q[3]            <= completed_entry3;\n          end\n        endcase\n        pending_q <= 1'b0;\n      end\n\n      case ({issue_fire, retire_fire})\n        2'b10: count_q <= count_q + 1'b1;\n        2'b01: count_q <= count_q - 1'b1;\n        default: count_q <= count_q;\n      endcase\n    end\n  end\n\nendmodule\n/* verilator lint_on DECLFILENAME */\n// rtl/forward_unit.sv\n//\n// Age-ordered operand forwarding.  The completion queue is older than the\n// current EX2 and EX/MEM values, so it is checked after those two sources.\n// Its entries are nevertheless newer than the architectural register file\n// and are needed when a completed load is waiting behind an older retirement.\nmodule forward_unit (\n  input  logic [4:0] id_ex_rs1,\n  input  logic [4:0] id_ex_rs2,\n  input  logic [4:0] ex2_rd,\n  input  logic       ex2_w_en,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  input  logic       queue_rs1_valid,\n  input  logic       queue_rs2_valid,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  // 000 = register file, 001 = EX2, 010 = EX/MEM, 011 = MEM/WB,\n  // 100 = completed completion-queue entry.\n  always_comb begin\n    if      (ex2_w_en     && ex2_rd    != 5'b0 && ex2_rd    == id_ex_rs1) fwd_rs1 = 3'd1;\n    else if (ex_mem_w_en  && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs1) fwd_rs1 = 3'd2;\n    else if (mem_wb_w_en  && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs1) fwd_rs1 = 3'd3;\n    else if (queue_rs1_valid && id_ex_rs1 != 5'b0)                       fwd_rs1 = 3'd4;\n    else                                                                  fwd_rs1 = 3'd0;\n  end\n\n  always_comb begin\n    if      (ex2_w_en     && ex2_rd    != 5'b0 && ex2_rd    == id_ex_rs2) fwd_rs2 = 3'd1;\n    else if (ex_mem_w_en  && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) fwd_rs2 = 3'd2;\n    else if (mem_wb_w_en  && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 3'd3;\n    else if (queue_rs2_valid && id_ex_rs2 != 5'b0)                       fwd_rs2 = 3'd4;\n    else                                                                  fwd_rs2 = 3'd0;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"The safe structure is a two-slot in-order backend, not a queue: an EX/MEM instruction enters a registered request slot; that slot remains stable until `io_dmemReady`, and an accepted request enters a registered raw-response slot. Formatting happens only from the response slot, while the EX pipeline is backpressured only when that single request slot is occupied by a stalled memory operation. I’ll add forwarding from the request slot and interlocks for loads in EX/MEM and the request slot; the response slot uses the existing write-first register-file path."}}
