\\\"sessionID\\\":\\\"ses_1da8c0d24ffeyR5lnSLdShWPv7\\\",\\\"part\\\":{\\\"type\\\":\\\"tool\\\",\\\"tool\\\":\\\"bash\\\",\\\"callID\\\":\\\"bash:5\\\",\\\"state\\\":{\\\"status\\\":\\\"completed\\\",\\\"input\\\":{\\\"command\\\":\\\"grep '\\\\\\\"id\\\\\\\": \\\\\\\"hyp-20260513-003-r3s2\\\\\\\"' /Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/kimi-k2_6-rep1/cores/bench/experiments/log.jsonl | python3 -m json.tool | head -n 20\\\",\\\"description\\\":\\\"Pretty-print BTB hypothesis line\\\"},\\\"output\\\":\\\"{\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"hyp-20260513-003-r3s2\\\\\\\",\\\\n    \\\\\\\"title\\\\\\\": \\\\\\\"Add 32-entry tagged BTB with 2-bit saturating counters for branch target caching and forward-branch learning\\\\\\\",\\\\n    \\\\\\\"category\\\\\\\": \\\\\\\"predictor\\\\\\\",\\\\n    \\\\\\\"motivation\\\\\\\": \\\\\\\"The existing static predictor correctly predicts backward branches and JAL,\\\\\\\\nbut forward branches that are frequently taken are always mispredicted.\\\\\\\\nAdditionally, the combinational branch-target computation in the IF stage\\\\\\\\n(opcode decode \\\\\\\\u2192 immediate extraction \\\\\\\\u2192 sign-extension \\\\\\\\u2192 PC adder) may\\\\\\\\ncontribute to the critical path. A small Branch Target Buffer can learn\\\\\\\\ntaken forward branches, cache targets to shorten the IF-stage path, and\\\\\\\\ncoexist safely with the existing static BTFN predictor.\\\\\\\\n\\\\\\\",\\\\n    \\\\\\\"hypothesis\\\\\\\": {\\\\n        \\\\\\\"motivation\\\\\\\": \\\\\\\"The existing static predictor correctly predicts backward branches and JAL,\\\\\\\\nbut forward branches that are frequently taken are always mispredicted.\\\\\\\\nAdditionally, the combinational branch-target computation in the IF stage\\\\\\\\n(opcode decode \\\\\\\\u2192 immediate extraction \\\\\\\\u2192 sign-extension \\\\\\\\u2192 PC adder) may\\\\\\\\ncontribute to the critical path. A small Branch Target Buffer can learn\\\\\\\\ntaken forward branches, cache targets to shorten the IF-stage path, and\\\\\\\\ncoexist safely with the existing static BTFN predictor.\\\\\\\\n\\\\\\\",\\\\n        \\\\\\\"hypothesis\\\\\\\": \\\\\\\"Add a 32-entry direct-mapped Branch Target Buffer in the IF stage.\\\\\\\\nEach entry stores a valid bit, a 5-bit tag (PC[11:7]), a 30-bit\\\\\\\\nword-aligned target, and a 2-bit saturating counter.  In ... (line truncated to 2000 chars)\\n{\\\"type\\\":\\\"step_finish\\\",\\\"timestamp\\\":1778744908455,\\\"sessionID\\\":\\\"ses_1da8c0d24ffeyR5lnSLdShWPv7\\\",\\\"part\\\":{\\\"id\\\":\\\"prt_e25755aa70019XeHNCcrArWrwm\\\",\\\"reason\\\":\\\"tool-calls\\\",\\\"snapshot\\\":\\\"6ef4ad46810c40172e11a19e9d966c945fe33d2d\\\",\\\"messageID\\\":\\\"msg_e2575398a001baSoTAUk5OHe5B\\\",\\\"sessionID\\\":\\\"ses_1da8c0d24ffeyR5lnSLdShWPv7\\\",\\\"type\\\":\\\"step-finish\\\",\\\"tokens\\\":{\\\"total\\\":55579,\\\"input\\\":934,\\\"output\\\":91,\\\"reasoning\\\":26,\\\"cache\\\":{\\\"write\\\":0,\\\"read\\\":54528}},\\\"cost\\\":0.01007978}}\\n{\\\"type\\\":\\\"step_start\\\",\\\"timestamp\\\":1778744913719,\\\"sessionID\\\":\\\"ses_1da8c0d24ffeyR5lnSLdShWPv7\\\",\\\"part\\\":{\\\"id\\\":\\\"prt_e25756f34001kQSlntoJw4XkZF\\\",\\\"messageID\\\":\\\"msg_e25755acb001WXi2rDOV56GPXn\\\",\\\"sessionID\\\":\\\"ses_1da8c0d24ffeyR5lnSLdShWPv7\\\",\\\"snapshot\\\":\\\"6ef4ad46810c40172e11a19e9d966c945fe33d2d\\\",\\\"type\\\":\\\"step-start\\\"}}\\n{\\\"type\\\":\\\"tool_use\\\",\\\"timestamp\\\":1778744916551,\\\"sessionID\\\":\\\"ses_1da8c0d24ffeyR5lnSLdShWPv7\\\",\\\"part\\\":{\\\"type\\\":\\\"tool\\\",\\\"tool\\\":\\\"bash\\\",\\\"callID\\\":\\\"bash:6\\\",\\\"state\\\":{\\\"status\\\":\\\"completed\\\",\\\"input\\\":{\\\"command\\\":\\\"python3 -c \\\\\\\"import json,sys; d=json.load(sys.stdin); print('outcome' in d, d.get('outcome'), d.get('fitness'), d.get('error'))\\\\\\\" < <(grep '\\\\\\\"id\\\\\\\": \\\\\\\"hyp-20260513-003-r3s2\\\\\\\"' /Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/kimi-k2_6-rep1/cores/bench/experiments/log.jsonl)\\\",\\\"description\\\":\\\"Check BTB outcome fields\\\"},\\\"output\\\":\\\"True broken None cosim_failed: coremark.elf\\\\n\\\",\\\"metadata\\\":{\\\"output\\\":\\\"True broken None cosim_failed: coremark.elf\\\\n\\\",\\\"exit\\\":0,\\\"description\\\":\\\"Check BTB outcome fields\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"Check BTB outcome fields\\\",\\\"time\\\":{\\\"start\\\":1778744916549,\\\"end\\\":1778744916551}},\\\"id\\\":\\\"prt_e25757196001jXSpq4vVqu3K10\\\",\\\"sessionID\\\":\\\"ses_1da8c0d24ffeyR5lnSLdShWPv7\\\",\\\"messageID\\\":\\\"msg_e25755acb001WXi2rDOV56GPXn\\\"}}\",\"truncated\":false,\"loaded\":[]},\"title\":\"cores/bench/experiments/hypotheses/.agent.hyp-20260514-003-r11s2.log\",\"time\":{\"start\":1778749582857,\"end\":1778749582864}},\"id\":\"prt_e25bcaa6c001w9gS25zi6vmktO\",\"sessionID\":\"ses_1da496ea7ffezAxTBNo3MtwKnx\",\"messageID\":\"msg_e25bb698d001f7F8RnHhANB5xd\"}}\nbench/kimi-k2_6/rep1/agent.log:932:{\"type\":\"tool_use\",\"timestamp\":1778736014460,\"sessionID\":\"ses_1db13f553ffeCMpsVuqxYIOVLU\",\"part\":{\"type\":\"tool\",\"tool\":\"grep\",\"callID\":\"grep:0\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"RAS|return.?address|jalr\",\"path\":\"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/kimi-k2_6-rep1/cores/bench/experiments\",\"include\":\"*.jsonl\"},\"output\":\"Found 3 matches\\n/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/kimi-k2_6-rep1/cores/bench/experiments/log.jsonl:\\n  Line 7: {\\\"id\\\": \\\"hyp-20260513-003-r2s2\\\", \\\"title\\\": \\\"Add 4-entry Return Address Stack for JALR return prediction\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing static predictor eliminates bubbles for backward branches and\\\\nunconditional JAL, but every JALR (function return) still incurs a 1-cycle\\\\nflush because the target is unknown until EX. CoreMark contains frequent\\\\nnested function calls, so returns are a noticeable fraction of the dynamic\\\\ninstruction stream. A tiny Return Address Stack (RAS) pushes the link\\\\naddress on JAL-to-x1/x5 and pops it on JALR-from-x1/x5, predicting the\\\\nreturn target in IF with high accuracy at negligible area cost.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing static predictor eliminates bubbles for backward branches and\\\\nunconditional JAL, but every JALR (function return) still incurs a 1-cycle\\\\nflush because the target is unknown until EX. CoreMark contains frequent\\\\nnested function calls, so returns are a noticeable fraction of the dynamic\\\\ninstruction stream. A tiny Return Address Stack (RAS) pushes the link\\\\naddress on JAL-to-x1/x5 and pops it on JALR-from-x1/x5, predicting the\\\\nreturn target in IF with high accuracy at negligible area cost.\\\\n\\\", \\\"hypothesis\\\": \\\"Extend the IF-stage predictor with a 4-entry RAS. When the fetched\\\\ninstruction is a JAL with rd=x1 or x5, push PC+4 onto the stack. When the\\\\nfetched instruction is a JALR with rs1=x1 or x5 and the stack is non-empty,\\\\npop the top entry and treat it as the predicted target (pred_taken=1,\\\\npred_target=ras_top). Thread the predicted target through the IF/ID and\\\\nID/EX bundles so that EX can verify it. In EX, a JALR only causes a\\\\nredirect when it was unpredicted (!pred_taken) or when the actual target\\\\ndiffers from pred_target. The RAS pointer is updated only on non-stalled,\\\\nnon-flushed cycles. This removes the bubble on the vast majority of\\\\nreturns.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description...\\n  Line 12: {\\\"id\\\": \\\"hyp-20260514-002-r4s1\\\", \\\"title\\\": \\\"Move JALR target resolution to ID stage to cut penalty from 2 to 1 cycle\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"JALR is currently unpredicted in IF and resolved in EX, incurring a 2-cycle\\\\nmisprediction bubble on every function return and indirect call. CoreMark's\\\\nlist benchmark makes frequent function calls through pointers, so JALR\\\\nbubbles are a real IPC limiter.  Because the return address register (x1)\\\\nis almost always in the regfile when the JALR reaches ID (no forwarding\\\\nneeded), we can compute the target address in ID stage and redirect IF one\\\\ncycle earlier, shrinking the penalty to a single flushed fetch slot.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"JALR is currently unpredicted in IF and resolved in EX, incurring a 2-cycle\\\\nmisprediction bubble on every function return and indirect call. CoreMark's\\\\nlist benchmark makes frequent function calls through pointers, so JALR\\\\nbubbles are a real IPC limiter.  Because the return address register (x1)\\\\nis almost always in the regfile when the JALR reaches ID (no forwarding\\\\nneeded), we can compute the target address in ID stage and redirect IF one\\\\ncycle earlier, shrinking the penalty to a single flushed fetch slot.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a JALR target adder in the ID stage: when the decoded instruction is\\\\nJALR and its rs1 is not the subject of an in-flight load-use hazard, compute\\\\njalr_target = (rs1_data + imm) & ~1 and assert a new id_redirect signal.\\\\nThread a jalr_redirected flag through the id_ex_t bundle so the EX stage\\\\nsuppresses its own redirect for JALRs that were already handled in ID.\\\\nAt the top level, OR the new id_redirect with the existing ex_redirect to\\\\ndrive the PC, and adjust flush_if/flush_id so that a JALR in ID is allowed\\\\nto advance into EX while the speculative fetch in IF is killed.\\\\nThis structural change shortens the JALR resolution loop by one full stage\\\\nwithout touching any other instruction type.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct...\\n  Line 13: {\\\"id\\\": \\\"hyp-20260514-003-r4s2\\\", \\\"title\\\": \\\"Add 32-entry 2-bit BHT for forward branch direction prediction\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing IF-stage static predictor (backward-taken + JAL-always-taken)\\\\nalready eliminated the largest source of control bubbles, yielding a +14.6%\\\\nfitness gain. The remaining dynamic mispredictions come mainly from forward\\\\nconditional branches that are frequently taken (e.g. early exits, loop-internal\\\\nconditionals) and from JALR returns. A prior 4-entry RAS improved IPC by only\\\\n0.3% because returns are rare, while a 32-entry tagged BTB broke in cosim.\\\\nA saturating-counter BHT attacks the much larger forward-branch bubble source\\\\nwith minimal area (64 flops) and no changes to pipeline bundles.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing IF-stage static predictor (backward-taken + JAL-always-taken)\\\\nalready eliminated the largest source of control bubbles, yielding a +14.6%\\\\nfitness gain. The remaining dynamic mispredictions come mainly from forward\\\\nconditional branches that are frequently taken (e.g. early exits, loop-internal\\\\nconditionals) and from JALR returns. A prior 4-entry RAS improved IPC by only\\\\n0.3% because returns are rare, while a 32-entry tagged BTB broke in cosim.\\\\nA saturating-counter BHT attacks the much larger forward-branch bubble source\\\\nwith minimal area (64 flops) and no changes to pipeline bundles.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a 32-entry direct-mapped Branch History Table with 2-bit saturating\\\\ncounters to the IF stage. The table is indexed by PC[6:2] and initialized to\\\\nstrongly-taken (2'b11) so backward loops are correct immediately without any\\\\ntraining cost. For every conditional branch, the BHT entry MSB drives\\\\npredict_taken; unconditional JAL continues to be always predicted taken. In\\\\nEX stage, each resolved branch writes its actual outcome back to the entry\\\\nindexed by the branch PC using a standard saturating update rule. This adds\\\\nonly 64 flops and a few LUTs of combinational logi...\",\"metadata\":{\"matches\":3,\"truncated\":false},\"title\":\"RAS|return.?address|jalr\",\"time\":{\"start\":1778736014434,\"end\":1778736014459}},\"id\":\"prt_e24eda06e001803Y7DXLhet3dA\",\"sessionID\":\"ses_1db13f553ffeCMpsVuqxYIOVLU\",\"messageID\":\"msg_e24ec0aec001davCKaDO55MuQQ\"}}\nbench/kimi-k2_6/rep1/agent.log:951:{\"type\":\"tool_use\",\"timestamp\":1778739644596,\"sessionID\":\"ses_1dadf93b3ffeMfaoMLwX4gHiIS\",\"part\":{\"type\":\"tool\",\"tool\":\"grep\",\"callID\":\"functions.grep:1\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"RAS|ras|return.address|jalr\",\"path\":\"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/kimi-k2_6-rep1/cores/bench/experiments/log.jsonl\"},\"output\":\"Found 3 matches\\n/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/kimi-k2_6-rep1/cores/bench/experiments/log.jsonl:\\n  Line 7: {\\\"id\\\": \\\"hyp-20260513-003-r2s2\\\", \\\"title\\\": \\\"Add 4-entry Return Address Stack for JALR return prediction\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing static predictor eliminates bubbles for backward branches and\\\\nunconditional JAL, but every JALR (function return) still incurs a 1-cycle\\\\nflush because the target is unknown until EX. CoreMark contains frequent\\\\nnested function calls, so returns are a noticeable fraction of the dynamic\\\\ninstruction stream. A tiny Return Address Stack (RAS) pushes the link\\\\naddress on JAL-to-x1/x5 and pops it on JALR-from-x1/x5, predicting the\\\\nreturn target in IF with high accuracy at negligible area cost.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing static predictor eliminates bubbles for backward branches and\\\\nunconditional JAL, but every JALR (function return) still incurs a 1-cycle\\\\nflush because the target is unknown until EX. CoreMark contains frequent\\\\nnested function calls, so returns are a noticeable fraction of the dynamic\\\\ninstruction stream. A tiny Return Address Stack (RAS) pushes the link\\\\naddress on JAL-to-x1/x5 and pops it on JALR-from-x1/x5, predicting the\\\\nreturn target in IF with high accuracy at negligible area cost.\\\\n\\\", \\\"hypothesis\\\": \\\"Extend the IF-stage predictor with a 4-entry RAS. When the fetched\\\\ninstruction is a JAL with rd=x1 or x5, push PC+4 onto the stack. When the\\\\nfetched instruction is a JALR with rs1=x1 or x5 and the stack is non-empty,\\\\npop the top entry and treat it as the predicted target (pred_taken=1,\\\\npred_target=ras_top). Thread the predicted target through the IF/ID and\\\\nID/EX bundles so that EX can verify it. In EX, a JALR only causes a\\\\nredirect when it was unpredicted (!pred_taken) or when the actual target\\\\ndiffers from pred_target. The RAS pointer is updated only on non-stalled,\\\\nnon-flushed cycles. This removes the bubble on the vast majority of\\\\nreturns.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description...\\n  Line 12: {\\\"id\\\": \\\"hyp-20260514-002-r4s1\\\", \\\"title\\\": \\\"Move JALR target resolution to ID stage to cut penalty from 2 to 1 cycle\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"JALR is currently unpredicted in IF and resolved in EX, incurring a 2-cycle\\\\nmisprediction bubble on every function return and indirect call. CoreMark's\\\\nlist benchmark makes frequent function calls through pointers, so JALR\\\\nbubbles are a real IPC limiter.  Because the return address register (x1)\\\\nis almost always in the regfile when the JALR reaches ID (no forwarding\\\\nneeded), we can compute the target address in ID stage and redirect IF one\\\\ncycle earlier, shrinking the penalty to a single flushed fetch slot.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"JALR is currently unpredicted in IF and resolved in EX, incurring a 2-cycle\\\\nmisprediction bubble on every function return and indirect call. CoreMark's\\\\nlist benchmark makes frequent function calls through pointers, so JALR\\\\nbubbles are a real IPC limiter.  Because the return address register (x1)\\\\nis almost always in the regfile when the JALR reaches ID (no forwarding\\\\nneeded), we can compute the target address in ID stage and redirect IF one\\\\ncycle earlier, shrinking the penalty to a single flushed fetch slot.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a JALR target adder in the ID stage: when the decoded instruction is\\\\nJALR and its rs1 is not the subject of an in-flight load-use hazard, compute\\\\njalr_target = (rs1_data + imm) & ~1 and assert a new id_redirect signal.\\\\nThread a jalr_redirected flag through the id_ex_t bundle so the EX stage\\\\nsuppresses its own redirect for JALRs that were already handled in ID.\\\\nAt the top level, OR the new id_redirect with the existing ex_redirect to\\\\ndrive the PC, and adjust flush_if/flush_id so that a JALR in ID is allowed\\\\nto advance into EX while the speculative fetch in IF is killed.\\\\nThis structural change shortens the JALR resolution loop by one full stage\\\\nwithout touching any other instruction type.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct...\\n  Line 13: {\\\"id\\\": \\\"hyp-20260514-003-r4s2\\\", \\\"title\\\": \\\"Add 32-entry 2-bit BHT for forward branch direction prediction\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing IF-stage static predictor (backward-taken + JAL-always-taken)\\\\nalready eliminated the largest source of control bubbles, yielding a +14.6%\\\\nfitness gain. The remaining dynamic mispredictions come mainly from forward\\\\nconditional branches that are frequently taken (e.g. early exits, loop-internal\\\\nconditionals) and from JALR returns. A prior 4-entry RAS improved IPC by only\\\\n0.3% because returns are rare, while a 32-entry tagged BTB broke in cosim.\\\\nA saturating-counter BHT attacks the much larger forward-branch bubble source\\\\nwith minimal area (64 flops) and no changes to pipeline bundles.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing IF-stage static predictor (backward-taken + JAL-always-taken)\\\\nalready eliminated the largest source of control bubbles, yielding a +14.6%\\\\nfitness gain. The remaining dynamic mispredictions come mainly from forward\\\\nconditional branches that are frequently taken (e.g. early exits, loop-internal\\\\nconditionals) and from JALR returns. A prior 4-entry RAS improved IPC by only\\\\n0.3% because returns are rare, while a 32-entry tagged BTB broke in cosim.\\\\nA saturating-counter BHT attacks the much larger forward-branch bubble source\\\\nwith minimal area (64 flops) and no changes to pipeline bundles.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a 32-entry direct-mapped Branch History Table with 2-bit saturating\\\\ncounters to the IF stage. The table is indexed by PC[6:2] and initialized to\\\\nstrongly-taken (2'b11) so backward loops are correct immediately without any\\\\ntraining cost. For every conditional branch, the BHT entry MSB drives\\\\npredict_taken; unconditional JAL continues to be always predicted taken. In\\\\nEX stage, each resolved branch writes its actual outcome back to the entry\\\\nindexed by the branch PC using a standard saturating update rule. This adds\\\\nonly 64 flops and a few LUTs of combinational logi...\",\"metadata\":{\"matches\":3,\"truncated\":false},\"title\":\"RAS|ras|return.address|jalr\",\"time\":{\"start\":1778739644577,\"end\":1778739644594}},\"id\":\"prt_e2525059b001hvlrt56HcI209u\",\"sessionID\":\"ses_1dadf93b3ffeMfaoMLwX4gHiIS\",\"messageID\":\"msg_e25206c85001OVZ3Wr1KYKKsmZ\"}}\nbench/kimi-k2_6/rep1/agent.log:983:{\"type\":\"tool_use\",\"timestamp\":1778741270630,\"sessionID\":\"ses_1dac84df8ffeqy1fd7OqLOZiN1\",\"part\":{\"type\":\"tool\",\"tool\":\"grep\",\"callID\":\"functions.grep:1\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"(?i)(ras|return.?address|jalr.?predict|indirect.?jump)\",\"path\":\"cores/bench/experiments\",\"include\":\"*.jsonl\"},\"output\":\"Found 3 matches\\n/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/kimi-k2_6-rep1/cores/bench/experiments/log.jsonl:\\n  Line 7: {\\\"id\\\": \\\"hyp-20260513-003-r2s2\\\", \\\"title\\\": \\\"Add 4-entry Return Address Stack for JALR return prediction\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing static predictor eliminates bubbles for backward branches and\\\\nunconditional JAL, but every JALR (function return) still incurs a 1-cycle\\\\nflush because the target is unknown until EX. CoreMark contains frequent\\\\nnested function calls, so returns are a noticeable fraction of the dynamic\\\\ninstruction stream. A tiny Return Address Stack (RAS) pushes the link\\\\naddress on JAL-to-x1/x5 and pops it on JALR-from-x1/x5, predicting the\\\\nreturn target in IF with high accuracy at negligible area cost.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing static predictor eliminates bubbles for backward branches and\\\\nunconditional JAL, but every JALR (function return) still incurs a 1-cycle\\\\nflush because the target is unknown until EX. CoreMark contains frequent\\\\nnested function calls, so returns are a noticeable fraction of the dynamic\\\\ninstruction stream. A tiny Return Address Stack (RAS) pushes the link\\\\naddress on JAL-to-x1/x5 and pops it on JALR-from-x1/x5, predicting the\\\\nreturn target in IF with high accuracy at negligible area cost.\\\\n\\\", \\\"hypothesis\\\": \\\"Extend the IF-stage predictor with a 4-entry RAS. When the fetched\\\\ninstruction is a JAL with rd=x1 or x5, push PC+4 onto the stack. When the\\\\nfetched instruction is a JALR with rs1=x1 or x5 and the stack is non-empty,\\\\npop the top entry and treat it as the predicted target (pred_taken=1,\\\\npred_target=ras_top). Thread the predicted target through the IF/ID and\\\\nID/EX bundles so that EX can verify it. In EX, a JALR only causes a\\\\nredirect when it was unpredicted (!pred_taken) or when the actual target\\\\ndiffers from pred_target. The RAS pointer is updated only on non-stalled,\\\\nnon-flushed cycles. This removes the bubble on the vast majority of\\\\nreturns.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description...\\n  Line 12: {\\\"id\\\": \\\"hyp-20260514-002-r4s1\\\", \\\"title\\\": \\\"Move JALR target resolution to ID stage to cut penalty from 2 to 1 cycle\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"JALR is currently unpredicted in IF and resolved in EX, incurring a 2-cycle\\\\nmisprediction bubble on every function return and indirect call. CoreMark's\\\\nlist benchmark makes frequent function calls through pointers, so JALR\\\\nbubbles are a real IPC limiter.  Because the return address register (x1)\\\\nis almost always in the regfile when the JALR reaches ID (no forwarding\\\\nneeded), we can compute the target address in ID stage and redirect IF one\\\\ncycle earlier, shrinking the penalty to a single flushed fetch slot.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"JALR is currently unpredicted in IF and resolved in EX, incurring a 2-cycle\\\\nmisprediction bubble on every function return and indirect call. CoreMark's\\\\nlist benchmark makes frequent function calls through pointers, so JALR\\\\nbubbles are a real IPC limiter.  Because the return address register (x1)\\\\nis almost always in the regfile when the JALR reaches ID (no forwarding\\\\nneeded), we can compute the target address in ID stage and redirect IF one\\\\ncycle earlier, shrinking the penalty to a single flushed fetch slot.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a JALR target adder in the ID stage: when the decoded instruction is\\\\nJALR and its rs1 is not the subject of an in-flight load-use hazard, compute\\\\njalr_target = (rs1_data + imm) & ~1 and assert a new id_redirect signal.\\\\nThread a jalr_redirected flag through the id_ex_t bundle so the EX stage\\\\nsuppresses its own redirect for JALRs that were already handled in ID.\\\\nAt the top level, OR the new id_redirect with the existing ex_redirect to\\\\ndrive the PC, and adjust flush_if/flush_id so that a JALR in ID is allowed\\\\nto advance into EX while the speculative fetch in IF is killed.\\\\nThis structural change shortens the JALR resolution loop by one full stage\\\\nwithout touching any other instruction type.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct...\\n  Line 13: {\\\"id\\\": \\\"hyp-20260514-003-r4s2\\\", \\\"title\\\": \\\"Add 32-entry 2-bit BHT for forward branch direction prediction\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing IF-stage static predictor (backward-taken + JAL-always-taken)\\\\nalready eliminated the largest source of control bubbles, yielding a +14.6%\\\\nfitness gain. The remaining dynamic mispredictions come mainly from forward\\\\nconditional branches that are frequently taken (e.g. early exits, loop-internal\\\\nconditionals) and from JALR returns. A prior 4-entry RAS improved IPC by only\\\\n0.3% because returns are rare, while a 32-entry tagged BTB broke in cosim.\\\\nA saturating-counter BHT attacks the much larger forward-branch bubble source\\\\nwith minimal area (64 flops) and no changes to pipeline bundles.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing IF-stage static predictor (backward-taken + JAL-always-taken)\\\\nalready eliminated the largest source of control bubbles, yielding a +14.6%\\\\nfitness gain. The remaining dynamic mispredictions come mainly from forward\\\\nconditional branches that are frequently taken (e.g. early exits, loop-internal\\\\nconditionals) and from JALR returns. A prior 4-entry RAS improved IPC by only\\\\n0.3% because returns are rare, while a 32-entry tagged BTB broke in cosim.\\\\nA saturating-counter BHT attacks the much larger forward-branch bubble source\\\\nwith minimal area (64 flops) and no changes to pipeline bundles.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a 32-entry direct-mapped Branch History Table with 2-bit saturating\\\\ncounters to the IF stage. The table is indexed by PC[6:2] and initialized to\\\\nstrongly-taken (2'b11) so backward loops are correct immediately without any\\\\ntraining cost. For every conditional branch, the BHT entry MSB drives\\\\npredict_taken; unconditional JAL continues to be always predicted taken. In\\\\nEX stage, each resolved branch writes its actual outcome back to the entry\\\\nindexed by the branch PC using a standard saturating update rule. This adds\\\\nonly 64 flops and a few LUTs of combinational logi...\",\"metadata\":{\"matches\":3,\"truncated\":false},\"title\":\"(?i)(ras|return.?address|jalr.?predict|indirect.?jump)\",\"time\":{\"start\":1778741270607,\"end\":1778741270629}},\"id\":\"prt_e253dd64b001QeLqc6NYLeBJCW\",\"sessionID\":\"ses_1dac84df8ffeqy1fd7OqLOZiN1\",\"messageID\":\"msg_e2537b244001IzeP8pcBWibAO8\"}}\nbench/kimi-k2_6/rep1/agent.log:984:{\"type\":\"tool_use\",\"timestamp\":1778741271251,\"sessionID\":\"ses_1dac84df8ffeqy1fd7OqLOZiN1\",\"part\":{\"type\":\"tool\",\"tool\":\"grep\",\"callID\":\"functions.grep:2\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"(?i)(ras|return.?address|jalr.?predict)\",\"path\":\"cores/bench\",\"include\":\"*.md\"},\"output\":\"No files found\",\"metadata\":{\"matches\":0,\"truncated\":false},\"title\":\"(?i)(ras|return.?address|jalr.?predict)\",\"time\":{\"start\":1778741271228,\"end\":1778741271250}},\"id\":\"prt_e253dd8a10016adnVZ6xOlebUS\",\"sessionID\":\"ses_1dac84df8ffeqy1fd7OqLOZiN1\",\"messageID\":\"msg_e2537b244001IzeP8pcBWibAO8\"}}\nbench/gpt-5_5_high/rep2/agent.log:831:{\"type\":\"tool_use\",\"timestamp\":1778668431189,\"sessionID\":\"ses_1df19dddcffelS3CeTtte84ugY\",\"part\":{\"type\":\"tool\",\"tool\":\"grep\",\"callID\":\"call_ZAGUZfCjKsBna9U4zVOLSksM\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"(?i)(predictor|btb|bht|branch|ras|jal|counter|taken|alias)\",\"path\":\"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_5_high-rep2/cores/bench/experiments/log.jsonl\",\"include\":\"log.jsonl\"},\"output\":\"Found 28 matches\\n/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_5_high-rep2/cores/bench/experiments/log.jsonl:\\n  Line 2: {\\\"id\\\": \\\"hyp-20260512-001-r1s0\\\", \\\"title\\\": \\\"Gate load-use stalls by actual source usage\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"The current hazard unit treats IF/ID instruction bits [19:15] and [24:20]\\\\nas live source registers for every opcode. For OP-IMM, LOAD, JALR, LUI,\\\\nAUIPC, JAL, FENCE, EBREAK, and many illegal encodings, one or both fields\\\\nare immediate or unused bits. If those bits happen to match the destination\\\\nof a preceding load, the pipeline injects a needless bubble. CoreMark has a\\\\ndense mix of immediate arithmetic, loads, address updates, and control flow,\\\\nso removing these false load-use bubbles should improve iterations/cycle\\\\nwithout changing the pipeline depth or top-level contract.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current hazard unit treats IF/ID instruction bits [19:15] and [24:20]\\\\nas live source registers for every opcode. For OP-IMM, LOAD, JALR, LUI,\\\\nAUIPC, JAL, FENCE, EBREAK, and many illegal encodings, one or both fields\\\\nare immediate or unused bits. If those bits happen to match the destination\\\\nof a preceding load, the pipeline injects a needless bubble. CoreMark has a\\\\ndense mix of immediate arithmetic, loads, address updates, and control flow,\\\\nso removing these false load-use bubbles should improve iterations/cycle\\\\nwithout changing the pipeline depth or top-level contract.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a small opcode/funct3 based source-use predecode for the IF/ID\\\\ninstruction and make the load-use detector compare the previous load's rd\\\\nonly against source operands that the next instruction actually consumes.\\\\nR-type and branches use rs1+rs2, stores use rs1+rs2, OP-IMM/LOAD/JALR use\\\\nrs1 only, and LUI/AUIPC/JAL/MISC-MEM/SYSTEM use no data source for hazard\\\\npurposes. This preserves the required one-cycle stall for true load-use\\\\ncases while avoiding bubbles caused solely by immediate-bit aliasing.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 4, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/hazard_unit.sv\\\", \\\"description\\\": \\\"...\\n  Line 4: {\\\"id\\\": \\\"hyp-20260512-003-r1s2\\\", \\\"title\\\": \\\"Add small BTB branch predictor\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The current 5-stage core always fetches sequentially and resolves branches and jumps in EX, so every taken loop branch pays a front-end redirect penalty. CoreMark has many tight backward loop branches, and under random instruction-memory stalls each wasted fetch cycle is especially expensive for iterations per cycle.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current 5-stage core always fetches sequentially and resolves branches and jumps in EX, so every taken loop branch pays a front-end redirect penalty. CoreMark has many tight backward loop branches, and under random instruction-memory stalls each wasted fetch cycle is especially expensive for iterations per cycle.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a small direct-mapped branch target buffer with saturating direction counters, updated in EX and read in IF by the current fetch PC. The IF stage should use a BTB hit with a taken counter to choose the predicted next PC, while ID/EX carries the predicted next PC so EX only redirects on actual-vs-predicted mismatch. This should eliminate most repeated taken-loop penalties after warm-up without changing the single-retire RVFI contract.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 8, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Add predicted next-PC metadata to the IF/ID and ID/EX pipeline bundles so EX can validate the fetch prediction.\\\"}, {\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Implement a small BTB/BHT read path and choose the next fetch PC from the predictor on taken hits, with reset-safe invalid entries.\\\"}, {\\\"file\\\": \\\"rtl/ex_stage.sv\\\", \\\"description\\\": \\\"Compute the actual next PC, raise redirect only on prediction mismatch, and expose branch predictor update information for taken/not-taken outcomes and targets.\\\"}, {\\\"file\\\": \\\"rtl/core.sv\\\", \\\"description\\\": \\\"Wire predictor update signals between EX and IF while preserving the existing NRE...\\n  Line 5: {\\\"id\\\": \\\"hyp-20260512-001-r2s0\\\", \\\"title\\\": \\\"Gate false load-use stalls\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"The pipeline currently stalls on any bit-pattern match between a load in\\\\nID/EX and the raw rs1/rs2 fields of the following IF/ID instruction. Many\\\\nRV32I encodings do not actually consume both fields: OP-IMM and LOAD use\\\\nonly rs1, LUI/AUIPC/JAL use neither, and SYSTEM/FENCE are source-free for\\\\nthis core. These false dependencies inject bubbles in CoreMark's immediate\\\\narithmetic, loop setup, and address-update code without improving\\\\ncorrectness.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The pipeline currently stalls on any bit-pattern match between a load in\\\\nID/EX and the raw rs1/rs2 fields of the following IF/ID instruction. Many\\\\nRV32I encodings do not actually consume both fields: OP-IMM and LOAD use\\\\nonly rs1, LUI/AUIPC/JAL use neither, and SYSTEM/FENCE are source-free for\\\\nthis core. These false dependencies inject bubbles in CoreMark's immediate\\\\narithmetic, loop setup, and address-update code without improving\\\\ncorrectness.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a tiny opcode/funct3 source-use predecode feeding only the load-use\\\\nhazard predicate. The hazard unit should compare the preceding load's rd\\\\nagainst rs1 only when the next instruction actually reads rs1, and against\\\\nrs2 only when it actually reads rs2. Keep the raw instruction rs1/rs2 fields\\\\nflowing through ID/EX and RVFI unchanged so cosim still observes the required\\\\narchitectural register addresses and pre-write snapshots. This should recover\\\\notherwise wasted single-cycle bubbles with minimal new logic and little Fmax\\\\nrisk.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/hazard_unit.sv\\\", \\\"description\\\": \\\"Replace the raw rs1/rs2 load-use match with source-use-qualified matches derived from the IF/ID instruction opcode, preserving true load-use stalls.\\\"}, {\\\"file\\\": \\\"rtl/core.sv\\\", \\\"description\\\": \\\"Pass the full IF/ID instruction or explicit source-use qualif...\\n  Line 6: {\\\"id\\\": \\\"hyp-20260512-002-r2s1\\\", \\\"title\\\": \\\"Resolve simple control flow in ID\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"The current pipeline resolves every branch and jump in EX, so taken control\\\\nflow still carries a two-stage wrong-path penalty unless the BTB predicts it\\\\ncorrectly. The prior structural fetch skid buffer lost because it added IF\\\\ncontrol and muxing without shortening a common dependency path. CoreMark has\\\\nmany loop branches and unconditional jumps, so structurally moving simple\\\\ntarget/condition resolution one stage earlier can improve iterations/cycle\\\\nwithout widening retirement or adding front-end buffering.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current pipeline resolves every branch and jump in EX, so taken control\\\\nflow still carries a two-stage wrong-path penalty unless the BTB predicts it\\\\ncorrectly. The prior structural fetch skid buffer lost because it added IF\\\\ncontrol and muxing without shortening a common dependency path. CoreMark has\\\\nmany loop branches and unconditional jumps, so structurally moving simple\\\\ntarget/condition resolution one stage earlier can improve iterations/cycle\\\\nwithout widening retirement or adding front-end buffering.\\\\n\\\", \\\"hypothesis\\\": \\\"Add an early-control path in ID for JAL and branch instructions whose operands\\\\nare already available from the regfile or WB write-first bypass, and redirect\\\\nIF before the instruction reaches EX. ID/EX should carry an early-resolved\\\\nnext PC plus a flag so EX can skip reissuing the same redirect while still\\\\npreserving the existing EX resolution for forwarded operands, load-use cases,\\\\nJALR, misalignment traps, and predictor updates. This reduces taken JAL and\\\\nmany non-dependent loop branch penalties by one cycle while keeping the\\\\nsingle-retire RVFI boundary and trap discipline unchanged.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Add ID/EX metadata for an early-resolved next PC and whether E...\\n  Line 7: {\\\"id\\\": \\\"hyp-20260512-003-r2s2\\\", \\\"title\\\": \\\"Add tiny return address stack\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing direct-mapped BTB helps repeated fixed-target taken branches, but\\\\nit is weak for function returns because a single return instruction can have\\\\ndifferent dynamic targets depending on the caller. CoreMark's small C working\\\\nset repeatedly calls shared helper routines, so return-target BTB aliasing can\\\\nstill cause EX-stage redirects even after the BTB is warm.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing direct-mapped BTB helps repeated fixed-target taken branches, but\\\\nit is weak for function returns because a single return instruction can have\\\\ndifferent dynamic targets depending on the caller. CoreMark's small C working\\\\nset repeatedly calls shared helper routines, so return-target BTB aliasing can\\\\nstill cause EX-stage redirects even after the BTB is warm.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a very small return address stack in the fetch stage and use lightweight\\\\nIF-side instruction predecode to predict JALR returns from x1/x5 using the\\\\nstack top. Update the stack only from valid EX-stage resolved control-flow:\\\\npush pc+4 for calls that write x1/x5 and pop for JALR returns, avoiding\\\\nspeculative corruption while preserving precise redirect recovery. This should\\\\ncomplement the current BTB without increasing its associativity or broadening\\\\nthe main BTB tag/target lookup, improving CoreMark IPC on call-heavy loops at\\\\nmodest LUT cost.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Add compact call/return predictor metadata if needed so EX can classify valid calls and returns without re-decoding in IF-only logic.\\\"}, {\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Add a 4-entry return address stack, IF-side return predecode, and prediction priority of redirect over RAS return over existing BTB over pc+4.\\\"}, {\\\"file\\\": \\\"rtl/ex_stage.sv\\\", \\\"description\\\": \\\"Classify resolved JAL/...\\n  Line 8: {\\\"id\\\": \\\"hyp-20260513-001-r3s0\\\", \\\"title\\\": \\\"Optimize load byte-lane formatter\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"The current MEM stage formats byte and halfword loads with a variable\\\\n32-bit right shift by addr[1:0] * 8, then forwards the formatted value\\\\ndirectly into the EX-stage operand mux for load-dependent instructions.\\\\nThat creates a likely critical path from dmem read data through a barrel\\\\nshifter, sign-extension mux, forwarding mux, and ALU/branch compare.\\\\nCoreMark has frequent loads and dependent address/data use, so improving\\\\nthis path should raise FPGA Fmax without changing the single-retire IPC\\\\nmodel or any architectural behavior.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current MEM stage formats byte and halfword loads with a variable\\\\n32-bit right shift by addr[1:0] * 8, then forwards the formatted value\\\\ndirectly into the EX-stage operand mux for load-dependent instructions.\\\\nThat creates a likely critical path from dmem read data through a barrel\\\\nshifter, sign-extension mux, forwarding mux, and ALU/branch compare.\\\\nCoreMark has frequent loads and dependent address/data use, so improving\\\\nthis path should raise FPGA Fmax without changing the single-retire IPC\\\\nmodel or any architectural behavior.\\\\n\\\", \\\"hypothesis\\\": \\\"Replace the variable-shift load extraction and shifted byte-mask logic in\\\\nrtl/mem_stage.sv with explicit case statements keyed by alu_result[1:0].\\\\nSelect byte_val and hword_val directly from dmem_rdata lanes, generate the\\\\nbyte/half/word masks with small decode logic, and keep the existing\\\\nmisalignment trapping, RVFI aligned address reporting, and formatted\\\\nMEM-stage forwarding semantics unchanged. This is a local micro-optimization\\\\nintended to reduce LUT depth on the load-to-use forwarding path while\\\\npreserving the current CoreMark cycle count.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/mem_stage.sv\\\", \\\"description\\\": \\\"Replace variable shifts for load extraction and store...\\n  Line 9: {\\\"id\\\": \\\"hyp-20260513-002-r3s1\\\", \\\"title\\\": \\\"Move div/rem off EX critical path\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"The current ALU keeps RV32M division and remainder as single-cycle\\\\ncombinational operations in the EX stage. CoreMark's timed path is dominated\\\\nby loads, branches, integer ALU work, and multiplication, while DIV/REM are\\\\nrare or absent. Keeping a full divider on every EX-cycle timing path likely\\\\ncosts Fmax and LUTs without improving CoreMark iterations per cycle.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current ALU keeps RV32M division and remainder as single-cycle\\\\ncombinational operations in the EX stage. CoreMark's timed path is dominated\\\\nby loads, branches, integer ALU work, and multiplication, while DIV/REM are\\\\nrare or absent. Keeping a full divider on every EX-cycle timing path likely\\\\ncosts Fmax and LUTs without improving CoreMark iterations per cycle.\\\\n\\\", \\\"hypothesis\\\": \\\"Split the M-extension structure so common ALU operations and MUL/MULH stay on\\\\nthe existing one-cycle EX path, but DIV/DIVU/REM/REMU are handled by a small\\\\nmulti-cycle divider sidecar that stalls the pipeline only when one of those\\\\nopcodes reaches EX. This should remove the long combinational divide/remainder\\\\nnetwork from the EX/MEM register timing path and recover FPGA Fmax, while\\\\npreserving CoreMark IPC because the benchmark should not depend on frequent\\\\ndivisions. The sidecar must keep RV32M corner-case results exact, keep ALTOPS\\\\nbehavior for fast formal runs, and retire the original instruction only after\\\\nthe computed result is available.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 4, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Add compact control metadata, if needed, to identify DIV/DIVU/REM/REMU as multi-cycle EX operations without changing the NRET=1 RVFI bundle shape.\\\"}, {\\\"file\\\": \\\"rtl/alu.sv\\\", \\\"description\\\": \\\"Remove real DIV/REM from the one-cycle combinational ALU path while keeping normal ALU, MUL-family, and RISCV_FORM...\\n  Line 10: {\\\"id\\\": \\\"hyp-20260513-003-r3s2\\\", \\\"title\\\": \\\"Predict JAL in fetch\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing 16-entry direct-mapped BTB improved CoreMark, but its benefit is\\\\nlimited by aliasing and by storing unconditional jumps that can be predicted\\\\ndirectly from the fetched instruction. CoreMark's small C workload includes\\\\nrepeated calls and unconditional control transfers, so letting JAL occupy BTB\\\\nentries wastes predictor capacity that could be used for conditional loop\\\\nbranches.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing 16-entry direct-mapped BTB improved CoreMark, but its benefit is\\\\nlimited by aliasing and by storing unconditional jumps that can be predicted\\\\ndirectly from the fetched instruction. CoreMark's small C workload includes\\\\nrepeated calls and unconditional control transfers, so letting JAL occupy BTB\\\\nentries wastes predictor capacity that could be used for conditional loop\\\\nbranches.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a simple IF-stage static predictor for JAL: when the fetched instruction\\\\nopcode is JAL, compute pc plus the J immediate and use that as pred_pc/next_pc\\\\nwithout waiting for an EX-stage BTB update. Keep the existing BTB/BHT path for\\\\nconditional branches, and stop inserting plain JAL updates into the BTB so\\\\nthose entries are not evicted by always-taken direct jumps. This should reduce\\\\ncold jump penalties and BTB conflict misses with much less state and formal\\\\ncomplexity than a return address stack.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Predecode fetched JAL instructions, compute their immediate target in IF, and give that static prediction priority after redirects but before the BTB fallback.\\\"}, {\\\"file\\\": \\\"rtl/ex_stage.sv\\\", \\\"description\\\": \\\"Update the branch predictor only for conditional branches and unresolved indirect jumps, avoiding BTB pollution from direct JAL instructions that IF can predict statically.\\\"}]}, \\\"expected_impact\\\": {\\\"...\\n  Line 12: {\\\"id\\\": \\\"hyp-20260513-002-r4s1\\\", \\\"title\\\": \\\"Post ordinary RAM stores\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"The current pipeline freezes the entire core whenever a store sits in MEM\\\\nand io_dmemReady is low. In the benchmark cosim mode dmem has random\\\\nbackpressure, and CoreMark contains many stores whose results are not\\\\nimmediately consumed by the next integer instructions. Prior structural\\\\nattempts regressed by lengthening the fetch/control critical path; this\\\\ntargets a different bottleneck by decoupling store acceptance from the\\\\nrest of the in-order pipeline.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current pipeline freezes the entire core whenever a store sits in MEM\\\\nand io_dmemReady is low. In the benchmark cosim mode dmem has random\\\\nbackpressure, and CoreMark contains many stores whose results are not\\\\nimmediately consumed by the next integer instructions. Prior structural\\\\nattempts regressed by lengthening the fetch/control critical path; this\\\\ntargets a different bottleneck by decoupling store acceptance from the\\\\nrest of the in-order pipeline.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a one-entry posted store buffer for aligned, non-MMIO RAM stores. When a\\\\nstore reaches MEM while dmem is not ready, capture its address, replicated\\\\nwrite data, byte mask, and RVFI store fields, allow the store to retire once\\\\nit is safely enqueued, and continue executing independent non-memory\\\\ninstructions while the buffer drains to dmem in the background. Preserve\\\\narchitectural ordering by stalling any later load or store until the buffer\\\\nis empty, and never post UART or CoreMark timing-marker MMIO stores so the\\\\nstart/stop bracket remains tied to real bus writes. This should improve\\\\nCoreMark iterations/cycle under random dStall without adding predictor or\\\\nbranch-resolution logic to the critical IF path.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 4, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/mem_stage.sv\\\", \\\"description\\\": \\\"Add a one-entry posted store buffer for aligned nor...\\n  Line 13: {\\\"id\\\": \\\"hyp-20260513-003-r4s2\\\", \\\"title\\\": \\\"Allocate BTB only on taken misses\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The current 16-entry direct-mapped BTB was the only predictor change that\\\\nimproved CoreMark, but its gain is limited by aliasing. Every resolved\\\\nbranch or jump currently installs a tag and target, even when a conditional\\\\nbranch is not taken. A never-taken or mostly-not-taken conditional branch\\\\npredicts the same pc+4 path whether it misses in the BTB or hits a weak/strong\\\\nnot-taken entry, so allocating those misses can evict useful taken loop and\\\\ncall targets without improving the next-PC decision.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current 16-entry direct-mapped BTB was the only predictor change that\\\\nimproved CoreMark, but its gain is limited by aliasing. Every resolved\\\\nbranch or jump currently installs a tag and target, even when a conditional\\\\nbranch is not taken. A never-taken or mostly-not-taken conditional branch\\\\npredicts the same pc+4 path whether it misses in the BTB or hits a weak/strong\\\\nnot-taken entry, so allocating those misses can evict useful taken loop and\\\\ncall targets without improving the next-PC decision.\\\\n\\\", \\\"hypothesis\\\": \\\"Change the BTB update policy so an update for the same resident PC still\\\\ntrains the 2-bit counter in both directions, but an update for a different\\\\nPC allocates/replaces the entry only when the resolved control-flow was\\\\ntaken. On not-taken misses, leave the current entry untouched. This keeps\\\\nthe IF lookup path PC-only and avoids the fetch-stage instruction decode\\\\nthat hurt the JAL predictor attempt, while reducing direct-mapped BTB\\\\npollution from forward conditionals and cold not-taken branches in CoreMark.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Modify BTB update allocation so matching entries continue to train, taken misses allocate/replace, and not-taken misses leave the existing entry intact.\\\"}]}, \\\"exp...\\n  Line 15: {\\\"id\\\": \\\"hyp-20260513-002-r5s1\\\", \\\"title\\\": \\\"Split execute and RVFI forwarding\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"The current forwarding network uses the MEM-stage formatted writeback value for\\\\nboth execute operands and RVFI source snapshots. That keeps the dmem read-data\\\\nformatting path connected to the EX operand muxes even though true load-use\\\\nconsumers are already stalled until the load reaches MEM/WB. Prior wins show\\\\nthat the dmem-to-forwarding path matters, while prior broken source-use work\\\\nshows RVFI raw source snapshots must still be preserved.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current forwarding network uses the MEM-stage formatted writeback value for\\\\nboth execute operands and RVFI source snapshots. That keeps the dmem read-data\\\\nformatting path connected to the EX operand muxes even though true load-use\\\\nconsumers are already stalled until the load reaches MEM/WB. Prior wins show\\\\nthat the dmem-to-forwarding path matters, while prior broken source-use work\\\\nshows RVFI raw source snapshots must still be preserved.\\\\n\\\", \\\"hypothesis\\\": \\\"Restructure forwarding into two planes: an execute plane that forwards only\\\\nALU/JAL results from EX/MEM and WB data from MEM/WB, and an RVFI snapshot\\\\nplane that can still forward the formatted MEM-stage load value for raw rs1\\\\nand rs2 reporting. EX should use the execute plane for ALU operands, branch\\\\ncompares, JALR targets, and store write data; the separately computed RVFI\\\\noperands should be carried in ex_mem_t.rs1_val/rs2_val exactly as today. This\\\\nremoves the load-format/dmem_rdata cone from common execute timing without\\\\nchanging retirement width, load-use interlocks, memory ordering, or RVFI\\\\nsource-field semantics.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 4, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/forward_unit.sv\\\", \\\"description\\\": \\\"Produce separate execute-forwarding and RVFI-source-forwarding selects, suppressing EX/MEM load selection only on the execute plane.\\\"}, {\\\"file\\\": \\\"rtl/ex_stage...\\n  Line 16: {\\\"id\\\": \\\"hyp-20260513-003-r5s2\\\", \\\"title\\\": \\\"Double PC-only BTB capacity\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The only successful predictor change so far was the small direct-mapped BTB,\\\\nand the lessons point to aliasing as the remaining limiter. Attempts that\\\\nadded fetched-instruction predecode, return-stack speculation, or more update\\\\npolicy control hurt timing or formal tractability. A capacity-only BTB change\\\\nkeeps the predictor lookup PC-only while reducing conflicts among CoreMark's\\\\nrepeated loop branches and calls.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The only successful predictor change so far was the small direct-mapped BTB,\\\\nand the lessons point to aliasing as the remaining limiter. Attempts that\\\\nadded fetched-instruction predecode, return-stack speculation, or more update\\\\npolicy control hurt timing or formal tractability. A capacity-only BTB change\\\\nkeeps the predictor lookup PC-only while reducing conflicts among CoreMark's\\\\nrepeated loop branches and calls.\\\\n\\\", \\\"hypothesis\\\": \\\"Increase the existing direct-mapped BTB/BHT from 16 entries to 32 entries by\\\\nwidening the PC index by one bit, while preserving the current full-PC tag,\\\\ntarget, 2-bit counter, EX-stage update, and prediction-mismatch recovery\\\\nbehavior. This should reduce destructive aliasing without adding instruction\\\\ndecode, extra ways, a RAS, or additional control-flow compares to the fetch\\\\nnext-PC path. The expected benefit is mainly higher CoreMark iterations per\\\\ncycle from fewer warm-loop redirects, with modest Fmax risk from the slightly\\\\nlarger indexed predictor arrays.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Change the BTB entry count and index width from 16/4 to 32/5, leaving the existing PC-only lookup and EX update semantics intact.\\\"}]}, \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Change the BTB entry count ...\\n  Line 17: {\\\"id\\\": \\\"hyp-20260513-001-r6s0\\\", \\\"title\\\": \\\"Trim BTB tag compare\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"The current 16-entry direct-mapped BTB remains one of the few successful IPC improvements, but its IF-stage lookup still stores and compares the full 32-bit fetch PC even though the low two alignment bits and the index bits are redundant. Prior predictor-policy and capacity changes regressed by adding front-end logic, so the safer micro-opt path is to keep identical prediction behavior while reducing the lookup cone and state width.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current 16-entry direct-mapped BTB remains one of the few successful IPC improvements, but its IF-stage lookup still stores and compares the full 32-bit fetch PC even though the low two alignment bits and the index bits are redundant. Prior predictor-policy and capacity changes regressed by adding front-end logic, so the safer micro-opt path is to keep identical prediction behavior while reducing the lookup cone and state width.\\\\n\\\", \\\"hypothesis\\\": \\\"Replace the BTB's full btb_pc array with a compact tag containing only pc[31:BTB_INDEX_BITS+2], and store targets as word addresses plus two implicit zero low bits. The fetch hit check and update same-entry check then use a narrower tag compare, while the existing direct-mapped index, 2-bit counter policy, redirect priority, and EX-stage update semantics stay unchanged. This should slightly shorten the IF next-PC path and reduce LUT/FF pressure without changing CoreMark cycle count or any architectural state.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Replace full-PC BTB tags with compact non-index PC tags and store aligned target word addresses, preserving the existing lookup/update behavior with less IF-stage compare and array width.\\\"}]}, \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Replac...\\n  Line 18: {\\\"id\\\": \\\"hyp-20260513-002-r6s1\\\", \\\"title\\\": \\\"Register IF/ID boundary\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"The bench core currently has a PC register in IF, but the IF/ID payload is\\\\ncombinational: imem data, raw instruction fields, decoder outputs, immediate\\\\ngeneration, and regfile read addresses all feed the ID/EX register in one\\\\ncycle. Prior structural attempts that added predictors, buffers, or early\\\\ncontrol logic regressed because they lengthened IF-side muxing or broad\\\\npipeline control. A narrower structural retiming can attack the same frontend\\\\ntiming pressure without adding a larger predictor or side buffer.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The bench core currently has a PC register in IF, but the IF/ID payload is\\\\ncombinational: imem data, raw instruction fields, decoder outputs, immediate\\\\ngeneration, and regfile read addresses all feed the ID/EX register in one\\\\ncycle. Prior structural attempts that added predictors, buffers, or early\\\\ncontrol logic regressed because they lengthened IF-side muxing or broad\\\\npipeline control. A narrower structural retiming can attack the same frontend\\\\ntiming pressure without adding a larger predictor or side buffer.\\\\n\\\", \\\"hypothesis\\\": \\\"Convert IF/ID into a true registered pipeline boundary that captures pc,\\\\npredicted pc, instruction, and valid when imem is ready, holds across ID or\\\\ndmem stalls, and flushes on redirects. This cuts the imem-data-to-decode and\\\\nimem-data-to-regfile-address path out of the ID/EX setup cone, and the single\\\\nregistered entry can also let ID consume one already-fetched instruction when\\\\nthe next imem access stalls. The cost is one extra frontend stage and a larger\\\\nredirect bubble on unpredicted control flow, but CoreMark's hot loop branches\\\\nare already helped by the existing BTB, so the expected net gain is higher\\\\nFmax plus modest iStall tolerance with much less control complexity than the\\\\nearlier skid-buffer attempt.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"me...\\n  Line 19: {\\\"id\\\": \\\"hyp-20260513-003-r6s2\\\", \\\"title\\\": \\\"Narrow BTB tags\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The current successful predictor is a 16-entry direct-mapped BTB/BHT, but\\\\nevery IF cycle still performs a full 32-bit PC tag comparison before choosing\\\\nthe predicted target. Prior predictor attempts show that larger tables,\\\\nfetched-instruction predecode, taken-only allocation policy, and RAS state add\\\\nmore front-end/control cost than CoreMark repays. CoreMark's timed image is a\\\\nsmall 6 KB working set in low memory, so a full 32-bit tag is unnecessary for\\\\ndistinguishing useful in-image control-flow PCs.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current successful predictor is a 16-entry direct-mapped BTB/BHT, but\\\\nevery IF cycle still performs a full 32-bit PC tag comparison before choosing\\\\nthe predicted target. Prior predictor attempts show that larger tables,\\\\nfetched-instruction predecode, taken-only allocation policy, and RAS state add\\\\nmore front-end/control cost than CoreMark repays. CoreMark's timed image is a\\\\nsmall 6 KB working set in low memory, so a full 32-bit tag is unnecessary for\\\\ndistinguishing useful in-image control-flow PCs.\\\\n\\\", \\\"hypothesis\\\": \\\"Replace the BTB's stored full-PC tag with a compact low-address tag derived\\\\nfrom bits above the 16-entry index, for example pc[12:6]. Keep the same entry\\\\ncount, target storage, 2-bit counters, EX-stage update policy, redirect\\\\nrecovery, and predicted-next-PC metadata. This preserves the predictor behavior\\\\nfor unique branch PCs within the CoreMark code window while shortening the IF\\\\nhit comparator and reducing predictor flip-flops/LUT fanout, so Fmax should\\\\nimprove without repeating the IPC regressions from capacity or policy changes.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Store and compare a narrow BTB tag such as pc[12:6] instead of the full fetch PC, leaving table size, counters, targets, and update semantics unc...\\n  Line 20: {\\\"id\\\": \\\"hyp-20260513-001-r7s0\\\", \\\"title\\\": \\\"Prune dead pipeline payload\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"The successful recent hypotheses for this core have been small local reductions\\\\nin LUT depth, muxing, or state width that preserve the current pipeline behavior.\\\\nThe EX/MEM bundle still carries branch_taken and branch_target even though no\\\\ndownstream stage consumes them, and ctrl.is_lui is decoded and transported\\\\nthrough every pipeline register even though LUI is already represented by\\\\nalu_op=ALU_LUI plus alu_src. These dead bits add flops, fanout, and routing in\\\\nthe execute and decode cones without contributing to RVFI or architectural state.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The successful recent hypotheses for this core have been small local reductions\\\\nin LUT depth, muxing, or state width that preserve the current pipeline behavior.\\\\nThe EX/MEM bundle still carries branch_taken and branch_target even though no\\\\ndownstream stage consumes them, and ctrl.is_lui is decoded and transported\\\\nthrough every pipeline register even though LUI is already represented by\\\\nalu_op=ALU_LUI plus alu_src. These dead bits add flops, fanout, and routing in\\\\nthe execute and decode cones without contributing to RVFI or architectural state.\\\\n\\\", \\\"hypothesis\\\": \\\"Remove unused pipeline/control payload: delete ctrl_t.is_lui, the decoder and\\\\nID-stage wiring that only feeds it, and the EX/MEM branch_taken and branch_target\\\\nfields and assignments. Keep all existing branch resolution, redirect, BTB update,\\\\nRVFI pc_wdata, trap, and register-write behavior unchanged. This should slightly\\\\nreduce EX-stage register input fanout and inter-stage bundle width, improving Tang\\\\nNano 20K Fmax and LUT/FF pressure without changing CoreMark cycle count.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Remove dead ctrl_t.is_lui and unused EX/MEM branch_taken and branch_target fields from the packed pipeline bu...\\n  Line 21: {\\\"id\\\": \\\"hyp-20260513-002-r7s1\\\", \\\"title\\\": \\\"Use zero-bubble load forwarding\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"The current pipeline still injects a one-cycle bubble for every true load-use\\\\ndependency even though MEM-stage forwarding already formats load data and can\\\\nfeed the EX operand muxes. CoreMark has many pointer-chasing and state-update\\\\nsequences where removing those bubbles should improve iterations per cycle.\\\\nPrior structural attempts lost by adding front-end or store-buffer control;\\\\nthis keeps the pipeline shape intact and changes only the interlock policy.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current pipeline still injects a one-cycle bubble for every true load-use\\\\ndependency even though MEM-stage forwarding already formats load data and can\\\\nfeed the EX operand muxes. CoreMark has many pointer-chasing and state-update\\\\nsequences where removing those bubbles should improve iterations per cycle.\\\\nPrior structural attempts lost by adding front-end or store-buffer control;\\\\nthis keeps the pipeline shape intact and changes only the interlock policy.\\\\n\\\", \\\"hypothesis\\\": \\\"Restructure the load-use path so a consumer immediately behind a load is\\\\nallowed to enter EX while the load is in MEM, using the existing EX/MEM\\\\nforwarding select to supply formatted load data directly from mem_stage.\\\\nIf dmem backpressure occurs, the existing dmem stall should hold both the\\\\nload in MEM and the dependent consumer in ID/EX until data is available, so\\\\ncorrectness remains in-order without adding a new buffer. This trades a\\\\nlonger dmem-to-EX bypass path for fewer CoreMark dependency bubbles; the\\\\nprevious lane-mux load formatter win makes that timing path cheaper than it\\\\nwas before.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 4, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/hazard_unit.sv\\\", \\\"description\\\": \\\"Remove the unconditional load-use bubble and rely on dmem stalls plus MEM-stage load forwarding for true dependent consumers.\\\"}, {\\\"file\\\": \\\"rtl/ex_stage.sv\\\"...\\n  Line 22: {\\\"id\\\": \\\"hyp-20260513-003-r7s2\\\", \\\"title\\\": \\\"Simplify BTB direction state\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The useful predictor changes so far point toward preserving the small PC-only\\\\nBTB and trimming its lookup representation rather than adding fetch predecode,\\\\nreturn-stack state, or more entries. The current IF path still reads a 2-bit\\\\ncounter per entry and gates the hit target through the counter MSB, while the\\\\nupdate path contains saturating increment/decrement logic for every resolved\\\\ncontrol-flow instruction. CoreMark's hot backward branches are mostly taken and\\\\nalready recover from loop exits by keeping the target resident, so a simpler\\\\ndirection representation may trade a small amount of hysteresis for better Fmax.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The useful predictor changes so far point toward preserving the small PC-only\\\\nBTB and trimming its lookup representation rather than adding fetch predecode,\\\\nreturn-stack state, or more entries. The current IF path still reads a 2-bit\\\\ncounter per entry and gates the hit target through the counter MSB, while the\\\\nupdate path contains saturating increment/decrement logic for every resolved\\\\ncontrol-flow instruction. CoreMark's hot backward branches are mostly taken and\\\\nalready recover from loop exits by keeping the target resident, so a simpler\\\\ndirection representation may trade a small amount of hysteresis for better Fmax.\\\\n\\\", \\\"hypothesis\\\": \\\"Replace the BTB's 2-bit saturating counters with a one-bit direction bit while\\\\nkeeping the existing 16-entry direct-mapped tag and word-target arrays. Predict\\\\na BTB hit only when the resident direction bit is set, allocate or set the bit\\\\non taken updates, and clear it on matching not-taken updates without allocating\\\\nnot-taken misses. This preserves the PC-only IF lookup and avoids the failed\\\\nlarger-table, RAS, and IF-instruction-predecode directions, while removing the\\\\ncounter add/sub/compare logic and one prediction-state bit per entry from the\\\\nfront-e...\\n  Line 23: {\\\"id\\\": \\\"hyp-20260513-001-r8s0\\\", \\\"title\\\": \\\"Fold load writeback select\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"The strongest recent wins for cores/bench have come from behavior-preserving\\\\ndatapath and payload reductions, especially pruning dead or duplicate control\\\\ncarried through the pipeline. The current ctrl_t still includes mem_to_reg,\\\\nbut in this RV32IM pipeline that bit is set exactly for loads and is therefore\\\\nredundant with mem_read. Carrying both bits through ID/EX, EX/MEM, and MEM/WB\\\\nadds decode fanout, register width, and writeback mux control pressure without\\\\nimproving CoreMark IPC or architectural precision.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The strongest recent wins for cores/bench have come from behavior-preserving\\\\ndatapath and payload reductions, especially pruning dead or duplicate control\\\\ncarried through the pipeline. The current ctrl_t still includes mem_to_reg,\\\\nbut in this RV32IM pipeline that bit is set exactly for loads and is therefore\\\\nredundant with mem_read. Carrying both bits through ID/EX, EX/MEM, and MEM/WB\\\\nadds decode fanout, register width, and writeback mux control pressure without\\\\nimproving CoreMark IPC or architectural precision.\\\\n\\\", \\\"hypothesis\\\": \\\"Remove ctrl_t.mem_to_reg and use ctrl.mem_read wherever the pipeline needs to\\\\nselect formatted load data instead of the ALU/JAL result. Decoder LOAD arms\\\\nshould set only mem_read, MEM-stage forwarding should choose load_data when\\\\nmem_read is true, and WB should use mem_read as the writeback-data select.\\\\nMisaligned loads already clear reg_write through the trap path, so the selected\\\\nignored data value is not architecturally visible. This should trim one hot\\\\ncontrol bit and its muxing across the full pipeline while preserving the NRET=1\\\\nRVFI contract, load/store masks, traps, and CoreMark cycle count.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Delete the redundant ctrl_t.mem_to_reg field ...\\n  Line 24: {\\\"id\\\": \\\"hyp-20260513-002-r8s1\\\", \\\"title\\\": \\\"Retire directly from MEM\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"The current bench core still carries a full MEM/WB register and a separate\\\\ncombinational WB stage even though MEM already computes the final writeback\\\\nvalue, formatted load data, memory masks, and RVFI memory fields. Recent wins\\\\ncame from pruning dead pipeline payload and shortening local datapath cones,\\\\nwhile prior structural regressions came from adding front-end buffers,\\\\nearlier branch logic, store buffers, or same-cycle dmem-to-EX pressure. A\\\\nMEM-stage retirement boundary attacks pipeline structure and routing pressure\\\\nwithout adding predictor state or changing the NRET=1 contract.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current bench core still carries a full MEM/WB register and a separate\\\\ncombinational WB stage even though MEM already computes the final writeback\\\\nvalue, formatted load data, memory masks, and RVFI memory fields. Recent wins\\\\ncame from pruning dead pipeline payload and shortening local datapath cones,\\\\nwhile prior structural regressions came from adding front-end buffers,\\\\nearlier branch logic, store buffers, or same-cycle dmem-to-EX pressure. A\\\\nMEM-stage retirement boundary attacks pipeline structure and routing pressure\\\\nwithout adding predictor state or changing the NRET=1 contract.\\\\n\\\", \\\"hypothesis\\\": \\\"Collapse writeback/retirement into the MEM stage: compute the final rd write\\\\ndata from the current EX/MEM payload, write the regfile from that MEM-stage\\\\ncommit value, and drive RVFI channel 0 from the same commit record when the\\\\nmemory operation is actually accepted. Keep the existing one-cycle load-use\\\\ninterlock, but remove the broad MEM/WB payload and replace MEM/WB forwarding\\\\nwith MEM-stage forwarding plus the regfile's same-cycle write-first bypass\\\\nfor instructions two cycles behind a producer. This should reduce flop count,\\\\nforwarding mux fan-in, and routing fanout on every instruction while keeping\\\\nCoreMark's steady...\\n  Line 25: {\\\"id\\\": \\\"hyp-20260513-003-r8s2\\\", \\\"title\\\": \\\"Filter BTB updates to loop backedges\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing 16-entry PC-only BTB with compact tags and 2-bit counters is the\\\\nonly predictor shape that has consistently helped CoreMark. Recent predictor\\\\nregressions came from adding IF-side instruction predecode, larger tables,\\\\nnarrower tags, taken-only allocation logic in the IF update path, and weaker\\\\ndirection hysteresis. The remaining low-risk opportunity is to preserve the\\\\nproven IF lookup path while reducing direct-mapped pollution from conditional\\\\nbranches that do not help hot loop prediction.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing 16-entry PC-only BTB with compact tags and 2-bit counters is the\\\\nonly predictor shape that has consistently helped CoreMark. Recent predictor\\\\nregressions came from adding IF-side instruction predecode, larger tables,\\\\nnarrower tags, taken-only allocation logic in the IF update path, and weaker\\\\ndirection hysteresis. The remaining low-risk opportunity is to preserve the\\\\nproven IF lookup path while reducing direct-mapped pollution from conditional\\\\nbranches that do not help hot loop prediction.\\\\n\\\", \\\"hypothesis\\\": \\\"Gate branch predictor updates in EX so conditional branches allocate/train the\\\\nBTB only when they are taken backward branches, while direct jumps and JALR\\\\ncontinue to update as today. This keeps the fetch critical path, table size,\\\\ntag width, target representation, and 2-bit counter lookup unchanged, but stops\\\\nforward conditionals and not-taken branches from replacing useful CoreMark loop\\\\nbackedge entries. Loop exits still recover through the existing EX redirect,\\\\nand the sticky backedge entries should improve iterations per cycle under the\\\\nrandom iStall model without repeating the failed larger-table or IF-predecode\\\\napproaches.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/ex_stage.sv\\\", \\\"description\\\": \\\"Qualify bpu_update_valid...\\n  Line 26: {\\\"id\\\": \\\"hyp-20260513-001-r9s0\\\", \\\"title\\\": \\\"Prune duplicate register fields\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"Recent successful bench-core changes have been behavior-preserving reductions in\\\\ndatapath width, control fanout, and inter-stage payload. The pipeline currently\\\\ncarries rd, rs1_addr, and rs2_addr as explicit fields in multiple bundles even\\\\nthough the full instruction word is already carried to every later stage for\\\\nRVFI. Those duplicated register-address flops and mux inputs add routing and\\\\nfanout without improving IPC or architectural precision.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"Recent successful bench-core changes have been behavior-preserving reductions in\\\\ndatapath width, control fanout, and inter-stage payload. The pipeline currently\\\\ncarries rd, rs1_addr, and rs2_addr as explicit fields in multiple bundles even\\\\nthough the full instruction word is already carried to every later stage for\\\\nRVFI. Those duplicated register-address flops and mux inputs add routing and\\\\nfanout without improving IPC or architectural precision.\\\\n\\\", \\\"hypothesis\\\": \\\"Delete the duplicated rd/rs1_addr/rs2_addr fields from the packed pipeline\\\\npayloads and derive register addresses from the carried instruction bits at\\\\neach use site: forwarding compares, writeback address selection, and RVFI\\\\nsource/destination reporting. Keep raw instruction fields for RVFI rs1/rs2 so\\\\nunused operands still report the same pre-write snapshots expected by cosim,\\\\nand keep all reg_write/x0 gating unchanged. This should reduce flip-flops and\\\\nrouting pressure in the ID/EX, EX/MEM, and MEM/WB cones without changing\\\\nCoreMark cycle count, predictor behavior, traps, or the NRET=1 top-level port\\\\ncontract.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Remove duplicated rd, rs1_addr, and rs2_addr fields from ID/EX, EX/MEM, and MEM/WB bundles while keeping instr for RVFI and address derivation.\\\"}, {\\\"file\\\": \\\"rtl/id...\\n  Line 27: {\\\"id\\\": \\\"hyp-20260513-002-r9s1\\\", \\\"title\\\": \\\"Pipeline BTB update path\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"Recent structural attempts that added front-end buffering, early control resolution, store posting, or zero-bubble load-use forwarding either lengthened hot paths or disturbed required stall/forwarding behavior. The existing 16-entry BTB is still useful, but its same-cycle update path takes EX-stage branch results, computes update index/tag/target, compares the old tag, and drives counter/entry write data in the IF module. That path can cost Fmax without improving the current cycle's redirect decision.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"Recent structural attempts that added front-end buffering, early control resolution, store posting, or zero-bubble load-use forwarding either lengthened hot paths or disturbed required stall/forwarding behavior. The existing 16-entry BTB is still useful, but its same-cycle update path takes EX-stage branch results, computes update index/tag/target, compares the old tag, and drives counter/entry write data in the IF module. That path can cost Fmax without improving the current cycle's redirect decision.\\\\n\\\", \\\"hypothesis\\\": \\\"Insert a one-cycle registered BTB update queue inside if_stage. EX still produces redirect and redirect_target in the same cycle, so architectural recovery and RVFI pc_wdata behavior are unchanged, but bpu_update_valid/pc/taken/target are first captured into a small update register and the BTB tag/target/counter arrays are written from that register on the following cycle. This removes the branch-compare/target cone from the direct BTB array write-data path while preserving the existing 16-entry direct-mapped predictor policy, two-bit hysteresis, tag width, and fetch next-PC lookup. CoreMark loop bodies should rarely refetch the same branch before a one-cycle-delayed update becomes visible, so the expected IPC loss is minimal while Fmax may improve.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\":...\\n  Line 28: {\\\"id\\\": \\\"hyp-20260513-003-r9s2\\\", \\\"title\\\": \\\"Compress predicted PC metadata\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing 16-entry PC-only BTB with compact tags and 2-bit counters is the\\\\nonly predictor shape that has reliably helped this core. Recent predictor\\\\nregressions came from changing policy, capacity, or adding IF-side instruction\\\\ndecode. One remaining predictor-specific cost is that IF carries a full 32-bit\\\\npredicted next PC through IF/ID and ID/EX, then EX compares it against the\\\\nresolved aligned next PC on every valid instruction.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing 16-entry PC-only BTB with compact tags and 2-bit counters is the\\\\nonly predictor shape that has reliably helped this core. Recent predictor\\\\nregressions came from changing policy, capacity, or adding IF-side instruction\\\\ndecode. One remaining predictor-specific cost is that IF carries a full 32-bit\\\\npredicted next PC through IF/ID and ID/EX, then EX compares it against the\\\\nresolved aligned next PC on every valid instruction.\\\\n\\\", \\\"hypothesis\\\": \\\"Store and pipeline the predicted next PC as an aligned word address rather\\\\nthan a full byte address. The IF predictor already produces only aligned\\\\nsequential or BTB targets, and EX suppresses misaligned control transfers by\\\\ntrapping and using pc+4, so the low two predicted bits are redundant. Changing\\\\npred_pc to pred_pc_word in the pipeline bundles and comparing actual_next_pc[31:2]\\\\nin EX preserves BTB behavior and redirect recovery while trimming two carried\\\\nbits and a little compare/mux fanout from the predictor validation path.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Replace if_id_t/id_ex_t pred_pc with a 30-bit aligned predicted PC word field.\\\"}, {\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Generate predicted_pc_word from the existing sequential/BTB prediction and reconstruct byte PCs only where needed for fetch.\\\"}, {\\\"file\\\": \\\"rtl/id_st...\\n  Line 31: {\\\"id\\\": \\\"hyp-20260513-003-r10s2\\\", \\\"title\\\": \\\"Strong-bias BTB allocations\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The existing 16-entry PC-only BTB with compact tags and two-bit counters is the only predictor shape that has improved this core. Recent predictor regressions came from changing table size, adding IF-side instruction predecode, weakening hysteresis, filtering feedback, or delaying updates. A safer remaining predictor angle is to preserve the lookup path and state shape while changing only the initial counter bias on newly allocated taken entries.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The existing 16-entry PC-only BTB with compact tags and two-bit counters is the only predictor shape that has improved this core. Recent predictor regressions came from changing table size, adding IF-side instruction predecode, weakening hysteresis, filtering feedback, or delaying updates. A safer remaining predictor angle is to preserve the lookup path and state shape while changing only the initial counter bias on newly allocated taken entries.\\\\n\\\", \\\"hypothesis\\\": \\\"Initialize a newly allocated taken BTB entry to strongly taken instead of weakly taken, while keeping not-taken allocations, matching-entry training, tags, targets, entry count, and EX-stage updates unchanged. This gives short CoreMark loops and call/branch sites one extra bit of hysteresis immediately after the first taken observation, so a single loop-exit not-taken update is less likely to poison the next loop entry. Because the fetch lookup still reads the same valid/tag/target/counter arrays and uses the same counter MSB, the change should have almost no Fmax risk and may recover a small amount of branch IPC.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 1, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Change BTB allocation for newly observed taken control-flow entries from weak-taken to strong-taken, leaving lookup logic, table size, tags, targets, and normal saturating counter t...\\n  Line 32: {\\\"id\\\": \\\"hyp-20260513-001-r11s0\\\", \\\"title\\\": \\\"Drop masked BTB resets\\\", \\\"category\\\": \\\"micro_opt\\\", \\\"motivation\\\": \\\"The successful bench-core micro-optimizations have mostly reduced local state,\\\\nfanout, and mux pressure without changing IPC behavior. The current IF-stage\\\\nBTB reset loop clears every tag, target, and saturating-counter bit, but those\\\\nfields are architecturally irrelevant while the corresponding valid bit is\\\\nzero. Keeping reset muxes and reset routing on the whole predictor array may\\\\ncost Tang Nano 20K Fmax in the already sensitive fetch next-PC region.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The successful bench-core micro-optimizations have mostly reduced local state,\\\\nfanout, and mux pressure without changing IPC behavior. The current IF-stage\\\\nBTB reset loop clears every tag, target, and saturating-counter bit, but those\\\\nfields are architecturally irrelevant while the corresponding valid bit is\\\\nzero. Keeping reset muxes and reset routing on the whole predictor array may\\\\ncost Tang Nano 20K Fmax in the already sensitive fetch next-PC region.\\\\n\\\", \\\"hypothesis\\\": \\\"Reset only the BTB valid bits and leave btb_tag, btb_target_word, and btb_ctr\\\\nas don't-care state until an entry is allocated. Fetch lookup already requires\\\\nbtb_valid before comparing tags or using the target/counter, and the update\\\\npath initializes tag, target, and counter on every invalid or tag-mismatched\\\\nallocation. This should preserve the existing 16-entry direct-mapped BTB\\\\nprediction policy and CoreMark cycle count while trimming reset fanout and\\\\nsequential muxing from the IF-stage predictor arrays.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Reset only btb_valid entries and rely on allocation writes to initialize tag, target, and counter state before any valid lookup can use them.\\\"}]}, \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 2, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"descripti...\\n  Line 33: {\\\"id\\\": \\\"hyp-20260513-002-r11s1\\\", \\\"title\\\": \\\"Bypass ALU for LSU addresses\\\", \\\"category\\\": \\\"structural\\\", \\\"motivation\\\": \\\"CoreMark spends much of its timed region in pointer-heavy load/store code, and the\\\\ncurrent EX stage routes every memory effective address through the same monolithic\\\\nRV32IM ALU result bus used for arithmetic, multiply, divide, and writeback values.\\\\nRecent structural attempts that added buffers or changed retirement boundaries\\\\nregressed, while local datapath isolation and payload pruning have produced the\\\\nstrongest gains.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"CoreMark spends much of its timed region in pointer-heavy load/store code, and the\\\\ncurrent EX stage routes every memory effective address through the same monolithic\\\\nRV32IM ALU result bus used for arithmetic, multiply, divide, and writeback values.\\\\nRecent structural attempts that added buffers or changed retirement boundaries\\\\nregressed, while local datapath isolation and payload pruning have produced the\\\\nstrongest gains.\\\\n\\\", \\\"hypothesis\\\": \\\"Restructure EX so instruction classes have separate result producers: a dedicated\\\\nrs1+imm address adder for LOAD/STORE, the existing branch/jump target adders for\\\\ncontrol flow, a direct pc+4 path for JAL/JALR writeback, and the full ALU output\\\\nonly for arithmetic instructions that actually need it. EX/MEM should receive the\\\\nLSU address from the small address adder instead of the full ALU mux whenever\\\\nmem_read or mem_write is set, while all hazards, forwarding, dmem stall behavior,\\\\nmisalignment checks, and RVFI fields remain unchanged. This should shorten the\\\\ncommon load/store address-to-MEM path and reduce full-ALU fanout without adding\\\\nbubbles or predictor state.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 3, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/ex_stage.sv\\\", \\\"description\\\": \\\"Add a dedicated LSU effective-address adder and select it for EX/MEM alu_result on memory operations, keeping the full ALU result only for arithmetic writeback pa...\\n  Line 34: {\\\"id\\\": \\\"hyp-20260513-003-r11s2\\\", \\\"title\\\": \\\"Add one-entry BTB victim\\\", \\\"category\\\": \\\"predictor\\\", \\\"motivation\\\": \\\"The current compact 16-entry PC-only BTB is the only predictor shape that has\\\\nreliably improved this core, but the lessons show direct-mapped aliasing is\\\\nstill the likely remaining predictor limiter. Prior attempts to reduce that\\\\naliasing by widening the table, narrowing tags, filtering updates, changing\\\\nhysteresis, adding IF instruction predecode, or adding RAS state all regressed.\\\\nA tiny victim entry attacks only conflict misses while preserving the proven\\\\nmain BTB size, tag width, 2-bit counters, and EX-stage update discipline.\\\\n\\\", \\\"hypothesis\\\": {\\\"motivation\\\": \\\"The current compact 16-entry PC-only BTB is the only predictor shape that has\\\\nreliably improved this core, but the lessons show direct-mapped aliasing is\\\\nstill the likely remaining predictor limiter. Prior attempts to reduce that\\\\naliasing by widening the table, narrowing tags, filtering updates, changing\\\\nhysteresis, adding IF instruction predecode, or adding RAS state all regressed.\\\\nA tiny victim entry attacks only conflict misses while preserving the proven\\\\nmain BTB size, tag width, 2-bit counters, and EX-stage update discipline.\\\\n\\\", \\\"hypothesis\\\": \\\"Add a single fully tagged victim BTB entry beside the existing 16-entry direct\\\\nmapped BTB. On a main-table replacement, copy the evicted valid entry into the\\\\nvictim slot with its PC word tag, target word, and 2-bit counter. During fetch,\\\\nkeep the current main BTB lookup as priority, and on a main miss allow a victim\\\\nhit with a taken counter to supply the predicted target. Updates that match the\\\\nvictim entry train its counter and target in place; other updates continue to\\\\nallocate and train the main table as today. This should recover hot two-branch\\\\nindex conflicts in CoreMark without the broad IF path and routing cost of a\\\\n32-entry table or the formal/timing risk of instruction-dependent prediction.\\\\n\\\", \\\"expected_impact\\\": {\\\"fitness_d...\",\"metadata\":{\"matches\":28,\"truncated\":false},\"title\":\"(?i)(predictor|btb|bht|branch|ras|jal|counter|taken|alias)\",\"time\":{\"start\":1778668431147,\"end\":1778668431187}},\"metadata\":{\"openai\":{\"itemId\":\"fc_003b8fcb67119d6d016a04538eed648198b67bcac8c305d8bd\"}},\"id\":\"prt_e20e66702001sEb1RGY02oTXRQ\",\"sessionID\":\"ses_1df19dddcffelS3CeTtte84ugY\",\"messageID\":\"msg_e20e6232c001beYLYBsIWhvadq\"}}\nbench/kimi-k2_6/rep2/agent.log:758:{\"type\":\"tool_use\",\"timestamp\":1778741493003,\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"bash:18\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"riscv64-unknown-elf-gcc -march=rv32im -mabi=ilp32 -O3 -S -Ibench/programs/coremark -Ibench/programs/coremark/baremetal -DTOTAL_DATA_SIZE=2000 bench/programs/coremark/core_matrix.c -o /tmp/core_matrix.s && grep -c 'jalr' /tmp/core_matrix.s; grep -c 'beq\\\\|bne\\\\|blt\\\\|bge\\\\|bltu\\\\|bgeu' /tmp/core_matrix.s\",\"description\":\"Count branches and jumps in matrix code\"},\"output\":\"0\\n42\\n\",\"metadata\":{\"output\":\"0\\n42\\n\",\"exit\":0,\"description\":\"Count branches and jumps in matrix code\",\"truncated\":false},\"title\":\"Count branches and jumps in matrix code\",\"time\":{\"start\":1778741493001,\"end\":1778741493002}},\"id\":\"prt_e25412e5f001u7NS3YVEN1ic2d\",\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"messageID\":\"msg_e25409372001VGNU6T71rKsX46\"}}\nbench/kimi-k2_6/rep2/agent.log:761:{\"type\":\"tool_use\",\"timestamp\":1778741502002,\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"bash:19\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"make -C bench/programs coremark.elf 2>/dev/null || true; if [ -f bench/programs/coremark.elf ]; then riscv64-unknown-elf-objdump -d bench/programs/coremark.elf | grep -c 'jalr'; else echo \\\"no elf\\\"; fi\",\"description\":\"Count JALR in full benchmark\"},\"output\":\"make: Nothing to be done for `coremark.elf'.\\n1\\n\",\"metadata\":{\"output\":\"make: Nothing to be done for `coremark.elf'.\\n1\\n\",\"exit\":0,\"description\":\"Count JALR in full benchmark\",\"truncated\":false},\"title\":\"Count JALR in full benchmark\",\"time\":{\"start\":1778741502001,\"end\":1778741502002}},\"id\":\"prt_e25415799001OZy0AOLJ64KVr0\",\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"messageID\":\"msg_e25413e2c001lH9lvNT10qMz9o\"}}\nbench/kimi-k2_6/rep2/agent.log:764:{\"type\":\"tool_use\",\"timestamp\":1778741510640,\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"bash:20\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"riscv64-unknown-elf-objdump -d bench/programs/coremark.elf | grep -c 'jal\\\\b'\",\"description\":\"Count JAL instructions\"},\"output\":\"96\\n\",\"metadata\":{\"output\":\"96\\n\",\"exit\":0,\"description\":\"Count JAL instructions\",\"truncated\":false},\"title\":\"Count JAL instructions\",\"time\":{\"start\":1778741510638,\"end\":1778741510640}},\"id\":\"prt_e25417ec8001PFLoSB4G9ADR0F\",\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"messageID\":\"msg_e254165c500145cCd3StqBQ3R4\"}}\nbench/kimi-k2_6/rep2/agent.log:767:{\"type\":\"tool_use\",\"timestamp\":1778741519744,\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"bash:21\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"riscv64-unknown-elf-objdump -d bench/programs/coremark.elf | grep -E '^(\\\\s+[0-9a-f]+:\\\\s+[0-9a-f]+\\\\s+)(beq|bne|blt|bge|bltu|bgeu)' | wc -l\",\"description\":\"Count conditional branches\"},\"output\":\"     372\\n\",\"metadata\":{\"output\":\"     372\\n\",\"exit\":0,\"description\":\"Count conditional branches\",\"truncated\":false},\"title\":\"Count conditional branches\",\"time\":{\"start\":1778741519741,\"end\":1778741519743}},\"id\":\"prt_e25419bf4001Drc0E4GwgJZI9g\",\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"messageID\":\"msg_e25418693001j08un4HKSeMeKI\"}}\nbench/kimi-k2_6/rep2/agent.log:770:{\"type\":\"tool_use\",\"timestamp\":1778741575212,\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"bash:22\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"python3 -c \\\"\\nimport subprocess, re\\n\\n# Disassemble\\noutput = subprocess.check_output(['riscv64-unknown-elf-objdump','-d','bench/programs/coremark.elf']).decode()\\nlines = output.splitlines()\\nbranches = []\\nfor i,line in enumerate(lines):\\n    m = re.match(r'\\\\s+([0-9a-f]+):\\\\s+([0-9a-f]+)\\\\s+(beq|bne|blt|bge|bltu|bgeu)', line)\\n    if m:\\n        addr = int(m.group(1),16)\\n        # find target\\n        target_match = re.search(r'<([^+>]+)\\\\+?0x([0-9a-f]+)?>', line)\\n        if target_match:\\n            # parse target from line like 'bne\\\\ta4,a5,5f8 <core_state_transition+0x...>'\\n            # extract hex after instruction\\n            hex_str = m.group(2)\\n            # imm is bits [31:25] and [11:7] of the instruction\\n            inst = int(hex_str,16)\\n            imm12 = (inst >> 31) & 1\\n            imm10_5 = (inst >> 25) & 0x3f\\n            imm4_1 = (inst >> 8) & 0xf\\n            imm11 = (inst >> 7) & 1\\n            imm = (imm12 << 12) | (imm11 << 11) | (imm10_5 << 5) | (imm4_1 << 1)\\n            if imm & 0x1000:\\n                imm |= 0xffffe000\\n            target = addr + imm\\n            branches.append((addr, target, inst, line.strip()))\\n\\nfwd = [b for b in branches if b[1] > b[0]]\\nbwd = [b for b in branches if b[1] < b[0]]\\nprint(f'Total branches: {len(branches)}')\\nprint(f'Forward: {len(fwd)}')\\nprint(f'Backward: {len(bwd)}')\\n# Count unique target addresses for backward branches (loop headers)\\nprint(f'Unique backward targets: {len(set(b[1] for b in bwd))}')\\n# Show some forward branches\\nfor b in fwd[:10]:\\n    print(b[3])\\n\\\"\",\"description\":\"Analyze branch directions in benchmark\"},\"output\":\"Total branches: 372\\nForward: 372\\nBackward: 0\\nUnique backward targets: 0\\n28:\\t00078663          \\tbeqz\\ta5,34 <calc_func+0x18>\\n68:\\t08068e63          \\tbeqz\\ta3,104 <calc_func+0xe8>\\n70:\\t08c69263          \\tbne\\ta3,a2,f4 <calc_func+0xd8>\\na0:\\t0a079463          \\tbnez\\ta5,148 <calc_func+0x12c>\\n108:\\t00c6e463          \\tbltu\\ta3,a2,110 <calc_func+0xf4>\\n140:\\t00079463          \\tbnez\\ta5,148 <calc_func+0x12c>\\n178:\\t0a079063          \\tbnez\\ta5,218 <cmp_complex+0xc8>\\n1a0:\\t1c068063          \\tbeqz\\ta3,360 <cmp_complex+0x210>\\n1a8:\\t14c69663          \\tbne\\ta3,a2,2f4 <cmp_complex+0x1a4>\\n1d8:\\t1c079663          \\tbnez\\ta5,3a4 <cmp_complex+0x254>\\n\",\"metadata\":{\"output\":\"Total branches: 372\\nForward: 372\\nBackward: 0\\nUnique backward targets: 0\\n28:\\t00078663          \\tbeqz\\ta5,34 <calc_func+0x18>\\n68:\\t08068e63          \\tbeqz\\ta3,104 <calc_func+0xe8>\\n70:\\t08c69263          \\tbne\\ta3,a2,f4 <calc_func+0xd8>\\na0:\\t0a079463          \\tbnez\\ta5,148 <calc_func+0x12c>\\n108:\\t00c6e463          \\tbltu\\ta3,a2,110 <calc_func+0xf4>\\n140:\\t00079463          \\tbnez\\ta5,148 <calc_func+0x12c>\\n178:\\t0a079063          \\tbnez\\ta5,218 <cmp_complex+0xc8>\\n1a0:\\t1c068063          \\tbeqz\\ta3,360 <cmp_complex+0x210>\\n1a8:\\t14c69663          \\tbne\\ta3,a2,2f4 <cmp_complex+0x1a4>\\n1d8:\\t1c079663          \\tbnez\\ta5,3a4 <cmp_complex+0x254>\\n\",\"exit\":0,\"description\":\"Analyze branch directions in benchmark\",\"truncated\":false},\"title\":\"Analyze branch directions in benchmark\",\"time\":{\"start\":1778741575209,\"end\":1778741575212}},\"id\":\"prt_e25423e05001fao7rHNYKPdPNn\",\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"messageID\":\"msg_e2541aaa3001N52lgUuxOawzIV\"}}\nbench/kimi-k2_6/rep2/agent.log:773:{\"type\":\"tool_use\",\"timestamp\":1778741606470,\"sessionID\":\"ses_1dac77996ffe0i2FM86AbKPGLm\",\"part\":{\"type\":\"tool\",\"tool\":\"bash\",\"callID\":\"bash:23\",\"state\":{\"status\":\"completed\",\"input\":{\"command\":\"python3 -c \\\"\\nimport subprocess, re\\n\\noutput = subprocess.check_output(['riscv64-unknown-elf-objdump','-d','bench/programs/coremark.elf']).decode()\\nlines = output.splitlines()\\nbranches = []\\nfor line in lines:\\n    m = re.match(r'\\\\s+([0-9a-f]+):\\\\s+([0-9a-f]+)\\\\s+(beq|bne|blt|bge|bltu|bgeu)', line)\\n    if m:\\n        addr = int(m.group(1),16)\\n        inst = int(m.group(2),16)\\n        imm12 = (inst >> 31) & 1\\n        imm10_5 = (inst >> 25) & 0x3f\\n        imm4_1 = (inst >> 8) & 0xf\\n        imm11 = (inst >> 7) & 1\\n        imm = (imm12 << 12) | (imm11 << 11) | (imm10_5 << 5) | (imm4_1 << 1)\\n        if imm & 0x1000:\\n            imm -= 0x2000\\n        target = addr + imm\\n        branches.append((addr, target, imm, line.strip()))\\n\\nfwd = [b for b in branches if b[1] > b[0]]\\nbwd = [b for b in branches if b[1] < b[0]]\\nself = [b for b in branches if b[1] == b[0]]\\nprint(f'Total: {len(branches)}, Fwd: {len(fwd)}, Bwd: {len(bwd)}, Self: {len(self)}')\\n# Show some backward branches\\nfor b in bwd[:20]:\\n    print(hex(b[0]), '->', hex(b[1]), b[3])\\n\\\"\",\"description\":\"Correctly classify branch directions\"},\"output\":\"Total: 372, Fwd: 246, Bwd: 126, Self: 0\\n0x490 -> 0x480 490:\\tffa618e3          \\tbne\\ta2,s10,480 <core_bench_list+0x6c>\\n0x4ac -> 0x49c 4ac:\\tfe0718e3          \\tbnez\\ta4,49c <core_bench_list+0x88>\\n0x528 -> 0x478 528:\\tf40d58e3          \\tbgez\\