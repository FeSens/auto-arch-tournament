{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"jq -c 'select(.category==\\\"predictor\\\") | {id,title,outcome,fitness,delta_pct,vs_baseline,fmax_mhz,ipc_coremark,lut4,ff,implementation_notes}' cores/bench/experiments/log.jsonl\"","aggregated_output":"{\"id\":\"hyp-20260710-003-r1s2\",\"title\":\"Early static backward-branch prediction\",\"outcome\":\"improvement\",\"fitness\":310.56,\"delta_pct\":9.81,\"vs_baseline\":9.81,\"fmax_mhz\":132.29,\"ipc_coremark\":0.000002,\"lut4\":10554,\"ff\":1897,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r2s2\",\"title\":\"Add a tiny dynamic branch history predictor\",\"outcome\":\"regression\",\"fitness\":281.94,\"delta_pct\":-9.22,\"vs_baseline\":-0.31,\"fmax_mhz\":118.96,\"ipc_coremark\":0.000002,\"lut4\":10302,\"ff\":1935,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r3s2\",\"title\":\"Add a compact return-address stack predictor\",\"outcome\":\"regression\",\"fitness\":266.64,\"delta_pct\":-14.14,\"vs_baseline\":-5.72,\"fmax_mhz\":113.21,\"ipc_coremark\":0.000002,\"lut4\":10460,\"ff\":2032,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r4s2\",\"title\":\"Add a tagged loop-exit predictor\",\"outcome\":\"regression\",\"fitness\":244.72,\"delta_pct\":-22.88,\"vs_baseline\":-13.47,\"fmax_mhz\":104.48,\"ipc_coremark\":0.000002,\"lut4\":13301,\"ff\":3141,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r5s2\",\"title\":\"Add a tiny exact-tag return target cache\",\"outcome\":\"regression\",\"fitness\":249.03,\"delta_pct\":-21.52,\"vs_baseline\":-11.95,\"fmax_mhz\":105.82,\"ipc_coremark\":0.000002,\"lut4\":10910,\"ff\":1997,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r6s2\",\"title\":\"Shadow-link return predictor\",\"outcome\":\"regression\",\"fitness\":375.45,\"delta_pct\":-5.28,\"vs_baseline\":32.75,\"fmax_mhz\":161.92,\"ipc_coremark\":0.000002,\"lut4\":10577,\"ff\":2144,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r7s2\",\"title\":\"Selective gshare forward-branch predictor\",\"outcome\":\"regression\",\"fitness\":403.25,\"delta_pct\":1.74,\"vs_baseline\":42.58,\"fmax_mhz\":174.67,\"ipc_coremark\":0.000002,\"lut4\":10400,\"ff\":2145,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r8s2\",\"title\":\"Narrow zero-offset return predictor\",\"outcome\":\"regression\",\"fitness\":391.01,\"delta_pct\":-18.69,\"vs_baseline\":38.25,\"fmax_mhz\":168.63,\"ipc_coremark\":0.000002,\"lut4\":10162,\"ff\":2105,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r9s2\",\"title\":\"Single-adder static branch predictor\",\"outcome\":\"regression\",\"fitness\":192.8,\"delta_pct\":-59.91,\"vs_baseline\":-31.83,\"fmax_mhz\":83.68,\"ipc_coremark\":0.000002,\"lut4\":10031,\"ff\":2082,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r10s2\",\"title\":\"Exact one-entry forward branch predictor\",\"outcome\":\"regression\",\"fitness\":295.29,\"delta_pct\":-38.6,\"vs_baseline\":4.41,\"fmax_mhz\":128.16,\"ipc_coremark\":0.000002,\"lut4\":10806,\"ff\":2117,\"implementation_notes\":\"\"}\n{\"id\":\"hyp-20260710-003-r11s2\",\"title\":\"Static operand-identity branch prediction\",\"outcome\":\"regression\",\"fitness\":327.48,\"delta_pct\":-31.9,\"vs_baseline\":15.79,\"fmax_mhz\":142.13,\"ipc_coremark\":0.000002,\"lut4\":10314,\"ff\":2082,\"implementation_notes\":\"\"}\n","exit_code":0,"status":"completed"}}
