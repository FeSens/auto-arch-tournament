                              'confidence': {'type': 'string',\\\\n                                                                      'enum': ['low',\\\\n                                                                               'medium',\\\\n                                                                               'high']}}},\\\\n                    'changes': {'type': 'array',\\\\n                                'minItems': 1,\\\\n                                'items': {'type': 'object',\\\\n                                          'required': ['file',\\\\n                                                       'description'],\\\\n                                          'properties': {'file': {'type': 'string',\\\\n                                                                  'description': 'Must '\\\\n                                                                                 'be '\\\\n                                                                                 'under '\\\\n                                                                                 'rtl/ '\\\\n                                                                                 '(any '\\\\n                                                                                 'extension) '\\\\n                                                                                 'or '\\\\n                                                                                 'be '\\\\n                                                                                 'a '\\\\n                                                                                 'test/test_*.py '\\\\n                                                                                 'cocotb '\\\\n                                                                                 'suite. '\\\\n                                                                                 'Anything '\\\\n                                