/wrapper_si.sv:42:        .io_dmemWEn         (dmem_wen),\nformal/wrapper_si.sv:43:        .io_dmemREn         (dmem_ren),\nformal/wrapper_si.sv:44:        .io_dmemReady       (1'b1),\nformal/wrapper_si.sv:49:        .io_rvfi_valid_0    (rvfi_valid),\nformal/wrapper_si.sv:50:        .io_rvfi_order_0    (rvfi_order),\nformal/wrapper.sv:2:// solver can pick any 32-bit instruction word each cycle, backs dmem with\nformal/wrapper.sv:7:// checker framework reads rvfi_valid/order/etc. straight from this\nformal/wrapper.sv:20:    // 8 KiB dmem (2048 words).\nformal/wrapper.sv:21:    reg [31:0] dmem [0:2047];\nformal/wrapper.sv:24:    wire [31:0] dmem_addr;\nformal/wrapper.sv:25:    wire [31:0] dmem_wdata;\nformal/wrapper.sv:26:    wire [3:0]  dmem_wen;\nformal/wrapper.sv:27:    wire        dmem_ren;\nformal/wrapper.sv:30:        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\nformal/wrapper.sv:31:        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\nformal/wrapper.sv:32:        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\nformal/wrapper.sv:33:        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\nformal/wrapper.sv:44:        // riscv-formal models a zero-wait imem/dmem (the symbolic stream\nformal/wrapper.sv:49:        .io_dmemAddr        (dmem_addr),\nformal/wrapper.sv:50:        .io_dmemWData       (dmem_wdata),\nformal/wrapper.sv:51:        .io_dmemRData       (dmem[dmem_addr[12:2]]),  // combinational read\nformal/wrapper.sv:52:        .io_dmemWEn         (dmem_wen),\nformal/wrapper.sv:53:        .io_dmemREn         (dmem_ren),\nformal/wrapper.sv:54:        .io_dmemReady       (1'b1),\nformal/wrapper.sv:56:        .io_rvfi_valid_0    (rvfi_valid    [0]),\nformal/wrapper.sv:57:        .io_rvfi_order_0    (rvfi_order    [63:0]),\nformal/wrapper.sv:79:        .io_rvfi_valid_1    (rvfi_valid    [1]),\nformal/wrapper.sv:80:        .io_rvfi_order_1    (rvfi_order    [127:64]),\ncores/bench