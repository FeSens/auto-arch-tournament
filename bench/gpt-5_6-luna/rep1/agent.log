{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"git show --stat --oneline 3113c3b && git show --format= --name-only 3113c3b && git show 3113c3b -- cores/bench/rtl/if_stage.sv | sed -n '1,220p'\"","aggregated_output":"3113c3b hyp-20260710-002-r2s1: Add a decoupled instruction prefetch queue (+14.3%)\n cores/bench/rtl/core.sv        |  35 ++++++----\n cores/bench/rtl/core_pkg.sv    |   2 +-\n cores/bench/rtl/hazard_unit.sv |  98 ++++++++++-----------------\n cores/bench/rtl/if_stage.sv    | 146 +++++++++++++++++++++++++++++++----------\n 4 files changed, 171 insertions(+), 110 deletions(-)\ncores/bench/rtl/core.sv\ncores/bench/rtl/core_pkg.sv\ncores/bench/rtl/hazard_unit.sv\ncores/bench/rtl/if_stage.sv\ncommit 3113c3b108c6e0172447a149d354d0a961852567\nAuthor: Felipe Sens Bonetto <felipesensbonetto@gmail.com>\nDate:   Fri Jul 10 12:12:40 2026 -0300\n\n    hyp-20260710-002-r2s1: Add a decoupled instruction prefetch queue (+14.3%)\n\ndiff --git a/cores/bench/rtl/if_stage.sv b/cores/bench/rtl/if_stage.sv\nindex 8db5c99..1bd7794 100644\n--- a/cores/bench/rtl/if_stage.sv\n+++ b/cores/bench/rtl/if_stage.sv\n@@ -1,57 +1,137 @@\n // rtl/if_stage.sv\n //\n-// Instruction fetch stage. Holds the PC register; the IF/ID payload\n-// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n-// flop in this microarchitecture, the next-stage's ID/EX register\n-// captures everything one cycle later.\n+// Two-entry decoupled instruction prefetch queue. The fetch PC advances\n+// whenever the instruction bus accepts a word, independently of whether the\n+// decode stage is currently able to consume the queue head. This lets\n+// instruction fetch make progress while the backend is stalled on a data\n+// access or a load-use interlock.\n //\n-// On flush or redirect, the instruction emitted to ID is forced to NOP\n-// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n-// observing a real rs1/rs2 from a wrong-path instruction and inserting\n-// a spurious load-use stall the cycle after a taken branch.\n+// The queue is kept compact (entries occupy slot 0, then slot 1), which makes\n+// the head/empty handshake unambiguous and permits a one-word-per-cycle\n+// drain/fill when the queue is full. A redirect is an atomic queue flush: the\n+// old path is discarded, fetch restarts at redirect_target, and a ready target\n+// access may be installed directly into slot 0 on that same clock edge.\n //\n-// Latency:        PC-reg update is synchronous; output is combinational.\n-// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n-//                 EX-stage redirect).\n+// Latency:        queue storage is synchronous; the head is combinational.\n+// RVFI fields:   feeds pc_rdata and instr through the ID/EX/MEM/WB path.\n module if_stage (\n   input  logic              clock,\n   input  logic              reset,\n-  input  logic              stall,            // hold PC (load-use)\n-  input  logic              flush,            // emit NOP into ID this cycle\n-  input  logic              redirect,         // EX has resolved a branch/jump\n+  input  logic              redirect,\n   input  logic [31:0]       redirect_target,\n+  input  logic              imem_ready,\n+  input  logic              consume,\n   output logic [31:0]       imem_addr,\n   input  logic [31:0]       imem_data,\n-  output if_id_t  out\n+  output if_id_t             out,\n+  output logic              queue_empty\n );\n \n   localparam logic [31:0] RESET_PC = 32'h0000_0000;\n+  localparam logic [31:0] NOP      = 32'h0000_0013;\n \n-  logic [31:0] pc;\n-  logic [31:0] next_pc;\n+  logic [31:0] fetch_pc_q;\n+  logic [31:0] entry_pc_q [0:1];\n+  logic [31:0] entry_insn_q [0:1];\n+  logic [1:0]  count_q;\n+\n+  logic pop;\n+  logic push;\n+\n+  // During redirect, selecting the target here makes a zero-wait bus able to\n+  // return the first target instruction without an extra dead fetch.\n+  assign imem_addr   = redirect ? redirect_target : fetch_pc_q;\n+  assign queue_empty = (count_q == 2'd0);\n \n   always_comb begin\n-    next_pc = redirect ? redirect_target : pc + 32'd4;\n+    out.pc    = queue_empty ? 32'b0 : entry_pc_q[0];\n+    out.instr = queue_empty ? NOP : entry_insn_q[0];\n+    out.valid = !queue_empty;\n   end\n \n-  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n-  // redirect on the same cycle as imem_stall or dmem_stall — without\n-  // this priority the redirect target would be silently dropped, the\n-  // PC would hold its old (wrong-path) value, and execution would\n-  // resume on the wrong path once the bus unstalls. Verified by the\n-  // VexRiscv-binary CoreMark sweep with --istall enabled.\n-  always_ff @(posedge clock) begin\n-    if      (reset)    pc <= RESET_PC;\n-    else if (redirect) pc <= redirect_target;\n-    else if (!stall)   pc <= next_pc;\n+  always_comb begin\n+    // A pop is only meaningful when the queue has a head. Redirect wins over\n+    // all normal queue traffic, so old-path data can never be retained.\n+    pop  = consume && !queue_empty && !redirect;\n+    push = imem_ready && (redirect || (count_q < 2'd2) || pop);\n   end\n \n-  assign imem_addr = pc;\n+  always_ff @(posedge clock) begin\n+    if (reset) begin\n+      fetch_pc_q      <= RESET_PC;\n+      count_q         <= 2'd0;\n+      entry_pc_q[0]   <= 32'b0;\n+      entry_pc_q[1]   <= 32'b0;\n+      entry_insn_q[0] <= NOP;\n+      entry_insn_q[1] <= NOP;\n+    end else if (redirect) begin\n+      // Flush both entries and restart the independent fetch pointer. The\n+      // target data is valid only when the redirected bus transaction was\n+      // accepted; otherwise the target remains the next request address.\n+      fetch_pc_q      <= redirect_target + (imem_ready ? 32'd4 : 32'd0);\n+      entry_pc_q[1]   <= 32'b0;\n+      entry_insn_q[1] <= NOP;\n+      if (imem_ready) begin\n+        count_q        <= 2'd1;\n+        entry_pc_q[0]   <= redirect_target;\n+        entry_insn_q[0] <= imem_data;\n+      end else begin\n+        count_q        <= 2'd0;\n+        entry_pc_q[0]   <= 32'b0;\n+        entry_insn_q[0] <= NOP;\n+      end\n+    end else begin\n+      if (push)\n+        fetch_pc_q <= fetch_pc_q + 32'd4;\n \n-  always_comb begin\n-    out.pc    = pc;\n-    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n-    out.valid = !(flush || redirect);\n+      case ({pop, push})\n+        2'b01: begin\n+          // Append the accepted word to the current compact queue.\n+          if (count_q == 2'd0) begin\n+            entry_pc_q[0]   <= fetch_pc_q;\n+            entry_insn_q[0] <= imem_data;\n+          end else begin\n+            entry_pc_q[1]   <= fetch_pc_q;\n+            entry_insn_q[1] <= imem_data;\n+          end\n+          count_q <= count_q + 2'd1;\n+        end\n+\n+        2'b10: begin\n+          // Drain without a replacement. If both entries were occupied,\n+          // promote the younger entry to the head.\n+          if (count_q == 2'd2) begin\n+            entry_pc_q[0]   <= entry_pc_q[1];\n+            entry_insn_q[0] <= entry_insn_q[1];\n+          end else begin\n+            entry_pc_q[0]   <= 32'b0;\n+            entry_insn_q[0] <= NOP;\n+          end\n+          entry_pc_q[1]   <= 32'b0;\n+          entry_insn_q[1] <= NOP;\n+          count_q <= count_q - 2'd1;\n+        end\n+\n+        2'b11: begin\n+          // Simultaneous drain/fill. A one-entry queue replaces its head;\n+          // a full queue shifts slot 1 down and fills slot 1.\n+          if (count_q == 2'd1) begin\n+            entry_pc_q[0]   <= fetch_pc_q;\n+            entry_insn_q[0] <= imem_data;\n+          end else begin\n+            entry_pc_q[0]   <= entry_pc_q[1];\n+            entry_insn_q[0] <= entry_insn_q[1];\n+            entry_pc_q[1]   <= fetch_pc_q;\n+            entry_insn_q[1] <= imem_data;\n+          end\n+          count_q <= count_q;\n+        end\n+\n+        default: begin\n+          count_q <= count_q;\n+        end\n+      endcase\n+    end\n   end\n \n endmodule\n","exit_code":0,"status":"completed"}}
