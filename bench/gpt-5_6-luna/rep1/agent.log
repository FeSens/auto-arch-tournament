.sv:202:    .dmem_ready     (io_dmemReady),\ncores/v1/rtl/core.sv:36:  output logic [31:0] io_dmemAddr,\ncores/v1/rtl/core.sv:39:  output logic [3:0]  io_dmemWEn,\ncores/v1/rtl/core.sv:40:  output logic        io_dmemREn,\ncores/v1/rtl/core.sv:45:  input  logic        io_dmemReady,\ncores/v1/rtl/core.sv:200:    .drain_ready   (io_dmemReady),\ncores/v1/rtl/core.sv:211:    .dmem_ready         (io_dmemReady),\ncores/v1/rtl/core.sv:229:      io_dmemAddr  = store_slot_drain_addr;\ncores/v1/rtl/core.sv:231:      io_dmemWEn   = store_slot_drain_wmask;\ncores/v1/rtl/core.sv:232:      io_dmemREn   = 1'b0;\ncores/v1/rtl/core.sv:234:      io_dmemAddr  = live_dmem_addr;\ncores/v1/rtl/core.sv:236:      io_dmemWEn   = live_dmem_wen;\ncores/v1/rtl/core.sv:237:      io_dmemREn   = live_dmem_ren;\ncores/v1/test/test_pipeline.py:94:    dut.io_dmemReady.value = 1\ncores/v1/test/test_pipeline.py:108:        da        = int(dut.io_dmemAddr.value)\ncores/v1/test/test_pipeline.py:109:        wen       = int(dut.io_dmemWEn.value)\ncores/baseline/test/test_pipeline.py:91:    dut.io_dmemReady.value = 1\ncores/baseline/test/test_pipeline.py:105:        da        = int(dut.io_dmemAddr.value)\ncores/baseline/test/test_pipeline.py:106:        wen       = int(dut.io_dmemWEn.value)\n","exit_code":0,"status":"completed"}}
