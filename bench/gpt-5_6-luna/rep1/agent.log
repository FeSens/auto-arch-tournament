d therefore continue through MEM/WB.\n+    dmem_stall = (ex_mem_load_valid && (store_buffer_valid || !dmem_ready))\n+              || (ex_mem_store_live_valid\n+                  && (store_buffer_valid || !dmem_ready))\n+              || (ex_mem_store_bufferable && !store_buffer_ready);\n \n     // An empty queue must not cause ID/EX to recapture its previous\n     // instruction. The empty case is handled as a front-end bubble below;\ndiff --git a/cores/bench/rtl/mem_stage.sv b/cores/bench/rtl/mem_stage.sv\nindex eb40d73..0bc6359 100644\n--- a/cores/bench/rtl/mem_stage.sv\n+++ b/cores/bench/rtl/mem_stage.sv\n@@ -39,10 +39,20 @@ module mem_stage (\n   input  logic [31:0]        dmem_rdata,\n   output logic [3:0]         dmem_wen,\n   output logic               dmem_ren,\n+  // Classification and payload for the decoupled normal-RAM store path.\n+  output logic               load_valid,\n+  output logic               store_bufferable,\n+  output logic               store_live_valid,\n+  output logic               store_enqueue_valid,\n+  output logic [31:0]        store_enqueue_addr,\n+  output logic [31:0]        store_enqueue_wdata,\n+  output logic [3:0]         store_enqueue_wmask,\n   // MEM/WB register output\n   output mem_wb_t  out\n );\n \n+  localparam logic [31:0] NORMAL_RAM_LIMIT = 32'h0010_0000;\n+\n   logic [31:0] wdata_rep;\n   logic [3:0]  byte_mask;\n   logic [31:0] aligned_addr;\n@@ -62,6 +72,7 @@ module mem_stage (\n   // On trap, the dmem ports are gated off and ctrl propagates is_illegal.\n   logic mem_misalign;\n   logic mem_op;\n+  logic mem_access;\n   ctrl_t ctrl_with_trap;\n \n   always_comb begin\n@@ -79,7 +90,7 @@ module mem_stage (\n       default: byte_mask = 4'b1111;\n     endcase\n \n-    mem_op       = in.ctrl.mem_read || in.ctrl.mem_write;\n+    mem_op       = in.valid && (in.ctrl.mem_read || in.ctrl.mem_write);\n     mem_misalign = mem_op && (\n                      (in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\n    