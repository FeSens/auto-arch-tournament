{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' cores/bench/rtl/if_stage.sv; sed -n '1,180p' cores/bench/rtl/core_pkg.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Two-entry decoupled instruction prefetch queue. The fetch PC advances\n// whenever the instruction bus accepts a word, independently of whether the\n// decode stage is currently able to consume the queue head. This lets\n// instruction fetch make progress while the backend is stalled on a data\n// access or a load-use interlock.\n//\n// The queue is kept compact (entries occupy slot 0, then slot 1), which makes\n// the head/empty handshake unambiguous and permits a one-word-per-cycle\n// drain/fill when the queue is full. A redirect is an atomic queue flush: the\n// old path is discarded, fetch restarts at redirect_target, and a ready target\n// access may be installed directly into slot 0 on that same clock edge.\n//\n// Latency:        queue storage is synchronous; the head is combinational.\n// RVFI fields:   feeds pc_rdata and instr through the ID/EX/MEM/WB path.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              redirect,\n  input  logic [31:0]       redirect_target,\n  input  logic              imem_ready,\n  input  logic              consume,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t             out,\n  output logic              queue_empty\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam logic [31:0] NOP      = 32'h0000_0013;\n\n  logic [31:0] fetch_pc_q;\n  logic [31:0] entry_pc_q [0:1];\n  logic [31:0] entry_insn_q [0:1];\n  logic [1:0]  count_q;\n\n  logic pop;\n  logic push;\n\n  // During redirect, selecting the target here makes a zero-wait bus able to\n  // return the first target instruction without an extra dead fetch.\n  assign imem_addr   = redirect ? redirect_target : fetch_pc_q;\n  assign queue_empty = (count_q == 2'd0);\n\n  always_comb begin\n    out.pc    = queue_empty ? 32'b0 : entry_pc_q[0];\n    out.instr = queue_empty ? NOP : entry_insn_q[0];\n    out.valid = !queue_empty;\n  end\n\n  always_comb begin\n    // A pop is only meaningful when the queue has a head. Redirect wins over\n    // all normal queue traffic, so old-path data can never be retained.\n    pop  = consume && !queue_empty && !redirect;\n    push = imem_ready && (redirect || (count_q < 2'd2) || pop);\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      fetch_pc_q      <= RESET_PC;\n      count_q         <= 2'd0;\n      entry_pc_q[0]   <= 32'b0;\n      entry_pc_q[1]   <= 32'b0;\n      entry_insn_q[0] <= NOP;\n      entry_insn_q[1] <= NOP;\n    end else if (redirect) begin\n      // Flush both entries and restart the independent fetch pointer. The\n      // target data is valid only when the redirected bus transaction was\n      // accepted; otherwise the target remains the next request address.\n      fetch_pc_q      <= redirect_target + (imem_ready ? 32'd4 : 32'd0);\n      entry_pc_q[1]   <= 32'b0;\n      entry_insn_q[1] <= NOP;\n      if (imem_ready) begin\n        count_q        <= 2'd1;\n        entry_pc_q[0]   <= redirect_target;\n        entry_insn_q[0] <= imem_data;\n      end else begin\n        count_q        <= 2'd0;\n        entry_pc_q[0]   <= 32'b0;\n        entry_insn_q[0] <= NOP;\n      end\n    end else begin\n      if (push)\n        fetch_pc_q <= fetch_pc_q + 32'd4;\n\n      case ({pop, push})\n        2'b01: begin\n          // Append the accepted word to the current compact queue.\n          if (count_q == 2'd0) begin\n            entry_pc_q[0]   <= fetch_pc_q;\n            entry_insn_q[0] <= imem_data;\n          end else begin\n            entry_pc_q[1]   <= fetch_pc_q;\n            entry_insn_q[1] <= imem_data;\n          end\n          count_q <= count_q + 2'd1;\n        end\n\n        2'b10: begin\n          // Drain without a replacement. If both entries were occupied,\n          // promote the younger entry to the head.\n          if (count_q == 2'd2) begin\n            entry_pc_q[0]   <= entry_pc_q[1];\n            entry_insn_q[0] <= entry_insn_q[1];\n          end else begin\n            entry_pc_q[0]   <= 32'b0;\n            entry_insn_q[0] <= NOP;\n          end\n          entry_pc_q[1]   <= 32'b0;\n          entry_insn_q[1] <= NOP;\n          count_q <= count_q - 2'd1;\n        end\n\n        2'b11: begin\n          // Simultaneous drain/fill. A one-entry queue replaces its head;\n          // a full queue shifts slot 1 down and fills slot 1.\n          if (count_q == 2'd1) begin\n            entry_pc_q[0]   <= fetch_pc_q;\n            entry_insn_q[0] <= imem_data;\n          end else begin\n            entry_pc_q[0]   <= entry_pc_q[1];\n            entry_insn_q[0] <= entry_insn_q[1];\n            entry_pc_q[1]   <= fetch_pc_q;\n            entry_insn_q[1] <= imem_data;\n          end\n          count_q <= count_q;\n        end\n\n        default: begin\n          count_q <= count_q;\n        end\n      endcase\n    end\n  end\n\nendmodule\n// rtl/core_pkg.sv\n//\n// Core-wide constants and pipeline-bundle types.\n//\n// Compilation-unit scope (no `package … endpackage` wrapper) because\n// Yosys's Verilog frontend rejects `import pkg::*;` even though it\n// accepts `pkg::sym` refs and package definitions. A file-scope\n// definition with an `\\`ifndef` guard is the lowest common denominator\n// across Verilator, Yosys, sby, and nextpnr-himbaechel.\n//\n// Order matters: this file MUST be the first source passed to any tool\n// (Verilator/cocotb runner / build.sh / formal staging). Subsequent\n// includes hit the guard and become no-ops.\n//\n// Latency:        n/a (declarations only).\n// RVFI fields:    none (defines types; no logic).\n`ifndef CORE_PKG_DEFINED\n`define CORE_PKG_DEFINED\n\n  // ── ALU operations ──────────────────────────────────────────────────────\n  localparam logic [4:0] ALU_ADD    = 5'd0;\n  localparam logic [4:0] ALU_SUB    = 5'd1;\n  localparam logic [4:0] ALU_AND    = 5'd2;\n  localparam logic [4:0] ALU_OR     = 5'd3;\n  localparam logic [4:0] ALU_XOR    = 5'd4;\n  localparam logic [4:0] ALU_SLT    = 5'd5;\n  localparam logic [4:0] ALU_SLTU   = 5'd6;\n  localparam logic [4:0] ALU_SLL    = 5'd7;\n  localparam logic [4:0] ALU_SRL    = 5'd8;\n  localparam logic [4:0] ALU_SRA    = 5'd9;\n  localparam logic [4:0] ALU_LUI    = 5'd10;\n  localparam logic [4:0] ALU_MUL    = 5'd11;\n  localparam logic [4:0] ALU_MULH   = 5'd12;\n  localparam logic [4:0] ALU_MULHU  = 5'd13;\n  localparam logic [4:0] ALU_MULHSU = 5'd14;\n  localparam logic [4:0] ALU_DIV    = 5'd15;\n  localparam logic [4:0] ALU_DIVU   = 5'd16;\n  localparam logic [4:0] ALU_REM    = 5'd17;\n  localparam logic [4:0] ALU_REMU   = 5'd18;\n\n  // ── Branch operations (encoded = funct3 of BRANCH opcode) ───────────────\n  // Phase 1 only references BR_BEQ (decoder default). The rest are\n  // referenced by the EX-stage comparator in phase 2; we keep them here\n  // for documentation and silence UNUSEDPARAM until then.\n  localparam logic [2:0] BR_BEQ  = 3'd0;\n  /* verilator lint_off UNUSEDPARAM */\n  localparam logic [2:0] BR_BNE  = 3'd1;\n  localparam logic [2:0] BR_BLT  = 3'd4;\n  localparam logic [2:0] BR_BGE  = 3'd5;\n  localparam logic [2:0] BR_BLTU = 3'd6;\n  localparam logic [2:0] BR_BGEU = 3'd7;\n  /* verilator lint_on UNUSEDPARAM */\n\n  // ── Pipeline-bundle typedefs ────────────────────────────────────────────\n  typedef struct packed {\n    logic [4:0] alu_op;\n    logic       alu_src;     // 0 = rs2 value, 1 = immediate\n    logic [2:0] branch_op;\n    logic       is_branch;\n    logic       is_jump;\n    logic       is_jalr;\n    logic       is_lui;\n    logic       is_auipc;\n    logic       mem_read;\n    logic       mem_write;\n    logic [1:0] mem_width;   // 0 = byte, 1 = half, 2 = word\n    logic       mem_sext;    // sign-extend load result\n    logic       reg_write;\n    logic       mem_to_reg;  // 1 = write loaded data, 0 = write ALU result\n    logic       is_illegal;  // default-true in decoder; cleared inside\n                              // validated opcode/funct arms only.\n  } ctrl_t;\n\n  // IF queue head -> ID combinational bundle (queue storage sits in if_stage).\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic        valid;\n  } if_id_t;\n\n  // ID/EX register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] imm;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } id_ex_t;\n\n  // EX/MEM register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] write_data;     // raw rs2 (post-forward), pre byte replication\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;        // post-forward rs1 used by EX\n    logic [31:0] rs2_val;        // post-forward rs2 used by EX\n    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    logic        branch_taken;\n    logic [31:0] branch_target;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n","exit_code":0,"status":"completed"}}
