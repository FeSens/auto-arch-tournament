{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' fpga/scripts/synth.tcl && rg -n 'core\\\\.sv|rtl/\\\\*\\\\.sv|glob.*sv' fpga tools test/cosim -g '*.tcl' -g '*.py' -g '*.sh' -g '*.sv' | head -100\"","aggregated_output":"# Yosys synthesis script: build the Fmax-benchmark wrapper.\n#\n# $rtl_dir/*.sv is globbed dynamically (core_pkg.sv first for compilation-\n# unit-scope typedefs). Hypotheses are allowed to add/rename/delete\n# files inside $rtl_dir/, so a hardcoded list would silently break\n# restructuring hypotheses (the orchestrator would log them as\n# build_failed regardless of merit).\nyosys -import\n\nif {![info exists ::env(RTL_DIR)]} {\n    error \"synth.tcl requires the RTL_DIR env var (e.g. RTL_DIR=cores/v1/rtl).\"\n}\nset rtl_dir $::env(RTL_DIR)\n\nif {![info exists ::env(GEN_DIR)]} {\n    error \"synth.tcl requires the GEN_DIR env var (e.g. GEN_DIR=cores/v1/generated).\"\n}\nset gen_dir $::env(GEN_DIR)\n\n# Ordering: read core_pkg.sv first so its typedefs/localparams are\n# visible to subsequent files.\nread_verilog -sv \"$rtl_dir/core_pkg.sv\"\n\n# Then everything else under $rtl_dir/. glob -nocomplain handles the empty\n# case; we filter core_pkg.sv out to avoid double-include.\nforeach f [lsort [glob -nocomplain \"$rtl_dir/*.sv\"]] {\n    if {[file tail $f] == \"core_pkg.sv\"} { continue }\n    read_verilog -sv \"$f\"\n}\n\n# BENCH selects which fpga/core_bench*.sv to read. Defaults to\n# fpga/core_bench.sv (NRET=2 dual-channel). tools/eval/fpga.py overrides\n# to fpga/core_bench_si.sv when cores/<target>/core.yaml declares nret: 1.\n# Both files define a module named core_bench; only one is read per run.\nif {[info exists ::env(BENCH)]} {\n    set bench_sv $::env(BENCH)\n} else {\n    set bench_sv \"fpga/core_bench.sv\"\n}\nread_verilog -sv $bench_sv\n\nsynth_gowin -top core_bench -json $gen_dir/synth.json\n\nstat\nfpga/scripts/synth.tcl:3:# $rtl_dir/*.sv is globbed dynamically (core_pkg.sv first for compilation-\nfpga/scripts/synth.tcl:26:foreach f [lsort [glob -nocomplain \"$rtl_dir/*.sv\"]] {\ntest/cosim/build.sh:5:# RTL_DIR (default: rtl/) is globbed dynamically (with core_pkg.sv forced\ntest/cosim/build.sh:46:  echo \"ERROR: no rtl/*.sv files found.\" >&2\ntools/tournament.py:135:#   stages rtl/*.sv into formal/riscv-formal/cores/auto-arch-researcher/,\nfpga/core_bench.sv:21:// = file name\" rule. The synth.tcl script reads rtl/*.sv first so this\ntools/eval/test_rvfi_lint.py:12:    _write(tmp_path, \"core.sv\", \"module core;\\n  assign io_rvfi_valid_0 = '0;\\nendmodule\\n\")\ntools/eval/test_rvfi_lint.py:16:    assert \"core.sv:2\" in out['detail']\ntools/eval/test_rvfi_lint.py:20:    _write(tmp_path, \"core.sv\", \"module core;\\nassign io_rvfi_valid_0 = 1'b0;\\nendmodule\\n\")\ntools/eval/test_rvfi_lint.py:23:    assert \"core.sv:2\" in out['detail']\ntools/eval/test_rvfi_lint.py:27:    _write(tmp_path, \"core.sv\", \"assign io_rvfi_valid_0 = 0;\\n\")\ntools/eval/test_rvfi_lint.py:34:    _write(tmp_path, \"core.sv\", \"assign io_rvfi_valid_1 = '0;\\n\")\ntools/eval/test_rvfi_lint.py:40:    _write(tmp_path, \"core.sv\",\ntools/eval/test_rvfi_lint.py:47:    _write(tmp_path, \"core.sv\",\ntools/eval/test_rvfi_lint.py:88:    _write(tmp_path, \"core.sv\",\ntools/eval/test_rvfi_lint.py:98:    _write(tmp_path, \"core.sv\",\ntools/eval/test_rvfi_lint.py:106:    _write(tmp_path, \"core.sv\",\ntools/agents/implement.py:19:    src_files = sorted(rtl_dir.rglob(\"*.sv\"))\ntools/agents/implement.py:200:    rtl_sources = sorted(rtl_dir.glob(\"*.sv\"))\ntools/eval/formal.py:4:genchecks.py against our rtl/*.sv + wrapper.sv + checks.cfg) and runs the\ntools/test_orchestrator_fork.py:33:    (bl_rtl / \"core.sv\").write_text(\"module core(); endmodule\\n\")\ntools/test_orchestrator_fork.py:58:    assert (foo / \"rtl\" / \"core.sv\").exists()\ntools/agents/hypothesis.py:181:    src_files = sorted(rtl_dir.rglob(\"*.sv\"))\ntools/eval/rvfi_lint.py:44:    sv_files = sorted(rtl_dir.glob(\"*.sv\"))\ntools/orchestrator.py:487:    # shell glob happens to place core.sv before core_pkg.sv.\ntools/orchestrator.py:490:    rtl_sources = sorted(rtl_path.glob(\"*.sv\"))\n","exit_code":0,"status":"completed"}}
