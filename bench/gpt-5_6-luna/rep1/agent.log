/rtl/core.sv:369:    issue_entry.bus_addr           = alu_result;\ncores/bench/rtl/core.sv:412:    response_shifted = io_dmemRData >> (mem_req.bus_addr[1:0] * 8);\ncores/bench/rtl/core.sv:434:    if (mem_resp_c0) begin\ncores/bench/rtl/core.sv:440:    if (mem_resp_c1) begin\n","exit_code":0,"status":"completed"}}
