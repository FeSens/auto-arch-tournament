 //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\ncores/v1/rtl/hazard_unit.sv:61:    // mem_wait takes precedence over load_use's bubble: re-evaluate\ncores/v1/rtl/hazard_unit.sv:62:    // load_use next cycle when the bus unblocks. flush_id is 1 only when\ncores/v1/rtl/hazard_unit.sv:64:    stall_id      = mem_wait || load_use_hazard || ex_long_busy;\ncores/v1/rtl/hazard_unit.sv:65:    flush_id      = (load_use_hazard || redirect) && !mem_wait;\ncores/v1/rtl/hazard_unit.sv:68:    stall_ex_mem  = mem_wait;\ncores/baseline/rtl/ex_stage.sv:18:  input  logic               stall,         // freeze EX/MEM register (dmem stall)\ncores/baseline/rtl/ex_stage.sv:121:    end else if (stall) begin\ncores/baseline/rtl/ex_stage.sv:122:      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\ncores/v1/rtl/store_slot.sv:5:// The instruction retires through MEM/WB on the enqueue cycle; this slot\ncores/v1/rtl/store_slot.sv:11:  input  logic        enqueue,\ncores/v1/rtl/store_slot.sv:12:  input  logic [31:0] enqueue_addr,\ncores/v1/rtl/store_slot.sv:13:  input  logic [31:0] enqueue_wdata,\ncores/v1/rtl/store_slot.sv:14:  input  logic [3:0]  enqueue_wmask,\ncores/v1/rtl/store_slot.sv:38:      if (drain_fire && !enqueue) begin\ncores/v1/rtl/store_slot.sv:40:      end else if (enqueue) begin\ncores/v1/rtl/store_slot.sv:42:        addr_q  <= enqueue_addr;\ncores/v1/rtl/store_slot.sv:43:        wdata_q <= enqueue_wdata;\ncores/v1/rtl/store_slot.sv:44:        wmask_q <= enqueue_wmask;\ncores/v1/rtl/ex_stage.sv:19:  input  logic               stall,         // freeze EX/MEM register (dmem stall)\ncores/v1/rtl/ex_stage.sv:88:    div_start   = div_request && !stall;\ncores/v1/rtl/ex_stage.sv:201:      end else if (div_complete && !stall) begin\ncores/v1/rtl/ex_stage.sv:214:    end else if (stall) begin\ncores/v1/rtl/ex_stage.sv:215:      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n","exit_code":0,"status":"completed"}}
