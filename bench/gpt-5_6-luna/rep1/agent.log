{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' fpga/core_bench_si.sv 2>/dev/null; rg -n \\\"RAM|dmem|imem|core\\\" fpga/core_bench_si.sv fpga/core_bench.sv cores/bench -g '*.sv' -g '*.tcl' | head -n 180\"","aggregated_output":"// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the full rationale on LFSR-driven imem, dmem\n// model, and the XOR-reduce LED that keeps RVFI fan-out alive through\n// dead-output elimination.\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI fan-out (NRET=1 contract).\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  core cpu (\n    .clock            (clock),\n    .reset            (reset),\n    .io_imemAddr      (imem_addr),\n    .io_imemData      (lfsr),\n    .io_imemReady     (1'b1),\n    .io_dmemAddr      (dmem_addr),\n    .io_dmemWData     (dmem_wdata),\n    .io_dmemRData     (dmem_rdata),\n    .io_dmemWEn       (dmem_wen),\n    .io_dmemREn       (dmem_ren),\n    .io_dmemReady     (1'b1),\n    .io_rvfi_valid_0    (rvfi_valid_0),\n    .io_rvfi_order_0    (rvfi_order_0),\n    .io_rvfi_insn_0     (rvfi_insn_0),\n    .io_rvfi_trap_0     (rvfi_trap_0),\n    .io_rvfi_halt_0     (rvfi_halt_0),\n    .io_rvfi_intr_0     (rvfi_intr_0),\n    .io_rvfi_mode_0     (rvfi_mode_0),\n    .io_rvfi_ixl_0      (rvfi_ixl_0),\n    .io_rvfi_rs1_addr_0 (rvfi_rs1_addr_0),\n    .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata_0),\n    .io_rvfi_rs2_addr_0 (rvfi_rs2_addr_0),\n    .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata_0),\n    .io_rvfi_rd_addr_0  (rvfi_rd_addr_0),\n    .io_rvfi_rd_wdata_0 (rvfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // XOR-reduce all CPU outputs to a single LED bit. Without this,\n  // dead-output elimination would prune the RVFI fan-out.\n  assign led = ^{rvfi_valid_0, rvfi_order_0, rvfi_insn_0, rvfi_trap_0, rvfi_halt_0, rvfi_intr_0,\n                 rvfi_mode_0, rvfi_ixl_0, rvfi_rs1_addr_0, rvfi_rs1_rdata_0,\n                 rvfi_rs2_addr_0, rvfi_rs2_rdata_0, rvfi_rd_addr_0, rvfi_rd_wdata_0,\n                 rvfi_pc_rdata_0, rvfi_pc_wdata_0, rvfi_mem_addr_0,\n                 rvfi_mem_rmask_0, rvfi_mem_wmask_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0,\n                 imem_addr, dmem_rdata};\n\nendmodule\nfpga/core_bench.sv:1:// fpga/core_bench.sv\nfpga/core_bench.sv:3:// FPGA synthesis wrapper for Fmax benchmarking. Drives `core` directly\nfpga/core_bench.sv:7://      with zero-initialized BRAM imem/dmem lets Yosys constant-fold the\nfpga/core_bench.sv:11://   2. Driving io_imemData from a 32-bit LFSR forces non-constant fetch\nfpga/core_bench.sv:15:// dmem mirrors the deployable SoC (8 KiB, byte-lane writeable) so the\nfpga/core_bench.sv:16:// dmem read mux's LUT/BRAM map matches what the eventual deployment will\nfpga/core_bench.sv:20:// Module is `core_bench` (lowercase) to match the project's \"module name\nfpga/core_bench.sv:22:// file's `core` instantiation resolves correctly.\nfpga/core_bench.sv:23:module core_bench (\nfpga/core_bench.sv:30:  // non-zero seed so io_imemData looks random to the synthesizer.\nfpga/core_bench.sv:36:  // 8 KiB dmem (2K words, byte-lane writeable). Keeps the dmem read path\nfpga/core_bench.sv:37:  // representative of the real SoC's BRAM-mapped memory.\nfpga/core_bench.sv:38:  logic [31:0] dmem [0:2047];\nfpga/core_bench.sv:39:  logic [31:0] dmem_rdata;\nfpga/core_bench.sv:40:  logic [31:0] dmem_addr;\nfpga/core_bench.sv:41:  logic [31:0] dmem_wdata;\nfpga/core_bench.sv:42:  logic [3:0]  dmem_wen;\nfpga/core_bench.sv:43:  logic        dmem_ren;\nfpga/core_bench.sv:46:    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\nfpga/core_bench.sv:47:    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\nfpga/core_bench.sv:48:    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\nfpga/core_bench.sv:49:    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\nfpga/core_bench.sv:51:  // Combinational read — matches core's expected io_dmemRData semantics.\nfpga/core_bench.sv:52:  assign dmem_rdata = dmem[dmem_addr[12:2]];\nfpga/core_bench.sv:54:  logic [31:0] imem_addr;\nfpga/core_bench.sv:56:  // from core, but the parallel decl + XOR include keeps the harness\nfpga/core_bench.sv:75:  core cpu (\nfpga/core_bench.sv:78:    .io_imemAddr      (imem_addr),\nfpga/core_bench.sv:79:    .io_imemData      (lfsr),                  // LFSR drives instr fetch\nfpga/core_bench.sv:80:    // FPGA target uses 1-cycle BRAM, modelled here as zero-wait. The\nfpga/core_bench.sv:83:    .io_imemReady     (1'b1),\nfpga/core_bench.sv:84:    .io_dmemAddr      (dmem_addr),\nfpga/core_bench.sv:85:    .io_dmemWData     (dmem_wdata),\nfpga/core_bench.sv:86:    .io_dmemRData     (dmem_rdata),\nfpga/core_bench.sv:87:    .io_dmemWEn       (dmem_wen),\nfpga/core_bench.sv:88:    .io_dmemREn       (dmem_ren),\nfpga/core_bench.sv:89:    .io_dmemReady     (1'b1),\nfpga/core_bench.sv:148:                 imem_addr, dmem_rdata};\nfpga/core_bench_si.sv:1:// fpga/core_bench_si.sv\nfpga/core_bench_si.sv:3:// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\nfpga/core_bench_si.sv:4:// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\nfpga/core_bench_si.sv:6:// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\nfpga/core_bench_si.sv:8:// See core_bench.sv for the full rationale on LFSR-driven imem, dmem\nfpga/core_bench_si.sv:11:module core_bench (\nfpga/core_bench_si.sv:22:  logic [31:0] dmem [0:2047];\nfpga/core_bench_si.sv:23:  logic [31:0] dmem_rdata;\nfpga/core_bench_si.sv:24:  logic [31:0] dmem_addr;\nfpga/core_bench_si.sv:25:  logic [31:0] dmem_wdata;\nfpga/core_bench_si.sv:26:  logic [3:0]  dmem_wen;\nfpga/core_bench_si.sv:27:  logic        dmem_ren;\nfpga/core_bench_si.sv:30:    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\nfpga/core_bench_si.sv:31:    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\nfpga/core_bench_si.sv:32:    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\nfpga/core_bench_si.sv:33:    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\nfpga/core_bench_si.sv:35:  assign dmem_rdata = dmem[dmem_addr[12:2]];\nfpga/core_bench_si.sv:37:  logic [31:0] imem_addr;\nfpga/core_bench_si.sv:49:  core cpu (\nfpga/core_bench_si.sv:52:    .io_imemAddr      (imem_addr),\nfpga/core_bench_si.sv:53:    .io_imemData      (lfsr),\nfpga/core_bench_si.sv:54:    .io_imemReady     (1'b1),\nfpga/core_bench_si.sv:55:    .io_dmemAddr      (dmem_addr),\nfpga/core_bench_si.sv:56:    .io_dmemWData     (dmem_wdata),\nfpga/core_bench_si.sv:57:    .io_dmemRData     (dmem_rdata),\nfpga/core_bench_si.sv:58:    .io_dmemWEn       (dmem_wen),\nfpga/core_bench_si.sv:59:    .io_dmemREn       (dmem_ren),\nfpga/core_bench_si.sv:60:    .io_dmemReady     (1'b1),\nfpga/core_bench_si.sv:91:                 imem_addr, dmem_rdata};\ncores/bench/rtl/mem_stage.sv:3:// Memory access stage. Drives the dmem read/write ports combinationally\ncores/bench/rtl/mem_stage.sv:21:  // hold_wb: dmem stall is in effect. MEM/WB's data fields are RETAINED\ncores/bench/rtl/mem_stage.sv:36:  // dmem interface\ncores/bench/rtl/mem_stage.sv:37:  output logic [31:0]        dmem_addr,\ncores/bench/rtl/mem_stage.sv:38:  output logic [31:0]        dmem_wdata,\ncores/bench/rtl/mem_stage.sv:39:  input  logic [31:0]        dmem_rdata,\ncores/bench/rtl/mem_stage.sv:40:  output logic [3:0]         dmem_wen,\ncores/bench/rtl/mem_stage.sv:41:  output logic               dmem_ren,\ncores/bench/rtl/mem_stage.sv:62:  // On trap, the dmem ports are gated off and ctrl propagates is_illegal.\ncores/bench/rtl/mem_stage.sv:95:    // Combinational dmem outputs — gated off on misalign.\ncores/bench/rtl/mem_stage.sv:96:    dmem_addr  = in.alu_result;\ncores/bench/rtl/mem_stage.sv:97:    dmem_wdata = wdata_rep;\ncores/bench/rtl/mem_stage.sv:98:    dmem_wen   = (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\ncores/bench/rtl/mem_stage.sv:99:    dmem_ren   = in.ctrl.mem_read  && !mem_misalign;\ncores/bench/rtl/mem_stage.sv:102:    shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\ncores/bench/rtl/mem_stage.sv:112:      default: load_data = dmem_rdata;\ncores/bench/rtl/mem_stage.sv:131:      // alive for as many cycles as the dmem stall lasts.\ncores/bench/rtl/mem_stage.sv:144:      reg_q.mem_rdata  <= dmem_rdata;\ncores/bench/rtl/reg_file.sv:8://     the new value. This matches the prior Chisel core's RegFile.scala\ncores/bench/rtl/reg_file.sv:13:// fine here; explicit BRAM attribution lives on the larger imem/dmem\ncores/bench/rtl/core_pkg.sv:1:// rtl/core_pkg.sv\ncores/bench/rtl/core_pkg.sv:44:  // for documentation and silence UNUSEDPARAM until then.\ncores/bench/rtl/core_pkg.sv:46:  /* verilator lint_off UNUSEDPARAM */\ncores/bench/rtl/core_pkg.sv:52:  /* verilator lint_on UNUSEDPARAM */\ncores/bench/rtl/core.sv:1:// rtl/core.sv\ncores/bench/rtl/core.sv:3:// Top-level wiring for the 5-stage in-order RV32IM core.\ncores/bench/rtl/core.sv:13:// CLAUDE.md invariant 1 under `nret: 1` (declared in core.yaml). The\ncores/bench/rtl/core.sv:15:// synth to fpga/core_bench_si.sv for this core. There is no channel 1.\ncores/bench/rtl/core.sv:22:`include \"core_pkg.sv\"\ncores/bench/rtl/core.sv:24:module core (\ncores/bench/rtl/core.sv:27:  // imem\ncores/bench/rtl/core.sv:28:  output logic [31:0] io_imemAddr,\ncores/bench/rtl/core.sv:29:  input  logic [31:0] io_imemData,\ncores/bench/rtl/core.sv:30:  // imem bus backpressure. Drive 1 for zero-wait single-cycle BRAM (the\ncores/bench/rtl/core.sv:37:  input  logic        io_imemReady,\ncores/bench/rtl/core.sv:38:  // dmem\ncores/bench/rtl/core.sv:39:  output logic [31:0] io_dmemAddr,\ncores/bench/rtl/core.sv:40:  input  logic [31:0] io_dmemRData,\ncores/bench/rtl/core.sv:41:  output logic [31:0] io_dmemWData,\ncores/bench/rtl/core.sv:42:  output logic [3:0]  io_dmemWEn,\ncores/bench/rtl/core.sv:43:  output logic        io_dmemREn,\ncores/bench/rtl/core.sv:44:  // dmem bus backpressure. Drive 1 for zero-wait. Drive 0 to model\ncores/bench/rtl/core.sv:48:  input  logic        io_dmemReady,\ncores/bench/rtl/core.sv:50:  // declared via `nret: 1` in core.yaml). Channel 0 is the sole\ncores/bench/rtl/core.sv:107:    .imem_ready      (io_imemReady),\ncores/bench/rtl/core.sv:109:    .imem_addr       (io_imemAddr),\ncores/bench/rtl/core.sv:110:    .imem_data       (io_imemData),\ncores/bench/rtl/core.sv:167:    .dmem_addr  (io_dmemAddr),\ncores/bench/rtl/core.sv:168:    .dmem_wdata (io_dmemWData),\ncores/bench/rtl/core.sv:169:    .dmem_rdata (io_dmemRData),\ncores/bench/rtl/core.sv:170:    .dmem_wen   (io_dmemWEn),\ncores/bench/rtl/core.sv:171:    .dmem_ren   (io_dmemREn),\ncores/bench/rtl/core.sv:192:    .dmem_ready     (io_dmemReady),\ncores/bench/rtl/if_stage.sv:22:  input  logic              imem_ready,\ncores/bench/rtl/if_stage.sv:24:  output logic [31:0]       imem_addr,\ncores/bench/rtl/if_stage.sv:25:  input  logic [31:0]       imem_data,\ncores/bench/rtl/if_stage.sv:43:  assign imem_addr   = redirect ? redirect_target : fetch_pc_q;\ncores/bench/rtl/if_stage.sv:56:    push = imem_ready && (redirect || (count_q < 2'd2) || pop);\ncores/bench/rtl/if_stage.sv:71:      fetch_pc_q      <= redirect_target + (imem_ready ? 32'd4 : 32'd0);\ncores/bench/rtl/if_stage.sv:74:      if (imem_ready) begin\ncores/bench/rtl/if_stage.sv:77:        entry_insn_q[0] <= imem_data;\ncores/bench/rtl/if_stage.sv:92:            entry_insn_q[0] <= imem_data;\ncores/bench/rtl/if_stage.sv:95:            entry_insn_q[1] <= imem_data;\ncores/bench/rtl/if_stage.sv:120:            entry_insn_q[0] <= imem_data;\ncores/bench/rtl/if_stage.sv:125:            entry_insn_q[1] <= imem_data;\ncores/bench/rtl/hazard_unit.sv:3:// Front-end and pipeline interlocks for the in-order five-stage core. The\ncores/bench/rtl/hazard_unit.sv:18:  input  logic       dmem_ready,\ncores/bench/rtl/hazard_unit.sv:27:  logic dmem_stall;\ncores/bench/rtl/hazard_unit.sv:34:    // dmem_ready is relevant only for an actual memory operation in EX/MEM.\ncores/bench/rtl/hazard_unit.sv:37:    dmem_stall = !dmem_ready && ex_mem_mem_op;\ncores/bench/rtl/hazard_unit.sv:42:    stall_id = dmem_stall || load_use_hazard;\ncores/bench/rtl/hazard_unit.sv:45:    // payload. A dmem stall has priority over either bubble operation so the\ncores/bench/rtl/hazard_unit.sv:47:    flush_id = (queue_empty || load_use_hazard || redirect) && !dmem_stall;\ncores/bench/rtl/hazard_unit.sv:49:    stall_ex_mem = dmem_stall;\ncores/bench/rtl/hazard_unit.sv:53:    hold_mem_wb = dmem_stall;\ncores/bench/rtl/ex_stage.sv:18:  input  logic               stall,         // freeze EX/MEM register (dmem stall)\ncores/bench/rtl/ex_stage.sv:122:      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n","exit_code":0,"status":"completed"}}
