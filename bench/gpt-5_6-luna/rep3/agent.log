+    .load_pending_mask (queue_load_pending)\\\\n   );\\\\n \\\\n+  // The ex_mem entry is sampled by MEM at the next edge, so include an\\\\n+  // unsampled load in the dependency scoreboard for this cycle.\\\\n+  always_comb begin\\\\n+    mem_in_valid = ex_mem_w.valid;\\\\n+    load_pending = queue_load_pending;\\\\n+    if (ex_mem_w.valid && ex_mem_w.ctrl.mem_read && (ex_mem_w.rd != 5\\\\'b0))\\\\n+      load_pending[ex_mem_w.rd] = 1\\\\'b1;\\\\n+\\\\n+    id_ex_load_dependency =\\\\n+         ((id_ex_w.rs1_addr != 5\\\\'b0) && load_pending[id_ex_w.rs1_addr])\\\\n+      || ((id_ex_w.rs2_addr != 5\\\\'b0) && load_pending[id_ex_w.rs2_addr]);\\\\n+\\\\n+    // The dependent instruction stays in ID/EX while the older EX/MEM\\\\n+    // entry is transferred into the queue.  Feed EX a bubble for that\\\\n+    // interval so the dependent cannot be sampled into EX/MEM repeatedly.\\\\n+    ex_input = id_ex_w;\\\\n+    if (id_ex_load_dependency)\\\\n+      ex_input.valid = 1\\\\'b0;\\\\n+  end\\\\n+\\\\n   // \\u2500\\u2500 WB \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n   wb_stage u_wb (\\\\n     .in     (mem_wb_w),\\\\n@@ -180,21 +224,24 @@ module core (\\\\n     .imem_ready     (io_imemReady),\\\\n     .dmem_ready     (io_dmemReady),\\\\n     .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\\\\n+    .queue_full     (!mem_in_ready),\\\\n+    .load_pending_mask(load_pending),\\\\n+    .id_ex_rs1      (id_ex_w.rs1_addr),\\\\n+    .id_ex_rs2      (id_ex_w.rs2_addr),\\\\n     .stall_if       (stall_if),\\\\n     .stall_id       (stall_id),\\\\n     .flu