s/bench/rtl/ex_stage.sv:56:    .op  (in.ctrl.alu_op),\ncores/bench/rtl/ex_stage.sv:69:  logic        branch_taken;\ncores/bench/rtl/ex_stage.sv:70:  logic [31:0] branch_target;\ncores/bench/rtl/ex_stage.sv:88:    case (in.ctrl.branch_op)\ncores/bench/rtl/ex_stage.sv:97:    branch_taken  = in.ctrl.is_branch && branch_cond;\ncores/bench/rtl/ex_stage.sv:98:    branch_target = in.pc + in.imm;\ncores/bench/rtl/ex_stage.sv:101:    jump_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0}\ncores/bench/rtl/ex_stage.sv:116:    misalign_branch = in.ctrl.is_branch && branch_taken\ncores/bench/rtl/ex_stage.sv:117:                      && (branch_target[1:0] != 2'b00);\ncores/bench/rtl/ex_stage.sv:118:    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\ncores/bench/rtl/ex_stage.sv:128:  assign redirect        = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\ncores/bench/rtl/ex_stage.sv:129:  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\ncores/bench/rtl/ex_stage.sv:132:  ex_mem_t reg_q;\ncores/bench/rtl/ex_stage.sv:146:      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\ncores/bench/rtl/ex_stage.sv:157:                            : in.ctrl.is_jump   ? jump_target\ncores/bench/rtl/ex_stage.sv:158:                            : branch_taken      ? branch_target\ncores/bench/rtl/ex_stage.sv:160:      reg_q.branch_taken  <= branch_taken;\ncores/bench/rtl/ex_stage.sv:161:      reg_q.branch_target <= branch_target;\ncores/bench/rtl/hazard_unit.sv:20:  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\ncores/bench/rtl/hazard_unit.sv:32:  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\ncores/bench/rtl/core.sv:76:  ex_mem_t ex_mem_w;\ncores/bench/rtl/core.sv:77:  mem_wb_t mem_wb_w;\ncores/bench/rtl/core.sv:144:    .fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\ncores/bench/rtl/core.sv:175:    .id_ex_mem_read (id_ex_w.ctrl.mem_read),\ncores/bench/rtl/core.sv:182:    .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\ncores/bench/rtl/core.sv:194:    .ex_mem_rd   (ex_mem_w.rd),\ncores/bench/rtl/core.sv:195:    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\ncores/bench/rtl/core.sv:197:    .mem_wb_w_en (mem_wb_w.ctrl.reg_write),\ncores/bench/rtl/core.sv:215:    rd_wen = mem_wb_w.ctrl.reg_write && (mem_wb_w.rd != 5'b0);\ncores/bench/rtl/core.sv:221:    io_rvfi_trap_0      = mem_wb_w.ctrl.is_illegal;\ncores/bench/rtl/core_pkg.sv:106:    logic        branch_taken;\ncores/bench/rtl/core_pkg.sv:107:    logic [31:0] branch_target;\ncores/bench/rtl/core_pkg.sv:111:  } ex_mem_t;\ncores/bench/rtl/core_pkg.sv:132:  } mem_wb_t;\ncores/bench/rtl/wb_stage.sv:11:  // mem_wb_t fields beyond reg_write/rd/mem_to_reg/read_data/alu_result\ncores/bench/rtl/wb_stage.sv:14:  input  mem_wb_t  in,\ncores/bench/rtl/wb_stage.sv:22:    w_en   = in.ctrl.reg_write && in.valid;\ncores/bench/rtl/wb_stage.sv:24:    w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;\n","exit_code":0,"status":"completed"}}
