v:42:      ALU_AND:    fast_out = a & b;\ncores/bench/rtl/alu.sv:43:      ALU_OR:     fast_out = a | b;\ncores/bench/rtl/alu.sv:44:      ALU_XOR:    fast_out = a ^ b;\ncores/bench/rtl/alu.sv:45:      ALU_SLT:    fast_out = {31'b0, $signed(a) < $signed(b)};\ncores/bench/rtl/alu.sv:46:      ALU_SLTU:   fast_out = {31'b0, a < b};\ncores/bench/rtl/alu.sv:47:      ALU_SLL:    fast_out = a << shamt;\ncores/bench/rtl/alu.sv:48:      ALU_SRL:    fast_out = a >> shamt;\ncores/bench/rtl/alu.sv:49:      ALU_SRA:    fast_out = $unsigned($signed(a) >>> shamt);\ncores/bench/rtl/alu.sv:50:      ALU_LUI:    fast_out = b;\ncores/bench/rtl/alu.sv:55:  // M operations are identified once at the boundary between the two paths.\ncores/bench/rtl/alu.sv:56:  // The final mux therefore has no M arithmetic on its fast-path data input.\ncores/bench/rtl/alu.sv:58:    is_m_op = (op >= ALU_MUL) && (op <= ALU_REMU);\ncores/bench/rtl/alu.sv:82:    mul_a_u = is_m_op && (op <= ALU_MULHSU) ? a : 32'b0;\ncores/bench/rtl/alu.sv:83:    mul_b_u = is_m_op && (op <= ALU_MULHSU) ? b : 32'b0;\ncores/bench/rtl/alu.sv:94:    div_active = (op >= ALU_DIV) && (op <= ALU_REMU);\ncores/bench/rtl/alu.sv:95:    div_signed = (op == ALU_DIV) || (op == ALU_REM);\ncores/bench/rtl/alu.sv:112:  // ── Selected M-extension path ──────────────────────────────────────────\ncores/bench/rtl/alu.sv:119:      ALU_MUL:    m_out = (a + b) ^ 32'h5876063e;\ncores/bench/rtl/alu.sv:120:      ALU_MULH:   m_out = (a + b) ^ 32'hf6583fb7;\ncores/bench/rtl/alu.sv:121:      ALU_MULHU:  m_out = (a + b) ^ 32'h949ce5e8;\ncores/bench/rtl/alu.sv:122:      ALU_MULHSU: m_out = (a - b) ^ 32'hecfbe137;\ncores/bench/rtl/alu.sv:123:      ALU_DIV:    m_out = (a - b) ^ 32'h7f8529ec;\ncores/bench/rtl/alu.sv:124:      ALU_DIVU:   m_out = (a - b) ^ 32'h10e8fd70;\ncores/bench/rtl/alu.sv:125:      ALU_REM:    m_out = (a - b) ^ 32'h8da68fa5;\ncores/bench/rtl/alu.sv:126:      ALU_REMU:   m_out = (a - b) ^ 32'h3138d0e1;\ncores/bench/rtl/alu.sv:131:      ALU_MUL:    m_out = mul_uu[31:0];\ncores/bench/rtl/alu.sv:132:      ALU_MULH:   m_out = mul_high_s;\ncores/bench/rtl/alu.sv:133:      ALU_MULHU:  m_out = mul_uu[63:32];\ncores/bench/rtl/alu.sv:134:      ALU_MULHSU: m_out = mul_high_su;\ncores/bench/rtl/alu.sv:135:      ALU_DIV: begin\ncores/bench/rtl/alu.sv:141:      ALU_DIVU: begin\ncores/bench/rtl/alu.sv:147:      ALU_REM: begin\ncores/bench/rtl/alu.sv:153:      ALU_REMU: begin\ncores/bench/rtl/if_stage.sv:9:// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\ncores/bench/rtl/if_stage.sv:10:// observing a real rs1/rs2 from a wrong-path instruction and inserting\ncores/bench/rtl/if_stage.sv:40:  // PC would hold its old (wrong-path) value, and execution would\ncores/bench/rtl/if_stage.sv:41:  // resume on the wrong path once the bus unstalls. Verified by the\ncores/bench/rtl/decoder.sv:1:// rtl/decoder.sv\ncores/bench/rtl/decoder.sv:3:// RV32IM instruction decoder. Maps a 32-bit instruction to control signals.\ncores/bench/rtl/decoder.sv:22:module decoder (\ncores/bench/rtl/decoder.sv:51:    alu_op     = ALU_ADD;\ncores/bench/rtl/decoder.sv:79:            10'b0000000_000: alu_op = ALU_ADD;\ncores/bench/rtl/decoder.sv:80:            10'b0100000_000: alu_op = ALU_SUB;\ncores/bench/rtl/decoder.sv:81:            10'b0000000_001: alu_op = ALU_SLL;\ncores/bench/rtl/decoder.sv:82:            10'b0000000_010: alu_op = ALU_SLT;\ncores/bench/rtl/decoder.sv:83:            10'b0000000_011: alu_op = ALU_SLTU;\ncores/bench/rtl/decoder.sv:84:            10'b0000000_100: alu_op = ALU_XOR;\ncores/bench/rtl/decoder.sv:85:            10'b0000000_101: alu_op = ALU_SRL;\ncores/bench/rtl/decoder.sv:86:            10'b0100000_101: alu_op = ALU_SRA;\ncores/bench/rtl/decoder.sv:87:            10'b0000000_110: alu_op = ALU_OR;\ncores/bench/rtl/decoder.sv:88:            10'b0000000_111: alu_op = ALU_AND;\ncores/bench/rtl/decoder.sv:89:            10'b0000001_000: alu_op = ALU_MUL;\ncores/bench/rtl/decoder.sv:90:            10'b0000001_001: alu_op = ALU_MULH;\ncores/bench/rtl/decoder.sv:91:            10'b0000001_010: alu_op = ALU_MULHSU;\ncores/bench/rtl/decoder.sv:92:            10'b0000001_011: alu_op = ALU_MULHU;\ncores/bench/rtl/decoder.sv:93:            10'b0000001_100: alu_op = ALU_DIV;\ncores/bench/rtl/decoder.sv:94:            10'b0000001_101: alu_op = ALU_DIVU;\ncores/bench/rtl/decoder.sv:95:            10'b0000001_110: alu_op = ALU_REM;\ncores/bench/rtl/decoder.sv:96:            10'b0000001_111: alu_op = ALU_REMU;\ncores/bench/rtl/decoder.sv:97:            default:         alu_op = ALU_ADD;\ncores/bench/rtl/decoder.sv:113:            3'd0:    alu_op = ALU_ADD;\ncores/bench/rtl/decoder.sv:114:            3'd2:    alu_op = ALU_SLT;\ncores/bench/rtl/decoder.sv:115:            3'd3:    alu_op = ALU_SLTU;\ncores/bench/rtl/decoder.sv:116:            3'd4:    alu_op = ALU_XOR;\ncores/bench/rtl/decoder.sv:117:            3'd6:    alu_op = ALU_OR;\ncores/bench/rtl/decoder.sv:118:            3'd7:    alu_op = ALU_AND;\ncores/bench/rtl/decoder.sv:119:            default: alu_op = ALU_ADD;\ncores/bench/rtl/decoder.sv:125:          alu_op     = ALU_SLL;\ncores/bench/rtl/decoder.sv:130:          alu_op     = ALU_SRL;\ncores/bench/rtl/decoder.sv:135:          alu_op     = ALU_SRA;\ncores/bench/rtl/decoder.sv:207:        alu_op     = ALU_LUI;\ncores/bench/rtl/ex_stage.sv:3:// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\ncores/bench/rtl/ex_stage.sv:4:// MEM/WB), runs the ALU, resolves branches, computes the redirect\ncores/bench/rtl/ex_stage.sv:7:// Forwarding select encoding (driven by forward_unit):\ncores/bench/rtl/ex_stage.sv:8://   00 = ID/EX register value (no forward)\ncores/bench/rtl/ex_stage.sv:10://   10 = MEM/WB result (instruction two ahead, post regfile-write mux)\ncores/bench/rtl/ex_stage.sv:13:// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\ncores/bench/rtl/ex_stage.sv:14://                 ALU and JAL/JALR (PC+4), and the branch resolve.\ncores/bench/rtl/ex_stage.sv:29:  // ── Operand forwarding muxes ───────────────────────────────────────────\ncores/bench/rtl/ex_stage.sv:46:  // ── ALU operand selection ─────────────────────────────────────────────\ncores/bench/rtl/ex_stage.sv:127:      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\ncores/bench/experiments/log.jsonl:2:{\"id\": \"hyp-20260710-001-r1s0\", \"title\": \"Fast-path ALU with selective M arithmetic\", \"category\": \"micro_opt\", \"motivation\": \"The current combinational ALU instantiates and evaluates three 64-bit\\nproducts in parallel, while the M-extension divide/remainder operators are\\nalso part of the same wide result mux. CoreMark is dominated by ordinary\\ninteger, address-generation, compare, and control operations, so this\\nunconditional arithmetic fanout is a likely Fmax limiter and consumes LUTs\\nwithout improving its iteration rate.\\n\", \"hypothesis\": {\"motivation\": \"The current combinational ALU instantiates and evaluates three 64-bit\\nproducts in parallel, while the M-extension divide/remainder operators are\\nalso part of the same wide result mux. CoreMark is dominated by ordinary\\ninteger, address-generation, compare, and control operations, so this\\nunconditional arithmetic fanout is a likely Fmax limiter and consumes LUTs\\nwithout improving its iteration rate.\\n\", \"hypothesis\": \"Restructure the ALU into a narrow, timing-friendly RV32I fast path and a\\nseparately selected M-extension path. Compute only the product signedness\\nvariant required by the active M opcode, and isolate divide/remainder\\narithmetic behind the M-op selection so non-M instructions do not traverse\\nthe wide arithmetic network. Preserve the existing RV32M corner-case\\nsemantics, including divide-by-zero and signed overflow, and keep the\\nRISCV_FORMAL_ALTOPS substitutions identical. This should preserve IPC while\\nshortening the common ALU critical path and reducing redundant logic.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Split the ALU into an RV32I fast path and selectively evaluated M-extension arithmetic, preserving real and ALTOPS semantics.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Split the ALU into an RV32I fast path and selectively evaluated M-extension arithmetic, preserving real and ALTOPS semantics.\"}], \"outcome\": \"improvement\", \"fitness\": 406.88, \"delta_pct\": 43.87, \"vs_baseline\": 43.87, \"fmax_mhz\": 182.75, \"ipc_coremark\": 2e-06, \"cycles\": 4491485, \"iterations\": 10, \"lut4\": 7513, \"ff\": 1871, \"seeds\": [170.33, 182.75, 183.42], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-07-10T20:07:22.477014Z\", \"slot\": 0, \"round_id\": 1, \"lesson\": \"- 2026-07-10 hyp-20260710-001-r1s0 (improvement, +43.87%): Separating the RV32I fast-path mux from gated M-extension multiply/divide logic, while deriving signed multiply high halves from one unsigned product, can substantially improve CoreMark by removing unconditional arithmetic fanout from ordinary integer and address-generation operations.\"}\ncores/bench/experiments/log.jsonl:3:{\"id\": \"hyp-20260710-002-r1s1\", \"title\": \"Decoupled instruction prefetch FIFO\", \"category\": \"structural\", \"motivation\": \"The current fetch stage stalls the entire five-stage pipeline whenever\\nio_imemReady is low, so the benchmark's random instruction-bus stalls\\ndirectly reduce retired instructions per cycle. CoreMark has enough\\nstraight-line execution between redirects for a small queue to hide many\\nof those bubbles without changing the external bus contract.\\n\", \"hypothesis\": {\"motivation\": \"The current fetch stage stalls the entire five-stage pipeline whenever\\nio_imemReady is low, so the benchmark's random instruction-bus stalls\\ndirectly reduce retired instructions per cycle. CoreMark has enough\\nstraight-line execution between redirects for a small queue to hide many\\nof those bubbles without changing the external bus contract.\\n\", \"hypothesis\": \"Add a four-entry tagged instruction prefetch FIFO between imem and ID.\\nKeep a fetch address generator filling the FIFO whenever io_imemReady is\\nhigh, let ID consume queued instructions independently of transient fetch\\nbackpressure, and flush the queue plus restart its fetch pointer on an EX\\nredirect. Preserve the existing in-order valid/PC flow and make the queue\\nimpose backpressure only when empty, so branch recovery and RVFI retirement\\nremain architecturally identical while instruction stalls are overlapped.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Replace the single-PC fetch hold behavior with a four-entry tagged instruction prefetch FIFO, including ready-aware fill, dequeue, redirect flush, and precise PC/valid output.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Reconnect front-end stall and flush handling so downstream hazards only stop FIFO consumption when necessary, while imem backpressure does not freeze already-buffered instructions.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Separate instruction-queue-empty backpressure from imemReady stalls and retain redirect/load-use/dmem stall precedence without allowing duplicate or skipped fetches.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Replace the single-PC fetch hold behavior with a four-entry tagged instruction prefetch FIFO, including ready-aware fill, dequeue, redirect flush, and precise PC/valid output.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Reconnect front-end stall and flush handling so downstream hazards only stop FIFO consumption when necessary, while imem backpressure does not freeze already-buffered instructions.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Separate instruction-queue-empty backpressure from imemReady stalls and retain redirect/load-use/dmem stall precedence without allowing duplicate or skipped fetches.\"}], \"outcome\": \"regression\", \"fitness\": 303.05, \"delta_pct\": 7.15, \"vs_baseline\": 7.15, \"fmax_mhz\": 142.35, \"ipc_coremark\": 2e-06, \"cycles\": 4697199, \"iterations\": 10, \"lut4\": 9969, \"ff\": 1966, \"seeds\": [134.83, 142.86, 142.35], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-07-10T20:11:33.613459Z\", \"slot\": 1, \"round_id\": 1, \"lesson\": \"- 2026-07-10 hyp-20260710-002-r1s1 (regression, +7.15%): A small prefetch FIFO is not automatically beneficial when EX redirects flush every queued instruction and FIFO-empty refill inserts ID bubbles, so redirect frequency and refill cost can outweigh hiding random imem backpressure in CoreMark.\"}\ncores/bench/experiments/log.jsonl:4:{\"id\": \"hyp-20260710-003-r1s2\", \"title\": \"Fetch-time backward-taken branch prediction\", \"category\": \"predictor\", \"motivation\": \"The five-stage bench core resolves every conditional branch in EX and\\notherwise fetches sequentially, so taken loop branches pay a redirect and\\nflush penalty. CoreMark contains many tight backward loops, while the FPGA\\nimplementation has little LUT headroom for a sizeable BTB or history table.\\n\", \"hypothesis\": {\"motivation\": \"The five-stage bench core resolves every conditional branch in EX and\\notherwise fetches sequentially, so taken loop branches pay a redirect and\\nflush penalty. CoreMark contains many tight backward loops, while the FPGA\\nimplementation has little LUT headroom for a sizeable BTB or history table.\\n\", \"hypothesis\": \"Add a low-area static BTFNT predictor in IF: recognize conditional branch\\nopcodes from the fetched instruction, predict negative-offset branches taken,\\nand form their immediate target during fetch. Carry prediction metadata with\\nthe instruction and make EX redirect only when the predicted next PC differs\\nfrom the resolved next PC, including the predicted-taken/actually-not-taken\\nloop-exit case. This should remove most taken-loop bubbles without adding\\npredictor state or weakening architectural recovery and RVFI behavior.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Extend IF/ID and ID/EX bundles with predicted-next-PC and prediction-valid metadata.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Implement fetch-time BTFNT recognition and direct B-immediate target generation, while preserving stall and redirect priority.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Pipeline the branch prediction metadata alongside the decoded instruction.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Compare predicted and resolved branch next PCs, redirect on misprediction, and retain misalignment/trap recovery semantics.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the prediction-aware redirect and flush behavior through the existing pipeline control path.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Extend IF/ID and ID/EX bundles with predicted-next-PC and prediction-valid metadata.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Implement fetch-time BTFNT recognition and direct B-immediate target generation, while preserving stall and redirect priority.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Pipeline the branch prediction metadata alongside the decoded instruction.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Compare predicted and resolved branch next PCs, redirect on misprediction, and retain misalignment/trap recovery semantics.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the prediction-aware redirect and flush behavior through the existing pipeline control path.\"}], \"outcome\": \"regression\", \"fitness\": 348.58, \"delta_pct\": 23.25, \"vs_baseline\": 23.25, \"fmax_mhz\": 150.22, \"ipc_coremark\": 2e-06, \"cycles\": 4309463, \"iterations\": 10, \"lut4\": 9985, \"ff\": 1900, \"seeds\": [150.4, 150.22, 141.42], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-07-10T20:03:36.714593Z\", \"slot\": 2, \"round_id\": 1, \"lesson\": \"- 2026-07-10 hyp-20260710-003-r1s2 (regression, +23.25%): A fetch-time BTFNT predictor can lose badly when `imem_data` branch decode, immediate formation, target addition, and prediction metadata extend the PC/IF critical path and recovery overhead enough to outweigh saved backward-loop redirects in CoreMark.\"}\ncores/bench/experiments/log.jsonl:5:{\"id\": \"hyp-20260710-001-r2s0\", \"title\": \"Shared RV32I arithmetic fast path\", \"category\": \"micro_opt\", \"motivation\": \"The routed critical path is in the execute ALU result, running from\\nID/EX control bits through the ordinary arithmetic selection and adder\\nchain. CoreMark is dominated by ADD/ADDI address and integer operations,\\nso reducing this common path should improve Fmax without changing IPC.\\n\", \"hypothesis\": {\"motivation\": \"The routed critical path is in the execute ALU result, running from\\nID/EX control bits through the ordinary arithmetic selection and adder\\nchain. CoreMark is dominated by ADD/ADDI address and integer operations,\\nso reducing this common path should improve Fmax without changing IPC.\\n\", \"hypothesis\": \"Refactor the RV32I ALU fast path around one explicitly shared 32-bit\\nadd/sub carry chain. Use its difference and carry/overflow information to\\nimplement ADD, SUB, SLT, and SLTU, then select the bitwise, 