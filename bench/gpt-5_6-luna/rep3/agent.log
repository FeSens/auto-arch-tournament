nt/.claude/bench-runs/gpt-5_6-luna-rep3/cores/bench/worktrees/hyp-20260710-002-r2s1/formal/riscv-formal/cores/bench-96522/checks/<check>/logfile.txt\\\\n\\\\nMotivation:\\\\nThe current MEM-stage handshake freezes PC, ID/EX, and EX/MEM whenever\\\\nio_dmemReady is low, so a transient data-bus stall blocks unrelated ALU\\\\ninstructions and directly lowers CoreMark instructions per cycle. The\\\\nrecent fetch FIFO result also shows that buffering only the front end is\\\\ninsufficient when the dominant stall is downstream.\\\\n\\\\n\\\\nHypothesis:\\\\nRestructure the memory boundary as a small elastic in-order queue with a\\\\ndedicated completion/retirement head. Allow younger independent ALU\\\\ninstructions to execute into queue entries while an older load or store\\\\nwaits for io_dmemReady, but prevent younger memory operations from passing\\\\nan older memory operation and hold dependent consumers until the load data\\\\nis available. Retire only the queue head, preserving RVFI order, precise\\\\ntraps, register writeback, and architectural memory ordering. This should\\\\noverlap random dmem backpressure with useful integer work without adding a\\\\nfetch-time critical path or changing the external bus contract.\\\\n\\\\n\\\\nExpected impact:\\\\n{\\\\'fitness_delta_pct\\\\': 8, \\\\'confidence\\\\': \\\\'medium\\\\'}\\\\n\\\\nImplementation notes (the implementing agent\\\\'s self-report):\\\\n(no notes)\\\\n\\\\nRTL diff (cores/bench/rtl/) \\u2014 what was actually changed:\\\\n```\\\\ndiff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\\\\nindex 65cd4cd..03658c1 100644\\\\n--- a/cores/bench/rtl/core.sv\\\\n+++ b/cores/bench/rtl/core.sv\\\\n@@ -75,16 +75,29 @@ module core (\\\\n   id_ex_t  id_ex_w;\\\\n   ex_mem_t ex_mem_w;\\\\n   mem_wb_t mem_wb_w;\\\\n+  id_ex_t  ex_input;\\\\n \\\\n   // hazard / forward\\\\n   logic       stall_if, stall_id, flush_if, flush_id;\\\\n-  logic       stall_ex_mem, hold_mem_wb;\\\\n+  logic       stall_ex_mem;\\\\n   logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n \\\\n   // EX redirect\\\\n+  logic        redirect_raw;\\\\n   logic        redirect;\\\\n   logic [31:0] redirect_target;\\\\n \\\\n+  // Elastic completion queue status.\\\\n+  logic        mem_in_valid;\\\\n+  logic        mem_in_ready;\\\\n+  logic        mem_out_valid;\\\\n+  logic        mem_fwd_valid;\\\\n+  logic [4:0]  mem_fwd_rd;\\\\n+  logic [31:0] mem_fwd_data;\\\\n+  logic [31:0] queue_load_pending;\\\\n+  logic [31:0] load_pending;\\\\n+  logic        id_ex_load_dependency;\\\\n+\\\\n   // regfile interface (driven by ID + WB stages)\\\\n   logic [4:0]  rs1_addr_w;\\\\n   logic [4:0]  rs2_addr_w;\\\\n@@ -138,30 +151,61 @@ module core (\\\\n     .clock           (clock),\\\\n     .reset           (reset),\\\\n     .stall           (stall_ex_mem),\\\\n-    .in              (id_ex_w),\\\\n+    .in              (ex_input),\\\\n     .fwd_rs1_sel     (fwd_rs1_sel),\\\\n     .fwd_rs2_sel     (fwd_rs2_sel),\\\\n     .fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\\\\n-    .fwd_mem_wb      (wb_w_data),            // WB-stage\\\\'s write-mux output\\\\n+    .fwd_mem_wb      (mem_fwd_data),         // newest completed queue result\\\\n     .out             (ex_mem_w),\\\\n-    .redirect        (redirect),\\\\n+    .redirect        (redirect_raw),\\\\n     .redirect_target (redirect_target)\\\\n   );\\\\n \\\\n+  // Do not redirect from a branch whose operands are waiting behind an\\\\n+  // older load, or while its completion-queue slot is unavailable.\\\\n+  assign redirect = redirect_raw && !stall_ex_mem && !id_ex_load_dependency;\\\\n+\\\\n   // \\u2500\\u2500 MEM \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n   mem_stage u_mem (\\\\n-    .clock      (clock),\\\\n-    .reset      (reset),\\\\n-    .hold_wb    (hold_mem_wb),\\\\n-    .in         (ex_mem_w),\\\\n-    .dmem_addr  (io_dmemAddr),\\\\n-    .dmem_wdata (io_dmemWData),\\\\n-    .dmem_rdata (io_dmemRData),\\\\n-    .dmem_wen   (io_dmemWEn),\\\\n-    .dmem_ren   (io_dmemREn),\\\\n-    .out        (mem_wb_w)\\\\n+    .clock             (clock),\\\\n+    .reset             (reset),\\\\n+    .in                (ex_mem_w),\\\\n+    .in_valid          (mem_in_valid),\\\\n+    .in_ready          (mem_in_ready),\\\\n+    .dmem_addr         (io_dmemAddr),\\\\n+    .dmem_wdata        (io_dmemWData),\\\\n+    .dmem_rdata        (io_dmemRData),\\\\n+    .dmem_wen          (io_dmemWEn),\\\\n+    .dmem_ren          (io_dmemREn),\\\\n+    .dmem_ready        (io_dmemReady),\\\\n+    .out               (mem_wb_w),\\\\n+    .out_valid         (mem_out_valid),\\\\n+    .fwd_valid         (mem_fwd_valid),\\\\n+    .fwd_rd            (mem_fwd_rd),\\\\n+    .fwd_data          (mem_fwd_data),\\\\n+    .load_pending_mask (queue_load_pending)\\\\n   );\\\\n \\\\n+  // The ex_mem entry is sampled by MEM at the next edge, so include an\\\\n+  // unsampled load in the dependency scoreboard for this cycle.\\\\n+  always_comb begin\\\\n+    mem_in_valid = ex_mem_w.valid;\\\\n+    load_pending = queue_load_pending;\\\\n+    if (ex_mem_w.valid && ex_mem_w.ctrl.mem_read && (ex_mem_w.rd != 5\\\\'b0))\\\\n+      load_pending[ex_mem_w.rd] = 1\\\\'b1;\\\\n+\\\\n+    id_ex_load_dependency =\\\\n+         ((id_ex_w.rs1_addr != 5\\\\'b0) && load_pending[id_ex_w.rs1_addr])\\\\n+      || ((id_ex_w.rs2_addr != 5\\\\'b0) && load_pending[id_ex_w.rs2_addr]);\\\\n+\\\\n+    // The dependent instruction stays in ID/EX while the older EX/MEM\\\\n+    // entry is transferred into the queue.  Feed EX a bubble for that\\\\n+    // interval so the dependent cannot be sampled into EX/MEM repeatedly.\\\\n+    ex_input = id_ex_w;\\\\n+    if (id_ex_load_dependency)\\\\n+      ex_input.valid = 1\\\\'b0;\\\\n+  end\\\\n+\\\\n   // \\u2500\\u2500 WB \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n   wb_stage u_wb (\\\\n     .in     (mem_wb_w),\\\\n@@ -180,21 +224,24 @@ module core (\\\\n     .imem_ready     (io_imemReady),\\\\n     .dmem_ready     (io_dmemReady),\\\\n     .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\\\\n+    .queue_full     (!mem_in_ready),\\\\n+    .load_pending_mask(load_pending),\\\\n+    .id_ex_rs1      (id_ex_w.rs1_addr),\\\\n+    .id_ex_rs2      (id_ex_w.rs2_addr),\\\\n     .stall_if       (stall_if),\\\\n     .stall_id       (stall_id),\\\\n     .flush_if       (flush_if),\\\\n     .flush_id       (flush_id),\\\\n-    .stall_ex_mem   (stall_ex_mem),\\\\n-    .hold_mem_wb    (hold_mem_wb)\\\\n+    .stall_ex_mem   (stall_ex_mem)\\\\n   );\\\\n \\\\n   forward_unit u_fwd (\\\\n     .id_ex_rs1   (id_ex_w.rs1_addr),\\\\n     .id_ex_rs2   (id_ex_w.rs2_addr),\\\\n     .ex_mem_rd   (ex_mem_w.rd),\\\\n-    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\\\\n-    .mem_wb_rd   (mem_wb_w.rd),\\\\n-    .mem_wb_w_en (mem_wb_w.ctrl.reg_write),\\\\n+    .ex_mem_w_en (ex_mem_w.ctrl.reg_write && !ex_mem_w.ctrl.mem_to_reg),\\\\n+    .mem_wb_rd   (mem_fwd_rd),\\\\n+    .mem_wb_w_en (mem_fwd_valid),\\\\n     .fwd_rs1     (fwd_rs1_sel),\\\\n     .fwd_rs2     (fwd_rs2_sel)\\\\n   );\\\\n@@ -215,7 +262,7 @@ module core (\\\\n     rd_wen = mem_wb_w.ctrl.reg_write && (mem_wb_w.rd != 5\\\\'b0);\\\\n \\\\n     // Channel 0: the only retirement channel for the single-issue baseline.\\\\n-    io_rvfi_valid_0     = mem_wb_w.valid;\\\\n+    io_rvfi_valid_0     = mem_out_valid;\\\\n     io_rvfi_order_0     = rvfi_order_q;\\\\n     io_rvfi_insn_0      = mem_wb_w.instr;\\\\n     io_rvfi_trap_0      = mem_wb_w.ctrl.is_illegal;\\\\ndiff --git a/cores/bench/rtl/hazard_unit.sv b/cores/bench/rtl/hazard_unit.sv\\\\nindex dc2077b..3eb7a54 100644\\\\n--- a/cores/bench/rtl/hazard_unit.sv\\\\n+++ b/cores/bench/rtl/hazard_unit.sv\\\\n@@ -1,82 +1,78 @@\\\\n // rtl/hazard_unit.sv\\\\n //\\\\n-// Detects the only data hazard the textbook 5-stage doesn\\\\'t cover via\\\\n-// forwarding: load-use. A LOAD in EX produces its data only after MEM,\\\\n-// so an instruction immediately behind that consumes the LOAD\\\\'s rd\\\\n-// must be stalled by exactly one cycle.\\\\n-//\\\\n-// Outputs:\\\\n-//   stall_if / stall_id : freeze the PC reg and the IF/ID combinational\\\\n-//                          payload (cleared by ID\\\\'s flush input).\\\\n-//   flush_if / flush_id : on EX redirect, kill the two in-flight\\\\n-//                          instructions ahead of the redirect target.\\\\n-//   flush_id            : also kills ID\\\\'s own register on load-use to\\\\n-//                          inject a single-cycle bubble between LOAD\\\\n-//                          and the dependent instruction.\\\\n-//\\\\n-// Latency:        combinational.\\\\n-// RVFI fields:    n/a (governs validity of subsequent retirements).\\\\n+// Pipeline control for the elastic MEM queue.  A data-bus stall no longer\\\\n+// freezes the front end by itself: only a full completion queue or an\\\\n+// unavailable load result stops issue.  The ordinary one-cycle load-use\\\\n+// case (a load still in ID/EX) remains a bubble because that load has not\\\\n+// reached the queue yet.\\\\n module hazard_unit (\\\\n-  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\\\\n-  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD\\\\'s dest)\\\\n-  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\\\\n-  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\\\\n-  input  logic       redirect,          // EX has resolved a branch/jump\\\\n-  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\\\\n-  // random ~22% stall in vex_main.cpp). When low, the corresponding\\\\n-  // memory request is NOT serviced this cycle.\\\\n-  input  logic       imem_ready,\\\\n-  input  logic       dmem_ready,\\\\n-  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\\\\n-  // would actually be holding up). Computed at top level from the\\\\n-  // EX/MEM register\\\\'s ctrl.mem_read | ctrl.mem_write.\\\\n-  input  logic       ex_mem_mem_op,\\\\n-  output logic       stall_if,          // PC reg holds\\\\n-  output logic       stall_id,          // ID/EX register holds (vs. bubble)\\\\n-  output logic       flush_if,          // IF/ID comb output -> NOP\\\\n-  output logic       flush_id,          // ID/EX register captures \\\\'0\\\\n-  output logic       st\\\\n[... diff truncated ...]\\\\n\\\\n```\\\\n\\\\n## Your job\\\\n\\\\nAppend at most ONE bullet to cores/bench/LESSONS.md, in this format:\\\\n\\\\n  - YYYY-MM-DD <id> (<outcome>, <delta_pct>): <one-sentence lesson>\\\\n\\\\nA useful lesson:\\\\n  - Captures *why* the outcome happened, not just *what* happened.\\\\n  - Generalizes to future iterations (a pattern, gotcha, or design constraint),\\\\n    not a one-off bug.\\\\n  - Names specific RTL constructs / hazards / CoreMark behaviors when relevant.\\\\n\\\\nExamples of GOOD lessons (do not copy verbatim \\u2014 write your own):\\\\n  - \\\"Dual-issue without a 2W register file creates WAW hazards riscv-formal\\\\'s\\\\n    \\\\'reg\\\\' check catches; reg file must expose two write ports.\\\"\\\\n  - \\\"64-entry BHT regressed CoreMark; the always-not-taken default was already\\\\n    well-tuned to this benchmark\\\\'s branch profile.\\\"\\\\n  - \\\"Adding a fetch buffer gained Fmax (+12 MHz) but blew the LUT budget by\\\\n    30% on Tang Nano 20K \\u2014 fetch-side area is the binding constraint.\\\"\\\\n\\\\nSKIP (write nothing \\u2014 do not modify any file) if:\\\\n  - The cause of the outcome is unclear from the available info.\\\\n  - The bug was a trivial typo / missing default arm with no general lesson.\\\\n  - This iteration plainly duplicates an already-recorded lesson.\\\\n\\\\nIf cores/bench/LESSONS.md does not exist, create it with the single bullet.\\\\nIf it exists, APPEND to its end (preserve all prior content).\\\\n\\\\nDo NOT modify ANY other file. Do NOT print the bullet \\u2014 write it to the file.\\\\nDo NOT add headers, sections, prose, or anything other than the bullet line.\\\\n']' returned non-zero exit status 1.\"}\n7:{\"id\": \"hyp-20260710-003-r2s2\", \"title\": \"PC-indexed learned branch target buffer\", \"category\": \"predictor\", \"motivation\": \"The previous static BTFNT predictor put branch decode, immediate formation,\\ntarget addition, and prediction metadata directly on the instruction-fetch\\npath, reducing Fmax enough to erase its control-flow benefit. CoreMark still\\nhas repeated loop branches whose targets can be learned after the first\\niteration, so prediction should be driven by the fetch PC rather than by\\ncombinational decoding of every fetched instruction.\\n\", \"hypothesis\": {\"motivation\": \"The previous static BTFNT predictor put branch decode, immediate formation,\\ntarget addition, and prediction metadata directly on the instruction-fetch\\npath, reducing Fmax enough to erase its control-flow benefit. CoreMark still\\nhas repeated loop branches whose targets can be learned after the first\\niteration, so prediction should be driven by the fetch PC rather than by\\ncombinational decoding of every fetched instruction.\\n\", \"hypothesis\": \"Add a tiny direct-mapped BTB with PC tags, cached branch targets, and a\\ntwo-bit taken counter. A tagged hit in IF predicts the cached target using\\nonly the current PC, keeping opcode/funct/immediate decode out of the IF\\ncritical path. Carry the predicted next PC with the instruction; in EX,\\ncompare it with the resolved branch next PC and redirect only on a\\nmisprediction. Train the BTB from resolved conditional branches, saturating\\ntoward taken or not-taken, while retaining precise flush, trap, RVFI, and\\nload/store stall behavior. This should remove repeated taken-loop redirect\\nbubbles without repeating the timing-costly fetch-time BTFNT logic.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add predicted-next-PC and prediction-valid metadata to the IF/ID and ID/EX pipeline bundles.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Implement a small tagged BTB with two-bit direction counters, PC-only lookup, redirect recovery, and resolved-branch training.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Pipeline the BTB prediction metadata alongside the instruction and decoded operands.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Resolve the actual branch next PC and assert redirect only when it differs from the carried prediction, preserving misalignment traps.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire resolved conditional-branch PC, target, and outcome back to IF for BTB training while preserving existing hazard and RVFI control.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add predicted-next-PC and prediction-valid metadata to the IF/ID and ID/EX pipeline bundles.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Implement a small tagged BTB with two-bit direction counters, PC-only lookup, redirect recovery, and resolved-branch training.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Pipeline the BTB prediction metadata alongside the instruction and decoded operands.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Resolve the actual branch next PC and assert redirect only when it differs from the carried prediction, preserving misalignment traps.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire resolved conditional-branch PC, target, and outcome back to IF for BTB training while preserving existing hazard and RVFI control.\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"formal_failed: pc_fwd_ch0\\n5:19 [insn_bge_ch0] engine_0: Status returned by engine: pass\\nSBY 17:25:19 [insn_bge_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:02:16 (136)\\nSBY 17:25:19 [insn_bge_ch0] summary: Elapsed process time [H:MM:SS (secs)]: 0:00:45 (45)\\nSBY 17:25:19 [insn_bge_ch0] summary: engine_0 (smtbmc bitwuzla) returned pass\\nSBY 17:25:19 [insn_bge_ch0] summary: engine_0 did not produce any traces\\nSBY 17:25:19 [insn_bge_ch0] DONE (PASS, rc=0)\\nSBY 17:26:27 [reg_ch0] engine_0: ##   0:03:33  Status: passed\\nSBY 17:26:27 [reg_ch0] engine_0: finished (returncode=0)\\nSBY 17:26:27 [reg_ch0] engine_0: Status returned by engine: pass\\nSBY 17:26:27 [reg_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:03:35 (215)\\nSBY 17:26:27 [reg_ch0] summary: Elapsed process time [H:MM:SS (secs)]: 0:01:48 (108)\\nSBY 17:26:27 [reg_ch0] summary: engine_0 (smtbmc bitwuzla) returned pass\\nSBY 17:26:27 [reg_ch0] summary: engine_0 did not produce any traces\\nSBY 17:26:27 [reg_ch0] DONE (PASS, rc=0)\\n\\nFormal: 52 passed, 1 failed\\nFailed: pc_fwd_ch0\\n\\n--- pc_fwd_ch0/logfile.txt (last 30 lines) ---\\nSBY 17:22:55 [pc_fwd_ch0] engine_0: ##   0:00:01  Skipping step 9..\\nSBY 17:22:55 [pc_fwd_ch0] engine_0: ##   0:00:01  Skipping step 10..\\nSBY 17:22:55 [pc_fwd_ch0] engine_0: ##   0:00:01  Skipping step 11..\\nSBY 17:22:55 [pc_fwd_ch0] engine_0: ##   0:00:01  Skipping 