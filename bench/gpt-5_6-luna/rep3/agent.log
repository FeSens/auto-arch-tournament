9:    .instr_bp_taken_i     (instr_bp_taken_id),\\n./cores/ibex/rtl/ibex_core.sv:581:    // Jumps and branches\\n./cores/ibex/rtl/ibex_core.sv:582:    .branch_decision_i(branch_decision),\\n./cores/ibex/rtl/ibex_core.sv:592:    .nt_branch_mispredict_o(nt_branch_mispredict),\\n./cores/ibex/rtl/ibex_core.sv:593:    .nt_branch_addr_o      (nt_branch_addr),\\n./cores/ibex/rtl/ibex_core.sv:711:    .perf_jump_o      (perf_jump),\\n./cores/ibex/rtl/ibex_core.sv:712:    .perf_branch_o    (perf_branch),\\n./cores/ibex/rtl/ibex_core.sv:713:    .perf_tbranch_o   (perf_tbranch),\\n./cores/ibex/rtl/ibex_core.sv:726:    .BranchTargetALU(BranchTargetALU)\\n./cores/ibex/rtl/ibex_core.sv:737:    // Branch target ALU signal from ID stage\\n./cores/ibex/rtl/ibex_core.sv:762:    .branch_target_o  (branch_target_ex),  // to IF\\n./cores/ibex/rtl/ibex_core.sv:763:    .branch_decision_o(branch_decision),  // to ID\\n./cores/ibex/rtl/ibex_core.sv:957:  // Crash dump output //\\n./cores/ibex/rtl/ibex_core.sv:960:  logic [31:0] crash_dump_mtval;\\n./cores/ibex/rtl/ibex_core.sv:961:  assign crash_dump_o.current_pc     = pc_id;\\n./cores/ibex/rtl/ibex_core.sv:962:  assign crash_dump_o.next_pc        = pc_if;\\n./cores/ibex/rtl/ibex_core.sv:963:  assign crash_dump_o.last_data_addr = lsu_addr_last;\\n./cores/ibex/rtl/ibex_core.sv:964:  assign crash_dump_o.exception_pc   = csr_mepc;\\n./cores/ibex/rtl/ibex_core.sv:965:  assign crash_dump_o.exception_addr = crash_dump_mtval;\\n./cores/ibex/rtl/ibex_core.sv:1108:    .csr_mtval_o      (crash_dump_mtval),\\n./cores/ibex/rtl/ibex_core.sv:1157:    .jump_i                     (perf_jump),\\n./cores/ibex/rtl/ibex_core.sv:1158:    .branch_i                   (perf_branch),\\n./cores/ibex/rtl/ibex_core.sv:1159:    .branch_taken_i             (perf_tbranch),\\n./cores/ibex/rtl/ibex_core.sv:1398:  // Factor in exceptions taken in ID so RVFI tracking picks up flushed instructions that took\\n./cores/ibex/rtl/ibex_core.sv:1462:  // trap taken depends upon the state of irq/debug_req/nmi on that cycle. In the cycles following\\n./cores/ibex/rtl/ibex_core.sv:1530:  // logic we won't tell the DV environment about a trap that should have been taken. So if there's\\n./cores/ibex/rtl/ibex_core.sv:1532:  // the DV environment will see if a trap should have been taken but wasn't.\\n./cores/ibex/rtl/ibex_core.sv:1649:            rvfi_stage_pc_wdata[i]                <= pc_set ? branch_target_ex : pc_if;\\n./cores/ibex/rtl/ibex_wb_stage.sv:155:    // Speculative versions of the signals do not factor in exceptions and whether the instruction\\n./cores/ibex/rtl/ibex_wb_stage.sv:207:    // The speculative signals are always 0 when no writeback stage is present as the raw counter\\n./cores/ibex/rtl/ibex_branch_predict.sv:6: * Branch Predictor\\n./cores/ibex/rtl/ibex_branch_predict.sv:8: * This implements static branch prediction. It takes an instruction and its PC and determines if\\n./cores/ibex/rtl/ibex_branch_predict.sv:9: * it's a branch or a jump and calculates its target. For jumps it will always predict taken. For\\n./cores/ibex/rtl/ibex_branch_predict.sv:10: * branches it will predict taken if the PC offset is negative.\\n./cores/ibex/rtl/ibex_branch_predict.sv:15: * The predictor is entirely combinational but takes clk/rst_n signals for use by assertions.\\n./cores/ibex/rtl/ibex_branch_predict.sv:20:module ibex_branch_predict (\\n./cores/ibex/rtl/ibex_branch_predict.sv:29:  // Prediction for supplied instruction\\n./cores/ibex/rtl/ibex_branch_predict.sv:30:  output logic        predict_branch_taken_o,\\n./cores/ibex/rtl/ibex_branch_predict.sv:31:  output logic [31:0] predict_branch_pc_o\\n./cores/ibex/rtl/ibex_branch_predict.sv:40:  logic [31:0] branch_imm;\\n./cores/ibex/rtl/ibex_branch_predict.sv:49:  logic instr_b_taken;\\n./cores/ibex/rtl/ibex_branch_predict.sv:68:  // Determine if the instruction is a branch or a jump\\n./cores/ibex/rtl/ibex_branch_predict.sv:70:  // Uncompressed branch/jump\\n./cores/ibex/rtl/ibex_branch