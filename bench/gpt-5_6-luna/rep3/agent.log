 [4:0] ALU_SLT    = 5'd5;\ncores/bench/rtl/core_pkg.sv:27:  localparam logic [4:0] ALU_SLTU   = 5'd6;\ncores/bench/rtl/core_pkg.sv:28:  localparam logic [4:0] ALU_SLL    = 5'd7;\ncores/bench/rtl/core_pkg.sv:29:  localparam logic [4:0] ALU_SRL    = 5'd8;\ncores/bench/rtl/core_pkg.sv:30:  localparam logic [4:0] ALU_SRA    = 5'd9;\ncores/bench/rtl/core_pkg.sv:31:  localparam logic [4:0] ALU_LUI    = 5'd10;\ncores/bench/rtl/core_pkg.sv:32:  localparam logic [4:0] ALU_MUL    = 5'd11;\ncores/bench/rtl/core_pkg.sv:33:  localparam logic [4:0] ALU_MULH   = 5'd12;\ncores/bench/rtl/core_pkg.sv:34:  localparam logic [4:0] ALU_MULHU  = 5'd13;\ncores/bench/rtl/core_pkg.sv:35:  localparam logic [4:0] ALU_MULHSU = 5'd14;\ncores/bench/rtl/core_pkg.sv:36:  localparam logic [4:0] ALU_DIV    = 5'd15;\ncores/bench/rtl/core_pkg.sv:37:  localparam logic [4:0] ALU_DIVU   = 5'd16;\ncores/bench/rtl/core_pkg.sv:38:  localparam logic [4:0] ALU_REM    = 5'd17;\ncores/bench/rtl/core_pkg.sv:39:  localparam logic [4:0] ALU_REMU   = 5'd18;\ncores/bench/rtl/core_pkg.sv:42:  // Phase 1 only references BR_BEQ (decoder default). The rest are\ncores/bench/rtl/core_pkg.sv:69:    logic       mem_to_reg;  // 1 = write loaded data, 0 = write ALU result\ncores/bench/rtl/core_pkg.sv:70:    logic       is_illegal;  // default-true in decoder; cleared inside\ncores/bench/rtl/core_pkg.sv:99:    logic [31:0] write_data;     // raw rs2 (post-forward), pre byte replication\ncores/bench/rtl/core_pkg.sv:103:    logic [31:0] rs1_val;        // post-forward rs1 used by EX\ncores/bench/rtl/core_pkg.sv:104:    logic [31:0] rs2_val;        // post-forward rs2 used by EX\ncores/bench/rtl/core_pkg.sv:117:    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)\ncores/bench/rtl/wb_stage.sv:4:// loaded-data path (mem_to_reg=1) and the ALU-result path. Drives the\ncores/bench/rtl/wb_stage.sv:5:// regfile write port; the regfile itself stalls on x0 and gates on\ncores/bench/rtl/core.sv:7://   |    +-----+