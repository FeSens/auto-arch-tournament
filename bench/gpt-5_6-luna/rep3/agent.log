{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '65,90p' Makefile; sed -n '1,130p' cores/bench/rtl/hazard_unit.sv; sed -n '1,380p' cores/bench/rtl/mem_stage.sv\"","aggregated_output":"  OBJ_DIR    := cores/$(TARGET)/obj_dir\n  GEN_DIR    := cores/$(TARGET)/generated\n  ORCH_TARGET_FLAG := --target $(TARGET)\n  # WORKTREE-mode paths (only consumed when WORKTREE= is set on `make loop`).\n  WT_BRANCH  := core-$(TARGET)\n  WT_PATH    := $(CURDIR)/.worktrees/$(TARGET)\nendif\n\nexport RTL_DIR CORE_NAME OBJ_DIR GEN_DIR\n\nhelp:\n\t@echo \"Targets (most accept TARGET=<core_name>):\"\n\t@echo \"  make lint TARGET=v1     — verilator lint over cores/<TARGET>/rtl/*.sv\"\n\t@echo \"  make test TARGET=v1     — cocotb unit tests under cores/<TARGET>/test/\"\n\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\n\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\n\t@echo \"  make formal-deep TARGET=v1 — full formal suite without ALTOPS (slow, bitvector-correct)\"\n\t@echo \"  make fpga TARGET=v1     — FPGA fitness eval (Fmax + CoreMark cycles)\"\n\t@echo \"  make bench              — build selftest + coremark ELFs\"\n\t@echo \"  make next TARGET=v1     — one orchestrator round\"\n\t@echo \"  make loop TARGET=v1 N=10 — N orchestrator rounds (auto-spawns .worktrees/<TARGET> on branch core-<TARGET>; pass WORKTREE= to opt out)\"\n\t@echo \"  make report TARGET=v1   — per-core experiment summary\"\n\t@echo \"  make clean TARGET=v1    — remove per-core build artifacts (use with TARGET=)\"\n\t@echo \"  make test-infra         — run orchestrator infra tests under tools/\"\n\t@echo \"\"\n\t@echo \"Available cores:\"\n// rtl/hazard_unit.sv\n//\n// Detects the only data hazard the textbook 5-stage doesn't cover via\n// forwarding: load-use. A LOAD in EX produces its data only after MEM,\n// so an instruction immediately behind that consumes the LOAD's rd\n// must be stalled by exactly one cycle.\n//\n// Outputs:\n//   stall_if / stall_id : freeze the PC reg and the IF/ID combinational\n//                          payload (cleared by ID's flush input).\n//   flush_if / flush_id : on EX redirect, kill the two in-flight\n//                          instructions ahead of the redirect target.\n//   flush_id            : also kills ID's own register on load-use to\n//                          inject a single-cycle bubble between LOAD\n//                          and the dependent instruction.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       redirect,          // EX has resolved a branch/jump\n  // Instruction-bus backpressure (default-1 in zero-wait testbenches;\n  // VexRiscv-style random ~22% stall in vex_main.cpp).\n  input  logic       imem_ready,\n  // MEM-stage completion.  This is high for cache-hit loads and for an\n  // accepted uncached/write-through operation, and low for a refill or a\n  // stalled external request.\n  input  logic       mem_complete,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_if,          // IF/ID comb output -> NOP\n  output logic       flush_id,          // ID/EX register captures '0\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic imem_stall;\n  logic dmem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_mem_read\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                   && (id_ex_rd != 5'b0);\n    imem_stall = !imem_ready;\n    // dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n    dmem_stall = !mem_complete && ex_mem_mem_op;\n\n    // PC reg holds on any stall reason.\n    stall_if      = load_use_hazard || imem_stall || dmem_stall;\n    // IF/ID combinational payload: NOP whenever we wouldn't have a valid\n    // instruction this cycle (redirect target unknown to IF, or imem\n    // didn't deliver).\n    flush_if      = redirect || imem_stall;\n    // ID/EX register:\n    //   - dmem_stall  -> hold        (preserve in-flight pipeline state)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    stall_id      = dmem_stall || load_use_hazard;\n    flush_id      = (load_use_hazard || redirect) && !dmem_stall;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n// rtl/mem_stage.sv\n//\n// Memory access stage with a deliberately small, blocking data cache.\n//\n// The cache is 256 bytes: sixteen direct-mapped lines, four words per line.\n// It is write-through and write-no-allocate.  Only the normal RAM window is\n// cached; UART/marker accesses and other addresses use the external port.\n// A miss holds the EX/MEM request and fills the line in four accepted beats.\n//\n// Latency:        1 cycle for a hit or accepted uncached access; four or more\n//                 external beats for a miss.\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata via the loaded-data path.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // The hazard unit asserts this while an external transaction/refill is\n  // incomplete.  As in the original stage, data fields are retained while\n  // valid is cleared so forwarding cannot observe a duplicate retirement.\n  input  logic               hold_wb,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t             in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  input  logic               dmem_ready,\n  // Completion is independent of dmem_ready for a cache-hit load.\n  output logic               mem_complete,\n  output mem_wb_t             out\n);\n\n  localparam logic [31:0] RAM_LIMIT   = 32'h0010_0000;\n  localparam logic [31:0] MMIO_BASE  = 32'h1000_0000;\n  localparam logic [31:0] MMIO_LIMIT = 32'h1000_0200;\n\n  // Cache geometry: address bits [3:2] select a word and [7:4] a line.\n  logic [23:0] tag_array   [0:15];\n  logic        valid_array [0:15];\n  logic [31:0] data_array  [0:63];\n\n  typedef enum logic [0:0] {REFILL_IDLE, REFILL_ACTIVE} refill_state_t;\n  refill_state_t refill_state_q;\n  logic [3:0]    refill_index_q;\n  logic [23:0]   refill_tag_q;\n  logic [31:0]   refill_base_q;\n  logic [1:0]    refill_word_q;\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] shifted;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [7:0]  byte_val;\n  logic [15:0] hword_val;\n  logic [31:0] load_data;\n\n  logic        mem_op;\n  logic        mem_misalign;\n  logic        normal_ram;\n  logic        mmio_access;\n  logic        cacheable;\n  logic        cache_hit;\n  logic        refill_last;\n  logic [3:0]  request_index;\n  logic [1:0]  request_word;\n  logic [23:0] request_tag;\n  logic [31:0] line_base;\n  logic [31:0] cache_word;\n  logic [31:0] store_mask_word;\n  logic [31:0] store_merged;\n  logic [31:0] response_word;\n  ctrl_t       ctrl_with_trap;\n\n  always_comb begin\n    // Byte/halfword replication for stores.  The mask, rather than this\n    // replication, determines which bytes are architecturally written.\n    case (in.ctrl.mem_width)\n      2'd0:    wdata_rep = {4{in.write_data[7:0]}};\n      2'd1:    wdata_rep = {2{in.write_data[15:0]}};\n      default: wdata_rep = in.write_data;\n    endcase\n\n    case (in.ctrl.mem_width)\n      2'd0:    byte_mask = (4'b0001 << in.alu_result[1:0]);\n      2'd1:    byte_mask = (4'b0011 << in.alu_result[1:0]);\n      default: byte_mask = 4'b1111;\n    endcase\n\n    mem_op = in.ctrl.mem_read || in.ctrl.mem_write;\n    // Word accesses require two low address bits clear; halfword accesses\n    // require bit zero clear.  This happens before cache lookup.\n    mem_misalign = mem_op && (\n                     (in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\n                     (in.ctrl.mem_width == 2'd1 && in.alu_result[0]   != 1'b0)\n                   );\n\n    normal_ram  = in.alu_result < RAM_LIMIT;\n    mmio_access = (in.alu_result >= MMIO_BASE) &&\n                  (in.alu_result <  MMIO_LIMIT);\n    cacheable   = mem_op && !mem_misalign && normal_ram && !mmio_access;\n\n    request_index = in.alu_result[7:4];\n    request_word  = in.alu_result[3:2];\n    request_tag   = in.alu_result[31:8];\n    line_base     = {in.alu_result[31:4], 4'b0};\n    cache_word    = data_array[{request_index, request_word}];\n    cache_hit     = cacheable && valid_array[request_index] &&\n                    (tag_array[request_index] == request_tag);\n\n    // Expand the byte mask once for a hit-store merge.  The cache update and\n    // the external write-through use exactly the same byte mask.\n    store_mask_word = 32'b0;\n    for (int b = 0; b < 4; b++) begin\n      if (byte_mask[b]) store_mask_word[b*8 +: 8] = 8'hff;\n    end\n    store_merged = (cache_word & ~store_mask_word) |\n                   (wdata_rep  &  store_mask_word);\n\n    // During refill, earlier beats are already in the cache array.  For the\n    // beat currently on the external bus, use dmem_rdata directly so the\n    // final word is available in the same cycle that completes the miss.\n    response_word = dmem_rdata;\n    if (refill_state_q == REFILL_ACTIVE) begin\n      if (request_word == refill_word_q)\n        response_word = dmem_rdata;\n      else\n        response_word = data_array[{refill_index_q, request_word}];\n    end else if (cache_hit) begin\n      response_word = cache_word;\n    end\n\n    shifted   = response_word >> (in.alu_result[1:0] * 8);\n    byte_val  = shifted[7:0];\n    hword_val = shifted[15:0];\n    case (in.ctrl.mem_width)\n      2'd0:    load_data = in.ctrl.mem_sext\n                         ? {{24{byte_val[7]}},  byte_val}\n                         : {24'b0,              byte_val};\n      2'd1:    load_data = in.ctrl.mem_sext\n                         ? {{16{hword_val[15]}}, hword_val}\n                         : {16'b0,               hword_val};\n      default: load_data = response_word;\n    endcase\n\n    ctrl_with_trap = in.ctrl;\n    if (mem_misalign) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n\n    // The external request is line-oriented only for a cache refill.  A\n    // hit produces no request at all, which is the key locality benefit.\n    dmem_addr  = in.alu_result;\n    dmem_wdata = wdata_rep;\n    dmem_wen   = 4'b0;\n    dmem_ren   = 1'b0;\n    if (refill_state_q == REFILL_ACTIVE) begin\n      dmem_addr = refill_base_q + {28'b0, refill_word_q, 2'b0};\n      dmem_ren  = 1'b1;\n    end else if (cacheable && in.ctrl.mem_read && !cache_hit) begin\n      // The first refill beat is presented while the FSM is still idle.\n      dmem_addr = line_base;\n      dmem_ren  = 1'b1;\n    end else if (in.ctrl.mem_write && !mem_misalign && !cache_hit) begin\n      // Store misses are write-through/no-write-allocate.  Store hits also\n      // come here because the external write must be accepted before retire.\n      dmem_wen = byte_mask;\n    end else if (in.ctrl.mem_write && !mem_misalign && cache_hit) begin\n      dmem_wen = byte_mask;\n    end else if (in.ctrl.mem_read && !mem_misalign && !cache_hit &&\n                 (!cacheable || !normal_ram || mmio_access)) begin\n      dmem_ren = 1'b1;\n    end\n\n    // An aligned normal-RAM load hit is complete without the bus.  All\n    // other memory operations complete only when their one bus request is\n    // accepted, except a refill which ends on beat three.\n    refill_last = (refill_state_q == REFILL_ACTIVE) &&\n                  (refill_word_q == 2'd3);\n    if (!mem_op || mem_misalign) begin\n      mem_complete = 1'b1;\n    end else if (refill_state_q == REFILL_ACTIVE) begin\n      mem_complete = refill_last && dmem_ready;\n    end else if (in.ctrl.mem_read && cache_hit) begin\n      mem_complete = 1'b1;\n    end else if (cacheable && in.ctrl.mem_read && !cache_hit) begin\n      // A ready beat zero starts a four-beat refill; it is not yet the\n      // architectural load completion.\n      mem_complete = 1'b0;\n    end else begin\n      mem_complete = dmem_ready;\n    end\n\n    aligned_addr = (mem_op && !mem_misalign)\n                 ? {in.alu_result[31:2], 2'b00}\n                 : 32'b0;\n  end\n\n  // ── Cache and refill state ─────────────────────────────────────────────\n  // The EX/MEM request remains unchanged for the entire active refill.  A\n  // miss starts by accepting beat zero while idle, then advances one word\n  // per ready cycle.  The line is made valid only after all four beats have\n  // arrived, preventing a partially filled line from being observed.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      refill_state_q <= REFILL_IDLE;\n      refill_index_q <= 4'b0;\n      refill_tag_q   <= 24'b0;\n      refill_base_q  <= 32'b0;\n      refill_word_q  <= 2'b0;\n      for (int i = 0; i < 16; i++) begin\n        valid_array[i] <= 1'b0;\n        tag_array[i]   <= 24'b0;\n      end\n      for (int j = 0; j < 64; j++) begin\n        data_array[j] <= 32'b0;\n      end\n    end else if (refill_state_q == REFILL_ACTIVE) begin\n      if (dmem_ready) begin\n        data_array[{refill_index_q, refill_word_q}] <= dmem_rdata;\n        if (refill_word_q == 2'd3) begin\n          tag_array[refill_index_q]   <= refill_tag_q;\n          valid_array[refill_index_q] <= 1'b1;\n          refill_state_q              <= REFILL_IDLE;\n          refill_word_q               <= 2'b0;\n        end else begin\n          refill_word_q <= refill_word_q + 2'd1;\n        end\n      end\n    end else if (cacheable && in.ctrl.mem_read && !cache_hit && dmem_ready) begin\n      // Beat zero is accepted directly from the idle miss request.\n      data_array[{request_index, 2'd0}] <= dmem_rdata;\n      refill_state_q <= REFILL_ACTIVE;\n      refill_index_q <= request_index;\n      refill_tag_q   <= request_tag;\n      refill_base_q  <= line_base;\n      refill_word_q  <= 2'd1;\n    end else if (cacheable && in.ctrl.mem_write && cache_hit && dmem_ready) begin\n      // Write-through hit update.  A miss deliberately does not allocate.\n      data_array[{request_index, request_word}] <= store_merged;\n    end\n  end\n\n  // ── MEM/WB register ────────────────────────────────────────────────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (hold_wb) begin\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.alu_result <= in.alu_result;\n      reg_q.read_data  <= load_data;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= response_word;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0;\n      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
