h_set      = branch_set_raw      & ~branch_jump_set_done_q;\\n./cores/ibex/rtl/ibex_id_stage.sv:721:  // Branch condition is calculated in the first cycle and flopped for use in the second cycle\\n./cores/ibex/rtl/ibex_id_stage.sv:722:  // (only used in fixed time execution mode to determine branch destination).\\n./cores/ibex/rtl/ibex_id_stage.sv:723:  if (DataIndTiming) begin : g_sec_branch_taken\\n./cores/ibex/rtl/ibex_id_stage.sv:725:    logic branch_taken_q;\\n./cores/ibex/rtl/ibex_id_stage.sv:729:        branch_taken_q <= 1'b0;\\n./cores/ibex/rtl/ibex_id_stage.sv:731:        branch_taken_q <= branch_decision_i;\\n./cores/ibex/rtl/ibex_id_stage.sv:735:    assign branch_taken = ~data_ind_timing_i | branch_taken_q;\\n./cores/ibex/rtl/ibex_id_stage.sv:737:  end else begin : g_nosec_branch_taken\\n./cores/ibex/rtl/ibex_id_stage.sv:739:    // Signal unused without fixed time execution mode - only taken branches will trigger\\n./cores/ibex/rtl/ibex_id_stage.sv:740:    // branch_set_raw\\n./cores/ibex/rtl/ibex_id_stage.sv:741:    assign branch_taken = 1'b1;\\n./cores/ibex/rtl/ibex_id_stage.sv:745:  // Holding branch_set/jump_set high for more than one cycle should not cause a functional issue.\\n./cores/ibex/rtl/ibex_id_stage.sv:747:  // designs ensures that this never happens for non-predicted branches.\\n./cores/ibex/rtl/ibex_id_stage.sv:748:  `ASSERT(NeverDoubleBranch, branch_set & ~instr_bp_taken_i |=> ~branch_set)\\n./cores/ibex/rtl/ibex_id_stage.sv:749:  `ASSERT(NeverDoubleJump, jump_set & ~instr_bp_taken_i |=> ~jump_set)\\n./cores/ibex/rtl/ibex_id_stage.sv:752:  // Branch not-taken address //\\n./cores/ibex/rtl/ibex_id_stage.sv:755:  if (BranchPredictor) begin : g_calc_nt_addr\\n./cores/ibex/rtl/ibex_id_stage.sv:756:    assign nt_branch_addr_o = pc_id_i + (instr_is_compressed_i ? 32'd2 : 32'd4);\\n./cores/ibex/rtl/ibex_id_stage.sv:758:    assign nt_branch_addr_o = 32'd0;\\n./cores/ibex/rtl/ibex_id_stage.sv:785:    stall_jump              = 1'b0;\\n./cores/ibex/rtl/ibex_id_stage.sv:786:    stall_branch            = 1'b0;\\n./cores/ibex/rtl/ibex_id_stage.sv:788:    branch_set_raw_d        = 1'b0;\\n./cores/ibex/rtl/ibex_id_stage.sv:789:    branch_not_set          = 1'b0;\\n./cores/ibex/rtl/ibex_id_stage.sv:790:    jump_set_raw            = 1'b0;\\n./cores/ibex/rtl/ibex_id_stage.sv:791:    perf_branch_o           = 1'b0;\\n./cores/ibex/rtl/ibex_id_stage.sv:817:            branch_in_dec: begin\\n./cores/ibex/rtl/ibex_id_stage.sv:818:              // cond branch operation\\n./cores/ibex/rtl/ibex_id_stage.sv:819:              // All branches take two cycles in fixed time execution mode, regardless of branch\\n./cores/ibex/rtl/ibex_id_stage.sv:822:              id_fsm_d         = (data_ind_timing_i || (!BranchTargetALU && branch_decision_i)) ?\\n./cores/ibex/rtl/ibex_id_stage.sv:824:              stall_branch     = (~BranchTargetALU & branch_decision_i) | data_ind_timing_i;\\n./cores/ibex/rtl/ibex_id_stage.sv:825:              branch_set_raw_d = (branch_decision_i | data_ind_timing_i);\\n./cores/ibex/rtl/ibex_id_stage.sv:827:              if (BranchPredictor) begin\\n./cores/ibex/rtl/ibex_id_stage.sv:828:                branch_not_set = ~branch_decision_i;\\n./cores/ibex/rtl/ibex_id_stage.sv:831:              perf_branch_o = 1'b1;\\n./cores/ibex/rtl/ibex_id_stage.sv:833:            jump_in_dec: begin\\n./cores/ibex/rtl/ibex_id_stage.sv:834:              // uncond branch operation\\n./cores/ibex/rtl/ibex_id_stage.sv:835:              // BTALU means jumps only need one cycle\\n./cores/ibex/rtl/ibex_id_stage.sv:836:              id_fsm_d      = BranchTargetALU ? FIRST_CYCLE : MULTI_CYCLE;\\n./cores/ibex/rtl/ibex_id_stage.sv:837:              stall_jump    = ~BranchTargetALU;\\n./cores/ibex/rtl/ibex_id_stage.sv:838:              jump_set_raw  = jump_set_dec;\\n./cores/ibex/rtl/ibex_id_stage.sv:860:            stall_branch    = branch_in_dec;\\n./cores/ibex/rtl/ibex_id_stage.sv:861:            stall_jump      = jump_in_dec;\\n./cores