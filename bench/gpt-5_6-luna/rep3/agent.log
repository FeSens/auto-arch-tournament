input  logic                        icache_enable_i,\ncores/ibex/rtl/ibex_if_stage.sv:107:  input  logic                        icache_inval_i,\ncores/ibex/rtl/ibex_if_stage.sv:108:  output logic                        icache_ecc_error_o,\ncores/ibex/rtl/ibex_if_stage.sv:265:  // The fetch_valid signal that comes out of the icache or prefetch buffer should be squashed if we\ncores/ibex/rtl/ibex_if_stage.sv:273:  if (ICache) begin : gen_icache\ncores/ibex/rtl/ibex_if_stage.sv:275:    ibex_icache #(\ncores/ibex/rtl/ibex_if_stage.sv:282:    ) icache_i (\ncores/ibex/rtl/ibex_if_stage.sv:318:        .icache_enable_i     ( icache_enable_i            ),\ncores/ibex/rtl/ibex_if_stage.sv:319:        .icache_inval_i      ( icache_inval_i             ),\ncores/ibex/rtl/ibex_if_stage.sv:321:        .ecc_error_o         ( icache_ecc_error_o         )\ncores/ibex/rtl/ibex_if_stage.sv:324:    // prefetch buffer, caches a fixed number of instructions\ncores/ibex/rtl/ibex_if_stage.sv:356:    assign unused_icen           = icache_enable_i;\ncores/ibex/rtl/ibex_if_stage.sv:357:    assign unused_icinv          = icache_inval_i;\ncores/ibex/rtl/ibex_if_stage.sv:370:    assign icache_ecc_error_o    = 'b0;\ncores/ibex/rtl/ibex_if_stage.sv:373:    // If we don't instantiate an icache and this is a simulation then we have a problem because the\ncores/ibex/rtl/ibex_if_stage.sv:374:    // simulator might discard the icache module entirely, including some DPI exports that it\ncores/ibex/rtl/ibex_if_stage.sv:742:     * Checks for branch prediction interface to fetch_fifo/icache\ncores/ibex/rtl/ibex_if_stage.sv:754:     *   branch_mispredict_i this indicates the fetch_fifo/icache has the not-taken side of the\ncores/ibex/rtl/ibex_if_stage.sv:808:    // prefetch buffer/icache makes that PC available.\ncores/ibex/rtl/ibex_if_stage.sv:813:    // mispredicts for different branches (core signals mispredict, prefetch buffer/icache immediate\ncores/ibex/rtl/ibex_core.sv:211:  logic        icache_enable