gpt-5_6-luna-rep3/cores/bench/worktrees/hyp-20260710-003-r2s2/formal/last_run-86536.log\\nPer-check logs in: /Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_6-luna-rep3/cores/bench/worktrees/hyp-20260710-003-r2s2/formal/riscv-formal/cores/bench-86536/checks/<check>/logfile.txt\", \"slot\": 2, \"round_id\": 2, \"lesson\": \"- 2026-07-10 hyp-20260710-003-r2s2 (broken, n/a): A PC-indexed BTB must carry prediction-valid/next-PC metadata atomically with the fetched instruction and reconcile it with EX `resolved_next_pc` and RVFI `pc_wdata`, or redirect recovery can break `pc_fwd` even when instruction checks pass.\"}\n","exit_code":0,"status":"completed"}}
