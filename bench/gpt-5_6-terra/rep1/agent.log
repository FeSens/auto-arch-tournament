itness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add ID/EX metadata marking a direct JAL whose fetch redirect was accepted in decode.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Recognize valid direct JAL instructions, form the PC-relative target, and emit an acceptance-qualified early-redirect request while latching its metadata.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Separate PC-update redirect selection from EX wrong-path output squashing so an accepted decode-stage JAL is retained while the PC advances to its target.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Suppress only the duplicate EX redirect for a JAL already redirected in decode; retain JAL result, RVFI pc_wdata, JALR, and branch behavior.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Expose or qualify the ID acceptance condition so early JAL redirection cannot occur while ID/EX is held or an older EX redirect squashes it.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Arbitrate older EX recovery ahead of an accepted decode-stage JAL redirect and wire the split fetch-control paths without changing the nret=1 interface.\"}, {\"file\": \"test/test_core.py\", \"description\": \"Add directed JAL call/return, consecutive JAL, load-use hold, dmem-stall, and simultaneous older-redirect cases that check RVFI PC order and return-address writes.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add ID/EX metadata marking a direct JAL whose fetch redirect was accepted in decode.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Recognize valid direct JAL instructions, form the PC-relative target, and emit an acceptance-qualified early-redirect request while latching its metadata.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Separate PC-update redirect selection from EX wrong-path out