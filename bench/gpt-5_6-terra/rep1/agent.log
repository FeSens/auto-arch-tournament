ctural sources. This removes false bubbles without changing the\\\\\\\\nPC, memory, RVFI, or arithmetic critical paths.\\\\\\\\n\\\\\\\", \\\\\\\"expected_impact\\\\\\\": {\\\\\\\"fitness_delta_pct\\\\\\\": 5, \\\\\\\"confidence\\\\\\\": \\\\\\\"medium\\\\\\\"}, \\\\\\\"changes\\\\\\\": [{\\\\\\\"file\\\\\\\": \\\\\\\"rtl/hazard_unit.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Gate each load-use register comparison with decode-derived rs1/rs2 use bits, retaining existing redirect and bus-stall priority.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/core.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Derive and connect IF/ID source-use classification signals to the hazard unit without altering the nret=1 interface.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"test/test_hazard_unit.py\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Add directed cases proving real load dependencies stall once while immediate and no-source encodings with matching bit fields do not stall.\\\\\\\"}]}, \\\\\\\"expected_impact\\\\\\\": {\\\\\\\"fitness_delta_pct\\\\\\\": 5, \\\\\\\"confidence\\\\\\\": \\\\\\\"medium\\\\\\\"}, \\\\\\\"changes\\\\\\\": [{\\\\\\\"file\\\\\\\": \\\\\\\"rtl/hazard_unit.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Gate each load-use register comparison with decode-derived rs1/rs2 use bits, retaining existing redirect and bus-stall priority.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/core.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Derive and connect IF/ID source-use classification signals to the hazard unit without altering the nret=1 interface.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"test/test_hazard_unit.py\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Add directed cases proving real load dependencies stall once while immediate and no-source encodings with matching bit fields do not stall.\\\\\\\"}], \\\\\\\"outcome\\\\\\\": \\\\\\\"broken\\\\\\\", \\\\\\\"formal_passed\\\\\\\": false, \\\\\\\"cosim_passed\\\\\\\": false, \\\\\\\"error\\\\\\\": \\\\