ce\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/branch_predictor.sv\\\", \\\"description\\\": \\\"Add a compact direct-mapped BTB with registered PC+4 lookup responses, query-PC tags, valid bits, and resolved-branch-only target/direction training.\\\"}, {\\\"file\\\": \\\"rtl/core_pkg.sv\\\", \\\"description\\\": \\\"Extend fetch and pipeline payloads with predicted-next-PC, prediction-valid, and fetch-PC metadata needed to prove response alignment.\\\"}, {\\\"file\\\": \\\"rtl/if_stage.sv\\\", \\\"description\\\": \\\"Consume a registered prediction only on an exact current-PC match, issue the next sequential lookahead query, and invalidate stale responses on redirect or non-sequential flow.\\\"}, {\\\"file\\\": \\\"rtl/id_stage.sv\\\", \\\"description\\\": \\\"Latch prediction metadata only with an accepted IF instruction so ID/EX cannot pair a branch with a different lookup response.\\\"}, {\\\"file\\\": \\\"rtl/ex_stage.sv\\\", \\\"description\\\": \\\"Compare the resolved architectural next PC with the carried prediction, redirect only on mismatch, and expose precisely qualified conditional-branch BTB training events.\\\"}, {\\\"file\\\": \\\"rtl/hazard_unit.sv\\\", \\\"description\\\": \\\"Define predictor-response hold and invalidation priority for load-use, bus, divider, and EX redirect events without changing their existing retirement behavior.\\\"}, {\\\"file\\\": \\\"rtl/core.sv\\\", \\\"description\\\": \\\"Wire predictor lookup, response-valid alignment, EX training, and misprediction recovery while retaining the nret=1 external contract.\\\"}, {\\\"file\\\": \\\"test/test_predictor.py\\\", \\\"description\\\": \\\"Add checks for sequential lookahead hits, taken-loop and final-exit recovery, redirect-stale-response suppression, imem stalls, and RVFI PC-order correctness.\\\"}]}, \\\"expected_impact\\\": {\\\"fitness_delta_pct\\\": 5, \\\"confidence\\\": \\\"medium\\\"}, \\\"changes\\\": [{\\\"file\\\": \\\"rtl/branch_predictor.sv\\\", 