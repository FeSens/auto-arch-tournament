ion\": \"Add a small tagged, direct-mapped two-bit-counter BTB whose lookup response is registered from a PC+4 lookahead query and whose entries train only on resolved valid conditional branches.\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add predicted-next-PC metadata to the IF/ID and downstream payloads so execution can verify the fetch decision precisely.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Issue the sequential PC+4 predictor query and select the next fetch PC from the registered response when it matches the current fetch PC, without flushing the correctly delivered predicted branch.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Latch the fetch packet's predicted next PC with the decoded instruction.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Compare resolved control-flow next PC against the carried prediction, emit redirects only for mismatches, and expose valid conditional-branch training fields.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Use prediction mismatch as the control flush event while preserving existing load-use, divide, and bus-stall priority rules.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Instantiate and wire the registered lookahead predictor, predictor metadata, branch training, and mismatch recovery without changing the nret=1 top-level contract.\"}, {\"file\": \"test/test_predictor.py\", \"description\": \"Add directed tests for sequential lookahead warm-up, repeated taken loops, final not-taken exits, target-entry misses after redirects, aliases, and bus-stall/RVFI correctness.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Add a small tagged, direct-mapped two-bit-counter BTB whose lookup response is registered from a PC+4 lookahead query and whose entries train only on resolved valid conditional branches.\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \