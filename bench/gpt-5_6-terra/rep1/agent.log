file\"=>\"rtl/if_stage.sv\", \"description\"=>\"Implement a one-entry stall-aware IF/ID register whose fill, dequeue, predicted redirect, EX recovery, and invalidation follow one atomic acceptance protocol.\"}, {\"file\"=>\"rtl/id_stage.sv\", \"description\"=>\"Detect valid backward conditional branches from the registered payload, form their target, and emit prediction only when the payload advances into ID/EX.\"}, {\"file\"=>\"rtl/ex_stage.sv\", \"description\"=>\"Carry qualified branch prediction metadata and recover only a resolved predicted branch whose direction or target disagrees.\"}, {\"file\"=>\"rtl/hazard_unit.sv\", \"description\"=>\"Define ready/hold and redirect precedence so load-use, bus stalls, divider ownership, prediction, and EX recovery cannot consume or retain a wrong-path fetch entry.\"}, {\"file\"=>\"rtl/core.sv\", \"description\"=>\"Wire the atomic fetch transaction, prediction metadata, and EX recovery while preserving the existing single-retire RVFI interface.\"}, {\"file\"=>\"test/test_predictor.py\", \"description\"=>\"Add directed loop, final-exit, forward-branch, imem/dmem-stall, and divide-hold tests that verify no sequential payload retires after a predicted redirect.\"}]}\n","exit_code":0,"status":"completed"}}
