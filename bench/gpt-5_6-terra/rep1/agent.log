result[1:0]);\ncores/bench/rtl/mem_stage.sv:78:      2'd1:    byte_mask = (4'b0011 << in.alu_result[1:0]);\ncores/bench/rtl/mem_stage.sv:84:                     (in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\ncores/bench/rtl/mem_stage.sv:85:                     (in.ctrl.mem_width == 2'd1 && in.alu_result[0]   != 1'b0)\ncores/bench/rtl/mem_stage.sv:96:    dmem_addr  = in.alu_result;\ncores/bench/rtl/mem_stage.sv:102:    shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\ncores/bench/rtl/mem_stage.sv:117:                 ? {in.alu_result[31:2], 2'b00}\ncores/bench/rtl/mem_stage.sv:135:      reg_q.alu_result <= in.alu_result;\ncores/bench/rtl/00_core_pkg_first.sv:2:// Ordered simulation/formal source lists still pass core_pkg.sv explicitly;\ncores/bench/rtl/core.sv:145:    .fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\ncores/bench/rtl/reg_file.sv:8://     the new value. This matches the prior Chisel core's RegFile.scala\ncores/bench/rtl/forward_unit.sv:4:// where the freshest value lives:\ncores/bench/rtl/forward_unit.sv:6://   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\ncores/bench/rtl/alu.sv:1:// rtl/alu.sv\ncores/bench/rtl/alu.sv:3:// RV32IM combinational ALU.  Multiply remains on the one-cycle EX path;\ncores/bench/rtl/alu.sv:10:module alu (\ncores/bench/rtl/alu.sv:19:  // All RV32M multiply variants share this one 33x33 two's-complement\ncores/bench/rtl/alu.sv:22:  // product for every variant, while MUL and the three high-half operations\ncores/bench/rtl/alu.sv:24:  logic signed [32:0] mul_a;\ncores/bench/rtl/alu.sv:25:  logic signed [32:0] mul_b;\ncores/bench/rtl/alu.sv:27:  // the full 66-bit product are intentionally not routed to an ALU result.\ncores/bench/rtl/alu.sv:29:  logic signed [65:0] mul_product;\ncores/bench/rtl/alu.sv:35:    // MUL's low half does not depend on signedness; sign-extending both\ncores/bench/rtl/alu.sv:36:    // operands lets it share the same selected datapath as MULH.\ncores/bench/rtl/alu.sv:38:      ALU_MUL, ALU_MULH: begin\ncores/bench/rtl/alu.sv:39:        mul_a = {a[31], a};\ncores/bench/rtl/alu.sv:40:        mul_b = {b[31], b};\ncores/bench/rtl/alu.sv:42:      ALU_MULHU: begin\ncores/bench/rtl/alu.sv:43:        mul_a = {1'b0, a};\ncores/bench/rtl/alu.sv:44:        mul_b = {1'b0, b};\ncores/bench/rtl/alu.sv:46:      ALU_MULHSU: begin\ncores/bench/rtl/alu.sv:47:        mul_a = {a[31], a};\ncores/bench/rtl/alu.sv:48:        mul_b = {1'b0, b};\ncores/bench/rtl/alu.sv:51:        mul_a = 33'b0;\ncores/bench/rtl/alu.sv:52:        mul_b = 33'b0;\ncores/bench/rtl/alu.sv:55:    mul_product = mul_a * mul_b;\ncores/bench/rtl/alu.sv:58:      ALU_ADD:    out = a + b;\ncores/bench/rtl/alu.sv:59:      ALU_SUB:    out = a - b;\ncores/bench/rtl/alu.sv:60:      ALU_AND:    out = a & b;\ncores/bench/rtl/alu.sv:61:      ALU_OR:     out = a | b;\ncores/bench/rtl/alu.sv:62:      ALU_XOR:    out = a ^ b;\ncores/bench/rtl/alu.sv:63:      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\ncores/bench/rtl/alu.sv:64:      ALU_SLTU:   out = {31'b0, a < b};\ncores/bench/rtl/alu.sv:65:      ALU_SLL:    out = a << shamt;\ncores/bench/rtl/alu.sv:66:      ALU_SRL:    out = a >> shamt;\ncores/bench/rtl/alu.sv:67:      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\ncores/bench/rtl/alu.sv:68:      ALU_LUI:    out = b;\ncores/bench/rtl/alu.sv:77:      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\ncores/bench/rtl/alu.sv:78:      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\ncores/bench/rtl/alu.sv:79:      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\ncores/bench/rtl/alu.sv:80:      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\ncores/bench/rtl/alu.sv:81:      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\ncores/bench/rtl/alu.sv:82:      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\ncores/bench/rtl/alu.sv:83:      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\ncores/bench/rtl/alu.sv:84:      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\ncores/bench/rtl/alu.sv:86:      ALU_MUL:    out = mul_product[31:0];\ncores/bench/rtl/alu.sv:87:      ALU_MULH:   out = mul_product[63:32];\ncores/bench/rtl/alu.sv:88:      ALU_MULHU:  out = mul_product[63:32];\ncores/bench/rtl/alu.sv:89:      ALU_MULHSU: out = mul_product[63:32];\ncores/bench/rtl/alu.sv:91:      // substitutions. These values are never committed by EX.\ncores/bench/rtl/alu.sv:92:      ALU_DIV,\ncores/bench/rtl/alu.sv:93:      ALU_DIVU,\ncores/bench/rtl/alu.sv:94:      ALU_REM,\ncores/bench/rtl/alu.sv:95:      ALU_REMU: out = 32'b0;\ncores/bench/rtl/core_pkg.sv:20:  // ── ALU operations ──────────────────────────────────────────────────────\ncores/bench/rtl/core_pkg.sv:21:  localparam logic [4:0] ALU_ADD    = 5'd0;\ncores/bench/rtl/core_pkg.sv:22:  localparam logic [4:0] ALU_SUB    = 5'd1;\ncores/bench/rtl/core_pkg.sv:23:  localparam logic [4:0] ALU_AND    = 5'd2;\ncores/bench/rtl/core_pkg.sv:24:  localparam logic [4:0] ALU_OR     = 5'd3;\ncores/bench/rtl/core_pkg.sv:25:  localparam logic [4:0] ALU_XOR    = 5'd4;\ncores/bench/rtl/core_pkg.sv:26:  localparam logic [4:0] ALU_SLT    = 5'd5;\ncores/bench/rtl/core_pkg.sv:27:  localparam logic [4:0] ALU_SLTU   = 5'd6;\ncores/bench/rtl/core_pkg.sv:28:  localparam logic [4:0] ALU_SLL    = 5'd7;\ncores/bench/rtl/core_pkg.sv:29:  localparam logic [4:0] ALU_SRL    = 5'd8;\ncores/bench/rtl/core_pkg.sv:30:  localparam logic [4:0] ALU_SRA    = 5'd9;\ncores/bench/rtl/core_pkg.sv:31:  localparam logic [4:0] ALU_LUI    = 5'd10;\ncores/bench/rtl/core_pkg.sv:32:  localparam logic [4:0] ALU_MUL    = 5'd11;\ncores/bench/rtl/core_pkg.sv:33:  localparam logic [4:0] ALU_MULH   = 5'd12;\ncores/bench/rtl/core_pkg.sv:34:  localparam logic [4:0] ALU_MULHU  = 5'd13;\ncores/bench/rtl/core_pkg.sv:35:  localparam logic [4:0] ALU_MULHSU = 5'd14;\ncores/bench/rtl/core_pkg.sv:36:  localparam logic [4:0] ALU_DIV    = 5'd15;\ncores/bench/rtl/core_pkg.sv:37:  localparam logic [4:0] ALU_DIVU   = 5'd16;\ncores/bench/rtl/core_pkg.sv:38:  localparam logic [4:0] ALU_REM    = 5'd17;\ncores/bench/rtl/core_pkg.sv:39:  localparam logic [4:0] ALU_REMU   = 5'd18;\ncores/bench/rtl/core_pkg.sv:56:    logic [4:0] alu_op;\ncores/bench/rtl/core_pkg.sv:57:    logic       alu_src;     // 0 = rs2 value, 1 = immediate\ncores/bench/rtl/core_pkg.sv:69:    logic       mem_to_reg;  // 1 = write loaded data, 0 = write ALU result\ncores/bench/rtl/core_pkg.sv:98:    logic [31:0] alu_result;\ncores/bench/rtl/core_pkg.sv:116:    logic [31:0] alu_result;\ncores/bench/rtl/wb_stage.sv:4:// loaded-data path (mem_to_reg=1) and the ALU-result path. Drives the\ncores/bench/rtl/wb_stage.sv:11:  // mem_wb_t fields beyond reg_write/rd/mem_to_reg/read_data/alu_result\ncores/bench/rtl/wb_stage.sv:24:    w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;\n\nbaseline-bench-2d60805\n\nNOTES:\n\n\nhyp-20260710-001-r1s0\nReplace the unconditional signed-signed, unsigned-unsigned, and\nsigned-unsigned product expressions with one shared 33x33 unsigned modular\nmultiplier. Select the operands' sign extension from the decoded multiply\noperation, then select bits [31:0] for MUL or [63:32] for MULH, MULHU, and\nMULHSU. The low 64 bits of the 33-bit two's-complement product preserve all\nRV32M result definitions, while removing two large parallel multiplier\ncones. Keep the RISCV_FORMAL_ALTOPS expressions unchanged.\n\nNOTES:\n\n\nhyp-20260710-001-r2s0\nReplace the sign-selected 33x33 multiplier with one unsigned 32x32 product.\nUse its low half directly for MUL and its high half for MULHU. For MULH,\nsubtract operand b from the unsigned high half when a is negative and\nsubtract operand a when b is negative; for MULHSU subtract b when a is\nnegative. These modulo-2^32 corrections exactly implement the signed\nproducts while avoiding sign-extension bits in the multiplier. Preserve the\nRISCV_FORMAL_ALTOPS operations and all division/reminder behavior.\n\nNOTES:\n\n\nhyp-20260710-001-r3s0\nPreserve the validated sign-selected 33x33 multiply arithmetic, but move it\ninto a small registered blocking multiplier unit. On an RV32M multiply,\nEX snapshots the fully forwarded operands and operation, stalls younger\nissue while the unit produces the selected half, then injects one normal\nEX/MEM result. Ordinary add, logic, shift, address, and branch operations\nbypass the multiplier entirely. This trades a short fixed latency only for\nmultiply instructions for a shorter and less congested common EX timing\npath, analogous to the successful divide isolation without using the\nregressive unsigned correction network.\n\nNOTES:\n\n\nhyp-20260710-001-r4s0\nMake the load-use hazard detector aware of whether the IF/ID opcode actually\nconsumes rs1 and/or rs2. Preserve the one-cycle interlock for real dependent\nconsumers, while suppressing it for operand-immediate ALU operations, loads,\nJAL, LUI, AUIPC, FENCE, EBREAK, and illegal encodings whose bit fields are\nnot architectural sources. This removes false bubbles without changing the\nPC, memory, RVFI, or arithmetic critical paths.\n\nNOTES:\n\n\nhyp-20260710-001-r5s0\nReplace the raw-field load-use comparison with an exhaustive, opcode-local\nsource-use table in the hazard unit. Classify rs1 as live only for OP,\nOP-IMM, LOAD, STORE, BRANCH, and JALR, and rs2 only for OP, STORE, and\nBRANCH; gate the corresponding comparisons with these bits and IF/ID valid.\nKeep every true one-cycle load dependency stalled, including all RV32M OP\noperations, branches, stores, and JALR. This removes false bubbles without\nadding work to the fetch or EX arithmetic timing paths.\n\nNOTES:\n\n","exit_code":0,"status":"completed"}}
