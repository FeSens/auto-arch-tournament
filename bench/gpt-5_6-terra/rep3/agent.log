\\\": 2}\\\\n7:{\\\\\\\"id\\\\\\\": \\\\\\\"hyp-20260711-003-r2s2\\\\\\\", \\\\\\\"title\\\\\\\": \\\\\\\"Committed return-stack JALR predictor\\\\\\\", \\\\\\\"category\\\\\\\": \\\\\\\"predictor\\\\\\\", \\\\\\\"motivation\\\\\\\": \\\\\\\"The current BHT eliminates the repeated recovery bubbles for direct branches\\\\\\\\nand JALs, but every function return remains an unpredicted JALR. CoreMark's\\\\\\\\nsmall routines execute many call and return pairs, making return recovery a\\\\\\\\nconcentrated remaining front-end cost.\\\\\\\\n\\\\\\\", \\\\\\\"hypothesis\\\\\\\": {\\\\\\\"motivation\\\\\\\": \\\\\\\"The current BHT eliminates the repeated recovery bubbles for direct branches\\\\\\\\nand JALs, but every function return remains an unpredicted JALR. CoreMark's\\\\\\\\nsmall routines execute many call and return pairs, making return recovery a\\\\\\\\nconcentrated remaining front-end cost.\\\\\\\\n\\\\\\\", \\\\\\\"hypothesis\\\\\\\": \\\\\\\"Extend the existing direct predictor with a tiny committed return-address\\\\\\\\nstack. Detect canonical RV32 calls and returns in fetch: predict a JALR\\\\\\\\nreturn through the stack top, while EX pushes PC+4 for resolved calls and\\\\\\\\npops only resolved canonical returns. Keeping updates at resolution avoids\\\\\\\\ncorrupting predictor state on a mispredicted speculative path, and avoids\\\\\\\\nthe tags, target RAM, and lookup delay of a general indirect BTB.\\\\\\\\n\\\\\\\", \\\\\\\"expected_impact\\\\\\\": {\\\\\\\"fitness_delta_pct\\\\\\\": 5, \\\\\\\"confidence\\\\\\\": \\\\\\\"medium\\\\\\\"}, \\\\\\\"changes\\\\\\\": [{\\\\\\\"file\\\\\\\": \\\\\\\"rtl/branch_predictor.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Add a shallow committed return-address stack, canonical JAL/JALR call and return recognition, resolved-call push/pop training, and stack-top prediction for returns while retaining the BHT behavior.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/ex_stage.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Expose resolved canonical call and return events to train the return stack, gated with valid, non-stalled execution and existing trap handling.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/core.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Wire execute-stage return-stack training into the predictor and preserve the existing predicted-next-PC and recovery path.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"test/test_pipeline.py\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Add directed nested-call and return tests, including return prediction, stack push/pop ordering, empty-stack sequential fallback, and wrong-path recovery.\\\\\\\"}]}, \\\\\\\"expected_impact\\\\\\\": {\\\\\\\"fitness_delta_pct\\\\\\\": 5, \\\\\\\"confidence\\\\\\\": \\\\\\\"medium\\\\\\\"}, \\\\\\\"changes\\\\\\\": [{\\\\\\\"file\\\\\\\": \\\\\\\"rtl/branch_predictor.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Add a shallow committed return-address stack, canonical JAL/JALR call and return recognition, resolved-call push/pop training, and stack-top prediction for returns while retaining the BHT behavior.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/ex_stage.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Expose resolved canonical call and return events to train the return stack, gated with valid, non-stalled execution and existing trap handling.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/core.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Wire execute-stage return-stack training into the predictor and preserve the existing predicted-next-PC and recovery path.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"test/test_pipeline.py\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Add directed nested-call and return tests, including return prediction, stack push/pop ordering, empty-stack sequential fallback, and wrong-path recovery.\\\\\\\"}], \\\\\\\"outcome\\\\\\\": \\\\\\\"regression\\\\\\\", \\\\\\\"fitness\\\\\\\": 308.55, \\\\\\\"delta_pct\\\\\\\": -2.41, \\\\\\\"vs_baseline\\\\\\\": 9.1, \