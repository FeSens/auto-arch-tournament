immediate.\\\\\\\\n\\\\\\\", \\\\\\\"hypothesis\\\\\\\": \\\\\\\"Replace the PC-indexed two-bit counter lookup with a stateless\\\\\\\\nbackward-taken/forward-not-taken policy for validated conditional branches,\\\\\\\\nwhile retaining direct-JAL target prediction and existing EX comparison\\\\\\\\nrecovery. A negative B-immediate predicts its direct target; forward\\\\\\\\nbranches stay sequential. This removes the BHT flops, index mux, reset\\\\\\\\nfanout, and training cone from fetch, avoids the first-iteration loop miss,\\\\\\\\nand should preserve nearly all CoreMark loop IPC at a higher Fmax.\\\\\\\\n\\\\\\\", \\\\\\\"expected_impact\\\\\\\": {\\\\\\\"fitness_delta_pct\\\\\\\": 5, \\\\\\\"confidence\\\\\\\": \\\\\\\"medium\\\\\\\"}, \\\\\\\"changes\\\\\\\": [{\\\\\\\"file\\\\\\\": \\\\\\\"rtl/branch_predictor.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Replace the indexed saturating-counter table and training state with a combinational validated-B-type backward-taken predictor, while keeping direct-JAL prediction.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/core.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Remove obsolete execute-to-predictor branch-training connections and retain the predicted-next-PC lookup and recovery wiring.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"rtl/ex_stage.sv\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Remove branch-training outputs that are no longer needed, preserving resolved-next-PC computation and misprediction redirect behavior.\\\\\\\"}, {\\\\\\\"file\\\\\\\": \\\\\\\"test/test_pipeline.py\\\\\\\", \\\\\\\"description\\\\\\\": \\\\\\\"Add directed checks for backward conditional prediction, forward sequential prediction, loop exit recovery, direct JAL prediction, and RVFI PC sequencing.\\\\\\\"}]}, \\\\\\\"expected_impact\\\\\\\": {\\\\\\\"fitness_delta_pct\\\\\\\": 5, \\\\\\\"confidence\\\\\\\": \\\\\\\"medium\\\\\\\"}, \\\\\\\"changes\\\\\\\": [{\\\\\\\"file\\\\\\\": \\\\\\\"rtl/branch_predictor.sv\\\\\\\", \\\\