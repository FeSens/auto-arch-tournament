ect(dut):\n434:    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n437:        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n467:    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n470:    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n490:    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n502:    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n510:async def rvfi_order_strictly_monotonic(dut):\n511:    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n524:def test_pipeline_runner():\n    assert fallthrough[\"cycle\"] == br[\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def alu_dependent_branch_resolves_in_decode(dut):\n    \"\"\"An immediately preceding ALU result must bypass into ID's compare.\"\"\"\n    program = [\n        ADDI(1, 0, 1),        # PC=0; EX result forwarded to branch decode\n        _b(8, 0, 1, 0b001, 0b1100011),  # PC=4; BNE x1,x0 -> PC=12\n        ADDI(2, 0, 99),       # PC=8; wrong path\n        ADDI(3, 0, 42),       # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 16]\n    branch = rets[1]\n    target = rets[2]\n    assert branch[\"rs1_rdata\"] == 1\n    assert branch[\"pc_next\"] == 12\n    assert target[\"cycle\"] == branch[\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def load_dependent_branch_waits_for_mem_bypass(dut):\n    \"\"\"A branch waits for a load in EX, then compares the MEM load result.\"\"\"\n    branch = BEQ(1, 0, 8)\n    program = [\n        LW(1, 0, 0),          # PC=0; dmem[0] is zero\n        branch,                # PC=4; must wait then take PC=12\n        ADDI(2, 0, 99),       # PC=8; wrong path\n        ADDI(3, 0, 42),       # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, dmem_init={0: 0})\n    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 16]\n    [load] = _by_insn(rets, LW(1, 0, 0))\n    [br] = _by_insn(rets, branch)\n    assert br[\"rs1_rdata\"] == 0\n    assert br[\"pc_next\"] == 12\n    assert br[\"cycle\"] == load[\"cycle\"] + 2, (\n        \"load-dependent branch must take exactly the load-use interlock\"\n    )\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def aligned_forward_jal_redirect_avoids_frontend_bubble(dut):\n    \"\"\"An aligned direct JAL redirects from ID and its target retires next.\"\"\"\n    program = [JAL(1, 8), ADDI(2, 0, 99), ADDI(3, 0, 42), EBREAK()]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12]\n    [jal, target] = rets[:2]\n    assert target[\"cycle\"] == jal[\"cycle\"] + 1, (\n        f\"aligned direct JAL should redirect from decode; retire gap was \"\n        f\"{target['cycle'] - jal['cycle']} cycles\"\n    )\n\n\n@cocotb.test()\nasync def aligned_backward_jal_redirect_preserves_link_and_rvfi_pcs(dut):\n    \"\"\"A backward JAL redirects in ID, then loops once before a branch exits.\"\"\"\n    loop_jal = JAL(5, -8)  # PC=12 -> PC=4\n    program = [\n        ADDI(2, 0, 2),       # PC=0\n        ADDI(1, 1, 1),       # PC=4; executes twice\n        BEQ(1, 2, 12),       # PC=8; final iteration exits to PC=20\n        loop_jal,             # PC=12; one aligned backward redirect\n        ADDI(3, 0, 99),       # PC=16; never retires\n        ADDI(3, 0, 42),       # PC=20\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 4, 8, 20, 24]\n    [jal] = _by_insn(rets, loop_jal)\n    assert jal[\"pc_next\"] == 4 and jal[\"rd\"] == 5 and jal[\"rd_wdata\"] == 16\n    loop_target = rets[4]\n    assert loop_target[\"cycle\"] == jal[\"cycle\"] + 1\n    assert not [r for r in rets if r[\"pc\"] == 16]\n\n\n@cocotb.test()\nasync def stalled_jal_is_not_marked_resolved_until_it_can_capture(dut):\n    \"\"\"An older dmem stall holds the JAL in ID; release captures one redirect.\"\"\"\n    jal = JAL(1, 8)          # PC=8 -> PC=16\n    program = [\n        LW(3, 0, 0),          # reaches MEM while JAL is decoding\n        ADDI(4, 0, 1),\n        jal,\n        ADDI(2, 0, 99),       # wrong path\n        ADDI(2, 0, 42),       # target\n        EBREAK(),\n    ]\n\n    def ready(cycle):\n        return (1, 0) if cycle == 2 else (1, 1)\n\n    rets, _ = await _run(dut, program, dmem_init={0: 0}, ready=ready)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 16, 20]\n    [rj] = _by_insn(rets, jal)\n    assert rj[\"rd\"] == 1 and rj[\"rd_wdata\"] == 12 and rj[\"pc_next\"] == 16\n    assert not [r for r in rets if r[\"pc\"] == 12]\n\n\n@cocotb.test()\nasync def older_ex_redirect_wins_over_wrong_path_decode_jal(dut):\n    \"\"\"A wrong-path JAL in ID cannot override an older JALR recovery in EX.\"\"\"\n    wrong_path_jal = JAL(2, 12)  # PC=8 -> PC=20, must be ignored\n    program = [\n        ADDI(5, 0, 16),\n        JALR(1, 5, 0),        # PC=4 -> PC=16 from EX\n        wrong_path_jal,\n        ADDI(3, 0, 99),\n        ADDI(4, 0, 42),       # PC=16\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 16, 20]\n    assert not _by_insn(rets, wrong_path_jal)\n    [target] = _by_insn(rets, ADDI(4, 0, 42))\n    assert target[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def misaligned_jal_traps_in_ex_without_decode_redirect(dut):\n    \"\"\"A +2 JAL is not ID-steered, traps, writes no link, and stays linear.\"\"\"\n    bad_jal = JAL(1, 2)\n    program = [bad_jal, ADDI(2, 0, 42), EBREAK()]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8]\n    [fault] = _by_insn(rets, bad_jal)\n    assert fault[\"trap\"] == 1 and fault[\"pc_next\"] == 4\n    assert fault[\"rd\"] == 0 and fault[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def sequential_loop_branches_recover_in_decode(dut):\n    \"\"\"Each taken loop branch recovers in ID; its final fall-through stays\n    sequential, without predictor state or training.\"\"\"\n    dec = ADDI(1, 1, -1)\n    loop = _b(-4, 0, 1, 0b001, 0b1100011)  # BNE x1,x0, PC-4\n    program = [ADDI(1, 0, 4), dec, loop, ADDI(2, 0, 42), EBREAK()]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 8, 4, 8, 4, 8, 4, 8, 12, 16]\n    branch_rets = _by_insn(rets, loop)\n    assert len(branch_rets) == 4\n    # The final not-taken resolution remains on fetch's sequential PC+4.\n    assert branch_rets[-1][\"pc_next\"] == 12\n    assert [r[\"order\"] for r in rets] == list(range(len(rets))), (\n        \"decode branch recovery must not perturb RVFI retirement ordering\"\n    )\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\n    cores report rd_addr = instr[11:7] regardless of trap and let the\n    verifier ignore it on trap=1; both are accepted by riscv-formal.\n    Our reference.py and DUT both follow the zeroed-on-trap convention,\n    so cosim stays in lockstep.\"\"\"\n    program = [\n        0xFFFFFFFF,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    bad = next(r for r in rets if r[\"insn\"] == 0xFFFFFFFF)\n    assert bad[\"trap\"] == 1\n    assert bad[\"rd\"] == 0\n    assert bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def ecall_traps(dut):\n    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n    program = [\n        ECALL(),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [re] = _by_insn(rets, ECALL())\n    assert re[\"trap\"] == 1\n\n\n@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"branch_predictor.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n","exit_code":0,"status":"completed"}}
