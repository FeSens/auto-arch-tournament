e instruction being\ncores/bench/rtl/id_stage.sv:24:  // directly from dmem through mem_bypass_data; wb is the normal writeback\ncores/bench/rtl/id_stage.sv:28:  input  logic [31:0]       ex_bypass_data,\ncores/bench/rtl/id_stage.sv:29:  input  logic              ex_bypass_valid,\ncores/bench/rtl/id_stage.sv:32:  input  logic [31:0]       mem_bypass_data,\ncores/bench/rtl/id_stage.sv:33:  input  logic              mem_bypass_valid,\ncores/bench/rtl/id_stage.sv:54:  logic        dec_mem_read;\ncores/bench/rtl/id_stage.sv:72:    .mem_read   (dec_mem_read),\ncores/bench/rtl/id_stage.sv:99:    ctrl_decoded.mem_read   = dec_mem_read;\ncores/bench/rtl/id_stage.sv:111:  // MEM, where mem_bypass_data is the extended dmem result.  The hazard\ncores/bench/rtl/id_stage.sv:131:    ex_rs1_match = ex_bypass_valid\ncores/bench/rtl/id_stage.sv:133:    ex_rs2_match = ex_bypass_valid\ncores/bench/rtl/id_stage.sv:139:    if (mem_bypass_valid && mem_in.rd != 5'b0\ncores/bench/rtl/id_stage.sv:141:      branch_rs1 = mem_bypass_data;\ncores/bench/rtl/id_stage.sv:142:    if (ex_rs1_match && !ex_in.ctrl.mem_read)\ncores/bench/rtl/id_stage.sv:143:      branch_rs1 = ex_bypass_data;\ncores/bench/rtl/id_stage.sv:148:    if (mem_bypass_valid && mem_in.rd != 5'b0\ncores/bench/rtl/id_stage.sv:150:      branch_rs2 = mem_bypass_data;\ncores/bench/rtl/id_stage.sv:151:    if (ex_rs2_match && !ex_in.ctrl.mem_read)\ncores/bench/rtl/id_stage.sv:152:      branch_rs2 = ex_bypass_data;\ncores/bench/rtl/id_stage.sv:154:    // The only unforwardable source is a matching load currently in EX.\ncores/bench/rtl/id_stage.sv:156:    branch_operands_ready = !(ex_in.valid && ex_in.ctrl.mem_read\ncores/bench/rtl/id_stage.sv:178:    branch_resolved_id = in.valid && dec_is_branch && !dec_is_illegal\ncores/bench/rtl/id_stage.sv:180:                      && !stall && !flush;\ncores/bench/rtl/id_stage.sv:182:    // JAL is operand-independent, so it needs neither branch forwarding nor\ncores/bench/rtl/id_stage.sv:189:    j