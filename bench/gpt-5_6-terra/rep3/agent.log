/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_6-terra-rep3/cores/bench/worktrees/hyp-20260711-002-r9s1/formal/last_run-25972.log\\nPer-check logs in: /Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_6-terra-rep3/cores/bench/worktrees/hyp-20260711-002-r9s1/formal/riscv-formal/cores/bench-25972/checks/<check>/logfile.txt\", \"slot\": 1, \"round_id\": 9}\n30:{\"id\": \"hyp-20260711-002-r10s1\", \"title\": \"Word-addressed control-flow spine\", \"category\": \"structural\", \"motivation\": \"The current core carries byte-addressed 32-bit PCs through every pipeline\\nbundle and repeatedly performs PC+4 and PC+immediate arithmetic in fetch,\\ndecode, and execute. RV32I instructions are always four-byte aligned, so\\nthe two low PC bits are invariant zeros on every architecturally executed\\npath. The current JAL-only prediction makes this PC feedback path more\\nimportant to routed Fmax than the removed conditional-BHT logic.\\n\", \"hypothesis\": {\"motivation\": \"The current core carries byte-addressed 32-bit PCs through every pipeline\\nbundle and repeatedly performs PC+4 and PC+immediate arithmetic in fetch,\\ndecode, and execute. RV32I instructions are always four-byte aligned, so\\nthe two low PC bits are invariant zeros on every architecturally executed\\npath. The current JAL-only prediction makes this PC feedback path more\\nimportant to routed Fmax than the removed conditional-BHT logic.\\n\", \"hypothesis\": \"Rebuild the control-flow spine around a 30-bit word PC internally. Fetch,\\ndirect-JAL prediction, decode-stage branch recovery, and EX branch/JAL\\ntarget generation operate on pc_word plus signed immediate[31:2]; pipeline\\nbundles carry word PCs and word successors. Reconstruct {pc_word,2'b00}\\nonly where an architectural byte address is required (imem, AUIPC/link\\ndata, dmem-derived RVFI context, and RVFI pc fields). JALR retains a\\nfull-width sum solely for its mandated bit-0 clear and bit-1 misalignment\\ntrap. This removes invariant low-bit routing and narrows the pervasive\\nsequential/relative-target adders without changing retirement width,\\nredirect priority, trap rules, or external I/O.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Replace pipeline PC and successor members with 30-bit word-address representations, retaining helpers or documented reconstruction points for architectural 32-bit PC values.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Store a word-addressed fetch PC, form imemAddr by appending two zero bits, and perform sequential/direct-JAL next-PC selection in word units while retaining redirect-over-stall priority.\"}, {\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Accept and return word PCs, derive the signed JAL word displacement from immediate[31:2], and avoid speculating an instruction-address-misaligned JAL target.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Calculate legal operand-ready conditional branch targets and decode redirects in word units, while preserving the existing forwarded compare and misaligned-target trap handoff.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Use word-PC arithmetic for AUIPC, branch, JAL, link, and resolved successor paths; retain a full JALR sum for exact alignment semantics and materialize byte PCs only for architectural data.\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Carry the narrower PC payload unchanged through MEM/WB without altering load/store handling or RVFI memory fields.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Reconstruct full byte PCs and successors at RVFI channel 0, keeping rvfi_order, trap, and all top-level interface fields unchanged.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add directed forward and backward control-flow cases near word-PC wrap, plus aligned and misaligned branch/JAL/JALR checks for RVFI pc_rdata, pc_wdata, trap, and retirement order.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 3, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Replace pipeline PC and successor members with 30-bit word-address representations, retaining helpers or documented reconstruction points for architectural 32-bit PC values.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Store a word-addressed fetch PC, form imemAddr by appending two zero bits, and perform sequential/direct-JAL next-PC selection in word units while retaining redirect-over-stall priority.\"}, {\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Accept and return word PCs, derive the signed JAL word displacement from immediate[31:2], and avoid speculating an instruction-address-misaligned JAL target.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Calculate legal operand-ready conditional branch targets and decode redirects in word units, while preserving the existing forwarded compare and misaligned-target trap handoff.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Use word-PC arithmetic for AUIPC, branch, JAL, link, and resolved successor paths; retain a full JALR sum for exact alignment semantics and materialize byte PCs only for architectural data.\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Carry the narrower PC payload unchanged through MEM/WB without altering load/store handling or RVFI memory fields.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Reconstruct full byte PCs and successors at RVFI channel 0, keeping rvfi_order, trap, and all top-level interface fields unchanged.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add directed forward and backward control-flow cases near word-PC wrap, plus aligned and misaligned branch/JAL/JALR checks for RVFI pc_rdata, pc_wdata, trap, and retirement order.\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"cosim_failed: coremark.elf\", \"slot\": 1, \"round_id\": 10, \"lesson\": \"- 2026-07-11 hyp-20260711-002-r10s1 (broken, n/a): Word-PC control flow must convert JAL/B immediates from byte to word units by dropping both invariant low bits; retaining the encoded halfword bit scales even legal aligned targets incorrectly and causes cosimulation failures.\"}\n33:{\"id\": \"hyp-20260711-002-r11s1\", \"title\": \"Correct 30-bit word-PC spine\", \"category\": \"structural\", \"motivation\": \"The fetch PC, predicted successor, and carried retirement PCs are always\\ninstruction aligned, yet the core routes their invariant low two zero bits\\nand uses 32-bit adders in the timing-sensitive fetch and redirect paths.\\nThe prior word-PC attempt failed cosimulation because it retained an\\nencoded halfword immediate bit when converting direct-control offsets, not\\nbecause the reduced-width PC topology is architecturally invalid.\\n\", \"hypothesis\": {\"motivation\": \"The fetch PC, predicted successor, and carried retirement PCs are always\\ninstruction aligned, yet the core routes their invariant low two zero bits\\nand uses 32-bit adders in the timing-sensitive fetch and redirect paths.\\nThe prior word-PC attempt failed cosimulation because it retained an\\nencoded halfword immediate bit when converting direct-control offsets, not\\nbecause the reduced-width PC topology is architecturally invalid.\\n\", \"hypothesis\": \"Represent sequential fetch, direct-JAL prediction, conditional-branch\\nrecovery, and non-JALR resolved successors as 30-bit instruction-word\\naddresses. PC+4 becomes pc_word+1. Direct JAL must use exactly the signed\\nJ-immediate bits [31:2], and B targets exactly the signed B-immediate bits\\n[31:2], dropping both encoded invariant low bits; this corrects the failed\\nearlier conversion. Reconstruct byte PCs only at imem, AUIPC/link-data,\\nJALR's full-width target/alignment check, and RVFI boundaries. Narrowing\\nthe persistent PC feedback/routing cone should improve Fmax without adding\\nqueueing state or changing single-retirement behavior.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Replace carried aligned PC and predicted-successor fields with 30-bit word-PC fields while retaining byte-address reconstruction at architectural boundaries.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Store the fetch PC in word units, emit io_imemAddr as {pc_word,2'b00}, and retain redirect-over-stall priority with pc_word+1 sequential advance.\"}, {\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Perform direct-JAL prediction in word units using the exact signed J-immediate [31:2] encoding, with no retained halfword bit.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Compute decode-resolved conditional branch targets from the exact signed B-immediate [31:2] word displacement while preserving existing operand bypass and trap gating.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Use word-PC arithmetic for branch/JAL successors and byte-PC reconstruction for AUIPC/link data; keep JALR full-width until its mandated alignment check completes.\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Propagate narrowed PC metadata through MEM/WB and materialize byte-addressed RVFI PC values without altering memory-access semantics.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Adapt predictor, redirect, and RVFI wiring to the internal word-PC representation while preserving the external imem and single-channel RVFI contract.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add forward/backward JAL and branch cases that verify exact word-offset conversion, plus AUIPC, JALR, misalignment, RVFI PC, and retirement-order coverage.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 4, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/core_pkg.sv\", \"description\": \"Replace carried aligned PC and predicted-successor fields with 30-bit word-PC fields while retaining byte-address reconstruction at architectural boundaries.\"}, {\"file\": \"rtl/if_stage.sv\", \"description\": \"Store the fetch PC in word units, emit io_imemAddr as {pc_word,2'b00}, and retain redirect-over-stall priority with pc_word+1 sequential advance.\"}, {\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Perform direct-JAL prediction in word units using the exact signed J-immediate [31:2] encoding, with no retained halfword bit.\"}, {\"file\": \"rtl/id_stage.sv\", \"description\": \"Compute decode-resolved conditional branch targets from the exact signed B-immediate [31:2] word displacement while preserving existing operand bypass and trap gating.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Use word-PC arithmetic for branch/JAL successors and byte-PC reconstruction for AUIPC/link data; keep JALR full-width until its mandated alignment check completes.\"}, {\"file\": \"rtl/mem_stage.sv\", \"description\": \"Propagate narrowed PC metadata through MEM/WB and materialize byte-addressed RVFI PC values without altering memory-access semantics.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Adapt predictor, redirect, and RVFI wiring to the internal word-PC representation while preserving the external imem and single-channel RVFI contract.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add forward/backward JAL and branch cases that verify exact word-offset conversion, plus AUIPC, JALR, misalignment, RVFI PC, and retirement-order coverage.\"}], \"outcome\": \"regression\", \"fitness\": 140.48, \"delta_pct\": -60.27, \"vs_baseline\": -50.33, \"fmax_mhz\": 58.28, \"ipc_coremark\": 2e-06, \"cycles\": 4148503, \"iterations\": 10, \"lut4\": 7923, \"ff\": 1906, \"seeds\": [58.1, 58.28, 61.98], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-07-11T18:13:43.138227Z\", \"slot\": 1, \"round_id\": 11}\n","exit_code":0,"status":"completed"}}
