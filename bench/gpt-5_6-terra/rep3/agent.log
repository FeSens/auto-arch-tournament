{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' cores/bench/test/_helpers.py && git diff --check && git diff -- cores/bench/rtl/branch_predictor.sv cores/bench/test/test_branch_predictor.py cores/bench/test/test_pipeline.py\"","aggregated_output":"\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ndiff --git a/cores/bench/rtl/branch_predictor.sv b/cores/bench/rtl/branch_predictor.sv\nindex 4128de7..2d67b1d 100644\n--- a/cores/bench/rtl/branch_predictor.sv\n+++ b/cores/bench/rtl/branch_predictor.sv\n@@ -6,12 +6,19 @@\n // logic to a single increment removes J-immediate extraction and the\n // PC-relative target adder from the fetch-to-PC feedback loop.\n module branch_predictor (\n+  // The sequential path deliberately consumes the aligned word address\n+  // only; byte-offset bits are reconstructed as zero below.\n+  /* verilator lint_off UNUSEDSIGNAL */\n   input  logic [31:0] lookup_pc,\n+  /* verilator lint_on UNUSEDSIGNAL */\n   output logic [31:0] predicted_next_pc\n );\n \n   always_comb begin\n-    predicted_next_pc = lookup_pc + 32'd4;\n+    // Fetch PCs are instruction aligned.  Increment their word address and\n+    // reconstruct the fixed byte-offset bits, keeping the fetch feedback\n+    // incrementer 30 bits wide while all architectural PCs remain bytes.\n+    predicted_next_pc = {lookup_pc[31:2] + 30'd1, 2'b00};\n   end\n \n endmodule\ndiff --git a/cores/bench/test/test_branch_predictor.py b/cores/bench/test/test_branch_predictor.py\nindex 863cc49..8144266 100644\n--- a/cores/bench/test/test_branch_predictor.py\n+++ b/cores/bench/test/test_branch_predictor.py\n@@ -15,7 +15,9 @@ async def _lookup(dut, pc: int) -> int:\n \n @cocotb.test()\n async def every_lookup_is_sequential(dut):\n+    assert await _lookup(dut, 0x0000_0000) == 0x0000_0004\n     assert await _lookup(dut, 0x100) == 0x104\n+    assert await _lookup(dut, 0x7FFF_FFFC) == 0x8000_0000\n     assert await _lookup(dut, 0xFFFF_FFFC) == 0x0000_0000\n \n \ndiff --git a/cores/bench/test/test_pipeline.py b/cores/bench/test/test_pipeline.py\nindex 7e99950..446e3e3 100644\n--- a/cores/bench/test/test_pipeline.py\n+++ b/cores/bench/test/test_pipeline.py\n@@ -446,6 +446,45 @@ async def jalr_target(dut):\n     assert r7[\"rd_wdata\"] == 42\n \n \n+@cocotb.test()\n+async def jalr_redirect_resumes_word_aligned_sequential_fetch(dut):\n+    \"\"\"A JALR recovery resumes on the target and then advances by exact PC+4.\"\"\"\n+    jalr = JALR(1, 5, 0)\n+    program = [\n+        ADDI(5, 0, 16),       # PC=0; JALR target\n+        jalr,                  # PC=4; redirects from EX\n+        ADDI(2, 0, 99),        # PC=8; wrong path\n+        ADDI(3, 0, 99),        # PC=12; wrong path\n+        ADDI(4, 0, 7),         # PC=16; redirect target\n+        ADDI(6, 4, 1),         # PC=20; sequential successor\n+        EBREAK(),              # PC=24\n+    ]\n+    rets, _ = await _run(dut, program)\n+    assert [r[\"pc\"] for r in rets] == [0, 4, 16, 20, 24]\n+    assert [r[\"pc_next\"] for r in rets] == [4, 16, 20, 24, 28]\n+    [target] = _by_insn(rets, ADDI(4, 0, 7))\n+    [successor] = _by_insn(rets, ADDI(6, 4, 1))\n+    assert successor[\"cycle\"] == target[\"cycle\"] + 1\n+\n+\n+@cocotb.test()\n+async def misaligned_jalr_traps_then_resumes_sequential_fetch(dut):\n+    \"\"\"A JALR target at PC+2 traps; its linear PC+4 successor is preserved.\"\"\"\n+    bad_jalr = JALR(1, 5, 0)\n+    program = [\n+        ADDI(5, 0, 6),        # PC=0; JALR clears bit 0 but target remains +2\n+        bad_jalr,              # PC=4; instruction-address-misaligned trap\n+        ADDI(2, 0, 42),        # PC=8; must execute after the fault\n+        EBREAK(),              # PC=12\n+    ]\n+    rets, _ = await _run(dut, program)\n+    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12]\n+    [fault] = _by_insn(rets, bad_jalr)\n+    assert fault[\"trap\"] == 1\n+    assert fault[\"pc_next\"] == 8\n+    assert fault[\"rd\"] == 0 and fault[\"rd_wdata\"] == 0\n+\n+\n @cocotb.test()\n async def sw_lw_roundtrip(dut):\n     \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n","exit_code":0,"status":"completed"}}
