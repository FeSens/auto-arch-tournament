l/branch_predictor.sv\", \"description\": \"Add a shallow committed return-address stack, canonical JAL/JALR call and return recognition, resolved-call push/pop training, and stack-top prediction for returns while retaining the BHT behavior.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Expose resolved canonical call and return events to train the return stack, gated with valid, non-stalled execution and existing trap handling.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire execute-stage return-stack training into the predictor and preserve the existing predicted-next-PC and recovery path.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add directed nested-call and return tests, including return prediction, stack push/pop ordering, empty-stack sequential fallback, and wrong-path recovery.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 5, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/branch_predictor.sv\", \"description\": \"Add a shallow committed return-address stack, canonical JAL/JALR call and return recognition, resolved-call push/pop training, and stack-top prediction for returns while retaining the BHT behavior.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Expose resolved canonical call and return events to train the return stack, gated with valid, non-stalled execution and existing trap handling.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire execute-stage return-stack training into the predictor and preserve the existing predicted-next-PC and recovery path.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add directed nested-call and return tests, including return prediction, stack push/pop ordering, empty-stack sequential fallback, and wrong-path recovery.\"}], \"outcome\": \"regression\", \"fitness\": 308.55, \"delta_pct\": -2.41, \"vs_baseline\": 9.1, \"fmax_mhz\": 129.72, \"ipc_coremark\": 2e-06, \"cycles\": 4204229, \"iterations\": 10, \"lut4\": 10293, \"ff\": 2059, \"seeds\