{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '270,390p' cores/bench/test/test_pipeline.py && git diff -- cores/bench/rtl\"","aggregated_output":"        ADDI(3, 0, 42),       # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 16]\n    branch = rets[1]\n    target = rets[2]\n    assert branch[\"rs1_rdata\"] == 1\n    assert branch[\"pc_next\"] == 12\n    assert target[\"cycle\"] == branch[\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def load_dependent_branch_waits_for_mem_bypass(dut):\n    \"\"\"A branch waits for a load in EX, then compares the MEM load result.\"\"\"\n    branch = BEQ(1, 0, 8)\n    program = [\n        LW(1, 0, 0),          # PC=0; dmem[0] is zero\n        branch,                # PC=4; must wait then take PC=12\n        ADDI(2, 0, 99),       # PC=8; wrong path\n        ADDI(3, 0, 42),       # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, dmem_init={0: 0})\n    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 16]\n    [load] = _by_insn(rets, LW(1, 0, 0))\n    [br] = _by_insn(rets, branch)\n    assert br[\"rs1_rdata\"] == 0\n    assert br[\"pc_next\"] == 12\n    assert br[\"cycle\"] == load[\"cycle\"] + 2, (\n        \"load-dependent branch must take exactly the load-use interlock\"\n    )\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def aligned_forward_jal_redirect_avoids_frontend_bubble(dut):\n    \"\"\"An aligned direct JAL redirects from ID and its target retires next.\"\"\"\n    program = [JAL(1, 8), ADDI(2, 0, 99), ADDI(3, 0, 42), EBREAK()]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12]\n    [jal, target] = rets[:2]\n    assert target[\"cycle\"] == jal[\"cycle\"] + 1, (\n        f\"aligned direct JAL should redirect from decode; retire gap was \"\n        f\"{target['cycle'] - jal['cycle']} cycles\"\n    )\n\n\n@cocotb.test()\nasync def aligned_backward_jal_redirect_preserves_link_and_rvfi_pcs(dut):\n    \"\"\"A backward JAL redirects in ID, then loops once before a branch exits.\"\"\"\n    loop_jal = JAL(5, -8)  # PC=12 -> PC=4\n    program = [\n        ADDI(2, 0, 2),       # PC=0\n        ADDI(1, 1, 1),       # PC=4; executes twice\n        BEQ(1, 2, 12),       # PC=8; final iteration exits to PC=20\n        loop_jal,             # PC=12; one aligned backward redirect\n        ADDI(3, 0, 99),       # PC=16; never retires\n        ADDI(3, 0, 42),       # PC=20\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 4, 8, 20, 24]\n    [jal] = _by_insn(rets, loop_jal)\n    assert jal[\"pc_next\"] == 4 and jal[\"rd\"] == 5 and jal[\"rd_wdata\"] == 16\n    loop_target = rets[4]\n    assert loop_target[\"cycle\"] == jal[\"cycle\"] + 1\n    assert not [r for r in rets if r[\"pc\"] == 16]\n\n\n@cocotb.test()\nasync def stalled_jal_is_not_marked_resolved_until_it_can_capture(dut):\n    \"\"\"An older dmem stall holds the JAL in ID; release captures one redirect.\"\"\"\n    jal = JAL(1, 8)          # PC=8 -> PC=16\n    program = [\n        LW(3, 0, 0),          # reaches MEM while JAL is decoding\n        ADDI(4, 0, 1),\n        jal,\n        ADDI(2, 0, 99),       # wrong path\n        ADDI(2, 0, 42),       # target\n        EBREAK(),\n    ]\n\n    def ready(cycle):\n        return (1, 0) if cycle == 2 else (1, 1)\n\n    rets, _ = await _run(dut, program, dmem_init={0: 0}, ready=ready)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 16, 20]\n    [rj] = _by_insn(rets, jal)\n    assert rj[\"rd\"] == 1 and rj[\"rd_wdata\"] == 12 and rj[\"pc_next\"] == 16\n    assert not [r for r in rets if r[\"pc\"] == 12]\n\n\n@cocotb.test()\nasync def older_ex_redirect_wins_over_wrong_path_decode_jal(dut):\n    \"\"\"A wrong-path JAL in ID cannot override an older JALR recovery in EX.\"\"\"\n    wrong_path_jal = JAL(2, 12)  # PC=8 -> PC=20, must be ignored\n    program = [\n        ADDI(5, 0, 16),\n        JALR(1, 5, 0),        # PC=4 -> PC=16 from EX\n        wrong_path_jal,\n        ADDI(3, 0, 99),\ndiff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex 964721c..19b2e4d 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -76,10 +76,13 @@ module core (\n   id_ex_t  id_ex_w;\n   ex_mem_t ex_mem_w;\n   mem_wb_t mem_wb_w;\n+  ex_mem_t shadow_payload_w;\n+  ex_mem_t shadow_q;\n \n   // hazard / forward\n   logic       stall_if, stall_id, flush_if, flush_id;\n   logic       stall_ex_mem, hold_mem_wb;\n+  logic       shadow_capture, shadow_valid, shadow_drain;\n   logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\n \n   // EX redirect\n@@ -166,6 +169,8 @@ module core (\n     .clock           (clock),\n     .reset           (reset),\n     .stall           (stall_ex_mem),\n+    .shadow_drain    (shadow_drain),\n+    .shadow_payload  (shadow_q),\n     .in              (id_ex_w),\n     .fwd_rs1_sel     (fwd_rs1_sel),\n     .fwd_rs2_sel     (fwd_rs2_sel),\n@@ -173,11 +178,33 @@ module core (\n     .fwd_mem_wb      (wb_w_data),            // WB-stage's write-mux output\n     .id_bypass_data  (ex_id_bypass_data),\n     .id_bypass_valid (ex_id_bypass_valid),\n+    .shadow_candidate(shadow_payload_w),\n     .out             (ex_mem_w),\n     .redirect        (redirect),\n     .redirect_target (redirect_target)\n   );\n \n+  // Shadow execute buffer.  Capture occurs only while a stalled older load\n+  // occupies EX/MEM; once that load receives its dmem response, the buffer\n+  // replaces it at EX/MEM on the same edge.  This preserves retirement and\n+  // memory order while avoiding a dmem-to-EX bypass path.\n+  assign shadow_drain = shadow_valid && ex_mem_w.ctrl.mem_read\n+                     && io_dmemReady;\n+  always_ff @(posedge clock) begin\n+    if (reset) begin\n+      shadow_q     <= '0;\n+      shadow_valid <= 1'b0;\n+    end else begin\n+      if (shadow_capture) begin\n+        shadow_q     <= shadow_payload_w;\n+        shadow_valid <= 1'b1;\n+      end else if (shadow_drain) begin\n+        shadow_q     <= '0;\n+        shadow_valid <= 1'b0;\n+      end\n+    end\n+  end\n+\n   // ── MEM ───────────────────────────────────────────────────────────────\n   mem_stage u_mem (\n     .clock      (clock),\n@@ -212,12 +239,22 @@ module core (\n     .imem_ready     (io_imemReady),\n     .dmem_ready     (io_dmemReady),\n     .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\n+    .ex_mem_mem_read(ex_mem_w.ctrl.mem_read),\n+    .ex_mem_rd      (ex_mem_w.rd),\n+    .id_ex_valid    (id_ex_w.valid),\n+    .id_ex_mem_write(id_ex_w.ctrl.mem_write),\n+    .id_ex_is_branch(id_ex_w.ctrl.is_branch),\n+    .id_ex_is_jump  (id_ex_w.ctrl.is_jump),\n+    .id_ex_rs1      (id_ex_w.rs1_addr),\n+    .id_ex_rs2      (id_ex_w.rs2_addr),\n+    .shadow_valid   (shadow_valid),\n     .stall_if       (stall_if),\n     .stall_id       (stall_id),\n     .flush_if       (flush_if),\n     .flush_id       (flush_id),\n     .stall_ex_mem   (stall_ex_mem),\n-    .hold_mem_wb    (hold_mem_wb)\n+    .hold_mem_wb    (hold_mem_wb),\n+    .shadow_capture (shadow_capture)\n   );\n \n   // A simultaneous EX redirect is older than anything in ID.  Suppressing\ndiff --git a/cores/bench/rtl/ex_stage.sv b/cores/bench/rtl/ex_stage.sv\nindex 6ecc3cd..aef90aa 100644\n--- a/cores/bench/rtl/ex_stage.sv\n+++ b/cores/bench/rtl/ex_stage.sv\n@@ -16,6 +16,11 @@ module ex_stage (\n   input  logic               clock,\n   input  logic               reset,\n   input  logic               stall,         // freeze EX/MEM register (dmem stall)\n+  // A one-entry shadow buffer may replace the just-drained older load at\n+  // this register boundary.  It is an already-executed EX/MEM payload, so\n+  // this mux is after the ALU/forwarding cone.\n+  input  logic               shadow_drain,\n+  input  ex_mem_t            shadow_payload,\n   input  id_ex_t   in,\n   input  logic [1:0]         fwd_rs1_sel,\n   input  logic [1:0]         fwd_rs2_sel,\n@@ -26,6 +31,9 @@ module ex_stage (\n   // other writers this is the value that will eventually reach the regfile.\n   output logic [31:0]        id_bypass_data,\n   output logic               id_bypass_valid,\n+  // Complete post-forwarded EX result used to fill the shadow buffer while\n+  // this register is held behind a stalled load.\n+  output ex_mem_t            shadow_candidate,\n   output ex_mem_t  out,\n   output logic               redirect,\n   output logic [31:0]        redirect_target\n@@ -141,8 +149,34 @@ module ex_stage (\n   assign redirect_target = resolved_next_pc;\n \n   // ── EX/MEM register ───────────────────────────────────────────────────\n+  ex_mem_t ex_payload;\n   ex_mem_t reg_q;\n \n+  always_comb begin\n+    ex_payload.pc            = in.pc;\n+    // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n+    // sum (which is the jump target). The MEM/WB register's read-data\n+    // mux only kicks in for LOADs, so we route PC+4 here.\n+    ex_payload.alu_result    = in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n+    ex_payload.write_data    = rs2;\n+    ex_payload.rd            = in.rd;\n+    ex_payload.rs1_addr      = in.rs1_addr;\n+    ex_payload.rs2_addr      = in.rs2_addr;\n+    ex_payload.rs1_val       = rs1;\n+    ex_payload.rs2_val       = rs2;\n+    // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n+    // (asserting next retirement's pc_rdata == this pc_wdata) stays\n+    // consistent with the suppressed redirect.\n+    ex_payload.pc_next       = resolved_next_pc;\n+    ex_payload.branch_taken  = branch_taken;\n+    ex_payload.branch_target = branch_target;\n+    ex_payload.ctrl          = ctrl_with_trap;\n+    ex_payload.instr         = in.instr;\n+    ex_payload.valid         = in.valid;\n+  end\n+\n+  assign shadow_candidate = ex_payload;\n+\n   always_ff @(posedge clock) begin\n     if (reset) begin\n       reg_q <= '0;\n@@ -151,26 +185,7 @@ module ex_stage (\n       // stays in MEM stage waiting on the bus.\n       reg_q <= reg_q;\n     end else begin\n-      reg_q.pc            <= in.pc;\n-      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n-      // sum (which is the jump target). The MEM/WB register's read-data\n-      // mux only kicks in for LOADs, so we route PC+4 here.\n-      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n-      reg_q.write_data    <= rs2;\n-      reg_q.rd            <= in.rd;\n-      reg_q.rs1_addr      <= in.rs1_addr;\n-      reg_q.rs2_addr      <= in.rs2_addr;\n-      reg_q.rs1_val       <= rs1;\n-      reg_q.rs2_val       <= rs2;\n-      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n-      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n-      // consistent with the suppressed redirect.\n-      reg_q.pc_next       <= resolved_next_pc;\n-      reg_q.branch_taken  <= branch_taken;\n-      reg_q.branch_target <= branch_target;\n-      reg_q.ctrl          <= ctrl_with_trap;\n-      reg_q.instr         <= in.instr;\n-      reg_q.valid         <= in.valid;\n+      reg_q <= shadow_drain ? shadow_payload : ex_payload;\n     end\n   end\n \ndiff --git a/cores/bench/rtl/hazard_unit.sv b/cores/bench/rtl/hazard_unit.sv\nindex 06736d9..abeab72 100644\n--- a/cores/bench/rtl/hazard_unit.sv\n+++ b/cores/bench/rtl/hazard_unit.sv\n@@ -31,18 +31,31 @@ module hazard_unit (\n   // would actually be holding up). Computed at top level from the\n   // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n   input  logic       ex_mem_mem_op,\n+  input  logic       ex_mem_mem_read,\n+  input  logic [4:0] ex_mem_rd,\n+  // Candidate currently in EX (ID/EX).  Only an independent, non-memory,\n+  // non-control instruction is allowed into the single shadow slot.\n+  input  logic       id_ex_valid,\n+  input  logic       id_ex_mem_write,\n+  input  logic       id_ex_is_branch,\n+  input  logic       id_ex_is_jump,\n+  input  logic [4:0] id_ex_rs1,\n+  input  logic [4:0] id_ex_rs2,\n+  input  logic       shadow_valid,\n   output logic       stall_if,          // PC reg holds\n   output logic       stall_id,          // ID/EX register holds (vs. bubble)\n   output logic       flush_if,          // IF/ID comb output -> NOP\n   output logic       flush_id,          // ID/EX register captures '0\n   output logic       stall_ex_mem,      // EX/MEM register holds\n-  output logic       hold_mem_wb        // MEM/WB clears valid only;\n+  output logic       hold_mem_wb,       // MEM/WB clears valid only;\n                                         // data fields stay (for fwd)\n+  output logic       shadow_capture\n );\n \n   logic load_use_hazard;\n   logic imem_stall;\n   logic dmem_stall;\n+  logic shadow_eligible;\n \n   always_comb begin\n     load_use_hazard = id_ex_mem_read\n@@ -52,6 +65,16 @@ module hazard_unit (\n     // dmem stall only matters if there's actually a memory op in EX/MEM\n     // — otherwise bus-not-ready is irrelevant to the pipeline.\n     dmem_stall = !dmem_ready && ex_mem_mem_op;\n+    // Source-address comparison is intentionally conservative: an encoded\n+    // rs field that an ALU-immediate instruction does not semantically read\n+    // may still reject capture.  This keeps the admission logic compact and\n+    // guarantees no load-data forwarding path enters EX.\n+    shadow_eligible = dmem_stall && ex_mem_mem_read && !shadow_valid\n+                   && id_ex_valid && !id_ex_mem_read && !id_ex_mem_write\n+                   && !id_ex_is_branch && !id_ex_is_jump\n+                   && (ex_mem_rd == 5'b0\n+                    || (id_ex_rs1 != ex_mem_rd && id_ex_rs2 != ex_mem_rd));\n+    shadow_capture = shadow_eligible;\n \n     // PC reg holds on any stall reason.\n     stall_if      = load_use_hazard || imem_stall || dmem_stall;\n@@ -70,8 +93,13 @@ module hazard_unit (\n     // dmem_stall takes precedence over load_use's bubble: re-evaluate\n     // load_use next cycle when the bus unblocks. flush_id is 1 only when\n     // we want bubble (not hold).\n-    stall_id      = dmem_stall || load_use_hazard;\n-    flush_id      = (load_use_hazard || ex_redirect) && !dmem_stall;\n+    // On shadow capture, consume the currently executing instruction into\n+    // the separate buffer and replace ID/EX with a bubble.  The front end\n+    // remains held until the old load drains, so the next instruction is\n+    // preserved in IF/ID and cannot be issued twice.\n+    stall_id      = (dmem_stall && !shadow_capture) || load_use_hazard;\n+    flush_id      = shadow_capture\n+                 || ((load_use_hazard || ex_redirect) && !dmem_stall);\n     // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n     // bus delivers).\n     stall_ex_mem  = dmem_stall;\n","exit_code":0,"status":"completed"}}
