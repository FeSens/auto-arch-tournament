{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"pytest|test_pipeline|cocotb|incdir\\\" Makefile cores/bench -g '\"'!rtl/*.sv'\"' | head -100 && git diff --check && git diff -- cores/bench/rtl cores/bench/test/test_branch_predictor.py cores/bench/test/test_pipeline.py\"","aggregated_output":"diff --git a/cores/bench/rtl/branch_predictor.sv b/cores/bench/rtl/branch_predictor.sv\nindex 4128de7..cb5586e 100644\n--- a/cores/bench/rtl/branch_predictor.sv\n+++ b/cores/bench/rtl/branch_predictor.sv\n@@ -1,17 +1,50 @@\n // rtl/branch_predictor.sv\n //\n-// Fetch-stage successor selector. Every instruction advances sequentially;\n-// conditional branches and aligned direct JALs redirect from ID, while JALR\n-// and all unresolved or misaligned control flow recover in EX. Keeping this\n-// logic to a single increment removes J-immediate extraction and the\n-// PC-relative target adder from the fetch-to-PC feedback loop.\n+// Fetch remains deliberately sequential: no instruction bits, cache RAM, or\n+// target adder participates in the fetch-to-PC loop.  A four-entry, tagless\n+// return-target cache is instead looked up alongside decode and can steer a\n+// canonical `jalr x0, x1, 0` at the ID capture edge.  An all-zero target is\n+// the reset/miss sentinel, so it is never presented as a prediction.\n module branch_predictor (\n+  input  logic        clock,\n+  input  logic        reset,\n   input  logic [31:0] lookup_pc,\n-  output logic [31:0] predicted_next_pc\n+  output logic [31:0] predicted_next_pc,\n+  output logic        return_hit,\n+  output logic [31:0] return_target,\n+  // EX only asserts train_valid for a resolved, aligned canonical return.\n+  input  logic        train_valid,\n+  /* verilator lint_off UNUSEDSIGNAL */\n+  input  logic [31:0] train_pc,\n+  /* verilator lint_on UNUSEDSIGNAL */\n+  input  logic [31:0] train_target\n );\n \n+  localparam int RTC_ENTRIES = 4;\n+  logic [31:0] return_targets [0:RTC_ENTRIES-1];\n+  logic [1:0]  lookup_index;\n+  logic [1:0]  train_index;\n+\n   always_comb begin\n+    lookup_index = lookup_pc[3:2];\n+    train_index  = train_pc[3:2];\n+\n+    // The normal fetch successor is intentionally always sequential.\n     predicted_next_pc = lookup_pc + 32'd4;\n+    return_target = return_targets[lookup_index];\n+    return_hit = (return_target != 32'b0);\n+  end\n+\n+  integer i;\n+  always_ff @(posedge clock) begin\n+    if (reset) begin\n+      for (i = 0; i < RTC_ENTRIES; i = i + 1)\n+        return_targets[i] <= 32'b0;\n+    end else if (train_valid && train_target != 32'b0) begin\n+      // No tag by design: aliases are ordinary control-flow mispredicts and\n+      // EX recovers to the actual JALR target before retiring the return.\n+      return_targets[train_index] <= train_target;\n+    end\n   end\n \n endmodule\ndiff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex 964721c..59d68c9 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -93,10 +93,22 @@ module core (\n   logic [31:0] mem_id_bypass_data;\n   logic        mem_id_bypass_valid;\n   logic [31:0] predicted_next_pc;\n+  logic        return_cache_hit;\n+  logic [31:0] return_cache_target;\n+  logic        return_cache_train_valid;\n+  logic [31:0] return_cache_train_pc;\n+  logic [31:0] return_cache_train_target;\n \n   branch_predictor u_predictor (\n+    .clock             (clock),\n+    .reset             (reset),\n     .lookup_pc         (io_imemAddr),\n-    .predicted_next_pc (predicted_next_pc)\n+    .predicted_next_pc (predicted_next_pc),\n+    .return_hit        (return_cache_hit),\n+    .return_target     (return_cache_target),\n+    .train_valid       (return_cache_train_valid),\n+    .train_pc          (return_cache_train_pc),\n+    .train_target      (return_cache_train_target)\n   );\n \n   // regfile interface (driven by ID + WB stages)\n@@ -144,6 +156,8 @@ module core (\n     .wb_w_en  (wb_w_en),\n     .wb_w_addr(wb_w_addr),\n     .wb_w_data(wb_w_data),\n+    .return_cache_hit(return_cache_hit),\n+    .return_cache_target(return_cache_target),\n     .early_redirect(id_redirect),\n     .early_redirect_target(id_redirect_target),\n     .out      (id_ex_w)\n@@ -175,7 +189,10 @@ module core (\n     .id_bypass_valid (ex_id_bypass_valid),\n     .out             (ex_mem_w),\n     .redirect        (redirect),\n-    .redirect_target (redirect_target)\n+    .redirect_target (redirect_target),\n+    .return_train_valid(return_cache_train_valid),\n+    .return_train_pc(return_cache_train_pc),\n+    .return_train_target(return_cache_train_target)\n   );\n \n   // ── MEM ───────────────────────────────────────────────────────────────\ndiff --git a/cores/bench/rtl/ex_stage.sv b/cores/bench/rtl/ex_stage.sv\nindex 6ecc3cd..395f49d 100644\n--- a/cores/bench/rtl/ex_stage.sv\n+++ b/cores/bench/rtl/ex_stage.sv\n@@ -28,7 +28,12 @@ module ex_stage (\n   output logic               id_bypass_valid,\n   output ex_mem_t  out,\n   output logic               redirect,\n-  output logic [31:0]        redirect_target\n+  output logic [31:0]        redirect_target,\n+  // Training data for the decode-stage return-target cache.  Kept out of\n+  // fetch so the sequential fetch critical path stays unchanged.\n+  output logic               return_train_valid,\n+  output logic [31:0]        return_train_pc,\n+  output logic [31:0]        return_train_target\n );\n \n   // ── Operand forwarding muxes ───────────────────────────────────────────\n@@ -140,6 +145,18 @@ module ex_stage (\n                          && (resolved_next_pc != in.predicted_next_pc);\n   assign redirect_target = resolved_next_pc;\n \n+  // A canonical return is exactly jalr x0, x1, 0.  Train only when EX owns\n+  // a valid, non-stalled, aligned, legal resolution.  A zero target is left\n+  // as a cache miss by branch_predictor's sentinel policy.\n+  always_comb begin\n+    return_train_valid = in.valid && !stall && !in.ctrl.is_illegal\n+                      && in.ctrl.is_jalr && (in.rd == 5'b0)\n+                      && (in.rs1_addr == 5'd1) && (in.imm == 32'b0)\n+                      && !misalign_fault;\n+    return_train_pc = in.pc;\n+    return_train_target = jump_target;\n+  end\n+\n   // ── EX/MEM register ───────────────────────────────────────────────────\n   ex_mem_t reg_q;\n \ndiff --git a/cores/bench/rtl/id_stage.sv b/cores/bench/rtl/id_stage.sv\nindex 1b651c8..cb26e28 100644\n--- a/cores/bench/rtl/id_stage.sv\n+++ b/cores/bench/rtl/id_stage.sv\n@@ -34,6 +34,10 @@ module id_stage (\n   input  logic              wb_w_en,\n   input  logic [4:0]        wb_w_addr,\n   input  logic [31:0]       wb_w_data,\n+  // Tagless return-target-cache lookup for this IF/ID PC.  This is used\n+  // only after decode has recognised the exact ABI return encoding.\n+  input  logic              return_cache_hit,\n+  input  logic [31:0]       return_cache_target,\n   // Asserted for a capturable, legal, aligned ID-resolved control-flow\n   // instruction whose actual successor differs from fetch's sequential one.\n   output logic              early_redirect,\n@@ -124,6 +128,9 @@ module id_stage (\n   logic [31:0] jal_target;\n   logic        jal_target_misaligned;\n   logic        jal_resolved_id;\n+  logic        canonical_return;\n+  logic        return_prediction_id;\n+  logic [31:0] carried_predicted_next_pc;\n   logic        control_resolved_id;\n   logic [31:0] control_next_pc;\n \n@@ -190,11 +197,26 @@ module id_stage (\n                    && !dec_is_illegal && !jal_target_misaligned\n                    && !stall && !flush;\n \n+    // Exactly `jalr x0, x1, 0` is an ABI return.  The cached value is a\n+    // prediction, not a decode-stage resolution: EX must still use the\n+    // forwarded x1 value, detect aliases/stale entries, and recover.\n+    canonical_return = dec_is_jump && dec_is_jalr && !dec_is_illegal\n+                    && (in.instr[11:7] == 5'b0)\n+                    && (in.instr[19:15] == 5'd1)\n+                    && (imm == 32'b0);\n+    return_prediction_id = in.valid && canonical_return && return_cache_hit\n+                        && !stall && !flush;\n+    carried_predicted_next_pc = return_prediction_id ? return_cache_target\n+                                                      : in.predicted_next_pc;\n+\n     control_resolved_id = branch_resolved_id || jal_resolved_id;\n     control_next_pc = jal_resolved_id ? jal_target : branch_next_pc;\n-    early_redirect_target = control_next_pc;\n-    early_redirect = control_resolved_id\n-                  && (control_next_pc != in.predicted_next_pc);\n+    early_redirect_target = return_prediction_id ? return_cache_target\n+                                                  : control_next_pc;\n+    early_redirect = (return_prediction_id\n+                   && (return_cache_target != in.predicted_next_pc))\n+                  || (control_resolved_id\n+                   && (control_next_pc != in.predicted_next_pc));\n   end\n \n   // ── ID/EX register ──────────────────────────────────────────────────────\n@@ -210,7 +232,9 @@ module id_stage (\n       reg_q.rs1_val  <= dec_is_branch ? branch_rs1 : rs1_data;\n       reg_q.rs2_val  <= dec_is_branch ? branch_rs2 : rs2_data;\n       reg_q.imm      <= imm;\n-      reg_q.predicted_next_pc <= in.predicted_next_pc;\n+      // Cache predictions replace the carried successor but deliberately do\n+      // not set control_resolved_id, preserving EX mismatch recovery.\n+      reg_q.predicted_next_pc <= carried_predicted_next_pc;\n       reg_q.control_resolved_id <= control_resolved_id;\n       reg_q.rd       <= in.instr[11:7];\n       reg_q.rs1_addr <= in.instr[19:15];\ndiff --git a/cores/bench/test/test_branch_predictor.py b/cores/bench/test/test_branch_predictor.py\nindex 863cc49..6cd8eb1 100644\n--- a/cores/bench/test/test_branch_predictor.py\n+++ b/cores/bench/test/test_branch_predictor.py\n@@ -1,22 +1,87 @@\n-\"\"\"Directed lookup tests for the sequential fetch successor selector.\"\"\"\n+\"\"\"Directed tests for sequential fetch and the decode return-target cache.\"\"\"\n from __future__ import annotations\n \n import cocotb\n-from cocotb.triggers import Timer\n+from cocotb.clock import Clock\n+from cocotb.triggers import RisingEdge, Timer\n \n from _helpers import run_cocotb\n \n \n-async def _lookup(dut, pc: int) -> int:\n+async def _lookup(dut, pc: int) -> tuple[int, int, int]:\n     dut.lookup_pc.value = pc\n     await Timer(1, \"ns\")\n-    return int(dut.predicted_next_pc.value)\n+    return (\n+        int(dut.predicted_next_pc.value),\n+        int(dut.return_hit.value),\n+        int(dut.return_target.value),\n+    )\n+\n+\n+async def _reset(dut) -> None:\n+    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n+    dut.train_valid.value = 0\n+    dut.train_pc.value = 0\n+    dut.train_target.value = 0\n+    dut.reset.value = 1\n+    await RisingEdge(dut.clock)\n+    dut.reset.value = 0\n+    await RisingEdge(dut.clock)\n+\n+\n+async def _train(dut, pc: int, target: int) -> None:\n+    dut.train_pc.value = pc\n+    dut.train_target.value = target\n+    dut.train_valid.value = 1\n+    await RisingEdge(dut.clock)\n+    dut.train_valid.value = 0\n+    await Timer(1, \"ns\")\n+\n+\n+@cocotb.test()\n+async def misses_keep_fetch_sequential_and_reset_uses_zero_sentinel(dut):\n+    await _reset(dut)\n+    next_pc, hit, target = await _lookup(dut, 0x100)\n+    assert (next_pc, hit, target) == (0x104, 0, 0)\n+    next_pc, hit, target = await _lookup(dut, 0xFFFF_FFFC)\n+    assert (next_pc, hit, target) == (0x0000_0000, 0, 0)\n+\n+\n+@cocotb.test()\n+async def canonical_return_training_warms_the_decode_lookup(dut):\n+    await _reset(dut)\n+    await _train(dut, 0x104, 0x240)\n+    next_pc, hit, target = await _lookup(dut, 0x104)\n+    # Fetch remains sequential; only the decode-side lookup uses the target.\n+    assert next_pc == 0x108\n+    assert hit == 1 and target == 0x240\n+\n+\n+@cocotb.test()\n+async def direct_mapped_alias_replaces_the_old_return_target(dut):\n+    await _reset(dut)\n+    # Both PCs have index pc[3:2] == 1.\n+    await _train(dut, 0x004, 0x100)\n+    await _train(dut, 0x014, 0x200)\n+    _, hit_old, target_old = await _lookup(dut, 0x004)\n+    _, hit_new, target_new = await _lookup(dut, 0x014)\n+    assert hit_old == hit_new == 1\n+    assert target_old == target_new == 0x200\n \n \n @cocotb.test()\n-async def every_lookup_is_sequential(dut):\n-    assert await _lookup(dut, 0x100) == 0x104\n-    assert await _lookup(dut, 0xFFFF_FFFC) == 0x0000_0000\n+async def zero_target_remains_a_sentinel_miss_after_stale_training(dut):\n+    await _reset(dut)\n+    await _train(dut, 0x108, 0x300)\n+    # The sentinel cannot be installed as a prediction; the prior entry is\n+    # retained, so a stale cache value is still an EX-recoverable prediction.\n+    await _train(dut, 0x108, 0x000)\n+    next_pc, hit, target = await _lookup(dut, 0x108)\n+    assert next_pc == 0x10C\n+    assert hit == 1 and target == 0x300\n+    # An untouched index proves reset/miss behavior remains sequential.\n+    next_pc, hit, target = await _lookup(dut, 0x10C)\n+    assert next_pc == 0x110 and hit == 0 and target == 0\n \n \n def test_branch_predictor_runner():\ndiff --git a/cores/bench/test/test_pipeline.py b/cores/bench/test/test_pipeline.py\nindex 7e99950..dfe8c4b 100644\n--- a/cores/bench/test/test_pipeline.py\n+++ b/cores/bench/test/test_pipeline.py\n@@ -446,6 +446,84 @@ async def jalr_target(dut):\n     assert r7[\"rd_wdata\"] == 42\n \n \n+@cocotb.test()\n+async def canonical_return_cache_warm_hit_redirects_in_decode(dut):\n+    \"\"\"The second execution of one return site uses its EX-trained target.\"\"\"\n+    ret = JALR(0, 1, 0)       # PC=12, canonical ABI return\n+    program = [\n+        ADDI(1, 0, 32),       # return target\n+        ADDI(2, 0, 3),\n+        JAL(0, 24),           # enter loop body at PC=32\n+        ret,                  # only reached from BNE below\n+        NOP(), NOP(), NOP(), NOP(),\n+        ADDI(2, 2, -1),       # PC=32\n+        _b(-24, 0, 2, 0b001, 0b1100011),  # BNE x2,x0 -> PC=12\n+        EBREAK(),\n+    ]\n+    rets, _ = await _run(dut, program)\n+    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 32, 36, 12, 32, 36, 12, 32, 36, 40]\n+    returns = _by_insn(rets, ret)\n+    assert len(returns) == 2\n+    warm_index = rets.index(returns[1])\n+    assert rets[warm_index + 1][\"pc\"] == 32\n+    assert rets[warm_index + 1][\"cycle\"] == returns[1][\"cycle\"] + 1\n+    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n+\n+\n+@cocotb.test()\n+async def canonical_return_cache_miss_and_load_dependency_recover_in_ex(dut):\n+    \"\"\"An unwarmed load-dependent return stays sequential until EX resolves it.\"\"\"\n+    ret = JALR(0, 1, 0)\n+    program = [\n+        LW(1, 0, 0),\n+        ret,\n+        ADDI(2, 0, 99),       # sequential wrong path; must be flushed\n+        NOP(),\n+        ADDI(3, 0, 42),       # loaded x1 target = PC=16\n+        EBREAK(),\n+    ]\n+    rets, _ = await _run(dut, program, dmem_init={0: 16})\n+    assert [r[\"pc\"] for r in rets] == [0, 4, 16, 20]\n+    [return_ret] = _by_insn(rets, ret)\n+    assert return_ret[\"rs1_rdata\"] == 16 and return_ret[\"pc_next\"] == 16\n+    assert not _by_insn(rets, ADDI(2, 0, 99))\n+\n+\n+@cocotb.test()\n+async def cache_alias_mispredict_recovers_and_retrains(dut):\n+    \"\"\"Tagless same-index sites may alias, but EX redirects to the real x1.\"\"\"\n+    ret_a = JALR(0, 1, 0)     # PC=12, index 3, trains target 40\n+    ret_b = JALR(0, 1, 0)     # PC=28, index 3, sees stale target 40\n+    program = [\n+        ADDI(1, 0, 40),\n+        JAL(0, 8),\n+        NOP(),\n+        ret_a,\n+        NOP(), NOP(), NOP(),\n+        ret_b,\n+        NOP(), NOP(), NOP(),\n+        ADDI(1, 0, 48),       # PC=40\n+        JAL(0, -16),          # PC=44 -> PC=28\n+        EBREAK(),              # PC=48, actual target of ret_b\n+    ]\n+    rets, _ = await _run(dut, program)\n+    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 40, 44, 28, 48]\n+    assert sum(r[\"pc\"] == 40 for r in rets) == 1, \"stale target leaked a wrong-path addi\"\n+    [b] = [r for r in rets if r[\"pc\"] == 28]\n+    assert b[\"pc_next\"] == 48\n+\n+\n+@cocotb.test()\n+async def misaligned_canonical_return_traps_without_cache_training(dut):\n+    \"\"\"A canonical encoding with x1=2 traps in EX and remains linear.\"\"\"\n+    bad_ret = JALR(0, 1, 0)\n+    program = [ADDI(1, 0, 2), bad_ret, ADDI(2, 0, 42), EBREAK()]\n+    rets, _ = await _run(dut, program)\n+    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12]\n+    [fault] = _by_insn(rets, bad_ret)\n+    assert fault[\"trap\"] == 1 and fault[\"pc_next\"] == 8\n+\n+\n @cocotb.test()\n async def sw_lw_roundtrip(dut):\n     \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n","exit_code":0,"status":"completed"}}
