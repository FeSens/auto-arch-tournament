{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"rg --files cores/bench/test cores/bench/rtl | sort && sed -n '1,160p' cores/bench/rtl/branch_predictor.sv && git status --short\"","aggregated_output":"cores/bench/rtl/alu.sv\ncores/bench/rtl/branch_predictor.sv\ncores/bench/rtl/core.sv\ncores/bench/rtl/core_pkg.sv\ncores/bench/rtl/decoder.sv\ncores/bench/rtl/ex_stage.sv\ncores/bench/rtl/forward_unit.sv\ncores/bench/rtl/hazard_unit.sv\ncores/bench/rtl/id_stage.sv\ncores/bench/rtl/if_stage.sv\ncores/bench/rtl/imm_gen.sv\ncores/bench/rtl/mem_stage.sv\ncores/bench/rtl/reg_file.sv\ncores/bench/rtl/wb_stage.sv\ncores/bench/test/_helpers.py\ncores/bench/test/conftest.py\ncores/bench/test/test_alu.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_imm_gen.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/test_reg_file.py\n// rtl/branch_predictor.sv\n//\n// Compact direct-control-flow predictor.  A sixteen-entry PC-indexed table\n// holds two-bit saturating direction counters for legal conditional branch\n// encodings.  Direct JALs always predict to their immediate target; JALR and\n// all other instructions remain sequential because this predictor has no\n// indirect target storage.\nmodule branch_predictor (\n  input  logic [31:0] lookup_pc,\n  input  logic [31:0] lookup_instr,\n  output logic [31:0] predicted_next_pc,\n\n  input  logic        train_valid,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0] train_pc,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic        train_taken,\n  input  logic        clock,\n  input  logic        reset\n);\n\n  localparam logic [6:0] OPCODE_BRANCH = 7'b1100011;\n  localparam logic [6:0] OPCODE_JAL    = 7'b1101111;\n\n  logic [1:0] counter_q [0:15];\n  logic [3:0] lookup_index;\n  logic [3:0] train_index;\n  logic       valid_branch;\n  logic       direct_jal;\n  logic [31:0] branch_imm;\n  logic [31:0] jal_imm;\n\n  assign lookup_index = lookup_pc[5:2];\n  assign train_index  = train_pc[5:2];\n\n  always_comb begin\n    // funct3=2/3 are reserved B-type encodings.  Do not let an illegal\n    // instruction steer fetch speculatively.\n    valid_branch = lookup_instr[6:0] == OPCODE_BRANCH\n                && lookup_instr[14:12] != 3'd2\n                && lookup_instr[14:12] != 3'd3;\n    direct_jal = lookup_instr[6:0] == OPCODE_JAL;\n    branch_imm = {{19{lookup_instr[31]}}, lookup_instr[31], lookup_instr[7],\n                  lookup_instr[30:25], lookup_instr[11:8], 1'b0};\n    jal_imm = {{11{lookup_instr[31]}}, lookup_instr[31], lookup_instr[19:12],\n               lookup_instr[20], lookup_instr[30:21], 1'b0};\n\n    predicted_next_pc = lookup_pc + 32'd4;\n    if (direct_jal)\n      predicted_next_pc = lookup_pc + jal_imm;\n    else if (valid_branch && counter_q[lookup_index][1])\n      predicted_next_pc = lookup_pc + branch_imm;\n  end\n\n  // Reset to weakly-not-taken.  A loop's first taken iteration trains the\n  // entry, and following iterations avoid the branch recovery bubbles.\n  integer i;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (i = 0; i < 16; i = i + 1)\n        counter_q[i] <= 2'b01;\n    end else if (train_valid) begin\n      if (train_taken) begin\n        if (counter_q[train_index] != 2'b11)\n          counter_q[train_index] <= counter_q[train_index] + 2'b01;\n      end else if (counter_q[train_index] != 2'b00) begin\n        counter_q[train_index] <= counter_q[train_index] - 2'b01;\n      end\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
