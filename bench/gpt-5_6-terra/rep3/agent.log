{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,130p' cores/bench/test/_helpers.py && sed -n '1,140p' /private/tmp/bench-shadow-formal-run16.out | tail -10 && rg -n 'ERROR|failed|FAIL|Killed' /private/tmp/bench-shadow-formal-run16.out | tail -20\"","aggregated_output":"\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\nSBY 15:23:40 [insn_beq_ch0] engine_0: smtbmc bitwuzla\nSBY 15:23:40 [insn_bgeu_ch0] Copy '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/../../checks/rvfi_macros.vh' to '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/checks/insn_bgeu_ch0/src/rvfi_macros.vh'.\nSBY 15:23:40 [insn_beq_ch0] base: starting process \"cd insn_beq_ch0/src; yosys -ql ../model/design.log ../model/design.ys\"\nSBY 15:23:40 [insn_andi_ch0] base: starting process \"cd insn_andi_ch0/src; yosys -ql ../model/design.log ../model/design.ys\"\nSBY 15:23:40 [insn_bgeu_ch0] Copy '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/../../checks/rvfi_channel.sv' to '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/checks/insn_bgeu_ch0/src/rvfi_channel.sv'.\nSBY 15:23:40 [insn_bgeu_ch0] Copy '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/../../checks/rvfi_testbench.sv' to '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/checks/insn_bgeu_ch0/src/rvfi_testbench.sv'.\nSBY 15:23:40 [insn_bgeu_ch0] Copy '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/../../checks/rvfi_insn_check.sv' to '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/checks/insn_bgeu_ch0/src/rvfi_insn_check.sv'.\nSBY 15:23:40 [insn_bgeu_ch0] Copy '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/../../insns/insn_bgeu.v' to '/private/tmp/bench-shadow-formal/formal/riscv-formal/cores/bench-22167/checks/insn_bgeu_ch0/src/insn_bgeu.v'.\nSBY 15:23:40 [insn_bgeu_ch0] engine_0: smtbmc bitwuzla\nSBY 15:23:40 [insn_bgeu_ch0] base: starting process \"cd insn