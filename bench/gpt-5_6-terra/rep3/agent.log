{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"git diff --check && git status --short && git diff -- cores/bench/rtl/alu.sv cores/bench/test/test_alu.py | sed -n '1,260p'\"","aggregated_output":" M cores/bench/rtl/alu.sv\n M cores/bench/test/test_alu.py\ndiff --git a/cores/bench/rtl/alu.sv b/cores/bench/rtl/alu.sv\nindex c604b2c..5bbbb9b 100644\n--- a/cores/bench/rtl/alu.sv\n+++ b/cores/bench/rtl/alu.sv\n@@ -14,6 +14,30 @@\n //\n // Latency:        combinational (0 cycles).\n // RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\n+//\n+// These explicit leaf modules preserve the independent unsigned product\n+// cones through synthesis hierarchy. Both operands remain native RV32 width\n+// while the product retains all 64 bits.\n+/* verilator lint_off DECLFILENAME */\n+(* keep_hierarchy = \"yes\" *)\n+module rv32_mul_uu (\n+  input  logic [31:0] a,\n+  input  logic [31:0] b,\n+  output logic [63:0] product\n+);\n+  always_comb product = a * b;\n+endmodule\n+\n+(* keep_hierarchy = \"yes\" *)\n+module rv32_mul_su_base (\n+  input  logic [31:0] a,\n+  input  logic [31:0] b,\n+  output logic [63:0] product\n+);\n+  always_comb product = a * b;\n+endmodule\n+/* verilator lint_on DECLFILENAME */\n+\n module alu (\n   input  logic [4:0]  op,\n   input  logic [31:0] a,\n@@ -23,7 +47,10 @@ module alu (\n \n   logic        [4:0]  shamt;\n \n-  // 64-bit products, computed once and selected per op.\n+  // 64-bit products, computed once and selected per op.  Keep the operands\n+  // at their architectural RV32 widths: the result assignment provides the\n+  // 64-bit product precision without building explicit 64-bit extensions in\n+  // front of each independent multiplier cone.\n   // mul_ss/mul_su low halves are unused (only MULH/MULHSU read the high\n   // half). Verilator's UNUSEDSIGNAL is silenced locally — the unused\n   // bits are dead-code-eliminated by Yosys.\n@@ -31,8 +58,24 @@ module alu (\n   logic signed [63:0] mul_ss;  // signed*signed\n   logic        [63:0] mul_uu;  // unsigned*unsigned (both halves used)\n   logic signed [63:0] mul_su;  // signed*unsigned (a signed, b unsigned)\n+  // Keep the MULHSU unsigned base product distinct from MULHU's product.\n+  // This preserves the three fixed multiplier cones rather than allowing\n+  // common-subexpression elimination to turn them into a shared multiplier.\n+  logic [63:0] mul_su_unsigned;\n   /* verilator lint_on UNUSEDSIGNAL */\n \n+  rv32_mul_uu u_mul_uu (\n+    .a       (a),\n+    .b       (b),\n+    .product (mul_uu)\n+  );\n+\n+  rv32_mul_su_base u_mul_su_base (\n+    .a       (a),\n+    .b       (b),\n+    .product (mul_su_unsigned)\n+  );\n+\n   // DIV/DIVU/REM/REMU share one unsigned magnitude datapath.  Signed\n   // operations convert both operands to magnitudes before the divide, then\n   // restore the quotient sign (sign(a) ^ sign(b)) or remainder sign\n@@ -49,9 +92,14 @@ module alu (\n   always_comb begin\n     shamt = b[4:0];\n \n-    mul_ss = $signed({{32{a[31]}}, a}) * $signed({{32{b[31]}}, b});\n-    mul_uu = {32'b0, a} * {32'b0, b};\n-    mul_su = $signed({{32{a[31]}}, a}) * $signed({32'b0, b});\n+    mul_ss = $signed(a) * $signed(b);\n+    // A mixed signed/unsigned `*` coerces both operands unsigned in\n+    // SystemVerilog.  Compute an independent native 32x32 unsigned product,\n+    // then subtract b*2^32 when a denotes a negative signed integer. This is\n+    // exactly (signed(a) * unsigned(b)) while leaving multiplier inputs at\n+    // RV32 width.\n+    mul_su = mul_su_unsigned;\n+    if (a[31]) mul_su = mul_su_unsigned - ({32'b0, b} << 32);\n \n     div_signed_op         = (op == ALU_DIV) || (op == ALU_REM);\n     div_a_magnitude       = a;\ndiff --git a/cores/bench/test/test_alu.py b/cores/bench/test/test_alu.py\nindex 3899961..dbb30eb 100644\n--- a/cores/bench/test/test_alu.py\n+++ b/cores/bench/test/test_alu.py\n@@ -49,6 +49,24 @@ def _rv32_divrem(op, a, b):\n     return quotient if op == ALU_DIVU else a - quotient * b\n \n \n+def _rv32_mul(op, a, b):\n+    \"\"\"Reference every RV32M multiply result half with Python integers.\"\"\"\n+    a &= MASK32\n+    b &= MASK32\n+    if op == ALU_MUL:\n+        product = a * b\n+        return product & MASK32\n+    if op == ALU_MULH:\n+        product = _signed32(a) * _signed32(b)\n+    elif op == ALU_MULHU:\n+        product = a * b\n+    elif op == ALU_MULHSU:\n+        product = _signed32(a) * b\n+    else:\n+        raise ValueError(f\"not a multiply op: {op}\")\n+    return (product >> 32) & MASK32\n+\n+\n async def _setup(dut):\n     \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n     `await _setup(dut)` for parity with other test files.\"\"\"\n@@ -173,6 +191,34 @@ async def mulhsu(dut):\n     await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n \n \n+@cocotb.test()\n+async def mul_family_native_width_boundaries_and_random(dut):\n+    \"\"\"Cover both halves and signedness combinations after width tightening.\"\"\"\n+    await _setup(dut)\n+    directed = [\n+        (0x00000000, 0xFFFFFFFF),\n+        (0x00000001, 0xFFFFFFFF),\n+        (0xFFFFFFFF, 0x00000001),\n+        (0xFFFFFFFF, 0xFFFFFFFF),\n+        (0x80000000, 0x00000001),\n+        (0x80000000, 0xFFFFFFFF),\n+        (0x80000001, 0x7FFFFFFF),\n+        (0x7FFFFFFF, 0x80000000),\n+        (0x40000000, 0x40000000),\n+    ]\n+    mul_ops = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\n+    for a, b in directed:\n+        for op in mul_ops:\n+            await _check(dut, op, a, b, _rv32_mul(op, a, b))\n+\n+    rng = random.Random(0x4D554C32)\n+    for _ in range(96):\n+        a = rng.getrandbits(32)\n+        b = rng.getrandbits(32)\n+        for op in mul_ops:\n+            await _check(dut, op, a, b, _rv32_mul(op, a, b))\n+\n+\n @cocotb.test()\n async def div_signed(dut):\n     await _setup(dut)\n","exit_code":0,"status":"completed"}}
