: \"Add a signed/unsigned iterative restoring divider with quotient/remainder selection and explicit divide-by-zero and INT_MIN/-1 handling.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Dispatch divide-class ALU operations to the divider, hold their EX payload until response, and emit one normal EX/MEM result on completion.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add an MDU-busy interlock that freezes fetch/decode and preserves retirement ordering while a divide is in flight.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the divider request/response and busy interlock into the existing in-order pipeline.\"}, {\"file\": \"test/test_alu.py\", \"description\": \"Keep exact RV32M divide and remainder corner-case coverage against the new execution path.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 8, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove real combinational DIV/DIVU/REM/REMU arithmetic from the normal ALU and retain only the ALTOPS formal behavior where required.\"}, {\"file\": \"rtl/divider.sv\", \"description\": \"Add a signed/unsigned iterative restoring divider with quotient/remainder selection and explicit divide-by-zero and INT_MIN/-1 handling.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Dispatch divide-class ALU operations to the divider, hold their EX payload until response, and emit one normal EX/MEM result on completion.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add an MDU-busy interlock that freezes fetch/decode and preserves retirement ordering while a divide is in flight.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the divider request/response and busy interlock into the existing in-order pipeline.\"}, {\"file\": \"test/test_alu.py\", \"description\": \"Keep exact RV32M divide and remainder corner-case coverage against the new execution path.\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false