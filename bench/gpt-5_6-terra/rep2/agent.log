f.core__DOT__u_ex__DOT__reg_q[7U] \ncores/bench/obj_dir/Vcore___024root__0.cpp:1540:    vlSelfRef.__VdfgRegularize_hebeb780c_0_1 = (vlSelfRef.io_dmemRData \ncores/bench/obj_dir/Vcore___024root__0.cpp:1545:    vlSelfRef.core__DOT__stall_ex_mem = ((~ (IData)(vlSelfRef.io_dmemReady)) \ncores/bench/obj_dir/Vcore___024root__0.cpp:1579:    vlSelfRef.io_dmemWEn = ((1U & ((vlSelfRef.core__DOT__u_ex__DOT__reg_q[1U] \ncores/bench/obj_dir/Vcore___024root__0.cpp:1583:    vlSelfRef.io_dmemREn = (1U & ((vlSelfRef.core__DOT__u_ex__DOT__reg_q[1U] \ncores/bench/obj_dir/Vcore___024root__0.cpp:1593:    vlSelfRef.io_dmemAddr = ((vlSelfRef.core__DOT__u_ex__DOT__reg_q[8U] \ncores/bench/obj_dir/Vcore___024root__0.cpp:1703:                                            ? vlSelfRef.io_dmemAddr\ncores/bench/obj_dir/Vcore___024root__0.cpp:1713:                                            ? vlSelfRef.io_dmemAddr\ncores/bench/obj_dir/Vcore___024root__0.cpp:2348:    if (VL_UNLIKELY(((vlSelfRef.io_dmemReady & 0xfeU)))) {\ncores/bench/obj_dir/Vcore___024root__0.cpp:2349:        Verilated::overWidthError(\"io_dmemReady\");\ncores/bench/test/test_reg_file.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/test_imm_gen.py\ncores/bench/test/test_decoder.py\ncores/bench/test/conftest.py\ncores/bench/test/test_alu.py\n// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the full rationale on LFSR-driven imem, dmem\n// model, and the XOR-reduce LED that keeps RVFI fan-out alive through\n// dead-output elimination.\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI fan-out (NRET=1 contract).\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  core cpu (\n    .clock            (clock),\n    .reset            (reset),\n    .io_imemAddr      (imem_addr),\n    .io_imemData      (lfsr),\n    .io_imemReady     (1'b1),\n    .io_dmemAddr      (dmem_addr),\n    .io_dmemWData     (dmem_wdata),\n    .io_dmemRData     (dmem_rdata),\n    .io_dmemWEn       (dmem_wen),\n    .io_dmemREn       (dmem_ren),\n    .io_dmemReady     (1'b1),\n    .io_rvfi_valid_0    (rvfi_valid_0),\n    .io_rvfi_order_0    (rvfi_order_0),\n    .io_rvfi_insn_0     (rvfi_insn_0),\n    .io_rvfi_trap_0     (rvfi_trap_0),\n    .io_rvfi_halt_0     (rvfi_halt_0),\n    .io_rvfi_intr_0     (rvfi_intr_0),\n    .io_rvfi_mode_0     (rvfi_mode_0),\n    .io_rvfi_ixl_0      (rvfi_ixl_0),\n    .io_rvfi_rs1_addr_0 (rvfi_rs1_addr_0),\n    .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata_0),\n    .io_rvfi_rs2_addr_0 (rvfi_rs2_addr_0),\n    .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata_0),\n    .io_rvfi_rd_addr_0  (rvfi_rd_addr_0),\n    .io_rvfi_rd_wdata_0 (rvfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // XOR-reduce all CPU outputs to a single LED bit. Without this,\n  // dead-output elimination would prune the RVFI fan-out.\n  assign led = ^{rvfi_valid_0, rvfi_order_0, rvfi_insn_0, rvfi_trap_0, rvfi_halt_0, rvfi_intr_0,\n                 rvfi_mode_0, rvfi_ixl_0, rvfi_rs1_addr_0, rvfi_rs1_rdata_0,\n                 rvfi_rs2_addr_0, rvfi_rs2_rdata_0, rvfi_rd_addr_0, rvfi_rd_wdata_0,\n                 rvfi_pc_rdata_0, rvfi_pc_wdata_0, rvfi_mem_addr_0,\n                 rvfi_mem_rmask_0, rvfi_mem_wmask_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0,\n                 imem_addr, dmem_rdata};\n\nendmodule\n{\"id\": \"baseline-bench-d2637a0\", \"title\": \"Baseline retest for cores/bench\", \"category\": \"micro_opt\", \"outcome\": \"improvement\", \"fitness\": 282.82, \"delta_pct\": 0.0, \"vs_baseline\": 0.0, \"fmax_mhz\": 127.03, \"ipc_coremark\": 2e-06, \"cycles\": 4491485, \"iterations\": 10, \"lut4\": 9563, \"ff\": 1866, \"seeds\": [128.72, 127.03, 123.02], \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-07-11T00:54:39.837121Z\", \"round_id\": 0, \"slot\": 0}\n{\"id\": \"hyp-20260710-001-r1s0\", \"title\": \"Iterative RV32M divide unit\", \"category\": \"micro_opt\", \"motivation\": \"The routed Fmax critical path is the combinational divide/remainder network\\nfrom the ID/EX register into the EX/MEM register. It is a long LUT-and-mux\\nchain, while the CoreMark timed loop executes after the setup-time DIVU\\ninstructions, so replacing it need not reduce measured IPC.\\n\", \"hypothesis\": {\"motivation\": \"The routed Fmax critical path is the combinational divide/remainder network\\nfrom the ID/EX register into the EX/MEM register. It is a long LUT-and-mux\\nchain, while the CoreMark timed loop executes after the setup-time DIVU\\ninstructions, so replacing it need not reduce measured IPC.\\n\", \"hypothesis\": \"Replace the inferred combinational DIV/DIVU/REM/REMU operators with a\\nsmall restoring iterative divider. On a divide or remainder instruction,\\nEX will issue the operands into the unit, drain older pipeline work, hold\\nthe frontend until completion, then inject one normal EX/MEM result. Keep\\nall RV32M corner cases exact and retain the ALTOPS behavior for formal.\\nThis removes the measured critical combinational path while confining the\\nmulti-cycle penalty to the rare non-timed divide operations.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 10, \"confidence\": \"high\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove real combinational divide/remainder operators from the Fmax path while preserving the RISCV_FORMAL_ALTOPS cases.\"}, {\"file\": \"rtl/divider.sv\", \"description\": \"Add a sequential unsigned restoring divider with signed pre/post-processing and architecturally defined zero and overflow cases.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Issue DIV/DIVU/REM/REMU to the divider, hold their pipeline payload until completion, and inject the returned result once.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add a divide-in-flight interlock that preserves program order without duplicate retirement or writeback.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the divide interlock and result path between execute, hazard control, and the new divider.\"}, {\"file\": \"test/test_alu.py\", \"description\": \"Extend RV32M coverage for iterative DIV/DIVU/REM/REMU latency and all specified corner cases.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 10, \"confidence\": \"high\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove real combinational divide/remainder operators from the Fmax path while preserving the RISCV_FORMAL_ALTOPS cases.\"}, {\"file\": \"rtl/divider.sv\", \"description\": \"Add a sequential unsigned restoring divider with signed pre/post-processing and architecturally defined zero and overflow cases.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Issue DIV/DIVU/REM/REMU to the divider, hold their pipeline payload until completion, and inject the returned result once.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add a divide-in-flight interlock that preserves program order without duplicate retirement or writeback.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire the divide interlock and result path between execute, hazard control, and the new divider.\"}, {\"file\": \"test/test_alu.py\", \"description\": \"Extend RV32M coverage for iterative DIV/DIVU/REM/REMU latency and all specified corner cases.\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"cosim_failed: selftest.elf\", \"slot\": 0, \"round_id\": 1}\n{\"id\": \"hyp-20260710-002-r1s1\", \"title\": \"Iterative divider execution unit\", \"category\": \"structural\", \"motivation\": \"The ALU unconditionally elaborates signed and unsigned divide and remainder\\ndatapaths, although CoreMark's timed kernels are dominated by loads, integer\\nALU operations, branches, and multiply-accumulate work. Four combinational\\ndivision/modulo expressions consume scarce LUT fabric and can set the slowest\\nALU route, limiting Fmax to 127 MHz near the LUT budget.\\n\", \"hypothesis\": {\"motivation\": \"The ALU unconditionally elaborates signed and unsigned divide and remainder\\ndatapaths, although CoreMark's timed kernels are dominated by loads, integer\\nALU operations, branches, and multiply-accumulate work. Four combinational\\ndivision/modulo expressions consume scarce LUT fabric and can set the slowest\\nALU route, limiting Fmax to 127 MHz near the LUT budget.\\n\", \"hypothesis\": \"Replace the combinational DIV/DIVU/REM/REMU implementation with one shared\\n32-cycle restoring divider that stalls the in-order execute path only for an\\nM divide/remainder instruction. Preserve the existing single-cycle path for\\nall other ALU and multiply operations. The rare divide latency should be\\noutside, or negligible within, the timed CoreMark kernel, while removing the\\nwide combinational divider should improve placement headroom and Fmax enough\\nto raise Fmax times CoreMark IPC.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 7, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove the synthesised combinational DIV/DIVU/REM/REMU datapaths while retaining the real and RISCV_FORMAL_ALTOPS semantics for non-divide ALU operations.\"}, {\"file\": \"rtl/divider_unit.sv\", \"description\": \"Add a shared signed/unsigned iterative restoring divider with request, busy, completion, quotient, and remainder interfaces, including all RV32M divide-by-zero and INT_MIN/-1 corner cases.\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add compact control metadata identifying the four divide/remainder ALU operations for execute-stage dispatch.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Turn EX into a small execute sequencer: launch divider operations once, hold the instruction and redirect state while busy, and emit the completed quotient or remainder exactly once into EX/MEM.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add an execute-busy interlock that freezes younger IF/ID and ID/EX work without duplicating retirements or losing redirects.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire divider-busy control into the pipeline stall policy while preserving the existing RVFI retirement boundary and nret=1 IO contract.\"}, {\"file\": \"test/test_alu.py\", \"description\": \"Keep exact RV32M division and remainder edge-case coverage against the new functional-unit result path.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add directed DIV/REM dependency and bus-stall tests to verify a single retirement, correct forwarding, and progress through the multi-cycle EX hold.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 7, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove the synthesised combinational DIV/DIVU/REM/REMU datapaths while retaining the real and RISCV_FORMAL_ALTOPS semantics for non-divide ALU operations.\"}, {\"file\": \"rtl/divider_unit.sv\", \"description\": \"Add a shared signed/unsigned iterative restoring divider with request, busy, completion, quotient, and remainder interfaces, including all RV32M divide-by-zero and INT_MIN/-1 corner cases.\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Add compact control metadata identifying the four divide/remainder ALU operations for execute-stage dispatch.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Turn EX into a small execute sequencer: launch divider operations once, hold the instruction and redirect state while busy, and emit the completed quotient or remainder exactly once into EX/MEM.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Add an execute-busy interlock that freezes younger IF/ID and ID/EX work without duplicating retirements or losing redirects.\"}, {\"file\": \"rtl/core.sv\", \"description\": \"Wire divider-busy control into the pipeline stall policy while preserving the existing RVFI retirement boundary and nret=1 IO contract.\"}, {\"file\": \"test/test_alu.py\", \"description\": \"Keep exact RV32M division and remainder edge-case coverage against the new functional-unit result path.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Add directed DIV/REM dependency and bus-stall tests to verify a single retirement, correct forwarding, and progress through the multi-cycle EX hold.\"}], \"outcome\": \"broken\", \"formal_passed\": false, \"cosim_passed\": false, \"error\": \"cosim_failed: selftest.elf\", \"slot\": 1, \"round_id\": 1}\n{\"id\": \"hyp-20260710-003-r1s2\", \"title\": \"Static loop branch prediction\", \"category\": \"predictor\", \"motivation\": \"The five-stage core always fetches PC+4 until EX resolves a branch or\\njump, so every taken loop back-edge discards useful fetch/decode work.\\nCoreMark contains many short counted loops, making this recurring control\\nhazard a material IPC limiter even with the zero-wait FPGA instruction bus.\\n\", \"hypothesis\": {\"motivation\": \"The five-stage core always fetches PC+4 until EX resolves a branch or\\njump, so every taken loop back-edge discards useful fetch/decode work.\\nCoreMark contains many short counted loops, making this recurring control\\nhazard a material IPC limiter even with the zero-wait FPGA instruction bus.\\n\", \"hypothesis\": \"Add a combinational static BTFNT predictor in IF: predict direct JALs and\\nbackward conditional branches taken, using their encoded PC-relative\\nimmediate, and otherwise predict fall-through. Carry the prediction with\\nthe instruction and have EX redirect and flush only on a misprediction;\\nJALR remains fall-through predicted. Correct loop-back predictions admit\\nthe target instruction into decode instead of paying the current recovery\\nbubble, while avoiding the LUT and timing cost of a BTB or dynamic table.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/if_stage.sv\", \"description\": \"Decode direct control-flow immediates at fetch, select static BTFNT/JAL next PC, and accept EX recovery only for mispredictions.\"}, {\"file\": \"rtl/core_pkg.sv\", \"description\": \"Extend IF/ID and ID/EX payloads with prediction metadata needed to validate speculative fetch in EX.\"}, {\"file\": \"rtl