_w.rs1_addr;\ncores/bench/rtl/core.sv:229:    io_rvfi_rs1_rdata_0 = mem_wb_w.rs1_val;\ncores/bench/rtl/core.sv:230:    io_rvfi_rs2_addr_0  = mem_wb_w.rs2_addr;\ncores/bench/rtl/core.sv:231:    io_rvfi_rs2_rdata_0 = mem_wb_w.rs2_val;\ncores/bench/rtl/core.sv:232:    io_rvfi_rd_addr_0   = rd_wen ? mem_wb_w.rd : 5'b0;\ncores/bench/rtl/core.sv:233:    io_rvfi_rd_wdata_0  = rd_wen ? wb_w_data   : 32'b0;\ncores/bench/rtl/core.sv:234:    io_rvfi_pc_rdata_0  = mem_wb_w.pc;\ncores/bench/rtl/core.sv:235:    io_rvfi_pc_wdata_0  = mem_wb_w.pc_next;\ncores/bench/rtl/core.sv:236:    io_rvfi_mem_addr_0  = mem_wb_w.mem_addr;\ncores/bench/rtl/core.sv:237:    io_rvfi_mem_rmask_0 = mem_wb_w.mem_rmask;\ncores/bench/rtl/core.sv:238:    io_rvfi_mem_wmask_0 = mem_wb_w.mem_wmask;\ncores/bench/rtl/core.sv:239:    io_rvfi_mem_rdata_0 = mem_wb_w.mem_rdata;\ncores/bench/rtl/core.sv:240:    io_rvfi_mem_wdata_0 = mem_wb_w.mem_wdata;\ncores/bench/rtl/ex_stage.sv:99:  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\ncores/bench/rtl/decoder.sv:9:// not explicitly recognised below traps via rvfi_trap.\ncores/bench/rtl/decoder.sv:20:// RVFI fields:    feeds rvfi_trap (= is_illegal at retirement), and all\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"The strongest remaining micro-optimization is to register the RVFI trace at retirement. The FPGA wrapper deliberately XOR-reduces every RVFI field into the LED, so today MEM/WB’s wide trace/mux cone also drives a physical output path. A trace register can isolate that fanout without changing execution, memory timing, or IPC."}}
