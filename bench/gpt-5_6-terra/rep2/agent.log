      dmem_stall_count += 1\ncores/bench/test/test_pipeline.py:166:        dut.io_dmemReady.value = int(dmem_ready)\ncores/bench/test/test_pipeline.py:170:    if dmem_backpressure:\ncores/bench/test/test_pipeline.py:171:        assert dmem_stall_count > 0, \"backpressure test did not stall dmem\"\ncores/bench/test/test_pipeline.py:172:    return retirements, dmem\ncores/bench/test/test_pipeline.py:221:    rets, dmem = await _run(dut, program)\ncores/bench/test/test_pipeline.py:224:    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\ncores/bench/test/test_pipeline.py:233:    rets, dmem = await _run(dut, program, dmem_init={0: 0x89ABCDEF})\ncores/bench/test/test_pipeline.py:235:    assert dmem[4] == 0x89ABCDEF\ncores/bench/test/test_pipeline.py:249:    rets, _ = await _run(dut, program, dmem_init={0: 0})\ncores/bench/test/test_pipeline.py:256:async def load_forwarding_survives_random_dmem_backpressure(dut):\ncores/bench/test/test_pipeline.py:262:    rets, dmem = await _run(\ncores/bench/test/test_pipeline.py:263:        dut, program, dmem_init={0: 0x20}, dmem_backpressure=True,\ncores/bench/test/test_pipeline.py:265:    assert dmem[4] == 0x27\ncores/bench/test/test_pipeline.py:271:        \"dmem backpressure did not hold the pipeline\"\ncores/bench/test/test_pipeline.py:386:    rets, dmem = await _run(dut, program)\ncores/bench/test/test_pipeline.py:389:    assert dmem.get(0) == val\ncores/bench/test/test_pipeline.py:458:            \"mem_stage.sv\", \"wb_stage.sv\",\ncores/bench/test/test_pipeline.py:459:            \"hazard_unit.sv\", \"forward_unit.sv\",\ncores/bench/rtl/reg_file.sv:13:// fine here; explicit BRAM attribution lives on the larger imem/dmem\ncores/bench/rtl/if_stage.sv:65:  // redirect on the same cycle as imem_stall or dmem_stall — without\ncores/bench/rtl/core.sv:9://   +- stall <- hazard_unit (bus backpressure / redirect recovery)\ncores/bench/rtl/core.sv:36:  // dmem\ncores/bench/rtl/core.sv:37:  output logic [31:0] io_dmemAddr,\ncores/bench/rtl/core.sv:38:  input  logic [31:0] io_dmemRData,\ncores/bench/rtl/core.sv:39:  output logic [31:0] io_dmemWData,\ncores/bench/rtl/core.sv:40:  output logic [3:0]  io_dmemWEn,\ncores/bench/rtl/core.sv:41:  output logic        io_dmemREn,\ncores/bench/rtl/core.sv:42:  // dmem bus backpressure. Drive 1 for zero-wait. Drive 0 to model\ncores/bench/rtl/core.sv:46:  input  logic        io_dmemReady,\ncores/bench/rtl/core.sv:155:  mem_stage u_mem (\ncores/bench/rtl/core.sv:160:    .dmem_addr  (io_dmemAddr),\ncores/bench/rtl/core.sv:161:    .dmem_wdata (io_dmemWData),\ncores/bench/rtl/core.sv:162:    .dmem_rdata (io_dmemRData),\ncores/bench/rtl/core.sv:163:    .dmem_wen   (io_dmemWEn),\ncores/bench/rtl/core.sv:164:    .dmem_ren   (io_dmemREn),\ncores/bench/rtl/core.sv:179:  hazard_unit u_hazard (\ncores/bench/rtl/core.sv:182:    .dmem_ready     (io_dmemReady),\ncores/bench/rtl/hazard_unit.sv:1:// rtl/hazard_unit.sv\ncores/bench/rtl/hazard_unit.sv:5:// combinational MEM-stage result.  A dmem stall still freezes both the load\ncores/bench/rtl/hazard_unit.sv:18:module hazard_unit (\ncores/bench/rtl/hazard_unit.sv:24:  input  logic       dmem_ready,\ncores/bench/rtl/hazard_unit.sv:25:  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\ncores/bench/rtl/hazard_unit.sv:39:  logic dmem_stall;\ncores/bench/rtl/hazard_unit.sv:43:    // dmem stall only matters if there's actually a memory op in EX/MEM\ncores/bench/rtl/hazard_unit.sv:45:    dmem_stall = !dmem_ready && ex_mem_mem_op;\ncores/bench/rtl/hazard_unit.sv:48:    stall_if      = imem_stall || dmem_stall;\ncores/bench/rtl/hazard_unit.sv:54:    //   - dmem_stall  -> hold        (preserve in-flight pipeline state)\ncores/bench/rtl/hazard_unit.sv:57:    // dmem_stall takes precedence over redirect's bubble so the in-flight\ncores/bench/rtl/hazard_unit.sv:60:    stall_id      = dmem_stall;\ncores/bench/rtl/hazard_unit.sv:61:    flush_id      = redirect && !dmem_stall;\ncores/bench/rtl/hazard_unit.sv:62:    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\ncores/bench/rtl/hazard_unit.sv:64:    stall_ex_mem  = dmem_stall;\ncores/bench/rtl/hazard_unit.sv:65:    // MEM/WB register: on dmem_stall the previously-retired instruction's\ncores/bench/rtl/hazard_unit.sv:69:    hold_mem_wb   = dmem_stall;\ncores/bench/rtl/forward_unit.sv:8://   11 (MEM_LOAD): extracted dmem read data from the EX/MEM load's MEM stage\ncores/bench/rtl/ex_stage.sv:21:  input  logic               stall,         // freeze EX/MEM register (dmem stall)\ncores/bench/rtl/ex_stage.sv:27:  input  logic [31:0]        fwd_mem_load,  // combinational extracted dmem data\ncores/bench/rtl/ex_stage.sv:130:  // recovery.  During a dmem hold, EX/MEM and ID/EX are frozen; in\ncores/bench/rtl/ex_stage.sv:132:  // unacknowledged dmem value.  JALR remains sequentially predicted, so\ncores/bench/rtl/ex_stage.sv:145:      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n","exit_code":0,"status":"completed"}}
