es — no carry-over of operands or state from the previous op.\n\n  Line 225:     # Real divides only (avoid edge-case short-circuit) so each pass\n\n  Line 227:     await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n  Line 228:     await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n\n  Line 229:     await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n\n  Line 230:     await _check_div(dut, ALU_REM, 10, 3, 1)\n\n  Line 231:     await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_decoder.py:\n  Line 12:     ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n\n  Line 67:         (0x023140B3, ALU_DIV),\n\n  Line 68:         (0x023150B3, ALU_DIVU),\n\n  Line 69:         (0x023160B3, ALU_REM),\n\n  Line 70:         (0x023170B3, ALU_REMU),\n","metadata":{"matches":32,"truncated":false},"title":"DIV|REM|divide","time":{"start":1778835278531,"end":1778835278559}},"metadata":{"openai":{"itemId":"fc_0fde98c6f102d27d016a06df4e2964819a829627792ec7efeb"}},"id":"prt_e2ad849b0001cRYPGkAfacWUcM","sessionID":"ses_1d52925c1ffeNMU0NKEnVRJtki","messageID":"msg_e2ad82cdc0011bP4pgGZ83zGAX"}}
