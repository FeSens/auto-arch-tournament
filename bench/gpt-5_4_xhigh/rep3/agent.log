,\n170:     .store_queue_nonempty(store_queue_nonempty),\n171:     .store_queue_full    (store_queue_full),\n172:     .out        (mem_wb_w)\n173:   );\n174: \n175:   assign ex_mem_end_fence = ex_mem_w.valid && (ex_mem_w.instr == 32'h0010_0073);\n176: \n177:   // ── WB ────────────────────────────────────────────────────────────────\n178:   wb_stage u_wb (\n179:     .in     (mem_wb_w),\n180:     .w_en   (wb_w_en),\n181:     .w_addr (wb_w_addr),\n182:     .w_data (wb_w_data)\n183:   );\n184: \n185:   // ── Hazard / forwarding ───────────────────────────────────────────────\n186:   hazard_unit u_hazard (\n187:     .id_ex_mem_read (id_ex_w.ctrl.mem_read),\n188:     .id_ex_rd       (id_ex_w.rd),\n189:     .if_id_rs1      (if_id_w.instr[19:15]),\n190:     .if_id_rs2      (if_id_w.instr[24:20]),\n191:     .redirect       (redirect),\n192:     .imem_ready     (io_imemReady),\n193:     .dmem_ready     (io_dmemReady),\n194:     .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\n195:     .ex_mem_store_bufferable (ex_mem_store_bufferable),\n196:     .ex_mem_end_fence (ex_mem_end_fence),\n197:     .store_queue_nonempty (store_queue_nonempty),\n198:     .store_queue_full (store_queue_full),\n199:     .div_stall      (div_stall),\n200:     .stall_if       (stall_if),\n201:     .stall_id       (stall_id),\n202:     .flush_if       (flush_if),\n203:     .flush_id       (flush_id),\n204:     .stall_ex_mem   (stall_ex_mem),\n205:     .hold_mem_wb    (hold_mem_wb)\n206:   );\n207: \n208:   forward_unit u_fwd (\n209:     .id_ex_rs1   (id_ex_w.rs1_addr),\n210:     .id_ex_rs2   (id_ex_w.rs2_addr),\n211:     .ex_mem_rd   (ex_mem_w.rd),\n212:     .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\n\n(Showing lines 73-212 of 258. Use offset=213 to continue.)\n</content>","metadata":{"preview":"  // ── Inter-stage wires ──────────────────────────────────────────────────\n  if_id_t  if_id_w;\n  id_ex_t  id_ex_w;\n  ex_mem_t ex_mem_w;\n  mem_wb_t mem_wb_w;\n\n  // hazard / forward\n  lo