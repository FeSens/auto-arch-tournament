{"type":"tool_use","timestamp":1778871042694,"sessionID":"ses_1d30823c8ffeYwNOsLBK2i2tAE","part":{"type":"tool","tool":"read","callID":"call_Xd1fObKbpZrRr6GMLpjDxaWi","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py","offset":1,"limit":260},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py</path>\n<type>file</type>\n<content>\n1: \"\"\"End-to-end pipeline tests for rtl/core.sv.\n2: \n3: Drives a minimal Python-side imem/dmem against the core's combinational\n4: fetch/load model and captures RVFI retirements. Covers forwarding\n5: (EX->EX, MEM->EX), branches, JAL, JALR, SW+LW roundtrip, load-use stall,\n6: divide stall/retire behavior, and the trap discipline (illegal / ECALL\n7: trap, EBREAK does NOT trap).\n8: \"\"\"\n9: from __future__ import annotations\n10: \n11: import cocotb\n12: from cocotb.clock import Clock\n13: from cocotb.triggers import RisingEdge, Timer\n14: \n15: from _helpers import run_cocotb\n16: \n17: \n18: # ── RV32I instruction encoder helpers ──────────────────────────────────────\n19: def _r(funct7, rs2, rs1, funct3, rd, opcode):\n20:     return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n21:          | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n22: \n23: \n24: def _i(imm, rs1, funct3, rd, opcode):\n25:     return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n26:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n27: \n28: \n29: def _s(imm, rs2, rs1, funct3, opcode):\n30:     imm_hi = (imm >> 5) & 0x7F\n31:     imm_lo = imm & 0x1F\n32:     return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n33:          | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n34: \n35: \n36: def _b(imm, rs2, rs1, funct3, opcode):\n37:     # imm is a 13-bit signed number; bit 0 is implicitly zero.\n38:     b12  = (imm >> 12) & 1\n39:     b105 = (imm >> 5)  & 0x3F\n40:     b41  = (imm >> 1)  & 0xF\n41:     b11  = (imm >> 11) & 1\n42:     return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n43:          | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n44: \n45: \n46: def _j(imm, rd, opcode):\n47:     # 21-bit signed imm; bit 0 implicit zero.\n48:     b20    = (imm >> 20) & 1\n49:     b101   = (imm >> 1)  & 0x3FF\n50:     b11    = (imm >> 11) & 1\n51:     b1912  = (imm >> 12) & 0xFF\n52:     return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n53:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n54: \n55: \n56: def _u(imm20, rd, opcode):\n57:     return ((imm20 & 0xFFFFF) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n58: \n59: \n60: def ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\n61: def ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\n62: def DIVU(rd, rs1, rs2): return _r(0b0000001, rs2, rs1, 0b101, rd, 0b0110011)\n63: def LUI (rd, imm20):    return _u(imm20, rd, 0b0110111)\n64: def LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\n65: def SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\n66: def BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\n67: def JAL (rd, imm):       return _j(imm, rd, 0b1101111)\n68: def JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\n69: def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\n70: def EBREAK():            return 0x00100073\n71: def ECALL():             return 0x00000073\n72: \n73: \n74: # ── Harness ────────────────────────────────────────────────────────────────\n75: async def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready_fn=None):\n76:     \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n77: \n78:     imem is read combinationally each cycle from imemAddr; dmem similarly.\n79:     Stores get applied to the Python-side dmem dict only on cycles where\n80:     io_dmemReady is high, matching test/cosim/main.cpp's accepted-write model.\n81: \n82:     Returns (retirements, dmem) where retirements is a list of dicts\n83:     sampled on every cycle that rvfi_valid=1.\n84:     \"\"\"\n85:     imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n86:     dmem = dict(dmem_init or {})\n87:     retirements: list[dict] = []\n88: \n89:     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n90: \n91:     dut.reset.value = 1\n92:     dut.io_imemData.value = 0\n93:     dut.io_dmemRData.value = 0\n94:     # Zero-wait bus model: ready always asserted. The stall-mode tests\n95:     # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n96:     dut.io_imemReady.value = 1\n97:     dut.io_dmemReady.value = 1\n98:     for _ in range(3):\n99:         await RisingEdge(dut.clock)\n100: \n101:     # Deassert reset and prime the imem read for the first PC=0 fetch.\n102:     dut.reset.value = 0\n103: \n104:     for cycle in range(max_cycles):\n105:         ia = int(dut.io_imemAddr.value)\n106:         da = int(dut.io_dmemAddr.value)\n107:         dready = dmem_ready_fn(cycle, dut) if dmem_ready_fn else 1\n108: \n109:         dut.io_imemReady.value = 1\n110:         dut.io_dmemReady.value = dready\n111:         dut.io_imemData.value = imem.get(ia & ~3, EBREAK())\n112:         dut.io_dmemRData.value = dmem.get(da & ~3, 0) if _is_ram_addr(da) else 0\n113: \n114:         await Timer(1, \"ns\")  # let combinational request signals settle\n115: \n116:         wen = int(dut.io_dmemWEn.value)\n117:         if wen and dready and _is_ram_addr(int(dut.io_dmemAddr.value)):\n118:             wdata = int(dut.io_dmemWData.value)\n119:             wa = int(dut.io_dmemAddr.value) & ~3\n120:             old = dmem.get(wa, 0)\n121:             new = old\n122:             for i in range(4):\n123:                 if (wen >> i) & 1:\n124:                     bv = (wdata >> (i * 8)) & 0xFF\n125:                     new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n126:             dmem[wa] = new\n127: \n128:         await RisingEdge(dut.clock)\n129:         await Timer(1, \"ns\")  # let combinational signals settle\n130: \n131:         # Sample the post-edge state.\n132:         rvfi_v    = int(dut.io_rvfi_valid_0.value)\n133: \n134:         # Capture RVFI retirement.\n135:         if rvfi_v:\n136:             r = {\n137:                 \"order\":     int(dut.io_rvfi_order_0.value),\n138:                 \"insn\":      int(dut.io_rvfi_insn_0.value),\n139:                 \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n140:                 \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n141:                 \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n142:                 \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n143:                 \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n144:                 \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n145:                 \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n146:                 \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n147:                 \"trap\":      int(dut.io_rvfi_trap_0.value),\n148:                 \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n149:                 \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n150:                 \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n151:                 \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n152:                 \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n153:                 \"cycle\":     cycle,\n154:             }\n155:             retirements.append(r)\n156:             if r[\"insn\"] == EBREAK():\n157:                 break\n158:     else:\n159:         raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n160: \n161:     return retirements, dmem\n162: \n163: \n164: def _by_insn(retirements, insn):\n165:     \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n166:     return [r for r in retirements if r[\"insn\"] == insn]\n167: \n168: \n169: def _is_ram_addr(addr):\n170:     return 0 <= addr < 0x00100000\n171: \n172: \n173: class StallOnce:\n174:     \"\"\"Force one request to see a fixed-length dmem-ready low window.\"\"\"\n175: \n176:     def __init__(self, addr, stall_cycles):\n177:         self.addr = addr\n178:         self.stall_cycles = stall_cycles\n179:         self.remaining = 0\n180:         self.started = False\n181:         self.release_cycle = None\n182: \n183:     def __call__(self, cycle, dut):\n184:         if self.remaining > 0:\n185:             self.remaining -= 1\n186:             return 0\n187: \n188:         wen = int(dut.io_dmemWEn.value)\n189:         addr = int(dut.io_dmemAddr.value)\n190:         if not self.started and wen and addr == self.addr:\n191:             self.started = True\n192:             self.release_cycle = cycle + self.stall_cycles\n193:             self.remaining = max(self.stall_cycles - 1, 0)\n194:             return 0 if self.stall_cycles else 1\n195: \n196:         return 1\n197: \n198: \n199: # ── Tests ──────────────────────────────────────────────────────────────────\n200: @cocotb.test()\n201: async def forwarding_ex_to_ex(dut):\n202:     \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n203:     program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n204:     rets, _ = await _run(dut, program)\n205:     [r1] = _by_insn(rets, ADDI(1, 0, 5))\n206:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n207:     assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n208:     assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n209:         f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n210:     )\n211:     # Order must be strict +1.\n212:     orders = [r[\"order\"] for r in rets]\n213:     assert orders == list(range(orders[0], orders[0] + len(rets)))\n214: \n215: \n216: @cocotb.test()\n217: async def forwarding_mem_to_ex(dut):\n218:     \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n219:     program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n220:     rets, _ = await _run(dut, program)\n221:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n222:     assert r2[\"rd_wdata\"] == 8\n223: \n224: \n225: @cocotb.test()\n226: async def load_use_stalls(dut):\n227:     \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n228: \n229:     All immediates kept inside the signed 12-bit positive range so ADDI's\n230:     sign-extension doesn't muddy the expected values.\n231:     \"\"\"\n232:     program = [\n233:         ADDI(3, 0, 0x123),     # x3 = 0x123\n234:         ADDI(4, 0, 0x100),     # x4 = 0x100\n235:         SW  (3, 0, 0),         # mem[0] = x3\n236:         LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n237:         ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n238:         EBREAK(),\n239:     ]\n240:     rets, dmem = await _run(dut, program)\n241:     [r2] = _by_insn(rets, ADD(2, 1, 4))\n242:     assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n243:     assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n244: \n245: \n246: @cocotb.test()\n247: async def divide_stalls_younger_ops_and_retires_once(dut):\n248:     \"\"\"DIVU must hold younger issue until the quotient is ready, then retire once.\"\"\"\n249:     div_insn = DIVU(3, 1, 2)\n250:     add_insn = ADD(4, 3, 0)\n251:     program = [\n252:         ADDI(1, 0, 100),\n253:         ADDI(2, 0, 7),\n254:         div_insn,\n255:         add_insn,\n256:         EBREAK(),\n257:     ]\n258:     rets, _ = await _run(dut, program, max_cycles=300)\n259: \n260:     div_rets = _by_insn(rets, div_insn)\n\n(Showing lines 1-260 of 497. Use offset=261 to continue.)\n</content>","metadata":{"preview":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers forwarding\n(EX->EX, MEM->EX), branches, JAL, JALR, SW+LW roundtrip, load-use stall,\ndivide stall/retire behavior, and the trap discipline (illegal / ECALL\ntrap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\","truncated":true,"loaded":[]},"title":"cores/bench/test/test_pipeline.py","time":{"start":1778871042685,"end":1778871042694}},"metadata":{"openai":{"itemId":"fc_0ca7e9fca0a31920016a076b025960819995c14eba6f81b181"}},"id":"prt_e2cfa0195001m5kBXiq0mQ82wV","sessionID":"ses_1d30823c8ffeYwNOsLBK2i2tAE","messageID":"msg_e2cf9ef3f001C3fouumvSc6cub"}}
