     EBREAK(),\n+    ]\n+    rets, dmem = await _run(\n+        dut,\n+        program,\n+        dmem_ready_fn=stall,\n+        accepted_writes=accepted_writes,\n+    )\n+\n+    assert stall.started and stall.release_cycle is not None\n+    [rstore0] = _by_insn(rets, store0)\n+    [rstore1] = _by_insn(rets, store1)\n+    [ralu] = _by_insn(rets, alu_insn)\n+    [rebreak] = _by_insn(rets, EBREAK())\n+\n+    assert rstore0[\"cycle\"] < stall.release_cycle\n+    assert rstore1[\"cycle\"] < stall.release_cycle, (\n+        f\"second RAM store should retire into the queue before the first drain completes, saw store cycle {rstore1['cycle']} and release {stall.release_cycle}\"\n+    )\n+    assert ralu[\"cycle\"] < stall.release_cycle\n+    assert [w[\"addr\"] for w in accepted_writes] == [0, 4], (\n+        f\"deferred stores must drain oldest-first, saw commits {accepted_writes}\"\n+    )\n+    assert accepted_writes[1][\"cycle\"] > accepted_writes[0][\"cycle\"]\n+    assert rebreak[\"cycle\"] > accepted_writes[1][\"cycle\"], (\n+        f\"EBREAK must wait until both deferred stores commit, saw EBREAK cycle {rebreak['cycle']} and commits {accepted_writes}\"\n+    )\n+    assert dmem.get(0) == 0x111\n+    assert dmem.get(4) == 0x222\n+\n+\n+@cocotb.test()\n+async def deferred_store_queue_fences_later_load_until_drain(dut):\n+    \"\"\"A younger load must wait until every deferred store ahead of it commits.\"\"\"\n+    store0 = SW(1, 0, 0)\n+    store1 = SW(2, 0, 4)\n+    load1 = LW(4, 0, 4)\n+    stall = StallOnce(addr=0, stall_cycles=5)\n+    accepted_writes = []\n+    program = [\n+        ADDI(1, 0, 0x111),\n+        ADDI(2, 0, 0x222),\n+        store0,\n+        store1,\n+        load1,\n+        EBREAK(),\n+    ]\n+    rets, dmem = await _run(\n+        dut,\n+        program,\n+        dmem_ready_fn=stall,\n+        accepted_writes=accepted_writes,\n+    )\n+\n+    assert [w[\"addr\"] for w in accepted_writes] == [0, 4]\n+    [rload] = _by_insn(rets, load1)\n+    assert rload[\"rd_wdata\"] == 0x222\n+    assert rload[\"cycle\"] > accepted_writes[1][\"cycle\"], (\n+        f\"load must stay behind both deferred stores, saw load cycle {rload['cycle']} and commits {accepted_writes}\"\n+    )\n+    assert dmem.get(0) == 0x111\n+    assert dmem.get(4) == 0x222\n+\n+\n+@cocotb.test()\n async def mmio_store_stays_unbuffered_under_backpressure(dut):\n     \"\"\"UART/MMIO stores must not use the RAM store slot.\"\"\"\n     store_insn = SW(1, 5, 0)\n     alu_insn = ADDI(2, 0, 7)\n","additions":93,"deletions":1}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM cores/bench/test/test_pipeline.py","time":{"start":1778854425466,"end":1778854425487}},"metadata":{"openai":{"itemId":"fc_081c04b623df5e6d016a072a054014819ba98ec5665427d5fa"}},"id":"prt_e2bfc24d6001XJGsqEKeAaMQtG","sessionID":"ses_1d408eb53ffey4O9FrudRXGFYP","messageID":"msg_e2bfb6a810010PtDKaj4gQ9N8c"}}
