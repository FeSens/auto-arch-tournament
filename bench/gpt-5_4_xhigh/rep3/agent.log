{"type":"tool_use","timestamp":1778835286668,"sessionID":"ses_1d529263affeANfCjt74fFVOMY","part":{"type":"tool","tool":"read","callID":"call_Yim7UYjNWZobftbDcgTpuCX2","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py","offset":1,"limit":220},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py</path>\n<type>file</type>\n<content>\n1: \"\"\"End-to-end pipeline tests for rtl/core.sv.\n2: \n3: Drives a minimal Python-side imem/dmem against the core's combinational\n4: fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n5: acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\n6: SW+LW roundtrip, load-use stall, and the trap discipline (illegal /\n7: ECALL trap, EBREAK does NOT trap).\n8: \"\"\"\n9: from __future__ import annotations\n10: \n11: import cocotb\n12: from cocotb.clock import Clock\n13: from cocotb.triggers import RisingEdge, Timer\n14: \n15: from _helpers import run_cocotb\n16: \n17: \n18: # ── RV32I instruction encoder helpers ──────────────────────────────────────\n19: def _r(funct7, rs2, rs1, funct3, rd, opcode):\n20:     return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n21:          | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n22: \n23: \n24: def _i(imm, rs1, funct3, rd, opcode):\n25:     return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n26:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n27: \n28: \n29: def _s(imm, rs2, rs1, funct3, opcode):\n30:     imm_hi = (imm >> 5) & 0x7F\n31:     imm_lo = imm & 0x1F\n32:     return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n33:          | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n34: \n35: \n36: def _b(imm, rs2, rs1, funct3, opcode):\n37:     # imm is a 13-bit signed number; bit 0 is implicitly zero.\n38:     b12  = (imm >> 12) & 1\n39:     b105 = (imm >> 5)  & 0x3F\n40:     b41  = (imm >> 1)  & 0xF\n41:     b11  = (imm >> 11) & 1\n42:     return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n43:          | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n44: \n45: \n46: def _j(imm, rd, opcode):\n47:     # 21-bit signed imm; bit 0 implicit zero.\n48:     b20    = (imm >> 20) & 1\n49:     b101   = (imm >> 1)  & 0x3FF\n50:     b11    = (imm >> 11) & 1\n51:     b1912  = (imm >> 12) & 0xFF\n52:     return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n53:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n54: \n55: \n56: def ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\n57: def ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\n58: def LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\n59: def SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\n60: def BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\n61: def JAL (rd, imm):       return _j(imm, rd, 0b1101111)\n62: def JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\n63: def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\n64: def EBREAK():            return 0x00100073\n65: def ECALL():             return 0x00000073\n66: \n67: \n68: # ── Harness ────────────────────────────────────────────────────────────────\n69: async def _run(dut, program, dmem_init=None, max_cycles=200):\n70:     \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n71: \n72:     imem is read combinationally each cycle from imemAddr; dmem similarly.\n73:     Stores get applied to the Python-side dmem dict so subsequent loads\n74:     see the new value.\n75: \n76:     Returns (retirements, dmem) where retirements is a list of dicts\n77:     sampled on every cycle that rvfi_valid=1.\n78:     \"\"\"\n79:     imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n80:     dmem = dict(dmem_init or {})\n81:     retirements: list[dict] = []\n82: \n83:     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n84: \n85:     dut.reset.value = 1\n86:     dut.io_imemData.value = 0\n87:     dut.io_dmemRData.value = 0\n88:     # Zero-wait bus model: ready always asserted. The stall-mode tests\n89:     # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n90:     dut.io_imemReady.value = 1\n91:     dut.io_dmemReady.value = 1\n92:     for _ in range(3):\n93:         await RisingEdge(dut.clock)\n94: \n95:     # Deassert reset and prime the imem read for the first PC=0 fetch.\n96:     dut.reset.value = 0\n97:     dut.io_imemData.value = imem.get(0, EBREAK())\n98: \n99:     for cycle in range(max_cycles):\n100:         await RisingEdge(dut.clock)\n101:         await Timer(1, \"ns\")  # let combinational signals settle\n102: \n103:         # Sample the post-edge state.\n104:         ia        = int(dut.io_imemAddr.value)\n105:         da        = int(dut.io_dmemAddr.value)\n106:         wen       = int(dut.io_dmemWEn.value)\n107:         rvfi_v    = int(dut.io_rvfi_valid_0.value)\n108: \n109:         # Apply dmem write side effects.\n110:         if wen:\n111:             wdata = int(dut.io_dmemWData.value)\n112:             wa = da & ~3\n113:             old = dmem.get(wa, 0)\n114:             new = old\n115:             for i in range(4):\n116:                 if (wen >> i) & 1:\n117:                     bv = (wdata >> (i * 8)) & 0xFF\n118:                     new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n119:             dmem[wa] = new\n120: \n121:         # Capture RVFI retirement.\n122:         if rvfi_v:\n123:             r = {\n124:                 \"order\":     int(dut.io_rvfi_order_0.value),\n125:                 \"insn\":      int(dut.io_rvfi_insn_0.value),\n126:                 \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n127:                 \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n128:                 \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n129:                 \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n130:                 \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n131:                 \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n132:                 \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n133:                 \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n134:                 \"trap\":      int(dut.io_rvfi_trap_0.value),\n135:                 \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n136:                 \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n137:                 \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n138:                 \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n139:                 \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n140:                 \"cycle\":     cycle,\n141:             }\n142:             retirements.append(r)\n143:             if r[\"insn\"] == EBREAK():\n144:                 break\n145: \n146:         # Drive next cycle's imem fetch and dmem read combinationally.\n147:         dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n148:         dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n149:     else:\n150:         raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n151: \n152:     return retirements, dmem\n153: \n154: \n155: def _by_insn(retirements, insn):\n156:     \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n157:     return [r for r in retirements if r[\"insn\"] == insn]\n158: \n159: \n160: # ── Tests ──────────────────────────────────────────────────────────────────\n161: @cocotb.test()\n162: async def forwarding_ex_to_ex(dut):\n163:     \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n164:     program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n165:     rets, _ = await _run(dut, program)\n166:     [r1] = _by_insn(rets, ADDI(1, 0, 5))\n167:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n168:     assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n169:     assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n170:         f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n171:     )\n172:     # Order must be strict +1.\n173:     orders = [r[\"order\"] for r in rets]\n174:     assert orders == list(range(orders[0], orders[0] + len(rets)))\n175: \n176: \n177: @cocotb.test()\n178: async def forwarding_mem_to_ex(dut):\n179:     \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n180:     program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n181:     rets, _ = await _run(dut, program)\n182:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n183:     assert r2[\"rd_wdata\"] == 8\n184: \n185: \n186: @cocotb.test()\n187: async def load_use_stalls(dut):\n188:     \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n189: \n190:     All immediates kept inside the signed 12-bit positive range so ADDI's\n191:     sign-extension doesn't muddy the expected values.\n192:     \"\"\"\n193:     program = [\n194:         ADDI(3, 0, 0x123),     # x3 = 0x123\n195:         ADDI(4, 0, 0x100),     # x4 = 0x100\n196:         SW  (3, 0, 0),         # mem[0] = x3\n197:         LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n198:         ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n199:         EBREAK(),\n200:     ]\n201:     rets, dmem = await _run(dut, program)\n202:     [r2] = _by_insn(rets, ADD(2, 1, 4))\n203:     assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n204:     assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n205: \n206: \n207: @cocotb.test()\n208: async def branch_taken_skips(dut):\n209:     \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n210:     not merely retire with rd_wdata != 99. Asserting only the side effect\n211:     would let a wrong-path retirement with rd=0 / trap=1 / different data\n212:     pass silently.\"\"\"\n213:     program = [\n214:         BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n215:         ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n216:         ADDI(2, 0, 42),        # PC=8;  branch target\n217:         EBREAK(),\n218:     ]\n219:     rets, _ = await _run(dut, program)\n220:     # Strict: no retirement should originate from PC=4.\n\n(Showing lines 1-220 of 356. Use offset=221 to continue.)\n</content>","metadata":{"preview":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\","truncated":true,"loaded":[]},"title":"cores/bench/test/test_pipeline.py","time":{"start":1778835286661,"end":1778835286667}},"metadata":{"openai":{"itemId":"fc_0ddab4ee76e45f40016a06df563e5c8199806c2d76b44c21f1"}},"id":"prt_e2ad86952001iWY4fEXDltxMgv","sessionID":"ses_1d529263affeANfCjt74fFVOMY","messageID":"msg_e2ad8528c001m9bgxNm7idc194"}}
