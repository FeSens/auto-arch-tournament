{"type":"tool_use","timestamp":1778835270390,"sessionID":"ses_1d52925c1ffeNMU0NKEnVRJtki","part":{"type":"tool","tool":"read","callID":"call_5fwF59vvNBUXt1wQAmRYVRLh","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_alu.py","offset":1,"limit":260},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_alu.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Unit tests for rtl/alu.sv.\n2: \n3: The ALU is purely combinational (RV32IM). MUL / DIV / REM use the\n4: SystemVerilog `*`, `/`, `%` operators and resolve in zero cycles, so\n5: there is no clock, reset, or handshake on this module.\n6: \"\"\"\n7: from __future__ import annotations\n8: \n9: import cocotb\n10: from cocotb.triggers import Timer\n11: \n12: from _helpers import (\n13:     ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n14:     ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n15:     ALU_LUI,\n16:     ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n17:     ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n18:     run_cocotb,\n19: )\n20: \n21: MASK32 = 0xFFFFFFFF\n22: \n23: \n24: async def _setup(dut):\n25:     \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n26:     `await _setup(dut)` for parity with other test files.\"\"\"\n27:     return\n28: \n29: \n30: async def _check(dut, op, a, b, expected):\n31:     \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n32:     dut.op.value = op\n33:     dut.a.value  = a & MASK32\n34:     dut.b.value  = b & MASK32\n35:     await Timer(1, \"ns\")\n36:     actual = int(dut.out.value) & MASK32\n37:     assert actual == (expected & MASK32), (\n38:         f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n39:         f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n40:     )\n41: \n42: \n43: async def _check_div(dut, op, a, b, expected):\n44:     \"\"\"Combinational div/rem — alias for _check. Was a multi-cycle FSM\n45:     under hyp-20260427-002, reverted in 6688be7 (v2 reset).\"\"\"\n46:     await _check(dut, op, a, b, expected)\n47: \n48: \n49: @cocotb.test()\n50: async def add(dut):\n51:     await _setup(dut)\n52:     await _check(dut, ALU_ADD, 5, 3, 8)\n53:     await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n54: \n55: \n56: @cocotb.test()\n57: async def sub(dut):\n58:     await _setup(dut)\n59:     await _check(dut, ALU_SUB, 10, 3, 7)\n60:     await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n61: \n62: \n63: @cocotb.test()\n64: async def bitwise(dut):\n65:     await _setup(dut)\n66:     await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n67:     await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n68:     await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n69: \n70: \n71: @cocotb.test()\n72: async def slt_signed(dut):\n73:     await _setup(dut)\n74:     await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)              # -1 < 0\n75:     await _check(dut, ALU_SLT, 1, 0, 0)\n76:     await _check(dut, ALU_SLT, 0x7FFFFFFF, 0x80000000, 0)     # MAX > MIN\n77: \n78: \n79: @cocotb.test()\n80: async def sltu_unsigned(dut):\n81:     await _setup(dut)\n82:     await _check(dut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n83:     await _check(dut, ALU_SLTU, 0, 1, 1)\n84: \n85: \n86: @cocotb.test()\n87: async def sll(dut):\n88:     await _setup(dut)\n89:     await _check(dut, ALU_SLL, 1, 4, 16)\n90:     await _check(dut, ALU_SLL, 1, 31, 0x80000000)\n91:     await _check(dut, ALU_SLL, 1, 0x20, 1)                    # shamt = b[4:0] = 0\n92: \n93: \n94: @cocotb.test()\n95: async def srl(dut):\n96:     await _setup(dut)\n97:     await _check(dut, ALU_SRL, 0x80000000, 1, 0x40000000)\n98:     await _check(dut, ALU_SRL, 0x80000000, 31, 1)\n99:     await _check(dut, ALU_SRL, 0xFFFFFFFF, 0x25, 0x07FFFFFF)   # shamt masked\n100: \n101: \n102: @cocotb.test()\n103: async def sra(dut):\n104:     await _setup(dut)\n105:     await _check(dut, ALU_SRA, 0x80000000, 1, 0xC0000000)\n106:     await _check(dut, ALU_SRA, 0x80000000, 31, 0xFFFFFFFF)\n107:     await _check(dut, ALU_SRA, 0x7FFFFFFF, 1, 0x3FFFFFFF)\n108: \n109: \n110: @cocotb.test()\n111: async def lui(dut):\n112:     await _setup(dut)\n113:     await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n114: \n115: \n116: @cocotb.test()\n117: async def mul(dut):\n118:     await _setup(dut)\n119:     await _check(dut, ALU_MUL, 3, 4, 12)\n120:     await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\n121: \n122: \n123: @cocotb.test()\n124: async def mulh(dut):\n125:     await _setup(dut)\n126:     # INT_MIN * 2 = -2^32; high half = -1\n127:     await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n128:     # INT_MIN * INT_MIN = 2^62; high half = 0x40000000\n129:     await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n130:     await _check(dut, ALU_MULH, 1, 1, 0)\n131: \n132: \n133: @cocotb.test()\n134: async def mulhu(dut):\n135:     await _setup(dut)\n136:     await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n137:     await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n138: \n139: \n140: @cocotb.test()\n141: async def mulhsu(dut):\n142:     await _setup(dut)\n143:     # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n144:     await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n145:     # (-1) * unsigned -> high half is sign extension\n146:     await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n147: \n148: \n149: @cocotb.test()\n150: async def div_signed(dut):\n151:     await _setup(dut)\n152:     await _check_div(dut, ALU_DIV, 10, 3, 3)\n153:     await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n154:     await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\n155: \n156: \n157: @cocotb.test()\n158: async def div_by_zero(dut):\n159:     await _setup(dut)\n160:     await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n161:     await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n162: \n163: \n164: @cocotb.test()\n165: async def div_overflow(dut):\n166:     await _setup(dut)\n167:     # INT_MIN / -1 -> INT_MIN  (defined overflow per RV32IM)\n168:     await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n169: \n170: \n171: @cocotb.test()\n172: async def divu(dut):\n173:     await _setup(dut)\n174:     await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n175:     await _check_div(dut, ALU_DIVU, 100, 7, 14)\n176: \n177: \n178: @cocotb.test()\n179: async def divu_by_zero(dut):\n180:     await _setup(dut)\n181:     await _check_div(dut, ALU_DIVU, 42, 0, 0xFFFFFFFF)\n182: \n183: \n184: @cocotb.test()\n185: async def rem_signed(dut):\n186:     await _setup(dut)\n187:     await _check_div(dut, ALU_REM, 10, 3, 1)\n188:     # -10 % 3 trunc-to-zero: -10 = (-3)*3 + (-1) -> rem = -1 = 0xFFFFFFFF\n189:     await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\n190:     # 10 % -3 trunc-to-zero: 10 = (-3)*(-3) + 1 -> rem = 1 (sign of dividend)\n191:     await _check_div(dut, ALU_REM, 10, 0xFFFFFFFD, 1)\n192: \n193: \n194: @cocotb.test()\n195: async def rem_by_zero(dut):\n196:     await _setup(dut)\n197:     await _check_div(dut, ALU_REM, 0xDEADBEEF, 0, 0xDEADBEEF)\n198: \n199: \n200: @cocotb.test()\n201: async def rem_overflow(dut):\n202:     await _setup(dut)\n203:     # INT_MIN % -1 -> 0\n204:     await _check_div(dut, ALU_REM, 0x80000000, 0xFFFFFFFF, 0)\n205: \n206: \n207: @cocotb.test()\n208: async def remu(dut):\n209:     await _setup(dut)\n210:     await _check_div(dut, ALU_REMU, 7, 3, 1)\n211: \n212: \n213: @cocotb.test()\n214: async def remu_by_zero(dut):\n215:     await _setup(dut)\n216:     await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n217: \n218: \n219: @cocotb.test()\n220: async def back_to_back_divides(dut):\n221:     \"\"\"Verify the FSM resets cleanly between consecutive iterative\n222:     divides — no carry-over of operands or state from the previous op.\n223:     \"\"\"\n224:     await _setup(dut)\n225:     # Real divides only (avoid edge-case short-circuit) so each pass\n226:     # exercises the full 33-cycle FSM.\n227:     await _check_div(dut, ALU_DIVU, 100, 7, 14)\n228:     await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n229:     await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n230:     await _check_div(dut, ALU_REM, 10, 3, 1)\n231:     await _check_div(dut, ALU_REMU, 7, 3, 1)\n232: \n233: \n234: def test_alu_runner():\n235:     \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n236:     run_cocotb(toplevel=\"alu\",\n237:                sources=[\"core_pkg.sv\", \"alu.sv\"],\n238:                test_module=\"test_alu\")\n\n(End of file - total 238 lines)\n</content>","metadata":{"preview":"\"\"\"Unit tests for rtl/alu.sv.\n\nThe ALU is purely combinational (RV32IM). MUL / DIV / REM use the\nSystemVerilog `*`, `/`, `%` operators and resolve in zero cycles, so\nthere is no clock, reset, or handshake on this module.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n","truncated":false,"loaded":[]},"title":"cores/bench/test/test_alu.py","time":{"start":1778835270382,"end":1778835270389}},"metadata":{"openai":{"itemId":"fc_081405f7d6a54f3d016a06df464838819b94750bd4710d6b1d"}},"id":"prt_e2ad82ae2001F7FexAPInpnBsH","sessionID":"ses_1d52925c1ffeNMU0NKEnVRJtki","messageID":"msg_e2ad818e8001wiINJ15IQ2A4an"}}
{"type":"tool_use","timestamp":1778835270540,"sessionID":"ses_1d52925c1ffeNMU0NKEnVRJtki","part":{"type":"tool","tool":"read","callID":"call_o4MV0b448oTnmYu7PwnmcrKN","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py","offset":1,"limit":260},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py</path>\n<type>file</type>\n<content>\n1: \"\"\"End-to-end pipeline tests for rtl/core.sv.\n2: \n3: Drives a minimal Python-side imem/dmem against the core's combinational\n4: fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n5: acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\n6: SW+LW roundtrip, load-use stall, and the trap discipline (illegal /\n7: ECALL trap, EBREAK does NOT trap).\n8: \"\"\"\n9: from __future__ import annotations\n10: \n11: import cocotb\n12: from cocotb.clock import Clock\n13: from cocotb.triggers import RisingEdge, Timer\n14: \n15: from _helpers import run_cocotb\n16: \n17: \n18: # ── RV32I instruction encoder helpers ──────────────────────────────────────\n19: def _r(funct7, rs2, rs1, funct3, rd, opcode):\n20:     return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n21:          | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n22: \n23: \n24: def _i(imm, rs1, funct3, rd, opcode):\n25:     return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n26:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n27: \n28: \n29: def _s(imm, rs2, rs1, funct3, opcode):\n30:     imm_hi = (imm >> 5) & 0x7F\n31:     imm_lo = imm & 0x1F\n32:     return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n33:          | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n34: \n35: \n36: def _b(imm, rs2, rs1, funct3, opcode):\n37:     # imm is a 13-bit signed number; bit 0 is implicitly zero.\n38:     b12  = (imm >> 12) & 1\n39:     b105 = (imm >> 5)  & 0x3F\n40:     b41  = (imm >> 1)  & 0xF\n41:     b11  = (imm >> 11) & 1\n42:     return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n43:          | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n44: \n45: \n46: def _j(imm, rd, opcode):\n47:     # 21-bit signed imm; bit 0 implicit zero.\n48:     b20    = (imm >> 20) & 1\n49:     b101   = (imm >> 1)  & 0x3FF\n50:     b11    = (imm >> 11) & 1\n51:     b1912  = (imm >> 12) & 0xFF\n52:     return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n53:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n54: \n55: \n56: def ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\n57: def ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\n58: def LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\n59: def SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\n60: def BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\n61: def JAL (rd, imm):       return _j(imm, rd, 0b1101111)\n62: def JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\n63: def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\n64: def EBREAK():            return 0x00100073\n65: def ECALL():             return 0x00000073\n66: \n67: \n68: # ── Harness ────────────────────────────────────────────────────────────────\n69: async def _run(dut, program, dmem_init=None, max_cycles=200):\n70:     \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n71: \n72:     imem is read combinationally each cycle from imemAddr; dmem similarly.\n73:     Stores get applied to the Python-side dmem dict so subsequent loads\n74:     see the new value.\n75: \n76:     Returns (retirements, dmem) where retirements is a list of dicts\n77:     sampled on every cycle that rvfi_valid=1.\n78:     \"\"\"\n79:     imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n80:     dmem = dict(dmem_init or {})\n81:     retirements: list[dict] = []\n82: \n83:     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n84: \n85:     dut.reset.value = 1\n86:     dut.io_imemData.value = 0\n87:     dut.io_dmemRData.value = 0\n88:     # Zero-wait bus model: ready always asserted. The stall-mode tests\n89:     # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n90:     dut.io_imemReady.value = 1\n91:     dut.io_dmemReady.value = 1\n92:     for _ in range(3):\n93:         await RisingEdge(dut.clock)\n94: \n95:     # Deassert reset and prime the imem read for the first PC=0 fetch.\n96:     dut.reset.value = 0\n97:     dut.io_imemData.value = imem.get(0, EBREAK())\n98: \n99:     for cycle in range(max_cycles):\n100:         await RisingEdge(dut.clock)\n101:         await Timer(1, \"ns\")  # let combinational signals settle\n102: \n103:         # Sample the post-edge state.\n104:         ia        = int(dut.io_imemAddr.value)\n105:         da        = int(dut.io_dmemAddr.value)\n106:         wen       = int(dut.io_dmemWEn.value)\n107:         rvfi_v    = int(dut.io_rvfi_valid_0.value)\n108: \n109:         # Apply dmem write side effects.\n110:         if wen:\n111:             wdata = int(dut.io_dmemWData.value)\n112:             wa = da & ~3\n113:             old = dmem.get(wa, 0)\n114:             new = old\n115:             for i in range(4):\n116:                 if (wen >> i) & 1:\n117:                     bv = (wdata >> (i * 8)) & 0xFF\n118:                     new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n119:             dmem[wa] = new\n120: \n121:         # Capture RVFI retirement.\n122:         if rvfi_v:\n123:             r = {\n124:                 \"order\":     int(dut.io_rvfi_order_0.value),\n125:                 \"insn\":      int(dut.io_rvfi_insn_0.value),\n126:                 \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n127:                 \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n128:                 \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n129:                 \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n130:                 \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n131:                 \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n132:                 \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n133:                 \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n134:                 \"trap\":      int(dut.io_rvfi_trap_0.value),\n135:                 \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n136:                 \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n137:                 \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n138:                 \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n139:                 \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n140:                 \"cycle\":     cycle,\n141:             }\n142:             retirements.append(r)\n143:             if r[\"insn\"] == EBREAK():\n144:                 break\n145: \n146:         # Drive next cycle's imem fetch and dmem read combinationally.\n147:         dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n148:         dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n149:     else:\n150:         raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n151: \n152:     return retirements, dmem\n153: \n154: \n155: def _by_insn(retirements, insn):\n156:     \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n157:     return [r for r in retirements if r[\"insn\"] == insn]\n158: \n159: \n160: # ── Tests ──────────────────────────────────────────────────────────────────\n161: @cocotb.test()\n162: async def forwarding_ex_to_ex(dut):\n163:     \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n164:     program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n165:     rets, _ = await _run(dut, program)\n166:     [r1] = _by_insn(rets, ADDI(1, 0, 5))\n167:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n168:     assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n169:     assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n170:         f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n171:     )\n172:     # Order must be strict +1.\n173:     orders = [r[\"order\"] for r in rets]\n174:     assert orders == list(range(orders[0], orders[0] + len(rets)))\n175: \n176: \n177: @cocotb.test()\n178: async def forwarding_mem_to_ex(dut):\n179:     \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n180:     program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n181:     rets, _ = await _run(dut, program)\n182:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n183:     assert r2[\"rd_wdata\"] == 8\n184: \n185: \n186: @cocotb.test()\n187: async def load_use_stalls(dut):\n188:     \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n189: \n190:     All immediates kept inside the signed 12-bit positive range so ADDI's\n191:     sign-extension doesn't muddy the expected values.\n192:     \"\"\"\n193:     program = [\n194:         ADDI(3, 0, 0x123),     # x3 = 0x123\n195:         ADDI(4, 0, 0x100),     # x4 = 0x100\n196:         SW  (3, 0, 0),         # mem[0] = x3\n197:         LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n198:         ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n199:         EBREAK(),\n200:     ]\n201:     rets, dmem = await _run(dut, program)\n202:     [r2] = _by_insn(rets, ADD(2, 1, 4))\n203:     assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n204:     assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n205: \n206: \n207: @cocotb.test()\n208: async def branch_taken_skips(dut):\n209:     \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n210:     not merely retire with rd_wdata != 99. Asserting only the side effect\n211:     would let a wrong-path retirement with rd=0 / trap=1 / different data\n212:     pass silently.\"\"\"\n213:     program = [\n214:         BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n215:         ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n216:         ADDI(2, 0, 42),        # PC=8;  branch target\n217:         EBREAK(),\n218:     ]\n219:     rets, _ = await _run(dut, program)\n220:     # Strict: no retirement should originate from PC=4.\n221:     leaked = [r for r in rets if r[\"pc\"] == 4]\n222:     assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n223:     # Strict: no retirement carries the skipped instruction word at all.\n224:     leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n225:     assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n226:     # Sanity: the target instruction and the EBREAK do retire, in order.\n227:     pcs = [r[\"pc\"] for r in rets]\n228:     assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n229:     [r2] = _by_insn(rets, ADDI(2, 0, 42))\n230:     assert r2[\"rd_wdata\"] == 42\n231: \n232: \n233: @cocotb.test()\n234: async def jal_writes_pc_plus_4(dut):\n235:     \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n236:     program = [\n237:         JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n238:         ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n239:         ADDI(3, 0, 42),        # PC=8 — target\n240:         EBREAK(),\n241:     ]\n242:     rets, _ = await _run(dut, program)\n243:     pcs = [r[\"pc\"] for r in rets]\n244:     assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n245:     [rj] = _by_insn(rets, JAL(1, 8))\n246:     assert rj[\"rd\"] == 1\n247:     assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n248:     [r3] = _by_insn(rets, ADDI(3, 0, 42))\n249:     assert r3[\"rd_wdata\"] == 42\n250: \n251: \n252: @cocotb.test()\n253: async def jalr_target(dut):\n254:     \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n255:     program = [\n256:         ADDI(5, 0, 12),        # PC=0;  x5 := 12\n257:         JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n258:         ADDI(6, 0, 99),        # PC=8;  wrong-path\n259:         ADDI(7, 0, 42),        # PC=12; target\n260:         EBREAK(),\n\n(Showing lines 1-260 of 356. Use offset=261 to continue.)\n</content>","metadata":{"preview":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\","truncated":true,"loaded":[]},"title":"cores/bench/test/test_pipeline.py","time":{"start":1778835270531,"end":1778835270539}},"metadata":{"openai":{"itemId":"fc_081405f7d6a54f3d016a06df464848819b8e63c9b06c883b05"}},"id":"prt_e2ad82afa0013JU2aISyqVGXlf","sessionID":"ses_1d52925c1ffeNMU0NKEnVRJtki","messageID":"msg_e2ad818e8001wiINJ15IQ2A4an"}}
