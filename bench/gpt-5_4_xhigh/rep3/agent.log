{"type":"tool_use","timestamp":1778874633211,"sessionID":"ses_1d2d0d46affeDQJGIeMWOEYdBs","part":{"type":"tool","tool":"read","callID":"call_E8RgG8g2Gh8yzfK12Mjr7CgE","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py","offset":1,"limit":220},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_pipeline.py</path>\n<type>file</type>\n<content>\n1: \"\"\"End-to-end pipeline tests for rtl/core.sv.\n2: \n3: Drives a minimal Python-side imem/dmem against the core's combinational\n4: fetch/load model and captures RVFI retirements. Covers forwarding\n5: (EX->EX, MEM->EX), branches, JAL, JALR, SW+LW roundtrip, load-use stall,\n6: divide stall/retire behavior, and the trap discipline (illegal / ECALL\n7: trap, EBREAK does NOT trap).\n8: \"\"\"\n9: from __future__ import annotations\n10: \n11: import cocotb\n12: from cocotb.clock import Clock\n13: from cocotb.triggers import RisingEdge, Timer\n14: \n15: from _helpers import run_cocotb\n16: \n17: \n18: # ── RV32I instruction encoder helpers ──────────────────────────────────────\n19: def _r(funct7, rs2, rs1, funct3, rd, opcode):\n20:     return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n21:          | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n22: \n23: \n24: def _i(imm, rs1, funct3, rd, opcode):\n25:     return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n26:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n27: \n28: \n29: def _s(imm, rs2, rs1, funct3, opcode):\n30:     imm_hi = (imm >> 5) & 0x7F\n31:     imm_lo = imm & 0x1F\n32:     return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n33:          | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n34: \n35: \n36: def _b(imm, rs2, rs1, funct3, opcode):\n37:     # imm is a 13-bit signed number; bit 0 is implicitly zero.\n38:     b12  = (imm >> 12) & 1\n39:     b105 = (imm >> 5)  & 0x3F\n40:     b41  = (imm >> 1)  & 0xF\n41:     b11  = (imm >> 11) & 1\n42:     return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n43:          | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n44: \n45: \n46: def _j(imm, rd, opcode):\n47:     # 21-bit signed imm; bit 0 implicit zero.\n48:     b20    = (imm >> 20) & 1\n49:     b101   = (imm >> 1)  & 0x3FF\n50:     b11    = (imm >> 11) & 1\n51:     b1912  = (imm >> 12) & 0xFF\n52:     return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n53:          | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n54: \n55: \n56: def _u(imm20, rd, opcode):\n57:     return ((imm20 & 0xFFFFF) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n58: \n59: \n60: def ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\n61: def ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\n62: def DIVU(rd, rs1, rs2): return _r(0b0000001, rs2, rs1, 0b101, rd, 0b0110011)\n63: def LUI (rd, imm20):    return _u(imm20, rd, 0b0110111)\n64: def LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\n65: def SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\n66: def BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\n67: def JAL (rd, imm):       return _j(imm, rd, 0b1101111)\n68: def JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\n69: def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\n70: def EBREAK():            return 0x00100073\n71: def ECALL():             return 0x00000073\n72: \n73: \n74: # ── Harness ────────────────────────────────────────────────────────────────\n75: async def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready_fn=None):\n76:     \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n77: \n78:     imem is read combinationally each cycle from imemAddr; dmem similarly.\n79:     Stores get applied to the Python-side dmem dict only on cycles where\n80:     io_dmemReady is high, matching test/cosim/main.cpp's accepted-write model.\n81: \n82:     Returns (retirements, dmem) where retirements is a list of dicts\n83:     sampled on every cycle that rvfi_valid=1.\n84:     \"\"\"\n85:     imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n86:     dmem = dict(dmem_init or {})\n87:     retirements: list[dict] = []\n88: \n89:     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n90: \n91:     dut.reset.value = 1\n92:     dut.io_imemData.value = 0\n93:     dut.io_dmemRData.value = 0\n94:     # Zero-wait bus model: ready always asserted. The stall-mode tests\n95:     # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n96:     dut.io_imemReady.value = 1\n97:     dut.io_dmemReady.value = 1\n98:     for _ in range(3):\n99:         await RisingEdge(dut.clock)\n100: \n101:     # Deassert reset and prime the imem read for the first PC=0 fetch.\n102:     dut.reset.value = 0\n103: \n104:     for cycle in range(max_cycles):\n105:         ia = int(dut.io_imemAddr.value)\n106:         da = int(dut.io_dmemAddr.value)\n107:         dready = dmem_ready_fn(cycle, dut) if dmem_ready_fn else 1\n108: \n109:         dut.io_imemReady.value = 1\n110:         dut.io_dmemReady.value = dready\n111:         dut.io_imemData.value = imem.get(ia & ~3, EBREAK())\n112:         dut.io_dmemRData.value = dmem.get(da & ~3, 0) if _is_ram_addr(da) else 0\n113: \n114:         await Timer(1, \"ns\")  # let combinational request signals settle\n115: \n116:         wen = int(dut.io_dmemWEn.value)\n117:         if wen and dready and _is_ram_addr(int(dut.io_dmemAddr.value)):\n118:             wdata = int(dut.io_dmemWData.value)\n119:             wa = int(dut.io_dmemAddr.value) & ~3\n120:             old = dmem.get(wa, 0)\n121:             new = old\n122:             for i in range(4):\n123:                 if (wen >> i) & 1:\n124:                     bv = (wdata >> (i * 8)) & 0xFF\n125:                     new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n126:             dmem[wa] = new\n127: \n128:         await RisingEdge(dut.clock)\n129:         await Timer(1, \"ns\")  # let combinational signals settle\n130: \n131:         # Sample the post-edge state.\n132:         rvfi_v    = int(dut.io_rvfi_valid_0.value)\n133: \n134:         # Capture RVFI retirement.\n135:         if rvfi_v:\n136:             r = {\n137:                 \"order\":     int(dut.io_rvfi_order_0.value),\n138:                 \"insn\":      int(dut.io_rvfi_insn_0.value),\n139:                 \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n140:                 \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n141:                 \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n142:                 \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n143:                 \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n144:                 \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n145:                 \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n146:                 \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n147:                 \"trap\":      int(dut.io_rvfi_trap_0.value),\n148:                 \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n149:                 \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n150:                 \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n151:                 \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n152:                 \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n153:                 \"cycle\":     cycle,\n154:             }\n155:             retirements.append(r)\n156:             if r[\"insn\"] == EBREAK():\n157:                 break\n158:     else:\n159:         raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n160: \n161:     return retirements, dmem\n162: \n163: \n164: def _by_insn(retirements, insn):\n165:     \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n166:     return [r for r in retirements if r[\"insn\"] == insn]\n167: \n168: \n169: def _is_ram_addr(addr):\n170:     return 0 <= addr < 0x00100000\n171: \n172: \n173: class StallOnce:\n174:     \"\"\"Force one request to see a fixed-length dmem-ready low window.\"\"\"\n175: \n176:     def __init__(self, addr, stall_cycles):\n177:         self.addr = addr\n178:         self.stall_cycles = stall_cycles\n179:         self.remaining = 0\n180:         self.started = False\n181:         self.release_cycle = None\n182: \n183:     def __call__(self, cycle, dut):\n184:         if self.remaining > 0:\n185:             self.remaining -= 1\n186:             return 0\n187: \n188:         wen = int(dut.io_dmemWEn.value)\n189:         addr = int(dut.io_dmemAddr.value)\n190:         if not self.started and wen and addr == self.addr:\n191:             self.started = True\n192:             self.release_cycle = cycle + self.stall_cycles\n193:             self.remaining = max(self.stall_cycles - 1, 0)\n194:             return 0 if self.stall_cycles else 1\n195: \n196:         return 1\n197: \n198: \n199: # ── Tests ──────────────────────────────────────────────────────────────────\n200: @cocotb.test()\n201: async def forwarding_ex_to_ex(dut):\n202:     \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n203:     program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n204:     rets, _ = await _run(dut, program)\n205:     [r1] = _by_insn(rets, ADDI(1, 0, 5))\n206:     [r2] = _by_insn(rets, ADDI(2, 1, 3))\n207:     assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n208:     assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n209:         f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n210:     )\n211:     # Order must be strict +1.\n212:     orders = [r[\"order\"] for r in rets]\n213:     assert orders == list(range(orders[0], orders[0] + len(rets)))\n214: \n215: \n216: @cocotb.test()\n217: async def forwarding_mem_to_ex(dut):\n218:     \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n219:     program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n220:     rets, _ = await _run(dut, program)\n\n(Showing lines 1-220 of 497. Use offset=221 to continue.)\n</content>","metadata":{"preview":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers forwarding\n(EX->EX, MEM->EX), branches, JAL, JALR, SW+LW roundtrip, load-use stall,\ndivide stall/retire behavior, and the trap discipline (illegal / ECALL\ntrap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\","truncated":true,"loaded":[]},"title":"cores/bench/test/test_pipeline.py","time":{"start":1778874633200,"end":1778874633209}},"metadata":{"openai":{"itemId":"fc_08dbd76ae1a274b9016a07790911b8819b86792922464c3cf0"}},"id":"prt_e2d30cbe4001JgH0vP3GwrufKg","sessionID":"ses_1d2d0d46affeDQJGIeMWOEYdBs","messageID":"msg_e2d306512001zrhxUAuaRsXl7U"}}
{"type":"tool_use","timestamp":1778874633211,"sessionID":"ses_1d2d0d46affeDQJGIeMWOEYdBs","part":{"type":"tool","tool":"read","callID":"call_3octCrNrHIF1IP0wECeuweJm","state":{"status":"completed","input":{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_decoder.py","offset":1,"limit":220},"output":"<path>/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/test/test_decoder.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Unit tests for rtl/decoder.sv. Mirrors chisel/test/src/DecoderSpec.scala\n2: 1:1. Includes every reserved-encoding case from CLAUDE.md invariant #10.\"\"\"\n3: from __future__ import annotations\n4: \n5: import cocotb\n6: from cocotb.triggers import Timer\n7: \n8: from _helpers import (\n9:     ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n10:     ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n11:     ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n12:     ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n13:     BR_BEQ, BR_BNE, BR_BLT, BR_BGE, BR_BLTU, BR_BGEU,\n14:     run_cocotb,\n15: )\n16: \n17: \n18: async def _poke(dut, instr):\n19:     dut.instr.value = instr & 0xFFFFFFFF\n20:     await Timer(1, \"ns\")\n21: \n22: \n23: # ── R-type ────────────────────────────────────────────────────────────────\n24: @cocotb.test()\n25: async def add(dut):\n26:     # ADD x1,x2,x3 = 0x003100B3\n27:     await _poke(dut, 0x003100B3)\n28:     assert int(dut.alu_op.value) == ALU_ADD\n29:     assert int(dut.reg_write.value) == 1\n30:     assert int(dut.alu_src.value) == 0\n31:     assert int(dut.is_illegal.value) == 0\n32: \n33: \n34: @cocotb.test()\n35: async def sub(dut):\n36:     await _poke(dut, 0x403100B3)\n37:     assert int(dut.alu_op.value) == ALU_SUB\n38:     assert int(dut.is_illegal.value) == 0\n39: \n40: \n41: @cocotb.test()\n42: async def r_type_ops(dut):\n43:     cases = [\n44:         (0x001010B3, ALU_SLL),\n45:         (0x001020B3, ALU_SLT),\n46:         (0x001030B3, ALU_SLTU),\n47:         (0x001040B3, ALU_XOR),\n48:         (0x001050B3, ALU_SRL),\n49:         (0x001060B3, ALU_OR),\n50:         (0x001070B3, ALU_AND),\n51:         (0x401050B3, ALU_SRA),\n52:     ]\n53:     for instr, op in cases:\n54:         await _poke(dut, instr)\n55:         assert int(dut.alu_op.value) == op, \\\n56:             f\"instr=0x{instr:08x}: expected aluOp={op}, got {int(dut.alu_op.value)}\"\n57:         assert int(dut.is_illegal.value) == 0\n58: \n59: \n60: @cocotb.test()\n61: async def m_extension(dut):\n62:     cases = [\n63:         (0x023100B3, ALU_MUL),\n64:         (0x023110B3, ALU_MULH),\n65:         (0x023120B3, ALU_MULHSU),\n66:         (0x023130B3, ALU_MULHU),\n67:         (0x023140B3, ALU_DIV),\n68:         (0x023150B3, ALU_DIVU),\n69:         (0x023160B3, ALU_REM),\n70:         (0x023170B3, ALU_REMU),\n71:     ]\n72:     for instr, op in cases:\n73:         await _poke(dut, instr)\n74:         assert int(dut.alu_op.value) == op\n75:         assert int(dut.is_illegal.value) == 0\n76: \n77: \n78: @cocotb.test()\n79: async def reserved_funct7_r_type(dut):\n80:     # funct7=0x3F is reserved; otherwise valid R-type encoding.\n81:     await _poke(dut, 0xFE3100B3)\n82:     assert int(dut.is_illegal.value) == 1\n83: \n84: \n85: @cocotb.test()\n86: async def reserved_subsra_funct3(dut):\n87:     # funct7=0x20, funct3=1 is reserved (only funct3=0 SUB or 5 SRA valid).\n88:     await _poke(dut, 0x403110B3)\n89:     assert int(dut.is_illegal.value) == 1\n90: \n91: \n92: # ── I-type OP-IMM ─────────────────────────────────────────────────────────\n93: @cocotb.test()\n94: async def addi(dut):\n95:     # ADDI x1, x0, 5 = 0x00500093\n96:     await _poke(dut, 0x00500093)\n97:     assert int(dut.alu_op.value) == ALU_ADD\n98:     assert int(dut.alu_src.value) == 1\n99:     assert int(dut.reg_write.value) == 1\n100:     assert int(dut.is_illegal.value) == 0\n101: \n102: \n103: @cocotb.test()\n104: async def slli_legal(dut):\n105:     # SLLI x1, x0, 4 = 0x00401093\n106:     await _poke(dut, 0x00401093)\n107:     assert int(dut.alu_op.value) == ALU_SLL\n108:     assert int(dut.is_illegal.value) == 0\n109: \n110: \n111: @cocotb.test()\n112: async def slli_with_funct7_illegal(dut):\n113:     # SLLI with funct7=0x20 is reserved.\n114:     await _poke(dut, 0x40401093)\n115:     assert int(dut.is_illegal.value) == 1\n116: \n117: \n118: @cocotb.test()\n119: async def srli(dut):\n120:     await _poke(dut, 0x00405093)\n121:     assert int(dut.alu_op.value) == ALU_SRL\n122:     assert int(dut.is_illegal.value) == 0\n123: \n124: \n125: @cocotb.test()\n126: async def srai(dut):\n127:     await _poke(dut, 0x40405093)\n128:     assert int(dut.alu_op.value) == ALU_SRA\n129:     assert int(dut.is_illegal.value) == 0\n130: \n131: \n132: # ── LOAD ──────────────────────────────────────────────────────────────────\n133: @cocotb.test()\n134: async def loads(dut):\n135:     cases = [\n136:         (0x00010083, 0, 1),  # LB    width=byte sext=1\n137:         (0x00011083, 1, 1),  # LH\n138:         (0x00012083, 2, 1),  # LW\n139:         (0x00014083, 0, 0),  # LBU   sext=0\n140:         (0x00015083, 1, 0),  # LHU\n141:     ]\n142:     for instr, mw, sext in cases:\n143:         await _poke(dut, instr)\n144:         assert int(dut.mem_read.value)   == 1\n145:         assert int(dut.reg_write.value)  == 1\n146:         assert int(dut.mem_to_reg.value) == 1\n147:         assert int(dut.alu_src.value)    == 1\n148:         assert int(dut.mem_width.value)  == mw, f\"instr=0x{instr:08x} mw={mw} got {int(dut.mem_width.value)}\"\n149:         assert int(dut.mem_sext.value)   == sext\n150:         assert int(dut.is_illegal.value) == 0\n151: \n152: \n153: @cocotb.test()\n154: async def reserved_load_funct3(dut):\n155:     for f3 in (3, 6, 7):\n156:         instr = (f3 << 12) | 0x03\n157:         await _poke(dut, instr)\n158:         assert int(dut.is_illegal.value) == 1, f\"LOAD funct3={f3} should be illegal\"\n159: \n160: \n161: # ── STORE ─────────────────────────────────────────────────────────────────\n162: @cocotb.test()\n163: async def stores(dut):\n164:     cases = [(0x00110023, 0), (0x00111023, 1), (0x00112023, 2)]\n165:     for instr, mw in cases:\n166:         await _poke(dut, instr)\n167:         assert int(dut.mem_write.value) == 1\n168:         assert int(dut.reg_write.value) == 0\n169:         assert int(dut.mem_width.value) == mw\n170:         assert int(dut.is_illegal.value) == 0\n171: \n172: \n173: @cocotb.test()\n174: async def reserved_store_funct3(dut):\n175:     for f3 in range(3, 8):\n176:         instr = (f3 << 12) | 0x23\n177:         await _poke(dut, instr)\n178:         assert int(dut.is_illegal.value) == 1, f\"STORE funct3={f3} should be illegal\"\n179: \n180: \n181: # ── BRANCH ────────────────────────────────────────────────────────────────\n182: @cocotb.test()\n183: async def branches(dut):\n184:     cases = [\n185:         (0x00208463, BR_BEQ),\n186:         (0x00209463, BR_BNE),\n187:         (0x0020C463, BR_BLT),\n188:         (0x0020D463, BR_BGE),\n189:         (0x0020E463, BR_BLTU),\n190:         (0x0020F463, BR_BGEU),\n191:     ]\n192:     for instr, op in cases:\n193:         await _poke(dut, instr)\n194:         assert int(dut.is_branch.value) == 1\n195:         assert int(dut.reg_write.value) == 0\n196:         assert int(dut.branch_op.value) == op\n197:         assert int(dut.is_illegal.value) == 0\n198: \n199: \n200: @cocotb.test()\n201: async def reserved_branch_funct3(dut):\n202:     for f3 in (2, 3):\n203:         instr = (f3 << 12) | 0x63\n204:         await _poke(dut, instr)\n205:         assert int(dut.is_illegal.value) == 1, f\"BRANCH funct3={f3} should be illegal\"\n206: \n207: \n208: # ── JAL / JALR / LUI / AUIPC ──────────────────────────────────────────────\n209: @cocotb.test()\n210: async def jal(dut):\n211:     # JAL x0, +4 = 0x0040006F\n212:     await _poke(dut, 0x0040006F)\n213:     assert int(dut.is_jump.value)    == 1\n214:     assert int(dut.reg_write.value)  == 1\n215:     assert int(dut.is_illegal.value) == 0\n216: \n217: \n218: @cocotb.test()\n219: async def jalr(dut):\n220:     # JALR x1, 0(x2) = 0x000100E7\n\n(Showing lines 1-220 of 335. Use offset=221 to continue.)\n</content>","metadata":{"preview":"\"\"\"Unit tests for rtl/decoder.sv. Mirrors chisel/test/src/DecoderSpec.scala\n1:1. Includes every reserved-encoding case from CLAUDE.md invariant #10.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    BR_BEQ, BR_BNE, BR_BLT, BR_BGE, BR_BLTU, BR_BGEU,\n    run_cocotb,\n)\n\n\nasync def _poke(dut, instr):\n    dut.instr.value = instr & 0xFFFFFFFF\n    await Timer(1, \"ns\")","truncated":true,"loaded":[]},"title":"cores/bench/test/test_decoder.py","time":{"start":1778874633203,"end":1778874633210}},"metadata":{"openai":{"itemId":"fc_08dbd76ae1a274b9016a07790911c8819bad4c20ae54bb572b"}},"id":"prt_e2d30cbf20013luSMU6tjdDvKA","sessionID":"ses_1d2d0d46affeDQJGIeMWOEYdBs","messageID":"msg_e2d306512001zrhxUAuaRsXl7U"}}
