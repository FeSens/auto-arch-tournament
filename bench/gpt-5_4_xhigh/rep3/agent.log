ccepted_writes}\"\n+    )\n+    assert dmem.get(0) == 0x111\n+    assert dmem.get(4) == 0x222\n+\n+\n+@cocotb.test()\n+async def deferred_store_queue_fences_later_load_until_drain(dut):\n+    \"\"\"A younger load must wait until every deferred store ahead of it commits.\"\"\"\n+    store0 = SW(1, 0, 0)\n+    store1 = SW(2, 0, 4)\n+    load1 = LW(4, 0, 4)\n+    stall = StallOnce(addr=0, stall_cycles=5)\n+    accepted_writes = []\n+    program = [\n+        ADDI(1, 0, 0x111),\n+        ADDI(2, 0, 0x222),\n+        store0,\n+        store1,\n+        load1,\n+        EBREAK(),\n+    ]\n+    rets, dmem = await _run(\n+        dut,\n+        program,\n+        dmem_ready_fn=stall,\n+        accepted_writes=accepted_writes,\n+    )\n+\n+    assert [w[\"addr\"] for w in accepted_writes] == [0, 4]\n+    [rload] = _by_insn(rets, load1)\n+    assert rload[\"rd_wdata\"] == 0x222\n+    assert rload[\"cycle\"] > accepted_writes[1][\"cycle\"], (\n+        f\"load must stay behind both deferred stores, saw load cycle {rload['cycle']} and commits {accepted_writes}\"\n+    )\n+    assert dmem.get(0) == 0x111\n+    assert dmem.get(4) == 0x222\n+\n+\n+@cocotb.test()\n async def mmio_store_stays_unbuffered_under_backpressure(dut):\n     \"\"\"UART/MMIO stores must not use the RAM store slot.\"\"\"\n     store_insn = SW(1, 5, 0)\n     alu_insn = ADDI(2, 0, 7)\n\n","files":[{"filePath":"/Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/worktrees/hyp-20260515-002-r4s1/cores/bench/test/test_pipeline.py","relativePath":"cores/bench/test/test_pipeline.py","type":"update","patch":"Index: /Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/worktrees/hyp-20260515-002-r4s1/cores/bench/test/test_pipeline.py\n===================================================================\n--- /Users/bonetto/bonetto/auto-arch-tournament/.claude/bench-runs/gpt-5_4_xhigh-rep3/cores/bench/worktrees/hyp-20260515-002-r4s1/cores/be