{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"sed -n '1,110p' cores/bench/rtl/forward_unit.sv && sed -n '1,60p' cores/bench/rtl/ex_stage.sv\"","aggregated_output":"// rtl/forward_unit.sv\n//\n// Operand forwarding. For each rs in the execute input, picks\n// where the freshest value lives:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic [4:0] rs1_addr,\n  input  logic [4:0] rs2_addr,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  // Compare at the execute boundary. A producer can spend a variable\n  // number of cycles in EX1 (for M operations and bus stalls), so binding\n  // source matches in ID would become stale as the pipeline holds.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && rs1_addr == ex_mem_rd) fwd_rs1 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && rs1_addr == mem_wb_rd) fwd_rs1 = 2'd2;\n    else                                                          fwd_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && rs2_addr == ex_mem_rd) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && rs2_addr == mem_wb_rd) fwd_rs2 = 2'd2;\n    else                                                          fwd_rs2 = 2'd0;\n  end\n\nendmodule\n// Split execute pipeline. EX1 selects forwarded operands and registers the\n// low-half carry work; EX2 completes sums, selects the ALU result, resolves\n// control flow, and writes the existing EX/MEM boundary.\nmodule ex_stage (\n  input  logic       clock,\n  input  logic       reset,\n  input  logic       stall,\n  input  logic       flush_ex1,\n  input  logic       operand_wait,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  id_ex_t     in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic [1:0] fwd_rs1_sel,\n  input  logic [1:0] fwd_rs2_sel,\n  input  logic [31:0] fwd_ex_mem,\n  input  logic [31:0] fwd_mem_wb,\n  output ex_mem_t    out,\n  output logic       redirect,\n  output logic [31:0] redirect_target,\n  output logic       predictor_update,\n  output logic [2:0] predictor_update_index,\n  output logic       predictor_update_taken,\n  output logic       divide_wait,\n  output logic       multiply_wait\n);\n\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n  logic [31:0] alu_a_in;\n  logic [31:0] alu_b_in;\n  logic [31:0] alu_result;\n  logic [31:0] alu_result_selected;\n  logic [31:0] alu_sum_ex2;\n  logic [31:0] pc_imm_sum_ex2;\n  logic [31:0] pc_plus4_ex2;\n  logic [31:0] branch_target_ex2;\n  logic [31:0] jump_target_ex2;\n  logic [15:0] alu_b_for_add;\n  logic [16:0] alu_low_sum_in;\n  logic [16:0] pc_imm_low_sum_in;\n  logic [16:0] pc_plus4_low_sum_in;\n  logic        alu_sub_in;\n  logic        divide_op;\n  logic        divider_start;\n  logic        divider_consume;\n  logic        divider_busy;\n  logic        divider_done;\n  logic [31:0] divider_result;\n  logic [31:0] divide_rs1_q;\n  logic [31:0] divide_rs2_q;\n  logic        multiply_op;\n  logic        multiplier_start;\n  logic        multiplier_consume;\n  logic        multiplier_busy;\n  logic        multiplier_done;\n  logic [31:0] multiplier_result;\n  logic [31:0] multiply_rs1_q;\n  logic [31:0] multiply_rs2_q;\n  logic        branch_cond;\n  logic        branch_taken;\n","exit_code":0,"status":"completed"}}
