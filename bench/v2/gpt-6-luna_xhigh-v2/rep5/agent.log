ected': hex(expected), 'got': hex(got)}\n\ndef compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\n            ref_reason=None, sim_returncode=0, sim_stderr=''):\n    for i, (ref, sim) in enumerate(zip(ref_trace, sim_trace)):\n        # Direct-equality RVFI fields. trap/halt/intr/mode/ixl are included\n    \n…[4992 of 8064 chars elided by tools/bench/transcript.py; sha256:ca58bad56e6545f5]…\n     //     a STORE that's accepted on the cycle dmem_ready transitions\n148:        // cycle dmem_ready transitions 0 -> 1.\n153:            // cycle counts so the bench harness can bracket the benchmark loop\n157:                if (!bench_start_set) { bench_start_cycle = cycle; bench_start_set = true; }\n161:                bench_stop_cycle = cycle; bench_stop_set = true;\n197:                \"{\\\"order\\\":%llu,\\\"cycle\\\":%llu,\\\"insn\\\":%u,\\\"pc_rdata\\\":%u,\\\"pc_wdata\\\":%u,\"\n205:                (unsigned long long)cycle,\n254:        // check \"ebreak\":true before trusting the cycle count — otherwise the\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n273:               (unsigned long long)bench_start_cycle,\n274:               (unsigned long long)bench_stop_cycle,\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n", "exit_code": 0, "status": "completed"}}
