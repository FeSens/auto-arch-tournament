 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[8486 of 11558 chars elided by tools/bench/transcript.py; sha256:74c0319e602ae662]…\n2\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\ncores/bench/rtl/if_stage.sv:1:// rtl/if_stage.sv\ncores/bench/rtl/if_stage.sv:16:module if_stage (\ncores/bench/rtl/hazard_unit.sv:1:// rtl/hazard_unit.sv\ncores/bench/rtl/hazard_unit.sv:19:module hazard_unit (\ncores/bench/rtl/core.sv:9://   +- stall <- hazard_unit (load-use)\ncores/bench/rtl/core.sv:101:  if_stage u_if (\ncores/bench/rtl/core.sv:178:  hazard_unit u_hazard (\ncores/bench/rtl/core_pkg.sv:74:  // IF -> ID combinational bundle (no register; PC reg sits in if_stage).\ncores/bench/test/test_pipeline.py:350:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:352:            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
