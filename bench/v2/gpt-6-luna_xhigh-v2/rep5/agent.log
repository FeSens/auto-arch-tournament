{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' bench/programs/selftest.S\"","aggregated_output":"# Minimal selftest: exercises ALU, load/store (including sub-word), branches.\n# Terminates with ebreak on success, loops on failure.\n.section .text.start\n.global _start\n_start:\n    # Set up stack\n    la   sp, _stack_top\n\n    # ---- ALU ----\n    li   t0, 10\n    li   t1, 3\n    add  t2, t0, t1       # t2 = 13\n    li   t3, 13\n    bne  t2, t3, fail\n\n    sub  t2, t0, t1       # t2 = 7\n    li   t3, 7\n    bne  t2, t3, fail\n\n    mul  t2, t0, t1       # t2 = 30\n    li   t3, 30\n    bne  t2, t3, fail\n\n    # ---- SW / LW ----\n    la   a0, scratch\n    li   t0, 0xDEADBEEF\n    sw   t0, 0(a0)\n    lw   t1, 0(a0)\n    bne  t0, t1, fail\n\n    # ---- SH / LH at halfword offset 0 ----\n    li   t0, 0x1234\n    sh   t0, 0(a0)\n    lhu  t1, 0(a0)\n    bne  t0, t1, fail\n\n    # ---- SH / LH at halfword offset 2 (offset 2 within word) ----\n    li   t0, 0xABCD\n    sh   t0, 2(a0)\n    lhu  t1, 2(a0)\n    bne  t0, t1, fail\n\n    # Check the full word now: lower half=0x1234, upper half=0xABCD\n    lw   t2, 0(a0)\n    li   t3, 0xABCD1234\n    bne  t2, t3, fail\n\n    # ---- SB / LB at byte offsets 0-3 ----\n    li   t0, 0xAA\n    sb   t0, 0(a0)\n    lbu  t1, 0(a0)\n    bne  t0, t1, fail\n\n    li   t0, 0xBB\n    sb   t0, 1(a0)\n    lbu  t1, 1(a0)\n    bne  t0, t1, fail\n\n    li   t0, 0xCC\n    sb   t0, 2(a0)\n    lbu  t1, 2(a0)\n    bne  t0, t1, fail\n\n    li   t0, 0xDD\n    sb   t0, 3(a0)\n    lbu  t1, 3(a0)\n    bne  t0, t1, fail\n\n    # Verify word = 0xDDCCBBAA\n    lw   t2, 0(a0)\n    li   t3, 0xDDCCBBAA\n    bne  t2, t3, fail\n\n    # ---- Bitwise + shifts ----\n    li   t0, 0xF0F0F0F0\n    li   t1, 0x0F0F0F0F\n    and  t2, t0, t1\n    bne  t2, zero, fail            # AND of disjoint bit fields = 0\n    or   t2, t0, t1\n    li   t3, -1                    # 0xFFFFFFFF\n    bne  t2, t3, fail              # OR covers everything\n    xor  t2, t0, t1\n    bne  t2, t3, fail              # XOR == OR for disjoint\n    li   t0, 1\n    sll  t2, t0, 5                 # 1 << 5 = 32\n    li   t3, 32\n    bne  t2, t3, fail\n    li   t0, 0x80000000\n    srl  t2, t0, 1                 # logical >> 1 = 0x40000000\n    li   t3, 0x40000000\n    bne  t2, t3, fail\n    sra  t2, t0, 1                 # arith  >> 1 = 0xC0000000\n    li   t3, 0xC0000000\n    bne  t2, t3, fail\n\n    # ---- SLT / SLTU ----\n    li   t0, -1\n    li   t1, 0\n    slt  t2, t0, t1                # signed: -1 < 0 -> 1\n    li   t3, 1\n    bne  t2, t3, fail\n    sltu t2, t0, t1                # unsigned: 0xFFFFFFFF !< 0 -> 0\n    bne  t2, zero, fail\n\n    # ---- DIV / REM (M-extension) ----\n    li   t0, 10\n    li   t1, 3\n    div  t2, t0, t1                # 10 / 3 = 3\n    li   t3, 3\n    bne  t2, t3, fail\n    rem  t2, t0, t1                # 10 % 3 = 1\n    li   t3, 1\n    bne  t2, t3, fail\n    li   t0, -7                    # signed: -7 / 2 = -3 (trunc toward zero)\n    li   t1, 2\n    div  t2, t0, t1\n    li   t3, -3\n    bne  t2, t3, fail\n    li   t1, 0                     # div-by-zero -> -1 (all-ones)\n    div  t2, t0, t1\n    li   t3, -1\n    bne  t2, t3, fail\n\n    # ---- LUI / AUIPC ----\n    lui  t0, 0x12345               # t0 = 0x12345000\n    li   t3, 0x12345000\n    bne  t0, t3, fail\n    auipc t0, 0                    # t0 = pc; nonzero (text past start)\n    beq  t0, zero, fail\n\n    # ---- BEQ taken/not-taken ----\n    li   t0, 7\n    li   t1, 7\n    beq  t0, t1, beq_taken         # MUST take\n    j    fail\nbeq_taken:\n    li   t1, 8\n    beq  t0, t1, fail              # MUST NOT take\n\n    # ---- FENCE — architectural NOP, must not trap ----\n    fence iorw, iorw\n\n    # ---- JAL / JALR ----\n    jal  ra, jal_target\n    j    after_jal\njal_target:\n    jalr zero, ra, 0\nafter_jal:\n\n    # ---- Success ----\n    ebreak\n\nfail:\n    j    fail\n\n.section .bss\nscratch: .word 0\n","exit_code":0,"status":"completed"}}
