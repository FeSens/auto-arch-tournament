e WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       rs1_ex_mem_match,\n  input  logic       rs1_mem_wb_match,\n  input  logic       rs2_ex_mem_match,\n  input  logic       rs2_mem_wb_match,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  // Destination equality is precomputed in ID; only live producer enables\n  // and x0 qualification remain on this cycle's forwarding path.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && rs1_ex_mem_match) fwd_rs1 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && rs1_mem_wb_match) fwd_rs1 = 2'd2;\n    else                                                          fwd_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && rs2_ex_mem_match) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && rs2_mem_wb_match) fwd_rs2 = 2'd2;\n    else                                                          fwd_rs2 = 2'd0;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
