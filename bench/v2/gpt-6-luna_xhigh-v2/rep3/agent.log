{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/core.sv cores/bench/rtl/hazard_unit.sv cores/bench/rtl/if_stage.sv; git status --short'", "aggregated_output": "diff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex 76e1f6d..9de7d42 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -75,6 +75,7 @@ module core (\n \n   // ── Inter-stage wires ──────────────────────────────────────────────────\n   if_id_t  if_id_w;\n+  id_ex_t  id_ex_raw;\n   id_ex_t  id_ex_w;\n   ex_mem_t ex_mem_w;\n   mem_wb_t mem_wb_w;\n@@ -89,6 +90,29 @@ module core (\n   logic        redirect;\n   logic [31:0] redirect_target;\n \n+  // IF/ID may accept the sequential fetch on a redirect cycle. Remember\n+  // whether that instruction entered ID/EX and mask it before any EX-side\n+  // consumer sees it. The token follows ID/EX through holds.\n+  logic squash_token_q;\n+\n+  always_ff @(posedge clock) begin\n+    if (reset) begin\n+      squash_token_q <= 1'b0;\n+    end else if (flush_id) begin\n+      // A load-use flush writes a bubble even though stall_id is asserted.\n+      squash_token_q <= 1'b0;\n+    end else if (!stall_id) begin\n+      // Redirect may remain asserted while the branch is held behind an\n+      // older data transaction. Do not squash the target once PC has moved.\n+      squash_token_q <= redirect && if_id_w.valid &&\n+                        (if_id_w.pc != redirect_target);\n+    end\n+  end\n+\n+  always_comb begin\n+    id_ex_w = squash_token_q ? '0 : id_ex_raw;\n+  end\n+\n   // regfile interface (driven by ID + WB stages)\n   logic [4:0]  rs1_addr_w;\n   logic [4:0]  rs2_addr_w;\n@@ -122,7 +146,7 @@ module core (\n     .rs2_addr (rs2_addr_w),\n     .rs1_data (rs1_data_w),\n     .rs2_data (rs2_data_w),\n-    .out      (id_ex_w)\n+    .out      (id_ex_raw)\n   );\n \n   reg_file u_rf (\n@@ -181,7 +205,6 @@ module core (\n     .id_ex_rd       (id_ex_w.rd),\n     .if_id_rs1      (if_id_w.instr[19:15]),\n     .if_id_rs2      (if_id_w.instr[24:20]),\n-    .redirect       (redirect),\n     .ex_busy        (ex_busy),\n     .imem_ready     (io_imemReady),\n     .dmem_ready     (io_dmemReady),\ndiff --git a/cores/bench/rtl/hazard_unit.sv b/cores/bench/rtl/hazard_unit.sv\nindex 08b46d3..886d9bd 100644\n--\n…[3273 of 6345 chars elided by tools/bench/transcript.py; sha256:d37ee7bd770de009]…\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n-// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n-// observing a real rs1/rs2 from a wrong-path instruction and inserting\n-// a spurious load-use stall the cycle after a taken branch.\n+// On an imem-stall flush, the instruction emitted to ID is forced to NOP\n+// (`0x00000013` = ADDI x0,x0,0). Redirect cycles preserve the sequential\n+// fetch; core.sv marks it with a registered token if it enters ID/EX.\n //\n // Latency:        PC-reg update is synchronous; output is combinational.\n // RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n@@ -50,8 +49,8 @@ module if_stage (\n \n   always_comb begin\n     out.pc    = pc;\n-    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n-    out.valid = !(flush || redirect);\n+    out.instr = flush ? 32'h0000_0013 : imem_data;\n+    out.valid = !flush;\n   end\n \n endmodule\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/if_stage.sv\n", "exit_code": 0, "status": "completed"}}
