{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'git diff --check && git status --short && git diff -- cores/bench/rtl/reg_file.sv'","aggregated_output":" M cores/bench/rtl/reg_file.sv\ndiff --git a/cores/bench/rtl/reg_file.sv b/cores/bench/rtl/reg_file.sv\nindex 9dd38a4..ff101a1 100644\n--- a/cores/bench/rtl/reg_file.sv\n+++ b/cores/bench/rtl/reg_file.sv\n@@ -4,10 +4,9 @@\n //   - x0 hardwired to zero (writes silently dropped, reads always 0).\n //   - Two combinational read ports.\n //   - Single synchronous write port.\n-//   - Write-first bypass: a same-cycle write to the read address returns\n-//     the new value. This matches the prior Chisel core's RegFile.scala\n-//     and lets the ID stage see WB-stage writes within the same cycle\n-//     without an extra forwarding mux.\n+//   - Parallel one-hot reads, including the same-cycle WB value as one\n+//     mutually exclusive source. This lets the ID stage see WB-stage\n+//     writes without a serial post-read bypass mux.\n //\n // The reset clears all 32 registers. Distributed-LUT or flop inference is\n // fine here; explicit BRAM attribution lives on the larger imem/dmem\n@@ -31,6 +30,22 @@ module reg_file (\n \n   logic [31:0] regs [0:31];\n \n+  // Decode each source address once. x0 is deliberately omitted from the\n+  // register-row selects and from the WB source select, so reads of x0\n+  // remain zero even if an invalid write to x0 is presented.\n+  logic [31:1] rs1_decode;\n+  logic [31:1] rs2_decode;\n+  logic [31:1] wb_decode;\n+  logic [31:1] rs1_row_sel;\n+  logic [31:1] rs2_row_sel;\n+  logic        rs1_wb_sel;\n+  logic        rs2_wb_sel;\n+\n+  // Transposed bit-by-row terms give each output bit an explicit\n+  // reduction tree over the selected rows.\n+  logic [31:0][31:1] rs1_terms;\n+  logic [31:0][31:1] rs2_terms;\n+\n   always_ff @(posedge clock) begin\n     if (reset) begin\n       for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n@@ -40,19 +55,32 @@ module reg_file (\n   end\n \n   always_comb begin\n-    if (rs1_addr == 5'b0)\n-      rs1_data = 32'b0;\n-    else if (w_en && w_addr == rs1_addr)\n-      rs1_data = w_data;\n-    else\n-      rs1_data = regs[rs1_addr];\n-\n-    if (rs2_addr == 5'b0)\n-      rs2_data = 32'b0;\n-    else if (w_en && w_addr == rs2_addr)\n-      rs2_data = w_data;\n-    else\n-      rs2_data = regs[rs2_addr];\n+    for (int i = 1; i < 32; i++) begin\n+      rs1_decode[i] = (rs1_addr == 5'(i));\n+      rs2_decode[i] = (rs2_addr == 5'(i));\n+      wb_decode[i]  = (w_addr == 5'(i));\n+\n+      // The ordinary row and WB source are one-hot and mutually\n+      // exclusive when a write targets this source register.\n+      rs1_row_sel[i] = rs1_decode[i] && !(w_en && wb_decode[i]);\n+      rs2_row_sel[i] = rs2_decode[i] && !(w_en && wb_decode[i]);\n+    end\n+    rs1_wb_sel = w_en && (rs1_addr != 5'b0) && (rs1_addr == w_addr);\n+    rs2_wb_sel = w_en && (rs2_addr != 5'b0) && (rs2_addr == w_addr);\n+  end\n+\n+  for (genvar bit_idx = 0; bit_idx < 32; bit_idx++) begin : g_read_bits\n+    for (genvar row_idx = 1; row_idx < 32; row_idx++) begin : g_rows\n+      assign rs1_terms[bit_idx][row_idx] =\n+          regs[row_idx][bit_idx] & rs1_row_sel[row_idx];\n+      assign rs2_terms[bit_idx][row_idx] =\n+          regs[row_idx][bit_idx] & rs2_row_sel[row_idx];\n+    end\n+\n+    assign rs1_data[bit_idx] = (w_data[bit_idx] & rs1_wb_sel)\n+                             | (|rs1_terms[bit_idx]);\n+    assign rs2_data[bit_idx] = (w_data[bit_idx] & rs2_wb_sel)\n+                             | (|rs2_terms[bit_idx]);\n   end\n \n endmodule\n","exit_code":0,"status":"completed"}}
