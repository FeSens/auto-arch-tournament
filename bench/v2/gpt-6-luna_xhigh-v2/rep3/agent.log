D namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[2273 of 5345 chars elided by tools/bench/transcript.py; sha256:134068509dd5e99a]…\n     WRAPPER=\"$SCRIPT_DIR/wrapper_si.sv\"\n        CHECKS_CFG=\"$SCRIPT_DIR/checks_si.cfg\"\n        echo \"[run_all.sh] auto-detected nret=1 from $CORE_YAML; using wrapper_si.sv + checks_si.cfg\"\n    fi\nfi\n\nCHECKS_CFG=\"${CHECKS_CFG:-${1:-$SCRIPT_DIR/checks.cfg}}\"\nWRAPPER=\"${WRAPPER:-$SCRIPT_DIR/wrapper.sv}\"\nif [ ! -f \"$CHECKS_CFG\" ]; then\n    echo \"ERROR: checks.cfg not found at $CHECKS_CFG\"\n    exit 1\nfi\nif [ ! -f \"$WRAPPER\" ]; then\n    echo \"ERROR: wrapper not found at $WRAPPER\"\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 47.649\n  lut4: 2558\n  ff: 630\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20260930-002-r1s1\n  updated: '2026-09-30T05:19:25.248281Z'\n", "exit_code": 0, "status": "completed"}}
