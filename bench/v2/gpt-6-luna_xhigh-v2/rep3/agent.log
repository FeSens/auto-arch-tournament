gic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[6337 of 9409 chars elided by tools/bench/transcript.py; sha256:64d5bd3cb95ddf3a]…\n <= dmem_wdata[7:0];\nfpga/core_bench.sv:51:    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\nfpga/core_bench.sv:52:    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\nfpga/core_bench.sv:53:    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\nfpga/core_bench.sv:55:  // Combinational read — matches core's expected io_dmemRData semantics.\nfpga/core_bench.sv:56:  assign dmem_rdata = dmem[dmem_addr[12:2]];\nfpga/core_bench.sv:81:  logic imem_ready, dmem_ready;\nfpga/core_bench.sv:86:    .dmem_ready (dmem_ready)\nfpga/core_bench.sv:98:    .io_dmemAddr      (dmem_addr),\nfpga/core_bench.sv:99:    .io_dmemWData     (dmem_wdata),\nfpga/core_bench.sv:100:    .io_dmemRData     (dmem_rdata),\nfpga/core_bench.sv:101:    .io_dmemWEn       (dmem_wen),\nfpga/core_bench.sv:102:    .io_dmemREn       (dmem_ren),\nfpga/core_bench.sv:103:    .io_dmemReady     (dmem_ready),\nfpga/core_bench.sv:152:  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n", "exit_code": 0, "status": "completed"}}
