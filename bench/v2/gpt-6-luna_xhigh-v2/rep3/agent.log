redirect handling.\"\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"required\": [\"id\",\"title\",\"category\",\"motivation\",\"hypothesis\",\"expected_impact\",\"changes\"],\n  \"properties\": {\n    \"id\":       {\"type\": \"string\", \"pattern\": \"^hyp-[0-9]{8}-[0-9]{3}(-r[0-9]+s[0-9]+)?$\"},\n    \"title\":    {\"type\": \"string\", \"minLength\": 5},\n    \"category\": {\"type\": \"string\", \"enum\": [\"micro_opt\",\"structural\",\"extension\",\"predictor\",\"memory\"]},\n    \"motivation\":  {\"type\": \"string\", \"minLength\": 20},\n    \"hypothesis\":  {\"type\": \"string\", \"minLength\": 20},\n    \"expected_impact\": {\n      \"type\": \"object\",\n      \"required\": [\"fitness_delta_pct\",\"confidence\"],\n      \"properties\": {\n        \"fitness_delta_pct\": {\"type\": \"integer\"},\n        \"confidence\": {\"type\": \"string\", \"enum\": [\"low\",\"medium\",\"high\"]}\n      }\n    },\n    \"changes\": {\n      \"type\": \"array\", \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"file\",\"description\"],\n        \"properties\": {\n          \"file\":        {\n            \"type\": \"string\",\n            \"description\": \"Must be under rtl/ (any extension) or be a test/test_*.py cocotb suite. Anything else is rejected by the runtime sandbox check.\",\n            \"pattern\": \"^(rtl/[^.].*|test/test_[^/]+\\\\.py)$\"\n          },\n          \"description\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
