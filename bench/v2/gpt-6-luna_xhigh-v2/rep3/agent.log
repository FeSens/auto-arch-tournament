{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,230p' formal/riscv-formal/cores/bench-wt1AutW9d/if_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On an imem-stall flush, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). Redirect cycles preserve the sequential\n// fetch; core.sv marks it with a registered token if it enters ID/EX.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              train_valid,\n  input  logic [31:0]       train_pc,\n  input  logic [11:0]       train_target_low,\n  input  logic [11:0]       train_imm_bits,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] lookup_pc;\n  logic        lookup_hit;\n  logic [11:0] lookup_target;\n\n  // One exact-PC entry for a same-page taken backedge. Lookup metadata is\n  // registered with the PC, keeping both the tag compare and target decode\n  // out of the fetch PC register's D path.\n  logic        predictor_valid_q;\n  logic [31:0] predictor_pc_q;\n  logic [11:0] predictor_target_q;\n  logic [11:0] predictor_imm_q;\n  logic        pred_taken_q;\n  logic [11:0] pred_target_q;\n  logic [11:0] pred_imm_q;\n  logic [11:0] fetched_imm_bits;\n  logic        pred_taken_current;\n\n  always_comb begin\n    // The formal instruction source may present a differ\n…[1594 of 4666 chars elided by tools/bench/transcript.py; sha256:76c204efc7487edf]…\n     <= 12'b0;\n      pred_imm_q         <= 12'b0;\n    end else begin\n      if (train_valid) begin\n        predictor_valid_q  <= 1'b1;\n        predictor_pc_q     <= train_pc;\n        predictor_target_q <= train_target_low;\n        predictor_imm_q    <= train_imm_bits;\n      end\n\n      // Redirect must override stalls. On either redirect or ordinary\n      // advance, register the lookup for the address being installed in PC.\n      if (redirect) begin\n        pc            <= redirect_target;\n        pred_taken_q  <= lookup_hit;\n        pred_target_q <= lookup_target;\n        pred_imm_q    <= predictor_imm_q;\n      end else if (!stall) begin\n        pc            <= next_pc;\n        pred_taken_q  <= lookup_hit;\n        pred_target_q <= lookup_target;\n        pred_imm_q    <= predictor_imm_q;\n      end\n    end\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = flush ? 32'h0000_0013 : imem_data;\n    out.pred_taken = pred_taken_current;\n    out.valid = !flush;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
