n': 'Separate low-half carry generation from high-half completion and preserve first-stage branch resolution.'}, {'file': 'rtl/core.sv', 'description': 'Wire the added execute substage and forward its completed result to decode.'}, {'file': 'rtl/hazard_unit.sv', 'description': 'Align stalls and bubbles with the extra execute register while preserving in-order retirement.'}]}\ncategory: structural files: ['rtl/core_pkg.sv', 'rtl/ex_stage.sv', 'rtl/core.sv', 'rtl/hazard_unit.sv']\nschema required: ['id', 'title', 'category', 'motivation', 'hypothesis', 'expected_impact', 'changes']\nyaml parsed: True\n","exit_code":0,"status":"completed"}}
