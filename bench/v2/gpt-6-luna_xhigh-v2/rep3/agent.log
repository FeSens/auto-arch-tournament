lu_result;\n+      reg_q.effective_address <= (in.ctrl.mem_read || in.ctrl.mem_write)\n+                               ? effective_address : 32'b0;\n       reg_q.write_data    <= div_result_valid ? div_rs2_q : rs2;\n       reg_q.rd            <= in.rd;\n       reg_q.rs1_addr      <= in.rs1_addr;\ndiff --git a/cores/bench/rtl/mem_stage.sv b/cores/bench/rtl/mem_stage.sv\nindex eb40d73..25e28db 100644\n--- a/cores/bench/rtl/mem_stage.sv\n+++ b/cores/bench/rtl/mem_stage.sv\n@@ -74,15 +74,15 @@ module mem_stage (\n \n     // Byte-lane mask shifted to addr[1:0] * 1.\n     case (in.ctrl.mem_width)\n-      2'd0:    byte_mask = (4'b0001 << in.alu_result[1:0]);\n-      2'd1:    byte_mask = (4'b0011 << in.alu_result[1:0]);\n+      2'd0:    byte_mask = (4'b0001 << in.effective_address[1:0]);\n+      2'd1:    byte_mask = (4'b0011 << in.effective_address[1:0]);\n       default: byte_mask = 4'b1111;\n     endcase\n \n     mem_op       = in.ctrl.mem_read || in.ctrl.mem_write;\n     mem_misalign = mem_op && (\n-                     (in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\n-                     (in.ctrl.mem_width == 2'd1 && in.alu_result[0]   != 1'b0)\n+                     (in.ctrl.mem_width == 2'd2 && in.effective_address[1:0] != 2'b00) ||\n+                     (in.ctrl.mem_width == 2'd1 && in.effective_address[0]   != 1'b0)\n                      // 2'd0 (byte) is never misaligned.\n                    );\n \n@@ -93,13 +93,13 @@ module mem_stage (\n     end\n \n     // Combinational dmem outputs — gated off on misalign.\n-    dmem_addr  = in.alu_result;\n+    dmem_addr  = in.effective_address;\n     dmem_wdata = wdata_rep;\n     dmem_wen   = (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n     dmem_ren   = in.ctrl.mem_read  && !mem_misalign;\n \n     // Load extraction: shift right then sign/zero-extend the low N bits.\n-    shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\n+    shifted   = dmem_rdata >> (in.effective_address[1:0] * 8);\n     byte_val  = shifted[7:0];\n     hword_val = shifted[15:0];\n     case (in.ctrl.mem_width)\n@@ -114,7 +114,7 @@ module mem_stage (\n \n     // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n     aligned_addr = (mem_op && !mem_misalign)\n-                 ? {in.alu_result[31:2], 2'b00}\n+                 ? {in.effective_address[31:2], 2'b00}\n                  : 32'b0;\n   end\n \n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_46","type":"agent_message","text":"Implemented the dedicated forwarded `rs1 + imm` address path and routed memory access handling through its own EX/MEM field. This adds 32 registers; the measured address path is about 4.05 ns, and the new worst path is regfile to ID/EX.\n\nLint passed, formal passed (53/53), cosim passed (both ELFs), and FPGA/CoreMark eval passed. Median Fmax was 46.082 MHz; placement option 0 was limited by the regfile-to-ID/EX path.\n\nChanges are in [ex_stage.sv](/srv/hwebench/clones/gpt-6-luna_xhigh-v2-rep3/cores/bench/worktrees/hyp-20260930-001-r4s0/cores/bench/rtl/ex_stage.sv:114), [core_pkg.sv](/srv/hwebench/clones/gpt-6-luna_xhigh-v2-rep3/cores/bench/worktrees/hyp-20260930-001-r4s0/cores/bench/rtl/core_pkg.sv:99), and [mem_stage.sv](/srv/hwebench/clones/gpt-6-luna_xhigh-v2-rep3/cores/bench/worktrees/hyp-20260930-001-r4s0/cores/bench/rtl/mem_stage.sv:96). Implementation details and results are recorded in [implementation_notes.md](/srv/hwebench/clones/gpt-6-luna_xhigh-v2-rep3/cores/bench/worktrees/hyp-20260930-001-r4s0/implementation_notes.md)."}}
