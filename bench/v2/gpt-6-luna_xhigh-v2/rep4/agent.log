elta_pct\": 7, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add a direct forwarded-rs1 plus immediate effective-address adder and use its sum for load/store results entering EX/MEM.\"}], \"outcome\": \"regression\", \"fitness\": 104.36, \"delta_pct\": 0.16, \"vs_baseline\": 761.06, \"fmax_mhz\": 46.877, \"ipc_coremark\": 2e-06, \"cycles\": 4491817, \"iterations\": 10, \"lut4\": 2747, \"ff\": 631, \"seeds\": [44.206, 46.877, 46.877], \"perturbations\": [[0, 44.206, 21], [1, 46.877, 22], [2, 46.877, 22]], \"lutram\": 8, \"bsram\": 6, \"dsp\": 6, \"critical_path\": {\"from\": \"cpu/u_rf/regs_regs_0_0_s\", \"to\": \"cpu/u_id/id_ex_w.rs2_val_0_s100\", \"slack_ns\": -17.621, \"arrival_ns\": 27.916, \"logic_cells\": 42, \"modules\": [\"clock_ibuf\", \"cpu/u_id\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_hazard\", \"cpu/u_id\"]}, \"logic_levels\": 21, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-09-30T14:36:48.174708Z\", \"slot\": 0, \"round_id\": 4, \"lesson\": \"- 2026-09-30 hyp-20260930-001-r4s0 (regression, +0.16%): A parallel `rs1 + imm` effective-address path duplicates the 32-bit sum and adds an EX result mux; bypassing ALU selectors alone did not pay off here, so keep it only when measured timing gains outweigh datapath overhead.\"}\n","exit_code":0,"status":"completed"}}
