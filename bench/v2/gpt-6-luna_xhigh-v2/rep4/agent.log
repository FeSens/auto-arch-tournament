nary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid = !(flush || redirect);\n  end\n\nendmodule\ncores/bench/rtl/core.sv:39:  input  logic        io_imemReady,\ncores/bench/rtl/core.sv:187:    .imem_ready     (io_imemReady),\ncores/bench/rtl/hazard_unit.sv:29:  input  logic       imem_ready,\ncores/bench/rtl/hazard_unit.sv:52:    imem_stall = !imem_ready;\n","exit_code":0,"status":"completed"}}
