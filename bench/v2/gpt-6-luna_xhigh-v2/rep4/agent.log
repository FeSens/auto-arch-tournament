nject bubbles while a matching older EX writer or an EX/MEM load prevents a decode-stage branch from receiving its correct operand.\"\n  - file: rtl/if_stage.sv\n    description: \"Accept an ID-stage branch redirect without squashing the branch instruction that generated it, while preserving EX redirects for jumps.\"\n  - file: rtl/ex_stage.sv\n    description: \"Use the carried branch result for EX/MEM and RVFI metadata, and stop recomputing conditional branch redirects in EX.\"\n  - file: rtl/core.sv\n    description: \"Connect branch bypass values, early branch redirect signals, and the expanded branch dependency interlock.\"\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"required\": [\"id\",\"title\",\"category\",\"motivation\",\"hypothesis\",\"expected_impact\",\"changes\"],\n  \"properties\": {\n    \"id\":       {\"type\": \"string\", \"pattern\": \"^hyp-[0-9]{8}-[0-9]{3}(-r[0-9]+s[0-9]+)?$\"},\n    \"title\":    {\"type\": \"string\", \"minLength\": 5},\n    \"category\": {\"type\": \"string\", \"enum\": [\"micro_opt\",\"structural\",\"extension\",\"predictor\",\"memory\"]},\n    \"motivation\":  {\"type\": \"string\", \"minLength\": 20},\n    \"hypothesis\":  {\"type\": \"string\", \"minLength\": 20},\n    \"expected_impact\": {\n      \"type\": \"object\",\n      \"required\": [\"fitness_delta_pct\",\"confidence\"],\n      \"properties\": {\n        \"fitness_delta_pct\": {\"type\": \"integer\"},\n        \"confidence\": {\"type\": \"string\", \"enum\": [\"low\",\"medium\",\"high\"]}\n      }\n    },\n    \"changes\": {\n      \"type\": \"array\", \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"file\",\"description\"],\n        \"properties\": {\n          \"file\":        {\n            \"type\": \"string\",\n            \"description\": \"Must be under rtl/ (any extension) or be a test/test_*.py cocotb suite. Anything else is rejected by the runtime sandbox check