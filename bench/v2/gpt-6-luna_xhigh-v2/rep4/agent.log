n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[4528 of 7600 chars elided by tools/bench/transcript.py; sha256:635745acb8f0b338]…\nwrapper_si.sv\"\n98:        CHECKS_CFG=\"$SCRIPT_DIR/checks_si.cfg\"\n99:        echo \"[run_all.sh] auto-detected nret=1 from $CORE_YAML; using wrapper_si.sv + checks_si.cfg\"\n103:CHECKS_CFG=\"${CHECKS_CFG:-${1:-$SCRIPT_DIR/checks.cfg}}\"\n104:WRAPPER=\"${WRAPPER:-$SCRIPT_DIR/wrapper.sv}\"\n105:if [ ! -f \"$CHECKS_CFG\" ]; then\n106:    echo \"ERROR: checks.cfg not found at $CHECKS_CFG\"\n110:    echo \"ERROR: wrapper not found at $WRAPPER\"\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n150:# Stage rtl + wrapper + the chosen checks config under the framework's\n161:cp \"$WRAPPER\"                   \"$CORE_DIR/wrapper.sv\"\n169:# and rebuild from the glob, with core_pkg.sv first and wrapper.sv last.\n171:awk '/^\\[verilog-files\\]/{exit} {print}' \"$CHECKS_CFG\" > \"$STAGED_CFG\"\n179:        [ \"$name\" = \"wrapper.sv\" ] && continue\n182:    echo \"@basedir@/cores/@core@/wrapper.sv\"\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n187:# yields @core@=\"$CORE_NAME-<suffix>\". The [verilog-files] lines we just\n", "exit_code": 0, "status": "completed"}}
