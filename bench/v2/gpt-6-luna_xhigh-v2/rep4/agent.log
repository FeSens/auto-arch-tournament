S+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[3414 of 6486 chars elided by tools/bench/transcript.py; sha256:d730d23d910246e4]…\nmal_nret.py:55:        (core_dir / \"core.yaml\").write_text(f\"name: {name}\\nnret: {nret}\\n\")\ntools/eval/test_formal_nret.py:69:    _mk_core(tmp_path, \"v1\")  # no core.yaml\ntools/eval/test_formal_nret.py:144:    assert \"NRET\" not in env\ntools/eval/test_formal_nret.py:152:    assert env[\"NRET\"] == \"2\"\ntools/eval/test_formal_nret.py:158:    assert env[\"NRET\"] == \"2\"\ntools/eval/test_formal_nret.py:166:    assert env[\"NRET\"] == \"1\"\ntools/eval/cosim.py:28:    Reads cores/<target>/core.yaml's `nret` (defaults to 2) and injects\ntools/eval/cosim.py:29:    NRET=<n> so build.sh can pass `-DNRET=<n>` to verilator. main.cpp's\ntools/eval/cosim.py:30:    channel-1 drain is compiled out under `#if NRET < 2`, so a single-\ntools/eval/cosim.py:39:    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\ntools/eval/test_fpga_report.py:85:    (tmp_path / \"cores\" / \"x\" / \"core.yaml\").write_text(\"nret: 1\\n\")\ntools/eval/test_fpga_report.py:87:    (tmp_path / \"cores\" / \"x\" / \"core.yaml\").write_text(\"nret: 2\\n\")\n", "exit_code": 0, "status": "completed"}}
