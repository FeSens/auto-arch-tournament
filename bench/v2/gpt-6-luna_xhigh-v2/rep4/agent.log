{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c 'git status --short && git diff -- cores/bench/rtl/alu.sv cores/bench/rtl/ex_stage.sv'","aggregated_output":" M cores/bench/rtl/alu.sv\n M cores/bench/rtl/ex_stage.sv\ndiff --git a/cores/bench/rtl/alu.sv b/cores/bench/rtl/alu.sv\nindex 92128f2..ff8361d 100644\n--- a/cores/bench/rtl/alu.sv\n+++ b/cores/bench/rtl/alu.sv\n@@ -9,7 +9,10 @@ module alu (\n   input  logic [4:0]  op,\n   input  logic [31:0] a,\n   input  logic [31:0] b,\n-  output logic [31:0] out\n+  output logic [31:0] out,\n+  output logic        cmp_eq,\n+  output logic        cmp_lt_signed,\n+  output logic        cmp_lt_unsigned\n );\n \n   logic        [4:0]  shamt;\n@@ -27,6 +30,13 @@ module alu (\n   always_comb begin\n     shamt = b[4:0];\n \n+    // Keep one equality and unsigned ordering cone for both ALU set-less-\n+    // than operations and EX branch resolution. Signed ordering follows\n+    // from the sign bits when they differ, and otherwise uses unsigned order.\n+    cmp_eq          = (a == b);\n+    cmp_lt_unsigned = (a < b);\n+    cmp_lt_signed   = (a[31] != b[31]) ? a[31] : cmp_lt_unsigned;\n+\n     mul_ss = $signed({{32{a[31]}}, a}) * $signed({{32{b[31]}}, b});\n     mul_uu = {32'b0, a} * {32'b0, b};\n     mul_su = $signed({{32{a[31]}}, a}) * $signed({32'b0, b});\n@@ -37,8 +47,8 @@ module alu (\n       ALU_AND:    out = a & b;\n       ALU_OR:     out = a | b;\n       ALU_XOR:    out = a ^ b;\n-      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n-      ALU_SLTU:   out = {31'b0, a < b};\n+      ALU_SLT:    out = {31'b0, cmp_lt_signed};\n+      ALU_SLTU:   out = {31'b0, cmp_lt_unsigned};\n       ALU_SLL:    out = a << shamt;\n       ALU_SRL:    out = a >> shamt;\n       ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\ndiff --git a/cores/bench/rtl/ex_stage.sv b/cores/bench/rtl/ex_stage.sv\nindex d758bfe..71902ea 100644\n--- a/cores/bench/rtl/ex_stage.sv\n+++ b/cores/bench/rtl/ex_st