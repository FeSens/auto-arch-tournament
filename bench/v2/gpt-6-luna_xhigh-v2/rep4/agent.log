 - file: rtl/ex_stage.sv\n    description: \"Compare the resolved architectural next PC with the carried prediction and redirect only when they differ.\"\n  - file: rtl/core.sv\n    description: \"Connect EX return training signals to the fetch-stage predictor while preserving existing stall and retirement behavior.\"\n","exit_code":0,"status":"completed"}}
