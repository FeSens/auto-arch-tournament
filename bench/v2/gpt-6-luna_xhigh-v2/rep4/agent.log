{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c 'git status --short --untracked-files=all && git diff --check && git diff --stat && git diff -- cores/bench/rtl/alu.sv'","aggregated_output":" M cores/bench/rtl/alu.sv\n cores/bench/rtl/alu.sv | 32 ++++++++++++++++++--------------\n 1 file changed, 18 insertions(+), 14 deletions(-)\ndiff --git a/cores/bench/rtl/alu.sv b/cores/bench/rtl/alu.sv\nindex 92128f2..fb30f37 100644\n--- a/cores/bench/rtl/alu.sv\n+++ b/cores/bench/rtl/alu.sv\n@@ -14,22 +14,26 @@ module alu (\n \n   logic        [4:0]  shamt;\n \n-  // 64-bit products, computed once and selected per op.\n-  // mul_ss/mul_su low halves are unused (only MULH/MULHSU read the high\n-  // half). Verilator's UNUSEDSIGNAL is silenced locally — the unused\n-  // bits are dead-code-eliminated by Yosys.\n-  /* verilator lint_off UNUSEDSIGNAL */\n-  logic signed [63:0] mul_ss;  // signed*signed\n-  logic        [63:0] mul_uu;  // unsigned*unsigned (both halves used)\n-  logic signed [63:0] mul_su;  // signed*unsigned (a signed, b unsigned)\n-  /* verilator lint_on UNUSEDSIGNAL */\n+  // One unsigned product supplies MUL and all high-half operations.\n+  // Signed high halves are the unsigned product's high word minus each\n+  // negative signed operand's contribution modulo 2^32.\n+  logic [63:0] mul_uu;\n+  logic [31:0] mul_corr_a;\n+  logic [31:0] mul_corr_b;\n+  logic [31:0] mul_correction;\n+  logic [31:0] mul_signed_high;\n \n   always_comb begin\n     shamt = b[4:0];\n \n-    mul_ss = $signed({{32{a[31]}}, a}) * $signed({{32{b[31]}}, b});\n-    mul_uu = {32'b0, a} * {32'b0, b};\n-    mul_su = $signed({{32{a[31]}}, a}) * $signed({32'b0, b});\n+    mul_uu = a * b;\n+\n+    // MULH treats both inputs as signed; MULHSU treats only a as signed.\n+    // MULHU and MUL need no correction.\n+    mul_corr_a = ((op == ALU_MULH || op == ALU_MULHSU) && a[31]) ? b : 32'b0;\n+    mul_corr_b = (op == ALU_MULH && b[31]) ? a : 32'b0;\n+    mul_correction = mul_corr_a + mul_corr_b;\n+    mul_signed_high = mul_uu[63:32] - mul_correction;\n \n     case (op)\n       ALU_ADD:    out = a + b;\n@@ -61,9 +65,9 @@ module alu (\n       ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\n `else\n       ALU_MUL:    out = mul_uu[31:0];\n-      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\n+      ALU_MULH:   out = mul_signed_high;\n       ALU_MULHU:  out = mul_uu[63:32];\n-      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\n+      ALU_MULHSU: out = mul_signed_high;\n       // These operations are handled by ex_stage.sv. Keeping explicit\n       // constants here prevents a combinational divider from entering the\n       // forwarding-to-ALU critical path.\n","exit_code":0,"status":"completed"}}
