\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\ntest/cosim/build.sh:5:# RTL_DIR (default: rtl/) is globbed dynamically (with core_pkg.sv forced\ntest/cosim/build.sh:14:if [ -z \"${RTL_DIR:-}\" ] || [ -z \"${OBJ_DIR:-}\" ]; then\ntest/cosim/build.sh:15:  echo \"ERROR: test/cosim/build.sh requires RTL_DIR and OBJ_DIR env vars.\" >&2\ntest/cosim/build.sh:16:  echo \"  Example: RTL_DIR=cores/v1/rtl OBJ_DIR=cores/v1/obj_dir bash test/cosim/build.sh\" >&2\ntest/cosim/build.sh:20:# NRET picks which RVFI port set main.cpp expects on `core`.\ntest/cosim/build.sh:23:# whose core.yaml declares nret: 1.\ntest/cosim/build.sh:24:NRET=\"${NRET:-2}\"\ntest/cosim/build.sh:34:# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\ntest/cosim/build.sh:39:[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\ntest/cosim/build.sh:40:for f in \"$RTL_DIR\"/*.sv; do\ntest/cosim/build.sh:52:  \"+incdir+$RTL_DIR\" \\\ntest/cosim/build.sh:55:  -CFLAGS \"-DNRET=$NRET\" \\\nMakefile:62:  RTL_DIR    := cores/$(TARGET)/rtl\nMakefile:64:  CORE_NAME  := $(TARGET)\nMakefile:73:export RTL_DIR CORE_NAME OBJ_DIR GEN_DIR\nMakefile:94:# verilator lint over $(RTL_DIR)/.\nMakefile:98:\t@if ls $(RTL_DIR)/*.sv >/dev/null 2>&1; then \\\nMakefile:99:\t  verilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+$(RTL_DIR) \\\nMakefile:100:\t    $(if $(wildcard $(RTL_DIR)/core_pkg.sv),$(RTL_DIR)/core_pkg.sv) \\\nMakefile:101:\t    $(filter-out $(RTL_DIR)/core_pkg.sv,$(wildcard $(