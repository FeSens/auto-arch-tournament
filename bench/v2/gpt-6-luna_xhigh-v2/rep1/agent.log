tl/forward_unit.sv\", \"description\": \"Adapt producer priority and bypass selection for the added execute stage.\"}, {\"file\": \"rtl/hazard_unit.sv\", \"description\": \"Update load-use interlocks, redirect flushing, and backpressure holds for the deeper pipeline.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 8, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl\n…[16854 of 19926 chars elided by tools/bench/transcript.py; sha256:c1afeae571b21b63]…\nn\", \"fitness\": 88.02, \"delta_pct\": -19.32, \"vs_baseline\": 626.24, \"fmax_mhz\": 40.185, \"ipc_coremark\": 2e-06, \"cycles\": 4565380, \"iterations\": 10, \"lut4\": 2756, \"ff\": 625, \"seeds\": [39.503, 40.185, 40.185], \"perturbations\": [[0, 39.503, 26], [1, 40.185, 27], [2, 40.185, 27]], \"lutram\": 40, \"bsram\": 4, \"dsp\": 6, \"critical_path\": {\"from\": \"cpu/u_ex/reg_q.rd_1_s0\", \"to\": \"cpu/u_if/pc_2_s1\", \"slack_ns\": -20.315, \"arrival_ns\": 30.609, \"logic_cells\": 42, \"modules\": [\"clock_ibuf\", \"cpu/u_fwd\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_id\", \"cpu/u_if\", \"cpu/u_rf\", \"cpu/u_id\", \"cpu/u_if\"]}, \"logic_levels\": 26, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-09-29T12:17:46.290649Z\", \"slot\": 1, \"round_id\": 5, \"lesson\": \"- 2026-09-29 hyp-20260929-002-r5s1 (regression, -19.32%): Resolving branches in ID without ID/EX and EX/MEM bypasses makes dependent branches wait for producers to reach WB, adding enough interlock cycles on CoreMark to outweigh the shorter redirect path.\"}\n", "exit_code": 0, "status": "completed"}}
