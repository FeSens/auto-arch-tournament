{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"git status --short && git diff --check && git diff --stat && sed -n '130,205p' cores/bench/rtl/ex_stage.sv\"","aggregated_output":" M cores/bench/rtl/ex_stage.sv\n cores/bench/rtl/ex_stage.sv | 55 ++++++++++++++++++++++++++++++++-------------\n 1 file changed, 40 insertions(+), 15 deletions(-)\n\n  assign div_stall = div_wait;\n\n  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n  logic        branch_taken;\n  logic        branch_equal;\n  logic        branch_unsigned_lt;\n  logic        branch_signed_lt;\n  logic [3:0]  branch_byte_equal;\n  logic [3:0]  branch_byte_lt;\n  logic        branch_hi_equal;\n  logic        branch_lo_equal;\n  logic        branch_hi_lt;\n  logic        branch_lo_lt;\n  logic [31:0] branch_target;\n  logic [31:0] jump_target;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  always_comb begin\n    // Compare four bytes in parallel. Resolve each two-byte half first,\n    // then combine the high half ahead of the low half. A lower byte only\n    // decides the result when every more-significant byte is equal.\n    branch_byte_equal[0] = (rs1[7:0]   == rs2[7:0]);\n    branch_byte_equal[1] = (rs1[15:8]  == rs2[15:8]);\n    branch_byte_equal[2] = (rs1[23:16] == rs2[23:16]);\n    branch_byte_equal[3] = (rs1[31:24] == rs2[31:24]);\n    branch_byte_lt[0]    = (rs1[7:0]   < rs2[7:0]);\n    branch_byte_lt[1]    = (rs1[15:8]  < rs2[15:8]);\n    branch_byte_lt[2]    = (rs1[23:16] < rs2[23:16]);\n    branch_byte_lt[3]    = (rs1[31:24] < rs2[31:24]);\n\n    branch_hi_equal = branch_byte_equal[3] & branch_byte_equal[2];\n    branch_lo_equal = branch_byte_equal[1] & branch_byte_equal[0];\n    branch_hi_lt    = branch_byte_lt[3] |\n                      (branch_byte_equal[3] & branch_byte_lt[2]);\n    branch_lo_lt    = branch_byte_lt[1] |\n                      (branch_byte_equal[1] & branch_byte_lt[0]);\n    branch_equal   = branch_hi_equal & branch_lo_equal;\n    branch_unsigned_lt = branch_hi_lt |\n                         (branch_hi_equal & branch_lo_lt);\n\n    // Signed and unsigned order differ only for opposite-sign operands.\n    branch_signed_lt = (rs1[31] != rs2[31]) ? rs1[31] : branch_unsigned_lt;\n\n    // Combine the three predicate families directly. For legal funct3\n    // encodings, bit 0 selects the predicate's inverse; bits 2:1 select\n    // equality, signed less-than, or unsigned less-than. Decoder validity\n    // gates branch execution, so reserved encodings need no extra arm.\n    branch_cond = ((~in.ctrl.branch_op[2] & branch_equal) |\n                   ( in.ctrl.branch_op[2] & ~in.ctrl.branch_op[1] &\n                     branch_signed_lt) |\n                   ( in.ctrl.branch_op[2] &  in.ctrl.branch_op[1] &\n                     branch_unsigned_lt)) ^ in.ctrl.branch_op[0];\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    jalr_sum    = rs1 + in.imm;\n    jump_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0}\n                                  : (in.pc + in.imm);\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n","exit_code":0,"status":"completed"}}
