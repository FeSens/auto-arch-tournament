{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"sed -n '1,65p' cores/bench/rtl/core.sv\"","aggregated_output":"// Top-level RV32IM core with two-entry elastic queues between stages.\n//\n// Each queue owns its occupancy locally. A consumer never drives a ready\n// signal through all upstream stages: a blocked data request fills EX/MEM,\n// then ID/EX, then IF/ID over subsequent clocks. The queue head remains\n// stable until its consumer accepts it.\nmodule core (\n  input  logic        clock,\n  input  logic        reset,\n  output logic [31:0] io_imemAddr,\n  input  logic [31:0] io_imemData,\n  input  logic        io_imemReady,\n  output logic [31:0] io_dmemAddr,\n  input  logic [31:0] io_dmemRData,\n  output logic [31:0] io_dmemWData,\n  output logic [3:0]  io_dmemWEn,\n  output logic        io_dmemREn,\n  input  logic        io_dmemReady,\n  output logic        io_rvfi_valid_0,\n  output logic [63:0] io_rvfi_order_0,\n  output logic [31:0] io_rvfi_insn_0,\n  output logic        io_rvfi_trap_0,\n  output logic        io_rvfi_halt_0,\n  output logic        io_rvfi_intr_0,\n  output logic [1:0]  io_rvfi_mode_0,\n  output logic [1:0]  io_rvfi_ixl_0,\n  output logic [4:0]  io_rvfi_rs1_addr_0,\n  output logic [31:0] io_rvfi_rs1_rdata_0,\n  output logic [4:0]  io_rvfi_rs2_addr_0,\n  output logic [31:0] io_rvfi_rs2_rdata_0,\n  output logic [4:0]  io_rvfi_rd_addr_0,\n  output logic [31:0] io_rvfi_rd_wdata_0,\n  output logic [31:0] io_rvfi_pc_rdata_0,\n  output logic [31:0] io_rvfi_pc_wdata_0,\n  output logic [31:0] io_rvfi_mem_addr_0,\n  output logic [3:0]  io_rvfi_mem_rmask_0,\n  output logic [3:0]  io_rvfi_mem_wmask_0,\n  output logic [31:0] io_rvfi_mem_rdata_0,\n  output logic [31:0] io_rvfi_mem_wdata_0\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  // Two-entry FIFOs, ordered oldest-first. Counts are registered; stage\n  // admission checks only the local FIFO occupancy, so memory/divider\n  // backpressure cannot form a same-cycle chain back to fetch.\n  if_id_t  if_q0, if_q1;\n  id_ex_t  id_q0, id_q1;\n  ex_mem_t ex_q0, ex_q1;\n  mem_wb_t wb_q0, wb_q1;\n  logic [1:0] if_count, id_count, ex_count, wb_count;\n\n  logic [31:0] pc_q;\n  logic [31:0] redirect_target;\n  logic        redirect;\n  logic        fetch_push, id_push, ex_push, mem_push;\n  logic        id_pop, ex_pop, mem_pop, wb_pop;\n  logic        ex_operand_wait;\n  logic        ex_is_div;\n  logic        ex_fire;\n\n  // Fetch fills IF/ID whenever the instruction bus accepts the current PC.\n  // Redirects discard all younger fetched work and restart at the target.\n  assign io_imemAddr = pc_q;\n  assign fetch_push = io_imemReady && (if_count != 2'd2) && !redirect;\n","exit_code":0,"status":"completed"}}
