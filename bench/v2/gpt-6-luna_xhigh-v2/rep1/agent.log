\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n1:.PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\n53:CORE_TARGETS := lint test cosim cosim-build formal formal-deep fpga next loop\n79:\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n113:\tpython3 -m tools.eval.cosim . $(TARGET)\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n116:\tbash test/cosim/build.sh\n137:fpga: cosim-build bench/programs/coremark.elf\n178:\trm -rf test/cosim/sim_build sim_build out\n","exit_code":0,"status":"completed"}}
