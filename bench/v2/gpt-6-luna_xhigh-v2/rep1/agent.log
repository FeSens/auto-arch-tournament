 output logic [3:0]  io_dmemWEn,\n  output logic        io_dmemREn,\n  // dmem bus backpressure. Drive 1 for zero-wait. Drive 0 to model\n  // dStall — when there is a memory op in EX/MEM, the entire pipeline\n  // freezes back to MEM; MEM/WB captures a bubble; the LOAD/STORE waits\n  // until the bus delivers.\n  input  logic        i\n…[9970 of 13042 chars elided by tools/bench/transcript.py; sha256:cff1ed6e24712b72]…\n&& !dmem_stall;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\ntotal 68\ndrwxrwx---+ 8 nobody nogroup 4096 Sep 29 12:17 .\ndrwxrwx---+ 3 nobody nogroup 4096 Sep 29 12:14 ..\n-rw-rw----+ 1 nobody nogroup    0 Sep 29 12:14 CORE_PHILOSOPHY.md\n-rw-rw----+ 1 nobody nogroup  545 Sep 29 12:17 core.yaml\ndrwxrwx---+ 3 nobody nogroup 4096 Sep 29 12:38 experiments\ndrwxrwx---+ 5 nobody nogroup 4096 Sep 29 12:15 generated\ndrwxrwx---+ 2 nobody nogroup 4096 Sep 29 12:14 obj_dir\ndrwxrwx---+ 2 nobody nogroup 4096 Sep 29 12:14 rtl\ndrwxrwx---+ 2 nobody nogroup 4096 Sep 29 12:14 test\ndrwxrwx---+ 2 nobody nogroup 4096 Sep 29 12:38 worktrees\n", "exit_code": 0, "status": "completed"}}
