$(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>/.\n# TARGET is required for all core-touching targets (enforced below).\nTARGET ?=\n\n# Targets that require TARGET=<core_name>.\nCORE_TARGETS := lint test cosim cosim-build formal formal-deep fpga next loop\n\nifeq ($(strip $(TARGET)),)\n62:  RTL_DIR    := cores/$(TARGET)/rtl\n64:  CORE_NAME  := $(TARGET)\n73:export RTL_DIR CORE_NAME OBJ_DIR GEN_DIR\n94:# verilator lint over $(RTL_DIR)/.\n98:\t@if ls $(RTL_DIR)/*.sv >/dev/null 2>&1; then \\\n99:\t  verilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+$(RTL_DIR) \\\n100:\t    $(if $(wildcard $(RTL_DIR)/core_pkg.sv),$(RTL_DIR)/core_pkg.sv) \\\n101:\t    $(filter-out $(RTL_DIR)/core_pkg.sv,$(wildcard $(RTL_DIR)/*.sv)); \\\n103:\t  echo \"lint: no source files in $(RTL_DIR)/\"; \\\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n","exit_code":0,"status":"completed"}}
