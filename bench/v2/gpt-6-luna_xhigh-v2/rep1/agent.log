e cosim TARGET=v1    — RVFI cosim against Python ISS\"\nMakefile:80:\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\nMakefile:81:\t@echo \"  make formal-deep TARGET=v1 — full formal suite without ALTOPS (slow, bitvector-correct)\"\nMakefile:82:\t@echo \"  make fpga TARGET=v1     — FPGA fitness eval (Gowin Fmax + CoreMark cycles)\"\nMakefile:83:\t@echo \"  make timing TARGET=v1   — Gowin Fmax and worst paths (placement option 0)\"\nMakefile:85:\t@echo \"  make next TARGET=v1     — one orchestrator round\"\nMakefile:86:\t@echo \"  make loop TARGET=v1 N=10 — N orchestrator rounds (auto-spawns .worktrees/<TARGET> on branch core-<TARGET>; pass WORKTREE= to opt out)\"\nMakefile:87:\t@echo \"  make report TARGET=v1   — per-core experiment summary\"\nMakefile:88:\t@echo \"  make clean TARGET=v1    — remove per-core build artifacts (use with TARGET=)\"\nMakefile:112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\nMakefile:113:\tpython3 -m tools.eval.cosim . $(TARGET)\nMakefile:115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\nMakefile:137:fpga: cosim-build bench/programs/coremark.elf\nMakefile:138:\tpython3 -m tools.eval.fpga . $(TARGET)\nMakefile:141:\tpython3 -m tools.eval.gowin $(TARGET)\nMakefile:151:\tAGENT_PROVIDER=$(AGENT) python3 -m tools.orchestrator $(subst --iterations $(N),--iterations 1,$(ORCH_FLAGS)) $(ORCH_TARGET_FLAG)\nMakefile:166:\t  TARGET=$(TARGET) N=$(N) K=$(K) AGENT=$(AGENT) \\\nMakefile:171:\tAGENT_PROVIDER=$(AGENT) python3 -m tools.orchestrator $(ORCH_FLAGS) $(ORCH_TARGET_FLAG)\nMakefile:175:\tpython3 -m tools.orchestrator --report $(ORCH_TARGET_FLAG)\nMakefile:184:ifneq ($(strip $(TARGET)),)\nMakefile:187:\trm -rf cores/$(TARGET)/sim_build\n","exit_code":0,"status":"completed"}}
