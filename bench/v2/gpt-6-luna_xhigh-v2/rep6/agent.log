etch prediction metadata through the ID/EX register to branch resolution.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Compare prediction with actual branch outcome and redirect only on a mismatch while retaining architectural pc_next.\"}]}, \"expected_impact\": {\"fitness_delta_pct\": 6, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \n…[12506 of 15578 chars elided by tools/bench/transcript.py; sha256:6fe58bda514d8f9e]…\nitness\": 81.12, \"delta_pct\": -24.6, \"vs_baseline\": 569.31, \"fmax_mhz\": 34.348, \"ipc_coremark\": 2e-06, \"cycles\": 4234400, \"iterations\": 10, \"lut4\": 2982, \"ff\": 562, \"seeds\": [35.843, 34.348, 34.348], \"perturbations\": [[0, 35.843, 32], [1, 34.348, 32], [2, 34.348, 32]], \"lutram\": 40, \"bsram\": 4, \"dsp\": 6, \"critical_path\": {\"from\": \"cpu/u_mem/reg_q.rd_3_s0\", \"to\": \"cpu/u_if/pc_7_s1\", \"slack_ns\": -22.899, \"arrival_ns\": 33.193, \"logic_cells\": 86, \"modules\": [\"clock_ibuf\", \"cpu/u_fwd\", \"cpu/u_ex\", \"cpu/u_divider\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_rf\", \"cpu/u_id\", \"cpu/u_if\"]}, \"logic_levels\": 32, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-10-01T04:35:05.041805Z\", \"slot\": 2, \"round_id\": 4, \"lesson\": \"- 2026-10-01 hyp-20261001-003-r4s2 (regression, -24.60%): Operand-based ID branch resolution can trade EX redirect bubbles for a longer ID-to-fetch-PC path, since EX/MEM bypass muxes, branch comparison, and target generation now feed the redirect decision.\"}\n", "exit_code": 0, "status": "completed"}}
