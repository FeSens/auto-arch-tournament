{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/reg_file.sv cores/bench/rtl/forward_unit.sv cores/bench/rtl/ex_stage.sv cores/bench/rtl/core.sv cores/bench/test/test_reg_file.py'", "aggregated_output": "diff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex cca8847..ddd2faf 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -5,7 +5,7 @@\n //  IF -> ID -> EX -> MEM -> WB\n //   |    |     ^\n //   |    +-----+    forward_unit drives EX-stage rs1/rs2 muxes\n-//   |               from EX/MEM and MEM/WB\n+//   |               from EX/MEM, MEM/WB, and retained prior WB\n //   +- stall <- hazard_unit (load-use)\n //\n // IO port names use the `io_*` Chisel-emit prefix so the existing\n@@ -96,6 +96,9 @@ module core (\n   logic        wb_w_en;\n   logic [4:0]  wb_w_addr;\n   logic [31:0] wb_w_data;\n+  logic        prev_wb_w_en_q;\n+  logic [4:0]  prev_wb_w_addr_q;\n+  logic [31:0] prev_wb_w_data_q;\n \n   // ── IF ────────────────────────────────────────────────────────────────\n   if_stage u_if (\n@@ -179,6 +182,7 @@ module core (\n     .fwd_rs2_sel     (fwd_rs2_sel),\n     .fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\n     .fwd_mem_wb      (wb_w_data),            // WB-stage's write-mux output\n+    .fwd_prev_wb     (prev_wb_w_data_q),\n     .divider_hold    (div_wait),\n     .divider_start   (div_start),\n     .divider_result  (div_result),\n@@ -211,6 +215,23 @@ module core (\n     .w_data (wb_w_data)\n   );\n \n+  // The register file no longer has a same-cycle WB read bypass. Preserve\n+  // the latest actual WB write for the following EX cycle, when an ID/EX\n+  // operand captured on the write edge may still contain the old value.\n+  // Keep the entry through bubbles and memory stalls so a held ID/EX\n+  // instruction can use it when it finally advances.\n+  always_ff @(posedge clock) begin\n+    if (reset) begin\n+      prev_wb_w_en_q   <= 1'b0;\n+      prev_wb_w_addr_q <= 5'b0;\n+      prev_wb_w_data_q <= 32'b0;\n+    end else if (wb_w_en && wb_w_addr != 5'b0) begin\n+      prev_wb_w_en_q   <= 1'b1;\n+      prev_wb_w_addr_q <= wb_w_addr;\n+      prev_wb_w_data_q <= wb_w_data;\n+    end\n+  end\n+\n   // ── Hazard / forwarding ───────────────────────────────────────────────\n   hazard_unit u_hazar\n…[5225 of 8297 chars elided by tools/bench/transcript.py; sha256:e3a570b17ebc59ab]…\n synchronous-reset-clears-all property.\"\"\"\n+\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, registered writes,\n+and the synchronous-reset-clears-all property.\"\"\"\n from __future__ import annotations\n \n import cocotb\n@@ -67,16 +67,19 @@ async def x0_hardwired(dut):\n \n \n @cocotb.test()\n-async def write_first_bypass(dut):\n+async def no_same_cycle_write_through(dut):\n     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n     await _reset(dut)\n-    # Combinational read of an addr that is being written this cycle:\n-    # bypass returns the new write data.\n+    # Reads expose the stored value during the write cycle. The new value\n+    # becomes visible after the synchronous write edge.\n     dut.rs1_addr.value = 7\n     dut.w_en.value     = 1\n     dut.w_addr.value   = 7\n     dut.w_data.value   = 0x12345678\n     await Timer(1, \"ns\")\n+    assert int(dut.rs1_data.value) == 0\n+    await RisingEdge(dut.clock)\n+    await Timer(1, \"ns\")\n     assert int(dut.rs1_data.value) == 0x12345678\n     dut.w_en.value = 0\n \n", "exit_code": 0, "status": "completed"}}
