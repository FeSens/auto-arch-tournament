applying high-word sign corrections for signed variants.\"\n      }\n    ]\n  },\n  \"expected_impact\": {\n    \"fitness_delta_pct\": 5,\n    \"confidence\": \"low\"\n  },\n  \"changes\": [\n    {\n      \"file\": \"rtl/alu.sv\",\n      \"description\": \"Share one unsigned multiplier across MUL, MULH, MULHU, and MULHSU, applying high-word sign corrections for signed variants.\"\n    }\n  ],\n  \"outcome\": \"regression\",\n  \"fitness\": 97.11,\n  \"delta_pct\": -9.74,\n  \"vs_baseline\": 701.24,\n  \"fmax_mhz\": \n…[4492 of 7564 chars elided by tools/bench/transcript.py; sha256:fe76b0dbbf9fff56]…\n,\n    43.578\n  ],\n  \"perturbations\": [\n    [\n      0,\n      41.839,\n      22\n    ],\n    [\n      1,\n      43.578,\n      23\n    ],\n    [\n      2,\n      43.578,\n      23\n    ]\n  ],\n  \"lutram\": 8,\n  \"bsram\": 6,\n  \"dsp\": 2,\n  \"critical_path\": {\n    \"from\": \"cpu/u_rf/regs_regs_0_0_s0\",\n    \"to\": \"cpu/u_id/id_ex_w.rs2_val_8_s1\",\n    \"slack_ns\": -18.901,\n    \"arrival_ns\": 29.196,\n    \"logic_cells\": 44,\n    \"modules\": [\n      \"clock_ibuf\",\n      \"cpu/u_id\",\n      \"cpu/u_ex\",\n      \"cpu/u_divider\",\n      \"cpu/u_ex\",\n      \"cpu/u_if\",\n      \"cpu/u_hazard\",\n      \"cpu/u_id\"\n    ]\n  },\n  \"logic_levels\": 22,\n  \"formal_passed\": true,\n  \"cosim_passed\": true,\n  \"error\": null,\n  \"implementation_notes\": \"\",\n  \"timestamp\": \"2026-10-01T05:32:46.516001Z\",\n  \"slot\": 1,\n  \"round_id\": 6,\n  \"lesson\": \"- 2026-10-01 hyp-20261001-002-r6s1 (regression, -11.66%): A shared two-stage multiplier holds this in-order EX stage for an extra cycle on each multiply, so its per-operation latency can outweigh shorter multiplier logic on CoreMark.\"\n}\n", "exit_code": 0, "status": "completed"}}
