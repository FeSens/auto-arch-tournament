t  logic [11:0]       train_disp,\n  input  logic              train_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic        target_valid_q;\n  logic [31:0] target_pc_q;\n  logic [31:0] target_q;\n  logic [11:0] target_disp_q;\n  logic        direction_q;\n  logic        target_hit;\n  logic        predicted_taken;\n\n  always_comb begin\n    target_hit      = target_valid_q && (pc == target_pc_q) &&\n                      (imem_data[6:0] == 7'b1100011) &&\n                      (imem_data[14:12] != 3'b010) &&\n                      (imem_data[14:12] != 3'b011) &&\n                      ({imem_data[31], imem_data[7], imem_data[30:25],\n                        imem_data[11:8]} == target_disp_q);\n    predicted_taken = target_hit && direction_q;\n  end\n\n  always_comb begin\n    if (redirect)\n      next_pc = redirect_target;\n    else if (predicted_taken)\n      next_pc = target_q;\n    else\n      next_pc = pc + 32'd4;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc             <= RESET_PC;\n      target_valid_q <= 1'b0;\n      target_pc_q    <= 32'b0;\n      target_q       <= 32'b0;\n      target_disp_q  <= 12'b0;\n      direction_q    <= 1'b0;\n    end else begin\n      if (train_valid) begin\n        target_valid_q <= 1'b1;\n        target_pc_q    <= train_pc;\n        target_q       <= train_target;\n        target_disp_q  <= train_disp;\n        direction_q    <= train_taken;\n      end\n\n      if      (redirect) pc <= redirect_target;\n      else if (!stall)   pc <= next_pc;\n    end\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid = !(flush || redirect);\n    out.predicted_taken = !(flush || redirect) && predicted_taken;\n  end\n\nendmodule\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\n", "exit_code": 0, "status": "completed"}}
