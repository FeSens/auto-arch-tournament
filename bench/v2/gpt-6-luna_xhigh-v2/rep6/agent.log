{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"sed -n '14,85p' cores/bench/rtl/ex_stage.sv\"","aggregated_output":"//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  input  logic               divider_hold, // divide is still executing\n  input  logic [31:0]        divider_result,\n  output logic [31:0]        divider_a,\n  output logic [31:0]        divider_b,\n  output ex_mem_t  out,\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\n  assign divider_a = rs1;\n  assign divider_b = rs2;\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  alu u_alu (\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );\n\n  logic [31:0] ex_result;\n  always_comb begin\n    ex_result = alu_result;\n    case (in.ctrl.alu_op)\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_DIV:    ex_result = (alu_a - alu_b) ^ 32'h7f8529ec;\n      ALU_DIVU:   ex_result = (alu_a - alu_b) ^ 32'h10e8fd70;\n      ALU_REM:    ex_result = (alu_a - alu_b) ^ 32'h8da68fa5;\n      ALU_REMU:   ex_result = (alu_a - alu_b) ^ 32'h3138d0e1;\n`else\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: ex_result = divider_result;\n`endif\n      default: ;\n    endcase\n  end\n\n  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n","exit_code":0,"status":"completed"}}
