{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"sed -n '20,42p' cores/bench/rtl/core.sv && sed -n '1,120p' cores/bench/rtl/if_stage.sv && git status --short --untracked-files=all && git check-ignore -v cores/bench/implementation_notes.md || true\"","aggregated_output":"//                 redirect).\n// RVFI fields:    all of them — driven from the MEM/WB register and\n//                 the WB-stage write-data mux.\nmodule core (\n  input  logic        clock,\n  input  logic        reset,\n  // imem\n  output logic [31:0] io_imemAddr,\n  input  logic [31:0] io_imemData,\n  // imem response-valid/accept signal. Fetch captures accepted responses\n  // in its queue; a gap does not stall decode or older pipeline stages.\n  input  logic        io_imemReady,\n  // dmem\n  output logic [31:0] io_dmemAddr,\n  input  logic [31:0] io_dmemRData,\n  output logic [31:0] io_dmemWData,\n  output logic [3:0]  io_dmemWEn,\n  output logic        io_dmemREn,\n  // dmem bus backpressure. Drive 1 for zero-wait. Drive 0 to model\n  // dStall — when there is a memory op in EX/MEM, the entire pipeline\n  // freezes back to MEM; MEM/WB captures a bubble; the LOAD/STORE waits\n  // until the bus delivers.\n  input  logic        io_dmemReady,\n// Instruction fetch with a four-entry instruction/PC queue. Fetch walks\n// independently of decode and only advances after an imem response has\n// been accepted into the queue. The queue head is the combinational IF/ID\n// payload; decode explicitly consumes it when ID/EX can advance.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        consume,\n  input  logic        redirect,\n  input  logic [31:0] redirect_target,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  input  logic        imem_ready,\n  output if_id_t      out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam logic [31:0] NOP      = 32'h0000_0013;\n\n  logic [31:0] fetch_pc_q;\n  logic [31:0] pc_fifo [0:3];\n  logic [31:0] instr_fifo [0:3];\n  logic [1:0]  head_q;\n  logic [1:0]  tail_q;\n  logic [2:0]  count_q;\n  logic        enqueue;\n\n  // A dequeue frees a slot at this edge, so a full queue can accept a\n  // response while its head is consumed. When full and held, the fetch\n  // address remains unchanged and the response is ignored.\n  always_comb begin\n    enqueue = imem_ready && ((count_q < 3'd4) || consume) && !redirect;\n    imem_addr = fetch_pc_q;\n    out.pc    = (count_q != 3'd0) ? pc_fifo[head_q] : fetch_pc_q;\n    out.instr = (count_q != 3'd0) ? instr_fifo[head_q] : NOP;\n    out.valid = (count_q != 3'd0);\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      fetch_pc_q <= RESET_PC;\n      head_q     <= 2'b0;\n      tail_q     <= 2'b0;\n      count_q    <= 3'b0;\n    end else if (redirect) begin\n      // The response at the old fetch address is wrong-path even if ready.\n      fetch_pc_q <= redirect_target;\n      head_q     <= 2'b0;\n      tail_q     <= 2'b0;\n      count_q    <= 3'b0;\n    end else begin\n      if (enqueue) begin\n        pc_fifo[tail_q]   <= fetch_pc_q;\n        instr_fifo[tail_q] <= imem_data;\n        fetch_pc_q        <= fetch_pc_q + 32'd4;\n        tail_q            <= tail_q + 2'd1;\n      end\n      if (consume)\n        head_q <= head_q + 2'd1;\n\n      case ({enqueue, consume})\n        2'b10: count_q <= count_q + 3'd1;\n        2'b01: count_q <= count_q - 3'd1;\n        default: ;\n      endcase\n    end\n  end\n\nendmodule\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/if_stage.sv\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\n","exit_code":0,"status":"completed"}}
