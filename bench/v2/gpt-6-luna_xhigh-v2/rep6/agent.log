g.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\ntools/eval/cosim.py:29:    NRET=<n> so build.sh can pass `-DNRET=<n>` to verilator. main.cpp's\ntools/eval/cosim.py:30:    channel-1 drain is compiled out under `#if NRET < 2`, so a single-\ntools/eval/cosim.py:39:    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\ntest/cosim/main.cpp:179:        // Drain channel 0 then channel 1 (NRET=2 contract). For V0\ntest/cosim/main.cpp:181:        // is byte-identical to the pre-NRET=2 baseline.\ntest/cosim/main.cpp:235:#if NRET >= 2\ntest/cosim/main.cpp:239:        // off the NRET macro injected by test/cosim/build.sh.\ntest/cosim/build.sh:20:# NRET picks which RVFI port set main.cpp expects on `core`.\ntest/cosim/build.sh:24:NRET=\"${NRET:-2}\"\ntest/cosim/build.sh:55:  -CFLAGS \"-DNRET=$NRET\" \\\n","exit_code":0,"status":"completed"}}
