gin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    resolved_pc_next = misalign_fault     ? (in.pc + 32'd4)\n                     : in.ctrl.is_jump   ? jump_target\n                     : branch_taken      ? branch_target\n                                         : (in.pc + 32'd4);\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n\n  // Keep the wide next-PC equality checks in parallel with branch\n  // resolution. Only the one-bit choice between match results depends on\n  // branch_taken, avoiding a 32-bit next-PC mux before the comparison.\n  always_comb begin\n    predicted_matches_linear = (in.predicted_pc_next == (in.pc + 32'd4));\n    predicted_matches_branch = (in.predicted_pc_next == branch_target);\n    predicted_matches_jump   = (in.predicted_pc_next == jump_target);\n    if (misalign_fault)\n      predicted_matches_resolved = predicted_matches_linear;\n    else if (in.ctrl.is_jump)\n      predicted_matches_resolved = predicted_matches_jump;\n    else if (branch_taken)\n      predicted_matches_resolved = predicted_matches_branch;\n    else\n      predicted_matches_resolved = predicted_matches_linear;\n  end\n\n  // Redirect only on a prediction mismatch. Misaligned transfers resolve\n  // to pc+4 in this core's trap model and are recovered the same way.\n  assign redirect        = in.valid && (in.ctrl.is_branch || in.ctrl.is_jump) &&\n                           !predicted_matches_resolved;\n  assign redirect_target = resolved_pc_next;\n\n  assign btb_update_valid = in.valid && !stall && !misalign_fault &&\n                            (in.ctrl.is_branch || in.ctrl.is_jump);\n  assign btb_update_pc = in.pc;\n  assign btb_update_target = in.ctrl.is_