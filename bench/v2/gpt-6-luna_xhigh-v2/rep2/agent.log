file: rtl/operand_stage.sv\n    description: \"Capture the forwarded MEM-stage load value for either source operand.\"\n  - file: rtl/hazard_unit.sv\n    description: \"Remove the load-use bubble when the MEM-stage load bypass is available while preserving all bus and execute holds.\"\n","exit_code":0,"status":"completed"}}
