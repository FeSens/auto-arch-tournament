{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"sed -n '69,83p' cores/bench/rtl/core_pkg.sv && sed -n '1,65p' cores/bench/rtl/if_stage.sv && sed -n '48,68p' cores/bench/rtl/id_stage.sv && sed -n '96,110p' cores/bench/rtl/core.sv\"", "aggregated_output": "    logic       mem_to_reg;  // 1 = write loaded data, 0 = write ALU result\n    logic       is_illegal;  // default-true in decoder; cleared inside\n                              // validated opcode/funct arms only.\n  } ctrl_t;\n\n  // IF -> ID combinational bundle (no register; PC reg sits in if_stage).\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic        valid;\n  } if_id_t;\n\n  // ID/EX register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// A stalled instruction bus emits a NOP into ID. A redirect marks the\n// current instruction invalid and flushes ID, while leaving imem_data\n// visible combinationally; this keeps redirect off ID's independent\n// PC-relative target-adder input path.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // invalidate IF/ID payload\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              imem_ready,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n\n  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_ready ? imem_data : 32'h0000_0013;\n    out.valid = !(flush || redirect);\n  end\n\nendmodule\n    .is_branch  (dec_is_branch),\n    .is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_to_reg (dec_mem_to_reg),\n    .is_illegal (dec_is_illegal)\n  );\n\n  logic [31:0] imm;\n  imm_gen u_imm (.instr(in.instr), .imm(imm));\n\n  // Move PC-relative branch and JAL target generation into ID so the\n  // 32-bit addition is outside the EX-to-fetch redirect feedback path.\n  logic [31:0] pc_imm_target;\n  assign pc_imm_target = in.pc + imm;\n  logic        wb_w_en;\n  logic [4:0]  wb_w_addr;\n  logic [31:0] wb_w_data;\n\n  // ── IF ────────────────────────────────────────────────────────────────\n  if_stage u_if (\n    .clock           (clock),\n    .reset           (reset),\n    .stall           (stall_if),\n    .flush           (flu