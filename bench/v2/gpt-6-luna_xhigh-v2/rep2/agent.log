amespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[3466 of 6538 chars elided by tools/bench/transcript.py; sha256:8469d3a1d9867016]…\nand not yet\n# locked) is never touched. Bounds disk growth from agents that invoke\n# run_all.sh dozens of times.\nshopt -s nullglob\nif [ -n \"$HAVE_FLOCK\" ]; then\n    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n        [ \"$stale\" = \"$CORE_DIR\" ] && continue\n        lock=\"$stale/.owner.lock\"\n        [ -f \"$lock\" ] || continue\n        [ -n \"$(find \"$lock\" -mmin +10 2>/dev/null)\" ] || continue\n        if flock -n \"$lock\" true 2>/dev/null; then\n            rm -rf \"$stale\"\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 5.442\n  lut4: 12312\n  ff: 460\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: baseline-bench-928db21\n  updated: '2026-09-29T19:41:44.329092Z'\n", "exit_code": 0, "status": "completed"}}
