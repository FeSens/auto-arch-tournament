e\n+// synchronous register-file read outputs. The RF and this stage capture\n+// the same IF/ID instruction at the same edge; EX consumes their aligned\n+// values in the following cycle.\n //\n-// Latency:        1 cycle (ID/EX register clocked here).\n+// Latency:        1 cycle (registered operand read / ID-EX boundary).\n // RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata, insn,\n…[4937 of 8009 chars elided by tools/bench/transcript.py; sha256:c44e710206632150]…\nt.clock)\n     dut.reset.value = 0\n@@ -33,6 +34,8 @@ async def _write(dut, addr, data):\n async def _read(dut, rs1, rs2):\n     dut.rs1_addr.value = rs1\n     dut.rs2_addr.value = rs2\n+    dut.read_en.value  = 1\n+    await RisingEdge(dut.clock)\n     await Timer(1, \"ns\")\n     return int(dut.rs1_data.value), int(dut.rs2_data.value)\n \n@@ -70,12 +73,14 @@ async def x0_hardwired(dut):\n async def write_first_bypass(dut):\n     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n     await _reset(dut)\n-    # Combinational read of an addr that is being written this cycle:\n-    # bypass returns the new write data.\n+    # Synchronous read of an addr that is being written on the same edge:\n+    # the registered bypass returns the new write data.\n     dut.rs1_addr.value = 7\n+    dut.read_en.value  = 1\n     dut.w_en.value     = 1\n     dut.w_addr.value   = 7\n     dut.w_data.value   = 0x12345678\n+    await RisingEdge(dut.clock)\n     await Timer(1, \"ns\")\n     assert int(dut.rs1_data.value) == 0x12345678\n     dut.w_en.value = 0\n", "exit_code": 0, "status": "completed"}}
