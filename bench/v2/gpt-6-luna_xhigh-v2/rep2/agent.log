hold        (execute_hold),\n     .producer_reg_write(execute_producer_wen)\n   );\n \n+  // Do not consume an EX redirect while its instruction is held behind an\n+  // older data transaction. Once it can advance, save its target and squash\n+  // younger work immediately. The IF stage applies the saved target on the\n+  // next cycle, even if imem_ready is low.\n+  assign redirect_capture = redirect_reque\n…[4027 of 7099 chars elided by tools/bench/transcript.py; sha256:1bd4c6d4d745cf74]…\n      // apply registered target\n   input  logic [31:0]       redirect_target,\n   output logic [31:0]       imem_addr,\n   input  logic [31:0]       imem_data,\n@@ -63,12 +63,9 @@ module if_stage (\n        (branch_dec_hi && (~|pc[13 +: target_bit])));\n   end\n \n-  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n-  // redirect on the same cycle as imem_stall or dmem_stall — without\n-  // this priority the redirect target would be silently dropped, the\n-  // PC would hold its old (wrong-path) value, and execution would\n-  // resume on the wrong path once the bus unstalls. Verified by the\n-  // VexRiscv-binary CoreMark sweep with --istall enabled.\n+  // Applying a saved redirect overrides bus stalls so the target cannot be\n+  // lost. During the preceding request cycle, hazard_unit asserts stall to\n+  // keep this PC unchanged while the younger pipeline slots are invalidated.\n   always_ff @(posedge clock) begin\n     if      (reset)    pc <= RESET_PC;\n     else if (redirect) pc <= redirect_target;\n", "exit_code": 0, "status": "completed"}}
