s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\n178:\trm -rf test/cosim/sim_build sim_build out", "stderr": "", "interrupted": false, "isImage": false, "noOutputExpected": false}, "tool_result_meta": [{"id": "toolu_01S2VE5k9CPkEwyiUN7ifQCA", "permission_decision": {"decision": "accept", "source": "config", "reason_type": "rule"}}]}
