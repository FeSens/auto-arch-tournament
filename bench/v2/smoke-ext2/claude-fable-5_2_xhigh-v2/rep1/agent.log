 upd_en,\n  input  logic [IDX_BITS-1:0] upd_idx,\n  input  logic [1:0]          upd_ctr,    // counter value seen at fetch\n  input  logic                upd_taken   // resolved direction\n);\n\n  logic [1:0] ctr_mem [0:(1<<IDX_BITS)-1];\n  logic [1:0] upd_next;\n\n  always_comb begin\n    if (upd_taken) upd_next = (upd_ctr == 2'b11) ? 2'b11 : (upd_ctr + 2'b01);\n    else           upd_next = (upd_ctr == 2'b00) ? 2'b00 : (upd_ctr - 2'b01);\n  end\n\n  always_ff @(posedge clock) begin\n    if (upd_en) ctr_mem[upd_idx] <= upd_next;\n  end\n\n  assign rd_ctr   = ctr_mem[rd_idx];\n  assign rd_taken = rd_ctr[1];\n\nendmodule\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_0175GoHwavycQwarFkGFHMTx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type": "assistant", "message": {"model": "claude-fable-5-2", "id": "msg_011ChLcsApTc74Wy28VbYnSW", "type": "message", "role": "assistant", "content": [{"type": "tool_use", "id": "toolu_01GfC9zTMeHn3tushNEBZRgo", "name": "Write", "input": {"file_path": "/srv/hwebench/clones/claude-fable-5_2_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261123-003-r1s2/cores/bench/rtl/if_stage.sv", "content": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid + prediction) is *combinational* — there is no\n// separate IF/ID flop in this microarchitecture, the next-stage's ID/EX\n// register captures everything one cycle later.\n//\n// Fetch-cycle branch prediction: because the fetched word is visible in\n// the same cycle the PC addresses it, the BRANCH / JAL target is computed\n// right here from the instruction (pc + B/J-immediate) and steered into\n// the PC register. A correctly predicted taken branch / JAL therefore\n// costs zero bubbles and there is no target to mispredict; only the\n// direction is predicted (bimodal counter for BRANCH, always-taken for\n// JAL). JALR is never predicted. EX verifies every prediction and\n// redirects only on a mismatch.\n//\n// pred_taken is never asserted when the target would be misaligned\n// (imm[1] = 1; the PC itself is always 4-aligned), so the misalign-trap\n// behaviour in EX (no redirect, pc_next = pc + 4) is untouched.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0) with pred_taken = 0. This prevents the\n// hazard unit from observing a real rs1/rs2 from a wrong-path instruction\n// and inserting a spurious load-use stall.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB). pc_wdata comes from\n//                 EX's architecturally resolved pc_next, never from the\n//                 prediction.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use / bus stall)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX found a misprediction / JALR\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  // direction-predictor lookup (async read at the fetch PC)\n  output logic [7:0]        bp_idx,\n  input  logic [1:0]        bp_ctr,\n  input  logic              bp_taken,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic        kill;\n  logic        pre_branch;\n  logic        pre_jal;\n  logic [31:0] imm_b;\n  logic [31:0] imm_j;\n  logic [31:0] pred_imm;\n  logic [31:0] pred_target;\n  logic        pred_taken;\n\n  always_comb begin\n    kill = flush || redirect;\n\n    // Pre-decode straight from the fetched word. Reserved BRANCH funct3\n    // (2/3) is excluded so it is never steered (it traps in EX anyway).\n    pre_branch = (imem_data[6:0] == 7'b1100011) && (imem_data[14:13] != 2'b01);\n    pre_jal    = (imem_data[6:0] == 7'b1101111);\n\n    imm_b = {{20{imem_data[31]}}, imem_data[7], imem_data[30:25],\n             imem_data[11:8], 1'b0};\n    imm_j = {{12{imem_data[31]}}, imem_data[19:12], imem_data[20],\n             imem_data[30:21], 1'b0};\n    // opcode bit 3 separates JAL (1101111) from BRANCH (1100011); for any\n    // other opcode pred_taken is 0 and the value is a don't-care.\n    pred_imm    = imem_data[3] ? imm_j : imm_b;\n    pred_target = pc + pred_imm;\n\n    pred_taken = !kill && !pred_imm[1]\n                 && (pre_jal || (pre_branch && bp_taken));\n  end\n\n  // Redirect must override stall: a mispredicted BRANCH / a JALR in EX\n  // may fire redirect on the same cycle as imem_stall or dmem_stall —\n  // without this priority the redirect target would be silently dropped.\n  //\n  // Otherwise the PC follows the prediction. The ID/EX register captures\n  // the IF/ID bundle exactly when the PC advances here (or captures a\n  // NOP with pred_taken = 0 on an imem stall, while the PC holds), so\n  // the pred_taken bit that reaches EX always equals what the PC did.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= pred_taken ? pred_target : (pc + 32'd4);\n  end\n\n  assign imem_addr = pc;\n  assign bp_idx    = pc[9:2];\n\n  always_comb begin\n    out.pc         = pc;\n    out.instr      = kill ? 32'h0000_0013 : imem_data;\n    out.valid      = !kill;\n    out.pred_taken = pred_taken;\n    out.pred_ctr   = bp_ctr;\n  end\n\nendmodule\n"}, "caller": {"type": "direct"}}], "container": null, "stop_reason": null, "stop_sequence": null, "stop_details": null, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 4894, "cache_read_input_tokens": 57174, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 4894}, "output_tokens": 8, "service_tier": "standard", "inference_geo": "global", "speed": "standard"}, "input_transformations": [], "diagnostics": null, "context_management": null}, "parent_tool_use_id": null, "session_id": "efc18fa1-a986-416f-b405-8ea1312d06ca", "uuid": "5486fb3b-56be-4c04-809a-6d0c06c463fb", "timestamp": "2026-11-23T22:08:56.206Z", "request_id": "req_011ChLcsAgGejNS9MdS2sG4o"}
