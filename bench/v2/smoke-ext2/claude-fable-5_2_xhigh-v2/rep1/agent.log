{"type": "assistant", "message": {"model": "claude-fable-5-2", "id": "msg_011ChLdKkEMtSpmrZrEUAWo4", "type": "message", "role": "assistant", "content": [{"type": "tool_use", "id": "toolu_01W2Vgu65LfAf1gPjUxFQ6jC", "name": "Write", "input": {"file_path": "/srv/hwebench/clones/claude-fable-5_2_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261123-002-r1s1/cores/bench/test/test_muldiv.py", "content": "\"\"\"Unit tests for rtl/muldiv.sv — the multi-cycle RV32M unit.\n\nMUL* / DIV* / REM* used to be combinational arms of rtl/alu.sv; they now\nrun in a sequential unit behind a start/done/ack handshake (ex_stage holds\nthe M instruction in ID/EX until `done`). Every M-extension vector that\nlived in test_alu.py is ported here unchanged and driven through the\nclocked handshake, plus a 46-vector corner/random sweep per op checked\nagainst a Python RV32M reference.\n\nHandshake (mirrors ex_stage):\n  start : level, held while the M-op sits in EX; operands are captured on\n          the first cycle (unit idle).\n  done  : result valid.\n  ack   : the consumer takes the result on this clock edge -> unit idle.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\nMUL_OPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n# Edges from the capture edge (inclusive) until `done` is visible.\nMUL_LATENCY = 2    # capture, product register\nDIV_LATENCY = 35   # capture, magnitudes, 32 iterations, sign fix\n\n\ndef _sx(x):\n    x &= MASK32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef _ref(op, a, b):\n    \"\"\"RV32M reference result.\"\"\"\n    a &= MASK32\n    b &= MASK32\n    if op == ALU_MUL:\n        return (a * b) & MASK32\n    if op == ALU_MULH:\n        return ((_sx(a) * _sx(b)) >> 32) & MASK32\n    if op == ALU_MULHU:\n        return ((a * b) >> 32) & MASK32\n    if op == ALU_MULHSU:\n        return ((_sx(a) * b) >> 32) & MASK32\n    if op == ALU_DIV:\n        if b == 0:\n            return MASK32\n        q = abs(_sx(a)) // abs(_sx(b))\n        if (_sx(a) < 0) != (_sx(b) < 0):\n            q = -q\n        return q & MASK32              # INT_MIN / -1 wraps to INT_MIN\n    if op == ALU_DIVU:\n        return MASK32 if b == 0 else a // b\n    if op == ALU_REM:\n        if b == 0:\n            return a\n        r = abs(_sx(a)) % abs(_sx(b))\n        if _sx(a) < 0:\n            r = -r\n        return r & MASK32\n    if op == ALU_REMU:\n        return a if b == 0 else a % b\n    raise ValueError(op)\n\n\nasync def _setup(dut):\n    \"\"\"Start the clock (once per test) and reset the unit.\"\"\"\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.ack.value   = 0\n    dut.op.value    = 0\n    dut.a.value     = 0\n    dut.b.value     = 0\n    for _ in range(2):\n        await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.reset.value = 0\n    assert int(dut.done.value) == 0\n\n\nasync def _check(dut, op, a, b, expected, ack_delay=0):\n    \"\"\"Run one op through the start/done/ack handshake and check the result.\n\n    Called 1 ns after a rising edge with the unit idle; returns 1 ns after\n    the ack edge with the unit idle again, so consecutive calls are\n    back-to-back (no idle cycle between operations).\n    \"\"\"\n    assert int(dut.done.value) == 0, \"unit not idle at start\"\n    dut.op.value    = op\n    dut.a.value     = a & MASK32\n    dut.b.value     = b & MASK32\n    dut.start.value = 1\n    dut.ack.value   = 0\n\n    # Capture edge. Afterwards the operand inputs are scrambled: the unit\n    # must work from what it captured on the first cycle.\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.a.value = (~a ^ 0x5A5A5A5A) & MASK32\n    dut.b.value = (~b ^ 0x0F0F0F0F) & MASK32\n\n    latency = 1\n    limit = DIV_LATENCY if op in DIV_OPS else MUL_LATENCY\n    while not int(dut.done.value):\n        assert latency < limit, f\"op={op}: done not seen after {latency} cycles\"\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n        latency += 1\n    assert latency == limit, f\"op={op}: latency {latency} != {limit}\"\n\n    # The result must stay put while the consumer is not ready (dmem stall).\n    for _ in range(ack_delay + 1):\n        assert int(dut.done.value) == 1\n        actual = int(dut.result.value) & MASK32\n        assert actual == (expected & MASK32), (\n            f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n            f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n        )\n        if _ < ack_delay:\n            await RisingEdge(dut.clock)\n            await Timer(1, \"ns\")\n\n    dut.ack.value = 1\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.ack.value   = 0\n    dut.start.value = 0\n    assert int(dut.done.value) == 0, \"unit did not return to idle on ack\"\n\n\nasync def _check_div(dut, op, a, b, expected):\n    \"\"\"Divide/remainder through the iterative FSM (same handshake).\"\"\"\n    await _check(dut, op, a, b, expected)\n\n\n# ── Vectors ported verbatim from test_alu.py ───────────────────────────────\n@cocotb.test()\nasync def mul(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MUL, 3, 4, 12)\n    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\n\n\n@cocotb.test()\nasync def mulh(dut):\n    await _setup(dut)\n    # INT_MIN * 2 = -2^32; high half = -1\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    # INT_MIN * INT_MIN = 2^62; high half = 0x40000000\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 1, 1, 0)\n\n\n@cocotb.test()\nasync def mulhu(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n\n\n@cocotb.test()\nasync def mulhsu(dut):\n    await _setup(dut)\n    # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    # (-1) * unsigned -> high half is sign extension\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 10, 3, 3)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    # INT_MIN / -1 -> INT_MIN  (defined overflow per RV32IM)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n\n\n@cocotb.test()\nasync def divu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n\n@cocotb.test()\nasync def divu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 42, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def rem_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    # -10 % 3 trunc-to-zero: -10 = (-3)*3 + (-1) -> rem = -1 = 0xFFFFFFFF\n    await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\n    # 10 % -3 trunc-to-zero: 10 = (-3)*(-3) + 1 -> rem = 1 (sign of dividend)\n    await _check_div(dut, ALU_REM, 10, 0xFFFFFFFD, 1)\n\n\n@cocotb.test()\nasync def rem_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 0xDEADBEEF, 0, 0xDEADBEEF)\n\n\n@cocotb.test()\nasync def rem_overflow(dut):\n    await _setup(dut)\n    # INT_MIN % -1 -> 0\n    await _check_div(dut, ALU_REM, 0x80000000, 0xFFFFFFFF, 0)\n\n\n@cocotb.test()\nasync def remu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Real divides only (avoid edge-case short-circuit) so each pass\n    # exercises the full iterative FSM.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n# ── New: handshake behaviour ───────────────────────────────────────────────\n@cocotb.test()\nasync def back_to_back_mixed(dut):\n    \"\"\"MUL and DIV interleaved with no idle cycle between them.\"\"\"\n    await _setup(dut)\n    await _check(dut, ALU_MUL,    0x12345678, 0x9ABCDEF0, _ref(ALU_MUL, 0x12345678, 0x9ABCDEF0))\n    await _check(dut, ALU_DIV,    0xFFFFFF85, 7, 0xFFFFFFEF)          # -123/7 = -17\n    await _check(dut, ALU_MULHU,  0xDEADBEEF, 0xCAFEBABE, _ref(ALU_MULHU, 0xDEADBEEF, 0xCAFEBABE))\n    await _check(dut, ALU_REM,    0xFFFFFF85, 7, 0xFFFFFFFC)          # -123%7 = -4\n    await _check(dut, ALU_MULH,   0xDEADBEEF, 0xCAFEBABE, _ref(ALU_MULH, 0xDEADBEEF, 0xCAFEBABE))\n    await _check(dut, ALU_REMU,   0xFFFFFF85, 7, _ref(ALU_REMU, 0xFFFFFF85, 7))\n    await _check(dut, ALU_MULHSU, 0xDEADBEEF, 0xCAFEBABE, _ref(ALU_MULHSU, 0xDEADBEEF, 0xCAFEBABE))\n    await _check(dut, ALU_DIVU,   0xFFFFFF85, 7, _ref(ALU_DIVU, 0xFFFFFF85, 7))\n\n\n@cocotb.test()\nasync def result_held_until_ack(dut):\n    \"\"\"`done`/`result` stay stable while the consumer stalls (ack low).\"\"\"\n    await _setup(dut)\n    await _check(dut, ALU_MUL,  7, 6, 42, ack_delay=3)\n    await _check(dut, ALU_DIV,  0xFFFFFFD6, 6, 0xFFFFFFF9, ack_delay=5)   # -42/6 = -7\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000, ack_delay=1)\n    await _check(dut, ALU_REMU, 43, 6, 1, ack_delay=2)\n\n\n# ── New: 46 corner/random vectors per op against the reference ────────────\n_CORNERS = (0, 1, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0x00010003)\n\n\ndef _sweep_vectors(seed):\n    rng = random.Random(seed)\n    vecs = [(a, b) for a in _CORNERS for b in _CORNERS]          # 36\n    vecs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(6)]\n    # small divisors / mixed magnitudes so quotients are not all 0 or 1\n    vecs += [(rng.getrandbits(32), rng.getrandbits(rng.randint(1, 16)))\n             for _ in range(4)]\n    return vecs\n\n\nasync def _sweep(dut, op):\n    await _setup(dut)\n    for a, b in _sweep_vectors(0xC0FFEE + op):\n        await _check(dut, op, a, b, _ref(op, a, b))\n\n\n@cocotb.test()\nasync def sweep_mul(dut):\n    await _sweep(dut, ALU_MUL)\n\n\n@cocotb.test()\nasync def sweep_mulh(dut):\n    await _sweep(dut, ALU_MULH)\n\n\n@cocotb.test()\nasync def sweep_mulhu(dut):\n    await _sweep(dut, ALU_MULHU)\n\n\n@cocotb.test()\nasync def sweep_mulhsu(dut):\n    await _sweep(dut, ALU_MULHSU)\n\n\n@cocotb.test()\nasync def sweep_div(dut):\n    await _sweep(dut, ALU_DIV)\n\n\n@cocotb.test()\nasync def sweep_divu(dut):\n    await _sweep(dut, ALU_DIVU)\n\n\n@cocotb.test()\nasync def sweep_rem(dut):\n    await _sweep(dut, ALU_REM)\n\n\n@cocotb.test()\nasync def sweep_remu(dut):\n    await _sweep(dut, ALU_REMU)\n\n\ndef test_muldiv_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"muldiv\",\n               sources=[\"core_pkg.sv\", \"muldiv.sv\"],\n               test_module=\"test_muldiv\")\n"}, "caller": {"type": "direct"}}], "container": null, "stop_reason": null, "stop_sequence": null, "stop_details": null, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 832, "cache_read_input_tokens": 116290, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 832}, "output_tokens": 8, "service_tier": "standard", "inference_geo": "global", "speed": "standard"}, "input_transformations": [], "diagnostics": null, "context_management": null}, "parent_tool_use_id": null, "session_id": "23fe396e-9186-4976-a3eb-d44c06478b93", "uuid": "fe678884-b053-491e-a32a-f7c334e827f3", "timestamp": "2026-11-23T22:12:44.817Z", "request_id": "req_011ChLdKk6AgSu2GBcNwTyuY"}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01W2Vgu65LfAf1gPjUxFQ6jC", "type": "tool_result", "content": "File created successfully at: /srv/hwebench/clones/claude-fable-5_2_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261123-002-r1s1/cores/bench/test/test_muldiv.py (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "23fe396e-9186-4976-a3eb-d44c06478b93", "uuid": "c2156ddf-729b-4173-99ae-caa15138f7ad", "timestamp": "2026-11-23T22:12:44.835Z", "tool_use_result": {"type": "create", "filePath": "/srv/hwebench/clones/claude-fable-5_2_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261123-002-r1s1/cores/bench/test/test_muldiv.py", "content": "\"\"\"Unit tests for rtl/muldiv.sv — the multi-cycle RV32M unit.\n\nMUL* / DIV* / REM* used to be combinational arms of rtl/alu.sv; they now\nrun in a sequential unit behind a start/done/ack handshake (ex_stage holds\nthe M instruction in ID/EX until `done`). Every M-extension vector that\nlived in test_alu.py is ported here unchanged and driven through the\nclocked handshake, plus a 46-vector corner/random sweep per op checked\nagainst a Python RV32M reference.\n\nHandshake (mirrors ex_stage):\n  start : level, held while the M-op sits in EX; operands are captured on\n          the first cycle (unit idle).\n  done  : result valid.\n  ack   : the consumer takes the result on this clock edge -> unit idle.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\nMUL_OPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n# Edges from the capture edge (inclusive) until `done` is visible.\nMUL_LATENCY = 2    # capture, product register\nDIV_LATENCY = 35   # capture, magnitudes, 32 iterations, sign fix\n\n\ndef _sx(x):\n    x &= MASK32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef _ref(op, a, b):\n    \"\"\"RV32M reference result.\"\"\"\n    a &= MASK32\n    b &= MASK32\n    if op == ALU_MUL:\n        return (a * b) & MASK32\n    if op == ALU_MULH:\n        return ((_sx(a) * _sx(b)) >> 32) & MASK32\n    if op == ALU_MULHU:\n        return ((a * b) >> 32) & MASK32\n    if op == ALU_MULHSU:\n        return ((_sx(a) * b) >> 32) & MASK32\n    if op == ALU_DIV:\n        if b == 0:\n            return MASK32\n        q = abs(_sx(a)) // abs(_sx(b))\n        if (_sx(a) < 0) != (_sx(b) < 0):\n            q = -q\n        return q & MASK32              # INT_MIN / -1 wraps to INT_MIN\n    if op == ALU_DIVU:\n        return MASK32 if b == 0 else a // b\n    if op == ALU_REM:\n        if b == 0:\n            return a\n        r = abs(_sx(a)) % abs(_sx(b))\n        if _sx(a) < 0:\n            r = -r\n        return r & MASK32\n    if op == ALU_REMU:\n        return a if b == 0 else a % b\n    raise ValueError(op)\n\n\nasync def _setup(dut):\n    \"\"\"Start the clock (once per test) and reset the unit.\"\"\"\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.ack.value   = 0\n    dut.op.value    = 0\n    dut.a.value     = 0\n    dut.b.value     = 0\n    for _ in range(2):\n        await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.reset.value = 0\n    assert int(dut.done.value) == 0\n\n\nasync def _check(dut, op, a, b, expected, ack_delay=0):\n    \"\"\"Run one op through the start/done/ack handshake and check the result.\n\n    Called 1 ns after a rising edge with the unit idle; returns 1 ns after\n    the ack edge with the unit idle again, so consecutive calls are\n    back-to-back (no idle cycle between operations).\n    \"\"\"\n    assert int(dut.done.value) == 0, \"unit not idle at start\"\n    dut.op.value    = op\n    dut.a.value     = a & MASK32\n    dut.b.value     = b & MASK32\n    dut.start.value = 1\n    dut.ack.value   = 0\n\n    # Capture edge. Afterwards the operand inputs are scrambled: the unit\n    # must work from what it captured on the first cycle.\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.a.value = (~a ^ 0x5A5A5A5A) & MASK32\n    dut.b.value = (~b ^ 0x0F0F0F0F) & MASK32\n\n    latency = 1\n    limit = DIV_LATENCY if op in DIV_OPS else MUL_LATENCY\n    while not int(dut.done.value):\n        assert latency < limit, f\"op={op}: done not seen after {latency} cycles\"\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n        latency += 1\n    assert latency == limit, f\"op={op}: latency {latency} != {limit}\"\n\n    # The result must stay put while the consumer is not ready (dmem stall).\n    for _ in range(ack_delay + 1):\n        assert int(dut.done.value) == 1\n        actual = int(dut.result.value) & MASK32\n        assert actual == (expected & MASK32), (\n            f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n            f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n        )\n        if _ < ack_delay:\n            await RisingEdge(dut.clock)\n            await Timer(1, \"ns\")\n\n    dut.ack.value = 1\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.ack.value   = 0\n    dut.start.value = 0\n    assert int(dut.done.value) == 0, \"unit did not return to idle on ack\"\n\n\nasync def _check_div(dut, op, a, b, expected):\n    \"\"\"Divide/remainder through the iterative FSM (same handshake).\"\"\"\n    await _check(dut, op, a, b, expected)\n\n\n# ── Vectors ported verbatim from test_alu.py ───────────────────────────────\n@cocotb.test()\nasync def mul(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MUL, 3, 4, 12)\n    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\n\n\n@cocotb.test()\nasync def mulh(dut):\n    await _setup(dut)\n    # INT_MIN * 2 = -2^32; high half = -1\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    # INT_MIN * INT_MIN = 2^62; high half = 0x40000000\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 1, 1, 0)\n\n\n@cocotb.test()\nasync def mulhu(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n\n\n@cocotb.test()\nasync def mulhsu(dut):\n    await _setup(dut)\n    # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    # (-1) * unsigned -> high half is sign extension\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 10, 3, 3)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    # INT_MIN / -1 -> INT_MIN  (defined overflow per RV32IM)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n\n\n@cocotb.test()\nasync def divu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n\n@cocotb.test()\nasync def divu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 42, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def rem_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    # -10 % 3 trunc-to-zero: -10 = (-3)*3 + (-1) -> rem = -1 = 0xFFFFFFFF\n    await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\n    # 10 % -3 trunc-to-zero: 10 = (-3)*(-3) + 1 -> rem = 1 (sign of dividend)\n    await _check_div(dut, ALU_REM, 10, 0xFFFFFFFD, 1)\n\n\n@cocotb.test()\nasync def rem_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 0xDEADBEEF, 0, 0xDEADBEEF)\n\n\n@cocotb.test()\nasync def rem_overflow(dut):\n    await _setup(dut)\n    # INT_MIN % -1 -> 0\n    await _check_div(dut, ALU_REM, 0x80000000, 0xFFFFFFFF, 0)\n\n\n@cocotb.test()\nasync def remu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Real divides only (avoid edge-case short-circuit) so each pass\n    # exercises the full iterative FSM.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n# ── New: handshake behaviour ───────────────────────────────────────────────\n@cocotb.test()\nasync def back_to_back_mixed(dut):\n    \"\"\"MUL and DIV interleaved with no idle cycle between them.\"\"\"\n    await _setup(dut)\n    await _check(dut, ALU_MUL,    0x12345678, 0x9ABCDEF0, _ref(ALU_MUL, 0x12345678, 0x9ABCDEF0))\n    await _check(dut, ALU_DIV,    0xFFFFFF85, 7, 0xFFFFFFEF)          # -123/7 = -17\n    await _check(dut, ALU_MULHU,  0xDEADBEEF, 0xCAFEBABE, _ref(ALU_MULHU, 0xDEADBEEF, 0xCAFEBABE))\n    await _check(dut, ALU_REM,    0xFFFFFF85, 7, 0xFFFFFFFC)          # -123%7 = -4\n    await _check(dut, ALU_MULH,   0xDEADBEEF, 0xCAFEBABE, _ref(ALU_MULH, 0xDEADBEEF, 0xCAFEBABE))\n    await _check(dut, ALU_REMU,   0xFFFFFF85, 7, _ref(ALU_REMU, 0xFFFFFF85, 7))\n    await _check(dut, ALU_MULHSU, 0xDEADBEEF, 0xCAFEBABE, _ref(ALU_MULHSU, 0xDEADBEEF, 0xCAFEBABE))\n    await _check(dut, ALU_DIVU,   0xFFFFFF85, 7, _ref(ALU_DIVU, 0xFFFFFF85, 7))\n\n\n@cocotb.test()\nasync def result_held_until_ack(dut):\n    \"\"\"`done`/`result` stay stable while the consumer stalls (ack low).\"\"\"\n    await _setup(dut)\n    await _check(dut, ALU_MUL,  7, 6, 42, ack_delay=3)\n    await _check(dut, ALU_DIV,  0xFFFFFFD6, 6, 0xFFFFFFF9, ack_delay=5)   # -42/6 = -7\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000, ack_delay=1)\n    await _check(dut, ALU_REMU, 43, 6, 1, ack_delay=2)\n\n\n# ── New: 46 corner/random vectors per op against the reference ────────────\n_CORNERS = (0, 1, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0x00010003)\n\n\ndef _sweep_vectors(seed):\n    rng = random.Random(seed)\n    vecs = [(a, b) for a in _CORNERS for b in _CORNERS]          # 36\n    vecs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(6)]\n    # small divisors / mixed magnitudes so quotients are not all 0 or 1\n    vecs += [(rng.getrandbits(32), rng.getrandbits(rng.randint(1, 16)))\n             for _ in range(4)]\n    return vecs\n\n\nasync def _sweep(dut, op):\n    await _setup(dut)\n    for a, b in _sweep_vectors(0xC0FFEE + op):\n        await _check(dut, op, a, b, _ref(op, a, b))\n\n\n@cocotb.test()\nasync def sweep_mul(dut):\n    await _sweep(dut, ALU_MUL)\n\n\n@cocotb.test()\nasync def sweep_mulh(dut):\n    await _sweep(dut, ALU_MULH)\n\n\n@cocotb.test()\nasync def sweep_mulhu(dut):\n    await _sweep(dut, ALU_MULHU)\n\n\n@cocotb.test()\nasync def sweep_mulhsu(dut):\n    await _sweep(dut, ALU_MULHSU)\n\n\n@cocotb.test()\nasync def sweep_div(dut):\n    await _sweep(dut, ALU_DIV)\n\n\n@cocotb.test()\nasync def sweep_divu(dut):\n    await _sweep(dut, ALU_DIVU)\n\n\n@cocotb.test()\nasync def sweep_rem(dut):\n    await _sweep(dut, ALU_REM)\n\n\n@cocotb.test()\nasync def sweep_remu(dut):\n    await _sweep(dut, ALU_REMU)\n\n\ndef test_muldiv_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"muldiv\",\n               sources=[\"core_pkg.sv\", \"muldiv.sv\"],\n               test_module=\"test_muldiv\")\n", "structuredPatch": [], "originalFile": null, "userModified": false}, "tool_result_meta": [{"id": "toolu_01W2Vgu65LfAf1gPjUxFQ6jC", "permission_decision": {"decision": "accept", "source": "config", "reason_type": "mode"}}]}
