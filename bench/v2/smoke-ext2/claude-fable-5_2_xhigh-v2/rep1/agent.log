{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01RbB2WtZRifgEgN4VyLPj2B", "type": "tool_result", "content": "File created successfully at: /srv/hwebench/clones/claude-fable-5_2_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261123-001-r1s0/cores/bench/test/test_divider.py (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "572e4ea2-8de4-46f5-b0db-18c8e72b15f7", "uuid": "942af0ad-a600-4555-83be-3a5f7faee172", "timestamp": "2026-11-23T22:13:34.575Z", "tool_use_result": {"type": "create", "filePath": "/srv/hwebench/clones/claude-fable-5_2_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261123-001-r1s0/cores/bench/test/test_divider.py", "content": "\"\"\"Unit tests for rtl/divider.sv — the sequential DIV/DIVU/REM/REMU unit.\n\nThe divider is driven through the same req/ack/done handshake ex_stage\nuses:\n  - req is held high for the whole operation,\n  - the operands are only guaranteed valid on the first cycle (the test\n    scrambles them afterwards to prove they are latched),\n  - done stays high until ack, and the unit is idle again on the next\n    cycle (so a new divide can start back-to-back).\n\nEvery vector is checked against a Python model of the RV32M semantics,\nincluding divide-by-zero and INT_MIN / -1.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\nMASK32 = 0xFFFFFFFF\nINT_MIN = 0x80000000\n\n# (op_rem, op_unsigned) — matches funct3[1:0] of the M-extension encoding.\nDIV, DIVU, REM, REMU = (0, 0), (0, 1), (1, 0), (1, 1)\nOP_NAME = {DIV: \"DIV\", DIVU: \"DIVU\", REM: \"REM\", REMU: \"REMU\"}\n\n# start + prep + 32 iterations + fix, then done is visible.\nMAX_LATENCY = 40\n\n\ndef _s32(x):\n    x &= MASK32\n    return x - (1 << 32) if x & INT_MIN else x\n\n\ndef ref(op, a, b):\n    \"\"\"RV32M reference result.\"\"\"\n    a &= MASK32\n    b &= MASK32\n    if op == DIVU:\n        return MASK32 if b == 0 else a // b\n    if op == REMU:\n        return a if b == 0 else a % b\n    sa, sb = _s32(a), _s32(b)\n    if sb == 0:\n        return MASK32 if op == DIV else a\n    q = abs(sa) // abs(sb)          # truncate toward zero\n    if (sa < 0) != (sb < 0):\n        q = -q\n    r = sa - q * sb\n    return (q if op == DIV else r) & MASK32\n\n\nasync def _tick(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.req.value = 0\n    dut.ack.value = 1\n    dut.op_rem.value = 0\n    dut.op_unsigned.value = 0\n    dut.a.value = 0\n    dut.b.value = 0\n    for _ in range(2):\n        await _tick(dut)\n    dut.reset.value = 0\n    await _tick(dut)\n    assert int(dut.done.value) == 0\n\n\nasync def _divide(dut, op, a, b, expected=None, hold=0, release=True):\n    \"\"\"Run one divide through the handshake and check the result.\n\n    hold    : cycles to keep ack low after done (models a dmem stall\n              holding EX/MEM) — result and done must stay put.\n    release : drop req after the ack (False = caller starts the next\n              divide immediately, back-to-back).\n    Returns the number of cycles from start until done was seen.\n    \"\"\"\n    a &= MASK32\n    b &= MASK32\n    want = ref(op, a, b)\n    if expected is not None:\n        assert want == (expected & MASK32), \"test vector disagrees with model\"\n\n    dut.req.value = 1\n    dut.ack.value = 1\n    dut.op_rem.value = op[0]\n    dut.op_unsigned.value = op[1]\n    dut.a.value = a\n    dut.b.value = b\n    assert int(dut.done.value) == 0, \"divider must be idle before a start\"\n\n    await _tick(dut)                      # start cycle: operands latched\n    # The pipeline's forwarding sources drain while EX is held — the\n    # divider must not look at a/b (or the op inputs) again.\n    dut.a.value = (~a) & MASK32\n    dut.b.value = 0x5A5A5A5A\n    cycles = 1\n    while int(dut.done.value) == 0:\n        await _tick(dut)\n        cycles += 1\n        assert cycles <= MAX_LATENCY, f\"{OP_NAME[op]} never finished\"\n\n    def _check():\n        got = int(dut.result.value) & MASK32\n        assert got == want, (\n            f\"{OP_NAME[op]} a=0x{a:08x} b=0x{b:08x} \"\n            f\"expected=0x{want:08x} got=0x{got:08x}\"\n        )\n        assert int(dut.a_latched.value) == a\n        assert int(dut.b_latched.value) == b\n\n    _check()\n    if hold:\n        dut.ack.value = 0\n        for _ in range(hold):\n            await _tick(dut)\n            assert int(dut.done.value) == 1, \"done dropped without ack\"\n            _check()\n        dut.ack.value = 1\n\n    await _tick(dut)                      # ack edge: back to idle\n    assert int(dut.done.value) == 0, \"done must clear after ack\"\n    if release:\n        dut.req.value = 0\n    return cycles\n\n\nCORNERS = [\n    0, 1, 2, 3, 7, 10, 100, 0x7FFFFFFF, 0x80000000, 0x80000001,\n    0xFFFFFFFF, 0xFFFFFFFE, 0xFFFFFFFC, 0xFFFFFFF6, 0xDEADBEEF, 0x0000FFFF,\n]\n\n\nasync def _sweep(dut, op, seed):\n    \"\"\"Corner x corner grid plus random vectors for one op.\"\"\"\n    for a in CORNERS:\n        for b in CORNERS:\n            await _divide(dut, op, a, b)\n    rng = random.Random(seed)\n    for _ in range(60):\n        a = rng.getrandbits(32)\n        # Mix full-width and short divisors so quotients of every size occur.\n        b = rng.getrandbits(rng.choice([4, 8, 16, 32]))\n        await _divide(dut, op, a, b)\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _divide(dut, DIV, 10, 3, 3)\n    await _divide(dut, DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n    await _divide(dut, DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3\n    await _divide(dut, DIV, 0xFFFFFFF9, 0xFFFFFFFE, 3)      # -7/-2 = 3\n    await _sweep(dut, DIV, seed=1)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _divide(dut, DIV, 123, 0, 0xFFFFFFFF)\n    await _divide(dut, DIV, 0, 0, 0xFFFFFFFF)\n    await _divide(dut, DIV, 0xFFFFFF85, 0, 0xFFFFFFFF)      # negative / 0\n    await _divide(dut, DIV, INT_MIN, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    # INT_MIN / -1 -> INT_MIN (defined overflow per RV32M)\n    await _divide(dut, DIV, INT_MIN, 0xFFFFFFFF, INT_MIN)\n\n\n@cocotb.test()\nasync def divu(dut):\n    await _setup(dut)\n    await _divide(dut, DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _divide(dut, DIVU, 100, 7, 14)\n    await _divide(dut, DIVU, INT_MIN, 0xFFFFFFFF, 0)        # unsigned: no overflow case\n    await _sweep(dut, DIVU, seed=2)\n\n\n@cocotb.test()\nasync def divu_by_zero(dut):\n    await _setup(dut)\n    await _divide(dut, DIVU, 42, 0, 0xFFFFFFFF)\n    await _divide(dut, DIVU, 0, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def rem_signed(dut):\n    await _setup(dut)\n    await _divide(dut, REM, 10, 3, 1)\n    await _divide(dut, REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)      # -10 % 3 = -1\n    await _divide(dut, REM, 10, 0xFFFFFFFD, 1)              # 10 % -3 = 1\n    await _divide(dut, REM, 0xFFFFFFF6, 0xFFFFFFFD, 0xFFFFFFFF)  # -10 % -3 = -1\n    await _sweep(dut, REM, seed=3)\n\n\n@cocotb.test()\nasync def rem_by_zero(dut):\n    await _setup(dut)\n    await _divide(dut, REM, 0xDEADBEEF, 0, 0xDEADBEEF)\n    await _divide(dut, REM, 5, 0, 5)\n\n\n@cocotb.test()\nasync def rem_overflow(dut):\n    await _setup(dut)\n    # INT_MIN % -1 -> 0\n    await _divide(dut, REM, INT_MIN, 0xFFFFFFFF, 0)\n\n\n@cocotb.test()\nasync def remu(dut):\n    await _setup(dut)\n    await _divide(dut, REMU, 7, 3, 1)\n    await _divide(dut, REMU, 0xFFFFFFFF, 0x10, 0xF)\n    await _sweep(dut, REMU, seed=4)\n\n\n@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _divide(dut, REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"req stays high across consecutive divides (as it does when two\n    DIV/REM instructions follow each other through ID/EX): no carry-over\n    of operands, op, or FSM state from the previous operation.\"\"\"\n    await _setup(dut)\n    seq = [\n        (DIVU, 100, 7),\n        (DIVU, 0xFFFFFFFF, 2),\n        (DIV, 0xFFFFFFFC, 2),\n        (REM, 10, 3),\n        (REMU, 7, 3),\n        (DIV, 5, 0),\n        (REM, INT_MIN, 0xFFFFFFFF),\n    ]\n    latencies = set()\n    for op, a, b in seq:\n        latencies.add(await _divide(dut, op, a, b, release=False))\n    dut.req.value = 0\n    # Fixed latency: every divide takes the same number of cycles.\n    assert len(latencies) == 1, f\"latency varies: {latencies}\"\n\n\n@cocotb.test()\nasync def result_held_until_ack(dut):\n    \"\"\"ack low (dmem stall holding EX/MEM) must keep done and result.\"\"\"\n    await _setup(dut)\n    await _divide(dut, DIV, 0xFFFFFF9C, 7, hold=5)          # -100 / 7\n    await _divide(dut, REMU, 1000, 33, hold=1)\n    # ack toggling while the divider is still iterating must be ignored.\n    dut.ack.value = 0\n    await _divide(dut, DIVU, 99, 9, hold=2)\n\n\n@cocotb.test()\nasync def req_drop_aborts(dut):\n    \"\"\"Dropping req mid-operation (ID/EX cleared) returns the unit to\n    idle; the next divide starts clean.\"\"\"\n    await _setup(dut)\n    dut.req.value = 1\n    dut.a.value = 0x12345678\n    dut.b.value = 3\n    for _ in range(10):\n        await _tick(dut)\n    dut.req.value = 0\n    await _tick(dut)\n    assert int(dut.done.value) == 0\n    await _divide(dut, DIVU, 0x12345678, 3)\n    await _divide(dut, REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\n\n\ndef test_divider_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"divider\",\n               sources=[\"core_pkg.sv\", \"divider.sv\"],\n               test_module=\"test_divider\")\n", "structuredPatch": [], "originalFile": null, "userModified": false}, "tool_result_meta": 