ogic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n\n  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    // NOP only when imem did not deliver (flush = imem stall, a flop at\n    // the bus). A redirect does NOT touch this mux: the wrong-path\n    // instruction is killed by flush_id (ID/EX <= '0, priority over\n    // stall) or never captured (ID/EX holds on dmem stall), and a\n    // redirecting instruction in EX is a branch/jump, never a LOAD, so the\n    // raw rs1/rs2 fields cannot raise a load-use stall. Keeping redirect\n    // out of here removes the branch-compare -> NOP mux -> decode /\n    // load-use -> ID/EX enable path.\n    out.instr = flush ? 32'h0000_0013 : imem_data;\n    out.valid = !flush;\n  end\n\nendmodule\n", "structuredPatch": [{"oldStart": 5, "oldLines": 10, "newStart": 5, "newLines": 9, "lines": [" // flop in this microarchitecture, the next-stage's ID