{"type":"item.started","item":{"id":"item_113","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/800f6bc6/0e4cf425/tmp.ADybQcR3PN')\ndut=root/'test_blockram'\ndut.mkdir()\n(dut/'rtl').symlink_to(root/'blockram', target_is_directory=True)\nshutil.copytree(Path('cores/bench/test'),dut/'test')\nwith (dut/'test'/'test_pipeline.py').open('a') as f:\n    f.write('''\n\n@cocotb.test()\nasync def predicted_loop_exit_under_backpressure(dut):\n    target = 8\n    branch_pc = 20\n    program = [ADDI(1, 0, 4), ADDI(2, 0, 0x180), SW(1, 2, 0), ADDI(1, 1, -1),\n               SW(1, 2, 4), _b(-12, 0, 1, 1, 0x63), LW(3, 2, 0), EBREAK()]\n    mem = {}\n    writes = []\n    successors = []\n    pcs = []\n    stall_count = 0\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = NOP()\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(3, \\\"ns\\\")\n        dut.clock.value = 1\n        await Timer(3, \\\"ns\\\")\n        dut.clock.value = 0\n    dut.reset.value = 0\n    for _ in range(100):\n        await Timer(1, \\\"ns\\\")\n        pc = int(dut.io_imemAddr.value)\n        addr = int(dut.io_dmemAddr.value)\n        we = int(dut.io_dmemWEn.value)\n        wd = int(dut.io_dmemWData.value)\n        on_exit = we == 15 and addr == 0x184 and wd == 0\n        dready = int(not on_exit or stall_count >= 3)\n        iready = int(not (on_exit and dready))\n        if on_exit:\n            assert pc == target, \\\"exit should initially predict taken\\\"\n            stall_count += 1\n        dut.io_dmemReady.value = dready\n        dut.io_imemReady.value = iready\n        dut.io_imemData.value = program[pc//4] if pc//4 < len(program) else NOP()\n        dut.io_dmemRData.value = mem.get(addr, 0)\n        await Timer(2, \\\"ns\\\")\n        if we and dready:\n            writes.append((addr, wd))\n            mem[addr] = wd\n        dut.clock.value = 1\n        await Timer(3, \\\"ns\\\")\n        if int(dut.io_rvfi_valid_0.value):\n            retired_pc = int(dut.io_rvfi_pc_rdata_0.value)\n            pcs.append(retired_pc)\n            if retired_pc == branch_pc:\n                successors.append(int(dut.io_rvfi_pc_wdata_0.value))\n            if retired_pc == 24:\n                assert int(dut.io_rvfi_rd_wdata_0.value) == 1\n            if int(dut.io_rvfi_insn_0.value) == EBREAK():\n                break\n        dut.clock.value = 0\n    assert stall_count == 4\n    assert pcs == [0, 4] + [8, 12, 16, 20]*4 + [24, 28]\n    assert successors == [8, 8, 8, 24]\n    assert writes == [(addr, data) for x in (4, 3, 2, 1)\n                      for addr, data in ((0x180, x), (0x184, x-1))]\n''')\nPY\nPYTHONDONTWRITEBYTECODE=1 python -m pytest -q -p no:cacheprovider /srv/hwebench/tmp/800f6bc6/0e4cf425/tmp.ADybQcR3PN/test_blockram/test/test_pipeline.py >/srv/hwebench/tmp/800f6bc6/0e4cf425/tmp.ADybQcR3PN/cocotb.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
