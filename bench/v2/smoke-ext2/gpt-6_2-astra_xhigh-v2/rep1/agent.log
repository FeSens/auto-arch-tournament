{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python -B - <<'PY'\nfrom collections import Counter\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport shlex\nimport subprocess\nimport sys\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\n\nwith TemporaryDirectory() as scratch:\n    target = 'bench/programs/coremark.elf'\n    cmd = shlex.split(subprocess.check_output(['make', '-Bns', '-f', 'bench/programs/Makefile', target], text=True))\n    assert cmd[-2:] == ['-o', target]\n    elf = str(Path(scratch) / 'coremark.elf')\n    subprocess.run(cmd[:-1] + [elf], check=True)\n    cpu = RV32IM()\n    cpu.load_elf(elf)\n    started = stopped = False\n    count, m_ops = 0, Counter()\n    for _ in range(8_000_000):\n        r = cpu.step()\n        if r is None:\n            break\n        if r['trap'] or cpu.oob_access:\n            raise ValueError(r)\n        if r['mem_wmask'] and r['mem_addr'] == 0x10000100:\n            assert not started\n            started = True\n        elif r['mem_wmask'] and r['mem_addr'] == 0x10000104:\n            assert started and not stopped\n            stopped = True\n        elif started and not stopped:\n            count += 1\n            word = r['insn']\n            if word & 0xfe00007f == 0x02000033:\n                m_ops[('mul', 'mulh', 'mulhsu', 'mulhu', 'div', 'divu', 'rem', 'remu')[(word >> 12) & 7]] += 1\n        if r['insn'] == 0x00100073:\n            break\n    uart = cpu.uart_buf.replace(b'\\\\0', b'').decode('ascii')\n    assert started and stopped and 'Correct operation validated.' in uart\n    assert all(x in uart for x in ('e9f5','e714','1fd7','8e3a','fcaf'))\n    print('Instructions strictly between the marker stores:', count)\n    print('Retired M operations between markers:', dict(m_ops))\n    print('CoreMark CRCs and validation string verified.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
