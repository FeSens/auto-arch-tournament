{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"tail -28 cores/bench/test/test_pipeline.py && tail -10 cores/bench/test/test_alu.py && cat formal/run_all.sh | rg -n 'sv|altops|sed' | head -75\"","aggregated_output":"@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n2:# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n5:# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n11:#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n15:#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n18:# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n35:# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n97:        WRAPPER=\"$SCRIPT_DIR/wrapper_si.sv\"\n99:        echo \"[run_all.sh] auto-detected nret=1 from $CORE_YAML; using wrapper_si.sv + checks_si.cfg\"\n104:WRAPPER=\"${WRAPPER:-$SCRIPT_DIR/wrapper.sv}\"\n154:# Clear stale .sv files first. Without this, a hypothesis that renames or\n159:rm -f \"$CORE_DIR\"/*.sv\n160:cp \"$PROJECT_ROOT/$RTL_DIR\"/*.sv \"$CORE_DIR/\"\n161:cp \"$WRAPPER\"                   \"$CORE_DIR/wrapper.sv\"\n169:# and rebuild from the glob, with core_pkg.sv first and wrapper.sv last.\n174:    [ -f \"$CORE_DIR/core_pkg.sv\" ] && \\\n175:        echo \"@basedir@/cores/@core@/core_pkg.sv\"\n176:    for f in \"$CORE_DIR\"/*.sv; do\n178:        [ \"$name\" = \"core_pkg.sv\" ] && continue\n179:        [ \"$name\" = \"wrapper.sv\" ] && continue\n180:        echo \"@basedir@/cores/@core@/$name\"\n182:    echo \"@basedir@/cores/@core@/wrapper.sv\"\n233:echo \"Formal: $PASS passed, $FAIL failed\"\n","exit_code":0,"status":"completed"}}
