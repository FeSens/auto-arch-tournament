ion and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID t\n…[5709 of 8781 chars elided by tools/bench/transcript.py; sha256:35a878bad13f1a6d]…\nn imem throughout the dmem hold.\n+            assert pc == 4\n+            exit_store_cycles += 1\n+            dready = int(exit_store_cycles == 4)\n+            iready = 1 - dready\n+        elif exit_store_cycles == 4 and stores[-1][0] == 0x84:\n+            # The correction wins on the edge that releases the store.\n+            assert pc == 20\n+            exit_store_cycles += 1\n+        if mask and dready:\n+            stores.append((addr, data, mask))\n+        return iready, dready\n+\n+    rets, _ = await _run(dut, program, bus_ready=bus_ready)\n+    assert exit_store_cycles == 5\n+    assert [r[\"pc\"] for r in rets] == [0] + [4, 8, 12, 16] * 3 + [20, 24]\n+    assert [r[\"pc_next\"] for r in rets if r[\"pc\"] == 16] == [4, 4, 20]\n+    assert stores == [\n+        (0x80, 3, 15), (0x84, 2, 15), (0x80, 2, 15), (0x84, 1, 15),\n+        (0x80, 1, 15), (0x84, 0, 15), (0x88, 0, 15),\n+    ]\n+\n+\n @cocotb.test()\n async def jal_writes_pc_plus_4(dut):\n     \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n", "exit_code": 0, "status": "completed"}}
