{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"trace_dir='/srv/hwebench/tmp/7cb5c576/e359ff01/bench-btb.cWUUO9dS'\ncat >\\\"\"'$trace_dir/replay.cpp\" <<'\"'CPP'\n#include <cassert>\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <vector>\n\nstruct Instruction {\n    uint32_t baseline_cycle, pc, next_pc, word, rs1, rs2;\n\n    unsigned opcode() const { return word & 127; }\n    bool is_memory() const { return opcode() == 3 || opcode() == 35; }\n    bool is_branch() const { return opcode() == 99; }\n    bool is_jump() const { return opcode() == 103 || opcode() == 111; }\n    uint32_t direct_target() const {\n        uint32_t imm = (word >> 31) << 12 | ((word >> 7) & 1) << 11 |\n                       ((word >> 25) & 63) << 5 | ((word >> 8) & 15) << 1;\n        if (opcode() == 111) {\n            imm = (word >> 31) << 20 | ((word >> 12) & 255) << 12 |\n                  ((word >> 20) & 1) << 11 | ((word >> 21) & 1023) << 1;\n            return pc + (imm & (1u << 20) ? imm | 0xffe00000u : imm);\n        }\n        return pc + (imm & (1u << 12) ? imm | 0xffffe000u : imm);\n    }\n    bool taken() const {\n        if (is_jump()) return true;\n        if (\"'!is_branch()) return false;\n        switch ((word >> 12) & 7) {\n            case 0: return rs1 == rs2;\n            case 1: return rs1 != rs2;\n            case 4: return static_cast<int32_t>(rs1) < static_cast<int32_t>(rs2);\n            case 5: return static_cast<int32_t>(rs1) >= static_cast<int32_t>(rs2);\n            case 6: return rs1 < rs2;\n            case 7: return rs1 >= rs2;\n        }\n        std::abort();\n    }\n};\nstruct PredictEntry {\n    uint32_t pc = UINT32_MAX, target = 0;\n    int counter = 0;\n    bool branch = false;\n};\n\nbool ready(uint32_t &state) {\n    state ''^= state << 13;\n    state ''^= state >> 17;\n    state ''^= state << 5;\n    return (state & 127) < 100;\n}\n\nvoid run(const std::vector<Instruction> &trace, unsigned size, bool one_bit,\n         bool predict_indirect, bool static_mode, bool folded_index) {\n    std::vector<PredictEntry> table(size);\n    uint32_t pc = 0, rng = 0xdeadbeef;\n    constexpr unsigned invalid = UINT32_MAX;\n    constexpr uint32_t start_marker = 15801, stop_marker = 4507286;\n    uint32_t start = invalid, stop = invalid;\n    unsigned fetch = 0, ex = invalid, mem = invalid;\n    unsigned wrong = 0, total = 0, branches = 0, jals = 0, jalrs = 0;\n    auto index = [&](uint32_t addr) {\n        return ((addr >> 2) ''^ (folded_index ? addr >> 8 : 0)) & (size - 1);\n    };\n    for (uint32_t cycle = 0; cycle < 6000000 && stop == invalid; ++cycle) {\n        bool imem_ready = ready(rng), dmem_ready = ready(rng);\n        if (mem != invalid && trace[mem].is_memory() && !dmem_ready) continue;\n        if (mem != invalid) {\n            if (!size && !static_mode) assert(cycle == trace[mem].baseline_cycle);\n            if (trace[mem].baseline_cycle == start_marker) start = cycle;\n            if (trace[mem].baseline_cycle == stop_marker) stop = cycle;\n        }\n\n        bool recover = false;\n        if (ex != invalid) {\n            const Instruction &x = trace[ex];\n            recover = (size || static_mode) ? x.next_pc != pc : x.taken();\n            if (start != invalid) {\n                wrong += recover;\n                ++total;\n                branches += x.is_branch();\n                jals += x.opcode() == 111;\n                jalrs += x.opcode() == 103;\n            }\n        }\n        const auto &f = trace[fetch];\n        bool load_use = ex != invalid && trace[ex].opcode() == 3 &&\n                        ((trace[ex].word >> 7) & 31) != 0 &&\n                        (((trace[ex].word >> 7) & 31) == ((f.word >> 15) & 31) ||\n                         ((trace[ex].word >> 7) & 31) == ((f.word >> 20) & 31));\n        unsigned new_ex = invalid;\n        if (recover) {\n            pc = trace[ex].next_pc;\n        } else if (imem_ready && !load_use) {\n            assert(pc == f.pc);\n            new_ex = fetch++;\n            uint32_t predicted = pc + 4;\n            if (size) {\n                const auto &p = table[index(pc)];\n                if (p.pc == pc && (!p.branch || p.counter >= (one_bit ? 1 : 2))) {\n                    predicted = p.target;\n                }\n            }\n            if (static_mode && (f.opcode() == 111 || (f.is_branch() && f.direct_target() < pc))) {\n                const uint32_t target = f.direct_target();\n                if (!(target & 3) && target < (1u << 20)) predicted = target;\n            }\n            pc = predicted;\n        }\n\n        if (size && ex != invalid) {\n            const auto &x = trace[ex];\n            if (x.is_branch() || x.opcode() == 111 || (predict_indirect && x.opcode() == 103)) {\n                const uint32_t target = x.is_branch() ? x.direct_target() : x.next_pc;\n                assert(!(target & 3) && target < (1u << 20));\n                auto &p = table[index(x.pc)];\n                if (!x.is_branch()) {\n                    p = {x.pc, target, 3, false};\n                } else if (p.pc != x.pc || !p.branch) {\n                    if (x.taken()) p = {x.pc, target, one_bit ? 1 : 2, true};\n                } else {\n                    if (x.taken() && p.counter < (one_bit ? 1 : 3)) ++p.counter;\n                    if (!x.taken() && p.counter > 0) --p.counter;\n                }\n            }\n        }\n        mem = ex;\n        ex = new_ex;\n    }\n    assert(start != invalid && stop != invalid);\n    unsigned cycles = stop - start;\n    std::printf(\"size=%3u one_bit=%u jalr=%u static=%u fold=%u cycles=%u misses=%u gain=%.2f%%'\"\\\\n\\\",\n                size, one_bit, predict_indirect, static_mode, folded_index,\n                cycles, wrong, (4491485.0 / cycles - 1.0) * 100);\n    if (\"'!size && !static_mode)\n        std::printf(\"retired=%u branches=%u jal=%u jalr=%u'\"\\\\n\\\", total, branches, jals, jalrs);\n}\n\nint main(int argc, char **argv) {\n    assert(argc == 2);\n    FILE *f = std::fopen(argv[1], \\\"rb\\\");\n    assert(f);\n    std::fseek(f, 0, SEEK_END);\n    std::vector<Instruction> trace(std::ftell(f) / sizeof(Instruction));\n    std::rewind(f);\n    assert(std::fread(trace.data(), sizeof(Instruction), trace.size(), f) == trace.size());\n    std::fclose(f);\n    run(trace, 0, false, false, false, false);\n    run(trace, 0, false, false, true, false);\n    for (unsigned size : {16u, 32u, 64u, 128u, 256u}) {\n        run(trace, size, false, true, false, false);\n        run(trace, size, true, true, false, false);\n        run(trace, size, false, false, false, false);\n        run(trace, size, false, true, false, true);\n    }\n}\nCPP\nc++ -O3 -Wall -Wextra \\\"\"'$trace_dir/replay.cpp\" -o \"$trace_dir/replay\" &&\n  \"$trace_dir/replay\" \"$trace_dir/retire.bin\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
