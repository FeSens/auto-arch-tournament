{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom random import Random\nrng = Random(20261119)\nmask = 2**32 - 1\nedge = [0, 1, 2, 3, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, 0xffffffff]\npairs = [(a, b) for a in edge for b in edge]\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\nfor a, b in pairs:\n    for signed in [False, True]:\n        x = a - 2**32 if signed and a >> 31 else a\n        y = b - 2**32 if signed and b >> 31 else b\n        dividend, divisor = abs(x), abs(y)\n        if divisor:\n            multiples = [digit * divisor for digit in range(4)]\n            rem = quo = 0\n            for offset in range(34, -1, -2):\n                trial = rem * 4 + (dividend >> offset & 3)\n                assert trial < 2**34\n                digit = max(i for i, m in enumerate(multiples) if m <= trial)\n                rem = trial - multiples[digit]\n                assert rem < divisor\n                quo = quo * 4 + digit\n            q = -quo if (x < 0) \"'!= (y < 0) else quo\n            r = -rem if x < 0 else rem\n            ref_q = x // y\n            if x % y and (x < 0) != (y < 0):\n                ref_q += 1\n            assert q & mask == ref_q & mask\n            assert r & mask == (x - ref_q * y) & mask\n        else:\n            q, r = mask, a\n            assert (q, r) == (0xffffffff, x & mask)\nprint(f'\"'Radix-4 arithmetic model matched {2 * len(pairs):,} signed and unsigned operand cases.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom random import Random\nrng = Random(20261119)\nmask = 2**32 - 1\nedge = [0, 1, 2, 3, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, 0xffffffff]\npairs = [(a, b) for a in edge for b in edge]\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\nfor a, b in pairs:\n    for signed in [False, True]:\n        x = a - 2**32 if signed and a >> 31 else a\n        y = b - 2**32 if signed and b >> 31 else b\n        dividend, divisor = abs(x), abs(y)\n        if divisor:\n            multiples = [digit * divisor for digit in range(4)]\n            rem = quo = 0\n            for offset in range(34, -1, -2):\n                trial = rem * 4 + (dividend >> offset & 3)\n                assert trial < 2**34\n                digit = max(i for i, m in enumerate(multiples) if m <= trial)\n                rem = trial - multiples[digit]\n                assert rem < divisor\n                quo = quo * 4 + digit\n            q = -quo if (x < 0) \"'!= (y < 0) else quo\n            r = -rem if x < 0 else rem\n            ref_q = x // y\n            if x % y and (x < 0) != (y < 0):\n                ref_q += 1\n            assert q & mask == ref_q & mask\n            assert r & mask == (x - ref_q * y) & mask\n        else:\n            q, r = mask, a\n            assert (q, r) == (0xffffffff, x & mask)\nprint(f'\"'Radix-4 arithmetic model matched {2 * len(pairs):,} signed and unsigned operand cases.')\nPY\"","aggregated_output":"Radix-4 arithmetic model matched 20,162 signed and unsigned operand cases.\n","exit_code":0,"status":"completed"}}
