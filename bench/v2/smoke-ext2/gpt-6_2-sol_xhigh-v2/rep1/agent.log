{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"set -e\ntrace_dir='/srv/hwebench/tmp/7cb5c576/e359ff01/bench-btb.cWUUO9dS'\ncp -r cores/bench/rtl \\\"\"'$trace_dir/rtl\"\npython - \"$trace_dir/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot = Path(sys.argv[1])\ndef update(file, *replacements):\n    path = root / file\n    text = path.read_text()\n    for before, after in replacements:\n        assert text.count(before) == 1, (file, before)\n        text = text.replace(before, after)\n    path.write_text(text)\n\nupdate('if_stage.sv',\n    (\\\"  output logic [31:0]       imem_addr,\\\",\n     \\\"\\\"\\\"  input  logic               btb_hit,\n  input  logic [31:0]        btb_target,\n  output logic [31:0]        imem_addr,\\\"\\\"\\\"),\n    (\\\"next_pc = redirect ? redirect_target : pc + 32'd4;\\\", \\\"next_pc = btb_hit ? btb_target : pc + 32'd4;\\\"))\n\nupdate('ex_stage.sv',\n    (\\\"  output ex_mem_t  out,\\\",\n     \\\"\\\"\\\"  input  logic [31:0]        fetch_pc,\n  output logic               btb_update,\n  output logic               btb_taken,\n  output logic [31:0]        btb_update_target,\n  output ex_mem_t  out,\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\"\"\",\n     \"\"\"  logic [31:0] fallthrough;\n  assign fallthrough = in.pc + 32'\"'d4;\n  assign btb_taken = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign btb_update_target = in.ctrl.is_jump ? jump_target : branch_target;\n  assign btb_update = in.valid && !stall && !misalign_fault &&\n                      (in.ctrl.is_branch || in.ctrl.is_jump);\n  assign redirect_target = btb_taken ? btb_update_target : fallthrough;\n  assign redirect = in.valid && !stall && fetch_pc != redirect_target;\"\"\"),\n    (\"\"\"reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'\"'d4)\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : (in.pc + 32'd4);\\\"\\\"\\\",\n     \\\"reg_q.pc_next       <= redirect_target;\\\"))\n\nupdate('core.sv',\n    (\\\"  logic [31:0] redirect_target;\\\",\n     \\\"\\\"\\\"  logic [31:0] redirect_target;\n  logic        btb_hit, btb_update, btb_taken;\n  logic [31:0] btb_target, btb_update_target;\n\n  branch_target_buffer u_btb (\n    .clock          (clock),\n    .reset          (reset),\n    .fetch_pc       (io_imemAddr),\n    .predict_taken  (btb_hit),\n    .predict_target (btb_target),\n    .update         (btb_update),\n    .update_pc      (id_ex_w.pc),\n    .update_target  (btb_update_target),\n    .update_taken   (btb_taken),\n    .update_jump    (id_ex_w.ctrl.is_jump)\n  );\\\"\\\"\\\"),\n    (\\\"    .imem_addr       (io_imemAddr),\\\",\n     \\\"\\\"\\\"    .btb_hit         (btb_hit),\n    .btb_target      (btb_target),\n    .imem_addr       (io_imemAddr),\\\"\\\"\\\"),\n    (\\\"    .out             (ex_mem_w),\\\",\n     \\\"\\\"\\\"    .fetch_pc        (io_imemAddr),\n    .btb_update      (btb_update),\n    .btb_taken       (btb_taken),\n    .btb_update_target(btb_update_target),\n    .out             (ex_mem_w),\\\"\\\"\\\"))\n\nupdate('hazard_unit.sv',\n    (\\\"  always_comb begin\\\", \\\"\\\"\\\"  assign stall_ex_mem = \"'!dmem_ready && ex_mem_mem_op;\n  assign hold_mem_wb  = stall_ex_mem;\n  assign dmem_stall   = stall_ex_mem;\n\n  always_comb begin\"\"\"),\n    (\"    dmem_stall = !dmem_ready && ex_mem_mem_op;'\"\\\\n\\\", \\\"\\\"),\n    (\\\"    stall_ex_mem  = dmem_stall;\\\\n\\\", \\\"\\\"),\n    (\\\"    hold_mem_wb   = dmem_stall;\\\\n\\\", \\\"\\\"))\nPY\ncat >\\\"\"'$trace_dir/rtl/branch_target_buffer.sv\" <<'\"'SV'\nmodule branch_target_buffer (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [31:0] fetch_pc,\n  output logic        predict_taken,\n  output logic [31:0] predict_target,\n  input  logic        update,\n  input  logic [31:0] update_pc,\n  input  logic [31:0] update_target,\n  input  logic        update_taken,\n  input  logic        update_jump\n);\n  localparam INDEX_WIDTH = 5;\n  localparam TAG_LOW = 2 + INDEX_WIDTH;\n  localparam ENTRIES = 1 << INDEX_WIDTH;\n\n  logic [ENTRIES-1:0] valid;\n  logic [19:TAG_LOW] tags [0:ENTRIES-1];\n  logic [19:2] targets [0:ENTRIES-1];\n  logic [2:0] state [0:ENTRIES-1];\n\n  logic [TAG_LOW-1:2] fetch_index, update_index;\n  logic [2:0] fetch_state, update_state, next_state;\n  logic matched_conditional, write_entry;\n\n  assign fetch_index = fetch_pc[TAG_LOW-1:2];\n  assign update_index = update_pc[TAG_LOW-1:2];\n  assign fetch_state = state[fetch_index];\n  assign update_state = state[update_index];\n  assign predict_taken = (fetch_pc[31:20] == '0) && (fetch_pc[1:0] == '0) &&\n                         valid[fetch_index] && tags[fetch_index] == fetch_pc[19:TAG_LOW] &&\n                         (fetch_state[2] || fetch_state[1]);\n  assign predict_target = {12'b0, targets[fetch_index], 2'b00};\n  assign matched_conditional = valid[update_index] &&\n                               tags[update_index] == update_pc[19:TAG_LOW] && \"'!update_state[2];\n  assign write_entry = update && (update_pc[31:20] == '\"'0) && (update_pc[1:0] == '0) &&\n                       (update_target[31:20] == '0) && (update_target[1:0] == '0) &&\n                       (update_taken || matched_conditional);\n\n  always_comb begin\n    next_state = update_state;\n    if (update_jump)\n      next_state = 3'b110;\n    else if (\"'!matched_conditional)\n      next_state = 3'\"'b010;\n    else if (update_taken && update_state[1:0] \"'!= 2'\"'b11)\n      next_state = update_state + 3'd1;\n    else if (\"'!update_taken && update_state[1:0] != 2'\"'b00)\n      next_state = update_state - 3'd1;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) valid <= '0;\n    else if (write_entry) valid[update_index] <= 1'b1;\n    if (\"'!reset && write_entry) begin\n      tags[update_index] <= update_pc[19:TAG_LOW];\n      targets[update_index] <= update_target[19:2];\n      state[update_index] <= next_state;\n    end\n  end\nendmodule\nSV\nRTL_DIR=\"$trace_dir/rtl\" OBJ_DIR=\"$trace_dir/btbobj\" NRET=1 MAKEFLAGS=-j2 bash test/cosim/build.sh >\"$trace_dir/btb_build.log\" 2>&1\n\"$trace_dir/btbobj/cosim_sim\" \"$trace_dir/coremark.elf\" 10000000 --bench --istall --dstall'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
