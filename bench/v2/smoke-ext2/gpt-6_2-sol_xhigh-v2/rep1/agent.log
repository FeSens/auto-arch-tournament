{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\n\nmask32 = (1 << 32) - 1\n\ndef as_signed(value):\n    return value - (1 << 32) if value & (1 << 31) else value\n\ndef proposed_div_rem(a, b, signed):\n    aa, bb = (as_signed(a), as_signed(b)) if signed else (a, b)\n    dividend, divisor = abs(aa), abs(bb)\n    multiples = tuple(i * divisor for i in range(4))\n    r, q = 0, 0\n    for shift in range(30, -1, -2):\n        partial = (r << 2) | (dividend >> shift & 3)\n        digit = next(i for i in range(3, -1, -1) if multiples[i] <= partial)\n        r, q = partial - multiples[digit], (q << 2) | digit\n        assert partial < 1 << 34\n        assert all(-2**34 <= partial - multiple < 2**34 for multiple in multiples)\n        if divisor:\n            assert 0 <= r < divisor\n    if b == 0:\n        return mask32, a\n    if (aa < 0) \"'!= (bb < 0):\n        q = -q\n    if aa < 0:\n        r = -r\n    return q & mask32, r & mask32\n\nrng = random.Random(20261119)\ncorners = (0, 1, 2, 3, 0x7FFFFFFF, 0x80000000, 0x80000001, 0xFFFFFFFE, mask32)\noperands = [(a, b) for a in corners for b in corners]\noperands += [(rng.getrandbits(32), rng.getrandbits(rng.randrange(1, 33))) for _ in range(25_000)]\nfor a, b in operands:\n    for signed in (False, True):\n        aa, bb = (as_signed(a), as_signed(b)) if signed else (a, b)\n        if bb:\n            q = abs(aa) // abs(bb)\n            if (aa < 0) != (bb < 0):\n                q = -q\n            expected = q & mask32, (aa - q * bb) & mask32\n        else:\n            expected = mask32, a\n        assert proposed_div_rem(a, b, signed) == expected, (a, b, signed)\nprint(f'\"'Radix-4 recurrence matched the reference on {2 * len(operands):,} operand/mode combinations')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
