else if (write_entry) valid[update_index] <= 1'b1;\n    if (\"'!reset && write_entry) begin\n      tags[update_index] <= update_pc[19:TAG_LOW];\n      targets[update_index] <= update_target[19:2];\n      state[update_index] <= next_state;\n    end\n  end\nendmodule\nSV\nRTL_DIR=\"$trace_dir/rtl\" OBJ_DIR=\"$trace_dir/btbobj\" NRET=1 MAKEFLAGS=-j2 bash test/cosim/build.sh >\"$trace_dir/btb_build.log\" 2>&1\n\"$trace_dir/btbobj/cosim_sim\" \"$trace_dir/coremark.elf\" 10000000 --bench --istall --dstall'", "aggregated_output": "{\"order\":2937036,\"cycle\":4213266,\"insn\":1048691,\"pc_rdata\":20,\"pc_wdata\":24,\"rd_addr\":0,\"rd_wdata\":0,\"rs1_addr\":0,\"rs1_rdata\":0,\"rs2_addr\":1,\"rs2_rdata\":20,\"mem_addr\":0,\"mem_rmask\":0,\"mem_rdata\":1048691,\"mem_wmask\":0,\"mem_wdata\":20,\"trap\":0,\"halt\":0,\"intr\":0,\"mode\":3,\"ixl\":1}\n{\"ebreak\":true,\"maxcycles_hit\":false,\"oob\":false,\"bench_start_cycle\":15185,\"bench_stop_cycle\":4206526,\"bench_bracketed\":true,\"uart\":\"2K performance run parameters for coremark.\\nCoreMark Size    : 666\\nTotal ticks      : 0\\nTotal time (secs): 10\\nIterations/Sec   : 1\\nIterations       : 10\\nCompiler version : riscv32-elf-gcc\\nCompiler flags   : -O2 -march=rv32im\\nMemory location  : STACK\\nseedcrc          : 0xe9f5\\n[0]crclist       : 0xe714\\n[0]crcmatrix     : 0x1fd7\\n[0]crcstate      : 0x8e3a\\n[0]crcfinal      : 0xfcaf\\nCorrect operation validated. See README.md for run and reporting rules.\\n\"}\n", "exit_code": 0, "status": "completed"}}
