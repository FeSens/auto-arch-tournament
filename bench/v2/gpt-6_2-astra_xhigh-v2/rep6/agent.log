{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"du -shL formal/riscv-formal/checks formal/riscv-formal/insns && ls -la /opt/gowin/IDE/bin/gw_sh && cat tools/eval/_slots.py && sed -n '1,220p' cores/bench/rtl/if_stage.sv\"", "aggregated_output": "996K\tformal/riscv-formal/checks\n4.5M\tformal/riscv-formal/insns\n-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = No\n…[6966 of 10038 chars elided by tools/bench/transcript.py; sha256:8b9471dfe1a62269]…\n(candidate.jal || (candidate.branch && counter[1]));\n  assign predicted_target_word = imem_ready ? live_target[19:2] : candidate.target_word;\n\n  // Capture both PC alternatives in parallel. Only the registered EX\n  // decision selects the corrected address, including on a fetch hold.\n  always_ff @(posedge clock) begin\n    correction_q    <= redirect && !reset;\n    correction_pc_q <= redirect_target;\n    if (reset)       predicted_pc_q <= RESET_PC;\n    else if (stall)  predicted_pc_q <= pc;\n    else             predicted_pc_q <= predicted_taken ? {12'b0, predicted_target_word, 2'b00}\n                                                        : pc + 32'd4;\n  end\n  assign pc = correction_q ? correction_pc_q : predicted_pc_q;\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc                = pc;\n    out.instr             = imem_ready ? imem_data : candidate.instr;\n    out.predicted_taken   = predicted_taken;\n    out.direction_counter = counter;\n    out.valid             = imem_ready || hit;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
