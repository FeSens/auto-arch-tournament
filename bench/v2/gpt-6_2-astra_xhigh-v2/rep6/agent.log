{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,99p' cores/bench/test/test_alu.py\nrg -n 'parse_iterations|ITERATIONS=' tools/eval/fpga.py bench/programs/coremark/baremetal/core_portme.h\ncat test/cosim/build.sh\ncommand -v riscv32-unknown-elf-gcc\ncommand -v pytest\"", "aggregated_output": "\"\"\"Combinational ALU and radix-16 DIV/REM request/response tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nDIV_LATENCY = 7  # One setup clock followed by six rounds.\n\n\nasync def _tick(dut):\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_resp_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _issue_div(dut, op, a, b):\n    assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await _tick(dut)\n    assert not int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n    dut.div_req_valid.value = 0\n    # Change all live inputs as soon as the divider owns the request.\n    dut.op.value = ALU_ADD\n    dut.a.value = 0x54321098\n    dut.b.value = 0x76543210\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    a_negative = op in (ALU_DIV, ALU_REM) and bool(a & (1 << 31))\n    b_negative = op in (ALU_DIV, ALU_REM) and bool(b & (1 << 31))\n    negate = a_negative if op in (ALU_REM, ALU_REMU) else (a_negative != b_negative and b != 0)\n    magnitude = (-expected if negat\n…[2901 of 5973 chars elided by tools/bench/transcript.py; sha256:8cea63eba8286c27]…\nLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n/srv/hwebench/venv/bin/pytest\n", "exit_code": 0, "status": "completed"}}
