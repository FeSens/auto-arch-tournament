{"type": "item.started", "item": {"id": "item_75", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/subword.py\" <<'\"'PY'\nimport os,shutil\nfrom pathlib import Path\ntmp=Path(os.environ['TMPDIR'])\nfor v,lg,wide in [('sub64',6,0),('sub128',7,0),('sub256',8,0),('subbank',8,1)]:\n root=tmp/v/'rtl';shutil.copytree('cores/bench/rtl',root)\n p=root/'ex_stage.sv';s=p.read_text().replace('  output logic [7:0]         lookup_index,','''  output logic [7:0]         lookup_index,\n  output logic [1:0]         lookup_lane,''').replace('  assign lookup_index[7:3]', '  assign lookup_lane = rs1[1:0] + in.imm[1:0];\\\\n  assign lookup_index[7:3]')\n p.write_text(s)\n p=root/'core.sv';s=p.read_text().replace('  logic [7:0] lookup_index;','  logic [7:0] lookup_index;\\\\n  logic [1:0] lookup_lane;')\n s=s.replace('    .lookup_index    (lookup_index),','    .lookup_lane     (lookup_lane),\\\\n    .lookup_index    (lookup_index),')\n s=s.replace('    .lookup_index   (lookup_index),','''    .lookup_lane    (lookup_lane),\n    .lookup_width   (id_ex_w.ctrl.mem_width),\n    .lookup_sext    (id_ex_w.ctrl.mem_sext),\n    .lookup_index   (lookup_index),''')\n s=s.replace(\\\"((id_ex_w.ctrl.mem_read && id_ex_w.ctrl.mem_width \"'!= 2'\"'d2)\\\\n                                    || is_mul(id_ex_w.ctrl.alu_op))\\\",\\\"is_mul(id_ex_w.ctrl.alu_op)\\\")\n p.write_text(s)\n p=root/'mem_stage.sv';s=p.read_text().replace('  input  logic [7:0]         lookup_index,','''  input  logic [7:0]         lookup_index,\n  input  logic [1:0]         lookup_lane, lookup_width,\n  input  logic               lookup_sext,''')\n s=s.replace('logic [7:0] candidate_index, update_index;',f'logic [{lg-1}:0] candidate_index, update_index;').replace('logic [9:0] candidate_tag;',f'logic [{17-lg}:0] candidate_tag;')\n s=s.replace('logic [255:0] occupied;',f'logic [{2**lg-1}:0] occupied;')\n s=s.replace('= in.effective_addr[9:2];',f'= in.effective_addr[{lg+1}:2];').replace('candidate_index <= lookup_index;',f'candidate_index <= lookup_index[{lg-1}:0];').replace('occupied[lookup_index]',f'occupied[lookup_index[{lg-1}:0]]').replace('update_index == lookup_index',f'update_index == lookup_index[{lg-1}:0]')\n s=s.replace('(* syn_ramstyle = \\\"block_ram\\\" *) logic [41:0] words [0:255];',f'''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] words [0:{2**lg-1}];\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [{17-lg}:0] tags [0:{2**lg-1}];\n  logic [31:0] stored_raw;\n  function automatic logic [31:0] format_word(input logic [31:0] word_in);\n    logic [7:0] byte_in;\n    logic [15:0] half_in;\n    byte_in = word_in[8 * lookup_lane +: 8];\n    half_in = lookup_lane[1] ? word_in[31:16] : word_in[15:0];\n    case (lookup_width)\n      2'd0: format_word = {{{{24{{lookup_sext && byte_in[7]}}}}, byte_in}};\n      2'd1: format_word = {{{{16{{lookup_sext && half_in[15]}}}}, half_in}};\n      default: format_word = word_in;\n    endcase\n  endfunction''')\n s=s.replace('load_hit ? predicted_word : dmem_rdata;', 'load_hit ? stored_raw : dmem_rdata;')\n start=s.index('    if (\"'!hold_wb)'\"\\\\n      {candidate_tag');end=s.index('  end\\\\n',start)\n s=s[:start]+f'''    if (\"'!hold_wb) begin\n      candidate_tag <= tags[lookup_index[{lg-1}:0]];\n      stored_raw <= words[lookup_index[{lg-1}:0]];\n      predicted_word <= format_word(words[lookup_index[{lg-1}:0]]);\n    end\n    if (update && install) begin\n      words[update_index] <= in.ctrl.mem_write ? in.write_data : dmem_rdata;\n      tags[update_index] <= in.effective_addr[19:{lg+2}];\n    end\n'\"'''+s[end:]\n if wide:\n  s=s.replace('  assign raw_word', '''  logic [3:0] bank_q;\n  logic [31:0] candidates [0:3];\n  always_ff @(posedge clock) if (\"'!hold_wb) bank_q <= 4'\"'b0001 << lookup_index[7:6];\n  for (genvar k=0; k<4; k++) begin : gen_part\n    always_ff @(posedge clock) if (\"'!hold_wb)\n      candidates[k] <= format_word(words[{k[1:0], lookup_index[5:0]}]);\n  end\n  assign predicted_word = ({32