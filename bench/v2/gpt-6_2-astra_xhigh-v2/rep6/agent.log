{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"ls -la cores/bench/experiments && git status --short && date -u && sed -n '313,361p' cores/bench/test/test_pipeline.py\"","aggregated_output":"total 224\ndrwxrwx---+ 3 nobody nogroup   4096 Nov 23 01:36 .\ndrwxrwx---+ 5 nobody nogroup   4096 Nov 23 01:36 ..\n-rw-rw----+ 1 nobody nogroup      0 Nov 23 01:36 .gitkeep\ndrwxrwx---+ 2 nobody nogroup   4096 Nov 23 01:37 hypotheses\n-rw-rw----+ 1 nobody nogroup 130942 Nov 23 01:36 log.jsonl\n-rw-rw----+ 1 nobody nogroup  71554 Nov 23 01:36 progress.png\nMon Nov 23 00:40:18 UTC 2026\nasync def load_div_rem_store_with_stalls(dut):\n    program = [\n        ADDI(2, 0, 7),\n        LW(1, 0, 0),       # -101, forwarded from WB to the first divide\n        DIV(3, 1, 2),      # -101 / 7 = -14\n        REM(4, 1, 3),      # -101 % -14 = -3, forwarded rs2\n        DIV(5, 3, 4),      # -14 / -3 = 4\n        SW(5, 0, 4),       # consume the immediately preceding divide\n        DIV(6, 5, 4),      # wait behind the stalled store, then use x5 from WB\n        EBREAK(),\n    ]\n    fetch_attempts = {}\n    mem_cycles = 0\n\n    def ready(pc, mem_access):\n        nonlocal mem_cycles\n        # Stall the fetch of REM briefly, and hold the EBREAK fetch through\n        # the last divide's transfer. Stall each data access for three edges.\n        fetch_attempts[pc] = fetch_attempts.get(pc, 0) + 1\n        fetch_delay = {12: 2, 28: 12}.get(pc, 0)\n        mem_cycles = mem_cycles + 1 if mem_access else 0\n        return fetch_attempts[pc] > fetch_delay, mem_cycles == 0 or mem_cycles > 3\n\n    stores = []\n    rets, dmem = await _run(dut, program, {0: -101 & 0xFFFFFFFF}, bus_ready=ready, stores=stores)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    for i, r in enumerate(rets):\n        assert (r[\"pc\"], r[\"pc_next\"], r[\"trap\"]) == (4 * i, 4 * i + 4, 0)\n    for i, rs1, a, rs2, b, rd, result in [\n        (2, 1, -101, 2, 7, 3, -14),\n        (3, 1, -101, 3, -14, 4, -3),\n        (4, 3, -14, 4, -3, 5, 4),\n        (6, 5, 4, 4, -3, 6, -1),\n    ]:\n        r = rets[i]\n        assert (r[\"rs1_addr\"], r[\"rs1_rdata\"]) == (rs1, a & 0xFFFFFFFF)\n        assert (r[\"rs2_addr\"], r[\"rs2_rdata\"]) == (rs2, b & 0xFFFFFFFF)\n        assert (r[\"rd\"], r[\"rd_wdata\"]) == (rd, result & 0xFFFFFFFF)\n        assert (r[\"mem_rmask\"], r[\"mem_wmask\"]) == (0, 0)\n    store = rets[5]\n    assert (store[\"rs2_addr\"], store[\"rs2_rdata\"]) == (5, 4)\n    assert (store[\"mem_addr\"], store[\"mem_wmask\"], store[\"mem_wdata\"]) == (4, 15, 4)\n    assert stores == [(4, 15, 4)] and dmem[4] == 4\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n","exit_code":0,"status":"completed"}}
