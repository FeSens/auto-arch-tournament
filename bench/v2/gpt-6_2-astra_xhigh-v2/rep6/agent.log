{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Combinational ALU and four-round DIV/REM request/response tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_resp_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _issue_div(dut, op, a, b):\n    assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await _tick(dut)\n    assert not int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n    dut.div_req_valid.value = 0\n    # Change all live inputs as soon as the divider owns the request.\n    dut.op.value = ALU_ADD\n    dut.a.value = 0x54321098\n    dut.b.value = 0x76543210\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    dut.div_resp_ready.value = 0\n    await _issue_div(dut, op, a, b)\n    for round_number in range(1, 5):\n        await _tick(dut)\n        assert not int(dut.div_req_ready.value)\n        assert int(dut.div_resp_valid.value) == (round_number == 4)\n    for cycle in range(hold\n…[6456 of 9528 chars elided by tools/bench/transcript.py; sha256:96269216fa055eb9]…\nr = dividend - divisor * q\n            else:\n                q, r = -1, dividend\n            await _check_div(dut, op, a, b, r if op in (ALU_REM, ALU_REMU) else q)\n\n\n@cocotb.test()\nasync def divider_reset(dut):\n    await _setup(dut)\n    for rounds_before_reset in (2, 4):\n        dut.div_resp_ready.value = 0\n        await _issue_div(dut, ALU_DIV, -101, 7)\n        for _ in range(rounds_before_reset):\n            await _tick(dut)\n        assert int(dut.div_resp_valid.value) == (rounds_before_reset == 4)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(5):\n            assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n            await _tick(dut)\n        await _check_div(dut, ALU_REMU, 0xFFFFFFFF, 0x80000000, 0x7FFFFFFF)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/conftest.py; cat cores/bench/core.yaml; rg -n 'implementation_notes|\\\\.tmp' .gitignore\"","aggregated_output":"\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 31.863\n  lut4: 2895\n  ff: 563\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261122-002-r1s1\n  updated: '2026-11-22T22:04:28.561015Z'\n87:cores/*/implementation_notes.md\n","exit_code":0,"status":"completed"}}
