lse, 'divergence_at': i,\n            'insn': hex(ref['insn']), 'pc': hex(ref['pc']),\n            'field': field, 'expected': hex(expected), 'got': hex(got)}\n\ndef compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\n            ref_reason=None, sim_returncode=0, sim_stderr=''):\n    for i, (ref, sim) in enumerate(zip(ref_trace, sim_trace)):\n        # Direct-equality RVFI fields. trap/halt/intr/mode/ixl are included\n    \n…[10133 of 13205 chars elided by tools/bench/transcript.py; sha256:9a6c2b5d816ad3fa]…\nta_4_s0/Q       dmem_0_dmem_0_0_0_s/DI[4]                     clock:[R]    clock:[R]   0.000      0.000        0.464       \n125:  9             0.215        cpu/u_ex/reg_q.write_data_2_s0/Q       dmem_0_dmem_0_0_0_s/DI[2]                     clock:[R]    clock:[R]   0.000      0.000        0.464       \n133:  17            0.337        cpu/u_ex/reg_q.write_data_1_s0/Q       dmem_0_dmem_0_0_0_s/DI[1]                     clock:[R]    clock:[R]   0.000      0.000        0.586       \n136:  20            0.340        cpu/u_ex/reg_q.write_data_7_s0/Q       dmem_0_dmem_0_0_0_s/DI[7]                     clock:[R]    clock:[R]   0.000      0.000        0.589       \n137:  21            0.340        cpu/u_ex/reg_q.write_data_3_s0/Q       dmem_0_dmem_0_0_0_s/DI[3]                     clock:[R]    clock:[R]   0.000      0.000        0.589       \n139:  23            0.347        cpu/u_ex/reg_q.effective_addr_6_s0/Q   dmem_0_dmem_0_0_0_s/ADA[7]                    clock:[R]    clock:[R]   0.000      0.000        0.465       \n", "exit_code": 0, "status": "completed"}}
