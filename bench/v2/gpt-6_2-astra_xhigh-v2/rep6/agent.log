{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/divmicro.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os\ns=Path(os.environ['TMPDIR'])\nfor n in ['divded','divgroups','divgroupsce']:\n d=s/n/'rtl'\n copytree('cores/bench/rtl',d)\n p=d/'core_pkg.sv'\n v=p.read_text().replace('logic        div_negate;', 'logic        div_negate;\\\\n    logic div_result_valid;\\\\n    logic [31:0] div_data;')\n if n\"'!='\"'divded':\n  v=v.replace('logic [31:0] div_data;', 'logic [31:0] div_partial0,div_partial1,div_partial2,div_partial3;\\\\n    logic [31:0] div_quot;\\\\n    logic div_rem;')\n p.write_text(v)\n p=d/'ex_stage.sv'\n v=p.read_text().replace('                           | ({32{div_transfer}} & div_magnitude)\\\\n','').replace('      reg_q.div_negate    <= div_transfer && div_negate;', '''      reg_q.div_result_valid <= in.wb_only && in.instr[14];\n      reg_q.div_negate    <= div_negate;''')\n if n=='divded':\n  v=v.replace('  assign out = reg_q;', '  assign out = reg_q;').replace('      reg_q.div_negate    <= div_negate;', '      reg_q.div_negate    <= div_negate;\\\\n      reg_q.div_data <= div_magnitude;')\n else:\n  v=v.replace('  alu u_alu (','  logic [31:0] partial0,partial1,partial2,partial3,div_quot;\\\\n  logic div_rem;\\\\n  alu u_alu (\\\\n    .partial0(partial0), .partial1(partial1), .partial2(partial2), .partial3(partial3), .div_quot(div_quot), .div_rem(div_rem),')\n  cap='''      reg_q.div_partial0 <= partial0;\n      reg_q.div_partial1 <= partial1;\n      reg_q.div_partial2 <= partial2;\n      reg_q.div_partial3 <= partial3;\n      reg_q.div_quot <= div_quot;\n      reg_q.div_rem <= div_rem;'''\n  if n=='divgroups':\n   # use separate free-running data regs to avoid multiple writers of the bundle\n   v=v.replace('  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    out.div_partial0 = part0_q;\n    out.div_partial1 = part1_q;\n    out.div_partial2 = part2_q;\n    out.div_partial3 = part3_q;\n    out.div_quot = quot_q;\n    out.div_rem = rem_q;\n  end''')\n   v=v.replace('  ex_mem_t reg_q;', '''  ex_mem_t reg_q;\n  logic [31:0] part0_q,part1_q,part2_q,part3_q,quot_q;\n  logic rem_q;\n  always_ff @(posedge clock) begin\n    part0_q <= partial0;\n    part1_q <= partial1;\n    part2_q <= partial2;\n    part3_q <= partial3;\n    quot_q <= div_quot;\n    rem_q <= div_rem;\n  end''')\n  else:\n   v=v.replace('      reg_q.div_negate    <= div_negate;', '      reg_q.div_negate    <= div_negate;\\\\n'+cap)\n  ap=d/'alu.sv'\n  av=ap.read_text().replace('  output logic        div_negate','  output logic [31:0] partial0,partial1,partial2,partial3,div_quot,\\\\n  output logic div_rem,\\\\n  output logic        div_negate')\n  av=av.replace('  assign div_negate = 1\\\\'b0;', '''  assign partial0 = 0, partial1 = 0, partial2 = 0, partial3 = 0, div_quot = div_magnitude, div_rem = 0;\n  assign div_negate = 1'b0;''').replace('  assign div_magnitude = rem_op_q ?', '''  assign partial0=residual_group[0],partial1=residual_group[1],partial2=residual_group[2],partial3=residual_group[3],div_quot={quotient_q[27:0],digit},div_rem=rem_op_q;\n  assign div_magnitude = rem_op_q ?''')\n  ap.write_text(av)\n p.write_text(v)\n p=d/'mem_stage.sv'\n v=p.read_text().replace('  logic [31:0] mul_result;', '  logic [31:0] div_data;\\\\n  assign div_data = '+('in.div_data;' if n=='divded' else 'in.div_rem ? (in.div_partial0 | in.div_partial1 | in.div_partial2 | in.div_partial3) : in.div_quot;')+'\\\\n  logic [31:0] mul_result;')\n v=v.replace('in.div_negate ? -in.alu_result : in.alu_result;', 'in.div_result_valid ? (in.div_negate ? -div_data : div_data) : in.alu_result;')\n p.write_text(v)\nPY\npython \\\"\"'$TMPDIR/divmicro.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
