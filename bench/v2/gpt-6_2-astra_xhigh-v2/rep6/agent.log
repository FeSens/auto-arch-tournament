{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\nmask = 2**32 - 1\nwide_mask = 2**36 - 1\ndef radix4(a, d):\n    q, r = a, 0\n    for _ in range(6):\n        for _ in range(3):\n            p = (r << 2) | (q >> 34)\n            digit = max(k for k in range(4) if p >= k*d)\n            r = p - digit*d\n            q = (q << 2 | digit) & wide_mask\n    return q & mask, r\nrng = Random(4491485)\nedges = [0, 1, 2, 3, 4, 0x55555555, 0x55555556, 0x7fffffff, 0x80000000, mask]\npairs = [(a, b) for a in edges for b in edges] + [(rng.getrandbits(32), rng.getrandbits(rng.randint(0, 32))) for _ in range(10000)]\nfor a, b in pairs:\n    assert radix4(a,b) == (divmod(a,b) if b else (mask,a))\nprint(f\\\"Unsigned magnitude recurrence matches division and remainder on {len(pairs)} operand pairs\\\")\nprint(\\\"Threshold/forecast (MHz):\\\", 70.94*1.046*4491485/1e7, 70.94*1.30*4491485/1e7)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
