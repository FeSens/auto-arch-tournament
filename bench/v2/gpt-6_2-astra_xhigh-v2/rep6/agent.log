ppend((len(program), 15, original, original, 2))\n    program.extend([LW(3, 0, 0x80), ADD(4, 3, 0), EBREAK()])\n    reads, stores = [], []\n    rets, _ = await _run(dut, program, {0x40: original}, reads=reads, stores=stores,\n                         bus_ready=lambda pc, access: (True, access))\n    _check_path(rets, list(range(0, len(program) * 4, 4)))\n    assert reads == [0x40, 0x80, 0x82, 0x80]\n    assert stores == [(0x80, 15, original), (0x81, 2, 0x5a5a5a5a),\n                      (0x82, 12, 0x005a005a), (0x80, 15, original)]\n    for i, mask, raw, value, gap in cases:\n        load, use = rets[i:i + 2]\n        assert (load[\"mem_addr\"], load[\"mem_rmask\"], load[\"mem_rdata\"]) == (0x80, mask, raw)\n        assert (load[\"rd_wdata\"], use[\"rs1_rdata\"], use[\"rd_wdata\"]) == (value, value, value)\n        assert use[\"cycle\"] - load[\"cycle\"] == gap\n\n\n@cocotb.test()\nasync def load_table_address_boundaries(dut):\n    ram, alias, mmio, high = 0x80, 0x480, 0x10000080, 0x00100080\n    program = [\n        LUI(1, 0x10000), LUI(2, 0x00100),\n        LW(5, 0, ram), LW(5, 0, alias), LW(5, 0, ram),\n        LW(5, 1, ram), ADD(6, 5, 5), LW(5, 1, ram), ADD(6, 5, 5),\n        LW(5, 2, ram), ADD(6, 5, 5), LW(5, 0, ram), ADD(6, 5, 5),\n        ADDI(5, 0, 77), LW(5, 0, ram + 2), ADD(6, 5, 5),\n        SH(5, 0, ram + 1), LW(5, 0, ram), ADD(6, 5, 5), EBREAK(),\n    ]\n    reads, stores = [], []\n    rets, _ = await _run(dut, program, {ram: 3, alias: 8, mmio: 13, high: 21},\n                         reads=reads, stores=stores)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert reads == [ram, alias, ram, mmio, mmio, high] and stores == []\n","exit_code":0,"status":"completed"}}
