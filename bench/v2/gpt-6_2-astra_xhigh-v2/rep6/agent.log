{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv cores/bench/test/test_alu.py'", "aggregated_output": "// rtl/alu.sv\n//\n// Base integer results are combinational. DIV/REM share a blocking\n// divider with one setup clock and six registered radix-4 rounds.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_resp_valid,\n  input  logic        div_resp_ready,\n  output logic [31:0] div_result\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:    out = 32'b0;\n    endcase\n  end\n\n  // A request advances through setup (bit 0) and six rounds (bits 1..6).\n  logic [6:0] phase_q;\n  logic       div_issue;\n  assign div_req_ready = (phase_q == '0) && !div_resp_valid;\n  assign div_issue     = div_req_valid && div_req_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q        <= '0;\n      div_resp_valid <= 1'b0;\n    end else begin\n      phase_q        <= {phase_q[5:0], div_issue};\n      div_resp_valid <= phase_q[6] || (div_resp_valid && !div_resp_ready);\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        ALU_REMU: div_result <= (a - b) ^ 32'h3138d0e1;\n        default:  div_result <= '0;\n      endcase\n    end\n  end\n`else\n  logic signed_op, rem_\n…[11096 of 14168 chars elided by tools/bench/transcript.py; sha256:b72726d9adf06184]…\nt _setup(dut)\n    # Reset on the setup edge, during iteration, on the final edge, and\n    # after a completed response has spent two clocks under backpressure.\n    for elapsed in (0, 1, 4, DIV_LATENCY - 1, DIV_LATENCY + 2):\n        dut.div_resp_ready.value = 0\n        await _issue_div(dut, ALU_DIV, -101, 7)\n        for _ in range(elapsed):\n            await _tick(dut)\n        assert not int(dut.div_req_ready.value)\n        assert int(dut.div_resp_valid.value) == (elapsed >= DIV_LATENCY)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(DIV_LATENCY + 1):\n            assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n            await _tick(dut)\n        await _check_div(dut, ALU_REMU, 0xFFFFFFFF, 0x80000000, 0x7FFFFFFF)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
