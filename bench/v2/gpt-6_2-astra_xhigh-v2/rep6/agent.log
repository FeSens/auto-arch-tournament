{"type": "item.completed", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/wb_stage.sv && cat cores/bench/test/_helpers.py | head -90 && sed -n '1,90p' cores/bench/rtl/forward_unit.sv\"", "aggregated_output": "// rtl/wb_stage.sv\n//\n// Write-back stage. Pure combinational mux that selects between the\n// loaded-data path (mem_to_reg=1) and the ALU-result path. Drives the\n// regfile write port; the regfile itself stalls on x0 and gates on\n// w_en.\n//\n// Latency:        combinational.\n// RVFI fields:    feeds rd_wdata (= w_data when w_en=1, else 0).\nmodule wb_stage (\n  // mem_wb_t fields beyond reg_write/rd/mem_to_reg/read_data/alu_result\n  // (pc, mem_*, rs?_*, instr) are RVFI-only and read at top level.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  mem_wb_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic               w_en,\n  output logic [4:0]         w_addr,\n  output logic [31:0]        w_data\n);\n\n  always_comb begin\n    w_en   = in.ctrl.reg_write && in.valid;\n    w_addr = in.rd;\n    w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;\n  end\n\nendmodule\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: \n…[1068 of 4140 chars elided by tools/bench/transcript.py; sha256:61f0758c115ff157]…\nvia EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       hold_id,\n  input  logic       hold_mem,\n  input  logic [4:0] decode_rs,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic       ex_mem_load,\n  input  logic       mem_wb_w_en,\n  output bypass_t    sel\n);\n\n  logic mem_match_q, wb_match_q, from_mem, wb_match;\n  always_ff @(posedge clock) begin\n    if (!hold_id)\n      mem_match_q <= id_ex_rd != 0 && id_ex_rd == decode_rs;\n    if (!hold_mem) begin\n      // With ID held, MEM drains into WB and EX supplies a bubble.\n      wb_match_q <= hold_id ? mem_match_q : (ex_mem_rd != 0 && ex_mem_rd == decode_rs);\n    end\n  end\n\n  assign from_mem = ex_mem_w_en && mem_match_q;\n  assign wb_match = mem_wb_w_en && wb_match_q;\n  assign sel.captured  = !from_mem && !wb_match;\n  assign sel.mem_wb    = !from_mem && wb_match;\n  assign sel.ex_mem    = from_mem && !ex_mem_load;\n  assign sel.load_word = from_mem && ex_mem_load;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/results.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1];base=Path(os.environ['TMPDIR'])/('r9-'+tag)\np=base/'rtl';shutil.copytree(Path(os.environ['TMPDIR'])/'r9-lanesflat/rtl',p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\nf=p/'ex_stage.sv'\ns=f.read_text();left=s[:s.index('  always_ff @(posedge clock) sum_q <=')];right=s[s.index('  always_comb begin\\\\n    out=reg_q;'):]\ns=left+'''\n  wire [31:0] bitwise = (rs1 & alu_b & {32{in.op_and || in.op_or}})\n                       | ((rs1 \"'^ alu_b) & {32{in.op_xor || in.op_or}});\n  wire [31:0] cmp = {31'\"'b0, (in.op_slt && \"'$signed(rs1) < $signed(alu_b))\n                          || (in.op_sltu && rs1 < alu_b)};\n  wire [31:0] right_shift = $unsigned($signed({in.op_sra && rs1[31],rs1}) >>> alu_b[4:0]);\n  wire [31:0] left_shift = rs1 << alu_b[4:0];\n  wire [31:0] shift_results = (left_shift & {32{in.op_sll}})\n                           | (right_shift & {32{in.op_sra || in.op_srl}});\n  wire [31:0] arithmetic = ((rs1 + alu_b) & {32{in.op_add}})\n                  | ((rs1 - alu_b) & {32{in.op_sub}});\n  wire [31:0] misc = (in.imm & {32{in.op_lui}})\n                   | ((in.pc + in.imm) & {32{in.op_auipc}})\n                   | (fallthrough_pc & {32{in.op_jump}})\n                   | (div_result & {32{in.op_div}});\n'\"''' +right\ngroups={'bitwise':'bitwise','cmp':'cmp','shift_results':'shift_results','arithmetic':'arithmetic','misc':'misc'}\nif 'share' in tag or 'choice' in tag:\n s=s.replace('((rs1 + alu_b) & {32{in.op_add}})\\\\n                  | ((rs1 - alu_b) & {32{in.op_sub}})','(rs1 + (alu_b \"'^ {32{in.op_sub}}) + in.op_sub) & {32{in.op_add || in.op_sub}}'\"')\nif 'branch' in tag:\n pos=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');end=s.index('  assign taken =',pos)\n s=s[:pos]+'''  wire eq = rs1 == rs2;\n  wire ult = rs1 < rs2;\n  wire slt = rs1[31] \"'^ rs2[31] ? rs1[31] : ult;\n  assign branch_cond = (in.ctrl.branch_op[2] ? (in.ctrl.branch_op[1] ? ult : slt) : eq)\n                     ''^ in.ctrl.branch_op[0];\n'\"'''+s[end:]\nif 'masked' in tag:\n s=s.replace('alu_b = in.ctrl.alu_src  ? in.imm : rs2;', '''alu_b = ({32{in.ctrl.alu_src}} & in.imm)\n          | ({32{\"'!in.ctrl.alu_src && fwd_rs2_sel.captured}} & in.rs2_val)\n          | ({32{!in.ctrl.alu_src && fwd_rs2_sel.ex_mem}} & fwd_ex_mem)\n          | ({32{!in.ctrl.alu_src && fwd_rs2_sel.mem_wb}} & fwd_mem_wb)\n          | ({32{!in.ctrl.alu_src && fwd_rs2_sel.load_word}} & predicted_word);'\"''')\nif 'choice' in tag:\n # select fast operation RHS via mux for arithmetic with minimal post-adder logic\n s=s.replace(') & {32{in.op_add || in.op_sub}};',');')\n expr='''  always_ff @(posedge clock) sum_q <= (in.op_add || in.op_sub) ? arithmetic\n                                    : (bitwise | cmp | shift_results | misc);\n'''\nelif 'split' in tag:\n # register after arithmetic with separately registered selector. Bypass via 2:1 mux\n s=s.replace(') & {32{in.op_add || in.op_sub}};',');')\n expr='''  logic addsub_q;\n  always_ff @(posedge clock) begin\n    addsub_q <= in.op_add || in.op_sub;\n    sum_q <= arithmetic;\n    logic_q <= bitwise | cmp | shift_results | misc;\n  end\n'''\n s=s.replace('out.alu_result=sum_q;', 'out.alu_result=addsub_q ? sum_q : logic_q;')\nelse:\n expr='  always_ff @(posedge clock) sum_q <= arithmetic | bitwise | cmp | misc | shift_results;\\\\n'\ns=s.replace('  always_comb begin\\\\n    out=reg_q;',expr+'  always_comb begin\\\\n    out=reg_q;')\nf.write_text(s)\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/results.py\" reschoice'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
