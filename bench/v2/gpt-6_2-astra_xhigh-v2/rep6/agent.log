lacement = imem_data[2]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign target = pc + displacement;\n  assign predicted_taken = (is_jal || (is_branch && count\n…[2019 of 5091 chars elided by tools/bench/transcript.py; sha256:890bfb890f4dfd7e]…\nng up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_id,          // bubble entering EX\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic dmem_stall;\n\n  assign load_use_hazard = id_ex_mem_read && id_ex_rd != 5'b0\n                        && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign dmem_stall   = !dmem_ready && ex_mem_mem_op;\n  assign stall_id     = dmem_stall || div_wait;\n  assign stall_if     = stall_id || load_use_hazard || !imem_ready;\n  assign flush_id     = load_use_hazard || redirect;\n  assign stall_ex_mem = dmem_stall;\n  assign hold_mem_wb  = dmem_stall;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
