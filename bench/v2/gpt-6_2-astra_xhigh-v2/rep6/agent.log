asked paths.\n data=data.replace('lq <= left_partial;', 'lq <= {32{in.ctrl.alu_op == ALU_SLL}} & left_partial;').replace('rq <= right_partial;', 'rq <= {32{in.ctrl.alu_op == ALU_SRA || in.ctrl.alu_op == ALU_SRL}} & right_partial;')\n data=data[:data.index('    out.alu_result =')]+'    out.alu_result = reg_q.alu_result | logical_left | logical_right;\\\\n  end'\nif 'mux' in tag:\n data=data[:data.index('    out.alu_result =')]+'    out.alu_result = sll_q ? logical_left : right_q ? logical_right : reg_q.alu_result;\\\\n  end'\nedit('ex_stage.sv','  assign out = reg_q;',data)\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/partial.py\" partial4 4'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
