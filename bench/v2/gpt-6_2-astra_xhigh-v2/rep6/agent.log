{"type":"item.completed","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/occupancy_table.sv'","aggregated_output":"// A group-valid bit invalidates sixteen entries together. On the first\n// update after a clear, write all sixteen bit planes for the group.\n// Subsequent updates write only the plane containing the addressed entry.\nmodule occupancy_table #(parameter INDEX_BITS = 8) (\n  input  logic                  clock,\n  input  logic                  clear,\n  input  logic                  update,\n  input  logic                  install,\n  input  logic [INDEX_BITS-1:0] write_index,\n  input  logic [INDEX_BITS-1:0] read_index,\n  output logic                  occupied\n);\n  localparam GROUPS = 1 << (INDEX_BITS - 4);\n  logic [GROUPS-1:0] group_valid;\n  wire [INDEX_BITS-5:0] write_group = write_index[INDEX_BITS-1:4];\n  wire [INDEX_BITS-5:0] read_group  = read_index[INDEX_BITS-1:4];\n  logic [15:0] members;\n\n  always_ff @(posedge clock) begin\n    if (clear) group_valid <= '0;\n    else if (update) group_valid[write_group] <= 1'b1;\n  end\n\n  for (genvar p = 0; p < 16; p++) begin : plane\n    (* syn_ramstyle = \"distributed_ram\" *) logic bits [0:GROUPS-1];\n    wire addressed = write_index[3:0] == p[3:0];\n    always_ff @(posedge clock) begin\n      if (update && (addressed || !group_valid[write_group]))\n        bits[write_group] <= addressed && install;\n    end\n    assign members[p] = bits[read_group];\n  end\n  assign occupied = group_valid[read_group] && members[read_index[3:0]];\nendmodule\n","exit_code":0,"status":"completed"}}
