&& !div_resp_ready);\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  assign div_negate = 1'b0;\n  assign div_completion.take_small      = 1'b1;\n  assign div_completion.take_quotient   = 1'b0;\n  assign div_completion.take_remainder  = 1'b0;\n  assign div_completion.large_quot\n…[7362 of 10434 chars elided by tools/bench/transcript.py; sha256:7bc5cd7694ebcc4b]…\n0, fits};\n  assign residual[0] = {32{select_digit[0]}} & partial_dividend;\n  assign remainder_next = residual[0] | residual[1] | residual[2] | residual[3] |\n                          residual[4] | residual[5] | residual[6] | residual[7];\n  assign digit = {fits[4], (fits[2] && !fits[4]) || fits[6], |(select_digit & 8'haa)};\n\n  // Expand the six committed digits in parallel with the final trial.\n  logic [11:0] quad_prefix;\n  logic [5:0] bin_prefix;\n  for (genvar i = 0; i < 6; i++) begin : gen_quotient\n    assign quad_prefix[2*i +: 2] = slots_q[3*i +: 2];\n    assign bin_prefix[i] = slots_q[3*i];\n  end\n  assign div_completion.large_quotient =\n        ({21{oct_q}}  & {slots_q[17:0], 3'b0})\n      | ({21{quad_q}} & {7'b0, quad_prefix, 2'b0})\n      | ({21{bin_q}}  & {14'b0, bin_prefix, 1'b0})\n      | {18'b0, digit};\n  assign div_completion.large_remainder = remainder_next;\n`endif\n\n  assign div_magnitude = divide_magnitude(div_completion);\n\n  assign div_result = div_negate ? -div_magnitude : div_magnitude;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
