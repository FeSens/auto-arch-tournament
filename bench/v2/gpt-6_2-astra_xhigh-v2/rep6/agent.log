{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/reg_file.sv'","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// The reset clears all 32 registers. Distributed-LUT or flop inference is\n// fine here; explicit BRAM attribution lives on the larger imem/dmem\n// declarations in soc.sv (phase 5).\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  logic [31:0] regs [0:31];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n    end else if (w_en && w_addr != 5'b0) begin\n      regs[w_addr] <= w_data;\n    end\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = regs[rs1_addr];\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = regs[rs2_addr];\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// A load consumer runs on its registered bank value while MEM verifies\n// its address. A failed verification kills this execution at the edge.\n//\n// Latency:        1 cycle for fast ops. DIV/REM hold ID/EX until completion.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               replay,        // keep ID/EX and bubble EX/MEM on release\n  input  id_ex_t   in,\n  input  bypass_t            fwd_rs1_sel,\n  input  bypass_t            fwd_rs2_sel,\n  input  load_banks_t        predicted_values,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  output ex_mem_t  out,\n  output logic [7:0]         lookup_index,\n  output logic [1:0]         lookup_lane,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:0]        redirect_target,\n  output logic               fence_i,\n  output logic               train_en,\n  output logic [6:0]         train_index,\n  output logic [1:0]         train_counter\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  function automatic logic [31:0] operand(input bypass_t sel, input logic [31:0] captured);\n    operand = select_banks(predicted_values, sel.banks)\n            | ({32{sel.captured}} & captured)\n            | ({32{sel.mem_wb}}   & fwd_mem_wb)\n            | ({32{sel.ex_mem}}   & fwd_ex_mem);\n  endfunction\n\n  assign rs1 = operand(fwd_rs1_sel, in.rs1_val);\n  assign rs2 = operand(fwd_rs2_se\n…[4586 of 7658 chars elided by tools/bench/transcript.py; sha256:45948e5baa691322]…\n in for LOADs, so we route PC+4 here.\n      reg_q.alu_result    <= in.ctrl.is_jump ? fallthrough_pc\n                           : div_resp_valid ? div_result : alu_result;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_resp_valid ? div_rs1_q : rs1;\n      reg_q.rs2_val       <= div_resp_valid ? div_rs2_q : rs2;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= aligned_taken ? transfer_target : fallthrough_pc;\n      // Let older work leave MEM, then put bubbles behind it until transfer.\n      reg_q.ctrl          <= (div_wait || replay) ? '0 : ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait && !replay;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
