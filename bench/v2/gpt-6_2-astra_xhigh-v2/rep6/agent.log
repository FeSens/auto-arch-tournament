{"type": "item.started", "item": {"id": "item_73", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/loadpipe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1];base=Path(os.environ['TMPDIR'])/('r9-'+tag);p=base/'rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\nedit('id_stage.sv','  output id_ex_t  out','  output logic [7:0] lookup_index,\\\\n  output id_ex_t  out')\nedit('id_stage.sv','  assign out = reg_q;', '''  assign lookup_index[7:3] = rs1_data[9:5] + imm[9:5];\n  assign lookup_index[2:0] = rs1_data[4:2] + imm[4:2];\n  assign out = reg_q;''')\nedit('core.sv','    .out      (id_ex_w)','    .lookup_index(lookup_index),\\\\n    .out      (id_ex_w)')\nedit('core.sv','    .lookup_index    (lookup_index),','    .lane_offset    (lane_offset),')\nedit('core.sv','  logic [7:0] lookup_index;','  logic [7:0] lookup_index;\\\\n  logic [1:0] lane_offset;')\nedit('core.sv','    .lookup_index   (lookup_index),','    .lookup_index   (lookup_index),\\\\n    .hold_id(stall_id), .width_ex(id_ex_w.ctrl.mem_width), .sign_ex(id_ex_w.ctrl.mem_sext), .lane_offset(lane_offset),')\nedit('ex_stage.sv','  output logic [7:0]         lookup_index,','  output logic [1:0]         lane_offset,')\nedit('ex_stage.sv','  assign lookup_index[7:3] = rs1[9:5] + in.imm[9:5];\\\\n  assign lookup_index[2:0] = rs1[4:2] + in.imm[4:2];','  assign lane_offset = rs1[1:0] + in.imm[1:0];')\nedit('core.sv','((id_ex_w.ctrl.mem_read && id_ex_w.ctrl.mem_width \"'!= 2'\"\\\\'d2)\\\\n                                    || is_mul(id_ex_w.ctrl.alu_op))','is_mul(id_ex_w.ctrl.alu_op)')\nedit('mem_stage.sv','  input  logic [7:0]         lookup_index,','  input logic hold_id, sign_ex,\\\\n  input logic [1:0] width_ex, lane_offset,\\\\n  input  logic [7:0]         lookup_index,')\nedit('mem_stage.sv','  logic [31:0] raw_word;', '''  logic [31:0] raw_word, raw_candidate, read_word;\n  logic [9:0] read_tag;\n  logic [7:0] read_index;\n  logic read_valid;\n  logic [31:0] fragment, formatted;\n  assign fragment = read_word >> {lane_offset,3'b000};\n  always_comb begin\n    case (width_ex)\n      2'd0: formatted = {{24{sign_ex && fragment[7]}},fragment[7:0]};\n      2'd1: formatted = {{16{sign_ex && fragment[15]}},fragment[15:0]};\n      default: formatted = read_word;\n    endcase\n  end''')\nedit('mem_stage.sv','raw_word = load_hit ? predicted_word : dmem_rdata;', 'raw_word = load_hit ? raw_candidate : dmem_rdata;')\nedit('mem_stage.sv','''    if (\"'!hold_wb)\n      {candidate_tag, predicted_word} <= words[lookup_index];'\"''','''    if (\"'!hold_id)\n      {read_tag, read_word} <= words[lookup_index];\n    if (!hold_wb) begin\n      candidate_tag <= read_tag;\n      raw_candidate <= read_word;\n      predicted_word <= formatted;\n    end'\"''')\nedit('mem_stage.sv',\\\"      candidate_valid <= 1'b0;\\\", \\\"      candidate_valid <= 1'b0;\\\\n      read_valid <= 1'b0;\\\")\nedit('mem_stage.sv','''      if (\"'!hold_wb) begin\n        candidate_index <= lookup_index;\n        candidate_valid <= occupied[lookup_index] && !(update && update_index == lookup_index);\n      end'\"''','''      if (\"'!hold_id) begin\n        read_index <= lookup_index;\n        read_valid <= occupied[lookup_index] && !(update && update_index == lookup_index);\n      end else if (update && update_index == read_index) begin\n        read_valid <= 1'\"'b0;\n      end\n      if (\"'!hold_wb) begin\n        candidate_index <= read_index;\n        candidate_valid <= read_valid && !(update && update_index == read_index);\n      end'\"''')\nedit('mem_stage.sv','assign raw_word = load_hit ? raw_candidate : dmem_rdata;','assign raw_word = load_hit ? raw_candidate : dmem_rdata;')\nedit('mem_stage.sv','shifted   = raw_word >>', 'shifted   = dmem_rdata >>')\nedit('mem_stage.sv','default: load_data = raw_word;', 'default: load_data = dmem_rdata;')\nedit('mem_stage.sv','reg_q.read_data  <= load_data;', 'reg_q.read_data  <= load_hit ? predicted_word : load_data;')\nif 'base' in tag:\n # A small mirror of low GPR bits serves only the speculative RAM index.\n edit('id_stage.sv','  output logic [7:0] lookup_index,','  input logic wb_we,\\\\n  input logic [4:0] wb_rd,\\\\n  input logic [9:0] wb_low,\\\\n  output logic [7:0] lookup_index,')\n edit('core.sv','    .lookup_index(lookup_index),','    .lookup_index(lookup_index), .wb_we(wb_w_en), .wb_rd(wb_w_addr), .wb_low(wb_w_data[9:0]),')\n edit('id_stage.sv','  assign lookup_index[7:3] = rs1_data[9:5]', '''  (* syn_ramstyle=\\\"distributed_ram\\\" *) logic [7:0] base_bits [0:31];\n  always_ff @(posedge clock) if (wb_we && wb_rd \"'!= 0) base_bits[wb_rd] <= wb_low[9:2];\n  wire [7:0] preview = base_bits[in.instr[19:15]];\n  assign lookup_index[7:3] = preview[7:3]'\"''')\n edit('id_stage.sv','  assign lookup_index[2:0] = rs1_data[4:2]', '  assign lookup_index[2:0] = preview[2:0]')\nif 'isplit' in tag:\n edit('id_stage.sv',' + imm[9:5]',' + in.instr[29:25]').replace if False else None\n f=p/'id_stage.sv';s=f.read_text().replace(' + imm[9:5]',' + in.instr[29:25]').replace(' + imm[4:2]',' + in.instr[24:22]');f.write_text(s)\nif 'free' in tag:\n edit('mem_stage.sv', '''    if (\"'!hold_id)\n      {read_tag, read_word} <= words[lookup_index];'\"''','''    {read_tag, read_word} <= words[lookup_index];''')\n edit('mem_stage.sv','''      end else if (update && update_index == read_index) begin\n        read_valid <= 1'b0;''','''      end else begin\n        read_valid <= 1'b0;''')\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/loadpipe.py\" loadbaseisplitfree'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
