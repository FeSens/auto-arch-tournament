nel-1 drain is compiled out under `#if NRET < 2`, so a single-\n    issue core (no `_1` ports) builds cleanly.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as t\n…[8396 of 11468 chars elided by tools/bench/transcript.py; sha256:720b05c3ac83b398]…\nen = int(dut.io_dmemWEn.value)\n        wdata = int(dut.io_dmemWData.value)\n        mem_access = bool(wen or int(dut.io_dmemREn.value))\n        iready, dready = bus_ready(ia, mem_access) if bus_ready else (True, True)\n        dut.io_imemReady.value = int(iready)\n        dut.io_dmemReady.value = int(dready)\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK()) if iready else 0\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0) if dready else 0\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n        if wen and dready:\n            if stores is not None:\n                stores.append((da, wen, wdata))\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if int(dut.io_rvfi_valid_0.value):\n            r = {\n", "exit_code": 0, "status": "completed"}}
