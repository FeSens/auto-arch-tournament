{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv; git diff --stat'", "aggregated_output": "// rtl/alu.sv\n//\n// Base integer results are combinational. DIV/REM share a blocking\n// divider with radix 2, 4, 8 or 16. Setup and six rounds register seven digits.\n// A final trial on the held state produces the response.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_resp_valid,\n  input  logic        div_resp_ready,\n  output logic [31:0] div_result,\n  output logic [31:0] div_magnitude,\n  output logic        div_negate,\n  output logic [31:0] div_mem_magnitude\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:    out = 32'b0;\n    endcase\n  end\n\n  // A request advances through setup (bit 0) and six rounds (bits 1..6).\n  logic [6:0] phase_q;\n  logic       div_issue;\n  assign div_req_ready = (phase_q == '0) && !div_resp_valid;\n  assign div_issue     = div_req_valid && div_req_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q        <= '0;\n      div_resp_valid <= 1'b0;\n    end else begin\n      phase_q        <= {phase_q[5:0], div_issue};\n      div_resp_valid <= phase_q[6] || (div_resp_valid && !div_resp_ready);\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  assign div_negate = 1'b0;\n  always_ff @(posedge clock) div_mem_magnitude <= div_magnitude;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_magnitude <= (a - \n…[7267 of 10339 chars elided by tools/bench/transcript.py; sha256:db8d498e554e0568]…\nuotient_q}} & quotient;\n  assign dividend_term = {32{use_dividend_q}} & dividend_q;\n  assign div_magnitude = quotient_term | dividend_term | ({32{use_remainder_q}} & remainder_next);\n\n  // A divide in MEM has no bus request and advances on the next edge.\n  // Only that MEM slot consumes these free-running result registers.\n  logic [31:0] mem_quotient_q, mem_dividend_q;\n  always_ff @(posedge clock) begin\n    mem_quotient_q <= quotient_term;\n    mem_dividend_q <= dividend_term;\n  end\n  assign div_mem_magnitude = mem_quotient_q | mem_dividend_q |\n                             mem_group[0] | mem_group[1] | mem_group[2] | mem_group[3];\n`endif\n\n  assign div_result = div_negate ? -div_magnitude : div_magnitude;\n\nendmodule\n cores/bench/rtl/alu.sv       | 141 +++++++++++++++++++++++++++++++------------\n cores/bench/rtl/core_pkg.sv  |   1 +\n cores/bench/rtl/ex_stage.sv  |  16 +++--\n cores/bench/rtl/mem_stage.sv |   6 +-\n cores/bench/test/test_alu.py |  34 ++++++++++-\n 5 files changed, 152 insertions(+), 46 deletions(-)\n", "exit_code": 0, "status": "completed"}}
