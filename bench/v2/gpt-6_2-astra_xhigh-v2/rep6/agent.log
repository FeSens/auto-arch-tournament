{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/rtl/forward_unit.sv; sed -n '80,142p' cores/bench/rtl/id_stage.sv\"","aggregated_output":"// rtl/forward_unit.sv\n//\n// Generate one-hot operand enables from the youngest matching writer.\n// The load-word enable is independent of address verification in MEM.\n//\n// Decode compares the incoming rs against the next cycle's MEM and WB\n// destinations so register-number comparisons stay off the EX data path.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       hold_id,\n  input  logic       hold_mem,\n  input  logic [4:0] decode_rs,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic       ex_mem_load,\n  input  logic       mem_wb_w_en,\n  output bypass_t    sel\n);\n\n  logic mem_match_q, wb_match_q, from_mem, wb_match;\n  always_ff @(posedge clock) begin\n    if (!hold_id)\n      mem_match_q <= id_ex_rd != 0 && id_ex_rd == decode_rs;\n    if (!hold_mem) begin\n      // With ID held, MEM drains into WB and EX supplies a bubble.\n      wb_match_q <= hold_id ? mem_match_q : (ex_mem_rd != 0 && ex_mem_rd == decode_rs);\n    end\n  end\n\n  assign from_mem = ex_mem_w_en && mem_match_q;\n  assign wb_match = mem_wb_w_en && wb_match_q;\n  assign sel.captured  = !from_mem && !wb_match;\n  assign sel.mem_wb    = !from_mem && wb_match;\n  assign sel.ex_mem    = from_mem && !ex_mem_load;\n  assign sel.load_word = from_mem && ex_mem_load;\n\nendmodule\n    ctrl_decoded.is_lui     = dec_is_lui;\n    ctrl_decoded.is_auipc   = dec_is_auipc;\n    ctrl_decoded.mem_read   = dec_mem_read;\n    ctrl_decoded.mem_write  = dec_mem_write;\n    ctrl_decoded.mem_width  = dec_mem_width;\n    ctrl_decoded.mem_sext   = dec_mem_sext;\n    ctrl_decoded.reg_write  = dec_reg_write;\n    ctrl_decoded.mem_to_reg = dec_mem_to_reg;\n    ctrl_decoded.is_illegal = dec_is_illegal;\n  end\n\n  // ── ID/EX register ──────────────────────────────────────────────────────\n  logic   is_fence_i;\n  assign is_fence_i = in.instr[6:0] == 7'b0001111 && in.instr[14:12] == 3'b001;\n\n  alu_en_t result_en;\n  logic    dec_add, dec_div;\n  // Several instruction classes leave alu_op at its ADD default.\n  assign dec_add = dec_alu_op == ALU_ADD && dec_reg_write && !dec_mem_read\n                && !dec_is_jump && !dec_is_auipc;\n  assign result_en[int'(ALU_ADD)] = dec_add && !dec_alu_src;\n  for (genvar op = 1; op <= ALU_LUI; op++) begin : gen_result_en\n    assign result_en[op] = dec_alu_op == op;\n  end\n  assign dec_div = dec_alu_op == ALU_DIV || dec_alu_op == ALU_DIVU\n                || dec_alu_op == ALU_REM || dec_alu_op == ALU_REMU;\n\n  always_ff @(posedge clock) begin\n    reg_q.rs1_val <= rs1_data;\n    reg_q.rs2_val <= rs2_data;\n    if (!stall) begin\n      reg_q.pc       <= in.pc;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.instr    <= in.instr;\n      // Forwarding and WB qualify these datapath selects with the producer.\n      // A flush can kill validity independently of the result decode.\n      reg_q.result_en <= result_en;\n      reg_q.addi_en   <= dec_add && dec_alu_src;\n      reg_q.is_div    <= dec_div;\n      reg_q.is_fence_i          <= is_fence_i;\n      reg_q.recover_fallthrough <= in.predicted_taken || is_fence_i;\n      reg_q.direction_counter <= in.direction_counter;\n    end\n\n    // Only validity and controls need killing. Raw decode and operand\n    // capture can proceed independently of the EX correction.\n    if (reset) begin\n      reg_q.valid <= 1'b0;\n      reg_q.ctrl  <= '0;\n    end else if (!stall) begin\n      reg_q.valid <= in.valid && !flush;\n      reg_q.ctrl  <= (in.valid && !flush) ? ctrl_decoded : '0;\n    end\n  end\n\n  assign out = reg_q