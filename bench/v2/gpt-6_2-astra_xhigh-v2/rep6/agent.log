{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/narrow\"\ncp -r cores/bench/rtl cores/bench/test \"$TMPDIR/narrow/\"\ncommand -v verilator\ncommand -v iverilog\ncommand -v pytest\ncat tools/eval/_slots.py | head -125\ntail -20 cores/bench/test/test_alu.py\ndate -u'","aggregated_output":"/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/oss-cad-suite/bin/iverilog\n/srv/hwebench/venv/bin/pytest\n\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n        dut.div_resp_ready.value = 0\n        await _issue_div(dut, ALU_DIV, -101, 7)\n        for _ in range(elapsed):\n            await _tick(dut)\n        assert not int(dut.div_req_ready.value)\n        assert int(dut.div_resp_valid.value) == (elapsed >= DIV_LATENCY)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(DIV_LATENCY + 1):\n            assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n            await _tick(dut)\n        await _check_div(dut, ALU_REMU, 0xFFFFFFFF, 0x80000000, 0x7FFFFFFF)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\nMon Nov 23 06:34:48 UTC 2026\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/narrow/gen.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom math import ceil,log2\nimport os\nr=Path(os.environ['TMPDIR'])/'narrow'/'rtl'\ndest=r/'alu.sv'\nbaseline=Path('cores/bench/rtl')\nalu=(baseline/'alu.sv').read_text()\nfront=alu[:alu.index('\"'`else'\"\\\\n')]\nbody=\\\"\\\"\\\"\n  logic [31:0] dividend_q, divisor_q, quotient_q, partial_q;\n  logic [31:0] remainder_next, quotient_next, start_quotient, start_partial;\n  logic [3:0] mode, mode_q, digit;\n  logic rem_q, zero_q;\n  wire signed_op = op == ALU_DIV || op == ALU_REM;\n  wire rem_op = op == ALU_REM || op == ALU_REMU;\n  wire a_neg = signed_op && a[31];\n  wire b_neg = signed_op && b[31];\n\n  assign mode[0] = |divisor_q[31:24];\n  assign mode[1] = divisor_q[31:24] == 0 && |divisor_q[23:16];\n  assign mode[2] = divisor_q[31:16] == 0 && |divisor_q[15:8];\n  assign mode[3] = divisor_q[31:8] == 0;\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dividend_q <= a_neg ? -a : a;\n      divisor_q <= b_neg ? -b : b;\n      rem_q <= rem_op;\n      zero_q <= b == 0;\n      div_negate <= rem_op ? a_neg : ((a_neg \"'^ b_neg) && b != 0);\n    end\n    if (phase_q[0]) mode_q <= mode;\n  end\n\"\"\"\ndef ow(k):\n return 32 if k==1 else 26 if k<4 else 19 if k<8 else 12\ndef gen_mult(k,d):\n if k==1: return d\n if k in [3,7,15]: return f'\"'(({d} << {(k+1).bit_length()-1}) - {d})'\n if k in [5,9]: return f'(({d} << {(k-1).bit_length()-1}) + {d})'\n if k in [11,13]:\n  return f\\\"(({d} << 3) \"'^ ({d} << {1 if k==11 else 2}) ''^ {d}) + (((({d} << 3) & ({d} << {1 if k==11 else 2})) | (({d} << 3) & {d}) | (({d} << {1 if k==11 else 2}) & {d})) << 1)\"\nfor k in range(1,16,2):\n w=ow(k)\n body+=f\"  logic [{w-1}:0] multiple_{k};'\"\\\\n\\\"\n if k==1: body+=\\\"  assign multiple_1 = divisor_q;\\\\n\\\"\n else: body+=f\\\"  always_ff @(posedge clock) if (phase_q[0]) multiple_{k} <= {w}'({gen_mult(k,'divisor_q')});\\\\n\\\"\nfor k in range(2,16,2):\n w=ow(k)\n shift=(k&-k).bit_length()-1\n body+=f\\\"  wire [{w-1}:0] multiple_{k} = {w}'(multiple_{k>>shift} << {shift});\\\\n\\\"\n\ndef maskterms(terms):\n return ' | '.join(terms)\ndef expand(w,signal,value):\n return f'({{{{{w}{{{signal}}}}}}} & {value})'\nfor s in range(1,5):\n # Setup partial P for first digit. Limit each divisor's effective width to P width.\n wp=32-7*s\n body+=f\\\"  wire [{wp-1}:0] first_p_{s} = dividend_q[31:{7*s}];\\\\n\\\"\n body+=f\\\"  wire [{(1<<s)-1}:0] first_ok_{s};\\\\n  assign first_ok_{s}[0] = 1'b1;\\\\n\\\"\n for k in range(1,1<<s):\n  w=wp+ceil(log2(k))\n  body+=f\\\"  wire [{w-1}:0] first_m_{s}_{k} = {w}'(divisor_q[{wp-1}:0]) * {w}'d{k};\\\\n\\\"\n  body+=f\\\"  wire [{w}:0] first_sub_{s}_{k} = {w+1}'(first_p_{s}) - {w+1}'(first_m_{s}_{k});\\\\n\\\"\n  body+=f\\\"  assign first_ok_{s}[{k}] = \"'!(|divisor_q[31:{wp}]) && !first_sub_{s}_{k}[{w}];'\"\\\\n\\\"\n body+=f\\\"  wire [{(1<<s)-1}:0] first_one_{s} = first_ok_{s} & ~(first_ok_{s} >> 1);\\\\n\\\"\n body+=f\\\"  wire [{s-1}:0] first_digit_{s};\\\\n\\\"\n for j in range(s):\n  mask=sum(1<<k for k in range(1<<s) if k & (1<<j))\n  body+=f\\\"  assign first_digit_{s}[{j}] = |(first_one_{s} & {1<<s}'h{mask:x});\\\\n\\\"\n terms=[expand(wp,f'first_one_{s}[{k}]',f'first_sub_{s}_{k}[{wp-1}:0]' if k else f'first_p_{s}') for k in range(1<<s)]\n body+=f\\\"  wire [{wp-1}:0] first_r_{s} = {maskterms(terms)};\\\\n\\\"\n body+=f\\\"  wire [31:0] start_q_{s} = {{dividend_q[{7*s-1}:0], \\\"+(f\\\"{32-8*s}'d0, \\\" if s<4 else \\\"\\\")+f\\\"first_digit_{s}}};\\\\n\\\"\n body+=f\\\"  wire [31:0] start_p_{s} = 32'({{first_r_{s}, dividend_q[{7*s-1}:{6*s}]}});\\\\n\\\"\nfor field,key in [('start_quotient','start_q'),('start_partial','start_p')]:\n body+=f\\\"  assign {field} = {maskterms([expand(32,f'mode[{s-1}]',f'{key}_{s}') for s in range(1,5)])};\\\\n\\\"\nbody+=\\\"  wire [15:0] ok, winner;\\\\n  assign ok[0] = 1'b1;\\\\n\\\"\nfor k in range(1,16):\n w=ow(k)\n qual=\\\"1'b1\\\" if k==1 else (\\\"(|mode_q[3:1])\\\" if k<4 else (\\\"(|mode_q[3:2])\\\" if k<8 else \\\"mode_q[3]\\\"))\n body+=f\\\"  wire [{w}:0] diff_{k} = {{1'b0,partial_q[{w-1}:0]}} - {{1'b0,multiple_{k}}};\\\\n\\\"\n body+=f\\\"  assign ok[{k}] = {qual} && \"'!diff_{k}[{w}];'\"\\\\n\\\"\nbody+=\\\"  assign winner = ok & ~(ok >> 1);\\\\n\\\"\nfor j in range(4):\n mask=sum(1<<k for k in range(16) if k & (1<<j))\n body+=f\\\"  assign digit[{j}] = |(winner & 16'h{mask:04x});\\\\n\\\"\nbody+=\\\"  assign remainder_next = \\\"+maskterms([expand(32,f'winner[{k}]',f\\\"32'(diff_{k}[{ow(k)-1}:0])\\\" if k else 'partial_q') for k in range(16)])+\\\";\\\\n\\\"\nfor s in range(1,5):\n body+=f\\\"  wire [31:0] q_{s} = {{quotient_q[{31-s}:0], digit[{s-1}:0]}};\\\\n\\\"\n body+=f\\\"  wire [31:0] p_{s} = {{remainder_next[{31-s}:0], quotient_q[{31-s}:{32-2*s}]}};\\\\n\\\"\nbody+=\\\"  assign quotient_next = \\\"+maskterms([expand(32,f'mode_q[{s-1}]',f'q_{s}') for s in range(1,5)])+\\\";\\\\n\\\"\nbody+=\\\"  wire [31:0] partial_next = \\\"+maskterms([expand(32,f'mode_q[{s-1}]',f'p_{s}') for s in range(1,5)])+\\\";\\\\n\\\"\nbody+=\\\"\\\"\\\"\n  always_ff @(posedge clock) begin\n    if (phase_q[0]) begin\n      quotient_q <= start_quotient;\n      partial_q <= start_partial;\n    end else if (|phase_q[6:1]) begin\n      quotient_q <= quotient_next;\n      partial_q <= partial_next;\n    end\n  end\n  assign div_magnitude = zero_q ? (rem_q ? dividend_q : 32'hffffffff) :\n                         rem_q ? remainder_next : quotient_next;\n\\\"\\\"\\\"\ndest.write_text(front+'\"'`else'\"\\\\n'+body+alu[alu.rindex('\"'`endif'\"'):])\np=r/'core_pkg.sv'\np.write_text((baseline/p.name).read_text().replace('logic        div_negate;', 'logic        div_negate;\\\\n    logic [31:0] div_value;'))\np=r/'ex_stage.sv'\np.write_text((baseline/p.name).read_text().replace('                           | ({32{div_transfer}} & div_magnitude)\\\\n','').replace('  assign out = reg_q;', '  assign out = reg_q;').replace('      reg_q.div_negate', '      reg_q.div_value <= div_magnitude;\\\\n      reg_q.div_negate'))\np=r/'mem_stage.sv'\np.write_text((baseline/p.name).read_text().replace('in.div_negate ? -in.alu_result : in.alu_result;', 'in.ctrl.alu_op >= ALU_DIV && in.ctrl.alu_op <= ALU_REMU ?\\\\n                          (in.div_negate ? -in.div_value : in.div_value) : in.alu_result;'))\nPY\npython \\\"\"'$TMPDIR/narrow/gen.py\"\nrg '\"'remainder_next =' \\\"\"'$TMPDIR/narrow/rtl/alu.sv\" | cut -c 1-180\nverilator --lint-only -Wno-fatal --top-module alu \"$TMPDIR/narrow/rtl/core_pkg.sv\" \"$TMPDIR/narrow/rtl/alu.sv\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
