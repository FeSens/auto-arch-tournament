{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'p=\"$TMPDIR/predict\"\nsed -n '\"'45,170p' \\\"\"'$p/cores/bench/rtl/if_stage.sv\" && tail -38 \"$p/cores/bench/rtl/id_stage.sv\" && command -v pytest && cat cores/bench/core.yaml && git status --short --untracked-files=all && git check-ignore -v cores/bench/experiments/hypotheses/hyp-20261122-003-r3s2.yaml'","aggregated_output":"  assign is_branch = imem_data[6:0] == 7'h63\n                   && imem_data[14:13] != 2'b01;\n  assign displacement = imem_data[2]\n       ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n       : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign target = pc + displacement;\n  assign predict_taken = (is_jal || (is_branch && out.pred_ctr[1]))\n                      && target[31:20] == 0 && target[1:0] == 0;\n  assign next_pc = predict_taken ? target : pc + 32'd4;\n  assign out.pred_taken = predict_taken;\n  assign out.pred_ctr = counters[pc[8:2]];\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_data;\n    out.valid = !flush;\n  end\n\nendmodule\n    ctrl_decoded.mem_read   = dec_mem_read;\n    ctrl_decoded.mem_write  = dec_mem_write;\n    ctrl_decoded.mem_width  = dec_mem_width;\n    ctrl_decoded.mem_sext   = dec_mem_sext;\n    ctrl_decoded.reg_write  = dec_reg_write;\n    ctrl_decoded.mem_to_reg = dec_mem_to_reg;\n    ctrl_decoded.is_illegal = dec_is_illegal;\n  end\n\n  // ── ID/EX register ──────────────────────────────────────────────────────\n  id_ex_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      reg_q.pred_taken <= in.pred_taken;\n      reg_q.pred_ctr   <= in.pred_ctr;\n      reg_q.pc       <= in.pc;\n      reg_q.rs1_val  <= rs1_data;\n      reg_q.rs2_val  <= rs2_data;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n\n      reg_q.instr    <= in.instr;\n    end\n    if (reset || flush) begin\n      reg_q.ctrl  <= '0;\n      reg_q.valid <= 1'b0;\n    end else if (!stall) begin\n      reg_q.ctrl  <= in.valid ? ctrl_decoded : '0;\n      reg_q.valid <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n/srv/hwebench/venv/bin/pytest\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 45.64\n  lut4: 2960\n  ff: 604\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261122-002-r2s1\n  updated: '2026-11-22T22:28:30.965225Z'\n.gitignore:88:cores/*/experiments/hypotheses/\tcores/bench/experiments/hypotheses/hyp-20261122-003-r3s2.yaml\n","exit_code":0,"status":"completed"}}
