{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"cp -r cores/bench/test '/srv/hwebench/tmp/51daa901/645b37fd/mul-mem.ZFiV5y/cores/bench'\npython3 - <<'PY'\nfrom pathlib import Path\nd=Path('/srv/hwebench/tmp/51daa901/645b37fd/mul-mem.ZFiV5y/cores/bench/test')\nap=d/'test_alu.py'\nalu=ap.read_text()\ni=alu.index('@cocotb.test()\\\\nasync def mul(')\nj=alu.index('@cocotb.test()\\\\nasync def div_signed(')\nmultiply_tests=alu[i:j].replace('    await _setup(dut)\\\\n','')\nap.write_text(alu[:i]+alu[j:])\ni=alu.index('async def _check('); j=alu.index('async def _issue_div')\nextra='''\n@cocotb.test()\nasync def product_reference(dut):\n    rng = random.Random(0x2343)\n    values = [0, 1, MASK32, 0x80000000, 0x7fffffff]\n    pairs = [(a, b) for a in values for b in values]\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(64))\n    for a, b in pairs:\n        sa = a - (a >> 31) * (1 << 32)\n        sb = b - (b >> 31) * (1 << 32)\n        for op, value in ((ALU_MUL, a*b), (ALU_MULH, (sa*sb) >> 32),\n                          (ALU_MULHSU, (sa*b) >> 32), (ALU_MULHU, (a*b) >> 32)):\n            await _check(dut, op, a, b, value)\n\ndef test_multiplier_runner():\n    run_cocotb(toplevel=\\\"multiplier\\\", sources=[\\\"core_pkg.sv\\\", \\\"multiplier.sv\\\"], test_module=\\\"test_multiplier\\\")\n'''\n(d/'test_multiplier.py').write_text('import random\\\\nimport cocotb\\\\nfrom cocotb.triggers import Timer\\\\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU, run_cocotb\\\\nMASK32=0xffffffff\\\\n'+alu[i:j]+multiply_tests+extra)\npp=d/'test_pipeline.py'\npipe=pp.read_text().replace('\\\"alu.sv\\\", \\\"decoder.sv\\\"', '\\\"alu.sv\\\", \\\"multiplier.sv\\\", \\\"decoder.sv\\\"')\nextra='''\n@cocotb.test()\nasync def multiply_dependences(dut):\n    def mul(rd, rs1, rs2):\n        return _r(1, rs2, rs1, 0, rd, 0x33)\n    program = [\n        ADDI(1, 0, 7), ADDI(2, 0, 9),\n        mul(3, 1, 2), mul(4, 1, 1),\n        mul(5, 4, 2), SW(5, 0, 4),\n        mul(6, 3, 2), BNE(6, 0, 8), SW(1, 0, 16), EBREAK(),\n    ]\n    held = 0\n    def ready(pc, mem_access):\n        nonlocal held\n        if mem_access and held < 5:\n            held += 1\n            return True, False\n        return True, True\n    stores = []\n    rets, _ = await _run(dut, program, bus_ready=ready, stores=stores)\n    assert held == 5\n    assert [r[\\\"pc\\\"] for r in rets] == [0,4,8,12,16,20,24,28,36]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(9))\n    assert [r[\\\"rd_wdata\\\"] for r in rets[2:5]] == [63,49,441]\n    assert rets[2][\\\"cycle\\\"] + 1 == rets[3][\\\"cycle\\\"]\n    assert rets[3][\\\"cycle\\\"] + 2 == rets[4][\\\"cycle\\\"]\n    assert rets[4][\\\"rs1_rdata\\\"] == 49 and rets[4][\\\"rs2_rdata\\\"] == 9\n    assert stores == [(4,15,441)]\n    assert rets[6][\\\"rd_wdata\\\"] == 567 and rets[7][\\\"rs1_rdata\\\"] == 567\n'''\npp.write_text(pipe+extra)\nPY\npytest -q '/srv/hwebench/tmp/51daa901/645b37fd/mul-mem.ZFiV5y/cores/bench/test/test_alu.py' '/srv/hwebench/tmp/51daa901/645b37fd/mul-mem.ZFiV5y/cores/bench/test/test_multiplier.py' '/srv/hwebench/tmp/51daa901/645b37fd/mul-mem.ZFiV5y/cores/bench/test/test_pipeline.py' > '/srv/hwebench/tmp/51daa901/645b37fd/mul-mem.ZFiV5y/cocotb.log' 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
