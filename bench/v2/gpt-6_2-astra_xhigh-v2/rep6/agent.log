{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '75,235p;620,894p;1130,1170p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, bus_ready=None, stores=None,\n               stalled_word=None, unified_memory=False, reads=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value. An optional bus_ready(pc, mem_access) callback sets\n    both ready signals before each edge. The reads and stores lists record accepted accesses.\n    stalled_word can poison the instruction bus while ready is low.\n    With unified_memory, accepted stores are visible to later live fetches.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = imem if unified_memory else {}\n    dmem.update(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    await Timer(1, \"ns\")\n    dut.reset.value = 0\n\n    for cycle in range(max_cycles):\n        ia = int(dut.io_imemAddr.value)\n        da = int(dut.io_dmemAddr.value)\n        wen = int(dut.io_dmemWEn.value)\n        wdata = int(dut.io_dmemWData.value)\n        ren = int(dut.io_dmemREn.value)\n        mem_access = bool(wen or ren)\n        iready, dready = bus_ready(ia, mem_access) if bus_ready else (True, True)\n        dut.io_imemReady.value = int(iready)\n        dut.io_dmemReady.value = int(dready)\n        # Even an unaccepted fetch can carry\n…[16873 of 19945 chars elided by tools/bench/transcript.py; sha256:ee3935a8b9261b87]…\ndut, program, {0x80: 13, 0x480: 7}, stores=stores, bus_ready=ready)\n    _check_path(rets, [0, 4, 8, 12, 16, 20])\n    assert len(held_pcs) == 4 and len(set(held_pcs)) == 1\n    assert rets[3][\"cycle\"] == rets[2][\"cycle\"] + 2\n    assert (rets[3][\"rs1_rdata\"], rets[3][\"rs2_rdata\"]) == (7, 13)\n    assert stores == [(0x84, 15, 7)]\n\n\n@cocotb.test()\nasync def fence_i_after_stalled_code_store(dut):\n    new_word = ADDI(4, 4, 9)\n    program = [\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"multiplier.sv\", \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
