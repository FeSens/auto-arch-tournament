s': [{'file': 'rtl/core_pkg.sv', 'description': 'Add a 32-bit effective_addr field immediately after alu_result in ex_mem_t.'}, {'file': 'rtl/ex_stage.sv', 'description': 'Register post-forwarding rs1 plus in.imm directly into effective_addr\\non the normal EX/MEM advance edge. Hold it with the memory controls\\nand store data during dmem backpressure.\\n'}, {'file': 'rtl\n…[8356 of 11428 chars elided by tools/bench/transcript.py; sha256:e85231bbde884c2e]…\nindependent\\nmultiplies retire on consecutive clocks. Check that an immediate\\nbranch, store or multiply consumes the WB product after one bubble.\\nHold a multiply behind an older stalled memory access, then check\\nthe operands, accepted stores and successive channel-0 orders.\\n'}], 'outcome': 'improvement', 'fitness': 146.18, 'delta_pct': 22.76, 'vs_baseline': 1106.11, 'fmax_mhz': 61.962, 'ipc_coremark': 2e-06, 'cycles': 4238604, 'iterations': 10, 'lut4': 3095, 'ff': 644, 'seeds': [58.897, 61.962, 61.962], 'perturbations': [[0, 58.897, 15], [1, 61.962, 15], [2, 61.962, 15]], 'lutram': 16, 'bsram': 6, 'dsp': 6, 'critical_path': {'from': 'cpu/u_rf/regs_regs_0_0_s', 'to': 'dmem_0_dmem_0_0_0_s', 'slack_ns': -11.979, 'arrival_ns': 22.273, 'logic_cells': 15, 'modules': ['clock_ibuf', 'cpu/u_id', 'cpu/u_ex', 'cpu/u_ex/u_alu', 'cpu/u_ex']}, 'logic_levels': 15, 'formal_passed': True, 'cosim_passed': True, 'error': None, 'implementation_notes': '', 'timestamp': '2026-11-22T22:55:20.574239Z', 'slot': 1, 'round_id': 4}\n", "exit_code": 0, "status": "completed"}}
