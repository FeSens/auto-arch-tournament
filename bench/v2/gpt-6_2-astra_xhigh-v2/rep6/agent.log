{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/operand-matrix.py\" <<'\"'PY'\nimport os,sys,shutil\nfrom pathlib import Path\nname=sys.argv[1]\nrtl=Path(os.environ['TMPDIR'])/name/'rtl'\nshutil.copytree('cores/bench/rtl',rtl)\ndef sub(f,fr,to):\n p=rtl/f;t=p.read_text();assert fr in t,fr;t=t.replace(fr,to);p.write_text(t)\ndef section(f,start,end,new):\n p=rtl/f;t=p.read_text();i=t.index(start);j=t.index(end,i);p.write_text(t[:i]+new+t[j:])\n# Raw RF with x0 dealt with on grants. Preserve public reg_file behavior for unit tests using param\nsub('reg_file.sv','module reg_file (','module reg_file #(parameter RAW_READ = 0) (')\nsub('reg_file.sv','if (rs1_addr ==', 'if (RAW_READ) rs1_data = regs[rs1_addr];\\\\n    else if (rs1_addr ==')\nsub('reg_file.sv','if (rs2_addr ==', 'if (RAW_READ) rs2_data = regs[rs2_addr];\\\\n    else if (rs2_addr ==')\nsub('core.sv','reg_file u_rf','reg_file #(.RAW_READ(1)) u_rf')\n# Compute youngest effective producer tags using same valid/trap ctrl as EX/MEM and MEM/WB will record.\nsub('mem_stage.sv','output mem_wb_t  out','output logic next_wen,\\\\n  output mem_wb_t  out')\nsub('mem_stage.sv','assign out =','assign next_wen = ctrl_with_trap.reg_write && in.valid;\\\\n  assign out =')\nsub('ex_stage.sv','output ex_mem_t  out,','output ex_mem_t  out,\\\\n  output logic next_wen,')\nsub('ex_stage.sv','assign out =','assign next_wen = ctrl_with_trap.reg_write && in.valid && \"'!div_wait;'\"\\\\n  assign out =')\n# Add fourth data port, which is the old WB\nsub('core.sv','logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', 'logic [3:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n  logic [31:0] old_wb_data;\\\\n  logic ex_next_wen, mem_next_wen;')\nsub('core.sv','.out             (ex_mem_w),','.out             (ex_mem_w),\\\\n    .old_wb (old_wb_data),\\\\n    .next_wen (ex_next_wen),')\nsub('core.sv','.out        (mem_wb_w)', '.next_wen (mem_next_wen),\\\\n    .out        (mem_wb_w)')\nsub('ex_stage.sv','input  logic [1:0]         fwd_', 'input  logic [3:0]         fwd_')\nsub('ex_stage.sv','input  logic [31:0]        fwd_ex_mem,', 'input  logic [31:0] old_wb,\\\\n  input  logic [31:0]        fwd_ex_mem,')\nsection('ex_stage.sv','  always_comb begin','  // ── ALU operand', ''.join(f'''  assign rs{i} = ({{32{{fwd_rs{i}_sel[0]}}}} & in.rs{i}_val)\n             | ({{32{{fwd_rs{i}_sel[1]}}}} & old_wb)\n             | ({{32{{fwd_rs{i}_sel[2]}}}} & fwd_mem_wb)\n             | ({{32{{fwd_rs{i}_sel[3]}}}} & fwd_ex_mem);\n''' for i in (1,2))+'\\\\n')\nsection('core.sv','  forward_unit u_fwd (','  // ── RVFI', '''  function automatic logic [3:0] grants(input logic [4:0] src);\n    logic take_ex, take_mem, take_wb;\n    begin\n      take_ex = ex_next_wen && id_ex_w.rd == src;\n      take_mem = mem_next_wen && ex_mem_w.rd == src;\n      take_wb = wb_w_en && wb_w_addr == src;\n      if (src == 0) grants = 4'b0;\n      else grants = {take_ex, \"'!take_ex && take_mem, !take_ex && !take_mem && take_wb,\n                     !take_ex && !take_mem && !take_wb};\n    end\n  endfunction\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      fwd_rs1_sel <= grants(rs1_addr_w);\n      fwd_rs2_sel <= grants(rs2_addr_w);\n      old_wb_data <= wb_w_data;\n    end\n  end\n\n'\"''')\nPY\npython \\\"\"'$TMPDIR/operand-matrix.py\" operand_matrix\nPYTHONPATH=. python \"$TMPDIR/bench_timing.py\" operand_matrix'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
