\"FORMAL_MIN_CHECKS\", \"50\"))\n\n\n# Patterns that prove SBY actually executed at least one check before the\n# post-run `*.sby` glob came up empty. Any one of these in the output\n# means `no_checks_generated` is the wrong label — checks DID generate,\n# they just got wiped or interrupted between SBY's output and the tally.\n_SBY_RAN_PATTERNS = (\n    re.compile(r'^SBY \\d+:\\d+\n…[3243 of 6315 chars elided by tools/bench/transcript.py; sha256:7645f9d1d48c588c]…\ned': False, 'failed_check': name, 'detail': str}\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    run_script = worktree_path / \"formal\" / \"run_all.sh\"\n    if not run_script.exists():\n        return {'passed': False, 'failed_check': 'setup',\n                'detail': f'formal/run_all.sh missing in {worktree}'}\n\n    env = _build_formal_env(worktree_path, target)\n    # Pin the work dir name so exactly this run's dir is removed in\n    # `finally`, once the tally (or failing-check log tail) is captured.\n    work_id = \"h\" + uuid.uuid4().hex[:15]\n    env = {**env, \"FORMAL_WORK_ID\": work_id}\n    try:\nSBY  1:10:27 [insn_xori_ch0] smt2: finished (returncode=0)\nSBY  1:10:27 [insn_xori_ch0] engine_0: starting process \"cd insn_xori_ch0; yosys-smtbmc -s bitwuzla --presat -\nSBY  1:10:28 [insn_xori_ch0] engine_0: ##   0:00:00  Solver: bitwuzla\nSBY  1:10:28 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 0..\nSBY  1:10:28 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 1..\nSBY  1:10:28 [insn_xori_ch0] engi\n", "exit_code": 0, "status": "completed"}}
