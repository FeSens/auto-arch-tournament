{"type": "item.started", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/forward.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,os,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1];base=Path(os.environ['TMPDIR'])/('r9-'+tag)\np=base/'rtl';shutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\n# Use complete early one-hot selects. Producer records from EX and MEM are\n# the post-trap, post-bubble controls that advance into those respective stages.\nedit('ex_stage.sv','  output logic               div_wait,','  output logic               next_we,\\\\n  output logic               div_wait,')\nedit('ex_stage.sv','  assign out = reg_q;', '  assign next_we = \"'!reset && !div_wait && !replay && ctrl_with_trap.reg_write;'\"\\\\n  assign out = reg_q;')\nedit('mem_stage.sv','  output logic               load_hit,','  output logic               next_wb_we,\\\\n  output logic               load_hit,')\nedit('mem_stage.sv','  assign out = reg_q;', '  assign next_wb_we = \"'!reset && ctrl_with_trap.reg_write;'\"\\\\n  assign out = reg_q;')\nedit('core.sv','  logic       div_wait;', '  logic       next_we, next_wb_we;\\\\n  logic       div_wait;')\nedit('core.sv','    .div_wait        (div_wait),','    .next_we         (next_we),\\\\n    .div_wait        (div_wait),')\nedit('core.sv','    .load_hit       (load_hit),','    .next_wb_we     (next_wb_we),\\\\n    .load_hit       (load_hit),')\nfor i in (1,2):\n edit('core.sv',f'  forward_unit u_fwd_rs{i} (',f'  forward_unit u_fwd_rs{i} (\\\\n    .reset (reset),\\\\n    .held_rs (id_ex_w.rs{i}_addr),\\\\n    .mem_we (next_we),\\\\n    .wb_we (next_wb_we),\\\\n    .load (id_ex_w.ctrl.mem_read),')\nedit('core.sv','    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\\\\n    .ex_mem_load (ex_mem_w.ctrl.mem_read),\\\\n    .mem_wb_w_en (mem_wb_w.ctrl.reg_write),','')\nf=p/'forward_unit.sv';s=f.read_text().replace('  input  logic       clock,','''  input logic reset, mem_we, wb_we, load,\n  input logic [4:0] held_rs,\n  input  logic       clock,''')\ns=s.replace('  input  logic       ex_mem_w_en,\\\\n  input  logic       ex_mem_load,\\\\n  input  logic       mem_wb_w_en,','')\ns=s[:s.index('  logic mem_match_q')]+'''\n  wire mem_match = id_ex_rd \"'!= 0 && id_ex_rd == decode_rs && mem_we;\n  wire wb_match = ex_mem_rd != 0 && ex_mem_rd == decode_rs && wb_we;\n  wire wb_held = ex_mem_rd != 0 && ex_mem_rd == held_rs && wb_we;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sel <= '\"'0;\n    end else if (\"'!hold_mem) begin\n      if (hold_id) begin\n        sel.ex_mem <= 0;\n        sel.load_word <= 0;\n        sel.mem_wb <= wb_held;\n        sel.captured <= !wb_held;\n      end else begin\n        sel.ex_mem <= mem_match && !load;\n        sel.load_word <= mem_match && load;\n        sel.mem_wb <= !mem_match && wb_match;\n        sel.captured <= !mem_match && !wb_match;\n      end\n    end\n  end\nendmodule\n'\"'''\nf.write_text(s)\nif tag.startswith('fwdalu'):\n # Give AUIPC its own PC sum. ALU operand A then can use rs1 directly.\n edit('ex_stage.sv','alu_a = in.ctrl.is_auipc ? in.pc  : rs1;','alu_a = rs1;')\n edit('ex_stage.sv',': alu_result;',': in.ctrl.is_auipc ? in.pc + in.imm : alu_result;')\n # Hide the ALU operand B mux behind per-source masks.\n edit('ex_stage.sv','alu_b = in.ctrl.alu_src  ? in.imm : rs2;','''alu_b = ({32{in.ctrl.alu_src}} & in.imm)\n          | ({32{\"'!in.ctrl.alu_src && fwd_rs2_sel.captured}} & in.rs2_val)\n          | ({32{!in.ctrl.alu_src && fwd_rs2_sel.ex_mem}} & fwd_ex_mem)\n          | ({32{!in.ctrl.alu_src && fwd_rs2_sel.mem_wb}} & fwd_mem_wb)\n          | ({32{!in.ctrl.alu_src && fwd_rs2_sel.load_word}} & predicted_word);'\"''')\nif tag.endswith('onehot'):\n edit('ex_stage.sv','operand = sel.load_word ? predicted_word\\\\n              : (','operand = ({32{sel.load_word}} & predicted_word) | (')\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/forward.py\" fwd'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
