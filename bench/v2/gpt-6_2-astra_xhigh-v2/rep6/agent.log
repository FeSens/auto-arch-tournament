{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/early.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1];base=Path(os.environ['TMPDIR'])/('r9-'+tag);p=base/'rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\nedit('mem_stage.sv','  output logic               load_hit,','  output logic               pre_wen,\\\\n  output logic [31:0]        pre_data,\\\\n  output logic               load_hit,')\nedit('mem_stage.sv','  assign out = reg_q;', '''  assign pre_wen = ctrl_with_trap.reg_write && in.valid && in.rd \"'!= 0;\n  assign pre_data = in.ctrl.mem_to_reg ? load_data : is_mul(in.ctrl.alu_op) ? mul_result : in.alu_result;\n  assign out = reg_q;'\"''')\nedit('core.sv','  logic       div_wait;', '  logic       pre_wen;\\\\n  logic [31:0] pre_data;\\\\n  logic       div_wait;')\nedit('core.sv','    .load_hit       (load_hit),','    .pre_wen        (pre_wen),\\\\n    .pre_data       (pre_data),\\\\n    .load_hit       (load_hit),')\nfor n in (1,2):\n edit('core.sv',f'    .rs{n}_data (rs{n}_data_w),', f'    .rs{n}_data (pre_wen && ex_mem_w.rd == rs{n}_addr_w ? pre_data : rs{n}_data_w),') if False else None\n # only modify the ID inputs, keep RF output pins going to named nets\n f=p/'core.sv';s=f.read_text().replace(f'    .rs{n}_data (rs{n}_data_w),', f'    .rs{n}_data (pre_wen && ex_mem_w.rd == rs{n}_addr_w && \"'!stall_ex_mem ? pre_data : rs{n}_data_w),'\"',1);f.write_text(s)\n# During memory freeze, captured operands must retain the early bypass that\n# was in WB when the freeze began. Snoop WB via existing write-first RF.\n# With RF read address pointing at held instruction, old WB writes become\n# visible immediately so recapture during hold is okay. For replay load,\n# MEM completes -> ID captures correct load at its accepting edge.\nedit('ex_stage.sv', '''operand = sel.load_word ? predicted_word\n              : (({32{sel.captured}} & captured)\n               | ({32{sel.mem_wb}}   & fwd_mem_wb)\n               | ({32{sel.ex_mem}}   & fwd_ex_mem));''', \n'''operand = sel.load_word ? predicted_word : sel.ex_mem ? fwd_ex_mem : captured;''')\nif 'mux' in tag:\n edit('ex_stage.sv','operand = sel.load_word ? predicted_word : sel.ex_mem ? fwd_ex_mem : captured;',\n      '''operand = (captured & {32{\"'!(sel.ex_mem || sel.load_word)}})\n                | (fwd_ex_mem & {32{sel.ex_mem}})\n                | (predicted_word & {32{sel.load_word}});'\"''')\nif 'simplify' in tag:\n edit('mem_stage.sv','reg_q.alu_result <= is_mul(in.ctrl.alu_op) ? mul_result : in.alu_result;','reg_q.alu_result <= pre_data;')\n edit('wb_stage.sv','w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;', 'w_data = in.alu_result;')\nif 'late' in tag:\n # Select speculative data for hits and late results from WB in EX. Ordinary\n # integer bypass is early, so no long late MEM operation feeds RF in ID.\n edit('mem_stage.sv','assign pre_wen = ctrl_with_trap.reg_write && in.valid && in.rd \"'!= 0;'\"', 'assign pre_wen = \"'!in.ctrl.mem_read && !is_mul(in.ctrl.alu_op) && ctrl_with_trap.reg_write && in.valid && in.rd != 0;'\"')\n edit('mem_stage.sv','assign pre_data = in.ctrl.mem_to_reg ? load_data : is_mul(in.ctrl.alu_op) ? mul_result : in.alu_result;', 'assign pre_data = in.alu_result;')\n edit('ex_stage.sv',' : captured;', ' : sel.mem_wb ? fwd_mem_wb : captured;')\n edit('core.sv','.mem_wb_w_en (mem_wb_w.ctrl.reg_write)', '.mem_wb_w_en (mem_wb_w.ctrl.reg_write && (mem_wb_w.ctrl.mem_read || is_mul(mem_wb_w.ctrl.alu_op)))')\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/early.py\" early'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
