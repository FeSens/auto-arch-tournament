_REM || in.ctrl.alu_op == ALU_REMU);\n   assign div_wait = is_div && !div_resp_valid;\n   assign ex_enable = !stall && !replay;\n   assign div_req_valid = div_wait && ex_enable;\n+  assign div_transfer = is_div && div_resp_valid && ex_enable;\n \n   // Forwarding sources can drain while ID/E\n…[6666 of 9738 chars elided by tools/bench/transcript.py; sha256:f3b61151e13d9748]…\nreg_q.branch_equal       <= dec_is_branch && !dec_branch_op[2];\n+      reg_q.branch_signed_lt   <= dec_is_branch && dec_branch_op[2:1] == 2'b10;\n+      reg_q.branch_unsigned_lt <= dec_is_branch && dec_branch_op[2:1] == 2'b11;\n+      reg_q.take_if_false      <= dec_is_jump || (dec_is_branch && dec_branch_op[0]);\n+      reg_q.ctrl <= ctrl_decoded;\n       reg_q.is_fence_i          <= is_fence_i;\n       reg_q.recover_fallthrough <= in.predicted_taken || is_fence_i;\n       reg_q.direction_counter <= in.direction_counter;\n     end\n \n-    // Only validity and controls need killing. Raw decode and operand\n-    // capture can proceed independently of the EX correction.\n-    if (reset) begin\n-      reg_q.valid <= 1'b0;\n-      reg_q.ctrl  <= '0;\n-    end else if (!stall) begin\n-      reg_q.valid <= in.valid && !flush;\n-      reg_q.ctrl  <= (in.valid && !flush) ? ctrl_decoded : '0;\n-    end\n+    if (reset)       reg_q.valid <= 1'b0;\n+    else if (!stall) reg_q.valid <= in.valid && !flush;\n   end\n \n   assign out = reg_q;\n", "exit_code": 0, "status": "completed"}}
