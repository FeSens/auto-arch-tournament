──────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic        is_div, div_req_valid, div_req_ready, div_resp_valid, ex_enable;\n  logic [31:0] div_result, div_rs1_q, div_rs2_q;\n  logic [31:0] alu_result;\n\n  assign is_\n…[6997 of 10069 chars elided by tools/bench/transcript.py; sha256:b1c16f679b14a68d]…\n\n                                    || is_mul(id_ex_w.ctrl.alu_op))),\n    .id_ex_rd       (id_ex_w.rd),\n    .if_id_rs1      (if_id_w.instr[19:15]),\n    .if_id_rs2      (if_id_w.instr[24:20]),\n    .redirect       (redirect),\n    .fetch_available (if_id_w.valid),\n    .dmem_ready     (io_dmemReady),\n    .bus_request    (io_dmemREn || (|io_dmemWEn)),\n    .replay         (replay),\n    .div_wait       (div_wait),\n    .stall_if       (stall_if),\n    .stall_id       (stall_id),\n    .flush_id       (flush_id),\n    .stall_ex_mem   (stall_ex_mem),\n    .hold_mem_wb    (hold_mem_wb)\n  );\n\n  forward_unit u_fwd_rs1 (\n    .clock       (clock),\n    .hold_id     (stall_id),\n    .hold_mem    (stall_ex_mem),\n    .decode_rs   (if_id_w.instr[19:15]),\n    .id_ex_rd    (id_ex_w.rd),\n    .ex_mem_rd   (ex_mem_w.rd),\n    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\n    .ex_mem_load (ex_mem_w.ctrl.mem_read),\n    .mem_wb_w_en (mem_wb_w.ctrl.reg_write),\n    .sel         (fwd_rs1_sel)\n  );\n\n  forward_unit u_fwd_rs2 (\n    .clock       (clock),\n", "exit_code": 0, "status": "completed"}}
