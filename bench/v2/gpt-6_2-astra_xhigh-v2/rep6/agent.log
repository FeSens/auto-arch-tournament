{"type": "item.started", "item": {"id": "item_75", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/dualrad/rtl\" && cp cores/bench/rtl/*.sv \"$TMPDIR/dualrad/rtl/\"\ncat > \"$TMPDIR/loadstage/rad.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom os import environ\np=Path(environ['TMPDIR'])/'dualrad/rtl/alu.sv'\ns=p.read_text()\na=s.index('  logic signed_op');b=s.index('\\\\n\"'`endif'\"',a)\ns=s[:a]+\\\"\\\"\\\"  logic signed_op, rem_op, neg_a, neg_b, small_q, zero_q, rem_q;\n  logic [31:0] amag, bmag, divisor_q, dividend_q;\n  assign signed_op = (op == ALU_DIV) || (op == ALU_REM);\n  assign rem_op = (op == ALU_REM) || (op == ALU_REMU);\n  assign neg_a = signed_op && a[31];\n  assign neg_b = signed_op && b[31];\n  assign amag = neg_a ? -a : a;\n  assign bmag = neg_b ? -b : b;\n\n  logic [31:0] sq;\n  logic [15:0] sr;\n  logic [19:0] sm [0:15];\n  logic [19:0] odd_reg [1:7];\n  logic [19:0] sd, sp;\n  assign sd = {4'b0,divisor_q[15:0]};\n  assign sp = {sr,sq[31:28]};\n  assign sm[0] = '0;\n  assign sm[1] = sd;\n  for (genvar n=2;n<16;n++) begin\n    if (n%2==0) assign sm[n] = sm[n/2]<<1;\n    else assign sm[n] = odd_reg[n/2];\n  end\n  function automatic [19:0] add3(input logic [19:0] x,y,z);\n    add3 = (x\"'^y''^z) + (((x&y)|(x&z)|(y&z))<<1);\n  endfunction\n  always_ff @(posedge clock) begin\n    if (phase_q[0]) begin\n      odd_reg[1] <= (sd<<1) + sd;\n      odd_reg[2] <= (sd<<2) + sd;\n      odd_reg[3] <= (sd<<3) - sd;\n      odd_reg[4] <= (sd<<3) + sd;\n      odd_reg[5] <= add3(sd<<3,sd<<1,sd);\n      odd_reg[6] <= add3(sd<<3,sd<<2,sd);\n      odd_reg[7] <= (sd<<4)-sd;\n    end\n  end\n  logic [15:0] sfit, swinner;\n  logic [3:0] digit;\n  logic [15:0] parts [0:15];\n  logic [15:0] srnext;\n  assign sfit[0] = 1'\"'b1;\n  assign swinner = sfit & ~(sfit>>1);\n  assign parts[0] = sp[15:0] & {16{swinner[0]}};\n  for (genvar i=1; i<16; i++) begin\n    logic [20:0] diff;\n    assign diff = {1'b0,sp} - {1'b0,sm[i]};\n    assign sfit[i] = \"'!diff[20];\n    assign parts[i] = diff[15:0] & {16{swinner[i]}};\n  end\n  always_comb begin\n    srnext = '\"'0;\n    for(int i=0; i<16; i++) srnext |= parts[i];\n  end\n  assign digit = {sfit[8], (sfit[4] && \"'!sfit[8]) || sfit[12],\n                  (sfit[2] && !sfit[4]) || (sfit[6] && !sfit[8]) ||\n                  (sfit[10] && !sfit[12]) || sfit[14], |(swinner & 16'\"'haaaa)};\n\n  logic [7:0] prefix [0:15];\n  logic [7:0] sfirst;\n  assign prefix[0] = '0;\n  for (genvar d=1; d<16; d++) begin\n    wire [7:0] e[0:15];\n    for (genvar n=0;n<16;n++) assign e[n] = {4'(n/d),4'(n%d)};\n    assign prefix[d] = e[dividend_q[31:28]];\n  end\n  assign sfirst = (|divisor_q[15:4]) ? {4'b0,dividend_q[31:28]} : prefix[divisor_q[3:0]];\n\n  logic [15:0] lq;\n  logic [29:0] lr;\n  logic [31:0] lp, lrnext;\n  logic [33:0] ld3;\n  logic [34:0] ldiff1,ldiff2,ldiff3;\n  logic [1:0] ldigit;\n  assign lp = {lr,lq[15:14]};\n  assign ldiff1 = {3'd0,lp} - {3'd0,divisor_q};\n  assign ldiff2 = {3'd0,lp} - {2'd0,divisor_q,1'b0};\n  assign ldiff3 = {3'd0,lp} - {1'b0,ld3};\n  assign ldigit = {\"'!ldiff2[34], (!ldiff1[34] && ldiff2[34]) || !ldiff3[34]};\n  assign lrnext = (lp & {32{ldiff1[34]}}) |\n                  (ldiff1[31:0] & {32{!ldiff1[34] && ldiff2[34]}}) |\n                  (ldiff2[31:0] & {32{!ldiff2[34] && ldiff3[34]}}) |\n                  (ldiff3[31:0] & {32{!ldiff3[34]}});\n  // The setup numerator contains only the highest 18 dividend bits.\n  logic [17:0] first_r;\n  logic [1:0] first_d;\n  logic [18:0] hi1,hi2,hi3;\n  logic [19:0] three_prefix;\n  assign three_prefix = {2'\"'b0,divisor_q[17:0]} + {1'b0,divisor_q[17:0],1'b0};\n  assign hi1 = {1'b0,dividend_q[31:14]} - {1'b0,divisor_q[17:0]};\n  assign hi2 = {1'b0,dividend_q[31:14]} - {divisor_q[17:0],1'b0};\n  assign hi3 = {1'b0,dividend_q[31:14]} - {1'b0,three_prefix[17:0]};\n  logic fit1, fit2, fit3;\n  assign fit1 = divisor_q[31:18] == 0 && \"'!hi1[18];\n  assign fit2 = divisor_q[31:17] == 0 && !hi2[18];\n  assign fit3 = 