{"type": "item.completed", "item": {"id": "item_87", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Each accepted PC looks up its last observed successor for the next\n// cycle. Live fetches also precompute the successor's direct target.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX corrects fetch\n  input  logic [31:0]       redirect_target,\n  input  logic              fence_i,\n  input  logic              train_en,\n  input  logic [6:0]        train_index,\n  input  logic [1:0]        train_counter,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [1:0]  counters [0:127];\n  logic [1:0]  counter;\n  logic [31:0] displacement, live_target;\n  logic        target_ok, live_branch, live_jal, predicted_taken;\n\n  typedef struct packed {\n    logic [17:0] pc_word;\n    logic [31:0] instr;\n    logic [17:0] target_word;\n    logic        jal;\n    logic        branch;\n  } successor_t;\n\n  // A flat memory word lets Gowin infer block RAM. The registered read\n  // port uses the packed type to name the fields.\n  (* syn_ramstyle = \"block_ram\" *) logic [69:0] successors [0:511];\n  successor_t  candidate;\n  logic [511:0] occupied;\n  logic [8:0]  index_now, prev_index;\n  logic        prev_valid, candidate_valid, hit, accept, fill, can_fill;\n  logic [17:0] predicted_target_word;\n\n  initial begin\n    for (int i = 0; i < 128; i++) counters[i] = 2'b01;\n  end\n\n  assign counter = c\n…[1898 of 4970 chars elided by tools/bench/transcript.py; sha256:736ca30e5149f15c]…\nison. Decode,\n  // source-register interlocking, and direction selection run in parallel.\n  assign hit = candidate_valid && {12'b0, candidate.pc_word, 2'b00} == pc;\n  assign predicted_taken = imem_ready ? (live_jal || (live_branch && counter[1]))\n                                      : (candidate.jal || (candidate.branch && counter[1]));\n  assign predicted_target_word = imem_ready ? live_target[19:2] : candidate.target_word;\n\n  // A correction commits even when imem cannot deliver the younger slot.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= predicted_taken ? {12'b0, predicted_target_word, 2'b00} : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc                = pc;\n    out.instr             = imem_ready ? imem_data : candidate.instr;\n    out.predicted_taken   = predicted_taken;\n    out.direction_counter = counter;\n    out.valid             = imem_ready || hit;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_86", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/core_pkg.sv'", "aggregated_output": "// rtl/core_pkg.sv\n//\n// Core-wide constants and pipeline-bundle types.\n//\n// Compilation-unit scope (no `package … endpackage` wrapper) because\n// Yosys's Verilog frontend rejects `import pkg::*;` even though it\n// accepts `pkg::sym` refs and package definitions. A file-scope\n// definition with an `\\`ifndef` guard is the lowest common denominator\n// across Verilator, Yosys, sby, and nextpnr-himbaechel.\n//\n// Order matters: this file MUST be the first source passed to any tool\n// (Verilator/cocotb runner / build.sh / formal staging). Subsequent\n// includes hit the guard and become no-ops.\n//\n// Latency:        n/a (declarations only).\n// RVFI fields:    none (defines types; no logic).\n`ifndef CORE_PKG_DEFINED\n`define CORE_PKG_DEFINED\n\n  // ── ALU operations ──────────────────────────────────────────────────────\n  localparam logic [4:0] ALU_ADD    = 5'd0;\n  localparam logic [4:0] ALU_SUB    = 5'd1;\n  localparam logic [4:0] ALU_AND    = 5'd2;\n  localparam logic [4:0] ALU_OR     = 5'd3;\n  localparam logic [4:0] ALU_XOR    = 5'd4;\n  localparam logic [4:0] ALU_SLT    = 5'd5;\n  localparam logic [4:0] ALU_SLTU   = 5'd6;\n  localparam logic [4:0] ALU_SLL    = 5'd7;\n  localparam logic [4:0] ALU_SRL    = 5'd8;\n  localparam logic [4:0] ALU_SRA    = 5'd9;\n  localparam logic [4:0] ALU_LUI    = 5'd10;\n  localparam logic [4:0] ALU_MUL    = 5'd11;\n  localparam logic [4:0] ALU_MULH   = 5'd12;\n  localparam logic [4:0] ALU_MULHU  = 5'd13;\n  localparam logic [4:0] ALU_MULHSU = 5'd14;\n  localparam logic [4:0] ALU_DIV    = 5'd15;\n  localparam logic [4:0] ALU_DIVU   = 5'd16;\n  localparam logic [4:0] ALU_REM    = 5'd17;\n  localparam logic [4:0] ALU_REMU   = 5'd18;\n\n  function automatic logic is_mul(input logic [4:0] op);\n    is_mul = (op == ALU_MUL)   || (op == ALU_MULH) ||\n             (op == ALU_MULHU) || (op == ALU_MULHSU);\n  endfunction\n\n  // ── Branch operations (encoded = funct3 of BRANCH opcode) ───────────────\n  // Phase 1 only references BR_BEQ (decoder default). The rest are\n  // referenced by the EX-stage comparator in phase 2\n…[2760 of 5832 chars elided by tools/bench/transcript.py; sha256:87d5248e07cedfe7]…\nrs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;        // post-forward rs1 used by EX\n    logic [31:0] rs2_val;        // post-forward rs2 used by EX\n    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] result;         // completed integer, multiply or load result\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n", "exit_code": 0, "status": "completed"}}
