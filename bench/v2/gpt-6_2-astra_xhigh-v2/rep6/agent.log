{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/address.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1]; base=Path(os.environ['TMPDIR'])/('r9-'+tag);p=base/'rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\nedit('core_pkg.sv','    logic        recover_fallthrough;', '    logic [31:0] pc_relative, pc_plus_four;\\\\n    logic        recover_fallthrough;')\nedit('id_stage.sv','      reg_q.pc       <= in.pc;', '''      reg_q.pc       <= in.pc;\n      reg_q.pc_relative <= in.pc + imm;\n      reg_q.pc_plus_four <= in.pc + 32'd4;''')\nedit('ex_stage.sv','assign fallthrough_pc = in.pc + 32\\\\'d4;', 'assign fallthrough_pc = in.pc_plus_four;')\nedit('ex_stage.sv','assign target_sum = (in.ctrl.is_jalr ? rs1 : in.pc) + in.imm;',\\\"\\\"\\\"wire [31:0] base_imm = rs1 + in.imm;\n  assign target_sum = in.ctrl.is_jalr ? base_imm : in.pc_relative;\\\"\\\"\\\")\nedit('ex_stage.sv','reg_q.effective_addr <= rs1 + in.imm;', 'reg_q.effective_addr <= base_imm;')\nedit('ex_stage.sv','alu_a = in.ctrl.is_auipc ? in.pc  : rs1;', 'alu_a = rs1;')\nif 'split' in tag:\n edit('core_pkg.sv','    logic        recover_fallthrough;', '    logic [31:0] pc_result;\\\\n    logic        recover_fallthrough;')\n edit('id_stage.sv','      reg_q.pc_plus_four <= in.pc + 32\\\\'d4;','      reg_q.pc_plus_four <= in.pc + 32\\\\'d4;\\\\n      reg_q.pc_result <= dec_is_jump ? in.pc + 32\\\\'d4 : in.pc + imm;')\n edit('ex_stage.sv','(in.ctrl.is_jump || div_resp_valid)\\\\n                           ? (in.ctrl.is_jump ? fallthrough_pc : div_result) : alu_result;', '(in.ctrl.is_jump || in.ctrl.is_auipc) ? in.pc_result : div_resp_valid ? div_result : alu_result;')\nelse:\n edit('ex_stage.sv','? (in.ctrl.is_jump ? fallthrough_pc : div_result) : alu_result;', '? (in.ctrl.is_jump ? fallthrough_pc : div_result) : in.ctrl.is_auipc ? in.pc_relative : alu_result;')\nif 'addi' in tag:\n edit('ex_stage.sv','  ex_mem_t reg_q;',\\\"  wire use_addr = (in.ctrl.alu_op == ALU_ADD) && in.ctrl.alu_src && \"'!in.ctrl.is_jump && !in.ctrl.is_auipc;'\"\\\\n  ex_mem_t reg_q;\\\")\n edit('ex_stage.sv',': alu_result;', ': use_addr ? base_imm : alu_result;')\n edit('alu.sv','module alu (','module alu #(parameter SEPARATE_SUM = 0) (')\n edit('alu.sv','  input  logic        clock,','  input  logic [31:0] sum_b,\\\\n  input  logic        clock,')\n edit('alu.sv','ALU_ADD:    out = a + b;', 'ALU_ADD:    out = a + (SEPARATE_SUM ? sum_b : b);')\n edit('ex_stage.sv','  alu u_alu (', '  alu #(.SEPARATE_SUM(1)) u_alu (\\\\n    .sum_b (rs2),')\nif 'direct' in tag:\n # form correct JALR alignment before target selection (PC-relative B/J alignment known in ID).\n edit('ex_stage.sv',\\\"assign aligned_taken  = taken && transfer_target[1:0] == 2'b00;\\\", \\\"wire target_aligned = in.ctrl.is_jalr ? \"'!base_imm[1] : !in.pc_relative[1] && !in.pc_relative[0];'\"\\\\n  assign aligned_taken = taken && target_aligned;\\\")\n edit('ex_stage.sv',\\\"assign misalign_fault = taken && transfer_target[1:0] \"'!= 2'\"'b00;\\\",\\\"assign misalign_fault = taken && \"'!target_aligned;\")\nfor v in build_all(Path.cwd(),p,'\"'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/address.py\" pcbase'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
