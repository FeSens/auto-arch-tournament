{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,random\np=Path(os.environ['TMPDIR'])/'recip13'\nC=1<<34\nM=0xffffffff\ndef ee(n,d):\n s=max(0,d.bit_length()-11)\n k=d>>s\n u=(d<<8>>s)&255\n ri=lambda k:(C+k-1)//k\n return n*(ri(k)-((ri(k)-ri(k+1))*u>>8))>>(34+s)\nhits=good=0; examples=[]\nr=random.Random(1053)\nfor i in range(300000):\n width=r.randrange(2,33)\n d=r.randrange(1<<(width-1),1<<width)\n q=M//d\n n=r.choice([r.randrange(M+1),M,q*d-1,r.randrange(1,q+1)*d-1,q*d])\n e=ee(n,d)\n assert n//d<=e<=n//d+1, (n,d)\n if e*d>n:\n  hits+=1\n  if len(examples)<20: examples.append((n,d))\n else: good+=1\nprint('estimate counts',good,hits,'examples',examples[:4])\nf=p/'test/test_alu.py'\nz=f.read_text()\nz+='''\n\n@cocotb.test()\nasync def reciprocal_boundaries(dut):\n    await _setup(dut)\n    rng = random.Random(1053)\n    divisors = {2, 3, 1023, 1024, 1025, 2047, 2048, 2049, MASK32}\n    for bit in range(2,32):\n        divisors.update((1 << bit) + off for off in (-1, 0, 1))\n    for shift in (1, 2, 4, 8, 9, 15, 21):\n        for k in (1024, 1025, 1537, 2047):\n            for sub in (0, 1, (1<<shift)//2, (1<<shift)-1):\n                divisors.add((k<<shift) + sub)\n    for d in sorted(divisors):\n        q = MASK32 // d\n        for n in (d-1, q*d-1, q*d, MASK32, rng.randrange(1<<32)):\n            for op, result in ((ALU_DIVU, n//d), (ALU_REMU,n%d)):\n                await _check_div(dut,op,n,d,result)\n    for n,d in '''+repr(examples)+''':\n        for op, result in ((ALU_DIVU, n//d), (ALU_REMU, n%d)):\n            await _check_div(dut,op,n,d,result,hold_cycles=2)\n'''\nf.write_text(z)\nPY\ncd \\\"\"'$TMPDIR/recip13\"\npytest --rootdir=\"$PWD\" --confcutdir=\"$PWD\" -q test/test_alu.py > unit-more.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
