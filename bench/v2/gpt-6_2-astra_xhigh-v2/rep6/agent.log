{"type": "item.completed", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'packets_packets_0_0_s' \\\"\"'$TMPDIR\"/loop-check/cores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.vg | head -20; sed -n '\"'1,170p' cores/bench/rtl/if_stage.sv; cat tools/accept_rule.py | head -100\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Direct transfers use the current instruction's displacement. The\n// PC-indexed table predicts only conditional branch direction.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX corrects fetch\n  input  logic [31:0]       redirect_target,\n  input  logic              fence_restart,\n  input  logic              store_accepted,\n  input  logic [31:2]       store_word_addr,\n  input  logic              train_en,\n  input  logic [6:0]        train_index,\n  input  logic [1:0]        train_counter,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [1:0]  counters [0:127];\n  logic [1:0]  counter;\n  logic [31:0] displacement, live_target, target;\n  logic        is_branch, is_jal, live_target_ok, predicted_taken;\n\n  // A short backward edge identifies an inclusive interval. Within one\n  // interval every word has a unique index, even across a 256-byte boundary.\n  logic        window_valid;\n  logic [31:0] head, tail;\n  logic [63:0] filled;\n  logic [5:0]  index;\n  logic        in_window, hit, fill, replace_window, store_overlaps;\n  typedef struct packed {\n    logic [31:0] instr;\n    logic [31:0] target;\n    logic        branch_ok;\n    logic        jal_ok;\n  } packet_t;\n  packet_t cached;\n  // Use a vector RAM so Gowin infers the memory behind the packed view.\n  logic [$bi\n…[5756 of 8828 chars elided by tools/bench/transcript.py; sha256:73ed5defecd3f3c1]…\ne:\n        return False\n    return perf >= coremark_target and lut <= lut_target\n\n\ndef _strict_pareto(old, new) -> bool:\n    \"\"\"new strictly dominates old on (perf, lut)?\n\n    Tuples are (perf, lut). Higher perf is better; lower lut is better.\n    Strict dominance: at least as good on both, strictly better on one.\n    \"\"\"\n    op, ol = old\n    np, nl = new\n    not_worse = (np >= op) and (nl <= ol)\n    strictly_better = (np > op) or (nl < ol)\n    return not_worse and strictly_better\n\n\ndef accept(old: tuple,\n           new: tuple,\n           coremark_target: Optional[float] = None,\n           lut_target: Optional[float] = None) -> bool:\n    \"\"\"Accept rule. old/new are (perf, lut) tuples. Either component may be\n    None when the corresponding axis is unconstrained.\n\n    Three modes, dispatched by which targets are set:\n      - No targets:    pure fitness comparison (today's behavior).\n      - One target:    deficit while below; max-axis past target.\n      - Two targets:   phase-1 deficit, phase-2 strict Pareto.\n", "exit_code": 0, "status": "completed"}}
