ms/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/pro\n…[2515 of 5587 chars elided by tools/bench/transcript.py; sha256:cfee372f7cc4067f]…\nrd or verified successor\ncores/bench/rtl/hazard_unit.sv:40:  assign stall_if     = stall_id || use_hazard || !fetch_available;\ncores/bench/rtl/ex_stage.sv:28:  output logic               fence_i,\ncores/bench/rtl/ex_stage.sv:134:  logic is_fence_i;\ncores/bench/rtl/ex_stage.sv:135:  assign is_fence_i      = in.instr[6:0] == 7'b0001111 && in.instr[14:12] == 3'b001;\ncores/bench/rtl/ex_stage.sv:136:  assign fence_i         = in.valid && !stall && is_fence_i;\ncores/bench/rtl/ex_stage.sv:137:  assign redirect        = in.valid && !stall && ((in.predicted_taken ^ aligned_taken) || is_fence_i);\ncores/bench/rtl/ex_stage.sv:138:  assign redirect_target = (in.predicted_taken || is_fence_i) ? fallthrough_pc : transfer_target;\ncores/bench/rtl/core.sv:87:  logic        fence_i;\ncores/bench/rtl/core.sv:106:    .imem_ready      (io_imemReady),\ncores/bench/rtl/core.sv:109:    .fence_i         (fence_i),\ncores/bench/rtl/core.sv:156:    .fence_i         (fence_i),\ncores/bench/rtl/core.sv:193:    .fetch_available(if_id_w.valid),\n", "exit_code": 0, "status": "completed"}}
