{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c 'D=\"$TMPDIR/recip13\"\ncat > \"$D/twopass.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\ns=Path(__file__).parent\nr=s/'rtltwo';shutil.copytree(s/'rtl',r)\np=r/'alu.sv';t=p.read_text()\na=t.index('  logic [39:0] normalized;')\nb=t.index('\"'`endif'\"',a)\nt=t[:a]+\\\"\\\"\\\"  logic [31:0] shifted_divisor;\n  logic [10:0] index_q;\n  logic [31:0] scaled_n_q, reciprocal_q;\n  assign shifted_divisor = (divisor-1'b1) >> exponent;\n  always_ff @(posedge clock) begin\n    exp_q <= exponent;\n    index_q <= shifted_divisor[10:0];\n    scaled_n_q <= numerator >> exponent;\n  end\n  (* syn_ramstyle=\\\"block_ram\\\" *) logic [31:0] inverse_rom [0:2047];\n  initial begin\n    for (int i=0;i<1024;i++) begin\n      inverse_rom[i]      = 32'hffffffff / (i+1);\n      inverse_rom[1024+i] = 32'hffffffff / (i+1025);\n    end\n  end\n  logic [63:0] first_estimate, second_estimate;\n  logic [31:0] first_product, second_product, first_r, first_r_q, scaled_r;\n  logic [31:0] both_digits, second_r;\n  assign first_r = numerator - first_product;\n  assign second_r = first_r_q - second_product;\n  always_ff @(posedge clock) begin\n    reciprocal_q <= inverse_rom[index_q];\n    first_estimate <= scaled_n_q * reciprocal_q;\n    first_product <= first_estimate[63:32] * divisor;\n    first_r_q <= first_r;\n    scaled_r <= first_r >> exp_q;\n    second_estimate <= scaled_r * reciprocal_q;\n    second_product <= second_estimate[63:32] * divisor;\n    both_digits <= first_estimate[63:32] + second_estimate[63:32];\n  end\n  logic [32:0] three_way;\n  logic [31:0] first_minus_d;\n  always_ff @(posedge clock) first_minus_d <= first_r - divisor;\n  assign three_way = {1'b0,first_r_q} - {1'b0, second_product} - {1'b0,divisor};\n  always_comb begin\n    if (zero_q) div_magnitude = rem_q ? numerator : 32'hffffffff;\n    else if (one_q) div_magnitude = rem_q ? 32'd0 : numerator;\n    else if (rem_q) div_magnitude = three_way[32] ? second_r : three_way[31:0];\n    else div_magnitude = both_digits + 32'(\"'!three_way[32]);\n  end\n\"\"\"+t[b:]\n# The two residual and quotient subtracts are formed from their stable pipelined operands.\nt=t.replace('\"'logic [31:0] first_minus_d;', 'logic [32:0] first_minus_d;').replace('first_minus_d <= first_r - divisor;', \\\"first_minus_d <= {1'b0,first_r} - {1'b0,divisor};\\\").replace(\\\"assign three_way = {1'b0,first_r_q} - {1'b0, second_product} - {1'b0,divisor};\\\", \\\"assign three_way = first_minus_d - {1'b0, second_product};\\\")\np.write_text(t)\nPY\npython \\\"\"'$D/twopass.py\"\nPYTHONPATH=. python \"$D/timing_run.py\" 1 two'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
