{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'successor_trial/cores/bench/test/test_pipeline.py'\ns=p.read_text().replace('bus_ready=None, stores=None):','bus_ready=None, stores=None, poison=False, unified=False):')\ns=s.replace('dut.io_imemData.value = imem.get(ia & ~3, EBREAK())','dut.io_imemData.value = SW(0,0,100) if poison and not iready else imem.get(ia & ~3, EBREAK())')\ns=s.replace('            dmem[wa] = new','            dmem[wa] = new\\\\n            if unified:\\\\n                imem[wa] = new')\ns += '''\n@cocotb.test()\nasync def predict_branch_jump_and_target_through_imem_stall(dut):\n    prog = [ADDI(1,0,8), ADDI(1,1,-1), JAL(5,8), SW(1,0,100), BNE(1,0,-12), EBREAK()]\n    visits = 0\n    stores = []\n    def ready(pc, mem):\n        nonlocal visits\n        if pc == 4:\n            visits += 1\n        return visits < 4 or pc not in (4,8,16), True\n    rets, _ = await _run(dut, prog, bus_ready=ready, stores=stores, poison=True)\n    assert [r[\\\"pc\\\"] for r in rets] == [0] + [4,8,16]*8 + [20]\n    assert not stores\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 4] == list(reversed(range(8)))\n    assert all(r[\\\"rd_wdata\\\"] == 12 for r in rets if r[\\\"pc\\\"] == 8)\n    for r, q in zip(rets[10:-2], rets[11:-1]):\n        assert r[\\\"cycle\\\"] + 1 == q[\\\"cycle\\\"]\n\n@cocotb.test()\nasync def same_row_alias_under_imem_stall(dut):\n    prog = [NOP()] * 515\n    prog[1] = ADDI(7,0,1)\n    prog[2] = JAL(0,2040)\n    prog[512:515] = [ADDI(3,0,3), ADDI(7,0,7), EBREAK()]\n    waits = 0\n    def ready(pc, mem):\n        nonlocal waits\n        if pc == 2052:\n            waits += 1\n            return waits >= 4, True\n        return True, True\n    rets, _ = await _run(dut, prog, bus_ready=ready, poison=True)\n    assert waits == 4\n    assert [r[\\\"pc\\\"] for r in rets] == [0,4,8,2048,2052,2056]\n    assert rets[-2][\\\"rd_wdata\\\"] == 7\n\n@cocotb.test()\nasync def fence_expires_stored_instruction_and_target(dut):\n    fence_i = 0x100f\n    new_inst = JAL(6, 4)\n    program = [LW(2,0,512), ADDI(3,0,2), JAL(0,12), EBREAK(), EBREAK(),\n               ADDI(3,3,-1), ADDI(6,0,1), BEQ(3,0,20), SW(2,0,24),\n               fence_i, JAL(0,-20), SW(0,0,100), EBREAK()]\n    held = 0\n    visits = 0\n    def ready(pc, mem):\n        nonlocal held, visits\n        if pc == 40 and mem:\n            held += 1\n            return False, held >= 3\n        if pc == 24:\n            visits += 1\n            return visits == 1 or visits >= 5, True\n        return True, True\n    stores = []\n    rets, _ = await _run(dut,program,{512:new_inst}, bus_ready=ready, poison=True, stores=stores, unified=True)\n    assert stores == [(24,15,new_inst)]\n    assert held == 3 and visits == 5\n    assert [r[\\\"pc\\\"] for r in rets] == [0,4,8,20,24,28,32,36,40,20,24,28,48]\n    assert all(r[\\\"pc_next\\\"] == q[\\\"pc\\\"] for r,q in zip(rets,rets[1:]))\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 24] == [1,28]\n'''\np.write_text(s)\nPY\ncd \\\"\"'$TMPDIR/successor_trial\" && python -m pytest -qs cores/bench/test/test_pipeline.py > pipeline.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
