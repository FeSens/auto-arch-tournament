{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/probe/real_div.txt\" <<'\"'SV'\n  logic [31:0] n_q, d_q;\n  logic negative_a, negative_b, remainder_op, signed_op;\n  logic want_rem;\n  assign signed_op = op == ALU_DIV || op == ALU_REM;\n  assign remainder_op = op == ALU_REM || op == ALU_REMU;\n  assign negative_a = a[31] && signed_op;\n  assign negative_b = b[31] && signed_op;\n  always_ff @(posedge clock) begin\n    if (div_req_ready) begin\n      n_q <= negative_a ? -a : a;\n      d_q <= negative_b ? -b : b;\n      want_rem <= remainder_op;\n      div_negate <= remainder_op ? negative_a : ((negative_a \"'^ negative_b) && b != 0);\n    end\n  end\n\n  (* syn_romstyle = \"block_rom\" *) logic [31:0] inv_table [0:2047];\n  initial begin\n    inv_table[0] = 0;\n    inv_table[1] = 0;\n    for (int i=2; i<2048; i++)\n      inv_table[i] = 32'\"'(64'h1_00000000 / 64'(unsigned'(i)));\n  end\n  logic [31:0] inv;\n  always_ff @(posedge clock) inv <= inv_table[d_q[10:0]];\n\n  logic use3, use2, use1, small_q, zero_q, one_q;\n  logic class3, class2, class1;\n  assign class1 = |d_q[31:25];\n  assign class2 = |d_q[24:18] && \"'!class1;\n  assign class3 = |d_q[17:11] && !class1 && !class2;\n  always_ff @(posedge clock) begin\n    if (phase_q[0]) begin\n      use1 <= class1;\n      use2 <= class2;\n      use3 <= class3;\n      small_q <= d_q[31:11] == 0 && |d_q[10:1];\n      zero_q <= d_q == 0;\n      one_q <= d_q == 1;\n    end\n  end\n\n  logic [15:0] limb_a, limb_a0, limb_b0;\n  logic [31:0] product0, product1;\n  logic [31:0] p00, p01;\n  logic [17:0] middle;\n  logic [31:0] high_sum, estimate_q;\n  logic [11:0] rem0;\n  assign limb_a = phase_q[1] ? n_q[15:0] : n_q[31:16];\n  assign limb_a0 = phase_q[5] ? {4'\"'b0,estimate_q[11:0]} : limb_a;\n  assign limb_b0 = phase_q[5] ? {5'b0,d_q[10:0]} : inv[15:0];\n  always_ff @(posedge clock) begin\n    product0 <= limb_a0 * limb_b0;\n    product1 <= limb_a * inv[31:16];\n    if (phase_q[2]) begin\n      p00 <= product0;\n      p01 <= product1;\n    end\n    if (phase_q[3]) begin\n      middle <= {2'b0,p00[31:16]} + {2'b0,p01[15:0]} + {2'b0,product0[15:0]};\n      high_sum <= product1 + {16'b0,p01[31:16]} + {16'b0,product0[31:16]};\n    end\n    if (phase_q[4]) estimate_q <= high_sum + {30'b0,middle[17:16]};\n    if (phase_q[6]) rem0 <= n_q[11:0] - product0[11:0];\n  end\n\n  logic [20:0] stream, packed_stream, finished;\n  logic [31:0] prior_q, partial, new_remainder, initial_r, large_quotient;\n  logic [6:0] q1;\n  logic [13:0] q2;\n  for (genvar j=0; j<7; j++) begin : gen_pack\n    assign packed_stream[3*j +: 3] = (class1 ? {2'b0,n_q[j]} : 3'b0)\n                                    | (class2 ? {1'b0,n_q[2*j +: 2]} : 3'b0)\n                                    | (class3 ? n_q[3*j +: 3] : 3'b0);\n    assign q1[j] = finished[3*j];\n    assign q2[2*j +: 2] = finished[3*j +: 2];\n  end\n  assign large_quotient = ({32{use1}} & {25'b0,q1}) | ({32{use2}} & {18'b0,q2})\n                        | ({32{use3}} & {11'b0,finished});\n  assign initial_r = ({32{class1}} & (n_q >> 7))\n                   | ({32{class2}} & (n_q >> 14))\n                   | ({32{class3}} & (n_q >> 21));\n  assign partial = prior_q | {29'b0,stream[20:18]};\n\n  logic [31:0] multiples [1:7];\n  assign multiples[1] = d_q;\n  assign multiples[2] = d_q << 1;\n  assign multiples[4] = d_q << 2;\n  assign multiples[6] = multiples[3] << 1;\n  always_ff @(posedge clock) begin\n    if (phase_q[0]) begin\n      multiples[3] <= d_q + (d_q << 1);\n      multiples[5] <= d_q + (d_q << 2);\n      multiples[7] <= (d_q << 3) - d_q;\n    end\n  end\n  logic [7:1] fit;\n  logic [7:0] wins;\n  logic [31:0] residual [0:7];\n  logic [2:0] digit;\n  assign wins = {fit[7],fit[6:1] & ~fit[7:2],\"'!fit[1]};\n  assign residual[0] = {32{wins[0]}} & partial;\n  for (genvar k=1; k<8; k++) begin : gen_trial\n    localparam W = (k==1) ? 32 : (k<4) ? 27 : 21;\n    logic [W:0] diff;\n    assign diff = {1'\"'b0,partial[W-1:0]} - {1'b0,multiples[k][W-1:0]};\n    assign fit[k] = \"'!diff[W] && ((k==1) || (k<4 && use2) || use3);\n    assign residual[k] = {{(32-W){1'\"'b0}}, diff[W-1:0] & {W{wins[k]}}};\n  end\n  assign digit[2] = fit[4];\n  assign digit[1] = (fit[2] && \"'!fit[4]) || fit[6];\n  assign digit[0] = |(wins & 8'\"'haa);\n  assign new_remainder = residual[0] | residual[1] | residual[2] | residual[3]\n                       | residual[4] | residual[5] | residual[6] | residual[7];\n  assign finished = {stream[17:0],digit};\n\n  always_ff @(posedge clock) begin\n    if (phase_q[0]) begin\n      stream <= packed_stream;\n      prior_q <= (class1 ? initial_r << 1 : 32'b0)\n               | (class2 ? initial_r << 2 : 32'b0)\n               | (class3 ? initial_r << 3 : 32'b0);\n    end else if (|phase_q[6:1]) begin\n      prior_q <= ({32{use1}} & (new_remainder << 1)) | ({32{use2}} & (new_remainder << 2))\n               | ({32{use3}} & (new_remainder << 3));\n      stream <= finished;\n    end\n  end\n\n  logic [12:0] excess;\n  logic [31:0] small_value, bypass_value, large_value;\n  assign excess = {1'b0,rem0} - {2'b0,d_q[10:0]};\n  assign small_value = want_rem ? {20'b0,excess[12] ? rem0 : excess[11:0]}\n                                : estimate_q + {31'b0,\"'!excess[12]};\n  assign large_value = want_rem ? new_remainder : large_quotient;\n  assign bypass_value = (zero_q ? (want_rem ? n_q : 32'\"'hffffffff) : 32'b0)\n                      | ({32{one_q && \"'!want_rem}} & n_q);\n  assign div_magnitude = (small_q ? small_value : 32'\"'b0) | bypass_value\n                       | ((use1 || use2 || use3) ? large_value : 32'b0);\n\n  logic [31:0] done_small, done_large_rem, done_large_q;\n  always_ff @(posedge clock) begin\n    done_small <= (small_q ? small_value : 32'b0) | bypass_value;\n    done_large_rem <= (want_rem && (use1 || use2 || use3)) ? new_remainder : 32'b0;\n    done_large_q <= want_rem ? 32'b0 : large_quotient;\n  end\n  assign div_comple