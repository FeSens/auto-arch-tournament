{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c 'rg --files cores/bench/test && cat cores/bench/rtl/if_stage.sv && git log -8 --oneline'","aggregated_output":"cores/bench/test/test_imm_gen.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/_helpers.py\ncores/bench/test/conftest.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/test_multiplier.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_alu.py\n// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Direct transfers use the current instruction's displacement. The\n// PC-indexed table predicts only conditional branch direction.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX corrects fetch\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [6:0]        train_index,\n  input  logic [1:0]        train_counter,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [1:0]  counters [0:127];\n  logic [1:0]  counter;\n  logic [31:0] displacement, target;\n  logic        is_branch, is_jal, predicted_taken;\n\n  initial begin\n    for (int i = 0; i < 128; i++) counters[i] = 2'b01;\n  end\n\n  assign counter = counters[pc[8:2]];\n  always_ff @(posedge clock) begin\n    if (train_en) counters[train_index] <= train_counter;\n  end\n\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] != 2'b01;\n  assign is_jal    = imem_data[6:0] == 7'b1101111;\n  // Choose the immediate before the adder, in parallel with opcode decode.\n  assign displacement = imem_data[2]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign target = pc + displacement;\n  assign predicted_taken = (is_jal || (is_branch && counter[1]))\n                        && target[1:0] == 2'b00 && target[31:20] == 12'b0;\n\n  // A correction commits even when imem cannot deliver the younger slot.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= predicted_taken ? target : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc                = pc;\n    out.instr             = imem_data;\n    out.predicted_taken   = predicted_taken;\n    out.direction_counter = counter;\n    out.valid             = imem_ready;\n  end\n\nendmodule\nd1c9f01 log: hyp-20261122-003-r4s2 regression\n4782a97 log: hyp-20261122-002-r4s1 improvement\n2928c52 log: hyp-20261122-001-r4s0 regression\nec221f6 hyp-20261122-002-r4s1: Execute multiplies in MEM from registered operands (+22.8%)\nc778dcb log: hyp-20261122-003-r3s2 improvement\n45f01a3 log: hyp-20261122-002-r3s1 regression\nefd8da1 log: hyp-20261122-001-r3s0 regression\nba0427e hyp-20261122-003-r3s2: Predict direct branches with a 128-entry direction table (+17.2%)\n","exit_code":0,"status":"completed"}}
