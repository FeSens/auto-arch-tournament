{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/load-probe/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def load_format_and_bypass(dut):\n    memory = {128: 0x807FFE81, 132: 0x12567823}\n    program = []\n    expected = []\n    for base, word in memory.items():\n        for fn, width in [(0, 1), (1, 2), (2, 4), (4, 1), (5, 2)]:\n            for offset in range(0, 4, width):\n                program.extend([_i(base + offset, 0, fn, 1, 3), ADD(2, 1, 1)])\n                value = (word >> (8 * offset)) & ((1 << (8 * width)) - 1)\n                if fn < 2 and value >> (8 * width - 1):\n                    value -= 1 << (8 * width)\n                expected.append(value & 0xffffffff)\n    rets, _ = await _run(dut, program + [EBREAK()], memory)\n    for i, value in enumerate(expected):\n        load, add = rets[2*i:2*i+2]\n        assert load[\\\"rd_wdata\\\"] == value\n        assert add[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1\n        assert add[\\\"rs1_rdata\\\"] == add[\\\"rs2_rdata\\\"] == value\n        assert add[\\\"rd_wdata\\\"] == (2 * value) & 0xffffffff\n\n\n@cocotb.test()\nasync def held_pointer_load_and_store(dut):\n    program = [LW(1, 0, 128), LW(2, 1, 0), SW(2, 0, 136),\n               LW(3, 0, 136), BEQ(3, 2, 8), ADDI(4, 0, 42), EBREAK()]\n    held = 0\n    def ready(pc, access):\n        nonlocal held\n        if access and held < 5:\n            held += 1\n            return True, False\n        return True, True\n    stores = []\n    rets, mem = await _run(dut, program, {128: 132, 132: 0x9040ABCD}, bus_ready=ready, stores=stores)\n    assert held == 5 and len(stores) == 1\n    assert [r[\\\"pc\\\"] for r in rets] == [0,4,8,12,16,24]\n    assert rets[1][\\\"cycle\\\"] == rets[0][\\\"cycle\\\"] + 1\n    assert mem[136] == rets[3][\\\"rd_wdata\\\"] == rets[4][\\\"rs1_rdata\\\"] == 0x9040ABCD\n\n\n@cocotb.test()\nasync def bypass_trapping_load(dut):\n    program = [ADDI(4,