{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/btb_r15/early.py\" <<'\"'PY'\nimport os,sys\nfrom pathlib import Path\nbase=Path('cores/bench/rtl'); variant=sys.argv[1]; out=Path(os.environ['TMPDIR'])/('load_'+variant)/'rtl'\nout.mkdir(exist_ok=True,parents=True)\nfor src in base.glob('*.sv'): (out/src.name).write_bytes(src.read_bytes())\ndef change(f,x,y):\n p=out/f;s=p.read_text();assert x in s;p.write_text(s.replace(x,y))\nchange('core_pkg.sv','    logic        recover_fallthrough;', '    logic [7:0]  early_row;\\\\n    logic        recover_fallthrough;')\nchange('id_stage.sv','  always_ff @(posedge clock) begin','  wire [9:0] early_address = rs1_data[9:0] + in.instr[29:20];\\\\n  always_ff @(posedge clock) begin')\nchange('id_stage.sv','      reg_q.pc       <=', '      reg_q.early_row <= early_address[9:2];\\\\n      reg_q.pc       <=')\np=out/'ex_stage.sv';s=p.read_text();a=s.index('  assign lookup_index[7:3]');b=s.index('  // ── ALU operand',a)\nif 'fwd' in variant:\n rep='''  wire [7:0] row_mask = in.early_row \"'^ in.rs1_val[9:2];\n  assign lookup_index = ({8{fwd_rs1_sel.captured}} & in.early_row) |\n              ({8{fwd_rs1_sel.mem_wb}} & (fwd_mem_wb[9:2] ''^ row_mask)) |\n              ({8{fwd_rs1_sel.ex_mem}} & (fwd_ex_mem[9:2] ''^ row_mask)) |\n              ({8{fwd_rs1_sel.load}} & (predicted_value[9:2] ''^ row_mask));'\"'''\nelse:\n rep='  assign lookup_index = in.early_row;'\np.write_text(s[:a]+rep+'\\\\n\\\\n'+s[b:])\nif 'block' in variant:\n change('mem_stage.sv','syn_ramstyle = \\\"distributed_ram\\\"','syn_ramstyle = \\\"block_ram\\\"')\nif 'views' in variant:\n p=out/'mem_stage.sv';s=p.read_text().replace('syn_ramstyle = \\\"distributed_ram\\\"','syn_ramstyle = \\\"block_ram\\\"')\n a=s.index('  always_ff @(posedge clock) begin')\n s=s[:a]+'''  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] views [0:511];\n  always_ff @(posedge clock) begin\n    if (\"'!hold_wb)\n      predicted_value <= views[{lookup_index,lookup_word}];\n    if (update && install) begin\n      views[{update_index,1'\"'b1}] <= row_word;\n      views[{update_index,1'b0}] <= formatted_value;\n    end\n  end\n'''+s[a:]\n s=s[:s.index('      predicted_value <= lookup_word')] + s[s.index('\\\\n    end',s.index('      predicted_value <= lookup_word')):]\n p.write_text(s)\nPY\ncat > \\\"\"'$TMPDIR/btb_r15/run_trial.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,json,subprocess\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build_all\nfrom tools.eval.fpga import validate_coremark_uart\np=Path(sys.argv[1]); rtl=p/'rtl'\ndef sim():\n with (p/'verilator.log').open('w') as log:\n  subprocess.run(['bash','test/cosim/build.sh'],env={**os.environ,'NRET':'1','RTL_DIR':str(rtl),'OBJ_DIR':str(p/'obj')}, stdout=log,stderr=subprocess.STDOUT,check=True)\n r=subprocess.run([str(p/'obj/cosim_sim'),str(p.parent/'btb_r15/coremark.elf'),'5000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True)\n (p/'cosim.log').write_text(r.stdout)\n end=json.loads(r.stdout.splitlines()[-1])\n return (validate_coremark_uart(end['uart'],10),end['oob'],end['bench_stop_cycle']-end['bench_start_cycle'])\ndef timing():\n opts=[int(n) for n in sys.argv[2:]] or [1]\n r=build_all('.',rtl,'fpga/core_bench_si.sv',p/'timing',options=opts)\n (p/'reports.json').write_text(json.dumps(r)); return [(x.get('fmax_mhz'),x.get('critical_paths',[{}])[0].get('from'),x.get('critical_paths',[{}])[0].get('to'),x.get('reason')) for x in r]\nwith ThreadPoolExecutor(2) as ex:\n a=ex.submit(sim); b=ex.submit(timing); print(a.result(),b.result(),flush=True)\nPY\npython \\\"\"'$TMPDIR/btb_r15/early.py\" early && python \"$TMPDIR/btb_r15/early.py\" views'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
