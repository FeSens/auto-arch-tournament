{"type": "item.completed", "item": {"id": "item_85", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// Base integer results are combinational. DIV/REM share a blocking\n// divider with one setup clock and six registered radix-4 rounds.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_resp_valid,\n  input  logic        div_resp_ready,\n  output logic [31:0] div_result\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:    out = 32'b0;\n    endcase\n  end\n\n  // A request advances through setup (bit 0) and six rounds (bits 1..6).\n  logic [6:0] phase_q;\n  logic       div_issue;\n  assign div_req_ready = (phase_q == '0) && !div_resp_valid;\n  assign div_issue     = div_req_valid && div_req_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q        <= '0;\n      div_resp_valid <= 1'b0;\n    end else begin\n      phase_q        <= {phase_q[5:0], div_issue};\n      div_resp_valid <= phase_q[6] || (div_resp_valid && !div_resp_ready);\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32