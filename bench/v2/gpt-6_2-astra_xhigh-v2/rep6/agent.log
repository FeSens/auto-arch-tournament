data, saved_lane) : dmem_rdata;\n  assign source_word = in.ctrl.mem_write ? in.write_data : dmem_rdata;\n  assign row_word = dmem_rdata;\n  assign update = \"'!reset && in.effective_addr[31:20] == 0 && dmem_ready &&\n                  !mem_misalign && (dmem_ren || in.ctrl.mem_write);\n  assign install = in.ctrl.mem_read || word_width;\n\"\"\"+(\"\"\"  (* syn_ramstyle = \"distributed_ram\" *) logic [41:0] words [0:255];\n  wire [41:0] lookup_row = words[lookup_index];\n  wire [31:0] aligned_data = permute(lookup_row[31:0],lookup_lane);\n  always_ff @(posedge clock) begin\n    if (!hold_wb) begin\n      candidate_tag   <= lookup_row[41:32];\n      saved_data      <= aligned_data;\n      saved_lane      <= lookup_lane;\n      predicted_value <= extend(aligned_data,lookup_width,lookup_sext);\n    end\n    if (update && install)\n      words[update_index] <= {in.effective_addr[19:10], source_word};\n  end\n\"\"\" if kind=='\"'lane_read' else \\\"\\\"\\\"  logic [9:0] tags[0:255];\n  logic [1:0] width_q;\n  logic sext_q;\n  always_ff @(posedge clock) begin\n    if (\"'!hold_wb) begin\n      candidate_tag <= tags[lookup_index];\n      saved_lane <= lookup_lane;\n      width_q <= lookup_width;\n      sext_q <= lookup_sext;\n    end\n    if (update && install) tags[update_index] <= in.effective_addr[19:10];\n  end\n  for(genvar p = 0; p < 4; p++) begin : gen_port\n    (* syn_ramstyle = \"block_ram\" *) logic [7:0] bytes[0:1023];\n    always_ff @(posedge clock) begin\n      if (!hold_wb) saved_data[8*p+:8] <= bytes[{lookup_index,lookup_lane ''^ 2'\"'(p)}];\n      if (update && install) begin\n        for(int b=0;b<4;b++) bytes[{update_index,2'(b)}] <= source_word[b*8+:8];\n      end\n    end\n  end\n  assign predicted_value = extend(saved_data,width_q,sext_q);\n\\\"\\\"\\\")+s[b:]\n p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/earlyalign.py\"\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
