{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Combinational ALU and radix-16 DIV/REM request/response tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nDIV_LATENCY = 7  # One setup clock followed by six rounds.\n\n\nasync def _tick(dut):\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_resp_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _issue_div(dut, op, a, b):\n    assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await _tick(dut)\n    assert not int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n    dut.div_req_valid.value = 0\n    # Change all live inputs as soon as the divider owns the request.\n    dut.op.value = ALU_ADD\n    dut.a.value = 0x54321098\n    dut.b.value = 0x76543210\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    a_negative = op in (ALU_DIV, ALU_REM) and bool(a & (1 << 31))\n    b_negative = op in (ALU_DIV, ALU_REM) and bool(b & (1 << 31))\n    negate = a_negative if op in (ALU_REM, ALU_REMU) else (a_negative != b_negative and b != 0)\n    magnitude = (-expected if negat\n…[8765 of 11837 chars elided by tools/bench/transcript.py; sha256:699a66dd22a6903e]…\nt _setup(dut)\n    # Reset on the setup edge, during iteration, on the final edge, and\n    # after a completed response has spent two clocks under backpressure.\n    for elapsed in (0, 1, 4, DIV_LATENCY - 1, DIV_LATENCY + 2):\n        dut.div_resp_ready.value = 0\n        await _issue_div(dut, ALU_DIV, -101, 7)\n        for _ in range(elapsed):\n            await _tick(dut)\n        assert not int(dut.div_req_ready.value)\n        assert int(dut.div_resp_valid.value) == (elapsed >= DIV_LATENCY)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(DIV_LATENCY + 1):\n            assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n            await _tick(dut)\n        await _check_div(dut, ALU_REMU, 0xFFFFFFFF, 0x80000000, 0x7FFFFFFF)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
