{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/predict/cores/bench/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def predict_direction_alias_and_exit(dut):\n    # The two conditionals have the same [8:2] index and different targets.\n    bne = lambda r1, r2, disp: _b(disp, r2, r1, 1, 0x63)\n    program = [NOP()] * 136\n    program[:4] = [ADDI(1, 0, 7), ADDI(1, 1, -1), bne(1, 0, -4), JAL(6, 508)]\n    program[130] = bne(0, 0, 12)\n    program[131] = JAL(5, 16)\n    program[133] = SW(0, 0, 0)\n    program[135] = EBREAK()\n    fetches, stores = [], []\n    def bus_ready(pc, mem_access):\n        fetches.append(pc)\n        return True, True\n    rets, _ = await _run(dut, program, stores=stores, bus_ready=bus_ready)\n    assert [r[\\\"pc\\\"] for r in rets] == [0] + [4, 8] * 7 + [12, 520, 524, 540]\n    assert rets[-4][\\\"rd_wdata\\\"] == 16 and rets[-2][\\\"rd_wdata\\\"] == 528\n    pairs = [(a,b) for a,b in zip(rets,rets[1:]) if (a[\\\"pc\\\"],b[\\\"pc\\\"]) == (8,4)]\n    assert pairs[-1][1][\\\"cycle\\\"] == pairs[-1][0][\\\"cycle\\\"] + 1\n    assert rets[-1][\\\"cycle\\\"] == rets[-2][\\\"cycle\\\"] + 1\n    assert 532 in fetches and not stores\n\n\n@cocotb.test()\nasync def jalr_recovers_on_dmem_release_with_imem_stalled(dut):\n    program = [ADDI(4, 0, 25), NOP(), LW(3, 0, 0), JALR(1, 4, 0),\n               SW(4, 0, 0), NOP(), JAL(6, 2), EBREAK()]\n    accesses, fetches, stores = [], [], []\n    def bus_ready(pc, mem_access):\n        fetches.append(pc)\n        if pc == 16 and mem_access:\n            accesses.append(pc)\n            return len(accesses) < 3, len(accesses) >= 3\n        return True, True\n    rets, _ = await _run(dut, program, bus_ready=bus_ready, stores=stores)\n    assert accesses == [16,16,16] and not stores\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 12, 24, 28]\n    assert (rets[3][\\\"pc_next\\\"],rets[3][\\\"rd_wdata\\\"]) == (24,16)\n    assert (rets[4][\\\"trap\\\"], rets[4][\\\"rd\\\"], rets[4][\\\"pc_next\\\"]) == (1,0,28)\n    assert not any(pc & 3 for pc in fetches)\nPY\ncd \\\"\"'$TMPDIR/predict\" && pytest -q cores/bench/test > pipeline_checks.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
