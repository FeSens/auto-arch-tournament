logic [4:0] op);\n    is_mul = (op == ALU_MUL)   || (op == ALU_MULH) ||\n             (op == ALU_MULHU) || (op == ALU_MULHSU);\n  endfunction\n\n  // ── Branch operations (encoded = funct3 of BRANCH opcode) ───────────────\n  // Phase 1 only references BR_BEQ (\n…[3221 of 6293 chars elided by tools/bench/transcript.py; sha256:6218a6a961738ade]…\nrs2 used by EX\n    logic        rs1_trace_load; // unused encoded field names the preceding load's rd\n    logic        rs2_trace_load;\n    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n", "exit_code": 0, "status": "completed"}}
