]);\n        if(type==1 && vaddr < (1<<20)) {\n            memcpy(imem+vaddr, elf.data.data()+foff, filesz);\n            memcpy(dmem+vaddr, elf.data.data()+foff, filesz);\n        }\nplace_option 0: Fmax 54.398 MHz, 17 logic levels; logic 5207, registers 1466, LUT-RAM 16, BSRAM 10, DSP 6\n// flop in this microarchitecture, the next-stage's ID/EX register\n// Each accepted PC looks up its last observed successor for the next\n  logic        prev_valid, candidate_valid, hit, accept, fill, can_fill;\n  assign accept = !stall && !redirect && !reset;\n  assign can_fill = imem_ready && prev_valid && pc[31:20] == 0 && pc[1:0] == 0;\n  assign fill = accept && can_fill;\n    if (accept) candidate <= successors[index_now];\n    if (fill) successors[prev_index] <= {pc[19:2], imem_data, live_target[19:2], live_jal, live_branch};\n      candidate_valid <= 1'b0;\n    end else if (accept) begin\n      if (can_fill) occupied[prev_index] <= 1'b1;\n      candidate_valid <= occupied[index_now] && !(can_fill && prev_index == index_now);\n  // Only acceptance depends on the full address comparison. Decode,\n  assign hit = candidate_valid && {12'b0, candidate.pc_word, 2'b00} == pc;\n    out.valid             = imem_ready || hit;\n","exit_code":0,"status":"completed"}}
