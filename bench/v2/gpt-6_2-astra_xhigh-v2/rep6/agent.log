{"type": "item.completed", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/forward_unit.sv && sed -n '50,76p' cores/bench/rtl/ex_stage.sv && cat cores/bench/rtl/hazard_unit.sv | tail -25\"", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Generate one-hot operand enables from the youngest matching writer.\n// The speculative load enable is independent of verification in MEM.\n//\n// Decode compares the incoming rs against the next cycle's MEM and WB\n// destinations so register-number comparisons stay off the EX data path.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       hold_id,\n  input  logic       hold_mem,\n  input  logic [4:0] decode_rs,\n  input  logic       decode_uses_rs,\n  input  logic [4:0] id_ex_rd,\n  input  logic       id_ex_load,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic       ex_mem_load,\n  input  logic       mem_wb_w_en,\n  output bypass_t    sel,\n  output logic       trace_load\n);\n\n  logic raw_match, raw_match_q, mem_match_q, wb_match_q, from_mem, wb_match;\n  assign raw_match = id_ex_rd != 0 && id_ex_rd == decode_rs;\n  always_ff @(posedge clock) begin\n    if (!hold_id) begin\n      raw_match_q <= raw_match;\n      mem_match_q <= raw_match && (decode_uses_rs || !id_ex_load);\n    end\n    if (!hold_mem) begin\n      // With ID held, MEM drains into WB and EX supplies a bubble.\n      wb_match_q <= hold_id ? raw_match_q : (ex_mem_rd != 0 && ex_mem_rd == decode_rs);\n    end\n  end\n\n  assign from_mem = ex_mem_w_en && mem_match_q;\n  assign wb_match = mem_wb_w_en && wb_match_q;\n  assign sel.captured  = !from_mem && !wb_match;\n  assign sel.mem_wb    = !from_mem && wb_match;\n  assign sel.ex_mem    = from_mem && !ex_mem_load;\n  assign sel.load      = from_mem && ex_mem_load;\n  assign trace_load    = ex_mem_load && raw_match_q && !mem_match_q;\n\nendmodule\n\n  // Two short adders drive the synchronous read port. MEM checks any\n  // discarded carries against the separately registered full address.\n  assign lookup_index[7:3] = rs1[9:5] + in.imm[9:5];\n  assign lookup_index[2:0] = rs1[4:2] + in.imm[4:2];\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_b;\n  bypass_t alu_b_sel;\n  assign alu_b_sel = in.ctrl.alu_src ? '0 : fwd_rs2_sel;\n  assign alu_b = operand(alu_b_sel, in.rs2_val) | ({32{in.ctrl.alu_src}} & in.imm);\n\n  logic        is_div, div_req_valid, div_req_ready, div_resp_valid, ex_enable;\n  logic [31:0] div_result, div_rs1_q, div_rs2_q;\n  logic [31:0] alu_result;\n\n  assign is_div = in.valid && (in.ctrl.alu_op == ALU_DIV  || in.ctrl.alu_op == ALU_DIVU ||\n                               in.ctrl.alu_op == ALU_REM  || in.ctrl.alu_op == ALU_REMU);\n  assign div_wait = is_div && !div_resp_valid;\n  assign ex_enable = !stall && !replay;\n  assign div_req_valid = div_wait && ex_enable;\n\n  // Forwarding sources can drain while ID/EX holds the divide metadata.\n  always_ff @(posedge clock) begin\n    if (div_req_valid && div_req_ready) begin\n      div_rs1_q <= rs1;\n      div_rs2_q <= rs2;\n  input  logic       replay,\n  input  logic       fetch_available,   // live bus word or verified successor\n  input  logic       dmem_ready,\n  input  logic       bus_request,       // load miss or store at the true address\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_id,          // bubble entering EX\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic use_hazard;\n  logic dmem_stall;\n\n  assign use_hazard   = id_ex_wb_only && id_ex_rd != 5'b0\n                     && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign dmem_stall   = !dmem_ready && bus_request;\n  assign stall_id     = dmem_stall || div_wait || replay;\n  assign stall_if     = stall_id || use_hazard || !fetch_available;\n  assign flush_id     = use_hazard || redirect;\n  assign stall_ex_mem = dmem_stall;\n  assign hold_mem_wb  = dmem_stall;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
