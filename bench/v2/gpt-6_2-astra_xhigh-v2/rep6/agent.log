{"type":"item.completed","item":{"id":"item_134","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv'","aggregated_output":"// rtl/forward_unit.sv\n//\n// Generate one-hot operand enables from the youngest matching writer.\n// Both the load match and bank enables are independent of MEM verification.\n//\n// Decode compares the incoming rs against the next cycle's MEM and WB\n// destinations so register-number comparisons stay off the EX data path.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       reset,\n  input  logic       hold_id,\n  input  logic       hold_mem,\n  input  logic [4:0] decode_rs,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_writes,\n  input  logic       ex_load,\n  input  logic       mem_writes,\n  input  logic [3:0] lookup_bank,\n  output logic       load_match,\n  output bypass_t    sel\n);\n\n  logic match_rd, match_ex, match_mem, next_wb, next_load;\n  assign match_rd  = id_ex_rd != 0 && id_ex_rd == decode_rs;\n  assign match_ex  = ex_writes && match_rd;\n  assign match_mem = mem_writes && ex_mem_rd != 0 && ex_mem_rd == decode_rs;\n\n  // On replay the current MEM writer drains to WB. A trapping load\n  // has mem_writes clear, so the held consumer uses its captured value.\n  assign next_wb = hold_id ? ((load_match || sel.ex_mem) && mem_writes)\n                           : (!match_ex && match_mem);\n  assign next_load = match_rd && ex_load && !hold_id;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sel.captured <= 1'b1;\n      sel.ex_mem   <= 1'b0;\n      sel.mem_wb   <= 1'b0;\n      load_match   <= 1'b0;\n      sel.banks    <= '0;\n    end else if (!hold_mem) begin\n      sel.captured <= !(match_ex && !hold_id) && !next_wb;\n      sel.ex_mem   <= match_ex && !ex_load && !hold_id;\n      sel.mem_wb   <= next_wb;\n      load_match   <= next_load;\n      sel.banks    <= {4{next_load}} & lookup_bank;\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_133", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/mem_stage.sv'", "aggregated_output": "// rtl/mem_stage.sv\n//\n// Memory access stage. Drives the dmem read/write ports combinationally\n// from the EX/MEM register, and sign/zero-extends the loaded data into\n// the MEM/WB register.\n//\n// Byte-lane discipline:\n//   - Write data is replicated across all four byte lanes; the\n//     byte-mask (mem_wmask) selects the actual destination bytes.\n//   - Load: shift the raw word right by `addr[1:0]*8`, then sign- or\n//     zero-extend the low 8/16 bits per the LB/LBU/LH/LHU encoding.\n//   - For RVFI ALIGNED_MEM, mem_addr is reported word-aligned and the\n//     byte position is captured in mem_rmask / mem_wmask.\n//\n// Latency:        1 cycle (MEM/WB register clocked here).\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata via the loaded-data path.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // hold_wb: dmem stall is in effect. MEM/WB's data fields are RETAINED\n  // (so the previously-retired LOAD's `rd` / `result` / `ctrl.reg_write`\n  // remain visible to forward_unit), but `valid` is cleared so:\n  //   - rvfi_order doesn't increment for held cycles\n  //   - wb_stage doesn't write the regfile twice\n  // Zeroing the whole register would lose the LOAD's load_data, breaking\n  // MEM/WB->EX forwarding for any dependent instruction that's also held\n  // in ID/EX during the stall (e.g. a BNE that consumes a LOAD's result).\n  input  logic               hold_wb,\n  input  ex_mem_t  in,\n  input  logic [7:0]         lookup_index,\n  input  logic [1:0]         lookup_lane,\n  input  logic [1:0]         lookup_width,\n  input  logic               lookup_sext,\n  output load_banks_t        predicted_values,\n  input  logic [3:0]         lookup_bank,\n  output logic               load_hit,\n  output logic               mem_writes,\n  // dmem interface\n  input  logic               dmem_ready,\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic \n…[7140 of 10212 chars elided by tools/bench/transcript.py; sha256:a793f76c5cf6da33]…\nlse begin\n      reg_q.pc         <= in.pc;\n      reg_q.result     <= ({32{load_hit}} & predicted_result)\n                        | ({32{in.ctrl.mem_to_reg && !load_hit}} & bus_result)\n                        | ({32{is_mul(in.ctrl.alu_op)}} & mul_result)\n                        | ({32{!in.ctrl.mem_to_reg && !is_mul(in.ctrl.alu_op)}} & in.alu_result);\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= raw_word;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
