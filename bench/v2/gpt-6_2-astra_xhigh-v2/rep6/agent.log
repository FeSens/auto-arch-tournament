{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c 'cat \"$TMPDIR/divide_research/radix8/timing/gowin_p0/gw.log\" | tail -8; cat cores/bench/test/_helpers.py | head -145\ngit status --short --untracked-files=all'","aggregated_output":"[30%] Inferring Phase 0 completed\n[40%] Inferring Phase 1 completed\n[50%] Inferring Phase 2 completed\n[55%] Inferring Phase 3 completed\nRunning technical mapping ...\n[60%] Tech-Mapping Phase 0 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/divide_research/design_mixed.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport sys\nroot=Path(__file__).parent\nvariant=sys.argv[1]\nout=root/variant/'rtl'\ncopytree('cores/bench/rtl',out,dirs_exist_ok=True)\nsrc=(root/'radix8/rtl/alu.sv').read_text()\nsrc=src.replace('logic [35:0] quotient_q, quotient_next;', 'logic [31:0] quotient_q, quotient_next;')\nsrc=src.replace(\\\"quotient_q  <= {4'b0000, dividend_mag};\\\",\\\"quotient_q  <= dividend_mag;\\\")\nloc=src.index('  always_comb begin\\\\n    logic [34:0] shifted;')\nend=src.index('  always_ff @(posedge clock) begin\\\\n    if (div_issue) begin\\\\n      divisor_q',loc)\ndef cell(bits):\n n=(1<<bits)\n digexpr=', '.join(f\\\"|(select_digit & {n}'h{sum(1<<k for k in range(n) if k>>bit & 1):x})\\\" for bit in reversed(range(bits)))\n return \\\"\\\"\\\"  function automatic logic [63:0] stepBITS(input logic [31:0] r, input logic [31:0] q);\n    logic [34:0] shifted;\n    logic [35:0] trial [0:LAST];\n    logic [LAST:0] fits, select_digit;\n    logic [DIGITHIGH:0] digit;\n    logic [31:0] residual;\n    shifted = SHIFT;\n    trial[0] = {1'b0, shifted};\n    fits[0] = 1'b1;\n    for (int k = 1; k < COUNT; k++) begin\n      trial[k] = {1'b0, shifted} - {1'b0, multiples[k]};\n      fits[k] = \"'!trial[k][35];\n    end\n    select_digit = fits & ~{1'\"'b0, fits[LAST:1]};\n    digit = {DEC};\n    residual = '0;\n    for (int k = 0; k < COUNT; k++)\n      residual |= {32{select_digit[k]}} & trial[k][31:0];\n    stepBITS = {residual, q[TOP:0], digit};\n  endfunction\n\\\"\\\"\\\".replace('SHIFT',(\\\"{1'b0, r, q[31:30]}\\\" if bits==2 else \\\"{r, q[31:29]}\\\")).replace('BITS',str(bits)).replace('LAST',str(n-1)).replace('COUNT',str(n)).replace('DEC',digexpr).replace('DIGITHIGH',str(bits-1)).replace('TOP',str(31-bits))\nprefix=\\\"\\\"\\\"  logic [1:0] prefix, prefix_digit, prefix_rem;\n  assign prefix = quotient_q[31:30];\n  always_comb begin\n    prefix_digit = '0;\n    prefix_rem = prefix;\n    case (divisor_q)\n      0: prefix_digit = 2'd3;\n      1: begin\n        prefix_digit = prefix;\n        prefix_rem = 2'b00;\n      end\n      2: begin\n        prefix_digit = {1'b0, prefix[1]};\n        prefix_rem = {1'b0, prefix[0]};\n      end\n      3: if (&prefix) begin\n        prefix_digit = 2'd1;\n        prefix_rem = 2'b00;\n      end\n      default: ;\n    endcase\n  end\n\\\"\\\"\\\"\na,b=(2,3) if variant.endswith('48') else (3,2)\nsrc=src[:loc]+prefix+cell(2)+cell(3)+f\\\"\\\"\\\"  logic [31:0] r_mid, q_mid;\n  assign {{r_mid,q_mid}} = step{a}(remainder_q, quotient_q);\n  assign {{remainder_next, quotient_next}} = step{b}(r_mid, q_mid);\n\\\"\\\"\\\"+src[end:]\nsrc=src.replace('    end else if (|phase_q[6:1]) begin','''    end else if (phase_q[0]) begin\n      quotient_q <= {quotient_q[29:0], prefix_digit};\n      remainder_q <= {30'b0, prefix_rem};\n    end else if (|phase_q[6:1]) begin''')\n(out/'alu.sv').write_text(src)\nPY\npython \\\"\"'$TMPDIR/divide_research/design_mixed.py\" mixed48 && PYTHONPATH=. python \"$TMPDIR/divide_research/timeit_div.py\" mixed48 0 1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
