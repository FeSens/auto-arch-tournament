{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/make-trial.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil,sys,os\nroot=Path(os.environ['TMPDIR'])\nname=sys.argv[1]\nf=set(sys.argv[2:])\np=root/name\nshutil.copytree(root/'original-rtl',p)\ndef sub(name,a,b):\n path=p/name\n src=path.read_text()\n assert a in src,(name,a)\n path.write_text(src.replace(a,b))\nif 'buffer' in f:\n shutil.copyfile(root/'load-table-trial/cores/bench/rtl/mem_stage.sv',p/'mem_stage.sv')\nif 'id' in f:\n sub('core_pkg.sv','logic [4:0]  rd;', 'logic [7:0]  lookup_guess;\\\\n    logic [4:0]  rd;') if False else None\n sub('core_pkg.sv','logic        wb_only;', 'logic [7:0]  lookup_guess;\\\\n    logic        wb_only;')\n sub('id_stage.sv','reg_q.imm      <= imm;', 'reg_q.imm      <= imm;\\\\n      reg_q.lookup_guess <= 8\\\\'((rs1_data[9:0] + in.instr[29:20]) >> 2);')\n # For now retain field on held operands. A misprediction simply misses.\n sub('ex_stage.sv','assign lookup_index[7:3] = rs1[9:5] + in.imm[9:5];\\\\n  assign lookup_index[2:0] = rs1[4:2] + in.imm[4:2];','assign lookup_index = in.lookup_guess;')\nif 'wbreg' in f:\n sub('wb_stage.sv','w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;', 'w_data = in.alu_result;')\n sub('mem_stage.sv','reg_q.alu_result <= is_mul','reg_q.alu_result <= in.ctrl.mem_read ? (load_hit ? predicted_value : (word_width ? dmem_rdata : formatted_value)) : is_mul')\nif 'earlywb' in f:\n # Capture the WB index in MEM, one clock ahead; aluresult and predicted_value available on entry\n sub('core.sv','  // ── EX ──','''  logic [7:0] wb_index_q;\n  logic [7:0] wb_base;\n  assign wb_base = ex_mem_w.ctrl.mem_read ? predicted_value[9:2] : ex_mem_w.alu_result[9:2];\n  always_ff @(posedge clock)\n    if (\"'!stall_ex_mem) wb_index_q <= wb_base ''^ (stall_id ? id_ex_w.imm[9:2] : if_id_w.instr[29:22]);\n\n  // ── EX ──'\"''')\n sub('core.sv','.fwd_rs1_sel     (fwd_rs1_sel),','.fwd_rs1_sel     (fwd_rs1_sel),\\\\n    .wb_index (wb_index_q),')\n sub('ex_stage.sv','input  bypass_t            fwd_rs1_sel,','input logic [7:0] wb_index,\\\\n  input  bypass_t            fwd_rs1_sel,')\n sub('ex_stage.sv','assign lookup_index = in.lookup_guess;', '''logic [7:0] mem_base;\n  logic [7:0] mem_index;\n  assign mem_base = ({8{fwd_rs1_sel.ex_mem}} & fwd_ex_mem[9:2]) | ({8{fwd_rs1_sel.load}} & predicted_value[9:2]);\n  assign mem_index = {5'(mem_base[7:3] + in.imm[9:5]), 3'(mem_base[2:0] + in.imm[4:2])};\n  assign lookup_index = ({8{fwd_rs1_sel.captured}} & in.lookup_guess)\n                      | ({8{fwd_rs1_sel.mem_wb}} & wb_index)\n                      | ({8{fwd_rs1_sel.ex_mem || fwd_rs1_sel.load}} & mem_index);''')\nprint(p)\nPY\ncat > \\\"\"'$TMPDIR/test-trial.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,os,shutil,subprocess as sp\nfrom tools.eval import gowin as g\nfrom tools.eval.fpga import run_coremark_ipc\nroot=Path(os.environ['TMPDIR'])\np=root/sys.argv[1]\nrepo=root/'load-table-trial'\nif 'fmax' in sys.argv:\n r=g.build_all(repo,p,'fpga/core_bench_si.sv',p/'timing',options=(1,))[0]\n print(p.name,'GOWIN',r['fmax_mhz'],r.get('critical_paths',[])[:2],flush=True)\nif 'all' in sys.argv:\n r=g.build_all(repo,p,'fpga/core_bench_si.sv',p/'timing')\n print(p.name,'GOWIN',g.summarize(r),flush=True)\nif 'cm' in sys.argv:\n env=dict(os.environ,RTL_DIR=str(p),OBJ_DIR=str(p/'obj'),NRET='1')\n with (p/'build.log').open('w') as out:\n  sp.run(['bash','test/cosim/build.sh'],env=env,cwd=repo,stdout=out,stderr=sp.STDOUT,check=True)\n print(p.name,'COREMARK',run_coremark_ipc(str(repo),str(p/'obj/cosim_sim')),flush=True)\nPY\npython \\\"\"'$TMPDIR/make-trial.py\" lookup-id buffer id && python \"$TMPDIR/make-trial.py\" lookup-partial buffer id earlywb && python \"$TMPDIR/make-trial.py\" lookup-wbmerge buffer wbreg'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
