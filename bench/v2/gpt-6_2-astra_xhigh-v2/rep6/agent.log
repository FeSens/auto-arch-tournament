{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c \"sed -n '547,708p' cores/bench/test/test_pipeline.py && sed -n '300,380p' cores/bench/test/test_pipeline.py && date -u\"", "aggregated_output": "        return loads <= 1 or pc not in (8, 12), mem_access\n\n    # On later iterations the instruction bus carries NOP and the data\n    # bus is unready. Both consumers must use the cached instructions.\n    reads = []\n    rets, _ = await _run(dut, program, {128: 7}, bus_ready=ready, stalled_word=NOP(), reads=reads)\n    pcs = [0] + [4, 8, 12, 16, 20] * 3 + [24]\n    _check_path(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 12] == [49, 98, 147]\n    assert reads == [128]\n    for pc, expected in [(8, [2, 1, 1]), (12, [2, 2, 2])]:\n        assert [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:]) if b[\"pc\"] == pc] == expected\n\n\n@cocotb.test()\nasync def load_index_discarded_carries(dut):\n    # Keep both the predicted and true rows resident. Carry from bit 4,\n    # carry from bit 1, and a negative displacement each select a wrong row.\n    program = [\n        LW(0, 0, 0x100), LW(0, 0, 0x11c), LW(0, 0, 0x120),\n        ADDI(1, 0, 0x11c), ADDI(6, 0, 6), LW(2, 1, 4), ADD(3, 2, 6),\n        ADDI(1, 0, 0x11f), LW(2, 1, 1), ADD(3, 6, 2),\n        ADDI(1, 0, 0x124), LW(2, 1, -4), ADD(3, 2, 6),\n        LW(2, 0, 0x120), ADD(3, 2, 2), EBREAK(),\n    ]\n    reads = []\n    rets, _ = await _run(dut, program, {0x100: 111, 0x11c: 222, 0x120: 33},\n                         bus_ready=lambda pc, access: (True, access), reads=reads)\n    _check_path(rets, list(range(0, len(program) * 4, 4)))\n    assert reads == [0x100, 0x11c, 0x120, 0x120, 0x120, 0x120]\n    for i, result, gap in [(5, 39, 2), (8, 39, 2), (11, 39, 2), (13, 66, 1)]:\n        load, use = rets[i:i + 2]\n        assert (load[\"mem_addr\"], load[\"mem_rmask\"], load[\"mem_rdata\"]) == (0x120, 15, 33)\n        assert (use[\"rd_wdata\"], use[\"cycle\"] - load[\"cycle\"]) == (result, gap)\n\n\n@cocotb.test()\nasync def outstanding_miss_keeps_its_lookup(dut):\n    # The real row is resident, but the carry in x1+4 selects a different\n    # row. The following independent LW looks up the real row during the\n    # freeze\n…[8598 of 11670 chars elided by tools/bench/transcript.py; sha256:91d2b086418cfacf]…\ny retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\nMon Nov 23 01:45:30 UTC 2026\n", "exit_code": 0, "status": "completed"}}
