[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\ntotal 12\ndrwxr-xr-x 5 nobody nogroup 4096 Sep 28 05:13 gowin\ndrwxr-xr-x 4 nobody nogroup 4096 Sep 28 02:57 hwe-python\ndrwxr-xr-x 5 nobody nogroup 4096 Sep 28 02:44 hwe-toolchain\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n/srv/hwebench/venv/bin/python3\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\n               total        used        free      shared  buff/cache   available\nMem:            62Gi       2.5Gi        56Gi        86Mi       4.5Gi        59Gi\nSwap:           31Gi       1.5Gi        30Gi\nMon Nov 23 10:24:46 UTC 2026\n-rwxrwx--x+ 1 nobody nogroup 27444 Nov 22 22:45 ../../../../bench/programs/coremark.elf\n-rwxrwx--x+ 1 nobody nogroup 46884 Nov 22 22:45 ../../../../bench/programs/random1.elf\n-rwxrwx--x+ 1 nobody nogroup 45912 Nov 22 22:45 ../../../../bench/programs/random2.elf\n-rwxrwx--x+ 1 nobody nogroup 47056 Nov 22 22:45 ../../../../bench/programs/random3.elf\n-rwxrwx--x+ 1 nobody nogroup  5248 Nov 22 22:45 ../../../../bench/programs/selftest.elf\n","exit_code":0,"status":"completed"}}
