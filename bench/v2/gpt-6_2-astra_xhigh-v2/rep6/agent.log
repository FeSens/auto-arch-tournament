{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/finalstate.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os\ns=Path(os.environ['TMPDIR'])\nfor n in ('finalstate','finalalways','finalonehot'):\n d=s/n/'rtl'\n copytree('cores/bench/rtl',d)\n p=d/'alu.sv'\n v=p.read_text().replace('  output logic        div_negate','  output logic [31:0] div_wb_magnitude,\\\\n  output logic        div_negate')\n v=v.replace('  assign div_negate = 1\\\\'b0;', \\\"  assign div_wb_magnitude = div_magnitude;\\\\n  assign div_negate = 1'b0;\\\")\n v=v.replace('logic [27:0] remainder_q;', 'logic [31:0] remainder_q;').replace('{remainder_q, quotient_q[31:28]}','{remainder_q[27:0], quotient_q[31:28]}').replace(\\\"{24'b0, setup_remainder}\\\", \\\"{28'b0, setup_remainder}\\\")\n v=v.replace('end else if (|phase_q[6:1]) begin','end else if (|phase_q[6:1] || (div_resp_valid && div_resp_ready)) begin').replace('remainder_q <= remainder_next[27:0];','remainder_q <= remainder_next;')\n if n=='finalalways':\n  # When idle, both outputs only have a consumer during/after a completed operation.\n  # On the release edge and every idle edge the recurrence advances; a backpressured response must hold.\n  v=v.replace('end else if (|phase_q[6:1] || (div_resp_valid && div_resp_ready)) begin','end else if (\"'!div_resp_valid || div_resp_ready) begin'\"')\n v=v.replace('  assign div_magnitude = rem_op_q ?', '  assign div_wb_magnitude = rem_op_q ? remainder_q : quotient_q;\\\\n  assign div_magnitude = rem_op_q ?')\n p.write_text(v)\n p=d/'ex_stage.sv'\n v=p.read_text().replace('  output logic [7:0]         lookup_index,','  output logic [31:0] div_wb_magnitude,\\\\n  output logic [7:0]         lookup_index,').replace('    .div_negate     (div_negate),','    .div_negate     (div_negate),\\\\n    .div_wb_magnitude(div_wb_magnitude),').replace('                           | ({32{div_transfer}} & div_magnitude)\\\\n','')\n v=v.replace('      reg_q.div_negate    <= div_transfer && div_negate;', '''      reg_q.div_op <= in.wb_only && in.instr[14];\n      reg_q.div_negate <= div_negate;''')\n if n=='finalonehot':\n  v=v.replace('reg_q.div_negate <= div_negate;', '''reg_q.div_negate <= in.wb_only && in.instr[14] && div_negate;\n      reg_q.div_op <= in.wb_only && in.instr[14] && \"'!div_negate;\n      reg_q.base_op <= !in.wb_only;'\"''').replace('      reg_q.div_op <= in.wb_only && in.instr[14];\\\\n','')\n p.write_text(v)\n p=d/'core_pkg.sv'\n p.write_text(p.read_text().replace('logic        div_negate;', 'logic div_op, base_op;\\\\n    logic        div_negate;' if n=='finalonehot' else 'logic div_op;\\\\n    logic        div_negate;'))\n p=d/'core.sv'\n v=p.read_text().replace('  logic       div_wait;', '  logic [31:0] div_wb_magnitude;\\\\n  logic       div_wait;')\n v=v.replace('ex_stage u_ex (','ex_stage u_ex (\\\\n    .div_wb_magnitude(div_wb_magnitude),').replace('mem_stage u_mem (','mem_stage u_mem (\\\\n    .div_wb_magnitude(div_wb_magnitude),')\n p.write_text(v)\n p=d/'mem_stage.sv'\n v=p.read_text().replace('module mem_stage (','module mem_stage (\\\\n  input logic [31:0] div_wb_magnitude,').replace('in.div_negate ? -in.alu_result : in.alu_result;', 'in.div_op ? (in.div_negate ? -div_wb_magnitude : div_wb_magnitude) : in.alu_result;')\n if n=='finalonehot':\n  v=v.replace('is_mul(in.ctrl.alu_op) ? mul_result :\\\\n                          in.div_op ? (in.div_negate ? -div_wb_magnitude : div_wb_magnitude) : in.alu_result;', 'mul_result | ({32{in.base_op}} & in.alu_result) | ({32{in.div_op}} & div_wb_magnitude) | ({32{in.div_negate}} & -div_wb_magnitude);')\n p.write_text(v)\nPY\npython \\\"\"'$TMPDIR/finalstate.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
