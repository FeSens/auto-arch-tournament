{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r5-fwd.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil,sys\nroot=Path(os.environ['TMPDIR'])/sys.argv[1]\nrtl=root/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\np=rtl/'core.sv';s=p.read_text()\nstart=s.index('  forward_unit u_fwd (')\nend=s.index('  // ── RVFI',start)\ns=s[:start]+\\\"\\\"\\\"  logic [1:0] issue_src1, issue_src2;\n  forward_unit u_fwd (\n    .id_ex_rs1   (if_id_w.instr[19:15]),\n    .id_ex_rs2   (if_id_w.instr[24:20]),\n    .ex_mem_rd   (id_ex_w.rd),\n    .ex_mem_w_en (ex_will_write),\n    .mem_wb_rd   (ex_mem_w.rd),\n    .mem_wb_w_en (mem_will_write),\n    .fwd_rs1     (issue_src1),\n    .fwd_rs2     (issue_src2)\n  );\n\n  always_ff @(posedge clock) begin\n    if (\"'!stall_id) begin\n      fwd_rs1_sel <= issue_src1;\n      fwd_rs2_sel <= issue_src2;\n    end\n  end\n\n\"\"\"+s[end:]\ns=s.replace('\"'  // ── IF ─','  logic ex_will_write, mem_will_write;\\\\n\\\\n  // ── IF ─')\ns=s.replace('    .train_en        (train_en),','    .ex_will_write (ex_will_write),\\\\n    .train_en        (train_en),',2)\ns=s.replace('    .ex_will_write (ex_will_write),\\\\n', '', 1)\ns=s.replace('    .out        (mem_wb_w)','    .mem_will_write (mem_will_write),\\\\n    .out        (mem_wb_w)')\np.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text()\ns=s.replace('  output logic               train_en,','  output logic               ex_will_write,\\\\n  output logic               train_en,')\ns=s.replace('  assign out = reg_q;', '  assign ex_will_write = ctrl_with_trap.reg_write;\\\\n  assign out = reg_q;')\nif 'flat' in sys.argv:\n st=s.index('  always_comb begin')\n en=s.index('  logic        is_div',st)\n s=s[:st]+\\\"\\\"\\\"  logic s1_local, s1_new, s1_old, s2_local, s2_new, s2_old;\n  assign s1_local = (fwd_rs1_sel == 0);\n  assign s1_new = (fwd_rs1_sel == 1);\n  assign s1_old = (fwd_rs1_sel == 2);\n  assign s2_local = (fw