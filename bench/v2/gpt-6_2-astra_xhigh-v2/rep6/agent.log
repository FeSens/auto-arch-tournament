{"type":"item.started","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil\nbase=Path(os.environ['TMPDIR'])\nfor kind in ('front-fill','front-qual','front-port'):\n p=base/kind/'rtl';shutil.copytree('cores/bench/rtl',p)\n f=p/'if_stage.sv';s=f.read_text()\n if kind=='front-fill':\n  s=(base/'elastic-enable/rtl/if_stage.sv').read_text()\n elif kind=='front-qual':\n  i=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset || fence_i)');j=s.index('  // Only acceptance depends',i)\n  s=s[:i]+'''  logic [8:0] set_index;\n  logic set_valid, clear_rows;\n  always_ff @(posedge clock) begin\n    set_valid <= fill;\n    set_index <= prev_index;\n    clear_rows <= reset || fence_i;\n    if (clear_rows) occupied <= '0;\n    else if (set_valid) occupied[set_index] <= 1'b1;\n    if (reset || fence_i) begin\n      prev_valid <= 1'b0;\n      candidate_valid <= 1'b0;\n    end else if (accept) begin\n      candidate_valid <= \"'!clear_rows && (occupied[index_now] || (set_valid && set_index==index_now)) &&\n                         !(can_fill && prev_index == index_now);\n      prev_index <= index_now;\n      prev_valid <= 1'\"'b1;\n    end\n  end\n'''+s[j:]\n else:\n  # Capture every ready live word, cancel training in metadata. On a\n  # squashed fetch overwriting an occupied row, the new word still has its exact PC.\n  s=(base/'elastic-mask/rtl/if_stage.sv').read_text()\n  s=s.replace('if (fill_valid) successors[fill_index] <= fill_row;', 'if (can_fill) successors[prev_index] <= {pc[19:2],imem_data,live_target[19:2],live_jal,live_branch};')\n  s=s.replace('                  \"'!(can_fill && prev_index == index_now) &&'\"\\\\n                  \"'!(fill_valid && fill_index == index_now);'\"','                  \"'!(can_fill && prev_index == index_now);'\"')\n f.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
