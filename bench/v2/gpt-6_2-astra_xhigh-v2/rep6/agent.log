{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil\nbase=Path(os.environ['TMPDIR'])\nfor kind in ('early-load','early-load-rf'):\n p=base/kind/'rtl';shutil.copytree((Path('cores/bench/rtl') if kind=='early-load' else base/'rf-capture/rtl'),p)\n f=p/'id_stage.sv';s=f.read_text().replace('  // ID/EX register output', '  output logic [7:0] lookup_index,\\\\n  // ID/EX register output')\n s=s.replace('  ctrl_t ctrl_decoded;', '''  assign lookup_index[2:0] = rs1_data[4:2] + imm[4:2];\n  assign lookup_index[7:3] = rs1_data[9:5] + imm[9:5];\n  ctrl_t ctrl_decoded;''')\n f.write_text(s)\n f=p/'ex_stage.sv'; s=f.read_text().replace('output logic [7:0]         lookup_index','output logic [1:0]         lookup_lane')\n i=s.index('  assign lookup_index');j=s.index('  // ── ALU operand',i)\n f.write_text(s[:i]+'''  assign lookup_lane = rs1[1:0] + in.imm[1:0];\n\n'''+s[j:])\n f=p/'core.sv';s=f.read_text().replace('  logic [7:0] lookup_index;','  logic [7:0] lookup_index;\\\\n  logic [1:0] lookup_lane;')\n s=s.replace('  id_stage u_id (', '  id_stage u_id (\\\\n    .lookup_index(lookup_index),')\n s=s.replace('.lookup_index    (lookup_index),','.lookup_lane     (lookup_lane),')\n s=s.replace('  mem_stage u_mem (','  mem_stage u_mem (\\\\n    .hold_id(stall_id), .lookup_lane(lookup_lane), .lookup_width(id_ex_w.ctrl.mem_width), .lookup_sext(id_ex_w.ctrl.mem_sext),')\n i=s.index('    .id_ex_wb_only');j=s.index('    .id_ex_rd',i)\n s=s[:i]+'    .id_ex_wb_only (id_ex_w.valid && is_mul(id_ex_w.ctrl.alu_op)),\\\\n'+s[j:];f.write_text(s)\n f=p/'mem_stage.sv';s=f.read_text().replace('module mem_stage (','module mem_stage (\\\\n  input logic hold_id,\\\\n  input logic [1:0] lookup_lane, lookup_width,\\\\n  input logic lookup_sext,')\n s=s.replace('  logic candidate_valid, update, install;', '''  logic candidate_valid, update, install;\n  logic [9:0] early_tag;\n  logic [7:0] early_inde