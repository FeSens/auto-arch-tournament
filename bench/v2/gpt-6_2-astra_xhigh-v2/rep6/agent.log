{"type":"item.started","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/test_loop_probe.py\" <<'\"'PY'\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADDI,JAL,BNE,SW,EBREAK,NOP\n\n@cocotb.test()\nasync def replay_and_modify(dut):\n    h = 0x3fc\n    original = ADDI(1,1,1)\n    patch = ADDI(1,1,2)\n    mem = {0:ADDI(2,0,7),4:ADDI(3,0,0),8:JAL(0,h-8),\n           h:original, h+4:BNE(1,2,-4), h+8:BNE(3,0,32),\n           h+12:ADDI(3,0,1), h+16:(patch & 0xfffff000)|(4<<7)|0x37,\n           h+20:ADDI(4,4,patch & 0xfff), h+24:SW(4,0,h), h+28:0x100f,\n           h+32:ADDI(2,0,9), h+36:JAL(0,-36), h+40:EBREAK()}\n    cocotb.start_soon(Clock(dut.clock,10,'ns').start())\n    dut.reset.value=1\n    dut.io_dmemRData.value=0\n    dut.io_dmemReady.value=1\n    dut.io_imemReady.value=0\n    dut.io_imemData.value=0\n    for i in range(3):\n        await RisingEdge(dut.clock)\n    await Timer(1,'ns')\n    dut.reset.value=0\n    arrivals=0\n    starve=False\n    starved=[]\n    orders=[]\n    increments=[]\n    stores=0\n    pending=0\n    for cycle in range(250):\n        pc=int(dut.io_imemAddr.value)\n        if pc==h:\n            arrivals+=1\n            if arrivals==5: starve=True\n        ready=not(starve and len(starved)<4)\n        if not ready: starved.append(pc)\n        dut.io_imemReady.value=ready\n        dut.io_imemData.value=mem.get(pc,NOP()) if ready else 0xffffffff\n        wen=int(dut.io_dmemWEn.value)\n        if wen: pending+=1\n        accept=not wen or pending>2\n        dut.io_dmemReady.value=accept\n        dest=int(dut.io_dmemAddr.value)\n        data=int(dut.io_dmemWData.value)\n        await RisingEdge(dut.clock)\n        await Timer(1,'ns')\n        if wen and accept:\n            assert (dest,data,wen)==(h,patch,15)\n            stores+=1\n            mem[dest]=data\n        if int(dut.io_rvfi_valid_0.value):\n            orders.append(int(dut.io_rvfi_order_0.value))\n            assert int(dut.io_rvfi_trap_0.value)==0\n            if int(dut.io_rvfi_pc_rdata_0.value)==h:\n                increments.append(int(dut.io_rvfi_rd_wdata_0.value))\n            if int(dut.io_rvfi_insn_0.value)==EBREAK(): break\n    assert increments==[1,2,3,4,5,6,7,9]\n    assert starved==[h,h+4,h,h+4]\n    assert stores==1 and orders==list(range(len(orders)))\n\ndef test_loop_probe():\n    from pathlib import Path\n    rtl=Path(__file__).resolve().parent.parent/'rtl'\n    run_cocotb('core', ['core_pkg.sv']+[p.name for p in sorted(rtl.glob('*.sv')) if p.name\"'!='\"'core_pkg.sv'], 'test_loop_probe')\nPY\ncat > \\\"\"'$TMPDIR/loop_probe.sh\" <<'\"'SH'\nset -eu\nv=\\\"\"'$1\"\ncp -r cores/bench/test \"$TMPDIR/$v/test\"\ncp \"$TMPDIR/test_loop_probe.py\" \"$TMPDIR/$v/test/\"\npython -m pytest -q \"$TMPDIR/$v/test/test_loop_probe.py\" > \"$TMPDIR/$v/probe.log\" 2>&1\ntail -3 \"$TMPDIR/$v/probe.log\"\nSH\nbash \"$TMPDIR/loop_probe.sh\" serial128'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
