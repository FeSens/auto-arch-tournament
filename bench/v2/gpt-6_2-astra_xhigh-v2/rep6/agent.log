{"type":"item.started","item":{"id":"item_94","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r5-finalproto.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])\nrtl=root/'r5-verify/rtl'\nshutil.copytree(root/'r5-lbu-flat/rtl',rtl,dirs_exist_ok=True)\np=rtl/'mem_stage.sv';s=p.read_text().replace('  logic [3:0] byte_src;', \\\"\\\"\\\"  // Fast MEM-to-EX load result. LB uses the registered WB result.\n  logic [3:0] byte_src;\\\"\\\"\\\").replace('half_sign, pass_alu;', 'half_sign;').replace(\\\"  assign pass_alu  = 1'b0;\\\\n\\\", '')\ns=s.replace('(dmem_rdata[31:24] & {8{byte_src[3]}}) |\\\\n                           (in.alu_result[7:0] & {8{pass_alu}});','(dmem_rdata[31:24] & {8{byte_src[3]}});')\ns=s.replace('(dmem_rdata[31:24] & {8{half_high}}) |\\\\n                            (in.alu_result[15:8] & {8{pass_alu}});','(dmem_rdata[31:24] & {8{half_high}});')\ns=s.replace('{16{half_sign}} | (in.alu_result[31:16] & {16{pass_alu}});','{16{half_sign}};')\nassert 'pass_alu' not in s\np.write_text(s)\nd=root/'r5-verify/test'\nshutil.copytree('cores/bench/test',d,dirs_exist_ok=True)\np=d/'test_pipeline.py';s=p.read_text();at=s.index('@cocotb.test()\\\\nasync def independent_multiplies')\ns=s[:at]+'''@cocotb.test()\nasync def load_bypass_lanes(dut):\n    # Probe both sources of ADD, including sign fill in each halfword.\n    raw = 0x820181fe\n    program, answers = [], []\n    for funct3, offsets in ((0, range(4)), (4, range(4)), (1, (0, 2)), (5, (0, 2)), (2, (0,))):\n        for offset in offsets:\n            width = 8 * (1 << (funct3 & 3))\n            value = (raw >> (8 * offset)) & ((1 << width) - 1)\n            if funct3 < 4 and value & (1 << (width - 1)):\n                value -= 1 << width\n            program += [_i(offset, 0, funct3, 3, 3), ADD(4, 3, 3)]\n            answers.append((value & 0xffffffff, 2 if funct3 == 0 else 1))\n    rets, _ = await _run(dut, program + [EBREAK()], {0: raw})\n    assert len(rets) == len(program) + 1\n    for i, (value, gap) in enumerate(answers):\n        load, add = rets[2*i:2*i+2]\n        assert (load[\\\"rd_wdata\\\"], add[\\\"rs1_rdata\\\"], add[\\\"rs2_rdata\\\"]) == (value,) * 3\n        assert add[\\\"rd_wdata\\\"] == (2 * value) & 0xffffffff\n        assert add[\\\"cycle\\\"] == load[\\\"cycle\\\"] + gap\n\n\n@cocotb.test()\nasync def held_load_to_pointer(dut):\n    program = [LW(5, 0, 0), LW(5, 5, 0), SW(5, 0, 8), EBREAK()]\n    stalls = 0\n    def ready(pc, access):\n        nonlocal stalls\n        if access:\n            stalls += 1\n            return True, stalls % 4 == 0\n        return True, True\n    stores = []\n    rets, _ = await _run(dut, program, {0:4, 4:0x87543210}, bus_ready=ready, stores=stores)\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(4))\n    assert [r[\\\"rs1_rdata\\\"] for r in rets[:2]] == [0,4]\n    assert stores == [(8,15,0x87543210)]\n\n\n@cocotb.test()\nasync def trapping_load_cannot_forward(dut):\n    program = [ADDI(1,0,18), LW(1,0,2), ADD(2,1,1), EBREAK()]\n    rets, _ = await _run(dut, program, {0:0xffffffff})\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert rets[1][\\\"trap\\\"] and rets[1][\\\"mem_rmask\\\"] == 0\n    assert (rets[2][\\\"rs1_rdata\\\"],rets[2][\\\"rs2_rdata\\\"],rets[2][\\\"rd_wdata\\\"]) == (18,18,36)\n\n\n'''+s[at:]\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/r5-finalproto.py\"\ndate -u\ncommand -v pytest'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
