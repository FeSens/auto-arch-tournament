{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c \"git diff --check; cat cores/bench/rtl/reg_file.sv; sed -n '16,52p' cores/bench/rtl/mem_stage.sv; ls -lh \\\"\"'$TMPDIR/check\"/cores/bench/test/test_pipeline_runner.result.xml'","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first by default. RAW_READ leaves same-edge WB collisions\n//     to the core's registered operand selection.\n//\n// The reset clears all 32 registers. Distributed-LUT or flop inference is\n// fine here; explicit BRAM attribution lives on the larger imem/dmem\n// declarations in soc.sv (phase 5).\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file #(\n  parameter bit RAW_READ = 1'b0\n) (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  logic [31:0] regs [0:31];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n    end else if (w_en && w_addr != 5'b0) begin\n      regs[w_addr] <= w_data;\n    end\n  end\n\n  if (RAW_READ) begin : gen_raw\n    assign rs1_data = regs[rs1_addr];\n    assign rs2_data = regs[rs2_addr];\n  end else begin : gen_write_first\n    always_comb begin\n      if (rs1_addr == 5'b0)\n        rs1_data = 32'b0;\n      else if (w_en && w_addr == rs1_addr)\n        rs1_data = w_data;\n      else\n        rs1_data = regs[rs1_addr];\n\n      if (rs2_addr == 5'b0)\n        rs2_data = 32'b0;\n      else if (w_en && w_addr == rs2_addr)\n        rs2_data = w_data;\n      else\n        rs2_data = regs[rs2_addr];\n    end\n  end\n\nendmodule\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata via the loaded-data path.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // hold_wb: dmem stall is in effect. MEM/WB's data fields are RETAINED\n  // (so the previously-retired LOAD's `rd` / `read_data` / `ctrl.reg_write`\n  // remain available to a held EX operand), but `valid` is cleared so:\n  //   - rvfi_order doesn't increment for held cycles\n  //   - wb_stage doesn't write the regfile twice\n  // Zeroing the whole register would lose the LOAD's load_data, breaking\n  // MEM/WB->EX forwarding for any dependent instruction that's also held\n  // in ID/EX during the stall (e.g. a BNE that consumes a LOAD's result).\n  input  logic               hold_wb,\n  input  ex_mem_t  in,\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  output logic               writes_rd,\n  // MEM/WB register output\n  output mem_wb_t  out\n);\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  // shifted[31:16] is dropped on byte/halfword loads; only [15:0] feeds\n  // the sign/zero-extension mux.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] shifted;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [7:0]  byte_val;\n  logic [15:0] hword_val;\n  logic [31:0] load_data;\n-rw-rw----+ 1 hwebench hwebench 7.1K Nov 23 01:09 /srv/hwebench/tmp/51daa901/aa2547ea/check/cores/bench/test/test_pipeline_runner.result.xml\n","exit_code":0,"status":"completed"}}
