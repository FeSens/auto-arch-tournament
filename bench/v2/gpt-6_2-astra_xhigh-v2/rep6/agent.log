{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"sed -n '196,355p;597,660p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def independent_multiplies(dut):\n    program = [\n        ADDI(1, 0, -2), ADDI(2, 0, -3),\n        MUL(3, 1, 2), MULH(4, 1, 2), MULHSU(5, 1, 2), MULHU(6, 1, 2),\n        MUL(0, 1, 2), ADD(7, 0, 2), EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"cycle\"] - rets[0][\"cycle\"] for r in rets] == list(range(len(program)))\n    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets[2:8]] == [\n        (3, 6), (4, 0), (5, 0xFFFFFFFE), (6, 0xFFFFFFFB), (0, 0), (7, 0xFFFFFFFD),\n    ]\n    for r in rets[2:7]:\n        assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"]) == (0xFFFFFFFE, 0xFFFFFFFD)\n        assert (r[\"trap\"], r[\"mem_rmask\"], r[\"mem_wmask\"]) == (0, 0, 0)\n\n\n@cocotb.test()\nasync def multiply_consumers(dut):\n    program = [\n        ADDI(1, 0, -2), ADDI(2, 0, -3),\n        MULHU(3, 1, 2), MUL(4, 3\n…[6168 of 9240 chars elided by tools/bench/transcript.py; sha256:4e36c15a833530a3]…\nll\n        EBREAK(),\n        ADDI(2, 1, 1),\n        EBREAK(),\n    ]\n    fetches = []\n    load_cycles = 0\n\n    def ready(pc, mem_access):\n        nonlocal load_cycles\n        assert not int(dut.io_dmemWEn.value), \"wrong-path store reached dmem\"\n        fetches.append(pc)\n        if mem_access:\n            load_cycles += 1\n            assert pc == 12\n            # Release the load while the wrong-path instruction is unready.\n            return load_cycles < 4, load_cycles == 4\n        return True, True\n\n    rets, _ = await _run(dut, program, {0: 37}, bus_ready=ready)\n    assert load_cycles == 4\n    assert fetches[:8] == [0, 4, 8, 12, 12, 12, 12, 20]\n    pcs = [0, 4, 8, 20, 24]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(not r[\"trap\"] for r in rets)\n    assert rets[1][\"rd_wdata\"] == 37\n    assert (rets[2][\"rd\"], rets[2][\"rd_wdata\"]) == (1, 12)\n    assert rets[3][\"rd_wdata\"] == 13\n\n\n", "exit_code": 0, "status": "completed"}}
