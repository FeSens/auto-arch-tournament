{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/packed\"\ncp -r \"$TMPDIR/narrow/rtl\" \"$TMPDIR/packed/rtl\"\ncat > \"$TMPDIR/packed/modify.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,re\np=Path(os.environ['TMPDIR'])/'packed/rtl/alu.sv'\nbody=(Path(os.environ['TMPDIR'])/'narrow/rtl/alu.sv').read_text()\ndef pack_in(s):\n terms=[]\n for g in range(6,-1,-1):\n  if s\"'!=4: terms.append(f\"{4-s}'\"'b0\\\")\n  terms.append(f'dividend_q[{(g+1)*s-1}:{g*s}]')\n if s\"'!=4: terms.append(f\"{4-s}'\"'b0\\\")\n terms.append(f'first_digit_{s}')\n return '{'+', '.join(terms)+'}'\ndef unpack_q(s):\n terms=[]\n if s<4: terms.append(f\\\"{32-8*s}'b0\\\")\n for g in range(7,-1,-1):\n  terms.append(f'quotient_next[{4*g+s-1}:{4*g}]')\n return '{'+', '.join(terms)+'}'\nfor s in range(1,5):\n body=re.sub(rf'(wire \\\\[31:0\\\\] start_q_{s} = )[\"'^;]+;'\"',lambda m: m[1]+pack_in(s)+';',body)\n body=re.sub(rf'(wire \\\\[31:0\\\\] q_{s} = )[\"'^;]+;'\"',lambda m:m[1]+unpack_q(s)+';',body)\n body=body.replace(f'quotient_q[{31-s}:{32-2*s}]', f'quotient_q[{24+s-1}:24]')\nbody=body.replace('assign quotient_next = ', 'wire [31:0] final_quotient = ')\nbody=body.replace('  wire [31:0] q_1', '  assign quotient_next = {quotient_q[27:0], digit};\\\\n  wire [31:0] q_1')\nbody=body.replace('rem_q ? remainder_next : quotient_next;', 'rem_q ? remainder_next : final_quotient;')\n# Register a kept divisor-class enable for each eligible digit group.\n# All later rounds use the same table of multiples.\nfor bit,(mask,now) in enumerate([('(|mode_q[3:1])','(|mode[3:1])'),('(|mode_q[3:2])','(|mode[3:2])')]):\n body=body.replace(mask, f'eligible_{bit}')\n body=body.replace('  wire [15:0] ok, winner;', f'  logic eligible_{bit};\\\\n  always_ff @(posedge clock) if (phase_q[0]) eligible_{bit} <= {now};\\\\n  wire [15:0] ok, winner;')\np.write_text(body)\nPY\npython \\\"\"'$TMPDIR/packed/modify.py\"\ncat > \"$TMPDIR/time_variant.py\" <<'\"'PY'\nimport sys,os\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\nd=Path(os.environ['TMPDIR'])/sys.argv[1]\nres=build_all(Path.cwd(),d/'rtl','fpga/core_bench_si.sv',d/'timing',options=tuple(map(int,sys.argv[2:])))\nfor v in res:\n print(v['place_option'],v['fmax_mhz'],[(q['from'],q['to']) for q in v.get('critical_paths',[])],v.get('reason',''))\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/time_variant.py\" packed 1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
