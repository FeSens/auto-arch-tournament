{"type": "item.completed", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// Base integer results are combinational. DIV/REM share a blocking\n// radix-16 divider with a 16-bit trial divisor and a fixed response time.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_resp_valid,\n  input  logic        div_resp_ready,\n  output logic [31:0] div_result,\n  output logic [31:0] div_magnitude,\n  output logic        div_negate,\n  output div_completion_t div_completion\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:    out = 32'b0;\n    endcase\n  end\n\n  // A request advances through setup (bit 0) and six rounds (bits 1..6).\n  logic [6:0] phase_q;\n  logic       div_issue;\n  assign div_req_ready = (phase_q == '0) && !div_resp_valid;\n  assign div_issue     = div_req_valid && div_req_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q        <= '0;\n      div_resp_valid <= 1'b0;\n    end else begin\n      phase_q        <= {phase_q[5:0], div_issue};\n      div_resp_valid <= phase_q[6] || (div_resp_valid && !div_resp_ready);\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (div_req_ready) begin\n      case (op)\n        ALU_DIV:  div_completion.quotient <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_completion.quotient <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_completion.quotient <= (a - b) ^\n…[7093 of 10165 chars elided by tools/bench/transcript.py; sha256:6cd9c3382e8b78c3]…\nder_q} << (1 << i)) & {32{scale_q[i]}};\n  end\n  always_ff @(posedge clock) begin\n    if (phase_q[6]) begin\n      unscaled_q <= zero_q ? dividend_q : unscaled;\n      product_q  <= quotient_q[15:0] * divisor_lo_q;\n      estimate_q <= zero_q ? 32'hffffffff : {16'd0, quotient_q[15:0]};\n    end\n  end\n\n  // R = N - q*D lies strictly between -D and D. Its borrow selects a\n  // single correction in MEM. For zero divisors the low mask and product\n  // are zero, giving the saved dividend and the explicit all-ones quotient.\n  assign difference = {1'b0, unscaled_q} - {1'b0, product_q};\n  assign div_completion.borrow   = large_q && difference[32];\n  assign div_completion.quotient = large_q || zero_q ? estimate_q : {quotient_q[27:0], digit};\n  assign div_completion.residual = large_q || zero_q ? difference[31:0] : {16'b0, remainder_next};\n`endif\n\n  assign div_result    = finish_divide(div_completion);\n  assign div_negate    = div_completion.negate;\n  assign div_magnitude = div_negate ? -div_result : div_result;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
