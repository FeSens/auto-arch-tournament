{"type": "item.started", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/loop_buffer.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,os,shutil\nfrom tools.eval.gowin import build_all\nroot=Path(os.environ['TMPDIR']); name=sys.argv[1]\nd=root/name/'rtl';shutil.copytree('cores/bench/rtl',d)\np=d/'core.sv';s=p.read_text().replace('  if_stage u_if (','''  logic fetch_available;\n  if_stage u_if (\n    .available       (fetch_available),\n    .store_accept    ((|io_dmemWEn) && io_dmemReady),\n    .store_addr      (io_dmemAddr),''').replace('    .imem_ready     (io_imemReady),\\\\n    .dmem_ready', '    .imem_ready     (fetch_available),\\\\n    .dmem_ready')\np.write_text(s)\np=d/'if_stage.sv';s=p.read_text().replace('  input  logic              imem_ready,','''  input  logic              imem_ready,\n  output logic              available,\n  input  logic              store_accept,\n  input  logic [31:0]       store_addr,''')\nstart=s.index('  assign is_branch');end=s.index('  // A correction',start)\ns=s[:start]+'''  // Capture a loop trace from its predicted head to its closing backedge.\n  localparam W = 6;\n  logic        capture, replay;\n  logic [31:0] loop_head, loop_tail;\n  logic [W-1:0] cursor, last;\n  logic [31:0] trace_pc [0:(1<<W)-1];\n  logic [31:0] trace_word [0:(1<<W)-1];\n  logic [31:0] trace_target [0:(1<<W)-1];\n  logic [1:0]  trace_kind [0:(1<<W)-1];\n  logic [31:0] live_target;\n  logic [31:0] word;\n  logic live_branch,live_jal,hit;\n  assign hit = replay && trace_pc[cursor] == pc;\n  assign available = hit || imem_ready;\n  assign word = hit ? trace_word[cursor] : imem_data;\n  assign live_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] \"'!= 2'\"'b01;\n  assign live_jal = imem_data[6:0] == 7'b1101111;\n  assign displacement = imem_data[2]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign live_target = pc + displacement;\n  assign target = hit ? trace_target[cursor] : live_target;\n  assign {is_jal,is_branch} = hit ? trace_kind[cursor] : {live_jal,live_branch};\n  assign predicted_taken = (is_jal || (is_branch && counter[1]))\n                        && target[1:0] == 2'b00 && target[31:20] == 12'b0;\n\n  logic backedge, span_store, inside_span, fence_i;\n  assign backedge = is_branch && predicted_taken && word[31];\n  assign fence_i = word[6:0] == 7'b0001111 && word[14:12] == 3'b001;\n  assign span_store = store_accept && store_addr[31:2] >= loop_head[31:2] &&\n                                      store_addr[31:2] <= loop_tail[31:2];\n  assign inside_span = pc >= loop_head && pc <= loop_tail;\n  always_ff @(posedge clock) begin\n    if (capture && \"'!stall && !redirect) begin\n      trace_pc[cursor] <= pc;\n      trace_word[cursor] <= imem_data;\n      trace_target[cursor] <= live_target;\n      trace_kind[cursor] <= {live_jal,live_branch};\n    end\n    if (reset || redirect || ((capture || replay) && span_store) || (!stall && fence_i)) begin\n      capture <= 0;\n      replay <= 0;\n      cursor <= 0;\n    end else if (!stall) begin\n      if (replay && hit) begin\n        if (cursor == last) begin\n          cursor <= 0;\n          replay <= backedge && target == loop_head;\n        end else cursor <= cursor + 1'\"'b1;\n      end else if (capture && inside_span) begin\n        if (pc == loop_tail && backedge && target == loop_head) begin\n          capture <= 0; replay <= 1; last <= cursor; cursor <= 0;\n        end else if (&cursor) begin\n          capture <= 0; cursor <= 0;\n        end else cursor <= cursor + 1'b1;\n      end else begin\n        capture <= backedge;\n        replay <= 0;\n        cursor <= 0;\n        if (backedge) begin\n          loop_head <= target;\n          loop_tail <= pc;\n        end\n      end\n    end\n  end\n\n'''+s[end:]\ns=s.replace('out.instr             = imem_data;', 'out.instr             = word;').replace('out.valid             = imem_ready;', 'out.valid             = available;')\np.write_text(s)\nfor r in build_all('.',d,'fpga/core_bench_si.sv',d.parent/'p'):\n print(r['place_option'],r['fmax_mhz'],r.get('critical_paths',[None])[0],flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/loop_buffer.py\" loop64'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
