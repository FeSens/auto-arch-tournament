s=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ncores/bench/test/test_pipeline.py:63:def DIV (rd, rs1, rs2): return _r(1, rs2, rs1, 0b100, rd, 0b0110011)\ncores/bench/test/test_pipeline.py:64:def DIVU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b101, rd, 0b0110011)\ncores/bench/test/test_pipeline.py:315:async def divide_writeback_consumers(dut):\ncores/bench/test/test_pipeline.py:317:    unsigned_q, unsigned_r = divmod(0xFFFFFFE1, 7)\ncores/bench/test/test_pipeline.py:318:    results = ((DIV, -4), (DIVU, unsigned_q), (REM, -3), (REMU, unsigned_r))\ncores/bench/test/test_pipeline.py:333:async def load_div_rem_store_with_stalls(dut):\ncores/bench/test/test_pipeline.py:336:        LW(1, 0, 0),       # -101, forwarded from WB to the first divide\ncores/bench/test/test_pipeline.py:337:        DIV(3, 1, 2),      # -101 / 7 = -14\ncores/bench/test/test_pipeline.py:339:        DIV(5, 3, 4),      # -14 / -3 = 4\ncores/bench/test/test_pipeline.py:340:        SW(5, 0, 4),       # consume the immediately preceding divide\ncores/bench/test/test_pipeline.py:341:        DIV(6, 5, 4),      # wait behind the stalled store, then use x5 from WB\ncores/bench/test/test_pipeline.py:350:        # the last divide's transfer. Stall each data access for three edges.\ncores/bench/test/test_pipeline.py:759:async def subword_branch_and_divide_replay(dut):\ncores/bench/test/test_pipeline.py:765:        _i(0x82, 0, 4, 1, 0x03), DIV(3, 1, 2),    # stale 255, correct 3\ncores/bench/test/test_decoder.py:12:    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\ncores/bench/test/test_decoder.py:67:        (0x023140B3, ALU_DIV),\ncores/bench/test/test_decoder.py:68:        (0x023150B3, ALU_DIVU),\n","exit_code":0,"status":"completed"}}
