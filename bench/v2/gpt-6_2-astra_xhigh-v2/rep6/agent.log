{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r5-source.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil,sys\nroot=Path(os.environ['TMPDIR']); rtl=root/sys.argv[1]/'rtl'\nshutil.copytree(root/'r5-fwdsel/rtl',rtl,dirs_exist_ok=True)\np=rtl/'reg_file.sv';s=p.read_text().replace('module reg_file (', \\\"module reg_file #(parameter bit RAW_READ = 1'b0) (\\\")\nstart=s.index('  always_comb begin')\ns=s[:start]+\\\"\\\"\\\"  if (RAW_READ) begin\n    assign rs1_data = regs[rs1_addr];\n    assign rs2_data = regs[rs2_addr];\n  end else \\\"\\\"\\\"+s[start:].lstrip()\np.write_text(s)\np=rtl/'core.sv';s=p.read_text()\ns=s.replace('reg_file u_rf', \\\"reg_file #(.RAW_READ(1'b1)) u_rf\\\").replace('  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', '  logic [3:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n  logic [31:0] issue_wb;')\ns=s.replace('    .fwd_ex_mem      (', '    .issue_wb        (issue_wb),\\\\n    .fwd_ex_mem      (')\nstart=s.index('  logic [1:0] issue_src1');end=s.index('  // ── RVFI',start)\ns=s[:start]+\\\"\\\"\\\"  function automatic logic [3:0] get_source(input logic [4:0] rs);\n    logic ex_hit, mem_hit, wb_hit;\n    ex_hit = id_ex_w.rd == rs && ex_will_write;\n    mem_hit = ex_mem_w.rd == rs && mem_will_write;\n    wb_hit = wb_w_addr == rs && wb_w_en;\n    if (rs == 0) get_source = 4'b0000;\n    else get_source = {ex_hit, \"'!ex_hit && mem_hit, !ex_hit && !mem_hit && wb_hit, !ex_hit && !mem_hit && !wb_hit};\n  endfunction\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      fwd_rs1_sel <= get_source(rs1_addr_w);\n      fwd_rs2_sel <= get_source(rs2_addr_w);\n      issue_wb <= wb_w_data;\n    end\n  end\n\n\"\"\"+s[end:]\np.write_text(s)\np=rtl/'\"'ex_stage.sv';s=p.read_text().replace('input  logic [1:0]         fwd_rs','input  logic [3:0]         fwd_rs')\ns=s.replace('  input  logic [31:0]        fwd_ex_mem', '  input  logic [31:0]        issue_wb,\\\\n  input  logic [31:0]        fwd