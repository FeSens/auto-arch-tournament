{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/btb\" && cp -r cores/bench/rtl \"$TMPDIR/btb/rtl\" && python3 - <<'\"'PY'\nfrom pathlib import Path\nimport tempfile\np=Path(tempfile.gettempdir())/'btb'/'rtl'\ndef rep(file,s,t):\n f=p/file; text=f.read_text(); assert text.count(s)==1,(file,s,text.count(s)); f.write_text(text.replace(s,t))\nrep('core_pkg.sv','  // ID/EX register payload.\\\\n  typedef struct packed {','''  // ID/EX register payload.\n  typedef struct packed {\n    logic [1:0] pred_ctr;\n    logic pred_taken;''')\nrep('if_stage.sv','  output logic [31:0]       imem_addr,','''  input logic pred_taken,\n  input logic [17:0] pred_target,\n  output logic [31:0]       imem_addr,''')\nrep('if_stage.sv',\\\"next_pc = redirect ? redirect_target : pc + 32'd4;\\\",\\\"next_pc = pred_taken ? {12'b0,pred_target,2'b00} : pc + 32'd4;\\\")\nrep('id_stage.sv','  input  if_id_t  in,','''  input  if_id_t  in,\n  input logic [1:0] pred_ctr,\n  input logic pred_taken,''')\nrep('id_stage.sv','      reg_q.pc       <= in.pc;','''      reg_q.pc       <= in.pc;\n      reg_q.pred_taken <= pred_taken;\n      reg_q.pred_ctr   <= pred_ctr;''')\nrep('ex_stage.sv','  output logic               div_wait,','''  output logic               div_wait,\n  input logic [31:0] fetch_pc,\n  output logic train_taken,\n  output logic [31:0] train_target,''')\nrep('ex_stage.sv','''  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;'\"''','''  logic [31:0] fallthrough;\n  assign fallthrough = in.pc + 32'd4;\n  assign train_target = in.ctrl.is_jump ? jump_target : branch_target;\n  assign train_taken = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect_target = train_taken ? train_target : fallthrough;\n  assign redirect = in.valid && !stall && !div_wait &&\n                    (train_taken ? fetch_pc