ut.div_req_ready.value)\n257:    dut.div_resp_ready.value = 1\n259:    assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n261:    dut.div_req_valid.value = 0\n264:    assert int(dut.div_resp_valid.value) and int(dut.div_result.value) == 15\n266:    assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n308:                await _check_div(dut, ALU_REMU, dividend, divisor, remainder, hold_cycles=2)\n335:        dut.div_resp_ready.value = 0\n339:        assert not int(dut.div_req_ready.value)\n340:        assert int(dut.div_resp_valid.value) == (elapsed >= DIV_LATENCY)\n345:            assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n","exit_code":0,"status":"completed"}}
