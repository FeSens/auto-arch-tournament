{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/divide_research/design8.py\" <<'\"'PY'\nfrom pathlib import Path\nroot=Path(__file__).parent\nsrc=(Path('cores/bench/rtl/alu.sv')).read_text()\nsrc=src.replace('logic [33:0] divisor_1x, divisor_2x, divisor_3x_q;', 'logic [34:0] multiples [1:7];')\nsrc=src[:src.index('  // D and 2D')] + \\\"\\\"\\\"  assign multiples[1] = {3'b0, divisor_q};\n  assign multiples[2] = multiples[1] << 1;\n  assign multiples[4] = multiples[1] << 2;\n  assign multiples[6] = multiples[3] << 1;\n  always_ff @(posedge clock) begin\n    if (phase_q[0]) begin\n      multiples[3] <= multiples[1] + multiples[2];\n      multiples[5] <= multiples[1] + multiples[4];\n      multiples[7] <= (multiples[1] << 3) - multiples[1];\n    end\n  end\n\n  always_comb begin\n    logic [34:0] shifted;\n    logic [35:0] trial [0:7];\n    logic [7:0] fits, select_digit;\n    logic [2:0] digit;\n    quotient_next  = quotient_q;\n    remainder_next = remainder_q;\n    for (int i = 0; i < 2; i++) begin\n      shifted = {remainder_next, quotient_next[35:33]};\n      trial[0] = {1'b0, shifted};\n      fits[0] = 1'b1;\n      for (int k = 1; k < 8; k++) begin\n        trial[k] = {1'b0, shifted} - {1'b0, multiples[k]};\n        fits[k] = \"'!trial[k][35];\n      end\n      select_digit = fits & ~{1'\"'b0,fits[7:1]};\n      digit = {|select_digit[7:4], |(select_digit & 8'hcc), |(select_digit & 8'haa)};\n      remainder_next = '0;\n      for (int k = 0; k < 8; k++) begin\n        remainder_next |= {32{select_digit[k]}} & trial[k][31:0];\n      end\n      quotient_next = {quotient_next[32:0], digit};\n    end\n  end\n\n\\\"\\\"\\\" + src[src.index('  always_ff @(posedge clock) begin\\\\n    if (div_issue) begin\\\\n      divisor_q'):]\n(root/'radix8/rtl/alu.sv').write_text(src)\nPY\ncat > \\\"\"'$TMPDIR/divide_research/timeit_div.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nimport json,sys\nroot=Path(__file__).parent/sys.argv[1]\nopts=tuple(map(int,sys.argv[2:])) or (0,1,2)\nr=build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing',options=opts)\n(root/('result'+''.join(map(str,opts))+'.json')).write_text(json.dumps(r,indent=2))\nfor t in r:\n print(t.get('fmax_mhz'), t.get('logic'),(t.get('critical_paths') or [t])[0])\nPY\npython \\\"\"'$TMPDIR/divide_research/design8.py\" && PYTHONPATH=. python \"$TMPDIR/divide_research/timeit_div.py\" radix8'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
