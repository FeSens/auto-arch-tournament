{"type": "item.completed", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"sed -n '430,760p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def stalled_successor_chain(dut):\n    program = [\n        ADDI(1, 0, 5), JAL(5, 12), EBREAK(), EBREAK(),\n        ADDI(1, 1, -1), BNE(1, 0, -16), EBREAK(),\n    ]\n    jump_fetches = 0\n\n    def ready(pc, mem_access):\n        nonlocal jump_fetches\n        assert not mem_access, \"poisoned bus store reached MEM\"\n        if pc == 4:\n            jump_fetches += 1\n            # The first back edge trains the branch's corrected successor.\n            return jump_fetches <= 2, True\n        if pc in (16, 20):\n            return jump_fetches <= 1, True\n        return True, True\n\n    rets, _ = await _run(dut, program, bus_ready=ready, stalled_word=SW(0, 0, 0))\n    pcs = [0] + [4, 16, 20] * 5 + [24]\n    _check_path(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 16] == [4, 3, 2, 1, 0]\n    assert all(r[\"rd_wdata\"] == 8 for r in rets if r[\"pc\"] == 4)\n    # The cached JAL and conditional branch each steer IF without a bubble.\n    warm = rets[4:-1]\n    assert [r[\"cycle\"] - warm[0][\"cycle\"] for r in warm] == list(range(len(warm)))\n    # One final, verified JAL fetch is squashed on the branch's exit.\n    assert jump_fetches == 6 and rets[-1][\"cycle\"] == warm[-1][\"cycle\"] + 2\n\n\n@cocotb.test()\nasync def cached_branch_uses_current_direction(dut):\n    program = [\n        ADDI(1, 0, 8), ADDI(2, 0, 3), ADDI(1, 1, -1),\n        _b(12, 1, 2, 4, 0x63),  # BLT x2,x1,+12 changes direction halfway through\n        NOP(), JAL(0, 8), NOP(), BNE(1, 0, -20), EBREAK(),\n    ]\n    branch_fetches = 0\n\n    def ready(pc, mem_access):\n        nonlocal branch_fetches\n        if pc == 12:\n            branch_fetches += 1\n            return branch_fetches == 1, True\n       