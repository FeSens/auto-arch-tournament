{"type": "item.completed", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,140p' formal/run_all.sh && sed -n '1,120p' formal/checks_si.cfg && cat cores/bench/test/_helpers.py | head -80\"", "aggregated_output": "#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env vars (orchestrator-driven, override $1 and defaults):\n#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n# When BOTH are unset, the script auto-detects nret from\n# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n# invoking `bash formal/run_all.sh` directly therefore get the\n# right wrapper without needing to know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[6233 of 9305 chars elided by tools/bench/transcript.py; sha256:071ec473bfa55f18]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/btb_r15/lane.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,os,shutil\nname=sys.argv[1]; out=Path(os.environ['TMPDIR'])/('lane_'+name)/'rtl';shutil.copytree('cores/bench/rtl',out,dirs_exist_ok=True)\ndef replace(f,old,new):\n p=out/f;s=p.read_text();assert old in s;p.write_text(s.replace(old,new))\nreplace('ex_stage.sv','output logic [7:0]         lookup_index,','output logic [7:0]         lookup_index,\\\\n  output logic [1:0]         lookup_lane,')\nreplace('ex_stage.sv','  assign lookup_index[7:3]', '  assign lookup_lane = rs1[1:0]+in.imm[1:0];\\\\n  assign lookup_index[7:3]')\nreplace('core.sv','  logic [7:0] lookup_index;', '  logic [7:0] lookup_index;\\\\n  logic [1:0] lookup_lane;')\nreplace('core.sv','.lookup_index    (lookup_index),','.lookup_index    (lookup_index), .lookup_lane(lookup_lane),')\nreplace('core.sv','.lookup_word    (id_ex_w.ctrl.mem_width[1]),','.lookup_lane(lookup_lane), .lookup_width(id_ex_w.ctrl.mem_width), .lookup_sext(id_ex_w.ctrl.mem_sext),')\np=out/'mem_stage.sv';s=p.read_text().replace('input  logic               lookup_word,','input logic [1:0] lookup_lane, lookup_width,\\\\n  input logic lookup_sext,')\ns=s[:s.index('  // One synchronous row')] + '''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [41:0] words [0:255];\n  logic [41:0] lookup_row;\n  logic [255:0] occupied;\n  logic [7:0] candidate_index, update_index;\n  logic [9:0] candidate_tag;\n  logic [31:0] saved_raw, raw_word, row_word;\n  logic candidate_valid, update, install, word_width, word_hit;\n  assign lookup_row=words[lookup_index];\n  assign update_index=in.effective_addr[9:2];\n  assign word_width=in.ctrl.mem_width[1];\n  assign word_hit = in.ctrl.mem_read && \"'!mem_misalign && candidate_valid &&\n                    {12'\"'b0, candidate_tag, candidate_index} == in.effective_addr[31:2];\n  assign load_hit = word_hit;\n  assign raw_word = word_hit ? saved_raw : dmem_rdata;\n  assign row_word = in.ctrl.mem_write ? in.write_data : dmem_rdata;\n  assign update = \"'!reset && in.effective_addr[31:20] == 0 && dmem_ready &&\n                             !mem_misalign && (dmem_ren || in.ctrl.mem_write);\n  assign install = in.ctrl.mem_read || word_width;\n  always_ff @(posedge clock) begin\n    if (!hold_wb) {candidate_tag,saved_raw} <= lookup_row;\n    if (update && install) words[update_index] <= {in.effective_addr[19:10],row_word};\n  end\n'\"''' + s[s.index('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      occupied'):]\ni=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      occupied')\nif 'ports' in name:\n fmt='''  (* syn_ramstyle = \\\"block_ram\\\" *) logic [7:0] low [0:1023];\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [7:0] middle [0:2047];\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [15:0] high [0:2047];\n  logic [2:0] mid_fmt, high_fmt;\n  assign mid_fmt = lookup_width[1] ? 3'd0 : lookup_width[0] ? {2'b00,lookup_lane[1]} :\n                    lookup_sext ? {1'b1,lookup_lane} : 3'd2;\n  assign high_fmt = lookup_width[1] ? 3'd0 : \"'!lookup_sext ? 3'\"'d1 :\n                    {1'b1,lookup_lane | {1'b0,lookup_width[0]}};\n  for(genvar k=0;k<4;k++) begin\n    always_ff @(posedge clock) if(update && install) low[{update_index,2'(k)}] <= row_word[8*k+:8];\n  end\n  for(genvar k=0;k<8;k++) begin\n    always_ff @(posedge clock) if(update && install) begin\n      if(k<2) middle[{update_index,3'(k)}] <= row_word[16*k+8+:8];\n      else if(k<4) middle[{update_index,3'(k)}] <= '0;\n      else middle[{update_index,3'(k)}] <= {8{row_word[8*(k-4)+7]}};\n      if(k==0) high[{update_index,3'(k)}] <= row_word[31:16];\n      else if(k<4) high[{update_index,3'(k)}] <= '0;\n      else high[{update_index,3'(k)}] <= {16{row_word[8*(k-4)+7]}};\n    end\n  end\n  always_ff @(posedge clock) if(\"'!hold_wb) begin\n    predicted_value[7:0] <= low[{lookup_index,lookup_lane}];\n    predicted_value[15:8] <= middle[{lookup_index,mid_fmt}];\n    predicted_value[31:16] <= high[{lookup_index,high_fmt}];\n  end\n'\"'''\nelse:\n fmt='''  logic [31:0] lookup_shift;\n  assign lookup_shift=lookup_row[31:0]>>(lookup_lane*8);\n  always_ff @(posedge clock) if(\"'!hold_wb)\n    predicted_value <= lookup_width[1] ? lookup_row[31:0] : lookup_width[0] ?\n                      {{16{lookup_sext && lookup_shift[15]}},lookup_shift[15:0]} :\n                      {{24{lookup_sext && lookup_shift[7]}},lookup_shift[7:0]};\n'\"'''\ns=s[:i]+fmt+s[i:]\nif 'block' in name: s=s.replace('syn_ramstyle = \\\"distributed_ram\\\"', 'syn_ramstyle = \\\"block_ram\\\"')\nif 'check' in name:\n a=s.index('  assign load_hit = word_hit;')\n b=s.index('\\\\n',a)\n s=s[:a]+'''  logic [31:0] checked, picked;\n  assign picked = saved_raw >> (in.effective_addr[1:0]*8);\n  assign checked = word_width ? saved_raw : in.ctrl.mem_width[0] ?\n                   {{16{in.ctrl.mem_sext && picked[15]}}, picked[15:0]} :\n                   {{24{in.ctrl.mem_sext && picked[7]}}, picked[7:0]};\n  assign load_hit = word_hit && predicted_value==checked;'''+s[b:]\n s=s.replace('assign row_word = in.ctrl.mem_write ? in.write_data : dmem_rdata;', 'assign row_word = in.ctrl.mem_write ? in.write_data : raw_word;')\n s=s.replace('word_width ? dmem_rdata : formatted_value','word_width ? raw_word : formatted_value')\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/btb_r15/lane.py\" raw && python \"$TMPDIR/btb_r15/lane.py\" ports_block_check'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
