{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/lanepred.UHOyuc/dyncarry.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil,sys\np=Path(__file__).parent\nname=sys.argv[1]\nrtl=p/name; shutil.copytree('cores/bench/rtl', rtl)\nn=int(name.split('_')[1]); g=int(name.split('_')[2])\ndef edit(f,a,b):\n p=rtl/f; s=p.read_text(); assert a in s; p.write_text(s.replace(a,b))\nedit('core_pkg.sv','logic        recover_fallthrough;','logic [7:0]  lookup_xor;\\\\n    logic        recover_fallthrough;')\nedit('id_stage.sv','input  logic              wb_en,', 'input  ex_mem_t           load_source,\\\\n  input  logic              load_advances,\\\\n  input  logic              wb_en,')\nedit('core.sv','.wb_en    (wb_w_en),', '.load_source (ex_mem_w),\\\\n    .load_advances (\"'!stall_ex_mem),'\"\\\\n    .wb_en    (wb_w_en),')\n# Predict base-XOR-effective-address for each group. The whole displacement influence observed previously replaces the immediate. Aliases are safe on checked lookup.\nbits=list(range(2,10,g))\ndecl=f'  logic [{len(bits)-1}:0] correction;\\\\n' if g\"'!=1 else '\"'  logic [7:0] correction;\\\\n'\nk=(len(bits) if g\"'!=1 else 8)\ndecl+=f'\"'''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [{k-1}:0] masks [0:{(1<<n)-1}];\n  logic write_sample;\n  logic [{k-1}:0] trained;\n  logic [{n-1}:0] sample_index;\n  assign correction = masks[in.pc[{n+1}:2]];\n  always_ff @(posedge clock) begin\n    write_sample <= \"'!reset && load_advances && load_source.valid && load_source.ctrl.mem_read;\n    sample_index <= load_source.pc[{n+1}:2];\n'\"'''\n# Dynamically observe carry in to each group, offset = I-immediate.\nif g==1:\n decl+='    trained <= load_source.effective_addr[9:2] \"'^ load_source.rs1_val[9:2] ''^ load_source.instr[29:22];'\"\\\\n'\nelse:\n for j,b in enumerate(bits): decl+=f'    trained[{j}] <= load_source.effective_addr[{b}] \"'^ load_source.rs1_val[{b}] ''^ load_source.instr[{20+b}];'\"\\\\n'\ndecl+='    if (write_sample) masks[sample_index] <= trained;\\\\n  end\\\\n'\nedit('id_stage.sv','  id_ex_t reg_q;',decl+'  id_ex_t reg_q;')\nkey='  assign lookup_index[7:3] = rs1[9:5] + in.imm[9:5];\\\\n  assign lookup_index[2:0] = rs1[4:2] + in.imm[4:2];'\nif g==1:\n edit('id_stage.sv','      reg_q.pc       <= in.pc;','      reg_q.lookup_xor <= in.instr[29:22] \"'^ correction;'\"\\\\n      reg_q.pc       <= in.pc;')\n edit('ex_stage.sv',key,'  assign lookup_index = rs1[9:2] \"'^ in.lookup_xor;'\"')\nelse:\n ids=''; es=''\n for j,b in enumerate(bits):\n  e=min(b+g,10)-1\n  ids+=f'      reg_q.lookup_xor[{e-2}:{b-2}] <= in.instr[{e+20}:{b+20}] + {e-b+1}\\\\'(correction[{j}]);\\\\n'\n  es+=f'  assign lookup_index[{e-2}:{b-2}] = rs1[{e}:{b}] + in.lookup_xor[{e-2}:{b-2}];\\\\n'\n edit('id_stage.sv','      reg_q.pc       <= in.pc;',ids+'      reg_q.pc       <= in.pc;')\n edit('ex_stage.sv',key,es)\nPY\nfor n in hist_6_1 hist_6_2 hist_7_1; do python \\\"\"'$TMPDIR/lanepred.UHOyuc/dyncarry.py\" \"$n\"; done\npython - <<'\"'PY'\nfrom pathlib import Path\nimport os,json\np=Path(os.environ['TMPDIR'])/'lanepred.UHOyuc'\nfor f in p.glob('bench_carry*.log'):\n m=json.loads(f.read_text().splitlines()[-1]);print(f.name, m['bench_stop_cycle']-m['bench_start_cycle'])\nfor f in p.glob('result_carry*'):\n r=json.loads(f.read_text());print(f.name, r['fmax_mhz'])\nPY\ndate -u\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
