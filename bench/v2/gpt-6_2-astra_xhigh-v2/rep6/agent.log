{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/wb_r14.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nimport shutil,sys\nfor name in sys.argv[1:]:\n    p=Path(gettempdir())/('r14_'+name)/'rtl'\n    shutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\n    m=p/'mem_stage.sv'; w=p/'wb_stage.sv'; a=m.read_text(); b=w.read_text()\n    mres='is_mul(in.ctrl.alu_op) ? mul_result :\\\\n                          in.div_valid ? div_result : in.alu_result'\n    lres='load_hit ? predicted_value : (word_width ? dmem_rdata : formatted_value)'\n    if name=='wb':\n        a=a.replace(mres,'in.ctrl.mem_to_reg ? ('+lres+') :\\\\n                          '+mres)\n        b=b.replace('in.ctrl.mem_to_reg ? in.read_data : in.alu_result','in.alu_result')\n        # Reuse the same registered bus for deferred trace load.\n        a=a.replace('reg_q.ctrl.reg_write ? reg_q.read_data','reg_q.ctrl.reg_write ? reg_q.alu_result')\n    if name=='wbone':\n        a=a.replace('  // ── MEM/WB register', '''  logic take_alu, take_word, take_pred, take_format, take_mul;\n  assign take_mul = is_mul(in.ctrl.alu_op);\n  assign take_alu = \"'!(in.ctrl.mem_to_reg || in.div_valid || take_mul);\n  assign take_pred = load_hit;\n  assign take_word = in.ctrl.mem_to_reg && !load_hit && word_width;\n  assign take_format = in.ctrl.mem_to_reg && !load_hit && !word_width;\n  // ── MEM/WB register'\"''')\n        a=a.replace(mres,'''({32{take_alu}} & in.alu_result)\n          | ({32{take_mul}} & mul_result) | ({32{in.div_valid}} & div_result)\n          | ({32{take_pred}} & predicted_value) | ({32{take_word}} & dmem_rdata)\n          | ({32{take_format}} & formatted_value)''')\n        b=b.replace('in.ctrl.mem_to_reg ? in.read_data : in.alu_result','in.alu_result')\n        a=a.replace('reg_q.ctrl.reg_write ? reg_q.read_data','reg_q.ctrl.reg_write ? reg_q.alu_result')\n    if name=='wbsplit':\n        # Let WB OR masked pieces that are registered on entry.\n        a=a.replace(mres,'in.ctrl.mem_to_reg ? 32\\\\'b0 : '+mres).replace('<= '+lres,'<= in.ctrl.mem_to_reg ? ('+lres+') : 32\\\\'b0')\n        b=b.replace('in.ctrl.mem_to_reg ? in.read_data : in.alu_result','in.read_data | in.alu_result')\n    m.write_text(a);w.write_text(b)\nPY\npython -B \\\"\"'$TMPDIR/wb_r14.py\" wb wbone wbsplit'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
