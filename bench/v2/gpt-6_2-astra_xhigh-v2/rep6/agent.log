{"type":"item.completed","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -c 'diff -u cores/bench/rtl/ex_stage.sv /srv/hwebench/tmp/51daa901/71a15ab2/operand-issue.mzghZskB/trial-link_alignment/rtl/ex_stage.sv'","aggregated_output":"--- cores/bench/rtl/ex_stage.sv\t2026-11-23 04:48:55.823259466 +0100\n+++ /srv/hwebench/tmp/51daa901/71a15ab2/operand-issue.mzghZskB/trial-link_alignment/rtl/ex_stage.sv\t2026-11-23 04:45:18.492231699 +0100\n@@ -97,8 +97,8 @@\n   // ── Branch resolve ────────────────────────────────────────────────────\n   logic        branch_cond;\n   logic        taken;\n-  logic [31:0] target_sum, transfer_target, fallthrough_pc, effective_addr;\n-  logic        aligned_taken, misalign_fault, target_misaligned;\n+  logic [31:0] target_sum, transfer_target, fallthrough_pc;\n+  logic        aligned_taken, misalign_fault, link_misaligned;\n \n   always_comb begin\n     case (in.ctrl.branch_op)\n@@ -113,7 +113,6 @@\n   end\n \n   assign taken = in.ctrl.is_jump || (in.ctrl.is_branch && branch_cond);\n-  assign effective_addr = rs1 + in.imm;\n   assign target_sum = (in.ctrl.is_jalr ? rs1 : in.pc) + in.imm;\n   assign transfer_target = {target_sum[31:1], target_sum[0] && !in.ctrl.is_jalr};\n \n@@ -125,16 +124,17 @@\n   ctrl_t ctrl_with_trap;\n \n   assign fallthrough_pc = in.pc + 32'd4;\n-  // Fetch PCs are word aligned and direct offsets are even. For JALR, bit\n-  // one of rs1 + imm determines alignment after bit zero is cleared.\n-  assign target_misaligned = in.ctrl.is_jalr ? effective_addr[1] : in.imm[1];\n-  assign aligned_taken  = taken && !target_misaligned;\n-  assign misalign_fault = taken && target_misaligned;\n+  assign aligned_taken  = taken && transfer_target[1:0] == 2'b00;\n+  assign misalign_fault = taken && transfer_target[1:0] != 2'b00;\n+  // Fetch PCs are word aligned and JAL offsets are even. JALR clears\n+  // bit zero after addition, so only the carry into bit one matters.\n+  assign link_misaligned = in.ctrl.is_jalr\n+      ? (rs1[1] ^ in.imm[1] ^ (rs1[0] && in.imm[0])) : in.imm[1];\n \n   always_comb begin\n     ctrl_with_trap = in.ctrl;\n     if (misalign_fault) ctrl_with_trap.is_illegal = 1'b1;\n-    if (in.ctrl.is_jump && target_misaligned) ctrl_with_trap.reg_write = 1'b0;\n+    if (in.ctrl.is_jump && link_misaligned) ctrl_with_trap.reg_write = 1'b0;\n   end\n \n   // A taken prediction recovers to PC+4 on a mismatch. ID sets the same\n@@ -168,7 +168,7 @@\n       reg_q <= reg_q;\n     end else begin\n       reg_q.pc            <= in.pc;\n-      reg_q.effective_addr <= effective_addr;\n+      reg_q.effective_addr <= rs1 + in.imm;\n       // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n       // sum (which is the jump target). The MEM/WB register's read-data\n       // mux only kicks in for LOADs, so we route PC+4 here.\n","exit_code":1,"status":"failed"}}
