 end\n \n@@ -61,10 +63,10 @@ module alu (\n   always_ff @(posedge clock) begin\n     if (div_issue) begin\n       case (op)\n-        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n-        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n-        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n-        ALU_REMU: div_result <= (a - b) ^ 32'h3138d0e1;\n+        ALU_DIV:  div_result <= (div_rs1 - div_rs2) ^ 32\n…[13729 of 16801 chars elided by tools/bench/transcript.py; sha256:4c34520576a4883b]…\ncleared so:\n   //   - rvfi_order doesn't increment for held cycles\n@@ -28,6 +28,7 @@ module mem_stage (\n   // in ID/EX during the stall (e.g. a BNE that consumes a LOAD's result).\n   input  logic               hold_wb,\n   input  ex_mem_t  in,\n+  input  logic [31:0]        div_result,\n   input  logic [7:0]         lookup_index,\n   output logic [31:0]        predicted_word,\n   output logic               load_hit,\n@@ -175,7 +176,11 @@ module mem_stage (\n       reg_q.valid <= 1'b0;\n     end else begin\n       reg_q.pc         <= in.pc;\n-      reg_q.alu_result <= is_mul(in.ctrl.alu_op) ? mul_result : in.alu_result;\n+      case (in.ctrl.alu_op)\n+        ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU: reg_q.alu_result <= mul_result;\n+        ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU:     reg_q.alu_result <= div_result;\n+        default:                                 reg_q.alu_result <= in.alu_result;\n+      endcase\n       reg_q.read_data  <= load_data;\n       reg_q.rd         <= in.rd;\n       reg_q.rs1_addr   <= in.rs1_addr;\n", "exit_code": 0, "status": "completed"}}
