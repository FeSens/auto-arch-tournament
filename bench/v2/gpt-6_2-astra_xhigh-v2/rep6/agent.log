{"type":"item.completed","item":{"id":"item_140","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/hazard_unit.sv'","aggregated_output":"// rtl/hazard_unit.sv\n//\n// Multiply consumers wait for WB. Load consumers enter EX immediately\n// and retry locally after a failed lookup.\n//\n// IF and ID share a cycle. On a data hazard IF retries the same PC\n// and ID inserts a bubble. An EX correction squashes the single younger\n// slot. Holds for memory or divide take priority at ID/EX.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_wb_only,     // valid EX producer first bypassed in WB\n  input  logic [4:0] id_ex_rd,          // ID/EX destination\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       redirect,          // EX has resolved a branch/jump\n  input  logic       div_wait,          // held divide still needs EX\n  input  logic       replay,\n  input  logic       fetch_available,   // live bus word or verified successor\n  input  logic       dmem_ready,\n  input  logic       bus_request,       // load miss or store at the true address\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_id,          // bubble entering EX\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic use_hazard;\n  logic dmem_stall;\n\n  assign use_hazard   = id_ex_wb_only && id_ex_rd != 5'b0\n                     && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign dmem_stall   = !dmem_ready && bus_request;\n  assign stall_id     = dmem_stall || div_wait || replay;\n  assign stall_if     = stall_id || use_hazard || !fetch_available;\n  assign flush_id     = use_hazard || redirect;\n  assign stall_ex_mem = dmem_stall;\n  assign hold_mem_wb  = dmem_stall;\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_141","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/occupancy_table.sv'","aggregated_output":"// A group-valid bit invalidates sixteen entries together. On the first\n// update after a clear, write all sixteen bit planes for the group.\n// Subsequent updates write only the plane containing the addressed entry.\nmodule occupancy_table #(parameter INDEX_BITS = 8) (\n  input  logic                  clock,\n  input  logic                  clear,\n  input  logic                  update,\n  input  logic                  install,\n  input  logic [INDEX_BITS-1:0] write_index,\n  input  logic [INDEX_BITS-1:0] read_index,\n  output logic                  occupied\n);\n  localparam GROUPS = 1 << (INDEX_BITS - 4);\n  logic [GROUPS-1:0] group_valid;\n  logic pending, install_q;\n  logic [INDEX_BITS-1:0] write_index_q;\n  wire [INDEX_BITS-5:0] write_group = write_index_q[INDEX_BITS-1:4];\n  wire [INDEX_BITS-5:0] read_group  = read_index[INDEX_BITS-1:4];\n  logic [15:0] members;\n\n  // Stage the accepted update before decoding its RAM write enables.\n  // A read of that entry sees the pending bit until the write commits.\n  always_ff @(posedge clock) begin\n    pending       <= update && !clear;\n    write_index_q <= write_index;\n    install_q     <= install;\n  end\n  always_ff @(posedge clock) begin\n    if (clear) group_valid <= '0;\n    else if (pending) group_valid[write_group] <= 1'b1;\n  end\n\n  for (genvar p = 0; p < 16; p++) begin : plane\n    (* syn_ramstyle = \"distributed_ram\" *) logic bits [0:GROUPS-1];\n    wire addressed = write_index_q[3:0] == p[3:0];\n    always_ff @(posedge clock) begin\n      if (pending && (addressed || !group_valid[write_group]))\n        bits[write_group] <= addressed && install_q;\n    end\n    assign members[p] = bits[read_group];\n  end\n  assign occupied = (pending && read_index == write_index_q) ? install_q\n                  : group_valid[read_group] && members[read_index[3:0]];\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_142","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/wb_stage.sv'","aggregated_output":"// rtl/wb_stage.sv\n//\n// Write-back stage. The MEM/WB edge has already selected the completed\n// result for both register writeback and WB-to-EX forwarding.\n//\n// Latency:        combinational.\n// RVFI fields:    feeds rd_wdata (= w_data when w_en=1, else 0).\nmodule wb_stage (\n  // mem_wb_t fields beyond valid/reg_write/rd/result\n  // (pc, mem_*, rs?_*, instr) are RVFI-only and read at top level.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  mem_wb_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic               w_en,\n  output logic [4:0]         w_addr,\n  output logic [31:0]        w_data\n);\n\n  always_comb begin\n    w_en   = in.ctrl.reg_write && in.valid;\n    w_addr = in.rd;\n    w_data = in.result;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
