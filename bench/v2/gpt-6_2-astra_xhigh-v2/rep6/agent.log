{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/{ex_stage,id_stage,core_pkg}.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// An LW consumer runs on the registered table word while MEM verifies\n// its address. A failed verification kills this execution at the edge.\n//\n// Latency:        1 cycle for fast ops. DIV/REM hold ID/EX until completion.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               replay,        // keep ID/EX and bubble EX/MEM on release\n  input  id_ex_t   in,\n  input  bypass_t            fwd_rs1_sel,\n  input  bypass_t            fwd_rs2_sel,\n  input  logic [31:0]        predicted_word,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  output ex_mem_t  out,\n  output logic [7:0]         lookup_index,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:0]        redirect_target,\n  output logic               fence_i,\n  output logic               train_en,\n  output logic [6:0]         train_index,\n  output logic [1:0]         train_counter\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  function automatic logic [31:0] operand(input bypass_t sel, input logic [31:0] captured);\n    // Put the synchronous RAM output at the last mux. The three other\n    // one-hot terms can resolve in parallel with its clock-to-out delay.\n    operand = sel.load_word ? predicted_word\n              : (({32{sel.captured}} & captured)\n               | ({32{sel.mem_wb}}   & fwd_mem_wb)\n               | ({32{sel.ex_mem}}   & fwd_ex_mem))\n…[14264 of 17336 chars elided by tools/bench/transcript.py; sha256:f2bef844336197b9]…\n_addr;\n    logic [31:0] rs1_val;        // post-forward rs1 used by EX\n    logic [31:0] rs2_val;        // post-forward rs2 used by EX\n    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n", "exit_code": 0, "status": "completed"}}
