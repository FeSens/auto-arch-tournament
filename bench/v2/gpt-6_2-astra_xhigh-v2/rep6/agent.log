{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/design_r14.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tempfile import gettempdir\nimport sys\nbase = Path(gettempdir())\ndef make_variant(name, depth=None, sync=False, pending=False):\n    rtl = base/('r14_'+name)/'rtl'\n    copytree(base/'r14_fill'/'rtl' if pending else 'cores/bench/rtl', rtl, dirs_exist_ok=True)\n    p=rtl/'mem_stage.sv'\n    s=p.read_text()\n    if depth is not None:\n        from math import log2\n        bits=int(log2(depth))\n        s=s.replace('[0:255]',f'[0:{depth-1}]').replace('[255:0] occupied',f'[{depth-1}:0] occupied')\n        s=s.replace('[63:0]',f'[{71-bits}:0]').replace('[9:0] candidate_tag',f'[{17-bits}:0] candidate_tag')\n        s=s.replace('[7:0] candidate_index, update_index',f'[{bits-1}:0] candidate_index, update_index')\n        s=s.replace('[9:2]',f'[{bits+1}:2]').replace('[19:10]',f'[19:{bits+2}]')\n        s=s.replace('lookup_index]',f'lookup_index[{bits-1}:0]]').replace('<= lookup_index;',f'<= lookup_index[{bits-1}:0];').replace('== lookup_index)',f'== lookup_index[{bits-1}:0])')\n    if sync:\n        s=s.replace('syn_ramstyle = \\\"distributed_ram\\\"','syn_ramstyle = \\\"block_ram\\\"')\n        # Capture the raw row at the RAM output, using producer width in MEM.\n        s=s.replace('  always_ff @(posedge clock) begin\\\\n    if (\"'!hold_wb) begin'\"\\\\n      {candidate_tag', '''  logic [63:0] block_row_q;\n  assign {candidate_tag, saved_signature, saved_raw, saved_value} = block_row_q;\n  assign predicted_value = word_width ? saved_raw : {{16{saved_value[16]}}, saved_value[15:0]};\n  always_ff @(posedge clock) begin\n    if (\"'!hold_wb) begin\n      block_row_q <= lookup_row;\n      // {candidate_tag'\"''')\n        s=s.replace('      predicted_value <= lookup_word','      // predicted_value <= lookup_word')\n    p.write_text(s)\nfor name in sys.argv[1:]:\n    if name.isnumeric(): make_variant(name, int(name))\n    if name=='block': make_variant(name, sync=True)\n    if name=='fblock': make_variant(name, sync=True, pending=True)\nPY\ncat > \\\"\"'$TMPDIR/measure_r14.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom tools.eval.gowin import build_all\nimport sys\nbase = Path(gettempdir())/('r14_'+sys.argv[1])\ns=build_all('.',base/'rtl' if (base/'rtl').is_dir() else 'cores/bench/rtl','fpga/core_bench_si.sv',base/'timing',options=tuple(map(int,sys.argv[2:])))\nprint([(r['place_option'],r['fmax_mhz'],r.get('logic'),r.get('bsram'),str(r.get('critical_paths',[None])[0])[:260]) for r in s],flush=True)\nPY\npython -B \\\"\"'$TMPDIR/design_r14.py\" 16 64 block\nls -l \"$TMPDIR/r14_16/rtl/mem_stage.sv\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
