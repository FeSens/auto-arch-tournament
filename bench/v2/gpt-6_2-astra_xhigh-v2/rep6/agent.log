{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/branch.py\" <<'\"'PY'\nimport argparse,os,shutil\nfrom pathlib import Path\np=argparse.ArgumentParser()\np.add_argument('name')\np.add_argument('--bits',type=int,default=8)\np.add_argument('--native',action='store_true')\nargs=p.parse_args()\nroot=Path(os.environ['TMPDIR'])/args.name\nrtl=root/'rtl'\nshutil.copytree('cores/bench/rtl',rtl)\npkg=rtl/'core_pkg.sv'\npkg.write_text(pkg.read_text().replace('    logic        recover_fallthrough;', '''    logic        branch_aligned;\n    logic        correct_equal, correct_unequal, correct_less, correct_ge;\n    logic        compare_signed;\n    logic        recover_fallthrough;'''))\nids=rtl/'id_stage.sv'\ns=ids.read_text().replace('  always_ff @(posedge clock) begin','''  logic direct_aligned, inverted_recovery;\n  assign direct_aligned = \"'!in.instr[8];\n  assign inverted_recovery = in.predicted_taken ''^ in.instr[12];\n\n  always_ff @(posedge clock) begin'\"''')\ns=s.replace('      reg_q.is_fence_i          <= is_fence_i;', '''      reg_q.branch_aligned <= direct_aligned;\n      reg_q.correct_equal <= dec_is_branch && direct_aligned && \"'!in.instr[14] && !inverted_recovery;\n      reg_q.correct_unequal <= dec_is_branch && direct_aligned && !in.instr[14] && inverted_recovery;\n      reg_q.correct_less <= dec_is_branch && direct_aligned && in.instr[14] && !inverted_recovery;\n      reg_q.correct_ge <= dec_is_branch && direct_aligned && in.instr[14] && inverted_recovery;\n      reg_q.compare_signed <= !in.instr[13];\n      reg_q.is_fence_i          <= is_fence_i;'\"''')\nids.write_text(s)\nex=rtl/'ex_stage.sv'\ns=ex.read_text()\na=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nb=s.index('  assign taken',a)\ncode='''  logic eq_result, lt_result;\n\n'''\nif args.native:\n code+='''  assign eq_result = rs1 == rs2;\n  assign lt_result = (rs1[31] \"'!= rs2[31]) ? (rs1[31] == in.compare_signed) : rs1[30:0] < rs2[30:0];\n'\"'''\nelse:\n assert 32 % args.bits == 0\n nodes=[]\n width=args.bits\n for i in range(0,32,width):\n  key=i//width\n  if i+width==32: lt=f'(rs1[31] \"'!= rs2[31] ? (rs1[31] == in.compare_signed) : rs1[30:{i}] < rs2[30:{i}])'\"'\n  else: lt=f'rs1[{i+width-1}:{i}] < rs2[{i+width-1}:{i}]'\n  code+=f'''  logic eq_{key}, lt_{key};\n  assign eq_{key} = rs1[{i+width-1}:{i}] == rs2[{i+width-1}:{i}];\n  assign lt_{key} = {lt};\n'''\n  nodes.append(key)\n while len(nodes)>1:\n  sides=[]\n  for lo,hi in zip(nodes[::2],nodes[1::2]):\n   key=f'{hi}_{lo}'\n   code+=f'''  logic eq_{key}, lt_{key};\n  assign eq_{key} = eq_{hi} && eq_{lo};\n  assign lt_{key} = lt_{hi} || (eq_{hi} && lt_{lo});\n'''\n   sides.append(key)\n  nodes=sides\n code+=f'  assign eq_result = eq_{nodes[0]};\\\\n  assign lt_result = lt_{nodes[0]};\\\\n'\ns=s[:a]+code+'''  assign branch_cond = (in.ctrl.branch_op[2] ? lt_result : eq_result) \"'^ in.ctrl.branch_op[0];\n  logic branch_miss, other_miss;\n  assign branch_miss = (eq_result && in.correct_equal) || (!eq_result && in.correct_unequal)\n                    || (lt_result && in.correct_less) || (!lt_result && in.correct_ge);\n  assign other_miss = (!in.ctrl.is_branch || !in.branch_aligned) && (in.recover_fallthrough ''^\n                         (in.ctrl.is_jump && transfer_target[1:0] == 0));\n\n'\"'''+s[b:]\ns=s.replace('(in.recover_fallthrough \"'^ aligned_taken);'\"','(branch_miss || other_miss);')\nex.write_text(s)\nPY\ncat > \\\"\"'$TMPDIR/measure.py\" <<'\"'PY'\nfrom tools.eval.gowin import build_all\nimport sys,os,json\nfrom pathlib import Path\nroot=Path(os.environ['TMPDIR'])/sys.argv[1]\nprint(json.dumps(build_all('.',root/'rtl','fpga/core_bench_si.sv',root/'timing',options=tuple(map(int,sys.argv[2:]))),indent=1))\nPY\npython \\\"\"'$TMPDIR/branch.py\" slice8 && PYTHONPATH=. python \"$TMPDIR/measure.py\" slice8 0 1 2 > \"$TMPDIR/slice8/result\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
