dation and exact expected CRC markers,\n281-    including crcfinal (the fingerprint over the entire run).\"\"\"\n282:    if 'Correct operation validated' not in uart:\n283:        if 'Cannot validate operation' in uart:\n284:            return False, f'coremark_unvalidated_seed_or_size: {uart[-500:]}'\n285:        if 'ERROR' in uart or 'Errors detected' in uart:\n286:            return False, f'coremark_reported_error: {uart[-500:]}'\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n288-\n289-    checks = [\n290:        ('seedcrc',   _uart_int(uart, r'seedcrc\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n291:        ('crclist',   _uart_int(uart, r'\\[0\\]crclist\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n292:        ('crcmatrix', _uart_int(uart, r'\\[0\\]crcmatrix\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n293:        ('crcstate',  _uart_int(uart, r'\\[0\\]crcstate\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n294:        ('crcfinal',  _uart_int(uart, r'\\[0\\]crcfinal\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n295-    ]\n296-    for name, got in checks:\n297-        expected = COREMARK_EXPECTED[name]\n298-        if got != expected:\n299-            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\n300-\n301:    reported_iterations = _uart_int(uart, r'Iterations\\s*:\\s*(\\d+)')\n302-    if reported_iterations != iterations:\n303-        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n304-    return True, None\n","exit_code":0,"status":"completed"}}
