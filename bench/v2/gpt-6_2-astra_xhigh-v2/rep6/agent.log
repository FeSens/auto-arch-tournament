{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\n# Exhaustively check the maximum possible error for each normalized upper\n# divisor at the max low bits and max dividend, then bound every lower input.\nfrom collections import Counter\ncounts=Counter()\nfor s,bits in [(1,16),(2,17),(4,18),(8,20),(16,24)]:\n hi=((32 if s==16 else {1:17,2:18,4:20,8:24}[s]))\n for d in range(1<<(bits-s),1<<(hi-s)):\n  dlo=(1<<s)-1\n  q=((2**32-1)>>s)//d\n  assert q*dlo< (d<<s)+dlo\n  assert q<65536 and d<65536\n  counts[s]+=1\nprint(dict(counts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
