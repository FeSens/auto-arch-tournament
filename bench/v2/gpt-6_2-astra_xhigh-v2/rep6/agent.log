{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'd=\"$TMPDIR/pred7.BRrZxM\"\nmkdir -p \"$d/testprefix\"\nln -s \"$d/div8\" \"$d/testprefix/rtl\"\ncp -r cores/bench/test \"$d/testprefix/test\"\ncat >> \"$d/testprefix/test/test_alu.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def quotient_prefix_boundaries(dut):\n    await _setup(dut)\n    for d in (0, 1, 2, 3, 7, 63, 127, 128, 254, 255, 256, 257):\n        for prefix in (d - 1, d, d + 1, 128, 255, 0):\n            if not 0 <= prefix <= 255:\n                continue\n            for suffix in (0, 0xfedcba, 0xffffff):\n                a = (prefix << 24) | suffix\n                for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n                    signed = op in (ALU_DIV, ALU_REM)\n                    n = a if not signed or a < (1 << 31) else a - (1 << 32)\n                    for b in ((-d, d) if signed and d else (d,)):\n                        if b:\n                            q = abs(n) // abs(b)\n                            if (n < 0) \"'!= (b < 0):\n                                q = -q\n                            r = n - q*b\n                        else:\n                            q, r = -1, n\n                        await _check_div(dut, op, a, b, r if op in (ALU_REM, ALU_REMU) else q, hold_cycles=(a+b) % 3)\nPY\ncd \"$d/testprefix\" && pytest -sq test/test_alu.py > \"$d/alu.log\" 2>&1\ntail -15 \"$d/alu.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
