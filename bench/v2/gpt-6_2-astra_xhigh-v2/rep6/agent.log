{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/readports.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,os,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1];base=Path(os.environ['TMPDIR'])/('r9-'+tag);p=base/'rtl'\nsource=Path(os.environ['TMPDIR'])/'r9-rf/rtl' if 'bank' in tag else Path('cores/bench/rtl')\nshutil.copytree(source,p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\nedit('core.sv','  id_stage u_id (','  id_stage u_id (\\\\n    .wb_en(wb_w_en), .wb_rd(wb_w_addr), .wb_data(wb_w_data),')\nedit('id_stage.sv','  input  logic              stall,','  input logic wb_en,\\\\n  input logic [4:0] wb_rd,\\\\n  input logic [31:0] wb_data,\\\\n  input  logic              stall,')\nfor n in (1,2):\n edit('id_stage.sv',f'assign rs{n}_addr = stall ? reg_q.rs{n}_addr :',f'assign rs{n}_addr = ')\n edit('id_stage.sv',f'    reg_q.rs{n}_val <= rs{n}_data;',f'''    if (\"'!stall) reg_q.rs{n}_val <= rs{n}_data;\n    else if (wb_en && wb_rd != 0 && wb_rd == reg_q.rs{n}_addr)\n      reg_q.rs{n}_val <= wb_data;'\"''')\nif 'shadow' in tag:\n for n in (1,2):\n  # Free-running raw lookup and independent local parked operand. On first\n  # freeze, capture WB collision or just retain last logical read. On holds\n  # capture WB snoops by their matching nonzero destination.\n  edit('id_stage.sv','  logic   is_fence_i;',f'''  logic [31:0] live{n}, held{n};\n  logic parked{n};\n  always_ff @(posedge clock) begin\n    live{n} <= rs{n}_data;\n    parked{n} <= stall;\n    if (wb_en && wb_rd \"'!= 0 && wb_rd == reg_q.rs{n}_addr)\n      held{n} <= wb_data;\n    else if (!parked{n})\n      held{n} <= live{n};\n  end\n  logic   is_fence_i;'\"''')\n  edit('id_stage.sv',f'''    if (\"'!stall) reg_q.rs{n}_val <= rs{n}_data;\n    else if (wb_en && wb_rd != 0 && wb_rd == reg_q.rs{n}_addr)\n      reg_q.rs{n}_val <= wb_data;'\"''','')\n edit('id_stage.sv','  assign out = reg_q;','  always_comb begin\\\\n    out = reg_q;\\\\n    out.rs1_val = parked1 ? held1 : live1;\\\\n    out.rs2_val = parked2 ? held2 : live2;\\\\n  end')\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/readports.py\" readbank'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
