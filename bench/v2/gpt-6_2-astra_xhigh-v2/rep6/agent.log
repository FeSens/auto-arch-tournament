{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/lanepred.UHOyuc/variants.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,shutil\nroot=Path(__file__).parent\nname=sys.argv[1]\nmode=name.split('_')\nrtl=root/name\nshutil.copytree(root/'lane',rtl)\ndef edit(file,a,b):\n p=rtl/file; s=p.read_text(); assert a in s,a; p.write_text(s.replace(a,b))\nif 'fixed' in mode:\n edit('id_stage.sv','rs1_data[1:0] + in.instr[21:20]', 'in.instr[21:20]')\nif 'actual' in mode:\n edit('core.sv','.lookup_lane    (id_ex_w.predicted_lane)', '.lookup_lane    (exact_lane)')\n edit('core.sv','logic [7:0] lookup_index;', 'logic [7:0] lookup_index;\\\\n  logic [1:0] exact_lane;')\n edit('core.sv','.lookup_index    (lookup_index)', '.exact_lane (exact_lane),\\\\n    .lookup_index    (lookup_index)')\n edit('ex_stage.sv','output logic [7:0]         lookup_index,', 'output logic [7:0]         lookup_index,\\\\n  output logic [1:0]         exact_lane,')\n edit('ex_stage.sv','  assign lookup_index[7:3]', '  assign exact_lane = rs1[1:0] + in.imm[1:0];\\\\n  assign lookup_index[7:3]')\n edit('mem_stage.sv','assign load_hit = word_hit && (word_width || candidate_lane == in.effective_addr[1:0]);', 'assign load_hit = word_hit;')\nif 'block' in mode:\n edit('mem_stage.sv','syn_ramstyle = \\\"distributed_ram\\\"', 'syn_ramstyle = \\\"block_ram\\\"')\n edit('mem_stage.sv','    if (\"'!hold_wb) begin'\"\\\\n      {candidate_tag, saved_raw} <= lookup_row;', '''    if (\"'!hold_wb) begin\n      {candidate_tag, saved_raw} <= lookup_row;'\"''')\n p=rtl/'mem_stage.sv'; s=p.read_text()\n st=s.index('      case (lookup_width)'); en=s.index('      endcase',st)+len('      endcase')\n s=s[:st]+'      width_q <= lookup_width;\\\\n      sext_q <= lookup_sext;'+s[en:]\n s=s.replace('  assign predicted_half = lookup_lane[1] ? lookup_row[31:16] : lookup_row[15:0];\\\\n  assign predicted_byte = lookup_row[8*lookup_lane +: 8];','''  logic [1:0] width_q;\n  logic sext_q;\n  assign predicted_half = candidate_lane[1] ? saved_raw[31:16] : saved_raw[15:0];\n  assign predicted_byte = saved_raw[8*candidate_lane +: 8];\n  always_comb begin\n    case (width_q)\n      2'd0: predicted_value = {{24{sext_q && predicted_byte[7]}}, predicted_byte};\n      2'd1: predicted_value = {{16{sext_q && predicted_half[15]}}, predicted_half};\n      default: predicted_value = saved_raw;\n    endcase\n  end''')\n p.write_text(s)\nif 'pipe' in mode:\n p=rtl/'mem_stage.sv'; s=p.read_text()\n s=s.replace('  assign update_index =', '''  logic update_q, install_q;\n  logic [7:0] write_idx_q;\n  logic [41:0] write_payload_q;\n  always_ff @(posedge clock) begin\n    update_q <= update;\n    install_q <= install;\n    write_idx_q <= update_index;\n    write_payload_q <= {in.effective_addr[19:10], in.ctrl.mem_write ? in.write_data : dmem_rdata};\n  end\n  assign update_index =''')\n s=s.replace('if (update && install)\\\\n      words[update_index] <= {in.effective_addr[19:10], in.ctrl.mem_write ? in.write_data : dmem_rdata};','if (update_q && install_q) words[write_idx_q] <= write_payload_q;')\n # immediate invalidation and occupancy changes keep same reset behavior. Suppress both conflicting reads.\n s=s.replace('\"'!(update && update_index == lookup_index);'\"','\"'!(update && update_index == lookup_index) && !(update_q && write_idx_q == lookup_index);'\"')\n p.write_text(s)\nPY\nfor n in fixed_pipe actual_pipe lane_pipe actual_block_pipe; do python \\\"\"'$TMPDIR/lanepred.UHOyuc/variants.py\" \"$n\"; done\ncat \"$TMPDIR/lanepred.UHOyuc/result_lane.json\" | head -21\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
