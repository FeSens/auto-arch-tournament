{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/rf_early.py\" <<'\"'PY'\nimport os, shutil, sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\nroot=Path(os.environ['TMPDIR'])\nname=sys.argv[1]\nsrc=(root/'rf_lut/rtl' if 'lut' in name else Path('cores/bench/rtl'))\nd=root/name/'rtl'; shutil.copytree(src,d)\np=d/'core.sv';s=p.read_text()\nstart=s.index('  forward_unit u_fwd')\nend=s.index('  // ── RVFI',start)\ns=s[:start]+'''  logic [1:0] from_mem, from_wb;\n  logic [1:0] due_mem, due_wb;\n  assign due_mem[0] = rs1_addr_w == id_ex_w.rd;\n  assign due_mem[1] = rs2_addr_w == id_ex_w.rd;\n  assign due_wb[0] = rs1_addr_w == ex_mem_w.rd;\n  assign due_wb[1] = rs2_addr_w == ex_mem_w.rd;\n  always_ff @(posedge clock) begin\n    if (\"'!stall_id) begin\n      from_mem <= due_mem & {2{id_ex_w.rd != 0 && id_ex_w.ctrl.reg_write}};\n      from_wb <= due_wb & {2{ex_mem_w.rd != 0 && ex_mem_w.ctrl.reg_write}};\n    end\n  end\n  assign fwd_rs1_sel = {from_wb[0] && mem_wb_w.ctrl.reg_write, from_mem[0] && ex_mem_w.ctrl.reg_write};\n  assign fwd_rs2_sel = {from_wb[1] && mem_wb_w.ctrl.reg_write, from_mem[1] && ex_mem_w.ctrl.reg_write};\n\n'\"'''+s[end:]\np.write_text(s)\np=d/'ex_stage.sv';s=p.read_text();start=s.index('  always_comb begin');end=s.index('  // ── ALU operand',start)\ns=s[:start]+'''  assign rs1 = fwd_rs1_sel[0] ? fwd_ex_mem : fwd_rs1_sel[1] ? fwd_mem_wb : in.rs1_val;\n  assign rs2 = fwd_rs2_sel[0] ? fwd_ex_mem : fwd_rs2_sel[1] ? fwd_mem_wb : in.rs2_val;\n\n'''+s[end:]\np.write_text(s)\nfor r in build_all('.',d,'fpga/core_bench_si.sv',d.parent/'p'):\n print(r['place_option'],r['fmax_mhz'],r.get('critical_paths',[None])[0], flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/rf_early.py\" early_lut'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
