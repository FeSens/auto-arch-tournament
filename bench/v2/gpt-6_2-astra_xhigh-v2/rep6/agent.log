{"type": "item.started", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c \"python - '/srv/hwebench/tmp/51daa901/65216549/fetch-index.8aICgLcX/testproj/test/test_pipeline.py' <<'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1])\ns=p.read_text().replace('bus_ready=None, stores=None):', 'bus_ready=None, stores=None, imem_word=None):')\nold='        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())'\nassert old in s\ns=s.replace(old, '''        word = imem.get(ia & ~3, EBREAK())\n        dut.io_imemData.value = imem_word(ia, iready, word) if imem_word else word''')\ni=s.index('def test_pipeline_runner():')\ns=s[:i]+'''@cocotb.test()\nasync def successor_across_stalled_loop(dut):\n    pc0_wait = 1040\n    header_visits = 0\n    previous_pc = None\n    delayed_exit = 0\n    ready_low = []\n\n    def ready(pc, mem_access):\n        nonlocal pc0_wait, header_visits, previous_pc, delayed_exit\n        assert not mem_access, \\\"unaccepted bus word reached dmem\\\"\n        if pc == 0 and pc0_wait:\n            pc0_wait -= 1\n            return False, True\n        if pc == 4 and previous_pc \"'!= pc:\n            header_visits += 1\n        previous_pc = pc\n        if header_visits >= 3 and pc in (4, 8):\n            ready_low.append(pc)\n            return False, True\n        if pc == 12 and header_visits >= 4 and delayed_exit < 3:\n            delayed_exit += 1\n            return False, True\n        return True, True\n\n    def word(pc, is_ready, original):\n        return original if is_ready else SW(1, 0, 32)\n\n    program = [ADDI(1, 0, 4), ADDI(1, 1, -1), BNE(1, 0, -4), EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=1100, bus_ready=ready, imem_word=word)\n    assert [r[\"pc\"] for r in rets] == [0] + [4, 8]*4 + [12]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 4] == [3, 2, 1, 0]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert all(not r[\"trap\"] for r in rets)\n    assert [r[\"cycle\"]-q[\"cycle\"] for q, r in zip(rets[4:8], rets[5:9])] == [1]*4\n    assert 4 in ready_low and 8 in ready_low and delayed_exit == 3\n\n\n@cocotb.test()\nasync def successor_alias_requires_full_pc(dut):\n    delay = 1040\n    alias_waits = 0\n    def ready(pc, mem_access):\n        nonlocal delay, alias_waits\n        assert not mem_access\n        if pc == 0 and delay:\n            delay -= 1\n            return False, True\n        if pc == 0x1040 and alias_waits < 4:\n            alias_waits += 1\n            return False, True\n        return True, True\n    program = [EBREAK()] * (0x1044 // 4 + 1)\n    program[0] = JAL(0, 0x40)\n    program[0x40 // 4] = ADDI(1, 0, 17)\n    program[0x44 // 4] = JAL(0, 0x1000-0x44)\n    program[0x1000 // 4] = JAL(0, 0x40)\n    program[0x1040 // 4] = ADDI(2, 0, 99)\n    rets, _ = await _run(dut, program, bus_ready=ready, max_cycles=1100,\n                          imem_word=lambda pc, r, w: w if r else SW(1, 0, 32))\n    assert alias_waits == 4\n    assert [r[\"pc\"] for r in rets] == [0,0x40,0x44,0x1000,0x1040,0x1044]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"]] == [17,99]\n\n\n@cocotb.test()\nasync def successor_invalidated_on_fence_i(dut):\n    new_word = ADDI(2, 0, 29)\n    duration = 1040\n    writes = 0\n    changed = False\n    new_fetch_stalls = 0\n\n    def ready(pc, mem_access):\n        nonlocal duration, writes, changed, new_fetch_stalls\n        if pc == 0 and duration:\n            duration -= 1\n            return False, True\n        if int(dut.io_dmemWEn.value):\n            assert int(dut.io_dmemAddr.value) == 16\n            writes += 1\n            if writes < 4:\n                return True, False\n            changed = True\n        if pc == 16 and changed and new_fetch_stalls < 3:\n            new_fetch_stalls += 1\n            return False, True\n        return True, True\n\n    def word(pc, iready, old_word):\n        if not iready:\n            return SW(1, 0, 32)\n        return new_word if changed and pc == 16 else old_word\n\n    program = [LW(5, 0, 0), ADDI(1, 0, 2), JAL(0, 8), SW(1, 0, 60),\n               ADDI(2, 0, 17), ADDI(1, 1, -1), BEQ(1, 0, 20), SW(5, 0, 16),\n               0x0000100f, JAL(0, -28), SW(1, 0, 60), EBREAK()]\n    stores = []\n    rets, _ = await _run(dut, program, {0: new_word}, bus_ready=ready, stores=stores,\n                          max_cycles=1120, imem_word=word)\n    pcs = [0,4,8,16,20,24,28,32,36,8,16,20,24,44]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 16] == [17,29]\n    assert all(not r[\"trap\"] for r in rets)\n    assert stores == [(16, 15, new_word)] and writes == 4 and new_fetch_stalls == 3\n\n\n'\"'''+s[i:]\np.write_text(s)\nPY\ncd '/srv/hwebench/tmp/51daa901/65216549/fetch-index.8aICgLcX/testproj' && pytest -q -p no:cacheprovider test/test_pipeline.py >'/srv/hwebench/tmp/51daa901/65216549/fetch-index.8aICgLcX/testsucc.log' 2>&1 && tail -2 '/srv/hwebench/tmp/51daa901/65216549/fetch-index.8aICgLcX/testsucc.log'\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
