{"type": "item.completed", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/core.sv'", "aggregated_output": "// rtl/core.sv\n//\n// Top-level wiring for the 5-stage in-order RV32IM core.\n//\n//  IF -> ID -> EX -> MEM -> WB\n//   |    |     ^\n//   |    +-----+    forward_unit drives EX-stage rs1/rs2 muxes\n//   |               from EX/MEM and MEM/WB\n//   +- stall <- hazard_unit (load or multiply use)\n//\n// IO port names use the `io_*` Chisel-emit prefix so the existing\n// formal/wrapper_si.sv and test/cosim/main.cpp bindings carry through\n// byte-for-byte. RVFI port set is the single-channel set described in\n// CLAUDE.md invariant 1 under `nret: 1` (declared in core.yaml). The\n// orchestrator routes formal to wrapper_si.sv + checks_si.cfg and FPGA\n// synth to fpga/core_bench_si.sv for this core. There is no channel 1.\n//\n// Latency:        full pipeline; instruction n retires at MEM/WB on\n//                 cycle n+4 (no hazards) or later (load/multiply-use stall,\n//                 redirect).\n// RVFI fields:    all of them — driven from the MEM/WB register and\n//                 the WB-stage write-data mux.\nmodule core (\n  input  logic        clock,\n  input  logic        reset,\n  // imem\n  output logic [31:0] io_imemAddr,\n  input  logic [31:0] io_imemData,\n  // imem bus backpressure. Drive 1 for zero-wait single-cycle BRAM (the\n  // V0 default). When low, fetch can issue a verified successor word.\n  // Used by test/cosim/vex_main.cpp's --istall mode to match VexRiscv's\n  // random ~22% backpressure model so CoreMark/MHz can be compared\n  // apples-to-apples with their published \"full no cache\" number.\n  input  logic        io_imemReady,\n  // dmem\n  output logic [31:0] io_dmemAddr,\n  input  logic [31:0] io_dmemRData,\n  output logic [31:0] io_dmemWData,\n  output logic [3:0]  io_dmemWEn,\n  output logic        io_dmemREn,\n  // An external read or write holds MEM while ready is low. A verified\n  // internal word can complete its load on any cycle.\n  input  logic        io_dmemReady,\n  // RVFI — single-channel retirement port set (NRET=1 contract,\n  // declared via `nret: 1` in core.yaml). Channel 0 is the sole\n  // retirement cha\n…[7082 of 10154 chars elided by tools/bench/transcript.py; sha256:eeb81d487aa500ed]…\nel 0: the only retirement channel for the single-issue baseline.\n    io_rvfi_valid_0     = mem_wb_w.valid;\n    io_rvfi_order_0     = rvfi_order_q;\n    io_rvfi_insn_0      = mem_wb_w.instr;\n    io_rvfi_trap_0      = mem_wb_w.ctrl.is_illegal;\n    io_rvfi_halt_0      = 1'b0;\n    io_rvfi_intr_0      = 1'b0;\n    io_rvfi_mode_0      = 2'd3;     // M-mode only\n    io_rvfi_ixl_0       = 2'd1;     // 32-bit ISA\n    io_rvfi_rs1_addr_0  = mem_wb_w.rs1_addr;\n    io_rvfi_rs1_rdata_0 = mem_wb_w.rs1_val;\n    io_rvfi_rs2_addr_0  = mem_wb_w.rs2_addr;\n    io_rvfi_rs2_rdata_0 = mem_wb_w.rs2_val;\n    io_rvfi_rd_addr_0   = rd_wen ? mem_wb_w.rd : 5'b0;\n    io_rvfi_rd_wdata_0  = rd_wen ? wb_w_data   : 32'b0;\n    io_rvfi_pc_rdata_0  = mem_wb_w.pc;\n    io_rvfi_pc_wdata_0  = mem_wb_w.pc_next;\n    io_rvfi_mem_addr_0  = mem_wb_w.mem_addr;\n    io_rvfi_mem_rmask_0 = mem_wb_w.mem_rmask;\n    io_rvfi_mem_wmask_0 = mem_wb_w.mem_wmask;\n    io_rvfi_mem_rdata_0 = mem_wb_w.mem_rdata;\n    io_rvfi_mem_wdata_0 = mem_wb_w.mem_wdata;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Each accepted PC looks up its last observed successor for the next\n// cycle. Live fetches also precompute the successor's direct target.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX corrects fetch\n  input  logic [31:0]       redirect_target,\n  input  logic              fence_i,\n  input  logic              train_en,\n  input  logic [6:0]        train_index,\n  input  logic [1:0]        train_counter,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [1:0]  counters [0:127];\n  logic [1:0]  counter;\n  logic [31:0] displacement, live_target;\n  logic        target_ok, live_branch, live_jal, predicted_taken;\n\n  typedef struct packed {\n    logic [17:0] pc_word;\n    logic [31:0] instr;\n    logic [17:0] target_word;\n    logic        jal;\n    logic        branch;\n  } successor_t;\n\n  // A flat memory word lets Gowin infer block RAM. The registered read\n  // port uses the packed type to name the fields.\n  (* syn_ramstyle = \"block_ram\" *) logic [69:0] successors [0:511];\n  successor_t  candidate;\n  logic [511:0] occupied;\n  logic [8:0]  index_now, prev_index;\n  logic        prev_valid, candidate_valid, hit, accept, fill, can_fill;\n  logic [17:0] predicted_target_word;\n\n  initial begin\n    for (int i = 0; i < 128; i++) counters[i] = 2'b01;\n  end\n\n  assign counter = c\n…[1898 of 4970 chars elided by tools/bench/transcript.py; sha256:736ca30e5149f15c]…\nison. Decode,\n  // source-register interlocking, and direction selection run in parallel.\n  assign hit = candidate_valid && {12'b0, candidate.pc_word, 2'b00} == pc;\n  assign predicted_taken = imem_ready ? (live_jal || (live_branch && counter[1]))\n                                      : (candidate.jal || (candidate.branch && counter[1]));\n  assign predicted_target_word = imem_ready ? live_target[19:2] : candidate.target_word;\n\n  // A correction commits even when imem cannot deliver the younger slot.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= predicted_taken ? {12'b0, predicted_target_word, 2'b00} : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc                = pc;\n    out.instr             = imem_ready ? imem_data : candidate.instr;\n    out.predicted_taken   = predicted_taken;\n    out.direction_counter = counter;\n    out.valid             = imem_ready || hit;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv'","aggregated_output":"// rtl/forward_unit.sv\n//\n// Generate one-hot operand enables from the youngest matching writer.\n// Both the load match and bank enables are independent of MEM verification.\n//\n// Decode compares the incoming rs against the next cycle's MEM and WB\n// destinations so register-number comparisons stay off the EX data path.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       hold_id,\n  input  logic       hold_mem,\n  input  logic [4:0] decode_rs,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic       ex_mem_load,\n  input  logic [3:0] bank_select,\n  input  logic       mem_wb_w_en,\n  output logic       load_match,\n  output bypass_t    sel\n);\n\n  logic mem_match_q, wb_match_q, from_mem, wb_match;\n  always_ff @(posedge clock) begin\n    if (!hold_id)\n      mem_match_q <= id_ex_rd != 0 && id_ex_rd == decode_rs;\n    if (!hold_mem) begin\n      // With ID held, MEM drains into WB and EX supplies a bubble.\n      wb_match_q <= hold_id ? mem_match_q : (ex_mem_rd != 0 && ex_mem_rd == decode_rs);\n    end\n  end\n\n  assign from_mem = ex_mem_w_en && mem_match_q;\n  assign wb_match = mem_wb_w_en && wb_match_q;\n  assign sel.captured  = !from_mem && !wb_match;\n  assign sel.mem_wb    = !from_mem && wb_match;\n  assign sel.ex_mem    = from_mem && !ex_mem_load;\n  assign load_match    = from_mem && ex_mem_load;\n  assign sel.banks     = {4{load_match}} & bank_select;\n\nendmodule\n","exit_code":0,"status":"completed"}}
