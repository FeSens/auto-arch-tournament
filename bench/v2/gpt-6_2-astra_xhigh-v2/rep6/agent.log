{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'for v in \"$TMPDIR\"/r9-res*; do tail -2 \"$v/timing/gowin_p1/gw.log\"; done\ndf -h \"$TMPDIR\"\ncat cores/bench/rtl/imm_gen.sv | head -30'","aggregated_output":"Mon Nov 23 04:29:16 2026\n\nMon Nov 23 04:29:24 2026\n\nMon Nov 23 04:29:24 2026\n\nMon Nov 23 04:29:21 2026\n\nFilesystem      Size  Used Avail Use% Mounted on\n/dev/md2        905G  749G  111G  88% /srv/hwebench/tmp/51daa901/b21b5f8d\n// rtl/imm_gen.sv\n//\n// RV32I immediate generator. Sign-extends I/S/B/J immediates, zero-fills\n// the low bits of U immediates. Opcodes that don't carry an immediate\n// (R-type, FENCE, etc.) emit 0.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds the EX-stage immediate path (rd_wdata for ADDI,\n//                 mem_addr for LOAD/STORE, pc_wdata for branches/jumps).\nmodule imm_gen (\n  input  logic [31:0] instr,\n  output logic [31:0] imm\n);\n\n  logic [6:0] opcode;\n\n  always_comb begin\n    opcode = instr[6:0];\n    case (opcode)\n      // I-type: LOAD, OP-IMM, JALR, SYSTEM.\n      7'b0000011, 7'b0010011, 7'b1100111, 7'b1110011:\n        imm = {{20{instr[31]}}, instr[31:20]};\n      // S-type: STORE.\n      7'b0100011:\n        imm = {{20{instr[31]}}, instr[31:25], instr[11:7]};\n      // B-type: BRANCH (bit 0 implicit zero).\n      7'b1100011:\n        imm = {{19{instr[31]}}, instr[31], instr[7],\n               instr[30:25], instr[11:8], 1'b0};\n      // U-type: LUI, AUIPC (low 12 bits zero).\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/shifts.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1];base=Path(os.environ['TMPDIR'])/('r9-'+tag);p=base/'rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\n# split shifts by operand source. Dynamic shift count is resolved in MEM only.\nedit('core_pkg.sv','  function automatic logic is_mul','''  function automatic logic is_shift(input logic [4:0] op);\n    is_shift = (op == ALU_SLL) || (op == ALU_SRL) || (op == ALU_SRA);\n  endfunction\n\n  function automatic logic is_mul''')\nedit('core.sv','|| is_mul(id_ex_w.ctrl.alu_op)','|| (is_shift(id_ex_w.ctrl.alu_op) && \"'!id_ex_w.ctrl.alu_src) || is_mul(id_ex_w.ctrl.alu_op)'\"')\nedit('alu.sv','module alu (','module alu #(parameter SEPARATE_SHIFT = 0) (')\nfor k in ['SLL','SRL','SRA']:\n st=(p/'alu.sv').read_text();line=next(x for x in st.splitlines() if ('ALU_'+k+':') in x)\n edit('alu.sv',line,line.replace('out =','out = SEPARATE_SHIFT ? 32\\\\'b0 :'))\nedit('ex_stage.sv','  alu u_alu (','  alu #(.SEPARATE_SHIFT(1)) u_alu (')\nedit('mem_stage.sv','  mem_wb_t reg_q;','''  logic [31:0] late_result;\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_SLL: late_result = in.rs1_val << in.write_data[4:0];\n      ALU_SRL: late_result = in.rs1_val >> in.write_data[4:0];\n      ALU_SRA: late_result = \"'$unsigned($signed(in.rs1_val) >>> in.write_data[4:0]);\n      default: late_result = mul_result;\n    endcase\n  end\n  mem_wb_t reg_q;'\"''')\nedit('mem_stage.sv','is_mul(in.ctrl.alu_op) ? mul_result : in.alu_result','(is_mul(in.ctrl.alu_op) || (is_shift(in.ctrl.alu_op) && \"'!in.ctrl.alu_src)) ? late_result : in.alu_result'\"')\n# Immediate shifts get only the immediate shift amount.\nif 'hot' in tag:\n edit('core_pkg.sv','    logic        recover_fallthrough;','    logic [3:0] shift_low;\\\\n    logic [7:0] shift_high;\\\\n    logic        recover_fallthrough;')\n edit('id_stage.sv','      reg_q.instr    <= in.instr;','''      reg_q.shift_low <= 4'b1 << in.instr[21:20];\n      reg_q.shift_high <= 8'b1 << in.instr[24:22];\n      reg_q.instr    <= in.instr;''')\n sh='''\n  logic [31:0] left_short, right_short;\n  logic [31:0] left_end, right_end;\n  wire sign_fill = in.ctrl.alu_op == ALU_SRA && rs1[31];\n  always_comb begin\n    left_short = 0;\n    right_short = 0;\n    for (int i=0; i<4; i++) begin\n      left_short |= ({32{in.shift_low[i]}} & (rs1 << i));\n      right_short |= ({32{in.shift_low[i]}} & 32'(\"'$signed({sign_fill,rs1}) >>> i));\n    end\n    left_end=0;\n    right_end=0;\n    for (int i=0; i<8; i++) begin\n      left_end |= ({32{in.shift_high[i]}} & (left_short << (4*i)));\n      right_end |= ({32{in.shift_high[i]}} & 32'\"'(\"'$signed({sign_fill,right_short}) >>> (4*i)));\n    end\n  end\n  wire [31:0] imm_shift = (in.ctrl.alu_op == ALU_SLL ? left_end : right_end);'\"'''\nelse: sh='''\n  logic [31:0] imm_shift;\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_SLL: imm_shift = rs1 << in.imm[4:0];\n      ALU_SRL: imm_shift = rs1 >> in.imm[4:0];\n      default: imm_shift = \"'$unsigned($signed(rs1) >>> in.imm[4:0]);\n    endcase\n  end'\"'''\nedit('ex_stage.sv','  ex_mem_t reg_q;',sh+'\\\\n  ex_mem_t reg_q;')\nif 'split' in tag:\n edit('ex_stage.sv','  assign out = reg_q;','''  logic [31:0] shift_q;\n  logic use_shift_q;\n  always_ff @(posedge clock) if (\"'!stall) begin\n    shift_q <= imm_shift;\n    use_shift_q <= is_shift(in.ctrl.alu_op);\n  end\n  always_comb begin\n    out = reg_q;\n    out.alu_result = use_shift_q ? shift_q : reg_q.alu_result;\n  end'\"''')\nelse:\n edit('ex_stage.sv',': alu_result;', ': is_shift(in.ctrl.alu_op) ? imm_shift : alu_result;')\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/shifts.py\" shiftbasic'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
