{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv; cat cores/bench/core.yaml'", "aggregated_output": "// rtl/alu.sv\n//\n// Base integer results are combinational. DIV/REM share a blocking\n// radix-16 divider. Setup and six rounds register seven quotient digits.\n// A final trial on the held state produces the response.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_resp_valid,\n  input  logic        div_resp_ready,\n  output logic [31:0] div_result,\n  output logic [31:0] div_magnitude,\n  output logic        div_negate\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:    out = 32'b0;\n    endcase\n  end\n\n  // A request advances through setup (bit 0) and six rounds (bits 1..6).\n  logic [6:0] phase_q;\n  logic       div_issue;\n  assign div_req_ready = (phase_q == '0) && !div_resp_valid;\n  assign div_issue     = div_req_valid && div_req_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q        <= '0;\n      div_resp_valid <= 1'b0;\n    end else begin\n      phase_q        <= {phase_q[5:0], div_issue};\n      div_resp_valid <= phase_q[6] || (div_resp_valid && !div_resp_ready);\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  assign div_negate = 1'b0;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_magnitude <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_magnitude <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_magnitude <= \n…[4522 of 7594 chars elided by tools/bench/transcript.py; sha256:ee19ef59a368aacc]…\n24'b0, setup_remainder};\n    end else if (|phase_q[6:1]) begin\n      quotient_q  <= {quotient_q[27:0], digit};\n      remainder_q <= remainder_next[27:0];\n    end\n  end\n\n  // The held seventh-digit state also drives the eighth trial during\n  // backpressure. EX captures this magnitude on the response handshake.\n  assign div_magnitude = rem_op_q ? remainder_next : {quotient_q[27:0], digit};\n`endif\n\n  assign div_result = div_negate ? -div_magnitude : div_magnitude;\n\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 83.455\n  lut4: 7349\n  ff: 1462\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261123-002-r10s1\n  updated: '2026-11-23T05:25:13.609667Z'\n", "exit_code": 0, "status": "completed"}}
