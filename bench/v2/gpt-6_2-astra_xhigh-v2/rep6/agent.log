{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"sed -n '485,880p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    program[2] = ADDI(1, 0, 11)\n    program[3] = JAL(0, 0x800 - 12)\n    program[0x800 // 4] = JAL(0, 8)\n    program[0x808 // 4] = ADDI(1, 0, 22)\n    attempts = 0\n\n    def ready(pc, mem_access):\n        nonlocal attempts\n        if pc == 0x808:\n            attempts += 1\n            return attempts == 4, True\n        return True, True\n\n    rets, _ = await _run(dut, program, bus_ready=ready, stalled_word=NOP())\n    _check_path(rets, [0, 8, 12, 0x800, 0x808, 0x80c])\n    assert attempts == 4\n    assert (rets[-2][\"insn\"], rets[-2][\"rd_wdata\"]) == (program[0x808 // 4], 22)\n\n\n@cocotb.test()\nasync def successor_read_write_collision(dut):\n    # Row 0 initially points at 16. On the path 0x800 -> 0 -> 16, the\n    # fetch of 0 writes and reads row 0. Even its old, matching tag must miss.\n    program = [EBREAK()] * (0x804 // 4)\n    program[0] = JAL(0, 16)\n    program[4:7] = [ADDI(1, 1, 1), ADDI(2, 0, 2), BNE(1, 2, 0x800 - 24)]\n    program[0x800 // 4] = JAL(0, -0x800)\n    visits = 0\n    attempts = 0\n\n    def ready(pc, mem_access):\n        nonlocal visits, attempts\n        if pc == 0:\n            visits += 1\n        if visits == 2 and pc == 16:\n            attempts += 1\n            return attempts == 3, True\n        return True, True\n\n    rets, _ = await _run(dut, program, bus_ready=ready, stalled_word=NOP())\n    _check_path(rets, [0, 16, 20, 24, 0x800, 0, 16, 20, 24, 28])\n    assert attempts == 3\n\n\n@cocotb.test()\nasync def predicted_load_and_multiply_consumers(dut):\n    program = [\n        ADDI(1, 0, 3), LW(2, 0, 128), MUL(3, 2, 2), ADD(4, 3, 4),\n        ADDI(1, 1, -1), BNE(1, 0, -16), EBREAK(),\n    ]\n    loads = 0\n\n    def ready(pc, mem_access):\n        nonlocal loads\n        if pc == 4:\n            loads += 1\n        return loads <= 1 or