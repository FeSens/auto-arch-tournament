{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nimport shutil\np=Path(gettempdir())/'tmp.2n4ATr2ZEz'\nfor name,n in [('cmp17',17),('cmp9',9)]:\n r=p/name/'rtl';shutil.copytree('cores/bench/rtl',r)\n f=r/'core_pkg.sv';s=f.read_text()\n # A less-than function using equal-high prefixes.\n groups=[(min(i+n,34)-1,i) for i in range(0,34,n)]\n body=['  function automatic logic less_u34(input logic [33:0] lhs, input logic [33:0] rhs);']\n terms=[]\n for h,l in groups:\n  lt='(lhs[%d:%d] < rhs[%d:%d])'%(h,l,h,l)\n  if h<33: lt='((lhs[33:%d] == rhs[33:%d]) && %s)'%(h+1,h+1,lt)\n  terms.append(lt)\n body+=['    less_u34 = '+'\\\\n             | '.join(terms)+';','  endfunction']\n f.write_text(s.replace('\"'`endif // CORE_PKG_DEFINED'\"','\\\\n'.join(body)+'\\\\n\"'`endif // CORE_PKG_DEFINED'\"'))\n f=r/'alu.sv';s=f.read_text().replace('logic [1:0] digit;','logic [1:0] digit;\\\\n    logic c1, c2, c3;')\n s=s.replace('      // The 2D borrow', '''      c1 = less_u34(shifted, divisor_1x);\n      c2 = less_u34(shifted, divisor_2x);\n      c3 = less_u34(shifted, divisor_3x_q);\n      // The 2D borrow''')\n for i in range(1,4): s=s.replace('diff_%dx[34]'%i, 'c%d'%i)\n f.write_text(s)\n f=r/'ex_stage.sv';s=f.read_text()\n a=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n b=s.index('  assign taken',a)\n s=s[:a]+'''  logic lt, eq, signed_lt;\n  assign lt = less_u34({2'b0,rs1}, {2'b0,rs2});\n  assign eq = rs1 == rs2;\n  assign signed_lt = lt \"'^ (rs1[31] != rs2[31]);\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ: branch_cond = eq;\n      BR_BNE: branch_cond = !eq;\n      BR_BLT: branch_cond = signed_lt;\n      BR_BGE: branch_cond = !signed_lt;\n      BR_BLTU: branch_cond = lt;\n      BR_BGEU: branch_cond = !lt;\n      default: branch_cond = 1'\"'b0;\n    endcase\n  end\n'''+s[b:];f.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
