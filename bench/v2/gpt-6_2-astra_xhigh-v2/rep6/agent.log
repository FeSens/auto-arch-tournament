n  logic [31:0] quotient_q;\n  logic [32:0] back_product, n_plus_d;\n  logic [31:0] previous_q;\n  always_ff @(posedge clock) begin\n    {anchor_q, slope_q} <= coefficients[index_q];\n    u_q <= fraction_q;\n    interp_q <= slope_q * u_q;\n    anchor_delay <= anchor_q;\n    inverse_q <= anchor_delay - {19'b0,interp_q[22:8]};\n    estimate_product <= numerator * inverse_q;\n    quotient_q <= estimate_product[65:34] >> exp_q;\n    back_product <= quotient_q * divisor;\n    previous_q <= quotient_q - 1'b1;\n    n_plus_d <= {1'b0, numerator} + {1'b0, divisor};\n  end\n\n  logic [32:0] residual;\n  logic [31:0] corrected_r;\n  assign residual = {1'b0,numerator} - back_product;\n  assign corrected_r = n_plus_d[31:0] - back_product[31:0];\n  always_comb begin\n    if (zero_q) div_magnitude = rem_q ? numerator : 32'hffffffff;\n    else if (one_q) div_magnitude = rem_q ? 32'd0 : numerator;\n    else if (rem_q) div_magnitude = residual[32] ? corrected_r : residual[31:0];\n    else div_magnitude = residual[32] ? previous_q : quotient_q;\n  end\n\\\"\\\"\\\"+t[b:]\np.write_text(t)\np=r/'core_pkg.sv'; p.write_text(p.read_text().replace('    logic        div_negate;', '    logic [31:0] div_magnitude;\\\\n    logic        div_negate;'))\np=r/'ex_stage.sv'; t=p.read_text().replace('                           | ({32{div_transfer}} & div_magnitude)\\\\n',''); t=t.replace('  assign out = reg_q;','  always_ff @(posedge clock) reg_q.div_magnitude <= div_magnitude;\\\\n\\\\n  assign out = reg_q;').replace(\\\"      reg_q <= '0;\\\", \\\"      reg_q <= '0;\\\").replace('    end else if (stall) begin','    end else if (stall) begin');t=t.replace('  always_ff @(posedge clock) reg_q.div_magnitude <= div_magnitude;','  logic [31:0] div_data_q;\\\\n  always_ff @(posedge clock) div_data_q <= div_magnitude;').replace('  assign out = reg_q;', '  always_comb begin\\\\n    out = reg_q;\\\\n    out.div_magnitude = div_data_q;\\\\n  end')\np.write_text(t)\np=r/'mem_stage.sv';t=p.read_text().replace('