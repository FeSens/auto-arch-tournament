{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/loop_two.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,os,shutil\nfrom tools.eval.gowin import build_all\nroot=Path(os.environ['TMPDIR']); name=sys.argv[1]; w=int(sys.argv[2]);d=root/name/'rtl';shutil.copytree(root/f'resolved{1<<w}'/'rtl',d)\np=d/'if_stage.sv';s=p.read_text();start=s.index('  logic active;');end=s.index('  // A correction',start)\ns=s[:start]+'''  logic [1:0] active, in_loop, hit, covers, invalid, record;\n  logic victim;\n  logic [31:0] loop_head [0:1], loop_tail [0:1];\n  logic [(1<<W)-1:0] filled [0:1];\n  logic [W-1:0] index;\n  logic [31:0] op_word, live_target;\n  logic [65:0] entry [0:1], live_word, selected;\n  logic live_branch, live_jal;\n  assign index = pc[W+1:2];\n  assign live_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] \"'!= 2'\"'b01;\n  assign live_jal = imem_data[6:0] == 7'b1101111;\n  assign displacement = imem_data[2]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign live_target = pc + displacement;\n  assign live_word = {live_jal,live_branch,live_target,imem_data};\n  assign selected = hit[0] ? entry[0] : hit[1] ? entry[1] : live_word;\n  assign available = (|hit) || imem_ready;\n  assign {is_jal,is_branch,target,op_word} = selected;\n  assign predicted_taken = (is_jal || (is_branch && counter[1]))\n                        && target[1:0] == 2'b00 && target[31:20] == 12'b0;\n  logic alloc_way;\n  assign alloc_way = \"'!active[0] ? 1'\"'b0 : \"'!active[1] ? 1'\"'b1 : victim;\n  for (genvar k=0; k<2; k++) begin : loops\n    logic [65:0] ram [0:(1<<W)-1];\n    logic allocate;\n    assign entry[k] = ram[index];\n    assign in_loop[k] = active[k] && pc >= loop_head[k] && pc <= loop_tail[k];\n    assign hit[k] = in_loop[k] && filled[k][index];\n    assign record[k] = \"'!