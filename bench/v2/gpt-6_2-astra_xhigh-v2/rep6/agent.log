{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predict/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom os import environ\nd = Path(environ[\\\"TMPDIR\\\"])/\\\"predict/cores/bench/rtl\\\"\ndef replace(file, a, b):\n    p = d / (file + \\\".sv\\\")\n    s = p.read_text()\n    assert a in s, a\n    p.write_text(s.replace(a,b,1))\nmeta = \\\"    logic        pred_taken;\\\\n    logic [1:0]  pred_ctr;\\\\n\\\"\nreplace(\\\"core_pkg\\\",\\\"    logic [31:0] pc;\\\\n    logic [31:0] instr;\\\",meta + \\\"    logic [31:0] pc;\\\\n    logic [31:0] instr;\\\")\nreplace(\\\"core_pkg\\\",\\\"    logic [31:0] pc;\\\\n    logic [31:0] rs1_val;\\\",meta + \\\"    logic [31:0] pc;\\\\n    logic [31:0] rs1_val;\\\")\nreplace(\\\"if_stage\\\",\\\"  output logic [31:0]       imem_addr,\\\", \\\"\\\"\\\"  input  logic              train,\n  input  logic [6:0]        train_idx,\n  input  logic [1:0]        train_value,\n  output logic [31:0]       imem_addr,\\\"\\\"\\\")\nreplace(\\\"if_stage\\\",\\\"  always_comb begin\\\\n    next_pc = redirect ? redirect_target : pc + 32'd4;\\\\n  end\\\", \\\"\\\"\\\"  logic [1:0] counters [0:127];\n  logic [31:0] displacement, target;\n  logic is_branch, is_jal, predict_taken;\n  initial begin\n    for (int i=0; i<128; i=i+1) counters[i] = 2'b01;\n  end\n  always_ff @(posedge clock)\n    if (train) counters[train_idx] <= train_value;\n  assign is_jal = imem_data[6:0] == 7'h6f;\n  assign is_branch = imem_data[6:0] == 7'h63\n                   && imem_data[14:13] \"'!= 2'\"'b01;\n  assign displacement = imem_data[2]\n       ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n       : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign target = pc + displacement;\n  assign predict_taken = (is_jal || (is_branch && out.pred_ctr[1]))\n                      && target[31:20] == 0 && target[1:0] == 0;\n  assi