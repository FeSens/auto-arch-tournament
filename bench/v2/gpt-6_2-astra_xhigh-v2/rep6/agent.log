{"type":"item.completed","item":{"id":"item_119","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/wb_stage.sv'","aggregated_output":"// rtl/wb_stage.sv\n//\n// Write-back stage. The MEM/WB edge has already selected the completed\n// result for both register writeback and WB-to-EX forwarding.\n//\n// Latency:        combinational.\n// RVFI fields:    feeds rd_wdata (= w_data when w_en=1, else 0).\nmodule wb_stage (\n  // mem_wb_t fields beyond valid/reg_write/rd/result\n  // (pc, mem_*, rs?_*, instr) are RVFI-only and read at top level.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  mem_wb_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic               w_en,\n  output logic [4:0]         w_addr,\n  output logic [31:0]        w_data\n);\n\n  always_comb begin\n    w_en   = in.ctrl.reg_write && in.valid;\n    w_addr = in.rd;\n    w_data = in.result;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
