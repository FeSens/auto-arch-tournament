{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// DIV/REM use radix 16 for a 16-bit divisor and radix 4 for a 16-bit\n// quotient. Both arrays register seven digits and present the eighth\n// from the held response state.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_resp_valid,\n  input  logic        div_resp_ready,\n  output logic [31:0] div_result,\n  output logic [31:0] div_magnitude,\n  output logic [31:0] div_small_term,\n  output logic [31:0] div_large_term,\n  output logic        div_negate\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:    out = 32'b0;\n    endcase\n  end\n\n  // A request advances through setup (bit 0) and six rounds (bits 1..6).\n  logic [6:0] phase_q;\n  logic       div_issue;\n  assign div_req_ready = (phase_q == '0) && !div_resp_valid;\n  assign div_issue     = div_req_valid && div_req_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q        <= '0;\n      div_resp_valid <= 1'b0;\n    end else begin\n      phase_q        <= {phase_q[5:0], div_issue};\n      div_resp_valid <= phase_q[6] || (div_resp_valid && !div_resp_ready);\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  assign div_negate = 1'b0;\n  assign div_large_term = '0;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_small_term <= (a - b) ^ 32'h7f8529ec;\n        ALU_DI\n…[7286 of 10358 chars elided by tools/bench/transcript.py; sha256:a58a8ca482830b19]…\n] && !fits[3]}} & diff[2][W-1:0])\n                    | ({W{fits[3]}} & diff[3][W-1:0]);\n  end\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      large_quot_q[15:2] <= dividend_mag[13:0];\n    end else if (phase_q[0]) begin\n      triple_q          <= triple_d;\n      large_quot_q[1:0] <= large_setup_digit;\n      large_rem_q       <= {12'b0, large_setup_rem};\n    end else if (|phase_q[6:1]) begin\n      large_quot_q <= {large_quot_q[13:0], large_digit};\n      large_rem_q  <= large_rem_next[29:0];\n    end\n  end\n\n  assign div_small_term = ({32{small_quot_en}} & {small_quot_q[27:0], digit})\n                        | {16'b0, {16{small_rem_en}} & small_rem_next};\n  assign div_large_term = {32{zero_quot_en}}\n                        | {16'b0, {16{large_quot_en}} & {large_quot_q[13:0], large_digit}}\n                        | ({32{large_rem_en}} & large_rem_next);\n`endif\n\n  assign div_magnitude = div_small_term | div_large_term;\n  assign div_result = div_negate ? -div_magnitude : div_magnitude;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
