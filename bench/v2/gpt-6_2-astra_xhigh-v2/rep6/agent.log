all\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n4:fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n63:def DIV (rd, rs1, rs2): return _r(1, rs2, rs1, 0b100, rd, 0b0110011)\n64:def REM (rd, rs1, rs2): return _r(\n…[3112 of 6184 chars elided by tools/bench/transcript.py; sha256:4a2f001e9ce84831]…\nly taken.\n596:async def predicted_load_and_multiply_consumers(dut):\n739:async def subword_branch_and_divide_replay(dut):\n745:        _i(0x82, 0, 4, 1, 0x03), DIV(3, 1, 2),    # stale 255, correct 3\n773:    # The immediate names x5 in the encoded rs2 field. RVFI still\n844:    # bus word is 7, so only a premature branch resolution would skip SW.\n1010:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n1030:    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n1053:    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n1056:    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n1057:    This is one valid RVFI interpretation (the spec says \"for\n1076:    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n1088:    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n1096:async def rvfi_order_strictly_monotonic(dut):\n1097:    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n", "exit_code": 0, "status": "completed"}}
