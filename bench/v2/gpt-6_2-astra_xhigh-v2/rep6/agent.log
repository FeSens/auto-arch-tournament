:02.961865Z'\n// rtl/alu.sv\n//\n// Integer and multiply results are combinational. DIV/REM share a blocking\n// divider with one setup clock and six registered radix-4 rounds.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  log\n…[4930 of 8002 chars elided by tools/bench/transcript.py; sha256:918ffbb353967815]…\n = diff_2x[34]\n                     ? (diff_1x[34] ? shifted[31:0] : diff_1x[31:0])\n                     : (diff_3x[34] ? diff_2x[31:0] : diff_3x[31:0]);\n      quotient_next = {quotient_next[33:0], digit};\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      divisor_q   <= b_negative ? -b : b;\n      quotient_q  <= {4'b0000, dividend_mag};\n      remainder_q <= '0;\n      rem_op_q    <= rem_op;\n      // Subtracting zero succeeds on every step, giving an all-ones\n      // quotient and the dividend magnitude as remainder.\n      negate_q    <= rem_op ? a_negative : ((a_negative ^ b_negative) && b != 0);\n    end else if (|phase_q[6:1]) begin\n      quotient_q  <= quotient_next;\n      remainder_q <= remainder_next;\n    end\n  end\n\n  // INT_MIN / -1 yields magnitude 2^31 with a positive sign, which\n  // already has the required RV32 overflow bit pattern.\n  assign magnitude  = rem_op_q ? remainder_q : quotient_q[31:0];\n  assign div_result = negate_q ? -magnitude : magnitude;\n`endif\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
