[p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[8512 of 11584 chars elided by tools/bench/transcript.py; sha256:4d80ee035e901b47]…\ne & 0x7F)\n29:def _s(imm, rs2, rs1, funct3, opcode):\n33:         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n36:def _b(imm, rs2, rs1, funct3, opcode):\n43:         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n46:def _j(imm, rd, opcode):\n53:         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n126:                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n127:                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n221:    leaked = [r for r in rets if r[\"pc\"] == 4]\n227:    pcs = [r[\"pc\"] for r in rets]\n228:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n234:async def jal_writes_pc_plus_4(dut):\n243:    pcs = [r[\"pc\"] for r in rets]\n244:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n247:    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n263:    pcs = [r[\"pc\"] for r in rets]\n264:    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n344:def test_pipeline_runner():\n355:        test_module=\"test_pipeline\",\n", "exit_code": 0, "status": "completed"}}
