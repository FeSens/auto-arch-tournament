[0:511];\n  successor_t  candidate;\n  logic [511:0] occupied;\n  logic [8:0]  index_now, prev_index;\n  logic        prev_valid, candidate_valid, hit, accept, fill, can_fill;\n  logic [17:0] predicted_target_word;\n\n  initial begin\n    for (int i = 0; i < 128; i++) counters[i] = 2'b01;\n  end\n\n  assign counter = c\n…[2563 of 5635 chars elided by tools/bench/transcript.py; sha256:e580a1a90e8b0904]…\nken ? {12'b0, predicted_target_word, 2'b00} : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc                = pc;\n    out.instr             = imem_ready ? imem_data : candidate.instr;\n    out.predicted_taken   = predicted_taken;\n    out.direction_counter = counter;\n    out.valid             = imem_ready || hit;\n  end\n\nendmodule\n_helpers.py\nconftest.py\ntest_alu.py\ntest_decoder.py\ntest_imm_gen.py\ntest_multiplier.py\ntest_pipeline.py\ntest_reg_file.py\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 70.62\n  lut4: 4824\n  ff: 1470\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261123-001-r7s0\n  updated: '2026-11-23T01:38:34.551939Z'\n", "exit_code": 0, "status": "completed"}}
