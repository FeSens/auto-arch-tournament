{"type": "item.completed", "item": {"id": "item_99", "type": "command_execution", "command": "/bin/bash -c \"sed -n '852,920p' cores/bench/test/test_pipeline.py; sed -n '20,57p' cores/bench/rtl/forward_unit.sv; git diff --check\"", "aggregated_output": "\n@cocotb.test()\nasync def invalid_direct_targets_and_reserved_branch(dut):\n    program = [EBREAK()] * (0x420 // 4)\n    program[0] = JAL(5, 8)                 # x5 = 4\n    program[2] = JAL(5, 6)                 # misaligned target, preserve x5\n    program[3] = JALR(5, 5, -1)            # 4 - 1 rounds to 2, also traps\n    program[4] = BEQ(0, 0, 512)            # train the entry for PC 0x010\n    program[0x210 // 4] = _b(12, 0, 0, 2, 0x63)  # reserved, even on a table hit\n    program[0x214 // 4] = JAL(0, 0x410 - 0x214)\n    program[0x410 // 4] = BNE(0, 0, -2048) # aliased, negative target\n    program[0x414 // 4] = BEQ(0, 0, 2)     # misaligned taken branch\n    program[0x418 // 4] = BNE(0, 0, 2)     # untaken, alignment irrelevant\n    program[0x41c // 4] = ADDI(5, 5, 1)    # consumes the original link\n\n    def ready(pc, mem_access):\n        assert pc < 0x100000 and pc % 4 == 0\n        assert pc != 0x21c, \"reserved branch predicted taken\"\n        return True, True\n\n    rets, _ = await _run(dut, program + [EBREAK()], bus_ready=ready)\n    pcs = [0, 8, 12, 16, 0x210, 0x214, 0x410, 0x414, 0x418, 0x41c, 0x420]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [8, 12, 0x210, 0x414]\n    assert all((r[\"rd\"], r[\"rd_wdata\"]) == (0, 0) for r in rets if r[\"trap\"])\n    assert rets[-2][\"rd_wdata\"] == 5\n\n\n@cocotb.test()\nasync def held_jalr_recovers_while_imem_stalled(dut):\n    program = [\n        ADDI(5, 0, 21),\n        LW(3, 0, 0),\n        JALR(1, 5, 0),  # x5 forwarded from WB, target bit zero cleared\n        SW(5, 0, 4),    # wrong-path fetch throughout the data stall\n        EBREAK(),\n        ADDI(2, 1, 1),\n        EBREAK(),\n    ]\n    fetches = []\n    load_cycles = 0\n\n    def ready(pc, mem_access):\n        nonlocal load_cycles\n        assert not int(dut.io_dmemWEn.value), \"wrong-path store reached dmem\"\n        fetches.append(pc)\n        if mem_access:\n            load_cycles += 1\n            assert pc == 12\n            # Release the load while the wrong-path instruction is unready.\n            return load_cycles < 4, load_cycles == 4\n        return True, True\n\n    rets, _ = await _run(dut, program, {0: 37}, bus_ready=ready)\n    assert load_cycles == 4\n    assert fetches[:8] == [0, 4, 8, 12, 12, 12, 12, 20]\n    pcs = [0, 4, 8, 20, 24]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(not r[\"trap\"] for r in rets)\n    assert rets[1][\"rd_wdata\"] == 37\n    assert (rets[2][\"rd\"], rets[2][\"rd_wdata\"]) == (1, 12)\n    assert rets[3][\"rd_wdata\"] == 13\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n\n  logic ex_match, mem_match, from_ex, from_mem;\n  logic mem_match_q;\n\n  assign ex_match = decode_rs != 0 && decode_rs == id_ex_rd;\n  assign mem_match = decode_rs != 0 && decode_rs == ex_mem_rd;\n  assign from_ex = ex_match && next_mem_writer;\n  assign from_mem = mem_match && next_wb_writer;\n\n  always_ff @(posedge clock) begin\n    if (!hold_mem) begin\n      mem_match_q   <= !hold_id && ex_match;\n      sel.ex_mem    <= !hold_id && from_ex && !id_ex_load;\n      sel.load_word <= !hold_id && from_ex && id_ex_load;\n      // On a local replay or divide wait the matched MEM producer drains\n      // to WB. A faulting load leaves the consumer on its captured value.\n      if (hold_id) begin\n        sel.mem_wb   <= mem_match_q && next_wb_writer;\n        sel.captured <= !(mem_match_q && next_wb_writer);\n      end else begin\n        sel.mem_wb   <= !from_ex && from_mem;\n        sel.captured <= !from_ex && !from_mem;\n      end\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
