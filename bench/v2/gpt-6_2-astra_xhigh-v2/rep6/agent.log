{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"cat tools/eval/_slots.py && rg -n 'def validate_coremark_uart|def run_cosim|ARENA|argparse|bench_only|trace' tools/eval/{fpga,cosim}.py | head -60 && ls -lh /opt/gowin/IDE/bin/gw_sh\"","aggregated_output":"\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\ntools/eval/fpga.py:279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\ntools/eval/cosim.py:4:  1. Full RVFI trace cosim for selftest and any other small ELF — every\ntools/eval/cosim.py:6:  2. CoreMark CRC validation via the sim's UART capture — full-trace cosim\ntools/eval/cosim.py:11:     catches any CPU bug that affects CoreMark output without the full trace\ntools/eval/cosim.py:42:# Stall modes for the full-trace comparison. The stalled mode uses the same\ntools/eval/cosim.py:44:# memory port stalls (which V2 now times and scores) is trace-checked too.\ntools/eval/cosim.py:73:    Full-trace cosim would take >30 min; the CRC guard is sensitive to any\ntools/eval/cosim.py:125:def run_cosim(worktree: str, target: str | None = None) -> dict:\ntools/eval/cosim.py:148:    # Split ELFs into full-trace cosim vs CRC-validated coremark.\ntools/eval/cosim.py:150:    trace_elfs = [p for p in all_elfs if p.name != \"coremark.elf\"]\ntools/eval/cosim.py:153:    if not trace_elfs and coremark is None:\ntools/eval/cosim.py:156:    # 1. Full-trace cosim of small ELFs (parallel).\ntools/eval/cosim.py:159:                   for elf in trace_elfs for flags in TRACE_STALL_MODES}\ntools/eval/cosim.py:179:    tested = len(trace_elfs) + (1 if coremark else 0)\n-rwxr-xr-x 1 nobody nogroup 25K Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n","exit_code":0,"status":"completed"}}
