{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/class.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nfrom tools.eval.gowin import build_all\ntag=sys.argv[1];base=Path(os.environ['TMPDIR'])/('r9-'+tag);p=base/'rtl'\nshutil.copytree(Path(os.environ['TMPDIR'])/'r9-lanesflat/rtl',p,dirs_exist_ok=True)\ndef edit(file,old,new):\n f=p/file;s=f.read_text();assert old in s;f.write_text(s.replace(old,new))\nf=p/'ex_stage.sv';s=f.read_text()\npos=s.index('  always_ff @(posedge clock) sum_q <=');end=s.index(';\\\\n',pos)\nterms=s[pos:end].split(' <= ')[1].split(' | ')\nspec=' | '.join(terms[10:]);shift=' | '.join(terms[7:10]);logic=' | '.join(terms[2:7])\nif 'dual' in tag:\n add='({32{in.op_add && in.ctrl.alu_src}} & (rs1 + in.imm)) | ({32{in.op_add && \"'!in.ctrl.alu_src}} & (rs1 + rs2)) | ({32{in.op_sub}} & (rs1 - rs2))'\"'\nelse:add=' | '.join(terms[:2])\nif 'id' in tag:\n # collapse non-register-dependent producers into one locally registered input.\n edit('core_pkg.sv','    logic        recover_fallthrough;', '    logic [31:0] const_result;\\\\n    logic        recover_fallthrough;')\n edit('id_stage.sv','      reg_q.pc       <= in.pc;',\\\"\\\"\\\"      reg_q.const_result <= ({32{dec_is_jump}} & (in.pc + 32'd4))\n                         | ({32{dec_is_lui}} & imm)\n                         | ({32{dec_is_auipc}} & (in.pc + imm));\n      reg_q.pc       <= in.pc;\\\"\\\"\\\")\n spec='in.const_result | ({32{in.op_div}} & div_result)'\nif 'paired' in tag:\n # Place common arithmetic on a dedicated result pair of flops. Select\n # after the edge using mutually exclusive group enables.\n main='''  logic arithmetic_q;\n  always_ff @(posedge clock) begin\n    arithmetic_q <= in.op_add || in.op_sub;\n    sum_q <= in.op_sub ? rs1 - rs2 : rs1 + alu_b;\n    logic_q <= '''+' | '.join([shift,logic,spec])+''';\n  end'''\n s=s.replace('out.alu_result=sum_q;', 'out.alu_result=arithmetic_q ? sum_q : logic_q;')\nelif 'last' in tag:\n main='''  always_ff @(posedge clock) sum_q <= in.op_sub ? rs1 - rs2 : in.op_add ? rs1 + alu_b : ('''+ ' | '.join([shift,logic,spec])+')'\nelif 'three' in tag:\n main='''  always_ff @(posedge clock) sum_q <= '''+add+''';\n  always_ff @(posedge clock) logic_q <= '''+logic+' | '+spec+''';\n  always_ff @(posedge clock) shift_q <= '''+shift\n s=s.replace('out.alu_result=sum_q;', 'out.alu_result=sum_q | logic_q | shift_q;')\nelse:main='  always_ff @(posedge clock) sum_q <= '+' | '.join([add,logic,shift,spec])\ns=s[:pos]+main+s[end:];f.write_text(s)\nfor v in build_all(Path.cwd(),p,'fpga/core_bench_si.sv',base/'timing',options=(1,)):\n print(tag,v['fmax_mhz'],v.get('critical_paths',[{}])[0])\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/class.py\" classidthree'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
