        return ADDI(0, 0, 0)        # = 0x00000013\n76:def EBREAK():            return 0x00100073\n77:def ECALL():             return 0x00000073\n81:async def _run(dut, program, dmem_init=None, max_cycles=200, bus_ready=None, stores=None,\n82:               stalled_word=None, unified_memory=False, reads=\n…[5237 of 8309 chars elided by tools/bench/transcript.py; sha256:374cf4aa1129ee4a]…\ns == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n1039:async def jalr_target(dut):\n1050:    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n1056:async def sw_lw_roundtrip(dut):\n1072:async def illegal_traps(dut):\n1095:async def ecall_traps(dut):\n1107:async def ebreak_does_not_trap(dut):\n1116:async def rvfi_order_strictly_monotonic(dut):\n1130:def test_pipeline_runner():\ntotal 108\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 23 06:46 .\ndrwxrwx---+ 5 nobody nogroup  4096 Nov 23 06:46 ..\n-rw-rw----+ 1 nobody nogroup  2143 Nov 23 06:46 _helpers.py\n-rw-rw----+ 1 nobody nogroup   361 Nov 23 06:46 conftest.py\n-rw-rw----+ 1 nobody nogroup 11839 Nov 23 06:46 test_alu.py\n-rw-rw----+ 1 nobody nogroup 11218 Nov 23 06:46 test_decoder.py\n-rw-rw----+ 1 nobody nogroup  2478 Nov 23 06:46 test_imm_gen.py\n-rw-rw----+ 1 nobody nogroup  2024 Nov 23 06:46 test_multiplier.py\n-rw-rw----+ 1 nobody nogroup 47553 Nov 23 06:46 test_pipeline.py\n-rw-rw----+ 1 nobody nogroup  2626 Nov 23 06:46 test_reg_file.py\n", "exit_code": 0, "status": "completed"}}
