 logic [31:0]        predicted_value,')\n W=44 if src=='rotation' else 42\n a=s.index('  (* syn_ramstyle',s.index('ctrl_t ctrl_with_trap;'))\n if src=='rotation':\n  b=s.index('  logic [255:0] occupied;',a)\n  s=s[:a]+s[b:]\n  a=s.index('  assign lookup_row =')\n  b=s.index('  assign raw_word',a)\n  s=s[:a]+s[b:]\n  a=s.index('  always_ff @(posedge clock) begin\\\\n    if (\"'!hold_wb) begin'\"')\n else:\n  a=s.index('  (* syn_ramstyle',s.index('assign install ='))\n b=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      occupied',a)\n bankcode=f\\\"\\\"\\\"  logic [{W-1}:0] bank_record [0:{n-1}];\n  logic [{e-1}:0] bank_q;\n  always_ff @(posedge clock) if (\"'!hold_wb) bank_q <= lookup_index[7:{8-e}];\n  assign predicted_value = bank_values[bank_q*32 +: 32];\n  for(genvar bank=0;bank<{n};bank++) begin : gen_bank\n    (* syn_ramstyle = \"distributed_ram\" *) logic [{W-1}:0] words [0:{256//n-1}];\n    wire [{W-1}:0] row = words[lookup_index[{7-e}:0]];\n\"\"\"\n if src=='\"'rotation':\n  bankcode+='''    wire [31:0] form = extend(row[31:0],lookup_width,lookup_sext);\n'''\n else:\n  bankcode+='''    wire [31:0] form = extend(permute(row[31:0],lookup_lane),lookup_width,lookup_sext);\n'''\n value='{in.effective_addr[19:10],in.effective_addr[1:0],rotated_word}' if src=='rotation' else '{in.effective_addr[19:10],source_word}'\n bankcode+=f\\\"\\\"\\\"    always_ff @(posedge clock) begin\n      if (\"'!hold_wb) begin\n        bank_values[bank*32+:32] <= form;\n        bank_record[bank] <= row;\n      end\n      if(update && install && update_index[7:{8-e}] == {e}'\"'(bank))\n        words[update_index[{7-e}:0]] <= {value};\n    end\n  end\n\\\"\\\"\\\"\n bankcode+=('  assign {candidate_tag,saved_lane,saved_data} = bank_record[bank_q];\\\\n' if src=='rotation' else '''  assign {candidate_tag,saved_data} = bank_record[bank_q];\n  always_ff @(posedge clock) if (\"'!hold_wb) saved_lane <= lookup_lane;\n'\"''')\n if src=='lane_read':\n  s=s.replace('wor