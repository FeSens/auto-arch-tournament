{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/conftest.py && tail -85 cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\nasync def divider_reference_vectors(dut):\n    await _setup(dut)\n    rng = random.Random(0xD174)\n    pairs = [(0x80000000, 0), (0xFFFFFFFF, 0x80000000),\n             (0x80000000, 0x80000001), (0x80000001, 0x80000001)]\n    # Vary the divisor width to exercise both long and short quotients.\n    for width in range(1, 33):\n        a, b = rng.getrandbits(32), rng.getrandbits(width)\n        pairs.extend([(a, b), (a, -b & MASK32)])\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in pairs:\n            signed = op in (ALU_DIV, ALU_REM)\n            dividend = a - (1 << 32) if signed and a >> 31 else a\n            divisor = b - (1 << 32) if signed and b >> 31 else b\n            if divisor:\n                q = abs(dividend) // abs(divisor)\n                if (dividend < 0) != (divisor < 0):\n                    q = -q\n                r = dividend - divisor * q\n            else:\n                q, r = -1, dividend\n            await _check_div(dut, op, a, b, r if op in (ALU_REM, ALU_REMU) else q)\n\n\n@cocotb.test()\nasync def divider_digit_boundaries(dut):\n    await _setup(dut)\n    # Small D reaches all digits. For large D also try the low word of\n    # each overflowing boundary, where a truncated multiple could win.\n    divisors = (7, 0x08000001, 0x11111111, 0x1FFFFFFF, 0x24924924, 0x2AAAAAAA,\n                0x33333333, 0x40000001, 0x55555555, 0x55555556, 0x80000001,\n                0xC0000001, 0xFFFFFFFF)\n    for divisor in divisors:\n        for k in (*range(16), 16, 24):\n            for offset in (-1, 0, 1):\n                dividend = (k * divisor + offset) & MASK32\n                quotient, remainder = divmod(dividend, divisor)\n                await _check_div(dut, ALU_DIVU, dividend, divisor, quotient)\n                await _check_div(dut, ALU_REMU, dividend, divisor, remainder, hold_cycles=2)\n\n    # Put each digit in all six registered rounds and in the response.\n    for digit in range(16):\n        quotient = 0x01111111 * digit\n        dividend = 15 * quotient + 14\n        await _check_div(dut, ALU_DIVU, dividend, 15, quotient)\n        await _check_div(dut, ALU_REMU, dividend, 15, 14)\n\n\n@cocotb.test()\nasync def divider_setup_prefixes(dut):\n    await _setup(dut)\n    for prefix in range(16):\n        dividend = (prefix << 28) | 0x015A73C9\n        for divisor in range(17):\n            quotient, remainder = divmod(dividend, divisor) if divisor else (MASK32, dividend)\n            await _check_div(dut, ALU_DIVU, dividend, divisor, quotient)\n            await _check_div(dut, ALU_REMU, dividend, divisor, remainder)\n\n\n@cocotb.test()\nasync def divider_reset(dut):\n    await _setup(dut)\n    # Reset on the setup edge, during iteration, on the final edge, and\n    # after a completed response has spent two clocks under backpressure.\n    for elapsed in (0, 1, 4, DIV_LATENCY - 1, DIV_LATENCY + 2):\n        dut.div_resp_ready.value = 0\n        await _issue_div(dut, ALU_DIV, -101, 7)\n        for _ in range(elapsed):\n            await _tick(dut)\n        assert not int(dut.div_req_ready.value)\n        assert int(dut.div_resp_valid.value) == (elapsed >= DIV_LATENCY)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(DIV_LATENCY + 1):\n            assert int(dut.div_req_ready.value) and not int(dut.div_resp_valid.value)\n            await _tick(dut)\n        await _check_div(dut, ALU_REMU, 0xFFFFFFFF, 0x80000000, 0x7FFFFFFF)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
