{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv'","aggregated_output":"// rtl/forward_unit.sv\n//\n// Generate one-hot operand enables from the youngest matching writer.\n// Both the load match and bank enables are independent of MEM verification.\n//\n// Decode compares the incoming rs against the next cycle's MEM and WB\n// destinations so register-number comparisons stay off the EX data path.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       reset,\n  input  logic       hold_id,\n  input  logic       hold_mem,\n  input  logic [4:0] decode_rs,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_writes,\n  input  logic       ex_load,\n  input  logic       mem_writes,\n  input  logic [3:0] bank_select,\n  output logic       load_match,\n  output bypass_t    sel\n);\n\n  logic match_ex, match_mem, next_wb;\n  assign match_ex  = ex_writes && id_ex_rd != 0 && id_ex_rd == decode_rs;\n  assign match_mem = mem_writes && ex_mem_rd != 0 && ex_mem_rd == decode_rs;\n\n  // On replay the current MEM writer drains to WB. A trapping load\n  // has mem_writes clear, so the held consumer uses its captured value.\n  assign next_wb = hold_id ? ((load_match || sel.ex_mem) && mem_writes)\n                           : (!match_ex && match_mem);\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sel.captured <= 1'b1;\n      sel.ex_mem   <= 1'b0;\n      sel.mem_wb   <= 1'b0;\n      load_match   <= 1'b0;\n    end else if (!hold_mem) begin\n      sel.captured <= !(match_ex && !hold_id) && !next_wb;\n      sel.ex_mem   <= match_ex && !ex_load && !hold_id;\n      sel.mem_wb   <= next_wb;\n      load_match   <= match_ex && ex_load && !hold_id;\n    end\n  end\n  assign sel.banks = {4{load_match}} & bank_select;\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/reg_file.sv'","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// The reset clears all 32 registers. Distributed-LUT or flop inference is\n// fine here; explicit BRAM attribution lives on the larger imem/dmem\n// declarations in soc.sv (phase 5).\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs [0:31];\n  logic [31:0] written;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      written <= '0;\n    else if (w_en && w_addr != 5'b0) begin\n      written[w_addr] <= 1'b1;\n      regs[w_addr] <= w_data;\n    end\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = written[rs1_addr] ? regs[rs1_addr] : 32'b0;\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = written[rs2_addr] ? regs[rs2_addr] : 32'b0;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
