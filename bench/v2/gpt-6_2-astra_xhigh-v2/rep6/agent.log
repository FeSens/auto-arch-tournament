if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n\n  // A correction consumes no imem data, so it also applies on an imem stall.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= predict_taken ? {12'b0, target_word, 2'b00} : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  assign out.pc    = pc;\n  assign out.instr = imem_data;\n\nendmodule\n","exit_code":0,"status":"completed"}}
