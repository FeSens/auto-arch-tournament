{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py && cat cores/bench/core.yaml'", "aggregated_output": "\"\"\"Run the EX ALU, seven-round divider, and multiplier unit tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.result_sel.value = 0\n    dut.div_start.value = 0\n    dut.div_accept.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.result_sel.value = 1 << op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0, previous_result=None):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    if previous_result is not None:\n        # MEM samples this value on the edge that issues the next divide.\n        await Timer(1, \"ns\")\n        assert int(dut.div_result.value) == previous_result & MASK32\n    await _tick(dut)\n    dut.div_start.value = 0\n    # The bypass inputs and opcode can change as soon as issue completes.\n    dut.op.value = ALU_ADD\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n\n    for _ in range(6):\n        assert int(dut.div_busy.value) and not int(dut.div_done.value)\n        assert not int(dut.div_last.value)\n        await _tick(dut)\n\n    assert int(dut.div_busy.value\n…[7739 of 10811 chars elided by tools/bench/transcript.py; sha256:3c124981e8f2e11d]…\ndut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n    await _check_div(dut, ALU_REM, -10, 3, -1)\n\n\ndef test_alu_runner():\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_multiplier_runner():\n    run_cocotb(toplevel=\"multiplier\", sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_multiplier\")\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 97.26\n  lut4: 4883\n  ff: 1934\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-003-r13s2\n  updated: '2026-11-21T22:59:53.940748Z'\n", "exit_code": 0, "status": "completed"}}
