{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv; cat cores/bench/test/_helpers.py'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (PC, instruction, prediction and validity) is combinational. The ID/EX\n// register captures the bundle when decode accepts the fetch.\n//\n// A BTB hit supplies a previously resolved instruction during an imem\n// wait. An available external word always wins. ID captures a bubble on\n// recovery or when neither source has an instruction.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              redirect,\n  input  logic [31:0]       redirect_target,\n  input  btb_update_t       update,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [5:0]  index;\n  logic [63:0] valid;\n  logic [11:0] tags [0:63];\n  logic [19:2] targets [0:63];\n  logic [31:0] words [0:63];\n  logic [1:0]  counters [0:63];\n  logic        external_control;\n  prediction_t prediction;\n\n  assign index = pc[7:2];\n  always_ff @(posedge clock) begin\n    if (reset || update.invalidate) valid <= '0;\n    else if (update.write)          valid[update.pc[7:2]] <= 1'b1;\n  end\n\n  // Only the valid bits need reset. Each payload array has a single\n  // synchronous write and an asynchronous read at the current fetch PC.\n  always_ff @(posedge clock) begin\n    if (update.write) begin\n      tags[update.pc[7:2]]     <= update.pc[19:8];\n      targets[update.pc[7:2]]  <= update.target;\n      words[update.pc[7:2]]    <= update.instr;\n      counters[update.pc[7:2]] <= update.counter;\n    end\n  end\n\n  assign external_control = imem_data[6:0] == 7'h6f ||\n                            (imem_data[6:0] == 7'h67 && imem_data[14:12] == 3'b000) ||\n    \n…[1888 of 4960 chars elided by tools/bench/transcript.py; sha256:719184352bdf4aee]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
