 localparam int R_BITS = 4 + 7 * lane;\n\n    logic [Q_BITS-1:0] quotient_q, quotient_next;\n    logic [R_BITS-1:0] remainder_q, remainder_next;\n    logic [R_BITS-1:0] initial_remainder;\n    logic [DIGITS-1:0] digits;\n    logic [R_BITS-1:0] difference;\n    logic              borrow, unused_difference_msb;\n    if (lane == 0) begin : g_zero_seed\n      assign initial_remainder = '0;\n    end else begin : g_prefix_seed\n      assign initial_remainder = R_BITS'(dividend_abs[31:Q_BITS]);\n    end\n\n    always_comb begin\n      remainder_next = remainder_q;\n      for (int i = 0; i < DIGITS; i++) begin\n        // Keep the shifted-out bit through the subtract. A successful\n        // subtraction leaves a remainder that fits back in R_BITS.\n        {borrow, unused_difference_msb, difference} =\n            {1'b0, remainder_next, quotient_q[Q_BITS-1-i]} - {2'b0, divisor_q[R_BITS-1:0]};\n        digits[DIGITS-1-i] = !borrow;\n        remainder_next = digits[DIGITS-1-i] ? difference :\n                         {remainder_next[R_BITS-2:0], quotient_q[Q_BITS-1-i]};\n      end\n      quotient_next = {quotient_q[Q_BITS-DIGITS-1:0], digits};\n    end\n\n    always_ff @(posedge clock) begin\n      if (div_start) begin\n        remainder_q <= initial_remainder;\n        quotient_q  <= Q_BITS'(dividend_abs);\n      end else if (div_busy && !div_done) begin\n        remainder_q <= remainder_next;\n        quotient_q  <= quotient_next;\n      end\n    end\n\n","exit_code":0,"status":"completed"}}
