{"type": "item.completed", "item": {"id": "item_56", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/core.sv | sed -n '135,265p'; cat cores/bench/rtl/hazard_unit.sv; cat cores/bench/rtl/forward_unit.sv\"", "aggregated_output": "    .w_en     (wb_w_en),\n    .w_addr   (wb_w_addr),\n    .w_data   (wb_w_data)\n  );\n\n  // ── Operand collection ────────────────────────────────────────────────\n  // EX already suppresses writes from bubbles and bad control transfers.\n  // MEM can still discover a misaligned access.\n  assign mem_writer = ex_mem_w.ctrl.reg_write && !mem_misalign;\n  assign bypass_alu = ex_mem_w.ctrl.reg_write && !ex_mem_w.ctrl.mem_read;\n  assign bypass_load = mem_writer && ex_mem_w.ctrl.mem_read;\n  forward_unit u_fwd (\n    .id_ex_rs1   (waiting.rs1_addr),\n    .id_ex_rs2   (waiting.rs2_addr),\n    .ex_mem_rd   (ex_mem_w.rd),\n    .ex_mem_w_en (mem_writer),\n    .mem_wb_rd   (mem_wb_w.rd),\n    .mem_wb_w_en (mem_wb_w.ctrl.reg_write),\n    .fwd_rs1     (fwd_rs1_sel),\n    .fwd_rs2     (fwd_rs2_sel)\n  );\n\n  id_ex_t collected;\n  always_comb begin\n    collected = waiting;\n    case (fwd_rs1_sel)\n      2'd1:    collected.rs1_val = mem_wb_value;\n      2'd2:    collected.rs1_val = wb_w_data;\n      default: collected.rs1_val = waiting.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    collected.rs2_val = mem_wb_value;\n      2'd2:    collected.rs2_val = wb_w_data;\n      default: collected.rs2_val = waiting.rs2_val;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (!stall_ex) begin\n      id_ex_w <= collected;\n      adjacent_rs1_q <= id_ex_w.rd != 0 && id_ex_w.rd == waiting.rs1_addr;\n      adjacent_rs2_q <= id_ex_w.rd != 0 && id_ex_w.rd == waiting.rs2_addr;\n    end\n    if (reset || redirect || (!stall_ex && result_hazard))\n      id_ex_w.valid <= 1'b0;\n  end\n\n  // ── EX ────────────────────────────────────────────────────────────────\n  ex_stage u_ex (\n    .clock           (clock),\n    .