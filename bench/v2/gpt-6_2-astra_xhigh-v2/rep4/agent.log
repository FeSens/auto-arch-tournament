t logic               reference,\n  output logic [3:0]         ref_mask,\n  output logic [31:0]        ref_data,\n  input  logic [31:0]        div_result,\n  // ex_mem_t carries branch_taken / branch_target / pc_next / rs?_val\n  // for downstream RVFI use; mem_stage only consumes a subset, so the\n  // remaining fields look unused from this module'\"'s perspective.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  output logic [31:0]        wb_value,\n  // MEM/WB register output\n  output mem_wb_t  out\n);\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  logic [31:0] raw_word;\n  logic [31:0] load_data;\n\n  assign wb_value = ({32{in.use_mul_high}} & in.mul_high) |\n                    ({32{in.use_div}} & div_result) |\n                    ({32{in.ctrl.mem_to_reg && \"'!early_hit}} & load_data) |\n                    ({32{in.use_alu_result || (in.ctrl.mem_to_reg && early_hit)}} & in.alu_result);\n\n  always_comb begin\n    // Byte/halfword replication for stores.\n    case (in.ctrl.mem_width)\n      2'\"'d0:    wdata_rep = {4{in.write_data[7:0]}};\n      2'd1:    wdata_rep = {2{in.write_data[15:0]}};\n      default: wdata_rep = in.write_data;\n    endcase\n\n    // Byte-lane mask shifted to addr[1:0] * 1.\n    case (in.ctrl.mem_width)\n      2'd0:    byte_mask = (4'b0001 << in.mem_addr[1:0]);\n      2'd1:    byte_mask = (4'b0011 << in.mem_addr[1:0]);\n      default: byte_mask = 4'b1111;\n    endcase\n\n    // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n    aligned_addr = (in.ctrl.mem_read || in.ctrl.mem_write)\n                 ? {in.mem_addr[31:2], 2'b00}\n                 : 32'b0;\n  end\n\n  wire ram = in.ram_access;\n  wire load_op = in.ctrl.mem_read;\n  wire store_op = in.ctrl.mem_write;\n  wire demand = load_op && \"'!(early_hit || retry_hit);\n  wire postable = store_op && ram;\n  wire ordered = in.valid && in.serialize;\n  logic posted;\n  logic [31:0] posted_data;\n  logic [3:0] posted_mask;\n\n  // When empty, the registered MEM operation owns the bus. A RAM store\n  // can complete even on a wait cycle. A full slot drains and refills\n  // on one edge, retaining priority over every external read and MMIO.\n  wire enqueue = postable && !hold_wb && (posted || !dmem_ready);\n  // A single registered bus address also serves as the slot address.\n  // On drain, restore a waiting demand address before enabling its read.\n  always_ff @(posedge clock)\n    if (!posted || dmem_ready)\n      dmem_addr <= (enqueue || hold_wb) ? in.mem_addr : ex_addr;\n  assign dmem_wdata = posted ? posted_data : wdata_rep;\n  assign dmem_wen   = posted ? posted_mask : (store_op ? byte_mask : 4'\"'b0);\n  assign dmem_ren   = \"'!posted && demand;\n  assign hold_wb    = ((demand || (store_op && !ram)) && (posted || !dmem_ready)) ||\n                      (posted && (ordered || (postable && !dmem_ready)));\n  always_ff @(posedge clock) begin\n    if (reset) posted <= 1'\"'b0;\n    else if (enqueue) begin\n      posted <= 1'b1;\n      posted_data <= wdata_rep;\n      posted_mask <= byte_mask;\n    end else if (dmem_ready) posted <= 1'b0;\n  end\n\n  assign reference = ram && (load_op || store_op) && \"'!hold_wb;\n  assign ref_mask = store_op ? byte_mask : {4{demand}};\n  assign ref_data = store_op ? wdata_rep : dmem_rdata;\n  wire [31:0] corrected_word = retry_hit ? retry_word : dmem_rdata;\n  assign raw_word = early_hit ? early_word : corrected_word;\n  // Select bytes and the extension bit in parallel on the RAM return\n  // path. For an aligned access the first byte always comes from addr.\n  wire half_load = in.ctrl.mem_width == 1;\n  wire word_load = in.ctrl.mem_width == 2;\n  wire [3:0] first_lane = 4'\"'b0001 << in.mem_addr[1:0];\n  wire [3:0] byte_sign_lane = first_lane & {4{in.ctrl.mem_width == 0 && in.ctrl.mem_sext}};\n  wire [3:0] sign_bits = {corrected_word[31], corrected_word[23], corrected_word[15], corrected_word[7]};\n  wire byte_sign = |(byte_sign_lane & sign_bits);\n  wire half_sign = half_load && in.ctrl.mem_sext &&\n                   (in.mem_addr[1] ? corrected_word[31] : corrected_word[15]);\n  assign load_data[7:0] = ({8{first_lane[0]}} & corrected_word[7:0]) |\n                          ({8{first_lane[1]}} & corrected_word[15:8]) |\n                          ({8{first_lane[2]}} & corrected_word[23:16]) |\n                          ({8{first_lane[3]}} & corrected_word[31:24]);\n  assign load_data[15:8] = {8{byte_sign}} |\n                           ({8{word_load || (half_load && \"'!in.mem_addr[1])}} & corrected_word[15:8]) |\n                           ({8{half_load && in.mem_addr[1]}} & corrected_word[31:24]);\n  assign load_data[31:16] = {16{byte_sign || half_sign}} | ({16{word_load}} & corrected_word[31:16]);\n\n  // ── MEM/WB register ───────────────────────────────────────────────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '\"'0;\n    end else if (hold_wb) begin\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.wb_value   <= wb_value;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= raw_word;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= store_op ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= load_op ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= in.ctrl;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n\n// rtl/mem_stage.sv\n//\n// Memory access stage. Drives the dmem read/write ports combinationally\n// from the EX/MEM register, and sign/zero-extends the loaded data into\n// the MEM/WB register.\n//\n// Byte-lane discipline:\n//   - Write data is replicated across all four byte lanes; the\n//     byte-mask (mem_wmask) selects the actual destination bytes.\n//   - Load: shift the raw word right by \"'`addr[1:0]*8`, then sign- or\n//     zero-extend the low 8/16 bits per the LB/LBU/LH/LHU encoding.\n//   - For RVFI ALIGNED_MEM, mem_addr is reported word-aligned and the\n//     byte position is captured in mem_rmask / mem_wmask.\n//\n// Latency:        1 cycle (MEM/WB register clocked here).\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata via the loaded-data path.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // A blocked request retains the preceding WB writer for collection.\n  // Clearing valid lets it retire exactly once.\n  output logic               hold_wb,\n  input  logic [31:0]        ex_addr,\n  input  logic               dmem_ready,\n  input  logic               early_hit, retry_hit,\n  input  logic [31:0]        early_word, retry_word,\n  output logic               reference,\n  output logic [3:0]         ref_mask,\n  output logic [31:0]        ref_data,\n  input  logic [31:0]        div_result,\n  // ex_mem_t carries branch_taken / branch_target / pc_next / rs?_val\n  // for downstream RVFI use; mem_stage only consumes a subset, so the\n  // remaining fields look unused from this module'\"'s perspective.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  output logic [31:0]        wb_value,\n  // MEM/WB register output\n  output mem_wb_t  out\n);\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  logic [31:0] raw_word;\n  logic [31:0] load_data;\n  wire bus_load = in.ctrl.mem_to_reg && \"'!early_hit && !retry_hit;\n  wire retry_load = in.ctrl.mem_to_reg && !early_hit && retry_hit;\n  wire [3:0] bus_signs = {dmem_rdata[31], dmem_rdata[23], dmem_rdata[15], dmem_rdata[7]};\n  wire [3:0] retry_signs = {retry_word[31], retry_word[23], retry_word[15], retry_word[7]};\n  wire sign_fill = (|(bus_signs & in.load_sign_lanes & {4{bus_load}})) ||\n                   (|(retry_signs & in.load_sign_lanes & {4{retry_load}}));\n\n  assign wb_value = ({32{in.use_mul_high}} & in.mul_high) |\n                    ({32{in.use_div}} & div_result) |\n                    ({32{in.ctrl.mem_to_reg && !early_hit}} & load_data) |\n                    {{16{sign_fill}}, {8{sign_fill && in.ctrl.mem_width == 0}}, 8'\"'b0} |\n                    ({32{in.use_alu_result || (in.ctrl.mem_to_reg && early_hit)}} & in.alu_result);\n\n  always_comb begin\n    // Byte/halfword replication for stores.\n    case (in.ctrl.mem_width)\n      2'd0:    wdata_rep = {4{in.write_data[7:0]}};\n      2'd1:    wdata_rep = {2{in.write_data[15:0]}};\n      default: wdata_rep = in.write_data;\n    endcase\n\n    // Byte-lane mask shifted to addr[1:0] * 1.\n    case (in.ctrl.mem_width)\n      2'd0:    byte_mask = (4'b0001 << in.mem_addr[1:0]);\n      2'd1:    byte_mask = (4'b0011 << in.mem_addr[1:0]);\n      default: byte_mask = 4'b1111;\n    endcase\n\n    // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n    aligned_addr = (in.ctrl.mem_read || in.ctrl.mem_write)\n                 ? {in.mem_addr[31:2], 2'b00}\n                 : 32'b0;\n  end\n\n  wire ram = in.ram_access;\n  wire load_op = in.ctrl.mem_read;\n  wire store_op = in.ctrl.mem_write;\n  wire demand = load_op && \"'!(early_hit || retry_hit);\n  wire postable = store_op && ram;\n  wire ordered = in.valid && in.serialize;\n  logic posted;\n  logic [31:0] posted_data;\n  logic [3:0] posted_mask;\n\n  // When empty, the registered MEM operation owns the bus. A RAM store\n  // can complete even on a wait cycle. A full slot drains and refills\n  // on one edge, retaining priority over every external read and MMIO.\n  wire enqueue = postable && !hold_wb && (posted || !dmem_ready);\n  // A single registered bus address also serves as the slot address.\n  // On drain, restore a waiting demand address before enabling its read.\n  always_ff @(posedge clock)\n    if (!posted || dmem_ready)\n      dmem_addr <= (enqueue || hold_wb) ? in.mem_addr : ex_addr;\n  assign dmem_wdata = posted ? posted_data : wdata_rep;\n  assign dmem_wen   = posted ? posted_mask : (store_op ? byte_mask : 4'\"'b0);\n  assign dmem_ren   = \"'!posted && demand;\n  assign hold_wb    = ((demand || (store_op && !ram)) && (posted || !dmem_ready)) ||\n                      (posted && (ordered || (postable && !dmem_ready)));\n  always_ff @(posedge clock) begin\n    if (reset) posted <= 1'\"'b0;\n    else if (enqueue) begin\n      posted <= 1'b1;\n      posted_data <= wdata_rep;\n      posted_mask <= byte_mask;\n    end else if (dmem_ready) posted <= 1'b0;\n  end\n\n  assign reference = ram && (load_op || store_op) && \"'!hold_wb;\n  assign ref_mask = store_op ? byte_mask : {4{demand}};\n  assign ref_data = store_op ? wdata_rep : dmem_rdata;\n  wire [31:0] corrected_word = retry_hit ? retry_word : dmem_rdata;\n  assign raw_word = early_hit ? early_word : corrected_word;\n  // Select bytes and the extension bit in parallel on the RAM return\n  // path. For an aligned access the first byte always comes from addr.\n  wire half_load = in.ctrl.mem_width == 1;\n  wire word_load = in.ctrl.mem_width == 2;\n  wire [3:0] first_lane = 4'\"'b0001 << in.mem_addr[1:0];\n  assign load_data[7:0] = ({8{first_lane[0]}} & corrected_word[7:0]) |\n                          ({8{first_lane[1]}} & corrected_word[15:8]) |\n                          ({8{first_lane[2]}} & corrected_word[23:16]) |\n                          ({8{first_lane[3]}} & corrected_word[31:24]);\n  assign load_data[15:8] = ({8{word_load || (half_load && \"'!in.mem_addr[1])}} & corrected_word[15:8]) |\n                           ({8{half_load && in.mem_addr[1]}} & corrected_word[31:24]);\n  assign load_data[31:16] = {16{word_load}} & corrected_word[31:16];\n\n  // ── MEM/WB register ───────────────────────────────────────────────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '\"'0;\n    end else if (hold_wb) begin\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.wb_value   <= wb_value;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= raw_word;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= store_op ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= load_op ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= in.ctrl;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n\nmodule sign_equivalence(input ex_mem_t in, input logic [31:0] dmem_rdata,retry_word,div_result, input logic early_hit,retry_hit, output logic mismatch);\nex_mem_t checked; logic [31:0] a,b;\nalways_comb begin\nchecked = in;\nfor (int i = 0; i < 4; i++) begin\n        checked.load_sign_lanes[i] = in.ctrl.mem_sext &&\n            ((in.ctrl.mem_width == 0 && in.mem_addr[1:0] == 2'(i)) ||\n             (in.ctrl.mem_width == 1 && i % 2 == 1 && in.mem_addr[1] == 1'(i / 2)));\n      end\nend\nprevious_mem u_old (.in(checked), .dmem_rdata, .early_hit, .retry_hit, .retry_word, .div_result, .wb_value(a));\nmem_stage u_new (.in(checked), .dmem_rdata, .early_hit, .retry_hit, .retry_word, .div_result, .wb_value(b));\nassign mismatch = a \"'!= b;\nendmodule\nHDL_EOF\nhierarchy -top sign_equivalence\nproc\nflatten\nopt\nsat -verify -prove mismatch 0\nYS_EOF'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.completed", "item": {"id": "item_135", "type": "command_execution", "command": "/bin/bash -c \"set -o pipefail\nyosys -Q -T -s /dev/stdin <<'YS_EOF' | tail -n 19\nread_verilog -sv <<HDL_EOF\n// rtl/core_pkg.sv\n//\n// Core-wide constants and pipeline-bundle types.\n//\n// Compilation-unit scope (no \"'`package … endpackage` wrapper) because\n// Yosys'\"'s Verilog frontend rejects \"'`import pkg::*;` even though it\n// accepts `pkg::sym` refs and package definitions. A file-scope\n// definition with an `'\"\\\\\"'`ifndef` guard is the lowest common denominator\n// across Verilator, Yosys, sby, and nextpnr-himbaechel.\n//\n// Order matters: this file MUST be the first source passed to any tool\n// (Verilator/cocotb runner / build.sh / formal staging). Subsequent\n// includes hit the guard and become no-ops.\n//\n// Latency:        n/a (declarations only).\n// RVFI fields:    none (defines types; no logic).\n`ifndef CORE_PKG_DEFINED\n`define CORE_PKG_DEFINED\n\n  // ── ALU operations ──────────────────────────────────────────────────────\n  localparam logic [4:0] ALU_ADD    = 5'\"'d0;\n  localparam logic [4:0] ALU_SUB    = 5'd1;\n  localparam logic [4:0] ALU_AND    = 5'd2;\n  localparam logic [4:0] ALU_OR     = 5'd3;\n  localparam logic [4:0] ALU_XOR    = 5'd4;\n  localparam logic [4:0] ALU_SLT    = 5'd5;\n  localparam logic [4:0] ALU_SLTU   = 5'd6;\n  localparam logic [4:0] ALU_SLL    = 5'd7;\n  localparam logic [4:0] ALU_SRL    = 5'd8;\n  localparam logic [4:0] ALU_SRA    = 5'd9;\n  localparam logic [4:0] ALU_LUI    = 5'd10;\n  localparam logic [4:0] ALU_MUL    = 5'd11;\n  localparam logic [4:0] ALU_MULH   = 5'd12;\n  localparam logic [4:0] ALU_MULHU  = 5'd13;\n  localparam logic [4:0] ALU_MULHSU = 5'd14;\n  localparam logic [4:0] ALU_DIV    = 5'd15;\n  localparam logic [4:0] ALU_DIVU   = 5'd16;\n  localparam logic [4:0] ALU_REM    = 5'd17;\n  localparam logic [4:0] ALU_REMU   = 5'd18;\n\n  // ── Branch operations (encoded = funct3 of BRANCH opcode) ───────────────\n  // Phase 1 only references BR_BEQ (decoder default). The rest are\n  // referenced by the EX-stage comparator in phase 2; we keep them here\n  // for documentation and silence UNUSEDPARAM until then.\n  localparam logic [2:0] BR_BEQ  = 3'd0;\n  /* verilator lint_off UNUSEDPARAM */\n  localparam logic [2:0] BR_BNE  = 3'd1;\n  localparam logic [2:0] BR_BLT  = 3'd4;\n  localparam logic [2:0] BR_BGE  = 3'd5;\n  localparam logic [2:0] BR_BLTU = 3'd6;\n  localparam logic [2:0] BR_BGEU = 3'd7;\n  /* verilator lint_on UNUSEDPARAM */\n\n  function automatic logic [31:0] format_load(\n      input logic [31:0] word_data, input logic [1:0] offset,\n      input logic [1:0] width, input logic sext);\n    logic [15:0] half_data;\n    logic [7:0] byte_data;\n    begin\n      half_data = offset[1] ? word_data[31:16] : word_data[15:0];\n      byte_data = offset[0] ? half_data[15:8] : half_data[7:0];\n      case (width)\n        2'd0: format_load = {{24{sext && byte_data[7]}}, byte_data};\n        2'd1: format_load = {{16{sext && half_data[15]}}, half_data};\n        default: format_load = word_data;\n      endcase\n    end\n  endfunction\n\n  // ── Pipeline-bundle typedefs ────────────────────────────────────────────\n  typedef struct packed {\n    logic [4:0] alu_op;\n    logic       alu_src;     // 0 = rs2 value, 1 = immediate\n    logic [2:0] branch_op;\n    logic       is_branch;\n    logic       is_jump;\n    logic       is_jalr;\n    logic       is_lui;\n    logic       is_auipc;\n    logic       mem_read;\n    logic       mem_write;\n    logic [1:0] mem_width;   // 0 = byte, 1 = half, 2 = word\n    logic       mem_sext;    // sign-extend load result\n    logic       reg_write;\n    logic       mem_to_reg;  // 1 = write loaded data, 0 = write ALU result\n    logic       is_illegal;  // default-true in decoder; cleared inside\n                              // validated opcode/funct arms only.\n  } ctrl_t;\n\n  typedef struct packed {\n    logic        hit;\n    