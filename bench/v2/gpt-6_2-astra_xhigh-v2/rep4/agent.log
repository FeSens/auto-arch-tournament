{"type": "item.completed", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/bash -c \"git diff --check && git diff --stat && sed -n '1,110p' cores/bench/rtl/if_stage.sv\"", "aggregated_output": " cores/bench/rtl/core_pkg.sv       |   2 -\n cores/bench/rtl/ex_stage.sv       |   2 -\n cores/bench/rtl/if_stage.sv       | 199 +++++++++++++-------------------------\n cores/bench/test/test_pipeline.py | 116 +++++++++++++---------\n 4 files changed, 134 insertions(+), 185 deletions(-)\n// Fetch the instruction and its prediction in parallel with installing its PC.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              redirect,\n  input  logic [31:0]       redirect_target,\n  input  btb_update_t       update,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t            out\n);\n  logic [31:0] pc, next_pc;\n  prediction_t prediction;\n\n  always_comb begin\n    if (reset)                 next_pc = 32'b0;\n    else if (redirect)         next_pc = redirect_target;\n    else if (stall)            next_pc = pc;\n    else if (prediction.taken) next_pc = {12'b0, prediction.target, 2'b00};\n    else                       next_pc = pc + 32'd4;\n  end\n\n  // One synchronous write and one synchronous read. Even on a hold the\n  // payload is reread, so a colliding write can supply the following cycle.\n  logic [58:0] entries [0:4095];\n  logic [58:0] entry_q;\n  wire install = update.write || update.successor;\n  always_ff @(posedge clock) begin\n    if (install)\n      entries[update.pc[13:2]] <= {update.pc[19:14], update.write, update.counter,\n                                   update.target, update.instr};\n    entry_q <= entries[next_pc[13:2]];\n    pc <= next_pc;\n  end\n\n  // Each group has sixteen independently initialized slots. Its first\n  // write after reset or FENCE.I starts a fresh mask over the old RAM.\n  logic [255:0] group_valid;\n  logic [15:0] masks [0:255];\n  wire [7:0] write_group = update.pc[13:6];\n  wire [7:0] read_group = next_pc[13:6];\n  wire [15:0] write_mask = (group_valid[write_group] ? masks[write_group] : 16'b0)\n                           | (16'b1 << update.pc[5:2]);\n  wire same_group = install && write_group == read_group;\n  wire collision = install && update.pc[13:2] == next_pc[13:2];\n  logic [15:0] mask_q;\n  logic group_valid_q, read_valid_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || update.invalidate)\n      group_valid <= '0;\n    else if (install)\n      group_valid[write_group] <= 1'b1;\n    if (install)\n      masks[write_group] <= write_mask;\n\n    // Forward metadata within a group. At the exact written index the\n    // dual-port payload RAM's read value is unspecified, so drop that hit.\n    mask_q <= same_group ? write_mask : masks[read_group];\n    // In a previously invalid group only the colliding slot can have\n    // become valid on this edge. Its payload must wait for a reread.\n    group_valid_q <= group_valid[read_group];\n    read_valid_q <= !reset && !update.invalidate && !collision;\n  end\n\n  logic [5:0] tag;\n  logic control, hit, external_control;\n  logic [1:0] counter;\n  logic [19:2] target;\n  logic [31:0] word;\n  assign {tag, control, counter, target, word} = entry_q;\n  assign hit = read_valid_q && group_valid_q && mask_q[pc[5:2]] && pc[31:20] == 0 &&\n               pc[1:0] == 0 && pc[19:14] == tag;\n  assign prediction.hit = hit && control;\n  assign prediction.counter = counter;\n  assign prediction.target = target;\n  // EX trains control entries only for legal transfers. A ready bus word\n  // takes precedence and must qualify for control prediction in its own right.\n  assign external_control = imem_data[6:0] == 7'h6f ||\n                            (imem_data[6:0] == 7'h67 && imem_data[14:12] == 3'b000) ||\n                            (imem_data[6:0] == 7'h63 && imem_data[14:13] != 2'b01);\n  assign prediction.taken = hit && control && counter[1] &&\n                            (!imem_ready || external_control);\n\n  assign imem_addr = pc;\n  assign out.pc = pc;\n  assign out.instr = imem_ready ? imem_data : hit ? word : 32'h0000_0013;\n  assign out.prediction = prediction;\n  assign out.valid = imem_ready || hit;\nendmodule\n", "exit_code": 0, "status": "completed"}}
