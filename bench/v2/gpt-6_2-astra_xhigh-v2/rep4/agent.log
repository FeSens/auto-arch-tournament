nd\nendmodule\nasync def independent_divides(dut):\n    # The REMU issue edge also captures the signed DIV result in MEM/WB.\n    program = [ADDI(1, 0, -103), ADDI(2, 0, 7), DIV(3, 1, 2),\n               REMU(4, 2, 1), ADD(5, 4, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    _check_pc_trace(rets, list(range(0, 4 * len(program), 4)))\n    assert [r[\"insn\"] for r in rets] == program\n    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n    assert rets[4][\"cycle\"] - rets[3][\"cycle\"] == 2\n    _c\n…[2870 of 5942 chars elided by tools/bench/transcript.py; sha256:ce745f7c25919642]…\nxfffffff0, 5, quotient)\n    assert (rets[5][\"rs1_rdata\"], rets[5][\"rs2_rdata\"], rets[5][\"rd_wdata\"]) == (\n        0xffffffff, quotient, 0xffffffff % quotient)\n    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n    assert rets[5][\"cycle\"] - rets[4][\"cycle\"] == 9  # load-use bubble, then seven divide waits\n\n\n@cocotb.test()\nasync def redirect_over_two_stores(dut):\n    program = [ADDI(2, 0, -128), LB(1, 0, 0x43), BEQ(1, 2, 12),\n               SW(1, 0, 0x70), SW(2, 0, 0x74), SW(1, 0, 0x78), EBREAK()]\n    visits, writes = [], []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        return word\n5:{\"id\": \"hyp-20261121-001-r2s0\", \"title\": \"Halve the divider's serial decisions with radix-4 restoring steps\", \"category\": \"micro_opt\", \"motivation\": \"Gowin traced the champion's 197-cell worst path from quoti\n8:{\"id\": \"hyp-20261121-001-r3s0\", \"title\": \"Shorten the champion's divider feedback path with radix-4 digits\", \"category\": \"micro_opt\", \"motivation\": \"On the current BTB-equipped core, Gowin traced a 28.668 ns \n", "exit_code": 0, "status": "completed"}}
