{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"rg -n -A2 '\"'^2.3 Max Frequency Summary'\"' \\\"\"'$TMPDIR/r8micro/early-p1/impl/pnr/core_bench.tr\" && rg '\"'200.000\\\\(MHz\\\\)' \\\"\"'$TMPDIR/r8micro/early-p1/impl/pnr/core_bench.tr\" | head -2 && cat cores/bench/rtl/reg_file.sv'","aggregated_output":"69:2.3 Max Frequency Summary\n70-  NO.   Clock Name    Constraint    Actual Fmax   Level   Entity  \n71- ===== ============ ============== ============= ======= ======== \n  1     clock        200.000(MHz)   57.049(MHz)   22      TOP     \n// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// The reset clears all 32 registers. Distributed-LUT or flop inference is\n// fine here; explicit BRAM attribution lives on the larger imem/dmem\n// declarations in soc.sv (phase 5).\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  logic [31:0] regs [0:31];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n    end else if (w_en && w_addr != 5'b0) begin\n      regs[w_addr] <= w_data;\n    end\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = regs[rs1_addr];\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = regs[rs2_addr];\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os\nw=Path(os.environ['TMPDIR'])/'r8micro'\nfor n in ('lutrf','bankrf'):\n p = copytree('cores/bench/rtl', w/n)/'reg_file.sv'\n s=p.read_text().split('  logic [31:0] regs [0:31];')[0]\n if n=='lutrf':\n  s+='''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] regs [0:31];\n  logic [31:0] valid;\n  wire write_reg = w_en && w_addr \"'!= 0;\n  always_ff @(posedge clock) begin\n    if (reset) valid <= 0;\n    else if (write_reg) valid[w_addr] <= 1;\n    if (write_reg) regs[w_addr] <= w_data;\n  end\n  assign rs1_data = write_reg && rs1_addr == w_addr ? w_data : valid[rs1_addr] ? regs[rs1_addr] : 0;\n  assign rs2_data = write_reg && rs2_addr == w_addr ? w_data : valid[rs2_addr] ? regs[rs2_addr] : 0;\nendmodule\n'\"'''\n else:\n  s+='''  wire [31:0] lo1,hi1,lo2,hi2;\n  logic [31:0] valid;\n  wire write_reg = w_en && w_addr \"'!= 0;\n  always_ff @(posedge clock) begin\n    if (reset) valid <= 0;\n    else if (write_reg) valid[w_addr] <= 1;\n  end\n  wire [31:0] from1 [2], from2 [2];\n  for(genvar i=0;i<2;i++) begin : banks\n    (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs [0:15];\n    always_ff @(posedge clock)\n      if (w_en && w_addr[4]==1'\"'(i)) regs[w_addr[3:0]] <= w_data;\n    assign from1[i] = regs[rs1_addr[3:0]];\n    assign from2[i] = regs[rs2_addr[3:0]];\n  end\n  assign rs1_data = write_reg && rs1_addr == w_addr ? w_data : valid[rs1_addr] ? from1[rs1_addr[4]] : 0;\n  assign rs2_data = write_reg && rs2_addr == w_addr ? w_data : valid[rs2_addr] ? from2[rs2_addr[4]] : 0;\nendmodule\n'''.replace('  wire [31:0] lo1,hi1,lo2,hi2;\\\\n','')\n p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
