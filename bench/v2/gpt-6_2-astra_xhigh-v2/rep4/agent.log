{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os\nw=Path(os.environ['TMPDIR'])/'r8micro'\ndef radix4tail(s):\n start=s.index('  logic [31:0] remainder_tail, magnitude;')\n end=s.index('  assign magnitude ',start)\n return s[:start]+'''  logic [33:0] multiple3_q;\n  always_ff @(posedge clock) begin\n    if (round_q == 1)\n      multiple3_q <= {1'b0,divisor_q,1'b0} + {2'b0,divisor_q};\n  end\n  wire [31:0] x = {head_remainder_q,tail_q};\n  wire [32:0] t1 = {1'b0,x} - {1'b0,divisor_q};\n  wire [33:0] t2 = {2'b0,x} - {1'b0,divisor_q,1'b0};\n  wire [34:0] t3 = {3'b0,x} - {1'b0,multiple3_q};\n  wire [1:0] tail_digits = { \"'!t2[33], !t3[34] || (t2[33] && !t1[32]) };\n  logic [31:0] remainder_tail, magnitude;\n  always_comb begin\n    case(tail_digits)\n      2'\"'d1: remainder_tail = t1[31:0];\n      2'd2: remainder_tail = t2[31:0];\n      2'd3: remainder_tail = t3[31:0];\n      default: remainder_tail = x;\n    endcase\n  end\n'''+s[end:]\ndef lanes(s,sz):\n n=len(sz)\n s=s.replace('logic [2:0]  lane_q;',f'logic [{n-1}:0]  lane_q;')\n start=s.index('      lane_q[0]')\n end=s.index('      tail_q',start)\n acc=[]\n for i,(cut,dig) in enumerate(sz):\n  lo,hi=((f'divisor_abs[31:{sz[i-1][0]}] \"'!= 0'\"' if i else ''),(f'divisor_abs[31:{cut}] == 0' if i\"'!=len(sz)-1 else '\"''))\n  acc.append(f'      lane_q[{i}] <= '+(' && '.join(x for x in (lo,hi) if x))+';\\\\n')\n s=s[:start]+''.join(acc)+s[end:]\n s=s.replace('[0:2]',f'[0:{n-1}]').replace('lane < 3','lane < '+str(n)).replace('5 - 2 * lane',''.join(f'lane == {i} ? {dig} : ' for i,(cut,dig) in enumerate(sz[:-1]))+str(sz[-1][1])).replace('lane == 0 ? 12 : lane == 1 ? 24 : 30',''.join(f'lane == {i} ? {cut} : ' for i,(cut,dig) in enumerate(sz[:-1]))+'30').replace('lane \"'!= 2'\"',f'lane \"'!= {n-1}'\"')\n for a in ('quotient','remainder'):\n  st=s.index('<= selected_'+a+'[0]'); en=s.index(';',st)\n  s=s[:st]+'<= '+' | '.join(f'selected_{a}[{i}]' for i in range(n))+s[en:]\n return s\nfor n,sz,tail in (('smalllanes',[(6,5),(12,4),(18,3),(24,2),(30,1)],0),('smallrad',[(6,5),(12,4),(18,3),(24,2),(30,1)],1),('rad4tail',[],1)):\n p=copytree('cores/bench/rtl',w/n)/'alu.sv'\n s=p.read_text()\n if sz:s=lanes(s,sz)\n if tail:s=radix4tail(s)\n p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
