{"type": "item.started", "item": {"id": "item_77", "type": "command_execution", "command": "/bin/bash -c 'cp -R cores/bench/test \"$TMPDIR/predictor/qualified64/test\"\ncat > \"$TMPDIR/predictor/qualified64/test/test_btb_scratch.py\" <<'\"'PY'\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADDI, JAL, JALR, LW, SW, EBREAK, NOP, _b\n\nasync def step(dut):\n    await Timer(3, 'ns')\n    dut.clock.value = 1\n    await Timer(3, 'ns')\n    dut.clock.value = 0\n    await Timer(3, 'ns')\n\nasync def reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = NOP()\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    dut.io_dmemRData.value = 0\n    for _ in range(3):\n        await step(dut)\n    dut.reset.value = 0\n\n@cocotb.test()\nasync def held_hit_alias_and_fence(dut):\n    await reset(dut)\n    old = JAL(1,256)\n    new = ADDI(9,0,99)\n    code = {0:old,4:EBREAK(),256:ADDI(2,2,1),260:ADDI(3,0,2),264:LW(4,0,0),\n            268:_b(-268,3,2,1,0x63),272:0x0000100f,276:JAL(0,-276),280:SW(3,0,4)}\n    pcs = []\n    intervals = []\n    alias_waits = 3\n    fence_waits = 3\n    dmem_waits = 4\n    was_replay = False\n    for _ in range(120):\n        pc = int(dut.io_imemAddr.value)\n        ir = True\n        if pc==256 and alias_waits:\n            ir = False\n            alias_waits -= 1\n        if pc == 0 and pcs.count(0) == 1 and code[0] == old:\n            ir = False\n            was_replay = True\n        if pc == 0 and code[0] == new and fence_waits:\n            ir = False\n            fence_waits -= 1\n        dut.io_imemReady.value = int(ir)\n        dut.io_imemData.value = code.get(pc,NOP()) if ir else SW(8,0,12)\n        dr = True\n        if int(dut.io_dmemREn.value) and dmem_waits:\n            dr = False\n            dmem_waits -= 1\n        dut.io_dmemReady.value = int(dr)\n        await step(dut)\n        next_fetch = int(dut.io_imemAddr.value)\n        if pc == 256 and not ir:\n            assert next_fetch == 256\n        if pc == 0 and not ir and code[0] == old:\n            assert next_fetch == 256\n        if pc == 0 and not ir and code[0] == new:\n            assert next_fetch == 0\n        assert not int(dut.io_dmemWEn.value)\n        if int(dut.io_rvfi_valid_0.value):\n            rpc = int(dut.io_rvfi_pc_rdata_0.value)\n            assert not int(dut.io_rvfi_trap_0.value)\n            assert int(dut.io_rvfi_order_0.value)==len(pcs)\n            pcs.append(rpc)\n            intervals.append(int(dut.io_rvfi_pc_wdata_0.value))\n            if rpc == 0 and pcs.count(0) == 2:\n                code[0] = new\n            if rpc == 0 and pcs.count(0) == 3:\n                assert int(dut.io_rvfi_insn_0.value)==new\n                assert int(dut.io_rvfi_rd_wdata_0.value)==99\n            if int(dut.io_rvfi_insn_0.value)==EBREAK(): break\n    assert was_replay and alias_waits == fence_waits == dmem_waits == 0\n    assert pcs == [0,256,260,264,268,0,256,260,264,268,272,276,0,4]\n    assert intervals[:-1] == pcs[1:]\n\n@cocotb.test()\nasync def changed_indirect_target(dut):\n    await reset(dut)\n    code = {0:ADDI(6,0,32),4:JALR(1,6,0),8:SW(1,0,4),32:SW(1,0,8),36:ADDI(6,0,48),40:JAL(0,-36),48:EBREAK()}\n    pcs, writes, nxt = [], [], []\n    for _ in range(80):\n        pc = int(dut.io_imemAddr.value)\n        ir = not (pc==4 and 4 in pcs)\n        dut.io_imemReady.value = int(ir)\n        dut.io_imemData.value = code.get(pc,NOP()) if ir else 0xffffffff\n        await step(dut)\n        if int(dut.io_dmemWEn.value):\n            writes.append((int(dut.io_dmemAddr.value),int(dut.io_dmemWData.value)))\n        if int(dut.io_rvfi_valid_0.value):\n            rpc = int(dut.io_rvfi_pc_rdata_0.value)\n            pcs.append(rpc)\n            nxt.append(int(dut.io_rvfi_pc_wdata_0.value))\n            if rpc==4: assert int(dut.io_rvfi_rd_wdata_0.value)==8\n            if rpc==48: break\n    assert pcs == [0,4,32,36,40,4,48]\n    assert nxt[:-1] == pcs[1:]\n    assert writes == [(8,8)]\n\ndef test_runner():\n    from pathlib import Path\n    sources=[p.name for p in (Path(__file__).resolve().parents[1]/'rtl').glob('*.sv') if p.name\"'!='\"'core_pkg.sv']\n    run_cocotb('core',['core_pkg.sv',*sorted(sources)],'test_btb_scratch')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
