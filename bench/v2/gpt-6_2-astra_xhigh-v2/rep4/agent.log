{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/3df75752/782d65b5/r14-study/carry.py <<'PY'\nimport sys\nfrom variants import *\nfrom tools.eval.gowin import build_all\ndef carry(name,w=16,style='a',base=None):\n    d=save(name,{})\n    if base: shutil.copytree(root/base/'rtl',d,dirs_exist_ok=True)\n    ex=(d/'ex_stage.sv').read_text();a=(d/'alu.sv').read_text()\n    j=a.index('  assign out =')\n    x=a[j:a.index(';',j)].removeprefix('  assign out = ').replace('(a + b)','sum0').replace('(a - b)','diff0')\n    hi=32-w\n    a=a[:j]+f'''\n  wire [{w}:0] low_sum = {{1'b0,a[{w-1}:0]}} + {{1'b0,b[{w-1}:0]}};\n  wire [{w}:0] low_diff = {{1'b0,a[{w-1}:0]}} - {{1'b0,b[{w-1}:0]}};\n  wire [{hi-1}:0] hi_sum = a[31:{w}] + b[31:{w}];\n  wire [{hi-1}:0] hi_diff = a[31:{w}] - b[31:{w}];\n  wire [31:0] sum0 = {{hi_sum,low_sum[{w-1}:0]}};\n  wire [31:0] diff0 = {{hi_diff,low_diff[{w-1}:0]}};\n  assign upper_correct = (result_sel[0] && low_sum[{w}]) || (result_sel[1] && low_diff[{w}]);\n  assign partial = '''+x+f''';\n  assign upper_alt = ((hi_sum + {hi}'d1) & {{{hi}{{result_sel[0]}}}}) | ((hi_diff - {hi}'d1) & {{{hi}{{result_sel[1]}}}});\n  assign out = {{(upper_correct ? upper_alt : partial[31:{w}]),partial[{w-1}:0]}};\n'''+a[a.index(';',j)+1:]\n    a=a.replace('  output logic [31:0] out\\\\n',f'  output logic [31:0] partial,\\\\n  output logic [{hi-1}:0] upper_alt,\\\\n  output logic upper_correct,\\\\n  output logic [31:0] out\\\\n')\n    ex=ex.replace('  logic [31:0] alu_result;', f\\\"\\\"\\\"  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] full_alu;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] alu_result;\n  logic [{hi-1}:0] upper_alt, upper_alt_q;\n  logic upper_correct, upper_correct_q;\\\"\\\"\\\")\n    ex=ex.replace('    .out (alu_result)','    .upper_correct, .upper_alt, .partial(alu_result), .out(full_alu)')\n    ex=ex.replace('      reg_q.pc            <= in.pc;', '      upper_correct_q <= upper_correct;\\\\n      upper_alt_q <= upper_alt;\\\\n      reg_q.pc            <= in.pc;')\n    ex=ex.replace('  assign out = reg_q;',f\\\"\\\"\\\"  always_comb begin\n    out = reg_q;\n    if (upper_correct_q) out.alu_result[31:{w}] = upper_alt_q;\n  end\\\"\\\"\\\")\n    (d/'ex_stage.sv').write_text(ex);(d/'alu.sv').write_text(a)\n    return d\nif __name__=='__main__':\n    name,w,base,*opts=sys.argv[1:]\n    d=carry(name,int(w),base=None if base=='orig' else base)\n    print(build_all(wt,d,'fpga/core_bench_si.sv',root/name,options=list(map(int,opts)) or [1]),flush=True)\nPY\nPYTHONPATH=. python3 /srv/hwebench/tmp/3df75752/782d65b5/r14-study/carry.py carry16 16 orig 1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
