{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/rfbank.py' <<'PY'\nfrom pathlib import Path\nimport sys,shutil\nold,new=map(Path,sys.argv[1:3]); b=int(sys.argv[3])\nshutil.copytree(old,new)\nfile=new/'reg_file.sv'\ntxt=file.read_text()\ni=txt.index('  logic [31:0] regs')\nn=32//(1<<b)\ntxt=txt[:i]+'''  wire [31:0] bank_rs1 [0:N-1], bank_rs2 [0:N-1];\n  logic [31:0] valid_q;\n  always_ff @(posedge clock) begin\n    if (reset) valid_q <= '0;\n    else if (w_en && w_addr \"'!= 0) valid_q[w_addr] <= 1'\"'b1;\n  end\n  for (genvar bank=0; bank<N; bank++) begin : g_bank\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] words [0:DEPTH-1];\n    always_ff @(posedge clock) begin\n      if (w_en && w_addr[4:B] == bank) words[w_addr[B-1:0]] <= w_data;\n    end\n    assign bank_rs1[bank] = words[rs1_addr[B-1:0]];\n    assign bank_rs2[bank] = words[rs2_addr[B-1:0]];\n  end\n  always_comb begin\n    if (rs1_addr \"'!= 0 && w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = valid_q[rs1_addr] ? bank_rs1[rs1_addr[4:B]] : 0;\n    if (rs2_addr != 0 && w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = valid_q[rs2_addr] ? bank_rs2[rs2_addr[4:B]] : 0;\n  end\nendmodule\n'\"'''.replace('N-1',str(n-1)).replace('bank<N','bank<'+str(n)).replace('DEPTH-1',str((1<<b)-1)).replace('[4:B]',f'[4:{b}]').replace('[B-1:0]',f'[{b-1}:0]')\nfile.write_text(txt)\nPY\npython '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/rfbank.py' cores/bench/rtl '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/rf16' 4\npython '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/rfbank.py' cores/bench/rtl '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/rf8' 3\npython '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/rfbank.py' '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/fwd' '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/rf16_fwd' 4\ncat > '/srv/hweb