{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"sed -n '216,295p;575,603p;760,785p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def consecutive_divides_and_redirect(dut):\n    # DIV gets x1 from MEM/WB and x2 from EX/MEM. Both bypasses drain\n    # before its result transfers. REM immediately consumes the quotient.\n    program = [\n        LW(1, 0, 0), ADDI(2, 0, -7), DIV(3, 1, 2), REM(4, 1, 3),\n        ADD(5, 4, 3), BEQ(5, 5, 8), DIVU(5, 0, 0), MUL(6, 5, 2), EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, {0: 100}, read_waits={0: 4})\n    indices = [0, 1, 2, 3, 4, 5, 7, 8]\n    assert [r[\"pc\"] for r in rets] == [i * 4 for i in indices]\n    assert [r[\"insn\"] for r in rets] == [program[i] for i in indices]\n    assert [r[\"order\"] for r in rets] == list(range(len(indices)))\n    assert not any(r[\"trap\"] for r in rets)\n    # DIV/REM each add seven cycles. ADD and MUL take their usual single\n    # cycle, and the branch flush costs one bubble at its target.\n    assert [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])] == [1, 8, 8, 1, 1, 2, 1]\n    for r, rs1, a, rs2, b, rd, value in (\n        (rets[2], 1, 100, 2, -7, 3, -14),\n        (rets[3], 1, 100, 3, -14, 4, 2),\n        (rets[4], 4, 2, 3, -14, 5, -12),\n        (rets[6], 5, -12, 2, -7, 6, 84),\n    ):\n        assert (r[\"rs1_addr\"], r[\"rs1_rd\n…[2167 of 5239 chars elided by tools/bench/transcript.py; sha256:b17f6450cb68f5ee]…\n) - 1]\n        return word\n\n    rets, dmem = await _run(dut, program, fetch=fetch)\n    _check_pc_trace(rets, [0, 4, 16, 4, 8, 4, 8, 4, 8, 4])\n    changed = [r for r in rets if r[\"pc\"] == 4]\n    assert [r[\"insn\"] for r in changed] == replacements\n    assert [r[\"trap\"] for r in changed] == [0, 1, 1, 0, 0]\n    assert (changed[3][\"rd\"], changed[3][\"rd_wdata\"]) == (4, 1)\n    assert all(visits[i + 1] == 8 for i, pc in enumerate(visits[:-1]) if pc == 4)\n    assert not dmem\n\n\n@cocotb.test()\nasync def successor_replay_holds_and_stops_at_sixteen(dut):\n    # The first backedge trains the second lap. On lap three the bus\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
