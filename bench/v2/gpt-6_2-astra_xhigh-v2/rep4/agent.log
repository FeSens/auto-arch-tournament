{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor-profile.cpp\" <<'\"'CPP'\n#include <algorithm>\n#include <cstdint>\n#include <fstream>\n#include <iostream>\n#include <vector>\n\nstruct Instruction {uint32_t pc, npc, word, address;};\nstruct Stats {\n    int cycles=0, start=0, stop=0, fetches=0, miss=0, branch=0, taken=0, branch_miss=0, jal=0, jalr=0;\n};\nstatic bool ready(uint32_t& xs) {\n    xs \"'^= xs << 13; xs ''^= xs >> 17; xs ''^= xs << 5; return (xs & 127) < 100;\n}\nint main(int argc, char** argv) {\n    std::ifstream in(argv[1],std::ios::binary);\n    std::vector<Instruction> trace;\n    for(Instruction t;in.read((char*)&t,sizeof(t));) trace.push_back(t);\n    for (int entries : {0,16,32,64,128,256,512,1024}) {\n        std::vector<int> counts(std::max(1,entries),1);\n        int ex=-1, mem=-1, next=0, snapshot=0;\n        bool predicted=false, bracket=false;\n        Stats s;\n        uint32_t xs=0xdeadbeef;\n        for (int cycle=0;next < trace.size();cycle++) {\n            bool iready=ready(xs), dready=ready(xs);\n            uint32_t mem_op=mem==-1?0:trace[mem].word&127;\n            if (!dready && (mem_op==3 || mem_op==35)) continue;\n            if (mem_op==35 && trace[mem].address == 0x10000100) {s.start=cycle; bracket=true;}\n            if (mem_op==35 && trace[mem].address == 0x10000104) {s.stop=cycle; break;}\n            uint32_t op=ex==-1?0:trace[ex].word&127;\n            auto t = ex==-1? Instruction{} : trace[ex];\n            bool actual = op==0x6f || op==0x67 || (op==0x63 && t.npc != t.pc+4);\n            bool miss = actual != predicted;\n            auto f = trace[next];\n            bool hazard = op==3 && (t.word>>7&31)!=0 &&\n                ((t.word>>7&31)==(f.word>>15&31) || (t.word>>7&31)==(f.word>>20&31));\n            bool fetch = !miss && iready && !hazard;\n            int if_count = entries ? counts[(f.pc>>2)&(entries-1)] : 0;\n            if (bracket) {\n                s.fetches+=fetch; s.miss+=miss; s.branch+=(op==0x63);\n                s.taken+=op==0x63 && actual; s.branch_miss+=op==0x63 && miss;\n                s.jal+=op==0x6f; s.jalr+=op==0x67;\n            }\n            if(entries && op==0x63) counts[(t.pc>>2)&(entries-1)] = std::clamp(snapshot + (actual?1:-1),0,3);\n            predicted = fetch && entries && ((f.word&127)==0x6f || ((f.word&127)==0x63 && if_count>=2));\n            snapshot = if_count; mem=ex; ex = fetch?next++:-1;\n        }\n        std::cout << \"entries=\" << entries << \" marker_cycles=\" << s.stop-s.start << \" instructions=\" << s.fetches\n            << \" redirects=\" << s.miss << \" cond=\" << s.branch << \" taken_cond=\" << s.taken\n            << \" missed_cond=\" << s.branch_miss << \" jal=\" << s.jal << \" jalr=\" << s.jalr << \"'\"\\\\n\\\";\n    }\n}\nCPP\ng++ -O2 -std=c++17 \\\"\"'$TMPDIR/predictor-profile.cpp\" -o \"$TMPDIR/predictor-profile\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
