{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/_helpers.py | head -180 && cat .gitignore | rg 'hypoth|\\\\.yaml|__pycache__' && ls -la \\\"\"'$TMPDIR\" && command -v iverilog'","aggregated_output":"\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n__pycache__/\n# (since the orchestrator never `git add`s it), and the hypothesis-phase\n# sandbox check in tools/agents/hypothesis.py rolls back the next slot's\n# every rep was hypothesis_gen_failed for this reason.\n# and per-hypothesis by tools/agents/hypothesis.py for `tail -f` visibility\n#   iteration (accept/regression/broken). Rejected hypotheses never\n# - per-iteration worktrees and per-iteration hypothesis YAMLs are\ncores/*/experiments/hypotheses/\ncores/*/experiments/hypotheses/*.yml\ncores/*/experiments/hypotheses/*.yaml\n# `models-*-verify.yaml` for the throwaway model YAML.\ntools/bench/models-*-verify.yaml\ntotal 24\ndrwxrwx---+  7 nobody    nogroup   4096 Nov 21 22:06 .\ndrwxrwx---+  5 nobody    nogroup   4096 Nov 21 22:03 ..\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 22:06 .agents\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 22:06 .aws\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 22:06 .codex\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 22:06 .git\ndrwxrwx---+ 12 hwebench2 hwebench2 4096 Nov 21 22:06 codex-bwrap-synthetic-mount-targets-1002\n/srv/hwebench/toolchain/oss-cad-suite/bin/iverilog\n","exit_code":0,"status":"completed"}}
