{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/pred/verify.cpp\" <<'\"'CPP'\n#include \\\"Valu.h\\\"\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <random>\nusing u32=uint32_t;\nusing u64=uint64_t;\n\nstatic void tick(Valu& dut) {\n    dut.clock=0; dut.eval(); dut.clock=1; dut.eval();\n}\nstatic u64 checked=0;\nstatic void verify(Valu& dut, u32 a, u32 d, int op) {\n    const bool sign=op==15 || op==17;\n    const bool rem=op==17 || op==18;\n    const int64_t av=sign ? int64_t(int32_t(a)) : int64_t(a);\n    const int64_t dv=sign ? int64_t(int32_t(d)) : int64_t(d);\n    u32 wanted=d ? u32(rem ? av%dv : av/dv) : rem ? a : UINT32_MAX;\n    dut.op=op; dut.a=a; dut.b=d; dut.div_start=1; tick(dut);\n    dut.div_start=0;\n    for(int n=0;n<6;n++) tick(dut);\n    if (\"'!dut.div_last) std::abort();\n    tick(dut);\n    if (dut.div_busy || dut.div_result !=wanted) {\n        std::fprintf(stderr,\"failed op %d A %08x D %08x expected %08x actual %08x'\"\\\\n\\\",\n                     op,a,d,wanted,dut.div_result); std::exit(1);\n    }\n    checked++;\n}\nint main() {\n    Valu dut;\n    dut.reset=1; dut.div_accept=1; dut.div_start=0; tick(dut); dut.reset=0;\n    std::mt19937 rng(3696);\n    for(int s=0;s<=20;s++) for(u64 i=s?2048:1;i<=4095;i++) {\n        const u64 dmin=i<<s, dmax=((i+1)<<s)-1;\n        if (dmax>UINT32_MAX) continue;\n        for (auto d : {u32(dmin),u32(dmax)}) {\n            u32 multiple = (UINT32_MAX/d)*d;\n            for (auto a : {UINT32_MAX,multiple,multiple-1,multiple+1,u32(rng())}) {\n                verify(dut,a,d,16); verify(dut,a,d,18);\n            }\n        }\n    }\n    for (int n=0;n<100000;n++) {\n        u32 d=rng(),a=rng(); int op=15+(n%4);\n        if (n%7==0) d=(rng()&4095) * ((n%2==0)?1:-1);\n        verify(dut, a, d, op);\n    }\n    std::printf(\\\"checked %llu seven-round RV32M results\\\\n\\\",(unsigned long long)checked);\n}\nCPP\nverilator --cc --exe --build -j 2 --Mdir \\\"\"'$TMPDIR/pred/v3/check\" --top-module alu -I\"$TMPDIR/pred/v3/rtl\" -Wno-fatal \"$TMPDIR/pred/v3/rtl/alu.sv\" \"$TMPDIR/pred/verify.cpp\" > \"$TMPDIR/pred/v3/check_build.log\" 2>&1 && \"$TMPDIR/pred/v3/check/Valu\" > \"$TMPDIR/pred/v3/check.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
