ds [0:63];\n  logic [1:0]  counters [0:63];\n  logic        external_control;\n  logic        control_hit;\n  prediction_t prediction;\n\n  assign index = pc[7:2];\n  always_ff @(posedge clock) begin\n    if (reset || update.invalidate) valid <= '0;\n    else if (update.write)          valid[upd\n…[3555 of 6627 chars elided by tools/bench/transcript.py; sha256:67cfd376852b4942]…\nq <= read_slot;\n    read_active_q <= !reset && !update.invalidate && read_active;\n    read_limit_q <= last_slot[read_path];\n    read_valid_q <= path_valid[read_path] && !(write_word && read_addr == write_addr);\n  end\n  assign successor_hit = read_active_q && read_valid_q && read_slot_q <= read_limit_q &&\n                         pc == {12'b0, read_data[49:32], 2'b00};\n\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= prediction.taken ? {12'b0, prediction.target, 2'b00}\n                                              : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    // An unavailable fetch decodes as a side-effect-free bubble.\n    out.instr = imem_ready ? imem_data : prediction.hit ? words[index] :\n                successor_hit ? read_data[31:0] : 32'h0000_0013;\n    out.prediction = prediction;\n    out.valid = imem_ready || prediction.hit || successor_hit;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
