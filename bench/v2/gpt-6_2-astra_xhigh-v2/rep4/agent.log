{"type": "item.completed", "item": {"id": "item_73", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/load_predictor.sv; rg -n 'byte_mask|mem_load_data|branch_cond|BR_BEQ' cores/bench/rtl/{core,mem_stage,ex_stage}.sv\"", "aggregated_output": "// Direct-mapped replay of raw bus words. EX addresses the synchronous\n// read port. Its response and both port indices travel with EX/MEM.\nmodule load_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        advance,\n  input  logic [11:2] lookup_index,\n  input  logic [31:2] mem_addr,\n  input  logic        read_en,     // valid, naturally aligned MEM load\n  input  logic [3:0]  write_mask,  // actual bus strobes\n  input  logic        bus_ready,\n  input  logic [31:0] bus_rdata,\n  input  logic [31:0] bus_wdata,\n  output logic        hit,\n  output logic [31:0] word\n);\n  logic [40:0] rows [0:1023]; // {valid, address[19:12], raw word}\n  logic clearing;\n  logic [11:2] clear_index;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      clearing <= 1'b1;\n      clear_index <= '0;\n    end else if (clearing) begin\n      if (&clear_index) clearing <= 1'b0;\n      clear_index <= clear_index + 10'd1;\n    end\n  end\n\n  wire ram = mem_addr[31:20] == 0;\n  wire store = |write_mask;\n  wire update = bus_ready && ((ram && read_en) || store);\n  wire [11:2] write_index = clearing ? clear_index : mem_addr[11:2];\n  wire install = !clearing && ram && (read_en || (&write_mask));\n  always_ff @(posedge clock) begin\n    if (clearing || update)\n      rows[write_index] <= {install, mem_addr[19:12], store ? bus_wdata : bus_rdata};\n  end\n\n  logic [40:0] row_q;\n  logic [11:2] index_q, write_index_q;\n  logic written_q, lookup_valid_q;\n  always_ff @(posedge clock) begin\n    if (advance) begin\n      row_q         <= rows[lookup_index];\n      index_q       <= lookup_index;\n      write_index_q <= mem_addr[11:2];\n      written_q     <= update;\n    end\n    if (reset)        lookup_valid_q <= 1'b0;\n    else if (advance) lookup_valid_q <= !clearing;\n  end\n\n  // A coincident read/write has device-dependent read data. Comparing\n  // the registered addresses keeps the collision check off the EX path.\n  assign hit = read_en && lookup_valid_q && row_q[40] &&\n               mem_addr[31:2] == {12'b0, row_q[39:32], index_q} &&\n               !(written_q && write_index_q == index_q);\n  assign word = row_q[31:0];\nendmodule\ncores/bench/rtl/ex_stage.sv:25:  input  logic [31:0]        mem_load_data, // aligned and extended\ncores/bench/rtl/ex_stage.sv:128:  logic        branch_cond;\ncores/bench/rtl/ex_stage.sv:140:      equal = mem_load_data == (load_rs1 ? rs2 : rs1);\ncores/bench/rtl/ex_stage.sv:144:      BR_BEQ:  branch_cond = equal;\ncores/bench/rtl/ex_stage.sv:145:      BR_BNE:  branch_cond = !equal;\ncores/bench/rtl/ex_stage.sv:146:      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\ncores/bench/rtl/ex_stage.sv:147:      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\ncores/bench/rtl/ex_stage.sv:148:      BR_BLTU: branch_cond = (rs1 <  rs2);\ncores/bench/rtl/ex_stage.sv:149:      BR_BGEU: branch_cond = (rs1 >= rs2);\ncores/bench/rtl/ex_stage.sv:150:      default: branch_cond = 1'b0;\ncores/bench/rtl/ex_stage.sv:152:    branch_taken  = in.ctrl.is_branch && branch_cond;\ncores/bench/rtl/ex_stage.sv:239:      reg_q.rs1_val       <= div_done ? div_rs1_q : load_rs1 ? mem_load_data : rs1;\ncores/bench/rtl/ex_stage.sv:240:      reg_q.rs2_val       <= div_done ? div_rs2_q : load_rs2 ? mem_load_data : rs2;\ncores/bench/rtl/mem_stage.sv:48:  logic [3:0]  byte_mask;\ncores/bench/rtl/mem_stage.sv:92:      2'd0:    byte_mask = (4'b0001 << in.mem_addr[1:0]);\ncores/bench/rtl/mem_stage.sv:93:      2'd1:    byte_mask = (4'b0011 << in.mem_addr[1:0]);\ncores/bench/rtl/mem_stage.sv:94:      default: byte_mask = 4'b1111;\ncores/bench/rtl/mem_stage.sv:112:    dmem_wen   = (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\ncores/bench/rtl/mem_stage.sv:160:      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\ncores/bench/rtl/mem_stage.sv:161:      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\ncores/bench/rtl/core.sv:76:  logic [31:0] mem_load_data;\ncores/bench/rtl/core.sv:146:    .mem_load_data   (mem_load_data),\ncores/bench/rtl/core.sv:189:    .load_data  (mem_load_data),\n", "exit_code": 0, "status": "completed"}}
