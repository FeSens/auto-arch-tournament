{"type": "item.started", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/prep.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil,sys\nroot=Path(os.environ['TMPDIR']); dest=root/sys.argv[1]\nsrc=Path('cores/bench/rtl') if len(sys.argv)<3 else root/sys.argv[2]\nshutil.copytree(src,dest,dirs_exist_ok=True)\ndef edit(f,a,b):\n p=dest/(f+'.sv');s=p.read_text();assert s.count(a)==1,(f,a);p.write_text(s.replace(a,b))\nedit('core_pkg','logic [31:0] imm;', '''logic [31:0] imm;\n    logic [31:0] fall_pc, direct_pc;\n    logic        fix_yes, fix_no;\n    logic [31:0] alu_lhs, alu_rhs;''')\nedit('core','  always_ff @(posedge clock) begin\\\\n    if (\"'!stall_ex)'\"', '''  wire [31:0] direct_pc = waiting.pc + waiting.imm;\n  wire [31:0] fall_pc = waiting.pc + 32'd4;\n  wire direct_ok = direct_pc[1:0] == 0;\n  wire pred_taken = waiting.prediction.taken;\n  wire fix_taken = direct_ok ? \"'!pred_taken || direct_pc != {12'\"'b0,waiting.prediction.target,2'b00} : pred_taken;\n  wire fix_cf_true = (waiting.ctrl.is_branch || waiting.ctrl.is_jump) ? fix_taken : pred_taken;\n  wire fix_cf_false = waiting.ctrl.is_jump ? fix_taken : pred_taken;\n  wire inv = waiting.ctrl.is_branch && waiting.ctrl.branch_op[0];\n  logic alu_bypass_a,alu_bypass_b;\n  always_ff @(posedge clock) begin\n    if (\"'!stall_ex)'\"''')\nedit('core','      id_ex_w <= collected;', '''      id_ex_w <= collected;\n      id_ex_w.direct_pc <= direct_pc;\n      id_ex_w.fall_pc <= fall_pc;\n      id_ex_w.fix_yes <= inv ? fix_cf_false : fix_cf_true;\n      id_ex_w.fix_no  <= inv ? fix_cf_true : fix_cf_false;\n      id_ex_w.alu_lhs <= waiting.ctrl.is_auipc ? waiting.pc : collected.rs1_val;\n      id_ex_w.alu_rhs <= waiting.ctrl.alu_src ? waiting.imm : collected.rs2_val;\n      alu_bypass_a <= match_rs1 && ex_nonload_write && \"'!waiting.ctrl.is_auipc;\n      alu_bypass_b <= match_rs2 && ex_nonload_write && !waiting.ctrl.alu_src;'\"''')\nedit('core','    .bypass_rs1      (bypass_rs1_q),','''    .alu_bypass_a    (alu_bypass_a),\n    .alu_bypass_b    (alu_bypass_b),\n    .bypass_rs1      (bypass_rs1_q),''')\nedit('ex_stage','  input  logic               bypass_rs1,','''  input logic alu_bypass_a, alu_bypass_b,\n  input  logic               bypass_rs1,''')\nedit('ex_stage','in.ctrl.is_auipc ? in.pc  : rs1;', 'alu_bypass_a ? fwd_ex_mem : in.alu_lhs;')\nedit('ex_stage','in.ctrl.alu_src  ? in.imm : rs2;', 'alu_bypass_b ? fwd_ex_mem : in.alu_rhs;')\nedit('ex_stage','branch_target = in.pc + in.imm;', 'branch_target = in.direct_pc;')\np=dest/'ex_stage.sv';s=p.read_text().replace(\\\"in.pc + 32'd4\\\",\\\"in.fall_pc\\\");p.write_text(s)\nedit('ex_stage','''  assign redirect = advancing && (fence_i || taken \"'!= in.prediction.taken ||\n                    (taken && control_target != {12'\"'b0, in.prediction.target, 2'b00}));''','''  wire raw_condition = in.ctrl.branch_op[2] ?\n        (in.ctrl.branch_op[1] ? rs1 < rs2 : \"'$signed(rs1) < $signed(rs2)) : equal;\n  wire jalr_recover = taken != in.prediction.taken ||\n                      (taken && control_target != {12'\"'b0,in.prediction.target,2'b00});\n  assign redirect = advancing && (fence_i || (in.ctrl.is_jalr ? jalr_recover :\n                                  (raw_condition ? in.fix_yes : in.fix_no)));''')\nPY\ncat > \\\"\"'$TMPDIR/sign.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil,sys\nroot=Path(os.environ['TMPDIR']);dest=root/sys.argv[1];shutil.copytree(root/sys.argv[2],dest,dirs_exist_ok=True)\ndef edit(f,a,b):\n p=dest/(f+'.sv');s=p.read_text();assert s.count(a)==1,(f,a);p.write_text(s.replace(a,b))\nedit('core_pkg','logic [31:0] write_data;', 'logic         signed_a, signed_b, low_product, high_product;\\\\n    logic [31:0] write_data;')\nedit('ex_stage','reg_q.write_data    <= rs2;', '''reg_q.write_data    <= rs2;\n      reg_q.signed_a <= rs1[31] && (in.ctrl.alu_op == ALU_MULHSU || in.ctrl.alu_op == ALU_MULH);\n      reg_q.signed_b <= rs2[31] && in.ctrl.alu_op == ALU_MULH;\n      reg_q.low_product <= in.ctrl.alu_op == ALU_MUL;\n      reg_q.high_product <= in.ctrl.alu_op >= ALU_MULH && in.ctrl.alu_op <= ALU_MULHSU;''')\nedit('mem_stage','  multiplier u_mul (','''\"'`ifdef RISCV_FORMAL_ALTOPS\n  multiplier u_mul ('\"''')\nedit('mem_stage','''  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU: alu_result = mul_result;''','''\"'`else\n  logic [63:0] raw_product;\n  assign raw_product = $signed({in.signed_a,in.rs1_val}) * $signed({in.signed_b,in.rs2_val});\n  assign mul_result = (raw_product[63:32] & {32{in.high_product}}) |\n                      (raw_product[31:0] & {32{in.low_product}});\n`endif\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU: alu_result = mul_result;'\"''')\nPY\npython \\\"\"'$TMPDIR/prep.py\" prep\npython \"$TMPDIR/sign.py\" prepsign prep'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
