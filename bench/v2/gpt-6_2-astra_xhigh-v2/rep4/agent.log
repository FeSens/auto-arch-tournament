ero_result_q <= want_rem ? a : 32'\"'hffff_ffff;\n    end\n  end\n  logic [31:0] selected_q [0:4], selected_r [0:4];\n  for (genvar lane=0; lane<5; lane++) begin : g_lane\n    localparam int DIGITS = 5-lane;\n    localparam int Q_BITS = 7*DIGITS;\n    localparam int R_BITS = 4+7*lane;\n    logic [Q_BITS-1:0] quotient_q, quotient_next;\n    logic [R_BITS-1:0] remainder_q, remainder_next;\n    logic [DIGITS-1:0] digits;\n    logic [R_BITS-1:0] difference;\n    logic borrow, unused_msb;\n    always_comb begin\n      remainder_next = remainder_q;\n      for (int i=0; i<DIGITS; i++) begin\n        {borrow,unused_msb,difference} = {1'b0,remainder_next,quotient_q[Q_BITS-1-i]} -\n                                         {2'b0,divisor_q[R_BITS-1:0]};\n        digits[DIGITS-1-i] = \"'!borrow;\n        remainder_next = !borrow ? difference : {remainder_next[R_BITS-2:0],quotient_q[Q_BITS-1-i]};\n      end\n      quotient_next = {quotient_q[Q_BITS-DIGITS-1:0],digits};\n    end\n    always_ff @(posedge clock) begin\n      if (div_start) begin\n        remainder_q <= R_BITS'\"'(dividend_abs >> Q_BITS);\n        quotient_q <= Q_BITS'(dividend_abs);\n      end else if (div_busy && \"'!div_done) begin\n        remainder_q <= remainder_next;\n        quotient_q <= quotient_next;\n      end\n    end\n    assign selected_q[lane] = 32'\"'(quotient_next) & {32{lane_q[lane]}};\n    assign selected_r[lane] = 32'(remainder_next) & {32{lane_q[lane]}};\n  end\n  logic [31:0] final_q, final_r;\n  always_ff @(posedge clock) begin\n    if (round_q == 7) begin\n      final_q <= selected_q[0]|selected_q[1]|selected_q[2]|selected_q[3]|selected_q[4];\n      final_r <= selected_r[0]|selected_r[1]|selected_r[2]|selected_r[3]|selected_r[4];\n    end\n  end\n  wire [31:0] magnitude = want_rem_q ? final_r : final_q;\n  assign div_result = zero_q ? zero_result_q : negate_q ? -magnitude : magnitude;\n'''+txt[b:]\np.write_text(txt)\np=dst/'ex_stage.sv';txt=p.read_text().replace('.div_done   (div_done)', '.di