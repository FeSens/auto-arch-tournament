{"type":"item.started","item":{"id":"item_104","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'research/checkplain/test/test_pipeline.py'\ns=p.read_text().replace('successor_replay_holds_and_stops_at_sixteen','replay_holds_and_continues_past_sixteen').replace('[68] * 4 + [72]','[68, 72]').replace('assert visits[last_lap:last_lap + 3] == [4, 4, 8]','assert visits[last_lap:last_lap + 3] == [12, 4, 8]')\ns += \\\"\\\"\\\"\n@cocotb.test()\nasync def collision_waits_for_the_last_resolved_word(dut):\n    old = JAL(1, 0)\n    new = JAL(5, 0)\n    visits = []\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc \"'!= 0:\n            return word\n        n = visits.count(0)\n        if n == 1: return old\n        if n == 4: return new\n        if n >= 8: return EBREAK()\n        return None\n    writes = []\n    rets, _ = await _run(dut, [old, SW(0, 0, 112)], fetch=fetch, writes=writes)\n    assert [r['\"'insn'] for r in rets] == [old, old, new, new, EBREAK()], (visits, rets)\n    _check_pc_trace(rets, [0, 0, 0, 0, 0])\n    assert [r['rd'] for r in rets] == [1, 1, 5, 5, 0]\n    assert all(r['rd_wdata'] == 4 for r in rets[:-1])\n    assert not any(r['trap'] for r in rets) and not writes\n\n@cocotb.test()\nasync def independent_branches_and_a_true_index_alias(dut):\n    far = 16384\n    # Two jumps that previously competed for one BTB entry keep their\n    # targets on later visits. At the alias, require a fresh external word.\n    first, second = JAL(1, 256), JAL(5, -256)\n    program = [first] + [NOP()] * (far//4 - 1) + [ADDI(3, 0, 99), EBREAK()]\n    program[1] = SW(0,0,112)\n    program[64] = second\n    visits = []\n    def fetch(pc, word):\n        visits.append(pc)\n        n = visits.count(pc)\n        if pc == 0 and n >= 3:\n            return JAL(4, far)\n        if pc == 0 and n == 2 or pc == 256 and n >= 2:\n            return None\n        if pc == far and n < 4:\n            return None\n        return word\n    writes = []\n    rets, _ = await _run(dut, program, fetch=fetch, writes=writes)\n    _check_pc_trace(rets, [0, 256, 0, 256, 0, far, far+4])\n    assert [r['insn'] for r in rets] == [first,second,first,second,JAL(4,far),program[-2],EBREAK()]\n    assert visits.count(far)==4 and not writes and not any(r['trap'] for r in rets)\n\\\"\\\"\\\"\np.write_text(s)\nPY\ncd \\\"\"'$TMPDIR/research/checkplain\" && python -m pytest --rootdir=. -q -s test/test_pipeline.py > ../pipeline_plain4_new.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
