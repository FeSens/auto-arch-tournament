{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/pred/v1\"\ncp -r cores/bench/rtl cores/bench/test \"$TMPDIR/pred/v1/\"\ncat > \"$TMPDIR/pred/v1/make_variant.py\" <<'\"'PY'\nfrom pathlib import Path\np=Path(__file__).parent/'rtl/alu.sv'\ns=Path('cores/bench/rtl/alu.sv').read_text()\na=s.index('    logic [Q_BITS-1:0]')\nb=s.index('\\\\n  end\\\\n\\\\n  logic [31:0] quotient,', a)\nunit=\\\"\\\"\\\"\n    if (lane == 2 || lane == 3) begin : g_predict_digit\n      localparam int RADIX = 1 << DIGITS;\n      localparam int DROP = lane == 2 ? 8 : 16;\n      localparam int W = R_BITS + DIGITS;\n      logic [R_BITS:0] remainder_q;\n      logic [R_BITS-1:0] repaired_q;\n      logic [Q_BITS-1:0] dividend_q, q, qminus;\n      wire negative = remainder_q[R_BITS];\n      wire [W-1:0] x = {remainder_q[R_BITS-1:0], dividend_q[Q_BITS-1 -: DIGITS]};\n      logic [RADIX:0] ge;\n      logic [RADIX-1:-1] chosen;\n      logic [R_BITS:0] residue [-1:RADIX-1];\n      assign ge[0] = 1'b1;\n      assign ge[RADIX] = 1'b0;\n      assign chosen[-1] = negative;\n      assign residue[-1] = x[R_BITS:0] + {1'b0,divisor_q[R_BITS-1:0]};\n      assign residue[0] = x[R_BITS:0];\n      for (genvar j = 0; j < RADIX; j++) begin : g_trial\n        assign chosen[j] = \"'!negative && ge[j] && !ge[j+1];\n        if (j > 0) begin\n          logic [W-1:0] multiple;\n          if (j == 1 || j == 2 || j == 4) begin\n            assign multiple = W'\"'(divisor_q[R_BITS-1:0]) << \"'$clog2(j);\n          end else begin\n            always_ff @(posedge clock)\n              if (div_start) multiple <= W'\"'(divisor_abs[R_BITS-1:0]) * W'(j);\n          end\n          assign ge[j] = x[W-1:DROP] >= multiple[W-1:DROP];\n          assign residue[j] = x[R_BITS:0] - multiple[R_BITS:0];\n        end\n      end\n      logic [R_BITS:0] next_rem;\n      logic [R_BITS-1:0] repaired;\n      logic [DIGITS-1:0] digit, digit_minus;\n      always_comb begin\n        next_rem = residue[-1] & {(R_BITS+1){chosen[-1]}};\n        repaired = '0;\n        digit = {DIGITS{chosen[-1]}};\n        digit_minus = DIGITS'(RADIX-2) & {DIGITS{chosen[-1]}};\n        for (int j=0; j<RADIX; j++) begin\n          next_rem |= residue[j] & {(R_BITS+1){chosen[j]}};\n          repaired |= residue[j-1][R_BITS-1:0] & {R_BITS{chosen[j]}};\n          digit |= DIGITS'(j) & {DIGITS{chosen[j]}};\n          digit_minus |= DIGITS'(j-1) & {DIGITS{chosen[j]}};\n        end\n      end\n      always_ff @(posedge clock) begin\n        if (div_start) begin\n          remainder_q <= (R_BITS+1)'(dividend_abs[31:Q_BITS]);\n          dividend_q <= dividend_abs[Q_BITS-1:0];\n          q <= '0;\n          qminus <= '1;\n        end else if (div_busy && \"'!div_done) begin\n          remainder_q <= next_rem;\n          repaired_q <= repaired;\n          dividend_q <= dividend_q << DIGITS;\n          q <= {negative ? qminus[Q_BITS-DIGITS-1:0] : q[Q_BITS-DIGITS-1:0], digit};\n          qminus <= {(chosen[0] || negative) ? qminus[Q_BITS-DIGITS-1:0] : q[Q_BITS-DIGITS-1:0], digit_minus};\n        end\n      end\n      assign selected_quotient[lane] = 32'\"'(negative ? qminus : q) & {32{lane_q[lane]}};\n      assign selected_remainder[lane] = 32'(negative ? repaired_q : remainder_q[R_BITS-1:0]) & {32{lane_q[lane]}};\n    end else begin : g_original\n\\\"\\\"\\\"\ns=s[:a]+unit+s[a:b]+'\\\\n    end'+s[b:]\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/pred/v1/make_variant.py\"\ncat > \"$TMPDIR/pred/timing.py\" <<'\"'PY'\nfrom tools.eval import gowin\nimport sys, os\nfrom pathlib import Path\nd=Path(os.environ['TMPDIR'])/'pred'/sys.argv[1]\nres=gowin.build_all('.', d/'rtl','fpga/core_bench_si.sv',d/'timing',options=tuple(map(int,sys.argv[2:])))\nfor r in res:\n print(r,flush=True)\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/pred/timing.py\" v1 0 1 2 > \"$TMPDIR/pred/v1/timing.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
