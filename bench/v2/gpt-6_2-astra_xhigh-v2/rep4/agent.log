{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/agu_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os, sys\nbase = Path(os.environ['TMPDIR'])\nname = sys.argv[1]\nroot = base/name/'rtl'\ncopytree('cores/bench/rtl',root)\ndef change(fn, bef, aft):\n f=root/fn\n s=f.read_text()\n assert s.count(bef)==1, (fn,bef)\n f.write_text(s.replace(bef,aft))\nchange('core_pkg.sv','logic [31:0] write_data;','logic [31:0] eff_addr;\\\\n    logic [31:0] write_data;')\nchange('core.sv','  id_ex_t collected;', '''  logic addr_alu_q, addr_jump_q, addr_load_q;\n  id_ex_t collected;''')\nchange('core.sv','      id_ex_w <= collected;', '''      id_ex_w <= collected;\n      addr_alu_q  <= id_ex_w.valid && id_ex_w.ctrl.reg_write && \"'!id_ex_w.ctrl.mem_read && !id_ex_w.ctrl.is_jump;\n      addr_jump_q <= id_ex_w.valid && id_ex_w.ctrl.is_jump;\n      addr_load_q <= id_ex_w.valid && id_ex_w.ctrl.mem_read;'\"''')\nchange('core.sv','    .bypass_rs1      (adjacent_rs1_q && bypass_alu),','''    .addr_alu        (adjacent_rs1_q && (addr_alu_q || (addr_jump_q && ex_mem_w.ctrl.reg_write))),\n    .addr_load       (adjacent_rs1_q && addr_load_q && \"'!mem_misalign),\n    .bypass_rs1      (adjacent_rs1_q && bypass_alu),'\"''')\nchange('ex_stage.sv','  input  logic               bypass_rs1,','''  input  logic               addr_alu,\n  input  logic               addr_load,\n  input  logic               bypass_rs1,''')\nchange('ex_stage.sv','  ex_mem_t reg_q;', '''  logic [31:0] collected_addr, forwarded_addr, pointer_addr;\n  assign collected_addr = in.rs1_val + in.imm;\n  assign forwarded_addr = fwd_ex_mem + in.imm;\n  assign pointer_addr   = dmem_rdata + in.imm;\n  ex_mem_t reg_q;\n  logic [31:0] effective_q;\n  always_ff @(posedge clock) begin\n    if (\"'!stall) begin\n      effective_q <= ({32{addr_load}} & pointer_addr) |\n                     ({32{addr_alu}} & forwarded_addr) |\n                     ({32{!addr_load && !addr_alu}} & collected_addr);\n    end\n  end'\"''')\nchange('ex_stage.sv','  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    out.eff_addr = effective_q;\n  end''')\n# Dedicated addr fully replaces original load pointer computation.\nchange('ex_stage.sv','''      if (in.ctrl.mem_read && load_rs1)\n        reg_q.alu_result  <= dmem_rdata + in.imm;\n      else\n        reg_q.alu_result  <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;''','''      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;''')\nfor f in ['mem_stage.sv']:\n p=root/f\n t=p.read_text().replace('in.alu_result','in.eff_addr').replace('alu_result = in.eff_addr;', 'alu_result = in.alu_result;')\n p.write_text(t)\nPY\npython \\\"\"'$TMPDIR/agu_probe.py\" agu1\ncat > \"$TMPDIR/r9_fpga_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\nimport os, sys\npath=Path(os.environ['TMPDIR']) /sys.argv[1]\nfor d in build_all('.',path/'rtl','fpga/core_bench_si.sv',path/'timing',options=tuple(map(int,sys.argv[2:]))):\n print(d,flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/r9_fpga_probe.py\" agu1 0 1 2'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
