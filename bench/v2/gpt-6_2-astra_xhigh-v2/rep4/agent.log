{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'tail -12 \"$TMPDIR\"/{pipeline-initial,formal-check,cosim-check,elf-build}.log; ls -l cores/bench/generated/timing/*/gw.log; ls /opt/hwe-python; cat cores/bench/test/test_multiplier.py | tail -50'","aggregated_output":"error: unexpected argument '-1' found\n\n  tip: to pass '-1' as a value, use '-- -1'\n\nUsage: tail [OPTION]... [FILE]...\n\nFor more information, try '--help'.\n-rw-rw----+ 1 hwebench2 hwebench2 8246 Nov 21 16:31 cores/bench/generated/timing/gowin_p0/gw.log\n-rw-rw----+ 1 hwebench2 hwebench2 8246 Nov 21 16:31 cores/bench/generated/timing/gowin_p1/gw.log\n-rw-rw----+ 1 hwebench2 hwebench2 8246 Nov 21 16:31 cores/bench/generated/timing/gowin_p2/gw.log\ncpython-3.13-linux-x86_64-gnu\ncpython-3.13.12-linux-x86_64-gnu\n\"\"\"Check the combinational RV32M multiplier used in MEM.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU\n\nMASK32 = 0xffffffff\n\n\nasync def _check(dut, op, a, b, expected):\n    dut.op.value = op\n    dut.a.value = a\n    dut.b.value = b\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value)\n    assert actual == expected, f\"op={op} {a:#x} * {b:#x}: {actual:#x} != {expected:#x}\"\n\n\n@cocotb.test()\nasync def multiply_vectors(dut):\n    for op, a, b, expected in (\n        (ALU_MUL, 3, 4, 12),\n        (ALU_MUL, MASK32, MASK32, 1),\n        (ALU_MULH, 0x80000000, 2, MASK32),\n        (ALU_MULH, 0x80000000, 0x80000000, 0x40000000),\n        (ALU_MULH, 1, 1, 0),\n        (ALU_MULHU, MASK32, 2, 1),\n        (ALU_MULHU, MASK32, MASK32, 0xfffffffe),\n        (ALU_MULHSU, 0x80000000, MASK32, 0x80000000),\n        (ALU_MULHSU, MASK32, MASK32, MASK32),\n    ):\n        await _check(dut, op, a, b, expected)\n\n\n@cocotb.test()\nasync def full_width_multiply(dut):\n    edges = (0, 1, 2, 0x7fffffff, 0x80000000, 0x80000001, MASK32)\n    pairs = [(a, b) for a in edges for b in edges]\n    rng = random.Random(0x33)\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(128))\n    for a, b in pairs:\n        sa = a - (1 << 32) if a >> 31 else a\n        sb = b - (1 << 32) if b >> 31 else b\n        await _check(dut, ALU_MUL, a, b, (a * b) & MASK32)\n        await _check(dut, ALU_MULH, a, b, ((sa * sb) >> 32) & MASK32)\n        await _check(dut, ALU_MULHSU, a, b, ((sa * b) >> 32) & MASK32)\n        await _check(dut, ALU_MULHU, a, b, (a * b) >> 32)\n","exit_code":0,"status":"completed"}}
