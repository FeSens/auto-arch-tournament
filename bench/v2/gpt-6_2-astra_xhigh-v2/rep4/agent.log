{"type": "item.completed", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// PC-indexed instruction replay and next-PC prediction. Read both possible\n// successors on the edge that accepts their predecessor. The registered port\n// selection associates a single word and prediction with the installed PC.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        stall,\n  input  logic        redirect,\n  input  logic [31:0] redirect_target,\n  input  btb_update_t update,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  input  logic        imem_ready,\n  output if_id_t      out\n);\n  typedef struct packed {\n    logic [19:13] tag;\n    logic         control;\n    logic [1:0]   counter;\n    logic [19:2]  target;\n    logic [31:0]  instr;\n  } entry_t;\n\n  logic [31:0] pc, predicted_pc_q, recovery_pc_q;\n  logic        recovering_q, select_target, target_port_q;\n  prediction_t prediction;\n\n  // The EX correction and its address have their own registers. ID kills\n  // the younger issue on the redirect edge. At the corrected PC a ready\n  // bus can issue immediately, and a wait launches a sequential-port retry.\n  assign pc = recovering_q ? recovery_pc_q : predicted_pc_q;\n  assign imem_addr = pc;\n  wire [31:0] sequential_pc = stall ? pc : pc + 32'd4;\n  assign select_target = !stall && prediction.taken;\n\n  always_ff @(posedge clock) begin\n    recovering_q <= !reset && redirect;\n    recovery_pc_q <= redirect_target;\n    if (reset) predicted_pc_q <= '0;\n    else       predicted_pc_q <= select_target ? {12'b0, prediction.target, 2'b0}\n                                               : sequential_pc;\n    target_port_q <= select_target;\n  end\n\n  wire        write_entry = update.write || update.successor;\n  wire [12:2] write_index = update.pc[12:2];\n  wire [12:2] sequential_index = sequential_pc[12:2];\n  wire [12:2] target_index = prediction.target[12:2];\n  entry_t write_data, sequential_q, target_q, entry;\n  logic [$bits(write_data)-1:0] sequential_ram [0:2047];\n  logic [$bits(write_data)-1:0] target_ram [0:2047];\n  logic   sequential_clean_q, target_clean\n…[1186 of 4258 chars elided by tools/bench/transcript.py; sha256:ac96e37f266cdd08]…\nups[write_group] ? initialized[write_group] : 16'b0)\n                                  | write_bit;\n  end\n\n  logic hit, external_control;\n  assign hit = !recovering_q && pc[31:20] == 0 && pc[1:0] == 0 &&\n               live_groups[pc[12:6]] && initialized[pc[12:6]][pc[5:2]] &&\n               (target_port_q ? target_clean_q : sequential_clean_q) && entry.tag == pc[19:13];\n  assign external_control = imem_data[6:0] == 7'h6f ||\n                            (imem_data[6:0] == 7'h67 && imem_data[14:12] == 0) ||\n                            (imem_data[6:0] == 7'h63 && imem_data[14:13] != 2'b01);\n  assign prediction.hit = hit && entry.control;\n  assign prediction.counter = entry.counter;\n  assign prediction.target = entry.target;\n  assign prediction.taken = prediction.hit && entry.counter[1] && (!imem_ready || external_control);\n\n  assign out.pc = pc;\n  assign out.instr = imem_ready ? imem_data : hit ? entry.instr : 32'h0000_0013;\n  assign out.valid = imem_ready || hit;\n  assign out.prediction = prediction;\nendmodule\n", "exit_code": 0, "status": "completed"}}
