l signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        if pending_read is not None:\n   \n…[3936 of 7008 chars elided by tools/bench/transcript.py; sha256:63ed04b92105fa4b]…\nning NOP puts the first ADDI in MEM at operand collection.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n                return None if refetch.count(16) <= 4 else replacement\n        return word\n\n    rets, _ = await _run(dut, program, fetch=fetch)\n    i = refetch.index(16)\n    assert refetch[i:i + 6] == [16] * 5 + [20]\n    _check_pc_trace(rets, [0, 4, 16, 20, 24, 8, 12, 4, 16, 20, 24, 28])\n    assert [(r[\"insn\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 16] == [\n        (program[4], 11), (replacement, 55)]\n    assert not any(r[\"trap\"] for r in rets)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
