{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv && cat cores/bench/core.yaml'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU with a shared six-round restoring divider.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        div_start,   // one issue pulse while idle\n  input  logic        div_accept,  // downstream can capture a completed result\n  output logic        div_busy,\n  output logic        div_done,\n  output logic [31:0] div_result,\n  output logic [31:0] out\n);\n\n  // Idle = 0, restoring rounds = 1..6, result held for EX/MEM = 7.\n  logic [2:0] round_q;\n  assign div_busy = round_q != 3'd0;\n  assign div_done = round_q == 3'd7;\n\n  always_ff @(posedge clock) begin\n    if (reset)                      round_q <= 3'd0;\n    else if (div_start)             round_q <= 3'd1;\n    else if (div_done && div_accept) round_q <= 3'd0;\n    else if (div_busy && !div_done) round_q <= round_q + 3'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        default:  div_result <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n  end\n`else\n  // EX consumes the top 30 bits of the dividend. Each consumed bit\n  // makes room for a quotient digit at the bottom of the shift register.\n  logic [29:0] quotient_q, remainder_q;\n  logic [1:0]  tail_q;\n  logic [31:0] divisor_q, dividend_abs;\n  logic        want_rem_q, negate_q;\n  logic        signed_op, want_rem;\n  logic        negative_a, negative_b;\n  assign signed_op  = op == ALU_DIV || op == ALU_REM;\n  assign want_rem   = op == ALU_REM || op == ALU_REMU;\n  assign negative_a = signed_op && a[31];\n  assign negative_b = signed_op && b[31];\n  assign dividend_abs = negative_a ? -a : a;\n\n  logic [29:0] remainder_next;\n  logic [30:0] trial;\n  logic [4:0]  quotient_bits;\n  always_comb begin\n\n…[2773 of 5845 chars elided by tools/bench/transcript.py; sha256:a682641e2efb8c85]…\n = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      default:    out = 32'b0;\n    endcase\n  end\n`else\n  logic signed [32:0] lhs, rhs;\n  logic signed [63:0] product;\n  assign lhs = $signed({a[31] && (op == ALU_MULH || op == ALU_MULHSU), a});\n  assign rhs = $signed({b[31] && op == ALU_MULH, b});\n  assign product = lhs * rhs;\n  assign out = op == ALU_MUL ? product[31:0] : product[63:32];\n`endif\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 51.41\n  lut4: 3824\n  ff: 953\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-001-r5s0\n  updated: '2026-11-21T15:44:46.381241Z'\n", "exit_code": 0, "status": "completed"}}
