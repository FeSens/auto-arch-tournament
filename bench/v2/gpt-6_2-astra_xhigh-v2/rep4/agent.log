{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/3df75752/782d65b5/r14-study/rel.py <<'PY'\nfrom variants import *\nfrom tools.eval.gowin import build_all\ndef rel(name,w,mode,base):\n    # Characterize branch redirect in terms of equality and a single unsigned\n    # magnitude comparison. Negation, branch family, and direction prediction\n    # are all combined before EX. Select for sign only if signs differ.\n    d=cmp_variant(name,32//w) if w<32 else cmp_variant(name,1)\n    c=(d/'core.sv').read_text();x=(d/'ex_stage.sv').read_text()\n    c=c.replace('  logic        redirect_on_taken_q, redirect_on_fallthrough_q, redirect_always_q;', '''  logic        redirect_on_taken_q, redirect_on_fallthrough_q, redirect_always_q;\n  logic [3:0] rel_q;''')\n    i=c.index('      redirect_on_taken_q <=')\n    j=c.index('      redirect_always_q <=',i)\n    c=c[:i]+'''      rel_q[0] <= waiting.ctrl.is_branch && \"'!waiting.ctrl.branch_op[2] &&\n                   (waiting.ctrl.branch_op[0] ? waiting.prediction.taken : bad_direct);\n      rel_q[1] <= waiting.ctrl.is_branch && !waiting.ctrl.branch_op[2] &&\n                   (waiting.ctrl.branch_op[0] ? bad_direct : waiting.prediction.taken);\n      rel_q[2] <= waiting.ctrl.is_branch && waiting.ctrl.branch_op[2] &&\n                   (waiting.ctrl.branch_op[0] ? waiting.prediction.taken : bad_direct);\n      rel_q[3] <= waiting.ctrl.is_branch && waiting.ctrl.branch_op[2] &&\n                   (waiting.ctrl.branch_op[0] ? bad_direct : waiting.prediction.taken);\n'\"'''+c[j:]\n    c=c.replace('    .redirect_on_taken(redirect_on_taken_q),\\\\n    .redirect_on_fallthrough(redirect_on_fallthrough_q),','    .rel_q,')\n    c=c.replace('redirect_on_taken_q, redirect_on_fallthrough_q, redirect_always_q','redirect_always_q')\n    x=x.replace('  input  logic               redirect_on_taken, redirect_on_fallthrough, redirect_always,','  input  logic               redirect_always,\\\\n  input logic [3:0] rel_q,')\n    x=x.replace('(predicate ? redirect_on_taken : redirect_on_fallthrough)', '((eq_all ? rel_q[0] : rel_q[1]) || (lt_all ? rel_q[2] : rel_q[3]))')\n    if mode=='xor':\n        x=x.replace(\\\"((rs1[31] \"'^ rs2[31]) && (in.ctrl.branch_op[1] == 1'\"'b0)) ? rs1[31] : lt_unsigned\\\",\\\"lt_unsigned \"'^ ((rs1[31] ''^ rs2[31]) && !in.ctrl.branch_op[1])\")\n    if base=='\"'literal':\n        litcore=(root/base/'rtl/core.sv').read_text()\n        block=litcore[litcore.index('      literal_q <='):litcore.index('      id_ex_w <= collected;')]\n        c=c.replace('  logic [31:0] direct_target_q, sequential_pc_q;', '  logic [31:0] direct_target_q, sequential_pc_q, literal_q;')\n        c=c.replace('\"'!waiting.ctrl.is_jump && !waiting.ctrl.mem_read &&'\"','\"'!waiting.ctrl.is_auipc && !waiting.ctrl.is_lui && !waiting.ctrl.is_jump && !waiting.ctrl.mem_read &&'\"')\n        c=c.replace('      id_ex_w <= collected;',block+'      id_ex_w <= collected;')\n        c=c.replace('    .repair, .candidate,','    .literal(literal_q), .repair, .candidate,')\n        x=x.replace('  input  logic [31:0]        fwd_ex_mem,','  input  logic [31:0]        literal, fwd_ex_mem,')\n        x=x.replace('alu_a = (in.ctrl.is_auipc ? in.pc : in.rs1_val) | ({32{bypass_alu_a}} & fwd_ex_mem);','alu_a = rs1;')\n        x=x.replace('alu_result | ({32{in.ctrl.is_jump}} & sequential_pc) |','alu_result | literal |')\n    (d/'core.sv').write_text(c);(d/'ex_stage.sv').write_text(x);return d\nif __name__=='__main__':\n    name,w,mode,base,*opts=sys.argv[1:]\n    d=rel(name,int(w),mode,base)\n    print(build_all(wt,d,'fpga/core_bench_si.sv',root/name,options=list(map(int,opts)) or [1]),flush=True)\nPY\nPYTHONPATH=. python3 /srv/hwebench/tmp/3df75752/782d65b5/r14-study/rel.py rel8 8 xor orig 1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
