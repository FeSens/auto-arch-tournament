r is already available from the BTB as the fence resolves.\n    program = [JAL(0, 8), 0x0000100f, JAL(2, 12), EBREAK(), NOP(), JAL(0, -16)]\n    replacement = ADDI(3, 0, 99)\n    visits = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc == 8:\n            n = visits.count(8)\n       \n…[7360 of 10432 chars elided by tools/bench/transcript.py; sha256:73f0ababc52c7d18]…\ns)\n    assert [r[\"insn\"] for r in rets] == [program[p // 4] for p in pcs]\n    assert writes == [(128, 15, 8)]\n    assert not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def fence_i_invalidates_successor_words(dut):\n    program = [ADDI(1, 0, 2), JAL(0, 12), 0x0000100f, JAL(0, -8),\n               ADDI(2, 0, 11), ADDI(1, 1, -1), BNE(1, 0, -16), EBREAK()]\n    replacement = ADDI(2, 0, 55)\n    visits = []\n    refetch = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if visits.count(4) == 2:\n            refetch.append(pc)\n            if pc == 16:\n                return None if refetch.count(16) <= 4 else replacement\n        return word\n\n    rets, _ = await _run(dut, program, fetch=fetch)\n    i = refetch.index(16)\n    assert refetch[i:i + 6] == [16] * 5 + [20]\n    _check_pc_trace(rets, [0, 4, 16, 20, 24, 8, 12, 4, 16, 20, 24, 28])\n    assert [(r[\"insn\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 16] == [\n        (program[4], 11), (replacement, 55)]\n    assert not any(r[\"trap\"] for r in rets)\n\n", "exit_code": 0, "status": "completed"}}
