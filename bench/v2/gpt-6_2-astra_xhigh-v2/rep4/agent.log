{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/mkproducer.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os,sys\ntmp=Path(os.environ['TMPDIR'])\nr=tmp/sys.argv[1]/'rtl'\ncopytree(tmp/'token1'/'rtl',r)\ndef edit(f, a,b):\n p=r/f\n s=p.read_text()\n assert s.count(a)==1,(f,a)\n p.write_text(s.replace(a,b))\nedit('ex_stage.sv','  output ex_mem_t  out,','''  output logic alu_writer, load_writer,\n  output logic [1:0] load_offset,\n  output ex_mem_t  out,''')\nedit('ex_stage.sv','  ex_mem_t reg_q;','''  assign alu_writer = ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read;\n  assign load_offset = in.imm[1:0] + (load_rs1 ? dmem_rdata[1:0] : rs1[1:0]);\n  assign load_writer = in.valid && in.ctrl.mem_read &&\n                        (in.ctrl.mem_width == 0 || (in.ctrl.mem_width == 1 && !load_offset[0]) ||\n                         (in.ctrl.mem_width == 2 && load_offset == 0));\n  ex_mem_t reg_q;'\"''')\np=r/'core.sv'; s=p.read_text(); a=s.index('  logic adj_alu1'); b=s.index('  id_ex_t collected;',a)\ns=s[:a]+'''  logic adj_alu1, adj_alu2, adj_load1, adj_load2, ex_alu_prod, ex_load_prod;\n  logic [1:0] load_offset;\n'''+s[b:]\ns='\\\\n'.join(l for l in s.split('\\\\n') if 'adj_jump1 <=' not in l and 'adj_jump2 <=' not in l)\nfor i in range(1,3):\n s=s.replace(f'adj_alu{i} || (adj_jump{i} && ex_mem_w.ctrl.reg_write)',f'adj_alu{i}')\n s=s.replace(f'adj_load{i} && \"'!mem_misalign'\"',f'adj_load{i}')\ns=s.replace('    .out             (ex_mem_w),','    .out             (ex_mem_w),\\\\n    .alu_writer      (ex_alu_prod),\\\\n    .load_writer     (ex_load_prod),\\\\n    .load_offset     (load_offset),')\np.write_text(s)\nif sys.argv[2]=='cmp':\n edit('core.sv','  id_ex_t collected;','''  logic [3:0] cmp_lane_q;\n  logic [1:0] cmp_width_q;\n  logic cmp_sext_q;\n  logic [31:0] cmp_other_q;\n  id_ex_t collected;''')\n edit('core.sv','      id_ex_w <= collected;', '''      id_ex_w <= collected;\n      cmp_other_q <= (id_ex_w.rd == waiting.rs1_addr) ? collected.rs2_val : collected.rs1_val;\n      cmp_width_q <= id_ex_w.ctrl.mem_width;\n      cmp_sext_q <= id_ex_w.ctrl.mem_sext;\n      cmp_lane_q <= (id_ex_w.ctrl.mem_width == 0) ? (4'b1 << load_offset) :\n                    (id_ex_w.ctrl.mem_width == 1) ? (4'b11 << load_offset) : 4'b1111;''')\n edit('ex_stage.sv','  output logic alu_writer, load_writer,','''  input logic [3:0] cmp_lane,\n  input logic [1:0] cmp_width,\n  input logic cmp_sext,\n  input logic [31:0] cmp_other,\n  output logic alu_writer, load_writer,''')\n edit('core.sv','    .load_offset     (load_offset),','''    .load_offset     (load_offset),\n    .cmp_lane        (cmp_lane_q),\n    .cmp_width       (cmp_width_q),\n    .cmp_sext        (cmp_sext_q),\n    .cmp_other       (cmp_other_q),''')\n edit('ex_stage.sv','  always_comb begin\\\\n    // With one load', '''  wire [31:0] cmp_expected = cmp_width == 0 ? {4{cmp_other[7:0]}} :\n                             cmp_width == 1 ? {2{cmp_other[15:0]}} : cmp_other;\n  wire cmp_ext_ok = (cmp_width \"'!= 0 || cmp_other[31:8] == {24{cmp_sext && cmp_other[7]}}) &&\n                    (cmp_width != 1 || cmp_other[31:16] == {16{cmp_sext && cmp_other[15]}});\n  wire [3:0] bytes_equal;\n  for(genvar j=0; j<4; j++) begin\n    assign bytes_equal[j] = (dmem_rdata[j*8+:8] == cmp_expected[j*8+:8]) || !cmp_lane[j];\n  end\n  always_comb begin\n    // With one load'\"''')\n edit('ex_stage.sv','equal = mem_load_data == (load_rs1 ? in.rs2_val : in.rs1_val);','equal = (&bytes_equal) && cmp_ext_ok;')\nPY\npython \\\"\"'$TMPDIR/mkproducer.py\" prod1 cmp && PYTHONPATH=. python \"$TMPDIR/r9_fpga_probe.py\" prod1 1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
