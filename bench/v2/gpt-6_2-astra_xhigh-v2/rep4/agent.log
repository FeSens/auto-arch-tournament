= lookup_pc[12:2];\n  logic [59:0] entries [0:2047];\n  logic [59:0] row_q;\n  always_ff @(posedge clock) begin\n    if (wr)\n      entries[wr_index] <= {update.pc[19:13], update.write, update.counter, update.target, update.instr};\n    row_q <= entries[rd_index];\n  end\n\n  logic [127:0] live;\n  logic [15:0] masks [0:127];\n  wire [6:0] wr_group = wr_index[10:4];\n  wire [6:0] rd_group = rd_index[10:4];\n  wire [15:0] wr_mask = (live[wr_group] ? masks[wr_group] : 16'b0) |\n                         (16'h1 << wr_index[3:0]);\n  logic [15:0] mask_q;\n  logic collision_q;\n  always_ff @(posedge clock) begin\n    if (reset || update.invalidate) live <= '0;\n    else if (wr) live[wr_group] <= 1'b1;\n    if (wr) masks[wr_group] <= wr_mask;\n    mask_q <= wr && wr_group == rd_group ? wr_mask : masks[rd_group];\n    collision_q <= wr && wr_index == rd_index;\n  end\n  wire hit = !repair && live[pc[12:6]] && mask_q[pc[5:2]] && !collision_q &&\n             pc[31:20] == 0 && pc[1:0] == 0 && row_q[59:53] == pc[19:13];\n  wire external_control = imem_data[6:0] == 7'h6f ||\n                          (imem_data[6:0] == 7'h67 && imem_data[14:12] == 0) ||\n                          (imem_data[6:0] == 7'h63 && imem_data[14:13] != 2'b01);\n  assign prediction.hit = hit && row_q[52] && !repair;\n  assign prediction.counter = row_q[51:50];\n  assign prediction.target = row_q[49:32];\n  assign prediction.taken = prediction.hit && prediction.counter[1] &&\n                            (!imem_ready || external_control);\n\n  assign out.pc = imem_addr;\n  assign out.prediction = prediction;\n  assign out.valid = imem_ready || hit;\n  assign out.instr = imem_ready ? imem_data :\n                     hit ? row_q[31:0] : 32'h13;\nendmodule\n","exit_code":0,"status":"completed"}}
