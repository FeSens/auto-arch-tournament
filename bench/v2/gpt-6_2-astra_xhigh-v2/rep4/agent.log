es' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[8709 of 11781 chars elided by tools/bench/transcript.py; sha256:81f4415ba56150e4]…\ndiv_done.value)\n    dut.div_accept.value = int(hold_cycles == 0)\n    await _tick(dut)\n    actual = int(dut.div_result.value)\n    assert actual == expected & MASK32, (\n        f\"op={op} a={a:#x} b={b:#x} expected={expected & MASK32:#x} got={actual:#x}\"\n    )\n    for cycle in range(hold_cycles):\n        assert int(dut.div_done.value) and int(dut.div_busy.value)\n        assert not int(dut.div_last.value)\n        assert int(dut.div_result.value) == actual\n        dut.div_accept.value = int(cycle == hold_cycles - 1)\n        await _tick(dut)\n    assert not int(dut.div_busy.value) and not int(dut.div_done.value)\n    assert not int(dut.div_last.value)\n    assert int(dut.div_result.value) == expected & MASK32, \"MEM lost the accepted divide\"\n    dut.div_accept.value = 0\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\nVexRiscv\nbench-wgpaboIYz\nbench-wxzDR26ON\nnerv\npicorv32\nserv\n", "exit_code": 0, "status": "completed"}}
