{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'module core|btb_update_t|div_wait|result_hazard' cores/bench/rtl/core.sv\nrg -n 'hazard|load_use|load_to|wait' cores/bench/test/test_pipeline.py | head -100\ndf -h \\\"\"'$TMPDIR\"; ls -lh \"$TMPDIR/probe\"'", "aggregated_output": "20:module core (\n73:  logic       stall_if, stall_id, stall_ex, result_hazard;\n74:  logic       stall_ex_mem, hold_mem_wb, div_wait;\n90:  btb_update_t btb_update;\n196:    if (reset || redirect || (!stall_ex && result_hazard))\n221:    .div_wait        (div_wait),\n265:    .div_wait       (div_wait),\n272:    .result_hazard  (result_hazard),\n82:async def _run(dut, program, dmem_init=None, max_cycles=200, read_waits=None,\n83:               fetch=None, writes=None, write_waits=None):\n88:    see the new value. read_waits and write_waits specify delays by address.\n90:    wait cycle. writes collects each accepted store.\n97:    waits = dict(read_waits or {})\n98:    store_waits = dict(write_waits or {})\n117:        await RisingEdge(dut.clock)\n124:        await RisingEdge(dut.clock)\n125:        await Timer(1, \"ns\")  # let combinational signals settle\n139:        request_waits = waits if ren else store_waits\n140:        stalled = (ren or wen) and request_waits.get(da, 0) > 0\n143:            request_waits[da] -= 1\n187:            dut.io_dmemRData.value = 0xfffe5555 if waits[da] % 2 else 0xdeadbeef\n193:    assert not any(waits.values()), f\"unexercised load wait cycles: {waits}\"\n194:    assert not any(store_waits.values()), f\"unexercised store wait cycles: {store_waits}\"\n221:    rets, _ = await _run(dut, program)\n237:    rets, _ = await _run(dut, program)\n243:async def load_use_stalls(dut):\n257:    rets, dmem = await _run(dut, program)\n282:    rets, _ = await _run(dut, program, memory, read_waits={0x46: 3},\n343:    rets, _ = await _run(dut, program, memory, max_cycles=2 * len(program),\n344:                         read_waits={0x100: 4, 0x102: 3})\n362:    rets, _ = await _run(dut, program, memory, read_waits={0x80: 4})\n385:    rets, _ = await _run(dut, program, {0x40: 0, 124: 0x98765432}, writes=writes)\n410:    rets, _ = await _run(dut, program, {0x80: 0x103, 0x100: 0xfffe4321},\n411:                         read_waits={0x80: 3, 0x102: 3})\n429:    # The ADD waits behind DIV while both of its writers drain through WB.\n431:    rets,\n…[1791 of 4863 chars elided by tools/bench/transcript.py; sha256:30c237799fa91994]…\n 33},\n940:                         read_waits={12: 4}, fetch=fetch, writes=writes)\n941:    # The ADDI waits in collection. One interlock and four dmem holds\n985:    rets, _ = await _run(dut, program, memory, fetch=fetch, writes=writes)\n1025:    rets, dmem = await _run(dut, program, fetch=fetch)\n1037:    # for PC 4 from that lap. The third lap must wait for a fresh read.\n1050:    rets, dmem = await _run(dut, program, fetch=fetch)\n1079:    rets, dmem = await _run(dut, program, fetch=fetch, writes=writes)\n1109:    rets, _ = await _run(dut, program, {4: 11, 8: 42}, read_waits={8: 3},\n1141:    rets, _ = await _run(dut, program, fetch=fetch, writes=writes)\n1168:    rets, _ = await _run(dut, program, fetch=fetch)\n1185:            \"hazard_unit.sv\", \"forward_unit.sv\",\nFilesystem      Size  Used Avail Use% Mounted on\n/dev/md2        905G  748G  112G  88% /srv/hwebench/tmp/3df75752/8d736254\ntotal 36K\n-rwxrwx---+ 1 hwebench2 hwebench2  27K Nov 21 20:58 coremark.elf\ndrwxrwx---+ 2 hwebench2 hwebench2 4.0K Nov 21 20:58 rtl\n", "exit_code": 0, "status": "completed"}}
