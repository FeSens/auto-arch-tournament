{"type": "item.completed", "item": {"id": "item_127", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Run the EX ALU, seven-round divider, and multiplier unit tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.result_sel.value = 0\n    dut.product.value = 0\n    dut.div_start.value = 0\n    dut.div_accept.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.result_sel.value = 1 << op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0, previous_result=None):\n    assert not int(dut.div_busy.value)\n    signed = op in (ALU_DIV, ALU_REM)\n    a_bits, b_bits = a & MASK32, b & MASK32\n    a_mag = (1 << 32) - a_bits if signed and a_bits >> 31 else a_bits\n    b_mag = (1 << 32) - b_bits if signed and b_bits >> 31 else b_bits\n    dut.op.value = op\n    dut.a.value = a_bits\n    dut.b.value = b_bits\n    dut.div_start.value = 1\n    if previous_result is not None:\n        # MEM samples this value on the edge that issues the next divide.\n        await Timer(1, \"ns\")\n        assert int(dut.div_result.value) == previous_result & MASK32\n    await _tick(dut)\n    dut.div_start.value = 0\n    # The bypass inputs and opcode can change as soon as issue completes.\n    dut.op.value = ALU_ADD\n    dut.a.value =\n…[9496 of 12568 chars elided by tools/bench/transcript.py; sha256:41ca9da02df22fae]…\ntimate. Dropping its carry would\n    # accept a quotient one too high. Hold both corrected results.\n    for op in (ALU_DIVU, ALU_REMU):\n        await _check_div(dut, op, MASK32, 0x80d, _div_reference(op, MASK32, 0x80d),\n                         hold_cycles=3)\n\n\n@cocotb.test()\nasync def reset_during_divide(dut):\n    await _setup(dut)\n    dut.op.value = ALU_DIVU\n    dut.a.value = MASK32\n    dut.b.value = 7\n    dut.div_start.value = 1\n    await _tick(dut)\n    dut.div_start.value = 0\n    await _tick(dut)\n    assert int(dut.div_busy.value)\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n    await _check_div(dut, ALU_REM, -10, 3, -1)\n\n\ndef test_alu_runner():\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_multiplier_runner():\n    run_cocotb(toplevel=\"multiplier\", sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_multiplier\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_128", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU with a seven-round reciprocal-based divider.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [10:0] result_sel,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        div_start,   // one issue pulse while idle\n  input  logic        div_accept,  // downstream can capture a completed result\n  input  logic [63:0] product,     // from the shared EX multiplier\n  output logic        factor_write,\n  output logic [31:0] factor_a,\n  output logic [31:0] factor_b,\n  output logic        div_busy,\n  output logic        div_last,    // result can transfer on the upcoming edge\n  output logic        div_done,\n  output logic [31:0] div_result,\n  output logic [31:0] out\n);\n\n  // Round seven writes the result on the EX/MEM transfer edge. Enter\n  // the held state only when downstream cannot accept that transfer.\n  logic [7:1] round_q;\n  assign div_last = round_q[7];\n  assign factor_write = round_q[3] || round_q[5];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      round_q  <= '0;\n      div_busy <= 1'b0;\n      div_done <= 1'b0;\n    end else begin\n      round_q  <= {round_q[6:1], div_start};\n      div_done <= (div_last || div_done) && !div_accept;\n      if (div_start) div_busy <= 1'b1;\n      else if ((div_last || div_done) && div_accept) div_busy <= 1'b0;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  wire unused_product = ^product;\n  assign factor_a = '0;\n  assign factor_b = '0;\n  logic [31:0] alt_result_q;\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      case (op)\n        ALU_DIV:  alt_result_q <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: alt_result_q <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  alt_result_q <= (a - b) ^ 32'h8da68fa5;\n        default:  alt_result_q <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n    if (div_last) div_result <= alt_result_q;\n  end\n`else\n  logic [31:0] dividend_q, divisor_q;\n  logic        want_rem_q,\n…[4274 of 7346 chars elided by tools/bench/transcript.py; sha256:2fbc8265fe110d44]…\n >>> shamt)) |\n               ({32{result_sel[ALU_LUI[3:0]]}}  & b);\n\nendmodule\n\n/* verilator lint_off DECLFILENAME */\nmodule multiplier (\n  // The formal model selects its formula by opcode. The DSP takes the\n  // extension bits directly from EX.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [4:0]  op,\n  input  logic        lhs_ext,\n  input  logic        rhs_ext,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [63:0] product\n);\n/* verilator lint_on DECLFILENAME */\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result;\n  always_comb begin\n    case (op)\n      ALU_MUL:    alt_result = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   alt_result = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  alt_result = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: alt_result = (a - b) ^ 32'hecfbe137;\n      default:    alt_result = 32'b0;\n    endcase\n  end\n  assign product = {2{alt_result}};\n`else\n  assign product = $signed({lhs_ext, a}) * $signed({rhs_ext, b});\n`endif\nendmodule\n", "exit_code": 0, "status": "completed"}}
