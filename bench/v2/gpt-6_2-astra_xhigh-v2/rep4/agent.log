b1;\\\", \\\"else if (row_hit)                buffered_reg <= 1'b1;\\\")\n s=s.replace('if (reset || redirect)\\\\n      read_mode', 'if (reset)\\\\n      read_mode')\n s=s.replace('else if (read_mode == RETRY || (read_mode == FOLLOW && \"'!row_hit))'\"','else if (\"'!redirect && (read_mode == RETRY || (read_mode == FOLLOW && !row_hit)))'\"')\n s=s.replace('  logic recovering;','').replace('  logic [31:0] recovered_pc, normal_pc;', '  logic [31:0] normal_pc;').replace('    recovering   <= \"'!reset && redirect;'\"\\\\n    recovered_pc <= redirect_target;\\\\n','')\n return s.replace('recovering ? recovered_pc : normal_pc','redirect ? redirect_target : normal_pc')\ndef eedit(s):\n s=s.replace('  assign redirect_target = taken ? control_target : sequential_pc;', '  wire [31:0] resolved_pc = taken ? control_target : sequential_pc;')\n s=s.replace('reg_q.pc_next       <= redirect_target;', 'reg_q.pc_next       <= resolved_pc;')\n a=s.index('  assign redirect = ');b=s.index(';',a)+1\n old=s[a:b]\n if choice=='atomic':\n  ctl=\\\"  always_ff @(posedge clock) redirect <= \"'!reset && \"+old.split('\"' = ',1)[1]\n elif choice=='split':\n  ctl='''  logic valid_resolve_q, taken_error_q, fall_error_q, unconditional_q, cond_q;\n  always_ff @(posedge clock) begin\n    valid_resolve_q <= \"'!reset && advancing;\n    taken_error_q <= redirect_on_taken;\n    fall_error_q <= redirect_on_fallthrough;\n    unconditional_q <= redirect_always || bad_jalr || link_fault || data_fault;\n    cond_q <= branch_cond;\n  end\n  assign redirect = valid_resolve_q && (unconditional_q || (cond_q ? taken_error_q : fall_error_q));'\"'''\n elif choice=='segments':\n  ctl='''  logic valid_resolve_q, unconditional_q, equal_q, less_q;\n  logic [3:0] recover_q;\n  always_ff @(posedge clock) begin\n    valid_resolve_q <= \"'!reset && advancing;\n    recover_q <= branch_recover;\n    equal_q <= equal;\n    less_q <= less;\n    unconditional_q <= redirect_always || bad_jalr || link_fault || data_fault;\n  end\n  assign redirect = valid_resolve_q && (unconditional_q || (equal_q ? recover_q[0] : recover_q[1]) ||\n                                      (less_q ? recover_q[2] : recover_q[3]));'\"'''\n s=s[:a]+ctl+s[b:]\n return s.replace('  // The fetch snapshot', '  always_ff @(posedge clock) redirect_target <= resolved_pc;\\\\n\\\\n  // The fetch snapshot')\nedit('core.sv',cedit)\nedit('if_stage.sv',fedit)\nedit('ex_stage.sv',eedit)\nPY\npython \\\"\"'$TMPDIR/predictstudy/verify.py\" split split\npython \"$TMPDIR/predictstudy/verify.py\" segments segments byte\npython \"$TMPDIR/predictstudy/verify.py\" atomic atomic\ncat > \"$TMPDIR/predictstudy/cosim.sh\" <<'\"'SH'\nset -e\nscratch_path=\\\"\"'$TMPDIR/predictstudy/$1\"\nRTL_DIR=\"$scratch_path/rtl\" OBJ_DIR=\"$scratch_path/obj\" NRET=1 bash test/cosim/build.sh >\"$scratch_path/cosim.log\" 2>&1\n\"$scratch_path/obj/cosim_sim\" ../../../../bench/programs/coremark.elf 15000000 --bench --istall --dstall >\"$scratch_path/coremark.log\"\ntail -1 \"$scratch_path/coremark.log\"\nSH'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
