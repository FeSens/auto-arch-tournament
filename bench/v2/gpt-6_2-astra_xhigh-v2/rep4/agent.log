  for (int i=0; i<3; i++)\n      collected.cmp_fix[i] = waiting.ctrl.is_branch &&\n          (collected.cmp_take[i] ? bad_direct : waiting.prediction.taken);'\"''')\n # repair uses exact returned load. Key always either unforwarded or ignored.\n edit('core.sv','      if (bypass_rs1_q) id_ex_w.rs1_val <= collected.rs1_val;', '''      if (id_ex_w.use_probe) begin\n        id_ex_w.use_probe <= 0;\n        id_ex_w.cmp_key <= id_ex_w.cmp_key;\n      end\n      if (bypass_rs1_q) id_ex_w.rs1_val <= collected.rs1_val;''')\n # Capture a distinct fallback probe initially rs1, on repair always the load\n edit('core_pkg.sv','logic [31:0] cmp_key;', 'logic [31:0] cmp_key, cmp_probe;')\n edit('id_stage.sv','reg_q.cmp_key <= 0;', 'reg_q.cmp_key <= 0;\\\\n      reg_q.cmp_probe <= 0;')\n edit('core.sv','    collected.cmp_key =', '    collected.cmp_probe = collected.rs1_val;\\\\n    collected.cmp_key =')\n edit('core.sv','id_ex_w.cmp_key <= id_ex_w.cmp_key;', 'id_ex_w.cmp_probe <= mem_wb_value;')\n p=rtl/'ex_stage.sv';s=p.read_text()\n a=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');b=s.index('    branch_taken ',a)\n decl='''  wire [31:0] cmp_key = in.cmp_key;\n  wire [31:0] probe = in.use_probe ? fwd_ex_mem : in.cmp_probe;\n  wire equal_raw = probe == cmp_key;\n  wire lt_raw = probe[31] == cmp_key[31] ? probe[30:0] < cmp_key[30:0] :\n                                           probe[31] == in.cmp_signed;\n  wire same = equal_raw || in.cmp_identical;\n  wire less = \"'!in.cmp_identical && lt_raw;\n  wire greater = !same && !less;\n  wire [2:0] ordering = {greater,less,same};\n  always_comb begin\n    branch_cond = |(in.cmp_take & ordering);\n'\"'''\n # signed comparison high bit expression should be high bit 1 for signed,\n # high bit 0 for unsigned, i.e. probe[31] == signed.\n if 'chunk' in name:\n  j=decl.index('  wire equal_raw');k=decl.index('  wire same',j)\n  decl=decl[:j]+'''  wire [3:0] eq, lt;\n  for (genvar g=0; g<4; g++) begin : g_chunk\n    assign eq[g] =