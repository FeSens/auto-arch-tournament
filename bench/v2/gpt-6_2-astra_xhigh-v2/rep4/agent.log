{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/sched.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil,sys\nroot=Path(os.environ['TMPDIR']);dest=root/sys.argv[1];shutil.copytree('cores/bench/rtl',dest,dirs_exist_ok=True)\ndef edit(f,a,b):\n p=dest/(f+'.sv');s=p.read_text(); assert s.count(a)==1,(f,a);p.write_text(s.replace(a,b))\nedit('core_pkg','logic [31:0] write_data;', 'logic        late_mul;\\\\n    logic [31:0] write_data;')\nedit('core','  assign match_rs1 =','''  wire waiting_mul = waiting.ctrl.alu_op >= ALU_MUL && waiting.ctrl.alu_op <= ALU_MULHSU;\n  wire ex_mul = id_ex_w.valid && id_ex_w.ctrl.alu_op >= ALU_MUL && id_ex_w.ctrl.alu_op <= ALU_MULHSU;\n  logic launch_late_q;\n  wire late_ex = launch_late_q && ex_mul;\n  wire signed [32:0] ex_a,ex_b;\n  logic signed [32:0] bank_a, bank_b;\n  logic [4:0] bank_op;\n  logic bank_low;\n  wire [31:0] product;\n  wire early_ex = \"'!launch_late_q && ex_mul;\n  // Dispatch all consumers in order. A late launch owns the single multiplier port.\n  wire needs_late = late_ex || (id_ex_w.valid && id_ex_w.ctrl.reg_write && (match_rs1 || match_rs2));\n  always_ff @(posedge clock) begin\n    if (!stall_ex) begin\n      launch_late_q <= needs_late;\n      bank_a <= late_ex ? ex_a : $signed({collected.rs1_val[31] && (waiting.ctrl.alu_op == ALU_MULH || waiting.ctrl.alu_op == ALU_MULHSU),collected.rs1_val});\n      bank_b <= late_ex ? ex_b : $signed({collected.rs2_val[31] && waiting.ctrl.alu_op == ALU_MULH,collected.rs2_val});\n      bank_op <= late_ex ? id_ex_w.ctrl.alu_op : waiting.ctrl.alu_op;\n      bank_low <= late_ex ? id_ex_w.ctrl.alu_op == ALU_MUL : waiting.ctrl.alu_op == ALU_MUL;\n    end\n  end\n`ifdef RISCV_FORMAL_ALTOPS\n  multiplier altmul(.op(bank_op),.a(bank_a[31:0]),.b(bank_b[31:0]),.out(product));\n`else\n  wire [63:0] wide_product=bank_a * bank_b;\n  assign product=bank_low ? wide_product[31:0] : wide_product[63:32];\n`endif\n  assign match_rs1 ='\"''')\nedit('core','    .fwd_ex_mem      (ex_mem_w.alu_result)', '''    .early_mul       (early_ex),\n    .late_mul        (late_ex),\n    .product         (product),\n    .ex_a            (ex_a),\n    .ex_b            (ex_b),\n    .fwd_ex_mem      (ex_mem_w.alu_result)''')\nedit('core','    .div_result (div_result),', '    .product    (product),\\\\n    .div_result (div_result),')\nedit('core','id_ex_w.ctrl.mem_read && \"'!load_bypass)'\"', 'id_ex_w.ctrl.mem_read && \"'!load_bypass && !waiting_mul)'\"')\nedit('core','id_ex_w.ctrl.alu_op >= ALU_MUL)),', 'late_ex || id_ex_w.ctrl.alu_op >= ALU_DIV)),')\nedit('ex_stage','  input  logic               load_rs1,','''  input  logic               early_mul,late_mul,\n  input  logic [31:0]        product,\n  output logic signed [32:0] ex_a,ex_b,\n  input  logic               load_rs1,''')\nedit('ex_stage','  // ── ALU operand selection', '''  wire [31:0] late_a=load_rs1 ? mem_load_data : rs1;\n  wire [31:0] late_b=load_rs2 ? mem_load_data : rs2;\n  assign ex_a={late_a[31] && (in.ctrl.alu_op==ALU_MULH || in.ctrl.alu_op==ALU_MULHSU),late_a};\n  assign ex_b={late_b[31] && in.ctrl.alu_op==ALU_MULH,late_b};\n  // ── ALU operand selection''')\nedit('ex_stage','reg_q.alu_result    <= in.ctrl.is_jump ?', 'reg_q.late_mul <= late_mul;\\\\n      reg_q.alu_result    <= early_mul ? product : in.ctrl.is_jump ?')\nedit('mem_stage','input  logic [31:0]        div_result,', 'input  logic [31:0]        product,div_result,')\nedit('mem_stage','''  multiplier u_mul (\n    .op  (in.ctrl.alu_op),\n    .a   (in.rs1_val),\n    .b   (in.rs2_val),\n    .out (mul_result)\n  );''','  assign mul_result = in.late_mul ? product : in.alu_result;')\nPY\npython \\\"\"'$TMPDIR/sched.py\" sched\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
