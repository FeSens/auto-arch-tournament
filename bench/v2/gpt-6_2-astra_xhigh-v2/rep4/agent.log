{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/radix4\"\ncp -a cores/bench/rtl \"$TMPDIR/radix4/rtl\"\npython - <<'\"'PY'\nimport os\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'radix4/rtl/alu.sv'\ns=p.read_text()\ns=s.replace('logic [35:0] quotient_q;', 'logic [31:0] quotient_q;\\\\n  logic [33:0] triple_q;')\nl=s.index('  logic [31:0] remainder_next;')\nr=s.index('  always_ff @(posedge clock) begin', l)\ns=s[:l]+'''  // The first digit depends only on the two leading bits of the dividend.\n  logic [1:0] prefix, first_digit, first_remainder;\n  always_comb begin\n    prefix = quotient_q[31:30];\n    first_digit = 2'b00;\n    first_remainder = prefix;\n    case (divisor_q)\n      32'd0: first_digit = 2'b11;\n      32'd1: begin\n        first_digit = prefix;\n        first_remainder = 2'b00;\n      end\n      32'd2: begin\n        first_digit = {1'b0, prefix[1]};\n        first_remainder = {1'b0, prefix[0]};\n      end\n      32'd3: begin\n        first_digit = {1'b0, &prefix};\n        first_remainder = (&prefix) ? 2'd0 : prefix;\n      end\n      default: ;\n    endcase\n  end\n\n  wire [31:0] residual [0:3];\n  wire [5:0] digits;\n  assign residual[0] = remainder_q;\n  for (genvar j = 0; j < 3; j = j + 1) begin : g_digit\n    wire [33:0] x = {residual[j], quotient_q[31-2*j -: 2]};\n    wire [34:0] d1 = {1'b0, x} - {3'b0, divisor_q};\n    wire [34:0] d2 = {1'b0, x} - {2'b0, divisor_q, 1'b0};\n    wire [34:0] d3 = {1'b0, x} - {1'b0, triple_q};\n    wire use0 = d1[34];\n    wire use1 = \"'!d1[34] && d2[34];\n    wire use2 = !d2[34] && d3[34];\n    wire use3 = !d3[34];\n    assign digits[5-2*j -: 2] = {!d2[34], use1 | use3};\n    assign residual[j+1] = ({32{use0}} & x[31:0]) |\n                           ({32{use1}} & d1[31:0]) |\n                           ({32{use2}} & d2[31:0]) |\n                           ({32{use3}} & d3[31:0]);\n  end\n\n'\"'''+s[r:]\ns=s.replace(\\\"quotient_q  <