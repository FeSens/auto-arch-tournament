{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/r6s1\" && cp -r cores/bench/rtl cores/bench/test \"$TMPDIR/r6s1\" && mkdir -p \"$TMPDIR/r6s1/bench/programs\" && cp -r bench/programs/coremark bench/programs/crt0.S bench/programs/link.ld \"$TMPDIR/r6s1/bench/programs\" && cat > \"$TMPDIR/r6s1/proto.py\" <<'\"'PY'\nimport os, pathlib\nt=pathlib.Path(os.environ['TMPDIR'])/'r6s1'\nsource=pathlib.Path('cores/bench/rtl/alu.sv').read_text()\nstart=source.index('  // EX consumes')\nstop=source.index('\"'`endif'\"',start)\ns='''\n  logic signed_op, neg_a, neg_b, want_rem;\n  logic [31:0] a_abs, b_abs;\n  assign signed_op = op == ALU_DIV || op == ALU_REM;\n  assign want_rem = op == ALU_REM || op == ALU_REMU;\n  assign neg_a = signed_op && a[31];\n  assign neg_b = signed_op && b[31];\n  assign a_abs = neg_a ? -a : a;\n  assign b_abs = neg_b ? -b : b;\n\n  logic [7:0] prefix;\n  always_comb begin\n    case ({b_abs[3:0],a_abs[31:28]})\n'''\nfor d in range(16):\n for n in range(16):\n  q,r=divmod(n,d) if d else (15,n)\n  s+=f\\\"      8'h{d:x}{n:x}: prefix = 8'h{q:x}{r:x};\\\\n\\\"\ns+='''\n      default: prefix = 0;\n    endcase\n  end\n  logic [31:0] d_q;\n  logic [33:0] triple_q;\n  logic [31:0] q_q;\n  logic [27:0] r_q;\n  logic [3:0] tail_q;\n  logic rem_op_q, negate_q;\n\n  logic [7:0] prefix_r;\n  logic [8:0] prefix_diff;\n  logic [3:0] prefix_digit;\n  always_comb begin\n    prefix_r = {4'b0,r_q[3:0]};\n    for (int i=0; i<4; i++) begin\n      prefix_r = {prefix_r[6:0],q_q[31-i]};\n      prefix_diff = {1'b0,prefix_r} - {1'b0,d_q[7:0]};\n      prefix_digit[3-i] = \"'!(|d_q[31:8]) && !prefix_diff[8];\n      if (prefix_digit[3-i]) prefix_r = prefix_diff[7:0];\n    end\n  end\n\n  function automatic [33:0] div_pair(input logic [33:0] t, input logic [31:0] d,\n                                    input logic [33:0] triple);\n    logic [34:0] diff1, diff2, diff3;\n    begin\n      diff1 = {1'\"'b0,t} - {3'b0,d};\n      diff2 = {1'b0,t} - {2'b0,d,1'b0};\n      diff3 = {1'b0,t} - {1'b0,triple};\n      if (\"'!diff3[34]) div_pair = {2'\"'d3,diff3[31:0]};\n      else if (\"'!diff2[34]) div_pair = {2'\"'d2,diff2[31:0]};\n      else if (\"'!diff1[34]) div_pair = {2'\"'d1,diff1[31:0]};\n      else div_pair = {2'd0,t[31:0]};\n    end\n  endfunction\n\n  wire [33:0] pair1 = div_pair({4'b0,r_q,q_q[31:30]},d_q,triple_q);\n  wire [33:0] pair2 = div_pair({pair1[31:0],q_q[29:28]},d_q,triple_q);\n  wire [33:0] tail1 = div_pair({4'b0,r_q,tail_q[3:2]},d_q,triple_q);\n  wire [33:0] tail2 = div_pair({tail1[31:0],tail_q[1:0]},d_q,triple_q);\n\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      q_q <= {a_abs[27:4],4'b0,(|b_abs[31:4] ? 4'b0 : prefix[7:4])};\n      r_q <= {24'b0,(|b_abs[31:4] ? a_abs[31:28] : prefix[3:0])};\n      tail_q <= a_abs[3:0];\n      d_q <= b_abs;\n      rem_op_q <= want_rem;\n      negate_q <= want_rem ? neg_a : ((neg_a \"'^ neg_b) && b!=0);\n    end else if (round_q == 1) begin\n      triple_q <= {2'\"'b0,d_q} + {1'b0,d_q,1'b0};\n      r_q <= {20'b0,prefix_r};\n      q_q <= {q_q[27:0],prefix_digit};\n    end else if (div_busy && \"'!div_done) begin\n      r_q <= pair2[27:0];\n      q_q <= {q_q[27:0],pair1[33:32],pair2[33:32]};\n    end\n  end\n  wire [31:0] magnitude = rem_op_q ? tail2[31:0] : {q_q[27:0],tail1[33:32],tail2[33:32]};\n  assign div_result = negate_q ? -magnitude : magnitude;\n'\"'''\n(t/'rtl/alu.sv').write_text(source[:start]+s+source[stop:])\nPY\npython \\\"\"'$TMPDIR/r6s1/proto.py\" && cat > \"$TMPDIR/r6s1/timing.py\" <<'\"'PY'\nfrom tools.eval import gowin\nfrom pathlib import Path\nimport os,sys,json\nfrom concurrent.futures import ThreadPoolExecutor\nt=Path(os.environ['TMPDIR'])/'r6s1'\ntitle=sys.argv[1]\nopts=[int(i) for i in sys.argv[2:]]\ndef one(o):\n r=gowin.build(Path.cwd(),t/'rtl','fpga/core_bench_si.sv',o,t/title/('p'+str(o)))\n print(json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=len(opts)) as e:\n l