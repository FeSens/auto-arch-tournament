{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor/trace.cpp\" <<'\"'CPP'\n#include <cstdio>\n#include <cstdint>\n#include <vector>\n#include <algorithm>\n#include <array>\nusing std::uint32_t;\nstruct Transfer {uint32_t insn, pc, dst;};\nint main(int argc, char** argv) {\n  FILE* f = fopen(argv[1],\\\"rb\\\");\n  Transfer t;\n  std::vector<Transfer> trace;\n  while (fread(&t,sizeof(t),1,f)==1) trace.push_back(t);\n  for(int n: {32,64,128,256}) {\n    std::vector<uint32_t> tags(n, -1), dst(n);\n    std::vector<int> c(n,1), direct(n,1);\n    std::array<int,3> hit{}, misses{}, cold{}, nall{}, direct_miss{};\n    for(auto [ins,pc,target]: trace) {\n      int i=(pc >> 2) & (n-1);\n      int k = (ins&127)==0x63 ? 0: (ins&127)==0x6f ? 1: 2;\n      bool taken = target \"'!= pc+4;\n      bool btb_hit = tags[i] == pc;\n      bool pred = btb_hit && c[i]>=2;\n      ++nall[k];\n      if (btb_hit) ++hit[k];\n      if (!btb_hit && taken) ++cold[k];\n      if ((pred ? dst[i] : pc+4) != target) ++misses[k];\n      if (taken != (k==1 || (k==0 && direct[i]>=2))) ++direct_miss[k];\n      if(k==0) direct[i]=std::clamp(direct[i]+(taken?1:-1),0,3);\n      if(taken || btb_hit) {\n        if(taken) {\n          tags[i] = pc;\n          dst[i] = target;\n        }\n        c[i] = btb_hit ? std::clamp(c[i]+(taken?1:-1),0,3) : 2;\n      }\n    }\n    printf(\"slots %d'\"\\\\n\\\",n);\n    for(int k: {0,1,2}) printf(\\\" %s operations %d, BTB misses %d, direct misses %d, cold/conflict taken %d\\\\n\\\",k==0?\\\"BR\\\":k==1?\\\"JAL\\\":\\\"JALR\\\",nall[k],misses[k],direct_miss[k],cold[k]);\n  }\n}\nCPP\ng++ -O2 \\\"\"'$TMPDIR/predictor/trace.cpp\" -o \"$TMPDIR/predictor/trace\" && \"$TMPDIR/predictor/trace\" \"$TMPDIR/predictor/branches.bin\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
