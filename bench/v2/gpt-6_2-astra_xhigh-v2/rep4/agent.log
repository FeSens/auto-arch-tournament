{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/digit_experiment.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil, sys\nfrom tools.eval import gowin\n\ndef make_digit(k, s):\n    rtl = s / 'rtl'\n    shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n    alu = rtl/'alu.sv'\n    src = alu.read_text()\n    front = \\\"\\\"\\\"\n\"'`ifndef RISCV_FORMAL_ALTOPS\n  wire signed_op = op == ALU_DIV || op == ALU_REM;\n  wire neg_a = signed_op && a[31];\n  wire neg_b = signed_op && b[31];\n  wire [31:0] dividend = neg_a ? -a : a;\n  wire [31:0] divisor = neg_b ? -b : b;\n  wire [31:0] quotient;\n\"\"\"\n    m = 2**k-1\n    for j in range(1,m+1):\n        if j == 1: expr = \"{\"+str(k)+\"'\"'b0, divisor}\\\"\n        elif j%2 == 0: expr = f'd{j//2} << 1'\n        elif j+1 == 2**((j+1).bit_length()-1):\n            expr = f'(d1 << {(j+1).bit_length()-1}) - d1'\n        else: expr = f'd{1<<(j.bit_length()-1)} + d{j-(1<<(j.bit_length()-1))}'\n        front+=f'  wire [{31+k}:0] d{j} = {expr};\\\\n'\n    count=(32+k-1)//k\n    first_width=32-(count-1)*k\n    for i in range(count):\n        w=first_width+i*k\n        digit_w=first_width if i==0 else k\n        n=2**digit_w-1\n        part=f'dividend[{32-w+digit_w-1}:{32-w}]'\n        inp=part if i==0 else '{rem'+str(i-1)+', '+part+'}'\n        front+=f'  wire [{w-1}:0] t{i} = {inp};\\\\n'\n        for j in range(1,n+1):\n            front+=f\\\"  wire [{w}:0] diff{i}_{j} = {{1'b0,t{i}}} - {{1'b0,d{j}[{w-1}:0]}};\\\\n\\\"\n            front+=f'  wire ge{i}_{j} = \"'!(|d{j}[{31+k}:{w}]) && !diff{i}_{j}[{w}];'\"\\\\n'\n        for j in range(n+1):\n            expr=f'ge{i}_{j}' if j>0 else \\\"1'b1\\\"\n            if j<n: expr+=f' && \"'!ge{i}_{j+1}'\"'\n            front+=f'  wire sel{i}_{j} = {expr};\\\\n'\n        remainders=['(t'+str(i)+' & {'+str(w)+'{sel'+str(i)+'_0}})']+[\n                f'(diff{i}_{j}[{w-1}:0] & '+'{'+str(w)+'{'+f'sel{i}_{j}'+