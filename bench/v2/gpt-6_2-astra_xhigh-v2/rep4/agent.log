{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/ex_stage.sv && rg -n 'if_id_t|reg_q.valid|out.valid|imem_data|EX redirect|.redirect|.hold_mem_wb' cores/bench/rtl/{core_pkg,id_stage,if_stage,core,ex_stage}.sv\"", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// Forwarding select encoding (driven by forward_unit):\n//   00 = ID/EX register value (no forward)\n//   01 = EX/MEM aluResult (instruction immediately ahead in MEM)\n//   10 = MEM/WB result (instruction two ahead, post regfile-write mux)\n//\n// Latency:        1 cycle (EX/MEM register clocked here).\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  output ex_mem_t  out,\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  alu u_alu (\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );\n\n  // ── Branch resolve ───────────────────────────────────────────────\n…[5301 of 8373 chars elided by tools/bench/transcript.py; sha256:8c3c866f637a7a61]…\n/ On flush or redirect, the instruction emitted to ID is forced to NOP\ncores/bench/rtl/if_stage.sv:15://                 EX-stage redirect).\ncores/bench/rtl/if_stage.sv:21:  input  logic              redirect,         // EX has resolved a branch/jump\ncores/bench/rtl/if_stage.sv:22:  input  logic [31:0]       redirect_target,\ncores/bench/rtl/if_stage.sv:24:  input  logic [31:0]       imem_data,\ncores/bench/rtl/if_stage.sv:25:  output if_id_t  out\ncores/bench/rtl/if_stage.sv:34:    next_pc = redirect ? redirect_target : pc + 32'd4;\ncores/bench/rtl/if_stage.sv:38:  // redirect on the same cycle as imem_stall or dmem_stall — without\ncores/bench/rtl/if_stage.sv:39:  // this priority the redirect target would be silently dropped, the\ncores/bench/rtl/if_stage.sv:45:    else if (redirect) pc <= redirect_target;\ncores/bench/rtl/if_stage.sv:53:    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\ncores/bench/rtl/if_stage.sv:54:    out.valid = !(flush || redirect);\ncores/bench/rtl/core_pkg.sv:79:  } if_id_t;\n", "exit_code": 0, "status": "completed"}}
