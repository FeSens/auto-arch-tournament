{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/3df75752/782d65b5/r14-study/variants.py <<'PY'\nimport sys,shutil\nfrom pathlib import Path\nroot=Path(__file__).parent\nwt=Path.cwd()\norig=wt/'cores/bench/rtl'\ndef get(fn): return (orig/fn).read_text()\ndef save(name, changed):\n    d=root/name/'rtl'\n    shutil.copytree(orig,d,dirs_exist_ok=True)\n    for fn,src in changed.items(): (d/fn).write_text(src)\n    return d\n\ndef cmp_variant(name,n=4,fold=True,scheme='flat'):\n    ex=get('ex_stage.sv')\n    top=get('core.sv')\n    w=32//n\n    is_signed=\\\"in.ctrl.branch_op[1] == 1'b0\\\"\n    out=[]\n    for i in range(n):\n        j=i*w\n        out.append(f\\\"  wire eq{i} = rs1[{j} +: {w}] == rs2[{j} +: {w}];\\\")\n        out.append(f\\\"  wire lt{i} = rs1[{j} +: {w}] < rs2[{j} +: {w}];\\\")\n    out.append('  wire eq_all = '+' && '.join(f'eq{i}' for i in range(n))+';')\n    if scheme=='flat':\n        lt=' || '.join('('+' && '.join([f'lt{i}',*(f'eq{j}' for j in range(i+1,n))])+')' for i in range(n))\n    else:\n        def cmp_tree(lo,hi):\n            if lo==hi: return f'lt{lo}'\n            mid=(lo+hi)//2\n            return '('+cmp_tree(mid+1,hi)+' || ('+' && '.join(f'eq{j}' for j in range(mid+1,hi+1))+' && '+cmp_tree(lo,mid)+'))'\n        lt=cmp_tree(0,n-1)\n    out.append(f\\\"  wire lt_unsigned = {lt};\\\")\n    out.append(f\\\"  wire lt_all = ((rs1[31] \"'^ rs2[31]) && ({is_signed})) ? rs1[31] : lt_unsigned;\")\n    out.append('\"'  wire predicate = in.ctrl.branch_op[2] ? lt_all : eq_all;')\n    j=ex.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n    k=ex.index('    branch_taken',j)\n    ex=ex[:j]+'\\\\n'.join(out)+'\\\\n  always_comb begin\\\\n    branch_cond = predicate \"'^ in.ctrl.branch_op[0];'\"\\\\n'+ex[k:]\n    if fold:\n        b='waiting.ctrl.branch_op[0]'\n        top=top.replace('redirect_on_taken_q <= waiting.ctrl.is_branch && bad_direct;',f'redirect_on_