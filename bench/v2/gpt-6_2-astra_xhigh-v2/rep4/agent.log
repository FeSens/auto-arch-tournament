{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictstudy/steer.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nbase=Path(os.environ['TMPDIR'])/'predictstudy';name,origin,mode=sys.argv[1:4]\np=base/name/'rtl';shutil.copytree(base/origin/'rtl',p,dirs_exist_ok=True)\nf=p/'if_stage.sv';s=f.read_text()\na=s.index('  logic recovering;')\nb=s.index('  assign imem_addr',a)\nif mode=='three':\n src='''  logic select_recovery_q, select_hold_q, select_link_q, select_seq_q;\n  logic [31:0] recovery_pc_q, held_pc_q, sequential_pc_q;\n  logic [19:2] link_pc_q;\n  always_ff @(posedge clock) begin\n    recovery_pc_q <= redirect_target;\n    held_pc_q <= pc;\n    sequential_pc_q <= pc + 32'd4;\n    link_pc_q <= prediction.target;\n    select_recovery_q <= \"'!reset && redirect;\n    select_hold_q <= !reset && !redirect && stall;\n    select_link_q <= !reset && !redirect && !stall && prediction.taken;\n    select_seq_q <= !reset && !redirect && !stall && !prediction.taken;\n  end\n  assign pc = (recovery_pc_q & {32{select_recovery_q}}) |\n              (held_pc_q & {32{select_hold_q}}) |\n              ({12'\"'b0, link_pc_q, 2'b0} & {32{select_link_q}}) |\n              (sequential_pc_q & {32{select_seq_q}});\n'''\nelif mode=='row':\n src='''  logic recovering, use_next_q;\n  logic [31:0] recovered_pc, normal_pc;\n  logic [19:2] link_pc;\n  always_ff @(posedge clock) begin\n    recovering   <= \"'!reset && redirect;\n    recovered_pc <= redirect_target;\n    link_pc <= prediction.target;\n    use_next_q <= !reset && !stall && prediction.taken;\n    if (reset) normal_pc <= '\"'0;\n    else normal_pc <= stall ? pc : pc + 32'd4;\n  end\n  assign pc = recovering ? recovered_pc : use_next_q ? {12'b0, link_pc, 2'b0} : normal_pc;\n'''\nelse:\n src='''  logic recovering, pick_replay;\n  logic [31:0] recovered_pc, normal_pc;\n  logic [19:2] replay_pc;\n  always_ff @(posedge clock) begin\n    recovering <= \"