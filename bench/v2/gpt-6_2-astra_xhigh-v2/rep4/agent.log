le\"] == by_pc[pc - 4][\"cycle\"] + 2\n397:    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n417:    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n418:    assert rets[4][\"cycle\"] - rets[3][\"cycle\"] == 2\n425:async def multiply_behind_stalled_load(dut):\n432:    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 6\n433:    assert rets[5][\"cycle\"] - rets[4][\"cycle\"] == 2\n455:    assert [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])] == [1, 8, 9, 2, 1, 3, 1]\n466:async def divide_behind_stalled_load(dut):\n484:    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n485:    assert rets[5][\"cycle\"] - rets[4][\"cycle\"] == 9  # load-use bubble, then seven divide waits\n629:    rets, _ = await _run(dut, program, max_cycles=20)\n732:    # On visit two the older load holds a misprediction in EX for 3 cycles.\n892:        # slot. Lap six replays the replacement with imem stalled.\n","exit_code":0,"status":"completed"}}
