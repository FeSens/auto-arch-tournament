{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/mklate.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os,sys\nt=Path(os.environ['TMPDIR'])\nr=t/sys.argv[1]/'rtl'\nsrc=t/sys.argv[2]/'rtl' if sys.argv[2]\"'!='\"'orig' else Path('cores/bench/rtl')\ncopytree(src,r)\ndef edit(fn,b,a):\n p=r/fn\n s=p.read_text()\n assert s.count(b)==1,(fn,b)\n p.write_text(s.replace(b,a))\n# Keep EX clear of all work on a registered recovery, including younger instruction's BTB/div effects.\nedit('ex_stage.sv','  // ── Operand forwarding','''  logic late_recover_q;\n  logic [31:0] late_pc_q, late_target_q;\n  logic late_taken_q, late_taken_mismatch_q, late_target_bad_q;\n  assign late_recover_q = late_taken_mismatch_q || (late_taken_q && late_target_bad_q);\n  // ── Operand forwarding''')\nedit('ex_stage.sv','assign is_div = in.valid &&','assign is_div = in.valid && \"'!late_recover_q &&'\"')\nedit('ex_stage.sv','assign advancing = in.valid &&','assign advancing = in.valid && \"'!late_recover_q &&'\"')\nedit('ex_stage.sv','  assign redirect_target = taken ? control_target : in.pc + 32\\\\'d4;\\\\n  assign redirect = advancing && (fence_i || taken \"'!= in.prediction.taken ||'\"\\\\n                    (taken && control_target \"'!= {12'\"\\\\'b0, in.prediction.target, 2\\\\'b00}));', '''  wire late_branch = in.ctrl.is_branch && (load_rs1 || load_rs2);\n  logic fast_cond, fast_taken;\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ: fast_cond = rs1 == rs2;\n      BR_BNE: fast_cond = rs1 \"'!= rs2;\n      BR_BLT: fast_cond = $signed(rs1) < $signed(rs2);\n      BR_BGE: fast_cond = $signed(rs1) >= $signed(rs2);\n      BR_BLTU: fast_cond = rs1 < rs2;\n      default: fast_cond = rs1 >= rs2;\n    endcase\n  end\n  wire aligned = control_target[1:0] == 0;\n  assign fast_taken = aligned && ((in.ctrl.is_branch && fast_cond) || in.ctrl.is_jump);\n  wire target_bad = control_target != {12'\"'b0, in.prediction.target, 2'b00};\n  wire fast_recover = advancing && \"'!late_branch && (fence_i || fast_taken != in.prediction.taken ||\n                      (fast_taken && target_bad));\n  always_ff @(posedge clock) begin\n    late_taken_mismatch_q <= !reset && advancing && late_branch && (taken != in.prediction.taken);\n    late_taken_q <= !reset && advancing && late_branch && taken;\n    late_target_bad_q <= target_bad;\n    late_target_q <= control_target;\n    late_pc_q <= in.pc + 32'\"'d4;\n  end\n  assign redirect = late_recover_q || fast_recover;\n  assign redirect_target = late_recover_q ? (late_taken_q ? late_target_q : late_pc_q) :\n                           fast_taken ? control_target : in.pc + 32'd4;''')\nedit('ex_stage.sv','reg_q.pc_next       <= redirect_target;',\\\"reg_q.pc_next       <= taken ? control_target : in.pc + 32'd4;\\\")\np=r/'ex_stage.sv';s=p.read_text()\nif 'else if (div_wait) begin' in s:\n s=s.replace('else if (div_wait) begin','else if (div_wait || late_recover_q) begin')\nelse:\n s=s.replace('reset || (\"'!stall && div_wait)'\"', 'reset || (\"'!stall && (div_wait || late_recover_q))'\"')\np.write_text(s)\n# Register backpressure for real transfers only. On late recovery MEM contains a branch.\nif sys.argv[3]=='payload':\n p=r/'if_stage.sv'\n p.write_text(p.read_text().replace(\\\"imem_ready ? imem_data : hit ? word.instr : 32'h0000_0013\\\",\\\"imem_ready ? imem_data : word.instr\\\"))\nPY\npython \\\"\"'$TMPDIR/mklate.py\" late1 agu1 payload && PYTHONPATH=. python \"$TMPDIR/r9_fpga_probe.py\" late1 1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
