he branch flush costs one bubble at its target.\n256:    assert [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])] == [1, 8, 8, 1, 1, 2, 1]\n270:async def divide_behind_stalled_load(dut):\n271:    # The older load at address 4 must hold EX/MEM while DIVU is in EX.\n272:    # Its release lets DIVU issue with the earlier load's held WB bypass.\n274:        ADDI(2, 0, 5), LW(1, 0, 0), LW(9, 0, 4), DIVU(3, 1, 2),\n275:        LW(8, 0, 8), REMU(4, 8, 3), EBREAK(),\n288:    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n289:    assert rets[5][\"cycle\"] - rets[4][\"cycle\"] == 9  # load-use bubble, then seven divide waits\n409:    rets, _ = await _run(dut, program, max_cycles=20)\n464:    # only from the BTB, including the cycle held for the load-use hazard.\n514:    # On visit two the older load holds a misprediction in EX for 3 cycles.\n579:    # control encodings may use the stored target, including across DIV waits.\n582:                    JALR(3, 0, 0) | (1 << 12), DIV(4, 1, 1), EBREAK()]\n","exit_code":0,"status":"completed"}}
