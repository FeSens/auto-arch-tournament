{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"rg -n -C 3 'timing|fpga:|test:|cosim' Makefile && cat tools/eval/gowin.py\"", "aggregated_output": "1:.PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\n2-.DEFAULT_GOAL := help\n3-\n4-# Resolve OSS CAD Suite path so commands work even when the user hasn't\n--\n50-TARGET ?=\n51-\n52-# Targets that require TARGET=<core_name>.\n53:CORE_TARGETS := lint test cosim cosim-build formal formal-deep fpga next loop\n54-\n55-ifeq ($(strip $(TARGET)),)\n56-  ifneq ($(filter $(MAKECMDGOALS),$(CORE_TARGETS)),)\n--\n76-\t@echo \"Targets (most accept TARGET=<core_name>):\"\n77-\t@echo \"  make lint TARGET=v1     — verilator lint over cores/<TARGET>/rtl/*.sv\"\n78-\t@echo \"  make test TARGET=v1     — cocotb unit tests under cores/<TARGET>/test/\"\n79:\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\n80-\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\n81-\t@echo \"  make formal-deep TARGET=v1 — full formal suite without ALTOPS (slow, bitvector-correct)\"\n82-\t@echo \"  make fpga TARGET=v1     — FPGA fitness eval (Gowin Fmax + CoreMark cycles)\"\n83:\t@echo \"  make timing TARGET=v1   — Gowin Fmax and worst paths (placement option 0)\"\n84-\t@echo \"  make bench              — build selftest + coremark ELFs\"\n85-\t@echo \"  make next TARGET=v1     — one orchestrator round\"\n86-\t@echo \"  make loop TARGET=v1 N=10 — N orchestrator rounds (auto-spawns .worktrees/<TARGET> on branch core-<TARGET>; pass WORKTREE= to opt out)\"\n--\n103-\t  echo \"lint: no source files in $(RTL_DIR)/\"; \\\n104-\tfi\n105-\n106:test:\n107-\tpytest -v $(TEST_DIR)/\n108-\n109-test-infra:\n110-\tpytest -v tools/\n111-\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n113:\tpython3 -m tools.eval.cosim . $(TARGET)\n114-\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n116:\tbash test/cosim/build.sh\n117-\n118-bench/programs/selftest.elf: bench/programs/selftest.S bench/programs/link.ld\n119-\t$(MAKE) -f bench/programs/Makefile bench/programs/selftest.elf\n--\n132-bench:\n133-\t$(MAKE) -f bench/programs/Makefile all\n134-\n135:# FPGA timing and area come from the vendor flow, Gowin EDA\n136-# (tools/eval/gowin\n…[9835 of 12907 chars elided by tools/bench/transcript.py; sha256:d89769538455eb32]…\n:\n            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\n            continue\n        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\n              f\"logic {r['logic']}, registers {r['regs']}, LUT-RAM {r['lutram']}, BSRAM {r['bsram']}, DSP {r['dsp']}\")\n        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\n            print(f\"  path {i}: {p['arrival_ns']} ns, {p['logic_cells']} cells, {p['from']} -> {p['to']}\")\n            print(f\"          through: {' > '.join(p['modules'])}\")\n        print(f\"  full report: {tr}\")\n    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "exit_code": 0, "status": "completed"}}
