{"type": "item.completed", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'COREMARK_SIM_FLAGS|parse_iterations' tools/eval/fpga.py; cat formal/checks_si.cfg | head -120; head -140 formal/run_all.sh; cat cores/bench/test/conftest.py\"", "aggregated_output": "77:COREMARK_SIM_FLAGS = [\"--bench\", \"--istall\", \"--dstall\"]\n83:def parse_iterations(worktree: str) -> int:\n215:            [sim_bin, elf, \"50000000\"] + COREMARK_SIM_FLAGS,\n250:    iterations = parse_iterations(worktree)\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logf\n…[4947 of 8019 chars elided by tools/bench/transcript.py; sha256:4c3e90e902e760d5]…\n logs) left by runs that have ended: the lock\n# file exists, is over 10 minutes old, and nobody holds it. A dir with no\n# lock file (older script versions, or one created a moment ago and not yet\n# locked) is never touched. Bounds disk growth from agents that invoke\n# run_all.sh dozens of times.\nshopt -s nullglob\nif [ -n \"$HAVE_FLOCK\" ]; then\n    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n        [ \"$stale\" = \"$CORE_DIR\" ] && continue\n        lock=\"$stale/.owner.lock\"\n        [ -f \"$lock\" ] || continue\n        [ -n \"$(find \"$lock\" -mmin +10 2>/dev/null)\" ] || continue\n        if flock -n \"$lock\" true 2>/dev/null; then\n            rm -rf \"$stale\"\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n", "exit_code": 0, "status": "completed"}}
