{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '780,1060p' cores/bench/test/test_pipeline.py; rg -n 'def rw|uint32_t rw|marker' test/cosim/main.cpp; cat formal/wrapper_si.sv; cat formal/checks_si.cfg\"", "aggregated_output": "\n@cocotb.test()\nasync def buffered_load_consumer_and_seventeenth_word(dut):\n    # On lap three the bus withholds the entire body and the backedge.\n    body = [ADDI(2, 2, 4), LW(4, 2, 0), ADDI(5, 4, 1), SW(5, 2, 128)]\n    body += [ADDI(6, 6, i) for i in range(1, 12)]\n    body += [ADDI(3, 3, -1), ADDI(7, 7, 23)]\n    program = [ADDI(3, 0, 3), *body, BNE(3, 0, -68), EBREAK()]\n    lap = list(range(4, 76, 4))\n    visits = []\n    warm = []\n\n    def fetch(pc, word):\n        if visits.count(72) >= 2:\n            warm.append(pc)\n            if 4 <= pc <= 72:\n                word = None\n        visits.append(pc)\n        return word\n\n    writes = []\n    rets, _ = await _run(dut, program, {4: 11, 8: 22, 12: 33},\n                         read_waits={12: 4}, fetch=fetch, writes=writes)\n    # One interlock and four dmem holds keep the ADDI buffered. Its\n    # store successor and the rest of the body each issue on one visit.\n    expected = [4, 8] + [12] * 6 + list(range(16, 76, 4))\n    assert warm[:len(expected)] == expected\n    pcs = [0] + lap * 3 + [76]\n    _check_pc_trace(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[p // 4] for p in pcs]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 12] == [12, 23, 34]\n    assert [(r[\"rs1_addr\"], r[\"rs1_rdata\"]) for r in rets if r[\"pc\"] == 12] == [\n        (4, 11), (4, 22), (4, 33)]\n    assert [(r[\"mem_addr\"], r[\"mem_rmask\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 8] == [\n        (4, 15, 11), (8, 15, 22), (12, 15, 33)]\n    assert writes == [(132, 15, 12), (136, 15, 23), (140, 15, 34)]\n    assert not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def successor_replay_across_direction_changes(dut):\n    # Each outcome has two distinct words before the paths rejoin.\n    # Recovery restarts sequential lookahead at the corrected PC.\n    outcomes = [False, True, False, True, True, True, False, False, False, True]\n    program = [\n        ADDI(3, 0, 4 * len(outcomes)), LW(1, 2, 0), BEQ(1, 0, 16),\n        ADDI(5, 5, 3), SW(5, 2, 0x100), JAL(0, 12),\n        ADDI(6, 6, 7), \n…[12520 of 15592 chars elided by tools/bench/transcript.py; sha256:32a027beb790a20a]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
