{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/divstudy/check_pair.py\" <<'\"'PY'\nimport subprocess\nfrom pathlib import Path\nimport os\nroot=Path(os.environ['TMPDIR'])/'divstudy'\ndef check(w):\n lines=['(set-logic QF_BV)']\n def var(name,width):\n  lines.append(f'(declare-fun {name} () (_ BitVec {width}))')\n def define(name,width,expr):\n  lines.append(f'(define-fun {name} () (_ BitVec {width}) {expr})')\n def ext(n,v):\n  return f'((_ zero_extend {n}) {v})'\n def low(n,v):\n  return f'((_ extract {n-1} 0) {v})'\n def bit(n,v):\n  return f'((_ extract {n} {n}) {v})'\n var('r',w);var('d',w);var('digit',2)\n lines.append('(assert (bvult r d))')\n define('x',w+3,ext(1,'(concat r digit)'))\n for k in range(1,4):\n  define(f'm{k}',w+3,f'(bvmul {ext(3,\\\"d\\\")} (_ bv{k} {w+3}))')\n  define(f's{k}',w+3,f'(bvsub x m{k})')\n  define(f'lt{k}',1,bit(w+2,f's{k}'))\n define('out_r',w,low(w,'(ite (= lt2 #b1) (ite (= lt1 #b1) x s1) (ite (= lt3 #b1) s2 s3))'))\n define('out_q',2,'(concat (bvnot lt2) (bvor (bvnot lt3) (bvand lt2 (bvnot lt1))))')\n prev='r'\n for j in (1,0):\n  define(f't{j}',w+1,f'(concat {prev} {bit(j,\\\"digit\\\")})')\n  define(f'q{j}',1,f'(ite (bvuge t{j} {ext(1,\\\"d\\\")}) #b1 #b0)')\n  define(f'r{j}',w,low(w,f'(ite (= q{j} #b1) (bvsub t{j} {ext(1,\\\"d\\\")}) t{j})'))\n  prev=f'r{j}'\n lines+=['(assert (or (distinct out_q (concat q1 q0)) (distinct out_r r0)))','(check-sat)']\n p=root/f'pair{w}.smt2';p.write_text('\\\\n'.join(lines)+'\\\\n')\n r=subprocess.run(['bitwuzla',str(p)],capture_output=True,text=True,timeout=60)\n assert r.stdout.strip()=='unsat', (w,r.stdout,r.stderr)\n print(w,'bits: equivalent',flush=True)\nfor width in (4,11,18): check(width)\nPY\npython \\\"\"'$TMPDIR/divstudy/check_pair.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
