{"type":"item.started","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -c '\nimport os, sys\nfrom pathlib import Path\nfrom tools.eval import gowin\ntmp = Path(os.environ[\\\"TMPDIR\\\"])\nname = sys.argv[1]\noptions = [int(v) for v in sys.argv[2:]]\nruns = gowin.build_all(Path.cwd(), tmp/(\\\"bench-\\\" + name), \\\"fpga/core_bench_si.sv\\\", tmp/(\\\"timing-\\\" + name), options=options)\nfor run in runs:\n    print(run[\\\"place_option\\\"], run.get(\\\"fmax_mhz\\\"), run.get(\\\"logic\\\"), run.get(\\\"regs\\\"), run.get(\\\"critical_paths\\\", [])[:2], run.get(\\\"reason\\\"))\n' compare 0 2\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
