{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '478,880p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\n@cocotb.test()\nasync def btb_replays_both_directions_and_rejects_alias(dut):\n    # The first two branches fall through to the backward JAL. On the\n    # third lap the branch exits to PC 264, which shares PC 8's BTB index.\n    program = [ADDI(1, 0, 3), ADDI(1, 1, -1), BEQ(1, 0, 256),\n               JAL(2, -8), SW(0, 0, 0x70)]\n    program += [NOP()] * (264 // 4 - len(program))\n    program += [ADDI(3, 0, 77), EBREAK()]\n\n    visits = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc in (8, 12) and visits.count(pc) > 1:\n            return None\n        if pc == 264 and visits.count(pc) <= 2:\n            return None\n        return word\n\n    rets, dmem = await _run(dut, program, fetch=fetch)\n    # A replay advances immediately, even on predicted fall-through. An\n    # unavailable colliding address holds until its own word arrives.\n    expected = [0, 4, 8, 12, 16, 4, 8, 12, 4, 8, 12, 264, 264, 264, 268]\n    assert visits[:len(expected)] == expected\n    pcs = [0, 4, 8, 12, 4, 8, 12, 4, 8, 264, 268]\n    _check_pc_trace(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[p // 4] for p in pcs]\n    assert all(r[\"rd_wdata\"] == 16 for r in rets if r[\"pc\"] == 12)\n    assert rets[-2][\"rd_wdata\"] == 77\n    assert not dmem and not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def replayed_branch