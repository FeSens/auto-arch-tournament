corrected_word[15:8]) |\n                          ({8{first_lane[2]}} & corrected_word[23:16]) |\n                          ({8{first_lane[3]}} & corrected_word[31:24]);\n  assign load_data[15:8] = ({8{word_load || (half_load && \"'!in.mem_addr[1])}} & corrected_word[15:8]) |\n                           ({8{half_load && in.mem_addr[1]}} & corrected_word[31:24]);\n  assign load_data[31:16] = {16{word_load}} & corrected_word[31:16];\n\n  // ── MEM/WB register ───────────────────────────────────────────────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '\"'0;\n    end else if (hold_wb) begin\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.wb_value   <= wb_value;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= raw_word;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= store_op ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= load_op ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= in.ctrl;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n\nmodule sign_equivalence(input ex_mem_t in, input logic [31:0] dmem_rdata,retry_word,div_result, input logic early_hit,retry_hit, output logic mismatch);\nex_mem_t checked; logic [31:0] a,b;\nalways_comb begin\nchecked = in;\nfor (int i = 0; i < 4; i++) begin\n        checked.load_sign_lanes[i] = in.ctrl.mem_sext &&\n            ((in.ctrl.mem_width == 0 && in.mem_addr[1:0] == 2'(i)) ||\n             (in.ctrl.mem_width == 1 && i % 2 == 1 && in.mem_addr[1] == 1'(i / 2)));\n      end\nend\nprevious_mem u_old (.in(checked), .dmem_rdata, .early_hit, .retry_hit, .retry_word, .div_result, .wb_value(a));\nmem_stage u_new (.in(checked), .dmem_rdata, .early_hit, .retry_hit, .retry_word, .div_result, .wb_value(b));\nassign mismatch = a \"'!= b;\nendmodule\nHDL_EOF\nhierarchy -top sign_equivalence\nproc\nflatten\nopt\nsat -verify -prove mismatch 0\nYS_EOF'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
