{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv; cat cores/bench/core.yaml'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU with a seven-round, magnitude-partitioned restoring divider.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [10:0] result_sel,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        div_start,   // one issue pulse while idle\n  input  logic        div_accept,  // downstream can capture a completed result\n  output logic        div_busy,\n  output logic        div_last,    // result can transfer on the upcoming edge\n  output logic        div_done,\n  output logic [31:0] div_result,\n  output logic [31:0] out\n);\n\n  // Round seven writes the result on the EX/MEM transfer edge. Enter\n  // the held state only when downstream cannot accept that transfer.\n  logic [3:0] round_q;\n  assign div_busy = round_q != 4'd0;\n  assign div_last = round_q == 4'd7;\n  assign div_done = round_q == 4'd8;\n\n  always_ff @(posedge clock) begin\n    if (reset)                               round_q <= 4'd0;\n    else if (div_start)                      round_q <= 4'd1;\n    else if ((div_last || div_done) && div_accept) round_q <= 4'd0;\n    else if (div_busy && !div_done)          round_q <= round_q + 4'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      case (op)\n        ALU_DIV:  alt_result_q <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: alt_result_q <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  alt_result_q <= (a - b) ^ 32'h8da68fa5;\n        default:  alt_result_q <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n    if (div_last) div_result <= alt_result_q;\n  end\n`else\n  logic [31:0] dividend_abs, divisor_abs, divisor_q, zero_result_q;\n  logic [12:0] triple_small_divisor_q;\n  logic [4:0]  lane_q;\n  logic        want_rem_q, negate_q, zero_q;\n  logic        signed_op, want_rem;\n  logic        negative_a, negative_b;\n  assign signed_op  = op == ALU_DIV || op == ALU_REM;\n  assign want_rem   = op == ALU\n…[6084 of 9156 chars elided by tools/bench/transcript.py; sha256:d4f78bd4d56cbdae]…\nV_FORMAL_ALTOPS\n  logic [31:0] alt_result;\n  always_comb begin\n    case (op)\n      ALU_MUL:    alt_result = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   alt_result = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  alt_result = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: alt_result = (a - b) ^ 32'hecfbe137;\n      default:    alt_result = 32'b0;\n    endcase\n  end\n  assign product = {2{alt_result}};\n`else\n  assign product = $signed({lhs_ext, a}) * $signed({rhs_ext, b});\n`endif\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 85.001\n  lut4: 4813\n  ff: 1927\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-003-r11s2\n  updated: '2026-11-21T21:03:10.017985Z'\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Run the EX ALU, seven-round divider, and multiplier unit tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.result_sel.value = 0\n    dut.div_start.value = 0\n    dut.div_accept.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.result_sel.value = 1 << op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0, previous_result=None):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    if previous_result is not None:\n        # MEM samples this value on the edge that issues the next divide.\n        await Timer(1, \"ns\")\n        assert int(dut.div_result.value) == previous_result & MASK32\n    await _tick(dut)\n    dut.div_start.value = 0\n    # The bypass inputs and opcode can change as soon as issue completes.\n    dut.op.value = ALU_ADD\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n\n    for _ in range(6):\n        assert int(dut.div_busy.value) and not int(dut.div_done.value)\n        assert not int(dut.div_last.value)\n        await _tick(dut)\n\n    assert int(dut.div_busy.value\n…[7194 of 10266 chars elided by tools/bench/transcript.py; sha256:1084c33cc024b1a0]…\n, (a, rng.randrange(-1024, 1024) & MASK32),\n                        (a, rng.randrange(1 << 12, 1 << 24))))\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in vectors:\n            await _check_div(dut, op, a, b, _div_reference(op, a, b))\n\n\n@cocotb.test()\nasync def reset_during_divide(dut):\n    await _setup(dut)\n    dut.op.value = ALU_DIVU\n    dut.a.value = MASK32\n    dut.b.value = 7\n    dut.div_start.value = 1\n    await _tick(dut)\n    dut.div_start.value = 0\n    await _tick(dut)\n    assert int(dut.div_busy.value)\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n    await _check_div(dut, ALU_REM, -10, 3, -1)\n\n\ndef test_alu_runner():\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_multiplier_runner():\n    run_cocotb(toplevel=\"multiplier\", sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_multiplier\")\n", "exit_code": 0, "status": "completed"}}
