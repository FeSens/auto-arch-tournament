{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/3df75752/782d65b5/r14-study/group.py <<'PY'\nimport sys\nfrom variants import *\nfrom tools.eval.gowin import build_all\ndef arith(name,w,kind,place=1):\n    n=(32+w-1)//w\n    d=cmp_variant(name,scheme='tree')\n    a=(d/'alu.sv').read_text()\n    code=['  logic [31:0] sum, difference;']\n    co=''; bo=''\n    for i in range(n):\n        lo=i*w; hi=min(32,lo+w)-1; width=hi-lo+1\n        av=f'a[{hi}:{lo}]'; bv=f'b[{hi}:{lo}]'\n        code+= [f'  wire pg{i} = &({av} \"'^ {bv});'\"',f'  wire eq{i} = {av} == {bv};']\n        for op,pref,pr,sign in [('>','c','pg','+'),('<','z','eq','-')]:\n            cmp=f'(~{bv})' if pref=='c' else bv\n            code+=[f'  wire {pref}g{i} = {av} {op} {cmp};']\n            carry=''\n            if i>0: \n                if kind=='flat':\n                    flag=' || '.join('('+' && '.join([f'{pref}g{j}',*(f'{pr}{k}' for k in range(j+1,i))])+')' for j in range(i))\n                else:\n                    flag=f'{pref}g{i-1}'+(f' || ({pr}{i-1} && {pref}{i-1})' if i>1 else '')\n                code.append(f'  wire {pref}{i} = {flag};')\n                carry=f\\\" {sign} {width}'({pref}{i})\\\"\n            dst='sum' if pref=='c' else 'difference'\n            code.append(f'  assign {dst}[{hi}:{lo}] = {av} {sign} {bv}{carry};')\n    code+=['  wire ult = zg'+str(n-1)+' || (eq'+str(n-1)+' && z'+str(n-1)+');','  wire slt = (a[31] \"'!= b[31]) ? a[31] : ult;'\"']\n    ix=a.index('  assign out =')\n    a=a[:ix]+'\\\\n'.join(code)+'\\\\n'+a[ix:].replace('& (a + b))','& sum)').replace('& (a - b))','& difference)').replace('\"'$signed(a) < $signed(b)'\"','slt').replace(', a < b}',', ult}')\n    (d/'alu.sv').write_text(a)\n    return d\nif __name__=='__main__':\n    name,w,kind,*opts=sys.argv[1:]\n    d=arith(name,int(w),kind)\n    print(build_all(wt,d,'fpga/core_bench_si.sv',root/name,options=list(map(int,opts)) or [1])