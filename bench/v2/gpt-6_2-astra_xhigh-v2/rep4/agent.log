{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"cat tools/eval/_slots.py; rg -n 'hypothes' .gitignore; ls -ld /tmp; printenv TMPDIR\"","aggregated_output":"\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n29:# (since the orchestrator never `git add`s it), and the hypothesis-phase\n30:# sandbox check in tools/agents/hypothesis.py rolls back the next slot's\n33:# every rep was hypothesis_gen_failed for this reason.\n37:# and per-hypothesis by tools/agents/hypothesis.py for `tail -f` visibility\n74:#   iteration (accept/regression/broken). Rejected hypotheses never\n80:# - per-iteration worktrees and per-iteration hypothesis YAMLs are\n88:cores/*/experiments/hypotheses/\n89:cores/*/experiments/hypotheses/*.yml\n90:cores/*/experiments/hypotheses/*.yaml\ndrwxrwxrwt 162 nobody nogroup 3300 Nov 21 14:12 /tmp\n/srv/hwebench/tmp/3df75752/a384a154\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil, os\nfrom tools.eval import gowin\nscratch = Path(os.environ['TMPDIR']) / 'radix4'\nscratch.mkdir(exist_ok=True)\nrtl = scratch / 'rtl'\nshutil.copytree('cores/bench/rtl', rtl, dirs_exist_ok=True)\np = rtl / 'alu.sv'\ns = p.read_text()\ni = s.index('  always_comb begin')\ns = s[:i] + \\\"\\\"\\\"\"'`ifndef RISCV_FORMAL_ALTOPS\n  wire signed_op = op == ALU_DIV || op == ALU_REM;\n  wire neg_a = signed_op && a[31];\n  wire neg_b = signed_op && b[31];\n  wire [31:0] dividend = neg_a ? -a : a;\n  wire [31:0] divisor = neg_b ? -b : b;\n  wire [33:0] d1 = {2'\"'b0, divisor};\n  wire [33:0] d2 = {1'b0, divisor, 1'b0};\n  wire [33:0] d3 = d1 + d2;\n  wire [31:0] quotient;\n  for (genvar i = 0; i < 16; i = i + 1) begin : digits\n    localparam W = 2*(i+1);\n    wire [W-1:0] trial;\n    if (i == 0)\n      assign trial = dividend[31:30];\n    else\n      assign trial = {digits[i-1].remainder, dividend[31-2*i -: 2]};\n    wire [W:0] sub1 = {1'b0,trial} - {1'b0,d1[W-1:0]};\n    wire [W:0] sub2 = {1'b0,trial} - {1'b0,d2[W-1:0]};\n    wire [W:0] sub3 = {1'b0,trial} - {1'b0,d3[W-1:0]};\n    wire fits1 = \"'!(|d1[33:W]) && !sub1[W];\n    wire fits2 = !(|d2[33:W]) && !sub2[W];\n    wire fits3 = !(|d3[33:W]) && !sub3[W];\n    wire sel1 = fits1 && !fits2;\n    wire sel2 = fits2 && !fits3;\n    wire [W-1:0] remainder = (trial & {W{!fits1}})\n                           | (sub1[W-1:0] & {W{sel1}})\n                           | (sub2[W-1:0] & {W{sel2}})\n                           | (sub3[W-1:0] & {W{fits3}});\n    assign quotient[31-2*i -: 2] = {fits2, fits3 || sel1};\n  end\n  wire want_r = op == ALU_REM || op == ALU_REMU;\n  wire [31:0] magnitude = want_r ? digits[15].remainder : quotient;\n  wire negate = want_r ? neg_a : neg_a ''^ neg_b;\n  wire [31:0] division_result = (b == 0) ? (want_r ? a : 32'\"'hffffffff)\n                                         : (negate ? -magnitude : magnitude);\n\"'`endif\n\n\"\"\" + s[i:]\ni = s.index('\"'      ALU_DIV: begin')\nj = s.index('\"'`endif'\"', i)\ns = s[:i] + '      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = division_result;\\\\n' + s[j:]\np.write_text(s)\nres = gowin.build_all(Path.cwd(), rtl, 'fpga/core_bench_si.sv', scratch, options=gowin.PLACE_OPTIONS)\nprint(gowin.summarize(res))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
