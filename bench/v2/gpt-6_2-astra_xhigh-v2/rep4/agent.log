{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"rg -n 'redirect|mispredict|misalign|three clocks|gap' cores/bench/test/test_pipeline.py | tail -90\"","aggregated_output":"382:async def misaligned_load_preserves_older_writer(dut):\n410:    # pointer makes LH misaligned, leaving x1 at the pointer value.\n428:    for pc, gap in [(12, 2), (28, 3), (44, 3), (52, 3)]:\n429:        assert by_pc[pc][\"cycle\"] == by_pc[pc - 4][\"cycle\"] + gap\n436:async def misaligned_load_behind_stalled_load(dut):\n501:    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n502:    assert gaps == [1, 1, 1, 2, 1, 2, 1, 1, 1, 1]\n566:async def consecutive_divides_and_redirect(dut):\n580:    # and two bubbles for the branch redirect.\n615:async def redirect_over_two_stores(dut):\n762:    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n857:    # The dispatch at PC 12 visits 32, 64, 32 and then a misaligned 34.\n858:    # On visit two the older load holds a misprediction in EX for 3 cycles.\n873:            return None  # expose a buffered store leaking across the redirect\n1148:    # The JALR at 4 first targets a store, then redirects to 64. A JAL\n1149:    # at 260 redirects to a second cold address.\n1340:    for gap in range(4):\n1341:        value = 50 + gap\n1342:        program += [ADDI(2, 0, value), SW(2, 0, 0x100)] + [NOP()]*gap\n1346:        if gap < 2:\n1354:    for gap, i in enumerate(loads):\n1355:        value = 50 + gap\n1358:        assert rets[i+1][\"cycle\"] == rets[i][\"cycle\"] + (2 if gap < 3 else 1)\n","exit_code":0,"status":"completed"}}
