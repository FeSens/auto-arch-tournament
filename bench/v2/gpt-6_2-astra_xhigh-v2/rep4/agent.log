{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/probe/warm.S\" <<'\"'EOF'\n.section .text\n.globl _start\n_start:\n  li s0, 0x10000\n  li s1, 0x12000\n  li s2, 123\n  li s3, 3\nphase:\n  li t0, 1200\n  mv t1, s0\nwrite:\n  sw s2, 0(t1)\n  addi t1, t1, 4\n  andi t2, t0, 63\n  bnez t2, same\n  mv t1, s0\nsame:\n  addi t0, t0, -1\n  bnez t0, write\n  addi t2, s0, 64\n  sw t2, 0(s0)\n  la t4, func\n  addi t4, t4, 1\n  sw t4, 4(s0)\n  li t0, 70\nread:\n  lw t1, 0(s0)\n  lw t3, 0(t1)\n  add t5, t3, t3\n  sh t5, 2(t1)\n  lh t6, 2(t1)\n  add t5, t6, t3\n  lw t4, 4(s0)\n  jalr ra, -1(t4)\n  addi t0, t0, -1\n  bnez t0, read\n  mv t1, s1\n  mv s1, s0\n  mv s0, t1\n  addi s3, s3, -1\n  bnez s3, phase\n  ebreak\nfunc:\n  xor s2, s2, t5\n  ret\nEOF\nriscv32-unknown-elf-gcc -march=rv32im -mabi=ilp32 -static -nostartfiles -T bench/programs/link.ld \\\"\"'$TMPDIR/probe/warm.S\" -o \"$TMPDIR/probe/warm.elf\" && python \"$TMPDIR/probe/check.py\" warm\npython - <<'\"'PY'\nimport json,yaml,jsonschema\nfrom pathlib import Path\np=Path('cores/bench/experiments/hypotheses/hyp-20261121-003-r11s2.yaml')\nh=yaml.safe_load(p.read_text());jsonschema.validate(h,json.load(open('schemas/hypothesis.schema.json')))\nassert h['id']==p.stem and h['category']=='predictor'\nprint('Schema valid')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
