{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/3df75752/782d65b5/r14-study/split.py <<'PY'\nfrom variants import *\nfrom tools.eval.gowin import build_all\ndef split(name,w,mode,base):\n    d=save(name,{})\n    if base\"'!='\"'orig': shutil.copytree(root/base/'rtl',d,dirs_exist_ok=True)\n    a=(d/'alu.sv').read_text()\n    i=a.index('  assign out =')\n    u=''\n    for tag,op,c in [('s','+','>'),('d','-','<')]:\n        low=f\\\"a[{w-1}:0]\\\"; blo=low.replace('a','b')\n        hi=f\\\"a[31:{w}]\\\";bhi=hi.replace('a','b')\n        cmp=f'({low} {c} '+(f'~{blo})' if tag=='s' else f'{blo})')\n        if mode=='inverse':\n            with_c=f'~((~{hi}) + (~{bhi}))' if tag=='s' else f'~({bhi} - {hi})'\n        else:\n            with_c=f\\\"({hi} {op} {bhi} {op} {32-w}'d1)\\\"\n        u+=f\\\"  wire [{31-w}:0] {tag}_hi = {cmp} ? {with_c} : ({hi} {op} {bhi});\\\\n\\\"\n        u+=f\\\"  wire [31:0] {tag}_out = {{{tag}_hi, {low} {op} {blo}}};\\\\n\\\"\n    a=a[:i]+u+a[i:].replace('& (a + b))','& s_out)').replace('& (a - b))','& d_out)')\n    (d/'alu.sv').write_text(a)\n    return d\nif __name__=='__main__':\n    name,w,mode,base,*opts=sys.argv[1:]\n    d=split(name,int(w),mode,base)\n    print(build_all(wt,d,'fpga/core_bench_si.sv',root/name,options=list(map(int,opts)) or [1]),flush=True)\nPY\nPYTHONPATH=. python3 /srv/hwebench/tmp/3df75752/782d65b5/r14-study/split.py split16 16 inverse byte 1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
