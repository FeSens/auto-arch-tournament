mption (rvfi_valid_1=1) is unsatisfiable, and SBY\n        # reports Status: PREUNSAT (rc=16). The property holds vacuously\n        # over the empty set of ch1-valid traces — a legitimate pass.\n        # Dual-issue hypotheses make the assumption satisfiable, so this\n        # branch never matches and the regular DONE (PASS branch covers it.\n        PASS=$((PASS+1))\n    else\n        FAIL=$\n…[1048 of 4120 chars elided by tools/bench/transcript.py; sha256:5abc5c40baac54e3]…\nad for the first PC=0 fetch.\n    dut.reset.value = 0\n    drive_fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        if pending_read is not None:\n            assert ren and not wen and da == pending_read, \"stalled load was lost\"\n        read_stall = ren and waits.get(da, 0) > 0\n        pending_read = da if read_stall else None\n        if read_stall:\n            waits[da] -= 1\n        dut.io_dmemReady.value = int(not read_stall)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            if writes is not None:\n                writes.append((da, wen, wdata))\n            wa = da & ~3\n", "exit_code": 0, "status": "completed"}}
