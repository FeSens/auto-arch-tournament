always_comb begin\n    alu_a = (in.ctrl.is_auipc ? in.pc : in.rs1_val) | ({32{bypass_alu_a}} & fwd_ex_mem);\n    alu_b = (in.ctrl.alu_src ? in.imm : in.rs2_val) | ({32{bypass_alu_b}} & fwd_ex_mem);\n  end\n\n  logic [31:0] alu_result;\n  logic [63:0] product;\n  logic [31:0] div_rs1_q, div_rs2_q;\n  logic   \n…[11653 of 14725 chars elided by tools/bench/transcript.py; sha256:ab92c884af76ed73]…\niting.ctrl.is_jump && bad_direct) ||\n                           (!waiting.ctrl.is_jump && !waiting.ctrl.is_branch && waiting.prediction.taken) ||\n                           (waiting.instr[6:0] == 7'h0f && waiting.instr[14:12] == 1);\n    end else if (repair && !mem_wait) begin\n      if (bypass_rs1_q) id_ex_w.rs1_val <= collected.rs1_val;\n      if (bypass_rs2_q) id_ex_w.rs2_val <= collected.rs2_val;\n      bypass_rs1_q <= 1'b0;\n      bypass_rs2_q <= 1'b0;\n      bypass_alu_a_q <= 1'b0;\n      bypass_alu_b_q <= 1'b0;\n    end\n    if (!mem_wait)\n      check_load_q <= !stall_ex && id_ex_w.ctrl.mem_read && (adjacent_rs1 || adjacent_rs2);\n    if (reset || redirect || (!stall_ex && result_hazard))\n      id_ex_w.valid <= 1'b0;\n  end\n\n  // ── EX ────────────────────────────────────────────────────────────────\n  ex_stage u_ex (\n    .clock           (clock),\n    .reset           (reset),\n    .stall           (mem_wait),\n    .in              (id_ex_w),\n    .bypass_rs1      (bypass_rs1_q),\n    .bypass_rs2      (bypass_rs2_q),\n", "exit_code": 0, "status": "completed"}}
