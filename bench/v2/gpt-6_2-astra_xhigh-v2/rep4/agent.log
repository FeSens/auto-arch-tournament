12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >\n…[2431 of 5503 chars elided by tools/bench/transcript.py; sha256:c6ff1da991eaad6d]…\n where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    waits = dict(read_waits or {})\n    store_waits = dict(write_waits or {})\n    pending_request = None\n    retirements: list[dict] = []\n\n    def drive_fetch(pc):\n        word = imem.get(pc, EBREAK())\n        if fetch is not None:\n            word = fetch(pc, word)\n        dut.io_imemReady.value = int(word is not None)\n        dut.io_imemData.value = word if word is not None else SW(0, 0, 0x70)\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n__init__.py\n__pycache__\n_slots.py\n_subprocess.py\ncosim.py\nformal.py\nfpga.py\ngowin.py\nholdout.py\nrvfi_lint.py\ntest_bench_stall_gen.py\ntest_formal_nret.py\ntest_formal_reclassify.py\ntest_formal_workdir_cleanup.py\ntest_fpga_report.py\ntest_gate_sanity.py\ntest_holdout.py\ntest_process_reaper.py\ntest_remove_path.py\ntest_rvfi_lint.py\ntest_slots.py\ntest_subprocess_pgroup.py\n", "exit_code": 0, "status": "completed"}}
