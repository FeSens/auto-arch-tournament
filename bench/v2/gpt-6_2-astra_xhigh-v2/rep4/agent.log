{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os, shutil\ntmp = Path(os.environ['TMPDIR'])\nrtl = tmp / 'predictor-prototype-rtl'\nshutil.copytree('cores/bench/rtl', rtl)\ndef change(name, old, new, count=1):\n    p = rtl / name\n    s = p.read_text()\n    assert s.count(old) == count, (name,old,s.count(old))\n    p.write_text(s.replace(old, new))\nfor t in ['if_id_t','id_ex_t']:\n    change('core_pkg.sv', '  } '+t+';', '    logic predicted_taken;\\\\n    logic [1:0] bht_snapshot;\\\\n  } '+t+';')\nchange('id_stage.sv','      reg_q.pc       <= in.pc;', '''      reg_q.predicted_taken <= in.predicted_taken;\n      reg_q.bht_snapshot    <= in.bht_snapshot;\n      reg_q.pc       <= in.pc;''')\nchange('core.sv', '  // EX redirect','''  logic train_en;\n  logic [4:0] train_index;\n  logic [1:0] train_data;\n\n  // EX redirect''')\nchange('core.sv', '    .redirect        (redirect),','''    .train_en        (train_en),\n    .train_index     (train_index),\n    .train_data      (train_data),\n    .redirect        (redirect),''', 2)\nchange('ex_stage.sv', '  output logic               redirect,', '''  output logic               train_en,\n  output logic [4:0]         train_index,\n  output logic [1:0]         train_data,\n  output logic               redirect,''')\nchange('ex_stage.sv', '''  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;'\"''','''  logic actual_taken;\n  assign actual_taken = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect = in.valid && !stall && (actual_taken != in.predicted_taken);\n  assign redirect_target = in.predicted_taken ? in.pc + 32'\"'d4\n                             : in.ctrl.is_jump ? jump_target : branch_target;\n  assign train_en = in.valid && \"'!stall && in.ctrl.is_branch && !misalign_fault;\n  assign train_index = in.pc[6:2];\n  assign train_data = branch_taken\n       ? (in.bht_snapshot == 2'\"'d3 ? 2'd3 : in.bht_snapshot + 2'd1)\n       : (in.bht_snapshot == 2'd0 ? 2'd0 : in.bht_snapshot - 2'd1);''')\nchange('if_stage.sv','  output if_id_t  out','''  input  logic              train_en,\n  input  logic [4:0]        train_index,\n  input  logic [1:0]        train_data,\n  output if_id_t  out''')\nchange('if_stage.sv', '''  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end''','''  logic [1:0] counters [0:31];\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 32; i++) counters[i] <= 2'd1;\n    end else if (train_en) begin\n      counters[train_index] <= train_data;\n    end\n  end\n\n  logic [1:0] counter;\n  logic is_branch, is_jal, predicted_taken;\n  logic [31:0] displacement, target;\n  assign counter = counters[pc[6:2]];\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] \"'!= 2'\"'b01;\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign displacement = is_jal\n     ? {{12{imem_data[31]}},imem_data[19:12],imem_data[20],imem_data[30:21],1'b0}\n     : {{20{imem_data[31]}},imem_data[7],imem_data[30:25],imem_data[11:8],1'b0};\n  assign target = pc + displacement;\n  assign predicted_taken = (is_jal || (is_branch && counter[1])) &&\n                           target[1:0] == 2'b00 && target[31:20] == 12'b0;\n  assign next_pc = predicted_taken ? target : pc + 32'd4;''')\nchange('if_stage.sv','    out.pc    = pc;', '''    out.bht_snapshot = counter;\n    out.predicted_taken = predicted_taken;\n    out.pc    = pc;''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
