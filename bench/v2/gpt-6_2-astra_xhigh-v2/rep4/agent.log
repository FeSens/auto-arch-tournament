d_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 2'd2;\n    else                                                                  fwd_rs2 = 2'd0;\n  \n…[4491 of 7563 chars elided by tools/bench/transcript.py; sha256:5ce3c09cd20a40e6]…\n        remainder_q <= remainder_next;\n        quotient_q  <= quotient_next;\n      end\n    end\n\n    assign selected_quotient[lane]  = 32'(quotient_next)  & {32{lane_q[lane]}};\n    assign selected_remainder[lane] = 32'(remainder_next) & {32{lane_q[lane]}};\n  end\n\n  logic [31:0] quotient_q, remainder_q, magnitude;\n  always_ff @(posedge clock) begin\n    if (div_last) begin\n      quotient_q  <= selected_quotient[0]  | selected_quotient[1]  | selected_quotient[2] |\n                     selected_quotient[3]  | selected_quotient[4];\n      remainder_q <= selected_remainder[0] | selected_remainder[1] | selected_remainder[2] |\n                     selected_remainder[3] | selected_remainder[4];\n    end\n  end\n\n  // MEM reads the held state even after div_accept. MEM/WB samples this\n  // result on or before the edge that initializes the next divide.\n  assign magnitude  = want_rem_q ? remainder_q : quotient_q;\n  assign div_result = zero_q ? zero_result_q : (negate_q ? -magnitude : magnitude);\n`endif\n\n  logic [4:0] shamt;\n\n", "exit_code": 0, "status": "completed"}}
