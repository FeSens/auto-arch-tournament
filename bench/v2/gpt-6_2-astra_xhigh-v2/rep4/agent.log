{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -c 'diff -u cores/bench/rtl/forward_unit.sv \"$TMPDIR/rtl-initial/forward_unit.sv\"'","aggregated_output":"--- cores/bench/rtl/forward_unit.sv\t2026-11-21 18:40:55.409268221 +0100\n+++ /srv/hwebench/tmp/3df75752/ab242c26/rtl-initial/forward_unit.sv\t2026-11-21 18:34:03.041779726 +0100\n@@ -1,28 +1,33 @@\n-// Track one decoded source across the issue edge. ex_writes is the\n-// write permission being clocked into EX/MEM on that same edge.\n+// Track one decoded source across the issue edge. The older choices are\n+// already mutually exclusive. The youngest writer can still lose its\n+// write permission on a control transfer or a misaligned load.\n module forward_unit (\n   input  logic         clock,\n   input  logic         stall_id,\n   input  logic [4:0]   rs,\n   input  logic         rf_written,\n   input  logic [4:0]   ex_rd,\n-  input  logic         ex_writes,\n   input  logic [4:0]   mem_rd,\n   input  logic         mem_writes,\n   input  logic [4:0]   wb_rd,\n   input  logic         wb_writes,\n   output operand_sel_t sel\n );\n-  wire match_ex  = ex_writes && ex_rd != 0 && rs == ex_rd;\n   wire match_mem = mem_writes && mem_rd != 0 && rs == mem_rd;\n   wire match_wb  = wb_writes && wb_rd != 0 && rs == wb_rd;\n \n+  operand_sel_t issued;\n   always_ff @(posedge clock) begin\n     if (!stall_id) begin\n-      sel.ex_mem   <= match_ex;\n-      sel.mem_wb   <= !match_ex && match_mem;\n-      sel.issue_wb <= !match_ex && !match_mem && match_wb;\n-      sel.raw_rf   <= !match_ex && !match_mem && !match_wb && rf_written;\n+      issued.ex_mem   <= ex_rd != 0 && rs == ex_rd;\n+      issued.mem_wb   <= match_mem;\n+      issued.issue_wb <= !match_mem && match_wb;\n+      issued.raw_rf   <= !match_mem && !match_wb && rf_written;\n     end\n   end\n+\n+  assign sel.ex_mem   = issued.ex_mem && mem_writes;\n+  assign sel.mem_wb   = issued.mem_wb   && !sel.ex_mem;\n+  assign 