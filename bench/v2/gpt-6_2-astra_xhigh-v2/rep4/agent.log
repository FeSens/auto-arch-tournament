{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"sed -n '430,757p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def btb_replays_both_directions_and_rejects_alias(dut):\n    # The first two branches fall through to the backward JAL. On the\n    # third lap the branch exits to PC 264, which shares PC 8's BTB index.\n    program = [ADDI(1, 0, 3), ADDI(1, 1, -1), BEQ(1, 0, 256),\n               JAL(2, -8), SW(0, 0, 0x70)]\n    program += [NOP()] * (264 // 4 - len(program))\n    program += [ADDI(3, 0, 77), EBREAK()]\n\n    visits = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc in (8, 12) and visits.count(pc) > 1:\n            return None\n        if pc == 264 and visits.count(pc) <= 2:\n            return None\n        return word\n\n    rets, dmem = await _run(dut, program, fetch=fetch)\n    # A replay advances immediately, even on predicted fall-through. An\n    # unavailable colliding address holds until its own word arrives.\n    expected = [0, 4, 8, 12, 16, 4, 8, 12, 4, 8, 12, 264, 264, 264, 268]\n    assert visits[:len(expected)] == expected\n    pcs = [0, 4, 8, 12, 4, 8, 12, 4, 8, 264, 268]\n    _check_pc_trace(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[p // 4] for p in pcs]\n    assert all(r[\"rd_wdata\"] == 16 for r in rets if r[\"pc\"] == 12)\n    assert rets[-2][\"rd_wdata\"] == 77\n    assert not dmem and not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def replayed_branch_interlocks_with_load_and_saturates(dut):\n    # Each LW drives the following BEQ. Once trained, BEQ is available\n    # only from the BTB, including the cycle held for the load-use hazard.\n    outcomes = [True, True, True, False, False, False, False, True, True, True]\n    program = [ADDI(3, 0, 4 * len(outcomes)), LW(1, 2, 0), BEQ(1, 0, 12),\n               JAL(0, 8), NOP(), ADDI(2, 2, 4), BNE(2, 3, -20), EBREAK()]\n    dmem = {4 * i: int(not taken) for i, taken in enumerate(outcomes)}\n    visits = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        return None if pc == 8 and visits.count(8) > 2 else word\n\n    rets, _ = await _run(dut, program, dmem, fetch=fetch)\n    fetch_indices = [i for i, pc in enumerate(visits) i\n…[10322 of 13394 chars elided by tools/bench/transcript.py; sha256:45b201e808d5d97a]…\nc + 4]\n    pcs = [0, 4, 32, 36, 40, 4, 64, 68, 260, 320, 324]\n    _check_pc_trace(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[p // 4] for p in pcs]\n    assert writes == [(128, 15, 8)]\n    assert not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def fence_i_invalidates_successor_words(dut):\n    program = [ADDI(1, 0, 2), JAL(0, 12), 0x0000100f, JAL(0, -8),\n               ADDI(2, 0, 11), ADDI(1, 1, -1), BNE(1, 0, -16), EBREAK()]\n    replacement = ADDI(2, 0, 55)\n    visits = []\n    refetch = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if visits.count(4) == 2:\n            refetch.append(pc)\n            if pc == 16:\n                return None if refetch.count(16) <= 4 else replacement\n        return word\n\n    rets, _ = await _run(dut, program, fetch=fetch)\n    i = refetch.index(16)\n    assert refetch[i:i + 6] == [16] * 5 + [20]\n    _check_pc_trace(rets, [0, 4, 16, 20, 24, 8, 12, 4, 16, 20, 24, 28])\n    assert [(r[\"insn\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 16] == [\n", "exit_code": 0, "status": "completed"}}
