{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/core.yaml; cat cores/bench/rtl/if_stage.sv; cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "name: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 43.402\n  lut4: 2985\n  ff: 669\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-003-r2s2\n  updated: '2026-11-21T14:02:16.843471Z'\n// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (PC, instruction, prediction and validity) is combinational. The ID/EX\n// register captures the bundle when decode accepts the fetch.\n//\n// A BTB hit supplies a previously resolved instruction during an imem\n// wait. An available external word always wins. ID captures a bubble on\n// recovery or when neither source has an instruction.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              redirect,\n  input  logic [31:0]       redirect_target,\n  input  btb_update_t       update,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [5:0]  index;\n  logic [63:0] valid;\n  logic [11:0] tags [0:63];\n  logic [19:2] targets [0:63];\n  logic [31:0] words [0:63];\n  logic [1:0]  counters [0:63];\n  logic        external_control;\n  prediction_t prediction;\n\n  assign index = pc[7:2];\n  always_ff @(posedge clock) begin\n    if (reset || update.invalidate) valid <= '0;\n    else if (update.write)          valid[update.pc[7:2]] <= 1'b1;\n  end\n\n  // Only the valid \n…[7855 of 10927 chars elided by tools/bench/transcript.py; sha256:df43e34e74497ee5]…\ng_q;\n    end else if (div_wait) begin\n      reg_q <= '0;\n    end else begin\n      reg_q.pc            <= in.pc;\n      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n      // sum (which is the jump target). The MEM/WB register's read-data\n      // mux only kicks in for LOADs, so we route PC+4 here.\n      reg_q.alu_result    <= div_done ? div_result :\n                             in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_done ? div_rs1_q : rs1;\n      reg_q.rs2_val       <= div_done ? div_rs2_q : rs2;\n      reg_q.pc_next       <= redirect_target;\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
