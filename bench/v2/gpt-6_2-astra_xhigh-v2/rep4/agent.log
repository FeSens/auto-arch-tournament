      default: ex_load_mask = 4'b1111;\n    endcase\n  end\n\n  assign redirect_target = taken ? control_target : in.pc + 32'd4;\n  assign redirect = advancing && (fence_i || taken \"'!= in.prediction.taken ||\n                    (taken && control_target != {12'\"'b0, in.prediction.target, 2'b00}));\n\n  // The fetch snapshot belongs to this instruction even if another source\n  // has since replaced its entry. Write the tag, word and target together.\n  logic ram_pc;\n  assign ram_pc = in.pc[31:20] == 0 && in.pc[1:0] == 0;\n  assign update.invalidate = advancing && fence_i;\n  assign update.successor = advancing && ram_pc && \"'!in.ctrl.is_illegal &&\n                            !in.ctrl.is_branch && !in.ctrl.is_jump && !fence_i;\n  assign update.write = advancing && (in.ctrl.is_branch || in.ctrl.is_jump) &&\n                        !in.ctrl.is_illegal && ram_pc &&\n                        control_target[31:20] == 0 && control_target[1:0] == 0;\n  assign update.pc     = in.pc[19:2];\n  assign update.target = control_target[19:2];\n  assign update.instr  = in.instr;\n  always_comb begin\n    if (in.ctrl.is_jump)\n      update.counter = 2'\"'b11;\n    else if (\"'!in.prediction.hit)\n      update.counter = branch_taken ? 2'\"'b10 : 2'b01;\n    else if (branch_taken)\n      update.counter = in.prediction.counter == 2'b11 ? 2'b11 : in.prediction.counter + 2'd1;\n    else\n      update.counter = in.prediction.counter == 2'b00 ? 2'b00 : in.prediction.counter - 2'd1;\n  end\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n\n  always_ff @(posedge clock) begin\n    if (\"'!stall) begin\n      reg_q.pc            <= in.pc;\n      // All three terms feed the existing EX/MEM bypass register.\n      reg_q.alu_result    <= alu_result | ({32{in.ctrl.is_jump}} & (in.pc + 32'\"'d4)) |\n                             product[31:0];\n      reg_q.mul_high      <= product[63:32];\n      reg_q.use_mul_high  <= in.use_mul_high;\n      reg_q.use_div       <= is_div;\n      reg_q.use_alu_result <= \"'!in.use_mul_high && !is_div && !in.ctrl.mem_to_reg;\n      reg_q.mem_addr      <= effective_addr;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= is_div ? div_rs1_q : load_rs1 ? mem_load_data : rs1;\n      reg_q.rs2_val       <= is_div ? div_rs2_q : load_rs2 ? mem_load_data : rs2;\n      reg_q.pc_next       <= redirect_target;\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid;\n    end\n    if (reset || (!stall && div_wait)) begin\n      reg_q.valid          <= 1'\"'b0;\n      reg_q.ctrl.reg_write <= 1'b0;\n      reg_q.ctrl.mem_read  <= 1'b0;\n      reg_q.ctrl.mem_write <= 1'b0;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n\nRTL\nprep -top ex_stage -flatten\ndesign -stash trial\ndesign -copy-from verified -as gold ex_stage\ndesign -copy-from trial -as gate ex_stage\nequiv_make gold gate equiv\nhierarchy -top equiv\nequiv_simple\nequiv_status -assert\nYOSYS_INPUT\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.completed", "item": {"id": "item_235", "type": "command_execution", "command": "/bin/bash -c \"yosys -Q -q -s - <<'YOSYS_INPUT'\nread_verilog -sv -DRISCV_FORMAL_ALTOPS -Icores/bench/rtl cores/bench/rtl/core_pkg.sv cores/bench/rtl/alu.sv cores/bench/rtl/ex_stage.sv\nprep -top ex_stage -flatten\ndesign -stash verified\nread_verilog -sv -DRISCV_FORMAL_ALTOPS -Icores/bench/rtl <<RTL\n// rtl/alu.sv\n//\n// RV32IM ALU with a seven-round reciprocal-based divider.\n\"'`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [10:0] result_sel,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        div_start,   // one issue pulse while idle\n  input  logic        div_accept,  // downstream can capture a completed result\n  input  logic [63:0] product,     // registered output of the shared EX multiplier\n  output logic        factor_write,\n  output logic [31:0] factor_a,\n  output logic [31:0] factor_b,\n  output logic        div_busy,\n  output logic        div_last,    // result can transfer on the upcoming edge\n  output logic        div_done,\n  output logic [31:0] div_result,\n  output logic [31:0] out\n);\n\n  // Round seven writes the result on the EX/MEM transfer edge. Enter\n  // the held state only when downstream cannot accept that transfer.\n  logic [7:1] round_q;\n  assign div_last = round_q[7];\n  assign factor_write = round_q[3] || round_q[5];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      round_q  <= '\"'0;\n      div_busy <= 1'b0;\n      div_done <= 1'b0;\n    end else begin\n      round_q  <= {round_q[6:1], div_start};\n      div_done <= (div_last || div_done) && \"'!div_accept;\n      if (div_start) div_busy <= 1'\"'b1;\n      else if ((div_last || div_done) && div_accept) div_busy <= 1'b0;\n    end\n  end\n\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  wire unused_product = ''^product;\n  assign factor_a = '\"'0;\n  assign factor_b = '0;\n  logic [31:0] alt_result_q;\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      case (op)\n        ALU_DIV:  alt_result_q <= (a - b) \"'^ 32'\"'h7f8529ec;\n        ALU_DIVU: alt_result_q <= (a - b) \"'^ 32'\"'h10e8fd70;\n        ALU_REM:  alt_result_q <= (a - b) \"'^ 32'\"'h8da68fa5;\n        default:  alt_result_q <= (a - b) \"'^ 32'\"'h3138d0e1; // REMU\n      endcase\n    end\n    if (div_last) div_result <= alt_result_q;\n  end\n\"'`else\n  logic [31:0] dividend_q, divisor_q;\n  logic        want_rem_q, negate_q, zero_quotient_q;\n  logic        signed_op, want_rem;\n  logic        negative_a, negative_b;\n  assign signed_op  = op == ALU_DIV || op == ALU_REM;\n  assign want_rem   = op == ALU_REM || op == ALU_REMU;\n  assign negative_a = signed_op && a[31];\n  assign negative_b = signed_op && b[31];\n\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      dividend_q    <= negative_a ? -a : a;\n      divisor_q     <= negative_b ? -b : b;\n      want_rem_q    <= want_rem;\n      negate_q      <= want_rem ? negative_a : negative_a ''^ negative_b;\n      // For REM by zero, P is zero and sign restoration returns a.\n      zero_quotient_q <= b == 0 && !want_rem;\n    end\n  end\n\n  // Round 1. Normalize D and recover k = floor(log2(D)) as we shift.\n  logic [31:0] normalized;\n  logic [4:0] exponent, exponent_q;\n  always_comb begin\n    normalized = divisor_q;\n    for (int s = 4; s >= 0; s--) begin\n      exponent[s] = |(normalized >> (32 - (1 << s)));\n      if (!exponent[s]) normalized = normalized << (1 << s);\n    end\n  end\n\n  // ceil(2''^42 / (1024+i)) - 1 fits in a word even for row zero.\n  function automatic [31:0] rom_base(input integer i);\n    rom_base = 32'\"'(((64'd1 << 42) - 64'd1) / (64'd1024 + 64'(i)));\n  endfunction\n  logic [48:0] reciprocal_rom [0:1023];\n  initial begin\n    for (int i = 0; i < 1024; i++)\n      reciprocal_rom[i] = {rom_base(i), 17'((rom_base(i) - rom_base(i+1)) >> 5)};\n  end\n\n  logic [48:0] row_q;\n  logic [12:0] fraction_q;\n  logic        reciprocal_carry_q;\n  always_ff @(posedge clock) begin\n    if (round_q[1]) begin\n      row_q      <= reciprocal_rom[normalized[30:21]];\n      fraction_q <= normalized[20:8];\n      exponent_q <= exponent;\n      // Only row zero at fraction zero can interpolate to 2\"'^32.\n      reciprocal_carry_q <= normalized[30:8] == 0;\n    end\n  end\n\n  // Rounds 2 and 3. Interpolate downward from the upper endpoint.\n  logic [31:0] upper_q, reciprocal;\n  logic [21:0] correction_q;\n  always_ff @(posedge clock) begin\n    if (round_q[2]) begin\n      upper_q      <= row_q[48:17] + 32'\"'d1;\n      correction_q <= 22'((30'(row_q[16:0]) * fraction_q) >> 8);\n    end\n  end\n  assign reciprocal = upper_q - {10'b0, correction_q};\n\n  // EX captures A and M on round 3, then E and D on round 5.\n  // When M = 2\"'^32, the high word of A*M is A.\n  logic [31:0] high_word, estimate;\n  assign high_word = reciprocal_carry_q ? dividend_q : product[63:32];\n  assign estimate = high_word >> exponent_q;\n  assign factor_a = round_q[3] ? dividend_q : estimate;\n  assign factor_b = round_q[3] ? reciprocal : divisor_q;\n\n  // For a quotient, subtract zero from E or E-1. For a remainder,\n  // subtract P from A or A+D. Complementing both operands reverses\n  // the sign of this subtraction without another carry chain.\n  logic [31:0] exact_base_q, corrected_base_q, minuend, subtrahend;\n  logic        overestimate;\n  always_ff @(posedge clock) begin\n    if (round_q[5]) exact_base_q <= want_rem_q ? dividend_q : estimate;\n    if (round_q[6]) corrected_base_q <= exact_base_q + (want_rem_q ? divisor_q : 32'\"'hffff_ffff);\n  end\n  assign overestimate = product[32:0] > {1'b0, dividend_q};\n  assign minuend = (overestimate ? corrected_base_q : exact_base_q) \"'^ {32{negate_q}};\n  assign subtrahend = (want_rem_q ? product[31:0] : 32'\"'b0) \"'^ {32{negate_q}};\n  always_ff @(posedge clock) begin\n    if (div_last)\n      div_result <= zero_quotient_q ? 32'\"'hffff_ffff : minuend - subtrahend;\n  end\n\"'`endif\n\n  logic [4:0] shamt;\n  assign shamt = b[4:0];\n  assign out = ({32{result_sel[ALU_ADD[3:0]]}}  & (a + b)) |\n               ({32{result_sel[ALU_SUB[3:0]]}}  & (a - b)) |\n               ({32{result_sel[ALU_AND[3:0]]}}  & (a & b)) |\n               ({32{result_sel[ALU_OR[3:0]]}}   & (a | b)) |\n               ({32{result_sel[ALU_XOR[3:0]]}}  & (a ''^ b)) |\n               ({32{result_sel[ALU_SLT[3:0]]}}  & {31'\"'b0, \"'$signed(a) < $signed(b)}) |\n               ({32{result_sel[ALU_SLTU[3:0]]}} & {31'\"'b0, a < b}) |\n               ({32{result_sel[ALU_SLL[3:0]]}}  & (a << shamt)) |\n               ({32{result_sel[ALU_SRL[3:0]]}}  & (a >> shamt)) |\n               ({32{result_sel[ALU_SRA[3:0]]}}  & \"'$unsigned($signed(a) >>> shamt)) |\n               ({32{result_sel[ALU_LUI[3:0]]}}  & b);\n\nendmodule\n\n/* verilator lint_off DECLFILENAME */\nmodule multiplier (\n  // The formal model selects its formula by opcode. The DSP takes the\n  // extension bits directly from EX.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [4:0]  op,\n  input  logic        lhs_ext,\n  input  logic        rhs_ext,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [63:0] product\n);\n/* verilator lint_on DECLFILENAME */\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result;\n  always_comb begin\n    case (op)\n      ALU_MUL:    alt_result = (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   alt_result = (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  alt_result = (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: alt_result = (a - b) \"'^ 32'\"'hecfbe137;\n      default:    alt_result = 32'b0;\n    endcase\n  end\n  assign product = {2{alt_result}};\n\"'`else\n  assign product = $signed({lhs_ext, a}) * $signed({rhs_ext, b});\n`endif\nendmodule\n\n// rtl/ex_stage.sv\n//\n// Execute uses collected operands plus a bypass from the immediate\n// predecessor. It resolves redirects and owns the EX/MEM register.\n//\n// Latency:        1 cycle to EX/MEM, or 8 for divide/remainder.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               bypass_rs1,\n  input  logic               bypass_rs2,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic               load_rs1,\n  input  logic               load_rs2,\n  input  logic [31:0]        load_other,    // collected branch operand opposite the load\n  input  logic [1:0]         load_width,\n  input  logic               load_sext,\n  input  logic [3:0]         load_mask,\n  input  logic [31:0]        mem_load_data, // aligned and extended\n  input  logic [31:0]        dmem_rdata,    // raw word for pointer loads and equality\n  output logic               nonload_write,\n  output logic               load_write,\n  output logic [3:0]         ex_load_mask,\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic [31:0]        div_result,\n  output logic               factor_write,\n  output logic [31:0]        factor_a,\n  output logic [31:0]        factor_b,\n  output btb_update_t        update,\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n  assign rs1 = bypass_rs1 ? fwd_ex_mem : in.rs1_val;\n  assign rs2 = bypass_rs2 ? fwd_ex_mem : in.rs2_val;\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  logic [63:0] product;\n  ex_mem_t reg_q;\n  logic [31:0] div_rs1_q, div_rs2_q;\n  logic        is_div, div_start, div_busy, div_last, div_done;\n\n  assign is_div = in.valid && (in.ctrl.alu_op == ALU_DIV  || in.ctrl.alu_op == ALU_DIVU ||\n                               in.ctrl.alu_op == ALU_REM  || in.ctrl.alu_op == ALU_REMU);\n  assign div_start = is_div && !div_busy && !stall;\n  assign div_wait  = is_div && !(div_last || div_done);\n\n  // The adjacent writer can drain while the divider owns EX.\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      div_rs1_q <= rs1;\n      div_rs2_q <= rs2;\n    end\n  end\n\n  alu u_alu (\n    .clock      (clock),\n    .reset      (reset),\n    .div_start  (div_start),\n    .div_accept (!stall),\n    .div_busy   (div_busy),\n    .div_last   (div_last),\n    .div_done   (div_done),\n    .div_result (div_result),\n    // During a divide the low product is the only enabled ALU result.\n    // EX/MEM therefore already holds both words after rounds 4 and 6.\n    .product    ({reg_q.mul_high, reg_q.alu_result}),\n    .factor_write (factor_write),\n    .factor_a   (factor_a),\n    .factor_b   (factor_b),\n    .result_sel (in.result_sel),\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );\n\n  logic [31:0] mul_lhs;\n  assign mul_lhs = in.bypass_mul_lhs ? fwd_ex_mem : in.mul_lhs;\n  multiplier u_mul (\n    .op      (in.ctrl.alu_op),\n    .lhs_ext (in.mul_lhs_signed && mul_lhs[31]),\n    .rhs_ext (in.mul_rhs_signed && rs2[31]),\n    .a       (mul_lhs),\n    .b       (rs2),\n    .product (product)\n  );\n\n  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n  logic        equal;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] control_target;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  // The active bytes test the low part of the expected register value.\n  // Its upper bits must be a valid extension before a subword can match.\n  logic [31:0] expected_bytes;\n  logic        extension_ok;\n  logic [3:0]  lane_equal;\n  always_comb begin\n    case (load_width)\n      2'\"'d0: begin\n        expected_bytes = {4{load_other[7:0]}};\n        extension_ok = (load_sext && load_other[7]) ? (&load_other[31:8]) :\n                                                      (~|load_other[31:8]);\n      end\n      2'd1: begin\n        expected_bytes = {2{load_other[15:0]}};\n        extension_ok = (load_sext && load_other[15]) ? (&load_other[31:16]) :\n                                                       (~|load_other[31:16]);\n      end\n      default: begin\n        expected_bytes = load_other;\n        extension_ok = 1'b1;\n      end\n    endcase\n  end\n  for (genvar lane = 0; lane < 4; lane++) begin : g_load_compare\n    assign lane_equal[lane] = \"'!load_mask[lane] ||\n                              dmem_rdata[8*lane +: 8] == expected_bytes[8*lane +: 8];\n  end\n\n  always_comb begin\n    // Two load matches name the same register, so the collected values\n    // already compare equal. A faulting load has neither match enabled.\n    if (load_rs1 ''^ load_rs2)\n      equal = extension_ok && (&lane_equal);\n    else\n      equal = rs1 == rs2;\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = equal;\n      BR_BNE:  branch_cond = !equal;\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'\"'b0;\n    endcase\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    // JALR clears bit 0. Direct jumps and conditional branches use PC.\n    jalr_sum    = rs1 + in.imm;\n    control_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0} : branch_target;\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] \"'!= 0). We trap the offending\n  // instruction, continue at PC+4, and suppress the link write.\n  logic wants_transfer;\n  logic misalign_fault;\n  logic taken;\n  logic advancing;\n  logic fence_i;\n  ctrl_t ctrl_with_trap;\n\n  assign wants_transfer = branch_taken || in.ctrl.is_jump;\n  assign misalign_fault = wants_transfer && control_target[1:0] != 0;\n  assign taken = wants_transfer && !misalign_fault;\n  assign advancing = in.valid && !stall && !div_wait;\n  assign fence_i = in.instr[6:0] == 7'\"'h0f && in.instr[14:12] == 3'b001;\n\n  always_comb begin\n    ctrl_with_trap = in.ctrl;\n    ctrl_with_trap.reg_write = in.valid && in.ctrl.reg_write && \"'!misalign_fault;\n    ctrl_with_trap.mem_read  = in.valid && in.ctrl.mem_read;\n    ctrl_with_trap.mem_write = in.valid && in.ctrl.mem_write;\n    if (misalign_fault)\n      ctrl_with_trap.is_illegal = 1'\"'b1;\n  end\n\n  // Qualify the current producer for the instruction in collection. A\n  // dependent load can take its base directly from the raw adjacent LW.\n  logic [31:0] effective_addr;\n  logic [1:0] load_offset;\n  assign effective_addr = (load_rs1 ? dmem_rdata : rs1) + in.imm;\n  assign load_offset = effective_addr[1:0];\n  assign nonload_write = ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read;\n  assign load_write = ctrl_with_trap.mem_read &&\n                      !(in.ctrl.mem_width == 2'\"'d1 && load_offset[0]) &&\n                      \"'!(in.ctrl.mem_width == 2'\"'d2 && load_offset \"'!= 0);\n  always_comb begin\n    case (in.ctrl.mem_width)\n      2'\"'d0:    ex_load_mask = 4'b0001 << load_offset;\n      2'd1:    ex_load_mask = 4'b0011 << load_offset;\n      default: ex_load_mask = 4'b1111;\n    endcase\n  end\n\n  assign redirect_target = taken ? control_target : in.pc + 32'd4;\n  assign redirect = advancing && (fence_i || taken \"'!= in.prediction.taken ||\n                    (taken && control_target != {12'\"'b0, in.prediction.target, 2'b00}));\n\n  // The fetch snapshot belongs to this instruction even if another source\n  // has since replaced its entry. Write the tag, word and target together.\n  logic ram_pc;\n  assign ram_pc = in.pc[31:20] == 0 && in.pc[1:0] == 0;\n  assign update.invalidate = advancing && fence_i;\n  assign update.successor = advancing && ram_pc && \"'!in.ctrl.is_illegal &&\n                            !in.ctrl.is_branch && !in.ctrl.is_jump && !fence_i;\n  assign update.write = advancing && (in.ctrl.is_branch || in.ctrl.is_jump) &&\n                        !in.ctrl.is_illegal && ram_pc &&\n                        control_target[31:20] == 0 && control_target[1:0] == 0;\n  assign update.pc     = in.pc[19:2];\n  assign update.target = control_target[19:2];\n  assign update.instr  = in.instr;\n  always_comb begin\n    if (in.ctrl.is_jump)\n      update.counter = 2'\"'b11;\n    else if (\"'!in.prediction.hit)\n      update.counter = branch_taken ? 2'\"'b10 : 2'b01;\n    else if (branch_taken)\n      update.counter = in.prediction.counter == 2'b11 ? 2'b11 : in.prediction.counter + 2'd1;\n    else\n      update.counter = in.prediction.counter == 2'b00 ? 2'b00 : in.prediction.counter - 2'd1;\n  end\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n\n  always_ff @(posedge clock) begin\n    if (\"'!stall) begin\n      reg_q.pc            <= in.pc;\n      // All three terms feed the existing EX/MEM bypass register.\n      reg_q.alu_result    <= alu_result | ({32{in.ctrl.is_jump}} & (in.pc + 32'\"'d4)) |\n                             product[31:0];\n      reg_q.mul_high      <= product[63:32];\n      reg_q.use_mul_high  <= in.use_mul_high;\n      reg_q.use_div       <