{"type":"item.completed","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -c \"git status --short; git diff --check; git check-ignore cores/bench/implementation_notes.md; sed -n '68,130p' cores/bench/rtl/alu.sv\"","aggregated_output":" M cores/bench/rtl/alu.sv\n M cores/bench/test/test_alu.py\ncores/bench/implementation_notes.md\n  // Round 1 indexes the ROM with up to 12 leading bits of D. In the\n  // normalized rows, (index + 1) << scale is an upper bound on D.\n  logic [4:0] scale;\n  always_comb begin\n    scale = 5'd0;\n    for (int bit_pos = 12; bit_pos < 32; bit_pos++)\n      if (divisor_q[bit_pos]) scale = 5'(bit_pos - 11);\n  end\n  wire [11:0] index = 12'(divisor_q >> scale);\n\n  logic [31:0] reciprocal_rom [0:4095];\n  for (genvar group = 0; group < 4; group++) begin : g_group\n    for (genvar offset = 0; offset < 1024; offset++) begin : g_word\n      localparam int ROW = group * 1024 + offset;\n      localparam logic [63:0] U = ROW < 2048 ? 64'(ROW) : 64'(ROW) + 64'd1;\n      if (ROW == 0) begin : g_zero\n        initial reciprocal_rom[ROW] = 32'b0;\n      end else if (ROW == 1) begin : g_one\n        initial reciprocal_rom[ROW] = 32'hffff_ffff;\n      end else begin : g_reciprocal\n        initial reciprocal_rom[ROW] = 32'(64'h1_0000_0000 / U);\n      end\n    end\n  end\n\n  logic [4:0]  scale_q;\n  logic [31:0] rom_word_q, coefficient_q, negative_divisor_q;\n  always_ff @(posedge clock) begin\n    rom_word_q         <= reciprocal_rom[index];\n    scale_q            <= scale;\n    coefficient_q      <= rom_word_q >> scale_q;\n    negative_divisor_q <= -divisor_q;\n  end\n\n  // R starts at A on round 2. Rounds 3 and 5 estimate floor(R*M/2^32)\n  // on the same multiplier. Since D*M <= 2^32, E*D <= R, so the low\n  // word of the multiply-add in rounds 4 and 6 is the exact residual.\n  logic [31:0] residual_q, estimate_q, quotient_q;\n  wire [31:0] next_residual = residual_q + estimate_q * negative_divisor_q;\n  always_ff @(posedge clock) begin\n    estimate_q <= 32'((64'(residual_q) * coefficient_q) >> 32);\n    if (round_q == 4'd2) begin\n      residual_q <= dividend_q;\n    end else if (round_q == 4'd4 || round_q == 4'd6) begin\n      residual_q <= next_residual;\n      quotient_q <= round_q == 4'd4 ? estimate_q : quotient_q + estimate_q;\n    end\n  end\n\n  // For nonzero D, R < 2D. The round-7 subtraction gives both the\n  // corrected remainder and the borrow that decides whether to use it.\n  wire [32:0] difference = {1'b0, residual_q} - {1'b0, divisor_q};\n  wire [31:0] remainder = difference[32] ? residual_q : difference[31:0];\n  wire [31:0] quotient = difference[32] ? quotient_q : quotient_q + 32'd1;\n  logic [31:0] magnitude_q;\n  always_ff @(posedge clock) begin\n    if (div_last) magnitude_q <= want_rem_q ? remainder : quotient;\n  end\n\n  // With D = 0, every residual equals |A|, so restoring its sign gives\n  // the architectural remainder. Either quotient operation returns all ones.\n  assign div_result = {32{zero_quotient_q}} | (negate_q ? -magnitude_q : magnitude_q);\n`endif\n","exit_code":0,"status":"completed"}}
