{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"cat tools/eval/gowin.py | head -260; rg -n 'def |placement|GOWIN|timeout' tools/eval/gowin.py | tail -90\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[9368 of 12440 chars elided by tools/bench/transcript.py; sha256:f7ac7eba6e52cd7e]…\n/ \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n137:            proc.wait(timeout=BUILD_TIMEOUT_SEC)\n148:def build(worktree: str | Path, rtl_dir: str | Path, bench_sv: str,\n160:        return {\"place_option\": place_option, \"placement_failed\": True,\n162:                \"reason\": f\"Gowin build timeout after {BUILD_TIMEOUT_SEC}s\"}\n164:    if res[\"placement_failed\"]:\n170:def build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\n179:def summarize(results: list[dict]) -> dict:\n180:    \"\"\"Median Fmax over placement options; every option must fit (the flow\n182:    failed = [r for r in results if r[\"placement_failed\"]]\n184:        return {\"placement_failed\": True,\n189:        \"placement_failed\": False,\n199:def main(argv=None) -> int:\n209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\n216:        if r[\"placement_failed\"]:\n226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"cat bench/programs/Makefile; cat tools/eval/cosim.py | head -280; sed -n '725,796p;1014,1085p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "CROSS   := riscv32-unknown-elf\nCC      := $(CROSS)-gcc\n\n# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\n# (2K data size, -O3); tools/eval/fpga.py's COREMARK_EXPECTED CRCs assume\n# exactly these defaults.\n# - COREMARK_SIZE: TOTAL_DATA_SIZE in coremark.h (#ifndef-guarded). 2000 is\n#   the EEMBC canonical reporting config (used by VexRiscv et al.); 6000\n#   makes the matrix/list/state working sets ~3x larger so the score is\n#   harder to inflate via register-resident working sets.\n# - COREMARK_OPT: gcc optimization. -O3 is the standard CoreMark publication\n#   flag; -O2 is what the V0 baseline used.\n# Defaults match VexRiscv's published CoreMark methodology so the\n# orchestrator's fitness number is directly comparable to public CoreMark\n# results. To override (e.g. for the prior 6K -O2 V0 baseline):\n#     make bench/programs/coremark.elf COREMARK_SIZE=6000 COREMARK_OPT=-O2\nCOREMARK_SIZE ?= 2000\nCOREMARK_OPT  ?= -O3\n\nCFLAGS  := -march=rv32im -mabi=ilp32 $(COREMARK_OPT) -static -nostartfiles \\\n           -specs=nano.specs -specs=nosys.specs \\\n           -T bench/programs/link.ld -Ibench/programs/coremark \\\n           -Ibench/programs/coremark/baremetal \\\n           -DTOTAL_DATA_SIZE=$(COREMARK_SIZE)\n\nSRCS := bench/programs/coremark/core_list_join.c \\\n        bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/pro\n…[13290 of 16362 chars elided by tools/bench/transcript.py; sha256:4c4afc4272f1280e]…\n, -1), BNE(1, 0, -16), EBREAK()]\n    replacement = ADDI(2, 0, 55)\n    visits = []\n    refetch = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if visits.count(4) == 2:\n            refetch.append(pc)\n            if pc == 16:\n                return None if refetch.count(16) <= 4 else replacement\n        return word\n\n    rets, _ = await _run(dut, program, fetch=fetch)\n    i = refetch.index(16)\n    assert refetch[i:i + 6] == [16] * 5 + [20]\n    _check_pc_trace(rets, [0, 4, 16, 20, 24, 8, 12, 4, 16, 20, 24, 28])\n    assert [(r[\"insn\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 16] == [\n        (program[4], 11), (replacement, 55)]\n    assert not any(r[\"trap\"] for r in rets)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
