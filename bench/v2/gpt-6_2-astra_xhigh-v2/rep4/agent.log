{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'set -eu\nalu_build=\"$TMPDIR/reciprocal-alu\"\nc++ -std=c++17 -O2 -I\"$alu_build\" -I/opt/hwe-toolchain/oss-cad-suite/share/verilator/include -x c++ - -x none \"$alu_build/libValu.a\" cores/bench/obj_dir/verilated{,_threads}.o -pthread -latomic -o \"$alu_build/check\" <<'\"'CPP'\n#include \\\"Valu.h\\\"\n#include <cstdint>\n#include <cstdlib>\n#include <iostream>\n#include <random>\n\nint main() {\n    Valu alu;\n    auto tick = [&]() {\n        alu.clock = 0;\n        alu.eval();\n        alu.clock = 1;\n        alu.eval();\n    };\n    alu.reset = 1;\n    alu.div_start = 0;\n    alu.div_accept = 1;\n    tick();\n    alu.reset = 0;\n    unsigned checked = 0;\n    auto check = [&](unsigned op, uint32_t a, uint32_t b) {\n        const bool rem = op == 17 || op == 18;\n        const bool sign = op == 15 || op == 17;\n        const int64_t lhs = sign ? int64_t(int32_t(a)) : int64_t(a);\n        const int64_t rhs = sign ? int64_t(int32_t(b)) : int64_t(b);\n        const uint32_t expected = rhs == 0 ? (rem ? a : UINT32_MAX)\n                                          : uint32_t(rem ? lhs % rhs : lhs / rhs);\n        alu.op = op;\n        alu.a = a;\n        alu.b = b;\n        alu.div_start = 1;\n        tick();\n        alu.div_start = 0;\n        alu.op = 0;\n        alu.a = ~a;\n        alu.b = ~b;\n        for (unsigned round = 1; round <= 7; ++round) {\n            if (\"'!alu.div_busy || alu.div_done || alu.div_last != (round == 7)) std::abort();\n            tick();\n        }\n        if (alu.div_busy || alu.div_result != expected) {\n            std::cerr << \"op=\" << op << \" a=\" << a << \" b=\" << b << \" expected=\"\n                      << expected << \" actual=\" << alu.div_result << std::endl;\n            std::exit(1);\n        }\n        ++checked;\n    };\n    std::mt19937 rng(271828);\n    for (unsigned s = 0; s <= 20; ++s) {\n        for (unsigned i = s