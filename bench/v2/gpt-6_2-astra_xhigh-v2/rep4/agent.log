{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, random, subprocess\nfrom pathlib import Path\ns = Path(os.environ['TMPDIR']) / 'radix4'\nrng = random.Random(20261121)\nm = (1<<32)-1\nv = []\nds = [0, 1, 2, 3, 7, 31, 255, 65535, 1<<30, (1<<31)-1, 1<<31, (1<<31)+1, m-1, m] + [rng.getrandbits(32) for _ in range(100)]\nargs = [(a & m,d) for d in ds for k in range(4) for e in [-1,0,1] for a in [k*d+e] if 0<=a<=m]\nargs.extend((rng.getrandbits(32),rng.getrandbits(rng.randrange(1,33))) for _ in range(2500))\nfor a,d in args:\n  for op in [15,16,17,18]:\n    signed = op in [15,17]\n    aa = a-(1<<32) if signed and a>>31 else a\n    dd = d-(1<<32) if signed and d>>31 else d\n    q = abs(aa)//abs(dd)*(-1 if (aa<0)\"'^(dd<0) else 1) if dd else -1\n    r = aa-q*dd\n    expected = (q if op in [15,16] else r) & m\n    v.append(f'\"'{op:02x}{a:08x}{d:08x}{expected:08x}')\n(s/'vectors.hex').write_text('\\\\n'.join(v)+'\\\\n')\n(s/'arith.sv').write_text(\\\"\\\"\\\"\nmodule arith;\nreg [103:0] vectors [0:COUNT-1];\nreg [4:0] op;\nreg [31:0] a,b,expected;\nwire [31:0] out;\nalu dut (op,a,b,out);\ninitial begin\n  \"'$readmemh(\"vectors.hex\",vectors);\n  for(integer i=0; i<COUNT; i=i+1) begin\n    {op,a,b,expected} = vectors[i][100:0];\n    #1;\n    if(out !== expected)\n      $fatal(1, \"op=%d a=%h b=%h out=%h expected=%h\",op,a,b,out,expected);\n  end\n  $display(\"Passed %d arithmetic comparisons\",COUNT);\n  $finish;\nend\nendmodule\n\"\"\".replace('\"'COUNT',str(len(v))))\nsubprocess.run(['iverilog','-g2012','-s','arith','-o','arith.vvp','rtl/core_pkg.sv','rtl/alu.sv','arith.sv'],cwd=s,check=True,stderr=subprocess.PIPE)\nsubprocess.run(['vvp','arith.vvp'],cwd=s,check=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
