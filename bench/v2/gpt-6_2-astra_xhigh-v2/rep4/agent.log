{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU with a shared six-round restoring divider.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        div_start,   // one issue pulse while idle\n  input  logic        div_accept,  // downstream can capture a completed result\n  output logic        div_busy,\n  output logic        div_done,\n  output logic [31:0] div_result,\n  output logic [31:0] out\n);\n\n  // Idle = 0, restoring rounds = 1..6, result held for EX/MEM = 7.\n  logic [2:0] round_q;\n  assign div_busy = round_q != 3'd0;\n  assign div_done = round_q == 3'd7;\n\n  always_ff @(posedge clock) begin\n    if (reset)                      round_q <= 3'd0;\n    else if (div_start)             round_q <= 3'd1;\n    else if (div_done && div_accept) round_q <= 3'd0;\n    else if (div_busy && !div_done) round_q <= round_q + 3'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        default:  div_result <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n  end\n`else\n  // Incoming dividend bits shift out of the top of quotient_q. Each bit\n  // consumed frees a bit at the bottom for the corresponding quotient bit.\n  logic [35:0] quotient_q;\n  logic [31:0] remainder_q, divisor_q;\n  logic        want_rem_q, negate_q;\n  logic        signed_op, want_rem;\n  logic        negative_a, negative_b;\n  assign signed_op  = op == ALU_DIV || op == ALU_REM;\n  assign want_rem   = op == ALU_REM || op == ALU_REMU;\n  assign negative_a = signed_op && a[31];\n  assign negative_b = signed_op && b[31];\n\n  logic [31:0] remainder_next;\n  logic [32:0] shifted, trial;\n  logic [5:0]  quotient_bits;\n  always_comb begin\n    remainder_next = remainder_q;\n    for (int i = 0; i < 6; i++) \n…[2048 of 5120 chars elided by tools/bench/transcript.py; sha256:430b6029c8ebf289]…\n'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations\n      // are substituted for tractable algebraic stand-ins so bitwuzla\n      // can solve the BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined and\n      // run the real arithmetic.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n`else\n      ALU_MUL:    out = mul_uu[31:0];\n      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\n      ALU_MULHU:  out = mul_uu[63:32];\n      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
