{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/split_trial.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport sys,os\n# k high dividend bits seed the wide remainder. For non-power k choose\n# the smallest multiple-of-six width: k=8,14,20,26 => 4,3,2,1 wide bits/round.\nk=int(sys.argv[1])\np=Path(os.environ['TMPDIR'])/f'split{k}'\np.mkdir(exist_ok=True)\ncopytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True,copy_function=__import__('shutil').copyfile)\nf=p/'rtl/alu.sv'\ns=f.read_text()\nl=s.index('  logic [35:0] quotient_q;')\nr=s.index('  logic        want_rem_q,',l)\ns=s[:l]+f'''  logic [35:0] small_q;\n  logic [{k-1}:0] small_r;\n  logic [{31-k}:0] large_q;\n  logic [31:0] large_r, divisor_q;\n  logic use_small;\n'''+s[r:]\nl=s.index('  logic [31:0] remainder_next;')\nr=s.index('  always_ff @(posedge clock) begin',l)\nn=(32-k)//6\ns=s[:l]+f'''  wire [31:0] ma = negative_a ? -a : a;\n  wire [31:0] mb = negative_b ? -b : b;\n  wire [{k-1}:0] ns[0:6];\n  assign ns[0] = small_r;\n  wire [5:0] sbits;\n  for(genvar j=0; j<6; j=j+1) begin : g_small\n    wire [{k}:0] x = {{ns[j], small_q[35-j]}};\n    wire [{k}:0] trial = x - {{1'b0,divisor_q[{k-1}:0]}};\n    assign ns[j+1] = trial[{k}] ? x[{k-1}:0] : trial[{k-1}:0];\n    assign sbits[5-j] = \"'!trial[{k}];\n  end\n  wire [31:0] nw[0:{n}];\n  assign nw[0] = large_r;\n  wire [{n-1}:0] wbits;\n  for(genvar j=0; j<{n}; j=j+1) begin : g_wide\n    wire [32:0] x = {{nw[j], large_q[{31-k}-j]}};\n    wire [32:0] trial = x - {{1'\"'b0,divisor_q}};\n    assign nw[j+1] = trial[32] ? x[31:0] : trial[31:0];\n    assign wbits[{n-1}-j] = \"'!trial[32];\n  end\n\n'\"'''+s[r:]\ns=s.replace(\\\"\\\"\\\"      quotient_q  <= {4'b0, negative_a ? -a : a};\n      remainder_q <= '0;\n      divisor_q   <= negative_b ? -b : b;\\\"\\\"\\\",f\\\"\\\"\\\"      small_q <= {{4'b0,ma}};\n      small_r <= '0;\n      large_q <= ma[{31-k}:0];\n      large_r <= {{{{{32-k}{{1'b0}}}},ma[31:{32-k}]}};\n      divisor_q <= mb;\n      use_small <= mb < 32'd{1<<k} && b \"'!= 0;\"\"\")\ns=s.replace(\"\"\"      quotient_q  <= {quotient_q[29:0], quotient_bits};\n      remainder_q <= remainder_next;\"\"\",f\"\"\"      small_q <= {{small_q[29:0],sbits}};\n      small_r <= ns[6];\n      large_q <= {{large_q[{31-k-n}:0],wbits}};\n      large_r <= nw[{n}];\"\"\")\ns=s.replace('\"'assign magnitude  = want_rem_q ? remainder_q : quotient_q[31:0];',f\\\"\\\"\\\"wire [31:0] q_value = use_small ? small_q[31:0] : {{{{{k}{{divisor_q == 0}}}},large_q}};\n  wire [31:0] r_value = use_small ? {{{{{32-k}{{1'b0}}}},small_r}} : large_r;\n  assign magnitude = want_rem_q ? r_value : q_value;\\\"\\\"\\\")\nf.write_text(s)\nPY\npython \\\"\"'$TMPDIR/split_trial.py\" 14\npython \"$TMPDIR/split_trial.py\" 8\ncat > \"$TMPDIR/bench_timing.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nimport os,json,sys\np=Path(os.environ['TMPDIR'])/sys.argv[1]\nr=build_all('.',p/'rtl','fpga/core_bench_si.sv',p/'timing')\nprint(json.dumps(summarize(r),indent=2))\n(p/'timing.json').write_text(json.dumps(r))\nPY\ncat \\\"\"'$TMPDIR/split14/rtl/alu.sv\" | sed -n '\"'90,125p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
