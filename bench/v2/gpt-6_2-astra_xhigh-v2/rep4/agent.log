{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c 'd=$(cat \"$TMPDIR/r10-scratch-path\")\ncat > \"$d/variant.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,shutil\nd=Path(__file__).parent\nrtl=d/'rtl'\ndef edit(name,old,new):\n p=rtl/(name+'.sv')\n s=p.read_text()\n assert s.count(old)==1, (name,old)\n p.write_text(s.replace(old,new))\nedit('core_pkg','    logic [31:0] write_data;', '''    logic mul_sign_a, mul_sign_b, use_mul_low, use_mul_high, use_ordinary, use_div;\n    logic [31:0] write_data;''')\nedit('ex_stage','      reg_q.write_data    <= rs2;', '''      reg_q.write_data    <= rs2;\n      reg_q.mul_sign_a    <= rs1[31] && (in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU);\n      reg_q.mul_sign_b    <= rs2[31] && in.ctrl.alu_op == ALU_MULH;\n      reg_q.use_mul_low   <= in.ctrl.alu_op == ALU_MUL;\n      reg_q.use_mul_high  <= in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU;\n      reg_q.use_div       <= in.ctrl.alu_op >= ALU_DIV;\n      reg_q.use_ordinary  <= in.ctrl.alu_op < ALU_MUL && \"'!in.ctrl.mem_to_reg;'\"''')\nalu=(rtl/'alu.sv').read_text()\nalu=alu[:alu.index('module multiplier (')]+'''module multiplier (\n  input  logic [4:0]  op,\n  input  logic        sign_a, sign_b,\n  input  logic [31:0] a, b,\n  output logic [63:0] product\n);\n/* verilator lint_on DECLFILENAME */\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] result;\n  always_comb begin\n    case (op)\n      ALU_MUL:    result = (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   result = (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  result = (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: result = (a - b) \"'^ 32'\"'hecfbe137;\n      default:    result = 32'b0;\n    endcase\n  end\n  assign product = {2{result}};\n\"'`else\n  assign product = $signed({sign_a, a}) * $signed({sign_b, b});\n`endif\nendmodule\n'\"'''\n(rtl/'alu.sv').write_text(alu)\ns=(rtl/'mem_stage.sv').read_text()\ns=s[: