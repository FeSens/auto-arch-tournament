{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -c 'cp -r cores/bench/test \"$TMPDIR/prodchecked/test\"\ncat >> \"$TMPDIR/prodchecked/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def compare_all_load_lanes(dut):\n    raw = 0x807f81fe\n    program = []\n    cases = []\n    mask = 0xffffffff\n    for load, width, signed in [(LB, 8, True), (LBU, 8, False), (LH, 16, True), (LHU, 16, False), (LW, 32, False)]:\n        for lane in range(0, 4, width // 8):\n            v = (raw >> (lane * 8)) & ((1 << width) - 1)\n            if signed and v & (1 << (width - 1)):\n                v -= 1 << width\n            v &= mask\n            for expected in (v, v \"'^ 1, v ''^ 0x40000000):\n                for reverse in (False, True):\n                    for branch in (BEQ, BNE):\n                        program.extend([(((expected + 0x800) & 0xfffff000) | (2 << 7) | 0x37), ADDI(2, 2, expected & 0xfff)])\n                        pc = 4 * len(program)\n                        srcs = (2, 1) if reverse else (1, 2)\n                        program.extend([load(1, 0, 0x100 + lane), branch(*srcs, 8), NOP()])\n                        a, b = (expected, v) if reverse else (v, expected)\n                        taken = (v == expected) == (branch == BEQ)\n                        cases.append((pc, a, b, taken))\n    program.append(EBREAK())\n    rets, _ = await _run(dut, program, {0x100:raw}, read_waits={0x100:4,0x101:3,0x102:5,0x103:2}, max_cycles=3000)\n    by_pc = {r['\"'pc']: r for r in rets}\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert not any(r['trap'] for r in rets)\n    for pc, a, b, taken in cases:\n        ld, br = by_pc[pc], by_pc[pc+4]\n        assert (br['rs1_rdata'],br['rs2_rdata']) == (a,b)\n        assert br['cycle'] == ld['cycle'] + 1\n        assert br['pc_next'] == pc + (12 if taken else 8)\n        assert (pc + 8 in by_pc) == (not taken)\nPY\ncd \\\"\"'$TMPDIR/prodchecked\" && python -m pytest --rootdir=. --confcutdir=. -q test/test_pipeline.py > lanes.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -c 'cp -r cores/bench/test \"$TMPDIR/prodchecked/test\"\ncat >> \"$TMPDIR/prodchecked/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def compare_all_load_lanes(dut):\n    raw = 0x807f81fe\n    program = []\n    cases = []\n    mask = 0xffffffff\n    for load, width, signed in [(LB, 8, True), (LBU, 8, False), (LH, 16, True), (LHU, 16, False), (LW, 32, False)]:\n        for lane in range(0, 4, width // 8):\n            v = (raw >> (lane * 8)) & ((1 << width) - 1)\n            if signed and v & (1 << (width - 1)):\n                v -= 1 << width\n            v &= mask\n            for expected in (v, v \"'^ 1, v ''^ 0x40000000):\n                for reverse in (False, True):\n                    for branch in (BEQ, BNE):\n                        program.extend([(((expected + 0x800) & 0xfffff000) | (2 << 7) | 0x37), ADDI(2, 2, expected & 0xfff)])\n                        pc = 4 * len(program)\n                        srcs = (2, 1) if reverse else (1, 2)\n                        program.extend([load(1, 0, 0x100 + lane), branch(*srcs, 8), NOP()])\n                        a, b = (expected, v) if reverse else (v, expected)\n                        taken = (v == expected) == (branch == BEQ)\n                        cases.append((pc, a, b, taken))\n    program.append(EBREAK())\n    rets, _ = await _run(dut, program, {0x100:raw}, read_waits={0x100:4,0x101:3,0x102:5,0x103:2}, max_cycles=3000)\n    by_pc = {r['\"'pc']: r for r in rets}\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert not any(r['trap'] for r in rets)\n    for pc, a, b, taken in cases:\n        ld, br = by_pc[pc], by_pc[pc+4]\n        assert (br['rs1_rdata'],br['rs2_rdata']) == (a,b)\n        assert br['cycle'] == ld['cycle'] + 1\n        assert br['pc_next'] == pc + (12 if taken else 8)\n        assert (pc + 8 in by_pc) == (not taken)\nPY\ncd \\\"\"'$TMPDIR/prodchecked\" && pyth