{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/3df75752/782d65b5/r14-study/fwd.py <<'PY'\nimport sys\nfrom variants import *\nfrom tools.eval.gowin import build_all\ndef fw(name,mode):\n    d=save(name,{})\n    c=get('core.sv');ex=get('ex_stage.sv')\n    # Capture a full fallback. In a repair cycle use the completing load result.\n    for s in ['rs1','rs2']:\n        c=c.replace(f'\"'!adjacent_{s} && '\"', '')\n        ex=ex.replace(f'in.{s}_val | ({{32{{bypass_{s}}}}} & fwd_ex_mem)', f'bypass_{s} ? fwd_ex_mem : in.{s}_val')\n    if mode=='dual':\n        ex=ex.replace('(in.ctrl.is_auipc ? in.pc : in.rs1_val) | ({32{bypass_alu_a}} & fwd_ex_mem)', 'bypass_alu_a ? fwd_ex_mem : (in.ctrl.is_auipc ? in.pc : in.rs1_val)')\n        ex=ex.replace('(in.ctrl.alu_src ? in.imm : in.rs2_val) | ({32{bypass_alu_b}} & fwd_ex_mem)', 'bypass_alu_b ? fwd_ex_mem : (in.ctrl.alu_src ? in.imm : in.rs2_val)')\n    elif mode=='after':\n        ex=ex.replace('(in.ctrl.is_auipc ? in.pc : in.rs1_val) | ({32{bypass_alu_a}} & fwd_ex_mem)', 'in.ctrl.is_auipc ? in.pc : rs1')\n        ex=ex.replace('(in.ctrl.alu_src ? in.imm : in.rs2_val) | ({32{bypass_alu_b}} & fwd_ex_mem)', 'in.ctrl.alu_src ? in.imm : rs2')\n    else:\n        c=c.replace('  id_ex_t collected;', '  logic [31:0] base_a, base_b, base_a_q, base_b_q;\\\\n  id_ex_t collected;')\n        ix=c.index(';',c.index('    collected.rs2_val ='))+1\n        sa='    base_a = waiting.ctrl.is_auipc ? waiting.pc : collected.rs1_val;'\n        sb='    base_b = waiting.ctrl.alu_src ? waiting.imm : collected.rs2_val;'\n        if mode=='flat':\n            for s,modesel,data,var in [('rs1','waiting.ctrl.is_auipc','waiting.pc','a'),('rs2','waiting.ctrl.alu_src','waiting.imm','b')]:\n                i=c.index(f'    collected.{s}_val =');j=c.index(';',i)+1\n                t=c[i:j].replace(f'collected.{s}_val =', f'base_{var} =\\\\n      ({{32{{{modesel}}}}} & {data}) |').replace