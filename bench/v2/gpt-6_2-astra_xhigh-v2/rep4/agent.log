{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"command -v gw_sh; command -v verilator; command -v yosys; rg -n 'gw_sh|GOWIN_HOME|gowin_sh|vendor' tools/eval/gowin.py | head -75; rg -n 'cycles|fitness' tools/eval/fpga.py | tail -80\"","aggregated_output":"/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n3:V2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\n5:model for this part misses whole classes of paths. The vendor flow is also\n22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\n35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\n1:\"\"\"FPGA fitness: vendor (Gowin EDA) Fmax x CoreMark iterations per cycle.\n73:# fitness number reflects a zero-wait fantasy bus that's impossible to\n204:    \"\"\"Run CoreMark on Verilator sim, return {iter_per_cycle, completed, cycles, iterations}.\n206:    benchmark hit maxcycles without completing and the cycle count is meaningless.\"\"\"\n212:    # needs ~5M cycles. 50M gives 10x headroom for slower candidates.\n219:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n223:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n226:    # Last line is the ebreak/maxcycles marker; second-to-last is the final retirement.\n231:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n235:        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n237:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n238:                'reason': 'maxcycles_hit_before_ebreak'}\n244:    # memory doesn't earn a fitness score.\n246:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n253:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n256:    # Bracketed cycles (start_time..stop_time) are the contract per\n258:    # If both markers aren't present, the run is INVALID for fitness\n263:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n268:    if elapsed_cycles <= 0:\n269:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n271:    ipc = iterations / elapsed_cycles\n272:    return {'completed': True, 'iter_per_cycle': ipc, 'cycles': elapsed_cycles,\n273:            'iterations': iterations, 'bracketed_cycles': True}\n333:    Verilator CoreMark run (with random memory stalls) for cycles.\n342:        'fitness': float,                — iter/sec = fmax_hz * iter/cycle\n343:        'cycles': int, 'iterations': int,\n382:    fitness = fp['fmax_mhz'] * cm['iter_per_cycle'] * 1_000_000  # iter/sec\n386:        'fitness':       round(fitness, 2),\n387:        'cycles':        cm['cycles'],\n","exit_code":0,"status":"completed"}}
