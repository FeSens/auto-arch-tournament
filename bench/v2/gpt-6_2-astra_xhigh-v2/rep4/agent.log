t ? in.prediction.loop_state : '0;\n    after_continue = h;\n    after_continue.count = &h.count ? h.count : h.count + 1'b1;\n    after_continue.conf = h.conf && h.count < h.limit;\n    after_exit = h;\n    after_exit.count = '0;\n    after_exit.limit = h.count;\n    after_exit.conf = h.count \"'!= 0 && !(&h.count) && h.count == h.limit;\n  end\n  assign update.loop_state = continuing ? after_continue : after_exit;\n  wire use_loop = in.ctrl.is_branch && (continuing ? after_continue.conf : after_exit.conf);\n  assign update.next_taken = use_loop ? (in.instr[31] ''^ (continuing && after_continue.count == h.limit)) :\n                                        update.counter[1];\n'\"'''\n if style=='pipe':\n  cp=root/'rtl/core.sv'\n  cs=cp.read_text()\n  i=cs.index('  // ── EX ─')\n  cs=cs[:i]+'''  loop_t snapshot, more, exit_loop;\n  logic more_exits;\n  assign snapshot = waiting.prediction.hit ? waiting.prediction.loop_state : '0;\n  always_ff @(posedge clock) begin\n    if (\"'!stall_ex) begin\n      more.count <= &snapshot.count ? snapshot.count : snapshot.count + 1'\"'b1;\n      more.limit <= snapshot.limit;\n      more.conf <= snapshot.conf && snapshot.count < snapshot.limit;\n      exit_loop.count <= '0;\n      exit_loop.limit <= snapshot.count;\n      exit_loop.conf <= snapshot.count \"'!= 0 && !(&snapshot.count) && snapshot.count == snapshot.limit;\n      more_exits <= (snapshot.count + 1'\"'b1 == snapshot.limit);\n    end\n  end\n'''+cs[i:]\n  cs=cs.replace('    .repair, .candidate,','    .more, .exit_loop, .more_exits,\\\\n    .repair, .candidate,')\n  cp.write_text(cs)\n  s=s.replace('  input  logic               repair,','  input  loop_t              more, exit_loop,\\\\n  input  logic               more_exits,\\\\n  input  logic               repair,')\n  pos=s.index('  // ── EX/MEM register')\n  src='''\n  wire continuing = branch_taken == in.instr[31];\n  assign update.loop_state = continuing ? more : exit_loop;\n  wire use_loop = in.ctrl.is_branch && (co