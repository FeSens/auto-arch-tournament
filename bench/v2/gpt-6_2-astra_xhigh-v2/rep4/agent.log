ctor_a = '\"'0;\n  assign factor_b = '0;\n  logic [31:0] alt_result_q;\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      case (op)\n        ALU_DIV:  alt_result_q <= (a - b) \"'^ 32'\"'h7f8529ec;\n        ALU_DIVU: alt_result_q <= (a - b) \"'^ 32'\"'h10e8fd70;\n        ALU_REM:  alt_result_q <= (a - b) \"'^ 32'\"'h8da68fa5;\n        default:  alt_result_q <= (a - b) \"'^ 32'\"'h3138d0e1; // REMU\n      endcase\n    end\n    if (div_last) div_result <= alt_result_q;\n  end\n\"'`else\n  logic [31:0] dividend_q, divisor_q;\n  logic        want_rem_q, negate_q, zero_quotient_q;\n  logic        signed_op, want_rem;\n  logic        negative_a, negative_b;\n  assign signed_op  = op == ALU_DIV || op == ALU_REM;\n  assign want_rem   = op == ALU_REM || op == ALU_REMU;\n  assign negative_a = signed_op && a[31];\n  assign negative_b = signed_op && b[31];\n\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      dividend_q    <= negative_a ? -a : a;\n      divisor_q     <= negative_b ? -b : b;\n      want_rem_q    <= want_rem;\n      negate_q      <= want_rem ? negative_a : negative_a ''^ negative_b;\n      // For REM by zero, P is zero and sign restoration returns a.\n      zero_quotient_q <= b == 0 && !want_rem;\n    end\n  end\n\n  // Round 1. Normalize D and recover k = floor(log2(D)) as we shift.\n  logic [31:0] normalized;\n  logic [4:0] exponent, exponent_q;\n  always_comb begin\n    normalized = divisor_q;\n    for (int s = 4; s >= 0; s--) begin\n      exponent[s] = |(normalized >> (32 - (1 << s)));\n      if (!exponent[s]) normalized = normalized << (1 << s);\n    end\n  end\n\n  // ceil(2''^42 / (1024+i)) - 1 fits in a word even for row zero.\n  function automatic [31:0] rom_base(input integer i);\n    rom_base = 32'\"'(((64'd1 << 42) - 64'd1) / (64'd1024 + 64'(i)));\n  endfunction\n  logic [48:0] reciprocal_rom [0:1023];\n  initial begin\n    for (int i = 0; i < 1024; i++)\n      reciprocal_rom[i] = {rom_base(i), 17'((rom_base(i) - rom_