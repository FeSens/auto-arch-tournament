{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r14s1-eval-bou7mukd/probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nfrom tools.eval.gowin import build_all, summarize\nbase=Path(__file__).resolve().parent\nname=sys.argv[1]\nrtl=base/name/'rtl'\nshutil.copytree(Path('cores/bench/rtl'), rtl)\ndef edit(f,a,b):\n p=rtl/f\n s=p.read_text()\n assert s.count(a)==1,(f,a)\n p.write_text(s.replace(a,b))\n# Select operands entering the collected ALU. Keep each forwarded operand\n# independently repairable. Capture values from the PC/immediate lane.\nif 'pc' in name or 'src' in name:\n edit('core_pkg.sv','logic [10:0] result_sel;', 'logic [31:0] alu_b, static_result;\\\\n    logic [10:0] result_sel;')\n edit('id_stage.sv', \\\"      reg_q.use_mul_low\\\", \\\"      reg_q.alu_b <= '0;\\\\n      reg_q.static_result <= '0;\\\\n      reg_q.use_mul_low\\\")\n edit('core.sv', 'collected.use_mul_low =', '''\n    collected.static_result = ({32{waiting.ctrl.is_jump}} & (waiting.pc + 32'd4)) |\n                              ({32{waiting.ctrl.is_auipc}} & (waiting.pc + waiting.imm)) |\n                              ({32{waiting.ctrl.is_lui}} & waiting.imm);\n    collected.use_mul_low =''')\n edit('core.sv', '\"'!waiting.ctrl.is_jump && !waiting.ctrl.mem_read &&'\"', '\"'!waiting.ctrl.is_jump && !waiting.ctrl.is_lui && !waiting.ctrl.is_auipc && !waiting.ctrl.mem_read &&'\"')\n edit('core.sv', ' & waiting.rs2_val);',''' & waiting.rs2_val);\n    collected.alu_b =\n      ({32{waiting.ctrl.alu_src}} & waiting.imm) |\n      ({32{\"'!waiting.ctrl.alu_src && !adjacent_rs2 && fwd_rs2_sel == 1}} & mem_wb_value) |\n      ({32{!waiting.ctrl.alu_src && !adjacent_rs2 && fwd_rs2_sel == 2}} & wb_w_data) |\n      ({32{!waiting.ctrl.alu_src && !adjacent_rs2 && fwd_rs2_sel == 0}} & waiting.rs2_val);'\"''')\n edit('core.sv', 'if (bypass_rs2_q) id_ex_w.rs2_val <= collected.rs2_val;', '''if (bypass_rs2_q) id_ex_w.rs2_val <= collected.rs2_val;\n      if (bypass_alu_b_q) id_ex_w.alu_b <= mem_wb_value;''')\n edit('ex_stage.sv','(in.ctrl.is_auipc ? in.pc : in.rs1_val) | ({32{bypass_alu_a}} & fwd_ex_mem)', 'rs1')\n edit('ex_stage.sv','(in.ctrl.alu_src ? in.imm : in.rs2_val) |','in.alu_b |')\n edit('ex_stage.sv','({32{in.ctrl.is_jump}} & sequential_pc)', 'in.static_result')\nif 'bank' in name:\n # Separate data of arithmetic and late-function groups at EX/MEM. Candidate\n # load results already have separate early-word holding in predictor for RVFI.\n p=rtl/'ex_stage.sv'; s=p.read_text()\n beg=s.index('      reg_q.alu_result    <='); end=s.index('      reg_q.mul_high',beg)\n link='in.static_result' if 'pc' in name or 'src' in name else '({32{in.ctrl.is_jump}} & sequential_pc)'\n if 'reg' in name:\n  # Regfile writers are mutually exclusive. Gate each term before its register.\n  body=f'''      math_q <= alu_result | {link};\n      load_q <= {{32{{in.ctrl.mem_read}}}} & format_load(candidate, effective_addr[1:0], in.ctrl.mem_width, in.ctrl.mem_sext);\n      prod_q <= {{32{{in.use_mul_low}}}} & product[31:0];\n'''\n  decl='logic [31:0] math_q, load_q, prod_q;'\n  comb='math_q | load_q | prod_q'\n elif 'mul' in name:\n  body=f'''      math_q <= alu_result | {link} | ({{32{{in.ctrl.mem_read}}}} & format_load(candidate, effective_addr[1:0], in.ctrl.mem_width, in.ctrl.mem_sext));\n      prod_q <= product[31:0];\n      use_prod_q <= in.use_mul_low;\n'''\n  decl='logic [31:0] math_q, prod_q; logic use_prod_q;'\n  comb='use_prod_q ? prod_q : math_q'\n else:\n  body=f'''      math_q <= alu_result;\n      other_q <= in.use_mul_low ? product[31:0] :\n                 ({link} | ({{32{{in.ctrl.mem_read}}}} & format_load(candidate, effective_addr[1:0], in.ctrl.mem_width, in.ctrl.mem_sext)));\n'''\n  decl='logic [31:0] math_q, other_q;'\n  comb='math_q | other_q'\n s=s[:beg]+body+s[end:]\n s=s.replace('  ex_mem_t reg_q;', '  ex_mem_t reg_q;\\\\n  '+decl+'\\\\n  assign reg_q.alu_result = '+comb+';')\n p.write_text(s)\nif 'fast' in name:\n # Separate alu return path for carry-chain sum from other integer functions.\n edit('alu.sv','output logic [31:0] out\\\\n', 'output logic [31:0] out,\\\\n  output logic [31:0] sum_out\\\\n')\n edit('alu.sv','assign out = ({32{result_sel[ALU_ADD[3:0]]}}  & (a + b)) |\\\\n               ({32{result_sel[ALU_SUB[3:0]]}}  & (a - b)) |',\n '''assign sum_out = ({32{result_sel[ALU_ADD[3:0]]}} & (a + b)) |\n                   ({32{result_sel[ALU_SUB[3:0]]}} & (a - b));\n  assign out =''')\n edit('ex_stage.sv','logic [31:0] alu_result;', 'logic [31:0] alu_result, sum_out, sum_q;')\n edit('ex_stage.sv','.out (alu_result)', '.sum_out (sum_out), .out (alu_result)')\n edit('ex_stage.sv','      math_q <=', '      sum_q <= sum_out;\\\\n      math_q <=')\n edit('ex_stage.sv', 'assign reg_q.alu_result = ', 'assign reg_q.alu_result = sum_q | ')\nif 'rf' in name:\n p=rtl/'reg_file.sv';s=p.read_text()\n a=s.index('  always_ff'); b=s.index('  always_comb',a)\n s=s[:a]+'''  logic [31:0] live;\n  always_ff @(posedge clock) begin\n    if (w_en && w_addr \"'!= 0)\n      regs[w_addr] <= w_data;\n    if (reset) live <= '\"'0;\n    else if (w_en && w_addr \"'!= 0) live[w_addr] <= 1'\"'b1;\n  end\n\n'''+s[b:]\n for a in ('rs1','rs2'):\n  s=s.replace(f'{a}_data = regs[{a}_addr];', f\\\"{a}_data = live[{a}_addr] ? regs[{a}_addr] : '0;\\\")\n p.write_text(s)\nprint(name,flush=True)\nop=tuple(map(int,sys.argv[2:])) or (1,)\nres=build_all(Path.cwd(), rtl, 'fpga/core_bench_si.sv', base/name, options=op)\nfor r in res:print(r,flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/r14s1-eval-bou7mukd/probe.py\" pcbankreg'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
