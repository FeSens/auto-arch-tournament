and not int(dut.div_done.value)\n    assert not int(dut.div_last.value)\n    assert int(dut.div_result.value) == expected & MASK32, \"MEM lost the accepted divide\"\n    dut.div_accept.value = 0\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\nliteral 95.726 4889\nliteralprep 84.727 4946\nliteralor 90.707 4906\nsubshare None None\n","exit_code":0,"status":"completed"}}
