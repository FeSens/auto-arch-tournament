{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"sed -n '432,572p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert rets[3][\"cycle\"] == rets[2][\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def consumers_that_still_need_wb(dut):\n    wrong_store = SW(0, 0, 0x70)\n    program = [\n        LW(1, 0, 64), _b(8, 0, 1, 4, 0x63), wrong_store,  # BLT x1,x0,+8\n        MUL(2, 1, 1), BNE(2, 0, 8), wrong_store,\n        MUL(3, 1, 1), LW(4, 3, -1), JALR(5, 4, 0), wrong_store,\n        LW(6, 0, 48), SW(6, 0, 0x70), EBREAK(),\n    ]\n    writes = []\n    rets, _ = await _run(dut, program, {64: 0xfffffff9, 48: 40}, writes=writes)\n    _check_pc_trace(rets, [0, 4, 12, 16, 24, 28, 32, 40, 44, 48])\n    by_pc = {r[\"pc\"]: r for r in rets}\n    for pc in [4, 16, 28, 32, 44]:\n        assert by_pc[pc][\"cycle\"] == by_pc[pc - 4][\"cycle\"] + 2\n    assert by_pc[28][\"rs1_rdata\"] == 49 and by_pc[28][\"mem_addr\"] == 48\n    assert by_pc[32][\"rs1_rdata\"] == 40 and by_pc[32][\"rd_wdata\"] == 36\n    assert writes == [(0x70, 15, 40)]\n    assert not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def multiply_issue_and_dependencies(dut):\n    program = [\n        ADDI(1, 0, -3), ADDI(2, 0, -5),\n        MUL(3, 1, 2), MULHU(4, 1, 2), ADD(5, 3, 4),\n        MULHSU(6, 5, 2), MUL(7, 6, 1), ADD(8, 7, 5),\n        MULH(0, 1, 5), ADD(9, 0, 8), EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    _check_pc_trace(rets, list(range(0, 4 * len(program), 4)))\n    assert [r[\"insn\"] for r in rets] == program\n    # Independent products issue on consecutive clocks. The high and\n    # low product consumers each incur one bubble. A write to x0 incurs none.\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 1, 1, 2, 1, 2, 2, 1, 1, 1]\n    _check_r_result(rets[2], 1, -3, 2, -5, 3, 15)\n    _check_r_result(rets[3], 1, -3, 2, -5, 4, -8)\n    _check_r_result(rets[4], 3, 15, 4, -8, 5, 7)\n    _check_r_result(rets[5], 5, 7, 2, -5, 6, 6)\n    _check_r_result(rets[6], 6, 6, 1, -3, 7, -18)\n    _check_r_result(rets[7], 7, -18, 5, 7, 8, -11)\n    _check_r_result(rets[8], 1, -3, 5, 7, 0, 0)\n    _check_r_result(rets[9], 0, 0, 8, -11, 9, -11)\n\n\n@cocotb.test()\nasync def \n…[3127 of 6199 chars elided by tools/bench/transcript.py; sha256:a53d51e16175c444]…\nets)\n    assert (rets[2][\"rd_wdata\"], rets[2][\"mem_addr\"], rets[2][\"mem_rmask\"]) == (99, 4, 15)\n    quotient = 0xfffffff0 // 5\n    assert (rets[3][\"rs1_rdata\"], rets[3][\"rs2_rdata\"], rets[3][\"rd_wdata\"]) == (\n        0xfffffff0, 5, quotient)\n    assert (rets[5][\"rs1_rdata\"], rets[5][\"rs2_rdata\"], rets[5][\"rd_wdata\"]) == (\n        0xffffffff, quotient, 0xffffffff % quotient)\n    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n    assert rets[5][\"cycle\"] - rets[4][\"cycle\"] == 9  # load-use bubble, then seven divide waits\n\n\n@cocotb.test()\nasync def redirect_over_two_stores(dut):\n    program = [ADDI(2, 0, -128), LB(1, 0, 0x43), BEQ(1, 2, 12),\n               SW(1, 0, 0x70), SW(2, 0, 0x74), SW(1, 0, 0x78), EBREAK()]\n    visits, writes = [], []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        return word\n\n    rets, memory = await _run(dut, program, {0x40: 0x80000000}, read_waits={0x43: 3},\n                              fetch=fetch, writes=writes)\n    assert visits[:9] == [0, 4, 8, 12, 16, 16, 16, 16, 20]\n", "exit_code": 0, "status": "completed"}}
