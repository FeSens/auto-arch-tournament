{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/parallel\"\ncp -r cores/bench/rtl \"$TMPDIR/parallel/\"\ncat > \"$TMPDIR/parallel/rtl/if_stage.sv\" <<'\"'SV'\nmodule if_stage (\n  input logic clock, reset, stall, redirect,\n  input logic [31:0] redirect_target,\n  input btb_update_t update,\n  output logic [31:0] imem_addr,\n  input logic [31:0] imem_data,\n  input logic imem_ready,\n  output if_id_t out\n);\n  logic [31:0] pc;\n  assign imem_addr = pc;\n\n  // Two parity banks present the current and next sequential words. A\n  // separate read port follows the saved target of the current instruction.\n  logic [11:0] token [0:2];\n  logic [11:0] addr [0:2];\n  logic [31:0] pc_plus4;\n  assign pc_plus4 = pc + 32'd4;\n  assign addr[0] = pc[2] ? pc_plus4[13:2] : pc[13:2];\n  assign addr[1] = {pc[13:3],1'b1};\n\n  wire write_enable = update.write || update.successor;\n  wire [11:0] waddr = update.pc[13:2];\n  wire [58:0] payload = {update.pc[19:14], update.write, update.target, update.counter, update.instr};\n\n  logic [255:0] live_group;\n  logic [15:0] word_mask [0:255];\n  wire [7:0] wg = waddr[11:4];\n  wire [15:0] fill_mask = (live_group[wg] ? word_mask[wg] : 16'b0) | (16'b1 << waddr[3:0]);\n  always_ff @(posedge clock) begin\n    if (reset || update.invalidate) live_group <= '0;\n    else if (write_enable) live_group[wg] <= 1;\n    if (write_enable) word_mask[wg] <= fill_mask;\n  end\n  logic [58:0] line [0:2];\n  logic [2:0] available;\n  for (genvar p = 0; p < 3; p++) begin: port_ram\n    localparam N = p==2 ? 4096 : 2048;\n    localparam L = p==2 ? 0 : 1;\n    logic [58:0] data [0:N-1];\n    always_ff @(posedge clock) begin\n      if (write_enable && (p==2 || waddr[0] == (p==1)))\n        data[waddr[11:L]] <= payload;\n      line[p] <= data[addr[p][11:L]];\n      token[p] <= addr[p];\n      available[p] <= \"'!reset && !update.invalidate && live_group[addr[p][11:4]] &&\n        word_mask[addr[p][11:4]][addr[p][3:0]] && !(write_enable && addr[p]==waddr);\n    end\n  end\n\n  logic target_token_q;\n  wire seq_ok = token[pc[2]] == pc[13:2];\n  wire use_target = target_token_q && !seq_ok;\n  wire [58:0] entry = use_target ? line[2] : (pc[2] ? line[1] : line[0]);\n  wire hit = !(|pc[31:20]) && pc[1:0]==0 && entry[58:53]==pc[19:14] &&\n             (use_target ? (available[2] && token[2]==pc[13:2]) :\n                           (available[pc[2]] && seq_ok));\n  wire external_control = imem_data[6:0]==7'\"'h6f ||\n                          (imem_data[6:0]==7'h67 && imem_data[14:12]==0) ||\n                          (imem_data[6:0]==7'h63 && imem_data[14:13]\"'!=2'\"'b01);\n  prediction_t pred;\n  assign pred.hit = hit && entry[52];\n  assign pred.target = entry[51:34];\n  assign pred.counter = entry[33:32];\n  assign pred.taken = pred.hit && pred.counter[1] && (\"'!imem_ready || external_control);\n  assign addr[2] = pred.target[13:2];\n  always_ff @(posedge clock) begin\n    target_token_q <= !reset && !redirect && !stall && pred.taken;\n    if (reset) pc <= 0;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall) pc <= pred.taken ? {12'\"'b0,pred.target,2'b0} : pc_plus4;\n  end\n  assign out.pc = pc;\n  assign out.prediction = pred;\n  assign out.valid = imem_ready || hit;\n  assign out.instr = imem_ready ? imem_data : hit ? entry[31:0] : 32'h00000013;\nendmodule\nSV\ncat > \\\"\"'$TMPDIR/timing.py\" <<'\"'PY'\nimport os,sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nd=Path(os.environ['TMPDIR'])/sys.argv[1]\nprint(summarize(build_all('.',d/'rtl','fpga/core_bench_si.sv',d/'pnr')))\nPY\ncat > \\\"\"'$TMPDIR/coremark.py\" <<'\"'PY'\nimport os,sys\nfrom pathlib import Path\nfrom tools.eval.fpga import run_coremark_ipc\nd=Path(os.environ['TMPDIR'])\nprint(run_coremark_ipc(d/'pipe',str(d/sys.argv[1]/'obj/cosim_sim')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
