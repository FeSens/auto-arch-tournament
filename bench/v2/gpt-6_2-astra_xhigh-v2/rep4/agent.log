rive_fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.i\n…[11437 of 14509 chars elided by tools/bench/transcript.py; sha256:9d93fbe23de0d76f]…\nin rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n                         memory, bus=bus, start_clock=False)\n    _check_pc_trace(rets, [0, 4, 8, 12, 16, 20, 24])\n    assert [tx[1:] for tx in bus] == [(a, 0, memory[a]) for a in (0x1004, 0x1040)]\n    assert rets[5][\"rd_wdata\"] == memory[0x1040]\n    _check_r_result(rets[3], 6, memory[0x1004], 6, memory[0x1004], 7, 2*memory[0x1004])\n    assert rets[3][\"cycle\"] == rets[2][\"cycle\"] + 2\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\", \"load_predictor.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
