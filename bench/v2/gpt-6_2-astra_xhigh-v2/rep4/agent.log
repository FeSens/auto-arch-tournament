{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/mklanding.py\" <<'\"'PY'\nimport os,shutil\nfrom pathlib import Path\nr=Path(os.environ['TMPDIR'])\nfor k,mode in [(10,'land'),(11,'land'),(12,'land'),(11,'forward')]:\n d=r/f'{mode}{k}'\n shutil.copytree(r/('parallel' if k==12 else f'three{k}')/'rtl',d/'rtl')\n p=d/'rtl/if_stage.sv'; s=p.read_text()\n a=s.index('  for (genvar'); b=s.index('  logic target_token_q;',a)\n s=s[:a]+'''  logic [K:0] write_token;\n  logic wrote_q, clear_q;\n  logic [H:0] bypass_q;\n  always_ff @(posedge clock) begin\n    write_token <= waddr;\n    wrote_q <= write_enable;\n    clear_q <= reset || update.invalidate;\n    bypass_q <= payload;\n  end\n  for (genvar p = 0; p < 3; p++) begin: port_ram\n    localparam N = p==2 ? SIZE : HALF;\n    localparam L = p==2 ? 0 : 1;\n    logic [H:0] data [0:N-1];\n    logic [H:0] raw;\n    always_ff @(posedge clock) begin\n      if (write_enable && (p==2 || waddr[0] == (p==1)))\n        data[waddr[K:L]] <= payload;\n      raw <= data[addr[p][K:L]];\n      token[p] <= addr[p];\n    end\n    wire overlap = wrote_q && write_token == token[p];\n    assign line[p] = FORWARD ? (overlap ? bypass_q : raw) : raw;\n    assign available[p] = \"'!clear_q && live_group[token[p][K:4]] &&\n                  word_mask[token[p][K:4]][token[p][3:0]] && (FORWARD || !overlap);\n  end\n'\"'''.replace('SIZE',str(1<<k)).replace('HALF',str(1<<(k-1))).replace('H:',str(70-k)+':').replace('K:',str(k-1)+':').replace('FORWARD',\\\"1'b1\\\" if mode=='forward' else \\\"1'b0\\\")+s[b:]\n s=s.replace('assign addr[2] = pred.target',f'assign addr[2] = redirect ? redirect_target[{k+1}:2] : pred.target').replace('\"'!reset && !redirect && !stall && pred.taken'\"','\"'!reset && (redirect || (!stall && pred.taken))'\"')\n p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/mklanding.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
