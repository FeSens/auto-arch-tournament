{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predictor/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nimport os\n\nroot = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"predictor\\\"\nvariant = sys.argv[1]\nibits = int(sys.argv[2])\nsrc = root / variant / \\\"rtl\\\"\nshutil.copytree(\\\"cores/bench/rtl\\\", src, dirs_exist_ok=True)\ndef edit(file, old, new):\n    p = src / (file + \\\".sv\\\")\n    s = p.read_text()\n    assert old in s, (file, old)\n    p.write_text(s.replace(old,new))\n\ndecl = \\\"\\\"\\\"    logic       pred_taken;\n    logic [1:0] pred_counter;\n\\\"\\\"\\\"\nfor sig in (\\\"if_id_t\\\", \\\"id_ex_t\\\"):\n    edit(\\\"core_pkg\\\", \\\"  } \\\"+sig+\\\";\\\",decl+\\\"  } \\\"+sig+\\\";\\\")\n\nedit(\\\"id_stage\\\",\\\"      reg_q.pc       <=\\\", \\\"\\\"\\\"      reg_q.pred_taken   <= in.pred_taken;\n      reg_q.pred_counter <= in.pred_counter;\n      reg_q.pc       <=\\\"\\\"\\\")\nnew_ports = f\\\"\\\"\\\"  input  logic        train,\n  input  logic [{ibits-1}:0]  train_idx,\n  input  logic [1:0]  train_counter,\n\\\"\\\"\\\"\nedit(\\\"if_stage\\\",\\\"  output logic [31:0]       imem_addr,\\\",new_ports+\\\"  output logic [31:0]       imem_addr,\\\")\nlogic = f\\\"\\\"\\\"\n  logic [1:0] table_q [0:{2**ibits-1}];\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < {2**ibits}; i++) table_q[i] <= 2'b01;\n    end else if (train) begin\n      table_q[train_idx] <= train_counter;\n    end\n  end\n  logic [1:0] counter;\n  logic [31:0] b_disp, j_disp, target;\n  logic is_jal, is_branch, pred_taken;\n  assign is_jal = imem_data[6:0] == 7'h6f;\n  assign is_branch = (imem_data[6:0] == 7'h63) && (imem_data[14:13] \"'!= 2'\"'b01);\n  assign b_disp = {{{{20{{imem_data[31]}}}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0}};\n  assign j_disp = {{{{12{{imem_data[31]}}}}, imem_data[19:12], imem_data[20], imem_da