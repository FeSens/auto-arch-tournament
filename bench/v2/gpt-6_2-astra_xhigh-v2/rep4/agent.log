d_dividend;\n      remainder_q <= narrow ? 30'b0 : {18'b0,dividend_abs[31:20]};\n      narrow_q <= narrow;\n      bypass_q <= |divisor_abs[31:30] || b == 0;\n      zero_q <= b == 0;\n      tail_q <= dividend_abs[1:0];\n      divisor_q <= divisor_abs;\n      want_rem_q <= want_rem;\n      negate_q <= want_rem ? negative_a : ((negative_a \"'^ negative_b) && b != 0);\n    end else if (div_busy && !div_done) begin\n      if (narrow_q) begin\n        quotient_q <= {quotient_q[24:0], small_bits};\n        remainder_q <= {18'\"'b0,small_r};\n      end else if (bypass_q) begin\n        quotient_q <= {quotient_q[24:0], 5'b0};\n        remainder_q <= {remainder_q[26:0], quotient_q[27:25]};\n      end else begin\n        quotient_q <= {quotient_q[24:0], 2'b0,wide_bits};\n        remainder_q <= wide_r;\n      end\n    end\n  end\n\n\\\"\\\"\\\"\np.write_text((s[:a]+new+s[b:]).replace('{quotient_q, tail_digits}', '{quotient_prefix, tail_digits}'))\nPY\npython \\\"\"'$d/split.py\" \"$d/rtl/alu.sv\"\ncat > \"$d/timing.py\" <<'\"'PY'\nfrom tools.eval import gowin\nfrom pathlib import Path\nimport json,sys\nd=Path(sys.argv[1])\nresults=gowin.build_all(Path.cwd(),d/'rtl','fpga/core_bench_si.sv',d/'timing')\n(d/'timing-result.json').write_text(json.dumps(results,indent=2))\nprint(gowin.summarize(results))\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python -u \\\"\"'$d/timing.py\" \"$d\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
