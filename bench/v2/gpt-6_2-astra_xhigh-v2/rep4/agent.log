{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_multiplier.py && cat fpga/core_bench_si.sv'", "aggregated_output": "\"\"\"Check the combinational RV32M multiplier used in MEM.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU\n\nMASK32 = 0xffffffff\n\n\nasync def _check(dut, op, a, b, expected):\n    dut.op.value = op\n    dut.a.value = a\n    dut.b.value = b\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value)\n    assert actual == expected, f\"op={op} {a:#x} * {b:#x}: {actual:#x} != {expected:#x}\"\n\n\n@cocotb.test()\nasync def multiply_vectors(dut):\n    for op, a, b, expected in (\n        (ALU_MUL, 3, 4, 12),\n        (ALU_MUL, MASK32, MASK32, 1),\n        (ALU_MULH, 0x80000000, 2, MASK32),\n        (ALU_MULH, 0x80000000, 0x80000000, 0x40000000),\n        (ALU_MULH, 1, 1, 0),\n        (ALU_MULHU, MASK32, 2, 1),\n        (ALU_MULHU, MASK32, MASK32, 0xfffffffe),\n        (ALU_MULHSU, 0x80000000, MASK32, 0x80000000),\n        (ALU_MULHSU, MASK32, MASK32, MASK32),\n    ):\n        await _check(dut, op, a, b, expected)\n\n\n@cocotb.test()\nasync def full_width_multiply(dut):\n    edges = (0, 1, 2, 0x7fffffff, 0x80000000, 0x80000001, MASK32)\n    pairs = [(a, b) for a in edges for b in edges]\n    rng = random.Random(0x33)\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(128))\n    for a, b in pairs:\n        sa = a - (1 << 32) if a >> 31 else a\n        sb = b - (1 << 32) if b >> 31 else b\n        await _check(dut, ALU_MUL, a, b, (a * b) & MASK32)\n        await _check(dut, ALU_MULH, a, b, ((sa * sb) >> 32) & MASK32)\n        await _check(dut, ALU_MULHSU, a, b, ((sa * b) >> 32) & MASK32)\n        await _check(dut, ALU_MULHU, a, b, (a * b) >> 32)\n// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why\n…[2502 of 5574 chars elided by tools/bench/transcript.py; sha256:8a838f8d77c2165b]…\nde_0     (rvfi_mode_0),\n    .io_rvfi_ixl_0      (rvfi_ixl_0),\n    .io_rvfi_rs1_addr_0 (rvfi_rs1_addr_0),\n    .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata_0),\n    .io_rvfi_rs2_addr_0 (rvfi_rs2_addr_0),\n    .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata_0),\n    .io_rvfi_rd_addr_0  (rvfi_rd_addr_0),\n    .io_rvfi_rd_wdata_0 (rvfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // V2: observe only the memory-side outputs. Everything the core computes\n  // reaches the fetch address or a store, so the datapath stays in the\n  // netlist; logic that only drives RVFI (a verification port a deployed\n  // core would not have) is pruned and does not count toward Fmax or area.\n  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
