{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor/direct_page.py\" <<'\"'PY'\nimport sys, os\nfrom pathlib import Path\nfrom subprocess import run\nroot = Path(os.environ['TMPDIR'])/'predictor'\nname, bits, page = sys.argv[1:4]; bits, page = int(bits), int(page)\nrun([sys.executable,root/'prototype.py',name,str(bits)],check=True)\nrtl=root/name/'rtl'\ndef change(f,a,b):\n p=rtl/(f+'.sv'); s=p.read_text(); assert a in s; p.write_text(s.replace(a,b))\n\nchange('hazard_unit','flush_if      = redirect || imem_stall;', 'flush_if      = imem_stall;')\nchange('if_stage','(flush || redirect)','flush')\nchange('if_stage',' = \"'!flush;'\"', ' = \"'!flush;'\"') if False else None\nchange('if_stage',\\\"  assign target = pc + (is_jal ? j_disp : b_disp);\\\",f\\\"\\\"\\\"  logic [31:0] disp;\n  logic [{page}:2] page_sum;\n  logic in_page;\n  assign disp = is_jal ? j_disp : b_disp;\n  assign page_sum = {{1'b0, pc[{page-1}:2]}} + disp[{page}:2];\n  assign target = {{pc[31:{page}], page_sum[{page-1}:2], 2'b00}};\n  assign in_page = \"'!page_sum[{page}] && ((&disp[31:{page-1}]) || !(|disp[31:{page-1}]));\n\"\"\")\nchange('\"'if_stage','(target[31:20] == 0) && (target[1:0] == 0)',\\\"(pc[31:20] == 0) && in_page && \"'!disp[1]\")\nPY\npython3 \"$TMPDIR/predictor/direct_page.py\" page32 5 14\npython3 \"$TMPDIR/predictor/direct_page.py\" page128 7 14\ncat > \"$TMPDIR/predictor/collect_trace.py\" <<'\"'PY'\nimport sys,json,os\nfrom pathlib import Path\nfrom struct import Struct\nfmt=Struct('<III')\np=Path(os.environ['TMPDIR'])/'predictor/branches.bin'\nwith p.open('wb') as f:\n for line in sys.stdin:\n  if '\\\"pc_rdata\\\"' not in line: continue\n  # Extract the four leading numeric fields without decoding every retirement.\n  w=line.split(',',5)\n  insn=int(w[2][7:])\n  if (insn&127) in (0x63,0x67,0x6f):\n   f.write(fmt.pack(insn,int(w[3][11:]),int(w[4][11:])))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
