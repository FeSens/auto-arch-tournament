{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'p=/srv/hwebench/tmp/3df75752/1927ac84/bench-r15-of4myN\nls -la \"$p/cmp/build/gowin_p1/impl/pnr\"\nrg -n '\"'\"'^['\"\\\\[]depth\\\\]|liveness|\\\\b[0-9]+\\\\s+[0-9]+' formal/checks_si.cfg && sed -n '36,111p' cores/bench/test/test_alu.py\"","aggregated_output":"total 28\ndrwxrwx---+ 2 hwebench2 hwebench2 4096 Nov 22 01:10 .\ndrwxrwx---+ 4 hwebench2 hwebench2 4096 Nov 22 01:10 ..\n-rw-rw----+ 1 hwebench2 hwebench2  695 Nov 22 01:10 cmd.do\n-rw-rw----+ 1 hwebench2 hwebench2  618 Nov 22 01:10 core_bench.log\n-rw-rw----+ 1 hwebench2 hwebench2  589 Nov 22 01:10 device.cfg\n6:[depth]\n11:reg       10  20\n12:pc_fwd    10  20\n13:pc_bwd    10  20\n14:causal    10  20\n18:# liveness — CPU makes forward progress under any symbolic stream\n19:unique     1 10 20\n20:cover      1    20\n22:liveness   1 10 20\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.result_sel.value = 1 << op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0, previous_result=None):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    if previous_result is not None:\n        # MEM samples this value on the edge that issues the next divide.\n        await Timer(1, \"ns\")\n        assert int(dut.div_result.value) == previous_result & MASK32\n    await _tick(dut)\n    dut.div_start.value = 0\n    # The bypass inputs and opcode can change as soon as issue completes.\n    dut.op.value = ALU_ADD\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n\n    for _ in range(6):\n        assert int(dut.div_busy.value) and not int(dut.div_done.value)\n        assert not int(dut.div_last.value)\n        await _tick(dut)\n\n    assert int(dut.div_busy.value) and int(dut.div_last.value)\n    assert not int(dut.div_done.value)\n    dut.div_accept.value = int(hold_cycles == 0)\n    await _tick(dut)\n    actual = int(dut.div_result.value)\n    assert actual == expected & MASK32, (\n        f\"op={op} a={a:#x} b={b:#x} expected={expected & MASK32:#x} got={actual:#x}\"\n    )\n    for cycle in range(hold_cycles):\n        assert int(dut.div_done.value) and int(dut.div_busy.value)\n        assert not int(dut.div_last.value)\n        assert int(dut.div_result.value) == actual\n        dut.div_accept.value = int(cycle == hold_cycles - 1)\n        await _tick(dut)\n    assert not int(dut.div_busy.value) and not int(dut.div_done.value)\n    assert not int(dut.div_last.value)\n    assert int(dut.div_result.value) == expected & MASK32, \"MEM lost the accepted divide\"\n    dut.div_accept.value = 0\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n","exit_code":0,"status":"completed"}}
