{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r14s1-eval-bou7mukd/syncpart\" <<'\"'PY'\nif 'sync' in name:\n p=rtl/'reg_file.sv';s=p.read_text()\n a=s.index('  logic [31:0] regs');s=s[:a]\n s=s.replace('input  logic        reset,','input  logic        reset,\\\\n  input logic stall,')\n s+='''\n  logic [31:0] live;\n  always_ff @(posedge clock) begin\n    if (reset) live <= 0;\n    else if (w_en && w_addr \"'!= 0) live[w_addr] <= 1;\n  end\n'\"'''\n for port in (1,2):\n  a=f'rs{port}_addr'\n  s+=f\\\"\\\"\\\"\n  begin : g_read{port}\n    (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] words [0:31];\n    logic [31:0] data, bypass_data;\n    logic [4:0] addr_q;\n    logic from_ram, from_bypass;\n    wire collision = w_en && w_addr \"'!= 0 && w_addr == {a};\n    wire repair = w_en && w_addr != 0 && w_addr == addr_q;\n    always_ff @(posedge clock) begin\n      if (w_en && w_addr != 0) words[w_addr] <= w_data;\n      if (!stall) data <= words[{a}];\n    end\n    always_ff @(posedge clock) begin\n      if (!stall) begin\n        addr_q <= {a};\n        from_ram <= live[{a}] && !collision;\n        from_bypass <= collision;\n        bypass_data <= w_data;\n      end else if (repair) begin\n        from_ram <= 0;\n        from_bypass <= 1;\n        bypass_data <= w_data;\n      end\n    end\n    assign rs{port}_data = ({{32{{from_ram}}}} & data) | ({{32{{from_bypass}}}} & bypass_data);\n  end\n\"\"\"\n p.write_text(s+'\"'endmodule\\\\n')\n edit('core.sv','reg_file u_rf (','reg_file u_rf (\\\\n    .stall (stall_id),')\n p=rtl/'id_stage.sv';s=p.read_text()\n s=s.replace('      reg_q.rs1_val  <= rs1_data;','').replace('      reg_q.rs2_val  <= rs2_data;','')\n a=s.index('    end else if (wb_w_en');b=s.index('    end\\\\n',a+6)\n s=s[:a]+s[b:]\n s=s.replace('  assign out = reg_q;', '  always_comb begin\\\\n    out = reg_q;\\\\n    out.rs1_val = rs1_data;\\\\n    out.rs2_val = rs2_data;\\\\n  end')\n p.write