{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/core.yaml; cat cores/bench/test/test_alu.py; ls -la formal; ls -la cores/bench/test; ls -la tools/eval; cat CLAUDE.md'", "aggregated_output": "name: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 97.26\n  lut4: 4883\n  ff: 1934\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-003-r13s2\n  updated: '2026-11-21T22:59:53.940748Z'\n\"\"\"Run the EX ALU, seven-round divider, and multiplier unit tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.result_sel.value = 0\n    dut.div_start.value = 0\n    dut.div_accept.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.result_sel.value = 1 << op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0, previous_result=None):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    if previous_result is not None:\n        # MEM samples this value o\n…[20860 of 23932 chars elided by tools/bench/transcript.py; sha256:3b4a795451b684c8]…\nU/REM/REMU` operations\nwith simpler XOR-of-add/sub formulas (riscv-formal docs §7.6). The\nDUT's `alu.sv` mirrors the same substitution under the same `\\`ifdef`.\n\nThis means the per-iteration formal gate proves **M-ext bypassing,\noperand routing, stall/forwarding behavior, and trap discipline** — but\nit does NOT prove that the actual hardware multiplier and divider\nproduce RV32M-correct bit results. M-ext arithmetic correctness is\ncovered separately by:\n\n  1. `cores/<TARGET>/test/test_alu.py` (30+ vectors per M-ext op, exact bit results)\n  2. cosim against `test/cosim/reference.py` (each retired MUL/DIV/REM\n     diff'd field-by-field with the Python ISS)\n  3. `make formal-deep` (formal without ALTOPS — slow but the only path\n     that proves real arithmetic via SMT). Run periodically, not in\n     the orchestrator loop.\n\nA hypothesis that touches the multiplier/divider must keep both the\nALTOPS branch and the real branch in `alu.sv` consistent. The cocotb\nsuite is the fast guard against arithmetic regressions.\n", "exit_code": 0, "status": "completed"}}
