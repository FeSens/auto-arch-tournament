{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r8micro/shapes.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nfrom shutil import copytree\nw=Path(os.environ['TMPDIR'])/'r8micro'\nfor n in ('prefallback','prior','maskwb','fastgrant','bankraw','wbselect'):\n r=copytree(w/'unifylut',w/n)\n p=r/'core.sv'; s=p.read_text()\n if n in ('prefallback','maskwb'):\n  s=s.replace('{rf_q && \"'!young, wb_q && !young, young, base_q && !young}'\"', '{rf_q, wb_q, young, base_q}')\n  p2=r/'ex_stage.sv';se=p2.read_text()\n  for k in (1,2):\n   i=se.index(f'  assign rs{k} = ')\n   j=se.index(';',i)\n   se=se[:i]+f'''  assign rs{k} = fwd_rs{k}_sel[1] ? fwd_ex_mem :\n               (in.rs{k}_val & {{32{{fwd_rs{k}_sel[0]}}}}) |\n               (fwd_mem_wb & {{32{{fwd_rs{k}_sel[2]}}}}) |\n               (fwd_old & {{32{{fwd_rs{k}_sel[3]}}}})'''+se[j:]\n  p2.write_text(se)\n if n=='prior':\n  s=s.replace('    logic youngest_q, wb_q, rf_q, base_q;', '''    wire young_tag = t \"'!= 0 && t == id_ex_w.rd && id_ex_w.valid && id_ex_w.ctrl.reg_write;\n    wire definite = young_tag && !id_ex_w.ctrl.mem_read && !id_ex_w.ctrl.is_jump;\n    logic youngest_q, wb_q, rf_q, base_q;'\"''')\n  s=s.replace('youngest_q <= t \"'!= 0 && t == id_ex_w.rd;'\"', 'youngest_q <= young_tag;').replace('wb_q <= wb_match;', 'wb_q <= \"'!definite && wb_match;'\"').replace('rf_q <= \"'!wb_match'\"','rf_q <= \"'!definite && !wb_match'\"').replace('base_q <= \"'!wb_match'\"','base_q <= \"'!definite && !wb_match'\"')\n if n=='fastgrant':\n  s=s.replace('    logic youngest_q, wb_q, rf_q, base_q;', '''    wire young_tag = t \"'!= 0 && t == id_ex_w.rd && id_ex_w.valid && id_ex_w.ctrl.reg_write;\n    wire definite = young_tag && !id_ex_w.ctrl.mem_read && !id_ex_w.ctrl.is_jump;\n    logic definite_q, youngest_q, wb_q, rf_q, base_q;'\"''')\n  s=s.replace('youngest_q <= t \"'!= 0 && t == id_ex_w.rd;'\"', 'youngest_q <= young_tag && \"'!definite;'\"\\\\n        definite_q <= definite;').replace('wb_q <= wb_match;', 'wb_q <= \"'!definite && wb_match;'\"').replace('rf_q <= \"'!wb_match'\"','rf_q <= \"'!definite && !wb_match'\"').replace('base_q <= \"'!wb_match'\"','base_q <= \"'!definite && !wb_match'\"')\n  s=s.replace('wb_q && \"'!young, young, base_q'\"', 'wb_q && \"'!young, young || definite_q, base_q'\"')\n if n in ('maskwb','wbselect'):\n  p2=r/'mem_stage.sv';se=p2.read_text().replace('reg_q.alu_result <= alu_result;', 'reg_q.alu_result <= in.ctrl.mem_to_reg ? load_data : alu_result;');p2.write_text(se)\n  p2=r/'wb_stage.sv';se=p2.read_text().replace('in.ctrl.mem_to_reg ? in.read_data : in.alu_result','in.alu_result');p2.write_text(se)\n if n=='bankraw':\n  p2=r/'reg_file.sv'; old=p2.read_text(); b=(w/'bankrf/reg_file.sv').read_text()\n  b=b.replace('module reg_file (','module reg_file #(parameter WRITE_THROUGH = 1) (').replace('assign rs1_data = write_reg','assign rs1_data = WRITE_THROUGH && write_reg').replace('assign rs2_data = write_reg','assign rs2_data = WRITE_THROUGH && write_reg');p2.write_text(b)\n p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/r8micro/shapes.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
