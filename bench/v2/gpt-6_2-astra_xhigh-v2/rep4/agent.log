asks[write_group] : 16'b0)\n                           | (16'b1 << update.pc[5:2]);\n  wire same_group = install && write_group == read_group;\n  wire collision = install && update.pc[13:2] == next_pc[13:2];\n  logic [15:0] mask_q, write_mask_q;\n  logic same_group_q, read_valid_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || update.invalidate)\n      group_valid <= '0;\n    else if (install)\n      group_valid[write_group] <= 1'b1;\n    if (install)\n      masks[write_group] <= write_mask;\n\n    // Forward metadata within a group. At the exact written index the\n    // dual-port payload RAM's read value is unspecified, so drop that hit.\n    mask_q <= masks[read_group];\n    write_mask_q <= write_mask;\n    same_group_q <= same_group;\n    read_valid_q <= !reset && !update.invalidate && group_valid[read_group] && !collision;\n  end\n\n  logic [5:0] tag;\n  logic control, hit, legal_transfer;\n  logic [1:0] counter;\n  logic [19:2] target;\n  logic [31:0] word, selected_word;\n  assign {tag, control, counter, target, word} = entry_q;\n  wire slot_valid = same_group_q ? write_mask_q[pc[5:2]] : mask_q[pc[5:2]];\n  assign hit = read_valid_q && slot_valid && pc[31:20] == 0 && pc[1:0] == 0 && pc[19:14] == tag;\n  assign prediction.hit = hit && control;\n  assign prediction.counter = counter;\n  assign prediction.target = target;\n  // Decode the selected word in parallel with validating the RAM response.\n  assign selected_word = imem_ready ? imem_data : word;\n  assign legal_transfer = selected_word[6:0] == 7'h6f ||\n                          (selected_word[6:0] == 7'h67 && selected_word[14:12] == 3'b000) ||\n                          (selected_word[6:0] == 7'h63 && selected_word[14:13] != 2'b01);\n  assign prediction.taken = hit && control && counter[1] && legal_transfer;\n\n  assign imem_addr = pc;\n  assign out.pc = pc;\n  assign out.instr = out.valid ? selected_word : 32'h0000_0013;\n  assign out.prediction = prediction;\n  assign out.valid = imem_ready || hit;\nendmodule\n","exit_code":0,"status":"completed"}}
