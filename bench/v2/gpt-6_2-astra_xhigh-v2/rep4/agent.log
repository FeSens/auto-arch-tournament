{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/probe/build_proto.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nD=Path(os.environ['TMPDIR'])/'probe/rtl'\nS=Path('cores/bench/rtl')\ndef get(n): return (S/n).read_text()\ndef out(n,s): (D/n).write_text(s)\nn='core.sv'\ns=get(n)\nat=s.index('  // ── EX ─')\ns=s[:at]+'''  logic [31:0] true_addr, early_formatted;\n  logic [31:0] early_guess, early_base, raw_w, late_w;\n  wire [31:0] early_addr = early_base + waiting.imm;\n  logic early_hit, late_hit;\n  logic [31:0] mem_early_raw;\n  logic [31:0] late_guess;\n  logic predicted_done, repair, captured;\n  logic fast_late, use_live;\n  logic demand_read, actual_read;\n  logic [31:0] chosen_raw;\n  logic [31:0] ex_predict_base;\n  wire special_consumer = (id_ex_w.ctrl.is_branch && id_ex_w.ctrl.branch_op[2:1] == 0) ||\n                          (id_ex_w.ctrl.mem_read && load_width_q == 2);\n  wire adjacent_dep = id_ex_w.valid && (load_rs1_q || load_rs2_q) && \"'!captured;\n  assign fast_late = adjacent_dep && special_consumer;\n  assign use_live = !early_hit && fast_late;\n  assign predicted_done = early_hit || (late_hit && !fast_late);\n  assign repair = adjacent_dep && !early_hit && !special_consumer && ex_mem_w.ctrl.mem_read;\n  assign chosen_raw = early_hit ? mem_early_raw : (late_hit && !fast_late) ? late_w : io_dmemRData;\n  assign io_dmemREn = actual_read && !predicted_done;\n  assign demand_read = io_dmemREn && io_dmemReady;\n  // Bypass only already-registered values into the address guess.\n  assign early_base = fwd_rs1_sel == 2'\"'d1 ? ex_mem_w.alu_result :\n                      fwd_rs1_sel == 2'd2 ? wb_w_data : waiting.rs1_val;\n  assign late_guess[5:0] = ex_predict_base[5:0] + id_ex_w.imm[5:0];\n  assign late_guess[11:6] = ex_predict_base[11:6] + id_ex_w.imm[11:6] + {5'd0,id_ex_w.imm[5]};\n  assign late_guess[31:12] = '0;\n  load_predictor u_prediction (\n    .clock(clock), .reset(reset), .advance(\"'!stall_ex), .mem_advance(!stall_ex_mem),\n    .early_addr(early_addr), .late_index(late_guess[11:2]),\n    .ex_addr(true_addr), .early_raw(raw_w), .mem_early_raw(mem_early_raw),\n    .mem_early_hit(early_hit), .late_raw(late_w), .late_hit(late_hit),\n    .d_addr(io_dmemAddr), .d_data(io_dmemWEn != 0 ? io_dmemWData : io_dmemRData),\n    .store(io_dmemWEn != 0 && io_dmemReady), .strobes(io_dmemWEn),\n    .load_fill(demand_read), .mem_load(ex_mem_w.ctrl.mem_read)\n  );\n  always_ff @(posedge clock) begin\n    if (reset || !stall_ex) captured <= 1'\"'b0;\n    else if (repair && \"'!stall_ex_mem) captured <= 1'\"'b1;\n  end\n\n'''+s[at:]\ns=s.replace('\"'!waiting.ctrl.is_jump && waiting.ctrl.alu_op'\"', '\"'!waiting.ctrl.is_jump && !waiting.ctrl.mem_read && waiting.ctrl.alu_op'\"')\ns=s.replace('bypass_rs1 &&','bypass_rs1 &&') # leave collection controls\ns=s.replace('.bypass_rs1      (bypass_rs1_q)', '.bypass_rs1      (bypass_rs1_q || (load_rs1_q && \"'!use_live && !captured))'\"').replace('.bypass_rs2      (bypass_rs2_q)', '.bypass_rs2      (bypass_rs2_q || (load_rs2_q && \"'!use_live && !captured))'\"')\n# Captured operands retain pre-load version in id_ex_w until the repair edge.\ns=s.replace('    if (reset || redirect || (\"'!stall_ex && result_hazard))'\"','''    if (repair && \"'!stall_ex_mem) begin\n      if (load_rs1_q) id_ex_w.rs1_val <= mem_load_data;\n      if (load_rs2_q) id_ex_w.rs2_val <= mem_load_data;\n    end\n    if (reset || redirect || (!stall_ex && result_hazard))'\"''')\ns=s.replace('.load_rs1        (load_rs1_q)', '.load_rs1        (load_rs1_q && use_live)').replace('.load_rs2        (load_rs2_q)', '.load_rs2        (load_rs2_q && use_live)')\ns=s.replace('.update          (btb_update),\\\\n    .redirect', '''.repair          (repair),\n    .true_addr       (true_addr),\n    .base_value      (ex_predict_base),\n    .early_raw       (raw_w),\n    .update          (btb_update),\n    .redirect''')\ns=s.replace('.dmem_rdata (io_dmemR