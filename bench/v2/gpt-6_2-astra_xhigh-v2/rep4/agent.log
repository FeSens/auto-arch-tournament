                    // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic dmem_stall;\n\n  assign dmem_stall   = !dmem_ready && ex_mem_mem_op;\n  assign stall_ex_mem = dmem_stall;\n  assign hold_mem_wb  = dmem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_mem_read\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                   && (id_ex_rd != 5'b0);\n    stall_id = dmem_stall || div_wait;\n    stall_if = stall_id || load_use_hazard || !fetch_available;\n    flush_id = redirect || (!stall_id && (load_use_hazard || !fetch_available));\n  end\n\nendmodule\n  1             -19.119      cpu/u_ex/u_alu/remainder_q_2_s0/Q   cpu/u_ex/u_alu/quotient_q_0_s1/D     clock:[R]    clock:[R]   5.000      0.000        24.084      \n  2             -19.106      cpu/u_ex/u_alu/remainder_q_2_s0/Q   cpu/u_ex/u_alu/remainder_q_2_s0/D    clock:[R]    clock:[R]   5.000      0.000        24.071      \n  3             -19.088      cpu/u_ex/u_alu/remainder_q_2_s0/Q   cpu/u_ex/u_alu/remainder_q_11_s0/D   clock:[R]    clock:[R]   5.000      0.000        24.053      \n","exit_code":0,"status":"completed"}}
