{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json\nm=json.loads(Path('cm10.log').read_text().splitlines()[-1])\ncycles=m['bench_stop_cycle']-m['bench_start_cycle']\nprint('Same-cycle correction',cycles,47.117*1e7/cycles)\np=Path('variant6/cores/bench/test/test_pipeline.py')\ns=p.read_text()\ni=s.index('def test_pipeline_runner')\ns=s[:i]+'''@cocotb.test()\nasync def cold_word_in_live_group(dut):\n    program = [ADDI(1, 0, 7), JAL(0,16), SW(1,0,4), NOP(), NOP(),\n               ADDI(1,1,3), SW(1,0,128), EBREAK()]\n    visits = []\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc == 20 and visits.count(pc) <= 4:\n            return None\n        return word\n    writes = []\n    rets, _ = await _run(dut, program, fetch=fetch, writes=writes)\n    _check_pc_trace(rets, [0,4,20,24,28])\n    assert [r[\\\"insn\\\"] for r in rets] == [program[p//4] for p in [0,4,20,24,28]]\n    i=visits.index(20)\n    assert visits[i:i+6] == [20]*5+[24]\n    assert writes == [(128,15,10)]\n\n\n'''+s[i:]\np.write_text(s)\nPY\ncd variant6 && pytest -qs cores/bench/test > ../tests6.log 2>&1; rg 'FAIL|TESTS=|passed in' ../tests6.log | tail -14\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
