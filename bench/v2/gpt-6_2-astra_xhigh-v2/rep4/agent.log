4, 8, 12, 20, 24])\n    _check_pc_trace(rets, pcs + [28])\n    assert [r[\"rs1_rdata\"] for r in rets if r[\"pc\"] == 8] == list(dmem.values())\n    assert not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def untaken_branches_with_uncacheable_targets(dut):\n    # PC 4's target wr\n…[10049 of 13121 chars elided by tools/bench/transcript.py; sha256:cc9a4b7285f14588]…\n= []\n    refetch = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if visits.count(4) == 2:\n            refetch.append(pc)\n            if pc == 16:\n                return None if refetch.count(16) <= 4 else replacement\n        return word\n\n    rets, _ = await _run(dut, program, fetch=fetch)\n    i = refetch.index(16)\n    assert refetch[i:i + 6] == [16] * 5 + [20]\n    _check_pc_trace(rets, [0, 4, 16, 20, 24, 8, 12, 4, 16, 20, 24, 28])\n    assert [(r[\"insn\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 16] == [\n        (program[4], 11), (replacement, 55)]\n    assert not any(r[\"trap\"] for r in rets)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
