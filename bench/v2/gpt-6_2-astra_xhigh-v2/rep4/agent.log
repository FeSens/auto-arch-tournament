{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/successors4/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def successor_replay_survives_load_interlocks(dut):\n    program = [ADDI(1, 0, 5), LW(4, 2, 0), ADDI(5, 4, 7), ADDI(2, 2, 4),\n               ADDI(1, 1, -1), BNE(1, 0, -16), EBREAK()]\n    visits = []\n    def fetch(pc, word):\n        visits.append(pc)\n        if visits.count(20) >= 2 and 4 <= pc <= 16:\n            return None\n        return word\n    rets, _ = await _run(dut, program, {i * 4: i + 10 for i in range(5)},\n                         read_waits={8: 4}, fetch=fetch)\n    _check_pc_trace(rets, [0] + [4, 8, 12, 16, 20] * 5 + [24])\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 8] == list(range(17, 22))\n\n\n@cocotb.test()\nasync def successor_trace_stops_at_sixteen(dut):\n    program = ([ADDI(1, 0, 3)] + [ADDI(2, 2, 1)] * 16 +\n               [ADDI(1, 1, -1), BNE(1, 0, -68), EBREAK()])\n    visits = []\n    waits = 0\n    def fetch(pc, word):\n        nonlocal waits\n        visits.append(pc)\n        if visits.count(72) >= 2:\n            if 4 <= pc < 68:\n                return None\n            if pc == 68 and waits < 3:\n                waits += 1\n                return None\n        return word\n    rets, _ = await _run(dut, program, fetch=fetch)\n    _check_pc_trace(rets, [0] + list(range(4, 76, 4)) * 3 + [76])\n    assert visits.count(68) == 6\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 64] == [16, 32, 48]\n\n\n@cocotb.test()\nasync def fence_i_invalidates_successor_word(dut):\n    program = [ADDI(1, 0, 3), JAL(0, 12), EBREAK(), NOP(),\n               ADDI(3, 3, 1), ADDI(1, 1, -1), BEQ(1, 0, -16),\n               ADDI(2, 2, 1), ADDI(4, 0, 2), BEQ(2, 4, 8), JAL(0, -36),\n               0x0000100f, JAL(0, -44)]\n    visits = []\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc == 16:\n            n = visits.count(16)\n            if n in (2, 3, 4):\n                return None\n            if n >= 5:\n                return ADDI(3, 3, 9)\n        return word\n    rets, _ = await _run(dut, program, fetch=fetch)\n    seq = [4,16,20,24,28,32,36]\n    _check_pc_trace(rets, [0] + seq + [40] + seq + [44,48,4,16,20,24,8])\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 16] == [1, 2, 11]\n\n\n@cocotb.test()\nasync def jalr_retarget_rejects_old_successor(dut):\n    program = [ADDI(1,0,64), JALR(0,1,0), SW(0,0,0x74)]\n    program += [NOP()] * (16 - len(program))\n    program += [SW(0,0,0x70), ADDI(1,0,320), JAL(0,-68)]\n    program += [NOP()] * (80 - len(program))\n    program += [ADDI(3,0,321), EBREAK()]\n    visits, writes = [], []\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc == 320 and visits.count(320) < 3:\n            return None\n        return word\n    rets, _ = await _run(dut, program, fetch=fetch, writes=writes)\n    _check_pc_trace(rets, [0,4,64,68,72,4,320,324])\n    assert visits.count(320) == 3\n    assert writes == [(0x70, 15, 0)]\n    assert rets[-2][\\\"rd_wdata\\\"] == 321\nPY\ncd \\\"\"'$TMPDIR/successors4\" && pytest -q --rootdir=. test > tests.log 2>&1 && tail -3 tests.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
