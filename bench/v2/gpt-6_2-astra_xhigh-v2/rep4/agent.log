{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/divstudy\"\ncat > \"$TMPDIR/divstudy/probe.py\" <<'\"'PY'\nimport os,sys,re,json,shutil\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot=Path.cwd()\noption=sys.argv[1]\nscratch=Path(os.environ['TMPDIR'])/'divstudy'/option\nrtl=scratch/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor f in (root/'cores/bench/rtl').glob('*.sv'):\n shutil.copyfile(f,rtl/f.name)\nf=rtl/'alu.sv'\ns=f.read_text()\nif option=='lane2':\n s=s.replace('logic [12:0] triple_small_divisor_q;', 'logic [19:0] triple_divisor_q;')\n s=s.replace(\\\"triple_small_divisor_q <= {1'b0, divisor_abs[10:0], 1'b0} + {2'b0, divisor_abs[10:0]};\\\", \\\"triple_divisor_q <= {1'b0, divisor_abs[17:0], 1'b0} + {2'b0, divisor_abs[17:0]};\\\")\n ix=s.index('    localparam int LEADING')\n iy=s.index('    end else begin : g_radix2',ix)\n s=s[:ix]+\\\"\\\"\\\"    localparam int LEADING = lane == 1 || lane == 2 ? 2 : 0;\n    if (LEADING \"'!= 0) begin : g_radix4\n      wire [R_BITS+1:0] shifted = {remainder_q, quotient_q[Q_BITS-1 -: 2]};\n      /* verilator lint_off UNUSEDSIGNAL */\n      logic [R_BITS+2:0] sub1, sub2, sub3;\n      /* verilator lint_on UNUSEDSIGNAL */\n      assign sub1 = {1'\"'b0, shifted} - {3'b0, divisor_q[R_BITS-1:0]};\n      assign sub2 = {1'b0, shifted} - {2'b0, divisor_q[R_BITS-1:0], 1'b0};\n      assign sub3 = {1'b0, shifted} - {1'b0, triple_divisor_q[R_BITS+1:0]};\n      wire lt1 = sub1[R_BITS+2];\n      wire lt2 = sub2[R_BITS+2];\n      wire lt3 = sub3[R_BITS+2];\n      assign leading_digits = {\"'!lt2, !lt3 || (lt2 && !lt1), {(DIGITS-2){1'\"'b0}}};\n      assign leading_remainder = ({R_BITS{lt1}} & shifted[R_BITS-1:0]) |\n                                 ({R_BITS{\"'!lt1 && lt2}} & sub1[R_BITS-1:0]) |\n                                 ({R_BITS{!lt2 && lt3}} & sub2[R_BITS-1:0]) |\n                                 ({R_BITS{!lt3}} & sub3[R_BITS-1:0]);\n\"\"\"+s[iy:]\nf.write_text(s)\nresults=build_all(root,rtl,'\"'fpga/core_bench_si.sv',scratch/'build',options=tuple(map(int,sys.argv[2:])))\n(scratch/'results.json').write_text(json.dumps(results))\nfor res in results:\n print(res,flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/divstudy/probe.py\" lane2 0 1 2'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
