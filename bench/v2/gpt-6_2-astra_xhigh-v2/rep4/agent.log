     hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Nov 21 15:15 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 21 15:15 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 21 15:15 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 21 15:15 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 21 15:15 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    68 Nov 21 15:15 riscv-formal -> /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep4/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 21 15:15 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 21 15:15 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 21 15:15 wrapper_si.sv\ntotal 464\ndrwxrwx---+  3 nobody nogroup   4096 Nov 21 15:15 .\ndrwxrwx---+  3 nobody nogroup   4096 Nov 21 15:15 ..\n-rw-rw----+  1 nobody nogroup   2317 Nov 21 15:15 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 21 15:15 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 21 15:15 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 21 15:15 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 21 15:15 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 21 15:15 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 21 15:15 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 21 15:15 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 21 15:15 selftest.S\nGOWIN_HOME=/opt/gowin\nPYTHONUSERBASE=/srv/hwebench/local\nTARGET=bench\n20\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\ncat: /sys/fs/cgroup/memory.max: No such file or directory\n","exit_code":1,"status":"failed"}}
