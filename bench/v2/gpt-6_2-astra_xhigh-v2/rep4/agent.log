sult |')\n a=s.index('  multiplier u_mul')\n if 'hot' in name:\n  shift='''  logic [31:0] reversed, workword, low, high, back;\n  for (genvar j=0; j<32; j++) begin\n    assign reversed[j] = rs1[31-j];\n    assign back[j] = high[31-j];\n  end\n  assign workword = shl ? reversed : rs1;\n  wire [63:0] wide = {{32{sign_fill}},workword};\n  always_comb begin\n    low = 0;\n    for (int i=0; i<4; i++) low = low | ({32{in.shift_fine[i]}} & 32'(wide >> i));\n  end\n  wire [63:0] mid = {{32{sign_fill}},low};\n  always_comb begin\n    high = 0;\n    for (int i=0; i<8; i++) high = high | ({32{in.shift_coarse[i]}} & 32'(mid >> (4*i)));\n  end\n  assign shifted = ({32{shl}} & back) | ({32{shr}} & high);\n'''\n else:\n  shift='''  wire [32:0] rsh = \"'$signed({sign_fill,rs1}) >>> in.shift_count;\n  assign shifted = ({32{shl}} & (rs1 << in.shift_count)) | ({32{shr}} & rsh[31:0]);\n'\"'''\n s=s[:a]+shift+s[a:]\n p.write_text(s)\nPY\npython - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'r14s1-eval-bou7mukd/probe.py'\ns=p.read_text().replace('print(name,flush=True)',p.with_name('shiftpart').read_text()+'\\\\nprint(name,flush=True)')\np.write_text(s)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/r14s1-eval-bou7mukd/probe.py\" shift'", "aggregated_output": "shift\n{'place_option': 1, 'placement_failed': False, 'fmax_mhz': 92.828, 'levels': 12, 'logic': 4907, 'regs': 1939, 'lutram': 8, 'bsram': 25, 'dsp': 2, 'critical_paths': [{'from': 'cpu/id_ex_w.ctrl.is_auipc_s0', 'to': 'cpu/u_ex/reg_q.alu_result_19_s0', 'slack_ns': -5.773, 'arrival_ns': 16.067, 'logic_cells': 23, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_alu', 'cpu/u_ex']}, {'from': 'cpu/u_ex/u_alu/lane_q_0_s0', 'to': 'cpu/id_ex_w.rs1_val_22_s0', 'slack_ns': -5.771, 'arrival_ns': 16.065, 'logic_cells': 9, 'modules': ['clock_ibuf', 'cpu', 'cpu/u_mem', 'cpu']}, {'from': 'cpu/u_ex/reg_q.alu_result_27_s0', 'to': 'cpu/u_if/recovered_pc_1_s0', 'slack_ns': -5.77, 'arrival_ns': 16.064, 'logic_cells': 12, 'mod