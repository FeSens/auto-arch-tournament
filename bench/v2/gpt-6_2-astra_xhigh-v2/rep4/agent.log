{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/rtl/hazard_unit.sv; rg --files cores/bench/test; ls -la formal; ls /opt; env | sort | rg '(GOWIN|RISCV|HW_|VIRTUAL|CAD|PATH=|PYTHON)'\"","aggregated_output":"// rtl/hazard_unit.sv\n//\n// Hold an adjacent consumer for one cycle if its producer's result is\n// first available for collection in MEM.\n//\n// Both younger stages hold on backpressure. A dependency holds only\n// decode/fetch and inserts a bubble between the producer and consumer.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_late_result, // load or M operation in EX\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd\n  input  logic [4:0] waiting_rs1,\n  input  logic [4:0] waiting_rs2,\n  input  logic       div_wait,          // divider owns ID/EX until result transfer\n  input  logic       fetch_available,   // external response or verified replay\n  input  logic       dmem_ready,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // decoded consumer stays in collection\n  output logic       stall_ex,          // EX input holds\n  output logic       result_hazard,\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic dmem_stall;\n\n  assign dmem_stall   = !dmem_ready && ex_mem_mem_op;\n  assign stall_ex_mem = dmem_stall;\n  assign hold_mem_wb  = dmem_stall;\n\n  always_comb begin\n    result_hazard = id_ex_late_result\n                 && (id_ex_rd == waiting_rs1 || id_ex_rd == waiting_rs2)\n                 && (id_ex_rd != 5'b0);\n    stall_ex = dmem_stall || div_wait;\n    stall_id = stall_ex || result_hazard;\n    stall_if = stall_id || !fetch_available;\n  end\n\nendmodule\ncores/bench/test/test_imm_gen.py\ncores/bench/test/test_decoder.py\ncores/bench/test/conftest.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\ncores/bench/test/test_multiplier.py\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Nov 21 21:16 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 21 21:17 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 21 21:16 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 21 21:16 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 21 21:16 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    68 Nov 21 21:16 riscv-formal -> /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep4/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 21 21:16 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 21 21:16 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 21 21:16 wrapper_si.sv\ngowin\nhwe-python\nhwe-toolchain\nGOWIN_HOME=/opt/gowin\nHWE_AGENT_PATH=/srv/hwebench/cli/codex-0.170.0:/srv/hwebench/bin:/srv/hwebench/venv/bin:/srv/hwebench/local/bin:/srv/hwebench/toolchain/oss-cad-suite/bin:/srv/hwebench/toolchain/bin:/srv/hwebench/venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\nHWE_AGENT_PYTHONUSERBASE=/srv/hwebench/local\nPATH=/srv/hwebench/cli/codex-0.170.0/codex-pkg/codex-path:/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep4/.codex-home/tmp/arg0-linux/codex-arg0WaoM3J:/srv/hwebench/cli/codex-0.170.0:/srv/hwebench/bin:/srv/hwebench/venv/bin:/srv/hwebench/local/bin:/srv/hwebench/toolchain/oss-cad-suite/bin:/srv/hwebench/toolchain/bin:/srv/hwebench/venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\nPYTHONUSERBASE=/srv/hwebench/local\n","exit_code":0,"status":"completed"}}
