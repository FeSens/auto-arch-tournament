{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/3df75752/0568b006/div-study.ZZBX6eUf/test/test_split.py' <<'PY'\nimport cocotb\nfrom test_alu import _setup, _check_div, _div_reference, MASK32\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\n@cocotb.test()\nasync def reciprocal_and_octal_digits(dut):\n    await _setup(dut)\n    # Every reciprocal entry, with dividends on both sides of an exact multiple.\n    for d in range(1, 2048):\n        multiple = (MASK32 // d) * d\n        for a in (multiple-1, multiple, min(multiple+1, MASK32)):\n            await _check_div(dut, ALU_DIVU, a, d, a//d)\n            await _check_div(dut, ALU_REMU, a, d, a%d)\n    # Exercise all combinations of the first and last octal digit at the split.\n    for d in (2047, 2048, 2049):\n        for first in range(8):\n            for last in range(8):\n                quotient = first * (8**6) + last\n                for offset in (-1, 0, 1):\n                    a = (quotient*d + offset) & MASK32\n                    await _check_div(dut, ALU_DIVU, a, d, a//d)\n                    await _check_div(dut, ALU_REMU, a, d, a%d)\n    # Alternate signed requests, unsigned high-range divisors, and backpressure.\n    for op,a,d in [(ALU_DIV,-0x7fffffff,-2047),(ALU_REM,-0x7fffffff,-2048),\n                   (ALU_DIVU,MASK32,0x10000001),(ALU_REMU,MASK32,0x40000001),\n                   (ALU_DIVU,0x80000000,0x80000001),(ALU_REMU,0x7fffffff,MASK32)]:\n        await _check_div(dut, op, a, d, _div_reference(op,a&MASK32,d&MASK32),\n                         hold_cycles=3)\n\ndef test_runner():\n    run_cocotb(toplevel='alu', sources=['core_pkg.sv','alu.sv'],test_module='test_split')\nPY\npython -m pytest --rootdir='/srv/hwebench/tmp/3df75752/0568b006/div-study.ZZBX6eUf' -q test/test_split.py > boundary.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
