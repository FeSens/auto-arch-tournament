ALU_REM || op == ALU_REMU;\n  assign negative_a = signed_op && a[31];\n  assign negative_b = signed_op && b[31];\n\n  logic [31:0] remainder_next;\n  logic [32:0] shifted, trial;\n  logic [5:0]  quotient_bits;\n  always_comb begin\n    remainder_next = remainder_q;\n    for (int i = 0; i < 6; i++) \n…[11106 of 14178 chars elided by tools/bench/transcript.py; sha256:b5501a60f54e7b7f]…\n]\n    rng = random.Random(0xD176)\n    for _ in range(100):\n        a = rng.getrandbits(32)\n        vectors.extend(((a, rng.getrandbits(32)), (a, rng.randrange(-1024, 1024) & MASK32)))\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in vectors:\n            await _check_div(dut, op, a, b, _div_reference(op, a, b))\n\n\n@cocotb.test()\nasync def reset_during_divide(dut):\n    await _setup(dut)\n    dut.op.value = ALU_DIVU\n    dut.a.value = MASK32\n    dut.b.value = 7\n    dut.div_start.value = 1\n    await _tick(dut)\n    dut.div_start.value = 0\n    await _tick(dut)\n    assert int(dut.div_busy.value)\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n    await _check_div(dut, ALU_REM, -10, 3, -1)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
