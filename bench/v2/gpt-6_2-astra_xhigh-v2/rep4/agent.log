{"type":"item.completed","item":{"id":"item_94","type":"command_execution","command":"/bin/bash -c \"sed -n '215,304p' '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/coco/test/test_alu.py'\"","aggregated_output":"@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14, hold_cycles=3)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n    # Change lanes at every issue. The zero-divisor result and the sign\n    # restoration must also belong to the newly issued request.\n    for op, a, b in (\n        (ALU_DIV, -0x76543210, -(1 << 12)),\n        (ALU_REMU, MASK32, (1 << 24) + 1),\n        (ALU_DIV, 0x80000000, -1),\n        (ALU_REM, -0x1234567, 0),\n        (ALU_DIVU, MASK32, 1 << 30),\n        (ALU_REM, -0x76543210, (1 << 24) - 1),\n        (ALU_DIVU, MASK32, 0),\n    ):\n        expected = _div_reference(op, a & MASK32, b & MASK32)\n        await _check_div(dut, op, a, b, expected, hold_cycles=2)\n\n\ndef _div_reference(op, a, b):\n    if op in (ALU_DIV, ALU_REM):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n    if b == 0:\n        return -1 if op in (ALU_DIV, ALU_DIVU) else a\n    quotient = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        quotient = -quotient\n    return quotient if op in (ALU_DIV, ALU_DIVU) else a - quotient * b\n\n\n@cocotb.test()\nasync def full_width_division(dut):\n    await _setup(dut)\n    edges = (0, 1, 2, 63, 64, 65, 0x7fffffff, 0x80000000, 0x80000001, MASK32)\n    vectors = [(a, b) for a in edges for b in edges]\n    # Cross both lane boundaries and the large lane's zero-digit cutoff.\n    # Include long quotients, equality, borrow, and all four MEM tails.\n    for width in (12, 24, 30):\n        for divisor in ((1 << width) - 1, 1 << width, (1 << width) + 1):\n            for multiple in (1, 2, 3, 4, MASK32 // divisor):\n                for offset in range(-3, 4):\n                    a = (multiple * divisor + offset) & MASK32\n                    for b in (divisor, -divisor, 0):\n                        vectors.extend(((a, b & MASK32), (-a & MASK32, b & MASK32)))\n    rng = random.Random(0xD176)\n    for _ in range(100):\n        a = rng.getrandbits(32)\n        vectors.extend(((a, rng.getrandbits(32)), (a, rng.randrange(-1024, 1024) & MASK32),\n                        (a, rng.randrange(1 << 12, 1 << 24))))\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in vectors:\n            await _check_div(dut, op, a, b, _div_reference(op, a, b))\n\n\n@cocotb.test()\nasync def reset_during_divide(dut):\n    await _setup(dut)\n    dut.op.value = ALU_DIVU\n    dut.a.value = MASK32\n    dut.b.value = 7\n    dut.div_start.value = 1\n    await _tick(dut)\n    dut.div_start.value = 0\n    await _tick(dut)\n    assert int(dut.div_busy.value)\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n    await _check_div(dut, ALU_REM, -10, 3, -1)\n\n\ndef test_alu_runner():\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/coco/test/test_alu.py');t=p.read_text().replace('for width in (12, 24, 30):','for width in (4, 11, 12, 18, 24, 25, 30):')\ni=t.index('def test_alu_runner():');t=t[:i]+'''@cocotb.test()\nasync def seventh_edge_transfer(dut):\n    await _setup(dut)\n    for op, a, b in ((ALU_DIV, -4321, 17), (ALU_REMU, MASK32, 1 << 25),\n                     (ALU_REM, -99, 0), (ALU_DIV, 0x80000000, -1)):\n        dut.op.value = op\n        dut.a.value = a & MASK32\n        dut.b.value = b & MASK32\n        dut.div_accept.value = 1\n        dut.div_start.value = 1\n        await _tick(dut)\n        dut.div_start.value = 0\n        for _ in range(6):\n            assert int(dut.div_busy.value) and not int(dut.div_finishing.value)\n            await _tick(dut)\n        assert int(dut.div_finishing.value) and not int(dut.div_done.value)\n        await _tick(dut)\n        assert not int(dut.div_busy.value)\n        assert int(dut.div_result.value) == _div_reference(op, a & MASK32, b & MASK32) & MASK32\n\n\n'''+t[i:];p.write_text(t)\nPY\ncd '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/coco' && PYTHONDONTWRITEBYTECODE=1 pytest -q test/test_alu.py > '/srv/hwebench/tmp/3df75752/aca414f5/r8s1.3LJjRpnZ/alu-final.log' 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
