{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Run the EX ALU, seven-round divider, and multiplier unit tests.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.result_sel.value = 0\n    dut.div_start.value = 0\n    dut.div_accept.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.result_sel.value = 1 << op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0, previous_result=None):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    if previous_result is not None:\n        # MEM samples this value on the edge that issues the next divide.\n        await Timer(1, \"ns\")\n        assert int(dut.div_result.value) == previous_result & MASK32\n    await _tick(dut)\n    dut.div_start.value = 0\n    # The bypass inputs and opcode can change as soon as