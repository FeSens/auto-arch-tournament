{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"rg -n -i -C 3 '(div|rem)' cores/bench/test/test_pipeline.py && cat formal/checks_si.cfg\"", "aggregated_output": "1-\"\"\"End-to-end pipeline tests for rtl/core.sv.\n2-\n3-Drives a minimal Python-side imem/dmem against the core's combinational\n4:fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n5-acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\n6-SW+LW roundtrip, load-use stall, and the trap discipline (illegal /\n7-ECALL trap, EBREAK does NOT trap).\n--\n59-def MULH(rd, rs1, rs2): return _r(1, rs2, rs1, 0b001, rd, 0b0110011)\n60-def MULHSU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b010, rd, 0b0110011)\n61-def MULHU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b011, rd, 0b0110011)\n62:def DIV (rd, rs1, rs2): return _r(1, rs2, rs1, 0b100, rd, 0b0110011)\n63:def DIVU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b101, rd, 0b0110011)\n64:def REM (rd, rs1, rs2): return _r(1, rs2, rs1, 0b110, rd, 0b0110011)\n65:def REMU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b111, rd, 0b0110011)\n66-def LB  (rd, rs1, imm): return _i(imm, rs1, 0b000, rd, 0b0000011)\n67-def LH  (rd, rs1, imm): return _i(imm, rs1, 0b001, rd, 0b0000011)\n68-def LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\n--\n83-# ── Harness ────────────────────────────────────────────────────────────────\n84-async def _run(dut, program, dmem_init=None, max_cycles=200, read_waits=None,\n85-               fetch=None, writes=None, write_waits=None, bus=None, start_clock=True):\n86:    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n87-\n88-    imem is read combinationally each cycle from imemAddr; dmem similarly.\n89-    Stores get applied to the Python-side dmem dict so subsequent loads\n--\n91-    fetch(pc, word) can replace the imem response or return None for a\n92-    wait cycle. writes collects each accepted store.\n93-\n94:    Returns (retirements, dmem) where retirements is a list of dicts\n95-    sampled on every cycle that rvfi_valid=1.\n96-    \"\"\"\n97-    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n--\n99-    waits = dict(read_waits or {})\n100-    store_waits = dict(write_waits or {})\n101-    pending_request =\n…[8296 of 11368 chars elided by tools/bench/transcript.py; sha256:d069d3b8f2c4e623]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
