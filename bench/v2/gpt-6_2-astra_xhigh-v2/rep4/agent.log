{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '170,580p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        drive_fetch(ia)\n        dut.io_dmemRData.value = 0xdeadbeef if read_stall else dmem.get(da & ~3, 0)\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    assert not any(waits.values()), f\"unexercised load wait cycles: {waits}\"\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _check_pc_trace(rets, pcs):\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert [(r[\"pc\"], r[\"pc_next\"]) for r in rets] == list(zip(pcs, pcs[1:] + [pcs[-1] + 4]))\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the e\n…[13374 of 16446 chars elided by tools/bench/transcript.py; sha256:c57fb6f249ec48dc]…\n  program = [JAL(0, 8), 0x0000100f, JAL(2, 12), EBREAK(), NOP(), JAL(0, -16)]\n    replacement = ADDI(3, 0, 99)\n    visits = []\n\n    def fetch(pc, word):\n        visits.append(pc)\n        if pc == 8:\n            n = visits.count(8)\n            if n in (2, 3, 4):\n                return None\n            if n == 5:\n                return replacement\n        return word\n\n    rets, dmem = await _run(dut, program, fetch=fetch)\n    assert visits[:12] == [0, 4, 8, 12, 20, 24, 4, 8, 8, 8, 8, 12]\n    _check_pc_trace(rets, [0, 8, 20, 4, 8, 12])\n    assert [(r[\"insn\"], r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 8] == [\n        (program[2], 2, 12), (replacement, 3, 99)]\n    assert not dmem and not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def external_noncontrol_word_on_btb_hit(dut):\n    # The bus can return a different word at a trained PC. Only legal\n    # control encodings may use the stored target, including across DIV waits.\n    program = [ADDI(1, 0, 42), JAL(2, 12), JAL(0, -4), NOP(), JAL(0, -12)]\n", "exit_code": 0, "status": "completed"}}
