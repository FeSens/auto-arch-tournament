nstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[1917 of 4989 chars elided by tools/bench/transcript.py; sha256:911fd90604360204]…\nrams (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\ntools/eval/_slots.py:7:set, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\ntools/eval/_slots.py:21:def eval_slot(what: str = \"eval\"):\ntools/eval/_slots.py:23:    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\ntools/eval/_slots.py:34:                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\ntools/eval/_slots.py:44:                fcntl.flock(f, fcntl.LOCK_UN)\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\ncat: /sys/fs/cgroup/memory.max: No such file or directory\n", "exit_code": 2, "status": "failed"}}
