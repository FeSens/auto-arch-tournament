{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -c \"rg --files cores/bench/generated/timing/gowin_p0/impl | tail -12 && head -30 cores/bench/rtl/core.sv && sed -n '1,35p' cores/bench/rtl/hazard_unit.sv\"","aggregated_output":"cores/bench/generated/timing/gowin_p0/impl/pnr/device.cfg\ncores/bench/generated/timing/gowin_p0/impl/pnr/cmd.do\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.log\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.db\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.prj\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench_syn_resource.html\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.vg\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench_syn_rsc.xml\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.log\n// rtl/core.sv\n//\n// Top-level wiring for the in-order RV32IM core.\n//\n//  IF -> ID -> operand collection -> EX -> MEM -> WB\n//  Collection resolves older writers and records the adjacent producer's\n//  tag matches. EX only needs the bypass from its immediate predecessor.\n//\n// IO port names use the `io_*` Chisel-emit prefix so the existing\n// formal/wrapper_si.sv and test/cosim/main.cpp bindings carry through\n// byte-for-byte. RVFI port set is the single-channel set described in\n// CLAUDE.md invariant 1 under `nret: 1` (declared in core.yaml). The\n// orchestrator routes formal to wrapper_si.sv + checks_si.cfg and FPGA\n// synth to fpga/core_bench_si.sv for this core. There is no channel 1.\n//\n// Latency:        full pipeline; instruction n retires at MEM/WB on\n//                 cycle n+5 (no hazards) or later (load-use stall,\n//                 redirect).\n// RVFI fields:    all of them — driven from the MEM/WB register and\n//                 the WB-stage write-data mux.\nmodule core (\n  input  logic        clock,\n  input  logic        reset,\n  // imem\n  output logic [31:0] io_imemAddr,\n  input  logic [31:0] io_imemData,\n  // A verified replay row can supply the instruction while imem is stalled.\n  input  logic        io_imemReady,\n  // dmem\n  output logic [31:0] io_dmemAddr,\n// rtl/hazard_unit.sv\n//\n// Hold an adjacent consumer for one cycle if its producer's result is\n// first available for collection in MEM.\n//\n// Both younger stages hold on backpressure. A dependency holds only\n// decode/fetch and inserts a bubble between the producer and consumer.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_late_result, // M operation in EX\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd\n  input  logic [4:0] waiting_rs1,\n  input  logic [4:0] waiting_rs2,\n  input  logic       div_wait,          // divider owns ID/EX until result transfer\n  input  logic       repair,            // replace dependent EX operands on bus acceptance\n  input  logic       fetch_available,   // external response or verified replay\n  input  logic       dmem_ready,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // decoded consumer stays in collection\n  output logic       stall_ex,          // EX input holds\n  output logic       result_hazard,\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic dmem_stall;\n\n  assign dmem_stall   = !dmem_ready && ex_mem_mem_op;\n","exit_code":0,"status":"completed"}}
