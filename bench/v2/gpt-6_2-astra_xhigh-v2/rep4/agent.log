{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor/directions.cpp\" <<'\"'CPP'\n#include <cstdio>\n#include <cstdint>\n#include <vector>\n#include <algorithm>\n#include <array>\n#include <tuple>\nusing std::uint32_t;\nstruct Transfer {uint32_t insn, pc, dst;};\nint main(int argc, char** argv) {\n  FILE* f = fopen(argv[1],\\\"rb\\\");\n  Transfer t; std::vector<Transfer> v;\n  while (fread(&t,sizeof(t),1,f)==1) if((t.insn&127)==0x63) v.push_back(t);\n  for (int n : {16,32,64,128,256}) {\n    std::vector<std::tuple<int, int,int,int,int,int>> res;\n    for(int hist: {0,1,2,3,4,5,6,7})\n    for(int fold: {0,1})\n    for(int ctr: {1,2})\n    for(int agree: {0,1})\n    for(int local: {0,1}) {\n     int sz=1<<hist;\n     int gh=0, errors=0; std::vector<int> t(n,(1<<(ctr-1))-1), lh(n);\n     for(auto [ins,pc,dst]: v){\n      bool taken=dst\"'!=pc+4;\n      int a = pc>>2;\n      int index = fold ? ((a''^(a/n)) & (n-1)) : (a & (n-1));\n      unsigned history = local ? lh[index] : gh;\n      int k=(index''^(history&(sz-1))) & (n-1);\n      bool bias=agree ? (ins>>31) : 0;\n      bool outcome = bias''^taken;\n      if(outcome != (t[k]>=(1<<(ctr-1)))) ++errors;\n      t[k]=std::clamp(t[k]+(outcome?1:-1),0,(1<<ctr)-1);\n      gh=((gh<<1) | int(taken)) & (sz-1);\n      lh[index]=((lh[index]<<1) | int(taken)) & (sz-1);\n     }\n     res.emplace_back(errors,hist,fold,ctr,agree,local);\n    }\n    std::sort(res.begin(),res.end());\n    printf(\"%d slots'\"\\\\n\\\",n);\n    for(int j=0; j<3; ++j) {\n      auto [err,h,x,c,a,l] = res[j];\n      printf(\\\" %d misses history=%d fold=%d counter=%d agree=%d local=%d\\\\n\\\",err,h,x,c,a,l);\n    }\n  }\n}\nCPP\ng++ -O3 \\\"\"'$TMPDIR/predictor/directions.cpp\" -o \"$TMPDIR/predictor/directions\" && \"$TMPDIR/predictor/directions\" \"$TMPDIR/predictor/branches.bin\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
