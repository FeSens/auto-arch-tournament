{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c \"cat > extra_load_tests.txt <<'PY'\n@cocotb.test()\nasync def adjacent_load_forwarding(dut):\n    def load(funct3, rd, rs1, imm):\n        return _i(imm & 0xfff, rs1, funct3, rd, 0x03)\n    program = [\n        LW(1, 0, 0x100),             # pointer to data word\n        load(0, 2, 1, 1),            # LB using the forwarded base, -128\n        SW(2, 0, 0x108),             # forward signed byte to store data\n        load(5, 3, 1, 2),            # LHU, 0x8123\n        ADD(4, 3, 3),                # both sources match\n        LW(0, 0, 0x100),\n        ADDI(5, 0, 8),\n        LW(6, 0, 0x110),             # -2\n        _r(1, 6, 6, 1, 7, 0x33),     # MULH -2 * -2, high word zero\n        LW(8, 0, 0x114),             # zero\n        BEQ(8, 0, 8),\n        SW(3, 0, 0x118),             # squashed\n        LW(8, 0, 0x11c),             # target of JALR\n        JALR(0, 8, 0),\n        SW(3, 0, 0x118),             # squashed\n        EBREAK(),\n    ]\n    data = {0x100: 0x104, 0x104: 0x81238047, 0x110: 0xfffffffe, 0x114: 0, 0x11c: 60}\n    writes = []\n    hold = 3\n    def ready(ren, wen, addr, wdata):\n        nonlocal hold\n        if ren and addr == 0x105 and hold:\n            hold -= 1\n            return False\n        if wen:\n            writes.append((addr, wen, wdata))\n        return True\n    rets, data = await _run(dut, program, data, dmem_ready=ready)\n    assert [r['pc'] for r in rets] == [4*i for i in range(11)] + [48, 52, 60]\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert all(r['trap'] == 0 for r in rets)\n    assert hold == 0 and writes == [(0x108, 15, 0xffffff80)]\n    assert [r['rd_wdata'] for r in rets[:9]] == [\n        0x104, 0xffffff80, 0, 0x8123, 0x10246, 0, 8, 0xfffffffe, 0]\n    assert rets[1]['rs1_rdata'] == 0x104 and rets[2]['rs2_rdata'] == 0xffffff80\n    assert rets[4]['rs1_rdata'] == rets[4]['rs2_rdata'] == 0x8123\n    assert rets[8]['rs1_rdata'] == rets[8]['rs2_rdata'] == 0xfffffffe\n    for i in [2,4,6,10,12]:\n        assert rets[i]['cycle'] == rets[i-1]['cycle'] + 1\n    assert rets[8]['cycle'] == rets[7]['cycle'] + 2\n\n@cocotb.test()\nasync def trapping_load_leaves_older_writer_visible(dut):\n    program = [ADDI(1,0,17), LW(1,0,0x101), ADD(2,1,1), EBREAK()]\n    def ready(ren, wen, addr, wdata):\n        assert not ren and not wen\n        return True\n    rets, _ = await _run(dut,program,{0x100:0xdeadbeef},dmem_ready=ready)\n    assert [r['insn'] for r in rets] == program\n    assert [r['trap'] for r in rets] == [0,1,0,0]\n    assert rets[1]['rd'] == 0 and rets[1]['mem_rmask'] == 0\n    assert rets[2]['rs1_rdata'] == rets[2]['rs2_rdata'] == 17\n    assert rets[2]['rd_wdata'] == 34\n\n@cocotb.test()\nasync def saved_consumer_behind_waiting_load(dut):\n    program = [ADDI(8,0,3),LW(1,0,0x100), ADD(2,1,1),ADDI(3,3,1),\n               BLT(3,8,-12), EBREAK()]\n    visits = 0\n    def fetch_ready(pc):\n        nonlocal visits\n        if pc == 4:\n            visits += 1\n        return not (visits >= 2 and pc == 8)\n    waits = 2\n    def data_ready(ren,wen,addr,wdata):\n        nonlocal waits\n        if visits >= 2 and ren and waits:\n            waits -= 1\n            return False\n        return True\n    rets,_ = await _run(dut,program,{0x100:23},imem_ready=fetch_ready,\n                        dmem_ready=data_ready,after_sweep=True)\n    assert [r['pc'] for r in rets] == [0] + [4,8,12,16]*3 + [20]\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert waits == 0\n    for i,r in enumerate(rets):\n        if r['pc'] == 8:\n            assert r['rs1_rdata'] == r['rs2_rdata'] == 23\n            assert r['rd_wdata'] == 46 and r['cycle'] == rets[i-1]['cycle'] + 1\nPY\npython - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_pipeline.py'); s=p.read_text().replace('def test_pipeline_runner():',Path('extra_load_tests.txt').read_text()+'\\\\n\\\\ndef test_pipeline_runner():');p.write_text(s)\nPY\npytest -q cores/bench/test/test_pipeline.py > directed.log 2>&1 && tail -3 directed.log\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
