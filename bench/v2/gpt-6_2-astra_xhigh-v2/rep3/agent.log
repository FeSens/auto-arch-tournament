{"type": "item.started", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r13pred/bank.py\" <<'\"'PY'\nimport os,sys,shutil\nfrom pathlib import Path\nt=Path(os.environ['TMPDIR'])/'r13pred'\nname=sys.argv[1]\nd=t/name/'rtl'\nd.mkdir(exist_ok=True,parents=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy(p,d/p.name)\np=d/'if_stage.sv'\ns=p.read_text()\ns=s.replace('  assign write_index = sweep_q ? sweep_index_q : predecessor_q;', '''  logic request, train_nonseq;\n  logic [17:0] predecessor_plus_one_q;\n  logic [8:0] lookup_index, train_row;\n  assign request = is_jal || is_jalr || (is_branch && (instr[31] \"'^ count[1]));\n  assign train_nonseq = mem_pc[19:2] != predecessor_plus_one_q;\n  assign lookup_index = {request, pc[9:2]};\n  assign train_row = {train_nonseq, predecessor_q[7:0]};\n  assign write_index = sweep_q ? sweep_index_q : train_row;'\"''')\ns=s.replace('    if (mem_transfer)\\\\n      predecessor_q <= mem_pc[10:2];','''    if (mem_transfer) begin\n      predecessor_q <= mem_pc[10:2];\n      predecessor_plus_one_q <= mem_pc[19:2] + 18'd1;\n    end''')\ns=s.replace('successors[pc[10:2]]','successors[lookup_index]')\ns=s.replace('request_q       <= is_jal || is_jalr || (is_branch && (instr[31] \"'^ count[1]));'\"','request_q       <= request;')\ns=s.replace('predecessor_q == pc[10:2]', 'train_row == lookup_index')\ns=s.replace('steer && \"'!row_is_fallthrough'\"','steer')\nif name in ('bankside','bankpipe','bankmeta'):\n s=s.replace('    if (\"'!stall_id) begin'\"\\\\n      fallthrough_q[15:0]  <= pc[15:0] + 16\\\\'d4;\\\\n      fallthrough_q[31:16] <= pc[31:16] + {15\\\\'b0, &pc[15:2]};\\\\n    end','''    if (\"'!stall_id)\n      fallthrough_q <= selected_plus_four;\n    held_plus_four_q <= selected_plus_four;'\"''')\n s=s.replace('  assign hold_slot =', '''  logic [31:0] held_plus_four_q, selected_plus_four;\n  logic [18:0] next_word_plus_one [0:511];\n  logic [18:0] next_word_plus_one_q;\n  always_ff @(posedge clock) begin\n    if (train_pair && \"'!sweep_q)\n      next_word_plus_one[write_index] <= {1'\"'b0, mem_pc[19:2]} + 19'd1;\n    next_word_plus_one_q <= next_word_plus_one[lookup_index];\n  end\n  assign selected_plus_four =\n      ({32{reset_q}} & 32'd4) |\n      ({32{\"'!reset_q && redirect}} & (resolved_pc + 32'\"'d4)) |\n      ({32{\"'!reset_q && !redirect && hold_slot}} & held_plus_four_q) |\n      ({32{fresh && steer}} & {11'\"'b0, next_word_plus_one_q, 2'b0}) |\n      ({32{fresh && \"'!steer}} & (fallthrough_q + 32'\"'d4));\n\n  assign hold_slot =''')\nif name in ('bankpipe','bankmeta','bankflag'):\n s=s.replace('  logic is_branch, is_jal, is_jalr;', '  logic is_branch, is_jal, is_jalr, inner_valid_q;')\n s=s.replace('  assign steer         = request_q && lookup_valid_q && ram_response_q.valid && \"'!sweep_q;'\"', '''  // Move the presence read into fabric so it cannot depend on block RAM.\n  (* syn_ramstyle=\\\"distributed_ram\\\" *) logic presence [0:255];\n  always_ff @(posedge clock) begin\n    if (sweep_q || (train_pair && train_nonseq))\n      presence[write_index[7:0]] <= \"'!sweep_q;\n    inner_valid_q <= presence[pc[9:2]];\n  end\n  assign steer = request_q && lookup_valid_q && inner_valid_q && !sweep_q;'\"''')\nif name in ('bankmeta','bankclass'):\n # Snapshot instruction type as a small sideband: IF-decode and BHT concurrently with instruction select\n s=s.replace('  logic is_branch, is_jal, is_jalr;', '  logic is_branch, is_jal, is_jalr;') # no-op\n s=s.replace('    logic [31:0] instr;','    logic [31:0] instr;\\\\n    logic [2:0] kind;')\n s=s.replace('{\"'!sweep_q, mem_pc[19:2], mem_instr}'\"', '''{\"'!sweep_q, mem_pc[19:2], mem_instr, (mem_instr[6:0] == 7'\"'h6f || (mem_instr[6:0] == 7'h67 && mem_instr[14:12] == 3'b000)), mem_instr[6:0] == 7'h63 && mem_instr[14:13] \"'!= 2'\"'b01, mem_instr[31]}''')\n s=s.replace('  assign request = is_jal || is_jalr || (is_branch && (instr[31] \"'^ count[1]));'\"','''  logic bus_jump, bus_branch, fresh_jump, fresh_branch;\n  assign bus_jump = imem_data[6:0] == 7'h6f || (imem_data[6:0] == 7'h67 && imem_data[14:12] == 0);\n  assign bus_branch = imem_data[6:0] == 7'h63 && imem_data[14:13] \"'!= 2'\"'b01;\n  assign fresh_jump = fresh ? ram_response_q.kind[2] : held_response_q.kind[2];\n  assign fresh_branch = fresh ? ram_response_q.kind[1] : held_response_q.kind[1];\n  assign request = imem_ready ? bus_jump || (bus_branch && (imem_data[31] \"'^ count[1])) :\n                                fresh_jump || (fresh_branch && (response.kind[0] ''^ count[1]));'\"''')\np.write_text(s)\nPY\nfor model in bank bankclass bankside bankflag bankmeta; do python3 \\\"\"'$TMPDIR/r13pred/bank.py\" \"$model\"; done'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
