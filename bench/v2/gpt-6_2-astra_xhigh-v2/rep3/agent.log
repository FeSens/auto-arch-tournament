{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\npath=Path('cores/bench/test/test_pipeline.py')\ns=path.read_text().replace('max_cycles=200, dmem_ready=None):','max_cycles=200, dmem_ready=None, imem_ready=None):')\ns=s.replace('        if wen and ready:', \\\"\\\"\\\"        if imem_ready is not None:\n            dut.io_imemReady.value = int(imem_ready(ia, ren, ready))\n        if wen and ready:\\\"\\\"\\\")\ni=s.index('def test_pipeline_runner():')\np=\\\"\\\"\\\"@cocotb.test()\nasync def predict_loop_and_exit(dut):\n    program = [\n        ADDI(1, 0, 5), ADDI(1, 1, -1),\n        _b(-4, 0, 1, 1, 0x63), BEQ(0, 0, 8), SW(1, 0, 64),\n        JAL(6, 8), SW(1, 0, 64), EBREAK(),\n    ]\n    fetches = []\n    def fetch(pc, ren, ready):\n        fetches.append(pc)\n        return True\n    rets, memory = await _run(dut, program, imem_ready=fetch)\n    assert [r['pc'] for r in rets] == [0] + [4,8]*5 + [12,20,28]\n    assert all(b['pc'] == a['pc_next'] for a,b in zip(rets,rets[1:]))\n    loop_rets = [r for r in rets if r['pc'] in (4,8)]\n    assert all(b['cycle'] == a['cycle']+1 for a,b in zip(loop_rets,loop_rets[1:]))\n    assert 24 not in fetches\n    assert memory == {}\n    assert rets[-2]['rd_wdata'] == 24\n\n\n@cocotb.test()\nasync def correct_held_forward_branch_on_imem_wait(dut):\n    program = [\n        LW(2, 0, 64), BEQ(0, 0, 12), SW(0, 0, 64), SW(0, 0, 64),\n        JAL(5, 2), _b(-4, 0, 0, 2, 0x63), BEQ(2, 0, -128), EBREAK(),\n    ]\n    load_waits = []\n    wrong = []\n    fetches = []\n    def dready(ren, wen, addr, data):\n        if ren:\n            load_waits.append(addr)\n            return len(load_waits) == 4\n        return True\n    def iready(pc, ren, ready):\n        fetches.append(pc)\n        if ren and pc == 8:\n            wrong.append((pc, ready))\n            return False\n        return True\n    rets, memory = await _run(dut, program, {64:13}, dmem_