{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/guard\" && python - <<'\"'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_alu.py')\ns=p.read_text()\na=s.index('def test_alu_runner():')\ns=s[:a]+'''@cocotb.test()\nasync def quotient_grid_boundaries(dut):\n    await _setup(dut)\n    for k in (0, 1, 2, 9, 10, 11, 12, 13, 16, 23, 31):\n        step = 1 << max(0, k - 10)\n        for i in (0, 1, 2, 127, 511, 512, 1022, 1023):\n            left = ((1024 + i) << k) // 1024\n            for b in {left, left + 1, left + step - 1}:\n                if not 0 < b <= MASK32:\n                    continue\n                multiple = (MASK32 // b) * b\n                for a in {MASK32, MASK32-3, multiple, multiple-1, min(MASK32,multiple+1)}:\n                    q, r = divmod(a, b)\n                    await _check_div(dut, ALU_DIVU, a, b, q)\n                    await _check_div(dut, ALU_REMU, a, b, r)\n\n\n@cocotb.test()\nasync def product_around_held_divide(dut):\n    await _setup(dut)\n    await _check_mul(dut, ALU_MULHSU, MASK32, MASK32, MASK32)\n    dut.mul_issue.value = 0\n    await _check_div(dut, ALU_DIVU, MASK32, 4099, MASK32 // 4099, hold_cycles=4)\n    await _check_mul(dut, ALU_MULHU, MASK32, MASK32, MASK32 - 1)\n\n\n'''+s[a:]\np.write_text(s)\nPY\npytest -q cores/bench/test > all-tests.log 2>&1 && tail -3 all-tests.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
