{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"sed -n '252,298p;480,510p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\n@cocotb.test()\nasync def back_to_back_dependent_divides(dut):\n    program = [\n        ADDI(1, 0, 100), ADDI(2, 0, 7),\n        DIV(3, 1, 2), REMU(4, 1, 3), ADD(5, 3, 4), EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [(r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"]) for r in rets[2:5]] == [\n        (100, 7, 14), (100, 14, 2), (14, 2, 16),\n    ]\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n@cocotb.test()\nasync def successor_word_across_load_use_and_divide(dut):\n    program = {\n        0: ADDI(5, 0, 5), 4: LW(1, 0, 0x100), 8: DIV(2, 1, 1),\n        12: ADDI(3, 3, 1), 16: JAL(0, 8), 20: SW(1, 0, 0x104),\n        24: BLT(3, 5, -20), 28: EBREAK(),\n    }\n    lap = 0\n\n    def fetch_ready(pc):\n        nonlocal lap\n        if pc == 4:\n            lap += 1\n        if lap == 2 and pc == 12:\n            # A ready word overrides the older saved word and retrains it.\n            program[12] = ADDI(3, 3, 2)\n            return True\n        return lap < 2 or (lap == 2 and pc == 4) or pc == 28\n\n    rets, data = await _run(dut, program, {0x100: 17}, after_sweep=True,\n                            imem_ready=fetch_ready)\n    assert [r[\"pc\"] for r in rets] == [0] + [4, 8, 12, 16, 24] * 3 + [28]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 8] == [1, 1, 1]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 12] == [1, 3, 5]\n    assert data == {0x100: 17}\n\n\n@cocotb.test()\nasync def successor_full_address_match(dut):\n    # Rows for PC 0 and 0x800 alias. Their fall-through PCs also share\n    # PC[10:2], but carry different words.\n","exit_code":0,"status":"completed"}}
