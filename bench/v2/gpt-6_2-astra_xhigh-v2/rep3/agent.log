{"type":"item.completed","item":{"id":"item_217","type":"command_execution","command":"/bin/bash -c 'git diff -- cores/bench/rtl/ex_stage.sv cores/bench/rtl/core_pkg.sv'","aggregated_output":"diff --git a/cores/bench/rtl/core_pkg.sv b/cores/bench/rtl/core_pkg.sv\nindex f8a57b5..804d4d8 100644\n--- a/cores/bench/rtl/core_pkg.sv\n+++ b/cores/bench/rtl/core_pkg.sv\n@@ -56,6 +56,19 @@\n                           width == 2'd1 && offset[0]);\n   endfunction\n \n+  // Compare a byte-address sum with an expected word in parallel. For\n+  // unlike operand bits the outgoing carry is the inverse of the sum bit.\n+  // Checking each adjacent pair proves that all inferred carries agree,\n+  // starting with the real carry out of the two byte-offset bits.\n+  function automatic logic sum_matches_word(input logic [31:0] base, offset,\n+                                            input logic [31:2] word_addr);\n+    logic [31:2] carry_in;\n+    carry_in[2] = (base[1:0] > ~offset[1:0]);\n+    carry_in[31:3] = (base[30:2] & offset[30:2]) |\n+                     ((base[30:2] | offset[30:2]) & ~word_addr[30:2]);\n+    sum_matches_word = (base[31:2] ^ offset[31:2] ^ word_addr) == carry_in;\n+  endfunction\n+\n   function automatic logic [31:0] format_load(input logic [31:0] word_data,\n                                                input logic [1:0] offset, width,\n                                                input logic sext);\n@@ -95,7 +108,6 @@\n     logic [31:0] pc;\n     logic [31:0] instr;\n     logic        predicted_taken;\n-    logic [31:0] alternate_pc;\n     logic [1:0]  train_count;\n     logic        valid;\n   } if_id_t;\n@@ -112,7 +124,6 @@\n     ctrl_t       ctrl;\n     logic [31:0] instr;\n     logic        predicted_taken;\n-    logic [31:0] alternate_pc;\n     logic [1:0]  train_count;\n     logic        valid;\n   } id_ex_t;\ndiff --git a/cores/bench/rtl/ex_stage.sv b/cores/bench/rtl/ex_stage.sv\nindex ef0d967..ed32b9a 100644\n--- a/cores/bench/rtl/ex_stage.sv\n+++ b/cores/bench/rtl/ex_stage.sv\n@@ -25,7 +25,7 @@ module ex_stage (\n   input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n   input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_data\n   input  logic               jalr_forecast,\n-  input  logic [31:0]        fetch_pc,\n+  input  logic [19:2]        forecast_word_addr,\n   output ex_mem_t  out,\n   output logic               writes_rd,     // write control entering EX/MEM on advance\n   output logic               div_wait,\n@@ -134,11 +134,12 @@ module ex_stage (\n   // A valid branch or jump is always a single-cycle EX operation.\n   assign advancing       = in.valid && !stall && !reset;\n   assign aligned_taken   = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n-  assign jalr_miss       = jalr_target[1] ? jalr_forecast\n-                                          : !jalr_forecast || fetch_pc != jalr_target;\n+  assign jalr_miss       = jalr_forecast ? (jalr_target[1] ||\n+                           !sum_matches_word(rs1, in.imm, {12'b0, forecast_word_addr}))\n+                                         : !jalr_target[1];\n   assign redirect        = advancing && (in.ctrl.is_jalr ? jalr_miss\n                                                          : aligned_taken != in.predicted_taken);\n-  assign redirect_target = !in.ctrl.is_jalr ? in.alternate_pc\n+  assign redirect_target = !in.ctrl.is_jalr ? (in.predicted_taken ? in.pc + 32'd4 : branch_target)\n                          : jalr_target[1]   ? in.pc + 32'd4 : jalr_target;\n \n   assign train_en    = advancing && in.ctrl.is_branch && !misalign_fault;\n","exit_code":0,"status":"completed"}}
