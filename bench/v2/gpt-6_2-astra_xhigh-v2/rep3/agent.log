{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_pipeline.py | sed -n '185,285p' && sed -n '450,580p' cores/bench/test/test_pipeline.py && cat test/cosim/build.sh | head -120\"", "aggregated_output": "    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def divide_behind_stalled_load(dut):\n    program = [\n        ADDI(1, 0, -101),\n        ADDI(2, 0, 7),       # forwards from WB while the load holds MEM\n        LW(4, 0, 64),\n        DIV(3, 1, 2),\n        SW(3, 0, 68),        # consumes the quotient from EX/MEM\n        EBREAK(),\n    ]\n    reads, writes, accepted_writes = [], [], []\n\n    def ready(ren, wen, addr, wdata):\n        if ren:\n            reads.append(addr)\n            return len(reads) > 3\n        if wen:\n            writes.append((addr, wen, wdata))\n            if len(writes) > 2:\n                accepted_writes.append(writes[-1])\n                return True\n        return False\n\n    rets, dmem = await _run(dut, program, dmem_init={64: 42}, dmem_ready=ready)\n   