lthrough;')\n s=''.join(l for l in s.splitlines(True) if 'out.alternate_pc' not in l and 'out.predicted_taken' not in l)\n p.write_text(s)\n p=d/'core.sv';s=p.read_text().replace('  logic        jalr_forecast;','  logic        jalr_forecast, direct_steered;').replace('.jalr_forecast   (jalr_forecast),','.jalr_forecast   (jalr_forecast),\\\\n    .direct_steered  (direct_steered),');p.write_text(s)\n p=d/'ex_stage.sv';s=p.read_text().replace('  input  logic               jalr_forecast,','  input  logic               jalr_forecast,\\\\n  input  logic               direct_steered,').replace('in.predicted_taken','direct_steered').replace('in.alternate_pc',\\\"(direct_steered ? (in.pc + 32'd4) : branch_target)\\\");p.write_text(s)\n for fname in ['id_stage.sv','core_pkg.sv']:\n  p=d/fname\n  p.write_text(''.join(l for l in p.read_text().splitlines(True) if 'alternate_pc' not in l and 'predicted_taken' not in l))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
