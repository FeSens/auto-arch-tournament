ors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[2091 of 5163 chars elided by tools/bench/transcript.py; sha256:d8e366bf12bf0f4e]…\nlf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n/opt/gowin\n/opt/hwe-python\n/opt/hwe-toolchain\n/srv/hwebench/venv/bin/python3\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\ntotal 448\n-rw-rw----+  1 nobody nogroup   2317 Nov 21 05:46 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 21 05:46 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 21 05:46 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 21 05:46 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 21 05:46 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 21 05:46 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 21 05:46 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 21 05:46 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 21 05:46 selftest.S\nbase\n", "exit_code": 0, "status": "completed"}}
