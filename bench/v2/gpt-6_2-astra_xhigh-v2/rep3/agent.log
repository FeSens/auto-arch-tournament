)\nPY\ncat > \\\"\"'$TMPDIR/runtiming.py\" <<'\"'PY'\nimport os,sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build\np=Path(os.environ['TMPDIR'])/sys.argv[1]\nn=int(sys.argv[2])\nr=build('.',p/'rtl','fpga/core_bench_si.sv',n,p/f'p{n}')\nprint(r,flush=True)\nPY\npython \\\"\"'$TMPDIR/testfetch.py\" pre && python \"$TMPDIR/testfetch.py\" slices && cat bench/programs/Makefile'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
