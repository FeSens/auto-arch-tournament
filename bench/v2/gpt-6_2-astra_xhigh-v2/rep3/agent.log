{"type": "item.completed", "item": {"id": "item_335", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// While fetching A, probe the row for the predicted B. At admission of B,\n// register its row in fabric so its successor C can issue on the next clock.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_value,\n  output logic              jalr_forecast,\n  output logic [19:2]       forecast_word_addr,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc_q, pc, instr;\n  logic [1:0] counters [0:63];\n  logic [1:0] count;\n  logic predicted_taken;\n  logic [31:0] fallthrough, predicted_target;\n\n  // Rows are indexed by the predecessor but contain the successor's full\n  // RAM word address. The direct target and flags describe that successor.\n  typedef struct packed {\n    logic [17:0] word_addr;\n    logic [31:0] instr;\n    logic [17:0] direct_addr;\n    logic        branch_ok;\n    logic        jal_ok;\n  } successor_data_t;\n  typedef struct packed {\n    logic            valid;\n    successor_data_t data;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t probe_q;\n  successor_data_t bank0_q, bank1_q, saved;\n  logic [8:0] predecessor, sweep_index_q, fill_index_q, write_index;\n  logic [17:0] fill_addr_q\n…[7625 of 10697 chars elided by tools/bench/transcript.py; sha256:e720bcc0a375a2ab]…\n         : fallthrough[10:2];\n\n  // Form all three PC candidates before the edge. A late interlock or\n  // redirect only chooses which register supplies the new request.\n  logic [31:0] next_q, recovery_q, parked_pc_q;\n  logic recover_q, park_q;\n  always_ff @(posedge clock) begin\n    next_q      <= predicted_taken ? predicted_target : fallthrough;\n    recovery_q  <= reset ? RESET_PC : redirect_target;\n    parked_pc_q <= pc_q;\n    recover_q   <= reset || redirect;\n    park_q      <= stall;\n  end\n  assign pc_q = recover_q ? recovery_q : park_q ? parked_pc_q : next_q;\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc              = pc;\n    out.instr           = instr;\n    out.valid           = imem_ready || saved_hit;\n    out.predicted_taken = predicted_taken;\n    // Predict with the old count, but train from the newest count if two\n    // consecutive branch PCs alias. This bypass only feeds the snapshot.\n    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_336", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/id_stage.sv'", "aggregated_output": "// rtl/id_stage.sv\n//\n// Decode stage. Combinationally drives the regfile read ports and the\n// ID/EX register's next-state from the IF/ID combinational bundle plus\n// the regfile read data. The ID/EX register is owned by this module so\n// the decoded view of instruction n is latched by end of cycle n+1.\n//\n// Latency:        1 cycle (ID/EX register clocked here).\n// RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata, insn,\n//                 trap (via ctrl.is_illegal).\nmodule id_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              flush,\n  input  if_id_t  in,\n  // regfile read interface\n  output logic [4:0]        rs1_addr,\n  output logic [4:0]        rs2_addr,\n  input  logic [31:0]       rs1_data,\n  input  logic [31:0]       rs2_data,\n  // ID/EX register output\n  output logic              is_mul,   // ID/EX multiply tag, qualified by out.valid\n  output id_ex_t  out\n);\n\n  // ── Combinational decode ────────────────────────────────────────────────\n  logic [4:0]  dec_alu_op;\n  logic        dec_alu_src;\n  logic [2:0]  dec_branch_op;\n  logic        dec_is_branch;\n  logic        dec_is_jump;\n  logic        dec_is_jalr;\n  logic        dec_is_lui;\n  logic        dec_is_auipc;\n  logic        dec_mem_read;\n  logic        dec_mem_write;\n  logic [1:0]  dec_mem_width;\n  logic        dec_mem_sext;\n  logic        dec_reg_write;\n  logic        dec_mem_to_reg;\n  logic        dec_is_illegal;\n\n  decoder u_decoder (\n    .instr      (in.instr),\n    .alu_op     (dec_alu_op),\n    .alu_src    (dec_alu_src),\n    .branch_op  (dec_branch_op),\n    .is_branch  (dec_is_branch),\n    .is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_to_reg (dec_mem_to_reg),\n    .is_illegal (dec_is_illegal)\n  );\n\n  logic [31\n…[1097 of 4169 chars elided by tools/bench/transcript.py; sha256:4993a035edad09e2]…\n Capture payload independently of the squash. Only valid and controls\n  // can make a decoded instruction observable downstream.\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      reg_q.pc       <= in.pc;\n      reg_q.rs1_val  <= rs1_data;\n      reg_q.rs2_val  <= rs2_data;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.instr    <= in.instr;\n      is_mul         <= dec_alu_op == ALU_MUL || dec_alu_op == ALU_MULH ||\n                        dec_alu_op == ALU_MULHSU || dec_alu_op == ALU_MULHU;\n      reg_q.predicted_taken <= in.predicted_taken;\n      reg_q.train_count     <= in.train_count;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q.valid <= 1'b0;\n      reg_q.ctrl  <= '0;\n    end else if (!stall) begin\n      reg_q.valid <= in.valid && !flush;\n      reg_q.ctrl  <= in.valid && !flush ? ctrl_decoded : '0;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
