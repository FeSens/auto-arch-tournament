:0] a_minus_b_q;\n  logic [32:0] corrected_res_q;\n  logic signed [71:0] mul_product;\n\n  assign mul_product = operand_a_q * operand_b_q;\n  assign mem_product = mul_high_q ? mul_product[63:32] : mul_product[31:0];\n  assign nr_product = normalized_q * recip_q;\n  assign update_product = factor_q * recip_q;\n  assign scale_product = x_q * recip_q;\n  assign q_times_b = quotient_q * divisor;\n\n  always_ff @(posedge clock) begin\n    if (mul_issue) begin\n      operand_a_q <= {{4{a[31] && (op == ALU_MULH || op == ALU_MULHSU)}}, a};\n      operand_b_q <= {{4{b[31] && op == ALU_MULH}}, b};\n    end\n    if (busy_q) begin\n      case (pass_q)\n        3'd0: begin\n          normalized_q <= normalized;\n          k_q <= ~clz_b;\n          recip_q <= {seed[normalized[30:22]], 22'b0};\n        end\n        3'd1, 3'd3: factor_q <= ~nr_product[65:31];\n        3'd2, 3'd4: recip_q <= update_product[67:34];\n        3'd5: quotient_q <= scale_product[65:34];\n        3'd6: begin\n          residual_q <= dividend - q_times_b;\n          corrected_res_q <= a_minus_b_q - {1'b0,q_times_b};\n        end\n        default: ;\n      endcase\n      if (pass_q == 3'd1)\n        a_minus_b_q <= {1'b0,dividend} - {1'b0,divisor};\n      if (pass_q == 3'd2)\n        x_q <= dividend >> k_q;\n    end\n  end\n\n  // For nonzero B the two refinements yield floor(A/B) or one less.\n  // Thus Q*B <= A and the exact residual fits in 32 bits. INT_MIN/-1\n  // already has the required magnitude and bit pattern.\n  logic        correct;\n  logic [31:0] magnitude;\n  assign correct   = !corrected_res_q[32];\n  assign magnitude = want_rem_q ? (correct ? corrected_res_q[31:0] : residual_q)\n                                : quotient_q + {31'b0, correct};\n  // At B=0 the residual is A and the remainder correction subtracts zero.\n  assign div_result = zero_q && !want_rem_q ? 32'hffff_ffff\n                    : negate_q ? -magnitude : magnitude;\n`endif\n\nendmodule\n","exit_code":0,"status":"completed"}