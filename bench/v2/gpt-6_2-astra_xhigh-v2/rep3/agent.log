{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport collections,os,json,pathlib\np=pathlib.Path(os.environ['TMPDIR'])\nfor n in ['rf_only','history_only','stride_analysis']:\n    m=json.loads((p/n/'stats').open().readlines()[-1])\n    print(n,m['bench_stop_cycle']-m['bench_start_cycle'])\npcstats=collections.defaultdict(lambda:[0]*8)\nfor line in open(p/'stride_analysis/stats'):\n    if not line.startswith('load '):continue\n    pc, sig,addr,rf,fore,pr,hit,dep=[int(w,16) for w in line.split()[1:]]\n    b = pcstats[pc]\n    for i,v in enumerate([1,addr==rf,addr==fore,addr==pr,hit,dep,(not hit) and dep, bool(sig&16)]): b[i]+=v\nprint('all',list(map(sum,zip(*pcstats.values()))))\nfor pc,b in sorted(pcstats.items(),key=lambda x:-x[1][6])[:22]:\n    print(hex(pc),b)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
