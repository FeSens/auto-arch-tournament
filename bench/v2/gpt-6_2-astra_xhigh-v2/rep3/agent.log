{"type": "item.completed", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/alu.sv | head -185 && sed -n '173,193p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "// Decode launches a narrow product. EX validates both operand keys or\n// replays the operation on the same 16x16 multiplier with exact limbs.\n// The seven-clock Newton divider has its own multiplier.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        mul_active,   // MUL admitted to ID/EX\n  input  logic [15:0] guess_a,\n  input  logic [15:0] guess_b,\n  input  logic        mul_result_ready,\n  output logic        mul_result_valid,\n  output logic [31:0] mul_result,\n  output logic [31:0] mul_rs1,\n  output logic [31:0] mul_rs2,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_result_valid,\n  input  logic        div_result_ready,\n  output logic [31:0] div_result\n);\n\n  always_comb begin\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << b[4:0];\n      ALU_SRL:    out = a >> b[4:0];\n      ALU_SRA:    out = $unsigned($signed(a) >>> b[4:0]);\n      ALU_LUI:    out = b;\n      default:    out = '0;\n    endcase\n  end\n\n  typedef enum logic [3:0] {\n    VERIFY, NARROW, LOW_LOW, HIGH_LOW, LOW_HIGH,\n    LOW_DONE, HIGH_HIGH, HIGH_ADD, HIGH_DONE\n  } mul_state_t;\n  mul_state_t state_q;\n  logic [15:0] forecast_a_q, forecast_b_q;\n  logic verify;\n  // ID/EX owns the admission token. The slices can be sampled in parallel\n  // with the decision to admit, including on the final repair edge.\n  assign verify = mul_active && state_q == VERIFY;\n  always_ff @(posedge clock) begin\n    forecast_a_q <= guess_a;\n    forecast_b_q <= guess_b;\n  end\n  logic [31:0] saved_a_q, saved_b_q;\n  logic [4:0] saved_op_q;\n  logic match_keys, both_narrow;\n  assign match_keys = a\n…[3976 of 7048 chars elided by tools/bench/transcript.py; sha256:2649b712b0341352]…\nlse if (busy_q) begin\n      pass_q <= pass_q + 3'd1;\n      if (pass_q == 3'd6) begin\n        busy_q           <= 1'b0;\n        div_result_valid <= 1'b1;\n      end\n    end else if (div_result_ready) begin\n      div_result_valid <= 1'b0;\n        # cycles makes accidental use of the bus on an internal hit visible.\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0) if ren and ready else 0xDEADCAFE\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    clock_task.cancel()\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _check_linear_retirements(rets, program):\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, len(program) * 4, 4))\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n", "exit_code": 0, "status": "completed"}}
