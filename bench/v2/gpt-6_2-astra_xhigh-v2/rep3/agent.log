{"type":"item.started","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport json,jsonschema,os,statistics,yaml\nfrom tools.eval.fpga import validate_coremark_uart\nfrom xml.etree import ElementTree\np=Path('cores/bench/experiments/hypotheses/hyp-20261120-003-r5s2.yaml')\nh=yaml.safe_load(p.read_text())\njsonschema.Draft7Validator(json.loads(Path('schemas/hypothesis.schema.json').read_text())).validate(h)\nassert p.stem == h['id'] == 'hyp-20261120-003-r5s2' and h['category']=='predictor'\nassert all(c['file'].startswith(('rtl/','test/test_')) and (Path('cores/bench')/c['file']).is_file() for c in h['changes'])\nv=Path(os.environ['TMPDIR'])/'preview'\ntiming=json.loads((v/'timing.json').read_text())\nbench=json.loads((v/'coremark.log').read_text().splitlines()[-1])\nassert bench['bench_bracketed'] and bench['ebreak'] and not bench['oob'] and validate_coremark_uart(bench['uart'],10)[0]\nncycles=bench['bench_stop_cycle']-bench['bench_start_cycle']\nfm=statistics.median(r['fmax_mhz'] for r in timing)\nprint(p.resolve(),f'{ncycles:,} cycles, {fm} MHz, {fm*1e7/ncycles:.2f} iter/s')\nprint((v/'formal-console.log').read_text().splitlines()[-1])\nfor file in sorted((v/'test').glob('*.result.xml')):\n t=ElementTree.parse(file)\n print(file.stem,len(t.findall('.//testcase')),len(t.findall('.//failure')))\nPY\ngit status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
