{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c \"date -u && sed -n '967,1030p' cores/bench/test/test_pipeline.py && ls \\\"\"'$TMPDIR/operand/gowin_p1/impl/pnr\" | head'","aggregated_output":"Sat Nov 21 00:06:20 UTC 2026\n    assert [r[\"pc\"] for r in rets if r[\"insn\"] == 0x0000100f] == [40]\n\n\n@cocotb.test()\nasync def invalid_direct_targets(dut):\n    program = {\n        0: JAL(0, 120),\n        120: _b(-8, 0, 0, 2, 0x63), 124: _b(-8, 0, 0, 3, 0x63),\n        128: BEQ(0, 0, -2), 132: BNE(0, 0, -2),\n        136: JAL(9, 2), 140: ADDI(10, 0, 151), 144: JALR(9, 10, 0),\n        148: EBREAK(),\n    }\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_trace=fetches)\n    pcs = [0, *range(120, 152, 4)]\n    assert fetches[:len(pcs)] == pcs\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [120, 124, 128, 136, 144]\n    assert all(r[\"rd\"] == 0 and r[\"rd_wdata\"] == 0 for r in rets if r[\"trap\"])\n\n\n@cocotb.test()\nasync def speculative_fetch_stays_in_ram(dut):\n    # Train the forward branch's index before testing the upper RAM bound.\n    # The final backward branch would wrap below RAM on a taken prediction.\n    program = {\n        0: JAL(0, 0x60),\n        0x60: BEQ(0, 0, 256), 0x160: JAL(0, 0x7ff00),\n        0x80060: JAL(0, 0x7ff00), 0xfff60: BNE(0, 0, 0xa0),\n        0xfff64: JAL(0, -0xfff00), 0x64: BNE(0, 0, -128), 0x68: EBREAK(),\n    }\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_trace=fetches)\n    pcs = [0, 0x60, 0x160, 0x80060, 0xfff60, 0xfff64, 0x64, 0x68]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert fetches[:len(pcs) + 1] == [0, 0x60, 0x64, *pcs[2:]]\n    assert all(pc < 0x100000 and pc % 4 == 0 for pc in fetches)\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\ncmd.do\ncore_bench.bin\ncore_bench.binx\ncore_bench.db\ncore_bench.fs\ncore_bench.log\ncore_bench.pin.html\ncore_bench.power.html\ncore_bench.rpt.html\ncore_bench.rpt.txt\n","exit_code":0,"status":"completed"}}
