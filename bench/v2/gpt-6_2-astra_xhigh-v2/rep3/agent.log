on runs alongside the tag check. Only load_hit authorizes\n  // the consumer to enter EX before this load reaches WB.\n  logic [31:0] effective_addr, load_result;\n  assign effective_addr = rs1 + in.imm;\n  assign load_hit = in.ctrl.mem_read && probe_ok && probe_row.valid && !store_conflict\n                 && effective_addr[31:2] == {12'b0, probe_row.tag, probe_index}\n                 && mem_aligned(in.ctrl.mem_width, effective_addr[1:0]);\n  assign load_result = extend_load(probe_row.word_data, effective_addr[1:0],\n                                   in.ctrl.mem_width, in.ctrl.mem_sext);\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  logic is_div, div_req_ready, div_result_valid;\n  logic [31:0] div_result;\n  assign is_div = in.valid && (in.ctrl.alu_op == ALU_DIV  || in.ctrl.alu_op == ALU_DIVU ||\n                               in.ctrl.alu_op == ALU_REM  || in.ctrl.alu_op == ALU_REMU);\n  assign div_wait = is_div && !div_result_valid;\n\n  alu u_alu (\n    .clock            (clock),\n    .reset            (reset),\n    .div_req_valid    (is_div && !stall),\n    .div_req_ready    (div_req_ready),\n    .div_result_valid (div_result_valid),\n    .div_result_ready (!stall),\n    .div_result       (div_result),\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );\n\n_helpers.py\nconftest.py\ntest_alu.py\ntest_alu_runner.result.xml\ntest_decoder.py\ntest_decoder_runner.result.xml\ntest_imm_gen.py\ntest_imm_gen_runner.result.xml\ntest_pipeline.py\ntest_pipeline_runner.result.xml\ntest_reg_file.py\ntest_reg_file_runner.result.xml\n","exit_code":0,"status":"completed"}}
