= str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[10606 of 13678 chars elided by tools/bench/transcript.py; sha256:f1942239d523727c]…\n=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n-rw-rw----+ 1 nobody nogroup   757 Nov 20 20:39 formal/riscv-formal/COPYING\n-rw-rw----+ 1 nobody nogroup  3086 Nov 20 20:39 formal/riscv-formal/CodeOfConduct\n-rw-rw----+ 1 nobody nogroup  3998 Nov 20 20:39 formal/riscv-formal/README.md\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 20 20:39 formal/riscv-formal/bus\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 20 20:39 formal/riscv-formal/checks\ndrwxrwx---+ 7 nobody nogroup  4096 Nov 20 21:35 formal/riscv-formal/cores\ndrwxrwx---+ 3 nobody nogroup  4096 Nov 20 20:39 formal/riscv-formal/docs\ndrwxrwx---+ 2 nobody nogroup 12288 Nov 20 20:39 formal/riscv-formal/insns\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 20 20:39 formal/riscv-formal/monitor\ndrwxrwx---+ 5 nobody nogroup  4096 Nov 20 20:39 formal/riscv-formal/tests\n20\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\n", "exit_code": 1, "status": "failed"}}
