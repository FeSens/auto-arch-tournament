{"type":"item.started","item":{"id":"item_109","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/preview/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def verified_subword_lanes_and_misaligned_access(dut):\n    word=0x817fabcd\n    program=[ADDI(1,0,0x180), LW(2,1,0), NOP(), NOP(),\n             _i(0,1,0,3,3), _i(1,1,4,4,3), _i(2,1,1,5,3),\n             _i(0,1,5,6,3), _i(1,1,1,7,3), LW(8,1,2), EBREAK()]\n    reads=[]\n    def ready(ren,wen,addr,wdata):\n        if ren:\n            reads.append(addr)\n        return True\n    rets,_=await _run(dut,program,{0x180:word},after_sweep=1026,dmem_ready=ready)\n    assert reads==[0x180], reads\n    assert [(r['mem_rmask'],r['rd_wdata']) for r in rets[4:8]]==[\n        (1,0xffffffcd),(2,0xab),(12,0xffff817f),(3,0xabcd)]\n    assert all(r['mem_rdata']==word and r['mem_addr']==0x180 for r in rets[4:8])\n    assert all(r['trap'] and r['mem_rmask']==0 and r['rd']==0 for r in rets[8:10])\nPY\ncd \\\"\"'$TMPDIR/preview\" && python3 -m pytest -q test > all-tests.log 2>&1 && tail -4 all-tests.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
