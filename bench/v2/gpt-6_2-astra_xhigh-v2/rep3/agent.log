──────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 2..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 3..\nSBY 22:14:53 [insn_xor_ch0] engine_0: ##   0:00:00  Checking assertions in step 20..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 4..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 5..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 6..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 7..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 8..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 9..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 10..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 11..\nSBY 22:14:53 [insn_xori_ch0] engine_0: ##   0:00:00  Skipping step 12..\nSBY 22:14:53 