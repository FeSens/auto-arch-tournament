checks a\n  // control transfer's destination before admitting the speculative successor.\n  typedef struct packed {\n    logic        valid;\n    logic [17:0] word_addr;\n    logic [31:0] instr;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t ram_response_q, held_respo\n…[3722 of 6794 chars elided by tools/bench/transcript.py; sha256:c19d91d01d1ac8a8]…\n assign is_jalr     = instr[6:0] == 7'h67 && instr[14:12] == 3'b000;\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc              = pc;\n    out.instr           = instr;\n    out.valid           = imem_ready || saved_hit;\n    // Predict with the old count, but train from the newest count if two\n    // consecutive branch PCs alias. This bypass only feeds the snapshot.\n    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n  end\n\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 87.58\n  lut4: 3601\n  ff: 1078\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-001-r12s0\n  updated: '2026-11-21T04:45:07.237067Z'\n", "exit_code": 0, "status": "completed"}}
