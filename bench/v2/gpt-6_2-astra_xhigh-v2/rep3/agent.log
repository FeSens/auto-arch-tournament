{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'for f in cores/bench/generated/timing/*/gw.log; do tail -2 \"$f\"; done; sed -n '\"'180,270p' cores/bench/test/test_alu.py; ls -l \\\"\"'$TMPDIR\"/banks-formal.*/formal/riscv-formal/cores/'","aggregated_output":"[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\nasync def mulhu(dut):\n    await _setup(dut)\n    await _check_mul(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check_mul(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n\n\n@cocotb.test()\nasync def mulhsu(dut):\n    await _setup(dut)\n    # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n    await _check_mul(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    # (-1) * unsigned -> high half is sign extension\n    await _check_mul(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def multiply_every_clock(dut):\n    await _setup(dut)\n    rng = random.Random(36)\n    previous = None\n    for _ in range(64):\n        for op in (ALU_MULH, ALU_MUL, ALU_MULHSU, ALU_MUL, ALU_MULHU, ALU_MUL):\n            a, b = rng.getrandbits(32), rng.getrandbits(32)\n            x = a - 2**32 if op in (ALU_MULH, ALU_MULHSU) and a >> 31 else a\n            y = b - 2**32 if op == ALU_MULH and b >> 31 else b\n            expected = ((x * y) >> (0 if op == ALU_MUL else 32)) & MASK32\n            await _check_mul(dut, op, a, b, expected, previous)\n            previous = expected\n\n    dut.mul_issue.value = 0\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    assert int(dut.mem_product.value) == previous\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 10, 3, 3)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, -123, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    # INT_MIN / -1 -> INT_MIN  (defined overflow per RV32IM)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n\n\n@cocotb.test()\nasync def divu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n\n@cocotb.test()\nasync def divu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 42, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def rem_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    # -10 % 3 trunc-to-zero: -10 = (-3)*3 + (-1) -> rem = -1 = 0xFFFFFFFF\n    await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\n    # 10 % -3 trunc-to-zero: 10 = (-3)*(-3) + 1 -> rem = 1 (sign of dividend)\n    await _check_div(dut, ALU_REM, 10, 0xFFFFFFFD, 1)\n\n\n@cocotb.test()\nasync def rem_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 0xDEADBEEF, 0, 0xDEADBEEF)\n\n\n@cocotb.test()\nasync def rem_overflow(dut):\n    await _setup(dut)\ntotal 8\ndrwxrwx---+ 3 hwebench hwebench 4096 Nov 21 01:19 bench-wCuLIgEMG\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"rg -n 'benchmark|formal|median' ../../experiments/log.jsonl | tail -1 | cut -c1-600; cat cores/bench/rtl/hazard_unit.sv; git status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"rg -n 'benchmark|formal|median' ../../experiments/log.jsonl | tail -1 | cut -c1-600; cat cores/bench/rtl/hazard_unit.sv; git status --short\"","aggregated_output":"25:{\"id\": \"hyp-20261121-003-r8s2\", \"title\": \"Predict the quotient with a piecewise-linear reciprocal and one residual check\", \"category\": \"predictor\", \"motivation\": \"The champion takes 3,097,817 cycles for ten CoreMark iterations at 71.595 MHz.\\nIts worst reported path goes from the reciprocal seed ROM to the quotient\\nregister. The timed loop contains no divide instructions, but this path\\nsets a clock constraint on every iteration. A more accurate initial\\nreciprocal prediction can free two of the seven divide clocks for product\\nregisters while preserving the issue rate of ordinary multipli\n// rtl/hazard_unit.sv\n//\n// An immediate consumer of a multiply, divide/remainder, or unverified\n// load waits one cycle so WB can forward the result to its EX inputs.\n//\n// A load-use interlock retries the fetch and bubbles ID/EX. Data memory\n// and divider waits hold the current ID/EX entry until EX can advance.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_result,  // result unavailable for EX bypass\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       redirect,          // EX has resolved a branch/jump\n  input  logic       div_wait,          // keep the issuing divide in ID/EX\n  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n  // random ~22% stall in vex_main.cpp). When low, the corresponding\n  // memory request is NOT serviced this cycle.\n  input  logic       imem_ready,\n  input  logic       dmem_ready,\n  // A demand load or a store in EX/MEM needs the external data bus.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_id,          // squash fetched instruction\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic mem_use_hazard;\n  assign mem_use_hazard = id_ex_mem_result && id_ex_rd != 5'b0\n                       && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign stall_ex_mem = !dmem_ready && ex_mem_mem_op;\n  assign hold_mem_wb  = stall_ex_mem;\n  assign stall_id     = stall_ex_mem || div_wait;\n  assign stall_if     = stall_id || mem_use_hazard || !imem_ready;\n  assign flush_id     = mem_use_hazard || redirect;\n\nendmodule\n M cores/bench/rtl/alu.sv\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/forward_unit.sv\n M cores/bench/rtl/id_stage.sv\n M cores/bench/rtl/mem_stage.sv\n M cores/bench/rtl/wb_stage.sv\n M cores/bench/test/test_pipeline.py\n","exit_code":0,"status":"completed"}}
