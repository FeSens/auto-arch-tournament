{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r12s2/staged.py\" <<'\"'PY'\nimport os,shutil\nfrom pathlib import Path\nroot=Path(os.environ['TMPDIR'])\nfor suffix in ['k','l','m']:\n p=root/('r12s2'+suffix)\n shutil.copytree(root/'r12s2h/rtl',p/'rtl',dirs_exist_ok=True)\n f=p/'rtl/alu.sv'\n s=f.read_text()\n a=s.index('  logic [17:0] seed_q')\n b=s.index('        3\\\\'d5: residual_q',a)\n n='''  logic [34:0] multiplier_a;\n  logic [33:0] multiplier_b, scaled_a_q;\n  logic [68:0] product;\n  logic [31:0] quotient_q, product_q, residual_q, magnitude_q;\n  assign product = multiplier_a * multiplier_b;\n  always_ff @(posedge clock) begin\n    if (busy_q) begin\n      case (pass_q)\n        3'd0: begin\n          multiplier_a <= {3'b0,normalized};\n          multiplier_b <= {16'b0,inverse[normalized[30:21]]};\n          k_q <= ~clz_b;\n        end\n        3'd1: begin\n          multiplier_a <= ~product[49:15];\n          scaled_a_q <= {dividend,2'b0} >> k_q;\n        end\n        3'd2: begin\n          multiplier_a <= {1'b0,scaled_a_q};\n          multiplier_b <= product[51:18];\n        end\n        3'd3: begin\n          multiplier_a <= {3'b0,product[67:36]};\n          multiplier_b <= {2'b0,divisor};\n          quotient_q <= product[67:36];\n        end\n        3'd4: product_q <= product[31:0];\n'''\n s=s[:a]+n+s[b:]\n if suffix=='l':\n  s=s.replace('quotient_q, product_q, residual_q, magnitude_q','product_q, residual_q, magnitude_q').replace('          quotient_q <= product[67:36];\\\\n','').replace('magnitude_q <= quotient_q +','magnitude_q <= multiplier_a[31:0] +')\n if suffix=='m':\n  s=s.replace('        3\\\\'d4: product_q <= product[31:0];', '''        3'd4: begin\n          product_q <= product[31:0];\n          if (negate_q && \"'!want_rem_q) begin\n            quotient_q <= -multiplier_a[31:0];\n          end\n        end'\"''')\n  s=s.replace('magnitude_q <= quotient_q + {31\\\\'b0, residual_q >= divisor};', '''magnitude_q <= (residual_q >= divisor) ?\n                            (negate_q ? quotient_q - 1'b1 : quotient_q + 1'b1) : quotient_q;''').replace(': negate_q ? -magnitude_q : magnitude_q;',': negate_q && want_rem_q ? -magnitude_q : magnitude_q;')\n f.write_text(s)\nPY\npython \\\"\"'$TMPDIR/r12s2/staged.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
