{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c 'for d in h i j; do tail -3 \"$TMPDIR/r12s2$d/gowin_p1/gw.log\"; done\nsed -n '\"'330,365p' cores/bench/test/test_alu.py\"","aggregated_output":"[60%] Tech-Mapping Phase 0 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n[60%] Tech-Mapping Phase 0 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n[60%] Tech-Mapping Phase 0 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n\n@cocotb.test()\nasync def scaled_dividend_boundaries(dut):\n    await _setup(dut)\n    for k in range(32):\n        scale = 1 << k\n        # B itself is an exact multiple with all k discarded bits set.\n        # Also check either side of the largest multiple representable.\n        b = 2 * scale - 1\n        last_multiple = (MASK32 // b) * b\n        for a in sorted({b, last_multiple - 1, last_multiple, min(last_multiple + 1, MASK32)}):\n            q, r = divmod(a, b)\n            await _check_div(dut, ALU_DIVU, a, b, q, hold_cycles=2 if a == b else 0)\n            await _check_div(dut, ALU_REMU, a, b, r, hold_cycles=2 if a == b else 0)\n\n\n@cocotb.test()\nasync def reciprocal_boundaries(dut):\n    await _setup(dut)\n    divisors = {b for k in range(32) for b in (2**k - 1, 2**k, 2**k + 1)\n                if 0 < b <= MASK32}\n    # Exercise both endpoints of every normalized ROM bin. Eight low\n    # divisor bits vary within each bin and disappear from the ROM index.\n    for prefix in range(512, 1024):\n        divisors.update((prefix << 8, (prefix << 8) | 255))\n    for b in sorted(divisors):\n        multiple = (MASK32 // b) * b\n        for a in (multiple - 1, multiple, min(multiple + 1, MASK32)):\n            q, r = divmod(a, b)\n            await _check_div(dut, ALU_DIVU, a, b, q)\n            await _check_div(dut, ALU_REMU, a, b, r)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n","exit_code":0,"status":"completed"}}
