toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ntotal 464\ndrwxrwx---+  3 nobody nogroup   4096 Nov 21 09:07 .\ndrwxrwx---+  3 nobody nogroup   4096 Nov 21 09:07 ..\n-rw-rw----+  1 nobody nogroup   2317 Nov 21 09:07 Makefile\ndrwxrwx\n…[4037 of 7109 chars elided by tools/bench/transcript.py; sha256:331986b475b41bbd]…\naccess',\n105:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'no_output'}\n109:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'malformed_marker',\n112:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'no_ebreak',\n115:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'oob_access',\n118:    valid, reason = validate_coremark_uart(marker.get('uart', ''), iterations)\n120:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'crc_mismatch',\n122:    return {'passed': True, 'elf': coremark_elf.name}\n148:    # Split ELFs into full-trace cosim vs CRC-validated coremark.\n150:    trace_elfs = [p for p in all_elfs if p.name != \"coremark.elf\"]\n151:    coremark   = next((p for p in all_elfs if p.name == \"coremark.elf\"), None)\n153:    if not trace_elfs and coremark is None:\n170:    if coremark is not None:\n171:        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n179:    tested = len(trace_elfs) + (1 if coremark else 0)\n", "exit_code": 0, "status": "completed"}}
