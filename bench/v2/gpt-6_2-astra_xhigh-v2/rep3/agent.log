{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv && cat cores/bench/rtl/hazard_unit.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Each admitted PC reads a row containing its last successor PC and word.\n// The word can satisfy a stalled fetch. EX resolves all control transfers.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_value,\n  output logic              jalr_forecast,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc_q, pc, instr;\n  logic [1:0] counters [0:63];\n  logic [1:0] count;\n  logic is_branch, is_jal, predicted_taken;\n  logic [31:0] fallthrough, offset, target;\n\n  // One synchronous read and one write per cycle. PC[10:2] can alias:\n  // the full word address qualifies instruction reuse, and EX checks a\n  // JALR target before admitting the speculative successor.\n  typedef struct packed {\n    logic        valid;\n    logic [17:0] word_addr;\n    logic [31:0] instr;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t response_q;\n  logic [8:0] predecessor_q, sweep_index_q, write_index;\n  logic sweep_q, predecessor_valid_q, lookup_valid_q, jalr_q;\n  logic admit, ram_pc, train_pair, fence_i, forecast_valid;\n  logic [31:0] forecast_pc;\n\n  assign admit = !reset && !redirect && !stall;\n  assign ram_pc = pc[\n…[4415 of 7487 chars elided by tools/bench/transcript.py; sha256:bb0742dc6e7a0753]…\ncycle.\n  input  logic       imem_ready,\n  input  logic       dmem_ready,\n  // A demand load or a store in EX/MEM needs the external data bus.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_id,          // squash fetched instruction\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic mem_use_hazard;\n  assign mem_use_hazard = id_ex_mem_result && id_ex_rd != 5'b0\n                       && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign stall_ex_mem = !dmem_ready && ex_mem_mem_op;\n  assign hold_mem_wb  = stall_ex_mem;\n  assign stall_id     = stall_ex_mem || div_wait;\n  assign stall_if     = stall_id || mem_use_hazard || !imem_ready;\n  assign flush_id     = mem_use_hazard || redirect;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
