[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ntotal 448\n-rw-rw----+  1 nobody nogroup   2317 Nov 20 20:44 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 20 20:44 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 20 20:44 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 20 20:44 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 20 20:44 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 20 20:44 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 20 20:44 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 20 20:44 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 20 20:44 selftest.S\nGOWIN_HOME=/opt/gowin\nTARGET=bench\n","exit_code":0,"status":"completed"}}
