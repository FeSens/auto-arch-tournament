{"type": "item.completed", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/if_stage.sv; sed -n '112,225p' cores/bench/rtl/ex_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Each PC reads its last successor's PC, instruction and direct target.\n// A matching successor word can also satisfy a stalled fetch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              stall_id,\n  input  logic              replay,\n  input  logic              imem_ready,\n  input  logic              redirect,         // result of registered EX checks\n  input  logic [31:0]       resolved_pc,\n  input  logic              wait_target,      // direct-target addition in MEM\n  input  logic              direct_certified, // current EX slot\n  input  logic [17:0]       direct_target,\n  input  logic              fence_i,          // valid FENCE.I in EX\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic              train_increment,\n  input  logic              mem_transfer,\n  input  logic [31:0]       mem_pc,\n  input  logic [31:0]       mem_instr,\n  input  logic              mem_direct,\n  input  logic [31:0]       mem_direct_target,\n  output logic              forecast_used,\n  output logic [31:0]       forecast_pc,\n  output logic [31:0]       fallthrough_q,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [31:0] held_pc_q, pc, instr;\n  logic [1:0] counters [0:63];\n  logic [1:0] prior_count, updated_count;\n  logic against_bias;\n  logic is_branch, is_jal, is_jalr;\n\n  // One synchronous read and one write per cycle. PC[10:2] can alias:\n  // the full word address qualifies in\n…[8763 of 11835 chars elided by tools/bench/transcript.py; sha256:cdaef1f4c26bfda7]…\n              ({32{!(in.ctrl.is_jump || in.ctrl.mem_read)}} & alu_result);\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      // Capture both forwarded operands on issue, while their writers\n      // are still in MEM/WB. Keep them through the result transfer.\n      if (div_req_ready) begin\n        reg_q.rs1_val    <= rs1;\n        reg_q.rs2_val    <= rs2;\n        reg_q.write_data <= rs2;\n      end\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= resolved_pc;\n      reg_q.direct_disp   <= in.imm[20:1];\n      reg_q.delayed_direct <= in.valid && delayed_direct;\n      reg_q.ctrl          <= in.valid && !div_wait ? ctrl_with_trap : '0;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
