uild_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n        return {**r, 'perturbation': k}\n    return await asyncio.gather(*(one(k, s) for k, s in pairs))\n\ndef run_coremark_ipc(worktree: str, sim_bin: str | None = None, env: dict | \n…[10365 of 13437 chars elided by tools/bench/transcript.py; sha256:50879583f044cc40]…\ned_taken = (is_jal || (is_branch && (instr[31] ^ count[1])))\n                        && target[31:20] == 0 && target[1:0] == 0;\n\n  // A resolving miss discards the pending fetch even if imem is waiting.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc_q <= RESET_PC;\n    else if (redirect) pc_q <= redirect_target;\n    else if (!stall)   pc_q <= predicted_taken ? target : fallthrough;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc              = pc;\n    out.instr           = instr;\n    // A steered JALR selects forecast_pc by construction.\n    out.valid           = imem_ready || (forecast_valid && (jalr_q || forecast_pc == pc_q));\n    out.predicted_taken = predicted_taken;\n    out.alternate_pc    = predicted_taken ? fallthrough : target;\n    // Predict with the old count, but train from the newest count if two\n    // consecutive branch PCs alias. This bypass only feeds the snapshot.\n    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
