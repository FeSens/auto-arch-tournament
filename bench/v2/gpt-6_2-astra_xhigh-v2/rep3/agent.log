                          int(dut.io_rvfi_insn_0.value)))\n                if retired[-1][-1] == EBREAK():\n                    break\n            await RisingEdge(dut.clock)\n            await Timer(1, \\\"ns\\\")\n        assert mutate_cycle is not None\n        assert fetch[mutate_cycle:mutate_cycle+3] == [0,16,4], (stall_recovery, fetch)\n        assert retired[-3:] == [(0,4,NOP()), (4,8,store), (8,12,EBREAK())], retired\n        assert stores == [0], stores\n\ndef test_probe():\n    run_cocotb(\\\"core\\\", [\\\"core_pkg.sv\\\", \\\"alu.sv\\\", \\\"decoder.sv\\\", \\\"imm_gen.sv\\\", \\\"reg_file.sv\\\",\n                        \\\"if_stage.sv\\\", \\\"id_stage.sv\\\", \\\"ex_stage.sv\\\", \\\"mem_stage.sv\\\",\n                        \\\"wb_stage.sv\\\", \\\"hazard_unit.sv\\\", \\\"forward_unit.sv\\\", \\\"core.sv\\\"],\n               \\\"test_btb_probe\\\")\nPY\ncd '/srv/hwebench/tmp/ec844b20/54a15e27/btb-prototype.lIazFK' && pytest -q test/test_btb_probe.py > btb-probe.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
