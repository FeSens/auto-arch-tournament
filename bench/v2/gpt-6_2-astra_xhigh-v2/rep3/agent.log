{"type": "item.completed", "item": {"id": "item_340", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/core_pkg.sv'", "aggregated_output": "// rtl/core_pkg.sv\n//\n// Core-wide constants, load formatting and pipeline-bundle types.\n//\n// Compilation-unit scope (no `package … endpackage` wrapper) because\n// Yosys's Verilog frontend rejects `import pkg::*;` even though it\n// accepts `pkg::sym` refs and package definitions. A file-scope\n// definition with an `\\`ifndef` guard is the lowest common denominator\n// across Verilator, Yosys, sby, and nextpnr-himbaechel.\n//\n// Order matters: this file MUST be the first source passed to any tool\n// (Verilator/cocotb runner / build.sh / formal staging). Subsequent\n// includes hit the guard and become no-ops.\n//\n// Latency:        n/a (declarations only).\n// RVFI fields:    shared load alignment and extraction rules for EX and MEM.\n`ifndef CORE_PKG_DEFINED\n`define CORE_PKG_DEFINED\n\n  // ── ALU operations ──────────────────────────────────────────────────────\n  localparam logic [4:0] ALU_ADD    = 5'd0;\n  localparam logic [4:0] ALU_SUB    = 5'd1;\n  localparam logic [4:0] ALU_AND    = 5'd2;\n  localparam logic [4:0] ALU_OR     = 5'd3;\n  localparam logic [4:0] ALU_XOR    = 5'd4;\n  localparam logic [4:0] ALU_SLT    = 5'd5;\n  localparam logic [4:0] ALU_SLTU   = 5'd6;\n  localparam logic [4:0] ALU_SLL    = 5'd7;\n  localparam logic [4:0] ALU_SRL    = 5'd8;\n  localparam logic [4:0] ALU_SRA    = 5'd9;\n  localparam logic [4:0] ALU_LUI    = 5'd10;\n  localparam logic [4:0] ALU_MUL    = 5'd11;\n  localparam logic [4:0] ALU_MULH   = 5'd12;\n  localparam logic [4:0] ALU_MULHU  = 5'd13;\n  localparam logic [4:0] ALU_MULHSU = 5'd14;\n  localparam logic [4:0] ALU_DIV    = 5'd15;\n  localparam logic [4:0] ALU_DIVU   = 5'd16;\n  localparam logic [4:0] ALU_REM    = 5'd17;\n  localparam logic [4:0] ALU_REMU   = 5'd18;\n\n  // ── Branch operations (encoded = funct3 of BRANCH opcode) ───────────────\n  // Phase 1 only references BR_BEQ (decoder default). The rest are\n  // referenced by the EX-stage comparator in phase 2; we keep them here\n  // for documentation and silence UNUSEDPARAM until then.\n  localparam logic [2:0] BR_BEQ  = 3'd0;\n  /* verilator l\n…[3753 of 6825 chars elided by tools/bench/transcript.py; sha256:ac63fa44e768f967]…\n       // post-forward rs1 used by EX\n    logic [31:0] rs2_val;        // post-forward rs2 used by EX\n    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    logic        branch_taken;\n    logic [31:0] branch_target;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] write_data;     // architectural result for WB and forwarding\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_339", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// While fetching A, probe the row for the predicted B. At admission of B,\n// register its row in fabric so its successor C can issue on the next clock.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_value,\n  output logic              jalr_forecast,\n  output logic [19:2]       forecast_word_addr,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc_q, pc, instr;\n  logic [1:0] counters [0:63];\n  logic [1:0] count;\n  logic predicted_taken;\n  logic [31:0] fallthrough, predicted_target;\n\n  // Rows are indexed by the predecessor but contain the successor's full\n  // RAM word address. The direct target and flags describe that successor.\n  typedef struct packed {\n    logic [17:0] word_addr;\n    logic [31:0] instr;\n    logic [17:0] direct_addr;\n    logic        branch_ok;\n    logic        jal_ok;\n  } successor_data_t;\n  typedef struct packed {\n    logic            valid;\n    successor_data_t data;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t probe_q;\n  successor_data_t bank0_q, bank1_q, saved;\n  logic [8:0] predecessor, sweep_index_q, fill_index_q, write_index;\n  logic [17:0] fill_addr_q\n…[7625 of 10697 chars elided by tools/bench/transcript.py; sha256:e720bcc0a375a2ab]…\n         : fallthrough[10:2];\n\n  // Form all three PC candidates before the edge. A late interlock or\n  // redirect only chooses which register supplies the new request.\n  logic [31:0] next_q, recovery_q, parked_pc_q;\n  logic recover_q, park_q;\n  always_ff @(posedge clock) begin\n    next_q      <= predicted_taken ? predicted_target : fallthrough;\n    recovery_q  <= reset ? RESET_PC : redirect_target;\n    parked_pc_q <= pc_q;\n    recover_q   <= reset || redirect;\n    park_q      <= stall;\n  end\n  assign pc_q = recover_q ? recovery_q : park_q ? parked_pc_q : next_q;\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc              = pc;\n    out.instr           = instr;\n    out.valid           = imem_ready || saved_hit;\n    out.predicted_taken = predicted_taken;\n    // Predict with the old count, but train from the newest count if two\n    // consecutive branch PCs alias. This bypass only feeds the snapshot.\n    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_341", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// Decode registers mutually exclusive EX/MEM and MEM/WB bypass selects.\n//\n// Latency:        1 cycle for integer/multiply, variable for divide/remainder.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               is_mul,        // valid MUL-family entry in ID/EX\n  output logic [31:0]        mem_product,\n  output logic               is_div,\n  output logic [31:0]        div_result,\n  input  logic [31:0]        early_word,\n  input  logic [19:2]        early_word_addr,\n  output logic               early_addr_match,\n  output logic [31:0]        mem_addr,\n  input  logic [2:0]         fwd_rs1_sel,\n  input  logic [2:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_data\n  input  logic               jalr_forecast,\n  input  logic [19:2]        forecast_word_addr,\n  output ex_mem_t  out,\n  output logic               writes_rd,     // write control entering EX/MEM on advance\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:0]        redirect_target,\n  output logic               train_en,\n  output logic [5:0]         train_index,\n  output logic [1:0]         train_value\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  // Decode clears the register-file contribution when a bypass wins.\n  assign rs1 = in.rs1_val | ({32{fwd_rs1_sel[0]}} & fwd_ex_mem)\n                          | ({32{fwd_rs1_s\n…[5521 of 8593 chars elided by tools/bench/transcript.py; sha256:e7c9f1efbf674400]…\nddr;\n      // Capture both forwarded operands on issue, while their writers\n      // are still in MEM/WB. Keep them through the result transfer.\n      if (div_req_ready) begin\n        reg_q.rs1_val    <= rs1;\n        reg_q.rs2_val    <= rs2;\n        reg_q.write_data <= rs2;\n      end\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : (in.pc + 32'd4);\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
