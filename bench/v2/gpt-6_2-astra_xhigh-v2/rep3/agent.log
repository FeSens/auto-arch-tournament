cessor_data_t;\n  typedef struct packed {\n    logic            valid;\n    successor_data_t data;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t probe_q;\n  successor_data_t held_q, fresh_q, retained_q, saved;\n  logic [8:0] predecessor, sweep_ind\n…[8187 of 11259 chars elided by tools/bench/transcript.py; sha256:28e8e0da4919324d]…\n[8:0] + 9'd1;\n  assign predicted_index = imem_ready ? bus_hint : cached_hint;\n\n  // Form all three PC candidates before the edge. A late interlock or\n  // redirect only chooses which register supplies the new request.\n  logic recover_q, park_q;\n  always_ff @(posedge clock) begin\n    next_q      <= predicted_taken ? predicted_target : fallthrough;\n    recovery_q  <= reset ? RESET_PC : redirect_target;\n    parked_pc_q <= pc_q;\n    recover_q   <= reset || redirect;\n    park_q      <= stall;\n  end\n  assign pc_q = recover_q ? recovery_q : park_q ? parked_pc_q : next_q;\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc              = pc;\n    out.instr           = instr;\n    out.valid           = imem_ready || saved_hit;\n    out.predicted_taken = predicted_taken;\n    // Predict with the old count, but train from the newest count if two\n    // consecutive branch PCs alias. This bypass only feeds the snapshot.\n    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
