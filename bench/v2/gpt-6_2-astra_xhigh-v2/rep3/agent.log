== requests\n    assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"] == 5] == [24] * 3\n    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"rd\"] in (7, 8)] == [(7, 44), (8, 45)]\n    assert waits == 3 and stores == [1, 2, 3] and dmem == {64: 3}\n\n\n@cocotb.test()\nasync def aliasing_branch_updates(dut):\n…[1744 of 4816 chars elided by tools/bench/transcript.py; sha256:96c707a9f208cdad]…\nif wen:\n            store_attempts.append((addr, wen, wdata))\n            if len(store_attempts) < 4:\n                return False\n            program[addr] = wdata\n        return True\n\n    def fetch_ready(pc):\n        nonlocal visits, parked\n        if pc == 56:\n            parked += 1\n            return parked > 512\n        if pc == 64:\n            visits += 1\n            requests.append(0)\n        if pc == 68:\n            requests[-1] += 1\n            return visits == 1 or (visits >= 3 and requests[-1] > 3)\n        return True\n\n    rets, _ = await _run(dut, program, {0x100: replacement}, sweep_cycles=513,\n                         imem_ready=fetch_ready, dmem_ready=data_ready, max_cycles=600)\n    assert store_attempts == [(68, 15, replacement)] * 4\n    assert requests == [1, 1, 4, 4]\n    assert parked == 513\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 68] == [1, 2, 12, 22]\n    assert [r[\"pc\"] for r in rets if r[\"insn\"] == 0x0000100f] == [44]\n\n\n@cocotb.test()\nasync def invalid_direct_targets(dut):\n", "exit_code": 0, "status": "completed"}}
