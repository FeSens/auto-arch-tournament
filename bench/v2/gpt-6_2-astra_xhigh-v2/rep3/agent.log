{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c 'cat >>\"$TMPDIR/collect/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def registered_operand_sources(dut):\n    program = [\n        ADDI(5, 0, 11), ADDI(6, 0, 29), ADD(7, 5, 6),\n        ADDI(5, 0, 2), ADDI(5, 0, 7), ADD(8, 5, 6),\n        ADDI(5, 0, 21), JALR(5, 0, 2), ADD(9, 5, 6),\n        ADDI(5, 0, 33), LW(5, 0, 2), ADD(10, 5, 6),\n        ADDI(5, 0, 44), LW(12, 0, 64), ADD(11, 5, 6),\n        EBREAK(),\n    ]\n    waits = 0\n    def ready(ren, wen, addr, wdata):\n        nonlocal waits\n        if ren and addr == 64 and waits < 4:\n            waits += 1\n            return False\n        return True\n    rs, _ = await _run(dut, program, {64: 55}, dmem_ready=ready)\n    assert [r['pc'] for r in rs] == list(range(0, len(program)*4, 4))\n    assert [r['order'] for r in rs] == list(range(len(program)))\n    for i, a in [(2,11),(5,7),(8,21),(11,33),(14,44)]:\n        r = rs[i]\n        assert (r['rs1_rdata'], r['rs2_rdata'], r['rd_wdata']) == (a,29,a+29)\n    assert [r['pc'] for r in rs if r['trap']] == [7*4,10*4]\n    assert waits == 4\nPY\ncat >>\\\"\"'$TMPDIR/collect/test/test_reg_file.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def reset_hides_stale_registers(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \\\"ns\\\").start())\n    await _reset(dut)\n    await _write(dut, 2, 0xabc)\n    await _write(dut, 12, 0x123)\n    assert await _read(dut, 2, 12) == (0xabc, 0x123)\n    await _reset(dut)\n    assert await _read(dut, 2, 12) == (0, 0)\n    await _write(dut, 2, 0x55)\n    assert await _read(dut, 12, 2) == (0, 0x55)\n    await _write(dut, 0, 0x123)\n    assert await _read(dut, 0, 0) == (0, 0)\nPY\ncd \\\"\"'$TMPDIR/collect\"\npytest --rootdir=. -q test/test_reg_file.py test/test_pipeline.py >targeted.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
