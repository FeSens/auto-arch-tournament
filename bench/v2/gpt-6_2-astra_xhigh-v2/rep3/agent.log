d.value == 0\n        await _tick(dut)\n\n    for cycle in range(hold_cycles + 1):\n        assert dut.div_req_ready.value == 0\n        assert dut.div_result_valid.value == 1\n        actual = int(dut.div_result.value)\n        assert actual == (expected & MASK32), (\n            f\"op={op} a={a:#x} b={b:#x} expected={expected & MASK32:#x} got={actual:#x}\"\n        )\n   \n…[3713 of 6785 chars elided by tools/bench/transcript.py; sha256:fde4ef2ef005dccd]…\nm_to_reg;\n    ctrl_decoded.is_illegal = dec_is_illegal;\n  end\n\n  // ── ID/EX register ──────────────────────────────────────────────────────\n  id_ex_t reg_q;\n\n  // A squash clears the slot's validity before EX can issue it.\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      reg_q.pc       <= in.pc;\n      reg_q.rs1_val  <= rs1_data;\n      reg_q.rs2_val  <= rs2_data;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.instr    <= in.instr;\n      reg_q.ctrl     <= ctrl_decoded;\n      is_mul         <= dec_alu_op == ALU_MUL || dec_alu_op == ALU_MULH ||\n                        dec_alu_op == ALU_MULHSU || dec_alu_op == ALU_MULHU;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q.valid <= 1'b0;\n    end else if (!stall) begin\n      reg_q.valid <= in.valid;\n    end\n  end\n\n  always_comb begin\n    out = reg_q;\n    out.valid = reg_q.valid && !squash;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
