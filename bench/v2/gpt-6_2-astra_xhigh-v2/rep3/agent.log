{"type": "item.started", "item": {"id": "item_72", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r6-late.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nfrom tools.eval.gowin import build_all\ntmp=Path(os.environ['TMPDIR'])\np=tmp/'r6-late'\nt=p/'rtl'\nshutil.copytree(tmp/'r6-rfcollector/rtl',t)\ndef sub(f,a,b):\n k=t/f\n s=k.read_text()\n assert a in s,a\n k.write_text(s.replace(a,b))\nf='core_pkg.sv'\nsub(f,'    logic        is_mul;', '    logic        late1, late2;\\\\n    logic        is_mul;')\nf='core.sv'\nsub(f,'  // ── IF ─','''  logic [1:0] id_rs1_sel, id_rs2_sel;\n  logic ex_writes, mem_writes;\n  logic late_exec_q, defer_operand, late_producer, aligned_load;\n  logic [4:0] id_op;\n  assign id_op = if_id_w.instr[6:2];\n  // An OP or OP-IMM can execute in MEM; M instructions issue only in EX.\n  assign defer_operand = if_id_w.instr[1:0] == 2'b11\n                      && ((id_op == 5'b00100)\n                      || (id_op == 5'b01100 && if_id_w.instr[31:25] \"'!= 7'\"'b1))\n                      && (\"'!id_ex_w.ctrl.mem_read || aligned_load);\n  assign late_producer = id_ex_w.ctrl.mem_read || mul_in_ex || late_exec_q;\n  always_ff @(posedge clock) begin\n    if (reset) late_exec_q <= 1'\"'b0;\n    else if (\"'!stall_id)\n      late_exec_q <= !flush_id && if_id_w.valid && late_producer && defer_operand\n                 && (id_rs1_sel == 1 || id_rs2_sel == 1);\n  end\n  // ── IF ─'\"''')\nsub(f,'  logic [1:0] id_rs1_sel, id_rs2_sel;\\\\n  logic ex_writes, mem_writes;\\\\n  // The selector','  // The selector')\nsub(f,'.id_ex_mem_result (id_ex_w.ctrl.mem_read || mul_in_ex)', '.id_ex_mem_result (late_producer && \"'!defer_operand)'\"')\nsub(f,'.ex_writes       (ex_writes),','.ex_writes       (ex_writes),\\\\n    .aligned_load    (aligned_load),\\\\n    .late_exec       (late_exec_q),')\nsub(f,'.mem_writes (mem_writes)', '.mem_writes (mem_writes),\\\\n    .wb_data (wb_w_data)')\nf='ex_stage.sv'\nsub(f,'  output logic ex_writes,','  output logic ex_writes,\\\\n  output logic aligned_load,\\\\n  input logic late_exec,')\nsub(f,'  assign ex_writes =', '''  logic [1:0] load_offset;\n  assign load_offset = rs1[1:0] + in.imm[1:0];\n  assign aligned_load = in.ctrl.mem_width == 0 ||\n                       (in.ctrl.mem_width == 1 ? \"'!load_offset[0] : load_offset == 0);\n  assign ex_writes ='\"''')\nsub(f,'      reg_q.is_mul        <= is_mul;', '''      reg_q.is_mul        <= is_mul;\n      reg_q.late1         <= late_exec && fwd_rs1_sel == 1;\n      reg_q.late2         <= late_exec && fwd_rs2_sel == 1;''')\nf='mem_stage.sv'\nsub(f,'  output logic mem_writes,','  output logic mem_writes,\\\\n  input logic [31:0] wb_data,')\nsub(f,'  // ── MEM/WB register', '''  logic [31:0] late_a, late_b_raw, late_b, late_result;\n  assign late_a = in.late1 ? wb_data : in.rs1_val;\n  assign late_b_raw = in.late2 ? wb_data : in.rs2_val;\n  assign late_b = in.ctrl.alu_src ? {{20{in.instr[31]}}, in.instr[31:20]} : late_b_raw;\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_ADD:    late_result = late_a + late_b;\n      ALU_SUB:    late_result = late_a - late_b;\n      ALU_AND:    late_result = late_a & late_b;\n      ALU_OR:     late_result = late_a | late_b;\n      ALU_XOR:    late_result = late_a \"'^ late_b;\n      ALU_SLT:    late_result = {31'\"'b0, \"'$signed(late_a) < $signed(late_b)};\n      ALU_SLTU:   late_result = {31'\"'b0, late_a < late_b};\n      ALU_SLL:    late_result = late_a << late_b[4:0];\n      ALU_SRL:    late_result = late_a >> late_b[4:0];\n      ALU_SRA:    late_result = \"'$unsigned($signed(late_a) >>> late_b[4:0]);\n      default:    late_result = '\"'0;\n    endcase\n  end\n\n  // ── MEM/WB register''')\nsub(f,'in.is_mul ? mem_product : in.alu_result','(in.late1 || in.late2) ? late_result : in.is_mul ? mem_product : in.alu_result')\nsub(f,'reg_q.rs1_val    <= in.rs1_val','reg_q.rs1_val    <= late_a')\nsub(f,'reg_q.rs2_val    <= in.rs2_val','reg_q.rs2_val    <= late_b_raw'