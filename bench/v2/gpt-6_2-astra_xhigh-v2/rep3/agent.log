{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"sed -n '115,182p' cores/bench/test/test_pipeline.py; ls -la formal | head -35; ls -d /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep3/formal/riscv-formal/{insns,checks,cores}\"","aggregated_output":"        await ClockCycles(dut.clock, 513)\n    drive_fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        ren       = int(dut.io_dmemREn.value)\n        wen       = int(dut.io_dmemWEn.value)\n        wdata     = int(dut.io_dmemWData.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        ready = True if dmem_ready is None else dmem_ready(ren, wen, da, wdata)\n        dut.io_dmemReady.value = int(ready)\n        if wen and ready:\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        drive_fetch(ia)\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Nov 20 22:10 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 20 22:14 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 20 22:10 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 20 22:10 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 20 22:10 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    68 Nov 20 22:10 riscv-formal -> /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep3/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 20 22:10 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 20 22:10 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 20 22:10 wrapper_si.sv\n/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep3/formal/riscv-formal/checks\n/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep3/formal/riscv-formal/cores\n/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-r