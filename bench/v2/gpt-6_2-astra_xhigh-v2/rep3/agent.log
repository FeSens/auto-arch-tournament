{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'rg --files cores/bench && cat cores/bench/rtl/if_stage.sv && cat cores/bench/core.yaml && git check-ignore -v implementation_notes.md cores/bench/implementation_notes.md'", "aggregated_output": "cores/bench/rtl/decoder.sv\ncores/bench/rtl/forward_unit.sv\ncores/bench/rtl/imm_gen.sv\ncores/bench/rtl/mem_stage.sv\ncores/bench/rtl/alu.sv\ncores/bench/rtl/if_stage.sv\ncores/bench/rtl/reg_file.sv\ncores/bench/rtl/hazard_unit.sv\ncores/bench/rtl/id_stage.sv\ncores/bench/rtl/ex_stage.sv\ncores/bench/rtl/wb_stage.sv\ncores/bench/rtl/core.sv\ncores/bench/rtl/core_pkg.sv\ncores/bench/CORE_PHILOSOPHY.md\ncores/bench/core.yaml\ncores/bench/LESSONS.md\ncores/bench/experiments/progress.png\ncores/bench/experiments/log.jsonl\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\n// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Each admitted PC reads a row containing its last successor PC and word.\n// The word can satisfy a stalled fetch. EX resolves all control transfers.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_value,\n  output logic              jalr_forecast,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc_q, pc, instr;\n  logic [1:0] counters [0:63];\n  logic [1:0] count;\n  logic is_branch, i\n…[3705 of 6777 chars elided by tools/bench/transcript.py; sha256:34870ddfd2bc39a3]…\nid && (jalr_q || forecast_pc == pc_q));\n    out.predicted_taken = predicted_taken;\n    out.alternate_pc    = predicted_taken ? fallthrough : target;\n    // Predict with the old count, but train from the newest count if two\n    // consecutive branch PCs alias. This bypass only feeds the snapshot.\n    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n  end\n\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 79.301\n  lut4: 3615\n  ff: 837\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-001-r9s0\n  updated: '2026-11-21T00:58:08.166039Z'\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\n", "exit_code": 0, "status": "completed"}}
