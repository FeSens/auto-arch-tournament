{"type": "item.started", "item": {"id": "item_82", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/stride/control.py\" <<'\"'PY'\nimport shutil,os\nfrom pathlib import Path\nr=Path(os.environ['TMPDIR'])\nfor name in ['typed_profile','typed_slow']:\n    d=r/name/'rtl';shutil.copytree(r/'shaped/rtl',d,dirs_exist_ok=True)\n    p=d/'core.sv';s=p.read_text()\n    if name=='typed_slow':\n        s=s.replace('assign predict_fast = fast[id_ex_w.pc[7:2]];', \\\"assign predict_fast = 1'b0;\\\")\n    else:\n        s=s.replace('  ex_stage u_ex (','''  logic mark;\n  integer loads, hits, replays, dependent_short, slow_bubbles;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      mark <= 0;\n      loads <= 0; hits <= 0; replays <= 0; dependent_short <= 0; slow_bubbles <= 0;\n    end else begin\n      if (io_dmemReady && |io_dmemWEn && io_dmemAddr == 'h10000100) mark <= 1;\n      if (io_dmemReady && |io_dmemWEn && io_dmemAddr == 'h10000104) begin\n        mark <= 0;\n        \"'$display(\"LOAD_PROFILE loads=%0d hits=%0d replays=%0d dependent_short=%0d slow_bubbles=%0d\",\n                  loads,hits,replays,dependent_short,slow_bubbles);\n      end\n      if (mark) begin\n        if (!stall_ex_mem && ex_mem_w.valid && ex_mem_w.ctrl.mem_read) begin\n          loads <= loads+1;\n          if (value_hit) hits <= hits+1;\n          if (replay) replays <= replays+1;\n          if (id_ex_w.valid && ex_mem_w.rd != 0 &&\n              (id_ex_w.rs1_addr == ex_mem_w.rd || id_ex_w.rs2_addr == ex_mem_w.rd))\n            dependent_short <= dependent_short + 1;\n        end\n        if (!stall_id && if_id_w.valid && id_ex_w.ctrl.mem_read && !predict_fast && id_ex_w.rd != 0 &&\n            (rs1_addr_w == id_ex_w.rd || rs2_addr_w == id_ex_w.rd)) slow_bubbles <= slow_bubbles + 1;\n      end\n    end\n  end\n  ex_stage u_ex ('\"''')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/stride/control.py\"\ncat > \"$TMPDIR/stride/checks.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil,sys\nr=Path(os.environ['TMPDIR'])\nd=r/sys.argv[1]\nshutil.copytree('cores/bench/test',d/'test',dirs_exist_ok=True)\np=d/'test/test_pipeline.py'\ns=p.read_text().replace('await ClockCycles(dut.clock, 513)','await ClockCycles(dut.clock, 1026)')\ns+='''\n@cocotb.test()\nasync def warm_typed_retry(dut):\n    # First install an LW result via SW, and consume it with the bus stalled.\n    # The byte access to the same location needs a fresh signed result.\n    word=0x180\n    program=[\n        ADDI(10,0,word), ADDI(3,0,-128), SW(3,10,0), NOP(), NOP(),\n        LW(4,10,0), ADD(5,4,3), ADDI(12,0,17),\n        _i(0,10,0,6,3), ADD(7,6,12), NOP(), NOP(),\n        _i(0,10,0,6,3), ADD(8,6,12), EBREAK()\n    ]\n    reads=[]; wait=[0]\n    def bus(ren,wen,addr,wdata):\n        if ren:\n            wait[0]+=1\n            if wait[0]<4: return False\n            reads.append(addr)\n            return True\n        return bool(wen)\n    rets,_=await _run(dut,program,dmem_ready=bus,after_sweep=True)\n    assert [i['insn'] for i in rets]==program\n    assert [i['order'] for i in rets]==list(range(len(program)))\n    assert reads==[word] and wait[0]==4\n    assert rets[6]['cycle']==rets[5]['cycle']+1 and rets[6]['rd_wdata']==0xffffff00\n    assert rets[9]['rs1_rdata']==0xffffff80 and rets[9]['rs2_rdata']==17\n    assert rets[9]['rd_wdata']==0xffffff91 and rets[9]['cycle']==rets[8]['cycle']+2\n    assert rets[13]['cycle']==rets[12]['cycle']+1 and rets[13]['rd_wdata']==0xffffff91\n    for i in [5,8,12]:\n        assert rets[i]['mem_rdata']==0xffffff80\n\n@cocotb.test()\nasync def typed_store_and_branch(dut):\n    word=0x200\n    # Two addresses mapping to the same row contain distinct branch values.\n    # A wrong early zero must never take the branch, even on a multi-cycle miss.\n    high=0x1000\n    load_hi=LW(4,11,word)\n    program=[ADDI(1,0,7),ADDI(10,0,word),0x000015b7,SW(0,10,0),NOP(),NOP(),\n             load_hi,BEQ(4,0,8),SW(1,10,4),_s(1,1,10,0,0x23),NOP(),NOP(),\n             LW(5,10,0),ADDI(6,5,1),EBREAK()]\n    wait=[0]; accepted=[]\n    def bus(ren,wen,addr,wdata):\n        if ren:\n            wait[0]+=1\n            if wait[0]<3:return False\n        if wen:accepted.append((addr,wen))\n        return True\n    rets,mem=await _run(dut,program,{word+high:42},dmem_ready=bus,after_sweep=True)\n    assert [i['insn'] for i in rets]==program\n    assert [i['order'] for i in rets]==list(range(len(program)))\n    assert rets[6]['rd_wdata']==42 and rets[7]['pc_next']==32\n    assert accepted==[(word,15),(word+4,15),(word+1,2)]\n    assert mem[word]==0x700 and rets[-2]['rd_wdata']==0x701\n'''\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/stride/checks.py\" shaped'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
