{"type": "item.completed", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/bash -c \"date -u && head -90 cores/bench/test/test_alu.py && rg -n 'ram_response|pc\\\\[|fallthrough' cores/bench/rtl/if_stage.sv\"", "aggregated_output": "Sat Nov 21 04:52:59 UTC 2026\n\"\"\"Check EX integer results, registered EX products and seven-clock division.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.reset.value = 1\n    dut.mul_issue.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    assert dut.div_req_ready.value == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    dut.div_result_ready.value = 0\n    await _tick(dut)  # issue\n\n    dut.div_req_valid.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n    for _ in range(7):\n        assert dut.div_req_ready.value == 0\n        assert dut.div_result_valid.value == 0\n        await _tick(dut)\n\n    for cycle in range(hold_cycles + 1):\n        assert dut.div_req_ready.value == 0\n        assert dut.div_result_valid.value == 1\n        actual = int(dut.div_result.value)\n        assert actual == (expected & MASK32), (\n            f\"op={op} a={a:#x} b={b:#x} expected={expected & MASK32:#x} got={actual:#x}\"\n        )\n        if cycle < hold_cycles:\n            await _tick(dut)\n    dut.div_result_ready.value = 1\n    await _tick(dut)\n    assert dut.div_result_valid.value == 0\n    assert dut.div_req_ready.value == 1\n\n\nasync def _check_mul(dut, op, a, b, expected, previous=None):\n    dut.op.value = op\n    dut.mul_rs1.value = a\n    dut.mul_rs2.value = b\n    dut.mul_issue.value = 1\n    if previous is not None:\n        await Timer(1, \"ns\")\n        assert int(dut.mem_product.value) == previous\n32:  output logic [31:0]       fallthrough_q,\n52:  successor_t ram_response_q, held_response_q, response;\n57:  logic fresh, hold_slot, steer, row_is_fallthrough, saved_hit, held_hit_q;\n59:  assign ram_pc = pc[31:20] == 0 && pc[1:0] == 0;\n60:  assign mem_ram_pc = mem_pc[31:20] == 0 && mem_pc[1:0] == 0;\n66:      successors[write_index] <= {!sweep_q, mem_pc[19:2], mem_instr};\n68:      predecessor_q <= mem_pc[10:2];\n69:    ram_response_q <= successors[pc[10:2]];\n96:      fallthrough_q[15:0]  <= pc[15:0] + 16'd4;\n97:      fallthrough_q[31:16] <= pc[31:16] + {15'b0, &pc[15:2]};\n100:    lookup_valid_q  <= ram_pc && !sweep_q && !(train_pair && predecessor_q == pc[10:2]);\n110:    response = fresh ? ram_response_q : held_response_q;\n113:  assign steer         = request_q && lookup_valid_q && ram_response_q.valid && !sweep_q;\n116:  assign row_is_fallthrough = {12'b0, ram_response_q.word_addr, 2'b00} == fallthrough_q;\n118:                         (hold_slot ? held_forecast_q : steer && !row_is_fallthrough);\n121:              ({32{fresh && steer}} & {12'b0, ram_response_q.word_addr, 2'b00}) |\n122:              ({32{fresh && !steer}} & fallthrough_q);\n125:                      hold_slot ? held_hit_q : (request_q || row_is_fallthrough));\n135:  assign count       = counters[pc[7:2]];\n148:    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n", "exit_code": 0, "status": "completed"}}
