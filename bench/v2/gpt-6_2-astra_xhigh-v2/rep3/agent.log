{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/ec844b20/48793438/r12-structural-3xybocum/table.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path(__file__).resolve().parent\np=root/'bands'/'rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\ns=(p/'alu.sv').read_text().split('  // Shift the highest')[0]\n# absolute reciprocal coefficients, ceil endpoints, 3 guard bits.\n# pre-bias upper secant by 7/8 so truncation and interpolation can err at most one unit either way.\nranges=[(0,11,0),(11,12,1)]+[(j,j+2,3+3*((j-12)//2)) for j in range(12,30,2)]+[(30,32,29)]\ns+='''\n  logic [12:0] addr,addr_q;\n  logic [9:0] t,t_q,t1_q;\n  always_comb begin\n    addr=0;\n    t=0;\n'''\ncount=0\ngroups=[]\nfor i,(lo,hi,shift) in enumerate(ranges):\n start=0 if i==0 else 2**lo; end=2**hi\n sz=(end-start)>>shift\n groups.append((start,end,shift,count)); count+=sz\n assert count<8192\n keyword=('    if' if i==0 else '    else if')\n cond=(f\\\"(divisor[31:{hi}] == 0)\\\" if hi<32 else \\\"(1'b1)\\\")\n bits=(end.bit_length()-2 if hi<32 else 31)\n s+=f\\\"{keyword} {cond} begin\\\\n\\\"\n # use concatenations/constant offsets, priority between broad ranges\n s+=f\\\"      addr=13'({groups[-1][3]} + (13'(divisor[{bits}:{shift}]) - {(start>>shift)}));\\\\n\\\"\n w=min(10,shift)\n if w:\n  index=f\\\"divisor[{shift-1}:{shift-w}]\\\"\n  s+=f\\\"      t={index};\\\\n\\\" if w==10 else f\\\"      t={{{index},{10-w}'b0}};\\\\n\\\"\n s+=\\\"    end\\\\n\\\"\ns+='''  end\n  always_ff @(posedge clock) begin\n    addr_q <= addr;\n    t_q <= t;\n    t1_q <= t_q;\n  end\n'''\nS=1<<35\ndef ceilrec(x): return min(S-1,(S+x-1)//x)\nmj=0\nrows=[]\nfor start,end,shift,base in groups:\n for l in range(start,end,1<<shift):\n  inter=ceilrec(max(1,l))\n  delta=inter-ceilrec(l+(1<<shift)) if shift else 0\n  rows.append((inter,delta)); mj=max(mj,delta)\nprint('table',count,mj)\ndw=mj.bit_length()\ns+=f\\\"  logic [{34+dw}:0] coeff[0:{count-1}];\\\\n\\\"\ns+=\\\"  initial begin\\\\n\\\"\nfor i,(inter,delta) in enumerate(rows):\n s+=f\\\"    coeff[{i}] = {35+dw}'h{((inter<<dw)|delta):x};\\\\n\\\"\ns+=\\\"  end\\\\n\\\"\ns+=f'''  logic [34:0] intercept_q, intercept2_q;\n  logic [{dw-1}:0] drop_q;\n  logic [{dw+10-1}:0] drop_product_q;\n  logic [34:0] recip_q;\n  logic [66:0] aq;\n  logic [31:0] quotient_q;\n  logic [63:0] qb;\n  logic [32:0] prod_q;\n  always_ff @(posedge clock) begin\n    {{intercept_q,drop_q}} <= coeff[addr_q];\n    drop_product_q <= drop_q * t1_q;\n    intercept2_q <= intercept_q;\n    recip_q <= intercept2_q - 35'(drop_product_q >> 10) - 35'd7;\n    quotient_q <= aq[66:35];\n    prod_q <= qb[32:0];\n  end\n  assign aq = dividend * recip_q;\n  assign qb = quotient_q * divisor;\n  wire [32:0] r = {{1'b0,dividend}} - prod_q;\n  wire [32:0] rab = r - {{1'b0,divisor}};\n  logic [31:0] magnitude_q;\n  always_ff @(posedge clock) begin\n    if (busy_q && pass_q == 3'd6)\n      magnitude_q <= want_rem_q ?\n         (r[32] ? r[31:0]+divisor : (rab[32] ? r[31:0] : rab[31:0]))\n         : (r[32] ? quotient_q-1'b1 : (rab[32] ? quotient_q : quotient_q+1'b1));\n  end\n  assign div_result = zero_q ? (want_rem_q ? (negate_q ? -dividend : dividend) : 32'hffff_ffff) :\n                      negate_q ? -magnitude_q : magnitude_q;\n\"'`endif\nendmodule\n'\"'''\n(p/'alu.sv').write_text(s)\nPY\npython /srv/hwebench/tmp/ec844b20/48793438/r12-structural-3xybocum/table.py\ndate -u\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
