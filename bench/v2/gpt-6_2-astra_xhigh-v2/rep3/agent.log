{"type":"item.started","item":{"id":"item_99","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/predecoded_split\" && cp -r \"$TMPDIR/split_decode/rtl\" \"$TMPDIR/predecoded_split/rtl\"\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'predecoded_split/rtl/if_stage.sv'\ns=p.read_text()\ns=s.replace('  // One synchronous read','''  // All B/J bits that depend on the format, prepared on the row-fill path.\n  logic [12:0] bus_fields, selected_fields;\n  assign bus_fields = imem_data[3] ? {imem_data[19:12], imem_data[20], imem_data[24:21]}\n                                   : {{8{imem_data[31]}}, imem_data[7], imem_data[11:8]};\n  // One synchronous read''').replace('    logic        valid;\\\\n    logic [17:0] word_addr;', '    logic        valid;\\\\n    logic [12:0] fields;\\\\n    logic [17:0] word_addr;').replace('\"'!sweep_q, pc[19:2], imem_data'\"', '\"'!sweep_q, bus_fields, pc[19:2], imem_data'\"')\na=s.index('  assign offset      =');b=s.index('  assign fallthrough',a)\ns=s[:a]+'''  assign selected_fields = imem_ready ? bus_fields : response_q.fields;\n  assign offset = {{12{instr[31]}}, selected_fields[12:4], instr[30:25], selected_fields[3:0], 1'b0};\n'''+s[b:];p.write_text(s)\nPY\nPYTHONPATH=. python3 \\\"\"'$TMPDIR/target-cache/timing.py\" \"$TMPDIR/predecoded_split\" 0 1 2'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
