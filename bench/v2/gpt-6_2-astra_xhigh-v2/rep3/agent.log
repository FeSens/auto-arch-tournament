tools/eval/gowin.py:158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\ntools/eval/gowin.py:173:    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\ntools/eval/gowin.py:175:                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\ntools/eval/gowin.py:192:        \"perturbations\": [[r[\"place_option\"], r[\"fmax_mhz\"], r[\"levels\"]] for r in results],\ntools/eval/gowin.py:200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\ntools/eval/gowin.py:214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\ntools/eval/gowin.py:221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n.\n..\ngowin\nhwe-python\nhwe-toolchain\n.\n..\n.agents\n.aws\n.codex\n.git\ncodex-bwrap-synthetic-mount-targets-1001\n.\n..\nCORE_PHILOSOPHY.md\nLESSONS.md\ncore.yaml\nexperiments\ngenerated\nobj_dir\nrtl\ntest\nworktrees\n","exit_code":0,"status":"completed"}}
