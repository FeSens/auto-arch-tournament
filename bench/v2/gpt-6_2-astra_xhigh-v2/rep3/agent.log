{"type": "item.completed", "item": {"id": "item_63", "type": "command_execution", "command": "/bin/bash -c \"sed -n '492,590p' cores/bench/test/test_pipeline.py && tail -n 4 \\\"\"'$TMPDIR/wb-check/cores/bench/generated/timing/gowin_p1/gw.log\"'", "aggregated_output": "async def buffered_pointer_chain(dut):\n    data = {64: 68, 68: 72, 72: 0x81234567}\n    program = [\n        LW(0, 0, 64), LW(0, 0, 68), LW(0, 0, 72),\n        ADDI(1, 0, 64), NOP(),  # x1 is in MEM when the first LW decodes\n        LW(2, 1, 0), LW(2, 2, 0), LW(3, 2, 0), ADDI(4, 3, 1), EBREAK(),\n    ]\n    reads = []\n\n    def ready(ren, wen, addr, wdata):\n        assert not wen\n        if ren:\n            reads.append(addr)\n            assert reads == list(data)[:len(reads)]\n            return True\n        return False\n\n    rets, _ = await _run(dut, program, data, dmem_ready=ready, sweep_cycles=1025)\n    _check_linear_retirements(rets, program)\n    assert reads == list(data)\n    chain = rets[5:9]\n    assert [r[\"cycle\"] for r in chain] == list(range(chain[0][\"cycle\"], chain[0][\"cycle\"] + 4))\n    assert [(r[\"mem_addr\"], r[\"mem_rmask\"], r[\"mem_rdata\"]) for r in chain[:3]] == [\n        (addr, 15, val) for addr, val in data.items()\n    ]\n    assert [(r[\"rs1_rdata\"], r[\"rd_wdata\"]) for r in chain] == [\n        (64, 68), (68, 72), (72, 0x81234567), (0x81234567, 0x81234568),\n    ]\n\n\n@cocotb.test()\nasync def buffered_xor_miss(dut):\n    # 68 ^ 4 selects the resident word at 64. Both loads actually need 72.\n    data = {64: 0x123, 72: 0x87654321}\n    program = [\n        ADDI(1, 0, 68), LW(0, 0, 64), NOP(), NOP(),\n        LW(2, 1, 4), ADDI(3, 2, 1), LW(4, 1, 4), ADDI(5, 4, 2), EBREAK(),\n    ]\n    reads = []\n\n    def ready(ren, wen, addr, wdata):\n        assert not wen\n        if ren:\n            reads.append(addr)\n            assert len(reads) <= 4\n            return addr == 64 or len(reads) == 4\n        return False\n\n    rets, _ = await _run(dut, program, data, dmem_ready=ready, sweep_cycles=1025)\n    _check_linear_retirements(rets, program)\n    assert reads == [64, 72, 72, 72]\n    for i in (4, 6):\n        load, use = rets[i:i+2]\n        assert (load[\"mem_addr\"], load[\"mem_rmask\"], load[\"mem_rdata\"]) == (72, 15, data[72])\n        assert (load[\"rd_wdata\"], use[\"rs1_rdata\"]) == (data[72], data[72])\n        assert use[\"cycle\"] == load[\"cycle\"] + 2\n    assert [rets[i][\"rd_wdata\"] for i in (5, 7)] == [0x87654322, 0x87654323]\n\n\n@cocotb.test()\nasync def buffered_store_collision_and_invalidation(dut):\n    sb = _s(67, 6, 0, 0, 0x23)\n    program = [\n        ADDI(6, 0, -123), SW(6, 0, 64), NOP(), NOP(),\n        LW(1, 0, 64), ADDI(2, 1, 1),\n        ADDI(3, 0, 0x155), SW(3, 0, 64), LW(1, 0, 64), ADDI(2, 1, 1),\n        sb, NOP(), NOP(), LW(1, 0, 64), ADDI(2, 1, 1), EBREAK(),\n    ]\n    requests = []\n\n    def ready(ren, wen, addr, wdata):\n        if ren or wen:\n            requests.append((ren, wen, addr, wdata if wen else 0))\n            return len(requests) % 3 == 0\n        return False\n\n    rets, mem = await _run(dut, program, dmem_ready=ready, sweep_cycles=1025)\n    _check_linear_retirements(rets, program)\n    expected = [\n        (0, 15, 64, 0xFFFFFF85),\n        (0, 15, 64, 0x155), (1, 0, 64, 0),  # store overlaps the resolved read\n        (0, 8, 67, 0x85858585), (1, 0, 64, 0),  # spaced load sees invalidation\n    ]\n    assert requests == [request for request in expected for _ in range(3)]\n    assert mem[64] == 0x85000155\n    for i, value, gap in [(4, 0xFFFFFF85, 1), (8, 0x155, 2), (13, mem[64], 2)]:\n        load, use = rets[i:i+2]\n        assert (load[\"mem_addr\"], load[\"mem_rmask\"], load[\"mem_rdata\"]) == (64, 15, value)\n        assert (load[\"rd_wdata\"], use[\"rd_wdata\"]) == (value, value + 1)\n        assert use[\"cycle\"] == load[\"cycle\"] + gap\n    store = rets[10]\n    assert (store[\"mem_addr\"], store[\"mem_wmask\"], store[\"mem_wdata\"]) == (64, 8, 0x85