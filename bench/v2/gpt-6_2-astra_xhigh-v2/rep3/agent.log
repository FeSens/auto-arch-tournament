{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, shutil\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'recip_study'\nfor name in ('shared','memfix'):\n shutil.copytree(p/'rtl',p/name)\nf=p/'shared/alu.sv'\ns=f.read_text()\ns=s.replace('logic signed [32:0] mul_a_q, mul_b_q;', 'logic signed [35:0] dsp_a_q, dsp_b_q;')\ns=s.replace('logic signed [65:0] mul_product;', 'logic signed [71:0] product;')\ns=s.replace('assign mul_product = mul_a_q * mul_b_q;', 'assign product = dsp_a_q * dsp_b_q;')\ns=s.replace('mul_product[','product[')\ns=s.replace('      mul_a_q <= {a[31] && (op == ALU_MULH || op == ALU_MULHSU), a};\\\\n      mul_b_q <= {b[31] && op == ALU_MULH, b};\\\\n','')\nstart=s.index('  logic [19:0] predicted_q;')\nend=s.index('  // For nonzero B',start)\ns=s[:start]+'''  logic [19:0] prediction;\n  logic [31:0] shifted_q, quotient_q, multiple_q, residual_q;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [26:0] tangent_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign tangent_product = distance_q * coeff_q[15:0];\n  assign prediction = coeff_q[35:16] + {9'b0,tangent_product[26:16]};\n\n  always_ff @(posedge clock) begin\n    if (mul_issue) begin\n      dsp_a_q <= {{4{a[31] && (op == ALU_MULH || op == ALU_MULHSU)}}, a};\n      dsp_b_q <= {{4{b[31] && op == ALU_MULH}}, b};\n    end else if (busy_q) begin\n      case (pass_q)\n        3'd0: begin\n          normalized_q <= normalized;\n          k_q <= ~clz_b;\n          distance_q <= ~normalized[21:11];\n          coeff_q <= coefficients[normalized[30:22]];\n        end\n        3'd1: begin\n          dsp_a_q <= {4'b0, normalized_q};\n          dsp_b_q <= {16'b0, prediction};\n          shifted_q <= dividend >> k_q;\n        end\n        3'd2: dsp_a_q <= {1'b0, ~product[51:17]};\n        3'd3: begin\n          dsp_a_q <= {4'b0, shifted_q};\n          dsp_b_q <= {2'b0, product[53:20]};\n        end\n        3'd4: begin\n          quotient_q <= product[65:34];\n          dsp_a_q <= {4'b0,product[65:34]};\n          dsp_b_q <= {4'b0,divisor};\n        end\n        3'd5: multiple_q <= product[31:0];\n        3'd6: residual_q <= dividend - multiple_q;\n        default: ;\n      endcase\n    end\n  end\n''' +s[end:]\nf.write_text(s)\n# Verify the residual at the MEM boundary, isolating the forwarding path.\ndef memfix(f):\n s=f.read_text()\n if f.name=='core_pkg.sv':\n  s=s.replace('logic        is_mul;', 'logic        is_div;\\\\n    logic [31:0] div_result;\\\\n    logic        is_mul;')\n if f.name=='ex_stage.sv':\n  s=s.replace('      reg_q.is_mul        <= is_mul;', '      reg_q.is_div        <= div_result_valid && is_div;\\\\n      reg_q.div_result    <= div_result;\\\\n      reg_q.is_mul        <= is_mul;')\n  s=s.replace(': div_result_valid ? div_result : alu_result;', ': alu_result;')\n if f.name=='core.sv':\n  s=s.replace('|| mul_in_ex),','|| mul_in_ex ||\\\\n                       (id_ex_w.valid && id_ex_w.ctrl.alu_op >= ALU_DIV && id_ex_w.ctrl.alu_op <= ALU_REMU)),')\n if f.name=='mem_stage.sv':\n  s=s.replace('in.is_mul ? mem_product : in.alu_result;', '({32{in.is_mul}} & mem_product) | ({32{in.is_div}} & in.div_result) |\\\\n                            ({32{\"'!in.is_mul && !in.is_div}} & in.alu_result);'\"')\n f.write_text(s)\nfor name in ('core.sv','core_pkg.sv','ex_stage.sv','mem_stage.sv'): memfix(p/'memfix'/name)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
