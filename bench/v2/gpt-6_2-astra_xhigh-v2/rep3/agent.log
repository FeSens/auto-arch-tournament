{"type":"item.started","item":{"id":"item_106","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/shaped/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def retried_m_op_and_same_row_store(dut):\n    a=0x1b0\n    program=[\n        ADDI(10,0,a), ADDI(3,0,6), ADDI(11,0,42), ADDI(12,0,100),\n        SW(11,10,0), NOP(), NOP(), LW(4,10,0), DIV(5,4,3),\n        SW(12,10,0), LW(4,10,0), DIV(6,4,3), EBREAK()\n    ]\n    requests=[];writes=[];waits=[3]\n    def bus(ren,wen,addr,data):\n        if wen:\n            if data==100 and waits[0]:\n                waits[0]-=1\n                return False\n            writes.append(data)\n        if ren: requests.append(addr)\n        return True\n    rets,_=await _run(dut,program,after_sweep=1026,dmem_ready=bus)\n    assert [r['order'] for r in rets]==list(range(len(program)))\n    assert [r['insn'] for r in rets]==program\n    assert writes==[42,100] and requests==[a]\n    assert rets[8]['rd_wdata']==7 and rets[11]['rd_wdata']==16\n    assert rets[11]['rs1_rdata']==100 and rets[11]['rs2_rdata']==6\n\n@cocotb.test()\nasync def misaligned_and_mmio_never_reused(dut):\n    # Prime a low RAM index and revisit it at the marker page and misaligned.\n    program=[ADDI(4,0,12),SW(4,0,0x100),NOP(),NOP(),LW(5,0,0x100),\n             0x10000337,SW(4,6,0x100),LW(8,0,0x101),ADD(9,8,5),EBREAK()]\n    writes=[];reads=[]\n    def bus(ren,wen,addr,data):\n        if wen:writes.append(addr)\n        if ren:reads.append(addr)\n        return True\n    rets,_=await _run(dut,program,after_sweep=1026,dmem_ready=bus)\n    assert writes==[0x100,0x10000100] and reads==[]\n    assert rets[7]['rd']==0 and rets[7]['trap']==1 and rets[7]['mem_rmask']==0\n    assert rets[8]['rs1_rdata']==0 and rets[8]['rd_wdata']==12\nPY\ncd \\\"\"'$TMPDIR/shaped\" && python -m pytest -q --rootdir=. --confcutdir=. -p no:cacheprovider test/test_pipeline.py > unit-run.log 2>&1 && tail -2 unit-run.log'","aggregated_output":"","exit_code":null,"status