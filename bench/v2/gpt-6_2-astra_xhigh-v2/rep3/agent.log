{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/fetch_fallthrough_xnulyah3/tag.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nd=Path(__file__).parent;p=d/sys.argv[1];shutil.copytree('cores/bench/rtl',p)\nf=p/'core.sv';s=f.read_text()\nbase='''  logic [1:0] nibble_match;\n  logic row_valid_write;\n  assign row_valid_write = \"'!sweep_q && (io_dmemREn || (&io_dmemWEn));\n  for (genvar n=0; n<2; n++) begin: tag_nibble\n    wire [15:0] bits_to_write = row_valid_write ? (16'\"'b1 << ex_mem_w.mem_addr[12+4*n +: 4]) : 16'b0;\n    wire [13:0] bit_addr = {ex_addr[11:2], ex_addr[12+4*n +: 4]};\n'''\nif 'native' in sys.argv:\n base+='''    wire [31:0] dout;\n    SDPB #(.BIT_WIDTH_0(16), .BIT_WIDTH_1(1), .READ_MODE(1'b0)) tag_cells (\n      .DO(dout), .DI({16'b0,bits_to_write}), .ADA({write_index,4'b0}), .ADB(bit_addr),\n      .BLKSELA(3'b0), .BLKSELB(3'b0), .CEA(update_row), .CEB(\"'!stall_ex_mem), .OCE(1'\"'b1),\n      .CLKA(clock), .CLKB(clock), .RESETA(1'b0), .RESETB(1'b0));\n    assign nibble_match[n] = dout[0];\n'''\nelse:\n base+='''    logic [15:0] decoded_tags[0:1023];\n    always_ff @(posedge clock) begin\n      if (update_row) decoded_tags[write_index] <= bits_to_write;\n      if (\"'!stall_ex_mem) nibble_match[n] <= decoded_tags[bit_addr[13:4]][bit_addr[3:0]];\n    end\n'\"'''\na=s.index('  assign resolved_hit =');b=s.index(';',a)\ns=s[:a]+base+'  end\\\\n  assign resolved_hit = resolved_available_q && (&nibble_match)'+s[b:]\nf.write_text(s)\nPY\np=\\\"\"'$TMPDIR/fetch_fallthrough_xnulyah3\"\npython \"$p/tag.py\" tags native\npython \"$p/tag.py\" tagsbeh'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
