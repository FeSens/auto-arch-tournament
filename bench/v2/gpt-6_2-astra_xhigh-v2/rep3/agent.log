 build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separatel\n…[1712 of 4784 chars elided by tools/bench/transcript.py; sha256:9392e676fa2c4922]…\n.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\nFilesystem      Size  Used Avail Use% Mounted on\n/dev/md2        905G  749G  111G  88% /srv/hwebench/tmp/ec844b20/f34de10f\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\ncat: /sys/fs/cgroup/memory.max: No such file or directory\n20\n", "exit_code": 0, "status": "completed"}}
