  assert dmem[68] == 42\nPY\npytest -q --rootdir=. test/test_pipeline.py > pipeline.log 2>&1\ntest_status=\"'$?\ntail -25 pipeline.log\nexit \"$test_status\"'","aggregated_output":".                                                                        [100%]\n1 passed in 0.70s\n","exit_code":0,"status":"completed"}}
