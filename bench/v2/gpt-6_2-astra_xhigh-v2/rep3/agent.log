   k_q          <= ~clz_b;\n          operand_a_q  <= {4'b0, normalized};\n          operand_b_q  <= {2'b0, seed[normalized[30:22]], 22'b0};\n        end\n        3'd1, 3'd3: operand_a_q <= {1'b0, ~product[65:31]};\n        3'd2: begin\n          scaled_a_q <= dividend >> k_q;\n          operand_a_q <= {4'b0, normalized_q};\n          operand_b_q <= {2'b0, product[67:34]};\n        end\n        3'd4: begin\n          operand_a_q <= {4'b0, scaled_a_q};\n          operand_b_q <= {2'b0, product[67:34]};\n        end\n        3'd5: begin\n          quotient_q  <= product[65:34];\n          operand_a_q <= {4'b0, product[65:34]};\n          operand_b_q <= {4'b0, divisor};\n        end\n        3'd6: residual_q <= dividend - product[31:0];\n        default: ;\n      endcase\n    end\n  end\n\n'''+s[end:]\nrtl.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
