{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/ec844b20/48793438/r12-structural-3xybocum/grid.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path(__file__).resolve().parent\np=root/'grid'/'rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\ns=(p/'alu.sv').read_text().split('  // Lower-bound reciprocal')[0]\ns+='''\n  logic [33:0] seed [0:2047];\n  initial begin\n    seed[0] = 34'h3ffffffff;\n    for (int i = 1; i < 2048; i++)\n      seed[i] = 34'(64'h200000000000 / (64'd2048 + 64'(i)));\n  end\n  logic [33:0] seed_q, seed2_q, reciprocal_q;\n  logic [34:0] factor_q;\n  logic [33:0] scaled_a_q;\n  logic [31:0] q_est, p_q, a_minus_b, rem0,rem1, result_q;\n  logic cor_q, can_increment;\n  wire [65:0] norm_seed = normalized_q * seed_q;\n  wire [68:0] refine = factor_q * seed2_q;\n  wire [67:0] quot_product = scaled_a_q * reciprocal_q;\n  wire [31:0] qb = q_est * divisor;\n  wire [31:0] mag = want_rem_q ? (cor_q ? rem1 : rem0) : q_est + {31'b0,cor_q};\n  always_ff @(posedge clock) begin\n    if (busy_q) begin\n      case (pass_q)\n        0: begin\n          normalized_q <= normalized;\n          k_q <= ~clz_b;\n          seed_q <= seed[normalized[30:20]];\n          a_minus_b <= dividend - divisor;\n          can_increment <= dividend >= divisor;\n        end\n        1: begin\n          seed2_q <= seed_q;\n          scaled_a_q <= {dividend,2'b0} >> k_q;\n          factor_q <= ~norm_seed[65:31];\n        end\n        2: reciprocal_q <= refine[67:34];\n        3: q_est <= quot_product[67:36];\n        4: p_q <= qb;\n        5: begin\n          rem0 <= dividend - p_q;\n          rem1 <= a_minus_b - p_q;\n          cor_q <= can_increment && p_q <= a_minus_b;\n        end\n        6: result_q <= zero_q && \"'!want_rem_q ? 32'\"'hffff_ffff : negate_q ? -mag : mag;\n        default: ;\n      endcase\n    end\n  end\n  assign div_result = result_q;\n\"'`endif\nendmodule\n'\"'''\n# C