o know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd\n…[5824 of 8896 chars elided by tools/bench/transcript.py; sha256:2a9a561122b442fb]…\nborates a stale ghost). Strip the original [verilog-files] section\n# and rebuild from the glob, with core_pkg.sv first and wrapper.sv last.\nSTAGED_CFG=\"$CORE_DIR/checks.cfg\"\ntools/eval/cosim.py:24:def _build_cosim_env(worktree, target: str | None,\ntools/eval/cosim.py:48:def run_one(elf: Path, sim_bin: str, worktree: str, env: dict | None = None,\ntools/eval/cosim.py:70:def run_coremark_crc(coremark_elf: Path, sim_bin: str, worktree: str, env: dict | None = None) -> dict:\ntools/eval/cosim.py:125:def run_cosim(worktree: str, target: str | None = None) -> dict:\ntools/eval/cosim.py:183:if __name__ == '__main__':\ntest/cosim/run_cosim.py:6:def run_verilator(sim_bin, elf, maxcycles=50_000_000, timeout=120, sim_flags=()):\ntest/cosim/run_cosim.py:22:def run_reference(elf, max_insns=10_000_000):\ntest/cosim/run_cosim.py:36:def _mismatch(i, ref, field, expected, got):\ntest/cosim/run_cosim.py:41:def compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\ntest/cosim/run_cosim.py:102:if __name__ == '__main__':\n", "exit_code": 0, "status": "completed"}}
