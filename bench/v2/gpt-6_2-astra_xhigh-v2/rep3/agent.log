{"type": "item.started", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/structural.qEoT0UwS/lanes.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nw=Path(os.environ['TMPDIR'])/'structural.qEoT0UwS'\nfor nm,kind in [('h','single'),('k','parallel'),('j','packet')]:\n d=w/nm/'rtl'; shutil.copytree('cores/bench/rtl' if nm\"'!='\"'j' else w/'a/rtl',d)\n p=d/'core_pkg.sv';s=p.read_text().replace('  function automatic logic naturally_aligned', '''  function automatic logic address_match(input logic [31:0] base, disp,\n                                           input logic [31:2] wordaddr);\n    logic [31:0] pbits, inferred, produced;\n    logic [2:0] low_sum;\n    pbits = base \"'^ disp;\n    low_sum = {1'\"'b0,base[1:0]} + {1'b0,disp[1:0]};\n    inferred = pbits \"'^ {wordaddr, 2'\"'b0};\n    produced = (base & disp) | (pbits & ~{wordaddr,2'b0});\n    address_match = (inferred[2] == low_sum[2]) && (inferred[31:3] == produced[30:2]);\n  endfunction\n\n  function automatic logic naturally_aligned''')\n s=''.join(l for l in s.splitlines(True) if 'alternate_pc;' not in l)\n p.write_text(s)\n p=d/'id_stage.sv';p.write_text(''.join(l for l in p.read_text().splitlines(True) if 'reg_q.alternate_pc' not in l))\n p=d/'ex_stage.sv';s=p.read_text().replace('  output logic [31:0]        mem_addr,','  output logic [31:0]        mem_addr,\\\\n  input logic [31:2] saved_load_word_addr,\\\\n  output logic same_load_word,')\n s=s.replace('  assign mem_addr = rs1 + in.imm;', '  assign mem_addr = rs1 + in.imm;\\\\n  assign same_load_word = address_match(rs1, in.imm, saved_load_word_addr);')\n s=s.replace('fetch_pc \"'!= jalr_target'\"','\"'!address_match(rs1,in.imm,fetch_pc[31:2])'\"')\n s=s.replace('in.alternate_pc',\\\"(in.predicted_taken ? (in.pc + 32'd4) : branch_target)\\\")\n p.write_text(s)\n p=d/'core.sv';s=p.read_text().replace('  assign early_hit = ex_ram_load', '  logic same_load_word;\\\\n  assign early_hit = id_ex_w.ct