{"type": "item.completed", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv; cat cores/bench/rtl/hazard_unit.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Each admitted PC reads a row containing its last successor PC and word.\n// The word can satisfy a stalled fetch. EX resolves all control transfers.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              stall_id,\n  input  logic              replay,\n  input  logic              imem_ready,\n  input  logic              redirect,         // result of registered EX checks\n  input  logic [31:0]       resolved_pc,\n  input  logic              fence_i,          // valid FENCE.I in EX\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_value,\n  input  logic              mem_transfer,\n  input  logic [31:0]       mem_pc,\n  input  logic [31:0]       mem_instr,\n  output logic              forecast_used,\n  output logic [31:0]       forecast_pc,\n  output logic [31:0]       fallthrough_q,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [31:0] held_pc_q, pc, instr;\n  logic [1:0] counters [0:63];\n  logic [1:0] count;\n  logic is_branch, is_jal, is_jalr;\n\n  // One synchronous read and one write per cycle. PC[10:2] can alias:\n  // the full word address qualifies instruction reuse, and EX checks a\n  // control transfer's destination before admitting the speculative successor.\n  typedef struct packed {\n    logic        valid;\n    logic [17:0] word_addr;\n    logic [31:0] instr;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t ram_response_q, held_respo\n…[5523 of 8595 chars elided by tools/bench/transcript.py; sha256:2e94699b87646e8f]…\n output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       replay,            // retry dependent fetch, squash ID/EX\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic dependent_q, bypass_q, canceled_q;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      dependent_q <= 1'b0;\n      canceled_q  <= 1'b0;\n    end else if (!stall_id) begin\n      dependent_q <= claims_ex && id_ex_mem_result;\n      canceled_q  <= claims_ex && !ex_writes_rd;\n      bypass_q    <= bypass_ready;\n    end\n  end\n  assign replay       = canceled_q || (dependent_q && !bypass_q);\n  assign stall_ex_mem = !dmem_ready && ex_mem_mem_op;\n  assign hold_mem_wb  = stall_ex_mem;\n  assign stall_id     = stall_ex_mem || div_wait;\n  assign stall_if     = stall_id || !imem_ready;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
