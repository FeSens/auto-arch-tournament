{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'redirect-fetch-lmlel6ao'\nh=p/'rtl/hazard_unit.sv'\ns=h.read_text()\nold='  input  logic       redirect,          // EX has resolved a branch/jump\\\\n'\nassert old in s\nh.write_text(s.replace(old,''))\nc=p/'rtl/core.sv'\ns=c.read_text()\nold='    .redirect       (redirect),\\\\n'\nassert s.count(old)==1\nc.write_text(s.replace(old,''))\nt=p/'test/test_pipeline.py'\ns=t.read_text().replace('max_cycles=200, dmem_ready=None):','max_cycles=200, dmem_ready=None, imem_ready=None):')\ns=s.replace('        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())','        dut.io_imemReady.value = int(imem_ready is None or imem_ready(ia))\\\\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())')\ns += \\\"\\\"\\\"\n@cocotb.test()\nasync def forwarded_jalr_ready_target(dut):\n    rets, _ = await _run(dut, [\n        ADDI(2, 0, 16), JALR(5, 2, 0), SW(0, 0, 40), NOP(),\n        ADDI(3, 5, 1), EBREAK(),\n    ])\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 16, 20]\n    assert [r[\\\"order\\\"] for r in rets] == [0, 1, 2, 3]\n    assert rets[1][\\\"pc_next\\\"] == 16 and rets[1][\\\"rd_wdata\\\"] == 8\n    assert rets[2][\\\"cycle\\\"] == rets[1][\\\"cycle\\\"] + 1 and rets[2][\\\"rd_wdata\\\"] == 9\n\n@cocotb.test()\nasync def branch_fetch_retries(dut):\n    accepted = []\n    waits = {}\n    def dready(ren, wen, addr, data):\n        if not wen: return True\n        if addr == 16 and waits.get(\\\"d\\\", 0) < 2:\n            waits[\\\"d\\\"] = waits.get(\\\"d\\\", 0) + 1\n            return False\n        accepted.append((addr, data, wen))\n        return True\n    def iready(addr):\n        if addr == 24 and waits.get(\\\"i\\\", 0) < 4:\n            waits[\\\"i\\\"] = waits.get(\\\"i\\\", 0) + 1\n            return False\n        return True\n    program = [ADDI(1,0,7), SW(1,0,16), BEQ(1,1,16), SW(0,0,20),\n               EBREAK(), EBREAK(), SW(1,0,24), EBREAK()]\n    rets, _ = await _run(dut, program, dmem_ready=dready, imem_ready=iready)\n    assert waits == {\\\"d\\\": 2, \\\"i\\\": 4}\n    assert accepted == [(16,7,15), (24,7,15)]\n    assert [r[\\\"pc\\\"] for r in rets] == [0,4,8,24,28]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n\\\"\\\"\\\"\nt.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
