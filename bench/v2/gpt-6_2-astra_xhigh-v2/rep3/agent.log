{"type": "item.completed", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/if_stage.sv && sed -n '83,165p' cores/bench/rtl/ex_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Each admitted PC reads a row containing its last successor PC and word.\n// The word can satisfy a stalled fetch. EX resolves all control transfers.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_value,\n  output logic              jalr_forecast,\n  output logic [31:0]       forecast_pc,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc, instr;\n  logic [1:0] counters [0:63];\n  logic [1:0] count;\n  logic is_branch, is_jal, request_taken;\n\n  // One synchronous read and one write per cycle. PC[10:2] can alias:\n  // the full word address qualifies instruction reuse, and EX checks a\n  // JALR target before admitting the speculative successor.\n  typedef struct packed {\n    logic        valid;\n    logic [17:0] word_addr;\n    logic [31:0] instr;\n    logic [12:0] disp_fields;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t response_q;\n  logic [8:0] predecessor_q, sweep_index_q, write_index;\n  logic sweep_q, predecessor_valid_q, lookup_valid_q, jalr_q;\n  logic admit, ram_pc, train_pair, fence_i, forecast_valid;\n  logic [12:0] bus_fields;\n  logic [19:11] offset_hi;\n  logic [4:1] offset_lo;\n\n…[7719 of 10791 chars elided by tools/bench/transcript.py; sha256:e9661b6708bbcf25]…\nnd\n\n  logic advancing, aligned_taken, jalr_miss;\n  // Decode holds its selects throughout a divide. Only a faulting link\n  // can cancel an otherwise enabled EX register write on an advancing edge.\n  assign writes_rd = in.ctrl.reg_write && !misalign_jump;\n  // A valid branch or jump is always a single-cycle EX operation.\n  assign advancing       = in.valid && !stall && !reset;\n  assign aligned_taken   = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n  assign jalr_miss       = jalr_target[1] ? jalr_forecast\n                                          : !jalr_forecast || forecast_pc != jalr_target;\n  assign redirect        = advancing && (in.ctrl.is_jalr ? jalr_miss\n                                                         : aligned_taken != in.predicted_taken);\n  assign redirect_target = !in.ctrl.is_jalr ? (in.predicted_taken ? in.pc + 32'd4 : branch_target)\n                         : jalr_target[1]   ? in.pc + 32'd4 : jalr_target;\n\n  assign train_en    = advancing && in.ctrl.is_branch && !misalign_fault;\n", "exit_code": 0, "status": "completed"}}
