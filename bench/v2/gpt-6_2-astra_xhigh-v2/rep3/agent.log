{"type": "item.completed", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c \"cat formal/wrapper_si.sv | head -150 && cat cores/bench/test/_helpers.py | head -130 && rg -n 'python|TARGET|JOBS|scratch|BASEDIR|RISCV_FORMAL' formal/run_all.sh\"", "aggregated_output": "// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[2553 of 5625 chars elided by tools/bench/transcript.py; sha256:9f83ba107d81d52b]…\n_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n32:RISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n42:mkdir -p \"$RISCV_FORMAL/cores\"\n48:    CORE_DIR=\"$RISCV_FORMAL/cores/$CORE_NAME-$FORMAL_WORK_ID\"\n56:        try=\"$(mktemp -u \"$RISCV_FORMAL/cores/$CORE_NAME-wXXXXXXXX\")\"\n60:        echo \"ERROR: could not create a work dir under $RISCV_FORMAL/cores\" >&2\n80:# env vars or $1 still win. Uses python3 to parse YAML robustly — bash\n86:    # Pass the path via env var so the python literal stays free of any\n88:    NRET=$(CORE_YAML=\"$CORE_YAML\" python3 -c '\n114:if [ ! -d \"$RISCV_FORMAL\" ]; then\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n192:python3 ../../checks/genchecks.py >> \"$LOG\" 2>&1\n195:JOBS=\"${JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)}\"\n196:echo \"=== make -j$JOBS -k ===\" | tee -a \"$LOG\"\n202:make -j\"$JOBS\" -k -f makefile 2>&1 \\\n", "exit_code": 0, "status": "completed"}}
