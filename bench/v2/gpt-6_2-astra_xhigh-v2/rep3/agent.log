{"type":"item.started","item":{"id":"item_103","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil,os\ntmp=Path(os.environ['TMPDIR'])\nd=tmp/'r6-checks'\nd.mkdir()\n(d/'rtl').symlink_to(tmp/'r6-rfwhole/rtl')\nshutil.copytree('cores/bench/test',d/'test')\ndef append(f,a):\n p=d/'test'/f\n with p.open('a') as w:w.write(a)\nappend('test_reg_file.py','''\n\n@cocotb.test()\nasync def reset_after_writes(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \\\"ns\\\").start())\n    await _reset(dut)\n    await _write(dut, 5, 0xABCDEF01)\n    await _write(dut, 21, 0x12345678)\n    assert await _read(dut, 21, 5) == (0x12345678, 0xABCDEF01)\n    await _reset(dut)\n    assert await _read(dut, 5, 21) == (0, 0)\n    await _write(dut, 21, 19)\n    assert await _read(dut, 5, 21) == (0, 19)\n''')\nappend('test_pipeline.py','''\n\n@cocotb.test()\nasync def decoded_operand_priority(dut):\n    program = [\n        ADDI(5, 0, 11), ADDI(5, 5, 3), ADD(6, 5, 5),\n        ADDI(7, 0, 9), LW(7, 0, 1), ADD(8, 7, 6),\n        ADDI(12, 0, 3), JALR(12, 0, 2), ADD(10, 12, 12),\n        ADDI(4, 0, 23), LW(9, 0, 64), ADD(11, 4, 8),\n        SW(11, 0, 68), EBREAK()\n    ]\n    load_waits = 0\n    writes = []\n    def ready(ren, wen, addr, data):\n        nonlocal load_waits\n        if ren and addr == 64:\n            load_waits += 1\n            return load_waits >= 4\n        if wen:\n            writes.append((addr, wen, data))\n        return True\n    rets, _ = await _run(dut, program, dmem_init={64: 1}, dmem_ready=ready)\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [(r[\\\"rs1_rdata\\\"],r[\\\"rs2_rdata\\\"],r[\\\"rd_wdata\\\"]) for r in\n            (rets[2], rets[5], rets[8], rets[11])] == [(14,14,28),(9,28,37),(3,3,6),(23,37,60)]\n    assert all(rets[i][\\\"trap\\\"] and rets[i][\\\"rd\\\"] == 0 for i in (4,7))\n    assert load_waits == 4 and writes == [(68,15,60)]\n''')\nPY\ncd \\\"\"'$TMPDIR/r6-checks\" && pytest -q test/test_reg_file.py test/test_pipeline.py > test-result.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
