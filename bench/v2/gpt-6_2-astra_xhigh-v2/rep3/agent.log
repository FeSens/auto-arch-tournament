{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Check EX integer results, registered EX products and seven-clock division.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.reset.value = 1\n    dut.mul_issue.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    assert dut.div_req_ready.value == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    dut.div_result_ready.value = 0\n    await _tick(dut)  # issue\n\n    dut.div_req_valid.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n    for _ in range(7):\n        assert dut.div_req_ready.value == 0\n        assert dut.div_result_valid.value == 0\n        await _tick(dut)\n\n    for cycle in range(hold_cycles + 1):\n        assert dut.div_req_ready.value == 0\n        assert dut.div_result_valid.value == 1\n        actual = int(dut.div_result.value)\n        assert actual == (expected & MASK32), (\n            f\"op={op} a={a:#x} b={b:#x} expected={expected & MASK32:#x} got={actual:#x}\"\n        )\n   \n…[8829 of 11901 chars elided by tools/bench/transcript.py; sha256:66a436e4d252c924]…\n if a == b else 0)\n            await _check_div(dut, ALU_REMU, a, b, r, hold_cycles=2 if a == b else 0)\n\n\n@cocotb.test()\nasync def reciprocal_boundaries(dut):\n    await _setup(dut)\n    divisors = {b for k in range(32) for b in (2**k - 1, 2**k, 2**k + 1)\n                if 0 < b <= MASK32}\n    # Exercise both endpoints of every normalized ROM bin. Eight low\n    # divisor bits vary within each bin and disappear from the ROM index.\n    for prefix in range(512, 1024):\n        divisors.update((prefix << 8, (prefix << 8) | 255))\n    for b in sorted(divisors):\n        multiple = (MASK32 // b) * b\n        for a in (multiple - 1, multiple, min(multiple + 1, MASK32)):\n            q, r = divmod(a, b)\n            await _check_div(dut, ALU_DIVU, a, b, q)\n            await _check_div(dut, ALU_REMU, a, b, r)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
