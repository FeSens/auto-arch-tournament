{"type": "item.completed", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c \"sed -n '200,290p' cores/bench/test/test_pipeline.py && sed -n '316,470p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def divide_behind_stalled_load(dut):\n    program = [\n        ADDI(1, 0, -101),\n        ADDI(2, 0, 7),       # forwards from WB while the load holds MEM\n        LW(4, 0, 64),\n        DIV(3, 1, 2),\n        SW(3, 0, 68),        # consumes the quotient from EX/MEM\n        EBREAK(),\n    ]\n    reads, writes, accepted_writes = [], [], []\n\n    def ready(ren, wen, addr, wdata):\n        if ren:\n            reads.append(addr)\n            return len(reads) > 3\n        if wen:\n            writes.append((addr, wen, wdata))\n            if len(writes) > 2:\n                accepted_writes.append(writes[-1])\n                return True\n        return False\n\n    rets, dmem = await _run(dut, program, dmem_init={64: 42}, dmem_ready=ready)\n    quotient = (-14) & 0xFFFFFFFF\n    assert reads == [64] * 4\n    assert writes == [(68, 0xF, quotient)] * 3\n    assert accepted_writes == [(68, 0xF, quotient)]\n    assert dmem[68] == quotient\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n    load, div, store = rets[2:5]\n    assert (load[\"rd\"], load[\"rd_wdata\"], load[\"mem_rmask\"]) == (4, 42, 0xF)\n    assert (div[\"rs1_addr\"], div[\"rs1_rdata\"]) == (1, (-101) & 0xFFFFFFFF)\n    assert (div[\"rs2_addr\"], div[\"rs2_rdata\"]) == (2, 7)\n    assert (div[\"rd\"], div[\"rd_wdata\"]) == (3, quotient)\n    assert (store[\"rs1_addr\"], store[\"rs1_rdata\"]) == (0, 0)\n    assert (store[\"rs2_addr\"], store[\"rs2_rdata\"]) == (3, quotient)\n    assert (store[\"mem_addr\"], store[\"mem_wmask\"], store[\"mem_wdata\"]) == (68, 0xF, quotient)\n    assert div[\"cycle\"] == load[\"cycle\"] + 9   # issue, seven passes, transfer\n    assert store[\"cycle\"] == div[\"cycle\"] + 3  # two store wait states\n\n\n@cocotb.test()\nasync def back_to_back_dependent_divides(dut):\n    program = [\n        ADDI(1, 0, 100), ADDI(2, 0, 7),\n        DIV(3, 1, 2), REMU(4, 1, 3), ADD(5, 3, 4), EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r\n…[6253 of 9325 chars elided by tools/bench/transcript.py; sha256:356bc4a2c7cb76c4]…\n\n        0: JAL(0, 0x60),\n        0x60: BEQ(0, 0, 256), 0x160: JAL(0, 0x7ff00),\n        0x80060: JAL(0, 0x7ff00), 0xfff60: BNE(0, 0, 0xa0),\n        0xfff64: JAL(0, -0xfff00), 0x64: BNE(0, 0, -128), 0x68: EBREAK(),\n    }\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_trace=fetches)\n    pcs = [0, 0x60, 0x160, 0x80060, 0xfff60, 0xfff64, 0x64, 0x68]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert fetches[:len(pcs) + 1] == [0, 0x60, 0x64, *pcs[2:]]\n    assert all(pc < 0x100000 and pc % 4 == 0 for pc in fetches)\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
