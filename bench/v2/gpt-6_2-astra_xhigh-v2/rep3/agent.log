{"type": "item.completed", "item": {"id": "item_125", "type": "command_execution", "command": "/bin/bash -c \"sed -n '747,831p' cores/bench/test/test_pipeline.py && tail -10 cores/bench/test/test_pipeline.py && date -u\"", "aggregated_output": "        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def predicted_loop_and_jumps(dut):\n    program = [\n        ADDI(2, 0, 3), ADDI(1, 1, 1),\n        BEQ(0, 0, 12), SW(1, 0, 68), NOP(),\n        JAL(5, 8), SW(1, 0, 72), SW(1, 0, 64),\n        BLT(1, 2, -28),                  # back to the increment\n        ADDI(6, 5, 25), JALR(7, 6, 0),   # forwarded 49, target 48\n        SW(1, 0, 76), ADDI(8, 7, 1), EBREAK(),\n    ]\n    fetches, stores = [], []\n    waits = 0\n\n    def data_ready(ren, wen, addr, wdata):\n        nonlocal waits\n        if wen:\n            assert (addr, wen) == (64, 15)\n            if wdata == 2 and waits < 3:\n                waits += 1\n                return False\n            stores.append(wdata)\n        return True\n\n    def fetch_ready(pc):\n        # The trained JAL and its target must both come from successor rows.\n        return pc not in (20, 28) or fetches.count(pc) == 1\n\n    rets, dmem = await _run(dut, program, sweep_cycles=513, fetch_trace=fetches,\n                            imem_ready=fetch_ready, dmem_ready=data_ready)\n    expected = [0] + [4, 8, 20, 28, 32] * 3 + [36, 40, 48, 52]\n    assert [r[\"order\"] for r in rets] == list(range(len(expected)))\n    assert [r[\"pc\"] for r in rets] == expected\n    assert [r[\"pc_next\"] for r in rets[:-1]] == expected[1:]\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in expected]\n    # Cold transfers select PC+4. The second lap hits on all three transfers,\n    # including the backedge held behind the stalled store. The last lap exits.\n    requests = ([0, 4, 8, 12, 20, 24, 28, 32, 36] +\n                [4, 8, 20, 28, 32] + [4] * 4 + [8, 20, 28, 32, 4, 36, 40, 44, 48, 52])\n    assert fetches[:len(requests)] == requests\n    assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"] == 5] == [24] * 3\n    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"rd\"] in (7, 8)] == [(7, 44), (8, 45)]\n    assert waits == 3 and stores == [1, 2, 3] and dmem == {64: 3}\n\n\n@cocotb.test()\nasync def aliasing_branch_updates(dut):\n    # Populate the four branch rows, then set their shared agree counter to 1.\n    # On the last lap EX at 320 increments 2 to 3 as 576 is fetched. The\n    # latter must decrement the bypassed count to 2 for 832 to steer to 844.\n    program = {\n        0: ADDI(1, 0, 1), 4: JAL(0, 60),\n        64: BEQ(0, 0, 256), 68: SW(0, 0, 64),\n        320: BEQ(0, 0, 256), 324: SW(0, 0, 68),\n        576: BNE(1, 0, 12), 580: JAL(0, 252), 588: JAL(0, 244),\n        832: BEQ(0, 0, 12), 836: SW(0, 0, 76),\n        844: BEQ(1, 0, 12), 848: JAL(0, 240), 856: EBREAK(),\n        1088: BNE(0, 0, 8), 1092: JAL(0, 252),\n        1344: BNE(0, 0, 8), 1348: JAL(0, 252),\n        1600: BNE(0, 0, 8), 1604: JAL(0, 252),\n        1856: BEQ(0, 0, 8), 1864: ADDI(1, 0, 0), 1868: JAL(0, 64 - 1868),\n    }\n    fetches = []\n    rets, dmem = await _run(dut, program, sweep_cycles=513, fetch_trace=fetches)\n    last = fetches.index(64, fetches.index(1868))\n    assert fetches[last:last + 9] == [64, 68, 320, 576, 588, 580, 584, 832, 844]\n    assert [r[\"pc\"] for r in rets] == [\n        0, 4, 64, 320, 576, 588, 832, 844, 848, 1088, 1092, 1344, 1348, 1600, 1604,\n        1856, 1864, 1868, 64, 320, 576, 580, 832, 844, 856,\n    ]\n    assert not dmem and all(r[\"mem_wmask\"] == 0 for r in rets)\n\n\n@cocotb.test()\nasync def held_branch_recovers_during_imem_wait(dut):\n    program = {\n        0: JAL(0, 80), 80: ADDI(1, 0, 1), 84: LW(5, 0, 64),\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\nSat Nov 21 05:05:49 UTC 2026\n", "exit_code": 0, "status": "completed"}}
