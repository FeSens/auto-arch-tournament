{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/h14_explore.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,os,tempfile,shutil\nbase=Path('cores/bench/rtl')\nroot=Path(tempfile.gettempdir())\nname=sys.argv[1]\ndest=root/('h14_'+name)\ndest.mkdir(exist_ok=True)\nrtl=dest/'rtl'\nrtl.mkdir(exist_ok=True)\nfor f in base.glob('*.sv'):shutil.copy(f,rtl/f.name)\ndef edit(f,a,b):\n p=rtl/f\n s=p.read_text()\n assert a in s,a\n p.write_text(s.replace(a,b,1))\nedit('core_pkg.sv','logic [31:0] rs1_val;', '''logic [10:0] iop;\n    logic [31:0] prepared_b;\n    logic [31:0] rs1_val;''')\nedit('id_stage.sv','reg_q.pc       <= in.pc;', '''reg_q.pc       <= in.pc;\n      reg_q.prepared_b <= in.instr[5] ? rs2_data : imm;\n      for (int i=0; i<11; i=i+1)\n        reg_q.iop[i] <= (in.instr[6:0] == 7'h33 || in.instr[6:0] == 7'h13) &&\n                         dec_alu_op == 5'(i);''')\nedit('core.sv','logic [2:0] fwd_rs1_sel_q, fwd_rs2_sel_q;', '''logic [2:0] fwd_rs1_sel_q, fwd_rs2_sel_q, fwd_rhs_q;''')\nedit('core.sv','.fwd_rs2_sel     (fwd_rs2_sel_q),','.fwd_rs2_sel     (fwd_rs2_sel_q),\\\\n    .fwd_rhs(fwd_rhs_q),')\nedit('core.sv','fwd_rs1_sel_q <=', '''fwd_rhs_q <= {3{if_id_w.instr[5]}} &\n                   {id_fwd_rs2[1], id_fwd_rs2[0] && mul_in_ex, id_fwd_rs2[0] && \"'!mul_in_ex};\n      fwd_rs1_sel_q <='\"''')\nedit('ex_stage.sv','input  logic [2:0]         fwd_rs2_sel,', '''input logic [2:0] fwd_rhs,\n  input  logic [2:0]         fwd_rs2_sel,''')\nedit('ex_stage.sv','alu_a = in.ctrl.is_auipc ? in.pc  : rs1;','alu_a = rs1;')\nedit('ex_stage.sv','alu_b = in.ctrl.alu_src  ? in.imm : rs2;','alu_b = rs2;')\nhard='''logic [31:0] rhs, arith_add, arith_sub, shift, boolres;\n  logic [4:0] sa;\n  logic [31:0] slin, shrval;\n  logic less;\n  assign rhs = in.prepared_b | ({32{fwd_rhs[0]}} & fwd_ex_mem)\n                              | ({32{fwd_rhs[1]}} & mem_product)\n                              | ({32{fwd_rhs[2]}} & fwd_mem_wb);\n  assign sa = rhs[4:0];\n  assign arith_add = rs1 + rhs;\n  assign arith_sub = rs1 - rhs;\n  assign less = rs1[31] == rhs[31] ? rs1[30:0] < rhs[30:0] :\n                (rs1[31] \"'^ in.iop[ALU_SLTU]);\n  assign boolres = ({32{in.iop[ALU_XOR]}} & (rs1 ''^ rhs)) |\n                   ({32{in.iop[ALU_AND]}} & (rs1 & rhs)) |\n                   ({32{in.iop[ALU_OR]}} & (rs1 | rhs));\n  assign shift = ({32{in.iop[ALU_SLL]}} & (rs1 << sa)) |\n                 ({32{in.iop[ALU_SRL]}} & (rs1 >> sa)) |\n                 ({32{in.iop[ALU_SRA]}} & $unsigned($signed(rs1) >>> sa));\n'\"'''\nif name=='ex_fold':\n hard=hard[:hard.index('  assign shift')] + '''  for (genvar i=0;i<32;i++) begin\n    assign slin[i] = in.iop[ALU_SLL] ? rs1[31-i] : rs1[i];\n    assign shift[i] = in.iop[ALU_SLL] && shrval[31-i] ||\n                      (in.iop[ALU_SRL] || in.iop[ALU_SRA]) && shrval[i];\n  end\n  assign shrval = \"'$unsigned($signed({in.iop[ALU_SRA] && rs1[31],slin}) >>> sa);\n'\"'''\nedit('ex_stage.sv','  ex_mem_t reg_q;',hard+'  ex_mem_t reg_q;')\nedit('ex_stage.sv','({32{\"'!(in.ctrl.is_jump || in.ctrl.mem_read)}} & alu_result);'\"','''({32{in.ctrl.is_lui}} & in.imm) |\n                             ({32{in.ctrl.is_auipc}} & branch_target) |\n                             ({32{in.iop[ALU_ADD]}} & arith_add) |\n                             ({32{in.iop[ALU_SUB]}} & arith_sub) |\n                             {31'b0, (in.iop[ALU_SLT] || in.iop[ALU_SLTU]) && less} |\n                             boolres | shift;''')\nPY\ncat > \\\"\"'$TMPDIR/h14_route.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,tempfile\nfrom tools.eval.gowin import build,critical_paths\nbase=Path(tempfile.gettempdir())/('h14_'+sys.argv[1])\np=int(sys.argv[2]) if len(sys.argv)>2 else 1\nout=base/('route'+str(p))\nr=build('.',base/'rtl','fpga/core_bench_si.sv',p,out)\nprint({k:v for k,v in r.items() if k\"'!='\"'critical_paths'})\nif not r['placement_failed']:\n for cp in critical_paths((out/'impl/pnr/core_bench.tr').read_text(),12):\n  print(cp['arrival_ns'],cp['from'],cp['to'])\nPY\npython \\\"\"'$TMPDIR/h14_explore.py\" ex_direct\nPYTHONPATH=. PYTHONDONTWRITEBYTECODE=1 python \"$TMPDIR/h14_route.py\" ex_direct 1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
