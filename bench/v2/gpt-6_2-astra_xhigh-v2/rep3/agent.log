{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"sed -n '97,139p' test/cosim/reference.py\"","aggregated_output":"    def trunc_div(a, b):\n        \"\"\"RISC-V signed division: truncate toward zero (C semantics), not Python floor.\"\"\"\n        q = abs(a) // abs(b)\n        return -q if (a < 0) ^ (b < 0) else q\n\n    @staticmethod\n    def trunc_rem(a, b):\n        \"\"\"RISC-V signed remainder: sign of result = sign of dividend (trunc-toward-zero).\"\"\"\n        r = abs(a) % abs(b)\n        return -r if a < 0 else r\n\n    def _retire(self, *, pc, npc, instr, trap=0,\n                wrd=0, wval=0, rs1=0, rs2=0,\n                rs1_rdata_pre=0, rs2_rdata_pre=0,\n                mem_addr=0, mem_rmask=0, mem_rdata=0,\n                mem_wmask=0, mem_wdata=0):\n        \"\"\"Centralized retirement record. On trap=1 we zero out the\n        write-side fields and force npc = pc + 4 so the trace stays in\n        lockstep with the DUT (which suppresses redirects + reg/mem\n        commits on misalign / illegal).\"\"\"\n        if trap:\n            wrd = wval = 0\n            mem_addr = mem_rmask = mem_wmask = 0\n            mem_rdata = mem_wdata = 0\n            npc = (pc + 4) & MASK\n        if wrd:\n            self.regs[wrd] = wval\n        self.regs[0] = 0\n        self.pc = npc\n        out = {\n            'order': self.retired, 'pc': pc, 'npc': npc, 'insn': instr,\n            'rd': wrd, 'rd_wdata': wval if wrd else 0,\n            'rs1': rs1, 'rs1_rdata': rs1_rdata_pre,\n            'rs2': rs2, 'rs2_rdata': rs2_rdata_pre,\n            'mem_addr': mem_addr, 'mem_rmask': mem_rmask, 'mem_rdata': mem_rdata,\n            'mem_wmask': mem_wmask, 'mem_wdata': mem_wdata,\n            'trap': trap, 'halt': 0, 'intr': 0, 'mode': 3, 'ixl': 1,\n        }\n        self.retired += 1\n        return out\n\n    def step(self) -> Optional[dict]:\n        instr = self.rw(self.pc)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python3 -B - '/srv/hwebench/tmp/ec844b20/8e9409b1/bench-predictor.m7zf3A87' <<'PY'\nfrom pathlib import Path\nimport json,sys\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nfrom collections import Counter\nd=Path(sys.argv[1])\ncpu=RV32IM()\ncpu.load_elf(str(d/'coremark.elf'))\ncounts=Counter()\ncounters=[1]*256\nactive=False\nwhile cpu.retired < 8_000_000:\n    a=cpu.step()\n    if a['mem_wmask'] and a['mem_addr']==0x10000104:\n        break\n    if a['mem_wmask'] and a['mem_addr']==0x10000100:\n        active=True\n    pc=a['pc']\n    insn=a['insn']\n    op=insn&127\n    taken=(pc+4)\"'!=a['\"'npc']\n    if op==0x63:\n        idx=(pc>>2)&255\n        count=counters[idx]\n        if active:\n            counts['cond']+=1\n            counts['taken']+=taken\n            counts['conditional_misses']+=(count>=2)\"'!=taken\n        counters[idx]=min(3,count+1) if taken else max(0,count-1)\n    if active:\n        counts['\"'instructions']+=1\n        counts['jal']+=op==0x6f\n        counts['jalr']+=op==0x67\n    if insn==0x00100073:break\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
