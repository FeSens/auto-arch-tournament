{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"sed -n '73,179p;266,411p;620,651p;840,882p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready=None,\n               *, imem_ready=None, fetch_trace=None, after_sweep=False):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    The optional dmem_ready(ren, wen, addr, wdata) callback sets readiness\n    for the upcoming edge. Accepted stores update the Python-side dmem.\n    imem_ready(pc) controls instruction delivery. fetch_trace records each\n    presented address, including speculative requests and wait states.\n    after_sweep holds the first request until the predictor sweep finishes.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = program if isinstance(program, dict) else {\n        i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)\n    }\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    def drive_fetch(pc):\n        if fetch_trace is not None:\n            fetch_trace.append(pc)\n        ready = imem_ready(pc) if imem_ready else True\n        dut.io_imemReady.value = int(ready)\n        dut.io_imemData.value = imem.get(pc, EBREAK()) if ready else SW(0, 0, 0xbc)\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Start both buses in zero-wait mode.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    if after_sweep:\n        dut.io_imemReady.value = 0\n        await ClockCycles(dut.clock, 513)\n    drive_fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n…[8786 of 11858 chars elided by tools/bench/transcript.py; sha256:c576971c19b149f9]…\npc == 4) or pc == 28\n\n    rets, data = await _run(dut, program, {0x100: 17}, after_sweep=True,\n                            imem_ready=fetch_ready)\n    assert [r[\"pc\"] for r in rets] == [0] + [4, 8, 12, 16, 24] * 3 + [28]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 8] == [1, 1, 1]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 12] == [1, 3, 5]\n    assert data == {0x100: 17}\n\n\n@cocotb.test()\nasync def successor_full_address_match(dut):\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
