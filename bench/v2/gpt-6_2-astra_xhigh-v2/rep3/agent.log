{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"rg -n -i 'load|hazard|successor|stall' cores/bench/test/test_pipeline.py; sed -n '305,340p;420,500p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "4:fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n6:SW+LW roundtrip, load-use stall, and the trap discipline (illegal /\n209:async def divide_behind_stalled_load(dut):\n212:        ADDI(2, 0, 7),       # forwards from WB while the load holds MEM\n241:    load, div, store = rets[2:5]\n242:    assert (load[\"rd\"], load[\"rd_wdata\"], load[\"mem_rmask\"]) == (4, 42, 0xF)\n249:    assert div[\"cycle\"] == load[\"cycle\"] + 9   # issue, seven passes, transfer\n268:async def load_use_stalls(dut):\n269:    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n278:        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n481:async def successor_word_across_load_use_and_divide(dut):\n508:async def successor_full_address_match(dut):\n538:async def successor_same_row_read_write(dut):\n553:async def fence_i_invalidates_successor_word(dut):\n710:            \"hazard_unit.sv\", \"forward_unit.sv\",\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut\n…[2370 of 5442 chars elided by tools/bench/transcript.py; sha256:0142e1aa51e2a2ec]…\ncle\"] == rets[hit][\"cycle\"] + 1\n    starts = [i + 1 for i, pc in enumerate(fetches) if pc == 16]\n    assert [fetches[i] for i in starts] == [20, 64, 64, far_target]\n    assert fetches[starts[1]:starts[1] + 5] == [64] * 4 + [68]\n    assert fetches[starts[2]:starts[2] + 5] == [64] * 4 + [far_target]\n\n\n@cocotb.test()\nasync def successor_word_across_load_use_and_divide(dut):\n    program = {\n        0: ADDI(5, 0, 5), 4: LW(1, 0, 0x100), 8: DIV(2, 1, 1),\n        12: ADDI(3, 3, 1), 16: JAL(0, 8), 20: SW(1, 0, 0x104),\n        24: BLT(3, 5, -20), 28: EBREAK(),\n    }\n    lap = 0\n\n    def fetch_ready(pc):\n        nonlocal lap\n        if pc == 4:\n            lap += 1\n        if lap == 2 and pc == 12:\n            # A ready word overrides the older saved word and retrains it.\n            program[12] = ADDI(3, 3, 2)\n            return True\n        return lap < 2 or (lap == 2 and pc == 4) or pc == 28\n\n    rets, data = await _run(dut, program, {0x100: 17}, after_sweep=True,\n                            imem_ready=fetch_ready)\n", "exit_code": 0, "status": "completed"}}
