{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom itertools import product\nfrom random import Random\n\nmask = (1 << 32) - 1\ndef signed(x):\n    return x - (1 << 32) if x >> 31 else x\n\ndef divide(a, b):\n    r = 0\n    q = 0\n    multiples = (b, b << 1, 3 * b)\n    for i in range(1, 17):\n        w = 2 * i\n        low_mask = (1 << w) - 1\n        t = 4 * r + ((a >> (32 - w)) & 3)\n        assert t.bit_length() <= w\n        digit, r = 0, t\n        for k, m in enumerate(multiples, 1):\n            extended_diff = (t - (m & low_mask)) & ((1 << (w + 1)) - 1)\n            if (m >> w) == 0 and (extended_diff >> w) == 0:\n                digit, r = k, extended_diff\n        q = 4 * q + digit\n    return q, r\n\nvals = [0, 1, 2, 3, 4, 7, 8, 0xffff, 0x40000000, 0x7fffffff, 0x80000000, 0xfffffffe, 0xffffffff]\nrng = Random(20261120)\npairs = list(product(vals, repeat=2)) + [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(4096)]\nfor a,b in pairs:\n    for signed_op in (False, True):\n        x,y = (signed(a), signed(b)) if signed_op else (a,b)\n        q,r = divide(abs(x), abs(y))\n        if y == 0:\n            q, r = mask, a\n            ref = (mask,a)\n        else:\n            if (x < 0) \"'!= (y < 0):\n                q = -q\n            if x < 0:\n                r = -r\n            k = abs(x) // abs(y) * (-1 if (x < 0) != (y < 0) else 1)\n            ref = (k & mask, (x - k*y) & mask)\n        assert (q & mask, r & mask) == ref\nprint(f'\"'Radix-4 arithmetic model agreed with RV32 quotient and remainder for {len(pairs)} operand pairs, each signed and unsigned.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom itertools import product\nfrom random import Random\n\nmask = (1 << 32) - 1\ndef signed(x):\n    return x - (1 << 32) if x >> 31 else x\n\ndef divide(a, b):\n    r = 0\n    q = 0\n    multiples = (b, b << 1, 3 * b)\n    for i in range(1, 17):\n        w = 2 * i\n        low_mask = (1 << w) - 1\n        t = 4 * r + ((a >> (32 - w)) & 3)\n        assert t.bit_length() <= w\n        digit, r = 0, t\n        for k, m in enumerate(multiples, 1):\n            extended_diff = (t - (m & low_mask)) & ((1 << (w + 1)) - 1)\n            if (m >> w) == 0 and (extended_diff >> w) == 0:\n                digit, r = k, extended_diff\n        q = 4 * q + digit\n    return q, r\n\nvals = [0, 1, 2, 3, 4, 7, 8, 0xffff, 0x40000000, 0x7fffffff, 0x80000000, 0xfffffffe, 0xffffffff]\nrng = Random(20261120)\npairs = list(product(vals, repeat=2)) + [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(4096)]\nfor a,b in pairs:\n    for signed_op in (False, True):\n        x,y = (signed(a), signed(b)) if signed_op else (a,b)\n        q,r = divide(abs(x), abs(y))\n        if y == 0:\n            q, r = mask, a\n            ref = (mask,a)\n        else:\n            if (x < 0) \"'!= (y < 0):\n                q = -q\n            if x < 0:\n                r = -r\n            k = abs(x) // abs(y) * (-1 if (x < 0) != (y < 0) else 1)\n            ref = (k & mask, (x - k*y) & mask)\n        assert (q & mask, r & mask) == ref\nprint(f'\"'Radix-4 arithmetic model agreed with RV32 quotient and remainder for {len(pairs)} operand pairs, each signed and unsigned.')\nPY\"","aggregated_output":"Radix-4 arithmetic model agreed with RV32 quotient and remainder for 4265 operand pairs, each signed and unsigned.\n","exit_code":0,"status":"completed"}}
