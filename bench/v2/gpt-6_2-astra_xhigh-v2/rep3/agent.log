{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/core.yaml cores/bench/CORE_PHILOSOPHY.md; cat cores/bench/test/_helpers.py cores/bench/test/conftest.py; rg -n 'RAM|MEM_SIZE|imem|1 << 20' fpga/core_bench_si.sv test/cosim/main.cpp\"", "aggregated_output": "name: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 46.846\n  lut4: 2643\n  ff: 566\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261120-001-r2s0\n  updated: '2026-11-20T20:28:21.768586Z'\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    run\n…[1306 of 4378 chars elided by tools/bench/transcript.py; sha256:e49a803e031c152c]…\nonding flag is on. Drives 1\ntest/cosim/main.cpp:119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\ntest/cosim/main.cpp:124:        //   - imem: PC should always be in range; flag every fetch outside.\ntest/cosim/main.cpp:125:        //   - dmem read: ANY read outside [0, MEM_SIZE) is OOB — including\ntest/cosim/main.cpp:135:        if (!in_mem_range(top->io_imemAddr)) oob_access = true;\ntest/cosim/main.cpp:136:        top->io_imemData  = rw(imem, top->io_imemAddr);\nfpga/core_bench_si.sv:8:// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\nfpga/core_bench_si.sv:37:  logic [31:0] imem_addr;\nfpga/core_bench_si.sv:53:  logic imem_ready, dmem_ready;\nfpga/core_bench_si.sv:57:    .imem_ready (imem_ready),\nfpga/core_bench_si.sv:64:    .io_imemAddr      (imem_addr),\nfpga/core_bench_si.sv:65:    .io_imemData      (lfsr),\nfpga/core_bench_si.sv:66:    .io_imemReady     (imem_ready),\nfpga/core_bench_si.sv:100:  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n", "exit_code": 0, "status": "completed"}}
