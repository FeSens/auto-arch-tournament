{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"cat >> test/test_alu.py <<'PY'\n\n@cocotb.test()\nasync def mixed_multiply_stream(dut):\n    await _setup(dut)\n    rng = random.Random(456)\n    for i in range(512):\n        a = rng.getrandbits(32)\n        b = rng.getrandbits(32)\n        sa = a if a < 2**31 else a-2**32\n        sb = b if b < 2**31 else b-2**32\n        op, value = [(ALU_MUL, a*b), (ALU_MULH, (sa*sb)>>32), (ALU_MULHSU, (sa*b)>>32), (ALU_MULHU, (a*b)>>32)][i % 4]\n        await _check(dut, op, a, b, value)\n\n@cocotb.test()\nasync def divisor_bin_edges(dut):\n    await _setup(dut)\n    for idx in range(512):\n        for edge in (0, (1 << 22) - 1):\n            d = 2**31 + (idx << 22) + edge\n            b = d >> ((idx*3) % 32)\n            multiple = (MASK32 // b) * b\n            for a in sorted(set([multiple-1, multiple, min(multiple+1, MASK32), MASK32])):\n                q,r = divmod(a,b)\n                await _check_div(dut, ALU_DIVU, a, b, q)\n                await _check_div(dut, ALU_REMU, a, b, r)\nPY\npytest -q --rootdir=. test/test_alu.py > alu.log 2>&1\ntest_status=\"'$?\ntail -25 alu.log\nexit \"$test_status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
