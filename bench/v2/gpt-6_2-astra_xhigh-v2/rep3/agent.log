{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/warm-check.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nroot=Path(os.environ[\\\"TMPDIR\\\"])/sys.argv[1]\nshutil.copytree('cores/bench/test',root/'test',dirs_exist_ok=True)\ntest=root/'test'/'test_pipeline.py'\ns=test.read_text().replace('await ClockCycles(dut.clock, 513)', 'await ClockCycles(dut.clock, 513 if after_sweep is True else after_sweep)')\ns+='''\n@cocotb.test()\nasync def early_load_on_cold_then_hot_loop(dut):\n    base = 0x104\n    program = [ADDI(1,0,0x100), ADDI(2,0,0), ADDI(3,0,3), LW(4,1,4),\n               ADD(5,4,4), ADDI(2,2,1), BNE(2,3,-12), EBREAK()]\n    reads=[]\n    def dready(ren,wen,addr,wdata):\n        assert not wen\n        if ren:\n            reads.append(addr)\n        return bool(ren)\n    rets,_ = await _run(dut,program,{base:0xc000d00d},after_sweep=1026,dmem_ready=dready)\n    assert reads == [base], (reads, rets)\n    loads=[r for r in rets if r['pc']==12]\n    deps=[r for r in rets if r['pc']==16]\n    assert len(loads)==len(deps)==3\n    assert [d['cycle']-l['cycle'] for l,d in zip(loads,deps)] == [2,1,1]\n    assert all((l['mem_addr'], l['mem_rmask'], l['mem_rdata'], l['rd_wdata']) ==\n               (base,15,0xc000d00d,0xc000d00d) for l in loads)\n    assert all(d['rd_wdata']==0x8001a01a for d in deps)\n\n@cocotb.test()\nasync def same_address_held_partial_store_before_hot_load(dut):\n    program = [ADDI(1,0,0x100), ADDI(3,0,0x7f), ADDI(8,0,2),\n               JAL(0,8), _s(1,3,1,0,0x23), LW(4,1,0), ADD(5,4,4),\n               ADDI(7,7,1), BLT(7,8,-16), EBREAK()]\n    reads=[]\n    store_attempts=[]\n    def dready(ren,wen,addr,wdata):\n        if wen:\n            store_attempts.append((addr,wen,wdata))\n            return len(store_attempts)>=4\n        if ren:\n            reads.append(addr)\n        return True\n    rets,_=await _run(dut,program,{0x100:0x99882211},after_sweep=1026,dmem_ready=dready)\n    assert reads==[0x100,0x100]\n    assert len(store_attempts)==4\n    loads=[r for r in rets if r['pc']==20]\n    assert [r['rd_wdata'] for r in loads]==[0x99882211,0x99887f11]\n    assert [r['mem_rdata'] for r in loads]==[0x99882211,0x99887f11]\n    assert [r['order'] for r in rets]==list(range(len(rets)))\n\n@cocotb.test()\nasync def high_tag_alias_before_predicted_load(dut):\n    program = [ADDI(1,0,0x100), 0x00001137, ADDI(7,0,2), JAL(0,8),\n               ADD(1,2,1), LW(4,1,0), ADD(5,4,4), ADDI(6,6,1),\n               BLT(6,7,-16), EBREAK()]\n    reads=[]\n    def dready(ren,wen,addr,wdata):\n        if ren:\n            reads.append(addr)\n        return True\n    data={0x100:0x10000001,0x1100:0x12345678}\n    rets,_=await _run(dut,program,data,after_sweep=1026,dmem_ready=dready)\n    assert reads==[0x100,0x1100], reads\n    assert [r['rd_wdata'] for r in rets if r['pc']==20]==list(data.values())\n'''\ntest.write_text(s)\nPY\npython3 \\\"\"'$TMPDIR/warm-check.py\" pair && cd \"$TMPDIR/pair\" && python3 -m pytest -q test/test_pipeline.py > pipeline.log 2>&1 && tail -4 pipeline.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
