{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv cores/bench/test/test_alu.py'", "aggregated_output": "// The EX multiplier takes forwarded register values directly and latches\n// its architectural word on issue. The divider has its own refinement DSP.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        mul_issue,\n  input  logic [31:0] mul_rs1,\n  input  logic [31:0] mul_rs2,\n  output logic [31:0] mem_product,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_result_valid,\n  input  logic        div_result_ready,\n  output logic [31:0] div_result\n);\n\n  always_comb begin\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << b[4:0];\n      ALU_SRL:    out = a >> b[4:0];\n      ALU_SRA:    out = $unsigned($signed(a) >>> b[4:0]);\n      ALU_LUI:    out = b;\n      default:    out = '0;\n    endcase\n  end\n\n  logic [31:0] product_word;\n`ifdef RISCV_FORMAL_ALTOPS\n  always_comb begin\n    case (op)\n      ALU_MUL:    product_word = (mul_rs1 + mul_rs2) ^ 32'h5876063e;\n      ALU_MULH:   product_word = (mul_rs1 + mul_rs2) ^ 32'hf6583fb7;\n      ALU_MULHU:  product_word = (mul_rs1 + mul_rs2) ^ 32'h949ce5e8;\n      ALU_MULHSU: product_word = (mul_rs1 - mul_rs2) ^ 32'hecfbe137;\n      default:    product_word = '0;\n    endcase\n  end\n`else\n  logic signed [32:0] mul_a, mul_b;\n  logic [63:0] full_product;\n  assign mul_a = {mul_rs1[31] && (op == ALU_MULH || op == ALU_MULHSU), mul_rs1};\n  assign mul_b = {mul_rs2[31] && op == ALU_MULH, mul_rs2};\n  assign full_product = mul_a * mul_b;\n  assign product_word = op == ALU_MUL ? full_product[31:0] : full_product[63:32];\n`endif\n  always_ff @(posedge clock) begin\n    if (mul_issue)\n      mem_product <= product_word;\n  end\n\n…[15338 of 18410 chars elided by tools/bench/transcript.py; sha256:a9c4203d21960b16]…\n if a == b else 0)\n            await _check_div(dut, ALU_REMU, a, b, r, hold_cycles=2 if a == b else 0)\n\n\n@cocotb.test()\nasync def reciprocal_boundaries(dut):\n    await _setup(dut)\n    divisors = {b for k in range(32) for b in (2**k - 1, 2**k, 2**k + 1)\n                if 0 < b <= MASK32}\n    # Exercise both endpoints of every normalized ROM bin. Eight low\n    # divisor bits vary within each bin and disappear from the ROM index.\n    for prefix in range(512, 1024):\n        divisors.update((prefix << 8, (prefix << 8) | 255))\n    for b in sorted(divisors):\n        multiple = (MASK32 // b) * b\n        for a in (multiple - 1, multiple, min(multiple + 1, MASK32)):\n            q, r = divmod(a, b)\n            await _check_div(dut, ALU_DIVU, a, b, q)\n            await _check_div(dut, ALU_REMU, a, b, r)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
