0\n    assert rets == list(enumerate([0,4,8,16,20,24]))\n    assert (load_waits, target_waits, loads) == (3, 7, 1)\n    assert writes == [(80, 15, 20)]\nPY\npython -m pytest -q --rootdir=. --confcutdir=. test/test_pipeline.py --basetemp=pytest2 -o cache_dir=pytest-cache > directed.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
