{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nrng = random.Random(7)\nmask32, mask35 = 2**32-1, 2**35-1\nedges = [0, 1, 2, 3, 2**31-1, 2**31, mask32]\npairs = [(a,b) for a in edges for b in edges]\npairs.extend((1<<i,1) for i in range(32))\npairs.extend((rng.getrandbits(32),rng.getrandbits(rng.randrange(1,33))) for _ in range(4096))\nfor a,b in pairs:\n    q,r = a,0\n    for _ in range(7):\n        for _ in range(5):\n            r = ((r << 1) | (q >> 34)) & mask32\n            take = r >= b\n            if take:\n                r -= b\n            q = ((q << 1) | take) & mask35\n    assert (q & mask32, r) == (divmod(a,b) if b else (mask32,a))\nprint(f'Padded recurrence matched quotient and remainder on {len(pairs)} input pairs.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
