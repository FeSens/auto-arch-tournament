{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// Integer results are available in EX. A multiply registers its operands\n// on issue and delivers its selected word in MEM. A blocking divide takes\n// over the same multiplier for seven clocks after its issue edge.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        mul_issue,\n  output logic [31:0] mem_product,\n  input  logic        div_req_valid,\n  output logic        div_req_ready,\n  output logic        div_result_valid,\n  input  logic        div_result_ready,\n  output logic [31:0] div_result\n);\n\n  always_comb begin\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << b[4:0];\n      ALU_SRL:    out = a >> b[4:0];\n      ALU_SRA:    out = $unsigned($signed(a) >>> b[4:0]);\n      ALU_LUI:    out = b;\n      default:    out = '0;\n    endcase\n  end\n\n  logic       busy_q;\n  logic [2:0] pass_q;\n  logic       div_issue;\n  assign div_req_ready = !busy_q && !div_result_valid;\n  assign div_issue = div_req_valid && div_req_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      busy_q           <= 1'b0;\n      pass_q           <= '0;\n      div_result_valid <= 1'b0;\n    end else if (div_issue) begin\n      busy_q <= 1'b1;\n      pass_q <= '0;\n    end else if (busy_q) begin\n      pass_q <= pass_q + 3'd1;\n      if (pass_q == 3'd6) begin\n        busy_q           <= 1'b0;\n        div_result_valid <= 1'b1;\n      end\n    end else if (div_result_ready) begin\n      div_result_valid <= 1'b0;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_a_q, alt_b_q;\n  logic [4:0]  alt_op_q;\n  always_ff @(posedge clock) begin\n    if (div_req_ready && (mul_issue || div_req_valid)) begin\n      \n…[3876 of 6948 chars elided by tools/bench/transcript.py; sha256:209bd54692152529]…\need[normalized[30:22]], 22'b0};\n        end\n        // E = 2*S - 1 - floor(D*R / 2^31), then R = floor(R*E / S).\n        3'd1, 3'd3: factor_q   <= ~product[65:31];\n        3'd2, 3'd4: recip_q    <= product[67:34];\n        3'd5:       quotient_q <= product[65:34] >> k_q;\n        3'd6:       residual_q <= dividend - product[31:0];\n        default: ;\n      endcase\n    end\n  end\n\n  // For nonzero B the two refinements yield floor(A/B) or one less.\n  // Thus Q*B <= A and the exact residual fits in 32 bits. INT_MIN/-1\n  // already has the required magnitude and bit pattern.\n  logic        correct;\n  logic [31:0] magnitude;\n  assign correct   = residual_q >= divisor;\n  assign magnitude = want_rem_q ? (correct ? residual_q - divisor : residual_q)\n                                : quotient_q + {31'b0, correct};\n  // At B=0 the residual is A and the remainder correction subtracts zero.\n  assign div_result = zero_q && !want_rem_q ? 32'hffff_ffff\n                    : negate_q ? -magnitude : magnitude;\n`endif\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
