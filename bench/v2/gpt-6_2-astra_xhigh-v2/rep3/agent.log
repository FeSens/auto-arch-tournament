{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r8_late_wb.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree,copyfile\nimport os,sys\nw=Path(os.environ['TMPDIR'])\nkind=sys.argv[1]\nbase=w/'bench-r8-shift'/'cores/bench'\ndst=w/('bench-r8-'+kind)\n(dst/'cores').mkdir(parents=True,exist_ok=True)\n(dst/'fpga').symlink_to(Path('fpga').resolve(),target_is_directory=True)\np=dst/'cores/bench'\ncopyfile(base/'core.yaml',(p.parent/'..'/'cores/bench.yaml')) if False else None\n(p/'rtl').mkdir(parents=True)\ncopyfile(base/'core.yaml',p/'core.yaml')\ncopytree(base/'rtl',p/'rtl',dirs_exist_ok=True)\ndef update(fn,pairs):\n f=p/'rtl'/fn\n t=f.read_text()\n for a,b in pairs:\n  assert a in t,a\n  t=t.replace(a,b)\n f.write_text(t)\nupdate('ex_stage.sv', [('  input  logic [31:0]        early_word,', '''  output logic               is_div,\n  output logic [31:0]        div_result,\n  input  logic [31:0]        early_word,'''),('logic is_div, div_req_ready, div_result_valid;', 'logic div_req_ready, div_result_valid;'),('  logic [31:0] div_result;\\\\n',''),('      reg_q.is_mul        <= is_mul;', '      reg_q.is_mul        <= is_mul;\\\\n      reg_q.is_div        <= is_div;'),(': div_result_valid ? div_result : alu_result;', ': alu_result;')])\nupdate('core_pkg.sv', [('    logic        is_mul;', '    logic        is_div;\\\\n    logic        is_mul;')])\nupdate('core.sv', [('  logic       mul_in_ex;', '''  logic       mul_in_ex, div_in_ex;\n  logic [31:0] mem_div_result;'''),('    .is_mul          (mul_in_ex),','''    .is_mul          (mul_in_ex),\n    .is_div          (div_in_ex),\n    .div_result      (mem_div_result),'''),('    .mem_product(mem_product),','    .mem_product(mem_product),\\\\n    .mem_div_result(mem_div_result),'),('\"'!early_hit) || mul_in_ex)'\"', '\"'!early_hit) || mul_in_ex || div_in_ex)'\"')])\nupdate('mem_stage.sv',[('  input  logic [31:0]        mem_product,','  input  logi