{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c 'alu_build=cores/bench/sim_build/alu\nverilator_inc=/opt/hwe-toolchain/oss-cad-suite/share/verilator/include\ng++ -O2 -std=c++20 -I\"$alu_build\" -I\"$verilator_inc\" -I\"$verilator_inc/vltstd\" -x c++ - -x none \"$alu_build/Vtop__ALL.a\" \"$alu_build/verilated.o\" \"$alu_build/verilated_threads.o\" \"$alu_build/verilated_dpi.o\" -pthread -o \"$TMPDIR/rv32m-stress\" <<'\"'CPP'\n#include \\\"Vtop.h\\\"\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <random>\n\nint main() {\n    Vtop dut;\n    auto tick = [&] { dut.clock = 0; dut.eval(); dut.clock = 1; dut.eval(); };\n    dut.reset = 1;\n    dut.div_req_valid = 0;\n    dut.div_result_ready = 0;\n    tick();\n    dut.reset = 0;\n    uint64_t vectors = 0;\n    auto check = [&](int op, uint32_t a, uint32_t b, uint32_t expected) {\n        if (\"'!dut.div_req_ready || dut.div_result_valid) std::abort();\n        dut.op = op; dut.a = a; dut.b = b;\n        dut.div_req_valid = 1; dut.div_result_ready = 0;\n        tick();\n        dut.op = 11 + (op + 1) % 8; dut.a = ~a; dut.b = ~b;\n        dut.div_req_valid = 0;\n        int latency = op < 15 ? 1 : 7;\n        for (int i = 0; i < latency; ++i) {\n            if (dut.div_req_ready || dut.div_result_valid) std::abort();\n            tick();\n        }\n        if (vectors % 257 == 0) tick();\n        if (!dut.div_result_valid || dut.div_req_ready || dut.div_result != expected) {\n            std::fprintf(stderr, \"op %d a %08x b %08x expected %08x got %08x'\"\\\\n\\\",\n                         op, a, b, expected, dut.div_result);\n            std::exit(1);\n        }\n        dut.div_result_ready = 1;\n        tick();\n        ++vectors;\n    };\n    auto test_all = [&](uint32_t a, uint32_t b) {\n        const int64_t sa = int32_t(a), sb = int32_t(b);\n        const uint64_t prod = uint64_t(a) * b;\n        check(11, a, b, uint32_t(prod));\n        check(12