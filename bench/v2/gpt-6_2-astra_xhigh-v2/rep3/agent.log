{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'study=\"$TMPDIR/bench-mul-study-yk8ad9cr\"\ncat > \"$study/variants.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,shutil\nr=Path(__file__).parent\ndef selmul(kind, word=False, agu=False):\n p=r/kind/'rtl'\n shutil.copytree(r/('loadaddr' if agu else 'load')/'rtl',p)\n def edit(file, fn):\n  f=p/file;s=f.read_text();updated=fn(s);assert updated\"'!=s, file;f.write_text(updated)\n def edalu(s):\n  start=s.index('\"'  // 64-bit products')\n  s=s[:start]+s[start:].replace('a[31]', 'a[31]') # operate on product inputs below\n  for name in ['mul_ss =','mul_uu =','mul_su =']:\n   import re\n   s=re.sub('\"'^    '\"'+name+r'.*\"'$'\"',lambda m: re.sub(r'\\\\b(a|b)\\\\b',lambda n:'mul_'+n[0],m[0]),s,flags=re.M)\n  s=s.replace('  output logic [31:0] out,','  input logic [31:0] mul_a, mul_b,\\\\n  output logic [31:0] out,')\n  return s\n edit('alu.sv',edalu)\n def edex(s):\n  s=s.replace('  output ex_mem_t  out,','  input logic [31:0] fwd_early,\\\\n  output ex_mem_t  out,')\n  a=s.index('  always_comb begin');b=s.index('  // ── ALU operand',a)\n  m=s[a:b].replace('fwd_ex_mem;', 'fwd_early;').replace('rs1 =','mul_a =').replace('rs2 =','mul_b =')\n  return s[:a]+'  logic [31:0] mul_a,mul_b;\\\\n'+m+s[a:].replace('    .op  (in.ctrl.alu_op),','    .mul_a(mul_a), .mul_b(mul_b),\\\\n    .op  (in.ctrl.alu_op),')\n edit('ex_stage.sv',edex)\n def edcore(s):\n  h=\\\"(if_id_w.instr[6:0] == 7'b0110011 && if_id_w.instr[31:25] == 7'b0000001)\\\"\n  if word:\n   h=\\\"(\\\"+h+\\\" || id_ex_w.ctrl.mem_width \"'!= 2'\"'d2)\\\"\n  s=s.replace(\\\".id_ex_mem_read (1'b0)\\\", \\\".id_ex_mem_read (id_ex_w.ctrl.mem_read && \\\"+h+\\\")\\\").replace('    .fwd_ex_mem      (mem_forward),','    .fwd_early       (ex_mem_w.alu_result),\\\\n    .fwd_ex_mem      (mem_forward),')\n  if not agu:\n   s=s.replace('  logic [31:0] mem_forward;', '  logic [31:0] mem_forward;\\\\n  logic mem_writes_rd;').replace('.mem_forward(mem_forward),','.mem_forward(mem_forward),\\\\n    .mem_writes_rd(mem_writes_rd),').replace('.ex_mem_w_en (ex_mem_w.ctrl.reg_write)', '.ex_mem_w_en (mem_writes_rd)')\n  return s\n edit('core.sv',edcore)\n def edmem(s):\n  if not agu:\n   s=s.replace('output logic [31:0] mem_forward,','output logic [31:0] mem_forward,\\\\n  output logic mem_writes_rd,').replace('  assign mem_forward', '  assign mem_writes_rd = ctrl_with_trap.reg_write;\\\\n  assign mem_forward')\n  if word:\n   s=s.replace('? load_data : in.alu_result','? dmem_rdata : in.alu_result')\n  return s\n if word or not agu:edit('mem_stage.sv',edmem)\nif __name__ == '__main__':\n selmul('selsub',False,False)\n selmul('selword',True,False)\n selmul('selsubaddr',False,True)\n selmul('selwordaddr',True,True)\nPY\npython \\\"\"'$study/variants.py\"\ncat > \"$study/timeone.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nr=Path(__file__).parent/sys.argv[1]\nres=build_all('.',r/'rtl','fpga/core_bench_si.sv',r/'build',options=list(map(int,sys.argv[2:])) or (0,1,2))\nprint([(o['place_option'],o['fmax_mhz'],o.get('critical_paths',[None])[0]) for o in res],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
