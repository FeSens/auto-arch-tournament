{"type":"item.started","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -c \"cat >> /srv/hwebench/tmp/ec844b20/49d10603/r7s2-probe.4NpGeo/tdptest/test/test_pipeline.py <<'PY'\n\n@cocotb.test()\nasync def pointer_probe_tags_and_subwords(dut):\n    prefix = [NOP()] * 1030\n    program = [\n        ADDI(1, 0, 64), (1 << 12) | (2 << 7) | 0x37, ADDI(2, 2, 64),\n        ADDI(3, 0, -128), SW(3, 1, 0), NOP(), NOP(), NOP(),\n        _i(0, 1, 0, 4, 3), ADDI(14, 4, 1), _i(0, 1, 4, 5, 3),\n        _i(0, 2, 1, 6, 3), ADDI(15, 6, 1), _i(0, 2, 5, 7, 3),\n        LW(8, 1, 0), ADDI(9, 0, 19), _s(2, 9, 1, 1, 0x23),\n        LW(10, 1, 0), ADDI(11, 10, 1), EBREAK()\n    ]\n    accepted_reads=[]; accepted_stores=[]; waits={}\n    def ready(ren,wen,addr,wdata):\n        if not ren and not wen:\n            return False\n        if ren or wen==12:\n            key = (wen,addr)\n            waits[key] = waits.get(key,0) + 1\n            if waits[key] % 3 \"'!= 0:\n                return False\n        if ren: accepted_reads.append(addr)\n        else: accepted_stores.append((wen,addr,wdata))\n        return True\n    r,mem=await _run(dut,prefix+program,dmem_init={4160:0x12348081},max_cycles=1160,dmem_ready=ready)\n    assert [v['\"'order'] for v in r] == list(range(len(r)))\n    r=r[len(prefix):]\n    assert [v['insn'] for v in r] == program\n    assert [v['rd_wdata'] for v in r[8:15]]==[0xffffff80,0xffffff81,128,0xffff8081,0xffff8082,0x8081,0xffffff80]\n    assert [r[i]['mem_rdata'] for i in (8,10,11,13,14)]==[0xffffff80,0xffffff80,0x12348081,0x12348081,0xffffff80]\n    assert [r[i]['mem_rmask'] for i in (8,10,11,13,14)]==[1,1,3,3,15]\n    assert accepted_reads==[4160,64,64]\n    assert len(accepted_stores)==2 and accepted_stores[-1]==(12,66,0x00130013)\n    assert mem[64]==0x0013ff80 and r[17]['rd_wdata']==0x0013ff80 and r[18]['rd_wdata']==0x0013ff81\nPY\ncd /srv/hwebench/tmp/ec844b20/49d10603/r7s2-probe.4NpGeo/tdptest && PYTHONDONTWRITEBYTECODE=1 pytest --rootdir=