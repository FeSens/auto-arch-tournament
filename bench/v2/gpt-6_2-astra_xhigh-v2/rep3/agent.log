{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c 'cat fpga/core_bench_si.sv && cat formal/checks_si.cfg'", "aggregated_output": "// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[2322 of 5394 chars elided by tools/bench/transcript.py; sha256:4a819f6a2f574183]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c 'ls -la bench/programs && cat bench/programs/Makefile && cat test/cosim/build.sh'", "aggregated_output": "total 464\ndrwxrwx---+  3 nobody nogroup   4096 Nov 20 21:16 .\ndrwxrwx---+  3 nobody nogroup   4096 Nov 20 21:16 ..\n-rw-rw----+  1 nobody nogroup   2317 Nov 20 21:16 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 20 21:16 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 20 21:16 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 20 21:16 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 20 21:16 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 20 21:16 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 20 21:16 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 20 21:16 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 20 21:16 selftest.S\nCROSS   := riscv32-unknown-elf\nCC      := $(CROSS)-gcc\n\n# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\n# (2K data size, -O3); tools/eval/fpga.py's COREMARK_EXPECTED CRCs assume\n# exactly these defaults.\n# - COREMARK_SIZE: TOTAL_DATA_SIZE in coremark.h (#ifndef-guarded). 2000 is\n#   the EEMBC canonical reporting config (used by VexRiscv et al.); 6000\n#   makes the matrix/list/state working sets ~3x larger so the score is\n#   harder to inflate via register-resident working sets.\n# - COREMARK_OPT: gcc optimization. -O3 is the standard CoreMark publication\n#   flag; -O2 is what the V0 baseline used.\n# Defaults match VexRiscv's published CoreMark methodology so the\n# orchestrator's fitness number is directly comparable to public CoreMark\n# results. To override (e.g. for the prior 6K -O2 V0 baseline):\n#     make bench/programs/coremark.elf COREMARK_SIZE=6000 COREMARK_OPT=-O2\nCOREMARK_SIZE ?= 2000\nCOREMARK_OPT  ?= -O3\n\nCFLAGS  := -march=rv32im -mabi=ilp32 $(COREMARK_OPT) -static -nostartfiles \\\n           -specs=nano.specs -specs=nosys.specs \\\n           -T bench/programs/link.ld -Ibench/programs/coremark \\\n           -Ibench/programs/coremark/baremetal \\\n           -DTOTAL_DATA_SIZE=$(COREMARK_SIZE)\n\nSRCS := bench/programs/coremark/core_list_join.c \\\n        bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n   \n…[2062 of 5134 chars elided by tools/bench/transcript.py; sha256:fc766cbe049726c5]…\nRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n", "exit_code": 0, "status": "completed"}}
