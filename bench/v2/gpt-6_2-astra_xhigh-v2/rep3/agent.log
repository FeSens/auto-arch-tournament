{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil,re\nr=Path(os.environ['TMPDIR'])/'bench-mul-study-yk8ad9cr/selsubaddr'\np=r/'rtl/alu.sv'\ns=p.read_text()\ns,n=re.subn(r'(ALU_MUL\\\\w*:\\\\s+out = )\\\\(a ([+-]) b\\\\)',r'\\\\1(mul_a \\\\2 mul_b)',s)\nassert n==4\np.write_text(s)\nshutil.copytree('cores/bench/test',r/'test')\np=r/'test/test_alu.py';s=p.read_text().replace('    dut.a.value  = a & MASK32\\\\n    dut.b.value  = b & MASK32\\\\n', '''    dut.mul_a.value = a & MASK32\n    dut.mul_b.value = b & MASK32\n    use_multiplier = op in (ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU)\n    dut.a.value = (~a if use_multiplier else a) & MASK32\n    dut.b.value = (~b if use_multiplier else b) & MASK32\n''')\np.write_text(s)\np=r/'test/test_pipeline.py';s=p.read_text()\na=s.index('    assert dmem[0] == 0x123',s.index('async def load_use_stalls('))\ns=s[:a]+'''    [load] = _by_insn(rets, LW(1, 0, 0))\n    assert r2[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1\n'''+s[a:]\ns=s.replace('async def load_use_stalls(dut):','async def adjacent_load_use(dut):').replace('load-use must stall once','load-use forwards on the next clock')\ns += '''\n\n@cocotb.test()\nasync def load_bypass_subwords_and_chains(dut):\n    # Byte 1 holds signed -128. Halfword 2 holds unsigned 0xff01.\n    lb = _i(1, 1, 0, 2, 0x03)\n    lhu = _i(2, 1, 5, 3, 0x03)\n    program = [\n        ADDI(1, 0, 64), lb, ADDI(4, 2, 2), lhu, SW(3, 1, 4),\n        LW(5, 1, 8), LW(6, 5, 0), SW(6, 1, 12), EBREAK(),\n    ]\n    attempts, accepted = [], []\n    def ready(ren, wen, addr, wdata):\n        if ren and addr == 65:\n            attempts.append(addr)\n            return len(attempts) > 2\n        if wen:\n            accepted.append((addr, wen, wdata))\n        return True\n    rets, dmem = await _run(dut, program,\n        dmem_init={64: 0xff018003, 72: 128, 128: 0xabcd},\n        dmem_ready=ready)\n    assert attempts == [65] * 3\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert all(r[\\\"trap\\\"] == 0 for r in rets)\n    for index in [2, 4, 6, 7]:\n        assert rets[index][\\\"cycle\\\"] == rets[index-1][\\\"cycle\\\"] + 1\n    assert (rets[2][\\\"rs1_rdata\\\"], rets[2][\\\"rd_wdata\\\"]) == (0xffffff80, 0xffffff82)\n    assert rets[4][\\\"rs2_rdata\\\"] == 0xff01\n    assert rets[6][\\\"rs1_rdata\\\"] == 128\n    assert accepted == [(68, 15, 0xff01), (76, 15, 0xabcd)]\n    assert (dmem[68],dmem[76]) == (0xff01,0xabcd)\n\n@cocotb.test()\nasync def misaligned_load_and_interlocked_mulh(dut):\n    mulh = _r(1, 2, 1, 1, 5, 0x33)\n    program = [\n        ADDI(1, 0, 42), LW(1, 0, 65), ADDI(3, 1, 3),\n        ADDI(2, 0, 2), LW(1, 0, 68), mulh, EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, dmem_init={64: 3, 68: 0x80000000})\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert [r[\\\"trap\\\"] for r in rets] == [0,1,0,0,0,0,0]\n    assert rets[1][\\\"rd\\\"] == 0 and rets[1][\\\"mem_rmask\\\"] == 0\n    assert (rets[2][\\\"rs1_rdata\\\"], rets[2][\\\"rd_wdata\\\"]) == (42,45)\n    assert (rets[5][\\\"rs1_rdata\\\"], rets[5][\\\"rs2_rdata\\\"], rets[5][\\\"rd_wdata\\\"]) == (0x80000000,2,0xffffffff)\n    assert rets[5][\\\"cycle\\\"] == rets[4][\\\"cycle\\\"] + 2\n'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
