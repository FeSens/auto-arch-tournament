{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/h14_fetch.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,tempfile,shutil\nname=sys.argv[1]\nsize=int(sys.argv[2])\nk=size.bit_length()-1\nrtl=Path(tempfile.gettempdir())/('h14_'+name)/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'):shutil.copy(f,rtl/f.name)\ndef edit(f,a,b):\n p=rtl/f\n s=p.read_text()\n assert a in s,a\n p.write_text(s.replace(a,b,1))\nedit('core.sv','.mem_instr       (ex_mem_w.instr),','.mem_instr       (ex_mem_w.instr), .mem_next(ex_mem_w.pc_next),')\np=rtl/'if_stage.sv'\ns=p.read_text().split('  logic [31:0] held_pc_q, pc, instr;')[0]\ns=s.replace('input  logic [31:0]       mem_instr,','input  logic [31:0]       mem_instr, input logic [31:0] mem_next,')\ns+='''\n  localparam K=INDEX_WIDTH;\n  typedef struct packed {\n    logic valid;\n    logic [19:K+2] tag;\n    logic [31:0] word_data;\n    logic [17:0] target;\n    logic uncond, cond, bias;\n  } row_t;\n  row_t rows[0:(1<<K)-1], row_q;\n  logic [1:0] counters[0:63];\n  logic [31:0] fetch_pc_q, last_pc_q, last_word_q, pc, word_data, target, seq, next_pc;\n  logic row_hit, hit, last_valid_q, direction, use_target, sweep_q, row_ok_q;\n  logic [K-1:0] sweep_idx_q;\n  logic [1:0] count;\n  wire [31:0] bdisp = {{19{mem_instr[31]}},mem_instr[31],mem_instr[7],mem_instr[30:25],mem_instr[11:8],1'b0};\n  wire [31:0] jdisp = {{11{mem_instr[31]}},mem_instr[31],mem_instr[19:12],mem_instr[20],mem_instr[30:21],1'b0};\n  wire mbranch = mem_instr[6:0]==7'h63 && mem_instr[14:13]\"'!=2'\"'b01;\n  wire mjal = mem_instr[6:0]==7'h6f;\n  wire mjalr = mem_instr[6:0]==7'h67 && mem_instr[14:12]==0;\n  wire [31:0] direct = mem_pc + (mjal ? jdisp : bdisp);\n  wire [31:0] mtarget = mjalr ? mem_next : direct;\n  wire target_ok = mtarget[31:20]==0 && mtarget[1:0]==0;\n  row_t fill_q;\n  logic [K-1:0] fill_index_q;\n  logic write_q;\n  always_ff @(posedge clock) begin\n    write_q <= \"'!reset && !fence_i && !sweep_q && mem_transfer && mem_pc[31:20]==0 && mem_pc[1:0]==0;\n    fill_index_q <= mem_pc[K+1:2];\n    fill_q <= {1'\"'b1,mem_pc[19:K+2],mem_instr,mtarget[19:2],\n               (mjal || mjalr) && target_ok,mbranch && target_ok,mem_instr[31]};\n    if (sweep_q || write_q)\n      rows[sweep_q ? sweep_idx_q : fill_index_q] <= sweep_q ? '0 : fill_q;\n    row_q <= rows[next_pc[K+1:2]];\n    row_ok_q <= \"'!sweep_q && !(write_q && fill_index_q==next_pc[K+1:2]);\n    if (reset || fence_i) begin\n      sweep_q<=1; sweep_idx_q<=0;\n    end else if (sweep_q) begin\n      sweep_idx_q<=sweep_idx_q+1'\"'b1;\n      if (&sweep_idx_q) sweep_q<=0;\n    end\n  end\n  initial for (int i=0;i<64;i++) counters[i]=2'b01;\n  always_ff @(posedge clock) if(train_en) counters[train_index]<=train_value;\n  assign pc=redirect ? resolved_pc : replay ? last_pc_q : fetch_pc_q;\n  assign row_hit=(\"'!redirect && !replay) && pc[31:20]==0 && pc[1:0]==0 &&\n                 !sweep_q && row_ok_q && row_q.valid && row_q.tag==pc[19:K+2];\n  assign hit=row_hit || (!redirect && replay && last_valid_q && !sweep_q);\n  assign word_data=imem_ready ? imem_data : replay && !redirect ? last_word_q : row_q.word_data;\n  assign count=counters[pc[7:2]];\n  assign direction=row_q.uncond || (row_q.cond && (row_q.bias ''^ count[1]));\n  assign use_target=row_hit && direction;\n  assign target={12'\"'b0,row_q.target,2'b0};\n  assign seq=pc+32'd4;\n  assign next_pc=stall ? pc : use_target ? target : seq;\n  always_ff @(posedge clock) begin\n    fetch_pc_q<=reset ? 32'b0 : next_pc;\n    if(\"'!stall_id) begin\n      last_pc_q<=pc; last_word_q<=word_data;\n      last_valid_q<=!reset && !fence_i && (imem_ready || hit);\n      fallthrough_q<=seq;\n      forecast_pc<=target;\n      forecast_used<=use_target && target!=seq;\n    end\n  end\n  assign imem_addr=pc;\n  assign out.pc=pc;\n  assign out.instr=word_data;\n  assign out.valid=imem_ready || hit;\n  assign out.t