{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c 'for d in \"$TMPDIR/verification/cores/bench/generated/timing/\"*; do tail -2 \"$d/gw.log\"; done; tail -2 \"$TMPDIR/verification\"/formal/riscv-formal/cores/bench-*/checks/reg_ch0/logfile.txt; head -50 cores/bench/rtl/ex_stage.sv; cat cores/bench/rtl/forward_unit.sv'", "aggregated_output": "[20%] Placement Phase 1 completed\n[30%] Placement Phase 2 completed\n[20%] Placement Phase 1 completed\n[30%] Placement Phase 2 completed\n[20%] Placement Phase 1 completed\n[30%] Placement Phase 2 completed\nSBY 23:00:36 [reg_ch0] summary: engine_0 did not produce any traces\nSBY 23:00:36 [reg_ch0] DONE (PASS, rc=0)\n// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// Forwarding select encoding (captured in ID/EX):\n//   00 = ID/EX register value (no forward)\n//   01 = EX/MEM aluResult (instruction immediately ahead in MEM)\n//   10 = MEM/WB result (instruction two ahead, post regfile-write mux)\n//\n// Latency:        1 cycle for integer/multiply, variable for divide/remainder.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               is_mul,        // valid MUL-family entry in ID/EX\n  output logic [31:0]        mem_product,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  input  logic               jalr_forecast,\n  input  logic [31:0]        fetch_pc,\n  output ex_mem_t  out,\n  output logic               next_reg_write,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:0]        redirect_target,\n  output logic               train_en,\n  output logic [5:0]         train_index,\n  output logic [1:0]         train_value\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = ({32{in.fwd_rs1 == 2'b00}} & in.rs1_val)\n             | ({32{in.fwd_rs1[0]}} & fwd_ex_mem)\n             | ({32{in.fwd_rs1[1]}} & fwd_mem_wb);\n  assign rs2 = ({32{in.fwd_rs2 == 2'b00}} & in.rs2_val)\n             | ({32{in.fwd_rs2[0]}} & fwd_ex_mem)\n             | ({32{in.fwd_rs2[1]}} & fwd_mem_wb);\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n// rtl/forward_unit.sv\n//\n// Compare ID's sources with the instructions in EX and MEM. Each select\n// names the source that will be available when this consumer reaches EX:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// The younger EX writer takes priority. Writes to x0 never match.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] ex_rd,\n  input  logic       ex_w_en,\n  input  logic [4:0] mem_rd,\n  input  logic       mem_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_w_en  && ex_rd  != 5'b0 && ex_rd  == id_rs1) fwd_rs1 = 2'd1;\n    else if (mem_w_en && mem_rd != 5'b0 && mem_rd == id_rs1) fwd_rs1 = 2'd2;\n    else                                                     fwd_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_w_en  && ex_rd  != 5'b0 && ex_rd  == id_rs2) fwd_rs2 = 2'd1;\n    else if (mem_w_en && mem_rd != 5'b0 && mem_rd == id_rs2) fwd_rs2 = 2'd2;\n    else                                                     fwd_rs2 = 2'd0;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
