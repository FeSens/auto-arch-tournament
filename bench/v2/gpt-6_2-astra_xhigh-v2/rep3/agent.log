{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r8_barrel.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil,sys,os\nkind=sys.argv[1]\nw=Path(os.environ['TMPDIR'])\ndst=w/('bench-r8-'+kind)\np=dst/'cores/bench'; p.mkdir(parents=True)\n(dst/'fpga').symlink_to(Path('fpga').resolve(),target_is_directory=True)\nshutil.copytree(w/'bench-r8-shift/cores/bench/rtl',p/'rtl')\nshutil.copyfile('cores/bench/core.yaml',p/'core.yaml')\nf=p/'rtl/alu.sv';s=f.read_text()\ni=s.index('  always_comb')\ns=s[:i]+'''  logic [31:0] shift_value, shift_input, reversed_input, shifted, reversed_output;\n  logic [4:0] shift_amount;\n  logic shift_left, shift_sign;\n  for (genvar i = 0; i < 32; i++) begin : gen_reverse\n    assign reversed_input[i] = a[31-i];\n    assign reversed_output[i] = shifted[31-i];\n  end\n  assign shift_left = op == ALU_SLL;\n  assign shift_sign = op == ALU_SRA && a[31];\n  logic signed [32:0] extended;\n  assign extended = {shift_sign, shift_input};\n  assign shifted = 32'(extended >>> shift_amount);\n  assign shift_value = shift_left ? reversed_output : shifted;\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  assign shift_input = shift_left ? reversed_input : a;\n  assign shift_amount = b[4:0];\n`endif\n\n'\"'''+s[i:]\ns=s.replace('ALU_SLL:    out = a << b[4:0];\\\\n      ALU_SRL:    out = a >> b[4:0];\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> b[4:0]);'\"','ALU_SLL, ALU_SRL, ALU_SRA: out = shift_value;')\ni=s.index('  assign dividend')\ns=s[:i]+'''  wire        prepare_shift = busy_q && pass_q == 3'd4;\n  assign shift_input = prepare_shift ? dividend : shift_left ? reversed_input : a;\n  assign shift_amount = prepare_shift ? k_q : b[4:0];\n'''+s[i:]\ns=s.replace('logic [4:0]  clz_b, k_q;', 'logic [4:0]  clz_b;').replace('  wire        prepare_shift =','  logic [4:0] k_q;\\\\n  wire        prepare_shift =')\ns=s.replace('  assign shift_sign = op == ALU_SRA && a[31];','').replace('  assign shift_amount = b[4:0];', '  assign shift_amount = b[4:0];\\\\n  assign shift_sign = op == ALU_SRA && a[31];').replace('  assign shift_amount = prepare_shift ?', '  assign shift_sign = \"'!prepare_shift && op == ALU_SRA && a[31];'\"\\\\n  assign shift_amount = prepare_shift ?')\ns=s.replace('normalized_q <= dividend >> k_q;','normalized_q <= shifted;')\nif kind=='barrel_early':\n s=s.replace(\\\"wire        prepare_shift = busy_q && pass_q == 3'd4;\\\",'wire        prepare_shift = busy_q;')\nif kind=='barrel_right':\n s=s.replace('ALU_SLL, ALU_SRL, ALU_SRA: out = shift_value;', 'ALU_SLL: out = a << b[4:0];\\\\n      ALU_SRL, ALU_SRA: out = shifted;')\n s=s.replace('shift_left ? reversed_input : a','a')\nf.write_text(s)\nPY\npython \\\"\"'$TMPDIR/r8_barrel.py\" barrel_early\npython \"$TMPDIR/r8_barrel.py\" barrel_right'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
