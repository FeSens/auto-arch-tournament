{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"sed -n '77,196p;700,1034p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready=None,\n               *, imem_ready=None, fetch_trace=None, sweep_cycles=0):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    The optional dmem_ready(ren, wen, addr, wdata) callback sets readiness\n    for the upcoming edge. Accepted stores update the Python-side dmem.\n    imem_ready(pc) controls instruction delivery. fetch_trace records each\n    presented address, including speculative requests and wait states.\n    sweep_cycles delays the first instruction while RAM rows are invalidated.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = program if isinstance(program, dict) else {\n        i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)\n    }\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    def drive_fetch(pc):\n        if fetch_trace is not None:\n            fetch_trace.append(pc)\n        ready = imem_ready(pc) if imem_ready else True\n        dut.io_imemReady.value = int(ready)\n        dut.io_imemData.value = imem.get(pc, EBREAK()) if ready else SW(0, 0, 0xbc)\n\n    clock_task = cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Start both buses in zero-wait mode.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    if sweep_cycles:\n        dut.io_imemReady.value = 0\n        await ClockCycles(dut.clock, sweep_cycles)\n    drive_fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        d\n…[15031 of 18103 chars elided by tools/bench/transcript.py; sha256:7500dcc30f7277fb]…\n\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [120, 124, 128, 136, 144]\n    assert all(r[\"rd\"] == 0 and r[\"rd_wdata\"] == 0 for r in rets if r[\"trap\"])\n\n\n@cocotb.test()\nasync def speculative_fetch_stays_in_ram(dut):\n    # Train the forward branch's index before testing the upper RAM bound.\n    # The final backward branch would wrap below RAM on a taken prediction.\n    program = {\n        0: JAL(0, 0x60),\n        0x60: BEQ(0, 0, 256), 0x160: JAL(0, 0x7ff00),\n        0x80060: JAL(0, 0x7ff00), 0xfff60: BNE(0, 0, 0xa0),\n        0xfff64: JAL(0, -0xfff00), 0x64: BNE(0, 0, -128), 0x68: EBREAK(),\n    }\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_trace=fetches)\n    pcs = [0, 0x60, 0x160, 0x80060, 0xfff60, 0xfff64, 0x64, 0x68]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert fetches[:len(pcs) + 1] == [0, 0x60, 0x64, *pcs[2:]]\n    assert all(pc < 0x100000 and pc % 4 == 0 for pc in fetches)\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n", "exit_code": 0, "status": "completed"}}
