{"type": "item.completed", "item": {"id": "item_253", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// While fetching A, probe the row for the predicted B. At admission of B,\n// register its row in fabric so its successor C can issue on the next clock.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_value,\n  output logic              jalr_forecast,\n  output logic [19:2]       forecast_word_addr,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc_q, pc, instr;\n  logic [31:0] next_q, recovery_q, parked_pc_q;\n  logic [1:0] counters [0:63];\n  logic [1:0] count;\n  logic predicted_taken;\n  logic [31:0] fallthrough, predicted_target;\n\n  // Rows are indexed by the predecessor but contain the successor's full\n  // RAM word address. The direct target and flags describe that successor.\n  typedef struct packed {\n    logic [17:0] word_addr;\n    logic [31:0] instr;\n    logic [17:0] direct_addr;\n    logic        branch_ok;\n    logic        jal_ok;\n  } successor_data_t;\n  typedef struct packed {\n    logic            valid;\n    successor_data_t data;\n  } successor_t;\n  successor_t successors [0:511];\n  successor_t probe_q;\n  successor_data_t held_q, fresh_q, retained_q, saved;\n  logic [8:0] predecessor, sweep_ind\n…[8187 of 11259 chars elided by tools/bench/transcript.py; sha256:28e8e0da4919324d]…\n[8:0] + 9'd1;\n  assign predicted_index = imem_ready ? bus_hint : cached_hint;\n\n  // Form all three PC candidates before the edge. A late interlock or\n  // redirect only chooses which register supplies the new request.\n  logic recover_q, park_q;\n  always_ff @(posedge clock) begin\n    next_q      <= predicted_taken ? predicted_target : fallthrough;\n    recovery_q  <= reset ? RESET_PC : redirect_target;\n    parked_pc_q <= pc_q;\n    recover_q   <= reset || redirect;\n    park_q      <= stall;\n  end\n  assign pc_q = recover_q ? recovery_q : park_q ? parked_pc_q : next_q;\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc              = pc;\n    out.instr           = instr;\n    out.valid           = imem_ready || saved_hit;\n    out.predicted_taken = predicted_taken;\n    // Predict with the old count, but train from the newest count if two\n    // consecutive branch PCs alias. This bypass only feeds the snapshot.\n    out.train_count     = train_en && train_index == pc[7:2] ? train_value : count;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
