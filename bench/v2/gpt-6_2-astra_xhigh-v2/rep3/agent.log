/ fetch cannot advance\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX correction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_enable,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]    \n…[1488 of 4560 chars elided by tools/bench/transcript.py; sha256:6def5eb661bbcfb2]…\n                         imem_data[11:8], 1'b0};\n  assign target = pc + offset;\n  assign predicted_taken = (is_jal || (is_branch && (imem_data[31] ^ fetch_counter[1])))\n                           && target[31:20] == 0 && target[1:0] == 0;\n\n  // An advancing EX correction takes priority even when imem is stalled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= predicted_taken ? {12'b0, target[19:2], 2'b00} : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid = !(flush || redirect);\n    out.predicted_taken = predicted_taken;\n    // If EX writes this index at the capture edge, start the younger\n    // instruction's eventual update from the older one's result.\n    out.counter_snapshot = (train_enable && train_index == pc[7:2])\n                         ? updated_counter : fetch_counter;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
