 = dec_alu_op \"'!= ALU_ADD && dec_alu_op != ALU_SUB;\n\"\"\"); d.write_text(u)\n s=s.replace('\"'  logic direct_addi;', '  logic direct_addi;').replace('in.ctrl.alu_src && in.ctrl.alu_op == ALU_ADD && \"'!(in.ctrl.mem_read || in.ctrl.is_jump || in.ctrl.is_auipc)'\"','in.ctrl.use_addi')\n # Arithmetic output and masks are parallel with the existing bitwise ALU output.\n s=s.replace(\\\"({32{\"'!(direct_addi || in.ctrl.is_auipc || in.ctrl.is_jump || in.ctrl.mem_read)}} & alu_result);\", \"\"\"({32{in.ctrl.use_rr_add}} & (rs1 + rs2)) |\n                             ({32{in.ctrl.use_rr_sub}} & (rs1 - rs2)) |\n                             ({32{in.ctrl.use_lean_alu}} & alu_result);\"\"\")\n # A JAL defaults to ALU_ADD, but must mask off its arithmetic path.\n d.write_text(d.read_text().replace('\"'dec_alu_op == ALU_ADD && \"'!dec_alu_src'\"','dec_alu_op == ALU_ADD && \"'!dec_alu_src && !dec_is_jump'\"'))\n if opt=='onehadd':\n  # For the general ALU, present rs1 as operand a; prepare mux for imm vs forwarded B in ID.\n  pkg.write_text(pkg.read_text().replace('logic [31:0] rs2_val;','logic [31:0] alu_b_base;\\\\n    logic [31:0] rs2_val;',1))\n  d.write_text(d.read_text().replace('reg_q.rs2_val  <= rs2_data;', 'reg_q.rs2_val  <= rs2_data;\\\\n      reg_q.alu_b_base <= dec_alu_src ? imm : rs2_data;'))\n  s=s.replace('in.ctrl.alu_src  ? in.imm : rs2;',\\\"\\\"\\\"in.alu_b_base | ({32{fwd_rs2_sel[0] && \"'!in.ctrl.alu_src}} & fwd_ex_mem)\n                           | ({32{fwd_rs2_sel[1] && !in.ctrl.alu_src}} & mem_product)\n                           | ({32{fwd_rs2_sel[2] && !in.ctrl.alu_src}} & fwd_mem_wb);\"\"\")\na.write_text(t);p.write_text(s)\nPY\npython \"$TMPDIR/fastalu.py\" addreuse && python \"$TMPDIR/fastalu.py\" splitadd && python \"$TMPDIR/fastalu.py\" onehadd'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
