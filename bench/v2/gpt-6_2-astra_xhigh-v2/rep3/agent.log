{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/stride/build.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\ndest=Path(os.environ[\\\"TMPDIR\\\"])/\\\"stride/rtl\\\"\nsrc=Path('cores/bench/rtl')\ndef edit(name,reps):\n    s=(src/name).read_text()\n    for a,b in reps:\n        assert a in s,(name,a)\n        s=s.replace(a,b)\n    (dest/name).write_text(s)\nedit('core_pkg.sv', [('logic        is_mul;', '''logic [31:0] effective_addr;\n    logic        early_hit;\n    logic [31:0] early_raw;\n    logic [31:0] early_data;\n    logic        is_mul;''')])\nedit('ex_stage.sv', [('  output logic               div_wait,','''  input logic [31:0] probe_word,\n  input logic [17:0] probe_addr,\n  input logic        probe_valid,\n  input logic        store_conflict,\n  input logic [31:0] fwd_load,\n  output logic       load_hit,\n  output logic               div_wait,'''),\n(\\\"2'd1:    rs1 = fwd_ex_mem;\\\", \\\"2'd1:    rs1 = fwd_ex_mem;\\\\n      2'd3:    rs1 = fwd_load;\\\"),\n(\\\"2'd1:    rs2 = fwd_ex_mem;\\\", \\\"2'd1:    rs2 = fwd_ex_mem;\\\\n      2'd3:    rs2 = fwd_load;\\\"),\n('  ex_mem_t reg_q;', '''  ex_mem_t reg_q;\n  logic [31:0] effective_addr, early_data;\n  logic [15:0] early_half;\n  logic [7:0] early_byte;\n  logic natural;\n  assign effective_addr = rs1 + in.imm;\n  assign natural = (in.ctrl.mem_width == 0) ||\n                   ((in.ctrl.mem_width == 1) && \"'!effective_addr[0]) ||\n                   (effective_addr[1:0] == 0);\n  assign load_hit = in.valid && in.ctrl.mem_read && probe_valid && !store_conflict &&\n                    natural && (effective_addr[31:2] == {12'\"'b0,probe_addr});\n  assign early_half = effective_addr[1] ? probe_word[31:16] : probe_word[15:0];\n  assign early_byte = effective_addr[0] ? early_half[15:8] : early_half[7:0];\n  always_comb begin\n    case (in.ctrl.mem_width)\n      2'd0: early_data = {{24{in.ctrl.mem_sext && early_byte[7]}},early_byte};\n      2'd1: early_data = {{16{in.ctrl.mem_sext && early_half[15]}},early_half};\n      default: early_data = probe_word;\n    endcase\n  end'''),\n('      reg_q.pc            <= in.pc;', '''      reg_q.effective_addr <= effective_addr;\n      reg_q.early_hit <= load_hit;\n      reg_q.early_raw <= probe_word;\n      reg_q.early_data <= early_data;\n      reg_q.pc            <= in.pc;''')])\nedit('forward_unit.sv',[('  input  logic [4:0] mem_wb_rd,','  input logic ex_mem_load,\\\\n  input  logic [4:0] mem_wb_rd,'),\n(\\\"fwd_rs1 = 2'd1;\\\", \\\"fwd_rs1 = ex_mem_load ? 2'd3 : 2'd1;\\\"),(\\\"fwd_rs2 = 2'd1;\\\", \\\"fwd_rs2 = ex_mem_load ? 2'd3 : 2'd1;\\\")])\nedit('mem_stage.sv', [('in.alu_result','in.effective_addr'),\n('in.is_mul ? mem_product : in.effective_addr','in.is_mul ? mem_product : in.alu_result'),\n('reg_q.read_data  <= load_data;','reg_q.read_data  <= in.early_hit ? in.early_data : load_data;'),\n('reg_q.mem_rdata  <= dmem_rdata;', 'reg_q.mem_rdata  <= in.early_hit ? in.early_raw : dmem_rdata;'),\n('dmem_ren   = in.ctrl.mem_read  && \"'!mem_misalign;'\"', 'dmem_ren   = in.ctrl.mem_read && \"'!mem_misalign && !in.early_hit;'\"')])\nedit('core.sv', [('  ex_stage u_ex (','''  logic [11:0] history [0:63];\n  logic [9:0] next_word [0:63];\n  logic [11:0] byte_forecast;\n  assign byte_forecast = (ex_mem_w.effective_addr[11:0] << 1) - history[ex_mem_w.pc[7:2]];\n  always_ff @(posedge clock) begin\n    if (\"'!reset && !hold_mem_wb && ex_mem_w.valid && ex_mem_w.ctrl.mem_read) begin\n      history[ex_mem_w.pc[7:2]]   <= ex_mem_w.effective_addr[11:0];\n      next_word[ex_mem_w.pc[7:2]] <= byte_forecast[11:2];\n    end\n  end\n  logic [11:0] rf_guess;\n  logic base_pending;\n  assign base_pending = (rs1_addr_w != 0) &&\n                         ((id_ex_w.ctrl.reg_write && rs1_addr_w == id_ex_w.rd) ||\n                          (ex_mem_w.ctrl.reg_write && rs1_addr_w == ex_mem_w.rd));\n  assign rf_guess = rs1_data_w[11:0] + if_id_w.instr[31:20];\n  logic [9:0] probe, probe_q, sweep_q, update_index;\n  logic [40:0] words [0:1023];\n  logic [40:0] candidate_q;\n  logic enabled_q, sweep_busy_q, update_word, clean_word, collision, load_hit;\n  assign probe = base_pending ? next_word[if_id_w.pc[7:2]] : rf_guess[11:2];\n  assign update_word = (io_dmemAddr[31:20] == 0) && io_dmemReady && (io_dmemREn || (|io_dmemWEn));\n  assign clean_word = io_dmemREn || (&io_dmemWEn);\n  assign update_index = sweep_busy_q ? sweep_q : io_dmemAddr[11:2];\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sweep_busy_q <= 1;\n      sweep_q <= 0;\n      enabled_q <= 0;\n    end else begin\n      if (sweep_busy_q) begin\n        sweep_q <= sweep_q + 1'\"'b1;\n        if (&sweep_q) sweep_busy_q <= 0;\n      end\n      if (\"'!stall_id)\n        enabled_q <= !sweep_busy_q && !(update_word && probe == update_index);\n    end\n    if (!stall_id) begin\n      candidate_q <= words[probe];\n      probe_q <= probe;\n    end\n    if (sweep_busy_q || update_word)\n      words[update_index] <= {!sweep_busy_q && clean_word,io_dmemAddr[19:12],\n                              io_dmemREn ? io_dmemRData : io_dmemWData};\n  end\n  assign collision = ex_mem_w.ctrl.mem_write && (ex_mem_w.effective_addr[11:2] == probe_q);\n  ex_stage u_ex (\n    .probe_word      (candidate_q[31:0]),\n    .probe_addr      ({candidate_q[39:32],probe_q}),\n    .probe_valid     (enabled_q && candidate_q[40]),\n    .store_conflict  (collision),\n    .fwd_load        (ex_mem_w.early_data),\n    .load_hit        (load_hit),'\"'''),\n('id_ex_w.ctrl.mem_read || mul_in_ex','(id_ex_w.ctrl.mem_read && \"'!load_hit) || mul_in_ex'\"'),\n('ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write','(ex_mem_w.ctrl.mem_read && \"'!ex_mem_w.early_hit) || ex_mem_w.ctrl.mem_write'\"'),\n('  forward_unit u_fwd (','  forward_unit u_fwd (\\\\n    .ex_mem_load    (ex_mem_w.ctrl.mem_read),')])\nPY\npython \\\"\"'$TMPDIR/stride/build.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
