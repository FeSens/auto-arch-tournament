{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/mulreg/unit.py\" <<'\"'PY'\nimport os, sys, shutil, subprocess, xml.etree.ElementTree as ET\nfrom pathlib import Path\nbase=Path(os.environ['TMPDIR'])/'mulreg'\nv=sys.argv[1]\ns=base/f'{v}_test'\ns.mkdir(exist_ok=True)\nshutil.copytree('cores/bench/test',s/'test',dirs_exist_ok=True)\nif not (s/'rtl').exists(): (s/'rtl').symlink_to(base/v)\np=s/'test/test_alu.py'\np.write_text(p.read_text()+'''\n\n@cocotb.test()\nasync def shifted_dividend_boundaries(dut):\n    await _setup(dut)\n    for k in range(32):\n        unit = 1 << k\n        for b in sorted({unit, min(MASK32, unit + 1), (2 * unit) - 1,\n                         unit + (unit >> 2)}):\n            limit = MASK32 // b\n            for q in sorted({0, 1, limit // 2, limit}):\n                exact = q * b\n                low_ones = exact | (unit - 1)\n                for a in sorted({exact - 1, exact, exact + 1, low_ones}):\n                    if 0 <= a <= MASK32:\n                        quo, rem = divmod(a, b)\n                        await _check_div(dut, ALU_DIVU, a, b, quo)\n                        await _check_div(dut, ALU_REMU, a, b, rem, hold_cycles=1)\n    await _check_mul(dut, ALU_MULHSU, 0xffffffef, MASK32, 0xffffffef)\n    dut.mul_issue.value = 0\n    await _check_div(dut, ALU_DIVU, MASK32, 3, MASK32 // 3)\n    await _check_mul(dut, ALU_MULHU, MASK32, MASK32, 0xfffffffe)\n''')\nenv=dict(os.environ,PYTEST_DISABLE_PLUGIN_AUTOLOAD='1')\nwith (s/'unit.log').open('w') as f:\n result=subprocess.run([sys.executable,'-m','pytest','--rootdir=.','--confcutdir=.','-q','test'],cwd=s,stdout=f,stderr=subprocess.STDOUT, env=env)\nprint(result.returncode)\nfor x in sorted((s/'test').glob('*.xml')):\n c=ET.parse(x).findall('.//testcase')\n print(x.name,len(c),'failures',sum(t.find('failure') is not None for t in c))\nsys.exit(result.returncode)\nPY\npython \\\"\"'$TMPDIR/mulreg/unit.py\" pipe_nr'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
