{"type":"item.started","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom fractions import Fraction as Fr\nmask = (1 << 32) - 1\nworst = (Fr(0), 0, 0)\nrows = 0\nfor k in range(32):\n    scale = 1 << k\n    dropped = 1 << max(0, k - 2)\n    x_error = Fr(dropped - 1, 4 * dropped)\n    for i in range(1024):\n        lo = ((1024 + i) * scale + 1023) // 1024\n        hi = ((1025 + i) * scale + 1023) // 1024 - 1\n        if lo > hi:\n            continue\n        p = min((1 << 18) - 1, (1 << 28) // (1024 + i))\n        r = Fr(p, 1 << 18)\n        endpoints = (Fr(lo, scale), Fr(hi, scale))\n        # D*r\"'^2 - 2*r + 1/D is convex on each constant-seed interval.\n        seed_error = max((r * d - 1)**2 / d for d in endpoints)\n        rounded_error = seed_error + (1+r) / (1 << 34)\n        bound = Fr(mask, scale) * rounded_error + x_error\n        assert bound < 1, (k, i, bound)\n        worst = max(worst, (bound, k, i))\n        rows += 1\nprint(f'\"'{rows} nonempty exponent/row intervals. Worst upper bound {float(worst[0]):.9f} quotient units at k={worst[1]}, row={worst[2]}.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
