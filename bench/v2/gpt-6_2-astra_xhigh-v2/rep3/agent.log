{"type": "item.completed", "item": {"id": "item_139", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/core_pkg.sv cores/bench/rtl/ex_stage.sv cores/bench/rtl/id_stage.sv'", "aggregated_output": "diff --git a/cores/bench/rtl/core_pkg.sv b/cores/bench/rtl/core_pkg.sv\nindex 2d7879e..5c481fe 100644\n--- a/cores/bench/rtl/core_pkg.sv\n+++ b/cores/bench/rtl/core_pkg.sv\n@@ -61,13 +61,18 @@\n                                                input logic sext);\n     logic [15:0] half_data;\n     logic [7:0] byte_data;\n-    half_data = offset[1] ? word_data[31:16] : word_data[15:0];\n-    byte_data = offset[0] ? half_data[15:8] : half_data[7:0];\n-    case (width)\n-      2'd0:    format_load = {{24{sext && byte_data[7]}}, byte_data};\n-      2'd1:    format_load = {{16{sext && half_data[15]}}, half_data};\n-      default: format_load = word_data;\n-    endcase\n+    logic is_byte, is_half, byte_sign, half_sign;\n+    is_byte = width == 2'd0;\n+    is_half = width == 2'd1;\n+    // A full-word load takes the low lanes directly. Both MEM formatters\n+    // share the width-qualified lane selects.\n+    half_data = (is_byte || is_half) && offset[1] ? word_data[31:16] : word_data[15:0];\n+    byte_data = is_byte && offset[0] ? half_data[15:8] : half_data[7:0];\n+    byte_sign = sext && is_byte && byte_data[7];\n+    half_sign = sext && is_half && half_data[15];\n+    format_load[7:0]   = byte_data;\n+    format_load[15:8]  = ({8{!is_byte}} & half_data[15:8]) | {8{byte_sign}};\n+    format_load[31:16] = ({16{!(is_byte || is_half)}} & word_data[31:16]) | {16{byte_sign || half_sign}};\n   endfunction\n \n   // ── Pipeline-bundle typedefs ────────────────────────────────────────────\n@@ -103,6 +108,7 @@\n     logic [31:0] pc;\n     logic [31:0] rs1_val;\n     logic [31:0] rs2_val;\n+    logic [31:0] alu_b_base; // immediate or the masked register-file value\n     logic [31:0] imm;\n     logic [4:0]  rd;\n     logic [4:0]  rs1_addr;\ndiff --git a/c