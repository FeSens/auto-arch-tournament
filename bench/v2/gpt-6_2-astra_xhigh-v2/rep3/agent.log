{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"command -v riscv32-unknown-elf-gcc; command -v spike; command -v g++; command -v python3; ls -A /srv/hwebench/tmp/ec844b20/8d83fbd5; cat fpga/bench_stall_gen.sv && rg -n 'cycles|stall|trace' test/cosim/main.cpp | head -80\"","aggregated_output":"/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n/usr/bin/g++\n/srv/hwebench/venv/bin/python3\n.agents\n.aws\n.codex\n.git\ncodex-bwrap-synthetic-mount-targets-1001\n// fpga/bench_stall_gen.sv\n//\n// Memory-ready generator for the timed FPGA wrapper (HWE Bench V2).\n//\n// It reproduces, cycle for cycle, the bus backpressure that\n// test/cosim/main.cpp applies when CoreMark is run for fitness\n// (--istall --dstall): an xorshift32 seeded with 0xDEADBEEF, advanced\n// twice per cycle (first draw -> imem ready, second draw -> dmem ready),\n// accepting when (state & 0x7F) < 100.\n//\n// Why it exists: in V1 the wrapper tied both ready signals to 1, so\n// synthesis deleted any core logic that only acts while a ready is low.\n// That logic then saved simulated cycles at no area or timing cost. With\n// the ready signals driven by this generator, the timed netlist is the\n// circuit whose cycles are counted.\n//\n// Both ready outputs come straight from flip-flops, so the generator adds\n// no combinational depth to paths inside the core. The reset values hold\n// the first cycle's draws; each clock precomputes the next cycle's pair.\nmodule bench_stall_gen (\n  input  logic clock,\n  input  logic reset,\n  output logic imem_ready,\n  output logic dmem_ready\n);\n\n  function automatic [31:0] xs32(input [31:0] s);\n    reg [31:0] t;\n    begin\n      t = s ^ (s << 13);\n      t = t ^ (t >> 17);\n      xs32 = t ^ (t << 5);\n    end\n  endfunction\n\n  function automatic accept(input [31:0] s);\n    accept = (s[6:0] < 7'd100);\n  endfunction\n\n  // State after the two draws of the current cycle.\n  logic [31:0] state;\n  logic [31:0] next_i, next_d;\n  assign next_i = xs32(state);\n  assign next_d = xs32(next_i);\n\n  // Reset values: state after the two draws of cycle 0, and the accept\n  // bits of those two draws (seed 0xDEADBEEF; see test_bench_stall_gen.py).\n  always_ff @(posedge clock or posedge reset) begin\n    if (reset) begin\n      state      <= 32'h8E1D9142;\n      imem_ready <= 1'b1;\n      dmem_ready <= 1'b1;\n    end else begin\n      state      <= next_d;\n      imem_ready <= accept(next_i);\n      dmem_ready <= accept(next_d);\n    end\n  end\n\nendmodule\n35:// bench_cycles = stop - start, excluding init/CRC-printing overhead.\n50:// ~22% stall). Replicating exactly so CoreMark/MHz numbers from this\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n66:    uint64_t maxcycles = argc > 2 ? atoll(argv[2]) : 50000000ULL;\n68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\n69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\n74:    bool istall = false;\n75:    bool dstall = false;\n78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\n79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\n113:    for(uint64_t cycle=0; cycle<maxcycles; cycle++) {\n118:        // slowed down by unrelated stalls.\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n","exit_code":0,"status":"completed"}}
