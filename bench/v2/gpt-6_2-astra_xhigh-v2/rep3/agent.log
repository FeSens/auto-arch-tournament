{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c \"sed -n '330,595p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def predicted_loop_and_jumps(dut):\n    program = [\n        ADDI(2, 0, 3), ADDI(1, 1, 1),\n        BEQ(0, 0, 8), SW(1, 0, 64),     # forward branch learns taken\n        BLT(1, 2, -12),                  # back to the increment\n        JAL(5, 8), SW(1, 0, 68),\n        ADDI(6, 5, 17), JALR(7, 6, 0),   # forwarded 41, target 40\n        SW(1, 0, 72), ADDI(8, 7, 1), EBREAK(),\n    ]\n    fetches = []\n    rets, dmem = await _run(dut, program, fetch_trace=fetches)\n    expected = [0, 4, 8, 16, 4, 8, 16, 4, 8, 16, 20, 28, 32, 40, 44]\n    assert [r[\"pc\"] for r in rets] == expected\n    assert [r[\"pc_next\"] for r in rets[:-1]] == expected[1:]\n    # The first forward branch misses, both later iterations hit. At exit\n    # there is one speculative fetch of the loop body before recovery.\n    requests = [0, 4, 8, 12, 16, 4, 8, 16, 4, 8, 16, 4, 20, 28, 32, 36, 40, 44]\n    assert fetches[:len(requests)] == requests\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 1, 2, 1, 1, 1, 1, 1, 1, 2, 1, 1, 2, 1]\n    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"rd\"] in (5, 7, 8)] == [\n        (5, 24), (7, 36), (8, 37),\n    ]\n    assert not dmem and all(r[\"mem_wmask\"] == 0 for r in rets)\n\n\n@cocotb.test()\nasync def aliasing_branch_updates(dut):\n    # All four branch PCs share PC[7:2]. At 320 the count rises from 2 to 3\n    # as 576 is fetched. Its opposite outcome should take 3 back to 2.\n    pr\n…[7230 of 10302 chars elided by tools/bench/transcript.py; sha256:1734dbd951373134]…\n = 0\n\n    def fetch_ready(pc):\n        nonlocal visits, parked\n        if pc == 40:\n            program[68] = ADDI(2, 2, 10)\n        if pc == 52:\n            parked += 1\n            return parked > 512\n        if pc == 64:\n            visits += 1\n            requests.append(0)\n        if pc == 68:\n            requests[-1] += 1\n            return visits == 1 or (visits >= 3 and requests[-1] > 3)\n        return True\n\n    rets, _ = await _run(dut, program, after_sweep=True, imem_ready=fetch_ready,\n                         max_cycles=600)\n    assert requests == [1, 1, 4, 4]\n    assert parked == 513\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 68] == [1, 2, 12, 22]\n    assert [r[\"pc\"] for r in rets if r[\"insn\"] == 0x0000100f] == [40]\n\n\n@cocotb.test()\nasync def invalid_direct_targets(dut):\n    program = {\n        0: JAL(0, 120),\n        120: _b(-8, 0, 0, 2, 0x63), 124: _b(-8, 0, 0, 3, 0x63),\n        128: BEQ(0, 0, -2), 132: BNE(0, 0, -2),\n        136: JAL(9, 2), 140: ADDI(10, 0, 151), 144: JALR(9, 10, 0),\n", "exit_code": 0, "status": "completed"}}
