{"type":"item.completed","item":{"id":"item_107","type":"command_execution","command":"/bin/bash -c \"git status --short && git check-ignore -v cores/bench/implementation_notes.md && sed -n '130,220p' cores/bench/rtl/alu.sv\"","aggregated_output":" M cores/bench/rtl/alu.sv\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/mem_stage.sv\n M cores/bench/test/test_alu.py\n M cores/bench/test/test_pipeline.py\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\n  assign clz_b[1] = norm4[31:30] == 0;\n  assign norm2 = clz_b[1] ? norm4 << 2 : norm4;\n  assign clz_b[0] = !norm2[31];\n  assign normalized = clz_b[0] ? norm2 << 1 : norm2;\n\n  // Lower-bound reciprocal at the upper end of each of 512 bins.\n  // The division in this ROM initializer is evaluated at elaboration.\n  logic [11:0] seed [0:511];\n  initial begin\n    for (int i = 0; i < 512; i++)\n      seed[i] = 12'(2097152 / (513 + i));\n  end\n\n  logic [33:0] recip_q;       // R scaled by S = 2^34\n  logic [34:0] factor_q;      // E can exceed S\n  logic [31:0] quotient_q, residual_q;\n  logic signed [35:0] dsp_a, dsp_b;\n  // The largest refinement needs bits 67:34. RV32M uses bits 63:0.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [71:0] product;\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  // Passes 1, 3 and 5 all multiply the staged operand by the reciprocal.\n  // Pass 0 reads the seed and has no DSP consumer.\n  logic use_normalized, use_factor, use_quotient;\n  assign use_normalized = busy_q && pass_q[0];\n  assign use_factor     = busy_q && (pass_q == 3'd2 || pass_q == 3'd4);\n  assign use_quotient   = busy_q && pass_q == 3'd6;\n  assign dsp_a = ({36{!busy_q}} & operand_a_q)\n               | ({36{use_normalized}} & {4'b0, normalized_q})\n               | ({36{use_factor}} & {1'b0, factor_q})\n               | ({36{use_quotient}} & {4'b0, quotient_q});\n  assign dsp_b = busy_q && pass_q != 3'd6 ? {2'b0, recip_q} : operand_b_q;\n  assign product = dsp_a * dsp_b;\n  assign mem_product = mul_high_q ? product[63:32] : product[31:0];\n\n  always_ff @(posedge clock) begin\n    if (busy_q) begin\n      case (pass_q)\n        3'd0: begin\n          normalized_q <= normalized;\n          k_q          <= ~clz_b;\n          recip_q      <= {seed[normalized[30:22]], 22'b0};\n        end\n        // E = 2*S - 1 - floor(D*R / 2^31), then R = floor(R*E / S).\n        3'd1, 3'd3: factor_q   <= ~product[65:31];\n        3'd2, 3'd4: begin\n          recip_q <= product[67:34];\n          // D's last use was in pass 3. Stage A for the quotient multiply.\n          if (pass_q == 3'd4)\n            normalized_q <= dividend >> k_q;\n        end\n        3'd5:       quotient_q <= product[65:34];\n        3'd6:       residual_q <= dividend - product[31:0];\n        default: ;\n      endcase\n    end\n  end\n\n  // For B > 0 the shift discards at most 2^k - 1 dividend units. With the\n  // reciprocal error, the underestimate is below (2^k - 1 + 0.91) / 2^k.\n  // The trial quotient is at most one low. The residual uses the full A.\n  logic        correct;\n  logic [32:0] residual_minus_divisor;\n  logic [31:0] unadjusted;\n  logic        increment;\n  assign residual_minus_divisor = {1'b0, residual_q} - {1'b0, divisor};\n  assign correct    = !residual_minus_divisor[32];\n  assign unadjusted = want_rem_q ? (correct ? residual_minus_divisor[31:0] : residual_q)\n                                 : quotient_q;\n  // -(Q+1) is ~Q. Fold the quotient correction into the sign increment.\n  assign increment  = negate_q ^ (correct && !want_rem_q);\n  // At B=0 the residual is A and the remainder correction subtracts zero.\n  assign div_result = zero_q && !want_rem_q ? 32'hffff_ffff\n                    : (unadjusted ^ {32{negate_q}}) + {31'b0, increment};\n`endif\n\nendmodule\n","exit_code":0,"status":"completed"}}
