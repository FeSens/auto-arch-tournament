─────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = ({32{fwd_rs1_sel[0]}} & in.rs1_val)\n             | ({32{fwd_rs1_sel[1]}} & fwd_ex_mem)\n             | ({32{fwd_rs1_sel[2]}} & fwd_mem_wb);\n  assign rs2 = ({32{fwd_rs2_sel[0]}} & in.rs2_val)\n             | ({32{fwd_rs2_sel[1]}} & fwd_ex_mem)\n             | ({32{fwd_rs2_sel[2]}} & fwd_mem_wb);\n\n  // ── ALU operand selection ──────────────────────\n…[12018 of 15090 chars elided by tools/bench/transcript.py; sha256:b08bec96dc6f5795]…\ne.MULTILINE)\n90:        raise RuntimeError(f\"ITERATIONS not found in {path}\")\n211:    # 50M cycle ceiling: 2K CoreMark with ITERATIONS=10 + iStall+dStall\n1:.PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\n53:CORE_TARGETS := lint test cosim cosim-build formal formal-deep fpga next loop\n80:\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\n81:\t@echo \"  make formal-deep TARGET=v1 — full formal suite without ALTOPS (slow, bitvector-correct)\"\n107:\tpytest -v $(TEST_DIR)/\n110:\tpytest -v tools/\n121:formal:\n122:\tbash formal/run_all.sh formal/checks.cfg\n124:# formal-deep: same checks WITHOUT RISCV_FORMAL_ALTOPS so bitwuzla\n127:# orchestrator's per-iteration formal gate uses fast `make formal`.\n128:# See formal/checks.cfg comments for the full ALTOPS scope explanation.\n129:formal-deep:\n130:\tbash formal/run_all.sh formal/checks-deep.cfg\n162:\t  [ -e \"$(WT_PATH)/formal/riscv-formal\" ] || ln -s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\n", "exit_code": 0, "status": "completed"}}
