{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil\ns=Path(os.environ['TMPDIR'])/'mulreg'\nfor variant in ('agu','agubase','agu_wb'):\n rtl=s/variant\n shutil.copytree({'agu':s/'cores/bench/rtl','agu_wb':s/'unified','agubase':Path('cores/bench/rtl')}[variant],rtl,dirs_exist_ok=True)\n f=rtl/'core_pkg.sv';t=f.read_text().replace('    logic        is_mul;', '    logic [31:0] mem_addr;\\\\n    logic        is_mul;')\n f.write_text(t)\n f=rtl/'ex_stage.sv';t=f.read_text().replace('      reg_q.is_mul        <= is_mul;', '      reg_q.mem_addr      <= rs1 + in.imm;\\\\n      reg_q.is_mul        <= is_mul;')\n f.write_text(t)\n f=rtl/'mem_stage.sv';t=f.read_text().replace('in.alu_result','in.mem_addr').replace('mem_product : in.mem_addr;', 'mem_product : in.alu_result;')\n f.write_text(t)\n\n# A spatially specialized, two-stage reciprocal refinement loop.\nrtl=s/'pipe_nr'\nshutil.copytree(s/'cores/bench/rtl',rtl,dirs_exist_ok=True)\nf=rtl/'alu.sv'\nt=f.read_text()\ni=t.index('  logic [31:0] quotient_q, residual_q, scaled_a_q;')\nj=t.index('  // For nonzero B',i)\nt=t[:i]+'''  logic [31:0] quotient_q, residual_q, scaled_a_q;\n  logic [33:0] recip_q;\n  logic [34:0] factor_q;\n  logic [31:0] x_q;\n  logic [65:0] nr_product, scale_product;\n  logic [68:0] update_product;\n  logic [31:0] q_times_b;\n  logic signed [71:0] mul_product;\n\n  assign mul_product = operand_a_q * operand_b_q;\n  assign mem_product = mul_high_q ? mul_product[63:32] : mul_product[31:0];\n  assign nr_product = normalized_q * recip_q;\n  assign update_product = factor_q * recip_q;\n  assign scale_product = x_q * recip_q;\n  assign q_times_b = quotient_q * divisor;\n\n  always_ff @(posedge clock) begin\n    if (mul_issue) begin\n      operand_a_q <= {{4{a[31] && (op == ALU_MULH || op == ALU_MULHSU)}}, a};\n      operand_b_q <= {{4{b[31] && op == ALU_MULH}}, b};\n    end\n    if (busy_q) begin\n      case (pass_q)\n        3'd0: begin\n          normalized_q <= normalized;\n          k_q <= ~clz_b;\n          recip_q <= {seed[normalized[30:22]], 22'b0};\n        end\n        3'd1, 3'd3: factor_q <= ~nr_product[65:31];\n        3'd2, 3'd4: recip_q <= update_product[67:34];\n        3'd5: quotient_q <= scale_product[65:34];\n        3'd6: residual_q <= dividend - q_times_b;\n        default: ;\n      endcase\n      if (pass_q == 3'd2)\n        x_q <= dividend >> k_q;\n    end\n  end\n\n'''+t[j:]\nf.write_text(t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
