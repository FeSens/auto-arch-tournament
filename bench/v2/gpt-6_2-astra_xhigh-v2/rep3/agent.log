{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c 'cat bench/programs/link.ld && head -37 bench/programs/selftest.S && tail -12 bench/programs/selftest.S'","aggregated_output":"MEMORY {\n  FLASH (rx)  : ORIGIN = 0x00000000, LENGTH = 128K\n  RAM   (rwx) : ORIGIN = 0x00020000, LENGTH = 64K\n}\nSECTIONS {\n  .text : { *(.text.start) *(.text*) } > FLASH\n  .rodata : { *(.rodata*) } > FLASH\n  .data : { *(.data*) } > RAM AT > FLASH\n  .bss  : { *(.bss*) *(COMMON) } > RAM\n  _stack_top = ORIGIN(RAM) + LENGTH(RAM);\n}\n# Minimal selftest: exercises ALU, load/store (including sub-word), branches.\n# Terminates with ebreak on success, loops on failure.\n.section .text.start\n.global _start\n_start:\n    # Set up stack\n    la   sp, _stack_top\n\n    # ---- ALU ----\n    li   t0, 10\n    li   t1, 3\n    add  t2, t0, t1       # t2 = 13\n    li   t3, 13\n    bne  t2, t3, fail\n\n    sub  t2, t0, t1       # t2 = 7\n    li   t3, 7\n    bne  t2, t3, fail\n\n    mul  t2, t0, t1       # t2 = 30\n    li   t3, 30\n    bne  t2, t3, fail\n\n    # ---- SW / LW ----\n    la   a0, scratch\n    li   t0, 0xDEADBEEF\n    sw   t0, 0(a0)\n    lw   t1, 0(a0)\n    bne  t0, t1, fail\n\n    # ---- SH / LH at halfword offset 0 ----\n    li   t0, 0x1234\n    sh   t0, 0(a0)\n    lhu  t1, 0(a0)\n    bne  t0, t1, fail\n\n    # ---- SH / LH at halfword offset 2 (offset 2 within word) ----\njal_target:\n    jalr zero, ra, 0\nafter_jal:\n\n    # ---- Success ----\n    ebreak\n\nfail:\n    j    fail\n\n.section .bss\nscratch: .word 0\n","exit_code":0,"status":"completed"}}
