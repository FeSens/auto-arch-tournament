3OaqpY/../../ins\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\n…[8490 of 11562 chars elided by tools/bench/transcript.py; sha256:2e85eeb12807d1c5]…\nests)] == requests\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 1, 2, 1, 1, 1, 1, 1, 1, 2, 1, 1, 2, 1]\n    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"rd\"] in (5, 7, 8)] == [\n        (5, 24), (7, 36), (8, 37),\n    ]\n    assert not dmem and all(r[\"mem_wmask\"] == 0 for r in rets)\n\n\n@cocotb.test()\nasync def aliasing_branch_updates(dut):\n    # All four branch PCs share PC[7:2]. At 320 the count rises from 2 to 3\n    # as 576 is fetched. Its opposite outcome should take 3 back to 2.\n    program = {\n        0: JAL(0, 64),\n        64: BEQ(0, 0, 256), 68: SW(0, 0, 64),\n        320: BEQ(0, 0, 256), 324: SW(0, 0, 68),\n        576: BNE(0, 0, 12), 580: JAL(0, 252), 588: SW(0, 0, 72),\n        832: BEQ(0, 0, 12), 836: SW(0, 0, 76), 844: EBREAK(),\n    }\n    fetches = []\n    rets, dmem = await _run(dut, program, fetch_trace=fetches)\n    assert fetches[:9] == [0, 64, 68, 320, 576, 588, 580, 832, 844]\n    assert [r[\"pc\"] for r in rets] == [0, 64, 320, 576, 580, 832, 844]\n", "exit_code": 0, "status": "completed"}}
