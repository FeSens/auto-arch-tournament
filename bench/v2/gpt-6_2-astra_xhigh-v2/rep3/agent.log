{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/earlyload.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os,sys\nopt=sys.argv[1]\nrtl=Path(os.environ['TMPDIR'])/opt/'rtl'\ncopytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\nc=rtl/'core.sv'; s=c.read_text()\ne=rtl/'mem_stage.sv'; t=e.read_text()\nnew=\\\"\\\"\\\"  logic early_confirm_q;\n  logic [31:0] raw_early_q;\n  always_ff @(posedge clock) if (\"'!stall_ex_mem) begin\n    early_confirm_q <= early_hit;\n    raw_early_q <= early_row_q.word_data;\n  end\n\"\"\"\nif opt.startswith('\"'retry'):\n new+=\\\"\\\"\\\"\n  logic retry_hit_q;\n  logic [31:0] retry_raw_q;\n  always_ff @(posedge clock) begin\n    if (reset || \"'!stall_ex_mem)\n      retry_hit_q <= 1'\"'b0;\n    else if (read_request) begin\n      retry_hit_q <= resolved_hit;\n      retry_raw_q <= resolved_row_q.word_data;\n    end\n  end\n  assign io_dmemREn = read_request && \"'!early_confirm_q && !retry_hit_q;\n  assign read_word = early_confirm_q ? raw_early_q : retry_hit_q ? retry_raw_q : io_dmemRData;\n\"\"\"\nelse:\n new+=\"\"\"\n  assign io_dmemREn = read_request && !early_confirm_q;\n  assign read_word = early_confirm_q ? raw_early_q : io_dmemRData;\n\"\"\"\ns=s.replace(\"  assign io_dmemREn = read_request && !resolved_hit;'\"\\\\n  assign read_word  = resolved_hit ? resolved_row_q.word_data : io_dmemRData;\\\",new)\neopt=opt.endswith('f')\nif eopt:\n # Architectural WB for confirmed early hit is already in EX/MEM.alu_result.\n t=t.replace('  input  logic               hold_wb,','  input  logic               hold_wb,\\\\n  input logic early_confirm,\\\\n  input logic [31:0] late_word,')\n t=t.replace('format_load(read_word,','format_load(late_word,').replace('in.ctrl.mem_to_reg);','(in.ctrl.mem_to_reg && \"'!early_confirm));'\"').replace('{32{in.ctrl.mem_to_reg}}','{32{in.ctrl.mem_to_reg && \"'!early_confirm}}'\"')\n s=s.replace('.hold_wb    (hold_mem_wb),','.hold_wb    (hold_mem_wb),\\\\n    .early_confirm(early_confirm_q),\\\\n    .late_word('+('retry_hit_q ? retry_raw_q : io_dmemRData' if opt.startswith('retry') else 'io_dmemRData')+'),')\nc.write_text(s);e.write_text(t)\nPY\ncat > \\\"\"'$TMPDIR/simone.sh\" <<'\"'SH'\nset -e\ncfg=\\\"\"'$1\"\nNRET=1 RTL_DIR=\"$TMPDIR/$cfg/rtl\" OBJ_DIR=\"$TMPDIR/$cfg/obj\" bash test/cosim/build.sh > \"$TMPDIR/$cfg/compile.log\" 2>&1\n\"$TMPDIR/$cfg/obj/cosim_sim\" \"$TMPDIR/coremark.elf\" 50000000 --bench --istall --dstall > \"$TMPDIR/$cfg/bench.log\"\ntail -1 \"$TMPDIR/$cfg/bench.log\"\nSH\npython \"$TMPDIR/earlyload.py\" onlyf && python \"$TMPDIR/earlyload.py\" retryf && python \"$TMPDIR/earlyload.py\" only'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
