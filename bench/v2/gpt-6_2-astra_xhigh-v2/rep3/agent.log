{"type":"item.completed","item":{"id":"item_33","type":"agent_message","text":"The carry prototype passed CoreMark’s CRC checks, but its median Fmax fell to 83.557 MHz. I’ll test a fetch predictor that can choose the next PC before the instruction RAM returns its word. That removes a timing dependency seen in several recent placements."}}
{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/ec844b20/c1469452/predictor-round.OWgH9o/build_fetch.py' <<'PY'\nfrom pathlib import Path\nimport sys,shutil\np=Path(__file__).parent\ndst=p/sys.argv[1]\nsrc=Path.cwd()/'cores/bench/rtl'\nshutil.copytree(src,dst,dirs_exist_ok=True)\ndef edit(f,ls):\n s=(dst/f).read_text()\n for a,b in ls:\n  assert a in s,a\n  s=s.replace(a,b)\n (dst/f).write_text(s)\nn=int(sys.argv[2])\niwidth=int(sys.argv[3])\n# size in log2 words\nw=n+1\nv=iwidth+1\nf=dst/'if_stage.sv'\nhdr=f.read_text().split('  logic [31:0] held_pc_q')[0].replace('  input  logic [31:0]       mem_instr,','''  input  logic [31:0]       mem_instr,\n  input  logic [31:0]       mem_next, mem_direct,\n  input  logic              mem_branch, mem_jump, mem_jalr, mem_trap,''')\nf.write_text(hdr+f'''\n  typedef struct packed {{\n    logic valid;\n    logic [{17-n}:0] tag;\n    logic cond, backwards;\n    logic [17:0] target;\n  }} btb_t;\n  (* syn_ramstyle=\\\"distributed_ram\\\" *) btb_t btb[0:{(1<<n)-1}];\n  logic [1:0] counters [0:63];\n  typedef struct packed {{\n    logic valid;\n    logic [{17-iwidth}:0] tag;\n    logic [31:0] instr;\n  }} cache_line_t;\n  cache_line_t ic [0:{(1<<iwidth)-1}];\n  cache_line_t line_q;\n  logic [31:0] pc, next_pc, predicted_pc_q, held_pc_q;\n  logic [31:0] instr, held_instr_q, pc4;\n  logic [31:0] target_for_training;\n  logic keep, held_hit_q, hit, ramhit, cache_ok_q, bank_ok;\n  logic [1:0] count;\n  logic [17:0] read_word_q;\n  logic [{iwidth-1}:0] read_index;\n  logic [{max(n,iwidth)-1}:0] sweep_index;\n  logic clear_tables, fill, update_btb, mem_ok, taken;\n  logic reset_q, hold_q;\n  btb_t entry;\n  logic [31:0] read_pc;\n\n  initial for(int i=0; i<64; i++) counters[i] = 2'b01;\n  assign mem_ok = mem_pc[31:20]==0 && mem_pc[1:0]==0;\n  assign target_for_training = mem_jalr ? mem_next : mem_direct;\n  assign fill = mem_transfer && mem_ok;\n  assign update_btb = fill && (mem_branch || mem_jump) && \"'!mem_trap &&\n                      target_for_training[31:20]==0 && target_for_training[1:0]==0;\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) begin\n      clear_tables <= 1'\"'b1;\n      sweep_index <= '0;\n    end else if (clear_tables) begin\n      sweep_index <= sweep_index + 1'b1;\n      if (&sweep_index) clear_tables <= 1'b0;\n    end\n    if (train_en) counters[train_index] <= train_value;\n    if (clear_tables || update_btb)\n      btb[clear_tables ? sweep_index[{n-1}:0] : mem_pc[{w}:2]] <=\n        {{\"'!clear_tables,mem_pc[19:{w+1}],mem_branch,mem_instr[31],target_for_training[19:2]}};\n    if (clear_tables || fill)\n      ic[clear_tables ? sweep_index[{iwidth-1}:0] : mem_pc[{v}:2]] <=\n        {{!clear_tables, mem_pc[19:{v+1}], mem_instr}};\n    line_q <= ic[read_index];\n    read_word_q <= read_pc[19:2];\n    cache_ok_q <= !clear_tables && read_pc[31:20] == 0 && read_pc[1:0]==0 &&\n                  !(fill && mem_pc[{v}:2] == read_index);\n  end\n\n  assign keep = hold_q || replay;\n  assign pc = reset_q ? 0 : redirect ? resolved_pc : keep ? held_pc_q : predicted_pc_q;\n  assign pc4 = {{pc[31:16]+16'\"'(&pc[15:2]),pc[15:0]+16'd4}};\n  assign entry = btb[pc[{w}:2]];\n  assign count = counters[pc[7:2]];\n  assign taken = \"'!clear_tables && pc[31:20]==0 && entry.valid &&\n                 entry.tag==pc[19:{w+1}] && (!entry.cond || (entry.backwards ''^ count[1]));\n  assign next_pc = taken ? {{12'\"'b0,entry.target,2'b0}} : pc4;\n  assign read_pc = stall ? pc : next_pc;\n  assign read_index = read_pc[{v}:2];\n  assign bank_ok = \"'!clear_tables && pc[31:20]==0 && pc[1:0]==0;\n  assign ramhit = bank_ok && cache_ok_q && line_q.valid && line_q.tag==pc[19:{v+1}] &&\n                  pc[19:2]==read_word_q;\n  assign hit = bank_ok && !redirect && keep && held_hit_q;\n  assign instr = imem_ready ? imem_data : hit ? held_instr_q : line_q.instr;\n  always_ff @(posedge clock) begin\n    reset_q <= reset;\n    hold_q <= stall;\n    held_pc_q <= pc;\n    held_instr_q <= instr;\n    held_hit_q <= bank_ok && (imem_ready || hit || ramhit);\n    predicted_pc_q <= next_pc;\n    if (!stall_id) begin\n      forecast_used <= taken;\n      forecast_pc <= {{12'\"'b0,entry.target,2'b0}};\n      fallthrough_q <= pc4;\n    end\n  end\n  assign imem_addr = pc;\n  always_comb begin\n    out.pc = pc;\n    out.instr = instr;\n    out.valid = imem_ready || hit || ramhit;\n    out.train_count = train_en && train_index==pc[7:2] ? train_value : count;\n  end\nendmodule\n''')\nedit('core.sv',[('    .mem_instr       (ex_mem_w.instr),','''    .mem_instr       (ex_mem_w.instr),\n    .mem_next(ex_mem_w.pc_next), .mem_direct(ex_mem_w.branch_target),\n    .mem_branch(ex_mem_w.ctrl.is_branch), .mem_jump(ex_mem_w.ctrl.is_jump),\n    .mem_jalr(ex_mem_w.ctrl.is_jalr), .mem_trap(ex_mem_w.ctrl.is_illegal),''')])\nedit('ex_stage.sv',[('check_q          <= advancing && (in.ctrl.is_jump || in.ctrl.is_branch);','check_q          <= advancing;')])\nPY\npython '/srv/hwebench/tmp/ec844b20/c1469452/predictor-round.OWgH9o/build_fetch.py' fetch1 7 10\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
