{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"cat formal/wrapper_si.sv; cat cores/bench/core.yaml; cat tools/eval/gowin.py | head -270; ls -la formal; env | rg '\"'^(RISCV|GOWIN|VIRTUAL_ENV|FORMAL|YOSYS|PATH|PYTHON|MAKE)'\"'\"", "aggregated_output": "// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[11747 of 14819 chars elided by tools/bench/transcript.py; sha256:232f25f7ebc2fa65]…\n 4096 Nov 21 02:19 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 21 02:20 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 21 02:19 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 21 02:19 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 21 02:19 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    68 Nov 21 02:19 riscv-formal -> /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep3/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 21 02:19 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 21 02:19 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 21 02:19 wrapper_si.sv\nGOWIN_HOME=/opt/gowin\nPATH=/srv/hwebench/cli/codex-0.170.0/codex-pkg/codex-path:/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep3/.codex-home/tmp/arg0-linux/codex-arg00q6SjD:/srv/hwebench/cli/codex-0.170.0:/srv/hwebench/bin:/srv/hwebench/venv/bin:/srv/hwebench/local/bin:/srv/hwebench/toolchain/oss-cad-suite/bin:/srv/hwebench/toolchain/bin:/srv/hwebench/venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\nPYTHONUSERBASE=/srv/hwebench/local\n", "exit_code": 0, "status": "completed"}}
