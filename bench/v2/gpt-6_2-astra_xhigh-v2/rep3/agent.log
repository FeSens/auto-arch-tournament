mainder;\n  logic [4:0] k_q, k;\n  logic [34:0] recip_q, error_q;\n  logic [11:0] seeds [0:511];\n  for (genvar i=0; i<512; i=i+1) begin : seed_table\n    assign seeds[i] = 12'(2097152/(513+i));\n  end\n  always_comb begin\n    k = '0;\n    for (int j=0; j<32; j++) if (mag_b[j]) k=5'(j);\n    norm = mag_b << (~k);\n  end\n  logic neg_a, neg_b, negative_q, rem_q;\n  logic [31:0] corrected;\n  assign neg_a = (op==ALU_DIV || op==ALU_REM) && a[31];\n  assign neg_b = (op==ALU_DIV || op==ALU_REM) && b[31];\n  logic signed [35:0] mul_a_q, mul_b_q, lhs, rhs;\n  logic signed [71:0] prod;\n  logic high_q;\n  always_ff @(posedge clock) begin\n    if (mul_req) begin\n      mul_a_q <= {{4{a[31] && (op==ALU_MULH || op==ALU_MULHSU)}},a};\n      mul_b_q <= {{4{b[31] && op==ALU_MULH}},b};\n      high_q <= op\"'!=ALU_MUL;\n    end\n  end\n  always_comb begin\n    lhs=mul_a_q;\n    rhs=mul_b_q;\n    if (busy_q) begin\n      case(pass_q)\n        1,3: begin lhs={4'\"'b0,norm_q}; rhs={1'b0,recip_q}; end\n        2,4: begin lhs={1'b0,recip_q}; rhs={1'b0,error_q}; end\n        5: begin lhs={4'b0,mag_a}; rhs={1'b0,recip_q}; end\n        default: begin lhs={4'b0,q_est}; rhs={4'b0,mag_b}; end\n      endcase\n    end\n  end\n  assign prod=lhs*rhs;\n  assign mul_result=high_q ? prod[63:32] : prod[31:0];\n  always_ff @(posedge clock) begin\n    if (div_req_ready && div_req_valid) begin\n      mag_a <= neg_a ? -a : a;\n      mag_b <= neg_b ? -b : b;\n      original_a <= a;\n      rem_q <= op == ALU_REM || op == ALU_REMU;\n      negative_q <= (op == ALU_REM || op == ALU_REMU) ? neg_a : neg_a \"'^ neg_b;\n    end\n    if (busy_q) begin\n      case(pass_q)\n        0: begin\n          norm_q <= norm;\n          k_q <= k;\n          recip_q <= {1'\"'b0,seeds[norm[30:22]],22'b0};\n        end\n        1,3: error_q <= ~prod[65:31];\n        2,4: recip_q <= prod[68:34];\n        5: q_est <= prod[65:34] >> k_q;\n        6: remainder <= mag_a-prod[31:0];\n        default: ;\n      endcase\n    end\n  end