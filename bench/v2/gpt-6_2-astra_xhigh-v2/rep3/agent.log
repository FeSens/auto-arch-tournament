,NOP(),NOP(),\n             LW(5,10,0),ADDI(6,5,1),EBREAK()]\n    wait=[0]; accepted=[]\n    def bus(ren,wen,addr,wdata):\n        if ren:\n            wait[0]+=1\n            if wait[0]<3:return False\n        if wen:accepted.append((addr,wen))\n        return True\n    rets,mem=await _run(dut,program,{word+high:42},dmem_ready=bus,after_sweep=True)\n    assert [i['insn'] for i in rets]==program\n    assert [i['order'] for i in rets]==list(range(len(program)))\n    assert rets[6]['rd_wdata']==42 and rets[7]['pc_next']==32\n    assert accepted==[(word,15),(word+4,15),(word+1,2)]\n    assert mem[word]==0x700 and rets[-2]['rd_wdata']==0x701\n'''\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/stride/checks.py\" shaped'", "aggregated_output": "", "exit_code": 0, "status": "completed"}}
