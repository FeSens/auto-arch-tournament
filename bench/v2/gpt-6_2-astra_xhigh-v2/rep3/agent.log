bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\ntotal 20\ndrwxr-xr-x 4 nobody nogroup 4096 Sep 28 02:57 .\ndrwxr-xr-x 5 nobody nogroup 4096 Sep 28 05:13 ..\n-rw-r--r-- 1 nobody nogroup    1 Sep 28 02:57 .gitignore\n-rw-r--r-- 1 nobody nogroup    0 Sep 28 02:57 .lock\ndrwxr-xr-x 2 nobody nogroup 4096 Sep 28 02:57 .temp\nlrwxrwxrwx 1 nobody nogroup   48 Sep 28 02:57 cpython-3.13-linux-x86_64-gnu -> /opt/hwe-python/cpython-3.13.12-linux-x86_64-gnu\ndrwxr-xr-x 6 nobody nogroup 4096 Sep 28 02:57 cpython-3.13.12-linux-x86_64-gnu\npytest is /srv/hwebench/venv/bin/pytest\npytest is /srv/hwebench/venv/bin/pytest\npython3 is /srv/hwebench/venv/bin/python3\npython3 is /srv/hwebench/venv/bin/python3\npython3 is /usr/bin/python3\npython3 is /bin/python3\n/bin/bash: line 1: type: riscv64-unknown-elf-gcc: not found\nriscv32-unknown-elf-gcc is /srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n2.0.1\nGOWIN_HOME=/opt/gowin\nPATH=/srv/hwebench/cli/codex-0.170.0/codex-pkg/codex-path:/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep3/.codex-home/tmp/arg0-linux/codex-arg0KZHtjL:/srv/hwebench/c