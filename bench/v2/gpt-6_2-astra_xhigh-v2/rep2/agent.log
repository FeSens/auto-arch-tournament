{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"cat formal/wrapper_si.sv | head -170 && rg -n 'mem|stall' formal/run_all.sh | head -30\"","aggregated_output":"// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n        .io_rvfi_trap_0     (rvfi_trap),\n        .io_rvfi_halt_0     (rvfi_halt),\n        .io_rvfi_intr_0     (rvfi_intr),\n        .io_rvfi_mode_0     (rvfi_mode),\n        .io_rvfi_ixl_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/microprobe/redirect.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\np=Path(os.environ['TMPDIR'])/'microprobe'\nbase=Path('cores/bench/rtl')\nfor name in ('redir','prev','split'):\n rtl=p/name/'rtl'\n shutil.copytree(base,rtl,dirs_exist_ok=True)\n f=rtl/'core.sv'\n s=f.read_text(); idx=s.index('  hazard_unit u_hazard')\n s=s[:idx]+s[idx:].replace('    .redirect       (redirect),\\\\n','')\n f.write_text(s)\n f=rtl/'hazard_unit.sv'\n s=''.join(l for l in f.read_text().splitlines(keepends=True) if 'input  logic       redirect,' not in l).replace(' || redirect || ', ' || ')\n f.write_text(s)\n f=rtl/'if_stage.sv'\n s=f.read_text()\n a=s.index('  logic [31:0] pc;')\n b=s.index('  always_comb begin',a)\n if name=='redir':\n  reg=\\\"\\\"\\\"  logic [31:0] pc;\n  assign imem_addr = redirect ? redirect_target : pc;\n  always_ff @(posedge clock) begin\n    if (reset)           pc <= RESET_PC;\n    else if (\"'!stall)     pc <= imem_addr + 32'\"'d4;\n    else if (redirect)   pc <= redirect_target;\n  end\n\\\"\\\"\\\"\n elif name=='prev':\n  reg=\\\"\\\"\\\"  logic [31:0] last_fetch;\n  logic          last_accepted;\n  assign imem_addr = redirect ? redirect_target : last_accepted ? last_fetch + 32'd4 : last_fetch;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      last_fetch    <= RESET_PC;\n      last_accepted <= 1'b0;\n    end else begin\n      last_fetch    <= imem_addr;\n      last_accepted <= \"'!stall;\n    end\n  end\n\"\"\"\n else:\n  reg=\"\"\"  logic [31:0] last_target, seq_pc;\n  logic          after_redirect;\n  logic          advance_target;\n  logic [31:0] fallback_pc;\n  assign fallback_pc = after_redirect ? (advance_target ? last_target + 32'\"'d4 : last_target) : seq_pc;\n  assign imem_addr = redirect ? redirect_target : fallback_pc;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      seq_pc          <= RESET_PC;\n      after_redirect  <= 1'b0;\n      advance_target  <= 1'b0;\n    end else begin\n      last_target    <= redirect_target;\n      after_redirect <= redirect;\n      advance_target <= \"'!stall;\n      seq_pc         <= stall ? fallback_pc : fallback_pc + 32'\"'d4;\n    end\n  end\n\\\"\\\"\\\"\n s=s[:a]+reg+'\\\\n'+s[b:].replace('out.pc    = pc;','out.pc    = imem_addr;')\n f.write_text(s)\nPY\npython \\\"\"'$TMPDIR/microprobe/redirect.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
