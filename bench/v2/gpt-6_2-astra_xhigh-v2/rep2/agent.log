inable_q <= 1'b0;\n    else if (!stall && ex_valid) begin\n      trainable_q   <= ex_pc[31:20] == 0 && ex_pc[1:0] == 0;\n      train_index_q <= ex_pc[10:2];\n    end\n    train_q <= !reset && !ex_fence_i && !clearing && !stall && imem_ready;\n    if (!stall) train_insn_q <\n…[1937 of 5009 chars elided by tools/bench/transcript.py; sha256:4ccd969dce31942f]…\n<= 1'b0;\n    end else if (!stall) begin\n      retry_pc      <= imem_addr;\n      target_q      <= redirect_target;\n      linear_q      <= fallthrough_pc;\n      redirect_q    <= redirect;\n      miss_target_q <= ex_valid && predicted_pc != redirect_target;\n      // On a denied ordinary fetch the bus PC was linear, but the word\n      // came from the row and must independently match the linear PC.\n      miss_linear_q <= ex_valid && ((row_usable && (ex_control || !imem_ready))\n                       ? saved_pc != fallthrough_pc : ex_control && |fallthrough_pc[31:20]);\n    end\n  end\n  assign annul = redirect_q ? miss_target_q : miss_linear_q;\n  assign imem_addr = ex_valid ? predicted_pc :\n                     annul ? (redirect_q ? target_q : linear_q) : retry_pc;\n\n  always_comb begin\n    out.pc    = imem_addr;\n    out.instr = imem_ready ? imem_data : row_q[31:0];\n    out.instr[19:15] = imem_ready ? imem_data[19:15] : early_q;\n    out.valid = !ex_fence_i && (imem_ready || (ex_valid && row_usable));\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
