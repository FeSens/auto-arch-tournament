{"type": "item.completed", "item": {"id": "item_75", "type": "command_execution", "command": "/bin/bash -c 'head -180 cores/bench/test/test_pipeline.py; cat \"$TMPDIR/latediv/cocotb.log\" | tail -4; tail -4 \"$TMPDIR/latediv/formal.log\"'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load forwarding, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b01\n…[4807 of 7879 chars elided by tools/bench/transcript.py; sha256:ca3310f084b6976a]…\n.get(da & ~3, 0) if dready else 0xDEADBEEF\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _check_trace(rets, pcs, insns):\n    assert [r[\"pc\"] for r in rets] == pcs\n...                                                                      [100%]\n3 passed in 14.75s\nSBY  7:37:15 [insn_bge_ch0] DONE (PASS, rc=0)\nSBY  7:37:15 [insn_jal_ch0] Writing '/srv/hwebench/tmp/3c491641/fbcb1a79/latediv/formal/riscv-formal/cores/bench-wZYmhaWnm/checks/insn_jal_ch0/src/defines.sv'.\nSBY  7:37:15 [insn_jal_ch0] Writing '/srv/hwebench/tmp/3c491641/fbcb1a79/latediv/formal/riscv-formal/cores/bench-wZYmhaWnm/checks/insn_jal_ch0/src/insn_jal_ch0.sv'.\nSBY  7:37:15 [insn_jal_ch0] Copy '/srv/hwebench/tmp/3c491641/fbcb1a79/latediv/formal/riscv-formal/cores/bench-wZYmhaWnm/../../checks/rvfi_macros.vh'", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,signal\nparents={}\nlabels={}\nfor p in Path('/proc').glob('[0-9]*'):\n try:\n  pid=int(p.name)\n  fields=p.joinpath('stat').read_text().rsplit(')',1)[1].split()\n  parents[pid]=int(fields[1])\n  cmd=p.joinpath('cmdline').read_bytes().split(b'\\\\0')\n  if len(cmd)>2 and cmd[1]==os.fsencode(Path(os.environ['TMPDIR'])/'hyp_formal.py') and cmd[2] in (b'membank',b'divmem'):\n   labels[pid]=cmd[2]\n except (ValueError,FileNotFoundError,ProcessLookupError,PermissionError): pass\nfor pid in parents:\n anc=pid\n while anc>0:\n  if anc in labels:\n   try: os.kill(pid,signal.SIGTERM)\n   except ProcessLookupError: pass\n   break\n  anc=parents.get(anc,0)\nprint('Stopped the two superseded scratch formal runs:',list(labels.values()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
