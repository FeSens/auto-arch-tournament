{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -c \"python3 -c '\nfrom pathlib import Path\nfrom subprocess import run\nimport os\ninitial = Path(\\\"formal/riscv-formal/cores/bench-wvO6ej8LG\\\")\nfinal = Path(\\\"cores/bench/rtl\\\")\ncommands = []\nfor directory, label in [(initial, \\\"gold\\\"), (final, \\\"gate\\\")]:\n    files = [directory / \\\"core_pkg.sv\\\", *sorted(p for p in directory.glob(\\\"*.sv\\\") if p.name not in (\\\"wrapper.sv\\\", \\\"core_pkg.sv\\\"))]\n    commands.extend([\\\"read_verilog -sv -DRISCV_FORMAL_ALTOPS \\\" + \\\" \\\".join(map(str, files)), \\\"hierarchy -top core\\\", \\\"proc\\\", \\\"flatten\\\", \\\"cd core\\\", \\\"connect -set io_dmemReady 1\\\", \\\"connect -set io_imemReady 1\\\", \\\"cd ..\\\", \\\"opt -full\\\", \\\"memory_map\\\", \\\"opt -full\\\", \\\"opt_clean -purge\\\", \\\"rename -hide core/w:*if_id* core/w:u_if.out core/w:u_id.in\\\", \\\"rename -top \\\" + label, \\\"design -stash \\\" + label])\ncommands.extend([\\\"design -copy-from gold gold\\\", \\\"design -copy-from gate gate\\\", \\\"equiv_make gold gate equiv\\\", \\\"hierarchy -top equiv\\\", \\\"opt_clean\\\", \\\"equiv_simple -seq 2\\\", \\\"equiv_induct -seq 2\\\", \\\"equiv_status -assert\\\"])\nwith (Path(os.environ[\\\"TMPDIR\\\"]) / \\\"ready-equivalence.log\\\").open(\\\"w\\\") as log:\n    raise SystemExit(run([\\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", \\\"; \\\".join(commands)], stdout=log, stderr=log).returncode)\n' && tail -n 6 \\\"\"'$TMPDIR/ready-equivalence.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
