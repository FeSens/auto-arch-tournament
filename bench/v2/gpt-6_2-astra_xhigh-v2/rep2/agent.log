{"type": "item.completed", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/bash -c \"sed -n '160,190p;286,312p;395,445p;490,560p' cores/bench/test/test_pipeline.py && ls -lt \\\"\"'$TMPDIR/microprobe/returnpcclean/formal-output.log\" && tail -5 \"$TMPDIR/microprobe/returnpcclean/formal-output.log\" && tail -5 \"$TMPDIR/microprobe/returnpcclean/timing/gowin_p1/gw.log\"'", "aggregated_output": "\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n        JAL(2, 8), store, ADDI(3, 2, 5), EBREAK(),\n    ]\n    fetches = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n        assert not (ren or wen), f\"discarded store issued a bus request at {addr:#x}\"\n        fetches.append(pc)\n        # At PC 4 the bus supplies a store while withholding ready. The\n        # two redirects see a ready store at PC 8 and an unready one at PC 16.\n        return (pc != 16 and (pc != 4 or fetches.count(4) > 3)), 1\n\n    rets, _ = await _run(dut, program, bus_ready=bus_ready, unready_instr=store)\n    assert fetches.count(4) == 4 and fetches.count(8) == fetches.count(16) == 1\n    pcs = [0, 4, 12, 20, 24]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(not (r[\"trap\"] or r[\"mem_wmask\"] \n…[3304 of 6376 chars elided by tools/bench/transcript.py; sha256:4f606473bd57783f]…\n        \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n-rw-rw----+ 1 hwebench hwebench 45094 Nov 20 05:14 /srv/hwebench/tmp/3c491641/abcc5258/microprobe/returnpcclean/formal-output.log\nSBY  5:14:46 [cover] engine_0: ##   0:00:05  Writing trace to Yosys witness file: engine_0/trace0.yw\nSBY  5:14:46 [insn_add_ch0] engine_0: ##   0:00:00  Skipping step 17..\nSBY  5:14:46 [insn_and_ch0] base: finished (returncode=0)\nSBY  5:14:46 [insn_andi_ch0] Writing '/srv/hwebench/tmp/3c491641/abcc5258/microprobe/returnpcclean/formal/riscv-formal/cores/bench-waRyUbzQD/checks/insn_andi_ch0/src/defines.sv'.\nSBY  5:14:46 [insn_and_ch0] prep: starting process \"cd insn_and_ch0/model; yosys -ql design_prep.logPhysical Constraint parsed completed\nRunning placement......\n[10%] Placement Phase 0 completed\n[20%] Placement Phase 1 completed\n[30%] Placement Phase 2 completed\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/microprobe/probetests.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil,sys\np=Path(os.environ['TMPDIR'])/'microprobe'/sys.argv[1]\nshutil.copytree('cores/bench/test',p/'test',dirs_exist_ok=True)\nf=p/'test/test_pipeline.py'\ns=f.read_text().replace('return (pc \"'!= 16 and (pc != 4 or fetches.count(4) > 3)), 1'\"','return not (pc == 4 and fetches.count(4) <= 3 or pc == 20 and fetches.count(20) <= 2), 1')\ns=s.replace('fetches.count(8) == fetches.count(16) == 1','fetches.count(8) == fetches.count(16) == 0\\\\n    assert fetches.count(20) == 3')\ns=s.replace('    assert r7[\\\"rd_wdata\\\"] == 42','    assert r7[\\\"rd_wdata\\\"] == 42\\\\n    assert r7[\\\"cycle\\\"] == rets[1][\\\"cycle\\\"] + 1')\ni=s.index('def test_pipeline_runner():')\ns=s[:i]+'''@cocotb.test()\nasync def stalled_store_with_redirect_and_target_retry(dut):\n    skipped_store = SW(1, 0, 0x4c)\n    program = [ADDI(1, 0, 17), SW(1, 0, 0x40), BEQ(1, 1, 8), skipped_store,\n               JAL(2, 8), skipped_store, ADDI(3, 2, 11), EBREAK()]\n    held = 0\n    writes = []\n    def ready(pc, addr, ren, wen, data):\n        nonlocal held\n        assert pc not in (12, 20)\n        assert not ren\n        if wen:\n            assert (pc, addr, wen, data) == (16, 0x40, 15, 17)\n            held += 1\n            if held <= 3:\n                return held & 1, 0\n            writes.append((addr, data))\n            return 0, 1\n        return 1, 1\n    rets, _ = await _run(dut, program, bus_ready=ready, unready_instr=skipped_store)\n    assert held == 4 and writes == [(0x40, 17)]\n    assert [r['pc'] for r in rets] == [0, 4, 8, 16, 24, 28]\n    assert [r['order'] for r in rets] == list(range(6))\n    assert rets[3]['rd_wdata'] == rets[4]['rs1_rdata'] == 20\n    assert rets[4]['cycle'] == rets[3]['cycle'] + 1\n    assert rets[4]['rd_wdata'] == 31\n\n\n@cocotb.test()\nasync def misaligned_redirects_fall_through(dut):\n    words = [ADDI(1, 0, 35), BEQ(1, 1, 2), BEQ(0, 1, 2),\n             JAL(2, 2), JALR(3, 1, 0), ADDI(4, 0, 78), EBREAK()]\n    rets,_ = await _run(dut, words)\n    assert [r['pc'] for r in rets] == list(range(0, 28, 4))\n    assert [r['insn'] for r in rets] == words\n    assert [r['trap'] for r in rets] == [0, 1, 0, 1, 1, 0, 0]\n    assert all(r['rd'] == 0 and r['pc_next'] == r['pc'] + 4 for r in rets if r['trap'])\n    assert rets[-2]['rd_wdata'] == 78\n\n\n'''+s[i:]\nf.write_text(s)\nPY\npython \\\"\"'$TMPDIR/microprobe/probetests.py\" returnpcclean\nprj=\"$TMPDIR/microprobe/returnpcclean\"\nPYTHONDONTWRITEBYTECODE=1 pytest -q \"$prj/test/test_pipeline.py\" > \"$prj/pipeline-tests.log\" 2>&1 && tail -4 \"$prj/pipeline-tests.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
