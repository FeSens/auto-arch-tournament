{"type": "item.started", "item": {"id": "item_59", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/early/testdesign.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nt=Path(os.environ['TMPDIR'])/'early/test/test_pipeline.py'\np=Path('cores/bench/test/test_pipeline.py').read_text()\np=p.replace('(6, 7, 9) else 1','(6, 7) else 1').replace('(20, 15, 5)', '(16, 15, 5)')\np=p.replace('(20, 0x44, 15, 37)','(12, 0x44, 15, 37)').replace('return 0, 1  # Accept the store and deny its younger branch\\\\'s target.', '''return 1, 1\n        if pc == 20 and fetches.count(20) == 1:\n            return 0, 1''').replace('[4, 8, 12] + [20] * 5 + [28]', '[4, 8] + [12] * 4 + [20] * 2 + [28]')\nstart=p.index('    jalr_fetches = 0')\nend=p.index('    rets, _ = await _run',start)\np=p[:start]+'''    jalr_fetches = 0\n    store_wait = 0\n    target_denied = False\n    writes = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n        nonlocal jalr_fetches, store_wait, target_denied\n        assert not ren\n        if wen:\n            if addr == 0x40:\n                assert pc == 8\n                if data == target and store_wait < 4:\n                    store_wait += 1\n                    return store_wait % 2, 0\n                jalr_fetches += 1\n                writes.append((addr, wen, data))\n                return jalr_fetches == 1, 1\n            writes.append((addr, wen, data))\n        if pc == target and not target_denied:\n            target_denied = True\n            return 0, 1\n        return 1, 1\n\n'''+p[end:]\np=p.replace('assert jalr_fetches == 2 and store_wait == 4','assert jalr_fetches == 2 and store_wait == 4 and target_denied')\nstart=p.index('        if pc == 2056 and not denied:')\nend=p.index('        return 1, 1',p.index('writes.append',start))\np=p[:start]+'''        if wen:\n            if addr == 0x48:\n                assert pc == 2056\n                if store_wait < 4:\n                    store_wait += 1\n                    return 1, 0\n                assert not denied\n                denied = True\n                writes.append((addr, wen, data))\n                return 0, 1\n            writes.append((addr, wen, data))\n'''+p[end:]\np=p.replace('if addr == 28:\\\\n                assert pc == 28','if addr == 28:\\\\n                assert pc == 24').replace('assert pc == 16, \\\"the divide','assert pc == 12, \\\"the divide')\nstart=p.index('def test_pipeline_runner():')\np=p[:start]+'''@cocotb.test()\nasync def dependent_load_branch(dut):\n    program = [LW(2, 0, 0x40), LW(3, 2, 4), BEQ(3, 0, 8),\n               SW(0, 0, 0x5c), ADDI(5, 2, 8), EBREAK()]\n    served = []\n    def ready(pc, addr, ren, wen, data):\n        assert not wen\n        if ren:\n            served.append(addr)\n        return 1, 1\n    rets, _ = await _run(dut, program, {0x40: 0x100, 0x104: 0}, bus_ready=ready)\n    pcs = [0, 4, 8, 16, 20]\n    _check_trace(rets, pcs, [program[i // 4] for i in pcs])\n    assert served == [0x40, 0x104]\n    assert rets[1][\\\"rs1_rdata\\\"] == rets[0][\\\"rd_wdata\\\"] == 0x100\n    assert rets[3][\\\"rd_wdata\\\"] == 0x108\n    assert [r[\\\"cycle\\\"] - rets[0][\\\"cycle\\\"] for r in rets] == list(range(len(rets)))\n\n\n@cocotb.test()\nasync def stale_mmio_load(dut):\n    program = {0: ADDI(3, 0, 64), 4: NOP(), 8: LW(1, 3, 0), 12: 0x100001b7,\n               16: JAL(0, 2052-16), 2052: NOP(), 2056: ADDI(2, 0, 1), 2060: EBREAK()}\n    requests = []\n    fetches = []\n    def ready(pc, addr, ren, wen, data):\n        fetches.append(pc)\n        assert not wen\n        if ren:\n            requests.append(addr)\n            assert addr == 64\n        if pc == 2056:\n            return fetches.count(pc) > 1, 0\n        return 1, 1\n    rets,_ = await _run(dut, program, {64: 0xeb}, bus_ready=ready, startup_wait=512)\n    pcs = list(program)\n    _check_trace(rets,pcs,[program[pc] for pc in pcs])\n    assert requests == [64] and fetches.count(2056) == 2\n    assert rets[-2][\\\"rd_wdata\\\"] == 1\n\n\n'''+p[start:]\nt.write_text(p)\nPY\npython \\\"\"'$TMPDIR/early/testdesign.py\"\npytest -q -s \"$TMPDIR/early/test/test_pipeline.py\" > \"$TMPDIR/early/pipeline.out\" 2>&1 && tail -10 \"$TMPDIR/early/pipeline.out\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
