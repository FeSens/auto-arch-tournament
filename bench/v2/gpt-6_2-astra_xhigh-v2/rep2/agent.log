!id_const[i] && !y && !m;\n    end\n    assign input_data[i] = ({32{qy}} & fwd_ex_mem) | ({32{qm}} & fwd_mem_wb) |\n                           ({32{qi}} & immediate[i]) | ({32{ql}} & reg_data[i]);\n'\"'''\nelif meth=='mux':\n code='''\n    logic lo,hi;\n    always_ff @(posedge clock) if (\"'!id_hold) begin\n      lo <= id_const[i] || (!y && m);\n      hi <= !id_const[i] && (y || m);\n    end\n    assign input_data[i] = hi ? (lo ? fwd_mem_wb : fwd_ex_mem)\n                             : (lo ? immediate[i] : reg_data[i]);\n'\"'''\nelif meth=='split':\n code='''\n    logic q_remote, q_wb, q_imm;\n    always_ff @(posedge clock) if (\"'!id_hold) begin\n      q_remote <= !id_const[i] && (y || m);\n      q_wb <= !y && m;\n      q_imm <= id_const[i];\n    end\n    assign input_data[i] = q_remote ? (q_wb ? fwd_mem_wb : fwd_ex_mem)\n                             : (q_imm ? immediate[i] : reg_data[i]);\n'\"'''\nchange('ex_stage.sv','  ex_mem_t reg_q;', '  ex_mem_t reg_q;\\\\n'+base+code+'''  end\n  assign alu_a = input_data[0];\n  assign alu_b = input_data[1];\n''')\nfor a,b in [('(rs1 == rs2)','(alu_a == alu_b)'),('(rs1 \"'!= rs2)'\"','(alu_a \"'!= alu_b)'\"'),('(\"'$signed(rs1) <  $signed(rs2))'\"','(\"'$signed(alu_a) < $signed(alu_b))'\"'),('(\"'$signed(rs1) >= $signed(rs2))'\"','(\"'$signed(alu_a) >= $signed(alu_b))'\"'),('(rs1 <  rs2)','(alu_a < alu_b)'),('(rs1 >= rs2)','(alu_a >= alu_b)')]:\n change('ex_stage.sv',a,b)\nPY\npython \\\"\"'$TMPDIR/flagtrial/ops.py\" bankmux b3 mux\npython \"$TMPDIR/flagtrial/ops.py\" bankor b3 or\npython \"$TMPDIR/flagtrial/ops.py\" banksplit b3 split'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
