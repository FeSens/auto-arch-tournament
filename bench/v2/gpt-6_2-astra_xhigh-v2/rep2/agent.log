sedge clock) begin\n    if (reset || ex_fence_i) begin\n      scrub <= 1'b1;\n      scrub_row <= '0;\n      lookup_ok <= 1'b0;\n    end else begin\n      if (scrub) begin\n        scrub_row <= scrub_row + 1'b1;\n        if (&scrub_row) scrub <= 1'b0;\n      end\n      if (!ex_hold)\n        lookup_ok <= !scrub && (ex_pc[10:2] != read_row);\n    end\n  end\n\n  logic hit;\n  wire src_match = predicted[61:53] == ex_pc[19:11] && ex_pc[31:20] == 0;\n  wire direct_match = !ex_is_jalr && ex_disp == predicted[51:32];\n  assign hit = ex_valid && lookup_ok && !ex_fence_i && predicted[62] && src_match\n            && (redirect ? (predicted[52] && direct_match) : !predicted[52]);\n  always_comb begin\n    out.pc    = imem_addr;\n    out.instr = imem_ready ? imem_data : predicted[31:0];\n    out.valid = imem_ready || hit;\n  end\n\nendmodule\n195:JOBS=\"${JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)}\"\n196:echo \"=== make -j$JOBS -k ===\" | tee -a \"$LOG\"\n202:make -j\"$JOBS\" -k -f makefile 2>&1 \\\n.\n..\n.agents\n.aws\n.codex\n.git\n.github\n.gitignore\n.mailmap\n.readthedocs.yaml\nCOPYING\nCodeOfConduct\nREADME.md\nbus\nchecks\ncores\ndocs\ninsns\nmonitor\ntests\n","exit_code":0,"status":"completed"}}
