{"type": "item.started", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/split.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nroot=Path(os.environ['TMPDIR'])\nwt=root/'split'\n(wt/'cores/bench').mkdir(exist_ok=True,parents=True)\nshutil.copytree('cores/bench/rtl',wt/'cores/bench/rtl', dirs_exist_ok=True)\nshutil.copyfile('cores/bench/core.yaml',wt/'cores/bench/core.yaml')\nif not (wt/'fpga').exists():\n    (wt/'fpga').symlink_to(Path.cwd()/'fpga')\np=wt/'cores/bench/rtl/alu.sv'\norig=p.read_text()\nhead,s=orig.split('  logic [31:0] quotient_q, remainder_q, divisor_q;')\ns,tail=s.split('\"'`endif'\"',1)\ncontrol=s[s.index('  assign want_remainder'):s.index('  // Seed')]\nseed=s[s.index('  // Seed'):s.index('  assign multiple[1]')]\ns=\\\"\\\"\\\"\n  logic [31:0] dividend_q, divisor_q;\n  logic large_q, zero_q, want_remainder, a_negative, b_negative, remainder_op_q, negate_q;\n  logic [1:0] prefix, first_digit, first_remainder;\n  logic [31:0] magnitude, unsigned_q, unsigned_r;\n\\\"\\\"\\\"+control+seed.replace('quotient_q[31:30]', 'dividend_q[31:30]')\nfor mode,bits,rwidth,qwidth in [('wide',3,32,18),('small',5,14,32)]:\n    width=rwidth+bits\n    n=1<<bits\n    s+=f\\\"\\\"\\\"\n  logic [{qwidth-1}:0] {mode}_q;\n  logic [{rwidth-1}:0] {mode}_r, {mode}_next;\n  logic [{bits-1}:0] {mode}_digit;\n  wire [{width-1}:0] {mode}_d = {{{bits}'b0, divisor_q[{rwidth-1}:0]}};\n  wire [{width-1}:0] {mode}_t = {{{mode}_r, {mode}_q[{qwidth-1}:{qwidth-bits}]}};\n  wire [{width-1}:0] {mode}_multiples [1:{n-1}];\n  wire [{n}:0] {mode}_fits;\n  wire [{n-1}:0] {mode}_pick;\n  wire [{rwidth-1}:0] {mode}_diff [0:{n-1}], {mode}_sel [0:{n-1}];\n  assign {mode}_fits[0]=1;\n  assign {mode}_fits[{n}]=0;\n  assign {mode}_diff[0]={mode}_t[{rwidth-1}:0];\n  assign {mode}_pick={mode}_fits[{n-1}:0] & ~{mode}_fits[{n}:1];\n\\\"\\\"\\\"\n    for k in range(1,n):\n        odd=k\n        shift=0\n        while odd%2==0:\n            odd//=2\n            shift+=1\n        src=f'{mode}_d' if odd==1 else f'{mode}_m{odd}'\n        if k>1 and k%2:\n            if mode=='small' and k<=7:\n                s+=f'  wire [{width-1}:0] {src} = wide_m{k}[{width-1}:0];\\\\n'\n            else:\n                s+=f'  logic [{width-1}:0] {src};\\\\n'\n                # One C-P adder. Products with >2 positive terms rewritten in canonical signed digit form.\n                d=f'{mode}_d'\n                shifts={3:f'({d} << 1) + {d}',5:f'({d} << 2) + {d}',7:f'({d} << 3) - {d}',9:f'({d} << 3) + {d}',15:f'({d} << 4) - {d}',17:f'({d} << 4) + {d}',31:f'({d} << 5) - {d}'}\n                thirds={11:[3,1,0],13:[3,2,0],19:[4,1,0],21:[4,2,0],25:[4,3,0]}\n                if k in shifts: exp=shifts[k]\n                elif k in thirds:\n                    x,y,z=[f'({d} << {i})' for i in thirds[k]]\n                    exp=f'({x} \"'^ {y} ''^ {z}) + ((({x} & {y}) | (({x} ''^ {y}) & {z})) << 1)'\"'\n                else:\n                    # 23, 27 and 29 via 32D minus 9D/5D/3D. CSA using 32D + ~8D+1 + ~D+1.\n                    # General constant multiply on small operands only.\n                    exp=f\\\"{width}'d{k} * {d}\\\"\n                s+=f'  always_ff @(posedge clock) if (groups_left == 6) {src} <= {exp};\\\\n'\n        s+=f'  assign {mode}_multiples[{k}] = {src} << {shift};\\\\n'\n    s+=f\\\"\\\"\\\"\n  for (genvar k=1; k<{n}; k++) begin : g_{mode}_diff\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [{width}:0] residual;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign residual = {{1'b0, {mode}_t}} - {{1'b0, {mode}_multiples[k]}};\n    assign {mode}_fits[k] = \"'!residual[{width}];\n    assign {mode}_diff[k] = residual[{rwidth-1}:0];\n  end\n  for (genvar k=0; k<{n}; k++) begin : g_{mode}_select\n    assign {mode}_sel[k] = {{{rwidth}{{{mode}_pick[k]}}}} & {mode}_diff[k];\n  end\n\"\"\"\n    s+=f'\"'  assign {mode}_next = '+' | '.join(f'{mode}_sel[{i}]' for i in range(n))+';\\\\n'\n    for bit in range(bits):\n        s+=f'  assign {mode}_digit[{bit}] = '+' | '.join(f'{mode}_pick[{i}]' for i in range(n) if i&(1<<bit))+';\\\\n'\ns+=\\\"\\\"\\\"\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      dividend_q     <= a_negative ? -a : a;\n      divisor_q      <= b_negative ? -b : b;\n      remainder_op_q <= want_remainder;\n      negate_q <= want_remainder ? a_negative : ((a_negative \"'^ b_negative) && b != 0);\n    end else if (groups_left == 6) begin\n      large_q <= |divisor_q[31:14];\n      zero_q <= divisor_q == 0;\n      wide_q <= dividend_q[17:0];\n      wide_r <= {18'\"'b0,dividend_q[31:18]};\n      small_q <= {dividend_q[29:0], first_digit};\n      small_r <= {12'b0,first_remainder};\n    end else if (groups_left \"'!= 0 || (div_valid && div_consume)) begin\n      wide_q <= {wide_q[14:0], wide_digit};\n      wide_r <= wide_next;\n      small_q <= {small_q[26:0], small_digit};\n      small_r <= small_next;\n    end\n  end\n  assign unsigned_q = large_q ? {14'\"'b0,wide_q} : small_q;\n  assign unsigned_r = zero_q ? dividend_q : large_q ? wide_r : {18'b0,small_r};\n  assign magnitude = remainder_op_q ? unsigned_r : unsigned_q;\n  assign div_result = negate_q ? -magnitude : magnitude;\n\\\"\\\"\\\"\np.write_text(head+s+'\"'`endif'\"'+tail)\nPY\npython \\\"\"'$TMPDIR/split.py\"\npython -m tools.eval.gowin bench --worktree \"$TMPDIR/split\" --all-options'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"cat > cores/bench/experiments/hypotheses/hyp-20261120-001-r8s0.yaml <<'YAML'\nid: hyp-20261120-001-r8s0\ntitle: \\\"Resolve each divider digit with one parallel trial bank\\\"\ncategory: micro_opt\nmotivation: |\n  The champion's 74-cell path runs from quotient_q[31] to remainder_q[1]\n  through two dependent digit selections. The earlier split at 2\"'^17 still\n  put two radix-8 steps on its narrow feedback path. CoreMark executes\n  zero DIV/REM between its timing markers, so shortening this path can\n  improve the clock for all 3,234,996 measured cycles.\nhypothesis: |\n  Split at divisor magnitude D = 2''^14. For 0 < D < 2''^14, a restored\n  remainder occupies at most 14 bits. Resolve the top two dividend bits\n  during setup, then process the remaining 30 in six radix-32 digits.\n  Each digit uses parallel 19-bit trials and a one-hot residual mux.\n  For D >= 2''^14, the high 14 dividend bits already form a valid\n  remainder. Start with them and consume the low 18 bits as six radix-8\n  digits, using a single bank of seven 35-bit trials. In both lanes\n  the feedback path crosses only one subtraction and selection per edge.\n\n  Register odd divisor multiples on the setup edge and derive even\n  multiples by shifts. Advance both lanes on the five remaining wait\n  edges and once on consume. Select the completed lane in MEM using the\n  registered mode. The six-wait handshake preserves the champion'\"'s\n  tested retirement latency. At 3,234,996 bracketed cycles, a median\n  above 76.79 MHz clears the 4.6% acceptance margin. The routing cost\n  of the 31-way narrow digit selection is the main uncertainty.\nexpected_impact:\n  fitness_delta_pct: 8\n  confidence: medium\nchanges:\n  - file: rtl/alu.sv\n    description: |\n      Use 14-bit and 32-bit remainder registers with independent quotient\n      shift registers. For T = radix*R + next input digit, use the borrow\n      of each extended T-kD to select the greatest fitting k and its\n      residual. Keep all multiples at full lane precision. Reuse the low\n      bits of the wide multiples for k up to seven. Capture divide-by-zero\n      explicitly so REM/REMU return the full dividend. Preserve signed\n      truncation, INT_MIN / -1, the existing ALTOPS timing, and the\n      consume-to-MEM result lifetime.\n  - file: test/test_alu.py\n    description: |\n      Exercise D=0x3fff, 0x4000 and 0x4001, signed variants, the largest\n      wide-lane quotient and kD boundaries for each of the 32 narrow\n      digits. Alternate modes on consecutive requests. Check the exact\n      result after consume and its stability while MEM is held.\nYAML\npython - <<'PY'\nimport json,yaml,jsonschema\nfrom pathlib import Path\np=Path('cores/bench/experiments/hypotheses/hyp-20261120-001-r8s0.yaml')\njsonschema.validate(yaml.safe_load(p.read_text()),json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('valid')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
