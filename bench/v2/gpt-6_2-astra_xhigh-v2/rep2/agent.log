  hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 85.328\n  lut4: 4965\n  ff: 944\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261120-002-r9s1\n  updated: '2026-11-20T10:02:46.882554Z'\n-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n/srv/hwebench/venv/bin/pytest\n/srv/hwebench/venv/bin/python3\n71:async def _run(dut, program, dmem_init=None, max_cycles=200, bus_ready=None,\n189:async def forwarding_ex_to_ex(dut):\n205:async def forwarding_mem_to_ex(dut):\n214:async def forwarding_priority_trap_and_stalled_store(dut):\n249:async def load_use_forwarding(dut):\n267:async def page_repairs_and_load_to_branch(dut):\n331:async def predict_from_inflight_writers(dut):\n368:async def trapped_base_writer(dut):\n391:async def multiply_dependencies(dut):\n427:async def multiply_held_behind_store(dut):\n459:async def discard_store_on_invalid_fetch_and_redirect(dut):\n487:async def branch_held_behind_store(dut):\n526:async def replay_through_eight_denied_loop_iterations(dut):\n561:async def replay_loads_with_alternating_rs1(dut):\n608:async def replay_jalr_held_behind_store(dut):\n652:async def replay_aliased_predecessor(dut):\n689:async def replay_read_write_collision(dut):\n713:async def fence_i_refetches_modified_successors(dut):\n763:async def divider_dependencies_with_sta