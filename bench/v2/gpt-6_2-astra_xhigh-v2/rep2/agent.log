{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r4struct-5ultg70k/redirect.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nimport shutil,sys\np=Path(__file__).resolve().parent\nname=sys.argv[1]\nrtl=p/name\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\nf=rtl/'hazard_unit.sv';s=f.read_text().replace(' || redirect || \"'!fetch_valid'\"',' || \"'!fetch_valid'\"')\ns=s.replace('  input  logic       redirect,          // EX has resolved a branch/jump\\\\n',''); f.write_text(s)\nf=rtl/'core.sv';s=f.read_text().replace('    .redirect       (redirect),\\\\n    .fetch_valid', '    .fetch_valid'); f.write_text(s)\nf=rtl/'if_stage.sv';s=f.read_text();s=s[:s.index('  // Redirect must override')]\nif name=='direct':\n s+='''\n  logic [31:0] address;\n  assign address = redirect ? redirect_target : pc;\n  always_ff @(posedge clock) begin\n    if (reset) pc <= RESET_PC;\n    else if (\"'!stall) pc <= address + 32'\"'d4;\n    else if (redirect) pc <= redirect_target;\n  end\n'''\nelif name=='defer':\n s+='''\n  logic [31:0] address;\n  logic consumed;\n  assign address = redirect ? redirect_target : (consumed ? pc + 32'd4 : pc);\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      consumed <= 1'b0;\n    end else if (redirect || \"'!stall) begin\n      pc <= address;\n      consumed <= !stall;\n    end\n  end\n'\"'''\nelse: raise ValueError(name)\ns+='''\n  assign imem_addr = address;\n  assign out.pc = address;\n  assign out.instr = imem_data;\n  assign out.valid = imem_ready;\nendmodule\n'''\nf.write_text(s)\nprint(name,flush=True)\nif len(sys.argv)>2:\n print(summarize(build_all('.',rtl,'fpga/core_bench_si.sv',p/(name+'_timing'),options=(0,1,2))),flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/r4struct-5ultg70k/redirect.py\" defer timing'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
