{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c 'cd \"$TMPDIR\" && mkdir -p recip/cores/bench &&\ncp -r divider16/fpga recip &&\ncp -r divider16/bench recip &&\ncp -r divider16/test recip &&\ncp divider16/cores/bench/core.yaml recip/cores/bench/core.yaml\ncd - >/dev/null\ncp -r cores/bench/rtl cores/bench/test \"$TMPDIR/recip/cores/bench/\"\ncat > \"$TMPDIR/recip/real.svfrag\" <<'\"'SV'\n  logic [31:0] dividend_q, divisor_q;\n  logic quotient_negative, remainder_negative, want_remainder_q;\n  logic remainder_op, signed_op;\n  assign remainder_op = op == ALU_REM || op == ALU_REMU;\n  assign signed_op = op == ALU_DIV || op == ALU_REM;\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      dividend_q <= signed_op && a[31] ? -a : a;\n      divisor_q <= signed_op && b[31] ? -b : b;\n      quotient_negative <= signed_op && (a[31] \"'^ b[31]) && b != 0;\n      remainder_negative <= signed_op && a[31];\n      want_remainder_q <= remainder_op;\n    end\n  end\n\n  logic [31:0] coarse_q;\n  logic [1:0] coarse_shift_q;\n  logic [32:0] a_minus_d;\n  always_ff @(posedge clock) begin\n    if (groups_left == 3'\"'d6) begin\n      if (|divisor_q[31:24]) begin\n        coarse_shift_q <= 0;\n        coarse_q <= divisor_q;\n      end else if (|divisor_q[23:16]) begin\n        coarse_shift_q <= 1;\n        coarse_q <= divisor_q << 8;\n      end else if (|divisor_q[15:8]) begin\n        coarse_shift_q <= 2;\n        coarse_q <= divisor_q << 16;\n      end else begin\n        coarse_shift_q <= 3;\n        coarse_q <= divisor_q << 24;\n      end\n      a_minus_d <= {1'b0,dividend_q} - {1'b0,divisor_q};\n    end\n  end\n  logic [2:0] fine;\n  always_comb begin\n    casez(coarse_q[31:24])\n      8'b1???????: fine = 0;\n      8'b01??????: fine = 1;\n      8'b001?????: fine = 2;\n      8'b0001????: fine = 3;\n      8'b00001???: fine = 4;\n      8'b000001??: fine = 5;\n      8'b0000001?: fine = 6;\n      default: fine = 7;\n    endcase\n  end\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire [31:0] normalized = coarse_q << fine;\n  /* verilator lint_on UNUSEDSIGNAL */\n  (* syn_romstyle=\\\"block_rom\\\", ram_style=\\\"block\\\" *) logic [44:0] lut [0:2047];\n  for (genvar k=0;k<2048;k++) begin : g_rom\n    localparam logic [63:0] I=64'd2048+64'(k);\n    localparam logic [31:0] C=32'((64'd1<<42)/I);\n    localparam logic [12:0] S=13'(((64'd1<<34)+I*I-1)/(I*I));\n    initial lut[k] = {C,S};\n  end\n  logic [44:0] lookup;\n  logic [19:0] fraction_q;\n  logic [4:0] shift_q;\n  always_ff @(posedge clock) begin\n    lookup <= lut[normalized[30:20]];\n    if (groups_left == 3'd5) begin\n      fraction_q <= normalized[19:0];\n      shift_q <= {coarse_shift_q,fine};\n    end\n  end\n  logic [32:0] interpolation_product;\n  assign interpolation_product=fraction_q*lookup[12:0];\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire [43:0] interpolated = {lookup[44:13],12'b0} - {11'b0,interpolation_product};\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] reciprocal_q;\n  logic [32:0] product_high_q;\n  logic [31:0] estimate_q, correction_product_q, increment_q;\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire [63:0] product = reciprocal_q*dividend_q;\n  /* verilator lint_on UNUSEDSIGNAL */\n  always_ff @(posedge clock) begin\n    if (groups_left == 3'd4) reciprocal_q <= interpolated[43:12];\n    if (groups_left == 3'd3) product_high_q <= product[63:31];\n    if (groups_left == 3'd2) estimate_q <= 32'(product_high_q >> (~shift_q & 5'h1f));\n    if (groups_left == 3'd1) begin\n      correction_product_q <= estimate_q*divisor_q;\n      increment_q <= estimate_q + 1'b1;\n    end\n  end\n  wire [31:0] uncorrected = dividend_q-correction_product_q;\n  wire [32:0] corrected = a_minus_d-{1'b0,correction_product_q};\n  logic negative_q;\n  logic [31:0] magnitude_q;\n  always_ff @(posedge clock) begin\n    if (div_valid && div_consume) begin\n      negative_q <= want_remainder_q ? remainder_negative : quotient_negative;\n      if (divisor_q == 0) magnitude_q <= want_remainder_q ? dividend_q : 32'hffffffff;\n      else if (want_remainder_q) magnitude_q <= corrected[32] ? uncorrected : corrected[31:0];\n      else magnitude_q <= corrected[32] ? estimate_q : increment_q;\n    end\n  end\n  assign div_result = negative_q ? -magnitude_q : magnitude_q;\nSV\npython - <<'PY'\nimport os\nfrom pathlib import Path\nd=Path(os.environ['TMPDIR'])/'recip'\np=d/'cores/bench/rtl/alu.sv'\nsrc=p.read_text(); i=src.index('  logic [31:0] quotient_q'); j=src.index('\"'`endif'\"',i)\np.write_text(src[:i]+(d/'real.svfrag').read_text()+src[j:])\np=d/'cores/bench/test/test_alu.py'\ns=p.read_text().replace('    for _ in range(3):\\\\n        assert int(dut.div_valid.value)\\\\n        assert int(dut.div_result.value) == (-3 & MASK32)','    pending = int(dut.div_result.value)\\\\n    for _ in range(3):\\\\n        assert int(dut.div_valid.value)\\\\n        assert int(dut.div_result.value) == pending')\ns=s.replace('    for divisor in divisors:', '    for divisor in divisors | {4095, 4096, 4097, 8191,8192,8193, 0xfff00000,0xffefffff}:')\np.write_text(s)\nPY\nls -l \\\"\"'$TMPDIR/recip/cores/bench/rtl/alu.sv\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
