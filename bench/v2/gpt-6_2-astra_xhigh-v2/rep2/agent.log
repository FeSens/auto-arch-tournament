integer OVERLAP = {overlap};\n  wire is_sub = in.ctrl.alu_op == ALU_SUB;\n  wire is_add = in.ctrl.alu_op == ALU_ADD;\n  wire [31:0] effective_b = is_sub ? ~alu_b : alu_b;\n  wire [LOW:0] low_result = {{1'b0,alu_a[LOW-1:0]}} + {{1'b0,effective_b[LOW-1:0]}} + is_sub;\n  wire [OVERLAP:0] middle = {{1'b0,alu_a[LOW-1 -: OVERLAP]}} + {{1'b0,effective_b[LOW-1 -: OVERLAP]}} + effective_b[31];\n  wire predicted_carry = middle[OVERLAP];\n  wire [31-LOW:0] high_result = alu_a[31:LOW] + effective_b[31:LOW] + predicted_carry;\n  assign add_value = {{high_result, low_result[LOW-1:0]}};\n  assign alu_result = logic_result | ({{32{{is_add || is_sub}}}} & add_value);\n''')\nchange('ex_stage.sv','      reg_q.pc            <= in.pc;', '''      reg_q.carry_miss <= in.valid && in.ctrl.reg_write && \"'!in.ctrl.is_jump && !in.ctrl.mem_read &&\n                          in.rd != 0 && (is_add || is_sub) && predicted_carry != low_result[LOW];\n      reg_q.guessed_carry <= predicted_carry;\n      reg_q.pc            <= in.pc;'\"''')\nchange('mem_stage.sv','  mem_wb_t reg_q;',f'''  localparam integer LOW = {width};\n  wire [31-LOW:0] correction = in.guessed_carry ? {{(32-LOW){{1'b1}}}} : {{{{(31-LOW){{1'b0}}}},1'b1}};\n  wire [31-LOW:0] exact_high = in.alu_result[31:LOW] + correction;\n  wire [31:0] integer_result = {{in.carry_miss ? exact_high : in.alu_result[31:LOW], in.alu_result[LOW-1:0]}};\n  mem_wb_t reg_q;''')\nchange('mem_stage.sv',': in.alu_result;', ': integer_result;')\nPY\npython \\\"\"'$TMPDIR/flagtrial/carry.py\" carry 16 4\nPYTHONPATH=. python \"$TMPDIR/flagtrial/build.py\" carry 0 1 2 > \"$TMPDIR/flagtrial/carry.time\"'","aggregated_output":"","exit_code":0,"status":"completed"}}
