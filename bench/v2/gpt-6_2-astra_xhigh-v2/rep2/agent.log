ecovery-hold test a fresh PC index unaffected by the preceding test.\nstart=s.index('async def recovery_held_branch_and_fetch')\ns=s[:start]+s[start:].replace('program = [LW(9','program = [NOP()] * 24 + [LW(9',1).replace('pc == 8','pc == 104',1).replace('pc == 12','pc == 108',1).replace(\\\"for r in rets] == [0, 4, 12, 16]\\\", \\\"for r in rets[24:]] == [96, 100, 108, 112]\\\",1).replace(\\\"for r in rets] == [0, 1, 2, 3]\\\",\\\"for r in rets] == list(range(28))\\\",1).replace(\\\"rets[1]['pc_next'] == 12\\\",\\\"rets[25]['pc_next'] == 108\\\",1).replace(\\\"rets[2]['rd_wdata'] == 31\\\",\\\"rets[26]['rd_wdata'] == 31\\\",1)\np.write_text(s)\nroot=Path.cwd(); q=root.parent/'target-buffer-research'; q.mkdir()\nfor n in ['bench','fpga','test','tools']:\n (q/n).symlink_to(root/n, target_is_directory=True)\ncopy(root/'Makefile',q/'Makefile')\ncopytree(root/'variants/registered',q/'cores/bench/rtl')\ncopytree(root/'cores/bench/test',q/'cores/bench/test')\ncopy(root/'cores/bench/core.yaml',q/'cores/bench/core.yaml')\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
