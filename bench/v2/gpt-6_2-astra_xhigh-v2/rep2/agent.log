{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/probe/make_probe.py\" <<'\"'PY'\nimport sys, shutil, os\nfrom pathlib import Path\ncfg = sys.argv[1]\nwt = Path.cwd()\nbase = Path(os.environ['TMPDIR']) / 'probe'\nrtl = base/cfg/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nshutil.copytree(wt/'cores/bench/rtl', rtl,dirs_exist_ok=True)\ndef change(f, old, new):\n    p = rtl / (f+'.sv')\n    s = p.read_text()\n    assert s.count(old) == 1,(f,old)\n    p.write_text(s.replace(old,new))\nf = 'forward_unit'\nchange(f,'  output logic [1:0] fwd_rs1,\\\\n  output logic [1:0] fwd_rs2','  output logic       older_rs2_match,\\\\n  output logic       fwd_rs1, fwd_rs2')\nchange(f,'younger_rs2_q, older_rs1_q, older_rs2_q;', 'younger_rs2_q;')\nchange(f,'  always_ff @(posedge clock)', '  assign older_rs2_match = older_writer && ex_mem_rd == id_rs2;\\\\n\\\\n  always_ff @(posedge clock)')\nchange(f,'''      older_rs1_q   <= older_rs1_match;\n      older_rs2_q   <= older_writer && ex_mem_rd == id_rs2;\n''','')\nchange(f,'''  assign fwd_rs1[0] = younger_rs1_q && ex_mem_forwardable;\n  assign fwd_rs2[0] = younger_rs2_q && ex_mem_forwardable;\n  assign fwd_rs1[1] = older_rs1_q && \"'!fwd_rs1[0];\n  assign fwd_rs2[1] = older_rs2_q && !fwd_rs2[0];'\"''','''  assign fwd_rs1 = younger_rs1_q && ex_mem_forwardable;\n  assign fwd_rs2 = younger_rs2_q && ex_mem_forwardable;''')\nc='core'\nchange(c,'logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', 'logic fwd_rs1_sel, fwd_rs2_sel, mem_matches_rs2;\\\\n  logic [31:0] mem_complete;')\nchange(c,'    .older_rs1_match    (mem_writes_base),','    .older_rs1_match    (mem_writes_base),\\\\n    .older_rs2_match    (mem_matches_rs2),')\nchange(c,'    .fwd_mem_wb      (wb_w_data),\\\\n','')\nchange(c,'    .div_result (div_result),','    .div_result (div_result),\\\\n    .complete_result (mem_complete),')\nchange(c,'    .out      (id_ex_q)', '''    .match_mem_rs1 (mem_writes_base),\n    .match_mem