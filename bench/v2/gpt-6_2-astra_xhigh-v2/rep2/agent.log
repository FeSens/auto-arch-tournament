{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/flagtrial\"\ncat > \"$TMPDIR/flagtrial/generate.py\" <<'\"'PY'\nimport sys, os, shutil\nfrom pathlib import Path\ndest=Path(os.environ['TMPDIR']) / 'flagtrial' / sys.argv[1]\nwidth=int(sys.argv[2])\nif dest.exists(): raise RuntimeError(f'existing {dest}')\nshutil.copytree('cores/bench/rtl', dest)\ndef change(f, old, new):\n p=dest/f\n s=p.read_text()\n assert old in s, old\n p.write_text(s.replace(old,new))\nchange('core_pkg.sv','logic        base_available;', 'logic        base_available;\\\\n    logic        compare_mode;')\nchange('id_stage.sv','reg_q.page_cross <=', '''reg_q.compare_mode <= dec_is_branch || dec_alu_op == ALU_SUB ||\n                            dec_alu_op == ALU_SLT || dec_alu_op == ALU_SLTU;\n      reg_q.page_cross <=''')\nchange('alu.sv','module alu (', \\\"module alu #(parameter INTEGRATED = 1'b0) (\\\")\nfor expr in ['a + b','a - b',\\\"{31'b0, \"'$signed(a) < $signed(b)}\",\"{31'\"'b0, a < b}\\\"]:\n change('alu.sv', 'out = '+expr+';', \\\"out = INTEGRATED ? 32'b0 : (\\\"+expr+');')\nchange('ex_stage.sv','output logic [31:0]        alu_a, alu_b,','output logic [31:0]        add_value, alu_a, alu_b,')\nchange('core.sv','repaired_addr, ex_a, ex_b;', 'repaired_addr, ex_a, ex_b, add_value;')\nchange('core.sv','.ex_a     (ex_a),','.add_value(add_value),\\\\n    .ex_a     (ex_a),')\nchange('core.sv','.alu_a           (ex_a),','.add_value       (add_value),\\\\n    .alu_a           (ex_a),')\nchange('id_stage.sv','mem_result, ex_a, ex_b, lw_word,','mem_result, ex_a, ex_b, lw_word, add_value,')\nchange('id_stage.sv','assign add_base = ex_a + ex_b;', 'assign add_base = add_value;')\nchange('ex_stage.sv','alu u_alu (','alu #(.INTEGRATED(1)) u_alu (')\nchange('ex_stage.sv','.out (alu_result),','.out (other_result),')\ninsert=f'''\n  localparam integer SLICE = {width};\n  localparam integer GROUPS = 32 / SLICE;\n  logic [31:0] other_result, cmp_word, add_rhs, local_a;\n  logic [GROUPS-1:0] group_eq, group_gt, group_carry;\n  logic pick_local, pick_ex, pick_wb, ge, eq, lt_signed, calc_sum, calc_lt;\n  assign pick_ex = \"'!in.ctrl.is_auipc && fwd_rs1_sel[0];\n  assign pick_wb = !in.ctrl.is_auipc && fwd_rs1_sel[1];\n  assign pick_local = in.ctrl.is_auipc || fwd_rs1_sel == 0;\n  assign local_a = in.ctrl.is_auipc ? in.pc : in.rs1_val;\n  assign cmp_word = in.compare_mode ? alu_b : ~alu_b;\n  assign add_rhs = ~cmp_word;\n  for (genvar i=0; i<GROUPS; i++) begin: g_flags\n    wire [SLICE-1:0] local_byte = local_a[i*SLICE +: SLICE];\n    wire [SLICE-1:0] ex_byte = fwd_ex_mem[i*SLICE +: SLICE];\n    wire [SLICE-1:0] wb_byte = fwd_mem_wb[i*SLICE +: SLICE];\n    wire [SLICE-1:0] t = cmp_word[i*SLICE +: SLICE];\n    assign group_eq[i] = (pick_local && local_byte == t) || (pick_ex && ex_byte == t) ||\n                         (pick_wb && wb_byte == t);\n    assign group_gt[i] = (pick_local && local_byte > t) || (pick_ex && ex_byte > t) ||\n                         (pick_wb && wb_byte > t);\n    if (i==0) assign group_carry[i] = in.compare_mode;\n    else assign group_carry[i] = (group_gt[i-1:0] > ~group_eq[i-1:0]) ||\n                                   (group_gt[i-1:0] == ~group_eq[i-1:0] && in.compare_mode);\n    assign add_value[i*SLICE +: SLICE] = alu_a[i*SLICE +: SLICE] +\n                                         add_rhs[i*SLICE +: SLICE] +\n                                         {{{{(SLICE-1){{1'\"'b0}}}}, group_carry[i]}};\n  end\n  assign eq = &group_eq;\n  assign ge = group_gt >= ~group_eq;\n  assign lt_signed = alu_a[31] \"'!= alu_b[31] ? alu_a[31] : !ge;\n  assign calc_sum = in.ctrl.alu_op == ALU_ADD || in.ctrl.alu_op == ALU_SUB;\n  assign calc_lt = (in.ctrl.alu_op == ALU_SLT && lt_signed) ||\n                   (in.ctrl.alu_op == ALU_SLTU && !ge);\n  assign alu_result = other_result | ({{32{{calc_sum}}}} & add_value) | {{31'\"'b0,calc_lt}};\n'''\n# Fold G,P as (G+P)+G, where G and P are mutually exclusive per group.\n# G versus ~P alone gives equality on a generate and a *kill* on propagate.\ninsert=insert.replace('> ~group_eq[i-1:0]', '> ~(group_gt[i-1:0] | group_eq[i-1:0])').replace('== ~group_eq[i-1:0]', '== ~(group_gt[i-1:0] | group_eq[i-1:0])').replace('>= ~group_eq;', '>= ~(group_gt | group_eq);')\n# A generate (G=1, P=0) compares as 1 > 0. A kill (G=P=0) compares as 0 < 1. Propagate (G=0,P=1) as 0 == 0.\nchange('ex_stage.sv','  logic [31:0] alu_result;','  logic [31:0] alu_result;\\\\n'+insert)\nfor old,new in [('(rs1 == rs2)','eq'),('(rs1 \"'!= rs2)'\"','\"'!eq'\"'),('(\"'$signed(rs1) <  $signed(rs2))'\"','lt_signed'),('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!lt_signed'\"'),('(rs1 <  rs2)','\"'!ge'\"'),('(rs1 >= rs2)','ge')]:\n change('ex_stage.sv',old,new)\nPY\npython \\\"\"'$TMPDIR/flagtrial/generate.py\" byte 8\ncat > \"$TMPDIR/flagtrial/build.py\" <<'\"'PY'\nimport sys,os\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\na=Path(os.environ['TMPDIR'])/'flagtrial'\nrtl=a/sys.argv[1]\nfor r in build_all(Path.cwd(),rtl,'fpga/core_bench_si.sv',a/('timing-'+sys.argv[1]),options=tuple(map(int,sys.argv[2:]))):\n print(r,flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/flagtrial/build.py\" byte 0 1 2'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
