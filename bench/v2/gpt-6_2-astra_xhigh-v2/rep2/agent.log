G=str(f/'checks_si.cfg'),JOBS='4')\nwith (s/'formal.log').open('w') as log:\n out=subprocess.run(['bash',f/'run_all.sh'],env=env,cwd=s,stdout=log,stderr=subprocess.STDOUT)\nprint('\\\\n'.join((s/'formal.log').read_text().splitlines()[-8:]))\nsys.exit(out.returncode)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
