 [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       div_wait,          // retain the divide instruction in ID/EX\n  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n  // random ~22% stall in vex_main.cpp). When low, the corresponding\n  // memory request is NOT serviced this cycle.\n  input  logic       fetch_valid,\n  input  logic       dmem_ready,\n  input  logic       ex_mem_request,    // verified, aligned access in EX\n  input  logic       id_mem_op,\n  input  logic       ex_base_match,\n  input  logic       ex_base_ready,\n  input  logic       mem_base_late,\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_id,          // ID/EX captures a bubble\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic late_use_hazard, base_hazard;\n  logic dmem_stall;\n\n  always_comb begin\n    late_use_hazard = fetch_valid && id_ex_late_result\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                   && (id_ex_rd != 5'b0);\n    base_hazard = id_mem_op && (ex_base_match ? !ex_base_ready : mem_base_late);\n    dmem_stall = !dmem_ready && ex_mem_request;\n\n    // Keep the resident EX instruction until it can transfer. Only then\n    // may ID/EX be cleared, including its register-write and bus controls.\n    stall_id      = dmem_stall || div_wait;\n    flush_id      = !stall_id && (late_use_hazard || base_hazard || !fetch_valid);\n    // Keep both forwarding sources stable through the acceptance edge.\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
