{"type": "item.completed", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"sed -n '364,556p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert rets[5][\"cycle\"] == rets[4][\"cycle\"] + 1\n    assert rets[4][\"rd_wdata\"] == rets[5][\"rs1_rdata\"] == 24\n    assert rets[5][\"rd_wdata\"] == 31\n\n\n@cocotb.test()\nasync def replay_through_eight_denied_loop_iterations(dut):\n    warmup = 180\n    iterations = warmup + 8\n    program = [\n        ADDI(1, 0, iterations), SW(1, 0, 0x40), ADDI(1, 1, -1),\n        BNE(1, 0, -8), EBREAK(),\n    ]\n    headers = 0\n    denied = []\n    writes = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n        nonlocal headers\n        assert not ren\n        if wen:\n            writes.append((addr, wen, data))\n        if pc == 4:\n            headers += 1\n        if headers > warmup and len(denied) < 27:\n            denied.append(pc)\n            return 0, 1\n        return 1, 1\n\n    rets, _ = await _run(dut, program, max_cycles=650, bus_ready=bus_ready,\n                         unready_instr=SW(0, 0, 0x48))\n    pcs = [0] + [4, 8, 12] * iterations + [16]\n    _check_trace(rets, pcs, [program[pc // 4] for pc in pcs])\n    assert denied == [4, 8, 12] * 8 + [16] * 3\n    assert writes == [(0x40, 15, n) for n in range(iterations, 0, -1)]\n    last_loops = rets[-25:-1]\n    first = last_loops[0][\"cycle\"]\n    assert [r[\"cycle\"] for r in last_loops] == list(range(first, first + 24))\n\n\n@cocotb.test()\nasync def replay_jalr_held_behind_store(dut):\n    # First train JALR with a target equal to its fall-through. Replay the\n    # JALR on its second visit, when x1 selects the same low 20 address\n    # bits in the MMIO window. Supply distinct words at the two addresses.\n    target = 0x1000000c\n    program = {\n        0: ADDI(1, 0, 12), 4: SW(1, 0, 0x40), 8: JALR(5, 1, 0),\n        12: SW(5, 0, 0x44), 16: 0x100000b7,  # LUI x1, 0x10000\n        20: ADDI(1, 1, 12), 24: J