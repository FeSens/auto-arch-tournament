{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch = Path(os.environ['TMPDIR'])/'divider'\nscratch.mkdir(exist_ok=False)\nrtl=scratch/'rtl'\nshutil.copytree('cores/bench/rtl',rtl)\nshutil.copytree('cores/bench/test',scratch/'test')\np=rtl/'alu.sv'\ns=p.read_text()\ns=s.replace('logic [31:0] quotient_q, remainder_q, divisor_q;','''logic [31:0] quotient_q, divisor_q;\n  logic [16:0] narrow_rem;\n  logic [31:0] wide_rem, original_a;\n  logic [14:0] wide_quotient;\n  logic large_q, zero_q;''')\ns=s.replace('logic [2:0]  digit [0:1];\\\\n  logic [31:0] middle_remainder, next_remainder;','''logic [2:0] digit [0:2];\n  logic [16:0] middle_remainder, next_narrow;\n  logic [31:0] next_wide;''')\ni=s.index('stage < 2')\nj=s.index('    assign fits[0]',i)\ns=s[:i]+'''stage < 3; stage++) begin : g_radix8\n    localparam RW = stage == 2 ? 32 : 17;\n    localparam TW = RW + 3;\n    logic [TW-1:0] trial;\n    logic [RW-1:0] remainder;\n    logic [8:0] fits;\n    logic [7:0] select_digit;\n    logic [RW-1:0] difference [0:7];\n    logic [RW-1:0] selected [0:7];\n\n    if (stage == 0) begin : g_first\n      assign trial = {narrow_rem, quotient_q[31:29]};\n      assign middle_remainder = remainder;\n    end else if (stage == 1) begin : g_second\n      assign trial = {middle_remainder, quotient_q[28:26]};\n      assign next_narrow = remainder;\n    end else begin : g_wide\n      assign trial = {wide_rem, wide_quotient[14:12]};\n      assign next_wide = remainder;\n    end\n\n'''+s[j:]\ns=s.replace('trial[31:0]', 'trial[RW-1:0]').replace(\\\"{1'b0, multiple[k]}\\\",\\\"{1'b0, multiple[k][TW-1:0]}\\\").replace('{32{select_digit[k]}}','{RW{select_digit[k]}}')\ns=s.replace('quotient_q     <= a_negative', 'original_a     <= a;\\\\n      quotient_q     <= a_negative')\ns=s.replace(\\\"remainder_q <= {30'b0, first_remainder};\\\",\\\"\\\"\\\"narrow_rem  <= {15'b0, first_remainder};\n      wide_rem    <= {15'b0, quotient_q[31:15]};\n      wide_quotient <= quotient_q[14:0];\n      large_q <= |divisor_q[31:17];\n      zero_q <= divisor_q == 0;\\\"\\\"\\\")\ns=s.replace('remainder_q <= next_remainder;', '''narrow_rem  <= next_narrow;\n      wide_quotient <= {wide_quotient[11:0], digit[2]};\n      wide_rem    <= next_wide;''')\ns=s.replace('assign magnitude = remainder_op_q ? remainder_q : quotient_q;\\\\n  assign div_result = negate_q ? -magnitude : magnitude;', '''assign magnitude = large_q ? (remainder_op_q ? wide_rem : {17'b0, wide_quotient})\n                             : (remainder_op_q ? {15'b0, narrow_rem} : quotient_q);\n  assign div_result = zero_q ? (remainder_op_q ? original_a : 32'hffffffff)\n                             : negate_q ? -magnitude : magnitude;''')\np.write_text(s)\nt=scratch/'test/test_alu.py'\nsrc=t.read_text().replace('0x1234567, MASK32 - 1','0x1ffff, 0x20000, 0x20001, 0x1234567, MASK32 - 1')\nsrc=src.replace('for prefix in range(4):','''if divisor:\n            largest_multiple = MASK32 // divisor * divisor\n            for delta in (-1, 0, 1):\n                if 0 <= largest_multiple + delta <= MASK32:\n                    pairs.add((largest_multiple + delta, divisor))\n        for prefix in range(4):''')\nsrc=src.replace('0x80000001, MASK32]', '0x80000001, MASK32, 0x1ffff, 0x20000, 0x20001, (-0x1ffff) & MASK32, (-0x20000) & MASK32, (-0x20001) & MASK32]')\nt.write_text(src)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
