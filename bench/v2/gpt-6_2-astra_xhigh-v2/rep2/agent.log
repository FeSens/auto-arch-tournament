{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py | tail -260'", "aggregated_output": "    assert writes == [(0x40, 15, 12), (0x44, 15, 12), (32, 15, patch), (28, 15, patch)]\n    assert store_wait == 3 and fetch_wait == 520 and denied == [3, 3]\n\n\n@cocotb.test()\nasync def divider_dependencies_with_stalls(dut):\n    mask = 0xFFFFFFFF\n    dividend = (-101) & mask\n    unsigned_quotient = dividend // 6\n    unsigned_remainder = dividend % unsigned_quotient\n    program = [\n        ADDI(1, 0, -101),\n        ADDI(2, 0, 6),\n        SW(1, 0, 0x40),              # holds the DIV at fetch\n        _r(1, 2, 1, 4, 3, 0x33),    # DIV  x3, x1, x2  -> -16\n        _r(1, 2, 3, 6, 4, 0x33),    # REM  x4, x3, x2  -> -4\n        SW(4, 0, 0x44),\n        LW(5, 0, 0x40),\n        _r(1, 2, 5, 5, 6, 0x33),    # DIVU x6, x5, x2  (load bypass)\n        _r(1, 6, 5, 7, 7, 0x33),    # REMU x7, x5, x6  (divisor bypass)\n        SW(7, 0, 0x48),\n        EBREAK(),\n    ]\n    expected_bus = [\n        (0, 15, 0x40, dividend),\n        (0, 15, 0x44, -4 & mask),\n        (1, 0, 0x40, 0),\n        (0, 15, 0x48, unsigned_remainder),\n    ]\n    transfers = 0\n    wait_cycles = 0\n    fetch_stalls = {16: 2, 36: 9}\n    fetches = []\n\n    def bus_ready(pc, addr, ren, wen, wdata):\n        nonlocal transfers, wait_cycles\n        fetches.append(pc)\n        iready = not fetch_stalls.get(pc, 0)\n        if not iready:\n            fetch_stalls[pc] -= 1\n        if not (ren or wen):\n            assert wait_cycles == 0, \"request withdrawn during a data stall\"\n            return iready, 1\n        assert (ren, wen, addr, wdata if wen else 0) == expected_bus[transfers]\n        if transfers == 0:\n            assert pc == 12, \"the divide must wait behind the older store\"\n        if wait_cycles < 3:\n            wait_cycles += 1\n            return iready, 0\n        transfers += 1\n        wait_cycles = 0\n        return iready, 1\n\n    rets, dmem = await _run(dut, program, bus_ready=bus_ready)\n    assert transfers == len(expected_bus) and not any(fetch_stalls.values())\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"insn\"] for r in rets] == prog\n…[6564 of 9636 chars elided by tools/bench/transcript.py; sha256:1851d11e4f449999]…\ngram = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
