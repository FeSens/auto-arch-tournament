{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv && cat bench/programs/Makefile'", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Operand forwarding. For each rs in the EX-stage's source list, picks\n// where the freshest value lives:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Compare the incoming ID sources while both producers are a stage earlier.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       stall_id,\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_reg_write,\n  input  logic       ex_mem_forwardable,\n  output logic       younger_rs1_match,\n  output logic       older_rs1_match,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  logic younger_rs1_q, younger_rs2_q, older_rs1_q, older_rs2_q;\n  logic older_writer;\n  assign younger_rs1_match = id_ex_rd != 0 && id_ex_rd == id_rs1;\n  assign older_writer = ex_mem_reg_write && ex_mem_rd != 0;\n  assign older_rs1_match = older_writer && ex_mem_rd == id_rs1;\n\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      younger_rs1_q <= younger_rs1_match;\n      younger_rs2_q <= id_ex_rd != 0 && id_ex_rd == id_rs2;\n      older_rs1_q   <= older_rs1_match;\n      older_rs2_q   <= older_writer && ex_mem_rd == id_rs2;\n    end\n  end\n\n  // EX has now resolved traps on the younger producer. A suppressed\n  // writer leaves the older match eligible, even if WB already retired.\n  assign fwd_rs1[0] = younger_rs1_q && ex_mem_forwardable;\n  assign fwd_rs2[0] = younger_rs2_q && ex_mem_forwardable;\n  assign fwd_rs1[1] = older_rs1_q && !fwd_rs1[0];\n  assign fwd_rs2[1] = older_rs2_q && !fwd_rs2[0];\nendmodule\nCROSS   := riscv32-unknown-elf\nCC      := $(CROSS)-gcc\n\n# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\n# (2K\n…[1158 of 4230 chars elided by tools/bench/transcript.py; sha256:e0925a7ea686b428]…\n       bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n", "exit_code": 0, "status": "completed"}}
