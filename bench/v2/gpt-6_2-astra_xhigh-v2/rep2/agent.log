{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"which riscv32-unknown-elf-gcc; cat cores/bench/rtl/forward_unit.sv; rg -n 'marker|istall|dStall|tohost|--' tools/eval/fpga.py | head -70\"","aggregated_output":"/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n// rtl/forward_unit.sv\n//\n// Operand forwarding. For each rs in the EX-stage's source list, picks\n// where the freshest value lives:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic [4:0] id_ex_rs1,\n  input  logic [4:0] id_ex_rs2,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs1) fwd_rs1 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs1) fwd_rs1 = 2'd2;\n    else                                                                  fwd_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 2'd2;\n    else                                                                  fwd_rs2 = 2'd0;\n  end\n\nendmodule\n71:# VexRiscv's iStall/dStall regression model — see\n77:COREMARK_SIM_FLAGS = [\"--bench\", \"--istall\", \"--dstall\"]\n211:    # 50M cycle ceiling: 2K CoreMark with ITERATIONS=10 + iStall+dStall\n226:    # Last line is the ebreak/maxcycles marker; second-to-last is the final retirement.\n228:        marker = json.loads(lines[-1])\n234:    if not marker.get('ebreak', False):\n245:    if marker.get('oob', False):\n249:    uart = marker.get('uart', '')\n258:    # If both markers aren't present, the run is INVALID for fitness\n262:    if not marker.get('bench_bracketed', False):\n264:                'reason': f'bench_markers_missing: '\n265:                          f'start={marker.get(\"bench_start_cycle\")} '\n266:                          f'stop={marker.get(\"bench_stop_cycle\")}'}\n267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n270:                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n280:    \"\"\"Require CoreMark's own validation and exact expected CRC markers,\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n","exit_code":0,"status":"completed"}}
