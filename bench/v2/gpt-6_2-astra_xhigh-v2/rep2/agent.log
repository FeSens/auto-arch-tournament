np.write_text(s)\nassert yaml.safe_load(p.read_text())==h\nprint('Validated',p)\nPY\npython \\\"\"'$TMPDIR/flagtrial/results.py\" r8 dedicatedmux flatone flatmux'", "aggregated_output": "Validated cores/bench/experiments/hypotheses/hyp-20261120-001-r15s0.yaml\nr8 1 77.987 cpu/u_if/match_linear_q_s0 -> cpu/u_if/early_q_16_s0 | stall_gen/imem_ready_s0 -> dmem_3_dmem_3_0_0_s | cpu/u_ex/early_result_q_2_s0 -> dmem_1_dmem_1_0_0_s\ndedicatedmux 1 64.322 cpu/u_fwd/younger_rs2_q_s0 -> cpu/u_id/reg_q.pc_24_s0 | cpu/u_fwd/younger_rs2_q_s0 -> cpu/u_id/reg_q.pc_25_s0 | cpu/u_fwd/younger_rs2_q_s0 -> cpu/u_id/reg_q.pc_3_s0\nflatmux 1 75.467 cpu/u_ex/old1_s0 -> cpu/u_id/reg_q.pc_16_s0 | cpu/u_ex/old1_s0 -> cpu/u_id/reg_q.pc_9_s0 | cpu/u_ex/old1_s0 -> cpu/u_if/retry_pc_9_s0\n", "exit_code": 0, "status": "completed"}}
