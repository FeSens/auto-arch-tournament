n_env(env, outdir))\ntools/eval/gowin.py:170:def build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\ntools/eval/gowin.py:173:    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\ntools/eval/gowin.py:175:                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\ntools/eval/gowin.py:179:def summarize(results: list[dict]) -> dict:\ntools/eval/gowin.py:199:\n…[7608 of 10680 chars elided by tools/bench/transcript.py; sha256:83f01d2acf15631d]…\ngn correction uses the registered final group, outside the recurrence.\n  assign magnitude = remainder_op_q ? remainder_q : quotient_q;\n  assign div_result = negate_q ? -magnitude : magnitude;\n`endif\n\nendmodule\n\n/* verilator lint_off DECLFILENAME */\nmodule mul_product (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n/* verilator lint_on DECLFILENAME */\n`ifdef RISCV_FORMAL_ALTOPS\n  always_comb begin\n    case (op)\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      default:    out = 32'b0;\n    endcase\n  end\n`else\n  logic signed [32:0] lhs, rhs;\n  logic signed [63:0] product;\n\n  assign lhs = $signed({a[31] && (op == ALU_MULH || op == ALU_MULHSU), a});\n  assign rhs = $signed({b[31] && op == ALU_MULH, b});\n  assign product = lhs * rhs;\n  assign out = op == ALU_MUL ? product[31:0] : product[63:32];\n`endif\nendmodule\n", "exit_code": 0, "status": "completed"}}
