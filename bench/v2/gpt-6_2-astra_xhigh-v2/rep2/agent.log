{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"cat >> cores/bench/test/test_pipeline.py <<'PY'\n\n@cocotb.test()\nasync def agree_loop_alias_and_stalled_correction(dut):\n    program = [NOP()] * (0x41c // 4)\n    program[:5] = [ADDI(1, 0, 5), ADDI(1, 1, -1), _b(-4, 0, 1, 1, 0x63),\n                   JAL(3, 0x400 - 12), SW(1, 0, 0x60)]\n    program[0x400 // 4:] = [NOP(), LW(7, 0, 0x40), BEQ(0, 0, 8),\n                            SW(1, 0, 0x64), JAL(4, 2), BEQ(0, 0, 2), EBREAK()]\n    waits = 0\n    fetches = []\n    def ready(pc, addr, ren, wen, wdata):\n        nonlocal waits\n        assert not wen\n        fetches.append(pc)\n        if ren:\n            assert (pc, addr) == (0x40c, 0x40)\n            waits += 1\n            return 0, int(waits > 3)\n        return 1, 1\n    rets, data = await _run(dut, program, {0x40: 41}, bus_ready=ready)\n    pcs = [0] + [4, 8] * 5 + [12, 0x400, 0x404, 0x408, 0x410, 0x414, 0x418]\n    assert [r['pc'] for r in rets] == pcs\n    assert [r['pc_next'] for r in rets[:-1]] == pcs[1:]\n    assert [r['order'] for r in rets] == list(range(len(pcs)))\n    assert [r['pc'] for r in rets if r['trap']] == [0x410, 0x414]\n    assert rets[-3]['rd'] == 0\n    assert {r['pc']:r['rd_wdata'] for r in rets}[12] == 16\n    assert waits == 4 and data == {0x40: 41}\n    # Successive correctly predicted loop iterations retire back to back.\n    assert all(rets[i]['cycle'] + 1 == rets[i+1]['cycle'] for i in range(5, 9))\n    jump = fetches.index(12)\n    assert fetches[jump+1] == 0x400\nPY\npython3 -m pytest -q cores/bench/test/test_pipeline.py > directed.log 2>&1 && tail -3 directed.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
