e per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs1) fwd_rs1 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs1) fwd_rs1 = 2'd2;\n    else                                                                  fwd_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 2'd2;\n    else                                                                  fwd_rs2 = 2'd0;\n  end\n\nendmodule\nSBY  7:41:29 [reg_ch0] engine_0: ##   0:00:00  Skipping step 15..\nSBY  7:41:29 [reg_ch0] engine_0: ##   0:00:00  Skipping step 16..\nSBY  7:41:29 [reg_ch0] engine_0: ##   0:00:00  Skipping step 17..\nSBY  7:41:30 [reg_ch0] engine_0: ##   0:00:00  Skipping step 18..\nSBY  7:41:30 [reg_ch0] engine_0: ##   0:00:00  Skipping step 19..\nSBY  7:41:30 [reg_ch0] engine_0: ##   0:00:00  Checking assumptions in step 20..\nSBY  7:41:30 [reg_ch0] engine_0: ##   0:00:01  Checking assertions in step 20..\nSBY  7:42:30 [reg_ch0] engine_0: ##   0:01:01  waiting for solver (1 minute)\n","exit_code":0,"status":"completed"}}
