{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python -B - /srv/hwebench/tmp/3c491641/5ef7bb43/split-multiplier-LqP2U4jo <<'PY'\nimport sys, shutil, pathlib, shlex, subprocess\nfrom pathlib import Path\nscratch=Path(sys.argv[1])\nrtl=scratch/'rtl'\nshutil.copytree('cores/bench/rtl',rtl)\ndef rep(file,a,b):\n    p=rtl/file\n    s=p.read_text()\n    assert s.count(a)==1,(p,a)\n    p.write_text(s.replace(a,b))\ndef section(file,left,right,body):\n    p=rtl/file\n    s=p.read_text()\n    start=s.index(left)\n    end=s.index(right,start)\n    p.write_text(s[:start]+body+s[end:])\nrep('core_pkg.sv','  // EX/MEM register payload.','''  typedef struct packed {\n    logic [31:0] p00;\n    logic signed [32:0] p01;\n    logic signed [32:0] p10;\n    logic [31:0] p11;\n  } mul_part_t;\n\n  // EX/MEM register payload.''')\nrep('core_pkg.sv','    logic [31:0] write_data;','    mul_part_t   parts;\\\\n    logic [31:0] write_data;')\nrep('core_pkg.sv','    logic [31:0] imm;','    logic        late_result;\\\\n    logic [31:0] imm;')\nrep('id_stage.sv','      reg_q.imm      <= imm;','''      reg_q.imm      <= imm;\n      reg_q.late_result <= dec_mem_read || (dec_alu_op >= ALU_MUL && dec_alu_op <= ALU_MULHSU);''')\nrep('core.sv','.id_ex_mem_read (id_ex_w.ctrl.mem_read)','.id_ex_mem_read (id_ex_w.late_result)')\nrep('alu.sv','  output logic [31:0] out,','''  input  logic [31:0] mul_a,\n  input  logic [31:0] mul_b,\n  output mul_part_t mul_parts,\n  output logic [31:0] out,''')\nsection('alu.sv','  // 64-bit products','    case (op)','''  wire signed [16:0] a0 = \"'$signed({1'\"'b0,mul_a[15:0]});\n  wire signed [16:0] b0 = \"'$signed({1'\"'b0,mul_b[15:0]});\n  wire signed [16:0] a1 = \"'$signed({(op == ALU_MULH || op == ALU_MULHSU) && mul_a[31],mul_a[31:16]});\n  wire signed [16:0] b1 = $signed({op == ALU_MULH && mul_b[31],mul_b[31:16]});\n  assign mul_parts.p00 = a0 * b0;\n  assign mul_parts.p01 = a0 * b1;\n  assign mul_parts.p10 = a1 * b0;\n  assign mul_parts.p11 = a1 * b1;\n  always_comb begin\n    shamt = b[4:0];\n\n'\"''')\nsection('alu.sv','\"'`else'\"\\\\n      ALU_MUL:', '      default:  out', '\"'`endif'\"\\\\n')\nrep('ex_stage.sv','    .out (alu_result),','''    .out (alu_result),\n    .mul_a (rs1),\n    .mul_b (rs2),\n    .mul_parts (mul_parts),''')\nrep('ex_stage.sv','  alu u_alu (','  mul_part_t mul_parts;\\\\n  alu u_alu (')\nrep('ex_stage.sv','      reg_q.write_data    <= rs2;','      reg_q.parts         <= mul_parts;\\\\n      reg_q.write_data    <= rs2;')\nrep('mem_stage.sv','  ex_mem_t reg_q;' if False else '  mem_wb_t reg_q;', '''  mem_wb_t reg_q;\n\n  wire [63:0] term0 = {32'b0,in.parts.p00};\n  wire [63:0] term1 = {{15{in.parts.p01[32]}},in.parts.p01,16'b0};\n  wire [63:0] term2 = {{15{in.parts.p10[32]}},in.parts.p10,16'b0};\n  wire [63:0] term3 = {in.parts.p11,32'b0};\n  wire [63:0] sum1 = term0 \"'^ term1 ''^ term2;\n  wire [63:0] carry1 = ((term0 & term1) | (term0 & term2) | (term1 & term2)) << 1;\n  wire [63:0] sum2 = sum1 ''^ carry1 ''^ term3;\n  wire [63:0] carry2 = ((sum1 & carry1) | (sum1 & term3) | (carry1 & term3)) << 1;\n  wire [63:0] product = sum2 + carry2;'\"''')\nrep('mem_stage.sv','      reg_q.alu_result <= in.alu_result;','''\"'`ifdef RISCV_FORMAL_ALTOPS\n      reg_q.alu_result <= in.alu_result;\n`else\n      case (in.ctrl.alu_op)\n        ALU_MUL: reg_q.alu_result <= product[31:0];\n        ALU_MULH, ALU_MULHU, ALU_MULHSU: reg_q.alu_result <= product[63:32];\n        default: reg_q.alu_result <= in.alu_result;\n      endcase\n`endif'\"''')\nelf = str(scratch/'coremark.elf')\nargs=shlex.split(subprocess.check_output(['make','-Bn','-f','bench/programs/Makefile','bench/programs/coremark.elf'],text=True))\nassert args[-2:]==['-o','bench/programs/coremark.elf']\nargs[-1]=elf\nsubprocess.run(args,check=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
