{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"cat >> cores/bench/test/test_pipeline.py <<'PY'\n\n@cocotb.test()\nasync def predict_and_recover_across_stalls(dut):\n    words = {\n        0: JAL(0, 0x100),\n        0x100: ADDI(1, 0, 4),\n        0x104: ADDI(1, 1, -1),\n        0x108: _b(-4, 0, 1, 1, 0x63),\n        0x10c: JAL(0, 0x500-0x10c),\n        0x500: ADDI(4, 0, 0x44),\n        0x504: LW(5, 4, 0),\n        0x508: BEQ(0, 0, 8),\n        0x50c: SW(5, 4, 4),\n        0x510: BEQ(0, 0, 2),\n        0x514: ADDI(2, 0, 0x524),\n        0x518: JALR(6, 2, 0),\n        0x51c: SW(2, 4, 4),\n        0x524: EBREAK(),\n    }\n    program = [words.get(a, EBREAK()) for a in range(0, 0x528, 4)]\n    waits = 0\n    release = False\n    def bus(pc, addr, ren, wen, wdata):\n        nonlocal waits, release\n        assert not wen, \\\"wrong-path store issued\\\"\n        if release:\n            assert pc == 0x510\n            release = False\n        if ren:\n            assert addr == 0x44 and pc == 0x50c\n            waits += 1\n            if waits <= 3:\n                return 1, 0\n            release = True\n            return 0, 1\n        return 1, 1\n    rets, _ = await _run(dut, program, bus_ready=bus)\n    assert waits == 4 and not release\n    seq = [0, 0x100] + [0x104, 0x108] * 4 + [0x10c, 0x500, 0x504, 0x508, 0x510, 0x514, 0x518, 0x524]\n    assert [r[\\\"pc\\\"] for r in rets] == seq\n    assert [r[\\\"pc_next\\\"] for r in rets[:-1]] == seq[1:]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert [r[\\\"pc\\\"] for r in rets if r[\\\"trap\\\"]] == [0x510]\n    for a,b in zip(rets, rets[1:]):\n        if a[\\\"pc\\\"] == 0x10c or (a[\\\"pc\\\"] == 0x108 and a[\\\"order\\\"] == 7):\n            assert b[\\\"cycle\\\"] == a[\\\"cycle\\\"] + 1\n        if a[\\\"pc\\\"] == 0x108 and b[\\\"pc\\\"] == 0x10c:\n            assert b[\\\"cycle\\\"] == a[\\\"cycle\\\"] + 2\nPY\npytest -q cores/b