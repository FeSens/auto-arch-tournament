{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nd=Path(os.environ['TMPDIR'])/'r14grant'\nshutil.copytree('cores/bench/rtl',d)\ndef edit(f,sub,rep):\n p=d/f;s=p.read_text();assert sub in s;p.write_text(s.replace(sub,rep,1))\nedit('core.sv','logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','logic [2:0] fwd_rs1_sel, fwd_rs2_sel;')\nedit('core.sv','logic annul, ex_likely_direct, ex_fence_i;', '''logic annul, replay_annul, writer_cancel, cancel_q, ex_likely_direct, ex_fence_i;\n  assign annul = replay_annul || cancel_q;\n  always_ff @(posedge clock) begin\n    if (reset) cancel_q <= 1'b0;\n    else if (\"'!stall_id) cancel_q <= writer_cancel;\n  end'\"''')\nedit('core.sv','.annul           (annul)','.annul           (replay_annul)')\nedit('core.sv','.div_wait        (div_wait),','.writer_cancel   (writer_cancel),\\\\n    .div_wait        (div_wait),')\nedit('core.sv','.ex_mem_forwardable (ex_mem_w.forwardable),', '.expect_write       (id_ex_w.ctrl.reg_write && \"'!id_ex_w.ctrl.late_result),'\"')\nedit('ex_stage.sv','logic [1:0]         fwd_rs1_sel','logic [2:0]         fwd_rs1_sel')\nedit('ex_stage.sv','logic [1:0]         fwd_rs2_sel','logic [2:0]         fwd_rs2_sel')\nedit('ex_stage.sv','fwd_rs1_sel == 2\\\\'b00','fwd_rs1_sel[2]')\nedit('ex_stage.sv','fwd_rs2_sel == 2\\\\'b00','fwd_rs2_sel[2]')\nedit('ex_stage.sv','output logic               div_wait,','output logic               writer_cancel, div_wait,')\nedit('ex_stage.sv','  // Check each target', '''  assign writer_cancel = in.ctrl.reg_write && \"'!ctrl_with_trap.reg_write && in.rd != 0;\n  // Check each target'\"''')\np=d/'forward_unit.sv';s=p.read_text().replace('ex_mem_forwardable','expect_write').replace('output logic [1:0]','output logic [2:0]')\na=s.index('  logic younger_rs1_q')\nb=s.index('endmodule',a)\ns=s[:a]+'''  logic young1, young2, old1, old2;\n  logic older_writer;\n  assign younger_rs1_match = id_ex_rd \"'!= 0 && id_ex_rd == id_rs1;\n  assign older_writer = ex_mem_reg_write && ex_mem_rd != 0;\n  assign older_rs1_match = older_writer && ex_mem_rd == id_rs1;\n  assign young1=expect_write && younger_rs1_match;\n  assign young2=expect_write && id_ex_rd!=0 && id_ex_rd==id_rs2;\n  assign old1=older_rs1_match;\n  assign old2=older_writer && ex_mem_rd==id_rs2;\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      fwd_rs1 <= {!young1&&!old1,!young1&&old1,young1};\n      fwd_rs2 <= {!young2&&!old2,!young2&&old2,young2};\n    end\n  end\n'\"'''+s[b:];p.write_text(s)\nPY\nRTL_DIR=\\\"\"'$TMPDIR/r14grant\" OBJ_DIR=\"$TMPDIR/r14grantobj\" NRET=1 bash test/cosim/build.sh > \"$TMPDIR/r14grantbuild.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
