{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/predictor_test\"\ncp -r cores/bench/test \"$TMPDIR/predictor_test/test\"\npython3 - <<'\"'PY'\nimport os\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'predictor_test/test/test_pipeline.py'\ns=p.read_text().replace('               unready_instr=0xFFFFFFFF):','               unready_instr=0xFFFFFFFF, update_imem=None):')\ns=s.replace('        # Drive next cycle\\\\'s imem fetch and dmem read combinationally.','''        if update_imem:\n            update_imem(imem, ia, da, wen, wdata, dready)\n\n        # Drive next cycle's imem fetch and dmem read combinationally.''')\ns += '''\n\n@cocotb.test()\nasync def replay_denied_loop_and_cancel_store_on_exit(dut):\n    # Move past the power-on invalidation sweep before testing warm entries.\n    program = [NOP()] * 520 + [ADDI(2, 0, 12)]\n    start = len(program) * 4\n    inc = ADDI(1, 1, 1)\n    store = SW(1, 0, 0x40)\n    branch = _b(-8, 2, 1, 1, 0x63)\n    program += [store, inc, branch, EBREAK()]\n    visits = denials = exit_wait = 0\n    writes = []\n\n    def ready(pc, addr, ren, wen, data):\n        nonlocal visits, denials, exit_wait\n        assert not ren\n        if wen:\n            assert (addr, wen) == (0x40, 15)\n            writes.append(data)\n        if pc == start:\n            visits += 1\n        if visits >= 5 and start <= pc < start + 12:\n            denials += 1\n            return 0, 1\n        if pc == start + 12 and exit_wait < 3:\n            exit_wait += 1\n            return 0, 1\n        return 1, 1\n\n    rets, _ = await _run(dut, program, max_cycles=750, bus_ready=ready,\n                         unready_instr=SW(7, 0, 0x60))\n    loop_rets = [r for r in rets if start <= r[\\\"pc\\\"] < start + 12]\n    assert len(loop_rets) == 36 and denials == 24 and exit_wait == 3\n    assert [r[\\\"pc\\\"] for r in loop_rets] == [start, start + 4, start + 8] * 12\n    assert all(b[\\\"cycle\\\"] == a[\\\"cycle\\\"] + 1 for a,b in zip(loop_rets,loop_rets[1:]))\n    assert writes == list(range(12))\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert rets[-1][\\\"pc\\\"] == start + 12 and loop_rets[-1][\\\"pc_next\\\"] == start + 12\n\n\n@cocotb.test()\nasync def fence_i_discards_a_warm_successor(dut):\n    program = [NOP()] * 520 + [ADDI(2, 0, 9)]\n    loop = len(program) * 4\n    old, new = ADDI(7, 7, 1), ADDI(7, 7, 5)\n    fence = 0x0000100f\n    bne = lambda rs1,rs2,imm: _b(imm, rs2, rs1, 1, 0x63)\n    program += [ADDI(1, 1, 1), old, bne(1, 2, -8),\n                bne(3, 0, 20), ADDI(3, 0, 1), ADDI(2, 2, 1),\n                fence, JAL(0, -28), EBREAK()]\n    changed = False\n    held = 0\n\n    def update(imem, pc, da, wen, wdata, dready):\n        nonlocal changed\n        if pc == loop + 24:\n            imem[loop + 4] = new\n            changed = True\n\n    def ready(pc, addr, ren, wen, data):\n        nonlocal held\n        assert not (ren or wen)\n        if changed and pc == loop + 4 and held < 3:\n            held += 1\n            return 0, 1\n        return 1, 1\n\n    rets, _ = await _run(dut, program, max_cycles=750, bus_ready=ready,\n                         update_imem=update,unready_instr=SW(1,0,0x60))\n    assert changed and held == 3\n    assert [r[\\\"insn\\\"] for r in rets if r[\\\"pc\\\"] == loop + 4] == [old] * 9 + [new]\n    assert [r for r in rets if r[\\\"pc\\\"] == loop + 4][-1][\\\"rd_wdata\\\"] == 14\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert not any(r[\\\"trap\\\"] for r in rets)\n'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
