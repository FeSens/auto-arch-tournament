{"type":"item.started","item":{"id":"item_130","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nb=Path('/srv/hwebench/tmp/3c491641/ab1ccee8/bench-r5s1-ko6grqtg/validstream/test/test_pipeline.py')\ns=b.read_text().replace('unready_instr=0xFFFFFFFF):','unready_instr=0xFFFFFFFF, patch_words=None):')\ns=s.replace('        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())', '''        if patch_words is not None:\n            patch_words(ia, imem)\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())''')\ns+='''\n@cocotb.test()\nasync def fallthrough_replay_then_exit(dut):\n    counts = {4:0, 8:0}\n    def ready(pc, addr, ren, wen, data):\n        assert wen == 0\n        if pc in counts:\n            counts[pc] += 1\n        return (not ((pc == 4 and counts[4] in (2, 3)) or\n                     (pc == 8 and counts[8] > 1))), 1\n    program = [ADDI(3,0,3), ADDI(1,1,1), ADDI(2,2,1),\n               _b(-8,3,1,1,0x63), EBREAK()]\n    rs,_ = await _run(dut,program,bus_ready=ready,unready_instr=SW(1,0,0))\n    assert [r[\\\"pc\\\"] for r in rs] == [0]+[4,8,12]*3+[16]\n    assert counts == {4:5,8:3}\n    assert [r[\\\"rd_wdata\\\"] for r in rs if r[\\\"pc\\\"]==8] == [1,2,3]\n    assert [r[\\\"order\\\"] for r in rs] == list(range(len(rs)))\n\n@cocotb.test()\nasync def fence_clears_replay(dut):\n    visits = 0\n    def ready(pc, addr, ren, wen, data):\n        nonlocal visits\n        assert wen == 0\n        if pc == 8: visits += 1\n        return (pc \"'!= 8 or visits not in (2,3)), 1\n    def patch(pc, words):\n        if pc == 20: words[8] = ADDI(2,2,5)\n    program = [ADDI(3,0,2), ADDI(1,1,1), ADDI(2,2,1), BEQ(1,3,12),\n               0x0000100f, JAL(0,-16), EBREAK()]\n    rs,_ = await _run(dut,program,bus_ready=ready,patch_words=patch,unready_instr=SW(1,0,0))\n    assert visits == 4\n    assert [r[\"rd_wdata\"] for r in rs if r[\"pc\"]==8] == [1,6]\n\n@cocotb.test()\nasync def replay_window_crossing(dut):\n    visits = {512:0,516:0}\n    def ready(pc,addr,ren,wen,data):\n        assert wen == 0\n        if pc not in visits: return 1,1\n        visits[pc] += 1\n        return visits[pc] > 2,1\n    program = [ADDI(1,0,1), ADDI(2,0,2), JAL(0,500)] + [NOP()] * 124\n    program += [ADDI(4,1,4), ADDI(5,4,5), ADDI(6,5,6), EBREAK()]\n    rs,_=await _run(dut,program,bus_ready=ready,unready_instr=SW(1,0,0))\n    assert [r[\"pc\"] for r in rs] == [0,4,8,508,512,516,520]\n    assert [r[\"rd_wdata\"] for r in rs[-4:-1]] == [5,10,16]\n'\"'''\nb.write_text(s)\nPY\ncd /srv/hwebench/tmp/3c491641/ab1ccee8/bench-r5s1-ko6grqtg/validstream && python -m pytest -q test/test_pipeline.py > replay-tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
