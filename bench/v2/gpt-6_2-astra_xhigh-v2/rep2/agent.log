{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py | tail -235'", "aggregated_output": "        EBREAK(),\n    ]\n    expected_bus = [\n        (0, 15, 0x40, dividend),\n        (0, 15, 0x44, -4 & mask),\n        (1, 0, 0x40, 0),\n        (0, 15, 0x48, unsigned_remainder),\n    ]\n    transfers = 0\n    wait_cycles = 0\n    fetch_stalls = {16: 2, 36: 9}\n\n    def bus_ready(pc, addr, ren, wen, wdata):\n        nonlocal transfers, wait_cycles\n        iready = not fetch_stalls.get(pc, 0)\n        if not iready:\n            fetch_stalls[pc] -= 1\n        if not (ren or wen):\n            assert wait_cycles == 0, \"request withdrawn during a data stall\"\n            return iready, 1\n        assert (ren, wen, addr, wdata if wen else 0) == expected_bus[transfers]\n        if transfers == 0:\n            assert pc == 16, \"the divide must wait behind the older store\"\n        if wait_cycles < 3:\n            wait_cycles += 1\n            return iready, 0\n        transfers += 1\n        wait_cycles = 0\n        return iready, 1\n\n    rets, dmem = await _run(dut, program, bus_ready=bus_ready)\n    assert transfers == len(expected_bus) and not any(fetch_stalls.values())\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert all(not r[\"trap\"] and r[\"pc_next\"] == r[\"pc\"] + 4 for r in rets)\n    for idx, lhs, rhs, result in [\n        (3, dividend, 6, -16 & mask),\n        (4, -16 & mask, 6, -4 & mask),\n        (7, dividend, 6, unsigned_quotient),\n        (8, dividend, unsigned_quotient, unsigned_remainder),\n    ]:\n        r = rets[idx]\n        assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"]) == (lhs, rhs, result)\n        assert r[\"rd\"] == ((program[idx] >> 7) & 31)\n        assert r[\"mem_rmask\"] ==