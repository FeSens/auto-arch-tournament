{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"git log --oneline -20 && cat formal/wrapper_si.sv | head -170 && rg -n 'replay|denied' test/cosim/main.cpp\"", "aggregated_output": "7a4275e log: hyp-20261120-003-r10s2 regression\na50746a log: hyp-20261120-002-r10s1 regression\n3c4b6db log: hyp-20261120-001-r10s0 regression\n654241b log: hyp-20261120-003-r9s2 regression\n0a0f99c log: hyp-20261120-002-r9s1 improvement\n15a50dc log: hyp-20261120-001-r9s0 regression\n753a7c9 hyp-20261120-002-r9s1: Register the rs1 field separately in the successor replay table (+5.2%)\nab68bca log: hyp-20261120-003-r8s2 regression\neb8484b log: hyp-20261120-002-r8s1 regression\naa22685 log: hyp-20261120-001-r8s0 improvement\nacfa217 hyp-20261120-001-r8s0: Share seven trial subtractors between radix-32 and radix-8 division (+10.4%)\nb4000d2 log: hyp-20261120-003-r7s2 regression\nade5919 log: hyp-20261120-002-r7s1 regression\n0ab85d1 log: hyp-20261120-001-r7s0 improvement\n160d457 hyp-20261120-001-r7s0: Retime the M-extension forwarding path from decode through MEM/WB (+12.1%)\n49426d6 log: hyp-20261120-003-r6s2 improvement\n83e40bf log: hyp-20261120-002-r6s1 regression\n5914540 log: hyp-20261120-001-r6s0 regression\nf38bfbe hyp-20261120-003-r6s2: Predict same-page data addresses to forward loads from EX/MEM (+14.6%)\n044260d log: hyp-20261120-003-r5s2 improvement\n// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n        .io_rvfi_trap_0     (rvfi_trap),\n        .io_rvfi_halt_0     (rvfi_halt),\n        .io_rvfi_intr_0     (rvfi_intr),\n        .io_rvfi_mode_0     (rvfi_mode),\n        .io_rvfi_ixl_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\n", "exit_code": 1, "status": "failed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/r11-load\"\ncp -r cores/bench/rtl \"$TMPDIR/r11-load/\"\ncat > \"$TMPDIR/r11-load/makeproto.py\" <<'\"'PY'\nimport os,sys\nfrom pathlib import Path\nroot=Path(os.environ['TMPDIR'])/sys.argv[1]/'rtl'\ndef edit(f,x,y):\n p=root/f\n s=p.read_text()\n assert s.count(x)==1,(f,x,s.count(x))\n p.write_text(s.replace(x,y))\nedit('id_stage.sv','  input  logic              repair,','  output logic [8:0]        load_index,\\\\n  input  logic              repair,')\nedit('id_stage.sv','  always_ff @(posedge clock) begin','  assign load_index = low_sum[10:2];\\\\n\\\\n  always_ff @(posedge clock) begin')\nedit('core.sv','  logic repair;','  logic repair, load_hit;\\\\n  logic [8:0] load_index;')\nedit('core.sv','    .lw_word  (io_dmemRData),','    .lw_word  (io_dmemRData),\\\\n    .load_index(load_index),')\nedit('core.sv','    .div_wait        (div_wait),','    .div_wait        (div_wait),\\\\n    .bus_ready       (io_dmemReady),\\\\n    .load_index      (load_index),\\\\n    .load_hit        (load_hit),\\\\n    .hold_slot       (stall_id),')\nedit('core.sv','    .dmem_ready     (io_dmemReady),','    .dmem_ready     (io_dmemReady || load_hit),')\nedit('ex_stage.sv','  output logic               repair,','  input  logic               bus_ready, hold_slot,\\\\n  input  logic [8:0]         load_index,\\\\n  output logic               load_hit,\\\\n  output logic               repair,')\nedit('ex_stage.sv','  logic [15:0] halfword;', '''  logic [31:0] replay_word, raw_word;\n  logic [8:0]  replay_index;\n  logic [44:0] entry;\n  (* syn_ramstyle = \\\"block_ram\\\", ram_style = \\\"block\\\" *)\n  logic [44:0] words [0:511]; // tag [19:11], byte valid mask, data\n  logic [8:0] sweep_addr, wr_addr;\n  logic sweeping, wr_en, usable_q, collision, normal_ram, fill;\n  logic [3:0] required_lanes, fill_mask;\n  logic [31:0] fill_word;\n  assign normal_ram = in.mem_addr[31:20] == 0;\n  assign required_lanes = access_mask(in.ctrl.mem_width, in.mem_addr[1:0]);\n  assign fill = normal_ram && bus_ready && (dmem_ren || (|dmem_wen));\n  assign fill_word = dmem_ren ? dmem_rdata : dmem_wdata;\n  assign fill_mask = dmem_ren ? 4'hf : dmem_wen;\n  assign wr_en = sweeping || fill;\n  assign wr_addr = sweeping ? sweep_addr : in.mem_addr[10:2];\n  assign replay_index = repair ? repaired_addr[10:2] : load_index;\n  assign collision = wr_en && wr_addr == replay_index;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sweeping <= 1'b1;\n      sweep_addr <= 9'b0;\n    end else if (sweeping) begin\n      sweeping <= \"'!(&sweep_addr);\n      sweep_addr <= sweep_addr + 1'\"'b1;\n    end\n    if (wr_en)\n      words[wr_addr] <= {in.mem_addr[19:11], sweeping ? 4'b0 : fill_mask, fill_word};\n    if (\"'!hold_slot || repair) entry <= words[replay_index];\n    if (reset || sweeping)\n      usable_q <= 1'\"'b0;\n    else if (\"'!hold_slot || repair)\n      usable_q <= !collision;\n  end\n  assign replay_word = entry[31:0];\n  assign load_hit = dmem_ren && normal_ram && usable_q &&\n                    entry[44:36] == in.mem_addr[19:11] &&\n                    (entry[35:32] & required_lanes) == required_lanes;\n  assign raw_word = bus_ready ? dmem_rdata : replay_word;\n  logic [15:0] halfword;'\"''')\nedit('ex_stage.sv','? dmem_rdata[31:16] : dmem_rdata[15:0]','? raw_word[31:16] : raw_word[15:0]')\nedit('ex_stage.sv','default: load_data = dmem_rdata;','default: load_data = raw_word;')\nedit('ex_stage.sv','reg_q.mem_rdata     <= dmem_rdata;','reg_q.mem_rdata     <= raw_word;')\nPY\npython \\\"\"'$TMPDIR/r11-load/makeproto.py\" r11-load'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
