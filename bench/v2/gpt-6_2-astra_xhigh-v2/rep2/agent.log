{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python -B - /srv/hwebench/tmp/3c491641/5ef7bb43/split-multiplier-LqP2U4jo <<'PY'\nfrom pathlib import Path\nimport sys,os,json,subprocess\nfrom tools.eval.fpga import validate_coremark_uart\nscratch=Path(sys.argv[1])\nenv=dict(os.environ, RTL_DIR=str(scratch/'rtl'),OBJ_DIR=str(scratch/'obj'), NRET='1')\nr=subprocess.run(['bash','test/cosim/build.sh'],env=env,capture_output=True,text=True)\nassert not r.returncode,(r.stdout+r.stderr)[-3000:]\nfor elf in ['coremark.elf']:\n    command=[str(scratch/'obj'/'cosim_sim'),str(scratch/elf),'50000000','--bench','--istall','--dstall']\n    r=subprocess.run(command,capture_output=True,check=True,text=True)\n    marker=json.loads(r.stdout.splitlines()[-1])\n    assert marker['ebreak'] and marker['bench_bracketed'] and not marker['oob']\n    assert validate_coremark_uart(marker['uart'],10)[0]\n    print(elf, 'cycles',marker['bench_stop_cycle']-marker['bench_start_cycle'],'CRC validated')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
