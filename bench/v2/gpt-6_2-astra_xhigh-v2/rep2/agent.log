{"type":"item.started","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -c \"cat >/srv/hwebench/tmp/3c491641/af02d159/tmp.py5X0I7rYM/branch.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path(__file__).parent\nfor mode in ('bpair','bplain','bgl','bchunks'):\n d=root/mode;shutil.copytree('cores/bench/rtl',d,dirs_exist_ok=True)\n p=d/'ex_stage.sv';s=p.read_text();start=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');end=s.index('    branch_taken',start)\n groups=range(4)\n body1='''    logic eq, lt;\n    logic [31:0] xk, yk;\n    begin\n      xk = x \"'^ {signed_mode,31'\"'b0};\n      yk = y \"'^ {signed_mode,31'\"'b0};\n      eq = x == y;\n      lt = xk < yk;\n      cmp = less_mode ? lt : eq;\n    end\n'''\n body2='''    logic [3:0] lt, eq;\n    logic [31:0] xk, yk;\n    begin\n      xk = x \"'^ {signed_mode,31'\"'b0};\n      yk = y \"'^ {signed_mode,31'\"'b0};\n      for (int i=0;i<4;i++) begin\n        eq[i] = x[i*8+:8] == y[i*8+:8];\n        lt[i] = xk[i*8+:8] < yk[i*8+:8];\n      end\n      cmp = less_mode ? (lt[3] || (eq[3] && lt[2]) || (&eq[3:2] && lt[1]) || (&eq[3:1] && lt[0])) : &eq;\n    end\n'''\n pre='''  function automatic logic cmp(input logic [31:0] x,y,input logic signed_mode,less_mode);\n'''+(body2 if mode=='bchunks' else body1)+'''  endfunction\n  logic signed_mode,less_mode,base_cond;\n  assign signed_mode = \"'!in.ctrl.branch_op[1];\n  assign less_mode = in.ctrl.branch_op[2];\n'\"'''\n if mode in ('bpair','bchunks'):\n  pre+='''  logic selected [0:2];\n  wire [31:0] xs[0:2], ys[0:2];\n  assign xs[0]=in.rs1_val; assign xs[1]=fwd_ex_mem; assign xs[2]=fwd_mem_wb;\n  assign ys[0]=in.rs2_val; assign ys[1]=fwd_ex_mem; assign ys[2]=fwd_mem_wb;\n  for (genvar i=0;i<3;i++) begin\n    wire [2:0] v;\n    for (genvar j=0;j<3;j++) begin\n      assign v[j]=cmp(xs[i],ys[j],signed_mode,less_mode);\n    end\n    assign selected[i]=v[fwd_rs2_sel];\n  end\n  assign base_cond=selected[fwd_rs1_sel];\n'''\n elif mode=='bgl':\n  pre+='''  logic c0, cy, co;\n  assign c0=cmp(rs1,in.rs2_val,signed_mode,less_mode);\n  assign cy=cmp(rs1,fwd_ex_mem,signed_mode,less_mode);\n  assign co=cmp(rs1,fwd_mem_wb,signed_mode,less_mode);\n  assign base_cond=(c0 && fwd_rs2_sel==0) || (cy && fwd_rs2_sel[0]) || (co && fwd_rs2_sel[1]);\n'''\n else:\n  pre+='  assign base_cond=cmp(rs1,rs2,signed_mode,less_mode);\\\\n'\n s=s[:start]+pre+'''  always_comb begin\n    branch_cond = base_cond \"'^ in.ctrl.branch_op[0];\n'\"'''+s[end:];p.write_text(s)\nPY\npython /srv/hwebench/tmp/3c491641/af02d159/tmp.py5X0I7rYM/branch.py\npython - <<'PY'\nimport json\nfrom pathlib import Path\nfor n in 'tiny small big asym asym9 asym11'.split():\n p=Path('/srv/hwebench/tmp/3c491641/af02d159/tmp.py5X0I7rYM')/(n+'.time')\n if p.stat().st_size: print(n,json.loads(p.read_text())['fmax_mhz'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
