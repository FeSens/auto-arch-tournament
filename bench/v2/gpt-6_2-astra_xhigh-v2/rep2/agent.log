dut.b.value = 0xBABE\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    await _issue(dut, op, a, b)\n    for _ in range(6):\n        assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _tick(dut)\n\n    pending = int(dut.div_result.value)\n    for delay in range(hold_cycles + 1):\n        assert int(dut.div_valid.value) and not int(dut.div_ready.value)\n        assert int(dut.div_result.value) == pending\n        if delay < \n…[3196 of 6268 chars elided by tools/bench/transcript.py; sha256:54037aa831823e83]…\ngrams/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n50:// ~22% stall). Replicating exactly so CoreMark/MHz numbers from this\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\n69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\n70:    //           (tools/eval/fpga.py:run_coremark_ipc) passes BOTH so the\n74:    bool istall = false;\n75:    bool dstall = false;\n78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\n79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\n118:        // slowed down by unrelated stalls.\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n", "exit_code": 0, "status": "completed"}}
