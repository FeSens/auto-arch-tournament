{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nf=Path('/srv/hwebench/tmp/3c491641/83938d59/divider-study.WpG0Gb/retimed/cores/bench/test/test_alu.py')\ns=f.read_text()\ntag='@cocotb.test()\\\\nasync def divider_reset(dut):'\ns=s.replace(tag,'''@cocotb.test()\nasync def divider_mode_boundary(dut):\n    await _setup(dut)\n    for q in (0, 1, 7, 8, 0x3fff, 0x7ffe, 0x7fff):\n        for d in (0x20000, 0x1ffff, 0x20001):\n            for a in (q*d-1, q*d, q*d+1, MASK32):\n                if not 0 <= a <= MASK32:\n                    continue\n                await _check_div(dut, ALU_DIVU, a, d, a // d, hold_cycles=2)\n                await _check_div(dut, ALU_REMU, a, d, a % d)\n                for b in (d, -d):\n                    dividend = a if a < 2**31 else a - 2**32\n                    quo = abs(dividend) // abs(b)\n                    if (dividend < 0) \"'!= (b < 0):\n                        quo = -quo\n                    await _check_div(dut, ALU_DIV, a, b, quo)\n                    await _check_div(dut, ALU_REM, a, b, dividend - quo * b)\n\n'\"''' + tag)\nf.write_text(s)\nPY\npython -m pytest -q --rootdir=. test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
