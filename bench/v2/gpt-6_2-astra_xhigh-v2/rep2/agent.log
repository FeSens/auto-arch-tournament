{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/latediv/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def early_tags_across_trap_and_held_store(dut):\n    program = [\n        ADDI(5, 0, 1), ADDI(5, 0, 7), ADD(6, 5, 5),\n        ADDI(5, 0, 19), JAL(5, 2), ADD(7, 5, 5),\n        ADDI(8, 0, 73), NOP(), SW(8, 0, 0x60), EBREAK()\n    ]\n    waits = 0\n    accepted = 0\n    def bus_ready(pc, addr, ren, wen, wdata):\n        nonlocal waits, accepted\n        if wen:\n            assert (addr, wen, wdata) == (0x60, 15, 73)\n            if waits < 4:\n                waits += 1\n                return 1, 0\n            accepted += 1\n        return 1, 1\n    rets, data = await _run(dut, program, bus_ready=bus_ready)\n    assert [r['insn'] for r in rets] == program\n    assert [r['order'] for r in rets] == list(range(len(program)))\n    assert (rets[2]['rs1_rdata'],rets[2]['rs2_rdata'],rets[2]['rd_wdata']) == (7,7,14)\n    assert (rets[4]['trap'],rets[4]['rd']) == (1,0)\n    assert (rets[5]['rs1_rdata'],rets[5]['rs2_rdata'],rets[5]['rd_wdata']) == (19,19,38)\n    assert waits == 4 and accepted == 1 and data[0x60] == 73\nPY\npytest -q --rootdir=\\\"\"'$TMPDIR/latediv\" \"$TMPDIR/latediv/test/test_pipeline.py\" > \"$TMPDIR/latediv/directed.log\" 2>&1 && tail -3 \"$TMPDIR/latediv/directed.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
