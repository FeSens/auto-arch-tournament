{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'git diff --check; cp cores/bench/rtl/alu.sv \"$TMPDIR/divider-saved-v2.sv\"; sed -n '\"'300,405p' cores/bench/test/test_alu.py\"","aggregated_output":"                        a = -a if k & 1 else a\n                        d = -d if k & 2 else d\n                    await _check_div(dut, op, a, d, _div_reference(op, a, d))\n\n    # Exercise all four suffixes immediately below and at each shared\n    # threshold, and with the upper residual bits set in a winning trial.\n    d = 0x3FFF\n    for j in range(1, 8):\n        for offset in (-1, 0, (d - 1) // 4):\n            for suffix in range(4):\n                a = ((j * d + offset) << 2) | suffix\n                for op in (ALU_DIVU, ALU_REMU):\n                    await _check_div(dut, op, a, d, _div_reference(op, a, d))\n\n    # The largest wide quotient uses all 18 bits. Follow each zero-\n    # divisor result with a wide divide to check the saved state.\n    for a in (MASK32, MASK32 - 0x3FFF, 0x80000001):\n        for op in (ALU_DIVU, ALU_REMU, ALU_DIV, ALU_REM):\n            for d in (0, 0x4000, 0, -0x4001):\n                await _check_div(dut, op, a, d, _div_reference(op, a, d), hold_cycles=2)\n\n\n@cocotb.test()\nasync def divider_radix8_boundaries(dut):\n    await _setup(dut)\n    divisors = {0, 1, 2, 3, 4, 0x1234567, MASK32 - 1, MASK32}\n    for k in range(2, 8):\n        # k*D just below or above the width of a 32-bit dividend.\n        divisors.update((MASK32 // k, MASK32 // k + 1))\n\n    pairs = set()\n    for divisor in divisors:\n        for prefix in range(4):\n            pairs.add(((prefix << 30) | 0x2D35A6C7, divisor))\n        for k in range(1, 8):\n            for delta in (-1, 0, 1):\n                boundary = k * divisor + delta\n                if 0 <= boundary <= MASK32:\n                    pairs.add((boundary, divisor))\n                    # Also exercise this boundary one radix-8 digit earlier.\n                    dividend = (boundary << 3) | 5\n                    if dividend <= MASK32:\n                        pairs.add((dividend, divisor))\n\n    for dividend, divisor in sorted(pairs):\n        q, r = divmod(dividend, divisor) if divisor else (MASK32, dividend)\n        await _check_div(dut, ALU_DIVU, dividend, divisor, q)\n        await _check_div(dut, ALU_REMU, dividend, divisor, r)\n\n\n@cocotb.test()\nasync def divider_reset(dut):\n    await _setup(dut)\n    for clocks_before_reset in (3, 6):\n        await _issue(dut, ALU_DIVU, 0x12345678, 0x55)\n        for _ in range(clocks_before_reset):\n            await _tick(dut)\n        assert int(dut.div_valid.value) == (clocks_before_reset == 6)\n        await _setup(dut)\n        await _check_div(dut, ALU_REM, -17, 3, -2)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_mul_product_runner():\n    run_cocotb(toplevel=\"mul_product\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_mul_product\")\n","exit_code":0,"status":"completed"}}
