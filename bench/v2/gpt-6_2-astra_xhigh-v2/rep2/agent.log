{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/membank.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nr=Path(os.environ['TMPDIR'])\nfor name,source in [('membank','divmem'),('divbank','reverse')]:\n s=r/name;shutil.copytree(r/source/'rtl',s/'rtl')\n p=s/'rtl/alu.sv';t=p.read_text()\n q_expr='{quotient_q[26:0], digit[0][1:0], digit[1]}' if source=='divmem' else '{quotient_q[26:0], digit[0], digit[1][1:0]}'\n t=t.replace('groups_left \"'!= 0 || (div_valid && div_consume)'\"','groups_left \"'!= 0'\"')\n t=t.replace('  assign magnitude = remainder_op_q ? remainder_q : quotient_q;\\\\n  assign div_result = negate_q ? -magnitude : magnitude;', f'''  logic completed_negate;\n  always_ff @(posedge clock) begin\n    if (div_valid && div_consume) begin\n      magnitude <= remainder_op_q ? next_remainder : {q_expr};\n      completed_negate <= negate_q;\n    end\n  end\n  assign div_result = completed_negate ? -magnitude : magnitude;''')\n i=t.index('  always_ff',t.index('\"'`ifdef RISCV_FORMAL_ALTOPS'\"'));j=t.index('\"'`else'\"',i)\n t=t[:i]+'  logic [31:0] alt_q;\\\\n'+t[i:j].replace('div_result <=','alt_q <=').replace('  end\\\\n', '  end\\\\n',1)+'''  always_ff @(posedge clock) begin\n    if (div_valid && div_consume) div_result <= alt_q;\n  end\n'''+t[j:]\n p.write_text(t)\nPY\npython \\\"\"'$TMPDIR/membank.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
