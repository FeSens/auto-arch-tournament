nner():\n    run_cocotb(\\\"core\\\", [\\\"core_pkg.sv\\\",\\\"alu.sv\\\",\\\"decoder.sv\\\",\\\"imm_gen.sv\\\",\\\"reg_file.sv\\\",\\\"if_stage.sv\\\",\\\"id_stage.sv\\\",\\\"ex_stage.sv\\\",\\\"mem_stage.sv\\\",\\\"wb_stage.sv\\\",\\\"hazard_unit.sv\\\",\\\"forward_unit.sv\\\",\\\"core.sv\\\"],\\\"test_prediction\\\")\n''')\nPY\npython -m pytest -q \\\"\"'$p/check_v7/test/test_prediction.py\" > \"$p/v7-directed.log\" 2>&1'","aggregated_output":"","exit_code":4,"status":"failed"}}
