{"type": "item.completed", "item": {"id": "item_89", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/mem_stage.sv'", "aggregated_output": "// A synchronous read and its EX/MEM slot share an enable. Validation\n// controls transfer independently of the provisional load-data bypass.\nmodule mem_stage (\n  input  logic    clock,\n  input  logic    reset,\n  input  logic [10:0] lookup_addr,\n  input  logic [1:0] lookup_width,\n  input  logic    lookup_sext,\n  input  logic    dmem_ready,\n  input  logic [31:0] dmem_rdata,\n  output logic [31:0] dmem_addr, dmem_wdata,\n  output logic [3:0] dmem_wen,\n  output logic    dmem_ren,\n  output logic    mem_wait, load_wait,\n  output logic [31:0] lookup_data, refill_data,\n  output logic    accept_read,\n  input  logic [31:0] div_result,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output mem_wb_t out\n);\n  logic [31:0] product;\n  mul_product u_product (\n    .op  (in.ctrl.alu_op),\n    .a   (in.rs1_val),\n    .b   (in.rs2_val),\n    .out (product)\n  );\n\n  logic ram_access, hit, refill_valid;\n  logic [31:0] refill_word;\n  logic post_store, io_store_pending, issue_read, issue_store;\n  logic slot_free, drain, barrier;\n  logic write_row;\n  // All cacheable addresses have zero upper 12 bits. Tag and index\n  // together cover every remaining word-address bit.\n  assign ram_access = in.mem_addr[31:20] == 0;\n  logic [8:0] index;\n  assign index = in.mem_addr[10:2];\n\n  logic [8:0] lookup_index;\n  assign lookup_index = lookup_addr[10:2];\n  (* syn_ramstyle = \"block_ram\", ram_style = \"block\" *)\n  logic [12:0] tags [0:511]; // {tag, valid byte lanes}\n  logic [12:0] tag_q;\n  (* syn_ramstyle = \"distributed_ram\", ram_style = \"distributed\" *)\n  logic [31:0] words [0:511];\n  logic [31:0] word_q;\n  // Reset one presence bit per group. Its first write initializes the\n  // complete sixteen-row bitmap, so no power-up RAM bits can qualify a hit.\n  logic [31:0] group_live;\n  (* syn_ramstyle = \"distributed_ram\", ram_style = \"distributed\" *)\n  logic [15:0] present [0:31];\n  logic [15:0] group_q;\n  logic usable_q;\n  assign write_row = post_store || (accept_read && ram_access);\n  always_ff @(posedge clo\n…[2778 of 5850 chars elided by tools/bench/transcript.py; sha256:54d85d6237537521]…\n   <= in.pc;\n      // funct3[2] selects DIV/REM within the M encoding. A new divide can\n      // issue on this very edge while MEM samples the previous result.\n      reg_q.alu_result <= in.ctrl.late_result ? (in.instr[14] ? div_result : product)\n                                              : in.alu_result;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= (in.ctrl.mem_read || in.ctrl.mem_write)\n                        ? {in.mem_addr[31:2], 2'b0} : 32'b0;\n      reg_q.mem_rdata  <= raw_word;\n      reg_q.mem_wdata  <= in.write_data;\n      reg_q.mem_wmask  <= in.ctrl.mem_write ? in.mem_mask : 4'b0;\n      reg_q.mem_rmask  <= in.ctrl.mem_read  ? in.mem_mask : 4'b0;\n      reg_q.ctrl       <= in.ctrl;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\nendmodule\n", "exit_code": 0, "status": "completed"}}
