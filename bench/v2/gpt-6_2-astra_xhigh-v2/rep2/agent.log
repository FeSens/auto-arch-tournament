{"type": "item.completed", "item": {"id": "item_81", "type": "command_execution", "command": "/bin/bash -c \"git diff --check && sed -n '220,350p' cores/bench/test/test_alu.py\"", "aggregated_output": "async def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def divider_final_group_on_transfer(dut):\n    await _setup(dut)\n    await _issue(dut, ALU_REM, -0x12345, 256)\n    for _ in range(6):\n        await _tick(dut)\n    # Five digits have consumed 0x1234. The transfer brings down the 5.\n    for _ in range(3):\n        assert int(dut.div_valid.value)\n        assert int(dut.div_result.value) == (-0x34 & MASK32)\n        await _tick(dut)\n    dut.div_consume.value = 1\n    for _ in range(4):\n        await _tick(dut)\n        assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n        assert int(dut.div_result.value) == (-0x45 & MASK32)\n    dut.div_consume.value = 0\n\n\n@cocotb.test()\nasync def divider_integer_reference(dut):\n    await _setup(dut)\n    rng = random.Random(0x52563332)\n    edges = [0, 1, 2, 0x7FFFFFFF, 0x80000000, 0x80000001, MASK32]\n    pairs = [(a, b) for a in edges for b in edges]\n    for _ in range(64):\n        a = rng.getrandbits(32)\n        pairs.extend([(a, rng.getrandbits(32)), (a, rng.randrange(-128, 129) & MASK32)])\n    # Vary the quotient length on the radix-16 path, including several\n    # successive nonzero digits for both signs of the divisor.\n    for _ in range(64):\n        a = rng.getrandbits(32)\n        width = rng.randrange(9, 25)\n        d = (1 << (width - 1)) | rng.getrandbits(width - 1)\n        pairs.extend([(a, d), (a, -d & MASK32)])\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in pai\n…[2252 of 5324 chars elided by tools/bench/transcript.py; sha256:8ea7d868c6b02349]…\n 4, 255, 256, 257, 0x1234567, MASK32 - 1, MASK32}\n    for k in range(2, 16):\n        # k*D just below or above the width of a 32-bit dividend.\n        divisors.update((MASK32 // k, MASK32 // k + 1))\n\n    pairs = set()\n    for divisor in divisors:\n        for prefix in range(4):\n            pairs.add(((prefix << 30) | 0x2D35A6C7, divisor))\n        for k in range(1, 16):\n            for delta in (-1, 0, 1):\n                boundary = k * divisor + delta\n                if 0 <= boundary <= MASK32:\n                    pairs.add((boundary, divisor))\n                    # Exercise the same boundary one radix-16 digit earlier.\n                    dividend = (boundary << 4) | 5\n                    if dividend <= MASK32:\n                        pairs.add((dividend, divisor))\n\n    for dividend, divisor in sorted(pairs):\n        q, r = divmod(dividend, divisor) if divisor else (MASK32, dividend)\n        await _check_div(dut, ALU_DIVU, dividend, divisor, q)\n        await _check_div(dut, ALU_REMU, dividend, divisor, r)\n\n\n", "exit_code": 0, "status": "completed"}}
