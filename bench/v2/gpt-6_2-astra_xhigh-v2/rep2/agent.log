{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/3c491641/0233e43d/split-ex.g1Qb7b/gen.py <<'PY'\nfrom pathlib import Path\nfrom sys import argv\nimport shutil\nroot = Path(__file__).parent\nfolder = root / argv[1]\nwidth = int(argv[2])\nsource = Path('cores/bench/rtl')\nfolder.mkdir(exist_ok=True)\nfor f in source.glob('*.sv'):\n    shutil.copy(f,folder/f.name)\ndef change(f,subs):\n    f=folder/f\n    s=f.read_text()\n    for old,new in subs:\n        assert s.count(old)==1,(f.name,old,s.count(old))\n        s=s.replace(old,new)\n    s=s.replace('SPLIT_BIT',str(width))\n    f.write_text(s)\nchange('core_pkg.sv',[('logic        page_cross;', '''logic [31:SPLIT_BIT] mem_upper_alt;\n    logic        mem_upper_sel;\n    logic        page_cross;'''),\n  ('logic        forwardable;', '''logic [31:SPLIT_BIT] result_upper_alt;\n    logic        result_upper_sel;\n    logic        forwardable;''')])\nchange('alu.sv', [('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;''')])\nchange('ex_stage.sv', [('  output logic               repair,', '''  output logic [31:0] add_base0,\n  output logic [31:SPLIT_BIT] add_upper1,\n  output logic               add_carry,\n  output logic               repair,'''),\n  ('  assign dmem_addr = in.mem_addr;', '''  assign dmem_addr = {in.mem_upper_sel ? in.mem_upper_alt : in.mem_addr[31:SPLIT_BIT], in.mem_addr[SPLIT_BIT-1:0]};'''),\n  ('  ex_mem_t reg_q;', '''  logic [SPLIT_BIT-1:0] add_lo, sub_lo;\n  logic [31:SPLIT_BIT] add_upper0, sub_upper0, sub_upper1;\n  logic sub_noborrow;\n  assign {add_carry,add_lo} = {1'b0,alu_a[SPLIT_BIT-1:0]} + {1'b0,alu_b[SPLIT_BIT-1:0]};\n  assign add_upper0 = alu_a[31:SPLIT_BIT] + alu_b[31:SPLIT_BIT];\n  assign add_upper1 = alu_a[31:SPLIT_BIT] + alu_b[31:SPLIT_BIT] + 1'b1;\n  assign add_base0 = {add_upper0,add_lo};\n  assign {sub_noborrow,sub_lo} = {1'b0,alu_a[SPLIT_BIT-1:0]} + {1'b0,~alu_b[SPLIT_BIT-1:0]} + 1'b1;\n  assign sub_upper0 = alu_a[31:SPLIT_BIT] + ~alu_b[31:SPLIT_BIT];\n  assign sub_upper1 = alu_a[31:SPLIT_BIT] - alu_b[31:SPLIT_BIT];\n  logic [31:0] provisional;\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_ADD: provisional = add_base0;\n      ALU_SUB: provisional = {sub_upper0,sub_lo};\n      default: provisional = alu_result;\n    endcase\n  end\n  ex_mem_t reg_q;'''),\n ('in.ctrl.is_jump ? (in.pc + 32\\\\'d4) : alu_result;', '''in.ctrl.is_jump ? (in.pc + 32'd4) : provisional;\n      reg_q.result_upper_alt <= (in.ctrl.alu_op == ALU_SUB) ? sub_upper1 : add_upper1;\n      reg_q.result_upper_sel <= \"'!in.ctrl.mem_read && !in.ctrl.is_jump &&\n          ((in.ctrl.alu_op == ALU_ADD && add_carry) || (in.ctrl.alu_op == ALU_SUB && sub_noborrow));'\"'''),\n ('  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    out.alu_result[31:SPLIT_BIT] = reg_q.result_upper_sel ? reg_q.result_upper_alt : reg_q.alu_result[31:SPLIT_BIT];\n  end''')])\nchange('core.sv', [('  logic repair;', '''  logic [31:0] add_base0;\n  logic [31:SPLIT_BIT] add_upper1;\n  logic repair, add_carry;'''),('    .use_rf   (use_rf),','''    .add_base0 (add_base0),\n    .add_upper1 (add_upper1),\n    .add_carry (add_carry),\n    .use_rf   (use_rf),'''),('    .alu_a           (ex_a),','''    .add_base0 (add_base0),\n    .add_upper1 (add_upper1),\n    .add_carry (add_carry),\n    .alu_a           (ex_a),''')])\nchange('id_stage.sv',[('  input  logic              use_rf,','''  input logic [31:0] add_base0,\n  input logic [31:SPLIT_BIT] add_upper1,\n  input logic add_carry,\n  input  logic              use_rf,'''),('assign add_base = ex_a + ex_b;', 'assign add_base = add_base0;'),\n('    if (repair)\\\\n      reg_q.mem_addr <= repaired_addr;\\\\n    else if (\"'!stall)'\"\\\\n      reg_q.mem_addr <= {page, low_sum[11:0]};','''    if (repair) begin\n      reg_q.mem_addr <= repaired_addr;\n      reg_q.mem_upper_sel <= 1'b0;\n    end else if (\"'!stall) begin\n      reg_q.mem_addr <= {page, low_sum[11