{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"date -u; cat cores/bench/test/conftest.py; rg -n 'ELF|coremark' tools/eval/cosim.py\"","aggregated_output":"Fri Nov 20 06:41:20 UTC 2026\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n1:\"\"\"Runs Verilator cosim for all bench ELFs. Returns structured pass/fail.\n4:  1. Full RVFI trace cosim for selftest and any other small ELF — every\n7:     of coremark.elf is skipped because the Python reference is ~10⁴× slower\n10:     with `validate_coremark_uart` (the same check run_fpga_eval uses). This\n50:    \"\"\"Run cosim for a single ELF using the run_cosim script.\"\"\"\n70:def run_coremark_crc(coremark_elf: Path, sim_bin: str, worktree: str, env: dict | None = None) -> dict:\n71:    \"\"\"Run coremark.elf on the sim and validate UART-reported CRC.\n80:    from tools.eval.fpga import validate_coremark_uart, parse_iterations\n86:            [sim_bin, str(coremark_elf), \"50000000\",\n92:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'timeout'}\n94:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'error', 'detail': str(e)}\n100:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'oob_access',\n105:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'no_output'}\n109:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'malformed_marker',\n112:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'no_ebreak',\n115:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'oob_access',\n118:    valid, reason = validate_coremark_uart(marke