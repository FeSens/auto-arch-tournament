{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\nM=(1<<32)-1\nrng=Random(42)\ndef qr(a,d):\n r=a>>30\n q=3 if not d else (r//d if d<=3 else 0)\n r-=q*d\n multiples=[k*d for k in range(8)]\n for bottom in range(24,-1,-6):\n  for s in [bottom+3,bottom]:\n   prefix=(r<<3)|((a>>s)&7)\n   k=max(k for k,v in enumerate(multiples) if prefix>=v)\n   r=prefix-multiples[k]\n   q=(q<<3)|k\n return q,r\npairs=[(a,d) for d in [0,1,2,3,4,5,7,8,9,31,257,65537,2**31,M] for a in [0,1,2,3,M>>1,2**31,M-1,M]]\npairs += [(rng.getrandbits(32),rng.getrandbits(rng.randrange(33))) for _ in range(25000)]\nfor a,d in pairs:\n assert qr(a,d)==(divmod(a,d) if d else (M,a))\nprint(f'{len(pairs)} unsigned quotient/remainder pairs passed the recurrence check')\nprint(f'At 50 MHz, {10*50000000/4491485:.2f} iterations/s')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
