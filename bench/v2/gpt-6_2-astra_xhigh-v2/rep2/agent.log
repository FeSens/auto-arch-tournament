{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/r11-alu\"\ncp -r cores/bench/rtl \"$TMPDIR/r11-alu/\"\ncat > \"$TMPDIR/r11-alu/proto.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'r11-alu/rtl'\ndef edit(f,x,y):\n s=(p/f).read_text()\n assert s.count(x)==1,(f,x,s.count(x))\n (p/f).write_text(s.replace(x,y))\nedit('core.sv','  logic repair;', '  logic repair, carry_wait;\\\\n  logic [31:0] shared_sum;')\nedit('core.sv','    .ex_a     (ex_a),','    .add_base (shared_sum),\\\\n    .ex_a     (ex_a),')\nedit('core.sv','    .alu_a           (ex_a),','    .shared_sum      (shared_sum),\\\\n    .carry_wait      (carry_wait),\\\\n    .alu_a           (ex_a),')\nedit('core.sv','    .repair         (repair),','    .repair         (repair || carry_wait),')\nedit('id_stage.sv','  input  logic [31:0]       mem_result','  /* verilator lint_off UNUSEDSIGNAL */\\\\n  input  logic [31:0]       add_base,\\\\n  /* verilator lint_on UNUSEDSIGNAL */\\\\n  input  logic [31:0]       mem_result')\nedit('id_stage.sv','  logic [31:0] add_base;','')\nedit('id_stage.sv','  assign add_base = ex_a + ex_b;','')\nedit('ex_stage.sv','  output logic               repair,','  output logic [31:0]        shared_sum,\\\\n  output logic               carry_wait,\\\\n  output logic               repair,')\nedit('ex_stage.sv','  alu u_alu (','''  logic [31:0] rhs;\n  logic [16:0] low_sum;\n  logic [4:0] carry_predictor;\n  logic predict_carry, saved_carry, recovered, signed_sub;\n  logic alu_writer;\n  assign signed_sub = in.ctrl.alu_op == ALU_SUB;\n  assign rhs = alu_b \"'^ {32{signed_sub}};\n  assign low_sum = {1'\"'b0, alu_a[15:0]} + {1'b0, rhs[15:0]} + {16'b0, signed_sub};\n  assign carry_predictor = {1'b0, alu_a[15:12]} + {1'b0, rhs[15:12]} + {4'b0,rhs[31]};\n  assign predict_carry = recovered ? saved_carry : carry_predictor[4];\n  assign shared_sum[15:0] = low_sum[15:0];\n  assign shared_sum[31:16] = alu_a[31:16] + rhs[31:16] + {15'b0,predict_carry};\n  assign alu_writer = in.valid && in.ctrl.reg_write && \"'!in.ctrl.mem_read && !in.ctrl.is_jump &&\n                      in.rd != 0 && (in.ctrl.alu_op == ALU_ADD || signed_sub);\n  assign carry_wait = alu_writer && !recovered && low_sum[16] != carry_predictor[4];\n  always_ff @(posedge clock) begin\n    if (reset || !stall) recovered <= 1'\"'b0;\n    else if (carry_wait) begin\n      recovered <= 1'b1;\n      saved_carry <= low_sum[16];\n    end\n  end\n\n  alu u_alu (''')\n# Mask off ADD and SUB in conventional ALU for these cases.\nedit('ex_stage.sv','(in.pc + 32\\\\'d4) : alu_result;',\\\"(in.pc + 32'd4) :\\\\n                             (in.ctrl.alu_op == ALU_ADD || signed_sub) ? shared_sum : alu_result;\\\")\n# Avoid an unneeded result mux and duplicated logic. Keep standalone ALU behavior via a constant parameter.\nedit('alu.sv','module alu (',\\\"module alu #(parameter bit EXTERNAL_ADDER = 1'b0) (\\\")\nedit('alu.sv','out = a + b;', 'out = EXTERNAL_ADDER ? 0 : a + b;')\nedit('alu.sv','out = a - b;', 'out = EXTERNAL_ADDER ? 0 : a - b;')\nedit('ex_stage.sv','  alu u_alu (',\\\"  alu #(.EXTERNAL_ADDER(1'b1)) u_alu (\\\")\nPY\npython \\\"\"'$TMPDIR/r11-alu/proto.py\"\ncat > \"$TMPDIR/r11-alu/measure.py\" <<'\"'PY'\nimport os,sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build\np=Path(os.environ['TMPDIR'])/sys.argv[1]\nres=build(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',int(sys.argv[2]),p/('p'+sys.argv[2]))\nprint(res,flush=True)\nPY\ncat > \\\"\"'$TMPDIR/r11-alu/bench.sh\" <<'\"'SH'\nset -eu\ndir=\\\"\"'$TMPDIR/$1\"\nNRET=1 RTL_DIR=\"$dir/rtl\" OBJ_DIR=\"$dir/obj\" bash test/cosim/build.sh > \"$dir/sim_build.log\" 2>&1\n\"$dir/obj/cosim_sim\" \"$TMPDIR/r11-alu/coremark.elf\" 50000000 --bench --istall --dstall > \"$dir/bench.log\"\nSH\nmake -f bench/programs/Makefile -n bench/programs/coremark.elf | sed \"s@ -o bench/programs/coremark.elf@ -o $TMPDIR/r11-alu/coremark.elf@\" | bash\nls -l \"$TMP