{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"sed -n '175,200p;360,435p' cores/bench/test/test_pipeline.py && cat /proc/loadavg\"", "aggregated_output": "    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _check_trace(rets, pcs, insns):\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"insn\"] for r in rets] == insns\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(not r[\"trap\"] for r in rets)\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert [fetches.count(pc) for pc in (8, 12, 20, 28, 32, 36, 40, 48)] == [\n        4, 1, 1, 1, 2, 2, 1, 1]\n    assert rets[2][\"rs1_rdata\"] == rets[1][\"rd_wdata\"] == 0x1004\n    assert rets[6][\"mem_rmask\"] == 12 and rets[6][\"rd_wdata\"] == 0xffffffed\n    assert rets[8][\"rs1_rdata\"] == rets[11][\"rs1_rdata\"] == 0\n\n\n@cocotb.test()\nasync def trapped_base_writer(dut):\n    # The younger LW to x1 traps. The next LW must repair using the older\n    # x1 still on the WB bypass, even when dmem returns a plausible raw word.\n    program = [ADDI(1, 0, 0x100), LW(1, 0, 2), LW(3, 1, 4), EBREAK()]\n    reads = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n        assert not wen\n        if ren:\n            reads.append((pc, addr))\n        return 1, 1\n\n    rets, _ = await _run(dut, program, {0: 0x80, 0x104: 37}, bus_ready=bus_ready)\n    assert reads == [(12, 0x104)]\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12]\n    assert [r[\"order\"] for r in rets] == [0, 1, 2, 3]\n    assert [r[\"trap\"] for r in rets] == [0, 1, 0, 0]\n    assert (rets[1][\"rd\"], rets[1][\"mem_rmask\"], rets[1][\"mem_wmask\"]) == (0, 0, 0)\n    assert (rets[2][\"rs1_rdata\"], rets[2][\"mem_rmask\"], rets[2][\"rd_wdata\"]) == (0x100, 15, 37)\n\n\n@cocotb.test()\nasync def multiply_dependencies(dut):\n    program = [\n        ADDI(1, 0, -3), ADDI(2, 0, -2),\n        MUL(3, 1, 2),\n        MUL(4, 1, 2, 1),  # MULH\n        MUL(5, 1, 2, 3),  # MULHU\n        MUL(6, 1, 2, 2),  # MULHSU\n        MUL(7, 6, 3), SW(7, 0, 0x40),\n        LW(8, 0, 0x40), MUL(9, 1, 8),\n        MUL(0, 1, 2), ADD(10, 0, 9),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert all(not r[\"trap\"] for r in rets)\n\n    for idx, lhs, rhs, result in [\n        (2, -3, -2, 6), (3, -3, -2, 0), (4, -3, -2, -5), (5, -3, -2, -3),\n        (6, -3, 6, -18), (9, -3, -18, 54), (10, -3, -2, 0), (11, 0, 54, 54),\n    ]:\n        r = rets[idx]\n        assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"]) == (\n            lhs & 0xFFFFFFFF, rhs & 0xFFFFFFFF, result & 0xFFFFFFFF\n        )\n        assert r[\"rd\"] == ((program[idx] >> 7) & 31)\n        assert r[\"mem_rmask\"] == r[\"mem_wmask\"] == 0\n    assert rets[7][\"rs2_rdata\"] == rets[7][\"mem_wdata\"] == dmem[0x40] == (-18 & 0xFFFFFFFF)\n    assert rets[8][\"rd_wdata\"] == dmem[0x40]\n\n    # Only the adjacent MUL-to-MUL and MUL-to-SW need bubbles.\n    for i in range(1, len(program)):\n        assert rets[i][\"cycle\"] - rets[i - 1][\"cycle\"] == (2 if i in (6, 7) else 1)\n\n\n@cocotb.test()\nasync def multiply_held_behind_store(dut):\n    program = [\n        ADDI(1, 0, 5), ADDI(2, 0, -7), MUL(3, 1, 2),\n        SW(1, 0, 0x44), MUL(4, 1, 3), SW(4, 0, 0x48), EBREAK(),\n    ]\n    wait_cycles = 0\n    writes = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n29.89 21.64 15.83 64/1229 3\n", "exit_code": 0, "status": "completed"}}
