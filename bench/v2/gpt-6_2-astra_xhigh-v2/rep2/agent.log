v = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.s\n…[3370 of 6442 chars elided by tools/bench/transcript.py; sha256:315191f4f879a795]…\n[\"bsram\"], \"dsp\": ref[\"dsp\"], \"logic_levels\": ref[\"levels\"],\n        \"critical_path\": (ref.get(\"critical_paths\") or [None])[0],\n    }\n\n\ndef main(argv=None) -> int:\n5:acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\n208:async def branch_taken_skips(dut):\n216:        ADDI(2, 0, 42),        # PC=8;  branch target\n-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n-rwxrwx--x+ 1 nobody nogroup 27444 Nov 20 03:33 /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/bench/programs/coremark.elf\n-rwxrwx--x+ 1 nobody nogroup 46884 Nov 20 03:33 /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/bench/programs/random1.elf\n-rwxrwx--x+ 1 nobody nogroup 45912 Nov 20 03:33 /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/bench/programs/random2.elf\n-rwxrwx--x+ 1 nobody nogroup 47056 Nov 20 03:33 /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/bench/programs/random3.elf\n-rwxrwx--x+ 1 nobody nogroup  5248 Nov 20 03:33 /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/bench/programs/selftest.elf\n", "exit_code": 0, "status": "completed"}}
