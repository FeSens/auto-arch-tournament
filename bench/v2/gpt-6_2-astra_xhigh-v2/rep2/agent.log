{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py && ls -la cores/bench/test'", "aggregated_output": "\"\"\"Check combinational ALU operations and the six-clock RV32M divider.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _issue(dut, op, a, b):\n    assert int(dut.div_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value = 1\n    await _tick(dut)\n    dut.div_request.value = 0\n    # The request may disappear and all three inputs may change after issue.\n    dut.op.value = ALU_ADD\n    dut.a.value = 0xCAFE\n    dut.b.value = 0xBABE\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    await _issue(dut, op, a, b)\n    for _ in range(6):\n        assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _tick(dut)\n\n    pending = int(dut.div_result.value)\n    for delay in range(hold_cycles + 1):\n        assert int(dut.div_valid.value) and not int(dut.div_ready.value)\n        assert int(dut.div_result.value) == pending\n        if delay < hold_cycles:\n            await _tick(dut)\n    dut.di\n…[7783 of 10855 chars elided by tools/bench/transcript.py; sha256:b6b4997685fa9dc1]…\nU_REM, -17, 3, -2)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_mul_product_runner():\n    run_cocotb(toplevel=\"mul_product\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_mul_product\")\ntotal 100\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 20 08:32 .\ndrwxrwx---+ 5 nobody nogroup  4096 Nov 20 08:32 ..\n-rw-rw----+ 1 nobody nogroup  2143 Nov 20 08:32 _helpers.py\n-rw-rw----+ 1 nobody nogroup   361 Nov 20 08:32 conftest.py\n-rw-rw----+ 1 nobody nogroup 10242 Nov 20 08:32 test_alu.py\n-rw-rw----+ 1 nobody nogroup 11218 Nov 20 08:32 test_decoder.py\n-rw-rw----+ 1 nobody nogroup  2478 Nov 20 08:32 test_imm_gen.py\n-rw-rw----+ 1 nobody nogroup  1414 Nov 20 08:32 test_mul_product.py\n-rw-rw----+ 1 nobody nogroup 39439 Nov 20 08:32 test_pipeline.py\n-rw-rw----+ 1 nobody nogroup  2720 Nov 20 08:32 test_reg_file.py\n", "exit_code": 0, "status": "completed"}}
