{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\n# For fixed (s, i, t), R is constant. The largest overestimate is at\n# the greatest reachable D; the largest underestimate is at the least.\ncount = 0\nfor s in range(32):\n    step = 1 << s\n    for i in range(2048, 4096):\n        c = (1 << 42) // i\n        slope = -(-(1 << 34) // (i*i))\n        for t in range(33):\n            base = i << 20\n            left = base + max(0, ((t-1) << 15) + 1)\n            right = base + min((1 << 20)-1, t << 15)\n            lo = ((left + step - 1) // step) * step\n            hi = (right // step) * step\n            if lo > hi:\n                continue\n            r = c - (t * slope << 3)\n            assert hi*r <= 1 << 62, (s, i, t, hi)\n            assert ((1 << 32)-1)*((1 << 62) - lo*r) < lo*(1 << (62-s)), (s, i, t, lo)\n            count += (hi - lo) // step + 1\nassert count == (1 << 32)-1\nprint('Exact integer reciprocal bounds checked for', count, 'nonzero divisors')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
