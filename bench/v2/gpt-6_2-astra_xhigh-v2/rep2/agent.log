S  = --iterations $(N) --tournament-size $(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>\n…[5263 of 8335 chars elided by tools/bench/transcript.py; sha256:c0ebb45b56ec266f]…\nrces=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Nov 20 18:29 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 20 18:29 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 20 18:29 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 20 18:29 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 20 18:29 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    68 Nov 20 18:29 riscv-formal -> /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 20 18:29 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 20 18:29 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 20 18:29 wrapper_si.sv\nFri Nov 20 17:29:33 UTC 2026\nIDE\nProgrammer\ndeps\ngowin.tgz.sha256\n", "exit_code": 0, "status": "completed"}}
