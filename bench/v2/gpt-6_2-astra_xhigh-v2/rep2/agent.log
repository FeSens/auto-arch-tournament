{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -c \"cat >> cores/bench/test/test_pipeline.py <<'PY'\n\n@cocotb.test()\nasync def colliding_branch_counters(dut):\n    program = [EBREAK()] * 274\n    program[0] = ADDI(3, 0, 5)\n    program[1] = JAL(0, 60)\n    program[16] = BEQ(0, 0, 16)\n    program[17] = SW(0, 0, 64)\n    program[20] = ADDI(3, 3, -1)\n    program[21] = JAL(0, 1088 - 84)\n    program[272] = _b(-1024, 0, 3, 1, 0x63)\n    def ready(pc, addr, ren, wen, data):\n        assert not (ren or wen)\n        return 1, 1\n    rets, _ = await _run(dut, program, bus_ready=ready)\n    pcs = [0, 4] + [64, 80, 84, 1088]*5 + [1092]\n    assert [r['pc'] for r in rets] == pcs\n    assert [r['pc_next'] for r in rets[:-1]] == pcs[1:]\n    assert [r['order'] for r in rets] == list(range(len(pcs)))\n\n@cocotb.test()\nasync def spec_target_bounds_and_misalignment(dut):\n    program = [ADDI(1, 0, 1), _b(2, 0, 1, 1, 0x63), JAL(5, 2),\n               _b(-4096, 0, 0, 1, 0x63), JALR(5, 0, 3), EBREAK()]\n    def ready(pc, addr, ren, wen, data):\n        assert not (ren or wen)\n        assert 0 <= pc < 1048576 and pc % 4 == 0\n        return 1, 1\n    rets, _ = await _run(dut, program, bus_ready=ready)\n    assert [r['pc'] for r in rets] == list(range(0, 24, 4))\n    assert [r['pc_next'] for r in rets] == list(range(4, 28, 4))\n    assert [r['trap'] for r in rets] == [0,1,1,0,1,0]\n    assert all(r['rd'] == 0 for r in rets[1:])\nPY\npytest -q cores/bench/test/test_pipeline.py > directed.log 2>&1 && tail -4 directed.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
