 | ({13{use_mem}} & mem_sum)\n                 | ({13{use_add}} & add_sum)\n                 | ({13{use_lui}} & {ex_b[12] ^ disp[12], disp[11:0]})\n                 | ({13{use_lw}}  & lw_sum);\n\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      reg_q.ctrl  <= '0;\n      reg_q.valid <= 1'b0;\n    end else if (!stall) begin\n      reg_q.ctrl  <= ctrl_decoded;\n      reg_q.valid <= in.valid;\n    end\n    if (repair)\n      reg_q.mem_addr <= repaired_addr;\n    else if (!stall)\n      reg_q.mem_addr <= {page, low_sum[11:0]};\n\n    if (!stall) begin\n      reg_q.page_cross <= low_sum[12] ^ page[0];\n      reg_q.base_available <= use_rf || use_mem || use_add || use_lui || use_lw;\n      reg_q.pc       <= in.pc;\n      // Keep the older value even when EX names the same rd. A younger\n      // producer can still lose its write enable to a misalignment trap.\n      reg_q.rs1_val  <= older_rs1_match ? mem_result : rs1_data;\n      reg_q.rs2_val  <= older_rs2_match ? mem_result : rs2_data;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.instr    <= in.instr;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n[70%] Routing Phase 1 completed\n[80%] Routing Phase 2 completed\n20\n","exit_code":0,"status":"completed"}}
