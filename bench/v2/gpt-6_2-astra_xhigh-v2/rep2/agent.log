\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n.agents\n.aws\n.codex\n.git\n.github\n.gitignore\n.mailmap\n.readthedocs.yaml\nCOPYING\nCodeOfConduct\nREADME.md\nbus\nchecks\ncores\ndocs\ninsns\nmonitor\ntests\n21:    nret=1, injects BENCH=fpga/core_bench_si.sv so synth.tcl reads the\n23:    default dual-channel core_bench.sv. nret=2 leaves BENCH unset and\n24:    synth.tcl falls back to fpga/core_bench.sv.\n34:        env[\"BENCH\"] = \"fpga/core_bench_si.sv\"\n306:def _bench_sv(worktree: str, target: str | None) -> str:\n309:        return \"fpga/core_bench.sv\"\n311:    return \"fpga/core_bench_si.sv\" if nret == 1 else \"fpga/core_bench.sv\"\n323:    res = gowin.build_all(worktree, rtl, _bench_sv(worktree, target), gen)\n361:    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\ntotal 20\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 02:44 .\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 05:13 ..\ndrwxr-xr-x  2 nobody nogroup 4096 Sep 28 02:44 bin\ndrwxr-xr-x 12 nobody nogroup 4096 Apr 24  2026 oss-cad-suite\ndrwxr-xr-x 10 nobody nogroup 4096 Oct 23  2025 xpack-riscv-none-elf-gcc-15.2.0-1\n","exit_code":0,"status":"completed"}}
