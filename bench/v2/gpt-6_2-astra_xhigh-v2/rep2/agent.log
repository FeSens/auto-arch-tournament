ild_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ncores/bench/test/test_pipeline.py:1045:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:1046:            \"mem_stage.sv\", \"wb_stage.sv\",\ncores/bench/test/test_pipeline.py:1047:            \"hazard_unit.sv\", \"forward_unit.sv\",\n","exit_code":0,"status":"completed"}}
