{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/LESSONS.md schemas/hypothesis.schema.json formal/checks_si.cfg && ls -la cores/bench/experiments/hypotheses'", "aggregated_output": "- 2026-11-20 hyp-20261120-001-r1s0 (regression, +471.20%): Eight serial trial subtractions on the `partial_q` feedback path limited median Fmax to 31.094 MHz versus 41.649 MHz for six steps per clock, while CoreMark executed no DIV/REM between markers to benefit from the shorter divide latency.\n- 2026-11-20 hyp-20261120-002-r1s1 (improvement, +665.10%): Moving combinational `/` and `%` off the shared EX result path into a six-cycle restoring divider raised median Fmax from 5.442 to 41.649 MHz without adding divider stalls because CoreMark issued no DIV/REM between its markers.\n- 2026-11-20 hyp-20261120-003-r1s2 (regression, +6.19%): Predicting branches by displacement bias and taking JAL in fetch saved 302,818 CoreMark cycles by avoiding EX redirects, while the combinational DIV/REM path still limited median Fmax to 5.392 MHz.\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"required\": [\"id\",\"title\",\"category\",\"motivation\",\"hypothesis\",\"expected_impact\",\"changes\"],\n  \"properties\": {\n    \"id\":       {\"type\": \"string\", \"pattern\": \"^hyp-[0-9]{8}-[0-9]{3}(-r[0-9]+s[0-9]+)?$\"},\n    \"title\":    {\"type\": \"string\", \"minLength\": 5},\n    \"category\": {\"type\": \"string\", \"enum\": [\"micro_opt\",\"structural\",\"extension\",\"predictor\",\"memory\"]},\n    \"motivation\":  {\"type\": \"string\", \"minLength\": 20},\n    \"hypothesis\":  {\"type\": \"string\", \"minLength\": 20},\n    \"expected_impact\": {\n      \"type\": \"object\",\n      \"required\": [\"fitness_delta_pct\",\"confidence\"],\n      \"properties\": {\n        \"fitness_delta_pct\": {\"type\": \"integer\"},\n        \"confidence\": {\"type\": \"string\", \"enum\": [\"low\",\"medium\",\"high\"]}\n      }\n    },\n    \"changes\": {\n      \"type\": \"array\", \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"file\",\"description\"],\n        \"properties\": {\n          \"file\":        {\n            \"type\": \"string\",\n            \"description\": \"Must be under rtl/ (any extension) or be a test/test_*.py cocotb suite. Anything else is rejected by the runtime sandbox check.\",\n            \"pattern\": \"^(rtl/[^.].*|test/test_[^/]+\\\\.py)$\"\n          },\n          \"description\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\ntotal 16\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 20 04:23 .\ndrwxrwx---+ 3 nobody nogroup 4096 Nov 20 04:23 ..\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py && cat cores/bench/rtl/alu.sv'", "aggregated_output": "\"\"\"Check combinational ALU operations and the six-clock RV32M divider.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _issue(dut, op, a, b):\n    assert int(dut.div_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value = 1\n    await _tick(dut)\n    dut.div_request.value = 0\n    # The request may disappear and all three inputs may change after issue.\n    dut.op.value = ALU_ADD\n    dut.a.value = 0xCAFE\n    dut.b.value = 0xBABE\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    await _issue(dut, op, a, b)\n    for _ in range(6):\n        assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _tick(dut)\n\n    for delay in range(hold_cycles + 1):\n        assert int(dut.div_valid.value) and not int(dut.div_ready.value)\n        actual = int(dut.div_result.value)\n        assert actual == (expected & MASK32), (\n            f\"op={op} a={a\n…[11479 of 14551 chars elided by tools/bench/transcript.py; sha256:c28d02a7b08a5a05]…\n5]}\n                                 : trial[31:0];\n      quotient_next = {quotient_next[34:0], !trial[32]};\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      quotient_q     <= {4'b0, (a_negative ? -a : a)};\n      divisor_q      <= b_negative ? -b : b;\n      remainder_q    <= 32'd0;\n      remainder_op_q <= want_remainder;\n      // Subtracting zero always succeeds, giving an all-ones quotient and\n      // the dividend magnitude as remainder. Only the remainder needs its\n      // original sign. INT_MIN / -1 already gives the required 32-bit pattern.\n      negate_q <= want_remainder ? a_negative : ((a_negative ^ b_negative) && b != 0);\n    end else if (groups_left != 0) begin\n      quotient_q  <= quotient_next;\n      remainder_q <= remainder_next;\n    end\n  end\n\n  // Sign correction uses the registered final group, outside the recurrence.\n  assign magnitude = remainder_op_q ? remainder_q : quotient_q[31:0];\n  assign div_result = negate_q ? -magnitude : magnitude;\n`endif\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
