{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c 'cat \"$TMPDIR/bigspec/rtl/if_stage.sv\"'","aggregated_output":"module if_stage (\n  input logic clock, reset,\n  input id_ex_t ex,\n  input logic ex_fence_i, cancel_writer, stall, consume, imem_ready, redirect,\n  input logic [31:0] redirect_target,\n  output logic [31:0] imem_addr,\n  input logic [31:0] imem_data,\n  output logic correction,\n  output if_id_t out\n);\n  logic [31:0] fetch_pc, next_pc, prediction, linear, correct_pc;\n  logic linear_miss, target_miss;\n  assign linear = ex.pc + 32'd4;\n  assign linear_miss = ex.prediction != linear;\n  assign target_miss = ex.prediction != redirect_target;\n  logic dir_q, miss_target_q, miss_linear_q, fence_q, resolve_q;\n  logic [31:0] target_q, linear_q;\n  always_ff @(posedge clock) begin\n    resolve_q <= !reset && ex.valid && !stall;\n    dir_q <= redirect;\n    miss_linear_q <= linear_miss;\n    miss_target_q <= target_miss;\n    fence_q <= ex_fence_i || cancel_writer;\n    target_q <= redirect_target;\n    linear_q <= linear;\n  end\n  assign correction = resolve_q && ((dir_q ? miss_target_q : miss_linear_q) || fence_q);\n  assign correct_pc = dir_q ? target_q : linear_q;\n  assign imem_addr = correction ? correct_pc : fetch_pc;\n\n  (* syn_ramstyle=\"block_ram\", ram_style=\"block\" *) logic [39:0] words[0:2047]; // valid + tag + word\n  (* syn_ramstyle=\"block_ram\", ram_style=\"block\" *) logic [30:0] btb[0:511]; // valid, uncond, 2-bit counter, tag (10), target word(18)\n  logic [39:0] row;\n  logic [30:0] entry;\n  logic [10:0] clear_idx;\n  logic clear, fill, word_ok, btb_ok, usable, b_usable, train;\n  logic can_fetch, advance;\n  logic [1:0] update_cnt, counter;\n  assign can_fetch = !out.valid || consume || correction;\n  assign word_ok = usable && !correction && row[39] && {12'd0,row[38:32]} == fetch_pc[31:13];\n  assign btb_ok = b_usable && !correction && entry[30] && {12'd0,entry[26:18]} == fetch_pc[31:11];\n  assign prediction = btb_ok && (entry[29] || entry[28]) ? {12'd0,entry[17:0],2'd0} : {12'd0,imem_addr[19:2]+18'd1,2'd0};\n  assign counter = btb_ok ? entry[28:27] : 2'd1;\n  assign advance = (imem_ready || word_ok) && can_fetch;\n  assign next_pc = advance ? prediction : imem_addr;\n  if_id_t q;\n  assign out = q;\n  assign fill = advance && imem_ready && imem_addr[31:20]==0 && !clear;\n  assign train = ex.valid && !stall && (ex.ctrl.is_branch || ex.ctrl.is_jump) && ex.pc[31:20]==0 && redirect_target[31:20]==0 && redirect_target[1:0]==0 && !clear;\n  assign update_cnt = redirect ? ((&ex.bht) ? 2'd3 : ex.bht + 1'b1) : ((|ex.bht) ? ex.bht - 1'b1 : 2'd0);\n  always_ff @(posedge clock) begin\n    if (reset || ex_fence_i) begin\n      clear <= 1'b1;\n      clear_idx <= '0;\n    end else if(clear) begin\n      clear_idx <= clear_idx + 1'b1;\n      clear <= !(&clear_idx);\n    end\n    if(clear || fill)\n      words[clear ? clear_idx : imem_addr[12:2]] <= {!clear,imem_addr[19:13],imem_data};\n    if(clear || train)\n      btb[clear ? clear_idx[8:0] : ex.pc[10:2]] <= {!clear,ex.ctrl.is_jump,update_cnt,ex.pc[19:11],redirect_target[19:2]};\n    row <= words[next_pc[12:2]];\n    entry <= btb[next_pc[10:2]];\n    usable <= !clear && !reset && !ex_fence_i && !(fill && imem_addr[12:2]==next_pc[12:2]);\n    b_usable <= !clear && !reset && !ex_fence_i && !(train && ex.pc[10:2]==next_pc[10:2]);\n    fetch_pc <= reset ? 32'd0 : next_pc;\n    if(reset) q.valid <= 1'b0;\n    else if(can_fetch) q.valid <= advance;\n    if(can_fetch) begin\n      q.pc <= imem_addr;\n      q.prediction <= prediction;\n      q.bht <= counter;\n      q.instr <= imem_ready ? imem_data : row[31:0];\n    end\n  end\nendmodule\n","exit_code":0,"status":"completed"}}
