{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"cat >variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/rtl')\ndef variant(name):\n d=Path(name)\n d.mkdir()\n shutil.copytree(base,d/'rtl')\n return d/'rtl'\ndef update(d,file,old,new):\n p=d/file\n s=p.read_text()\n assert old in s\n p.write_text(s.replace(old,new))\ndef from_to(d,file,start,end,new):\n p=d/file;s=p.read_text();i=s.index(start);j=s.index(end,i);p.write_text(s[:i]+new+s[j:])\nd=variant('late_ex')\n# During EX, replace the early address only if a newer register file value\n# became available. The usual forwarding priority and trap squash apply.\nfrom_to(d,'id_stage.sv','  logic [31:0] pair_xor,','  always_ff','  logic [31:0] effective_addr;\\\\n  assign effective_addr = rs1_data + imm;\\\\n')\nupdate(d,'id_stage.sv','  input logic [31:0] ex_a, ex_b, ex_base, older_base,\\\\n  input logic use_ex_add, use_ex_base, use_older_base,\\\\n','')\nfrom_to(d,'core.sv','  logic [31:0] ex_a,','  assign ex_mul', '  logic mem_mul, ex_mul;\\\\n')\nfrom_to(d,'core.sv','  assign ex_match', '    .clock    (clock),','  id_stage u_id (\\\\n')\nupdate(d,'core.sv','    .ex_a(ex_a), .ex_b(ex_b),','')\nupdate(d,'core.sv','    .addr_interlock (addr_interlock),','')\nupdate(d,'ex_stage.sv','  output logic [31:0] ex_a, ex_b,\\\\n','')\nupdate(d,'ex_stage.sv','  assign ex_a = alu_a;\\\\n  assign ex_b = alu_b;\\\\n','')\nupdate(d,'ex_stage.sv','  assign dmem_addr = in.effective_addr;', '''  assign dmem_addr = ({32{fwd_rs1_sel == 0}} & in.effective_addr)\n                   | ({32{fwd_rs1_sel[0]}} & (fwd_ex_mem + in.imm))\n                   | ({32{fwd_rs1_sel[1]}} & (fwd_mem_wb + in.imm));''')\nupdate(d,'hazard_unit.sv','  input  logic       addr_interlock,\\\\n','')\nupdate(d,'hazard_unit.sv','late_use_hazard || addr_interlock ||','late_use_hazard ||')\n# Restrict immediately bypassed values to simple LW and LUI outputs and\n# previous registered EX/MEM values. The 3-operand path and wiring disappear.\nd=variant('simple')\nfrom_to(d,'id_stage.sv','  logic [31:0] pair_xor,','  always_ff','''  logic [31:0] effective_addr;\n  assign effective_addr = (use_ex_base ? ex_base : use_older_base ? older_base : rs1_data) + imm;\n''')\nupdate(d,'core.sv','(ex_add || ex_lw || ex_lui)', '(ex_lw || ex_lui)')\n# Only ADD uses a second carry-save datapath, other bases share a single adder.\nd=variant('twosum')\nfrom_to(d,'id_stage.sv','  assign effective_addr =','  always_ff','''  logic [31:0] ordinary_base;\n  assign ordinary_base = use_ex_base ? ex_base : use_older_base ? older_base : rs1_data;\n  assign effective_addr = use_ex_add ? sum3 : ordinary_base + imm;\n\n''')\nPY\npython variants.py && cat >time_one.py <<'PY'\nfrom tools.eval.gowin import build\nimport sys\np=sys.argv[1];opt=int(sys.argv[2])\nr=build('.',p+'/rtl','fpga/core_bench_si.sv',opt,p+'/p'+str(opt))\nprint(r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
