{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nrtl = Path(\\\"cores/bench/rtl\\\")\ndef edit(name, fr, to):\n    p=rtl / (name+\\\".sv\\\")\n    s=p.read_text()\n    assert s.count(fr) == 1, (name, fr)\n    p.write_text(s.replace(fr,to))\n\nfor terminator in [\\\"if_id_t\\\",\\\"id_ex_t\\\"]:\n    edit(\\\"core_pkg\\\", \\\"  } \\\"+terminator+\\\";\\\", \\\"    logic        pred_taken;\\\\n    logic [1:0]  counter;\\\\n  } \\\"+terminator+\\\";\\\")\np=rtl/\\\"if_stage.sv\\\"\ns=p.read_text().replace(\\\"  input  logic              flush,            // emit NOP into ID this cycle\\\", \\\"\\\"\\\"  input  logic              train,\n  input  logic [7:0]        train_index,\n  input  logic [1:0]        train_count,\\\"\\\"\\\")\ns=s[:s.index(\\\"  always_comb begin\\\")]+\\\"\\\"\\\"  logic [1:0] counters [0:255];\n  initial for (int i=0; i<256; i++) counters[i] = 2'b01;\n  always_ff @(posedge clock)\n    if (train) counters[train_index] <= train_count;\n\n  logic is_b, is_j;\n  logic [31:0] offset, target;\n  logic [1:0] count;\n  logic predicted;\n  assign count = counters[pc[9:2]];\n  assign is_b = imem_data[6:0] == 7'b1100011 && (imem_data[14] || \"'!imem_data[13]);\n  assign is_j = imem_data[6:0] == 7'\"'b1101111;\n  assign offset = is_j ? {{12{imem_data[31]}},imem_data[19:12],imem_data[20],imem_data[30:21],1'b0}\n                       : {{20{imem_data[31]}},imem_data[7],imem_data[30:25],imem_data[11:8],1'b0};\n  assign target = pc + offset;\n  assign predicted = (is_j || (is_b && (imem_data[31] \"'^ count[1]))) &&\n                     target[31:20] == '\"'0 && target[1:0] == '0;\n  assign next_pc = predicted ? target : pc + 4;\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (\"'!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n  assign out.pc = pc;\n  assign out.instr = imem_data;\n  assign out.pred_taken = predicted;\n  assign out.counter = count;\n  assign out.valid = 1'\"'b1;\nendmodule\n\\\"\\\"\\\"\np.write_text(s)\n\nedit(\\\"id_stage\\\", \\\"if (reset || flush)\\\", \\\"if (reset)\\\")\nedit(\\\"id_stage\\\", \\\"reg_q.ctrl     <= ctrl_decoded;\\\", \\\"reg_q.ctrl     <= flush ? '0 : ctrl_decoded;\\\\n      reg_q.counter <= in.counter;\\\\n      reg_q.pred_taken <= in.pred_taken;\\\")\nedit(\\\"id_stage\\\", \\\"reg_q.valid    <= in.valid;\\\", \\\"reg_q.valid    <= in.valid && \"'!flush;\")\n\np=rtl/\"hazard_unit.sv\"\ns=p.read_text()\ns=s[:s.index(\"    // IF/ID combinational payload:\")]+\"\"\"    stall_id = dmem_stall || div_wait;\n    flush_id = load_use_hazard || redirect || imem_stall;\n    stall_ex_mem = dmem_stall;\n    hold_mem_wb = dmem_stall;\n  end\nendmodule\n\"\"\"\ns='\"'\\\\n'.join(x for x in s.split('\\\\n') if not x.startswith('  output logic       flush_if,'))\np.write_text(s)\n\nedit(\\\"ex_stage\\\",\\\"  output logic               div_wait,\\\", \\\"\\\"\\\"  output logic               train,\n  output logic [1:0]         train_count,\n  output logic               div_wait,\\\"\\\"\\\")\nedit(\\\"ex_stage\\\",\\\"  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"\\\\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\\\", \\\"\\\"\\\"  logic resolved_taken;\n  assign resolved_taken = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect = in.valid && !stall && (resolved_taken != in.pred_taken);\n  assign redirect_target = resolved_taken ? (in.ctrl.is_jump ? jump_target : branch_target) : in.pc + 32'\"'d4;\n  assign train = \"'!reset && in.valid && !stall && in.ctrl.is_branch;\n  always_comb begin\n    if (branch_cond ''^ in.imm[31])\n      train_count = (in.counter == 3) ? 2'\"'d3 : in.counter + 2'd1;\n    else\n      train_count = (in.counter == 0) ? 2'd0 : in.counter - 2'd1;\n  end\\\"\\\"\\\")\nedit(\\\"core