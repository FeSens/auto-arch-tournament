]} MHz, {r['levels']} logic levels; \"\n221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n", "exit_code": 0, "status": "completed"}}
