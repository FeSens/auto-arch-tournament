ons]\n180:    \"\"\"Median Fmax over placement options; every option must fit (the flow\n187:    ref = next(r for r in results if r[\"place_option\"] == PLACE_OPTIONS[0])\n192:        \"perturbations\": [[r[\"place_option\"], r[\"fmax_mhz\"], r[\"levels\"]] for r in results],\n200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\n208:    ap.add_argument(\"--all-options\", action=\"store_true\",\n209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\n212:    opts = PLACE_OPTIONS if a.all_options else PLACE_OPTIONS[:1]\n214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\n217:            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\n219:        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\n221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n227:        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n20\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\n","exit_code":1,"status":"failed"}}
