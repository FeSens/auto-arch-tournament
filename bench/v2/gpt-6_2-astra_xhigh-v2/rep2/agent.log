{"type":"item.completed","item":{"id":"item_118","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/test_pipeline.py | sed -n '88,118p'; which pytest; python -c 'import cocotb;print(cocotb.__version__)'\"","aggregated_output":"    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Start with a zero-wait fetch at the reset vector.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    if startup_wait:\n        dut.io_imemReady.value = 0\n        dut.io_imemData.value = unready_instr\n        for _ in range(startup_wait):\n            await RisingEdge(dut.clock)\n        dut.io_imemReady.value = 1\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n/srv/hwebench/venv/bin/pytest\n2.0.1\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_119","type":"command_execution","command":"/bin/bash -c 'p=\"$TMPDIR/probe\"\nmkdir -p \"$p/check_v7/test\"\nln -s \"$p/v7\" \"$p/check_v7/rtl\"\ncp cores/bench/test/_helpers.py \"$p/check_v7/test/\"\npython - <<'\"'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'probe/check_v7/test'\ns=Path('cores/bench/test/test_pipeline.py').read_text()\n(p/'test_prediction.py').write_text(s[:s.index('# ── Tests ─')]+'''\n@cocotb.test()\nasync def page_repair(dut):\n    # x1 = 4096, x2 = 4092, x4 = 0x53. Both stores cross a page.\n    program = [\n        0x000010b7, ADDI(2,1,-4), ADDI(4,0,0x53),\n        SW(4,2,4), SW(4,1,-4),\n        LW(5,1,0), BEQ(5,4,8), SW(0,0,0x18),\n        _i(0,1,4,6,0x13), # XORI x6,x1,0. Unsupported address producer.\n        SW(4,6,12), LW(7,2,5), EBREAK(),\n    ]\n    # Loads at 4097 must trap, and the skipped store must never issue.\n    writes = []\n    reads = []\n    wait = 0\n    def ready(pc,addr,ren,wen,data):\n        nonlocal wait\n        if wen:\n            assert wen == 15 and data == 0x53\n            assert addr in (4096,4092,4108)\n            if addr == 4096 and wait < 3:\n                wait += 1\n                return 1,0\n            writes.append(addr)\n        if ren:\n            reads.append(addr)\n        return 1,1\n    r,dm = await _run(dut,program,bus_ready=ready)\n    pcs = [i*4 for i in (0,1,2,3,4,5,6,8,9,10,11)]\n    assert [x['pc'] for x in r] == pcs\n    assert [x['order'] for x in r] == list(range(len(r)))\n    assert [x['pc_next'] for x in r[:-1]] == pcs[1:]\n    assert writes == [4096,4092,4108] and reads == [4096] and wait == 3\n    assert [x['mem_addr'] for x in r if x['mem_wmask']] == writes\n    assert r[5]['rd_wdata'] == 0x53 and r[5]['mem_rmask'] == 15\n    assert r[6]['cycle'] == r[5]['cycle'] + 1\n    assert r[-2]['trap'] and r[-2]['rd']==0 and not r[-2]['mem_rmask']\n    assert not any(x['trap'] for x in r[:-2])\n\ndef test_prediction_runner():\n    run_cocotb(\\\"core\\\", [\\\"core_pkg.sv\\\",\\\"alu.sv\\\",\\\"decoder.sv\\\",\\\"imm_gen.sv\\\",\\\"reg_file.sv\\\",\\\"if_stage.sv\\\",\\\"id_stage.sv\\\",\\\"ex_stage.sv\\\",\\\"mem_stage.sv\\\",\\\"wb_stage.sv\\\",\\\"hazard_unit.sv\\\",\\\"forward_unit.sv\\\",\\\"core.sv\\\"],\\\"test_prediction\\\")\n''')\nPY\npython -m pytest -q \\\"\"'$p/check_v7/test/test_prediction.py\" > \"$p/v7-directed.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
