{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python -B - <<'PY'\nimport collections, os, pathlib, shlex, subprocess, sys, tempfile\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\nwith tempfile.TemporaryDirectory(prefix='multiply-profile-') as directory:\n    elf = str(pathlib.Path(directory) / 'coremark.elf')\n    recipe = subprocess.check_output(['make', '-Bn', '-f', 'bench/programs/Makefile', 'bench/programs/coremark.elf'], text=True)\n    args = shlex.split(recipe)\n    assert args[-2:] == ['-o', 'bench/programs/coremark.elf']\n    args[-1] = elf\n    subprocess.run(args, check=True, stdout=subprocess.DEVNULL)\n    cpu = RV32IM()\n    cpu.load_elf(elf)\n    counting = False\n    counts = collections.Counter()\n    last_rd = 0\n    while cpu.retired < 5000000:\n        rec = cpu.step()\n        insn = rec['insn']\n        if rec['mem_wmask'] and rec['mem_addr'] == 0x10000104:\n            break\n        if counting:\n            counts['instructions'] += 1\n            if last_rd and last_rd in (rec['rs1'], rec['rs2']):\n                counts['raw_field_matches'] += 1\n                op = insn & 0x7f\n                if (last_rd == rec['rs1'] and op in (0x03,0x13,0x23,0x33,0x63,0x67)) or (last_rd == rec['rs2'] and op in (0x23,0x33,0x63)):\n                    counts['true_matches'] += 1\n            is_mul = (insn & 0xfe00407f) == 0x02000033\n            if is_mul:\n                counts['multiplies'] += 1\n                counts[f'mul_funct3_{(insn >> 12)&7}'] += 1\n            last_rd = rec['rd'] if is_mul else 0\n        if rec['mem_wmask'] and rec['mem_addr'] == 0x10000100:\n            counting = True\n    else:\n        sys.exit('stop marker missing')\n    print(dict(counts))\n    assert not cpu.oob_access\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
