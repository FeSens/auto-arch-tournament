x_stage','in.base_available && \"'!in.page_cross'\"', 'in.base_available && \"'!(in.page_cross ''^ dmem_addr[12])'\"')\nchange('ex_stage','  logic [31:0] alu_result;', '''  logic [31:0] alu_result;\n  /* verilator lint_off PINCONNECTEMPTY */''')\nchange('ex_stage','    .out (alu_result),','''    .out (),\n    .uncorrected (alu_result),\n    .upper0 (upper0),\n    .upper1 (upper1),\n    .low_carry (low_carry),''')\nchange('ex_stage','  // ── Branch resolve', '''  /* verilator lint_on PINCONNECTEMPTY */\n\n  // ── Branch resolve''')\nchange('ex_stage','  ex_mem_t reg_q;', '''  ex_mem_t reg_q;\n  logic [19:0] alu_alt_q;\n  logic alu_alt_en_q;\n  always_ff @(posedge clock) begin\n    if (\"'!stall) begin\n      alu_alt_q <= upper1;\n      alu_alt_en_q <= low_carry && !in.ctrl.is_jump && !in.ctrl.mem_read &&\n                      (in.ctrl.alu_op == ALU_ADD || in.ctrl.alu_op == ALU_SUB);\n    end\n  end'\"''')\nchange('ex_stage','  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    if (alu_alt_en_q) out.alu_result[31:12] = alu_alt_q;\n  end''')\nchange('core_pkg','    logic        page_cross;', '''    logic [19:0] alt_page;\n    logic        alt_page_en;\n    logic        page_cross;''')\nchange('core','  logic repair;', '''  logic [19:0] upper0, upper1;\n  logic low_carry;\n  logic repair;''')\nchange('core','    .lw_word', '''    .upper0   (upper0),\n    .upper1   (upper1),\n    .low_carry (low_carry),\n    .lw_word''')\nchange('core','    .alu_a', '''    .upper0          (upper0),\n    .upper1          (upper1),\n    .low_carry       (low_carry),\n    .alu_a''')\nchange('id_stage','  input  logic              repair,','''  input  logic [19:0]       upper0, upper1,\n  input  logic              low_carry,\n  input  logic              repair,''')\nchange('id_stage','  logic [31:0] add_base;', '  // The ADD page candidates are generated in the EX arithmetic slices.')\nchange('id_stage','  assign add_base = ex_a + ex_b;','')\nchange('id_stage','& add_base[