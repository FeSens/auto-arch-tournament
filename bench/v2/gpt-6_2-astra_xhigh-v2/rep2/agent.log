{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/r12\"\ncat > \"$TMPDIR/r12/groups.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport sys,os\nbase=Path(os.environ[\\\"TMPDIR\\\"])/\\\"r12\\\"\nlabel=sys.argv[1]\nwidth=int(sys.argv[2])\nmode=sys.argv[3] if len(sys.argv)>3 else 'select'\npath=base/label/'rtl'\ncopytree('cores/bench/rtl',path)\ndef sub(f,old,new):\n p=path/f; s=p.read_text(); assert old in s, (f,old); p.write_text(s.replace(old,new))\ndef disj(g,p,n,cin=None):\n terms=[]\n for i in range(n-1,-1,-1):\n  terms.append('('+' & '.join([g+'['+str(i)+']']+[p+'['+str(k)+']' for k in range(i+1,n)])+')')\n if cin: terms.append('('+' & '.join([cin]+[p+'['+str(k)+']' for k in range(n)])+')')\n return ' | '.join(terms)\nN=(32+width-1)//width\ns=f\\\"\\\"\\\"\n  function automatic logic [31:0] group_add(input logic [31:0] a,b, input logic cin);\n    logic [{N-1}:0] g,p;\n    logic [{N-1}:0] carry;\n\\\"\\\"\\\"\nfor i in range(N):\n w=min(width,32-i*width)\n l=i*width\n sl=f\\\"[{l+w-1}:{l}]\\\"\n s+=f\\\"    logic [{w-1}:0] s{i};\\\\n\\\"\n if i>0 and mode=='select': s+=f\\\"    logic [{w-1}:0] t{i};\\\\n\\\"\nfor i in range(N):\n w=min(width,32-i*width)\n l=i*width\n sl=f\\\"[{l+w-1}:{l}]\\\"\n s+=f\\\"    {{g[{i}],s{i}}} = {{1'b0,a{sl}}} + {{1'b0,b{sl}}};\\\\n\\\"\n s+=f\\\"    p[{i}] = &(a{sl} \"'^ b{sl});'\"\\\\n\\\"\n if i==0:\n  s+=f\\\"    carry[0] = cin;\\\\n    group_add{sl} = a{sl}+b{sl}+{w}'(cin);\\\\n\\\"\n else:\n  s+=f\\\"    carry[{i}] = {disj('g','p',i,'cin')};\\\\n\\\"\n  if mode=='select':\n   s+=f\\\"    t{i} = a{sl}+b{sl}+{w}'d1;\\\\n    group_add{sl} = carry[{i}] ? t{i} : s{i};\\\\n\\\"\n  else:\n   s+=f\\\"    group_add{sl} = a{sl}+b{sl}+{w}'(carry[{i}]);\\\\n\\\"\ns+=\\\"  endfunction\\\\n\\\"\ns+=f\\\"\\\"\\\"\n  function automatic logic group_lt(input logic [31:0] a,b);\n    logic [{N-1}:0] eq,lt;\n\\\"\\\"\\\"\nfor i in range(N):\n l=i*width\n sl=f\\\"[{min(32,l+width)-1}:{l}]\\\"\n s+=f\\\"    eq[{i}] = a{sl} == b{sl};\\\\n    lt[{i}] = a{sl} < b{sl};\\\\n\\\"\ns+=f\\\"    group_lt = {disj('lt','eq',N)};\\\\n  endfunction\\\\n\\\"\nsub('core_pkg.sv','\"'`endif // CORE_PKG_DEFINED'\"',s+'\\\\n\"'`endif // CORE_PKG_DEFINED'\"')\nsub('alu.sv','output logic [31:0] out,','output logic [31:0] out,\\\\n  output logic [31:0] add_sum,')\nsub('alu.sv','  always_comb begin','  always_comb begin') # first always_comb below\nsub('alu.sv','  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  logic alu_lt;\n  assign add_sum = group_add(a,b,1'b0);\n  assign alu_lt = group_lt(a,b);''')\nsub('alu.sv','out = a + b;', 'out = add_sum;')\nsub('alu.sv','out = a - b;', \\\"out = group_add(a,~b,1'b1);\\\")\nsub('alu.sv','\"'$signed(a) < $signed(b)'\"', \\\"(a[31] \"'^ b[31]) ? a[31] : alu_lt\")\nsub('\"'alu.sv','a < b}', 'alu_lt}')\nsub('ex_stage.sv','output logic [31:0]        alu_a, alu_b,','output logic [31:0]        alu_a, alu_b, add_sum,')\nsub('ex_stage.sv','.out (alu_result),','.out (alu_result),\\\\n    .add_sum (add_sum),')\np=path/'ex_stage.sv'\nss=p.read_text()\nst=ss.index('    case (in.ctrl.branch_op)')\ned=ss.index('    branch_taken',st)\nss=ss[:st]+'''    branch_cond = (in.ctrl.branch_op[2] ?\n      ((\"'!in.ctrl.branch_op[1] && (rs1[31] ''^ rs2[31])) ? rs1[31] : group_lt(rs1,rs2)) :\n      (rs1 == rs2)) ''^ in.ctrl.branch_op[0];\n'\"'''+ss[ed:]\np.write_text(ss)\nsub('core.sv','logic [31:0] repaired_addr, ex_a, ex_b;', 'logic [31:0] repaired_addr, ex_a, ex_b, add_sum;')\nsub('core.sv','.ex_b     (ex_b),','.ex_b     (ex_b),\\\\n    .add_sum  (add_sum),')\nsub('core.sv','.alu_b           (ex_b),','.alu_b           (ex_b),\\\\n    .add_sum         (add_sum),')\nsub('id_stage.sv','mem_result, ex_a, ex_b, lw_word,','mem_result, ex_a, ex_b, lw_word, add_sum,')\nsub('id_stage.sv','logic [12:0] ab_xor, carry, add_sum;', 'logic [12:0] ab_xor, carry, add_low;')\nsub('id_stage.sv','assign add_base = ex_a + ex_b;', 'assign add_base = add_sum;')\nsub('id_stage.sv','assign add_sum  =','assign add_low  =')\nsub('id_stage.sv','{13{use_add}} & add_sum','{13{use_add}} & add_low')\nPY\ncat > \\\"\"'$TMPDIR/r12/timing.py\" <<'\"'PY'\nfrom tools.eval.gowin import build,build_all\nfrom pathlib import Path\nimport sys,os\nbase=Path(os.environ[\\\"TMPDIR\\\"])/\\\"r12\\\"/sys.argv[1]\nfor res in build_all(Path.cwd(),base/'rtl','fpga/core_bench_si.sv',base/'timing',options=tuple(int(i) for i in sys.argv[2:])):\n print(res,flush=True)\nPY\npython \\\"\"'$TMPDIR/r12/groups.py\" byte 8 select\nPYTHONPATH=. python \"$TMPDIR/r12/timing.py\" byte 0 1 2 > \"$TMPDIR/r12/byte/timing.log\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
