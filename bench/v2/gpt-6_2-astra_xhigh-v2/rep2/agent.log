(* syn_ramstyle = \\\"block_ram\\\", ram_style = \\\"block\\\" *)\n  logic [23:0] seed_rom[0:16383];\n  initial begin\n    seed_rom[0] = 0;\n    for (int i=1; i<16384; i++)\n      seed_rom[i] = 24'(8388608/i);\n  end\n  assign approx = prefix_q * recip_q;\n  wire [22:0] estimate = approx[45:23];\n  always_ff @(posedge clock) begin\n    // The live input magnitudes were captured on the issue edge.\n    if (setup) begin\n      prefix_q <= quotient_q[31:9];\n      tail_q <= quotient_q[8:0];\n    end\n    recip_q <= seed_rom[divisor_q[13:0]];\n    if (groups_left == 3'd5) estimate_q <= estimate;\n    if (groups_left == 3'd4)\n      residual_q <= prefix_q[14:0] - (estimate_q[14:0] * divisor_q[13:0]);\n  end\n  wire adjust = residual_q >= {1'b0,divisor_q[13:0]};\n  assign seed_digit = estimate_q + {22'b0,adjust};\n  assign seed_rem = adjust ? (residual_q[13:0] - divisor_q[13:0]) : residual_q[13:0];\n\n''')\nedit('      quotient_q  <= ({32{setup}}','    end\\\\n  end\\\\n\\\\n  // Sign correction', '''      if (setup) begin\n        quotient_q <= {quotient_q[17:0], {14{zero_divisor}}};\n        remainder_q <= {18'b0, quotient_q[31:18]};\n      end else if (seed_small) begin\n        quotient_q <= {tail_q, seed_digit};\n        remainder_q <= {18'b0,seed_rem};\n      end else begin\n        quotient_q <= {quotient_q[28:0], wide_digit};\n        remainder_q <= wide_remainder;\n      end\n''')\nif name=='seedbank':\n edit('  (* syn_ramstyle = \\\"block_ram\\\"', '  assign approx =', '''  logic [23:0] parts [0:15];\n  logic [3:0] bank_q;\n  for (genvar bank=0; bank<16; bank++) begin : banks\n    localparam WIDTH = bank==0 ? 24 : \"'$clog2((8388608/(bank*1024))+1);\n    (* syn_ramstyle = \"block_ram\", ram_style = \"block\" *)\n    logic [WIDTH-1:0] rom[0:1023];\n    logic [WIDTH-1:0] part;\n    initial begin\n      for (int i=0; i<1024; i++) begin\n        rom[i] = bank==0 && i==0 ? '\"'0 : WIDTH'(8388608/(bank*1024+i));\n      end\n    end\n    always_ff @(posedge clock) part