data\\\"] == 0xfd8\n    assert rets[10][\\\"rd_wdata\\\"] == 0xfedc and mem[64] == 0xabcd\n\n'''+s[i:]\np.write_text(s)\nPY\npython moretests.py && cp -r cores/bench/test loadport/ && pytest -q loadport/test >loadport/tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
