{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py; cat fpga/core_bench_si.sv; cat fpga/bench_stall_gen.sv'", "aggregated_output": "\"\"\"Check combinational ALU operations and the six-clock RV32M divider.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _issue(dut, op, a, b):\n    assert int(dut.div_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value = 1\n    await _tick(dut)\n    dut.div_request.value = 0\n    # The request may disappear and all three inputs may change after issue.\n    dut.op.value = ALU_ADD\n    dut.a.value = 0xCAFE\n    dut.b.value = 0xBABE\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    await _issue(dut, op, a, b)\n    for _ in range(6):\n        assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _tick(dut)\n\n    pending = int(dut.div_result.value)\n    for delay in range(hold_cycles + 1):\n        assert int(dut.div_valid.value) and not int(dut.div_ready.value)\n        assert int(dut.div_result.value) == pending\n        if delay < hold_cycles:\n            await _tick(dut)\n    dut.di\n…[13099 of 16171 chars elided by tools/bench/transcript.py; sha256:766532c601776070]…\npair.\nmodule bench_stall_gen (\n  input  logic clock,\n  input  logic reset,\n  output logic imem_ready,\n  output logic dmem_ready\n);\n\n  function automatic [31:0] xs32(input [31:0] s);\n    reg [31:0] t;\n    begin\n      t = s ^ (s << 13);\n      t = t ^ (t >> 17);\n      xs32 = t ^ (t << 5);\n    end\n  endfunction\n\n  function automatic accept(input [31:0] s);\n    accept = (s[6:0] < 7'd100);\n  endfunction\n\n  // State after the two draws of the current cycle.\n  logic [31:0] state;\n  logic [31:0] next_i, next_d;\n  assign next_i = xs32(state);\n  assign next_d = xs32(next_i);\n\n  // Reset values: state after the two draws of cycle 0, and the accept\n  // bits of those two draws (seed 0xDEADBEEF; see test_bench_stall_gen.py).\n  always_ff @(posedge clock or posedge reset) begin\n    if (reset) begin\n      state      <= 32'h8E1D9142;\n      imem_ready <= 1'b1;\n      dmem_ready <= 1'b1;\n    end else begin\n      state      <= next_d;\n      imem_ready <= accept(next_i);\n      dmem_ready <= accept(next_d);\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
