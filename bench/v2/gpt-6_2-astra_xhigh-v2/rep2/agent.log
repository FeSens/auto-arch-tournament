{"type": "item.completed", "item": {"id": "item_30", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/core.sv | sed -n '60,230p'\"", "aggregated_output": ");\n\n  // ── Inter-stage wires ──────────────────────────────────────────────────\n  if_id_t  if_id_w;\n  id_ex_t  id_ex_q, id_ex_w;\n  ex_mem_t ex_mem_w;\n  mem_wb_t mem_wb_w;\n\n  // hazard / forward\n  logic       stall_id, flush_id;\n  logic       stall_ex_mem, hold_mem_wb, div_wait;\n  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\n\n  // EX redirect\n  logic        redirect;\n  logic [31:0] redirect_target;\n\n  // regfile interface (driven by ID + WB stages)\n  logic [4:0]  rs1_addr_w;\n  logic [4:0]  rs2_addr_w;\n  logic [31:0] rs1_data_w;\n  logic [31:0] rs2_data_w;\n  logic        wb_w_en;\n  logic [4:0]  wb_w_addr;\n  logic [31:0] wb_w_data;\n\n  // ── IF ────────────────────────────────────────────────────────────────\n  logic annul, ex_likely_direct, ex_fence_i;\n\n  // Annul the enables while EX selects and computes its operands in parallel.\n  always_comb begin\n    id_ex_w = id_ex_q;\n    if (annul) begin\n      id_ex_w.valid            = 1'b0;\n      id_ex_w.ctrl.is_branch   = 1'b0;\n      id_ex_w.ctrl.is_jump     = 1'b0;\n      id_ex_w.ctrl.is_jalr     = 1'b0;\n      id_ex_w.ctrl.mem_read    = 1'b0;\n      id_ex_w.ctrl.mem_write   = 1'b0;\n      id_ex_w.ctrl.reg_write   = 1'b0;\n      id_ex_w.ctrl.late_result = 1'b0;\n    end\n  end\n  assign ex_likely_direct = (id_ex_w.ctrl.is_jump && !id_ex_w.ctrl.is_jalr) ||\n                            (id_ex_w.ctrl.is_branch && id_ex_w.imm[31]);\n  assign ex_fence_i = id_ex_w.valid && id_ex_w.instr[6:0] == 7'b0001111 &&\n                      id_ex_w.instr[14:12] == 3'b001;\n\n  if_stage u_if (\n    .clock           (clock),\n    .reset           (reset),\n    .ex_valid        (id_ex_w.valid),\n    .ex_pc           (id_ex_w.pc),\n    .ex_word_disp    (id_ex_w.imm[10:2]),\n    .ex_likely_direct(ex_likely_direct),\n    .ex_fence_i      (ex_fence_i),\n    .stall           (stall_id),\n    .imem_ready      (io_imemReady),\n    .redirect        (redirect),\n    .redirect_target (redirect_target),\n    .imem_addr       (io_imemAddr),\n    .imem_data       (io_imemData),\n    .annul           (annul),\n    .out             (if_id_w)\n…[2394 of 5466 chars elided by tools/bench/transcript.py; sha256:7bad24ce117a0eb7]…\n.dmem_rdata      (io_dmemRData),\n    .dmem_wen        (io_dmemWEn),\n    .dmem_ren        (io_dmemREn),\n    .div_wait        (div_wait),\n    .div_result      (div_result),\n    .redirect        (redirect),\n    .redirect_target (redirect_target)\n  );\n\n  // ── MEM ───────────────────────────────────────────────────────────────\n  mem_stage u_mem (\n    .clock      (clock),\n    .reset      (reset),\n    .hold_wb    (hold_mem_wb),\n    .in         (ex_mem_w),\n    .div_result (div_result),\n    .out        (mem_wb_w)\n  );\n\n  // ── WB ────────────────────────────────────────────────────────────────\n  wb_stage u_wb (\n    .in     (mem_wb_w),\n    .w_en   (wb_w_en),\n    .w_addr (wb_w_addr),\n    .w_data (wb_w_data)\n  );\n\n  // ── Hazard / forwarding ───────────────────────────────────────────────\n  hazard_unit u_hazard (\n    .id_ex_late_result (id_ex_w.ctrl.late_result),\n    .id_ex_rd       (id_ex_w.rd),\n    .if_id_rs1      (if_id_w.instr[19:15]),\n    .if_id_rs2      (if_id_w.instr[24:20]),\n    .fetch_valid    (if_id_w.valid),\n", "exit_code": 0, "status": "completed"}}
