{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r14profile.cpp\" <<'\"'EOF'\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <vector>\n#include <algorithm>\nusing u32=uint32_t;\nstruct Ins {u32 pc,npc,ins,addr,cycle,rd,rs1,rs2;};\nstruct B {u32 pc=~0u,tgt=0,kind=0,cnt=1;};\nvoid run(const std::vector<Ins> &ins,int n,int history,int pattern,int use_stack) {\n  std::vector<B> btb(n); std::vector<int> counters(pattern,1); std::vector<int> locals(n);\n  std::vector<u32> stack;\n  int gh=0,hm=(1<<abs(history))-1,nb=0,miss=0,missbr=0,missjal=0,missjr=0,ras=0;\n  int imiss=0,ifetch=0;std::vector<u32> ic(2048,~0u);\n  for (auto &r:ins) {\n    bool timed=(r.cycle>11828&&r.cycle<=3246824);\n    auto pc=r.pc, npc=r.npc, w=pc>>2, op=r.ins&127, rd=(r.ins>>7)&31, rs1=(r.ins>>15)&31;\n    auto &cache=ic[w%ic.size()]; imiss+=timed&&(cache\"'!=pc); ifetch+=timed;cache=pc;\n    bool br=op==99,jal=op==111,jr=op==103;\n    if (!br&&!jal&&!jr) continue;\n    bool is_link=rd==1||rd==5, from_link=rs1==1||rs1==5;\n    bool pop=jr&&from_link&&(!is_link||rs1!=rd);\n    auto &e=btb[w&(n-1)];\n    auto &hist=locals[w&(n-1)];\n    int pi= history<0 ? ((w<<(abs(history)))''^hist)&(pattern-1): ((w''^gh)&(pattern-1));\n    int pred=history ? counters[pi] : e.cnt;\n    auto pn=pc+4; \n    if(e.pc==pc && (!br || pred>=2)) pn=e.tgt;\n    if(use_stack && e.pc==pc&&e.kind==3 && !stack.empty()) pn=stack.back();\n    if(timed){\n      nb+=br;miss+=pn!=npc;missbr+=br&&pn!=npc;missjal+=jal&&pn!=npc;missjr+=jr&&pn!=npc;ras+=pop&&pn!=npc;\n    }\n    if(pop&&!stack.empty())stack.pop_back();\n    if((jr||jal)&&is_link){if(stack.size()==8)stack.erase(stack.begin());stack.push_back(pc+4);}\n    if(e.pc!=pc){e=B{};e.pc=pc;}\n    bool taken=npc!=pc+4;\n    if(br) {\n      u32 imm=((r.ins>>31)?0xfffff000:0) | ((r.ins>>7&1)<<11) | ((r.ins>>25&63)<<5) | ((r.ins>>8&15)<<1);\n      e.tgt=pc+imm;e.cnt=std::min(3,std::max(0,int(e.cnt)+(taken?1:-1)));\n      counters[pi]=std::min(3,std::max(0,counters[pi]+(taken?1:-1)));\n      hist=((hist<<1)|taken)&hm; gh=((gh<<1)|taken)&hm;\n    } else e.tgt=npc;\n    e.kind=pop?3:(jr?2:(!br));\n  }\n  printf(\"BTB%4d hist%3d pht%5d ras%d: %7d all, %6d branch, %6d JAL, %6d JALR (%6d return), %d cold I rows / %d total, %d branches'\"\\\\n\\\",n,history,pattern,use_stack,miss,missbr,missjal,missjr,ras,imiss,ifetch,nb);\n}\nint main(int argc,char**argv){\n  auto f=fopen(argv[1],\\\"rb\\\"); std::vector<Ins> ins;Ins i;while(fread(&i,sizeof(i),1,f))ins.push_back(i);\n  for(int n:{128,256,512,1024}) for(int h:{0,6,10,-4,-6}) run(ins,n,h,2048,1);\n  run(ins,256,0,2048,0);\n}\nEOF\ng++ -O3 \\\"\"'$TMPDIR/r14profile.cpp\" -o \"$TMPDIR/r14profile\" && \"$TMPDIR/r14profile\" \"$TMPDIR/r14trace.bin\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
