{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c 'ls -la \"$TMPDIR/microprobe\" && ls -la \"$TMPDIR/microprobe/base/gowin_p1\" && rg -n '\"'stall|flush|late_result' cores/bench/rtl/id_stage.sv && cat tools/eval/_slots.py | head -160 && ls -la bench/programs\"","aggregated_output":"total 24\ndrwxrwx---+ 3 hwebench hwebench 4096 Nov 20 05:07 .\ndrwxrwx---+ 8 nobody   nogroup  4096 Nov 20 05:08 ..\ndrwxrwx---+ 3 hwebench hwebench 4096 Nov 20 05:07 base\ntotal 48\ndrwxrwx---+ 4 hwebench hwebench  4096 Nov 20 05:07 .\ndrwxrwx---+ 3 hwebench hwebench  4096 Nov 20 05:07 ..\ndrwx------+ 2 hwebench hwebench  4096 Nov 20 05:07 .xdg\n-rw-rw----+ 1 hwebench hwebench  2547 Nov 20 05:07 build.tcl\n-rw-rw----+ 1 hwebench hwebench 10510 Nov 20 05:07 gw.log\ndrwxrwx---+ 4 hwebench hwebench  4096 Nov 20 05:07 impl\n14:  input  logic              stall,\n15:  input  logic              flush,\n85:    ctrl_decoded.late_result = dec_mem_read || dec_alu_op == ALU_MUL\n96:    if (reset || flush) begin\n98:    end else if (!stall) begin\n\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\ntotal 464\ndrwxrwx---+  3 nobody nogroup   4096 Nov 20 05:06 .\ndrwxrwx---+  3 nobody nogroup   4096 Nov 20 05:06 ..\n-rw-rw----+  1 nobody nogroup   2317 Nov 20 05:06 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 20 05:06 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 20 05:06 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 20 05:06 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 20 05:06 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 20 05:06 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 20 05:06 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 20 05:06 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 20 05:06 selftest.S\n","exit_code":0,"status":"completed"}}
