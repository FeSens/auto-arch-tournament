{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/write_div.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nbase=Path('cores/bench/rtl/alu.sv').read_text()\ntarget=Path(os.environ['TMPDIR'])/'nibble/cores/bench/rtl/alu.sv'\nbase=base.replace(\\\"groups_left <= 3'd6\\\", \\\"groups_left <= 3'd7\\\")\nheader,tail=base.split('  logic [31:0] quotient_q, remainder_q, divisor_q;')\n_,tail=tail.split('  // Sign correction',1)\ns=\\\"\\\"\\\"\n  logic [31:0] quotient_q, remainder_q, divisor_q;\n  logic [35:0] multiple [0:15];\n  logic [3:0] digit, seed_digit, seed_remainder;\n  logic [35:0] trial;\n  logic [16:0] fits;\n  logic [15:0] pick;\n  logic [31:0] selected [0:15], diff [0:15], next_remainder;\n  logic        want_remainder, a_negative, b_negative, remainder_op_q, negate_q;\n  logic [31:0] magnitude;\n  assign want_remainder = (op == ALU_REM) || (op == ALU_REMU);\n  assign a_negative = ((op == ALU_DIV) || (op == ALU_REM)) && a[31];\n  assign b_negative = ((op == ALU_DIV) || (op == ALU_REM)) && b[31];\n  assign multiple[0] = '0;\n  assign multiple[1] = {4'b0, divisor_q};\n  function automatic logic [35:0] csa3(input logic [35:0] x,y,z);\n    csa3 = (x \"'^ y ''^ z) + (((x & y) | ((x ''^ y) & z)) << 1);\n  endfunction\n\"\"\"\nfor i in range(2,16):\n    if i%2==0:\n        s+=f\"  assign multiple[{i}] = multiple[{i//2}] << 1;'\"\\\\n\\\"\nodd={3:'(d << 1) + d',5:'(d << 2) + d',7:'(d << 3) - d',9:'(d << 3) + d',11:'csa3(d << 3, d << 1, d)',13:'csa3(d << 3, d << 2, d)',15:'(d << 4) - d'}\ns+=\\\"  wire [35:0] d = multiple[1];\\\\n  always_ff @(posedge clock) begin\\\\n    if (groups_left == 7) begin\\\\n\\\"\nfor k,v in odd.items():\n    s+=f\\\"      multiple[{k}] <= {v};\\\\n\\\"\ns+=\\\"    end\\\\n  end\\\\n\\\"\ns+=\\\"\\\"\\\"\n  always_comb begin\n    seed_digit = 0;\n    seed_remainder = quotient_q[31:28];\n    case (divisor_q)\n      0: seed_digit = 15;\n\\\"\\\"\\\"\nfor d in range(1,16):\n    s+=f'      {d}: begin\\\\n        case (quotient_q[31:28])\\\\n'\n    for a in range(d,16):\n        s+=f\\\"          4'd{a}: {{seed_digit, seed_remainder}} = 8'h{a//d*16+a%d:02x};\\\\n\\\"\n    s+='          default: ;\\\\n        endcase\\\\n      end\\\\n'\ns+=\\\"\\\"\\\"\n      default: ;\n    endcase\n  end\n  assign trial = {remainder_q, quotient_q[31:28]};\n  assign fits[0] = 1;\n  assign fits[16] = 0;\n  assign diff[0] = trial[31:0];\n  for (genvar i=1; i < 16; i++) begin : g_trial\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [36:0] residual;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign residual = {1'b0,trial} - {1'b0,multiple[i]};\n    assign fits[i] = \"'!residual[36];\n    assign diff[i] = residual[31:0];\n  end\n  assign pick = fits[15:0] & ~fits[16:1];\n  for (genvar i=0; i < 16; i++) begin : g_pick\n    assign selected[i] = {32{pick[i]}} & diff[i];\n  end\n\"\"\"\nfor bit in range(4):\n    s+=f\"  assign digit[{bit}] = \"+'\"' | '.join(f\\\"pick[{i}]\\\" for i in range(16) if i & (1<<bit))+';\\\\n'\ns+=\\\"  assign next_remainder = \\\"+' | '.join(f\\\"selected[{i}]\\\" for i in range(16))+\\\";\\\\n\\\"\ns+=\\\"\\\"\\\"\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      quotient_q     <= a_negative ? -a : a;\n      divisor_q      <= b_negative ? -b : b;\n      remainder_op_q <= want_remainder;\n      negate_q <= want_remainder ? a_negative : ((a_negative \"'^ b_negative) && b != 0);\n    end else if (groups_left == 3'\"'d7) begin\n      quotient_q  <= {quotient_q[27:0], seed_digit};\n      remainder_q <= {28'b0, seed_remainder};\n    end else if (groups_left \"'!= 0 || (div_valid && div_consume)) begin\n      quotient_q  <= {quotient_q[27:0], digit};\n      remainder_q <= next_remainder;\n    end\n  end\n\n  // Sign correction\"\"\"\ntarget.write_text(header+s+tail)\nPY\npython \"$TMPDIR/write_div.py\"\npython -m tools.eval.gowin bench --worktree \"$TMPDIR/nibble\" --all-options'","aggregated_output":"","exit_co