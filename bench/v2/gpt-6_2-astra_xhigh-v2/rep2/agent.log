{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/{if_stage,hazard_unit}.sv; rg -n 'redirect|stall_if|imemReady|Latency' cores/bench/rtl/core.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Pass the bus word directly to decode and the source-register comparators.\n// ID/EX discards an unavailable fetch or a wrong-path instruction.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_data;\n    out.valid = imem_ready;\n  end\n\nendmodule\n// rtl/hazard_unit.sv\n//\n// Loads and products are first available in MEM/WB. Compare the fetched\n// register fields in parallel with EX redirect resolution. A match holds\n// the PC and inserts a bubble while the producer advances through MEM.\n//\n// Latency:        comb\n…[2132 of 5204 chars elided by tools/bench/transcript.py; sha256:0ffb9e3f10873631]…\nEX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n18:// Latency:        full pipeline; instruction n retires at MEM/WB on\n20://                 redirect).\n34:  input  logic        io_imemReady,\n79:  logic       stall_if, stall_id, flush_id;\n83:  // EX redirect\n84:  logic        redirect;\n85:  logic [31:0] redirect_target;\n100:    .stall           (stall_if),\n101:    .imem_ready      (io_imemReady),\n102:    .redirect        (redirect),\n103:    .redirect_target (redirect_target),\n147:    .redirect        (redirect),\n148:    .redirect_target (redirect_target)\n179:    .redirect       (redirect),\n184:    .stall_if       (stall_if),\n", "exit_code": 0, "status": "completed"}}
