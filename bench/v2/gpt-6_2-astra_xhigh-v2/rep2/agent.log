{"type": "item.completed", "item": {"id": "item_64", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv cores/bench/rtl/hazard_unit.sv; tail -33 cores/bench/rtl/id_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// The instruction in EX selects its successor on the combinational imem\n// bus. When ID/EX takes a bubble, retry the address presented on that edge.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              ex_valid,\n  input  logic [31:0]       ex_pc,\n  input  logic [31:0]       ex_instr,\n  input  logic              imem_ready,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  // Store word i at i-1 so the registered PC addresses the fall-through\n  // word while EX resolves the branch and the bus selects its address.\n  logic [31:0] words [0:127];\n  logic [127:0] slot_valid, captured_word;\n  logic [22:0] region_tag;\n  logic [6:0] ex_slot, write_slot, retry_slot;\n  logic same_region, fence, ex_hit, retry_hit;\n\n  assign ex_slot = ex_pc[8:2];\n  assign write_slot = ex_slot - 7'd1;\n  assign captured_word = 128'b1 << ex_slot;\n  assign same_region = region_tag == ex_pc[31:9];\n  assign fence = ex_instr[6:0] == 7'b0001111;\n\n  always_ff @(posedge clock) begin\n    if (ex_valid) begin\n      words[write_slot] <= ex_instr;\n      region_tag <= ex_pc[31:9];\n    end\n    if (reset || (ex_valid && fence))\n      slot_valid <= '0;\n    else if (ex_valid)\n      slot_valid <= (slot_valid & {128{same_region}}) | {captured_word[0], captured_word[127:1]};\n  end\n\n  assign ex_hit = same_region && slot_valid[ex_slot] && ex_slot != 7'd127\n               && !redirect && !fence;\n\n  always_ff @(posedge clock) begin\n    // A late-result interlock can bubble ID/EX even on a replay hit.\n    // Keep the decision and data address paired with the PC during retries.\n    if (reset) retry_hit <= 1'b0;\n    else if (ex_valid) retry_hit <= ex_hit;\n    if (ex_valid) retry_slot <= ex_slot;\n  end\n\n  // ID/EX captures the requested PC even on a bubble, so its PC register\n  // also holds the retry address un\n…[2823 of 5895 chars elided by tools/bench/transcript.py; sha256:dc621670d10b19de]…\n           || dec_alu_op == ALU_MULH || dec_alu_op == ALU_MULHU\n                             || dec_alu_op == ALU_MULHSU;\n    ctrl_decoded.mem_to_reg = dec_mem_to_reg;\n    ctrl_decoded.is_illegal = dec_is_illegal;\n  end\n\n  // ── ID/EX register ──────────────────────────────────────────────────────\n  id_ex_t reg_q;\n\n  always_ff @(posedge clock) begin\n    // Only validity depends on replay admission and interlocks. Capture\n    // the decode payload on every unheld edge, including bubble cycles.\n    if (reset) reg_q.valid <= 1'b0;\n    else if (!stall) reg_q.valid <= in.valid && !flush;\n\n    if (reset) reg_q.pc <= '0;\n    else if (!stall) reg_q.pc <= in.pc;\n\n    if (!stall) begin\n      reg_q.rs1_val  <= rs1_data;\n      reg_q.rs2_val  <= rs2_data;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.ctrl     <= ctrl_decoded;\n      reg_q.instr    <= in.instr;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
