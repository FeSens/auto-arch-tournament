{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r10/port.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\ntmp=Path(os.environ['TMPDIR'])/'r10';name=sys.argv[1];rtl=tmp/name/'rtl';shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\ndef rep(f,x,y):\n p=rtl/(f+'.sv');s=p.read_text();assert x in s,x;p.write_text(s.replace(x,y))\ndef before(f,x,y):rep(f,x,y+x)\nbits=int(''.join(c for c in name if c.isdigit()))\nbefore('id_stage','  input  logic              repair,','  output logic [31:0]       candidate,\\\\n')\nbefore('id_stage','  always_ff @(posedge clock)', '  assign candidate = {page, low_sum[11:0]};\\\\n\\\\n')\nbefore('core','  logic [31:0] repaired_addr,', '  logic [31:0] candidate, req_addr, req_wdata, response;\\\\n  logic req_rd, req_ready;\\\\n  logic [3:0] req_wr;\\\\n')\nbefore('core','    .repaired_addr (repaired_addr),', '    .candidate(candidate),\\\\n')\nrep('core','&& io_dmemREn && io_dmemReady;', '&& req_rd && req_ready;')\nrep('core','(io_dmemRData)', '(response)')\nfor x,y in [('io_dmemAddr','req_addr'),('io_dmemWData','req_wdata'),('io_dmemREn','req_rd'),('io_dmemWEn','req_wr'),('io_dmemReady','req_ready')]: rep('core','('+x+')','('+y+')') if '('+x+')' in (rtl/'core.sv').read_text() else None\nrep('core','(io_dmemREn || (|req_wr))','(req_rd || (|req_wr))')\nbefore('core','  // ── MEM ─', '''  data_port u_data (\n    .clock(clock), .reset(reset), .stall(stall_id), .repair(repair),\n    .candidate(candidate), .repaired_addr(repaired_addr), .req_addr(req_addr),\n    .req_rd(req_rd), .req_wr(req_wr), .req_wdata(req_wdata),\n    .width(id_ex_w.ctrl.mem_width), .req_ready(req_ready), .response(response),\n    .bus_ready(io_dmemReady), .bus_data(io_dmemRData), .bus_addr(io_dmemAddr),\n    .bus_wdata(io_dmemWData), .bus_wen(io_dmemWEn), .bus_ren(io_dmemREn)\n  );\n\n''')\n# Implement with a guarded bank read in parallel with ID. A RAM load hits\n# only if all four bytes are known, ensuring correct raw RVFI word too.\np=rtl/'data_port.sv'\np.write_text('''module data_port (\n  input logic clock, reset, stall, repair,\n  input logic [31:0] candidate, repaired_addr, req_addr, req_wdata,\n  input logic req_rd, input logic [3:0] req_wr, input logic [1:0] width,\n  output logic req_ready, output logic [31:0] response,\n  input logic bus_ready, input logic [31:0] bus_data,\n  output logic [31:0] bus_addr, bus_wdata,\n  output logic [3:0] bus_wen, output logic bus_ren\n);\n  localparam K = BITS;\n  localparam T = 18-K;\n  logic pending;\n  logic [31:0] pending_addr, pending_data;\n  logic [3:0] pending_mask;\n  logic ram, wr, post;\n  assign ram = req_addr[31:20]==0;\n  assign wr = |req_wr;\n  assign post = wr && ram && (\"'!pending || bus_ready);\n\n  logic [K-1:0] clear_idx, read_idx, write_idx;\n  logic clearing, usable, hit, fill, write_en;\n  logic [T+32:0] row;\n  logic [31:0] seen_data;\n  (* syn_ramstyle = \"block_ram\", ram_style = \"block\" *)\n  logic [T+32:0] entries[0:(1<<K)-1];\n  wire [T-1:0] tag = req_addr[19:K+2];\n  assign hit = usable && ram && row[T+32] && tag == row[T+31:32];\n  wire live = !pending && bus_ready;\n  assign req_ready = req_rd ? (live || hit) : (wr ? (live || post) : 1'\"'b1);\n  assign response = live ? bus_data : row[31:0];\n  // An occupied store entry owns the external port until acceptance.\n  assign bus_addr  = pending ? pending_addr : req_addr;\n  assign bus_wdata = pending ? pending_data : req_wdata;\n  assign bus_wen   = pending ? pending_mask : req_wr;\n  assign bus_ren   = \"'!pending && req_rd && (bus_ready || !hit);\n\n  always_ff @(posedge clock) begin\n    if (reset) pending <= 0;\n    else if (post && !live) begin\n      pending <= 1;\n      pending_addr <= req_addr;\n      pending_data <= req_wdata;\n      pending_mask <= req_wr;\n    end else if (bus_ready) pending <= 0;\n  end\n  // A full store replaces the row. A partial store invalidates its row.\n  assign fill = ram && ((req_rd && live) || (wr && req_ready));\n  assign seen_data = wr ? req_wdata : bus_data;\n  assign write_en = clearing || fill;\n  assign write_idx = clearing ? clear_idx : req_addr[K+1:2];\n  assign read_idx = repair ? repaired_addr[K+1:2] : candidate[K+1:2];\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      clearing <= 1;\n      clear_idx <= 0;\n    end else if (clearing) begin\n      clear_idx <= clear_idx + 1'\"'b1;\n      clearing <= \"'!(&clear_idx);\n    end\n    if (write_en)\n      entries[write_idx] <= {!clearing && (!wr || (&req_wr)), tag, seen_data};\n    if (repair || !stall) row <= entries[read_idx];\n    if (reset || clearing) usable <= 0;\n    else if (repair || !stall) usable <= !(fill && write_idx == read_idx);\n  end\nendmodule\n'\"'''.replace('BITS',str(bits)))\n# Caching partial-store lanes permits most byte loads to hit. RVFI can\n# report unspecified bits on unused lanes; choose canonical bus input if live.\nif 'lane' in name:\n s=p.read_text().replace('[T+32:0]','[T+35:0]').replace('row[T+32]','((row[T+35:T+32] & need) == need)').replace('  assign hit =','  wire [3:0] need = access_mask(width,req_addr[1:0]);\\\\n  assign hit =').replace('\"'!clearing && (!wr || (&req_wr)), tag'\"','({4{\"'!clearing}} & (wr ? req_wr : 4'\"\\\\'hf)), tag');p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/r10/port.py\" lane9 && python \"$TMPDIR/r10/port.py\" port10 && PYTHONPATH=. python \"$TMPDIR/r10/timeit.py\" lane9:1 port10:1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
