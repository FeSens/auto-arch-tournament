{"type": "item.completed", "item": {"id": "item_75", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// EX computes integer results. After six wait clocks, div_valid lets EX\n// transfer the divide instruction. That edge corrects the reciprocal\n// estimate for a small divisor or finishes the final radix-16 digit,\n// and div_result supplies the resident MEM slot until the next issue.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_request,\n  output logic        div_ready,\n  output logic        div_valid,\n  output logic [31:0] div_result,\n  input  logic        div_consume\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:  out = 32'b0;\n    endcase\n  end\n\n  logic [2:0] groups_left;\n  logic       div_start;\n  assign div_ready = (groups_left == 0) && !div_valid;\n  assign div_start = div_request && div_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      groups_left <= 3'd0;\n      div_valid   <= 1'b0;\n    end else if (div_start) begin\n      groups_left <= 3'd6;\n    end else if (groups_left != 0) begin\n      groups_left <= groups_left - 3'd1;\n      div_valid   <= (groups_left == 3'd1);\n    end else if (div_consume) begin\n      div_valid <= 1'b0;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      case (op)\n        ALU_DIV:  alt_result_q <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: alt_result_q <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  alt_resu\n…[8062 of 11134 chars elided by tools/bench/transcript.py; sha256:f22dd1a2ac6a8eb5]…\nt : next_remainder;\n    end\n  end\n\n  logic [31:0] magnitude;\n  assign magnitude = large_quotient_q ? {8'b0, quotient_q} : remainder_q;\n  assign div_result = negate_q ? -magnitude : magnitude;\n`endif\n\nendmodule\n\n/* verilator lint_off DECLFILENAME */\nmodule mul_product (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n/* verilator lint_on DECLFILENAME */\n`ifdef RISCV_FORMAL_ALTOPS\n  always_comb begin\n    case (op)\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      default:    out = 32'b0;\n    endcase\n  end\n`else\n  logic signed [32:0] lhs, rhs;\n  logic signed [63:0] product;\n\n  assign lhs = $signed({a[31] && (op == ALU_MULH || op == ALU_MULHSU), a});\n  assign rhs = $signed({b[31] && op == ALU_MULH, b});\n  assign product = lhs * rhs;\n  assign out = op == ALU_MUL ? product[31:0] : product[63:32];\n`endif\nendmodule\n", "exit_code": 0, "status": "completed"}}
