/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\ntools/eval/gowin.py:128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\ntools/eval/gowin.py:133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\ntools/eval/gowin.py:158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\ntools/eval/gowin.py:173:    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\ntools/eval/gowin.py:175:                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\ntools/eval/gowin.py:221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\ngowin\nhwe-python\nhwe-toolchain\nalu.sv\ncore.sv\ncore_pkg.sv\ndecoder.sv\nex_stage.sv\nforward_unit.sv\nhazard_unit.sv\nid_stage.sv\nif_stage.sv\nimm_gen.sv\nmem_stage.sv\nreg_file.sv\nwb_stage.sv\n","exit_code":0,"status":"completed"}}
