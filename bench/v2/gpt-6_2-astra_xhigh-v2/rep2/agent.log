\n\n@cocotb.test()\nasync def multiply_held_behind_store(dut):\n    program = [\n        ADDI(1, 0, 5), ADDI(2, 0, -7), MUL(3, 1, 2),\n        SW(1, 0, 0x44), MUL(4, 1, 3), SW(4, 0, 0x48), EBREAK(),\n    ]\n    wait_cycles = 0\n    writes = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n        nonlocal wait_cycles\n        assert not ren\n        if wen:\n            if addr == 0x44:\n                # EX holds the store with the dependent multiply at fetch.\n                assert (pc, wen, data) == (16, 15, 5)\n                if wait_cycles < 4:\n                    wait_cycles += 1\n                    return 1, 0\n            writes.append((addr, wen, data))\n        return 1, 1\n\n    rets, _ = await _run(dut, program, bus_ready=bus_ready)\n    assert wait_cycles == 4\n    assert writes == [(0x44, 15, 5), (0x48, 15, -175 & 0xFFFFFFFF)]\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert rets[2][\"rd_wdata\"] == rets[4][\"rs2_rdata\"] == (-35 & 0xFFFFFFFF)\n    assert rets[4][\"rs1_rdata\"] == 5\n    assert rets[4][\"rd_wdata\"] == rets[5][\"rs2_rdata\"] == (-175 & 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def discard_store_on_invalid_fetch_and_redirect(dut):\n    store = SW(1, 0, 0x4C)\n    program = [\n        ADDI(1, 0, 37), BEQ(1, 1, 8), store,\n        JAL(2, 8), store, ADDI(3, 2, 5), EBREAK(),\n    ]\n    fetches = []\n    denials = {4: 3, 12: 2, 20: 1}\n\n    def bus_ready(pc, addr, ren, wen, data):\n        assert not (ren or wen), f\"discarded store issued a bus request at {addr:#x}\"\n        fetches.append(pc)\n        # Supply a store on denied sequential, branch-target and JAL-target reads.\n        return fetches.count(pc) > denials.get(pc, 0), 1\n\n    rets, _ = await _run(dut, program, bus_ready=bus_ready, unready_instr=store)\n    assert 8 not in fetches and 16 not in fetches\n    assert fetches[:10] == [4] * 4 + [12] * 3 + [20] * 2 + [24]\n    pcs = [0, 4, 12, 20, 24]\n77:COREMARK_SIM_FLAGS = [\"--bench\", \"--istall\", \"--dstall\"]\n215:            [sim_bin, elf, \"50000000\"] + COREMARK_SIM_FLAGS,\n1.6M\t/srv/hwebench/tmp/3c491641/b29e33c6/earlyrf/timing/gowin_p0\n1.6M\t/srv/hwebench/tmp/3c491641/b29e33c6/earlyrf/timing/gowin_p1\n1.6M\t/srv/hwebench/tmp/3c491641/b29e33c6/earlyrf/timing/gowin_p2\n", "exit_code": 0, "status": "completed"}}
