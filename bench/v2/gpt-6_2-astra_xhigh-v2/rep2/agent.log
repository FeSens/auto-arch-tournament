{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"sed -n '243,304p' cores/bench/test/test_pipeline.py && cat cores/bench/test/_helpers.py\"", "aggregated_output": "        LW(8, 0, 0x40), MUL(9, 1, 8),\n        MUL(0, 1, 2), ADD(10, 0, 9),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert all(not r[\"trap\"] for r in rets)\n\n    for idx, lhs, rhs, result in [\n        (2, -3, -2, 6), (3, -3, -2, 0), (4, -3, -2, -5), (5, -3, -2, -3),\n        (6, -3, 6, -18), (9, -3, -18, 54), (10, -3, -2, 0), (11, 0, 54, 54),\n    ]:\n        r = rets[idx]\n        assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"]) == (\n            lhs & 0xFFFFFFFF, rhs & 0xFFFFFFFF, result & 0xFFFFFFFF\n        )\n        assert r[\"rd\"] == ((program[idx] >> 7) & 31)\n        assert r[\"mem_rmask\"] == r[\"mem_wmask\"] == 0\n    assert rets[7][\"rs2_rdata\"] == rets[7][\"mem_wdata\"] == dmem[0x40] == (-18 & 0xFFFFFFFF)\n    assert rets[8][\"rd_wdata\"] == dmem[0x40]\n\n    # Only the adjacent MUL-to-MUL, MUL-to-SW and LW-to-MUL need bubbles.\n    for i in range(1, len(program)):\n        assert rets[i][\"cycle\"] - rets[i - 1][\"cycle\"] == (2 if i in (6, 7, 9) else 1)\n\n\n@cocotb.test()\nasync def multiply_held_behind_store(dut):\n    program = [\n        ADDI(1, 0, 5), ADDI(2, 0, -7), MUL(3, 1, 2),\n        SW(1, 0, 0x44), MUL(4, 1, 3), SW(4, 0, 0x48), EBREAK(),\n    ]\n    wait_cycles = 0\n    writes = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n        nonlocal wait_cycles\n        assert not ren\n        if wen:\n            if addr == 0x44:\n                # x3 is in MEM/WB. EX holds the multiply and fetch holds its consumer.\n                assert (pc, wen, data) == (20, 15, 5)\n                if wait_cycles < 4:\n                    wait_cycles += 1\n        