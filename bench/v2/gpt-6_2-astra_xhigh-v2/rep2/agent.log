{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/borrow.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nr=Path(os.environ['TMPDIR'])\nname=sys.argv[1]; w=r/name; (w/'cores/bench').mkdir(exist_ok=True,parents=True)\nshutil.copytree('cores/bench/rtl',w/'cores/bench/rtl',dirs_exist_ok=True);shutil.copyfile('cores/bench/core.yaml',w/'cores/bench/core.yaml')\nif not (w/'fpga').exists(): (w/'fpga').symlink_to(Path.cwd()/'fpga')\np=w/'cores/bench/rtl/alu.sv'; s=p.read_text()\na=s.index('      logic borrow;'); b=s.index('    end',a)\nq=\\\"\\\"\\\"\n      localparam integer G = 9;\n      localparam integer N = (WIDTH+G-1)/G;\n      wire [N-1:0] eq, lt;\n      for (genvar j=0; j<N; j++) begin : g_block\n        localparam integer W = (j+1)*G <= WIDTH ? G : WIDTH-j*G;\n        wire [W-1:0] x = trial[j*G +: W];\n        wire [W-1:0] y = multiple[k][j*G +: W];\n        assign eq[j] = x == y;\n        assign lt[j] = x < y;\n      end\n      wire borrow = lt[3] || (eq[3] && lt[2]) || ((&eq[3:2]) && lt[1])\n                 || ((&eq[3:1]) && lt[0]);\n      assign fits[k] = \"'!borrow;\n      assign difference[k] = trial[31:0] - multiple[k][31:0];\n\"\"\"\nif name=='\"'slices':\n    q=q.replace(\\\"        assign eq[j] = x == y;\\\\n        assign lt[j] = x < y;\\\", \\\"\\\"\\\"        wire [W:0] sub = {1'b0,x} - {1'b0,y};\n        assign eq[j] = x == y;\n        assign lt[j] = sub[W];\n        if (j == 0) begin\n          assign difference[k][0+:G] = sub[G-1:0];\n        end else begin\n          localparam integer K = j*G + W <= 32 ? W : 32-j*G;\n          wire low_borrow;\n          if (j==1) assign low_borrow = lt[0];\n          if (j==2) assign low_borrow = lt[1] || (eq[1] && lt[0]);\n          if (j==3) assign low_borrow = lt[2] || (eq[2] && lt[1]) || ((&eq[2:1]) && lt[0]);\n          assign difference[k][j*G +: K] = x[K-1:0] + ~y[K-1:0] + {{(K-1){1'b0}},\"'!low_borrow};\n        end\"\"\").replace(\"      assign difference[k] = trial[31:0] - multiple[k][31:0];\",\"\")\np.write_text(s[:a]+q+s[b:])\nPY\npython \"$TMPDIR/borrow.py\" borrow\npython \"$TMPDIR/borrow.py\" slices'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
