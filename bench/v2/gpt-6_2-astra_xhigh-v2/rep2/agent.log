{"type":"item.started","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -c 'p=\"$TMPDIR/predict.Zyi3qF\"\ncat > \"$p/addp.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,shutil\nbase=Path(__file__).parent\nv=sys.argv[1];mode=sys.argv[2]\nrtl=base/v;shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\ns=(rtl/'id_stage.sv').read_text()\ndef edit(a,b):\n global s\n assert a in s\n s=s.replace(a,b)\nif mode in ['addi','small','both','sel','guard']:\n edit('assign add_base = ex_a + ex_b;', '''logic a_small, b_small;\n  assign a_small = ex_a[31:11] == {21{ex_a[11]}};\n  assign b_small = ex_b[31:11] == {21{ex_b[11]}};\n  assign add_base = ''' + ('b_small ? ex_a : ex_b;' if mode in ['both','sel'] else 'ex_a;'))\n if mode in ['addi','guard']:\n  c=(rtl/'core.sv').read_text().replace('&& \"'!id_ex_w.ctrl.is_jump && !id_ex_w.ctrl.mem_read;'\"', '&& \"'!id_ex_w.ctrl.is_jump && !id_ex_w.ctrl.mem_read'\"\\\\n                && id_ex_w.ctrl.alu_src && \"'!id_ex_w.ctrl.is_auipc;'\"')\n  (rtl/'core.sv').write_text(c)\n if mode in ['both','small','sel','guard']:\n  check='b_small || a_small' if mode in ['both','sel'] else 'b_small'\n  edit('use_mem || use_add || use_lui', 'use_mem || (use_add && ('+check+')) || use_lui')\nelse:\n # Three-term CSA. Compute high and low halves independently. Predict\n # carry into high adder from carry generated by just L adjacent low bits.\n # Register actual carry xor prediction to trigger the ordinary retry.\n n=int(sys.argv[3]);w=int(sys.argv[4]);z=str(n);h=str(n-1);l=str(n-w)\n edit('  assign add_base = ex_a + ex_b;', f'''\n  logic [31:0] dext, xbit, ybit;\n  logic [{n}:0] low;\n  logic predicted_carry, carry_wrong;\n  assign dext = {{{{19{{disp[12]}}}},disp}};\n  assign xbit = ex_a \"'^ ex_b ''^ dext;\n  assign ybit = ((ex_a & ex_b) | ((ex_a ''^ ex_b) & dext)) << 1;\n  assign low = {{1'\"'b0,xbit[{h}:0]}} + {{1'b0,ybit[{h}:0]}};\n  assign predicted_carry = xbit[{h}:{l}] > ~ybit[{h}:{l}];\n  assign add_base = {{xbit[31:{z}] + ybit[31:{z}] + {{{{(31-{z}){{1'b0}}}},predicted_carry}}, low[{h}:0]}};\n  assign carry_wrong = predicted_carry \"'^ low[{z}];\n'\"''')\n edit('reg_q.page_cross <= low_sum[12] \"'^ page[0];'\"','reg_q.page_cross <= use_add ? carry_wrong : low_sum[12] \"'^ page[0];'\"')\n(rtl/'id_stage.sv').write_text(s)\nPY\nfor m in addi small both; do python3 \\\"\"'$p/addp.py\" \"addp$m\" \"$m\"; done\nfor spec in '\"'12 2' '12 4' '16 3' '12 1'; do set -- \"'$spec; python3 \"$p/addp.py\" \"addc${1}w${2}\" carry \"$1\" \"$2\"; done\ncat > \"$p/results.py\" <<'\"'PY'\nfrom tools.eval.gowin import parse_reports\nfrom pathlib import Path\nimport sys,json\np=Path(__file__).parent\nrows=[]\nfor a in p.glob('*_coremark.json'):\n if not a.stat().st_size:continue\n v=a.name.split('_')[0]\n d=json.load(a.open())\n c=d['bench_stop_cycle']-d['bench_start_cycle']\n f=parse_reports(p/(v+'_p1')).get('fmax_mhz')\n if not c or not f: continue\n rows.append((round(1e7*f/c,2),v,c,f))\nfor r in sorted(rows,reverse=True)[:18]: print(*r)\nPY\nPYTHONPATH=. python3 \\\"\"'$p/results.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
