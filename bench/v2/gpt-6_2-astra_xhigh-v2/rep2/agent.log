dy, 0\n        transfers += 1\n        wait_cycles = 0\n        return iready, 1\n\n    rets, dmem = await _run(dut, program, bus_ready=bus_ready)\n    assert transfers == len(expected_bus) and not any(fetch_stalls.values())\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert all(not r[\"trap\"] and r[\"pc_next\"] == r[\"pc\"] + 4 for r in rets)\n    for idx, lhs, rhs, result in [\n        (3, dividend, 6, -16 & mask),\n        (4, -16 & mask, 6, -4 & mask),\n        (7, dividend, 6, unsigned_quotient),\n        (8, dividend, unsigned_quotient, unsigned_remainder),\n    ]:\n        r = rets[idx]\n        assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"]) == (lhs, rhs, result)\n        assert r[\"rd\"] == ((program[idx] >> 7) & 31)\n        assert r[\"mem_rmask\"] == r[\"mem_wmask\"] == 0\n    # Older MEM and WB drain at issue. Each adjacent divider issues on the\n    # cycle following its predecessor's transfer.\n    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n    assert fetches.count(20) == 8  # REM occupies EX for its eight cycles.\n    # Its result then waits in EX/MEM during the following store's denials.\n    assert rets[4][\"cycle\"] - rets[3][\"cycle\"] == 8 + 3\n    for idx, addr, value in [(5, 0x44, -4 & mask), (9, 0x48, unsigned_remainder)]:\n        assert rets[idx][\"rs2_rdata\"] == dmem[addr] == value\n        assert (rets[idx][\"mem_addr\"], rets[idx][\"mem_wmask\"], rets[idx][\"mem_wdata\"]) == (\n            addr, 15, value\n        )\n\n\n@cocotb.test()\n64:`ifdef RISCV_FORMAL_ALTOPS\n65-  logic [31:0] alt_q;\n66-  always_ff @(posedge clock) begin\n67-    if (div_start) begin\n68-      case (op)\n69-        ALU_DIV:  alt_q <= (a - b) ^ 32'h7f8529ec;\n70-        ALU_DIVU: alt_q <= (a - b) ^ 32'h10e8fd70;\n71-        ALU_REM:  alt_q <= (a - b) ^ 32'h8da68fa5;\n72-        defaul