store_cycles = 0\n341:        nonlocal store_cycles\n347:            store_cycles += 1\n348:            if store_cycles <= 3:\n353:    rets, dmem = await _run(dut, program, bus_ready=bus_ready, unready_instr=store)\n354:    assert store_cycles == 4 and dmem == {0x44: 37}\n370:async def replay_through_eight_denied_loop_iterations(dut):\n393:    rets, _ = await _run(dut, program, max_cycles=650, bus_ready=bus_ready,\n405:async def replay_jalr_held_behind_store(dut):\n448:async def replay_aliased_predecessor(dut):\n485:async def replay_read_write_collision(dut):\n545:    rets, _ = await _run(dut, program, {0x100: patch}, max_cycles=610,\n583:    transfers = 0\n584:    wait_cycles = 0\n588:        nonlocal transfers, wait_cycles\n593:            assert wait_cycles == 0, \"request withdrawn during a data stall\"\n595:        assert (ren, wen, addr, wdata if wen else 0) == expected_bus[transfers]\n596:        if transfers == 0:\n598:        if wait_cycles < 3:\n599:            wait_cycles += 1\n601:        transfers += 1\n602:        wait_cycles = 0\n605:    rets, dmem = await _run(dut, program, bus_ready=bus_ready)\n606:    assert transfers == len(expected_bus) and not any(fetch_stalls.values())\n622:    # cycle following its predecessor's transfer.\n626:        assert rets[idx][\"rs2_rdata\"] == dmem[addr] == value\n732:    rets, dmem = await _run(dut, program)\n735:    assert dmem.get(0) == val\n777:    rets, _ = await _run(dut, program, max_cycles=20)\n","exit_code":0,"status":"completed"}}
