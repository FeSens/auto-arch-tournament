1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b01\n…[9283 of 12355 chars elided by tools/bench/transcript.py; sha256:537a959ce879f9d2]…\nut):\n713:async def fence_i_refetches_modified_successors(dut):\n763:async def divider_dependencies_with_stalls(dut):\n799:            assert wait_cycles == 0, \"request withdrawn during a data stall\"\n831:    assert [rets[i][\"cycle\"] - rets[i - 1][\"cycle\"] for i in range(3, len(rets))] == [\n841:async def independent_divides_and_held_mem_result(dut):\n862:    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 8\n863:    assert rets[4][\"cycle\"] - rets[3][\"cycle\"] == 2\n875:async def branch_taken_skips(dut):\n898:    assert r2[\"cycle\"] == rets[0][\"cycle\"] + 1\n902:async def jal_writes_pc_plus_4(dut):\n918:    assert r3[\"cycle\"] == rj[\"cycle\"] + 1\n922:async def jalr_target(dut):\n936:    assert rets[1][\"cycle\"] == rets[0][\"cycle\"] + 1\n939:    assert r7[\"cycle\"] == rets[1][\"cycle\"] + 1\n943:async def misaligned_targets_fall_through(dut):\n965:async def sw_lw_roundtrip(dut):\n981:async def illegal_traps(dut):\n1004:async def ecall_traps(dut):\n1016:async def ebreak_does_not_trap(dut):\n1025:async def rvfi_order_strictly_monotonic(dut):\n", "exit_code": 0, "status": "completed"}}
