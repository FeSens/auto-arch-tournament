fg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mk\n…[3953 of 7025 chars elided by tools/bench/transcript.py; sha256:dc53e5d48f564b5c]…\ncores/bench-whU0MRk6O/checks/insn_add_ch0/src/rvfi_macros.vh\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/src/rvfi_insn_check.sv\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/src/rvfi_channel.sv\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/src/defines.sv\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/src/insn_add_ch0.sv\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/src/rvfi_testbench.sv\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/logfile.txt\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/config.sby\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/engine_0/logfile.txt\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/model/design_smt2.ys\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/model/design.ys\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/model/design.log\nformal/riscv-formal/cores/bench-whU0MRk6O/checks/insn_add_ch0/model/design_prep.ys\n", "exit_code": 0, "status": "completed"}}
