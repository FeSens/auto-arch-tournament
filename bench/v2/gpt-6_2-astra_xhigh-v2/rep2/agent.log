{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '500,900p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py\"", "aggregated_output": "\n    rets, _ = await _run(dut, program, bus_ready=bus_ready, startup_wait=512,\n                         unready_instr=SW(0, 0, 0x40))\n    pcs = [0] + [4, 8] * 5 + [12]\n    _check_trace(rets, pcs, [program[pc // 4] for pc in pcs])\n    assert fetches[:12] == [4, 8] * 4 + [8, 4, 8, 12]\n\n\n@cocotb.test()\nasync def fence_i_refetches_modified_successors(dut):\n    # Execute the two stores at 28 and 32, then overwrite both with ADDI.\n    # The fetch at 28 sees the old instruction on the patch's acceptance edge.\n    patch = ADDI(3, 3, 1)\n    program = [\n        LW(5, 0, 0x100), ADDI(1, 0, 12), JAL(0, 20),\n        ADDI(1, 0, 44), SW(5, 0, 32), SW(5, 0, 28), 0x0000100F,\n        SW(1, 0, 0x40), SW(1, 0, 0x44), JALR(0, 1, 0), NOP(),\n        ADDI(1, 0, 56), JAL(0, -20), NOP(), EBREAK(),\n    ]\n    writes = []\n    store_wait = 0\n    fetch_wait = 0\n    denied = [0, 0]\n\n    def bus_ready(pc, addr, ren, wen, data):\n        nonlocal store_wait, fetch_wait\n        if ren:\n            assert addr == 0x100\n        if wen:\n            if addr == 28:\n                assert pc == 28\n                if store_wait < 3:\n                    store_wait += 1\n                    return 1, 0\n            writes.append((addr, wen, data))\n        # Probe the old row both during the sweep and after it completes.\n        if pc == 48 and fetch_wait < 520:\n            fetch_wait += 1\n            return 0, 1\n        visit = int(fetch_wait > 0)\n        if pc == 32 and len(writes) >= 4 and denied[visit] < 3:\n            denied[visit] += 1\n            return 0, 1\n        return 1, 1\n\n    rets, _ = await _run(dut, program, {0x100: patch}, max_cycles=610,\n                         bus_ready=bus_ready, startup_wait=512, unified_memory=True,\n                         unready_instr=SW(0, 0, 0x4c))\n    before = [0, 4, 8, 28, 32, 36, 12, 16, 20, 24]\n    after = [28, 32, 36, 44, 48, 28, 32, 36, 56]\n    insns = [program[pc // 4] for pc in before]\n    insns += [patch if pc in (28, 32) else program[pc // 4] for pc in after]\n    _check_trace(rets, before + after, insns)\n \n…[10369 of 13441 chars elided by tools/bench/transcript.py; sha256:9b419cf13c0fe870]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
