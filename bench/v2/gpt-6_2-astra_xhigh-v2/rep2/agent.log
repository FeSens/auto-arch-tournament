{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c 'sby -d \"$TMPDIR/replay-final-prove\" > \"$TMPDIR/replay-final-prove.log\" 2>&1 <<'\"'SBY'\n[options]\nmode prove\ndepth 5\n\n[engines]\nsmtbmc bitwuzla\n\n[script]\nplugin -i slang\nread_slang --single-unit --top replay_proof -DRISCV_FORMAL_ALTOPS core_pkg.sv alu.sv core.sv decoder.sv ex_stage.sv forward_unit.sv hazard_unit.sv id_stage.sv if_stage.sv imm_gen.sv mem_stage.sv reg_file.sv wb_stage.sv replay_proof.sv\nprep -top replay_proof\n\n[files]\ncores/bench/rtl/core_pkg.sv\ncores/bench/rtl/alu.sv\ncores/bench/rtl/core.sv\ncores/bench/rtl/decoder.sv\ncores/bench/rtl/ex_stage.sv\ncores/bench/rtl/forward_unit.sv\ncores/bench/rtl/hazard_unit.sv\ncores/bench/rtl/id_stage.sv\ncores/bench/rtl/if_stage.sv\ncores/bench/rtl/imm_gen.sv\ncores/bench/rtl/mem_stage.sv\ncores/bench/rtl/reg_file.sv\ncores/bench/rtl/wb_stage.sv\n\n[file replay_proof.sv]\nmodule replay_proof (\n  input logic clock, reset, imem_ready, dmem_ready,\n  input logic [31:0] imem_data, dmem_rdata, seed_word,\n  input logic [29:0] seed_watch\n);\n  logic [31:0] addr;\n  core dut (.clock(clock), .reset(reset), .io_imemAddr(addr),\n            .io_imemData(imem_data), .io_imemReady(imem_ready),\n            .io_dmemRData(dmem_rdata), .io_dmemReady(dmem_ready));\n  logic [29:0] watch;\n  logic [31:0] word;\n  wire [31:0] pc = {watch, 2'b0};\n  wire [6:0] slot = pc[8:2] - 7'd1;\n  logic started = 0;\n  always @(posedge clock) begin\n    started <= 1;\n    if (\"'!started) begin watch <= seed_watch; word <= seed_word; end\n  end\n  always_comb begin\n    if (!started) assume(reset);\n    if (imem_ready && addr == pc) assume(imem_data == word);\n  end\n\n  always @(posedge clock) if (started) begin\n    assert(addr[1:0] == 0);\n    assert(dut.id_ex_w.pc[1:0] == 0);\n    if (dut.id_ex_w.valid) begin\n      assert(!(dut.id_ex_w.ctrl.is_branch && dut.id_ex_w.ctrl.is_jalr));\n      if (dut.id_ex_w.pc == pc) assert(dut.