{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/flagtrial/carry.py\" <<'\"'PY'\nimport sys, os, shutil\nfrom pathlib import Path\ndest=Path(os.environ['TMPDIR']) / 'flagtrial' / sys.argv[1]\nwidth=int(sys.argv[2]); overlap=int(sys.argv[3])\nif dest.exists(): raise RuntimeError(f'existing {dest}')\nshutil.copytree('cores/bench/rtl', dest)\ndef change(f, old, new):\n p=dest/f\n s=p.read_text()\n assert old in s, old\n p.write_text(s.replace(old,new))\nchange('alu.sv','module alu (',\\\"module alu #(parameter EX_SPLIT = 1'b0) (\\\")\nfor expr in ['a + b','a - b']:\n change('alu.sv', 'out = '+expr+';', \\\"out = EX_SPLIT ? 32'b0 : (\\\"+expr+');')\nchange('ex_stage.sv','output logic [31:0]        alu_a, alu_b,','output logic [31:0]        add_value, alu_a, alu_b,')\nchange('core.sv','repaired_addr, ex_a, ex_b;', 'repaired_addr, ex_a, ex_b, add_value;')\nchange('core.sv','.ex_a     (ex_a),','.add_value(add_value),\\\\n    .ex_a     (ex_a),')\nchange('core.sv','.alu_a           (ex_a),','.add_value       (add_value),\\\\n    .alu_a           (ex_a),')\nchange('id_stage.sv','mem_result, ex_a, ex_b, lw_word,','mem_result, ex_a, ex_b, lw_word, add_value,')\nchange('id_stage.sv','assign add_base = ex_a + ex_b;', 'assign add_base = add_value;')\nchange('ex_stage.sv','alu u_alu (','alu #(.EX_SPLIT(1)) u_alu (')\nchange('ex_stage.sv','.out (alu_result),','.out (logic_result),')\nchange('core_pkg.sv','logic        forwardable;', 'logic        carry_miss, guessed_carry;\\\\n    logic        forwardable;')\nchange('core.sv','if (annul) begin','if (annul || ex_mem_w.carry_miss) begin')\n# Older grant ok for fetch after a repair. Transfer the corrected result for WB.\nchange('core.sv','&& ex_mem_w.forwardable;', '&& ex_mem_w.forwardable && \"'!ex_mem_w.carry_miss;'\"')\nchange('ex_stage.sv','  logic [31:0] alu_result;', f'''\n  logic [31:0] alu_result, logic_result;\n  localparam integer LOW = {width};\n  localparam integer OVERLAP = {overlap};\n  wire is_sub = in.ctrl.alu_op == ALU_SUB;\n  wire is_add = in.ctrl.alu_op == ALU_ADD;\n  wire [31:0] effective_b = is_sub ? ~alu_b : alu_b;\n  wire [LOW:0] low_result = {{1'b0,alu_a[LOW-1:0]}} + {{1'b0,effective_b[LOW-1:0]}} + is_sub;\n  wire [OVERLAP:0] middle = {{1'b0,alu_a[LOW-1 -: OVERLAP]}} + {{1'b0,effective_b[LOW-1 -: OVERLAP]}} + effective_b[31];\n  wire predicted_carry = middle[OVERLAP];\n  wire [31-LOW:0] high_result = alu_a[31:LOW] + effective_b[31:LOW] + predicted_carry;\n  assign add_value = {{high_result, low_result[LOW-1:0]}};\n  assign alu_result = logic_result | ({{32{{is_add || is_sub}}}} & add_value);\n''')\nchange('ex_stage.sv','      reg_q.pc            <= in.pc;', '''      reg_q.carry_miss <= in.valid && in.ctrl.reg_write && \"'!in.ctrl.is_jump && !in.ctrl.mem_read &&\n                          in.rd != 0 && (is_add || is_sub) && predicted_carry != low_result[LOW];\n      reg_q.guessed_carry <= predicted_carry;\n      reg_q.pc            <= in.pc;'\"''')\nchange('mem_stage.sv','  mem_wb_t reg_q;',f'''  localparam integer LOW = {width};\n  wire [31-LOW:0] correction = in.guessed_carry ? {{(32-LOW){{1'b1}}}} : {{{{(31-LOW){{1'b0}}}},1'b1}};\n  wire [31-LOW:0] exact_high = in.alu_result[31:LOW] + correction;\n  wire [31:0] integer_result = {{in.carry_miss ? exact_high : in.alu_result[31:LOW], in.alu_result[LOW-1:0]}};\n  mem_wb_t reg_q;''')\nchange('mem_stage.sv',': in.alu_result;', ': integer_result;')\nPY\npython \\\"\"'$TMPDIR/flagtrial/carry.py\" carry 16 4\nPYTHONPATH=. python \"$TMPDIR/flagtrial/build.py\" carry 0 1 2 > \"$TMPDIR/flagtrial/carry.time\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
