{"type": "item.completed", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,110p' cores/bench/rtl/forward_unit.sv; sed -n '90,190p' cores/bench/rtl/id_stage.sv; git diff --numstat\"", "aggregated_output": "// rtl/forward_unit.sv\n//\n// ID resolves the source grants at the same edge that advances the\n// consumer and its two possible forwarding producers.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       stall_id,\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_reg_write,\n  input  logic       ex_forwardable,\n  input  logic       id_auipc, id_alu_imm,\n  output logic       younger_rs1_match,\n  output logic       older_rs1_match,\n  output operand_grants_t rs1_grants, rs2_grants\n);\n\n  logic younger_rs2_match, older_rs2_match;\n  logic older_writer;\n  assign younger_rs1_match = id_ex_rd != 0 && id_ex_rd == id_rs1;\n  assign older_writer = ex_mem_reg_write && ex_mem_rd != 0;\n  assign older_rs1_match = older_writer && ex_mem_rd == id_rs1;\n  assign younger_rs2_match = id_ex_rd != 0 && id_ex_rd == id_rs2;\n  assign older_rs2_match = older_writer && ex_mem_rd == id_rs2;\n\n  function automatic operand_grants_t resolve_grants(\n      input logic young, older_match, other);\n    operand_grants_t g;\n    g.young = young;\n    g.older = older_match && !young;\n    g.local_reg = !young && !older_match;\n    g.alu_forward = !other && !g.local_reg;\n    g.alu_reg = !other && g.local_reg;\n    g.alu_other = other;\n    resolve_grants = g;\n  endfunction\n\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      rs1_grants <= resolve_grants(younger_rs1_match && ex_forwardable, older_rs1_match, id_auipc);\n      rs2_grants <= resolve_grants(younger_rs2_match && ex_forwardable, older_rs2_match, id_alu_imm);\n    end\n  end\n\nendmodule\n    ctrl_decoded.mem_width  = dec_mem_width;\n    ctrl_dec