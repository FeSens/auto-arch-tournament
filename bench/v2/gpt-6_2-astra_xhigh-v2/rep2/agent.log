{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c 'cat formal/checks_si.cfg && cat fpga/core_bench_si.sv && cat tools/eval/_slots.py'", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0]\n…[4383 of 7455 chars elided by tools/bench/transcript.py; sha256:eed73bbe3535503d]…\n   d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c 'cat tools/eval/cosim.py && cat test/cosim/build.sh && cat bench/programs/Makefile'", "aggregated_output": "\"\"\"Runs Verilator cosim for all bench ELFs. Returns structured pass/fail.\n\nCorrectness is gated in two stages:\n  1. Full RVFI trace cosim for selftest and any other small ELF — every\n     retirement is diffed against the Python reference ISS.\n  2. CoreMark CRC validation via the sim's UART capture — full-trace cosim\n     of coremark.elf is skipped because the Python reference is ~10⁴× slower\n     than Verilator (would take 30+ minutes per candidate). Instead we run\n     the sim in --bench mode and verify its UART matches the canonical CRCs\n     with `validate_coremark_uart` (the same check run_fpga_eval uses). This\n     catches any CPU bug that affects CoreMark output without the full trace\n     overhead.\n\"\"\"\nimport os, subprocess, json, sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\nBENCH_DIR = Path(\"bench/programs\")\n\n\ndef _build_cosim_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `bash test/cosim/build.sh`.\n\n    Reads cores/<target>/core.yaml's `nret` (defaults to 2) and injects\n    NRET=<n> so build.sh can pass `-DNRET=<n>` to verilator. main.cpp's\n    channel-1 drain is compiled out under `#if NRET < 2`, so a single-\n    issue core (no `_1` ports) builds cleanly.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[9794 of 12866 chars elided by tools/bench/transcript.py; sha256:82af5fbe001a325a]…\n       bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"sed -n '465,660p' cores/bench/test/test_pipeline.py && cat cores/bench/test/_helpers.py\"", "aggregated_output": "    fetches = []\n    denials = {4: 3, 12: 2, 20: 1}\n\n    def bus_ready(pc, addr, ren, wen, data):\n        assert not (ren or wen), f\"discarded store issued a bus request at {addr:#x}\"\n        fetches.append(pc)\n        # Supply a store on denied sequential, branch-target and JAL-target reads.\n        return fetches.count(pc) > denials.get(pc, 0), 1\n\n    rets, _ = await _run(dut, program, bus_ready=bus_ready, unready_instr=store)\n    assert 8 not in fetches and 16 not in fetches\n    assert fetches[:10] == [4] * 4 + [12] * 3 + [20] * 2 + [24]\n    pcs = [0, 4, 12, 20, 24]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(not (r[\"trap\"] or r[\"mem_wmask\"] or r[\"mem_rmask\"]) for r in rets)\n    assert rets[2][\"rd_wdata\"] == rets[3][\"rs1_rdata\"] == 16\n    assert rets[3][\"rd_wdata\"] == 21\n\n\n@cocotb.test()\nasync def branch_held_behind_store(dut):\n    store = SW(1, 0, 0x44)\n    program = [\n        ADDI(1, 0, 37), ADDI(2, 0, 37), store,\n        BEQ(1, 2, 8), store, JAL(3, 8), store, ADDI(4, 3, 7), EBREAK(),\n    ]\n    fetches = []\n    store_cycles = 0\n\n    def bus_ready(pc, addr, ren, wen, data):\n        nonlocal store_cycles\n        fetches.append(pc)\n        assert not ren\n        if wen:\n            assert (pc, addr, wen, data) == (12, 0x44, 15, 37)\n            store_cycles += 1\n            if store_cycles <= 3:\n                return 1, 0\n        if pc == 20 and fetches.count(20) == 1:\n            return 0, 1  # Deny the target as the branch executes.\n        return 1, 1\n\n    rets, dmem = await _run(dut, program, bus_ready=bus_ready, unready_instr=store