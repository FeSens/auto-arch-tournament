ic -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n100:    top->io_imemReady = 1;\n101:    top->io_dmemReady = 1;\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n149:        if(top->io_dmemWEn && top->io_dmemReady) {\n185:                        uint32_t pc_rdata, uint32_t pc_wdata,\n187:                        uint8_t  rs1_addr, uint32_t rs1_rdata,\n188:                        uint8_t  rs2_addr, uint32_t rs2_rdata,\n190:                        uint8_t  mem_rmask, uint32_t mem_rdata,\n197:                \"{\\\"order\\\":%llu,\\\"cycle\\\":%llu,\\\"insn\\\":%u,\\\"pc_rdata\\\":%u,\\\"pc_wdata\\\":%u,\"\n199:                \"\\\"rs1_addr\\\":%u,\\\"rs1_rdata\\\":%u,\"\n200:                \"\\\"rs2_addr\\\":%u,\\\"rs2_rdata\\\":%u,\"\n201:                \"\\\"mem_addr\\\":%u,\\\"mem_rmask\\\":%u,\\\"mem_rdata\\\":%u,\"\n206:                insn, pc_rdata, pc_wdata,\n208:                rs1_addr, rs1_rdata,\n209:                rs2_addr, rs2_rdata,\n210:                mem_addr, mem_rmask, mem_rdata,\n226:                 top->io_rvfi_pc_rdata_0, top->io_rvfi_pc_wdata_0,\n228:                 top->io_rvfi_rs1_addr_0, top->io_rvfi_rs1_rdata_0,\n229:                 top->io_rvfi_rs2_addr_0, top->io_rvfi_rs2_rdata_0,\n231:                 top->io_rvfi_mem_rmask_0, top->io_rvfi_mem_rdata_0,\n241:                 top->io_rvfi_pc_rdata_