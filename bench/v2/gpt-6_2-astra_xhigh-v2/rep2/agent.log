ready one at PC 16.\n        return (pc != 16 and (pc != 4 or fetches.count(4) > 3)), 1\n\n    rets, _ = await _run(dut, program, bus_ready=bus_ready, unready_instr=store)\n    assert fetches.count(4) == 4 and fetches.count(8) == fetches.count(16) == 1\n    pcs = [0, 4, 12, 20, 24]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"insn\"] for r in rets] == [progr\n…[4380 of 7452 chars elided by tools/bench/transcript.py; sha256:84b1f08ed09f74f3]…\nbit zero cleared for JALR. For aligned instruction PCs, imm[1]\n      detects direct-target misalignment and the JALR sum's bit 1 detects\n      indirect-target misalignment. Keep branch comparison, trap, link\n      and RVFI next-PC semantics in EX.\n  - file: rtl/hazard_unit.sv\n    description: |\n      Remove redirect from the ID/EX bubble condition. Preserve the\n      late-result interlock, unready-fetch bubble, divider hold and\n      data-bus hold. A ready target issues only when ID can accept it.\n  - file: rtl/core.sv\n    description: Remove the redirect input to the hazard unit and keep EX driving IF.\n  - file: test/test_pipeline.py\n    description: |\n      Update the redirect test to require immediate target addresses and\n      consecutive retirements on ready hits. Retain all wrong-path store\n      and retirement checks. Stall a target fetch and an older data\n      request independently, verify retry and single delivery, and cover\n      back-to-back transfers, JALR link forwarding and misaligned targets.\n", "exit_code": 0, "status": "completed"}}
