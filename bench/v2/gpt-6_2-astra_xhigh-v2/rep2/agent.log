{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/split_replay_test.py\" <<'\"'PY'\n@cocotb.test()\nasync def replay_loads_with_alternating_base_registers(dut):\n    loop_count = 8\n    header = 12\n    tail = 28\n    program = [\n        ADDI(1, 0, 0x80), ADDI(30, 0, 0xc0), ADDI(6, 0, loop_count),\n        LW(3, 1, 0), LW(3, 30, 0), ADDI(6, 6, -1), BNE(6, 0, -12),\n        EBREAK(),\n    ]\n    memory = {0x80: 0x11223344, 0xc0: 0x55667788}\n    accepted = []\n    denials = [0, 0]\n    fetches = []\n    replay = False\n\n    def ready(pc, addr, ren, wen, data):\n        nonlocal replay\n        assert not wen\n        if pc == header and len(accepted) == 8:\n            replay = True\n        dready = 1\n        if ren:\n            assert addr in memory\n            i = int(addr == 0xc0)\n            if replay and denials[i] < 3:\n                denials[i] += 1\n                dready = 0\n            else:\n                accepted.append(addr)\n        if replay and pc \"'!= tail:\n            fetches.append(pc)\n            return 0, dready\n        return 1, dready\n\n    rets, _ = await _run(dut, program, memory, bus_ready=ready,\n                         startup_wait=512, unready_instr=SW(0, 0, 0x44))\n    assert denials == [3, 3]\n    assert set(fetches) == {12, 16, 20, 24}\n    assert accepted == [0x80, 0xc0] * loop_count\n    pcs = [0, 4, 8] + [12, 16, 20, 24] * loop_count + [28]\n    _check_trace(rets, pcs, [program[pc // 4] for pc in pcs])\n    assert [(r['\"'rs1_rdata'], r['rd_wdata']) for r in rets if r['mem_rmask']] == [\n        (0x80, memory[0x80]), (0xc0, memory[0xc0])] * loop_count\nPY\ncat \\\"\"'$TMPDIR/split_replay_test.py\" >> \"$TMPDIR/split_admit/test/test_pipeline.py\"\ncd \"$TMPDIR/split_admit\" && python -m pytest --rootdir=. --confcutdir=. -q test/test_pipeline.py > split_test.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
