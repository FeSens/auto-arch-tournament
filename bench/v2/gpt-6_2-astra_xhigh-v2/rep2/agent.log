gn id_tag[1] = id_insn[24:20];\n  wire [31:0] id_local [0:1];\n  assign id_local[0] = id_r1;\n  assign id_local[1] = id_r2;\n  wire [31:0] value [0:1];\n  for (genvar i=0; i<2; i++) begin: g_source\n    wire hit_y = y_writer && in.rd == id_tag[i];\n    wire hit_m = m_writer && reg_q.rd == id_tag[i];\n    logic [31:0] local_q, younger_q, older_q;\n    always_ff @(posedge clock) begin\n      if (!id_hold) begin\n        if (hit_y || hit_m) local_q <= 32'\"'b0;\n        else local_q <= id_local[i];\n        if (\"'!hit_y) younger_q <= 32'\"'b0;\n        else younger_q <= result_d;\n        if (hit_y || \"'!hit_m) older_q <= 32'\"'b0;\n        else older_q <= mem_d;\n      end\n    end\n    assign value[i] = local_q | younger_q | older_q;\n  end\n  assign rs1 = value[0];\n  assign rs2 = value[1];\n'''\nif mode=='lanes_extra':\n # Use separate local ALU operand lane, with forwarding qualified only for actual R source.\n # Keep raw rs values for branch and RAM. PC and immediate each available in ID.\n extra=extra.replace('  assign rs1', '''  assign rs1''')\ns=s.replace('  ex_mem_t reg_q;', '  ex_mem_t reg_q;\\\\n'+extra)\ns=s.replace('reg_q.alu_result    <= '+r+';', 'reg_q.alu_result    <= result_d;')\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/flagtrial/lanes.py\" lanes\nPYTHONPATH=. python \"$TMPDIR/flagtrial/build.py\" lanes 0 1 2 > \"$TMPDIR/flagtrial/lanes.time\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
