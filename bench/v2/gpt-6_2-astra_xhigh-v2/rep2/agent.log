{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/alu.sv | head -74'","aggregated_output":"// rtl/alu.sv\n//\n// EX computes integer results. After six wait clocks, div_valid lets EX\n// transfer the divide instruction. That edge finishes the last digit,\n// and div_result supplies the resident MEM slot until the next issue.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        carry_retry,\n  input  logic        saved_carry,\n  output logic        predicted_carry, exact_carry,\n  output logic [31:12] sum_page,\n  input  logic        div_request,\n  output logic        div_ready,\n  output logic        div_valid,\n  output logic [31:0] div_result,\n  input  logic        div_consume\n);\n\n  logic        [4:0]  shamt;\n  logic        subtract, guess_at_12;\n  logic [31:0] effective_b, sum;\n  logic [3:0]  unused_upper_low;\n\n  assign subtract = op == ALU_SUB;\n  assign effective_b = b ^ {32{subtract}};\n  assign {exact_carry, sum[15:0]} = {1'b0, a[15:0]} + {1'b0, effective_b[15:0]}\n                                  + {16'b0, subtract};\n  // A greater nibble generates a carry, a smaller one kills it. When\n  // a[15:12] == ~effective_b[15:12], propagate the guess at bit 12.\n  assign predicted_carry = {a[15:12], effective_b[31]} > {~effective_b[15:12], 1'b0};\n  // Put the four prediction bits on the upper adder's native carry chain.\n  // Only a propagating nibble can miss, so on retry a carry inserted at\n  // bit 12 reaches bit 16 unchanged.\n  assign guess_at_12 = carry_retry ? saved_carry : effective_b[31];\n  assign {sum[31:16], unused_upper_low} = a[31:12] + effective_b[31:12]\n                                        + {19'b0, guess_at_12};\n  assign sum_page = sum[31:12];\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD, ALU_SUB: out = sum;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:  out = 32'b0;\n    endcase\n  end\n\n  logic [2:0] groups_left;\n  logic       div_start;\n  assign div_ready = (groups_left == 0) && !div_valid;\n  assign div_start = div_request && div_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      groups_left <= 3'd0;\n      div_valid   <= 1'b0;\n","exit_code":0,"status":"completed"}}
