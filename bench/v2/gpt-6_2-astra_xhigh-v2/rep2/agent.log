{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c 'ls \"$TMPDIR/r10/capture/p1/impl/pnr\" && tail -1 \"$TMPDIR/r10/caplate/p1/gw.log\"; cat cores/bench/test/test_pipeline.py | sed -n '\"'264,386p'\"", "aggregated_output": "cmd.do\ncore_bench.bin\ncore_bench.binx\ncore_bench.db\ncore_bench.fs\ncore_bench.log\ncore_bench.pin.html\ncore_bench.power.html\ncore_bench.rpt.html\ncore_bench.rpt.txt\ncore_bench.timing_paths\ncore_bench.tr\ncore_bench.tr.html\ncore_bench_tr_cata.html\ncore_bench_tr_content.html\ndevice.cfg\n[80%] Routing Phase 2 completed\n\n\n@cocotb.test()\nasync def page_repairs_and_load_to_branch(dut):\n    program = [\n        0x000010B7, ADDI(7, 0, 0x55), ADDI(2, 1, -4),  # x1=0x1000, x2=0xffc\n        SW(7, 2, 4), LW(3, 1, -4), BNE(3, 0, 8), SW(0, 0, 0),\n        LW(4, 1, 4), BEQ(4, 7, 8), SW(0, 0, 0),\n        _i(0x100, 0, 4, 2, 0x13),   # XORI x2,x0,0x100 (unsupported in ID)\n        _i(2, 2, 1, 6, 0x03),       # LH x6,2(x2)\n        _i(1, 2, 4, 3, 0x13),       # XORI x3,x2,1\n        LW(6, 3, 0), SW(6, 3, 0),   # Trap on the corrected odd address\n        ADDI(5, 6, 1), EBREAK(),\n    ]\n    transfers = []\n    requests = {}\n    denials = 0\n\n    def bus_ready(pc, addr, ren, wen, data):\n        nonlocal denials\n        req = (ren, wen, addr, data if wen else 0) if ren or wen else None\n        requests.setdefault(pc, []).append(req)\n        if pc in (56, 60):\n            assert req is None\n            return 1, 0  # Traps can advance even if the memory stays unready.\n        if wen and denials < 3:\n            denials += 1\n            return 1, 0\n        if req:\n            transfers.append(req)\n        return 1, 1\n\n    init = {0xffc: 42, 0x1004: 0x55, 0x100: 0x81234567}\n    rets, dmem = await _run(dut, program, init, bus_ready=bus_ready)\n    store = (0, 15, 0x1000, 0x55)\n    borrow = (1, 0, 0xffc, 0)\n    hit = (1, 0, 0x1004, 0)\n    half = (1, 0, 0x102, 0)\n    assert transfers == [store, borrow, hit, half]\n    assert requests[16] == [None] + [store] * 4\n    assert requests[20] == [None, borrow]\n    assert requests[32] == [hit]\n    assert requests[48] == [None, half]\n    assert requests[56] == [None, None]\n    assert dmem == {**init, 0x1000: 0x55}\n\n    pcs = [0, 4, 8, 12, 16, 20, 28, 32, 40, 44, 48, 52, 56, 60, 64]\n    assert [r[\"pc\"] for r in rets]\n…[2552 of 5624 chars elided by tools/bench/transcript.py; sha256:b942ec7364d746dd]…\n\"rs1_rdata\"] == rets[1][\"rd_wdata\"] == 0x1004\n    assert rets[6][\"mem_rmask\"] == 12 and rets[6][\"rd_wdata\"] == 0xffffffed\n    assert rets[8][\"rs1_rdata\"] == rets[11][\"rs1_rdata\"] == 0\n\n\n@cocotb.test()\nasync def trapped_base_writer(dut):\n    # The younger LW to x1 traps. The next LW must repair using the older\n    # x1 still on the WB bypass, even when dmem returns a plausible raw word.\n    program = [ADDI(1, 0, 0x100), LW(1, 0, 2), LW(3, 1, 4), EBREAK()]\n    reads = []\n\n    def bus_ready(pc, addr, ren, wen, data):\n        assert not wen\n        if ren:\n            reads.append((pc, addr))\n        return 1, 1\n\n    rets, _ = await _run(dut, program, {0: 0x80, 0x104: 37}, bus_ready=bus_ready)\n    assert reads == [(12, 0x104)]\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12]\n    assert [r[\"order\"] for r in rets] == [0, 1, 2, 3]\n    assert [r[\"trap\"] for r in rets] == [0, 1, 0, 0]\n    assert (rets[1][\"rd\"], rets[1][\"mem_rmask\"], rets[1][\"mem_wmask\"]) == (0, 0, 0)\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r10/capture.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nt=Path(os.environ['TMPDIR'])/'r10'\nname=sys.argv[1]\nrtl=t/name/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\ndef rep(f,x,y):\n p=rtl/(f+'.sv');s=p.read_text();assert x in s,x;p.write_text(s.replace(x,y))\ndef before(f,x,y):rep(f,x,y+x)\n# Capture older source at ID/EX and bypass only the youngest EX/MEM producer.\nbefore('mem_stage','  output mem_wb_t out','  output logic [31:0] mem_value,\\\\n')\nrep('mem_stage','  mem_wb_t reg_q;','  assign mem_value = in.ctrl.late_result ? (in.instr[14] ? div_result : product) : in.alu_result;\\\\n  mem_wb_t reg_q;')\nrep('mem_stage','in.ctrl.late_result ? (in.instr[14] ? div_result : product)\\\\n                                              : in.alu_result;', 'mem_value;')\nbefore('core','  logic [31:0] repaired_addr','  logic [31:0] mem_value;\\\\n  logic older_rs2;\\\\n')\nbefore('core','    .out        (mem_wb_w)','    .mem_value  (mem_value),\\\\n')\nbefore('core','    .rs1_data (rs1_data_w),\\\\n    .rs2_data (rs2_data_w),\\\\n    .use_rf', '    .older1   (mem_writes_base),\\\\n    .older2   (older_rs2),\\\\n    .mem_value(mem_value),\\\\n')\nbefore('id_stage','  input  logic              use_rf','  input logic               older1, older2,\\\\n  input logic [31:0]        mem_value,\\\\n')\nrep('id_stage','reg_q.rs1_val  <= rs1_data;','reg_q.rs1_val  <= older1 ? mem_value : rs1_data;')\nrep('id_stage','reg_q.rs2_val  <= rs2_data;','reg_q.rs2_val  <= older2 ? mem_value : rs2_data;')\nbefore('core','    .older_rs1_match    (mem_writes_base),','    .older_rs2_match    (older_rs2),\\\\n')\nbefore('forward_unit','  output logic       older_rs1_match,','  output logic       older_rs2_match,\\\\n')\nbefore('forward_unit','  always_ff','  assign older_rs2_match = older_writer && ex_mem_rd == id_rs2;\\\\n')\nrep('forward_unit','logic younger_rs1_q, younger_rs2_q, older_rs1_q, older_rs2_q;', 'logic younger_rs1_q, younger_rs2_q;')\nrep('forward_unit','      older_rs1_q   <= older_rs1_match;\\\\n      older_rs2_q   <= older_writer && ex_mem_rd == id_rs2;\\\\n','')\nfor i in [1,2]:\n prefix=f'  assign rs{i} = '\n p=rtl/'ex_stage.sv';s=p.read_text();start=s.index(prefix);end=s.index(';',start)\n p.write_text(s[:start]+f'  assign rs{i} = fwd_rs{i}_sel ? fwd_ex_mem : in.rs{i}_val'+s[end:])\n rep('forward_unit',f'  assign fwd_rs{i}[1] = older_rs{i}_q && \"'!fwd_rs{i}[0];'\"\\\\n','')\n rep('forward_unit',f'fwd_rs{i}[0] =',f'fwd_rs{i} =')\nfor f in ['core','forward_unit','ex_stage']:\n rep(f,'[1:0] '+('        ' if f=='ex_stage' else '')+'fwd_rs1',('        ' if f=='ex_stage' else '')+'fwd_rs1')\n if f\"'!='\"'core': rep(f,'[1:0] '+('        ' if f=='ex_stage' else '')+'fwd_rs2',('        ' if f=='ex_stage' else '')+'fwd_rs2')\nrep('ex_stage','  input  logic [31:0]        fwd_mem_wb,\\\\n','')\nrep('core','    .fwd_mem_wb      (wb_w_data),\\\\n','')\nif name=='caplate':\n # Select the base earlier if the older writer is an ordinary op.\n # Use a separate WB source for older M producers.\n for i in (1,2):\n  rep('id_stage',f'older{i} ? mem_value',f'older{i} ? mem_result')\n  rep('ex_stage',f'fwd_rs{i}_sel ? fwd_ex_mem : in.rs{i}_val',f'(fwd_rs{i}_sel ? fwd_ex_mem : (late_rs{i} ? wb_value : in.rs{i}_val))')\n before('forward_unit','  input  logic       ex_mem_forwardable,','  input  logic       ex_mem_late,\\\\n  output logic       late_rs1, late_rs2,\\\\n')\n before('forward_unit','      younger_rs1_q <=','      late_rs1 <= ex_mem_late && older_rs1_match;\\\\n      late_rs2 <= ex_mem_late && older_rs2_match;\\\\n')\n before('core','  logic older_rs2;','  logic late_rs1, late_rs2;\\\\n')\n before('core','    .ex_mem_forwardable (ex_mem_w.forwardable),','    .ex_mem_late        (ex_mem_w.ctrl.late_result),\\\\n    .late_rs1           (late_rs1),\\\\n    .late_rs2           (late_rs2),\\\\n')\n before('core','    .fwd_ex_mem      (ex_mem_w.alu_result),','    .wb_value        (wb_w_data),\\\\n    .late_rs1        (late_rs1),\\\\n    .late_rs2        (late_rs2),\\\\n')\n before('ex_stage','  input  logic [31:0]        fwd_ex_mem,','  input logic [31:0]         wb_value,\\\\n  input logic                late_rs1, late_rs2,\\\\n')\nPY\npython \\\"\"'$TMPDIR/r10/capture.py\" capture && python \"$TMPDIR/r10/capture.py\" caplate && PYTHONPATH=. python \"$TMPDIR/r10/timeit.py\" capture:1 caplate:1'", "aggregated_output": "capture 1 {'fmax_mhz': 76.454, 'logic': 5000, 'regs': 942, 'reason': None} [{'from': 'cpu/u_ex/reg_q.alu_result_5_s0', 'to': 'cpu/u_ex/reg_q.alu_result_23_s0', 'slack_ns': -8.08, 'arrival_ns': 18.374, 'logic_cells': 29, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_id', 'cpu/u_ex']}]\ncaplate 1 {'fmax_mhz': 77.334, 'logic': 5049, 'regs': 944, 'reason': None} [{'from': 'stall_gen/imem_ready_s0', 'to': 'dmem_2_dmem_2_0_0_s', 'slack_ns': -7.931, 'arrival_ns': 18.226, 'logic_cells': 14, 'modules': ['clock_ibuf', 'cpu/u_if', 'cpu/u_hazard', 'cpu/u_fwd', 'cpu/u_id']}]\n", "exit_code": 0, "status": "completed"}}
