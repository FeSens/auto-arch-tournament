d_redirects_fall_through(dut):\n    words = [ADDI(1, 0, 35), BEQ(1, 1, 2), BEQ(0, 1, 2),\n             JAL(2, 2), JALR(3, 1, 0), ADDI(4, 0, 78), EBREAK()]\n    rets,_ = await _run(dut, words)\n    assert [r['pc'] for r in rets] == list(range(0, 28, 4))\n    assert [r['insn'] for r in rets] == words\n    assert [r['trap'] for r in rets] == [0, 1, 0, 1, 1, 0, 0]\n    assert all(r['rd'] == 0 and r['pc_next'] == r['pc'] + 4 for r in rets if r['trap'])\n    assert rets[-2]['rd_wdata'] == 78\n\n\n'''+s[i:]\nf.write_text(s)\nPY\npython \\\"\"'$TMPDIR/microprobe/probetests.py\" returnpcclean\nprj=\"$TMPDIR/microprobe/returnpcclean\"\nPYTHONDONTWRITEBYTECODE=1 pytest -q \"$prj/test/test_pipeline.py\" > \"$prj/pipeline-tests.log\" 2>&1 && tail -4 \"$prj/pipeline-tests.log\"'","aggregated_output":"","exit_code":4,"status":"failed"}}
