{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/clean/extra_cases.py\" <<'\"'PY'\n@cocotb.test()\nasync def youngest_base_and_address_interlocks(dut):\n    program = [ADDI(2, 0, 0x80), ADDI(2, 2, 4), LW(8, 2, -4),\n               ADDI(3, 0, 4), MUL(3, 3, 8), LW(9, 3, 4), EBREAK()]\n    seen = []\n    def ready(pc, addr, ren, wen, data):\n        assert not wen\n        if ren:\n            seen.append(addr)\n        return 1, 1\n    rets, _ = await _run(dut, program, {0x80: 0x40, 0x104: 0xbeef}, bus_ready=ready)\n    _check_trace(rets, list(range(0, len(program)*4,4)), program)\n    assert seen == [0x80, 0x104]\n    assert (rets[2][\\\"rs1_rdata\\\"], rets[5][\\\"rs1_rdata\\\"], rets[5][\\\"rd_wdata\\\"]) == (0x84, 0x100, 0xbeef)\n    assert rets[2][\\\"cycle\\\"] - rets[1][\\\"cycle\\\"] == 2\n    assert rets[5][\\\"cycle\\\"] - rets[4][\\\"cycle\\\"] == 3\n\n\n@cocotb.test()\nasync def early_subwords_and_misaligned_base(dut):\n    # Establish x2, try a misaligned replacement, then use x2 in the very next load.\n    lb = _i(0, 2, 0, 5, 3)\n    lhu = _i(2, 2, 5, 6, 3)\n    lh = _i(2, 2, 1, 7, 3)\n    program = [ADDI(2, 0, 0x100), LW(2, 0, 2), lb, lhu, lh, SW(7, 2, 4), EBREAK()]\n    requests = []\n    def ready(pc, addr, ren, wen, data):\n        if ren or wen:\n            requests.append((addr,ren,wen))\n        return 1,1\n    rets, dmem = await _run(dut,program,{0x100: 0xfedc0080},bus_ready=ready)\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert [r[\\\"trap\\\"] for r in rets] == [0, 1, 0, 0, 0, 0, 0]\n    assert rets[1][\\\"rd\\\"] == rets[1][\\\"mem_rmask\\\"] == 0\n    assert [r[\\\"mem_rmask\\\"] for r in rets[2:5]] == [1,12,12]\n    assert [r[\\\"rd_wdata\\\"] for r in rets[2:5]] == [0xffffff80,0xfedc,0xfffffedc]\n    assert requests == [(0x100,1,0),(0x102,1,0),(0x102,1,0),(0x104,0,15)]\n    assert dmem[0x104] == 0xfffffedc\n\n\n@cocotb.test()\nasync def accepted_word_feeds_stalled_store(dut):\n    program = [ADDI(2, 0, 0x40), LW(2, 0, 0), SW(2, 2, -8), EBREAK()]\n    waits = 0\n    transfers = []\n    def ready(pc, addr, ren, wen, data):\n        nonlocal waits\n        if ren:\n            assert (pc,addr,wen) == (8,0,0)\n            transfers.append(('read',addr))\n        if wen:\n            assert (pc,addr,wen,data) == (12,0x100,15,0x108)\n            if waits < 3:\n                waits += 1\n                return waits % 2, 0\n            transfers.append(('write',addr))\n        return 1,1\n    rets,dmem = await _run(dut,program,{0:0x108},bus_ready=ready)\n    _check_trace(rets,[0,4,8,12],program)\n    assert waits == 3 and transfers == [('read',0),('write',0x100)]\n    assert rets[2][\\\"rs1_rdata\\\"] == rets[2][\\\"rs2_rdata\\\"] == dmem[0x100] == 0x108\nPY\ncat \\\"\"'$TMPDIR/clean/extra_cases.py\" >> \"$TMPDIR/clean/test/test_pipeline.py\"\ncd \"$TMPDIR/clean\" && pytest --rootdir=. -q -s test > all-tests.out 2>&1 && rg '\"'TESTS=|[0-9]+ passed' all-tests.out | tail -9\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
