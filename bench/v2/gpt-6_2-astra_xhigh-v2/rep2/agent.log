{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c \"head -60 cores/bench/rtl/alu.sv; sed -n '83,113p;164,183p' cores/bench/rtl/ex_stage.sv\"","aggregated_output":"// rtl/alu.sv\n//\n// EX computes integer results. After six wait clocks, div_valid lets EX\n// transfer the divide instruction. That edge finishes the last digit,\n// and div_result supplies the resident MEM slot until the next issue.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  output logic [31:12] add_page,\n  input  logic        div_request,\n  output logic        div_ready,\n  output logic        div_valid,\n  output logic [31:0] div_result,\n  input  logic        div_consume\n);\n\n  logic        [4:0]  shamt;\n  logic [31:0] sum;\n  logic        subtract, less_than;\n  assign subtract = op == ALU_SUB;\n  assign sum = byte_add(a, b ^ {32{subtract}}, subtract);\n  assign add_page = sum[31:12];\n  assign less_than = byte_compare(a, b, 1'b0, op == ALU_SLT);\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD, ALU_SUB: out = sum;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT, ALU_SLTU: out = {31'b0, less_than};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:  out = 32'b0;\n    endcase\n  end\n\n  logic [2:0] groups_left;\n  logic       div_start;\n  assign div_ready = (groups_left == 0) && !div_valid;\n  assign div_start = div_request && div_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      groups_left <= 3'd0;\n      div_valid   <= 1'b0;\n    end else if (div_start) begin\n      groups_left <= 3'd6;\n      default: load_data = dmem_rdata;\n    endcase\n  end\n\n  logic [31:0] alu_result;\n  logic        is_div, div_ready, div_valid, div_issue, div_consume;\n  assign is_div = in.valid && in.ctrl.late_result && in.instr[14];\n  assign div_wait    = is_div && !div_valid;\n  assign div_issue   = is_div && div_ready && !stall;\n  assign div_consume = is_div && div_valid && !stall;\n\n  alu u_alu (\n    .clock       (clock),\n    .reset       (reset),\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result),\n    .add_page (add_page),\n    .div_request (div_issue),\n    .div_ready   (div_ready),\n    .div_valid   (div_valid),\n    .div_result  (div_result),\n    .div_consume (div_consume)\n  );\n\n  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] jump_target;\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (stall) begin\n      // Keep the forwarding sources for both the repair and any denied request.\n      reg_q <= reg_q;\n    end else begin\n      reg_q.pc            <= in.pc;\n      reg_q.alu_result    <= in.ctrl.mem_read ? load_data :\n                             in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      reg_q.forwardable   <= forwardable;\n      reg_q.mem_addr      <= dmem_addr;\n      reg_q.mem_rdata     <= dmem_rdata;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n","exit_code":0,"status":"completed"}}
