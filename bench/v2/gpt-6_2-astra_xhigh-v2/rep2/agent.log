21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[2627 of 5699 chars elided by tools/bench/transcript.py; sha256:05b721f2bf36f565]…\n       \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n71:[95%] Generate netlist file \"/srv/hwebench/tmp/3c491641/8e72d025/predictor.7050zk/timing/gowin_p1/impl/gwsynthesis/core_bench.vg\" completed\n72:[100%] Generate report file \"/srv/hwebench/tmp/3c491641/8e72d025/predictor.7050zk/timing/gowin_p1/impl/gwsynthesis/core_bench_syn.rpt.html\" completed\n80:[10%] Placement Phase 0 completed\n81:[20%] Placement Phase 1 completed\n82:[30%] Placement Phase 2 completed\n83:[50%] Placement Phase 3 completed\n85:[60%] Routing Phase 0 completed\n86:[70%] Routing Phase 1 completed\n87:[80%] Routing Phase 2 completed\n89:[90%] Routing Phase 3 completed\n91:[95%] Timing analysis completed\n96:[100%] Power analysis completed\n", "exit_code": 0, "status": "completed"}}
