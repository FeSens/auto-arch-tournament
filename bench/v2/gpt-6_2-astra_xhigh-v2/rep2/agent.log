1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[11410 of 14482 chars elided by tools/bench/transcript.py; sha256:b1024989e5a4adf8]…\ncycle.\n            assert (pc, addr, wen, data) == (20, 0x44, 15, 37)\n            store_cycles += 1\n            if store_cycles <= 3:\n                return 1, 0\n            return 0, 1  # Accept the store and deny its younger branch's target.\n        return 1, 1\n\n    rets, dmem = await _run(dut, program, bus_ready=bus_ready, unready_instr=store)\n    assert store_cycles == 4 and dmem == {0x44: 37}\n    assert fetches[:9] == [4, 8, 12] + [20] * 5 + [28]\n    pcs = [0, 4, 8, 12, 20, 28, 32]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(not r[\"trap\"] for r in rets)\n    assert rets[3][\"rs1_rdata\"] == rets[3][\"rs2_rdata\"] == 37\n    assert rets[4][\"cycle\"] == rets[3][\"cycle\"] + 2  # one denied target fetch\n    assert rets[5][\"cycle\"] == rets[4][\"cycle\"] + 1\n    assert rets[4][\"rd_wdata\"] == rets[5][\"rs1_rdata\"] == 24\n", "exit_code": 0, "status": "completed"}}
