_ok;\n  logic [IDXW-1:0] clear_row, read_row, write_row, index_q;\n  logic write_row_en, read_row_en;\n  logic write_is_ram, want_data;\n  assign write_is_ram = in.valid && in.mem_addr[31:20] == 0 && (dmem_ren || |dmem_wen) && dmem_ready;\n  assign write_row_en = sweeping || write_is_ram;\n  assign write_row = sweeping ? clear_row : in.mem_addr[IDXW+1:2];\n  assign read_row = replay_index;\n  assign read_row_en = \"'!stall || repair;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sweeping <= 1;\n      clear_row <= 0;\n    end else if (sweeping) begin\n      sweeping <= !(&clear_row);\n      clear_row <= clear_row + 1'\"'b1;\n    end\n    if (write_row_en)\n      entries[write_row] <= {{in.mem_addr[19:IDXW+2], sweeping ? 4'b0 : dmem_ren ? 4'hf : dmem_wen,\n                             dmem_ren ? dmem_rdata : dmem_wdata}};\n    if (read_row_en) begin\n      entry <= entries[read_row];\n      index_q <= read_row;\n    end\n    if (sweeping || reset) slot_ok <= 0;\n    else if (read_row_en) slot_ok <= \"'!(write_row_en && write_row == read_row);\n  end\n  logic [3:0] requested_lanes;\n  assign requested_lanes = access_mask(in.ctrl.mem_width, dmem_addr[1:0]);\n  assign data_hit = slot_ok && in.mem_addr[31:2] == {{12'\"'b0, entry.tagbits, index_q}} &&\n                    (entry.maskbits & requested_lanes) == requested_lanes;\n  assign want_data = dmem_ren && \"'!dmem_ready && data_hit;\n'\"'''\ntwo=old.replace('halfword','saved_half').replace('lane','saved_lane').replace('load_data','saved_data').replace('dmem_rdata','entry.data')\ns=s[:a]+extra+old+two+s[z:]\ns=s.replace('  ex_mem_t reg_q;', '''  ex_mem_t reg_q;\n  logic use_saved_q;\n  logic [31:0] saved_data_q, saved_raw_q;\n  always_ff @(posedge clock) begin\n    if (reset) use_saved_q <= 0;\n    else if (\"'!stall) use_saved_q <= want_data;\n    if (!stall) begin\n      saved_data_q <= saved_data;\n      saved_raw_q <= entry.data;\n    end\n  end'\"''').replace('  assign out = reg_q;', '''  always_