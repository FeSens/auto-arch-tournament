{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/3c491641/31941f3e/rv32-r13-pi6iPR/fix.py <<'PY'\nfrom pathlib import Path\nimport sys,shutil\nsc=Path(__file__).parent\nname=sys.argv[1]; opts=sys.argv[2:]\nk=int(next((x[1:] for x in opts if x.startswith('k')),'12'))\nd=sc/name/'rtl';shutil.copytree('cores/bench/rtl',d,dirs_exist_ok=True)\ndef ref(file,a,b):\n p=d/(file+'.sv');s=p.read_text();assert s.count(a)==1,(file,a);p.write_text(s.replace(a,b))\nref('alu','  input  logic        div_request,', '''  output logic [31:0] partial,\n  output logic        carry_exact, carry_guess,\n  input  logic        div_request,''')\nref('alu','  always_comb begin\\\\n    shamt',f'''  localparam K = {k};\n  localparam H = 32-K;\n  logic sub;\n  logic [31:0] bx;\n  logic [K:0] low_wide;\n  logic [H-1:0] high_sum;\n  assign sub = op == ALU_SUB;\n  assign bx = b \"'^ {{32{{sub}}}};\n  assign low_wide = {{1'\"'b0,a[K-1:0]}} + {{1'b0,bx[K-1:0]}} + sub;\n  assign carry_exact = low_wide[K];\n  assign carry_guess = bx[K-1];\n  assign high_sum = a[31:K] + bx[31:K] + carry_guess;\n  always_comb begin\n    shamt''')\nif 'p4' in opts:\n ref('alu','assign carry_guess = bx[K-1];','''assign carry_guess = (a[K-1:K-4] > ~bx[K-1:K-4])\n                     || ((a[K-1:K-4] == ~bx[K-1:K-4]) && bx[31]);''')\nif 'addonly' in opts:\n ref('alu',\\\"assign sub = op == ALU_SUB;\\\", \\\"assign sub = 1'b0;\\\")\nref('alu','  logic [2:0] groups_left;', '''  assign partial = {high_sum, low_wide[K-1:0]};\n  logic [2:0] groups_left;''')\nref('ex_stage','  output logic               repair,','''  output logic [31:0]        partial_sum,\n  output logic               fix_result,\n  output logic               repair,''')\nref('ex_stage','assign repair = mem_op && \"'!addr_checked;'\"', 'assign repair = \"'!fix_result && mem_op && !addr_checked;'\"')\nref('ex_stage','(in.ctrl.mem_write && addr_checked', '(\"'!fix_result && in.ctrl.mem_