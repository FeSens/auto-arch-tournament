{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"tail -8 reg-formal.log && sed -n '210,244p' formal/run_all.sh && cat registered-timing.log | tail -2 && ls -lh cores/bench/generated/timing/gowin_p1/impl/pnr/core_bench.tr\"","aggregated_output":"SBY  5:12:22 [reg_ch0] engine_0: Status returned by engine: pass\nSBY  5:12:22 [reg_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:01:47 (107)\nSBY  5:12:22 [reg_ch0] summary: Elapsed process time [H:MM:SS (secs)]: 0:01:43 (103)\nSBY  5:12:22 [reg_ch0] summary: engine_0 (smtbmc bitwuzla) returned pass\nSBY  5:12:22 [reg_ch0] summary: engine_0 did not produce any traces\nSBY  5:12:22 [reg_ch0] DONE (PASS, rc=0)\n\nFormal: 53 passed, 0 failed\n    log=\"$name/logfile.txt\"\n    if grep -q \"DONE (PASS\" \"$log\" 2>/dev/null; then\n        PASS=$((PASS+1))\n    elif [[ \"$name\" == *_ch1 ]] && grep -q \"Status: PREUNSAT\" \"$log\" 2>/dev/null; then\n        # Vacuous pass on channel-1 checks. NRET=2 contract: when a\n        # single-issue hypothesis ties io_rvfi_valid_1 to 0, the per-channel\n        # BMC's assumption (rvfi_valid_1=1) is unsatisfiable, and SBY\n        # reports Status: PREUNSAT (rc=16). The property holds vacuously\n        # over the empty set of ch1-valid traces — a legitimate pass.\n        # Dual-issue hypotheses make the assumption satisfiable, so this\n        # branch never matches and the regular DONE (PASS branch covers it.\n        PASS=$((PASS+1))\n    else\n        FAIL=$((FAIL+1)); FAILED+=(\"$name\")\n    fi\ndone\nTOTAL=$((PASS+FAIL))\nif [ $TOTAL -eq 0 ]; then\n    FAIL=1\n    FAILED+=(\"no_checks_generated\")\nfi\n\necho \"\"\necho \"Formal: $PASS passed, $FAIL failed\"\nif [ $FAIL -gt 0 ]; then\n    echo \"Failed: ${FAILED[*]}\"\n    # Surface the FIRST failing check's logfile tail. tools/eval/formal.py\n    # captures this script's stdout/stderr into formal['detail'] and the\n    # orchestrator now records that in experiments/log.jsonl, so what we\n    # print here is what shows up as the diagnostic for the failed run.\n    first=\"${FAILED[0]}\"\n    if [ -f \"$first/logfile.txt\" ]; then\n        echo \"\"\n        echo \"--- $first/logfile.txt (last 30 lines) ---\"\n        tail -30 \"$first/logfile.txt\"\n  full report: /srv/hwebench/tmp/3c491641/1f2cf1bd/predictor-research/cores/bench/generated/timing/gowin_p2/impl/pnr/core_bench.tr\nscore Fmax (median): 61.218 MHz\n-rw-rw----+ 1 hwebench hwebench 307K Nov 20 05:11 cores/bench/generated/timing/gowin_p1/impl/pnr/core_bench.tr\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom shutil import copytree,copy\np=Path('cores/bench/test/test_pipeline.py');s=p.read_text()\na=\\\"ADDI(1, 0, 37), BEQ(1, 1, 8), store,\\\\n        JAL(2, 8), store\\\"\nassert a in s\ns=s.replace(a,a.replace('JAL(2, 8)','JALR(2, 0, 20)'))\ns+=\\\"\\\"\\\"\n@cocotb.test()\nasync def recovery_held_branch_and_fetch(dut):\n    program = [LW(9, 0, 64), BEQ(0, 0, 8), SW(9, 0, 68), ADDI(7, 0, 31), EBREAK()]\n    waits = 0\n    corrected_stalls = 0\n    def ready(pc, addr, ren, wen, data):\n        nonlocal waits, corrected_stalls\n        assert not wen\n        if ren:\n            assert addr == 64 and pc == 8\n            waits += 1\n            return int(waits < 4), int(waits == 4)\n        if pc == 12 and corrected_stalls < 2:\n            corrected_stalls += 1\n            return 0, 1\n        return 1, 1\n    rets, _ = await _run(dut, program, bus_ready=ready, unready_instr=SW(0, 0, 68))\n    assert (waits, corrected_stalls) == (4, 2)\n    assert [r['pc'] for r in rets] == [0, 4, 12, 16]\n    assert [r['order'] for r in rets] == [0, 1, 2, 3]\n    assert rets[1]['pc_next'] == 12\n    assert rets[2]['rd_wdata'] == 31\n\n@cocotb.test()\nasync def prediction_backedge_and_link(dut):\n    program = [ADDI(3, 0, 6), ADDI(3, 3, -1), _b(-4, 0, 3, 1, 0x63),\n               JAL(1, 8), SW(3, 0, 68), EBREAK()]\n    def ready(pc, addr, ren, wen, data):\n        assert not (ren or wen)\n        return 1, 1\n    rets, _ = await _run(dut, program, bus_ready=ready)\n    assert [r['pc'] for r in rets] == [0] + [4,8]*6 + [12,20]\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert rets[-2]['rd_wdata'] == 16\n    # The trained backedge hands the target to decode in the following cycle.\n    assert rets[9]['cycle'] == rets[8]['cycle'] + 1\n    assert rets[-1]['cycle'] == rets[-2]['cycle'] + 1\n\\\"\\\"\\\"\n# Give the recovery-hold test a fresh PC index unaffected by the preceding test.\nstart=s.index('async def recovery_held_branch_and_fetch')\ns=s[:start]+s[start:].replace('program = [LW(9','program = [NOP()] * 24 + [LW(9',1).replace('pc == 8','pc == 104',1).replace('pc == 12','pc == 108',1).replace(\\\"for r in rets] == [0, 4, 12, 16]\\\", \\\"for r in rets[24:]] == [96, 100, 108, 112]\\\",1).replace(\\\"for r in rets] == [0, 1, 2, 3]\\\",\\\"for r in rets] == list(range(28))\\\",1).replace(\\\"rets[1]['pc_next'] == 12\\\",\\\"rets[25]['pc_next'] == 108\\\",1).replace(\\\"rets[2]['rd_wdata'] == 31\\\",\\\"rets[26]['rd_wdata'] == 31\\\",1)\np.write_text(s)\nroot=Path.cwd(); q=root.parent/'target-buffer-research'; q.mkdir()\nfor n in ['bench','fpga','test','tools']:\n (q/n).symlink_to(root/n, target_is_directory=True)\ncopy(root/'Makefile',q/'Makefile')\ncopytree(root/'variants/registered',q/'cores/bench/rtl')\ncopytree(root/'cores/bench/test',q/'cores/bench/test')\ncopy(root/'cores/bench/core.yaml',q/'cores/bench/core.yaml')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
