{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/predictor_test/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def change_a_warm_indirect_target_behind_a_store(dut):\n    program = [NOP()] * 520\n    base = len(program) * 4\n    poison = SW(7, 0, 0x60)\n    program += [\n        0x00000297, ADDI(2, 0, 8), ADDI(4, 5, 36), ADDI(1, 1, 1),\n        _b(8, 2, 1, 1, 0x63), ADDI(4, 5, 48), SW(1, 0, 0x40),\n        JALR(0, 4, 0), poison, SW(1, 0, 0x44), JAL(0, -28), poison,\n        ADDI(8, 0, 55), EBREAK()\n    ]\n    holds = denials = 0\n    writes = []\n\n    def ready(pc, addr, ren, wen, data):\n        nonlocal holds,denials\n        assert not ren\n        dready = 1\n        if wen:\n            assert addr in (0x40,0x44) and wen == 15\n            if addr == 0x40 and data == 8:\n                assert pc == base + 48\n                if holds < 4:\n                    holds += 1\n                    dready = 0\n            if dready:\n                writes.append((addr,data))\n        if pc == base + 48 and denials < 8:\n            denials += 1\n            return 0,dready\n        return 1,dready\n\n    rets,_ = await _run(dut,program,max_cycles=850,bus_ready=ready,unready_instr=poison)\n    assert (holds,denials) == (4,8)\n    assert writes == [(a,i) for i in range(1,8) for a in (0x40,0x44)] + [(0x40,8)]\n    assert [r[\\\"pc_next\\\"] for r in rets if r[\\\"insn\\\"] == JALR(0,4,0)] == [base+36]*7 + [base+48]\n    assert rets[-2][\\\"rd_wdata\\\"] == 55\n    assert all(a[\\\"pc_next\\\"] == b[\\\"pc\\\"] for a,b in zip(rets,rets[1:]))\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n\n\n@cocotb.test()\nasync def same_index_different_pc_cannot_supply_a_store(dut):\n    program = [NOP()] * 520\n    base = len(program) * 4\n    store = SW(1,0,0x40)\n    program += [ADDI(1,0,7),NOP(),store,JAL(0,2048-12)] + [NOP()]*(512-4)\n    program += [ADDI(1,0,9),NOP(),ADDI(2,1,3),EBREAK()]\n    writes = []\n    waits = 0\n    def ready(pc,addr,ren,wen,data):\n        nonlocal waits\n        assert not ren\n        if wen:\n            writes.append((addr,data))\n        if pc == base+2056 and waits < 5:\n            waits += 1\n            return 0,1\n        return 1,1\n\n    rets,_=await _run(dut,program,max_cycles=800,bus_ready=ready,unready_instr=store)\n    assert waits == 5\n    assert writes == [(0x40,7)]\n    assert rets[-2][\\\"rd_wdata\\\"] == 12\n    assert all(a[\\\"pc_next\\\"] == b[\\\"pc\\\"] for a,b in zip(rets,rets[1:]))\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
