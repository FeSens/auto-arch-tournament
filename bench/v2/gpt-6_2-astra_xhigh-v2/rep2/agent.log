{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/lat\" && cp -r \"$TMPDIR/probe/rtl\" \"$TMPDIR/lat/rtl\"\npython - <<'\"'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'lat/rtl/load_replay.sv'\ns=p.read_text(); s=s[:s.index('  (* syn_ramstyle')]+'''  wire [9:0] index = addr[11:2];\n  logic [43:0] words[0:1023];\n  logic [9:0] clear_index;\n  logic clearing, last_write;\n  logic [9:0] last_index;\n  wire ordinary = addr[31:20] == 0;\n  wire wr = \"'!reset && ready && ordinary && (ren || |wen);\n  wire [43:0] row = words[index];\n  always_ff @(posedge clock) begin\n    if (reset) begin clearing<=1; clear_index<=0; end\n    else if (clearing) begin clearing<=!(&clear_index); clear_index<=clear_index+1'\"'b1; end\n    if (clearing) words[clear_index] <= 0;\n    else if (wr) words[index] <= {addr[19:12], ren ? 4'hf : wen, ren ? live_word : store_word};\n    last_write <= wr;\n    last_index <= index;\n  end\n  assign hit = \"'!ready && !clearing && ordinary && row[43:36] == addr[19:12] &&\n               (load_mask & row[35:32]) == load_mask && !(last_write && last_index == index);\n  assign selected_word = hit ? row[31:0] : live_word;\nendmodule\n'\"''';p.write_text(s)\nPY\nbash \\\"\"'$TMPDIR/simprobe.sh\" lat'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
