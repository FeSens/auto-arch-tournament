{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py && rg -n 'ADDI|use_add|alu_a|ex_a|cycle|fetches.count' cores/bench/test/test_pipeline.py | tail -105\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n73:    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n75:    imem is read combinationally each cycle from imemAddr; dmem similarly.\n80:    sampled on every\n…[4624 of 7696 chars elided by tools/bench/transcript.py; sha256:3bd47af14bac3098]…\nassert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n896:    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n898:    assert r2[\"cycle\"] == rets[0][\"cycle\"] + 1\n906:        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n907:        ADDI(3, 0, 42),        # PC=8 — target\n916:    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n918:    assert r3[\"cycle\"] == rj[\"cycle\"] + 1\n925:        ADDI(5, 0, 15),\n927:        ADDI(6, 0, 99),        # PC=8;  wrong-path\n928:        ADDI(7, 0, 42),        # PC=12; target\n936:    assert rets[1][\"cycle\"] == rets[0][\"cycle\"] + 1\n937:    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n939:    assert r7[\"cycle\"] == rets[1][\"cycle\"] + 1\n945:        ADDI(1, 0, 7),\n948:        ADDI(2, 1, 1), EBREAK(),\n966:    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n969:        ADDI(1, 0, val),\n1019:    rets, _ = await _run(dut, program, max_cycles=20)\n1028:        ADDI(1, 0, 1),\n1029:        ADDI(2, 0, 2),\n1030:        ADDI(3, 0, 3),\n1031:        ADDI(4, 0, 4),\n", "exit_code": 0, "status": "completed"}}
