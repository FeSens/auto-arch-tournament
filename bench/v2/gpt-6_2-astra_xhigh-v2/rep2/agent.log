{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\nm=(1<<32)-1\ndef digits(a,d):\n    multipliers=(0,d,d<<1,3*d)\n    t=a>>30\n    digit=max(k for k in range(4) if k*d<=t)\n    q=digit\n    r=t-digit*d\n    for group in range(5):\n        for pos in range(3):\n            shift=28-6*group-2*pos\n            t=(r<<2)|((a>>shift)&3)\n            residuals=[(t-v)%(1<<35) for v in multipliers]\n            digit=max(k for k in range(4) if (residuals[k]>>34)==0)\n            r=residuals[digit]\n            q=(q<<2)|digit\n            assert r <= m\n    return q,r\npairs=set()\nfor d in (0,1,2,3,5,7,0x55555555,0x55555556,0x7fffffff,0x80000000,0xffffffff):\n    for top in range(4):\n        for lo in (0,1,2,3,(1<<30)-1):\n            pairs.add(((top<<30)|lo,d))\n    for k in (1,2,3):\n        for e in (-1,0,1):\n            if 0<=k*d+e<=m: pairs.add((k*d+e,d))\nrng=Random(27)\nfor _ in range(20000): pairs.add((rng.getrandbits(32),rng.getrandbits(rng.randint(1,32))))\nfor a,d in pairs:\n    assert digits(a,d) == (divmod(a,d) if d else (m,a))\nprint(f'Radix-4 schedule matches quotient and remainder for {len(pairs):,} distinct unsigned input pairs.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\nm=(1<<32)-1\ndef digits(a,d):\n    multipliers=(0,d,d<<1,3*d)\n    t=a>>30\n    digit=max(k for k in range(4) if k*d<=t)\n    q=digit\n    r=t-digit*d\n    for group in range(5):\n        for pos in range(3):\n            shift=28-6*group-2*pos\n            t=(r<<2)|((a>>shift)&3)\n            residuals=[(t-v)%(1<<35) for v in multipliers]\n            digit=max(k for k in range(4) if (residuals[k]>>34)==0)\n            r=residuals[digit]\n            q=(q<<2)|digit\n            assert r <= m\n    return q,r\npairs=set()\nfor d in (0,1,2,3,5,7,0x55555555,0x55555556,0x7fffffff,0x80000000,0xffffffff):\n    for top in range(4):\n        for lo in (0,1,2,3,(1<<30)-1):\n            pairs.add(((top<<30)|lo,d))\n    for k in (1,2,3):\n        for e in (-1,0,1):\n            if 0<=k*d+e<=m: pairs.add((k*d+e,d))\nrng=Random(27)\nfor _ in range(20000): pairs.add((rng.getrandbits(32),rng.getrandbits(rng.randint(1,32))))\nfor a,d in pairs:\n    assert digits(a,d) == (divmod(a,d) if d else (m,a))\nprint(f'Radix-4 schedule matches quotient and remainder for {len(pairs):,} distinct unsigned input pairs.')\nPY\"","aggregated_output":"Radix-4 schedule matches quotient and remainder for 20,267 distinct unsigned input pairs.\n","exit_code":0,"status":"completed"}}
