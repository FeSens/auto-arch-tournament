{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"rg -n '\"'^def |''^class '\"' cores/bench/test/test_pipeline.py && cat tools/eval/_slots.py | head -160 && rg -n 'python|env|cosim' Makefile | head -50 && cat bench/programs/Makefile | head -110\"", "aggregated_output": "19:def _r(funct7, rs2, rs1, funct3, rd, opcode):\n24:def _i(imm, rs1, funct3, rd, opcode):\n29:def _s(imm, rs2, rs1, funct3, opcode):\n36:def _b(imm, rs2, rs1, funct3, opcode):\n46:def _j(imm, rd, opcode):\n56:def ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\n57:def ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\n58:def MUL(rd, rs1, rs2, funct3=0): return _r(1, rs2, rs1, funct3, rd, 0b0110011)\n59:def LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\n60:def SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\n61:def BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\n62:def BNE (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b001, 0b1100011)\n63:def JAL (rd, imm):       return _j(imm, rd, 0b1101111)\n64:def JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\n65:def NOP():               return ADDI(0, 0, 0)        # = 0x00000013\n66:def EBREAK():            return 0x00100073\n67:def ECALL():             return 0x00000073\n174:def _by_insn(retirements, insn):\n179:def _check_trace(rets, pcs, insns):\n1039:def test_pipeline_runner():\n\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\n…[3518 of 6590 chars elided by tools/bench/transcript.py; sha256:5ce4e0aeaaaed347]…\n       bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n", "exit_code": 0, "status": "completed"}}
