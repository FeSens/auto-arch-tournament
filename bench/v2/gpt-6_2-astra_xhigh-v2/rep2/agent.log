iv_consume)) begin\n      quotient <= quotient + digit;\n      residual <= residual - subtract_product;\n    end\n  end\n  logic [31:0] rem_one, rem_two, corrected_q, corrected_r;\n  logic fit_one, fit_two;\n  assign fit_one = residual >= divisor;\n  assign fit_two = !divisor[31] && residual >= (divisor << 1);\n  assign rem_one = residual - divisor;\n  assign rem_two = residual - (divisor << 1);\n  assign corrected_q = divisor == 0 ? 32'\"'hffffffff : quotient + {30'b0, fit_two, fit_one && \"'!fit_two};\n  assign corrected_r = fit_two ? rem_two : fit_one ? rem_one : residual;\n  logic [31:0] magnitude;\n  assign magnitude = rem_q ? corrected_r : corrected_q;\n  assign div_result = neg_q ? -magnitude : magnitude;\n'\"'''\nif 'shared' in cfg:\n a=a.replace('  assign estimate_product = residual * inv;\\\\n  assign subtract_product = digit * divisor;', '''  logic estimate_phase;\n  logic [31:0] mul_a,mul_b;\n  assign estimate_phase = groups_left[0];\n  assign mul_a = estimate_phase ? residual : digit;\n  assign mul_b = estimate_phase ? inv : divisor;\n  assign estimate_product = mul_a * mul_b;\n  assign subtract_product = estimate_product[31:0];''')\nq.write_text(s[:b]+a+s[e:])\nPY\nfor cfg in refine refineshared; do python \\\"\"'$TMPDIR/probe/make_refine.py\" \"$cfg\"; done\ncat \"$TMPDIR/probe/narrow8/benchres\" \"$TMPDIR/probe/narrow10/benchres\" \"$TMPDIR/probe/zero/benchres\"\npython - <<'\"'PY'\nfrom pathlib import Path\nimport ast,os\nfor c in ['zero','narrow8','narrow10','zerorfmux']:\n p=Path(os.environ['TMPDIR'])/'probe'/c/'result1'\n if p.stat().st_size: print(c,ast.literal_eval(p.read_text())['fmax_mhz'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
