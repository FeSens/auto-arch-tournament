{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_mul_product_runner.result.xml && cat cores/bench/test/test_mul_product.py'","aggregated_output":"<testsuites name=\"results\">\n  <testsuite name=\"all\" package=\"all\">\n    <property name=\"random_seed\" value=\"1795196058\" />\n    <testcase name=\"product_vectors\" classname=\"test_mul_product\" file=\"/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/cores/bench/worktrees/hyp-20261120-001-r15s0/cores/bench/test/test_mul_product.py\" lineno=\"10\" time=\"0.0053768157958984375\" sim_time_ns=\"0.0\" ratio_time=\"0.0\">\n      <failure error_type=\"AttributeError\" error_msg=\"mul_product contains no child object named result_en\" />\n    </testcase>\n    <testcase name=\"product_integer_reference\" classname=\"test_mul_product\" file=\"/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep2/cores/bench/worktrees/hyp-20261120-001-r15s0/cores/bench/test/test_mul_product.py\" lineno=\"23\" time=\"0.000621795654296875\" sim_time_ns=\"0.0\" ratio_time=\"0.0\">\n      <failure error_type=\"AttributeError\" error_msg=\"mul_product contains no child object named result_en\" />\n    </testcase>\n  </testsuite>\n</testsuites>\"\"\"Bit-exact tests for the MEM-stage RV32M product.\"\"\"\nimport random\n\nimport cocotb\n\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU\nfrom test_alu import _check\n\n\n@cocotb.test()\nasync def product_vectors(dut):\n    await _check(dut, ALU_MUL, 3, 4, 12)\n    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 1, 1, 0)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def product_integer_reference(dut):\n    edges = [0, 1, 2, 0x7FFFFFFF, 0x80000000, 0x80000001, 0xFFFFFFFF]\n    pairs = [(a, b) for a in edges for b in edges]\n    rng = random.Random(0x4D554C)\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(128))\n    for a, b in pairs:\n        signed_a = a - (1 << 32) if a >> 31 else a\n        signed_b = b - (1 << 32) if b >> 31 else b\n        await _check(dut, ALU_MUL, a, b, a * b)\n        await _check(dut, ALU_MULH, a, b, (signed_a * signed_b) >> 32)\n        await _check(dut, ALU_MULHSU, a, b, (signed_a * b) >> 32)\n        await _check(dut, ALU_MULHU, a, b, (a * b) >> 32)\n","exit_code":0,"status":"completed"}}
