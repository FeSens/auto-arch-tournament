{"type": "item.completed", "item": {"id": "item_105", "type": "command_execution", "command": "/bin/bash -c 'cat \"$TMPDIR/if_first.sv\"'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Read the successor row for each address sent to ID. Branches and jumps\n// use its saved PC on either bus outcome. EX checks the fetch in parallel.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              ex_valid,\n  input  logic [31:0]       ex_pc,\n  input  logic              ex_control,\n  input  logic              ex_fence_i,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output logic              annul,\n  output if_id_t  out\n);\n\n  // Write a live response one edge later, after its destination is checked.\n  // Keep rs1 in distributed RAM so its registered output can drive ID early.\n  (* syn_ramstyle = \"block_ram\", ram_style = \"block\" *)\n  logic [50:0] successors [0:511];\n  (* syn_ramstyle = \"distributed_ram\", ram_style = \"distributed\" *)\n  logic [19:15] insn_fast [0:511];\n  logic        clearing, train_q, trainable_q, write_enable;\n  logic [8:0]  clear_index, train_index_q, write_index;\n  logic [31:0] train_insn_q;\n  logic [31:0] retry_pc;\n\n  always_ff @(posedge clock) begin\n    if (reset || ex_fence_i) begin\n      clearing    <= 1'b1;\n      clear_index <= '0;\n    end else if (clearing) begin\n      clearing    <= !(&clear_index);\n      clear_index <= clear_index + 9'd1;\n    end\n\n    // A bubble or annul leaves the predecessor in place for the retry,\n    // however many clocks it takes to get a live word at the correct PC.\n    if (reset || ex_fence_i || clearing)\n      trainable_q <= 1'b0;\n    else if (!stall && ex_valid) begin\n      trainable_