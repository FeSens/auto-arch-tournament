{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'ls /opt/hwe-python && command -v python3 && command -v verilator && command -v riscv32-unknown-elf-gcc && ls -l /opt/gowin/IDE/bin/gw_sh && cat cores/bench/test/test_alu.py | head -100'","aggregated_output":"cpython-3.13-linux-x86_64-gnu\ncpython-3.13.12-linux-x86_64-gnu\n/srv/hwebench/venv/bin/python3\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n\"\"\"Check combinational ALU operations and the six-clock RV32M divider.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _issue(dut, op, a, b):\n    assert int(dut.div_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value =