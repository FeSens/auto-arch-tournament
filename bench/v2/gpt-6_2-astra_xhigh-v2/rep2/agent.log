& \"'!diff[17];\n    assign early_difference[k]=diff[13:0];\n  end\n  assign early_sel=early_fit[7:0] & ~early_fit[8:1];\n  for (genvar i=0;i<14;i++) begin\n    logic [7:0] masked;\n    for (genvar k=0;k<8;k++) begin\n      assign masked[k]=early_difference[k][i] & early_sel[k];\n    end\n    assign initial_remainder[i]=|masked;\n  end\n  assign initial_digit={early_fit[4],|(early_sel & 8'\"'hcc),|(early_sel & 8'haa)};\n\n  logic [34:0] trial;\n  logic [8:0] fits;\n  logic [7:0] sel;\n  logic [31:0] difference[0:7];\n  logic [2:0] digit;\n  logic [31:0] next_r;\n  assign trial={remainder_wide,quotient_wide[20:18]};\n  assign fits[0]=1;\n  assign fits[8]=0;\n  assign difference[0]=trial[31:0];\n  for (genvar k=1;k<8;k++) begin\n    logic [35:0] diff;\n    assign diff = {1'b0,trial} - {1'b0,mult[k]};\n    assign fits[k]=\"'!diff[35];\n    assign difference[k]=diff[31:0];\n  end\n  assign sel=fits[7:0] & ~fits[8:1];\n  for(genvar i=0;i<32;i++) begin\n    logic [7:0] opts;\n    for(genvar k=0;k<8;k++) begin\n      assign opts[k]=sel[k] & difference[k][i];\n    end\n    assign next_r[i]=|opts;\n  end\n  assign digit={fits[4],|(sel & 8'\"'hcc),|(sel & 8'haa)};\n  always_ff @(posedge clock) begin\n    if(groups_left==3'd6) begin\n      quotient_wide<={dividend[17:0],initial_digit};\n      remainder_wide<={18'b0,initial_remainder};\n    end else if(groups_left\"'!=0 || (div_valid && div_consume)) begin\n      quotient_wide <= {quotient_wide[17:0],digit};\n      remainder_wide <= next_r;\n    end\n  end\n\n\"\"\"+v[end:]\nv=v.replace(\"{8'\"'b0,quotient_wide}\\\", \\\"{11'b0,quotient_wide}\\\")\np.write_text(v)\nPY\npython \\\"\"'$TMPDIR/quotient11/build_candidate.py\"\nPYTHONPATH=. python \"$TMPDIR/quotient/timing.py\" \"$TMPDIR/quotient11\" > \"$TMPDIR/quotient11/results\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
