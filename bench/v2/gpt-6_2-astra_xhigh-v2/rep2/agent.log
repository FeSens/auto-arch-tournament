{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'cat tools/eval/_slots.py | head -95; ls -l /opt/gowin/IDE/bin/gw_sh; echo \"${GOWIN_HOME:-/opt/gowin}\"'","aggregated_output":"\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n/opt/gowin\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nd=Path(os.environ['TMPDIR'])/'r14rtl'\nshutil.copytree('cores/bench/rtl',d)\ndef change(file,a,b):\n p=d/file;s=p.read_text();assert a in s;p.write_text(s.replace(a,b,1))\nchange('core_pkg.sv','    logic [31:0] pc;\\\\n    logic [31:0] instr;', '    logic [31:0] predicted;\\\\n    logic [1:0] counter;\\\\n    logic [31:0] pc;\\\\n    logic [31:0] instr;')\nchange('core_pkg.sv','    logic [31:0] pc;\\\\n    logic [31:0] rs1_val;', '    logic [31:0] predicted;\\\\n    logic [1:0] counter;\\\\n    logic [31:0] pc;\\\\n    logic [31:0] rs1_val;')\nchange('id_stage.sv','reg_q.pc       <= in.pc;','reg_q.predicted <= in.predicted;\\\\n      reg_q.counter   <= in.counter;\\\\n      reg_q.pc       <= in.pc;')\nchange('core.sv','logic annul, ex_likely_direct, ex_fence_i;', 'logic annul, ex_fence_i;')\nchange('core.sv','  assign ex_likely_direct = (id_ex_w.ctrl.is_jump && \"'!id_ex_w.ctrl.is_jalr) ||'\"\\\\n                            (id_ex_w.ctrl.is_branch && id_ex_w.imm[31]);\\\\n','')\nchange('core.sv','    .ex_word_disp    (id_ex_w.imm[10:2]),\\\\n    .ex_likely_direct(ex_likely_direct),','    .ex_counter      (id_ex_w.counter),\\\\n    .ex_prediction   (id_ex_w.predicted),\\\\n    .ex_branch       (id_ex_w.ctrl.is_branch),\\\\n    .ex_jump         (id_ex_w.ctrl.is_jump),\\\\n    .hold_packet     (stall_id || (if_id_w.valid && flush_id)),')\nPY\ncat > \\\"\"'$TMPDIR/r14rtl/if_stage.sv\" <<'\"'EOF'\nmodule if_stage (\n  input logic clock, reset, ex_valid,\n  input logic [31:0] ex_pc, ex_prediction,\n  input logic [1:0] ex_counter,\n  input logic ex_branch, ex_jump, hold_packet, ex_fence_i, stall, imem_ready, redirect,\n  input logic [31:0] redirect_target,\n  output logic [31:0] imem_addr,\n  input logic [31:0] imem_data,\n  output logic annul,\n  output if_id_t out\n);\n  logic [31:0] fetch_pc_q, fix_pc_q, ex_linear;\n  logic [31:0] predict_pc, read_pc;\n  logic fix_q, hit_word, good_word, hit_target, take_target;\n  logic [10:0] init_ptr;\n  logic clearing;\n\n  // Next-PC prediction launches both positive-edge reads. Record the full\n  // actual fetch address separately so redirection never relies on a tag alias.\n  (* syn_ramstyle=\\\"block_ram\\\" *) logic [39:0] words[0:2047]; // valid, tag7, instruction\n  (* syn_ramstyle=\\\"block_ram\\\" *) logic [29:0] targets[0:511]; // valid, tag9, counter2, target18\n  logic [39:0] word_q;\n  logic [29:0] target_q;\n  logic ram_usable, target_usable, fill, train;\n  logic [1:0] trained_counter;\n  if_id_t packet;\n\n  assign ex_linear = ex_pc + 32'd4;\n  assign annul = fix_q;\n  assign imem_addr = fix_q ? fix_pc_q : fetch_pc_q;\n  assign hit_word = \"'!fix_q && ram_usable && word_q[39] &&\n      fetch_pc_q[31:20] == 0 && word_q[38:32] == fetch_pc_q[19:13];\n  assign hit_target = !fix_q && target_usable && target_q[29] &&\n      fetch_pc_q[31:20] == 0 && target_q[28:20] == fetch_pc_q[19:11];\n  assign take_target = hit_target && target_q[19];\n  assign predict_pc = take_target ? {12'\"'b0,target_q[17:0],2'b0} : imem_addr+32'd4;\n  assign good_word = imem_ready || hit_word;\n  assign read_pc = hold_packet || \"'!good_word ? imem_addr : predict_pc;\n  assign train = !reset && !clearing && (ex_branch || ex_jump) && !stall &&\n                 ex_pc[31:20]==0 && redirect_target[31:20]==0 && redirect_target[1:0]==0;\n  assign trained_counter = ex_jump ? 2'\"'b11 :\n      redirect ? (ex_counter==3 ? 2'd3 : ex_counter+2'd1) :\n                 (ex_counter==0 ? 2'd0 : ex_counter-2'd1);\n  assign fill = \"'!reset && !clearing && !ex_fence_i && imem_ready && imem_addr[31:20]==0;\n  always_ff @(posedge clock) begin\n    if (reset || ex_fence_i) begin\n      clearing <= 1'\"'b1;\n      init_ptr <= 0;\n    end else if (clearing) begin\n      clearing <= \"'!(&init_ptr);\n      init_ptr <= init_ptr+11'\"'d1;\n    end\n    if (reset) begin\n      fetch_pc_q<=0;\n      fix_q<=0;\n      packet.valid<=0;\n    end else begin\n      fetch_pc_q <= read_pc;\n      fix_q <= ex_valid && \"'!stall &&\n               (ex_fence_i || (redirect ? ex_prediction!=redirect_target : ex_prediction!=ex_linear));\n      fix_pc_q <= redirect ? redirect_target : ex_linear;\n      if (!hold_packet) begin\n        packet.pc<=imem_addr;\n        packet.predicted<=predict_pc;\n        packet.counter<=hit_target ? target_q[19:18] : 2'\"'d1;\n        packet.instr<=imem_ready ? imem_data : word_q[31:0];\n        packet.valid<=good_word;\n      end\n    end\n    if (clearing || fill)\n      words[clearing ? init_ptr : imem_addr[12:2]] <= {\"'!clearing,imem_addr[19:13],imem_data};\n    if (clearing || train)\n      targets[clearing ? init_ptr[8:0] : ex_pc[10:2]] <= {!clearing,ex_pc[19:11],trained_counter,redirect_target[19:2]};\n    word_q <= words[read_pc[12:2]];\n    target_q <= targets[read_pc[10:2]];\n    ram_usable <= !reset && !ex_fence_i && !clearing && !(fill && imem_addr[12:2]==read_pc[12:2]);\n    target_usable <= !reset && !ex_fence_i && !clearing && !(train && ex_pc[10:2]==read_pc[10:2]);\n  end\n  always_comb begin\n    out=packet;\n    out.valid=packet.valid && !fix_q;\n  end\nendmodule\nEOF\nRTL_DIR=\"$TMPDIR/r14rtl\" OBJ_DIR=\"$TMPDIR/r14trial\" NRET=1 bash test/cosim/build.sh > \"$TMPDIR/r14trial.log\" 2>&1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
