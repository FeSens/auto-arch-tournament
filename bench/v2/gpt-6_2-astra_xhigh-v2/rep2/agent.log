{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c 'cat formal/checks_si.cfg formal/wrapper_si.sv cores/bench/test/test_alu.py'", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) \n…[11470 of 14542 chars elided by tools/bench/transcript.py; sha256:8ed62ed05bb09d44]…\nvisor))\n\n    for dividend, divisor in sorted(pairs):\n        q, r = divmod(dividend, divisor) if divisor else (MASK32, dividend)\n        await _check_div(dut, ALU_DIVU, dividend, divisor, q)\n        await _check_div(dut, ALU_REMU, dividend, divisor, r)\n\n\n@cocotb.test()\nasync def divider_reset(dut):\n    await _setup(dut)\n    for clocks_before_reset in (3, 6):\n        await _issue(dut, ALU_DIVU, 0x12345678, 0x55)\n        for _ in range(clocks_before_reset):\n            await _tick(dut)\n        assert int(dut.div_valid.value) == (clocks_before_reset == 6)\n        await _setup(dut)\n        await _check_div(dut, ALU_REM, -17, 3, -2)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_mul_product_runner():\n    run_cocotb(toplevel=\"mul_product\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_mul_product\")\n", "exit_code": 0, "status": "completed"}}
