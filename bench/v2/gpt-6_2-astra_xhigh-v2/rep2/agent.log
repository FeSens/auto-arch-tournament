{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/seg.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nr=Path(os.environ['TMPDIR']); orig=sys.argv[1]; name=sys.argv[2]\nw=r/name; (w/'cores/bench').mkdir(exist_ok=True,parents=True)\nshutil.copytree(r/orig/'cores/bench/rtl',w/'cores/bench/rtl',dirs_exist_ok=True);shutil.copyfile('cores/bench/core.yaml',w/'cores/bench/core.yaml')\nif not (w/'fpga').exists(): (w/'fpga').symlink_to(Path.cwd()/'fpga')\nd=w/'cores/bench/rtl'; p=d/'core_pkg.sv'\ns=p.read_text(); i=s.index('  function automatic logic [3:0] access_mask')\nfun=\\\"\\\"\\\"\n  function automatic logic [31:0] add_blocks(\n    input logic [31:0] a, b, input logic carry_in\n  );\n    logic [2:0] g, p;\n    logic [3:0] c;\n    for (integer k=0; k<3; k=k+1) begin\n      g[k] = a[k*8 +: 8] > ~b[k*8 +: 8];\n      p[k] = &(a[k*8 +: 8] \"'^ b[k*8 +: 8]);\n    end\n    c[0] = carry_in;\n    c[1] = g[0] || (p[0] && carry_in);\n    c[2] = g[1] || (p[1] && g[0]) || ((&p[1:0]) && carry_in);\n    c[3] = g[2] || (p[2] && g[1]) || ((&p[2:1]) && g[0]) || ((&p) && carry_in);\n    for (integer k=0;k<4;k=k+1)\n      add_blocks[k*8 +: 8] = a[k*8 +: 8] + b[k*8 +: 8] + {7'\"'b0,c[k]};\n  endfunction\n\n\\\"\\\"\\\"\np.write_text(s[:i]+fun+s[i:])\np=d/'alu.sv'; s=p.read_text().replace('out = a + b;', \\\"out = add_blocks(a,b,1'b0);\\\").replace('out = a - b;', \\\"out = add_blocks(a,~b,1'b1);\\\");p.write_text(s)\np=d/'id_stage.sv';s=p.read_text().replace('assign add_base = ex_a + ex_b;', \\\"assign add_base = add_blocks(ex_a,ex_b,1'b0);\\\");p.write_text(s)\np=d/'ex_stage.sv';s=p.read_text().replace('assign repaired_addr = rs1 + in.imm;', \\\"assign repaired_addr = add_blocks(rs1,in.imm,1'b0);\\\");p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/seg.py\" slices seg\npython -m tools.eval.gowin bench --worktree \"$TMPDIR/seg\" --all-options'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
