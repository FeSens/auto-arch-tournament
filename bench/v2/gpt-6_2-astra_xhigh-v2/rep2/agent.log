wd_rs1 = 2'd0;\n   end\n \n-  // EX can discover a misaligned load or jump. Use its actual registered\n-  // write enable so a trapped younger writer cannot shadow the WB value.\n-  assign fwd_rs1[0] = ex_match[0] && ex_mem_can_forward;\n-  assign fwd_rs2[0] = ex_match[1] && ex_mem_can_forward;\n-  assign fwd_rs1[1] = mem_match[0] && !fwd_rs1[0];\n-  assign fwd_rs2[1] = mem_match[1] && !fwd_rs2[0];\n+  always_comb begin\n+    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) fwd_rs2 = 2'd1;\n+    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 2'd2;\n+    else                                                                  fwd_rs2 = 2'd0;\n+  end\n \n endmodule\n--- cores/bench/rtl/core.sv\t2026-11-20 06:48:44.440260212 +0100\n+++ /srv/hwebench/tmp/3c491641/9afa0198/rtl-rf/core.sv\t2026-11-20 06:48:20.236794306 +0100\n@@ -233,14 +233,12 @@\n   );\n \n   forward_unit u_fwd (\n-    .clock       (clock),\n-    .stall       (stall_id),\n-    .id_rs1      (rs1_addr_w),\n-    .id_rs2      (rs2_addr_w),\n-    .ex_rd       (id_ex_w.rd),\n-    .mem_rd      (ex_mem_w.rd),\n-    .mem_writes  (ex_mem_w.ctrl.reg_write),\n-    .ex_mem_can_forward (ex_mem_w.ctrl.reg_write && !ex_mem_w.ctrl.late_result),\n+    .id_ex_rs1   (id_ex_w.rs1_addr),\n+    .id_ex_rs2   (id_ex_w.rs2_addr),\n+    .ex_mem_rd   (ex_mem_w.rd),\n+    .ex_mem_w_en (ex_mem_w.ctrl.reg_write && !ex_mem_w.ctrl.late_result),\n+    .mem_wb_rd   (mem_wb_w.rd),\n+    .mem_wb_w_en (mem_wb_w.ctrl.reg_write), // held data still forwards after retirement\n     .fwd_rs1     (fwd_rs1_sel),\n     .fwd_rs2     (fwd_rs2_sel)\n   );\n","exit_code":1,"status":"failed"}}
