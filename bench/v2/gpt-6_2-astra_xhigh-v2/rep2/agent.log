{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python -B - <<'PY'\nfrom collections import Counter\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport shlex, subprocess, sys\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\nwith TemporaryDirectory() as build:\n    exe = str(Path(build) / 'coremark.elf')\n    cmd = subprocess.check_output(['make','-nB','-f','bench/programs/Makefile','bench/programs/coremark.elf'],text=True).strip()\n    args = shlex.split(cmd.replace('\\\\\\\\\\\\n',' '))\n    assert args[-2:] == ['-o','bench/programs/coremark.elf']\n    args[-1] = exe\n    subprocess.run(args,check=True)\n    cpu = RV32IM()\n    cpu.load_elf(exe)\n    active = False\n    count = 0\n    ops = Counter()\n    windows = 0\n    for i in range(10_000_000):\n        r = cpu.step()\n        insn = r['insn']\n        assert not r['trap'] and not cpu.oob_access\n        if r['mem_wmask'] and r['mem_addr'] == 0x10000100:\n            assert not active\n            active = True\n            continue\n        if r['mem_wmask'] and r['mem_addr'] == 0x10000104:\n            assert active\n            windows += 1\n            active = False\n            continue\n        if active:\n            count += 1\n            if (insn & 0xfe00007f) == 0x02000033:\n                ops[(insn >> 12) & 7] += 1\n        if insn == 0x00100073:\n            break\n    else:\n        raise RuntimeError('Instruction limit before EBREAK')\n    assert not active and windows == 1\n    uart = bytes(cpu.uart_buf).replace(b'\\\\x00', b'').decode()\n    for token in ['0xe9f5', '0xe714', '0x1fd7', '0x8e3a', '0xfcaf', 'Correct operation validated.']:\n        assert token in uart, (token,uart)\n    print(f'Timed retirements={count}, MUL-family={sum(ops[i] for i in range(4))}, DIV/REM-family={sum(ops[i] for i in range(4,8))}. CoreMark CRCs confirmed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
