{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/if_stage.sv && sed -n '70,180p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// The instruction in EX selects its successor on the combinational imem\n// bus. When ID/EX takes a bubble, retry the address presented on that edge.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              ex_valid,\n  input  logic [31:0]       ex_pc,\n  input  logic [8:0]        ex_word_disp,\n  input  logic              ex_likely_direct,\n  input  logic              ex_fence_i,\n  input  logic              stall,\n  input  logic              imem_ready,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output logic              annul,\n  output if_id_t  out\n);\n\n  logic [31:0] retry_pc, fallthrough_pc;\n\n  always_ff @(posedge clock) begin\n    if (reset) retry_pc <= 32'b0;\n    else       retry_pc <= imem_addr;\n  end\n\n  assign fallthrough_pc = ex_pc + 32'd4;\n  assign imem_addr = redirect ? redirect_target\n                   : ex_valid ? fallthrough_pc : retry_pc;\n\n  // Write a live response one edge later, once retry_pc contains its address.\n  // Keep rs1 in distributed RAM so its registered output can drive ID early.\n  (* syn_ramstyle = \"block_ram\", ram_style = \"block\" *)\n  logic [50:0] successors [0:511];\n  (* syn_ramstyle = \"distributed_ram\", ram_style = \"distributed\" *)\n  logic [19:15] insn_fast [0:511];\n  logic        clearing, train_q, write_enable;\n  logic [8:0]  clear_index, train_index_q, write_index;\n  logic [31:0] train_insn_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || ex_fence_i) begin\n      clearing    <= 1'b1;\n      clear_index <= '0;\n    end else if (clearing) begin\n      clearing    <= !(&clear_index);\n      clear_index <= clear_index + 9'd1;\n    end\n\n    train_q <= !reset && !ex_fence_i && !clearing && !stall &&\n               imem_ready && ex_valid && ex_pc[31:20] == 0 && ex_pc[1:0] == 0;\n    train_index_q <= ex_pc[10:2];\n    train_insn_q  <= imem_data;\n  end\n\n \n…[5602 of 8674 chars elided by tools/bench/transcript.py; sha256:8932e671df3a29f6]…\n\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value = fetched\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0) if dready else 0xDEADBEEF\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _check_trace(rets, pcs, insns):\n    assert [r[\"pc\"] for r in rets] == pcs\n", "exit_code": 0, "status": "completed"}}
