{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv cores/bench/rtl/forward_unit.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, and issues checked memory\n// requests. Owns the EX/MEM pipeline register.\n//\n// Forwarding select encoding (driven by forward_unit):\n//   00 = ID/EX register value (no forward)\n//   01 = EX/MEM result, including an accepted load\n//   10 = MEM/WB result, including any M operation\n//\n// DIV/REM hold ID/EX for issue and six iterations. Other operations take\n// one cycle when MEM can advance.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,\n  output logic [31:0]        alu_a, alu_b,  // operands for the ID address predictor\n  output logic               repair,\n  output logic [31:0]        repaired_addr,\n  output logic [31:0]        dmem_addr, dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic [31:0]        div_result,    // MEM sideband from the final divider registers\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  // The forward unit already gives the youngest eligible producer priority.\n  // Its two select bits are mutually exclusive.\n  assign rs1 = ({32{fwd_rs1_sel == 2'b00}} & in.rs1_val)\n             | ({32{fwd_rs1_sel[0]}} & fwd_ex_mem)\n             | ({32{fwd_rs1_sel[1]}} & fwd_mem_\n…[7498 of 10570 chars elided by tools/bench/transcript.py; sha256:1d68db8e449e9963]…\n output logic       older_rs1_match,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  logic younger_rs1_q, younger_rs2_q, older_rs1_q, older_rs2_q;\n  logic older_writer;\n  assign younger_rs1_match = id_ex_rd != 0 && id_ex_rd == id_rs1;\n  assign older_writer = ex_mem_reg_write && ex_mem_rd != 0;\n  assign older_rs1_match = older_writer && ex_mem_rd == id_rs1;\n\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      younger_rs1_q <= younger_rs1_match;\n      younger_rs2_q <= id_ex_rd != 0 && id_ex_rd == id_rs2;\n      older_rs1_q   <= older_rs1_match;\n      older_rs2_q   <= older_writer && ex_mem_rd == id_rs2;\n    end\n  end\n\n  // EX has now resolved traps on the younger producer. A suppressed\n  // writer leaves the older match eligible, even if WB already retired.\n  assign fwd_rs1[0] = younger_rs1_q && ex_mem_forwardable;\n  assign fwd_rs2[0] = younger_rs2_q && ex_mem_forwardable;\n  assign fwd_rs1[1] = older_rs1_q && !fwd_rs1[0];\n  assign fwd_rs2[1] = older_rs2_q && !fwd_rs2[0];\nendmodule\n", "exit_code": 0, "status": "completed"}}
