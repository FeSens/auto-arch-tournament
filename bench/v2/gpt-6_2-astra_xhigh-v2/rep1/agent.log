{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"cp -r cores/bench/test '/srv/hwebench/tmp/800f6bc6/a945fa9a/predictor.R04qjsIx/cores/bench/' && cat >> '/srv/hwebench/tmp/800f6bc6/a945fa9a/predictor.R04qjsIx/cores/bench/test/test_pipeline.py' <<'PY'\n\n@cocotb.test()\nasync def warm_loop_and_exit(dut):\n    program = [\n        ADDI(1, 0, 3), NOP(), SW(1, 0, 0x100), ADDI(1, 1, -1),\n        _b(-8, 0, 1, 1, 0x63), JAL(0, 8), SW(0, 0, 0x100), EBREAK(),\n    ]\n    rets, mem = await _run(dut, program)\n    pcs = [r['pc'] for r in rets]\n    assert pcs == [0, 4] + [8, 12, 16] * 3 + [20, 28]\n    assert mem[0x100] == 1\n    warm = [i for i, r in enumerate(rets) if r['pc'] == 16][1]\n    assert rets[warm+1]['cycle'] == rets[warm]['cycle'] + 1\n\n@cocotb.test()\nasync def changing_indirect_behind_load(dut):\n    program = [\n        ADDI(3, 0, 24), LW(6, 0, 0x100), JALR(5, 3, 0), SW(0, 0, 0x100),\n        NOP(), NOP(), ADDI(3, 0, 40), ADDI(7, 7, 1), JAL(0, -28),\n        SW(0, 0, 0x100), EBREAK(),\n    ]\n    dwaits = 3\n    iwaits = {12: 2, 24: 2, 40: 2}\n    def ready(ia, addr, ren, wen, data):\n        nonlocal dwaits\n        hold_i = iwaits.get(ia, 0) > 0\n        if hold_i: iwaits[ia] -= 1\n        hold_d = ren and addr == 0x100 and dwaits > 0\n        if hold_d: dwaits -= 1\n        elif ren: dwaits = 3\n        return int(not hold_i), int(not hold_d)\n    rets, mem = await _run(dut, program, {0x100: 0x1234}, bus_ready=ready)\n    assert [r['pc'] for r in rets] == [0, 4, 8, 24, 28, 32, 4, 8, 40]\n    assert [r['pc_next'] for r in rets if r['pc'] == 8] == [24, 40]\n    assert [r['rd_wdata'] for r in rets if r['pc'] == 8] == [12, 12]\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert mem[0x100] == 0x1234\nPY\npython -m pytest -q '/srv/hwebench/tmp/800f6bc6/a945fa9a/predictor.R04qjsIx/cores/bench/test/test_pipeline.py' > '/srv/hwebench/tmp/800f6bc6/a945fa9a/predictor.R04qjsIx/pipeline-run.log' 