{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'sdir=\"$TMPDIR/bench-share.KOuNYh\"\ncat > \"$sdir/correct.py\" <<'\"'PY'\nimport pathlib,sys\nout=pathlib.Path(sys.argv[1]); f=out/'alu.sv'\ns=f.read_text()\na=s.index('  logic [31:0] first_q,')\nb=s.index('\"'`endif'\"',a)\ns=s[:a]+\\\"\\\"\\\"  logic [31:0] first_q, resid0, sum_q;\n  logic [32:0] resid0_minus_d;\n  wire [31:0] residual = numerator - product[31:0];\n  always_comb begin\n    case (phase_q)\n      2: begin next_lhs = numerator; next_rhs = seed_q >> shift_q; end\n      4: begin next_lhs = residual; next_rhs = recip_q; end\n      default: begin next_lhs = product[63:32]; next_rhs = divisor; end\n    endcase\n  end\n  always_ff @(posedge clock) begin\n    if (phase_q == 3) first_q <= product[63:32];\n    if (phase_q == 4) resid0 <= residual;\n    if (phase_q == 5) begin\n      sum_q <= first_q + product[63:32];\n      resid0_minus_d <= {1'b0,resid0} - {1'b0,divisor};\n    end\n  end\n  logic increment;\n  logic [31:0] rem0, rem1, q0, q1, bypass_result;\n  always_ff @(posedge clock) begin\n    if (phase_q == 6) begin\n      increment <= \"'!resid0_minus_d[32] && product[31:0] <= resid0_minus_d[31:0];\n      rem0 <= negate ? product[31:0] - resid0 : resid0 - product[31:0];\n      rem1 <= negate ? product[31:0] - resid0_minus_d[31:0] : resid0_minus_d[31:0] - product[31:0];\n      q0 <= negate ? -sum_q : sum_q;\n      q1 <= negate ? ~sum_q : sum_q + 1'\"'b1;\n    end\n    bypass_result <= zero && \"'!want_rem ? '\"'1 : one && want_rem ? 0 : negate ? -numerator : numerator;\n  end\n  assign div_result = zero || one ? bypass_result : want_rem ? (increment ? rem1 : rem0) : (increment ? q1 : q0);\n\\\"\\\"\\\"+s[b:]\nf.write_text(s)\nPY\nfor n in b c; do mkdir \\\"\"'$sdir/$n\"; cp -r \"$sdir/rtl\" \"$sdir/$n\"; python \"$sdir/correct.py\" \"$sdir/$n/rtl\"; done\ncat > \"$sdir/reuse.py\" <<'\"'PY'\nimport sys,pathlib\np=pathlib.Path(sys.argv[1])\nf=p/'core_pkg.sv';s=f.read_text().replace('logic [32:0] product_lhs, product_rhs;', 'logic [31:0] product_rhs; logic mul_lhs_negative, mul_rhs_negative;');f.write_text(s)\nf=p/'ex_stage.sv';s=f.read_text().replace('reg_q.other_operand <= in.ctrl.alu_src ?', 'reg_q.other_operand <= div_busy ? next_lhs : in.ctrl.alu_src ?').replace(\\\"reg_q.product_lhs <= div_busy ? {1'b0,next_lhs} : {((in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU) && rs1[31]),rs1};\\\", 'reg_q.mul_lhs_negative <= \"'!div_busy && (in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU) && rs1[31];'\"').replace(\\\"reg_q.product_rhs <= div_busy ? {1'b0,next_rhs} : {(in.ctrl.alu_op == ALU_MULH && rs2[31]),rs2};\\\", 'reg_q.mul_rhs_negative <= \"'!div_busy && in.ctrl.alu_op == ALU_MULH && rs2[31];'\"\\\\n      reg_q.product_rhs <= div_busy ? next_rhs : rs2;');f.write_text(s)\nf=p/'mem_stage.sv';s=f.read_text().replace('in.product_lhs','{in.mul_lhs_negative,in.other_operand}').replace('in.product_rhs','{in.mul_rhs_negative,in.product_rhs}');f.write_text(s)\nPY\npython \\\"\"'$sdir/reuse.py\" \"$sdir/c/rtl\"\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
