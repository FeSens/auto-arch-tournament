{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/newton/normalized.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os,sys\nH=1<<32\nname=sys.argv[1]; p,n,g=map(int,sys.argv[2:5]); flags=sys.argv[5:]\nguard=3\nstep=1<<n; prefix=1<<p; group=1<<(p-g)\nbase=Path(os.environ['TMPDIR'])/'newton'\nrtl=base/name/'rtl'\ncopytree(base/'b4/rtl',rtl,dirs_exist_ok=True)\nfile=rtl/'alu.sv'; src=file.read_text()\nc0=[((H<<p)-1)//j for j in range(prefix,2*prefix)]\nc1=[]\nfor grp in range(1<<g):\n mid=2*(prefix+grp*group)+group-1\n for frac in range(step):\n  num=(H<<guard)*4*frac\n  den=mid*(mid*step+2*frac)\n  c1.append((num+den//2)//den)\ndef rom(name,vals,w):\n return f'  (* syn_ramstyle = \\\"block_ram\\\" *) logic [{w-1}:0] {name}[0:{len(vals)-1}];\\\\n  initial begin\\\\n'+'\\\\n'.join(f\\\"    {name}[{i}] = {w}'h{v:0{(w+3)//4}x};\\\" for i,v in enumerate(vals))+'\\\\n  end\\\\n'\ncw=max(c1).bit_length()\nif 'case' in flags:\n norm='  logic [31:0] normalized;\\\\n  logic [4:0] e;\\\\n  always_comb begin\\\\n    casez (dvs_q)\\\\n'\n for i in reversed(range(32)):\n  pattern='0'*(31-i)+'1'+'?'*i\n  norm+=f\\\"      32'b{pattern}: begin normalized = dvs_q << {31-i}; e = 5'd{i}; end\\\\n\\\"\n norm+=\\\"      default: begin normalized = 0; e = 0; end\\\\n    endcase\\\\n  end\\\\n\\\"\nelse:\n norm=\\\"\\\"\\\"  logic [4:0] e;\n  always_comb begin\n    e = 0;\n    for (int i = 0; i < 32; i++)\n      if (dvs_q[i]) e = 5'(i);\n  end\n  wire [31:0] normalized = dvs_q << ~e;\n\\\"\\\"\\\"\npre=norm+rom('intercept',c0,32)+rom('adjust',c1,cw)+f\\\"\\\"\\\"\n  logic [31:0] c_q, refined_q, m_q;\n  logic [{cw-1}:0] k_q;\n  logic [4:0] exponent_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd1) begin\n      c_q <= intercept[normalized[30:{31-p}]];\n      k_q <= adjust[{{normalized[30:{31-g}],normalized[{30-p}:{31-p-n}]}}];\n      exponent_q <= e;\n    end\n    if (phase_q == 3'd2)\n      refined_q <= c_q - (32'(k_q) << {p-guard});\n    if (phase_q == 3'd3)\n      m_q <= 32'(({{1'b0,refined_q}} + (33'd1 << (exponent_q-1'b1))) >> exponent_q);\n  end\n\\\"\\\"\\\"\nif 'round' in flags:\n pre=pre.replace('  always_ff @(posedge clock) begin\\\\n    if (phase_q == 3\\\\'d1)',\\\"  wire [31:0] shifted = refined_q >> (exponent_q-5'd1);\\\\n  always_ff @(posedge clock) begin\\\\n    if (phase_q == 3'd1)\\\")\n pre=pre.replace(\\\"32'(({1'b0,refined_q} + (33'd1 << (exponent_q-1'b1))) >> exponent_q)\\\",\\\"{1'b0,shifted[31:1]} + 32'(shifted[0])\\\")\ni=src.index('  logic [4:0] s,scale_q'); j=src.index('  logic [31:0] estimate_q, magnitude_q;',i)\nsrc=src[:i]+pre+src[j:]\nif 'sepdsp' in flags:\n i=src.index('  wire [31:0] lhs = phase_q');j=src.index('  wire [31:0] residual =',i)\n src=src[:i]+'''  wire [63:0] qp = dvd_q * m_q;\n  wire [32:0] dp = 33'(estimate_q * dvs_q);\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd4) estimate_q <= qp[63:32];\n    if (phase_q == 3'd5) residual_q <= {1'b0,dvd_q} - dp;\n  end\n'''+src[j:]\nfile.write_text(src)\nct=0;bad=0;worst=(0,0)\nfor e in range(1,32):\n W=1<<max(0,e-p)\n for j in range(prefix,2*prefix,1<<max(0,p-e)):\n  for frac in range(0,step,max(1,step//W)):\n   L=((j<<max(0,e-p))>>max(0,p-e))+(frac*W+step-1)//step\n   R=((j<<max(0,e-p))>>max(0,p-e))+((frac+1)*W-1)//step\n   k=c1[(j-prefix)//group*step+frac]\n   M=(c0[j-prefix]-(k<<(p-guard))+(1<<(e-1)))>>e\n   ct+=1\n   if M*R>H+R or M*L<H-L:bad+=1\n   worst=max(worst,(max(M-H/R,H/L-M),L))\nprint(name,'bins',ct,'bad',bad,'worst',worst,'corrw',cw,flush=True)\nPY\npython \\\"\"'$TMPDIR/newton/normalized.py\" c1 12 4 7 round\npython \"$TMPDIR/newton/normalized.py\" c2 12 4 7 round case sepdsp\npython \"$TMPDIR/newton/normalized.py\" c3 11 5 9 round\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
