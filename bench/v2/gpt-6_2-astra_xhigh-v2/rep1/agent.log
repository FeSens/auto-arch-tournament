\"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[8073 of 11145 chars elided by tools/bench/transcript.py; sha256:29eb7193acad3394]…\narker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n275:def _uart_int(uart: str, pattern: str, base: int = 10):\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n280:    \"\"\"Require CoreMark's own validation and exact expected CRC markers,\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n306:def _bench_sv(worktree: str, target: str | None) -> str:\n309:        return \"fpga/core_bench.sv\"\n311:    return \"fpga/core_bench_si.sv\" if nret == 1 else \"fpga/core_bench.sv\"\n314:def measure_fmax(worktree: str, target: str, pairs=None) -> dict:\n323:    res = gowin.build_all(worktree, rtl, _bench_sv(worktree, target), gen)\n330:def run_fpga_eval(worktree: str, target: str | None = None) -> dict:\n337:      {'bench_failed': True, ...}        — bench didn't reach ebreak, or\n361:    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\n368:        return {'bench_failed': True, 'placement_failed': False,\n375:            'bench_failed': True,\n", "exit_code": 0, "status": "completed"}}
