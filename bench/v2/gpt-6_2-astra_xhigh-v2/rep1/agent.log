{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfor var in ['shared','compact']:\n p=Path('/srv/hwebench/tmp/800f6bc6/bf54ca24/r11-divider.g7mIWusm')/var/'cores/bench/test/test_alu.py'\n t=p.read_text()\n p.write_text(t+'''\n@cocotb.test()\nasync def reciprocal_bucket_transitions(dut):\n    await _setup(dut)\n    rng = random.Random(76)\n    pairs = [(0xffffffff,2), (0xfffffffe,2), (0xffffffff,2049)]\n    for shift in (0, 1, 2, 5, 11, 12, 13, 19, 21):\n        for j in (1024, 1025, 1111, 1536, 2046, 2047):\n            for offset in (-1, 0, 1, (1 << shift) // 2, (1 << shift) - 1):\n                d = (j << shift) + offset\n                if 1 < d <= MASK32:\n                    q = MASK32 // d\n                    for x in (d-1, d, d+1, q*d-1, q*d, q*d+1, MASK32):\n                        if x <= MASK32:\n                            pairs.append((x, d))\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(rng.randrange(1,33))) for _ in range(1000))\n    for a, b in pairs:\n        for op in (ALU_DIVU, ALU_REMU, ALU_DIV, ALU_REM):\n            x, y = a, b\n            if op in (ALU_DIV, ALU_REM):\n                if x >> 31: x -= 1 << 32\n                if y >> 31: y -= 1 << 32\n            if y:\n                quotient = abs(x) // abs(y)\n                if (x < 0) \"'!= (y < 0): quotient = -quotient\n                remainder = x - quotient * y\n            else:\n                quotient, remainder = -1, x\n            expected = quotient if op in (ALU_DIVU, ALU_DIV) else remainder\n            await _check_div(dut, op, a, b, expected)\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
