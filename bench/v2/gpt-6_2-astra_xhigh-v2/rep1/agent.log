{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/vprof.cpp\" <<'\"'CPP'\n#include <cstdio>\n#include <cstdint>\n#include <vector>\n#include <array>\n#include <algorithm>\nstruct R{unsigned pc,npc,i,rd,a,b,addr,cyc;};\nstruct B{int pc,t,context;};\nstruct E{int key=-1,c=1,dir=0,cf=0;};\nint sat(int c,int t){return std::max(0,std::min(3,c+(t?1:-1)));}\nint main(int ac,char**av){std::vector<R> ins; R r;FILE*f=fopen(av[1],\\\"rb\\\");while(fread(&r,sizeof r,1,f))ins.push_back(r);\nfor(int ctx=0;ctx<6;ctx++){std::vector<B> br;int c=0,ix=0;\nfor(auto r:ins){while(ix<(int)ins.size() && ins[ix].cyc+3<=r.cyc){auto p=ins[ix++];if((p.i&127)==3){int width=p.i>>12&3;if(ctx==0&&width==0)c=p.rd&255;if(ctx==1)c=p.rd&255;if(ctx==2&&width==0)c=p.addr&255;if(ctx==3)c=p.addr&255;if(ctx==4&&width==0)c=(p.rd&255)\"'^((c<<4)&255);if(ctx==5&&width!=2)c=p.rd&255;}}if((r.i&127)==99)br.push_back({int(r.pc>>2),r.pc+4!=r.npc,c});}\nfor(int lg:{6,8,10,12})for(int sty=0;sty<5;sty++){int mask=(1<<lg)-1;std::vector<E> tab(1<<lg);std::vector<int> base(4096,1);int wrong=0,ovr=0;\nfor(auto b:br){int pc=b.pc,h=b.context,t=b.t;int key=pc<<8|h;int idx=sty>=3?pc&mask:(pc''^(pc>>lg)''^h''^(h<<4))&mask;E&e=tab[idx];int p=base[pc]>=2;\nint pred=e.key==key?(sty>=3?e.dir:(e.c>=2)):p;\nwrong+=(pred!=t);ovr+=pred!=p;\nif(sty<3){\n if(e.key==key) e.c=sat(e.c,t);else if(p!=t||sty==1){e.key=key;e.c=t?2:1;}\n if(sty==2&&e.key==key&&(e.c==3||e.c==0)&&p==t)e.key=-1;\n}else{\n if(e.key==key){if(e.dir!=t)e.cf--;else e.cf=std::min(3,e.cf+1);if(e.cf<0)e.key=-1;}\n else if(p!=t){if(sty==3||e.cf--<=0){e.key=key;e.dir=t;e.cf=1;}}\n}\nbase[pc]=sat(base[pc],t);\n}printf(\"%d %d %d %d %d'\"\\\\n\\\",ctx,lg,sty,wrong,ovr);}\n}}\nCPP\ng++ -std=c++17 -O3 \\\"\"'$TMPDIR/vprof.cpp\" -o \"$TMPDIR/vprof\" && \"$TMPDIR/vprof\" \"$TMPDIR/trace.bin\" > \"$TMPDIR/vpcounts\"; sort -nk4 \"$TMPDIR/vpcounts\" | head -35'","aggregated_output":"","exit_code":null,"status":"in_prog