{"type": "item.completed", "item": {"id": "item_60", "type": "command_execution", "command": "/bin/bash -c \"ls -l formal/riscv-formal/; sed -n '180,245p' cores/bench/test/test_pipeline.py; sed -n '1,100p' tools/eval/cosim.py\"", "aggregated_output": "total 76\n-rw-rw----+  1 nobody nogroup   757 Nov 19 15:04 COPYING\n-rw-rw----+  1 nobody nogroup  3086 Nov 19 15:04 CodeOfConduct\n-rw-rw----+  1 nobody nogroup  3998 Nov 19 15:04 README.md\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:04 bus\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:04 checks\ndrwxrwx---+ 10 nobody nogroup  4096 Nov 19 15:59 cores\ndrwxrwx---+  3 nobody nogroup  4096 Nov 19 15:04 docs\ndrwxrwx---+  2 nobody nogroup 12288 Nov 19 15:04 insns\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:04 monitor\ndrwxrwx---+  5 nobody nogroup  4096 Nov 19 15:04 tests\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_