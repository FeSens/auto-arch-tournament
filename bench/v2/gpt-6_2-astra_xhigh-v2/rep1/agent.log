{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/div-research/compact.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nroot=Path(os.environ['TMPDIR'])/'div-research'\nname=sys.argv[1];source=root/'wide16'\ndest=root/name\nshutil.copytree(source/'rtl',dest/'rtl',dirs_exist_ok=True)\nshutil.copytree(Path.cwd()/'cores/bench/test',dest/'test',dirs_exist_ok=True)\nf=dest/'rtl/alu.sv';s=f.read_text()\ndef rc(name,w,b,onehot=False):\n n=1<<b;bits=w+b\n v=f'''  function automatic logic [{bits-1}:0] {name}(input logic [{bits-1}:0] partial);\n    logic [{n-1}:0] ge;\n    logic [{b-1}:0] digit;\n    logic [{w-1}:0] subtrahend;\n    logic [{w-1}:0] choices [0:{n-1}];\n    ge[0] = 1'b1;\n    choices[0] = '0;\n    for (int k=1; k < {n}; k++) begin\n      ge[k] = partial >= multiple[k][{bits-1}:0];\n      choices[k] = multiple[k][{w-1}:0];\n    end\n'''\n def tree(l,h,arr):\n    if l==h:return f'{b}\\\\'d{l}' if arr=='digit' else f'choices[{l}]'\n    m=(l+h+1)//2\n    return f'(ge[{m}] ? {tree(m,h,arr)} : {tree(l,m-1,arr)})'\n v+='    digit = '+tree(0,n-1,'digit')+';\\\\n'\n if onehot:\n    v+=\\\"    subtrahend = '0;\\\\n\\\"\n    for k in range(1,n):\n        cond=f'ge[{k}]' + (f' && \"'!ge[{k+1}]'\"' if k<n-1 else '')\n        v+=f'    subtrahend = subtrahend | (choices[{k}] & {{{w}{{{cond}}}}});\\\\n'\n else:\n    v+='    subtrahend = '+tree(0,n-1,'mul')+';\\\\n'\n v+=f'    {name} = {{digit, (partial[{w-1}:0] - subtrahend)}};\\\\n  endfunction'\n return v\nif 'comp' in name:\n a=s.index('  function automatic logic [35:0] wide_digit')\n b=s.index('  endfunction',a)+len('  endfunction')\n s=s[:a]+rc('wide_digit',32,4,'hot' in name)+s[b:]\nif 'fused' in name:\n # Register narrow complements in opening phase to reduce start delay for two serial digits\n for k in range(1,8):\n    needle='  function automatic logic [14:0] narrow_digit'\n    s=s.replace(needle,f\\\"  logic [15:0] negative{k}_q;\\\\n  always_ff @(posedge clock) if (phase_q == 1) negative{k}_q <= -(16'(wide_d[11:0]) * 16'd{k});\\\\n\\\"+needle)\n s=s.replace('    for (int k = 1; k < 8; k++)\\\\n      trial[k] = {1\\\\'b0,partial} - {1\\\\'b0,multiple[k][14:0]};','\\\\n'.join(f\\\"    trial[{k}] = {{1'b0,partial}} + negative{k}_q;\\\" for k in range(1,8)))\nif 'fold' in name:\n # Register a single unconsumed dividend: both width modes require same high bits on each digit round but different shift.\n s=s.replace('  always_ff @(posedge clock) begin\\\\n    if (div_issue) begin\\\\n      dividend_q', '''  logic [19:0] wide_tail_q;\n  logic [19:0] wide_answer_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd1) wide_tail_q <= dividend_q[19:0];\n    else wide_tail_q <= {wide_tail_q[15:0],4'b0};\n    wide_answer_q <= {wide_answer_q[15:0],wdigit};\n  end\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dividend_q''')\n s=s.replace('wide_quotient_q[31:28]','wide_tail_q[19:16]').replace('want_rem_q ? wide_rem_q : wide_quotient_q',\\\"want_rem_q ? wide_rem_q : {12'b0,wide_answer_q}\\\")\n # need declaration before use\n s=s.replace('  logic [19:0] wide_tail_q;\\\\n','').replace('  wire [3:0] wdigit;', '  logic [19:0] wide_tail_q;\\\\n  wire [3:0] wdigit;')\nf.write_text(s)\nPY\npython \\\"\"'$TMPDIR/div-research/compact.py\" comp && PYTHONPATH=. python \"$TMPDIR/div-research/timeit.py\" comp 1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
