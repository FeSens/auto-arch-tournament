{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 's=/srv/hwebench/tmp/800f6bc6/94704985/r5micro\nmkdir -p \"$s/orgunit\"\ncp -r cores/bench/test \"$s/orgunit/test\"\nln -s \"$s/organized\" \"$s/orgunit/rtl\"\ncat >> \"$s/orgunit/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def early_tag_priority_with_trap_and_wait(dut):\n    # Both rd tags match x5 at each ADD. The second ADD sees an annulled\n    # younger JAL while the first sees two live writers.\n    program = [\n        ADDI(5, 0, 1), ADDI(5, 0, 3), ADD(1, 5, 5),\n        ADDI(5, 0, 7), JAL(5, 2), ADD(2, 5, 5),\n        ADDI(5, 0, 19), SW(0, 0, 64), ADD(3, 5, 5),\n        EBREAK(),\n    ]\n    waits = []\n    def bus_ready(ia, da, ren, wen, wdata):\n        if wen and da == 64 and len(waits) < 4:\n            waits.append(ia)\n            return 1, 0\n        return 1, 1\n    trace, _ = await _run(dut, program, bus_ready=bus_ready)\n    assert len(trace) == len(program)\n    assert len(waits) == 4\n    assert trace[4]['trap'] and trace[4]['rd'] == 0\n    for i, expected in [(2, 3), (5, 7), (8, 19)]:\n        row = trace[i]\n        assert row['rs1_rdata'] == row['rs2_rdata'] == expected\n        assert row['rd_wdata'] == 2 * expected\n    assert [r['order'] for r in trace] == list(range(len(program)))\nPY\ncd \\\"\"'$s/orgunit\" && PYTHONDONTWRITEBYTECODE=1 pytest -q test/ > \"$s/orgunit.out\" 2>&1 && tail -3 \"$s/orgunit.out\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
