{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/hazard_unit.sv; rg -n 'stall|hazard|issue_|rs[12]_addr|div_wait' cores/bench/rtl/core.sv\"", "aggregated_output": "// rtl/hazard_unit.sv\n//\n// Loads and multiplies produce their result at the end of MEM. On a\n// source match, IF holds the PC and ID/EX inserts one bubble so the\n// consumer can forward from MEM/WB.\n// A redirect also discards the fetch on the edge the branch leaves EX.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,    // valid load or multiply in EX\n  input  logic [4:0] id_ex_rd,          // producer's destination\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       redirect,          // EX has resolved a branch/jump\n  input  logic       fence_i,           // valid FENCE.I in EX\n  input  logic       div_wait,          // DIV/REM occupies ID/EX\n  input  logic       fetch_valid,       // live bus word or loop replay hit\n  input  logic       dmem_ready,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       bubble_id,         // discard fetch when ID/EX advances\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic imem_stall;\n  logic dmem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_mem_read\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                   && (id_ex_rd != 5'b0);\n    imem_stall = !fetch_valid;\n    // dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n   \n…[1379 of 4451 chars elided by tools/bench/transcript.py; sha256:63d902a9c34512b1]…\nh || id_ex_w.ctrl.is_jump)\n109:  logic [4:0]  rs1_addr_w;\n110:  logic [4:0]  rs2_addr_w;\n121:    .stall           (stall_if),\n130:    .issue_valid     (id_ex_w.valid),\n131:    .issue_pc        (id_ex_w.pc[31:2]),\n132:    .issue_instr     (id_ex_w.instr),\n143:    .stall    (stall_id),\n146:    .rs1_addr (rs1_addr_w),\n147:    .rs2_addr (rs2_addr_w),\n156:    .rs1_addr (rs1_addr_w),\n157:    .rs2_addr (rs2_addr_w),\n169:    .stall           (stall_ex_mem),\n176:    .div_wait        (div_wait),\n206:  hazard_unit u_hazard (\n209:    .if_id_rs1      (rs1_addr_w),\n210:    .if_id_rs2      (rs2_addr_w),\n213:    .div_wait       (div_wait),\n217:    .stall_if       (stall_if),\n218:    .stall_id       (stall_id),\n220:    .stall_ex_mem   (stall_ex_mem),\n226:    .stall_id    (stall_id),\n227:    .if_id_rs1   (rs1_addr_w),\n228:    .if_id_rs2   (rs2_addr_w),\n232:    // A dmem stall clears WB valid but keeps the forwarding payload live.\n262:    io_rvfi_rs1_addr_0  = mem_wb_w.rs1_addr;\n264:    io_rvfi_rs2_addr_0  = mem_wb_w.rs2_addr;\n", "exit_code": 0, "status": "completed"}}
