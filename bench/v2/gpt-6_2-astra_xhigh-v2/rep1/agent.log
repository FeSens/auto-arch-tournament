{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"rg -n -A7 -B2 'test_jal|async def jal' cores/bench/test/test_decoder.py && cat cores/bench/rtl/ex_stage.sv | head -181\"", "aggregated_output": "208-# ── JAL / JALR / LUI / AUIPC ──────────────────────────────────────────────\n209-@cocotb.test()\n210:async def jal(dut):\n211-    # JAL x0, +4 = 0x0040006F\n212-    await _poke(dut, 0x0040006F)\n213-    assert int(dut.is_jump.value)    == 1\n214-    assert int(dut.reg_write.value)  == 1\n215-    assert int(dut.is_illegal.value) == 0\n216-\n217-\n218-@cocotb.test()\n219:async def jalr(dut):\n220-    # JALR x1, 0(x2) = 0x000100E7\n221-    await _poke(dut, 0x000100E7)\n222-    assert int(dut.is_jump.value)    == 1\n223-    assert int(dut.is_jalr.value)    == 1\n224-    assert int(dut.is_illegal.value) == 0\n225-\n226-\n227-@cocotb.test()\n228:async def jalr_nonzero_funct3_illegal(dut):\n229-    # JALR with any funct3 != 0 is reserved per spec.\n230-    for f3 in range(1, 8):\n231-        instr = (f3 << 12) | 0x000000E7  # rd=1 rs1=0 imm=0 funct3=f3 opcode=JALR\n232-        await _poke(dut, instr)\n233-        assert int(dut.is_illegal.value) == 1, (\n234-            f\"JALR funct3={f3} should be illegal (instr=0x{instr:08x})\"\n235-        )\n// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// Each source has independent EX/MEM (bit 0) and MEM/WB (bit 1) hits.\n// EX/MEM holds the younger writer and wins when both bits are set.\n//\n// Latency:        8 cycles for DIV/DIVU/REM/REMU, 1 cycle otherwise.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  input  logic [31:0]\n…[4237 of 7309 chars elided by tools/bench/transcript.py; sha256:49edfd972c5e6501]…\ngh : alu_result;\n      reg_q.mem_addr      <= base_plus_imm;\n      // Capture the operands while the forwarding sources are still live.\n      // These EX/MEM fields can hold them across the invalid divider slots.\n      if (!div_busy) begin\n        reg_q.write_data <= rs2;\n        reg_q.rs1_val    <= rs1;\n        reg_q.rs2_val    <= rs2;\n      end\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= actual_taken ? resolved_target : fallthrough;\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= direct_target;\n      reg_q.ctrl          <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
