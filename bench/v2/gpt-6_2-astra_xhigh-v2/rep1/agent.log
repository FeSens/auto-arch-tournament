d,\n  input  logic [31:2]       issue_pc,\n  input  logic [31:0]       issue_instr,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  logic [31:2] normal_pc, target_q, fallthrough_q;\n  logic use_target, use_fallthrough;\n  wire recovering = use_target || use_fallthrough;\n  wire [31:2] pc_word = ({30{!rec\n…[4876 of 7948 chars elided by tools/bench/transcript.py; sha256:f0c53cdac019e905]…\n2][35] ? pair01 : pair23)\n                                : (trial[6][35] ? pair45 : pair67);\n  endfunction\n\n  // Phases 2 through 6 each exchange six dividend bits for two digits.\n  logic [2:0] high_digit, low_digit;\n  logic [31:0] middle_rem, next_rem;\n  assign {high_digit, middle_rem} = radix8_digit({remainder_q, quotient_q[31:29]});\n  assign {low_digit, next_rem}    = radix8_digit({middle_rem, quotient_q[28:26]});\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      quotient_q  <= neg_a ? -a : a;\n      divisor_q   <= neg_b ? -b : b;\n      want_rem_q  <= want_rem;\n      // Subtracting zero sets every quotient bit and shifts the entire\n      // dividend magnitude into the remainder. Only REM restores its sign.\n      negate_q    <= want_rem ? neg_a : ((neg_a ^ neg_b) && b != 0);\n    end else if (phase_q == 3'd1) begin\n      triple_q    <= multiple[2] + multiple[1];\n      quintuple_q <= multiple[4] + multiple[1];\n      septuple_q  <= (multiple[1] << 3) - multiple[1];\n38.12 25.33 20.95 29/1052 7\n", "exit_code": 0, "status": "completed"}}
