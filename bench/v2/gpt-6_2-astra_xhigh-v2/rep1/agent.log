{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'ls -ld formal/riscv-formal && head -100 formal/checks_si.cfg && tail -50 formal/run_all.sh'","aggregated_output":"lrwxrwxrwx+ 1 nobody nogroup 68 Nov 19 17:05 formal/riscv-formal -> /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep1/formal/riscv-formal\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n# producing a misleading failure list of unbuilt directories).\nmake -j\"$JOBS\" -k -f makefile 2>&1 \\\n    | tee -a \"$LOG\" \\\n    | grep -E \"^(make|SBY|yosys|==|ERROR)\" || true\n\nshopt -s nullglob\nPASS=0; FAIL=0; FAILED=()\nfor sby_file in *.sby; do\n    name=\"${sby_file%.sby}\"\n    log=\"$name/logfile.txt\"\n    if grep -q \"DONE (PASS\" \"$log\" 2>/dev/null; then\n        PASS=$((PASS+1))\n    elif [[ \"$name\" == *_ch1 ]] && grep -q \"Status: PREUNSAT\" \"$log\" 2>/dev/null; then\n        # Vacuous pass on channel-1 checks. NRET=2 contract: when a\n        # single-issue hypothesis ties io_rvfi_valid_1 to 0, the per-channel\n        # BMC's assumption (rvfi_valid_1=1) is unsatisfiable, and SBY\n        # reports Status: PREUNSAT (rc=16). The property holds vacuously\n        # over the empty set of ch1-valid traces — a legitimate pass.\n        # Dual-issue hypotheses make the assumption satisfiable, so this\n        # branch never matches and the regular DONE (PASS branch covers it.\n        PASS=$((PASS+1))\n    else\n        FAIL=$((FAIL+1)); FAILED+=(\"$name\")\n    fi\ndone\nTOTAL=$((PASS+FAIL))\nif [ $TOTAL -eq 0 ]; then\n    FAIL=1\n    FAILED+=(\"no_checks_generated\")\nfi\n\necho \"\"\necho \"Formal: $PASS passed, $FAIL failed\"\nif [ $FAIL -gt 0 ]; then\n    echo \"Failed: ${FAILED[*]}\"\n    # Surface the FIRST failing check's logfile tail. tools/eval/formal.py\n    # captures this script's stdout/stderr into formal['detail'] and the\n    # orchestrator now records that in experiments/log.jsonl, so what we\n    # print here is what shows up as the diagnostic for the failed run.\n    first=\"${FAILED[0]}\"\n    if [ -f \"$first/logfile.txt\" ]; then\n        echo \"\"\n        echo \"--- $first/logfile.txt (last 30 lines) ---\"\n        tail -30 \"$first/logfile.txt\"\n    fi\n    echo \"\"\n    echo \"Full run log: $LOG\"\n    echo \"Per-check logs in: $CORE_DIR/checks/<check>/logfile.txt\"\nfi\n[ $FAIL -eq 0 ]\n","exit_code":0,"status":"completed"}}
