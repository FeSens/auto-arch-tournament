{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/800f6bc6/1fef7d78/r6micro.kJjowIv1/skid/test/test_pipeline.py')\ns=p.read_text().replace('    assert requests == [(16, 68, 15, 11)] * 4','    assert requests == [(16, 68, 15, 11)] + [(20, 68, 15, 11)] * 3').replace('    assert stalled_pcs == [40] * 4','    assert stalled_pcs == [44] * 4')\nloc=s.index('def test_pipeline_runner')\ns=s[:loc]+'''@cocotb.test()\nasync def buffered_load_consumer_during_instruction_wait(dut):\n    program = [LW(3, 0, 64), ADD(4, 3, 3), ADDI(5, 4, 1), EBREAK()]\n    waits = []\n    def ready(ia, da, ren, wen, wdata):\n        if ia == 8 and len(waits) < 3:\n            waits.append(ia)\n            return 0, 1\n        return 1, 1\n    rets, _ = await _run(dut, program, {64: 23}, bus_ready=ready)\n    assert len(waits) == 3\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 12]\n    assert rets[1][\\\"rd_wdata\\\"] == 46 and rets[2][\\\"rd_wdata\\\"] == 47\n    assert rets[1][\\\"cycle\\\"] == rets[0][\\\"cycle\\\"] + 2\n    assert rets[2][\\\"cycle\\\"] == rets[1][\\\"cycle\\\"] + 3\n\n@cocotb.test()\nasync def buffered_fallthrough_store_flushed_on_redirect(dut):\n    program = [LW(3, 0, 64), ADD(4, 3, 3), BEQ(3, 3, 8), SW(4, 0, 68), EBREAK()]\n    accepted = []\n    def ready(ia, da, ren, wen, wdata):\n        if wen:\n            accepted.append((da,wen,wdata))\n        return 1, 1\n    rets, _ = await _run(dut, program, {64: 23}, bus_ready=ready)\n    assert accepted == []\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 16]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(4))\n    assert rets[2][\\\"pc_next\\\"] == 16 and rets[1][\\\"rd_wdata\\\"] == 46\n\n\n'''+s[loc:]\np.write_text(s)\nPY\ncd '/srv/hwebench/tmp/800f6bc6/1fef7d78/r6micro.kJjowIv1/skid' && pytest --rootdir=. --confcutdir=. -q -p no:cacheprovider test/test_pipeline.py > new-tests.log