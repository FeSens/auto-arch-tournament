{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '490,850p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert dmem[64] == 3\n    loads = _by_insn(rets, LW(2, 0, 64))\n    increments = _by_insn(rets, ADDI(2, 2, 1))\n    assert [r[\"rd_wdata\"] for r in loads] == [0, 1, 2]\n    assert [(r[\"rs1_rdata\"], r[\"rd_wdata\"]) for r in increments] == [(0, 1), (1, 2), (2, 3)]\n    assert all(inc[\"cycle\"] == load[\"cycle\"] + 2 for load, inc in zip(loads, increments))\n    assert rets[-2][\"rd_wdata\"] == 4\n\n\n@cocotb.test()\nasync def replay_alias_and_missing_word(dut):\n    # The two loops use the same RAM slots across a bank boundary.\n    # Enter the second one via its exit and tail, leaving its head unfilled.\n    program = [NOP()] * (0x150 // 4 + 1)\n    for pc, instr in {\n        0: ADDI(1, 0, 2), 4: JAL(0, 0x3c - 4),\n        0x03c: ADDI(2, 2, 1), 0x040: ADDI(3, 3, 3), 0x044: BNE(2, 1, -8),\n        0x048: JAL(0, 0x100),\n        0x13c: ADDI(4, 4, 1), 0x140: ADDI(3, 3, 9), 0x144: BNE(4, 1, -8),\n        0x148: BEQ(4, 1, 8), 0x14c: JAL(0, -8), 0x150: EBREAK(),\n    }.items():\n        program[pc // 4] = instr\n    visits = {0x13c: 0, 0x140: 0}\n    exit_waits = 0\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal exit_waits\n        if ia in visits:\n            visits[ia] += 1\n            # 13c has the wrong tag. 140 has the right tag but its bit\n            # was cleared by replacement. Both must wait for cycle four.\n            if visits[ia] <= 4:\n                return visits[ia] == 4, 1\n            if ia == 0x140:\n                # The live word wins over the recorded +9 on a hit.\n                program[ia // 4] = ADDI(3, 3, 11)\n                return 1, 1\n            return 0, 1\n        if ia == 0x148 and visits[0x140] == 5 and exit_waits < 3:\n            # The fall-through was recorded on entry. The untaken exit\n            # must still wait for the