{"type": "item.completed", "item": {"id": "item_67", "type": "command_execution", "command": "/bin/bash -c \"cat formal/run_all.sh | head -165\nsed -n '88,135p' cores/bench/test/test_pipeline.py\npython - <<'PY'\nimport os\nprint(os.environ.get('RISCV_FORMAL_DIR'))\nPY\"", "aggregated_output": "#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env vars (orchestrator-driven, override $1 and defaults):\n#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n# When BOTH are unset, the script auto-detects nret from\n# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n# invoking `bash formal/run_all.sh` directly therefore get the\n# right wrapper without needing to know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[5708 of 8780 chars elided by tools/bench/transcript.py; sha256:2ce5ff8c19ff8bb9]…\n):\n            await RisingEdge(dut.clock)\n        dut.io_imemReady.value = 1\n    dut.io_imemData.value = fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        ren       = int(dut.io_dmemREn.value)\n        wen       = int(dut.io_dmemWEn.value)\n        wdata     = int(dut.io_dmemWData.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        request = (da, ren, wen, wdata)\n        if held_request is not None:\n            assert request == held_request, \"dmem request changed before acceptance\"\n        iready, dready = bus_ready(ia, *request) if bus_ready else (1, 1)\n        dut.io_imemReady.value = iready\n        dut.io_dmemReady.value = dready\n        held_request = request if (ren or wen) and not dready else None\n\n        if wen and dready:\n            wa = da & ~3\nNone\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r8read.py\" <<'\"'PY'\nfrom r8scratch import rtl\nfrom pathlib import Path\nimport sys,subprocess\nname,n,variant=sys.argv[1:]\nsubprocess.run([sys.executable,str(Path(__file__).with_name('r8ram.py')),name,n,'packedsmall'],check=True)\nn=int(n); i=n.bit_length()\np=rtl(name)/'if_stage.sv'\ns=p.read_text()\ns=s.replace('use_target ? target_resident : \"'!use_fallthrough && norm_resident'\"','(use_target && target_resident) || (\"'!recovering && norm_resident)'\"')\ns=s.replace('imem_ready ? imem_data : (use_target ? target_row[31:0] : norm_row[31:0])', \n   '({32{imem_ready}} & imem_data) | ({32{\"'!imem_ready && use_target}} & target_row[31:0]) | ({32{!imem_ready && !recovering}} & norm_row[31:0])'\"')\nif variant=='valid':\n # Decompose the single word-valid predicate into two half-selects, paired as a per-sector array.\n s=s.replace(f'logic [{n-1}:0] present;',f'logic [15:0] present [0:{n//16-1}];')\n a=s.index('    if (reset || fence_i) present'); b=s.index('  wire [',a)\n s=s[:a]+f'''  end\n  for (genvar k = 0; k < {n//16}; k++) begin : gen_presence\n    always_ff @(posedge clock) begin\n      if (reset || fence_i) present[k] <= '0;\n      else if (issue_valid && issue_pc[31:20] == 0 && issue_pc[{i}:6] == k)\n        present[k][issue_pc[5:2]] <= 1'b1;\n    end\n  end\n'''+s[b:]\n for a in ('normal_pc','target_q'):\n  s=s.replace(f'present[{a}[{i}:2]]',f'present[{a}[{i}:6]][{a}[5:2]]')\nif variant=='slicetag':\n # Physically separate the small tag RAM from the 32-bit data. Both reads use registered addresses.\n a=s.index('  (* syn_ramstyle = \\\"block_ram\\\" *)',s.index('  assign predict_taken ='))\n b=s.index('  logic [',a)\n s=s[:a]+f'''  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] words [0:{n-1}];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [19:{i+1}] word_tag [0:{n-1}];\n'''+s[b:]\n s=s.replace(f'words[issue_pc[{i}:2]] <= {{issu