{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/mshare/bip.py\" <<'\"'PY'\nfrom math import log2,ceil\ndef best(e,limit=7.9,halfbits=0):\n H=1<<(32-halfbits);D=1<<e\n best=None\n for k in range(e+1):\n  w=1<<k; n=1<<(e-k)\n  for g in range(k,e+1):\n   G=1<<g\n   for s in range(k+1):\n    delta=1<<s\n    err=H*(w-1)**2/D**3+H*(w-1)*(1/D**2-1/(D+G-w)**2)+H*(delta-1)/D**2+2\n    good=err<limit\n    single=s==k\n    if single: good= (H*(w-1)/D**2+1 < limit)\n    if not good:continue\n    n2=0 if single else 1<<(e-g+k-s)\n    deltaw=0 if single else max(1, (int(H*(w-1)/D**2)).bit_length())\n    cost=n*max(1,32-halfbits-e+1)+n2*deltaw\n    candidate=(cost,k,g,s,n,n2,deltaw)\n    if best is None or best>candidate: best=candidate\n return best\nif __name__=='__main__':\n for halfbits in [0,3]:\n  bs=[best(e,7,halfbits) for e in range(1,32)]\n  print(halfbits, sum(x[0] for x in bs),sum(x[4] for x in bs),sum(x[5] for x in bs));print(bs)\nPY\npython \\\"\"'$TMPDIR/mshare/bip.py\"\ntail -4 \"$TMPDIR/mshare/pnrv2_1/gw.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
