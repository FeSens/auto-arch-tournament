visits:\n            visits[ia] += 1\n            # Both cold words must wait for the fourth bus cycle.\n            if visits[ia] <= 4:\n                return visits[ia] == 4, 1\n            if ia == 0x140:\n                # The live word wins over the recorded +9 on a hit.\n                progra\n…[10831 of 13903 chars elided by tools/bench/transcript.py; sha256:ed45b84f76c53758]…\n1056),\n    }.items():\n        program[pc // 4] = insn\n    fetches = []\n\n    def ready(ia, da, ren, wen, wdata):\n        assert not wen\n        fetches.append(ia)\n        return 1, 1\n\n    rets, _ = await _run(dut, program, bus_ready=ready, initial_imem_wait=260)\n    _check_loop_path(rets, [0, 4, 8, 32, 36, 1028, 1032, 1056, 4, 8, 32, 44])\n    assert [b for a, b in zip(fetches, fetches[1:]) if a in (8, 1032)] == [12, 1036, 12]\n\n\n@cocotb.test()\n@cocotb.parametrize(replacement=[ADDI(5, 5, 1), 0x0000100f])\nasync def stale_taken_prediction_on_live_nonbranch(dut, replacement):\n    program = [ADDI(2, 0, 7), JAL(5, 20), SW(5, 0, 68), EBREAK(),\n               NOP(), NOP(), SW(2, 0, 64), JAL(0, -28)]\n    fetches, stores = [], []\n\n    def ready(ia, da, ren, wen, wdata):\n        if ia == 4 and stores:\n            program[1] = replacement\n        if wen:\n            stores.append((da, wen, wdata))\n        fetches.append(ia)\n        return 1, 1\n\n    rets, _ = await _run(dut, program, bus_ready=ready, initial_imem_wait=260)\n", "exit_code": 0, "status": "completed"}}
