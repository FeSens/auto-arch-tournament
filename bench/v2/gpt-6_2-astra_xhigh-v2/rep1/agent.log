{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// A tagged word and its successor share a row. The registered normal PC\n// and taken-recovery PC address the RAM in parallel with path selection.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              recover_target,\n  input  logic              recover_fallthrough,\n  input  logic              taken,\n  input  logic [31:0]       target,\n  input  logic              train,\n  input  logic              conditional,\n  input  logic              eligible_jump,\n  input  logic              counter_hit,\n  input  logic [1:0]        old_counter,\n  input  logic              fence_i,\n  input  logic [31:2]       issue_pc,\n  input  logic [31:0]       issue_instr,\n  input  logic [4:0]        producer_rd,\n  output logic              depends_on_rd,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t            out\n);\n\n  logic [31:2] normal_pc, target_q, fallthrough_q;\n  logic use_target, use_fallthrough;\n  wire recovering = use_target || use_fallthrough;\n  wire [31:2] pc_word = ({30{!recovering}} & normal_pc)\n                      | ({30{use_target}} & target_q)\n                      | ({30{use_fallthrough}} & fallthrough_q);\n  wire [31:2] next_word = pc_word + 1'b1;\n\n  typedef struct packed {\n    logic [1:0]  counter;\n    logic [19:2] target;\n    logic        valid;\n    logic [19:12] tag;\n    logic [31:0] instr;\n  } row_t;\n  row_t normal_row;\n  // Only the instruction and its tag are read on taken recovery.\n  /* verilator lint_off UNUSEDSIGNAL */\n  row_t target_row;\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  logic clearing, write_pending;\n  logic [9:0] clear_index, write_index;\n  logic [19:12] write_t