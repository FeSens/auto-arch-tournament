{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/predictor\" && cat table16/if_stage.sv && date -u'","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Decode sees the raw memory word while EX resolves a branch. ID/EX\n// records whether the word was ready and survived a redirect or replay.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              train,\n  input  logic [3:0]        train_index,\n  input  logic [1:0]        train_count,\n  input  logic              train_agree,\n  output logic              predicted_taken,\n  output logic [31:0]       direct_q,\n  output logic [31:0]       fallthrough_q,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  logic [31:0] pc, displacement, direct_target;\n  logic [31:0] recovery_q;\n  logic use_recovery;\n  logic is_jal, is_branch, take;\n  logic [3:0] index;\n  logic [4:0] init_q;\n  (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] ctr [0:15];\n  logic [1:0] count;\n  logic pending, agree_q;\n  logic [3:0] wr_index;\n  logic [1:0] last_count;\n\n  assign index = pc[5:2] ^ pc[9:6];\n  assign count = init_q[4] ? ctr[index] : 2'd2;\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] != 2'b01;\n  assign displacement = imem_data[3] ?\n      {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0} :\n      {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign direct_target = pc + displacement;\n  assign take = (is_jal || (is_branch && (imem_data[31] == count[1]))) &&\n                direct_target[31:20] == 0 && direct_target[1:0] == 0;\n\n  always_ff @(posedge clock) begin\n    pending <= !reset && train;\n    wr_index <= train_index;\n    last_count <= train_count;\n    agree_q <= train_agree;\n    if (reset) init_q <= '0;\n    else if (!init_q[4]) init_q <= init_q + 1'b1;\n    if (!init_q[4] || pending)\n      ctr[init_q[4] ? wr_index : init_q[3:0]] <= !init_q[4] ? 2'd2 : agree_q ? ((last_count == 3) ? 2'd3 : last_count + 2'd1) :\n                                 ((last_count == 0) ? 2'd0 : last_count - 2'd1);\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      use_recovery <= 1'b1;\n      recovery_q <= 0;\n    end else begin\n      if (redirect) use_recovery <= 1'b1;\n      else if (!stall) use_recovery <= 1'b0;\n      if (!use_recovery) recovery_q <= redirect_target;\n    end\n    if (!stall) begin\n      direct_q <= direct_target;\n      fallthrough_q <= pc + 32'd4;\n      predicted_taken <= take;\n    end\n  end\n  assign pc = use_recovery ? recovery_q : predicted_taken ? direct_q : fallthrough_q;\n  assign imem_addr = pc;\n  assign out.pc = pc;\n  assign out.instr = imem_data;\n  assign out.count = count;\n  assign out.valid = imem_ready;\nendmodule\nThu Nov 19 16:39:31 UTC 2026\n","exit_code":0,"status":"completed"}}
