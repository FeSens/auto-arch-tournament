{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/rtl/if_stage.sv && rg -n 'core_pkg|include' cores/bench/rtl/*.sv && ls -al bench/programs/coremark\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n\n  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid = !(flush || redirect);\n  end\n\nendmodule\ncores/bench/rtl/core_pkg.sv:1:// rtl/core_pkg.sv\ncores/bench/rtl/core_pkg.sv:13:// includes hit the guard and become no-ops.\ntotal 248\ndrwxrwx---+ 14 nobody nogroup  4096 Nov 19 15:10 .\ndrwxrwx---+  3 nobody nogroup  4096 Nov 19 15:10 ..\ndrwxrwx---+  3 nobody nogroup  4096 Nov 19 15:10 .github\n-rw-rw----+  1 nobody nogroup 18582 Nov 19 15:10 LICENSE.md\n-rw-rw----+  1 nobody nogroup  3584 Nov 19 15:10 Makefile\n-rw-rw----+  1 nobody nogroup 19687 Nov 19 15:10 README.md\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 barebones\n-rw-rw----+  1 nobody nogroup  9745 Nov 19 15:10 barebones_porting.md\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 baremetal\n-rw-rw----+  1 nobody nogroup 18225 Nov 19 15:10 core_list_join.c\n-rw-rw----+  1 nobody nogroup 15788 Nov 19 15:10 core_main.c\n-rw-rw----+  1 nobody nogroup  9598 Nov 19 15:10 core_matrix.c\n-rw-rw----+  1 nobody nogroup  9707 Nov 19 15:10 core_state.c\n-rw-rw----+  1 nobody nogroup  6004 Nov 19 15:10 core_util.c\n-rw-rw----+  1 nobody nogroup  4760 Nov 19 15:10 coremark.h\n-rw-rw----+  1 nobody nogroup   283 Nov 19 15:10 coremark.md5\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 cygwin\ndrwxrwx---+  3 nobody nogroup  4096 Nov 19 15:10 docs\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 freebsd\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 linux\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 macos\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 posix\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 rtems\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 simple\ndrwxrwx---+  2 nobody nogroup  4096 Nov 19 15:10 zephyr\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"ls -la cores/bench && cat cores/bench/test/_helpers.py && cat formal/checks_si.cfg && env | rg '\"'^(CORE_NAME|RTL_DIR|GOWIN|GW_|EDA|SBY|RISCV)'\"'\"", "aggregated_output": "total 44\ndrwxrwx---+ 5 nobody nogroup 4096 Nov 19 15:10 .\ndrwxrwx---+ 3 nobody nogroup 4096 Nov 19 15:10 ..\n-rw-rw----+ 1 nobody nogroup    0 Nov 19 15:10 CORE_PHILOSOPHY.md\n-rw-rw----+ 1 nobody nogroup  545 Nov 19 15:10 core.yaml\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 19 15:10 experiments\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 19 15:10 rtl\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 19 15:10 test\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\nGOWIN_HOME=/opt/gowin\n", "exit_code": 0, "status": "completed"}}
