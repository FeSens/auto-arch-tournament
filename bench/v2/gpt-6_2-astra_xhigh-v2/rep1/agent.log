{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/quotient/verify.py\" <<'\"'PY'\nimport os,sys,subprocess,json\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tools.eval.fpga import validate_coremark_uart\nfrom xml.etree import ElementTree as ET\nroot=Path(os.environ['TMPDIR'])/'quotient'\nvariant=sys.argv[1]\no=root/f'check_{variant}'\ncopytree(root/variant,o/'rtl',dirs_exist_ok=True)\ncopytree(Path('cores/bench/test'),o/'test',dirs_exist_ok=True)\np=o/'test/test_alu.py';s=p.read_text()\ns+=\\\"\\\"\\\"\n\n@cocotb.test()\nasync def reciprocal_prefix_edges(dut):\n    await _setup(dut)\n    random_cases = random.Random(8177)\n    for bit in range(32):\n        power = 1 << bit\n        for d in [max(0, power-1), power, min(power+1,MASK32), min(power+3,MASK32), min(power+129,MASK32), min(power+4097,MASK32), random_cases.randint(power,min(MASK32,2*power-1))]:\n            for a in [MASK32, min(MASK32,0x80000000//max(d,1)*d+1), (MASK32//max(d,1))*d, random_cases.getrandbits(32)]:\n                for op in [ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU]:\n                    numerator=a\n                    denominator=d\n                    if op in [ALU_DIV,ALU_REM]:\n                        numerator = a if a < (1<<31) else a-(1<<32)\n                        denominator = d if d < (1<<31) else d-(1<<32)\n                    if denominator:\n                        q=(abs(numerator)//abs(denominator)) * (-1 if (numerator<0) \"'!= (denominator<0) else 1)\n                        rem=numerator-q*denominator\n                    else:\n                        q,rem=-1,numerator\n                    expected=q if op in [ALU_DIV,ALU_DIVU] else rem\n                    await _check_div(dut,op,a,d,expected)\n\"\"\"\np.write_text(s)\nwith (o/'\"'tests.log').open('w') as log:\n p=subprocess.run(['pytest','--rootdir',str(o),'--confcutdir',str(o),'-q',str(o/'test/test_alu.py'),str(o/'test/test_pipeline.py')],stdout=log,stderr=subprocess.STDOUT)\nprint('returncode',p.returncode,flush=True)\nfor xml in (o/'test').glob('*.xml'):\n tree=ET.parse(xml)\n print(xml.name,len(list(tree.iter('testcase'))),'cases,',len(list(tree.iter('failure'))),'failed',flush=True)\nwith (o/'build.log').open('w') as log:\n subprocess.run(['bash','test/cosim/build.sh'],env=dict(os.environ,NRET='1',RTL_DIR=str(o/'rtl'),OBJ_DIR=str(o/'obj')),stdout=log,stderr=subprocess.STDOUT,check=True)\np=subprocess.run([str(o/'obj/cosim_sim'),str(root/'bench/programs/coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True)\nm=json.loads(p.stdout.splitlines()[-1]);print('CoreMark',m['bench_stop_cycle']-m['bench_start_cycle'],validate_coremark_uart(m['uart'],10),m['ebreak'],m['oob'],flush=True)\nPY\ndate -u; tail -1 \\\"\"'$TMPDIR/quotient/builddirectmem1/gw.log\"; head -1 \"$TMPDIR/quotient/buildmemnorm1/impl/pnr/core_bench.tr\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
