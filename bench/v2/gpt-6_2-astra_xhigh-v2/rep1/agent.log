{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py && sed -n '1,225p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 \n…[7805 of 10877 chars elided by tools/bench/transcript.py; sha256:04addf41597983dc]…\n= _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def youngest_writer_on_both_ports(dut):\n    program = [ADDI(17, 0, 9), ADDI(17, 0, 23), ADD(3, 17, 17), EBREAK()]\n    rets, _ = await _run(dut, program)\n    assert [r[\"insn\"] for r in rets] == program\n    older, younger, consumer, _ = rets\n    assert (older[\"rd_wdata\"], younger[\"rd_wdata\"]) == (9, 23)\n    assert younger[\"cycle\"] == older[\"cycle\"] + 1\n    assert consumer[\"cycle\"] == younger[\"cycle\"] + 1\n    assert (consumer[\"rs1_rdata\"], consumer[\"rs2_rdata\"], consumer[\"rd_wdata\"]) == (23, 23, 46)\n\n\n@cocotb.test()\nasync def wb_forward_behind_stalled_store(dut):\n    program = [\n        ADDI(20, 0, 11),\n        ADDI(4, 0, 37),\n        SW(20, 0, 68),   # instr[11:7] aliases x4. The store cannot forward.\n        ADD(7, 20, 4),   # Captured x20, forwarded x4 from the held WB payload.\n        EBREAK(),\n    ]\n    requests = []\n\n    def ready(ia, da, ren, wen, wdata):\n        if wen:\n            requests.append((ia, da, wen, wdata))\n", "exit_code": 0, "status": "completed"}}
