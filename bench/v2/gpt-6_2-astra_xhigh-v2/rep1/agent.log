{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom fractions import Fraction as F\nH = 1 << 32\nks = [0,1,3,4,5,6,8,9,10,11,13,14,15,17,18,19,20,22,23,24,26,27,29,30,31]\ncells = [(d,d) for sign in range(2) for x in range(128) if (d:=x+sign) >= 2]\nfor e,k in enumerate(ks,7):\n    cells.extend((l, l+(1<<k)) for l in range(1<<e, 2<<e, 1<<k))\nworst = F(0)\nfor d,upper in cells:\n    m=H//upper\n    f=1-F(d*m,H)\n    bound=F(H,d)*f**4+(2+f)*(1+f*f)/8+F(1,d)\n    assert m>0 and 0<=f<1 and upper*m<=H and bound<1\n    if bound>worst: worst,at=bound,d\nprint('physical words',len(cells)+3,'max bound',worst,float(worst),'at D',at)\nprint([e-k for e,k in enumerate(ks,7)])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
