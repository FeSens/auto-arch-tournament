in : init_rom\n    initial begin\n      for (int i=0; i<1024; i++) begin\n        if (bank == 0)\n          intercept[i] = 32'(64'h1_0000_0000 / (64'(i)+1));\n        else begin\n          intercept[1024+i] = 32'(64'h4_0000_0000 / (64'(i)+1025));\n          slope[i] = 14'(64'h4_0000_0000 / ((64'(i)+1025)*(64'(i)+1025)));\n        end\n      end\n    end\n  end\n\n  logic [31:0] intercept_q, affine_q, factor_q, quotient_q;\n  logic [13:0] slope_q;\n  logic [11:0] fraction_q;\n  logic [4:0] scale_q, scale_qq;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [25:0] adjustment;\n  logic [63:0] product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign adjustment = slope_q * fraction_q;\n  assign product = quotient_q * factor_q;\n  always_ff @(posedge clock) begin\n    intercept_q <= intercept[index];\n    slope_q <= slope[index[9:0]];\n    fraction_q <= fraction;\n    scale_q <= shift + (index[10] ? 5'd2 : 5'd0);\n    if (phase_q == 2) begin\n      affine_q <= intercept_q + {18'b0, adjustment[25:12]};\n      scale_qq <= scale_q;\n    end\n    if (phase_q == 3) begin\n      factor_q <= (affine_q >> scale_qq) + 1'b1;\n      quotient_q <= dividend_q;\n    end else if (phase_q == 4) begin\n      factor_q <= divisor_q;\n      quotient_q <= product[63:32];\n    end\n  end\n\n  logic [32:0] residual_q;\n  always_ff @(posedge clock)\n    if (phase_q == 5) residual_q <= {1'b0, dividend_q} - product[32:0];\n\n  logic [31:0] correct_data;\n  logic above, below;\n  assign above = residual_q[32];\n  assign below = \"'!above && residual_q[31:0] >= divisor_q;\n  always_comb begin\n    if (zero_q || unit_q)\n      correct_data = (want_rem_q ? zero_q : unit_q) ? dividend_q :\n                     (want_rem_q ? 32'\"'d0 : 32'hffff_ffff);\n    else if (want_rem_q)\n      correct_data = above ? residual_q[31:0]+divisor_q :\n                     below ? residual_q[31:0]-divisor_q : residual_q[31:0];\n    else\n      correct_data = above ? quotient_q-1'b1 : below ? quotient_q+1'b1 : quotien