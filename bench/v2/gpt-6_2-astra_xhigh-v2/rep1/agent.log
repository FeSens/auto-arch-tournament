002-r2s1 (improvement, +14.16%): Registering 3D, 5D and 7D during the two-bit opening round let each later round resolve six quotient bits in two radix-8 stages of parallel trial subtraction and selection, raising median Gowin Fmax from 43.1 to 49.2 MHz at the same CoreMark cycle count.\n- 2026-11-19 hy\n…[10126 of 13198 chars elided by tools/bench/transcript.py; sha256:dfbd2c1814e825fa]…\n\ntools/agents/random_agent.py\ntools/agents/sandbox_probe.py\ntools/agents/scribe.py\ntools/agents/static_agent.py\ntools/agents/test_agent_scope_live.py\ntools/agents/test_hypothesis.py\ntools/agents/test_hypothesis_workspace.py\ntools/agents/test_quota.py\ntools/agents/test_random_agent.py\ntools/agents/test_scribe.py\ntools/agents/test_static_agent.py\ntools/eval/__init__.py\ntools/eval/_slots.py\ntools/eval/_subprocess.py\ntools/eval/cosim.py\ntools/eval/formal.py\ntools/eval/fpga.py\ntools/eval/gowin.py\ntools/eval/holdout.py\ntools/eval/rvfi_lint.py\ntools/eval/test_bench_stall_gen.py\ntools/eval/test_formal_nret.py\ntools/eval/test_formal_reclassify.py\ntools/eval/test_formal_workdir_cleanup.py\ntools/eval/test_fpga_report.py\ntools/eval/test_gate_sanity.py\ntools/eval/test_holdout.py\ntools/eval/test_process_reaper.py\ntools/eval/test_remove_path.py\ntools/eval/test_rvfi_lint.py\ntools/eval/test_slots.py\ntools/eval/test_subprocess_pgroup.py\ntools/orchestrator.py\ntools/plot.py\ntools/sandbox.py\ntools/tournament.py\ntools/worktree.py\n", "exit_code": 0, "status": "completed"}}
