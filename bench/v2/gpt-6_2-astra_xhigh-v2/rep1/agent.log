{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"rg -n 'failed|AssertionError|assert [0-9]|Traceback' \\\"\"'$TMPDIR/quotient/check_later/tests.log\" | tail -16; sed -n '\"'702,777p' cores/bench/test/test_pipeline.py; rg -n 'ERROR' \\\"\"'$TMPDIR/quotient/buildnegtree1/gw.log\" \"$TMPDIR/quotient/buildonehot1/gw.log\" | head'","aggregated_output":"132: 67461.02ns WARNING  ..ependent_divides_with_bus_stalls assert 24 == (15 + 8)\n133:                                                        Traceback (most recent call last):\n136:                                                        AssertionError: assert 24 == (15 + 8)\n137: 67461.02ns WARNING  cocotb.regression                  test_pipeline.dependent_divides_with_bus_stalls failed\n301:1 failed, 1 passed in 13.18s\n    assert gaps == [1, 1, 1, 2, 2, 1 + len(stalled_pcs), 1, 1]\n\n\n@cocotb.test()\nasync def dependent_divides_with_bus_stalls(dut):\n    dividend = 0xffffff8c  # -116\n    quotient = 0xfffffff0  # -16\n    remainder = 0xfffffffe  # -2\n    program = [\n        ADDI(2, 0, 7),\n        LW(1, 0, 64),\n        DIV(3, 1, 2),\n        REM(4, 3, 2),\n        SW(4, 0, 68),\n        DIV(5, 1, 4),\n        EBREAK(),\n    ]\n    accepted = []\n    load_waits, store_waits, fetch_waits = 3, 5, 15\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal load_waits, store_waits, fetch_waits\n        # Withhold EBREAK across both the stalled store and the final DIV.\n        iready = 1\n        if ia == 24 and fetch_waits:\n            fetch_waits -= 1\n            iready = 0\n        if ren and load_waits:\n            load_waits -= 1\n            return iready, 0\n        if wen and store_waits:\n            store_waits -= 1\n            return iready, 0\n        if ren or wen:\n            accepted.append((da, ren, wen, wdata if wen else 0))\n        return iready, 1\n\n    rets, dmem = await _run(dut, program, {64: dividend}, bus_ready=ready)\n    assert load_waits == store_waits == fetch_waits == 0\n    assert accepted == [(64, 1, 0, 0), (68, 0, 15, remainder)]\n    assert dmem[68] == remainder\n    assert [r[\"insn\"] for r in rets] == program\n    for i, r in enumerate(rets):\n        assert (r[\"order\"], r[\"pc\"], r[\"pc_next\"], r[\"trap\"]) == (i, 4 * i, 4 * i + 4, 0)\n    for i, fields in [\n        (2, (1, dividend, 2, 7, 3, quotient)),\n        (3, (3, quotient, 2, 7, 4, remainder)),\n        (4, (0, 0, 4, remainder, 0, 0)),\n        (5, (1, dividend, 4, remainder, 5, 58)),\n    ]:\n        r = rets[i]\n        assert (r[\"rs1_addr\"], r[\"rs1_rdata\"], r[\"rs2_addr\"], r[\"rs2_rdata\"],\n                r[\"rd\"], r[\"rd_wdata\"]) == fields\n    store = rets[4]\n    assert (store[\"mem_addr\"], store[\"mem_wmask\"], store[\"mem_wdata\"]) == (68, 15, remainder)\n    assert rets[3][\"cycle\"] == rets[2][\"cycle\"] + 8\n    assert store[\"cycle\"] == rets[3][\"cycle\"] + 1 + 5\n    # The final DIV can issue on the edge accepting the older store.\n    assert rets[5][\"cycle\"] == store[\"cycle\"] + 8\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n","exit_code":0,"status":"completed"}}
