{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nd = [(int(p,16)>>2,int(t),int(hit),int(pred)) for _,p,t,pred,hit in (s.split() for s in (Path(os.environ['TMPDIR'])/'baseline-misses.log').read_text().splitlines() if s.startswith('B '))]\ndef run(h,s,l,tagbits):\n    pm=(1<<s)-1; hm=(1<<h)-1; lm=(1<<l)-1; tm=(1<<tagbits)-1\n    prev=[0]*(lm+1); pat=[1]*(2<<s); tags=[-1]*(2<<s); saved=[1]*16384; err=0\n    for pc,t,hit,orig in d:\n        lh=pc&lm\n        a = prev[lh]\n        b=((a<<1)|t)&hm\n        mix=pc\"'^(pc>>s)\n        old=(((a>>1)''^(a>>(s+1))''^(a>>(s+s+1))''^mix)&pm)*2+(a&1)\n        new=(((b>>1)''^(b>>(s+1))''^(b>>(s+s+1))''^mix)&pm)*2+t\n        v=saved[pc]\n        err += t!=(v>>1 if hit and v in (0,3) else orig)\n        tag=pc&tm\n        saved[pc]=pat[new] if tags[new]==tag else 1\n        p=pat[old]\n        pat[old]=(1+t if tags[old]!=tag else (min(3,p+1) if t else max(0,p-1)))\n        tags[old]=tag\n        prev[lh]=b\n    return err\nfor s,l in [(10,10),(8,7),(9,8),(7,6)]:\n for h in (9,11,13,16,18,22,26,32):\n    print(s,l,h,run(h,s,l,4),flush=True)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
