c\"] == 8] == [(0, 0), (1, 0)]\n    assert [b for a, b in zip(fetches, fetches[1:]) if a == 8] == [12, 28]\n\n\n@cocotb.test()\nasync def live_deferred_branch_changes_target(dut):\n    old, replacement = BEQ(1, 1, 20), BEQ(1, 1, 28)\n    program = [\n        LW(1, 0, 64), old, SW(0, 0, 80), EBREAK(), NOP(), NOP(),\n        SW(1, 0, 68), JAL(0, -28), SW(1, 0, 72), EBREAK(),\n    ]\n    requests, fetches = [], []\n    waits = 3\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal waits\n        if ren or wen:\n            requests.append((da, ren, wen, wdata if wen else 0))\n        if ia == 4 and len(requests) >= 2:\n            program[1] = replacement\n        fetches.append(ia)\n        if ia == 32 and program[1] == replacement and waits:\n            waits -= 1\n            return 0, 1\n        return 1, 1\n\n    rets, _ = await _run(dut, program, {64: 17}, bus_ready=ready, initial_imem_wait=SWEEP_CYCLES)\n    _check_loop_path(rets, [0, 4, 24, 28, 0, 4, 32, 36])\n    assert requests == [(64, 1, 0, 0), (68, 0, 15, 17), (64, 1, 0, 0), (72, 0, 15, 17)]\n    assert [b for a, b in zip(fetches, fetches[1:]) if a == 4] == [8, 24]\n......                                                                   [100%]\n6 passed in 39.41s\npython3 -m tools.eval.cosim . bench\n{\n  \"passed\": true,\n  \"elfs_tested\": 5\n}\n","exit_code":0,"status":"completed"}}
