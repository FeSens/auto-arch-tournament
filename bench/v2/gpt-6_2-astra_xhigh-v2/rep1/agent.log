{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/btb-eval\" && cat >> cores/bench/test/test_pipeline.py <<'\"'PY'\n\n\n@cocotb.test()\nasync def warm_target_replaced_across_fence_i(dut):\n    base = 1040\n    new_word = ADDI(5, 0, 7)\n    program = [NOP()] * 259 + [LW(4, 0, 96)] + [\n        JAL(6,16), SW(5,0,64), EBREAK(), NOP(),\n        ADDI(2,2,1), ADDI(3,0,3), BNE(2,3,-24),\n        SW(4,0,base), 0x0000100f, JAL(0,-40),\n    ]\n    patch_waits = 2\n    fetch_waits = 2\n    patched = False\n    seen = []\n    stores = []\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal patch_waits, fetch_waits, patched\n        if wen and da == base:\n            if patch_waits:\n                patch_waits -= 1\n                return 1,0\n            program[base//4] = wdata\n            patched = True\n        if wen:\n            stores.append((da,wen,wdata))\n        if patched:\n            seen.append(ia)\n            if ia == base and fetch_waits:\n                fetch_waits -= 1\n                return 0,1\n        return 1,1\n    rets, _ = await _run(dut, program, {96:new_word}, max_cycles=360, bus_ready=ready)\n    loop = [base+x for x in (0,16,20,24)]\n    pcs = list(range(0,base,4)) + loop * 3 + [base+x for x in (28,32,36,-4,0,4,8)]\n    _check_loop_path(rets, pcs)\n    assert stores == [(base,15,new_word),(64,15,7)]\n    assert fetch_waits == 0 and patch_waits == 0\n    assert base+16 not in seen\n    assert [r['insn'] for r in rets if r['pc'] == base] == [JAL(6,16)]*3 + [new_word]\nPY\npytest -q cores/bench/test/test_pipeline.py >fence-directed.log 2>&1 && tail -n 3 fence-directed.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
