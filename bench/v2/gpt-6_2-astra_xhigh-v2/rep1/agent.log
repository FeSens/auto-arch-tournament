{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/newton/gold.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\nbase=Path(os.environ['TMPDIR'])/'newton'\nname=sys.argv[1]; flags=sys.argv[2:]\nrtl=base/name/'rtl'\nshutil.copytree(base/'v1/rtl',rtl,dirs_exist_ok=True)\nf=rtl/'alu.sv';src=f.read_text()\ni=src.index('  logic [31:0] m0_q');j=src.index('  always_ff',src.index('  wire [31:0] quotient_val',i))\npre='''\n  logic [31:0] seed_q, err_q, q0_q, inc_q, product_q, est_q, magnitude_q;\n  wire [31:0] dvs_neg = ~(index_input);\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd2) seed_q <= m0;\n  end\n'''\nproducts='''\n  wire [63:0] initial_q_product = dvd_q * seed_q;\n  wire [63:0] q_inc_product = q0_q * err_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd3) begin\n      err_q <= dvs_neg * seed_q;\n      q0_q <= initial_q_product[63:32];\n    end\n    if (phase_q == 3'd4) inc_q <= q_inc_product[63:32];\n  end\n'''\nif 'sharehi' in flags:\n products='''\n  wire [63:0] hi_product = (phase_q == 3'd3 ? seed_q : err_q) *\n                           (phase_q == 3'd3 ? dvd_q : q0_q);\n  logic [31:0] hi_reg;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd3) err_q <= dvs_neg * seed_q;\n    if (phase_q == 3'd3 || phase_q == 3'd4) hi_reg <= hi_product[63:32];\n    if (phase_q == 3'd4) q0_q <= hi_reg;\n  end\n  assign inc_q = hi_reg;\n'''.replace(\\\"dvd_q : q0_q\\\",\\\"dvd_q : hi_reg\\\").replace('  logic [31:0] hi_reg;','')\n pre+='  logic [31:0] hi_reg;\\\\n'\nif 'truncate' in flags:\n # Phase 3 seed error can need a correction even with exact small-divisor reciprocal.\n # For small D exact floor seed is already sufficient; set their E to zero for purposes of estimate.\n products=products.replace('dvs_neg * seed_q','dvs_neg * {11\\\\'b0,seed_q[20:0]}')\n if 'sharehi' not in flags:\n  products=products.replace('q0_q * err_q',\\\"{11'b0,q0_q[20:0]} * err_q\\\")\n # large D has small quotient, small D uses exact q0 in phase 5\n pre+=\\\"  wire small = index_input[31:11] == 0;\\\\n\\\"\nqest='q0_q + inc_q' if 'truncate' not in flags else \\\"q0_q + (small ? 32'b0 : inc_q)\\\"\nbasecalc='''\n  wire [31:0] estimated = '''+qest+''';\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd5) begin\n      product_q <= estimated * dvs_q;\n      est_q <= estimated;\n    end\n  end\n'''\ncorrbase='dvd_q'\nif 'split' in flags:\n basecalc='''\n  logic [31:0] prod0_q, residual0_q;\n  wire [31:0] estimated = '''+qest+''';\n  wire [31:0] next_base = dvd_q - prod0_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd4) prod0_q <= '''+('hi_reg' if 'sharehi' in flags else 'q0_q')+''' * dvs_q;\n    if (phase_q == 3'd5) begin\n      product_q <= '''+(\\\"small ? 32'b0 : \\\" if 'truncate' in flags else '')+'''inc_q * dvs_q;\n      est_q <= estimated;\n      residual0_q <= next_base;\n    end\n  end\n'''\n corrbase='next_base'\npost='''\n  logic [31:0] a_minus_d, a_minus_2d;\n  logic single_ok, double_ok;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd5) begin\n      a_minus_d <= BASE - dvs_q;\n      a_minus_2d <= BASE - {dvs_q[30:0],1'b0};\n      single_ok <= BASE >= dvs_q;\n      double_ok <= \"'!dvs_q[31] && BASE >= {dvs_q[30:0],1'\"'b0};\n    end\n  end\n  wire [31:0] residual = BASE_REG - product_q;\n  wire [32:0] diff1 = {1'b0,a_minus_d} - {1'b0,product_q};\n  wire [32:0] diff2 = {1'b0,a_minus_2d} - {1'b0,product_q};\n  wire one = single_ok && \"'!diff1[32];\n  wire two = double_ok && !diff2[32];\n  wire [31:0] remainder = two ? diff2[31:0] : one ? diff1[31:0] : residual;\n  wire [31:0] quotient_val = two ? est_q+32'\"'d2 : one ? est_q+32'd1 : est_q;\n'''.replace('BASE_REG','dvd_q' if 'split' not in flags else 'residual0_q').replace('BASE',corrbase)\nsrc=src[:i]+pre+products+basecalc+post+src[j:]\nf.write_text(src)\nPY\npython \\\"\"'$TMPDIR/newton/gold.py\" g1 truncate\npython \"$TMPDIR/newton/gold.py\" g2 sh