{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nfrom collections import Counter\nraw = [s.split() for s in (Path(os.environ['TMPDIR'])/'baseline-misses.log').read_text().splitlines() if s.startswith('B ')]\ndata = [(int(p,16)>>2,int(t),int(hit),int(pred)) for _,p,t,pred,hit in raw]\nprint(Counter((t,hit,pred) for _,t,hit,pred in data),flush=True)\ndef run(h,s,k,l):\n    mask=(1<<h)-1\n    pm=(1<<s)-1\n    prev=[0]*2048\n    pat=[1]*(2<<s)\n    errors=0\n    for pc,t,hit,orig in data:\n        lh=pc&((1<<l)-1)\n        hc=prev[lh]\n        mix=(pc\"'^(pc>>s))&pm\n        if hit and pc in saved and saved[pc] in (0,3):\n            pred=saved[pc]>>1\n        else:\n            pred=orig\n        errors += t!=pred\n        hn=((hc<<1)|t)&mask\n        old=(((hc>>1)''^mix)<<1)|(hc&1)\n        new=(((hn>>1)''^mix)<<1)|t\n        saved[pc]=pat[new]\n        p=pat[old]\n        pat[old]=min(3,p+1) if t else max(0,p-1)\n        prev[lh]=hn\n    return errors\nfor l in (8,6):\n for h,s in [(4,8),(6,8),(8,8),(8,9),(9,9),(10,9),(10,10),(11,10)]:\n    saved={}\n    print(l,h,s,run(h,s,0,l),flush=True)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
