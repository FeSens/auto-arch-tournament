{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/btb-eval\" && cat >> cores/bench/test/test_pipeline.py <<'\"'PY'\n\n\n@cocotb.test()\nasync def branch_target_buffer_source_tag_collision(dut):\n    a = 1040\n    b = a + 1024\n    program = [NOP()] * ((b+28)//4+1)\n    for pc,insn in {\n        a-4:ADDI(1,0,3), a:JAL(0,12), a+4:SW(0,0,80),\n        a+12:JAL(0,(b-4)-(a+12)), b-4:ADDI(2,2,1),\n        b:JAL(0,20), b+4:SW(0,0,84), b+20:BEQ(2,1,8),\n        b+24:JAL(0,(a-4)-(b+24)), b+28:EBREAK()\n    }.items():\n        program[pc//4]=insn\n    fetches = []\n    def ready(ia,da,ren,wen,wdata):\n        fetches.append(ia)\n        assert not wen\n        return 1,1\n    rets, _ = await _run(dut,program,bus_ready=ready,max_cycles=350)\n    lap = [a-4,a,a+12,b-4,b,b+20,b+24]\n    _check_loop_path(rets,list(range(0,a-4,4))+lap*2+lap[:-1]+[b+28])\n    probes = [(p,q) for p,q in zip(fetches,fetches[1:]) if p in (a,b)]\n    assert probes == [(a,a+4),(b,b+4)]*3\nPY\npytest -q cores/bench/test/test_pipeline.py >alias-directed.log 2>&1 && tail -n 3 alias-directed.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
