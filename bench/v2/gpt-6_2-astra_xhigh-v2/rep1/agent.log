{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/replay-study\" && cat > divide.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\ndef gen(n,k,sep):\n v=Path(n);shutil.copytree('champion',v);p=v/'alu.sv';s=p.read_text()\n w=(32-k)//5\n assert k+5*w==32 and w<=3\n def func(label,bits,rad): # bits=remainder width, rad digit bits, t whole bits\n  m=bits+rad\n  lines=[f'  function automatic logic [{m-1}:0] {label}(input logic [{m-1}:0] t);']\n  for i in range(1,2**rad):\n   lines.append(f'    logic [{m}:0] d{i};')\n  for i in range(1,2**rad):\n   lines.append(f\\\"    d{i} = {{1'b0,t}} - {{1'b0,multiple[{i}][{m-1}:0]}};\\\")\n  def tree(a,b):\n   if a==b: return \\\"{\\\"+f\\\"{rad}'d{a}, \\\" + (f\\\"d{a}\\\" if a else \\\"t\\\")+f\\\"[{bits-1}:0]\\\"+\\\"}\\\"\n   mid=(a+b+1)//2\n   return f'(d{mid}[{m}] ? {tree(a,mid-1)} : {tree(mid,b)})'\n  lines += [f'    {label} = {tree(0,2**rad-1)};','  endfunction']\n  return '\\\\n'.join(lines)+'\\\\n'\n a=s.index('  function automatic logic [34:0] radix8_digit')\n b=s.index('  always_ff',a)\n wide_q='qw' if sep else 'quotient_q';wide_r='rw' if sep else 'remainder_q'\n block=func('small_step',k,3)+func('wide_step',32,w)+f'''\n  logic [2:0] hi_small, lo_small;\n  logic [{w-1}:0] digit_wide;\n  logic [{k-1}:0] middle_small, next_small;\n  logic [31:0] next_wide;\n  logic [31:0] qw,rw;\n  wire large = |divisor_q[31:{k}];\n  wire zero = divisor_q == 32'b0;\n  assign {{hi_small,middle_small}} = small_step({{remainder_q[{k-1}:0],quotient_q[31:29]}});\n  assign {{lo_small,next_small}} = small_step({{middle_small,quotient_q[28:26]}});\n  assign {{digit_wide,next_wide}} = wide_step({{{wide_r},{wide_q}[31:{32-w}]}});\n'''\n s=s[:a]+block+s[b:]\n s=s.replace('  logic [31:0] magnitude;', '  logic [31:0] magnitude, original_a;')\n s=s.replace('      quotient_q  <= neg_a ?', '      original_a <= a;\\\\n      quotient_q  <= neg_a ?')\n a=s.index('      quotient_q  <= {quotient_q[29:0]')\n b=s.index('    end\\\\n',s.index('remainder_q <= next_rem',a))\n if sep:\n  block=f'''      quotient_q <= {{quotient_q[29:0],first_bit,second_bit}};\n      remainder_q <= {{30'b0,prefix_rem}};\n      qw <= {{quotient_q[{31-k}:0],{k}'b0}};\n      rw <= {{{32-k}'b0,quotient_q[31:{32-k}]}};\n    end else if (div_busy && \"'!div_done) begin\n      quotient_q <= {{quotient_q[25:0],hi_small,lo_small}};\n      remainder_q <= next_small;\n      qw <= {{qw[{31-w}:0],digit_wide}};\n      rw <= next_wide;\n'\"'''\n  mag='large ? (want_rem_q ? rw : qw) : (want_rem_q ? remainder_q : quotient_q)'\n else:\n  block=f'''      quotient_q <= large ? {{quotient_q[{31-k}:0],{k}'b0}} : {{quotient_q[29:0],first_bit,second_bit}};\n      remainder_q <= large ? {{{32-k}'b0,quotient_q[31:{32-k}]}} : {{30'b0,prefix_rem}};\n    end else if (div_busy && \"'!div_done) begin\n      quotient_q <= large ? {{quotient_q[{31-w}:0],digit_wide}} : {{quotient_q[25:0],hi_small,lo_small}};\n      remainder_q <= large ? next_wide : next_small;\n'\"'''\n  mag='want_rem_q ? remainder_q : quotient_q'\n s=s[:a]+block+s[b:]\n s=s.replace('assign magnitude  = want_rem_q ? remainder_q : quotient_q;',f'assign magnitude = {mag};')\n s=s.replace('assign div_result = negate_q ? -magnitude : magnitude;', \\\"assign div_result = zero ? (want_rem_q ? original_a : 32'hffffffff) : (negate_q ? -magnitude : magnitude);\\\")\n s=s.replace('large','wide_mode')\n p.write_text(s)\nif __name__=='__main__':\n for k in [17,22]:\n  for sep in [0,1]: gen(f'div{k}'+('sep' if sep else 'shared'),k,sep)\nPY\npython divide.py && python - <<'PY'\nimport json,glob\nfor f in glob.glob('freq_*1.json'):\n r=json.load(open(f))[0]\n if 'group' in f or 'sweep' in f or 'load' in f: print(f,r.get('fmax_mhz'),r.get('logic'))\nfor f in glob.glob('load*.json'):\n r=json.loads(open(f).read().splitlines()[-1]); print(f,r['bench_stop_cycle']-r['bench_start_cycle'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
