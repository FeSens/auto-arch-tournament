{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/btb-eval\" && cat >> cores/bench/test/test_pipeline.py <<'\"'PY'\n\n\n@cocotb.test()\nasync def predictor_holds_loop_replay_across_taken_tail(dut):\n    setup = [NOP()] * 260\n    head = 4 * (len(setup) + 1)\n    tail = head + 8\n    program = setup + [\n        ADDI(1, 0, 4),\n        SW(2, 0, 64), ADDI(2, 2, 1), BNE(1, 2, -8),\n        EBREAK()\n    ]\n    accepted = []\n    cold_exit_seen = False\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal cold_exit_seen\n        if ia == tail + 4:\n            cold_exit_seen = True\n        if wen:\n            accepted.append((da, wen, wdata))\n        return not (cold_exit_seen and head <= ia <= tail), 1\n    rets, _ = await _run(dut, program, max_cycles=330, bus_ready=ready)\n    expected = list(range(0, head, 4)) + [head, head + 4, tail] * 4 + [tail + 4]\n    _check_loop_path(rets, expected)\n    assert accepted == [(64, 15, k) for k in range(4)]\n    tail_times = [r['cycle'] for r in rets if r['pc'] == tail]\n    head_times = [r['cycle'] for r in rets if r['pc'] == head]\n    assert head_times[1] == tail_times[0] + 2\n    assert head_times[2:] == [n + 1 for n in tail_times[1:3]]\n    assert rets[-1]['cycle'] == tail_times[3] + 2\n\n\n@cocotb.test()\nasync def correct_jalr_direction_with_changed_target(dut):\n    setup = [NOP()] * 260\n    base = 4 * len(setup)\n    jump, target, done = base + 8, base + 20, base + 40\n    program = setup + [\n        ADDI(1, 0, target), ADDI(3, 0, 2), JALR(5, 1, 0),\n        SW(0, 0, 80), EBREAK(),\n        SW(2, 0, 64), ADDI(2, 2, 1), BNE(2, 3, 8),\n        ADDI(1, 0, done), JAL(0, jump - (base + 36)), EBREAK()\n    ]\n    accepted = []\n    def ready(ia, da, ren, wen, wdata):\n        if wen:\n            accepted.append((da, wen, wdata))\n        return 1, 1\n    rets, _ = await _run(dut, program, max_cycles=340, bus_ready=ready)\n    expected = (list(range(0,jump,4)) +\n                [jump,target,target+4,target+8,target+16] +\n                [jump,target,target+4,target+8,target+12,target+16] + [jump,done])\n    _check_loop_path(rets, expected)\n    assert accepted == [(64,15,0),(64,15,1)]\n    jumps = [r for r in rets if r['pc'] == jump]\n    stores = [r for r in rets if r['pc'] == target]\n    assert [r['rd_wdata'] for r in jumps] == [jump+4] * 3\n    assert stores[1]['cycle'] == jumps[1]['cycle'] + 1\n    assert rets[-1]['cycle'] == jumps[-1]['cycle'] + 2\nPY\npytest -q cores/bench/test/test_pipeline.py >directed.log 2>&1 && tail -n 2 directed.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
