{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python -B - <<'PY'\nfrom collections import Counter\nfrom pathlib import Path\nimport subprocess, sys, tempfile\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nwith tempfile.TemporaryDirectory() as temp:\n    elf = Path(temp) / 'coremark.elf'\n    recipe = subprocess.check_output(['make','-s','-n','-f','bench/programs/Makefile','bench/programs/coremark.elf'], text=True).split()\n    assert recipe[-2:] == ['-o','bench/programs/coremark.elf']\n    subprocess.run([*recipe[:-1], str(elf)], check=True)\n    cpu = RV32IM()\n    cpu.load_elf(elf)\n    divs, muls = Counter(), Counter()\n    start = stop = None\n    while cpu.retired < 10_000_000:\n        r = cpu.step()\n        op = r['insn']\n        if r['trap'] or cpu.oob_access:\n            raise RuntimeError(f\\\"unexpected trap or address at PC {r['pc']:08x}\\\")\n        if r['mem_wmask'] and r['mem_addr'] == 0x10000100:\n            assert start is None\n            start = r['order']\n        elif r['mem_wmask'] and r['mem_addr'] == 0x10000104:\n            stop = r['order']\n            assert start is not None\n        elif start is not None and stop is None and op & 0xfe00007f == 0x02000033:\n            f3 = op >> 12 & 7\n            (divs if f3 >= 4 else muls)[f3] += 1\n        if op == 0x00100073:\n            break\n    assert stop and stop > start\n    print(f'{stop-start-1} instructions strictly between markers, {sum(divs.values())} DIV/REM, {sum(muls.values())} MUL-family')\n    print('canonical validation:', b'Correct operation validated.' in cpu.uart_buf)\n    assert b'Correct operation validated.' in cpu.uart_buf\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
