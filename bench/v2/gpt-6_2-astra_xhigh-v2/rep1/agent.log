{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/newton/make_proto.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport sys\nfrom shutil import copytree\nbase=Path(os.environ['TMPDIR'])/'newton'\nname=sys.argv[1] if len(sys.argv)>1 else 'v1'\nrtl=base/name/'rtl'\ncopytree(Path('cores/bench/rtl'),rtl,dirs_exist_ok=True)\nfull=(rtl/'alu.sv').read_text()\nstart=full.index('  logic signed_div')\nstop=full.index('\\\\n\"'`endif'\"',start)\nbody=\\\"\\\"\\\"\n  wire signed_op = op == ALU_DIV || op == ALU_REM;\n  wire neg_a = signed_op && a[31];\n  wire neg_b = signed_op && b[31];\n  wire rem_op = op == ALU_REM || op == ALU_REMU;\n  logic [31:0] dvd_q, dvs_q, index_input;\n  logic rem_q, neg_q;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dvd_q <= neg_a ? -a : a;\n      dvs_q <= neg_b ? -b : b;\n      index_input <= neg_b ? ~b : b - 32'd1;\n      rem_q <= rem_op;\n      neg_q <= rem_op ? neg_a : ((neg_a \"'^ neg_b) && b != 0);\n    end\n  end\n\n  logic [4:0] s, shift_q;\n  always_comb begin\n    s = 0;\n    for (int i = 11; i < 32; i++)\n      if (index_input[i]) s = 5'\"'(i-10);\n  end\n  wire [10:0] adr = 11'(index_input >> s);\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] reciprocal [0:2047];\n  initial begin\n    for (int i = 0; i < 2048; i++)\n      reciprocal[i] = 32'(64'h100000000 / (64'(i) + 64'd1));\n  end\n  logic [31:0] rom_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd1) begin\n      shift_q <= s;\n      rom_q <= reciprocal[adr];\n    end\n  end\n  wire [31:0] m0 = rom_q >> shift_q;\n  logic [31:0] m0_q, prod_q, hi_q, magnitude_q;\n  wire [31:0] lo_left = phase_q == 3'd2 ? m0 : hi_q;\n  wire [31:0] hi_left = phase_q == 3'd3 ? m0_q : m0_q + hi_q;\n  wire [31:0] hi_right = phase_q == 3'd3 ? -prod_q : dvd_q;\n  wire [63:0] product = hi_left * hi_right;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd2) m0_q <= m0;\n    if (phase_q == 3'd2 || phase_q == 3'd5)\n      prod_q <= lo_left * dvs_q;\n    if (phase_q == 3'd3 || phase_q == 3'd4)\n      hi_q <= product[63:32];\n  end\n  wire [31:0] residual = dvd_q - prod_q;\n  wire [32:0] diff1 = {1'b0, residual} - {1'b0, dvs_q};\n  wire [33:0] diff2 = {2'b0, residual} - {1'b0, dvs_q, 1'b0};\n  wire [31:0] remainder = \"'!diff2[33] ? diff2[31:0] :\n                          !diff1[32] ? diff1[31:0] : residual;\n  wire [31:0] quotient_val = !diff2[33] ? hi_q + 2'\"'d2 :\n                             \"'!diff1[32] ? hi_q + 1'\"'d1 : hi_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd6) begin\n      if (dvs_q == 0) magnitude_q <= rem_q ? dvd_q : 32'hffffffff;\n      else if (dvs_q == 1) magnitude_q <= rem_q ? 0 : dvd_q;\n      else magnitude_q <= rem_q ? remainder : quotient_val;\n    end\n  end\n  assign div_result = neg_q ? -magnitude_q : magnitude_q;\n\\\"\\\"\\\"\n(rtl/'alu.sv').write_text(full[:start]+body+full[stop:])\nPY\npython \\\"\"'$TMPDIR/newton/make_proto.py\" v1\ncat > \"$TMPDIR/newton/timing.py\" <<'\"'PY'\nimport sys,os\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\nroot=Path.cwd()\nx=Path(os.environ['TMPDIR'])/'newton'/sys.argv[1]\nfor r in build_all(root,x/'rtl','fpga/core_bench_si.sv',x/'timing',options=list(map(int,sys.argv[2:])) or [0,1,2]):\n print(r)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/newton/timing.py\" v1 1 > \"$TMPDIR/newton/v1/timing.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
