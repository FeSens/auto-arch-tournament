{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom fractions import Fraction\nH=1<<32\nfor g in (3,4):\n widths=[];n=1;peak=0;at=0\n for e in range(1,32):\n  for k in range(e,-1,-1):\n   w=1<<k\n   results=[]\n   for l in range(1<<e,2<<e,w):\n    f=1-Fraction(l*(H//(l+w-1)),H)\n    b=Fraction(H,l)*f**4 + Fraction((2+f)*(1+f*f),1<<g)+Fraction(1,l)\n    if b>=1:break\n    results.append((b,l))\n   else:break\n  n+=1<<(e-k);widths.append(k)\n  if max(results)[0]>peak:peak,at=max(results)\n print(g,n, float(peak),at,widths)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
