{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/{reg_file,forward_unit}.sv && rg -n 'fwd_|stall|rs[12]_(addr|val)' cores/bench/rtl/{core,id_stage,ex_stage}.sv\"", "aggregated_output": "// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// The reset clears all 32 registers. Distributed-LUT or flop inference is\n// fine here; explicit BRAM attribution lives on the larger imem/dmem\n// declarations in soc.sv (phase 5).\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  logic [31:0] regs [0:31];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n    end else if (w_en && w_addr != 5'b0) begin\n      regs[w_addr] <= w_data;\n    end\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = regs[rs1_addr];\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = regs[rs2_addr];\n  end\n\nendmodule\n// rtl/forward_unit.sv\n//\n// Operand forwarding. For each rs in the EX-stage's source list, picks\n// where the freshest value lives:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younge\n…[4890 of 7962 chars elided by tools/bench/transcript.py; sha256:749748b95b66d6e8]…\n.fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\ncores/bench/rtl/core.sv:146:    .fwd_mem_wb      (wb_w_data),            // WB-stage's write-mux output\ncores/bench/rtl/core.sv:179:    .if_id_rs1      (rs1_addr_w),\ncores/bench/rtl/core.sv:180:    .if_id_rs2      (rs2_addr_w),\ncores/bench/rtl/core.sv:186:    .stall_if       (stall_if),\ncores/bench/rtl/core.sv:187:    .stall_id       (stall_id),\ncores/bench/rtl/core.sv:189:    .stall_ex_mem   (stall_ex_mem),\ncores/bench/rtl/core.sv:194:    .id_ex_rs1   (id_ex_w.rs1_addr),\ncores/bench/rtl/core.sv:195:    .id_ex_rs2   (id_ex_w.rs2_addr),\ncores/bench/rtl/core.sv:200:    .fwd_rs1     (fwd_rs1_sel),\ncores/bench/rtl/core.sv:201:    .fwd_rs2     (fwd_rs2_sel)\ncores/bench/rtl/core.sv:228:    io_rvfi_rs1_addr_0  = mem_wb_w.rs1_addr;\ncores/bench/rtl/core.sv:229:    io_rvfi_rs1_rdata_0 = mem_wb_w.rs1_val;\ncores/bench/rtl/core.sv:230:    io_rvfi_rs2_addr_0  = mem_wb_w.rs2_addr;\ncores/bench/rtl/core.sv:231:    io_rvfi_rs2_rdata_0 = mem_wb_w.rs2_val;\n", "exit_code": 0, "status": "completed"}}
