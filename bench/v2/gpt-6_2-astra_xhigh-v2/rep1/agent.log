{"type": "item.completed", "item": {"id": "item_84", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv && ls -t formal/last_run*.log && git diff -- cores/bench/test/test_pipeline.py | head -150'", "aggregated_output": "// rtl/if_stage.sv\n//\n// The fetch PC supplies both the instruction address and the bimodal table\n// index. ID captures the instruction and its prediction on the same edge\n// that advances the PC. A flush supplies an invalid NOP to ID.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // ID cannot accept this fetch\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX prediction miss\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [7:0]        train_index,\n  input  logic [1:0]        train_state,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [255:0] entry_valid;\n  logic [1:0] counters [0:255];\n  logic [1:0] pred_state;\n  logic is_branch, is_jal, pred_taken;\n  logic [31:0] imm, direct_target;\n\n  // Only the valid bits need reset. Until the first training write to an\n  // index, use a weak counter biased by the sign of this displacement.\n  always_ff @(posedge clock) begin\n    if (reset)         entry_valid <= '0;\n    else if (train_en) entry_valid[train_index] <= 1'b1;\n    if (train_en) counters[train_index] <= train_state;\n  end\n  assign pred_state = entry_valid[pc[9:2]] ? counters[pc[9:2]]\n                                           : (imem_data[31] ? 