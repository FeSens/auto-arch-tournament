index;\n  always_ff @(posedge clock) begin\n    last_write <= edge_pending || edge_clearing;\n    last_write_index <= edge_write_index;\n    if (reset || fence_i || recover_target || recover_fallthrough) response_valid <= 1'b0;\n    else if (\"'!stall) response_valid <= !recovering && !edge_clearing &&\n                             !(last_write && last_write_index == normal_pc[11:2]) &&\n                             !(edge_pending && edge_index == normal_pc[11:2]) &&\n                             normal_pc[31:20] == 0 && edge_lookup[50] &&\n                             (predict_taken ? lookup.target == edge_lookup[49:32] :\n                              (normal_pc + 30'\"'d1) == {12'b0,edge_lookup[49:32]});\n  end\n  wire successor_hit = response_valid;\n\n'''+s[j:]\ns=s.replace('successor_hit ? edge_response[31:0]', 'successor_hit ? response_word')\np.write_text(s)\nrtl=root/'splitmatch/cores/bench/rtl'\nshutil.copytree(src,rtl)\np=rtl/'core.sv'\ns=p.read_text().replace('  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n  logic raw_match;').replace('    .issue_advance   (','    .producer_rd     (id_ex_w.rd),\\\\n    .raw_match       (raw_match),\\\\n    .issue_advance   (').replace('    .id_ex_rd       (id_ex_w.rd),\\\\n    .if_id_rs1      (rs1_addr_w),\\\\n    .if_id_rs2      (rs2_addr_w),','    .id_ex_rd       (id_ex_w.rd),\\\\n    .raw_match      (raw_match),')\np.write_text(s)\np=rtl/'hazard_unit.sv'\ns=p.read_text().replace('  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\\\\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)','  input  logic       raw_match,').replace('(id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)','raw_match')\np.write_text(s)\np=rtl/'if_stage.sv'\ns=p.read_text().replace('  input  logic              issue_advance,','  input  logic              issue_advance,\\\\n  input  logic [4:0]        producer_rd,\\\\n  output logic              raw_match,')\ns=s.re