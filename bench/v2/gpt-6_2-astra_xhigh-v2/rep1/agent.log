{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/predstudy\"\ncat > link.py <<'\"'PY'\nfrom pathlib import Path\nbase=Path('cores/bench/rtl')\ndef edit(file, a,b):\n p=base/file\n s=p.read_text()\n assert a in s\n p.write_text(s.replace(a,b,1))\nedit('core_pkg.sv','    logic [31:0] rs1_val;', '    logic [31:0] alu_imm;\\\\n    logic [31:0] rs1_val;')\nedit('id_stage.sv','    ctrl_decoded.alu_op     = dec_alu_op;', '    ctrl_decoded.alu_op     = dec_is_jump ? ALU_LUI : dec_alu_op;')\nedit('id_stage.sv','    ctrl_decoded.alu_src    = dec_alu_src;', '    ctrl_decoded.alu_src    = dec_is_jump || dec_alu_src;')\nedit('id_stage.sv','      reg_q.imm      <= imm;', '      reg_q.imm      <= imm;\\\\n      reg_q.alu_imm  <= dec_is_jump ? in.fallthrough : imm;')\nedit('ex_stage.sv','in.ctrl.alu_src  ? in.imm : rs2','in.ctrl.alu_src  ? in.alu_imm : rs2')\nedit('ex_stage.sv','in.ctrl.is_jump ? (in.fallthrough) : alu_result','alu_result')\nPY\npython3 link.py\ncp -r cores/bench/rtl \\\"\"'$TMPDIR/pred_page_v3\"\ncat >> cores/bench/test/test_pipeline.py < predtests.tmp\ncat > get_timing.py <<'\"'PY'\nfrom tools.eval.gowin import build_all,summarize\nimport os,sys\nversion=sys.argv[1]\nprint(summarize(build_all('.',os.environ['TMPDIR']+'/pred_page_'+version,'fpga/core_bench_si.sv',version+'timing')))\nPY\npython3 get_timing.py v3 > v3timing.log && cat v3timing.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
