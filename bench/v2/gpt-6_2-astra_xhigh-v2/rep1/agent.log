{"type": "item.started", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predictor/refine.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path(__file__).parent\nfor variant in ['repair','link']:\n path=base/variant\n if path.exists(): raise ValueError(path)\n shutil.copytree(base/'cores/bench/rtl',path)\n def edit(name, pairs):\n  f=path/name\n  s=f.read_text()\n  for a,b in pairs:\n   assert s.count(a)==1, (name,a)\n   s=s.replace(a,b)\n  f.write_text(s)\n edit('if_stage.sv',[('input  logic [31:0]       train_pc,','input  logic [5:0]        train_index,'),('wr_index <= train_pc[7:2] \"'^ train_pc[13:8];'\"','wr_index <= train_index;')])\n edit('ex_stage.sv',[('output logic               train,','output logic [5:0]         train_index,\\\\n  output logic [1:0]         train_count,\\\\n  output logic               train,'),('  assign actual_agree =','  assign train_index = in.pc[7:2] \"'^ in.pc[13:8];'\"\\\\n  assign train_count = in.count;\\\\n  assign actual_agree =')])\n edit('core.sv',[('  logic actual_agree;', '  logic actual_agree;\\\\n  logic [5:0] train_index;\\\\n  logic [1:0] train_count;'),('.train_pc        (id_ex_w.pc),','.train_index     (train_index),'),('.train_count     (id_ex_w.count),','.train_count     (train_count),'),('.actual_agree    (actual_agree),','.actual_agree    (actual_agree),\\\\n    .train_count     (train_count),\\\\n    .train_index     (train_index),')])\n # Both variants split the fast recovery tests by control-transfer type.\n f=path/'ex_stage.sv'\n s=f.read_text()\n a=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n b=s.index('    branch_taken ',a)\n s=s[:a]+'''  logic [3:0] lt_byte, eq_byte;\n  logic lt_word, equal_word, base_condition;\n  for (genvar i=0; i<4; i++) begin : g_cmp\n    logic [7:0] a_byte, b_byte;\n    if (i == 3) begin\n      assign a_byte = {rs1[31] \"'^ !in.ctrl.branch_op[1], rs1[30:24]};\n      assign b_byte = {rs2[31] ''^ !in.ctrl.branch_op[1], rs2[30:24]};\n    end else begin\n      assign a_byte = rs1[i*8 +: 8];\n      assign b_byte = rs2[i*8 +: 8];\n    end\n    assign lt_byte[i] = a_byte < b_byte;\n    assign eq_byte[i] = rs1[i*8 +: 8] == rs2[i*8 +: 8];\n  end\n  assign equal_word = &eq_byte;\n  assign lt_word = lt_byte[3] || (eq_byte[3] && lt_byte[2]) ||\n                   ((&eq_byte[3:2]) && lt_byte[1]) ||\n                   ((&eq_byte[3:1]) && lt_byte[0]);\n  assign base_condition = in.ctrl.branch_op[2] ? lt_word : equal_word;\n  always_comb begin\n    branch_cond = base_condition ''^ in.ctrl.branch_op[0];\n'\"'''+s[b:]\n f.write_text(s)\n edit('ex_stage.sv',[('  assign redirect = in.valid && \"'!stall &&'\"\\\\n        (predicted_taken \"'^ ((branch_taken || in.ctrl.is_jump) && !misalign_fault));'\"','''  logic invert_miss;\n  assign invert_miss = predicted_taken \"'^ in.ctrl.branch_op[0];\n  assign redirect = !stall && (\n      (in.ctrl.is_branch && direct_q[1:0] == 0 && (base_condition ''^ invert_miss)) ||\n      (in.ctrl.is_jump && !predicted_taken && jump_target[1:0] == 0)\n  );'\"''')])\n if variant=='link':\n  edit('core_pkg.sv', [('logic [31:0] imm;','logic [31:0] imm;\\\\n    logic [31:0] alu_imm;')])\n  edit('id_stage.sv',[('= dec_alu_op;', '= dec_is_jump ? ALU_LUI : dec_alu_op;'),('= dec_alu_src;','= dec_is_jump || dec_alu_src;'),('reg_q.imm      <= imm;', 'reg_q.imm      <= imm;\\\\n      reg_q.alu_imm  <= dec_is_jump ? in.pc + 32\\\\'d4 : imm;')])\n  edit('ex_stage.sv',[('in.ctrl.alu_src  ? in.imm : rs2;', 'in.ctrl.alu_src  ? in.alu_imm : rs2;'),('reg_q.alu_result    <= in.ctrl.is_jump ? fallthrough_q : alu_result;','reg_q.alu_result    <= alu_result;')])\nPY\npython \\\"\"'$TMPDIR/predictor/refine.py\"\ncat > \"$TMPDIR/predictor/check_timing.py\" <<'\"'PY'\nfrom tools.eval import gowin\nfrom pathlib import Path\nimport sys\nname=sys.argv[1]\noptions=tuple(map(int,sys.argv[2:])) or (0,1,2)\np=Path.cwd()\nres=gowin.build_all(p,p/name,'fpga/core_bench_si.sv',p/('timing-'+name),options=options)\nfor d in res:\n print(name,d.get('fmax_mhz'), d.get('logic'), d.get('regs'), d.get('critical_paths',[{}])[0], d.get('reason',''))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
