{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/predictor\" && cat > extra-tests.txt <<'\"'PY'\n@cocotb.test()\nasync def predicted_jal_chain(dut):\n    bank = 160\n    program = [JAL(2,8), SW(0,0,bank), JAL(3,8), SW(0,0,bank+4), EBREAK()]\n    rets, dmem = await _run(dut, program)\n    assert [r[\\\"pc\\\"] for r in rets] == [0,8,16]\n    assert [r[\\\"order\\\"] for r in rets] == [0,1,2]\n    assert [r[\\\"rd_wdata\\\"] for r in rets[:2]] == [4,12]\n    assert [r[\\\"cycle\\\"] - rets[0][\\\"cycle\\\"] for r in rets] == [0,1,2]\n    assert not dmem\n\n@cocotb.test()\nasync def warm_forward_and_exit(dut):\n    # The 96-NOP prefix puts branch training after any 64-row cold sweep.\n    prefix=[NOP()]*96\n    program = prefix+[ADDI(1,0,5),SW(1,0,160),BEQ(0,0,8),SW(0,0,164),\n                      ADDI(1,1,-1),BNE(1,0,-16),EBREAK()]\n    seen=[]\n    def ready(ia,da,ren,wen,wdata):\n        if wen: seen.append((da,wdata))\n        return 1,1\n    rets,dmem=await _run(dut,program,max_cycles=300,bus_ready=ready)\n    assert seen == [(160,k) for k in [5,4,3,2,1]]\n    assert dmem=={160:1}\n    tail=rets[len(prefix):]\n    assert [r[\\\"pc\\\"]-384 for r in tail] == [0]+[4,8,16,20]*5+[24]\n    assert [r[\\\"order\\\"] for r in rets]==list(range(len(rets)))\n    assert tail[-3][\\\"cycle\\\"] == tail[-4][\\\"cycle\\\"] + 1\n    assert tail[-1][\\\"cycle\\\"] == tail[-2][\\\"cycle\\\"] + 2\n\n@cocotb.test()\nasync def disallowed_speculative_targets(dut):\n    program=[BNE(0,0,-4),JAL(3,2),BEQ(0,0,2),EBREAK()]\n    def ready(ia,da,ren,wen,wdata):\n        assert ia < 0x100000 and ia % 4 == 0\n        return 1,1\n    rets,_=await _run(dut,program,bus_ready=ready)\n    assert [(r[\\\"pc\\\"],r[\\\"pc_next\\\"],r[\\\"trap\\\"]) for r in rets] == [\n        (0,4,0),(4,8,1),(8,12,1),(12,16,0)]\n    assert rets[1][\\\"rd\\\"] == 0\n\n@cocotb.test()\nasync def imem_wait_when_memory_releases(dut):\n    program = [LW(7,0,64), BEQ(0,0,8), SW(0,0,68), SW(7,0,72), EBREAK()]\n    holds = 0\n    writes = []\n    def ready(ia,da,ren,wen,wdata):\n        nonlocal holds\n        if ren:\n            holds += 1\n            return int(holds < 3), int(holds >= 3)\n        if wen: writes.append((da,wdata))\n        return 1,1\n    rets,dmem=await _run(dut,program,{64:23},bus_ready=ready)\n    assert [r[\\\"pc\\\"] for r in rets] == [0,4,12,16]\n    assert [r[\\\"order\\\"] for r in rets] == [0,1,2,3]\n    assert holds == 3 and writes == [(72,23)] and dmem == {64:23,72:23}\nPY\ncat > test-variant.sh <<'SH'\nset -eu\nv=\"'$1\nmkdir -p \"$v-test\"\nln -s \"$PWD/$v\" \"$v-test/rtl\"\ncp -r cores/bench/test \"$v-test/\"\ncat extra-tests.txt >> \"$v-test/test/test_pipeline.py\"\npytest -q \"$v-test/test\" > \"$v-tests.log\" 2>&1\ntail -3 \"$v-tests.log\"\nSH\ncat table16-timing.log table64-timing.log && tail -2 ready-proof.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
