{"type": "item.started", "item": {"id": "item_96", "type": "command_execution", "command": "/bin/bash -c 'cd \"$TMPDIR/replay-study\" && cat > zerofwd.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nfor name in ('zero','zero_raw','equal','equal_raw'):\n zero='zero' in name; raw='raw' in name\n v=Path(name);shutil.copytree('champion',v)\n p=v/'core.sv';s=p.read_text();a=s.index('  // ── IF ─')\n s=s[:a]+'''  wire next_equality = if_id_w.instr[6:0] == 7'b1100011 && if_id_w.instr[14:13] == 2'b00;\n  wire involves_zero = rs1_addr_w == 0 || rs2_addr_w == 0;\n  logic [31:0] load_value;\n  logic load_is_zero, actual_mem_wen;\n'''+s[a:]\n cond=\\\" && involves_zero\\\" if zero else \\\"\\\"\n s=s.replace('(id_ex_w.valid && id_ex_w.ctrl.mem_to_reg)',f'(id_ex_w.valid && id_ex_w.ctrl.mem_to_reg && \"'!(id_ex_w.ctrl.mem_read && next_equality{cond}))'\"')\n s=s.replace('    .fwd_ex_mem      (','    .older_load      (ex_mem_w.ctrl.mem_read),\\\\n    .older_load_value (load_value),\\\\n    .older_load_zero  (load_is_zero),\\\\n    .fwd_ex_mem      (')\n s=s.replace('    .hold_wb    (hold_mem_wb),','    .hold_wb    (hold_mem_wb),\\\\n    .load_is_zero (load_is_zero),\\\\n    .load_value (load_value),\\\\n    .actual_wen (actual_mem_wen),')\n s=s.replace('(ex_mem_w.ctrl.reg_write),','(actual_mem_wen),')\n p.write_text(s)\n p=v/'mem_stage.sv';s=p.read_text().replace('  input  logic               hold_wb,','  input  logic               hold_wb,\\\\n  output logic load_is_zero,actual_wen,\\\\n  output logic [31:0] load_value,')\n a=s.index('  // ── MEM/WB')\n ex='''  assign actual_wen = ctrl_with_trap.reg_write;\n  assign load_value = load_data;\n'''\n if raw:\n  ex+='''  wire [3:0] nonzero;\n  for(genvar lane=0; lane<4; lane=lane+1) begin\n    assign nonzero[lane] = |dmem_rdata[lane*8+:8];\n  end\n  assign load_is_zero = (nonzero & byte_mask) == 0;\n'''\n else: ex+=\\\"  assign load_is_zero = load_value == 0;\\\\n\\\"\n p.write_text(s[:a]+ex+'\\\\n'+s[a:])\n p=v/'ex_stage.sv';s=p.read_text()\n s=s.replace('  input  logic [1:0]         fwd_rs1_sel,','  input logic older_load,older_load_zero,\\\\n  input logic [31:0] older_load_value,\\\\n  input  logic [1:0]         fwd_rs1_sel,')\n a=s.index('  always_comb begin',s.index('  logic [31:0] base_plus_imm;'))\n ex='''  wire consume1 = in.ctrl.is_branch && older_load && fwd_rs1_sel[0];\n  wire consume2 = in.ctrl.is_branch && older_load && fwd_rs2_sel[0];\n  wire uses_load = consume1 || consume2;\n'''\n if zero: ex+='  wire equality = uses_load ? older_load_zero : rs1 == rs2;\\\\n'\n else:\n  ex+='''  wire [31:0] other = consume1 ? rs2 : rs1;\n  wire both = consume1 && consume2;\n  wire other_zero = consume1 ? in.rs2_addr == 0 : in.rs1_addr == 0;\n'''\n  if raw:ex+='  wire equality = uses_load ? (both || (other_zero ? older_load_zero : older_load_value == other)) : rs1 == rs2;\\\\n'\n  else: ex+='  wire equality = uses_load ? (both || older_load_value == other) : rs1 == rs2;\\\\n'\n s=s[:a]+ex+s[a:]\n s=s.replace('branch_cond = (rs1 == rs2);','branch_cond = equality;').replace('branch_cond = (rs1 \"'!= rs2);'\"','branch_cond = \"'!equality;'\"')\n # suppress recovery while a consumer's load value is unaccepted\n s=s.replace('  assign taken = transfer', '  assign taken = \"'!(uses_load && stall) && transfer'\"').replace('assign recover_fallthrough = in.valid', 'assign recover_fallthrough = \"'!(uses_load && stall) && in.valid'\"')\n # avoid including deferred branch data in the operand-to-multiplier path, carry repair to MEM alongside RVFI\n s=s.replace('      reg_q.rd            <= in.rd;', '''      reg_q.repair1 <= consume1;\n      reg_q.repair2 <= consume2;\n      reg_q.rd            <= in.rd;''')\n p.write_text(s)\n p=v/'core_pkg.sv';p.write_text(p.read_text().replace('    logic        branch_taken;', '    logic        repair1, repair2;\\\\n    logic        branch_taken;'))\n p=v/'mem_stage.sv'\n s=p.read_text().replace('reg_q.rs1_val    <= in.rs1_val;','reg_q.rs1_val    <= in.repair1 ? reg_q