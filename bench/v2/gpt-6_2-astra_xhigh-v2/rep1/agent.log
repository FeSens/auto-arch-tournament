{"type":"item.completed","item":{"id":"item_19","type":"agent_message","text":"The champion’s reported worst path crosses two full-width divider steps. I’ve written the hypothesis and will test a scratch version that uses one wide step for large divisors and shorter carry chains for small ones. At the champion’s cycle count, it needs about 87.6 MHz to clear acceptance."}}
{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/div-research\"\ncat > \"$TMPDIR/div-research/prototype.py\" <<'\"'PY'\nimport os, argparse, shutil\nfrom pathlib import Path\np=argparse.ArgumentParser()\np.add_argument('name'); p.add_argument('--cut', type=int, default=12)\np.add_argument('--select', choices=['tree','onehot'],default='tree')\nargs=p.parse_args()\nroot=Path.cwd()\ndest=Path(os.environ['TMPDIR'])/'div-research'/args.name\nrtl=dest/'rtl'\nshutil.copytree(root/'cores/bench/rtl',rtl,dirs_exist_ok=True)\nshutil.copytree(root/'cores/bench/test',dest/'test',dirs_exist_ok=True)\norig=(rtl/'alu.sv').read_text()\nlo=orig.index('  logic [31:0] divisor_q,')\nhi=orig.index('\"'`endif'\"',lo)\ncut=args.cut\nwidebits=(32-cut)//5\nassert cut in (12,17)\nB=2**widebits\nlogic=f\\\"\\\"\\\"  logic [31:0] divisor_q, dividend_q, magnitude;\n  logic want_rem_q, negate_q, is_wide_q, zero_q;\n  logic [31:0] wide_quotient_q, wide_rem_q, narrow_quotient_q;\n  logic [{cut-1}:0] narrow_rem_q;\n  wire [31:0] small_quotient = narrow_quotient_q;\n\n  logic [1:0] prefix_quotient, prefix_rem;\n  wire first_bit = divisor_q <= {{31'b0, dividend_q[31]}};\n  wire first_rem = first_bit ? dividend_q[31] - divisor_q[0] : dividend_q[31];\n  wire [1:0] prefix = {{first_rem, dividend_q[30]}};\n  wire second_bit = divisor_q <= {{30'b0, prefix}};\n  assign prefix_rem = second_bit ? prefix - divisor_q[1:0] : prefix;\n  assign prefix_quotient = {{first_bit,second_bit}};\n\n  wire [{31+widebits}:0] wide_d = {{{{{widebits}{{1'b0}}}}, divisor_q}};\n  wire [{31+widebits}:0] multiple [1:{B-1}];\n  assign multiple[1] = wide_d;\n\\\"\\\"\\\"\nfor k in range(2,B):\n    if k%2==0:\n        logic+=f'  assign multiple[{k}] = multiple[{k//2}] << 1;\\\\n'\n    else:\n        expr={3:'(wide_d << 1) + wide_d',5:'(wide_d << 2) + wide_d',7:'(wide_d << 3) - wide_d',9:'(wide_d << 3) + wide_d',15:'(wide_d << 4) - wide_d'}.get(k)\n        if k in (11,13):\n            a,b,c='(wide_d << 3)',f'(wide_d << {1 if k==11 else 2})','wide_d'\n            expr=f'({a} \"'^ {b} ''^ {c}) + ((({a} & {b}) | ({a} & {c}) | ({b} & {c})) << 1)'\"'\n        logic+=f'  logic [{31+widebits}:0] odd{k}_q;\\\\n  assign multiple[{k}] = odd{k}_q;\\\\n  always_ff @(posedge clock) if (phase_q == 1) odd{k}_q <= {expr};\\\\n'\ndef mkdigit(name,w,b):\n    n=1<<b\n    s=f'''  function automatic logic [{w+b-1}:0] {name}(input logic [{w+b-1}:0] partial);\n    logic [{w+b}:0] trial [1:{n-1}];\n    logic [{w+b-1}:0] result [0:{n-1}];\n    for (int k = 1; k < {n}; k++)\n      trial[k] = {{1'b0,partial}} - {{1'b0,multiple[k][{w+b-1}:0]}};\n    result[0] = {{{b}'d0,partial[{w-1}:0]}};\n    for (int k = 1; k < {n}; k++)\n      result[k] = {{k[{b-1}:0],trial[k][{w-1}:0]}};\n'''\n    def tree(l,h):\n        if l==h:return f'result[{l}]'\n        m=(l+h+1)//2\n        return f'(trial[{m}][{w+b}] ? {tree(l,m-1)} : {tree(m,h)})'\n    if args.select=='tree':\n        s+=f'    {name} = {tree(0,n-1)};\\\\n'\n    else:\n        s+=f\\\"    {name} = result[0] & {{{w+b}{{trial[1][{w+b}]}}}};\\\\n\\\"\n        for k in range(1,n):\n            cond=f'\"'!trial[{k}][{w+b}]'\"'\n            if k<n-1:cond+=f' && trial[{k+1}][{w+b}]'\n            s+=f'    {name} = {name} | (result[{k}] & {{{w+b}{{{cond}}}}});\\\\n'\n    return s+'  endfunction\\\\n'\nlogic+=mkdigit('wide_digit',32,widebits)+mkdigit('narrow_digit',cut,3)\nlogic+=f\\\"\\\"\\\"\n  wire [{widebits-1}:0] wdigit;\n  wire [31:0] wrem;\n  assign {{wdigit, wrem}} = wide_digit({{wide_rem_q, wide_quotient_q[31:{32-widebits}]}});\n  wire [2:0] ndig1, ndig2;\n  wire [{cut-1}:0] nrem1, nrem2;\n  assign {{ndig1,nrem1}} = narrow_digit({{narrow_rem_q, narrow_quotient_q[31:29]}});\n  assign {{ndig2,nrem2}} = narrow_digit({{nrem1, narrow_quotient_q[28:26]}});\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dividend_q <= neg_a ? -a : a;\n      divisor_q <= neg_b ? -b : b;\n      want_rem_q <= want_rem;\n      negate_q <= want_rem ? neg_a : ((neg_a \"'^ neg_b) && b != 0);\n    end\n    if (phase_q == 3'\"'d1) begin\n      zero_q <= divisor_q == 0;\n      is_wide_q <= |divisor_q[31:{cut}];\n      wide_rem_q <= {{{{{32-cut}{{1'b0}}}},dividend_q[31:{32-cut}]}};\n      wide_quotient_q <= {{dividend_q[{31-cut}:0],{cut}'b0}};\n      narrow_rem_q <= {{{{{cut-2}{{1'b0}}}},prefix_rem}};\n      narrow_quotient_q <= {{dividend_q[29:0],prefix_quotient}};\n    end else if (div_busy && \"'!div_done) begin\n      wide_quotient_q <= {{wide_quotient_q[{31-widebits}:0],wdigit}};\n      wide_rem_q <= wrem;\n      narrow_quotient_q <= {{narrow_quotient_q[25:0],ndig1,ndig2}};\n      narrow_rem_q <= nrem2;\n    end\n  end\n\n  assign magnitude = zero_q ? (want_rem_q ? dividend_q : 32'\"'hffffffff) :\n                     is_wide_q ? (want_rem_q ? wide_rem_q : wide_quotient_q) :\n                                 (want_rem_q ? {{{{{32-cut}{{1'b0}}}},narrow_rem_q}} : small_quotient);\n  assign div_result = negate_q ? -magnitude : magnitude;\n\\\"\\\"\\\"\n(rtl/'alu.sv').write_text(orig[:lo]+logic+orig[hi:])\nPY\ncat > \\\"\"'$TMPDIR/div-research/timeit.py\" <<'\"'PY'\nfrom pathlib import Path\nimport json, os, sys\nfrom tools.eval.gowin import build_all, summarize\ndef time_variant(name,options):\n    d=Path(os.environ['TMPDIR'])/'div-research'/name\n    r=build_all(Path.cwd(), d/'rtl', 'fpga/core_bench_si.sv', d/'timing',options=options)\n    (d/'timing-result.json').write_text(json.dumps(r,indent=2))\n    for rec in r:\n        print(rec['place_option'], rec['fmax_mhz'], rec.get('reason'), str((rec.get('critical_paths') or [None])[0])[:240])\nif __name__=='__main__': time_variant(sys.argv[1],tuple(map(int,sys.argv[2:])))\nPY\npython \\\"\"'$TMPDIR/div-research/prototype.py\" wide16 && PYTHONPATH=. python \"$TMPDIR/div-research/timeit.py\" wide16 0 1 2'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
