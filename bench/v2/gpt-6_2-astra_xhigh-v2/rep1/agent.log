ializing) begin\n      init_index   <= init_index + 4'd1;\n      initializing <= init_index != 4'd15;\n    end\n    if (initializing || train.valid)\n      counters[write_index] <= next_count;\n  end\n\n  logic        is_jal, is_branch, predict_taken;\n  logic [31:0] displacement, direct_target;\n  assign is_jal    = imem_\n…[4376 of 7448 chars elided by tools/bench/transcript.py; sha256:f0ddf5c6db17f153]…\nt[1:0] == 2'b00;\n    misalign_fault = (branch_taken || in.ctrl.is_jump) && !target_aligned;\n    actual_taken   = (branch_taken || in.ctrl.is_jump) && target_aligned;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault)\n      ctrl_with_trap.is_illegal = 1'b1;\n    // Only a jump can have a link write to suppress.\n    if (in.ctrl.is_jump && !target_aligned)\n      ctrl_with_trap.reg_write  = 1'b0;\n  end\n\n  assign redirect = in.valid && (predicted_taken != actual_taken);\n  // JALR always predicts sequential. Direct transfers have both possible\n  // successors registered, so their correction is independent of branch_cond.\n  assign redirect_target = in.ctrl.is_jalr ? {base_plus_imm[31:1], 1'b0} :\n                           predicted_taken ? fallthrough : direct_target;\n\n  always_ff @(posedge clock) begin\n    train.valid  <= !reset && !stall && in.ctrl.is_branch && !misalign_fault;\n    train.index  <= agree_index(in.pc[9:2]);\n    train.count  <= in.agree_count;\n    train.agrees <= branch_cond == in.imm[31];\n  end\n\n", "exit_code": 0, "status": "completed"}}
