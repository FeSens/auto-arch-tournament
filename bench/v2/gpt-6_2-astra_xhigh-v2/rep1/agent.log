{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/mshare/check.sh\" <<'\"'SH'\nset -e\nv=\\\"\"'$1\"\npdir=\"$TMPDIR/mshare/check$v\"\nmkdir -p \"$pdir/test\"\ncp \"$TMPDIR/mshare/test/\"*.py \"$pdir/test/\"\nln -s \"$TMPDIR/mshare/v$v\" \"$pdir/rtl\"\ncat >> \"$pdir/test/test_alu.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def wide_boundaries(dut):\n    await _setup(dut)\n    for pivot in (1024,4096,65536,131072,262144,1<<20,1<<24,1<<31):\n        for d in range(pivot-3,pivot+4):\n            for q in (1, 2, 15, ((1<<31)-1)//d, MASK32//d):\n                for a in (q*d-1,q*d,q*d+1):\n                    a &= MASK32\n                    quo, rem=divmod(a,d)\n                    await _check_div(dut,ALU_DIVU,a,d,quo)\n                    await _check_div(dut,ALU_REMU,a,d,rem)\n                    if d<=(1<<31) and a<=(1<<31):\n                        await _check_div(dut,ALU_DIV,-a,-d,quo)\n                        await _check_div(dut,ALU_REM,-a,-d,-rem)\nPY\ncd \\\"\"'$pdir\"\nexport MAKEFLAGS=-j3\npytest -q --rootdir=. --confcutdir=. test/test_alu.py test/test_pipeline.py > suite.log 2>&1\ntail -10 suite.log\nSH\nbash \"$TMPDIR/mshare/check.sh\" 7'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
