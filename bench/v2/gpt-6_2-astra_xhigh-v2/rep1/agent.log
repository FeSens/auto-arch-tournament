id[pc]=(ea-last[pc])==str[pc];str[pc]=ea-last[pc];pred[pc]=ea+str[pc];last[pc]=ea;lid[rs1]=a.base;\n    }\n    if(op==35 && a.addr<(1<<20))data[ix]=((a.insn>>12)&7)==2?word:~0u;\n    if(op==0x63||op==0x67||op==0x6f) {int bi=a.pc>>2&1023;bool taken=a.npc!=a.pc+4;bool ph=btpc[bi]==a.pc&&ctrl[bi]>=2; bool ok=ph==taken && (!ph|| a.npc==bt[bi]); if(op==0x63){br++;bmiss+=!ok;}else{jmiss+=!ok;} if(op==0x63){ctrl[bi]=taken?std::min(3u,ctrl[bi]+1):std::max(0,int(ctrl[bi])-1);}else ctrl[bi]=3;btpc[bi]=a.pc;if(taken)bt[bi]=a.npc;}\n   }\n   printf(\"mode=%d loads=%d latehit=%d early=%d dep=%d depearly=%d deplatehit=%d br=%d brmiss=%d jmiss=%d'\"\\\\n\\\",mode,loads,hit,early,du,dh,dhit,br,bmiss,jmiss);\n }\n}\nCPP\ng++ -O2 \\\"\"'$TMPDIR/model.cpp\" -o \"$TMPDIR/model\" && \"$TMPDIR/model\" \"$TMPDIR/retire.bin\" && tail -1 \"$TMPDIR/benchmark.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
