{"type":"item.started","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/sprob/rank.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,ast,json\np=Path(os.environ['TMPDIR'])\nt=[]\nfor f in p.glob('*/timing.log'):\n if f.stat().st_size and (f.parent/'sim_out').exists():\n  try:\n   d=ast.literal_eval(f.read_text());m=json.loads((f.parent/'sim_out').read_text().splitlines()[-1])\n   c=m['bench_stop_cycle']-m['bench_start_cycle'];x=d.get('fmax_mhz')\n   if x and c: t.append((round(x*1e7/c,2),f.parent.name,x,c,d['logic'],d['bsram']))\n  except ValueError:pass\nprint(sorted(t,reverse=True)[:12])\nPY\npython3 \\\"\"'$TMPDIR/sprob/rank.py\"\nfor d in pc1 pc2 pc3 dep1 dep2 dep3; do tail -2 \"$TMPDIR/$d/timing/gowin_p1/gw.log\"; done\ndate -u\npython3 - <<'\"'PY'\nimport yaml,json,jsonschema\nfrom pathlib import Path\np=Path('cores/bench/experiments/hypotheses/hyp-20261119-003-r9s2.yaml')\nv=yaml.safe_load(p.read_text())\njsonschema.validate(v,json.load(open('schemas/hypothesis.schema.json')))\nprint(p,len(v['changes']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
