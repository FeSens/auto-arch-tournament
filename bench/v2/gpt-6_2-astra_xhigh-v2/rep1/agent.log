{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"sed -n '255,490p' cores/bench/test/test_alu.py; cat cores/bench/core.yaml\"","aggregated_output":"@cocotb.test()\nasync def divider_radix8_thresholds(dut):\n    await _setup(dut)\n    for p, divisor in ((5, 0x00A0000B), (0o1234567, 167)):\n        for digit in range(8):\n            for offset in (-1, 0, 1):\n                prefix = (8 * p + digit) * divisor + offset\n                # Appending three bits also tests this threshold in the\n                # first digit of a round, whose remainder feeds the second.\n                for dividend in (prefix, (prefix << 3) | 5):\n                    quotient, remainder = divmod(dividend, divisor)\n                    await _check_div(dut, ALU_DIVU, dividend, divisor, quotient)\n                    await _check_div(dut, ALU_REMU, dividend, divisor, remainder)\n\n\n@cocotb.test()\nasync def divider_full_width_operands(dut):\n    await _setup(dut)\n    rng = random.Random(36)\n    edges = [0, 1, 2, 63, 64, 65, 0x7fffffff, 0x80000000, 0x80000001,\n             0xfffffffd, 0xfffffffe, MASK32]\n    pairs = [(a, b) for a in edges for b in edges]\n    # Both sides of the 17-bit division threshold, including exact\n    # quotient transitions at the largest representable multiples.\n    for divisor in (0x1fffe, 0x1ffff, 0x20000, 0x20001, 0x20002):\n        for quotient in (1, 7, 8, MASK32 // divisor):\n            for offset in (-1, 0, 1):\n                pairs.append(((quotient * divisor + offset) & MASK32, divisor))\n    pairs += [(rng.getrandbits(32), rng.getrandbits(rng.randint(1, 32))) for _ in range(64)]\n    for a, b in pairs:\n        for op in (ALU_DIV, ALU_REM, ALU_DIVU, ALU_REMU):\n            signed = op in (ALU_DIV, ALU_REM)\n            x = a - (1 << 32) if signed and a >> 31 else a\n            y = b - (1 << 32) if signed and b >> 31 else b\n            if y == 0:\n                quotient, remainder = -1, x\n            else:\n                quotient = abs(x) // abs(y)\n                if (x < 0) != (y < 0):\n                    quotient = -quotient\n                remainder = x - quotient * y\n            expected = quotient if op in (ALU_DIV, ALU_DIVU) else remainder\n            await _check_div(dut, op, a, b, expected)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 87.399\n  lut4: 4661\n  ff: 1104\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261119-003-r11s2\n  updated: '2026-11-19T21:39:56.711163Z'\n","exit_code":0,"status":"completed"}}
