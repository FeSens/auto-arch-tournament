{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/successor_checks.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def learned_successor_behind_held_store(dut):\n    target = 0x100\n    words = {\n        0: ADDI(1, 0, 3), 4: ADDI(2, 2, 1), 8: SW(2, 0, 68),\n        12: JAL(5, target - 12), 16: SW(0, 0, 124),\n        target: ADDI(3, 2, 7), target+4: SW(3, 0, 64),\n        target+8: BNE(2, 1, 4 - (target+8)), target+12: EBREAK(),\n    }\n    program = [words.get(pc, NOP()) for pc in range(0, target+16, 4)]\n    visits = 0\n    holds, stores = [], []\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal visits\n        visits += ia == 12\n        iready = not (visits >= 2 and ia == target)\n        if wen and da == 68 and wdata == 2 and len(holds) < 3:\n            holds.append(ia)\n            return iready, 0\n        if wen:\n            stores.append((da, wdata))\n        return iready, 1\n\n    rets, _ = await _run(dut, program, bus_ready=ready, initial_imem_wait=1200)\n    _check_loop_path(rets, [0] + [4, 8, 12, 256, 260, 264]*3 + [268])\n    assert holds == [target]*3\n    assert stores == [(68, 1), (64, 8), (68, 2), (64, 9), (68, 3), (64, 10)]\n    for i,r in enumerate(rets):\n        if r[\\\"pc\\\"] == target and i > 4:\n            assert r[\\\"cycle\\\"] == rets[i-1][\\\"cycle\\\"] + 1\n            assert r[\\\"insn\\\"] == words[target]\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
