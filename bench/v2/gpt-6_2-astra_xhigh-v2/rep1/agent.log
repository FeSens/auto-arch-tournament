1:2] normal_pc, target_q, fallthrough_q;\n  logic use_target, use_fallthrough;\n  wire recovering = use_target || use_fallthrough;\n  wire [31:2] pc_word = ({30{!recovering}} & normal_pc)\n                      | ({30{use_target}} & target_q)\n                      | ({30{use_fallthrough}} & fallthrough_q);\n  wire [31:2] ne\n…[11479 of 14551 chars elided by tools/bench/transcript.py; sha256:60bfe4fd44baeaf9]…\nq.alu_result    <= alu_result;\n      reg_q.mem_addr      <= base_plus_imm;\n      // Capture the operands while the forwarding sources are still live.\n      // These EX/MEM fields can hold them across the invalid divider slots.\n      if (!div_busy) begin\n        reg_q.write_data <= rs2;\n        reg_q.rs1_val    <= rs1;\n        reg_q.rs2_val    <= rs2;\n      end\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= taken ? target : in.pc + 32'd4;\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
