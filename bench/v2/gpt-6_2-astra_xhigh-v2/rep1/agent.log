{"type": "item.completed", "item": {"id": "item_59", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/if_stage.sv; sed -n '75,133p' cores/bench/rtl/core.sv; cat cores/bench/rtl/hazard_unit.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Decode uses the live instruction whenever imem is ready. Within a\n// short backward loop, a recorded instruction can cover a bus wait.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:2]       redirect_target,\n  input  logic              short_back_branch,\n  input  logic              fence_i,\n  input  logic              issue_valid,\n  input  logic [31:2]       issue_pc,\n  input  logic [31:0]       issue_instr,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  logic [31:2] pc_word;\n  wire [31:0] pc = {pc_word, 2'b00};\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] words [0:63];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:8] tags [0:3];\n  logic [15:0] present [0:3];\n  logic [15:0] write_bit;\n  logic same_tag;\n  logic active, replay_hit;\n  // Bit 8 distinguishes head from tail for a displacement of exactly -256.\n  logic [8:2] tail;\n\n  always_ff @(posedge clock) begin\n    if (issue_valid) begin\n      words[issue_pc[7:2]] <= issue_instr;\n      tags[issue_pc[7:6]] <= issue_pc[31:8];\n    end\n  end\n\n  assign same_tag = tags[issue_pc[7:6]] == issue_pc[31:8];\n  assign write_bit = 16'b1 << issue_pc[5:2];\n  for (genvar bank = 0; bank < 4; bank++) begin : gen_tag\n    wire write_bank = issue_valid && issue_pc[7:6] == bank;\n    always_ff @(posedge clock) begin\n      if (reset || fence_i) present[\n…[4983 of 8055 chars elided by tools/bench/transcript.py; sha256:0985b3a737b09e25]…\n// dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n    dmem_stall = !dmem_ready && ex_mem_mem_op;\n\n    // The PC gives redirect priority over these interlocks.\n    // Issuing FENCE.I advanced IF to fence PC+4. Hold that PC and\n    // discard its pre-fence fetch on the edge that lets the fence leave EX.\n    stall_if      = load_use_hazard || imem_stall || dmem_stall || div_wait || fence_i;\n    stall_id      = dmem_stall || div_wait;\n    bubble_id     = redirect || load_use_hazard || fence_i;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
