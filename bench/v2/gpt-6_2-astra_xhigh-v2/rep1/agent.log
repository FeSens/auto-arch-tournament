te_q, zero_q;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      raw_a_q    <= a;\n      neg_a_q    <= neg_a;\n      x_q        <= neg_b ? ~b : b - 32'd1;\n      zero_q     <= b == 0;\n      want_rem_q <= want_rem;\n      negate_q   <= want_rem ? neg_a : ((\n…[2196 of 5268 chars elided by tools/bench/transcript.py; sha256:eea1f5218bc080fc]…\ndividend_q - product)\n                   : (increment ? next_quotient_q : quotient_q);\n  end\n  assign div_result = negate_q ? -magnitude_q : magnitude_q;\n`endif\n\n  wire [32:0] mul_lhs = {(op == ALU_MULH || op == ALU_MULHSU) && a[31], a};\n  wire [32:0] mul_rhs = {op == ALU_MULH && b[31], b};\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU:\n        out = ENABLE_MUL ? multiply_result(op, mul_lhs, mul_rhs) : 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = DIV_ON_ALU_OUT ? div_result : 32'b0;\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
