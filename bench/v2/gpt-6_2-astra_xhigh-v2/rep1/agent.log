{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/replay-study\" && cat > load_bypass.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nfor name in ['loadword','loadall','loadwordnc','loadallnc']:\n v=Path(name);shutil.copytree('champion',v)\n allsizes='all' in name\n no_ctrl=name.endswith('nc')\n q=v/'core.sv';s=q.read_text()\n a=s.index('  // ── IF ─')\n s=s[:a]+'''  logic mem_writes_arch;\n  logic [31:0] loaded_value;\n  logic skip_interlock;\n  logic mem_can_forward;\n  logic load_dep_control;\n'''+s[a:]\n can_fwd_id='id_ex_w.ctrl.mem_read'\n can_fwd_mem='ex_mem_w.ctrl.mem_read'\n if not allsizes:\n  can_fwd_id+=' && id_ex_w.ctrl.mem_width == 2'\n  can_fwd_mem+=' && ex_mem_w.ctrl.mem_width == 2'\n elif allsizes:\n  pass\n id_cond=can_fwd_id\n if no_ctrl: id_cond+=' && if_id_w.instr[6:0] \"'!= 7'\"\\\\'b1100011 && if_id_w.instr[6:0] \"'!= 7'\"\\\\'b1100111'\n s=s.replace('  // ── IF ─', f'  assign skip_interlock = {id_cond};\\\\n  assign mem_can_forward = {can_fwd_mem};\\\\n\\\\n  // ── IF ─',1)\n s=s.replace('(ex_mem_w.alu_result),  //','(mem_can_forward ? '+('loaded_value' if allsizes else 'io_dmemRData')+' : ex_mem_w.alu_result),  //',1)\n s=s.replace('    .hold_wb    (hold_mem_wb),','    .hold_wb    (hold_mem_wb),\\\\n    .loaded_value (loaded_value),\\\\n    .mem_writes_arch (mem_writes_arch),')\n s=s.replace('(ex_mem_w.ctrl.reg_write),','(mem_writes_arch),')\n s=s.replace('(id_ex_w.valid && id_ex_w.ctrl.mem_to_reg)','(id_ex_w.valid && id_ex_w.ctrl.mem_to_reg && \"'!skip_interlock)'\"')\n if not no_ctrl:\n  s=s.replace('  // ── IF ─','  assign load_dep_control = stall_ex_mem && mem_can_forward && (fwd_rs1_sel[0] || fwd_rs2_sel[0]);\\\\n  logic ex_recover_target, ex_recover_fallthrough, ex_taken;\\\\n  assign taken = ex_taken && \"'!load_dep_control;'\"\\\\n  assign recover_target = ex_recover_target && \"'!load_dep_control;'\"\\\\n  assign recover_fallthrough = ex_recover_fallthrough && \"'!load_dep_control;'\"\\\\n\\\\n  // ── IF ─',1)\n  a=s.index('  ex_stage u_ex');b=s.index('  // ── MEM',a)\n  s=s[:a]+s[a:b].replace('(recover_target)','(ex_recover_target)').replace('(recover_fallthrough)','(ex_recover_fallthrough)').replace('(taken)','(ex_taken)')+s[b:]\n q.write_text(s)\n q=v/'mem_stage.sv'; s=q.read_text().replace('  input  logic               hold_wb,','  input  logic               hold_wb,\\\\n  output logic [31:0] loaded_value,\\\\n  output logic mem_writes_arch,')\n s=s.replace('  // ── MEM/WB register','  assign mem_writes_arch = ctrl_with_trap.reg_write;\\\\n  assign loaded_value = load_data;\\\\n\\\\n  // ── MEM/WB register');q.write_text(s)\nPY\npython load_bypass.py\npython - <<'PY'\nimport json,glob\nfor f in glob.glob('freq*1.json'):\n if 'group' in f or 'sweep' in f:\n  r=json.load(open(f))[0];print(f, r.get('fmax_mhz'),r.get('logic'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
