{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/divsplit\" && cp -R cores/bench/rtl cores/bench/test \"$TMPDIR/divsplit/\" && cp cores/bench/rtl/alu.sv \"$TMPDIR/divsplit/original.sv\" && cat > \"$TMPDIR/divsplit/generate.py\" <<'\"'PY'\nfrom pathlib import Path\n\nroot = Path(__file__).resolve().parent\norig = (root/'original.sv').read_text()\nstart = orig.index('  logic signed_div')\nend = orig.index('\"'`endif'\"', start)\nlarge = \\\"\\\"\\\"\n  logic [31:0] dividend_q, divisor_q;\n  logic negate_q, rem_op_q;\n  wire signed_op = op == ALU_DIV || op == ALU_REM;\n  wire rem_op = op == ALU_REM || op == ALU_REMU;\n  wire a_neg = signed_op && a[31];\n  wire b_neg = signed_op && b[31];\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dividend_q <= a_neg ? -a : a;\n      divisor_q <= b_neg ? -b : b;\n      rem_op_q <= rem_op;\n      negate_q <= rem_op ? a_neg : ((a_neg \"'^ b_neg) && b != 0);\n    end\n  end\n\n  logic [35:0] table_d [1:15];\n  wire [35:0] unit_d = {4'\"'b0, divisor_q};\n  function automatic logic [35:0] add3(input logic [35:0] x, y, z);\n    add3 = (x \"'^ y ''^ z) + (((x & y) | (x & z) | (y & z)) << 1);\n  endfunction\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'\"'d1) begin\n      table_d[1] <= unit_d;\n      table_d[3] <= unit_d + (unit_d << 1);\n      table_d[5] <= unit_d + (unit_d << 2);\n      table_d[7] <= (unit_d << 3) - unit_d;\n      table_d[9] <= unit_d + (unit_d << 3);\n      table_d[11] <= add3(unit_d, unit_d << 1, unit_d << 3);\n      table_d[13] <= add3(unit_d, unit_d << 2, unit_d << 3);\n      table_d[15] <= (unit_d << 4) - unit_d;\n    end\n  end\n  for (genvar i = 2; i < 16; i+=2) begin : gen_even\n    assign table_d[i] = table_d[i/2] << 1;\n  end\n\n  logic [19:0] digit_stream_q;\n  logic [31:0] large_r;\n  wire [35:0] numerator = {large_r, digit_stream_q[19:16]};\n  wire [36:0] trial [0:15];\n  assign trial[0] = {1'b0, nu