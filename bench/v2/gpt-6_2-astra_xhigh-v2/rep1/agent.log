{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"cp -r cores/bench/rtl cores/bench/test '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/' && cp cores/bench/rtl/alu.sv '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/alu.base.sv' && cat > '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/generate.py' <<'PY'\nfrom pathlib import Path\nroot=Path(__file__).parent\nbase=(root/'alu.base.sv').read_text()\na=base.index('  logic [31:0] divisor_q')\nb=base.index('\"'`endif'\"',a)\nbody=\\\"\\\"\\\"\n  logic [31:0] a_q, d_q, wq_q, wr_q, nq_q;\n  logic [16:0] nr_q;\n  logic want_rem_q, negate_q, zero_q, wide_q;\n  logic [34:0] mult3_q, mult5_q, mult7_q;\n  wire [34:0] d_ext = {3'b0,d_q};\n  wire [34:0] multiples[1:7];\n  assign multiples[1] = d_ext;\n  assign multiples[2] = d_ext << 1;\n  assign multiples[3] = mult3_q;\n  assign multiples[4] = d_ext << 2;\n  assign multiples[5] = mult5_q;\n  assign multiples[6] = mult3_q << 1;\n  assign multiples[7] = mult7_q;\n\n\\\"\\\"\\\"\nfor key,w in [('wide',32),('narrow',17)]:\n body+=f\\\"\\\"\\\"\n  function automatic logic [{w+2}:0] {key}_digit(input logic [{w+2}:0] t);\n    logic [{w+3}:0] trial [1:7];\n    logic [{w+2}:0] pair01, pair23, pair45, pair67;\n    for (int k=1; k<=7; k++)\n      trial[k] = {{1'b0,t}} - {{1'b0,multiples[k][{w+2}:0]}};\n    pair01 = trial[1][{w+3}] ? {{3'd0,t[{w-1}:0]}} : {{3'd1,trial[1][{w-1}:0]}};\n    pair23 = trial[3][{w+3}] ? {{3'd2,trial[2][{w-1}:0]}} : {{3'd3,trial[3][{w-1}:0]}};\n    pair45 = trial[5][{w+3}] ? {{3'd4,trial[4][{w-1}:0]}} : {{3'd5,trial[5][{w-1}:0]}};\n    pair67 = trial[7][{w+3}] ? {{3'd6,trial[6][{w-1}:0]}} : {{3'd7,trial[7][{w-1}:0]}};\n    {key}_digit = trial[4][{w+3}] ? (trial[2][{w+3}] ? pair01 : pair23)\n                                 : (trial[6][{w+3}] ? pair45 : pair67);\n  endfunction\n\\\"\\\"\\\"\nbody+=\\\"\\\"\\\"\n  wire [2:0] wd, nh, nl;\n  wire [31:0] wr_next;\n  wire [16:0] nr_mid, nr_next;\n  assign {wd,wr_next}=wide_digit({wr_q,wq_q[31:29]});\n  assign {nh,nr_mid}=narrow_digit({nr_q,nq_q[31:29]});\n  assign {nl,nr_next}=narrow_digit({nr_mid,nq_q[28:26]});\n  wire first_bit = d_q <= {31'b0,a_q[31]};\n  wire first_rem = first_bit ? a_q[31] - d_q[0] : a_q[31];\n  wire [1:0] prefix = {first_rem,a_q[30]};\n  wire second_bit = d_q <= {30'b0,prefix};\n  wire [1:0] prefix_rem = second_bit ? prefix - d_q[1:0] : prefix;\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      a_q <= neg_a ? -a : a;\n      d_q <= neg_b ? -b : b;\n      zero_q <= b == 0;\n      want_rem_q <= want_rem;\n      negate_q <= want_rem ? neg_a : ((neg_a \"'^ neg_b) && b != 0);\n    end\n    if (phase_q == 3'\"'d1) begin\n      wide_q <= |d_q[31:17];\n      mult3_q <= (d_ext << 1) + d_ext;\n      mult5_q <= (d_ext << 2) + d_ext;\n      mult7_q <= (d_ext << 3) - d_ext;\n      wr_q <= {15'b0,a_q[31:15]};\n      wq_q <= {a_q[14:0],17'b0};\n      nr_q <= {15'b0,prefix_rem};\n      nq_q <= {a_q[29:0],first_bit,second_bit};\n    end else if (div_busy && \"'!div_done) begin\n      wr_q <= wr_next;\n      wq_q <= {wq_q[28:0],wd};\n      nr_q <= nr_next;\n      nq_q <= {nq_q[25:0],nh,nl};\n    end\n  end\n  logic [31:0] magnitude;\n  assign magnitude = zero_q ? (want_rem_q ? a_q : 32'\"'hffffffff)\n                   : (wide_q ? (want_rem_q ? wr_q : wq_q)\n                             : (want_rem_q ? {15'b0,nr_q} : nq_q));\n  assign div_result = negate_q ? -magnitude : magnitude;\n\\\"\\\"\\\"\n(root/'rtl/alu.sv').write_text(base[:a]+body+base[b:])\nPY\npython '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/generate.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
