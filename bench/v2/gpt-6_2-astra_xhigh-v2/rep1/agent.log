  assert rets[3][\"cycle\"] == rets[2][\"cycle\"] + 8\n269:    assert store[\"cycle\"] == rets[3][\"cycle\"] + 1 + 5\n270:    # The final DIV can issue on the edge accepting the older store.\n271:    assert rets[5][\"cycle\"] == store[\"cycle\"] + 8\n286:    rets, _ = await _run(dut, program)\n309:    rets, _ = await _run(dut, program)\n329:    rets, _ = await _run(dut, program)\n346:    rets, dmem = await _run(dut, program)\n368:    rets, _ = await _run(dut, program)\n382:    rets, _ = await _run(dut, program)\n391:    rets, _ = await _run(dut, program, max_cycles=20)\n406:    rets, _ = await _run(dut, program)\n","exit_code":0,"status":"completed"}}
