{"type": "item.completed", "item": {"id": "item_149", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU. Division takes one issue cycle, six reciprocal-estimation rounds, and\n// one result transfer cycle. Other operations remain combinational.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu #(\n  parameter bit ENABLE_MUL = 1'b1,\n  parameter bit SHARED_DIV_MUL = 1'b0\n) (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        div_request,\n  output logic        div_busy,\n  output logic        div_done,\n  input  logic [31:0] issue_rs1,\n  input  logic [31:0] issue_rs2,\n  input  logic [63:0] mem_product,\n  output logic        div_mul_slot,\n  output logic [31:0] div_lhs,\n  output logic [31:0] div_rhs,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic [31:0] pc_plus_imm,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  // Phase 0 accepts a request. Phases 1 through 6 run the divider.\n  // In phase 7 EX owns an empty EX/MEM slot and consumes the result.\n  logic [2:0] phase_q;\n  logic div_issue;\n  logic [31:0] div_result;\n  assign div_busy  = phase_q != 3'd0;\n  assign div_done  = phase_q == 3'd7;\n  assign div_issue = div_request && !div_busy;\n\n  always_ff @(posedge clock) begin\n    if (reset) phase_q <= 3'd0;\n    else if (div_request || div_busy) phase_q <= phase_q + 3'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  assign div_mul_slot = 1'b0;\n  assign div_lhs = '0;\n  assign div_rhs = '0;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        default:  div_result <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n  end\n`else\n  logic [31:0] raw_a, raw_b;\n  logic [63:0] product;\n  if (SHARED_DIV_MUL) begin : gen_mem_product\n    assign raw_a = issue_rs1;\n    assign raw_b = issue_rs2;\n    assign product = mem_product;\n  end else begin : gen_local_product\n    logic [31:0] lhs_q, rhs_q;\n    always_ff @(posedge cloc\n…[4494 of 7566 chars elided by tools/bench/transcript.py; sha256:05833bdee6cdb1c0]…\nign div_result = want_rem_q ? (correct ? rem_corrected : rem_base) :\n                                   (correct ? quot_inc_q : quot_base_q);\n`endif\n\n  wire [32:0] mul_lhs = {(op == ALU_MULH || op == ALU_MULHSU) && a[31], a};\n  wire [32:0] mul_rhs = {op == ALU_MULH && b[31], b};\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n      ALU_AUIPC:  out = pc_plus_imm;\n\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU:\n        out = ENABLE_MUL ? multiply_result(op, mul_lhs, mul_rhs) : 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
