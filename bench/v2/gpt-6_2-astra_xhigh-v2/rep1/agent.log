{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c 'cd \"$TMPDIR/pred\" && cat > trainer.py <<'\"'PY'\nfrom pathlib import Path\nimport sys\nsrc=Path(sys.argv[1]); out=Path(sys.argv[2]);out.mkdir(exist_ok=True)\nfor f in src.glob('*.sv'): (out/f.name).write_text(f.read_text())\np=out/'if_stage.sv';s=p.read_text()\na=s.index('  always_comb begin\\\\n    next_counter');b=s.index('  for (genvar offset',a)\ns=s[:a]+'''  typedef struct packed {\n    logic [17:0] pc;\n    logic cond, jump, outcome, matching;\n    logic [17:0] target;\n    logic [31:0] word;\n  } update_t;\n  update_t first, second;\n  logic first_valid, second_valid;\n  logic [2:0] last_pattern;\n  logic [13:0] hash;\n  logic [15:0] history, new_history;\n  logic [1:0] bias, new_bias;\n  logic [15:0] second_history;\n  logic [1:0] second_bias;\n  logic [2:0] forecast_strength;\n  logic [20:0] state_q;\n  logic [13:0] old_index, next_index;\n  wire ok = train_target[31:20]==0 && train_target[1:0]==0;\n  always_ff @(posedge clock) begin\n    first <= {train_pc, conditional && ok, eligible_jump && ok, taken, counter_hit, train_target[19:2], issue_instr};\n    second <= first;\n    first_valid <= train && \"'!reset && !fence_i && !clearing;\n    second_valid <= first_valid && !reset && !fence_i && !clearing;\n    second_history <= new_history;\n    second_bias <= new_bias;\n  end\n  // Each state read and write is independent of instruction fetch.\n  (* syn_ramstyle = \"block_ram\" *) logic [20:0] local_state [0:1023];\n  always_ff @(posedge clock) begin\n    state_q <= local_state[train_pc[11:2]];\n    if (second_valid && second.cond)\n      local_state[second.pc[9:0]] <= {second_history, second_bias, forecast_strength};\n  end\n  // State can be used on an exact matching instruction. Replacement by\n  // any other instruction resets training even when it aliases the row.\n  assign {history, bias, last_pattern} = first.matching ? state_q : {16'\"'b0,2'd1,3'b0};\n  assign new_history = {history[14:0],first.outcome};\n  assign hash = {first.pc[10:0],3'b0} \"'^ first.pc[14:1];\n  assign old_index = hash ''^ history[13:0] ''^ {12'\"'b0,history[15:14]};\n  assign next_index = hash \"'^ new_history[13:0] ''^ {12'\"'b0,new_history[15:14]};\n  assign new_bias = first.outcome ? (bias==3 ? 2'd3 : bias+1'b1) :\n                                    (bias==0 ? 2'd0 : bias-1'b1);\n  logic [2:0] reinforce;\n  always_comb begin\n    if (last_pattern==0) reinforce = first.outcome ? 3'd5 : 3'd2;\n    else if (first.outcome) reinforce = last_pattern==6 ? 3'd6 : last_pattern+1'b1;\n    else reinforce = last_pattern==1 ? 3'd1 : last_pattern-1'b1;\n  end\n  logic [13:0] walk;\n  logic sweep, pattern_ready;\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) begin\n      sweep <= 1;\n      walk <= 0;\n    end else if (sweep) begin\n      sweep <= \"'!(&walk);\n      walk <= walk+1'\"'b1;\n    end\n    pattern_ready <= \"'!sweep;\n  end\n  (* syn_ramstyle = \"block_ram\" *) logic [2:0] patterns [0:16383];\n  logic [2:0] response;\n  always_ff @(posedge clock) begin\n    if (sweep || (first_valid && first.cond))\n      patterns[sweep ? walk : old_index] <= sweep ? 3'\"'d0 : reinforce;\n    response <= patterns[next_index];\n  end\n  assign forecast_strength = pattern_ready ? response : 3'd0;\n  wire forecast = (forecast_strength==6 || forecast_strength==1) ? forecast_strength==6 : second_bias[1];\n  assign next_counter = {second.jump || (second.cond && forecast), 1'b0};\n  row_t write_row;\n  assign write_row = {next_counter, second.target, demand(second.word), \"'!clearing,\n                      second.pc[17:10], second.word};\n  wire write_enable = clearing || (second_valid && !reset && !fence_i);\n  wire [9:0] write_addr = clearing ? clear_index : second.pc[9:0];\n'\"'''+s[b:];p.write_text(s)\n# Correctness of state initialization: train nonconditional first installs exact identity in instruction row,\n# but may precede the fi