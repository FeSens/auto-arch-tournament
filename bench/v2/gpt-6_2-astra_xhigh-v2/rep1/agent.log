= 3'd1) begin\n      scaled_q    <= {abs_a, 3'b000};\n      error_lhs_q <= neg_b ? raw_b : -raw_b;\n    end\n    if (seed_step) begin\n      dividend_q  <= scaled_q[34:3];\n      error_lhs_q <= error_product[31:0];\n      zero_q      <= divisor_q == 0;\n      one_q       <= divisor_q == 1;\n    end\n    if (phase_q[2:1] == 2'b01)\n      scaled_q <= {1'b0, refined[65:32]};\n    if (phase_q == 3'd3) squared_error_q <= error_product[63:32];\n    // Both special seeds are zero. Supply the architectural quotient\n    // here so A-q*D also gives the architectural remainder.\n    if (phase_q == 3'd4)\n      estimate_q <= refined[66:35] | {32{zero_q}} | ({32{one_q}} & dividend_q);\n  end\n\n  logic [32:0] a_minus_d_q;\n  logic [31:0] product_q, next_estimate_q;\n  always_ff @(posedge clock) begin\n    // Phase 5. The registered inputs hold until the next divide, so\n    // these paths can run without phase enables. P <= A fits in XLEN.\n    product_q       <= estimate_q * divisor_q;\n    next_estimate_q <= estimate_q + 32'd1;\n    a_minus_d_q     <= {1'b0, dividend_q} - {1'b0, divisor_q};\n  end\n\n  // In exact arithmetic the remaining relative error is (E/H)^4.\n  // Including truncations the estimate is exact or one low. Test the\n  // borrow of (A-D)-P while computing the uncorrected remainder A-P.\n  wire [32:0] corrected_rem = {1'b0, a_minus_d_q[31:0]} - {1'b0, product_q};\n  wire increment = !zero_q && !a_minus_d_q[32] && !corrected_rem[32];\n  logic [31:0] magnitude_q;\n  always_ff @(posedge clock)\n    if (phase_q == 3'd6) begin\n      if (want_rem_q)\n        magnitude_q <= increment ? corrected_rem[31:0] : dividend_q - product_q;\n      else\n        magnitude_q <= increment ? next_estimate_q : estimate_q;\n    end\n  assign div_result = negate_q ? -magnitude_q : magnitude_q;\n`endif\n\n  wire [32:0] mul_lhs = {(op == ALU_MULH || op == ALU_MULHSU) && a[31], a};\n  wire [32:0] mul_rhs = {op == ALU_MULH && b[31], b};\n  always_comb begin\n    shamt = b[4:0];\n\n   