{"type": "item.started", "item": {"id": "item_56", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/800f6bc6/bf54ca24/r11-divider.g7mIWusm')\ndef new_variant(name,src):\n d=p/name/'cores/bench'\n shutil.copytree('cores/bench/rtl',d/'rtl')\n shutil.copytree('cores/bench/test',d/'test')\n a=d/'rtl/alu.sv'\n t=a.read_text()\n a.write_text(t[:t.index('  logic signed_div')]+src+t[t.index('\"'`endif'\"',t.index('  logic signed_div')):])\nnew_variant('shared','''  logic signed_op, neg_a, neg_b;\n  assign signed_op = op == ALU_DIV || op == ALU_REM;\n  assign neg_a = signed_op && a[31];\n  assign neg_b = signed_op && b[31];\n\n  logic [31:0] dividend_q, divisor_less_one_q, divisor_q;\n  logic want_rem_q, negate_q, zero_q, unit_q;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dividend_q <= neg_a ? -a : a;\n      divisor_less_one_q <= neg_b ? ~b : b - 32'd1;\n      want_rem_q <= op == ALU_REM || op == ALU_REMU;\n      negate_q <= (op == ALU_REM || op == ALU_REMU) ? neg_a : neg_a \"'^ neg_b;\n      zero_q <= b == 0;\n      unit_q <= b == 1 || (neg_b && (&b));\n    end\n    if (phase_q == 1) divisor_q <= divisor_less_one_q + 1'\"'b1;\n  end\n\n  logic [10:0] index;\n  logic [4:0] shift;\n  logic [11:0] fraction;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [43:0] inverted;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign inverted = {~divisor_less_one_q, 12'b0};\n  always_comb begin\n    index = divisor_less_one_q[10:0];\n    shift = 0;\n    fraction = 0;\n    for (int i=11; i<32; i++) begin\n      if (divisor_less_one_q[i]) begin\n        shift = 5'(i-10);\n        index = divisor_less_one_q[i -: 11];\n        fraction = inverted[i-10 +: 12];\n      end\n    end\n  end\n\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] intercept [0:2047];\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [13:0] slope [0:1023];\n  for (genvar bank=0; bank<2; bank++) begin :