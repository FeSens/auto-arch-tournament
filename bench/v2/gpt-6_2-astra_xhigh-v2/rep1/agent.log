{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '390,615p' cores/bench/test/test_pipeline.py && sed -n '15,72p;148,232p' tools/eval/gowin.py && sed -n '203,270p' tools/eval/fpga.py\"", "aggregated_output": "async def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n    assert r2[\"cycle\"] == rets[0][\"cycle\"] + 2\n\n\n@cocotb.test()\nasync def taken_branch_behind_stalled_load(dut):\n    value = 0x12345678\n    program = [\n        ADDI(1, 0, 1),\n        LW(2, 0, 64),\n        BNE(1, 0, 8),    # Taken using x1 forwarded from the held MEM/WB slot.\n        SW(0, 0, 68),    # Fall-through store must never reach the bus.\n        SW(2, 0, 72),    # Target store must reach the bus exactly once.\n        EBREAK(),\n    ]\n    load_fetch_pcs = []\n    accepted = []\n    target_waits = 2\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal target_waits\n        if ren and da == 64:\n            load_fetch_pcs.append(ia)\n            if len(load_fetch_pcs) <= 3:\n                return 1, 0\n        if ren or wen:\n            accepted.append((da, ren, wen, wdata if wen else 0))\n        # The target word is ready on the edge releas\n…[15907 of 18979 chars elided by tools/bench/transcript.py; sha256:d17c65485397a496]…\ntime..stop_time) are the contract per\n    # bench/programs/coremark/baremetal/core_portme.c's start/stop_time.\n    # If both markers aren't present, the run is INVALID for fitness\n    # scoring — DO NOT fall back to total elapsed: a CPU/MMIO bug that\n    # drops 0x10000100/0x10000104 writes would silently get scored on\n    # init+CRC-printing overhead too.\n    if not marker.get('bench_bracketed', False):\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'bench_markers_missing: '\n                          f'start={marker.get(\"bench_start_cycle\")} '\n                          f'stop={marker.get(\"bench_stop_cycle\")}'}\n    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n    if elapsed_cycles <= 0:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n", "exit_code": 0, "status": "completed"}}
