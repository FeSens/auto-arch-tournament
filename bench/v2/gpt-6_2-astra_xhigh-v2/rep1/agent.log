{"type": "item.completed", "item": {"id": "item_154", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// Each source has independent EX/MEM (bit 0) and MEM/WB (bit 1) hits.\n// EX/MEM holds the younger writer and wins when both bits are set.\n//\n// Latency:        8 cycles for DIV/DIVU/REM/REMU, 1 cycle otherwise.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               operand_wait,\n  input  load_row_t          candidate,\n  input  logic               snapshot_ok,\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // Selected result in MEM/WB\n  input  logic [31:2]        wb_alu_word,\n  input  logic [31:2]        wb_mem_word,\n  input  logic               wb_mem_to_reg,\n  output ex_mem_t  out,\n  output logic               producer_writes,\n  output logic               div_wait,\n  output logic               taken,\n  output logic [31:0]        target,\n  output logic               recover_target,\n  output logic               recover_fallthrough\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = fwd_rs1_sel[0] ? fwd_ex_mem :\n               fwd_rs1_sel[1] ? fwd_mem_wb : in.rs1_val;\n  assign rs2 = fwd_rs2_sel[0] ? fwd_ex_mem :\n               fwd_rs2_sel[1] ? fwd_mem_wb : in.rs2_val;\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.c\n…[5623 of 8695 chars elided by tools/bench/transcript.py; sha256:74b9b7423d7d0603]…\nword_addr[10:2] == base_plus_imm[10:2];\n      // Capture the operands while the forwarding sources are still live.\n      // These EX/MEM fields can hold them across the invalid divider slots.\n      if (!div_busy) begin\n        reg_q.write_data <= rs2;\n        reg_q.rs1_val    <= rs1;\n        reg_q.rs2_val    <= rs2;\n      end\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= taken ? target : in.pc + 32'd4;\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= (div_wait || operand_wait) ? '0 : ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait && !operand_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
