{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/rf-structural/id-tests\"\ncat >> test/test_pipeline.py <<'\"'PY'\n\n@cocotb.test()\nasync def captured_bypass_priority_and_retained_store_operand(dut):\n    program = [\n        ADDI(1, 0, 19),\n        ADDI(1, 0, 37),\n        ADD(17, 1, 1),\n        SW(1, 0, 80),\n        ADD(18, 17, 1),\n        EBREAK(),\n    ]\n    waits = 0\n    accepted = []\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal waits\n        if wen:\n            if waits < 4:\n                waits += 1\n                return 1, 0\n            accepted.append((da, wen, wdata))\n        return 1, 1\n\n    retired, data = await _run(dut, program, bus_ready=ready)\n    assert [r['insn'] for r in retired] == program\n    assert [r['order'] for r in retired] == list(range(len(program)))\n    for i, expected in [(2, (37, 37, 74)), (4, (74, 37, 111))]:\n        assert tuple(retired[i][f] for f in ('rs1_rdata','rs2_rdata','rd_wdata')) == expected\n    assert accepted == [(80, 15, 37)]\n    assert waits == 4 and data[80] == 37\nPY\ncat >> test/test_reg_file.py <<'PY'\n\n@cocotb.test()\nasync def reset_and_bypass_across_banks(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, 'ns').start())\n    await _reset(dut)\n    await _write(dut, 5, 0x35)\n    await Timer(1, 'ns')\n    await _write(dut, 21, 0x128)\n    assert await _read(dut, 5, 21) == (0x35, 0x128)\n    dut.w_en.value = 1\n    dut.w_addr.value = 21\n    dut.w_data.value = 0x65\n    assert await _read(dut, 5, 21) == (0x35, 0x65)\n    await _reset(dut)\n    assert await _read(dut, 5, 21) == (0, 0)\n    await _write(dut, 5, 0x42)\n    assert await _read(dut, 5, 21) == (0x42, 0)\nPY\npython -m pytest -q --rootdir=. test/test_pipeline.py test/test_reg_file.py > ../cocotb-extra.log 2>&1\ntail -6 ../cocotb-extra.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
