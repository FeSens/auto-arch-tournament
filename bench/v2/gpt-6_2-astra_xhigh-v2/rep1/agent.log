{"type":"item.started","item":{"id":"item_118","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom fractions import Fraction as F\nH=2**32\nks=[0,1,3,4,5,6,8,9,10,11,13,14,15,17,18,19,20,22,23,24,26,27,29,30,31]\ntable=[(False,0,0,0)]\nboundp=(F(0),0);checks=0;corr=[0,0];printpairs={}\nfor D in range(2,129):\n M=H//D\n f=1-F(D*M,H)\n boundp=max(boundp,(F(H,D)*f**4+(2+f)*(1+f*f)/8+F(1,D),D))\n table.append((True,D,D,M))\nfor e,k in enumerate(ks,7):\n for l in range(1<<e,2<<e,1<<k):\n  u=l+(1<<k)\n  m=H//u;f=1-F(l*m,H)\n  boundp=max(boundp,(F(H,l)*f**4+(2+f)*(1+f*f)/8+F(1,l),l))\n  table.append((False,l,u,m))\nfor single,l,u,m in table[1:]:\n for d in set([l,max(l,u-1),min(u,H-1),min(u,l+1)]):\n  for q in {0,1,7,127,65535,(H-1)//d//2,(H-1)//d}:\n   for ns in (q*d-1,q*d,q*d+1,H-2,H-1):\n    if ns<0 or ns>=H:continue\n    r=H-d*m\n    a0=(ns*m)>>29;a1=(a0*(H+r))>>32\n    t=(r*r)>>32;out=(a1*(H+t))>>35\n    k=ns//d-out\n    assert k in (0,1)\n    corr[k]+=1;checks+=1\n    assert divmod(ns,d)==(out+int(ns-out*d>=d),(ns-out*d)%d)\n    if k not in printpairs:printpairs[k]=(ns,d)\nprint('max_bound',float(boundp[0]),'at',boundp[1],'vectors',checks,'correction counts',corr,'examples',printpairs)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
