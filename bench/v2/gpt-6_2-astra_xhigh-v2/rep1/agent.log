{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/quotient/generate.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nroot=Path(os.environ['TMPDIR'])/'quotient'\nbase=Path('cores/bench/rtl/alu.sv').read_text()\nnew = \\\"\\\"\\\"  logic [31:0] dividend, divisor, bypass_result;\n  logic rem_mode, neg_result, is_bypass;\n  wire signed_op = op == ALU_DIV || op == ALU_REM;\n  wire rem_op = op == ALU_REM || op == ALU_REMU;\n  wire neg_a = signed_op && a[31];\n  wire neg_b = signed_op && b[31];\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dividend <= neg_a ? -a : a;\n      divisor <= neg_b ? -b : b;\n      rem_mode <= rem_op;\n      neg_result <= rem_op ? neg_a : neg_a \"'^ neg_b;\n    end\n    if (phase_q == 1) begin\n      is_bypass <= divisor <= 1;\n      if (divisor == 0) bypass_result <= rem_mode ? (neg_result ? -dividend : dividend) : '\"'1;\n      else bypass_result <= rem_mode ? 0 : (neg_result ? -dividend : dividend);\n    end\n  end\n\n  logic [12:0] rom_index;\n  always_comb begin\n    rom_index = {1'b0, divisor[11:0]};\n\\\"\\\"\\\"\nfor e in range(12,23):\n k=2*e-23\n indexbits=e-k\n baseidx=8192-(1<<(indexbits+1))\n literal=f\\\"{13-indexbits}'d{baseidx>>indexbits}\\\"\n new+=f\\\"    if (divisor[{e}]) rom_index = {{{literal}, divisor[{e-1}:{k}]}};\\\\n\\\"\nnew+=\\\"\\\"\\\"    if (|divisor[31:23]) rom_index = 13'd8191;\n  end\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] seeds [0:8191];\n\\\"\\\"\\\"\ntable=[0]*8192\nfor d in range(2,4096):\n table[d]=(1<<32)//d\nfor e in range(12,23):\n k=2*e-23\n n=1<<(e-k); baseidx=8192-2*n\n for j in range(n):\n  upper=(1<<e)+((j+1)<<k)-1\n  table[baseidx+j]=(1<<32)//upper\n# Split constant init into manageable elaboration units.\nfor i,m in enumerate(table):\n if i%256==0: new+='  initial begin\\\\n'\n new+=f\\\"    seeds[{i}] = 32'h{m:08x};\\\\n\\\"\n if i%256==255: new+='  end\\\\n'\nnew+=\\\"\\\"\\\"\n  logic [31:0] recip, estimate;\n  logic [63:0] prod;\n  always_ff @(posedge clock) recip <= seeds[rom_index];\n  assign prod = dividend * recip;\n  logic [31:0] residual, quotient_base;\n  always_ff @(posedge clock) begin\n    if (phase_q == 2) estimate <= prod[63:32];\n    if (phase_q == 3) begin\n      residual <= dividend - estimate * divisor;\n      quotient_base <= estimate;\n    end\n  end\n\n  logic [34:0] d3, d5, d7;\n  wire [34:0] d = {3'b0, divisor};\n  always_ff @(posedge clock) begin\n    if (phase_q == 2) begin\n      d3 <= (d << 1) + d;\n      d5 <= (d << 2) + d;\n      d7 <= (d << 3) - d;\n    end\n  end\n  wire [34:0] multiples [1:7];\n  assign multiples[1] = d;\n  assign multiples[2] = d << 1;\n  assign multiples[3] = d3;\n  assign multiples[4] = d << 2;\n  assign multiples[5] = d5;\n  assign multiples[6] = d3 << 1;\n  assign multiples[7] = d7;\n\n  logic [31:0] tail_window;\n  wire [31:0] window = phase_q == 4 ? {6'b0,residual[31:6]} : tail_window;\n  wire [35:0] diff [1:7];\n  for (genvar i=1;i<=7;i=i+1) begin : gen_trial\n    assign diff[i] = {4'b0,window} - {1'b0,multiples[i]};\n  end\n  wire [34:0] pair01 = diff[1][35] ? {3'd0,window} : {3'd1,diff[1][31:0]};\n  wire [34:0] pair23 = diff[3][35] ? {3'd2,diff[2][31:0]} : {3'd3,diff[3][31:0]};\n  wire [34:0] pair45 = diff[5][35] ? {3'd4,diff[4][31:0]} : {3'd5,diff[5][31:0]};\n  wire [34:0] pair67 = diff[7][35] ? {3'd6,diff[6][31:0]} : {3'd7,diff[7][31:0]};\n  wire [2:0] digit;\n  wire [31:0] remainder;\n  assign {digit,remainder} = diff[4][35] ? (diff[2][35] ? pair01 : pair23)\n                                          : (diff[6][35] ? pair45 : pair67);\n  logic [5:0] prefix;\n  logic [8:0] corr;\n  logic [31:0] final_rem;\n  always_ff @(posedge clock) begin\n    tail_window <= {remainder[28:0],phase_q == 4 ? residual[5:3] : residual[2:0]};\n    prefix <= {prefix[2:0],digit};\n    if (phase_q == 6) begin\n      corr <= {prefix,digit};\n      final_rem <= remainder;\n    end\n  end\n  wire [31:0] magnitude = rem_mode ? final_rem : quotient_base + {23'b0,corr};\n  assign div_result = is_bypass ? bypass_result : neg_result ? -magnitude : magnitude;\n\\\"\\\"\\\"\np=root/'cores/bench/rtl/alu.sv'\np.write_text(base[:base.index('  logic signed_div')] + new + base[base.index('\"'`endif'\"\\\\n\\\\n  wire [32:0]'):])\nPY\npython \\\"\"'$TMPDIR/quotient/generate.py\"\ncat > \"$TMPDIR/quotient/route.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,json\nfrom tools.eval.gowin import build\nr=Path(os.environ['TMPDIR'])/'quotient'\nv=sys.argv[1] if len(sys.argv)>1 else ''\np=int(sys.argv[2]) if len(sys.argv)>2 else 1\nrtl=r/('cores/bench/rtl' if not v else v)\nres=build(Path.cwd(),rtl,'fpga/core_bench_si.sv',p,r/f'build{v}{p}')\nprint(json.dumps(res))\nPY\nwhich riscv32-unknown-elf-gcc\nPYTHONPATH=. python \\\"\"'$TMPDIR/quotient/route.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
