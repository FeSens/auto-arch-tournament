{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/structural_r12/bands.py\" <<'\"'PY'\nH=1<<32\ndef check(e,k,limit):\n L0=1<<e; w=1<<k; v=max(1,w>>8)\n for L in range(L0,L0*2,w):\n  U=L+w-1; C=H//U;S=H*w//U**2 if k else 0\n  for a in range(L,U+1,v):\n   if a<2: continue\n   f=(U-a)*256//w; M=C+(S*f>>8)\n   if H-M*a>limit*a: return False\n return True\ndef calc(limit):\n result=[]\n for e in range(32):\n  k=min(e,max(0,(3*e-31)//2))\n  while k>0 and not check(e,k,limit): k-=1\n  while k<e and check(e,k+1,limit): k+=1\n  result.append(k)\n return result\nif __name__=='__main__':\n for l in [3,5,7,15]:\n  ks=calc(l)\n  print(l,sum(1<<(e-k) for e,k in enumerate(ks)),ks)\nPY\npython \\\"\"'$TMPDIR/structural_r12/bands.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
