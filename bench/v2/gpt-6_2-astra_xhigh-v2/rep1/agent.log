{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r15-structural/taper.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,tempfile,shutil\nd=Path(tempfile.gettempdir())/'bench-r15-structural';name=sys.argv[1];opt=sys.argv[2] if len(sys.argv)>2 else 'sub'\nout=d/name;shutil.copytree('cores/bench/rtl',out,dirs_exist_ok=True)\np=out/'alu.sv';s=p.read_text();st=s.index('  logic [31:0] divisor_q');en=s.index('\"'`endif'\"',st)\nu='''\n  logic [31:0] dv, dq, rq;\n  logic wide,medium,tiny,neg_q,rem_q,zero;\n  logic [31:0] dividend,magic,qtiny,rtiny;\n  wire [63:0] product=dividend*magic;\n  (* syn_ramstyle=\\\"block_ram\\\" *) logic [31:0] seed[0:127];\n  initial begin\n'''\nfor i in range(128):u+=f\\\"    seed[{i}]=32'h{((2**32-1)//max(1,i)):08x};\\\\n\\\"\nu+='''\n  end\n  always_ff @(posedge clock) begin\n    seed<=seed;\n  end\n'''.replace('    seed<=seed;','    magic<=seed[dv[6:0]];')\nu+='''\n  logic [6:0] small_d;\n  always_ff @(posedge clock) begin\n    small_d<=dv[6:0];\n    if(phase_q==2) qtiny<=product[63:32];\n    if(phase_q==3) rtiny<=dividend - qtiny*small_d;\n  end\n  wire [36:0] t = wide ? {2'b0,rq,dq[31:29]} : medium ? {16'b0,rq[16:0],dq[31:28]} : {20'b0,rq[11:0],dq[31:27]};\n  wire [4:0] digit;\n  wire [31:0] rest;\n'''\n# Build an increasing set of threshold trials. On modes where a narrow threshold\n# aliases, force its borrow/failure at the decision boundary.\nW=[0]+[35]*7+[21]*8+[17]*16\nfor k in range(1,32):\n w=W[k]\n # Largest supported d tiny mode D<2\"'^12. Full bound 31*(2''^12-1) < 2''^17.\n v='\"'wide' if k<=15 else '(wide || medium)'\n u+=f\\\"  logic [{w-1}:0] m{k};\\\\n  always_ff @(posedge clock) m{k}<={w}'(dv)*{w}'d{k};\\\\n\\\"\n u+=f\\\"  wire [{w}:0] t{k}={{1'b0,t[{w-1}:0]}}-{{1'b0,m{k}}};\\\\n  wire ok{k}=\"'!t{k}[{w}]\"+(f'\"' && \"'!{v}'\"' if k in (8,16) else '')+\\\";\\\\n\\\"\n# binary tree picking largest success; the mode only needs to disable k=8 or 16\nde