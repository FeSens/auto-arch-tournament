{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/loopfeed/extra_tests.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nd=Path(sys.argv[1])\np=d/'test/test_pipeline.py'\ns=p.read_text()\ns=s.replace('max_cycles=200, bus_ready=None):','max_cycles=200, bus_ready=None, fetch_word=None):')\ns=s.replace('dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())','''word = imem.get(ia & ~3, EBREAK())\n        dut.io_imemData.value = fetch_word(ia, iready, word) if fetch_word else word''')\ni=s.index('def test_pipeline_runner():')\ns=s[:i]+'''@cocotb.test()\nasync def replay_over_imem_wait(dut):\n    program = [ADDI(1,0,4), ADDI(2,0,0), ADDI(2,2,3), SW(2,0,64),\n               ADDI(1,1,-1), BNE(1,0,-12), EBREAK()]\n    warmed = False\n    d_waits = 0\n    writes = []\n    def ready(ia, da, ren, wen, data):\n        nonlocal warmed, d_waits\n        warmed |= ia == 24\n        dr = 1\n        if wen and warmed and d_waits < 3:\n            d_waits += 1\n            dr = 0\n        if wen and dr: writes.append(data)\n        return int(not warmed or ia not in (8,12,16,20)), dr\n    def bus_word(ia, ready, word):\n        return word if ready else 0xffffffff\n    rets, _ = await _run(dut, program, bus_ready=ready, fetch_word=bus_word)\n    assert [r[\\\"pc\\\"] for r in rets] == [0,4]+4*[8,12,16,20]+[24]\n    assert all(not r[\\\"trap\\\"] for r in rets)\n    assert writes == [3,6,9,12] and d_waits == 3\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n\n@cocotb.test()\nasync def replay_fence_i(dut):\n    program=[ADDI(1,0,2), ADDI(2,2,1), ADDI(1,1,-1), BNE(1,0,-8),\n             BNE(3,0,20), ADDI(3,0,1), ADDI(1,0,2), 0x100f, BEQ(0,0,-28), EBREAK()]\n    changed = False\n    withheld = 0\n    def ready(ia,*args):\n        nonlocal changed, withheld\n        changed |= ia == 32\n        if changed and ia == 4 and withheld < 3:\n            withheld += 1\n            return 0,1\n        return 1,1\n    def word(ia, ready, insn):\n        if not ready: return 0xffffffff\n        if changed and ia == 4: return ADDI(2,2,10)\n        return insn\n    rets, _=await _run(dut,program,bus_ready=ready,fetch_word=word)\n    assert withheld == 3\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"]==4] == [1,2,12,22]\n    assert [r[\\\"insn\\\"] for r in rets if r[\\\"pc\\\"]==4] == 2*[ADDI(2,2,1)]+2*[ADDI(2,2,10)]\n    assert all(not r[\\\"trap\\\"] for r in rets)\n\n@cocotb.test()\nasync def replay_same_index_cold_hole(dut):\n    span=WINDOW_BYTES\n    second=span+4\n    tail=second+8\n    program=[ADDI(1,0,2), ADDI(2,2,1), ADDI(1,1,-1), BNE(1,0,-8), ADDI(1,0,2), JAL(0,tail-20)]\n    program+= [NOP()]*(second//4-len(program))\n    program+= [ADDI(2,2,10), ADDI(1,1,-1), BNE(1,0,-8), EBREAK()]\n    withheld=0\n    def ready(ia,*args):\n        nonlocal withheld\n        if ia==second and withheld<4:\n            withheld+=1\n            return 0,1\n        return 1,1\n    def word(ia,ready,insn): return insn if ready else 0xffffffff\n    rets, _ = await _run(dut, program, bus_ready=ready,fetch_word=word)\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"]==second] == [12,22]\n    assert withheld == 4 and all(not r[\\\"trap\\\"] for r in rets)\n\n'''.replace('WINDOW_BYTES',sys.argv[2])+s[i:]\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/loopfeed/extra_tests.py\" \"$TMPDIR/loopfeed\" 256\ncd \"$TMPDIR/loopfeed\" && PYTHONDONTWRITEBYTECODE=1 pytest --rootdir=. -p no:cacheprovider -q test/test_pipeline.py > extra_tests.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
