{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"cat tools/eval/cosim.py; cat test/conftest.py; ls cores/bench/test; printenv | rg '\"'^(GOWIN|FORMAL|RISCV_FORMAL|TARGET|HW_ROOT|HWEBENCH|REPO_ROOT|NPROC|PYTHONPATH)'\"'\"", "aggregated_output": "\"\"\"Runs Verilator cosim for all bench ELFs. Returns structured pass/fail.\n\nCorrectness is gated in two stages:\n  1. Full RVFI trace cosim for selftest and any other small ELF — every\n     retirement is diffed against the Python reference ISS.\n  2. CoreMark CRC validation via the sim's UART capture — full-trace cosim\n     of coremark.elf is skipped because the Python reference is ~10⁴× slower\n     than Verilator (would take 30+ minutes per candidate). Instead we run\n     the sim in --bench mode and verify its UART matches the canonical CRCs\n     with `validate_coremark_uart` (the same check run_fpga_eval uses). This\n     catches any CPU bug that affects CoreMark output without the full trace\n     overhead.\n\"\"\"\nimport os, subprocess, json, sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\nBENCH_DIR = Path(\"bench/programs\")\n\n\ndef _build_cosim_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `bash test/cosim/build.sh`.\n\n    Reads cores/<target>/core.yaml's `nret` (defaults to 2) and injects\n    NRET=<n> so build.sh can pass `-DNRET=<n>` to verilator. main.cpp's\n    channel-1 drain is compiled out under `#if NRET < 2`, so a single-\n    issue core (no `_1` ports) builds cleanly.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[5817 of 8889 chars elided by tools/bench/transcript.py; sha256:5e771ea974b230f7]…\nark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n\n\nif __name__ == '__main__':\n    result = run_cosim(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n_helpers.py\nconftest.py\ntest_alu.py\ntest_decoder.py\ntest_imm_gen.py\ntest_pipeline.py\ntest_reg_file.py\nGOWIN_HOME=/opt/gowin\nTARGET=bench\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv; cat tools/eval/gowin.py | head -330; cat cores/bench/core.yaml; git check-ignore -v cores/bench/implementation_notes.md; ls -l formal'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU. Division takes one issue cycle, six restoring rounds, and\n// one result transfer cycle. Other operations remain combinational.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu #(\n  parameter bit ENABLE_MUL = 1'b1\n) (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        div_request,\n  output logic        div_busy,\n  output logic        div_done,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  // Phase 0 accepts a request. Phases 1 through 6 run the divider.\n  // In phase 7 EX owns an empty EX/MEM slot and consumes the result.\n  logic [2:0] phase_q;\n  logic div_issue;\n  logic [31:0] div_result;\n  assign div_busy  = phase_q != 3'd0;\n  assign div_done  = phase_q == 3'd7;\n  assign div_issue = div_request && !div_busy;\n\n  always_ff @(posedge clock) begin\n    if (reset) phase_q <= 3'd0;\n    else if (div_request || div_busy) phase_q <= phase_q + 3'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        default:  div_result <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n  end\n`else\n  logic signed_div, want_rem, neg_a, neg_b;\n  assign signed_div = op == ALU_DIV || op == ALU_REM;\n  assign want_rem   = op == ALU_REM || op == ALU_REMU;\n  assign neg_a      = signed_div && a[31];\n  assign neg_b      = signed_div && b[31];\n\n  logic [31:0] divisor_q, remainder_q, quotient_q;\n  logic want_rem_q, negate_q;\n  logic [31:0] magnitude;\n\n  // Phase 1 starts from zero, so the two binary steps need only one\n  // and two remainder bits. Both comparisons still use the full divisor.\n  logic first_bit, first_rem, second_bit;\n  logic [1:0] prefix, prefix_rem;\n  assign first_bit  = divisor_q <= {31'b0, quotient_q[31]};\n  assign first_rem  = f\n…[15177 of 18249 chars elided by tools/bench/transcript.py; sha256:af371c416a653def]…\n freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 84.949\n  lut4: 4050\n  ff: 1046\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261119-002-r10s1\n  updated: '2026-11-19T20:42:07.945270Z'\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\ntotal 40\n-rw-rw----+ 1 nobody nogroup  2630 Nov 19 21:56 checks-deep.cfg\n-rw-rw----+ 1 nobody nogroup  2658 Nov 19 21:56 checks.cfg\n-rw-rw----+ 1 nobody nogroup  1455 Nov 19 21:56 checks_si.cfg\nlrwxrwxrwx+ 1 nobody nogroup    68 Nov 19 21:56 riscv-formal -> /srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep1/formal/riscv-formal\n-rwxrwx---+ 1 nobody nogroup 10597 Nov 19 21:56 run_all.sh\n-rw-rw----+ 1 nobody nogroup  4615 Nov 19 21:56 wrapper.sv\n-rw-rw----+ 1 nobody nogroup  2863 Nov 19 21:56 wrapper_si.sv\n", "exit_code": 0, "status": "completed"}}
