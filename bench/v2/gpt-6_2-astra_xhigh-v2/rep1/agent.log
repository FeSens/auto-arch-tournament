{"type": "item.completed", "item": {"id": "item_78", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU. Division takes one issue cycle, six arithmetic phases, and\n// one result transfer cycle. Other operations remain combinational.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu #(\n  parameter bit ENABLE_MUL = 1'b1\n) (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        div_request,\n  output logic        div_busy,\n  output logic        div_done,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  // Phase 0 accepts a request. Phases 1 through 6 run the divider.\n  // In phase 7 EX owns an empty EX/MEM slot and consumes the result.\n  logic [2:0] phase_q;\n  logic [31:0] div_result;\n  assign div_busy  = phase_q != 3'd0;\n  assign div_done  = phase_q == 3'd7;\n\n  always_ff @(posedge clock) begin\n    if (reset) phase_q <= 3'd0;\n    else if (div_request || div_busy) phase_q <= phase_q + 3'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  wire div_issue = div_request && !div_busy;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        default:  div_result <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n  end\n`else\n  logic [31:0] raw_a_q, raw_b_q, dividend_q, divisor_q;\n  logic neg_a_q, neg_b_q, want_rem_q, negate_q;\n  logic zero_q, unit_q;\n  wire signed_div = op == ALU_DIV || op == ALU_REM;\n\n  always_ff @(posedge clock) begin\n    if (!div_busy) begin\n      raw_a_q <= a;\n      raw_b_q <= b;\n      neg_a_q <= signed_div && a[31];\n      neg_b_q <= signed_div && b[31];\n      want_rem_q <= op == ALU_REM || op == ALU_REMU;\n    end\n    if (phase_q == 3'd1) begin\n      dividend_q <= neg_a_q ? -raw_a_q : raw_a_q;\n      divisor_q <= neg_b_q ? -raw_b_q : raw_b_q;\n      negate_q <= want_rem_q ? neg_a_q : (neg_a_q ^ neg_b_q) && raw_b_q != 0;\n    end\n    if (phase_q == 3'd2) begin\n     \n…[6138 of 9210 chars elided by tools/bench/transcript.py; sha256:245a86b0d9cb6256]…\ne_q <= want_rem_q ? '0 : dividend_q;\n      else magnitude_q <= want_rem_q ? corrected[31:0] : quotient;\n    end\n  end\n  assign div_result = negate_q ? -magnitude_q : magnitude_q;\n`endif\n\n  wire [32:0] mul_lhs = {(op == ALU_MULH || op == ALU_MULHSU) && a[31], a};\n  wire [32:0] mul_rhs = {op == ALU_MULH && b[31], b};\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU:\n        out = ENABLE_MUL ? multiply_result(op, mul_lhs, mul_rhs) : 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
