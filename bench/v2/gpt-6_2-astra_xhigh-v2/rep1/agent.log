{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"cat >> /srv/hwebench/tmp/800f6bc6/1e98df49/bench-predict-r5-rAxhvuCd/cores/bench/test/test_pipeline.py <<'PY'\n\n@cocotb.test()\nasync def trained_forward_branch_releases_to_held_recovery_pc(dut):\n    # Branch is taken 4 times and then falls through. Each trip puts a load\n    # immediately before it. Use both instruction and data waits on its exit.\n    prefix = [NOP()] * 68\n    start = len(prefix) * 4\n    test = [\n        ADDI(1, 0, 4),\n        LW(6, 0, 128),\n        BNE(1, 0, 12),\n        SW(6, 0, 140),\n        EBREAK(),\n        SW(1, 0, 136),\n        ADDI(1, 1, -1),\n        JAL(0, -24)\n    ]\n    store_log = []\n    read_log = []\n    waits = 3\n    iwaits = 2\n    fifth_load_active = False\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal waits, iwaits, fifth_load_active\n        if ren and da == 128:\n            if len(read_log) == 4:\n                fifth_load_active = True\n                if waits:\n                    waits -= 1\n                    return 0, 0\n            read_log.append(da)\n        if fifth_load_active and not ren and ia == start + 12 and iwaits:\n            iwaits -= 1\n            return 0, 1\n        if wen:\n            store_log.append((da, wdata))\n        return 1, 1\n\n    rets, mem = await _run(dut, prefix + test, {128: 77}, bus_ready=ready)\n    assert waits == iwaits == 0\n    assert store_log == [(136, i) for i in (4, 3, 2, 1)] + [(140, 77)]\n    assert mem[136] == 1 and len(read_log) == 5\n    branches = [r for r in rets if r[\\\"pc\\\"] == start + 8]\n    assert len(branches) == 5\n    assert [r[\\\"pc_next\\\"] for r in branches] == [start+20] * 4 + [start+12]\n    for r in branches[1:4]:\n        successor = rets[r[\\\"order\\\"] + 1]\n        assert successor[\\\"cycle\\\"] == r[\\\"cycle\\\"] + 1\n    for i,(a,b) in enumerate(zip(rets,rets[1:])):\n        assert a[\\\"order\\\"] == i and a[\\\"pc_next\\\"] == b[\\\"pc\\\"] and a[\\\"trap\\\"] == 0\n\n@cocotb.test()\nasync def predictions_keep_full_direct_targets_and_traps(dut):\n    # Cross the 8 KiB boundary both ways, then exercise JALR forwarding,\n    # the bit-zero mask and a trapping misaligned JAL with suppressed link.\n    prefix = [JAL(1, 8192), ADDI(3, 0, 1), BEQ(3, 0, -512),\n              ADDI(4, 0, 25), JALR(5, 4, 0), SW(0, 0, 64),\n              JAL(9, 2), BEQ(0, 0, 2), EBREAK()]\n    prog = prefix + [NOP()] * (2048-len(prefix)) + [JAL(2, 4-8192)]\n    addresses = []\n    def ready(ia, da, ren, wen, wd):\n        addresses.append(ia)\n        assert ia < 0x100000 and ia % 4 == 0\n        assert not wen\n        return 1, 1\n    r,_ = await _run(dut,prog,bus_ready=ready)\n    assert [x[\\\"pc\\\"] for x in r] == [0,8192,4,8,12,16,24,28,32]\n    assert [x[\\\"trap\\\"] for x in r] == [0,0,0,0,0,0,1,1,0]\n    assert [x[\\\"order\\\"] for x in r] == list(range(len(r)))\n    assert [(r[i][\\\"rd\\\"], r[i][\\\"rd_wdata\\\"]) for i in (0,1,5,6)] == [\n        (1,4),(2,8196),(5,20),(0,0)]\n    assert r[0][\\\"cycle\\\"] + 1 == r[1][\\\"cycle\\\"] == r[2][\\\"cycle\\\"] - 1\n    assert all(x[\\\"pc_next\\\"] == y[\\\"pc\\\"] for x,y in zip(r,r[1:]))\nPY\ncd /srv/hwebench/tmp/800f6bc6/1e98df49/bench-predict-r5-rAxhvuCd && pytest -q cores/bench/test > banks/tests.log 2>&1 && tail -3 banks/tests.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
