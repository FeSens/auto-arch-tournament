q <= neg_b ? ~b : b - 32'd1;\n@@\n     end\n     if (phase_q == 3'd1) begin\n       divisor_q <= divisor_minus_one_q + 32'd1;\n-      // Correct a negative remainder by adding D, a positive one by\n-      // adding -D. Complementing D-1 gives -D without a second carry.\n-      remainder_adjust_q <= negate_q ? divisor_minus_one_q + 32'd1 : ~divisor_minus_one_q;\n-      div_by_zero_q <= &divisor_minus_one_q;\n+      quotient_by_zero_q <= (&divisor_minus_one_q) && !want_rem_q;\n       rom_word_q <= reciprocal_rom[rom_index];\n       shift_q <= shift;\n     end\n@@\n   // are all the quotient candidates needed in the transfer cycle.\n   // The bucket error bound gives q1 < 2048 (checked in test_alu).\n   wire [31:0] last_term = {21'b0, estimate_q[10:0]} ^ {32{negate_q}};\n-  wire [31:0] sum_base = first_term_q + last_term;\n-  wire [31:0] sum_next = first_term_q - ~last_term;\n-  logic [31:0] base_result_q, corrected_quotient_q, remainder_q;\n+  logic [31:0] quotient_base_q, quotient_next_q, remainder_q, neg_remainder_q;\n   always_ff @(posedge clock) begin\n     if (div_issue)\n       x_q <= neg_a ? -a : a;\n@@\n     if (phase_q == 3'd4)\n       first_term_q <= negate_q ? -estimate_q : estimate_q;\n     if (phase_q == 3'd6) begin\n+      quotient_base_q <= first_term_q + last_term;\n+      quotient_next_q <= first_term_q - ~last_term;\n       remainder_q <= residual;\n-      if (want_rem_q)\n-        base_result_q <= negate_q ? divisor_product - x_q : residual;\n-      else\n-        base_result_q <= negate_q ? sum_next : sum_base;\n-      corrected_quotient_q <= div_by_zero_q ? 32'hffff_ffff :\n-                              negate_q ? sum_base : sum_next;\n+      neg_remainder_q <= divisor_product - x_q;\n     end\n   end\n \n   // For D>0 the two estimates leave R < 2D. The borrow selects\n   // the exact quotient or remainder, with -(R-D) = (-R)+D.\n-  wire borrow = remainder_q < divisor_q;\n-  // D=0 always takes the correction. The remainder adjustment is\n-  // then zero, so REM returns the original signed dividend.\n-  assign div_result = borrow ? base_result_q :\n-                      want_rem_q ? base_result_q + remainder_adjust_q : corrected_quotient_q;\n+  wire [32:0] difference = {1'b0, remainder_q} - {1'b0, divisor_q};\n+  // With D=0, both products by D and the remainder correction are zero.\n+  // REM therefore returns rs1, while DIV selects the all-ones result.\n+  always_comb begin\n+    if (quotient_by_zero_q)\n+      div_result = 32'hffff_ffff;\n+    else if (want_rem_q) begin\n+      if (difference[32])\n+        div_result = negate_q ? neg_remainder_q : remainder_q;\n+      else\n+        div_result = negate_q ? neg_remainder_q + divisor_q : difference[31:0];\n+    end else if (difference[32] == negate_q)\n+      div_result = quotient_next_q;\n+    else\n+      div_result = quotient_base_q;\n+  end\n `endif\n \n   always_comb begin\n", "exit_code": 0, "status": "completed"}}
