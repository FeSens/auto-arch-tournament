{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/successor_checks.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def successor_source_alias_rejects_foreign_destination(dut):\n    other = 0x1000\n    words = {\n        0: ADDI(1,0,2), 4: ADDI(2,2,1), 8: NOP(), 12: NOP(),\n        16: ADDI(3,2,7), 20: BEQ(2,1,12), 24: JAL(0,other+8-24), 32: EBREAK(),\n        other+8: NOP(), other+12: NOP(), other+16: SW(2,0,84),\n        other+20: JAL(0,4-(other+20)),\n    }\n    program = [words.get(pc, NOP()) for pc in range(0,other+24,4)]\n    visits, waits, stores = 0,0,[]\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal visits, waits\n        visits += ia == 12\n        if wen:\n            stores.append((da,wdata))\n        if visits == 2 and ia == 16 and waits < 3:\n            waits += 1\n            return 0,1\n        return 1,1\n    rets,_ = await _run(dut,program,bus_ready=ready,initial_imem_wait=1200)\n    _check_loop_path(rets, [0,4,8,12,16,20,24,other+8,other+12,other+16,other+20,4,8,12,16,20,32])\n    assert stores == [(84,1)] and waits == 3\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 16] == [8,9]\n\n@cocotb.test()\nasync def successor_invalidated_across_full_fence_sweep(dut):\n    old, new = ADDI(3,3,1), ADDI(3,3,11)\n    program=[LW(5,0,64), ADDI(1,0,2), ADDI(2,2,1),NOP(),old,\n             BEQ(2,1,20), SW(5,0,16),0x0000100f,JAL(0,8-32),SW(0,0,124), EBREAK()]\n    writes,holds,waits=[],0,0\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal holds,waits\n        if wen:\n            assert (da,wen,wdata) == (16,15,new)\n            writes.append(da)\n            program[4]=new\n        if writes and ia==32 and holds<1200:\n            holds+=1\n            return 0,1\n        if writes and ia==16 and waits<3:\n            waits+=1\n            return 0,1\n        return 1,1\n    rets,_ = await _run(dut,program,{64:new},bus_ready=ready,initial_imem_wait=1200,max_cycles=1400)\n    _check_loop_path(rets,[0,4,8,12,16,20,24,28,32,8,12,16,20,40])\n    assert writes==[16] and holds==1200 and waits==3\n    assert [(r[\\\"insn\\\"],r[\\\"rd_wdata\\\"]) for r in rets if r[\\\"pc\\\"]==16]==[(old,1),(new,12)]\nPY\ncat > \\\"\"'$TMPDIR/check_successor.sh\" <<'\"'SH'\nset -eu\nresearch_dir=\\\"\"'$TMPDIR/$1\"\nmkdir -p \"$research_dir/cores/bench/test\"\ncp cores/bench/test/*.py \"$research_dir/cores/bench/test/\"\ncat \"$TMPDIR/successor_checks.py\" >> \"$research_dir/cores/bench/test/test_pipeline.py\"\ncd \"$research_dir/cores/bench\"\npytest --rootdir=. -q test > \"$research_dir/test.log\" 2>&1\nSH\ncat > \"$TMPDIR/formal_successor.sh\" <<'\"'SH'\nset -eu\nresearch_dir=\\\"\"'$TMPDIR/$1\"\nmkdir -p \"$research_dir/formal/riscv-formal/cores\"\ncp -r \"$TMPDIR/successor/formal/riscv-formal/checks\" \"$TMPDIR/successor/formal/riscv-formal/insns\" \"$research_dir/formal/riscv-formal/\"\ncp formal/run_all.sh formal/checks_si.cfg formal/wrapper_si.sv \"$research_dir/formal/\"\ncp cores/bench/core.yaml \"$research_dir/cores/bench/\"\ncd \"$research_dir\"\nRTL_DIR=cores/bench/rtl CORE_NAME=bench JOBS=8 bash formal/run_all.sh > formal.log 2>&1\nSH\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
