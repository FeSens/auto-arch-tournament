{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python3 -c 'import numpy as np\nH = 1 << 32\ncount = 0\nfor s in range(22):\n    fbits = min(s, 12)\n    subbin = 1 << (s - fbits)\n    offsets = np.arange(1 << fbits, dtype=np.int64) * subbin\n    fractions = ((1 << fbits) - 1 - np.arange(1 << fbits, dtype=np.int64)) << (12 - fbits)\n    for j in range(1 if s == 0 else 1024, 2048):\n        k = j + 1\n        lo = (j << s) + 1 + offsets\n        hi = np.minimum(lo + subbin - 1, H - 1)\n        keep = lo <= hi\n        C = H // k if j < 1024 else 4 * H // k\n        S = 0 if j < 1024 else 4 * H // (k * k)\n        scale = 0 if j < 1024 else s + 2\n        M = ((C + ((S * fractions[keep]) >> 12)) >> scale) + 1\n        assert np.all(M * lo[keep] - H > -lo[keep])\n        assert np.all(M * hi[keep] - H <= hi[keep])\n        count += int(keep.sum())\nprint(f\\\"Verified reciprocal error bounds for {count:,} fractional bins\\\")'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
