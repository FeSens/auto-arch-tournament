{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/gold/integrate.py\" <<'\"'PY'\nimport sys, os\nfrom pathlib import Path\nfrom shutil import copytree\nbase=Path(__file__).parent\nmode=sys.argv[1]\ndest=base/mode\ncopytree(base/('p3raw' if 'ded' not in mode else 'dedicatedraw'),dest,dirs_exist_ok=True)\ns=(dest/'alu.sv').read_text()\ns=s.replace(\\\"parameter bit ENABLE_MUL = 1'b1\\\",\\\"parameter bit EX_OPERANDS = 1'b0,\\\\n  parameter bit ENABLE_MUL = 1'b1\\\")\ns=s.replace(\\\"  input  logic [4:0]  op,\\\", \\\"  input  logic [31:0] saved_rs1, saved_rs2,\\\\n  input  logic [4:0]  op,\\\")\nstart=s.index('  logic [31:0] raw_a,raw_b;');end=s.index('  always_ff @(posedge clock) if (phase_q == 1)',start)\ns=s[:start]+\\\"\\\"\\\"\n  logic [31:0] raw_a, raw_b;\n  logic sa,sb,sd_q;\n  if (EX_OPERANDS) begin\n    assign raw_a = saved_rs1;\n    assign raw_b = saved_rs2;\n  end else begin\n    always_ff @(posedge clock) if (div_issue) begin\n      raw_a <= a; raw_b <= b;\n    end\n  end\n  assign sa = sd_q && raw_a[31];\n  assign sb = sd_q && raw_b[31];\n  always_ff @(posedge clock) if (div_issue) begin\n    sd_q <= sd;\n    need_rem <= rem_op;\n  end\n\\\"\\\"\\\"+s[end:]\nif 'compact' in mode:\n import math\n from fractions import Fraction\n H=1<<32\n wtab=[0,1,3,4,5,6,8,9,10,11,13,14,15,17,18,19,20,22,23,24,26,27,29,30,31]\n values=[0]*256\n for x in range(128):\n  for sb in (0,1):\n   d=x+sb\n   values[128*sb+x]=0 if d<2 else H//d\n addr=[]\n for e,k in sorted(enumerate(wtab,7),key=lambda pair:pair[1]-pair[0]):\n  m=e-k;w=1<<k;off=len(values)\n  assert off%(1<<m)==0\n  addr.append(f\\\"      32'b{'0'*(31-e)}1{'?'*e}: ix = \\\"+(f\\\"{{{10-m}'d{off>>m},xi[{e-1}:{k}]}};\\\" if m else f\\\"10'd{off};\\\"))\n  for l in range(1<<e,2<<e,w):\n   v=H//(l+w);f=1-Fraction(l*v,H)\n   assert Fraction(H,l)*f**4+(2+f)*(1+f*f)/8+Fraction(1,l)<1\n   values.append(v)\n st=s.index('    casez (xi)');en=s.index('  logic special;',st)\n s=s[:st]+'    casez (xi)\\\\n'+'\\\\n'.join(addr)+\\\"\\\\n      default: ix = {2'b00,sb,xi[6:0]};\\\\n    endcase\\\\n  end\\\\n\\\"+'  (* syn_ramstyle=\\\"block_ram\\\" *) logic [31:0] seeds [0:1023];\\\\n  initial begin\\\\n'+'\\\\n'.join(f\\\"    seeds[{i}]=32'h{val:08x};\\\" for i,val in enumerate(values))+'\\\\n  end\\\\n  always_ff @(posedge clock) seed <= seeds[ix];\\\\n'+s[en:]\nif 'two' in mode:\n st=s.index('  wire [33:0] num =');en=s.index('  logic [31:0] qd,qinc,mag;',st)\n s=s[:st]+\\\"\\\"\\\"\n  logic [33:0] num;\n  logic [32:0] factor;\n  always_comb begin\n    case(phase_q)\n      2: begin num={2'b0,a_q}; factor={1'b0,seed}; end\n      5: begin num={2'b0,q}; factor={1'b0,d}; end\n      default: begin num=head; factor={1'b1,err}; end\n    endcase\n  end\n  wire [66:0] prod=num*factor;\n  wire [31:0] ex=phase_q==2 ? neg_d : err;\n  wire [31:0] ey=phase_q==2 ? seed : err;\n  wire [63:0] ep=ex*ey;\n  always_ff @(posedge clock) begin\n    if (phase_q==2) head<=prod[62:29];\n    else head<=prod[65:32];\n    err<=phase_q==2 ? ep[31:0] : ep[63:32];\n    if (phase_q==4) q<=prod[66:35];\n  end\n\\\"\\\"\\\"+s[en:]\n s=s.replace('    qd <= q*d;', '    qd <= prod[31:0];')\n(dest/'alu.sv').write_text(s)\ns=(dest/'ex_stage.sv').read_text().replace(\\\"alu #(.ENABLE_MUL(1'b0))\\\", \\\"alu #(.EX_OPERANDS(1'b1), .ENABLE_MUL(1'b0))\\\").replace('    .a   (alu_a),','    .saved_rs1 (reg_q.rs1_val),\\\\n    .saved_rs2 (reg_q.rs2_val),\\\\n    .a   (alu_a),')\n(dest/'ex_stage.sv').write_text(s)\nPY\nfor m in excompacttwo excompact3 excompactded exdualtwo; do python \\\"\"'$TMPDIR/gold/integrate.py\" \"$m\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
