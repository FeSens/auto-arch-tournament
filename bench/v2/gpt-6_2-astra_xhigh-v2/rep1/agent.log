{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/hazard_unit.sv'","aggregated_output":"// rtl/hazard_unit.sv\n//\n// A consumer that needs a pending MEM result in EX waits one cycle.\n// A redirect also discards the fetch on the edge the branch leaves EX.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_late_result,\n  input  logic [4:0] id_ex_rd,          // producer's destination\n  input  logic       depends_on_rd,     // fetch rs1 or rs2 matches the EX destination\n  input  logic       redirect,          // EX has resolved a branch/jump\n  input  logic       fence_i,           // valid FENCE.I in EX\n  input  logic       serialize,         // following DIV/REM or FENCE.I\n  input  logic       replay,\n  output logic       needs_replay,\n  input  logic       div_wait,          // DIV/REM occupies ID/EX\n  input  logic       fetch_valid,       // live bus word or exact predictor hit\n  input  logic       dmem_ready,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       bubble_id,         // discard fetch when ID/EX advances\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic imem_stall;\n  logic dmem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_late_result && depends_on_rd && id_ex_rd != 5'b0;\n    imem_stall = !fetch_valid;\n    // dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n    dmem_stall = !dmem_ready && ex_mem_mem_op;\n\n    // The PC gives redirect priority over these interlocks.\n    // Issuing FENCE.I advanced IF to fence PC+4. Hold that PC and\n    // discard its pre-fence fetch on the edge that lets the fence leave EX.\n    needs_replay  = load_use_hazard || serialize;\n    stall_if      = replay || imem_stall || dmem_stall || div_wait || fence_i;\n    stall_id      = dmem_stall || div_wait || replay;\n    bubble_id     = redirect || fence_i;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"sed -n '38,62p;96,146p' cores/bench/rtl/ex_stage.sv\"","aggregated_output":"  output logic               recover_target,\n  output logic               recover_fallthrough\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  ex_mem_t reg_q;\n  logic late_binary;\n  assign late_rs1 = fwd_rs1_sel[0] && reg_q.ctrl.mem_to_reg;\n  assign late_rs2 = fwd_rs2_sel[0] && reg_q.ctrl.mem_to_reg;\n  assign late_binary = late_rs1 || late_rs2;\n  assign defer_add = in.is_add && (late_rs1 || (!in.ctrl.alu_src && late_rs2));\n  assign defer_branch = in.ctrl.is_branch && !in.ctrl.branch_op[2] && late_binary;\n\n  assign rs1 = ({32{fwd_rs1_sel[0]}} & fwd_ex_mem) |\n               ({32{fwd_rs1_sel[1]}} & fwd_mem_wb) |\n               ({32{fwd_rs1_sel[2]}} & in.rs1_val);\n  assign rs2 = ({32{fwd_rs2_sel[0]}} & fwd_ex_mem) |\n               ({32{fwd_rs2_sel[1]}} & fwd_mem_wb) |\n               ({32{fwd_rs2_sel[2]}} & in.rs2_val);\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n  assign equal_hi = rs1[31:16] == rs2[31:16];\n  assign equal_lo = rs1[15:0] == rs2[15:0];\n  assign less_hi  = rs1[31] != rs2[31] ? rs1[31] ^ in.ctrl.branch_op[1] :\n                                         rs1[30:16] < rs2[30:16];\n  assign less_lo  = rs1[15:0] < rs2[15:0];\n  assign less     = less_hi || (equal_hi && less_lo);\n\n  always_comb begin\n    branch_cond   = (in.ctrl.branch_op[2] ? less : equal_hi && equal_lo) ^ in.ctrl.branch_op[0];\n    branch_taken  = in.ctrl.is_branch && !defer_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    base_plus_imm = (word_handoff ? raw_word : rs1) + in.imm;\n    target = in.ctrl.is_jalr ? {base_plus_imm[31:1], 1'b0} : branch_target;\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic transfer;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  assign transfer = branch_taken || in.ctrl.is_jump;\n  assign misalign_fault = transfer && target[1:0] != 2'b00;\n\n  always_comb begin\n    ctrl_with_trap = in.ctrl;\n    ctrl_with_trap.mem_to_reg = in.ctrl.mem_to_reg || defer_add;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n  // Suppress a trapping load before the ID forwarding comparisons latch.\n  // An older matching writer in WB can then supply the preserved register.\n  logic load_misaligned;\n  assign load_misaligned = in.ctrl.mem_read &&\n                          ((in.ctrl.mem_width == 2 && base_plus_imm[1:0] != 0) ||\n                           (in.ctrl.mem_width == 1 && base_plus_imm[0]));\n  assign producer_writes = !annul && ctrl_with_trap.reg_write && !load_misaligned;\n  assign aligned_lw = !annul && in.ctrl.mem_read && in.ctrl.mem_width == 2 &&\n                      base_plus_imm[1:0] == 0;\n\n  // The tag and identical instruction fix the target of a direct transfer.\n  // For JALR with no offset, compare all producers while bypass selects\n  // settle. JALR clears bit 0 and the trap logic checks bit 1.\n  logic [31:2] saved_word_addr;\n  logic wb_match, base_match;\n","exit_code":0,"status":"completed"}}
