{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/replay-study\" && cat > generate_wb.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nfor n in ('wb','wbor'):\n v=Path(n)\n shutil.copytree('cores/bench/rtl',v)\n p=v/'mem_stage.sv'\n s=p.read_text().replace('      reg_q.alu_result <= in.alu_result;\\\\n','')\n a=s.index('      reg_q.read_data  <=')\n b=s.index('      reg_q.rd ',a)\n if n=='wb':\n  expr=\\\"\\\"\\\"      reg_q.read_data  <= in.ctrl.mem_read ? load_data :\n                          in.ctrl.mem_to_reg ? multiply_result(in.ctrl.alu_op, in.rs1_val, in.rs2_val) :\n                          in.alu_result;\n\\\"\\\"\\\"\n else:\n  expr=\\\"\\\"\\\"      reg_q.read_data  <= ({32{in.ctrl.mem_read}} & load_data)\n                        | ({32{\"'!in.ctrl.mem_to_reg}} & in.alu_result)\n                        | ({32{in.ctrl.mem_to_reg && !in.ctrl.mem_read}}\n                           & multiply_result(in.ctrl.alu_op, in.rs1_val, in.rs2_val));\n\"\"\"\n p.write_text(s[:a]+expr+s[b:])\n p=v/'\"'wb_stage.sv'\n p.write_text(p.read_text().replace('in.ctrl.mem_to_reg ? in.read_data : in.alu_result','in.read_data'))\nPY\npython generate_wb.py && cp -r cores/bench/rtl champion && cat > fast_jalr.py <<'PY'\nfrom pathlib import Path\nimport shutil\nfor n in ('indirect','relative','segcompare','chunks'):\n v=Path(n);shutil.copytree('cores/bench/rtl',v)\n p=v/'ex_stage.sv'; s=p.read_text()\n if n=='chunks':\n  a=s.index('  always_comb begin',s.index('logic [31:0] base_plus_imm;'))\n  s=s[:a]+'''  logic [32:0] carry;\n  assign carry[0] = 1'b0;\n  for (genvar i = 0; i < 32; i = i+8) begin: base_sum\n    wire [7:0] x = rs1[i+:8], y = in.imm[i+:8];\n    wire g = x > ~y;\n    wire t = &(x \"'^ y);\n    assign carry[i+8] = g || (t && carry[i]);\n    assign base_plus_imm[i+:8] = x + y + carry[i];\n  end\n'\"'''+s[a:]\n  p.write_text(s.replace('    base_plus_imm = rs1 + in.imm;',''))\n  continue\n a=s.index('  assign target_match')\n b=s.index('  assign recover_target',a)\n if n=='indirect':\n  expr='''  wire direct_match = {12'b0, in.prediction.target} == branch_target[31:2];\n  wire indirect_match = in.instr[31:20] == 0 && {12'b0,in.prediction.target} == rs1[31:2];\n  assign target_match = in.ctrl.is_jalr ? indirect_match : direct_match;\n'''\n elif n=='relative':\n  # Precompute expected base ignoring bit zero; low-bit carry correction from rs1[0] & imm[0]\n  # For odd imm, two source values differ in upper 31 bits so compare rs1+1 to expected.\n  expr='''  wire direct_match = {12'b0, in.prediction.target} == branch_target[31:2];\n  wire [31:0] expected_target = {12'b0,in.prediction.target,2'b00};\n  wire [31:0] predicted_base = expected_target - in.imm;\n  wire [31:0] predicted_base1 = predicted_base + 32'd1;\n  assign target_match = in.ctrl.is_jalr ?\n      (rs1 == predicted_base || rs1 == predicted_base1) : direct_match;\n'''\n elif n=='segcompare':\n  expr='''  wire [31:0] expected = {12'b0, in.prediction.target, 2'b00};\n  wire [31:0] c = rs1 \"'^ in.imm ''^ expected;\n  wire [31:0] d = (rs1 & in.imm) | ((rs1 | in.imm) & ~expected);\n  wire indirect_match = c[31:1] == {d[30:1], rs1[0] & in.imm[0]};\n  wire direct_match = {12'\"'b0, in.prediction.target} == branch_target[31:2];\n  assign target_match = in.ctrl.is_jalr ? indirect_match : direct_match;\n'''\n p.write_text(s[:a]+expr+s[b:])\nPY\npython fast_jalr.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
