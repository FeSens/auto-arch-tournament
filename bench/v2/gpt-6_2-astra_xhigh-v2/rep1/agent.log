a, raw_b;\n  logic [31:0] held_lhs;\n  logic [63:0] product;\n  if (SHARED_DIV_MUL) begin : gen_mem_product\n    assign raw_a = issue_rs1;\n    assign raw_b = issue_rs2;\n    assign product = mem_product;\n    assign held_lhs = mem_div_lhs;\n  end else begin : gen_local_product\n…[4647 of 7719 chars elided by tools/bench/transcript.py; sha256:6177e65a98904360]…\nisor_q - r1_q : r1_q - divisor_q;\n  assign div_result = want_rem_q ? (correct ? rem_corrected : rem_base) :\n                                   (correct ? quot_inc_q : quot_base_q);\n`endif\n\n  wire [32:0] mul_lhs = {(op == ALU_MULH || op == ALU_MULHSU) && a[31], a};\n  wire [32:0] mul_rhs = {op == ALU_MULH && b[31], b};\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL, ALU_SRA:\n        out = 32'($signed({op == ALU_SRA && a[31], a}) >>> shamt);\n      ALU_LUI:    out = b;\n\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU:\n        out = ENABLE_MUL ? multiply_result(op, mul_lhs, mul_rhs) : 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
