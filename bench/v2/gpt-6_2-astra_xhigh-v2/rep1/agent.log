   = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[18182 of 21254 chars elided by tools/bench/transcript.py; sha256:41bcd606af42eca7]…\n] * 4 and waits == {24: 0, 4: 0}\n    assert [(r[\"insn\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 4] == [\n        (old, 1), (new, 10)\n    ]\n\n\n@cocotb.test()\nasync def cold_jump_to_resident_words(dut):\n    program = [\n        ADDI(2, 0, 2), JAL(0, 28), *([NOP()] * 6),\n        ADDI(1, 1, 1), SW(1, 0, 64), BEQ(1, 2, 16), JAL(5, -12),\n        SW(0, 0, 124), NOP(), EBREAK(),\n    ]\n    cold_jump = False\n    withheld, stores = [], []\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal cold_jump\n        cold_jump |= ia == 48\n        if wen:\n            stores.append((da, wen, wdata))\n        if cold_jump and ia in (32, 36):\n            withheld.append(ia)\n            return 0, 1\n        return 1, 1\n\n    rets, _ = await _run(dut, program, bus_ready=ready, initial_imem_wait=SWEEP_CYCLES)\n    pcs = [0, 4, 32, 36, 40, 44, 32, 36, 40, 56]\n    _check_loop_path(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert withheld == [32, 36] and stores == [(64, 15, 1), (64, 15, 2)]\n", "exit_code": 0, "status": "completed"}}
