{"type": "item.completed", "item": {"id": "item_154", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU. Division takes one issue cycle, six reciprocal-estimation rounds, and\n// one result transfer cycle. Other operations remain combinational.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu #(\n  parameter bit ENABLE_MUL = 1'b1,\n  parameter bit SHARED_DIV_MUL = 1'b0\n) (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        div_request,\n  output logic        div_busy,\n  output logic        div_done,\n  input  logic [31:0] issue_rs1,\n  input  logic [31:0] issue_rs2,\n  input  logic [63:0] mem_product,\n  output logic        div_mul_slot,\n  output logic [31:0] div_lhs,\n  output logic [31:0] div_rhs,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic [31:0] pc_plus_imm,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  // Phase 0 accepts a request. Phases 1 through 6 run the divider.\n  // In phase 7 EX owns an empty EX/MEM slot and consumes the result.\n  logic [2:0] phase_q;\n  logic div_issue;\n  logic [31:0] div_result;\n  assign div_busy  = phase_q != 3'd0;\n  assign div_done  = phase_q == 3'd7;\n  assign div_issue = div_request && !div_busy;\n\n  always_ff @(posedge clock) begin\n    if (reset) phase_q <= 3'd0;\n    else if (div_request || div_busy) phase_q <= phase_q + 3'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  assign div_mul_slot = 1'b0;\n  assign div_lhs = '0;\n  assign div_rhs = '0;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        default:  div_result <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n  end\n`else\n  logic [31:0] raw