{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport itertools, random\nrng = random.Random(0)\nmask = 2**32-1\nedges = [0,1,2,3,4,5,0x55555555,0x7fffffff,0x80000000,0xaaaaaaab,mask]\npairs = list(itertools.product(edges, repeat=2))\npairs.extend((rng.getrandbits(32), rng.getrandbits(rng.randrange(1,33))) for _ in range(16384))\nfor a,b in pairs:\n for signed in (False,True):\n  x = a - (1<<32) if signed and a >> 31 else a\n  y = b - (1<<32) if signed and b >> 31 else b\n  n,d = abs(x),abs(y)\n  r,q = 0,0\n  for off in (31,30):\n   t = (r<<1) + ((n>>off)&1)\n   s = int(t>=d)\n   r,q = t-s*d, ((q<<1)|s)&mask\n  for phase in range(5):\n   for digit in range(3):\n    t = (r<<2) | ((n>>(28-phase*6-digit*2))&3)\n    # Most significant subtraction bit indicates borrow in 35-bit arithmetic.\n    trial = [(t-m*d)&((1<<35)-1) for m in range(4)]\n    sel = max(i for i in range(4) if trial[i]>>34 == 0)\n    r,q = trial[sel], ((q<<2)|sel)&mask\n  if (x<0) \"'!= (y<0) and y!=0: q = -q\n  if x<0: r = -r\n  eq = (n//d)*(-1 if (x<0)!=(y<0) else 1) if y else -1\n  er = x - eq*y if y else x\n  assert (q&mask,r&mask) == (eq&mask,er&mask), (a,b,signed)\nprint(f'\"'Quotient and remainder match integer reference for {len(pairs)} operand pairs in both sign modes.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
