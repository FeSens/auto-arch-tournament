{"type":"item.started","item":{"id":"item_114","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport tempfile\np=Path(tempfile.gettempdir())/'structural_r12/tail_shared/test/test_alu.py'\ns=p.read_text();s+='''\n@cocotb.test()\nasync def radix8_corrections(dut):\n    await _setup(dut)\n    vectors = [(0xffffffff,565376), (0xfffa55ff,565376), (23,565376),(0x8a080,565376),(0xffffffff,4417),(0xffffff53,4417)]\n    rng = random.Random(0x1251)\n    for _ in range(5000):\n        d = rng.randrange(1<<rng.randrange(33)) or 1\n        a = (rng.randrange(1<<32)//d)*d + rng.randrange(-1,2)\n        vectors.append((a & MASK32, d))\n    for i,(a,b) in enumerate(vectors):\n        op = (ALU_DIVU, ALU_REMU, ALU_DIV, ALU_REM)[i%4]\n        if op in (ALU_DIV, ALU_REM):\n            x = a-(1<<32) if a>>31 else a\n            y = b-(1<<32) if b>>31 else b\n        else:\n            x,y=a,b\n        q=abs(x)//abs(y)\n        if (x<0)\"'!=(y<0): q=-q\n        await _check_div(dut,op,a,b,q if op in (ALU_DIV, ALU_DIVU) else x-q*y)\n'\"'''\np.write_text(s)\nPY\ncd \\\"\"'$TMPDIR/structural_r12/tail_shared\" && python -m pytest --rootdir=. -q test/test_alu.py > deep_samples.log 2>&1 && tail -2 deep_samples.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
