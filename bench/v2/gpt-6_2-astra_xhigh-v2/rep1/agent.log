{"type":"item.started","item":{"id":"item_156","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nd=Path('/srv/hwebench/tmp/800f6bc6/72181047/successor-r8.WM4BSG6V')\nnew=\\\"\\\"\\\"\n\n@cocotb.test()\nasync def alias_changes_successor_address(dut):\n    program = [NOP()] * (0x1014 // 4 + 1)\n    for pc, word in {\n        0: ADDI(1,0,1), 4: JAL(0,0x1000), 0x1004: ADDI(2,2,1),\n        0x1008: BNE(2,1,12), 0x100c: JAL(0,4-0x100c), 0x1014: EBREAK(),\n    }.items():\n        program[pc//4] = word\n    waits = 0\n    back = False\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal waits, back\n        back |= ia == 0x100c\n        if back and ia == 0x1004 and waits < 3:\n            waits += 1\n            return 0, 1\n        return 1, 1\n    rets, _ = await _run(dut, program, initial_imem_wait=2050, bus_ready=ready)\n    assert waits == 3\n    _check_loop_path(rets, [0,4,0x1004,0x1008,0x100c,4,0x1004,0x1008,0x1014])\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"]==0x1004] == [1,2]\n\n@cocotb.test()\nasync def fence_synchronizes_a_trained_successor(dut):\n    old, new = ADDI(3,3,1), ADDI(3,3,9)\n    program = [LW(5,0,128), ADDI(2,2,1), old, BEQ(3,2,8), EBREAK(),\n               SW(5,0,8), 0x0000100f, JAL(0,4-28)]\n    patched = False\n    waits = 0\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal patched, waits\n        if wen:\n            assert (da, wen, wdata) == (8,15,new)\n            program[2] = wdata\n            patched = True\n        if patched and ia==8 and waits < 3:\n            waits += 1\n            return 0, 1\n        return 1, 1\n    rets, _ = await _run(dut, program, {128:new}, initial_imem_wait=2050, bus_ready=ready)\n    _check_loop_path(rets,[0,4,8,12,20,24,28,4,8,12,16])\n    assert waits==3\n    assert [(r[\\\"insn\\\"],r[\\\"rd_wdata\\\"]) for r in rets if r[\\\"pc\\\"]==8] == [(old,1),(new,10)]\n\\\"\\\"\\\"\nfor name in ('unit','warmunit'):\n p=d/name/'test/test_pipeline.py';p.write_text(p.read_text()+new)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
