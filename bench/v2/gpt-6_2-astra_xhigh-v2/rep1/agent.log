{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_pipeline.py | sed -n '730,865p'; cat bench/programs/Makefile; df -h \\\"\"'$TMPDIR\"; nproc; head -c 120 /sys/fs/cgroup/cpu.max'", "aggregated_output": "    assert [b for a, b in zip(fetches, fetches[1:]) if a == 16] == predicted\n\n\n@cocotb.test()\n@cocotb.parametrize(new_base=[65, 35])\nasync def predicted_jalr_behind_stalled_store(dut, new_base):\n    program = [\n        ADDI(1, 0, 33), ADDI(2, 0, 99), SW(1, 0, 80), JALR(5, 1, 0),\n        SW(2, 0, 92), EBREAK(), NOP(), NOP(),\n        SW(5, 0, 84), ADDI(1, 0, new_base), JAL(0, 8 - 40),\n    ] + [NOP()] * 5 + [SW(1, 0, 88), EBREAK()]\n    held_pcs, stores = [], []\n    traps = new_base == 35\n    successor = 16 if traps else 64\n\n    def ready(ia, da, ren, wen, wdata):\n        if wen:\n            if da == 80 and wdata == new_base:\n                held_pcs.append(ia)\n                if len(held_pcs) <= 3:\n                    return 0, 0\n            stores.append((da, wen, wdata))\n        return 1, 1\n\n    rets, _ = await _run(dut, program, bus_ready=ready, initial_imem_wait=260)\n    # The first wait sees the old predicted target. The correction holds\n    # through subsequent waits and the edge accepting the older store.\n    assert held_pcs == [32, successor, successor, successor]\n    pcs = [0, 4, 8, 12, 32, 36, 40, 8, 12, successor, successor + 4]\n    assert [(r[\"order\"], r[\"pc\"], r[\"pc_next\"], r[\"trap\"]) for r in rets] == [\n        (i, pc, nxt, int(i == 8 and traps))\n        for i, (pc, nxt) in enumerate(zip(pcs, pcs[1:] + [successor + 8]))\n    ]\n    assert (rets[8][\"rd\"], rets[8][\"rd_wdata\"]) == ((0, 0) if traps else (5, 16))\n    assert stores == [(80, 15, 33), (84, 15, 16), (80, 15, new_base),\n                      (92, 15, 99) if traps else (88, 15, 65)]\n\n\n@cocotb.test()\nasync def btb_index_conflict(dut):\n    # PC 8 and PC 1032 share all e