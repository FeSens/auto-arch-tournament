{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat formal/checks_si.cfg && cat cores/bench/test/test_alu.py'", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n\"\"\"Check the combinational ALU and the six-round RV32M divider.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.div_request.value = 0\n    dut.reset.value = 1\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").star\n…[7499 of 10571 chars elided by tools/bench/transcript.py; sha256:86214ebd0c990cb0]…\n0xfffffffd, 0xfffffffe, MASK32]\n    pairs = [(a, b) for a in edges for b in edges]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(rng.randint(1, 32))) for _ in range(64)]\n    for a, b in pairs:\n        for op in (ALU_DIV, ALU_REM, ALU_DIVU, ALU_REMU):\n            signed = op in (ALU_DIV, ALU_REM)\n            x = a - (1 << 32) if signed and a >> 31 else a\n            y = b - (1 << 32) if signed and b >> 31 else b\n            if y == 0:\n                quotient, remainder = -1, x\n            else:\n                quotient = abs(x) // abs(y)\n                if (x < 0) != (y < 0):\n                    quotient = -quotient\n                remainder = x - quotient * y\n            expected = quotient if op in (ALU_DIV, ALU_DIVU) else remainder\n            await _check_div(dut, op, a, b, expected)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
