{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/gold/control.py\" <<'\"'PY'\nimport re,sys\nfrom pathlib import Path\nfrom shutil import copytree\nb=Path(__file__).parent\nsrc,mode=sys.argv[1:]\ndest=b/mode\ncopytree(b/src,dest,dirs_exist_ok=True)\ndef update(name,change):\n p=dest/name;t=p.read_text()\n p.write_text(change(t))\nif 'ring' in mode:\n p=dest/'alu.sv'\n t=p.read_text()\n start=t.index('  logic [2:0] phase_q;');end=t.index('\"'`ifdef RISCV_FORMAL_ALTOPS'\"',start)\n t=t[:start]+\\\"\\\"\\\"\n  logic [7:1] rounds;\n  logic idle_q;\n  logic div_issue;\n  logic [31:0] div_result;\n  assign div_busy = \"'!idle_q;\n  assign div_done = rounds[7];\n  assign div_issue = idle_q && div_request;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      rounds <= '\"'0;\n      idle_q <= 1'b1;\n    end else begin\n      rounds <= {rounds[6:1],div_issue};\n      idle_q <= rounds[7] || (idle_q && \"'!div_request);\n    end\n  end\n\n\"\"\"+t[end:]\n t=re.sub(r\"phase_q'\"\\\\s*==\\\\s*(?:3'd)?(\\\\d)\\\",r\\\"rounds[\\\\1]\\\",t)\n if 'phase_q' in t:\n  raise RuntimeError('remaining op')\n p.write_text(t)\nif 'pre' in mode:\n update('core_pkg.sv',lambda s:s.replace('    logic        is_add;', '    logic        is_div;\\\\n    logic        is_add;'))\n update('id_stage.sv',lambda s:s.replace('      reg_q.is_add   <=','      reg_q.is_div <= in.instr[6:0] == 7\\\\'h33 && in.instr[31:25] == 7\\\\'h01 && in.instr[14];\\\\n      reg_q.is_add   <='))\n update('ex_stage.sv',lambda s:re.sub(r'assign is_div = in.valid.*?;', 'assign is_div = in.valid && \"'!annul && in.is_div;'\"',s,flags=re.S))\nPY\nfor pair in 'excompact3 ringcompact' 'excompact3 preringcompact' 'compshared preringshared' 'compshort preringshort'; do set -- \"'$pair; python \"$TMPDIR/gold/control.py\" \"$1\" \"$2\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
