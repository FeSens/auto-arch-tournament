{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/structural_r12/prepare.py\" <<'\"'PY'\nfrom pathlib import Path\nimport tempfile, shutil\nroot = Path(tempfile.gettempdir())/'structural_r12'\nbase=root/'digit'\np=base/'rtl'\nshutil.copytree('cores/bench/rtl',p,dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',base/'test',dirs_exist_ok=True)\nalu=p/'alu.sv'\nsrc=alu.read_text()\nstart=src.index('  logic [31:0] divisor_q')\nend=src.index('\"'`endif'\"',start)\nbody=\\\"\\\"\\\"  logic [31:0] dividend_q, divisor_q, prefix_q;\n  logic rem_q, negate_q, zero_q;\n  logic [4:0] exponent, shift_q;\n  logic [31:0] normalized;\n  always_comb begin\n    exponent = 0;\n    for (int i = 0; i < 32; i++)\n      if (divisor_q[i]) exponent = 5'(i);\n    normalized = divisor_q << ~exponent;\n  end\n\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] coefficients [0:1023];\n  initial begin\n    for (int j=0; j<1024; j++) begin\n      coefficients[j][31:11] = 21'((64'd1<<31)/(1025+j));\n      coefficients[j][10:0] = 11'((64'd1<<31)/((1025+j)*(1025+j)));\n    end\n  end\n  logic [31:0] coeff_q;\n  logic [11:0] fraction_q;\n  logic [22:0] adjustment;\n  logic [20:0] reciprocal_q;\n  assign adjustment = coeff_q[10:0] * fraction_q;\n\n  wire [31:0] estimate_input = phase_q == 3'd3 ? {16'b0,dividend_q[31:16]} : prefix_q;\n  wire [52:0] estimate_product = estimate_input * reciprocal_q;\n  wire [16:0] estimate = 17'(estimate_product[52:21] >> shift_q);\n  logic [15:0] q_hi;\n  logic [16:0] digit_q;\n  wire [31:0] product = digit_q * divisor_q;\n  wire [15:0] prefix_hi = dividend_q[31:16] - product[15:0];\n  logic [31:0] quotient_q, residue_q;\n  wire [31:0] remainder_if_correct = residue_q - divisor_q;\n  wire correct = residue_q >= divisor_q;\n  wire [31:0] q_final = quotient_q + correct;\n  wire [31:0] r_final = correct ? remainder_if_correct : residue_q;\n  wire [31:0] magnitude = zero_q ? (rem_q ? dividend_q : 32'hf