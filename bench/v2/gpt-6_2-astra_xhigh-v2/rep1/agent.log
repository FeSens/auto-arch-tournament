{"type": "item.started", "item": {"id": "item_60", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/structural_r12/radix_tail.py\" <<'\"'PY'\nfrom pathlib import Path\nimport tempfile, shutil,sys\nbase=Path(tempfile.gettempdir())/'structural_r12'; name=sys.argv[1];dest=base/name\nshutil.copytree('cores/bench/rtl',dest/'rtl',dirs_exist_ok=True)\np=dest/'rtl'/'alu.sv';src=p.read_text()\na=src.index('  logic [31:0] divisor_q');b=src.index('\"'`endif'\"',a)\n# Use exponent-aligned bands, constant indexed ROMs with compact common address.\n# K as large as possible while guaranteeing approximate reciprocal within 7 units.\nH=1<<32\nstart=0;entries=[]; bands=[]\ndef coefficients(lo,k):\n u=lo+(1<<k)-1\n c=H//u if u>1 else 0\n s=H*(1<<k)//u**2 if k else 0\n return c,s\nfor e in range(32):\n k=min(e,max(0,(3*e-31)//2))\n # floor at left coarse estimate and verify the whole piecewise function below.\n n=1<<(e-k)\n bands.append((e,k,start,n))\n for t in range(n):\n  lo=(1<<e)+(t<<k)\n  entries.append(coefficients(lo,k))\n start+=n\nprint(name,'entries',len(entries),'max slope',max(s for c,s in entries),bands)\n# Pad to natural boundaries by using offset at bin start minus band minimum.\nbits=(len(entries)-1).bit_length(); sw=max(s for c,s in entries).bit_length()\nbody=f'''  logic [31:0] input_a, input_b, magnitude_a, divisor;\n  logic abs_a, abs_b, rem_q, negate_q, zero_q, one_q;\n  logic [{bits-1}:0] index;\n  logic [7:0] fraction, fraction_q;\n  always_comb begin\n    index = '0;\n    fraction = '0;\n'''\nfor e,k,start,n in reversed(bands):\n cond=f\\\"if (divisor[{e}])\\\"\n expr=f\\\"{bits}'d{start} + {bits}'(divisor[{e-1}:{k}])\\\" if e>k else f\\\"{bits}'d{start}\\\"\n fexpr=\\\"8'd0\\\" if k==0 else (f\\\"~divisor[{k-1}:{k-8}]\\\" if k>=8 else f\\\"{{~divisor[{k-1}:0],{8-k}'b0}}\\\")\n body+=f\\\"    {cond} begin index = {expr}; fraction = {fexpr}; end else\\\\n\\\"\nbody+=\\\"    begin index='0; fraction='0; end\\\\n  end\\\\n\\\"\nbody+=f'''  (* syn_ramstyle = \\\"block_ram\\\" *) logic [{31+sw}:0] table_words [0:{len(entries)-1}];\n  initial begin\n'''\nfor i,(c,s) in enumerate(entries):\n body+=f\\\"    table_words[{i}] = {32+sw}'h{(c<<sw)|s:x};\\\\n\\\"\nbody+=f\\\"\\\"\\\"  end\n  logic [{31+sw}:0] word_q;\n  logic [{sw+7}:0] interpolation;\n  assign interpolation = word_q[{sw-1}:0]*fraction_q;\n  logic [31:0] multiplier_q, estimate_q, residue_q, magnitude_q;\n  logic [31:0] multiples[1:7];\n  logic [6:0] fits;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      input_a <= a; input_b <= b; abs_a <= neg_a; abs_b <= neg_b;\n      rem_q <= want_rem;\n      negate_q <= want_rem ? neg_a : (neg_a \"'^ neg_b) && b != 0;\n    end\n    if (phase_q == 1) begin\n      magnitude_a <= abs_a ? -input_a : input_a;\n      divisor <= abs_b ? -input_b : input_b;\n      zero_q <= input_b == 0;\n      one_q <= input_b == 1 || ((&input_b) && abs_b);\n    end\n    if (phase_q == 2) begin\n      word_q <= table_words[index];\n      fraction_q <= fraction;\n    end\n    if (phase_q == 3) multiplier_q <= word_q[{31+sw}:{sw}] + (interpolation >> 8);\n  end\n\"\"\"\nif '\"'shared' in name:\n body+=\\\"\\\"\\\"  wire [31:0] mx = phase_q==4 ? magnitude_a : estimate_q;\n  wire [31:0] my = phase_q==4 ? multiplier_q : divisor;\n  wire [63:0] prod = mx*my;\n  wire [31:0] hi = prod[63:32], lo = prod[31:0];\n\\\"\\\"\\\"\nelse:\n body+=\\\"\\\"\\\"  wire [63:0] prod = magnitude_a * multiplier_q;\n  wire [31:0] hi = prod[63:32], lo = estimate_q * divisor;\n\\\"\\\"\\\"\nbody+=\\\"\\\"\\\"  for (genvar d=1; d<=7; d++) begin: thresholds\n    wire [34:0] multiple = {3'b0,divisor} * 3'(d);\n    always_ff @(posedge clock) if (phase_q==4) begin\n      multiples[d] <= multiple[31:0];\n      fits[d-1] <= \"'!(|multiple[34:32]);\n    end\n  end\n  logic [31:0] residues [0:7];\n  logic [7:0] ok;\n  assign residues[0]=residue_q;\n  assign ok[0]=1;\n  for (genvar d=1; d<=7; d++) begin: trials\n    wire [32:0] diff = {1'\"'b0,residue_q}-{1'b0,multiples[d]};\n    assign ok[d]= \"'!diff[32] && fits[d-1];\n    assign residues[d]=diff[31:0];\n  end\n  logic [34:0] pairs [0:3];\n  for (genvar i=0;i<4;i++) begin\n    assign pairs[i]=ok[2*i+1] ? {3'\"'(2*i+1),residues[2*i+1]} :\n                                {3'(2*i),residues[2*i]};\n  end\n  wire [34:0] chosen=ok[4] ? (ok[6]?pairs[3]:pairs[2]) : (ok[2]?pairs[1]:pairs[0]);\n  always_ff @(posedge clock) begin\n    if (phase_q==4) estimate_q <= hi;\n    if (phase_q==5) residue_q <= magnitude_a-lo;\n    if (phase_q==6) magnitude_q <= zero_q ? (rem_q ? magnitude_a : '1) :\n                      one_q ? (rem_q ? 0 : magnitude_a) :\n                      rem_q ? chosen[31:0] : estimate_q + chosen[34:32];\n  end\n  assign div_result = negate_q ? -magnitude_q : magnitude_q;\n\\\"\\\"\\\"\np.write_text(src[:a]+body+src[b:])\nPY\npython \\\"\"'$TMPDIR/structural_r12/radix_tail.py\" tail_shared\npython \"$TMPDIR/structural_r12/radix_tail.py\" tail_split\ndate -u'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
