{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c 'tail -n 5 \"$TMPDIR/fetch-formal/formal\"/last_run-wwPWjEol6.log; git status --short --untracked-files=all; cat cores/bench/rtl/if_stage.sv'","aggregated_output":"SBY 17:53:07 [insn_sub_ch0] summary: Elapsed process time [H:MM:SS (secs)]: 0:00:04 (4)\nSBY 17:53:07 [insn_sub_ch0] summary: engine_0 (smtbmc bitwuzla) returned pass\nSBY 17:53:07 [insn_sub_ch0] summary: engine_0 did not produce any traces\nSBY 17:53:07 [insn_sub_ch0] DONE (PASS, rc=0)\nSBY 17:53:46 [reg_ch0] engine_0: ##   0:01:00  waiting for solver (1 minute)\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_pipeline.py\n// rtl/if_stage.sv\n//\n// Decode sees the bus directly until a backend hold saves a ready word.\n// The saved PC and instruction can issue while the bus waits for the\n// next word, or be replaced on the same edge if that word is ready.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [9:0] saved_word_offset;\n  logic [31:0] saved_instr;\n  logic full, fence_wait;\n  logic ready, raw_fence_i, can_buffer, hold_slot, direct_issue, take;\n\n  assign ready = imem_ready && !fence_wait;\n  assign raw_fence_i = imem_data[6:0] == 7'h0f && imem_data[14:12] == 3'd1;\n  // At the last word of a page or at FENCE.I, only direct issue may\n  // advance the bus to the successor.\n  assign can_buffer = ready && pc[11:2] != 10'h3ff && !raw_fence_i;\n  assign hold_slot = full && stall;\n  assign direct_issue = !full && !stall;\n  assign take = (ready && direct_issue) || (can_buffer && !hold_slot);\n\n  // Only full makes the saved payload visible. A flush can invalidate it\n  // independently of the wide payload register enables.\n  always_ff @(posedge clock) begin\n    if (!hold_slot) begin\n      saved_word_offset <= pc[11:2];\n      saved_instr       <= imem_data;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc         <= RESET_PC;\n      full       <= 1'b0;\n      fence_wait <= 1'b0;\n    end else if (redirect) begin\n      pc         <= redirect_target;\n      full       <= 1'b0;\n      fence_wait <= 1'b0;\n    end else begin\n      if (take) pc <= pc + 32'd4;\n      full <= hold_slot || (can_buffer && !direct_issue);\n      // A directly issued FENCE.I may be held in EX by an older store.\n      // Sample its successor only after EX advances past the fence.\n      if (!stall)\n        fence_wait <= !full && ready && raw_fence_i;\n    end\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    // A buffered fetch and its successor share the page and alignment.\n    out.pc    = {pc[31:12], full ? saved_word_offset : pc[11:2], pc[1:0]};\n    out.instr = full ? saved_instr : imem_data;\n    out.valid = full || ready;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
