{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predict_r11/page.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys,shutil\np=Path(os.environ['TMPDIR'])/'predict_r11'\nv=sys.argv[1]; d=p/v;shutil.copytree(p/'v3',d,dirs_exist_ok=True)\ng=int(sys.argv[2]) if len(sys.argv)>2 else 2\nc=(d/'core.sv').read_text(); a=c.index('  logic [9:0] predicted_index');b=c.index('  // ── IF ─',a)\nc=c[:a]+'''\n  logic [9:0] predicted_index;\n  logic [7:0] page, challenger;\n  logic [2:0] streak;\n  logic clearing, index_ok, read_request;\n  wire [31:0] addr = ex_mem_w.mem_addr;\n  wire in_ram = addr[31:20] == 0;\n  wire page_match = in_ram && addr[19:12] == page;\n  wire train_load = io_dmemREn && io_dmemReady;\n  wire train_store = (|io_dmemWEn) && io_dmemReady;\n  wire access_done = train_load || train_store;\n  wire new_page = \"'!clearing && in_ram && !page_match && access_done &&\n                  challenger == addr[19:12] && (&streak);\n  localparam int W = 1 << GGG;\n  logic [9-GGG:0] sweep;\n  always_ff @(posedge clock) begin\n    if (reset || new_page) begin\n      clearing <= 1'\"'b1;\n      sweep <= '0;\n      page <= reset ? 8'd0 : addr[19:12];\n      streak <= '0;\n    end else if (clearing) begin\n      clearing <= \"'!(&sweep);\n      sweep <= sweep + 1'\"'b1;\n    end else if (access_done && in_ram) begin\n      challenger <= addr[19:12];\n      streak <= page_match || challenger \"'!= addr[19:12] ? 3'\"'d0 : streak + 1'b1;\n    end\n  end\n\n  wire install = \"'!clearing && !reset && page_match && (train_load || train_store);\n  wire learn_word = install && (train_load || (&io_dmemWEn));\n  wire [W-1:0] slot_bit = {{(W-1){1'\"'b0}},1'b1} << addr[GGG+1:2];\n  wire [9-GGG:0] wr_group = clearing ? sweep : addr[11:GGG+2];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [W-1:0] seen[0:(1024/W)-1];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic complete[0:(1024/W)-1];\n  wire [W-1:0] updated = seen[wr_group] | slot_bit;\n  always_ff @(posedge clock) begin\n    if (clearing || learn_word) begin\n      seen[wr_group] <= clearing ? '0 : updated;\n      complete[wr_group] <= \"'!clearing && (&updated);\n    end\n  end\n  logic [9:0] prior_write_index;\n  logic had_write;\n  logic [31:0] sampled_word;\n  wire local_hit = !clearing && page_match && index_ok &&\n                   complete[addr[11:GGG+2]] && !(had_write && prior_write_index == addr[11:2]);\n  always_ff @(posedge clock) begin\n    if (!stall_ex_mem) begin\n      index_ok <= !word_handoff || local_hit;\n      prior_write_index <= addr[11:2];\n      had_write <= install;\n    end\n  end\n  wire [31:0] write_data = train_load ? io_dmemRData : io_dmemWData;\n  for (genvar i=0; i<4; i++) begin\n    (* syn_ramstyle = \"block_ram\" *) logic [7:0] bank[0:1023];\n    always_ff @(posedge clock) begin\n      if (install && (train_load || io_dmemWEn[i]))\n        bank[addr[11:2]] <= write_data[8*i+:8];\n      if (!stall_ex_mem) sampled_word[8*i+:8] <= bank[predicted_index];\n    end\n  end\n  assign io_dmemREn = read_request && !local_hit;\n  wire [31:0] selected_word = local_hit ? sampled_word : io_dmemRData;\n\n'\"'''.replace('GGG',str(g))+c[b:]\nc=c.replace('sampled_row[31:0]','sampled_word').replace('sampled_row[11:0]','sampled_word[11:0]')\n(d/'core.sv').write_text(c)\nPY\npython \\\"\"'$TMPDIR/predict_r11/page.py\" v6 2'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
