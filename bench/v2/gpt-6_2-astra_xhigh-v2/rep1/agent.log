{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'ls -l \"$TMPDIR\"\ncommand -v riscv32-unknown-elf-gcc\ncat cores/bench/rtl/hazard_unit.sv\nrg -n '\"'critical_path' cores/bench/experiments/log.jsonl -o | wc -l\"","aggregated_output":"total 8\ndrwxrwx---+ 12 hwebench hwebench 4096 Nov 19 20:44 codex-bwrap-synthetic-mount-targets-1001\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n// rtl/hazard_unit.sv\n//\n// Loads and multiplies produce their result at the end of MEM. On a\n// source match, IF holds the PC and ID/EX inserts one bubble so the\n// consumer can forward from MEM/WB.\n// A redirect also discards the fetch on the edge the branch leaves EX.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,    // valid load or multiply in EX\n  input  logic [4:0] id_ex_rd,          // producer's destination\n  input  logic       depends_on_rd,     // fetch rs1 or rs2 matches the EX destination\n  input  logic       redirect,          // EX has resolved a branch/jump\n  input  logic       fence_i,           // valid FENCE.I in EX\n  input  logic       div_wait,          // DIV/REM occupies ID/EX\n  input  logic       fetch_valid,       // live bus word or exact predictor hit\n  input  logic       dmem_ready,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       bubble_id,         // discard fetch when ID/EX advances\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic imem_stall;\n  logic dmem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_mem_read && depends_on_rd && id_ex_rd != 5'b0;\n    imem_stall = !fetch_valid;\n    // dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n    dmem_stall = !dmem_ready && ex_mem_mem_op;\n\n    // The PC gives redirect priority over these interlocks.\n    // Issuing FENCE.I advanced IF to fence PC+4. Hold that PC and\n    // discard its pre-fence fetch on the edge that lets the fence leave EX.\n    stall_if      = load_use_hazard || imem_stall || dmem_stall || div_wait || fence_i;\n    stall_id      = dmem_stall || div_wait;\n    bubble_id     = redirect || load_use_hazard || fence_i;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n28\n","exit_code":0,"status":"completed"}}
