{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c 'git diff --check; git status --short; cat cores/bench/rtl/if_stage.sv'","aggregated_output":" M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/id_stage.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_pipeline.py\n// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// The BTB reads alongside instruction memory. ID/EX captures its lookup\n// on the same edge that accepts the word and advances the fetch PC.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              flush,            // instruction memory wait\n  input  logic              redirect,         // advancing EX needs recovery\n  input  logic [31:0]       redirect_target,\n  input  logic              train_en,\n  input  logic [19:2]       train_pc,\n  input  logic [17:0]       train_target_word,\n  input  logic [1:0]        train_count,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [8:0] init_q;\n  always_ff @(posedge clock) begin\n    if (reset)           init_q <= '0;\n    else if (!init_q[8]) init_q <= init_q + 9'd1;\n  end\n\n  // One write port services both the reset sweep and EX updates.\n  (* syn_ramstyle = \"block_ram\" *) logic [30:0] btb [0:255];\n  logic [7:0]  write_index;\n  logic [30:0] write_row;\n  assign write_index = init_q[8] ? train_pc[9:2] : init_q[7:0];\n  assign write_row = init_q[8] ? {1'b1, train_pc[19:10], train_target_word, train_count} : '0;\n  always_ff @(posedge clock) begin\n    if (!init_q[8] || train_en) btb[write_index] <= write_row;\n  end\n\n  logic row_valid;\n  logic [9:0] row_tag;\n  prediction_t prediction;\n  assign {row_valid, row_tag, prediction.target_word, prediction.count} = btb[pc[9:2]];\n  assign prediction.hit = init_q[8] && row_valid && row_tag == pc[19:10]\n                       && pc[31:20] == '0 && pc[1:0] == 2'b00;\n\n  // Recovery from an advancing EX instruction also consumes an imem wait.\n  // A stalled EX cannot issue a redirect.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= prediction.hit && prediction.count[1]\n                            ? {12'b0, prediction.target_word, 2'b00} : pc + 32'd4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = flush ? 32'h0000_0013 : imem_data;\n    out.prediction = prediction;\n    out.valid = !flush;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
