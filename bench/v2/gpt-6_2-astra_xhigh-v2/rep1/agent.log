{"type": "item.completed", "item": {"id": "item_88", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv; cat cores/bench/rtl/hazard_unit.sv; cat cores/bench/rtl/word_probe.sv'", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Compare tags alongside the register-file read in ID. When the consumer\n// reaches EX, the two producers have advanced to EX/MEM and MEM/WB.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       stall_id,\n  input  logic [4:0] if_id_rs1,\n  input  logic [4:0] if_id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       id_ex_w_en,\n  input  logic       ex_mem_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  logic [1:0] rs1_match_q, rs2_match_q;\n\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      rs1_match_q[0] <= id_ex_w_en && id_ex_rd != 5'b0 && if_id_rs1 == id_ex_rd;\n      rs2_match_q[0] <= id_ex_w_en && id_ex_rd != 5'b0 && if_id_rs2 == id_ex_rd;\n      rs1_match_q[1] <= ex_mem_w_en && ex_mem_rd != 5'b0 && if_id_rs1 == ex_mem_rd;\n      rs2_match_q[1] <= ex_mem_w_en && ex_mem_rd != 5'b0 && if_id_rs2 == ex_mem_rd;\n    end\n  end\n\n  assign fwd_rs1 = rs1_match_q;\n  assign fwd_rs2 = rs2_match_q;\n\nendmodule\n// rtl/hazard_unit.sv\n//\n// A multiply-use dependency inserts one bubble in ID. A load consumer\n// can issue immediately and waits in EX only if MEM needs to repair it.\n// A redirect also discards the fetch on the edge the branch leaves EX.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       late_result,       // multiply or a load during the reset sweep\n  input  logic [4:0] id_ex_rd,          // producer's destination\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       redirect,          // EX has resolved a branch/jump\n  input  logic       fence_i,           // valid FENCE.I in EX\n  input  logic       div_wait,          // DIV/REM occupies ID/EX\n  input  logic       fetch_valid,       // live bus word or loop replay hit\n  input  logic       mem_wait,          // outstanding bus request or load \n…[1696 of 4768 chars elided by tools/bench/transcript.py; sha256:7013dd83aff926ba]…\nic        clearing,\n  input  logic        write_en,\n  input  logic [10:2] write_index,\n  input  word_row_t   write_row,\n  input  logic        read_en,\n  input  logic [10:2] read_index,\n  input  logic [10:2] held_index,\n  output word_row_t   row\n);\n  (* syn_ramstyle = \"block_ram\" *) logic [50:0] words [0:511];\n  word_row_t read_q;\n  logic stale, wrote_q;\n  logic [10:2] write_index_q;\n  wire collision = wrote_q && write_index_q == held_index;\n\n  always_ff @(posedge clock) begin\n    if (write_en) words[write_index] <= write_row;\n    if (read_en) read_q <= words[read_index];\n  end\n\n  // A simultaneous write can produce either RAM value. Also discard a\n  // saved response if its row is overwritten while its source is held.\n  always_ff @(posedge clock) begin\n    wrote_q <= write_en;\n    write_index_q <= write_index;\n    if (read_en) stale <= clearing;\n    else if (clearing || collision) stale <= 1'b1;\n  end\n\n  always_comb begin\n    row = read_q;\n    row.valid = read_q.valid && !stale && !collision;\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
