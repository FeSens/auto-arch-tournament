=4: {leaked}\"\n779:    # Strict: no retirement carries the skipped instruction word at all.\n784:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n866:    increments = _by_insn(rets, ADDI(2, 2, 1))\n868:    assert [(r[\"rs1_rdata\"], r[\"rd_wdata\"]) for r in increments] == [(0, 1), (1, 2), (2, 3)]\n869:    assert all(inc[\"cycle\"] == load[\"cycle\"] + 1 for load, inc in zip(loads, increments))\n1202:async def jalr_forwarded_target_match(dut, producer, new_base):\n1240:async def nonzero_offset_jalr_predicts_sequential(dut):\n1264:async def predicted_jalr_behind_stalled_store(dut, new_base):\n1399:    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n1408:async def jalr_target(dut):\n1419:    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n1499:def test_pipeline_runner():\n","exit_code":0,"status":"completed"}}
