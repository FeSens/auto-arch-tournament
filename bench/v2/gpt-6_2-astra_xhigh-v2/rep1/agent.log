{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/predstudy\" && cat v2timing.log && tail -4 tests2.log && cat sim2-build.log | tail -1 && cat > predtests.tmp <<'\"'PY'\n@cocotb.test()\nasync def trained_forward_branch_with_stalled_exit(dut):\n    start = 65 * 4\n    program = [NOP()] * 65 + [\n        ADDI(1, 0, 4),                        # start\n        ADDI(1, 1, -1),                       # +4\n        LW(3, 0, 60),                         # +8\n        BNE(1, 0, 12),                        # +12\n        JAL(0, 16),                           # +16\n        ECALL(),                              # +20\n        SW(1, 0, 64),                         # +24\n        JAL(0, -24),                          # +28\n        EBREAK(),                             # +32\n    ]\n    loads = 0\n    holds = 0\n    stores = []\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal loads, holds\n        if ren and da == 60:\n            if loads == 3 and holds < 3:\n                holds += 1\n                return 0, 0\n            loads += 1\n            return int(loads \"'!= 4), 1\n        if wen:\n            stores.append((da, wen, wdata))\n        return 1, 1\n\n    rets, memory = await _run(dut, program, bus_ready=ready)\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert [r[\"pc_next\"] for r in rets[:-1]] == [r[\"pc\"] for r in rets[1:]]\n    controls = [i for i, r in enumerate(rets) if r[\"pc\"] == start + 12]\n    assert len(controls) == 4 and loads == 4 and holds == 3\n    assert [rets[i][\"pc_next\"] for i in controls] == [start+24]*3 + [start+16]\n    assert [rets[i+1][\"cycle\"] - rets[i][\"cycle\"] for i in controls[:3]] == [2, 1, 1]\n    assert stores == [(64, 15, v) for v in (3, 2, 1)]\n    assert memory[64] == 1 and all(r[\"trap\"] == 0 for r in rets)\n\n\n@cocotb.test()\nasync def direct_target_page_edges_and_trap(dut):\n    program = [ECALL()] * (0x4000 // 4 + 1)\n    jumps = [(0, 0x1ffc, 1), (0x1ffc, 0x2008, 5),\n             (0x2008, 0x1ff8, 6), (0x1ff8, 0x3ffc, 7)]\n    for pc, dst, rd in jumps:\n        program[pc // 4] = JAL(rd, dst - pc)\n    program[0x3ffc // 4] = JAL(8, 2)\n    program[0x4000 // 4] = EBREAK()\n    rets, _ = await _run(dut, program)\n    assert [r[\"order\"] for r in rets] == list(range(6))\n    assert [(r[\"pc\"], r[\"pc_next\"], r[\"rd\"], r[\"rd_wdata\"], r[\"trap\"]) for r in rets[:4]] == [\n        (pc, dst, rd, pc + 4, 0) for pc, dst, rd in jumps\n    ]\n    assert [rets[i+1][\"cycle\"] - rets[i][\"cycle\"] for i in range(4)] == [1, 2, 2, 2]\n    assert (rets[4][\"pc\"], rets[4][\"pc_next\"], rets[4][\"trap\"], rets[4][\"rd\"]) == (0x3ffc, 0x4000, 1, 0)\n    assert rets[5][\"pc\"] == 0x4000\n\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
