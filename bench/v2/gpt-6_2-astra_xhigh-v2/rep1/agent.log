{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/quotient/digits.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os,sys\nr=Path(os.environ['TMPDIR'])/'quotient'\nsrc=r/sys.argv[1];dst=r/sys.argv[2];copytree(src,dst,dirs_exist_ok=True)\np=dst/'alu.sv'; s=p.read_text()\nd=\\\"\\\"\\\"  wire [7:0] fits;\n  assign fits[0] = 1'b1;\n  wire [31:0] candidate [0:7];\n  assign candidate[0] = window;\n\\\"\\\"\\\"\n# Register only magnitude/overflow limits off the feedback path, using\n# modular arithmetic for the seven differences.\nif 'neg' in sys.argv[2]:\n d+=\\\"\\\"\\\"\n  wire [31:0] nd;\n  assign nd = -divisor;\n  for (genvar i=1;i<=7;i=i+1) begin : gen_trial\n    logic [31:0] neg_multiple;\n    logic valid_multiple;\n    always_ff @(posedge clock) begin\n      neg_multiple <= 32'(nd * 32'(i));\n      valid_multiple <= divisor <= (32'hffffffff / 32'(i));\n    end\n    wire carry;\n    assign {carry,candidate[i]} = {1'b0,window} + {1'b0,neg_multiple};\n    assign fits[i] = carry && valid_multiple;\n  end\n\\\"\\\"\\\"\nelse:\n d+=\\\"\\\"\\\"\n  for (genvar i=1;i<=7;i=i+1) begin : gen_trial\n    logic [31:0] subtractor;\n    logic valid_multiple;\n    always_ff @(posedge clock) begin\n      subtractor <= 32'(divisor * 32'(i));\n      valid_multiple <= divisor <= (32'hffffffff / 32'(i));\n    end\n    wire borrow;\n    assign {borrow,candidate[i]} = {1'b0,window} - {1'b0,subtractor};\n    assign fits[i] = \"'!borrow && valid_multiple;\n  end\n\"\"\"\nif '\"'onehot' in sys.argv[2]:\n d+=\\\"\\\"\\\"\n  wire [7:0] sel = fits & ~(fits >> 1);\n  wire [2:0] digit = {|(sel & 8'hf0),|(sel & 8'hcc),|(sel & 8'haa)};\n  logic [31:0] remainder;\n  always_comb begin\n    remainder = 0;\n    for (int k=0;k<8;k=k+1) remainder = remainder | ({32{sel[k]}} & candidate[k]);\n  end\n\\\"\\\"\\\"\nelse:\n d+=\\\"\\\"\\\"\n  wire [2:0] digit;\n  wire [31:0] remainder;\n  wire [34:0] p01 = fits[1] ? {3'd1,candidate[1]} : {3'd0,candidate[0]};\n  wire [34:0] p23 = fits[3] ? {3'd3,candidate[3]} : {3'd2,candidate[2]};\n  wire [34:0] p45 = fits[5] ? {3'd5,candidate[5]} : {3'd4,candidate[4]};\n  wire [34:0] p67 = fits[7] ? {3'd7,candidate[7]} : {3'd6,candidate[6]};\n  assign {digit,remainder} = fits[4] ? (fits[6] ? p67 : p45) : (fits[2] ? p23 : p01);\n\\\"\\\"\\\"\ns=s[:s.index('  logic [34:0] d3')]+'  logic [31:0] window;\\\\n'+d+s[s.index('  logic [2:0] saved_digit;'):]\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/quotient/digits.py\" normalized negtree\npython \"$TMPDIR/quotient/digits.py\" normalized onehot\npython \"$TMPDIR/quotient/digits.py\" later memnegtree\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
