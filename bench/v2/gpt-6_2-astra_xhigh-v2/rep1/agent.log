{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"cat >> test/test_pipeline.py <<'PY'\n\n\n@cocotb.test()\nasync def multiply_forwarding(dut):\n    def mul(funct3, rd, rs1, rs2):\n        return _r(1, rs2, rs1, funct3, rd, 0x33)\n\n    program = [\n        ADDI(1, 0, -2),\n        ADDI(2, 0, -3),\n        mul(1, 3, 1, 2),\n        mul(2, 4, 1, 2),\n        mul(3, 5, 1, 2),\n        mul(0, 6, 4, 5),\n        LW(8, 0, 64),\n        ADD(7, 6, 6),\n        SW(7, 0, 68),\n        EBREAK(),\n    ]\n    waits = 5\n    accepted = []\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal waits\n        if ren and waits:\n            waits -= 1\n            return 1, 0\n        if ren or wen:\n            accepted.append((da, ren, wen))\n        return 1, 1\n\n    rets, mem = await _run(dut, program, {64: 42}, bus_ready=ready)\n    assert waits == 0 and mem[68] == 20\n    assert accepted == [(64, 1, 0), (68, 0, 15)]\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    for r, result in zip(rets[2:6], [0, 0xfffffffe, 0xfffffffb, 10]):\n        assert r[\\\"rd_wdata\\\"] == result\n        assert (r[\\\"trap\\\"], r[\\\"mem_wmask\\\"], r[\\\"mem_rmask\\\"]) == (0, 0, 0)\n    assert [r[\\\"cycle\\\"] - rets[2][\\\"cycle\\\"] for r in rets[2:6]] == [0, 1, 2, 4]\n    assert (rets[5][\\\"rs1_rdata\\\"], rets[5][\\\"rs2_rdata\\\"]) == (0xfffffffe, 0xfffffffb)\n    assert (rets[7][\\\"rs1_rdata\\\"], rets[7][\\\"rs2_rdata\\\"]) == (10, 10)\nPY\npytest --rootdir=. --confcutdir=. -q test > pytest.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
