{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '505,970p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert rets[-2][\"rd_wdata\"] == 4\n\n\n@cocotb.test()\nasync def replay_missing_word_and_live_bus_priority(dut):\n    # Enter the second loop via its exit and tail, leaving its body unfilled.\n    program = [NOP()] * (0x150 // 4 + 1)\n    for pc, instr in {\n        0: ADDI(1, 0, 2), 4: JAL(0, 0x3c - 4),\n        0x03c: ADDI(2, 2, 1), 0x040: ADDI(3, 3, 3), 0x044: BNE(2, 1, -8),\n        0x048: JAL(0, 0x100),\n        0x13c: ADDI(4, 4, 1), 0x140: ADDI(3, 3, 9), 0x144: BNE(4, 1, -8),\n        0x148: BEQ(4, 1, 8), 0x14c: JAL(0, -8), 0x150: EBREAK(),\n    }.items():\n        program[pc // 4] = instr\n    visits = {0x13c: 0, 0x140: 0}\n    exit_waits = 0\n\n    def ready(ia, da, ren, wen, wdata):\n        nonlocal exit_waits\n        if ia in visits:\n            visits[ia] += 1\n            # Both cold words must wait for the fourth bus cycle.\n            if visits[ia] <= 4:\n                return visits[ia] == 4, 1\n            if ia == 0x140:\n                # The live word wins over the recorded +9 on a hit.\n                program[ia // 4] = ADDI(3, 3, 11)\n                return 1, 1\n            return 0, 1\n        if ia == 0x148 and visits[0x140] == 5 and exit_waits < 3:\n            # The fall-through was recorded on entry. The untaken exit\n            # must still wait for the bus after consuming the loop tail.\n            exit_waits += 1\n            return 0, 1\n        return 1, 1\n\n    rets, _ = await _run(dut, program, bus_ready=ready, initial_imem_wait=SWEEP_CYCLES)\n    pcs = ([0, 4] + [0x3c, 0x40, 0x44] * 2 + [0x48, 0x148, 0x14c, 0x144]\n           + [0x13c, 0x140, 0x144] * 2 + [0x148, 0x150])\n    _check_loop_path(rets, pcs)\n    # The trained tail also fetches 0x13c speculatively on its final exit.\n    assert visits == {0x13c: 6, 0x140: 5} and exit_waits == 3\n    assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"] == 3] == [3, 6, 15, 26]\n\n\n@cocotb.test()\nasync def replay_word_residency_and_replacement(dut):\n    # The final jump shares the row at 32, leaving the store at 36 resident.\n    alias = 32 + 4096\n    program = [NOP()] * (ali\n…[14715 of 17787 chars elided by tools/bench/transcript.py; sha256:5c639be5895380f6]…\ns + 4: SW(0, 0, 68), alias + 24: JAL(0, 4 - (alias + 24)),\n    }.items():\n        program[pc // 4] = insn\n    fetches = []\n\n    def ready(ia, da, ren, wen, wdata):\n        assert not wen\n        fetches.append(ia)\n        return 1, 1\n\n    rets, _ = await _run(dut, program, bus_ready=ready, initial_imem_wait=SWEEP_CYCLES)\n    _check_loop_path(rets, [0, 4, 8, 32, 36, alias - 4, alias, alias + 24, 4, 8, 32, 44])\n    assert [b for a, b in zip(fetches, fetches[1:]) if a in (8, alias)] == [12, alias + 4, 12]\n\n\n@cocotb.test()\n@cocotb.parametrize(replacement=[ADDI(5, 5, 1), 0x0000100f])\nasync def stale_taken_prediction_on_live_nonbranch(dut, replacement):\n    program = [ADDI(2, 0, 7), JAL(5, 20), SW(5, 0, 68), EBREAK(),\n               NOP(), NOP(), SW(2, 0, 64), JAL(0, -28)]\n    fetches, stores = [], []\n\n    def ready(ia, da, ren, wen, wdata):\n        if ia == 4 and stores:\n            program[1] = replacement\n        if wen:\n            stores.append((da, wen, wdata))\n        fetches.append(ia)\n        return 1, 1\n\n", "exit_code": 0, "status": "completed"}}
