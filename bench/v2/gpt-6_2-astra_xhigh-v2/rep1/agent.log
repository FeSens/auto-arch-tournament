output: {e}'}\n\n    if not marker.get('ebreak', False):\n        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n        # a hung CPU with whatever cycle count it happened to reach.\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': 'maxcycles_hit_before_ebreak'}\n\n    # OOB sticky flag from the sim:\n…[4957 of 8029 chars elided by tools/bench/transcript.py; sha256:8e9f126fd349f589]…\neds']}\n\n    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n    if not cm['completed']:\n        return {\n            'bench_failed': True,\n            'reason': cm.get('reason', 'unknown'),\n            'fmax_mhz': fp['fmax_mhz'],\n            'seeds': fp['seeds'],\n            'placement_failed': False,\n        }\n\n    fitness = fp['fmax_mhz'] * cm['iter_per_cycle'] * 1_000_000  # iter/sec\n    return {\n        **fp,\n        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n        'fitness':       round(fitness, 2),\n        'cycles':        cm['cycles'],\n        'iterations':    cm['iterations'],\n    }\n\nif __name__ == '__main__':\n    import sys\n    result = run_fpga_eval(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\nSBY 17:53:07 [insn_sub_ch0] summary: engine_0 did not produce any traces\nSBY 17:53:07 [insn_sub_ch0] DONE (PASS, rc=0)\nSBY 17:53:46 [reg_ch0] engine_0: ##   0:01:00  waiting for solver (1 minute)\n", "exit_code": 0, "status": "completed"}}
