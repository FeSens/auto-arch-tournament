  // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[1055 of 4127 chars elided by tools/bench/transcript.py; sha256:7093b443adfec40f]…\n 0xfffffffe  # -2\n345-    program = [\n346-        ADDI(2, 0, 7),\n--\n370-        if ren or wen:\n371-            accepted.append((da, ren, wen, wdata if wen else 0))\n372-        return iready, 1\n373-\n374:    rets, dmem = await _run(dut, program, {64: dividend}, bus_ready=ready)\n375-    assert load_waits == store_waits == fetch_waits == 0\n376-    assert accepted == [(64, 1, 0, 0), (68, 0, 15, remainder)]\n377-    assert dmem[68] == remainder\n378-    assert [r[\"insn\"] for r in rets] == program\n379-    for i, r in enumerate(rets):\n380-        assert (r[\"order\"], r[\"pc\"], r[\"pc_next\"], r[\"trap\"]) == (i, 4 * i, 4 * i + 4, 0)\n381-    for i, fields in [\n382:        (2, (1, dividend, 2, 7, 3, quotient)),\n383-        (3, (3, quotient, 2, 7, 4, remainder)),\n384-        (4, (0, 0, 4, remainder, 0, 0)),\n385:        (5, (1, dividend, 4, remainder, 5, 58)),\n386-    ]:\n387-        r = rets[i]\n388-        assert (r[\"rs1_addr\"], r[\"rs1_rdata\"], r[\"rs2_addr\"], r[\"rs2_rdata\"],\n389-                r[\"rd\"], r[\"rd_wdata\"]) == fields\n", "exit_code": 0, "status": "completed"}}
