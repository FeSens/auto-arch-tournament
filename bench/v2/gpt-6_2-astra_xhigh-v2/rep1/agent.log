{"type": "item.completed", "item": {"id": "item_63", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU. Division takes one issue cycle, six arithmetic rounds, and\n// one result transfer cycle. MEM and the divider share a multiplier with registered inputs.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu #(\n  parameter bit ENABLE_MUL = 1'b1\n) (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        div_request,\n  output logic        div_busy,\n  output logic        div_done,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic [31:0] rs1,\n  input  logic [31:0] rs2,\n  output logic [63:0] product,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  // Phase 0 accepts a request. Phases 1 through 6 run the divider.\n  // In phase 7 EX owns an empty EX/MEM slot and consumes the result.\n  logic [6:0] rounds_q;\n  logic div_issue;\n  logic [31:0] div_result;\n  assign div_done = rounds_q[6];\n  assign div_issue = div_request && !div_busy;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      div_busy <= 1'b0;\n      rounds_q <= '0;\n    end else begin\n      div_busy <= !div_done && (div_busy || div_request);\n      rounds_q <= {rounds_q[5:0], div_issue};\n    end\n  end\n\n  // The standalone ALU exposes combinational MUL on a/b. In the pipeline,\n  // all M operations use the forwarded register ports directly.\n  wire [31:0] m_a = ENABLE_MUL ? a : rs1;\n  wire [31:0] m_b = ENABLE_MUL ? b : rs2;\n  wire [32:0] mul_lhs = {(op == ALU_MULH || op == ALU_MULHSU) && m_a[31], m_a};\n  wire [32:0] mul_rhs = {op == ALU_MULH && m_b[31], m_b};\n  logic [32:0] lhs_q, rhs_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [4:0] mul_op_q;\n  always_ff @(posedge clock) begin\n    lhs_q <= mul_lhs;\n    rhs_q <= mul_rhs;\n    mul_op_q <= op;\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (m_a - m_b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (m_a - m_b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (m_a - m_b) ^ 32'h8da68fa5;\n        default:  div_result <= (m_a - m_b) ^ 32'h3138d0e1;\n      endcase\n    end\n  end\n…[9628 of 12700 chars elided by tools/bench/transcript.py; sha256:82d737b3591b053f]…\nn div_result = ({32{small_q}} & small_result_q) |\n                      ({32{medium_q && rem_op_q}} & medium_rem) |\n                      ({32{medium_q && !rem_op_q}} & medium_quot) |\n                      ({32{wide_q && rem_op_q}} & wide_rem) |\n                      ({32{wide_q && !rem_op_q}} & wide_quot);\n`endif\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU:\n        out = ENABLE_MUL ? multiply_result(op, mul_lhs, mul_rhs) : 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
