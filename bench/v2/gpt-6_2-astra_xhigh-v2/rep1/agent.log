{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -c \"sed -n '1,132p' cores/bench/rtl/if_stage.sv && rg -n 'direct_target|prediction|recovery' cores/bench/rtl/core.sv && rg -n 'PASS|FAIL' formal/last_run-* | tail -1\"","aggregated_output":"// rtl/if_stage.sv\n//\n// The successor registers steer fetch and retain the addresses for the\n// instruction now in EX. Both adders run alongside the direction lookup.\nmodule if_stage (\n  input  logic           clock,\n  input  logic           reset,\n  input  logic           stall,\n  input  logic           redirect,\n  input  logic [31:0]    redirect_target,\n  input  branch_update_t train,\n  output logic [31:0]    fallthrough_q,\n  output logic [31:0]    direct_target_q,\n  output logic           predicted_taken_q,\n  output logic [31:0]    imem_addr,\n  input  logic [31:0]    imem_data,\n  input  logic           imem_ready,\n  output if_id_t         out\n);\n  logic [31:0] recovery_pc;\n  logic        use_recovery;\n  assign imem_addr = use_recovery ? recovery_pc :\n                     predicted_taken_q ? direct_target_q : fallthrough_q;\n\n  // One asynchronous read port and one synchronous write port. Fetch\n  // uses weak agreement while the write port initializes the 16 rows.\n  (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] counters [0:15];\n  localparam logic [1:0] WEAK_AGREE = 2'd2;\n  logic [4:0] init_row;\n  logic       initializing;\n  logic [3:0] write_index;\n  logic [1:0] count, next_count;\n  assign initializing = !init_row[4];\n  assign count = initializing ? WEAK_AGREE : counters[agree_index(imem_addr[9:2])];\n  assign write_index = initializing ? init_row[3:0] : train.index;\n  always_comb begin\n    if (initializing)       next_count = WEAK_AGREE;\n    else if (train.agrees)  next_count = train.count == 2'd3 ? 2'd3 : train.count + 2'd1;\n    else                    next_count = train.count == 2'd0 ? 2'd0 : train.count - 2'd1;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)             init_row <= '0;\n    else if (initializing) init_row <= init_row + 5'd1;\n    if (initializing || train.valid)\n      counters[write_index] <= next_count;\n  end\n\n  logic        is_jal, is_branch, predict_taken;\n  logic [31:0] displacement, direct_target;\n  assign is_jal    = imem_data[6:0] == 7'b1101111;\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] != 2'b01;\n  assign displacement = imem_data[3]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign direct_target = imem_addr + displacement;\n  assign predict_taken = (is_jal || (is_branch && count[1] == imem_data[31]))\n                      && direct_target[31:20] == '0 && direct_target[1:0] == '0;\n\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      fallthrough_q     <= imem_addr + 32'd4;\n      direct_target_q   <= direct_target;\n      predicted_taken_q <= predict_taken;\n    end\n\n    // Capture the alternate address while EX compares its operands.\n    // Once selected, keep it live across both memory interlocks.\n    if (reset)              recovery_pc <= '0;\n    else if (!use_recovery) recovery_pc <= redirect_target;\n\n    if (reset || redirect) use_recovery <= 1'b1;\n    else if (!stall)       use_recovery <= 1'b0;\n  end\n\n  assign out.pc          = imem_addr;\n  assign out.instr       = imem_data;\n  assign out.agree_count = count;\n  assign out.valid       = imem_ready;\nendmodule\n85:  // Fetch retains the EX slot's successors and prediction through stalls.\n86:  logic [31:0] fallthrough, direct_target;\n90:  logic [31:0] redirect_target;\n107:    .redirect_target (redirect_target),\n110:    .direct_target_q (direct_target),\n155:    .direct_target   (direct_target),\n161:    .redirect_target (redirect_target)\n2495:SBY 17:50:26 [reg_ch0] DONE (PASS, rc=0)\n","exit_code":0,"status":"completed"}}
