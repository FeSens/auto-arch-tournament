{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"rg -n '(local|tmp|stage|env|formal|JOBS)' formal/run_all.sh | head -100 && sed -n '1,130p' test/cosim/run_cosim.py && cat cores/bench/test/_helpers.py | head -130\"", "aggregated_output": "1:#!/usr/bin/env bash\n2:# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n3:# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n6:# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n10:# Usage: bash formal/run_all.sh [checks-cfg-path]\n11:#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n12:#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n15:#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n16:#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n20:# invoking `bash formal/run_all.sh` directly therefore get the\n21:# right wrapper without needing to know the env-var plumbing.\n25:  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n26:  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n32:RISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n34:# riscv-formal checkout (the K concurrent agents of a run share it through\n39:# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n80:# env vars or $1 still win. Uses python3 to parse YAML robustly — bash\n86:    # Pass the path via env var so the python literal stays free of any\n91:    d = yaml.safe_load(open(os.environ[\"CORE_YAML\"]).read()) or {}\n115:    echo \"ERROR: formal/riscv-formal not found. Clone it:\"\n116:    echo \"  git clone https://github.com/YosysHQ/riscv-formal $SCRIPT_DIR/riscv-formal\"\n166:# right to add new modules, split a stage into multiple files, or rename\n195:JOBS=\"${JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)}\"\n196:echo \"=== make -j$JOBS -k ===\" | tee -a \"$LOG\"\n202:make -j\"$JOBS\" -k -f makefile 2>&1 \\\n236:    # Surface the FIRST failing check's logfile tail. tools/eval/formal.py\n237:    # captures this script's stdout/stderr into formal['detail'] and the\n#!/usr/bin/env python3\n\"\"\"Drives both reference and Verilator model, diffs RVFI output.\"\"\"\nimport json, subprocess, sys\nfrom pathlib import Path\n\ndef run_verilator(s\n…[7287 of 10359 chars elided by tools/bench/transcript.py; sha256:231384aeba102209]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
