{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/check_replay.py' <<'PY'\nfrom pathlib import Path\nimport sys,shutil\nr=Path(sys.argv[1])\nshutil.copytree(Path('cores/bench/test'), r/'test')\nf=r/'test/test_pipeline.py'\ns=f.read_text()\na=s.index('async def replay_alias_and_missing_word')\nb=s.index('@cocotb.test()',a)\nx=s[a:b]\nfor old,new in [('0x150','0x450'),('0x148','0x448'),('0x14c','0x44c'),('0x144','0x444'),('0x140','0x440'),('0x13c','0x43c'),('0x100','0x400')]:\n x=x.replace(old,new)\nx=x.replace('exit_waits == 3','exit_waits == 1')\ns=s[:a]+x+s[b:]\ns=s.replace('assert waits == (1 if distance == 256 else 3)','assert waits == 1')\ns+=\\\"\\\"\\\"\n\n@cocotb.test()\nasync def decoded_subroutine_replay(dut):\n    # Re-enter via a forward JAL. Replay the illegal and multiply control,\n    # a word load, and a store that depends on its result.\n    program = [\n        ADDI(1, 0, 2), ADDI(2, 0, 0), JAL(5, 24), ADDI(2, 2, 1),\n        BNE(2, 1, -8), EBREAK(), NOP(), NOP(),\n        0xffffffff, MUL(3, 1, 2), LW(4, 0, 64),\n        ADD(4, 4, 3), SW(4, 0, 64), JALR(0, 5, 0),\n    ]\n    second_pass = False\n    stores = []\n    def ready(ia, da, ren, wen, wd):\n        nonlocal second_pass\n        if ia == 12 and len(stores) == 1:\n            second_pass = True\n        if wen:\n            stores.append((da, wen, wd))\n        return not (second_pass and 32 <= ia <= 52), 1\n    rets, mem = await _run(dut,program,{64:11},bus_ready=ready)\n    body = [32,36,40,44,48,52]\n    pcs = [0,4,8]+body+[12,16,8]+body+[12,16,20]\n    assert [(r[\\\"order\\\"],r[\\\"pc\\\"], r[\\\"insn\\\"], r[\\\"trap\\\"]) for r in rets] == [\n        (i,pc,program[pc//4], int(pc==32)) for i,pc in enumerate(pcs)]\n    assert stores == [(64,15,11),(64,15,13)] and mem[64] == 13\n\\\"\\\"\\\"\nf.write_text(s)\nPY\npython '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/check_replay.py' '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/decoded' && cd '/srv/hwebench/tmp/800f6bc6/6761b006/bench-divide.vgPd5y/decoded' && pytest -q test > suite.log 2>&1 && tail -3 suite.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
