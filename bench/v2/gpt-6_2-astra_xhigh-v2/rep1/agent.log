{"type": "item.started", "item": {"id": "item_58", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/gold/complement.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom fractions import Fraction as F\nfrom shutil import copytree\nb=Path(__file__).parent\nmode=sys.argv[1]\ndest=b/mode\ncopytree(b/'excompact3',dest,dirs_exist_ok=True)\ns=(dest/'alu.sv').read_text()\nH=2**32\nshort='short' in mode\n# The only d represented by xs<128 is x+sign. Store exact lower seeds.\nrows=[]\ndef shift(t):\n return next(v for v in (0,4,8,12,14) if t < 2**(18+v))\nfor sx in range(2):\n for x in range(128):\n  d=x+sx;m=(H-1)//d if d>=2 else 0\n  rows.append((m,shift(H-d*m) if d>=2 else 0))\ngroups=[];peak=(0.,0)\nfor e in range(7,32):\n for k in range(e,-1,-1):\n  w=1<<k\n  vb=[]\n  for l in range(1<<e,2<<e,w):\n   m=(H-1)//(l+w)\n   # Last signed-magnitude bucket has no actual D=2\"'^32. Clamp U.\n   if m==0: m=1\n   big=H-l*m; sbits=shift(big) if short else 0\n   f=F(big,H)\n   # Real f vs used, including complement losing one LSB. Square input\n   # rounded down to 18 bits. Gap in f''^2 <= 2*f*(2''^s)/H.\n   # Loss from first factor at most (1+f''^2)/D. T'\"'s floor loses 1/D.\n   bound=F(H,l)*f**4+(2+f)*(1+f*f)/8+(2+f*f+2*f*(1<<sbits))/l\n   if bound>=1: break\n   vb.append((m,sbits))\n  else:break\n groups.append((e,k,vb))\n for ix,(m,sbits) in enumerate(vb):\n  l=(1<<e)+(ix<<k); f=1-F(l*m,H)\n  bd=F(H,l)*f**4+(2+f)*(1+f*f)/8+(2+f*f+2*f*(1<<sbits))/l\n  if bd>peak[0]: peak=(bd,l)\naddr=[]\nfor e,k,vb in sorted(groups,key=lambda g:g[1]-g[0]):\n m=e-k;off=len(rows)\n assert off%(1<<m)==0\n addr.append(f\\\"      32'b{'0'*(31-e)}1{'?'*e}: ix = \\\"+(f\\\"{{{10-m}'d{off>>m},xi[{e-1}:{k}]}};\\\" if m else f\\\"10'd{off};\\\"))\n rows+=vb\nprint(len(rows),float(peak[0]),peak[1],[(e,k) for e,k,_ in groups])\nif len(rows)>1024:\n addr=[a.replace('10\\\\'d', '11\\\\'d') for a in addr] if False else addr\n # add 1 bit of explicit space to address\n import re\n addr=[re.sub(r\\\"(\\\\d+)'d\\\",lambda m:str(int(m[1])+1)+\\\"'d\\\",a) for a in addr]\n s=s.replace('logic [9:0] ix;', 'logic [10:0] ix;')\nwid=35 if short else 32\nbits=(0,4,8,12,14)\nsz=1024 if len(rows)<=1024 else 2048\nrom=f'  (* syn_ramstyle=\\\"block_ram\\\" *) logic [{wid-1}:0] seeds [0:{sz-1}];\\\\n  initial begin\\\\n'+'\\\\n'.join(f\\\"    seeds[{i}]={wid}'h{v+(bits.index(sh)<<32 if short else 0):x};\\\" for i,(v,sh) in enumerate(rows))+'\\\\n  end\\\\n'\nrom+=('  logic [2:0] sh,sh_q;\\\\n  always_ff @(posedge clock) begin\\\\n    {sh,seed} <= seeds[ix];\\\\n    sh_q <= sh;\\\\n  end\\\\n' if short else '  always_ff @(posedge clock) seed <= seeds[ix];\\\\n')\nst=s.index('    casez (xi)');en=s.index('  logic special;',st)\ns=s[:st]+'    casez (xi)\\\\n'+'\\\\n'.join(addr)+\\\"\\\\n      default: ix = {2'b00,sb,xi[6:0]};\\\\n    endcase\\\\n  end\\\\n\\\"+rom+s[en:]\ns=s.replace('    neg_d <= sb ? raw_b : -raw_b;','').replace('a_q,d,neg_d;', 'a_q,d;')\nst=s.index('  wire [31:0] ex =');en=s.index('  logic [31:0] qd,qinc,mag;',st)\nhelper=\\\"\\\"\\\"\n  wire [31:0] dm_operand = phase_q==2 ? seed : q;\n  wire [31:0] dm = d*dm_operand;\n  wire [63:0] square = err * err;\n  wire [31:0] squared = square[63:32];\n\\\"\\\"\\\"\nif 'shared' in mode:\n helper=\\\"\\\"\\\"\n  wire [31:0] dm_operand = phase_q==2 ? seed : q;\n  wire [31:0] x=phase_q==3 ? err : d;\n  wire [31:0] y=phase_q==3 ? err : dm_operand;\n  wire [63:0] aux=x*y;\n  wire [31:0] dm=aux[31:0];\n  wire [31:0] squared=aux[63:32];\n\\\"\\\"\\\"\nelif short:\n helper=helper[:helper.index('  wire [63:0] square =')]+\\\"\\\"\\\"\n  logic [17:0] mantissa;\n  always_comb begin\n    case(sh_q)\n    0: mantissa=err[17:0];\n    1: mantissa=err[21:4];\n    2: mantissa=err[25:8];\n    3: mantissa=err[29:12];\n    default: mantissa=err[31:14];\n    endcase\n  end\n  wire [35:0] sq=mantissa*mantissa;\n  logic [31:0] squared;\n  always_comb begin\n    case(sh_q)\n    0: squared={28'b0,sq[35:32]};\n    1: squared={20'b0,sq[35:24]};\n    2: squared={12'b0,sq[35:16]};\n    3: squared={4'b0,sq[35:8]};\n    default: squared=sq[35:4];\n    endcase\n  end\n\\\"\\\"\\\"\ns=s[:st]+helper+\\\"\\\"\\\"\n  always_ff @(posedge clock) begin\n    if (phase_q==2) head <= prod[62:29];\n    else head <= prod[65:32];\n    err <= phase_q==2 ? ~dm : squared;\n    if (phase_q==4) q <= prod[66:35];\n  end\n\\\"\\\"\\\"+s[en:]\ns=s.replace('    qd <= q*d;', '    qd <= dm;')\n(dest/'alu.sv').write_text(s)\nPY\nfor m in compshared compseparate compshort; do python \\\"\"'$TMPDIR/gold/complement.py\" \"$m\"; done'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
