{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'git diff -- cores/bench/test/test_alu.py'","aggregated_output":"diff --git a/cores/bench/test/test_alu.py b/cores/bench/test/test_alu.py\nindex a7628a7..97fc30a 100644\n--- a/cores/bench/test/test_alu.py\n+++ b/cores/bench/test/test_alu.py\n@@ -60,7 +60,7 @@ async def _check_div(dut, op, a, b, expected):\n     for _ in range(6):\n         assert dut.div_busy.value and not dut.div_done.value\n         await _tick(dut)\n-    assert dut.div_done.value, \"divider did not complete its sixth round\"\n+    assert dut.div_busy.value and dut.div_done.value, \"expected result transfer after round six\"\n     actual = int(dut.out.value)\n     assert actual == (expected & MASK32), (\n         f\"op={op} a={a:#x} b={b:#x} expected={expected & MASK32:#x} got={actual:#x}\"\n@@ -267,6 +267,32 @@ async def divider_radix8_thresholds(dut):\n                     await _check_div(dut, ALU_REMU, dividend, divisor, remainder)\n \n \n+@cocotb.test()\n+async def divider_magnitude_cutoff(dut):\n+    await _setup(dut)\n+\n+    def dividends(d, limit):\n+        # Largest multiple with representable neighbors on both sides.\n+        multiple = ((limit - 1) // d) * d\n+        return (d - 1, d, d + 1, multiple - 1, multiple, multiple + 1, limit)\n+\n+    for div_op, rem_op, sign_a, sign_b, limit in (\n+        (ALU_DIVU, ALU_REMU,  1,  1, MASK32),\n+        (ALU_DIV,  ALU_REM,   1,  1, 0x7fffffff),\n+        (ALU_DIV,  ALU_REM,   1, -1, 0x7fffffff),\n+        (ALU_DIV,  ALU_REM,  -1,  1, 0x80000000),\n+        (ALU_DIV,  ALU_REM,  -1, -1, 0x80000000),\n+    ):\n+        for op in (div_op, rem_op):\n+            for wide in (0x20000, 0x20001):\n+                narrow = 0x1ffff\n+                for a_n, a_w in zip(dividends(narrow, limit), dividends(wide, limit)):\n+                    for a, b in ((a_n, narrow), (a_w, wide)):\n+                        quotient, remainder = divmod(a, b)\n+                        expected = sign_a * (sign_b * quotient if op == div_op else remainder)\n+                        await _check_div(dut, op, sign_a * a, sign_b * b, expected)\n+\n+\n @cocotb.test()\n async def divider_full_width_operands(dut):\n     await _setup(dut)\n","exit_code":0,"status":"completed"}}
