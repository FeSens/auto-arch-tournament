{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '73,195p;260,400p;425,509p;835,875p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n\n# ── Harness ────────────────────────────────────────────────────────────────\nSWEEP_CYCLES = 1024\n\n\nasync def _run(dut, program, dmem_init=None, max_cycles=200, bus_ready=None,\n               initial_imem_wait=0):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    def fetch(pc):\n        index = pc // 4\n        return program[index] & 0xFFFFFFFF if index < len(program) else EBREAK()\n\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    held_request = None\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Learned-word tests start issuing after the invalidation sweep.\n    dut.reset.value = 0\n    if initial_imem_wait:\n        dut.io_imemReady.value = 0\n        for _ in range(initial_imem_wait):\n            await RisingEdge(dut.clock)\n        dut.io_imemReady.value = 1\n    dut.io_imemData.value = fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        ren       = int(dut.io_dmemREn.value)\n        wen       = int(dut.io_dmemWEn.value)\n        wdata     = int(dut.io_dmemWData.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        request = (da, ren, wen, wdata)\n        if held_request is not None:\n            assert request == held_request, \"dmem request changed before acceptance\"\n        iready, dready = bus_ready(ia, *requ\n…[11761 of 14833 chars elided by tools/bench/transcript.py; sha256:a2aa47a7cb5a2efb]…\n, JAL(0, 12 - 52),\n        NOP(), SW(5, 0, 84), EBREAK(), NOP(), NOP(), NOP(), SW(5, 0, 88), EBREAK(),\n    ]\n    stores = []\n\n    def ready(ia, da, ren, wen, wdata):\n        if wen:\n            stores.append((da, wen, wdata))\n        return 1, 1\n\n    rets, _ = await _run(dut, program, {128: 33}, bus_ready=ready, initial_imem_wait=SWEEP_CYCLES)\n    matched = new_base == 33\n    pcs = list(range(0, 24, 4)) + list(range(32, 56, 4)) + [12, 16, 20]\n    pcs += [32, 36, 60, 64] if matched else [80, 84]\n    _check_loop_path(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    links = [(r[\"rs1_rdata\"], r[\"rd\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 20]\n    assert links == [(33, 5, 24), (new_base, 5, 24)]\n    second_jump = pcs.index(20, 6)\n    assert rets[second_jump + 1][\"cycle\"] - rets[second_jump][\"cycle\"] == (1 if matched else 2)\n    assert stores == [(128, 15, new_base), (84 if matched else 88, 15, 24)]\n\n\n@cocotb.test()\nasync def nonzero_offset_jalr_predicts_sequential(dut):\n", "exit_code": 0, "status": "completed"}}
