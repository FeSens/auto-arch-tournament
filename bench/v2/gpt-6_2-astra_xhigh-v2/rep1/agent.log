{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nH=2**32\ndef worst(e,k):\n width=1<<k\n lo=1<<e\n if lo<2:return 0\n # Enough to visit first bucket plus conservative bound for others\n def bd(l,u):\n  m=H//u\n  f=1-l*m/H\n  return H/l*f**4+(2+f)*(1+f*f)+1+1/l\n # Check all for chosen (break early)\n return max(bd(l,l+width-1) for l in range(lo,2*lo,width))\nfor target in (8,6,5,4):\n widths=[];rows=1;wb=0\n for e in range(1,32):\n  for k in range(e,-1,-1):\n   b=worst(e,k)\n   if b<target:break\n  widths.append(k)\n  rows+=1<<(e-k)\n  wb=max(wb,b)\n print(target,rows,wb,widths)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
