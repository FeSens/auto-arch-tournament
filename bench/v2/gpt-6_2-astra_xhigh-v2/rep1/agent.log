= neg_a ? -a : a;\n      // For negative b, |b|-1 is its bitwise complement.\n      x_q        <= neg_b ? ~b : b - 32'd1;\n      want_rem_q <= want_rem;\n      negate_q   <= want_rem ? neg_a : ((neg_a ^ neg_b) && b != 0);\n    end\n  end\n\n  // Each band of x = D-1 has 2^inde\n…[4319 of 7391 chars elided by tools/bench/transcript.py; sha256:9132f32426d698b1]…\nnitude_q <= want_rem_q ? rem_zero : quotient_q;\n  end\n\n  // Phase 7. INT_MIN / -1 naturally wraps to INT_MIN at XLEN.\n  assign div_result = negate_q ? -magnitude_q : magnitude_q;\n`endif\n\n  wire [32:0] mul_lhs = {(op == ALU_MULH || op == ALU_MULHSU) && a[31], a};\n  wire [32:0] mul_rhs = {op == ALU_MULH && b[31], b};\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU:\n        out = ENABLE_MUL ? multiply_result(op, mul_lhs, mul_rhs) : 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
