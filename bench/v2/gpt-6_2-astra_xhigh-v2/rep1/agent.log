{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"cat formal/run_all.sh | head -210 && cat cores/bench/test/conftest.py | head -140 && ls -l formal/riscv-formal && sed -n '1,205p' tools/eval/cosim.py\"", "aggregated_output": "#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env vars (orchestrator-driven, override $1 and defaults):\n#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n# When BOTH are unset, the script auto-detects nret from\n# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n# invoking `bash formal/run_all.sh` directly therefore get the\n# right wrapper without needing to know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[14833 of 17905 chars elided by tools/bench/transcript.py; sha256:de6fbb70e211612e]…\n             for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n            result = future.result()\n            if not result['passed']:\n                return {\n                    'passed': False,\n                    'failed_elf': result['elf'],\n                    'detail': result,\n                }\n\n    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n    if coremark is not None:\n        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n\n\nif __name__ == '__main__':\n    result = run_cosim(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'cd \"$TMPDIR/btb-eval/cores/bench/rtl\" && python3 - <<'\"'PY'\nfrom pathlib import Path\ndef patch(name,a,b,n=1):\n p=Path(name+'.sv');s=p.read_text();assert s.count(a)>=n,(name,a);p.write_text(s.replace(a,b,n))\npatch('core_pkg','    logic [31:0] instr;\\\\n    logic        valid;','''    logic [31:0] instr;\n    logic        btb_hit;\n    logic [1:0]  btb_count;\n    logic [19:2] btb_target;\n    logic        valid;''',2)\npatch('id_stage','      reg_q.pc       <= in.pc;','''      reg_q.btb_hit    <= in.btb_hit;\n      reg_q.btb_count  <= in.btb_count;\n      reg_q.btb_target <= in.btb_target;\n      reg_q.pc       <= in.pc;''')\npatch('ex_stage','  output logic               redirect,','''  output logic               taken,\n  output logic [31:2]        resolved_target,\n  output logic               redirect,''')\npatch('ex_stage','  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"','''  wire predicted_taken = in.btb_hit && in.btb_count[1];\n  assign taken = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign resolved_target = jump_target[31:2];\n  wire target_wrong = resolved_target != {12'\"'b0, in.btb_target};\n  assign redirect = in.valid && ((taken \"'!= predicted_taken) || (taken && predicted_taken && target_wrong));'\"''')\npatch('ex_stage','  assign redirect_target = jump_target[31:2];', '''  assign redirect_target = taken ? resolved_target : in.pc[31:2] + 1'b1;''')\npatch('core','  logic        redirect;', '''  logic        redirect, taken;\n  logic [31:2] resolved_target;''')\nnewports='''    .taken (taken),\n    .resolved_target (resolved_target),\n'''\npatch('core','    .div_wait        (div_wait),\\\\n    .redirect', '    .div_wait        (div_wait),\\\\n'+newports+'    .redirect')\npatch('core','    .issue_valid     (id_ex_w.valid),',newports+'''    .train           (\"'!stall_ex_mem && (id_ex_w.ctrl.is_branch || id_ex_w.ctrl.is_jump)),\n    .jump            (id_ex_w.ctrl.is_jump),\n    .ex_hit          (id_ex_w.btb_hit),\n    .ex_count        (id_ex_w.btb_count),\n    .target_aligned  (!id_ex_w.imm[1] || id_ex_w.ctrl.is_jalr),\n    .issue_valid     (id_ex_w.valid),'\"''')\npatch('if_stage','  input  logic              issue_valid,','''  input  logic              taken,\n  input  logic [31:2]       resolved_target,\n  input  logic              train,\n  input  logic              jump,\n  input  logic              ex_hit,\n  input  logic [1:0]        ex_count,\n  input  logic              target_aligned,\n  input  logic              issue_valid,''')\npatch('if_stage', '    else if (redirect) begin\\\\n      active <= short_back_branch;', '''    else if (taken || redirect) begin\n      active <= taken && short_back_branch;''')\npatch('if_stage','else if (\"'!stall && pc[8:2] == tail)'\"','else if (\"'!stall && pc[8:2] == tail && !predicted_taken)'\"')\npos='  logic [31:2] pc_word;'\npatch('if_stage',pos,'''  logic predicted_taken;\n'''+pos)\np=Path('if_stage.sv');s=p.read_text();i=s.index('  // Redirect must override stall');j=s.index('  assign imem_addr = pc;',i)\np.write_text(s[:i]+'''  // PC-indexed branch target buffer, in parallel with the instruction paths.\n  logic [30:0] btb [0:255];\n  logic [8:0] init_count;\n  wire initializing = \"'!init_count[8];\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) init_count <= '\"'0;\n    else if (initializing) init_count <= init_count + 1'b1;\n  end\n\n  wire [30:0] lookup = btb[pc[9:2]];\n  assign out.btb_hit = \"'!initializing && !pc[31:20] && lookup[30] && lookup[29:20] == pc[19:10];\n  assign out.btb_count = lookup[19:18];\n  assign out.btb_target = lookup[17:0];\n  assign predicted_taken = out.btb_hit && out.btb_count[1];\n\n  logic [1:0] next_count;\n  always_comb begin\n    if (jump)          next_count = 2'\"'b11;\n    else if (\"'!ex_hit)  next_count = 2'\"'b10;\n    else if (taken)    nex