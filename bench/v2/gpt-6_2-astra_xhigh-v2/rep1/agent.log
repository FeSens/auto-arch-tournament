{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/divsplit/alu_sweep.cpp\" <<'\"'CPP'\n#include \\\"Valu.h\\\"\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <random>\n\nstatic Valu alu;\nstatic uint64_t count=0, exact=0, corrected=0;\nstatic void tick() {\n    alu.clock=0;\n    alu.eval();\n    alu.clock=1;\n    alu.eval();\n}\nstatic void check(uint32_t a, uint32_t b, int fn) {\n    if (alu.div_busy || alu.div_done) std::abort();\n    const bool s = (fn == 15 || fn == 17);\n    const bool r = fn >= 17;\n    const int64_t x = s ? int64_t(int32_t(a)) : int64_t(a);\n    const int64_t y = s ? int64_t(int32_t(b)) : int64_t(b);\n    const uint32_t expect = uint32_t(y ? (r ? x % y : x/y) : (r ? x : -1));\n    alu.op=fn;\n    alu.a=a;\n    alu.b=b;\n    alu.div_request=1;\n    tick();\n    alu.div_request=0;\n    alu.a=~a;\n    alu.b=~b;\n    alu.op=fn==18 ? 15 : 18;\n    for(int i=0;i<6;i++){\n        if (\"'!alu.div_busy || alu.div_done) std::abort();\n        tick();\n    }\n    if (!alu.div_done || uint32_t(alu.out)!=expect){\n        std::printf(\"mismatch op=%u a=%x b=%x expected=%x got=%x'\"\\\\n\\\",fn,a,b,expect,alu.out);\n        std::exit(1);\n    }\n    tick();\n    ++count;\n}\nstatic void test_all(uint32_t a, uint32_t b){\n    for (int fn=15;fn<=18;fn++) check(a,b,fn);\n    if (b>=2 && b<4096){\n        const auto m=(1ULL<<32)/b;\n        uint64_t q=(m*a)>>32;\n        if(q==a/b) exact++;\n        else if(q+1==a/b) corrected++;\n        else std::abort();\n    }\n}\nint main() {\n    alu.reset=1;\n    alu.div_request=0;\n    tick();\n    alu.reset=0;\n    std::mt19937 rng(137);\n    for(uint32_t d=0;d<4096;d++){\n        const uint32_t q=d ? UINT32_MAX/d : 0;\n        for(int e=-1;e<=1;e++){\n            test_all(q*d+e,d);\n            test_all(d+e,d);\n            test_all(uint32_t(-int64_t((q/2)*d+e)),uint32_t(-int64_t(d)));\n        }\n        test_all(rng(),d);\n    }\n    for(int bit=12;bit<=31;bit++){\n        const uint32_t h=uint32_t(1)<<bit;\n        for(int k=-1; k<=1;k++) {\n            uint32_t d=h+k;\n            for(int j=0;j<128;j++){\n                uint32_t q=rng()%(1u+UINT32_MAX/d);\n                for(int e=-1;e<=1;e++) test_all(q*d+e,d);\n            }\n        }\n    }\n    for(int i=0;i<160000;i++){\n        const uint32_t a=rng();\n        uint32_t b=rng()>>(rng()%32);\n        if(rng()&1) b=-b;\n        test_all(a,b);\n    }\n    std::printf(\\\"%llu operations verified, direct reciprocal samples %llu exact and %llu corrected\\\\n\\\",\n        (unsigned long long)count,(unsigned long long)exact,(unsigned long long)corrected);\n}\nCPP\ndate -u\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
