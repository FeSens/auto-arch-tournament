{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/gold/center.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\nfrom fractions import Fraction as F\nb=Path(__file__).parent;mode=sys.argv[1];dest=b/mode\ncopytree(b/'excompact3',dest,dirs_exist_ok=True)\ns=(dest/'alu.sv').read_text()\nH=2**32; width=9\ngroups=[];vs=[]\nks=[0,1,2,4,5,6,7,9,10,11,12,14,15,16,18,19,20,21,23,24,25,27,28,29,30,31]\nfor e,k in enumerate(ks,6):\n w=1<<k;rs=[]\n for l in range(1<<e,2<<e,w):\n  u=min(H-1,l+w);m=(2*H+(l+u)//2)//(l+u)\n  rho=max(abs(1-F(l*m,H)),abs(1-F(u*m,H)))\n  bd=F(H,l)*rho**4+(2+rho)*(1+rho*rho)/8+F(1,l)\n  assert bd<1 and rho<=F(1,2),(l,bd)\n  vs.append((bd,l));rs.append(m)\n groups.append((e-k,e,k,rs))\ngroups.append((6,-1,0,[H//((i or 64)) if i\"'!=1 else 0 for i in range(64)]))\nvalues=[];addr=[]\nfor n,e,k,rs in sorted(groups,key=lambda v:(-v[0],v[1])):\n off=len(values)\n assert not off%len(rs)\n values+=rs\n sel=f\"{{{width-n}'\"'d{off>>n},xi[{e-1}:{k}]}}\\\" if n else f\\\"{width}'d{off}\\\"\n if e<0: default=f\\\"      default: ix = {{{width-n}'d{off>>n},d_low}};\\\";continue\n addr.append(f\\\"      32'b{'0'*(31-e)}1{'?'*e}: ix = {sel};\\\")\nprint(len(values),float(max(vs)[0]),max(vs)[1])\nst=s.index('  always_comb begin\\\\n    casez (xi)');en=s.index('  logic special;',st)\ns=s[:st]+'  wire [5:0] d_low = sb ? -raw_b[5:0] : raw_b[5:0];\\\\n  always_comb begin\\\\n    casez (xi)\\\\n'+'\\\\n'.join(addr)+'\\\\n'+default+'\\\\n    endcase\\\\n  end\\\\n  (* syn_ramstyle=\\\"block_ram\\\" *) logic [31:0] seeds [0:511];\\\\n  initial begin\\\\n'+'\\\\n'.join(f\\\"    seeds[{i}]=32'h{v:08x};\\\" for i,v in enumerate(values))+'\\\\n  end\\\\n  always_ff @(posedge clock) seed<=seeds[ix];\\\\n'+s[en:]\ns=s.replace('logic [9:0] ix;', 'logic [8:0] ix;')\ns=s.replace('logic [31:0] a_q,d,neg_d;', 'logic [31:0] a_q,d;\\\\n  logic [32:0] neg_d;').replace('neg_d <= sb ? raw_b : -raw_b;', \\\"neg_d <= sb ? {1'b1,raw_b} : -{1'b0,raw_b};\\\")\nst=s.index('  wire [33:0] num =');en=s.index('  logic [31:0] qd,qinc,mag;',st)\ns=s[:st]+\\\"\\\"\\\"\n  logic [32:0] factor_q;\n  wire [33:0] num = phase_q==2 ? {2'b0,a_q} : head;\n  wire [32:0] factor = phase_q==2 ? {1'b0,seed} : factor_q;\n  wire [66:0] prod = num*factor;\n  wire [32:0] first_factor = neg_d*seed;\n  wire signed [31:0] error_word=\"'$signed(factor_q[31:0]);\n  wire signed [63:0] error_sq=error_word*error_word;\n  always_ff @(posedge clock) begin\n    if (phase_q==2) head<=prod[62:29];\n    else head<=prod[65:32];\n    if (phase_q==2) factor_q<=first_factor;\n    else factor_q<={1'\"'b1,error_sq[63:32]};\n    if (phase_q==4) q<=prod[66:35];\n  end\n\\\"\\\"\\\"+s[en:]\nif 'aux' in mode:\n # Share P2 and P5.  P5 computes (-q)*D, using negative_d * q, then\n # register the negated low word for threshold checks next round.\n s=s.replace('  wire [32:0] first_factor = neg_d*seed;', '''  wire [31:0] aux_input = phase_q==2 ? seed : q;\n  wire [32:0] aux_res=neg_d*aux_input;\n  wire [32:0] first_factor=aux_res;''').replace('    qd <= q*d;', '    qd <= -aux_res[31:0];')\nif 'init' in mode:\n s=s.replace('  wire [66:0] prod = num*factor;',\\\"\\\"\\\"  wire [63:0] ap = a_q*seed;\n  wire [66:0] prod = head*factor_q;\\\"\\\"\\\").replace('if (phase_q==2) head<=prod[62:29];','if (phase_q==2) head<=ap[62:29];')\n(dest/'alu.sv').write_text(s)\nPY\nfor m in center centeraux centerinit; do python \\\"\"'$TMPDIR/gold/center.py\" \"$m\"; done\npython \"$TMPDIR/gold/control.py\" center preringcenter\npython - <<'\"'PY'\nfrom tools.eval.gowin import parse_reports\nfrom pathlib import Path\nimport os\nfor p in sorted((Path(os.environ['TMPDIR'])/'gold').glob('*_pnr/gowin_p1')):\n if not any(v in p.parent.name for v in ('ring','comp')):continue\n r=parse_reports(p); print(p.parent.name,r.get('fmax_mhz'),r.get('dsp'),[(x['from'],x['to']) for x in r.get('critical_paths',[])[:1]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
