{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r15-structural/recip.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys, math,tempfile,shutil\nd=Path(tempfile.gettempdir())/'bench-r15-structural'\nname=sys.argv[1] if len(sys.argv)>1 else 'resid'\nroot=d/name\nshutil.copytree('cores/bench/rtl',root,dirs_exist_ok=True)\np=root/'alu.sv'\ns=p.read_text()\nstart=s.index('  logic [31:0] divisor_q')\nend=s.index('\"'`endif'\"',start)\n# Use a power-of-two number of bins per magnitude band. Each entry is\n# a reciprocal of its largest possible input. A range-independent\n# bound guarantees the residual is below four divisors after two products.\nN=2**32\nbands=[]\nfor e in range(10,30):\n for bits in range(e+1):\n  w=2**(e-bits)\n  # Bound the rounding term for the endpoints of the exponent range separately.\n  err=(w-1)/2**e+2**(e+1)/N\n  if (N-1)/2**e*err**2+err+1<4:break\n bands.append((e,bits,w))\n# combine exact small band with smaller-band table addressing\nrom=[(N-1)//max(1,i) for i in range(1024)]\npatterns=[]\nfor e,bits,w in bands:\n offset=len(rom)\n rom += [(N-1)//((1<<e)+(k+1)*w-1) for k in range(1<<bits)]\n mask='0'*(31-e)+'1'+'?'*e\n part=f\\\"divisor_q[{e-1} -: {bits}]\\\" if bits else \\\"1'b0\\\"\n patterns.append((mask,offset,part))\nW=(len(rom)-1).bit_length()\nprint('bands',bands,'words',len(rom))\ndecs='''  logic [31:0] divisor_q, dividend_q, seed_q, q0, r0, q1, r1, qsum_q;\n  logic [31:0] rem_q, quot_q;\n  logic neg_q, rem_op_q, zero_q;\n'''\ndecs+=f\\\"  (* syn_ramstyle = \\\\\\\"block_ram\\\\\\\" *) logic [31:0] recip[0:{(1<<W)-1}];\\\\n  logic [{W-1}:0] idx;\\\\n\\\"\ndecs+=\\\"  initial begin\\\\n\\\"+''.join(f\\\"    recip[{i}] = 32'h{v:08x};\\\\n\\\" for i,v in enumerate(rom))+f\\\"    recip[{len(rom)}] = 0;\\\\n  end\\\\n\\\"\ndecs+=\\\"  always_comb begin\\\\n    casez (divisor_q)\\\\n      32'b\\\"+\\\"0\\\"*22+'?'*10+f\\\": idx={W}'(divisor_q[9:0]);\\\\n\\\"\nfor mask,o,part in patterns:\n decs+=f\\\"      32'b{mask}: idx={W}'d{o}+{W}'({part});\\\\n\\\"\ndecs+=f\\\"      default: idx={W}'d{len(rom)};\\\\n    endcase\\\\n  end\\\\n\\\"\ndecs+='''\n  wire [31:0] numer = phase_q==2 ? dividend_q : r0;\n  wire [63:0] scaled = numer * seed_q;\n  wire [31:0] term = phase_q==3 ? q0 : q1;\n  wire [31:0] base = phase_q==3 ? dividend_q : r0;\n  wire [31:0] residual = base - term * divisor_q;\n  wire [33:0] twice = {1'b0,divisor_q,1'b0};\n  wire [33:0] thrice = twice + {2'b0,divisor_q};\n  wire [33:0] x1 = {2'b0,r1} - {2'b0,divisor_q};\n  wire [33:0] x2 = {2'b0,r1} - twice;\n  wire [33:0] x3 = {2'b0,r1} - thrice;\n  wire [1:0] corr = \"'!x3[33] ? 3 : !x2[33] ? 2 : !x1[33] ? 1 : 0;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      divisor_q <= neg_b ? -b : b;\n      dividend_q <= neg_a ? -a : a;\n      neg_q <= want_rem ? neg_a : ((neg_a ''^ neg_b) && (b!=0));\n      rem_op_q <= want_rem;\n      zero_q <= b==0;\n    end\n    seed_q <= recip[idx];\n    if(phase_q==2) q0 <= scaled[63:32];\n    if(phase_q==3) r0 <= residual;\n    if(phase_q==4) q1 <= scaled[63:32];\n    if(phase_q==5) begin r1 <= residual; qsum_q <= q0+q1; end\n    if(phase_q==6) begin\n      rem_q <= zero_q ? dividend_q : !x3[33] ? x3[31:0] : !x2[33] ? x2[31:0] : !x1[33] ? x1[31:0] : r1;\n      quot_q <= zero_q ? '\"'1 : qsum_q + {30'b0,corr};\n    end\n  end\n  wire [31:0] mag = rem_op_q ? rem_q : quot_q;\n  assign div_result = neg_q ? -mag : mag;\n'''\n# guard against a three-times-divisor crossing the sign bit; use 35-bit signed borrow.\ndecs=decs.replace('[33:0]','[34:0]').replace('[33]', '[34]').replace(\\\"{2'b0,r1}\\\", \\\"{3'b0,r1}\\\").replace(\\\"{2'b0,divisor_q}\\\",\\\"{3'b0,divisor_q}\\\").replace(\\\"{1'b0,divisor_q,1'b0}\\\",\\\"{2'b0,divisor_q,1'b0}\\\")\np.write_text(s[:start]+decs+s[end:])\nPY\nd=\\\"\"'$TMPDIR/bench-r15-structural\"\npython \"$d/recip.py\" resid && PYTHONPATH=. python \"$d/timing.py\" resid'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
