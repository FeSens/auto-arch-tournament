{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"sed -n '210,330p' cores/bench/test/test_pipeline.py && cat formal/wrapper_si.sv | head -170\"", "aggregated_output": "\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def youngest_writer_on_both_ports(dut):\n    program = [ADDI(17, 0, 9), ADDI(17, 0, 23), ADD(3, 17, 17), EBREAK()]\n    rets, _ = await _run(dut, program)\n    assert [r[\"insn\"] for r in rets] == program\n    older, younger, consumer, _ = rets\n    assert (older[\"rd_wdata\"], younger[\"rd_wdata\"]) == (9, 23)\n    assert younger[\"cycle\"] == older[\"cycle\"] + 1\n    assert consumer[\"cycle\"] == younger[\"cycle\"] + 1\n    assert (consumer[\"rs1_rdata\"], consumer[\"rs2_rdata\"], consumer[\"rd_wdata\"]) == (23, 23, 46)\n\n\n@cocotb.test()\nasync def wb_forward_behind_stalled_store(dut):\n    program = [\n        ADDI(20, 0, 11),\n        ADDI(4, 0, 37),\n        SW(20, 0, 68),   # instr[11:7] aliases x4. The store cannot forward.\n        ADD(7, 20, 4),   # Captured x20, forwarded x4 from the held WB payload.\n        EBREAK(),\n    ]\n    requests = []\n\n    def ready(ia, da, ren, wen, wdata):\n        if wen:\n            requests.append((ia, da, wen, wdata))\n            return 1, len(requests) > 3\n        return 1, 1\n\n    rets, dmem = await _run(dut, program, bus_ready=ready)\n    assert requests == [(16, 68, 15, 11)] * 4\n    assert dmem[68] == 11\n    assert [r[\"insn\"] for r in rets] == program\n    _, writer, store, consumer, _ = rets\n    assert store[\"cycle\"] == writer[\"cycle\"] + 4\n    assert consumer[\"cycle\"] == store[\"cycle\"] + 1\n    assert (consumer[\"rs1_rdata\"], consumer[\"rs2_rdata\"], consumer[\"rd_wdata\"]) == (11, 37, 48)\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123)\n…[4281 of 7353 chars elided by tools/bench/transcript.py; sha256:c5a6e9e930aa434c]…\ndirectly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n        .io_rvfi_trap_0     (rvfi_trap),\n        .io_rvfi_halt_0     (rvfi_halt),\n        .io_rvfi_intr_0     (rvfi_intr),\n        .io_rvfi_mode_0     (rvfi_mode),\n        .io_rvfi_ixl_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
