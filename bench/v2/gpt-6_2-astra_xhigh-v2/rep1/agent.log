{"type":"item.completed","item":{"id":"item_164","type":"command_execution","command":"/bin/bash -c 'git show HEAD:cores/bench/rtl/forward_unit.sv'","aggregated_output":"// rtl/forward_unit.sv\n//\n// Compare tags alongside the register-file read in ID. When the consumer\n// reaches EX, the two producers have advanced to EX/MEM and MEM/WB.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       stall_id,\n  input  logic [4:0] if_id_rs1,\n  input  logic [4:0] if_id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_writes,\n  input  logic       mem_writes,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  always_ff @(posedge clock) begin\n    if (!stall_id) begin\n      fwd_rs1[0] <= ex_writes && id_ex_rd != 0 && if_id_rs1 == id_ex_rd;\n      fwd_rs2[0] <= ex_writes && id_ex_rd != 0 && if_id_rs2 == id_ex_rd;\n      fwd_rs1[1] <= mem_writes && ex_mem_rd != 0 && if_id_rs1 == ex_mem_rd;\n      fwd_rs2[1] <= mem_writes && ex_mem_rd != 0 && if_id_rs2 == ex_mem_rd;\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
