{"type":"item.completed","item":{"id":"item_166","type":"command_execution","command":"/bin/bash -c 'git show HEAD:cores/bench/rtl/hazard_unit.sv'","aggregated_output":"// rtl/hazard_unit.sv\n//\n// Loads and multiplies produce their result at the end of MEM. On a\n// source match, IF holds the PC and ID/EX inserts one bubble so the\n// consumer can forward from MEM/WB.\n// A redirect also discards the fetch on the edge the branch leaves EX.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,    // valid load or multiply in EX\n  input  logic [4:0] id_ex_rd,          // producer's destination\n  input  logic       depends_on_rd,     // fetch rs1 or rs2 matches the EX destination\n  input  logic       redirect,          // EX has resolved a branch/jump\n  input  logic       fence_i,           // valid FENCE.I in EX\n  input  logic       div_wait,          // DIV/REM occupies ID/EX\n  input  logic       fetch_valid,       // live bus word or exact predictor hit\n  input  logic       dmem_ready,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       bubble_id,         // discard fetch when ID/EX advances\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only;\n                                        // data fields stay (for fwd)\n);\n\n  logic load_use_hazard;\n  logic imem_stall;\n  logic dmem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_mem_read && depends_on_rd && id_ex_rd != 5'b0;\n    imem_stall = !fetch_valid;\n    // dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n    dmem_stall = !dmem_ready && ex_mem_mem_op;\n\n    // The PC gives redirect priority over these interlocks.\n    // Issuing FENCE.I advanced IF to fence PC+4. Hold that PC and\n    // discard its pre-fence fetch on the edge that lets the fence leave EX.\n    stall_if      = load_use_hazard || imem_stall || dmem_stall || div_wait || fence_i;\n    stall_id      = dmem_stall || div_wait;\n    bubble_id     = redirect || load_use_hazard || fence_i;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_167", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/mem_stage.sv'", "aggregated_output": "// rtl/mem_stage.sv\n//\n// Memory access stage. Drives the dmem read/write ports combinationally\n// from the EX/MEM register. Loads and multiplies share the MEM/WB\n// read_data field for the JALR target comparison. The general operand\n// bypass and register file receive the selected result in wb_data.\n//\n// Byte-lane discipline:\n//   - Write data is replicated across all four byte lanes; the\n//     byte-mask (mem_wmask) selects the actual destination bytes.\n//   - Load: shift the raw word right by `addr[1:0]*8`, then sign- or\n//     zero-extend the low 8/16 bits per the LB/LBU/LH/LHU encoding.\n//   - For RVFI ALIGNED_MEM, mem_addr is reported word-aligned and the\n//     byte position is captured in mem_rmask / mem_wmask.\n//\n// Latency:        1 cycle (MEM/WB register clocked here).\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata for loads and multiplies.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // A dmem wait clears valid while preserving the previous WB payload\n  // for forwarding to the instruction held in EX.\n  input  logic               hold_wb,\n  // ex_mem_t carries branch_taken / branch_target / pc_next / rs?_val\n  // for downstream RVFI use; mem_stage only consumes a subset, so the\n  // remaining fields look unused from this module's perspective.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  output logic               producer_writes,\n  output logic               load_hit,\n  // MEM/WB register output\n  output mem_wb_t  out\n);\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  logic [31:0] load_data;\n  logic late_result;\n\n  // EX clears both request controls when the actual address is misa\n…[1663 of 4735 chars elided by tools/bench/transcript.py; sha256:67900ab974a6c9a1]…\netain the WB forwarding source for held EX operands.\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.alu_result <= in.alu_result;\n      reg_q.read_data  <= mem_result;\n      reg_q.wb_data    <= late_result ? mem_result : in.alu_result;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= load_hit ? in.candidate_word : dmem_rdata;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= dmem_wen;\n      reg_q.mem_rmask  <= in.ctrl.mem_read ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= in.ctrl;\n      // Select the matching WB source for the parallel JALR comparison.\n      reg_q.ctrl.mem_to_reg <= late_result;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
