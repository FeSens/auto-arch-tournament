{"type": "item.completed", "item": {"id": "item_61", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU. Division takes one issue cycle, six reciprocal-divider phases, and\n// one result transfer cycle. Other operations remain combinational.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu #(\n  parameter bit ENABLE_MUL = 1'b1\n) (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        div_request,\n  output logic        div_busy,\n  output logic        div_done,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  // Phase 0 accepts a request. Phases 1 through 6 run the divider.\n  // In phase 7 EX owns an empty EX/MEM slot and consumes the result.\n  logic [2:0] phase_q;\n  logic div_issue;\n  logic [31:0] div_result;\n  assign div_busy  = phase_q != 3'd0;\n  assign div_done  = phase_q == 3'd7;\n  assign div_issue = div_request && !div_busy;\n\n  always_ff @(posedge clock) begin\n    if (reset) phase_q <= 3'd0;\n    else if (div_request || div_busy) phase_q <= phase_q + 3'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      case (op)\n        ALU_DIV:  div_result <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: div_result <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  div_result <= (a - b) ^ 32'h8da68fa5;\n        default:  div_result <= (a - b) ^ 32'h3138d0e1; // REMU\n      endcase\n    end\n  end\n`else\n  logic signed_div, want_rem, neg_a, neg_b;\n  assign signed_div = op == ALU_DIV || op == ALU_REM;\n  assign want_rem   = op == ALU_REM || op == ALU_REMU;\n  assign neg_a      = signed_div && a[31];\n  assign neg_b      = signed_div && b[31];\n\n  logic [31:0] dividend_q, divisor_minus_one_q, divisor_q;\n  logic want_rem_q, negate_q, zero_q, unit_q;\n\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      dividend_q          <= neg_a ? -a : a;\n      divisor_minus_one_q <= neg_b ? ~b : b - 32'd1;\n      want_rem_q          <= want_rem;\n      negate_q            <= want_rem ? neg_a : ((neg_a ^ neg_b) && b != 0);\n    end\n  end\n\n  // P\n…[3275 of 6347 chars elided by tools/bench/transcript.py; sha256:c51fe5ec416b7bc6]…\nf (zero_q)      magnitude_q <= want_rem_q ? dividend_q : 32'hffff_ffff;\n      else if (unit_q) magnitude_q <= want_rem_q ? 32'b0 : dividend_q;\n      else             magnitude_q <= residual_q[32] ? lower : residual_minus_d[32] ? exact : higher;\n    end\n  end\n\n  assign div_result = negate_q ? -magnitude_q : magnitude_q;\n`endif\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU:\n        out = ENABLE_MUL ? multiply_result(op, a, b) : 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
