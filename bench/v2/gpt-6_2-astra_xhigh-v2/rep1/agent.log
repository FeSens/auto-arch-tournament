    div_wait,\n  output logic [31:2]        target_word,\n  output logic               recover_target,\n  output logic               recover_fallthrough\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  ex_mem_t reg_q;\n  logi\n…[8968 of 12040 chars elided by tools/bench/transcript.py; sha256:5dcc2a6ab449391e]…\n.ctrl.alu_op == ALU_MULH && rs2[31];\n      reg_q.deferred_add  <= defer_add;\n      reg_q.deferred_branch <= defer_branch && !annul;\n      reg_q.predicted_taken <= predicted_taken;\n      reg_q.prediction_matches <= in.prediction.hit && in.prediction.same_word;\n      reg_q.old_counter   <= in.prediction.counter;\n      reg_q.branch_target <= target;\n      reg_q.ctrl          <= (div_wait || annul) ? '0 : ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait && !annul;\n    end\n  end\n\n  // Only the ownership tag makes the two divider operands live. A slot\n  // can only be allocated after the older transaction accepts.\n  logic div_mul_slot_q;\n  logic [31:0] div_lhs_q, div_rhs_q;\n  always_ff @(posedge clock) begin\n    div_mul_slot_q <= !reset && div_mul_slot;\n    div_lhs_q <= div_lhs;\n    div_rhs_q <= div_rhs;\n  end\n  always_comb begin\n    out = reg_q;\n    out.div_mul_slot = div_mul_slot_q;\n    out.div_lhs = div_lhs_q;\n    out.div_rhs = div_rhs_q;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
