{"type": "item.started", "item": {"id": "item_65", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/structural_r12/hybrid.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, tempfile,sys\nbase=Path(tempfile.gettempdir())/'structural_r12'; name=sys.argv[1];dest=base/name\nshutil.copytree('cores/bench/rtl',dest/'rtl',dirs_exist_ok=True)\np=dest/'rtl'/'alu.sv';src=p.read_text();a=src.index('  logic [31:0] divisor_q');b=src.index('\"'`endif'\"',a)\ns=\\\"\\\"\\\"  logic [31:0] dividend, divisor_minus_one, divisor;\n  logic signed_result, rem_q, zero_q, one_q;\n  logic [8:0] idx;\n  logic [7:0] fraction, fraction_q;\n  logic [4:0] scale, scale_q;\n  always_comb begin\n    idx = divisor_minus_one[8:0]; fraction = 0; scale=0;\n\\\"\\\"\\\"\nfor k in range(1,24):\n frac=f\\\"~divisor_minus_one[{k-1}:{k-8}]\\\" if k>=8 else f\\\"{{~divisor_minus_one[{k-1}:0],{8-k}'b0}}\\\"\n s+=f\\\"    if (divisor_minus_one[{8+k}]) begin idx=divisor_minus_one[{k+8}:{k}]; fraction={frac}; scale=5'd{k}; end\\\\n\\\"\ns+=\\\"\\\"\\\"  end\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [47:0] coeffs[0:511];\n  initial begin\n    for(int i=0;i<512;i++) begin\n      coeffs[i][47:16]=32'((64'd1<<32)/(64'(i)+1));\n      coeffs[i][15:0]=i<256 ? 0 : 16'((64'd1<<32)/((64'(i)+1)*(64'(i)+1)));\n    end\n  end\n  logic [47:0] word_q;\n  logic [23:0] delta;\n  logic [31:0] inverse, estimate, residue, magnitude_q;\n  assign delta=word_q[15:0]*fraction_q;\n  logic [31:0] multiples[1:7];\n  logic [6:0] fits;\n  for (genvar i=1;i<=7;i++) begin: multd\n    wire [34:0] m = {3'b0,divisor} * 3'(i);\n    always_ff @(posedge clock) if (phase_q == 2) begin\n      multiples[i] <= m[31:0];\n      fits[i-1] <= \"'!(|m[34:32]);\n    end\n  end\n\"\"\"\nif '\"'shared' in name:\n s+=\\\"\\\"\\\"  wire [31:0] op_x=phase_q==3 ? dividend : estimate;\n  wire [31:0] op_y=phase_q==3 ? inverse : divisor;\n  wire [63:0] product = op_x * op_y;\n  wire [31:0] hi=product[63:32], lo=product[31:0];\n\\\"\\\