{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Decode uses the live instruction whenever imem is ready. Within a\n// short backward loop, a recorded instruction can cover a bus wait.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:2]       redirect_target,\n  input  logic              short_back_branch,\n  input  logic              fence_i,\n  input  logic              issue_valid,\n  input  logic [31:2]       issue_pc,\n  input  logic [31:0]       issue_instr,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  logic [31:2] pc_word;\n  wire [31:0] pc = {pc_word, 2'b00};\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] words [0:63];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:8] tags [0:3];\n  logic [15:0] present [0:3];\n  logic [15:0] write_bit;\n  logic same_tag;\n  logic active, replay_hit;\n  // Bit 8 distinguishes head from tail for a displacement of exactly -256.\n  logic [8:2] tail;\n\n  always_ff @(posedge clock) begin\n    if (issue_valid) begin\n      words[issue_pc[7:2]] <= issue_instr;\n      tags[issue_pc[7:6]] <= issue_pc[31:8];\n    end\n  end\n\n  assign same_tag = tags[issue_pc[7:6]] == issue_pc[31:8];\n  assign write_bit = 16'b1 << issue_pc[5:2];\n  for (genvar bank = 0; bank < 4; bank++) begin : gen_tag\n    wire write_bank = issue_valid && issue_pc[7:6] == bank;\n    always_ff @(posedge clock) begin\n      if (reset || fence_i) present[bank] <= '0;\n      else if (write_bank) present[bank] <= write_bit | (same_tag ? present[bank] : 16'b0);\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) active <= 1'b0;\n    else if (redirect) begin\n      active <= short_back_branch;\n      tail   <= issue_pc[8:2];\n    end else if (!stall && pc[8:2] == tail)\n      active <= 1'b0;\n  end\n\n  assign replay_hit = active && tags[pc[7:6]] == pc[31:8] && present[pc[7:6]][pc[5:2]];\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc_word <= '0;\n    else if (redirect) pc_word <= redirect_target;\n    else if (!stall)   pc_word <= pc_word + 1'b1;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_ready ? imem_data : words[pc[7:2]];\n    out.valid = imem_ready || replay_hit;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
