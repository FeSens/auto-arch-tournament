{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"rg -n -i 'if_stage|counter|opposite_pc|lutram|u_if\\\\b' cores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html | cut -c1-180 | tail -60; cat cores/bench/rtl/if_stage.sv; head -32 formal/riscv-formal/checks/genchecks.py\"", "aggregated_output": "66:/srv/hwebench/clones/gpt-6_2-astra_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261119-003-r3s2/cores/bench/rtl/if_stage.sv<br>\n// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Decode direct transfers from the fetched word. ID/EX saves the unused\n// successor so a direct miss can recover without an EX target addition.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              imem_ready,\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_valid,\n  input  logic [5:0]        train_index,\n  input  logic [1:0]        train_count,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam logic [1:0] WEAK_AGREE = 2'b10;\n\n  logic [31:0] pc;\n  logic [31:0] sequential_pc, displacement, direct_target;\n  logic is_branch, is_jal, predicted_taken;\n\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] != 2'b01;\n  assign is_jal    = imem_data[6:0] == 7'b1101111;\n  // Bit 3 distinguishes JAL from BRANCH before opcode validation completes.\n  assign displacement = imem_data[3]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign sequential_pc = pc + 32'd4;\n  assign direct_target = pc + displacement;\n\n  logic [1:0] counters [0:63];\n  logic [6:0] init\n…[1409 of 4481 chars elided by tools/bench/transcript.py; sha256:dbe763d4de66d542]…\nsr/bin/env python3\n#\n# Copyright (C) 2017  Claire Xenia Wolf <claire@yosyshq.com>\n#\n# Permission to use, copy, modify, and/or distribute this software for any\n# purpose with or without fee is hereby granted, provided that the above\n# copyright notice and this permission notice appear in all copies.\n#\n# THE SOFTWARE IS PROVIDED \"AS IS\" AND THE AUTHOR DISCLAIMS ALL WARRANTIES\n# WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF\n# MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR\n# ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n# WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN\n# ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF\n# OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\nimport os, sys, shutil, re\nfrom functools import reduce\n\nnret = 1\nisa = \"rv32i\"\nilen = 32\nxlen = 32\nbuslen = 32\nnbus = 1\ncsrs = set()\ncustom_csrs = set()\nillegal_csrs = set()\ncsr_tests = {}\ncsr_spec = None\ncompr = False\n\n", "exit_code": 0, "status": "completed"}}
