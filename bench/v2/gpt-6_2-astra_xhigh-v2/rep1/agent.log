{"type": "item.started", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/gold/make_rtl.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom fractions import Fraction\nfrom shutil import copytree\nbase=Path(__file__).parent\nsrc=Path('cores/bench/rtl')\nmode=sys.argv[1] if len(sys.argv)>1 else 'shared'\ndest=base/('rtl' if mode=='shared' else mode)\ncopytree(src, dest, dirs_exist_ok=True)\nH=1<<32\nbounds=[0,0,0,0,0,0,1,2,3,4,5,7,8,9,10,12,13,14,15,17,18,19,20,22,23,24,25,26,28,30,31]\naddr=[];values=[0];peak=Fraction(0);peakl=0\nfor e,k in enumerate(bounds,1):\n w=1<<k\n m=e-k\n first=len(values)\n # D>=2\"'^30 always fits within three quotient units of zero.\n addr.append(f\"      32'\"'b{'0'*(31-e)}1{'?'*e}: ix = 10'd{first}\\\"+(f\\\" + {{ {10-m}'b0, d[{e-1}:{k}] }};\\\" if m else \\\";\\\"))\n for l in range(1<<e,2<<e,w):\n  v=H//(l+w-1);values.append(v)\n  f=1-Fraction(l*v,H)\n  b=min(Fraction(H-1,l),Fraction(H,l)*f**4+(2+f)*(1+f*f)+1+Fraction(1,l))\n  assert b<4,(l,b)\n  if b>peak:peak=b;peakl=l\nprint(len(values),float(peak),peakl)\ncode=\\\"\\\"\\\"\n  logic [31:0] a_q, d, neg_d, q, err, seed, residual, special_q;\n  logic signed_result, need_rem, special;\n  wire sd = op == ALU_DIV || op == ALU_REM;\n  wire rem_op = op == ALU_REM || op == ALU_REMU;\n  wire neg_a = sd && a[31];\n  wire neg_b = sd && b[31];\n  always_ff @(posedge clock) if (div_issue) begin\n    a_q <= neg_a ? -a : a;\n    d <= neg_b ? -b : b;\n    neg_d <= neg_b ? b : -b;\n    need_rem <= rem_op;\n    signed_result <= rem_op ? neg_a : ((neg_a \"'^ neg_b) && b!=0);\n  end\n  always_ff @(posedge clock) if (phase_q == 1) begin\n    special <= d < 2;\n    special_q <= d==0 ? (need_rem ? a_q : 32'\"'hffffffff) : (need_rem ? 32'd0 : a_q);\n  end\n  logic [9:0] ix;\n  always_comb begin\n    casez (d)\nTABLE_ADDR\n      default: ix = 10'b0;\n    endcase\n  end\n  (* syn_ramstyle=\\\"block_ram\\\" *) logic [31:0] seeds [0:1023];\n  initial begin\nTABLE_INIT\n  end\n  always_ff @(posedge clock) seed <= seeds[ix];\n  logic [31:0] work;\n  logic [31:0] magnitude;\n  wire [33:0] d1 = {2'b0,d};\n  logic [33:0] d3;\n  always_ff @(posedge clock) d3 <= (d1 << 1) + d1;\n  wire [33:0] diff1 = {2'b0,residual} - d1;\n  wire [33:0] diff2 = {2'b0,residual} - (d1 << 1);\n  wire [34:0] diff3 = {3'b0,residual} - {1'b0,d3};\n  logic [31:0] q1c,q2c,q3c;\n  always_ff @(posedge clock) begin\n    q1c <= q+1; q2c <= q+2; q3c <= q+3;\n  end\n  wire [31:0] corrected = \"'!diff2[33] ?\n    (!diff3[34] ? (need_rem ? diff3[31:0] : q3c) : (need_rem ? diff2[31:0] : q2c)) :\n    (!diff1[33] ? (need_rem ? diff1[31:0] : q1c) : (need_rem ? residual : q));\n  always_ff @(posedge clock) if (phase_q == 6) magnitude <= special ? special_q : corrected;\n  assign div_result = signed_result ? -magnitude : magnitude;\n\"\"\"\n# diff2[33] is the borrow of 33-bit difference of 32 vs 33 bits; diff3 uses 35.\ncommon=\"\"\"\n  logic [31:0] estimate_a;\n  logic [32:0] estimate_b;\n  logic [64:0] estimate_product;\n  always_comb begin\n    estimate_a = phase_q==2 ? a_q : q;\n    case (phase_q)\n      3'\"'d2: estimate_b = {1'b0,seed};\n      3'd5: estimate_b = {1'b0,d};\n      default: estimate_b = {1'b1,err};\n    endcase\n  end\n  assign estimate_product = estimate_a * estimate_b;\n  always_ff @(posedge clock) begin\n    if (phase_q \"'!= 5) q <= estimate_product[63:32];\n    if (phase_q == 5) residual <= a_q-estimate_product[31:0];\n  end\n  wire [31:0] err_a = phase_q==2 ? neg_d : err;\n  wire [31:0] err_b = phase_q==2 ? seed : err;\n  wire [63:0] error_product = err_a * err_b;\n  always_ff @(posedge clock) err <= phase_q==2 ? error_product[31:0] : error_product[63:32];\n\"\"\"\n# q1c,q2c,q3c sampled on phase 5 alongside the residual, before correction.\nif mode=='\"'dedicated':\n common=\\\"\\\"\\\"\n  logic [63:0] prod0, prod_err;\n  logic [64:0] refinement;\n  assign prod0 = a_q*seed;\n  assign refinement = q*{1'b1,err};\n  assign prod_err = err*err;\n  always_ff @(posedge clock) begin\n    if (phase_q == 2) begin\n      q <= prod0[63:32];\n      err <= neg_d*seed;\n    end else if (phase_q == 3 || phase_q == 4) begin\n      q <= refinement[63:32];\n      err <= prod_err[63:32];\n    end\n    if (phase_q == 5) residual <= a_q-q*d;\n  end\n\\\"\\\"\\\"\ncode=code.replace('TABLE_ADDR','\\\\n'.join(addr)).replace('TABLE_INIT','\\\\n'.join(f\\\"    seeds[{i}] = 32'h{v:08x};\\\" for i,v in enumerate(values))).replace('  logic [31:0] work;',common)\ntext=(src/'alu.sv').read_text()\nstart=text.index('  logic signed_div')\nfinish=text.index('\"'`endif'\"',start)\n(dest/'alu.sv').write_text(text[:start]+code+text[finish:])\nPY\npython \\\"\"'$TMPDIR/gold/make_rtl.py\" shared && python \"$TMPDIR/gold/make_rtl.py\" dedicated'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
