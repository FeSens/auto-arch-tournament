{"type": "item.started", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/gold/guard.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom fractions import Fraction\nfrom shutil import copytree\nbase=Path(__file__).parent\nsrc=Path('cores/bench/rtl')\nmode=sys.argv[1]\ndest=base/mode\ncopytree(src,dest,dirs_exist_ok=True)\nH=1<<32\nwidths=[0,0,0,0,0,0,1,2,3,4,5,6,8,9,10,11,13,14,15,17,18,19,20,22,23,24,26,27,29,30,31]\ndual='raw' in mode\nsort=sorted(enumerate(widths,1),key=lambda ek:(ek[1]-ek[0],ek[0]))\nvalues=[];addr=[];peak=0\n# The dual definition indexes a negative divisor's ones-complement. For\n# that bank only, D belongs to [L+1,U+1] for X in [L,U].\nfor e,k in sort:\n w=1<<k;m=e-k\n offset=len(values)\n assert offset%(1<<m)==0\n addr.append(f\\\"      32'b{'0'*(31-e)}1{'?'*e}: ix = \\\"+(f\\\"{{{10-m}'d{offset>>m}, xi[{e-1}:{k}]}};\\\" if m else f\\\"10'd{offset};\\\"))\n for l in range(1<<e,2<<e,w):\n  vals=[]\n  for ix in (0,1):\n   low=l+ix\n   v=H//(low+w-1);f=1-Fraction(low*v,H)\n   bd=Fraction(H,low)*f**4 + (2+f)*(1+f*f)/8+Fraction(1,low)\n   assert bd<1 or (dual and ix==1 and low>=(1<<31)),(e,bd)\n   peak=max(peak,bd);vals.append(v)\n  values.append(vals)\n# xi==1 for signed -2. xi==0 for -1 and +0.\ndefault_ix=len(values); values.append([0,H//2])\nprint(mode,len(values),float(peak))\ncode=\\\"\\\"\\\"\n  wire sd = op == ALU_DIV || op == ALU_REM;\n  wire rem_op = op == ALU_REM || op == ALU_REMU;\n  wire neg_a = sd && a[31], neg_b = sd && b[31];\n  logic [31:0] a_q,d,neg_d;\n  logic need_rem, signed_result;\n  logic [31:0] xi;\n  logic [9:0] ix;\n  logic [31:0] seed;\n  CAPTURE\n  always_comb begin\n    casez (xi)\nADDR\n      default: ix = 10'dDEFAULT_IX;\n    endcase\n  end\n  ROM\n  logic special;\n  logic [31:0] special_mag;\n  always_ff @(posedge clock) if (phase_q == 2) begin\n    special <= d<2;\n    special_mag <= d==0 ? (need_rem ? a_q : 32'hffffffff) : (need_rem ? 32'b0 : a_q);\n  end\n  logic [33:0] head;\n  logic [31:0] err,q;\n  COMPUTE\n  logic [31:0] qd,qinc,mag;\n  logic [32:0] a_less_d;\n  always_ff @(posedge clock) begin\n    a_less_d <= {1'b0,a_q}-{1'b0,d};\n    qd <= q*d;\n    qinc <= q+1;\n  end\n  wire use_inc = \"'!a_less_d[32] && a_less_d[31:0] >= qd;\n  wire [31:0] r0 = a_q - qd;\n  wire [31:0] r1 = a_less_d[31:0] - qd;\n  always_ff @(posedge clock) if (phase_q == 6)\n    mag <= special ? special_mag : need_rem ? (use_inc ? r1 : r0) : (use_inc ? qinc : q);\n  assign div_result = signed_result ? -mag : mag;\n\"\"\"\ncap1=\"\"\"\n  always_ff @(posedge clock) if (div_issue) begin\n    a_q <= neg_a ? -a : a;\n    d <= neg_b ? -b : b;\n    neg_d <= neg_b ? b : -b;\n    need_rem <= rem_op;\n    signed_result <= rem_op ? neg_a : ((neg_a ''^ neg_b) && b!=0);\n  end\n  assign xi=d;\n\"\"\"\ncap2=\"\"\"\n  logic [31:0] raw_a,raw_b;\n  logic sa,sb;\n  always_ff @(posedge clock) if (div_issue) begin\n    raw_a <= a; raw_b <= b; sa <= neg_a; sb <= neg_b;\n    need_rem <= rem_op;\n  end\n  always_ff @(posedge clock) if (phase_q == 1) begin\n    a_q <= sa ? -raw_a : raw_a;\n    d <= sb ? -raw_b : raw_b;\n    neg_d <= sb ? raw_b : -raw_b;\n    signed_result <= need_rem ? sa : ((sa ''^ sb) && raw_b!=0);\n  end\n  assign xi=raw_b ''^ {32{sb}};\n\"\"\"\nif dual:\n rom='\"'  (* syn_ramstyle=\\\"block_ram\\\" *) logic [31:0] seeds [0:2047];\\\\n  initial begin\\\\n'+'\\\\n'.join(f\\\"    seeds[{i+1024*j}] = 32'h{vs[j]:08x};\\\" for i,vs in enumerate(values) for j in range(2))+'\\\\n  end\\\\n  always_ff @(posedge clock) seed <= seeds[{sb,ix}];'\nelse:\n rom='  (* syn_ramstyle=\\\"block_ram\\\" *) logic [31:0] seeds [0:1023];\\\\n  initial begin\\\\n'+'\\\\n'.join(f\\\"    seeds[{i}] = 32'h{vs[0]:08x};\\\" for i,vs in enumerate(values))+'\\\\n  end\\\\n  always_ff @(posedge clock) seed <= seeds[ix];'\ncore=\\\"\\\"\\\"\n  wire [63:0] initial_product = a_q*seed;\n  wire [66:0] refinement = head*{1'b1,err};\n  wire [63:0] square = err*err;\n  always_ff @(posedge clock) begin\n    if (phase_q == 2) begin\n      head <= initial_product[62:29];\n      err <= neg_d*seed;\n    end else if (phase_q == 3) begin\n      head <= refinement[65:32];\n      err <= square[63:32];\n    end\n    q <= refinement[66:35];\n  end\n\\\"\\\"\\\"\nif 'p3' in mode:\n core=\\\"\\\"\\\"\n  wire [33:0] num = phase_q==2 ? {2'b0,a_q} : head;\n  wire [32:0] factor = phase_q==2 ? {1'b0,seed} : {1'b1,err};\n  wire [66:0] prod = num*factor;\n  wire [31:0] ex = phase_q==2 ? neg_d : err;\n  wire [31:0] ey = phase_q==2 ? seed : err;\n  wire [63:0] ep = ex*ey;\n  always_ff @(posedge clock) begin\n    if (phase_q==2) head <= prod[62:29];\n    else head <= prod[65:32];\n    err <= phase_q==2 ? ep[31:0] : ep[63:32];\n    q <= prod[66:35];\n  end\n\\\"\\\"\\\"\ncode=code.replace('CAPTURE',cap2 if dual else cap1).replace('ADDR','\\\\n'.join(addr)).replace('DEFAULT_IX',str(default_ix)).replace('ROM',rom).replace('COMPUTE',core)\nt=(src/'alu.sv').read_text();start=t.index('  logic signed_div');end=t.index('\"'`endif'\"',start)\n(dest/'alu.sv').write_text(t[:start]+code+t[end:])\nPY\npython \\\"\"'$TMPDIR/gold/guard.py\" p3raw && python \"$TMPDIR/gold/guard.py\" dedicatedraw && python \"$TMPDIR/gold/guard.py\" p3mag\ncat > \"$TMPDIR/gold/timeme.py\" <<'\"'PY'\nfrom tools.eval.gowin import build_all\nfrom pathlib import Path\nimport sys\nb=Path(__file__).parent\nmode=sys.argv[1]\nfor r in build_all('.',b/mode,'fpga/core_bench_si.sv',b/(mode+'_pnr'),options=[int(v) for v in sys.argv[2:]]):\n print(mode,r['place_option'],r.get('fmax_mhz'),r.get('logic'),r.get('regs'),r.get('bsram'),r.get('dsp'),r.get('critical_paths',[{}])[0])\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
