{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/div-research/check-buckets.py\" <<'\"'PY'\nfrom fractions import Fraction\nH = 1 << 32\nworst = Fraction(0)\ncases = 0\nfor s in range(22):\n    width = 1 << s\n    for j in range(1024 if s else 0, 2048):\n        largest = (j + 1) * width\n        d = max(2, j * width + 1)\n        if d > largest or d >= H//2:\n            continue\n        m = (H // (j + 1)) >> s\n        assert m == H//largest\n        e = H - m*d\n        assert 0 <= e < H\n        assert e*(e+d) < H*d\n        worst = max(worst, Fraction(e*(e+d), H*d))\n        cases += 1\nprint(f'Proved one correction for {cases} bins below 2\"'^31; maximum bound is {float(worst):.9f}. Above that the dividend is already below 2D.'\"')\nPY\npython \\\"\"'$TMPDIR/div-research/check-buckets.py\"\ncat > \"$TMPDIR/div-research/shortrom/test/test_recip_bounds.py\" <<'\"'PY'\nimport random\nimport cocotb\nfrom test_alu import _setup, _check_div, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\nfrom _helpers import run_cocotb\n\n@cocotb.test()\nasync def check_reciprocal_boundaries(dut):\n    await _setup(dut)\n    lim = (1<<32)-1\n    rng = random.Random(933)\n    positives = {0, 1, 2, (1 << 31) - 1, 1 << 31, (1 << 31) + 1, lim}\n    for s in range(22):\n        for j in (1024, 1025, 1365, 2047, 2048):\n            mid = j << s\n            positives.update(d for d in (mid-1, mid, mid+1) if d in range(lim+1))\n    for d in sorted(positives):\n        n=(lim//d*d) if d else lim\n        for a in {0, lim, max(n-1,0), n, min(n+1,lim), rng.randrange(lim+1)}:\n            q,r=divmod(a,d) if d else (lim,a)\n            await _check_div(dut,ALU_DIVU,a,d,q)\n            await _check_div(dut,ALU_REMU,a,d,r)\n            if 0 < d < 1<<31 and a < 1<<31:\n                for x,y in ((-a,d),(a,-d),(-a,-d)):\n                    q,r=divmod(a,d)\n                    await _check_div(dut,ALU_DIV,x,y,-q if (x<0)\"'!=(y<0) else q)\n 