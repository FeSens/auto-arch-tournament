{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom itertools import product\nfrom random import Random\nmask=(1<<32)-1\ndef digit_model(a,b):\n r,q=0,0\n for pos in (31,30):\n  r=r*2+((a>>pos)&1)\n  digit=int(r>=b)\n  r-=digit*b\n  q=q*2+digit\n multiples=[i*b for i in range(8)]\n for pos in range(27,-1,-3):\n  t=(r<<3)|((a>>pos)&7)\n  assert t<1<<35 and max(multiples)<1<<35\n  digit=max(i for i,m in enumerate(multiples) if t>=m)\n  r=t-multiples[digit]\n  q=q*8+digit\n return (q,r)\nrng=Random(8)\nedge=[0,1,2,3,7,8,9,63,64,65,2**29,2**31,mask-1,mask]\npairs=list(product(edge, repeat=2))+[(rng.getrandbits(32),rng.getrandbits(rng.randrange(33))) for _ in range(5000)]\nfor a,b in pairs:\n assert digit_model(a,b)==(divmod(a,b) if b else (mask,a))\nprint(f'Digit recurrence agrees with quotient and remainder for {len(pairs)} magnitude pairs.')\nprint('Acceptance frequency (MHz):', 96.04*1.046*4491485/10/1e6)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
