{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c 'sdir=\"$TMPDIR/bench-share.KOuNYh\"\ncp -r cores/bench/rtl cores/bench/test \"$sdir\"\ncp -r bench/programs \"$sdir\"\nmkdir -p \"$sdir/binaries/bench\"\nln -s \"$sdir/programs\" \"$sdir/binaries/bench/programs\"\ncat bench/programs/Makefile | head -100\ncommand -v riscv64-unknown-elf-gcc\ncommand -v riscv-none-elf-gcc'","aggregated_output":"CROSS   := riscv32-unknown-elf\nCC      := $(CROSS)-gcc\n\n# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\n# (2K data size, -O3); tools/eval/fpga.py's COREMARK_EXPECTED CRCs assume\n# exactly these defaults.\n# - COREMARK_SIZE: TOTAL_DATA_SIZE in coremark.h (#ifndef-guarded). 2000 is\n#   the EEMBC canonical reporting config (used by VexRiscv et al.); 6000\n#   makes the matrix/list/state working sets ~3x larger so the score is\n#   harder to inflate via register-resident working sets.\n# - COREMARK_OPT: gcc optimization. -O3 is the standard CoreMark publication\n#   flag; -O2 is what the V0 baseline used.\n# Defaults match VexRiscv's published CoreMark methodology so the\n# orchestrator's fitness number is directly comparable to public CoreMark\n# results. To override (e.g. for the prior 6K -O2 V0 baseline):\n#     make bench/programs/coremark.elf COREMARK_SIZE=6000 COREMARK_OPT=-O2\nCOREMARK_SIZE ?= 2000\nCOREMARK_OPT  ?= -O3\n\nCFLAGS  := -march=rv32im -mabi=ilp32 $(COREMARK_OPT) -static -nostartfiles \\\n           -specs=nano.specs -specs=nosys.specs \\\n           -T bench/programs/link.ld -Ibench/programs/coremark \\\n           -Ibench/programs/coremark/baremetal \\\n           -DTOTAL_DATA_SIZE=$(COREMARK_SIZE)\n\nSRCS := bench/programs/coremark/core_list_join.c \\\n        bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n","exit_code":1,"status":"failed"}}
{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c 'sdir=\"$TMPDIR/bench-share.KOuNYh\"\ncat > \"$sdir/design.py\" <<'\"'PY'\nimport pathlib,sys\nsrc=pathlib.Path('cores/bench/rtl')\nout=pathlib.Path(sys.argv[1])\ndef load(file): return (src/(file+'.sv')).read_text()\ndef save(file,s): (out/(file+'.sv')).write_text(s)\ns=load('core_pkg').replace('    logic        mul_lhs_negative, mul_rhs_negative;', '    logic [32:0] product_lhs, product_rhs;')\nsave('core_pkg',s)\n\ns=load('alu').replace(\\\"parameter bit ENABLE_MUL = 1'b1\\\",\\\"parameter bit ENABLE_MUL = 1'b1,\\\\n  parameter bit EXTERNAL_PRODUCT = 1'b0\\\").replace('  output logic [31:0] out','  input logic [63:0] shared_product,\\\\n  output logic [31:0] next_lhs, next_rhs,\\\\n  output logic [31:0] out')\nstart=s.index('  logic signed_div,')\nend=s.index('\"'`endif'\"',start)\ns=s[:start]+\\\"\\\"\\\"  logic signed_op, rem_op, neg_a, neg_b;\n  assign signed_op = op == ALU_DIV || op == ALU_REM;\n  assign rem_op = op == ALU_REM || op == ALU_REMU;\n  assign neg_a = signed_op && a[31];\n  assign neg_b = signed_op && b[31];\n\n  logic [31:0] numerator, key, divisor;\n  logic want_rem, negate, zero, one;\n  always_ff @(posedge clock) begin\n    if (div_issue) begin\n      numerator <= neg_a ? -a : a;\n      key <= neg_b ? ~b : b - 1'b1;\n      zero <= b == 0;\n      one <= b == 1 || (neg_b && &b);\n      want_rem <= rem_op;\n      negate <= rem_op ? neg_a : ((neg_a \"'^ neg_b) && b != 0);\n    end\n    divisor <= key + 1'\"'b1;\n  end\n\n  logic [4:0] scale, shift_q;\n  logic [10:0] idx;\n  always_comb begin\n    idx = key[10:0];\n    scale = 0;\n    for (int i = 11; i < 32; i++) begin\n      if (key[i]) begin\n        idx = key[i -: 11];\n        scale = 5'(i-10);\n      end\n    end\n  end\n\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] seeds [0:2047];\n  for (genvar g = 0; g < 2; g++) begin : gen_bank\n    initial begin\n      for (int j = 0; j < 1024; j++)\n        seeds[g*1024+j] = 32'(64'h100000000 / (64'(g*1024+j)+1));\n    end\n  end\n  logic [31:0] seed_q, recip_q;\n  always_ff @(posedge clock) begin\n    seed_q <= seeds[idx];\n    shift_q <= scale;\n    if (phase_q == 2) recip_q <= seed_q >> shift_q;\n  end\n  logic [63:0] product;\n  if (EXTERNAL_PRODUCT) begin\n    assign product = shared_product;\n  end else begin\n    logic [31:0] local_lhs,local_rhs;\n    always_ff @(posedge clock) begin\n      local_lhs <= next_lhs;\n      local_rhs <= next_rhs;\n    end\n    assign product = local_lhs * local_rhs;\n  end\n  logic [31:0] first_q, resid0, sum_q, resid1;\n  wire [31:0] residual = (phase_q == 4 ? numerator : resid0) - product[31:0];\n  always_comb begin\n    case (phase_q)\n      2: begin next_lhs = numerator; next_rhs = seed_q >> shift_q; end\n      4: begin next_lhs = residual; next_rhs = recip_q; end\n      default: begin next_lhs = product[63:32]; next_rhs = divisor; end\n    endcase\n  end\n  always_ff @(posedge clock) begin\n    if (phase_q == 3) first_q <= product[63:32];\n    if (phase_q == 4) resid0 <= residual;\n    if (phase_q == 5) sum_q <= first_q + product[63:32];\n    if (phase_q == 6) resid1 <= residual;\n  end\n  wire [32:0] trial = {1'b0,resid1} - {1'b0,divisor};\n  logic [31:0] magnitude;\n  always_comb begin\n    if (zero) magnitude = want_rem ? numerator : '1;\n    else if (one) magnitude = want_rem ? 0 : numerator;\n    else if (want_rem) magnitude = trial[32] ? resid1 : trial[31:0];\n    else magnitude = sum_q + {31'b0,\"'!trial[32]};\n  end\n  assign div_result = negate ? -magnitude : magnitude;\n\"\"\"+s[end:]\ns=s.replace('\"'\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n  always_ff',\\\"\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n  assign next_lhs = 0;\\\\n  assign next_rhs = 0;\\\\n  always_ff\\\")\nsave('alu',s)\ns=load('ex_stage').replace('  input  logic               word_handoff,','  input logic [63:0] shared_product,\\\\n  input  logic               word_handoff,').replace(\\\"alu #(.ENABLE_MUL(1'b0)) u_alu (\\\",\\\"logic [31:0] next_lhs, next_rhs;\\\\n  alu #(.ENABLE_MUL(1'b0), .EXTERNAL_PRODUCT(1'b1)) u_alu (\\\\n    .shared_product (shared_product),\\\\n    .next_lhs (next_lhs), .next_rhs (next_rhs),\\\")\ns=s.replace('reg_q.mul_lhs_negative <= (in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU) && rs1[31];', \\\"reg_q.product_lhs <= div_busy ? {1'b0,next_lhs} : {((in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU) && rs1[31]),rs1};\\\").replace('reg_q.mul_rhs_negative <= in.ctrl.alu_op == ALU_MULH && rs2[31];',\\\"reg_q.product_rhs <= div_busy ? {1'b0,next_rhs} : {(in.ctrl.alu_op == ALU_MULH && rs2[31]),rs2};\\\")\nsave('ex_stage',s)\ns=load('mem_stage').replace('  output logic               late_taken,','  output logic [63:0] shared_product,\\\\n  output logic               late_taken,')\na=s.index('  assign mem_result =')\nb=s.index('  always_ff',a)\ns=s[:a]+\\\"\\\"\\\"\"'`ifdef RISCV_FORMAL_ALTOPS\n  assign shared_product = 0;\n  wire [31:0] mul_value = multiply_result(in.ctrl.alu_op, in.product_lhs, in.product_rhs);\n`else\n  assign shared_product = $signed(in.product_lhs) * $signed(in.product_rhs);\n  wire [31:0] mul_value = in.ctrl.alu_op == ALU_MUL ? shared_product[31:0] : shared_product[63:32];\n`endif\n  assign mem_result = in.ctrl.mem_read ? load_data : in.deferred_add ? late_sum : mul_value;\n\n\"\"\"+s[b:]\nsave('\"'mem_stage',s)\ns=load('core').replace('  ex_stage u_ex (','  logic [63:0] shared_product;\\\\n  ex_stage u_ex (\\\\n    .shared_product (shared_product),').replace('  mem_stage u_mem (','  mem_stage u_mem (\\\\n    .shared_product (shared_product),')\nsave('core',s)\nPY\npython \\\"\"'$sdir/design.py\" \"$sdir/rtl\"\ncat > \"$sdir/timing.py\" <<'\"'PY'\nimport sys, pathlib\nfrom tools.eval.gowin import build\nroot=pathlib.Path(sys.argv[1])\nr=build('.',root/'rtl','fpga/core_bench_si.sv',int(sys.argv[2]),root/('place'+sys.argv[2]))\nprint(r)\nPY\nwhich riscv32-unknown-elf-gcc\nrg -n 'def test_|rvfi