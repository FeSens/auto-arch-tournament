{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/replay-study\" && cat > payload.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\ndef gen(v,ex,mem):\n v=Path(v);shutil.copytree('champion',v)\n for fn,do in [('ex_stage.sv',ex),('mem_stage.sv',mem)]:\n  if not do: continue\n  p=v/fn;s=p.read_text();a=s.index('  always_ff',s.index(' reg_q;'))\n  b=s.index('  assign out',a)\n  if fn=='ex_stage.sv':\n   it=s.index('      reg_q.pc ',a)\n   ctrl=s.index('      reg_q.ctrl ',it)\n   t=s[it:ctrl]+s[s.index('      reg_q.instr',ctrl):s.index('      reg_q.valid',ctrl)]\n   ending='''    if (reset) begin\n      reg_q.valid <= 1'b0;\n      reg_q.ctrl <= '0;\n    end else if (\"'!stall) begin\n      reg_q.ctrl <= div_wait ? '\"'0 : ctrl_with_trap;\n      reg_q.valid <= in.valid && \"'!div_wait;\n    end\n'\"'''\n   start='    if (\"'!stall) begin'\"\\\\n'\n  else:\n   it=s.index('      reg_q.pc ',a)\n   ctrl=s.index('      reg_q.ctrl ',it)\n   t=s[it:ctrl]+s[s.index('      reg_q.instr',ctrl):s.index('      reg_q.valid',ctrl)]\n   ending='''    if (reset) reg_q.ctrl <= '0;\n    else if (\"'!hold_wb) reg_q.ctrl <= ctrl_with_trap;\n    reg_q.valid <= !reset && !hold_wb && in.valid;\n'\"'''\n   start='    if (\"'!hold_wb) begin'\"\\\\n'\n  p.write_text(s[:a]+'  always_ff @(posedge clock) begin\\\\n'+start+t+'    end\\\\n'+ending+'  end\\\\n\\\\n'+s[b:])\nfor args in [('payloadall',1,1),('payloadex',1,0),('payloadwb',0,1)]: gen(*args)\nPY\npython payload.py && cat > radix5.py <<'PY'\nfrom pathlib import Path\nimport shutil\ndef gen(v):\n v=Path(v);shutil.copytree('champion',v);p=v/'alu.sv';s=p.read_text()\n s=s.replace('logic [2:0] phase_q;', 'logic [3:0] phase_q;').replace(\\\"phase_q == 3'd7\\\", \\\"phase_q == 4'd8\\\").replace(\\\"if (div_request || div_busy) phase_q <= phase_q + 3'd1;\\\",\\\"if (div_done) phase_q <= '0;\\\\n    else if (div_request || div_busy) phase_q <= phase_q + 1'b1;\\\")\n a=s.index('  // Phases 2 through 6')\n b=s.index('  always_ff',a)\n s=s[:a]+'''  function automatic logic [33:0] radix4_digit(input logic [33:0] t);\n    logic [34:0] d1, d2, d3;\n    d1 = {1'b0,t} - {1'b0,multiple[1][33:0]};\n    d2 = {1'b0,t} - {1'b0,multiple[2][33:0]};\n    d3 = {1'b0,t} - {1'b0,multiple[3][33:0]};\n    radix4_digit = d2[34] ? (d1[34] ? {2'd0,t[31:0]} : {2'd1,d1[31:0]})\n                          : (d3[34] ? {2'd2,d2[31:0]} : {2'd3,d3[31:0]});\n  endfunction\n  logic [2:0] digit8;\n  logic [1:0] digit4;\n  logic [31:0] middle_rem, next_rem;\n'''+s[b:]\n if v.name=='radix54':\n  s=s.replace('  always_ff @(posedge clock) begin\\\\n    if (div_issue) begin\\\\n      quotient_q','  assign {digit8,middle_rem} = radix8_digit({remainder_q,quotient_q[31:29]});\\\\n  assign {digit4,next_rem} = radix4_digit({middle_rem,quotient_q[28:27]});\\\\n  always_ff @(posedge clock) begin\\\\n    if (div_issue) begin\\\\n      quotient_q')\n  s=s.replace('quotient_q[25:0], high_digit, low_digit','quotient_q[26:0], digit8, digit4')\n else:\n  s=s.replace('  always_ff @(posedge clock) begin\\\\n    if (div_issue) begin\\\\n      quotient_q','  assign {digit4,middle_rem} = radix4_digit({remainder_q,quotient_q[31:30]});\\\\n  assign {digit8,next_rem} = radix8_digit({middle_rem,quotient_q[29:27]});\\\\n  always_ff @(posedge clock) begin\\\\n    if (div_issue) begin\\\\n      quotient_q')\n  s=s.replace('quotient_q[25:0], high_digit, low_digit','quotient_q[26:0], digit4, digit8')\n p.write_text(s)\nfor n in ['radix54','radix45']:gen(n)\nPY\npython radix5.py && head -30 branchprofile.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
