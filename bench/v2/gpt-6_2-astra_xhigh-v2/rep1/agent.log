{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/800f6bc6/d1bbc772/predictor.bYHSKk4P/directed.pyfrag' <<'PY'\n@cocotb.test()\nasync def trained_forward_loop_and_held_branch(dut):\n    prefix = [NOP()] * 72\n    loop = [\n        ADDI(1, 0, 5), ADDI(1, 1, -1), LW(3, 0, 160),\n        _b(12, 0, 1, 1, 0x63),\n        SW(1, 0, 164), JAL(0, 16),\n        SW(1, 0, 168), JAL(0, -24), SW(1, 0, 172), EBREAK(),\n    ]\n    writes = []\n    reads = 0\n    waits = None\n    def ready(ia, da, ren, wen, data):\n        nonlocal reads, waits\n        if wen:\n            writes.append((da, wen, data))\n        if ren:\n            assert da == 160\n            if waits is None:\n                reads += 1\n                waits = 2 if reads in (1, 5) else 0\n            if waits:\n                waits -= 1\n                return (1, 0)\n            waits = None\n            return (int(reads not in (1, 5)), 1)\n        return (1, 1)\n    rets, _ = await _run(dut, prefix + loop, bus_ready=ready)\n    assert reads == 5\n    assert writes == [(168,15,i) for i in (4,3,2,1)] + [(164,15,0)]\n    expected = list(range(73))\n    for i in range(5):\n        expected.extend(72 + n for n in (1,2,3))\n        expected.extend(72 + n for n in ((6,7) if i < 4 else (4,5,9)))\n    assert [r['pc'] for r in rets] == [4*w for w in expected]\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert [r['pc_next'] for r in rets[:-1]] == [r['pc'] for r in rets[1:]]\n    branches = [i for i,r in enumerate(rets) if r['pc'] == 4*(72+3)]\n    for idx in branches[1:4]:\n        assert rets[idx+1]['cycle'] == rets[idx]['cycle']+1\n\n@cocotb.test()\nasync def safe_direct_targets_and_misaligned_fallthrough(dut):\n    fetches = []\n    def ready(ia, *args):\n        fetches.append(ia)\n        return (1,1)\n    program = [_b(-4,0,0,1,0x63), JAL(1,2), ADDI(2,0,19), JALR(1,2,0),\n               BEQ(0,0,2), JALR(1,0,25), EBREAK()]\n    rets, _ = await _run(dut, program, bus_ready=ready)\n    assert all(0 <= pc < (1 << 20) and pc % 4 == 0 for pc in fetches)\n    assert [r['pc'] for r in rets] == list(range(0,28,4))\n    assert [r['trap'] for r in rets] == [0,1,0,1,1,0,0]\n    assert [r['pc_next'] for r in rets] == list(range(4,32,4))\n    assert [r['rd'] for r in rets] == [0,0,2,0,0,1,0]\n    assert rets[-2]['rd_wdata'] == 24\nPY\ncat '/srv/hwebench/tmp/800f6bc6/d1bbc772/predictor.bYHSKk4P/directed.pyfrag' >> '/srv/hwebench/tmp/800f6bc6/d1bbc772/predictor.bYHSKk4P/verify/cores/bench/test/test_pipeline.py'\ncd '/srv/hwebench/tmp/800f6bc6/d1bbc772/predictor.bYHSKk4P/verify/cores/bench' && PYTHONDONTWRITEBYTECODE=1 python -m pytest -q --rootdir=. test/test_pipeline.py > '/srv/hwebench/tmp/800f6bc6/d1bbc772/predictor.bYHSKk4P/cocotbplus.log' 2>&1 && tail -3 '/srv/hwebench/tmp/800f6bc6/d1bbc772/predictor.bYHSKk4P/cocotbplus.log'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
