{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"cat test/cosim/build.sh\nsed -n '104,153p' Makefile\nls -l /opt/hwe-toolchain/bin\"", "aggregated_output": "#!/usr/bin/env bash\n# Build the Verilator-based cosim binary that drives `core` against an ELF\n# program. Produces $OBJ_DIR/cosim_sim (default: test/cosim/obj_dir/cosim_sim).\n#\n# RTL_DIR (default: rtl/) is globbed dynamically (with core_pkg.sv forced\n# first because its compilation-unit-scope typedefs and localparams must be\n# visible before any module references them). Hypotheses are allowed to add,\n# rename, or delete files inside rtl/, so a hardcoded file list would\n# silently break restructuring hypotheses.\nset -euo pipefail\n\nREPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nCOSIM_DIR=\"$REPO_ROOT/test/cosim\"\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${OBJ_DIR:-}\" ]; then\n  echo \"ERROR: test/cosim/build.sh requires RTL_DIR and OBJ_DIR env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl OBJ_DIR=cores/v1/obj_dir bash test/cosim/build.sh\" >&2\n  exit 2\nfi\n\n# NRET picks which RVFI port set main.cpp expects on `core`.\n# 1 = single-issue (only `_0` ports); 2 = dual-channel (both `_0` and `_1`).\n# Default 2 preserves existing behavior; orchestrator sets to 1 for cores\n# whose core.yaml declares nret: 1.\nNRET=\"${NRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[6233 of 9305 chars elided by tools/bench/transcript.py; sha256:eefca8c557610826]…\n32-unknown-elf-objcopy -> /opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-objcopy\nlrwxrwxrwx 1 nobody nogroup 79 Sep 28 02:44 riscv32-unknown-elf-objdump -> /opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-objdump\nlrwxrwxrwx 1 nobody nogroup 78 Sep 28 02:44 riscv32-unknown-elf-ranlib -> /opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-ranlib\nlrwxrwxrwx 1 nobody nogroup 79 Sep 28 02:44 riscv32-unknown-elf-readelf -> /opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-readelf\nlrwxrwxrwx 1 nobody nogroup 76 Sep 28 02:44 riscv32-unknown-elf-size -> /opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-size\nlrwxrwxrwx 1 nobody nogroup 79 Sep 28 02:44 riscv32-unknown-elf-strings -> /opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-strings\nlrwxrwxrwx 1 nobody nogroup 77 Sep 28 02:44 riscv32-unknown-elf-strip -> /opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-strip\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/mshare/proto.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ[\\\"TMPDIR\\\"])/\\\"mshare\\\"\nbase=Path(\\\"cores/bench/rtl\\\")\ndef put(file,txt): (p/\\\"rtl\\\"/file).write_text(txt)\ndef src(file): return (base/file).read_text()\nH=1<<32\nbands=[]\nfor e in range(1,32):\n for k in range(e,-1,-1):\n  W=1<<k\n  def good(l):\n   z=H-l*(H//(l+W-1))\n   return z*z+(H+z)*l<8*H*l\n  if all(good(l) for l in range(1<<e,2<<e,W)):break\n bands.append((1<<(e-k),e,k))\nrows={}; expr=[]\nfor n,e,k in sorted(bands, reverse=True):\n addr=len(rows)\n assert addr%n==0\n s=(f\\\"{{{12-(e-k)}'d{addr//n}, D[{e-1}:{k}]}}\\\" if e>k else f\\\"12'd{addr}\\\")\n expr.append((e, \\\"32'b\\\"+'0'*(31-e)+'1'+'?'*e+\\\": addr = \\\"+s+\\\";\\\"))\n for j in range(n): rows[addr+j]=H//((1<<e)+((j+1)<<k)-1)\nromdef='\\\\n'.join(\\\"      \\\"+v for _,v in sorted(expr,reverse=True))\nrominit='\\\\n'.join(f\\\"  initial coeff[{a}]=32'd{v};\\\" for a,v in rows.items())\nalu=src('alu.sv')\nalu=alu.replace('  input  logic        div_request,','  input  logic        mul_hold,\\\\n  output logic [63:0] shared_product,\\\\n  input  logic        div_request,')\na=alu.index('  logic signed_div'); b=alu.index('\"'`endif'\"',a)\nimpl=\\\"\\\"\\\"\n  logic signed_mode, nA, nD, rem_q, neg_q;\n  assign signed_mode = op==ALU_DIV || op==ALU_REM;\n  assign nA=signed_mode && a[31];\n  assign nD=signed_mode && b[31];\n  logic [31:0] A,D,orig;\n  always_ff @(posedge clock) if(div_issue) begin\n    A<=nA ? -a : a;\n    D<=nD ? -b : b;\n    rem_q<=op==ALU_REM || op==ALU_REMU;\n    neg_q<=(op==ALU_REM || op==ALU_REMU) ? nA : ((nA\"'^nD) && b!=0);\n    orig<=a;\n  end\n  logic [11:0] addr;\n  always_comb begin\n    casez(D)\nROMDEF\n      default: addr=0;\n    endcase\n  end\n  (* syn_ramstyle=\"block_ram\" *) logic [31:0] coeff[0:4095];\nROMINIT\n  logic [31:0] M,R1,R2,Q0,Qsum,mag;\n  logic [32:0] Lp,Rp;\n  logic use_m;\n  wire [32:0] Rop=use_m ? {1'\"'b0,M} : Rp;\n  assign shared_product = \"'$signed(Lp) * $signed(Rop);\n  wire [31:0] est=shared_product[63:32];\n  wire [31:0] back=shared_product[31:0];\n  always_ff @(posedge clock) begin\n    if(phase_q==1) M<=coeff[addr];\n    if(!mul_hold) begin\n      use_m<=phase_q==1 || phase_q==3;\n      case(phase_q)\n        1: Lp<={1'\"'b0,A};\n        2,4: begin Lp<={1'b0,est}; Rp<={1'b0,D}; end\n        3: Lp<={1'b0,A-back};\n        default: begin\n          Lp<={(op==ALU_MULH || op==ALU_MULHSU) && a[31],a};\n          Rp<={op==ALU_MULH && b[31],b};\n        end\n      endcase\n    end\n    if(phase_q==2) Q0<=est;\n    if(phase_q==3) R1<=A-back;\n    if(phase_q==4) Qsum<=Q0+est;\n    if(phase_q==5) R2<=R1-back;\n  end\n  logic [34:0] mults[0:7];\n  logic [35:0] delta[0:7];\n  for(genvar i=0;i<8;i++)begin\n    always_ff @(posedge clock) if(phase_q==1) mults[i]<=35'(D)*35'(i);\n    assign delta[i]={4'b0,R2}-{1'b0,mults[i]};\n  end\n  logic [34:0] pairv[0:3];\n  for(genvar i=0;i<4;i++)begin\n    assign pairv[i]=delta[2*i+1][35] ? {3'(2*i),delta[2*i][31:0]} : {3'(2*i+1),delta[2*i+1][31:0]};\n  end\n  wire [34:0] corr=delta[4][35] ? (delta[2][35] ? pairv[0]:pairv[1]) : (delta[6][35]?pairv[2]:pairv[3]);\n  always_ff @(posedge clock) if(phase_q==6) begin\n    if(D==0) mag<=rem_q? A : 32'hffffffff;\n    else if(D==1) mag<=rem_q?0:A;\n    else mag<=rem_q ? corr[31:0] : Qsum+{29'b0,corr[34:32]};\n  end\n  assign div_result=neg_q ? -mag:mag;\n\\\"\\\"\\\".replace('ROMDEF',romdef).replace('ROMINIT',rominit)\nalu=alu[:a]+impl+alu[b:]\nalu=alu.replace('\"'`ifdef RISCV_FORMAL_ALTOPS'\"','\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n  assign shared_product=0;')\nput('alu.sv',alu)\nex=src('ex_stage.sv').replace('  output ex_mem_t  out,','  output logic [63:0] shared_product,\\\\n  output ex_mem_t  out,').replace('.div_request (is_div && \"'!stall),'\"','.div_request (is_div && \"'!stall),'\"\\\\n    .mul_hold(stall), .shared_product(shared_product),')\nput('ex_stage.sv',ex)\nmem=src('mem_stage.sv').replace('  output mem_wb_t  out','  input logic [63:0] shared_product,\\\\n  output mem_wb_t  out')\na=mem.index('                    : multiply_result(');b=mem.index(';',a)\nmem=mem[:a]+'''                    \"'`ifdef RISCV_FORMAL_ALTOPS\n'\"'''+mem[a:b+1]+'''\n                    \"'`else\n                    : in.ctrl.alu_op == ALU_MUL ? shared_product[31:0] : shared_product[63:32];\n                    `endif'\"'''+mem[b+1:]\nput('mem_stage.sv',mem)\ncore=src('core.sv').replace('  ex_stage u_ex (','  wire [63:0] shared_product;\\\\n  ex_stage u_ex (\\\\n    .shared_product(shared_product),').replace('  mem_stage u_mem (','  mem_stage u_mem (\\\\n    .shared_product(shared_product),')\nput('core.sv',core)\nPY\npython \\\"\"'$TMPDIR/mshare/proto.py\"\ncat > \"$TMPDIR/mshare/timing.py\" <<'\"'PY'\nfrom tools.eval.gowin import build\nfrom pathlib import Path\nimport os, sys\nroot=Path.cwd()\np=Path(os.environ[\\\"TMPDIR\\\"])/\\\"mshare\\\"\nver=sys.argv[1]\nplace=int(sys.argv[2]) if len(sys.argv)>2 else 1\nprint(build(root,p/ver if ver\"'!='\"'v1' else p/'rtl','fpga/core_bench_si.sv',place,p/f'pnr{ver}_{place}'),flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/mshare/timing.py\" v1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
