{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\ndata = [(int(p,16)>>2,int(t),int(hit),int(pred)) for _,p,t,pred,hit in (s.split() for s in (Path(os.environ['TMPDIR'])/'baseline-misses.log').read_text().splitlines() if s.startswith('B '))]\ndef run(h,s,l,tagbits,mode):\n    mask=(1<<h)-1\n    pm=(1<<s)-1\n    prev=[0]*(1<<l)\n    pat=[1]*(2<<s)\n    tags=[-1]*(2<<s)\n    saved={}\n    errors=0\n    for pc,t,hit,orig in data:\n        lh=pc&((1<<l)-1)\n        hc=prev[lh]\n        source = pc\"'^(pc>>s)\n        mix=source&pm\n        tag = (pc & ((1<<tagbits)-1)) if tagbits else 0\n        v=saved.get(pc,1)\n        pred = v>>1 if hit and v in (0,3) else orig\n        errors += t!=pred\n        hn=((hc<<1)|t)&mask\n        old=(((hc>>1)''^mix)<<1)|(hc&1)\n        new=(((hn>>1)''^mix)<<1)|t\n        saved[pc]=pat[new] if tags[new]==tag else 1\n        p=pat[old]\n        if tags[old]!=tag:\n            tags[old]=tag\n            pat[old]=1+t\n        elif mode==0:\n            pat[old]=min(3,p+1) if t else max(0,p-1)\n        else:\n            pat[old]=(t*2) | (p>>1)\n        prev[lh]=hn\n    return errors\nfor s,l in [(10,9),(9,8)]:\n for h in (8,9,10):\n  for t in (0,4,8):\n    print(h,s,l,t,run(h,s,l,t,0),run(h,s,l,t,1),flush=True)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
