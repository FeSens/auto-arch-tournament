{"type": "item.started", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/newton/bip.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport sys,os\nH=1<<32\nname=sys.argv[1]\np,n,g=map(int,sys.argv[2:5])\nguard=3\nstep=1<<n\nbase=Path(os.environ['TMPDIR'])/'newton'\nrtl=base/name/'rtl'\ncopytree(base/'v1/rtl',rtl,dirs_exist_ok=True)\nf=rtl/'alu.sv'; src=f.read_text()\nprefix=1<<p\nmidsize=1<<(p-g)\ndef rounding(num,den):\n return (num+den//2)//den\nc0=[0]+[H//(j+1) for j in range(1,prefix)]\nc0 += [rounding(H<<guard,j+1) for j in range(prefix,2*prefix)]\nc1=[]\nfor grp in range(1<<g):\n # Exact correction evaluated at central upper endpoint (twice that endpoint = mid).\n mid=2*(prefix+grp*midsize)+midsize+1\n for frac in range(step):\n  c1.append(rounding((H<<guard)*4*frac,mid*(mid*step-2*frac)))\ndef rom(name,vals,w):\n return f'  (* syn_ramstyle = \\\"block_ram\\\" *) logic [{w-1}:0] {name}[0:{len(vals)-1}];\\\\n  initial begin\\\\n'+'\\\\n'.join(f\\\"    {name}[{i}] = {w}'h{v:0{(w+3)//4}x};\\\" for i,v in enumerate(vals))+'\\\\n  end\\\\n'\ni=src.index('  logic [4:0] s, shift_q');j=src.index('  logic [31:0] m0_q',i)\npre=f\\\"\\\"\\\"\n  logic [4:0] s,scale_q;\n  wire [{n+31}:0] ext = {{index_input,{n}'b0}};\n  always_comb begin\n    s = 0;\n    for (int i = {p+1}; i < 32; i++)\n      if (index_input[i]) s = 5'(i-{p});\n  end\n  wire [{p+n}:0] packed_idx = {p+n+1}'(ext >> s);\n  wire [{p}:0] j_idx = packed_idx[{p+n}:{n}];\n  wire [{n-1}:0] frac = ~packed_idx[{n-1}:0];\n  wire [{n-1}:0] fractional_offset;\n  // Left alignment pads the complement with zeros below the available bits.\n  wire [{n+31}:0] inv_ext = {{~index_input,{n}'b0}};\n  assign fractional_offset = {n}'(inv_ext >> s);\n\\\"\\\"\\\"\n# for x==D-1 with s smaller than n, only s lowest bits can contribute;\n# shift of {~x, 0} is complement padded with zeros -> correct\npre+=rom('intercept',c0,32)+rom('adjust',c1,max(c1).bit_length())\ncw=max(c1).bit_length()\npre+=f\\\"\\\"\\\"\n  logic [31:0] c_q, refined_q, m_q;\n  logic [{cw-1}:0] k_q;\n  logic in_table_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd1) begin\n      c_q <= intercept[j_idx];\n      k_q <= adjust[{{j_idx[{p-1}:{p-g}], fractional_offset}}];\n      scale_q <= s + 5'd{guard};\n      in_table_q <= \"'!j_idx[{p}];\n    end\n    if (phase_q == 3'\"'d2)\n      refined_q <= in_table_q ? c_q : c_q + 32'(k_q);\n    if (phase_q == 3'd3)\n      m_q <= in_table_q ? refined_q : 32'(({{1'b0,refined_q}} + (33'd1 << (scale_q-1'b1))) >> scale_q);\n  end\n\\\"\\\"\\\"\ni2=src.index('\\\\n\"'`endif'\"',j)\npost=\\\"\\\"\\\"\n  logic [31:0] estimate_q, magnitude_q;\n  logic [32:0] residual_q;\n  wire [31:0] lhs = phase_q == 3'd5 ? estimate_q : dvd_q;\n  wire [31:0] rhs = phase_q == 3'd5 ? dvs_q : m_q;\n  wire [63:0] product = lhs * rhs;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd4) estimate_q <= product[63:32];\n    if (phase_q == 3'd5) residual_q <= {1'b0,dvd_q} - product[32:0];\n  end\n  wire [31:0] residual = residual_q[31:0];\n  wire over = residual_q[32];\n  wire under = \"'!over && residual >= dvs_q;\n  wire [31:0] remainder = over ? residual+dvs_q : under ? residual-dvs_q : residual;\n  wire [31:0] quotient_val = over ? estimate_q-32'\"'d1 : under ? estimate_q+32'd1 : estimate_q;\n  always_ff @(posedge clock) begin\n    if (phase_q == 3'd6) begin\n      if (dvs_q == 0) magnitude_q <= rem_q ? dvd_q : 32'hffffffff;\n      else if (dvs_q == 1) magnitude_q <= rem_q ? 0 : dvd_q;\n      else magnitude_q <= rem_q ? remainder : quotient_val;\n    end\n  end\n  assign div_result = neg_q ? -magnitude_q : magnitude_q;\n\\\"\\\"\\\"\nf.write_text(src[:i]+pre+post+src[i2:])\n# Check lower/upper endpoints of every fraction bin, whether attainable exactly or quantized.\nbad=0;ct=0;worst=(0,0)\nfor s in range(32-p):\n W=1<<s\n for j in range(prefix,2*prefix):\n  U=(j+1)*W\n  for frac in range(0,step,max(1,step//W)):\n   tl=(f