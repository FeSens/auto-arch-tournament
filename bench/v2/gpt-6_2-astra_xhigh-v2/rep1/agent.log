{"type": "item.completed", "item": {"id": "item_30", "type": "command_execution", "command": "/bin/bash -c 'cat \"$TMPDIR/predictor/cores/bench/rtl/ex_stage.sv\" | tail -100; du -sh \"$TMPDIR/predictor\"'", "aggregated_output": "  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] jump_target;\n  // Loads, stores, and JALR share the forwarded base-plus-offset adder.\n  logic [31:0] base_plus_imm;\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 != rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'b0;\n    endcase\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = direct_q;\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    base_plus_imm = rs1 + in.imm;\n    jump_target = in.ctrl.is_jalr ? {base_plus_imm[31:1], 1'b0}\n                                  : direct_q;\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n\n  assign redirect = in.valid && !stall &&\n        (predicted_taken ^ ((branch_taken || in.ctrl.is_jump) && !misalign_fault));\n  assign redirect_target = in.ctrl.is_jalr ? {base_plus_imm[31:1], 1'b0} :\n                           predicted_taken ? fallthrough_q : direct_q;\n  assign train = in.ctrl.is_branch && !stall && !misalign_fault;\n  assign actual_agree = branch_cond == in.imm[31];\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (stall) begin\n      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n      // stays in MEM stage waiting on the bus.\n      reg_q <= reg_q;\n    end else begin\n      reg_q.pc            <= in.pc;\n      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n      // sum (which is the jump target).\n      reg_q.alu_result    <= in.ctrl.is_jump ? fallthrough_q : alu_result;\n      reg_q.mem_addr      <= base_plus_imm;\n      // Capture the operands while the forwarding sources are still live.\n      // These EX/MEM fields can hold them across the invalid divider slots.\n      if (!div_busy) begin\n        reg_q.write_data <= rs2;\n        reg_q.rs1_val    <= rs1;\n        reg_q.rs2_val    <= rs2;\n      end\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= misalign_fault     ? fallthrough_q\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : fallthrough_q;\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !div_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n203M\t/srv/hwebench/tmp/800f6bc6/a2dea662/predictor\n", "exit_code": 0, "status": "completed"}}
