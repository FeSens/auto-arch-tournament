{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/div-research/profile.py\" <<'\"'PY'\nimport collections,json,sys\non=False\nprev=None\npairs=collections.Counter()\nstats=collections.Counter()\nhistory={}\nspcs=collections.Counter()\npcstats=collections.Counter()\nfor line in sys.stdin.buffer:\n    x=json.loads(line)\n    if 'cycle' not in x:continue\n    if x['mem_addr']==0x10000104 and x['mem_wmask']:break\n    if x['mem_addr']==0x10000100 and x['mem_wmask']:on=True\n    if not on:continue\n    ins=x['insn'];op=ins&127;f3=(ins>>12)&7\n    stats[op]+=1\n    if prev and prev['insn'] & 127==3:\n        a=prev['rd_addr']\n        if a and (a==x['rs1_addr'] or a==x['rs2_addr']):\n            pairs[op,f3]+=1\n            pcstats[(x['pc_rdata'],op,f3)]+=1\n    addr=x['mem_addr']\n    if x['mem_rmask']:\n        tag=addr &~3\n        seen=history.get(tag)\n        if seen:\n            cnt,last_store=seen\n            if last_store:spcs['last_store']+=1\n            if stats[3]-cnt<16:spcs['last16']+=1\n        history[tag]=(stats[3],False)\n    if x['mem_wmask']: history[addr&~3]=(stats[3],True)\n    prev=x\nprint('pairs',pairs,'inst',stats,'recent',spcs,'pcs',pcstats.most_common(15))\nPY\nset -o pipefail\n\\\"\"'$TMPDIR/div-research/wide16/obj_dir/cosim_sim\" \"$TMPDIR/div-research/bench/programs/coremark.elf\" 10000000 --istall --dstall | python \"$TMPDIR/div-research/profile.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
