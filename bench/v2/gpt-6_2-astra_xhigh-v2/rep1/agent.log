{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/verify.py\" <<'\"'PY'\nimport os,shutil,sys\nfrom pathlib import Path\nd=Path(os.environ['TMPDIR']); name=sys.argv[1];src=sys.argv[2] if len(sys.argv)>2 else 'retime';root=d/name;shutil.copytree(d/src,root,dirs_exist_ok=True)\ndef change(file,old,new):\n f=root/(file+'.sv');s=f.read_text();assert old in s,(file,old);f.write_text(s.replace(old,new,1))\nif 'sum' in name:\n # Compute tag==base+imm without a wide carry path. Reduce matches into five clocked groups.\n change('core_pkg','    logic predicted_valid;', '    logic predicted_valid;\\\\n    logic [4:0] address_match;')\n change('ex_stage','  assign effective_addr =','''  wire [31:0] wanted = {12'b0, early_tag,2'b0};\n  wire [31:0] cin = rs1 \"'^ in.imm ''^ wanted;\n  wire [31:0] cout = (rs1 & in.imm) | ((rs1 ''^ in.imm) & cin);\n  wire [2:0] lo = {1'\"'b0,rs1[1:0]} + {1'b0,in.imm[1:0]};\n  wire [31:2] match_bits = ~(cin[31:2] \"'^ {cout[30:2],lo[2]});\n  assign effective_addr ='\"''')\n change('ex_stage','reg_q.predicted_tag <= early_tag;', '''reg_q.predicted_tag <= early_tag;\n      reg_q.address_match <= {&match_bits[31:26], &match_bits[25:20], &match_bits[19:14], &match_bits[13:8], &match_bits[7:2]};''')\n change('core','ex_mem_w.predicted_tag == ex_mem_w.mem_addr[19:2];','(&ex_mem_w.address_match);')\nif 'part' in name:\n change('core_pkg','    logic predicted_valid;', '    logic predicted_valid;\\\\n    logic index_match;')\n change('ex_stage','reg_q.predicted_tag <= early_tag;', '''reg_q.predicted_tag <= early_tag;\n      reg_q.index_match <= base_plus_imm[10:2] == early_tag[10:2];''')\n change('core','ex_mem_w.predicted_tag == ex_mem_w.mem_addr[19:2];','ex_mem_w.index_match && ex_mem_w.predicted_tag[19:11]==ex_mem_w.mem_addr[19:11];')\nif 'flat' in name:\n before='ex_mem_w.predicted_tag == ex_mem_w.mem_addr[19:2];'\n after=' && '.join('(\"'!(|(ex_mem_w.predicted_tag[%d:%d] ''^ ex_mem_w.mem_addr[%d:%d])))'\"'%(i+2,i,i+2,i) for i in range(2,20,3))+';'\n change('core',before,after)\nif 'alu' in name:\n change('alu','  input  logic        clock,','  input logic [31:0] load_hint,\\\\n  input  logic        clock,')\n change('alu','      ALU_ADD:','      5\\\\'d19: out = load_hint;\\\\n      ALU_ADD:')\n change('ex_stage','    .clock       (clock),','    .load_hint(early_value),\\\\n    .clock       (clock),')\n change('id_stage','dec_is_jump ? ALU_LUI : dec_alu_op','dec_is_jump ? ALU_LUI : dec_mem_read ? 5\\\\'d19 : dec_alu_op')\n change('ex_stage','assign generated_value = in.ctrl.mem_read ? early_value : alu_result;','assign generated_value = alu_result;')\nPY\nfor variant in part sum partalu sumalu aluflat; do python \\\"\"'$TMPDIR/verify.py\" \"$variant\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
