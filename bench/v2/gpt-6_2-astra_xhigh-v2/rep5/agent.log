{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/operand/stream.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,sys\nbase=Path(os.environ['TMPDIR'])\nd=base/('stream'+sys.argv[1])/'rtl'\nd.mkdir(parents=True,exist_ok=True)\nsource=base/('operand'+sys.argv[1])/'rtl'\nfor p in source.glob('*.sv'): (d/p.name).write_bytes(p.read_bytes())\np=d/'if_stage.sv';s=p.read_text()\na=s.index('  typedef struct packed {',s.index('  } fetch_word_t;'))\nb=s.index('  // An older store in MEM',a)\ns=s[:a]+'''  (* syn_ramstyle = \\\"block_ram\\\" *) logic [50:0] words [0:2047];\n  fetch_word_t ram_word;\n  (* syn_preserve = 1 *) fetch_word_t candidate;\n  logic [11:0] scrub;\n  logic [10:0] prev_pc, prev2_pc, row_q, wr_row_q, write_row;\n  logic [1:0] valid_history;\n  logic accepted_q, live_q, write_hit, read_ok_q, ram_ok, candidate_ok_q;\n  logic [19:2] sample_pc;\n  logic [31:0] sample_instr;\n  logic in_window, hit, fence_issue, fence_in_ex;\n  logic [31:0] instr;\n  assign in_window = pc[31:20] == 0;\n  assign write_row = scrub[11] ? prev2_pc : scrub[10:0];\n  assign write_hit = \"'!scrub[11] || (accepted_q && live_q && valid_history[1]);\n  always_ff @(posedge clock) begin\n    if (write_hit)\n      words[write_row] <= {scrub[11], sample_pc, sample_instr};\n    ram_word <= words[pc[12:2]];\n    row_q <= pc[12:2];\n    wr_row_q <= write_row;\n    read_ok_q <= scrub[11] && !reset;\n    wr_en_q <= write_hit;\n    candidate <= ram_word;\n    candidate_ok_q <= ram_ok;\n    sample_pc <= pc[19:2];\n    sample_instr <= imem_data;\n    live_q <= imem_ready && in_window;\n    accepted_q <= issue;\n    if (accepted_q) begin\n      prev_pc <= sample_pc[12:2];\n      prev2_pc <= prev_pc;\n    end\n  end\n  logic wr_en_q;\n  assign ram_ok = read_ok_q && !(wr_en_q && wr_row_q == row_q);\n  always_ff @(posedge clock) begin\n    if (reset || fence_in_ex) begin\n      scrub <= 0;\n      valid_history <= 0;\n    end else begin\n      if (!scrub[11]) scrub <= scrub + 1'\"'b1;\n      if (accepted_q) valid_history <= {valid_history[0],1'b1};\n    end\n  end\n  assign hit = scrub[11] && candidate_ok_q && candidate.valid && in_window && candidate.pc == pc[19:2];\n  assign instr = imem_ready ? imem_data : candidate.instr;\n  assign fence_issue = issue && instr[6:0] == 7'b0001111 && instr[14:12] == 3'b001;\n''' +s[b:]\n# Preserve the fence barrier at normal issue; stale responses remain excluded even when a fence is stalled.\np.write_text(s)\nPY\npython \\\"\"'$TMPDIR/operand/stream.py\" 2\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
