{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"sed -n '1110,1200p' cores/bench/test/test_pipeline.py; date -u\"","aggregated_output":"\n    def dready(addr, ren, wen):\n        nonlocal store_waits, stored_first_word\n        if wen and addr == 24:\n            if store_waits:\n                store_waits -= 1\n                return False\n            stored_first_word = True\n        return True\n\n    def iready(pc):\n        nonlocal successor_requests, first_word_waits\n        if pc == 24 and stored_first_word and first_word_waits:\n            first_word_waits -= 1\n            return False\n        if pc == 28:\n            successor_requests += 1\n            # Fill PC 28 on the first pass. After FENCE.I, hold the\n            # bus for three clocks at 28 with the old word in that row.\n            return successor_requests == 1 or successor_requests >= 5\n        return True\n\n    rets, mem = await _run(dut, program, {0x80: replacement}, initial_fetch_wait=1024,\n                           shared_memory=True, dmem_ready=dready, imem_ready=iready)\n    before = [0, 4, 8, 24, 28, 32, 12, 16, 20]\n    _check_path(rets, program, before + [24, 28, 32, 36],\n                [program[pc // 4] for pc in before] + [replacement] * 2 + program[8:])\n    assert store_waits == first_word_waits == 0 and successor_requests == 5\n    assert mem[24] == mem[28] == replacement\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] in (24, 28)] == [1, 2, 9, 9]\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n\n@cocotb.test()\nasync def live_word_priority_and_completed_fence_scrub(dut):\n    entry = 64\n    replacement = ADDI(4, 0, 99)\n    program = [\n        LW(5, 0, 0x80), JAL(1, entry - 4),\n        SW(5, 0, entry + 8), JAL(1, entry - 12),\n        SW(5, 0, entry + 12), FENCE_I(),\n        JAL(1, entry - 24), EBREAK(),\n    ] + [NOP()] * 8 + [NOP(), NOP(), ADDI(3, 0, 1), ADDI(4, 0, 2), JALR(0, 1, 0)]\n    scrub_wait = 1024\n    visits = 0\n    miss_wait = 3\n\n    def iready(pc):\n        nonlocal scrub_wait, visits, miss_wait\n        if pc == 24 and scrub_wait:\n            scrub_wait -= 1\n            return False\n        if pc == entry:\n            visits += 1\n        if visits == 3 and pc == entry + 12 and miss_wait:\n            miss_wait -= 1\n            return False\n        return True\n\n    rets, _ = await _run(dut, program, {0x80: replacement}, initial_fetch_wait=1024,\n                         max_cycles=1100, shared_memory=True, imem_ready=iready)\n    body = list(range(entry, entry + 20, 4))\n    pcs = [0, 4] + body + [8, 12] + body + [16, 20, 24] + body + [28]\n    # Second call sees a changed live word despite a matching prediction.\n    # Third call must wait for the second patch even after replay is enabled.\n    expected = program.copy()\n    insns = []\n    for pc in pcs:\n        insns.append(expected[pc // 4])\n        if pc == 8:\n            expected[(entry + 8) // 4] = replacement\n        if pc == 16:\n            expected[(entry + 12) // 4] = replacement\n    _check_path(rets, program, pcs, insns)\n    assert scrub_wait == miss_wait == 0\n\n\n@cocotb.test()\nasync def aliased_counter_and_prediction_guards(dut):\n    # The branches are 512 bytes apart and share one counter. A taken BLT\n    # warms it for a busy BEQ whose older MEM value would predict fallthrough.\n    a, b, c, d, e = range(512, 2561, 512)\n    program = [SW(0, 0, 0)] * (e // 4 + 3)\n    program[:128] = [ADDI(1, 0, 1)] + [NOP()] * 127\n    probes = {\n        a: BLT(0, 1, b - 8 - a),\n        b - 8: ADDI(2, 0, 1), b - 4: ADDI(2, 0, 0),\n        b: BEQ(0, 2, c - b),\n        c: _b(8, 0, 0, 2, 0x63),          # reserved branch funct3\n        c + 4: JAL(0, d - (c + 4)),\n        d: BLT(0, 0, -4096),               # table taken, target below zero\nSun Nov 22 11:25:37 UTC 2026\n","exit_code":0,"status":"completed"}}
