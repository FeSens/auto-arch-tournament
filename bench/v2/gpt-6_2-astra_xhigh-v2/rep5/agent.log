is_jump && target[1]);\n  assign bypass1 = src1_match && source_writes;\n  assign bypass2 = src2_match && source_writes;\n  logic [2:0] bank1_q, bank2_q;\n  always_ff @(posedge clock) if (capture) begin\n    bank1_q <= {bypass1 && !(mul_low || mul_high),bypass1 && (mul_low || mul_high),bypass1 && mul_high};\n    bank2_q <= {bypass2 && !(mul_low || mul_high),bypass2 && (mul_low || mul_high),bypass2 && mul_high};\n  end\n  assign rs1 = bank1_q[1] ? (bank1_q[0] ? product_high : product_low) : (bank1_q[2] ? reg_q.alu_result : in.rs1_val);\n  assign rs2 = bank2_q[1] ? (bank2_q[0] ? product_high : product_low) : (bank2_q[2] ? reg_q.alu_result : in.rs2_val);\n\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      use_low_q           <= mul_low;\n      use_high_q          <= mul_high;\n      use_ordinary_q      <= !(mul_low || mul_high);\n      reg_q.pc            <= in.pc;\n      reg_q.alu_result    <= in.ctrl.mem_read ? predicted_data :\n                             div_valid ? div_result : alu_result;\n      reg_q.mem_addr      <= mem_addr;\n      reg_q.load_hit      <= load_hit;\n      reg_q.load_word     <= candidate.data;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_valid ? div_rs1_q : rs1;\n      reg_q.rs2_val       <= div_valid ? div_rs2_q : rs2;\n      reg_q.pc_next       <= actual_taken ? target : in.pc_plus4;\n","exit_code":0,"status":"completed"}}
