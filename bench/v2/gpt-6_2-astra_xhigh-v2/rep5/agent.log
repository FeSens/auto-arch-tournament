DIR':str(rtl),'OBJ_DIR':str(obj),'NRET':'1'},stdout=f,stderr=f,check=True)\n binary=str(obj/'cosim_sim')\n d=run_coremark_ipc(str(root),binary)\n return d\nwith ThreadPoolExecutor(max_workers=4) as ex:\n futs=[]\n for k in sys.argv[2:]:\n  futs.append(ex.submit(sim) if k=='sim' else ex.submit(timing,int(k)))\n for f in as_completed(futs):\n  print(name, f.result(),flush=True)\nPY\nroot=/srv/hwebench/tmp/19d02a47/66dd5617/agu.Ruac6Z\npython \\\"\"'$root/replay.py\" successor 9 && PYTHONPATH=. python -u \"$root/testproto.py\" successor 1 sim'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
