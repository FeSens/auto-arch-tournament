{"type": "item.completed", "item": {"id": "item_129", "type": "command_execution", "command": "/bin/bash -c \"sed -n '365,610p' cores/bench/test/test_pipeline.py && cat cores/bench/test/_helpers.py | head -140 && cat cores/bench/test/conftest.py | head -100 && sed -n '1148,1195p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert (add[\"rs2_addr\"], add[\"rs2_rdata\"]) == (5, 0xFFFFFF81)\n    assert (add[\"rd\"], add[\"rd_wdata\"]) == (6, 0xFFFFFF02)\n\n\n@cocotb.test()\nasync def predicted_load_lanes_with_bus_stopped(dut):\n    raw = 0xA781F03C\n    # The first signed byte read supplies the whole row. The negative\n    # displacements of the following loads select different lanes.\n    lanes = [(0, 0, 0x3C), (0, 1, 0xFFFFFFF0), (0, 2, 0xFFFFFF81),\n             (4, 3, 0xA7), (1, 0, 0xFFFFF03C), (5, 2, 0xA781), (2, 0, raw)]\n    program = [ADDI(1, 0, 0x49), NOP()]\n    reads = []\n    for funct3, lane, _ in lanes:\n        program.extend([_i(lane - 9, 1, funct3, 5, 3), ADD(6, 5, 5)])\n    program.append(EBREAK())\n\n    def ready(addr, ren, wen):\n        assert not wen\n        if ren:\n            reads.append(addr)\n        return ren and len(reads) == 1\n\n    rets, _ = await _run(dut, program, {0x40: raw}, initial_fetch_wait=1024, dmem_ready=ready)\n    _check_straight_line(rets, program)\n    assert reads == [0x40]\n    for i, (funct3, lane, value) in enumerate(lanes):\n        load, add = rets[2 + 2*i:4 + 2*i]\n        width = 1 << (funct3 & 3)\n        assert (load[\"mem_addr\"], load[\"mem_rmask\"], load[\"mem_wmask\"], load[\"mem_rdata\"]) == (\n            0x40, ((1 << width) - 1) << lane, 0, raw)\n        assert (load[\"trap\"], load[\"rd\"], load[\"rd_wdata\"]) == (0, 5, value)\n        assert (add[\"rs1_rdata\"], add[\"rs2_rdata\"], add[\"rd_wdata\"]) == (\n            value, value, (value * 2) & 0xFFFFFFFF)\n        assert add[\"cycle\"] - load[\"cycle\"] == (2 if i == 0 else 1)\n\n\n@cocotb.test()\nasync def replay_pointer_loads_with_both_buses_stopped(dut):\n    # The first LB needs the adjacent pointer load in EX. The second\n    # needs its MEM bypass in ID. Clear x1 between laps to expose either\n    # use of an older register value. Replay the trained lap from imem's\n    # successor table with unrelated data on both external buses.\n    program = [\n        ADDI(7, 0, 3), LW(1, 0, 0x70), LB(5, 1, -3), LB(6, 1, -2), ADD(8, 5, 6),\n        ADDI(1, 0, 0), ADDI(7, 7, -1), BNE(7, 0, -24\n…[10212 of 13284 chars elided by tools/bench/transcript.py; sha256:7d10279373a2b310]…\nst_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"radix4_path.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\",\n            \"hazard_unit.sv\", \"load_predictor.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
