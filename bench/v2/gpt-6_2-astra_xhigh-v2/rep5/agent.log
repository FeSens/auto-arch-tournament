{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"sed -n '270,355p;475,528p' cores/bench/test/test_pipeline.py; ls cores/bench/generated/timing/gowin_p0/impl/pnr\"", "aggregated_output": "\n\n@cocotb.test()\nasync def held_ex_operands_and_matches(dut):\n    # The first ADD has its WB and MEM operands when the load stalls. The\n    # waiting second ADD has different operands and matches the first ADD's\n    # destination on both sources throughout the stall.\n    program = [\n        ADDI(1, 0, 21), ADDI(2, 0, 34), LW(3, 0, 0x40),\n        ADD(4, 1, 2), ADD(5, 4, 4), EBREAK(),\n    ]\n    waits = 3\n\n    def ready(addr, ren, wen):\n        nonlocal waits\n        if ren and waits:\n            waits -= 1\n            return False\n        return True\n\n    rets, _ = await _run(dut, program, {0x40: 7}, dmem_ready=ready)\n    _check_straight_line(rets, program)\n    assert waits == 0\n    assert all(r[\"trap\"] == 0 for r in rets)\n    assert (rets[3][\"rs1_rdata\"], rets[3][\"rs2_rdata\"], rets[3][\"rd_wdata\"]) == (21, 34, 55)\n    assert (rets[4][\"rs1_rdata\"], rets[4][\"rs2_rdata\"], rets[4][\"rd_wdata\"]) == (55, 55, 110)\n\n\n@cocotb.test()\nasync def trapping_writers_preserve_old_rd(dut):\n    # The load faults in MEM with the old x5 in WB. The jump faults in\n    # EX with the old x5 in MEM and both adjacent-source matches set.\n    program = [\n        ADDI(5, 0, 17), LW(5, 0, 0x42), ADD(6, 5, 5),\n        ADDI(5, 0, 23), JAL(5, 2), ADD(7, 5, 5), EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, {0x40: 0xDEADBEEF})\n    _check_straight_line(rets, program)\n    assert [r[\"trap\"] for r in rets] == [0, 1, 0, 0, 1, 0, 0]\n    assert rets[1][\"mem_rmask\"] == rets[1][\"mem_wmask\"] == 0\n    for i, old, rd in [(1, 17, 6), (4, 23, 7)]:\n        fault, add = rets[i:i + 2]\n        assert (fault[\"rd\"], fault[\"rd_wdata\"]) == (0, 0)\n        assert (add[\"rs1_addr\"], add[\"rs1_rdata\"]) == (5, old)\n        assert (add[\"rs2_addr\"], add[\"rs2_rdata\"]) == (5, old)\n        assert (add[\"rd\"], add[\"rd_wdata\"]) == (rd, 2 * old)\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the\n…[2092 of 5164 chars elided by tools/bench/transcript.py; sha256:cb5c0168894cc550]…\n 6}, initial_fetch_wait=512,\n                           imem_ready=iready, dmem_ready=dready)\n    _check_path(rets, program, [0, 4] + [8, 12, 16, 20, 24] * 4 + [28, 32])\n    assert load_waits == exit_waits == 0\n    assert all(r[\"trap\"] == 0 for r in rets)\n    adds = _by_insn(rets, program[3])\n    assert [(r[\"rs1_rdata\"], r[\"rs2_rdata\"]) for r in adds] == [(6, i) for i in range(4)]\n    stores = [r for r in rets if r[\"mem_wmask\"]]\n    assert [(r[\"mem_addr\"], r[\"mem_wmask\"], r[\"mem_wdata\"]) for r in stores] == [\n        (0x84, 15, 6 + i) for i in range(4)\n    ] + [(0x88, 15, 4)]\n    assert (mem[0x84], mem[0x88]) == (9, 4)\n\n\n@cocotb.test()\nasync def aliased_successors_and_same_row_write(dut):\n    a = 16\n    b = a + 2048\n    c = b + 2048\ncmd.do\ncore_bench.bin\ncore_bench.binx\ncore_bench.db\ncore_bench.fs\ncore_bench.log\ncore_bench.pin.html\ncore_bench.power.html\ncore_bench.rpt.html\ncore_bench.rpt.txt\ncore_bench.timing_paths\ncore_bench.tr\ncore_bench.tr.html\ncore_bench_tr_cata.html\ncore_bench_tr_content.html\ndevice.cfg\n", "exit_code": 0, "status": "completed"}}
