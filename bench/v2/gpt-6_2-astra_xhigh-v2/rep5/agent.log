{"type":"item.started","item":{"id":"item_114","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r10s1.XAOKHW/commit.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport os\nd=Path(os.environ['TMPDIR'])/'r10s1.XAOKHW'\nfor name,base in [('link_qual','recover_link'),('link_history','recover_link'),('link_probe','probe_qual'),('clean_probe','probe'),('bank_history','target_banks'),('late_meta','probe')]:\n p=d/name;copytree(d/base,p)\n c=p/'if_stage.sv';s=c.read_text()\n if name in ['link_history','bank_history']:\n  s=s.replace('if (issue)', 'if (issue && \"'!redirect)'\"').replace('&& issue && imem_ready','&& issue && \"'!redirect && imem_ready'\"')\n if name=='link_qual':\n  c2=p/'core.sv';s2=c2.read_text().replace('.issue           (\"'!stall_if)'\"', '.issue           (\"'!stall_if && !redirect)'\"');c2.write_text(s2)\n if name in ['link_probe','clean_probe']:\n  c2=p/'ex_stage.sv';s2=c2.read_text();i=s2.index('  assign ordinary_writer');j=s2.index('  always_ff',i);z=(d/'recover_link/ex_stage.sv').read_text();i2=z.index('  logic link_ok;');j2=z.index('  always_ff',i2);c2.write_text(s2[:i]+z[i2:j2]+s2[j:])\n if name=='late_meta':\n  # Keep successive source PCs committed, while the physical probes/candidate run independently and always require a full-address match.\n  s=s.replace('      recent <= {pc[12:2], matched};\\\\n      older <= recent;', '''      if (\"'!redirect) begin\n        recent <= {pc[12:2], matched};\n        older <= recent;\n      end'\"''').replace('        history_valid <= {history_valid[0], 1\\\\'b1};', \\\"        if (\"'!redirect) history_valid <= {history_valid[0], 1'\"'b1};\\\").replace('&& issue && imem_ready','&& issue && \"'!redirect && imem_ready'\"')\n c.write_text(s)\nPY\npython \\\"\"'$TMPDIR/r10s1.XAOKHW/commit.py\"\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
