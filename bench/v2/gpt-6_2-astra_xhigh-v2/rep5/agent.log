{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,tempfile\nfrom tools.eval.gowin import build\nbase=Path(tempfile.gettempdir())/'prefix-divider-eegy0os4'\nr=shutil.copytree(base/'rtl',base/'rtl_nibble')\np=r/'alu.sv'\ns=p.read_text()\nindex=s.index('  always_comb begin\\\\n    prefix_d1')\ns=s[:index]+'''  function automatic logic [7:0] divide_nibble(input logic [3:0] n, d);\n    case ({n, d})\n'''+''.join(f\\\"      8'h{(n<<4|d):02x}: divide_nibble = 8'h{((n//d if d else 15)<<4 | (n%d if d else n)):02x};\\\\n\\\" for n in range(16) for d in range(16))+'''      default: divide_nibble = 0;\n    endcase\n  endfunction\n  logic [7:0] nibble_result;\n  assign nibble_result = (|divisor_q[7:4]) ? {4'd0,dividend_mag_q[31:28]} :\n                         divide_nibble(dividend_mag_q[31:28],divisor_q[3:0]);\n'''+s[index:]\ns=s.replace('prefix_rem = 0;', \\\"prefix_rem = {4'd0, nibble_result[3:0]};\\\").replace('prefix_quot = dividend_mag_q[31:24];','prefix_quot = {dividend_mag_q[27:24], nibble_result[7:4]};').replace('j < 4','j < 2')\np.write_text(s)\nres=build('.',r,'fpga/core_bench_si.sv',1,base/'nibble-timing')\nprint(res)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
