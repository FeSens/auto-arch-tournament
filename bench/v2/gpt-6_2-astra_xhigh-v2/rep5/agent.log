{"type":"item.completed","item":{"id":"item_202","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/rtl/reg_file.sv && sed -n '125,172p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational ID read ports and two live fetch read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value to ID. Fetch reads the last committed write.\n//\n// Four independent read addresses infer replicas of the distributed RAM.\n// Only the shared written bits need reset. An unwritten register reads zero.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic [4:0]  fetch_rs1_addr,\n  input  logic [4:0]  fetch_rs2_addr,\n  output logic [31:0] fetch_rs1_data,\n  output logic [31:0] fetch_rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs [0:31];\n  logic [31:0] rs1_array, rs2_array;\n  logic [31:0] written;\n  logic write_word;\n\n  assign write_word = w_en && w_addr != 5'd0;\n\n  always_ff @(posedge clock) begin\n    if (write_word)\n      regs[w_addr] <= w_data;\n    if (reset)\n      written <= '0;\n    else if (write_word)\n      written[w_addr] <= 1'b1;\n  end\n\n  assign rs1_array = written[rs1_addr] ? regs[rs1_addr] : 32'b0;\n  assign rs2_array = written[rs2_addr] ? regs[rs2_addr] : 32'b0;\n  assign rs1_data = write_word && w_addr == rs1_addr ? w_data : rs1_array;\n  assign rs2_data = write_word && w_addr == rs2_addr ? w_data : rs2_array;\n  assign fetch_rs1_data = written[fetch_rs1_addr] ? regs[fetch_rs1_addr] : 32'b0;\n  assign fetch_rs2_data = written[fetch_rs2_addr] ? regs[fetch_rs2_addr] : 32'b0;\n\nendmodule\n  logic [19:2] direct_pc_q;\n  logic [31:2] other_pc_q;\n  logic direct_q;\n  assign pc_word = direct_q ? {12'b0, direct_pc_q} : other_pc_q;\n  assign pc = {pc_word, 2'b00};\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      direct_q   <= 1'b0;\n      other_pc_q <= '0;\n    end else if (redirect) begin\n      direct_q   <= 1'b0;\n      other_pc_q <= redirect_target;\n    end else if (issue) begin\n      direct_q   <= direct_taken;\n      other_pc_q <= jalr_taken ? {12'b0, rs1_data[19:2]} : pc_plus4[31:2];\n    end\n    if (issue) direct_pc_q <= direct_target[19:2];\n  end\n\n  assign imem_addr           = pc;\n  assign out.pc              = pc;\n  assign out.pc_plus4        = pc_plus4;\n  assign out.direct_target   = direct_target;\n  // An exact live prediction inside the window never needs recovery.\n  // Only a counter prediction can recover to fallthrough. A target\n  // outside the window always needs the full direct address in EX.\n  assign out.alternate_pc    = counter[1] && direct_target_ok ? pc_plus4[31:2] : direct_target[31:2];\n  assign out.counter         = counter;\n  assign out.predicted_taken = direct_taken || jalr_taken;\n  assign out.instr           = instr;\n  assign out.valid           = (imem_ready || hit) && !fence_in_ex;\nendmodule\n","exit_code":0,"status":"completed"}}
