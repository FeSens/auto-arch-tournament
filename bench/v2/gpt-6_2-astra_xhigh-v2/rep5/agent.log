{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/{hazard_unit,ex_stage,mem_stage}.sv'", "aggregated_output": "// Hold the pipeline behind a waiting memory operation or divide. A\n// load-use interlock holds the PC and inserts a single bubble into EX.\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] if_id_rs1,\n  input  logic [4:0] if_id_rs2,\n  input  logic       redirect,\n  input  logic       fetch_valid,\n  input  logic       dmem_ready,\n  input  logic       ex_mem_mem_op,\n  input  logic       div_wait,\n  output logic       stall_if,\n  output logic       stall_id,\n  output logic       flush_id,\n  output logic       stall_ex_mem,\n  output logic       hold_mem_wb\n);\n  logic load_use_hazard;\n\n  assign load_use_hazard = fetch_valid && id_ex_mem_read && id_ex_rd != 0 &&\n                           (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign stall_ex_mem = ex_mem_mem_op && !dmem_ready;\n  assign hold_mem_wb  = stall_ex_mem;\n  assign stall_id     = stall_ex_mem || div_wait;\n  assign stall_if     = stall_id || load_use_hazard || !fetch_valid;\n  assign flush_id     = redirect || load_use_hazard;\nendmodule\n// rtl/ex_stage.sv\n//\n// Execute stage. Bypass the adjacent producer when needed, run the ALU\n// and resolve branch targets. Owns the EX/MEM pipeline register.\n//\n// Latency:        9 EX cycles for DIV/REM, 1 for other instructions.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               fwd_rs1_sel,\n  input  logic               fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:2]        redirect_target,\n  output logic               train,\n  output logic [1:0]         train_counter\n);\n\n  // ── Opera\n…[8795 of 11867 chars elided by tools/bench/transcript.py; sha256:c45b1a70da6b563d]…\n──────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (hold_wb) begin\n      // The preceding instruction has already retired.\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.alu_result <= in.alu_result;\n      reg_q.read_data  <= load_data;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= dmem_rdata;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
