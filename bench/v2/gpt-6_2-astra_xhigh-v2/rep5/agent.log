{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/conftest.py; cat cores/bench/rtl/core_pkg.sv | tail -90'","aggregated_output":"\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n    logic [31:2] alternate_pc;\n    logic [1:0]  counter;\n    logic        predicted_taken;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] imm;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } id_ex_t;\n\n  // EX and MEM use the same byte lanes for an access and its retry.\n  function automatic logic mem_misaligned(input logic [1:0] width, offset);\n    mem_misaligned = (width == 2'd2 && offset != 0) || (width == 2'd1 && offset[0]);\n  endfunction\n\n  function automatic logic [3:0] mem_mask(input logic [1:0] width, offset);\n    case (width)\n      2'd0:    mem_mask = 4'b0001 << offset;\n      2'd1:    mem_mask = 4'b0011 << offset;\n      default: mem_mask = 4'b1111;\n    endcase\n  endfunction\n\n  function automatic logic [31:0] store_lanes(input logic [1:0] width,\n                                               input logic [31:0] data);\n    case (width)\n      2'd0:    store_lanes = {4{data[7:0]}};\n      2'd1:    store_lanes = {2{data[15:0]}};\n      default: store_lanes = data;\n    endcase\n  endfunction\n\n  function automatic logic [31:0] load_lanes(input logic [31:0] data,\n      input logic [1:0] width, offset, input logic sext);\n    logic [15:0] halfword;\n    logic [7:0] octet;\n    halfword = offset[1] ? data[31:16] : data[15:0];\n    octet = offset[0] ? halfword[15:8] : halfword[7:0];\n    case (width)\n      2'd0:    load_lanes = {{24{sext && octet[7]}}, octet};\n      2'd1:    load_lanes = {{16{sext && halfword[15]}}, halfword};\n      default: load_lanes = data;\n    endcase\n  endfunction\n\n  // EX/MEM register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;     // effective address for loads and stores\n    logic        early_done;     // accepted load or store\n    logic        early_load;\n    logic [31:0] early_rdata;    // raw word for RVFI\n    logic [31:0] early_result;   // extended value for the adjacent consumer\n    logic [31:0] write_data;     // raw rs2 (post-forward), pre byte replication\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;        // post-forward rs1 used by EX\n    logic [31:0] rs2_val;        // post-forward rs2 used by EX\n    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] rd_data;        // value written on the MEM completion edge\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n","exit_code":0,"status":"completed"}}
