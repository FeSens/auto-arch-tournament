{"type": "item.completed", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv && cat cores/bench/rtl/hazard_unit.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Bypass the adjacent producer when needed, run the ALU\n// and resolve branch targets. Owns the EX/MEM pipeline register.\n//\n// Latency:        9 EX cycles for DIV/REM, 1 for other instructions.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               fwd_rs1_sel,\n  input  logic               fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic [31:0]        ex_next_pc\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = fwd_rs1_sel ? fwd_ex_mem : in.rs1_val;\n  assign rs2 = fwd_rs2_sel ? fwd_ex_mem : in.rs2_val;\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  logic is_div, div_ready, div_start, div_valid, div_consume;\n  logic [31:0] div_result, div_rs1_q, div_rs2_q;\n\n  assign is_div = in.valid && (in.ctrl.alu_op == ALU_DIV  || in.ctrl.alu_op == ALU_DIVU ||\n                               in.ctrl.alu_op == ALU_REM  || in.ctrl.alu_op == ALU_REMU);\n  assign div_start = is_div && div_ready && !stall;\n  assign div_consume = div_valid && !stall;\n  assign div_wait = is_div && !div_valid;\n\n  // ID/EX holds the instruction throughout the divide. Forwarding sources\n  // can drain on the issue edge, so preserve the values EX actually used.\n  always_ff @(posedge clock) begin\n    if (div_start) begin\n      div_rs1_q <= rs1;\n      div_rs2_q <= rs2;\n    end\n  end\n\n  alu u_alu (\n   \n…[5279 of 8351 chars elided by tools/bench/transcript.py; sha256:50cae1d393e2ce44]…\n    // ID/EX register captures '0\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only\n);\n\n  logic load_use_hazard;\n  logic dmem_stall;\n\n  always_comb begin\n    load_use_hazard = id_ex_mem_read\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                   && (id_ex_rd != 5'b0);\n    // dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n    dmem_stall = !dmem_ready && ex_mem_mem_op;\n\n    flush_if      = !imem_ready;\n    // Insert a load-use bubble only when the load can advance out of EX.\n    stall_id      = dmem_stall || div_wait;\n    flush_id      = load_use_hazard && !stall_id;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // Clear MEM/WB valid during a dmem stall to retire and write WB once.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
