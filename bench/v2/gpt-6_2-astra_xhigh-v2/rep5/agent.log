{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c 'p=\"$TMPDIR/r6s1-bench-2am7678a\"\ncat > \"$p/dispatch.py\" <<'\"'PY'\nimport sys,shutil\nfrom pathlib import Path\np=Path(__file__).parent\nname=sys.argv[1]\nchain='chain' in name\nmerge='merge' in name\nqueues='queue' in name\nrtl=p/name/'rtl'\nshutil.copytree(p/'elastic/rtl',rtl)\ndef rd(n):return (rtl/n).read_text()\ndef wr(n,s):(rtl/n).write_text(s)\ns=rd('core.sv')\nold=s[s.index('  assign older_request'):s.index('  assign io_dmemAddr')]\nnew='''  logic port_early_q;\n  logic early_load;\n  assign older_request = (ex_mem_w.ctrl.mem_read || ex_mem_w.ctrl.mem_write) && \"'!port_early_q;\n  assign ex_request = port_early_q;\n  assign early_done = ex_request && (ex_ren || (|ex_wen)) && io_dmemReady;\n  assign early_load = early_done && id_ex_w.ctrl.mem_read;\n  assign pending_ex = (id_ex_w.ctrl.mem_read || id_ex_w.ctrl.mem_write) && !early_done;\n  always_ff @(posedge clock) begin\n    if (!stall_ex_mem)\n      port_addr <= pending_ex ? ex_addr : id_addr;\n    if (reset)\n      port_early_q <= 1'\"'b0;\n    else if (\"'!stall_ex_mem)\n      port_early_q <= !pending_ex && rs1_ready;\n  end\n'\"'''\n# If EX op was accepted and the following instruction has a busy base, MEM is done\n# regardless of port_early_q. Track pending separately.\nnew=new.replace(' && \"'!port_early_q;'\"', ' && \"'!ex_mem_w.early_done;'\"')\ns=s.replace(old,new)\ns=s.replace('ex_mem_w.early_done && ex_mem_w.ctrl.mem_read ? ex_mem_w.read_data', 'ex_mem_w.early_load ? ex_mem_w.read_data')\ns=s.replace('.early_done      (early_done),', '.early_done      (early_done),\\\\n    .early_load      (early_load),')\nif chain:\n # Select only EX ADD for the address-generation bypass. Both input values are forwarded.\n s=s.replace('  always_ff @(posedge clock) begin\\\\n    if (\"'!stall_ex_mem)'\"', '''  logic [31:0] add_result;\n  logic add_to_base, zero_disp;\n  assign zero_disp = if_id_w.instr[31:25] == 0 &&\n                 (if_id_w.instr[5] ? if_id_w.instr[11:7] == 0 : if_id_w.instr[24:20] == 0);\n  assign add_to_base = \"'!rs1_ready && zero_disp && id_ex_w.ctrl.alu_op == ALU_ADD &&\n                 !id_ex_w.ctrl.mem_read && !id_ex_w.ctrl.is_auipc;\n  always_ff @(posedge clock) begin\n    if (!stall_ex_mem)'\"''',1)\n s=s.replace('pending_ex ? ex_addr : id_addr','pending_ex ? ex_addr : add_to_base ? add_result : id_addr')\n s=s.replace('\"'!pending_ex && rs1_ready'\"','\"'!pending_ex && (rs1_ready || add_to_base)'\"')\n s=s.replace('    .ex_addr         (ex_addr),','    .ex_addr         (ex_addr),\\\\n    .add_result      (add_result),')\nif merge:\n s=s.replace('ex_mem_w.early_load ? ex_mem_w.read_data : ex_mem_w.alu_result','ex_mem_w.alu_result')\nif queues:\n s=s.replace('    if (\"'!stall_ex_mem)'\"\\\\n      port_addr <= pending_ex ? ex_addr : id_addr;','''    if (\"'!stall_ex_mem && !(ex_request && pending_ex))\n      port_addr <= pending_ex ? ex_addr : id_addr;'\"''')\nwr('core.sv',s)\ns=rd('ex_stage.sv')\ns=s.replace('  input logic early_done,','  input logic early_done, early_load,')\ns=s.replace('reg_q.early_done   <= early_done;', 'reg_q.early_done   <= early_done;\\\\n      reg_q.early_load <= early_load;')\nif chain:\n s=s.replace('  output logic [31:0] ex_addr,','  output logic [31:0] ex_addr, add_result,')\n s=s.replace('  assign ex_addr =', '  assign add_result = rs1 + alu_b;\\\\n  assign ex_addr =')\nif merge:\n s=s.replace('div_valid ? div_result : alu_result','early_load ? load_data : div_valid ? div_result : alu_result')\n s=s.replace('      reg_q.read_data    <= load_data;', '      reg_q.read_data    <= ex_addr;')\nwr('ex_stage.sv',s)\ns=rd('core_pkg.sv').replace('logic early_done;', 'logic early_done, early_load;')\nwr('core_pkg.sv',s)\nif merge:\n s=rd('mem_stage.sv')\n s=s.replace('  logic [31:0] wdata_rep;', '  logic [31:0] access_addr;\\\\n  assign access_addr = in.early_done ? in.read_data : in.alu_result;\\\\n  logic [31:0] w