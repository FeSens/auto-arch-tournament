{"type": "item.started", "item": {"id": "item_94", "type": "command_execution", "command": "/bin/bash -c \"cat >/srv/hwebench/tmp/19d02a47/4b8b66bd/bench-micro-lSj4CZ/bypass.py <<'PY'\nfrom pathlib import Path\nimport shutil\nd=Path(__file__).parent\nfor name in ('localbase','localordinary','splitbase','splitordinary','exactpc','localtiny','latebase','deferfill'):\n t=d/name\n shutil.copytree(d/'direct4' if name=='localtiny' else d/'pagetag',t)\n if name=='exactpc': # Select the fallback address after ID/EX, preserving the two candidates.\n    p=t/'if_stage.sv'\n    p.write_text(p.read_text().replace('direct_taken ? pc_plus4[31:2] : direct_target[31:2];','direct_target[31:2];'))\n    p=t/'ex_stage.sv'\n    p.write_text(p.read_text().replace('jalr_sum[31:2] : in.alternate_pc;', 'jalr_sum[31:2] : in.predicted_taken ? in.pc_plus4[31:2] : in.alternate_pc;'))\n    continue\n if name=='deferfill':\n    p=t/'load_predictor.sv';s=p.read_text()\n    s=s.replace('  assign write_row = scrub[10] ? mem_addr[11:2] : scrub[9:0];','''  logic [31:0] wdata_q;\n  logic [19:2] waddr_q;\n  logic valid_q, write_q;\n  always_ff @(posedge clock) begin\n    wdata_q <= mem_read ? mem_rdata : mem_wdata;\n    waddr_q <= mem_addr[19:2];\n    valid_q <= valid_word;\n    write_q <= \"'!reset && scrub[10] && update_word;\n  end\n  assign write_row = scrub[10] ? waddr_q[11:2] : scrub[9:0];'\"''')\n    s=s.replace(\\\"if (\"'!scrub[10] || update_word)'\"\\\\n      words[write_row] <= {scrub[10] && valid_word, mem_addr[19:12],\\\\n                           mem_read ? mem_rdata : mem_wdata};\\\",\\\"if (\"'!scrub[10] || write_q)'\"\\\\n      words[write_row] <= {scrub[10] && valid_q, waddr_q[19:12], wdata_q};\\\")\n    s=s.replace('      update_q <= update_word;', '      update_q <= update_word;\\\\n      collision_q <= write_q && waddr_q[11:2] == read_row;')\n    s=s.replace('  logic update_q;','  logic update_q, collision_q;')\n    s=s.replace('assign eligible = probe_ok_q','assign eligible = \"'!collision_q && probe_ok_q'\"')\n    p.write_text(s);continue\n p=t/'core.sv';s=p.read_text()\n a=s.index('  logic [1:0] load_offset;')\n b=s.index('  load_predictor',a)\n s=s[:b]+'''  logic mem_matches_base, waiting_base;\n  logic [31:0] fast_mem_value;\n  assign mem_matches_base = mem_bypass_en && ex_mem_w.rd == rs1_addr_w;\n  assign waiting_base = ex_mem_w.ctrl.mem_read && \"'!ex_mem_w.load_hit;\n  assign fast_mem_value = ex_mem_w.alu_result;\n'\"'''+s[b:]\n s=s.replace('.base            (id_rs1_data)', '.base            (mem_matches_base ? fast_mem_value : fetch_rs1_data)').replace('.base_ready      (rs1_ex_ready)', '.base_ready      (rs1_ex_ready && \"'!(waiting_base && mem_matches_base))'\"')\n if 'ordinary' in name:\n    s=s.replace('assign waiting_base = ex_mem_w.ctrl.mem_read && \"'!ex_mem_w.load_hit;'\"', '''assign waiting_base = (ex_mem_w.ctrl.mem_read && \"'!ex_mem_w.load_hit) ||\n                        ex_mem_w.ctrl.alu_op == ALU_MUL || ex_mem_w.ctrl.alu_op == ALU_MULH ||\n                        ex_mem_w.ctrl.alu_op == ALU_MULHSU || ex_mem_w.ctrl.alu_op == ALU_MULHU;'\"''')\n    s=s.replace('  assign fast_mem_value = ex_mem_w.alu_result;','')\n    s=s.replace('    .capture_operands(\"'!stall_id),'\"', '    .capture_operands(\"'!stall_id),'\"\\\\n    .ordinary_base(fast_mem_value),')\n    ep=t/'ex_stage.sv';txt=ep.read_text().replace('  output logic [11:0]        actual_low,','  output logic [31:0]        ordinary_base,\\\\n  output logic [11:0]        actual_low,').replace('  assign actual_low =','  assign ordinary_base = reg_q.alu_result;\\\\n  assign actual_low =')\n    ep.write_text(txt)\n if 'split' in name or name=='latebase':\n    s=s.replace('.base            (mem_matches_base ? fast_mem_value : fetch_rs1_data)', '.rf_base         (fetch_rs1_data),\\\\n    .mem_base        (fast_mem_value),\\\\n    .from_mem        (mem_matches_base)')\n    p2=t/'load_predictor.sv';z=p2.read_text()\n    z=z.replace('  input  logic [31:0]  base,','  input logic [31:0] rf_base, mem_base,\\\\n  input logic from_mem,')\n    z=z.replace('  logic [12:0] low_sum;', '  logic [31:0] base;\\\\n  logic [12:0] low_sum;\\\\n  logic [12:0] mem_sum, rf_sum;\\\\n  assign base = from_mem ? mem_base : rf_base;')\n    z=z.replace(\\\"  assign low_sum = {1'b0,base[11:0]} + {1'b0,i_imm};\\\", \\\"\\\"\\\"  assign mem_sum = {1'b0,mem_base[11:0]} + {1'b0,i_imm};\n  assign rf_sum  = {1'b0,rf_base[11:0]} + {1'b0,i_imm};\n  assign low_sum = from_mem ? mem_sum : rf_sum;\\\"\\\"\\\")\n    if name=='latebase':\n       z=z.replace('  logic probe_ok_q;', '''  logic probe_ok_q, from_mem_q;\n  logic [7:0] mem_page_q, rf_page_q;\n  logic mem_ok_q, rf_ok_q, sign_q, mem_carry_q, rf_carry_q;''').replace('      probe_ok_q <= base_ready && base[31:20] == 0 && low_sum[12] == i_imm[11];\\\\n      page_q <= base[19:12];','''      probe_ok_q <= base_ready;\n      from_mem_q <= from_mem;\n      mem_page_q <= mem_base[19:12];\n      rf_page_q <= rf_base[19:12];\n      mem_ok_q <= mem_base[31:20] == 0;\n      rf_ok_q <= rf_base[31:20] == 0;\n      sign_q <= i_imm[11];\n      mem_carry_q <= mem_sum[12];\n      rf_carry_q <= rf_sum[12];''').replace('  assign probe_offset','''  assign page_q = from_mem_q ? mem_page_q : rf_page_q;\n  wire address_ok = from_mem_q ? (mem_ok_q && mem_carry_q == sign_q) : (rf_ok_q && rf_carry_q == sign_q);\n  assign probe_offset''').replace('assign eligible = probe_ok_q', 'assign eligible = address_ok && probe_ok_q')\n    p2.write_text(z)\n p.write_text(s)\nPY\npython /srv/hwebench/tmp/19d02a47/4b8b66bd/bench-micro-lSj4CZ/bypass.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
