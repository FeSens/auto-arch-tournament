{"type":"item.completed","item":{"id":"item_194","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv'","aggregated_output":"// rtl/forward_unit.sv\n//\n// Compare the adjacent producer in EX with each source in ID. The match\n// travels with the consumer, qualified by the result that EX will produce.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       capture_operands,\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic       id_ex_w_en,\n  output logic       fwd_rs1,\n  output logic       fwd_rs2\n);\n\n  always_ff @(posedge clock) begin\n    if (capture_operands) begin\n      fwd_rs1 <= id_ex_w_en && id_ex_rd != 5'd0 && id_ex_rd == id_rs1;\n      fwd_rs2 <= id_ex_w_en && id_ex_rd != 5'd0 && id_ex_rd == id_rs2;\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
