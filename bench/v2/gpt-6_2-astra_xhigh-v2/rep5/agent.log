{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -c 'mkdir \"$TMPDIR/r14exp/cfex\"\ncp -r \"$TMPDIR/r14exp/control/rtl\" \"$TMPDIR/r14exp/cfex/rtl\"\npython - <<'\"'PY'\nimport os\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'r14exp/cfex/rtl'\nf=p/'ex_stage.sv';s=f.read_text();a=s.index('  // ── Branch resolve');b=s.index('  ctrl_t ctrl_with_trap;',a)\nt=s[a:b].replace('rs1','br_a').replace('rs2','br_b')\ns=s[:a]+'''  wire [31:0] br_a = rs1_ordinary_q ? reg_q.alu_result : in.rs1_val;\n  wire [31:0] br_b = rs2_ordinary_q ? reg_q.alu_result : in.rs2_val;\n'''+t+s[b:]\nf.write_text(s)\nf=p/'core.sv';s=f.read_text()\na=s.index('  hazard_unit u_hazard')\ns=s[:a]+'''  wire mul_writer = id_ex_w.ctrl.alu_op == ALU_MUL || id_ex_w.ctrl.alu_op == ALU_MULH ||\n                    id_ex_w.ctrl.alu_op == ALU_MULHU || id_ex_w.ctrl.alu_op == ALU_MULHSU;\n  wire cf_dep = (if_id_w.instr[6:0] == 7'h63 && (rs1_match_ex || rs2_match_ex)) ||\n                (if_id_w.instr[6:0] == 7'h67 && rs1_match_ex);\n'''+s[a:];s=s.replace('.id_ex_mem_read (id_ex_w.ctrl.mem_read && \"'!load_hit)'\"', '.id_ex_mem_read ((id_ex_w.ctrl.mem_read && \"'!load_hit) || (id_ex_w.valid && mul_writer && cf_dep))'\"')\nf.write_text(s)\nPY\npython - <<'PY'\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\np=Path(os.environ[\\\"TMPDIR\\\"])/\\\"r14exp/cfex\\\"\nprint(build(\\\".\\\",p/\\\"rtl\\\",\\\"fpga/core_bench_si.sv\\\",1,p/\\\"p1\\\"),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
