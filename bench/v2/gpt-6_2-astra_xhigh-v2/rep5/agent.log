_load_value_q),''')\n t=t.replace('  input logic [31:0] access_addr,','''  input logic early,\n  input logic [31:0] early_value, raw_q,\n  input logic [31:0] access_addr,''').replace('reg_q.read_data  <= load_data;', 'reg_q.read_data  <= early ? early_value : load_data;').replace('reg_q.mem_rdata  <= dmem_rdata;', 'reg_q.mem_rdata  <= early ? raw_q : dmem_rdata;').replace('assign bypass_data = in.ctrl.mem_to_reg ? load_data : in.alu_result;', 'assign bypass_data = in.ctrl.mem_to_reg ? (early ? early_value : load_data) : in.alu_result;')\nif 'chain' in cfg or 'zero' in cfg:\n test=\\\"(if_id_w.instr[31:20] == 0)\\\" if 'zero' in cfg else \\\"1'b1\\\"\n ea=\\\"io_dmemRData\\\" if 'zero' in cfg else \\\"(io_dmemRData + {{20{if_id_w.instr[31]}},if_id_w.instr[31:20]})\\\"\n s=s.replace('  always_ff @(posedge clock)\\\\n    if (\"'!stall_id) addr_ready_q <= rs1_ready;'\"',f'''  logic chain_base;\n  assign chain_base = completed && id_ex_w.ctrl.mem_width == 2 && (id_ex_w.rd == rs1_addr_w) && (rs1_addr_w \"'!= 0) && {test};\n  always_ff @(posedge clock)\n    if (!stall_id) addr_ready_q <= rs1_ready || chain_base;'\"''')\n s=s.replace('normal_addr : decode_addr;',f'normal_addr : chain_base ? {ea} : decode_addr;')\nif 'merge' in cfg:\n # Collapse early-data forwarding and MEM/ID bypass around identical data mux\n s=s.replace('.early_value (early_load_value_q),','.early_value (fwd_result),')\n t=t.replace('assign bypass_data = in.ctrl.mem_to_reg ? (early ? early_value : load_data) : in.alu_result;', 'assign bypass_data = in.ctrl.mem_to_reg && \"'!early ? load_data : early_value;'\"')\n # early_value equals integer ALU result on a nonload; din for writes.\nif 'shared' in cfg:\n # Put one memory response extractor on the physical port, driven by saved\n # width and sign from the instruction owning the bus, captured with address.\n s=s.replace('  assign shalf =', '''  logic [1:0] port_width;\n  logic port_sign;\n  always_ff @(posedge clock)\n    if (\"'!stall_ex_mem) begin\n     