{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'date -u && cat cores/bench/rtl/load_predictor.sv'","aggregated_output":"Sun Nov 22 09:11:19 UTC 2026\n// Probe one word in ID and verify its page from the same base in EX.\nmodule load_predictor (\n  input  logic         clock,\n  input  logic         reset,\n  input  logic         capture,\n  input  logic [31:0]  rf_base,\n  input  logic [31:0]  mem_base,\n  input  logic         select_mem,\n  input  logic [11:0]  i_imm,\n  input  logic         base_ready,\n  input  logic [31:0]  mem_addr,\n  input  logic         mem_read,\n  input  logic [3:0]   mem_wen,\n  input  logic         mem_ready,\n  input  logic [31:0]  mem_rdata,\n  input  logic [31:0]  mem_wdata,\n  output logic [31:0]  data,\n  output logic [1:0]   byte_offset,\n  output logic         page_match\n);\n  typedef struct packed {\n    logic        in_ram;\n    logic [7:0]  page;\n    logic        carry;\n  } base_page_t;\n  base_page_t rf_page_q, mem_page_q, selected_page;\n  logic [12:0] rf_sum, mem_sum;\n  logic [11:0] selected_low;\n  logic select_mem_q, imm_sign_q;\n\n  assign rf_sum = {1'b0, rf_base[11:0]} + {1'b0, i_imm};\n  assign mem_sum = {1'b0, mem_base[11:0]} + {1'b0, i_imm};\n  assign selected_low = select_mem ? mem_sum[11:0] : rf_sum[11:0];\n\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      rf_page_q    <= {rf_base[31:20] == 0, rf_base[19:12], rf_sum[12]};\n      mem_page_q   <= {mem_base[31:20] == 0, mem_base[19:12], mem_sum[12]};\n      select_mem_q <= select_mem;\n      imm_sign_q   <= i_imm[11];\n      byte_offset  <= selected_low[1:0];\n    end\n  end\n  assign selected_page = select_mem_q ? mem_page_q : rf_page_q;\n\n  (* syn_ramstyle = \"block_ram\" *) logic [40:0] words [0:1023];\n  logic valid_q;\n  logic [7:0] tag_q;\n  logic [10:0] scrub;\n  logic [9:0] write_row;\n  logic mem_store, in_ram, update_word, valid_word, probe_ready_q;\n  logic [9:0] read_row_q, write_row_q;\n  logic update_q;\n\n  assign mem_store = |mem_wen;\n  assign in_ram = mem_addr[31:20] == 0;\n  assign update_word = mem_ready && ((mem_read && in_ram) || mem_store);\n  assign valid_word = in_ram && (mem_read || (mem_wen == 4'b1111 && mem_addr[1:0] == 0));\n  assign write_row = scrub[10] ? mem_addr[11:2] : scrub[9:0];\n\n  // Both the scrub and normal updates use the block RAM's one write port.\n  always_ff @(posedge clock) begin\n    if (!scrub[10] || update_word)\n      words[write_row] <= {scrub[10] && valid_word, mem_addr[19:12],\n                           mem_read ? mem_rdata : mem_wdata};\n    // Carry the port addresses alongside the word so the collision\n    // comparison runs in EX, after ID's register-file read and address adder.\n    if (capture) begin\n      {valid_q, tag_q, data} <= words[selected_low[11:2]];\n      read_row_q <= selected_low[11:2];\n      write_row_q <= mem_addr[11:2];\n      update_q <= update_word;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      scrub <= '0;\n      probe_ready_q <= 1'b0;\n    end else begin\n      if (!scrub[10]) scrub <= scrub + 11'd1;\n      if (capture)\n        probe_ready_q <= scrub[10] && base_ready;\n    end\n  end\n\n  // Reject an undefined read-during-write result, and a candidate sampled\n  // before an older store entered MEM. A stalled store keeps the veto live.\n  // Above bit 11 a signed displacement adds either zero or -1, plus\n  // the low addition's carry. Equal carry and sign preserve the base page.\n  assign page_match = probe_ready_q && valid_q && selected_page.in_ram &&\n                      selected_page.carry == imm_sign_q && selected_page.page == tag_q &&\n                      !(update_q && write_row_q == read_row_q) &&\n                      !(mem_store && mem_addr[11:2] == read_row_q);\nendmodule\n","exit_code":0,"status":"completed"}}
