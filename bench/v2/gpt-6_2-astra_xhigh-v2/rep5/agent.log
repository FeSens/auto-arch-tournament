{"type":"item.completed","item":{"id":"item_99","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/imm_gen.sv'","aggregated_output":"// rtl/imm_gen.sv\n//\n// RV32I immediate generator. Sign-extends I/S/B/J immediates, zero-fills\n// the low bits of U immediates. Opcodes that don't carry an immediate\n// (R-type, FENCE, etc.) emit 0.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds the EX-stage immediate path (rd_wdata for ADDI,\n//                 mem_addr for LOAD/STORE, pc_wdata for branches/jumps).\nmodule imm_gen (\n  input  logic [31:0] instr,\n  output logic [31:0] imm\n);\n\n  logic [6:0] opcode;\n\n  always_comb begin\n    opcode = instr[6:0];\n    case (opcode)\n      // I-type: LOAD, OP-IMM, JALR, SYSTEM.\n      7'b0000011, 7'b0010011, 7'b1100111, 7'b1110011:\n        imm = {{20{instr[31]}}, instr[31:20]};\n      // S-type: STORE.\n      7'b0100011:\n        imm = {{20{instr[31]}}, instr[31:25], instr[11:7]};\n      // B-type: BRANCH (bit 0 implicit zero).\n      7'b1100011:\n        imm = {{19{instr[31]}}, instr[31], instr[7],\n               instr[30:25], instr[11:8], 1'b0};\n      // U-type: LUI, AUIPC (low 12 bits zero).\n      7'b0110111, 7'b0010111:\n        imm = {instr[31:12], 12'b0};\n      // J-type: JAL (bit 0 implicit zero).\n      7'b1101111:\n        imm = {{11{instr[31]}}, instr[31], instr[19:12],\n               instr[20], instr[30:21], 1'b0};\n      default:\n        imm = 32'b0;\n    endcase\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_100", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Bypass the adjacent producer when needed, run the ALU\n// and resolve branch targets. Owns the EX/MEM pipeline register.\n//\n// Latency:        9 EX cycles for DIV/REM, 1 for other instructions.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               fwd_rs1_sel,\n  input  logic               fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,\n  input  logic               early_done,\n  input  logic [31:0]        dmem_rdata,\n  output logic               early_eligible,\n  output logic               mem_pending,\n  output logic [31:0]        mem_addr,\n  output logic [31:0]        early_wdata,\n  output logic [3:0]         early_lanes,\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:2]        redirect_target,\n  output logic               train,\n  output logic [1:0]         train_counter\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = fwd_rs1_sel ? fwd_ex_mem : in.rs1_val;\n  assign rs2 = fwd_rs2_sel ? fwd_ex_mem : in.rs2_val;\n\n  // The forwarded address also covers a base that was still busy in ID.\n  assign mem_addr = rs1 + in.imm;\n  assign mem_pending = (in.ctrl.mem_read || in.ctrl.mem_write) && !early_done\n                       && mem_aligned(in.ctrl.mem_width, mem_addr[1:0]);\n  assign early_eligible = in.valid && in.base_ready && in.early_addr[31:20] == 0\n                          && mem_aligned(in.ctrl.mem_width, in.early_addr[1:0]);\n  assign early_lanes = mem_lanes(in.ctrl.mem_width, in.early_addr[1:0]);\n  assign early_wdata = store_word(in.ctrl.mem_width, rs2);\n\n  // ── ALU operand selection ────────────────────────\n…[3496 of 6568 chars elided by tools/bench/transcript.py; sha256:bec560005deaa989]…\n    reg_q.mem_addr      <= mem_addr;\n      reg_q.early_done    <= early_done;\n      reg_q.early_rdata   <= dmem_rdata;\n      reg_q.early_load    <= load_value(in.ctrl.mem_width, in.early_addr[1:0],\n                                        in.ctrl.mem_sext, dmem_rdata);\n      reg_q.write_data    <= early_wdata;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_valid ? div_rs1_q : rs1;\n      reg_q.rs2_val       <= div_valid ? div_rs2_q : rs2;\n      reg_q.pc_next       <= actual_taken ? target : in.pc_plus4;\n      reg_q.instr         <= in.instr;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q.ctrl  <= '0;\n      reg_q.valid <= 1'b0;\n      reg_q.mem_pending <= 1'b0;\n    end else if (!stall) begin\n      reg_q.ctrl  <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.valid <= in.valid && !div_wait;\n      reg_q.mem_pending <= mem_pending;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv'","aggregated_output":"// rtl/forward_unit.sv\n//\n// Compare the adjacent producer in EX with each source in ID. The match\n// travels with the consumer. A producer that traps in EX clears reg_write\n// before reaching EX/MEM, leaving the older value captured in ID available.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       capture_operands,\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic       ex_mem_w_en,\n  output logic       fwd_rs1,\n  output logic       fwd_rs2\n);\n\n  logic rs1_match_q, rs2_match_q;\n\n  always_ff @(posedge clock) begin\n    if (capture_operands) begin\n      rs1_match_q <= id_ex_rd != 5'd0 && id_ex_rd == id_rs1;\n      rs2_match_q <= id_ex_rd != 5'd0 && id_ex_rd == id_rs2;\n    end\n  end\n\n  assign fwd_rs1 = rs1_match_q && ex_mem_w_en;\n  assign fwd_rs2 = rs2_match_q && ex_mem_w_en;\n\nendmodule\n","exit_code":0,"status":"completed"}}
