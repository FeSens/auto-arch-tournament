{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '81,210p;886,1146p;1185,1308p;1398,1445p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready=None,\n               imem_ready=None, fetches=None, initial_fetch_wait=0, shared_memory=False):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    An optional dmem_ready(addr, ren, wen) selects which requests are accepted.\n    Accepted stores update the Python-side dmem dict.\n    fetches records every address presented to imem, including held PCs.\n    A stalled imem drives an unrelated word. shared_memory makes completed\n    stores visible to instruction fetch starting on the following cycle.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = imem if shared_memory else {}\n    dmem.update(dmem_init or {})\n    retirements: list[dict] = []\n\n    def drive_fetch(pc):\n        if fetches is not None:\n            fetches.append(pc)\n        ready = imem_ready(pc) if imem_ready else True\n        dut.io_imemReady.value = int(ready)\n        dut.io_imemData.value = imem.get(pc & ~3, EBREAK()) if ready else 0xFFFFFFFF\n\n    clock = Clock(dut.clock, 10, \"ns\")\n    clock.start()\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 0\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Replay tests let the power-on scrub finish before issuing the program.\n    dut.reset.value = 0\n    if initial_fetch_wait:\n        await ClockCycles(dut.clock, initial_fetch_wait)\n    drive_fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n       \n…[17660 of 20732 chars elided by tools/bench/transcript.py; sha256:29054d52ee0825b0]…\nC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"radix4_path.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\",\n            \"hazard_unit.sv\", \"load_predictor.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
