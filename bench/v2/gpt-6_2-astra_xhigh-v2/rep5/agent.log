ence_at': i,\n            'insn': hex(ref['insn']), 'pc': hex(ref['pc']),\n            'field': field, 'expected': hex(expected), 'got': hex(got)}\n\ndef compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\n            ref_reason=None, sim_returncode=0, sim_stderr=''):\n    for i, (ref, sim) in enumerate(zip(ref_trace, sim_trace)):\n        # Direct-equality RVFI fields. trap/halt/intr/mode/ixl are included\n    \n…[5456 of 8528 chars elided by tools/bench/transcript.py; sha256:e3635bf3fed511a3]…\nst + coremark ELFs\"\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n113:\tpython3 -m tools.eval.cosim . $(TARGET)\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n116:\tbash test/cosim/build.sh\n137:fpga: cosim-build bench/programs/coremark.elf\n143:bench/programs/coremark.elf: bench/programs/Makefile bench/programs/crt0.S \\\n144:                              $(wildcard bench/programs/coremark/*.c) \\\n145:                              $(wildcard bench/programs/coremark/*.h) \\\n146:                              $(wildcard bench/programs/coremark/baremetal/*.c) \\\n147:                              $(wildcard bench/programs/coremark/baremetal/*.h)\n148:\t$(MAKE) -f bench/programs/Makefile bench/programs/coremark.elf\n178:\trm -rf test/cosim/sim_build sim_build out\ncpython-3.13-linux-x86_64-gnu\ncpython-3.13.12-linux-x86_64-gnu\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n_helpers.py\nconftest.py\ntest_alu.py\ntest_decoder.py\ntest_imm_gen.py\ntest_pipeline.py\ntest_reg_file.py\n", "exit_code": 0, "status": "completed"}}
