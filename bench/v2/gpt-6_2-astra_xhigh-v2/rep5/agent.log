1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[8065 of 11137 chars elided by tools/bench/transcript.py; sha256:4848c8baffd9c957]…\nets)\n    assert requests == [0x42] * 4\n    base, load, add, _ = rets\n    assert load[\"cycle\"] == base[\"cycle\"] + 4  # three wait cycles\n    assert add[\"cycle\"] == load[\"cycle\"] + 2   # one load-use bubble\n    assert (load[\"mem_addr\"], load[\"mem_rmask\"]) == (0x40, 0b0100)\n    assert (load[\"rs1_addr\"], load[\"rs1_rdata\"]) == (1, 0x41)\n    assert (load[\"rd\"], load[\"rd_wdata\"]) == (5, 0xFFFFFF81)\n    assert (add[\"rs1_addr\"], add[\"rs1_rdata\"]) == (5, 0xFFFFFF81)\n    assert (add[\"rs2_addr\"], add[\"rs2_rdata\"]) == (5, 0xFFFFFF81)\n    assert (add[\"rd\"], add[\"rd_wdata\"]) == (6, 0xFFFFFF02)\n\n\n@cocotb.test()\nasync def held_ex_operands_and_matches(dut):\n    # The first ADD has its WB and MEM operands when the load stalls. The\n    # waiting second ADD has different operands and matches the first ADD's\n    # destination on both sources throughout the stall.\n    program = [\n        ADDI(1, 0, 21), ADDI(2, 0, 34), LW(3, 0, 0x40),\n        ADD(4, 1, 2), ADD(5, 4, 4), EBREAK(),\n    ]\n    waits = 3\n\n    def ready(addr, ren, wen):\n", "exit_code": 0, "status": "completed"}}
