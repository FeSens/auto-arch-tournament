LAUDE.md invariant 1 for the full contract.\n  output logic        io_rvfi_valid_0,\n  output logic [63:0] io_rvfi_order_0,\n  output logic [31:0] io_rvfi_insn_0,\n  output logic        io_rvfi_trap_0,\n  output logic        io_rvfi_halt_0,\n  output logic        io_rvfi_intr_0,\n  output logic [1:0]  io_rvfi_mode_0,\n  output logic [1:0]  io_rvfi_ixl_0,\n  output logic [4:0]\n…[2297 of 5369 chars elided by tools/bench/transcript.py; sha256:ba6c610b5d7f03dc]…\npredicts taken\n949:    # Start after the counter reset sweep. The first BLT predicts fallthrough,\n950:    # the next two predict the loop body, and the third actually exits.\n988:async def replay_loop_through_load_use_and_exit(dut):\n1006:        # needed to replay both words across the back edge.\n1036:async def replay_word_filled_from_a_different_path(dut):\n1040:    # default P+8 probe can already replay Q from the destination RAM.\n1219:    # Second call sees a changed live word despite a matching prediction.\n1220:    # Third call must wait for the second patch even after replay is enabled.\n1234:async def aliased_counter_and_prediction_guards(dut):\n1236:    # warms it for a busy BEQ whose older MEM value would predict fallthrough.\n1264:async def predicted_and_recovered_jumps(dut):\n1271:        ADDI(7, 4, 1), JALR(8, 9, 0), store, EBREAK(), # ready odd base predicts 68\n1403:            \"alu.sv\", \"radix4_path.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n1406:            \"hazard_unit.sv\", \"load_predictor.sv\",\n", "exit_code": 0, "status": "completed"}}
