{"type": "item.completed", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c \"head -6 cores/bench/test/test_alu.py; tail -50 cores/bench/test/test_alu.py; cat cores/bench/test/_helpers.py | head -100; rg -n -i 'errors|warn' \\\"\"'$TMPDIR/recip/gowin_p1/gw.log\" | tail -9'", "aggregated_output": "\"\"\"Check the integer ALU, registered product and clocked DIV/REM interface.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\n            else:\n                q, r = -1, x\n            await _check_div(dut, op, a, b, r if op in (ALU_REM, ALU_REMU) else q)\n\n\n@cocotb.test()\nasync def radix4_digit_boundaries(dut):\n    await _setup(dut)\n    # 3D is 0x1_00000002 here. Its low word alone equals the dividend.\n    pairs = [(2, 0x55555556)]\n    for divisor in (7, 255, 256, 257, 0x40000001, 0x55555555, 0x55555556, 0x80000001, MASK32):\n        for digit in (1, 2, 3):\n            for delta in (-1, 0, 1):\n                dividend = digit * divisor + delta\n                if dividend <= MASK32:\n                    pairs.append((dividend, divisor))\n    for a, b in pairs:\n        quotient, remainder = divmod(a, b)\n        await _check_div(dut, ALU_DIVU, a, b, quotient)\n        await _check_div(dut, ALU_REMU, a, b, remainder)\n\n\n@cocotb.test()\nasync def reset_cancels_division(dut):\n    await _setup(dut)\n    # Reset in PREP (0 clocks after issue), each RUN cycle (1..6), and DONE (7).\n    for cycles_after_issue in range(8):\n        dut.op.value = ALU_DIV\n        dut.a.value = 123\n        dut.b.value = 3\n        dut.div_start.value = 1\n        await _tick(dut)\n        dut.div_start.value = 0\n        for _ in range(cycles_after_issue):\n            assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n            await _tick(dut)\n        assert not int(dut.div_ready.value)\n        assert int(dut.div_valid.value) == (cycles_after_issue == 7)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _check_div(dut, ALU_REMU, 27, 4, 3)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"radix4_path.sv\"],\n               test_module=\"test_alu\")\n\"\"\"Shared cocotb constants and\n…[1290 of 4362 chars elided by tools/bench/transcript.py; sha256:c831cf4fa2cc208a]…\ntters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n80:WARN  (NL0002) : The module \"hazard_unit\" instantiated to \"u_hazard\" is swept in optimizing(\"/srv/hwebench/tmp/19d02a47/f7432493/recip/rtl/core.sv\":268)\n81:WARN  (NL0002) : The module \"decoder\" instantiated to \"u_decoder\" is swept in optimizing(\"/srv/hwebench/tmp/19d02a47/f7432493/recip/rtl/id_stage.sv\":55)\n99:WARN  (PR1014) : Generic routing resource will be used to clock signal 'clock_d' by the specified constraint. And then it may lead to the excessive delay or skew\n", "exit_code": 0, "status": "completed"}}
