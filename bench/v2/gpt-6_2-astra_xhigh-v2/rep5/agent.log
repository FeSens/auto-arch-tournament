{"type": "item.completed", "item": {"id": "item_104", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/mem_stage.sv'", "aggregated_output": "// rtl/mem_stage.sv\n//\n// Finish outstanding accesses and carry the accepted transaction into MEM/WB.\n//\n// Byte-lane discipline:\n//   - Write data is replicated across all four byte lanes; the\n//     byte-mask (mem_wmask) selects the actual destination bytes.\n//   - Load: shift the raw word right by `addr[1:0]*8`, then sign- or\n//     zero-extend the low 8/16 bits per the LB/LBU/LH/LHU encoding.\n//   - For RVFI ALIGNED_MEM, mem_addr is reported word-aligned and the\n//     byte position is captured in mem_rmask / mem_wmask.\n//\n// Latency:        1 cycle (MEM/WB register clocked here).\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata via the loaded-data path.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // A dmem stall inserts a bubble at retirement and holds ID's operands.\n  input  logic               hold_wb,\n  input  ex_mem_t  in,\n  output logic [31:0]        fwd_ex_mem,\n  // dmem interface\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  // Decode samples this bypass when the pipeline advances.\n  output logic               bypass_en,\n  output logic [31:0]        bypass_data,\n  // MEM/WB register output\n  output mem_wb_t  out\n);\n\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  logic [31:0] mem_load;\n\n  // Misaligned mem-access trap. RV32I requires word-aligned LW/SW and\n  // halfword-aligned LH/LHU/SH; byte ops are always aligned.\n  // riscv-formal's RISCV_FORMAL_ALIGNED_MEM contract demands rvfi_trap=1\n  // when the effective byte address is not aligned to the access width.\n  // On trap, the dmem ports are gated off and ctrl propagates is_illegal.\n  logic mem_misalign;\n  logic mem_op;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    byte_mask = mem_lanes(in.ctrl.mem_width, in.mem_addr[1:0]);\n    mem_op       = in.ctrl.mem_read || in.ctrl.mem_write;\n    mem_misalign = mem_op && !(in.mem_pending || in.early_done);\n\n    ctrl_with_trap = in.ctrl;\n    if (mem_misalign) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n\n    // Combinational dmem outputs — gated off on misalign.\n    dmem_wdata = in.write_data;\n    dmem_wen   = (in.ctrl.mem_write && in.mem_pending) ? byte_mask : 4'b0000;\n    dmem_ren   = in.ctrl.mem_read && in.mem_pending;\n    mem_load   = load_value(in.ctrl.mem_width, in.mem_addr[1:0], in.ctrl.mem_sext, dmem_rdata);\n\n    // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n    aligned_addr = (mem_op && !mem_misalign)\n                 ? {in.mem_addr[31:2], 2'b00}\n                 : 32'b0;\n  end\n\n  assign bypass_en   = in.valid && in.rd != 5'd0 && ctrl_with_trap.reg_write;\n  assign fwd_ex_mem  = in.early_done ? in.early_load : in.alu_result;\n  assign bypass_data = dmem_ren ? mem_load : fwd_ex_mem;\n\n  // ── MEM/WB register ───────────────────────────────────────────────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (hold_wb) begin\n      // The preceding instruction has already retired.\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.rd_data    <= bypass_data;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= in.early_done ? in.early_rdata : dmem_rdata;\n      reg_q.mem_wdata  <= in.write_data;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/hazard_unit.sv'","aggregated_output":"// Hold the pipeline behind a waiting memory operation or divide. A\n// load-use interlock holds the PC and inserts a single bubble into EX.\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] if_id_rs1,\n  input  logic [4:0] if_id_rs2,\n  input  logic       redirect,\n  input  logic       imem_ready,\n  input  logic       dmem_ready,\n  input  logic       ex_mem_mem_op,\n  input  logic       div_wait,\n  output logic       stall_if,\n  output logic       stall_id,\n  output logic       flush_id,\n  output logic       stall_ex_mem,\n  output logic       hold_mem_wb\n);\n  logic load_use_hazard;\n\n  assign load_use_hazard = imem_ready && id_ex_mem_read && id_ex_rd != 0 &&\n                           (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign stall_ex_mem = ex_mem_mem_op && !dmem_ready;\n  assign hold_mem_wb  = stall_ex_mem;\n  assign stall_id     = stall_ex_mem || div_wait;\n  assign stall_if     = stall_id || load_use_hazard || !imem_ready;\n  assign flush_id     = redirect || load_use_hazard;\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_103","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/reg_file.sv'","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// Each asynchronous read port has a RAM replica. Only the shared written\n// bits need reset. An unwritten register (including x0) always reads zero.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_rs1 [0:31];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_rs2 [0:31];\n  logic [31:0] written;\n  logic write_word;\n\n  assign write_word = w_en && w_addr != 5'd0;\n\n  always_ff @(posedge clock) begin\n    if (write_word) begin\n      regs_rs1[w_addr] <= w_data;\n      regs_rs2[w_addr] <= w_data;\n    end\n    if (reset)\n      written <= '0;\n    else if (write_word)\n      written[w_addr] <= 1'b1;\n  end\n\n  always_comb begin\n    if (write_word && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = written[rs1_addr] ? regs_rs1[rs1_addr] : 32'b0;\n\n    if (write_word && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = written[rs2_addr] ? regs_rs2[rs2_addr] : 32'b0;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'","aggregated_output":"// IF and ID share the instruction bus and the bypassed register operands.\n// The PC is the fetch register. ID/EX captures the prediction on issue.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        stall,\n  input  logic        redirect,\n  input  logic [31:2] redirect_target,\n  input  logic [31:0] rs1_data,\n  input  logic [31:0] rs2_data,\n  input  logic        rs1_ready,\n  input  logic        rs2_ready,\n  input  logic        train,\n  input  logic [6:0]  train_index,\n  input  logic [1:0]  train_counter,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  input  logic        imem_ready,\n  output if_id_t      out\n);\n  logic [31:2] pc_word;\n  logic [31:0] pc, pc_plus4, direct_target, direct_offset;\n  logic        is_jal, is_branch, eq_branch_ready, branch_direction;\n  logic        direct_taken, jalr_taken;\n\n  // One asynchronous lookup and one shared synchronous write port.\n  // The high bit holds at one once all 128 rows have been initialized.\n  (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] counters [0:127];\n  logic [7:0] sweep;\n  logic [1:0] counter;\n  logic [6:0] write_index;\n\n  always_ff @(posedge clock) begin\n    if (reset)          sweep <= 8'd0;\n    else if (!sweep[7]) sweep <= sweep + 8'd1;\n  end\n  assign write_index = sweep[7] ? train_index : sweep[6:0];\n  always_ff @(posedge clock) begin\n    if (!sweep[7] || train)\n      counters[write_index] <= sweep[7] ? train_counter : 2'b01;\n  end\n  assign counter = sweep[7] ? counters[pc[8:2]] : 2'b01;\n\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] != 2'b01;\n  assign eq_branch_ready = imem_data[14:13] == 2'b00 && rs1_ready && rs2_ready;\n  assign branch_direction = eq_branch_ready ? ((rs1_data == rs2_data) ^ imem_data[12])\n                                            : counter[1];\n\n  // Opcode bit 3 distinguishes J from B for the shared target adder.\n  assign direct_offset = imem_data[3]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign direct_target = pc + direct_offset;\n  assign pc_plus4 = pc + 32'd4;\n  assign direct_taken = (is_jal || (is_branch && branch_direction)) &&\n                        direct_target[31:20] == 0 && direct_target[1:0] == 0;\n  // With a ready base and an immediate of zero the predicted JALR target\n  // is exact. Bit zero is discarded for both prediction and execution.\n  assign jalr_taken = imem_data[6:0] == 7'b1100111 && imem_data[14:12] == 0 &&\n                      imem_data[31:20] == 0 && rs1_ready &&\n                      rs1_data[31:20] == 0 && !rs1_data[1];\n\n  // Every admitted target is word-aligned. Both taken prediction paths\n  // also checked the instruction window, so their upper bits are zero.\n  assign pc = {pc_word, 2'b00};\n  always_ff @(posedge clock) begin\n    if (reset)         pc_word <= '0;\n    else if (redirect) pc_word <= redirect_target;\n    else if (!stall)   pc_word <= jalr_taken ? {12'b0, rs1_data[19:2]} :\n                                  direct_taken ? {12'b0, direct_target[19:2]} : pc_plus4[31:2];\n  end\n\n  assign imem_addr           = pc;\n  assign out.pc              = pc;\n  assign out.pc_plus4        = pc_plus4;\n  assign out.direct_target   = direct_target;\n  assign out.alternate_pc    = direct_taken ? pc_plus4[31:2] : direct_target[31:2];\n  assign out.counter         = counter;\n  assign out.predicted_taken = direct_taken || jalr_taken;\n  assign out.instr           = imem_data;\n  assign out.valid           = imem_ready;\nendmodule\n","exit_code":0,"status":"completed"}}
