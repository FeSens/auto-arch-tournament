l_fetch_wait:\n        await ClockCycles(dut.clock, initial_fetch_wait)\n    drive_fetch(0)\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = in\n…[3191 of 6263 chars elided by tools/bench/transcript.py; sha256:1929a2f33317056f]…\nexpected)] == [base + pc for pc in expected]\n    assert writes == [(0x44, 15)] and mem[0x44] == 3\n\n\n@cocotb.test()\nasync def replay_loop_through_load_use_and_exit(dut):\n    program = [\n        ADDI(1, 0, 0), ADDI(2, 0, 4),\n        LW(3, 0, 0x80), ADD(4, 3, 1), SW(4, 0, 0x84),\n        ADDI(1, 1, 1), BLT(1, 2, -16),\n        SW(1, 0, 0x88), EBREAK(),\n    ]\n    heads = 0\n    load_waits = 3\n    exit_waits = 3\n\n    def iready(pc):\n        nonlocal heads, exit_waits\n        if pc == 8:\n            heads += 1\n        # The first taken BLT redirects in EX. Its resolved successor\n        # must train the row so the entire third and fourth laps can replay.\n        if heads >= 3 and 8 <= pc <= 24:\n            return False\n        if heads >= 4 and pc == 28 and exit_waits:\n            exit_waits -= 1\n            return False\n        return True\n\n    def dready(addr, ren, wen):\n        nonlocal load_waits\n        if ren and heads >= 3 and load_waits:\n            load_waits -= 1\n            return False\n        return True\n", "exit_code": 0, "status": "completed"}}
