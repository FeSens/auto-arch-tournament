{"type":"item.started","item":{"id":"item_106","type":"command_execution","command":"/bin/bash -c 't=/srv/hwebench/tmp/19d02a47/d26b37b6/bench-mul.0I3X59\nmkdir -p \"$t/cleantest\"\ncp -r \"$t/splittest/test\" \"$t/cleantest/test\"\nln -s \"$t/clean\" \"$t/cleantest/rtl\"\npython - <<'\"'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/19d02a47/d26b37b6/bench-mul.0I3X59/cleantest/test/test_pipeline.py')\ns=p.read_text()\ni=s.index('def test_pipeline_runner')\ns=s[:i]+'''@cocotb.test()\nasync def early_store_wait_and_older_port_owner(dut):\n    # A dependent load base puts the first load in MEM as the next store\n    # reaches EX. The following store can later try the port one cycle early.\n    program = [ADDI(1, 0, 0x48), LW(2, 1, 0), SW(2, 0, 0x40),\n               ADDI(3, 0, 0x123), SW(3, 0, 0x44), LW(4, 0, 0x44), EBREAK()]\n    wait_left = {0x48: 3, 0x40: 1, 0x44: 3}\n    attempts = []\n    accepted = []\n    def ready(addr, ren, wen):\n        if not (ren or wen):\n            return True\n        value = int(dut.io_dmemWData.value) if wen else None\n        entry = (addr, ren, wen, value)\n        attempts.append(entry)\n        if wait_left[addr]:\n            wait_left[addr] -= 1\n            return False\n        accepted.append(entry)\n        return True\n    r, mem = await _run(dut, program, {0x48: 0x1234abcd}, dmem_ready=ready)\n    _check_straight_line(r, program)\n    expected = [(0x48,1,0,None), (0x40,0,15,0x1234abcd),\n                (0x44,0,15,0x123), (0x44,1,0,None)]\n    assert accepted == expected\n    assert attempts == [expected[0]]*4 + [expected[1]]*2 + [expected[2]]*4 + [expected[3]]\n    assert mem[0x40] == 0x1234abcd and mem[0x44] == r[5][\\\"rd_wdata\\\"] == 0x123\n'''+s[i:]\np.write_text(s)\nPY\ncd \\\"\"'$t/cleantest\" && pytest --rootdir=. -q test > \"$t/cleantests.log\" 2>&1\ntail -15 \"$t/cleantests.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
