{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'for option in cores/bench/generated/timing/gowin_p*; do tail -2 \"$option/gw.log\"; done; sed -n '\"'10,27p;62,72p' cores/bench/rtl/id_stage.sv; cat cores/bench/rtl/reg_file.sv\"","aggregated_output":"[20%] Placement Phase 1 completed\n[30%] Placement Phase 2 completed\n[20%] Placement Phase 1 completed\n[30%] Placement Phase 2 completed\n[20%] Placement Phase 1 completed\n[30%] Placement Phase 2 completed\n//                 trap (via ctrl.is_illegal).\nmodule id_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              flush,\n  input  if_id_t  in,\n  // regfile read interface\n  output logic [4:0]        rs1_addr,\n  output logic [4:0]        rs2_addr,\n  input  logic [31:0]       rs1_data,\n  input  logic [31:0]       rs2_data,\n  // ID/EX register output\n  output id_ex_t  out\n);\n\n  // ── Combinational decode ────────────────────────────────────────────────\n  logic [4:0]  dec_alu_op;\n  logic [31:0] imm;\n  imm_gen u_imm (.instr(in.instr), .imm(imm));\n\n  // Regfile read addresses come straight from the IF/ID instruction — these\n  // are also wired to the hazard unit at top level for load-use detection.\n  assign rs1_addr = in.instr[19:15];\n  assign rs2_addr = in.instr[24:20];\n\n  ctrl_t ctrl_decoded;\n  always_comb begin\n    ctrl_decoded.alu_op     = dec_alu_op;\n// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Optional write-first bypass returns same-cycle write data. The core\n//     disables it and forwards the saved WB data in EX.\n//\n// The reset clears all 32 registers. Distributed-LUT or flop inference is\n// fine here; explicit BRAM attribution lives on the larger imem/dmem\n// declarations in soc.sv (phase 5).\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file #(\n  parameter bit WRITE_FIRST = 1'b1\n) (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  logic [31:0] regs [0:31];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n    end else if (w_en && w_addr != 5'b0) begin\n      regs[w_addr] <= w_data;\n    end\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (WRITE_FIRST && w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = regs[rs1_addr];\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (WRITE_FIRST && w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = regs[rs2_addr];\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
