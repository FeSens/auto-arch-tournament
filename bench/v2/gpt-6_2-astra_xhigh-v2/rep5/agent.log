{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR\"/benchstruct.Ki2472\ncat > freerun.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('base_rtl')\nfor n,mode,coll,dat in [(36,0,True,False),(37,1,True,False),(38,2,True,False),(39,2,False,False),(40,1,True,True),(41,3,True,False)]:\n d=Path(f'v{n}')\n shutil.copytree(src,d)\n f=(src/'if_stage.sv').read_text()\n f=f.replace('    if (issue)\\\\n      ram_word <= words[read_row];','    ram_word <= words[read_row];')\n f=f.replace('    if (issue) begin\\\\n      candidate <= ram_word;','    begin\\\\n      candidate <= ram_word;')\n f=f.replace(\\\"      if (issue) begin\\\\n        history_valid <= {history_valid[0], 1'b1};\\\",\\\"      begin\\\\n        history_valid <= {history_valid[0], issue};\\\")\n if coll:\n  f=f.replace(\\\"  assign in_window =\\\",'''  logic [9:0] read_row_q, fill_row_collision_q;\n  logic read_during_fill;\n  always_ff @(posedge clock) begin\n    read_row_q <= read_row;\n    fill_row_collision_q <= fill_pc_q[11:2];\n    read_during_fill <= fill_q;\n  end\n  assign in_window =''')\n  f=f.replace(\\\"read_ok_q <= scrub[10] && \"'!(fill_q && read_row == fill_pc_q[11:2]);\",\"read_ok_q <= scrub[10];\")\n  f=f.replace('\"'candidate_ok_q <= read_ok_q;', 'candidate_ok_q <= read_ok_q && \"'!(read_during_fill && read_row_q == fill_row_collision_q);'\"')\n if mode\"'!=0:\n  cond={1:'\"'\"'!issue'\"',2:'stall',3:'\"'!imem_ready && !hit'\"'}[mode]\n  f=f.replace(\\\"  assign read_row = matched ? exception_entry.row : sequential_row;\\\",f\\\"\\\"\\\"  logic demand_q;\n  always_ff @(posedge clock) demand_q <= {cond};\n  assign read_row = demand_q ? pc[11:2] : (matched ? exception_entry.row : sequential_row);\\\"\\\"\\\")\n if dat:\n  # Separately compute default, exception, or demand address; issue dependence no longer\n  # drives the cache. Qualify ordinary demand directly on sampled collision vs PC.\n  f=f.replace(\\\"assign read_row = demand_q ? pc[11:2] : (matched ? exception_entry.row : sequential_row);\\\", \\\"assign read_row = (\"'!demand_q && matched) ? exception_entry.row : (pc[11:2] + (demand_q ? 10'\"'d0 : 10'd2));\\\")\n # Remove fence_issue-> wide reset and CE from streaming metadata (hit checked against scrub).\n f=f.replace('assign hit = candidate_ok_q', 'assign hit = scrub[10] && candidate_ok_q')\n (d/'if_stage.sv').write_text(f)\nPY\npython freerun.py\ncat > totals.py <<'PY'\nfrom pathlib import Path\nimport ast,json\nfor p in sorted(Path('.').glob('v*-p1.log'),key=lambda p:int(p.name.split('-')[0][1:])):\n if not p.stat().st_size: continue\n d=ast.literal_eval(p.read_text().split(' ',2)[2]); base=p.name.split('-')[0]\n q=Path(base+'-iter.log')\n c=None\n if q.exists() and q.stat().st_size:\n  last=json.loads(q.read_text().splitlines()[-1])\n  if last.get('bench_bracketed'): c=last['bench_stop_cycle']-last['bench_start_cycle']\n mhz=d.get('fmax_mhz')\n print(base,mhz,c,round(1e7*mhz/c,2) if c and mhz else '')\nPY\npython totals.py | tail -14\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
