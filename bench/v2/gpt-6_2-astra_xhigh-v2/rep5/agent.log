{"type": "item.completed", "item": {"id": "item_119", "type": "command_execution", "command": "/bin/bash -c 'cat /srv/hwebench/tmp/19d02a47/4b8b66bd/bench-micro-lSj4CZ/latebase/load_predictor.sv && git status --short && date -u'", "aggregated_output": "// Read a data word alongside ID/EX. Only EX can verify its full address.\nmodule load_predictor (\n  input  logic         clock,\n  input  logic         reset,\n  input  logic         capture,\n  input  logic [6:0]   issue_pc_index,\n  input logic [31:0] rf_base, mem_base,\n  input logic from_mem,\n  input  logic [11:0]  i_imm,\n  input  logic         base_ready,\n  input  logic         train,\n  input  logic [6:0]   train_pc_index,\n  input  logic [11:0]  actual_low,\n  input  logic [31:0]  mem_addr,\n  input  logic         mem_read,\n  input  logic [3:0]   mem_wen,\n  input  logic         mem_ready,\n  input  logic [31:0]  mem_rdata,\n  input  logic [31:0]  mem_wdata,\n  output load_word_t   candidate,\n  output logic [1:0]   probe_offset,\n  output logic         eligible\n);\n  logic [9:0] read_row;\n  logic [31:0] base;\n  logic [12:0] low_sum;\n  logic [12:0] mem_sum, rf_sum;\n  assign base = from_mem ? mem_base : rf_base;\n  logic probe_ok_q, from_mem_q;\n  logic [7:0] mem_page_q, rf_page_q;\n  logic mem_ok_q, rf_ok_q, sign_q, mem_carry_q, rf_carry_q;\n  logic [7:0] page_q;\n  logic [1:0] offset_q;\n  assign mem_sum = {1'b0,mem_base[11:0]} + {1'b0,i_imm};\n  assign rf_sum  = {1'b0,rf_base[11:0]} + {1'b0,i_imm};\n  assign low_sum = from_mem ? mem_sum : rf_sum;\n  assign read_row = low_sum[11:2];\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      probe_ok_q <= base_ready;\n      from_mem_q <= from_mem;\n      mem_page_q <= mem_base[19:12];\n      rf_page_q <= rf_base[19:12];\n      mem_ok_q <= mem_base[31:20] == 0;\n      rf_ok_q <= rf_base[31:20] == 0;\n      sign_q <= i_imm[11];\n      mem_carry_q <= mem_sum[12];\n      rf_carry_q <= rf_sum[12];\n      offset_q <= low_sum[1:0];\n    end\n  end\n\n  (* syn_ramstyle = \"block_ram\" *) logic [40:0] words [0:1023];\n  logic [10:0] scrub;\n  logic [9:0] write_row;\n  logic mem_store, in_ram, update_word, valid_word, scrub_done_q;\n  logic [9:0] read_row_q, write_row_q;\n  logic update_q;\n\n  assign mem_store = |mem_wen;\n  assign in_ram = mem_addr[31:20] == 0;\n  assign update_word = mem_ready && ((mem_read && in_ram) || mem_store);\n  assign valid_word = in_ram && (mem_read || (mem_wen == 4'b1111 && mem_addr[1:0] == 0));\n  assign write_row = scrub[10] ? mem_addr[11:2] : scrub[9:0];\n\n  // Both the scrub and normal updates use the block RAM's one write port.\n  always_ff @(posedge clock) begin\n    if (!scrub[10] || update_word)\n      words[write_row] <= {scrub[10] && valid_word, mem_addr[19:12],\n                           mem_read ? mem_rdata : mem_wdata};\n    // Carry the port addresses alongside the word so the collision\n    // comparison runs in EX, after ID's register-file read and address adder.\n    if (capture) begin\n      {candidate.valid,candidate.word_addr[19:12],candidate.data} <= words[read_row];\n      read_row_q <= read_row;\n      write_row_q <= mem_addr[11:2];\n      update_q <= update_word;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      scrub <= '0;\n      scrub_done_q <= 1'b0;\n    end else begin\n      if (!scrub[10]) scrub <= scrub + 11'd1;\n      if (capture)\n        scrub_done_q <= scrub[10];\n    end\n  end\n\n  // Reject an undefined read-during-write result, and a candidate sampled\n  // before an older store entered MEM. A stalled store keeps the veto live.\n  assign candidate.word_addr[11:2] = read_row_q;\n  assign page_q = from_mem_q ? mem_page_q : rf_page_q;\n  wire address_ok = from_mem_q ? (mem_ok_q && mem_carry_q == sign_q) : (rf_ok_q && rf_carry_q == sign_q);\n  assign probe_offset = offset_q;\n  assign eligible = address_ok && probe_ok_q && page_q == candidate.word_addr[19:12] && scrub_done_q && !(update_q && write_row_q == read_row_q) &&\n                    !(mem_store && mem_addr[11:2] == candidate.word_addr[11:2]);\nendmodule\nSun Nov 22 09:05:12 UTC 2026\n", "exit_code": 0, "status": "completed"}}
