{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py cores/bench/test/test_reg_file.py'", "aggregated_output": "\"\"\"Check combinational ALU and multiply results and the clocked DIV/REM interface.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.div_start.value = 0\n    dut.div_consume.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0):\n    assert int(dut.div_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    await _tick(dut)\n\n    # Forwarded inputs can change immediately after issue.\n    dut.div_start.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = (~a) & MASK32\n    dut.b.value = (~b) & MASK32\n    # PREP registers 3D from the captured divisor.\n    assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n    await _tick(dut)\n    for _ in range(6):  # Each RUN edge produces six quotient bits.\n        assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _tick(dut)\n\n    for _ in range(hold):\n        assert int(dut.div_valid.value) and not int(dut.div_re\n…[10377 of 13449 chars elided by tools/bench/transcript.py; sha256:e27bc0e5b0a905a3]…\nrt_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    for addr, value in [(7, 0x12345678), (7, 0x9ABCDEF0), (0, 0xFFFFFFFF)]:\n        dut.w_en.value = 1\n        dut.w_addr.value = addr\n        dut.w_data.value = value\n        expected = value if addr else 0\n        # Check both outputs before the write edge and again with bypass off.\n        assert await _read(dut, addr, addr) == (expected, expected)\n        await RisingEdge(dut.clock)\n        dut.w_en.value = 0\n        assert await _read(dut, addr, addr) == (expected, expected)\n\n\n@cocotb.test()\nasync def two_read_ports(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 1, 0xAAAAAAAA)\n    await _write(dut, 2, 0xBBBBBBBB)\n    await Timer(1, \"ns\")\n    rs1, rs2 = await _read(dut, 1, 2)\n    assert rs1 == 0xAAAAAAAA\n    assert rs2 == 0xBBBBBBBB\n\n\ndef test_reg_file_runner():\n    run_cocotb(toplevel=\"reg_file\",\n               sources=[\"reg_file.sv\"],\n               test_module=\"test_reg_file\")\n", "exit_code": 0, "status": "completed"}}
