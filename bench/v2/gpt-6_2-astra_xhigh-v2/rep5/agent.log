{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json,subprocess\ncmd = ['cores/bench/obj_dir/cosim_sim','bench/programs/coremark.elf','50000000','--istall','--dstall']\nwith subprocess.Popen(cmd,stdout=subprocess.PIPE) as sim:\n    marked = False\n    previous_rd = 0\n    products = adjacent = 0\n    markers = []\n    for line in sim.stdout:\n        if not line.startswith(b'{\\\"order\\\"'): continue\n        r = json.loads(line)\n        if r['mem_wmask'] and r['mem_addr'] in (0x10000100, 0x10000104):\n            marked = r['mem_addr'] == 0x10000100\n            markers.append(r['cycle'])\n        insn = r['insn']\n        if marked and previous_rd:\n            branch = insn & 127 == 0x63\n            jalr = insn & 127 == 0x67\n            if (branch or jalr) and previous_rd == r['rs1_addr'] or branch and previous_rd == r['rs2_addr']:\n                adjacent += 1\n        product = insn & 0xfe00407f == 0x02000033\n        if marked and product: products += 1\n        previous_rd = r['rd_addr'] if product else 0\n    print('MMIO retirement cycles',markers,'marked MUL family',products,'adjacent dependent control',adjacent,'sim rc',sim.wait())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
