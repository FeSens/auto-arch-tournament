{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/linkshadow.py\" <<'\"'PY'\nfrom fetchkey import *\ndef prep(n):\n    parent = 'rfzero'\n    if n.startswith('z3'):parent='zero3'\n    if n.startswith('hash4'):parent='hash4low'\n    if n.startswith('sign'):parent='signzero'\n    dst=base/n/'rtl'\n    shutil.copytree(base/parent/'rtl',dst,dirs_exist_ok=True)\n    c=dst/'core.sv';r=c.read_text()\n    # Feed only the link registers and their registered eligibility to the fetch-stage early redirect.\n    t=\\\"\\\"\\\"\n  logic [19:2] link1;\n  logic link1_ok;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      link1 <= '0;\n      link1_ok <= 1'b1;\n    end else if (mem_bypass_en && \"'!hold_mem_wb && ex_mem_w.rd == 5'\"'d1) begin\n      link1 <= mem_bypass_data[19:2];\n      link1_ok <= mem_bypass_data[31:20] == 0 && \"'!mem_bypass_data[1];\n    end\n  end\n\"\"\"\n    if '\"'link5' in n:\n        t+=t.replace('link1','link5').replace(\\\"== 5'd1\\\",\\\"== 5'd5\\\")\n        val=\\\"((rs1_addr_w == 5'd1) ? link1 : link5)\\\"\n        ok=\\\"((rs1_addr_w == 5'd1 && link1_ok) || (rs1_addr_w == 5'd5 && link5_ok))\\\"\n    else:\n        val='link1'\n        ok=\\\"(rs1_addr_w == 5'd1 && link1_ok)\\\"\n    r=r.replace('  if_stage u_if (',t+'  if_stage u_if (')\n    r=r.replace('.rs1_data        (fetch_rs1_data)', \\\".rs1_data        ({12'b0, \\\"+val+\\\", 2'b00})\\\")\n    r=r.replace('.rs1_jok(rs1_jok),', f'.rs1_jok({ok}),',1)\n    c.write_text(r)\nif __name__=='__main__':\n    names=sys.argv[1:]\n    for n in names:prep(n)\n    with ThreadPoolExecutor(max_workers=3) as ex:list(ex.map(run,names))\nPY\nPYTHONPATH=. python -u \\\"\"'$TMPDIR/linkshadow.py\" zerolink1 zerolink5 z3link1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/metas.py\" <<'\"'PY'\nfrom fetchkey import *\ndef prep(n):\n    src=base/'rfzero/rtl'\n    p=base/n/'rtl'\n    shutil.copytree(src,p,dirs_exist_ok=True)\n    f=p/'reg_file.sv'\n    s=f.read_text()\n    a=s.index('  logic [31:0] nonzero')\n    b=s.index('  assign rs1_array',a)\n    # eligibility is a sidecar from the same write. For unwritten registers\n    # zero is a legal target; forwarding guards still qualify both uses.\n    impl='''\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] facts [0:31];\n  always_ff @(posedge clock) begin\n    if (write_word)\n      facts[w_addr] <= {w_data[31:20] \"'!= 0 || w_data[1], |w_data};\n  end\n  assign rs1_nz = written[rs1_addr] && facts[rs1_addr][0];\n  assign rs2_nz = written[rs2_addr] && facts[rs2_addr][0];\n  assign rs1_jok = !(written[rs1_addr] && facts[rs1_addr][1]);\n'\"'''\n    if 'bundle' in n:\n        impl='''\n  assign rs1_nz = written[rs1_addr] && regs_rs1[rs1_addr][32];\n  assign rs2_nz = written[rs2_addr] && regs_rs2[rs2_addr][32];\n  assign rs1_jok = \"'!(written[rs1_addr] && regs_rs1[rs1_addr][33]);\n'\"'''\n        s=s.replace('[31:0] regs_rs','[33:0] regs_rs').replace('<= w_data;','<= {w_data[31:20] \"'!= 0 || w_data[1], |w_data, w_data};'\"').replace('regs_rs1[rs1_addr] :','regs_rs1[rs1_addr][31:0] :').replace('regs_rs2[rs2_addr] :','regs_rs2[rs2_addr][31:0] :')\n        a=s.index('  logic [31:0] nonzero');b=s.index('  assign rs1_array',a)\n    if 'ff' not in n:s=s[:a]+impl+s[b:]\n    f.write_text(s)\n    f=p/'if_stage.sv';s=f.read_text()\n    if 'bool' in n:\n        # Distribute condition and outcome so the fallback counter is multiplexed only\n        # between two known branch directions.\n        a=s.index('  assign eq_branch_ready')\n        b=s.index('  // Opcode bit',a)\n        s=s[:a]+\\\"\\\"\\\"\n  wire use_nz = instr[14:13] == 0 && rs1_ready && rs2_ready;\n  wire exact_neq = rs1_nz \"'^ rs2_nz;\n  wire exact_eq = !(rs1_nz || rs2_nz);\n  wire early_take = instr[12] ? exact_neq : exact_eq;\n  wire early_fall = instr[12] ? exact_eq : exact_neq;\n  assign branch_direction = (use_nz && early_take) || (counter[1] && !(use_nz && early_fall));\n\"\"\"+s[b:]\n    f.write_text(s)\nif __name__=='\"'__main__':\n    names=sys.argv[1:]\n    for n in names:prep(n)\n    with ThreadPoolExecutor(max_workers=3) as ex:list(ex.map(run,names))\nPY\nPYTHONPATH=. python -u \\\"\"'$TMPDIR/metas.py\" factsram factsbundle factsffbool'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
