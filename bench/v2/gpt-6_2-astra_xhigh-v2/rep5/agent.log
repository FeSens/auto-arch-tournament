n = predecessor_valid && imem_ready && in_window;\n  assign successor_write_index = scrub[9] ? predecessor : scrub[8:0];\n  assign lookup = scrub[9] && !(learn && predecessor == pc[10:2]);\n  always_ff @(posedge clock) begin\n    if (!scrub[9] || (issue && learn))\n      successors[successor_write_index] <= {\n…[3458 of 6530 chars elided by tools/bench/transcript.py; sha256:f8eff4f2949efe73]…\nge clock) begin\n    if (reset) begin\n      direct_q   <= 1'b0;\n      other_pc_q <= '0;\n    end else if (redirect) begin\n      direct_q   <= 1'b0;\n      other_pc_q <= redirect_target;\n    end else if (!stall) begin\n      direct_q   <= direct_taken;\n      other_pc_q <= jalr_taken ? {12'b0, rs1_data[19:2]} : pc_plus4[31:2];\n    end\n    if (!stall) direct_pc_q <= direct_target[19:2];\n  end\n\n  assign imem_addr           = pc;\n  assign out.pc              = pc;\n  assign out.pc_plus4        = pc_plus4;\n  assign out.direct_target   = direct_target;\n  assign out.alternate_pc    = direct_taken ? pc_plus4[31:2] : direct_target[31:2];\n  assign out.counter         = counter;\n  assign out.predicted_taken = direct_taken || jalr_taken;\n  assign out.instr           = instr;\n  assign out.valid           = (imem_ready || hit) && !fence_in_ex;\nendmodule\ntotal 12\ndrwxr-xr-x 5 nobody nogroup 4096 Sep 28 05:13 gowin\ndrwxr-xr-x 4 nobody nogroup 4096 Sep 28 02:57 hwe-python\ndrwxr-xr-x 5 nobody nogroup 4096 Sep 28 02:44 hwe-toolchain\n", "exit_code": 0, "status": "completed"}}
