/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to\n…[6364 of 9436 chars elided by tools/bench/transcript.py; sha256:76ab16795b926e45]…\nd_op = op == ALU_DIV || op == ALU_REM;\n  assign want_rem  = op == ALU_REM || op == ALU_REMU;\n  if (1) begin : wide\n  logic [31:0] remainder_q, remainder_next;\n  logic [35:0] quotient_q, quotient_next;\n  logic [33:0] divisor_1x, divisor_2x, divisor_3x_q, trial;\n  // Bit 34 is the borrow. The selected remainder fits in 32 bits.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [34:0] diff1, diff2, diff3;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [1:0] digit;\n\n  \n  \n  assign divisor_1x = {2'b0, divisor_q[31:0]};\n  assign divisor_2x = {1'b0, divisor_q[31:0], 1'b0};\n\n  always_comb begin\n    quotient_next = quotient_q;\n    remainder_next = remainder_q;\n    for (int i = 0; i < 2; i++) begin\n      trial = {remainder_next, quotient_next[35:34]};\n      diff1 = {1'b0, trial} - {1'b0, divisor_1x};\n      diff2 = {1'b0, trial} - {1'b0, divisor_2x};\n      diff3 = {1'b0, trial} - {1'b0, divisor_3x_q};\n      // The 2D borrow selects between digits 0/1 and 2/3.\n      if (diff2[34]) begin\n        digit = {1'b0, !diff1[34]};\n", "exit_code": 0, "status": "completed"}}
