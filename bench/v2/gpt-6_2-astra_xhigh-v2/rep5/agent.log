{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Bypass the adjacent producer when needed, run the ALU\n// and resolve branch targets. Owns the EX/MEM pipeline register.\n//\n// Latency:        9 EX cycles for DIV/REM, 1 for other instructions.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               fwd_rs1_sel,\n  input  logic               fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  load_word_t         candidate,\n  input  logic               candidate_eligible,\n  output logic [11:0]        actual_low,\n  output logic               load_hit,\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:2]        redirect_target,\n  output logic               train,\n  output logic [1:0]         train_counter\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = fwd_rs1_sel ? fwd_ex_mem : in.rs1_val;\n  assign rs2 = fwd_rs2_sel ? fwd_ex_mem : in.rs2_val;\n\n  // Address verification runs in parallel with extracting the load value.\n  // Compare the row as well as the tag: a stride can choose the wrong row.\n  logic [31:0] mem_addr, predicted_data;\n  assign mem_addr = rs1 + in.imm;\n  assign actual_low = mem_addr[11:0];\n  assign load_hit = in.ctrl.mem_read && candidate_eligible && candidate.valid &&\n                    mem_addr[31:2] == {12'b0, candidate.word_addr} &&\n                    !access_misaligned(in.ctrl.mem_width, mem_addr[1:0]);\n  assign predicted_data = extend_load(candidate.data, mem_addr[1:0],\n                                      in.ctrl.mem_width, in.ctrl.mem_sext);\n\n  // ── ALU operand selection ────────────────────────────\n…[3189 of 6261 chars elided by tools/bench/transcript.py; sha256:98416bb1c4f37fcd]…\n;\n\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      reg_q.pc            <= in.pc;\n      reg_q.alu_result    <= in.ctrl.mem_read ? predicted_data :\n                             div_valid ? div_result : alu_result;\n      reg_q.mem_addr      <= mem_addr;\n      reg_q.load_hit      <= load_hit;\n      reg_q.load_word     <= candidate.data;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_valid ? div_rs1_q : rs1;\n      reg_q.rs2_val       <= div_valid ? div_rs2_q : rs2;\n      reg_q.pc_next       <= actual_taken ? target : in.pc_plus4;\n      reg_q.instr         <= in.instr;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q.ctrl  <= '0;\n      reg_q.valid <= 1'b0;\n    end else if (!stall) begin\n      reg_q.ctrl  <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.valid <= in.valid && !div_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
