{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c \"sed -n '76,116p' cores/bench/test/test_pipeline.py; date -u\"","aggregated_output":"async def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready=None,\n               imem_ready=None, fetches=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    An optional dmem_ready(addr, ren, wen) selects which requests are accepted.\n    Accepted stores update the Python-side dmem dict.\n    fetches records every address presented to imem, including held PCs.\n    imem_ready(pc) can stall selected fetch cycles.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n    if fetches is not None:\n        fetches.append(0)\n    if imem_ready:\n        dut.io_imemReady.value = int(imem_ready(0))\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\nSun Nov 22 04:47:04 UTC 2026\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -c 'root=/srv/hwebench/tmp/19d02a47/66dd5617/agu.Ruac6Z\npython - \"$root/testtraces/test/test_pipeline.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1]);s=p.read_text()\ns=s.replace('imem_ready=None, fetches=None, fetch_word=None):','imem_ready=None, fetches=None, fetch_word=None, start_clock=True):')\ns=s.replace('    cocotb.start_soon(Clock(dut.clock, 10, \\\"ns\\\").start())','    if start_clock:\\\\n        cocotb.start_soon(Clock(dut.clock, 10, \\\"ns\\\").start())')\ns += \\\"\\\"\\\"\n\n@cocotb.test()\nasync def reset_rejects_a_resident_instruction(dut):\n    program = [ADDI(1, 0, 3), ADDI(7, 7, 1), ADDI(1, 1, -1),\n               NOP(), BNE(1, 0, -12), EBREAK()]\n    expected = [0] + [4,8,12,16]*3 + [20]\n    first, _ = await _run(dut, program)\n    _check_path(first, program, expected)\n    # Start a new reset epoch with a fresh program image at the same PCs.\n    # Hold the individual PCs cold until the live bus supplies their new word.\n    new = program.copy()\n    new[1] = ADDI(7, 7, 15)\n    remaining = {0: 3, 4: 4, 8: 2, 12: 5}\n    allowed = True\n    def ready(pc):\n        nonlocal allowed\n        allowed = remaining.get(pc, 0) == 0\n        if not allowed:\n            remaining[pc] -= 1\n        return allowed\n    def read(pc, imem):\n        return imem.get(pc, EBREAK()) if allowed else SW(1, 0, 0)\n    second, _ = await _run(dut, new, imem_ready=ready, dmem_ready=_no_stores,\n                           fetch_word=read, start_clock=False)\n    _check_path(second, new, expected)\n    assert [r[\\\"rd_wdata\\\"] for r in second if r[\\\"pc\\\"] == 4] == [15, 30, 45]\n    assert all(v == 0 for v in remaining.values())\n\n@cocotb.test()\nasync def aliases_and_circular_overwrite(dut):\n    # Two branch PCs 512 bytes apart share a restart pointer. Alternate\n    # their distinct successors, then overwrite the circular buffer during\n    # a 1,100-word straight-line path and rejoin at the old branch.\n    a, b, c, d, linear = 16, 528, 128, 768, 1024\n    length = 1100\n    end = linear + 4*length\n    program = [SW(0, 0, 0)] * (end//4+5)\n    def put(pc,word):\n        program[pc//4] = word\n    put(0, ADDI(2, 0, 0))\n    put(4, ADDI(1, 0, 1))\n    put(8, JAL(0, a-8))\n    put(a, JAL(0, c-a))\n    put(c, ADDI(2, 2, 1))\n    put(c+4, BEQ(1, 0, 12))\n    put(c+8, JAL(0, b-c-8))\n    put(c+16, EBREAK())\n    put(b, JAL(0, d-b))\n    put(d, ADDI(1, 1, -1))\n    put(d+4, JAL(0, linear-d-4))\n    for i in range(length):\n        put(linear+4*i, ADDI(4, 4, i%9-4))\n    put(end, JAL(0, a-end))\n    counter = 0\n    allowed = True\n    def ready(pc):\n        nonlocal counter, allowed\n        counter += 1\n        allowed = counter % 7 not in (0, 1)\n        return allowed\n    def read(pc, imem):\n        return imem.get(pc, EBREAK()) if allowed else SW(1, 0, 0)\n    rets, _ = await _run(dut, program, imem_ready=ready, dmem_ready=_no_stores,\n                         fetch_word=read, max_cycles=3000)\n    expected = [0,4,8,a,c,c+4,c+8,b,d,d+4] + list(range(linear,end+4,4)) + [a,c,c+4,c+16]\n    _check_path(rets, program, expected)\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == c] == [1,2]\n\\\"\\\"\\\"\np.write_text(s)\nPY\ncd \\\"\"'$root/testtraces\" && pytest -q --rootdir=. test/test_pipeline.py > \"$root/tracesfinaltests.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
