2:18 CORE_PHILOSOPHY.md\n-rw-rw----+ 1 nobody nogroup 8997 Nov 22 12:18 LESSONS.md\n-rw-rw----+ 1 nobody nogroup  544 Nov 22 12:18 core.yaml\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 22 12:18 experiments\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 22 12:18 rtl\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 22 12:18 test\n","exit_code":0,"status":"completed"}}
