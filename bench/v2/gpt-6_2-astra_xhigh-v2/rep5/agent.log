{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"ls -la cores/bench/experiments/hypotheses && git check-ignore -v cores/bench/experiments/hypotheses/hyp-20261122-003-r11s2.yaml && sed -n '1,165p' cores/bench/rtl/load_predictor.sv\"","aggregated_output":"total 20\ndrwxrwx---+ 2 nobody    nogroup   4096 Nov 22 12:02 .\ndrwxrwx---+ 3 nobody    nogroup   4096 Nov 22 11:58 ..\n-rw-rw----+ 1 hwebench2 hwebench2 3054 Nov 22 12:02 hyp-20261122-003-r11s2.yaml\n.gitignore:88:cores/*/experiments/hypotheses/\tcores/bench/experiments/hypotheses/hyp-20261122-003-r11s2.yaml\n// Read a data word alongside ID/EX. Only EX can verify its full address.\nmodule load_predictor (\n  input  logic         clock,\n  input  logic         reset,\n  input  logic         capture,\n  input  logic [6:0]   issue_pc_index,\n  input  logic [11:0]  base_low,\n  input  logic [11:0]  i_imm,\n  input  logic         base_ready,\n  input  logic         train,\n  input  logic [6:0]   train_pc_index,\n  input  logic [11:0]  actual_low,\n  input  logic [31:0]  mem_addr,\n  input  logic         mem_read,\n  input  logic [3:0]   mem_wen,\n  input  logic         mem_ready,\n  input  logic [31:0]  mem_rdata,\n  input  logic [31:0]  mem_wdata,\n  output load_word_t   candidate,\n  output logic         eligible\n);\n  (* syn_ramstyle = \"distributed_ram\" *) logic [11:0] last_addr [0:127];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [9:0] next_row [0:127];\n  logic [11:0] prior_q;\n  logic [9:0] read_row;\n\n  initial begin\n    for (int i = 0; i < 128; i++) begin\n      last_addr[i] = '0;\n      next_row[i] = '0;\n    end\n  end\n\n  // Both calculations wrap at 4 KiB. Capturing the history at issue\n  // gives each table one read address, even while another load trains.\n  assign read_row = base_ready ? 10'((base_low + i_imm) >> 2) : next_row[issue_pc_index];\n  always_ff @(posedge clock) begin\n    if (capture) prior_q <= last_addr[issue_pc_index];\n    if (train) begin\n      last_addr[train_pc_index] <= actual_low;\n      next_row[train_pc_index] <= 10'(({actual_low[10:0], 1'b0} - prior_q) >> 2);\n    end\n  end\n\n  (* syn_ramstyle = \"block_ram\" *) logic [50:0] words [0:1023];\n  logic [10:0] scrub;\n  logic [9:0] write_row;\n  logic mem_store, in_ram, update_word, valid_word, scrub_done_q;\n  logic [9:0] read_row_q, write_row_q;\n  logic update_q;\n\n  assign mem_store = |mem_wen;\n  assign in_ram = mem_addr[31:20] == 0;\n  assign update_word = mem_ready && ((mem_read && in_ram) || mem_store);\n  assign valid_word = in_ram && (mem_read || (mem_wen == 4'b1111 && mem_addr[1:0] == 0));\n  assign write_row = scrub[10] ? mem_addr[11:2] : scrub[9:0];\n\n  // Both the scrub and normal updates use the block RAM's one write port.\n  always_ff @(posedge clock) begin\n    if (!scrub[10] || update_word)\n      words[write_row] <= {scrub[10] && valid_word, mem_addr[19:2],\n                           mem_read ? mem_rdata : mem_wdata};\n    // Carry the port addresses alongside the word so the collision\n    // comparison runs in EX, after ID's register-file read and address adder.\n    if (capture) begin\n      candidate <= words[read_row];\n      read_row_q <= read_row;\n      write_row_q <= mem_addr[11:2];\n      update_q <= update_word;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      scrub <= '0;\n      scrub_done_q <= 1'b0;\n    end else begin\n      if (!scrub[10]) scrub <= scrub + 11'd1;\n      if (capture)\n        scrub_done_q <= scrub[10];\n    end\n  end\n\n  // Reject an undefined read-during-write result, and a candidate sampled\n  // before an older store entered MEM. A stalled store keeps the veto live.\n  assign eligible = scrub_done_q && !(update_q && write_row_q == read_row_q) &&\n                    !(mem_store && mem_addr[11:2] == candidate.word_addr[11:2]);\nendmodule\n","exit_code":0,"status":"completed"}}
