{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nU32 = (1 << 32) - 1\nU36 = (1 << 36) - 1\ndef divide(n, d):\n    q, r = n, 0\n    multiples = (0, d, d*2, d*3)\n    for _ in range(6):\n        for _ in range(3):\n            t = r*4 + (q >> 34)\n            assert t < 1 << 34 and multiples[-1] < 1 << 34\n            digit = max(k for k,m in enumerate(multiples) if m <= t)\n            r = t - multiples[digit]\n            assert r <= U32\n            q = ((q << 2) | digit) & U36\n    return q & U32, r\nrng = random.Random(32)\nedges = [0,1,2,3,4,0x3fffffff,0x55555555,0x55555556,0x7fffffff,0x80000000,0xaaaaaaab,U32]\npairs = [(a,b) for a in edges for b in edges]\npairs.extend((rng.getrandbits(32),rng.getrandbits(rng.randint(0,32))) for _ in range(10000))\nfor a,b in pairs:\n    expected = divmod(a,b) if b else (U32,a)\n    assert divide(a,b) == expected\nprint(f'Radix-4 recurrence matched unsigned quotient and remainder on {len(pairs):,} operand pairs including zero divisors.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
