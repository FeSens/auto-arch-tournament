{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/loadopt_fetch.py\" <<'\"'PY'\nfrom loadopt_try import *\ndef fetch(name):\n    p=set_up(name)\n    ff=p/'if_stage.sv'\n    s=ff.read_text()\n    if 'rfzero' in name or 'flags' in name:\n        f=p/'reg_file.sv'\n        r=f.read_text().replace('  output logic [31:0] rs2_array,','  output logic [31:0] rs2_array,\\\\n  output logic rs1_nz, rs2_nz, rs1_jok,')\n        r=r.replace('  assign rs1_array',\\\"\\\"\\\"  logic [31:0] nonzero, jalr_ok;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      nonzero <= '0;\n      jalr_ok <= '1;\n    end else if (write_word) begin\n      nonzero[w_addr] <= |w_data;\n      jalr_ok[w_addr] <= w_data[31:20] == 0 && \"'!w_data[1];\n    end\n  end\n  assign rs1_nz = nonzero[rs1_addr];\n  assign rs2_nz = nonzero[rs2_addr];\n  assign rs1_jok = jalr_ok[rs1_addr];\n  assign rs1_array\"\"\")\n        f.write_text(r)\n        c=p/'\"'core.sv'; cr=c.read_text()\n        cr=cr.replace('  // ── IF ─', '  wire rs1_nz, rs2_nz, rs1_jok;\\\\n  // ── IF ─')\n        cr=cr.replace('    .rs2_data        (fetch_rs2_data),','    .rs2_data        (fetch_rs2_data),\\\\n    .rs1_nz(rs1_nz), .rs2_nz(rs2_nz), .rs1_jok(rs1_jok),')\n        cr=cr.replace('    .rs2_array(fetch_rs2_data),','    .rs2_array(fetch_rs2_data),\\\\n    .rs1_nz(rs1_nz), .rs2_nz(rs2_nz), .rs1_jok(rs1_jok),')\n        c.write_text(cr)\n        s=s.replace('  input  logic        rs1_ready,','  input logic rs1_nz, rs2_nz, rs1_jok,\\\\n  input  logic        rs1_ready,')\n        # both zero -> BEQ. one zero/one nonzero exact. Equal register numbers handled separately by BHT if both nonzero.\n        s=s.replace('&& rs1_ready && rs2_ready;', '&& rs1_ready && rs2_ready && \"'!(rs1_nz && rs2_nz);'\"')\n        s=s.replace('(rs1_data == rs2_data)','(rs1_nz == rs2_nz)').replace('rs1_data[31:20] == 0 && \"'!rs1_data[1]'\"','rs1_jok')\n    if 'early' in name:\n        s=s.replace('  assign in_window',\\\"\\\"\\\"  logic [9:0] fields_q;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [9:0] fields [0:511];\n  always_ff @(posedge clock) begin\n    if (issue && learn && scrub[9]) fields[predecessor] <= imem_data[24:15];\n    if (issue && lookup) fields_q <= fields[pc[10:2]];\n  end\n  assign in_window\\\"\\\"\\\")\n        s=s.replace('imem_data : candidate.instr;', 'imem_data : {candidate.instr[31:25], fields_q, candidate.instr[14:0]};')\n    if 'mux' in name:\n        s=s.replace('assign out.alternate_pc    = direct_taken ? pc_plus4[31:2] : direct_target[31:2];','assign out.alternate_pc    = direct_target[31:2];')\n        f=p/'ex_stage.sv'\n        f.write_text(f.read_text().replace('jalr_sum[31:2] : in.alternate_pc','jalr_sum[31:2] : in.predicted_taken ? in.pc_plus4[31:2] : in.direct_target[31:2]'))\n    if 'loadbits' in name:\n        f=p/'ex_stage.sv'\n        orig=f.read_text()\n        b=(base/'bitcmp/rtl/ex_stage.sv').read_text()\n        in1=orig.index('  assign actual_low')\n        in2=orig.index('  assign predicted_data')\n        f.write_text(orig[:in1]+b[b.index('  assign actual_low'):b.index('  assign predicted_data')]+orig[in2:])\n    ff.write_text(s)\nif __name__=='__main__':\n    names=sys.argv[1:]\n    for n in names:fetch(n)\n    with ThreadPoolExecutor(max_workers=3) as ex:list(ex.map(run,names))\nPY\nPYTHONPATH=. python -u \\\"\"'$TMPDIR/loadopt_fetch.py\" rfzero rfzeroearly earlyloadbits'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/loadopt_pc.py\" <<'\"'PY'\nfrom loadopt_try import *\ndef prep(name):\n    p=set_up(name)\n    f=p/'if_stage.sv'\n    s=f.read_text()\n    a=s.index('  logic [19:2] direct_pc_q;')\n    b=s.index('  assign imem_addr',a)\n    if 'simple' in name:\n        body=\\\"\\\"\\\"\n  logic [31:2] hold_q, recover_q, next_q;\n  logic [19:2] direct_pc_q, indirect_pc_q;\n  logic [4:0] choice_q;\n  always_ff @(posedge clock) begin\n    hold_q        <= pc_word;\n    recover_q     <= redirect_target;\n    next_q        <= pc_plus4[31:2];\n    direct_pc_q   <= direct_target[19:2];\n    indirect_pc_q <= rs1_data[19:2];\n    choice_q[0] <= \"'!reset && !redirect && stall;\n    choice_q[1] <= !reset && redirect;\n    choice_q[2] <= !reset && !redirect && !stall && !direct_taken && !jalr_taken;\n    choice_q[3] <= !reset && !redirect && !stall && direct_taken;\n    choice_q[4] <= !reset && !redirect && !stall && jalr_taken;\n  end\n  assign pc_word = ({30{choice_q[0]}} & hold_q) | ({30{choice_q[1]}} & recover_q) |\n                   ({30{choice_q[2]}} & next_q) | {12'\"'b0, ({18{choice_q[3]}} & direct_pc_q) |\n                       ({18{choice_q[4]}} & indirect_pc_q)};\n\\\"\\\"\\\"\n    else:\n        body=\\\"\\\"\\\"\n  logic [31:2] hold_q, recover_q, next_q;\n  logic [19:2] direct_pc_q, indirect_pc_q;\n  logic [1:0] action_q;\n  logic direct_taken_q, indirect_taken_q;\n  always_ff @(posedge clock) begin\n    hold_q        <= pc_word;\n    recover_q     <= redirect_target;\n    next_q        <= pc_plus4[31:2];\n    direct_pc_q   <= direct_target[19:2];\n    indirect_pc_q <= rs1_data[19:2];\n    direct_taken_q <= direct_taken;\n    indirect_taken_q <= jalr_taken;\n    if (reset) action_q <= 2'd0;\n    else if (redirect) action_q <= 2'd1;\n    else if (stall) action_q <= 2'd2;\n    else action_q <= 2'd3;\n  end\n  always_comb begin\n    case (action_q)\n      2'd1: pc_word = recover_q;\n      2'd2: pc_word = hold_q;\n      2'd3: pc_word = direct_taken_q ? {12'b0,direct_pc_q} :\n                    indirect_taken_q ? {12'b0,indirect_pc_q} : next_q;\n      default: pc_word = '0;\n    endcase\n  end\n\\\"\\\"\\\"\n    s=s[:a]+body+'  assign pc = {pc_word,2\\\\'b00};\\\\n'+s[b:]\n    if 'alt' in name:\n        s=s.replace('direct_taken ? pc_plus4[31:2] : direct_target[31:2]','direct_target[31:2]')\n        e=p/'ex_stage.sv'\n        e.write_text(e.read_text().replace('jalr_sum[31:2] : in.alternate_pc','jalr_sum[31:2] : in.predicted_taken ? in.pc_plus4[31:2] : in.direct_target[31:2]'))\n    f.write_text(s)\nif __name__=='__main__':\n    names=sys.argv[1:]\n    for n in names:prep(n)\n    with ThreadPoolExecutor(max_workers=3) as ex:list(ex.map(run,names))\nPY\nPYTHONPATH=. python -u \\\"\"'$TMPDIR/loadopt_pc.py\" simpleP combinP simplePalt'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
