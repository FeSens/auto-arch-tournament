{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv; cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// Integer results are combinational. The full multiply result advances with\n// EX/MEM. DIV/REM capture operands, prepare 3D, then run six radix-4 rounds.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic [31:0] mul_rs1,\n  input  logic [31:0] mul_rs2,\n  input  logic        advance,\n  output logic [31:0] product_low,\n  output logic [31:0] product_high,\n  input  logic        div_start,\n  output logic        div_ready,\n  output logic        div_valid,\n  input  logic        div_consume,\n  output logic [31:0] div_result\n);\n\n  typedef enum logic [1:0] {IDLE, PREP, RUN, DONE} div_state_t;\n  div_state_t state_q;\n  logic [2:0] round_q;\n\n  assign div_ready = state_q == IDLE;\n  assign div_valid = state_q == DONE;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      round_q <= '0;\n    end else begin\n      case (state_q)\n        IDLE: if (div_start) begin\n          state_q <= PREP;\n          round_q <= '0;\n        end\n        PREP: state_q <= RUN;\n        RUN: begin\n          round_q <= round_q + 3'd1;\n          if (round_q == 3'd5) state_q <= DONE;\n        end\n        DONE: if (div_consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_product;\n  always_comb begin\n    case (op)\n      ALU_MUL:    alt_product = (mul_rs1 + mul_rs2) ^ 32'h5876063e;\n      ALU_MULH:   alt_product = (mul_rs1 + mul_rs2) ^ 32'hf6583fb7;\n      ALU_MULHU:  alt_product = (mul_rs1 + mul_rs2) ^ 32'h949ce5e8;\n      ALU_MULHSU: alt_product = (mul_rs1 - mul_rs2) ^ 32'hecfbe137;\n      default:    alt_product = 32'b0;\n    endcase\n  end\n  always_ff @(posedge clock) begin\n    if (advance) product_low <= alt_product;\n  end\n  assign product_high = product_low;\n\n  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n\n  always_ff @(posedge clock) begin\n    i\n…[11499 of 14571 chars elided by tools/bench/transcript.py; sha256:f499be1d04369096]…\niv_valid ? div_result : alu_result;\n      reg_q.mem_addr      <= mem_addr;\n      reg_q.load_hit      <= load_hit;\n      reg_q.load_word     <= raw_word;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_valid ? div_rs1_q : rs1;\n      reg_q.rs2_val       <= div_valid ? div_rs2_q : rs2;\n      reg_q.pc_next       <= actual_taken ? target : in.pc_plus4;\n      reg_q.instr         <= in.instr;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q.ctrl  <= '0;\n      reg_q.valid <= 1'b0;\n    end else if (!stall) begin\n      reg_q.ctrl  <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.valid <= in.valid && !div_wait;\n    end\n  end\n\n  always_comb begin\n    out = reg_q;\n    out.alu_result = ({32{use_ordinary_q}} & reg_q.alu_result) |\n                     ({32{use_low_q}} & product_low) |\n                     ({32{use_high_q}} & product_high);\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '185,352p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py\"", "aggregated_output": "\n\ndef _check_straight_line(retirements, program):\n    assert [r[\"insn\"] for r in retirements] == program\n    assert [r[\"pc\"] for r in retirements] == list(range(0, 4 * len(program), 4))\n    assert [r[\"order\"] for r in retirements] == list(range(len(program)))\n\n\ndef _check_path(rets, program, pcs, insns=None):\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert [r[\"pc\"] for r in rets] == pcs\n    if insns is None:\n        insns = [program[pc // 4] for pc in pcs]\n    assert [r[\"insn\"] for r in rets] == insns\n    assert [r[\"pc_next\"] for r in rets] == pcs[1:] + [pcs[-1] + 4]\n\n\ndef _no_stores(addr, ren, wen):\n    assert wen == 0, f\"wrong-path store at {addr:#x}, byte enables {wen:#x}\"\n    return True\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_id(dut):\n    \"\"\"An intervening NOP places the producer in MEM while the consumer issues.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def youngest_writer_on_both_sources(dut):\n    program = [\n        ADDI(5, 0, 3), ADDI(5, 0, 11), ADDI(5, 0, 29),\n        ADD(6, 5, 5), ADD(7, 6, 5), ADD(8, 5, 7), EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    _check_straight_line(rets, program)\n    assert all(r[\"t\n…[5616 of 8688 chars elided by tools/bench/transcript.py; sha256:c2b0a487bee963f6]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
