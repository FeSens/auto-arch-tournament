{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/load_predictor.sv && rg -n 'word_addr|predictor|stride|candidate|rs1_ready|actual_low' cores/bench/{rtl,test}\"", "aggregated_output": "// Read a data word alongside ID/EX. Only EX can verify its full address.\nmodule load_predictor (\n  input  logic         clock,\n  input  logic         reset,\n  input  logic         capture,\n  input  logic [6:0]   issue_pc_index,\n  input  logic [11:0]  base_low,\n  input  logic [11:0]  i_imm,\n  input  logic         base_ready,\n  input  logic         train,\n  input  logic [6:0]   train_pc_index,\n  input  logic [11:0]  actual_low,\n  input  logic [31:0]  mem_addr,\n  input  logic         mem_read,\n  input  logic [3:0]   mem_wen,\n  input  logic         mem_ready,\n  input  logic [31:0]  mem_rdata,\n  input  logic [31:0]  mem_wdata,\n  output load_word_t   candidate,\n  output logic         eligible\n);\n  (* syn_ramstyle = \"distributed_ram\" *) logic [11:0] last_addr [0:127];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [9:0] next_row [0:127];\n  logic [11:0] prior_q;\n  logic [9:0] read_row;\n\n  initial begin\n    for (int i = 0; i < 128; i++) begin\n      last_addr[i] = '0;\n      next_row[i] = '0;\n    end\n  end\n\n  // Both calculations wrap at 4 KiB. Capturing the history at issue\n  // gives each table one read address, even while another load trains.\n  assign read_row = base_ready ? 10'((base_low + i_imm) >> 2) : next_row[issue_pc_index];\n  always_ff @(posedge clock) begin\n    if (capture) prior_q <= last_addr[issue_pc_index];\n    if (train) begin\n      last_addr[train_pc_index] <= actual_low;\n      next_row[train_pc_index] <= 10'(({actual_low[10:0], 1'b0} - prior_q) >> 2);\n    end\n  end\n\n  (* syn_ramstyle = \"block_ram\" *) logic [50:0] words [0:1023];\n  logic [10:0] scrub;\n  logic [9:0] write_row;\n  logic mem_store, in_ram, update_word, valid_word, scrub_done_q;\n  logic [9:0] read_row_q, write_row_q;\n  logic update_q;\n\n  assign mem_store = |mem_wen;\n  assign in_ram = mem_addr[31:20] == 0;\n  assign update_word = mem_ready && ((mem_read && in_ram) || mem_store);\n  assign valid_word = in_ram && (mem_read || (mem_wen == 4'b1111 && mem_addr[1:0] == 0));\n  assign write_row = scrub[10] ? mem_addr[11:2] : scrub[9:0];\n\n  // Both the scr\n…[3655 of 6727 chars elided by tools/bench/transcript.py; sha256:7785a05498c5cfb4]…\nrtl/if_stage.sv:111:      candidate_ok_q <= 1'b0;\ncores/bench/rtl/if_stage.sv:121:        candidate_ok_q <= read_ok_q;\ncores/bench/rtl/if_stage.sv:153:  assign eq_branch_ready = instr[14:13] == 2'b00 && rs1_ready && rs2_ready;\ncores/bench/rtl/if_stage.sv:168:                      instr[31:20] == 0 && rs1_ready &&\ncores/bench/rtl/load_predictor.sv:2:module load_predictor (\ncores/bench/rtl/load_predictor.sv:12:  input  logic [11:0]  actual_low,\ncores/bench/rtl/load_predictor.sv:19:  output load_word_t   candidate,\ncores/bench/rtl/load_predictor.sv:40:      last_addr[train_pc_index] <= actual_low;\ncores/bench/rtl/load_predictor.sv:41:      next_row[train_pc_index] <= 10'(({actual_low[10:0], 1'b0} - prior_q) >> 2);\ncores/bench/rtl/load_predictor.sv:66:      candidate <= words[read_row];\ncores/bench/rtl/load_predictor.sv:84:  // Reject an undefined read-during-write result, and a candidate sampled\ncores/bench/rtl/load_predictor.sv:87:                    !(mem_store && mem_addr[11:2] == candidate.word_addr[11:2]);\n", "exit_code": 0, "status": "completed"}}
