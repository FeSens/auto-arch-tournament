{"type":"item.started","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'r8-predict'\ns=\\\"\\\"\\\"\n\n@cocotb.test()\nasync def valid_wrong_tag_repair(dut):\n    # Two RAM pages share the row at 0x40. Their values distinguish\n    # stale forwarding, early branch resolution and premature divide start.\n    program = [\n        0x000010b7, ADDI(2, 0, 3), LW(7, 0, 0x40), NOP(), NOP(),\n        LW(5, 1, 0x40), ADD(6, 5, 5), LW(5, 0, 0x40), DIVU(6, 5, 2),\n        LW(5, 1, 0x40), SW(5, 0, 0xb0), LW(5, 0, 0x40),\n        BEQ(5, 2, 8), SW(0, 0, 0xb4), LW(5, 0, 0x42), ADD(6, 5, 5),\n        LW(5, 0, 0x40), ADD(6, 5, 5), EBREAK()\n    ]\n    accepted, pending = [], 0\n    def ready(addr, ren, wen):\n        nonlocal pending\n        if ren:\n            pending += 1\n            if pending < 4:\n                return False\n            pending = 0\n            accepted.append((addr, 0))\n        if wen:\n            accepted.append((addr, wen))\n        return True\n    rets, mem = await _run(dut, program, {0x40:3, 0x1040:11},\n                           initial_fetch_wait=1024, dmem_ready=ready)\n    pcs = [4*i for i in range(len(program)) if i \"'!= 13]\n    _check_path(rets, program, pcs)\n    assert accepted == [(0x40,0),(0x1040,0),(0x40,0),(0x1040,0),(0xb0,15),(0x40,0)]\n    assert mem[0xb0] == 11 and 0xb4 not in mem\n    at = {r['\"'pc']//4:r for r in rets}\n    assert (at[6]['rs1_rdata'],at[6]['rs2_rdata'],at[6]['rd_wdata']) == (11,11,22)\n    assert at[6]['cycle']-at[5]['cycle'] == 2\n    assert (at[8]['rs1_rdata'],at[8]['rs2_rdata'],at[8]['rd_wdata']) == (3,3,1)\n    assert at[12]['rs1_rdata'] == 3\n    assert at[14]['trap'] == 1 and at[14]['rd'] == 0\n    assert at[15]['rd_wdata'] == 6\n    assert at[17]['cycle']-at[16]['cycle'] == 1\n\\\"\\\"\\\"\nfor n in ['spec_row','early_keep']:\n t=p/(n+'_test/test/test_pipeline.py')\n t.write_text(t.read_text()+