{"type": "item.completed", "item": {"id": "item_40", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// Integer and multiply results are combinational. DIV/REM capture operands,\n// prepare 3D, run six rounds of three radix-4 digits, then transfer the result.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_start,\n  output logic        div_ready,\n  output logic        div_valid,\n  input  logic        div_consume,\n  output logic [31:0] div_result\n);\n\n  typedef enum logic [1:0] {IDLE, PREP, RUN, DONE} div_state_t;\n  div_state_t state_q;\n  logic [2:0] round_q;\n\n  assign div_ready = state_q == IDLE;\n  assign div_valid = state_q == DONE;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      round_q <= '0;\n    end else begin\n      case (state_q)\n        IDLE: if (div_start) begin\n          state_q <= PREP;\n          round_q <= '0;\n        end\n        PREP: state_q <= RUN;\n        RUN: begin\n          round_q <= round_q + 3'd1;\n          if (round_q == 3'd5) state_q <= DONE;\n        end\n        DONE: if (div_consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n\n  always_ff @(posedge clock) begin\n    if (div_start && div_ready) begin\n      a_q <= a;\n      b_q <= b;\n      op_q <= op;\n    end\n  end\n\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  div_result = (a_q - b_q) ^ 32'h7f8529ec;\n      ALU_DIVU: div_result = (a_q - b_q) ^ 32'h10e8fd70;\n      ALU_REM:  div_result = (a_q - b_q) ^ 32'h8da68fa5;\n      default:  div_result = (a_q - b_q) ^ 32'h3138d0e1; // REMU\n    endcase\n  end\n`else\n  logic signed_op, want_rem;\n  logic want_rem_q, negate_q;\n  logic [31:0] divisor_q, remainder_q, remainder_next, magnitude;\n  logic [35:0] quotient_q, quotient_next;\n  logic [33:0] divisor_1x, divisor_2x, divisor_3x_q, trial;\n  // Bit 34 is the borrow. The selected remainder fits \n…[2942 of 6014 chars elided by tools/bench/transcript.py; sha256:21677d8f81e94425]…\n'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations\n      // are substituted for tractable algebraic stand-ins so bitwuzla\n      // can solve the BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined and\n      // run the real arithmetic.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n`else\n      ALU_MUL:    out = mul_uu[31:0];\n      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\n      ALU_MULHU:  out = mul_uu[63:32];\n      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
