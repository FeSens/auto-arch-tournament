go == index);\n        lookup_valid <= ram_valid;\n      end else if (redirect) begin\n        ram_valid <= 1'b0;\n        lookup_valid <= 1'b0;\n      end\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (initializing || recorded_pair)\n      successors[initializing ? clear_row[INDEX_BITS-1:0] : two_ago]\n          <= initializing ? '0 : {1'b1, pc[19:2], imem_data};\n    if (issue) begin\n      ram_output <= successors[index];\n      candidate <= ram_output;\n    end\n  end\n\n  assign is_jal = fetch_word[6:0] == 7'b1101111;\n  assign is_branch = fetch_word[6:0] == 7'b1100011 && fetch_word[14:13] != 2'b01;\n  assign eq_branch_ready = fetch_word[14:13] == 2'b00 && rs1_ready && rs2_ready;\n  assign branch_direction = eq_branch_ready ? ((rs1_data == rs2_data) ^ fetch_word[12])\n                                            : counter[1];\n\n  // Opcode bit 3 distinguishes J from B for the shared target adder.\n  assign direct_offset = fetch_word[3]\n      ? {{12{fetch_word[31]}}, fetch_word[19:12], fetch_word[20], fetch_word[30:21], 1'b0}\n      : {{20{fetch_word[31]}}, fetch_word[7], fetch_word[30:25], fetch_word[11:8], 1'b0};\n  assign direct_target = pc + direct_offset;\n  assign pc_plus4 = pc + 32'd4;\n  assign direct_taken = (is_jal || (is_branch && branch_direction)) &&\n                        direct_target[31:20] == 0 && direct_target[1:0] == 0;\n  // With a ready base and an immediate of zero the predicted JALR target\n  // is exact. Bit zero is discarded for both prediction and execution.\n  assign jalr_taken = fetch_word[6:0] == 7'b1100111 && fetch_word[14:12] == 0 &&\n                      fetch_word[31:20] == 0 && rs1_ready &&\n                      rs1_data[31:20] == 0 && !rs1_data[1];\n\n  // Every admitted target is word-aligned. Both taken prediction paths\n  // also checked the instruction window, so their upper bits are zero.\n  assign pc = {pc_word, 2'b00};\n  always_ff @(posedge clock) begin\n    if (reset)         pc_word <= '0;\n    else