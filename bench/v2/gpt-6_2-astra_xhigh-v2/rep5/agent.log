t()\nasync def forwarding_held_behind_store(dut):\n    program = [\n        ADDI(1, 0, 0x21),\n        ADDI(2, 0, 0x104),\n        SW(1, 2, 0),\n        ADD(3, 1, 2),  # needs the saved decode-cycle WB and the held MEM/WB\n        EBREAK(),\n    ]\n    store_cycles = 0\n\n    def ready(addr, ren, wen):\n        nonlocal store_cycles\n        if wen:\n            assert (addr, ren, wen) == (0x104, 0, 15)\n            store_cycles += 1\n            return store_cycles > 3\n        return True\n\n    rets, dmem = await _run(dut, program, dmem_ready=ready)\n    assert store_cycles == 4 and dmem[0x104] == 0x21\n    assert [r[\"insn\"] for r in rets] == program\n    r = rets[3]\n    assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd\"], r[\"rd_wdata\"]) == (0x21, 0x104, 3, 0x125)\n\n\n@cocotb.test()\nasync def forwarding_past_trapping_writers(dut):\n    program = [\n        ADDI(1, 0, 0x14),\n        JAL(1, 2),      # EX suppresses the link write\n        ADD(2, 1, 1),   # older x1 writer is in MEM during decode\n        ADDI(1, 0, 0x28),\n        LW(1, 0, 2),    # MEM suppresses the misaligned load write\n        ADD(3, 1, 1),   # after the load-use bubble the older writer is in WB\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, {0: 0x12345678})\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"trap\"] for r in rets] == [0, 1, 0, 0, 1, 0, 0]\n    for r in (rets[1], rets[4]):\n        assert (r[\"rd\"], r[\"rd_wdata\"], r[\"pc_next\"]) == (0, 0, r[\"pc\"] + 4)\n    assert rets[4][\"mem_rmask\"] == 0\n    for r, value, rd in [(rets[2], 0x14, 2), (rets[5], 0x28, 3)]:\n        assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd\"], r[\"rd_wdata\"]) == (value, value, rd, 2 * value)\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n83:def parse_iterations(worktree: str) -> int:\n265:                          f'start={marker.get(\"bench_start_cycle\")} '\n266:                          f'stop={marker.get(\"bench_stop_cycle\")}'}\n267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n270:                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n", "exit_code": 0, "status": "completed"}}
