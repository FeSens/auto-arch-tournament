{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv'","aggregated_output":"// rtl/forward_unit.sv\n//\n// Compare the adjacent producer in EX with each source in ID. The match\n// travels with the consumer. A producer that traps in EX clears reg_write\n// before reaching EX/MEM, leaving the older value captured in ID available.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       capture_operands,\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic       ex_mem_w_en,\n  output logic       fwd_rs1,\n  output logic       fwd_rs2\n);\n\n  logic rs1_match_q, rs2_match_q;\n\n  always_ff @(posedge clock) begin\n    if (capture_operands) begin\n      rs1_match_q <= id_ex_rd != 5'd0 && id_ex_rd == id_rs1;\n      rs2_match_q <= id_ex_rd != 5'd0 && id_ex_rd == id_rs2;\n    end\n  end\n\n  assign fwd_rs1 = rs1_match_q && ex_mem_w_en;\n  assign fwd_rs2 = rs2_match_q && ex_mem_w_en;\n\nendmodule\n","exit_code":0,"status":"completed"}}
