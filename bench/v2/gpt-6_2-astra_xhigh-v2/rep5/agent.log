{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1098,1325p;1395,1440p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def destination_row_full_pc_check(dut):\n    # Same word-store row, once with a different in-RAM tag and once\n    # with all 18 tag bits matching an address outside instruction RAM.\n    low = 32\n    for page in (0x1000, 0x10000000):\n        high = page + low\n        program = [page | 0xB7, JAL(0, low - 4)] + [NOP()] * 8  # LUI x1,page\n        program.extend([SW(0, 0, 0x80), JALR(0, 1, low)])\n        upper = {high: NOP(), high + 4: NOP(), high + 8: EBREAK()}\n        requests = 0\n\n        def iready(pc):\n            nonlocal requests\n            if pc == high + 8:\n                requests += 1\n                return requests == 4\n            return True\n\n        rets, _ = await _run(dut, program, upper, shared_memory=True,\n                             initial_fetch_wait=1024, imem_ready=iready)\n        before = [0, 4, low, low + 4, low + 8, low + 12]\n        _check_path(rets, program, before + list(upper),\n                    [program[p // 4] for p in before] + list(upper.values()))\n        assert requests == 4\n        assert [r[\"pc\"] for r in rets if r[\"mem_wmask\"]] == [low + 8]\n\n\n@cocotb.test()\nasync def two_issue_probe_collides_with_delayed_fill(dut):\n    program = [ADDI(1, 0, 3), ADDI(1, 1, -1), NOP(), BNE(1, 0, -8), EBREAK()]\n    requests = 0\n\n    def iready(pc):\n        nonlocal requests\n        if pc == 12:\n            requests += 1\n            # At PC 4 the previous issue's PC-12 fill collides with\n            # the read for PC 12. The row already holds a valid copy.\n            return requests <= 2 or requests == 6\n        return True\n\n    rets, _ = await _run(dut, program, initial_fetch_wait=1024, imem_ready=iready)\n    _check_path(rets, program, [0] + [4, 8, 12] * 3 + [16])\n    assert requests == 6\n\n\n@cocotb.test()\nasync def fence_i_after_stalled_code_store(dut):\n    replacement = ADDI(3, 0, 9)\n    program = [\n        ADDI(2, 0, 1), LW(5, 0, 0x80), JAL(0, 16),\n        SW(5, 0, 28), SW(5, 0, 24), FENCE_I(),\n        ADDI(3, 0, 1), ADDI(4, 3, 1), BEQ(2, 3, -20), EBREAK(),\n    ]\n    store_waits = 4\n    \n…[6333 of 9405 chars elided by tools/bench/transcript.py; sha256:2db31de6906d6e5e]…\n JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"radix4_path.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\",\n            \"hazard_unit.sv\", \"load_predictor.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
