DIV, ALU_DIVU, ALU_REM, ALU_REMU,\ncores/bench/test/test_alu.py:30:    dut.div_start.value = 0\ncores/bench/test/test_alu.py:31:    dut.div_consume.value = 0\ncores/bench/test/test_alu.py:35:    assert int(dut.div_ready.value) and not int(dut.div_valid.value)\ncores/bench/test/\n…[3912 of 6984 chars elided by tools/bench/transcript.py; sha256:2556c0309cfaa44f]…\nest_alu.py:286:            await _check_div(dut, op, a, b, r if op in (ALU_REM, ALU_REMU) else q)\ncores/bench/test/test_alu.py:290:async def reset_cancels_division(dut):\ncores/bench/test/test_alu.py:293:        dut.op.value = ALU_DIV\ncores/bench/test/test_alu.py:296:        dut.div_start.value = 1\ncores/bench/test/test_alu.py:298:        dut.div_start.value = 0\ncores/bench/test/test_alu.py:299:        for _ in range(rounds):\ncores/bench/test/test_alu.py:304:        assert int(dut.div_ready.value) and not int(dut.div_valid.value)\ncores/bench/test/test_alu.py:305:        await _check_div(dut, ALU_REMU, 27, 4, 3)\ncores/bench/test/test_decoder.py:12:    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\ncores/bench/test/test_decoder.py:67:        (0x023140B3, ALU_DIV),\ncores/bench/test/test_decoder.py:68:        (0x023150B3, ALU_DIVU),\ncores/bench/test/test_decoder.py:175:    for f3 in range(3, 8):\ncores/bench/test/test_decoder.py:230:    for f3 in range(1, 8):\ncores/bench/test/test_decoder.py:244:        for f3 in range(8):\n", "exit_code": 0, "status": "completed"}}
