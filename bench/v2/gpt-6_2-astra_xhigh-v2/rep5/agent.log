iled': True}.\"\"\"\n109:        return {\"placement_failed\": True, \"fmax_mhz\": None}\n114:        return {\"placement_failed\": True, \"fmax_mhz\": None, \"reason\": \"no Fmax in timing report\"}\n116:        \"placement_failed\": False,\n128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n148:def build(worktree: str | Path, rtl_dir: str | Path, bench_sv: str,\n155:    # Plain threads and blocking waits, no asyncio: agents run `make timing`\n158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n160:        return {\"place_option\": place_option, \"placement_failed\": True,\n164:    if res[\"placement_failed\"]:\n170:def build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\n179:def summarize(results: list[dict]) -> dict:\n180:    \"\"\"Median Fmax over placement options; every option must fit (the flow\n182:    failed = [r for r in results if r[\"placement_failed\"]]\n184:        return {\"placement_failed\": True,\n189:        \"placement_failed\": False,\n199:def main(argv=None) -> int:\n200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\n202:    import argparse, json\n204:    ap = argparse.ArgumentParser()\n209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\n214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\n216:        if r[\"placement_failed\"]:\n221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n","exit_code":0,"status":"completed"}}
