{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"sed -n '567,610p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py\"","aggregated_output":"@cocotb.test()\nasync def warm_reset_scrubs_first_and_last_load_rows(dut):\n    reads = []\n\n    def ready(addr, ren, wen):\n        assert not wen\n        if ren:\n            reads.append(addr)\n        return ren\n\n    low, high = LW(5, 0, 0), LW(5, 1, -4)\n    use = ADD(6, 5, 5)\n    program = [0x000010B7, low, use, high, use, low, use, high, use, EBREAK()]\n    rets, _ = await _run(dut, program, {0: 1, 4092: 2}, initial_fetch_wait=1024,\n                         dmem_ready=ready)\n    _check_straight_line(rets, program)\n    assert reads == [0, 4092]\n\n    # Read the first row twice during scrub. After scrub both rows must\n    # miss once, including the last row, untouched since the warm reset.\n    program = [0x000010B7, low, use, low, use, high, use, low, use, high, use, low, use, EBREAK()]\n    delay = 1024\n\n    def iready(pc):\n        nonlocal delay\n        if pc == 20 and delay:\n            delay -= 1\n            return False\n        return True\n\n    reads.clear()\n    rets, _ = await _run(dut, program, {0: 11, 4092: 22}, imem_ready=iready,\n                         dmem_ready=ready, max_cycles=1100)\n    _check_straight_line(rets, program)\n    assert delay == 0\n    assert reads == [0, 0, 4092, 0]\n    loads = [r for r in rets if r[\"mem_rmask\"]]\n    assert [r[\"mem_rdata\"] for r in loads] == [11, 11, 22, 11, 22, 11]\n    for load, add in zip(loads, _by_insn(rets, use)):\n        assert (load[\"rd_wdata\"], add[\"rd_wdata\"]) == (load[\"mem_rdata\"], 2 * load[\"mem_rdata\"])\n\n\n@cocotb.test()\nasync def held_ex_operands_and_matches(dut):\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n","exit_code":0,"status":"completed"}}
