$(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/pro\n…[1927 of 4999 chars elided by tools/bench/transcript.py; sha256:2fecd0602f70a87a]…\ns': 0,\n253:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n256:    # Bracketed cycles (start_time..stop_time) are the contract per\n262:    if not marker.get('bench_bracketed', False):\n263:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n268:    if elapsed_cycles <= 0:\n269:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n270:                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n271:    ipc = iterations / elapsed_cycles\n272:    return {'completed': True, 'iter_per_cycle': ipc, 'cycles': elapsed_cycles,\n273:            'iterations': iterations, 'bracketed_cycles': True}\n333:    Verilator CoreMark run (with random memory stalls) for cycles.\n343:        'cycles': int, 'iterations': int,\n387:        'cycles':        cm['cycles'],\n", "exit_code": 0, "status": "completed"}}
