{"type": "item.started", "item": {"id": "item_66", "type": "command_execution", "command": "/bin/bash -c 'cd \"$TMPDIR\"/benchstruct.Ki2472\ncat > lanes.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('base_rtl')\nfor n,parent in [(18,src),(19,src),(20,src),(21,Path('v12')),(22,src),(23,src)]:\n d=Path(f'v{n}')\n shutil.copytree(parent,d)\n co=(parent/'core.sv').read_text()\n f=(parent/'if_stage.sv').read_text()\n e=(parent/'ex_stage.sv').read_text()\n co=co.replace('  if_stage u_if', '''  logic [31:0] replay_instr;\n  logic live_exact1, live_exact2, replay_exact1, replay_exact2;\n  logic [31:0] lv1, lv2, rp1, rp2, lv_id1, lv_id2, rp_id1, rp_id2;\n  function automatic logic source_ready(input logic [4:0] addr);\n    source_ready = \"'!(addr != 0 && id_ex_w.ctrl.reg_write && id_ex_w.rd == addr) &&\n                   !(mem_bypass_en && ex_mem_w.rd == addr);\n  endfunction\n  assign live_exact1 = source_ready(io_imemData[19:15]);\n  assign live_exact2 = source_ready(io_imemData[24:20]);\n  assign replay_exact1 = source_ready(replay_instr[19:15]);\n  assign replay_exact2 = source_ready(replay_instr[24:20]);\n  if_stage u_if'\"''')\n a=co.index('    .rs1_data ')\n b=co.index('    .train ',a)\n co=co[:a]+'''    .live_eq(lv1 == lv2), .cached_eq(rp1 == rp2),\n    .live_ready1(live_exact1), .live_ready2(live_exact2),\n    .cached_ready1(replay_exact1), .cached_ready2(replay_exact2),\n    .live_base(lv1), .cached_base(rp1), .replay_instr(replay_instr),\n'''+co[b:]\n a=co.index('  reg_file u_rf')\n b=co.index('  // ── EX ',a)\n orig=co[a:b]\n part=''\n for kind,source,pre in [('live','io_imemData','lv'),('replay','replay_instr','rp')]:\n  rf=orig.replace('reg_file u_rf (','reg_file u_rf_'+kind+' (').replace('(rs1_addr_w)',f'({source}[19:15])').replace('(rs2_addr_w)',f'({source}[24:20])')\n  for i in [1,2]:\n   rf=rf.replace(f'(fetch_rs{i}_data)',f'({pre}{i})').replace(f'(id_rs{i}_data)',f'({pre}_id{i})')\n  part+=rf\n if n==20:\n  part+=orig\n else:\n  part+='''  assign id_rs1_data = io_imemReady ? lv_id1 : rp_id1;\n  assign id_rs2_data = io_imemReady ? lv_id2 : rp_id2;\n'''\n co=co[:a]+part+co[b:]\n a=f.index('  input  logic [31:0] rs1_data')\n b=f.index('  input  logic        train,',a)\n f=f[:a]+'''  input logic live_eq, cached_eq,\n  input logic live_ready1, live_ready2, cached_ready1, cached_ready2,\n  input logic [31:0] live_base, cached_base,\n  output logic [31:0] replay_instr,\n'''+f[b:]\n a=f.index('  assign eq_branch_ready')\n b=f.index('  // Opcode',a)\n custom='''  assign replay_instr = candidate.instr;\n  logic live_dir, cached_dir;\n  assign live_dir = (imem_data[14:13] == 0 && live_ready1 && live_ready2) ?\n                    (live_eq \"'^ imem_data[12]) : counter[1];\n  assign cached_dir = (replay_instr[14:13] == 0 && cached_ready1 && cached_ready2) ?\n                    (cached_eq ''^ replay_instr[12]) : counter[1];\n  assign branch_direction = imem_ready ? live_dir : cached_dir;\n'\"'''\n f=f[:a]+custom+f[b:]\n a=f.index('  assign jalr_taken')\n b=f.index('  // Every admitted',a)\n f=f[:a]+'''  logic live_jalr, cached_jalr;\n  assign live_jalr = imem_data[6:0] == 7'b1100111 && imem_data[14:12] == 0 &&\n                     imem_data[31:20] == 0 && live_ready1 && live_base[31:20] == 0 && \"'!live_base[1];\n  assign cached_jalr = replay_instr[6:0] == 7'\"'b1100111 && replay_instr[14:12] == 0 &&\n                     replay_instr[31:20] == 0 && cached_ready1 && cached_base[31:20] == 0 && \"'!cached_base[1];\n  assign jalr_taken = imem_ready ? live_jalr : cached_jalr;\n'\"'''+f[b:]\n f=f.replace('rs1_data[19:2]','(imem_ready ? live_base[19:2] : cached_base[19:2])')\n if n in [19,21,22,23]:\n  # Both direct recovery addresses already cross ID/EX.\n  e=e.replace(': in.alternate_pc;', ': (in.predicted_taken ? in.pc_plus4[31:2] : in.direct_target[31:2]);')\n if n==22:\n  # Complete the two ID low-address additions before the bus selects a lane.\n  co=co.replace(\\\"{1'b0, id_rs1_data[11:0]} + {1'b0, if_id_w.instr[31:20]}\\\",'''io_imemReady ? ({1'b0, lv_id1[11:0]} + {1'b0, io_imemData[31:20]}) :\n                                ({1'b0, rp_id1[11:0]} + {1'b0, replay_instr[31:20]})''')\n if n==23:\n  # On an external MEM load bypass, always consult the bus for this probe.\n  # Both stored copies already have an independent asynchronous path here.\n  co=co.replace(\\\"{1'b0, id_rs1_data[11:0]} + {1'b0, if_id_w.instr[31:20]}\\\",'''io_imemReady ? ({1'b0, lv1[11:0]} + {1'b0, io_imemData[31:20]}) :\n                                ({1'b0, rp1[11:0]} + {1'b0, replay_instr[31:20]})''')\n  co=co.replace(\\\"ready_ram_q <= rs1_ex_ready\\\", \\\"ready_ram_q <= \"'!(mem_bypass_en && ex_mem_w.rd == rs1_addr_w) && rs1_ex_ready\")\n (d/'\"'ex_stage.sv').write_text(e)\n (d/'core.sv').write_text(co)\n (d/'if_stage.sv').write_text(f)\nPY\npython lanes.py\nfor n in 12 13 14 16; do cut -c1-200 \\\"v\"'$n-p1.log\"; done'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
