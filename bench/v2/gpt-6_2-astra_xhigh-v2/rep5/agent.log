value would predict fallthrough.\n1243:        b: BEQ(0, 2, c - b),\n1244:        c: _b(8, 0, 0, 2, 0x63),          # reserved branch funct3\n1249:        e + 4: _i(0, 0, 1, 0, 0x67),      # reserved JALR funct3\n1264:async def predicted_and_recovered_jumps(dut):\n1267:        ADDI(5, 0, 17), ADDI(9, 0, 69), JALR(1, 5, 0), store,  # MEM base targets 16\n1268:        ADDI(5, 0, 32), JALR(2, 5, 0), store,         # busy base targets 32\n1269:        JAL(4, 16), JALR(3, 5, -4), store, store,     # signed displacement targets 28\n1270:        ADDI(5, 0, 51), NOP(), JALR(6, 5, 0),         # bit one set, trap\n1271:        ADDI(7, 4, 1), JALR(8, 9, 0), store, EBREAK(), # ready odd base predicts 68\n1308:    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n1311:        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n1406:            \"hazard_unit.sv\", \"load_predictor.sv\",\n","exit_code":0,"status":"completed"}}
