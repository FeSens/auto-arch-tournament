{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv; cat cores/bench/core.yaml; cat .gitignore'", "aggregated_output": "// IF and ID share the instruction bus and register-file read addresses.\n// The PC is the fetch register. ID/EX captures the prediction on issue.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        stall,\n  input  logic        issue,\n  input  logic        stall_id,\n  input  logic        redirect,\n  input  logic [31:2] redirect_target,\n  input  logic [31:0] rs1_data,\n  input  logic [31:0] rs2_data,\n  input  logic        rs1_ready,\n  input  logic        rs2_ready,\n  input  logic        train,\n  input  logic [6:0]  train_index,\n  input  logic [1:0]  train_counter,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  input  logic        imem_ready,\n  output if_id_t      out\n);\n  logic [31:2] pc_word;\n  logic [31:0] pc, pc_plus4, direct_target, direct_offset;\n  logic        is_jal, is_branch, eq_branch_ready, branch_direction;\n  logic        direct_taken, jalr_taken;\n\n  // Each issued PC names a row. Its successor is learned only when the\n  // bus supplies an instruction that actually enters EX.\n  typedef struct packed {\n    logic        valid;\n    logic [19:2] pc;\n    logic [31:0] instr;\n  } successor_t;\n  (* syn_ramstyle = \"block_ram\" *) logic [50:0] successors [0:511];\n  successor_t candidate;\n  logic [8:0] predecessor, successor_write_index;\n  logic [9:0] scrub;\n  logic predecessor_valid, lookup_valid, in_window, learn, lookup, hit;\n  logic fence_issue, fence_in_ex;\n  logic [31:0] instr;\n\n  assign in_window = pc[31:20] == 0;\n  assign learn = predecessor_valid && imem_ready && in_window;\n  assign successor_write_index = scrub[9] ? predecessor : scrub[8:0];\n  assign lookup = scrub[9] && !(learn && predecessor == pc[10:2]);\n  always_ff @(posedge clock) begin\n    if (!scrub[9] || (issue && learn))\n      successors[successor_write_index] <= {scrub[9], pc[19:2], imem_data};\n    if (issue && lookup)\n      candidate <= successors[pc[10:2]];\n  end\n\n  assign hit = lookup_valid && candidate.valid && in_window && candidate.pc == pc[19:2];\n  assign instr = imem_ready\n…[9595 of 12667 chars elided by tools/bench/transcript.py; sha256:1b4dfcf463d7d99e]…\npshot: PATH + resolved EDA tool paths)\n# IS tracked, decided at the first v2 rep publish (e1a static, 2026-07-16):\n# it is tiny, contains no secrets, and pins which toolchain binaries\n# produced each rep's numbers.\n\n# Throwaway harness-verification runs (one-model YAMLs + their output\n# trees). These are reliability checks, not benchmark data — output is\n# regenerable and the YAMLs only encode \"rerun this single model to\n# confirm a fix landed\". Naming convention: `*-verify` for output dirs,\n# `models-*-verify.yaml` for the throwaway model YAML.\nbench/*-verify/\nbench/smoke-*/\ntools/bench/models-*-verify.yaml\n\n# Aborted/partial bench output preserved locally with a debug-tag suffix\n# (e.g. `gpt-5_5.failed-pwd-bug/`, `gpt-5_5.validate-v3/`, sibling\n# `results.jsonl.<tag>`). They document a known-broken state for the\n# author's own postmortem; the canonical results live in the un-suffixed\n# per-model dirs.\nbench/*.failed-*\nbench/*.validate-*\nbench/*.prev-*\nbench/*.stale-*\nbench/*.partial-*\nbench/results.jsonl.*\n", "exit_code": 0, "status": "completed"}}
