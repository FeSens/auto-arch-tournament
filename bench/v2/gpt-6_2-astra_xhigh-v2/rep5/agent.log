{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/hazard_unit.sv'","aggregated_output":"// Hold the pipeline behind a waiting memory operation or divide. A\n// load-use interlock holds the PC and inserts a single bubble into EX.\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] if_id_rs1,\n  input  logic [4:0] if_id_rs2,\n  input  logic       redirect,\n  input  logic       imem_ready,\n  input  logic       dmem_ready,\n  input  logic       ex_mem_mem_op,\n  input  logic       div_wait,\n  output logic       stall_if,\n  output logic       stall_id,\n  output logic       flush_id,\n  output logic       stall_ex_mem,\n  output logic       hold_mem_wb\n);\n  logic load_use_hazard;\n\n  assign load_use_hazard = imem_ready && id_ex_mem_read && id_ex_rd != 0 &&\n                           (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign stall_ex_mem = ex_mem_mem_op && !dmem_ready;\n  assign hold_mem_wb  = stall_ex_mem;\n  assign stall_id     = stall_ex_mem || div_wait;\n  assign stall_if     = stall_id || load_use_hazard || !imem_ready;\n  assign flush_id     = redirect || load_use_hazard;\nendmodule\n","exit_code":0,"status":"completed"}}
