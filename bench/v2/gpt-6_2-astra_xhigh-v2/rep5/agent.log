{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/fetchkey.py\" <<'\"'PY'\nfrom loadopt_try import *\nfrom loadopt_fetch import fetch\nimport subprocess,os\ndef sim(n):\n    p=base/n\n    with (p/'build.log').open('w') as f:\n        subprocess.run(['bash','test/cosim/build.sh'],env={**os.environ,'RTL_DIR':str(p/'rtl'),'OBJ_DIR':str(p/'obj'),'NRET':'1'},stdout=f,stderr=subprocess.STDOUT,check=True)\n    with (p/'sim.log').open('w') as f:\n        subprocess.run([str(p/'obj/cosim_sim'),str(Path(tempfile.gettempdir())/'coremark.elf'),'50000000','--bench','--istall','--dstall'],stdout=f,check=True)\n    import json\n    from tools.eval.fpga import validate_coremark_uart\n    r=json.loads((p/'sim.log').read_text().splitlines()[-1])\n    print(n,r['bench_stop_cycle']-r['bench_start_cycle'],validate_coremark_uart(r['uart'],10),r['oob'],flush=True)\n\ndef setupkey(n):\n    fetch(n+'flags')\n    p=base/n/'rtl'\n    if p.exists(): shutil.rmtree(p)\n    p.parent.mkdir(parents=True,exist_ok=True)\n    shutil.move(base/(n+'flags')/'rtl',p)\n    f=p/'if_stage.sv';s=f.read_text()\n    rf=p/'reg_file.sv';r=rf.read_text()\n    c=p/'core.sv';t=c.read_text()\n    if n.startswith('sign'):\n        r=r.replace('  output logic rs1_nz','  output logic rs1_neg, rs2_neg,\\\\n  output logic rs1_nz').replace('  logic [31:0] nonzero','  logic [31:0] negative;\\\\n  logic [31:0] nonzero').replace(\\\"      nonzero <= '0;\\\",\\\"      negative <= '0;\\\\n      nonzero <= '0;\\\").replace('      nonzero[w_addr] <= |w_data;', '      negative[w_addr] <= w_data[31];\\\\n      nonzero[w_addr] <= |w_data;').replace('  assign rs1_nz','  assign rs1_neg = negative[rs1_addr];\\\\n  assign rs2_neg = negative[rs2_addr];\\\\n  assign rs1_nz')\n        t=t.replace('  wire rs1_nz','  wire rs1_neg, rs2_neg;\\\\n  wire rs1_nz').replace('.rs1_nz(rs1_nz)', '.rs1_neg(rs1_neg), .rs2_neg(rs2_neg), .rs1_nz(rs1_nz)')\n        s=s.replace('  input logic rs1_nz','  input logic rs1_neg, rs2_neg,\\\\n  input logic rs1_nz')\n        a=s.index('  assign eq_branch_ready')\n        b=s.index('  // Opcode bit',a)\n        s=s[:a]+\\\"\\\"\\\"\n  wire both_avail = rs1_ready && rs2_ready;\n  wire unequal_signs = rs1_neg \"'^ rs2_neg;\n  wire known = unequal_signs || !(rs1_nz && rs2_nz);\n  wire lt = unequal_signs ? (instr[13] ? rs2_neg : rs1_neg) : (!rs1_nz && rs2_nz);\n  wire eq = !(rs1_nz || rs2_nz);\n  assign branch_direction = both_avail && known ?\n                      ((instr[14] ? lt : eq) ''^ instr[12]) : counter[1];\n\"\"\"+s[b:]\n    elif n.startswith('\"'hash'):\n        width=int(n[4])\n        r=r.replace('  output logic rs1_nz',f'  output logic [{width-1}:0] sig1,sig2,\\\\n  output logic rs1_nz')\n        lock='  logic [31:0] nonzero'\n        exp='{' + ', '.join('('+' \"'^ '\"'.join(f'w_data[{i}]' for i in range(start,32,width))+')' for start in reversed(range(width))) + '}'\n        if 'low' in n:exp=f'w_data[{width-1}:0]'\n        r=r.replace(lock,f'  logic [{width-1}:0] sigs [0:31];\\\\n  logic [{width-1}:0] sig;\\\\n  assign sig = {exp};\\\\n'+lock)\n        r=r.replace('      nonzero[w_addr] <= |w_data;', '      sigs[w_addr] <= sig;\\\\n      nonzero[w_addr] <= |w_data;')\n        # On reset the consumed signature of an unwritten RF register should be zero.\n        r=r.replace('  assign rs1_nz','  assign sig1 = written[rs1_addr] ? sigs[rs1_addr] : 0;\\\\n  assign sig2 = written[rs2_addr] ? sigs[rs2_addr] : 0;\\\\n  assign rs1_nz')\n        t=t.replace('  wire rs1_nz',f'  wire [{width-1}:0] sig1,sig2;\\\\n  wire rs1_nz').replace('.rs1_nz(rs1_nz)', '.sig1(sig1),.sig2(sig2), .rs1_nz(rs1_nz)')\n        s=s.replace('  input logic rs1_nz',f'  input logic [{width-1}:0] sig1,sig2,\\\\n  input logic rs1_nz')\n        s=s.replace(' && \"'!(rs1_nz && rs2_nz);'\"',';').replace('(rs1_nz == rs2_nz)','(sig1 == sig2)')\n    elif n=='zero2':\n        s=s.replace(' && \"'!(rs1_nz && rs2_nz);'\"',' && (instr[24:20] == 0 || instr[19:15] == 0);').replace('(rs1_nz == rs2_nz)','\"'!(rs1_nz || rs2_nz)'\"')\n    elif n=='zero3':\n        s=s.replace(' && \"'!(rs1_nz && rs2_nz);'\"',' && instr[24:20] == 0;').replace('(rs1_nz == rs2_nz)','\"'!rs1_nz'\"')\n    f.write_text(s);rf.write_text(r);c.write_text(t)\n\nif __name__=='__main__':\n    names=sys.argv[1:]\n    for n in names:setupkey(n)\n    with ThreadPoolExecutor(max_workers=4) as ex:list(ex.map(run,names))\nPY\nPYTHONPATH=. python -u \\\"\"'$TMPDIR/fetchkey.py\" signzero hash4low zero2 zero3'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
