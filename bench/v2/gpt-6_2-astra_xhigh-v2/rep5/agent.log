,\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[1058 of 4130 chars elided by tools/bench/transcript.py; sha256:e9a688993ab632af]…\nt Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n cores/bench/rtl/core.sv     | 15 +++++++++--\n cores/bench/rtl/core_pkg.sv |  2 ++\n cores/bench/rtl/ex_stage.sv | 37 ++++++++++++++-------------\n cores/bench/rtl/id_stage.sv |  1 +\n cores/bench/rtl/if_stage.sv | 62 ++++++++++++++++++++++++++++++++++-----------\n 5 files changed, 83 insertions(+), 34 deletions(-)\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\ntotal 24\ndrwxrwx---+  7 nobody    nogroup   4096 Nov 22 03:45 .\ndrwxrwx---+  4 nobody    nogroup   4096 Nov 22 03:44 ..\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 22 03:45 .agents\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 22 03:45 .aws\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 22 03:45 .codex\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 22 03:45 .git\ndrwxrwx---+ 12 hwebench2 hwebench2 4096 Nov 22 03:45 codex-bwrap-synthetic-mount-targets-1002\n996K\tformal/riscv-formal/checks\n4.5M\tformal/riscv-formal/insns\n796K\tformal/riscv-formal/cores\n", "exit_code": 0, "status": "completed"}}
