ndex','logic [31:0]  early_base').replace('logic         port_valid','logic         source_valid')\n  a=s.index('  logic [9:0] read_row;'); b=s.index('  (* syn_ramstyle',a)\n  x='''  logic [9:0] read_row;\n  logic [12:0] low_sum;\n  logic [2:0] early_lane;\n  logic [12:0] early_sum;\n  logic direct_ok, early_ok;\n  assign low_sum = {1'b0,base[11:0]} + {1'b0,i_imm};\n  assign early_sum = {1'b0,early_base[11:0]} + {1'b0,i_imm};\n  assign early_lane = {1'b0,early_base[1:0]} + {1'b0,i_imm[1:0]};\n  assign direct_ok = base[31:20] == 0 && low_sum[12] == i_imm[11];\n'''\n  if add:\n   x+='''  assign early_ok = source_valid && early_base[31:20] == 0 && early_sum[12] == i_imm[11];\n  assign read_row = base_ready ? low_sum[11:2] : early_sum[11:2];\n'''\n  else:\n   x+='''  assign early_ok = source_valid && early_base[31:20] == 0 && i_imm[11:2] == 0 && \"'!early_lane[2];\n  assign read_row = base_ready ? low_sum[11:2] : early_base[11:2];\n'\"'''\n  if banked:\n   x+='''  logic [7:0] saved_page, saved_early_page;\n  logic saved_ok, saved_early_ok;\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      saved_page <= base[19:12];\n      saved_early_page <= early_base[19:12];\n      saved_ok <= base_ready && direct_ok;\n      saved_early_ok <= \"'!base_ready && early_ok;\n      probe_offset <= base_ready ? low_sum[1:0] : early_lane[1:0];\n    end\n  end\n  assign tag_hit = (saved_ok && saved_page == candidate.word_addr[19:12]) ||\n                   (saved_early_ok && saved_early_page == candidate.word_addr[19:12]);\n'\"'''\n  else:\n   x+='''  logic [7:0] saved_page;\n  logic saved_ok;\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      saved_page <= base_ready ? base[19:12] : early_base[19:12];\n      saved_ok <= base_ready ? direct_ok : early_ok;\n      probe_offset <= base_ready ? low_sum[1:0] : early_lane[1:0];\n    end\n  end\n  assign tag_hit = saved_ok && saved_page == candidate.word_addr[19:12];\n'''\n  if mode=='lazy':\n   x=x.replace('logic [7