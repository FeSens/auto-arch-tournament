{"type":"item.started","item":{"id":"item_106","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR\"/benchstruct.Ki2472\ncat > signature.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nfor n,bits,style,dual,coll in [(42,5,'fold',False,False),(43,4,'stripe',True,False),(44,6,'stripe',True,False),(45,5,'fold',True,False),(46,4,'stripe',False,False),(47,8,'low',True,False),(48,5,'fold',True,True)]:\n src=Path('v26'); d=Path(f'v{n}'); shutil.copytree(src,d)\n rf=(src/'reg_file.sv').read_text()\n co=(src/'core.sv').read_text()\n f=(src/'if_stage.sv').read_text()\n e=(src/'ex_stage.sv').read_text()\n if not coll: # Route the precomputed alternative PC using the champion's interface.\n  e=Path('base_rtl/ex_stage.sv').read_text()\n args=['rs1_addr','rs2_addr']\n ports=''\n if dual:\n  args=['live_a','live_b','replay_a','replay_b']\n  ports='  input logic [4:0] live_a, live_b, replay_a, replay_b,\\\\n'\n  co=co.replace('  logic rs1_zero, rs2_zero, rs1_bad;','  logic [31:0] replay_instr;\\\\n  logic rs1_zero, rs2_zero, rs1_bad;')\n  f=f.replace('  input logic rs1_zero,','  output logic [31:0] replay_instr,\\\\n  input logic rs1_zero,').replace('  assign in_window','  assign replay_instr = candidate.instr;\\\\n  assign in_window')\n  co=co.replace('  if_stage u_if (', '  if_stage u_if (\\\\n    .replay_instr(replay_instr),')\n  co=co.replace('  reg_file u_rf (', '  reg_file u_rf (\\\\n    .live_a(io_imemData[19:15]), .live_b(io_imemData[24:20]),\\\\n    .replay_a(replay_instr[19:15]), .replay_b(replay_instr[24:20]),')\n if style=='fold':\n  expr=' \"'^ '\"'.join(f\\\"{bits}'(w_data >> {x})\\\" for x in range(0,32,bits))\n elif style=='stripe':\n  expr='{'+', '.join(f'w_data[{x}]' for x in ([31,16,5,0] if bits==4 else [31,16,8,5,2,0]))+'}'\n else: expr=f'w_data[{bits-1}:0]'\n add=f'  logic [{bits-1}:0] signature;\\\\n  assign signature = {expr};\\\\n'\n for arg in args:\n  add+=f'''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [{bits-1}:0] sig_{arg} [0:31];\n  always_ff @(posedge clock) if (write_word) sig_{arg}[w_addr] <= signature;\n  wire [{bits-1}:0] v_{arg} = written[{arg}] ? sig_{arg}[{arg}] : '0;\n'''\n cmpnames=['live_equal','replay_equal'] if dual else ['sig_equal']\n for i,name in enumerate(cmpnames):\n  add+=f'  assign {name} = v_{args[2*i]} == v_{args[2*i+1]};\\\\n'\n ports+='  output logic '+', '.join(cmpnames)+',\\\\n'\n rf=rf.replace('  input  logic        w_en,',ports+'  input  logic        w_en,').replace('endmodule',add+'endmodule')\n for name in cmpnames:\n  f=f.replace('  input logic rs1_zero,',f'  input logic {name},\\\\n  input logic rs1_zero,')\n  co=co.replace('  logic rs1_zero,',f'  logic {name};\\\\n  logic rs1_zero,').replace('  if_stage u_if (',f'  if_stage u_if (\\\\n    .{name}({name}),').replace('  reg_file u_rf (',f'  reg_file u_rf (\\\\n    .{name}({name}),')\n a=f.index('  assign branch_direction')\n b=f.index(';',a)\n cmp='(imem_ready ? live_equal : replay_equal)' if dual else 'sig_equal'\n f=f[:a]+f'  assign branch_direction = eq_branch_ready ? ({cmp} \"'^ instr[12]) : counter[1]'\"'+f[b:]\n (d/'core.sv').write_text(co); (d/'ex_stage.sv').write_text(e); (d/'if_stage.sv').write_text(f); (d/'reg_file.sv').write_text(rf)\nPY\npython signature.py\npython totals.py | tail -15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
