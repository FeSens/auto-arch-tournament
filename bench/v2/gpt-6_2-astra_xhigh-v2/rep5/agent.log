         break\n \n         # Drive next cycle's imem fetch and dmem read combinationally.\n+        dut.io_imemReady.value = int(imem_ready(ia)) if imem_ready else 1\n         dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n         dut.io_dmemRData.value = dmem.get(da & ~3, 0) if ready else 0xdeadbeef\n+     \n…[4745 of 7817 chars elided by tools/bench/transcript.py; sha256:590896755fa9c29d]…\nnch_failed': True, 'placement_failed': False,\n                'reason': 'fpga_report_unparsed: no Logic/Register count in Gowin report',\n                'fmax_mhz': fp['fmax_mhz'], 'seeds': fp['seeds']}\n\n    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n    if not cm['completed']:\n        return {\n            'bench_failed': True,\n            'reason': cm.get('reason', 'unknown'),\n            'fmax_mhz': fp['fmax_mhz'],\n            'seeds': fp['seeds'],\n            'placement_failed': False,\n        }\n\n    fitness = fp['fmax_mhz'] * cm['iter_per_cycle'] * 1_000_000  # iter/sec\n    return {\n        **fp,\n        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n        'fitness':       round(fitness, 2),\n        'cycles':        cm['cycles'],\n        'iterations':    cm['iterations'],\n    }\n\nif __name__ == '__main__':\n    import sys\n    result = run_fpga_eval(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n", "exit_code": 0, "status": "completed"}}
