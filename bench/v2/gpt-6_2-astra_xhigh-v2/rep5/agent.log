{"type": "item.completed", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py | head -200 && cat formal/checks_si.cfg | head -140'", "aggregated_output": "\"\"\"Check the integer ALU, registered product and clocked DIV/REM interface.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.advance.value = 0\n    dut.mul_rs1.value = 0\n    dut.mul_rs2.value = 0\n    dut.div_start.value = 0\n    dut.div_consume.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0):\n    assert int(dut.div_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    await _tick(dut)\n\n    # Forwarded inputs can change immediately after issue.\n    dut.div_start.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = (~a) & MASK32\n    dut.b.value = (~b) & MASK32\n    # PREP registers 3D from the captured divisor.\n    assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n    await _tick(dut)\n    for _ in range(6):  # Both divisor ranges finish on the sixth RUN edge.\n        assert not int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _tick(dut)\n\n    for _\n…[4210 of 7282 chars elided by tools/bench/transcript.py; sha256:85e22261bf75fa3f]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
