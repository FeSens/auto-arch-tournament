_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[3641 of 6713 chars elided by tools/bench/transcript.py; sha256:3f4a51bb14c9776b]…\n(reset) begin\n      state      <= 32'h8E1D9142;\n      imem_ready <= 1'b1;\n      dmem_ready <= 1'b1;\n    end else begin\n      state      <= next_d;\n      imem_ready <= accept(next_i);\n      dmem_ready <= accept(next_d);\n    end\n  end\n\nendmodule\n27:static bool oob_access = false;  // sticky: once set, final marker reports it\n32:// Benchmark-time MMIO markers. CoreMark's portme.c writes to BENCH_START\n70:    //           (tools/eval/fpga.py:run_coremark_ipc) passes BOTH so the\n131:        //     allowed (markers); anything else outside dmem is OOB (handled\n152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\n253:        // Emit final record, plus an explicit completion marker. Consumers MUST\n22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\n23:GOWIN_VERSION = \"1.9.11.03 Education\"\n35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n", "exit_code": 0, "status": "completed"}}
