range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n       \n…[13079 of 16151 chars elided by tools/bench/transcript.py; sha256:480bc0060d0da741]…\nsees a changed live word despite a matching prediction.\n    # Third call must wait for the second patch even after replay is enabled.\n    expected = program.copy()\n    insns = []\n    for pc in pcs:\n        insns.append(expected[pc // 4])\n        if pc == 8:\n            expected[(entry + 8) // 4] = replacement\n        if pc == 16:\n            expected[(entry + 12) // 4] = replacement\n    _check_path(rets, program, pcs, insns)\n    assert scrub_wait == miss_wait == 0\n\n\n@cocotb.test()\nasync def aliased_counter_and_prediction_guards(dut):\n    # The branches are 512 bytes apart and share one counter. A taken BLT\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"radix4_path.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\",\n            \"hazard_unit.sv\", \"load_predictor.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
