{"type": "item.completed", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c \"sed -n '75,170p;310,495p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    An optional dmem_ready(addr, ren, wen) selects which requests are accepted.\n    Accepted stores update the Python-side dmem dict.\n    imem_ready(cycle, pc) can deny a fetch. fetch_pcs records each bus\n    address, including held requests and the slot discarded on recovery.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    await Timer(1, \"ns\")\n    dut.reset.value = 0\n\n    for cycle in range(max_cycles):\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        ready = dmem_ready(da, ren, wen) if dmem_ready else True\n        dut.io_dmemReady.value = int(ready)\n        dut.io_imemReady.value = int(imem_ready(cycle, ia) if imem_ready else True)\n        if fetch_pcs is not None:\n            fetch_pcs.append(ia)\n        if wen and ready:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"orde\n…[7879 of 10951 chars elided by tools/bench/transcript.py; sha256:de6b36a26bc70105]…\ns == 4)\n\n    fetches = []\n    rets, dmem = await _run(dut, program, {0x40: 1, 0x44: 17}, dmem_ready=data_ready,\n                            imem_ready=fetch_ready, fetch_pcs=fetches)\n    assert requests == [(0x40, 1, 0)] + [(0x44, 1, 0)] * 4\n    assert fetches[:8] == [0, 4, 8, 12, 12, 12, 12, 16]\n    _check_path(rets, [0, 4, 8, 16])\n    assert rets[2][\"rs1_rdata\"] == 1\n    assert all(r[\"trap\"] == 0 for r in rets)\n    assert 0x48 not in dmem\n\n\n@cocotb.test()\nasync def undelivered_store_after_load(dut):\n    program = [LW(1, 0, 0x40), SW(1, 0, 0x44), EBREAK()]\n    stores = []\n\n    def data_ready(addr, ren, wen):\n        if wen:\n            stores.append((addr, wen))\n        return True\n\n    # The raw store data is on imem for two denied cycles. Only the\n    # accepted copy may reach the data bus, even with its load-use match.\n    rets, dmem = await _run(dut, program, {0x40: 123}, dmem_ready=data_ready,\n                            imem_ready=lambda cycle, pc: cycle not in (1, 2))\n    _check_path(rets, [0, 4, 8])\n", "exit_code": 0, "status": "completed"}}
