logic [31:0]        write_result,\n  // MEM/WB register output\n  output mem_wb_t  out\n);\n\n  logic [3:0]  byte_mask;\n  logic [31:0] load_data;\n\n  // Misaligned mem-access trap. RV32I requires word-aligned LW/SW and\n  // halfword-aligned LH/LHU/SH; byte ops are always aligned.\n  // riscv-formal's RISCV_F\n…[1337 of 4409 chars elided by tools/bench/transcript.py; sha256:838690b56d81f9ff]…\ndge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (hold_wb) begin\n      // The preceding instruction has already retired.\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.rd_data    <= write_result;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= (mem_op && !mem_misalign) ? {in.alu_result[31:2], 2'b00} : 32'b0;\n      reg_q.mem_rdata  <= in.early_done ? in.early_rdata : dmem_rdata;\n      reg_q.mem_wdata  <= dmem_wdata;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
