ssign redirect        = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n-  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\n+  // Check alignment in parallel with the branch condition. The same\n+  // resolved target feeds fetch and the retiring instruction's next PC.\n+  assign target_aligned = redirect_target[1:0] == 2'b00;\n+  assign transfer_taken = branch_taken || in.ctrl.is_jump;\n+  assign misalign_fault = transfer_taken && !target_aligned;\n+  assign redirect       = transfer_taken && target_aligned;\n \n   // ── EX/MEM register ───────────────────────────────────────────────────\n   ex_mem_t reg_q;\n@@ -149,10 +146,7 @@ module ex_stage (\n       // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n       // (asserting next retirement's pc_rdata == this pc_wdata) stays\n       // consistent with the suppressed redirect.\n-      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\n-                            : in.ctrl.is_jump   ? jump_target\n-                            : branch_taken      ? branch_target\n-                                                : (in.pc + 32'd4);\n+      reg_q.pc_next       <= redirect ? redirect_target : (in.pc + 32'd4);\n       reg_q.branch_taken  <= branch_taken;\n       reg_q.branch_target <= branch_target;\n       reg_q.ctrl          <= ctrl_with_trap;\n05:28:33\n","exit_code":0,"status":"completed"}}
