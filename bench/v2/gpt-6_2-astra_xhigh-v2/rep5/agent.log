{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor9/ahead.py\" <<'\"'PY'\nimport os,sys,shutil\nfrom pathlib import Path\nd=Path(os.environ['TMPDIR'])/'predictor9'; name=sys.argv[1]; width=int(sys.argv[2]); o=d/name\nshutil.copytree('cores/bench/rtl',o,dirs_exist_ok=True)\nf=o/'if_stage.sv';s=f.read_text();a=s.index('  (* syn_ramstyle = \\\"block_ram\\\" *)');b=s.index('  // An older store',a)\ns=s[:a]+'''  localparam int W = WIDTH;\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [50:0] successors [0:(1<<W)-1];\n  successor_t raw, held, candidate;\n  logic [W-1:0] prev, older, pending_index;\n  logic [W:0] scrub;\n  logic have_prev, have_older, launched, raw_ok, held_ok, lookup_valid;\n  logic pending, in_window, hit, fence_issue, fence_in_ex;\n  successor_t pending_word;\n  logic [31:0] instr;\n\n  assign in_window = pc[31:20] == 0;\n  assign hit = lookup_valid && candidate.valid && in_window && candidate.pc == pc[19:2];\n  assign instr = imem_ready ? imem_data : candidate.instr;\n  assign fence_issue = issue && instr[6:0] == 7'b0001111 && instr[14:12] == 3'b001;\n\n  // The single write port serves scrub and captured fills. The raw output\n  // is always read, and only issued lookups can enter the prediction pipeline.\n  always_ff @(posedge clock) begin\n    if (\"'!scrub[W])\n      successors[scrub[W-1:0]] <= '\"'0;\n    else if (pending)\n      successors[pending_index] <= pending_word;\n    raw <= successors[pc[W+1:2]];\n  end\n  always_ff @(posedge clock) begin\n    pending_index <= older;\n    pending_word <= {1'b1, pc[19:2], imem_data};\n    raw_ok <= scrub[W] && \"'!(pending && pending_index == pc[W+1:2]);\n    if (launched) begin\n      held <= raw;\n      held_ok <= raw_ok;\n    end\n    if (issue) begin\n      candidate <= launched ? raw : held;\n      older <= prev;\n      prev <= pc[W+1:2];\n    end\n    if (reset || fence_issue) begin\n      scrub <= '\"'0;\n      pending <= 1'b0