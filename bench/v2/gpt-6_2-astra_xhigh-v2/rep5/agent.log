{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/predictor/proposed/test/test_pipeline.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def jalr_uses_exmem_operand_at_fetch(dut):\n    j = JALR(5, 1, 0)\n    rs, mem = await _run(dut, [ADDI(1, 0, 17), NOP(), j, SW(1, 0, 0), EBREAK()])\n    b, end = rs[-2:]\n    assert b['insn'] == j and b['pc_next'] == 16 and b['rd_wdata'] == 12\n    assert end['pc'] == 16 and end['cycle'] == b['cycle'] + 1 and not mem\n\n@cocotb.test()\nasync def jalr_waits_for_younger_writer(dut):\n    j = JALR(3, 1, 0)\n    rs, mem = await _run(dut, [ADDI(1, 0, 20), ADDI(1, 0, 28), j, SW(1, 0, 0), EBREAK(), SW(1, 0, 4), EBREAK(), EBREAK()])\n    b, end = rs[-2:]\n    assert b['insn'] == j and b['pc_next'] == 28 and b['rd_wdata'] == 12\n    assert end['pc'] == 28 and not mem\n\n@cocotb.test()\nasync def jalr_rejects_misaligned_available_operand(dut):\n    j = JALR(3, 1, 0)\n    rs, mem = await _run(dut, [ADDI(1, 0, 23), NOP(), j, EBREAK(), NOP(), SW(1, 0, 0)])\n    b, end = rs[-2:]\n    assert b['insn'] == j and b['trap'] and not b['rd'] and b['pc_next'] == 12\n    assert end['pc'] == 12 and not mem\n\n@cocotb.test()\nasync def ready_signed_comparison_steers_first_encounter(dut):\n    branch = _b(8, 0, 1, 4, 0x63)\n    rs, mem = await _run(dut, [ADDI(1, 0, -1), NOP(), branch, SW(1, 0, 0), EBREAK()])\n    b, end = rs[-2:]\n    assert b['insn'] == branch and b['pc_next'] == 16\n    assert end['pc'] == 16 and end['cycle'] == b['cycle'] + 1 and not mem\nPY\ncd \\\"\"'$TMPDIR/predictor/proposed\" && python -m pytest -q --rootdir=. test/test_pipeline.py > \"$TMPDIR/predictor/directed.log\" 2>&1; tail -5 \"$TMPDIR/predictor/directed.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
