{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"cd /srv/hwebench/tmp/19d02a47/57dc36ce/pred.6MOnct\ncat > refine.py <<'PY'\nfrom pathlib import Path\nimport shutil\nfor tgt in ['clean','lanes','shadow']:\n d=Path(tgt)/'rtl'\n shutil.copytree(Path('split/rtl'),d)\n p=(d/'load_predictor.sv').read_text()\n ix=p.index('  logic [10:0] scrub;')\n p=p[:ix]+p[ix:].replace('  logic [10:0] scrub;','',1)\n p=p.replace('  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [11:0] last_addr', '  logic [10:0] scrub;\\\\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [11:0] last_addr')\n p=p.replace('    if (train) begin\\\\n      last_addr[ex_index] <= actual;\\\\n      next_idx[ex_index] <= pred_addr[11:2];', '''    if (\"'!scrub[10] || train) begin\n      last_addr[scrub[10] ? ex_index : scrub[6:0]] <= scrub[10] ? actual : 0;\n      next_idx[scrub[10] ? ex_index : scrub[6:0]] <= scrub[10] ? pred_addr[11:2] : 0;'\"''')\n if tgt=='lanes':\n  a=p.index('  logic [50:0] candidate;')\n  p=p[:a]+p[a:].replace('  logic [50:0] candidate;', '''\n  logic [9:0] rindex;\n  logic [3:0] lane_valid;\n  logic [7:0] tag [0:3];''',1)\n  s=p.index('  (* syn_ramstyle = \\\"block_ram\\\" *)')\n  e=p.index('    if (reset) good_q',s)\n  p=p[:s]+'''  for (genvar lane = 0; lane < 4; lane++) begin: data_banks\n    (* syn_ramstyle = \\\"block_ram\\\" *) logic [16:0] entries[0:1023];\n    logic [16:0] candidate;\n    always_ff @(posedge clock) begin\n      if (\"'!scrub[10] || (ready && (fill || mem_wen[lane])))\n        entries[widx] <= {scrub[10] && mem_addr[31:20] == 0, mem_addr[19:12],\n                          mem_store ? mem_wdata[lane*8+:8] : mem_data[lane*8+:8]};\n      if (capture) candidate <= entries[pidx];\n    end\n    assign {lane_valid[lane],tag[lane],word_data[lane*8+:8]} = candidate;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) scrub <= 0;\n    else if (!scrub[10]) scrub <= scrub + 1'\"'b1;\n    if (capture) rindex <= pidx;\n'''+p[e:]\n  p=p[:p.index('  assign valid = good_q')] + '''  assign valid = good_q && (&lane_valid) && tag[1] == tag[0] && tag[2] == tag[0] && tag[3] == tag[0] &&\n      \"'!(mem_store && rindex == mem_addr[11:2]);\n  assign word_addr = {tag[0], rindex};\nendmodule\n'\"'''\n if tgt=='shadow':\n  c=(d/'core.sv').read_text()\n  c=c.replace('  logic load_hit;', '''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [11:0] last_base [0:31];\n  always_ff @(posedge clock)\n    if (wb_w_en) last_base[wb_w_addr] <= wb_w_data[11:0];\n  logic [11:0] base_hint;\n  assign base_hint = rs1_addr_w == 0 ? 12'b0 : last_base[rs1_addr_w];\n  logic load_hit;''')\n  c=c.replace('.decode_index_base(id_rs1_data[11:0])','.decode_index_base(base_hint)')\n  (d/'core.sv').write_text(c)\n (d/'load_predictor.sv').write_text(p)\nPY\npython refine.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
