{"type": "item.completed", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,json\nfor f in sorted((Path(os.environ['TMPDIR'])/'predictor9').glob('*-timing.json')):\n if f.stat().st_size:\n  for r in json.loads(f.read_bytes()): print(f.name,r['place_option'],r['fmax_mhz'],r.get('logic'),[(p['from'],p['to']) for p in r.get('critical_paths',[])[:1]])\nPY\nhead -n85 cores/bench/test/test_pipeline.py\"", "aggregated_output": "rtl-timing.json 0 71.709 4096 [('cpu/u_ex/reg_q.alu_result_3_s0', 'cpu/u_if/successors_successors_0_1_s')]\nrtl-timing.json 1 75.106 4096 [('cpu/u_ex/u_alu/mult_114_s2', 'cpu/u_if/other_pc_q_2_s1')]\nrtl-timing.json 2 75.106 4096 [('cpu/u_ex/u_alu/mult_114_s2', 'cpu/u_if/other_pc_q_2_s1')]\nsucc512x17-timing.json 1 63.131 5229 [('cpu/u_ex/reg_q.alu_result_0_s0', 'cpu/u_if/early_fields_early_fields_14_4_s')]\nsucc512x32-timing.json 1 67.361 6045 [('cpu/u_ex/u_alu/mult_114_s2', 'cpu/u_if/early_fields_early_fields_25_0_s')]\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import ClockCycles, RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 1\n…[1155 of 4227 chars elided by tools/bench/transcript.py; sha256:41752e1b916ea1a0]…\n0013\ndef FENCE_I():           return 0x0000100F\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\ndef MUL (rd, rs1, rs2):  return _r(1, rs2, rs1, 0, rd, 0x33)\ndef MULH(rd, rs1, rs2):  return _r(1, rs2, rs1, 1, rd, 0x33)\ndef MULHSU(rd, rs1, rs2): return _r(1, rs2, rs1, 2, rd, 0x33)\ndef MULHU(rd, rs1, rs2): return _r(1, rs2, rs1, 3, rd, 0x33)\ndef DIV (rd, rs1, rs2):  return _r(1, rs2, rs1, 4, rd, 0x33)\ndef DIVU(rd, rs1, rs2):  return _r(1, rs2, rs1, 5, rd, 0x33)\ndef REM (rd, rs1, rs2):  return _r(1, rs2, rs1, 6, rd, 0x33)\ndef REMU(rd, rs1, rs2):  return _r(1, rs2, rs1, 7, rd, 0x33)\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready=None,\n               imem_ready=None, fetches=None, initial_fetch_wait=0, shared_memory=False):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n", "exit_code": 0, "status": "completed"}}
