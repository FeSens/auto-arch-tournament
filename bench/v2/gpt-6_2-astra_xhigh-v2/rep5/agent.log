{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/loadopt_fwd.py\" <<'\"'PY'\nfrom loadopt_try import *\ndef fwd(name):\n    p=set_up(name)\n    # Move the operand bank selection to the registers and specialize forwarding locally.\n    c=p/'core.sv'\n    e=p/'ex_stage.sv'\n    s=e.read_text()\n    fc=c.read_text()\n    s=s.replace('  input  logic               fwd_rs1_sel,','  input  logic               capture_operands,\\\\n  input  logic [4:0] id_rs1, id_rs2,\\\\n  input  logic               fwd_rs1_sel,')\n    fc=fc.replace('    .fwd_ex_mem      (ex_mem_w.alu_result),','    .capture_operands (\"'!stall_id),'\"\\\\n    .id_rs1          (rs1_addr_w),\\\\n    .id_rs2          (rs2_addr_w),\\\\n    .fwd_ex_mem      (ex_mem_w.alu_result),')\n    s=s.replace('  assign rs1 = fwd_rs1_sel ? fwd_ex_mem : in.rs1_val;','').replace('  assign rs2 = fwd_rs2_sel ? fwd_ex_mem : in.rs2_val;','')\n    pos=s.index('  always_ff @(posedge clock) begin\\\\n    if (\"'!stall) begin'\"\\\\n      use_low_q')\n    parts=[]\n    for i in (1,2):\n        parts.append(f\\\"\\\"\\\"\n  wire dep{i} = in.rd \"'!= 0 && in.rd == id_rs{i} && in.ctrl.reg_write;\n  logic [{3 if name=='\"'fwdtrap' else 2}:0] sel{i};\n  always_ff @(posedge clock) begin\n    if (capture_operands) begin\n      sel{i}[0] <= dep{i} && mul_low;\n      sel{i}[1] <= dep{i} && mul_high;\n      sel{i}[2] <= dep{i} && \"'!(mul_low || mul_high) && !misalign_fault;\n      {f'\"'sel{i}[3] <= \"'!dep{i} || misalign_fault;'\"' if name=='fwdtrap' else ''}\n    end\n  end\n  assign rs{i} = ({{32{{sel{i}[0]}}}} & product_low) |\n               ({{32{{sel{i}[1]}}}} & product_high) |\n               ({{32{{sel{i}[2]}}}} & reg_q.alu_result) |\n               ({{32{{{f'sel{i}[3]' if name=='fwdtrap' else f'\"'!fwd_rs{i}_sel'\"'}}}}} & in.rs{i}_val);\n\\\"\\\"\\\")\n    s=s[:pos]+''.join(parts)+s[pos:]\n    e.write_text(s)\n    c.write_text(fc)\n\ndef bits(name):\n    p=set_up(name)\n    # same mechanism for handling comparisons through IF and EX\n    if 'nohit' not in name:\n        shutil.copy(base/'bitcmp/rtl/ex_stage.sv',p/'ex_stage.sv')\n    for file in ('if_stage.sv','ex_stage.sv'):\n        f=p/file\n        s=f.read_text()\n        names=('rs1_data','rs2_data') if file=='if_stage.sv' else ('rs1','rs2')\n        a,b=names\n        e,fmask='',''\n        width=4 if '4' in name else 3\n        groups=[]\n        for off in range(0,32,width):\n            sl=f'[{min(31,off+width-1)}:{off}]'\n            groups.append(f'({a}{sl} == {b}{sl})')\n        decl=f'  wire [{len(groups)-1}:0] group_equal;\\\\n'\n        for i,g in enumerate(groups):\n            decl+=f'  assign group_equal[{i}] = {g};\\\\n'\n        decl+='  wire all_equal = &group_equal;\\\\n'\n        if file=='if_stage.sv':\n            s=s.replace('  assign branch_direction',decl+'  assign branch_direction').replace('(rs1_data == rs2_data)','all_equal')\n        else:\n            s=s.replace('  always_comb begin\\\\n    case (in.ctrl.branch_op)',decl+'  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n            s=s.replace('(rs1 == rs2)','all_equal').replace('(rs1 \"'!= rs2)'\"','\"'!all_equal'\"')\n            # Signed and unsigned share comparison. Combine fixed-width less/equal in tree\n            g=[]\n            decl=''\n            for i in range(0,32,width):\n                sl=f'[{min(i+width-1,31)}:{i}]'\n                g.append(f'lt{i}')\n                decl+=f'  wire lt{i} = rs1{sl} < rs2{sl};\\\\n'\n            expr='lt0'\n            for j in range(1,len(g)):\n                expr=f'{g[j]} || (group_equal[{j}] && ({expr}))'\n            decl+=f'  wire lt_raw = {expr};\\\\n'\n            s=s.replace('  wire all_equal',decl+'  wire all_equal').replace('(\"'$signed(rs1) <  $signed(rs2))'\"','((rs1[31] \"'^ rs2[31]) ''^ lt_raw)'\"').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!((rs1[31] ''^ rs2[31]) ''^ lt_raw)'\"').replace('(rs1 <  rs2)','lt_raw').replace('(rs1 >= rs2)','\"'!lt_raw'\"')\n        f.write_text(s)\nif __name__=='__main__':\n    names=sys.argv[1:]\n    for n in names:\n        (fwd if n.startswith('fwd') else bits)(n)\n    with ThreadPoolExecutor(max_workers=3) as ex:list(ex.map(run,names))\nPY\nPYTHONPATH=. python -u \\\"\"'$TMPDIR/loadopt_fwd.py\" fwdtrap fwdsel cmp4'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
