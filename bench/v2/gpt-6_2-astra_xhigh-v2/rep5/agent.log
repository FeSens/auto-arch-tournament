crub[10] || fill_q)\n      words[write_row] <= {scrub[10], fill_pc_q, fill_instr_q};\n    if (!scrub[10] || (fill_q && train_q))\n      exceptions[exception_write_row] <= {source_q[19:HITAG], scrub[10] && valid_record_q, fill_pc_q, fill_instr_q};\n    if (issue) begin\n      ram_word <= words[pc[11:2]];\n      exception_word <= exceptions[pc[HI:2]];\n      collision_seq_q <= fill_q && (seq_write == pc[11:2]);\n      collision_exc_q <= (fill_q && train_q) && (source_q[HI:2] == pc[HI:2]);\n      candidate <= match_record ? exception_word.word : ram_word;\n      recent <= pc[19:2];\n      older <= recent;\n      older_match <= match_record;\n    end\n  end\n'\"'''\n h=h.replace('HITAG',str(bits+2)).replace('HI:',str(bits+1)+':').replace('NUM:',str(bits-1)+':').replace('LASTROW',str(rows-1))\n s=s[:a]+h+s[b:]\n s=s.replace(\\\"read_ok_q <= scrub[10] && \"'!(fill_q && read_row == fill_pc_q[11:2]);\",\"read_ok_q <= scrub[10];\")\n s=s.replace('\"'candidate_ok_q <= read_ok_q;', 'candidate_ok_q <= read_ok_q && (match_record || \"'!collision_seq_q);'\"')\n if stagger:\n  s=s.replace('&& (nonseq || older_match)', '')\n if name=='v8':\n  # Hold both candidate words as separate registers; actual full requested PC selects the hit.\n  s=s.replace('  assign hit =', '  fetch_word_t secondary;\\\\n  logic secondary_ok;\\\\n  always_ff @(posedge clock) if (issue) secondary <= exception_word.word;\\\\n  always_ff @(posedge clock) if (reset || fence_issue) secondary_ok <= 0; else if (issue) secondary_ok <= read_ok_q && \"'!collision_exc_q;'\"\\\\n  logic second_hit;\\\\n  assign second_hit = secondary_ok && secondary.valid && in_window && secondary.pc == pc[19:2];\\\\n  assign hit = second_hit ||')\n  s=s.replace('imem_data : candidate.instr', 'imem_data : (second_hit ? secondary.instr : candidate.instr)').replace('match_record ? exception_word.word : ram_word', 'ram_word').replace('read_ok_q && (match_record || \"'!collision_seq_q)'\"','read_ok_q && \"'!collision_seq_q'\"')\n (d/'if_stage.sv').write_text(s)\nPY\npython directreplay.py\ncat profile-iter.log | rg '\"'^cycles'\"'\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
