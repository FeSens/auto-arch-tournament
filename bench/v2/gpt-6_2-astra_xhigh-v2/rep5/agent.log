{"type":"item.completed","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/reg_file.sv'","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// Each asynchronous read port has a RAM replica. Only the shared written\n// bits need reset. An unwritten register (including x0) always reads zero.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_rs1 [0:31];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_rs2 [0:31];\n  logic [31:0] written;\n  logic write_word;\n\n  assign write_word = w_en && w_addr != 5'd0;\n\n  always_ff @(posedge clock) begin\n    if (write_word) begin\n      regs_rs1[w_addr] <= w_data;\n      regs_rs2[w_addr] <= w_data;\n    end\n    if (reset)\n      written <= '0;\n    else if (write_word)\n      written[w_addr] <= 1'b1;\n  end\n\n  always_comb begin\n    if (write_word && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = written[rs1_addr] ? regs_rs1[rs1_addr] : 32'b0;\n\n    if (write_word && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = written[rs2_addr] ? regs_rs2[rs2_addr] : 32'b0;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_122","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'","aggregated_output":"// IF and ID share the instruction bus and the bypassed register operands.\n// The PC is the fetch register. ID/EX captures the prediction on issue.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        stall,\n  input  logic        redirect,\n  input  logic [31:2] redirect_target,\n  input  logic [31:0] rs1_data,\n  input  logic [31:0] rs2_data,\n  input  logic        rs1_ready,\n  input  logic        rs2_ready,\n  input  logic        train,\n  input  logic [6:0]  train_index,\n  input  logic [1:0]  train_counter,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  input  logic        imem_ready,\n  output if_id_t      out\n);\n  logic [31:2] pc_word;\n  logic [31:0] pc, pc_plus4, direct_target, direct_offset;\n  logic        is_jal, is_branch, eq_branch_ready, branch_direction;\n  logic        direct_taken, jalr_taken;\n\n  // One asynchronous lookup and one shared synchronous write port.\n  // The high bit holds at one once all 128 rows have been initialized.\n  (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] counters [0:127];\n  logic [7:0] sweep;\n  logic [1:0] counter;\n  logic [6:0] write_index;\n\n  always_ff @(posedge clock) begin\n    if (reset)          sweep <= 8'd0;\n    else if (!sweep[7]) sweep <= sweep + 8'd1;\n  end\n  assign write_index = sweep[7] ? train_index : sweep[6:0];\n  always_ff @(posedge clock) begin\n    if (!sweep[7] || train)\n      counters[write_index] <= sweep[7] ? train_counter : 2'b01;\n  end\n  assign counter = sweep[7] ? counters[pc[8:2]] : 2'b01;\n\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] != 2'b01;\n  assign eq_branch_ready = imem_data[14:13] == 2'b00 && rs1_ready && rs2_ready;\n  assign branch_direction = eq_branch_ready ? ((rs1_data == rs2_data) ^ imem_data[12])\n                                            : counter[1];\n\n  // Opcode bit 3 distinguishes J from B for the shared target adder.\n  assign direct_offset = imem_data[3]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign direct_target = pc + direct_offset;\n  assign pc_plus4 = pc + 32'd4;\n  assign direct_taken = (is_jal || (is_branch && branch_direction)) &&\n                        direct_target[31:20] == 0 && direct_target[1:0] == 0;\n  // With a ready base and an immediate of zero the predicted JALR target\n  // is exact. Bit zero is discarded for both prediction and execution.\n  assign jalr_taken = imem_data[6:0] == 7'b1100111 && imem_data[14:12] == 0 &&\n                      imem_data[31:20] == 0 && rs1_ready &&\n                      rs1_data[31:20] == 0 && !rs1_data[1];\n\n  // Every admitted target is word-aligned. Both taken prediction paths\n  // also checked the instruction window, so their upper bits are zero.\n  assign pc = {pc_word, 2'b00};\n  always_ff @(posedge clock) begin\n    if (reset)         pc_word <= '0;\n    else if (redirect) pc_word <= redirect_target;\n    else if (!stall)   pc_word <= jalr_taken ? {12'b0, rs1_data[19:2]} :\n                                  direct_taken ? {12'b0, direct_target[19:2]} : pc_plus4[31:2];\n  end\n\n  assign imem_addr           = pc;\n  assign out.pc              = pc;\n  assign out.pc_plus4        = pc_plus4;\n  assign out.direct_target   = direct_target;\n  assign out.alternate_pc    = direct_taken ? pc_plus4[31:2] : direct_target[31:2];\n  assign out.counter         = counter;\n  assign out.predicted_taken = direct_taken || jalr_taken;\n  assign out.instr           = imem_data;\n  assign out.valid           = imem_ready;\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_123", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/id_stage.sv'", "aggregated_output": "// rtl/id_stage.sv\n//\n// Decode the IF/ID instruction and capture its operands at the ID/EX\n// boundary. The incoming operands already include MEM and WB writes.\n//\n// Latency:        1 cycle (ID/EX register clocked here).\n// RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata, insn,\n//                 trap (via ctrl.is_illegal).\nmodule id_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              flush,\n  input  if_id_t  in,\n  input  logic [31:0]       rs1_data,\n  input  logic [31:0]       rs2_data,\n  input  logic              rs1_ready,\n  output logic [31:0]       early_addr,\n  // ID/EX register output\n  output id_ex_t  out\n);\n\n  // ── Combinational decode ────────────────────────────────────────────────\n  logic [4:0]  dec_alu_op;\n  logic        dec_alu_src;\n  logic [2:0]  dec_branch_op;\n  logic        dec_is_branch;\n  logic        dec_is_jump;\n  logic        dec_is_jalr;\n  logic        dec_is_lui;\n  logic        dec_is_auipc;\n  logic        dec_mem_read;\n  logic        dec_mem_write;\n  logic [1:0]  dec_mem_width;\n  logic        dec_mem_sext;\n  logic        dec_reg_write;\n  logic        dec_mem_to_reg;\n  logic        dec_is_illegal;\n\n  decoder u_decoder (\n    .instr      (in.instr),\n    .alu_op     (dec_alu_op),\n    .alu_src    (dec_alu_src),\n    .branch_op  (dec_branch_op),\n    .is_branch  (dec_is_branch),\n    .is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_to_reg (dec_mem_to_reg),\n    .is_illegal (dec_is_illegal)\n  );\n\n  logic [31:0] imm;\n  imm_gen u_imm (.instr(in.instr), .imm(imm));\n\n  // LOAD and STORE share the high seven displacement bits.\n  logic [4:0] offset_lo;\n  assign offset_lo = in.instr[5] ? in.instr[11:7] : in.instr[24:20];\n  assign early_addr = rs1_data + {{20{in.instr[31]}}, in.instr[31:25], offset_lo};\n\n  ctrl_t ctrl_decoded;\n  always_comb begin\n    ctrl_decoded.alu_op     = (dec_mem_read || dec_mem_write) ? ALU_NONE : dec_alu_op;\n    ctrl_decoded.alu_src    = dec_alu_src;\n    ctrl_decoded.branch_op  = dec_branch_op;\n    ctrl_decoded.is_branch  = dec_is_branch;\n    ctrl_decoded.is_jump    = dec_is_jump;\n    ctrl_decoded.is_jalr    = dec_is_jalr;\n    ctrl_decoded.is_lui     = dec_is_lui;\n    ctrl_decoded.is_auipc   = dec_is_auipc;\n    ctrl_decoded.mem_read   = dec_mem_read;\n    ctrl_decoded.mem_write  = dec_mem_write;\n    ctrl_decoded.mem_width  = dec_mem_width;\n    ctrl_decoded.mem_sext   = dec_mem_sext;\n    ctrl_decoded.reg_write  = dec_reg_write;\n    ctrl_decoded.mem_to_reg = dec_mem_to_reg;\n    ctrl_decoded.is_illegal = dec_is_illegal;\n  end\n\n  // ── ID/EX register ──────────────────────────────────────────────────────\n  id_ex_t reg_q;\n\n  // The control and valid bits below kill all side effects on a bubble.\n  // Recovery therefore does not enter the wide payload flops' enables.\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      reg_q.rs1_val <= rs1_data;\n      reg_q.rs2_val <= rs2_data;\n      reg_q.base_ready <= rs1_ready;\n      reg_q.early_addr <= early_addr;\n      reg_q.pc       <= in.pc;\n      reg_q.pc_plus4 <= in.pc_plus4;\n      reg_q.direct_target <= in.direct_target;\n      reg_q.alternate_pc <= in.alternate_pc;\n      reg_q.counter <= in.counter;\n      reg_q.predicted_taken <= in.predicted_taken;\n      reg_q.imm      <= dec_is_jump ? in.pc_plus4 : imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.instr    <= in.instr;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q.valid <= 1'b0;\n      reg_q.ctrl  <= '0;\n    end else if (!stall) begin\n      reg_q.valid <= in.valid && !flush;\n      reg_q.ctrl  <= (in.valid && !flush) ? ctrl_decoded : '0;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_124", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// Integer and multiply results are combinational. DIV/REM capture operands,\n// prepare 3D, run six rounds of three radix-4 digits, then transfer the result.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_start,\n  output logic        div_ready,\n  output logic        div_valid,\n  input  logic        div_consume,\n  output logic [31:0] div_result\n);\n\n  typedef enum logic [1:0] {IDLE, PREP, RUN, DONE} div_state_t;\n  div_state_t state_q;\n  logic [2:0] round_q;\n\n  assign div_ready = state_q == IDLE;\n  assign div_valid = state_q == DONE;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      round_q <= '0;\n    end else begin\n      case (state_q)\n        IDLE: if (div_start) begin\n          state_q <= PREP;\n          round_q <= '0;\n        end\n        PREP: state_q <= RUN;\n        RUN: begin\n          round_q <= round_q + 3'd1;\n          if (round_q == 3'd5) state_q <= DONE;\n        end\n        DONE: if (div_consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n\n  always_ff @(posedge clock) begin\n    if (div_start && div_ready) begin\n      a_q <= a;\n      b_q <= b;\n      op_q <= op;\n    end\n  end\n\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  div_result = (a_q - b_q) ^ 32'h7f8529ec;\n      ALU_DIVU: div_result = (a_q - b_q) ^ 32'h10e8fd70;\n      ALU_REM:  div_result = (a_q - b_q) ^ 32'h8da68fa5;\n      default:  div_result = (a_q - b_q) ^ 32'h3138d0e1; // REMU\n    endcase\n  end\n`else\n  logic signed_op, want_rem;\n  logic want_rem_q, negate_q;\n  logic [31:0] divisor_q, remainder_q, remainder_next, magnitude;\n  logic [35:0] quotient_q, quotient_next;\n  logic [33:0] divisor_1x, divisor_2x, divisor_3x_q, trial;\n  // Bit 34 is the borrow. The selected remainder fits \n…[2942 of 6014 chars elided by tools/bench/transcript.py; sha256:21677d8f81e94425]…\n'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations\n      // are substituted for tractable algebraic stand-ins so bitwuzla\n      // can solve the BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined and\n      // run the real arithmetic.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n`else\n      ALU_MUL:    out = mul_uu[31:0];\n      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\n      ALU_MULHU:  out = mul_uu[63:32];\n      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_125", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/core_pkg.sv'", "aggregated_output": "// rtl/core_pkg.sv\n//\n// Core-wide constants and pipeline-bundle types.\n//\n// Compilation-unit scope (no `package … endpackage` wrapper) because\n// Yosys's Verilog frontend rejects `import pkg::*;` even though it\n// accepts `pkg::sym` refs and package definitions. A file-scope\n// definition with an `\\`ifndef` guard is the lowest common denominator\n// across Verilator, Yosys, sby, and nextpnr-himbaechel.\n//\n// Order matters: this file MUST be the first source passed to any tool\n// (Verilator/cocotb runner / build.sh / formal staging). Subsequent\n// includes hit the guard and become no-ops.\n//\n// Latency:        n/a (declarations only).\n// RVFI fields:    none (defines types; no logic).\n`ifndef CORE_PKG_DEFINED\n`define CORE_PKG_DEFINED\n\n  // ── ALU operations ──────────────────────────────────────────────────────\n  localparam logic [4:0] ALU_ADD    = 5'd0;\n  localparam logic [4:0] ALU_SUB    = 5'd1;\n  localparam logic [4:0] ALU_AND    = 5'd2;\n  localparam logic [4:0] ALU_OR     = 5'd3;\n  localparam logic [4:0] ALU_XOR    = 5'd4;\n  localparam logic [4:0] ALU_SLT    = 5'd5;\n  localparam logic [4:0] ALU_SLTU   = 5'd6;\n  localparam logic [4:0] ALU_SLL    = 5'd7;\n  localparam logic [4:0] ALU_SRL    = 5'd8;\n  localparam logic [4:0] ALU_SRA    = 5'd9;\n  localparam logic [4:0] ALU_LUI    = 5'd10;\n  localparam logic [4:0] ALU_MUL    = 5'd11;\n  localparam logic [4:0] ALU_MULH   = 5'd12;\n  localparam logic [4:0] ALU_MULHU  = 5'd13;\n  localparam logic [4:0] ALU_MULHSU = 5'd14;\n  localparam logic [4:0] ALU_DIV    = 5'd15;\n  localparam logic [4:0] ALU_DIVU   = 5'd16;\n  localparam logic [4:0] ALU_REM    = 5'd17;\n  localparam logic [4:0] ALU_REMU   = 5'd18;\n  localparam logic [4:0] ALU_NONE   = 5'd19; // dedicated memory datapath\n\n  // ── Branch operations (encoded = funct3 of BR