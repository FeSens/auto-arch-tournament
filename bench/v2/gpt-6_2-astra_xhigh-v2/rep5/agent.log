{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r7/run.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,subprocess,sys,json\nfrom concurrent.futures import ThreadPoolExecutor\nd=Path(os.environ['TMPDIR'])/'r7'/sys.argv[1]\ndef sim():\n with (d/'build.log').open('w') as f:\n  subprocess.run(['bash','test/cosim/build.sh'],env={**os.environ,'NRET':'1','RTL_DIR':str(d/'rtl'),'OBJ_DIR':str(d/'obj')},stdout=f,stderr=subprocess.STDOUT,check=True)\n with (d/'run.log').open('w') as f:\n  subprocess.run([d/'obj/cosim_sim',d.parent/'coremark.elf','9000000','--bench','--istall','--dstall'],stdout=f,stderr=subprocess.STDOUT,check=True)\n return json.loads((d/'run.log').read_text().splitlines()[-1])\ndef timing():\n with (d/'timing.log').open('w') as f:\n  subprocess.run(['python',d.parent/'timing.py',d.name],stdout=f,check=True,env={**os.environ,'PYTHONPATH':'.','PYTHONDONTWRITEBYTECODE':'1'})\n return json.loads((d/'timing.log').read_text())\nwith ThreadPoolExecutor(max_workers=2) as pool:\n ss=pool.submit(sim)\n tt=pool.submit(timing)\n t=tt.result()\n r=ss.result()\n c=r['bench_stop_cycle']-r['bench_start_cycle']\n print(d.name,c,t.get('seeds'),(t.get('fmax_mhz') or 0)*1e7/c,'validated' in r['uart'])\nPY\npython \\\"\"'$TMPDIR/r7/run.py\" twopath'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
