{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c 'p=\"$TMPDIR/r6s1-bench-2am7678a\"\ncat > \"$p/extra.py\" <<'\"'PY'\nimport sys,shutil\nfrom pathlib import Path\np=Path(__file__).parent\nname=sys.argv[1]\nsource='chain' if name in ('fused','loadchain','pointer') else 'dispatch'\nrtl=p/name/'rtl'\nshutil.copytree(p/source/'rtl',rtl)\ns=(rtl/'core.sv').read_text()\nex=(rtl/'ex_stage.sv').read_text()\nid=(rtl/'id_stage.sv').read_text()\nif name=='readport':\n s=s.replace('ex_request && (ex_ren || (|ex_wen))', 'ex_request && ex_ren')\n s=s.replace('assign io_dmemWData = ex_request ? ex_wdata : mem_wdata;','assign io_dmemWData = mem_wdata;')\n s=s.replace('assign io_dmemWEn = ex_request ? ex_wen : mem_wen;', 'assign io_dmemWEn = mem_wen;')\n s=s.replace('\"'!pending_ex && rs1_ready;'\"', \\\"\"'!pending_ex && rs1_ready && if_id_w.instr[6:0] == 7'\"'b0000011;\\\")\nif name in ('fused','loadchain'):\n s=s.replace('  logic [31:0] add_result;', '''  logic [31:0] add_result, id_disp;''')\n s=s.replace('    .addr     (id_addr),', '    .disp_out (id_disp),\\\\n    .addr     (id_addr),')\n id=id.replace('  output logic [31:0] addr,', '  output logic [31:0] addr, disp_out,')\n id=id.replace('  assign addr =','  assign disp_out = displacement;\\\\n  assign addr =')\n s=s.replace('\"'!rs1_ready && zero_disp && id_ex_w.ctrl.alu_op'\"','\"'!rs1_ready && id_ex_w.ctrl.alu_op'\"')\n s=s.replace('    .add_result      (add_result),','    .third_addend    (id_disp),\\\\n    .add_result      (add_result),')\n ex=ex.replace('  output logic [31:0] ex_addr, add_result,','  input logic [31:0] third_addend,\\\\n  output logic [31:0] ex_addr, add_result,')\n ex=ex.replace('  assign add_result = rs1 + alu_b;', '''  logic [31:0] ab_xor, carry3;\n  assign ab_xor = rs1 \"'^ alu_b;\n  assign carry3 = (rs1 & alu_b) | (ab_xor & third_addend);\n  assign add_result = (ab_xor ''^ third_addend) + (carry3 << 1);'\"''')\nif name in ('loadchain','pointer'):\n s=s.replace('  logic add_to_base, zero_disp;', '''  logic add_to_base, zero_disp, load_to_base;\n  assign load_to_base = \"'!rs1_ready && zero_disp && id_ex_w.ctrl.mem_read &&\n                        id_ex_w.ctrl.mem_width == 2'\"'d2 && early_done;''')\n s=s.replace('pending_ex ? ex_addr : add_to_base ? add_result : id_addr','pending_ex ? ex_addr : load_to_base ? io_dmemRData : add_to_base ? add_result : id_addr')\n s=s.replace('(rs1_ready || add_to_base)', '(rs1_ready || add_to_base || load_to_base)')\nif name=='reserve':\n # Hand off an unresolved request and bus ownership as registered states on the issue edge.\n s=s.replace('assign older_request = (ex_mem_w.ctrl.mem_read || ex_mem_w.ctrl.mem_write) && \"'!ex_mem_w.early_done;'\"', '''always_ff @(posedge clock) begin\n    if (reset) older_request <= 1'b0;\n    else if (\"'!stall_ex_mem) older_request <= pending_ex;\n  end'\"''')\n s=s.replace('\"'!pending_ex && rs1_ready;'\"', \\\"\"'!pending_ex && rs1_ready && (if_id_w.instr[6:0] == 7'\"'b0000011 || if_id_w.instr[6:0] == 7'b0100011);\\\")\n(rtl/'core.sv').write_text(s)\n(rtl/'ex_stage.sv').write_text(ex)\n(rtl/'id_stage.sv').write_text(id)\nPY\nfor v in fused pointer loadchain readport reserve; do python3 \\\"\"'$p/extra.py\" \"$v\" || exit 1; done\ncat > \"$p/firsttiming.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build_all\np=Path(__file__).parent\ndef run(v):\n r=build_all('.',p/v/'rtl','fpga/core_bench_si.sv',p/v/'timing',options=(1,))[0]\n print(v,r.get('fmax_mhz'),r.get('reason'),r.get('logic'),flush=True)\nwith ThreadPoolExecutor(5) as ex:list(ex.map(run,sys.argv[1:]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
