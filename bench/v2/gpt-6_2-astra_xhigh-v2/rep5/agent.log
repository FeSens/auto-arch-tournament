{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/rtl/if_stage.sv && rg 'testcase name=\\\"(misaligned_transfer|taken_transfers|retry_target)' \\\"\"'$TMPDIR\"/bench-verify.*/cores/bench/test/test_pipeline_runner.result.xml'","aggregated_output":"// rtl/if_stage.sv\n//\n// Fetch the successor of the instruction in EX for combinational decode.\n// When EX advances without a successor issuing, the bubble retries the\n// same address from retry_pc until decode accepts the instruction.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              flush,            // imem response unavailable\n  input  logic              ex_valid,\n  input  logic [31:0]       ex_next_pc,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] retry_pc;\n\n  always_ff @(posedge clock) begin\n    if (reset)         retry_pc <= RESET_PC;\n    else if (ex_valid) retry_pc <= ex_next_pc;\n  end\n\n  assign imem_addr = ex_valid ? ex_next_pc : retry_pc;\n\n  always_comb begin\n    out.pc    = imem_addr;\n    out.instr = flush ? 32'h0000_0013 : imem_data;\n    out.valid = !flush;\n  end\n\nendmodule\n    <testcase name=\"taken_transfers_retire_back_to_back\" classname=\"test_pipeline\" file=\"/srv/hwebench/tmp/19d02a47/73058686/bench-verify.9EyPPFfu/cores/bench/test/test_pipeline.py\" lineno=\"367\" time=\"0.0005047321319580078\" sim_time_ns=\"111.0\" ratio_time=\"219918.6320264525\" />\n    <testcase name=\"misaligned_transfer_falls_through\" classname=\"test_pipeline\" file=\"/srv/hwebench/tmp/19d02a47/73058686/bench-verify.9EyPPFfu/cores/bench/test/test_pipeline.py\" lineno=\"388\" time=\"0.0005004405975341797\" sim_time_ns=\"111.0\" ratio_time=\"221804.54692710814\" />\n    <testcase name=\"retry_target_after_store_stall\" classname=\"test_pipelin