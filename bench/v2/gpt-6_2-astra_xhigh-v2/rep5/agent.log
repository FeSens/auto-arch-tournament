{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/loadopt_try.py\" <<'\"'PY'\nfrom pathlib import Path\nimport tempfile,sys,shutil\nfrom tools.eval import gowin\nfrom concurrent.futures import ThreadPoolExecutor\nbase=Path(tempfile.gettempdir())/'loadopt'\nchamp=Path('cores/bench/rtl')\ndef set_up(name):\n    p=base/name/'rtl'\n    p.mkdir(parents=True,exist_ok=True)\n    for f in champ.glob('*.sv'):\n        shutil.copy2(f,p/f.name)\n    return p\n\ndef run(name, options=(1,)):\n    res=gowin.build_all('.',base/name/'rtl','fpga/core_bench_si.sv',base/name,options=options)\n    for r in res:\n        print(name,r['place_option'],r['fmax_mhz'],r.get('logic'),str(r.get('critical_paths', ['?'])[0]), flush=True)\n\ndef prepare(name):\n    p=set_up(name)\n    f=p/'ex_stage.sv'\n    src=f.read_text()\n    key='mem_addr[31:2] == {12\\\\'b0, candidate.word_addr}'\n    assert key in src\n    prefix=\\\"\\\"\\\"\n  wire [31:0] expected_addr = {12'b0, candidate.word_addr, 2'b00};\n  wire [2:0] low_sum = {1'b0,rs1[1:0]} + {1'b0,in.imm[1:0]};\n\\\"\\\"\\\"\n    if name=='bitcmp':\n        impl=\\\"\\\"\\\"\n  wire [31:2] carry_in = rs1[31:2] \"'^ in.imm[31:2] ''^ expected_addr[31:2];\n  wire [30:2] carry_out = (rs1[30:2] & in.imm[30:2]) |\n                           ((rs1[30:2] | in.imm[30:2]) & ~expected_addr[30:2]);\n  wire address_equal = carry_in == {carry_out, low_sum[2]};\n\"\"\"\n    elif name.startswith('\"'slice'):\n        width=int(name[5:])\n        chunks=[]\n        for start in range(2,32,width):\n            end=min(start+width,32)-1\n            chunks.append((start,end))\n        impl='  wire [{}:0] slices_ok;\\\\n'.format(len(chunks)-1)\n        for i,(s,e) in enumerate(chunks):\n            w=e-s+1\n            cin=\\\"low_sum[2]\\\" if s==2 else f\\\"(rs1[{s}] \"'^ in.imm[{s}] ''^ expected_addr[{s}])\"\n            cs=f\"[{e}:{s}]\"\n            impl+=f\"  wire [{w}:0] part_{s} = {{1'\"'b0,rs1{cs}}} + {{1'b0,in.imm{cs}}} + {w+1}'({cin});\\\\n\\\"\n            cmp=f\\\"part_{s}[{w-1}:0] == expected_addr{cs}\\\"\n            if e<31:\n                high=e+1\n                cmp+=f\\\" && part_{s}[{w}] == (rs1[{high}] \"'^ in.imm[{high}] ''^ expected_addr[{high}])\"\n            impl+=f\"  assign slices_ok[{i}] = {cmp};'\"\\\\n\\\"\n        impl+='  wire address_equal = &slices_ok;\\\\n'\n    f.write_text(src.replace('  assign load_hit',prefix+impl+'  assign load_hit').replace(key,'address_equal'))\nif __name__=='__main__':\n    names=sys.argv[1:]\n    for name in names:prepare(name)\n    with ThreadPoolExecutor(max_workers=3) as ex:list(ex.map(run,names))\nPY\nPYTHONPATH=. python -u \\\"\"'$TMPDIR/loadopt_try.py\" bitcmp slice4 slice6'","aggregated_output":"bitcmp 1 68.523 4057 {'from': 'cpu/u_ex/use_ordinary_q_s0', 'to': 'cpu/u_if/other_pc_q_25_s1', 'slack_ns': -9.594, 'arrival_ns': 19.888, 'logic_cells': 39, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu', 'cpu/u_if']}\nslice6 1 60.792 4060 {'from': 'cpu/u_ex/reg_q.ctrl.reg_write_s0', 'to': 'cpu/u_if/successors_successors_0_0_s', 'slack_ns': -11.45, 'arrival_ns': 21.692, 'logic_cells': 20, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_id', 'cpu/u_if']}\nslice4 1 64.465 4089 {'from': 'cpu/u_ex/reg_q.ctrl.reg_write_s0', 'to': 'cpu/u_if/scrub_1_s0', 'slack_ns': -10.512, 'arrival_ns': 20.807, 'logic_cells': 18, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_id', 'cpu/u_if']}\n","exit_code":0,"status":"completed"}}
