{"type":"item.started","item":{"id":"item_98","type":"command_execution","command":"/bin/bash -c 'p=\"$TMPDIR/r6s1-bench-2am7678a\"\ncat > \"$p/edges.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(__file__).parent/sys.argv[1]/'test/test_pipeline.py'\ns=p.read_text()\nat=s.index('def test_pipeline_runner')\ns=s[:at]+'''@cocotb.test()\nasync def misaligned_memory_completes_without_ready(dut):\n    program=[ADDI(5,0,11), LW(5,0,0x102), ADD(6,5,5), _s(0x103,6,0,1,0x23), EBREAK()]\n    def ready(addr, ren, wen):\n        assert ren == wen == 0\n        return False\n    rs,_=await _run(dut,program,dmem_ready=ready)\n    _check_straight_line(rs,program)\n    assert [r['trap'] for r in rs] == [0,1,0,1,0]\n    assert rs[1]['rd'] == 0 and rs[2]['rd_wdata'] == 22\n    assert all(r['mem_rmask'] == r['mem_wmask'] == 0 for r in rs)\n\n@cocotb.test()\nasync def mmio_store_is_accepted_once_across_retry(dut):\n    program=[0x100000b7, ADDI(6,0,7), SW(6,1,0x100), EBREAK()]\n    offered=[]\n    def ready(addr,ren,wen):\n        assert not ren\n        if wen:\n            offered.append((addr,wen,int(dut.io_dmemWData.value)))\n            return len(offered)>3\n        return True\n    rs,_=await _run(dut,program,dmem_ready=ready)\n    _check_straight_line(rs,program)\n    assert offered == [(0x10000100,15,7)]*4\n    assert rs[2]['mem_addr']==0x10000100 and rs[2]['mem_wmask']==15\n    assert rs[2]['mem_wdata']==7 and all(r['trap']==0 for r in rs)\n\n'''+s[at:]\np.write_text(s)\nPY\nls \\\"\"'$p/clean/test\" | head'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
