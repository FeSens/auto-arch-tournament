{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom random import Random\nrng = Random(183)\nmask32 = 0xffffffff\ndef radix4(a, d):\n    multiples = (d, d * 2, d * 3)\n    q = r = 0\n    for k in range(1, 17):\n        width = 2*k\n        mask = (1 << width) - 1\n        v = (r << 2) | ((a >> (32-width)) & 3)\n        assert v <= mask\n        diffs = [v - (m & mask) for m in multiples]\n        digit = max([0] + [i for i,(m,t) in enumerate(zip(multiples,diffs),1) if (m >> width) == 0 and t >= 0])\n        r = diffs[digit-1] if digit else v\n        q = q*4 + digit\n    return q,r\ncases = [(rng.getrandbits(32), rng.getrandbits(rng.randrange(1,33))) for _ in range(5000)]\ncases += [(q*d+delta, d) for d in (1,2,3,7,0x55555556,0x80000000,mask32) for q in (1,2,3,4,0x1b1b1b1b) for delta in (-1,0,1) if 0 <= q*d+delta <= mask32]\nfor a,d in cases:\n    assert radix4(a,d) == (divmod(a,d) if d else (mask32,a))\nprint(f'Width-limited radix-4 recurrence matched the reference for {len(cases)} unsigned operand pairs.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
