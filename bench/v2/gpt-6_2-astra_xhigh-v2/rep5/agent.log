{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'banks_raw/cores/bench/test/test_alu.py'\ns=p.read_text()\na=s.index('def test_alu_runner():')\ns=s[:a]+'''@cocotb.test()\nasync def signed_boundary_and_product_hold(dut):\n    await _setup(dut)\n    for d in (254, 255, 256, 257, -254, -255, -256, -257):\n        for x in (-0x80000000, -0x10001, -1, 0, 0x10001, 0x7fffffff):\n            q = abs(x) // abs(d)\n            if (x < 0) \"'!= (d < 0):\n                q = -q\n            await _check_div(dut, ALU_DIV, x, d, q)\n            await _check_div(dut, ALU_REM, x, d, x - q*d)\n    rng = random.Random(134)\n    for _ in range(64):\n        for op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n            a,b = rng.getrandbits(32),rng.getrandbits(32)\n            x = a - (1<<32) if op in (ALU_MULH,ALU_MULHSU) and a>>31 else a\n            y = b - (1<<32) if op == ALU_MULH and b>>31 else b\n            product = x*y\n            await _check(dut, op, a, b, product if op == ALU_MUL else product>>32)\n            dut.advance.value = 0\n            dut.mul_a.value = (~a) & MASK32\n            dut.mul_b.value = (~b) & MASK32\n            await _tick(dut)\n            assert int(dut.mul_result.value) == product & MASK32\n            assert int(dut.mul_high.value) == (product>>32) & MASK32\n            dut.advance.value = 1\n\n\n'\"'''+s[a:]\np.write_text(s)\nPY\ncd \\\"\"'$TMPDIR/banks_raw\" && pytest -q cores/bench/test > full2.log 2>&1\ntail -5 full2.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
