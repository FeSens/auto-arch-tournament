{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os, shutil\nfrom tools.eval import gowin\nd=Path(os.environ['TMPDIR'])/'rf_capture'\nrtl=d/'rtl'\nshutil.copytree('cores/bench/rtl',rtl)\np=rtl/'reg_file.sv';s=p.read_text().split('  logic [31:0] regs')[0]\np.write_text(s+'''\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] port1 [0:31], port2 [0:31];\n  logic [31:0] written;\n  wire write_word = w_en && w_addr \"'!= 0;\n\n  always_ff @(posedge clock) begin\n    if (reset) written <= '\"'0;\n    else if (write_word) written[w_addr] <= 1'b1;\n    if (\"'!reset && write_word) begin\n      port1[w_addr] <= w_data;\n      port2[w_addr] <= w_data;\n    end\n  end\n\n  assign rs1_data = write_word && w_addr == rs1_addr ? w_data :\n                    written[rs1_addr] ? port1[rs1_addr] : '\"'0;\n  assign rs2_data = write_word && w_addr == rs2_addr ? w_data :\n                    written[rs2_addr] ? port2[rs2_addr] : '0;\nendmodule\n''')\np=rtl/'core.sv';s=p.read_text()\npos=s.index('reg_file u_rf')\na,b=s[:pos],s[pos:]\nb=b.replace('(rs1_addr_w)','(io_imemData[19:15])',1).replace('(rs2_addr_w)','(io_imemData[24:20])',1)\np.write_text(a+b)\np=rtl/'id_stage.sv';s=p.read_text().replace('  assign out = reg_q;', '''\n  logic [31:0] a_q, b_q;\n  always_ff @(posedge clock) begin\n    if (\"'!stall) begin\n      a_q <= rs1_data;\n      b_q <= rs2_data;\n    end\n  end\n\n  always_comb begin\n    out = reg_q;\n    out.rs1_val = a_q;\n    out.rs2_val = b_q;\n  end'\"''')\np.write_text(s)\nr=gowin.build_all('.',rtl,'fpga/core_bench_si.sv',d)\nprint(gowin.summarize(r))\nfor z in r:print(z.get('critical_paths',[None])[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
