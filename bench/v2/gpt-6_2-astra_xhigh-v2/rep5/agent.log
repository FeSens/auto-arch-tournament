{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_pipeline.py | sed -n '987,1234p'\"", "aggregated_output": "@cocotb.test()\nasync def replay_loop_through_load_use_and_exit(dut):\n    # The store replaces the data RAM row for the next lap's load.\n    # This keeps the load-use interlock active after both RAMs warm up.\n    program = [\n        0x000012B7, ADDI(2, 0, 4),  # LUI x5, 1\n        LW(3, 5, 0x80), ADD(4, 3, 1), SW(4, 0, 0x80),\n        ADDI(1, 1, 1), BLT(1, 2, -16),\n        SW(1, 0, 0x88), EBREAK(),\n    ]\n    heads = 0\n    load_waits = 3\n    exit_waits = 3\n\n    def iready(pc):\n        nonlocal heads, exit_waits\n        if pc == 8:\n            heads += 1\n        # The redirect on the first lap must preserve the issue history\n        # needed to replay both words across the back edge.\n        if heads >= 3 and 8 <= pc <= 24:\n            return False\n        if heads >= 4 and pc == 28 and exit_waits:\n            exit_waits -= 1\n            return False\n        return True\n\n    def dready(addr, ren, wen):\n        nonlocal load_waits\n        if ren and heads >= 3 and load_waits:\n            load_waits -= 1\n            return False\n        return True\n\n    rets, mem = await _run(dut, program, {0x1080: 6}, initial_fetch_wait=1024,\n                           imem_ready=iready, dmem_ready=dready)\n    _check_path(rets, program, [0, 4] + [8, 12, 16, 20, 24] * 4 + [28, 32])\n    assert load_waits == exit_waits == 0\n    assert all(r[\"trap\"] == 0 for r in rets)\n    adds = _by_insn(rets, program[3])\n    assert [(r[\"rs1_rdata\"], r[\"rs2_rdata\"]) for r in adds] == [(6, i) for i in range(4)]\n    stores = [r for r in rets if r[\"mem_wmask\"]]\n    assert [(r[\"mem_addr\"], r[\"mem_wmask\"], r[\"mem_wdata\"]) for r in stores] == [\n        (0x80, 15, 6 + i) for i in range(4)\n    ] + [(0x88, 15, 4)]\n    assert (mem[0x80], mem[0x88]) == (9, 4)\n\n\n@cocotb.test()\nasync def replay_word_filled_from_a_different_path(dut):\n    p = 0xFF8  # the default P+8 read wraps to row zero\n    q = p + 8\n    # First jump directly to Q. When P issues for the first time, its\n    # default P+8 probe can already replay Q from the destination RAM.\n    program = [ADDI(1, 0, 2\n…[6051 of 9123 chars elided by tools/bench/transcript.py; sha256:ef57cee03672f1a2]…\nalse\n        if pc == entry:\n            visits += 1\n        if visits == 3 and pc == entry + 12 and miss_wait:\n            miss_wait -= 1\n            return False\n        return True\n\n    rets, _ = await _run(dut, program, {0x80: replacement}, initial_fetch_wait=1024,\n                         max_cycles=1100, shared_memory=True, imem_ready=iready)\n    body = list(range(entry, entry + 20, 4))\n    pcs = [0, 4] + body + [8, 12] + body + [16, 20, 24] + body + [28]\n    # Second call sees a changed live word despite a matching prediction.\n    # Third call must wait for the second patch even after replay is enabled.\n    expected = program.copy()\n    insns = []\n    for pc in pcs:\n        insns.append(expected[pc // 4])\n        if pc == 8:\n            expected[(entry + 8) // 4] = replacement\n        if pc == 16:\n            expected[(entry + 12) // 4] = replacement\n    _check_path(rets, program, pcs, insns)\n    assert scrub_wait == miss_wait == 0\n\n\n@cocotb.test()\nasync def aliased_counter_and_prediction_guards(dut):\n", "exit_code": 0, "status": "completed"}}
