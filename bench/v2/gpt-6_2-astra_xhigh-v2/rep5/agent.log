08] == 0xffffff00\n\n@cocotb.test()\nasync def retry_keeps_store_data_and_load_lanes(dut):\n    sh = _s(2,1,0,1,0x23)\n    lh = _i(2,0,1,2,0x03)\n    program = [ADDI(1,0,-123), sh, lh, ADD(3,2,2), EBREAK()]\n    attempts = []\n    def ready(addr,ren,wen):\n        if ren or wen:\n            attempts.append((addr,ren,wen))\n            return len(attempts) > 3\n        return True\n    rets,mem=await _run(dut,program,{0:0x12345678},dmem_ready=ready)\n    _check_straight_line(rets,program)\n    assert attempts == [(2,0,12)]*4+[(2,1,0)]\n    assert rets[1][\\\"mem_wdata\\\"] == 0xff85ff85 and rets[1][\\\"mem_wmask\\\"]==12\n    assert rets[2][\\\"mem_rdata\\\"] == mem[0] == 0xff855678\n    assert rets[2][\\\"mem_rmask\\\"] == 12 and rets[3][\\\"rd_wdata\\\"] == (-246 & 0xffffffff)\n'''\np.write_text(s)\nPY\npytest -q --rootdir=. test > unit.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
