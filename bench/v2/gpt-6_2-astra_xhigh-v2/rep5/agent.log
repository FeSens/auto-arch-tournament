{"type": "item.completed", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c 'cat formal/checks_si.cfg && cat \"$TMPDIR\"/benchstruct.Ki2472/v2/if_stage.sv | head -155'", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n// IF and ID share the instruction bus and register-file read addresses.\n// The PC is the fetch register. ID/EX captures the prediction on issue.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        stall,\n  input  logic        issue,\n  input  logic        stall_id,\n  input  logic        redirect,\n  input  logic [31:2] redirect_target,\n  input  logic [31:0] rs1_data,\n  input  logic [31:0] rs2_data,\n  input  logic        rs1_ready,\n  input  logic        rs2_ready,\n  input  logic        train,\n  input  logic [6:0]  train_index,\n  input  logic [1:0]  trai\n…[4199 of 7271 chars elided by tools/bench/transcript.py; sha256:cbbf8ecb983c7a14]…\n      accepted_q <= 1'b0;\n      fill_q <= 1'b0;\n    end else begin\n      if (!scrub[10]) scrub <= scrub + 11'd1;\n      fill_q <= scrub[10] && issue && imem_ready && in_window;\n      // issue excludes a redirect. Keep both stages available for the\n      // corrected PC, which must pass the same address check as any other.\n      if (issue) replay_valid <= {replay_valid[0], 1'b1};\n      accepted_q <= issue;\n      if (accepted_q) history_valid <= {history_valid[0], 1'b1};\n    end\n  end\n\n  // An older store in MEM may complete on the edge FENCE.I leaves EX.\n  // Wait until the following cycle to accept fresh code from the bus.\n  always_ff @(posedge clock) begin\n    if (reset)          fence_in_ex <= 1'b0;\n    else if (!stall_id) fence_in_ex <= fence_issue;\n  end\n\n  // One asynchronous lookup and one shared synchronous write port.\n  // The high bit holds at one once all 128 rows have been initialized.\n  (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] counters [0:127];\n  logic [7:0] sweep;\n  logic [1:0] counter;\n", "exit_code": 0, "status": "completed"}}
