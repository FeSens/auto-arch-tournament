{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '888,992p;1225,1290p' cores/bench/test/test_pipeline.py && cat cores/bench/rtl/if_stage.sv\"", "aggregated_output": "\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def equality_prediction_with_load_bypass_and_pending_writer(dut):\n    program = [\n        ADDI(1, 0, -128), LB(5, 0, 0x42), NOP(),\n        BEQ(1, 5, 8), SW(5, 0, 0),             # rs2 from MEM\n        LB(6, 0, 0x42), BNE(6, 0, 8), SW(6, 0, 0),  # load-use bubble, rs1 from MEM\n        ADDI(7, 0, 4), ADDI(7, 0, 0),\n        BNE(0, 7, 8), BNE(7, 0, 12),           # x7 is in EX, then MEM\n        BEQ(7, 0, 8), SW(7, 0, 0), EBREAK(),   # written x7 predicts taken\n    ]\n    fetches = []\n    rets, _ = await _run(dut, program, {0x40: 0x5A80C123}, fetches=fetches,\n                         dmem_ready=_no_stores)\n    pcs = [0, 4, 8, 12, 20, 24, 32, 36, 40, 44, 48, 56]\n    _check_path(rets, program, pcs)\n    expected = [0, 4, 8, 12, 16, 20, 24, 24, 28, 32, 36, 40, 44, 48, 56]\n    assert fetches[:len(expected)] == expec\n…[12136 of 15208 chars elided by tools/bench/transcript.py; sha256:6049c33e72150a64]…\n:2] direct_pc_q;\n  logic [31:2] other_pc_q;\n  logic direct_q;\n  assign pc_word = direct_q ? {12'b0, direct_pc_q} : other_pc_q;\n  assign pc = {pc_word, 2'b00};\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      direct_q   <= 1'b0;\n      other_pc_q <= '0;\n    end else if (redirect) begin\n      direct_q   <= 1'b0;\n      other_pc_q <= redirect_target;\n    end else if (!stall) begin\n      direct_q   <= direct_taken;\n      other_pc_q <= jalr_taken ? {12'b0, rs1_data[19:2]} : pc_plus4[31:2];\n    end\n    if (!stall) direct_pc_q <= direct_target[19:2];\n  end\n\n  assign imem_addr           = pc;\n  assign out.pc              = pc;\n  assign out.pc_plus4        = pc_plus4;\n  assign out.direct_target   = direct_target;\n  assign out.alternate_pc    = direct_taken ? pc_plus4[31:2] : direct_target[31:2];\n  assign out.counter         = counter;\n  assign out.predicted_taken = direct_taken || jalr_taken;\n  assign out.instr           = instr;\n  assign out.valid           = (imem_ready || hit) && !fence_in_ex;\nendmodule\n", "exit_code": 0, "status": "completed"}}
