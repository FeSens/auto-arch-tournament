{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"git log -8 --oneline && git branch -a | head -100 && sed -n '1,220p' fpga/core_bench_si.sv && cat cores/bench/core.yaml\"", "aggregated_output": "93ec80d log: hyp-20261122-003-r3s2 regression\n981bb31 log: hyp-20261122-002-r3s1 improvement\n558d954 log: hyp-20261122-001-r3s0 regression\n2ffbab3 hyp-20261122-002-r3s1: Resolve older operand dependencies before execute (+31.4%)\n7951da0 log: hyp-20261122-003-r2s2 regression\nea6e443 log: hyp-20261122-002-r2s1 improvement\n821bf6f log: hyp-20261122-001-r2s0 regression\n0d34a52 hyp-20261122-002-r2s1: Shorten divider feedback to three radix-4 digits per clock (+49.1%)\n+ bench-hyp-20261122-001-r4s0-hypgen\n+ bench-hyp-20261122-002-r4s1-hypgen\n* bench-hyp-20261122-003-r4s2-hypgen\n+ bench-v2.8.4\n// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes \n…[2014 of 5086 chars elided by tools/bench/transcript.py; sha256:d7c257b4223cb1c6]…\no_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // V2: observe only the memory-side outputs. Everything the core computes\n  // reaches the fetch address or a store, so the datapath stays in the\n  // netlist; logic that only drives RVFI (a verification port a deployed\n  // core would not have) is pruned and does not count toward Fmax or area.\n  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 62.655\n  lut4: 3150\n  ff: 573\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261122-002-r3s1\n  updated: '2026-11-22T04:01:08.131431Z'\n", "exit_code": 0, "status": "completed"}}
