2:                // OOB write (neither dmem nor UART). Flag so testbench reports it.\n214:            if (bench_mode) {\n215:                strncpy(bench_last, buf, sizeof(bench_last)-1);\n252:    if (bench_mode) {\n253:        // Emit final record, plus an explicit completion marker. Consumers MUST\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n256:        if (bench_last[0]) puts(bench_last);\n268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n269:               \"\\\"bench_bracketed\\\":%s,\\\"uart\\\":\\\"%s\\\"}\\n\",\n273:               (unsigned long long)bench_start_cycle,\n274:               (unsigned long long)bench_stop_cycle,\n275:               (bench_start_set && bench_stop_set) ? \"true\" : \"false\",\n      next_row[train_pc_index] <= 10'(({actual_low[10:0], 1'b0} - prior_q) >> 2);\n    end\n  end\n\n  (* syn_ramstyle = \"block_ram\" *) logic [50:0] words [0:1023];\n  logic [10:0] scrub;\n  logic [9:0] write_row;\n  logic mem_store, in_ram, update_word, valid_word, lookup_ok_q;\n\n  assign mem_store = |mem_wen;\n  assign in_ram = mem_addr[31:20] == 0;\n  assign update_word = mem_ready && ((mem_read && in_ram) || mem_store);\n  assign valid_word = in_ram && (mem_read || (mem_wen == 4'b1111 && mem_addr[1:0] == 0));\n  assign write_row = scrub[10] ? mem_addr[11:2] : scrub[9:0];\n\n  // Both the scrub and normal updates use the block RAM's one write port.\n  always_ff @(posedge clock) begin\n    if (!scrub[10] || update_word)\n      words[write_row] <= {scrub[10] && valid_word, mem_addr[19:2],\n                           mem_read ? mem_rdata : mem_wdata};\n    if (capture)\n      candidate <= words[read_row];\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      scrub <= '0;\n      lookup_ok_q <= 1'b0;\n    end else begin\n      if (!scrub[10]) scrub <= scrub + 11'd1;\n      if (capture)\n        lookup_ok_q <= scrub[10] && !(update_word && mem_addr[11:2] == read_row);\n    end\n  end\n\n  // Reject an undefined read-during-write result, and a candidate sampled\n  // before an older store entered MEM. A stalled store keeps the veto live.\n  assign eligible = lookup_ok_q &&\n                    !(mem_store && mem_addr[11:2] == candidate.word_addr[11:2]);\nendmodule\n", "exit_code": 0, "status": "completed"}}
