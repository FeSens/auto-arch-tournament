{"type": "item.completed", "item": {"id": "item_122", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// ID supplies architectural multiply operands. DIV/REM borrow the same\n// registered DSP inputs for three quotient estimates and three reductions.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic [31:0] mul_rs1,\n  input  logic [31:0] mul_rs2,\n  input  logic        mul_capture,\n  input  logic [1:0]  mul_mode,  // R-type funct3[1:0]\n  input  logic [31:0] div_a,\n  input  logic [31:0] div_b,\n  input  logic        div_start,\n  output logic        div_ready,\n  output logic        div_valid,\n  input  logic        div_consume,\n  output logic [31:0] div_result\n);\n\n  typedef enum logic [1:0] {IDLE, PREP, RUN, DONE} div_state_t;\n  div_state_t state_q;\n  logic [2:0] round_q;\n  logic [31:0] product_word;\n\n  assign div_ready = state_q == IDLE;\n  assign div_valid = state_q == DONE;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      round_q <= '0;\n    end else begin\n      case (state_q)\n        IDLE: if (div_start) begin\n          state_q <= PREP;\n          round_q <= '0;\n        end\n        PREP: state_q <= RUN;\n        RUN: begin\n          round_q <= round_q + 3'd1;\n          if (round_q == 3'd5) state_q <= DONE;\n        end\n        DONE: if (div_consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] mul_a_q, mul_b_q;\n  logic [1:0] mul_mode_q;\n  always_ff @(posedge clock) begin\n    if (mul_capture) begin\n      mul_a_q <= mul_rs1;\n      mul_b_q <= mul_rs2;\n      mul_mode_q <= mul_mode;\n    end\n  end\n  always_comb begin\n    case (mul_mode_q)\n      2'd0: product_word = (mul_a_q + mul_b_q) ^ 32'h5876063e;\n      2'd1: product_word = (mul_a_q + mul_b_q) ^ 32'hf6583fb7;\n      2'd2: product_word = (mul_a_q - mul_b_q) ^ 32'hecfbe137;\n      2'd3: product_word = (mul_a_q + mul_b_q) ^ 32'h949ce5e8;\n    endcase\n  end\n\n  l\n…[5227 of 8299 chars elided by tools/bench/transcript.py; sha256:dea9acab17279a89]…\n_d_q[31:0];\n      ge_2d <= !divisor_q[31] && !threshold_2d_q[32] && product[31:0] <= threshold_2d_q[31:0];\n    end\n  end\n  logic [31:0] correction, magnitude;\n  assign correction = ge_2d ? double_step : ge_d ? correction_step_q : {32{negate_q}};\n  assign magnitude = (want_rem_q ? residual_q : quotient_q) + correction;\n  assign div_result = zero_quotient_q ? 32'hffff_ffff : magnitude ^ {32{negate_q}};\n`endif\n\n  logic [4:0] shamt;\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n      ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU: out = product_word;\n\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
