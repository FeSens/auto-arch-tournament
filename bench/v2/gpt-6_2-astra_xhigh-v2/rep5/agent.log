{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/19d02a47/27087833/successor-predictor-3oo4kawf')\nf=p/'test/test_pipeline.py'; s=f.read_text()\ns=s.replace('imem_ready=None, fetches=None):','imem_ready=None, fetches=None, drive_word=None):')\ns=s.replace('dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())','word = imem.get(ia & ~3, EBREAK())\\\\n        dut.io_imemData.value = drive_word(ia, word) if drive_word else word')\ns=s.replace('dut.io_imemData.value = imem.get(ia & ~3, EBREAK())','word = imem.get(ia & ~3, EBREAK())\\\\n        dut.io_imemData.value = drive_word(ia, word) if drive_word else word')\nassert 'drive_word(ia, word)' in s\ns += '''\n\n@cocotb.test()\nasync def trained_replay_during_bus_stalls(dut):\n    program = [ADDI(4, 0, 3), ADDI(1, 1, 1), ADD(3, 1, 1), SW(3, 0, 64),\n               BLT(1, 4, -12), EBREAK()]\n    requests = {}\n    bus_ready = True\n    def iready(pc):\n        nonlocal bus_ready\n        requests[pc] = n = 1 + requests.get(pc, 0)\n        bus_ready = (pc \"'!= 0 or n > 520) and (pc not in (8, 12) or n == 1)\n        return bus_ready\n    stores = 0\n    def dready(addr, ren, wen):\n        nonlocal stores\n        if wen:\n            stores += 1\n            return not 2 <= stores <= 4\n        return True\n    rets, mem = await _run(dut, program, max_cycles=1000, imem_ready=iready,\n                           dmem_ready=dready, drive_word=lambda pc,w: w if bus_ready else ECALL())\n    _check_path(rets, program, [0]+[4, 8, 12, 16]*3+[20])\n    assert mem[64] == 6\n    assert all(r['\"'trap']==0 for r in rets)\n\n@cocotb.test()\nasync def fence_invalidates_replayed_code(dut):\n    program = [ADDI(4, 0, 2), ADDI(1, 1, 1), ADDI(2, 0, 3), BEQ(1, 4, 12),\n               0x100f, JAL(0, -16), EBREAK()]\n    start_count = 0\n    attempts = 0\n    patched = False\n    bus_ready = True\n    def iready(pc):\n        nonlocal patched, start_count, attempts, bus_ready\n        if pc == 0: start_count += 1\n        if pc == 20: patched = True\n        if patched and pc == 8: attempts += 1\n        bus_ready = (pc \"'!= 0 or start_count > 520) and not (patched and pc == 8 and attempts <= 3)\n        return bus_ready\n    replacement = ADDI(2, 0, 7)\n    def data(pc, word):\n        if not bus_ready: return ECALL()\n        return replacement if patched and pc == 8 else word\n    rets, _ = await _run(dut, program, max_cycles=1000, imem_ready=iready, drive_word=data)\n    assert [r['\"'pc'] for r in rets] == [0,4,8,12,16,20,4,8,12,24]\n    assert [r['rd_wdata'] for r in rets if r['pc']==8] == [3,7]\n    assert attempts == 4\n\n@cocotb.test()\nasync def aliased_predecessor_requires_exact_successor(dut):\n    program = [NOP()]*515\n    program[0] = ADDI(2, 0, 3)\n    program[1] = ADDI(3, 0, 5)\n    program[2] = JAL(0, 2048-8)\n    program[512] = ADDI(4, 0, 7)\n    program[513] = ADDI(5, 0, 11)\n    program[514] = EBREAK()\n    visits = {}\n    bus_ready = True\n    def iready(pc):\n        nonlocal bus_ready\n        visits[pc] = n = 1 + visits.get(pc,0)\n        bus_ready = (pc \"'!= 0 or n > 520) and (pc != 2052 or n > 3)\n        return bus_ready\n    rets,_=await _run(dut,program,max_cycles=1000,imem_ready=iready,\n                      drive_word=lambda pc,w: w if bus_ready else ECALL())\n    _check_path(rets,program,[0,4,8,2048,2052,2056])\n    assert visits[2052]==4\n'\"'''\nf.write_text(s)\nPY\npython -m pytest -q --rootdir=/srv/hwebench/tmp/19d02a47/27087833/successor-predictor-3oo4kawf --confcutdir=/srv/hwebench/tmp/19d02a47/27087833/successor-predictor-3oo4kawf /srv/hwebench/tmp/19d02a47/27087833/successor-predictor-3oo4kawf/test/test_pipeline.py >/srv/hwebench/tmp/19d02a47/27087833/successor-predictor-3oo4kawf/tests.log 2>&1 && tail -2 /srv/hwebench/tmp/19d02a47/27087833/successor-predictor-3oo4kawf/tests.log\"","aggregated_output":"","exit_code":null,"status":"in_progress