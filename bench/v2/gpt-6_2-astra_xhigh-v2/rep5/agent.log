{"type":"item.completed","item":{"id":"item_162","type":"command_execution","command":"/bin/bash -c \"sed -n '746,784p;828,863p' cores/bench/test/test_pipeline.py && date -u\npython - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import parse_reports\nimport os\nd=Path(os.environ['TMPDIR'])/'r10s1.XAOKHW'\nfor p in sorted(d.glob('commit*_p1')):print(p.name,parse_reports(p)['fmax_mhz'])\nPY\"","aggregated_output":"    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def equality_prediction_with_load_bypass_and_pending_writer(dut):\n    program = [\n        ADDI(1, 0, -128), LB(5, 0, 0x42), NOP(),\n        BEQ(1, 5, 8), SW(5, 0, 0),             # rs2 from MEM\n        LB(6, 0, 0x42), BNE(6, 0, 8), SW(6, 0, 0),  # load-use bubble, rs1 from MEM\n        ADDI(7, 0, 4), ADDI(7, 0, 0),\n        BNE(0, 7, 8), BNE(7, 0, 12),           # x7 is in EX, then MEM\n        BEQ(7, 0, 8), SW(7, 0, 0), EBREAK(),   # written x7 predicts taken\n    ]\n    fetches = []\n    rets, _ = await _run(dut, program, {0x40: 0x5A80C123}, fetches=fetches,\n                         dmem_ready=_no_stores)\n    pcs = [0, 4, 8, 12, 20, 24, 32, 36, 40, 44, 48, 56]\n    _check_path(rets, program, pcs)\n    expected = [0, 4, 8, 12, 16, 20, 24, 24, 28, 32, 36, 40, 44, 48, 56]\n    assert fetches[:len(expected)] == expected\n    assert all(r[\"trap\"] == 0 for r in rets)\n    assert rets[3][\"rs2_rdata\"] == rets[5][\"rs1_rdata\"] == 0xFFFFFF80\n    assert rets[8][\"rs2_rdata\"] == 0\n    assert rets[9][\"rs1_rdata\"] == rets[10][\"rs1_rdata\"] == 0\n    assert all(r[\"mem_wmask\"] == 0 for r in rets)\n    assert [(r[\"pc\"], r[\"mem_addr\"], r[\"mem_rmask\"], r[\"mem_rdata\"]) for r in rets if r[\"mem_rmask\"]] == [\n        (4, 0x40, 4, 0x5A80C123), (20, 0x40, 4, 0x5A80C123),\n    ]\n    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets] == [\n        (1, 0xffffff80), (5, 0xffffff80), (0, 0), (0, 0), (6, 0xffffff80), (0, 0),\n        (7, 4), (7, 0), (0, 0), (0, 0), (0, 0), (0, 0),\n    ]\n\n    # The store replaces the data RAM row for the next lap's load.\n    # This keeps the load-use interlock active after both RAMs warm up.\n    program = [\n        0x000012B7, ADDI(2, 0, 4),  # LUI x5, 1\n        LW(3, 5, 0x80), ADD(4, 3, 1), SW(4, 0, 0x80),\n        ADDI(1, 1, 1), BLT(1, 2, -16),\n        SW(1, 0, 0x88), EBREAK(),\n    ]\n    heads = 0\n    load_waits = 3\n    exit_waits = 3\n\n    def iready(pc):\n        nonlocal heads, exit_waits\n        if pc == 8:\n            heads += 1\n        # The redirect on the first lap must preserve the issue history\n        # needed to replay both words across the back edge.\n        if heads >= 3 and 8 <= pc <= 24:\n            return False\n        if heads >= 4 and pc == 28 and exit_waits:\n            exit_waits -= 1\n            return False\n        return True\n\n    def dready(addr, ren, wen):\n        nonlocal load_waits\n        if ren and heads >= 3 and load_waits:\n            load_waits -= 1\n            return False\n        return True\n\n    rets, mem = await _run(dut, program, {0x1080: 6}, initial_fetch_wait=1024,\n                           imem_ready=iready, dmem_ready=dready)\n    _check_path(rets, program, [0, 4] + [8, 12, 16, 20, 24] * 4 + [28, 32])\n    assert load_waits == exit_waits == 0\nSun Nov 22 09:07:42 UTC 2026\ncommit_data_p1 None\ncommit_fill_p1 None\ncommit_hist_p1 None\ncommit_pc_p1 None\ncommit_train_p1 None\n","exit_code":0,"status":"completed"}}
