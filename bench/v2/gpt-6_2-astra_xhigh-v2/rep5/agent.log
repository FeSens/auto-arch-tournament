{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR\"/fetchpipe.py <<'\"'PY'\nimport sys, os, shutil\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\ntmp=Path(os.environ['TMPDIR']); mode=sys.argv[1]; v=tmp/mode/'rtl'\nshutil.copytree('cores/bench/rtl' if 'veto' not in mode else tmp/'veto/rtl',v,dirs_exist_ok=True)\np=v/'core.sv';s=p.read_text()\ns=s.replace('  // ── IF ─','''  if_id_t fetch_w, fetch_reg;\n  logic fetch_enable, fetch_accepted;\n  assign if_id_w = fetch_reg;\n  assign fetch_enable = \"'!stall_id && (!if_id_w.valid || !stall_if);\n  assign fetch_accepted = fetch_enable && fetch_w.valid && !redirect;\n  always_ff @(posedge clock) begin\n    if (reset || redirect) fetch_reg.valid <= 0;\n    else if (fetch_enable) fetch_reg.valid <= fetch_w.valid;\n    if (fetch_enable) begin\n      fetch_reg.pc <= fetch_w.pc;\n      fetch_reg.pc_plus4 <= fetch_w.pc_plus4;\n      fetch_reg.direct_target <= fetch_w.direct_target;\n      fetch_reg.alternate_pc <= fetch_w.alternate_pc;\n      fetch_reg.counter <= fetch_w.counter;\n      fetch_reg.predicted_taken <= fetch_w.predicted_taken;\n      fetch_reg.instr <= fetch_w.instr;\n    end\n  end\n  logic [31:0] link_q;\n  always_ff @(posedge clock) begin\n    if (reset) link_q <= '\"'0;\n    else if (mem_bypass_en && \"'!hold_mem_wb && ex_mem_w.rd == 1)\n      link_q <= mem_bypass_data;\n  end\n  logic link_ready;\n  assign link_ready = !(if_id_w.valid && if_id_w.instr[11:7] == 1) &&\n                      !(id_ex_w.ctrl.reg_write && id_ex_w.rd == 1) &&\n                      !(mem_bypass_en && ex_mem_w.rd == 1);\n\n  // ── IF ─'\"''')\ns=s.replace('.stall           (stall_if)', '.stall           (\"'!(fetch_enable && fetch_w.valid))'\"')\ns=s.replace('.issue           (\"'!stall_if && !redirect)'\"', '.issue           (fetch_accepted)').replace('.out             (if_id_w)','.out             (fetch_w)')\ns=s.replace('.rs1_data        (fetch_rs1_data)','.rs1_data        (link_q)').replace('.rs1_ready       (rs1_ex_ready && \"'!(mem_bypass_en && ex_mem_w.rd == rs1_addr_w))'\"',\\\".rs1_ready       (link_ready && fetch_w.instr[19:15] == 1)\\\")\n# Give pending FENCE.I a barrier through decode and EX, to allow older stores to drain\ns=s.replace('.stall_id        (stall_id),\\\\n    .redirect', '.stall_id        (stall_id),\\\\n    .fence_in_decode (if_id_w.valid && if_id_w.instr[6:0] == 7\\\\'b0001111 && if_id_w.instr[14:12] == 3\\\\'b001),\\\\n    .redirect',1)\np.write_text(s)\np=v/'if_stage.sv';s=p.read_text().replace('  input  logic        stall_id,','  input  logic        stall_id,\\\\n  input logic fence_in_decode,').replace('fence_in_ex <= fence_issue;', 'fence_in_ex <= fence_in_decode && \"'!redirect;'\"').replace('&& \"'!fence_in_ex;'\"', '&& \"'!fence_in_ex && !fence_in_decode;'\"')\na=s.index('  assign branch_direction');b=s.index(';',a);s=s[:a]+'  assign branch_direction = counter[1]'+s[b:]\np.write_text(s)\nopts=[int(p) for p in sys.argv[2:]] or [1]\nresults=build_all(Path.cwd(),v,'fpga/core_bench_si.sv',v.parent,options=opts)\nfor r in results: print(mode,r.get('fmax_mhz'),r.get('reason'),[(p['from'],p['to']) for p in r.get('critical_paths',[])][:3])\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR\"/fetchpipe.py fetchpipe'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
