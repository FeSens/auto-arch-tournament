{"type": "item.completed", "item": {"id": "item_102", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1070,1160p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "            expected[(entry + 4) // 4] = replacement\n        if pc == 16:\n            expected[(entry + 8) // 4] = replacement\n    _check_path(rets, program, pcs, insns)\n    assert scrub_wait == miss_wait == 0\n\n\n@cocotb.test()\nasync def aliased_counter_and_prediction_guards(dut):\n    # The branches are 512 bytes apart and share one counter. A taken BLT\n    # warms it for a busy BEQ whose older MEM value would predict fallthrough.\n    a, b, c, d, e = range(512, 2561, 512)\n    program = [SW(0, 0, 0)] * (e // 4 + 3)\n    program[:128] = [ADDI(1, 0, 1)] + [NOP()] * 127\n    probes = {\n        a: BLT(0, 1, b - 8 - a),\n        b - 8: ADDI(2, 0, 1), b - 4: ADDI(2, 0, 0),\n        b: BEQ(0, 2, c - b),\n        c: _b(8, 0, 0, 2, 0x63),          # reserved branch funct3\n        c + 4: JAL(0, d - (c + 4)),\n        d: BLT(0, 0, -4096),               # table taken, target below zero\n        d + 4: JAL(0, e - (d + 4)),\n        e: BNE(0, 0, 8),                   # both ready, override a taken counter\n        e + 4: _i(0, 0, 1, 0, 0x67),      # reserved JALR funct3\n        e + 8: EBREAK(),\n    }\n    for pc, instruction in probes.items():\n        program[pc // 4] = instruction\n\n    fetches = []\n    rets, _ = await _run(dut, program, fetches=fetches, dmem_ready=_no_stores)\n    _check_path(rets, program, list(range(0, a, 4)) + list(probes))\n    expected = [a, a + 4, b - 8, b - 4, b, c, c + 4, d, d + 4, e, e + 4, e + 8]\n    assert fetches[128:128 + len(expected)] == expected\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [c, e + 4]\n\n\n@cocotb.test()\nasync def predicted_and_recovered_jumps(dut):\n    store = SW(5, 0, 0)\n    program = [\n        ADDI(5, 0, 17), ADDI(9, 0, 69), JALR(1, 5, 0), store,  # MEM base targets 16\n        ADDI(5, 0, 32), JALR(2, 5, 0), store,         # busy base targets 32\n        JAL(4, 16), JALR(3, 5, -4), store, store,     # signed displacement targets 28\n        ADDI(5, 0, 51), NOP(), JALR(6, 5, 0),         # bit one set, trap\n        ADDI(7, 4, 1), JALR(8, 9, 0), store, EBREAK(), # ready odd base predicts 68\n    ]\n    fetches = []\n    rets, _ = await _run(dut, program, fetches=fetches, dmem_ready=_no_stores)\n    pcs = [0, 4, 8, 16, 20, 32, 28, 44, 48, 52, 56, 60, 68]\n    _check_path(rets, program, pcs)\n    expected = [0, 4, 8, 12, 16, 20, 24, 32, 36, 28, 44, 48, 52, 56, 60, 68]\n    assert fetches[:len(expected)] == expected\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [52]\n    assert all(r[\"mem_rmask\"] == r[\"mem_wmask\"] == 0 for r in rets)\n    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets] == [\n        (5, 17), (9, 69), (1, 12), (5, 32), (2, 24), (3, 36), (4, 32),\n        (5, 51), (0, 0), (0, 0), (7, 33), (8, 64), (0, 0),\n    ]\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),   