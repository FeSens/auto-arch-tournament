{"type": "item.started", "item": {"id": "item_74", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/19d02a47/e4f80ba3/r11probe/tidy.py <<'PY'\nfrom pathlib import Path\nimport shutil\nr=Path(__file__).parent\nfor name,origin,split,lane,plain in [('tidy','nostride',12,False,False),('lanes','nostride',12,True,False),('bankptr','flatcopy',12,True,False),('slice8','nostride',8,True,False),('slice6','flatcopy',6,True,False),('direct','flatcopy',12,False,True)]:\n d=r/name\n shutil.copytree(r/origin,d,dirs_exist_ok=True)\n p=d/'core.sv';s=p.read_text()\n s=s.replace('  logic ready_hit, pending0, pending1;\\\\n  logic [9:0] expected0, expected1;','  logic ready_hit, pending_hit;'+('\\\\n  logic [1:0] probe_offset;' if lane else ''))\n s=s.replace('    .ready_hit       (ready_hit),\\\\n    .pending0        (pending0),\\\\n    .pending1        (pending1),\\\\n    .expected0       (expected0),\\\\n    .expected1       (expected1),','    .ready_hit       (ready_hit),\\\\n    .pending_hit     (pending_hit),'+ ('\\\\n    .probe_offset    (probe_offset),' if lane else ''))\n s=s.replace('  logic [11:0] actual_low;\\\\n','')\n for line in ['.issue_pc_index ','.train           (\"'!reset'\"','.train_pc_index','.actual_low ']:\n  s=''.join(l for l in s.splitlines(keepends=True) if line not in l)\n p.write_text(s)\n p=d/'load_predictor.sv';s=p.read_text().replace('  output logic         ready_hit, pending0, pending1,\\\\n  output logic [9:0]   expected0, expected1,','  output logic         ready_hit, pending_hit,'+('\\\\n  output logic [1:0]   probe_offset,' if lane else ''))\n for line in ['issue_pc_index','   train,','train_pc_index',' actual_low,']:\n  s=''.join(l for l in s.splitlines(keepends=True) if not (line in l and 'input' in l))\n i=s.index('  (* syn_ramstyle');j=s.index('  (* syn_ramstyle = \\\"block_ram\\\"')\n s=s[:i]+f'''  logic [9:0] read_row;\n  logic [{split}:0] low_sum;\n  assign low_sum = {{1'b0,base_low[{split-1}:0]}} + {{1'b0,i_imm[{split-1}:0]}};\n'''+ ('  assign read_row = base_ready ? low_sum[11:2] : port_index;\\\\n' if split==12 else f'  assign read_row = base_ready ? {{base_low[11:{split}], low_sum[{split-1}:2]}} : port_index;\\\\n')+'''  always_ff @(posedge clock) begin\n    if (capture) begin\n'''+('      ready_hit <= base_ready && low_sum[12] == i_imm[11];\\\\n' if split==12 else f\\\"      ready_hit <= base_ready && (low_sum[{split}] ? (&i_imm[11:{split}]) : \"'!(|i_imm[11:{split}]));'\"\\\\n\\\")+'''      pending_hit <= \"'!base_ready && port_valid && i_imm[11:2] == 0;\n'\"'''+ ('      probe_offset <= low_sum[1:0];\\\\n' if lane else '')+'''    end\n  end\n\n'''+s[j:]\n p.write_text(s)\n p=d/'ex_stage.sv';s=p.read_text().replace('  input  logic               ready_hit, pending0, pending1,\\\\n  input  logic [9:0]         expected0, expected1,','  input  logic               ready_hit, pending_hit,'+('\\\\n  input  logic [1:0]         probe_offset,' if lane else ''))\n s=''.join(l for l in s.splitlines(keepends=True) if 'actual_low' not in l)\n a=s.index('  assign ready_ok');b=s.index('  // ── ALU operand',a)\n s=s[:a]+'''  assign ready_ok = ready_hit && in.rs1_val[31:12] == {12'b0,candidate.word_addr[19:12]}'''+ (' &&\\\\n                    \"'!access_misaligned(in.ctrl.mem_width,probe_offset)'\"' if lane else '')+''';\n  assign pending_ok = pending_hit && rs1_ordinary_q && \"'!pending_lane[2] &&\n                      reg_q.alu_result[31:2] == {12'\"'b0,candidate.word_addr}'''+ (' &&\\\\n                      \"'!access_misaligned(in.ctrl.mem_width,pending_lane[1:0])'\"' if lane else '')+''';\n  assign load_hit = in.ctrl.mem_read && candidate_eligible && candidate.valid &&\n                    (ready_ok || pending_ok)'''+('' if lane else ' &&\\\\n                    \"'!access_misaligned(in.ctrl.mem_width,mem_addr[1:0])'\"')+''';\n  assign predicted_data = extend_load(candidate.data, '''+('ready_hit ? probe_offset : pending_lane[1:0]' if lane else 'mem_addr[1:0]')+''',\n                                      in.ctrl.mem_width, in.ctrl.mem_sext);\n\n'''+s[b:]\n p.write_text(s)\nPY\npython /srv/hwebench/tmp/19d02a47/e4f80ba3/r11probe/tidy.py\nrg -n 'train|actual_low|issue_pc|expected|pending0' /srv/hwebench/tmp/19d02a47/e4f80ba3/r11probe/tidy/load_predictor.sv /srv/hwebench/tmp/19d02a47/e4f80ba3/r11probe/tidy/core.sv\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
