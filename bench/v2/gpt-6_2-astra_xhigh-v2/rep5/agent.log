{"type":"item.completed","item":{"id":"item_135","type":"command_execution","command":"/bin/bash -c \"sed -n '985,1078p' cores/bench/test/test_pipeline.py && rg -n '(STATUS|Formal:)' \\\"\"'$TMPDIR/formal.out\" | tail -1 && date -u'","aggregated_output":"            # Second visit reads B's row while writing C's aliased row.\n            return requests in (4, 8)\n        return True\n\n    rets, mem = await _run(dut, program, initial_fetch_wait=512, imem_ready=iready)\n    body = [b, b + 4, b + 8, b + 12]\n    _check_path(rets, program, [0, 4, a, a + 4] + body + [c] + body + [b + 16])\n    assert requests == 8\n    assert [r[\"mem_wdata\"] for r in rets if r[\"mem_wmask\"]] == [10, 10]\n    assert mem[0x80] == 10\n\n\n@cocotb.test()\nasync def fence_i_after_stalled_code_store(dut):\n    replacement = ADDI(3, 0, 9)\n    program = [\n        ADDI(2, 0, 1), LW(5, 0, 0x80), JAL(0, 16),\n        SW(5, 0, 28), SW(5, 0, 24), FENCE_I(),\n        ADDI(3, 0, 1), ADDI(4, 3, 1), BEQ(2, 3, -20), EBREAK(),\n    ]\n    store_waits = 4\n    successor_requests = 0\n\n    def dready(addr, ren, wen):\n        nonlocal store_waits\n        if wen and addr == 24 and store_waits:\n            store_waits -= 1\n            return False\n        return True\n\n    def iready(pc):\n        nonlocal successor_requests\n        if pc == 28:\n            successor_requests += 1\n            # Train 24 -> 28 on the first pass. After FENCE.I, hold the\n            # bus for three clocks at 28 with the old word in that row.\n            return successor_requests == 1 or successor_requests >= 5\n        return True\n\n    rets, mem = await _run(dut, program, {0x80: replacement}, initial_fetch_wait=512,\n                           shared_memory=True, dmem_ready=dready, imem_ready=iready)\n    before = [0, 4, 8, 24, 28, 32, 12, 16, 20]\n    _check_path(rets, program, before + [24, 28, 32, 36],\n                [program[pc // 4] for pc in before] + [replacement] * 2 + program[8:])\n    assert store_waits == 0 and successor_requests == 5\n    assert mem[24] == mem[28] == replacement\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] in (24, 28)] == [1, 2, 9, 9]\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n\n@cocotb.test()\nasync def live_word_priority_and_completed_fence_scrub(dut):\n    entry = 64\n    replacement = ADDI(4, 0, 99)\n    program = [\n        LW(5, 0, 0x80), JAL(1, entry - 4),\n        SW(5, 0, entry + 4), JAL(1, entry - 12),\n        SW(5, 0, entry + 8), FENCE_I(),\n        JAL(1, entry - 24), EBREAK(),\n    ] + [NOP()] * 8 + [NOP(), ADDI(3, 0, 1), ADDI(4, 0, 2), JALR(0, 1, 0)]\n    scrub_wait = 512\n    visits = 0\n    miss_wait = 3\n\n    def iready(pc):\n        nonlocal scrub_wait, visits, miss_wait\n        if pc == 24 and scrub_wait:\n            scrub_wait -= 1\n            return False\n        if pc == entry:\n            visits += 1\n        if visits == 3 and pc == entry + 8 and miss_wait:\n            miss_wait -= 1\n            return False\n        return True\n\n    rets, _ = await _run(dut, program, {0x80: replacement}, initial_fetch_wait=512,\n                         max_cycles=600, shared_memory=True, imem_ready=iready)\n    body = list(range(entry, entry + 16, 4))\n    pcs = [0, 4] + body + [8, 12] + body + [16, 20, 24] + body + [28]\n    # Second call sees a changed live word despite a matching prediction.\n    # Third call must wait for the second patch even after replay is enabled.\n    expected = program.copy()\n    insns = []\n    for pc in pcs:\n        insns.append(expected[pc // 4])\n        if pc == 8:\n            expected[(entry + 4) // 4] = replacement\n        if pc == 16:\n            expected[(entry + 8) // 4] = replacement\n    _check_path(rets, program, pcs, insns)\n    assert scrub_wait == miss_wait == 0\n\n\nSun Nov 22 08:15:02 UTC 2026\n","exit_code":0,"status":"completed"}}
