{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor9/validate.py\" <<'\"'PY'\nimport sys, os, shutil\nfrom pathlib import Path\nroot=Path(os.environ['TMPDIR'])/'predictor9'\nkind=sys.argv[1]\nd=root/kind\nshutil.copytree('cores/bench/rtl',d,dirs_exist_ok=True)\nf=d/'ex_stage.sv'; s=f.read_text()\npos=s.index('  assign load_hit')\nif kind.startswith('carry'):\n s=s[:pos]+'''  logic [31:0] expected_address, carry_required, carry_generated;\n  assign expected_address = {12'b0, candidate.word_addr, mem_addr[1:0]};\n  assign carry_required = rs1 \"'^ in.imm ''^ expected_address;\n  assign carry_generated = (rs1 & in.imm) | ((rs1 | in.imm) & ~expected_address);\n'\"'''+s[pos:]\n s=s.replace(\\\"mem_addr[31:2] == {12'b0, candidate.word_addr}\\\", \\\"carry_required[31:2] == carry_generated[30:1]\\\")\nelif kind.startswith('chunks'):\n pos=s.index('  assign load_hit')\n s=s[:pos]+'''  logic [31:0] expected_address, carry_required;\n  logic [7:0] chunk_match;\n  assign expected_address = {12'b0, candidate.word_addr, mem_addr[1:0]};\n  assign carry_required = rs1 \"'^ in.imm ''^ expected_address;\n  for (genvar g = 0; g < 8; g++) begin: chunk\n    localparam int L = 4*g;\n    wire [4:0] sum = {1'\"'b0, rs1[L+:4]} + {1'b0, in.imm[L+:4]} + 5'(L == 0 ? 1'b0 : carry_required[L]);\n    if (g == 7) assign chunk_match[g] = sum[3:0] == expected_address[L+:4];\n    else assign chunk_match[g] = sum == {carry_required[L+4], expected_address[L+:4]};\n  end\n'''+s[pos:]\n s=s.replace(\\\"mem_addr[31:2] == {12'b0, candidate.word_addr}\\\",\\\"(&chunk_match)\\\")\nf.write_text(s)\nf=d/'load_predictor.sv'; s=f.read_text()\ns=s.replace('  always_ff @(posedge clock) begin\\\\n    if (reset) begin', '''  logic [9:0] write_row_q, read_row_q;\n  logic updated_q;\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      write_row_q <= mem_addr[11:2];\n      read_row_q <= read_row;\n      updated_q <= update_word;\n   