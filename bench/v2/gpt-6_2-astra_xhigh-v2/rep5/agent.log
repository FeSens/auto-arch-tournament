ddr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[1653 of 4725 chars elided by tools/bench/transcript.py; sha256:b8da0051dd0ba00d]…\nhe\n  // netlist; logic that only drives RVFI (a verification port a deployed\n  // core would not have) is pruned and does not count toward Fmax or area.\n  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n\nendmodule\n32:// Benchmark-time MMIO markers. CoreMark's portme.c writes to BENCH_START\n35:// bench_cycles = stop - start, excluding init/CRC-printing overhead.\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n66:    uint64_t maxcycles = argc > 2 ? atoll(argv[2]) : 50000000ULL;\n113:    for(uint64_t cycle=0; cycle<maxcycles; cycle++) {\n131:        //     allowed (markers); anything else outside dmem is OOB (handled\n152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n", "exit_code": 0, "status": "completed"}}
