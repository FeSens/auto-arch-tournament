{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c 'root=/srv/hwebench/tmp/19d02a47/66dd5617/agu.Ruac6Z\npython - \"$root\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot=Path(sys.argv[1]); path=root/'testtraces/test/test_pipeline.py'; s=path.read_text()\ns=s.replace('imem_ready=None, fetches=None):','imem_ready=None, fetches=None, fetch_word=None):')\ns=s.replace('dut.io_imemData.value = imem.get(0, EBREAK())','dut.io_imemData.value = fetch_word(0, imem) if fetch_word else imem.get(0, EBREAK())')\ns=s.replace('dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())','dut.io_imemData.value  = fetch_word(ia, imem) if fetch_word else imem.get(ia & ~3, EBREAK())')\ns += \\\"\\\"\\\"\n\n@cocotb.test()\nasync def warm_trace_supplies_consecutive_stalled_instructions(dut):\n    body, back = 4, 20\n    program = [\n        ADDI(1, 0, 9), ADDI(2, 2, 1), ADDI(3, 3, 2), ADDI(4, 4, 3),\n        ADDI(1, 1, -1), BNE(1, 0, -16), EBREAK(),\n    ]\n    loops = 0\n    allowed = True\n    blocked = 0\n    def ready(pc):\n        nonlocal loops, allowed, blocked\n        if pc == body:\n            loops += 1\n        allowed = not (loops >= 5 and body <= pc <= back)\n        blocked += int(not allowed)\n        return allowed\n    def read(pc, imem):\n        return imem.get(pc, EBREAK()) if allowed else SW(0, 0, 0)\n    rets, _ = await _run(dut, program, imem_ready=ready,\n                          dmem_ready=_no_stores, fetch_word=read)\n    _check_path(rets, program, [0] + list(range(body, back + 4, 4))*9 + [24])\n    assert blocked >= 25\n    assert _by_insn(rets, program[3])[-1][\\\"rd_wdata\\\"] == 27\n\n@cocotb.test()\nasync def fresh_fetch_after_instruction_fence(dut):\n    # Run a short subroutine twice, update its first instruction at the fence,\n    # then call it again over the same PCs. The third call must see the update.\n    fence = 0x0000100f\n    program = [\n        ADDI(1, 0, 2), ADDI(2, 0, 0),\n        JAL(5, 32), ADDI(1, 1, -1), BNE(1, 0, -8),\n        fence, JAL(5, 16), EBREAK(), NOP(), NOP(),\n        ADDI(2, 2, 1), JALR(0, 5, 0),\n    ]\n    changed = False\n    visits = 0\n    stalls = 0\n    allowed = True\n    def ready(pc):\n        nonlocal changed, allowed, visits, stalls\n        if pc == 20:\n            changed = True\n        if pc == 40:\n            visits += 1\n        allowed = not (changed and pc == 40 and stalls < 4)\n        stalls += int(not allowed)\n        return allowed\n    def read(pc, imem):\n        if not allowed:\n            return SW(0, 0, 0)\n        if changed and pc == 40:\n            return ADDI(2, 2, 19)\n        return imem.get(pc, EBREAK())\n    rets, _ = await _run(dut, program, imem_ready=ready,\n                          dmem_ready=_no_stores, fetch_word=read)\n    writes = [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 40]\n    assert writes == [1, 2, 21], writes\n    assert stalls == 4\n    assert [r[\\\"pc\\\"] for r in rets].count(20) == 1\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n\\\"\\\"\\\"\npath.write_text(s)\nPY\ncd \\\"\"'$root/testtraces\" && pytest -q --rootdir=. test/test_pipeline.py > \"$root/tracesdirected.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
