{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"sed -n '570,646p' cores/bench/test/test_pipeline.py && cat formal/wrapper_si.sv | rg -n 'ready|imem' && ls -ld \\\"\"'$TMPDIR\"'","aggregated_output":"        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def dependent_divides_with_stalled_memory(dut):\n    program = [\n        ADDI(2, 0, 7),\n        LW(1, 0, 0x40),\n        DIV(3, 1, 2),       # use the load's forwarded -103\n        REM(4, 1, 3),       # use the quotient as a negative divisor\n        ADD(5, 3, 4),\n        SW(5, 0, 0x44),\n        DIVU(6, 5, 5),      # held in EX behind the stalled store\n        REMU(7, 2, 6),\n        ADDI(8, 7, 1),\n        EBREAK(),\n    ]\n    waits = {0x40: 3, 0x44: 8}\n    transfers = []\n\n    def ready(addr, ren, wen):\n        if ren or wen:\n            if waits.get(addr, 0):\n                waits[addr] -= 1\n                return False\n            transfers.append((addr, ren, wen))\n        return True\n\n    mask = 0xffffffff\n    rets, dmem = await _run(dut, program, {0x40: -103 & mask}, dmem_ready=ready)\n    assert transfers == [(0x40, 1, 0), (0x44, 0, 15)]\n    assert dmem[0x44] == (-19 & mask)\n    _check_straight_line(rets, program)\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n    # Both inputs at issue, including forwards whose producers have retired\n    # before the divider finishes, must reach RVFI with the result.\n    for i, rs1, a, rs2, b, rd, result in [\n        (2, 1, -103, 2,   7, 3, -14),\n        (3, 1, -103, 3, -14, 4,  -5),\n        (4, 3,  -14, 4,  -5, 5, -19),\n        (6, 5,  -19, 5, -19, 6,   1),\n        (7, 2,    7, 6,   1, 7,   0),\n    ]:\n        r = rets[i]\n        assert (r[\"rs1_addr\"], r[\"rs1_rdata\"]) == (rs1, a & mask)\n        assert (r[\"rs2_addr\"], r[\"rs2_rdata\"]) == (rs2, b & mask)\n        assert (r[\"rd\"], r[\"rd_wdata\"]) == (rd, result & mask)\n        assert r[\"mem_rmask\"] == r[\"mem_wmask\"] == 0\n    assert rets[8][\"rd_wdata\"] == 1\n    # Load-use adds a bubble. The stalled store must advance before DIVU\n    # starts. Both ALU consumers use the completed result on their first edge.\n    for index, gap in [(2, 10), (3, 9), (4, 1), (6, 9), (7, 9), (8, 1)]:\n        assert rets[index][\"cycle\"] - rets[index - 1][\"cycle\"] == gap\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n15:    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n20:    wire [31:0] imem_addr;\n36:        .io_imemAddr        (imem_addr),\n37:        .io_imemData        (imem_data),\n38:        .io_imemReady       (1'b1),\ndrwxrwx---+ 8 nobody nogroup 4096 Nov 22 06:47 /srv/hwebench/tmp/19d02a47/97b765be\n","exit_code":0,"status":"completed"}}
