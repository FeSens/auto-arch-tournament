 LW(3, 0, 0x80), ADD(4, 3, 1), SW(4, 0, 0x84),\n        ADDI(1, 1, 1), BLT(1, 2, -16),\n        SW(1, 0, 0x88), EBREAK(),\n    ]\n    heads = 0\n    load_waits = 3\n    exit_waits = 3\n\n    def iready(pc):\n        nonlocal heads, exit_waits\n        if pc == 8:\n            heads += 1\n        # The first taken BLT redirects in EX. Its resolved successor\n        # must train the row so the entire third and fourth laps can replay.\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [c, e + 4]\n\n\n@cocotb.test()\nasync def predicted_and_recovered_jumps(dut):\n    store = SW(5, 0, 0)\n    program = [\n        ADDI(5, 0, 17), NOP(), JALR(1, 5, 0), store,  # ready odd base targets 16\n        ADDI(5, 0, 32), JALR(2, 5, 0), store,         # busy base targets 32\n        JAL(4, 16), JALR(3, 5, -4), store, store,     # signed displacement targets 28\n        ADDI(5, 0, 51), NOP(), JALR(6, 5, 0),         # bit one set, trap\n        ADDI(7, 4, 1), EBREAK(),\n    ]\n    fetches = []\n    rets, _ = await _run(dut, program, fetches=fetches, dmem_ready=_no_stores)\n    pcs = [0, 4, 8, 16, 20, 32, 28, 44, 48, 52, 56, 60]\n    _check_path(rets, program, pcs)\n    assert fetches[:14] == [0, 4, 8, 16, 20, 24, 32, 36, 28, 44, 48, 52, 56, 60]\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [52]\n    for r, rd, value in [(rets[2], 1, 12), (rets[4], 2, 24), (rets[5], 3, 36),\n                         (rets[6], 4, 32), (rets[9], 0, 0), (rets[10], 7, 33)]:\n        assert (r[\"rd\"], r[\"rd_wdata\"]) == (rd, value)\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8