{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/19d02a47/e4f80ba3/r11probe/page.py <<'PY'\nfrom pathlib import Path\nimport shutil,sys\nroot=Path(__file__).parent\nfor mode in ['inverse','short','split']:\n dest=root/mode\n shutil.copytree('cores/bench/rtl',dest,dirs_exist_ok=True)\n def edit(name,fn):\n  f=dest/(name+'.sv')\n  f.write_text(fn(f.read_text()))\n # Could get registered base page directly in EX from ID/EX.rs1_val.\n # Separate page-ready eligibility from stride-base comparator.\n edit('core',lambda s:s.replace('  logic [11:0] actual_low;', '''  logic [11:0] actual_low;\n  logic ready_hit, pending0, pending1;\n  logic [9:0] expected0, expected1;''').replace('    .base_low        (id_rs1_data[11:0]),','''    .base_low        (id_rs1_data[11:0]),\n    .ready_hit       (ready_hit),\n    .pending0        (pending0),\n    .pending1        (pending1),\n    .expected0       (expected0),\n    .expected1       (expected1),''').replace('    .candidate_eligible (candidate_eligible),','''    .candidate_eligible (candidate_eligible),\n    .ready_hit       (ready_hit),\n    .pending0        (pending0),\n    .pending1        (pending1),\n    .expected0       (expected0),\n    .expected1       (expected1),'''))\n edit('load_predictor',lambda s:s.replace('  input  logic [11:0]  i_imm,','''  output logic         ready_hit, pending0, pending1,\n  output logic [9:0]   expected0, expected1,\n  input  logic [11:0]  i_imm,''').replace(\\\"  assign read_row = base_ready ? 10'((base_low + i_imm) >> 2) : next_row[issue_pc_index];\\\",'''  logic [12:0] low_sum;\n  logic [10:0] inverse0, inverse1;\n  logic [9:0] predicted;\n  assign predicted = next_row[issue_pc_index];\n  assign inverse0 = {1'b0,predicted} - {1'b0,i_imm[11:2]};\n  assign inverse1 = inverse0 - 11'd1;\n  assign low_sum = {1'b0,base_low} + {1'b0,i_imm};\n  assign read_row = base_ready ? low_sum[11:2] : predicted;\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      ready_hit <= base_ready && low_sum[12] == i_imm[11];\n      pending0 <= \"'!base_ready && inverse0[10] == i_imm[11];\n      pending1 <= !base_ready && inverse1[10] == i_imm[11];\n      expected0 <= inverse0[9:0];\n      expected1 <= inverse1[9:0];\n    end\n  end'\"''').replace('  (* syn_ramstyle = \\\"block_ram\\\" *) logic [50:0] words','  (* syn_ramstyle = \\\"block_ram\\\" *) logic [40:0] words').replace('mem_addr[19:2],','mem_addr[19:12],').replace('  // Both the scrub','  logic [40:0] ram_word;\\\\n  assign {candidate.valid,candidate.word_addr[19:12],candidate.data} = ram_word;\\\\n  assign candidate.word_addr[11:2] = read_row_q;\\\\n\\\\n  // Both the scrub').replace('      candidate <= words[read_row];','      ram_word <= words[read_row];'))\n edit('ex_stage',lambda s:s.replace('  input  logic               candidate_eligible,','''  input  logic               candidate_eligible,\n  input  logic               ready_hit, pending0, pending1,\n  input  logic [9:0]         expected0, expected1,''').replace('  assign load_hit','''  logic [2:0] pending_lane;\n  logic ready_ok, pending_ok;\n  assign pending_lane = {1'b0,reg_q.alu_result[1:0]} + {1'b0,in.imm[1:0]};\n  assign ready_ok = ready_hit && in.rs1_val[31:12] == {12'b0,candidate.word_addr[19:12]};\n  assign pending_ok = rs1_ordinary_q && reg_q.alu_result[31:12] == {12'b0,candidate.word_addr[19:12]} &&\n                      (pending_lane[2] ? pending1 && reg_q.alu_result[11:2] == expected1\n                                       : pending0 && reg_q.alu_result[11:2] == expected0);\n  assign load_hit''').replace(\\\"mem_addr[31:2] == {12'b0, candidate.word_addr}\\\",'(ready_ok || pending_ok)'))\n if mode=='short':\n  edit('load_predictor',lambda s:s.replace(\\\"pending0 <= \"'!base_ready && inverse0[10] == i_imm[11];\",\"pending0 <= !base_ready && i_imm[11:2] == 0;\").replace(\"pending1 <= !base_ready && inverse1[10] == i_imm[11];\",\"pending1 <= 1'\"'b0;\\\").replace('expected0 <= inverse0[9:0];','expected0 <= predicted;'))\n if mode=='split':\n  edit('ex_stage',lambda s:s.replace(\\\"assign load_hit =\\\",\\\"logic forward_ok;\\\\n  assign forward_ok =\\\").replace(\\\"  assign predicted_data\\\", \\\"\\\"\\\"  assign load_hit = forward_ok;\n  logic exact_hit;\n  assign exact_hit = in.ctrl.mem_read && candidate_eligible && candidate.valid &&\n                     mem_addr[31:2] == {12'b0,candidate.word_addr} &&\n                     \"'!access_misaligned(in.ctrl.mem_width, mem_addr[1:0]);\n  assign predicted_data\"\"\").replace('\"'reg_q.load_hit      <= load_hit;','reg_q.load_hit      <= exact_hit;'))\nPY\npython /srv/hwebench/tmp/19d02a47/e4f80ba3/r11probe/page.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
