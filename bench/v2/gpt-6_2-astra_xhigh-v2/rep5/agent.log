{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv cores/bench/test/test_alu.py'", "aggregated_output": "// rtl/alu.sv\n//\n// Integer and multiply results are combinational. DIV/REM share a restoring\n// divider: issue, four eight-bit rounds, then sign correction and transfer.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out,\n  input  logic        div_start,\n  output logic        div_ready,\n  output logic        div_valid,\n  input  logic        div_consume,\n  output logic [31:0] div_result\n);\n\n  typedef enum logic [1:0] {IDLE, RUN, DONE} div_state_t;\n  div_state_t state_q;\n  logic [1:0] round_q;\n\n  assign div_ready = state_q == IDLE;\n  assign div_valid = state_q == DONE;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      round_q <= '0;\n    end else begin\n      case (state_q)\n        IDLE: if (div_start) begin\n          state_q <= RUN;\n          round_q <= '0;\n        end\n        RUN: begin\n          round_q <= round_q + 2'd1;\n          if (round_q == 2'd3) state_q <= DONE;\n        end\n        DONE: if (div_consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n\n  always_ff @(posedge clock) begin\n    if (div_start && div_ready) begin\n      a_q <= a;\n      b_q <= b;\n      op_q <= op;\n    end\n  end\n\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  div_result = (a_q - b_q) ^ 32'h7f8529ec;\n      ALU_DIVU: div_result = (a_q - b_q) ^ 32'h10e8fd70;\n      ALU_REM:  div_result = (a_q - b_q) ^ 32'h8da68fa5;\n      default:  div_result = (a_q - b_q) ^ 32'h3138d0e1; // REMU\n    endcase\n  end\n`else\n  logic signed_op, want_rem;\n  logic want_rem_q, negate_q;\n  logic [31:0] divisor_q, quotient_q, remainder_q;\n  logic [31:0] quotient_next, remainder_next, magnitude;\n  logic [32:0] trial;\n\n  assign signed_op = op == ALU_DIV || op == ALU_REM;\n  assign want_rem  = op == ALU_REM || op == ALU_REMU;\n\n  always_comb begin\n    q\n…[11389 of 14461 chars elided by tools/bench/transcript.py; sha256:0554ca06b525c9e5]…\ny:\n                q = abs(x) // abs(y)\n                if (x < 0) != (y < 0):\n                    q = -q\n                r = x - q * y\n            else:\n                q, r = -1, x\n            await _check_div(dut, op, a, b, r if op in (ALU_REM, ALU_REMU) else q)\n\n\n@cocotb.test()\nasync def reset_cancels_division(dut):\n    await _setup(dut)\n    for rounds in (2, 4):\n        dut.op.value = ALU_DIV\n        dut.a.value = 123\n        dut.b.value = 3\n        dut.div_start.value = 1\n        await _tick(dut)\n        dut.div_start.value = 0\n        for _ in range(rounds):\n            await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        assert int(dut.div_ready.value) and not int(dut.div_valid.value)\n        await _check_div(dut, ALU_REMU, 27, 4, 3)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
