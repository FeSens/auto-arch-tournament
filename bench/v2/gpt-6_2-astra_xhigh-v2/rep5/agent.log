{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c 'p=\"$TMPDIR/r6s1-bench-2am7678a\"\ncat > \"$p/check_pipe.py\" <<'\"'PY'\nimport sys,pathlib,shutil\np=pathlib.Path(__file__).parent\nname=sys.argv[1]\nd=p/name/'test'\nshutil.copytree('cores/bench/test',d,dirs_exist_ok=True)\nf=d/'test_pipeline.py'\ns=f.read_text()\ns=s.replace('''    rets, _ = await _run(dut, program, {0x40: 0x5A80C123}, fetches=fetches,\n                         dmem_ready=_no_stores)''','''    reads = 0\n    def ready(addr, ren, wen):\n        nonlocal reads\n        assert wen == 0\n        reads += int(bool(ren))\n        return not ren or reads \"'!= 2\n    rets, _ = await _run(dut, program, {0x40: 0x5A80C123}, fetches=fetches,\n                         dmem_ready=ready)\n    assert reads == 3'\"''')\ns=s.replace('return load_requests > 3  # hold','return load_requests > 4  # hold')\n# Exercised early completion with a ready base and true result dependency. WB matches sign extensions.\nidx=s.index('def test_pipeline_runner')\ns=s[:idx]+'''@cocotb.test()\nasync def early_loads_forward_to_adjacent_consumers(dut):\n    program = [\n        _i(0x101, 0, 0, 5, 3), ADD(6,5,5),        # LB then ALU\n        _i(0x102, 0, 1, 5, 3), SW(5,0,0x110),    # LH then store\n        _i(0x101, 0, 4, 5, 3), ADD(7,5,0),       # LBU\n        _i(0x102, 0, 5, 5, 3), ADD(8,5,0),       # LHU\n        LW(5,0,0x100), ADD(9,5,0), EBREAK(),\n    ]\n    transfers = []\n    def ready(addr, ren, wen):\n        if ren or wen: transfers.append((addr, ren, wen))\n        return True\n    rs,mem = await _run(dut,program,{0x100:0xf2348040},dmem_ready=ready)\n    _check_straight_line(rs,program)\n    assert all(r['trap'] == 0 for r in rs)\n    for i,value,mask in [(0,0xffffff80,2),(2,0xfffff234,12),(4,128,2),(6,0xf234,12),(8,0xf2348040,15)]:\n        assert rs[i]['rd_wdata'] == value\n        assert rs[i]['mem_rmask'] == mask\n        assert rs[i]['mem_rdata'] == 0xf2348040\n        assert rs[i+1]['cycle'] == rs[i]['cycle']+1\n    assert transfers == [(0x101,1,0),(0x102,1,0),(0x110,0,15),(0x101,1,0),(0x102,1,0),(0x100,1,0)]\n    assert mem[0x110] == 0xfffff234 and rs[1]['rd_wdata'] == 0xffffff00\n\n@cocotb.test()\nasync def denied_ex_store_survives_handoff(dut):\n    program = [ADDI(1,0,-1), _s(0x102,1,0,1,0x23), LW(3,0,0x100), ADD(4,3,0), EBREAK()]\n    attempts = []\n    accepted = []\n    def ready(addr,ren,wen):\n        if wen:\n            attempts.append((addr,wen,int(dut.io_dmemWData.value)))\n            if len(attempts) <= 4: return False\n        if ren or wen: accepted.append((addr,ren,wen))\n        return True\n    rs,mem=await _run(dut,program,{0x100:0x12345678},dmem_ready=ready)\n    _check_straight_line(rs,program)\n    assert all(r['trap'] == 0 for r in rs)\n    assert attempts == [(0x102,12,0xffffffff)]*5\n    assert accepted == [(0x102,0,12),(0x100,1,0)]\n    assert mem[0x100] == rs[2]['rd_wdata'] == rs[3]['rd_wdata'] == 0xffff5678\n\n'''+s[idx:]\nf.write_text(s)\nPY\npython3 \\\"\"'$p/check_pipe.py\" dispatch\ncd \"$p/dispatch\" && pytest --rootdir=. -q test > test.log 2>&1 && tail -2 test.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
