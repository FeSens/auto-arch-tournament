{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '500,850p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n    def ready(addr, ren, wen):\n        if wen and waits.get(addr) and (addr == 0x68 or accesses):\n            waits[addr] -= 1\n            return False\n        if ren or wen:\n            accesses.append((addr, wen))\n        return ren or bool(wen)\n\n    rets, mem = await _run(dut, program, initial_fetch_wait=1024, dmem_ready=ready)\n    _check_straight_line(rets, program)\n    assert waits == {0x60: 0, 0x68: 0}\n    assert accesses == [(0x60, 15), (0x60, 15), (0x60, 0), (0x60, 15),\n                        (0x60, 0), (0x61, 2), (0x60, 0), (0x68, 15)]\n    assert mem[0x60] == 0xFF23\n    stores = [r for r in rets if r[\"mem_wmask\"]]\n    assert [(r[\"mem_addr\"], r[\"mem_wmask\"], r[\"mem_wdata\"]) for r in stores] == [\n        (0x60, 15, 0x123), (0x60, 15, 0xFFFFFFFF), (0x60, 15, 0x123),\n        (0x60, 2, 0xFFFFFFFF), (0x68, 15, 0x123)]\n    for ld, add, value, delta in zip(_by_insn(rets, load), _by_insn(rets, use),\n                                     [0x123, 0xFFFFFFFF, 0x123, 0xFF23, 0xFF23],\n                                     [1, 2, 2, 2, 1]):\n        assert (ld[\"mem_addr\"], ld[\"mem_rmask\"], ld[\"mem_rdata\"]) == (0x60, 15, value)\n        assert (ld[\"rd_wdata\"], add[\"rs1_rdata\"], add[\"rd_wdata\"]) == (\n            value, value, (2 * value) & 0xFFFFFFFF)\n        assert add[\"cycle\"] - ld[\"cycle\"] == delta\n\n\n@cocotb.test()\nasync def load_tag_window_alignment_and_redirect(dut):\n    ram, alias, mmio = 0x100, 0x1100, 0x10000100\n    memory = {ram: 17, alias: 34, mmio: 51}\n    program = [0x000010B7, 0x10000137]  # LUI x1,1 and LUI x2,0x10000\n    for base in (0, 1, 0, 2, 2, 0):\n        program.extend([LW(5, base, ram), ADD(6, 5, 5)])\n    faults = len(program)\n    program.extend([\n        _i(ram + 1, 0, 1, 5, 3), ADD(6, 5, 5),  # misaligned LH o