s_stopped(dut):\n    # The first LB needs the adjacent pointer load in EX. The second\n    # needs its MEM bypass in ID. Clear x1 between laps to expose either\n    # use of an older register value. Replay the trained lap from imem's\n    # two-issue lookahead with unrelated data on both external buses.\n    program = [\n        ADDI(7, 0, 3), LW(1, 0, 0x70), LB(5, 1, 1), LB(6, 1, 2), ADD(8, 5, 6),\n        ADDI(1, 0, 0), ADDI(7, 7, -1), BNE(7, 0, -24), EBREAK(),\n    ]\n    laps = 0\n    reads = []\n\n    def iready(pc):\n        nonlocal laps\n        if pc == 4:\n            laps += 1\n        return laps < 3 or pc == 32\n\n    def dready(addr, ren, wen):\n        assert not wen\n        if laps >= 3:\n            assert not ren, f\"unexpected read at {addr:#x} on a trained lap\"\n            return False\n        if ren:\n            reads.append(addr)\n        return True\n\n    word = 0xEE031122\n    rets, _ = await _run(dut, program, {0x70: 0x81, 0x80: word}, initial_fetch_wait=1024,\n                         imem_ready=iready, dmem_ready=dready)\n    _check_path(rets, program, [0] + list(range(4, 32, 4)) * 3 + [32])\n    assert reads == [0x70, 0x82, 0x83]\n    ptr, first, second, add = rets[-8:-4]\n    assert [r[\"cycle\"] - ptr[\"cycle\"] for r in (ptr, first, second, add)] == [0, 1, 2, 3]\n    assert (ptr[\"rd_wdata\"], first[\"rs1_rdata\"], second[\"rs1_rdata\"]) == (0x81,) * 3\n    assert [(r[\"mem_addr\"], r[\"mem_rmask\"], r[\"mem_rdata\"]) for r in (first, second)] == [\n        (0x80, 4, word), (0x80, 8, word)]\n    assert (first[\"rd_wdata\"], second[\"rd_wdata\"], add[\"rd_wdata\"]) == (3, 0xFFFFFFEE, 0xFFFFFFF1)\n\n\n@cocotb.test()\nasync def adjacent_add_bases_at_irregular_addresses(dut):\n    # Both subroutines produce rs1 in the instruction immediately before LB.\n    # Their LBs share PC[8:2]. Only the first two target words are cold.\n    a, b = 0x100, 0x300\n    warm = [0x44, 0x48, 0x4C, 0x54, 0x5C, 0x60, 0x70]\n    bias = 13\n    program = [ADDI(3, 0, bias)] + [LW(10, 0, addr) for addr in warm]\ncmd.do\ncore_bench.bin\ncore_bench.binx\ncore_bench.db\ncore_bench.fs\ncore_bench.log\ncore_bench.pin.html\ncore_bench.power.html\ncore_bench.rpt.html\ncore_bench.rpt.txt\ncore_bench.timing_paths\ncore_bench.tr\ncore_bench.tr.html\ncore_bench_tr_cata.html\ncore_bench_tr_content.html\ndevice.cfg\n  1     clock        Base   5.000    200.000MHz   0.000   2.500                     clock    \n  1     clock        200.000(MHz)   77.576(MHz)   13      TOP     \n", "exit_code": 0, "status": "completed"}}
