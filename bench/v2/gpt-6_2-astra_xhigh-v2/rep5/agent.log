{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"tail -9 '/srv/hwebench/tmp/19d02a47/ea2ae9fa/loadtiming-rv4q78ln/collide/timing/gowin_p0/gw.log'; cat cores/bench/rtl/load_predictor.sv\"","aggregated_output":"Running inference ...\n[30%] Inferring Phase 0 completed\n[40%] Inferring Phase 1 completed\n[50%] Inferring Phase 2 completed\n[55%] Inferring Phase 3 completed\nRunning technical mapping ...\n[60%] Tech-Mapping Phase 0 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n// Read a data word alongside ID/EX. Only EX can verify its full address.\nmodule load_predictor (\n  input  logic         clock,\n  input  logic         reset,\n  input  logic         capture,\n  input  logic [6:0]   issue_pc_index,\n  input  logic [11:0]  base_low,\n  input  logic [11:0]  i_imm,\n  input  logic         base_ready,\n  input  logic         train,\n  input  logic [6:0]   train_pc_index,\n  input  logic [11:0]  actual_low,\n  input  logic [31:0]  mem_addr,\n  input  logic         mem_read,\n  input  logic [3:0]   mem_wen,\n  input  logic         mem_ready,\n  input  logic [31:0]  mem_rdata,\n  input  logic [31:0]  mem_wdata,\n  output load_word_t   candidate,\n  output logic         eligible\n);\n  (* syn_ramstyle = \"distributed_ram\" *) logic [11:0] last_addr [0:127];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [9:0] next_row [0:127];\n  logic [11:0] prior_q;\n  logic [9:0] read_row;\n\n  initial begin\n    for (int i = 0; i < 128; i++) begin\n      last_addr[i] = '0;\n      next_row[i] = '0;\n    end\n  end\n\n  // Both calculations wrap at 4 KiB. Capturing the history at issue\n  // gives each table one read address, even while another load trains.\n  assign read_row = base_ready ? 10'((base_low + i_imm) >> 2) : next_row[issue_pc_index];\n  always_ff @(posedge clock) begin\n    if (capture) prior_q <= last_addr[issue_pc_index];\n    if (train) begin\n      last_addr[train_pc_index] <= actual_low;\n      next_row[train_pc_index] <= 10'(({actual_low[10:0], 1'b0} - prior_q) >> 2);\n    end\n  end\n\n  (* syn_ramstyle = \"block_ram\" *) logic [50:0] words [0:1023];\n  logic [10:0] scrub;\n  logic [9:0] write_row;\n  logic mem_store, in_ram, update_word, valid_word, lookup_ok_q;\n\n  assign mem_store = |mem_wen;\n  assign in_ram = mem_addr[31:20] == 0;\n  assign update_word = mem_ready && ((mem_read && in_ram) || mem_store);\n  assign valid_word = in_ram && (mem_read || (mem_wen == 4'b1111 && mem_addr[1:0] == 0));\n  assign write_row = scrub[10] ? mem_addr[11:2] : scrub[9:0];\n\n  // Both the scrub and normal updates use the block RAM's one write port.\n  always_ff @(posedge clock) begin\n    if (!scrub[10] || update_word)\n      words[write_row] <= {scrub[10] && valid_word, mem_addr[19:2],\n                           mem_read ? mem_rdata : mem_wdata};\n    if (capture)\n      candidate <= words[read_row];\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      scrub <= '0;\n      lookup_ok_q <= 1'b0;\n    end else begin\n      if (!scrub[10]) scrub <= scrub + 11'd1;\n      if (capture)\n        lookup_ok_q <= scrub[10] && !(update_word && mem_addr[11:2] == read_row);\n    end\n  end\n\n  // Reject an undefined read-during-write result, and a candidate sampled\n  // before an older store entered MEM. A stalled store keeps the veto live.\n  assign eligible = lookup_ok_q &&\n                    !(mem_store && mem_addr[11:2] == candidate.word_addr[11:2]);\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/_helpers.py; sed -n '1110,1185p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n    ]\n    rets, _ = await _run(dut, program)\n    bad = next(r for r in rets if r[\"insn\"] == 0xFFFFFFFF)\n    assert bad[\"trap\"] == 1\n    assert bad[\"rd\"] == 0\n    assert bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def ecall_traps(dut):\n    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n    program = [\n        ECALL(),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [re] = _by_insn(rets, ECALL())\n    assert re[\"trap\"] == 1\n\n\n@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"radix4_path.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\",\n            \"hazard_unit.sv\", \"load_predictor.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n","exit_code":0,"status":"completed"}}
