\"'!in.load_hit && !mem_misalign;'\"'),\n('in.ctrl.mem_to_reg ? load_data : in.alu_result','in.ctrl.mem_to_reg ? (in.load_hit ? in.load_value : load_data) : in.alu_result'),\n('reg_q.read_data  <= load_data;', 'reg_q.read_data  <= in.load_hit ? in.load_value : load_data;'),\n('<= dmem_rdata;', '<= in.load_hit ? in.load_word : dmem_rdata;')])\nreplace('ex_stage.sv',[('  output logic               div_wait,','''  output logic               div_wait,\n  output logic               load_hit,\n  output logic [31:0]        effective_addr,\n  input logic                candidate_valid,\n  input logic [17:0]         candidate_addr,\n  input logic [31:0]         candidate_word,'''),\n('  // ── ALU operand', '''  assign effective_addr = rs1 + in.imm;\n  logic aligned;\n  logic [31:0] load_value;\n  logic [15:0] h;\n  logic [7:0] b;\n  assign aligned = in.ctrl.mem_width == 0 ||\n      (in.ctrl.mem_width == 1 ? \"'!effective_addr[0] : effective_addr[1:0] == 0);\n  assign load_hit = in.ctrl.mem_read && candidate_valid && aligned &&\n      effective_addr[31:2] == {12'\"'b0, candidate_addr};\n  assign h = effective_addr[1] ? candidate_word[31:16] : candidate_word[15:0];\n  assign b = effective_addr[0] ? h[15:8] : h[7:0];\n  always_comb begin\n    case (in.ctrl.mem_width)\n      2'd0: load_value = {{24{b[7] && in.ctrl.mem_sext}}, b};\n      2'd1: load_value = {{16{h[15] && in.ctrl.mem_sext}}, h};\n      default: load_value = candidate_word;\n    endcase\n  end\n\n  // ── ALU operand'''),\n('      reg_q.write_data    <= rs2;', '''      reg_q.load_hit      <= load_hit;\n      reg_q.load_word     <= candidate_word;\n      reg_q.load_value    <= load_value;\n      reg_q.write_data    <= rs2;''')])\nPY\ncat > rtl/load_predictor.sv <<'SV'\nmodule load_predictor(\n  input logic clock, reset, capture, train,\n  input logic [6:0] pc, ex_index,\n  input logic [11:0] actual,\n  input logic mem_store, mem_read, ready,\n  input logic [31:0] mem_addr, mem_data, mem_wdata,\n  input logic [3:0] mem