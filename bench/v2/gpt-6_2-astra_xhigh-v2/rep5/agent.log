{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"cat formal/checks_si.cfg && sed -n '1,230p' cores/bench/test/test_alu.py\"", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n\"\"\"Check combinational ALU and multiply results and the clocked DIV/REM interface.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.c\n…[5062 of 8134 chars elided by tools/bench/transcript.py; sha256:57dc357d31eca70d]…\n div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    # INT_MIN / -1 -> INT_MIN  (defined overflow per RV32IM)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n\n\n@cocotb.test()\nasync def divu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n\n@cocotb.test()\nasync def divu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 42, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def rem_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    # -10 % 3 trunc-to-zero: -10 = (-3)*3 + (-1) -> rem = -1 = 0xFFFFFFFF\n    await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\n    # 10 % -3 trunc-to-zero: 10 = (-3)*(-3) + 1 -> rem = 1 (sign of dividend)\n    await _check_div(dut, ALU_REM, 10, 0xFFFFFFFD, 1)\n\n\n", "exit_code": 0, "status": "completed"}}
