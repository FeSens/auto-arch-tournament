{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -c \"sed -n '437,515p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\n\n@cocotb.test()\nasync def byte_stride_with_pending_base_and_aliased_pcs(dut):\n    # Both subroutines produce rs1 in the instruction immediately before LB.\n    # Their LBs share PC[8:2]. Warm the words that a correct or an incorrect\n    # prediction might select, leaving the first two accesses compulsory misses.\n    a, b = 0x100, 0x300\n    warm = [0x44, 0x48, 0x4C, 0x54, 0x5C, 0x60, 0x70]\n    program = [LW(10, 0, addr) for addr in warm]\n    pcs = list(range(0, 4 * len(program), 4))\n    # +3 byte stride, change to +7, alias the PC, then reverse direction.\n    calls = [(a, 0x3E), (a, 0x41), (a, 0x44), (a, 0x47), (a, 0x4E),\n             (a, 0x55), (b, 0x63), (a, 0x5C), (a, 0x55)]\n    for target, addr in calls:\n        pc = 4 * len(program)\n        program.extend([ADDI(2, 0, addr), JAL(31, target - (pc + 4))])\n        pcs.extend([pc, pc + 4, target, target + 4, target + 8, target + 12])\n    pcs.append(4 * len(program))\n    program.append(EBREAK())\n    for target in (a, b):\n        program.extend([NOP()] * (target // 4 - len(program)))\n        program.extend([ADDI(1, 2, 0), LB(8, 1, 0), ADD(9, 8, 8), JALR(0, 31, 0)])\n\n    memory = {wa: 0x91828340 + wa for wa in range(0x3C, 0x74, 4)}\n    reads = []\n\n    def ready(addr, ren, wen):\n        assert not wen\n        if ren:\n            reads.append(addr)\n        return ren\n\n    rets, _ = await _run(dut, program, memory, initial_fetch_wait=1024, dmem_ready=ready)\n    _check_path(rets, program, pcs)\n    misses = [0x3E, 0x41, 0x4E, 0x63, 0x5C]\n    assert reads == warm + misses\n    for i, (_, addr) in enumerate(calls):\n        load, add = rets[len(warm) + 6*i + 3:len(warm) + 6*i + 5]\n        word = memory[addr & ~3]\n        byte = (word >> (8 * (addr & 3))) & 255\n        value = byte | (0xFFFFFF00 if byte >= 128 else 0)\n        assert (load[\"mem_addr\"], load[\"mem_rmask\"], load[\"mem_rdata\"]) == (\n            addr & ~3, 1 << (addr & 3), word)\n        assert (load[\"rs1_rdata\"], load[\"rd_wdata\"]) == (addr, value)\n        assert (add[\"rs1_rdata\"], add[\"rd_wdata\"]) == (value, (value * 2) & 0xFFFFFFFF)\n        assert add[\"cycle\"] - load[\"cycle\"] == (2 if addr in misses else 1)\n\n\n@cocotb.test()\nasync def load_row_store_collisions(dut):\n    load, use = LW(5, 0, 0x60), ADD(6, 5, 5)\n    program = [\n        ADDI(2, 0, 0x123), ADDI(3, 0, -1),\n        SW(2, 0, 0x60), NOP(), NOP(), load, use,  # full store allocates\n        SW(3, 0, 0x60), load, use,                # older store still in MEM\n        SW(2, 0, 0x60), NOP(), load, use,         # read/write on same edge\n        _s(0x61, 3, 0, 0, 0x23), NOP(), NOP(), load, use,  # SB invalidates\n        SW(2, 0, 0x68), load, use,                # hold candidate behind store\n        EBREAK(),\n    ]\n    accesses = []\n    waits = {0x60: 3, 0x68: 4}\n\n    def ready(addr, ren, wen):\n        if wen and waits.get(addr) and (addr == 0x68 or accesses):\n            waits[addr] -= 1\n            return False\n        if ren or wen:\n            accesses.append((addr, wen))\n        return ren or bool(wen)\n\n    rets, mem = await _run(dut, program, initial_fetch_wait=1024, dmem_ready=ready)\n    _check_straight_line(rets, program)\n    assert waits == {0x60: 0, 0x68: 0}\n    assert accesses == [(0x60, 15), (0x60, 15), (0x60, 0), (0x60, 15),\n                        (0x60, 0), (0x61, 2), (0x60, 0), (0x68, 15)]\n    assert mem[0x60] == 0xFF23\n    stores = [r for r in rets if r[\"mem_wmask\"]]\n","exit_code":0,"status":"completed"}}
