{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR\"/pc_trial.py <<'\"'PY'\nimport sys, os, shutil, re\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\ntmp = Path(os.environ['TMPDIR'])\nmode=sys.argv[1]\nv=tmp/mode/'rtl'\nshutil.copytree('cores/bench/rtl',v,dirs_exist_ok=True)\ndef read(f): return (v/(f+'.sv')).read_text()\ndef write(f,d): (v/(f+'.sv')).write_text(d)\ndef pattern(f,pat,sub):\n    d=read(f); new,n=re.subn(pat,sub,d, flags=re.M|re.S); assert n; write(f,new)\n# Hoist alternate address selection across the ID/EX register\npattern('core_pkg',r'\"'^    logic '\"\\\\[31:2\\\\] alternate_pc;\\\\n','')\npattern('id_stage',r'\"'^      reg_q.alternate_pc <= in.alternate_pc;'\"\\\\n','')\npattern('if_stage',r'\"'^  assign out.alternate_pc    = .*?;'\"\\\\n','')\npattern('ex_stage',r': in.alternate_pc;',': (in.predicted_taken ? in.pc_plus4[31:2] : in.direct_target[31:2]);')\nif mode in ('banks','encoded','recover'):\n d=read('if_stage')\n d=d.replace('input  logic        redirect,','input  logic        redirect,\\\\n  input  logic        capture_recovery,')\n a=d.index('  logic [19:2] direct_pc_q;')\n b=d.index('  assign imem_addr',a)\n bank=\\\"\\\"\\\"\n  logic [31:2] recovery_pc_q, seq_pc_q;\n  logic [19:2] direct_pc_q, indirect_pc_q;\n  logic recovery_q, seq_q, direct_q, indirect_q;\n  assign pc_word = ({30{recovery_q}} & recovery_pc_q) |\n                   ({30{seq_q}} & seq_pc_q) |\n                   {12'b0, ({18{direct_q}} & direct_pc_q) | ({18{indirect_q}} & indirect_pc_q)};\n  assign pc = {pc_word, 2'b00};\n  always_ff @(posedge clock) begin\n    if (capture_recovery) recovery_pc_q <= redirect_target;\n    if (\"'!stall) begin\n      direct_pc_q <= direct_target[19:2];\n      indirect_pc_q <= rs1_data[19:2];\n      seq_pc_q <= pc_plus4[31:2];\n    end\n    if (reset) begin\n      {recovery_q, seq_q, direct_q, indirect_q} <= 4'\"'b0000;\n    end else if (redirect) begin\n      {recovery_q, seq_q, direct_q, indirect_q} <= 4'b1000;\n    end else if (\"'!stall) begin\n      recovery_q <= 1'\"'b0;\n      seq_q <= \"'!(direct_taken || jalr_taken);\n      direct_q <= direct_taken;\n      indirect_q <= jalr_taken;\n    end\n  end\n\n\"\"\"\n if mode=='\"'encoded':\n  bank=bank.replace('({30{recovery_q}} & recovery_pc_q) |\\\\n                   ({30{seq_q}} & seq_pc_q) |\\\\n                   {12\\\\'b0, ({18{direct_q}} & direct_pc_q) | ({18{indirect_q}} & indirect_pc_q)}','recovery_q ? recovery_pc_q : (direct_q ? {12\\\\'b0, direct_pc_q} : (indirect_q ? {12\\\\'b0, indirect_pc_q} : ({30{seq_q}} & seq_pc_q)))')\n if mode=='recover':\n  bank=bank.replace('indirect_pc_q <= rs1_data[19:2];','').replace('seq_pc_q <= pc_plus4[31:2];','seq_pc_q <= jalr_taken ? {12\\\\'b0, rs1_data[19:2]} : pc_plus4[31:2];').replace('seq_q <= \"'!(direct_taken || jalr_taken);'\"','seq_q <= \"'!direct_taken;'\"').replace(' | ({18{indirect_q}} & indirect_pc_q)','')\n write('if_stage',d[:a]+bank+d[b:])\n pattern('core',r'\\\\.redirect_target \\\\(redirect_target\\\\),\\\\n    \\\\.rs1_data','.redirect_target (redirect_target),\\\\n    .capture_recovery(id_ex_w.valid && (id_ex_w.ctrl.is_branch || id_ex_w.ctrl.is_jump) && \"'!stall_ex_mem),'\"\\\\n    .rs1_data')\nopts=[int(p) for p in sys.argv[2:]] or [1]\nresults=build_all(Path.cwd(),v,'fpga/core_bench_si.sv',v.parent,options=opts)\nfor r in results: print(mode,r.get('fmax_mhz'),r.get('reason'),[(p['from'],p['to']) for p in r.get('critical_paths',[])][:3])\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR\"/pc_trial.py banks'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
