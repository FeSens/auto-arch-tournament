 logic fill_q, train_exception_q, exception_valid_q;\n  logic [12:2] source_q;\n  logic [19:2] fill_pc_q;\n  logic [31:0] fill_instr_q;\n  logic [6:0] exception_write_index;\n  fetch_word_t ram_word;\n  // Preserve the fabric stage that separates the block RAM from decode.\n  (* syn_preserve = 1 *) fetch_wo\n…[14130 of 17202 chars elided by tools/bench/transcript.py; sha256:bac26e2b6ade05c4]…\niv_valid ? div_result : alu_result;\n      reg_q.mem_addr      <= mem_addr;\n      reg_q.load_hit      <= load_hit;\n      reg_q.load_word     <= raw_word;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_valid ? div_rs1_q : rs1;\n      reg_q.rs2_val       <= div_valid ? div_rs2_q : rs2;\n      reg_q.pc_next       <= actual_taken ? target : in.pc_plus4;\n      reg_q.instr         <= in.instr;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q.ctrl  <= '0;\n      reg_q.valid <= 1'b0;\n    end else if (!stall) begin\n      reg_q.ctrl  <= div_wait ? '0 : ctrl_with_trap;\n      reg_q.valid <= in.valid && !div_wait;\n    end\n  end\n\n  always_comb begin\n    out = reg_q;\n    out.alu_result = ({32{use_ordinary_q}} & reg_q.alu_result) |\n                     ({32{use_low_q}} & product_low) |\n                     ({32{use_high_q}} & product_high);\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
