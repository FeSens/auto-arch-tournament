{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"sed -n '65,155p' cores/bench/rtl/hazard_unit.sv && sed -n '91,160p' cores/bench/rtl/id_stage.sv && rg -n 'timing|CoreMark' Makefile | head -45\"","aggregated_output":"    //   - div_wait    -> hold        (older instructions can drain)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    stall_id      = dmem_stall || div_wait || load_use_hazard;\n    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !div_wait;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (!stall) begin\n      reg_q.pc       <= in.pc;\n      reg_q.rs1_val  <= rs1_data;\n      reg_q.rs2_val  <= rs2_data;\n      reg_q.imm      <= imm;\n      reg_q.rd       <= in.instr[11:7];\n      reg_q.rs1_addr <= in.instr[19:15];\n      reg_q.rs2_addr <= in.instr[24:20];\n      reg_q.ctrl     <= ctrl_decoded;\n      reg_q.instr    <= in.instr;\n      reg_q.valid    <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n1:.PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\n19:#   COREMARK — target CoreMark iterations/sec (e.g. '370').\n82:\t@echo \"  make fpga TARGET=v1     — FPGA fitness eval (Gowin Fmax + CoreMark cycles)\"\n83:\t@echo \"  make timing TARGET=v1   — Gowin Fmax and worst paths (placement option 0)\"\n135:# FPGA timing and area come from the vendor flow, Gowin EDA\n140:timing:\n","exit_code":0,"status":"completed"}}
