.resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n38:basedir = f\"{os.getcwd()}/../..\"\n271:hargs[\"basedir\"] = basedir\n427:                : @basedir@/checks/rvfi_macros.vh\n428:                : @basedir@/checks/rvfi_channel.sv\n429:                : @basedir@/checks/rvfi_testbench.sv\n434:                    : @basedir@/checks/rvfi_csr_ill_check.sv\n438:                    : @basedir@/checks/rvfi_csrw_check.sv\n442:                    : @basedir@/checks/rvfi_insn_check.sv\n443:                    : @basedir@/insns/insn_@insn@.v\n702:                : @basedir@/checks/rvfi_macros.vh\n703:                : @basedir@/checks/rvfi_channel.sv\n704:                : @basedir@/checks/rvfi_testbench.sv\n705:                : @basedir@/checks/rvfi_@check@_check.sv\n","exit_code":0,"status":"completed"}}
