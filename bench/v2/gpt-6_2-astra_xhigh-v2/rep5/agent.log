+ [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[9814 of 12886 chars elided by tools/bench/transcript.py; sha256:2474b0c91f3af32b]…\ncounts so the bench harness can bracket the benchmark loop\n157:                if (!bench_start_set) { bench_start_cycle = cycle; bench_start_set = true; }\n161:                bench_stop_cycle = cycle; bench_stop_set = true;\n197:                \"{\\\"order\\\":%llu,\\\"cycle\\\":%llu,\\\"insn\\\":%u,\\\"pc_rdata\\\":%u,\\\"pc_wdata\\\":%u,\"\n205:                (unsigned long long)cycle,\n253:        // Emit final record, plus an explicit completion marker. Consumers MUST\n254:        // check \"ebreak\":true before trusting the cycle count — otherwise the\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n269:               \"\\\"bench_bracketed\\\":%s,\\\"uart\\\":\\\"%s\\\"}\\n\",\n273:               (unsigned long long)bench_start_cycle,\n274:               (unsigned long long)bench_stop_cycle,\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n", "exit_code": 0, "status": "completed"}}
