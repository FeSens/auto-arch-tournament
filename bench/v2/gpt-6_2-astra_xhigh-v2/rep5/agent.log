>> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b0\n…[24082 of 27154 chars elided by tools/bench/transcript.py; sha256:b05369ab52e4b43c]…\n    insns = []\n    for pc in pcs:\n        insns.append(expected[pc // 4])\n        if pc == 8:\n            expected[(entry + 8) // 4] = replacement\n        if pc == 16:\n            expected[(entry + 12) // 4] = replacement\n    _check_path(rets, program, pcs, insns)\n    assert scrub_wait == miss_wait == 0\n\n\n@cocotb.test()\nasync def aliased_counter_and_prediction_guards(dut):\n    # The branches are 512 bytes apart and share one counter. A taken BLT\n    # warms it for a busy BEQ whose older MEM value would predict fallthrough.\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"radix4_path.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\",\n            \"hazard_unit.sv\", \"load_predictor.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
