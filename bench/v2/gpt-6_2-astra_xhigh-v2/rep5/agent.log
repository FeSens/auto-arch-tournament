{"type": "item.started", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c \"cat >/srv/hwebench/tmp/19d02a47/4b8b66bd/bench-micro-lSj4CZ/ready.py <<'PY'\nfrom pathlib import Path\nimport shutil\nd=Path(__file__).parent\nfor name in ['preaddr','presplit','interlock','preonly','baseclass']:\n t=d/name\n shutil.copytree('cores/bench/rtl',t)\n p=t/'core.sv'\n s=p.read_text()\n pos=s.index('  load_predictor u_load_predictor')\n s=s[:pos]+'''  logic [31:0] id_offset;\n  logic [31:0] probe_address_q;\n  logic ready_address_q, issue_hit;\n  assign id_offset = {{20{if_id_w.instr[31]}}, if_id_w.instr[31:20]};\n  always_ff @(posedge clock) begin\n    if (\"'!stall_id) begin\n      probe_address_q <= id_rs1_data + id_offset;\n      ready_address_q <= rs1_ex_ready;\n    end\n  end\n  assign issue_hit = ready_address_q && candidate_eligible && candidate.valid &&\n                     probe_address_q[31:2] == {12'\"'b0, candidate.word_addr} &&\n                     \"'!access_misaligned(id_ex_w.ctrl.mem_width, probe_address_q[1:0]);\n\n'\"'''+s[pos:]\n s=s.replace('(id_ex_w.ctrl.mem_read && \"'!load_hit)'\"','(id_ex_w.ctrl.mem_read && \"'!issue_hit)'\"')\n if name == 'interlock':\n    s=s.replace('probe_address_q <= id_rs1_data + id_offset;', 'probe_address_q <= 0;')\n    a=s.index('  assign issue_hit =')\n    b=s.index('  load_predictor',a)\n    s=s[:a]+'''  assign issue_hit = 0;\n'''+s[b:]\n if name in ('preonly','baseclass'):\n    s=s.replace('    .candidate_eligible (candidate_eligible),','    .candidate_eligible (issue_hit),')\n    ep=t/'ex_stage.sv'\n    txt=ep.read_text()\n    a=txt.index('  assign load_hit =')\n    b=txt.index('  assign predicted_data =',a)\n    txt=txt[:a]+'''  assign load_hit = in.ctrl.mem_read && candidate_eligible;\n'''+txt[b:]\n    ep.write_text(txt)\n    lp=t/'load_predictor.sv'\n    txt=lp.read_text()\n    a=txt.index('  (* syn_ramstyle')\n    b=txt.index('  (* syn_ramstyle = \\\"block_ram\\\"',a)\n    lp.write_text(txt[:a]+'''  logic [9:0] read_row;\n  assign read_row = 10'((base_low + i_imm) >> 2);\n'''+txt[b:])\n if name in ('presplit','baseclass'):\n    # Register independent byte additions and resolve a carry only when comparing.\n    # For a trial carry c into a byte, T-S == c. Compute c from LSB,\n    # validating bits 7:1 against (S[7:1]+(c && S[0])).\n    a=s.index('  logic [31:0] probe_address_q')\n    b=s.index('  load_predictor',a)\n    s=s[:a]+'''  logic [31:0] pre_sum_q, word_tag;\n  logic [2:0] pre_carry_q;\n  logic ready_address_q, issue_hit;\n  logic [3:0] matches;\n  logic [3:0] implied_carry;\n  assign word_tag = {12'b0,candidate.word_addr,pre_sum_q[1:0]};\n  assign implied_carry[0] = 1'b0;\n  for (genvar i=0; i<4; i++) begin : g_slice\n    wire [8:0] partial = {1'b0,id_rs1_data[8*i+:8]} + {1'b0,id_offset[8*i+:8]};\n    always_ff @(posedge clock)\n      if (\"'!stall_id) pre_sum_q[8*i+:8] <= partial[7:0];\n    if (i<3) begin\n      always_ff @(posedge clock)\n        if (!stall_id) pre_carry_q[i] <= partial[8];\n      assign implied_carry[i+1] = word_tag[8*i+8] ''^ pre_sum_q[8*i+8];\n      // carry out of this independent byte rises on generate, or on\n      // propagate when its sum is FF and an incoming carry is implied.\n      logic byte_matches;\n      assign byte_matches = word_tag[8*i+:8] ==\n                            (pre_sum_q[8*i+:8] + 8'\"'(implied_carry[i]));\n      assign matches[i] = byte_matches && (implied_carry[i+1] ==\n                          (pre_carry_q[i] || ((&pre_sum_q[8*i+:8]) && implied_carry[i])));\n    end else begin\n      assign matches[i] = word_tag[8*i+:8] == (pre_sum_q[8*i+:8] + 8'(implied_carry[i]));\n    end\n  end\n  always_ff @(posedge clock) if (\"'!stall_id) ready_address_q <= rs1_ex_ready;\n  assign issue_hit = ready_address_q && candidate_eligible && candidate.valid &&\n                     (&matches) && !access_misaligned(id_ex_w.ctrl.mem_width, pre_sum_q[1:0]);\n\n'\"'''+s[b:]\n p.write_text(s)\nPY\npython /srv/hweben