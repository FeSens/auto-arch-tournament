{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/ex_stage.sv; cat cores/bench/rtl/hazard_unit.sv\"", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Bypass the adjacent producer when needed, run the ALU\n// and resolve branch targets. Owns the EX/MEM pipeline register.\n//\n// Latency:        9 EX cycles for DIV/REM, 1 for other instructions.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               fwd_rs1_sel,\n  input  logic               fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  load_word_t         candidate,\n  input  logic               candidate_eligible,\n  output logic [11:0]        actual_low,\n  output logic               load_hit,\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:2]        redirect_target,\n  output logic               train,\n  output logic [1:0]         train_counter\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = fwd_rs1_sel ? fwd_ex_mem : in.rs1_val;\n  assign rs2 = fwd_rs2_sel ? fwd_ex_mem : in.rs2_val;\n\n  // Address verification runs in parallel with extracting the load value.\n  // Compare the row as well as the tag: a stride can choose the wrong row.\n  logic [31:0] mem_addr, predicted_data;\n  assign mem_addr = rs1 + in.imm;\n  assign actual_low = mem_addr[11:0];\n  assign load_hit = in.ctrl.mem_read && candidate_eligible && candidate.valid &&\n                    mem_addr[31:2] == {12'b0