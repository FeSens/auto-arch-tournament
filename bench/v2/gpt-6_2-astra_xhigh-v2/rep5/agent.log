{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predictor/btb.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nroot=Path(os.environ['TMPDIR'])/'predictor/cores/bench'\np=root/'rtl_btb'\nshutil.copytree(root/'rtl_control',p)\ndef update(file, pairs):\n s=(p/file).read_text()\n for a,b in pairs: assert a in s,(file,a); s=s.replace(a,b)\n (p/file).write_text(s)\nupdate('core_pkg.sv',[('    logic predicted_taken;', '    logic btb_hit;\\\\n    logic predicted_taken;')])\nupdate('id_stage.sv',[('      reg_q.predicted_taken', '      reg_q.btb_hit <= in.btb_hit;\\\\n      reg_q.predicted_taken')])\n# One bank per column with distinct write enables: tag and target only update on allocation / taken, state on taken or matching non-taken.\nupdate('core.sv',[('  logic [6:0]  train_index;', '''  logic [31:0] train_pc;\n  logic [17:0] train_target;\n  logic        train_target_valid;'''),('.train_index     (train_index),','''.train_pc        (train_pc),\n    .train_target    (train_target),\n    .train_target_valid(train_target_valid),'''),('  ex_stage u_ex (','  ex_stage u_ex (\\\\n    .fetch_pc(io_imemAddr),')])\nupdate('if_stage.sv',[('  input logic [6:0]         train_index,','''  input logic [31:0]        train_pc,\n  input logic [17:0]        train_target,\n  input logic               train_target_valid,''')])\ns=(p/'if_stage.sv').read_text(); a=s.index('  logic [1:0] counters'); b=s.index('  // Redirect must',a)\ns=s[:a]+'''  logic [1:0] counters [0:127];\n  logic [10:0] tags [0:127];\n  logic [17:0] targets [0:127];\n  logic [127:0] valid;\n  logic hit, predict;\n  logic [6:0] index;\n  assign index = pc[8:2];\n  assign hit = valid[index] && pc[31:20] == 0 && tags[index] == pc[19:9];\n  assign predict = hit && counters[index][1];\n  assign next_pc = predict ? {12'b0, targets[index], 2'b0} : pc + 32'd4;\n  assign out.btb_hit = hit;\n  assign out.predicted_taken = predict;\n  assign out.direction_state = counters[index];\n\n  always_ff @(posedge clock) begin\n    if (reset) valid <= '0;\n    else if (train_target_valid)\n      valid[train_pc[8:2]] <= 1'b1;\n    if (train_target_valid) begin\n      tags[train_pc[8:2]] <= train_pc[19:9];\n      targets[train_pc[8:2]] <= train_target;\n    end\n    if (train_valid)\n      counters[train_pc[8:2]] <= train_state;\n  end\n\n'''+s[b:]\n# Avoid unused port bits for lint without reducing correctness.\ns=s.replace('logic [31:0]        train_pc','logic [19:2]        train_pc'); (p/'if_stage.sv').write_text(s)\nupdate('core.sv',[('logic [31:0] train_pc;', 'logic [19:2] train_pc;')])\nupdate('ex_stage.sv',[('  output logic [6:0]         train_index,','''  input logic [31:0]         fetch_pc,\n  output logic [19:2]        train_pc,\n  output logic [17:0]        train_target,\n  output logic               train_target_valid,''')])\ns=(p/'ex_stage.sv').read_text(); a=s.index('  logic actual_taken;'); b=s.index('  // ── EX/MEM',a)\ns=s[:a]+'''  logic actual_taken, advance, cacheable;\n  logic [31:0] destination;\n  assign advance = in.valid && \"'!stall && !div_wait;\n  assign actual_taken = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n  assign destination = in.ctrl.is_jalr ? jump_target : branch_target;\n  assign redirect = advance && ((in.predicted_taken != actual_taken)\n                             || (actual_taken && in.predicted_taken && fetch_pc != destination));\n  assign redirect_target = actual_taken ? destination : in.pc + 32'\"'d4;\n  assign cacheable = in.pc[31:20] == 0 && destination[31:20] == 0;\n  assign train_target_valid = advance && actual_taken && cacheable;\n  assign train_valid = train_target_valid || (advance && in.ctrl.is_branch && in.btb_hit && \"'!misalign_fault);\n  assign train_pc = in.pc[19:2];\n  assign train_target = destination[19:2];\n  assign train_state = in.ctrl.is_jump ? 2'\"'b11 :\n                       actual_taken ? ((\"'!in.btb_hit) ? 2'\"'b10 :\n                                       ((&in.direction_state) ? 2'b11 : in.direction_state + 2'd1)) :\n                                       ((|in.direction_state) ? in.direction_state - 2'd1 : 2'b00);\n\n'''+s[b:]\n(p/'ex_stage.sv').write_text(s)\nPY\npython \\\"\"'$TMPDIR/predictor/btb.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
