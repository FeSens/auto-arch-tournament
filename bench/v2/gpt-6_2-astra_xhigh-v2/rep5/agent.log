{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"cp -r cores/bench/test /srv/hwebench/tmp/19d02a47/57dc36ce/pred.6MOnct/initialized/test\ncd /srv/hwebench/tmp/19d02a47/57dc36ce/pred.6MOnct/initialized\npython - <<'PY'\nfrom pathlib import Path\np=Path('test/test_pipeline.py')\ns=p.read_text().replace('\\\"hazard_unit.sv\\\", \\\"forward_unit.sv\\\",','\\\"hazard_unit.sv\\\", \\\"forward_unit.sv\\\", \\\"load_predictor.sv\\\",')\ns += '''\n\n@cocotb.test()\nasync def predict_stride_with_pending_base(dut):\n    # Train six words, then walk their high halfwords. Every load's base is\n    # produced by the immediately preceding ADDI. The last two target rows\n    # must be available to the dependent ADD while the external RAM stalls.\n    memory = {0x200+4*i: ((0xFF00+i) << 16) | (0xA0+i) for i in range(6)}\n    preload = [LW(20, 0, a) for a in memory]\n    lh = _i(2, 10, 1, 11, 3)\n    add = ADD(12,11,11)\n    program = preload + [ADDI(10,0,0x1fc), ADDI(13,0,0x214),\n                         ADDI(10,10,4), lh, add, BLT(10,13,-12), EBREAK()]\n    requests = []\n    def ready(addr, ren, wen):\n        if ren: requests.append(addr)\n        return addr not in (0x212, 0x216)\n    rets,_ = await _run(dut, program, memory, dmem_ready=ready, initial_fetch_wait=1040)\n    loads = _by_insn(rets,lh)\n    adds = _by_insn(rets,add)\n    assert len(loads) == len(adds) == 6\n    for i,(l,a) in enumerate(zip(loads,adds)):\n        word = 0x200+4*i\n        expected = (0xffffff00+i) & 0xffffffff\n        assert (l[\\\"mem_addr\\\"],l[\\\"mem_rmask\\\"],l[\\\"mem_rdata\\\"],l[\\\"rd_wdata\\\"]) == (word,12,memory[word],expected)\n        assert (a[\\\"rs1_rdata\\\"],a[\\\"rs2_rdata\\\"],a[\\\"rd_wdata\\\"]) == (expected,expected,(2*expected)&0xffffffff)\n        if i >= 4:\n            assert a[\\\"cycle\\\"] == l[\\\"cycle\\\"] + 1\n            assert word+2 not in requests\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n\n@cocotb.test()\nasync def conflicting_stores_during_load_prediction(dut):\n    # The older SB holds MEM while the following load holds its RAM\n    # candidate in EX. The byte store must win before the LW completes.\n    a,b = 0x100,0x1100\n    initial = {a:0x12345678, b:0xa1b2c3d4}\n    sb = _s(1,5,1,0,0x23)\n    lui = (1<<12) | (7<<7) | 0x37\n    program = [ADDI(1,0,a),ADDI(5,0,0x9a),lui,ADDI(7,7,a),\n               LW(10,1,0),NOP(),NOP(),sb,LW(11,1,0),ADD(12,11,11),\n               LW(13,7,0),NOP(),LW(14,1,0),NOP(),SW(13,1,0),\n               LW(15,1,0),NOP(),LW(16,1,2),EBREAK()]\n    waits = 3\n    def ready(addr,ren,wen):\n        nonlocal waits\n        if addr == a+1 and wen and waits:\n            waits -= 1\n            return False\n        return True\n    rets,mem = await _run(dut,program,initial,dmem_ready=ready,initial_fetch_wait=1040)\n    assert [r[\\\"pc\\\"] for r in rets] == [4*i for i in range(len(program))]\n    assert waits == 0\n    values={r[\\\"rd\\\"]:r[\\\"rd_wdata\\\"] for r in rets if r[\\\"rd\\\"]}\n    assert [values[k] for k in range(10,16)] == [initial[a],0x12349a78,0x246934f0,initial[b],0x12349a78,initial[b]]\n    assert rets[-2][\\\"trap\\\"] == 1 and rets[-2][\\\"mem_rmask\\\"] == 0 and rets[-2][\\\"rd\\\"] == 0\n    assert mem[a] == mem[b] == initial[b]\n'''\np.write_text(s)\nPY\npytest -q test/test_pipeline.py >/srv/hwebench/tmp/19d02a47/57dc36ce/pred.6MOnct/initialized/cocotb.log 2>&1 && tail -5 /srv/hwebench/tmp/19d02a47/57dc36ce/pred.6MOnct/initialized/cocotb.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
