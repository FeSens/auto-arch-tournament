{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl cores/bench/test/test_pipeline.py'", "aggregated_output": "diff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex bb8ee68..a496ab6 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -4,7 +4,7 @@\n //\n //  IF -> ID -> EX -> MEM -> WB\n //  ID captures write-first RF operands on MEM completion. EX can override\n-//  either operand with the immediately preceding instruction's result.\n+//  either operand with the preceding instruction's ordinary EX/MEM result.\n //\n // IO port names use the `io_*` Chisel-emit prefix so the existing\n // formal/wrapper_si.sv and test/cosim/main.cpp bindings carry through\n@@ -14,7 +14,7 @@\n // synth to fpga/core_bench_si.sv for this core. There is no channel 1.\n //\n // Latency:        full pipeline; instruction n retires at MEM/WB on\n-//                 cycle n+4 (no hazards) or later (load-use stall,\n+//                 cycle n+4 (no hazards) or later (operand stall,\n //                 redirect).\n // RVFI fields:    driven from the MEM/WB register.\n module core (\n@@ -110,7 +110,7 @@ module core (\n \n   // ── ID + regfile ──────────────────────────────────────────────────────\n   // Read and compare speculatively. The qualified IF/ID instruction still\n-  // controls issue, the load-use interlock and retirement metadata.\n+  // controls issue, the operand interlock and retirement metadata.\n   assign rs1_addr_w = if_id_w.instr[19:15];\n   assign rs2_addr_w = if_id_w.instr[24:20];\n   // A matching EX writer needs forwarding after issue. A MEM writer is\n@@ -146,6 +146,8 @@ module core (\n \n   // ── EX ────────────────────────────────────────────────────────────────\n   load_word_t  candidate;\n+  logic [31:0] fast_bypass;\n+  logic        slow_producer;\n   logic        candidate_eligible, load_hit;\n   logic [11:0] actual_low;\n \n@@ -177,11 +179,13 @@ module core (\n     .in              (id_ex_w),\n     .fwd_rs1_sel     (fwd_rs1_sel),\n     .fwd_rs2_sel     (fwd_rs2_sel),\n-    .fwd_ex_mem      (ex_mem_w.alu_result),\n+    .fwd_ex_mem      (fast_bypass),\n     .candidate       (candidate),\n     .candidate_eligible (candidate_eligible\n…[4833 of 7905 chars elided by tools/bench/transcript.py; sha256:01316451ebef1325]…\n[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])] == [\n-        1, 4, 1, 1, 1, 1, 3, 2, 1, 1\n+        1, 4, 1, 2, 2, 1, 4, 2, 2, 1\n     ]\n \n \n+@cocotb.test()\n+async def independent_multiplies_and_x0(dut):\n+    program = [\n+        ADDI(1, 0, -2), MUL(2, 1, 1), MULHU(3, 1, 1), ADD(4, 1, 3),\n+        MUL(0, 2, 2), ADD(5, 4, 0), EBREAK(),\n+    ]\n+    rets, _ = await _run(dut, program)\n+    _check_straight_line(rets, program)\n+    assert all(r[\"trap\"] == 0 for r in rets)\n+    assert [(r[\"rd\"], r[\"rd_wdata\"]) for r in rets] == [\n+        (1, 0xfffffffe), (2, 4), (3, 0xfffffffc), (4, 0xfffffffa),\n+        (0, 0), (5, 0xfffffffa), (0, 0),\n+    ]\n+    assert (rets[3][\"rs2_rdata\"], rets[5][\"rs2_rdata\"]) == (0xfffffffc, 0)\n+    # Only the ADD reading MULHU's result on rs2 needs a bubble.\n+    assert [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])] == [1, 1, 2, 1, 1, 1]\n+\n+\n @cocotb.test()\n async def stalled_signed_byte_load_use(dut):\n     program = [ADDI(1, 0, 0x41), LB(5, 1, 1), ADD(6, 5, 5), EBREAK()]\n", "exit_code": 0, "status": "completed"}}
