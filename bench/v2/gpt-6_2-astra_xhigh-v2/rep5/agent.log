{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/reg_file.sv'","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// Each asynchronous read port has a RAM replica. Only the shared written\n// bits need reset. An unwritten register (including x0) always reads zero.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_rs1 [0:31];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_rs2 [0:31];\n  logic [31:0] written;\n  logic write_word;\n\n  assign write_word = w_en && w_addr != 5'd0;\n\n  always_ff @(posedge clock) begin\n    if (write_word) begin\n      regs_rs1[w_addr] <= w_data;\n      regs_rs2[w_addr] <= w_data;\n    end\n    if (reset)\n      written <= '0;\n    else if (write_word)\n      written[w_addr] <= 1'b1;\n  end\n\n  always_comb begin\n    if (write_word && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = written[rs1_addr] ? regs_rs1[rs1_addr] : 32'b0;\n\n    if (write_word && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = written[rs2_addr] ? regs_rs2[rs2_addr] : 32'b0;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'","aggregated_output":"// IF and ID share the instruction bus and the bypassed register operands.\n// The PC is the fetch register. ID/EX captures the prediction on issue.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        stall,\n  input  logic        redirect,\n  input  logic [31:2] redirect_target,\n  input  logic [31:0] rs1_data,\n  input  logic [31:0] rs2_data,\n  input  logic        rs1_ready,\n  input  logic        rs2_ready,\n  input  logic        train,\n  input  logic [6:0]  train_index,\n  input  logic [1:0]  train_counter,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  input  logic        imem_ready,\n  output if_id_t      out\n);\n  logic [31:2] pc_word;\n  logic [31:0] pc, pc_plus4, direct_target, direct_offset;\n  logic        is_jal, is_branch, eq_branch_ready, branch_direction;\n  logic        direct_taken, jalr_taken;\n\n  // One asynchronous lookup and one shared synchronous write port.\n  // The high bit holds at one once all 128 rows have been initialized.\n  (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] counters [0:127];\n  logic [7:0] sweep;\n  logic [1:0] counter;\n  logic [6:0] write_index;\n\n  always_ff @(posedge clock) begin\n    if (reset)          sweep <= 8'd0;\n    else if (!sweep[7]) sweep <= sweep + 8'd1;\n  end\n  assign write_index = sweep[7] ? train_index : sweep[6:0];\n  always_ff @(posedge clock) begin\n    if (!sweep[7] || train)\n      counters[write_index] <= sweep[7] ? train_counter : 2'b01;\n  end\n  assign counter = sweep[7] ? counters[pc[8:2]] : 2'b01;\n\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] != 2'b01;\n  assign eq_branch_ready = imem_data[14:13] == 2'b00 && rs1_ready && rs2_ready;\n  assign branch_direction = eq_branch_ready ? ((rs1_data == rs2_data) ^ imem_data[12])\n                                            : counter[1];\n\n  // Opcode bit 3 distinguishes J from B for the shared target adder.\n  assign direct_offset = imem_data[3]\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:21], 1'b0}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:8], 1'b0};\n  assign direct_target = pc + direct_offset;\n  assign pc_plus4 = pc + 32'd4;\n  assign direct_taken = (is_jal || (is_branch && branch_direction)) &&\n                        direct_target[31:20] == 0 && direct_target[1:0] == 0;\n  // With a ready base and an immediate of zero the predicted JALR target\n  // is exact. Bit zero is discarded for both prediction and execution.\n  assign jalr_taken = imem_data[6:0] == 7'b1100111 && imem_data[14:12] == 0 &&\n                      imem_data[31:20] == 0 && rs1_ready &&\n                      rs1_data[31:20] == 0 && !rs1_data[1];\n\n  // Every admitted target is word-aligned. Both taken prediction paths\n  // also checked the instruction window, so their upper bits are zero.\n  assign pc = {pc_word, 2'b00};\n  always_ff @(posedge clock) begin\n    if (reset)         pc_word <= '0;\n    else if (redirect) pc_word <= redirect_target;\n    else if (!stall)   pc_word <= jalr_taken ? {12'b0, rs1_data[19:2]} :\n                                  direct_taken ? {12'b0, direct_target[19:2]} : pc_plus4[31:2];\n  end\n\n  assign imem_addr           = pc;\n  assign out.pc              = pc;\n  assign out.pc_plus4        = pc_plus4;\n  assign out.direct_target   = direct_target;\n  assign out.alternate_pc    = direct_taken ? pc_plus4[31:2] : direct_target[31:2];\n  assign out.counter         = counter;\n  assign out.predicted_taken = direct_taken || jalr_taken;\n  assign out.instr           = imem_data;\n  assign out.valid           = imem_ready;\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Bypass the adjacent producer when needed, run the ALU\n// and resolve branch targets. Owns the EX/MEM pipeline register.\n//\n// Latency:        9 EX cycles for DIV/REM, 1 for other instructions.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  id_ex_t   in,\n  input  logic               fwd_rs1_sel,\n  input  logic               fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,\n  input  logic               early_done,\n  input  logic [31:0]        dmem_rdata,\n  output logic               early_eligible,\n  output logic [31:0]        mem_addr,\n  output logic [31:0]        early_wdata,\n  output logic [3:0]         early_lanes,\n  output ex_mem_t  out,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:2]        redirect_target,\n  output logic               train,\n  output logic [1:0]         train_counter\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = fwd_rs1_sel ? fwd_ex_mem : in.rs1_val;\n  assign rs2 = fwd_rs2_sel ? fwd_ex_mem : in.rs2_val;\n\n  // The forwarded address also covers a base that was still busy in ID.\n  assign mem_addr = rs1 + in.imm;\n  assign early_eligible = in.valid && in.base_ready && in.early_addr[31:20] == 0\n                          && mem_aligned(in.ctrl.mem_width, in.early_addr[1:0]);\n  assign early_lanes = mem_lanes(in.ctrl.mem_width, in.early_addr[1:0]);\n  assign early_wdata = store_word(in.ctrl.mem_width,