{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport struct,json\nfrom pathlib import Path\nrecords=list(struct.iter_unpack('<5I',Path('/srv/hwebench/tmp/b57a151a/28c36122/control-events-r6s2.bin').read_bytes()))\nresults=[]\nfor organization in ('direct','assoc_fifo','assoc_lru'):\n for size in (4,8,16):\n  for taken_allocate in (False,True):\n   table=[None]*size; ages=[0]*size; pointer=0; tick=0; misses=0;directtaken=0\n   for pc,insn,dest,taken,active in records:\n    op=insn&127\n    if op==0x67:continue\n    tick+=1\n    if organization=='direct':\n     idx=(pc>>2)&(size-1);entry=table[idx]\n     hit=entry is not None and entry[0]==pc\n    else:\n     idx=next((j for j,e in enumerate(table) if e is not None and e[0]==pc),None)\n     hit=idx is not None;entry=table[idx] if hit else None\n    ptaken=hit and (entry[2] or entry[3]>=2)\n    pred=entry[1] if ptaken else pc+4\n    actual=dest if taken else pc+4\n    if active:misses+=pred\"'!=actual;directtaken+=taken\n    if hit:\n     count=entry[3]\n     if op==0x63:count=min(3,count+1) if taken else max(0,count-1)\n     table[idx]=(pc,dest,op==0x6f,count);ages[idx]=tick\n    elif not taken_allocate or taken:\n     count=2 if taken else 1\n     if organization!='\"'direct':\n      empty=next((j for j,e in enumerate(table) if e is None),None)\n      if empty is not None:idx=empty\n      elif organization=='assoc_fifo':idx=pointer\n      else:idx=min(range(size),key=ages.__getitem__)\n      if organization=='assoc_fifo':pointer=(idx+1)%size\n     table[idx]=(pc,dest,op==0x6f,count);ages[idx]=tick\n   saved=directtaken-misses;cycles=4491817-saved\n   results.append({'organization':organization,'entries':size,'allocate_taken_only':taken_allocate,'misses':misses,'saved':saved,'estimated_cycles':cycles,'rate_gain_pct':round((4491817/cycles-1)*100,3),'min_fmax_mhz':round(150.99*1.046*cycles/10/1e6,3)})\nprint(json.dumps(sorted(results,key=lambda r:r['misses']),indent=2))\nPath('/srv/hwebench/tmp/b57a151a/28c36122/allocation-stats-r6s2.json').write_text(json.dumps(results,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
