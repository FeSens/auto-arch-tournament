{"type": "item.completed", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,160p' cores/bench/rtl/branch_predictor.sv; sed -n '1,90p' cores/bench/rtl/if_stage.sv; ls -lt cores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr\"", "aggregated_output": "// Sixteen independent direct-transfer entries. Partial tags may alias:\n// EX checks the full live successor independently of all table contents.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule branch_predictor (\n  input  logic              clock,\n  input  logic              reset,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0]        lookup_pc, // bits above 13 deliberately alias\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic              predict_taken,\n  output logic [31:0]        predict_target,\n  input  logic              mem_advance,\n  input  predictor_update_t update\n);\n  wire [15:0] selected;\n  wire [31:0] targets [0:15];\n  wire [31:0] level1 [0:7];\n  wire [31:0] level2 [0:3];\n  wire [31:0] level3 [0:1];\n\n  for (genvar entry = 0; entry < 16; entry++) begin : g_entries\n    localparam logic [3:0] INDEX = 4'(entry);\n    logic valid_q;\n    logic [9:0] tag_q;\n    logic [31:2] target_q;\n    logic [1:0] counter_q;\n    wire lookup_hit = valid_q && (lookup_pc[5:2] == INDEX) &&\n                      (tag_q == {lookup_pc[13:6], lookup_pc[1:0]});\n    wire update_hit = valid_q &&\n                      (tag_q == {update.pc[13:6], update.pc[1:0]});\n    wire write_entry = mem_advance && update.valid && (update.pc[5:2] == INDEX);\n\n    assign selected[entry] = lookup_hit && counter_q[1];\n    assign targets[entry] = {target_q, 2'b00} & {32{selected[entry]}};\n\n    // Reset validity only. Uninitialized tags, targets and counters are\n    // inaccessible until a legal aligned taken transfer allocates them.\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        valid_q <= 1'b0;\n      end else if (write_entry) begin\n        if (!update.direct_eligible) begin\n          if (update_hit) valid_q <= 1'b0;\n        end else if (update_hit) begin\n          // Cache the destination even on a not-taken branch outcome.\n          target_q <= update.target;\n          if (update.taken) begin\n            if (counter_q != 2'b11) counter_q <= counter_q + 2'b01;\n          end else begin\n            i\n…[2300 of 5372 chars elided by tools/bench/transcript.py; sha256:a1c6570bfd5c1094]…\nunselected leaf to\n    // zero. Combine it with a locally qualified fallthrough instead of\n    // putting a second wide mux after the balanced target OR tree.\n    next_pc = predict_target | ((pc + 32'd4) & {32{!predict_taken}});\n  end\n\n  // Redirect is an accepted EX repair: EX already excludes downstream\n  // and divider holds. It overrides unavailable imem and load-use, while\n  // predictions are consumed only when a valid fetch enters ID/EX.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    // hazard_unit includes imem-not-ready and every ID/EX hold in stall.\n    // With no redirect, !stall is exactly valid ID/EX fetch acceptance.\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_data;\n    out.valid = !(flush || redirect);\n  end\n\nendmodule\n-rw-rw----+ 1 hwebench3 hwebench3 231638 Oct  5 05:32 cores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr\n", "exit_code": 0, "status": "completed"}}
