k(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await tick(\n…[40308 of 43380 chars elided by tools/bench/transcript.py; sha256:c92f0c0d5f9d81e6]…\nunavailable\"] >= 68\n    assert stats[\"launches\"] == [(100, 7), (21, 7)]\n    for instr, a, b, result in ((DIV(3, 1, 2), 100, 7, 14),\n                                (ADD(4, 3, 2), 14, 7, 21),\n                                (REM(5, 4, 2), 21, 7, 0)):\n        [ret] = _by_insn(rets, instr)\n        assert (ret[\"rs1_rdata\"], ret[\"rs2_rdata\"], ret[\"rd_wdata\"]) == (a, b, result)\n    [unchanged] = _by_insn(rets, ADDI(12, 11, 1))\n    assert (unchanged[\"rs1_rdata\"], unchanged[\"rd_wdata\"]) == (0, 1)\n    assert stats[\"reads\"] == []\n    assert stats[\"writes\"] == [(0x104, 0, 15)]\n    assert dmem == {0x104: 0}\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
