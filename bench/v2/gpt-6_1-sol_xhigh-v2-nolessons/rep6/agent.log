{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.cosim import run_one\nfrom tools.eval.fpga import validate_coremark_uart\nfrom concurrent.futures import ThreadPoolExecutor\nimport json,subprocess\nprobe=Path('cores/bench/generated/r15_mul_prepare_probe').resolve(); sim=str(probe/'obj_dir/cosim_sim')\nwith ThreadPoolExecutor() as pool:\n fs=[pool.submit(run_one,probe/(name+'.elf'),sim,str(Path.cwd()),None,flags) for name in ['selftest','random1','random2','random3'] for flags in [(),('--istall','--dstall')]]\n for f in fs: print(json.dumps(f.result()),flush=True)\nr=subprocess.run([sim,str(probe/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True)\nm=json.loads(r.stdout.splitlines()[-1]); valid,why=validate_coremark_uart(m.get('uart',''),10)\nassert valid,why\nassert m['ebreak'] and not m['oob'] and m['bench_bracketed']\nprint('Validated CoreMark cycles:',m['bench_stop_cycle']-m['bench_start_cycle'],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
