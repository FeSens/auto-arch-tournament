HESIS\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire [71:0] native_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n`else\n  logic signed [32:0] mul_a, mul_b;\n  // The extension-only product bits [65:64] are intentionally unused.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] product;\n  /* verilator lint_on UNUSEDSIGNAL */\n`endif\n`ifdef SYNTHESIS\n  MULT36X36 #(.AREG(1'b0), .BREG(1'b0), .OUT0_REG(1'b0),\n              .OUT1_REG(1'b0), .PIPE_REG(1'b0),\n              .ASIGN_REG(1'b0), .BSIGN_REG(1'b0)) u_native (\n    .DOUT(native_product), .A({rs1_val,4'b0}), .B({rs2_val,4'b0}),\n    .ASIGN(a_signed), .BSIGN(b_signed), .CLK(1'b0), .CE(1'b1), .RESET(1'b0)\n  );\n`endif\n`endif\n\n  always_comb begin\n`ifdef RISCV_FORMAL_ALTOPS\n    case (op)\n      ALU_MUL:    result = (rs1_val + rs2_val) ^ 32'h5876063e;\n      ALU_MULH:   result = (rs1_val + rs2_val) ^ 32'hf6583fb7;\n      ALU_MULHU:  result = (rs1_val + rs2_val) ^ 32'h949ce5e8;\n      ALU_MULHSU: result = (rs1_val - rs2_val) ^ 32'hecfbe137;\n      default:    result = 32'b0;\n    endcase\n`else\n    a_signed = (op == ALU_MULH || op == ALU_MULHSU);\n    b_signed = (op == ALU_MULH);\n`ifdef SYNTHESIS\n    case (op)\n      ALU_MUL: result = native_product[39:8];\n      ALU_MULH, ALU_MULHU, ALU_MULHSU: result = native_product[71:40];\n      default: result = 32'b0;\n    endcase\n`else\n    mul_a = $signed({a_signed && rs1_val[31], rs1_val});\n    mul_b = $signed({b_signed && rs2_val[31], rs2_val});\n    product = mul_a * mul_b;\n    case (op)\n      ALU_MUL: result = product[31:0];\n      ALU_MULH, ALU_MULHU, ALU_MULHSU: result = product[63:32];\n      default: result = 32'b0;\n    endcase\n`endif\n`endif\n  end\nendmodule\n\n","exit_code":0,"status":"completed"}}
