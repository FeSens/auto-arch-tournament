{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_alu.py\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nThe fast ALU is combinational. Real MUL-family vectors live in\ntest_multiplier.py; real DIV/REM vectors use test_divider.py.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"ALTOPS_MODE\") == \"1\"\nALTOPS_CONSTANTS = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\nMUL_OPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\n\n\nasync def _setup(dut):\n    \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n    `await _setup(dut)` for parity with other test files.\"\"\"\n    return\n\n\nasync def _check(dut, op, a, b, expected, *, mul_rs1=None, mul_rs2=None):\n    \"\"\"Drive both operand interfaces and check the combinational result.\"\"\"\n    mul_rs1 = a if mul_rs1 is None else mul_rs1\n    mul_rs2 = b if mul_rs2 is None else mul_rs2\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    dut.mul_rs1.value = mul_rs1 & MASK32\n    dut.mul_rs2.value = mul_rs2 & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    if ALTOPS and op in ALTOPS_CONSTANTS:\n        arithmetic = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        expected = arithmetic ^ ALTOPS_CONSTANTS[op]\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"mul_rs1=0x{mul_rs1 & MASK32:08x} mul_rs2=0x{mul_rs2 & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_A\n…[4532 of 7604 chars elided by tools/bench/transcript.py; sha256:a86761f45cff4a49]…\n (MASK32, 0x80000000, 0x7FFFFFFF, 0x80000001),\n        (0x80000001, 3, MASK32, MASK32),\n        (0x12345678, 0x9ABCDEF0, 0x80000001, 0x7FFFFFFF),\n    ):\n        for op in MUL_OPS:\n            await _check(dut, op, a, b, 0,\n                         mul_rs1=rs1, mul_rs2=rs2)\n        # Change modes with the same four input words. No base operation\n        # may accidentally use the dedicated multiplier sources.\n        signed_a = a if a < 0x80000000 else a - (1 << 32)\n        signed_b = b if b < 0x80000000 else b - (1 << 32)\n        for op, expected in (\n            (ALU_ADD, a + b), (ALU_SUB, a - b),\n            (ALU_AND, a & b), (ALU_OR, a | b), (ALU_XOR, a ^ b),\n            (ALU_SLT, int(signed_a < signed_b)), (ALU_SLTU, int(a < b)),\n            (ALU_SLL, a << (b & 31)), (ALU_SRL, a >> (b & 31)),\n            (ALU_SRA, signed_a >> (b & 31)), (ALU_LUI, b),\n            (ALU_DIV, 0), (ALU_DIVU, 0), (ALU_REM, 0), (ALU_REMU, 0),\n        ):\n            await _check(dut, op, a, b, expected, mul_rs1=rs1, mul_rs2=rs2)\n", "exit_code": 0, "status": "completed"}}
