{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"sed -n '730,852p' cores/bench/test/test_pipeline.py; sed -n '1959,2068p' cores/bench/test/test_pipeline.py; sed -n '145,205p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def redirects_squash_all_younger_side_effects(dut):\n    \"\"\"Taken BEQ/JAL/JALR each squash a store, load, writer, DIV, and REM.\"\"\"\n    redirects = (BEQ(1, 1, 8), JAL(7, 8), JALR(7, 5, 0))\n    younger = (SW(1, 0, 0x100), LW(9, 0, 0x100), ADDI(9, 0, 99),\n               DIV(9, 1, 2), REM(9, 1, 2))\n    for jump in redirects:\n        for wrong in younger:\n            program = [ADDI(1, 0, 100), ADDI(2, 0, 7), ADDI(5, 0, 20),\n                       jump, wrong, ADDI(8, 9, 1), SW(8, 0, 0x104), EBREAK()]\n            stats, observe = _bubble_observer(dut)\n            rets, dmem = await _run(dut, program, {0x100: 0xFEED}, observe=observe)\n            _assert_retirement_stream(rets, program, skipped=(16,))\n            [target] = _by_insn(rets, ADDI(8, 9, 1))\n            assert (target[\"rs1_rdata\"], target[\"rd_wdata\"]) == (0, 1)\n            [ret_jump] = _by_insn(rets, jump)\n            assert ret_jump[\"pc_next\"] == 20\n            if jump == BEQ(1, 1, 8):\n                assert (ret_jump[\"rs1_rdata\"], ret_jump[\"rs2_rdata\"]) == (100, 100)\n            else:\n                assert (ret_jump[\"rd\"], ret_jump[\"rd_wdata\"]) == (7, 16)\n                if jump == JALR(7, 5, 0):\n                    assert ret_jump[\"rs1_rdata\"] == 20\n            assert dmem == {0x100: 0xFEED, 0x104: 1}\n            assert stats[\"reads\"] == [] and stats[\"launches\"] == []\n            assert stats[\"writes\"] == [(0x104, 1, 15)]\n\n\n@cocotb.test()\nasync def unavailable_fetch_words_have_no_side_effects(dut):\n    program = [ADDI(1, 0, 100), ADDI(2, 0, 7), LW(3, 0, 0x100),\n               ADD(4, 3, 1), ADD(5, 4, 2), SW(5, 0, 0x104),\n               LW(6, 0, 0x104), ADDI(7, 6, 1), ADDI(12, 11, 1), EBREAK()]\n    remaining = {}\n\n    def ready(cycle, ia, da, wen, ren):\n        remaining.setdefault(ia, 8)\n        ir = int(remaining[ia] == 0)\n        if not ir:\n            remaining[ia] -= 1\n        return ir, int(cycle % 5 != 0)\n\n    stats, observe = _bubble_observer(dut)\n    rets, dmem = await _run(dut, program, {0x100: 5}, max_cycles=300,\n                          \n…[11394 of 14466 chars elided by tools/bench/transcript.py; sha256:a8650cb750ae23e6]…\nawait tick()\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
