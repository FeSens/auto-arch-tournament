{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport random,subprocess\nprobe=Path('/srv/hwebench/tmp/b57a151a/2d5114cf/predictor_probe')\nrepo=Path.cwd()\nsrcs=[str(repo/'bench/programs/coremark'/s) for s in ['core_list_join.c','core_main.c','core_matrix.c','core_state.c','core_util.c','baremetal/core_portme.c']]+[str(repo/'bench/programs/crt0.S')]\nargs=['riscv32-unknown-elf-gcc','-march=rv32im','-mabi=ilp32','-O3','-static','-nostartfiles','-specs=nano.specs','-specs=nosys.specs','-T',str(repo/'bench/programs/link.ld'),'-I'+str(repo/'bench/programs/coremark'),'-I'+str(repo/'bench/programs/coremark/baremetal'),'-DTOTAL_DATA_SIZE=2000',*srcs,'-o',str(probe/'coremark.elf')]\nsubprocess.run(args,check=True)\nfor name in ['selftest','random1','random2','random3']:\n subprocess.run(['riscv32-unknown-elf-gcc','-march=rv32im','-mabi=ilp32','-static','-nostartfiles','-T',str(repo/'bench/programs/link.ld'),str(repo/f'bench/programs/{name}.S'),'-o',str(probe/f'{name}.elf')],check=True)\nrng=random.Random(45172)\nfor width in (12,20):\n for _ in range(100000):\n  p=rng.getrandbits(32);d=rng.randrange(-(1<<width),1<<width)//2*2\n  mask=(1<<width)-1;low=(p&mask)+(d&mask);carry=low>>width;sign=int(d<0)\n  hi=((p>>width)+carry-sign)&((1<<(32-width))-1)\n  got=(hi<<width)|(low&mask)\n  assert got==(p+d)&0xffffffff,(width,p,d,got)\nprint('Built five canonical ELFs in private directory; split-carry identities passed 200000 randomized vectors.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
