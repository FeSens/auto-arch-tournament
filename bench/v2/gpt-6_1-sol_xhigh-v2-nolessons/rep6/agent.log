{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/b57a151a/54ef2595/branch_bank/rtl')\n(p/'branch_compare.sv').write_text('''// Forwarding selects one-bit branch results after raw-source comparisons.\nmodule branch_compare (\n  input logic [31:0] raw_rs1, raw_rs2, ex_result, wb_result,\n  input logic [1:0] fwd_rs1_sel, fwd_rs2_sel,\n  input logic [2:0] branch_op,\n  output logic branch_cond\n);\n  function automatic [2:0] predicates(input logic [31:0] x, y);\n    logic [3:0] eq, lt;\n    logic full_eq, unsigned_lt, signed_lt;\n    begin\n      for (integer i=0; i<4; i=i+1) begin\n        eq[i] = (x[i*8 +: 8] == y[i*8 +: 8]);\n        lt[i] = (x[i*8 +: 8] < y[i*8 +: 8]);\n      end\n      full_eq = &eq;\n      unsigned_lt = lt[3] | (eq[3] & lt[2]) |\n                    (eq[3] & eq[2] & lt[1]) |\n                    (eq[3] & eq[2] & eq[1] & lt[0]);\n      signed_lt = (x[31] \"'^ y[31]) ? x[31] : unsigned_lt;\n      predicates = {signed_lt,unsigned_lt,full_eq};\n    end\n  endfunction\n  function automatic [2:0] reverse_pred(input logic [2:0] p);\n    reverse_pred = {(!p[2] && !p[0]), (!p[1] && !p[0]), p[0]};\n  endfunction\n  function automatic condition(input logic [2:0] p, input logic [2:0] op);\n    case (op)\n      BR_BEQ: condition = p[0];\n      BR_BNE: condition = !p[0];\n      BR_BLT: condition = p[2];\n      BR_BGE: condition = !p[2];\n      BR_BLTU: condition = p[1];\n      BR_BGEU: condition = !p[1];\n      default: condition = 1'\"'b0;\n    endcase\n  endfunction\n  logic [2:0] ab, ae, aw, be, bw, ew;\n  logic a_sel, e1_sel, w1_sel, b_sel, e2_sel, w2_sel;\n  assign ab = predicates(raw_rs1,raw_rs2);\n  assign ae = predicates(raw_rs1,ex_result);\n  assign aw = predicates(raw_rs1,wb_result);\n  assign be = predicates(raw_rs2,ex_result);\n  assign bw = predicates(raw_rs2,wb_result);\n  assign ew = predicates(ex_result,wb_result);\n  assign e1_sel = (fwd_rs1_sel==2'd1);\n  assign w1_sel = (fwd_rs1_sel==2'd2);\n  assign a_sel = \"'!(e1_sel | w1_sel);\n  assign e2_sel = (fwd_rs2_sel==2'\"'d1);\n  assign w2_sel = (fwd_rs2_sel==2'd2);\n  assign b_sel = \"'!(e2_sel | w2_sel);\n  assign branch_cond =\n    (a_sel & b_sel & condition(ab,branch_op)) |\n    (a_sel & e2_sel & condition(ae,branch_op)) |\n    (a_sel & w2_sel & condition(aw,branch_op)) |\n    (e1_sel & b_sel & condition(reverse_pred(be),branch_op)) |\n    (e1_sel & e2_sel & condition(3'\"'b001,branch_op)) |\n    (e1_sel & w2_sel & condition(ew,branch_op)) |\n    (w1_sel & b_sel & condition(reverse_pred(bw),branch_op)) |\n    (w1_sel & e2_sel & condition(reverse_pred(ew),branch_op)) |\n    (w1_sel & w2_sel & condition(3'b001,branch_op));\nendmodule\n''')\nf=p/'ex_stage.sv';s=f.read_text()\nold='''    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 \"'!= rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'\"'b0;\n    endcase\n'''\nassert old in s;s=s.replace(old,'')\ns=s.replace('  always_comb begin\\\\n    branch_taken', '''  branch_compare u_branch_compare (\n    .raw_rs1(in.rs1_val), .raw_rs2(in.rs2_val),\n    .ex_result(fwd_ex_mem), .wb_result(fwd_mem_wb),\n    .fwd_rs1_sel(fwd_rs1_sel), .fwd_rs2_sel(fwd_rs2_sel),\n    .branch_op(in.ctrl.branch_op), .branch_cond(branch_cond)\n  );\n\n  always_comb begin\n    branch_taken''')\nassert 'u_branch_compare' in s;f.write_text(s)\nprint('Temporary prototype ready:',p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
