{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/branch_probe'); rtl=base/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'ex_stage.sv';t=p.read_text()\nstart=t.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nend=t.index('    branch_taken  =',start)\nnew='''  logic [3:0] compare_eq, compare_lt;\n  logic equal_word, less_unsigned, less_signed;\n  for (genvar i=0;i<4;i++) begin : branch_compare\n    assign compare_eq[i] = (rs1[i*8+:8] == rs2[i*8+:8]);\n    assign compare_lt[i] = (rs1[i*8+:8] < rs2[i*8+:8]);\n  end\n  assign equal_word = &compare_eq;\n  assign less_unsigned = compare_lt[3] |\n                         (compare_eq[3] & compare_lt[2]) |\n                         (compare_eq[3] & compare_eq[2] & compare_lt[1]) |\n                         (compare_eq[3] & compare_eq[2] & compare_eq[1] & compare_lt[0]);\n  assign less_signed = (rs1[31] \"'^ rs2[31]) ? rs1[31] : less_unsigned;\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ, BR_BNE:   branch_cond = equal_word ''^ in.ctrl.branch_op[0];\n      BR_BLT, BR_BGE:   branch_cond = less_signed ''^ in.ctrl.branch_op[0];\n      BR_BLTU, BR_BGEU: branch_cond = less_unsigned ''^ in.ctrl.branch_op[0];\n      default:         branch_cond = 1'\"'b0;\n    endcase\n'''\nt=t[:start]+new+t[end:];p.write_text(t)\nprint('Isolated hierarchical branch comparator prototype prepared.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
