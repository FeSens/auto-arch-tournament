{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json,sys,collections\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('bench/programs/coremark.elf')\nactive=False; stats=collections.Counter(); pcs=collections.Counter(); table=[3]*16\nfor n in range(4000000):\n r=cpu.step()\n if r is None:break\n if r['mem_addr']==0x10000100 and r['mem_wmask']: active=True\n if r['mem_addr']==0x10000104 and r['mem_wmask']: break\n if not active:continue\n stats['instructions']+=1\n i=r['insn'];op=i&127\n if op==0x63 and not r['trap']:\n  taken=r['npc']\"'!=((r['\"'pc']+4)&0xffffffff)\n  bias=bool((i>>31)&1) if i&(1<<14) else bool(i&(1<<12))\n  idx=((r['pc']>>2)\"'^(r['\"'pc']>>7))&15\n  predict=bias \"'^ (table[idx]<2)\n  stats['\"'branches']+=1;stats['misses']+=predict\"'!=taken\n  if predict!=taken:pcs[r['\"'pc']]+=1\n  table[idx]=min(3,table[idx]+1) if taken==bias else max(0,table[idx]-1)\n if op==0x67:stats['jalr']+=1\nprint(json.dumps({'stats':dict(stats),'largest_branch_miss_counts':[(hex(k),v) for k,v in pcs.most_common(12)],'oob':cpu.oob_access},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
