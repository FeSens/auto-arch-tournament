FFFFFFFF),\n        (MUL(6, 4, 5), 0xFFFFFFFD, 0xFFFFFFFF, 3),\n        (ADD(7, 6, 5), 3, 0xFFFFFFFF, 2),\n        (MULH(8, 7, 2), 2, 0xFFFFFFFE, 0xFFFFFFFF),\n        (MULHU(9, 5, 2), 0xFFFFFFFF, 0xFFFFFFFE, 0xFFFFFFFD),\n        (MULHSU(0, 1, 2), 0xFFFFFFFF, 0xFFFFFFFE, 0),\n        (MUL(10, 0, 2), 0, 0xFFFFFFFE, 0),\n        (MUL(12, 12, 2), 3, 0xFFFFFFFE, 0xFFFFFFFA),\n        (MULH(13, 12, 2), 0xFFFFFFFA, 0xFFFFFFFE, 0),\n        (MULHSU(16, 14, 15), 0x80000000, 0xFFFFFFFF, 0x80000000),\n        (MULH(17, 14, 15), 0x800000\n…[11258 of 14330 chars elided by tools/bench/transcript.py; sha256:4d496ecb0d23e89c]…\n\n    assert int(dut.div_result_valid.value) and int(dut.div_result.value) == 14\n    for _ in range(5):\n        await tick(dut)\n        assert int(dut.div_result_valid.value) and int(dut.div_result.value) == 14\n\n    dut.stall.value = 0\n    await Timer(1, \"ns\")\n    assert not int(dut.execute_hold.value), \"completion must release the upstream hold\"\n    await tick(dut)\n    result = unpack(EX_FIELDS, int(dut.out.value))\n    assert result[\"valid\"] and result[\"alu_result\"] == 14\n    assert (result[\"rs1_val\"], result[\"rs2_val\"]) == (100, 7)\n    assert (result[\"pc\"], result[\"pc_next\"], result[\"rd\"]) == (0x80, 0x84, 3)\n    assert result[\"instr\"] == 0x0220C1B3\n    ctrl = unpack(CTRL_FIELDS, result[\"ctrl\"])\n    assert ctrl[\"reg_write\"] and not ctrl[\"mem_read\"] and not ctrl[\"mem_write\"]\n    dut[\"in\"].value = 0  # model ID/EX advancing on the result transfer edge\n    for _ in range(40):\n        await tick(dut)\n        assert not unpack(EX_FIELDS, int(dut.out.value))[\"valid\"]\n        assert not int(dut.div_active_q.value)\n\n", "exit_code": 0, "status": "completed"}}
