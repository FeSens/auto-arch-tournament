 Timer(1,unit='ns')\n            assert int(dut.out.value)==(expected&MASK),(op,hex(a),hex(b),hex(int(dut.out.value)),hex(expected&MASK))\n''')\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
