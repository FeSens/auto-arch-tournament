{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"sed -n '666,733p' cores/bench/test/test_pipeline.py; sed -n '1958,2078p' cores/bench/test/test_pipeline.py; sed -n '2190,2254p' cores/bench/test/test_pipeline.py; sed -n '1412,1453p' cores/bench/test/test_pipeline.py; cat cores/bench/test/conftest.py\"", "aggregated_output": "def _bubble_observer(dut):\n    \"\"\"Check ID/EX bubble/hold invariants and count accepted transactions.\"\"\"\n    stats = {\"reads\": [], \"writes\": [], \"launches\": [], \"load_bubbles\": 0,\n             \"dmem_holds\": 0, \"divider_unavailable\": 0,\n             \"redirect_unavailable\": 0, \"redirect_dmem_holds\": 0,\n             \"unavailable\": 0}\n    previous = None\n\n    def observe(cycle, ia, da, wen, ren, ir, dr):\n        nonlocal previous\n        state = int(dut.u_id.reg_q.value)\n        # id_ex_t ends with ctrl_t (22 bits), instr (32), valid (1).\n        controls = (state >> 33) & ((1 << 22) - 1)\n        assert state & 1 or controls == 0, \"invalid ID/EX retained live controls\"\n        # ex_mem_t stores fwd_ready immediately after effective_addr. Its\n        # 231 trailing bits retain the complete operand/control payload.\n        ex_state = int(dut.u_ex.reg_q.value)\n        ex_ctrl = (ex_state >> 33) & ((1 << 22) - 1)\n        ex_op = ex_ctrl >> 17\n        early = (ex_state >> 231) & 1\n        assert early == int(bool(ex_ctrl & 4) and not (ex_ctrl & 2)\n                            and ex_op not in (7, 8, 9, 11, 12, 13, 14))\n        if not (ex_state & 1):\n            assert not early, \"bubble retained early producer eligibility\"\n        if previous is None:\n            assert state == 0, \"ID/EX reset is not deterministic\"\n        elif previous[\"hold\"]:\n            assert state == previous[\"state\"], \"hold changed live ID/EX payload or controls\"\n        if previous and previous[\"execute_hold\"]:\n            assert ia == previous[\"pc\"], \"fetch PC advanced during divider hold\"\n\n        stall = int(dut.stall_id.value)\n        flush = int(dut.flush_id.value)\n        dhold = int(dut.hold_mem_wb.value)\n        ehold = int(dut.execute_hold.value)\n        redirect = int(dut.redirect.value)\n        if dhold or ehold:\n            assert stall and not flush, \"flush overrode a genuine pipeline hold\"\n        if flush and stall and not redirect:\n            stats[\"load_bubbles\"] += 1\n        stats[\"dmem_holds\"] += dhold\n        stats[\"unavailabl\n…[13261 of 16333 chars elided by tools/bench/transcript.py; sha256:1f01b34a94f4d591]…\nvalue)\n        if state & 1:\n            instr = (state >> 1) & 0xFFFFFFFF\n            if instr & 0x7F in (0x03, 0x23):\n                stats[\"selectors\"].setdefault(instr, set()).add(int(dut.fwd_rs1_sel.value))\n        if ren and dr:\n            stats[\"reads\"].append(da)\n        if wen and dr:\n            stats[\"writes\"].append((da, int(dut.io_dmemWData.value), wen))\n        stats[\"holds\"] += bool((wen or ren) and not dr)\n        stats[\"istalls\"] += not ir\n        previous = {\"hold\": bool(int(dut.hold_mem_wb.value)), \"ex\": ex, \"wb\": wb}\n\n    return stats, observe\n\n\n@cocotb.test()\nasync def effective_addresses_forwarded_load_store_widths_and_stalls(dut):\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n", "exit_code": 0, "status": "completed"}}
