{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport sys,json,struct,re,time\nfrom collections import Counter\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('/srv/hwebench/tmp/b57a151a/b6dfab37/predictor-coremark.elf')\nsizes=(8,16,32,64,128)\ntables={n:[None]*n for n in sizes}\nstats={n:Counter() for n in sizes}\nprofile=Counter(); active=False; marked=0;controls=Counter();begin=time.monotonic()\nfor step in range(10000000):\n r=cpu.step();pc=r['pc'];insn=r['insn'];op=insn&127\n if r['mem_wmask'] and r['mem_addr']==0x10000100:\n  active=True\n elif r['mem_wmask'] and r['mem_addr']==0x10000104:\n  active=False\n if active: marked+=1\n if op in (0x63,0x6f,0x67) and not r['trap']:\n  actual=r['npc']\"'!=((pc+4)&0xffffffff)\n  if active:\n   controls[(hex(op),'\"'taken' if actual else 'fallthrough')]+=1\n   profile[pc]+=int(actual)\n  direct=op\"'!=0x67\n  if direct:\n   if op==0x63:\n    imm=(((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1));imm=cpu.sx(imm,13)\n   else:\n    imm=(((insn>>31)<<20)|(((insn>>12)&255)<<12)|(((insn>>20)&1)<<11)|(((insn>>21)&1023)<<1));imm=cpu.sx(imm,21)\n   dest=(pc+imm)&0xffffffff\n   for n,table in tables.items():\n    idx=(pc>>2)&(n-1);entry=table[idx];hit=entry is not None and entry[0]==pc and entry[1]==insn\n    pred=hit and (op==0x6f or entry[2]>=2)\n    if active:\n     stats[n]['\"'direct_controls']+=1;stats[n]['hits']+=int(hit);stats[n]['mispredictions']+=int(pred\"'!=actual)\n     stats[n]['\"'net_bubbles_saved']+=int(actual)-int(pred\"'!=actual)\n    if dest&3==0:\n     ctr=(min(3,entry[2]+1) if actual else max(0,entry[2]-1)) if hit else (2 if actual else 1)\n     table[idx]=(pc,insn,ctr)\n if insn==0x00100073:break\nelse: raise RuntimeError('\"'did not complete')\nprint('Retired:',cpu.retired,'marked:',marked,'elapsed:',round(time.monotonic()-begin,3))\nprint('Control outcomes:',dict(controls))\nfor n in sizes:\n s=stats[n];cycles=4491817-s['net_bubbles_saved'];s['estimated_cycles']=cycles;s['required_mhz']=round(139.9025*cycles/10/1e6,3);s['rate_gain_pct']=round((4491817/cycles-1)*100,3)\n print('Table',n,dict(s))\nuart=cpu.uart_buf.decode('ascii','replace')\nfor val in ['0xe9f5','0xe714','0x1fd7','0x8e3a','0xfcaf','Correct operation validated.']:\n print('UART contains',repr(val),val in uart)\nprint('OOB:',cpu.oob_access,'top taken control PCs:',[(hex(pc),count) for pc,count in profile.most_common(15)])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
