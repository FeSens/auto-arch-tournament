{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor name,bidir in [('shift_right_shared',False),('shift_bidir',True)]:\n base=Path('cores/bench/generated')/name;rtl=base/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n p=rtl/'alu.sv';t=p.read_text();pos=t.index('  always_comb begin')\n if not bidir:\n  new='''  logic signed [32:0] right_input;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [32:0] right_result;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign right_input = \"'$signed({(op == ALU_SRA) && a[31], a});\n  assign right_result = right_input >>> b[4:0];\n\n'\"'''\n  t=t[:pos]+new+t[pos:];t=t.replace('      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','      ALU_SRL, ALU_SRA: out = right_result[31:0];')\n else:\n  new='''  logic [31:0] reversed_a, shift_input, shifted_word, reversed_shift;\n  logic shift_left;\n  logic signed [32:0] right_input;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [32:0] right_result;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign shift_left = op == ALU_SLL;\n  for (genvar i=0;i<32;i++) begin : shift_reverse\n    assign reversed_a[i] = a[31-i];\n    assign reversed_shift[i] = right_result[31-i];\n  end\n  assign shift_input = shift_left ? reversed_a : a;\n  assign right_input = \"'$signed({(op == ALU_SRA) && a[31], shift_input});\n  assign right_result = right_input >>> b[4:0];\n  assign shifted_word = shift_left ? reversed_shift : right_result[31:0];\n\n'\"'''\n  t=t[:pos]+new+t[pos:];t=t.replace('      ALU_SLL:    out = a << shamt;\\\\n      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','      ALU_SLL, ALU_SRL, ALU_SRA: out = shifted_word;').replace('  logic        [4:0]  shamt;','').replace('    shamt = b[4:0];','')\n p.write_text(t)\nprint('Prepared shared right-shift and bidirectional combinational shifter probes.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
