   if not marker.get('ebreak', False):\n        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n        # a hung CPU with whatever cycle count it happened to reach.\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': 'maxcycles_hit_before_ebreak'}\n\n    # OOB sticky flag from the sim:\n…[3186 of 6258 chars elided by tools/bench/transcript.py; sha256:5406fd4b58807cd9]…\nce_option {place_option}\",\n        \"set_option -gen_text_timing_rpt 1\",\n        \"run all\",\n        \"\",\n    ])\n\n\n_MAXF = re.compile(r\"^\\s*\\d+\\s+\\S+\\s+[\\d.]+\\(MHz\\)\\s+([\\d.]+)\\(MHz\\)\\s+(\\d+)\", re.M)\n\n\ndef _cells(rpt: str, name: str) -> int | None:\n6:  2. CoreMark CRC validation via the sim's UART capture — full-trace cosim\n11:     catches any CPU bug that affects CoreMark output without the full trace\n24:def _build_cosim_env(worktree, target: str | None,\n44:# memory port stalls (which V2 now times and scores) is trace-checked too.\n48:def run_one(elf: Path, sim_bin: str, worktree: str, env: dict | None = None,\n70:def run_coremark_crc(coremark_elf: Path, sim_bin: str, worktree: str, env: dict | None = None) -> dict:\n74:    computational bug since CoreMark's CRC is computed over every algorithm's\n125:def run_cosim(worktree: str, target: str | None = None) -> dict:\n169:    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n171:        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n", "exit_code": 0, "status": "completed"}}
