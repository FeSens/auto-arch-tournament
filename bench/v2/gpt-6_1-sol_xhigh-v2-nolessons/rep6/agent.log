{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os,random,subprocess\ns=Path(os.environ['TMPDIR'])/'r5s0_dsp_probe'\nr=random.Random(505)\nedges=[0,1,2,0xffffffff,0x80000000,0x7fffffff,0xffff0000,0x10000,0xaaaaaaaa,0x55555555]\npairs=[(a,b) for a in edges for b in edges]+[(r.getrandbits(32),r.getrandbits(32)) for _ in range(5000)]\nwith (s/'vectors.txt').open('w') as f:\n for a,b in pairs:\n  for op in [11,12,13,14]:\n   aa=a-(1<<32) if op in [12,14] and a>>31 else a\n   bb=b-(1<<32) if op==12 and b>>31 else b\n   p=aa*bb\n   out=(p if op==11 else p>>32)&0xffffffff\n   f.write(f'{a:08x} {b:08x} {op:02x} {out:08x}\\\\n')\n(s/'tb.sv').write_text('''module tb;\nreg [31:0] a,b,expected;\nreg [4:0] op;\nwire [31:0] out;\ninteger f,rc,n;\nGSR GSR (.GSRI(1'b1));\nalu dut(.op(op),.a(a),.b(b),.out(out));\ninitial begin\nf=\"'$fopen(\"vectors.txt\",\"r\"); n=0;\nwhile (!$feof(f)) begin\nrc=$fscanf(f,\"%h %h %h %h'\"\\\\\\\\n\\\",a,b,op,expected);\nif(rc==4) begin\n#1;\nif(out \"'!== expected) $fatal(1,\"mismatch op=%d a=%h b=%h got=%h expected=%h\",op,a,b,out,expected);\nn=n+1;\nend\nend\n$display(\"Vendor DSP model passed %0d exact multiplication vectors\",n);\n$finish;\nend\nendmodule\n'\"''')\ncmd=['iverilog','-g2012','-DSYNTHESIS','-s','tb','-o',str(s/'tb.vvp'),str(s/'rtl/core_pkg.sv'),str(s/'rtl/alu.sv'),'/opt/gowin/IDE/simlib/gw2a/prim_sim.v',str(s/'tb.sv')]\np=subprocess.run(cmd,cwd=s,capture_output=True,text=True)\nprint('compile',p.returncode,p.stderr[-2000:])\nif p.returncode==0:\n p=subprocess.run(['vvp',str(s/'tb.vvp')],cwd=s,capture_output=True,text=True)\n print('simulation',p.returncode,p.stdout,p.stderr[-1000:])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
