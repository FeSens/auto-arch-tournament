 $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/pro\n…[4962 of 8034 chars elided by tools/bench/transcript.py; sha256:8398a9d545ed4c0a]…\nrce npc = pc + 4 so the trace stays in\n        lockstep with the DUT (which suppresses redirects + reg/mem\n        commits on misalign / illegal).\"\"\"\n        if trap:\n            wrd = wval = 0\n            mem_addr = mem_rmask = mem_wmask = 0\n            mem_rdata = mem_wdata = 0\n            npc = (pc + 4) & MASK\n        if wrd:\n            self.regs[wrd] = wval\n        self.regs[0] = 0\n        self.pc = npc\n        out = {\n            'order': self.retired, 'pc': pc, 'npc': npc, 'insn': instr,\n            'rd': wrd, 'rd_wdata': wval if wrd else 0,\n            'rs1': rs1, 'rs1_rdata': rs1_rdata_pre,\n            'rs2': rs2, 'rs2_rdata': rs2_rdata_pre,\n            'mem_addr': mem_addr, 'mem_rmask': mem_rmask, 'mem_rdata': mem_rdata,\n            'mem_wmask': mem_wmask, 'mem_wdata': mem_wdata,\n            'trap': trap, 'halt': 0, 'intr': 0, 'mode': 3, 'ixl': 1,\n        }\n        self.retired += 1\n        return out\n\n    def step(self) -> Optional[dict]:\n        instr = self.rw(self.pc)\n        op  = instr & 0x7F\n", "exit_code": 0, "status": "completed"}}
