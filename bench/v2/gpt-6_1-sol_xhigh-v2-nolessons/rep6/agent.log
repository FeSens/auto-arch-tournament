m >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm\n…[22501 of 25573 chars elided by tools/bench/transcript.py; sha256:c71ebf37c588cade]…\non(dut):\n    await setup(dut)\n    dut[\"in\"].value = payload(valid=0)\n    for _ in range(40):\n        await tick(dut)\n        assert not int(dut.execute_hold.value) and not int(dut.div_req_valid.value)\n        assert not int(dut.div_active_q.value)\n    dut[\"in\"].value = payload()\n    await tick(dut)\n    assert int(dut.div_active_q.value)\n    for _ in range(12):\n        await tick(dut)\n    dut.reset.value = 1\n    await Timer(1, \"ns\")\n    assert not int(dut.execute_hold.value) and not int(dut.div_req_valid.value)\n    await tick(dut)\n    assert int(dut.out.value) == 0 and not int(dut.div_active_q.value)\n    dut[\"in\"].value = payload(valid=0)\n    dut.reset.value = 0\n    for _ in range(40):\n        await tick(dut)\n        assert not int(dut.div_result_valid.value)\n        assert not unpack(EX_FIELDS, int(dut.out.value))[\"valid\"]\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"divider.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
