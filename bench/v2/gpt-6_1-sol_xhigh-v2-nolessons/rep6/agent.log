{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('/srv/hwebench/tmp/b57a151a/06db53ca/predictor_r15')\nprobe.mkdir(parents=True,exist_ok=True)\nshutil.copytree('cores/bench/rtl',probe/'rtl',dirs_exist_ok=True)\np=probe/'rtl/if_stage.sv'\ns=p.read_text()\nstart=s.index('  // Exact modulo-2\"'^32 direct additions.'\"')\nend=s.index('  assign pc_plus4 = pc + 32\\\\'d4;',start)\ns=s[:start]+'''  logic [31:0] prediction_offset, prediction_target;\n  wire [7:0] block_p, block_g;\n  wire [7:0] prefix_p1, prefix_g1, prefix_p2, prefix_g2, prefix_p4, prefix_g4;\n  wire [7:0] block_c;\n  wire [31:0] sum0, sum1;\n  // Bit 3 distinguishes BRANCH (0x63) and JAL (0x6f).\n  assign prediction_offset = imem_data[3]\n    ? {{11{imem_data[31]}}, imem_data[31], imem_data[19:12],\n       imem_data[20], imem_data[30:21], 1'b0}\n    : {{19{imem_data[31]}}, imem_data[31], imem_data[7],\n       imem_data[30:25], imem_data[11:8], 1'b0};\n  for (genvar k=0; k<8; k++) begin : g_prediction_blocks\n    wire [4:0] z, o;\n    assign z = {1'b0,pc[4*k +: 4]} + {1'b0,prediction_offset[4*k +: 4]};\n    assign o = {1'b0,pc[4*k +: 4]} + {1'b0,prediction_offset[4*k +: 4]} + 5'd1;\n    assign sum0[4*k +: 4] = z[3:0];\n    assign sum1[4*k +: 4] = o[3:0];\n    assign block_g[k] = z[4];\n    assign block_p[k] = &(pc[4*k +: 4] \"'^ prediction_offset[4*k +: 4]);\n    if (k == 0) begin\n      assign prefix_p1[k] = block_p[k];\n      assign prefix_g1[k] = block_g[k];\n    end else begin\n      assign prefix_p1[k] = block_p[k] & block_p[k-1];\n      assign prefix_g1[k] = block_g[k] | (block_p[k] & block_g[k-1]);\n    end\n    if (k < 2) begin\n      assign prefix_p2[k] = prefix_p1[k];\n      assign prefix_g2[k] = prefix_g1[k];\n    end else begin\n      assign prefix_p2[k] = prefix_p1[k] & prefix_p1[k-2];\n      assign prefix_g2[k] = prefix_g1[k] | (prefix_p1[k] & prefix_g1[k-2]);\n    end\n    i