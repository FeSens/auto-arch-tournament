{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nimport shutil,subprocess\nrepo=Path.cwd();probe=Path('/srv/hwebench/tmp/b57a151a/2d5114cf/predictor_probe')\nrf=probe/'riscv-formal'\nshutil.copytree(repo/'formal/riscv-formal',rf,ignore=shutil.ignore_patterns('.git','cores','__pycache__'),dirs_exist_ok=True)\ncore=rf/'cores/probe';core.mkdir(parents=True,exist_ok=True)\nfor p in (probe/'rtl').glob('*.sv'):shutil.copy2(p,core/p.name)\nshutil.copy2(repo/'formal/wrapper_si.sv',core/'wrapper.sv')\ncfg=(repo/'formal/checks_si.cfg').read_text().split('[verilog-files]')[0]+'[verilog-files]\\\\n'\nfiles=[core/'core_pkg.sv']+[p for p in sorted(core.glob('*.sv')) if p.name not in ('core_pkg.sv','wrapper.sv')]+[core/'wrapper.sv']\ncfg+='\\\\n'.join('@basedir@/cores/@core@/'+p.name for p in files)+'\\\\n'\n(core/'checks.cfg').write_text(cfg)\nsubprocess.run(['python3','../../checks/genchecks.py'],cwd=core,check=True,stdout=(probe/'formal_gen.log').open('w'),stderr=subprocess.STDOUT)\nwith (probe/'formal_run.log').open('w') as out:\n r=subprocess.run(['make','-j8','-k','-f','makefile'],cwd=core/'checks',stdout=out,stderr=subprocess.STDOUT,timeout=650)\nprint('Formal returncode',r.returncode)\npassed=[];other=[]\nfor p in sorted((core/'checks').glob('*.sby')):\n log=p.with_suffix('')/'logfile.txt'\n (passed if log.exists() and 'DONE (PASS' in log.read_text() else other).append(p.stem)\nprint('Formal passed',len(passed),'other',other)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
