{"type":"item.completed","item":{"id":"item_21","type":"agent_message","text":"The replay model also puts a low ceiling on accuracy gains: it estimates 46,315 conditional misses, worth about 2.1% of champion cycles even if all were removed. I’m focusing the replacement on prediction-validation timing: move the entire conditional comparison behind EX/MEM, so it no longer loads the forwarded operands feeding the critical EX arithmetic path. This differs from round 13’s partial-comparison retiming."}}
{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/b57a151a/faf3b517/predictor-profile/memvalidate/rtl')\np.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,p/f.name)\nf=p/'ex_stage.sv';s=f.read_text()\ns=s.replace('rs1[8*lane +: 8]', 'reg_q.rs1_val[8*lane +: 8]').replace('rs2[8*lane +: 8]', 'reg_q.rs2_val[8*lane +: 8]')\ns=s.replace('{rs1[31] \"'^ !in.ctrl.branch_op[1], rs1[30:24]}'\"','{reg_q.rs1_val[31] \"'^ !reg_q.ctrl.branch_op[1], reg_q.rs1_val[30:24]}'\"')\ns=s.replace('{rs2[31] \"'^ !in.ctrl.branch_op[1], rs2[30:24]}'\"','{reg_q.rs2_val[31] \"'^ !reg_q.ctrl.branch_op[1], reg_q.rs2_val[30:24]}'\"')\ns=s.replace('assign branch_base = in.ctrl.branch_op[2]', 'assign branch_base = reg_q.ctrl.branch_op[2]')\ns=s.replace('assign branch_polarity = in.ctrl.branch_op[0];','assign branch_polarity = reg_q.ctrl.branch_op[0];')\ns=s.replace('assign recovery_polarity = in.ctrl.branch_op[0] \"'^ in.predicted_taken;'\"', 'assign recovery_polarity = recovery_polarity_q;')\ns=s.replace('logic        branch_base, branch_polarity, recovery_polarity, branch_mismatch;', 'logic        branch_base, branch_polarity, recovery_polarity, branch_mismatch;\\\\n  logic conditional_valid_q, recovery_polarity_q, bias_q;')\ns=s.replace('branch_taken  = in.ctrl.is_branch && branch_cond;', 'branch_taken  = 1\\\\'b0;')\ns=s.replace('misalign_branch = in.ctrl.is_branch && branch_taken\\\\n                      && (branch_target[1:0] \"'!= 2'\"\\\\'b00);', 'misalign_branch = 1\\\\'b0;')\ns=s.replace('((in.ctrl.is_branch && branch_target[1:0] == 2\\\\'b00 && branch_mismatch) ||\\\\n                     (in.ctrl.is_jump', '((in.ctrl.is_jump')\ns=s.replace('recovery_valid_q <= 1\\\\'b0;\\\\n      recovery_target_q', 'recovery_valid_q <= 1\\\\'b0;\\\\n      conditional_valid_q <= 1\\\\'b0;\\\\n      recovery_polarity_q <= 1\\\\'b0;\\\\n      bias_q <= 1\\\\'b0;\\\\n      recovery_target_q')\ns=s.replace('recovery_valid_q <= recovery_valid;\\\\n      recovery_target_q', 'recovery_valid_q <= recovery_valid;\\\\n      conditional_valid_q <= advance_ex && in.valid && \"'!in.ctrl.is_illegal &&'\"\\\\n                             in.ctrl.is_branch && (branch_target[1:0] == 2\\\\'b00);\\\\n      recovery_polarity_q <= in.ctrl.branch_op[0] \"'^ in.predicted_taken;'\"\\\\n      bias_q <= in.instr[14] ? in.instr[31] : in.instr[12];\\\\n      recovery_target_q')\ns=s.replace('assign redirect = \"'!reset && !stall && recovery_valid_q;'\"', 'assign redirect = \"'!reset && !stall && (recovery_valid_q || (conditional_valid_q && branch_mismatch));'\"')\na=s.index('  predictor_train_t train_q;');b=s.index('  // ── EX/MEM register',a)\ns=s[:a]+'''  always_comb begin\n    train.index = reg_q.pc[5:2] \"'^ reg_q.pc[10:7];\n    train.agree = (branch_cond == bias_q);\n    train.valid = conditional_valid_q;\n  end\n\n'\"'''+s[b:]\ns=s.replace('if (recovery_valid) assert (recovery_target == normal_payload.pc_next);', 'if (recovery_valid) assert (recovery_target == normal_payload.pc_next);')\ns=s.replace('if (redirect) assert (redirect_target == reg_q.pc_next && reg_q.valid);', 'if (redirect) assert (reg_q.valid && (conditional_valid_q ?\\\\n      redirect_target == (branch_cond ? reg_q.branch_target : reg_q.pc + 32\\\\'d4) : redirect_target == reg_q.pc_next));')\nf.write_text(s)\nf=p/'mem_stage.sv';s=f.read_text()\nx='''  logic conditional_taken, conditional_fault;\n  always_comb begin\n    conditional_taken = 1'b0;\n    case (in.ctrl.branch_op)\n      BR_BEQ: conditional_taken = in.rs1_val == in.rs2_val;\n      BR_BNE: conditional_taken = in.rs1_val \"'!= in.rs2_val;\n      BR_BLT: conditional_taken = $signed(in.rs1_val) < $signed(in.rs2_val);\n      BR_BGE: conditional_taken = $signed(in.rs1_val) >= $signed(in.rs2_val);\n      BR_BLTU: conditional_taken = in.rs1_val < in.rs2_val;\n      BR_BGEU: conditional_taken = in.rs1_val >= in.rs2_val;\n      default: conditional_taken = 1'\"'b0;\n    endcase\n    conditional_fault = in.ctrl.is_branch && conditional_taken && in.branch_target[1:0] \"'!= 2'\"'b00;\n  end\n\n'''\ns=s.replace('  // ── MEM/WB register',x+'  // ── MEM/WB register')\ns=s.replace('reg_q.pc_next    <= in.pc_next;', 'reg_q.pc_next    <= in.ctrl.is_branch ?\\\\n         (conditional_taken && \"'!conditional_fault ? in.branch_target : in.pc + 32'\"\\\\'d4) : in.pc_next;')\ns=s.replace('reg_q.ctrl       <= ctrl_with_trap;', 'reg_q.ctrl       <= ctrl_with_trap;\\\\n      reg_q.ctrl.is_illegal <= ctrl_with_trap.is_illegal || conditional_fault;')\nf.write_text(s)\nprint('Private full-MEM-validation prototype written')\nPY\nverilator --lint-only --top-module core -Wall -Wno-fatal -Wno-style +incdir+/srv/hwebench/tmp/b57a151a/faf3b517/predictor-profile/memvalidate/rtl /srv/hwebench/tmp/b57a151a/faf3b517/predictor-profile/memvalidate/rtl/core_pkg.sv /srv/hwebench/tmp/b57a151a/faf3b517/predictor-profile/memvalidate/rtl/*.sv\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
