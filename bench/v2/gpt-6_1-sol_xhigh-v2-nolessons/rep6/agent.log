{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('/srv/hwebench/tmp/b57a151a/aa817689/late_shift')\nr=Path('/srv/hwebench/tmp/b57a151a/aa817689/late_shift_fast')\nr.mkdir(exist_ok=True)\nfor d in ('rtl','test'):shutil.copytree(src/d,r/d,dirs_exist_ok=True)\nrtl=r/'rtl'\np=rtl/'core_pkg.sv';s=p.read_text().replace('    logic [31:0] imm;\\\\n', '    logic [31:0] imm;\\\\n    logic        shift_early;\\\\n    logic        shift_two;\\\\n');s=s.replace('    logic [4:0]  shift_amount;', '    logic        shift_late;\\\\n    logic [4:0]  shift_amount;');p.write_text(s)\np=rtl/'id_stage.sv';s=p.read_text().replace(\\\"      reg_q.imm      <= '0;\\\", \\\"      reg_q.imm      <= '0;\\\\n      reg_q.shift_early <= 1'b0;\\\\n      reg_q.shift_two <= 1'b0;\\\");s=s.replace('      reg_q.imm      <= imm;', '''      reg_q.imm      <= imm;\n      reg_q.shift_early <= dec_alu_src &&\n        (dec_alu_op == ALU_SLL || dec_alu_op == ALU_SRL || dec_alu_op == ALU_SRA) &&\n        (in.instr[24:20] == 5'd1 || in.instr[24:20] == 5'd2);\n      reg_q.shift_two <= (in.instr[24:20] == 5'd2);''');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text().replace('  logic [31:0] alu_result;', '''  logic [31:0] alu_result;\n  logic [31:0] early_shift_result;\n  logic shift_sign;\n  always_comb begin\n    shift_sign = (in.ctrl.alu_op == ALU_SRA) && rs1[31];\n    if (in.ctrl.alu_op == ALU_SLL)\n      early_shift_result = in.shift_two ? {rs1[29:0], 2'b0} : {rs1[30:0], 1'b0};\n    else\n      early_shift_result = in.shift_two ? {{2{shift_sign}}, rs1[31:2]} : {shift_sign, rs1[31:1]};\n  end\n''');s=s.replace(\\\"normal_payload.alu_result    = in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\\\", \\\"normal_payload.alu_result    = in.shift_early ? early_shift_result : in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\\\")\ns=s.replace('\"'!(in.ctrl.alu_op == ALU_SLL || in.ctrl.alu_op == ALU_SRL ||'\"\\\\n                                    in.ctrl.alu_op == ALU_SRA || in.ctrl.alu_op == ALU_MUL ||', '''\"'!(!in.shift_early && (in.ctrl.alu_op == ALU_SLL || in.ctrl.alu_op == ALU_SRL ||\n                                                       in.ctrl.alu_op == ALU_SRA)) &&\n                                  !(in.ctrl.alu_op == ALU_MUL ||'\"''')\ns=s.replace('normal_payload.shift_amount = alu_b[4:0];', '''normal_payload.shift_late = \"'!in.shift_early &&\n      (in.ctrl.alu_op == ALU_SLL || in.ctrl.alu_op == ALU_SRL || in.ctrl.alu_op == ALU_SRA);\n    normal_payload.shift_amount = alu_b[4:0];'\"''');p.write_text(s)\np=rtl/'mem_stage.sv';s=p.read_text().replace('assign is_shift = in.valid && \"'!in.ctrl.is_illegal &&'\"', 'assign is_shift = in.valid && \"'!in.ctrl.is_illegal && in.shift_late &&'\"');p.write_text(s)\np=rtl/'core.sv';s=p.read_text().replace('assign id_ex_shift = id_ex_w.valid && \"'!id_ex_w.ctrl.is_illegal &&'\"', 'assign id_ex_shift = id_ex_w.valid && \"'!id_ex_w.ctrl.is_illegal && !id_ex_w.shift_early &&'\"');p.write_text(s)\np=r/'test/test_ex_stage.py';s=p.read_text().replace('(\\\"imm\\\", 32),', '(\\\"imm\\\", 32), (\\\"shift_early\\\", 1), (\\\"shift_two\\\", 1),').replace('(\\\"shift_amount\\\", 5),', '(\\\"shift_late\\\", 1), (\\\"shift_amount\\\", 5),');p.write_text(s)\nprint(r)\nPY\npython - <<'PY'\nfrom tools.eval.gowin import build,summarize\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json\nroot=Path('/srv/hwebench/tmp/b57a151a/aa817689/late_shift_fast')\nwith ThreadPoolExecutor(max_workers=3) as e:\n fs=[e.submit(build,Path.cwd(),root/'rtl','fpga/core_bench_si.sv',p,root/f'gowin_p{p}') for p in (0,1,2)]\n rs=[f.result() for f in fs]\nr=summarize(rs)\n(root/'timing.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(r,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
