{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm\n…[7368 of 10440 chars elided by tools/bench/transcript.py; sha256:35d65bcbeb11132f]…\n,        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Execute address generation, forwarding, and retained divider completion.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_ADD, ALU_SUB, ALU_AND, ALU_SLT, ALU_SLL, ALU_LUI,\n                      ALU_DIV, ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb)\n\nCTRL_FIELDS = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n               (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n               (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n               (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n               (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_FIELDS = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"effective_addr\", 32),\n             (\"fwd_ready\", 1), (\"write_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n             (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef pack(fields, values):\n    bits = 0\n    for name, width in fields:\n        bits = (bits << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return bits\n\n\ndef unpack(fields, bits):\n    values = {}\n    for name, width in reversed(fields):\n        values[name] = bits & ((1 << width) - 1)\n        bits >>= width\n    return values\n\n\ndef payload(op=ALU_DIV, valid=1, imm=0):\n    return pack(ID_FIELDS, {\n        \"pc\": 0x80, \"rs1_val\": 1, \"rs2_val\": 2, \"imm\": imm, \"rd\": 3,\n        \"rs1_addr\": 1, \"rs2_addr\": 2, \"instr\": 0x0220C1B3,\n        \"valid\": valid, \"ctrl\": pack(CTRL_FIELDS, {\"alu_op\": op, \"reg_write\": 1}),\n    })\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def setup(dut):\n    dut.clock.value = 0\n    dut.reset.v\n…[9560 of 12632 chars elided by tools/bench/transcript.py; sha256:636a70f7831557c9]…\nr in (0, 1, 2):\n        dut.fwd_rs1_sel.value = selector\n        dut.fwd_ex_mem.value = base\n        dut.fwd_mem_wb.value = base\n        for controls, result in cases:\n            controls = dict(controls, reg_write=1)\n            dut[\"in\"].value = pack(ID_FIELDS, {\n                \"pc\": pc, \"rs1_val\": base if selector == 0 else 0xBAD0BAD0,\n                \"rs2_val\": rs2, \"imm\": imm, \"rd\": 3, \"valid\": 1,\n                \"ctrl\": pack(CTRL_FIELDS, controls),\n            })\n            await tick(dut)\n            out = unpack(EX_FIELDS, int(dut.out.value))\n            assert out[\"effective_addr\"] == (base + imm) & 0xFFFFFFFF\n            assert out[\"alu_result\"] == result & 0xFFFFFFFF\n            assert out[\"alu_result\"] != out[\"effective_addr\"]\n            assert out[\"fwd_ready\"] and out[\"ctrl\"] == pack(CTRL_FIELDS, controls)\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"divider.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
