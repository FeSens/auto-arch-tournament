{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json,subprocess\nfrom tools.eval.fpga import validate_coremark_uart\np=Path('/srv/hwebench/tmp/b57a151a/d31a4914/fetch_probe'); b=str(p/'obj_raw/cosim_sim')\nfor flags in [[],['--istall','--dstall']]:\n r=subprocess.run(['python','test/cosim/run_cosim.py',b,'bench/programs/selftest.elf',*flags],capture_output=True,text=True)\n print('selftest',flags,r.returncode,r.stdout.strip(),flush=True)\nr=subprocess.run([b,'bench/programs/coremark.elf','50000000','--bench','--istall','--dstall'],capture_output=True,text=True)\n(p/'coremark_raw.jsonl').write_text(r.stdout); d=json.loads(r.stdout.splitlines()[-1])\nprint('CoreMark',r.returncode,'marked_cycles',d['bench_stop_cycle']-d['bench_start_cycle'],'CRC',validate_coremark_uart(d.get('uart',''),10),'oob',d.get('oob'),'ebreak',d.get('ebreak'),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
