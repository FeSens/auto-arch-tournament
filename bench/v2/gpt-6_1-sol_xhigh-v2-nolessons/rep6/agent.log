{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nbase=Path(os.environ['TMPDIR'])/'hypgen-r6s0'\nfor kind in ('onehot','wbretime_onehot'):\n p=base/kind; src=base/'wbretime' if kind.startswith('wbretime') else Path('cores/bench')\n for name in ('rtl','test'): shutil.copytree(src/name,p/name,dirs_exist_ok=True)\n f=p/'rtl/forward_unit.sv'; s=f.read_text()\n s=s.replace('  output logic [1:0] fwd_rs2\\\\n','  output logic [1:0] fwd_rs2,\\\\n  output logic [2:0] rs1_mask,\\\\n  output logic [2:0] rs2_mask\\\\n')\n pos=s.index('  // Current controls include')\n s=s[:pos]+'''  always_comb begin\n    rs1_mask[1] = ex_mem_w_en && rs1_ex_match_q;\n    rs1_mask[2] = mem_wb_w_en && rs1_wb_match_q && \"'!rs1_mask[1];\n    rs1_mask[0] = !(rs1_mask[1] || (mem_wb_w_en && rs1_wb_match_q));\n    rs2_mask[1] = ex_mem_w_en && rs2_ex_match_q;\n    rs2_mask[2] = mem_wb_w_en && rs2_wb_match_q && !rs2_mask[1];\n    rs2_mask[0] = !(rs2_mask[1] || (mem_wb_w_en && rs2_wb_match_q));\n  end\n\n'\"'''+s[pos:]\n f.write_text(s)\n f=p/'rtl/ex_stage.sv'; s=f.read_text()\n s=s.replace('  input  logic [1:0]         fwd_rs2_sel,','  input  logic [1:0]         fwd_rs2_sel,\\\\n  input  logic [2:0]         rs1_mask,\\\\n  input  logic [2:0]         rs2_mask,')\n start=s.index('  always_comb begin\\\\n    case (fwd_rs1_sel)'); end=s.index('  // ── ALU operand selection',start)\n s=s[:start]+'''  always_comb begin\n    rs1 = ({32{rs1_mask[0]}} & in.rs1_val) |\n          ({32{rs1_mask[1]}} & fwd_ex_mem) |\n          ({32{rs1_mask[2]}} & fwd_mem_wb);\n    rs2 = ({32{rs2_mask[0]}} & in.rs2_val) |\n          ({32{rs2_mask[1]}} & fwd_ex_mem) |\n          ({32{rs2_mask[2]}} & fwd_mem_wb);\n  end\n\n'''+s[end:]\n # Preserve selector ports for unit-test observations; encoded values are no longer used for muxing.\n s=s.replace('  input  logic [1:0]         fwd_rs1_sel,','  /* verilator lint_off UNUSEDSIGNAL */\\\\n  input  logic [1:0]         fwd_rs1_sel,')\n s=s.replace('  input  logic [1:0]         fwd_rs2_sel,','  input  logic [1:0]         fwd_rs2_sel,\\\\n  /* verilator lint_on UNUSEDSIGNAL */')\n f.write_text(s)\n f=p/'rtl/core.sv'; s=f.read_text()\n s=s.replace('  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n  logic [2:0] rs1_mask, rs2_mask;')\n s=s.replace('    .fwd_rs2_sel     (fwd_rs2_sel),','    .fwd_rs2_sel     (fwd_rs2_sel),\\\\n    .rs1_mask        (rs1_mask),\\\\n    .rs2_mask        (rs2_mask),')\n s=s.replace('    .fwd_rs2     (fwd_rs2_sel)\\\\n','    .fwd_rs2     (fwd_rs2_sel),\\\\n    .rs1_mask    (rs1_mask),\\\\n    .rs2_mask    (rs2_mask)\\\\n')\n f.write_text(s)\n print('Created',kind)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
