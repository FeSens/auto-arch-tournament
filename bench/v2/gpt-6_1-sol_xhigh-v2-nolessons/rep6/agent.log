{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys, struct, time\nfrom pathlib import Path\nfrom collections import Counter\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM(); cpu.load_elf('bench/programs/coremark.elf')\ntrace=bytearray(); marked=False; counts=Counter(); started=time.monotonic()\nfor n in range(5000000):\n r=cpu.step()\n if r['mem_wmask'] and r['mem_addr']==0x10000100: marked=True\n if r['mem_wmask'] and r['mem_addr']==0x10000104: marked=False\n insn=r['insn']; op=insn&127\n if op==0x63 and not r['trap']:\n  a=r['rs1_rdata']; b=r['rs2_rdata']; f=(insn>>12)&7\n  sa=(a\"'^0x80000000)-0x80000000; sb=(b''^0x80000000)-0x80000000\n  taken={0:a==b,1:a!=b,4:sa<sb,5:sa>=sb,6:a<b,7:a>=b}[f]\n  trace+=struct.pack('\"'<IIBB',r['pc'],insn,taken,marked)\n if marked:\n  counts['instructions']+=1; counts[hex(op)]+=1\n if insn==0x00100073: break\nPath('/srv/hwebench/tmp/b57a151a/aea12141/predictor_branches.bin').write_bytes(trace)\nprint(dict(counts));print('branch_records',len(trace)//10,'seconds',round(time.monotonic()-started,2),'oob',cpu.oob_access)\nprint(cpu.uart_buf.decode(errors='replace')[-2000:])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
