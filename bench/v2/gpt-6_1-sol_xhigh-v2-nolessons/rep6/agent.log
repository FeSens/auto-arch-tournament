{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/b57a151a/aa817689/late_shift_fast/test/test_pipeline.py')\ns=p.read_text();marker='def test_pipeline_runner():'\naddition='''@cocotb.test()\nasync def shift_split_all_amounts_dependencies_and_stalls(dut):\n    import random\n    a = (-127) & 0xffffffff\n    for mode in ('sll', 'srl', 'sra'):\n        for immediate in (False, True):\n            for amount in range(32):\n                funct3 = 1 if mode == 'sll' else 5\n                funct7 = 32 if mode == 'sra' else 0\n                insn = (_i((0x400 if mode == 'sra' else 0) | amount, 1, funct3, 3, 0x13)\n                        if immediate else _r(funct7, 2, 1, funct3, 3, 0x33))\n                expected = ((a << amount) if mode == 'sll' else\n                            (a >> amount) if mode == 'srl' else (-127 >> amount)) & 0xffffffff\n                program = [ADDI(1, 0, -127), ADDI(2, 0, amount + 32), insn,\n                           ADDI(4, 3, 1), SW(4, 0, 0x100), EBREAK()]\n                for stalled in (False, True):\n                    rng = random.Random(1000 + amount)\n                    def ready(*args):\n                        return (int(rng.randrange(100) >= 22), int(rng.randrange(100) >= 22))\n                    retires, memory = await _run(dut, program, max_cycles=1000,\n                                                 ready=ready if stalled else None)\n                    assert len(retires) == len(program)\n                    shifted = next(r for r in retires if r['pc'] == 8)\n                    consumer = next(r for r in retires if r['pc'] == 12)\n                    assert shifted['rd_wdata'] == expected, (mode, immediate, amount, shifted)\n                    assert shifted['rs1_rdata'] == a\n                    assert shifted['rs2_rdata'] == ((amount + 32) if not immediate else 0)\n                    assert consumer['rd_wdata'] == ((expected + 1) & 0xffffffff)\n                    assert consumer['rs1_rdata'] == expected\n                    assert memory[0x100] == ((expected + 1) & 0xffffffff)\n                    if not stalled:\n                        early = immediate and amount in (1, 2)\n                        assert consumer['cycle'] - shifted['cycle'] == (1 if early else 2)\n                    assert [r['order'] for r in retires] == list(range(len(program)))\n                    assert not any(r['trap'] for r in retires)\n\n\n'''\n# For immediate forms, raw instruction rs2_addr is amount, and that register\n# can be x1/x2/x3/x4; require its exact pre-retirement value through RVFI.\naddition=addition.replace(\\\"assert shifted['rs2_rdata'] == ((amount + 32) if not immediate else 0)\\\", \\\"assert shifted['rs2_rdata'] == ((amount + 32) if not immediate or amount == 2 else a if amount == 1 else 0)\\\")\nassert marker in s;s=s.replace(marker,addition+marker);p.write_text(s)\nPY\npytest --rootdir=. --confcutdir=. -q test/test_pipeline.py::test_pipeline_runner > shift_unit.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
