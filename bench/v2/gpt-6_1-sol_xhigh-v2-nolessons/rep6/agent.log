           assert (ret[\"rd\"], ret[\"rd_wdata\"], ret[\"mem_rmask\"], ret[\"mem_wmask\"]) == (0, 0, 0, 0)\n    for instr, result in ((ADD(6, 5, 5), 46), (ADD(7, 5, 5), 58),\n                          (ADD(8, 5, 5), 58), (ADD(9, 5, 5), 58)):\n        [ret] = _by_insn(rets, instr)\n        assert ret[\"rd_wdata\"] == result\n    assert selectors[ADD(6, 5, 5)] == (2, 2), \"trapped younger JAL must\n…[11481 of 14553 chars elided by tools/bench/transcript.py; sha256:2974219bbb009596]…\nnbuilt directories).\nmake -j\"$JOBS\" -k -f makefile 2>&1 \\\n    | tee -a \"$LOG\" \\\n    | grep -E \"^(make|SBY|yosys|==|ERROR)\" || true\n\nshopt -s nullglob\nPASS=0; FAIL=0; FAILED=()\nfor sby_file in *.sby; do\n    name=\"${sby_file%.sby}\"\n    log=\"$name/logfile.txt\"\n    if grep -q \"DONE (PASS\" \"$log\" 2>/dev/null; then\n        PASS=$((PASS+1))\n    elif [[ \"$name\" == *_ch1 ]] && grep -q \"Status: PREUNSAT\" \"$log\" 2>/dev/null; then\n        # Vacuous pass on channel-1 checks. NRET=2 contract: when a\n        # single-issue hypothesis ties io_rvfi_valid_1 to 0, the per-channel\n        # BMC's assumption (rvfi_valid_1=1) is unsatisfiable, and SBY\n        # reports Status: PREUNSAT (rc=16). The property holds vacuously\n        # over the empty set of ch1-valid traces — a legitimate pass.\n        # Dual-issue hypotheses make the assumption satisfiable, so this\n        # branch never matches and the regular DONE (PASS branch covers it.\nMakefile\ncoremark\ncrt0.S\ngen_random_trace.py\nlink.ld\nrandom1.S\nrandom2.S\nrandom3.S\nselftest.S\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypgen-late-mul').resolve()\nrtl=root/'rtl'; test=root/'test'\nrtl.mkdir(parents=True,exist_ok=True); test.mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\nfor p in Path('cores/bench/test').glob('*.py'): shutil.copy2(p,test/p.name)\n# Keep the champion's exact product formulation, only retime its inputs.\ns=(rtl/'alu.sv').read_text()\nmult_decl=s[s.index('\"'`ifndef RISCV_FORMAL_ALTOPS'\"'):s.index('  always_comb begin')]\nmult_body=s[s.index('\"'`ifndef RISCV_FORMAL_ALTOPS'\"',s.index('  always_comb begin')):s.index('    case (op)')]\nmult_case='''    case (op)\n\"'`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL: out = (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH: out = (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU: out = (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: out = (a - b) \"'^ 32'\"'hecfbe137;\n\"'`else\n      ALU_MUL: out = mul_product[31:0];\n      ALU_MULH, ALU_MULHU, ALU_MULHSU: out = mul_product[63:32];\n`endif\n      default: out = 32'\"'b0;\n    endcase\n'''\n(rtl/'multiplier.sv').write_text('module multiplier(input logic [4:0] op, input logic [31:0] a, b, output logic [31:0] out);\\\\n'+mult_decl+'  always_comb begin\\\\n'+mult_body+mult_case+'  end\\\\nendmodule\\\\n')\ns=s.replace(mult_decl,'').replace(mult_body,'')\ns=s.replace('ALU_MUL:    out = mul_product[31:0];','ALU_MUL:    out = 32\\\\'b0;').replace('ALU_MULH, ALU_MULHU, ALU_MULHSU: out = mul_product[63:32];',\\\"ALU_MULH, ALU_MULHU, ALU_MULHSU: out = 32'b0;\\\")\n(rtl/'alu.sv').write_text(s)\ns=(rtl/'mem_stage.sv').read_text()\npos=s.index('  logic [31:0] wdata_rep;')\ns=s[:pos]+'''  logic [31:0] mul_result;\n  logic is_mul;\n  assign is_mul = in.valid && \"'!in.ctrl.is_illegal &&\n                  (in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH |