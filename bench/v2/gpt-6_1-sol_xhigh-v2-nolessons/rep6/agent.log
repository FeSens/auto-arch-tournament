{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport runpy, json\nfrom collections import Counter\nns=runpy.run_path('test/cosim/reference.py')\ncpu=ns['RV32IM']()\ncpu.load_elf('cores/bench/generated/hypothesis_research/coremark.elf')\ncounts=Counter()\nstarted=False\nstart_retirement=0\nfor n in range(10000000):\n rec=cpu.step()\n if rec is None:\n  raise RuntimeError('Program halted before stop marker')\n addr=rec.get('mem_addr',0)\n wm=rec.get('mem_wmask',0)\n if wm and addr==0x10000100:\n  started=True\n  start_retirement=n\n  continue\n if wm and addr==0x10000104:\n  break\n if started:\n  i=rec['insn']\n  if i&0x7f==0x33 and i>>25==1:\n   names=('MUL','MULH','MULHSU','MULHU','DIV','DIVU','REM','REMU')\n   counts[names[(i>>12)&7]]+=1\n  counts['total']+=1\nelse:\n raise RuntimeError('Stop marker not reached')\nmul_count=sum(counts[op] for op in ['MUL','MULH','MULHSU','MULHU'])\nbase=4491817\n# Accepted request is edge 1; result valid after edge 5 and consumed at\n# edge 6. Baseline emits EX/MEM at edge 1, so the nominal cost is 5 clocks.\nresult={'profile':'canonical 2K -O3 ELF through existing Python ISS',\n        'marked_retirements':counts['total'],'M_operations':dict(counts),\n        'multiply_count':mul_count,'nominal_extra_multiply_cycles':5*mul_count,\n        'nominal_cycle_ratio':(base+5*mul_count)/base,\n        'Fmax_MHz_required_for_4_6pct_gain':50.016*1.046*(base+5*mul_count)/base,\n        'note':'Arithmetic count is architectural; added-cycle estimate excludes changing pseudo-random stalls and any overlapped stalls.'}\nprint(json.dumps(result,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
