{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/hypgen_r14s0')\nsrc=Path('cores/bench/rtl')\nstage=p/'flat_operands'/'rtl'\nshutil.copytree(src,stage,dirs_exist_ok=True)\nf=stage/'ex_stage.sv'\ns=f.read_text()\nold='''  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n'''\nnew='''  logic a_ex, a_wb, a_stored, b_ex, b_wb, b_stored;\n  logic a_pc_mask, a_ex_mask, a_wb_mask, a_id_mask;\n  logic b_imm_mask, b_ex_mask, b_wb_mask, b_id_mask;\n  assign a_ex = (fwd_rs1_sel == 2'd1);\n  assign a_wb = (fwd_rs1_sel == 2'd2);\n  assign a_stored = \"'!(a_ex || a_wb);\n  assign b_ex = (fwd_rs2_sel == 2'\"'d1);\n  assign b_wb = (fwd_rs2_sel == 2'd2);\n  assign b_stored = \"'!(b_ex || b_wb);\n  assign a_pc_mask = in.ctrl.is_auipc;\n  assign a_ex_mask = !in.ctrl.is_auipc && a_ex;\n  assign a_wb_mask = !in.ctrl.is_auipc && a_wb;\n  assign a_id_mask = !in.ctrl.is_auipc && a_stored;\n  assign b_imm_mask = in.ctrl.alu_src;\n  assign b_ex_mask = !in.ctrl.alu_src && b_ex;\n  assign b_wb_mask = !in.ctrl.alu_src && b_wb;\n  assign b_id_mask = !in.ctrl.alu_src && b_stored;\n  assign alu_a = ((in.pc & {32{a_pc_mask}}) | (fwd_ex_mem & {32{a_ex_mask}})) |\n                 ((fwd_mem_wb & {32{a_wb_mask}}) | (in.rs1_val & {32{a_id_mask}}));\n  assign alu_b = ((in.imm & {32{b_imm_mask}}) | (fwd_ex_mem & {32{b_ex_mask}})) |\n                 ((fwd_mem_wb & {32{b_wb_mask}}) | (in.rs2_val & {32{b_id_mask}}));\n'\"'''\nassert old in s\nf.write_text(s.replace(old,new))\nprint(stage.resolve())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
