{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nwt=Path.cwd()\nbase=wt/'cores/bench/generated/hyp_r13s0'\ns=(wt/'cores/bench/rtl/alu.sv').read_text()\nnet='''  logic subtract;\n  logic [31:0] bx, addsub_result;\n  assign subtract = op[0];\n  assign bx = b \"'^ {32{subtract}};\n  assign addsub_result = a + bx + {31'\"'b0, subtract};\n\n'''\nfor name,bits in [('shared32',None),('cla4',4),('cla8sep',8)]:\n d=base/name/'rtl'\n shutil.copytree(wt/'cores/bench/rtl',d,dirs_exist_ok=True)\n if bits is None:\n  network=net\n else:\n  network=''\n  for mode in (['add','sub'] if name=='cla8sep' else ['addsub']):\n   invert='~b' if mode=='sub' else ('b' if mode=='add' else '(b \"'^ {32{op[0]}})'\"')\n   first='1\\\\'b1' if mode=='sub' else ('1\\\\'b0' if mode=='add' else 'op[0]')\n   network+=f'  logic [31:0] {mode}_b, {mode}_result;\\\\n  assign {mode}_b = {invert};\\\\n'\n   n=32//bits\n   for i in range(n):\n    network+=f'  wire [{bits}:0] {mode}_s0_{i} = {{1\\\\'b0, a[{i*bits} +: {bits}]}} + {{1\\\\'b0, {mode}_b[{i*bits} +: {bits}]}};\\\\n'\n    network+=f'  wire [{bits-1}:0] {mode}_s1_{i} = a[{i*bits} +: {bits}] + {mode}_b[{i*bits} +: {bits}] + {bits}\\\\'d1;\\\\n'\n    network+=f'  wire {mode}_p_{i} = &(a[{i*bits} +: {bits}] \"'^ {mode}_b[{i*bits} +: {bits}]);'\"\\\\n'\n    network+=f'  wire {mode}_g_{i} = {mode}_s0_{i}[{bits}];\\\\n'\n    terms=[]\n    for j in range(i-1,-1,-1):\n     factors=[f'{mode}_p_{k}' for k in range(j+1,i)]+[f'{mode}_g_{j}']\n     terms.append('('+' & '.join(factors)+')')\n    terms.append('('+' & '.join([f'{mode}_p_{k}' for k in range(i)]+[first])+')')\n    network+=f'  wire {mode}_c_{i} = '+' | '.join(terms)+';\\\\n'\n    network+=f'  assign {mode}_result[{i*bits} +: {bits}] = {mode}_c_{i} ? {mode}_s1_{i} : {mode}_s0_{i}[{bits-1}:0];\\\\n'\n  network+='\\\\n'\n ns=s.replace('  always_comb begin\\\\n    case (op)',network+'  always_comb begin\\\\n    case (op)',1)\n if name=='cla8sep':\n  ns=ns.replace('      ALU_ADD:    out = a + b;\\\\n      ALU_SUB:    out = a - b;','      ALU_ADD: out = add_result;\\\\n      ALU_SUB: out = sub_result;')\n else:\n  ns=ns.replace('      ALU_ADD:    out = a + b;\\\\n      ALU_SUB:    out = a - b;','      ALU_ADD, ALU_SUB: out = addsub_result;')\n (d/'alu.sv').write_text(ns)\nprint('Prepared three carry-network variants')\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nfrom tools.eval import gowin\nimport json\nwt=Path.cwd(); base=wt/'cores/bench/generated/hyp_r13s0'\nwith ThreadPoolExecutor(max_workers=3) as pool:\n fs={pool.submit(gowin.build,wt,base/name/'rtl','fpga/core_bench_si.sv',1,base/name/'gowin_p1'):name for name in ['shared32','cla4','cla8sep']}\n for f in as_completed(fs):\n  n=fs[f]; r=f.result(); (base/n/'timing_p1.json').write_text(json.dumps(r,indent=2)); print(n,json.dumps(r),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
