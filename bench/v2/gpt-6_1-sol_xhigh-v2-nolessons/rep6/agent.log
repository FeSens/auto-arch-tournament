{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/generated/r15_distributed_rf_probe/rtl')\nfor kind in ['masked','partitioned']:\n p=Path(f'cores/bench/generated/r15_rf_{kind}_probe');shutil.copytree(src,p/'rtl',dirs_exist_ok=True)\n f=p/'rtl/reg_file.sv';s=f.read_text()\n if kind=='masked':\n  i=s.index(' always_comb begin');s=s[:i]+''' wire bypass1 = w_en && w_addr \"'!= 0 && w_addr == rs1_addr;\n wire bypass2 = w_en && w_addr != 0 && w_addr == rs2_addr;\n assign rs1_data = (w_data & {32{bypass1}}) | (bank1[rs1_addr] & {32{!bypass1 && initialized_q[rs1_addr]}});\n assign rs2_data = (w_data & {32{bypass2}}) | (bank2[rs2_addr] & {32{!bypass2 && initialized_q[rs2_addr]}});\nendmodule\n'\"'''\n else:\n  i=s.index(' (* syn_ramstyle');s=s[:i]+''' (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] bank1_lo [0:15],bank1_hi [0:15];\n (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] bank2_lo [0:15],bank2_hi [0:15];\n logic [15:0] initialized_lo_q,initialized_hi_q;\n wire write_valid = w_en && w_addr \"'!= 0 && !reset;\n always_ff @(posedge clock) begin\n  if(write_valid && !w_addr[4]) begin bank1_lo[w_addr[3:0]] <= w_data;bank2_lo[w_addr[3:0]] <= w_data;end\n  if(write_valid && w_addr[4]) begin bank1_hi[w_addr[3:0]] <= w_data;bank2_hi[w_addr[3:0]] <= w_data;end\n end\n always_ff @(posedge clock) begin\n  if(reset) begin initialized_lo_q <= 16'\"'b0;initialized_hi_q <= 16'b0;end\n  else begin\n   if(write_valid && \"'!w_addr[4]) initialized_lo_q[w_addr[3:0]] <= 1'\"'b1;\n   if(write_valid && w_addr[4]) initialized_hi_q[w_addr[3:0]] <= 1'b1;\n  end\n end\n wire bypass1 = w_en && w_addr \"'!= 0 && w_addr == rs1_addr;\n wire bypass2 = w_en && w_addr != 0 && w_addr == rs2_addr;\n wire low1 = !bypass1 && !rs1_addr[4] && initialized_lo_q[rs1_addr[3:0]];\n wire high1 = !bypass1 && rs1_addr[4] && initialized_hi_q[rs1_addr[3:0]];\n wire low2 = !bypass2 && !rs2_addr[4] && initialized_lo_q[rs2_addr[3:0]];\n wire high2 = !bypass2 && rs2_addr[4] && initialized_hi_q[rs2_addr[3:0]];\n assign rs1_data = (w_data & {32{bypass1}}) | (bank1_lo[rs1_addr[3:0]] & {32{low1}}) | (bank1_hi[rs1_addr[3:0]] & {32{high1}});\n assign rs2_data = (w_data & {32{bypass2}}) | (bank2_lo[rs2_addr[3:0]] & {32{low2}}) | (bank2_hi[rs2_addr[3:0]] & {32{high2}});\nendmodule\n'\"'''\n f.write_text(s)\n print('Prepared RF',kind)\nPY\npython3 -u - <<'PY'\nfrom pathlib import Path\nfrom tools.eval import gowin\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nroot=Path.cwd()\ndef go(kind):\n p=root/f'cores/bench/generated/r15_rf_{kind}_probe'\n t=gowin.build_all(root,p/'rtl','fpga/core_bench_si.sv',p/'timing')\n (p/'timing.json').write_text(json.dumps(t,indent=2));print(kind,json.dumps(gowin.summarize(t)),flush=True)\n for r in t: print(kind,json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=2) as pool:\n for f in [pool.submit(go,k) for k in ['masked','partitioned']]:f.result()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
