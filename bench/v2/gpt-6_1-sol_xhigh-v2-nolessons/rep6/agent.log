be's commit.\nformal/last_run*.log\n\n# Orchestrator-emitted per-rep summary. Phase-2 contract output written\n# by tools/orchestrator.py:write_run_summary after every round and at\n# end of main(). Derivable from log.jsonl; not worth tracking in git.\n# Without this entry, `git status` between rounds shows it as untracked\n# (since the orchestrator never `git add`s it), and the hypothesis-phase\n# sandbox check in tools/agents/hypothesis.py rolls back the next slot's\n# turn with \"modified off-limits paths: ['.../run_summary.json']\".\n# Caught live during the gpt-5.5 effort sweep — slot 2 in round 2 of\n# every rep was hypothesis_gen_failed for this reason.\ncores/*/experiments/run_summary.json\n\n# Agent stdout capture, written per-worktree by tools/agents/implement\n…[5765 of 8837 chars elided by tools/bench/transcript.py; sha256:01a102470658293b]…\n   d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n", "exit_code": 0, "status": "completed"}}
