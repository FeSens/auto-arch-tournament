{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport yaml,json,jsonschema\np=Path('cores/bench/experiments/hypotheses/hyp-20261005-002-r15s1.yaml');h=yaml.safe_load(p.read_text())\nh['title']='Compact dual-read distributed-RAM register file with reset validity'\ns=h['hypothesis']\ns=s.replace('Replace only the flop-based integer register file with two mirrored\\\\nasynchronously read distributed-RAM banks, each supplying one read port.\\\\nBoth copies receive the same synchronous architectural write.','Replace only the flop-based integer register file with one behavioral\\\\ndistributed-RAM array exposing two asynchronous read ports and one\\\\nsynchronous write port. Let Gowin infer mirrored physical read banks\\\\nfrom this shared array, rather than manually declaring duplicated words.')\ns=s.replace('A nonzero enabled write when\\\\nreset is low updates both copies and sets only its owning initialized\\\\nbit.','A nonzero enabled write when\\\\nreset is low updates the array and sets only its owning initialized bit.')\nstart=s.index('Use local bank selection and mutually exclusive masked-OR terms')\nend=s.index('\\\\nAll ordinary, shift and M-extension arithmetic',start)\ns=s[:start]+'''Use exactly one 32-by-32 behavioral storage declaration with two indexed\nasynchronous reads. After x0 qualification, give same-cycle WB bypass\npriority over initialized-word data, then return zero for an unwritten\nword. Keep one shared resettable validity vector and the original\nread-output priority expression. Do not use four/eight-entry fetch\nbuffers, split the read output into masked-OR terms or manually partition\nthe RAM into smaller address banks: private probes of those variants\nfailed to improve median timing. Use the shared array to expose the\nactual one-write/two-read storage topology to synthesis, with no new\npipeline register, clock phase, operand stall or decode-address hold.\nKeep all 32 architectural data bits and stable output behavior for held\ndecode addresses. Dmem/divider holds retain existing ID/EX and WB\nforwarding behavior; the register file still writes only valid WB records.\n''' +s[end:]\ns=s.replace('The final local\\\\nbank/read-selection topology must be measured; no qualifying result is\\\\nclaimed by these preliminary numbers.','The final shared-array\\\\ntopology must be measured; no qualifying result is claimed by these\\\\npreliminary numbers. Shared-array inference is the final proposed form,\\\\nnot the explicitly mirrored or manually partitioned probe.')\nh['hypothesis']=s\nh['changes'][0]['description']='''Replace 31 resettable flop words with one behavioral 32-by-32 RAM\nhaving synchronous nonzero writes and two asynchronous read ports.\nUse Gowin syn_ramstyle=\\\"distributed_ram\\\" and let synthesis replicate\nphysical read banks. Keep a shared resettable per-word initialized\nvector, mask stale/unwritten storage to zero, and preserve reset priority,\nx0 and original write-first output selection and ports/latency. Add no\nread register, manually partitioned address banks or new dependency stall.'''\np.write_text(yaml.safe_dump(h,sort_keys=False,width=78))\njsonschema.validate(h,json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('Updated schema-valid shared-array hypothesis')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
