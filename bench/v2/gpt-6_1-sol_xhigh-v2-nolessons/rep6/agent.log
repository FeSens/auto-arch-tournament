 if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[10145 of 13217 chars elided by tools/bench/transcript.py; sha256:2ca691a4c63d151d]…\nfit (the flow\n187:    ref = next(r for r in results if r[\"place_option\"] == PLACE_OPTIONS[0])\n192:        \"perturbations\": [[r[\"place_option\"], r[\"fmax_mhz\"], r[\"levels\"]] for r in results],\n199:def main(argv=None) -> int:\n205:    ap.add_argument(\"target\")\n206:    ap.add_argument(\"--worktree\", default=\".\")\n207:    ap.add_argument(\"--paths\", type=int, default=5)\n208:    ap.add_argument(\"--all-options\", action=\"store_true\",\n209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\n212:    opts = PLACE_OPTIONS if a.all_options else PLACE_OPTIONS[:1]\n214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\n217:            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\n219:        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\n221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n", "exit_code": 0, "status": "completed"}}
