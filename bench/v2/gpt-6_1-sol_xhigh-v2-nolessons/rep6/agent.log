{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_alu.py; sed -n '1,180p' cores/bench/test/test_divider.py; sed -n '1,170p' cores/bench/test/test_pipeline.py; rg -n 'ALU_MUL|MULH|multiply|mul_' cores/bench/rtl/alu.sv cores/bench/test/test_ex_stage.py; rg --files -uu cores/bench/generated/timing | head -n 50\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nThe fast ALU is combinational. Real DIV/REM vectors now live in\ntest_divider.py and use the sequential divider handshake.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"ALTOPS_MODE\") == \"1\"\nALTOPS_CONSTANTS = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n\n\nasync def _setup(dut):\n    \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n    `await _setup(dut)` for parity with other test files.\"\"\"\n    return\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    if ALTOPS and op in ALTOPS_CONSTANTS:\n        arithmetic = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        expected = arithmetic ^ ALTOPS_CONSTANTS[op]\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await \n…[16960 of 20032 chars elided by tools/bench/transcript.py; sha256:8c45f1d30e500bb9]…\n= (a - b) ^ 32'hecfbe137;\ncores/bench/rtl/alu.sv:63:      ALU_MUL:    out = mul_uu[31:0];\ncores/bench/rtl/alu.sv:64:      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\ncores/bench/rtl/alu.sv:65:      ALU_MULHU:  out = mul_uu[63:32];\ncores/bench/rtl/alu.sv:66:      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\ncores/bench/generated/timing/gowin_p0/gw.log\ncores/bench/generated/timing/gowin_p0/impl/pnr/device.cfg\ncores/bench/generated/timing/gowin_p0/impl/pnr/cmd.do\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.log\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.prj\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench_syn_resource.html\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.vg\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench_syn_rsc.xml\ncores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.log\ncores/bench/generated/timing/gowin_p0/build.tcl\n", "exit_code": 0, "status": "completed"}}
