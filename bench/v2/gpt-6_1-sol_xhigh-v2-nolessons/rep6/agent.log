valid, \"ctrl\": pack(CTRL_FIELDS, {\"alu_op\": op, \"reg_write\": 1}),\n    })\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_e\n…[11390 of 14462 chars elided by tools/bench/transcript.py; sha256:2de05174669e2ad1]…\nin (0, 1, 0x7FFFFFFF, 0x80000000, MASK32):\n            for b in (0, 2, 0x10001, 0x80000000, MASK32):\n                await _check(dut, op, a, b)\n        for _ in range(40):\n            await _check(dut, op, rng.getrandbits(32), rng.getrandbits(32))\n\n\ndef test_multiplier_runner():\n    run_cocotb(toplevel=\"multiplier\", sources=[\"core_pkg.sv\", \"multiplier.sv\"],\n               test_module=\"test_multiplier\")\n\n\ndef test_multiplier_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / \"multiplier_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"multiplier.sv\"],\n                 hdl_toplevel=\"multiplier\", build_dir=build_dir, always=True,\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\", \"-DRISCV_FORMAL_ALTOPS\"])\n    runner.test(hdl_toplevel=\"multiplier\", test_module=\"test_multiplier\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"ALTOPS_MODE\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
