{"type": "item.completed", "item": {"id": "item_53", "type": "command_execution", "command": "/bin/bash -c \"rg --files cores/bench/generated/hypgen_r8s1_match/test; sed -n '155,215p' cores/bench/test/test_ex_stage.py; sed -n '690,713p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "cores/bench/generated/hypgen_r8s1_match/test/test_ex_stage.py\ncores/bench/generated/hypgen_r8s1_match/test/test_pipeline.py\ncores/bench/generated/hypgen_r8s1_match/test/results.xml\n    assert int(dut.out.value) == 0 and not int(dut.div_active_q.value)\n    dut[\"in\"].value = payload(valid=0)\n    dut.reset.value = 0\n    for _ in range(40):\n        await tick(dut)\n        assert not int(dut.div_result_valid.value)\n        assert not unpack(EX_FIELDS, int(dut.out.value))[\"valid\"]\n\n\n@cocotb.test()\nasync def early_readiness_is_registered_and_trap_qualified(dut):\n    await setup(dut)\n    assert int(dut.out.value) == 0\n    cases = [\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1}, 1, 0, 0),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 0}, 0, 0, 0),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1, \"mem_read\": 1, \"mem_to_reg\": 1}, 0, 0, 0),\n    ]\n    cases.extend(({\"alu_op\": op, \"reg_write\": 1}, 0, 0, 0)\n                 for op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU))\n    # Aligned link is early; misaligned JAL and JALR must suppress it.\n    cases.extend((\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1, \"is_jump\": 1}, 1, 8, 0),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1, \"is_jump\": 1}, 0, 2, 1),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1, \"is_jump\": 1, \"is_jalr\": 1}, 0, 1, 1),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1}, 1, 0, 0),\n    ))\n    for ctrl, ready, imm, trap in cases:\n        old = int(dut.out.value)\n        dut[\"in\"].value = pack(ID_FIELDS, {\n            \"pc\": 0x80, \"rs1_val\": 1, \"rs2_val\": 2, \"imm\": imm,\n            \"rd\": 3, \"rs1_addr\": 1, \"rs2_addr\": 2, \"valid\": 1,\n            \"ctrl\": pack(CTRL_FIELDS, ctrl),\n        })\n        await Timer(1, \"ns\")\n        assert int(dut.out.value) == old, \"readiness changed before EX/MEM clock\"\n        assert int(dut.redirect.value) == int(ctrl.get(\"is_jump\", 0) and not trap)\n        await tick(dut)\n        out = unpack(EX_FIELDS, int(dut.out.value))\n        assert out[\"valid\"] and out[\"fwd_ready\"] == ready\n        out_ctrl = unpack(CTRL_FIELDS, out[\"ctrl\"])\n        assert out_ctrl[\"is_illegal\"] == trap\n        assert out_ctrl[\"reg_write\"] == (ctrl[\"reg_write\"] and not trap)\n        assert (out[\"rs1_val\"], out[\"rs2_val\"]) == (1, 2)\n        assert out[\"effective_addr\"] == (1 + imm) & 0xFFFFFFFF\n        if ctrl.get(\"is_jump\"):\n            assert out[\"alu_result\"] == 0x84\n            if trap:\n                assert out[\"pc_next\"] == 0x84\n        if ctrl[\"alu_op\"] in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n            assert out[\"alu_result\"] == 0, \"real product must be absent from EX\"\n\n    # A downstream hold retains readiness with the old producer payload.\n    saved = int(dut.out.value)\n    dut[\"in\"].value = 0\n    dut.stall.value = 1\n    for _ in range(5):\n        await tick(dut)\n        assert int(dut.out.value) == saved\n    dut.stall.value = 0\n    await tick(dut)\n        flush = int(dut.flush_id.value)\n        dhold = int(dut.hold_mem_wb.value)\n        ehold = int(dut.execute_hold.value)\n        redirect = int(dut.redirect.value)\n        if dhold or ehold:\n            assert stall and not flush, \"flush overrode a genuine pipeline hold\"\n        if flush and stall:\n            stats[\"load_bubbles\"] += 1\n        stats[\"dmem_holds\"] += dhold\n        stats[\"unavailable\"] += not ir\n        stats[\"divider_unavailable\"] += bool(ehold and not ir)\n        stats[\"redirect_unavailable\"] += bool(redirect and not ir)\n        stats[\"redirect_dmem_holds\"] += bool(redirect and dhold)\n        if ren and dr:\n            stats[\"reads\"].append(da)\n        if wen and dr:\n            stats[\"writes\"].append((da, int(dut.io_dmemWData.value), wen))\n        if int(dut.u_ex.div_req_valid.value) and int(dut.u_ex.div_req_ready.value):\n            stats[\"launches\"].append((int(dut.u_ex.rs1.value), int(dut.u_ex.rs2.value)))\n        previous = {\"hold\": bool(stall and not flush), \"state\": state,\n                    \"execute_hold\": bool(ehold), \"pc\": ia}\n\n    return stats, observe\n\n", "exit_code": 0, "status": "completed"}}
