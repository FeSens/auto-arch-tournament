e to zero. Preserve\nreset priority, nonzero write eligibility, x0, both write-first bypasses\nand exact original ports/latency. Use mutually exclusive masked-OR read\nselection without inserting another pipeline register.'''},\n{'file':'test/test_reg_file.py','description':'''Retain every existing x0, asynchronous read, synchronous write,\nwrite-first and reset assertion. Cover all 31 locations, both low/high\nbanks, independent and identical read addresses, concurrent dual bypass,\ndisabled writes, reset with write enabled, repeated resets after distinct\nRAM contents, partial repopulation and seeded randomized reference-model\nsequences. Check observable zeros without depending on RAM initialization.'''},\n{'file':'test/test_pipeline.py','description':'''Preserve existing pipeline checks and exercise writes/reads across\nregister-file banks, WB-to-ID bypass and immediate EX/WB dependencies\nthrough ALU, load, shift, MUL and DIV consumers. Include long bus/divider\nholds, younger overwrites, reset after execution, x0 and recovery-squashed\nwrites. Assert exact RVFI sources/results/order and unchanged dependency\nschedule; retain all decoder/trap/forward-progress checks.'''}]}\np.write_text(yaml.safe_dump(h,sort_keys=False,width=78))\njsonschema.validate(h,json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('Rewrote and validated',p)\nPY\"", "aggregated_output": "Rewrote and validated cores/bench/experiments/hypotheses/hyp-20261005-002-r15s1.yaml\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/generated/r15_mul_prepare_probe/rtl');p=Path('cores/bench/generated/r15_compact_operand_probe');shutil.copytree(src,p/'rtl',dirs_exist_ok=True)\nshutil.copy2('cores/bench/generated/r15_distributed_rf_probe/rtl/reg_file.sv',p/'rtl/reg_file.sv')\nprint('Prepared compact operand-delivery topology')\nPY\npython3 -u - <<'PY'\nfrom tools.eval import gowin\nfrom tools.eval.cosim import run_one\nfrom tools.eval.fpga import validate_coremark_uart\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport subprocess,os,json\nroot=Path.cwd();p=root/'cores/bench/generated/r15_compact_operand_probe'\ndef functional():\n env=dict(os.environ,RTL_DIR=str(p/'rtl'),OBJ_DIR=str(p/'obj_dir'),NRET='1')\n with (p/'cosim_build.log').open('w') as f: subprocess.run(['bash','test/cosim/build.sh'],stdout=f,stderr=subprocess.STDOUT,env=env,check=True)\n sim=str(p/'obj_dir/cosim_sim');elf_dir=root/'cores/bench/generated/r15_mul_prepare_probe'\n with ThreadPoolExecutor(max_workers=8) as pool:\n  fs=[pool.submit(run_one,elf_dir/(name+'.elf'),sim,str(root),None,flags) for name in ['selftest','random1','random2','random3'] for flags in [(),('--istall','--dstall')]]\n  for f in fs: print('COSIM',json.dumps(f.result()),flush=True)\n r=subprocess.run([sim,str(elf_dir/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True)\n m=json.loads(r.stdout.splitlines()[-1]);(p/'coremark.json').write_text(json.dumps(m,indent=2));print('COREMARK cycles',m['bench_stop_cycle']-m['bench_start_cycle'],'CRCs',validate_coremark_uart(m['uart'],10),flush=True)\ndef timing():\n t=gowin.build_all(root,p/'rtl','fpga/core_bench_si.sv',p/'timing')\n (p/'timing.json').write_text(json.dumps(t,indent=2));print('TIMING',json.dumps(gowin.summarize(t)),flush=True)\n for r in t: print('OPTION',json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=2) as pool:\n for f in [pool.submit(functional),pool.submit(timing)]:f.result()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
