101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm\n…[23379 of 26451 chars elided by tools/bench/transcript.py; sha256:d16086a2fc9f9863]…\n True):\n1992:            if not stalled:\n2003:            if stalled and ir and (memory_hold or int(dut.execute_hold.value)):\n2008:        stats, observe = _prediction_observer(dut)\n2021:        aliases = [entry for entry in stats[\"train\"] if entry[0] in (20, 84)]\n2029:        if stalled:\n2039:    stats, observe = _prediction_observer(dut)\n2041:    aliases = [entry for entry in stats[\"train\"] if entry[0] in (20, 84)]\n2049:async def agree_predictor_reserved_and_faulting_direct_controls(dut):\n2054:    # suppress its link just like the unpredicted misaligned JAL.\n2055:    stats, observe = _prediction_observer(dut)\n2064:    assert stats[\"train\"] == [] and stats[\"recoveries\"] == []\n2065:    assert all(prediction == 0 for _, _, prediction in stats[\"accepted\"])\n2069:def test_pipeline_runner():\n2074:            \"alu.sv\", \"multiplier.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n2075:            \"branch_predictor.sv\", \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n2084:def test_pipeline_altops_runner():\n", "exit_code": 0, "status": "completed"}}
