{"type": "item.started", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport json,shutil\nfrom pathlib import Path\ns=Path('/srv/hwebench/tmp/b57a151a/9feffaf8/writeback-prototype')\nt=s.parent/'late-writeback-prototype'\nt.mkdir()\nshutil.copytree(s/'rtl',t/'rtl')\nshutil.copytree(Path('cores/bench/test'),t/'test')\np=t/'rtl/core_pkg.sv'\nx=p.read_text()\nold='    logic [31:0] write_data;     // raw rs2 (post-forward), pre byte replication'\nassert x.count(old)==1\np.write_text(x.replace(old,'    logic        fwd_ready;     // registered early producer readiness\\\\n'+old))\np=t/'rtl/alu.sv'\nx=p.read_text()\na=x.index('\"'`ifndef RISCV_FORMAL_ALTOPS'\"')\nb=x.index('  always_comb begin',a)\nx=x[:a]+x[b:]\na=x.index('\"'`ifndef RISCV_FORMAL_ALTOPS'\"')\nb=x.index('    case (op)',a)\nx=x[:a]+x[b:]\nx=x.replace('ALU_MUL:    out = mul_product[31:0];','ALU_MUL:    out = 32\\\\'b0;')\nx=x.replace('ALU_MULH, ALU_MULHU, ALU_MULHSU: out = mul_product[63:32];','ALU_MULH, ALU_MULHU, ALU_MULHSU: out = 32\\\\'b0;')\n# Preserve the ALTOPS formulas here, although MUL-family architectural results now come from MEM.\nx=x.replace('\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n  /* verilator lint_off UNUSEDSIGNAL */\\\\n\"'`endif'\"','  /* verilator lint_off UNUSEDSIGNAL */')\nx=x.replace('\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n  /* verilator lint_on UNUSEDSIGNAL */\\\\n\"'`endif'\"','  /* verilator lint_on UNUSEDSIGNAL */')\np.write_text(x)\np=t/'rtl/multiplier.sv'\np.write_text('''module multiplier (\n  input logic [4:0] op,\n  input logic [31:0] a,\n  input logic [31:0] b,\n  output logic [31:0] result\n);\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  always_comb begin\n    case (op)\n      ALU_MUL:    result = (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   result = (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  result = (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: result = (a - b) \"'^ 32'\"'hecfbe137;\n      default: result = '0;\n    endca