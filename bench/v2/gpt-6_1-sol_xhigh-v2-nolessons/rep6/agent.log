{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hypgen-late-mul/test/test_pipeline.py')\ns=p.read_text()\ns+='''\n\n@cocotb.test()\nasync def late_multiply_to_divider_and_retained_wb(dut):\n    import random\n    program = [\n        ADDI(1, 0, 101), ADDI(2, 0, 7), MUL(3, 1, 2), DIV(4, 3, 2),\n        MUL(5, 4, 2), SW(5, 0, 0x100), ADD(6, 5, 5), MUL(7, 6, 2),\n        LW(8, 0, 0x100), DIV(9, 7, 8), SW(9, 0, 0x104), EBREAK(),\n    ]\n    stats, observe = _bubble_observer(dut)\n    rng = random.Random(0x51A7)\n    remaining = 25\n    def ready(cycle, ia, da, wen, ren):\n        nonlocal remaining\n        ir, dr = int(rng.randrange(5) \"'!= 0), int(rng.randrange(5) != 0)\n        if wen and da == 0x100 and remaining:\n            remaining -= 1\n            dr = 0\n        return ir, dr\n    rets, memory = await _run(dut, program, ready=ready, observe=observe,\n                             unavailable_word=_poison_fetch, max_cycles=1000)\n    _assert_retirement_stream(rets, program)\n    _assert_raw_source_values(rets)\n    for rd, result in ((1,101),(2,7),(3,707),(4,101),(5,707),(6,1414),(7,9898),(8,707),(9,14)):\n        assert [r['\"'rd_wdata'] for r in rets if r['rd']==rd] == [result]\n    assert stats['launches'] == [(707,7),(9898,707)]\n    assert stats['writes'] == [(0x100,707,15),(0x104,14,15)]\n    assert memory == {0x100:707,0x104:14} and remaining == 0\n\n\n@cocotb.test()\nasync def late_multiply_jump_consumer_and_younger_writer(dut):\n    program = [ADDI(1,0,7), ADDI(2,0,4), MUL(3,1,2), JALR(4,3,0),\n               SW(3,0,0x100), NOP(), NOP(), ADD(5,3,4),\n               MUL(6,1,2), ADDI(6,0,11), ADD(7,6,6),\n               MUL(0,1,2), ADD(8,0,0), EBREAK()]\n    stats, observe = _bubble_observer(dut)\n    rets, memory = await _run(dut, program, observe=observe)\n    _assert_retirement_stream(rets,program,skipped=(16,20,24))\n    _assert_raw_source_values(rets)\n    for instr, result in ((JALR(4,3,0),16),(ADD(5,3,4),44),(ADD(7,6,6),22),(ADD(8,0,0),0)):\n        [r] = _by_insn(rets,instr)\n        assert r['rd_wdata']==result\n    [jump] = _by_insn(rets,JALR(4,3,0))\n    assert jump['pc_next']==28 and jump['rs1_rdata']==28\n    assert stats['writes']==[] and memory=={}\n'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
