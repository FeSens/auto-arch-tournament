> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm\n…[9157 of 12229 chars elided by tools/bench/transcript.py; sha256:6578ff4a4004932f]…\nexecute_hold.value), \"completion must release the upstream hold\"\n    await tick(dut)\n    result = unpack(EX_FIELDS, int(dut.out.value))\n    assert result[\"valid\"] and result[\"alu_result\"] == 14\n    assert result[\"fwd_ready\"], \"divider completion must transfer saved early readiness\"\n    assert (result[\"rs1_val\"], result[\"rs2_val\"]) == (100, 7)\n    assert result[\"effective_addr\"] == 96, \"divider must preserve the launch address snapshot\"\n    assert (result[\"pc\"], result[\"pc_next\"], result[\"rd\"]) == (0x80, 0x84, 3)\n    assert result[\"instr\"] == 0x0220C1B3\n    ctrl = unpack(CTRL_FIELDS, result[\"ctrl\"])\n    assert ctrl[\"reg_write\"] and not ctrl[\"mem_read\"] and not ctrl[\"mem_write\"]\n    dut[\"in\"].value = 0  # model ID/EX advancing on the result transfer edge\n    for _ in range(40):\n        await tick(dut)\n        assert not unpack(EX_FIELDS, int(dut.out.value))[\"valid\"]\n        assert not int(dut.div_active_q.value)\n\n\n@cocotb.test()\nasync def invalid_instruction_and_reset_cancel_division(dut):\n    await setup(dut)\n", "exit_code": 0, "status": "completed"}}
