{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/b57a151a/be1824b0/r4s0-forward-xtkdvy45')\nshutil.copytree(Path.cwd()/'cores/bench/rtl',p/'flop_rf',dirs_exist_ok=True)\nf=p/'flop_rf/reg_file.sv'; s=f.read_text(); start=s.index('  logic [31:0] regs')\ns=s[:start]+'''  wire [31:0] regs [0:31];\n  assign regs[0] = 32'b0;\n  generate\n    for (genvar r = 1; r < 32; r++) begin: word\n      logic [31:0] value_q;\n      always_ff @(posedge clock) begin\n        if (reset) value_q <= 32'b0;\n        else if (w_en && w_addr == 5'(r)) value_q <= w_data;\n      end\n      assign regs[r] = value_q;\n    end\n  endgenerate\n  always_comb begin\n    if (rs1_addr == 5'b0) rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = regs[rs1_addr];\n    if (rs2_addr == 5'b0) rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = regs[rs2_addr];\n  end\nendmodule\n''';f.write_text(s)\nprint('Prepared explicit per-register flop storage prototype.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
