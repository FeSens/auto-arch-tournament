      \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(\n…[16395 of 19467 chars elided by tools/bench/transcript.py; sha256:46c68bac0b511624]…\n        DIV(11, 1, 2), REM(11, 1, 2), JAL(11, 0),\n             BEQ(1, 1, -4), 0xFFFFFFFF)\n    return words[cycle % len(words)]\n\n\n@cocotb.test()\nasync def redirects_squash_all_younger_side_effects(dut):\n    \"\"\"Taken BEQ/JAL/JALR each squash a store, load, writer, DIV, and REM.\"\"\"\n    redirects = (BEQ(1, 1, 8), JAL(7, 8), JALR(7, 5, 0))\n    younger = (SW(1, 0, 0x100), LW(9, 0, 0x100), ADDI(9, 0, 99),\n               DIV(9, 1, 2), REM(9, 1, 2))\n    for jump in redirects:\n        for wrong in younger:\n            program = [ADDI(1, 0, 100), ADDI(2, 0, 7), ADDI(5, 0, 20),\n                       jump, wrong, ADDI(8, 9, 1), SW(8, 0, 0x104), EBREAK()]\n            stats, observe = _bubble_observer(dut)\n            rets, dmem = await _run(dut, program, {0x100: 0xFEED}, observe=observe)\n            _assert_retirement_stream(rets, program, skipped=(16,))\n            [target] = _by_insn(rets, ADDI(8, 9, 1))\n            assert (target[\"rs1_rdata\"], target[\"rd_wdata\"]) == (0, 1)\n            [ret_jump] = _by_insn(rets, jump)\n", "exit_code": 0, "status": "completed"}}
