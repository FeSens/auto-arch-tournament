{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/branch8_signbias');test=base/'test';test.mkdir(exist_ok=True)\nfor name in ('_helpers.py','test_pipeline.py','test_ex_stage.py'):\n (test/name).write_text((Path('cores/bench/test')/name).read_text())\np=test/'test_ex_stage.py';t=p.read_text();t+='''\n\n@cocotb.test()\nasync def branch_predicate_architectural_reference(dut):\n    import random\n    await setup(dut)\n    def signed(x): return x - (1 << 32) if x & (1 << 31) else x\n    rng = random.Random(20261005)\n    edges = [0, 1, 2, 0x7f, 0x80, 0xff, 0x100, 0x7fff, 0x8000,\n             0xffff, 0x10000, 0xffffff, 0x1000000, 0x7fffffff,\n             0x80000000, 0xfffffffe, 0xffffffff]\n    pairs = [(a, b) for a in edges for b in edges]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(1500)]\n    for index, (a, b) in enumerate(pairs):\n        src1, src2 = (index // 3) % 3, index % 3\n        dut.fwd_rs1_sel.value = src1\n        dut.fwd_rs2_sel.value = src2\n        # Select identical architectural sources with varied forwarding;\n        # when both share a bypass word, intentionally test equality.\n        if src1 == src2 and src1 \"'!= 0: b = a\n        dut.fwd_ex_mem.value = a if src1 == 1 else b\n        dut.fwd_mem_wb.value = a if src1 == 2 else b\n        reference = [a == b, a != b, False, False,\n                     signed(a) < signed(b), signed(a) >= signed(b), a < b, a >= b]\n        for op in range(8):\n            dut[\"in\"].value = pack(ID_FIELDS, {\n                \"pc\": 0x100, \"rs1_val\": a, \"rs2_val\": b, \"imm\": 0x20,\n                \"valid\": 1, \"ctrl\": pack(CTRL_FIELDS, {\"is_branch\": 1, \"branch_op\": op}),\n            })\n            await Timer(1, \"ns\")\n            assert int(dut.redirect.value) == reference[op], (a, b, src1, src2, op)\n            assert int(dut.redirect_target.value) == 0x120\n'\"''';p.write_text(t)\nPY\npython3 -m pytest -q cores/bench/generated/branch8_signbias/test/test_ex_stage.py cores/bench/generated/branch8_signbias/test/test_pipeline.py > cores/bench/generated/branch8_signbias/tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
