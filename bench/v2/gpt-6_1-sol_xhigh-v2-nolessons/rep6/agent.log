{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"sed -n '350,408p' cores/bench/test/test_pipeline.py; sed -n '850,879p' cores/bench/test/test_pipeline.py; rg --files bench/programs -g '*.elf'; rg -n 'formal|sim_build|implementation_notes' .gitignore\"", "aggregated_output": "\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef _division_observer(dut):\n    stats = {\"launches\": [], \"busy_cycles\": 0, \"blocked_cycles\": 0, \"writes\": []}\n    previous = {\"hold\": False, \"pc\": None}\n\n    def observe(cycle, ia, da, wen, ren, ir, dr):\n        if previous[\"hold\"]:\n            assert ia == previous[\"pc\"], \"fetch PC moved during divider hold\"\n        active = int(dut.u_ex.div_active_q.value)\n        hold = int(dut.execute_hold.value)\n        request = int(dut.u_ex.div_req_valid.value)\n        accepted = request and int(dut.u_ex.div_req_ready.value)\n        if active:\n            stats[\"busy_cycles\"] += 1\n            assert wen == 0 and ren == 0, \"memory side effect while division is active\"\n            assert not (int(dut.u_ex.reg_q.value) & 1), \"EX/MEM must be invalid while waiting\"\n            assert not int(dut.hold_mem_wb.value), \"divider froze the older WB instruction\"\n            assert not request, \"divide request launched twice\"\n        if accepted:\n            assert hold, \"upstream must hold on the request acceptance cycle\"\n            stats[\"launches\"].append((cycle, int(dut.u_ex.rs1.value),\n                                      int(dut.u_ex.rs2.value)))\n        if (wen or ren) and not dr:\n            stats[\"blocked_cycles\"] += 1\n            assert not request and not active, \"divide launched behind a blocked memory op\"\n        if wen and dr:\n            stats[\"writes\"].append((da, int(dut.io_dmemWData.value), wen))\n        previous.update(hold=bool(hold), pc=ia)\n\n    return stats, observe\n\n\ndef _assert_retirement_stream(rets, program, skipped=()):\n    pcs = [pc for pc in range(0, len(program) * 4, 4) if pc not in skipped]\n    assert [r[\"pc\"] for r in rets] == pcs, \"lost, duplicated, or wrong-path retirement\"\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert not any(r[\"trap\"] for r in rets)\n    for older, younger in zip(rets, rets[1:]):\n        assert older[\"pc_next\"] == younger[\"pc\"]\n\n\n@cocotb.test()\nasync def multiply_signedness_forwarding_and_consumers(dut):\n                                (ADD(4, 3, 2), 14, 7, 21),\n                                (REM(5, 4, 2), 21, 7, 0)):\n        [ret] = _by_insn(rets, instr)\n        assert (ret[\"rs1_rdata\"], ret[\"rs2_rdata\"], ret[\"rd_wdata\"]) == (a, b, result)\n    [unchanged] = _by_insn(rets, ADDI(12, 11, 1))\n    assert (unchanged[\"rs1_rdata\"], unchanged[\"rd_wdata\"]) == (0, 1)\n    assert stats[\"reads\"] == []\n    assert stats[\"writes\"] == [(0x104, 0, 15)]\n    assert dmem == {0x104: 0}\n\n\ndef _assert_raw_source_values(rets):\n    \"\"\"Check both RVFI raw source values against architectural register state.\"\"\"\n    registers = [0] * 32\n    for ret in rets:\n        for port, shift in ((\"rs1\", 15), (\"rs2\", 20)):\n            addr = (ret[\"insn\"] >> shift) & 31\n            assert ret[f\"{port}_addr\"] == addr\n            assert ret[f\"{port}_rdata\"] == registers[addr], (\n                f\"PC {ret['pc']:#x} {port}=x{addr}: \"\n                f\"{ret[f'{port}_rdata']:#x} != {registers[addr]:#x}\"\n            )\n        if ret[\"rd\"]:\n            registers[ret[\"rd\"]] = ret[\"rd_wdata\"]\n\n\n@cocotb.test()\nasync def registered_matches_priority_alternation_and_x0(dut):\n    program = [\n        ADDI(5, 0, 11), ADDI(5, 0, 23), ADD(6, 5, 5),\n15:formal/riscv-formal\n19:# emitted by run_all.sh after the concurrent-rm-race fix (formal/run_all.sh\n23:formal/last_run*.log\n52:sim_build/\n54:test/cosim/sim_build/\n55:test/**/sim_build/\n87:cores/*/implementation_notes.md\n", "exit_code": 0, "status": "completed"}}
