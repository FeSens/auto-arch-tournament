{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Execute divider integration: launch gating and retained completion.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_DIV, run_cocotb\n\nCTRL_FIELDS = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n               (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n               (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n               (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n               (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_FIELDS = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n             (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef pack(fields, values):\n    bits = 0\n    for name, width in fields:\n        bits = (bits << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return bits\n\n\ndef unpack(fields, bits):\n    values = {}\n    for name, width in reversed(fields):\n        values[name] = bits & ((1 << width) - 1)\n        bits >>= width\n    return values\n\n\ndef payload(op=ALU_DIV, valid=1):\n    return pack(ID_FIELDS, {\n        \"pc\": 0x80, \"rs1_val\": 1, \"rs2_val\": 2, \"rd\": 3,\n        \"rs1_addr\": 1, \"rs2_addr\": 2, \"instr\": 0x0220C1B3,\n        \"valid\": valid, \"ctrl\": pack(CTRL_FIELDS, {\"alu_op\": op, \"reg_write\": 1}),\n    })\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await tick(\n…[2554 of 5626 chars elided by tools/bench/transcript.py; sha256:d74851537e22e303]…\non(dut):\n    await setup(dut)\n    dut[\"in\"].value = payload(valid=0)\n    for _ in range(40):\n        await tick(dut)\n        assert not int(dut.execute_hold.value) and not int(dut.div_req_valid.value)\n        assert not int(dut.div_active_q.value)\n    dut[\"in\"].value = payload()\n    await tick(dut)\n    assert int(dut.div_active_q.value)\n    for _ in range(12):\n        await tick(dut)\n    dut.reset.value = 1\n    await Timer(1, \"ns\")\n    assert not int(dut.execute_hold.value) and not int(dut.div_req_valid.value)\n    await tick(dut)\n    assert int(dut.out.value) == 0 and not int(dut.div_active_q.value)\n    dut[\"in\"].value = payload(valid=0)\n    dut.reset.value = 0\n    for _ in range(40):\n        await tick(dut)\n        assert not int(dut.div_result_valid.value)\n        assert not unpack(EX_FIELDS, int(dut.out.value))[\"valid\"]\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"divider.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
