{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_branch_predictor.py'", "aggregated_output": "\"\"\"Agreement state, fetch legality, exact direct targets, and PC acceptance.\"\"\"\nfrom __future__ import annotations\n\nimport random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\nfrom test_pipeline import _b, JAL, JALR, NOP\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def independent_saturation_reset_and_accepted_records(dut):\n    if not hasattr(dut, \"train\"):\n        return\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.lookup_index.value = 0\n    dut.train.value = 0\n    dut.advance.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    model = [3] * 16\n\n    async def update(index, agree, valid=1, advance=1):\n        dut.train.value = (index << 2) | (agree << 1) | valid\n        dut.advance.value = advance\n        await tick(dut)\n        if valid and advance:\n            model[index] = max(0, min(3, model[index] + (1 if agree else -1)))\n        for lookup in range(16):\n            dut.lookup_index.value = lookup\n            await Timer(1, \"ns\")\n            assert int(dut.agreement.value) == (model[lookup] >> 1)\n            assert int(dut.g_counters[lookup].counter_q.value) == model[lookup]\n\n    for index in range(16):\n        for _ in range(6):\n            await update(index, 0)\n        for _ in range(6):\n            await update(index, 1)\n    # A held valid event cannot write until MEM accepts it. Its agreement\n    # is captured independently of the fetch index / current instruction.\n    for _ in range(8):\n        await update(7, 0, advance=0)\n    await update(7, 0)\n    for _ in range(8):\n        await update(7, 0, valid=0)\n    assert model[7] == 2\n    await update(7, 0)\n    assert model[7] == 1\n    # Opposite directions sharing an index agree with their own BEQ/BNE\n    # biases, so both strengthen the same counter.\n    for bias, actual in ((0, 0), (1, 1), (0, 0), (1, 1)):\n        await update(7, int(bias == actual))\n    asse\n…[2684 of 5756 chars elided by tools/bench/transcript.py; sha256:7a48d634df25121b]…\ne) == target\n        assert int(dut.next_pc.value) == pc, \"stall consumed a prediction\"\n        dut.stall.value = 0\n        await Timer(1, \"ns\")\n        expected = target if predicted else (pc + 4) & 0xFFFFFFFF\n        assert int(dut.next_pc.value) == expected\n        dut.flush.value = 1\n        await Timer(1, \"ns\")\n        assert int(dut.next_pc.value) == pc\n        dut.redirect.value = 1\n        dut.redirect_target.value = 0x12345678\n        await Timer(1, \"ns\")\n        assert int(dut.next_pc.value) == 0x12345678\n        assert int(dut.out.value) >> 2 == out >> 2, \"repair altered raw fetch payload\"\n        await tick(dut)\n        assert int(dut.imem_addr.value) == 0x12345678\n    dut.reset.value = 1\n    await tick(dut)\n    assert int(dut.imem_addr.value) == 0\n\n\ndef test_agree_counter_runner():\n    run_cocotb(\"branch_predictor\", [\"core_pkg.sv\", \"branch_predictor.sv\"], \"test_branch_predictor\")\n\n\ndef test_direct_fetch_runner():\n    run_cocotb(\"if_stage\", [\"core_pkg.sv\", \"if_stage.sv\"], \"test_branch_predictor\")\n", "exit_code": 0, "status": "completed"}}
