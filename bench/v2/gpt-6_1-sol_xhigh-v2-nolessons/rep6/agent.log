": imm, \"rd\": 3,\n        \"rs1_addr\": 1, \"rs2_addr\": 2, \"instr\": 0x0220C1B3,\n        \"valid\": valid, \"ctrl\": pack(CTRL_FIELDS, {\"alu_op\": op, \"reg_write\": 1}),\n    })\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def setup(dut\n…[18186 of 21258 chars elided by tools/bench/transcript.py; sha256:89246e0b365ebf55]…\n       await tick(dut)\n        dut.squash.value = 1\n        dut[\"in\"].value = younger\n        await Timer(1, \"ns\")\n        assert not int(dut.execute_hold.value) and not int(dut.div_req_valid.value)\n        assert not int(dut.div_result_ready.value) and not int(dut.recovery_valid.value)\n        await tick(dut)\n        out = unpack(EX_FIELDS, int(dut.out.value))\n        assert not out[\"valid\"] and not out[\"ctrl\"] and not out[\"fwd_ready\"]\n        assert not int(dut.div_active_q.value) and not int(dut.redirect.value)\n        assert not (int(dut.train.value) & 1)\n    dut.squash.value = 0\n    dut[\"in\"].value = branch\n    await tick(dut)\n    dut.reset.value = 1\n    await Timer(1, \"ns\")\n    assert not int(dut.redirect.value)\n    await tick(dut)\n    assert not int(dut.recovery_valid_q.value) and int(dut.redirect_target.value) == 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"divider.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
