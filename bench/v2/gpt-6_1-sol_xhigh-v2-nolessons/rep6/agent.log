{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/test/test_ex_stage.py\"", "aggregated_output": "\"\"\"Execute address generation, forwarding, and retained divider completion.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_ADD, ALU_SUB, ALU_AND, ALU_SLT, ALU_SLL, ALU_SRL, ALU_SRA, ALU_LUI,\n                      ALU_DIV, ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb)\n\nCTRL_FIELDS = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n               (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n               (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n               (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n               (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_FIELDS = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"predicted_taken\", 1), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"effective_addr\", 32),\n             (\"fwd_ready\", 1), (\"write_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n             (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef pack(fields, values):\n    bits = 0\n    for name, width in fields:\n        bits = (bits << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return bits\n\n\ndef unpack(fields, bits):\n    values = {}\n    for name, width in reversed(fields):\n        values[name] = bits & ((1 << width) - 1)\n        bits >>= width\n    return values\n\n\ndef payload(op=ALU_DIV, valid=1, imm=0):\n    return pack(ID_FIELDS, {\n        \"pc\": 0x80, \"rs1_val\": 1, \"rs2_val\": 2, \"imm\": imm, \"rd\": 3,\n        \"rs1_addr\": 1, \"rs2_addr\": 2, \"instr\": 0x0220C1B3,\n        \"valid\": valid, \"ctrl\": pack(CTRL_FIELDS, {\"alu_op\": op, \"reg_write\": 1}),\n    })\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def setup(dut\n…[3671 of 6743 chars elided by tools/bench/transcript.py; sha256:5a321e5cd66deef1]…\nut.div_active_q.value)\n    dut[\"in\"].value = payload(valid=0)\n    dut.reset.value = 0\n    for _ in range(40):\n        await tick(dut)\n        assert not int(dut.div_result_valid.value)\n        assert not unpack(EX_FIELDS, int(dut.out.value))[\"valid\"]\n\n\n@cocotb.test()\nasync def early_readiness_is_registered_and_trap_qualified(dut):\n    await setup(dut)\n    assert int(dut.out.value) == 0\n    cases = [\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1}, 1, 0, 0),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 0}, 0, 0, 0),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1, \"mem_read\": 1, \"mem_to_reg\": 1}, 0, 0, 0),\n    ]\n    cases.extend(({\"alu_op\": op, \"reg_write\": 1}, 0, 0, 0)\n                 for op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n                            ALU_SLL, ALU_SRL, ALU_SRA))\n    # Aligned link is early; misaligned JAL and JALR must suppress it.\n    cases.extend((\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1, \"is_jump\": 1}, 1, 8, 0),\n        ({\"alu_op\": ALU_ADD, \"reg_write\": 1, \"is_jump\": 1}, 0, 2, 1),\n", "exit_code": 0, "status": "completed"}}
