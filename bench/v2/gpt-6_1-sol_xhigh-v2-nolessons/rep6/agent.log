{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1358,1435p' cores/bench/test/test_pipeline.py; sed -n '2040,2090p' cores/bench/test/test_pipeline.py; cat test/cosim/build.sh\"", "aggregated_output": "            [product] = [r for r in rets if r[\"pc\"] == 16]\n            assert ret[\"cycle\"] == product[\"cycle\"] + 2\n        assert stats[\"load_bubbles\"] == 1\n\n\n@cocotb.test()\nasync def multiply_schedule_matches_real_and_altops(dut):\n    \"\"\"Both builds use MEM products, one dependent bubble, and retained WB.\"\"\"\n    import os\n    altops = os.environ.get(\"ALTOPS_MODE\") == \"1\"\n    modes = (MUL, MULH, MULHU, MULHSU)\n    constants = (0x5876063E, 0xF6583FB7, 0x949CE5E8, 0xECFBE137)\n    for multiply, constant in zip(modes, constants):\n        program = [ADDI(1, 0, -3), ADDI(2, 0, 7), NOP(),\n                   multiply(5, 1, 2), ADD(6, 5, 5),\n                   multiply(7, 1, 2), SW(2, 0, 0x100), ADD(8, 7, 7), EBREAK()]\n        value = _multiply_result(multiply(5, 1, 2), 0xFFFFFFFD, 7)\n        if altops:\n            arithmetic = 0xFFFFFFFD - 7 if multiply == MULHSU else 0xFFFFFFFD + 7\n            value = (arithmetic ^ constant) & 0xFFFFFFFF\n        holds = 12\n        retained = 0\n        bubbles = 0\n\n        def ready(cycle, ia, da, wen, ren):\n            nonlocal holds\n            if wen and da == 0x100 and holds:\n                holds -= 1\n                return int(holds % 2 == 0), 0\n            return 1, 1\n\n        def observe(cycle, ia, da, wen, ren, ir, dr):\n            nonlocal retained, bubbles\n            assert not int(dut.execute_hold.value)\n            if int(dut.flush_id.value) and int(dut.stall_id.value):\n                bubbles += 1\n            state = int(dut.u_id.reg_q.value)\n            instr = (state >> 1) & 0xFFFFFFFF\n            if state & 1 and instr in (ADD(6, 5, 5), ADD(8, 7, 7)):\n                assert (int(dut.fwd_rs1_sel.value), int(dut.fwd_rs2_sel.value)) == (2, 2)\n                assert int(dut.wb_w_data.value) == value\n            if int(dut.hold_mem_wb.value) and not int(dut.io_rvfi_valid_0.value):\n                retained += 1\n                assert int(dut.wb_w_data.value) == value and not int(dut.wb_w_en.value)\n\n        rets, dmem = await _run(dut, program, ready=ready, observe=observe,\n  \n…[5870 of 8942 chars elided by tools/bench/transcript.py; sha256:70b2d76d7a7aad4f]…\nRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n", "exit_code": 0, "status": "completed"}}
