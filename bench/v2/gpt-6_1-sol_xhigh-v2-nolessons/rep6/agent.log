{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM=(1<<32)-1\ndef signed(v): return v-(1<<32) if v>>31 else v\nedges=[0,1,2,0xffff,0x10000,0x7fffffff,0x80000000,0xffff0000,0xffffffff]\npairs=[(a,b) for a in edges for b in edges]\nr=random.Random(1105)\npairs += [(r.getrandbits(32),r.getrandbits(32)) for _ in range(100000)]\nfor a,b in pairs:\n ll=(a&0xffff)*(b&0xffff)\n lh=(a&0xffff)*(b>>16)\n hl=(a>>16)*(b&0xffff)\n hh=(a>>16)*(b>>16)\n cross=lh+hl\n middle=(ll>>16)+(cross&0xffff)\n lo=((middle&0xffff)<<16)|(ll&0xffff)\n hi=(hh+(cross>>16)+(middle>>16))&M\n assert ((hi<<32)|lo)==a*b\n for op in ['mul','mulh','mulhsu','mulhu']:\n  correction=(b if op in ['mulh','mulhsu'] and a>>31 else 0)+(a if op=='mulh' and b>>31 else 0)\n  out=lo if op=='mul' else (hi-correction)&M\n  av=signed(a) if op in ['mulh','mulhsu'] else a\n  bv=signed(b) if op=='mulh' else b\n  expected=(av*bv if op=='mul' else (av*bv)>>32)&M\n  assert out==expected,(op,a,b,out,expected)\nprint('Partial-product assembly and signed corrections verified for',len(pairs),'operand pairs across all four operations')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
