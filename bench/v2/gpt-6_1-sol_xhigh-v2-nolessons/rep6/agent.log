{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\nfrom tools.eval.gowin import parse_reports, summarize\nroot = Path('cores/bench/generated/timing')\nresults = [dict(place_option=p, **parse_reports(root / f'gowin_p{p}')) for p in range(3)]\nsummary = summarize(results)\ncycles = 4507701 - 15884\nfitness = summary['fmax_mhz'] * 1e6 * 10 / cycles\nprint(f'Median Fmax: {summary[\\\"fmax_mhz\\\"]:.3f} MHz; marked cycles: {cycles}; fitness: {fitness:.6f}; gain: {(fitness / 133.75 - 1) * 100:.4f}%')\nfor p in range(3):\n    text = (root / f'gowin_p{p}/impl/pnr/core_bench.tr').read_text()\n    setup = text.split('3.3.1 Setup Analysis Report')[-1].split('3.3.2 Hold Analysis Report')[0]\n    dsp_paths = 0\n    for block in re.split(r'\"'^'\"\\\\s*Path\\\\d+\\\\s*\"'$'\"', setup, flags=re.M)[1:]:\n        arrival = block.split('Data Arrival Path:')[-1].split('Data Required Path:')[0]\n        if '/u_alu/mul_product' not in arrival:\n            continue\n        dsp_paths += 1\n        before_dsp = arrival.split('/u_alu/mul_product')[0]\n        assert not re.search(r'/alu_[ab]_|is_auipc|alu_src', before_dsp), f'General ALU mode mux before multiplier in option {p}'\n    print(f'Option {p}: {dsp_paths} reported DSP setup paths, no general ALU mode mux before multiplier.')\n    assert dsp_paths > 0\nPY\nverilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+cores/bench/rtl cores/bench/rtl/*.sv\ngit diff --check\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
