ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n   \n…[5563 of 8635 chars elided by tools/bench/transcript.py; sha256:13a3f0ddecd1bb6e]…\nest(skip=not ALTOPS)\nasync def algebraic_m_extension(dut):\n    rng = random.Random(0xA170)\n    for op in ALTOPS_CONSTANTS:\n        for _ in range(40):\n            await _check(dut, op, rng.getrandbits(32), rng.getrandbits(32), 0)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_alu_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"alu.sv\"],\n                 hdl_toplevel=\"alu\", build_dir=build_dir, always=True,\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\", \"-DRISCV_FORMAL_ALTOPS\"])\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"ALTOPS_MODE\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
