{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/b57a151a/d31a4914/branch_probe'); f=p/'rtl/ex_stage.sv'; s=f.read_text()\na=s.index('  wire [31:0] ba'); b=s.index('  always_comb begin\\\\n    branch_taken',a)\ns=s[:a]+'''  wire [31:0] ba [0:2], bb [0:2];\n  wire [2:0] ea, eb;\n  wire [2:0] flags [0:2][0:2];\n  wire [2:0] cr [0:2];\n  wire [2:0] chosen;\n  assign ba[0]=in.rs1_val; assign ba[1]=fwd_ex_mem; assign ba[2]=fwd_mem_wb;\n  assign bb[0]=in.rs2_val; assign bb[1]=fwd_ex_mem; assign bb[2]=fwd_mem_wb;\n  assign ea={fwd_rs1_sel==2'd2,fwd_rs1_sel==2'd1,(fwd_rs1_sel==2'd0 || fwd_rs1_sel==2'd3)};\n  assign eb={fwd_rs2_sel==2'd2,fwd_rs2_sel==2'd1,(fwd_rs2_sel==2'd0 || fwd_rs2_sel==2'd3)};\n  for(genvar i=0;i<3;i++) begin:g_bc_a\n    for(genvar j=0;j<3;j++) begin:g_bc_b\n      if(i==j && i\"'!=0) begin:g_same\n        assign flags[i][j]=3'\"'b001;\n      end else if(i==2 && j==1) begin:g_reverse\n        assign flags[i][j]={\"'!flags[1][2][2] && !flags[1][2][0],!flags[1][2][1] && !flags[1][2][0],flags[1][2][0]};\n      end else begin:g_cmp\n        wire eq=ba[i]==bb[j];\n        wire ltu=ba[i]<bb[j];\n        wire lts=(ba[i][31]''^bb[j][31])?ba[i][31]:ltu;\n        assign flags[i][j]={lts,ltu,eq};\n      end\n    end\n    assign cr[i]=(flags[i][0]&{3{eb[0]}})|(flags[i][1]&{3{eb[1]}})|(flags[i][2]&{3{eb[2]}});\n  end\n  assign chosen=(cr[0]&{3{ea[0]}})|(cr[1]&{3{ea[1]}})|(cr[2]&{3{ea[2]}});\n  always_comb begin\n    case(in.ctrl.branch_op)\n      BR_BEQ:branch_cond=chosen[0];\n      BR_BNE:branch_cond=!chosen[0];\n      BR_BLT:branch_cond=chosen[2];\n      BR_BGE:branch_cond=!chosen[2];\n      BR_BLTU:branch_cond=chosen[1];\n      BR_BGEU:branch_cond=!chosen[1];\n      default:branch_cond=1'\"'b0;\n    endcase\n  end\n\n'''+s[b:]\nf.write_text(s)\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nimport json\np=Path('/srv/hwebench/tmp/b57a151a/d31a4914/branch_probe')\nr=build_all(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',p/'timing_flags',options=(0,1,2))\n(p/'timing_flags_result.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(summarize(r),indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
