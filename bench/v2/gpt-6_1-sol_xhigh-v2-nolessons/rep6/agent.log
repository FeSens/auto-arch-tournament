{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/b57a151a/24a3e3b0/r10s1-research/outcome_forward')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'alu.sv';s=p.read_text();s=s.replace('module alu (','module alu #(parameter bit ENABLE_SHIFTS = 1\\\\'b1) (');s=s.replace('out = a << shamt;','out = ENABLE_SHIFTS ? (a << shamt) : 32\\\\'b0;').replace('out = right_result;','out = ENABLE_SHIFTS ? right_result : 32\\\\'b0;');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text();s=s.replace('alu u_alu (','alu #(.ENABLE_SHIFTS(1\\\\'b0)) u_alu (')\na=s.index('  // ── Branch resolve')\ns=s[:a]+'''  function automatic [31:0] shifted_candidate(input logic [31:0] v,\n                                              input logic [4:0] amount,\n                                              input logic [4:0] operation);\n    logic fill;\n    logic [31:0] t1,t2,t4,t8,tr;\n    begin\n      fill = (operation == ALU_SRA) && v[31];\n      t1 = amount[0] ? {fill,v[31:1]} : v;\n      t2 = amount[1] ? {{2{fill}},t1[31:2]} : t1;\n      t4 = amount[2] ? {{4{fill}},t2[31:4]} : t2;\n      t8 = amount[3] ? {{8{fill}},t4[31:8]} : t4;\n      tr = amount[4] ? {{16{fill}},t8[31:16]} : t8;\n      shifted_candidate = operation == ALU_SLL ? (v << amount) : tr;\n    end\n  endfunction\n  logic [31:0] shift_local, shift_ex, shift_wb, shift_result;\n  logic shift_instruction;\n  assign shift_local = shifted_candidate(in.rs1_val,alu_b[4:0],in.ctrl.alu_op);\n  assign shift_ex = shifted_candidate(fwd_ex_mem,alu_b[4:0],in.ctrl.alu_op);\n  assign shift_wb = shifted_candidate(fwd_mem_wb,alu_b[4:0],in.ctrl.alu_op);\n  assign shift_instruction = in.ctrl.alu_op == ALU_SLL || in.ctrl.alu_op == ALU_SRL ||\n                             in.ctrl.alu_op == ALU_SRA;\n  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1: shift_result = shift_ex;\n      2'd2: shift_result = shift_wb;\n      default: shift_result = shift_local;\n    endcase\n  end\n\n  function automatic compared_candidate(input logic [31:0] a,b,\n                                        input logic [2:0] operation);\n    logic eq,ult,slt;\n    begin\n      eq = (a == b);\n      ult = (a < b);\n      slt = (a[31] \"'!= b[31]) ? a[31] : ult;\n      case (operation)\n        BR_BEQ: compared_candidate = eq;\n        BR_BNE: compared_candidate = !eq;\n        BR_BLT: compared_candidate = slt;\n        BR_BGE: compared_candidate = !slt;\n        BR_BLTU: compared_candidate = ult;\n        BR_BGEU: compared_candidate = !ult;\n        default: compared_candidate = 1'\"'b0;\n      endcase\n    end\n  endfunction\n  wire [31:0] candidate_a[0:2], candidate_b[0:2];\n  wire compared[0:2][0:2];\n  logic [2:0] compared_row;\n  assign candidate_a[0] = in.rs1_val;\n  assign candidate_a[1] = fwd_ex_mem;\n  assign candidate_a[2] = fwd_mem_wb;\n  assign candidate_b[0] = in.rs2_val;\n  assign candidate_b[1] = fwd_ex_mem;\n  assign candidate_b[2] = fwd_mem_wb;\n  for (genvar r=0; r<3; r++) begin: g_compare_rows\n    for (genvar c=0; c<3; c++) begin: g_compare_cols\n      assign compared[r][c] = compared_candidate(candidate_a[r],candidate_b[c],in.ctrl.branch_op);\n    end\n    always_comb begin\n      case (fwd_rs2_sel)\n        2'd1: compared_row[r] = compared[r][1];\n        2'd2: compared_row[r] = compared[r][2];\n        default: compared_row[r] = compared[r][0];\n      endcase\n    end\n  end\n\n'''+s[a:]\na=s.index('    case (in.ctrl.branch_op)');b=s.index('    branch_taken  =',a)\ns=s[:a]+'''    case (fwd_rs1_sel)\n      2'd1: branch_cond = compared_row[1];\n      2'd2: branch_cond = compared_row[2];\n      default: branch_cond = compared_row[0];\n    endcase\n'''+s[b:]\ns=s.replace('in.ctrl.is_jump ? (in.pc + 32\\\\'d4) : alu_result;', 'in.ctrl.is_jump ? (in.pc + 32\\\\'d4) : shift_instruction ? shift_