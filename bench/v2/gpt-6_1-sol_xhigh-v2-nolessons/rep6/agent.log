{"type": "item.completed", "item": {"id": "item_95", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/branch_predictor.sv cores/bench/rtl/hazard_unit.sv'", "aggregated_output": "// Instruction-validated, 32-entry direct-target cache. The target is\n// learned only from legal aligned EX resolution, never calculated in IF.\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [31:0] fetch_pc,\n  input  logic [31:0] fetch_instr,\n  output logic        predicted_taken,\n  output logic [31:0] predicted_target,\n  input  logic        resolve_fire,\n  input  logic        resolve_direct,\n  input  logic [31:0] resolve_pc,\n  input  logic [31:0] resolve_instr,\n  input  logic [31:0] resolve_target,\n  input  logic        resolve_taken\n);\n  logic [31:0] valid_q;\n  // Index accounts for bits [6:2]; keep every other PC bit in the tag.\n  // One packed write makes the association between all three fields\n  // explicit to both RAM inference and symbolic memory reasoning.\n  logic [88:0] entry_q [0:31];  // {PC tag, exact instruction, target[31:2]}\n  logic [1:0] counter_q [0:31];\n  logic [4:0] fetch_index, resolve_index;\n  logic [26:0] fetch_tag, resolve_tag;\n  logic pc_match, instr_match, replacement;\n  logic fetch_jal, fetch_branch;\n  logic train;\n\n  assign fetch_index = fetch_pc[6:2];\n  assign resolve_index = resolve_pc[6:2];\n  assign fetch_tag = {fetch_pc[31:7], fetch_pc[1:0]};\n  assign resolve_tag = {resolve_pc[31:7], resolve_pc[1:0]};\n\n  // Both equalities consume raw inputs independently of fetch acceptance,\n  // recovery, validity, and one another. Only the final narrow select is\n  // qualified; the destination comes entirely from stored aligned bits.\n  assign pc_match = (entry_q[fetch_index][88:62] == fetch_tag);\n  assign instr_match = (entry_q[fetch_index][61:30] == fetch_instr);\n  assign fetch_jal = (fetch_instr[6:0] == 7'b1101111);\n  assign fetch_branch = (fetch_instr[6:0]