done\nTOTAL=$((PASS+FAIL))\nif [ $TOTAL -eq 0 ]; then\n    FAIL=1\n    FAILED+=(\"no_checks_generated\")\nfi\n\necho \"\"\necho \"Formal: $PASS passed, $FAIL failed\"\nif [ $FAIL -gt 0 ]; then\n    echo \"Failed: ${FAILED[*]}\"\nCOPYING\nCodeOfConduct\nREADME.md\nbus\nchecks\ncores\ndocs\ninsns\nmonitor\ntests\n38:basedir = f\"{os.getcwd()}/../..\"\n271:hargs[\"basedir\"] = basedir\n427:                : @basedir@/checks/rvfi_macros.vh\n428:                : @basedir@/checks/rvfi_channel.sv\n429:                : @basedir@/checks/rvfi_testbench.sv\n434:                    : @basedir@/checks/rvfi_csr_ill_check.sv\n438:                    : @basedir@/checks/rvfi_csrw_check.sv\n442:                    : @basedir@/checks/rvfi_insn_check.sv\n443:                    : @basedir@/insns/insn_@insn@.v\n702:                : @basedir@/checks/rvfi_macros.vh\n703:                : @basedir@/checks/rvfi_channel.sv\n704:                : @basedir@/checks/rvfi_testbench.sv\n705:                : @basedir@/checks/rvfi_@check@_check.sv\n38:basedir = f\"{os.getcwd()}/../..\"\n132:isa_regex = re.compile(r\"^rv(?P<width>\\d+)(?P<base>[ie])(?P<ext>[a-v]*)(?P<multi>_?[SZX]\\w+)?$\", re.I)\n139:isa_mods: list[str] = [isa_dict[\"base\"].lower(), isa_dict[\"width\"]]\n235:        custom_csrs.add((name, int(addr, base=16), levels))\n271:hargs[\"basedir\"] = basedir\n357:        insn = f\"12'h{int(ill_addr, base=16):03X}\"\n393:                : [script]\n427:                : @basedir@/checks/rvfi_macros.vh\n428:                : @basedir@/checks/rvfi_channel.sv\n429:                : @basedir@/checks/rvfi_testbench.sv\n434:                    : @basedir@/checks/rvfi_csr_ill_check.sv\n438:                    : @basedir@/checks/rvfi_csrw_check.sv\n442:                    : @basedir@/checks/rvfi_insn_check.sv\n443:                    : @basedir@/insns/insn_@insn@.v\n665:                : [script]\n702:                : @basedir@/checks/rvfi_macros.vh\n703:                : @basedir@/checks/rvfi