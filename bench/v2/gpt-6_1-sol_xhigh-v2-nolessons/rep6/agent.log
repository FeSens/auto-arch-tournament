31];\n-  assign words[0] = 32'b0;\n+  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] words [0:31];\n+  logic [31:0] initialized_q;\n \n-  for (genvar word = 1; word < 32; word++) begin : g_regs\n-    localparam logic [4:0] WORD_ADDR = 5'(word);\n-    logic [31:0] value_q;\n-    wire write_word = w_en && (w_addr == WORD_ADDR);\n+  // Reset suppresses writes without resetting the RAM itself. x0 is never\n+  // written and its initialized bit stays clear.\n+  always_ff @(posedge clock) begin\n+    if (!reset && w_en && w_addr != 5'b0)\n+      words[w_addr] <= w_data;\n+  end\n \n-    always_ff @(posedge clock) begin\n-      if (reset)           value_q <= 32'b0;\n-      else if (write_word) value_q <= w_data;\n-    end\n-    assign words[word] = value_q;\n+  always_ff @(posedge clock) begin\n+    if (reset)\n+      initialized_q <= 32'b0;\n+    else if (w_en && w_addr != 5'b0)\n+      initialized_q[w_addr] <= 1'b1;\n   end\n \n   always_comb begin\n@@ -50,15 +52,19 @@ module reg_file (\n       rs1_data = 32'b0;\n     else if (w_en && w_addr == rs1_addr)\n       rs1_data = w_data;\n-    else\n+    else if (initialized_q[rs1_addr])\n       rs1_data = words[rs1_addr];\n+    else\n+      rs1_data = 32'b0;\n \n     if (rs2_addr == 5'b0)\n       rs2_data = 32'b0;\n     else if (w_en && w_addr == rs2_addr)\n       rs2_data = w_data;\n-    else\n+    else if (initialized_q[rs2_addr])\n       rs2_data = words[rs2_addr];\n+    else\n+      rs2_data = 32'b0;\n   end\n \n endmodule\n{'runner_reports': 14, 'cocotb_executed': 153, 'cocotb_failed': 0}\n","exit_code":0,"status":"completed"}}
