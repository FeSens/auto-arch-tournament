{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"rg -n -F 'n1240' cores/bench/generated/timing/gowin_p0/impl/gwsynthesis/core_bench.vg | head -15\nsed -n '1,160p' cores/bench/test/_helpers.py\nsed -n '235,285p' cores/bench/test/test_alu.py\nsed -n '335,380p' cores/bench/test/test_ex_stage.py\nsed -n '1845,1890p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"alu.sv\"],\n                 hdl_toplevel=\"alu\", build_dir=build_dir, always=True,\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\", \"-DRISCV_FORMAL_ALTOPS\"])\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"ALTOPS_MODE\": \"1\"})\n                    assert stats[\"first_selectors\"][ret[\"pc\"]] == (\n                        (1, 1) if consumer in (MUL(4, 3, 3), BEQ(3, 3, 8)) else (1, 0)\n                        if consumer in (DIV(6, 3, 10), JALR(8, 3, 0)) else (0, 1))\n                    if consumer != DIV(6, 3, 10) or altops:\n                        assert ret[\"cycle\"] == by_pc[ret[\"pc\"] - 4][\"cycle\"] + 1\n            else:\n                assert stats[\"holds\"] >= 8 and stats[\"istalls\"] > 0\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"multiplier.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n\n\ndef test_pipeline_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / \"core_altops\"\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\")\n    runner.build(sources=sources, hdl_toplevel=\"core\", build_dir=build_dir, always=True,\n                 build_args=[\"-Wall\", \"-DRISCV_FORMAL_ALTOPS\"])\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"ALTOPS_MODE\": \"1\"},\n                test_filter=\"multiply_schedule_matches_real_and_altops|effective_addresses_|right_shifts_\")\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r9_compare_probes')\nroot.mkdir(parents=True,exist_ok=True)\ncomp='''// Parallel byte comparisons and balanced lexicographic reduction.\nmodule compare32 (\n  input logic [31:0] a, b,\n  output logic equal, unsigned_lt, signed_lt\n);\n  logic [3:0] eq_byte, lt_byte;\n  logic eq_hi, eq_lo, lt_hi, lt_lo;\n  for (genvar i=0; i<4; i++) begin : g_byte\n    assign eq_byte[i] = (a[8*i +: 8] == b[8*i +: 8]);\n    assign lt_byte[i] = (a[8*i +: 8] < b[8*i +: 8]);\n  end\n  assign eq_hi = eq_byte[3] && eq_byte[2];\n  assign eq_lo = eq_byte[1] && eq_byte[0];\n  assign lt_hi = lt_byte[3] || (eq_byte[3] && lt_byte[2]);\n  assign lt_lo = lt_byte[1] || (eq_byte[1] && lt_byte[0]);\n  assign equal = eq_hi && eq_lo;\n  assign unsigned_lt = lt_hi || (eq_hi && lt_lo);\n  assign signed_lt = (a[31] \"'!= b[31]) ? a[31] : unsigned_lt;\nendmodule\n'\"'''\nfor variant in ['both','branch']:\n stage=root/variant\n shutil.copytree('cores/bench/rtl',stage/'rtl',dirs_exist_ok=True)\n shutil.copytree('cores/bench/test',stage/'test',dirs_exist_ok=True)\n (stage/'rtl/compare32.sv').write_text(comp)\n p=stage/'rtl/ex_stage.sv'\n s=p.read_text().replace('  logic        branch_cond;', '''  logic cmp_equal, cmp_unsigned_lt, cmp_signed_lt;\n  compare32 u_branch_compare (.a(rs1), .b(rs2), .equal(cmp_equal),\n      .unsigned_lt(cmp_unsigned_lt), .signed_lt(cmp_signed_lt));\n  logic        branch_cond;''')\n for before,after in [('(rs1 == rs2)','cmp_equal'),('(rs1 \"'!= rs2)'\"','\"'!cmp_equal'\"'),('(\"'$signed(rs1) <  $signed(rs2))'\"','cmp_signed_lt'),('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!cmp_signed_lt'\"'),('(rs1 <  rs2)','cmp_unsigned_lt'),('(rs1 >= rs2)','\"'!cmp_unsigned_lt'\"')]:\n  assert before in s,before\n  s=s.replace(before,after)\n p.write_text(s)\n if variant=='both':\n  p=stage/'rtl/alu.sv';s=p.read_text()\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic cmp_unsigned_lt, cmp_signed_lt;\n  compare32 u_compare (.a(a), .b(b), .equal(),\n      .unsigned_lt(cmp_unsigned_lt), .signed_lt(cmp_signed_lt));\n  logic        [4:0]  shamt;''')\n  s=s.replace('\"'$signed(a) < $signed(b)'\"','cmp_signed_lt').replace('a < b','cmp_unsigned_lt')\n  p.write_text(s)\n for p in (stage/'test').glob('test_*.py'):\n  s=p.read_text().replace('\\\"alu.sv\\\",','\\\"alu.sv\\\", \\\"compare32.sv\\\",').replace('RTL / \\\"alu.sv\\\"','RTL / \\\"alu.sv\\\", RTL / \\\"compare32.sv\\\"')\n  p.write_text(s)\nprint('Staged comparison prototypes:',root.resolve())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
