{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('cores/bench/generated/r15_lutram_rf_probe');rtl=probe/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n(rtl/'reg_file.sv').write_text('''module reg_file (\n input logic clock, reset,\n input logic [4:0] rs1_addr,rs2_addr,\n output logic [31:0] rs1_data,rs2_data,\n input logic w_en,\n input logic [4:0] w_addr,\n input logic [31:0] w_data\n);\n (* syn_ramstyle = \\\"distributed\\\", ram_style = \\\"distributed\\\" *) logic [31:0] bank1 [0:31];\n (* syn_ramstyle = \\\"distributed\\\", ram_style = \\\"distributed\\\" *) logic [31:0] bank2 [0:31];\n logic [31:0] initialized_q;\n wire write_valid = w_en && w_addr \"'!= 0 && !reset;\n always_ff @(posedge clock) begin\n  if(write_valid) begin bank1[w_addr] <= w_data;bank2[w_addr] <= w_data;end\n end\n always_ff @(posedge clock) begin\n  if(reset) initialized_q <= 32'\"'b0;\n  else if(write_valid) initialized_q[w_addr] <= 1'b1;\n end\n always_comb begin\n  if(rs1_addr == 0) rs1_data = 0;\n  else if(w_en && w_addr == rs1_addr) rs1_data = w_data;\n  else rs1_data = initialized_q[rs1_addr] ? bank1[rs1_addr] : 32'b0;\n  if(rs2_addr == 0) rs2_data = 0;\n  else if(w_en && w_addr == rs2_addr) rs2_data = w_data;\n  else rs2_data = initialized_q[rs2_addr] ? bank2[rs2_addr] : 32'b0;\n end\nendmodule\n''')\nprint('Prepared mirrored LUT-RAM RF')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
