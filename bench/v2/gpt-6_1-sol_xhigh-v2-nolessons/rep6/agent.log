{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"sed -n '240,550p' cores/bench/test/test_ex_stage.py\"","aggregated_output":"                \"pc\": 0x80, \"rs1_val\": raw, \"rs2_val\": 0x12345678, \"imm\": imm,\n                \"rd\": 3, \"rs1_addr\": 1, \"rs2_addr\": 2, \"valid\": 1,\n                \"ctrl\": pack(CTRL_FIELDS, ctrl),\n            })\n            await Timer(1, \"ns\")\n            assert int(dut.out.value) == old, \"address must be registered with EX/MEM\"\n            await tick(dut)\n            out = unpack(EX_FIELDS, int(dut.out.value))\n            expected = (base + imm) & 0xFFFFFFFF\n            assert out[\"effective_addr\"] == expected\n            assert out[\"alu_result\"] == expected, \"legal memory ADD must match the address lane\"\n            assert out[\"rs1_val\"] == base and out[\"write_data\"] == 0x12345678\n            assert out[\"valid\"] and out[\"ctrl\"] == pack(CTRL_FIELDS, ctrl)\n\n    saved = int(dut.out.value)\n    dut.stall.value = 1\n    for index in range(8):\n        dut[\"in\"].value = payload(ALU_ADD, imm=index)\n        dut.fwd_rs1_sel.value = index % 3\n        dut.fwd_ex_mem.value = 0xFFFFFF00 + index\n        dut.fwd_mem_wb.value = 0x100 + index\n        await tick(dut)\n        assert int(dut.out.value) == saved, \"downstream hold changed the complete address payload\"\n    dut.reset.value = 1\n    await tick(dut)\n    assert int(dut.out.value) == 0, \"reset must clear the address even during a hold\"\n    dut.reset.value = 0\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    await tick(dut)\n    out = unpack(EX_FIELDS, int(dut.out.value))\n    assert out[\"effective_addr\"] == 0 and out[\"ctrl\"] == 0\n    assert not out[\"valid\"] and not out[\"fwd_ready\"]\n\n\n@cocotb.test()\nasync def effective_address_is_independent_of_generic_result_selection(dut):\n    await setup(dut)\n    base, rs2, imm, pc = 0x12345678, 3, 0x1000, 0x80\n    cases = (\n        ({\"alu_op\": ALU_ADD}, base + rs2),\n        ({\"alu_op\": ALU_SUB}, base - rs2),\n        ({\"alu_op\": ALU_AND}, base & rs2),\n        ({\"alu_op\": ALU_SLT}, 0),\n        ({\"alu_op\": ALU_SLL}, base << rs2),\n        ({\"alu_op\": ALU_LUI, \"alu_src\": 1, \"is_lui\": 1}, imm),\n        ({\"alu_op\": ALU_ADD, \"alu_src\": 1, \"is_auipc\": 1}, pc + imm),\n        ({\"alu_op\": ALU_ADD, \"is_jump\": 1}, pc + 4),\n        ({\"alu_op\": ALU_ADD, \"alu_src\": 1, \"is_jump\": 1, \"is_jalr\": 1}, pc + 4),\n    )\n    for selector in (0, 1, 2):\n        dut.fwd_rs1_sel.value = selector\n        dut.fwd_ex_mem.value = base\n        dut.fwd_mem_wb.value = base\n        for controls, result in cases:\n            controls = dict(controls, reg_write=1)\n            dut[\"in\"].value = pack(ID_FIELDS, {\n                \"pc\": pc, \"rs1_val\": base if selector == 0 else 0xBAD0BAD0,\n                \"rs2_val\": rs2, \"imm\": imm, \"rd\": 3, \"valid\": 1,\n                \"ctrl\": pack(CTRL_FIELDS, controls),\n            })\n            await tick(dut)\n            out = unpack(EX_FIELDS, int(dut.out.value))\n            assert out[\"effective_addr\"] == (base + imm) & 0xFFFFFFFF\n            assert out[\"alu_result\"] == result & 0xFFFFFFFF\n            assert out[\"alu_result\"] != out[\"effective_addr\"]\n            assert out[\"fwd_ready\"] and out[\"ctrl\"] == pack(CTRL_FIELDS, controls)\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"divider.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n","exit_code":0,"status":"completed"}}
