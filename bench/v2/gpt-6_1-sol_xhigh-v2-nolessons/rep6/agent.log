{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' tools/eval/gowin.py; sed -n '1,240p' cores/bench/test/test_multiplier.py; cat cores/bench/test/conftest.py\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[11904 of 14976 chars elided by tools/bench/transcript.py; sha256:ef50ee3b356e470b]…\n               test_module=\"test_multiplier\")\n\n\ndef test_multiplier_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / \"multiplier_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"multiplier.sv\"],\n                 hdl_toplevel=\"multiplier\", build_dir=build_dir, always=True,\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\", \"-DRISCV_FORMAL_ALTOPS\"])\n    runner.test(hdl_toplevel=\"multiplier\", test_module=\"test_multiplier\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"ALTOPS_MODE\": \"1\"})\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r15_mul_prepare_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv'; s=p.read_text(); token='    logic        fwd_ready;      // registered early-result eligibility\\\\n'; assert token in s\ns=s.replace(token,token+'    logic mul_sign_a, mul_sign_b, mul_high, mul_complete;\\\\n'); p.write_text(s)\np=rtl/'ex_stage.sv'; s=p.read_text(); token='    normal_payload.write_data    = rs2;'; assert token in s\ns=s.replace(token,'''    normal_payload.mul_sign_a = (in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU) && rs1[31];\n    normal_payload.mul_sign_b = (in.ctrl.alu_op == ALU_MULH) && rs2[31];\n    normal_payload.mul_high = (in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU);\n    normal_payload.mul_complete = in.valid && \"'!in.ctrl.is_illegal &&\n                                  (in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH ||\n                                   in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU);\n'\"'''+token)\ns=s.replace(\\\"        reg_q.fwd_ready <= 1'b0;\\\", \\\"        reg_q.fwd_ready <= 1'b0;\\\\n        reg_q.mul_complete <= 1'b0;\\\")\np.write_text(s)\np=rtl/'multiplier.sv'; s=p.read_text(); s+='''\nmodule prepared_multiplier (\n  input logic signed [32:0] a,\n  input logic signed [32:0] b,\n  input logic select_high,\n  output logic [31:0] result\n);\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign product = a * b;\n  assign result = select_high ? product[63:32] : product[31:0];\nendmodule\n'''; p.write_text(s)\np=rtl/'mem_stage.sv'; s=p.read_text(); start=s.index('  assign is_mul = '); end=s.index('  // All shifts complete',start)\ns=s[:start]+'''  assign is_mul = in.mul_complete;\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  multiplier u_multiplier (\n    .op (in.ctrl.alu_op), .rs1_val (in.rs1_val), .rs2_val (in.rs2_val),\n    .result (mul_result)\n  );\n`else\n  prepared_multiplier u_multiplier (\n    .a ($signed({in.mul_sign_a, in.rs1_val})),\n    .b ($signed({in.mul_sign_b, in.rs2_val})),\n    .select_high (in.mul_high), .result (mul_result)\n  );\n`endif\n\n'\"'''+s[end:];p.write_text(s)\nprint('Prepared isolated RTL:',rtl)\nPY\nverilator --lint-only -Wall -Wno-MULTITOP -Wno-fatal -sv +incdir+cores/bench/generated/r15_mul_prepare_probe/rtl cores/bench/generated/r15_mul_prepare_probe/rtl/core_pkg.sv cores/bench/generated/r15_mul_prepare_probe/rtl/alu.sv cores/bench/generated/r15_mul_prepare_probe/rtl/branch_predictor.sv cores/bench/generated/r15_mul_prepare_probe/rtl/core.sv cores/bench/generated/r15_mul_prepare_probe/rtl/decoder.sv cores/bench/generated/r15_mul_prepare_probe/rtl/divider.sv cores/bench/generated/r15_mul_prepare_probe/rtl/ex_stage.sv cores/bench/generated/r15_mul_prepare_probe/rtl/fetch_queue.sv cores/bench/generated/r15_mul_prepare_probe/rtl/forward_unit.sv cores/bench/generated/r15_mul_prepare_probe/rtl/hazard_unit.sv cores/bench/generated/r15_mul_prepare_probe/rtl/id_stage.sv cores/bench/generated/r15_mul_prepare_probe/rtl/if_stage.sv cores/bench/generated/r15_mul_prepare_probe/rtl/imm_gen.sv cores/bench/generated/r15_mul_prepare_probe/rtl/mem_stage.sv cores/bench/generated/r15_mul_prepare_probe/rtl/multiplier.sv cores/bench/generated/r15_mul_prepare_probe/rtl/reg_file.sv cores/bench/generated/r15_mul_prepare_probe/rtl/wb_stage.sv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
