{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nbase=Path(os.environ['TMPDIR'])/'hypgen-r6s0'\nfor kind in ('opbits','wbretime_opbits','result_flat'):\n p=base/kind; src=base/'wbretime' if kind.startswith('wbretime') else Path('cores/bench')\n for name in ('rtl','test'): shutil.copytree(src/name,p/name,dirs_exist_ok=True)\n f=p/'rtl/alu.sv'; s=f.read_text()\n if kind.endswith('opbits'):\n  s=s.replace('    a_signed = (op == ALU_MULH || op == ALU_MULHSU);','    a_signed = \"'!op[0];'\"')\n  s=s.replace('    b_signed = (op == ALU_MULH);','    b_signed = \"'!op[0] && !op[1];'\"')\n  s=s.replace('      ALU_MUL:    out = mul_product[31:0];\\\\n      ALU_MULH, ALU_MULHU, ALU_MULHSU: out = mul_product[63:32];','      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU:\\\\n        out = op[2] ? mul_product[63:32] : mul_product[31:0];')\n else:\n  s=s.replace('  output logic [31:0] out\\\\n','  output logic [31:0] out,\\\\n  output logic [31:0] base_out,\\\\n  output logic [31:0] multiply_out\\\\n')\n  pos=s.index('    case (op)')\n  s=s[:pos]+'''\"'`ifdef RISCV_FORMAL_ALTOPS\n    case (op)\n      ALU_MUL:    multiply_out = (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   multiply_out = (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  multiply_out = (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: multiply_out = (a - b) \"'^ 32'\"'hecfbe137;\n      default:    multiply_out = 32'b0;\n    endcase\n\"'`else\n    multiply_out = op[2] ? mul_product[63:32] : mul_product[31:0];\n`endif\n    case (op)\n      ALU_ADD: base_out = a + b;\n      ALU_SUB: base_out = a - b;\n      ALU_AND: base_out = a & b;\n      ALU_OR: base_out = a | b;\n      ALU_XOR: base_out = a ''^ b;\n      ALU_SLT: base_out = {31'\"'b0, \"'$signed(a) < $signed(b)};\n      ALU_SLTU: base_out = {31'\"'b0, a < b};\n      ALU_SLL: base_out = a << shamt;\n      ALU_SRL: base_out = a >> shamt;\n      ALU_SRA: base_out