{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/preselect_probe'); rtl=root/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv'; s=p.read_text().replace('    logic [31:0] imm;\\\\n    logic [4:0]  rd;', '    logic [31:0] imm;\\\\n    logic [31:0] alu_base_a;\\\\n    logic [31:0] alu_base_b;\\\\n    logic [4:0]  rd;'); p.write_text(s)\np=rtl/'id_stage.sv'; s=p.read_text().replace('        reg_q.imm      <= imm;', '        reg_q.imm      <= imm;\\\\n        reg_q.alu_base_a <= dec_is_auipc ? in.pc : rs1_data;\\\\n        reg_q.alu_base_b <= dec_alu_src ? imm : rs2_data;'); p.write_text(s)\np=rtl/'ex_stage.sv'; s=p.read_text().replace('    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\\\\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;', '''    case (in.ctrl.is_auipc ? 2'd0 : fwd_rs1_sel)\n      2'd1: alu_a = fwd_ex_mem;\n      2'd2: alu_a = fwd_mem_wb;\n      default: alu_a = in.alu_base_a;\n    endcase\n    case (in.ctrl.alu_src ? 2'd0 : fwd_rs2_sel)\n      2'd1: alu_b = fwd_ex_mem;\n      2'd2: alu_b = fwd_mem_wb;\n      default: alu_b = in.alu_base_b;\n    endcase'''); p.write_text(s)\ntest=root/'test'; test.mkdir(exist_ok=True)\nfor name in ['conftest.py','_helpers.py','test_pipeline.py']: shutil.copy2(Path('cores/bench/test')/name,test/name)\nprint('ID source preselection probe prepared')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
