'h6f;\n assign pre_jalr = imem_data[6:0] == 7'h67 && imem_data[14:12] == 3'd0;\n assign direct_aligned = pre_jal ? \"'!imem_data[21] : !imem_data[8];\n for (genvar e=0;e<32;e++) begin : gen_predictor\n  localparam logic [4:0] INDEX=5'\"'(e);\n  logic valid_q;\n  logic [24:0] tag_q;\n  logic [29:0] target_q;\n  logic [1:0] kind_q, counter_q;\n  wire tag_match = tag_q == pc[31:7];\n  wire train_match = tag_q == train_pc[31:7] && kind_q == train_kind;\n  wire eligible = (kind_q == 2'd0 && pre_branch && direct_aligned && counter_q[1]) ||\n                  (kind_q == 2'd1 && pre_jal && direct_aligned) ||\n                  (kind_q == 2'd2 && pre_jalr);\n  assign select_hits[e] = valid_q && pc[6:2] == INDEX && tag_match && eligible;\n  assign selected_targets[e] = {32{select_hits[e]}} & {target_q, 2'b00};\n  always_ff @(posedge clock) begin\n   if(reset) begin\n    valid_q <= 1'b0; counter_q <= 2'b01;\n   end else if(train_valid && train_pc[6:2] == INDEX) begin\n    valid_q <= 1'b1;\n    tag_q <= train_pc[31:7]; target_q <= train_target[31:2]; kind_q <= train_kind;\n    if(\"'!valid_q || !train_match) counter_q <= train_taken ? 2'\"'b10 : 2'b01;\n    else case(counter_q)\n      2'b00: counter_q <= train_taken ? 2'b01 : 2'b00;\n      2'b01: counter_q <= train_taken ? 2'b10 : 2'b00;\n      2'b10: counter_q <= train_taken ? 2'b11 : 2'b01;\n      default: counter_q <= train_taken ? 2'b11 : 2'b10;\n    endcase\n   end\n  end\n end\n for(genvar g=0;g<4;g++) begin : gen_lookup\n  assign target_groups[g] = selected_targets[g*8] | selected_targets[g*8+1] |\n      selected_targets[g*8+2] | selected_targets[g*8+3] | selected_targets[g*8+4] |\n      selected_targets[g*8+5] | selected_targets[g*8+6] | selected_targets[g*8+7];\n end\n assign predicted_target = target_groups[0] | target_groups[1] | target_groups[2] | target_groups[3];\n assign predicted_taken = |select_hits;\n assign sequential_pc = pc + 32'd4;\n assign next_pc = predicted_taken ? predicted_target : sequential_pc;\n always_ff @(posedge clock) begin\n  if(reset) pc <= 32'b0;\n  else if(redirect) pc <= redirect_target;\n  else if(\"'!stall) pc <= next_pc;\n end\n assign imem_addr = pc;\n always_comb begin\n  out.pc = pc;\n  out.recovery_addr = sequential_pc;\n  out.predicted_next_pc = next_pc;\n  out.predicted_taken = predicted_taken;\n  out.direct_aligned = direct_aligned;\n  out.instr = imem_data;\n  out.valid = !(flush || redirect);\n end\nendmodule\n'\"''')\nPY\npython3 cores/bench/generated/r10-predictor-trial/prototype.py\nRTL_DIR=cores/bench/generated/r10-predictor-trial/rtl OBJ_DIR=cores/bench/generated/r10-predictor-trial/obj_dir NRET=1 bash test/cosim/build.sh > cores/bench/generated/r10-predictor-trial/cosim-build.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
