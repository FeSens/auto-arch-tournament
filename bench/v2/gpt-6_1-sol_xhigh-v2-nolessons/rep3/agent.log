{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/CORE_PHILOSOPHY.md\nrg -n 'timing:|fpga:|coremark|TARGET|GOWIN' Makefile\nrg -n 'trace|class|def step|MMIO' test/cosim/reference.py\nrg --files -g '*.elf' -g '*.bin' -g '*trace*' -g '*gowin*' -g '*timing*' | head -80\"", "aggregated_output": "17:#   BASE     — when forking a new TARGET, copy from cores/<BASE>/.\n22:#              at .worktrees/<TARGET>/ on branch core-<TARGET> and re-execs\n24:#              TARGETs run in parallel without git index/merge collisions.\n26:#              an explicit empty value: `make loop TARGET=v1 WORKTREE=`.\n42:  ORCH_FLAGS += --coremark-target $(COREMARK)\n48:# Multi-core: TARGET selects the core under cores/<TARGET>/.\n49:# TARGET is required for all core-touching targets (enforced below).\n50:TARGET ?=\n52:# Targets that require TARGET=<core_name>.\n53:CORE_TARGETS := lint test cosim cosim-build formal formal-deep fpga next loop\n55:ifeq ($(strip $(TARGET)),)\n56:  ifneq ($(filter $(MAKECMDGOALS),$(CORE_TARGETS)),)\n57:    $(error TARGET= required. Available cores: $(notdir $(wildcard cores/*)))\n61:ifneq ($(strip $(TARGET)),)\n62:  RTL_DIR    := cores/$(TARGET)/rtl\n63:  TEST_DIR   := cores/$(TARGET)/test\n64:  CORE_NAME  := $(TARGET)\n65:  OBJ_DIR    := cores/$(TARGET)/obj_dir\n66:  GEN_DIR    := cores/$(TARGET)/generated\n67:  ORCH_TARGET_FLAG := --target $(TARGET)\n69:  WT_BRANCH  := core-$(TARGET)\n70:  WT_PATH    := $(CURDIR)/.worktrees/$(TARGET)\n76:\t@echo \"Targets (most accept TARGET=<core_name>):\"\n77:\t@echo \"  make lint TARGET=v1     — verilator lint over cores/<TARGET>/rtl/*.sv\"\n78:\t@echo \"  make test TARGET=v1     — cocotb unit tests under cores/<TARGET>/test/\"\n79:\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\n80:\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\n81:\t@echo \"  make formal-deep TARGET=v1 — full formal suite without