{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '270,520p' cores/bench/test/test_alu.py; cat cores/bench/test/_helpers.py\"", "aggregated_output": "\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Real divides only (avoid edge-case short-circuit) so each pass\n    # exercises all 32 restoring steps plus preparation and correction.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def randomized_m_extension(dut):\n    \"\"\"Keep all eight real M operations covered beyond the fixed vectors.\"\"\"\n    await _setup(dut)\n    rng = random.Random(0xA1D1)\n    for _ in range(64):\n        a, b = rng.getrandbits(32), rng.getrandbits(32)\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        await _check_mul(dut, ALU_MUL, a, b, a * b)\n        await _check_mul(dut, ALU_MULH, a, b, (sa * sb) >> 32)\n        await _check_mul(dut, ALU_MULHU, a, b, (a * b) >> 32)\n        await _check_mul(dut, ALU_MULHSU, a, b, (sa * b) >> 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        await _check_div(dut, ALU_DIV, a, b, q)\n        await _check_div(dut, ALU_REM, a, b, sa - q * sb)\n        await _check_div(dut, ALU_DIVU, a, b, a // b)\n        await _check_div(dut, ALU_REMU, a, b, a % b)\n\n\n@cocotb.test()\nasync def selected_unit_holds_result_and_gates_integer_handshakes(dut):\n    \"\"\"Changing the result selection cannot consume the unselected unit.\"\"\"\n    await _setup(dut)\n    for op, a, b, expected in ((ALU_MULHU, MASK32, MASK32, 0xFFFFFFFE),\n                                (ALU_DIVU, 100, 7, 14)):\n        dut.op.value = op\n        dut.a.value = a\n        dut.b.value = b\n        dut.div_req_valid.value = 1\n        await Timer(1, \"ns\")\n        assert int(dut.div_req_ready.value)\n  \n…[2559 of 5631 chars elided by tools/bench/transcript.py; sha256:10a35f43db7b0db7]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
