{"type": "item.started", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/rtl')\nbak=Path('/srv/hwebench/tmp/f88745d5/e8e17466/r9s1-original-rtl')\nshutil.copytree(root,bak,dirs_exist_ok=True)\np=root/'core_pkg.sv'; s=p.read_text(); s=s.replace('  // ID/EX register payload.', '''  typedef struct packed {\n    logic [31:0] add_result;\n    logic [31:0] sub_result;\n    logic [31:0] logic_result;\n    logic [31:0] shift_result;\n    logic [31:0] compare_result;\n    logic [31:0] immediate_result;\n    logic [31:0] link_result;\n    logic [31:0] m_result;\n    logic [7:0] select;\n  } integer_lanes_t;\n\n  // ID/EX register payload.'''); s=s.replace('    logic        is_multiply;', '    logic [7:0]  result_select;\\\\n    logic        is_multiply;'); p.write_text(s)\np=root/'id_stage.sv';s=p.read_text();s=s.replace('        reg_q.pc       <= in.pc;', '''        reg_q.result_select <= 8'b0;\n        if (dec_is_jump) reg_q.result_select <= 8'h40;\n        else if (dec_is_branch) reg_q.result_select <= 8'h20;\n        else case (dec_alu_op)\n          ALU_ADD: reg_q.result_select <= 8'h01;\n          ALU_SUB: reg_q.result_select <= 8'h02;\n          ALU_AND, ALU_OR, ALU_XOR: reg_q.result_select <= 8'h04;\n          ALU_SLL, ALU_SRL, ALU_SRA: reg_q.result_select <= 8'h08;\n          ALU_SLT, ALU_SLTU: reg_q.result_select <= 8'h10;\n          ALU_LUI: reg_q.result_select <= 8'h20;\n          ALU_MUL, ALU_MULH, ALU_MULHSU, ALU_MULHU,\n          ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU:\n                   reg_q.result_select <= 8'h80;\n          default: reg_q.result_select <= 8'b0;\n        endcase\n        reg_q.pc       <= in.pc;''');p.write_text(s)\np=root/'alu.sv';s=p.read_text();s=s.replace('  output logic [31:0] out\\\\n', '''  output logic [31:0] add_result,\n  output logic [31:0] sub_result,\n  output logic [31:0] logic_result,\n  output logic [31:0] shift_