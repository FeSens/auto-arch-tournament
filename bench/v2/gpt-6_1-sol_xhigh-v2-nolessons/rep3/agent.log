{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' test/cosim/build.sh\"","aggregated_output":"#!/usr/bin/env bash\n# Build the Verilator-based cosim binary that drives `core` against an ELF\n# program. Produces $OBJ_DIR/cosim_sim (default: test/cosim/obj_dir/cosim_sim).\n#\n# RTL_DIR (default: rtl/) is globbed dynamically (with core_pkg.sv forced\n# first because its compilation-unit-scope typedefs and localparams must be\n# visible before any module references them). Hypotheses are allowed to add,\n# rename, or delete files inside rtl/, so a hardcoded file list would\n# silently break restructuring hypotheses.\nset -euo pipefail\n\nREPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nCOSIM_DIR=\"$REPO_ROOT/test/cosim\"\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${OBJ_DIR:-}\" ]; then\n  echo \"ERROR: test/cosim/build.sh requires RTL_DIR and OBJ_DIR env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl OBJ_DIR=cores/v1/obj_dir bash test/cosim/build.sh\" >&2\n  exit 2\nfi\n\n# NRET picks which RVFI port set main.cpp expects on `core`.\n# 1 = single-issue (only `_0` ports); 2 = dual-channel (both `_0` and `_1`).\n# Default 2 preserves existing behavior; orchestrator sets to 1 for cores\n# whose core.yaml declares nret: 1.\nNRET=\"${NRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/rtl')\nbackup=Path('/srv/hwebench/tmp/f88745d5/54fa2f1a/predictor_trial_backup')\nbackup.mkdir(parents=True,exist_ok=True)\nfor p in root.glob('*.sv'): shutil.copy2(p,backup/p.name)\n\ndef edit(name,old,new):\n p=root/name;s=p.read_text();assert old in s,(name,old);p.write_text(s.replace(old,new))\n\nfields='''    logic        predicted_taken;\n    logic [31:0] direct_target;\n    logic [31:0] fallthrough_pc;\n    logic [31:0] recovery_pc;\n    logic        direct_aligned;\n'''\nedit('core_pkg.sv','    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;',fields+'    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;')\nedit('core_pkg.sv','    ctrl_t       ctrl;\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;','    ctrl_t       ctrl;\\\\n'+fields+'    logic [2:0]  mismatch_op;\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;')\nedit('id_stage.sv','        reg_q.pc       <= in.pc;','''        reg_q.pc       <= in.pc;\n        reg_q.predicted_taken <= in.predicted_taken;\n        reg_q.direct_target <= in.direct_target;\n        reg_q.fallthrough_pc <= in.fallthrough_pc;\n        reg_q.recovery_pc <= in.recovery_pc;\n        reg_q.direct_aligned <= in.direct_aligned;\n        reg_q.mismatch_op <= dec_branch_op \"'^ {2'\"'b00, in.predicted_taken};''')\nedit('if_stage.sv','  output logic [31:0]       imem_addr,','''  input logic train_valid,\n  input logic [31:0] train_pc,\n  input logic train_taken,\n  output logic [31:0]       imem_addr,''')\nedit('if_stage.sv','  logic [31:0] next_pc;','''  logic [31:0] next_pc;\n  logic [63:0] directions;\n  logic [5:0] read_index, train_index;\n  logic legal_branch, is_jal, prediction, aligned;\n  logic [31:0] direct_imm, direct_target, fallthrough_pc, recovery_pc;\n  assign read_index = pc[7:2] \"'^ pc[13:8];\n  assign train_index = train_pc[7:2] ''^ train_pc[13:8];\n  for (genvar i=0;i<64;i++) begin: direction_entry\n    always_ff @(posedge clock) begin\n      if (reset) directions[i] <= 1'\"'b0;\n      else if (train_valid && train_index == 6'(i)) directions[i] <= train_taken;\n    end\n  end\n  always_comb begin\n    legal_branch = imem_data[6:0] == 7'b1100011 &&\n                   imem_data[14:12] \"'!= 3'\"'d2 && imem_data[14:12] \"'!= 3'\"'d3;\n    is_jal = imem_data[6:0] == 7'b1101111;\n    direct_imm = is_jal\n      ? {{11{imem_data[31]}},imem_data[31],imem_data[19:12],imem_data[20],imem_data[30:21],1'b0}\n      : {{19{imem_data[31]}},imem_data[31],imem_data[7],imem_data[30:25],imem_data[11:8],1'b0};\n    direct_target = pc + direct_imm;\n    fallthrough_pc = pc + 32'd4;\n    aligned = direct_target[1:0] == 2'b00;\n    prediction = aligned && (is_jal || (legal_branch && directions[read_index]));\n    recovery_pc = prediction ? fallthrough_pc : direct_target;\n  end''')\nedit('if_stage.sv',\\\"    next_pc = redirect ? redirect_target : pc + 32'd4;\\\",\\\"    next_pc = prediction ? direct_target : fallthrough_pc;\\\")\nedit('if_stage.sv','    out.pc    = pc;','''    out.pc    = pc;\n    out.predicted_taken = prediction;\n    out.direct_target = direct_target;\n    out.fallthrough_pc = fallthrough_pc;\n    out.recovery_pc = recovery_pc;\n    out.direct_aligned = aligned;''')\nedit('ex_stage.sv','  output logic [31:0]        redirect_target\\\\n','''  output logic [31:0]        redirect_target,\n  output logic train_valid,\n  output logic [31:0] train_pc,\n  output logic train_taken\n''')\nedit('ex_stage.sv','  logic        branch_cond;','''  logic        branch_cond;\n  logic        mismatch_cond;\n  logic normal_advance;\n  assign normal_advance = in.valid && \"'!stall && !is_divide && !divide_active_q;'\"''')\nedit('ex_stage.sv','    branch_taken  = in.ctrl.is_branch && branch_cond;','''    case (in.mismatch_op)\n      BR_BEQ: mismatch_cond = rs1 == rs2;\n      BR_BNE: mismatch_cond = rs1 \"'!= rs2;\n      BR_BLT: mismatch_cond = $signed(rs1) < $signed(rs2);\n      BR_BGE: mismatch_cond = $signed(rs1) >= $signed(rs2);\n      BR_BLTU: mismatch_cond = rs1 < rs2;\n      BR_BGEU: mismatch_cond = rs1 >= rs2;\n      default: mismatch_cond = 1'\"'b0;\n    endcase\n    branch_taken  = in.ctrl.is_branch && branch_cond;''')\nedit('ex_stage.sv','    branch_target = in.pc + in.imm;','    branch_target = in.direct_target;')\nedit('ex_stage.sv','                                  : (in.pc + in.imm);','                                  : in.direct_target;')\nedit('ex_stage.sv','  assign redirect        = in.valid && (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"\\\\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;','''  assign redirect = normal_advance &&\n    ((in.ctrl.is_branch && in.direct_aligned && mismatch_cond) ||\n     (in.ctrl.is_jump && \"'!misalign_fault && !in.predicted_taken));\n  assign redirect_target = in.ctrl.is_jalr ? jump_target : in.recovery_pc;\n  assign train_valid = normal_advance && in.ctrl.is_branch && !in.ctrl.is_illegal && in.direct_aligned;\n  assign train_pc = in.pc;\n  assign train_taken = branch_taken;'\"''')\nedit('ex_stage.sv',\\\"(in.pc + 32'd4)\\\",\\\"in.fallthrough_pc\\\")\nedit('core.sv','  logic [31:0] redirect_target;','''  logic [31:0] redirect_target;\n  logic train_valid, train_taken;\n  logic [31:0] train_pc;''')\nedit('core.sv','    .imem_addr       (io_imemAddr),','''    .train_valid (train_valid),\n    .train_taken (train_taken),\n    .train_pc (train_pc),\n    .imem_addr       (io_imemAddr),''')\nedit('core.sv','    .redirect_target (redirect_target)\\\\n  );','''    .redirect_target (redirect_target),\n    .train_valid (train_valid),\n    .train_taken (train_taken),\n    .train_pc (train_pc)\n  );''')\nprint('Temporary trial RTL prepared; pristine RTL saved outside worktree.')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
