{"type": "item.completed", "item": {"id": "item_61", "type": "command_execution", "command": "/bin/bash -c \"rg -n -A20 'def _read_notes' tools/tournament.py; sed -n '1,180p' cores/bench/rtl/if_stage.sv; sed -n '135,180p' cores/bench/rtl/ex_stage.sv; tail -10 \\\"\"'$TMPDIR/bench-direction-local-recovery-timing.log\"; date -u'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + prediction + instr + valid) is *combinational* — no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Decode always sees the raw bus payload, including during a redirect or\n// an instruction-bus stall. Only validity marks an unavailable/killed\n// fetch, keeping redirect control out of decode and regfile addressing.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // kill fetch validity only\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              branch_train_valid,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0]       branch_train_pc,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic              branch_train_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [1:0] direction_q [0:63];\n  logic [5:0] fetch_index, train_index;\n  logic legal_branch, direct_jump, predicted_taken;\n  logic [31:0] direct_imm, direct_target;\n\n  assign fetch_index = pc[7:2] ^ pc[13:8];\n  assign train_index = branch_train_pc[7:2] ^ branch_train_pc[13:8];\n\n  // Raw predecode and counter lookup never depend on recovery, hazards or\n  // bus readiness. B and J immediates share a single PC-relative adder.\n  always_comb begin\n    legal_branch = imem_data[6:0] == 7'b1100011 &&\n                   imem_data[14:12] != 3'd2 && imem_data[14:12] != 3'd3;\n    direct_jump = \n…[3210 of 6282 chars elided by tools/bench/transcript.py; sha256:9fbf9675a2a7721f]…\nassign branch_train_taken = branch_taken;\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n  ex_mem_t normal_result;\n\n  always_comb begin\n    normal_result = '0;\n    normal_result.pc            = in.pc;\n    normal_result.alu_result    = in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n    normal_result.write_data    = rs2;\n    normal_result.rd            = in.rd;\n    normal_result.rs1_addr      = in.rs1_addr;\n    normal_result.rs2_addr      = in.rs2_addr;\n    normal_result.rs1_val       = rs1;\n    normal_result.rs2_val       = rs2;\n    normal_result.pc_next       = misalign_fault   ? (in.pc + 32'd4)\n                               : in.ctrl.is_jump ? jump_target\n                               : branch_taken    ? branch_target\n                                                 : (in.pc + 32'd4);\n    normal_result.branch_taken  = branch_taken;\n    normal_result.branch_target = branch_target;\n    normal_result.ctrl          = ctrl_with_trap;\nSun Oct  4 15:32:36 UTC 2026\n", "exit_code": 0, "status": "completed"}}
