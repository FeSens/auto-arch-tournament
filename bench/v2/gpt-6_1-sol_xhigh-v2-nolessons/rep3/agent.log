{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/predictor_research'); out=root/'uniform_jalr'/'rtl'; out.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,out/p.name)\np=out/'ex_stage.sv'; s=p.read_text()\ns=s.replace('  logic recovery_valid_q;','  logic recovery_valid_q;\\\\n  logic recovery_jalr_aligned_q;')\ns=s.replace('  assign redirect_target = reg_q.ctrl.is_jalr','  assign redirect_target = recovery_jalr_aligned_q')\ns=s.replace('                        : (\"'!is_divide && normal_result.ctrl.reg_write));'\"', '''                        : (\"'!is_divide && in.valid && !recovery_valid_q &&\n                           in.ctrl.reg_write &&\n                           (!in.ctrl.is_jump || in.ctrl.is_jalr || in.direct_aligned)));'\"''')\ns=s.replace(\\\"      recovery_valid_q <= 1'b0;\\\", \\\"      recovery_valid_q <= 1'b0;\\\\n      recovery_jalr_aligned_q <= 1'b0;\\\")\ns=s.replace('                             (in.ctrl.is_jalr && \"'!misalign_jump));'\"', '''                             in.ctrl.is_jalr);\n        recovery_jalr_aligned_q <= in.ctrl.is_jalr && \"'!misalign_jump;'\"''')\np.write_text(s)\nprint('Prepared uniform JALR recovery trial.')\nPY\npython3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nimport json\nwt=Path.cwd(); root=wt/'cores/bench/generated/predictor_research'\ndef trial(pair):\n name,opt=pair\n r=build(wt,root/name/'rtl','fpga/core_bench_si.sv',opt,root/name/('gowin_p'+str(opt)))\n (root/name/('timing_p'+str(opt)+'.json')).write_text(json.dumps(r,indent=2))\n print(name,opt,json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=3) as pool:\n list(pool.map(trial,(('uniform_jalr',0),('uniform_jalr',1),('mismatch_onehot',1))))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
