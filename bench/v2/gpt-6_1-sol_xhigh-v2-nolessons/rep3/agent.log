t retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"r\n…[9691 of 12763 chars elided by tools/bench/transcript.py; sha256:c0ead84bd28e7bb0]…\n  LW(3, 0, 0x108), ADDI(5, 0, 3),\n               LW(6, 0, 0x108), ADDI(7, 0, 0),\n               LW(0, 0, 0x108), ADDI(8, 0, 0),\n               BEQ(0, 0, 8), SW(4, 0, 0x200), ADD(9, 4, 5), EBREAK()]\n    observed = []\n    rets, _ = await _run(dut, program, {0x100: 0x104, 0x104: 10, 0x108: 99},\n                         observations=observed)\n    _check_stream(rets, program, skipped=(10,))\n    results = {r[\"pc\"]: r for r in rets}\n    for older, younger, gap in ((0, 4, 2), (4, 8, 2), (12, 16, 2),\n                                (20, 24, 1), (28, 32, 1), (36, 44, 2)):\n        assert results[younger][\"cycle\"] - results[older][\"cycle\"] == gap\n    assert results[8][\"rd_wdata\"] == 20 and results[44][\"rd_wdata\"] == 23\n    assert sum(o[\"kill_valid\"] and not o[\"redirect\"] for o in observed) == 3\n    assert any(not o[\"ex_valid\"] and o[\"ex_instr\"] == program[1] for o in observed)\n    requests = [o[\"request\"][0] for o in observed if o[\"request\"][3]]\n    assert requests == [0x100, 0x104, 0x108, 0x108, 0x108]\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
