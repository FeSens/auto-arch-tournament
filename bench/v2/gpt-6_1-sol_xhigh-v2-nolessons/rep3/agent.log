88 MHz and 4,773,836 bracketed\\nCoreMark cycles. No LESSONS.md exists. Recent micro_opt mux folding\\nfailed the acceptance margin. Moving all four multiplies into a shared\\nregistered unit improved Fmax, but increased CoreMark cycles from\\n4,491,817 to 4,773,836: 282,019 extra cycles, approximately 6.28 percent.\\nLow MUL now waits for operand capture, products, reduction and result\\ntransfer even though its low 32 bits need no high-half or si\n13:{\"id\": \"hyp-20261004-\n…[12179 of 15251 chars elided by tools/bench/transcript.py; sha256:1cddb35dda352722]…\nree add \"$(WT_PATH)\" $(WT_BRANCH); \\\n\t  else \\\n\t    git worktree add -b $(WT_BRANCH) \"$(WT_PATH)\"; \\\n\t  fi; \\\n\t  [ -e \"$(WT_PATH)/formal/riscv-formal\" ] || ln -s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\n\tfi\n\t@$(MAKE) -C \"$(WT_PATH)\" loop \\\n\t  WORKTREE= \\\n\t  TARGET=$(TARGET) N=$(N) K=$(K) AGENT=$(AGENT) \\\n\t  $(if $(strip $(BASE)),BASE=$(BASE),) \\\n\t  $(if $(strip $(COREMARK)),COREMARK=$(COREMARK),) \\\n\t  $(if $(strip $(LUT)),LUT=$(LUT),)\nelse\n\tAGENT_PROVIDER=$(AGENT) python3 -m tools.orchestrator $(ORCH_FLAGS) $(ORCH_TARGET_FLAG)\nendif\n\nreport:\n\tpython3 -m tools.orchestrator --report $(ORCH_TARGET_FLAG)\n\nclean:\n\trm -rf test/cosim/sim_build sim_build out\n\trm -rf experiments/worktrees\n\trm -f bench/programs/*.elf\n\trm -f test/*.result.xml\n\tfind test -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\n\tfind tools -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\nifneq ($(strip $(TARGET)),)\n\trm -rf $(OBJ_DIR)\n\trm -rf $(GEN_DIR)\n\trm -rf cores/$(TARGET)/sim_build\nendif\n", "exit_code": 0, "status": "completed"}}
