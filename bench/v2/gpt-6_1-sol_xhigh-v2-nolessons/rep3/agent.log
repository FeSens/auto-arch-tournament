{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/test/test_pipeline.py cores/bench/test/test_predictor.py; cat cores/bench/test/test_pipeline.py | tail -25'", "aggregated_output": "diff --git a/cores/bench/test/test_pipeline.py b/cores/bench/test/test_pipeline.py\nindex 2da33d8..ef8b4f9 100644\n--- a/cores/bench/test/test_pipeline.py\n+++ b/cores/bench/test/test_pipeline.py\n@@ -106,6 +106,24 @@ def _predictor_index(pc):\n     return ((pc >> 2) ^ (pc >> 8)) & 63\n \n \n+def _check_predictor_lookup(bank, pc, counters):\n+    \"\"\"Observe lookup identity and recoded state against binary counters.\"\"\"\n+    index = _predictor_index(pc)\n+    assert int(bank.lookup_index.value) == index\n+    row = int(bank.row_onehot.value)\n+    column = int(bank.column_onehot.value)\n+    assert row == 1 << (index >> 3) and row.bit_count() == 1\n+    assert column == 1 << (index & 7) and column.bit_count() == 1\n+    assert int(bank.lookup_select.value) == 1 << index, \"lookup selected the wrong entry\"\n+    assert int(bank.counter_msb.value) == sum((c >> 1) << i for i, c in enumerate(counters))\n+    # Fixed mapping of the original 00,01,10,11 states to direction/weakness\n+    # 00,01,11,10. The model still updates by binary saturating +/-1.\n+    assert int(bank.counter_weakness.value) == sum(int(c in (1, 2)) << i\n+                                                 for i, c in enumerate(counters))\n+    assert int(bank.selected_direction.value) == ((1 << index) if counters[index] >= 2 else 0)\n+    assert int(bank.direction.value) == counters[index] >> 1\n+\n+\n def _result_grants(payload):\n     # Low fields: valid(1), instr(32), ctrl(22), mismatch(3),\n     # direct_aligned(1), predicted_taken(1), then result_grants(12).\n@@ -149,6 +167,7 @@ async def _run(dut, program, dmem_init=None, max_cycles=200,\n     assert int(dut.fwd_rs1_sel.value) == 0 and int(dut.fwd_rs2_sel.value) == 0\n     assert int(dut.alu_a_sel.value) == 0 and int(dut.alu_b_sel.value) == 0\n     assert int(dut.mem_wb_w.value) == 0 and int(dut.wb_w_data.value) == 0\n+    _check_predictor_lookup(dut.u_if, 0, [1] * 64)\n     dut.reset.value = 0\n     blocked_request = None\n     counters = [1] * 64\n@@ -221,6 +240,8 @@ async def _run(dut, program, dmem_init=None, max_cycles=200,\n \n…[10887 of 13959 chars elided by tools/bench/transcript.py; sha256:a5564c09df183e2f]…\n) == 64\n        assert any(not o[\"ex_valid\"] and o[\"grants\"] != 0 for o in observed), \\\n            \"invalid payload captures did not exercise integer/link grants\"\n        for grant in (1 << 7, 1 << 8, 1 << 9):\n            assert any(o[\"ex_valid\"] and o[\"grants\"] == grant and\n                       (o[\"fwd_rs1\"] or o[\"fwd_rs2\"]) for o in observed)\n        if stalled:\n            assert any(o[\"hold_payload\"] and o[\"grants\"] == 1 << 9 and\n                       o[\"fwd_rs1\"] == 2 for o in observed), \\\n                \"memory hold did not exercise retained WB operands at the barrel\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
