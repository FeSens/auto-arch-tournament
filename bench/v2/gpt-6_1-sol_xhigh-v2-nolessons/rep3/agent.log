{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/rtl'); root=Path('cores/bench/generated/hyp-r11')\nfor name in ['early_arith','tree_compare','local_store']:\n shutil.copytree(base,root/name/'rtl',dirs_exist_ok=True)\np=root/'early_arith/rtl/alu.sv'\ns=p.read_text().replace('((a + b) & {32{result_grants[0]}})', '((a & {32{result_grants[0]}}) + (b & {32{result_grants[0]}}))').replace('((a - b) & {32{result_grants[1]}})', '((a & {32{result_grants[1]}}) - (b & {32{result_grants[1]}}))')\np.write_text(s)\ncmp='''\nmodule tree_compare32(input logic [31:0] a,b, output logic eq,lt_u,lt_s);\n wire [7:0] le,ee;\n wire [3:0] le2,ee2;\n wire [1:0] le4,ee4;\n for(genvar i=0;i<8;i++) begin : nibble\n  assign le[i] = a[i*4+:4] < b[i*4+:4];\n  assign ee[i] = a[i*4+:4] == b[i*4+:4];\n end\n for(genvar i=0;i<4;i++) begin : pair\n  assign le2[i] = le[i*2+1] | (ee[i*2+1] & le[i*2]);\n  assign ee2[i] = ee[i*2+1] & ee[i*2];\n end\n for(genvar i=0;i<2;i++) begin : quad\n  assign le4[i] = le2[i*2+1] | (ee2[i*2+1] & le2[i*2]);\n  assign ee4[i] = ee2[i*2+1] & ee2[i*2];\n end\n assign lt_u=le4[1] | (ee4[1]&le4[0]);\n assign eq=ee4[1]&ee4[0];\n assign lt_s=(a[31]\"'^b[31]) ? a[31] : lt_u;\nendmodule\n'\"'''\np=root/'tree_compare/rtl/alu.sv'\ns=p.read_text().replace('  logic        [4:0]  shamt;', '''  wire int_lt_u,int_lt_s;\n  tree_compare32 cmp_int(.a(a),.b(b),.eq(),.lt_u(int_lt_u),.lt_s(int_lt_s));\n  logic        [4:0]  shamt;''')\ns=s.replace('\"'$signed(a) < $signed(b)'\"','int_lt_s').replace('a < b','int_lt_u')\np.write_text(s+cmp)\np=root/'tree_compare/rtl/ex_stage.sv'\ns=p.read_text().replace('  // ── Branch resolve', '''  wire br_eq,br_lt_u,br_lt_s;\n  tree_compare32 cmp_branch(.a(rs1),.b(rs2),.eq(br_eq),.lt_u(br_lt_u),.lt_s(br_lt_s));\n  // ── Branch resolve''')\ns=s.replace('(rs1 == rs2)','br_eq').replace('(rs1 \"'!= rs2)'\"','\"'!br_eq'\"').replace('(\"'$signed(rs1) <  $signed(rs2))'\"','br_lt_s').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!br_lt_s'\"').replace('(rs1 <  rs2)','br_lt_u').replace('(rs1 >= rs2)','\"'!br_lt_u'\"')\np.write_text(s)\n# Another topology: move store-width replication into EX before the existing store-data register.\n# It is prepared for timing only, not a second proposal.\np=root/'local_store/rtl/ex_stage.sv'\ns=p.read_text().replace('  logic [31:0] alu_result;', '''  logic [31:0] replicated_store;\n  always_comb begin\n    case(in.ctrl.mem_width)\n      2'd0: replicated_store={4{rs2[7:0]}};\n      2'd1: replicated_store={2{rs2[15:0]}};\n      default: replicated_store=rs2;\n    endcase\n  end\n  logic [31:0] alu_result;''').replace('store_data_q <= rs2;', 'store_data_q <= replicated_store;')\np.write_text(s)\np=root/'local_store/rtl/mem_stage.sv'\ns=p.read_text()\nstart=s.index('    // Byte/halfword replication for stores.')\nend=s.index('    // Byte-lane mask shifted',start)\ns=s[:start]+'    wdata_rep = in.write_data;\\\\n\\\\n'+s[end:]\np.write_text(s)\nPY\npython3 -u - <<'PY'\nfrom pathlib import Path\nimport json,time\nfrom tools.eval.gowin import build_all,summarize\nwt=Path.cwd(); root=wt/'cores/bench/generated/hyp-r11'\nfor name in ['early_arith','tree_compare','local_store']:\n start=time.monotonic()\n r=build_all(wt,root/name/'rtl','fpga/core_bench_si.sv',root/name/'timing',options=(1,))\n print(name,json.dumps(r), 'seconds',round(time.monotonic()-start,1),flush=True)\n (root/name/'results.json').write_text(json.dumps(r,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
