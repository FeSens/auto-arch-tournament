{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '520,1060p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n\n@cocotb.test()\nasync def invalid_redirect_payloads_are_inert(dut):\n    \"\"\"Every side-effect/control class is captured raw on a redirect bubble.\"\"\"\n    wrong_path = [LW(3, 0, 0x104), SW(2, 0, 0x108), BEQ(0, 0, 52),\n                  JAL(3, 52), JALR(3, 1, 0), DIV(3, 1, 2), REM(3, 1, 2),\n                  MUL(3, 1, 2), MULH(3, 1, 2), MULHU(3, 1, 2), MULHSU(3, 1, 2)]\n    for wrong in wrong_path:\n        for stall_redirect in (False, True):\n            program = [ADDI(1, 0, 64), ADDI(2, 0, 7), BEQ(0, 0, 8), wrong,\n                       ADD(4, 3, 2), SW(4, 0, 0x200), EBREAK()]\n\n            def ready(cycle, request):\n                return (int(not (stall_redirect and int(dut.io_imemAddr.value) == 12)), 1)\n\n            observed = []\n            rets, dmem = await _run(dut, program, {0x104: 99},\n                                    ready_fn=ready, observations=observed)\n            _check_stream(rets, program, skipped=(3,))\n            results = {r[\"pc\"]: r for r in rets}\n            assert results[16][\"rd_wdata\"] == 7, \"invalid writer poisoned forwarding\"\n            assert dmem == {0x104: 99, 0x200: 7}\n            assert not any(o[\"launch\"] for o in observed), \"wrong-path divide launched\"\n            assert any(not o[\"ex_valid\"] and o[\"ex_instr\"] == wrong for o in observed)\n            accepted = [o[\"request\"][0] for o in observed\n                        if o[\"dready\"] and (o[\"request\"][2] or o[\"request\"][3])]\n            assert accepted == [0x200], \"invalid load/store issued a request\"\n            assert results[16][\"cycle\"] - results[8][\"cycle\"] == 2, \"taken branch bubble changed\"\n            [recovery] = [o for o in observed if o[\"redirect\"]]\n            assert recovery[\"iready\"] == int(not stall_redirect)\n\n\n@