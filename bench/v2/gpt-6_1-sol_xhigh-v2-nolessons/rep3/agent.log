ame used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[11664 of 14736 chars elided by tools/bench/transcript.py; sha256:ba9c92e6f715ed22]…\n                    (\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\")],\n                 hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n                 parameters={\"SEPARATE_M\": 1, \"PREDECODED_RESULT\": 1},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"+define+RISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir),\n                test_filter=\"predecoded_.*\",\n                extra_env={\"PREDECODED_ALU\": \"1\", \"PREDECODED_ALTOPS\": str(int(altops))})\n\n\ndef test_predecoded_alu_runner():\n    _predecoded_runner(False)\n\n\ndef test_predecoded_altops_alu_runner():\n    _predecoded_runner(True)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
