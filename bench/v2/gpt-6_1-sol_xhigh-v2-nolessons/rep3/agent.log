kg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[12574 of 15646 chars elided by tools/bench/transcript.py; sha256:33958bf7eda0d033]…\nlfs and coremark is None:\n        return {'passed': False, 'failed_elf': 'none', 'detail': 'no ELFs found'}\n\n    # 1. Full-trace cosim of small ELFs (parallel).\n    with ThreadPoolExecutor() as pool:\n        futures = {pool.submit(run_one, elf, sim_bin, worktree, env, flags): elf\n                   for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Oct  5 01:01 .\ndrwxrwx---+ 12 nobody nogroup  4096 Oct  5 01:01 ..\n-rw-rw----+  1 nobody nogroup  2630 Oct  5 01:01 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Oct  5 01:01 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Oct  5 01:01 checks_si.cfg\nlrwxrwxrwx   1 nobody nogroup    76 Oct  5 01:01 riscv-formal -> /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep3/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Oct  5 01:01 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Oct  5 01:01 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Oct  5 01:01 wrapper_si.sv\n", "exit_code": 0, "status": "completed"}}
