{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/prepare_tests.py <<'PY'\nfrom pathlib import Path\nimport shutil\nb=Path('/srv/hwebench/tmp/f88745d5/098f973f/predictor_trial');t=b/'reuse'\nshutil.copytree('cores/bench/test',t/'test',dirs_exist_ok=True)\np=t/'test/test_pipeline.py';s=p.read_text()\ns=s.replace('    blocked_request = None\\\\n', '    blocked_request = None\\\\n    counter_model = [1] * 64\\\\n',1)\ns=s.replace('        raw_instr = imem.get(ia & ~3, EBREAK())', '''        raw_instr = imem.get(ia & ~3, EBREAK())\n        lookup = ((ia >> 2) \"'^ (ia >> 8)) & 63\n        opcode = raw_instr & 127\n        is_b = opcode == 0x63 and ((raw_instr >> 12) & 7) not in (2, 3)\n        is_j = opcode == 0x6f\n        if is_j:\n            immediate = (((raw_instr >> 31) & 1) << 20) | (((raw_instr >> 12) & 255) << 12) | (((raw_instr >> 20) & 1) << 11) | (((raw_instr >> 21) & 1023) << 1)\n            if immediate & (1 << 20): immediate -= 1 << 21\n        else:\n            immediate = (((raw_instr >> 31) & 1) << 12) | (((raw_instr >> 7) & 1) << 11) | (((raw_instr >> 25) & 63) << 5) | (((raw_instr >> 8) & 15) << 1)\n            if immediate & (1 << 12): immediate -= 1 << 13\n        direct = (ia + immediate) & 0xffffffff\n        predicted = bool((is_j or (is_b and counter_model[lookup] >= 2)) and direct % 4 == 0)\n        assert int(dut.u_if.predicted_taken.value) == int(predicted), \"prediction disagrees with pre-edge independent model\"\n        training = int(dut.train_valid.value)\n        training_pc = int(dut.train_pc.value)\n        training_taken = int(dut.train_taken.value)\n        if hold_payload or not (ex_payload & 1):\n            assert not training and not redirect, \"held/invalid instruction trained or recovered\"\n        if training:\n            index = ((training_pc >> 2) ''^ (training_pc >> 8)) & 63\n            counter_model[index] = max(0, min(3, counter_model[index] + (1 if training_taken else -1)))'\"''',1)\ns=s.replace('                                     redirect=redirect,','                                     redirect=redirect, training=training, predicted=predicted,',1)\ns=s.replace('    assert any(o[\\\"redirect\\\"] and not o[\\\"iready\\\"] and not o[\\\"dready\\\"] for o in observed)', '    assert all(not o[\\\"redirect\\\"] and not o[\\\"training\\\"] for o in observed if o[\\\"hold_payload\\\"])\\\\n    assert sum(o[\\\"redirect\\\"] for o in observed) == 1\\\\n    assert sum(o[\\\"training\\\"] for o in observed) == 1')\ns=s.replace('ADDI(0, 0, 77), ADD(10, 0, 0), JAL(0, 8),','ADDI(0, 0, 77), ADD(10, 0, 0), BEQ(0, 0, 8),')\nidx=s.index('\\\\ndef test_pipeline_runner')\ns=s[:idx]+'''\n@cocotb.test()\nasync def shared_predicate_boundary_pairs(dut):\n    def load(rd, v):\n        v &= 0xffffffff\n        hi = ((v + 0x800) & 0xfffff000)\n        lo = (v - hi) & 0xfff\n        return [hi | (rd << 7) | 0x37, ADDI(rd, rd, lo)]\n    def signed(v): return v if v < 0x80000000 else v - 0x100000000\n    values = [0, 1, 0x7fffffff, 0x80000000, 0xffffffff]\n    for funct in (0, 1, 4, 5, 6, 7):\n        for a in values:\n            for b in values:\n                cond = {0: a == b, 1: a \"'!= b, 4: signed(a) < signed(b),\n                        5: signed(a) >= signed(b), 6: a < b, 7: a >= b}[funct]\n                program = load(1, a) + load(2, b) + [_b(8, 2, 1, funct, 0x63), SW(1, 0, 0x600), ADDI(3, 0, 77), EBREAK()]\n                seen = []\n                rets, mem = await _run(dut, program, observations=seen)\n                _check_stream(rets, program, skipped=(5,) if cond else ())\n                [branch] = _by_insn(rets, program[4])\n                assert branch['\"'rs1_rdata'] == a and branch['rs2_rdata'] == b\n                assert branch['pc_next'] == (24 if cond else 20)\n                assert branch['trap'] == 0\n                assert (0x600 not in mem) if cond else mem[0x600] == a\n                assert sum(o['redirect'] for o in seen) == int(cond)\n\n@cocotb.test()\nasync def warm_loop_hysteresis_and_stalls(dut):\n    program = [ADDI(1, 0, 20), ADDI(2, 0, 0), ADDI(2, 2, 1),\n               _b(-4, 2, 1, 1, 0x63), SW(2, 0, 0x600), EBREAK()]\n    for stalled in (False, True):\n        rng = random.Random(817)\n        ready = (lambda c, req: (int(rng.random() >= .22), int(rng.random() >= .22))) if stalled else None\n        seen = []\n        rets, mem = await _run(dut, program, max_cycles=500, ready_fn=ready, observations=seen)\n        branches = [r for r in rets if r['pc'] == 12]\n        assert len(branches) == 20 and [r['pc_next'] for r in branches] == [8]*19+[16]\n        assert mem[0x600] == 20\n        assert [r['order'] for r in rets] == list(range(len(rets)))\n        assert sum(o['redirect'] for o in seen) == 2\n        assert sum(o['training'] for o in seen) == 20\n        assert all(not o['redirect'] and not o['training'] for o in seen if o['hold_payload'])\n\n'''+s[idx:]\np.write_text(s)\nprint('Prepared tests with independent cycle-by-cycle predictor model')\nPY\npython /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/prepare_tests.py\npytest -q --rootdir=/srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/reuse --confcutdir=/srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/reuse /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/reuse/test > /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/reuse/tests.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
