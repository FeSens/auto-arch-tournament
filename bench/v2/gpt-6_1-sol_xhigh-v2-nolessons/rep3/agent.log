al)\n          | ({32{resolved_b[1]}} & fwd_ex_mem)\n          | ({32{resolved_b[2]}} & fwd_mem_wb)\n          | ({32{resolved_b[3]}} & in.imm);\n  end\n\n'\"'''+s[b:]\na=s.index('  // Predict the producer entering EX/MEM');b=s.index('  always_ff @(posedge clock)',a)\ns=s[:a]+'''  // Producer acceptance is registered with the selected payload.\n  assign bypass_available = reg_q.ctrl.reg_write;\n\n'''+s[b:]\np.write_text(s)\np=Path('cores/bench/rtl/mem_stage.sv');s=p.read_text()\ns=s.replace('output logic               next_reg_write,','output logic               bypass_available,')\ns=s.replace('  assign next_reg_write = \"'!hold_wb && ctrl_with_trap.reg_write && in.valid;'\"','  assign bypass_available = bypass_available_q;\\\\n  logic bypass_available_q;')\ns=s.replace(\\\"      reg_q <= '0;\\\",\\\"      reg_q <= '0;\\\\n      bypass_available_q <= 1'b0;\\\")\ns=s.replace('    end else begin\\\\n      reg_q.pc','    end else begin\\\\n      bypass_available_q <= ctrl_with_trap.reg_write && in.valid;\\\\n      reg_q.pc')\np.write_text(s)\nprint('Applied independent-match trial to four RTL files')\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
