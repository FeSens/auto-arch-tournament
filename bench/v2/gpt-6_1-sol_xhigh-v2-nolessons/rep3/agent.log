{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path.cwd()\ntask=Path('/srv/hwebench/tmp/f88745d5/e5e139df/pc_offset_trial')\nfor variant in ('shared21','prefix21'):\n base=task/variant\n shutil.copytree(root/'cores/bench/rtl',base/'rtl',dirs_exist_ok=True)\n p=base/'rtl/if_stage.sv'\n s=p.read_text()\n s=s.replace('logic [31:0] sequential_pc, direct_imm, direct_target;', 'logic [31:0] sequential_pc, direct_imm, direct_target;\\\\n  logic [21:0] target_low_sum;\\\\n  logic [10:0] target_hi_plus, target_hi_minus, target_hi;')\n if variant=='shared21':\n  replacement='''    target_low_sum = {1'b0, pc[20:0]} + {1'b0, direct_imm[20:0]};\n    target_hi_plus = pc[31:21] + 11'd1;\n    target_hi_minus = pc[31:21] - 11'd1;\n    target_hi = (target_low_sum[21] == direct_imm[31]) ? pc[31:21]\n              : direct_imm[31] ? target_hi_minus : target_hi_plus;\n    direct_target = {target_hi, target_low_sum[20:0]};'''\n else:\n  s=s.replace('logic [10:0] target_hi_plus, target_hi_minus, target_hi;', 'logic [10:0] target_hi;\\\\n  logic target_inc, target_dec;')\n  replacement='''    target_low_sum = {1'b0, pc[20:0]} + {1'b0, direct_imm[20:0]};\n    target_inc = target_low_sum[21] && \"'!direct_imm[31];\n    target_dec = !target_low_sum[21] && direct_imm[31];\n    target_hi[0] = pc[21] ''^ (target_inc || target_dec);\n'\"'''+''.join(f'    target_hi[{j}] = pc[{21+j}] \"'^ ((target_inc && (&pc[{20+j}:21])) ||'\"\\\\n                                            (target_dec && \"'!(|pc[{20+j}:21])));'\"\\\\n' for j in range(1,11))+'''    direct_target = {target_hi, target_low_sum[20:0]};'''\n s=s.replace('    direct_target = pc + direct_imm;',replacement)\n p.write_text(s)\nprint('Prepared shared21 and prefix21 trials')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
