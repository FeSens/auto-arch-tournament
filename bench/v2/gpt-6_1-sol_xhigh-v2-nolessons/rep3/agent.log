2) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b001001\n…[20695 of 23767 chars elided by tools/bench/transcript.py; sha256:2c53fdf3da0078ba]…\nto 0, the per-channel\n        # BMC's assumption (rvfi_valid_1=1) is unsatisfiable, and SBY\n        # reports Status: PREUNSAT (rc=16). The property holds vacuously\n        # over the empty set of ch1-valid traces — a legitimate pass.\n        # Dual-issue hypotheses make the assumption satisfiable, so this\n        # branch never matches and the regular DONE (PASS branch covers it.\ntools/eval/gowin.py:121:        \"lutram\": _cells(r, \"--SSRAM(RAM16)\") or 0,\ntools/eval/gowin.py:220:              f\"logic {r['logic']}, registers {r['regs']}, LUT-RAM {r['lutram']}, BSRAM {r['bsram']}, DSP {r['dsp']}\")\nfpga/core_bench.sv:16:// dmem read mux's LUT/BRAM map matches what the eventual deployment will\ntools/eval/gowin.py:121:        \"lutram\": _cells(r, \"--SSRAM(RAM16)\") or 0,\ntools/eval/gowin.py:220:              f\"logic {r['logic']}, registers {r['regs']}, LUT-RAM {r['lutram']}, BSRAM {r['bsram']}, DSP {r['dsp']}\")\ntools/eval/test_fpga_report.py:20:    --SSRAM(RAM16)            | 8                                   | -\n", "exit_code": 0, "status": "completed"}}
