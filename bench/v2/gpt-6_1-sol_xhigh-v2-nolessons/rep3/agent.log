{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py; cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger operations are combinational. All eight M operations use the\nshared request/result valid-ready interface to registered arithmetic.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value), \"divider did not return to idle\"\n    await _tick(dut)\n    dut.div_req_valid.value = 0\n    for _ in range(40):\n        if int(dut.div_result_valid.value):\n            break\n        await _tick(dut)\n    else:\n        raise AssertionError(\"division exceeded 40-cycle completion bound\")\n    await _check(dut, op, a, b, expected)\n    dut.div_result_ready.value = 1\n    await _tick(dut)\n    dut.div_result_ready.value = 0\n    assert not int(dut\n…[45431 of 48503 chars elided by tools/bench/transcript.py; sha256:fdf0ea6d11f7ce03]…\nult_valid.value)\n            assert int(dut.ex_mem_w.value) == 0 and int(dut.mem_wb_w.value) == 0\n            dut.io_imemReady.value = 0\n            dut.reset.value = 0\n            for _ in range(8):\n                await tick()\n                assert not int(dut.io_rvfi_valid_0.value), \"cancelled instruction retired\"\n                assert not int(dut.io_dmemWEn.value)\n            recovery = [ADDI(1, 0, 5), ADDI(2, 0, 6), MUL(3, 1, 2), EBREAK()]\n            rets, _ = await _run(dut, recovery)\n            _check_stream(rets, recovery)\n            assert rets[2][\"rd_wdata\"] == 30\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
