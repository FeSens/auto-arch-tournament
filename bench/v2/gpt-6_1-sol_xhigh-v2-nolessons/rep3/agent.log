<8)|(m[a+2]<<16)|(m[a+3]<<24);\n}\nvoid ww(uint8_t* m, uint32_t a, uint32_t v, uint8_t mask) {\n    a &= 0xFFFFC;\n    for(int i=0;i<4;i++) if((mask>>i)&1) m[a+i]=(v>>(i*8))&0xFF;\n}\n\n// VexRiscv-style random bus backpressure model (regression/main.cpp:2079).\n// xorshift7 LFSR; accept request when (state & 0x7F) < 100 (~78% accept,\n// ~22% stall). Replicating exactly so CoreMark/MHz numbers from this\n// cosim are directly comparable to VexRiscv's published \"full no cache,\n// 2.30\" — which is measured under iStall+dSt\n…[5847 of 8919 chars elided by tools/bench/transcript.py; sha256:2106684cff0c0fb7]…\nre_bench.power.html\" completed\nGenerate file \"/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep3/cores/bench/worktrees/hyp-20261004-001-r12s0/cores/bench/generated/timing/gowin_p2/impl/pnr/core_bench.pin.html\" completed\nGenerate file \"/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep3/cores/bench/worktrees/hyp-20261004-001-r12s0/cores/bench/generated/timing/gowin_p2/impl/pnr/core_bench.rpt.html\" completed\nGenerate file \"/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep3/cores/bench/worktrees/hyp-20261004-001-r12s0/cores/bench/generated/timing/gowin_p2/impl/pnr/core_bench.rpt.txt\" completed\nGenerate file \"/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep3/cores/bench/worktrees/hyp-20261004-001-r12s0/cores/bench/generated/timing/gowin_p2/impl/pnr/core_bench.tr.html\" completed\nGenerate file \"/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep3/cores/bench/worktrees/hyp-20261004-001-r12s0/cores/bench/generated/timing/gowin_p2/impl/pnr/core_bench.tr\" completed\nSun Oct  4 23:38:14 2026\n\n", "exit_code": 0, "status": "completed"}}
