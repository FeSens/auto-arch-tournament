{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/adder_trial');rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n(rtl/'fast_add.sv').write_text('''module fast_add (input logic [31:0] a,b, input logic sub, output logic [31:0] sum);\n  logic [31:0] bx;\n  logic [3:0] prop,genr;\n  logic [3:0] carry;\n  assign bx = b \"'^ {32{sub}};\n  assign carry[0] = sub;\n  assign carry[1] = genr[0] | (prop[0] & sub);\n  assign carry[2] = genr[1] | (prop[1] & genr[0]) | (prop[1] & prop[0] & sub);\n  assign carry[3] = genr[2] | (prop[2] & genr[1]) | (prop[2] & prop[1] & genr[0]) | (prop[2] & prop[1] & prop[0] & sub);\n  for (genvar i=0;i<4;i++) begin:blocks\n    logic [8:0] sum0;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [8:0] sum1;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign sum0 = {1'\"'b0,a[i*8+:8]} + {1'b0,bx[i*8+:8]};\n    assign sum1 = {1'b0,a[i*8+:8]} + {1'b0,bx[i*8+:8]} + 9'd1;\n    assign genr[i] = sum0[8];\n    assign prop[i] = &(a[i*8+:8] \"'^ bx[i*8+:8]);\n    assign sum[i*8+:8] = carry[i] ? sum1[7:0] : sum0[7:0];\n  end\nendmodule\n'\"''')\np=rtl/'alu.sv';s=p.read_text();s=s.replace('  logic        [4:0]  shamt;','  logic        [4:0]  shamt;\\\\n  logic [31:0] add_result, sub_result;\\\\n  fast_add u_add (.a(a), .b(b), .sub(1\\\\'b0), .sum(add_result));\\\\n  fast_add u_sub (.a(a), .b(b), .sub(1\\\\'b1), .sum(sub_result));');s=s.replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = add_result;').replace('ALU_SUB:    out = a - b;', 'ALU_SUB:    out = sub_result;');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text();s=s.replace('  always_comb begin\\\\n    case (in.ctrl.branch_op)', '''  logic [31:0] direct_sum, link_sum;\n  fast_add u_direct (.a(in.pc), .b(in.imm), .sub(1'b0), .sum(direct_sum));\n  fast_add u_jalr (.a(rs1), .b(in.imm), .sub(1'b0), .sum(jalr_sum));\n  assign link_sum = in.pc + 32'd4;\n  always_comb begin\n    case (in.ctrl.branch_op)''');s=s.replace('branch_target = in.pc + in.imm;', 'branch_target = direct_sum;').replace('    jalr_sum    = rs1 + in.imm;\\\\n','').replace(': (in.pc + in.imm);',': direct_sum;');p.write_text(s)\nprint(root)\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nwt=Path('.').resolve();root=wt/'cores/bench/generated/adder_trial'\nr=build_all(wt,root/'rtl','fpga/core_bench_si.sv',root/'timing')\nprint(r);print(summarize(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
