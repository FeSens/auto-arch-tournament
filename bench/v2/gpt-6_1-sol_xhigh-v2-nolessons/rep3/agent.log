{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nroot=Path('/srv/hwebench/tmp/f88745d5/7b173ab3/forwarding_trial')\nfor p in Path('cores/bench/rtl').glob('*.sv'): p.write_bytes((root/p.name).read_bytes())\nPath('cores/bench/test/test_pipeline.py').write_bytes((root/'test_pipeline.py').read_bytes())\np=Path('cores/bench/rtl/reg_file.sv');s=p.read_text()\ns=s.replace('module reg_file (','module reg_file #(parameter bit SYNCHRONOUS_READ = 1\\\\'b0) (')\ns=s.replace('  input  logic        reset,','  input  logic        reset,\\\\n  input  logic        read_enable,')\ns=s.replace('  // Only constant-index wires', '''  generate if (SYNCHRONOUS_READ) begin : gen_sync\n    logic [31:0] bank_a [0:31];\n    logic [31:0] bank_b [0:31];\n    logic [31:0] valid_words;\n    logic [31:0] data_a_q, data_b_q, bypass_data_q;\n    logic zero_a_q, zero_b_q, bypass_a_q, bypass_b_q;\n    always_ff @(posedge clock) begin\n      if (\"'!reset && w_en && w_addr != 0) begin\n        bank_a[w_addr] <= w_data;\n        bank_b[w_addr] <= w_data;\n      end\n      if (read_enable) begin\n        data_a_q <= bank_a[rs1_addr];\n        data_b_q <= bank_b[rs2_addr];\n      end\n      if (reset) begin\n        valid_words <= '\"'0;\n        zero_a_q <= 1'b1;\n        zero_b_q <= 1'b1;\n        bypass_a_q <= 1'b0;\n        bypass_b_q <= 1'b0;\n        bypass_data_q <= '0;\n      end else begin\n        if (w_en && w_addr \"'!= 0) valid_words[w_addr] <= 1'\"'b1;\n        if (read_enable) begin\n          zero_a_q <= rs1_addr == 0 || \"'!valid_words[rs1_addr];\n          zero_b_q <= rs2_addr == 0 || !valid_words[rs2_addr];\n          bypass_a_q <= w_en && w_addr != 0 && w_addr == rs1_addr;\n          bypass_b_q <= w_en && w_addr != 0 && w_addr == rs2_addr;\n          bypass_data_q <= w_data;\n        end\n      end\n    end\n    assign rs1_data = bypass_a_q ? bypass_data_q : (zero_a_q ? 32'\"'b0 : data_a_q);\n    assign rs2_data = bypass_b_q ? bypass_data_q : (zero_b_q ? 32'b0 : data_b_q);\n  end else begin : gen_async\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire unused_read_enable = read_enable;\n  /* verilator lint_on UNUSEDSIGNAL */\n  // Only constant-index wires''')\ns=s.replace('\\\\nendmodule','\\\\n  end endgenerate\\\\nendmodule')\np.write_text(s)\np=Path('cores/bench/rtl/core.sv');s=p.read_text()\ns=s.replace('  reg_file u_rf (','  reg_file #(.SYNCHRONOUS_READ(1\\\\'b1)) u_rf (')\ns=s.replace('    .rs1_addr (rs1_addr_w),\\\\n    .rs2_addr (rs2_addr_w),\\\\n    .rs1_data (rs1_data_w),\\\\n    .rs2_data (rs2_data_w),\\\\n    .w_en','    .read_enable (\"'!hold_id_payload),'\"\\\\n    .rs1_addr (rs1_addr_w),\\\\n    .rs2_addr (rs2_addr_w),\\\\n    .rs1_data (rs1_data_w),\\\\n    .rs2_data (rs2_data_w),\\\\n    .w_en')\ns=s.replace('    .fwd_rs1_sel     (fwd_rs1_sel),','    .register_rs1    (rs1_data_w),\\\\n    .register_rs2    (rs2_data_w),\\\\n    .fwd_rs1_sel     (fwd_rs1_sel),')\np.write_text(s)\np=Path('cores/bench/rtl/ex_stage.sv');s=p.read_text()\ns=s.replace('  input  logic [1:0]         fwd_rs1_sel,','  input  logic [31:0]        register_rs1,\\\\n  input  logic [31:0]        register_rs2,\\\\n  input  logic [1:0]         fwd_rs1_sel,')\ns=s.replace('in.rs1_val','register_rs1').replace('in.rs2_val','register_rs2')\np.write_text(s)\nprint('Applied synchronous mirrored register-file trial')\nPY\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
