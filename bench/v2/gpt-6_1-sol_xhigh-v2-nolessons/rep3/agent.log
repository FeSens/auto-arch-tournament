{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom functools import cache\nimport re,json\npath=Path('cores/bench/generated/mapping_keep/impl/pnr/core_bench.vo')\ns=path.read_text()\ncanon=lambda n:re.sub(r'\\\\s+','',n).replace('\\\\\\\\','')\ncells=[]; drivers={}\nfor m in re.finditer(r'\"'^([A-Za-z0-9_]+)'\"\\\\s+(\\\\\\\\\\\\S+|\\\\w+)\\\\s+\\\\(\\\\s*\\\\n(.*?)\\\\n\\\\);',s,re.M|re.S):\n typ,name,body=m.groups()\n ports={p:canon(n) for p,n in re.findall(r'\\\\.(\\\\w+)\\\\((.*?)\\\\)',body)}\n name=canon(name)\n cells.append((typ,name,ports))\n if typ.startswith('LUT') or typ.startswith('MUX') or typ=='ALU':\n  for output in ('F','O','SUM','COUT'):\n   if output in ports:drivers[ports[output]]=(name,[v for p,v in ports.items() if p.startswith('I') or p in ('S','SEL','CIN')])\n@cache\ndef cone(n):\n if re.fullmatch(r'cpu/u_ex/alu_b\\\\[[0-4]\\\\]',n) or n not in drivers:return frozenset((n,))\n name,inputs=drivers[n]\n return frozenset((n,)).union(*(cone(v) for v in inputs))\nprefix='cpu/u_ex/u_alu/gen_predecoded_result.gen_exmem_local_sll.'\nsummary={}\nfor lane in ('fallback_left','exmem_shifted'):\n roots=[prefix+lane+f'[{i}]' for i in range(32)]\n assert all(r in drivers for r in roots)\n nets=frozenset().union(*(cone(r) for r in roots))\n sel=[n for n in nets if n.startswith('cpu/alu_a_sel[')]\n data={key:sorted(int(re.search(r'\\\\[(\\\\d+)\\\\]',n)[1]) for n in nets if n.startswith(base))\n       for key,base in [('idex','cpu/id_ex_w.rs1_val['),('exmem','cpu/ex_mem_w.alu_result['),('wb','cpu/wb_w_data[')]}\n assert not any(re.fullmatch(r'cpu/u_ex/alu_a\\\\[\\\\d+\\\\]',n) for n in nets)\n assert ('cpu/alu_a_sel[1]' not in nets)\n if lane=='fallback_left':\n  assert set(sel)=={'cpu/alu_a_sel[0]','cpu/alu_a_sel[2]'} and not data['exmem']\n  assert data['idex']==data['wb']==list(range(32))\n else:\n  assert not sel and not data['idex'] and not data['wb'] and data['exmem']==list(range(32))\n assert all(f'cpu/u_ex/alu_b[{i}]' in nets for i in range(5))\n assert 'cpu/id_ex_w.result_grants[7]' in nets\n summary[lane]={'source_bits':data,'source_selects':sel,'shamt_bits':[0,1,2,3,4],'selected_a_mux_in_cone':False}\n# Every EX/MEM source selection in the ALU consumes a completed barrel bit.\nselected=[(name,p) for _,name,p in cells if name.startswith('cpu/u_ex/u_alu/') and 'cpu/alu_a_sel[1]' in p.values()]\nassert len(selected)==32\nassert all(any(v.startswith(prefix+'exmem_shifted[') for v in p.values()) for _,p in selected)\nsummary['post_barrel_source_select_cells']=len(selected)\n# Grant-7 injection only feeds these two barrel cones (no third SLL lane).\nroots=[prefix+lane+f'[{i}]' for lane in ('fallback_left','exmem_shifted') for i in range(32)]\nshift_nets=frozenset().union(*(cone(r) for r in roots))\nfor typ,name,p in cells:\n if name.startswith('cpu/u_ex/u_alu/') and 'cpu/id_ex_w.result_grants[7]' in p.values():\n  assert p.get('F') in shift_nets,(name,p)\nsummary['third_sll_grant_cone']=False\n(out:=Path('cores/bench/generated/local_checks/mapping_final.json')).write_text(json.dumps(summary,indent=2)+'\\\\n')\nprint(json.dumps(summary,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
