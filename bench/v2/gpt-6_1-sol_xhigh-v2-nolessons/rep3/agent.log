{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypgen_r14')\ntrial=base/'onehot_barrel'/'rtl';trial.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,trial/p.name)\np=trial/'alu.sv';s=p.read_text()\nneedle='''  generate if (PREDECODED_RESULT) begin : gen_predecoded_result\n'''\nnew='''  generate if (PREDECODED_RESULT) begin : gen_predecoded_result\n    wire [31:0] shift_left_terms [0:31];\n    wire [31:0] shift_right_terms [0:31];\n    wire [31:0] shift_arithmetic_terms [0:31];\n    logic [31:0] shift_left, shift_right, shift_arithmetic;\n    for (genvar k = 0; k < 32; k++) begin : gen_onehot_shift\n      wire selected = shamt == 5'(k);\n      assign shift_left_terms[k] = (a << k) & {32{selected && result_grants[7]}};\n      assign shift_right_terms[k] = (a >> k) & {32{selected && result_grants[8]}};\n      assign shift_arithmetic_terms[k] = \"'$unsigned($signed(a) >>> k) & {32{selected && result_grants[9]}};\n    end\n    always_comb begin\n      shift_left = '\"'0;\n      shift_right = '0;\n      shift_arithmetic = '0;\n      for (int k = 0; k < 32; k++) begin\n        shift_left = shift_left | shift_left_terms[k];\n        shift_right = shift_right | shift_right_terms[k];\n        shift_arithmetic = shift_arithmetic | shift_arithmetic_terms[k];\n      end\n    end\n'''\nassert needle in s;s=s.replace(needle,new)\nold='''        | ((a & {32{result_grants[7]}}) << shamt)\n        | ((a & {32{result_grants[8]}}) >> shamt)\n        | \"'$unsigned($signed(a & {32{result_grants[9]}}) >>> shamt);'\"'''\nnew='''        | shift_left | shift_right | shift_arithmetic;'''\nassert old in s;p.write_text(s.replace(old,new))\nprint('Prepared decoded constant-shift selection trial')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
