{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json\nfor line in Path('cores/bench/experiments/log.jsonl').read_text().splitlines():\n d=json.loads(line)\n if d.get('category')=='predictor':\n  print(d['id'],d['outcome'],d['fitness'],d['fmax_mhz'],d['cycles'])\nPY\nsed -n '1,140p' tools/eval/fpga.py\"", "aggregated_output": "hyp-20261004-003-r1s2 regression 12.76 5.347 4190281\nhyp-20261004-003-r2s2 regression 118.59 49.908 4208611\nhyp-20261004-003-r3s2 regression 123.45 51.727 4190281\nhyp-20261004-003-r4s2 regression 138.33 62.195 4496136\nhyp-20261004-003-r5s2 regression 153.96 69.223 4496136\nhyp-20261004-003-r6s2 regression 180.4 80.665 4471522\n\"\"\"FPGA fitness: vendor (Gowin EDA) Fmax x CoreMark iterations per cycle.\n\nThe Yosys + nextpnr helpers below (run_seed, _run_perturbations, ...) are\nkept for the research scripts that document the V1 flow; the eval uses\ntools/eval/gowin.py.\n\"\"\"\nimport asyncio, os, re, json, subprocess, statistics\nfrom pathlib import Path\n\nfrom tools.eval import gowin\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\n\ndef _build_synth_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `yosys -c fpga/scripts/synth.tcl`.\n\n    Reads cores/<target>/core.yaml's `nret` field (defaults to 2). When\n    nret=1, injects BENCH=fpga/core_bench_si.sv so synth.tcl reads the\n    single-issue FPGA wrapper (only `_0` RVFI ports) instead of the\n    default dual-channel core_bench.sv. nret=2 leaves BENCH unset and\n    synth.tcl falls back to fpga/core_bench.sv.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"GEN_DIR\"] = f\"cores/{target}/generated\"\n    nret = read_nret(worktree_path / \"cores\" / target / \"core.yaml\")\n    if nret == 1:\n        env[\"BENCH\"] = \"fpga/core_bench_si.sv\"\n    return env\n\nSEEDS = [1, 2, 3]\n# Fmax is scored over (perturbation, seed) pairs. Perturbation k adds an\n# unused k-assign module to synthesis (k=0: the netlist `make` built);\n# neutral changes like this move a design's Fmax by far more than nextpnr\n# seeds do (EXP-2026-09-27-v2-placement-noise), so one netlist is one\n# draw. Set from that calibration; see research/v2/NOTES.md.\n# \n…[3653 of 6725 chars elided by tools/bench/transcript.py; sha256:6cb314a108b170a7]…\n         'log': f'nextpnr timeout after {NEXTPNR_TIMEOUT_SEC}s',\n            'returncode': None,\n            'placement_failed': True,\n            'timed_out': True,\n        }\n    output = (stdout + stderr).decode()\n\n    # Take the LAST \"Max frequency\" line: nextpnr prints intermediate estimates\n    # during place-and-route plus a final post-routing value. The final one is\n    # authoritative — an earlier match can be pessimistic (pre-route estimate)\n    # or optimistic (pre-placement estimate).\n    matches = re.findall(r'Max frequency[^\\d]+([\\d.]+)\\s+MHz', output)\n    fmax = float(matches[-1]) if matches else None\n\n    # Treat a non-zero exit from nextpnr (passed through pipefail in the\n    # shell script) as placement failure even if it printed a frequency\n    # line during a partial run.\n    placement_failed = (proc.returncode != 0) or (fmax is None)\n\n    return {\n        'seed': seed,\n        'fmax_mhz': fmax if not placement_failed else None,\n        'log': output,\n        'returncode': proc.returncode,\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial\ncat > /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/prepare.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path.cwd()\nt=Path('/srv/hwebench/tmp/f88745d5/098f973f/predictor_trial')\nr=t/'rtl'\nshutil.copytree(root/'cores/bench/rtl',r,dirs_exist_ok=True)\np=r/'core_pkg.sv'; s=p.read_text()\ns=s.replace('    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;', '    logic        predicted_taken;\\\\n    logic [31:0] recovery_pc;\\\\n    logic        direct_aligned;\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;')\ns=s.replace('    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;', '    logic        predicted_taken;\\\\n    logic [31:0] recovery_pc;\\\\n    logic        direct_aligned;\\\\n    logic [2:0]  mismatch_op;\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;')\np.write_text(s)\np=r/'id_stage.sv'; s=p.read_text().replace('        reg_q.pc       <= in.pc;', '        reg_q.pc       <= in.pc;\\\\n        reg_q.predicted_taken <= in.predicted_taken;\\\\n        reg_q.recovery_pc <= in.recovery_pc;\\\\n        reg_q.direct_aligned <= in.direct_aligned;\\\\n        reg_q.mismatch_op <= dec_branch_op \"'^ {2'\"\\\\'b00, in.predicted_taken};');p.write_text(s)\np=r/'core.sv';s=p.read_text().replace('  logic [31:0] redirect_target;', '  logic [31:0] redirect_target;\\\\n  logic train_valid, train_taken;\\\\n  logic [31:0] train_pc;')\ns=s.replace('    .redirect_target (redirect_target),\\\\n    .imem_addr', '    .redirect_target (redirect_target),\\\\n    .train_valid     (train_valid),\\\\n    .train_taken     (train_taken),\\\\n    .train_pc        (train_pc),\\\\n    .imem_addr')\ns=s.replace('    .redirect_target (redirect_target)\\\\n  );', '    .redirect_target (redirect_target),\\\\n    .train_valid     (train_valid),\\\\n    .train_taken     (train_taken),\\\\n    .train_pc        (train_pc)\\\\n  );');p.write_text(s)\np=r/'ex_stage.sv';s=p.read_text().replace('  output logic [31:0]        redirect_target\\\\n', '  output logic [31:0]        redirect_target,\\\\n  output logic               train_valid,\\\\n  output logic               train_taken,\\\\n  output logic [31:0]        train_pc\\\\n')\ns=s.replace('case (in.ctrl.branch_op)', 'case (in.mismatch_op)')\ns=s.replace('branch_taken  = in.ctrl.is_branch && branch_cond;', 'branch_taken  = in.ctrl.is_branch && (branch_cond \"'^ in.predicted_taken);'\"')\ns=s.replace(\\\"&& (branch_target[1:0] \"'!= 2'\"'b00);\\\", '&& \"'!in.direct_aligned;'\"')\ns=s.replace(\\\"misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] \"'!= 2'\"'b00);\\\", \\\"misalign_jump   = in.ctrl.is_jump && (in.ctrl.is_jalr\\\\n                      ? (jump_target[1:0] \"'!= 2'\"'b00) : \"'!in.direct_aligned);\")\ns=s.replace('\"'      ctrl_with_trap.reg_write  = 1\\\\'b0;', '')\ns=s.replace('    end\\\\n  end\\\\n\\\\n  assign redirect        = in.valid && (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"\\\\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;', '''    end\n    // Only a jump can both write a register and suffer a control target fault.\n    ctrl_with_trap.reg_write = in.ctrl.reg_write && \"'!misalign_jump;\n  end\n\n  logic normal_advance;\n  assign normal_advance = in.valid && !stall && !is_divide && !divide_active_q;\n  assign redirect = normal_advance &&\n                    ((in.ctrl.is_branch && in.direct_aligned && branch_cond) ||\n                     (in.ctrl.is_jalr && !misalign_jump));\n  assign redirect_target = in.ctrl.is_jalr ? jump_target : in.recovery_pc;\n  assign train_valid = normal_advance && in.ctrl.is_branch &&\n                       !in.ctrl.is_illegal && in.direct_aligned;\n  assign train_taken = branch_taken;\n  assign train_pc = in.pc;'\"''')\np.write_text(s)\n(r/'if_stage.sv').write_text('''// Compact direction predictor, with registered direct recovery metadata.\nmodule if_stage (\n  input logic clock, reset, stall, flush, redirect,\n  input logic [31:0] redirect_target,\n  input logic train_valid, train_taken,\n  input logic [31:0] train_pc,\n  output logic [31:0] imem_addr,\n  input logic [31:0] imem_data,\n  output if_id_t out\n);\n  logic [31:0] pc;\n  logic [5:0] lookup_index, train_index;\n  wire [63:0] direction;\n  assign lookup_index = pc[7:2] \"'^ pc[13:8];\n  assign train_index = train_pc[7:2] ''^ train_pc[13:8];\n  for (genvar e = 0; e < 64; e++) begin : gen_counters\n    localparam logic [5:0] INDEX = 6'\"'(e);\n    logic [1:0] counter_q;\n    always_ff @(posedge clock) begin\n      if (reset) counter_q <= 2'b01;\n      else if (train_valid && train_index == INDEX) begin\n        if (train_taken)\n          counter_q <= {counter_q[1] | counter_q[0], counter_q[1] | \"'!counter_q[0]};\n        else\n          counter_q <= {counter_q[1] & counter_q[0], counter_q[1] & !counter_q[0]};\n      end\n    end\n    assign direction[e] = counter_q[1];\n  end\n  wire [7:0] direction_groups;\n  for (genvar g = 0; g < 8; g++) begin : gen_groups\n    assign direction_groups[g] =\n        ((lookup_index[2:0] == 3'\"'d0) & direction[g*8+0])\n      | ((lookup_index[2:0] == 3'd1) & direction[g*8+1])\n      | ((lookup_index[2:0] == 3'd2) & direction[g*8+2])\n      | ((lookup_index[2:0] == 3'd3) & direction[g*8+3])\n      | ((lookup_index[2:0] == 3'd4) & direction[g*8+4])\n      | ((lookup_index[2:0] == 3'd5) & direction[g*8+5])\n      | ((lookup_index[2:0] == 3'd6) & direction[g*8+6])\n      | ((lookup_index[2:0] == 3'd7) & direction[g*8+7]);\n  end\n  logic predicted_direction, is_branch, is_jal;\n  logic [31:0] direct_imm, direct_target, sequential_pc;\n  logic predicted_taken, direct_aligned;\n  always_comb begin\n    case (lookup_index[5:3])\n      3'd0: predicted_direction = direction_groups[0];\n      3'd1: predicted_direction = direction_groups[1];\n      3'd2: predicted_direction = direction_groups[2];\n      3'd3: predicted_direction = direction_groups[3];\n      3'd4: predicted_direction = direction_groups[4];\n      3'd5: predicted_direction = direction_groups[5];\n      3'd6: predicted_direction = direction_groups[6];\n      default: predicted_direction = direction_groups[7];\n    endcase\n    is_branch = imem_data[6:0] == 7'b1100011 &&\n                imem_data[14:12] \"'!= 3'\"'d2 && imem_data[14:12] \"'!= 3'\"'d3;\n    is_jal = imem_data[6:0] == 7'b1101111;\n    direct_imm = is_jal\n      ? {{11{imem_data[31]}},imem_data[31],imem_data[19:12],imem_data[20],imem_data[30:21],1'b0}\n      : {{19{imem_data[31]}},imem_data[31],imem_data[7],imem_data[30:25],imem_data[11:8],1'b0};\n    direct_target = pc + direct_imm;\n    sequential_pc = pc + 32'd4;\n    direct_aligned = direct_target[1:0] == 2'b00;\n    predicted_taken = direct_aligned && (is_jal || (is_branch && predicted_direction));\n    out.pc = pc;\n    out.predicted_taken = predicted_taken;\n    out.recovery_pc = predicted_taken ? sequential_pc : direct_target;\n    out.direct_aligned = direct_aligned;\n    out.instr = imem_data;\n    out.valid = \"'!(flush || redirect);\n  end\n  always_ff @(posedge clock) begin\n    if (reset) pc <= 32'\"'b0;\n    else if (redirect) pc <= redirect_target;\n    else if (\"'!stall) pc <= predicted_taken ? direct_target : sequential_pc;\n  end\n  assign imem_addr = pc;\nendmodule\n'\"''')\nprint('Prepared isolated trial in',r)\nPY\npython /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/prepare.py\nverilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+/srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/rtl /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/rtl/core_pkg.sv /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/rtl/alu.sv /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/rtl/core.sv /srv/hwebench/tmp/f88745d5/098f973f/predictor_trial/rtl/decoder.sv /srv/hwebench/tmp/f88745d5/098