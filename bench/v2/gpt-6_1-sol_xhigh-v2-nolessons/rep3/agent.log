{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger operations are combinational. All eight M operations use the\nshared request/result valid-ready interface to registered arithmetic.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nimport random\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb, RTL, TEST_DIR, SIM_BUILD,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    dut.m_is_multiply.value = 0\n    dut.m_is_divide.value = 0\n    dut.result_grants.value = 0\n    dut.pc_plus4.value = 0\n    dut.m_complete.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value), \"divider did not return to idle\"\n    await _tick(dut)\n    dut.div_req_valid.value = 0\n    for _ in range(40):\n        if int(dut.div_result_valid.value):\n            break\n        await _tick(dut)\n    else:\n  \n…[15023 of 18095 chars elided by tools/bench/transcript.py; sha256:d0fd0b8857a95eea]…\n                    (\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\")],\n                 hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n                 parameters={\"SEPARATE_M\": 1, \"PREDECODED_RESULT\": 1},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"+define+RISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir),\n                test_filter=\"predecoded_.*\",\n                extra_env={\"PREDECODED_ALU\": \"1\", \"PREDECODED_ALTOPS\": str(int(altops))})\n\n\ndef test_predecoded_alu_runner():\n    _predecoded_runner(False)\n\n\ndef test_predecoded_altops_alu_runner():\n    _predecoded_runner(True)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
