{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_predictor.py'", "aggregated_output": "\"\"\"Independent direction-counter, raw predecode and pre-edge lookup checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b, _direct_offset, _legal_branch, _predictor_index\n\n\n@cocotb.test()\nasync def counters_predecode_targets_and_reset(dut):\n    counters = [1] * 64\n    pc = 0\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.imem_data.value = NOP()\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n\n    async def edge(insn=NOP(), train=None, stall=1, flush=0, redirect=None, reset=0):\n        nonlocal pc, counters\n        dut.clock.value = 0\n        dut.reset.value = reset\n        dut.imem_data.value = insn\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut.redirect.value = redirect is not None\n        dut.redirect_target.value = redirect or 0\n        dut.train_valid.value = train is not None\n        dut.train_pc.value = train[0] if train else 0\n        dut.train_taken.value = train[1] if train else 0\n        await Timer(2, unit=\"ns\")\n        target = (pc + _direct_offset(insn)) & 0xFFFFFFFF\n        prediction = target & 3 == 0 and (insn & 127 == 0x6F or\n                                         (_legal_branch(insn) and counters[_predictor_index(pc)] >= 2))\n        fetch = int(dut.out.value)\n        assert (fetch >> 1) & 0xFFFFFFFF == insn\n        assert (fetch >> 34) & 1 == prediction, \"lookup bypassed pre-edge counter state\"\n        assert (fetch >> 33) & 1 == (target & 3 == 0)\n        assert (fetch >> 35) & 0xFFFFFFFF == ((pc + 4) & 0xFFFFFFFF if prediction else target)\n        assert fetch & 1 == int(not flush and redirect is None)\n        if reset:\n            counters, next_pc = [1] * 64, 0\n        else:\n            next_pc = redirect if redirect is not None else pc if stall else target if prediction else (pc + 4) & 0xFFFFFFFF\n         \n…[1388 of 4460 chars elided by tools/bench/transcript.py; sha256:8a66863c93086f0f]…\naddress, 1))\n        for funct3 in range(8):\n            for offset in (-4096, -2, 2, 4, 4094):\n                await edge(_b(offset, 0, 0, funct3, 0x63))\n        for offset in (-1048576, -2, 2, 4, 1048574):\n            await edge(JAL(1, offset))\n        await edge(JALR(1, 0, 4))\n        await edge(NOP())\n        await edge(JAL(1, 4), stall=0)\n\n    rng = random.Random(0xD1EC7)\n    for _ in range(500):\n        insn = rng.choice((BEQ(0, 0, rng.choice((-128, 2, 124))), JAL(1, 4096), NOP(), JALR(1, 0, 4)))\n        train = (rng.getrandbits(32), rng.randrange(2)) if rng.random() < 0.8 else None\n        await edge(insn, train, stall=rng.randrange(2), flush=rng.randrange(2),\n                   redirect=(rng.getrandbits(30) << 2) if rng.random() < 0.1 else None)\n    await edge(BEQ(0, 0, 4), train=(pc, 1), redirect=0x100, reset=1)\n    await edge(BEQ(0, 0, 4), stall=0)\n\n\ndef test_predictor_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n                test_module=\"test_predictor\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' tools/eval/fpga.py; sed -n '1,160p' cores/bench/test/conftest.py\"", "aggregated_output": "\"\"\"FPGA fitness: vendor (Gowin EDA) Fmax x CoreMark iterations per cycle.\n\nThe Yosys + nextpnr helpers below (run_seed, _run_perturbations, ...) are\nkept for the research scripts that document the V1 flow; the eval uses\ntools/eval/gowin.py.\n\"\"\"\nimport asyncio, os, re, json, subprocess, statistics\nfrom pathlib import Path\n\nfrom tools.eval import gowin\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\n\ndef _build_synth_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `yosys -c fpga/scripts/synth.tcl`.\n\n    Reads cores/<target>/core.yaml's `nret` field (defaults to 2). When\n    nret=1, injects BENCH=fpga/core_bench_si.sv so synth.tcl reads the\n    single-issue FPGA wrapper (only `_0` RVFI ports) instead of the\n    default dual-channel core_bench.sv. nret=2 leaves BENCH unset and\n    synth.tcl falls back to fpga/core_bench.sv.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"GEN_DIR\"] = f\"cores/{target}/generated\"\n    nret = read_nret(worktree_path / \"cores\" / target / \"core.yaml\")\n    if nret == 1:\n        env[\"BENCH\"] = \"fpga/core_bench_si.sv\"\n    return env\n\nSEEDS = [1, 2, 3]\n# Fmax is scored over (perturbation, seed) pairs. Perturbation k adds an\n# unused k-assign module to synthesis (k=0: the netlist `make` built);\n# neutral changes like this move a design's Fmax by far more than nextpnr\n# seeds do (EXP-2026-09-27-v2-placement-noise), so one netlist is one\n# draw. Set from that calibration; see research/v2/NOTES.md.\n# 9 pairs: one wave on the run host (EXP-2026-09-28-v2-noise-server fixes\n# P=9 and derives the acceptance margin for it).\nPERTURBATIONS = [(0, 1)] + [(7 * i, i + 1) for i in range(1, 9)]\n# The final champion's Fmax for the headline score is measured afresh on\n# perturbations and seeds the loop never used: the loop's number was\n…[7563 of 10635 chars elided by tools/bench/transcript.py; sha256:b71b5fa04fffca95]…\nn is None:\n        sim_bin = str(worktree_path / \"test/cosim/obj_dir/cosim_sim\")\n    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\n    # 50M cycle ceiling: 2K CoreMark with ITERATIONS=10 + iStall+dStall\n    # needs ~5M cycles. 50M gives 10x headroom for slower candidates.\n    try:\n        result = run_pgroup(\n            [sim_bin, elf, \"50000000\"] + COREMARK_SIM_FLAGS,\n            capture_output=True, text=True, timeout=600, env=env\n        )\n    except (subprocess.TimeoutExpired, OSError) as e:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'coremark_harness_error: {e}'}\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n", "exit_code": 0, "status": "completed"}}
