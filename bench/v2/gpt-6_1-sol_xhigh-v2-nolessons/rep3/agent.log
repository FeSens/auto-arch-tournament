{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -c \"cat formal/checks_si.cfg; sed -n '350,410p' tools/eval/fpga.py\"","aggregated_output":"[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n    env = os.environ.copy()\n    rtl_dir = Path(worktree) / \"cores\" / target / \"rtl\" if target is not None else Path(worktree) / \"rtl\"\n    generated_dir = (\n        Path(worktree) / \"cores\" / target / \"generated\" if target is not None else Path(worktree) / \"generated\"\n    )\n    sim_bin = (\n        str(Path(worktree) / \"cores\" / target / \"obj_dir\" / \"cosim_sim\")\n        if target is not None\n        else None\n    )\n\n    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\n                              generated_dir, env=env)\n    fp = gowin.summarize(results)\n    if fp['placement_failed']:\n        return fp\n    if fp['lut4'] is None or fp['ff'] is None:\n        # Never substitute 0: 0 logic is the best possible area score.\n        return {'bench_failed': True, 'placement_failed': False,\n                'reason': 'fpga_report_unparsed: no Logic/Register count in Gowin report',\n                'fmax_mhz': fp['fmax_mhz'], 'seeds': fp['seeds']}\n\n    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n    if not cm['completed']:\n        return {\n            'bench_failed': True,\n            'reason': cm.get('reason', 'unknown'),\n            'fmax_mhz': fp['fmax_mhz'],\n            'seeds': fp['seeds'],\n            'placement_failed': False,\n        }\n\n    fitness = fp['fmax_mhz'] * cm['iter_per_cycle'] * 1_000_000  # iter/sec\n    return {\n        **fp,\n        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n        'fitness':       round(fitness, 2),\n        'cycles':        cm['cycles'],\n        'iterations':    cm['iterations'],\n    }\n\nif __name__ == '__main__':\n    import sys\n    result = run_fpga_eval(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n","exit_code":0,"status":"completed"}}
