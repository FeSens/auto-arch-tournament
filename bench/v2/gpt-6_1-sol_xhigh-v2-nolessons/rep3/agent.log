{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/f88745d5/944d69ae/r9s0-groupedshift')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,rtl/f.name)\nf=rtl/'alu.sv'\ns=f.read_text()\nhelper='''\n  // Shared low/high amount decodes; every data source is constant-index.\n  wire [7:0] shift_fine;\n  wire [3:0] shift_coarse;\n  logic shift_fill;\n  wire [31:0] left_fine, right_fine, left_value, right_value;\n  assign shift_fill = (op == ALU_SRA) && a[31];\n  for (genvar n=0; n<8; n++) begin : gen_fine_decode\n    assign shift_fine[n] = b[2:0] == 3'(n);\n  end\n  for (genvar n=0; n<4; n++) begin : gen_coarse_decode\n    assign shift_coarse[n] = b[4:3] == 2'(n);\n  end\n'''\nfor i in range(32):\n lf=['(shift_fine[%d] & %s)'%(n,f'a[{i-n}]' if i>=n else \\\"1'b0\\\") for n in range(8)]\n rf=['(shift_fine[%d] & %s)'%(n,f'a[{i+n}]' if i+n<32 else 'shift_fill') for n in range(8)]\n lc=['(shift_coarse[%d] & %s)'%(n,f'left_fine[{i-8*n}]' if i>=8*n else \\\"1'b0\\\") for n in range(4)]\n rc=['(shift_coarse[%d] & %s)'%(n,f'right_fine[{i+8*n}]' if i+8*n<32 else 'shift_fill') for n in range(4)]\n helper+=f'  assign left_fine[{i}] = '+ ' | '.join(lf)+';\\\\n'\n helper+=f'  assign right_fine[{i}] = '+ ' | '.join(rf)+';\\\\n'\n helper+=f'  assign left_value[{i}] = '+ ' | '.join(lc)+';\\\\n'\n helper+=f'  assign right_value[{i}] = '+ ' | '.join(rc)+';\\\\n'\ns=s.replace('  always_comb begin\\\\n    shamt',helper+'\\\\n  always_comb begin\\\\n    shamt')\ns=s.replace('ALU_SLL:    out = a << shamt;','ALU_SLL:    out = left_value;')\ns=s.replace('ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','ALU_SRL, ALU_SRA: out = right_value;')\ns=s.replace('  logic        [4:0]  shamt;','').replace('    shamt = b[4:0];','')\nf.write_text(s)\nprint(r