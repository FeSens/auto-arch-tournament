      e_phoff     = struct.unpack_from('<I', data, 28)[0]\n        e_phentsize = struct.unpack_from('<H', data, 42)[0]\n        e_phnum     = struct.unpack_from('<H', data, 44)[0]\n        self.pc     = struct.unpack_from('<I', data, 24)[0]\n        for i in range(e_phnum):\n            off      = e_phoff + i * e_phentsize\n            p_type   = struct.unpack_from('<I', data, off)[0]\n            p_\n…[8212 of 11284 chars elided by tools/bench/transcript.py; sha256:0d681b4b14fa5cb0]…\nes stay aligned across illegal / misaligned\ntest/cosim/reference.py:47:    def load_elf(self, path: str):\ntest/cosim/reference.py:53:        self.pc     = struct.unpack_from('<I', data, 24)[0]\ntest/cosim/reference.py:61:                self.mem[p_vaddr:p_vaddr+p_filesz] = data[p_offset:p_offset+p_filesz]\ntest/cosim/reference.py:63:    def _in_uart(self, a): return (a & UART_MASK) == UART_BASE\ntest/cosim/reference.py:64:    def _in_mem (self, a): return a < MEM_BYTES\ntest/cosim/reference.py:66:    def rw(self, addr):\ntest/cosim/reference.py:67:        if self._in_uart(addr): self.oob_access = True; return 0\ntest/cosim/reference.py:68:        if not self._in_mem(addr): self.oob_access = True\ntest/cosim/reference.py:69:        return struct.unpack_from('<I', self.mem, addr & 0xFFFFFC)[0]\ntest/cosim/reference.py:70:    def rb(self, addr):\ntest/cosim/reference.py:71:        if self._in_uart(addr): self.oob_access = True; return 0\ntest/cosim/reference.py:72:        if not self._in_mem(addr): self.oob_access = True\n", "exit_code": 0, "status": "completed"}}
