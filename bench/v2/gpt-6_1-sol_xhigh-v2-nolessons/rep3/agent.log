{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,struct,time\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM(); cpu.load_elf('bench/programs/coremark.elf')\np=Path('/srv/hwebench/tmp/f88745d5/d508f939/branches.bin')\nactive=False; n=0; branches=0; start=time.time()\nwith p.open('wb') as f:\n for k in range(10000000):\n  r=cpu.step()\n  if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n  if r['mem_wmask'] and r['mem_addr']==0x10000104: active=False\n  if r['insn'] & 127 == 0x63 and not r['trap']:\n   taken=int(r['npc'] \"'!= ((r['\"'pc']+4)&0xffffffff))\n   f.write(struct.pack('<IIBB',r['pc'],r['insn'],taken,active)); branches+=int(active)\n  if active: n+=1\n  if r['insn']==0x00100073: break\nprint({'retired':k+1,'bracketed_instructions':n,'branches':branches,'seconds':time.time()-start,'trace':str(p)},flush=True)\ntrace=list(struct.iter_unpack('<IIBB',p.read_bytes()))\nfor bits in [3,4,5,6,7,8]:\n mask=(1<<bits)-1\n for agree in [False,True]:\n  table=[2 if agree else 1]*(1<<bits); misses=0\n  for pc,insn,taken,active in trace:\n   idx=((pc>>2)\"'^(pc>>8))&mask\n   bias=insn>>31\n   pred=(bias ''^ (table[idx]<2)) if agree else int(table[idx]>=2)\n   misses+=int(active and pred!=taken)\n   update=int(taken==bias) if agree else taken\n   table[idx]=min(3,table[idx]+1) if update else max(0,table[idx]-1)\n  print({'\"'entries':1<<bits,'agree':agree,'misses':misses},flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
