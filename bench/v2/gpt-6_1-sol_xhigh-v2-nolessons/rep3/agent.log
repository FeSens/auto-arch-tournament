{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '185,450p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "        wb_payload = int(dut.mem_wb_w.value)\n        wb_data = int(dut.wb_w_data.value)\n        kill_valid = int(dut.kill_id_valid.value)\n        ex_payload = int(dut.id_ex_w.value)\n        grants = _result_grants(ex_payload)\n        captured_control = (ex_payload >> 33) & ((1 << 22) - 1)\n        if ex_payload:\n            assert grants == _grants_from_control(captured_control), \\\n                \"registered grants disagree with captured controls\"\n        incoming_grants = _grants_from_control(int(dut.u_id.ctrl_decoded.value))\n        memory_payload = int(dut.ex_mem_w.value)\n        expected_addr = int(dut.u_ex.jalr_sum.value)\n        expected_store_data = int(dut.u_ex.rs2.value)\n        completed_m = int(dut.u_ex.divide_active_q.value) and int(dut.u_ex.div_result_valid.value)\n        if int(dut.u_ex.divide_active_q.value) or launch:\n            assert grants == 0, \"M ownership must exclude integer/link grants\"\n        assert not completed_m or grants == 0, \"completed M overlapped an integer/link grant\"\n        expected_arithmetic = 0\n        if grants:\n            assert grants & (grants - 1) == 0, \"result grants are not one-hot\"\n            op = grants.bit_length() - 1\n            expected_arithmetic = ((ex_payload >> (len(dut.id_ex_w) - 32)) + 4) & 0xFFFFFFFF \\\n                if op == 11 else integer_reference(op, int(dut.u_ex.alu_a.value),\n                                                  int(dut.u_ex.alu_b.value))\n        if completed_m:\n            expected_arithmetic = int(dut.u_ex.m_result.value)\n        assert int(dut.u_ex.alu_result.value) == expected_arithmetic, \\\n            \"complete ALU output disagrees with independent result reference\"\n        selections = tuple(int(s.value) for s in\n                           (dut.fwd_rs1_sel, dut.fwd_rs2_sel,\n                            dut.alu_a_sel, dut.alu_b_sel))\n        assert ((selections[2] in (1, 2, 4, 8) and selections[3] in (1, 2, 4, 8))\n                or (not (ex_payload & 1) and selections[2:] == (0, 0))), \\\n            \"ALU selections must remain \n…[11828 of 14900 chars elided by tools/bench/transcript.py; sha256:cc52efdac07177a9]…\n, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n", "exit_code": 0, "status": "completed"}}
