ster; PC reg sits in if_stage).\n   typedef struct packed {\n     logic [31:0] pc;\n+    logic [31:0] sequential_pc; // exact PC+4, combinational fetch operand only\n     logic [31:0] recovery_addr; // alternate direct path, prepared in IF\n     logic        predicted_taken;\n     logic        direct_aligned;\ndiff --git a/cores/bench/rtl/ex_stage.sv b/cores/bench/rtl/ex_stage.sv\nindex 2ccbb5c..dbf0a0a 100644\n--- a/cores/bench/\n…[3840 of 6912 chars elided by tools/bench/transcript.py; sha256:91a0a7eb41e9e6fe]…\n,8 +106,8 @@ module id_stage (\n         reg_q.pc       <= in.pc;\n         reg_q.rs1_val  <= rs1_data;\n         reg_q.rs2_val  <= rs2_data;\n-        reg_q.imm      <= (dec_is_branch || (dec_is_jump && !dec_is_jalr))\n-                        ? in.recovery_addr : imm;\n+        reg_q.imm      <= dec_is_branch ? in.recovery_addr\n+                       : dec_is_jump   ? in.sequential_pc : imm;\n         reg_q.predicted_taken <= in.predicted_taken;\n         reg_q.direct_aligned <= in.direct_aligned;\n         reg_q.mismatch_op <= dec_branch_op ^ {2'b00, in.predicted_taken};\ndiff --git a/cores/bench/rtl/if_stage.sv b/cores/bench/rtl/if_stage.sv\nindex 75a0572..ccb6301 100644\n--- a/cores/bench/rtl/if_stage.sv\n+++ b/cores/bench/rtl/if_stage.sv\n@@ -114,6 +114,7 @@ module if_stage (\n \n   always_comb begin\n     out.pc    = pc;\n+    out.sequential_pc = sequential_pc;\n     out.recovery_addr = predicted_taken ? sequential_pc : direct_target;\n     out.predicted_taken = predicted_taken;\n     out.direct_aligned = direct_aligned;\n", "exit_code": 0, "status": "completed"}}
