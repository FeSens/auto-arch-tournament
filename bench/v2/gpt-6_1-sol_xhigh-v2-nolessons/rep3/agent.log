{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/test/test_pipeline.py')\nshutil.copy2(p,Path('cores/bench/generated/predictor_trial_original/test_pipeline.py'))\ns=p.read_text()\ninsert='''\n@cocotb.test()\nasync def direction_predictor_warm_loop_and_false_taken_recovery(dut):\n    branch = _b(-4, 0, 1, 0b001, 0b1100011)\n    program = [ADDI(1, 0, 8), ADDI(1, 1, -1), branch, SW(1, 0, 0x100), EBREAK()]\n    observed = []\n    rets, dmem = await _run(dut, program, max_cycles=100, observations=observed)\n    branches = [r for r in rets if r['pc'] == 8]\n    assert len(branches) == 8\n    assert [r['rs1_rdata'] for r in branches] == list(range(7,-1,-1))\n    assert [r['pc_next'] for r in branches] == [4]*7+[12]\n    assert dmem == {0x100: 0}\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    for branch_ret in branches[:-1]:\n        younger = rets[rets.index(branch_ret)+1]\n        assert younger['pc'] == 4\n        assert younger['cycle'] - branch_ret['cycle'] == 1, 'correct taken prediction left a bubble'\n    [store] = [r for r in rets if r['pc']==12]\n    assert store['cycle'] - branches[-1]['cycle'] == 2\n    assert sum(o['redirect'] for o in observed) == 1, 'warm loop should recover only its not-taken exit'\n    assert int(dut.u_if.counters[2].value) == 2, 'counter should saturate then decrement once'\n\n@cocotb.test()\nasync def direction_predictor_loop_with_stalls(dut):\n    branch = _b(-4, 0, 1, 0b001, 0b1100011)\n    program = [ADDI(1, 0, 20), ADDI(1, 1, -1), branch, SW(1, 0, 0x100), EBREAK()]\n    observed = []\n    rets, dmem = await _run(dut, program, max_cycles=200,\n        ready_fn=lambda c, req:(int(c%4\"'!=0),int(c%3!=0)), observations=observed)\n    branches = [r for r in rets if r['\"'pc']==8]\n    assert len(branches)==20\n    assert [r['rs1_rdata'] for r in branches] == list(range(19,-1,-1))\n    assert [r['pc_next'] for r in branches] == [4]*19+[12]\n    assert dmem == {0x100:0}\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert int(dut.u_if.counters[2].value)==2\n\n'''\ns=s.replace('def test_pipeline_runner():',insert+'def test_pipeline_runner():')\np.write_text(s)\nprint('Added warm-loop, false-taken recovery and stalled-loop trial coverage')\nPY\npytest -q cores/bench/test/test_pipeline.py > cores/bench/generated/predictor_trial2_extended_tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
