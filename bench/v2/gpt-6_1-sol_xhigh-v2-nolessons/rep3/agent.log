{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nimport sys, struct, json, time\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nroot=Path('cores/bench/generated/predictor_research')\ncpu=RV32IM(); cpu.load_elf(str(root/'coremark.elf')); active=False; branches=[]; total=0; first=0; t=time.monotonic()\nwhile total<10000000:\n r=cpu.step(); total+=1\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True; first=total\n if active and r['insn']&127==0x63:\n  branches.append((r['pc'], int(r['npc'] \"'!= (r['\"'pc']+4)&0xffffffff), r['insn']>>31))\n if r['mem_wmask'] and r['mem_addr']==0x10000104: break\n if r['insn']==0x00100073: break\n(root/'branches.bin').write_bytes(b''.join(struct.pack('<IBB',*b) for b in branches))\nprint(json.dumps({'elapsed':time.monotonic()-t,'total_insns':total,'bracketed_insns':total-first,'branches':len(branches),'oob':cpu.oob_access}),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/predictor_research'); src=Path('cores/bench/rtl')\nfor name in ('hashed32','gshare32','agree32','last64'):\n out=root/name/'rtl'; out.mkdir(parents=True,exist_ok=True)\n for p in src.glob('*.sv'): shutil.copy2(p,out/p.name)\n p=out/'if_stage.sv'; s=p.read_text()\n if name.endswith('32'):\n  s=s.replace('[5:0] lookup_index, train_index','[4:0] lookup_index, train_index').replace('[63:0] counter_msb','[31:0] counter_msb').replace('[7:0] lookup_groups','[3:0] lookup_groups').replace('pc[7:2] \"'^ pc[13:8]'\"','pc[6:2] \"'^ pc[12:8]'\"').replace('train_pc[7:2] \"'^ train_pc[13:8]'\"','train_pc[6:2] \"'^ train_pc[12:8]'\"').replace('e < 64','e < 32').replace('[5:0] INDEX = 6\\\\'(e)','[4:0] INDEX = 5\\\\'(e)').replace('g < 8','g < 4')\n  start=s.index('    case (lookup_index[5:3])')\n  end=s.index('    pre_branch =',start)\n  s=s[:start]+'''    case (lookup_index[4:3])\n      2'd0: direction = lookup_groups[0];\n      2'd1: direction = lookup_groups[1];\n      2'd2: direction = lookup_groups[2];\n      default: direction = lookup_groups[3];\n    endcase\n'''+s[end:]\n if name=='gshare32':\n  s=s.replace('  logic direction;','''  logic direction;\n  logic [4:0] history_q;\n  always_ff @(posedge clock) begin\n    if (reset) history_q <= 5'b0;\n    else if (train_valid) history_q <= {history_q[3:0], train_taken};\n  end''')\n  s=s.replace('pc[6:2] \"'^ pc[12:8]'\"','pc[6:2] \"'^ history_q'\"').replace('train_pc[6:2] \"'^ train_pc[12:8]'\"','train_pc[6:2] \"'^ history_q'\"')\n if name=='agree32':\n  s=s.replace('      if (reset) counter_q <= 2\\\\'b01;','      if (reset) counter_q <= 2\\\\'b10;')\n  s=s.replace('train_taken ?','(train_taken == train_bias) ?')\n  s=s.replace('pre_branch && direction','pre_branch && (direction \"'^ !imem_data[31])'\"')\n  s=s.replace('  input  logic       