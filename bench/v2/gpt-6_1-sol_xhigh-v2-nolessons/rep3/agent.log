; i++) counters[i] <= 2'b01;\n    end else if (train_valid) begin\n      if (train_taken) begin\n        if (counters[train_index] \"'!= 2'\"'b11) counters[train_index] <= counters[train_index] + 2'b01;\n      end else begin\n        if (counters[train_index] \"'!= 2'\"'b00) counters[train_index] <= counters[train_index] - 2'b01;\n      end\n    end\n  end''')\ns=s.replace('next_pc = redirect ? redirect_target : pc + 32\\\\'d4;','next_pc = predicted_taken ? direct_target : pc + 32\\\\'d4;')\ns=s.replace('out.pc    = pc;','out.pc    = pc;\\\\n    out.predicted_taken = predicted_taken;')\np.write_text(s)\np=root/'ex_stage.sv'\ns=p.read_text().replace('output logic [31:0]        redirect_target','output logic train_valid,\\\\n  output logic [31:0] train_pc,\\\\n  output logic train_taken,\\\\n  output logic [31:0]        redirect_target')\ns=s.replace('assign redirect        = in.valid && (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"\\\\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;', '''logic resolved_taken;\n  assign resolved_taken = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault && !in.ctrl.is_illegal;\n  assign redirect = in.valid && !stall && (in.predicted_taken ''^ resolved_taken);\n  assign redirect_target = !resolved_taken ? in.pc + 32'\"'d4\n                         : in.ctrl.is_jump ? jump_target : branch_target;\n  assign train_valid = in.valid && \"'!stall && !divide_wait && in.ctrl.is_branch &&\n                       !in.ctrl.is_illegal && (branch_target[1:0] == 2'\"'b00);\n  assign train_pc = in.pc;\n  assign train_taken = branch_taken;''')\np.write_text(s)\np=root/'core.sv'\ns=p.read_text().replace('logic [31:0] redirect_target;','logic [31:0] redirect_target;\\\\n  logic train_valid, train_taken;\\\\n  logic [31:0] train_pc;')\ns=s.replace('.redirect_target (redirect_target),','.redirect_target (redirect_target),\\\\n    .train_valid     (train_valid),\\\\n    .train_pc        (train_pc),\\\\n    .train_taken     (train_taken),')\ns=s.replace('.redirect_target (redirect_target)\\\\n  );','.redirect_target (redirect_target),\\\\n    .train_valid     (train_valid),\\\\n    .train_pc        (train_pc),\\\\n    .train_taken     (train_taken)\\\\n  );')\np.write_text(s)\nprint('Created reversible direction-only RTL trial')\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
