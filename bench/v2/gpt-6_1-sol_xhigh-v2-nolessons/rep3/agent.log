is_divide = op == ALU_DIV || op == ALU_DIVU ||\\\\n                     op == ALU_REM || op == ALU_REMU;','''  assign is_divide = SPLIT_M ? m_class[1] :\n                    (op == ALU_DIV || op == ALU_DIVU ||\n                     op == ALU_REM || op == ALU_REMU);''')\ns=s.replace('  assign div_result_valid = is_multiply ? mul_result_valid\\\\n                          : (is_divide && divider_result_valid);','''  assign div_result_valid = mul_result_valid || divider_result_valid;\n  assign m_result = owner_multiply_q ? mul_result\n                    : (div_result_rem ? div_remainder : div_quotient);\n  always_ff @(posedge clock) begin\n    if (reset) owner_multiply_q <= 1'b0;\n    else if (div_req_valid && div_req_ready) owner_multiply_q <= is_multiply;\n  end''')\ns=s.replace('.result_ready (div_result_ready && is_multiply)', '.result_ready (div_result_ready && owner_multiply_q)')\ns=s.replace('.result_ready (div_result_ready && is_divide)', '.result_ready (div_result_ready && \"'!owner_multiply_q)'\"')\ns=s.replace('                   out = mul_result;',\\\"                   out = SPLIT_M ? 32'b0 : mul_result;\\\")\ns=s.replace('                   out = div_result_rem ? div_remainder : div_quotient;',\\\"                   out = SPLIT_M ? 32'b0 : (div_result_rem ? div_remainder : div_quotient);\\\")\np.write_text(s)\np=trial/'rtl/ex_stage.sv'\ns=p.read_text().replace('  logic [31:0] alu_result;','  logic [31:0] alu_result;\\\\n  logic [31:0] m_result;')\ns=s.replace('''  assign is_divide = in.valid && \"'!in.ctrl.is_illegal &&\n                    (in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH ||\n                     in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU ||\n                     in.ctrl.alu_op == ALU_DIV || in.ctrl.alu_op == ALU_DIVU ||\n                     in.ctrl.alu_op == ALU_REM || in.ctrl.alu_op == ALU_REMU);'\"''','''  assign is_divide = in.valid && (in.m_multiply || in.m_divide);''')\ns=s.replace('  alu u_alu (',\\\"  al