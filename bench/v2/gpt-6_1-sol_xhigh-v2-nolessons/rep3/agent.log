{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"command -v verilator\ncommand -v iverilog\ncommand -v yosys\ncommand -v pytest\nsed -n '505,620p' cores/bench/test/test_alu.py\nsed -n '1,170p' tools/eval/cosim.py\ncat test/cosim/build.sh\"", "aggregated_output": "/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/oss-cad-suite/bin/iverilog\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n/srv/hwebench/venv/bin/pytest\n\n\ndef test_predecoded_alu_runner():\n    _predecoded_runner(False)\n\n\ndef test_predecoded_altops_alu_runner():\n    _predecoded_runner(True)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\"\"\"Runs Verilator cosim for all bench ELFs. Returns structured pass/fail.\n\nCorrectness is gated in two stages:\n  1. Full RVFI trace cosim for selftest and any other small ELF — every\n     retirement is diffed against the Python reference ISS.\n  2. CoreMark CRC validation via the sim's UART capture — full-trace cosim\n     of coremark.elf is skipped because the Python reference is ~10⁴× slower\n     than Verilator (would take 30+ minutes per candidate). Instead we run\n     the sim in --bench mode and verify its UART matches the canonical CRCs\n     with `validate_coremark_uart` (the same check run_fpga_eval uses). This\n     catches any CPU bug that affects CoreMark output without the full trace\n     overhead.\n\"\"\"\nimport os, subprocess, json, sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\nBENCH_DIR = Path(\"bench/programs\")\n\n\ndef _build_cosim_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `bash test/cosim/build.sh`.\n\n    Reads cores/<target>/core.yaml's `nret` (defaults to 2) and injects\n    NRET=<n> so build.sh can pass `-DNRET=<n>` to verilator. main.cpp's\n    channel-1 drain is compiled out under `#if NRET < 2`, so a single-\n    issue core (no `_1` ports) builds cleanly.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_\n…[7478 of 10550 chars elided by tools/bench/transcript.py; sha256:a541b0fdd86b264d]…\nRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hypgen_r13/alu_arithmetic_tb.sv')\np.write_text('''module alu_arithmetic_tb;\n logic clock=0, reset=1;\n logic [4:0] op;\n logic [31:0] a,b;\n wire [31:0] result_encoded,result_predecoded;\n logic [11:0] grants;\n alu encoded(.clock(clock),.reset(reset),.op(op),.a(a),.b(b),\n .div_req_valid(1'b0),.div_req_ready(),.div_result_valid(),.div_result_ready(1'b0),\n .m_is_multiply(1'b0),.m_is_divide(1'b0),.result_grants(grants),.pc_plus4(32'b0),\n .m_complete(1'b0),.m_result(),.out(result_encoded));\n alu #(.PREDECODED_RESULT(1'b1)) predecoded(.clock(clock),.reset(reset),.op(op),.a(a),.b(b),\n .div_req_valid(1'b0),.div_req_ready(),.div_result_valid(),.div_result_ready(1'b0),\n .m_is_multiply(1'b0),.m_is_divide(1'b0),.result_grants(grants),.pc_plus4(32'b0),\n .m_complete(1'b0),.m_result(),.out(result_predecoded));\n logic [31:0] expected;\n task automatic check(input logic [31:0] x,input logic [31:0] y);\n   a=x; b=y;\n   for(int k=0;k<2;k++) begin\n     op=5'(k); grants=12'(1<<k); expected=k ? x-y : x+y;\n     #1;\n     if(result_encoded\"'!==expected || result_predecoded!==expected)\n       $fatal(1,\"a=%h b=%h op=%d expected=%h encoded=%h predecoded=%h\",a,b,op,expected,result_encoded,result_predecoded);\n   end\n endtask\n initial begin\n  for(int k=0;k<32;k++) begin\n   check((32'\"'h1<<k)-1,32'h1);\n   check(32'h1<<k,32'h1);\n   check(32'hffffffff,32'h1<<k);\n   check(32'h0,32'h1<<k);\n  end\n  check(32'h80000000,32'hffffffff);\n  check(32'h7fffffff,32'h1);\n  check(32'hffffffff,32'hffffffff);\n  for(int k=0;k<100000;k++) check(\"'$urandom,$urandom);\n  $display(\"PASS 200262 encoded/predecoded ADD/SUB comparisons\");\n  $finish;\n end\nendmodule\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
