{"type": "item.completed", "item": {"id": "item_63", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// PC-only, fully tagged next-PC prediction. Every entry owns constant-index\n// flops and a local write enable; four eight-entry groups partition lookup.\n// Fetch data and availability affect only payload/acceptance, never lookup.\nmodule if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        stall,\n  input  logic        flush,\n  input  logic        redirect,\n  input  logic [31:0] redirect_target,\n  input  logic        train_valid,\n  input  logic        invalidate_valid,\n  input  logic [31:0] train_pc,\n  input  logic        train_taken,\n  input  logic        train_conditional,\n  input  logic [31:0] train_target,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  output if_id_t      out\n);\n  logic [31:0] pc, next_pc;\n  wire [29:0] entry_targets [0:31];\n  wire [24:0] entry_tags [0:31];\n  wire [31:0] entry_taken;\n  wire [29:0] target_groups [0:3];\n  wire [24:0] tag_groups [0:3];\n  wire [3:0] eligible_groups;\n  wire [3:0] taken_groups;\n  logic [29:0] target;\n  logic taken;\n\n  for (genvar e = 0; e < 32; e++) begin : gen_predictor\n    localparam logic [4:0] INDEX = 5'(e);\n    logic valid_q, conditional_q;\n    logic [24:0] tag_q;\n    logic [29:0] target_q;\n    logic [1:0] counter_q;\n    wire matching = valid_q && tag_q == train_pc[31:7];\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        valid_q <= 1'b0;\n        counter_q <= 2'b01;\n      end else if (train_pc[6:2] == INDEX) begin\n        if (train_valid && train_pc[1:0] == 2'b00 &&\n            train_target[1:0] == 2'b00) begin\n          valid_q <= 1'b1;\n          tag_q <= train_pc[31:7];\n          target_q <= train_target[31:2];\n          conditional_q <= train_conditional;\n          if (!matching || conditional_q != train_conditional)\n            counter_q <= train_taken ? 2'b10 : 2'b01;\n          else if (train_conditional) begin\n            case (counter_q)\n              2'b00: counter_q <= train_taken ? 2'b01 : 2'b00;\n              2'b01: counter_q <= train_taken ? 2'b10 : 2'b00;\n              2'b1\n…[1957 of 5029 chars elided by tools/bench/transcript.py; sha256:3c7be363d876c25c]…\n | ((pc[4:2] == 3'd6) && entry_taken[g*8 + 6])\n      | ((pc[4:2] == 3'd7) && entry_taken[g*8 + 7]);\n    assign taken_groups[g] = eligible_groups[g] && pc[6:5] == 2'(g) &&\n                             tag_groups[g] == pc[31:7];\n  end\n  always_comb begin\n    taken = |taken_groups;\n    target = (target_groups[0] & {30{taken_groups[0]}})\n           | (target_groups[1] & {30{taken_groups[1]}})\n           | (target_groups[2] & {30{taken_groups[2]}})\n           | (target_groups[3] & {30{taken_groups[3]}});\n    next_pc = {target, 2'b00} | ((pc + 32'd4) & {32{!taken}});\n    out.pc = pc;\n    out.predicted_next_pc = next_pc;\n    out.instr = imem_data;\n    out.valid = !(flush || redirect);\n  end\n  // Correction is issued only when its registered owner can advance. It\n  // still has priority over unavailable fetch and every frontend hold.\n  always_ff @(posedge clock) begin\n    if (reset) pc <= 32'b0;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall) pc <= next_pc;\n  end\n  assign imem_addr = pc;\nendmodule\n", "exit_code": 0, "status": "completed"}}
