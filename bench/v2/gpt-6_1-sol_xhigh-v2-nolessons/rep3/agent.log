(imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0,\n…[62906 of 65978 chars elided by tools/bench/transcript.py; sha256:c82db327d4e28588]…\nkey], value)\n        assert dmem == memory\n        launches = [o for o in observed if o[\"launch\"]]\n        transfers = [o for o in observed if o[\"result_valid\"] and o[\"result_ready\"]]\n        assert len(launches) == len(transfers) == 25\n        assert any(o[\"active\"] and not o[\"result_valid\"] and\n                   o[\"request_addr_next\"] != o[\"request_addr_q\"] for o in observed)\n        assert all(not o[\"request\"][2] and not o[\"request\"][3]\n                   for o in observed if o[\"active\"])\n        assert all(o[\"result\"] == 0 for o in transfers), \"integer path selected M data\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
