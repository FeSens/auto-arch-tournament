{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\ntrial=Path('cores/bench/generated/r6s1_trial')\nt=trial/'test'\nt.mkdir(exist_ok=True)\nfor name in ('_helpers.py','conftest.py','test_pipeline.py'):\n shutil.copy2(Path('cores/bench/test')/name,t/name)\np=t/'test_pipeline.py'\ns=p.read_text()\ns+='''\n\n@cocotb.test()\nasync def wb_result_boundary_subwords_and_mixed_producers(dut):\n    \\\"\\\"\\\"Architectural model checks mixed writeback values under bus holds.\\\"\\\"\\\"\n    rng = random.Random(0x6B00)\n    mem_init = {0x500 + i * 4: rng.getrandbits(32) for i in range(12)}\n    for stalled in (False, True):\n        regs = [0] * 32\n        program, expected, stores = [], [], {}\n\n        def emit(instr, rd, value):\n            rs1, rs2 = (instr >> 15) & 31, (instr >> 20) & 31\n            expected.append((rs1, regs[rs1], rs2, regs[rs2], rd, value if rd else 0))\n            program.append(instr)\n            if rd:\n                regs[rd] = value & 0xffffffff\n\n        emit(ADDI(10, 0, 0x500), 10, 0x500)\n        for index in range(60):\n            funct3 = (0, 1, 2, 4, 5)[index % 5]\n            width = {0: 1, 1: 2, 2: 4, 4: 1, 5: 2}[funct3]\n            offset = (index % 12) * 4 + (rng.randrange(4 // width) * width)\n            value = (mem_init[0x500 + (offset & ~3)] >> (8 * (offset & 3))) & ((1 << (8 * width)) - 1)\n            if funct3 < 3 and value & (1 << (8 * width - 1)):\n                value -= 1 << (8 * width)\n            value &= 0xffffffff\n            rd = (index % 8) + 1\n            emit(_i(offset, 10, funct3, rd, 0x03), rd, value)\n            if index % 3 == 0:\n                # A blocked intervening store keeps a consumer on retained WB.\n                addr = 0x700 + index * 4\n                emit(SW(rd, 0, addr), 0, 0)\n                stores[addr] = regs[rd]\n            other = (rd % 8) + 1\n            emit(ADDI(other, rd, -7), other, (regs[rd] - 7) & 0xffffffff)\n            emit(XOR(rd, rd, other), rd, (regs[rd] \"'^ regs[other]) & 0xffffffff)\n            if index % 7 == 0:\n                emit(MUL(other, rd, other), other, (regs[rd] * regs[other]) & 0xffffffff)\n            if index % 11 == 0:\n                emit(ADDI(0, rd, 19), 0, 0)\n        emit(EBREAK(), 0, 0)\n        stalls = random.Random(0x6A11)\n        blocked = {}\n\n        def ready(cycle, req):\n            addr, data, wen, ren = req\n            if wen:\n                blocked[addr] = blocked.get(addr, 0) + 1\n                if blocked[addr] <= 5:\n                    return 0, 0\n            return int(stalls.random() >= 0.22), int(stalls.random() >= 0.35)\n\n        observed = []\n        rets, mem = await _run(dut, program, mem_init, max_cycles=3000,\n                               ready_fn=ready if stalled else None,\n                               observations=observed)\n        _check_stream(rets, program)\n        for r, want in zip(rets, expected):\n            got = tuple(r[k] for k in ('\"'rs1_addr','rs1_rdata','rs2_addr','rs2_rdata','rd','rd_wdata'))\n            assert got == want, (r['pc'], got, want)\n        assert mem == {**mem_init, **stores}\n        if stalled:\n            assert any(o['hold_payload'] and not o['wb_valid'] and\n                       (o['fwd_rs1'] == 2 or o['fwd_rs2'] == 2) for o in observed)\n'''\np.write_text(s)\nprint('Prepared additional independent mixed-producer/subword architectural test')\nPY\nCOCOTB_TEST_FILTER=wb_result_boundary python3 - <<'PY' > cores/bench/generated/r6s1_trial/extra_pipeline.log 2>&1\nfrom pathlib import Path\nimport sys\np=Path('cores/bench/generated/r6s1_trial/test').resolve()\nsys.path.insert(0,str(p))\nimport test_pipeline\ntest_pipeline.test_pipeline_runner()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
