{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/f88745d5/d508f939/agree_search.cpp')\np.write_text(r'''\n#include <cstdio>\n#include <cstdint>\n#include <vector>\n#include <algorithm>\nstruct B {uint32_t pc, insn; uint8_t t,active;};\nstruct R {int misses,bits,a,b,c;bool agree;};\nint main(int argc,char**argv){\n FILE*f=fopen(argv[1],\\\"rb\\\"); std::vector<B> bs; B b;\n while(fread(&b.pc,4,1,f)&&fread(&b.insn,4,1,f)&&fread(&b.t,1,1,f)&&fread(&b.active,1,1,f))bs.push_back(b);\n std::vector<R> rs;\n for(int bits=3;bits<=6;bits++) for(int a=2;a<=9;a++)for(int z=a+1;z<=13;z++)for(int c=0;c<=1;c++)for(int agree=0;agree<=1;agree++){\n  int mask=(1<<bits)-1,misses=0;uint8_t cs[64]; std::fill(cs,cs+64,agree?2:1);\n  for(auto b:bs){int index=((b.pc>>a)\"'^(b.pc>>z)''^(c?(b.pc>>(z+bits)):0))&mask;\n   int bias=b.insn>>31,pred=agree?(bias''^(cs[index]<2)):(cs[index]>=2);\n   misses+=(b.active&&pred!=b.t);int train=agree?(b.t==bias):b.t;\n   cs[index]=train?std::min(int(cs[index])+1,3):std::max(int(cs[index])-1,0);\n  }\n  rs.push_back({misses,bits,a,z,c,bool(agree)});\n }\n for(int bits=3;bits<=6;bits++){\n  std::vector<R> sub;for(auto r:rs)if(r.bits==bits)sub.push_back(r);\n  std::sort(sub.begin(),sub.end(),[](auto a,auto b){return a.misses<b.misses;});\n  for(int n=0;n<6;n++){auto r=sub[n];printf(\"entries=%d misses=%d a=%d b=%d third=%d agree=%d'\"\\\\n\\\",1<<bits,r.misses,r.a,r.b,r.c,int(r.agree));}\n }\n}\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
