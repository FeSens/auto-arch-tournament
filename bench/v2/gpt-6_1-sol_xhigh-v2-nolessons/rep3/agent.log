{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/early_operand_probe'); rtl=root/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/generated/preselect_probe/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv'; s=p.read_text().replace('    logic [31:0] alu_base_b;', '    logic [31:0] alu_base_b;\\\\n    logic [2:0] alu_a_sel, alu_b_sel, rs1_sel, rs2_sel;'); p.write_text(s)\np=rtl/'id_stage.sv'; s=p.read_text().replace('  input  logic              flush,', '  input  logic [4:0] ex_rd, mem_rd,\\\\n  input  logic ex_wen, mem_wen,\\\\n  input  logic              flush,')\na=s.index('  // ── ID/EX register'); s=s[:a]+'''  logic [2:0] sel1, sel2;\n  always_comb begin\n    if (ex_wen && ex_rd \"'!= 0 && ex_rd == rs1_addr) sel1 = 3'\"'b010;\n    else if (mem_wen && mem_rd \"'!= 0 && mem_rd == rs1_addr) sel1 = 3'\"'b100;\n    else sel1 = 3'b001;\n    if (ex_wen && ex_rd \"'!= 0 && ex_rd == rs2_addr) sel2 = 3'\"'b010;\n    else if (mem_wen && mem_rd \"'!= 0 && mem_rd == rs2_addr) sel2 = 3'\"'b100;\n    else sel2 = 3'b001;\n  end\n\n'''+s[a:]\ns=s.replace('        reg_q.alu_base_b <= dec_alu_src ? imm : rs2_data;', '''        reg_q.alu_base_b <= dec_alu_src ? imm : rs2_data;\n        reg_q.rs1_sel <= sel1;\n        reg_q.rs2_sel <= sel2;\n        reg_q.alu_a_sel <= dec_is_auipc ? 3'b001 : sel1;\n        reg_q.alu_b_sel <= dec_alu_src ? 3'b001 : sel2;'''); p.write_text(s)\np=rtl/'core.sv'; s=p.read_text().replace('  id_stage u_id (', '''  id_stage u_id (\n    .ex_rd(id_ex_w.rd), .mem_rd(ex_mem_w.rd),\n    .ex_wen(id_ex_w.valid && id_ex_w.ctrl.reg_write),\n    .mem_wen(ex_mem_w.ctrl.reg_write),'''); p.write_text(s)\np=rtl/'ex_stage.sv'; s=p.read_text(); a=s.index('  always_comb begin'); b=s.index('  logic [31:0] alu_result;',a)\ns=s[:a]+'''  assign rs1 = ({32{in.rs1_sel[0]}} & in.rs1_val)\n             | ({32{in.rs1_sel[1]}} & fwd_ex_mem)\n             | ({32{in.rs1_sel[2]}} & fwd_mem_wb);\n  assign rs2 = ({32{in.rs2_sel[0]}} & in.rs2_val)\n             | ({32{in.rs2_sel[1]}} & fwd_ex_mem)\n             | ({32{in.rs2_sel[2]}} & fwd_mem_wb);\n  logic [31:0] alu_a, alu_b;\n  assign alu_a = ({32{in.alu_a_sel[0]}} & in.alu_base_a)\n               | ({32{in.alu_a_sel[1]}} & fwd_ex_mem)\n               | ({32{in.alu_a_sel[2]}} & fwd_mem_wb);\n  assign alu_b = ({32{in.alu_b_sel[0]}} & in.alu_base_b)\n               | ({32{in.alu_b_sel[1]}} & fwd_ex_mem)\n               | ({32{in.alu_b_sel[2]}} & fwd_mem_wb);\n\n'''+s[b:]; p.write_text(s)\ntest=root/'test'; test.mkdir(exist_ok=True)\nfor name in ['conftest.py','_helpers.py','test_pipeline.py']: shutil.copy2(Path('cores/bench/test')/name,test/name)\nprint('Early forwarding and base operand probe prepared')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
