{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_predictor.py')\ns=p.read_text().replace('counters = [1] * 64','counters = [2] * 32').replace('counters, next_pc = [1] * 64, 0','counters, next_pc = [2] * 32, 0').replace('for index in range(64):','for index in range(32):').replace('address = index << 2','address = index << 3').replace('alias = address \"'^ 0x104'\"','alias = address \"'^ 0x108'\"')\ns=s.replace('from test_pipeline import BEQ, JAL, JALR, NOP, _b, _direct_offset, _legal_branch, _predictor_index','from test_pipeline import BEQ, JAL, JALR, NOP, _b, _direct_offset, _legal_branch\\\\n\\\\ndef _predictor_index(pc):\\\\n    return ((pc >> 3) \"'^ (pc >> 8)) & 31'\"')\ns=s.replace('dut.train_taken.value = 0','dut.train_taken.value = 0\\\\n    dut.train_bias.value = 0')\ns=s.replace('dut.train_taken.value = train[1] if train else 0','dut.train_taken.value = train[1] if train else 0\\\\n        dut.train_bias.value = train[2] if train and len(train) > 2 else 0')\ns=s.replace('(_legal_branch(insn) and counters[_predictor_index(pc)] >= 2)','(_legal_branch(insn) and ((insn >> 31) \"'^ (counters[_predictor_index(pc)] < 2)))'\"')\ns=s.replace('counters[index] + (1 if train[1] else -1)','counters[index] + (1 if train[1] == (train[2] if len(train) > 2 else 0) else -1)')\ns=s.replace('rng.getrandbits(32), rng.randrange(2))','rng.getrandbits(32), rng.randrange(2), rng.randrange(2))')\ns=s.replace('await edge(BEQ(0, 0, -12), (address, 1))','await edge(BEQ(0, 0, -12), (address, 1, 1))\\\\n        for bias in (0, 1):\\\\n            for agrees in (1, 1, 1, 0, 0, 0, 0, 1):\\\\n                await edge(BEQ(0, 0, -12 if bias else 12),\\\\n                           (address, bias if agrees else 1-bias, bias))')\np.write_text(s)\nq=Path('cores/bench/experiments/hypotheses/hyp-20261005-003-r14s2.yaml')\nimport yaml,json,jsonschema\nh=yaml.safe_load(q.read