{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY' > cores/bench/generated/predictor_trial/agree_profile.log 2>&1\nimport sys,json,time,struct\nfrom pathlib import Path\nsys.path.insert(0,str(Path('test/cosim').resolve()))\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('bench/programs/coremark.elf')\ntrace=bytearray(); n=0; active=False; start=time.time()\nwhile n < 10000000:\n d=cpu.step();n+=1\n if d['mem_wmask'] and d['mem_addr']==0x10000100: active=True\n if active and (d['instr'] & 127)==0x63:\n  trace.extend(struct.pack('<IBB',d['pc'],int(d['npc']\"'!=(d['\"'pc']+4)&0xffffffff),d['instr']>>31))\n if d['mem_wmask'] and d['mem_addr']==0x10000104: break\nPath('cores/bench/generated/predictor_trial/branches.bin').write_bytes(trace)\nprint('instructions',n,'branches',len(trace)//6,'seconds',time.time()-start,flush=True)\nrecords=list(struct.iter_unpack('<IBB',trace))\nfor bits in (4,5,6,7):\n for agree in (False,True):\n  counters=[2 if agree else 1]*(1<<bits);mask=(1<<bits)-1;miss=0\n  for pc,taken,back in records:\n   index=((pc>>2)\"'^(pc>>8))&mask\n   prediction=(counters[index]>=2) ''^ (not back) if agree else counters[index]>=2\n   miss+=prediction!=taken\n   actual=int(taken==back) if agree else taken\n   counters[index]=min(3,counters[index]+1) if actual else max(0,counters[index]-1)\n  print(bits,'\"'agree' if agree else 'bimodal','misses',miss,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
