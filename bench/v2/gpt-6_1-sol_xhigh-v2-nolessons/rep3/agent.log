{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypgen_r14')\ntrial=base/'encoded_operands'/'rtl';trial.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,trial/p.name)\np=trial/'core.sv';s=p.read_text().replace('logic [3:0] alu_a_sel, alu_b_sel;', 'logic [1:0] alu_a_sel, alu_b_sel;').replace('logic [3:0] next_alu_a_sel, next_alu_b_sel;','logic [1:0] next_alu_a_sel, next_alu_b_sel;')\nold='''    next_alu_a_sel[0] = \"'!incoming_is_auipc && next_fwd_rs1_sel == 2'\"'d0;\n    next_alu_a_sel[1] = \"'!incoming_is_auipc && next_fwd_rs1_sel == 2'\"'d1;\n    next_alu_a_sel[2] = \"'!incoming_is_auipc && next_fwd_rs1_sel == 2'\"'d2;\n    next_alu_a_sel[3] = incoming_is_auipc;\n    next_alu_b_sel[0] = \"'!incoming_alu_src && next_fwd_rs2_sel == 2'\"'d0;\n    next_alu_b_sel[1] = \"'!incoming_alu_src && next_fwd_rs2_sel == 2'\"'d1;\n    next_alu_b_sel[2] = \"'!incoming_alu_src && next_fwd_rs2_sel == 2'\"'d2;\n    next_alu_b_sel[3] = incoming_alu_src;'''\nnew='''    next_alu_a_sel = incoming_is_auipc ? 2'd3 : next_fwd_rs1_sel;\n    next_alu_b_sel = incoming_alu_src ? 2'd3 : next_fwd_rs2_sel;'''\nassert old in s;s=s.replace(old,new).replace(\\\"alu_a_sel <= 4'b0000;\\\",\\\"alu_a_sel <= 2'd0;\\\").replace(\\\"alu_b_sel <= 4'b0000;\\\",\\\"alu_b_sel <= 2'd0;\\\")\np.write_text(s)\np=trial/'ex_stage.sv';s=p.read_text().replace('input  logic [3:0]         alu_a_sel,','input  logic [1:0]         alu_a_sel,').replace('input  logic [3:0]         alu_b_sel,','input  logic [1:0]         alu_b_sel,')\nold='''    alu_a = ({32{alu_a_sel[0]}} & in.rs1_val)\n          | ({32{alu_a_sel[1]}} & fwd_ex_mem)\n          | ({32{alu_a_sel[2]}} & fwd_mem_wb)\n          | ({32{alu_a_sel[3]}} & in.pc);\n    alu_b = ({32{alu_b_sel[0]}} & in.rs2_val)\n          | ({32{alu_b_sel[1]}} & fwd_ex_mem)\n          | ({32{alu_b_sel[2]}} & fwd_mem_wb)\n          | ({32{alu_b_sel[3]}} & in.imm);'''\nnew='''    case (alu_a_sel)\n      2'd1: alu_a = fwd_ex_mem;\n      2'd2: alu_a = fwd_mem_wb;\n      2'd3: alu_a = in.pc;\n      default: alu_a = in.rs1_val;\n    endcase\n    case (alu_b_sel)\n      2'd1: alu_b = fwd_ex_mem;\n      2'd2: alu_b = fwd_mem_wb;\n      2'd3: alu_b = in.imm;\n      default: alu_b = in.rs2_val;\n    endcase'''\nassert old in s;p.write_text(s.replace(old,new))\nprint('Prepared encoded complete operand trial')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
