     high_base_q <= '0;\n      carry_q     <= '0;\n      result      <= '0;\n    end else begin\n      case (state_q)\n        IDLE: if (req_valid && req_ready) begin\n          a_q     <= a;\n          b_q     <= b;\n          op_q    <= req_op;\n          state_q <= PRODUCTS;\n        end\n        PRODUCTS: begin\n          ll_q <= a_q[15:0]  * b_q[15:0];\n          lh_q <= a_q[15:0]  * b_q[31:16];\n          hl_q <= a_q[31:16] \n…[5623 of 8695 chars elided by tools/bench/transcript.py; sha256:9f8028add1935e91]…\nready.value) and not int(dut.result_valid.value)\n    dut.req_valid.value = 0\n    for _ in range(8):\n        await _tick(dut)\n        assert not int(dut.result_valid.value)\n\n\n@cocotb.test()\nasync def reset_cancels_every_execution_stage_and_held_result(dut):\n    await _reset(dut)\n    for op in OPS:\n        for elapsed in range(LATENCY[op] + 2):\n            dut.a.value = 0x8000FFFF\n            dut.b.value = MASK\n            dut.req_op.value = op\n            dut.req_valid.value = 1\n            await _tick(dut)\n            dut.req_valid.value = 0\n            for _ in range(elapsed):\n                await _tick(dut)\n            await _reset(dut)\n            for _ in range(8):\n                await _tick(dut)\n                assert not int(dut.result_valid.value), \"cancelled result reappeared\"\n            await _execute(dut, op, 0x12345678, 0x87654321, hold=2)\n\n\ndef test_multiplier_runner():\n    run_cocotb(toplevel=\"multiplier\", sources=[\"core_pkg.sv\", \"multiplier.sv\"],\n               test_module=\"test_multiplier\")\n", "exit_code": 0, "status": "completed"}}
