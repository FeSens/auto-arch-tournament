{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nrt=Path('cores/bench/rtl');(Path('cores/bench/generated/hypgen_fullram.sv')).write_bytes((rt/'reg_file.sv').read_bytes())\n(rt/'reg_file.sv').write_text('''// Hybrid asynchronous RF: low flop bank, high mirrored LUT RAM bank.\nmodule reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output logic [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  wire [31:0] words [0:15];\n  assign words[0] = '0;\n  for (genvar r = 1; r < 16; r++) begin : gen_regs\n    localparam logic [4:0] ADDR = 5'(r);\n    logic [31:0] value_q;\n    always_ff @(posedge clock) begin\n      if (reset) value_q <= '0;\n      else if (w_en && w_addr == ADDR) value_q <= w_data;\n    end\n    assign words[r] = value_q;\n  end\n  wire [31:0] rs1_groups [0:1];\n  wire [31:0] rs2_groups [0:1];\n  for (genvar g = 0; g < 2; g++) begin : gen_read_groups\n    assign rs1_groups[g] =\n        ({32{rs1_addr[2:0] == 3'd0}} & words[g*8+0])\n      | ({32{rs1_addr[2:0] == 3'd1}} & words[g*8+1])\n      | ({32{rs1_addr[2:0] == 3'd2}} & words[g*8+2])\n      | ({32{rs1_addr[2:0] == 3'd3}} & words[g*8+3])\n      | ({32{rs1_addr[2:0] == 3'd4}} & words[g*8+4])\n      | ({32{rs1_addr[2:0] == 3'd5}} & words[g*8+5])\n      | ({32{rs1_addr[2:0] == 3'd6}} & words[g*8+6])\n      | ({32{rs1_addr[2:0] == 3'd7}} & words[g*8+7]);\n    assign rs2_groups[g] =\n        ({32{rs2_addr[2:0] == 3'd0}} & words[g*8+0])\n      | ({32{rs2_addr[2:0] == 3'd1}} & words[g*8+1])\n      | ({32{rs2_addr[2:0] == 3'd2}} & words[g*8+2])\n      | ({32{rs2_addr[2:0] == 3'd3}} & words[g*8+3])\n      | ({32{rs2_addr[2:0] == 3'd4}} & words[g*8+4])\n      | ({32{rs2_addr[2:0] == 3'd5}} & words[g*8+5])\n      | ({32{rs2_addr[2:0] == 3'd6}} & words[g*8+6])\n      | ({32{rs2_addr[2:0] == 3'd7}} & words[g*8+7]);\n  end\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] rs1_mem [0:15];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] rs2_mem [0:15];\n  logic [15:0] valid_q;\n  always_ff @(posedge clock) begin\n    if (\"'!reset && w_en && w_addr[4]) begin\n      rs1_mem[w_addr[3:0]] <= w_data;\n      rs2_mem[w_addr[3:0]] <= w_data;\n    end\n    if (reset) valid_q <= '\"'0;\n    else if (w_en && w_addr[4]) valid_q[w_addr[3:0]] <= 1'b1;\n  end\n  wire [31:0] rs1_ram = rs1_mem[rs1_addr[3:0]];\n  wire [31:0] rs2_ram = rs2_mem[rs2_addr[3:0]];\n  logic [31:0] rs1_read, rs2_read;\n  always_comb begin\n    rs1_read = rs1_addr[4] ? (valid_q[rs1_addr[3:0]] ? rs1_ram : 32'b0)\n                          : rs1_groups[rs1_addr[3]];\n    rs2_read = rs2_addr[4] ? (valid_q[rs2_addr[3:0]] ? rs2_ram : 32'b0)\n                          : rs2_groups[rs2_addr[3]];\n    if (rs1_addr == 0) rs1_data = 0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = rs1_read;\n    if (rs2_addr == 0) rs2_data = 0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = rs2_read;\n  end\nendmodule\n''')\nPY\nmake lint TARGET=bench\nmake timing TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
