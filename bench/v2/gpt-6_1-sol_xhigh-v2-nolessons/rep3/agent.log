n a kill\"\n        assert int(dut.rs1_addr_w.value) == (raw_instr >> 15) & 31\n        assert int(dut.rs2_addr_w.value) == (raw_instr >> 20) & 31\n        assert fetch & 1 == int(bool(iready and not redirect))\n        if not (ex_payload & 1):\n            assert not redirect and \n…[2187 of 5259 chars elided by tools/bench/transcript.py; sha256:e85ee14d9a5a2e9b]…\nt next_ex & 1 == (0 if kill_valid else fetch & 1)\n        if redirect:\n            assert int(dut.io_imemAddr.value) == redirect_target, \"redirect lost priority over PC hold\"\n        if waiting:\n            assert int(dut.io_imemAddr.value) == ia, \"PC advanced during divide ownership\"\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen and dready:\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n", "exit_code": 0, "status": "completed"}}
