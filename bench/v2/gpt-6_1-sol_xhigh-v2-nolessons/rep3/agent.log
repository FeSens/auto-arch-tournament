{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/rtl')\nroot=Path('cores/bench/generated/hypgen_trials')\nfor name in ('csel8','csel4','parallel'):\n dest=root/name/'rtl'\n dest.mkdir(parents=True,exist_ok=True)\n for p in base.glob('*.sv'): shutil.copy2(p,dest/p.name)\n src=(dest/'alu.sv').read_text()\n if name.startswith('csel'):\n  w=int(name[4:]); n=32//w\n  lines=[f'  logic [31:0] add_fast;',f'  logic [{n}:0] add_carry;', '  assign add_carry[0] = 1\\\\'b0;']\n  for i in range(n):\n   lo=i*w; hi=lo+w-1\n   if i==0:\n    lines.append(f\\\"  assign {{add_carry[{i+1}], add_fast[{hi}:{lo}]}} = {{1'b0,a[{hi}:{lo}]}} + {{1'b0,b[{hi}:{lo}]}};\\\")\n   else:\n    lines += [f'  logic [{w}:0] add_{i}_zero, add_{i}_one;',f\\\"  assign add_{i}_zero = {{1'b0,a[{hi}:{lo}]}} + {{1'b0,b[{hi}:{lo}]}};\\\",f\\\"  assign add_{i}_one = {{1'b0,a[{hi}:{lo}]}} + {{1'b0,b[{hi}:{lo}]}} + {w+1}'d1;\\\",f'  assign {{add_carry[{i+1}],add_fast[{hi}:{lo}]}} = add_carry[{i}] ? add_{i}_one : add_{i}_zero;']\n  lines += ['  /* verilator lint_off UNUSEDSIGNAL */', f'  wire unused_add_carry = add_carry[{n}];','  /* verilator lint_on UNUSEDSIGNAL */']\n  src=src.replace('  always_comb begin\\\\n', '\\\\n'.join(lines)+'\\\\n\\\\n  always_comb begin\\\\n',1).replace('ALU_ADD:    out = a + b;','ALU_ADD:    out = add_fast;')\n else:\n  start=src.index('    case (op)')\n  end=src.index('      // M-extension.', start)\n  replacement='''    case (op)\n      ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n      ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA, ALU_LUI:\n        out = ({32{op == ALU_ADD}} & (a + b))\n            | ({32{op == ALU_SUB}} & (a - b))\n            | ({32{op == ALU_AND}} & (a & b))\n            | ({32{op == ALU_OR }} & (a | b))\n            | ({32{op == ALU_XOR}} & (a \"'^ b))\n            | ({32{op == ALU_SLT}} & {31'\"'b0,\"'$signed(a) < $signed(b)})\n            | ({32{op == ALU_SLTU}} & {31'\"'b0,a < b})\n            | ({32{op == ALU_SLL}} & (a << shamt))\n            | ({32{op == ALU_SRL}} & (a >> shamt))\n            | ({32{op == ALU_SRA}} & \"'$unsigned($signed(a) >>> shamt))\n            | ({32{op == ALU_LUI}} & b);\n\n'\"'''\n  src=src[:start]+replacement+src[end:]\n (dest/'alu.sv').write_text(src)\nprint('Prepared local combinational ALU trials')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
