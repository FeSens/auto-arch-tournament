{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/predictor_research'); src=Path('cores/bench/rtl')\nfor name in ('mismatch_onehot','agree16','bimodal32hi','lookup_onehot'):\n out=root/name/'rtl'; out.mkdir(parents=True,exist_ok=True)\n for p in src.glob('*.sv'): shutil.copy2(p,out/p.name)\n if name=='mismatch_onehot':\n  p=out/'core_pkg.sv'; s=p.read_text(); s=s.replace('logic [2:0]  mismatch_op;', 'logic [5:0]  mismatch_grants;'); p.write_text(s)\n  p=out/'id_stage.sv'; s=p.read_text(); s=s.replace('        reg_q.mismatch_op <= dec_branch_op \"'^ {2'\"\\\\'b00, in.predicted_taken};', '''        reg_q.mismatch_grants[0] <= (dec_branch_op \"'^ {2'\"'b00, in.predicted_taken}) == BR_BEQ;\n        reg_q.mismatch_grants[1] <= (dec_branch_op \"'^ {2'\"'b00, in.predicted_taken}) == BR_BNE;\n        reg_q.mismatch_grants[2] <= (dec_branch_op \"'^ {2'\"'b00, in.predicted_taken}) == BR_BLT;\n        reg_q.mismatch_grants[3] <= (dec_branch_op \"'^ {2'\"'b00, in.predicted_taken}) == BR_BGE;\n        reg_q.mismatch_grants[4] <= (dec_branch_op \"'^ {2'\"'b00, in.predicted_taken}) == BR_BLTU;\n        reg_q.mismatch_grants[5] <= (dec_branch_op \"'^ {2'\"'b00, in.predicted_taken}) == BR_BGEU;'''); p.write_text(s)\n  p=out/'ex_stage.sv'; s=p.read_text(); start=s.index('    case (in.mismatch_op)'); end=s.index('    branch_taken =',start)\n  s=s[:start]+'''    branch_mismatch = (in.mismatch_grants[0] && rs1 == rs2)\n                    | (in.mismatch_grants[1] && rs1 \"'!= rs2)\n                    | (in.mismatch_grants[2] && $signed(rs1) < $signed(rs2))\n                    | (in.mismatch_grants[3] && $signed(rs1) >= $signed(rs2))\n                    | (in.mismatch_grants[4] && rs1 < rs2)\n                    | (in.mismatch_grants[5] && rs1 >= rs2);\n'\"'''+s[end:]; p.write_text(s)\n elif name=='agree16':\n  for p in (root/'agree32'/'rtl').glob('*.sv'): shutil.copy2(p,out/p.name)\n  p=out/'if_stage.sv'; s=p.read_text().replace('[4:0] lookup_index, train_index','[3:0] lookup_index, train_index').replace('[31:0] counter_msb','[15:0] counter_msb').replace('[3:0] lookup_groups','[1:0] lookup_groups').replace('pc[6:2] \"'^ pc[12:8]'\"','pc[5:2] \"'^ pc[13:10]'\"').replace('train_pc[6:2] \"'^ train_pc[12:8]'\"','train_pc[5:2] \"'^ train_pc[13:10]'\"').replace('e < 32','e < 16').replace('[4:0] INDEX = 5\\\\'(e)','[3:0] INDEX = 4\\\\'(e)').replace('g < 4','g < 2')\n  start=s.index('    case (lookup_index[4:3])'); end=s.index('    pre_branch =',start)\n  s=s[:start]+'''    direction = lookup_index[3] ? lookup_groups[1] : lookup_groups[0];\n'''+s[end:]; p.write_text(s)\n elif name=='bimodal32hi':\n  for p in (root/'hashed32'/'rtl').glob('*.sv'): shutil.copy2(p,out/p.name)\n  p=out/'if_stage.sv'; p.write_text(p.read_text().replace('pc[12:8]','pc[14:10]').replace('train_pc[12:8]','train_pc[14:10]'))\n elif name=='lookup_onehot':\n  p=out/'if_stage.sv'; s=p.read_text(); start=s.index('  for (genvar g = 0;'); end=s.index('    pre_branch =',start)\n  s=s[:start]+'''  wire [63:0] lookup_hits;\n  for (genvar e = 0; e < 64; e++) begin : gen_lookup_onehot\n    assign lookup_hits[e] = (lookup_index == 6'(e)) && counter_msb[e];\n  end\n\n  always_comb begin\n    direction = |lookup_hits;\n'''+s[end:]; s=s.replace('  wire [7:0] lookup_groups;\\\\n',''); p.write_text(s)\nprint('Prepared recovery and lookup trials.')\nPY\npython3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nimport json\nwt=Path.cwd(); root=wt/'cores/bench/generated/predictor_research'\ndef trial(name):\n r=build(wt,root/name/'rtl','fpga/core_bench_si.sv',0,root/name/'gowin_p0')\n (root/name/'timing.json').write_text(json.dumps(r,indent=2))\n print(name,json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=4) as pool:\n list(pool.map(trial,('mismatch_onehot','agree16','bimodal32hi','lookup_onehot')))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
