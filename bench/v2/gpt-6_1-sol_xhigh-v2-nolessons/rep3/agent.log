{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json\nimport random\nimport yaml\nimport jsonschema\n\nmask = (1 << 32) - 1\n\ndef radix4(a, b):\n    multiples = (0, b, b << 1, 3 * b)\n    rem = q = 0\n    for step in range(16):\n        width = 2 * (step + 1)\n        trial = (rem << 2) | ((a >> (30 - 2 * step)) & 3)\n        digit = 0\n        selected = trial\n        for k in (3, 2, 1):\n            d = multiples[k]\n            difference = (trial - (d & ((1 << width) - 1))) & ((1 << (width + 1)) - 1)\n            if not (d >> width) and not (difference >> width):\n                digit = k\n                selected = difference & ((1 << width) - 1)\n                break\n        q = (q << 2) | digit\n        rem = selected\n    return q, rem\n\ndef signed(v):\n    return v if v < (1 << 31) else v - (1 << 32)\n\nrng = random.Random(20261004)\nedge = [0, 1, 2, 3, 4, 5, 7, 15, 16, 17, 0x55555555, 0x55555556, 0x7fffffff, 0x80000000, 0xfffffffe, mask]\npairs = [(a, b) for a in edge for b in edge]\npairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000))\nfor a, b in pairs:\n    q, r = radix4(a, b)\n    assert (q, r) == ((mask, a) if b == 0 else divmod(a, b)), (a, b, q, r)\n    sa, sb = signed(a), signed(b)\n    qm, rm = radix4(abs(sa), abs(sb))\n    actual = (mask, a) if b == 0 else (((-qm if (sa < 0) \"'!= (sb < 0) else qm) & mask), ((-rm if sa < 0 else rm) & mask))\n    if sb == 0:\n        expected = (mask, a)\n    else:\n        eq = abs(sa) // abs(sb)\n        eq = -eq if (sa < 0) != (sb < 0) else eq\n        expected = (eq & mask, (sa - eq * sb) & mask)\n    assert actual == expected, (a, b, actual, expected)\n\np = Path('\"'cores/bench/experiments/hypotheses/hyp-20261004-001-r1s0.yaml')\ndata = yaml.safe_load(p.read_text())\njsonschema.validate(data, json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint(f'Algorithm model passed {len(pairs)} operand pairs for unsigned and signed quotient/remainder.')\nprint(f'Schema valid: {p}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
