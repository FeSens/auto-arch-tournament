{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, pathlib, re\nfrom tools.eval.gowin import critical_paths\nfrom tools.eval.fpga import validate_coremark_uart\nimport os\nroot = pathlib.Path('.')\nmarker = json.loads((pathlib.Path(os.environ['TMPDIR']) / 'bench-coremark.log').read_text().splitlines()[-1])\ncycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nfitness = 74.191e6 * 10 / cycles\nprint(json.dumps({'cycles': cycles, 'crc_validation': validate_coremark_uart(marker['uart'], 10), 'fitness': fitness, 'improvement_pct': 100*(fitness/140.75-1)}, indent=2))\nfor option in (0,1,2):\n    report = root / f'cores/bench/generated/timing/gowin_p{option}/impl/pnr/core_bench.tr'\n    text = report.read_text()\n    paths = critical_paths(text, 100)\n    print('option', option, 'setup paths', len(paths), 'memory endpoints', [p for p in paths if 'dmem' in p['to']])\n    hold = text.split('3.3.2 Hold Analysis Report')[-1]\n    for block in re.split(r'\"'^'\"\\\\s*Path\\\\d+\\\\s*\"'$'\"', hold, flags=re.M)[1:]:\n        if re.search(r'\"'^To'\"\\\\s*:\\\\s*dmem', block, re.M):\n            arrival = block.split('Data Arrival Path:')[-1].split('Data Required Path:')[0]\n            nodes = [line.split()[-1] for line in arrival.splitlines() if ' tINS ' in f' {line} ' or ' tC2Q ' in f' {line} ' or ' tNET ' in f' {line} ']\n            print('memory address timing path:', ' -> '.join(nodes))\n            assert 'reg_q.effective_addr' in arrival and 'u_alu/' not in arrival\n            break\nprint('pipeline tests', len(re.findall(r'@cocotb.test\\\\(\\\\)', (root / 'cores/bench/test/test_pipeline.py').read_text())))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
