{"type": "item.started", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nrt=Path('cores/bench/rtl')\nbk=Path('cores/bench/generated/hypgen_backup');bk.mkdir(parents=True,exist_ok=True)\nfor f in ['core.sv','id_stage.sv','ex_stage.sv','alu.sv']:\n shutil.copy2(rt/f,bk/f)\np=rt/'core.sv';s=p.read_text()\ns=s.replace('logic       incoming_alu_src, incoming_is_auipc;','logic       incoming_alu_src, incoming_is_auipc;\\\\n  logic [4:0] incoming_alu_op;\\\\n  logic incoming_is_jump;\\\\n  logic [3:0] add_lane_grants, sub_lane_grants;\\\\n  logic [2:0] addr_lane_grants;')\ns=s.replace('.incoming_is_auipc (incoming_is_auipc),','.incoming_is_auipc (incoming_is_auipc),\\\\n    .incoming_alu_op (incoming_alu_op),\\\\n    .incoming_is_jump (incoming_is_jump),')\ns=s.replace('.alu_b_sel       (alu_b_sel),','.alu_b_sel       (alu_b_sel),\\\\n    .add_lane_grants (add_lane_grants),\\\\n    .sub_lane_grants (sub_lane_grants),\\\\n    .addr_lane_grants (addr_lane_grants),')\ns=s.replace(\\\"alu_b_sel <= 4'b0000;\\\",\\\"alu_b_sel <= 4'b0000;\\\\n      add_lane_grants <= '0;\\\\n      sub_lane_grants <= '0;\\\\n      addr_lane_grants <= '0;\\\")\ns=s.replace('alu_b_sel <= next_alu_b_sel;','alu_b_sel <= next_alu_b_sel;\\\\n      add_lane_grants <= next_alu_a_sel & {4{\"'!incoming_is_jump && incoming_alu_op == ALU_ADD}};'\"\\\\n      sub_lane_grants <= next_alu_a_sel & {4{\"'!incoming_is_jump && incoming_alu_op == ALU_SUB}};'\"\\\\n      addr_lane_grants <= {next_fwd_rs1_sel == 2\\\\'d2, next_fwd_rs1_sel == 2\\\\'d1, next_fwd_rs1_sel == 2\\\\'d0};')\np.write_text(s)\np=rt/'id_stage.sv';s=p.read_text()\ns=s.replace('output logic             incoming_is_auipc,','output logic             incoming_is_auipc,\\\\n  output logic [4:0]       incoming_alu_op,\\\\n  output logic             incoming_is_jump,')\ns=s.replace('id_ex_t reg_q;','id_ex_t reg_q;\\\\n  assign incoming_alu_op = ctrl_decoded.alu_op;\\\\n  assign incoming_is_jump = ctrl_decoded.is_jump;')\np.write_text(s)\np=rt/'alu.sv';s=p.read_text()\ns=s.replace(\\\"parameter bit PREDECODED_RESULT = 1'b0\\\",\\\"parameter bit PREDECODED_RESULT = 1'b0,\\\\n  parameter bit EXTERNAL_ARITHMETIC = 1'b0\\\")\ns=s.replace('input  logic        m_complete,','input  logic        m_complete,\\\\n  input  logic [31:0] external_arithmetic,')\ns=s.replace('out = ((((a + b) & {32{result_grants[0]}})\\\\n         | ((a - b) & {32{result_grants[1]}}))','out = ((EXTERNAL_ARITHMETIC ? external_arithmetic\\\\n          : (((a + b) & {32{result_grants[0]}})\\\\n         | ((a - b) & {32{result_grants[1]}})))')\np.write_text(s)\np=rt/'ex_stage.sv';s=p.read_text()\ns=s.replace('input  logic [3:0]         alu_b_sel,','input  logic [3:0]         alu_b_sel,\\\\n  input  logic [3:0]         add_lane_grants, sub_lane_grants,\\\\n  input  logic [2:0]         addr_lane_grants,')\ns=s.replace('logic [31:0] alu_result;','logic [31:0] alu_result;\\\\n  wire [31:0] add_sources [0:3];\\\\n  wire [31:0] arith_contribution [0:3];\\\\n  wire [31:0] addr_candidates [0:2];\\\\n  logic [31:0] external_arithmetic, source_address;\\\\n  assign add_sources[0] = in.rs1_val;\\\\n  assign add_sources[1] = fwd_ex_mem;\\\\n  assign add_sources[2] = fwd_mem_wb;\\\\n  assign add_sources[3] = in.pc;\\\\n  for (genvar k = 0; k < 4; k++) begin : gen_arith_lanes\\\\n    assign arith_contribution[k] = ((add_sources[k] + alu_b) & {32{add_lane_grants[k]}})\\\\n                               | ((add_sources[k] - alu_b) & {32{sub_lane_grants[k]}});\\\\n  end\\\\n  for (genvar k = 0; k < 3; k++) begin : gen_address_lanes\\\\n    assign addr_candidates[k] = add_sources[k] + in.imm;\\\\n  end\\\\n  assign external_arithmetic = arith_contribution[0] | arith_contribution[1]\\\\n                             | arith_contribution[2] | arith_contribution[3];\\\\n  assign source_address = (addr_candidates[0] & {32{addr_lane_grants[0]}})\\\\n                        | (addr_candidates[1] & {32{addr_lane_grants[1]}})\\\\n                        | (addr_candidates[2] & {32{addr_lane_grants[2]}});')\ns=s.replace(\\\"alu #(.SEPARATE_M(1'b1), .PREDECODED_RESULT(1'b1)) u_alu\\\", \\\"alu #(.SEPARATE_M(1'b1), .PREDECODED_RESULT(1'b1), .EXTERNAL_ARITHMETIC(1'b1)) u_alu\\\")\ns=s.replace('.m_complete      (divide_active_q && div_result_valid),','.m_complete      (divide_active_q && div_result_valid),\\\\n    .external_arithmetic (external_arithmetic),')\ns=s.replace('jalr_sum    = rs1 + in.imm;','jalr_sum    = source_address;')\ns=s.replace('effective_addr_q <= rs1 + in.imm;','effective_addr_q <= source_address;')\np.write_text(s)\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
