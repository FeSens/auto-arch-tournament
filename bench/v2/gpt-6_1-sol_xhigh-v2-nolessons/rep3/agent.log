{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/{if_stage,id_stage,hazard_unit,ex_stage}.sv; rg -n 'stall_id|flush_id|flush_if|hazard_unit|id_stage|if_stage' cores/bench test tools/eval/gowin.py\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n\n  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = (flush || redirect) ? 32\n…[38517 of 41589 chars elided by tools/bench/transcript.py; sha256:dc9c59d2f064e687]…\nit.sv:70:  assign flush_id = (redirect || (load_use_hazard && !ex_divide_wait)) && !dmem_stall;\ncores/bench/rtl/core_pkg.sv:74:  // IF -> ID combinational bundle (no register; PC reg sits in if_stage).\ncores/bench/rtl/core.sv:9://   +- stall <- hazard_unit (load-use)\ncores/bench/rtl/core.sv:80:  logic       stall_if, stall_id, flush_if, flush_id;\ncores/bench/rtl/core.sv:99:  if_stage u_if (\ncores/bench/rtl/core.sv:103:    .flush           (flush_if),\ncores/bench/rtl/core.sv:112:  id_stage u_id (\ncores/bench/rtl/core.sv:115:    .stall    (stall_id),\ncores/bench/rtl/core.sv:116:    .flush    (flush_id),\ncores/bench/rtl/core.sv:176:  hazard_unit u_hazard (\ncores/bench/rtl/core.sv:187:    .stall_id       (stall_id),\ncores/bench/rtl/core.sv:188:    .flush_if       (flush_if),\ncores/bench/rtl/core.sv:189:    .flush_id       (flush_id),\ncores/bench/test/test_pipeline.py:471:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:473:            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
