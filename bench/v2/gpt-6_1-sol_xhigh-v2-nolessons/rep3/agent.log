{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/f88745d5/944d69ae/r9s0-carry8')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,rtl/f.name)\nf=rtl/'alu.sv'\ns=f.read_text()\nhelper='''\n  // Four speculative eight-bit adders with direct inter-group lookahead.\n  function automatic [31:0] carry_select8(\n    input logic [31:0] x,\n    input logic [31:0] y,\n    input logic cin\n  );\n    logic [8:0] s0 [0:3];\n    logic [8:0] s1 [0:3];\n    logic [3:0] g, p, c;\n    begin\n      for (integer j=0; j<4; j=j+1) begin\n        s0[j] = {1'b0,x[j*8 +: 8]} + {1'b0,y[j*8 +: 8]};\n        s1[j] = {1'b0,x[j*8 +: 8]} + {1'b0,y[j*8 +: 8]} + 9'd1;\n        g[j] = s0[j][8];\n        p[j] = &(x[j*8 +: 8] \"'^ y[j*8 +: 8]);\n      end\n      c[0] = cin;\n      c[1] = g[0] | (p[0] & cin);\n      c[2] = g[1] | (p[1]&g[0]) | (p[1]&p[0]&cin);\n      c[3] = g[2] | (p[2]&g[1]) | (p[2]&p[1]&g[0]) | (p[2]&p[1]&p[0]&cin);\n      for (integer j=0; j<4; j=j+1) begin\n        carry_select8[j*8 +: 8] = c[j] ? s1[j][7:0] : s0[j][7:0];\n      end\n    end\n  endfunction\n\n'\"'''\ns=s.replace('  always_comb begin\\\\n    shamt',helper+'  always_comb begin\\\\n    shamt')\ns=s.replace('ALU_ADD:    out = a + b;',\\\"ALU_ADD:    out = carry_select8(a, b, 1'b0);\\\")\ns=s.replace('ALU_SUB:    out = a - b;',\\\"ALU_SUB:    out = carry_select8(a, ~b, 1'b1);\\\")\nf.write_text(s)\nprint(rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
