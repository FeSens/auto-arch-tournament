pc[7:2] ^ train_pc[13:8];\n\n  // Each entry owns its constant-index write enable and saturating state.\n  // Lookup observes the old state on a simultaneous training edge.\n  for (genvar e = 0; e < 64; e++) begin : gen_predictor\n    localparam logic [5:0] INDEX = 6'(e);\n    logic [1:0] counter_q;\n    always_ff \n…[6359 of 9431 chars elided by tools/bench/transcript.py; sha256:d2d8b44a4ffa24f5]…\naddress, 1))\n        for funct3 in range(8):\n            for offset in (-4096, -2, 2, 4, 4094):\n                await edge(_b(offset, 0, 0, funct3, 0x63))\n        for offset in (-1048576, -2, 2, 4, 1048574):\n            await edge(JAL(1, offset))\n        await edge(JALR(1, 0, 4))\n        await edge(NOP())\n        await edge(JAL(1, 4), stall=0)\n\n    rng = random.Random(0xD1EC7)\n    for _ in range(500):\n        insn = rng.choice((BEQ(0, 0, rng.choice((-128, 2, 124))), JAL(1, 4096), NOP(), JALR(1, 0, 4)))\n        train = (rng.getrandbits(32), rng.randrange(2)) if rng.random() < 0.8 else None\n        await edge(insn, train, stall=rng.randrange(2), flush=rng.randrange(2),\n                   redirect=(rng.getrandbits(30) << 2) if rng.random() < 0.1 else None)\n    await edge(BEQ(0, 0, 4), train=(pc, 1), redirect=0x100, reset=1)\n    await edge(BEQ(0, 0, 4), stall=0)\n\n\ndef test_predictor_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n                test_module=\"test_predictor\")\n", "exit_code": 0, "status": "completed"}}
