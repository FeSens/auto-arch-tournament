{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/carry_select_trial')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n(rtl/'carry_select32.sv').write_text('''module carry_select32 #(\n  parameter bit SUBTRACT = 1'b0\n) (\n  input logic [31:0] a,\n  input logic [31:0] b,\n  output logic [31:0] sum\n);\n  wire [31:0] b_eff = SUBTRACT ? ~b : b;\n  wire [8:0] low_sum = {1'b0,a[7:0]} + {1'b0,b_eff[7:0]} + 9'(SUBTRACT);\n  wire [3:0] carry;\n  assign sum[7:0] = low_sum[7:0];\n  assign carry[0] = low_sum[8];\n  for (genvar k = 1; k < 4; k++) begin : gen_blocks\n    wire [8:0] sum0 = {1'b0,a[k*8 +: 8]} + {1'b0,b_eff[k*8 +: 8]};\n    wire [8:0] sum1 = {1'b0,a[k*8 +: 8]} + {1'b0,b_eff[k*8 +: 8]} + 9'd1;\n    assign sum[k*8 +: 8] = carry[k-1] ? sum1[7:0] : sum0[7:0];\n    assign carry[k] = carry[k-1] ? sum1[8] : sum0[8];\n  end\nendmodule\n''')\np=rtl/'alu.sv'\ns=p.read_text()\ns=s.replace('  logic        [4:0]  shamt;', '''  logic [31:0] add_result, sub_result;\n  carry_select32 u_add (.a(a), .b(b), .sum(add_result));\n  carry_select32 #(.SUBTRACT(1'b1)) u_sub (.a(a), .b(b), .sum(sub_result));\n  logic        [4:0]  shamt;''')\ns=s.replace('((a + b) & {32{result_grants[0]}})', '(add_result & {32{result_grants[0]}})')\ns=s.replace('((a - b) & {32{result_grants[1]}})', '(sub_result & {32{result_grants[1]}})')\ns=s.replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = add_result;')\ns=s.replace('ALU_SUB:    out = a - b;', 'ALU_SUB:    out = sub_result;')\np.write_text(s)\np=rtl/'ex_stage.sv'\ns=p.read_text()\ns=s.replace('  always_comb begin\\\\n    case (in.mismatch_op)', \\\"  carry_select32 u_address (.a(rs1), .b(in.imm), .sum(jalr_sum));\\\\n\\\\n  always_comb begin\\\\n    case (in.mismatch_op)\\\")\ns=s.replace('    jalr_sum    = rs1 + in.imm;\\\\n','')\ns=s.replace('effective_addr_q <= rs1 + in.imm;', 'effective_addr_q <= jalr_sum;')\np.write_text(s)\nprint('Trial RTL:',rtl)\nPY\nverilator --lint-only -Wall -Wno-fatal -Wno-MULTITOP -sv +incdir+cores/bench/generated/carry_select_trial/rtl cores/bench/generated/carry_select_trial/rtl/core_pkg.sv cores/bench/generated/carry_select_trial/rtl/*.sv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
