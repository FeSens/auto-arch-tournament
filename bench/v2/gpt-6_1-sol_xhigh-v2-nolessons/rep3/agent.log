{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/rtl'); root=Path('cores/bench/generated/hypgen_trials')\nfor name in ('rf_flat','rf_banked','rf_validram'):\n dest=root/name/'rtl'; dest.mkdir(parents=True,exist_ok=True)\n for p in base.glob('*.sv'): shutil.copy2(p,dest/p.name)\n src=(dest/'reg_file.sv').read_text()\n start=src.index('  logic [31:0] regs [0:31];')\n if name=='rf_validram':\n  src=src[:start]+'''  logic [31:0] regs [0:31];\n  logic [31:1] written_q;\n  always_ff @(posedge clock) begin\n    if (reset) written_q <= '0;\n    else if (w_en && w_addr \"'!= 0) written_q[w_addr] <= 1'\"'b1;\n    if (\"'!reset && w_en && w_addr != 0) regs[w_addr] <= w_data;\n  end\n  always_comb begin\n    if (rs1_addr == 0) rs1_data = '\"'0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = written_q[rs1_addr] ? regs[rs1_addr] : '0;\n    if (rs2_addr == 0) rs2_data = '0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = written_q[rs2_addr] ? regs[rs2_addr] : '0;\n  end\nendmodule\n'''\n else:\n  flat='''  wire [31:0] value [0:31];\n  wire [31:0] read1_select, read2_select;\n  assign value[0] = '0;\n  for (genvar r=0; r<32; r=r+1) begin: word_decode\n    assign read1_select[r] = rs1_addr == 5'(r);\n    assign read2_select[r] = rs2_addr == 5'(r);\n    if (r \"'!= 0) begin: stored\n      logic [31:0] value_q;\n      always_ff @(posedge clock) begin\n        if (reset) value_q <= '\"'0;\n        else if (w_en && w_addr == 5'(r)) value_q <= w_data;\n      end\n      assign value[r] = value_q;\n    end\n  end\n  logic [31:0] rf1, rf2;\n'''\n  if name=='rf_flat':\n   flat+='''  always_comb begin\n    rf1 = '0; rf2 = '0;\n    for (integer r=1; r<32; r=r+1) begin\n      rf1 = rf1 | ({32{read1_select[r]}} & value[r]);\n      rf2 = rf2 | ({32{read2_select[r]}} & value[r]);\n    end\n  end\n'''\n  else:\n   flat+='''  wire [31:0] bank1 [0:3];\n  wire [31:0] bank2 [0:3];\n  for (genvar g=0; g<4; g=g+1) begin: read_bank\n    logic [31:0] b1, b2;\n    always_comb begin\n      b1 = '0; b2 = '0;\n      for (integer k=0;k<8;k=k+1) begin\n        b1 = b1 | ({32{rs1_addr[2:0] == 3'(k)}} & value[g*8+k]);\n        b2 = b2 | ({32{rs2_addr[2:0] == 3'(k)}} & value[g*8+k]);\n      end\n    end\n    assign bank1[g] = b1;\n    assign bank2[g] = b2;\n  end\n  assign rf1 = bank1[rs1_addr[4:3]];\n  assign rf2 = bank2[rs2_addr[4:3]];\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire unused_select = \"'^{read1_select,read2_select};\n  /* verilator lint_on UNUSEDSIGNAL */\n'\"'''\n  src=src[:start]+flat+'''  always_comb begin\n    if (rs1_addr == 0) rs1_data = '0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = rf1;\n    if (rs2_addr == 0) rs2_data = '0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = rf2;\n  end\nendmodule\n'''\n (dest/'reg_file.sv').write_text(src)\nprint('Prepared register-file implementation trials')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
