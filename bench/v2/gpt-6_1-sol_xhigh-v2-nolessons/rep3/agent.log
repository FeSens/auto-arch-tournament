{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom functools import cache\nimport re,json\ns=Path('cores/bench/generated/mapping_keep/impl/pnr/core_bench.vo').read_text()\ncanon=lambda n:re.sub(r'\\\\s+','',n).replace('\\\\\\\\','')\ncells=[];drivers={}\nfor m in re.finditer(r'\"'^([A-Za-z0-9_]+)'\"\\\\s+(\\\\\\\\\\\\S+|\\\\w+)\\\\s+\\\\(\\\\s*\\\\n(.*?)\\\\n\\\\);',s,re.M|re.S):\n typ,name,body=m.groups();p={port:canon(net) for port,net in re.findall(r'\\\\.(\\\\w+)\\\\((.*?)\\\\)',body)};name=canon(name)\n cells.append((typ,name,p))\n if typ.startswith(('LUT','MUX')) or typ=='ALU':\n  for output in ('F','O','SUM','COUT'):\n   if output in p:drivers[p[output]]=[v for port,v in p.items() if port.startswith('I') or port in ('S','SEL','CIN')]\n@cache\ndef leaves(n):\n if re.fullmatch(r'cpu/u_ex/alu_[ab]\\\\[\\\\d+\\\\]',n) or re.fullmatch(r'.*\\\\.(?:fallback_left|exmem_shifted)\\\\[\\\\d+\\\\]',n) or n not in drivers:return frozenset((n,))\n return frozenset().union(*(leaves(v) for v in drivers[n]))\nresult={}\nfor grant in (8,9):\n injection=[p for _,name,p in cells if name.startswith('cpu/u_ex/u_alu/') and f'cpu/id_ex_w.result_grants[{grant}]' in p.values()]\n nets=frozenset().union(*(leaves(v) for p in injection for port,v in p.items() if port.startswith('I')))\n raw=[n for n in nets if n.startswith(('cpu/ex_mem_w.alu_result[','cpu/id_ex_w.rs1_val[','cpu/wb_w_data['))]\n assert not raw,(grant,raw)\n result[str(grant)]={'grant_injection_cells':len(injection),'raw_forwarding_sources_outside_selected_a':raw,'selected_a_present':any(n.startswith('cpu/u_ex/alu_a[') for n in nets)}\np=Path('cores/bench/generated/local_checks/mapping_final.json');summary=json.loads(p.read_text());summary['right_shift_mapping']=result;p.write_text(json.dumps(summary,indent=2)+'\\\\n')\nprint(json.dumps(result))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
