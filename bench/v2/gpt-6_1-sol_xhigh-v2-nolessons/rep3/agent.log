{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_predictor.py'", "aggregated_output": "\"\"\"Independent direction-counter, raw predecode and pre-edge lookup checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b, _direct_offset, _legal_branch, _predictor_index\n\n\n@cocotb.test()\nasync def counters_predecode_targets_and_reset(dut):\n    counters = [1] * 64\n    pc = 0\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.imem_data.value = NOP()\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n\n    async def edge(insn=NOP(), train=None, stall=1, flush=0, redirect=None, reset=0):\n        nonlocal pc, counters\n        dut.clock.value = 0\n        dut.reset.value = reset\n        dut.imem_data.value = insn\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut.redirect.value = redirect is not None\n        dut.redirect_target.value = redirect or 0\n        dut.train_valid.value = train is not None\n        dut.train_pc.value = train[0] if train else 0\n        dut.train_taken.value = train[1] if train else 0\n        await Timer(2, unit=\"ns\")\n        target = (pc + _direct_offset(insn)) & 0xFFFFFFFF\n        prediction = target & 3 == 0 and (insn & 127 == 0x6F or\n                                         (_legal_branch(insn) and counters[_predictor_index(pc)] >= 2))\n        fetch = int(dut.out.value)\n        assert (fetch >> 1) & 0xFFFFFFFF == insn\n        assert (fetch >> 34) & 1 == prediction, \"lookup bypassed pre-edge counter state\"\n        assert (fetch >> 33) & 1 == (target & 3 == 0)\n        assert (fetch >> 35) & 0xFFFFFFFF == ((pc + 4) & 0xFFFFFFFF if prediction else target)\n        assert fetch & 1 == int(not flush and redirect is None)\n        if reset:\n            counters, next_pc = [1] * 64, 0\n        else:\n            next_pc = redirect if redirect is not None else pc if stall else target if prediction else (pc + 4) & 0xFFFFFFFF\n         \n…[1388 of 4460 chars elided by tools/bench/transcript.py; sha256:8a66863c93086f0f]…\naddress, 1))\n        for funct3 in range(8):\n            for offset in (-4096, -2, 2, 4, 4094):\n                await edge(_b(offset, 0, 0, funct3, 0x63))\n        for offset in (-1048576, -2, 2, 4, 1048574):\n            await edge(JAL(1, offset))\n        await edge(JALR(1, 0, 4))\n        await edge(NOP())\n        await edge(JAL(1, 4), stall=0)\n\n    rng = random.Random(0xD1EC7)\n    for _ in range(500):\n        insn = rng.choice((BEQ(0, 0, rng.choice((-128, 2, 124))), JAL(1, 4096), NOP(), JALR(1, 0, 4)))\n        train = (rng.getrandbits(32), rng.randrange(2)) if rng.random() < 0.8 else None\n        await edge(insn, train, stall=rng.randrange(2), flush=rng.randrange(2),\n                   redirect=(rng.getrandbits(30) << 2) if rng.random() < 0.1 else None)\n    await edge(BEQ(0, 0, 4), train=(pc, 1), redirect=0x100, reset=1)\n    await edge(BEQ(0, 0, 4), stall=0)\n\n\ndef test_predictor_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n                test_module=\"test_predictor\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat Makefile; cat cores/bench/core.yaml; cat formal/run_all.sh'", "aggregated_output": ".PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\n.DEFAULT_GOAL := help\n\n# Resolve OSS CAD Suite path so commands work even when the user hasn't\n# sourced .toolchain/oss-cad-suite/environment in this shell.\nTOOLCHAIN_DIR := $(CURDIR)/.toolchain\nOSS_BIN       := $(TOOLCHAIN_DIR)/oss-cad-suite/bin\nLOCAL_BIN     := $(TOOLCHAIN_DIR)/bin\nexport PATH := $(OSS_BIN):$(LOCAL_BIN):$(PATH)\n\n# Orchestrator knobs (pass-through to tools.orchestrator):\n#   N        — number of rounds for `make loop` (default 10).\n#   K        — tournament size, slots per round (default 1 = sequential).\n#   AGENT    — codex (default) or claude. Honors a pre-existing\n#              AGENT_PROVIDER env var if AGENT isn't set on the make\n#              command line.\n#   BASE     — when forking a new TARGET, copy from cores/<BASE>/.\n#              Default: baseline (orchestrator-side default).\n#   COREMARK — target CoreMark iterations/sec (e.g. '370').\n#   LUT      — target LUT count (e.g. '3000').\n#   WORKTREE — default ON. `make loop` first creates a dedicated git worktree\n#              at .worktrees/<TARGET>/ on branch core-<TARGET> and re-execs\n#              itself there. Lets two `make loop` invocations for different\n#              TARGETs run in parallel without git index/merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: `make loop TARGET=v1 WORKTREE=`.\nN        ?= 10\nK        ?= 1\nAGENT    ?= $(or $(AGENT_PROVIDER),codex)\nBASE     ?=\nCOREMARK ?=\nLUT      ?=\nWORKTREE ?= 1\n\n# Compose optional CLI flags for the orchestrator. Empty vars produce\n# empty strings so the orchestrator falls back to its defaults.\nORCH_FLAGS  = --iterations $(N) --tournament-size $(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>\n…[15720 of 18792 chars elided by tools/bench/transcript.py; sha256:b55ba5f790df2737]…\nheses make the assumption satisfiable, so this\n        # branch never matches and the regular DONE (PASS branch covers it.\n        PASS=$((PASS+1))\n    else\n        FAIL=$((FAIL+1)); FAILED+=(\"$name\")\n    fi\ndone\nTOTAL=$((PASS+FAIL))\nif [ $TOTAL -eq 0 ]; then\n    FAIL=1\n    FAILED+=(\"no_checks_generated\")\nfi\n\necho \"\"\necho \"Formal: $PASS passed, $FAIL failed\"\nif [ $FAIL -gt 0 ]; then\n    echo \"Failed: ${FAILED[*]}\"\n    # Surface the FIRST failing check's logfile tail. tools/eval/formal.py\n    # captures this script's stdout/stderr into formal['detail'] and the\n    # orchestrator now records that in experiments/log.jsonl, so what we\n    # print here is what shows up as the diagnostic for the failed run.\n    first=\"${FAILED[0]}\"\n    if [ -f \"$first/logfile.txt\" ]; then\n        echo \"\"\n        echo \"--- $first/logfile.txt (last 30 lines) ---\"\n        tail -30 \"$first/logfile.txt\"\n    fi\n    echo \"\"\n    echo \"Full run log: $LOG\"\n    echo \"Per-check logs in: $CORE_DIR/checks/<check>/logfile.txt\"\nfi\n[ $FAIL -eq 0 ]\n", "exit_code": 0, "status": "completed"}}
