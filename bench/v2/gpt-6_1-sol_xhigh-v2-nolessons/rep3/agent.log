d/reg_q.rs1_val_9_s0\", \"slack_ns\": -5.052, \"arrival_ns\": 15.346, \"logic_cells\": 7, \"modules\": [\"clock_ibuf\", \"cpu/u_rf\"]}, {\"from\": \"cpu/u_mem/reg_q.wb_result_25_s0\", \"to\": \"cpu/u_ex/arithmetic_result_q_14_s0\", \"slack_ns\": -5.049, \"arrival_ns\": 15.344, \"logic_cells\": 9, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\"]}, {\"from\": \"cpu/u_if/pc_9_s1\", \"to\": \"cpu/u_id/reg_q.imm_17_s0\", \"slack_ns\": -5.047, \"arrival_ns\": 15.341, \"logic_cells\": 12, \"modules\": [\"clock_ibuf\"\n…[1361 of 4433 chars elided by tools/bench/transcript.py; sha256:13342f2ed51a6e94]…\n \"logic\": 4502, \"regs\": 1905, \"lutram\": 0, \"bsram\": 4, \"dsp\": 2, \"critical_paths\": [{\"from\": \"cpu/u_id/reg_q.pc_2_s0\", \"to\": \"cpu/u_ex/arithmetic_result_q_31_s0\", \"slack_ns\": -4.275, \"arrival_ns\": 14.57, \"logic_cells\": 38, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\"]}, {\"from\": \"lfsr_20_s0\", \"to\": \"cpu/u_id/reg_q.rs2_val_22_s0\", \"slack_ns\": -4.275, \"arrival_ns\": 14.57, \"logic_cells\": 7, \"modules\": [\"clock_ibuf\", \"cpu/u_rf\"]}, {\"from\": \"cpu/alu_a_sel_2_s0\", \"to\": \"cpu/u_ex/arithmetic_result_q_22_s0\", \"slack_ns\": -4.27, \"arrival_ns\": 14.564, \"logic_cells\": 9, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\"]}, {\"from\": \"cpu/alu_a_sel_1_s0\", \"to\": \"cpu/u_ex/arithmetic_result_q_19_s0\", \"slack_ns\": -4.27, \"arrival_ns\": 14.564, \"logic_cells\": 9, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\"]}, {\"from\": \"cpu/u_id/reg_q.pc_2_s0\", \"to\": \"cpu/u_ex/arithmetic_result_q_29_s0\", \"slack_ns\": -4.269, \"arrival_ns\": 14.563, \"logic_cells\": 36, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\"]}]}\n", "exit_code": 0, "status": "completed"}}
