{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/carry_select_trial')\nroot=Path('cores/bench/generated/carry_prefix_trial')\nshutil.copytree(base/'rtl',root/'rtl',dirs_exist_ok=True)\nrtl=root/'rtl'\n(rtl/'carry_select32.sv').rename(rtl/'carry_lookahead32.sv')\n(rtl/'carry_lookahead32.sv').write_text('''module carry_lookahead32 #(\n  parameter bit SUBTRACT = 1'b0\n) (\n  input logic [31:0] a,\n  input logic [31:0] b,\n  output logic [31:0] sum\n);\n  wire [31:0] b_eff = SUBTRACT ? ~b : b;\n  wire [7:0] gen0, prop0;\n  wire [7:0] gen1, prop1;\n  wire [7:0] gen2, prop2;\n  wire [7:0] gen3, prop3;\n  wire [7:0] carry_in;\n  for (genvar k = 0; k < 8; k++) begin : gen_blocks\n    wire [4:0] local_zero = {1'b0,a[k*4 +: 4]} + {1'b0,b_eff[k*4 +: 4]};\n    wire [4:0] local_sum = {1'b0,a[k*4 +: 4]} + {1'b0,b_eff[k*4 +: 4]} + {4'b0,carry_in[k]};\n    assign gen0[k] = local_zero[4];\n    assign prop0[k] = &(a[k*4 +: 4] \"'^ b_eff[k*4 +: 4]);\n    assign sum[k*4 +: 4] = local_sum[3:0];\n    if (k == 0) assign carry_in[k] = SUBTRACT;\n    else assign carry_in[k] = gen3[k-1] | (prop3[k-1] & SUBTRACT);\n    if (k < 1) begin\n      assign gen1[k] = gen0[k];\n      assign prop1[k] = prop0[k];\n    end else begin\n      assign gen1[k] = gen0[k] | (prop0[k] & gen0[k-1]);\n      assign prop1[k] = prop0[k] & prop0[k-1];\n    end\n    if (k < 2) begin\n      assign gen2[k] = gen1[k];\n      assign prop2[k] = prop1[k];\n    end else begin\n      assign gen2[k] = gen1[k] | (prop1[k] & gen1[k-2]);\n      assign prop2[k] = prop1[k] & prop1[k-2];\n    end\n    if (k < 4) begin\n      assign gen3[k] = gen2[k];\n      assign prop3[k] = prop2[k];\n    end else begin\n      assign gen3[k] = gen2[k] | (prop2[k] & gen2[k-4]);\n      assign prop3[k] = prop2[k] & prop2[k-4];\n    end\n  end\nendmodule\n'\"''')\nfor f in ('alu.sv','ex_stage.sv'):\n p=rtl/f\n p.w