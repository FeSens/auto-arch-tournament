old_payload\"] and not o[\"wb_valid\"] and o[\"fwd_rs1\"] == 2\n               for o in observed)\n    accepted = [o[\"request\"][0] for o in observed\n                if o[\"dready\"] and (o[\"request\"][2] or o[\"request\"][3])]\n    assert accepted == [0x100, 0x104, 0x108]\n\n\n@cocotb.test()\n            expected_requests += [0x504] + ([0x508] if kind == \"store\" else [])\n      \n…[1804 of 4876 chars elided by tools/bench/transcript.py; sha256:a27a7c0736718e0e]…\n     assert results[28][\"mem_rmask\"] == 8 and results[28][\"mem_rdata\"] == 0x80FE7F81\n        assert dmem == {0x400: 0x80FE7F81}\n        accepted = [o[\"request\"] for o in observed\n                    if o[\"dready\"] and (o[\"request\"][2] or o[\"request\"][3])]\n        assert accepted == [(0x403, 0, 0, 1)]\n        if not stalled:\n            # x0's loaded result remains available as data even though the\n            # register file and RVFI suppress its architectural destination.\n            assert any(o[\"wb_valid\"] and o[\"wb_en\"] and o[\"wb_addr\"] == 0\n                       and o[\"wb_data\"] == 0xFFFFFF80 for o in observed)\n            assert any(not o[\"wb_valid\"] and not o[\"wb_en\"] and o[\"wb_addr\"] == 5\n                       and o[\"wb_data\"] == 0xFFFFFF80 for o in observed), \\\n                \"invalid ordinary load payload did not capture its selected result\"\n\n\n@cocotb.test()\nasync def registered_wb_reset_during_memory_hold(dut):\n    \"\"\"Synchronous reset cancels the held request and clears the retained result.\"\"\"\n", "exit_code": 0, "status": "completed"}}
