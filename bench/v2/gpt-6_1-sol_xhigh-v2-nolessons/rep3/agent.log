lse, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n238:                'reason': 'maxcycles_hit_before_ebreak'}\n241:    # point during this run, the cycle count we're about to divide by is tainted\n246:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n251:    valid, reason = validate_coremark_uart(uart, iterations)\n253:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n256:    # Bracketed cycles (start_time..stop_time) are the contract per\n263:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n265:                          f'start={marker.get(\"bench_start_cycle\")} '\n266:                          f'stop={marker.get(\"bench_stop_cycle\")}'}\n267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n268:    if elapsed_cycles <= 0:\n269:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n270:                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n271:    ipc = iterations / elapsed_cycles\n272:    return {'completed': True, 'iter_per_cycle': ipc, 'cycles': elapsed_cycles,\n273:            'iterations': iterations, 'bracketed_cycles': True}\n275:def _uart_int(uart: str, pattern: str, base: int = 10):\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n306:def _bench_sv(worktree: str, target: str | None) -> str:\n314:def measure_fmax(worktree: str, target: str, pairs=None) -> dict:\n330:def run_fpga_eval(worktree: str, target: str | None = None) -> dict:\n333:    Verilator CoreMark run (with random memory stalls) for cycles.\n341:        'ipc_coremark': float,           — iter/cycle\n342:        'fitness': float,                — iter/sec = fmax_hz * iter/cycle\n343:        'cycles': int, 'iterations': int,\n382:    fitness = fp['fmax_mhz'] * cm['iter_per_cycle'] * 1_000_000