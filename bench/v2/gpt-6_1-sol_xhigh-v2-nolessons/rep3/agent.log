{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"sed -n '620,1040p' cores/bench/test/test_pipeline.py && cat cores/bench/test/_helpers.py\"", "aggregated_output": "                if o[\"request\"][2] or o[\"request\"][3]]\n    assert requests == [0x100, 0x104]\n    for index in (0, 2, 3, 4, 6, 9):\n        assert any(not o[\"ex_valid\"] and o[\"ex_instr\"] == program[index] for o in observed), \\\n            f\"missing invalid-payload coverage at PC={4 * index}\"\n\n\n@cocotb.test()\nasync def redirect_during_memory_hold_retains_wb_forwarding(dut):\n    \"\"\"A held branch needs WB bypass after WB's retirement valid has cleared.\"\"\"\n    program = [LW(1, 0, 0x100), SW(0, 0, 0x104), BEQ(1, 0, 8),\n               SW(1, 0, 0x108), ADDI(2, 1, 9), EBREAK()]\n    blocked = 0\n\n    def ready(cycle, request):\n        nonlocal blocked\n        if request[2] and request[0] == 0x104:\n            blocked += 1\n            if blocked <= 12:\n                return 0, 0\n        return 1, 1\n\n    observed = []\n    rets, dmem = await _run(dut, program, {0x100: 0},\n                            ready_fn=ready, observations=observed)\n    _check_stream(rets, program, skipped=(3,))\n    [branch] = _by_insn(rets, program[2])\n    assert branch[\"rs1_rdata\"] == 0 and branch[\"pc_next\"] == 16\n    assert dmem == {0x100: 0, 0x104: 0}\n    assert any(o[\"redirect\"] and not o[\"iready\"] and not o[\"dready\"] for o in observed)\n    assert any(o[\"hold_payload\"] and not o[\"wb_valid\"] and o[\"fwd_rs1\"] == 2\n               for o in observed), \"retained WB forwarding case was not exercised\"\n\n    # With a nonzero load, losing that retained bypass would falsely take\n    # the branch and drop the store. The load is newer than the ID snapshot.\n    blocked = 0\n    observed = []\n    rets, dmem = await _run(dut, program, {0x100: 23},\n                            ready_fn=ready, observations=observed)\n    _check_strea