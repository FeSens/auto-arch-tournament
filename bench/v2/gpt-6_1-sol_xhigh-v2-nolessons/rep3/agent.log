verride the registered-grant datapath in formal.\n    // There is no service ownership or completion in this build.\n    case (op)\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\n      default: ;\n    endcase\n    end\n`endif\n  end else begin : gen_encoded_result\n  always_comb begin\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\nls: cannot access '.toolchain': No such file or directory\nlrwxrwxrwx 1 nobody nogroup 76 Oct  5 00:17 formal/riscv-formal -> /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep3/formal/riscv-formal\n","exit_code":1,"status":"failed"}}
