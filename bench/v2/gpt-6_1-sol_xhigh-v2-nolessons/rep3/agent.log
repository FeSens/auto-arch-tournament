{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nimport struct, json\nbranches=list(struct.iter_unpack('<IBB',Path('cores/bench/generated/predictor_research/branches.bin').read_bytes()))\nresults=[]\nfor bits in (4,5,6,7,8):\n mask=(1<<bits)-1\n for kind in ('bimodal','agree','forward','onebit','gshare'):\n  for shift in (0,8,10):\n   table=[2 if kind=='agree' else 1]*(1<<bits); h=0; misses=0\n   for pc,taken,sign in branches:\n    i=((pc>>2)\"'^(pc>>shift if shift else 0)''^(h if kind=='\"'gshare' else 0))&mask\n    pred=(table[i]>=2)\n    if kind=='agree': pred = pred==bool(sign)\n    elif kind=='forward' and sign: pred=True\n    elif kind=='onebit': pred=bool(table[i])\n    misses+=pred\"'!=taken\n    if kind=='\"'onebit': table[i]=taken\n    elif kind=='agree': table[i]=max(0,min(3,table[i]+(1 if taken==sign else -1)))\n    elif kind\"'!='\"'forward' or not sign: table[i]=max(0,min(3,table[i]+(1 if taken else -1)))\n    h=((h<<1)|taken)&mask\n   results.append((misses,bits,kind,shift))\nfor row in sorted(results)[:30]: print(row)\nprint('SMALL TABLES')\nfor row in sorted(r for r in results if r[1]<=6)[:30]: print(row)\nPath('cores/bench/generated/predictor_research/accuracy.json').write_text(json.dumps(results))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
