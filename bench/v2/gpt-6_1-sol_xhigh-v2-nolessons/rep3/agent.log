{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/predictor_variants/counters16/rtl')\nfor bits in (4,6):\n size=1<<bits; name=f'local{size}'\n dest=Path(f'cores/bench/generated/predictor_variants/{name}/rtl');dest.mkdir(parents=True,exist_ok=True)\n for p in base.glob('*.sv'):shutil.copy2(p,dest/p.name)\n p=dest/'if_stage.sv';s=p.read_text()\n s=s.replace('logic [1:0] counters [0:15];',f'logic [1:0] counters [0:{size-1}];')\n s=s.replace('logic [3:0] lookup_index, train_index;',f'logic [{bits-1}:0] lookup_index, train_index;')\n s=s.replace('pc[5:2] \"'^ pc[9:6]'\"',f'pc[{bits+1}:2] \"'^ pc[{2*bits+1}:{bits+2}]'\"')\n s=s.replace('train_pc[5:2] \"'^ train_pc[9:6]'\"',f'train_pc[{bits+1}:2] \"'^ train_pc[{2*bits+1}:{bits+2}]'\"')\n a=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      for (int i=0; i<16; i++) counters[i]')\n b=s.index('\\\\n  always_comb begin\\\\n    next_pc',a)\n gen=f'''  generate for (genvar entry=0; entry<{size}; entry++) begin : bht_entry\n    always_ff @(posedge clock) begin\n      if (reset) counters[entry] <= 2'b01;\n      else if (train_valid && train_index == {bits}'(entry)) begin\n        counters[entry][1] <= train_taken ? (counters[entry][1] | counters[entry][0])\n                                                : (counters[entry][1] & counters[entry][0]);\n        counters[entry][0] <= train_taken ? (counters[entry][1] | ~counters[entry][0])\n                                                : (counters[entry][1] & ~counters[entry][0]);\n      end\n    end\n  end endgenerate\n'''\n s=s[:a]+gen+s[b:];p.write_text(s)\nprint('Prepared local counter-state transition variants')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
