{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport re\nfrom pathlib import Path\ns=Path('cores/bench/generated/lookup_inspection/impl/pnr/core_bench.vo').read_text()\nnodes={}; drivers={}; init={}\nclean=lambda v: re.sub(r'\\\\s+','',v)\nfor typ,name,body in re.findall(r'\"'^('\"\\\\w+)\\\\s+(\\\\\\\\\\\\S+|\\\\w+)\\\\s+\\\\(\\\\s*(.*?)\"'^'\"\\\\);',s,re.M|re.S):\n ports={p:clean(v) for p,v in re.findall(r'\\\\.(\\\\w+)\\\\(([\"'^()]*)'\"\\\\)',body)}\n n=(typ,name,ports); nodes[name]=n\n for p in ('F','Q','O','SUM','COUT'):\n  if p in ports: drivers[ports[p]]=n\nfor name,value in re.findall(r'\"'^defparam'\"\\\\s+(\\\\\\\\\\\\S+|\\\\w+)\\\\s*\\\\.INIT\\\\s*=\\\\s*([\"'^;]+);'\"',s,re.M): init[name]=value\nleaves=[n for n in nodes.values() if n[0].startswith('LUT') and 'predicted_taken' in n[1] and any('counter_q[1]' in v for v in n[2].values())]\nprint('Lookup leaves containing counter MSBs:',len(leaves))\nfor typ,name,ports in leaves[:10]: print(typ,name,init.get(name),ports)\nprint('Predicted-taken output cone:')\ndef cone(net,depth=0):\n n=drivers.get(net)\n if n is None or depth>3: return\n typ,name,ports=n\n print(' '*depth,typ,name,init.get(name),ports)\n if typ.startswith('LUT'):\n  for p,v in ports.items():\n   if p.startswith('I'): cone(v,depth+1)\ncone('\\\\\\\\cpu/if_id_w.predicted_taken')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
