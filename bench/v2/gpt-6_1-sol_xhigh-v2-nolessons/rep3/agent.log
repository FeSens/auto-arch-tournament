{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_predictor.py; rg --files cores/bench/experiments/hypotheses | tail -15; rg -n 'timing|coremark|sim' Makefile\"", "aggregated_output": "\"\"\"Independent direction-counter, raw predecode and pre-edge lookup checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b, _direct_offset, _legal_branch, _predictor_index\n\n\n@cocotb.test()\nasync def counters_predecode_targets_and_reset(dut):\n    counters = [1] * 64\n    pc = 0\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.imem_data.value = NOP()\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n\n    async def edge(insn=NOP(), train=None, stall=1, flush=0, redirect=None, reset=0):\n        nonlocal pc, counters\n        dut.clock.value = 0\n        dut.reset.value = reset\n        dut.imem_data.value = insn\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut.redirect.value = redirect is not None\n        dut.redirect_target.value = redirect or 0\n        dut.train_valid.value = train is not None\n        dut.train_pc.value = train[0] if train else 0\n        dut.train_taken.value = train[1] if train else 0\n        await Timer(2, unit=\"ns\")\n        target = (pc + _direct_offset(insn)) & 0xFFFFFFFF\n        prediction = target & 3 == 0 and (insn & 127 == 0x6F or\n                                         (_legal_branch(insn) and counters[_predictor_index(pc)] >= 2))\n        fetch = int(dut.out.value)\n        assert (fetch >> 1) & 0xFFFFFFFF == insn\n        assert (fetch >> 34) & 1 == prediction, \"lookup bypassed pre-edge counter state\"\n        assert (fetch >> 33) & 1 == (target & 3 == 0)\n        assert (fetch >> 35) & 0xFFFFFFFF == ((pc + 4) & 0xFFFFFFFF if prediction else target)\n        assert fetch & 1 == int(not flush and redirect is None)\n        if reset:\n            counters, next_pc = [1] * 64, 0\n        else:\n            next_pc = redirect if redirect is not None else pc if stall else target if prediction else (pc + 4) & 0xFFFFFFFF\n         \n…[2738 of 5810 chars elided by tools/bench/transcript.py; sha256:3b8aaddac0f4d6ce]…\n — Gowin Fmax and worst paths (placement option 0)\"\n84:\t@echo \"  make bench              — build selftest + coremark ELFs\"\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n113:\tpython3 -m tools.eval.cosim . $(TARGET)\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n116:\tbash test/cosim/build.sh\n135:# FPGA timing and area come from the vendor flow, Gowin EDA\n137:fpga: cosim-build bench/programs/coremark.elf\n140:timing:\n143:bench/programs/coremark.elf: bench/programs/Makefile bench/programs/crt0.S \\\n144:                              $(wildcard bench/programs/coremark/*.c) \\\n145:                              $(wildcard bench/programs/coremark/*.h) \\\n146:                              $(wildcard bench/programs/coremark/baremetal/*.c) \\\n147:                              $(wildcard bench/programs/coremark/baremetal/*.h)\n148:\t$(MAKE) -f bench/programs/Makefile bench/programs/coremark.elf\n178:\trm -rf test/cosim/sim_build sim_build out\n187:\trm -rf cores/$(TARGET)/sim_build\n", "exit_code": 0, "status": "completed"}}
