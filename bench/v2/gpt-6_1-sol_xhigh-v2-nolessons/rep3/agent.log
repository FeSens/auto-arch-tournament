e, request):\n        nonlocal blocked\n        if request[2] and request[0] == 0x104:\n            blocked += 1\n            if blocked <= 12:\n                return 0, 0\n        return 1, 1\n\n    observed = []\n    rets, dmem = await _run(dut, program, {0x100: 0},\n                            ready_fn=ready, observations=observed)\n    _check_stream(rets, program, skipped=(3,))\n    [branch] = _by_insn(rets, program[2])\n    assert branch[\"rs1_rdata\"] == 0 and branch[\"pc_next\"] == 16\n    assert dmem == {0x100: 0, 0x104: 0}\n    assert any(o[\"redirect\"] and not o[\"iready\"] and not o[\"dready\"] for o in observed)\n    assert any(o[\"hold_payload\"] and not o[\"wb_valid\"] and o[\"fwd_rs1\"] == 2\n               for o in observed), \"retained WB forwarding case was not exercised\"\n\n    # With a nonzero load, losing that retained bypass would falsely take\n    # the branch and drop the store. The load is newer than the ID snapshot.\n    blocked = 0\n    observed = []\n    rets, dmem = await _run(dut, program, {0x100: 23},\n                            ready_fn=ready, observations=observed)\n    _check_stream(rets, program)\n    [branch] = _by_insn(rets, program[2])\n    assert branch[\"rs1_rdata\"] == 23 and branch[\"pc_next\"] == 12\n    assert dmem == {0x100: 23, 0x104: 0, 0x108: 23}\n    [result] = _by_insn(rets, program[4])\n    assert result[\"rd_wdata\"] == 32\n    assert any(o[\"hold_payload\"] and not o[\"wb_valid\"] and o[\"fwd_rs1\"] == 2\n               for o in observed)\n    accepted = [o[\"request\"][0] for o in observed\n                if o[\"dready\"] and (o[\"request\"][2] or o[\"request\"][3])]\n    assert accepted == [0x100, 0x104, 0x108]\n\n\nls: cannot access 'cores/bench/generated/r6s1_trial/timing/gowin_p1/impl/pnr/core_bench.tr': No such file or directory\nSBY 19:00:45 [insn_srl_ch0] engine_0: ##   0:00:00  Skipping step 13..\nSBY 19:00:45 [insn_srl_ch0] engine_0: ##   0:00:00  Skipping step 14..\nSBY 19:00:45 [insn_srli_ch0] bas