.dumps(r,indent=2))\n print(name,opt,json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=4) as pool:\n list(pool.map(trial,(('confidence',0),('confidence',1),('confidence',2),('binary_boolean',1))))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
