{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, json\nroot=Path('cores/bench/generated/hypgen_r13')\nfor name in ('early_mask','grant_carry','only_add'):\n rtl=root/name/'rtl';shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n p=rtl/'alu.sv';s=p.read_text()\n if name=='early_mask':\n  s=s.replace('((a + b) & {32{result_grants[0]}})','((a & {32{result_grants[0]}}) + (b & {32{result_grants[0]}}))')\n  s=s.replace('((a - b) & {32{result_grants[1]}})','((a & {32{result_grants[1]}}) - (b & {32{result_grants[1]}}))')\n elif name=='grant_carry':\n  # Early operation selection, shared native carry chain. No dynamic opcode\n  # decoding: exclusively registered ADD/SUB grants determine neutral inputs.\n  anchor='    // Shift grants enter before the original barrel expressions.'\n  network='''    wire arithmetic_selected = result_grants[0] | result_grants[1];\n    wire [31:0] arithmetic_a = a & {32{arithmetic_selected}};\n    wire [31:0] arithmetic_b = (b & {32{arithmetic_selected}}) \"'^ {32{result_grants[1]}};\n    wire [31:0] arithmetic_sum = arithmetic_a + arithmetic_b + {31'\"'b0, result_grants[1]};\n'''\n  s=s.replace(anchor,network+anchor)\n  s=s.replace('(((a + b) & {32{result_grants[0]}})\\\\n         | ((a - b) & {32{result_grants[1]}}))','(arithmetic_sum)')\n elif name=='only_add':\n  s=s.replace('((a + b) & {32{result_grants[0]}})','((a & {32{result_grants[0]}}) + (b & {32{result_grants[0]}}))')\n p.write_text(s)\nprint('Prepared early-grant native-arithmetic trials')\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom tools.eval.gowin import build\nimport json\nwt=Path.cwd();p=wt/'cores/bench/generated/hypgen_r13'\nvariants=['baseline','early_mask','grant_carry','only_add']\ndef run(name):\n rtl=wt/'cores/bench/rtl' if name=='baseline' else p/name/'rtl'\n result=build(wt,rtl,'fpga/co