{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 -B - <<'PY'\nimport sys, json\nfrom array import array\nfrom pathlib import Path\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\nroot = Path('/srv/hwebench/tmp/f88745d5/4a7d11cb')\ncpu = RV32IM(); cpu.load_elf(str(root/'coremark-predictor.elf'))\nconfigs = [(n,h) for n in (32,64,128,256) for h in (False,True)]\ntables = {c: [None]*c[0] for c in configs}\nstats = {c: {'conditional':0,'jal':0,'jalr':0,'other':0,'tag_miss':0} for c in configs}\nbase = {'conditional':0,'jal':0,'jalr':0}\ncounts = dict(base); pcs = {k:set() for k in base}\ntrace = array('I'); active = False; steps = 0; measured = 0\nwhile steps < 10000000:\n    r = cpu.step()\n    if r is None: break\n    steps += 1\n    pc, insn, npc = r['pc'], r['insn'], r['npc']\n    op = insn & 127\n    kind = {0x63:'conditional',0x6f:'jal',0x67:'jalr'}.get(op,'other')\n    control = kind \"'!= '\"'other' and not r['trap']\n    taken = npc \"'!= ((pc+4)&0xffffffff)\n    target = npc\n    if kind == '\"'conditional':\n        imm = ((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1)\n        if imm&4096: imm -= 8192\n        target = (pc+imm)&0xffffffff\n    if active:\n        measured += 1\n        if control:\n            counts[kind] += 1; pcs[kind].add(pc)\n            if taken: base[kind] += 1\n    for c in configs:\n        n, hashed = c; bits = n.bit_length()-1\n        idx = ((pc>>2)\"'^((pc>>(2+bits)) if hashed else 0))&(n-1)\n        tab = tables[c]; e = tab[idx]\n        hit = e is not None and e[0] == pc\n        prediction = e[1] if hit and (e[2] or e[3]>=2) else ((pc+4)&0xffffffff)\n        if active and prediction != npc:\n            stats[c][kind] += 1\n        if active and control and not hit: stats[c]['\"'tag_miss'] += 1\n        if control and target&3 == 0:\n            unconditional = kind \"'!= '\"'conditional'\n            counter = min(3,e[3]+1) if taken else max(0,e[3]-1)\n            if not hit or e[2] \"'!= unconditional: counter = 2 if taken else 1\n            tab[idx] = (pc,target,unconditional,counter)\n    trace.extend((pc,insn,npc,r['\"'mem_addr'] if r['mem_rmask'] or r['mem_wmask'] else 0xffffffff))\n    if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n    if r['mem_wmask'] and r['mem_addr']==0x10000104: break\nwith (root/'coremark-predictor-trace.bin').open('wb') as f: trace.tofile(f)\nreport={'steps':steps,'measured_instructions':measured,'counts':counts,'unique_pcs':{k:len(v) for k,v in pcs.items()},'baseline_redirects':base,'predictors':{f'{n}_{\\\"xor\\\" if h else \\\"direct\\\"}':s for (n,h),s in stats.items()},'oob':cpu.oob_access}\n(root/'coremark-predictor-stats.json').write_text(json.dumps(report,indent=2))\nprint(json.dumps(report,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
