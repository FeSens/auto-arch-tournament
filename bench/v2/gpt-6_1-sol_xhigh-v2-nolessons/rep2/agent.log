{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('/srv/hwebench/tmp/3d673a88/3690d99c/r8s0_probe')\nprobe.mkdir(exist_ok=True)\nfor variant in ('native','block4','block8'):\n rtl=probe/variant/'rtl'\n rtl.mkdir(parents=True,exist_ok=True)\n for src in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(src,rtl/src.name)\n if variant=='native': continue\n size=int(variant.removeprefix('block')); blocks=32//size; levels=(blocks-1).bit_length()\n code='''module fast_adder (input logic [31:0] a, b, input logic cin, output logic [31:0] sum);\n'''\n code+=f'  wire [{blocks-1}:0] p [0:{levels}];\\\\n  wire [{blocks-1}:0] g [0:{levels}];\\\\n  wire [{blocks-1}:0] c;\\\\n'\n for block in range(blocks):\n  lo=block*size\n  code+=f'''  wire [{size}:0] s0_{block} = {{1'b0,a[{lo} +: {size}]}} + {{1'b0,b[{lo} +: {size}]}};\n  assign p[0][{block}] = &(a[{lo} +: {size}] \"'^ b[{lo} +: {size}]);\n  assign g[0][{block}] = s0_{block}[{size}];\n  assign sum[{lo} +: {size}] = s0_{block}[{size-1}:0] + {{{size-1}'\"'b0,c[{block}]}};\n'''\n for level in range(1,levels+1):\n  distance=1<<(level-1)\n  for block in range(blocks):\n   if block<distance:\n    code+=f'  assign g[{level}][{block}] = g[{level-1}][{block}];\\\\n  assign p[{level}][{block}] = p[{level-1}][{block}];\\\\n'\n   else:\n    code+=f'  assign g[{level}][{block}] = g[{level-1}][{block}] | (p[{level-1}][{block}] & g[{level-1}][{block-distance}]);\\\\n  assign p[{level}][{block}] = p[{level-1}][{block}] & p[{level-1}][{block-distance}];\\\\n'\n code+='  assign c[0] = cin;\\\\n'\n for block in range(1,blocks): code+=f'  assign c[{block}] = g[{levels}][{block-1}] | (p[{levels}][{block-1}] & cin);\\\\n'\n code+='endmodule\\\\n'\n (rtl/'fast_adder.sv').write_text(code)\n p=rtl/'alu.sv';s=p.read_text();s=s.replace('  always_comb begin\\\\n    shamt', '''  logic [31:0] add_result, sub_result;\n  fast_adder u_add(.a