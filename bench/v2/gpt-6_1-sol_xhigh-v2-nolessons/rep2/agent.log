{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl')\ndst=Path('cores/bench/generated/hypgen_rf_probe/rtl')\ndst.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'):\n shutil.copy2(p,dst/p.name)\noriginal=(src/'reg_file.sv').read_text()\nheader=original.split('  logic [31:0] regs [0:31];')[0]\nbody='''  logic [31:0] words [1:31];\n  logic [31:0] raw_rs1, raw_rs2;\n  for (genvar g=1; g<32; g++) begin : rf_word\n    always_ff @(posedge clock) begin\n      if (reset) words[g] <= 32'b0;\n      else if (w_en && w_addr == 5'(g)) words[g] <= w_data;\n    end\n  end\n  always_comb begin\n    raw_rs1 = 32'b0;\n    raw_rs2 = 32'b0;\n    for (int i=1; i<32; i++) begin\n      raw_rs1 = raw_rs1 | (words[i] & {32{rs1_addr == 5'(i)}});\n      raw_rs2 = raw_rs2 | (words[i] & {32{rs2_addr == 5'(i)}});\n    end\n    if (rs1_addr == 5'b0) rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = raw_rs1;\n    if (rs2_addr == 5'b0) rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = raw_rs2;\n  end\nendmodule\n'''\n(dst/'reg_file.sv').write_text(header+body)\nprint('Prepared explicit flop register-file timing probe; champion RTL is unchanged.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
