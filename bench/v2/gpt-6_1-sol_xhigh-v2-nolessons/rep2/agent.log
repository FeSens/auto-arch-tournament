{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hyp13_alu_compare_prototype')\nrtl=base/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'alu.sv';s=p.read_text().replace('  always_comb begin\\\\n    shamt', '''  wire [15:1] compare_lt;\n  wire [15:1] compare_eq;\n  wire signed_lt;\n  for (genvar g=0; g<8; g++) begin : g_compare_leaf\n    assign compare_lt[8+g] = a[4*g +: 4] < b[4*g +: 4];\n    assign compare_eq[8+g] = a[4*g +: 4] == b[4*g +: 4];\n  end\n  for (genvar g=1; g<8; g++) begin : g_compare_tree\n    assign compare_lt[g] = compare_lt[2*g+1] | (compare_eq[2*g+1] & compare_lt[2*g]);\n    assign compare_eq[g] = compare_eq[2*g+1] & compare_eq[2*g];\n  end\n  assign signed_lt = (a[31] \"'^ b[31]) ? a[31] : compare_lt[1];\n\n  always_comb begin\n    shamt'\"''').replace('ALU_SLT:    out = {31\\\\'b0, \"'$signed(a) < $signed(b)};'\"', 'ALU_SLT:    out = {31\\\\'b0, signed_lt};').replace('ALU_SLTU:   out = {31\\\\'b0, a < b};', 'ALU_SLTU:   out = {31\\\\'b0, compare_lt[1]};')\ns=s.replace('  wire [15:1] compare_eq;', '  /* verilator lint_off UNUSEDSIGNAL */\\\\n  wire [15:1] compare_eq;\\\\n  /* verilator lint_on UNUSEDSIGNAL */')\np.write_text(s)\nprint('Prepared balanced ALU comparator prototype',rtl)\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nimport json\nwt=Path.cwd();base=wt/'cores/bench/generated/hyp13_alu_compare_prototype'\nr=build_all(wt,base/'rtl','fpga/core_bench_si.sv',base/'timing')\n(base/'timing_result.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(summarize(r),indent=2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
