{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport struct\nfrom collections import Counter\nfrom pathlib import Path\ntrace=list(struct.iter_unpack('<IIIB',Path('/srv/hwebench/tmp/3d673a88/01ab618d/predictor_trace.bin').read_bytes()))\nfor policy in ('two-bit','one-bit','static-backward','static-taken'):\n tab=[None]*64; m=Counter()\n for pc,insn,nxt,measured in trace:\n  jump=(insn&127)\"'!=99; actual=jump or nxt!=pc+4; idx=(pc>>2)&63\n  row=tab[idx]; hit=row is not None and row[0]==pc\n  pred=hit and (row[2] or row[3]>=2)\n  if measured and ((bool(pred)!=actual) or (pred and actual and row[1]!=nxt)):\n   m['\"'total']+=1; m['jump' if jump else 'branch']+=1\n  if jump: target=nxt\n  else:\n   imm=((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1)\n   if imm&4096: imm-=8192\n   target=(pc+imm)&0xffffffff\n  if policy=='two-bit':\n   counter=min(3,row[3]+1) if hit and not row[2] and actual else (max(0,row[3]-1) if hit and not row[2] else (2 if actual else 1))\n  elif policy=='one-bit': counter=2 if actual else 1\n  elif policy=='static-backward': counter=2 if (insn>>31) else 1\n  else: counter=2\n  tab[idx]=(pc,target,jump,counter)\n print(policy,dict(m))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
