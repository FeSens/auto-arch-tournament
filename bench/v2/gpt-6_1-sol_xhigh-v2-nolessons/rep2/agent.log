 f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[9794 of 12866 chars elided by tools/bench/transcript.py; sha256:767d747ae4e5323a]…\n       bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n", "exit_code": 0, "status": "completed"}}
