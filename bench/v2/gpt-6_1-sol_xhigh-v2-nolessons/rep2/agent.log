{"type": "item.completed", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/bash -c 'git diff --check; cat cores/bench/rtl/hazard_unit.sv'", "aggregated_output": "// rtl/hazard_unit.sv\n//\n// Interlocks load-use, memory backpressure and pending EX division.\n// A LOAD in EX produces its data only after MEM,\n// so an instruction immediately behind that consumes the LOAD's rd\n// must be stalled by exactly one cycle.\n//\n// Outputs:\n//   consume_if          : candidate registered-head transfer, independent\n//                          of recovery and instruction-memory readiness.\n//   stall_id            : hold the finalized ID/EX operands.\n//   flush_id            : on EX recovery, kill younger ID/EX control.\n//   flush_id            : also kills ID's own register on load-use to\n//                          inject a single-cycle bubble between LOAD\n//                          and the dependent instruction.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       if_id_valid,       // registered queue head available\n  input  logic       redirect,          // accepted EX prediction recovery\n  input  logic       div_wait,          // hold the division in ID/EX\n  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n  // random ~22% stall in vex_main.cpp). When low, the corresponding\n  // memory request is NOT serviced this cycle.\n  input  logic       dmem_ready,\n  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n  // would actually be holding up). Computed at top level from the\n  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n  input  logic       ex_mem_mem_op,\n  output logic       consume_if,        // speculative queue head consumption\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_id,          // ID/EX register captures '0\n  output logic       stall_ex_mem,      // EX/MEM register holds\n  output logic       hold_mem_wb        // MEM/WB clears valid only\n);\n\n  logic load_use_hazard;\n  logic dmem_stall;\n\n  assign load_use_hazard = if_id_valid && id_ex_mem_read\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                   && (id_ex_rd != 5'b0);\n    // dmem stall only matters if there's actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n  assign dmem_stall = !dmem_ready && ex_mem_mem_op;\n\n    // ID/EX register:\n    //   - dmem_stall  -> hold        (preserve in-flight pipeline state)\n    //   - div_wait    -> hold        (older MEM/WB instructions still drain)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n  assign stall_id = dmem_stall || load_use_hazard || div_wait;\n    // Recovery is deliberately excluded from the FIFO payload enables.\n    // Its priority at occupancy and ID/EX discards candidate transfers.\n  assign consume_if = if_id_valid && !stall_id;\n    // redirect is already qualified by EX acceptance. It must override\n    // raw wrong-path source-bit load-use interlocks at the ID register.\n  assign flush_id = redirect || (load_use_hazard && !dmem_stall && !div_wait);\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n  assign stall_ex_mem = dmem_stall;\n    // MEM/WB clears valid on dmem_stall to avoid repeating retirement.\n    // ID/EX holds finalized operands without refreshing from MEM or WB.\n  assign hold_mem_wb = dmem_stall;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
