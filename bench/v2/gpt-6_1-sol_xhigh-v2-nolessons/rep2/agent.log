\": 1919,\n  \"lutram\": 32,\n  \"bsram\": 5,\n  \"dsp\": 2,\n  \"logic_levels\": 10,\n  \"critical_path\": {\n    \"from\": \"stall_gen/imem_ready_s0\",\n    \"to\": \"cpu/u_ex/u_alu/mul_product_65_s1\",\n    \"slack_ns\": -9.049,\n    \"arrival_ns\": 19.123,\n    \"logic_cells\": 12,\n    \"modules\": [\n      \"clock_ibuf\",\n      \"cpu/u_if\",\n      \"cpu/u_rf\",\n      \"cpu/u_id\"\n    ]\n  }\n}\n","exit_code":0,"status":"completed"}}
