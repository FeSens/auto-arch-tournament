{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,300p' cores/bench/test/test_alu.py\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic and multiplication are combinational. Division uses a\nclocked request/completion/consume handshake and bounded real arithmetic.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nMASK64 = 0xFFFFFFFFFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_start.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_done.value)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    await _tick(dut)\n    dut.div_start.value = 0\n    assert int(dut.div_busy.value)\n    cycles = 0\n    while not int(dut.div_done.value):\n        assert int(dut.out.value) == 0, \"unfinished divider result exposed\"\n        assert cycles < 36, \"divider failed to finish within its bound\"\n        await _tick(dut)\n        cycles += 1\n    assert cycles == (1 if (b & MASK32) == 0 else 34), cycles\n    await _check(dut\n…[5691 of 8763 chars elided by tools/bench/transcript.py; sha256:77a72a917a80cd41]…\nack_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Real divides only (avoid edge-case short-circuit) so each pass\n    # exercises all 32 recurrence cycles and setup/sign correction.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def division_boundaries_and_random(dut):\n    await _setup(dut)\n    boundaries = [0, 1, 2, 3, 0x7fffffff, 0x80000000,\n                  0x80000001, 0xfffffffe, MASK32]\n    rng = random.Random(0xD1A1DE)\n    pairs = [(a, b) for a in boundaries for b in boundaries]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(100)]\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n", "exit_code": 0, "status": "completed"}}
