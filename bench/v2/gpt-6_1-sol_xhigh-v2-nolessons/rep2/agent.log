{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"sed -n '1,110p' cores/bench/test/test_alu.py; sed -n '880,920p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic and multiplication are combinational. Division uses a\nclocked request/completion/consume handshake and bounded real arithmetic.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nMASK64 = 0xFFFFFFFFFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_start.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_done.value)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    await _tick(dut)\n    dut.div_start.value = 0\n    assert int(dut.div_busy.value)\n    cycles = 0\n    while not int(dut.div_done.value):\n        assert int(dut.out.value) == 0, \"unfinished divider result exposed\"\n        assert cycles < 36, \"divider failed to finish within its bound\"\n        await _tick(dut)\n        cycles += 1\n    assert cycles == (1 if (b & MASK32) == 0 else 34), cycles\n    await _check(dut, op, a, b, expected)\n    dut.div_consume.value = 1\n    await _tick(dut)\n    dut.div_consume.value = 0\n    assert not int(dut.div_done.value)\n    assert not int(dut.div_busy.value)\n\n\ndef _signed(value):\n    return value if value < 0x80000000 else value - 0x100000000\n\n\ndef _multiplication_expected(op, a, b):\n    \"\"\"Exact Python integer product, reduced to the RV32M result bits.\"\"\"\n    lhs = _signed(a) if op in (ALU_MULH, ALU_MULHSU) else a\n    rhs = _signed(b) if op == ALU_MULH else b\n    product = (lhs * rhs) & MASK64\n    return (product if op == ALU_MUL else product >> 32) & MASK32\n\n\ndef _division_expected(op, a, b):\n    if not b:\n        return a if op in (ALU_REM, ALU_REMU) else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        sa, sb = _signed(a), _signed(b)\n        quotient = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            quotient = -quotient\n        return (sa - quotient * sb if op == ALU_REM else quotient) & MASK32\n    return (a % b if op == ALU_REMU else a // b) & MASK32\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"branch_predictor.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n","exit_code":0,"status":"completed"}}
