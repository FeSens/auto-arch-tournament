{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '166,292p' cores/bench/test/test_pipeline.py; sed -n '570,790p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def _run_checked(dut, program, dmem_init=None, stalls=None,\n                       max_cycles=2000, reset_cycle=None, mutate=None, events=None):\n    \"\"\"Edge-accurate bus model: count a store only on its accepting edge.\n\n    stalls(cycle, fetch_pc, data_addr, wen, ren) returns (iready, dready).\n    Every retirement must have a unique consecutive order and instruction.\n    \"\"\"\n    imem = dict(program) if isinstance(program, dict) else {\n        4 * i: insn for i, insn in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    rets, stores = [], []\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = NOP()\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n    dut.reset.value = 0\n    for cycle in range(max_cycles):\n        dut.clock.value = 0\n        resetting = cycle == reset_cycle\n        dut.reset.value = int(resetting)\n        if resetting:\n            rets.clear()\n            stores.clear()\n        if mutate:\n            mutate(cycle, imem, rets)\n        ia = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = imem.get(ia, EBREAK())\n        await Timer(1, \"ns\")\n        da = int(dut.io_dmemAddr.value)\n        wen = int(dut.io_dmemWEn.value)\n        ren = int(dut.io_dmemREn.value)\n        ir, dr = stalls(cycle, ia, da, wen, ren) if stalls else (1, 1)\n        dut.io_imemReady.value = ir\n        dut.io_dmemReady.value = dr\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        await Timer(4, \"ns\")\n\n        # Observe the accepting edge, after both buses and all interlocks\n        # have settled. Held EX instructions must neither recover nor train.\n        update = int(dut.predictor_update_en.value)\n        redirect = int(dut.redirect.value)\n        held_ex = int(dut.stall_ex_mem.value) or int(dut.div_wait.value)\n        if resetting or held_ex:\n            assert not update and not redirect, \"held\n…[13037 of 16109 chars elided by tools/bench/transcript.py; sha256:c1abca9c4c953781]…\n  assert len(stores) == 4 and dmem[8] == 101 and 4 not in dmem\n    assert len([u for u in events[\"updates\"] if u[1] in (12, 36)]) == 8\n    assert len([r for r in events[\"recoveries\"] if r[1] in (12, 36)]) == 3\n\n\n@cocotb.test()\nasync def predictor_reset_with_live_loop_entries(dut):\n    program = [ADDI(1, 0, 12), ADDI(1, 1, -1), BNE(1, 0, -4),\n               SW(1, 0, 0), EBREAK()]\n    rets, dmem, stores = await _run_checked(dut, program, reset_cycle=12)\n    assert [r[\"pc\"] for r in rets] == [0] + [4, 8] * 12 + [12, 16]\n    assert len(stores) == 1 and dmem[0] == 0\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"branch_predictor.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
