{"type": "item.completed", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,230p' cores/bench/test/test_branch_predictor.py\"", "aggregated_output": "\"\"\"Predictor policy checks through its lookup and accepted-update ports.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\n\n\nasync def _edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.lookup_pc.value = 0\n    dut.update_en.value = 0\n    dut.update_pc.value = 0\n    dut.update_branch.value = 0\n    dut.update_jump.value = 0\n    dut.update_legal.value = 0\n    dut.update_taken.value = 0\n    dut.update_target.value = 0\n    await _edge(dut)\n    dut.reset.value = 0\n\n\nasync def _lookup(dut, pc, taken, target=None):\n    dut.lookup_pc.value = pc\n    await Timer(1, \"ns\")\n    assert int(dut.predicted_taken.value) == taken, f\"lookup {pc:#x} direction\"\n    if target is not None:\n        assert int(dut.predicted_target.value) == target, f\"lookup {pc:#x} target\"\n\n\nasync def _update(dut, pc, target, taken=1, branch=1, jump=0, legal=1, enabled=1):\n    dut.update_en.value = enabled\n    dut.update_pc.value = pc\n    dut.update_target.value = target\n    dut.update_taken.value = taken\n    dut.update_branch.value = branch\n    dut.update_jump.value = jump\n    dut.update_legal.value = legal\n    await _edge(dut)\n    dut.update_en.value = 0\n\n\n@cocotb.test()\nasync def conditional_saturation_replacement_and_kind_change(dut):\n    await _reset(dut)\n    pc, target = 0x184, 0x240\n    await _lookup(dut, pc, 0)\n    # New not-taken row starts 01; both saturation endpoints are exercised.\n    outcomes = [0, 1, 1, 0, 0, 0, 0, 1, 1]\n    predictions = [0, 1, 1, 1, 0, 0, 0, 0, 1]\n    for outcome, prediction in zip(outcomes, predictions):\n        await _update(dut, pc, target, taken=outcome)\n        await _lookup(dut, pc, prediction, target)\n    await _update(dut, pc + 4, target, taken=1)\n    await _lookup(dut, pc + 4, 1, target)\n    await _update(dut, pc + 4, target, taken=0)\n    await _lookup(dut, pc + 4, 0, target)\n    await _update(dut, pc, target, taken=1)\n    await _update(dut, pc\n…[1894 of 4966 chars elided by tools/bench/transcript.py; sha256:8a6f073d5a5ae95d]…\nndex, branch=0, jump=1)\n    for index in range(64):\n        await _lookup(dut, 0x400 + 4 * index, 1, 0x1000 + 4 * index)\n    # With lookup and write at the same index, old state is visible before\n    # the edge, and the replacement becomes visible only after the edge.\n    pc = 0x424\n    await _lookup(dut, pc, 1, 0x1024)\n    dut.update_en.value = 1\n    dut.update_pc.value = pc\n    dut.update_target.value = 0x2000\n    dut.update_branch.value = 0\n    dut.update_jump.value = 1\n    dut.update_legal.value = 1\n    await _lookup(dut, pc, 1, 0x1024)\n    await _edge(dut)\n    await _lookup(dut, pc, 1, 0x2000)\n    # Reset wins over a simultaneous update and clears all 64 valid bits.\n    dut.reset.value = 1\n    await _edge(dut)\n    dut.reset.value = 0\n    dut.update_en.value = 0\n    for index in range(64):\n        await _lookup(dut, 0x400 + 4 * index, 0, 0)\n\n\ndef test_branch_predictor_runner():\n    run_cocotb(toplevel=\"branch_predictor\", sources=[\"branch_predictor.sv\"],\n               test_module=\"test_branch_predictor\")\n", "exit_code": 0, "status": "completed"}}
