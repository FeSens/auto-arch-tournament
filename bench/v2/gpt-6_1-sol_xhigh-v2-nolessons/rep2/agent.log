st our rtl/*.sv + wrapper.sv + checks.cfg) and runs the\n~45 I-base / M-ext insn checks plus reg / pc_fwd / pc_bwd / causal /\nunique / cover / ill / liveness — 53 total against the V0 baseline.\n\nIf genchecks.py crashes mid-run and only emits one .sby task that\nvacuously passes, the old `passed > 0 and failed == 0` rule would\nreturn success. EXPECTED_MIN_CHECKS prevents that.\n\"\"\"\nimport os, shutil, subprocess, json, re, uuid\nfrom pathlib import Pat\n…[12482 of 15554 chars elided by tools/bench/transcript.py; sha256:0febff7db17bff72]…\nrep2/formal/riscv-formal/.agents\"},\"access\":\"read\",\"missing_path_behavior\":\"skip\"},{\"path\":{\"type\":\"path\",\"path\":\"/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep2/formal/riscv-formal/.codex\"},\"access\":\"read\",\"missing_path_behavior\":\"skip\"},{\"path\":{\"type\":\"path\",\"path\":\"/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep2/formal/riscv-formal/.aws\"},\"access\":\"read\",\"missing_path_behavior\":\"skip\"}]},\"network\":\"restricted\"} --apply-seccomp-then-exec -- /bin/bash -c cat formal/checks_si.cfg; sed -n '1,190p' tools/eval/formal.py; rg -n 'reg_ch0|ERROR|FAIL|Formal:' cores/bench/generated/formal-check.log | tail -18; ps -eo pid,etime,pcpu,args | rg 'yosys-smtbmc|bitwuzla|formal/run_all'\n      2       00:00  0.0 /bin/bash -c cat formal/checks_si.cfg; sed -n '1,190p' tools/eval/formal.py; rg -n 'reg_ch0|ERROR|FAIL|Formal:' cores/bench/generated/formal-check.log | tail -18; ps -eo pid,etime,pcpu,args | rg 'yosys-smtbmc|bitwuzla|formal/run_all'\n      8       00:00  0.0 rg yosys-smtbmc|bitwuzla|formal/run_all\n", "exit_code": 0, "status": "completed"}}
