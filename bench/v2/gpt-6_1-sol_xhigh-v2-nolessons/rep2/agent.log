{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/r10s1_probe/test/test_alu.py');s=p.read_text();anchor='async def _check(dut, op, a, b, expected):';s=s.replace(anchor,'''def _actual(dut):\n    op = int(dut.op.value)\n    if op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        return (int(dut.product.value) >> (0 if op == ALU_MUL else 32)) & MASK32\n    return int(dut.out.value)\n\n\n'''+anchor);s=s.replace('int(dut.out.value)','_actual(dut)');s=s.replace('    return _actual(dut)','    return int(dut.out.value)');p.write_text(s)\np=Path('cores/bench/generated/r10s1_probe/test/test_pipeline.py');s=p.read_text();i=s.index('async def id_youngest_writer_and_consecutive_multiply');j=s.index('@cocotb.test()',i+10);a=s[i:j];a=a.replace('assert all(b[\\\"cycle\\\"] == a[\\\"cycle\\\"] + 1 for a, b in zip(rets, rets[1:]))','''for older, younger in zip(rets, rets[1:]):\n                insn = older[\\\"insn\\\"]\n                mul = insn & 0x7f == 0x33 and insn >> 25 == 1 and (insn >> 12) & 7 < 4\n                rd = (insn >> 7) & 31\n                dep = mul and rd \"'!= 0 and rd in ((younger[\"insn\"] >> 15) & 31, (younger[\"insn\"] >> 20) & 31)\n                assert younger[\"cycle\"] == older[\"cycle\"] + 1 + int(dep)'\"''');s=s[:i]+a+s[j:];p.write_text(s)\nPY\npytest -q cores/bench/generated/r10s1_probe/test/test_alu.py cores/bench/generated/r10s1_probe/test/test_pipeline.py > cores/bench/generated/r10s1_probe/unit_result_v2.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
