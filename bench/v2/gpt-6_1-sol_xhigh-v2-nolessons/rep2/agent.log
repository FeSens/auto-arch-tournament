rets:\n            assert not r['\"'trap']\n            if r['pc'] in expected:\n                got=(r['rs1_rdata'],r['rs2_rdata'],r['pc_next'])\n                assert got==expected[r['pc']],(r,expected[r['pc']])\n                seen[r['pc']]=got\n        assert seen==expected\n        assert len(stores)==store_count\n'''\np.write_text(s)\nprint('Added boundary and random branch coverage in temporary prototype')\nPY\npytest --confcutdir=/srv/hwebench/tmp/3d673a88/38c2edcd/branch_compare/test --rootdir=/srv/hwebench/tmp/3d673a88/38c2edcd/branch_compare -p no:cacheprovider -q /srv/hwebench/tmp/3d673a88/38c2edcd/branch_compare/test/test_pipeline.py > /srv/hwebench/tmp/3d673a88/38c2edcd/branch_compare/pipeline_extended.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
