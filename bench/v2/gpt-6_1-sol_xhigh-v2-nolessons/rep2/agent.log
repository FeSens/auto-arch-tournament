{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nr=Path.cwd();p=r/'cores/bench/generated/r12_fetch1';rtl=p/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor f in (r/'cores/bench/generated/r12_fetch2/rtl').glob('*.sv'):shutil.copyfile(f,rtl/f.name)\n(rtl/'if_stage.sv').write_text('''module if_stage (\n  input logic clock,reset,imem_ready,consume,redirect,\n  input logic [31:0] redirect_target,\n  input logic predicted_taken,\n  input logic [31:0] predicted_target,\n  output logic [31:0] imem_addr,\n  input logic [31:0] imem_data,\n  output if_id_t out\n);\n  logic [31:0] pc;\n  logic occupied_q;\n  if_id_t saved_q,incoming;\n  wire [31:0] next_pc=predicted_taken ? predicted_target : pc+32'd4;\n  wire fill=\"'!reset && !redirect && imem_ready && (!occupied_q || consume);\n  wire enqueue=fill && (occupied_q || !consume);\n  always_comb begin\n    incoming.pc=pc;\n    incoming.instr=imem_ready ? imem_data : 32'\"'h13;\n    incoming.predicted_taken=imem_ready && predicted_taken;\n    incoming.predicted_target=imem_ready ? next_pc : 0;\n    incoming.valid=imem_ready;\n    out=occupied_q ? saved_q : incoming;\n  end\n  always_ff @(posedge clock) if(enqueue) saved_q<=incoming;\n  always_ff @(posedge clock) begin\n    if(reset) begin pc<=0;occupied_q<=0; end\n    else if(redirect) begin pc<=redirect_target;occupied_q<=0; end\n    else begin\n      if(fill) pc<=next_pc;\n      if(enqueue) occupied_q<=1;\n      else if(consume) occupied_q<=0;\n    end\n  end\n  assign imem_addr=pc;\nendmodule\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
