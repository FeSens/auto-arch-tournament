{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/hazard_unit.sv; git status --short'", "aggregated_output": "// rtl/hazard_unit.sv\n//\n// Interlocks load-use, memory backpressure and pending EX division.\n// A LOAD in EX produces its data only after MEM,\n// so an instruction immediately behind that consumes the LOAD's rd\n// must be stalled by exactly one cycle.\n//\n// Outputs:\n//   stall_if / stall_id : freeze the PC reg and the IF/ID combinational\n//                          payload (cleared by ID's flush input).\n//   flush_if            : mask unavailable instruction-memory data only.\n//   flush_id            : on registered MEM recovery, kill younger ID/EX.\n//   flush_id            : also kills ID's own register on load-use to\n//                          inject a single-cycle bubble between LOAD\n//                          and the dependent instruction.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a (governs validity of subsequent retirements).\nmodule hazard_unit (\n  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n  input  logic       redirect,          // accepted EX/MEM prediction recovery\n  input  logic       div_wait,          // hold the division in ID/EX\n  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n  // random ~22% stall in vex_main.cpp). When low, the corresponding\n  // memory request is NOT serviced this cycle.\n  input  logic       imem_ready,\n  input  logic       dmem_ready,\n  // EX/MEM has an actual data request. Trapping misaligned accesses\n  // have no bus request and therefore do not wait for dmem_ready.\n  input  logic       ex_mem_mem_op,\n  output logic       stall_if,          // PC reg holds\n  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n  output logic       flush_if,          // IF/ID comb output -> NOP\n  output logic       flush_id,          // ID/EX register captures '0\n  output logic\n…[1155 of 4227 chars elided by tools/bench/transcript.py; sha256:a2ad716eda015d93]…\nise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n  assign stall_id      = dmem_stall || (!redirect && (load_use_hazard || div_wait));\n    // Recovery is qualified by older MEM acceptance and overrides all\n    // younger load-use/division holds. EX separately kills its result.\n  assign flush_id      = redirect || (load_use_hazard && !dmem_stall && !div_wait);\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n  assign stall_ex_mem  = dmem_stall;\n    // MEM/WB clears valid on dmem_stall to avoid repeating retirement.\n    // ID/EX holds finalized operands without refreshing from MEM or WB.\n  assign hold_mem_wb   = dmem_stall;\n\nendmodule\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_pipeline.py\n", "exit_code": 0, "status": "completed"}}
