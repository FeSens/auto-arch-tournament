{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hyp_r5s0_mul_inputs/test/test_pipeline.py')\ns=p.read_text()\ns += '''\n\n@cocotb.test()\nasync def prepared_multiply_signs_forwarding_and_holds(dut):\n    \\\"\\\"\\\"Prepared extension bits must follow youngest source values and holds.\\\"\\\"\\\"\n    def m(op, rd, rs1, rs2):\n        return _r(1, rs2, rs1, op, rd, 0x33)\n    def signed(x):\n        return x if x < 0x80000000 else x - 0x100000000\n    def stalls(cycle, ia, da, wen, ren):\n        return (int(cycle % 7 \"'!= 2), int(cycle % 5 not in (1, 2)))\n    for a,b in ((0x80000000,0xffffffff),(0xffffffff,0xffffffff),\n                (0x7fffffff,0x80000000),(0x80000001,0x7fffffff)):\n        program = [ADDI(10,0,0x100),LW(1,10,0),LW(2,10,4),\n                   ADDI(1,0,1),LW(1,10,0),\n                   m(1,3,1,2),m(2,4,1,2),m(3,5,1,2),m(0,6,1,2),\n                   SW(3,10,8),SW(4,10,12),SW(5,10,16),SW(6,10,20),\n                   ADDI(2,0,-1),m(1,7,1,2),m(2,8,1,2),\n                   m(3,9,1,2),m(0,11,1,2),m(1,12,0,2),EBREAK()]\n        rets,mem,stores=await _run_checked(dut,program,{0x100:a,0x104:b},\n                                           stalls=stalls,poison_unready=True)\n        expected={3:(signed(a)*signed(b))>>32,4:(signed(a)*b)>>32,\n                  5:(a*b)>>32,6:a*b,\n                  7:(signed(a)*-1)>>32,8:(signed(a)*0xffffffff)>>32,\n                  9:(a*0xffffffff)>>32,11:a*0xffffffff,12:0}\n        for rd,value in expected.items():\n            assert [r['\"'rd_wdata'] for r in rets if r['rd']==rd]==[value&0xffffffff]\n        assert len(stores)==4\n        for offset,rd in ((8,3),(12,4),(16,5),(20,6)):\n            assert mem[0x100+offset]==expected[rd]&0xffffffff\n'''\np.write_text(s)\np=Path('cores/bench/generated/hyp_r5s0_mul_inputs/test/test_alu.py')\ns=p.read_text()\ns += '''\n\n@cocotb.test()\nasync def prepared_multiplier_port_isolation(dut):\n    await _setup(dut)\n    dut.mul_a.value=(1<<33)-3\n    dut.mul_b.value=0xffffffff\n    for op,want in ((ALU_MUL,3),(ALU_MULH,0xfffffffd),\n                    (ALU_MULHU,0xfffffffd),(ALU_MULHSU,0xfffffffd)):\n        dut.op.value=op\n        for a,b in ((0,0),(0xabcdef01,0x55555555),(0xffffffff,1)):\n            dut.a.value=a\n            dut.b.value=b\n            await Timer(1,'ns')\n            assert int(dut.out.value)==want\n    dut.op.value=ALU_ADD\n    dut.a.value=0x12345678\n    dut.b.value=0x22222222\n    for a,b in ((0,0),((1<<33)-1,(1<<33)-1),(0x80000000,0xffffffff)):\n        dut.mul_a.value=a\n        dut.mul_b.value=b\n        await Timer(1,'ns')\n        assert int(dut.out.value)==0x3456789a\n'''\np.write_text(s)\nprint('Added isolated forwarding/hold and multiplier port-isolation checks')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
