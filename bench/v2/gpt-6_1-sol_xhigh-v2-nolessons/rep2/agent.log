   build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"Runs Verilator cosim for all bench ELFs. Returns structured pass/fail.\n\nCorrectness is gated in two stages:\n  1. Full RVFI trace cosim for selftest and any other small ELF — ever\n…[22005 of 25077 chars elided by tools/bench/transcript.py; sha256:8a27fdb6a4a2cae2]…\nled in (False, True):\n        rng = random.Random(0xB4A7)\n        holds = 0\n        def stalls(cycle, ia, da, wen, ren):\n            nonlocal holds\n            ir, dr = rng.random() >= .22, rng.random() >= .22\n            if wen and da == 0x1008 and holds < 12:\n                holds += 1\n                dr = False\n            return ir, dr\n        events = {}\n        rets, _, stores = await _run_checked(\n            dut, program, initial, stalls if stalled else None,\n            max_cycles=5 * len(program), events=events, poison_unready=True)\n        assert [r[\"pc\"] for r in rets] == expected_pcs\n        assert not any(r[\"trap\"] for r in rets)\n        for r in rets:\n            if r[\"pc\"] in branches:\n                a, b, taken = branches[r[\"pc\"]]\n                assert (r[\"rs1_addr\"], r[\"rs2_addr\"]) == (1, 2), r\n                assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"]) == (a, b), r\n                assert r[\"pc_next\"] == r[\"pc\"] + (8 if taken else 4), r\n        updates = [u for u in events[\"updates\"] if u[2]]\n", "exit_code": 0, "status": "completed"}}
