{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport struct\nfrom pathlib import Path\nfrom collections import Counter\nraw=Path('/srv/hwebench/tmp/3d673a88/01ab618d/predictor_trace.bin').read_bytes()\ntrace=list(struct.iter_unpack('<IIIB',raw))\ndata=[]\nfor pc,insn,nxt,m in trace:\n op=insn&127; jump=op\"'!=99; taken=jump or nxt!=pc+4\n if jump: target=nxt\n else:\n  imm=((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1)\n  if imm&4096: imm-=8192\n  target=(pc+imm)&0xffffffff\n data.append((pc,insn,jump,taken,target,m))\n\ndef simulate(name,n,shift=None,ras=False,gshare=None,local=None):\n tab=[None]*n; misses=Counter(); history=0; pht=[1]*(1<<gshare) if gshare else None\n histories={}; lct={} if local else None; stack=[]; executed=0; misspcs=Counter()\n for pc,insn,jump,taken,target,m in data:\n  idx=(pc>>2)&(n-1)\n  if shift is not None: idx''^=(pc>>shift)&(n-1)\n  row=tab[idx]; hit=row is not None and row[0]==pc\n  pred=hit and (row[2] or row[3]>=2)\n  pt=row[1] if hit else 0\n  if gshare:\n   pi=((pc>>2)''^history)&((1<<gshare)-1)\n   if hit and not row[2]: pred=pht[pi]>=2\n  if local:\n   h=histories.get(pc,0); pi=(pc,h)\n   if hit and not row[2]: pred=lct.get(pi,1)>=2\n  op=insn&127; rd=(insn>>7)&31; rs1=(insn>>15)&31\n  ret=op==103 and rs1 in (1,5) and rd not in (1,5) and (insn>>20)==0\n  call=op in (103,111) and rd in (1,5)\n  if ras and hit and ret and stack: pred=True; pt=stack[-1]\n  wrong=(bool(pred)!=taken) or (pred and taken and pt!=target)\n  if m:\n   executed+=1\n   if wrong:\n    k='\"'target' if pred and taken else ('cold/conflict' if not hit else 'direction')\n    misses[k]+=1; misspcs[pc]+=1\n    misses['jump' if jump else 'branch']+=1\n  if ras:\n   if ret and stack: stack.pop()\n   if call: stack.append(pc+4); stack=stack[-8:]\n  if gshare and not jump:\n   pht[pi]=min(3,pht[pi]+1) if taken else max(0,pht[pi]-1)\n   history=((history<<1)|taken)&((1<<gshare)-1)\n  if local and not jump:\n   c=lct.get(pi,1); lct[pi]=min(3,c+1) if taken else max(0,c-1)\n   histories[pc]=((h<<1)|taken)&((1<<local)-1)\n  if hit and not row[2]: c=min(3,row[3]+1) if taken else max(0,row[3]-1)\n  else: c=2 if taken else 1\n  tab[idx]=(pc,target,jump,2 if jump else c)\n print(name,'events',executed,'mispred',misses['branch']+misses['jump'],dict(misses))\n return misses,misspcs\nbaseline,pcs=simulate('baseline',64)\nfor shift in (6,7,8,9,10,11,12,13,14): simulate('hash'+str(shift),64,shift)\nfor n in (128,256,512): simulate('capacity'+str(n),n)\nsimulate('RAS8',64,ras=True)\nfor g in (4,6,8,9,10): simulate('gshare'+str(g),64,gshare=g)\nfor l in (2,3,4,6,8): simulate('ideal-local'+str(l),64,local=l)\nprint('Hot baseline mispredicted PCs:',[(hex(pc),n) for pc,n in pcs.most_common(16)])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
