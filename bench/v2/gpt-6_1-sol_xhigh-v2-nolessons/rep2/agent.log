{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv cores/bench/test/test_alu.py'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM ALU: base arithmetic and multiplication remain combinational;\n// division uses a shared clocked restoring unit with sticky completion.\n//\n// RV32IM division semantics (overridden from straight `signed /`):\n//   DIV  by 0       -> -1   (all ones)\n//   DIVU by 0       -> 0xFFFFFFFF\n//   DIV  INT_MIN/-1 -> INT_MIN  (no trap, defined overflow)\n//   REM  by 0       -> dividend\n//   REMU by 0       -> dividend\n//   REM  INT_MIN/-1 -> 0\n//\n// Latency:        combinational except DIV/DIVU/REM/REMU (bounded multi-cycle).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input  logic       clock,\n  input  logic       reset,\n  input  logic       div_start,\n  input  logic       div_consume,\n  output logic       div_busy,\n  output logic       div_done,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n  logic [31:0] div_result;\n  divider u_divider (\n    .clock(clock), .reset(reset), .start(div_start), .consume(div_consume),\n    .op(op), .a(a), .b(b), .busy(div_busy), .done(div_done), .result(div_result)\n  );\n\n`ifndef RISCV_FORMAL_ALTOPS\n  // A signed 33-bit operand represents both signed and unsigned RV32\n  // values exactly. Share one native multiplier across all four variants.\n  logic sign_a, sign_b;\n  logic signed [32:0] mul_a, mul_b;\n  // Only the low 64 product bits are part of an RV32M result.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] mul_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  assign sign_a = (op == ALU_MULH || op == ALU_MULHSU);\n  assign sign_b = (op == ALU_MULH);\n  assign mul_a = $signed({sign_a && a[31], a});\n  assign mul_b = $signed({sign_b && b[31], b});\n  assign mul_product = mul_a * mul_b;\n`endif\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n\n…[13061 of 16133 chars elided by tools/bench/transcript.py; sha256:3217f4a7400265d9]…\nt.div_consume.value = 1\n    await _tick(dut)\n    dut.div_consume.value = 0\n    await _check_div(dut, ALU_REM, (-101) & MASK32, 7, (-3) & MASK32)\n\n\n@cocotb.test()\nasync def divider_reset_cancels_work(dut):\n    await _setup(dut)\n    for reset_cycle in (0, 10, 33, 34):\n        dut.op.value = ALU_DIVU\n        dut.a.value = MASK32\n        dut.b.value = 3\n        dut.div_start.value = 1\n        await _tick(dut)\n        dut.div_start.value = 0\n        for _ in range(reset_cycle):\n            await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(40):\n            await _tick(dut)\n            assert not int(dut.div_busy.value)\n            assert not int(dut.div_done.value)\n        await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
