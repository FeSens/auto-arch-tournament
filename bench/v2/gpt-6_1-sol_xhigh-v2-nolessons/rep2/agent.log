{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic and multiplication are combinational. Division uses a\nclocked request/completion/consume handshake and bounded real arithmetic.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nMASK64 = 0xFFFFFFFFFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_start.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.mul_a.value = 0\n    dut.mul_b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_done.value)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\ndef _drive_mul(dut, op, a, b):\n    \"\"\"Format the dedicated operands exactly as the ID/EX capture does.\"\"\"\n    a, b = a & MASK32, b & MASK32\n    dut.mul_a.value = a | (int(op in (ALU_MULH, ALU_MULHSU) and a >> 31) << 32)\n    dut.mul_b.value = b | (int(op == ALU_MULH and b >> 31) << 32)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive ordinary and formatted operands and check the result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    _drive_mul(dut, op, a, b)\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    await _tick(dut)\n    d\n…[15393 of 18465 chars elided by tools/bench/transcript.py; sha256:c3bc072ed69ff4ae]…\n    dut.div_consume.value = 0\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_alu_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, SIM_BUILD, TEST_DIR\n\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[str(RTL / source) for source in (\"core_pkg.sv\", \"divider.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n        build_args=[\"-Wall\", \"-Wno-style\", \"-DRISCV_FORMAL_ALTOPS\"],\n    )\n    runner.test(\n        hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), test_filter=\"altops_uses_ordinary_operands$\",\n        extra_env={\"ALU_ALTOPS\": \"1\"},\n        results_xml=str(TEST_DIR / \"alu_altops.result.xml\"),\n    )\n", "exit_code": 0, "status": "completed"}}
