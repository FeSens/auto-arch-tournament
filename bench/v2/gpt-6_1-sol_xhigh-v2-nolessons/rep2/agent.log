{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/generated/r7s1_probe/rtl')\nfor name,bits in [('fold4',2),('fold2',1)]:\n root=Path('cores/bench/generated/r7s1_'+name)\n shutil.copytree(src,root/'rtl',dirs_exist_ok=True)\n banks=2**bits\n rows=32//banks\n rb=5-bits\n code='''module reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output wire [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  logic [31:0] written_q;\n  wire bypass1 = w_en && w_addr == rs1_addr && rs1_addr \"'!= 5'\"'b0;\n  wire bypass2 = w_en && w_addr == rs2_addr && rs2_addr \"'!= 5'\"'b0;\n  wire [31:0] rs1_terms [0:BANKS-1];\n  wire [31:0] rs2_terms [0:BANKS-1];\n  for (genvar b=0; b<BANKS; b++) begin : g_bank\n    localparam logic [BITS-1:0] BANK = BITS'(b);\n    logic [31:0] words1 [0:ROWS-1];\n    logic [31:0] words2 [0:ROWS-1];\n    wire [ROWS-1:0] valid_bits = written_q[b*ROWS +: ROWS];\n    wire select1 = rs1_addr[4:RB] == BANK && valid_bits[rs1_addr[RB-1:0]] && \"'!bypass1;\n    wire select2 = rs2_addr[4:RB] == BANK && valid_bits[rs2_addr[RB-1:0]] && !bypass2;\n    always_ff @(posedge clock) begin\n      if (!reset && w_en && w_addr != 5'\"'b0 && w_addr[4:RB] == BANK) begin\n        words1[w_addr[RB-1:0]] <= w_data;\n        words2[w_addr[RB-1:0]] <= w_data;\n      end\n    end\n    assign rs1_terms[b] = words1[rs1_addr[RB-1:0]] & {32{select1}};\n    assign rs2_terms[b] = words2[rs2_addr[RB-1:0]] & {32{select2}};\n  end\n  always_ff @(posedge clock) begin\n    if (reset) written_q <= 32'b0;\n    else if (w_en && w_addr \"'!= 5'\"'b0) written_q[w_addr] <= 1'b1;\n  end\n  assign rs1_data = REDUCE1 | (w_data & {32{bypass1}});\n  assign rs2_data = REDUCE2 | (w_data & {32{bypass2}});\nendmodule\n'''\n for a,b in [('BANKS',str(banks)),('BITS',str(bits)),('ROWS',str(rows)),