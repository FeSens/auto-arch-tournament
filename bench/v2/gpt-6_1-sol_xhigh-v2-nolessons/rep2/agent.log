      await _update(dut, pc, target, taken=outcome)\n        await _lookup(dut, pc, prediction, target)\n    await _update(dut, pc + 4, target, taken=1)\n    await _lookup(dut, pc + 4, 1, target)\n    await _update(dut, pc + 4, target, taken=0)\n    await _lookup(dut, pc + 4, 0, target)\n    await _update(dut, pc, target, taken=1)\n    await _update(dut, pc\n…[15016 of 18088 chars elided by tools/bench/transcript.py; sha256:398f160164834fa8]…\nectural_regs[addr], r\n            if r[\"rd\"]:\n                architectural_regs[r[\"rd\"]] = r[\"rd_wdata\"]\n            if rets:\n                assert rets[-1][\"pc_next\"] == r[\"pc\"], (rets[-1], r)\n            rets.append(r)\n            if r[\"insn\"] == EBREAK():\n                # Every accepted store must correspond to one retirement.\n                retired_stores = [(r[\"mem_addr\"], r[\"mem_wdata\"], r[\"mem_wmask\"])\n                                  for r in rets if r[\"mem_wmask\"]]\n                assert [(a & ~3, v, m) for _, a, v, m in stores] == retired_stores\n                return rets, dmem, stores\n\n        if wen and dr and not resetting:\n            value = int(dut.io_dmemWData.value)\n            stores.append((cycle, da, value, wen))\n            old = dmem.get(da & ~3, 0)\n            for byte in range(4):\n                if wen & (1 << byte):\n                    mask = 0xff << (8 * byte)\n                    old = (old & ~mask) | (value & mask)\n            dmem[da & ~3] = old\n        dut.clock.value = 1\n", "exit_code": 0, "status": "completed"}}
