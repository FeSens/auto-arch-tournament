and not dr\n                                 else dmem.get(da & ~3, 0))\n        await Timer(4, \"ns\")\n\n        # Observe the accepting edge, after both buses and all interlocks\n        # have settled. Held EX instructions must neither recover nor train.\n        update = int(dut.predictor_update\n…[5170 of 8242 chars elided by tools/bench/transcript.py; sha256:6a6a32d9b5c5dc7b]…\nbyte)\n                    old = (old & ~mask) | (value & mask)\n            dmem[da & ~3] = old\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        if resetting or flushed_id:\n            assert int(dut.id_ex_w.value) == 0, \"flush left younger control/metadata\"\n        elif held_id:\n            assert int(dut.id_ex_w.value) == old_bundle, \"ID hold changed its bundle\"\n        if held_mem and not resetting:\n            request = tuple(int(getattr(dut, name).value) for name in (\n                \"io_dmemAddr\", \"io_dmemWData\", \"io_dmemWEn\", \"io_dmemREn\"))\n            assert request == old_request, \"unaccepted memory request changed\"\n        if not resetting:\n            expected_pc = recovery_pc if redirect else old_pc if held_if else predicted_pc\n            assert int(dut.io_imemAddr.value) == expected_pc, \"fetch/recovery PC priority\"\n    raise AssertionError(f\"no forward progress after {max_cycles} cycles: {rets[-3:]}\")\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n", "exit_code": 0, "status": "completed"}}
