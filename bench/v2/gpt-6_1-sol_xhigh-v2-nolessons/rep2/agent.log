1_val_6_s0\",\n          \"to\": \"cpu/u_ex/u_alu/mul_product_65_s1\",\n          \"slack_ns\": -7.889,\n          \"arrival_ns\": 17.963,\n          \"logic_cells\": 31,\n          \"modules\": [\n            \"clock_ibuf\",\n            \"cpu/u_ex\",\n            \"cpu/u_predictor\",\n            \"cpu/u_id\"\n          ]\n        },\n        {\n          \"from\": \"dmem_3_dmem_3_0_0_s\",\n          \"to\": \"cpu/u_ex/u_alu/mul_product_65_s1\",\n          \"slack_ns\": -7.872,\n          \"arrival_ns\": 17.978,\n          \"logic_cells\": 9,\n          \"modules\": [\n            \"clock_ibuf\",\n            \"cpu/u_mem\",\n            \"cpu/u_id\"\n          ]\n        }\n      ]\n    },\n    {\n      \"place_option\": 1,\n      \"placement_failed\": false,\n      \"fmax_mhz\": 79.944,\n      \"levels\":\n…[3322 of 6394 chars elided by tools/bench/transcript.py; sha256:6fdb6c525b37b9da]…\n: \"cpu/u_predictor/counter_q_counter_q_RAMREG_28_G[0]_s1\",\n          \"slack_ns\": -7.46,\n          \"arrival_ns\": 17.754,\n          \"logic_cells\": 11,\n          \"modules\": [\n            \"clock_ibuf\",\n            \"cpu/u_predictor\"\n          ]\n        }\n      ]\n    }\n  ],\n  \"summary\": {\n    \"placement_failed\": false,\n    \"fmax_mhz\": 79.944,\n    \"seeds\": [\n      77.544,\n      79.944,\n      79.944\n    ],\n    \"perturbations\": [\n      [\n        0,\n        77.544,\n        12\n      ],\n      [\n        1,\n        79.944,\n        12\n      ],\n      [\n        2,\n        79.944,\n        12\n      ]\n    ],\n    \"lut4\": 5057,\n    \"ff\": 2052,\n    \"lutram\": 32,\n    \"bsram\": 5,\n    \"dsp\": 2,\n    \"logic_levels\": 12,\n    \"critical_path\": {\n      \"from\": \"cpu/u_id/reg_q.rs1_val_6_s0\",\n      \"to\": \"cpu/u_ex/u_alu/mul_product_65_s1\",\n      \"slack_ns\": -7.896,\n      \"arrival_ns\": 18.001,\n      \"logic_cells\": 32,\n      \"modules\": [\n        \"clock_ibuf\",\n        \"cpu/u_ex\",\n        \"cpu/u_predictor\