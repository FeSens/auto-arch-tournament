{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/3d673a88/1602ad9d')\nfor name in ('alu_compare','alu_shift','alu_operands'):\n p=root/name\n shutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\n if name=='alu_compare':\n  f=p/'rtl/alu.sv';s=f.read_text()\n  marker='  always_comb begin\\\\n    shamt'\n  logic='''  wire [15:1] compare_lt, compare_eq;\n  wire signed_lt;\n  for (genvar g=0;g<8;g++) begin : g_compare_leaf\n    assign compare_lt[8+g] = a[4*g +: 4] < b[4*g +: 4];\n    assign compare_eq[8+g] = a[4*g +: 4] == b[4*g +: 4];\n  end\n  for (genvar g=1;g<8;g++) begin : g_compare_tree\n    assign compare_lt[g] = compare_lt[2*g+1] | (compare_eq[2*g+1] & compare_lt[2*g]);\n    assign compare_eq[g] = compare_eq[2*g+1] & compare_eq[2*g];\n  end\n  assign signed_lt = (a[31] \"'^ b[31]) ? a[31] : compare_lt[1];\n\n'\"'''\n  s=s.replace(marker,logic+marker).replace(\\\"{31'b0, \"'$signed(a) < $signed(b)}\",\"{31'\"'b0, signed_lt}\\\").replace(\\\"{31'b0, a < b}\\\",\\\"{31'b0, compare_lt[1]}\\\")\n  f.write_text(s)\n elif name=='alu_shift':\n  f=p/'rtl/alu.sv';s=f.read_text()\n  marker='  always_comb begin\\\\n    shamt'\n  logic='''  wire shift_left = (op == ALU_SLL);\n  wire arithmetic_shift = (op == ALU_SRA);\n  wire [31:0] reversed_a, shift_input, shift_right, shift_result;\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire signed [32:0] shift_extended;\n  wire signed [32:0] shifted_extended;\n  /* verilator lint_on UNUSEDSIGNAL */\n  for (genvar g=0;g<32;g++) begin : g_reverse\n    assign reversed_a[g] = a[31-g];\n    assign shift_result[g] = shift_left ? shift_right[31-g] : shift_right[g];\n  end\n  assign shift_input = shift_left ? reversed_a : a;\n  assign shift_extended = \"'$signed({arithmetic_shift && a[31],shift_input});\n  assign shifted_extended = shift_extended >>> b[4:0];\n  assign shift_right = shifted_extended[31:0];\n\n'\"'''\n  s=s.replace(marker,logic+marker)\n  s=s.replace('a << shamt','shift_result').replace('a >> shamt','shift_result').replace('\"'$unsigned($signed(a) >>> shamt)'\"','shift_result')\n  s=s.replace('  logic        [4:0]  shamt;','').replace('    shamt = b[4:0];','')\n  f.write_text(s)\n else:\n  f=p/'rtl/core_pkg.sv';s=f.read_text().replace('    logic [31:0] imm;','    logic [31:0] imm;\\\\n    logic [31:0] alu_a, alu_b;');f.write_text(s)\n  f=p/'rtl/id_stage.sv';s=f.read_text().replace('      reg_q.imm      <= imm;','''      reg_q.imm      <= imm;\n      reg_q.alu_a <= dec_is_auipc ? in.pc : rs1_final;\n      reg_q.alu_b <= dec_alu_src ? imm : rs2_final;''');f.write_text(s)\n  f=p/'rtl/ex_stage.sv';s=f.read_text().replace('alu_a = in.ctrl.is_auipc ? in.pc  : rs1;','alu_a = in.alu_a;').replace('alu_b = in.ctrl.alu_src  ? in.imm : rs2;','alu_b = in.alu_b;');f.write_text(s)\nprint('Prepared ALU comparator, shared shifter and operand mux timing experiments')\nPY\npython3 -u - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nroot=Path('/srv/hwebench/tmp/3d673a88/1602ad9d')\ndef run(name):\n p=root/name\n r=build(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',1,p/'timing_p1')\n (p/'timing.json').write_text(json.dumps(r,indent=2))\n print(name,json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=3) as pool:\n list(pool.map(run,('alu_compare','alu_shift','alu_operands')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
