{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/3d673a88/1602ad9d')\nfor width in (4,8):\n p=root/f'carry{width}_proto'\n shutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\n shutil.copytree('cores/bench/test',p/'test',dirs_exist_ok=True)\n alu=p/'rtl/alu.sv'\n s=alu.read_text()\n n=32//width\n helper='''module alu_block_add #(parameter integer WIDTH = %d) (\n  input wire [31:0] a, b,\n  input wire cin,\n  output wire [31:0] sum\n);\n  localparam integer GROUPS = 32 / WIDTH;\n  wire [WIDTH:0] local_sum [0:GROUPS-1];\n  wire [GROUPS-1:0] pg [0:\"'$clog2(GROUPS)];\n  wire [GROUPS-1:0] gg [0:$clog2(GROUPS)];\n  wire [GROUPS-1:0] carry;\n  for (genvar g=0; g<GROUPS; g++) begin : leaf\n    assign local_sum[g] = {1'\"'b0,a[g*WIDTH +: WIDTH]} + {1'b0,b[g*WIDTH +: WIDTH]};\n    assign gg[0][g] = local_sum[g][WIDTH];\n    assign pg[0][g] = &(a[g*WIDTH +: WIDTH] \"'^ b[g*WIDTH +: WIDTH]);\n    if (g==0) assign carry[g]=cin;\n    else assign carry[g] = gg[$clog2(GROUPS)][g-1] | (pg[$clog2(GROUPS)][g-1] & cin);\n    assign sum[g*WIDTH +: WIDTH] = local_sum[g][WIDTH-1:0] + {{(WIDTH-1){1'\"'b0}},carry[g]};\n  end\n  for (genvar l=0; l<\"'$clog2(GROUPS); l++) begin : level\n    for (genvar g=0;g<GROUPS;g++) begin : group_prefix\n      if (g >= (1<<l)) begin\n        assign gg[l+1][g] = gg[l][g] | (pg[l][g] & gg[l][g-(1<<l)]);\n        assign pg[l+1][g] = pg[l][g] & pg[l][g-(1<<l)];\n      end else begin\n        assign gg[l+1][g] = gg[l][g];\n        assign pg[l+1][g] = pg[l][g];\n      end\n    end\n  end\nendmodule\n'\"''' % width\n s=s.replace('  always_comb begin\\\\n    shamt',f'''  logic [31:0] add_result, sub_result;\n  alu_block_add u_add (.a(a),.b(b),.cin(1'b0),.sum(add_result));\n  alu_block_add u_sub (.a(a),.b(~b),.cin(1'b1),.sum(sub_result));\n\n  always_comb begin\n    shamt''')\n s=s.replace('ALU_ADD:    out = a + b;','ALU_ADD:    out = add_result;').replace('ALU_SUB:    out = a - b;','ALU_SUB:    out = sub_result;')\n alu.write_text(s+'\\\\n'+helper)\nprint('Prepared four- and eight-bit carry-prefix arithmetic prototypes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
