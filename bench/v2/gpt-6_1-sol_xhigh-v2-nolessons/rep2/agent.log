n = 1'b0;\n     predicted_target = 32'b0;\n     if (lookup_in_range && valid_q[lookup_index]) begin\n       if (tag_q[lookup_index] == lookup_pc[19:8]) begin\n         predicted_taken = jump_q[lookup_index] || counter_q[lookup_index][1];\n-        predicted_target = {12'b0, target_q[lookup_index], 2'b0};\n+        pr\n…[6221 of 9293 chars elided by tools/bench/transcript.py; sha256:80a3e84552b325f8]…\n for pc in pcs:\n+            await _update(dut, pc, 0x20000 + pc, branch=0, jump=1)\n+        dut.update_en.value = 1\n+        dut.update_pc.value = pending_pc + 0x100\n+        dut.update_target.value = 0xffffc\n+        dut.update_branch.value = 0\n+        dut.update_jump.value = 1\n+        dut.update_legal.value = 1\n+        dut.reset.value = 1\n+        # Reset is synchronous: the prior prediction survives until its edge.\n+        await _lookup(dut, pending_pc, 1, 0x20000 + pending_pc)\n+        await _edge(dut)\n+        dut.reset.value = 0\n+        dut.update_en.value = 0\n+        for pc in pcs:\n+            await _lookup(dut, pc, 0, 0)\n+            await _lookup(dut, pc + 0x100, 0, 0)\n+        # Deasserting reset without an update must not resurrect any entry.\n+        await _edge(dut)\n+        await _lookup(dut, pending_pc + 0x100, 0, 0)\n+\n+\n def test_branch_predictor_runner():\n     run_cocotb(toplevel=\"branch_predictor\", sources=[\"branch_predictor.sv\"],\n                test_module=\"test_branch_predictor\")\n", "exit_code": 0, "status": "completed"}}
