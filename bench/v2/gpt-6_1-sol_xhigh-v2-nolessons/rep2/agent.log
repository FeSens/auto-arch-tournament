on states if needed. Each recurrence\\nuses one 33-bit trial subtraction and a borrow-controlled selection, rather\\nthan a chain of 32 division stages. No synthesizable / or % operation may\\nremain in the normal hardware ALU or divider.\\n\\nAccept a request exactly once for a valid division instruction whe\n…[195778 of 198850 chars elided by tools/bench/transcript.py; sha256:04d3c75ce0754147]…\nn aliasing and prediction changes during every existing\\nfetch/load-use/dmem/division hold. Require exact captured predictions,\\nonce-only training, immediate recovery, forward progress, strict\\nretirement order and no wrong-path register or memory effects.\\n\"}], \"outcome\": \"regression\", \"fitness\": 174.22, \"delta_pct\": -10.31, \"vs_baseline\": 1337.46, \"fmax_mhz\": 73.211, \"ipc_coremark\": 2e-06, \"cycles\": 4202272, \"iterations\": 10, \"lut4\": 4588, \"ff\": 1921, \"seeds\": [77.775, 73.211, 73.211], \"perturbations\": [[0, 77.775, 11], [1, 73.211, 11], [2, 73.211, 11]], \"lutram\": 0, \"bsram\": 4, \"dsp\": 2, \"critical_path\": {\"from\": \"cpu/u_id/reg_q.ctrl.is_auipc_s0\", \"to\": \"cpu/u_ex/u_alu/mul_product_65_s1\", \"slack_ns\": -7.858, \"arrival_ns\": 17.932, \"logic_cells\": 11, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_id\"]}, \"logic_levels\": 11, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-10-05T06:57:34.686423Z\", \"slot\": 2, \"round_id\": 11}\n", "exit_code": 0, "status": "completed"}}
