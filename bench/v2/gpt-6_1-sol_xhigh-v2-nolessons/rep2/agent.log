n sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, write-first\nbypass, and the synchronous-reset-clears-all property.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom\n…[2391 of 5463 chars elided by tools/bench/transcript.py; sha256:e4b0c7eb7d9d49b4]…\n must not alias any pair of word indices.\"\"\"\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    values = [0] + [(0x9E3779B9 * r) & 0xFFFFFFFF for r in range(1, 32)]\n    for r in range(1, 32):\n        await _write(dut, r, values[r])\n        await Timer(1, \"ns\")\n    for a in range(32):\n        for b in range(32):\n            assert await _read(dut, a, b) == (values[a], values[b]), (a, b)\n\n    # Reset must clear populated storage, including when a write is pending.\n    dut.reset.value = 1\nGenerate file \"/srv/hwebench/tmp/3d673a88/e3e10f46/r14banks2/gowin_p1/impl/pnr/core_bench.rpt.txt\" completed\nGenerate file \"/srv/hwebench/tmp/3d673a88/e3e10f46/r14banks2/gowin_p1/impl/pnr/core_bench.tr.html\" completed\nGenerate file \"/srv/hwebench/tmp/3d673a88/e3e10f46/r14banks2/gowin_p1/impl/pnr/core_bench.tr\" completed\nMon Oct  5 10:38:42 2026\n\n[50%] Placement Phase 3 completed\nRunning routing......\n[60%] Routing Phase 0 completed\n[70%] Routing Phase 1 completed\n[80%] Routing Phase 2 completed\n", "exit_code": 0, "status": "completed"}}
