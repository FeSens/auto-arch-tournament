{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nroot=Path(os.environ['TMPDIR'])/'predictor_split_target'\nrtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv';s=p.read_text();needle='  // ID/EX register payload.';a,b=s.split(needle,1);b=b.replace('logic [31:0] imm;','logic [31:0] imm;\\\\n    logic [15:0] target_low;\\\\n    logic        target_carry;',1);p.write_text(a+needle+b)\np=rtl/'id_stage.sv';s=p.read_text().replace('  logic [31:0] imm;',\\\"  logic [31:0] imm;\\\\n  logic [16:0] target_low_sum;\\\\n  assign target_low_sum = {1'b0, in.pc[15:0]} + {1'b0, imm[15:0]};\\\")\ns=s.replace('reg_q.imm      <= imm;','reg_q.imm      <= imm;\\\\n      reg_q.target_low <= target_low_sum[15:0];\\\\n      reg_q.target_carry <= target_low_sum[16];');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text().replace('  logic [31:0] branch_target;',\\\"  logic [31:0] branch_target;\\\\n  logic [15:0] target_upper;\\\\n  assign target_upper = in.pc[31:16] + in.imm[31:16] + {15'b0, in.target_carry};\\\")\ns=s.replace('branch_target = in.pc + in.imm;','branch_target = {target_upper, in.target_low};').replace(': (in.pc + in.imm);',': branch_target;');p.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
