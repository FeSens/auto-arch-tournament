s/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep2/bench/programs/selftest.elf\n/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep2/bench/programs/coremark.elf\n/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep2/bench/programs/random2.elf\n/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep2/bench/programs/random1.elf\n/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep2/bench/programs/random3.elf\n","exit_code":0,"status":"completed"}}
