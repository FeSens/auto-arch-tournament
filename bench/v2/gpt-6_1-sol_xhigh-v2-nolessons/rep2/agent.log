{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,240p' tools/eval/gowin.py\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[7281 of 10353 chars elided by tools/bench/transcript.py; sha256:1263a0fc72d8086b]…\n:\n            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\n            continue\n        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\n              f\"logic {r['logic']}, registers {r['regs']}, LUT-RAM {r['lutram']}, BSRAM {r['bsram']}, DSP {r['dsp']}\")\n        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\n            print(f\"  path {i}: {p['arrival_ns']} ns, {p['logic_cells']} cells, {p['from']} -> {p['to']}\")\n            print(f\"          through: {' > '.join(p['modules'])}\")\n        print(f\"  full report: {tr}\")\n    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/3d673a88/21c2222a/carry-probe')\nroot.mkdir(parents=True,exist_ok=True)\nhelper='''\n// Explicit eight-nibble carry prefix; arithmetic is modulo 2\"'^32.\nmodule execute_sum32 (\n  input wire [31:0] x, y,\n  input wire cin,\n  output wire [31:0] sum\n);\n  wire [31:0] p = x ''^ y;\n  wire [31:0] g = x & y;\n  wire [7:0] gp [0:3];\n  wire [7:0] gg [0:3];\n  wire [7:0] carry;\n  for (genvar k=0; k<8; k++) begin : group_init\n    assign gp[0][k] = &p[4*k +: 4];\n    assign gg[0][k] = g[4*k+3] | (p[4*k+3]&g[4*k+2])\n      | (p[4*k+3]&p[4*k+2]&g[4*k+1])\n      | (p[4*k+3]&p[4*k+2]&p[4*k+1]&g[4*k]);\n  end\n  for (genvar level=0; level<3; level++) begin : prefix_level\n    for (genvar k=0; k<8; k++) begin : prefix_group\n      if (k >= (1<<level)) begin\n        assign gp[level+1][k] = gp[level][k] & gp[level][k-(1<<level)];\n        assign gg[level+1][k] = gg[level][k]\n          | (gp[level][k] & gg[level][k-(1<<level)]);\n      end else begin\n        assign gp[level+1][k] = gp[level][k];\n        assign gg[level+1][k] = gg[level][k];\n      end\n    end\n  end\n  assign carry[0] = cin;\n  for (genvar k=1; k<8; k++) begin : group_carry\n    assign carry[k] = gg[3][k-1] | (gp[3][k-1]&cin);\n  end\n  for (genvar k=0; k<8; k++) begin : group_sum\n    wire c1 = g[4*k] | (p[4*k]&carry[k]);\n    wire c2 = g[4*k+1] | (p[4*k+1]&g[4*k])\n      | (p[4*k+1]&p[4*k]&carry[k]);\n    wire c3 = g[4*k+2] | (p[4*k+2]&g[4*k+1])\n      | (p[4*k+2]&p[4*k+1]&g[4*k])\n      | (p[4*k+2]&p[4*k+1]&p[4*k]&carry[k]);\n    assign sum[4*k +: 4] = p[4*k +: 4] ''^ {c3,c2,c1,carry[k]};\n  end\nendmodule\n'\"'''\nfor variant in ('alu_only','execute_all'):\n rtl=root/variant/'rtl'\n shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n p=rtl/'alu.sv'\n s=p.read_text()\n s=s.replace('  always_comb begin\\\\n    shamt', '''  wire [31:0] add_sum, sub_sum;\n  execute_sum32 u_add(.x(a), .y(b), .cin(1'b0), .sum(add_sum));\n  execute_sum32 u_sub(.x(a), .y(~b), .cin(1'b1), .sum(sub_sum));\n\n  always_comb begin\n    shamt''')\n s=s.replace('out = a + b;','out = add_sum;').replace('out = a - b;','out = sub_sum;')\n p.write_text(s+helper)\n if variant=='execute_all':\n  p=rtl/'ex_stage.sv';s=p.read_text()\n  at='  always_comb begin\\\\n    case (in.ctrl.branch_op)'\n  s=s.replace(at,'''  wire [31:0] pc_imm_sum, pc_next_sum;\n  execute_sum32 u_pc_imm(.x(in.pc), .y(in.imm), .cin(1'b0), .sum(pc_imm_sum));\n  execute_sum32 u_rs1_imm(.x(rs1), .y(in.imm), .cin(1'b0), .sum(jalr_sum));\n  execute_sum32 u_pc_next(.x(in.pc), .y(32'd4), .cin(1'b0), .sum(pc_next_sum));\n\n  always_comb begin\n    case (in.ctrl.branch_op)''')\n  s=s.replace('branch_target = in.pc + in.imm;', 'branch_target = pc_imm_sum;')\n  s=s.replace('    jalr_sum    = rs1 + in.imm;\\\\n','')\n  s=s.replace('(in.pc + in.imm)','pc_imm_sum')\n  s=s.replace('(in.pc + 32\\\\'d4)', 'pc_next_sum').replace('in.pc + 32\\\\'d4','pc_next_sum')\n  p.write_text(s)\n print(variant,rtl)\n(root/'helper.sv').write_text(helper)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
