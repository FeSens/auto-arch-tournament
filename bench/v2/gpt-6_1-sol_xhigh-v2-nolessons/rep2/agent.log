2:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    await _tick(dut)\n    d\n…[15393 of 18465 chars elided by tools/bench/transcript.py; sha256:c3bc072ed69ff4ae]…\n    dut.div_consume.value = 0\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_alu_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, SIM_BUILD, TEST_DIR\n\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[str(RTL / source) for source in (\"core_pkg.sv\", \"divider.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n        build_args=[\"-Wall\", \"-Wno-style\", \"-DRISCV_FORMAL_ALTOPS\"],\n    )\n    runner.test(\n        hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), test_filter=\"altops_uses_ordinary_operands$\",\n        extra_env={\"ALU_ALTOPS\": \"1\"},\n        results_xml=str(TEST_DIR / \"alu_altops.result.xml\"),\n    )\n", "exit_code": 0, "status": "completed"}}
