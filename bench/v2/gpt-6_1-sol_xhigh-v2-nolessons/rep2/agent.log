{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/predictor_research/replay.cpp')\np.write_text(r'''\n#include <cstdio>\n#include <vector>\n#include <cstdint>\n#include <map>\n#include <algorithm>\n#include <string>\nstruct Row {bool valid=false,jump=false; uint32_t pc=0,target=0; uint8_t cnt=1,hist=0;};\nstruct Model {\n Row rows[64]; uint8_t pht[4096]; unsigned hist=0, hbits, pc_bits; bool global,ras;\n std::vector<uint32_t> stack;\n unsigned long long miss=0,dir=0,target=0,conflict=0,n=0,br=0;\n std::map<uint32_t,unsigned> sites;\n Model(unsigned hb,unsigned pb,bool g=false,bool r=false):hbits(hb),pc_bits(pb),global(g),ras(r){std::fill_n(pht,4096,1);}\n void step(uint32_t pc,uint32_t next,uint32_t insn,bool timed){\n  bool branch=(insn&127)==0x63, jump=(insn&127)==0x6f||(insn&127)==0x67;\n  bool taken=(branch||jump)&&next\"'!=pc+4;\n  // Unconditional transfers to PC+4 still count as taken in hardware.\n  if(jump)taken=true;\n  auto &row=rows[(pc>>2)&63]; bool hit=row.valid&&row.pc==pc;\n  unsigned ph=((pc>>2)&((1<<pc_bits)-1))*(1<<hbits) + ((global?hist:row.hist)&((1<<hbits)-1));\n  bool pred=hit&&(row.jump||(hbits?pht[ph]>=2:row.cnt>=2));\n  uint32_t pt=row.target;\n  bool ret=(insn&127)==0x67&&((insn>>7)&31)==0&&(((insn>>15)&31)==1||((insn>>15)&31)==5)&&(insn>>20)==0;\n  if(ras&&ret&&!stack.empty()){pred=true;pt=stack.back();}\n  if(timed){n++;br+=branch; if(pred!=taken||(pred&&taken&&pt!=next)){\n    miss++;sites[pc]++;\n    if(pred!=taken)dir++;\n    else target++;\n    if((branch||jump)&&!hit)conflict++;\n  }}\n  if(branch||jump){\n   if(branch&&hbits){if(!hit||row.jump)ph=((pc>>2)&((1<<pc_bits)-1))*(1<<hbits);\n    if(taken){if(pht[ph]<3)pht[ph]++;}else if(pht[ph])pht[ph]--;\n   }\n   uint8_t nh=(hit&&!row.jump)?row.hist:0;\n   uint8_t nc=(hit&&!row.jump)?row.cnt:(taken?2:1);\n   if(hit&&!row.jump){if(taken){if(nc<3)nc++;}else if(nc)nc--;}\n   row={true,jump,pc,branch?(pc+(int32_t)((((insn>>31)&1)?0xffffe000:0)|(((insn>>31)&1)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1))):next,nc,(uint8_t)(((nh<<1)|taken)&((1<<hbits)-1))};\n   if(branch)hist=((hist<<1)|taken)&((1<<hbits)-1);\n  }else if(hit)row.valid=false;\n  if(ras){bool call=jump&&(((insn>>7)&31)==1||((insn>>7)&31)==5);\n   if(ret&&!stack.empty())stack.pop_back();\n   if(call){if(stack.size()==16)stack.erase(stack.begin());stack.push_back(pc+4);}\n  }\n }\n};\nint main(int argc,char**argv){\n std::vector<Model> m; std::vector<std::string> names;\n m.emplace_back(0,0); names.emplace_back(\"baseline\");\n m.emplace_back(0,0,false,true); names.emplace_back(\"RAS16\");\n for(bool g:{false,true})for(unsigned hb:{2,3,4,5,6,8})for(unsigned pb:{4,5,6})if(hb+pb<=12){m.emplace_back(hb,pb,g);names.push_back(std::string(g?\"global\":\"local\")+std::to_string(hb)+\"_pc\"+std::to_string(pb));}\n FILE*f=fopen(argv[1],\"rb\");uint32_t r[5]; while(fread(r,sizeof(r),1,f)==1)for(auto &m:m)m.step(r[0],r[1],r[2],r[4]); fclose(f);\n for(unsigned i=0;i<m.size();i++)printf(\"%s instructions=%llu branches=%llu misses=%llu direction=%llu target=%llu miss_no_btb=%llu'\"\\\\n\\\",names[i].c_str(),m[i].n,m[i].br,m[i].miss,m[i].dir,m[i].target,m[i].conflict);\n std::vector<std::pair<unsigned,uint32_t>> hot;for(auto[p,n]:m[0].sites)hot.emplace_back(n,p);std::sort(hot.rbegin(),hot.rend());for(unsigned i=0;i<std::min<unsigned>(hot.size(),25);i++)printf(\\\"hot PC=%08x misses=%u\\\\n\\\",hot[i].second,hot[i].first);\n}\n''')\nprint('Wrote software replay for branch-history opportunity measurement')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
