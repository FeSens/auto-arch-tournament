{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os,json\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nroot=Path(os.environ['TMPDIR'])/'predictor_direct_eligible'\nr=build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'timing_result.json').write_text(json.dumps({'results':r,'summary':summarize(r)},indent=2))\nprint(json.dumps({'summary':summarize(r)},indent=2))\nPY\"","aggregated_output":"{\n  \"summary\": {\n    \"placement_failed\": false,\n    \"fmax_mhz\": 76.872,\n    \"seeds\": [\n      74.138,\n      76.872,\n      76.872\n    ],\n    \"perturbations\": [\n      [\n        0,\n        74.138,\n        10\n      ],\n      [\n        1,\n        76.872,\n        10\n      ],\n      [\n        2,\n        76.872,\n        10\n      ]\n    ],\n    \"lut4\": 4931,\n    \"ff\": 1889,\n    \"lutram\": 32,\n    \"bsram\": 5,\n    \"dsp\": 2,\n    \"logic_levels\": 10,\n    \"critical_path\": {\n      \"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\",\n      \"to\": \"cpu/u_ex/u_alu/mul_product_65_s1\",\n      \"slack_ns\": -8.488,\n      \"arrival_ns\": 18.594,\n      \"logic_cells\": 12,\n      \"modules\": [\n        \"clock_ibuf\",\n        \"cpu/u_ex\",\n        \"cpu/u_predictor\",\n        \"cpu/u_id\"\n      ]\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
