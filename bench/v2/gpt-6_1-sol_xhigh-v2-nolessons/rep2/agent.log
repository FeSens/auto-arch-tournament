{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nroot=Path(os.environ['TMPDIR'])/'predictor_prepared_targets'\nrtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in (root.parent/'predictor_direct_target/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv';s=p.read_text().replace('logic [31:0] pc_relative_target;','logic [31:0] pc_relative_target;\\\\n    logic [31:0] sequential_target;');p.write_text(s)\np=rtl/'id_stage.sv';s=p.read_text().replace('reg_q.pc_relative_target <= in.pc + imm;','reg_q.pc_relative_target <= in.pc + imm;\\\\n      reg_q.sequential_target <= in.pc + 32\\\\'d4;');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text().replace(\\\"(in.pc + 32'd4)\\\",'in.sequential_target').replace(\\\"in.pc + 32'd4\\\",'in.sequential_target');p.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
