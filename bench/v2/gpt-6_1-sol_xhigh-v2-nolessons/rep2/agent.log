RD_ADDR = 5'(r);\n    logic [31:0] word_q;\n    wire write_en = w_en && (w_addr == WORD_ADDR);\n    wire rs1_match = (rs1_addr == WORD_ADDR);\n    wire rs2_match = (rs2_addr == WORD_ADDR);\n\n    always_ff @(posedge clock) begin\n      if (reset) word_q <= 32'b0;\n      else if (write_en) word_q <= w_data;\n    end\n\n    assign rs1_tree[32+r] = word_q & {32{rs1_match}};\n    assign rs2_tree[32+r] = word_q & {32{rs2_match}};\n  end\n\n  for (genvar n = 1; n < 32; n++) begin : g_\n…[5120 of 8192 chars elided by tools/bench/transcript.py; sha256:9a59626517aed6c1]…\n (io_dmemRData),\n    .dmem_wen   (io_dmemWEn),\n    .dmem_ren   (io_dmemREn),\n    .producer_w_en(mem_producer_w_en),\n    .producer_data(mem_producer_data),\n    .out        (mem_wb_w)\n  );\n\n  // ── WB ────────────────────────────────────────────────────────────────\n  wb_stage u_wb (\n    .in     (mem_wb_w),\n    .w_en   (wb_w_en),\n    .w_addr (wb_w_addr),\n    .w_data (wb_w_data)\n  );\n\n  // ── Hazard / forwarding ───────────────────────────────────────────────\n  hazard_unit u_hazard (\n    .id_ex_mem_read (id_ex_w.ctrl.mem_read),\n    .id_ex_rd       (id_ex_w.rd),\n    .if_id_rs1      (if_id_w.instr[19:15]),\n    .if_id_rs2      (if_id_w.instr[24:20]),\n    .redirect       (redirect),\n    .div_wait       (div_wait),\n    .imem_ready     (io_imemReady),\n    .dmem_ready     (io_dmemReady),\n    .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\n    .stall_if       (stall_if),\n    .stall_id       (stall_id),\n    .flush_if       (flush_if),\n    .flush_id       (flush_id),\n    .stall_ex_mem   (stall_ex_mem),\n", "exit_code": 0, "status": "completed"}}
