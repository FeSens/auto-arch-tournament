{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nroot=Path(os.environ['TMPDIR'])/'regional_predictor'\ntest=root/'test';test.mkdir(exist_ok=True)\nfor name in ['_helpers.py','conftest.py','test_pipeline.py','test_branch_predictor.py']:\n shutil.copy2(Path('cores/bench/test')/name,test/name)\np=test/'test_branch_predictor.py'\ns=p.read_text().replace('0xffffc','0x3ffc')\ns+='''\\\\n\\\\n@cocotb.test()\\\\nasync def regional_target_reconstruction_and_fallback(dut):\\\\n    await _reset(dut)\\\\n    for region in (0, 1, 7, 31, 63):\\\\n        base = region << 14\\\\n        pc, dest = base + 0x184, base + 0x3ffc\\\\n        await _update(dut, pc, dest, branch=0, jump=1)\\\\n        await _lookup(dut, pc, 1, dest)\\\\n        # Matching full tags must reject an entry from another region.\\\\n        await _lookup(dut, ((region \"'^ 1) << 14) + 0x184, 0, 0)'\"\\\\n        for other in (region \"'^ 1, region ''^ 32):'\"\\\\n            for taken in (0, 1):\\\\n                await _update(dut, pc, dest, branch=0, jump=1)\\\\n                # An unrelated unrepresentable update cannot evict this PC.\\\\n                await _update(dut, pc+0x100, (other<<14)+0x240, taken=taken)\\\\n                await _lookup(dut, pc, 1, dest)\\\\n                await _update(dut, pc, (other<<14)+0x240, taken=taken)\\\\n                await _lookup(dut, pc, 0, 0)\\\\n        await _update(dut, base+0x3ffc, base, branch=0, jump=1)\\\\n        await _lookup(dut, base+0x3ffc, 1, base)\\\\n        await _update(dut, base+0x3ffc, ((region\"'^1)<<14), branch=0, jump=1)'\"\\\\n        await _lookup(dut, base+0x3ffc, 0, 0)\\\\n'''\np.write_text(s)\nprint('Copied pipeline tests and added regional predictor coverage.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
