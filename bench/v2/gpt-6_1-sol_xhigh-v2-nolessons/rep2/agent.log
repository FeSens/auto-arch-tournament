r == rs2_addr) resolved_rs2 = ex_w_data;\n    else if (mem_w_en && mem_w_addr \"'!= 5'\"'b0 && mem_w_addr == rs2_addr) resolved_rs2 = mem_w_data;\n  end\n  // ── ID/EX register''');s=s.replace('<= rs1_data;','<= resolved_rs1;').replace('<= rs2_data;','<= resolved_rs2;');p.write_text(s)\np=dst/'core.sv';s=p.read_text();s=s.replace('  // ── ID + regfile', '  logic [31:0] ex_bypass_data, mem_bypass_data;\\\\n  logic ex_bypass_w_en, mem_bypass_w_en;\\\\n  // ── ID + regfile');s=s.replace('    .rs2_data (rs2_data_w),\\\\n    .out      (id_ex_w)', '    .rs2_data (rs2_data_w),\\\\n    .ex_w_en(ex_bypass_w_en), .ex_w_addr(id_ex_w.rd), .ex_w_data(ex_bypass_data),\\\\n    .mem_w_en(mem_bypass_w_en), .mem_w_addr(ex_mem_w.rd), .mem_w_data(mem_bypass_data),\\\\n    .out      (id_ex_w)');s=s.replace('.fwd_rs1_sel     (fwd_rs1_sel)', '.fwd_rs1_sel     (2\\\\'d0)').replace('.fwd_rs2_sel     (fwd_rs2_sel)', '.fwd_rs2_sel     (2\\\\'d0)');s=s.replace('    .div_wait        (div_wait),', '    .bypass_data(ex_bypass_data), .bypass_w_en(ex_bypass_w_en),\\\\n    .div_wait        (div_wait),');s=s.replace('    .out        (mem_wb_w)', '    .bypass_data(mem_bypass_data), .bypass_w_en(mem_bypass_w_en),\\\\n    .out        (mem_wb_w)');p.write_text(s)\nprint('Prepared finalized-ID-operand timing probe; champion RTL is unchanged.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
