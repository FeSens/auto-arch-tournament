_in_range && valid_q[update_index])\n      update_hit = tag_q[update_index] == update_pc[19:8];\n\n    // A replacement (including a change from jump to branch) starts weak.\n    next_counter = update_taken ? 2'b10 : 2'b01;\n    if (update_hit && !jump_q[update_index]) begin\n      next_counter = counter_q[update_index];\n      if (update_taken \n…[5441 of 8513 chars elided by tools/bench/transcript.py; sha256:c8a0d45f8790d03d]…\n4)\n    await _edge(dut)\n    await _lookup(dut, pc, 1, 0x2000)\n    # Reset wins over a simultaneous update and clears all 64 valid bits.\n    dut.reset.value = 1\n    await _edge(dut)\n    dut.reset.value = 0\n    dut.update_en.value = 0\n    for index in range(64):\n        await _lookup(dut, 0x400 + 4 * index, 0, 0)\n\n\ndef test_branch_predictor_runner():\n    run_cocotb(toplevel=\"branch_predictor\", sources=[\"branch_predictor.sv\"],\n               test_module=\"test_branch_predictor\")\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 53.083\n  lut4: 3205\n  ff: 925\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261005-001-r3s0\n  updated: '2026-10-05T01:30:37.910184Z'\n", "exit_code": 0, "status": "completed"}}
