{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_alu.py\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic and multiplication are combinational. Division uses a\nclocked request/completion/consume handshake and bounded real arithmetic.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_start.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_done.value)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_start.value = 1\n    await _tick(dut)\n    dut.div_start.value = 0\n    assert int(dut.div_busy.value)\n    cycles = 0\n    while not int(dut.div_done.value):\n        assert int(dut.out.value) == 0, \"unfinished divider result exposed\"\n        assert cycles < 36, \"divider failed to finish within its bound\"\n        await _tick(dut)\n        cycles += 1\n    assert cycles == (1 if (b & MASK32) == 0 else 34), cycles\n    await _check(dut, op, a, b, expected)\n    du\n…[3113 of 6185 chars elided by tools/bench/transcript.py; sha256:60415c84978a8bdb]…\nFFF, 0xFFFFFFFE)\n\n\n@cocotb.test()\nasync def mulhsu(dut):\n    await _setup(dut)\n    # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    # (-1) * unsigned -> high half is sign extension\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 10, 3, 3)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    # INT_MIN / -1 -> INT_MIN  (defined overflow per RV32IM)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nm64=(1<<64)-1\nr=random.Random(0x3203)\npoints=[0,1,0xffffffff,0x80000000,0x7fffffff,0xffff,0x10000,0x1ffff,0xffff0000,0x7fff0000]\npairs=[(a,b) for a in points for b in points]+[(r.getrandbits(32),r.getrandbits(32)) for _ in range(10000)]\nfor op in ['MUL','MULH','MULHU','MULHSU']:\n for a,b in pairs:\n  sa=op in ['MULH','MULHSU']; sb=op=='MULH'\n  al=a&65535; bl=b&65535\n  ah=(a>>16)-(65536 if sa and a>>31 else 0)\n  bh=(b>>16)-(65536 if sb and b>>31 else 0)\n  rows=[al*bl,((al*bh)<<16)&m64,((ah*bl)<<16)&m64,((ah*bh)<<32)&m64]\n  x,y,z=rows[:3]\n  s=x\"'^y''^z; c=(((x&y)|(x&z)|(y&z))<<1)&m64\n  x,y,z=s,c,rows[3]\n  s=x''^y''^z; c=(((x&y)|(x&z)|(y&z))<<1)&m64\n  p=(s+c)&m64\n  ref=((a-(1<<32) if sa and a>>31 else a)*(b-(1<<32) if sb and b>>31 else b))&m64\n  assert p==ref,(op,a,b,p,ref)\nprint('\"'Proposed limb and compressor arithmetic matches exact products for 40,400 operation/input combinations.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
