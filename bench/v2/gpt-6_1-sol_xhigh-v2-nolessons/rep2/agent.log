{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nroot=Path('cores/bench/generated/hypgen_r5')\n(root/'test_multiplier_probe.py').write_text('''import random\nimport cocotb\nfrom cocotb.triggers import Timer\n\nasync def tick(dut):\n dut.clock.value=0\n await Timer(5,unit=\\\"ns\\\")\n dut.clock.value=1\n await Timer(5,unit=\\\"ns\\\")\n\ndef signed(x): return x if x<0x80000000 else x-0x100000000\n\n@cocotb.test()\nasync def exact_products_and_handshake(dut):\n dut.clock.value=0; dut.reset.value=1; dut.start.value=0; dut.consume.value=0\n dut.op.value=11; dut.a.value=0; dut.b.value=0\n await tick(dut); dut.reset.value=0\n rng=random.Random(5102)\n edges=[0,1,0xffff,0x10000,0x7fffffff,0x80000000,0xffffffff,0x80008000,0xffff0001]\n vectors=[(a,b) for a in edges for b in edges]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(512)]\n for op in [11,12,13,14]:\n  for a,b in vectors:\n   assert not int(dut.busy.value)\n   dut.op.value=op; dut.a.value=a; dut.b.value=b; dut.start.value=1\n   await tick(dut); dut.start.value=0\n   cycles=0\n   if op==11: assert int(dut.done.value), \\\"MUL must complete immediately after partial-product capture\\\"\n   dut.a.value=a\"'^0xffffffff; dut.b.value=b''^0xffffffff; dut.op.value=0\n   while not int(dut.done.value):\n    assert cycles<6\n    assert int(dut.result.value)==0\n    await tick(dut); cycles+=1\n   lhs=signed(a) if op in [12,14] else a\n   rhs=signed(b) if op==12 else b\n   product=(lhs*rhs)&0xffffffffffffffff\n   expected=(product if op==11 else product>>32)&0xffffffff\n   assert int(dut.result.value)==expected, (op,hex(a),hex(b),hex(expected),hex(int(dut.result.value)))\n   for _ in range(2):\n    await tick(dut)\n    assert int(dut.done.value) and int(dut.result.value)==expected\n   dut.consume.value=1; await tick(dut); dut.consume.value=0\n   assert not int(dut.done.value) and not int(dut.busy.value)\n for op in [11,12,13,14]:\n  dut.op.value=op; dut.a.value=0xffffffff; dut.b.value=0x80000000; dut.start.value=1\n  await tick(dut); dut.start.value=0; dut.reset.value=1\n  await tick(dut); dut.reset.value=0\n  assert not int(dut.done.value) and not int(dut.busy.value)\n'\"''')\n(root/'run_multiplier_probe.py').write_text('''from pathlib import Path\nimport sys\nfrom cocotb_tools.runner import get_runner\nroot=Path(__file__).parent.resolve()\nsys.path.insert(0,str(root))\nrunner=get_runner(\\\"verilator\\\")\nrunner.build(sources=[root/\\\"rtl/core_pkg.sv\\\",root/\\\"rtl/multiplier.sv\\\"],hdl_toplevel=\\\"multiplier\\\",build_dir=root/\\\"mul_build\\\",build_args=[\\\"-Wall\\\",\\\"-Wno-fatal\\\"],always=True)\nrunner.test(hdl_toplevel=\\\"multiplier\\\",test_module=\\\"test_multiplier_probe\\\",test_dir=root,build_dir=root/\\\"mul_build\\\")\n''')\nprint('Created exact-arithmetic probe')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
