 hex(ref['pc']),\n            'field': field, 'expected': hex(expected), 'got': hex(got)}\n\ndef compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\n            ref_reason=None, sim_returncode=0, sim_stderr=''):\n    for i, (ref, sim) in enumerate(zip(ref_trace, sim_trace)):\n        # Direct-equality RVFI fields. trap/halt/intr/mode/ixl are included\n    \n…[8286 of 11358 chars elided by tools/bench/transcript.py; sha256:c15c9515cabb5ce2]…\nr_0,\n234:                 top->io_rvfi_mode_0, top->io_rvfi_ixl_0)) break;\n240:        if (emit(top->io_rvfi_valid_1, top->io_rvfi_order_1, top->io_rvfi_insn_1,\n241:                 top->io_rvfi_pc_rdata_1, top->io_rvfi_pc_wdata_1,\n242:                 top->io_rvfi_rd_addr_1, top->io_rvfi_rd_wdata_1,\n243:                 top->io_rvfi_rs1_addr_1, top->io_rvfi_rs1_rdata_1,\n244:                 top->io_rvfi_rs2_addr_1, top->io_rvfi_rs2_rdata_1,\n245:                 top->io_rvfi_mem_addr_1,\n246:                 top->io_rvfi_mem_rmask_1, top->io_rvfi_mem_rdata_1,\n247:                 top->io_rvfi_mem_wmask_1, top->io_rvfi_mem_wdata_1,\n248:                 top->io_rvfi_trap_1, top->io_rvfi_halt_1, top->io_rvfi_intr_1,\n249:                 top->io_rvfi_mode_1, top->io_rvfi_ixl_1)) break;\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n", "exit_code": 0, "status": "completed"}}
