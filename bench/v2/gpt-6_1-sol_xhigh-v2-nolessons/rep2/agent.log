kg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[10840 of 13912 chars elided by tools/bench/transcript.py; sha256:4fd61a8bb910a574]…\nted a frequency\ntools/eval/fpga.py:134:    placement_failed = (proc.returncode != 0) or (fmax is None)\ntools/eval/fpga.py:138:        'fmax_mhz': fmax if not placement_failed else None,\ntools/eval/fpga.py:141:        'placement_failed': placement_failed,\ntools/eval/fpga.py:196:                 'placement_failed': True}\ntools/eval/fpga.py:203:def run_coremark_ipc(worktree: str, sim_bin: str | None = None, env: dict | None = None) -> dict:\ntools/eval/fpga.py:327:            'placed': sum(1 for r in res if not r['placement_failed'])}\ntools/eval/fpga.py:330:def run_fpga_eval(worktree: str, target: str | None = None) -> dict:\ntools/eval/fpga.py:336:      {'placement_failed': True, ...}    — the design does not fit or route\ntools/eval/fpga.py:344:        'seeds': [float, ...],           — Fmax per placement option\ntools/eval/fpga.py:364:    if fp['placement_failed']:\ntools/eval/fpga.py:368:        return {'bench_failed': True, 'placement_failed': False,\ntools/eval/fpga.py:379:            'placement_failed': False,\n", "exit_code": 0, "status": "completed"}}
