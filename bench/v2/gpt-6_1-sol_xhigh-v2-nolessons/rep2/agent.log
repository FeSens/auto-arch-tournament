{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nfrom pathlib import Path\nimport sys,json\nfrom tools.eval.fpga import run_coremark_ipc\nroot=Path.cwd()\np=root/'cores/bench/generated/hyp_r5s0_address'\nsim=str(p/'obj_dir/cosim_sim')\nsys.path.insert(0,str(root/'test/cosim'))\nfrom run_cosim import run_reference,run_verilator,compare\nresults=[]\nfor name in ('selftest','random1','random2','random3'):\n elf=str(root/f'bench/programs/{name}.elf')\n ref,rc,reason=run_reference(elf)\n for flags in ((),('--istall','--dstall')):\n  trace,completed,code,stderr=run_verilator(sim,elf,sim_flags=flags)\n  result=compare(ref,trace,rc,completed,reason,code,stderr)\n  item={'program':name,'flags':flags,**result}\n  results.append(item)\n  print(json.dumps(item),flush=True)\ncm=run_coremark_ipc(str(root),sim_bin=sim)\nprint('COREMARK:',json.dumps(cm),flush=True)\n(p/'simulation_results.json').write_text(json.dumps({'cosim':results,'coremark':cm},indent=2))\nassert all(r['passed'] for r in results)\nassert cm['completed']\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
