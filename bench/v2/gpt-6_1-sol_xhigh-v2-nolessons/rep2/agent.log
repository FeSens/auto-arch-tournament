{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json, subprocess\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.cosim import run_one\nfrom tools.eval.fpga import validate_coremark_uart\nroot=Path('/srv/hwebench/tmp/3d673a88/af46de74/predictor_probe')\nsim=str(root/'recovery_obj/cosim_sim')\nwith ThreadPoolExecutor(max_workers=8) as pool:\n traces=[f.result() for f in [pool.submit(run_one,root/f'{name}.elf',sim,str(Path.cwd()),None,flags) for name in ['selftest','random1','random2','random3'] for flags in [(),('--istall','--dstall')]]]\nprint('TRACE:',json.dumps(traces))\nr=subprocess.run([sim,str(root/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True,timeout=180)\nmarker=json.loads(r.stdout.splitlines()[-1])\nvalid,reason=validate_coremark_uart(marker.get('uart',''),10)\nassert marker.get('ebreak') and not marker.get('oob') and marker.get('bench_bracketed')\nassert valid,reason\n(root/'recovery_coremark.json').write_text(json.dumps(marker,indent=2))\nprint('COREMARK:',json.dumps(marker))\n(root/'recovery_verification.json').write_text(json.dumps({'traces':traces,'coremark_valid':valid,'reason':reason},indent=2))\nassert all(t['passed'] for t in traces)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
