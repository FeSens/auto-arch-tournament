{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,re\np=Path('cores/bench/generated/hyp_r6s1_splitdecode/rtl'); p.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/generated/hyp_r6s1_alupacket/rtl').glob('*.sv'): shutil.copy2(f,p/f.name)\nshutil.copy2('cores/bench/generated/hyp_r6s1/rtl/core.sv',p/'core.sv')\nshutil.copy2('cores/bench/generated/hyp_r6s1/rtl/if_stage.sv',p/'if_stage.sv')\ns=(p/'core_pkg.sv').read_text().replace('    logic [31:0] instr;\\\\n    logic        predicted_taken;', '    logic [31:0] instr;\\\\n    ctrl_t ctrl;\\\\n    logic [31:0] imm;\\\\n    logic        predicted_taken;')\n(p/'core_pkg.sv').write_text(s)\ns=(p/'id_stage.sv').read_text(); start=s.index('  decoder u_decoder (');end=s.index('  // Regfile read addresses',start)\nfields=re.findall(r'ctrl_decoded\\\\.(\\\\w+)\\\\s*=\\\\s*(dec_\\\\w+);',s)\ns=s[:start]+''.join(f'  assign {dec} = in.ctrl.{field};\\\\n' for field,dec in fields)+'  logic [31:0] imm;\\\\n  assign imm = in.imm;\\\\n\\\\n'+s[end:]\n(p/'id_stage.sv').write_text(s)\ns=(p/'if_stage.sv').read_text(); ctrl='  ctrl_t fetch_ctrl;\\\\n  logic [31:0] fetch_imm;\\\\n  decoder u_decoder (\\\\n    .instr(imem_data),\\\\n'+',\\\\n'.join(f'    .{field}(fetch_ctrl.{field})' for field,dec in fields)+'\\\\n  );\\\\n  imm_gen u_imm (.instr(imem_data), .imm(fetch_imm));\\\\n'\ns=s.replace('  logic [31:0] pc;',ctrl+'  logic [31:0] pc;')\ns=s.replace('        reg_q.instr <= imem_data;', '        reg_q.instr <= imem_data;\\\\n        reg_q.ctrl <= fetch_ctrl;\\\\n        reg_q.imm <= fetch_imm;')\n(p/'if_stage.sv').write_text(s)\nprint('Created split decode / operand collection prototype')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
