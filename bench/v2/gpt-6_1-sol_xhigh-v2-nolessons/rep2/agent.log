{"type": "item.completed", "item": {"id": "item_58", "type": "command_execution", "command": "/bin/bash -c \"sed -n '691,720p' cores/bench/test/test_pipeline.py; cat /srv/hwebench/tmp/3d673a88/322a5608/predictor_split/rtl/branch_predictor.sv\"", "aggregated_output": "@cocotb.test()\nasync def predictor_conflicts_and_simultaneous_lookup_training(dut):\n    program = {0: ADDI(2, 0, 4), 4: JAL(0, 0xfc),\n               0x100: ADDI(2, 2, -1), 0x104: BNE(2, 0, -0x100),\n               0x108: SW(2, 0, 0), 0x10c: EBREAK()}\n    events = {}\n    rets, _, stores = await _run_checked(dut, program, events=events)\n    assert [r[\"pc\"] for r in rets] == [0] + [4, 0x100, 0x104] * 4 + [0x108, 0x10c]\n    assert len(events[\"recoveries\"]) == 7 and len(stores) == 1\n    assert all(not f[2] for f in events[\"fetches\"] if f[1] in (4, 0x104))\n\n    # JALR writes its own source register: first resolve to itself, then\n    # forward the link and resolve to PC+4. Lookup and EX update repeatedly\n    # coincide at PC=0, so a write-through metadata bug changes retirement.\n    program = [JALR(1, 1, 0), ADDI(2, 2, 1), ADDI(1, 0, 0), ADDI(3, 0, 4),\n               BEQ(2, 3, 12), JAL(0, -20), SW(1, 0, 4), SW(2, 0, 0), EBREAK()]\n    events = {}\n    rets, dmem, stores = await _run_checked(dut, program, events=events)\n    expected = [0, 0, 4, 8, 12, 16, 20] * 3 + [0, 0, 4, 8, 12, 16, 28, 32]\n    assert [r[\"pc\"] for r in rets] == expected\n    assert [r[\"rs1_rdata\"] for r in rets if r[\"pc\"] == 0] == [0, 4] * 4\n    assert [r[\"pc_next\"] for r in rets if r[\"pc\"] == 0] == [0, 4] * 4\n    assert all(r[\"rd_wdata\"] == 4 for r in rets if r[\"pc\"] == 0)\n    assert len([u for u in events[\"updates\"] if u[1] == 0]) == 8\n    assert len(stores) == 1 and dmem[0] == 4\n\n\n@cocotb.test()\nasync def predictor_stale_code_illegal_and_misaligned_recovery(dut):\n    replacements = [\n// 64-entry direct-mapped target/direction predictor for the lower 1 MiB.\n// Only validity resets. Payload arrays have asynchronous reads and one\n// synchronous write port; lookup observes the old row on an update edge.\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [31:0] lookup_pc,\n  output logic        predicted_taken,\n  output logic [31:0] predicted_target,\n  input logic direction_update_en,\n  input logic [31:0] direc\n…[2551 of 5623 chars elided by tools/bench/transcript.py; sha256:645a666021151af8]…\n only their own PC, never another tag's entry.\n        valid_q[update_index] <= 1'b0;\n      end\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      direction_valid_q <= '0;\n    end else if (direction_update_en && direction_update_in_range && direction_update_legal\n                 && (direction_update_branch || direction_update_jump)) begin\n      direction_valid_q[direction_update_index] <= 1'b1;\n      if (direction_update_jump)\n        counter_q[direction_update_index] <= 2'b10;\n      else if (!direction_valid_q[direction_update_index])\n        counter_q[direction_update_index] <= direction_update_taken ? 2'b10 : 2'b01;\n      else if (direction_update_taken && counter_q[direction_update_index] != 2'b11)\n        counter_q[direction_update_index] <= counter_q[direction_update_index] + 2'b01;\n      else if (!direction_update_taken && counter_q[direction_update_index] != 2'b00)\n        counter_q[direction_update_index] <= counter_q[direction_update_index] - 2'b01;\n    end\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
