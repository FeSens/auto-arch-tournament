'rtl'; d.mkdir(parents=True,exist_ok=True)\n for p in rtl.glob('*.sv'): shutil.copyfile(p,d/p.name)\n s=orig[:start]+new+orig[stop:]\n s=s.replace('mul_uu[31:0]','mul_product[31:0]')\n s=s.replace('\"'$unsigned(mul_ss[63:32])'\"','mul_product[63:32]')\n s=s.replace('mul_uu[63:32]','mul_product[63:32]')\n s=s.replace('\"'$unsigned(mul_su[63:32])'\"','mul_product[63:32]')\n (d/'alu.sv').write_text(s)\nprint('Prepared isolated multiplier timing prototypes.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
