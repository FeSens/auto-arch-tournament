{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"git diff --check; git status --short; sed -n '118,136p' cores/bench/rtl/core_pkg.sv; sed -n '121,147p' cores/bench/rtl/mem_stage.sv; cat cores/bench/rtl/wb_stage.sv\"","aggregated_output":" M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/mem_stage.sv\n M cores/bench/rtl/wb_stage.sv\n M cores/bench/test/test_pipeline.py\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] read_data;      // sign/zero-extended load (retained for visibility)\n    logic [31:0] wb_data;        // selected MEM result for regfile write\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n  assign producer_data = in.ctrl.mem_to_reg ? load_data : in.alu_result;\n\n  // ── MEM/WB register ───────────────────────────────────────────────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (hold_wb) begin\n      // Clear valid to avoid repeating retirement while MEM holds.\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.alu_result <= in.alu_result;\n      reg_q.read_data  <= load_data;\n      // Share the existing selection even for x0, traps and bubbles.\n      reg_q.wb_data    <= producer_data;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= dmem_rdata;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n// rtl/wb_stage.sv\n//\n// Write-back stage. Drives the selected result captured by MEM/WB to the\n// regfile write port; the regfile itself stalls on x0 and gates on\n// w_en.\n//\n// Latency:        combinational.\n// RVFI fields:    feeds rd_wdata (= w_data when w_en=1, else 0).\nmodule wb_stage (\n  // Other payload fields are retained for compatibility or consumed by\n  // top-level RVFI; this stage only needs reg_write/valid/rd/wb_data.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  mem_wb_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic               w_en,\n  output logic [4:0]         w_addr,\n  output logic [31:0]        w_data\n);\n\n  always_comb begin\n    w_en   = in.ctrl.reg_write && in.valid;\n    w_addr = in.rd;\n    w_data = in.wb_data;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
