{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json,os,subprocess\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nroot=Path(os.environ['TMPDIR'])/'predictor_direct_target';old=root.parent/'regional_predictor'\np=subprocess.run([str(root/'obj/cosim_sim'),str(old/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True)\n(root/'coremark_output.txt').write_text(p.stdout)\nd=json.loads(p.stdout.splitlines()[-1]);good,why=validate_coremark_uart(d.get('uart',''),10)\nprint(json.dumps(d)); print('Canonical CRC validation:',good,why)\nassert d.get('ebreak') and not d.get('oob') and good\nfor name in ['selftest','random1','random2','random3']:\n for flags in [[],['--istall','--dstall']]:\n  p=subprocess.run(['python','test/cosim/run_cosim.py',str(root/'obj/cosim_sim'),str(old/f'{name}.elf'),*flags],text=True,capture_output=True)\n  print(name,flags,p.returncode,p.stdout[-300:],p.stderr[-300:],flush=True)\n  assert p.returncode==0\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
