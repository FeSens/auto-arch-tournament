{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"sed -n '330,400p' tools/eval/fpga.py; rg -n 'PLACE_OPTIONS|def run|write_text|outdir' tools/eval/gowin.py | tail -40\"", "aggregated_output": "def run_fpga_eval(worktree: str, target: str | None = None) -> dict:\n    \"\"\"\n    Vendor place-and-route (tools/eval/gowin.py) for Fmax and area, and the\n    Verilator CoreMark run (with random memory stalls) for cycles.\n\n    Returns:\n      {'placement_failed': True, ...}    — the design does not fit or route\n      {'bench_failed': True, ...}        — bench didn't reach ebreak, or\n                                           reason 'fpga_report_unparsed: ...'\n      {\n        'fmax_mhz': float,               — median over gowin.PLACE_OPTIONS\n        'ipc_coremark': float,           — iter/cycle\n        'fitness': float,                — iter/sec = fmax_hz * iter/cycle\n        'cycles': int, 'iterations': int,\n        'seeds': [float, ...],           — Fmax per placement option\n        'lut4': int (Gowin \"Logic\": LUT + ALU + ROM16), 'ff': int,\n        'lutram', 'bsram', 'dsp', 'logic_levels': int,\n      }\n    \"\"\"\n    worktree = str(Path(worktree).resolve())\n    env = os.environ.copy()\n    rtl_dir = Path(worktree) / \"cores\" / target / \"rtl\" if target is not None else Path(worktree) / \"rtl\"\n    generated_dir = (\n        Path(worktree) / \"cores\" / target / \"generated\" if target is not None else Path(worktree) / \"generated\"\n    )\n    sim_bin = (\n        str(Path(worktree) / \"cores\" / target / \"obj_dir\" / \"cosim_sim\")\n        if target is not None\n        else None\n    )\n\n    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\n                              generated_dir, env=env)\n    fp = gowin.summarize(results)\n    if fp['placement_failed']:\n        return fp\n    if fp['lut4'] is None or fp['ff'] is None:\n        # Never substitute 0: 0 logic is the best possible area score.\n        return {'bench_failed': True, 'placement_failed': False,\n                'reason': 'fpga_report_unparsed: no Logic/Register count in Gowin report',\n                'fmax_mhz': fp['fmax_mhz'], 'seeds': fp['seeds']}\n\n    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n    if not cm['completed']:\n        return {\n            'bench_failed': True,\n            'reason': cm.get('reason', 'unknown'),\n            'fmax_mhz': fp['fmax_mhz'],\n            'seeds': fp['seeds'],\n            'placement_failed': False,\n        }\n\n    fitness = fp['fmax_mhz'] * cm['iter_per_cycle'] * 1_000_000  # iter/sec\n    return {\n        **fp,\n        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n        'fitness':       round(fitness, 2),\n        'cycles':        cm['cycles'],\n        'iterations':    cm['iterations'],\n    }\n\nif __name__ == '__main__':\n    import sys\n    result = run_fpga_eval(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n8:Fmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\n26:PLACE_OPTIONS = (0, 1, 2)\n104:def parse_reports(outdir: Path) -> dict:\n106:    tr = outdir / \"impl/pnr/core_bench.tr\"\n107:    rpt = outdir / \"impl/pnr/core_bench.rpt.txt\"\n128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n149:                place_option: int, outdir: str | Path, env: dict | None = None) -> dict:\n150:    worktree, rtl_dir, outdir = Path(worktree).resolve(), Path(rtl_dir).resolve(), Path(outdir).resolve()\n151:    remove_path(outdir)\n152:    outdir.mkdir(parents=True)\n153:    (outdir / \"build.tcl\").write_text(project_tcl(worktree, rtl_dir, bench_sv, place_option))\n154:    log = outdir / \"gw.log\"\n158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n163:    res = parse_reports(outdir)\n171:              options=PLACE_OPTIONS) -> list[dict]:\n187:    ref = next(r for r in results if r[\"place_option\"] == PLACE_OPTIONS[0])\n212:    opts = PLACE_OPTIONS if a.all_options else PLACE_OPTIONS[:1]\n", "exit_code": 0, "status": "completed"}}
