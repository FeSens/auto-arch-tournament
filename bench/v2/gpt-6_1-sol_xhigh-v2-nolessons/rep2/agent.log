{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypgen_mul/shared')\ntest=base/'test'; test.mkdir(exist_ok=True)\nfor f in ['_helpers.py','test_alu.py']:\n shutil.copyfile(Path('cores/bench/test')/f,test/f)\nextra='''\n\n@cocotb.test()\nasync def shared_multiplier_boundaries_and_random(dut):\n    await _setup(dut)\n    rng = random.Random(0x320305)\n    boundary = [0,1,0xffffffff,0x80000000,0x7fffffff,0xffff,0x10000,0x1ffff,0xffff0000,0x7fff0000,0x80000001]\n    for bit in range(32):\n        boundary.extend([((1 << bit) + delta) & MASK32 for delta in [-1,0,1]])\n    boundary = sorted(set(boundary))\n    pairs = [(a,b) for a in boundary for b in boundary]\n    pairs.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000))\n    for a,b in pairs:\n        await _check(dut, ALU_MUL, a, b, a*b)\n        await _check(dut, ALU_MULH, a, b, (_signed(a)*_signed(b)) >> 32)\n        await _check(dut, ALU_MULHU, a, b, (a*b) >> 32)\n        await _check(dut, ALU_MULHSU, a, b, (_signed(a)*b) >> 32)\n'''\np=test/'test_alu.py'; p.write_text(p.read_text()+extra)\nprint('Prepared isolated ALU suite with exact shared-multiplier checks.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
