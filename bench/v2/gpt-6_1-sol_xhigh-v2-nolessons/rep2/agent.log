w] = lookup_hit && (jump_q || counter_q[1]);\n    assign row_target[row] = lookup_hit ? {12'b0, target_q, 2'b0} : 32'b0;\n    assign update_hit = valid_q && tag_q == update_pc[19:8];\n    always_comb begin\n      next_counter = update_taken ? 2'b10 : 2'b01;\n      if (update_hit && \"'!jump_q) begin\n        next_counter = counter_q;\n        if (update_taken && counter_q != 2'\"'b11)\n          next_counter = counter_q + 2'b01;\n        else if (\"'!update_taken && counter_q != 2'\"'b00)\n          next_counter = counter_q - 2'b01;\n      end\n    end\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        valid_q <= 1'b0;\n      end else if (update_en && update_in_range && update_pc[7:2] == row[5:0]) begin\n        if (update_legal && (update_branch || update_jump) && target_in_range) begin\n          valid_q <= 1'b1;\n          tag_q <= update_pc[19:8];\n          target_q <= update_target[19:2];\n          counter_q <= update_jump ? 2'b10 : next_counter;\n          jump_q <= update_jump;\n        end else if (update_hit) begin\n          valid_q <= 1'b0;\n        end\n      end\n    end\n  end endgenerate\nendmodule\n''';f.write_text(head+body)\nprint('Prepared two-bank targets and explicit flop-backed rows')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
