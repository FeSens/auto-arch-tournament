counter_q[lookup_index][1]);\n  end\n  always_ff @(posedge clock) begin\n    if (reset || lookup_clear) predicted_taken <= 1'b0;\n    else if (lookup_advance) predicted_taken <= lookup_taken;\n  end\n  // Direct enabled, unreset synchronous target read, independent of hit.\n  always_ff @(posedge clock) begin\n    if (lookup_advance) target_read_q <= target_q[lookup_index];\n  end\n  assign predicted_target = {12'b0, target_read_q, 2'b0};\n\n'''+s[b:]\np.write_text(s)\nprint('Explicit synchronous lookahead predictor RTL:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
