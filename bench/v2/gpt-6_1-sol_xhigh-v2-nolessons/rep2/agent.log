{"type": "item.completed", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/alu.sv'", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM combinational ALU. Multiplication uses SystemVerilog `*`;\n// DIV/REM share a triangular unsigned divider with borrow lookahead.\n//\n// RV32IM division semantics (overridden from straight `signed /`):\n//   DIV  by 0       -> -1   (all ones)\n//   DIVU by 0       -> 0xFFFFFFFF\n//   DIV  INT_MIN/-1 -> INT_MIN  (no trap, defined overflow)\n//   REM  by 0       -> dividend\n//   REMU by 0       -> dividend\n//   REM  INT_MIN/-1 -> 0\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  // 64-bit products, computed once and selected per op.\n  // mul_ss/mul_su low halves are unused (only MULH/MULHSU read the high\n  // half). Verilator's UNUSEDSIGNAL is silenced locally — the unused\n  // bits are dead-code-eliminated by Yosys.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [63:0] mul_ss;  // signed*signed\n  logic        [63:0] mul_uu;  // unsigned*unsigned (both halves used)\n  logic signed [63:0] mul_su;  // signed*unsigned (a signed, b unsigned)\n  /* verilator lint_on UNUSEDSIGNAL */\n\n`ifndef RISCV_FORMAL_ALTOPS\n  logic div_signed, div_remainder, div_negative;\n  logic [31:0] div_a, div_b;\n  wire [31:0] residual [0:32];\n  wire [31:0] quotient;\n  logic [31:0] div_selected, div_result;\n\n  assign div_signed = (op == ALU_DIV) || (op == ALU_REM);\n  assign div_remainder = (op == ALU_REM) || (op == ALU_REMU);\n  assign div_a = (div_signed && a[31]) ? (~a + 32'd1) : a;\n  assign div_b = (div_signed && b[31]) ? (~b + 32'd1) : b;\n  assign residual[32] = div_a;\n\n  // Row i subtracts (div_b << i) from the preceding residual. Only\n  // its high N=32-i bits participate; the low i bits pass through.\n  // A divisor with bits above N cannot fit, even if its low slice does.\n  for (genvar i = 0; i < 32; i++) begin : div_row\n    localpar\n…[5356 of 8428 chars elided by tools/bench/transcript.py; sha256:ab3a6d7cde6746a2]…\n substituted for tractable algebraic stand-ins so bitwuzla\n      // can solve the BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined and\n      // run the real arithmetic.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\n`else\n      ALU_MUL:    out = mul_uu[31:0];\n      ALU_MULH:   out = $unsigned(mul_ss[63:32]);\n      ALU_MULHU:  out = mul_uu[63:32];\n      ALU_MULHSU: out = $unsigned(mul_su[63:32]);\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = div_result;\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
