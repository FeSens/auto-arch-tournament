{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/r10s1_partials/rtl')\nfor name,mode in (('r10s1_partialnarrow','narrow'),('r10s1_partiallow','low')):\n dst=Path('cores/bench/generated')/name/'rtl';shutil.copytree(base,dst,dirs_exist_ok=True)\n p=dst/'mem_stage.sv';s=p.read_text()\n if mode=='narrow':\n  a=s.index('  logic [63:0] t00');b=s.index('  logic is_mul;',a)\n  s=s[:a]+'''  logic [17:0] low_a, low_b, low_c, low_s, low_carry, low_sum;\n  logic [31:0] high_a, high_b, high_c, high_s, high_carry;\n  logic [31:0] high2_s, high2_carry, high_lowcarry, high_result;\n  logic [63:0] product;\n  assign low_a = {2'b0, in.mul_p00[31:16]};\n  assign low_b = {2'b0, in.mul_p01[15:0]};\n  assign low_c = {2'b0, in.mul_p10[15:0]};\n  assign low_s = low_a \"'^ low_b ''^ low_c;\n  assign low_carry = ((low_a & low_b) | (low_a & low_c) | (low_b & low_c)) << 1;\n  assign low_sum = low_s + low_carry;\n  assign high_a = in.mul_p11[31:0];\n  assign high_b = {{14{in.mul_p01[33]}}, in.mul_p01[33:16]};\n  assign high_c = {{14{in.mul_p10[33]}}, in.mul_p10[33:16]};\n  assign high_s = high_a ''^ high_b ''^ high_c;\n  assign high_carry = ((high_a & high_b) | (high_a & high_c) | (high_b & high_c)) << 1;\n  assign high_lowcarry = {30'\"'b0, low_sum[17:16]};\n  assign high2_s = high_s \"'^ high_carry ''^ high_lowcarry;\n  assign high2_carry = ((high_s & high_carry) | (high_s & high_lowcarry) | (high_carry & high_lowcarry)) << 1;\n  assign high_result = high2_s + high2_carry;\n  assign product = {high_result, low_sum[15:0], in.mul_p00[15:0]};\n'\"'''+s[b:]\n else:\n  s=s.replace('  logic is_mul;','  logic [17:0] low_sum;\\\\n  assign low_sum = {2\\\\'b0, in.mul_p00[31:16]} + {2\\\\'b0, in.mul_p01[15:0]} + {2\\\\'b0, in.mul_p10[15:0]};\\\\n  logic is_mul;')\n  s=s.replace('? product[31:0] : product[63:32])','? {low_sum[15:0], in.mul_p00[15:0]} : product[63: