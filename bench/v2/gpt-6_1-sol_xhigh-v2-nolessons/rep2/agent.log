es it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[9490 of 12562 chars elided by tools/bench/transcript.py; sha256:131872162a95d11c]…\nesis/core_bench_syn.rpt.html:1163:<td>cpu/u_rf/regs_regs_0_0_s0/DO[31]</td>\n/srv/hwebench/tmp/3d673a88/73ed3a77/predictor_training/baseline/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html:1472:<td>cpu/u_rf/regs_regs_0_0_s0</td>\n/srv/hwebench/tmp/3d673a88/73ed3a77/predictor_training/baseline/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html:1527:<td>cpu/u_rf/regs_regs_0_0_s0/CLKB</td>\n/srv/hwebench/tmp/3d673a88/73ed3a77/predictor_training/baseline/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html:1535:<td>cpu/u_rf/regs_regs_0_0_s0/DO[31]</td>\n/srv/hwebench/tmp/3d673a88/73ed3a77/predictor_training/baseline/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html:1844:<td>cpu/u_rf/regs_regs_0_0_s0</td>\n/srv/hwebench/tmp/3d673a88/73ed3a77/predictor_training/baseline/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html:1899:<td>cpu/u_rf/regs_regs_0_0_s0/CLKB</td>\n/srv/hwebench/tmp/3d673a88/73ed3a77/predictor_training/baseline/gowin_p0/impl/gwsynthesis/core_bench_syn.rpt.html:1907:<td>cpu/u_rf/regs_regs_0_0_s0/DO[31]</td>\n", "exit_code": 0, "status": "completed"}}
