{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_branch_predictor.py; rg --files cores/bench/experiments/hypotheses cores/bench/test bench | head -80'", "aggregated_output": "\"\"\"Predictor policy checks through its lookup and accepted-update ports.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\n\n\nasync def _edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.lookup_pc.value = 0\n    dut.update_en.value = 0\n    dut.update_pc.value = 0\n    dut.update_branch.value = 0\n    dut.update_jump.value = 0\n    dut.update_legal.value = 0\n    dut.update_taken.value = 0\n    dut.update_target.value = 0\n    await _edge(dut)\n    dut.reset.value = 0\n\n\nasync def _lookup(dut, pc, taken, target=None):\n    dut.lookup_pc.value = pc\n    await Timer(1, \"ns\")\n    assert int(dut.predicted_taken.value) == taken, f\"lookup {pc:#x} direction\"\n    if target is not None:\n        assert int(dut.predicted_target.value) == target, f\"lookup {pc:#x} target\"\n\n\nasync def _update(dut, pc, target, taken=1, branch=1, jump=0, legal=1, enabled=1):\n    dut.update_en.value = enabled\n    dut.update_pc.value = pc\n    dut.update_target.value = target\n    dut.update_taken.value = taken\n    dut.update_branch.value = branch\n    dut.update_jump.value = jump\n    dut.update_legal.value = legal\n    await _edge(dut)\n    dut.update_en.value = 0\n\n\n@cocotb.test()\nasync def conditional_saturation_replacement_and_kind_change(dut):\n    await _reset(dut)\n    pc, target = 0x184, 0x240\n    await _lookup(dut, pc, 0)\n    # New not-taken row starts 01; both saturation endpoints are exercised.\n    outcomes = [0, 1, 1, 0, 0, 0, 0, 1, 1]\n    predictions = [0, 1, 1, 1, 0, 0, 0, 0, 1]\n    for outcome, prediction in zip(outcomes, predictions):\n        await _update(dut, pc, target, taken=outcome)\n        await _lookup(dut, pc, prediction, target)\n    await _update(dut, pc + 4, target, taken=1)\n    await _lookup(dut, pc + 4, 1, target)\n    await _update(dut, pc + 4, target, taken=0)\n    await _lookup(dut, pc + 4, 0, target)\n    await _update(dut, pc, target, taken=1)\n    await _update(dut, pc\n…[5610 of 8682 chars elided by tools/bench/transcript.py; sha256:551d2666250826d8]…\nsC.html\nbench/programs/coremark/docs/html/search/NoResults.html\nbench/programs/coremark/docs/html/search/FunctionsP.html\nbench/programs/coremark/docs/html/search/GeneralT.html\nbench/programs/coremark/docs/html/search/FilesC.html\nbench/programs/coremark/docs/html/search/GeneralS.html\nbench/programs/coremark/docs/html/search/GeneralF.html\nbench/programs/coremark/docs/html/search/VariablesD.html\nbench/programs/coremark/docs/html/search/GeneralD.html\nbench/programs/coremark/docs/html/search/ConfigurationsT.html\nbench/programs/coremark/docs/html/search/GeneralL.html\nbench/programs/coremark/docs/html/search/VariablesO.html\nbench/programs/coremark/docs/html/search/FilesR.html\nbench/programs/coremark/docs/html/search/FunctionsS.html\nbench/programs/coremark/docs/html/search/FunctionsT.html\nbench/programs/coremark/docs/html/search/ConfigurationU.html\nbench/programs/coremark/docs/html/search/VariablesS.html\nbench/programs/coremark/docs/html/search/TypesS.html\nbench/programs/coremark/docs/html/search/ConfigurationS.html\n", "exit_code": 0, "status": "completed"}}
