{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor name in ('shifter','rightshift','fwd3'):\n base=Path('cores/bench/generated/r11-'+name);shutil.copytree('cores/bench/rtl',base/'rtl',dirs_exist_ok=True)\nfor name in ('shifter','rightshift'):\n p=Path('cores/bench/generated/r11-'+name+'/rtl/alu.sv');s=p.read_text();i=s.index('  always_comb begin')\n if name=='shifter':\n  extra='''  wire left_shift = op == ALU_SLL;\n  wire [31:0] reverse_a, shift_input, shift_raw, shift_result;\n  wire signed [32:0] shift_extended;\n  wire signed [32:0] shift_extended_result;\n  for (genvar g=0; g<32; g++) begin : g_reverse\n    assign reverse_a[g] = a[31-g];\n    assign shift_result[g] = left_shift ? shift_raw[31-g] : shift_raw[g];\n  end\n  assign shift_input = left_shift ? reverse_a : a;\n  assign shift_extended = \"'$signed({(op == ALU_SRA) && a[31], shift_input});\n  assign shift_extended_result = shift_extended >>> b[4:0];\n  assign shift_raw = shift_extended_result[31:0];\n'\"'''\n  s=s[:i]+extra+s[i:];s=s.replace('ALU_SLL:    out = a << shamt;', 'ALU_SLL:    out = shift_result;').replace('ALU_SRL:    out = a >> shamt;', 'ALU_SRL:    out = shift_result;').replace('ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','ALU_SRA:    out = shift_result;')\n  s=s.replace('  logic        [4:0]  shamt;','').replace('    shamt = b[4:0];','')\n else:\n  extra='''  wire signed [32:0] shift_extended;\n  wire signed [32:0] shift_extended_result;\n  assign shift_extended = \"'$signed({(op == ALU_SRA) && a[31], a});\n  assign shift_extended_result = shift_extended >>> b[4:0];\n'\"'''\n  s=s[:i]+extra+s[i:];s=s.replace('ALU_SRL:    out = a >> shamt;','ALU_SRL:    out = shift_extended_result[31:0];').replace('ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','ALU_SRA:    out = shift_extended_result[31:0];')\n # Extra bit is discarded by architectural output.\n s=s.replac