{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py; sed -n '1,260p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 \n…[10712 of 13784 chars elided by tools/bench/transcript.py; sha256:a541b1b13de06125]…\nex_insn\"])) & 0xFFFFFFFF\n        should_train = int(s[\"ex_valid\"] and branch and branch_target & 3 == 0\n                           and not s[\"hold_ex\"] and not s[\"wait\"] and not s[\"mul_repair\"])\n        assert s[\"train\"] == should_train, \"branch trained while held, invalid, or unqualified\"\n        if should_train:\n            taken = int(_branch_condition(s[\"ex_insn\"], s[\"rs1\"], s[\"rs2\"]))\n            index = (s[\"ex_pc\"] >> 2) & 63\n            assert (s[\"train_index\"], s[\"train_taken\"]) == (index, taken)\n            counters[index] = min(3, counters[index] + 1) if taken else max(0, counters[index] - 1)\n            trained_events.append((cycle, s[\"ex_pc\"]))\n        if s[\"repair\"]:\n            expected_pc = s[\"repair_target\"]\n        elif s[\"accept\"]:\n            expected_pc = target if prediction else (s[\"ia\"] + 4) & 0xFFFFFFFF\n\n        # Independently model nearest writer selection, readiness and retention.\n        # Unavailable producers remain in EX (divider) or MEM (unaccepted load).\n        selected = []\n", "exit_code": 0, "status": "completed"}}
