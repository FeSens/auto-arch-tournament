{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport sys,json\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('bench/programs/coremark.elf')\nactive=False; counts={k:[0,0] for k in ('SRL','SRA')}\nfor n in range(10000000):\n    insn=cpu.rw(cpu.pc);op=insn&127;fn3=insn>>12&7;fn7=insn>>25\n    if active and op in (0x13,0x33) and fn3==5 and fn7 in (0,32):\n        a=cpu.regs[insn>>15&31];amount=(insn>>20 if op==0x13 else cpu.regs[insn>>20&31])&31\n        sign=fn7==32;narrow=a&65535\n        if sign and narrow&32768:narrow-=65536\n        original=a-(1<<32) if sign and a&0x80000000 else a\n        c=counts['SRA' if sign else 'SRL'];c[0]+=1;c[1]+=(narrow>>amount)==(original>>amount)\n    r=cpu.step()\n    if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n    if r['mem_wmask'] and r['mem_addr']==0x10000104: active=False\n    if insn==0x00100073:break\nprint(json.dumps({'bracketed_counts':counts,'match_pct':{k:100*v[1]/v[0] for k,v in counts.items()}}))\nprint('Acceptance ratio at 59.885 MHz and 4275479 cycles:',(59.885/58.252)*(4201709/4275479))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
