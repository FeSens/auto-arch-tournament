{"type": "item.completed", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'Usage|--|coremark_cycles|markers|start|stop|istall|dstall' test/cosim/main.cpp | tail -65 && sed -n '1,100p' bench/programs/coremark/baremetal/core_portme.c\"", "aggregated_output": "32:// Benchmark-time MMIO markers. CoreMark's portme.c writes to BENCH_START\n33:// from start_time() and BENCH_STOP from stop_time(); the sim records the\n35:// bench_cycles = stop - start, excluding init/CRC-printing overhead.\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n67:    // --bench:  suppress per-retirement output; print only the final record.\n68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\n69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\n74:    bool istall = false;\n75:    bool dstall = false;\n77:        if      (std::strcmp(argv[i], \"--bench\")  == 0) bench_mode = true;\n78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\n79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\n80:        else if (std::strcmp(argv[i], \"--seed\")   == 0 && i + 1 < argc)\n111:    uint64_t bench_start_cycle = 0, bench_stop_cycle = 0;\n112:    bool     bench_start_set = false, bench_stop_set = false;\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n131:        //     allowed (markers); anything else outside dmem is OOB (handled\n152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\n157:                if (!bench_start_set) { bench_start_cycle = cycle; bench_start_set = true; }\n159:                // Last stop_time() call wins — CoreMark calls it once, but\n161:                bench_stop_cycle = cycle; bench_stop_set = true;\n268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n273:               (unsigned long long)bench_start_cycle,\n274:               (unsigned long long)bench_stop_cycle,\n275:               (bench_start_set && bench_stop_set) ? \"true\" : \"false\",\n#include \"coremark.h\"\n#include <stdint.h>\n#include <stdarg.h>\n\n#define UART_TX     (*(volatile uint32_t*)0x10000000)\n/* MMIO markers the sim uses to record cycle counts at start_time/stop_time.\n * \n…[2531 of 5603 chars elided by tools/bench/transcript.py; sha256:b80c1f8816a26758]…\n, t_end;\nvoid       start_time(void)              { BENCH_START = 1; t_start = 0; }\nvoid       stop_time(void)               { BENCH_STOP  = 1; t_end   = 0; }\nCORE_TICKS get_time(void)                { return t_end - t_start; }\nCORE_TICKS baremetal_timer_read(void)    { return 0; }\nee_u32     time_in_secs(CORE_TICKS ticks) { (void)ticks; return 10; }\n\nvolatile ee_u32 seed1_volatile = 0;\nvolatile ee_u32 seed2_volatile = 0;\nvolatile ee_u32 seed3_volatile = 0x66;\nvolatile ee_u32 seed4_volatile = ITERATIONS;  /* run exactly ITERATIONS, skip auto-detect */\n/* seed5 = execs bitmask. Must be ALL_ALGORITHMS_MASK (7) — list's\n * core_list_mergesort calls calc_func which unconditionally invokes\n * core_bench_state/core_bench_matrix via res->memblock[3]/memblock[2].\n * With seed5=1 (list-only), those memblocks stay NULL and the benches\n * dereference a null pointer. This is the reason crclist came out 0x263b\n * instead of 0xd4b0 — the state/matrix calls read garbage (or faulted). */\nvolatile ee_u32 seed5_volatile = 7;\n\n", "exit_code": 0, "status": "completed"}}
