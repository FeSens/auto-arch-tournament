ata = w_data;\n-    else\n-      rs1_data = regs[rs1_addr];\n-\n-    if (rs2_addr == 5'b0)\n-      rs2_data = 32'b0;\n-    else if (w_en && w_addr == rs2_addr)\n-      rs2_data = w_data;\n-    else\n-      rs2_data = regs[rs2_addr];\n+    // Bypass remains combinational even during reset, matching the\n+    // original write-first interface; reset only controls stored state.\n+    rs1_data = w_data & {32{w_en && w_addr != 5'b0 && w_addr == rs1_addr}};\n+    rs2_data = w_data & {32{w_en && w_addr != 5'b0 && w_addr == rs2_addr}};\n+    // x0 never participates. Exactly one stored word or bypass can\n+    // contribute, including when both ports read the current writer.\n+    for (int i = 1; i < 32; i++) begin\n+      rs1_data = rs1_data | (regs[i] & {32{read1_sel[i] && !write_sel[i]}});\n+      rs2_data = rs2_data | (regs[i] & {32{read2_sel[i] && !write_sel[i]}});\n+    end\n   end\n \n endmodule\n","exit_code":0,"status":"completed"}}
