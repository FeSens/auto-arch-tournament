pedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[6541 of 9613 chars elided by tools/bench/transcript.py; sha256:b487397bc5a7c48c]…\nonstexpr uint32_t BENCH_START_ADDR = 0x10000100u;\n37:static constexpr uint32_t BENCH_STOP_ADDR  = 0x10000104u;\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\n69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\n70:    //           (tools/eval/fpga.py:run_coremark_ipc) passes BOTH so the\n74:    bool istall = false;\n75:    bool dstall = false;\n78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\n79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n131:        //     allowed (markers); anything else outside dmem is OOB (handled\n152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\n253:        // Emit final record, plus an explicit completion marker. Consumers MUST\n", "exit_code": 0, "status": "completed"}}
