{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl');base=Path('/srv/hwebench/tmp/b62664fd/8ea9497e')\nfor name in ('ramvalid64','raminit64'):\n dst=base/('r12s2-'+name)/'rtl'; dst.mkdir(parents=True,exist_ok=True)\n for p in src.glob('*.sv'): shutil.copyfile(p,dst/p.name)\n p=dst/'if_stage.sv';s=p.read_text().replace('logic [1:0] direction_q [0:63];','(* syn_ramstyle = \\\"distributed\\\" *) logic [1:0] direction_q [0:63];')\n if name=='ramvalid64':\n  s=s.replace('logic is_branch, is_jal, predicted_taken;','logic is_branch, is_jal, predicted_taken;\\\\n  logic [63:0] direction_valid_q;\\\\n  logic [1:0] train_counter;\\\\n  assign train_counter = direction_valid_q[branch_train_index] ? direction_q[branch_train_index] : 2\\\\'b10;')\n  s=s.replace('(is_branch && direction_q[pc[7:2]][1])',\\\"(is_branch && (\"'!direction_valid_q[pc[7:2]] || direction_q[pc[7:2]][1]))\")\n  begin=s.index('\"'  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      for (int i = 0; i < 64; i++) direction_q[i] <= 2\\\\'b10;')\n  end=s.index('\\\\n  assign imem_addr = pc;',begin)\n  s=s[:begin]+'''  always_ff @(posedge clock) begin\n    if (reset) direction_valid_q <= '0;\n    else if (branch_train_en) direction_valid_q[branch_train_index] <= 1'b1;\n    if (\"'!reset && branch_train_en) begin\n      if (branch_train_taken)\n        direction_q[branch_train_index] <= train_counter == 2'\"'b11 ? 2'b11 : train_counter + 2'b01;\n      else\n        direction_q[branch_train_index] <= train_counter == 2'b00 ? 2'b00 : train_counter - 2'b01;\n    end\n  end\n''' + s[end:]\n else:\n  s=s.replace('logic is_branch, is_jal, predicted_taken;','logic is_branch, is_jal, predicted_taken;\\\\n  logic [5:0] init_index_q;\\\\n  logic initialized_q;')\n  s=s.replace('(is_branch && direction_q[pc[7:2]][1])',\\\"(is_branch && (\"'!initialized_q || direction_q[pc[7:2]][1]))\")\n  begin=s.index('\"'  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      for (int i = 0; i < 64; i++) direction_q[i] <= 2\\\\'b10;')\n  end=s.index('\\\\n  assign imem_addr = pc;',begin)\n  s=s[:begin]+'''  always_ff @(posedge clock) begin\n    if (reset) begin\n      init_index_q <= 6'b0;\n      initialized_q <= 1'b0;\n    end else if (\"'!initialized_q) begin\n      direction_q[init_index_q] <= 2'\"'b10;\n      init_index_q <= init_index_q + 6'd1;\n      if (init_index_q == 6'd63) initialized_q <= 1'b1;\n    end else if (branch_train_en) begin\n      if (branch_train_taken) begin\n        if (direction_q[branch_train_index] \"'!= 2'\"'b11)\n          direction_q[branch_train_index] <= direction_q[branch_train_index] + 2'b01;\n      end else begin\n        if (direction_q[branch_train_index] \"'!= 2'\"'b00)\n          direction_q[branch_train_index] <= direction_q[branch_train_index] - 2'b01;\n      end\n    end\n  end\n''' + s[end:]\n p.write_text(s)\nprint('Two isolated predictor RAM prototypes prepared')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
