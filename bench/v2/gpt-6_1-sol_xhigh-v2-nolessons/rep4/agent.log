{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -c '\nimport re\nfrom pathlib import Path\nnet = Path(\\\"cores/bench/generated/topology/impl/pnr/core_bench.vo\\\").read_text()\ncells = {}\nfor kind, name, body in re.findall(r\\\"\"'^([A-Z][A-Z0-9_]*)'\"\\\\s+(\\\\S+)\\\\s+\\\\((.*?)\\\\);\\\", net, re.M | re.S):\n    ports = {port: re.sub(r\\\"\\\\s+\\\", \\\"\\\", signal) for port, signal in re.findall(r\\\"\\\\.(\\\\w+)\\\\(([\"'^()]*)'\"\\\\)\\\", body)}\n    cells[name] = (kind, ports)\ninits = dict(re.findall(r\\\"\"'^defparam'\"\\\\s+(\\\\S+)\\\\s+\\\\.INIT=([\"'^;]+);\", net, re.M))\ndrivers = {ports[output]: name for name, (kind, ports) in cells.items() for output in (\"F\", \"O\", \"Q\") if output in ports}\ndef leaves(signal, seen=None):\n    seen = set() if seen is None else seen\n    if signal in seen:\n        return set()\n    seen.add(signal)\n    name = drivers.get(signal)\n    if name is None or cells[name][0].startswith(\"DFF\"):\n        return {signal}\n    return set().union(*(leaves(s, seen) for p, s in cells[name][1].items() if p not in (\"F\", \"O\", \"Q\")))\nplane = lambda p, i: \"'\"\\\\\\\\cpu/u_if/\\\" + p + \\\"_q[\\\" + str(i) + \\\"]\\\"\nfor index in range(64):\n    p_name = \\\"\\\\\\\\cpu/u_if/prediction_q_\\\" + str(index) + \\\"_s0\\\"\n    s_name = \\\"\\\\\\\\cpu/u_if/confidence_q_\\\" + str(index) + \\\"_s0\\\"\n    p_kind, p = cells[p_name]\n    s_kind, s = cells[s_name]\n    assert p_kind == \\\"DFFSE\\\" and s_kind == \\\"DFFRE\\\"\n    assert p[\\\"Q\\\"] == plane(\\\"prediction\\\", index) and s[\\\"Q\\\"] == plane(\\\"confidence\\\", index)\n    assert p[\\\"D\\\"] == \\\"\\\\\\\\cpu/branch_train_taken\\\"\n    update_name = drivers[s[\\\"D\\\"]]\n    kind, update = cells[update_name]\n    assert kind == \\\"LUT2\\\" and inits[update_name].endswith(\\\"h9\\\")\n    assert {update[\\\"I0\\\"], update[\\\"I1\\\"]} == {plane(\\\"prediction\\\", index), \\\"\\\\\\\\cpu/branch_train_taken\\\"}\n    confidence_leaves = {signal for signal in leaves(p[\\\"CE\\\"]) if \\\"confidence_q[\\\" in signal}\n    assert confidence_leaves == {plane(\\\"confidence\\\", index)}, (index, confidence_leaves)\n    assert not any(\\\"confidence_q[\\\" in signal for signal in leaves(s[\\\"CE\\\"]))\nlookup = leaves(\\\"\\\\\\\\cpu/u_if/if_id_w.predicted_taken_3\\\")\nassert {signal for signal in lookup if \\\"prediction_q[\\\" in signal} == {plane(\\\"prediction\\\", i) for i in range(64)}\nassert not any(\\\"confidence_q[\\\" in signal or \\\"branch_train\\\" in signal for signal in lookup)\nprint(\\\"PASS: all 64 local confidence XNORs, all 64 local confidence-controlled prediction enables, reset/set flip-flop types, prediction-only 64-entry fetch mux.\\\")\nprint(\\\"Lookup leaves:\\\", len(lookup), \\\"(64 prediction bits and six PC index bits)\\\")\n' \"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
