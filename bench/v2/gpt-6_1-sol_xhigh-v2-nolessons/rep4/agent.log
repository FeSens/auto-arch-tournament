 pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN\n…[6045 of 9117 chars elided by tools/bench/transcript.py; sha256:6e18a8ad8d0d33a6]…\n        options=PLACE_OPTIONS) -> list[dict]:\n    from tools.eval._slots import eval_slot\n    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\n        futs = [ex.submit(build, worktree, rtl_dir, bench_sv, p,\n                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\n        return [f.result() for f in futs]\n\n\ndef summarize(results: list[dict]) -> dict:\n    \"\"\"Median Fmax over placement options; every option must fit (the flow\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 91.186\n  lut4: 4222\n  ff: 1329\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261005-001-r9s0\n  updated: '2026-10-05T06:14:53.169856Z'\n", "exit_code": 0, "status": "completed"}}
