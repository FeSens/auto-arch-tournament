alid\"] and out[\"pc\"] == pc and out[\"predicted_taken\"] == 1\n        assert (out[\"rs1_val\"], out[\"rs2_val\"]) == (pc + 7, pc + 11)\n        assert out[\"alu_a_val\"] == (pc if control & (1 << 8) else pc + 7)\n        assert out[\"alu_b_val\"] == (imm if control & (1 << 16) else pc + 11)\n    dut[\"in\"].value = 0\n    awai\n…[6562 of 9634 chars elided by tools/bench/transcript.py; sha256:8020e560230a9dc2]…\nt)\n            out = _unpack(ID_FIELDS, int(dut.out.value))\n            assert (out[\"rs1_val\"], out[\"rs2_val\"]) == (expected[1], expected[2])\n            assert out[\"alu_a_val\"] == (0x100 if control & (1 << 8) else expected[1])\n            assert out[\"alu_b_val\"] == (0xF1234000 if control & (1 << 16) else expected[2])\n            assert not int(dut.rs1_ready_q.value) and not int(dut.rs2_ready_q.value)\n            # The next instruction must use fresh snapshots on the next edge.\n            dut.ex_writer.value = dut.mem_writer.value = dut.wb_writer.value = 0\n            dut[\"in\"].value = instruction(pc=0x104, a=13, b=17)\n            await _tick(dut)\n            out = _unpack(ID_FIELDS, int(dut.out.value))\n            assert (out[\"rs1_val\"], out[\"rs2_val\"], out[\"alu_a_val\"], out[\"alu_b_val\"]) == (13, 17, 13, 17)\n\n\n@cocotb.test()\nasync def pc_and_immediate_do_not_bypass_blocked_architectural_sources(dut):\n    \"\"\"PC/immediate operands coexist with separately resolved raw RVFI fields.\"\"\"\n    for source in (1, 2):\n", "exit_code": 0, "status": "completed"}}
