{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/b62664fd/0cebedcc/branch_validate_probe/rtl')\nroot=Path('/srv/hwebench/tmp/b62664fd/0cebedcc/control_validate_probe'); rtl=root/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in base.glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv';s=p.read_text();s=s.replace('''    logic        predicted_taken;\n    logic        valid;''','''    logic        predicted_taken;\n    logic [31:0] predicted_pc;\n    logic        valid;''',2);p.write_text(s)\np=rtl/'id_stage.sv';s=p.read_text();s=s.replace('''      reg_q.predicted_taken <= in.predicted_taken;''','''      reg_q.predicted_taken <= in.predicted_taken;\n      reg_q.predicted_pc <= in.predicted_pc;''');p.write_text(s)\np=rtl/'if_stage.sv';s=p.read_text();s=s.replace('''  input  logic              branch_train_en,''','''  input  logic              jalr_train_en,\n  input  logic [31:0]        jalr_train_pc,\n  input  logic [31:0]        jalr_train_target,\n  input  logic              branch_train_en,''');s=s.replace('''  logic is_branch, is_jal, predicted_taken;''','''  logic is_branch, is_jal, is_jalr, jalr_hit, predicted_taken;\n  logic [7:0] jalr_valid_q;\n  logic [26:0] jalr_tag_q [0:7];\n  logic [29:0] jalr_target_q [0:7];''');s=s.replace('''    is_jal = imem_data[6:0] == 7'h6f;''','''    is_jal = imem_data[6:0] == 7'h6f;\n    is_jalr = imem_data[6:0] == 7'h67 && imem_data[14:12] == 3'b000;\n    jalr_hit = jalr_valid_q[pc[4:2]] && jalr_tag_q[pc[4:2]] == pc[31:5];''');s=s.replace('''    next_pc = predicted_taken ? direct_target : pc + 32'd4;''','''    next_pc = is_jalr && jalr_hit ? {jalr_target_q[pc[4:2]],2'b00}\n            : predicted_taken ? direct_target : pc + 32'd4;''');s=s.replace('''  assign imem_addr = pc;''','''  always_ff @(posedge clock) begin\n    if (reset) jalr_valid_q <= 8'b0;\n    else if (jalr_train_en) begin\n      jalr_valid_q[jalr_train_pc[4:2]] <= 1'b1;\n      jalr_tag_q[jalr_train_pc[4:2]] <= jalr_train_pc[31:5];\n      jalr_target_q[jalr_train_pc[4:2]] <= jalr_train_target[31:2];\n    end\n  end\n\n  assign imem_addr = pc;''');s=s.replace('''    out.predicted_taken = predicted_taken;''','''    out.predicted_taken = predicted_taken;\n    out.predicted_pc = next_pc;''');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text();s=s.replace('''    misalign_jump   = in.valid && in.ctrl.is_jump && (jump_target[1:0] \"'!= 2'\"'b00);''','''    misalign_jump   = in.valid && in.ctrl.is_jump && \"'!in.ctrl.is_jalr && (jump_target[1:0] != 2'\"'b00);''');start=s.index('  assign redirect =');end=s.index('  // ── EX/MEM register',start);s=s[:start]+'''  assign redirect = 1'b0;\n  assign redirect_target = 32'b0;\n\n'''+s[end:];s=s.replace('''                                   : in.ctrl.is_jump ? jump_target''','''                                   : in.ctrl.is_jalr ? in.predicted_pc\n                                   : in.ctrl.is_jump ? jump_target''');s=s.replace('''      exec_payload.branch_target = branch_target;''','''      exec_payload.branch_target = in.ctrl.is_jalr ? jump_target : branch_target;''');p.write_text(s)\np=rtl/'mem_stage.sv';s=p.read_text();s=s.replace('''  output logic               branch_train_en,''','''  output logic               jalr_train_en,\n  output logic [31:0]        jalr_train_pc,\n  output logic [31:0]        jalr_train_target,\n  output logic               branch_train_en,''');s=s.replace('''  logic branch_cond, branch_fault, branch_actual, branch_miss;\n  logic [31:0] branch_next;''','''  logic branch_cond, branch_fault, branch_actual, branch_miss;\n  logic jalr_fault, jalr_miss;\n  logic [31:0] branch_next, resolved_next;\n  assign jalr_fault = in.valid && in.ctrl.is_jalr && in.branch_target[1:0] \"'!= 2'\"'b00;\n  assign resolved_next = in.ctrl.is_branch ? branch_next : in.ctrl.is_jalr ?\n                         (jalr_fault ? in.pc +