$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[12757 of 15829 chars elided by tools/bench/transcript.py; sha256:7192128ade58dd88]…\n), REMU(8, 1, 0), DIVU(0, 1, 2), ADDI(9, 0, 3),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, dmem_init={0x100: 0x80000000}, max_cycles=160)\n    expected = {3: 0x80000000, 4: 0, 5: 0xFFFFFFFF, 6: 0x80000000,\n                7: 0xFFFFFFFF, 8: 0x80000000, 9: 3}\n    for r in rets:\n        assert not r[\"trap\"]\n        if r[\"rd\"] in expected:\n            assert r[\"rd_wdata\"] == expected[r[\"rd\"]]\n    [zero_destination] = _by_insn(rets, DIVU(0, 1, 2))\n    assert zero_destination[\"rd\"] == 0 and zero_destination[\"rd_wdata\"] == 0\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
