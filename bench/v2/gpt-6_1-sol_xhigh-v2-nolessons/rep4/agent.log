{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport struct,collections,json,sys\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('/srv/hwebench/tmp/b62664fd/bbb89c33/predictor-coremark.elf')\nrecords=list(struct.iter_unpack('<IIIIIII',Path('/srv/hwebench/tmp/b62664fd/bbb89c33/predictor_trace.bin').read_bytes()))\ntables={n:{} for n in (32,64,128,256)};counts={n:collections.Counter() for n in tables};regs=[0]*32\nfor i,(pc,ins,value,addr,npc,order,active) in enumerate(records):\n op=ins&127;rd=(ins>>7)&31;fn=(ins>>12)&7\n if op==3:\n  word=cpu.rw(addr&~3)\n  nextins=records[i+1][1] if i+1<len(records) else 0\n  dep=rd and rd in ((nextins>>15)&31,(nextins>>20)&31)\n  for size,table in tables.items():\n   idx=(addr>>2)&(size-1);old=table.get(idx);hit=old is not None and old[0]==addr>>2\n   if hit:\n    pred=(old[1]>>((addr&3)*8))&((1<<(8 if fn in (0,4) else 16 if fn in (1,5) else 32))-1)\n    if fn in (0,1) and pred>>(7 if fn==0 else 15):pred=(pred|(-1<<(8 if fn==0 else 16)))&0xffffffff\n   else:pred=0\n   if active:\n    counts[size]['loads']+=1;counts[size]['hits']+=hit;counts[size]['correct']+=hit and pred==value;counts[size]['misses']+=not hit;counts[size]['dep_misses']+=not hit and bool(dep);counts[size]['prediction_failures']+=hit and pred\"'!=value\n   table[idx]=(addr>>2,word)\n elif op==0x23 and addr<0x100000:\n  rs2=(ins>>20)&31;sv=regs[rs2]\n  if fn==0:cpu.wb(addr,sv)\n  elif fn==1:cpu.whw(addr,sv)\n  else:cpu.ww(addr,sv)\n  for size,table in tables.items():\n   idx=(addr>>2)&(size-1);old=table.get(idx)\n   if fn==2 or (old is not None and old[0]==addr>>2):table[idx]=(addr>>2,cpu.rw(addr&~3))\n if op in (3,0x13,0x33,0x37,0x17,0x6f,0x67) and rd:regs[rd]=value\n regs[0]=0\nprint(json.dumps({n:dict(c) for n,c in counts.items()},indent=2))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
