{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/mem_stage.sv cores/bench/test/test_pipeline.py; cat cores/bench/test/test_mul_repair.py'", "aggregated_output": "diff --git a/cores/bench/rtl/mem_stage.sv b/cores/bench/rtl/mem_stage.sv\nindex da8bb11..5c37beb 100644\n--- a/cores/bench/rtl/mem_stage.sv\n+++ b/cores/bench/rtl/mem_stage.sv\n@@ -47,6 +47,7 @@ module mem_stage (\n );\n \n   logic is_mul;\n+  logic product_certified;\n   logic [31:0] exact_product;\n   assign is_mul = in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH ||\n                   in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU;\n@@ -56,11 +57,26 @@ module mem_stage (\n     .b (in.rs2_val),\n     .out (exact_product)\n   );\n+`ifdef RISCV_FORMAL_ALTOPS\n+  // Both helpers use identical stand-ins on the original full-width sources.\n+  assign product_certified = 1'b1;\n+`else\n+  // Sufficient correctness certificates avoid putting the exact multiplier\n+  // on recovery's control path. A failed certificate conservatively replays\n+  // even when the prediction happens to match; WB always gets exact_product.\n+  // MUL predicts a signed 16x16 product. High-product predictions are zero\n+  // and are exact for two unsigned 16-bit sources, whose product fits in 32 bits.\n+  assign product_certified = !(|in.rs1_val) || !(|in.rs2_val) ||\n+                             (in.ctrl.alu_op == ALU_MUL\n+                              ? (in.rs1_val[31:16] == {16{in.rs1_val[15]}} &&\n+                                 in.rs2_val[31:16] == {16{in.rs2_val[15]}})\n+                              : (!(|in.rs1_val[31:16]) && !(|in.rs2_val[31:16])));\n+`endif\n   // Only an advancing writer can have a consumed prediction. x0 has no\n   // consumers. EX bubbles on repair, so this fires once per multiplication.\n   assign mul_repair = !reset && !hold_wb && in.valid && is_mul &&\n                       !in.ctrl.is_illegal && in.ctrl.reg_write && in.rd != 5'b0 &&\n-                      exact_product != in.alu_result;\n+                      !product_certified;\n   assign mul_repair_target = in.pc_next;\n \n   logic [31:0] wdata_rep;\ndiff --git a/cores/bench/test/test_pipeline.py b/cores/bench/test/test_pipeline.py\nindex dc64dc8..3fae925 100644\n--- a\n…[15538 of 18610 chars elided by tools/bench/transcript.py; sha256:86bba24c85186f53]…\n  dut.reset.value = 0\n        dut.hold_wb.value = 0\n\n    payload = _payload(ALU_ADD, MASK, MASK, 0x89ABCDEF)\n    dut[\"in\"].value = _pack(EX_FIELDS, payload)\n    await Timer(1, \"ns\")\n    assert not int(dut.mul_repair.value)\n    await _tick(dut)\n    _check_wb(dut, payload, payload[\"alu_result\"])\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_mul_repair_runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"mem_mul_repair_altops\" if altops else \"mem_mul_repair\")\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"mul_exact.sv\", \"mem_stage.sv\")],\n        hdl_toplevel=\"mem_stage\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1} if altops else {},\n        build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"],\n    )\n    runner.test(\n        hdl_toplevel=\"mem_stage\", test_module=\"test_mul_repair\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), extra_env={\"MUL_REPAIR_ALTOPS\": str(int(altops))},\n    )\n", "exit_code": 0, "status": "completed"}}
