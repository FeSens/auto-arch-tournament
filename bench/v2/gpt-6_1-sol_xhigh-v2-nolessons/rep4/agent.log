uipc;\n  assign alu_b_near = fwd_rs2_sel[1] && !in.ctrl.alu_src;\n  assign alu_b_far  = fwd_rs2_sel[2] && !in.ctrl.alu_src;\n  assign alu_b_load = fwd_rs2_sel[3] && !in.ctrl.alu_src;\n  assign alu_a = ({32{!(alu_a_near || alu_a_far || alu_a_load)}} & in.alu_a_val) |\n                 ({32{alu_a_near}} & fwd_ex_mem) |\n                 ({32{alu_a_far}} & fwd_mem_wb) |\n                 ({32{alu_a_load}} & fwd_mem_wb_load);\n  assign alu_b = ({32{!(alu_b_near || alu_b_far || alu_b_load)}} & in.alu_b_val) |\n                 ({32{alu_b_near}} & fwd_ex_mem) |\n                 ({32{alu_b_far}} & fwd_mem_wb) |\n                 ({32{alu_b_load}} & fwd_mem_wb_load);\n\n  logic [31:0] alu_result;\n  logic [31:0] predicted_product;\n  logic [31:0] div_result;\n  logic div_busy, div_result_valid, div_start, div_consume, is_div, is_mul;\n  ex_mem_t div_payload_q;\n  ex_mem_t exec_payload;\n\n  assign is_div = in.ctrl.alu_op == ALU_DIV || in.ctrl.alu_op == ALU_DIVU ||\n                  in.ctrl.alu_op == ALU_REM || in.ctrl.alu_op == ALU_REMU;\n  assign is_mul = in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH ||\n                  in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU;\n  assign div_start = in.valid && is_div && !stall && !squash && !div_busy;\n  assign div_consume = div_busy && div_result_valid && !stall && !squash;\n  // Release ID/EX on the very edge that accepts the result. busy stays\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"sed -n '1,120p' bench/programs/Makefile; sed -n '1,200p' formal/run_all.sh; sed -n '1,100p' formal/checks_si.cfg; rg --files formal | head -25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,120p' bench/programs/Makefile; sed -n '1,200p' formal/run_all.sh; sed -n '1,100p' formal/checks_si.cfg; rg --files formal | head -25\"", "aggregated_output": "CROSS   := riscv32-unknown-elf\nCC      := $(CROSS)-gcc\n\n# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\n# (2K data size, -O3); tools/eval/fpga.py's COREMARK_EXPECTED CRCs assume\n# exactly these defaults.\n# - COREMARK_SIZE: TOTAL_DATA_SIZE in coremark.h (#ifndef-guarded). 2000 is\n#   the EEMBC canonical reporting config (used by VexRiscv et al.); 6000\n#   makes the matrix/list/state working sets ~3x larger so the score is\n#   harder to inflate via register-resident working sets.\n# - COREMARK_OPT: gcc optimization. -O3 is the standard CoreMark publication\n#   flag; -O2 is what the V0 baseline used.\n# Defaults match VexRiscv's published CoreMark methodology so the\n# orchestrator's fitness number is directly comparable to public CoreMark\n# results. To override (e.g. for the prior 6K -O2 V0 baseline):\n#     make bench/programs/coremark.elf COREMARK_SIZE=6000 COREMARK_OPT=-O2\nCOREMARK_SIZE ?= 2000\nCOREMARK_OPT  ?= -O3\n\nCFLAGS  := -march=rv32im -mabi=ilp32 $(COREMARK_OPT) -static -nostartfiles \\\n           -specs=nano.specs -specs=nosys.specs \\\n           -T bench/programs/link.ld -Ibench/programs/coremark \\\n           -Ibench/programs/coremark/baremetal \\\n           -DTOTAL_DATA_SIZE=$(COREMARK_SIZE)\n\nSRCS := bench/programs/coremark/core_list_join.c \\\n        bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/pro\n…[9525 of 12597 chars elided by tools/bench/transcript.py; sha256:e394da6da6a0b559]…\np from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\nformal/checks_si.cfg\nformal/wrapper.sv\nformal/run_all.sh\nformal/checks-deep.cfg\nformal/checks.cfg\nformal/wrapper_si.sv\n", "exit_code": 0, "status": "completed"}}
