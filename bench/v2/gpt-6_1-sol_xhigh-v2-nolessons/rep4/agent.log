{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_fetch_predictor.py')\ns=p.read_text()\nPath('/srv/hwebench/tmp/b62664fd/357c4a3b/bench_test_fetch_original.py').write_text(s)\nloc=s.index('\\\\ndef test_fetch_predictor_runner')\naddition='''\n@cocotb.test()\nasync def mixed_training_matches_saturating_reference(dut):\n    import random\n    rng = random.Random(0xB1A0DA1)\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.accept.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.branch_train_en.value = 0\n    dut.branch_train_index.value = 0\n    dut.branch_train_taken.value = 0\n    dut.imem_data.value = BEQ(0, 0, 8)\n    await _tick(dut)\n    dut.reset.value = 0\n    reference = [2] * 64\n    transitions = set()\n    for cycle in range(2048):\n        read_index = rng.randrange(64)\n        await _pc(dut, read_index * 4 + (256 if cycle % 3 == 0 else 0))\n        assert _payload(dut)[2] == (reference[read_index] >> 1)\n        train_index = read_index if cycle % 2 == 0 else rng.randrange(64)\n        outcome = rng.randrange(2)\n        enable = cycle % 7 \"'!= 0\n        reset = cycle % 499 == 498\n        dut.branch_train_en.value = enable\n        dut.branch_train_index.value = train_index\n        dut.branch_train_taken.value = outcome\n        dut.reset.value = reset\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == (reference[read_index] >> 1)\n        before = reference[train_index]\n        await _tick(dut)\n        if reset:\n            reference = [2] * 64\n            read_index = 0\n        elif enable:\n            transitions.add((before, outcome))\n            reference[train_index] = min(3, before + 1) if outcome else max(0, before - 1)\n        assert _payload(dut)[2] == (reference[read_index] >> 1)\n        dut.branch_train_en.value = 0\n        dut.reset.value = 0\n    assert transitions == {(state, outcome) for state in range(4) for outcome in range(2)}\n\n'\"'''\np.write_text(s[:loc]+addition+s[loc:])\nprint('Added mixed predictor reference probe')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
