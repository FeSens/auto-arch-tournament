{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python3 -c '\nimport json, subprocess\np = subprocess.Popen([\\\"cores/bench/obj_dir/cosim_sim\\\", \\\"bench/programs/coremark.elf\\\", \\\"50000000\\\", \\\"--istall\\\", \\\"--dstall\\\"], stdout=subprocess.PIPE, text=True)\nactive = False\ncounts, hits, repairs = [0]*4, [0]*4, [0]*4\norder, retired, markers = -1, 0, []\ndef signed(value, bits):\n    return ((value & ((1 << bits)-1)) \"'^ (1 << (bits-1))) - (1 << (bits-1))\nfor line in p.stdout:\n    r = json.loads(line)\n    assert r[\"order\"] == order + 1\n    order = r[\"order\"]\n    retired += 1\n    if r[\"mem_wmask\"] and r[\"mem_addr\"] in (0x10000100, 0x10000104):\n        active = r[\"mem_addr\"] == 0x10000100\n        markers.append((r[\"mem_addr\"], r[\"cycle\"]))\n    insn = r[\"insn\"]\n    if insn & 127 != 0x33 or insn >> 25 != 1 or (insn >> 12) & 7 >= 4:\n        continue\n    op = (insn >> 12) & 7\n    a, b = r[\"rs1_rdata\"], r[\"rs2_rdata\"]\n    exact = [a*b, (signed(a,32)*signed(b,32)) >> 32, (signed(a,32)*b) >> 32, (a*b) >> 32][op] & 0xffffffff\n    assert not r[\"trap\"]\n    assert r[\"rd_wdata\"] == (exact if r[\"rd_addr\"] else 0)\n    predicted = (signed(a,9)*signed(b,9)) & 0xffffffff if op == 0 else 0\n    if active:\n        counts[op] += 1\n        hits[op] += predicted == exact\n        repairs[op] += bool(r[\"rd_addr\"] and predicted != exact)\nassert p.wait() == 0\nassert insn == 0x00100073\nprint(json.dumps({\"retirements\":retired, \"markers\":markers, \"variant_order\":[\"MUL\",\"MULH\",\"MULHSU\",\"MULHU\"], \"timed_products\":counts, \"prediction_hits\":hits, \"nonzero_destination_misses\":repairs}, indent=2))\n'\"' > \\\"\"'$TMPDIR/coremark-multiply-profile-native9.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
