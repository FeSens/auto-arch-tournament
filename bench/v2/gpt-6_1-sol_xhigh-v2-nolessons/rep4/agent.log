{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_divider.py; cat Makefile; cat formal/run_all.sh; cat cores/bench/core.yaml'", "aggregated_output": "\"\"\"Execute-stage transaction checks with downstream acceptance held off.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIVU, run_cocotb\n\n\nID_FIELDS = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n             (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n             (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, **values):\n    result = 0\n    for name, width in fields:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(fields, value):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = value & ((1 << width) - 1)\n        value >>= width\n    return result\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\n@cocotb.test()\nasync def completion_waits_for_acceptance(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.squash.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Put an older store into EX/MEM, then hold it with dmem backpressure.\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x20, rs2_val=0x55,\n                            ctrl=1 << 6, instr=0x00202023, valid=1)\n    await _tick(dut)\n    older = int(dut.out.value)\n    assert older != 0\n\n    instruction = 0x0220D1B3  # DIVU x3,x1,x2\n    control = (ALU_DIVU << 17) | (1 << 2)  # alu_op, reg_write\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x24, rs1_val=999, rs2_val=999,\n                    \n…[20209 of 23281 chars elided by tools/bench/transcript.py; sha256:c140418d1dd0bcf8]…\nmal['detail'] and the\n    # orchestrator now records that in experiments/log.jsonl, so what we\n    # print here is what shows up as the diagnostic for the failed run.\n    first=\"${FAILED[0]}\"\n    if [ -f \"$first/logfile.txt\" ]; then\n        echo \"\"\n        echo \"--- $first/logfile.txt (last 30 lines) ---\"\n        tail -30 \"$first/logfile.txt\"\n    fi\n    echo \"\"\n    echo \"Full run log: $LOG\"\n    echo \"Per-check logs in: $CORE_DIR/checks/<check>/logfile.txt\"\nfi\n[ $FAIL -eq 0 ]\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 58.252\n  lut4: 3371\n  ff: 949\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261005-003-r3s2\n  updated: '2026-10-05T01:24:36.796209Z'\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nimport random\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm):\n…[39041 of 42113 chars elided by tools/bench/transcript.py; sha256:80e58852c3e37108]…\n Both sources are bypassed into the first MUL, then predicted products\n    # forward into consecutive multiplications without any recovery or bubble.\n    program = [ADDI(1, 0, -7), ADDI(2, 0, 9), MUL(3, 1, 2),\n               MUL(4, 3, 2), MUL(5, 4, 1), ADD(6, 5, 3), EBREAK()]\n    repairs = []\n    rets, _ = await _run(dut, program,\n                         observe=lambda c, s, ir, dr: repairs.append(c) if s[\"mul_repair\"] else None)\n    _check_arithmetic_trace(rets)\n    assert not repairs\n    assert all(b[\"cycle\"] == a[\"cycle\"] + 1 for a, b in zip(rets, rets[1:]))\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_predictor.sv\", \"mul_exact.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
