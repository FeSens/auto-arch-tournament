backpressure.\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x20, rs2_val=0x55,\n                            ctrl=1 << 6, instr=0x00202023, valid=1)\n    await _tick(dut)\n    older = int(dut.out.value)\n    assert older != 0\n\n    instruction = 0x0220D1B3  # DIVU x3,x1,x2\n    control = (ALU_DIVU << 17) | (1 << 2)  # alu_op, reg_write\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x24, rs1_val=999, rs2_val=999,\n                    \n…[1922 of 4994 chars elided by tools/bench/transcript.py; sha256:57f040498dc6d1c5]…\nlt[\"rs1_val\"], result[\"rs2_val\"], result[\"write_data\"]) == (100, 7, 7)\n    assert not int(dut.div_busy.value) and not int(dut.div_result_valid.value)\n    # Model ID/EX advancing on that same edge; no second emission follows.\n    dut[\"in\"].value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0 and not int(dut.div_busy.value)\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"mul_predictor.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_ex_divider.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_hazard.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\ncores/bench/test/test_fetch_predictor.py\ncores/bench/test/test_mul_predictor.py\n/srv/hwebench/tmp/b62664fd/785de347\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/oss-cad-suite/bin/sby\n", "exit_code": 0, "status": "completed"}}
