{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,json,collections,time\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('/srv/hwebench/tmp/b62664fd/5ff8b96b/ras_profile/coremark.elf');active=False;loads=[];recent=[];insns=[]\nfor i in range(10000000):\n r=cpu.step()\n if active:\n  insns.append((r['pc'],r['insn'],r['rd'],r['rd_wdata']))\n  if r['insn']&127==3:loads.append([len(insns)-1,r['pc'],r['rd'],r['rd_wdata'],r['mem_addr']])\n if r['mem_wmask'] and r['mem_addr']==0x10000100:active=True\n if r['mem_wmask'] and r['mem_addr']==0x10000104:break\ncounts=collections.Counter();by_pc=collections.defaultdict(collections.Counter)\nfor row in loads:\n idx,pc,rd,value,addr=row;used=False;first=False\n if rd:\n  for k in [1,2]:\n   if idx+k>=len(insns):break\n   ip,iw,wr,wv=insns[idx+k]\n   if rd in (((iw>>15)&31),((iw>>20)&31)):used=True;first|=k==1\n   if wr==rd:break\n row.extend([used,first]);counts['total']+=1;counts['used']+=used;counts['immediate']+=first\nout={'counts':dict(counts),'policies':{}}\nfor n in [16,32,64,128,256]:\n for policy in ['last','stride']:\n  for threshold in [0,1,2,3]:\n   tab=[None]*n;stats=collections.Counter()\n   for _,pc,rd,val,addr,used,first in loads:\n    ix=(pc>>2)&(n-1);old=tab[ix];hit=old is not None and old[0]==pc\n    candidate=(old[1]+(old[2] if policy=='stride' else 0))&0xffffffff if hit else 0\n    eligible=hit and old[3]>=threshold\n    right=hit and candidate==val\n    if eligible:\n     stats['predicted']+=1;stats['right']+=right;stats['wrong']+=not right\n     if used:stats['used']+=1;stats['used_right']+=right;stats['used_wrong']+=not right\n     if first:stats['immediate_right']+=right;stats['immediate_wrong']+=not right\n    if not eligible and used:stats['cold_used']+=1\n    delta=(val-old[1])&0xffffffff if hit else 0\n    confidence=min(3,old[3]+1) if right else max(0,old[3]-1) if hit else 0\n    tab[ix]=(pc,val,delta,confidence)\n   out['policies'][f'{policy}{n}_c{threshold}']=dict(stats)\nPath('/srv/hwebench/tmp/b62664fd/5ff8b96b/ras_profile/loads.json').write_text(json.dumps(loads))\nPath('/srv/hwebench/tmp/b62664fd/5ff8b96b/ras_profile/load_profile.json').write_text(json.dumps(out,indent=2));print(json.dumps(out,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
