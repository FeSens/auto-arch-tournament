{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport subprocess\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nscratch = Path(os.environ['TMPDIR'])\nchampion = str(scratch / 'champion-obj' / 'cosim_sim')\ncandidate = str(Path('cores/bench/obj_dir/cosim_sim').resolve())\ndef check(pair):\n    elf, stalled = pair\n    flags = ['--istall', '--dstall'] if stalled else []\n    runs = [subprocess.run([binary, str(elf), '50000000', *flags], capture_output=True, text=True, check=True) for binary in (champion, candidate)]\n    assert runs[0].stdout == runs[1].stdout, f'{elf.name} stalled={stalled}: trace changed'\n    print(elf.name, 'stalled=' + str(stalled), len(runs[1].stdout.splitlines()), 'identical retirement records and cycles')\nelfs = sorted(p for p in Path('bench/programs').glob('*.elf') if p.name \"'!= '\"'coremark.elf')\nwith ThreadPoolExecutor() as pool:\n    list(pool.map(check, [(elf, stalled) for elf in elfs for stalled in (False, True)]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
