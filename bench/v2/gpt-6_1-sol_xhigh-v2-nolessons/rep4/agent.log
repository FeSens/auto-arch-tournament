t/cosim/reference.py:2:\"\"\"RV32IM reference interpreter for the cosim. Mirrors the DUT's trap\ntest/cosim/reference.py:3:discipline so cosim traces stay aligned across illegal / misaligned\nbench/programs/Makefile:4:# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\nbench/programs/Makefile:7:# - COREMARK_SIZE: TOTAL_DATA_SIZE in coremark.h (#ifndef-guarded). 2000 is\nbench/programs/Makefile:16:#     make bench/programs/coremark.elf COREMARK_SIZE=6000 COREMARK_OPT=-O2\nbench/programs/Makefile:22:           -T bench/programs/link.ld -Ibench/programs/coremark \\\nbench/programs/Makefile:23:           -Ibench/programs/coremark/baremetal \\\nbench/programs/Makefile:26:SRCS := bench/programs/coremark/core_list_join.c \\\nbench/programs/Makefile:27:        bench/programs/coremark/core_main.c \\\nbench/programs/Makefile:28:        bench/programs/coremark/core_matrix.c \\\nbench/programs/Makefile:29:        bench/programs/coremark/core_state.c \\\nbench/programs/Makefile:30:        bench/programs/coremark/core_util.c \\\nbench/programs/Makefile:31:        bench/programs/coremark/baremetal/core_portme.c \\\nbench/programs/Makefile:34:bench/programs/coremark.elf: $(SRCS)\nbench/programs/Makefile:51:all: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_fetch_predictor.py'", "aggregated_output": "\"\"\"Instruction qualification, deterministic table reset, and read/write edges.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\ndef _payload(dut):\n    value = int(dut.out.value)\n    return value >> 34, (value >> 2) & 0xFFFFFFFF, (value >> 1) & 1, value & 1\n\n\nasync def _pc(dut, value):\n    dut.redirect.value = 1\n    dut.redirect_target.value = value\n    await _tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def reset_all_entries_and_same_edge_training(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.accept.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.branch_train_en.value = 0\n    dut.branch_train_index.value = 0\n    dut.branch_train_taken.value = 0\n    dut.imem_data.value = BEQ(0, 0, 8)\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Every entry starts weakly taken; one decrement crosses its threshold.\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut) == (index * 4, BEQ(0, 0, 8), 1, 1)\n        dut.branch_train_en.value = 1\n        dut.branch_train_index.value = index\n        dut.branch_train_taken.value = 0\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == 1, \"write changed prediction before the edge\"\n        await _tick(dut)\n        dut.branch_train_en.value = 0\n        assert _payload(dut)[2] == 0 and int(dut.imem_addr.value) == index * 4\n\n    # A reset restores all entries, including those whose MSB was cleared.\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut)[2] == 1\n\n    await _pc(dut, 0)\n    dut.branch_train_en.value = 1\n    dut.branch_train_index.value = 0\n    dut.branch_train_taken.value = 0\n    dut.accept.value = 1\n    await Timer(1, \"ns\")\n    accepted = _payload(dut)\n    assert accepted == (0, BEQ(0, 0, 8), 1, 1)\n    await _tick(dut)\n    assert int(dut.imem_addr.value) == 8, \"same-edge write altered accepted successor\"\n    dut.accept.value = 0\n    dut.branch_train_en.value = 0\n    await _pc(dut, 256)\n    assert _payload(dut)[2] == 0, \"PC[7:2] aliases did not share direction\"\n    dut.imem_data.value = JAL(1, -256)\n    await Timer(1, \"ns\")\n    assert _payload(dut)[2] == 1, \"JAL incorrectly depended on a not-taken table entry\"\n\n    # Flush invalidates the payload without replacing the raw instruction or\n    # altering predecode. Repair overrides disabled acceptance.\n    dut.flush.value = 1\n    await Timer(1, \"ns\")\n    assert _payload(dut) == (256, JAL(1, -256), 1, 0)\n    await _pc(dut, 0)\n    assert int(dut.imem_addr.value) == 0\n    dut.flush.value = 0\n    for instruction in (NOP(), JALR(1, 0, 8), _b(8, 0, 0, 2, 0x63),\n                        _b(8, 0, 0, 3, 0x63), BEQ(0, 0, 2), JAL(1, 2)):\n        dut.imem_data.value = instruction\n        dut.accept.value = 1\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == 0, f\"unqualified direct prediction: {instruction:#x}\"\n        previous = int(dut.imem_addr.value)\n        await _tick(dut)\n        assert int(dut.imem_addr.value) == previous + 4\n    dut.accept.value = 0\n    dut.imem_data.value = JAL(1, 8)\n    for _ in range(5):\n        previous = int(dut.imem_addr.value)\n        await _tick(dut)\n        assert int(dut.imem_addr.value) == previous\n\n\ndef test_fetch_predictor_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n               test_module=\"test_fetch_predictor\")\n", "exit_code": 0, "status": "completed"}}
