ry:\n        marker = json.loads(lines[-1])\n        last_retirement = json.loads(lines[-2])\n    except json.JSONDecodeError as e:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'malformed sim output: {e}'}\n\n    if not marker.get('ebreak', False):\n        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n        # a hung CPU with whatev\n…[16670 of 19742 chars elided by tools/bench/transcript.py; sha256:8cbced186540b7ac]…\nPath:\n3844:From              : stall_gen/state_11_s0\n3845:To                : stall_gen/state_11_s0\n3849:Data Arrival Path:\n3889:From              : stall_gen/state_21_s0\n3890:To                : stall_gen/state_21_s0\n3894:Data Arrival Path:\n3934:From              : cpu/u_ex/u_alu/div_state_q_2_s1\n3935:To                : cpu/u_ex/u_alu/div_state_q_2_s1\n3939:Data Arrival Path:\n3979:From              : stall_gen/state_30_s0\n3980:To                : stall_gen/state_30_s0\n3984:Data Arrival Path:\n4024:From              : cpu/u_ex/u_alu/div_state_q_1_s1\n4025:To                : cpu/u_ex/u_alu/div_state_q_1_s1\n4029:Data Arrival Path:\n4069:From              : cpu/u_ex/reg_q.effective_addr_11_s0\n4070:To                : dmem_1_dmem_1_0_0_s\n4074:Data Arrival Path:\n4112:From              : cpu/u_ex/reg_q.effective_addr_9_s0\n4113:To                : dmem_2_dmem_2_0_0_s\n4117:Data Arrival Path:\n4155:From              : cpu/u_ex/reg_q.effective_addr_4_s0\n4156:To                : dmem_3_dmem_3_0_0_s\n4160:Data Arrival Path:\n", "exit_code": 0, "status": "completed"}}
