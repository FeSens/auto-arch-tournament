{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/b62664fd/c991e2bf')\nfor width in (8,4):\n root=base/f'compare{width}_probe';rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for src in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(src,rtl/src.name)\n p=rtl/'ex_stage.sv';s=p.read_text();start=s.index('    case (in.ctrl.branch_op)');end=s.index('    branch_taken',start)\n n=32//width\n block=f'  logic [{n-1}:0] cmp_eq, cmp_lt;\\\\n  logic cmp_unsigned_lt, cmp_signed_lt, cmp_equal;\\\\n'\n for i in range(n):\n  lo=i*width;hi=lo+width-1\n  block+=f'  assign cmp_eq[{i}] = rs1[{hi}:{lo}] == rs2[{hi}:{lo}];\\\\n'\n  block+=f'  assign cmp_lt[{i}] = rs1[{hi}:{lo}] < rs2[{hi}:{lo}];\\\\n'\n # Balanced two-way lexicographic tree.\n def tree(lo,hi):\n  if lo==hi:return f'cmp_eq[{lo}]',f'cmp_lt[{lo}]'\n  mid=(lo+hi)//2\n  el,ll=tree(lo,mid);eh,lh=tree(mid+1,hi)\n  return f'({eh} & {el})',f'({lh} | ({eh} & {ll}))'\n eq,lt=tree(0,n-1)\n block+=f'  assign cmp_equal = {eq};\\\\n  assign cmp_unsigned_lt = {lt};\\\\n'\n block+='  assign cmp_signed_lt = (rs1[31] \"'^ rs2[31]) ? rs1[31] : cmp_unsigned_lt;'\"\\\\n'\n replacement='''    case (in.ctrl.branch_op)\n      BR_BEQ: branch_cond = cmp_equal;\n      BR_BNE: branch_cond = \"'!cmp_equal;\n      BR_BLT: branch_cond = cmp_signed_lt;\n      BR_BGE: branch_cond = !cmp_signed_lt;\n      BR_BLTU: branch_cond = cmp_unsigned_lt;\n      BR_BGEU: branch_cond = !cmp_unsigned_lt;\n      default: branch_cond = 1'\"'b0;\n    endcase\n'''\n s=s[:start]+replacement+s[end:]\n s=s.replace('  always_comb begin\\\\n    case (in.ctrl.branch_op)',block+'\\\\n  always_comb begin\\\\n    case (in.ctrl.branch_op)',1)\n assert 'assign cmp_unsigned_lt' in s\n p.write_text(s)\n (root/'run.py').write_text('''import json,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()))\nfrom tools.eval import gowin\nroot=Path(__file__).resolve().parent\nres=gowin.build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing',options=(0,1))\n(root/'result.json').write_text(json.dumps(res,indent=2))\nfor r in res: print(json.dumps(r),flush=True)\n''')\n print(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
