{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase operations and MUL are combinational; DIV/REM use a held transaction.\nBoth real arithmetic and the exact formal ALTOPS substitutes are tested.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"ALU_ALTOPS\") == \"1\"\nALT_MASKS = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n\n\ndef _expected(op, a, b, expected):\n    if ALTOPS and op in ALT_MASKS:\n        value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n        return (value ^ ALT_MASKS[op]) & MASK32\n    return expected & MASK32\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    expected = _expected(op, a, b, expected)\n    assert actual == expected, (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    \"\"\"Check capture, finite completion, held result, an\n…[9254 of 12326 chars elided by tools/bench/transcript.py; sha256:24e54e42eeae816d]…\n\n        dut.reset.value = 0\n        assert not int(dut.busy.value) and not int(dut.result_valid.value)\n        await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, MASK32)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_alu_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1}, build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"],\n    )\n    runner.test(\n        hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), extra_env={\"ALU_ALTOPS\": \"1\"},\n    )\n", "exit_code": 0, "status": "completed"}}
