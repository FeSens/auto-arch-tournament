t[\"pc\"] == pc and out[\"predicted_taken\"] == 1\n        assert (out[\"rs1_val\"], out[\"rs2_val\"]) == (pc + 7, pc + 11)\n        assert out[\"alu_a_val\"] == (pc if control & (1 << 8) else pc + 7)\n        assert out[\"alu_b_val\"] == (imm if control & (1 << 16) else pc + 11)\n    dut[\"in\"].value = 0\n    awai\n…[8738 of 11810 chars elided by tools/bench/transcript.py; sha256:7265e5deea112811]…\n= instruction(ra=0, rb=0, a=0xFFFFFFFF, b=0xFFFFFFFF,\n                                      ctrl=control, imm=0x80000001)\n        dut.hold_ex.value = 1\n        for stage in (\"ex\", \"mem\", \"wb\"):\n            dut[f\"{stage}_writer\"].value = 1\n            dut[f\"{stage}_value\"].value = 0xFFFFFFFF\n        for _ in range(3):\n            await _tick(dut)\n            assert int(dut.operands_ready.value) and not int(dut.advance.value)\n            assert int(dut.rs1_value_q.value) == int(dut.rs2_value_q.value) == 0\n        dut.hold_ex.value = 0\n        await _tick(dut)\n        out = _unpack(ID_FIELDS, int(dut.out.value))\n        assert out[\"rs1_val\"] == out[\"rs2_val\"] == 0\n        assert out[\"alu_a_val\"] == (0x100 if control & (1 << 8) else 0)\n        assert out[\"alu_b_val\"] == (0x80000001 if control & (1 << 16) else 0)\n\n\ndef test_operand_stage_runner():\n    run_cocotb(toplevel=\"operand_stage\",\n               sources=[\"core_pkg.sv\", \"forward_unit.sv\", \"operand_stage.sv\"],\n               test_module=\"test_operand_stage\")\n", "exit_code": 0, "status": "completed"}}
