e).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[13363 of 16435 chars elided by tools/bench/transcript.py; sha256:4e28bb91633f9eb8]…\nnogroup 45912 Oct  5 02:06 /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep4/bench/programs/random2.elf\n-rwxrwx--x+ 1 nobody nogroup 47056 Oct  5 02:06 /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep4/bench/programs/random3.elf\n-rwxrwx--x+ 1 nobody nogroup  5248 Oct  5 02:06 /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep4/bench/programs/selftest.elf\nrm Vcore__ALL.verilator_deplist.tmp\nmake: Leaving directory '/srv/hwebench/tmp/b62664fd/92711ff4/load_return_probe/obj_dir'\n- V e r i l a t i o n   R e p o r t: Verilator 5.047 devel rev v5.046-331-g2cd9b8df6 (mod)\n- Verilator: Built from 0.868 MB sources in 17 modules, into 0.402 MB in 7 C++ files needing 0.001 MB\n- Verilator: Walltime 3.860 s (elab=0.004, cvt=0.025, bld=3.821); cpu 0.039 s on 1 threads; allocated 25.320 MB\nBuilt: /srv/hwebench/tmp/b62664fd/92711ff4/load_return_probe/obj_dir/cosim_sim\nls: cannot access '/srv/hwebench/tmp/b62664fd/92711ff4/load_return_probe/timing/gowin_p*/impl/pnr/core_bench.tr': No such file or directory\n", "exit_code": 2, "status": "failed"}}
