{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/compare_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\nhelper='''module compare32 (\n  input logic [31:0] a, b,\n  output logic equal, unsigned_less, signed_less\n);\n  logic [3:0] byte_equal, byte_less;\n  logic low_equal, high_equal, low_less, high_less;\n  for (genvar i=0; i<4; i=i+1) begin : g_byte\n    assign byte_equal[i] = a[i*8 +: 8] == b[i*8 +: 8];\n    assign byte_less[i] = a[i*8 +: 8] < b[i*8 +: 8];\n  end\n  assign low_equal = byte_equal[1] & byte_equal[0];\n  assign high_equal = byte_equal[3] & byte_equal[2];\n  assign low_less = byte_less[1] | (byte_equal[1] & byte_less[0]);\n  assign high_less = byte_less[3] | (byte_equal[3] & byte_less[2]);\n  assign equal = high_equal & low_equal;\n  assign unsigned_less = high_less | (high_equal & low_less);\n  assign signed_less = (a[31] \"'^ b[31]) ? a[31] : unsigned_less;\nendmodule\n'\"'''\n(rtl/'compare32.sv').write_text(helper)\np=rtl/'ex_stage.sv'\ns=p.read_text()\ns=s.replace('  logic        branch_cond;','''  logic branch_equal, branch_unsigned_less, branch_signed_less;\n  compare32 u_branch_compare (\n    .a(rs1), .b(rs2), .equal(branch_equal),\n    .unsigned_less(branch_unsigned_less), .signed_less(branch_signed_less)\n  );\n  logic        branch_cond;''')\nreplacements={'(rs1 == rs2)':'branch_equal','(rs1 \"'!= rs2)'\"':'\"'!branch_equal'\"','(\"'$signed(rs1) <  $signed(rs2))'\"':'branch_signed_less','(\"'$signed(rs1) >= $signed(rs2))'\"':'\"'!branch_signed_less'\"','(rs1 <  rs2)':'branch_unsigned_less','(rs1 >= rs2)':'\"'!branch_unsigned_less'\"'}\nfor old,new in replacements.items():\n assert old in s,old\n s=s.replace(old,new)\np.write_text(s)\np=rtl/'alu.sv'\ns=p.read_text().replace('  logic        [4:0]  shamt;','''  logic        [4:0]  shamt;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic compare_equal;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic compare_unsigned_less, compare_signed_less;\n  compare32 u_compare (\n    .a(a), .b(b), .equal(compare_equal),\n    .unsigned_less(compare_unsigned_less), .signed_less(compare_signed_less)\n  );''')\ns=s.replace(\\\"{31'b0, \"'$signed(a) < $signed(b)}\",\"{31'\"'b0, compare_signed_less}\\\").replace(\\\"{31'b0, a < b}\\\",\\\"{31'b0, compare_unsigned_less}\\\")\np.write_text(s)\n(root/'compare_miter.sv').write_text('''module compare_miter(input [31:0] a,b,output mismatch);\n wire equal,unsigned_less,signed_less;\n compare32 u(.a(a),.b(b),.equal(equal),.unsigned_less(unsigned_less),.signed_less(signed_less));\n assign mismatch = (equal \"'!= (a==b)) | (unsigned_less != (a<b)) | (signed_less != ($signed(a)<$signed(b)));\nendmodule\n'\"''')\nprint(f'Prepared isolated probe RTL in {rtl}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
