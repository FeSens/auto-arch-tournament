{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nfrom array import array\nfrom collections import defaultdict\nimport json\nfrom pathlib import Path\ntrace=array('Q');trace.frombytes(Path('/srv/hwebench/tmp/b62664fd/ecd60add/r11_predictor/branches.bin').read_bytes())\ntrace=[(int(x>>2),int(x&1),bool(x&2)) for x in trace]\nresults=[]\nfor kind in ['bimodal','gshare','local_concat','local_xor']:\n for bits in [6,7,8,9,10]:\n  for hb in ([0] if kind=='bimodal' else ([bits] if kind=='gshare' else [2,3,4])):\n   counters=[2]*(1<<bits);hist=0;lh=[0]*64;mask=(1<<bits)-1;hm=(1<<hb)-1;miss=0\n   for pc,taken,win in trace:\n    if kind=='bimodal': idx=(pc>>2)&mask\n    elif kind=='gshare': idx=((pc>>2)\"'^hist)&mask\n    elif kind=='\"'local_concat': idx=(((pc>>2)<<hb)|lh[(pc>>2)&63])&mask\n    else: idx=((pc>>2)\"'^(lh[(pc>>2)&63]<<(bits-hb)))&mask\n    if win: miss+=(counters[idx]>=2)!=taken\n    counters[idx]=min(3,counters[idx]+1) if taken else max(0,counters[idx]-1)\n    hist=((hist<<1)|taken)&hm; lh[(pc>>2)&63]=((lh[(pc>>2)&63]<<1)|taken)&hm\n   results.append({'\"'kind':kind,'pht_bits':bits,'hist_bits':hb,'misses':miss})\nprint(json.dumps(results,indent=2))\nPath('/srv/hwebench/tmp/b62664fd/ecd60add/r11_predictor/profile.json').write_text(json.dumps(results,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
