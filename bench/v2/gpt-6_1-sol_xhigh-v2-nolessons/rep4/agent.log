{"type": "item.completed", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c \"ls bench/programs/*.elf\nsed -n '1,100p' /srv/hwebench/tmp/b62664fd/a9af5e82/bypass_probe/rtl/forward_unit.sv\nsed -n '1,130p' tools/eval/formal.py\"", "aggregated_output": "ls: cannot access 'bench/programs/*.elf': No such file or directory\n// rtl/forward_unit.sv\n//\n// Operand forwarding. For each rs in the EX-stage's source list, picks\n// where the freshest value lives:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input logic clock,\n  input logic reset,\n  input logic stall,\n  input logic flush,\n  input  logic [4:0] id_ex_rs1,\n  input  logic [4:0] id_ex_rs2,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  logic [1:0] next_rs1, next_rs2;\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      fwd_rs1 <= 2'b0;\n      fwd_rs2 <= 2'b0;\n    end else if (!stall) begin\n      fwd_rs1 <= next_rs1;\n      fwd_rs2 <= next_rs2;\n    end\n  end\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs1) next_rs1 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs1) next_rs1 = 2'd2;\n    else                                                                  next_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) next_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) next_rs2 = 2'd2;\n    else                                                                  next_rs2 = 2'd0;\n  end\n\nendmodule\n\"\"\"Runs the real riscv-formal suite via formal/run_all.sh.\n\nThe real suite is generated at runtime by\n…[4537 of 7609 chars elided by tools/bench/transcript.py; sha256:b306a1df459aa70b]…\nArgs:\n      worktree: path to the repo root.\n      target:   optional core name (e.g. 'v1').  When set, injects\n                RTL_DIR=cores/<target>/rtl and CORE_NAME=<target> into\n                the subprocess environment so run_all.sh picks up that\n                core's RTL instead of the default rtl/ directory. When\n                that core's core.yaml declares nret=1, also injects\n                WRAPPER=formal/wrapper_si.sv and CHECKS_CFG=formal/checks_si.cfg\n                so the single-issue formal flow runs instead of the\n                default dual-channel one.\n\n    Returns:\n      {'passed': True, 'checks_passed': N}\n      {'passed': False, 'failed_check': name, 'detail': str}\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    run_script = worktree_path / \"formal\" / \"run_all.sh\"\n    if not run_script.exists():\n        return {'passed': False, 'failed_check': 'setup',\n                'detail': f'formal/run_all.sh missing in {worktree}'}\n\n    env = _build_formal_env(worktree_path, target)\n", "exit_code": 0, "status": "completed"}}
