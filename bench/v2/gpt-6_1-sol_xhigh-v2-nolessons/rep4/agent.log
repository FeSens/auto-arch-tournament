{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_operand_stage.py'", "aggregated_output": "\"\"\"Resolved OC operands, nearest-writer blocking, retention and recovery.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\nfrom test_ex_divider import ID_FIELDS, _pack, _unpack, _tick\n\n\nasync def reset_stage(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.hold_ex.value = 0\n    dut.flush.value = 0\n    dut[\"in\"].value = 0\n    for stage in (\"ex\", \"mem\", \"wb\"):\n        dut[f\"{stage}_rd\"].value = 0\n        dut[f\"{stage}_writer\"].value = 0\n        dut[f\"{stage}_value\"].value = 0\n    dut.ex_ready.value = 0\n    dut.mem_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\ndef instruction(pc=0x100, a=3, b=5, ra=1, rb=2, predicted=1, ctrl=4, imm=0):\n    return _pack(ID_FIELDS, pc=pc, alu_a_val=a, alu_b_val=b, rs1_val=a,\n                 rs2_val=b, imm=imm, rd=3, rs1_addr=ra, rs2_addr=rb,\n                 ctrl=ctrl, instr=0x002081B3, predicted_taken=predicted, valid=1)\n\n\n@cocotb.test()\nasync def full_rate_capture_and_operand_selection(dut):\n    await reset_stage(dut)\n    for pc, control, imm in ((0x100, 4, 0), (0x104, 4 | (1 << 8) | (1 << 16), 0x1000),\n                              (0x108, 4 | (1 << 16), 19)):\n        dut[\"in\"].value = instruction(pc=pc, ctrl=control, imm=imm)\n        dut.ex_rd.value = 1\n        dut.ex_writer.value = 1\n        dut.ex_ready.value = 1\n        dut.ex_value.value = pc + 7\n        dut.mem_rd.value = 2\n        dut.mem_writer.value = 1\n        dut.mem_ready.value = 1\n        dut.mem_value.value = pc + 11\n        await Timer(1, \"ns\")\n        assert int(dut.advance.value) and int(dut.operands_ready.value)\n        await _tick(dut)\n        out = _unpack(ID_FIELDS, int(dut.out.value))\n        assert out[\"valid\"] and out[\"pc\"] == pc and out[\"predicted_taken\"] == 1\n        assert (out[\"rs1_val\"], out[\"rs2_val\"]) == (pc + 7, pc + 11)\n        assert out[\"alu_a_val\"] == (pc if control & (1 << 8) else pc + 7)\n        assert out[\"alu_b_val\"] == (imm if control & (1 << 16) else pc + 11)\n    dut[\"in\"].value = 0\n    awai\n…[8738 of 11810 chars elided by tools/bench/transcript.py; sha256:7265e5deea112811]…\n= instruction(ra=0, rb=0, a=0xFFFFFFFF, b=0xFFFFFFFF,\n                                      ctrl=control, imm=0x80000001)\n        dut.hold_ex.value = 1\n        for stage in (\"ex\", \"mem\", \"wb\"):\n            dut[f\"{stage}_writer\"].value = 1\n            dut[f\"{stage}_value\"].value = 0xFFFFFFFF\n        for _ in range(3):\n            await _tick(dut)\n            assert int(dut.operands_ready.value) and not int(dut.advance.value)\n            assert int(dut.rs1_value_q.value) == int(dut.rs2_value_q.value) == 0\n        dut.hold_ex.value = 0\n        await _tick(dut)\n        out = _unpack(ID_FIELDS, int(dut.out.value))\n        assert out[\"rs1_val\"] == out[\"rs2_val\"] == 0\n        assert out[\"alu_a_val\"] == (0x100 if control & (1 << 8) else 0)\n        assert out[\"alu_b_val\"] == (0x80000001 if control & (1 << 16) else 0)\n\n\ndef test_operand_stage_runner():\n    run_cocotb(toplevel=\"operand_stage\",\n               sources=[\"core_pkg.sv\", \"forward_unit.sv\", \"operand_stage.sv\"],\n               test_module=\"test_operand_stage\")\n", "exit_code": 0, "status": "completed"}}
