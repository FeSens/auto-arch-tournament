                     ({32{far2}} & wb_value) | ({32{captured2}} & rs2_captured);\nendmodule\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n// ID/OC remains occupied until both sources and the EX slot are ready.\n// A blocked load/divider retains its authoritative producer slot until it\n// supplies \n…[9618 of 12690 chars elided by tools/bench/transcript.py; sha256:d88dda083677dfd7]…\n;\n      // Clock every unheld, non-quarantined advance: no comparison enable\n      // on the target flops. The repair bit alone qualifies this target.\n      mul_repair_target <= in.pc_next;\n      reg_q.pc         <= in.pc;\n      reg_q.alu_result <= is_mul ? exact_product : in.alu_result;\n      reg_q.read_data  <= load_data;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= dmem_rdata;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= (in.valid && in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= (in.valid && in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
