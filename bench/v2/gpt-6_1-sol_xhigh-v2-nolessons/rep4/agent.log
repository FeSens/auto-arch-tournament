{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,json,collections\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim');from reference import RV32IM\ncpu=RV32IM();cpu.load_elf('/srv/hwebench/tmp/b62664fd/0b78fa10/coremark-profile.elf');active=False;loads=[]\ndef ww(addr,value):\n global active\n if addr==0x10000100:active=True;return\n if addr==0x10000104:active=False;return\n RV32IM.ww(cpu,addr,value)\ncpu.ww=ww\nfor _ in range(10000000):\n r=cpu.step()\n if r['insn']&127==3 and r['rd']:\n  nxt=cpu.rw(cpu.pc);dependent=r['rd'] in ((nxt>>15)&31,(nxt>>20)&31)\n  loads.append((r['pc'],r['rd_wdata'],dependent,active))\n if r['insn']==0x00100073:break\nsummary={}\nfor size in [32,64,128,256]:\n for threshold in [0,1,2,3]:\n  values=[0]*size;valid=[False]*size;conf=[0]*size;hit=miss=deps=0\n  for pc,val,dependent,marked in loads:\n   idx=(pc>>2)&(size-1);pred=valid[idx] and conf[idx]>=threshold\n   if dependent and marked:\n    deps+=1\n    if pred:\n     if val==values[idx]:hit+=1\n     else:miss+=1\n   conf[idx]=min(3,conf[idx]+1) if valid[idx] and val==values[idx] else 0;valid[idx]=True;values[idx]=val\n  summary[f'{size}_threshold{threshold}']={'dependent_loads':deps,'hits':hit,'misses':miss,'nominal_saved_cycles':hit-2*miss}\nprint(json.dumps(summary,indent=2));Path('/srv/hwebench/tmp/b62664fd/0b78fa10/load-profile.json').write_text(json.dumps(summary))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
