{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/b62664fd/aa2fceec/regfile-prototype')\nr=p/'rtl'\nr.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(f,r/f.name)\n(r/'reg_file.sv').write_text('''module reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output logic [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  wire [31:0] leaf1 [0:31], leaf2 [0:31];\n  wire [31:0] bank1 [0:3], bank2 [0:3];\n  assign leaf1[0] = 32'b0;\n  assign leaf2[0] = 32'b0;\n  for (genvar r=1; r<32; r=r+1) begin : g_word\n    logic [31:0] word_q;\n    wire sel1 = rs1_addr == 5'(r);\n    wire sel2 = rs2_addr == 5'(r);\n    always_ff @(posedge clock) begin\n      if (reset) word_q <= 32'b0;\n      else if (w_en && w_addr == 5'(r)) word_q <= w_data;\n    end\n    assign leaf1[r] = word_q & {32{sel1}};\n    assign leaf2[r] = word_q & {32{sel2}};\n  end\n  for (genvar b=0; b<4; b=b+1) begin : g_bank\n    wire [31:0] pair1 [0:3], pair2 [0:3];\n    wire [31:0] quad1 [0:1], quad2 [0:1];\n    for (genvar s=0;s<4;s=s+1) begin : g_pair\n      assign pair1[s] = leaf1[b*8+s*2] | leaf1[b*8+s*2+1];\n      assign pair2[s] = leaf2[b*8+s*2] | leaf2[b*8+s*2+1];\n    end\n    for (genvar s=0;s<2;s=s+1) begin : g_quad\n      assign quad1[s] = pair1[s*2] | pair1[s*2+1];\n      assign quad2[s] = pair2[s*2] | pair2[s*2+1];\n    end\n    assign bank1[b] = quad1[0] | quad1[1];\n    assign bank2[b] = quad2[0] | quad2[1];\n  end\n  wire [31:0] read1 = (bank1[0] | bank1[1]) | (bank1[2] | bank1[3]);\n  wire [31:0] read2 = (bank2[0] | bank2[1]) | (bank2[2] | bank2[3]);\n  always_comb begin\n    if (rs1_addr == 0) rs1_data = 0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = read1;\n    if (rs2_addr == 0) rs2_data = 0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = read2;\n  end\nendmodule\n''')\nprint('Prototype RTL:',r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
