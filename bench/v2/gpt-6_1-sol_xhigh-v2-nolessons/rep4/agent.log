{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nbase=Path(os.environ['TMPDIR'])/'r12-fast-arith-probe'\np=Path(os.environ['TMPDIR'])/'r12-carry-select-probe'\nshutil.copytree(base/'rtl',p/'rtl',dirs_exist_ok=True)\n(p/'rtl'/'fast_arith.sv').write_text('''module fast_arith #(parameter bit SUBTRACT = 1'b0) (\n  input logic [31:0] a,b,\n  output logic [31:0] sum,\n  output logic carry_out\n);\n  logic [31:0] bb;\n  logic [17:0] low_seeded, high_one;\n  logic [16:0] high_zero;\n  logic [16:0] high_selected;\n  assign bb = SUBTRACT ? ~b : b;\n  assign low_seeded = {1'b0,a[15:0],1'b1}+{1'b0,bb[15:0],SUBTRACT};\n  assign high_zero = {1'b0,a[31:16]}+{1'b0,bb[31:16]};\n  assign high_one = {1'b0,a[31:16],1'b1}+{1'b0,bb[31:16],1'b1};\n  assign high_selected = low_seeded[17] ? high_one[17:1] : high_zero;\n  assign sum = {high_selected[15:0],low_seeded[16:1]};\n  assign carry_out = high_selected[16];\nendmodule\n''')\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
