{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/b62664fd/2dba8126/load16rtl');p.mkdir(exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(f,p/f.name)\n(p/'load_predictor.sv').write_text('''module load_predictor (\n  input logic clock, reset,\n  input logic [31:0] lookup_addr,\n  output logic hit,\n  output logic [31:0] prediction,\n  input logic train_en, train_load,\n  input logic [31:0] train_addr, train_data,\n  input logic [3:0] train_wmask\n);\n  logic [15:0] valid_q;\n  logic [25:0] tag_q [0:15];\n  logic [31:0] word_q [0:15];\n  wire [3:0] lookup_index = lookup_addr[5:2];\n  wire [3:0] train_index = train_addr[5:2];\n  wire train_hit = valid_q[train_index] && tag_q[train_index] == train_addr[31:6];\n  assign hit = valid_q[lookup_index] && tag_q[lookup_index] == lookup_addr[31:6];\n  assign prediction = word_q[lookup_index];\n  always_ff @(posedge clock) begin\n    if (reset) valid_q <= '0;\n    else if (train_en) begin\n      if (train_load || train_wmask == 4'b1111) begin\n        valid_q[train_index] <= 1'b1;\n        tag_q[train_index] <= train_addr[31:6];\n        word_q[train_index] <= train_data;\n      end else if (train_hit) begin\n        for (integer lane = 0; lane < 4; lane = lane + 1)\n          if (train_wmask[lane]) word_q[train_index][lane*8 +: 8] <= train_data[lane*8 +: 8];\n      end\n    end\n  end\nendmodule\n''')\nf=p/'mem_stage.sv';s=f.read_text()\npos='  logic [31:0] wdata_rep;'\ns=s.replace(pos,'''  logic load_prediction_hit;\n  logic [31:0] predicted_word, predicted_load, predicted_shifted;\n  load_predictor u_load_predictor (\n    .clock(clock), .reset(reset), .lookup_addr(in.effective_addr),\n    .hit(load_prediction_hit), .prediction(predicted_word),\n    .train_en(\"'!hold_wb && !mul_repair && dmem_ready && (dmem_ren || |dmem_wen)),\n    .train_load(dmem_ren), .train_addr(in.