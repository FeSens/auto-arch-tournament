{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/b62664fd/92711ff4/fetch_fifo_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'core.sv'\ns=p.read_text().replace('if_id_t  if_id_w;','if_id_t  if_id_w;\\\\n  if_id_t queued_if_id_w;\\\\n  logic fetch_space, decode_accept;')\na=s.index('  assign fetch_accept = ')\nb=s.index('  if_stage u_if',a)\ns=s[:a]+'''  assign fetch_accept = fetch_space && io_imemReady && \"'!redirect;\n  assign decode_accept = queued_if_id_w.valid && !stall_id && !flush_id;\n  fetch_queue u_fetch_queue (\n    .clock(clock), .reset(reset), .flush(redirect),\n    .enqueue(fetch_accept), .dequeue(decode_accept),\n    .space(fetch_space), .in(if_id_w), .out(queued_if_id_w)\n  );\n'\"'''+s[b:]\ns=s.replace('.flush           (flush_if),','.flush           (redirect || \"'!io_imemReady),'\"',1)\ns=s.replace('.in       (if_id_w),','.in       (queued_if_id_w),',1)\ns=s.replace('.imem_ready     (io_imemReady),','.imem_ready     (queued_if_id_w.valid),',1)\np.write_text(s)\n(rtl/'fetch_queue.sv').write_text('''\"'`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule fetch_queue #(\n  parameter integer DEPTH = 2,\n  parameter integer PTR_W = $clog2(DEPTH)\n)(\n  input logic clock, reset, flush,\n  input logic enqueue, dequeue,\n  output logic space,\n  input if_id_t in,\n  output if_id_t out\n);\n  logic [64:0] slots [0:DEPTH-1];\n  logic [PTR_W-1:0] head_q, tail_q;\n  logic [PTR_W:0] count_q;\n  assign space = count_q < DEPTH;\n  always_comb begin\n    out = in;\n    if (count_q != 0) begin\n      {out.pc, out.instr, out.predicted_taken} = slots[head_q];\n      out.valid = 1'\"'b1;\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      head_q <= '0;\n      tail_q <= '0;\n      count_q <= '0;\n    end else begin\n      if (enqueue) begin\n        slots[tail_q] <= {in.pc, in.instr, in.predicted_taken};\n        tail_q <= tail_q + 1'b1;\n      end\n      if (dequeue) head_q <= head_q + 1'b1;\n      case ({enqueue, dequeue})\n        2'b10: count_q <= count_q + 1'b1;\n        2'b01: count_q <= count_q - 1'b1;\n        default: begin end\n      endcase\n    end\n  end\nendmodule\n''')\nprint('Created isolated fetch FIFO:',root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
