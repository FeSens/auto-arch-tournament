{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport struct,collections,json\nrecords=list(struct.iter_unpack('<IIIIIII',Path('/srv/hwebench/tmp/b62664fd/bbb89c33/predictor_trace.bin').read_bytes()))\nloads=[]\nfor i,(pc,ins,value,addr,npc,order,active) in enumerate(records):\n if ins&127\"'!=3:continue\n rd=(ins>>7)&31\n nextins=records[i+1][1] if i+1<len(records) else 0\n rawdep=rd and (rd==((nextins>>15)&31) or rd==((nextins>>20)&31))\n loads.append((pc,value,active,bool(rawdep)))\nsummary=[]\nfor size in (16,32,64,128,256):\n for kind in ('\"'last','stride'):\n  table=[None]*size;c=collections.Counter();by_pc=collections.defaultdict(collections.Counter)\n  for pc,value,active,dep in loads:\n   idx=(pc>>2)&(size-1);entry=table[idx];same=entry is not None and entry[0]==pc\n   if same:\n    _,last,stride,conf=entry\n    pred=last if kind=='last' else (last+stride)&0xffffffff\n    correct=pred==value\n    if active:\n     c['loads']+=1;c['lookups']+=1;c['correct']+=correct;c['dep']+=dep;c['correct_dep']+=correct and dep\n     for threshold in (1,2,3):\n      if conf>=threshold:\n       c[f'eligible{threshold}']+=1;c[f'hits{threshold}']+=correct;c[f'dep_hits{threshold}']+=correct and dep;c[f'dep_misses{threshold}']+=not correct and dep\n     by_pc[pc]['lookups']+=1;by_pc[pc]['correct']+=correct;by_pc[pc]['dep']+=dep\n    conf=min(3,conf+1) if correct else 0\n    table[idx]=(pc,value,(value-last)&0xffffffff,conf)\n   else:\n    table[idx]=(pc,value,0,0)\n    if active:c['loads']+=1;c['dep']+=dep\n  summary.append({'size':size,'kind':kind,**c})\nprint(json.dumps(summary,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
