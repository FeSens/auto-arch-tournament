{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/b62664fd/abd77d19/r13_micro_probe')\nfor bits in (4,8,16):\n rtl=p/f'branch{bits}_rtl'; shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n n=32//bits\n text='module branch_compare(input logic [31:0] a,b, input logic [2:0] op, output logic cond);\\\\n'\n text+=f'logic [{n-1}:0] eq0,lt0;\\\\n'\n for i in range(n):\n  hi,lo=(i+1)*bits-1,i*bits\n  text+=f'assign eq0[{i}]=a[{hi}:{lo}]==b[{hi}:{lo}];\\\\nassign lt0[{i}]=a[{hi}:{lo}]<b[{hi}:{lo}];\\\\n'\n depth=0; width=n\n while width>1:\n  nxt=width//2\n  text+=f'logic [{nxt-1}:0] eq{depth+1},lt{depth+1};\\\\n'\n  for i in range(nxt):\n   text+=f'assign eq{depth+1}[{i}]=eq{depth}[{2*i+1}] & eq{depth}[{2*i}];\\\\n'\n   text+=f'assign lt{depth+1}[{i}]=lt{depth}[{2*i+1}] | (eq{depth}[{2*i+1}] & lt{depth}[{2*i}]);\\\\n'\n  width=nxt; depth+=1\n text+=f'logic less_unsigned,less_signed;\\\\nassign less_unsigned=lt{depth}[0];\\\\nassign less_signed=(a[31]\"'^b[31]) ? a[31] : less_unsigned;'\"\\\\n'\n text+='always_comb begin\\\\ncase(op)\\\\n0:cond= &eq0;\\\\n1:cond= \"'!(&eq0);'\"\\\\n4:cond=less_signed;\\\\n5:cond=\"'!less_signed;'\"\\\\n6:cond=less_unsigned;\\\\n7:cond=\"'!less_unsigned;'\"\\\\ndefault:cond=0;\\\\nendcase\\\\nend\\\\nendmodule\\\\n'\n (rtl/'branch_compare.sv').write_text(text)\n f=rtl/'ex_stage.sv'; s=f.read_text(); start=s.index('    case (in.ctrl.branch_op)'); end=s.index('    branch_taken',start)\n s=s[:start]+s[end:]\n s=s.replace('  always_comb begin\\\\n    branch_taken', '  branch_compare u_branch_compare(.a(rs1),.b(rs2),.op(in.ctrl.branch_op),.cond(branch_cond));\\\\n\\\\n  always_comb begin\\\\n    branch_taken',1)\n f.write_text(s)\nprint('Temporary exact branch comparator probes prepared.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
