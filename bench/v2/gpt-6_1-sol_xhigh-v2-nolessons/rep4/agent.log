{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_mem_repair.py cores/bench/test/test_fetch_predictor.py cores/bench/test/test_ex_divider.py'", "aggregated_output": "\"\"\"MEM/WB repair record qualification, target clocking, and quarantine.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb\nfrom test_ex_divider import EX_FIELDS, _pack, _unpack\n\n\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"pc_next\", 32), (\"mem_addr\", 32), (\"mem_rdata\", 32),\n             (\"mem_wdata\", 32), (\"mem_wmask\", 4), (\"mem_rmask\", 4),\n             (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\n@cocotb.test()\nasync def repair_records_only_advancing_legal_writers(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.hold_wb.value = 0\n    dut[\"in\"].value = 0\n    dut.dmem_rdata.value = 0x12345678\n    dut.dmem_ready.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    target = 0\n    for valid, rd, illegal, writer in ((0, 3, 0, 1), (1, 0, 0, 1),\n                                       (1, 3, 1, 1), (1, 3, 0, 0)):\n        control = (ALU_MUL << 17) | (writer << 2) | illegal\n        target += 4\n        dut[\"in\"].value = _pack(EX_FIELDS, pc=target - 4, pc_next=target,\n                                rs1_val=0x10001, rs2_val=4, alu_result=4,\n                                rd=rd, ctrl=control, valid=valid)\n        await Timer(1, \"ns\")\n        assert not int(dut.mul_repair.value), \"validation leaked combinational recovery\"\n        await _tick(dut)\n        assert not int(dut.mul_repair.value)\n        assert int(dut.mul_repair_target.value) == target, \"target needs no mismatch enable\"\n        wb = _unpack(WB_FIELDS, int(dut.out.value))\n        assert wb[\"alu_result\"] == 0x40004 and wb[\"valid\"] == valid\n\n    # A held MEM instruction cannot create a repair, and retains WB data.\n    control = (ALU_MUL << 17) | 4\n    dut[\"in\"].value = _p\n…[19394 of 22466 chars elided by tools/bench/transcript.py; sha256:1175bb85e05283ca]…\ncontrols\"\n        dut[\"in\"].value = 0\n        await _tick(dut)\n        assert int(dut.out.value) == 0 and not int(dut.div_busy.value)\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"mul_predictor.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n\n\ndef test_ex_divider_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"ex_stage_altops\"\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"alu.sv\", \"mul_predictor.sv\", \"ex_stage.sv\")],\n        hdl_toplevel=\"ex_stage\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1}, build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"],\n    )\n    runner.test(\n        hdl_toplevel=\"ex_stage\", test_module=\"test_ex_divider\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), extra_env={\"EX_DIV_ALTOPS\": \"1\"},\n    )\n", "exit_code": 0, "status": "completed"}}
