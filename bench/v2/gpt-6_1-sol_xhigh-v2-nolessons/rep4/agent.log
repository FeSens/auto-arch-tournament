{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'for path in /AGENTS.md /srv/AGENTS.md /srv/hwebench/AGENTS.md /srv/hwebench/clones/AGENTS.md /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep4/AGENTS.md /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep4/cores/AGENTS.md /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-nolessons-rep4/cores/bench/AGENTS.md; do if [ -f \"$path\" ]; then cat \"$path\"; fi; done; rg --files --hidden -g '\"'AGENTS.md' -g '\"'!formal/riscv-formal/**'\"'; cat cores/bench/core.yaml; cat cores/bench/test/test_mul_predictor.py\"", "aggregated_output": "name: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 65.311\n  lut4: 3791\n  ff: 970\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261005-002-r5s1\n  updated: '2026-10-05T03:18:22.284173Z'\n\"\"\"Exact MEM arithmetic and speculative EX arithmetic, including ALTOPS.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n                      RTL, TEST_DIR, SIM_BUILD)\n\nMASK = 0xFFFFFFFF\nOPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nALT_MASKS = (0x5876063E, 0xF6583FB7, 0x949CE5E8, 0xECFBE137)\n\n\ndef _signed(value, bits):\n    value &= (1 << bits) - 1\n    return value - (1 << bits) if value & (1 << (bits - 1)) else value\n\n\n@cocotb.test()\nasync def products(dut):\n    exact = os.environ[\"MUL_HELPER\"] == \"mul_exact\"\n    altops = os.environ[\"MUL_ALTOPS\"] == \"1\"\n    narrow = [0, 1, -1, 2, -2, -32768, -32767, 32766, 32767]\n    wide = [0x8000, 0xFFFF, 0x10000, 0x10001, 0x7FFFFFFF,\n            0x80000000, 0x80000001, 0xFFFF0000, MASK]\n    pairs = [(a & MASK, b & MASK) for a in narrow for b in narrow]\n    pairs += [(a, b) for a in wide for b in wide + [0, 1, 2, 3]]\n    rng = random.Random(0x161632)\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(256)]\n    misses = [0] * 4\n    for a, b in pairs:\n        reference = (a * b, (_signed(a, 32) * _signed(b, 32)) >> 32,\n                     (a * b) >> 32, (_signed(a, 32) * b) >> 32)\n        for index, op in enumerate(OPS):\n            dut.op.value = op\n            dut.a.value = a\n            dut.b.value = b\n            await Timer(1, \"ns\")\n            if altops:\n                expected = ((a - b if op == ALU_MULHSU else a + b)\n                            ^ ALT_MASKS[index]) & MASK\n            elif exact:\n                expected = reference[index] & MASK\n            else:\n                expected = (_signed(a, 16) * _signed(b, 16)) & MASK if op == ALU_MUL else 0\n                misses[index] += expected != reference[index] & MASK\n                if op == ALU_MUL and a == (_signed(a, 16) & MASK) and b == (_signed(b, 16) & MASK):\n                    assert expected == reference[index] & MASK\n            assert int(dut.out.value) == expected, (op, hex(a), hex(b), hex(expected))\n    if not exact and not altops:\n        assert all(misses), \"vectors did not force each multiply variant to miss\"\n    dut.op.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.out.value) == 0\n\n\n@pytest.mark.parametrize(\"module\", [\"mul_predictor\", \"mul_exact\"])\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_multiplier_runner(module, altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (module + (\"_altops\" if altops else \"\"))\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", module + \".sv\")],\n        hdl_toplevel=module, build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1} if altops else {},\n        build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"],\n    )\n    runner.test(\n        hdl_toplevel=module, test_module=\"test_mul_predictor\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n        extra_env={\"MUL_HELPER\": module, \"MUL_ALTOPS\": str(int(altops))},\n    )\n", "exit_code": 0, "status": "completed"}}
