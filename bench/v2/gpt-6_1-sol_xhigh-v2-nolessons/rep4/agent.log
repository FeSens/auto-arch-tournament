{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path.cwd();p=Path('/srv/hwebench/tmp/b62664fd/dd36461a/fetch_fifo_probe'); b=Path('/srv/hwebench/tmp/b62664fd/dd36461a/late_mul_probe')\n(p/'formal').mkdir(exist_ok=True)\nfor n in ('run_all.sh','wrapper_si.sv','checks_si.cfg'):\n    shutil.copy2(root/'formal'/n,p/'formal'/n)\nfor n in ('checks','insns'):\n    shutil.copytree(b/'formal/riscv-formal'/n,p/'formal/riscv-formal'/n,dirs_exist_ok=True)\n(p/'cores/bench').mkdir(parents=True,exist_ok=True)\nshutil.copy2(root/'cores/bench/core.yaml',p/'cores/bench/core.yaml')\n(p/'cores/bench/rtl').symlink_to(p/'rtl',target_is_directory=True)\nprint('Isolated formal framework staged for fetch queue')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
