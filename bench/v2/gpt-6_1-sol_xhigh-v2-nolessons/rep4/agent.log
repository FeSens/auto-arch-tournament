{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_fetch_predictor.py; cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"Instruction qualification, deterministic table reset, and read/write edges.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\ndef _payload(dut):\n    value = int(dut.out.value)\n    return value >> 34, (value >> 2) & 0xFFFFFFFF, (value >> 1) & 1, value & 1\n\n\nasync def _pc(dut, value):\n    dut.redirect.value = 1\n    dut.redirect_target.value = value\n    await _tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def reset_all_entries_and_same_edge_training(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.accept.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.branch_train_en.value = 0\n    dut.branch_train_index.value = 0\n    dut.branch_train_taken.value = 0\n    dut.imem_data.value = BEQ(0, 0, 8)\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Every entry starts weakly taken; one decrement crosses its threshold.\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut) == (index * 4, BEQ(0, 0, 8), 1, 1)\n        dut.branch_train_en.value = 1\n        dut.branch_train_index.value = index\n        dut.branch_train_taken.value = 0\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == 1, \"write changed prediction before the edge\"\n        await _tick(dut)\n        dut.branch_train_en.value = 0\n        assert _payload(dut)[2] == 0 and int(dut.imem_addr.value) == index * 4\n\n    # A reset restores all entries, including those whose MSB was cleared.\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut)[2] == 1\n\n    await _pc(dut, 0)\n    dut.branch_train_en.value = 1\n    dut.branch_train_index\n…[81332 of 84404 chars elided by tools/bench/transcript.py; sha256:6a36556afdd5f6f7]…\n not int(dut.u_ex.div_busy.value) and not int(dut.u_ex.div_result_valid.value)\n    assert int(dut.id_ex_w.value) == int(dut.oc_ex_w.value) == int(dut.ex_mem_w.value) == int(dut.mem_wb_w.value) == 0\n    assert not int(dut.u_oc.rs1_ready_q.value) and not int(dut.u_oc.rs2_ready_q.value)\n    rets, _ = await _run(dut, program, dmem_init={0x100: 0x10001}, max_cycles=150)\n    _check_arithmetic_trace(rets)\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert next(r for r in rets if r[\"pc\"] == 12)[\"rd_wdata\"] == 0x10001\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_predictor.sv\", \"mul_exact.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\", \"operand_stage.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
