wargs, trap=1)\n            mem_addr = addr\n            if fn3 == 0:\n                self.wb(addr, r[rs2])\n                mem_wmask, mem_wdata = 1, r[rs2] & 0xFF\n            elif fn3 == 1:\n                self.whw(addr, r[rs2])\n                mem_wmask, mem_wdata = 3, r[rs2] & 0xFFFF\n            else:\n                self.ww(addr, r[rs2])\n                mem_wmask, mem_wdata = 15, r[rs2]\n            return self._retire(**trap_kwargs,\n                                mem_addr=mem_addr,\n                                mem_wmask=mem_wmask, mem_wdata=mem_wdata)\n\n        if op == 0x63:  # BRANCH\n            if fn3 in (2, 3):\n                return self._retire(**trap_kwargs, trap=1)\n            a, b = r[rs1], r[rs2]\n            sa, sb = self.sx(a, 32), self.sx(b, 32)\n            taken = {0: a == b, 1: a != b, 4: sa < sb, 5: sa >= sb,\n                     6: a < b,  7: a >= b}.get(fn3, False)\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/b62664fd/5ff8b96b/ras_profile/probe.py <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl');dst=Path('/srv/hwebench/tmp/b62664fd/5ff8b96b/ras_profile/probe_rtl');dst.mkdir(exist_ok=True)\nfor p in src.glob('*.sv'):shutil.copy2(p,dst/p.name)\ndef edit(name,a,b):\n p=dst/name;s=p.read_text();assert a in s,(name,a);p.write_text(s.replace(a,b))\nedit('core_pkg.sv','    logic [31:0] pc;\\\\n    logic [31:0] alu_result;','    logic load_pred_valid, load_pred_used;\\\\n    logic [31:0] pc;\\\\n    logic [31:0] alu_result;')\nedit('operand_stage.sv','  output logic operands_ready,','  output logic [6:0] load_read_index,\\\\n  output logic load_read_en, ex_prediction_use, mem_prediction_use,\\\\n  output logic operands_ready,')\nedit('operand_stage.sv','  assign operands_ready = rs1_ready && rs2_ready;','''  logic [8:0] low_address;\n  logic capture_rs1, capture_rs2;\n  assign low_address = rs1_value[8:0] + in.imm[8:0];\n  assign load_read_index = low_address[8:2];\n  assign load_read_en = advance;\n  assign capture_rs1 = in.valid && \"'!flush && !reset && rs1_ready && !rs1_ready_q;\n  assign capture_rs2 = in.valid && !flush && !reset && rs2_ready && !rs2_ready_q;\n  assign ex_prediction_use = (capture_rs1 && rs1_select[3]) || (capture_rs2 && rs2_select[3]);\n  assign mem_prediction_use = (capture_rs1 && rs1_select[2]) || (capture_rs2 && rs2_select[2]);\n  assign operands_ready = rs1_ready && rs2_ready;'\"''')\nedit('ex_stage.sv','  input  oc_ex_t   in,','  input logic [31:0] load_candidate,\\\\n  input logic load_candidate_valid, ex_prediction_use,\\\\n  input  oc_ex_t   in,')\nedit('ex_stage.sv','  assign bypass_ready = bypass_w_en && \"'!in.ctrl.mem_read &&'\"','  assign bypass_ready = bypass_w_en && (\"'!in.ctrl.mem_read || load_candidate_valid) &&'\"')\nedit('ex_stage.sv','  assign bypass_value = in.ctrl.is_jump ? in.pc + 32\\\\'d4 :','  assign bypass_value = in.ctrl.mem_read ? predicted_load : in.ctrl.is_jump ? in.pc + 32\\\\'d4 :')\nedit('ex_stage.sv','  logic actual_taken;','''  logic [31:0] shifted_candidate, predicted_load;\n  logic prediction_used_q;\n  assign shifted_candidate = load_candidate >> {effective_addr[1:0],3'b0};\n  always_comb begin\n    case (in.ctrl.mem_width)\n      2'd0: predicted_load = in.ctrl.mem_sext ? {{24{shifted_candidate[7]}},shifted_candidate[7:0]} : {24'b0,shifted_candidate[7:0]};\n      2'd1: predicted_load = in.ctrl.mem_sext ? {{16{shifted_candidate[15]}},shifted_candidate[15:0]} : {16'b0,shifted_candidate[15:0]};\n      default: predicted_load = load_candidate;\n    endcase\n  end\n  always_ff @(posedge clock) begin\n    if (reset || squash) prediction_used_q <= 1'b0;\n    else if (\"'!stall && !divider_wait) prediction_used_q <= 1'\"'b0;\n    else if (in.valid && in.ctrl.mem_read && load_candidate_valid && ex_prediction_use)\n      prediction_used_q <= 1'b1;\n  end\n  logic actual_taken;''')\nedit('ex_stage.sv','      exec_payload.pc            = in.pc;','''      exec_payload.load_pred_valid = in.ctrl.mem_read && load_candidate_valid;\n      exec_payload.load_pred_used = prediction_used_q || ex_prediction_use;\n      exec_payload.pc            = in.pc;''')\nedit('ex_stage.sv','      exec_payload.alu_result    = in.ctrl.is_jump ? (in.pc + 32\\\\'d4)','      exec_payload.alu_result    = in.ctrl.mem_read ? predicted_load : in.ctrl.is_jump ? (in.pc + 32\\\\'d4)')\nedit('mem_stage.sv','  input  logic               hold_wb,','  input logic mem_prediction_use,\\\\n  input  logic               hold_wb,')\nedit('mem_stage.sv','(\"'!in.ctrl.mem_read || (dmem_ready && dmem_ren))'\"','(\"'!in.ctrl.mem_read || (in.load_pred_valid && dmem_ready && dmem_ren))'\"')\nedit('mem_stage.sv','assign bypass_value = in.ctrl.mem_read ? load_data : in.alu_result;','assign bypass_value = in.alu_result;')\nedit('mem_stage.sv','      mul_repair <= in.valid && is_mul && \