{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/b62664fd/dd36461a/fetch_fifo_probe')\nfor depth in (2,4):\n    p=root.parent/f'fetch_flow{depth}_probe'\n    shutil.copytree(root/'rtl',p/'rtl',dirs_exist_ok=True)\n    s=p/'rtl/fetch_fifo.sv';t=s.read_text()\n    t=t.replace('input logic clock, reset, clear, push, pop,','input logic clock, reset, clear, push, pop, available,')\n    t=t.replace('out = entries[head];\\\\n    out.valid = count \"'!= 0 && !clear;'\"', 'out = count == 0 ? in : entries[head];\\\\n    out.valid = (count \"'!= 0 || available) && !clear;'\"')\n    if depth==2:\n        t=t.replace('entries [0:3]','entries [0:1]').replace('logic [1:0] head, tail;','logic head, tail;').replace(\\\"count < 3'd4\\\", \\\"count < 3'd2\\\").replace(\\\"tail + 2'd1\\\", \\\"tail + 1'b1\\\").replace(\\\"head + 2'd1\\\", \\\"head + 1'b1\\\")\n    s.write_text(t)\n    s=p/'rtl/core.sv';t=s.read_text().replace('.push(fetch_accept), .pop(fetch_pop), .in(fetch_w),', '.push(fetch_accept), .pop(fetch_pop), .available(io_imemReady), .in(fetch_w),')\n    s.write_text(t)\n    print(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
