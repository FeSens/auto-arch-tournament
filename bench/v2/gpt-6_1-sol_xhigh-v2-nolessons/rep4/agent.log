{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_divider.py'", "aggregated_output": "\"\"\"Execute-stage transaction checks with downstream acceptance held off.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIVU, run_cocotb\n\n\nID_FIELDS = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n             (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n             (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, **values):\n    result = 0\n    for name, width in fields:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(fields, value):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = value & ((1 << width) - 1)\n        value >>= width\n    return result\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\n@cocotb.test()\nasync def completion_waits_for_acceptance(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Put an older store into EX/MEM, then hold it with dmem backpressure.\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x20, rs2_val=0x55,\n                            ctrl=1 << 6, instr=0x00202023, valid=1)\n    await _tick(dut)\n    older = int(dut.out.value)\n    assert older != 0\n\n    instruction = 0x0220D1B3  # DIVU x3,x1,x2\n    control = (ALU_DIVU << 17) | (1 << 2)  # alu_op, reg_write\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x24, rs1_val=999, rs2_val=999,\n                            rd=3, rs1_addr=1,\n…[1374 of 4446 chars elided by tools/bench/transcript.py; sha256:c0149c0bb149ff33]…\n        assert int(dut.out.value) == 0\n\n    dut.stall.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.div_consume.value) and not int(dut.divider_wait.value)\n    await _tick(dut)\n    result = _unpack(EX_FIELDS, int(dut.out.value))\n    assert result[\"valid\"] and result[\"alu_result\"] == 14\n    assert result[\"pc\"] == 0x24 and result[\"pc_next\"] == 0x28\n    assert result[\"instr\"] == instruction and result[\"ctrl\"] == control\n    assert (result[\"rd\"], result[\"rs1_addr\"], result[\"rs2_addr\"]) == (3, 1, 2)\n    assert (result[\"rs1_val\"], result[\"rs2_val\"], result[\"write_data\"]) == (100, 7, 7)\n    assert not int(dut.div_busy.value) and not int(dut.div_result_valid.value)\n    # Model ID/EX advancing on that same edge; no second emission follows.\n    dut[\"in\"].value = 0\n    await _tick(dut)\n    assert int(dut.out.value) == 0 and not int(dut.div_busy.value)\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n", "exit_code": 0, "status": "completed"}}
