{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,300p' cores/bench/test/test_ex_divider.py\"", "aggregated_output": "\"\"\"Execute-stage transaction checks with downstream acceptance held off.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIVU, run_cocotb\n\nALTOPS = os.environ.get(\"EX_DIV_ALTOPS\") == \"1\"\n\n\ndef _divu(a, b):\n    return ((a - b) ^ 0x10E8FD70) & 0xFFFFFFFF if ALTOPS else a // b\n\n\nID_FIELDS = [(\"alu_a_val\", 32), (\"alu_b_val\", 32),\n             (\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n             (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n             (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, **values):\n    result = 0\n    for name, width in fields:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(fields, value):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = value & ((1 << width) - 1)\n        value >>= width\n    return result\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\n@cocotb.test()\nasync def completion_waits_for_acceptance(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.squash.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0b001\n    dut.fwd_rs2_sel.value = 0b001\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Put an older store into EX/MEM, then hold it with dmem backpressure.\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x20, rs2_val=0x55,\n                            ctrl=1 << 6, instr=0x00202023, valid=1)\n    await _tick(dut)\n    older = int(dut.out.value)\n    assert older != \n…[5709 of 8781 chars elided by tools/bench/transcript.py; sha256:a07c7f51c80b6ce5]…\n, 19, 19)\n        dut[\"in\"].value = 0\n        await _tick(dut)\n        assert int(dut.out.value) == 0 and not int(dut.div_busy.value)\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"mul_predictor.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n\n\ndef test_ex_divider_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"ex_stage_altops\"\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"alu.sv\", \"mul_predictor.sv\", \"ex_stage.sv\")],\n        hdl_toplevel=\"ex_stage\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1}, build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"],\n    )\n    runner.test(\n        hdl_toplevel=\"ex_stage\", test_module=\"test_ex_divider\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), extra_env={\"EX_DIV_ALTOPS\": \"1\"},\n    )\n", "exit_code": 0, "status": "completed"}}
