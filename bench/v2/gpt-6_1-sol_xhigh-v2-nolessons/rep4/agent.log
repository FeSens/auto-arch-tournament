: 24534, 'consumer': 294127, 'consumer_miss': 278014}\n16 pc_stride {'load': 544852, 'hit': 172010, 'consumer': 294127, 'consumer_miss': 234385}\n32 address_fold {'load': 544852, 'hit': 257978, 'consumer': 294127, 'consumer_miss': 154870}\n32 pc_last {'load': 544852, 'hit': 29828, 'consumer': 294127, 'consumer_miss': 274874}\n32 pc_stride {'load': 544852, 'hit': 178893, 'consumer': 294127, 'consumer_miss': 231285}\n","exit_code":0,"status":"completed"}}
