{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK = (1 << 32) - 1\n\ndef proposed(a, b, signed):\n    aneg = signed and bool(a & (1 << 31))\n    bneg = signed and bool(b & (1 << 31))\n    amag = (-a & MASK) if aneg else a\n    bmag = (-b & MASK) if bneg else b\n    q, r = 0, 0\n    for k in range(1, 33):\n        candidate = (r << 1) | ((amag >> (32-k)) & 1)\n        diff = (candidate - (bmag & ((1 << k)-1))) & ((1 << (k+1))-1)\n        take = not (bmag >> k) and not (diff >> k)\n        r = (diff & ((1 << k)-1)) if take else candidate\n        q = (q << 1) | int(take)\n    if aneg \"'!= bneg:\n        q = -q & MASK\n    if aneg:\n        r = -r & MASK\n    return (MASK, a) if b == 0 else (q, r)\n\ndef reference(a, b, signed):\n    if not b:\n        return MASK, a\n    if signed:\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n    q = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        q = -q\n    return q & MASK, (a - q*b) & MASK\n\nspecial = {0, 1, 2, 3, MASK, MASK-1, 0x80000000, 0x7fffffff}\nfor i in range(32):\n    special.update({(1 << i)-1, 1 << i, ((1 << i)+1) & MASK})\nrng = random.Random(20261005)\ncases = [(a,b) for a in sorted(special) for b in sorted(special)]\ncases.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(20000))\nfor a,b in cases:\n    for signed in (False, True):\n        got = proposed(a,b,signed)\n        want = reference(a,b,signed)\n        assert got == want, (hex(a),hex(b),signed,got,want)\nprint(f'\"'Recurrence sanity check passed: {2*len(cases)} signed/unsigned quotient-remainder pairs. This checks the proposed algorithm, not implemented RTL or timing.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
