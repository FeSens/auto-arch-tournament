{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_mem_repair.py; tail -60 cores/bench/test/test_alu.py; cat cores/bench/test/_helpers.py'", "aggregated_output": "\"\"\"MEM/WB repair record qualification, target clocking, and quarantine.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb\nfrom test_ex_divider import EX_FIELDS, _pack, _unpack\n\n\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"pc_next\", 32), (\"mem_addr\", 32), (\"mem_rdata\", 32),\n             (\"mem_wdata\", 32), (\"mem_wmask\", 4), (\"mem_rmask\", 4),\n             (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\n@cocotb.test()\nasync def repair_records_only_advancing_legal_writers(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.hold_wb.value = 0\n    dut[\"in\"].value = 0\n    dut.dmem_rdata.value = 0x12345678\n    dut.dmem_ready.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    target = 0\n    for valid, rd, illegal, writer in ((0, 3, 0, 1), (1, 0, 0, 1),\n                                       (1, 3, 1, 1), (1, 3, 0, 0)):\n        control = (ALU_MUL << 17) | (writer << 2) | illegal\n        target += 4\n        dut[\"in\"].value = _pack(EX_FIELDS, pc=target - 4, pc_next=target,\n                                rs1_val=0x10001, rs2_val=4, alu_result=4,\n                                rd=rd, ctrl=control, valid=valid)\n        await Timer(1, \"ns\")\n        assert not int(dut.mul_repair.value), \"validation leaked combinational recovery\"\n        await _tick(dut)\n        assert not int(dut.mul_repair.value)\n        assert int(dut.mul_repair_target.value) == target, \"target needs no mismatch enable\"\n        wb = _unpack(WB_FIELDS, int(dut.out.value))\n        assert wb[\"alu_result\"] == 0x40004 and wb[\"valid\"] == valid\n\n    # A held MEM instruction cannot create a repair, and retains WB data.\n    control = (ALU_MUL << 17) | 4\n    dut[\"in\"].value = _p\n…[11146 of 14218 chars elided by tools/bench/transcript.py; sha256:983ba8784542e5ab]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
