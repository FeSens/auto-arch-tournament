2,\n    \"correct\": 261302,\n    \"misses\": 283550,\n    \"dep_misses\": 129500,\n    \"prediction_failures\": 0\n  },\n  \"64\": {\n    \"loads\": 544852,\n    \"hits\": 395527,\n    \"correct\": 395527,\n    \"misses\": 149325,\n    \"dep_misses\": 73584,\n    \"prediction_failures\": 0\n  },\n  \"128\": {\n    \"loads\": 544852,\n    \"hits\": 514383,\n    \"correct\": 514383,\n    \"misses\": 30469,\n    \"dep_misses\": 3364,\n    \"prediction_failures\": 0\n  },\n  \"256\": {\n    \"loads\": 544852,\n    \"hits\": 529445,\n    \"correct\": 529445,\n    \"misses\": 15407,\n    \"dep_misses\": 1586,\n    \"prediction_failures\": 0\n  }\n}\n","exit_code":0,"status":"completed"}}
