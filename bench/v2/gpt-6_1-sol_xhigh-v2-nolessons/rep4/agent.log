{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport importlib.util,collections,json\ns=importlib.util.spec_from_file_location('ref','test/cosim/reference.py'); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)\nc=m.RV32IM(); c.load_elf('/srv/hwebench/tmp/b62664fd/8ea9497e/r12s2-coremark.elf')\nactive=False; counts=collections.Counter(); jalrs=collections.Counter(); targets=collections.defaultdict(collections.Counter)\nbanks={n:{} for n in (4,8,16,32,64)}; stats={n:collections.Counter() for n in banks}; ras=[]; rstats=collections.Counter()\nbranches=collections.Counter(); tables={n:[2]*n for n in (16,32,64,128,256)}; bstats={n:collections.Counter() for n in tables}\nfor k in range(10000000):\n r=c.step()\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n if r['mem_wmask'] and r['mem_addr']==0x10000104: active=False\n i=r['insn']; op=i&127; pc=r['pc']; rd=(i>>7)&31; rs1=(i>>15)&31\n if active:\n  counts[hex(op)]+=1\n if op==0x67 and not r['trap']:\n  for n,bank in banks.items():\n   idx=(pc>>2)&(n-1); entry=bank.get(idx); hit=entry is not None and entry[0]==pc\n   if active: stats[n]['hit' if hit else 'miss']+=1; stats[n]['correct']+=bool(hit and entry[1]==r['npc'])\n   bank[idx]=(pc,r['npc'])\n  if active:\n   jalrs[(pc,rd,rs1)]+=1;targets[pc][r['npc']]+=1\n   if rd==0 and rs1 in (1,5) and i>>20==0:\n    rstats['returns']+=1; rstats['ras_correct']+=bool(ras and ras[-1]==r['npc'])\n  if rs1 in (1,5) and rd not in (1,5) and ras: ras.pop()\n if op in (0x6f,0x67) and rd in (1,5) and not r['trap']:\n  ras.append((pc+4)&0xffffffff)\n  if len(ras)>8: ras=ras[-8:]\n if op==0x63 and not r['trap']:\n  taken=r['npc']\"'!=((pc+4)&0xffffffff)\n  if active: branches[pc]+=1\n  for n,t in tables.items():\n   idx=(pc>>2)&(n-1); pred=t[idx]>=2\n   if active: bstats[n]['\"'mispred']+=pred\"'!=taken;bstats[n]['\"'branches']+=1\n   t[idx]=min(3,t[idx]+1) if taken else max(0,t[idx]-1)\n if i=