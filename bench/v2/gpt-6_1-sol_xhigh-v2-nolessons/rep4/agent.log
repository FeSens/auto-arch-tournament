d to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[36957 of 40029 chars elided by tools/bench/transcript.py; sha256:43f2c6661f54fc08]…\n not int(dut.u_ex.div_busy.value) and not int(dut.u_ex.div_result_valid.value)\n    assert int(dut.id_ex_w.value) == int(dut.oc_ex_w.value) == int(dut.ex_mem_w.value) == int(dut.mem_wb_w.value) == 0\n    assert not int(dut.u_oc.rs1_ready_q.value) and not int(dut.u_oc.rs2_ready_q.value)\n    rets, _ = await _run(dut, program, dmem_init={0x100: 0x10001}, max_cycles=150)\n    _check_arithmetic_trace(rets)\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert next(r for r in rets if r[\"pc\"] == 12)[\"rd_wdata\"] == 0x10001\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_predictor.sv\", \"mul_exact.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\", \"operand_stage.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
