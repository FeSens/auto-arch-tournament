{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,json,collections,time\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('/srv/hwebench/tmp/b62664fd/0b78fa10/coremark-profile.elf')\nactive=False; windows=0\npairs=collections.Counter(); allpairs=collections.Counter(); pcs=collections.Counter(); widths=collections.Counter(); classes=collections.Counter();br=collections.Counter()\ndef marker_ww(addr,value):\n global active,windows\n if addr==0x10000100: active=True;windows+=1;return\n if addr==0x10000104: active=False;return\n RV32IM.ww(cpu,addr,value)\ncpu.ww=marker_ww\nstart=time.monotonic()\nfor n in range(10000000):\n insn=cpu.rw(cpu.pc);op=insn&127;pc=cpu.pc\n if active:classes[op]+=1\n if op==0x33 and insn>>25==1 and (insn>>12)&7==0:\n  a=cpu.regs[(insn>>15)&31];b=cpu.regs[(insn>>20)&31]\n  allpairs[a,b]+=1\n  if active:\n   pairs[a,b]+=1;pcs[pc]+=1\n if active and op==0x63:\n  pass\n r=cpu.step()\n if r['insn']==0x00100073:break\nelse:raise RuntimeError('No completion')\ndef sx(a,w):\n a&=(1<<w)-1\n return a-(1<<w) if a>>(w-1) else a\nmisses={}\nfor wa in [8,9,10,11,12,13,14,15,16]:\n for wb in [8,9,10,11,12,13,14,15,16]:\n  misses[f'{wa}x{wb}']=sum(c for (a,b),c in pairs.items() if (sx(a,wa)*sx(b,wb))&0xffffffff\"'!=(a*b)&0xffffffff)\nprint('\"'elapsed',round(time.monotonic()-start,2),'retired',cpu.retired,'windows',windows,'oob',cpu.oob_access,'classes',classes)\nprint('MUL count',sum(pairs.values()),'all MUL count',sum(allpairs.values()),'unique pairs',len(pairs),'by PC',dict(pcs))\nprint('signed ranges',min(sx(a,32) for a,b in pairs),max(sx(a,32) for a,b in pairs),min(sx(b,32) for a,b in pairs),max(sx(b,32) for a,b in pairs))\nprint('misses',json.dumps(misses))\nprint('UART',cpu.uart_buf.decode(errors='replace'))\nPath('/srv/hwebench/tmp/b62664fd/0b78fa10/mul-profile.json').write_text(json.dumps({'retired':cpu.retired,'classes':classes,'pcs':pcs,'pairs':[[a,b,c] for (a,b),c in pairs.items()],'allpairs':[[a,b,c] for (a,b),c in allpairs.items()],'misses':misses}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
