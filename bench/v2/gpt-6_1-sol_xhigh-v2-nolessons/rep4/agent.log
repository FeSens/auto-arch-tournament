{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os,shutil\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'r12-fast-arith-probe'\nr=p/'rtl'; r.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,r/f.name)\nhelper='''module fast_arith #(parameter bit SUBTRACT = 1'b0) (\n  input logic [31:0] a,b,\n  output logic [31:0] sum,\n  output logic carry_out\n);\n  logic [31:0] bb;\n  logic [7:0] g0,p0,g1,p1,g2,p2,g3,p3;\n  logic [8:0] c;\n  assign bb = SUBTRACT ? ~b : b;\n  assign c[0] = SUBTRACT;\n  for (genvar k=0;k<8;k=k+1) begin : blocks\n    logic [4:0] s0;\n    logic [5:0] s1;\n    assign s0 = {1'b0,a[k*4+:4]} + {1'b0,bb[k*4+:4]};\n    assign s1 = {1'b0,a[k*4+:4],1'b1} + {1'b0,bb[k*4+:4],1'b1};\n    assign g0[k] = s0[4];\n    assign p0[k] = &(a[k*4+:4] \"'^ bb[k*4+:4]);\n    if (k>=1) begin\n      assign g1[k] = g0[k] | (p0[k] & g0[k-1]);\n      assign p1[k] = p0[k] & p0[k-1];\n    end else begin\n      assign g1[k] = g0[k];\n      assign p1[k] = p0[k];\n    end\n    if (k>=2) begin\n      assign g2[k] = g1[k] | (p1[k] & g1[k-2]);\n      assign p2[k] = p1[k] & p1[k-2];\n    end else begin\n      assign g2[k] = g1[k];\n      assign p2[k] = p1[k];\n    end\n    if (k>=4) begin\n      assign g3[k] = g2[k] | (p2[k] & g2[k-4]);\n      assign p3[k] = p2[k] & p2[k-4];\n    end else begin\n      assign g3[k] = g2[k];\n      assign p3[k] = p2[k];\n    end\n    assign c[k+1] = g3[k] | (p3[k] & c[0]);\n    assign sum[k*4+:4] = c[k] ? s1[4:1] : s0[3:0];\n  end\n  assign carry_out = c[8];\nendmodule\n'\"'''\n(r/'fast_arith.sv').write_text(helper)\nf=r/'alu.sv'; s=f.read_text(); marker='  always_comb begin\\\\n    shamt = b[4:0];'\nnew='''  logic [31:0] fast_sum, fast_difference;\n  logic fast_sub_carry;\n  fast_arith u_fast_add (.a(a),.b(b),.sum(fast_sum),.carry_out());\n  fast_arith #(.SUBTRACT(1'b1)) u_fast_sub (.a(a),.b(b),.sum(fast_difference),.carry_out(fast_sub_carry));\n'''\nassert marker in s; s=s.replace(marker,new+'\\\\n'+marker)\ns=s.replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = fast_sum;').replace('ALU_SUB:    out = a - b;', 'ALU_SUB:    out = fast_difference;')\ns=s.replace(\\\"ALU_SLT:    out = {31'b0, \"'$signed(a) < $signed(b)};\", \"ALU_SLT:    out = {31'\"'b0, (a[31] \"'!= b[31]) ? a[31] : !fast_sub_carry};\")\ns=s.replace(\"ALU_SLTU:   out = {31'\"'b0, a < b};\\\", \\\"ALU_SLTU:   out = {31'b0, \"'!fast_sub_carry};\")\nf.write_text(s)\nf=r/'\"'ex_stage.sv'; s=f.read_text(); marker='  // ── Branch resolve'\nnew='''  logic [31:0] fast_pc_target, fast_source_target, fast_pc_plus4;\n  logic fast_compare_carry, fast_unsigned_lt, fast_signed_lt;\n  fast_arith u_fast_pc_target (.a(in.pc),.b(in.imm),.sum(fast_pc_target),.carry_out());\n  fast_arith u_fast_source_target (.a(rs1),.b(in.imm),.sum(fast_source_target),.carry_out());\n  fast_arith u_fast_pc_plus4 (.a(in.pc),.b(32'd4),.sum(fast_pc_plus4),.carry_out());\n  fast_arith #(.SUBTRACT(1'b1)) u_fast_compare (.a(rs1),.b(rs2),.sum(),.carry_out(fast_compare_carry));\n  assign fast_unsigned_lt = \"'!fast_compare_carry;\n  assign fast_signed_lt = (rs1[31] != rs2[31]) ? rs1[31] : fast_unsigned_lt;\n'\"'''\nassert marker in s; s=s.replace(marker,new+'\\\\n'+marker)\ns=s.replace('(\"'$signed(rs1) <  $signed(rs2))'\"','fast_signed_lt').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!fast_signed_lt'\"').replace('(rs1 <  rs2)','fast_unsigned_lt').replace('(rs1 >= rs2)','\"'!fast_unsigned_lt'\"')\ns=s.replace('in.pc + in.imm','fast_pc_target').replace('rs1 + in.imm','fast_source_target').replace(\\\"in.pc + 32'd4\\\",'fast_pc_plus4')\nf.write_text(s)\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
