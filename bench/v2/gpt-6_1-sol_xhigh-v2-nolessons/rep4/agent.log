{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_fetch_predictor.py; rg -n 'train|direction|predict' cores/bench/test/test_pipeline.py; sed -n '1,160p' cores/bench/test/conftest.py; sed -n '1,160p' cores/bench/test/_helpers.py\"", "aggregated_output": "\"\"\"Instruction qualification, deterministic table reset, and read/write edges.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\ndef _payload(dut):\n    value = int(dut.out.value)\n    return value >> 34, (value >> 2) & 0xFFFFFFFF, (value >> 1) & 1, value & 1\n\n\nasync def _pc(dut, value):\n    dut.redirect.value = 1\n    dut.redirect_target.value = value\n    await _tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def reset_all_entries_and_same_edge_training(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.accept.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.branch_train_en.value = 0\n    dut.branch_train_index.value = 0\n    dut.branch_train_taken.value = 0\n    dut.imem_data.value = BEQ(0, 0, 8)\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Every entry starts weakly taken; one decrement crosses its threshold.\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut) == (index * 4, BEQ(0, 0, 8), 1, 1)\n        dut.branch_train_en.value = 1\n        dut.branch_train_index.value = index\n        dut.branch_train_taken.value = 0\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == 1, \"write changed prediction before the edge\"\n        await _tick(dut)\n        dut.branch_train_en.value = 0\n        assert _payload(dut)[2] == 0 and int(dut.imem_addr.value) == index * 4\n\n    # A reset restores all entries, including those whose MSB was cleared.\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut)[2] == 1\n\n    await _pc(dut, 0)\n    dut.branch_train_en.value = 1\n    dut.branch_train_index\n…[6695 of 9767 chars elided by tools/bench/transcript.py; sha256:5e3e480c39637706]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
