{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nprototype=Path('/srv/hwebench/tmp/b62664fd/bbb89c33/load-prediction-probe/rtl')\nprototype.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copyfile(p,prototype/p.name)\np=prototype/'mem_stage.sv'\ns=p.read_text()\ns=s.replace('  logic [31:0] load_data;','  logic [31:0] load_data;\\\\n  logic [31:0] predicted_load_data;')\nneedle='    // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.'\ninsert='''    // Speculative unsigned/narrow MEM-to-OC forwarding only.\n    // MEM/WB still commits load_data and a mismatch triggers older repair.\n    case (in.ctrl.mem_width)\n      2'd0: predicted_load_data = {24'b0, byte_val};\n      2'd1: predicted_load_data = {16'b0, hword_val};\n      default: predicted_load_data = {12'b0, dmem_rdata[19:0]};\n    endcase\n\n'''\nassert needle in s;s=s.replace(needle,insert+needle)\ns=s.replace('assign bypass_value = in.ctrl.mem_read ? load_data : in.alu_result;', 'assign bypass_value = in.ctrl.mem_read ? predicted_load_data : in.alu_result;')\nneedle=\\\"\\\"\\\"      mul_repair <= in.valid && is_mul && \"'!in.ctrl.is_illegal &&\n                    in.ctrl.reg_write && in.rd != 5'\"'b0 &&\n                    exact_product \"'!= in.alu_result;\"\"\"\nreplace=\"\"\"      mul_repair <= in.valid && !ctrl_with_trap.is_illegal &&\n                    in.ctrl.reg_write && in.rd != 5'\"'b0 &&\n                    ((is_mul && exact_product \"'!= in.alu_result) ||\n                     (in.ctrl.mem_read && dmem_ready && dmem_ren &&\n                      predicted_load_data != load_data));\"\"\"\nassert needle in s;s=s.replace(needle,replace)\np.write_text(s)\nprint('\"'Created isolated unsigned-20-bit load prediction prototype')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
