{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_hazard.py; sed -n '1,280p' cores/bench/test/test_pipeline.py; rg -n '\"'^(def |async def |@)|redirect|train|stall|mul_repair|divider'\"' cores/bench/test/test_pipeline.py; rg --files cores/bench/test; cat tools/eval/gowin.py\"", "aggregated_output": "\"\"\"OC/EX occupancy, operand readiness, bus holds and recovery priority.\"\"\"\nfrom __future__ import annotations\n\nimport itertools\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\n\n\n@cocotb.test()\nasync def repair_and_hold_priorities(dut):\n    for occupied, resolved, repair, divider, iready, dready, memop in itertools.product((0, 1), repeat=7):\n        dut.oc_valid.value = occupied\n        dut.operands_ready.value = resolved\n        dut.redirect.value = repair\n        dut.divider_wait.value = divider\n        dut.imem_ready.value = iready\n        dut.dmem_ready.value = dready\n        dut.ex_mem_mem_op.value = memop\n        await Timer(1, \"ns\")\n        memory_hold = int(memop and not dready)\n        ex_hold = int(memory_hold or divider)\n        id_hold = int(occupied and (ex_hold or not resolved))\n        expected = (int(id_hold or not iready), id_hold, int(not iready), 0,\n                    memory_hold, memory_hold, ex_hold)\n        if repair:\n            expected = (0, 0, 1, 1, memory_hold, memory_hold, ex_hold)\n        outputs = tuple(int(dut[name].value) for name in\n                        (\"stall_if\", \"stall_id\", \"flush_if\", \"flush_id\",\n                         \"stall_ex_mem\", \"hold_mem_wb\", \"hold_oc_ex\"))\n        assert outputs == expected, (occupied, resolved, repair, divider, iready, dready, memop, outputs)\n\n\ndef test_hazard_runner():\n    run_cocotb(toplevel=\"hazard_unit\", sources=[\"hazard_unit.sv\"], test_module=\"test_hazard\")\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minim