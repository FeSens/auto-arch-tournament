op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    expected = _expected(op, a, b, expected)\n    assert actual == expected, (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    \"\"\"Check capture, finite completion, held result, an\n…[9366 of 12438 chars elided by tools/bench/transcript.py; sha256:d8b865837f2e8c11]…\nawait _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, MASK32)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_alu_altops_runner():\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, TEST_DIR, SIM_BUILD\n\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1}, build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"],\n    )\n    runner.test(\n        hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=str(TEST_DIR),\n        build_dir=str(build_dir), extra_env={\"ALU_ALTOPS\": \"1\"},\n    )\ncores/bench/rtl/alu.sv:21:module alu #(\ncores/bench/rtl/ex_stage.sv:92:  alu #(.FULL_MUL_ENABLED(1'b0)) u_alu (\n", "exit_code": 0, "status": "completed"}}
