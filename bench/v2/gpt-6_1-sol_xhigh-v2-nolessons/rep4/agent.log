{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_mul_predictor.py cores/bench/test/test_fetch_predictor.py'", "aggregated_output": "\"\"\"Exact MEM arithmetic and speculative EX arithmetic, including ALTOPS.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n                      RTL, TEST_DIR, SIM_BUILD)\n\nMASK = 0xFFFFFFFF\nOPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nALT_MASKS = (0x5876063E, 0xF6583FB7, 0x949CE5E8, 0xECFBE137)\n\n\ndef _signed(value, bits):\n    value &= (1 << bits) - 1\n    return value - (1 << bits) if value & (1 << (bits - 1)) else value\n\n\n@cocotb.test()\nasync def products(dut):\n    exact = os.environ[\"MUL_HELPER\"] == \"mul_exact\"\n    altops = os.environ[\"MUL_ALTOPS\"] == \"1\"\n    narrow = [0, 1, -1, 2, -2, -32768, -32767, 32766, 32767]\n    wide = [0x8000, 0xFFFF, 0x10000, 0x10001, 0x7FFFFFFF,\n            0x80000000, 0x80000001, 0xFFFF0000, MASK]\n    pairs = [(a & MASK, b & MASK) for a in narrow for b in narrow]\n    pairs += [(a, b) for a in wide for b in wide + [0, 1, 2, 3]]\n    rng = random.Random(0x161632)\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(256)]\n    misses = [0] * 4\n    for a, b in pairs:\n        reference = (a * b, (_signed(a, 32) * _signed(b, 32)) >> 32,\n                     (a * b) >> 32, (_signed(a, 32) * b) >> 32)\n        for index, op in enumerate(OPS):\n            dut.op.value = op\n            dut.a.value = a\n            dut.b.value = b\n            await Timer(1, \"ns\")\n            if altops:\n                expected = ((a - b if op == ALU_MULHSU else a + b)\n                            ^ ALT_MASKS[index]) & MASK\n            elif exact:\n                expected = reference[index] & MASK\n            else:\n                expected = (_signed(a, 16) * _signed(b, 16)) & MASK if op == ALU_MUL else 0\n                misses[index] += expected != reference[index] & MASK\n                if op == ALU_MUL and a == (_signed(a, 16) & MASK) and b == (_signed(b, 16) & MASK):\n                    assert expected == refer\n…[3861 of 6933 chars elided by tools/bench/transcript.py; sha256:1d86b04b651cb13c]…\ncceptance.\n    dut.flush.value = 1\n    await Timer(1, \"ns\")\n    assert _payload(dut) == (256, JAL(1, -256), 1, 0)\n    await _pc(dut, 0)\n    assert int(dut.imem_addr.value) == 0\n    dut.flush.value = 0\n    for instruction in (NOP(), JALR(1, 0, 8), _b(8, 0, 0, 2, 0x63),\n                        _b(8, 0, 0, 3, 0x63), BEQ(0, 0, 2), JAL(1, 2)):\n        dut.imem_data.value = instruction\n        dut.accept.value = 1\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == 0, f\"unqualified direct prediction: {instruction:#x}\"\n        previous = int(dut.imem_addr.value)\n        await _tick(dut)\n        assert int(dut.imem_addr.value) == previous + 4\n    dut.accept.value = 0\n    dut.imem_data.value = JAL(1, 8)\n    for _ in range(5):\n        previous = int(dut.imem_addr.value)\n        await _tick(dut)\n        assert int(dut.imem_addr.value) == previous\n\n\ndef test_fetch_predictor_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n               test_module=\"test_fetch_predictor\")\n", "exit_code": 0, "status": "completed"}}
