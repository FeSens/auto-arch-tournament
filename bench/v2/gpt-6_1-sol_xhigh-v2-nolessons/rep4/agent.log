{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl');dst=Path('/srv/hwebench/tmp/b62664fd/9b957951/predictor_research/prototype_rtl');dst.mkdir(exist_ok=True)\nfor p in src.glob('*.sv'):shutil.copyfile(p,dst/p.name)\np=dst/'alu.sv';s=p.read_text();s=s.replace('module alu (','module alu #(parameter ENABLE_MUL = 1) (');s=s.replace('mul_ss = \"'$signed'\"','mul_ss = ENABLE_MUL ? \"'$signed'\"').replace('a}) * \"'$signed({{32{b[31]}}, b});'\"','a}) * \"'$signed({{32{b[31]}}, b}) : 64'\"\\\\'b0;');s=s.replace('mul_uu = {32\\\\'b0, a} * {32\\\\'b0, b};','mul_uu = ENABLE_MUL ? {32\\\\'b0, a} * {32\\\\'b0, b} : 64\\\\'b0;');s=s.replace('mul_su = \"'$signed'\"','mul_su = ENABLE_MUL ? \"'$signed'\"').replace('a}) * \"'$signed({32'\"\\\\'b0, b});','a}) * \"'$signed({32'\"\\\\'b0, b}) : 64\\\\'b0;');p.write_text(s)\np=dst/'ex_stage.sv';s=p.read_text();s=s.replace('  input  id_ex_t   in,','  input logic older_repair,\\\\n  input  id_ex_t   in,');s=s.replace('  alu u_alu (','  alu #(.ENABLE_MUL(0)) u_alu (');s=s.replace('assign div_start = in.valid','assign div_start = \"'!older_repair && in.valid'\"');s=s.replace('assign divider_wait = (div_busy','assign divider_wait = \"'!older_repair && (div_busy'\"');s=s.replace('assign redirect = in.valid','assign redirect = \"'!older_repair && in.valid'\"');s=s.replace('assign branch_train_en = in.valid','assign branch_train_en = \"'!older_repair && in.valid'\"');s=s.replace('  // ── EX/MEM register','  logic [31:0] predicted_mul;\\\\n  logic is_mul;\\\\n  assign is_mul = in.ctrl.alu_op >= ALU_MUL && in.ctrl.alu_op <= ALU_MULHSU;\\\\n  mul_predictor u_predict (.op(in.ctrl.alu_op), .a(rs1), .b(rs2), .result(predicted_mul));\\\\n\\\\n  // ── EX/MEM register');s=s.replace(': alu_result;',': is_mul ? predicted_mul : alu_result;');s=s.replace('        if (div_consume) begin','        if (older_repair) begin\\\\n          reg_q <= \\\\'0;\\\\n        end else if (div_consume) begin');p.write_text(s)\np=dst/'mem_stage.sv';s=p.read_text();s=s.replace('  output mem_wb_t  out','  output logic mul_repair,\\\\n  output logic [31:0] mul_repair_target,\\\\n  output mem_wb_t  out');s=s.replace('  // ── MEM/WB register','  logic [31:0] exact_mul_result;\\\\n  logic is_mul;\\\\n  assign is_mul = in.ctrl.alu_op >= ALU_MUL && in.ctrl.alu_op <= ALU_MULHSU;\\\\n  exact_mul u_exact (.op(in.ctrl.alu_op), .a(in.rs1_val), .b(in.rs2_val), .result(exact_mul_result));\\\\n  assign mul_repair = in.valid && is_mul && in.ctrl.reg_write && in.rd \"'!= 0 && !hold_wb && in.alu_result != exact_mul_result;'\"\\\\n  assign mul_repair_target = in.pc_next;\\\\n\\\\n  // ── MEM/WB register');s=s.replace('reg_q.alu_result <= in.alu_result;','reg_q.alu_result <= is_mul ? exact_mul_result : in.alu_result;');p.write_text(s)\np=dst/'core.sv';s=p.read_text();s=s.replace('  // regfile interface','  logic ex_redirect, mul_repair;\\\\n  logic [31:0] ex_redirect_target, mul_repair_target;\\\\n  assign redirect = mul_repair || ex_redirect;\\\\n  assign redirect_target = mul_repair ? mul_repair_target : ex_redirect_target;\\\\n\\\\n  // regfile interface');s=s.replace('    .stall           (stall_ex_mem),','    .stall           (stall_ex_mem),\\\\n    .older_repair (mul_repair),');start=s.index('  ex_stage u_ex');end=s.index('  // ── MEM',start);block=s[start:end].replace('.redirect        (redirect)', '.redirect        (ex_redirect)').replace('.redirect_target (redirect_target)', '.redirect_target (ex_redirect_target)');s=s[:start]+block+s[end:];s=s.replace('    .out        (mem_wb_w)','    .mul_repair (mul_repair),\\\\n    .mul_repair_target (mul_repair_target),\\\\n    .out        (mem_wb_w)');p.write_text(s)\n(dst/'mul_predictor.sv').write_text('''module mul_predictor(input logic [4:0] op, input logic [31:0] a,b, output logic [31:0] result);\nlogic signed [15:0] narrow_a,narrow_b;\nlogic signed [31:0] narrow_product;\nassign narrow_a = \"'$signed(a[15:0]);\nassign narrow_b = $signed(b[15:0]);\nassign narrow_product = narrow_a * narrow_b;\nalways_comb begin\n`ifdef RISCV_FORMAL_ALTOPS\n case(op)\n ALU_MUL: result=(a+b)''^32'\"'h5876063e;\n ALU_MULH: result=(a+b)\"'^32'\"'hf6583fb7;\n ALU_MULHU: result=(a+b)\"'^32'\"'h949ce5e8;\n ALU_MULHSU: result=(a-b)\"'^32'\"'hecfbe137;\n default: result=0;\n endcase\n\"'`else\n result = op == ALU_MUL ? $unsigned(narrow_product) : 0;\n`endif\nend\nendmodule\nmodule exact_mul(input logic [4:0] op, input logic [31:0] a,b, output logic [31:0] result);\nlogic signed [63:0] mul_ss,mul_su;\nlogic [63:0] mul_uu;\nalways_comb begin\n mul_ss=$signed({{32{a[31]}},a})*$signed({{32{b[31]}},b});\n mul_uu={32'\"'b0,a}*{32'b0,b};\n mul_su=\"'$signed({{32{a[31]}},a})*$signed({32'\"'b0,b});\n\"'`ifdef RISCV_FORMAL_ALTOPS\n case(op)\n ALU_MUL: result=(a+b)''^32'\"'h5876063e;\n ALU_MULH: result=(a+b)\"'^32'\"'hf6583fb7;\n ALU_MULHU: result=(a+b)\"'^32'\"'h949ce5e8;\n ALU_MULHSU: result=(a-b)\"'^32'\"'hecfbe137;\n default: result=0;\n endcase\n\"'`else\n case(op)\n ALU_MUL: result=mul_uu[31:0];\n ALU_MULH: result=$unsigned(mul_ss[63:32]);\n ALU_MULHU: result=mul_uu[63:32];\n ALU_MULHSU: result=$unsigned(mul_su[63:32]);\n default: result=0;\n endcase\n`endif\nend\nendmodule\n'\"''')\nprint('Temporary timing prototype created outside core source tree.')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
