/ \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[13224 of 16296 chars elided by tools/bench/transcript.py; sha256:d7bb09c515555e37]…\nm(1 for r in res if not r['placement_failed'])}\ntools/eval/fpga.py:336:      {'placement_failed': True, ...}    — the design does not fit or route\ntools/eval/fpga.py:340:        'fmax_mhz': float,               — median over gowin.PLACE_OPTIONS\ntools/eval/fpga.py:341:        'ipc_coremark': float,           — iter/cycle\ntools/eval/fpga.py:344:        'seeds': [float, ...],           — Fmax per placement option\ntools/eval/fpga.py:356:        str(Path(worktree) / \"cores\" / target / \"obj_dir\" / \"cosim_sim\")\ntools/eval/fpga.py:364:    if fp['placement_failed']:\ntools/eval/fpga.py:368:        return {'bench_failed': True, 'placement_failed': False,\ntools/eval/fpga.py:372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\ntools/eval/fpga.py:379:            'placement_failed': False,\ntools/eval/fpga.py:385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\nalu.sv\ncore.sv\ncore_pkg.sv\ndecoder.sv\nex_stage.sv\nforward_unit.sv\nhazard_unit.sv\nid_stage.sv\nif_stage.sv\nimm_gen.sv\nmem_stage.sv\nreg_file.sv\nwb_stage.sv\n", "exit_code": 0, "status": "completed"}}
