{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/rtl');p=Path('/srv/hwebench/tmp/b62664fd/2dba8126/early128rtl');p.mkdir(exist_ok=True)\nfor f in base.glob('*.sv'):shutil.copy2(f,p/f.name)\ns=Path('/srv/hwebench/tmp/b62664fd/2dba8126/load16rtl/load_predictor.sv').read_text()\ns=s.replace('input logic [31:0] lookup_addr,\\\\n  output logic hit,','input logic [6:0] lookup_index,\\\\n  output logic prediction_valid,\\\\n  output logic [22:0] prediction_tag,')\ns=s.replace('logic [15:0] valid_q;','logic [127:0] valid_q;').replace('logic [25:0] tag_q [0:15];','logic [22:0] tag_q [0:127];').replace('logic [31:0] word_q [0:15];','logic [31:0] word_q [0:127];')\ns=s.replace('  wire [3:0] lookup_index = lookup_addr[5:2];\\\\n','').replace('wire [3:0] train_index = train_addr[5:2];','wire [6:0] train_index = train_addr[8:2];').replace('train_addr[31:6]','train_addr[31:9]')\ns=s.replace('  assign hit = valid_q[lookup_index] && tag_q[lookup_index] == lookup_addr[31:6];','  assign prediction_valid = valid_q[lookup_index];\\\\n  assign prediction_tag = tag_q[lookup_index];')\n(p/'load_predictor.sv').write_text(s)\nf=p/'core_pkg.sv';s=f.read_text();pos='    logic [31:0] effective_addr; // forwarded architectural rs1 + immediate';s=s.replace(pos,pos+'\\\\n    logic [31:0] load_prediction_word;\\\\n    logic [22:0] load_prediction_tag;\\\\n    logic load_prediction_valid;');f.write_text(s)\nf=p/'ex_stage.sv';s=f.read_text();s=s.replace('  output ex_mem_t  out,','''  output ex_mem_t  out,\n  output logic [6:0] load_prediction_index,\n  input logic [31:0] load_prediction_word,\n  input logic [22:0] load_prediction_tag,\n  input logic load_prediction_valid,''');s=s.replace('  assign effective_addr = rs1 + in.imm;','''  assign effective_addr = rs1 + in.imm;\n  assign load_prediction_index = effective_addr[8:2];''');s=s.replace('      exec_payload.effective_addr = effective_addr;','''      exec_payload.effective_addr = effective_addr;\n      exec_payload.load_prediction_word = load_prediction_word;\n      exec_payload.load_prediction_tag = load_prediction_tag;\n      exec_payload.load_prediction_valid = load_prediction_valid;''');f.write_text(s)\nf=p/'mem_stage.sv';s=Path('/srv/hwebench/tmp/b62664fd/2dba8126/load16rtl/mem_stage.sv').read_text();start=s.index('  load_predictor u_load_predictor (');end=s.index('  always_comb begin\\\\n    predicted_shifted',start);s=s[:start]+'''  assign predicted_word = in.load_prediction_word;\n  assign load_prediction_hit = in.load_prediction_valid && in.load_prediction_tag == in.effective_addr[31:9];\n'''+s[end:];f.write_text(s)\nf=p/'core.sv';s=f.read_text();s=s.replace('  // regfile interface (driven by ID + WB stages)','''  logic [6:0] load_prediction_index;\n  logic [31:0] load_prediction_word;\n  logic [22:0] load_prediction_tag;\n  logic load_prediction_valid;\n  load_predictor u_load_predictor (\n    .clock(clock), .reset(reset), .lookup_index(load_prediction_index),\n    .prediction(load_prediction_word), .prediction_tag(load_prediction_tag),\n    .prediction_valid(load_prediction_valid),\n    .train_en(\"'!hold_mem_wb && !mul_repair && io_dmemReady && (io_dmemREn || |io_dmemWEn)),\n    .train_load(io_dmemREn), .train_addr(io_dmemAddr),\n    .train_data(io_dmemREn ? io_dmemRData : io_dmemWData), .train_wmask(io_dmemWEn)\n  );\n\n  // regfile interface (driven by ID + WB stages)'\"''')\ns=s.replace('    .bypass_w_en     (ex_bypass_w_en),','''    .load_prediction_index(load_prediction_index),\n    .load_prediction_word(load_prediction_word),\n    .load_prediction_tag(load_prediction_tag),\n    .load_prediction_valid(load_prediction_valid),\n    .bypass_w_en     (ex_bypass_w_en),''');f.write_text(s)\nprint('early prediction prototype:',p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
