{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/b62664fd/2dba8126/early128rtl');p=Path('/srv/hwebench/tmp/b62664fd/2dba8126/sync128rtl');p.mkdir(exist_ok=True)\nfor f in base.glob('*.sv'):shutil.copy2(f,p/f.name)\n(p/'load_predictor.sv').write_text('''module load_predictor (\n  input logic clock, reset,\n  input logic [6:0] lookup_index,\n  input logic lookup_enable,\n  output logic prediction_valid,\n  output logic [22:0] prediction_tag,\n  output logic [31:0] prediction,\n  input logic train_en, train_load,\n  input logic [31:0] train_addr, train_data,\n  input logic [3:0] train_wmask\n);\n  logic [127:0] valid_q;\n  logic [22:0] tag_q [0:127];\n  wire [6:0] train_index = train_addr[8:2];\n  wire train_hit = valid_q[train_index] && tag_q[train_index] == train_addr[31:9];\n  wire allocate = train_load || train_wmask == 4'b1111;\n  wire store_enable = train_en && \"'!reset;\n  always_ff @(posedge clock) begin\n    if (reset) valid_q <= '\"'0;\n    else if (train_en && allocate) valid_q[train_index] <= 1'b1;\n  end\n  always_ff @(posedge clock) begin\n    if (store_enable && allocate) tag_q[train_index] <= train_addr[31:9];\n    if (lookup_enable) prediction_tag <= tag_q[lookup_index];\n    if (reset) prediction_valid <= 1'b0;\n    else if (lookup_enable) prediction_valid <= valid_q[lookup_index];\n  end\n  for (genvar lane = 0; lane < 4; lane = lane + 1) begin : g_lane\n    logic [7:0] bytes_q [0:127];\n    always_ff @(posedge clock) begin\n      if (store_enable && (allocate || (train_hit && train_wmask[lane])))\n        bytes_q[train_index] <= train_data[lane*8 +: 8];\n      if (lookup_enable) prediction[lane*8 +: 8] <= bytes_q[lookup_index];\n    end\n  end\nendmodule\n''')\n(p/'core_pkg.sv').write_text(Path('cores/bench/rtl/core_pkg.sv').read_text())\nf=p/'ex_stage.sv';s=f.read_text();s=s.replace('''  input logic [31:0] load_