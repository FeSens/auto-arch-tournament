{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv cores/bench/rtl/hazard_unit.sv'", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Prepare the fetched instruction's next-cycle forwarding in ID:\n//   001 : captured ID/register-file data\n//   010 : next EX/MEM result (current EX writer)\n//   100 : next MEM/WB result (current MEM writer)\n//\n// The near writer wins. Qualified writes include validity and stage traps;\n// x0 never forwards. Selections capture, hold and clear together with ID/EX.\n//\n// Latency:        1 cycle, parallel to the existing ID/EX register.\n// RVFI fields:    feeds architectural rs1_rdata / rs2_rdata through EX.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       reset,\n  input  logic       stall,\n  input  logic       flush,\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic       ex_w_en,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       mem_w_en,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  logic [2:0] rs1_next, rs2_next;\n\n  always_comb begin\n    rs1_next[1] = ex_w_en && id_ex_rd != 5'b0 && id_ex_rd == id_rs1;\n    rs1_next[2] = mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_rs1 && !rs1_next[1];\n    rs1_next[0] = !(rs1_next[1] || rs1_next[2]);\n\n    rs2_next[1] = ex_w_en && id_ex_rd != 5'b0 && id_ex_rd == id_rs2;\n    rs2_next[2] = mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_rs2 && !rs2_next[1];\n    rs2_next[0] = !(rs2_next[1] || rs2_next[2]);\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      fwd_rs1 <= 3'b001;\n      fwd_rs2 <= 3'b001;\n    end else if (!stall) begin\n      fwd_rs1 <= rs1_next;\n      fwd_rs2 <= rs2_next;\n    end\n  end\n\nendmodule\n// rtl/hazard_unit.sv\n//\n// Detects the only data hazard the textbook 5-stage doesn't cover via\n// forwarding: load-use. A LOAD in EX produces its data only after MEM,\n// so an instruction immediately behind that consumes the LOAD's rd\n// must be stalled by exactly one cycle.\n//\n// Outputs:\n//   stall_if            : hold PC until fetch acceptance or EX repair.\n//   stall_id            : retain ID/EX during dmem or divider waits\n…[2392 of 5464 chars elided by tools/bench/transcript.py; sha256:55879503ac3d3905]…\nlush_if = imem_stall;\n    flush_id = 1'b0;\n    // Downstream holds preserve ID/EX, load-use injects a bubble, and\n    // imem backpressure advances older stages with an invalid payload.\n    // Repair has explicit priority over frontend hazards and bus holds.\n    if (dmem_stall || divider_wait) begin\n      stall_if = 1'b1;\n      stall_id = 1'b1;\n    end else if (redirect) begin\n      flush_if = 1'b1;\n      flush_id = 1'b1;\n    end else if (load_use_hazard) begin\n      stall_if = 1'b1;\n      flush_id = 1'b1;\n    end else if (imem_stall) begin\n      stall_if = 1'b1;\n    end\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
