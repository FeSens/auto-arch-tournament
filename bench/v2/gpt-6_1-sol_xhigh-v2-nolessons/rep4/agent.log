{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,185p' fpga/core_bench_si.sv && python3 - <<'PY'\nimport json\nfrom pathlib import Path\nfor r in map(json.loads,Path('cores/bench/experiments/log.jsonl').read_text().splitlines()):\n if r['id']=='hyp-20261005-003-r9s2':print(r['hypothesis']['hypothesis'])\nPY\"", "aggregated_output": "// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[6971 of 10043 chars elided by tools/bench/transcript.py; sha256:f76afb74a7294978]…\nus values on a valid hit, arbitrary signed\nand unsigned words, x0, misalignment, same-index read/write and dmem holds.\nForce stale prediction recovery with dependent ALU/load/store/branch/JALR/\nDIV/REM work, unrelated younger MEM effects, retained operands and older\nmultiply repair. Preserve every architectural assertion; adapt only checks\nthat assume a ready exact MEM bypass on a history miss. Run unchanged\nformal, ready/stalled trace cosims, canonical stalled CoreMark CRC/bracket\nvalidation and median vendor timing. Acceptance requires\n(Fmax_new/85.344)*(4,196,601/cycles_new)>1.046. The expected eight-percent\nfitness gain remains an estimate pending final implementation and evaluation.\n\nAn isolated local 128-entry prototype completed stalled CoreMark with all\nfive canonical CRCs, the validation literal, no out-of-bounds access and\n4,205,263 bracketed cycles, versus 4,196,601 for the champion. This is\npreliminary benchmark validation, not complete trace cosimulation/formal\nor a median Gowin fitness result.\n\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,json,collections\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('/srv/hwebench/tmp/b62664fd/5ff8b96b/ras_profile/coremark.elf');active=False;records=[]\nfor i in range(10000000):\n r=cpu.step();records.append(r)\n if r['mem_wmask'] and r['mem_addr']==0x10000100:start=len(records)\n if r['mem_wmask'] and r['mem_addr']==0x10000104:break\nout={}\nfor n in [64,128,256,512]:\n for delay in [0,2]:\n  data=[0]*n;valid=[False]*n;stats=collections.Counter()\n  for i,r in enumerate(records):\n   if i>=start and r['mem_rmask'] and r['rd']:\n    slot=(r['mem_addr']>>2)&(n-1);candidate=data[slot];hit=valid[slot];shift=((r['mem_rmask']&-r['mem_rmask']).bit_length()-1)*8;op=(r['insn']>>12)&7\n    width=8 if op in (0,4) else 16 if op in (1,5) else 32;v=(candidate>>shift)&((1<<width)-1)\n    if op in (0,1) and v>>(width-1):v|=((1<<32)-1)\"'^((1<<width)-1)\n    used=immediate=False\n    for k in [1,2]:\n     if i+k>=len(records):break\n     rw=records[i+k]['\"'insn']\n     if r['rd'] in (((rw>>15)&31),((rw>>20)&31)):used=True;immediate|=k==1\n     if records[i+k]['rd']==r['rd']:break\n    right=v==r['rd_wdata'];stats['loads']+=1;stats['valid']+=hit;stats['right']+=hit and right\n    if used:stats['used']+=1;stats['used_right']+=hit and right;stats['used_wrong']+=hit and not right;stats['used_cold']+=not hit\n    if immediate:stats['immediate_right']+=hit and right;stats['immediate_wrong']+=hit and not right;stats['immediate_cold']+=not hit\n   if i-delay<0:continue\n   t=records[i-delay]\n   if t['trap']:continue\n   if t['mem_rmask']:\n    slot=(t['mem_addr']>>2)&(n-1);data[slot]=t['mem_rdata'];valid[slot]=True\n   elif t['mem_wmask'] and t['mem_addr']<0x100000:\n    slot=(t['mem_addr']>>2)&(n-1);mask=t['mem_wmask'];value=t['mem_wdata'];rawmask=sum(255<<(8*j) for j in range(4) if mask&(1<<j))\n    if mask==15:data[slot]=value;valid[slot]=True\n    elif valid[slot]:\n     # ISS store data is narrow rather than replicated; normalize its mask lane.\n     lo=(mask&-mask).bit_length()-1;norm=value<<(8*lo);data[slot]=(data[slot]&~rawmask)|(norm&rawmask)\n  out[f'word_history{n}_delay{delay}']=dict(stats)\nprint(json.dumps(out,indent=2));Path('/srv/hwebench/tmp/b62664fd/5ff8b96b/ras_profile/early_history_profile.json').write_text(json.dumps(out,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
