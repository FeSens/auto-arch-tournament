{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_ex_divider.py; sed -n '1,240p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Execute-stage transaction checks with downstream acceptance held off.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIVU, run_cocotb\n\n\nID_FIELDS = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n             (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n             (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, **values):\n    result = 0\n    for name, width in fields:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(fields, value):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = value & ((1 << width) - 1)\n        value >>= width\n    return result\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\n@cocotb.test()\nasync def completion_waits_for_acceptance(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.squash.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Put an older store into EX/MEM, then hold it with dmem backpressure.\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x20, rs2_val=0x55,\n                            ctrl=1 << 6, instr=0x00202023, valid=1)\n    await _tick(dut)\n    older = int(dut.out.value)\n    assert older != 0\n\n    instruction = 0x0220D1B3  # DIVU x3,x1,x2\n    control = (ALU_DIVU << 17) | (1 << 2)  # alu_op, reg_write\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x24, rs1_val=999, rs2_val=999,\n                    \n…[11917 of 14989 chars elided by tools/bench/transcript.py; sha256:8a01306248ed3a31]…\ncept\"]\n            assert not s[\"start\"] and not s[\"wait\"] and not s[\"train\"]\n            assert not int(dut.ex_redirect.value), \"younger redirect beat MEM repair\"\n            assert not s[\"wen\"] and not s[\"ren\"], \"younger memory request escaped\"\n        previous_mul_repair = bool(s[\"mul_repair\"])\n        if observe:\n            observe(cycle, s, iready, dready)\n        if (s[\"wen\"] or s[\"ren\"]) and dready and memory_events is not None:\n            memory_events.append((cycle, request))\n\n        # Apply only requests actually accepted on this rising edge.\n        if s[\"wen\"] and dready:\n            wdata = s[\"wdata\"]\n            wa = s[\"da\"] & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (s[\"wen\"] >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        dut.clock.value = 1\n        await Timer(2, \"ns\")\n        # Capture RVFI retirement.\n", "exit_code": 0, "status": "completed"}}
