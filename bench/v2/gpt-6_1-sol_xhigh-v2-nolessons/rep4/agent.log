{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_divider.py && cat cores/bench/test/test_mem_repair.py'", "aggregated_output": "\"\"\"Execute-stage transaction checks with downstream acceptance held off.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport os\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIVU, run_cocotb\n\nALTOPS = os.environ.get(\"EX_DIV_ALTOPS\") == \"1\"\n\n\ndef _divu(a, b):\n    return ((a - b) ^ 0x10E8FD70) & 0xFFFFFFFF if ALTOPS else a // b\n\n\nID_FIELDS = [(\"alu_a_val\", 32), (\"alu_b_val\", 32),\n             (\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n             (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"effective_addr\", 32), (\"write_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n             (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n             (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, **values):\n    result = 0\n    for name, width in fields:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(fields, value):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = value & ((1 << width) - 1)\n        value >>= width\n    return result\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n\n\n@cocotb.test()\nasync def completion_waits_for_acceptance(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.squash.value = 0\n    dut[\"in\"].value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Put an older store into EX/MEM, then hold it with dmem backpressure.\n    dut[\"in\"].value = _pack(ID_FIELDS, pc=0x20, rs2_val=0x55,\n                            ctrl=1 << 6, instr=0x00202023, valid=1)\n    await _tick(dut)\n    older = int(dut.out.value)\n    assert older != 0\n\n    instruction = 0x0220D1B3  # DIVU x3,x1,x2\n    control = (ALU_DIVU << 17) | (1 << 2)  # alu_op, \n…[15598 of 18670 chars elided by tools/bench/transcript.py; sha256:7d8fba5520bc3123]…\nd wb[\"alu_result\"] == alu\n                assert bool(wb[\"ctrl\"] & 1) == misaligned\n                assert bool(wb[\"ctrl\"] & 4) == (read and not misaligned)\n                assert wb[\"mem_addr\"] == (0 if misaligned else addr & ~3)\n                assert wb[\"mem_rmask\"] == (mask if read and not misaligned else 0)\n                assert wb[\"mem_wmask\"] == (mask if not read and not misaligned else 0)\n                assert wb[\"mem_rdata\"] == word and wb[\"mem_wdata\"] == replicated\n                if read and not misaligned:\n                    value = (word >> (8 * offset)) & ((1 << (8 * size)) - 1)\n                    if sext and value & (1 << (8 * size - 1)):\n                        value |= 0xFFFFFFFF ^ ((1 << (8 * size)) - 1)\n                    assert wb[\"read_data\"] == value\n                    assert int(dut.bypass_value.value) == value\n\n\ndef test_mem_repair_runner():\n    run_cocotb(toplevel=\"mem_stage\", sources=[\"core_pkg.sv\", \"mul_exact.sv\", \"mem_stage.sv\"],\n               test_module=\"test_mem_repair\")\n", "exit_code": 0, "status": "completed"}}
