{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_fetch_predictor.py'", "aggregated_output": "\"\"\"Instruction qualification, deterministic table reset, and read/write edges.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\ndef _payload(dut):\n    value = int(dut.out.value)\n    return value >> 34, (value >> 2) & 0xFFFFFFFF, (value >> 1) & 1, value & 1\n\n\nasync def _pc(dut, value):\n    dut.redirect.value = 1\n    dut.redirect_target.value = value\n    await _tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def reset_all_entries_and_same_edge_training(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.accept.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.branch_train_en.value = 0\n    dut.branch_train_index.value = 0\n    dut.branch_train_taken.value = 0\n    dut.imem_data.value = BEQ(0, 0, 8)\n    await _tick(dut)\n    dut.reset.value = 0\n\n    # Every entry starts weakly taken; one decrement crosses its threshold.\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut) == (index * 4, BEQ(0, 0, 8), 1, 1)\n        dut.branch_train_en.value = 1\n        dut.branch_train_index.value = index\n        dut.branch_train_taken.value = 0\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == 1, \"write changed prediction before the edge\"\n        await _tick(dut)\n        dut.branch_train_en.value = 0\n        assert _payload(dut)[2] == 0 and int(dut.imem_addr.value) == index * 4\n\n    # A reset restores all entries, including those whose MSB was cleared.\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    for index in range(64):\n        await _pc(dut, index * 4)\n        assert _payload(dut)[2] == 1\n\n    await _pc(dut, 0)\n    dut.branch_train_en.value = 1\n    dut.branch_train_index.value = 0\n    dut.branch_train_taken.value = 0\n    dut.accept.value = 1\n    await Timer(1, \"ns\")\n    accepted = _payload(dut)\n    assert accepted == (0, BEQ(0, 0, 8), 1, 1)\n    await _tick(dut)\n    assert int(dut.imem_addr.value) == 8, \"same-edge write altered accepted successor\"\n    dut.accept.value = 0\n    dut.branch_train_en.value = 0\n    await _pc(dut, 256)\n    assert _payload(dut)[2] == 0, \"PC[7:2] aliases did not share direction\"\n    dut.imem_data.value = JAL(1, -256)\n    await Timer(1, \"ns\")\n    assert _payload(dut)[2] == 1, \"JAL incorrectly depended on a not-taken table entry\"\n\n    # Flush invalidates the payload without replacing the raw instruction or\n    # altering predecode. Repair overrides disabled acceptance.\n    dut.flush.value = 1\n    await Timer(1, \"ns\")\n    assert _payload(dut) == (256, JAL(1, -256), 1, 0)\n    await _pc(dut, 0)\n    assert int(dut.imem_addr.value) == 0\n    dut.flush.value = 0\n    for instruction in (NOP(), JALR(1, 0, 8), _b(8, 0, 0, 2, 0x63),\n                        _b(8, 0, 0, 3, 0x63), BEQ(0, 0, 2), JAL(1, 2)):\n        dut.imem_data.value = instruction\n        dut.accept.value = 1\n        await Timer(1, \"ns\")\n        assert _payload(dut)[2] == 0, f\"unqualified direct prediction: {instruction:#x}\"\n        previous = int(dut.imem_addr.value)\n        await _tick(dut)\n        assert int(dut.imem_addr.value) == previous + 4\n    dut.accept.value = 0\n    dut.imem_data.value = JAL(1, 8)\n    for _ in range(5):\n        previous = int(dut.imem_addr.value)\n        await _tick(dut)\n        assert int(dut.imem_addr.value) == previous\n\n\ndef test_fetch_predictor_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n               test_module=\"test_fetch_predictor\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nimport random\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm):\n…[39041 of 42113 chars elided by tools/bench/transcript.py; sha256:80e58852c3e37108]…\n Both sources are bypassed into the first MUL, then predicted products\n    # forward into consecutive multiplications without any recovery or bubble.\n    program = [ADDI(1, 0, -7), ADDI(2, 0, 9), MUL(3, 1, 2),\n               MUL(4, 3, 2), MUL(5, 4, 1), ADD(6, 5, 3), EBREAK()]\n    repairs = []\n    rets, _ = await _run(dut, program,\n                         observe=lambda c, s, ir, dr: repairs.append(c) if s[\"mul_repair\"] else None)\n    _check_arithmetic_trace(rets)\n    assert not repairs\n    assert all(b[\"cycle\"] == a[\"cycle\"] + 1 for a, b in zip(rets, rets[1:]))\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_predictor.sv\", \"mul_exact.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
