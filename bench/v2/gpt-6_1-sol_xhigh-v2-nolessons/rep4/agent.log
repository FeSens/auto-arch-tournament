s)-1;bmask=(1<<bankbits)-1\n   history=[0]*nhist;counters=[2]*(1<<(histbits+bankbits));err=0\n   for pc,taken,backward,measure in branchtrace:\n    hi=(pc>>2)&(nhist-1);idx=(((pc>>2)&bmask)<<histbits)|history[hi]\n    pred=counters[idx]>>1\n    if measure and pred\"'!=taken:err+=1\n    counters[idx]=min(3,counters[idx]+1) if taken else max(0,counters[idx]-1)\n    history[hi]=((history[hi]<<1)|taken)&hmask\n   models.append((f'\"'local_n{nhist}_h{histbits}_bank{bankbits}',err))\nstaticerr=0\nfor pc,taken,backward,measure in branchtrace:\n if measure:\n  sites[pc]['count']+=1;sites[pc]['taken']+=taken\n  if backward\"'!=taken:staticerr+=1\nmodels.append(('\"'btfnt',staticerr))\nprint(json.dumps({'branch_events':len(branchtrace),'base_top_sites':[{ 'pc':hex(pc),'errors':err,**dict(sites[pc])} for pc,err in baseper.most_common(20)],'models':sorted(models,key=lambda x:x[1]),'seconds':time.monotonic()-start},indent=2))\nwith open('/srv/hwebench/tmp/b62664fd/408de1ff/conditional-profile.json','w') as f:json.dump({'branchtrace':branchtrace,'models':models,'baseper':dict(baseper),'sites':dict(sites)},f)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
