{"type": "item.completed", "item": {"id": "item_55", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_reg_file.py'", "aggregated_output": "\"\"\"Enabled raw synchronous banks and their architectural snapshot sidecar.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom _helpers import run_cocotb\nfrom test_ex_divider import _tick\n\n\nasync def _reset(dut):\n    dut.clock.value    = 0\n    dut.reset.value    = 1\n    dut.w_en.value     = 0\n    dut.w_addr.value   = 0\n    dut.w_data.value   = 0\n    dut.rs1_addr.value = 0\n    dut.rs2_addr.value = 0\n    dut.read_en.value  = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _write(dut, addr, data):\n    dut.w_en.value   = 1\n    dut.w_addr.value = addr\n    dut.w_data.value = data\n    await _tick(dut)\n    dut.w_en.value = 0\n\n\nasync def _read(dut, rs1, rs2):\n    dut.rs1_addr.value = rs1\n    dut.rs2_addr.value = rs2\n    dut.read_en.value = 1\n    await _tick(dut)\n    dut.read_en.value = 0\n    return _resolved(dut, 1), _resolved(dut, 2)\n\n\ndef _resolved(dut, source):\n    # Test-side architectural interpretation. The DUT exports only raw words\n    # and flags; OC, rather than RF, implements these terms in its role masks.\n    if not int(dut[f\"rs{source}_nonzero\"].value):\n        return 0\n    if int(dut[f\"rs{source}_collision\"].value):\n        return int(dut.wb_snapshot.value)\n    if int(dut[f\"rs{source}_initialized\"].value):\n        return int(dut[f\"rs{source}_raw\"].value)\n    return 0\n\n\ndef _snapshot(dut):\n    names = [\"rs1_raw\", \"rs2_raw\", \"wb_snapshot\", \"rs1_nonzero\", \"rs2_nonzero\",\n             \"rs1_initialized\", \"rs2_initialized\", \"rs1_collision\", \"rs2_collision\"]\n    return tuple(int(dut[name].value) for name in names)\n\n\n@cocotb.test()\nasync def reset_clears_all(dut):\n    await _reset(dut)\n    for r in range(32):\n        rs1, rs2 = await _read(dut, r, r)\n        assert rs1 == rs2 == 0, f\"x{r} after reset = 0x{rs1:08x}\"\n        assert not int(dut.rs1_initialized.value) and not int(dut.rs2_initialized.value)\n\n\n@cocotb.test()\nasync def write_and_read(dut):\n    await _reset(dut)\n    await _write(dut, 5, 0xDEADBEEF)\n    rs1, _ = await _read(dut, 5, 0)\n    assert rs1 == 0xDEADBEEF\n\n\n@cocotb.test()\nasync def x0\n…[2335 of 5407 chars elided by tools/bench/transcript.py; sha256:4c0dd12e6585c380]…\ngle_port_collisions(dut):\n    await _reset(dut)\n    for addr in range(1, 32):\n        await _write(dut, addr, (0x1020304 * addr) & 0xFFFFFFFF)\n    for addr in range(32):\n        other = 31 - addr\n        expected = tuple((0x1020304 * a) & 0xFFFFFFFF for a in (addr, other))\n        assert await _read(dut, addr, other) == expected\n        assert await _read(dut, other, addr) == expected[::-1]\n    for source in (1, 2):\n        dut.w_en.value = 1\n        dut.w_addr.value = 5\n        dut.w_data.value = 0x12340000 + source\n        addresses = (5, 6) if source == 1 else (6, 5)\n        values = await _read(dut, *addresses)\n        assert values[source - 1] == 0x12340000 + source\n        assert values[2 - source] == 0x1020304 * 6\n        assert int(dut[f\"rs{source}_collision\"].value)\n        assert not int(dut[f\"rs{3-source}_collision\"].value)\n        dut.w_en.value = 0\n\n\ndef test_reg_file_runner():\n    run_cocotb(toplevel=\"reg_file\",\n               sources=[\"reg_file.sv\"],\n               test_module=\"test_reg_file\")\n", "exit_code": 0, "status": "completed"}}
