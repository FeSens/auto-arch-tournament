{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nroot=Path('/srv/hwebench/tmp/b62664fd/c991e2bf/lane_probe')\ns=Path('cores/bench/rtl/mem_stage.sv').read_text().replace('module mem_stage (','module mem_stage_reference (')\n(root/'mem_stage_reference.sv').write_text(s)\n(root/'equiv.sv').write_text('''\"'`include \"core_pkg.sv\"\nmodule equiv;\n  logic clock=0, reset=1, hold_wb=0, dmem_ready=1;\n  ex_mem_t in;\n  logic [31:0] dmem_rdata=0;\n  logic [31:0] addr0,addr1,data0,data1,bypass0,bypass1,target0,target1;\n  logic [3:0] wen0,wen1;\n  logic ren0,ren1,writer0,writer1,ready0,ready1,repair0,repair1;\n  mem_wb_t wb0,wb1;\n  mem_stage_reference ref_dut(.clock(clock),.reset(reset),.hold_wb(hold_wb),.in(in),.dmem_ready(dmem_ready),\n    .dmem_rdata(dmem_rdata),.dmem_addr(addr0),.dmem_wdata(data0),.dmem_wen(wen0),.dmem_ren(ren0),\n    .out(wb0),.bypass_w_en(writer0),.bypass_ready(ready0),.bypass_value(bypass0),.mul_repair(repair0),.mul_repair_target(target0));\n  mem_stage new_dut(.clock(clock),.reset(reset),.hold_wb(hold_wb),.in(in),.dmem_ready(dmem_ready),\n    .dmem_rdata(dmem_rdata),.dmem_addr(addr1),.dmem_wdata(data1),.dmem_wen(wen1),.dmem_ren(ren1),\n    .out(wb1),.bypass_w_en(writer1),.bypass_ready(ready1),.bypass_value(bypass1),.mul_repair(repair1),.mul_repair_target(target1));\n  task automatic check_outputs;\n    if ({addr0,data0,wen0,ren0,writer0,ready0,bypass0,repair0,target0,wb0} !==\n        {addr1,data1,wen1,ren1,writer1,ready1,bypass1,repair1,target1,wb1})\n      $fatal(1,\"MEM mismatch word=%h width=%d offset=%d sext=%d old=%h new=%h\",dmem_rdata,in.ctrl.mem_width,in.effective_addr[1:0],in.ctrl.mem_sext,bypass0,bypass1);\n  endtask\n  initial begin\n    in='\"'0;\n    #1; clock=1; #1; clock=0; #1; check_outputs(); reset=0;\n    for(int t=0;t<50000;t++) begin\n      in.pc=\"'$urandom; in.alu_result=$urandom; in.effective_addr=$urandom;\n      in.write_data=$urandom; in.rd=$urandom; in.rs1_addr=$urandom; in.rs2_addr=$urandom;\n      in.rs1_val=$urandom; in.rs2_val=$urandom; in.pc_next=$urandom; in.branch_taken=$urandom;\n      in.branch_target=$urandom; in.ctrl=$urandom; in.instr=$urandom; in.valid=$urandom;\n      dmem_rdata=$urandom; dmem_ready=$urandom; hold_wb=$urandom; reset=(t%1000==0);\n      #1; check_outputs(); clock=1; #1; check_outputs(); clock=0; #1;\n    end\n    $display(\"PASS: 50,000 randomized cycle-by-cycle complete MEM equivalence cases\");\n    $finish;\n  end\nendmodule\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
