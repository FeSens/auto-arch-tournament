ividend bit, has a k-bit candidate\\nremainder, and subtracts only divisor[k-1:0] using a k+1-bit difference.\\nAccept that subtraction only when its borrow is clear and every omitted\\nupper divisor bit is zero. Thus the subtractors grow from 1 to 32 bits,\\nrather than carrying full-width arithmetic through every step. Use the\\nsubtraction's borrow to select the new remainder and emit the quotient\\nbit, avoiding a separat\n…[73545 of 76617 chars elided by tools/bench/transcript.py; sha256:b29aad2f0001d35b]…\nf self._in_uart(addr):\n            self.uart_buf.extend(((v >> (i*8)) & 0xFF) for i in range(4))\n            return\n        if not self._in_mem(addr): self.oob_access = True\n        struct.pack_into('<I', self.mem, addr & 0xFFFFFC, v & MASK)\n    def wb(self, addr, v):\n        if self._in_uart(addr):\n            self.uart_buf.append(v & 0xFF); return\n        if not self._in_mem(addr): self.oob_access = True\n        self.mem[addr & (MEM_BYTES - 1)] = v & 0xFF\n    def whw(self, addr, v):\n        if self._in_uart(addr):\n            self.uart_buf.extend(((v >> (i*8)) & 0xFF) for i in range(2)); return\n        if not self._in_mem(addr): self.oob_access = True\n        struct.pack_into('<H', self.mem, addr & (MEM_BYTES - 2), v & 0xFFFF)\n    def sx(self, v, bits): return v - (1 << bits) if v >> (bits-1) else v\n\n    @staticmethod\n    def trunc_div(a, b):\n        \"\"\"RISC-V signed division: truncate toward zero (C semantics), not Python floor.\"\"\"\n        q = abs(a) // abs(b)\n        return -q if (a < 0) ^ (b < 0) else q\n", "exit_code": 0, "status": "completed"}}
