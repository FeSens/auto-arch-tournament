u/u_mem/reg_q.read_data_3_s0\",\n      \"to\": \"dmem_1_dmem_1_0_0_s\",\n      \"slack_ns\": -10.468,\n      \"arrival_ns\": 20.763,\n      \"logic_cells\": 10,\n      \"modules\": [\n        \"clock_ibuf\",\n        \"cpu/u_ex\",\n        \"cpu/u_ex/u_mul_predictor\",\n        \"cpu/u_ex\"\n      ]\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
