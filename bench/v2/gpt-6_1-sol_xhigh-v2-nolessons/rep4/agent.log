{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/b62664fd/c991e2bf/lane_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(src,rtl/src.name)\np=rtl/'mem_stage.sv'\ns=p.read_text()\nstart=s.index('  // shifted[31:16]')\nend=s.index('  logic [31:0] load_data;',start)\ns=s[:start]+s[end:]\nstart=s.index('    // Load extraction:')\nend=s.index('    // RVFI ALIGNED_MEM',start)\ns=s[:start]+s[end:]\nold='  assign bypass_value = in.ctrl.mem_read ? load_data : in.alu_result;'\nassert old in s\ns=s.replace(old,'')\nblock='''  logic [3:0] byte_sel, half_sel, byte_ret, half_ret;\n  logic word_sel, word_ret, nonload_ret;\n  logic byte_sign, half_sign, byte_sign_ret, half_sign_ret;\n  assign word_sel = in.ctrl.mem_width[1];\n  assign word_ret = in.ctrl.mem_read && word_sel;\n  assign nonload_ret = \"'!in.ctrl.mem_read;\n  for (genvar k = 0; k < 4; k++) begin : g_lane\n    assign byte_sel[k] = in.ctrl.mem_width == 2'\"'d0 && in.effective_addr[1:0] == k;\n    assign half_sel[k] = in.ctrl.mem_width == 2'd1 && in.effective_addr[1:0] == k;\n    assign byte_ret[k] = in.ctrl.mem_read && byte_sel[k];\n    assign half_ret[k] = in.ctrl.mem_read && half_sel[k];\n  end\n  assign byte_sign = (byte_sel[0] && in.ctrl.mem_sext && dmem_rdata[7]) |\n                     (byte_sel[1] && in.ctrl.mem_sext && dmem_rdata[15]) |\n                     (byte_sel[2] && in.ctrl.mem_sext && dmem_rdata[23]) |\n                     (byte_sel[3] && in.ctrl.mem_sext && dmem_rdata[31]);\n  assign half_sign = (half_sel[0] && in.ctrl.mem_sext && dmem_rdata[15]) |\n                     (half_sel[1] && in.ctrl.mem_sext && dmem_rdata[23]) |\n                     (half_sel[2] && in.ctrl.mem_sext && dmem_rdata[31]);\n  assign byte_sign_ret = (byte_ret[0] && in.ctrl.mem_sext && dmem_rdata[7]) |\n                         (byte_ret[1] && in.ctrl.mem_sext && dmem_rdata[15]) |\n                         (byte_ret[2] && in.ctrl.mem_sext && dmem_rdata[23]) |\n                         (byte_ret[3] && in.ctrl.mem_sext && dmem_rdata[31]);\n  assign half_sign_ret = (half_ret[0] && in.ctrl.mem_sext && dmem_rdata[15]) |\n                         (half_ret[1] && in.ctrl.mem_sext && dmem_rdata[23]) |\n                         (half_ret[2] && in.ctrl.mem_sext && dmem_rdata[31]);\n'''\nfor bit in range(32):\n for dest,bs,hs,ws,signsuffix in [('load_data','byte_sel','half_sel','word_sel',''),('bypass_value','byte_ret','half_ret','word_ret','_ret')]:\n  terms=[f'({ws} & dmem_rdata[{bit}])']\n  if bit<8:\n   for lane in range(4): terms.append(f'(({bs}[{lane}] | {hs}[{lane}]) & dmem_rdata[{lane*8+bit}])')\n  else:\n   terms.append('byte_sign'+signsuffix)\n   if bit<16:\n    for lane in range(4):\n     idx=lane*8+bit\n     if idx<32: terms.append(f'({hs}[{lane}] & dmem_rdata[{idx}])')\n   else: terms.append('half_sign'+signsuffix)\n  if dest=='bypass_value': terms.append(f'(nonload_ret & in.alu_result[{bit}])')\n  # Parenthesized balanced binary OR tree.\n  while len(terms)>1:\n   terms=[f'({terms[i]} | {terms[i+1]})' if i+1<len(terms) else terms[i] for i in range(0,len(terms),2)]\n  block+=f'  assign {dest}[{bit}] = {terms[0]};\\\\n'\ns=s.replace('  // ── MEM/WB register',block+'\\\\n  // ── MEM/WB register')\np.write_text(s)\nscript=root/'run.py'\nscript.write_text('''import json,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()))\nfrom tools.eval import gowin\nroot=Path(__file__).resolve().parent\nres=gowin.build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'result.json').write_text(json.dumps(res,indent=2))\nprint(json.dumps(gowin.summarize(res)),flush=True)\nfor r in res: print(json.dumps(r),flush=True)\n''')\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
