{"type":"item.completed","item":{"id":"item_38","type":"agent_message","text":"The narrow-load prototype passed stalled CoreMark, but its Gowin placement measured 79.721 MHz, below the champion. I’m refining the same load-value prediction angle to use an address-tagged word history. The reference profile gives 128 entries a 94.4% hit rate; misses would wait for exact WB data, removing the raw memory-to-OC bypass entirely.\n"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/b62664fd/bbb89c33/load-history-probe');rtl=base/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copyfile(p,rtl/p.name)\np=rtl/'mem_stage.sv';s=p.read_text()\ns=s.replace('  logic [31:0] load_data;','''  logic [31:0] load_data;\n  logic [31:0] history_data [0:127];\n  logic [22:0] history_tag [0:127];\n  logic history_valid [0:127];\n  logic [6:0] history_index;\n  logic history_hit;\n  logic [31:0] predicted_word, predicted_shifted, predicted_load_data;\n  assign history_index = in.effective_addr[8:2];\n  assign history_hit = history_valid[history_index] && history_tag[history_index] == in.effective_addr[31:9];\n  assign predicted_word = history_data[history_index];\n  assign predicted_shifted = predicted_word >> (in.effective_addr[1:0] * 8);\n  always_comb begin\n    case (in.ctrl.mem_width)\n      2'd0: predicted_load_data = in.ctrl.mem_sext ? {{24{predicted_shifted[7]}},predicted_shifted[7:0]} : {24'b0,predicted_shifted[7:0]};\n      2'd1: predicted_load_data = in.ctrl.mem_sext ? {{16{predicted_shifted[15]}},predicted_shifted[15:0]} : {16'b0,predicted_shifted[15:0]};\n      default: predicted_load_data = predicted_word;\n    endcase\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i=0;i<128;i++) history_valid[i] <= 1'b0;\n    end else if (\"'!mul_repair && !hold_wb && in.valid && !ctrl_with_trap.is_illegal && dmem_ready) begin\n      if (dmem_ren) begin\n        history_valid[history_index] <= 1'\"'b1;\n        history_tag[history_index] <= in.effective_addr[31:9];\n        history_data[history_index] <= dmem_rdata;\n      end else if (|dmem_wen) begin\n        if (dmem_wen == 4'b1111) begin\n          history_valid[history_index] <= 1'b1;\n          history_tag[history_index] <= in.effective_addr[31:9];\n          history_data[history_index] <= dmem_wdata;\n        end else if (history_hit) begin\n          for (int lane=0;lane<4;lane++)\n            if (dmem_wen[lane]) history_data[history_index][lane*8 +: 8] <= dmem_wdata[lane*8 +: 8];\n        end\n      end\n    end\n  end''')\ns=s.replace('assign bypass_ready = bypass_w_en && (\"'!in.ctrl.mem_read || (dmem_ready && dmem_ren));'\"','assign bypass_ready = bypass_w_en && (\"'!in.ctrl.mem_read || (dmem_ready && dmem_ren && history_hit));'\"')\ns=s.replace('assign bypass_value = in.ctrl.mem_read ? load_data : in.alu_result;','assign bypass_value = in.ctrl.mem_read ? predicted_load_data : in.alu_result;')\nneedle=\\\"\\\"\\\"      mul_repair <= in.valid && is_mul && \"'!in.ctrl.is_illegal &&\n                    in.ctrl.reg_write && in.rd != 5'\"'b0 &&\n                    exact_product \"'!= in.alu_result;\"\"\"\nreplace=\"\"\"      mul_repair <= in.valid && !ctrl_with_trap.is_illegal &&\n                    in.ctrl.reg_write && in.rd != 5'\"'b0 &&\n                    ((is_mul && exact_product \"'!= in.alu_result) ||\n                     (in.ctrl.mem_read && dmem_ready && dmem_ren && history_hit &&\n                      predicted_word != dmem_rdata));\"\"\"\nassert needle in s;s=s.replace(needle,replace);p.write_text(s)\nprint('\"'Created isolated address-tagged load history prototype')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
