{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"sed -n '1230,1295p' cores/bench/test/test_pipeline.py\"","aggregated_output":"    assert [(addr, mask, data) for _, addr, mask, data in effects] == [\n        (0, 15, 100), (4, 15, 4900)]\n\n\ndef _assert_architectural_sources(rets):\n    \"\"\"Check both captured raw source values against retirement history.\"\"\"\n    registers = [0] * 32\n    for r in rets:\n        assert r[\"rs1_rdata\"] == registers[r[\"rs1_addr\"]], r\n        assert r[\"rs2_rdata\"] == registers[r[\"rs2_addr\"]], r\n        if r[\"rd\"]:\n            assert not r[\"trap\"], r\n            registers[r[\"rd\"]] = r[\"rd_wdata\"]\n\n\n@cocotb.test()\nasync def captured_sources_at_ex_mem_wb_distances(dut):\n    # Both ports at every bypass distance, simultaneous different EX/MEM\n    # writers, and two writers to one destination with the younger winning.\n    program = []\n    expected = {}\n    for gap in range(3):\n        value = 17 + gap\n        program += [ADDI(1, 0, value), *([NOP()] * gap), ADD(2 + gap, 1, 1)]\n        expected[len(program) * 4 - 4] = value * 2\n    program += [ADDI(5, 0, 11), ADDI(5, 0, 29), ADD(6, 5, 5),\n                ADDI(7, 0, 37), ADDI(8, 0, 41), ADD(9, 7, 8),\n                ADDI(10, 0, 43), ADDI(11, 0, 47), ADD(12, 11, 10),\n                ADDI(13, 0, 0x123), LW(13, 0, 0), ADD(14, 13, 13),\n                ADDI(0, 0, 99), ADD(15, 0, 0)]\n    expected.update({(len(program) - 12) * 4: 58,\n                     (len(program) - 9) * 4: 78,\n                     (len(program) - 6) * 4: 90,\n                     (len(program) - 3) * 4: 0xFFFFFF00,\n                     (len(program) - 1) * 4: 0})\n    # AUIPC and immediate inputs must be selected before EX, while RVFI\n    # still reports the independently captured architectural operands.\n    auipc_pc = len(program) * 4\n    program += [0x00012797, ADDI(16, 15, 9), 0x123458B7,\n                ADD(18, 17, 16), EBRE