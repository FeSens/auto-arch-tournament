{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nroot=Path('cores/bench/generated/carry_probe')\ns=Path('cores/bench/test/test_mul_unit.py').read_text()\ns=s.replace('    assert int(dut.busy.value) and not int(dut.result_valid.value)\\\\n\\\\n\\\\nasync def finish', '''    fast = op == ALU_MUL and ((a >> 16) & 0xffff) in (0,0xffff) and ((b >> 16) & 0xffff) in (0,0xffff)\n    assert int(dut.busy.value) == int(not fast)\n    assert int(dut.result_valid.value) == int(fast)\n\n\nasync def finish''',1)\ns=s.replace('    # Poison every live input', '''    fast = op == ALU_MUL and ((a >> 16) & 0xffff) in (0,0xffff) and ((b >> 16) & 0xffff) in (0,0xffff)\n    if fast:\n        assert not int(dut.busy.value) and int(dut.result_valid.value)\n        assert int(dut.result.value) == expected & MASK32\n        for cycle in range(max(1,delay)):\n            dut.start.value=1\n            dut.a.value=0x12345678 \"'^ cycle\n            dut.b.value=0xdeadbeef\n            dut.op.value=ALU_MULHU\n            await tick(dut)\n            assert int(dut.result_valid.value) and not int(dut.busy.value)\n            assert int(dut.result.value) == expected & MASK32\n        dut.start.value=0\n        return\n    # Poison every live input'\"''',1)\n(root/'test_fast_mul_probe.py').write_text(s)\nprint('Scratch test adapts only exact narrow-MUL latency expectations')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
