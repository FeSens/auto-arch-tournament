{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/mul_probe/test/test_pipeline.py')\ns=p.read_text()\ni=s.index('\\\\ndef test_pipeline_runner():')\ns=s[:i]+'''\n@cocotb.test()\nasync def multiplication_dependencies_stalls_and_divider_transitions(dut):\n    def MUL(rd,rs1,rs2,f3=0): return _r(1,rs2,rs1,f3,rd,0b0110011)\n    program=[ADDI(1,0,-2),ADDI(2,0,7),MUL(3,1,2),MUL(4,3,2,1),\n             MUL(5,1,2,2),MUL(6,1,2,3),SW(3,0,0),LW(7,0,0),\n             MUL(8,7,2),DIV(9,8,2),MUL(10,9,2),REM(11,10,2),\n             MUL(0,1,2),MUL(12,0,2),EBREAK()]\n    expected={3:0xfffffff2,4:0xffffffff,5:0xffffffff,6:6,\n              7:0xfffffff2,8:0xffffff9e,9:0xfffffff2,10:0xffffff9e,11:0,12:0}\n    rng=random.Random(71)\n    for stalls in [False,True]:\n        effects=[]\n        buses=lambda c,d: (int(rng.randrange(100)>=22),int(rng.randrange(100)>=22))\n        rets,mem=await _run(dut,program,max_cycles=300,\n                           bus_ready=buses if stalls else None,side_effects=effects)\n        assert [r['pc_r'] for r in rets]==list(range(0,len(program)*4,4))\n        for r in rets:\n            if r['rd'] in expected:\n                assert r['rd_wdata']==expected[r['rd']],r\n        assert len(effects)==1 and mem[0]==0xfffffff2\n        if not stalls:\n            assert max(b['cycle']-a['cycle'] for a,b in zip(rets,rets[1:]))<=10\n\n''' +s[i:]\np.write_text(s)\nPY\npytest -q cores/bench/generated/mul_probe/test/test_mul_unit.py cores/bench/generated/mul_probe/test/test_pipeline.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
