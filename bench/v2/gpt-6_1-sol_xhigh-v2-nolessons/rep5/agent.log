{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_pipeline.py; rg -n 'reg_q|ex_mem|bubble|wait|async def|mem_addr|trap|stall' cores/bench/test/test_pipeline.py; rg --files cores/bench/test test | head -60\"", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: operand capture (EX->ID, MEM->ID, write-first WB), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb,\n)\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1,\n…[14937 of 18009 chars elided by tools/bench/transcript.py; sha256:f22fd77c2588669f]…\nasync def extended_loads_resolve_both_sources_and_registered_divide(dut):\n1125:        for stalled in (False, True):\n1132:                    payload = core.ex_mem_w\n1144:            rets, _ = await _run(\n1145:                dut, program, {0: 0x80FF7F01}, bus_ready=buses if stalled else None,\n1153:            if stalled:\n1158:async def trapping_producers_do_not_replace_captured_values(dut):\n1166:        trap_pcs = {i * 4 for i, instr in enumerate(program)\n1172:            rets, memory = await _run(\n1179:            assert {r[\"pc\"] for r in rets if r[\"trap\"]} == trap_pcs\n1181:                if r[\"trap\"]:\ntest/_helpers.py\ntest/conftest.py\ntest/cosim/reference.py\ntest/cosim/main.cpp\ntest/cosim/build.sh\ntest/cosim/run_cosim.py\ncores/bench/test/test_mul_unit.py\ncores/bench/test/test_alu.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/conftest.py\ncores/bench/test/test_div_unit.py\ncores/bench/test/test_imm_gen.py\n", "exit_code": 0, "status": "completed"}}
