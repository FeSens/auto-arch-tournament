{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json\nfrom tools.eval.gowin import build\nwt=Path.cwd()\nroot=wt/'cores/bench/generated/carry_probe'\njobs={'baseline':wt/'cores/bench/rtl','candidate':root/'rtl'}\nwith ThreadPoolExecutor(max_workers=2) as ex:\n    futures={ex.submit(build,wt,rtl,'fpga/core_bench_si.sv',1,root/name):name for name,rtl in jobs.items()}\n    for f in as_completed(futures):\n        name=futures[f]\n        res=f.result()\n        (root/(name+'.json')).write_text(json.dumps(res,indent=2))\n        print(name,json.dumps(res),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
