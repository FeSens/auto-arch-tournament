ut.predicted_taken.value) == 1\n    await edge(0x100, 1)\n    assert int(dut.predicted_taken.value) == 0  # 4 and 0x100 collide\n    for _ in range(12):\n        await edge(4, 1)  # a queued event cannot train again during holds\n    await edge(4, 1, (1, 1))\n    await edge(4, 1)\n    assert int(dut.predicted_taken.value) == 1\n\n    # Back-to-ba\n…[11760 of 14832 chars elided by tools/bench/transcript.py; sha256:3f813610b9654839]…\n────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=1000,\n               bus_ready=None, side_effects=None, fetch_data=None, observe=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    predecode_observer = _observe_predecode()\n\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n", "exit_code": 0, "status": "completed"}}
