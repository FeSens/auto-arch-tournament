 env) for p in options]\n        return [f.result() for f in futs]\n\n\ndef summarize(results: list[dict]) -> dict:\n    \"\"\"Median Fmax over placement options; every option must fit (the flow\n    is deterministic, so a failure is a property of the design).\"\"\"\n    failed = [r for r in results if r[\"placement_failed\"]]\n    if failed:\n    \n…[1180 of 4252 chars elided by tools/bench/transcript.py; sha256:1a3e090c779fdb14]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
