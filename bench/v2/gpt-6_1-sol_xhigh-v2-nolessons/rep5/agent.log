xt('''module arithmetic_lane (\n input logic [35:0] s0,s1,\n input logic [3:0] p,\n input logic subtract, equal_in, sign_diff, sign_a,\n output logic [31:0] result,\n output logic equal, less_unsigned, less_signed\n);\n logic [3:0] g,c;\n logic cout;\n assign c[0]=subtract;\n for(genvar k=0;k<4;k=k+1) begin: slices\n   assign g[k]=s0[9*k+8];\n   assign result[8*k+:8]=c[k] ? s1[9*k+:8] : s0[9*k+:8];\n end\n assign c[1]=g[0]|(p[0]&c[0]);\n assign c[2]=g[1]|(p[1]&g[0])|(p[1]&p[0]&c[0]);\n assign c[3]=g[2]|(p[2]&g[1])|(p[2]&p[1]&g[0])|(p[2]&p[1]&p[0]&c[0]);\n assign cout=g[3]|(p[3]&g[2])|(p[3]&p[2]&g[1])|(p[3]&p[2]&p[1]&g[0])|(p[3]&p[2]&p[1]&p[0]&c[0]);\n assign equal=equal_in;\n assign less_unsigned=\"'!cout;\n assign less_signed=sign_diff ? sign_a : less_unsigned;\nendmodule\n'\"''')\nf=p/'rtl/alu.sv';s=f.read_text().replace('  input logic subtract,','  input logic [35:0] s0,s1,\\\\n  input logic [3:0] p,\\\\n  input logic equal_in, sign_diff, sign_a,\\\\n  input logic subtract,');s=s.replace('arithmetic_lane u_arithmetic (.a(a),.b(b),.subtract(subtract)', 'arithmetic_lane u_arithmetic (.s0(s0),.s1(s1),.p(p),.equal_in(equal_in),.sign_diff(sign_diff),.sign_a(sign_a),.subtract(subtract)');f.write_text(s)\nf=p/'rtl/ex_stage.sv';s=f.read_text().replace('    .subtract(in.arithmetic_subtract),','    .s0(in.arithmetic_s0), .s1(in.arithmetic_s1), .p(in.arithmetic_p),\\\\n    .equal_in(in.arithmetic_equal), .sign_diff(in.arithmetic_sign_diff), .sign_a(in.arithmetic_sign_a),\\\\n    .subtract(in.arithmetic_subtract),');f.write_text(s)\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
