nd-test chain precedes selection.\n  function automatic [63:0] radix4_step(\n    input logic [31:0] quotient, remainder,\n    input logic [33:0] divisor1, divisor2, divisor3\n  );\n    logic [33:0] trial;\n    // Upper residual bits are discarded: R < D for nonzero D, and for\n    // D=0 the remainder contains at most the 32 divid\n…[8156 of 11228 chars elided by tools/bench/transcript.py; sha256:a3ff04159fbaedce]…\n:\n            await check(dut, op, a, b, reference(op, a, b))\n\n\n@cocotb.test()\nasync def accept_and_start_on_same_edge(dut):\n    await setup(dut)\n    await launch(dut, ALU_DIVU, 100, 7)\n    await finish(dut, ALU_DIVU, 100, 7, 14, delay=5)\n    dut.result_accept.value = 1\n    await launch(dut, ALU_REM, 0xFFFFFFF6, 3)\n    dut.result_accept.value = 0\n    await finish(dut, ALU_REM, 0xFFFFFFF6, 3, MASK32)\n    dut.result_accept.value = 1\n    await tick(dut)\n    dut.result_accept.value = 0\n    for _ in range(10):\n        await tick(dut)\n        assert not int(dut.busy.value) and not int(dut.result_valid.value)\n\n\n@cocotb.test()\nasync def reset_cancels_work_and_completion(dut):\n    await setup(dut)\n    await launch(dut, ALU_DIV, 0x80000000, 3)\n    for _ in range(4):\n        await tick(dut)\n    await setup(dut)\n    for _ in range(10):\n        await tick(dut)\n        assert not int(dut.result_valid.value) and not int(dut.busy.value)\n    await launch(dut, ALU_REMU, MASK32, 7)\n    await finish(dut, ALU_REMU, MASK32, 7, 3)\n", "exit_code": 0, "status": "completed"}}
