{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/89cd5fec/b591b16b/r12-research')\nfor name,width in [('alu_csel8',8),('alu_csel4',4)]:\n dst=root/name/'rtl';shutil.copytree(root/'baseline/rtl',dst,dirs_exist_ok=True)\n p=dst/'alu.sv';s=p.read_text()\n fn=f'''  function automatic [31:0] block_add(input logic [31:0] x, y, input logic cin);\n    logic [{32//width-1}:0] g, p;\n    logic [{32//width}:0] c;\n    logic [{width}:0] partial [{32//width-1}:0];\n    logic [31:0] sum;\n    begin\n      c[0] = cin;\n      for (int j = 0; j < {32//width}; j++) begin\n        partial[j] = {{1'b0,x[j*{width} +: {width}]}} + {{1'b0,y[j*{width} +: {width}]}};\n        g[j] = partial[j][{width}];\n        p[j] = &(x[j*{width} +: {width}] \"'^ y[j*{width} +: {width}]);\n      end\n'\"'''\n for j in range(1,32//width+1):\n  terms=[]\n  for k in range(j):\n   terms.append('('+' & '.join([f'p[{m}]' for m in range(j-1,k,-1)]+[f'g[{k}]'])+')')\n  terms.append('('+' & '.join([f'p[{m}]' for m in range(j-1,-1,-1)]+['cin'])+')')\n  fn+='      c['+str(j)+'] = '+' | '.join(terms)+';\\\\n'\n fn+=f'''      for (int j = 0; j < {32//width}; j++)\n        sum[j*{width} +: {width}] = x[j*{width} +: {width}] + y[j*{width} +: {width}] + c[j];\n      block_add = sum;\n    end\n  endfunction\n\n'''\n s=s.replace('  logic        [4:0]  shamt;',fn+'  logic        [4:0]  shamt;')\n s=s.replace('out = a + b;',\\\"out = block_add(a, b, 1'b0);\\\")\n s=s.replace('out = a - b;',\\\"out = block_add(a, ~b, 1'b1);\\\")\n p.write_text(s)\nprint('Generated exact ALU segmented carry prototypes')\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nfrom tools.eval.gowin import build\nwt=Path.cwd();root=Path('/srv/hwebench/tmp/89cd5fec/b591b16b/r12-research')\nwith ThreadPoolExecutor(max_workers=2) as ex:\n fs={n:ex.submit(b