{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"git diff --check && sed -n '190,235p' cores/bench/rtl/ex_stage.sv && rg -n 'DONE \\\\(FAIL|DONE \\\\(ERROR|Status: failed' formal/last_run-wV5Q8pBX2.log\"","aggregated_output":"  // occupancy alone select data and destination; launch and stall\n  // must not enter this path, which feeds younger decode operands.\n  // Loads expose no EX candidate because their ALU output is an address.\n  logic normal_result, mul_result_select, div_result_select;\n  assign mul_result_select = mul_valid;\n  assign div_result_select = !mul_valid && div_valid;\n  assign normal_result = !mul_valid && !div_valid;\n\n  always_comb begin\n    forward_rd = in.rd;\n    // Resolve the registered completion selects in parallel with result\n    // data. One-hot masking avoids cascading arithmetic completion muxes\n    // after the fast ALU on its path to the next operand capture.\n    forward_data = (alu_result & {32{normal_result && !in.ctrl.is_jump}})\n                 | (in.fallthrough_pc & {32{normal_result && in.ctrl.is_jump}})\n                 | (mul_result & {32{mul_result_select}})\n                 | (div_result & {32{div_result_select}});\n    // Conditional branches never have fast_write set. Only a jump can\n    // both write in EX and fault here; exclude the direction comparator\n    // from forwarding eligibility as well as from payload capture enable.\n    forward_wen = in.valid && in.fast_write && !misalign_jump;\n    if (mul_valid) begin\n      forward_rd = mul_meta_q.rd;\n      forward_wen = mul_meta_q.valid && mul_meta_q.ctrl.reg_write;\n    end else if (div_valid) begin\n      forward_rd = div_meta_q.rd;\n      forward_wen = div_meta_q.valid && div_meta_q.ctrl.reg_write;\n    end\n  end\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (stall) begin\n      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n      // stays in MEM stage waiting on the bus.\n      reg_q <= reg_q;\n    end else if (mul_accept) begin\n      reg_q <= mul_meta_q;\n      reg_q.alu_result <= mul_result;\n    end else if (div_accept) begin\n      reg_q <= div_meta_q;\n      reg_q.alu_result <= div_result;\n","exit_code":1,"status":"failed"}}
