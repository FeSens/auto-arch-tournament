{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK = (1 << 32) - 1\n\ndef radix4(a, d):\n    q = r = 0\n    for shift in range(30, -1, -2):\n        t = (r << 2) | ((a >> shift) & 3)\n        assert 0 <= t < (1 << 34)\n        trials = [t - k*d for k in (1, 2, 3)]\n        digit = max([0] + [k for k, delta in enumerate(trials, 1) if delta >= 0])\n        q = (q << 2) | digit\n        r = t - digit*d\n        if d:\n            assert 0 <= r < d\n    return q, r\n\nrng = random.Random(0x20261004)\npairs = [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\nfor d in (1, 2, 3, 7, 0x40000000, 0x7fffffff, 0x80000000, 0xfffffffe, MASK):\n    for k in (0, 1, 2, 3, 4):\n        for delta in (-1, 0, 1):\n            a = k*d + delta\n            if 0 <= a <= MASK:\n                pairs.append((a, d))\nfor a, d in pairs:\n    assert radix4(a, d) == divmod(a, d)\nfor a in (0, 1, 0x80000000, MASK):\n    assert radix4(a, 0) == (MASK, a)\nprint(f'Radix-4 integer model passed {len(pairs)} nonzero-divisor vectors and zero-divisor cases; RTL timing remains unmeasured.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
