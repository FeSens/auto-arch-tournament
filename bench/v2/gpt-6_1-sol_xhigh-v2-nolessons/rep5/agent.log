{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_div_unit.py'", "aggregated_output": "\"\"\"Real sequential RV32M arithmetic and divider handshake checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef magnitudes(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if op in (ALU_DIV, ALU_REM):\n        a = (-a) & MASK32 if a & 0x80000000 else a\n        b = (-b) & MASK32 if b & 0x80000000 else b\n    return a, b\n\n\ndef captured_signs(dut):\n    return tuple(int(getattr(dut, name).value) for name in (\n        \"quotient_negative_q\", \"remainder_negative_q\",\n        \"divisor_negative_q\", \"select_remainder_q\"))\n\n\ndef reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if b == 0:\n        return MASK32 if op in (ALU_DIV, ALU_DIVU) else a\n    if op in (ALU_DIV, ALU_REM):\n        a = a if a < 0x80000000 else a - (1 << 32)\n        b = b if b < 0x80000000 else b - (1 << 32)\n        quotient = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            quotient = -quotient\n    else:\n        quotient = a // b\n    return (quotient if op in (ALU_DIV, ALU_DIVU) else a - quotient * b) & MASK32\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n    assert int(dut.result.value) == 0\n    assert int(dut.divisor_3x_q.value) == 0\n    assert int(dut.result_magnitude_q.value) == 0\n    assert captured_signs(dut) == (0, 0, 0, 0)\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n    # Launch captures raw RV32 operands; normali\n…[9898 of 12970 chars elided by tools/bench/transcript.py; sha256:888334f516d114ff]…\nhe edge accepting the previous result.\n        dut.result_accept.value = int(index != 0)\n        await launch(dut, op, a, b)\n        dut.result_accept.value = 0\n        await finish(dut, op, a, b, reference(op, a, b), delay=8)\n    dut.result_accept.value = 1\n    await tick(dut)\n    dut.result_accept.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n\n\n@cocotb.test()\nasync def reset_cancels_work_and_completion(dut):\n    await setup(dut)\n    await launch(dut, ALU_DIV, 0x80000000, 3)\n    for _ in range(4):\n        await tick(dut)\n    await setup(dut)\n    for _ in range(10):\n        await tick(dut)\n        assert not int(dut.result_valid.value) and not int(dut.busy.value)\n    await launch(dut, ALU_REMU, MASK32, 7)\n    await finish(dut, ALU_REMU, MASK32, 7, 3)\n    await setup(dut)\n    await check(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\", sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"sed -n '1,160p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py; cat cores/bench/test/conftest.py; cat fpga/scripts/synth.tcl\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,160p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py; cat cores/bench/test/conftest.py; cat fpga/scripts/synth.tcl\"", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: operand capture (EX->ID, MEM->ID, write-first WB), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\nd\n…[8022 of 11094 chars elided by tools/bench/transcript.py; sha256:bc5477166259aac1]…\nwhich fpga/core_bench*.sv to read. Defaults to\n# fpga/core_bench.sv (NRET=2 dual-channel). tools/eval/fpga.py overrides\n# to fpga/core_bench_si.sv when cores/<target>/core.yaml declares nret: 1.\n# Both files define a module named core_bench; only one is read per run.\nif {[info exists ::env(BENCH)]} {\n    set bench_sv $::env(BENCH)\n} else {\n    set bench_sv \"fpga/core_bench.sv\"\n}\n# SYNTH_PAD (tools/eval/fpga.py): an unused module the harness adds to\n# perturb the netlist's internal numbering. Synthesis prunes it; placement\n# still changes, so Fmax is scored as a median over several such variants\n# (research/v2/NOTES.md, placement noise).\nif {[info exists ::env(SYNTH_PAD)] && $::env(SYNTH_PAD) ne \"\"} {\n    read_verilog -sv $::env(SYNTH_PAD)\n}\nread_verilog -sv fpga/bench_stall_gen.sv\nread_verilog -sv $bench_sv\n\n# -family gw2a: the part is a GW2A-18C; without it synth_gowin maps for its\n# default gw1n (V1 did). EXP-2026-09-27-v2-synth-flow.\nsynth_gowin -top core_bench -family gw2a -json $gen_dir/synth.json\n\nstat\n", "exit_code": 0, "status": "completed"}}
