ed to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[17438 of 20510 chars elided by tools/bench/transcript.py; sha256:b5ea488b041400b6]…\nrchitectural_sources(rets)\n        assert holds == 15 and coverage[\"pending\"] >= 3\n        assert coverage[\"transfer\"] == coverage[\"unready_pop\"] == 1\n        assert coverage[\"predicted\"] == [20, 28]\n        assert coverage[\"corrections\"] == [36, 48]\n        assert rets[3][\"rd_wdata\"] == result\n        assert rets[4][\"rs1_rdata\"] == result and rets[4][\"rd_wdata\"] == result + 7\n        assert [(addr, mask, data) for _, addr, mask, data in effects] == [\n            (0, 15, 100), (4, 15, result + 7)]\n        assert memory == {0: 100, 4: result + 7}\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"branch_predictor.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
