'\\x7fELF'\n        e_phoff     = struct.unpack_from('<I', data, 28)[0]\n        e_phentsize = struct.unpack_from('<H', data, 42)[0]\n        e_phnum     = struct.unpack_from('<H', data, 44)[0]\n        self.pc     = struct.unpack_from('<I', data, 24)[0]\n        for i in range(e_phnum):\n            off      = e_phoff + i * e_phentsize\n            p_type   = struct.unpack_from('<I', data, off)[0]\n            p_\n…[7311 of 10383 chars elided by tools/bench/transcript.py; sha256:5f9a6de502e6ab1a]…\nd-zero).\"\"\"\n108:    def _retire(self, *, pc, npc, instr, trap=0,\n127:            'order': self.retired, 'pc': pc, 'npc': npc, 'insn': instr,\n139:        instr = self.rw(self.pc)\n140:        op  = instr & 0x7F\n141:        rd  = (instr >> 7)  & 0x1F\n142:        fn3 = (instr >> 12) & 0x7\n143:        rs1 = (instr >> 15) & 0x1F\n144:        rs2 = (instr >> 20) & 0x1F\n145:        fn7 = (instr >> 25) & 0x7F\n147:        imm_i = self.sx((instr >> 20), 12)\n148:        imm_s = self.sx(((instr>>25)<<5)|((instr>>7)&0x1F), 12)\n149:        imm_b = self.sx(((instr>>31)<<12)|(((instr>>7)&1)<<11)|(((instr>>25)&0x3F)<<5)|(((instr>>8)&0xF)<<1), 13)\n150:        imm_u = instr & 0xFFFFF000\n151:        imm_j = self.sx(((instr>>31)<<20)|(((instr>>12)&0xFF)<<12)|(((instr>>20)&1)<<11)|(((instr>>21)&0x3FF)<<1), 21)\n157:        # values the instruction consumed.\n163:            pc=pc, npc=npc, instr=instr,\n190:                    else self.trunc_div(sa, sb) & MASK)\n299:            if instr == 0x00100073:\n309:    cpu.load_elf(sys.argv[1])\n", "exit_code": 0, "status": "completed"}}
