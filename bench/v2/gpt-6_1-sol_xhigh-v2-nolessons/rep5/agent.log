is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_to_reg (dec_mem_to_reg),\n    .is_illegal (dec_is_illegal)\n  );\n\n  logic [31:0] imm;\n  imm_gen u_imm (.instr(in.i\n…[11700 of 14772 chars elided by tools/bench/transcript.py; sha256:bbe430ca7efc6863]…\n 'fpga_report_unparsed: no Logic/Register count in Gowin report',\ntools/eval/fpga.py:379:            'placement_failed': False,\ntools/eval/fpga.py:393:    result = run_fpga_eval(\ntest/cosim/reference.py:2:\"\"\"RV32IM reference interpreter for the cosim. Mirrors the DUT's trap\ntest/cosim/reference.py:3:discipline so cosim traces stay aligned across illegal / misaligned\ntest/_helpers.py:1:\"\"\"Shared cocotb constants and runner helpers for unit tests.\ntest/_helpers.py:11:# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\ntest/_helpers.py:12:from cocotb_tools.runner import get_runner\ntest/_helpers.py:51:def run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\ntest/_helpers.py:52:    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\ntest/cosim/run_cosim.py:47:        # inside fields cosim used to ignore.\ntest/conftest.py:1:\"\"\"pytest configuration for cocotb unit tests.\ntest/conftest.py:4:during pytest collection. Cocotb sets PYTHONPATH separately for the\n", "exit_code": 0, "status": "completed"}}
