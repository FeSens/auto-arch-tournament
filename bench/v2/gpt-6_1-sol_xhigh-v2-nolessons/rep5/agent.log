{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,280p' cores/bench/test/test_div_unit.py; sed -n '1,300p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Real sequential RV32M arithmetic and divider handshake checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if b == 0:\n        return MASK32 if op in (ALU_DIV, ALU_DIVU) else a\n    if op in (ALU_DIV, ALU_REM):\n        a = a if a < 0x80000000 else a - (1 << 32)\n        b = b if b < 0x80000000 else b - (1 << 32)\n        quotient = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            quotient = -quotient\n    else:\n        quotient = a // b\n    return (quotient if op in (ALU_DIV, ALU_DIVU) else a - quotient * b) & MASK32\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n    assert int(dut.result.value) == 0\n    assert int(dut.divisor_3x_q.value) == 0\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n\n\nasync def finish(dut, op, a, b, expected, delay=0):\n    # Changing live inputs, including an attempted start, must not replace\n    # the operands captured at launch or the held completed result.\n    dut.a.value = 0x12345678\n    dut.b.value = 0\n    dut.op.value = ALU_REMU\n    for group in range(8):\n        dut.start.value = int(group == 3)\n        await tick(dut)\n        assert int(dut.result_valid.value) == int(group == 7)\n        assert int(dut.busy.value) == int(group != 7)\n    dut.start.value = 0\n    actual = int(dut.result.value)\n    assert a\n…[17122 of 20194 chars elided by tools/bench/transcript.py; sha256:18a43e394f76be0a]…\nert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n", "exit_code": 0, "status": "completed"}}
