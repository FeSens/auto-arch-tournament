{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef MUL (rd, rs1, rs2)\n…[32403 of 35475 chars elided by tools/bench/transcript.py; sha256:4697db989b034846]…\ngram, bus_ready=buses, observe=observe,\n                             side_effects=effects)\n    _assert_program(rets, program)\n    assert holds == 15 and len(pending) >= 8\n    assert launches == [(100, 7), (700, 7), (700, 7), (4900, 7)]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"]] == [\n        100, 7, 700, 4900, 700, 4900, 4900, 34300]\n    [r] = _by_insn(rets, MUL(3, 1, 2))\n    assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"]) == (100, 7)\n    assert memory == {0: 100, 4: 4900}\n    assert [(addr, mask, data) for _, addr, mask, data in effects] == [\n        (0, 15, 100), (4, 15, 4900)]\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/rtl')\nsave=Path('/srv/hwebench/tmp/89cd5fec/95cb2248/r5s1_original_rtl')\nsave.mkdir(parents=True,exist_ok=True)\nfor p in root.glob('*.sv'): shutil.copy2(p,save/p.name)\np=root/'core_pkg.sv'; s=p.read_text(); mark='  // ID/EX register payload.'; i=s.index(mark); j=s.index('  // EX/MEM register payload.',i)\npart=s[i:j].replace('    logic [31:0] imm;','    logic [31:0] imm;\\\\n    logic [31:0] alu_a;\\\\n    logic [31:0] alu_b;')\np.write_text(s[:i]+part+s[j:])\np=root/'id_stage.sv';s=p.read_text().replace('    decoded.imm      = imm;','    decoded.imm      = imm;\\\\n    decoded.alu_a    = dec_is_auipc ? in.pc : rs1_data;\\\\n    decoded.alu_b    = dec_alu_src ? imm : rs2_data;');p.write_text(s)\np=root/'ex_stage.sv';s=p.read_text();a=s.index('  input  logic [1:0]         fwd_rs1_sel,');b=s.index('  output ex_mem_t  out,',a)\ns=s[:a]+'''  output logic              bypass_wen,\n  output logic [4:0]        bypass_rd,\n  output logic [31:0]       bypass_data,\n'''+s[b:]\na=s.index('  always_comb begin\\\\n    case (fwd_rs1_sel)');b=s.index('  logic [31:0] alu_result;',a)\ns=s[:a]+'''  assign rs1 = in.rs1_val;\n  assign rs2 = in.rs2_val;\n  logic [31:0] alu_a, alu_b;\n  assign alu_a = in.alu_a;\n  assign alu_b = in.alu_b;\n\n'''+s[b:]\na=s.index('  // ── EX/MEM register');s=s[:a]+'''  // Current EX producer is independent of younger decode eligibility.\n  always_comb begin\n    bypass_rd = in.rd;\n    bypass_data = in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n    bypass_wen = in.valid && in.ctrl.reg_write && \"'!in.ctrl.mem_read\n                 && !in.ctrl.is_illegal && !misalign_fault && !is_mul && !is_div;\n    if (mul_valid) begin\n      bypass_rd = mul_meta_q.rd;\n      bypass_data = mul_result;\n      bypass_wen = mul_meta_q.valid && mul_meta_q.ctrl.reg_write;\n    end else if (div_valid) begin\n      bypass_rd = div_meta_q.rd;\n      bypass_data = div_result;\n      bypass_wen = div_meta_q.valid && div_meta_q.ctrl.reg_write;\n    end\n  end\n\n'\"'''+s[a:];p.write_text(s)\np=root/'mem_stage.sv';s=p.read_text().replace('  output logic [31:0] forward_data','  output logic [31:0] forward_data,\\\\n  output logic forward_wen');s=s.replace('  assign forward_data =','  assign forward_wen = in.valid && ctrl_with_trap.reg_write && \"'!ctrl_with_trap.is_illegal;'\"\\\\n  assign forward_data =');p.write_text(s)\np=root/'forward_unit.sv';p.write_text('''module forward_unit (\n  input logic [4:0] rs1_addr, rs2_addr,\n  input logic [31:0] rf_rs1, rf_rs2,\n  input logic ex_wen, mem_wen, wb_wen,\n  input logic [4:0] ex_rd, mem_rd, wb_rd,\n  input logic [31:0] ex_data, mem_data, wb_data,\n  output logic [31:0] rs1_data, rs2_data\n);\n  logic e1,m1,w1,r1,e2,m2,w2,r2;\n  always_comb begin\n    e1 = ex_wen && ex_rd \"'!= 0 && ex_rd == rs1_addr;\n    m1 = !e1 && mem_wen && mem_rd != 0 && mem_rd == rs1_addr;\n    w1 = !e1 && !m1 && wb_wen && wb_rd != 0 && wb_rd == rs1_addr;\n    r1 = !e1 && !m1 && !w1;\n    e2 = ex_wen && ex_rd != 0 && ex_rd == rs2_addr;\n    m2 = !e2 && mem_wen && mem_rd != 0 && mem_rd == rs2_addr;\n    w2 = !e2 && !m2 && wb_wen && wb_rd != 0 && wb_rd == rs2_addr;\n    r2 = !e2 && !m2 && !w2;\n    rs1_data = rs1_addr == 0 ? 32'\"'b0 : (ex_data & {32{e1}}) | (mem_data & {32{m1}})\n                | (wb_data & {32{w1}}) | (rf_rs1 & {32{r1}});\n    rs2_data = rs2_addr == 0 ? 32'b0 : (ex_data & {32{e2}}) | (mem_data & {32{m2}})\n                | (wb_data & {32{w2}}) | (rf_rs2 & {32{r2}});\n  end\nendmodule\n''')\np=root/'core.sv';s=p.read_text().replace('  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','''  logic ex_bypass_wen, mem_bypass_wen;\n  logic [4:0] ex_bypass_rd;\n  logic [31:0] ex_bypass_data;\n  logic [31:0] rf_rs1_data_w, rf_rs2_data_w;''')\na=s.index('  reg_file u_rf');b=s.index('  // ── EX',a);s=s[:a]+s[a:b].replace('(rs1_data_w)','(rf_rs1_data_w)').replace('(rs2_data_w)','(rf_rs2_data_w)')+s[b:]\ns=s.replace('.early_mem_wen   (ex_mem_w.valid && ex_mem_w.ctrl.reg_write)', '.early_mem_wen   (mem_bypass_wen)')\na=s.index('    .fwd_rs1_sel');b=s.index('    .out             (ex_mem_w)',a);s=s[:a]+'''    .bypass_wen      (ex_bypass_wen),\n    .bypass_rd       (ex_bypass_rd),\n    .bypass_data     (ex_bypass_data),\n'''+s[b:]\ns=s.replace('.forward_data (mem_forward_data)', '.forward_data (mem_forward_data),\\\\n    .forward_wen (mem_bypass_wen)')\na=s.index('  forward_unit u_fwd');b=s.index('  // ── RVFI',a);s=s[:a]+'''  forward_unit u_fwd (\n    .rs1_addr(rs1_addr_w), .rs2_addr(rs2_addr_w),\n    .rf_rs1(rf_rs1_data_w), .rf_rs2(rf_rs2_data_w),\n    .ex_wen(ex_bypass_wen), .ex_rd(ex_bypass_rd), .ex_data(ex_bypass_data),\n    .mem_wen(mem_bypass_wen), .mem_rd(ex_mem_w.rd), .mem_data(mem_forward_data),\n    .wb_wen(wb_w_en), .wb_rd(wb_w_addr), .wb_data(wb_w_data),\n    .rs1_data(rs1_data_w), .rs2_data(rs2_data_w)\n  );\n\n'''+s[b:];p.write_text(s)\nprint('Temporary operand-capture prototype prepared; originals saved.')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
