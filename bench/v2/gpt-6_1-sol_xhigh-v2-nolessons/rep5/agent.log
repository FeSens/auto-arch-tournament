{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_div_unit.py\ncat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"Real sequential RV32M arithmetic and divider handshake checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if b == 0:\n        return MASK32 if op in (ALU_DIV, ALU_DIVU) else a\n    if op in (ALU_DIV, ALU_REM):\n        a = a if a < 0x80000000 else a - (1 << 32)\n        b = b if b < 0x80000000 else b - (1 << 32)\n        quotient = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            quotient = -quotient\n    else:\n        quotient = a // b\n    return (quotient if op in (ALU_DIV, ALU_DIVU) else a - quotient * b) & MASK32\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n\n\nasync def finish(dut, op, a, b, expected, delay=0):\n    # Changing live inputs, including an attempted start, must not replace\n    # the operands captured at launch or the held completed result.\n    dut.a.value = 0x12345678\n    dut.b.value = 0\n    dut.op.value = ALU_REMU\n    for group in range(8):\n        dut.start.value = int(group == 3)\n        await tick(dut)\n        assert int(dut.result_valid.value) == int(group == 7)\n        assert int(dut.busy.value) == int(group != 7)\n    dut.start.value = 0\n    actual = int(dut.result.value)\n    assert actual == expected & MASK32, (\n        f\"op={op} a={a & MASK32:#010x} b={b & MASK32\n…[28211 of 31283 chars elided by tools/bench/transcript.py; sha256:e70fb0ba7ee6d2f6]…\n            assert [(a, b) for _, _, a, b in launches] == [\n                (0xFFFFFF9C, 7), (0xFFFFFF9C, 24), (100, 7),\n                (0xFFFFFF9C, 7), (100, 0)]\n            assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"]] == [\n                0xFFFFFF9C, 7, 0xFFFFFFF2, 24, 0xFFFFFFFC,\n                100, 14, 0xFFFFFF9C, 0xFFFFFFF2, 0xFFFFFFF2]\n            assert [(addr, data) for _, addr, _, data in effects] == [(8, 0xFFFFFFF2)]\n            assert memory == {0: 100, 4: 0xFFFFFF9C, 8: 0xFFFFFFF2}\n            if stalled:\n                assert redirects_held == {12, 24, 40} and load_holds == 5\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
