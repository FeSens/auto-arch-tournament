{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/89cd5fec/f5897130/r7s0-probe')\nfor name,src in [('nibble','cores/bench/rtl'),('early_nibble',p/'early/rtl')]:\n shutil.copytree(src,p/name/'rtl',dirs_exist_ok=True)\n shutil.copytree('cores/bench/test',p/name/'test',dirs_exist_ok=True)\n f=p/name/'rtl/div_unit.sv';s=f.read_text()\n s=s.replace('logic [31:0] q1, q2, r1, r2;', '''logic [31:0] q2, r2;\n  logic [35:0] multiples_q[1:15];\n\n  function automatic [35:0] multiple(input logic [31:0] d, input integer k);\n    logic [35:0] x, y, z, csum, ccarry;\n    begin\n      x={4'b0,d}; y=36'b0; z=36'b0;\n      case(k)\n        1: multiple=x;\n        2: multiple=x<<1;\n        3: multiple=x+(x<<1);\n        4: multiple=x<<2;\n        5: multiple=x+(x<<2);\n        6: multiple=(x<<1)+(x<<2);\n        7: multiple=(x<<3)-x;\n        8: multiple=x<<3;\n        9: multiple=x+(x<<3);\n        10: multiple=(x<<1)+(x<<3);\n        11,13: begin\n          y=(k==11) ? x<<1 : x<<2; z=x<<3;\n          csum=x\"'^y''^z;\n          ccarry=((x&y)|(x&z)|(y&z))<<1;\n          multiple=csum+ccarry;\n        end\n        12: multiple=(x<<2)+(x<<3);\n        14: multiple=(x<<4)-(x<<1);\n        15: multiple=(x<<4)-x;\n        default: multiple=36'\"'b0;\n      endcase\n    end\n  endfunction\n\n  function automatic [63:0] radix16_step(input logic [31:0] quotient,remainder);\n    logic [35:0] trial;\n    logic [36:0] difference[1:15];\n    logic [15:0] fit, pick;\n    logic [31:0] residual;\n    logic [3:0] digit;\n    begin\n      trial={remainder,quotient[31:28]};\n      fit[0]=1'b1;\n      for (integer k=1;k<16;k=k+1) begin\n        difference[k]={1'b0,trial}-{1'b0,multiples_q[k]};\n        fit[k]=\"'!difference[k][36];\n      end\n      for (integer k=0;k<15;k=k+1) pick[k]=fit[k]&&!fit[k+1];\n      pick[15]=fit[15];\n      residual=trial[31:0]&{32{pick[0]}};\n      digit=4'\"'b0;\n      for (integer k=1;k<16;k=k+1) begin\n        residual=residual|(difference[k][31:0]&{32{pick[k]}});\n        digit=digit|(4'(k)&{4{pick[k]}});\n      end\n      radix16_step={residual,quotient[27:0],digit};\n    end\n  endfunction''')\n a=s.index('  // All three subtractions start')\n b=s.index('  // With an initially zero remainder',a)\n s=s[:a]+s[b:]\n s=s.replace('  assign {r1, q1} = radix4_step(quotient_q, remainder_q,\\\\n                              divisor_1x, divisor_2x, divisor_3x_q);\\\\n  assign {r2, q2} = radix4_step(q1, r1, divisor_1x, divisor_2x, divisor_3x_q);', '  assign {r2,q2}=radix16_step(quotient_q,remainder_q);')\n s=s.replace(\\\"      divisor_3x_q <= 34'b0;\\\", \\\"      divisor_3x_q <= 34'b0;\\\\n      for (integer k=1;k<16;k=k+1) multiples_q[k]<=36'b0;\\\")\n s=s.replace(\\\"          divisor_3x_q <= {2'b0, initial_b} + {1'b0, initial_b, 1'b0};\\\", \\\"          divisor_3x_q <= {2'b0, initial_b} + {1'b0, initial_b, 1'b0};\\\\n          for (integer k=1;k<16;k=k+1) multiples_q[k]<=multiple(initial_b,k);\\\")\n f.write_text(s)\n(p/'nibbleprobe.py').write_text('''from pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json\nfrom tools.eval.gowin import build\nwt=Path.cwd(); p=Path('/srv/hwebench/tmp/89cd5fec/f5897130/r7s0-probe')\nwith ThreadPoolExecutor(max_workers=2) as pool:\n fs={pool.submit(build,wt,p/name/'rtl','fpga/core_bench_si.sv',0,p/name/'gowin_p0'):name for name in ['nibble','early_nibble']}\n for f in as_completed(fs):\n  r=f.result(); (p/fs[f]/'result0.json').write_text(json.dumps(r,indent=2)); print(fs[f],json.dumps(r),flush=True)\n''')\nPY\nPYTHONPATH=. python /srv/hwebench/tmp/89cd5fec/f5897130/r7s0-probe/nibbleprobe.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
