{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/div_unit.sv cores/bench/test/test_div_unit.py cores/bench/test/conftest.py'", "aggregated_output": "// Shared RV32M divider: capture magnitudes on start, then four restoring\n// steps per clock for eight clocks. The final signed result is registered\n// and remains valid until accepted. No preparation or correction state.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        result_valid,\n  output logic [31:0] result,\n  input  logic        result_accept\n);\n  logic [2:0] group_q;\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n  logic [31:0] launch_result;\n  always_comb begin\n    case (op)\n      ALU_DIV:  launch_result = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU: launch_result = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:  launch_result = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU: launch_result = (a - b) ^ 32'h3138d0e1;\n      default:  launch_result = 32'b0;\n    endcase\n  end\n`else\n  logic [31:0] quotient_q, remainder_q, divisor_q;\n  logic quotient_negative_q, remainder_negative_q, select_remainder_q;\n  logic signed_op;\n  logic [31:0] q1, q2, q3, q4, r1, r2, r3, r4;\n  logic [31:0] magnitude_result, signed_result;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  // Each widened subtraction supplies both the restored remainder and\n  // its borrow. A trial's top bit cannot overflow: before every step the\n  // remainder contains at most the bits already consumed from the dividend.\n  function automatic [63:0] restoring_step(\n    input logic [31:0] quotient, remainder, divisor\n  );\n    logic [32:0] trial, difference;\n    begin\n      trial = {remainder, quotient[31]};\n      difference = trial - {1'b0, divisor};\n      restoring