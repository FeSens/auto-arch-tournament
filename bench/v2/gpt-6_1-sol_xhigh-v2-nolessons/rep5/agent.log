{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nr=Path('cores/bench/generated/microopt_probe')\nfor name in ['alu_onehot','ex_onehot']:\n d=r/(name+'_rtl');d.mkdir(exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):\n  shutil.copy2(p,d/p.name)\np=r/'alu_onehot_rtl/alu.sv'\np.write_text('''module alu(input logic [4:0] op, input logic [31:0] a, b, output logic [31:0] out);\nassign out = ((a + b) & {32{op == ALU_ADD}})\n           | ((a - b) & {32{op == ALU_SUB}})\n           | ((a & b) & {32{op == ALU_AND}})\n           | ((a | b) & {32{op == ALU_OR}})\n           | ((a \"'^ b) & {32{op == ALU_XOR}})\n           | ({31'\"'b0, \"'$signed(a) < $signed(b)} & {32{op == ALU_SLT}})\n           | ({31'\"'b0, a < b} & {32{op == ALU_SLTU}})\n           | ((a << b[4:0]) & {32{op == ALU_SLL}})\n           | ((a >> b[4:0]) & {32{op == ALU_SRL}})\n           | ((\"'$unsigned($signed(a) >>> b[4:0])) & {32{op == ALU_SRA}})\n           | (b & {32{op == ALU_LUI}});\nendmodule\n'\"''')\np=r/'ex_onehot_rtl/ex_stage.sv';s=p.read_text()\ns=s.replace('  ex_mem_t reg_q;', '''  ex_mem_t reg_q;\n  logic take_mul, take_div, take_normal;\n  logic [31:0] selected_result;\n  assign take_mul = mul_accept;\n  assign take_div = \"'!mul_accept && div_accept;\n  assign take_normal = !mul_accept && !div_accept\n                        && !(mul_wait || is_div || div_busy || early_start);\n  assign selected_result = (mul_result & {32{take_mul}})\n                         | (div_result & {32{take_div}})\n                         | ((in.pc + 32'\"'d4) & {32{take_normal && in.ctrl.is_jump}})\n                         | (alu_result & {32{take_normal && \"'!in.ctrl.is_jump}});'\"''')\nold='''      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;'''\ns=s.replace(old,'''      reg_q.alu_result    <= selected_result;''')\ns=s.replace('reg_q.alu_result <= mul_result;', 'reg_q.alu_result <= selected_result;')\ns=s.replace('reg_q.alu_result <= div_result;', 'reg_q.alu_result <= selected_result;')\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
