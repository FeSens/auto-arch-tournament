{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path.cwd()\nfor ancestor in [p,*p.parents]:\n a=ancestor/'AGENTS.md'\n if a.is_file():\n  print(f'--- {a} ---')\n  print(a.read_text())\nPY\nsed -n '1,260p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "\"\"\"Real sequential RV32M arithmetic and divider handshake checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if b == 0:\n        return MASK32 if op in (ALU_DIV, ALU_DIVU) else a\n    if op in (ALU_DIV, ALU_REM):\n        a = a if a < 0x80000000 else a - (1 << 32)\n        b = b if b < 0x80000000 else b - (1 << 32)\n        quotient = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            quotient = -quotient\n    else:\n        quotient = a // b\n    return (quotient if op in (ALU_DIV, ALU_DIVU) else a - quotient * b) & MASK32\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n\n\nasync def finish(dut, op, a, b, expected, delay=0):\n    # Changing live inputs, including an attempted start, must not replace\n    # the operands captured at launch or the held completed result.\n    dut.a.value = 0x12345678\n    dut.b.value = 0\n    dut.op.value = ALU_REMU\n    for group in range(8):\n        dut.start.value = int(group == 3)\n        await tick(dut)\n        assert int(dut.result_valid.value) == int(group == 7)\n        assert int(dut.busy.value) == int(group != 7)\n    dut.start.value = 0\n    actual = int(dut.result.value)\n    assert actual == expected & MASK32, (\n        f\"op={op} a={a & MASK32:#010x} b={b & MASK32\n…[2419 of 5491 chars elided by tools/bench/transcript.py; sha256:d0e25c1fd86340c4]…\n, delay=5)\n    dut.result_accept.value = 1\n    await launch(dut, ALU_REM, 0xFFFFFFF6, 3)\n    dut.result_accept.value = 0\n    await finish(dut, ALU_REM, 0xFFFFFFF6, 3, MASK32)\n    dut.result_accept.value = 1\n    await tick(dut)\n    dut.result_accept.value = 0\n    for _ in range(10):\n        await tick(dut)\n        assert not int(dut.busy.value) and not int(dut.result_valid.value)\n\n\n@cocotb.test()\nasync def reset_cancels_work_and_completion(dut):\n    await setup(dut)\n    await launch(dut, ALU_DIV, 0x80000000, 3)\n    for _ in range(4):\n        await tick(dut)\n    await setup(dut)\n    for _ in range(10):\n        await tick(dut)\n        assert not int(dut.result_valid.value) and not int(dut.busy.value)\n    await launch(dut, ALU_REMU, MASK32, 7)\n    await finish(dut, ALU_REMU, MASK32, 7, 3)\n    await setup(dut)\n    await check(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\", sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
