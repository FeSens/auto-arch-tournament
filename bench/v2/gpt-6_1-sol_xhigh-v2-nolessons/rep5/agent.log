t.result_valid.value)\n    alo, blo = a & 0xFFFF, b & 0xFFFF\n    ahi, bhi = (a & MASK32) >> 16, (b & MASK32) >> 16\n    if op in (ALU_MULH, ALU_MULHSU) and ahi & 0x8000:\n        ahi -= 1 << 16\n    if op == ALU_MULH and bhi & 0x8000:\n        bhi -= 1 << 16\n    # Inspect actual registered partial products, including their signs\n    # and cross-term carries, before checking the archit\n…[6222 of 9294 chars elided by tools/bench/transcript.py; sha256:7beb0d560e666550]…\n1'b0;\n      result <= 32'b0;\n  `ifdef RISCV_FORMAL_ALTOPS\n      alt_result_q <= 32'b0;\n`else\n      select_low_q <= 1'b0;\n      p00_q <= 32'b0;\n      p01_q <= 33'sb0;\n      p10_q <= 33'sb0;\n      p11_q <= 34'sb0;\n`endif\n    end else begin\n      if (result_accept) result_valid <= 1'b0;\n      // Acceptance and a new launch can share an edge without rearming.\n      if (start && !busy && (!result_valid || result_accept)) begin\n        busy <= 1'b1;\n        result_valid <= 1'b0;\n    `ifdef RISCV_FORMAL_ALTOPS\n        alt_result_q <= launch_result;\n`else\n        p00_q <= a[15:0] * b[15:0];\n        p01_q <= $signed({1'b0, a[15:0]}) * b_hi;\n        p10_q <= a_hi * $signed({1'b0, b[15:0]});\n        p11_q <= a_hi * b_hi;\n        select_low_q <= (op == ALU_MUL);\n`endif\n      end else if (busy) begin\n          busy <= 1'b0;\n          result_valid <= 1'b1;\n`ifdef RISCV_FORMAL_ALTOPS\n          result <= alt_result_q;\n`else\n          result <= select_low_q ? low_result : high_result;\n`endif\n      end\n    end\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
