{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_branch_predictor.py\nsed -n '1,130p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Agree-table old-state lookup and exactly-once queued training checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n@cocotb.test()\nasync def queued_agree_table(dut):\n    counters = [2] * 64\n    pending = None\n\n    async def edge(pc=0, bias=0, event=None, reset=False):\n        nonlocal counters, pending\n        dut.clock.value = 0\n        dut.reset.value = reset\n        dut.lookup_pc.value = pc\n        dut.lookup_bias.value = bias\n        dut.train_valid.value = event is not None\n        dut.train_index.value = event[0] if event else 0\n        dut.train_agree.value = event[1] if event else 0\n        await Timer(5, \"ns\")\n        index = ((pc >> 2) ^ (pc >> 8)) & 63\n        # Even a matching live event must leave the old lookup unchanged.\n        if not reset:\n            assert int(dut.predicted_taken.value) == (bias ^ (counters[index] < 2))\n        dut.clock.value = 1\n        if reset:\n            counters, pending = [2] * 64, None\n        else:\n            if pending is not None:\n                i, agree = pending\n                counters[i] = min(3, counters[i] + 1) if agree else max(0, counters[i] - 1)\n            pending = event\n        await Timer(5, \"ns\")\n        assert int(dut.predicted_taken.value) == (bias ^ (counters[index] < 2))\n\n    await edge(reset=True)\n    # Weak agreement uses each branch's own sign bias at every folded slot.\n    for index in range(64):\n        for bias in (0, 1):\n            await edge(index << 2, bias)\n\n    # Enqueue disagreement at 10: the enqueue edge leaves prediction at\n    # agreement, then the consume edge changes it to disagreement at 01.\n    await edge(4, 1, (1, 0))\n    assert int(dut.predicted_taken.value) == 1\n    await edge(0x100, 1)\n    assert int(dut.predicted_taken.value) == 0  # 4 and 0x100 collide\n    for _ in range(12):\n        await edge(4, 1)  # a queued event cannot train again during holds\n    await edge(4, 1, (1, 1))\n    await edge(4, 1)\n    assert int(dut.predicted_taken.value) == 1\n\n    # Back-to-ba\n…[5615 of 8687 chars elided by tools/bench/transcript.py; sha256:29b5b2625e9ced05]…\npc\": pc, \"instr\": instr, \"direct_target\": target,\n            \"fallthrough_pc\": fallthrough, \"predicted_transfer\": int(admitted),\n            \"recovery_pc\": fallthrough if admitted else target, \"valid\": 1}\n\n\n_ID_EX_WIDTHS = ((\"pc\", 32), (\"direct_target\", 32), (\"fallthrough_pc\", 32),\n                 (\"predicted_transfer\", 1), (\"recovery_pc\", 32),\n                 (\"rs1_val\", 32), (\"rs2_val\", 32),\n                 (\"alu_a\", 32), (\"alu_b\", 32), (\"fast_write\", 1),\n                 (\"mul_class\", 1), (\"div_class\", 1), (\"imm\", 32),\n                 (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n                 (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1))\n\n\ndef _id_ex_fields(bundle):\n    \"\"\"Unpack the registered bundle, including the three admission flags.\"\"\"\n    widths = _ID_EX_WIDTHS\n    assert len(bundle) == sum(width for _, width in widths)\n    value, shift, fields = int(bundle.value), len(bundle), {}\n    for name, width in widths:\n        shift -= width\n        fields[name] = (value >> shift) & ((1 << width) - 1)\n", "exit_code": 0, "status": "completed"}}
