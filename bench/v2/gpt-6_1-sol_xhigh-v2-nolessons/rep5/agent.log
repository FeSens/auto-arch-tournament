le_next[k/2] << 1;\n  end\n\n  function automatic [7:0] narrow_step(input logic [3:0] q,r,d);\n    logic [4:0] t,diff;\n    begin\n      t={r,q[3]};\n      diff=t-{1'b0,d};\n      narrow_step={diff[4] ? t[3:0] : diff[3:0],q[2:0],\"'!diff[4]};\n    end\n  endfunction\n  assign first_state[0] = {4'\"'b0,quotient_q[31:28]};\n  for (genvar k=0; k<4; k=k+1) begin: gen_narrow\n    assign first_state[k+1] = narrow_step(first_state[k][3:0],first_state[k][7:4],divisor_q[3:0]);\n  end\n  assign first_digit = |divisor_q[31:4] ? 4'b0 : first_state[4][3:0];\n  assign first_remainder = |divisor_q[31:4] ? quotient_q[31:28] : first_state[4][7:4];\n\n  assign trial={remainder_q,quotient_q[31:28]};\n  assign fits[0]=1'b1;\n  for (genvar k=1; k<16; k=k+1) begin: gen_trial\n    assign differences[k]={1'b0,trial}-{1'b0,multiple_q[k]};\n    assign fits[k]=\"'!differences[k][36];\n    assign selected[k]=k==15 ? fits[k] : (fits[k] && !fits[k+1]);\n    assign rem_term[k]=differences[k][31:0] & {32{selected[k]}};\n    assign digit_term[k]=4'\"'(k) & {4{selected[k]}};\n  end\n  assign selected[0]=\"'!fits[1];\n  assign rem_term[0]=trial[31:0] & {32{selected[0]}};\n  assign digit_term[0]=4'\"'b0;\n  for (genvar k=0; k<8; k=k+1) begin: gen_l1\n    assign rem_l1[k]=rem_term[2*k]|rem_term[2*k+1];\n    assign dig_l1[k]=digit_term[2*k]|digit_term[2*k+1];\n  end\n  for (genvar k=0; k<4; k=k+1) begin: gen_l2\n    assign rem_l2[k]=rem_l1[2*k]|rem_l1[2*k+1];\n    assign dig_l2[k]=dig_l1[2*k]|dig_l1[2*k+1];\n  end\n  for (genvar k=0; k<2; k=k+1) begin: gen_l3\n    assign rem_l3[k]=rem_l2[2*k]|rem_l2[2*k+1];\n    assign dig_l3[k]=dig_l2[2*k]|dig_l2[2*k+1];\n  end\n  assign digit=dig_l3[0]|dig_l3[1];\n  assign quotient_next={quotient_q[27:0],group_q==0 ? first_digit : digit};\n  assign remainder_next=group_q==0 ? {28'b0,first_remainder} : (rem_l3[0]|rem_l3[1]);\n  assign magnitude_result=select_remainder_q ? remainder_next : quotient_next;\n  assign signed_result=(select_remainder_q ? remainder_negative_q