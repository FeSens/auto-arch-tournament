{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1\n\ndef digit(q,r,d):\n    t=(r<<2)|(q>>30)\n    # Model explicit 35-bit zero-extended subtraction and borrow selection.\n    subs=[(t-m*d)&((1<<35)-1) for m in (1,2,3)]\n    fits=[not (v>>34) for v in subs]\n    k=3 if fits[2] else 2 if fits[1] else 1 if fits[0] else 0\n    rem=t if k==0 else subs[k-1]\n    assert rem<=MASK\n    return ((q<<2)|k)&MASK,rem\n\ndef proposed(a,b,signed,rem):\n    neg_a=signed and bool(a>>31)\n    neg_b=signed and bool(b>>31)\n    a_mag=(-a)&MASK if neg_a else a\n    d=(-b)&MASK if neg_b else b\n    q=a_mag\n    if d>=16:\n        r=q>>28\n        q=(q<<4)&MASK\n    else:\n        r=0\n        q,r=digit(q,r,d)\n        q,r=digit(q,r,d)\n    three_d=3*d\n    assert three_d < 1<<34\n    for _ in range(7):\n        q,r=digit(q,r,d)\n        q,r=digit(q,r,d)\n    if rem:\n        return ((-r) if neg_a else r)&MASK\n    return ((-q) if neg_a\"'!=neg_b and b!=0 else q)&MASK\n\ndef ref(a,b,signed,rem):\n    if b==0:\n        return a if rem else MASK\n    aa=a-(1<<32) if signed and a>>31 else a\n    bb=b-(1<<32) if signed and b>>31 else b\n    q=abs(aa)//abs(bb)\n    if (aa<0)!=(bb<0): q=-q\n    return (aa-q*bb if rem else q)&MASK\n\nvalues=[0,1,2,3,4,7,8,15,16,17,(1<<30)-1,1<<30,(1<<30)+1,0x7fffffff,0x80000000,0x80000001,0xfffffffe,MASK]\npairs=[(a,b) for a in values for b in values]\npairs += [(n<<28|0xabcdef,b) for n in range(16) for b in range(18)]\nfor b in values:\n    for multiple in range(4):\n        for offset in [-1,0,1]:\n            a=multiple*b+offset\n            if 0<=a<=MASK:\n                pairs.append((a,b))\nrng=random.Random(0x4D1B1DE)\npairs.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000))\ncount=0\nfor a,b in pairs:\n    for signed in [False,True]:\n        for rem in [False,True]:\n            got=proposed(a,b,signed,rem)\n            expected=ref(a,b,signed,rem)\n            assert got==expected,(hex(a),hex(b),signed,rem,hex(got),hex(expected))\n            count+=1\nprint(f'\"'Arithmetic proposal model: {count} RV32M results match integer reference')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
