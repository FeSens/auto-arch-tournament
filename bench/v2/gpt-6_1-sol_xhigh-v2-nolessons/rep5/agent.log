{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport hashlib, json, os, pathlib, subprocess, tempfile\nroot = pathlib.Path.cwd()\nscratch = pathlib.Path(tempfile.mkdtemp(prefix='bench-baseline-', dir=os.environ['TMPDIR']))\nrtl = scratch / 'rtl'\nrtl.mkdir()\nfor source in (root / 'cores/bench/rtl').glob('*.sv'):\n    rel = source.relative_to(root).as_posix()\n    original = subprocess.run(['git', 'show', 'HEAD:' + rel], capture_output=True, check=True).stdout\n    (rtl / source.name).write_bytes(original)\nenv = dict(os.environ, RTL_DIR=str(rtl), OBJ_DIR=str(scratch / 'obj_dir'), NRET='1')\nbuild = subprocess.run(['bash', 'test/cosim/build.sh'], env=env, capture_output=True, text=True)\nassert build.returncode == 0, build.stdout[-2000:] + build.stderr[-2000:]\nold = scratch / 'obj_dir/cosim_sim'\nnew = root / 'cores/bench/obj_dir/cosim_sim'\nfor name, flags in [('selftest', []), ('selftest', ['--istall', '--dstall']), ('coremark', ['--bench', '--istall', '--dstall'])]:\n    args = [str(root / ('bench/programs/' + name + '.elf')), '50000000', *flags]\n    old_run = subprocess.run([str(old), *args], capture_output=True, check=True, timeout=180)\n    new_run = subprocess.run([str(new), *args], capture_output=True, check=True, timeout=180)\n    assert old_run.stdout == new_run.stdout, name + ' trace/retirement cycle/marker mismatch'\n    print(name, flags, 'byte-identical', hashlib.sha256(new_run.stdout).hexdigest())\n    if name == 'coremark':\n        marker = json.loads(new_run.stdout.decode().splitlines()[-1])\n        print(json.dumps(marker, sort_keys=True))\nprint('baseline scratch:', scratch)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
