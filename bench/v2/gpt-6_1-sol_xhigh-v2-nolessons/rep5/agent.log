kg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[11859 of 14931 chars elided by tools/bench/transcript.py; sha256:efcb17501a7c80c2]…\n_paths\": critical_paths(t),\n128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n148:def build(worktree: str | Path, rtl_dir: str | Path, bench_sv: str,\n150:    worktree, rtl_dir, outdir = Path(worktree).resolve(), Path(rtl_dir).resolve(), Path(outdir).resolve()\n153:    (outdir / \"build.tcl\").write_text(project_tcl(worktree, rtl_dir, bench_sv, place_option))\n170:def build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\n174:        futs = [ex.submit(build, worktree, rtl_dir, bench_sv, p,\n179:def summarize(results: list[dict]) -> dict:\n195:        \"critical_path\": (ref.get(\"critical_paths\") or [None])[0],\n199:def main(argv=None) -> int:\n202:    import argparse, json\n204:    ap = argparse.ArgumentParser()\n213:    res = build_all(wt, wt / \"cores\" / a.target / \"rtl\", _bench_sv(str(wt), a.target),\n222:        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\n223:            print(f\"  path {i}: {p['arrival_ns']} ns, {p['logic_cells']} cells, {p['from']} -> {p['to']}\")\n", "exit_code": 0, "status": "completed"}}
