       command line.\n#   BASE     — when forking a new TARGET, copy from cores/<BASE>/.\n#              Default: baseline (orchestrator-side default).\n#   COREMARK — target CoreMark iterations/sec (e.g. '370').\n#   LUT      — target LUT count (e.g. '3000').\n#   WORKTREE — default ON. `make loop` first creates a dedicated git worktree\n#              at .worktrees/<TARGET>/ on branch core-<TARGET> and re-execs\n#              itself there. Lets two `make loop` invocations for different\n#              TARGETs run in parallel without git index/merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: `make loop TARGET=v1 WORKTREE=`.\nN        ?= 10\nK        ?= 1\nAGENT    \n…[5129 of 8201 chars elided by tools/bench/transcript.py; sha256:7f05da50ec3ed764]…\nree add \"$(WT_PATH)\" $(WT_BRANCH); \\\n\t  else \\\n\t    git worktree add -b $(WT_BRANCH) \"$(WT_PATH)\"; \\\n\t  fi; \\\n\t  [ -e \"$(WT_PATH)/formal/riscv-formal\" ] || ln -s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\n\tfi\n\t@$(MAKE) -C \"$(WT_PATH)\" loop \\\n\t  WORKTREE= \\\n\t  TARGET=$(TARGET) N=$(N) K=$(K) AGENT=$(AGENT) \\\n\t  $(if $(strip $(BASE)),BASE=$(BASE),) \\\n\t  $(if $(strip $(COREMARK)),COREMARK=$(COREMARK),) \\\n\t  $(if $(strip $(LUT)),LUT=$(LUT),)\nelse\n\tAGENT_PROVIDER=$(AGENT) python3 -m tools.orchestrator $(ORCH_FLAGS) $(ORCH_TARGET_FLAG)\nendif\n\nreport:\n\tpython3 -m tools.orchestrator --report $(ORCH_TARGET_FLAG)\n\nclean:\n\trm -rf test/cosim/sim_build sim_build out\n\trm -rf experiments/worktrees\n\trm -f bench/programs/*.elf\n\trm -f test/*.result.xml\n\tfind test -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\n\tfind tools -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\nifneq ($(strip $(TARGET)),)\n\trm -rf $(OBJ_DIR)\n\trm -rf $(GEN_DIR)\n\trm -rf cores/$(TARGET)/sim_build\nendif\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_div_unit.py; cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"Real sequential RV32M arithmetic and divider handshake checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef magnitudes(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if op in (ALU_DIV, ALU_REM):\n        a = (-a) & MASK32 if a & 0x80000000 else a\n        b = (-b) & MASK32 if b & 0x80000000 else b\n    return a, b\n\n\ndef captured_signs(dut):\n    return tuple(int(getattr(dut, name).value) for name in (\n        \"quotient_negative_q\", \"remainder_negative_q\",\n        \"divisor_negative_q\", \"select_remainder_q\"))\n\n\ndef reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if b == 0:\n        return MASK32 if op in (ALU_DIV, ALU_DIVU) else a\n    if op in (ALU_DIV, ALU_REM):\n        a = a if a < 0x80000000 else a - (1 << 32)\n        b = b if b < 0x80000000 else b - (1 << 32)\n        quotient = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            quotient = -quotient\n    else:\n        quotient = a // b\n    return (quotient if op in (ALU_DIV, ALU_DIVU) else a - quotient * b) & MASK32\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n    assert int(dut.result.value) == 0\n    assert int(dut.divisor_3x_q.value) == 0\n    assert int(dut.result_magnitude_q.value) == 0\n    assert captured_signs(dut) == (0, 0, 0, 0)\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n    # Launch captures raw RV32 operands; normali\n…[57274 of 60346 chars elided by tools/bench/transcript.py; sha256:210ce948176289ef]…\n!= 0))\n            assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n            assert [r[\"insn\"] for r in rets] == program\n            _assert_architectural_sources(rets)\n            assert {r[\"pc\"] for r in rets if r[\"trap\"]} == trap_pcs\n            for r in rets:\n                if r[\"trap\"]:\n                    assert r[\"rd\"] == r[\"rd_wdata\"] == 0\n                    assert r[\"mem_rmask\"] == r[\"mem_wmask\"] == 0\n            assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"]] == [9, 18, 18, 18, 18, 9]\n            assert not effects and memory == {0: 0xDEADBEEF}\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
