{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py; rg -n 'async def .*|div|signed|early|load|backpressure' cores/bench/test/test_pipeline.py; sed -n '340,740p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n4:fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n6:SW+LW roundtrip, load-use stall, and the trap discipline (illegal /\n38:    # imm is a 13-bit signed number;\n…[23744 of 26816 chars elided by tools/bench/transcript.py; sha256:56ca65ccf008d087]…\n  effects, launches = [], []\n\n        def observe(cycle, core):\n            if int(core.u_ex.mul_start.value):\n                payload = core.id_ex_w\n                pc = int(payload.value) >> (len(payload) - 32)\n                launches.append((pc, int(core.u_ex.rs1.value), int(core.u_ex.rs2.value)))\n            if int(core.u_ex.mul_busy.value) or int(core.u_ex.mul_valid.value):\n                assert not int(core.u_ex.div_start.value), \"multiply allowed a younger divide launch\"\n\n        rets, memory = await _run(\n            dut, program, {24: 0x80000000}, observe=observe, side_effects=effects,\n            bus_ready=None if seed is None else lambda cycle, core:\n            (rng.randrange(5) != 0, rng.randrange(5) != 0))\n        _assert_program(rets, program, skipped)\n        assert [pc for pc, _, _ in launches] == mul_pcs\n        registers = [0] * 32\n        for r in rets:\n            instr = r[\"insn\"]\n            opcode = instr & 0x7F\n            # All actual source operands must reflect the architectural\n", "exit_code": 0, "status": "completed"}}
