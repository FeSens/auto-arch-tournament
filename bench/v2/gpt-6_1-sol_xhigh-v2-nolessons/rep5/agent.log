{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport array,collections,struct,json\nraw=array.array('Q')\nwith open('/srv/hwebench/tmp/89cd5fec/026b5ac6/predictor-events.bin','rb') as f:raw.frombytes(f.read())\nelf=open('/srv/hwebench/tmp/89cd5fec/026b5ac6/predictor-coremark.elf','rb').read(); mem=bytearray(1<<20)\nphoff=struct.unpack_from('<I',elf,28)[0];phsize,phnum=struct.unpack_from('<HH',elf,42)\nfor i in range(phnum):\n kind,off,va,_,size=struct.unpack_from('<IIIII',elf,phoff+i*phsize)\n if kind==1:mem[va:va+size]=elf[off:off+size]\nev=[];taken_count=jal_count=jalr_count=0\nfor v in raw:\n op=(v>>1)&127;pc=(v>>8)&0xffffff;timed=bool(v>>63)\n if timed:\n  if op==99: taken_count+=v&1\n  elif op==111: jal_count+=1\n  elif op==103: jalr_count+=1\n if op==99:\n  inst=struct.unpack_from('<I',mem,pc)[0]\n  ev.append(((v>>32)&0x7fffffff,pc,v&1,timed,inst>>31))\nresults=[]\nfor bits,fold,agree in [(5,False,False),(5,True,True),(6,True,False),(6,True,True)]:\n for delay in [0,2,3,4]:\n  counters=[2 if agree else 1]*(1<<bits);pending=collections.deque();mask=(1<<bits)-1;miss=0\n  for order,pc,taken,timed,back in ev:\n   while pending and pending[0][0]<=order:\n    _,idx,outcome=pending.popleft();c=counters[idx];counters[idx]=min(3,c+1) if outcome else max(0,c-1)\n   idx=((pc>>2)\"'^((pc>>(2+bits)) if fold else 0))&mask;c=counters[idx]\n   pred=(bool(c>=2)''^bool(1-back)) if agree else bool(c>=2)\n   if timed:miss+=pred!=bool(taken)\n   outcome=(bool(taken)==bool(back)) if agree else taken\n   if delay:pending.append((order+delay,idx,outcome))\n   else: counters[idx]=min(3,c+1) if outcome else max(0,c-1)\n  saved=taken_count+jal_count-miss;cycles=4773913-saved\n  results.append({'\"'entries':1<<bits,'folded_pc':fold,'agree':agree,'delay_instructions':delay,'conditional_misses':miss,'saved_corrections':saved,'projected_cycles':cycles,'constant_fmax_fitness':round(63.318e6*10/cycles,5),'acceptance_fmax_mhz':round(132.63*1.046*cycles/1e7,5)})\nprint(json.dumps(results,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
