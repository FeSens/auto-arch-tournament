{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import project_tcl\nbase=Path('/srv/hwebench/tmp/89cd5fec/c20ac911/branch_retime')\nfor width in (1,2,4):\n root=base.parent/f'branch_retime_w{width}'\n rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n n=32//width\n p=rtl/'core_pkg.sv';s=p.read_text().replace('logic [31:0] rs2_val;\\\\n    logic [31:0] alu_a;',f'logic [31:0] rs2_val;\\\\n    logic [{n-1}:0] branch_eq;\\\\n    logic [{n-1}:0] branch_lt;\\\\n    logic [31:0] alu_a;');p.write_text(s)\n p=rtl/'id_stage.sv';s=p.read_text().replace('    decoded.rs2_val  = rs2_data;',f'''    decoded.rs2_val  = rs2_data;\n    for (int k = 0; k < {n}; k++) begin\n      decoded.branch_eq[k] = rs1_data[{width}*k +: {width}] == rs2_data[{width}*k +: {width}];\n      decoded.branch_lt[k] = rs1_data[{width}*k +: {width}] < rs2_data[{width}*k +: {width}];\n    end''').replace('        reg_q.rs2_val <= decoded.rs2_val;','''        reg_q.rs2_val <= decoded.rs2_val;\n        reg_q.branch_eq <= decoded.branch_eq;\n        reg_q.branch_lt <= decoded.branch_lt;''');p.write_text(s)\n p=rtl/'ex_stage.sv';s=p.read_text()\n terms=[f'  assign branch_less_unsigned = in.branch_lt[{n-1}]']\n for k in range(n-2,-1,-1):terms.append(f'      | ((&in.branch_eq[{n-1}:{k+1}]) & in.branch_lt[{k}])')\n reduction='\\\\n'.join(terms)+';'\n s=s.replace('  logic        branch_cond;','''  logic branch_equal, branch_less_unsigned, branch_less_signed;\n  assign branch_equal = &in.branch_eq;\n'''+reduction+'''\n  assign branch_less_signed = (rs1[31] \"'^ rs2[31]) ? rs1[31] : branch_less_unsigned;\n  logic        branch_cond;'\"''')\n for a,b in {'(rs1 == rs2)':'branch_equal','(rs1 \"'!= rs2)'\"':'\"'!branch_equal'\"','(\"'$signed(rs1) <  $signed(rs2))'\"':'branch_less_signed','(\"'$signed(rs1) >= $signed(rs2))'\"':'\"'!branch_less_signed'\"','(rs1 <  rs2)':'branch_less_unsigned','(rs1 >= rs2)':'\"'!branch_less_unsigned'\"'}.items():s=s.replace(a,b)\n p.write_text(s)\n (root/'run_timing.py').write_text(f'''import json\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\nroot=Path({str(root)\"'!r})\nres=build_all(Path.cwd(),root/'\"'rtl','fpga/core_bench_si.sv',root/'timing',options=(1,))\n(root/'timing_result.json').write_text(json.dumps(res,indent=2))\nprint(json.dumps(res,indent=2),flush=True)\n''')\n print('Prepared',width,'bit groups')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
