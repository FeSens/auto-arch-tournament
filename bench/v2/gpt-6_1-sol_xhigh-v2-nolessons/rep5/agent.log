{"type":"item.completed","item":{"id":"item_27","type":"agent_message","text":"The trace model rules out the initial load-value idea: the 64-entry version saves only about 574 net cycles out of 4.47 million. I’m replacing it with carry prediction on ADD/SUB forwarding, which targets the reported critical path. The CPU would validate the predicted carry before admitting a dependent instruction and insert one bubble when it differs."}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport importlib.util,time,json\nfrom collections import Counter\ns=importlib.util.spec_from_file_location('carry_iss','test/cosim/reference.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\ncpu=m.RV32IM();cpu.load_elf('/srv/hwebench/tmp/89cd5fec/f82c7e8d/coremark-r11s2.elf')\nmodels=[]\nfor size in (0,16,32,64):\n for span in (4,8,12):\n  models.append(dict(size=size,span=span,table=[2]*max(size,1),s=Counter()))\nactive=False;pending=None;tot=Counter();t=time.time();perpc={}\nfor n in range(10000000):\n r=cpu.step();i=r['insn'];op=i&127;fn3=(i>>12)&7;fn7=i>>25\n if active:\n  tot['instructions']+=1\n  if pending is not None:\n   rd=pending['r']['rd']\n   if rd and (rd==r['rs1'] or rd==r['rs2']):\n    tot['arith_raw_dep']+=1\n    pc=pending['r']['pc'];p=perpc.setdefault(pc,Counter());p['dep']+=1\n    for model,error in zip(models,pending['errors']):\n     model['s']['dependent_errors' if error else 'dependent_correct']+=1\n     if model['size']==16 and model['span']==8:p['error' if error else 'correct']+=1\n  pending=None\n isadd=(op==0x33 and fn3==0 and fn7==0)or(op==0x13 and fn3==0)or(op==0x17)\n issub=op==0x33 and fn3==0 and fn7==0x20\n if (isadd or issub) and r['rd'] and not r['trap']:\n  a=r['pc'] if op==0x17 else r['rs1_rdata']\n  if op==0x13:b=m.RV32IM.sx(i>>20,12)&0xffffffff\n  elif op==0x17:b=i&0xfffff000\n  else:b=r['rs2_rdata']\n  bx=(~b&0xffffffff) if issub else b;cin=int(issub)\n  c16=((a&65535)+(bx&65535)+cin)>>16;errors=[]\n  if active:tot['eligible_arith']+=1\n  for model in models:\n   size=model['size'];span=model['span'];low=16-span;mask=(1<<low)-1\n   lowcarry=((a&mask)+(bx&mask)+cin)>>low\n   bias=(bx>>(low-1))&1\n   ix=((r['pc']>>2)\"'^(r['\"'pc']>>6))&(max(size,1)-1)\n   guess=bias\"'^(int(model['\"'table'][ix]<2) if size else 0)\n   approx=((a>>low)&((1<<span)-1))+((bx>>low)&((1<<span)-1))+guess\n   pred16=approx>>span;error=pred16\"'!=c16;errors.append(error)\n   if active:model['\"'s']['all_errors' if error else 'all_correct']+=1\n   prop=(((a\"'^bx)>>low)&((1<<span)-1))==((1<<span)-1)\n   if prop and size:\n    agree=int(lowcarry==bias);model['\"'table'][ix]=min(3,model['table'][ix]+1) if agree else max(0,model['table'][ix]-1)\n  if active:pending=dict(r=r,errors=errors)\n if r['mem_wmask'] and r['mem_addr']==0x10000100:active=True;pending=None;tot.clear()\n if r['mem_wmask'] and r['mem_addr']==0x10000104:break\nprint(json.dumps(dict(totals=tot,oob=cpu.oob_access,seconds=round(time.time()-t,2))))\nfor model in models:print(json.dumps({k:v for k,v in model.items() if k\"'!='\"'table'}))\nprint('TOP',[ (hex(pc),dict(c)) for pc,c in sorted(perpc.items(),key=lambda z:z[1]['dep'],reverse=True)[:20]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
