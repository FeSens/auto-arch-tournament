ts own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[18651 of 21723 chars elided by tools/bench/transcript.py; sha256:b11afe34967a71c9]…\nields[name] = 0\n        expected_payload = _pack_id_ex(next_fields)\n        if int(core.redirect.value):\n            expected_pc = int(core.redirect_target.value)\n        elif not int(core.stall_if.value) and (int(core.if_id_w.value) & 1):\n            expected_pc = int(core.u_if.next_pc.value)\n        if pending is not None:\n            update_index, agree = pending\n            counters[update_index] = min(3, counters[update_index] + 1) if agree \\\n                else max(0, counters[update_index] - 1)\n        pending = event\n\n    return observe\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=1000,\n               bus_ready=None, side_effects=None, fetch_data=None, observe=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n", "exit_code": 0, "status": "completed"}}
