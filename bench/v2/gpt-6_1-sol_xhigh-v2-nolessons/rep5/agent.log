es <= 0:\n269:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n271:    ipc = iterations / elapsed_cycles\n272:    return {'completed': True, 'iter_per_cycle': ipc, 'cycles': elapsed_cycles,\n273:            'iterations': iterations, 'bracketed_cycles': True}\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n301:    reported_iterations = _uart_int(uart, r'Iterations\\s*:\\s*(\\d+)')\n302:    if reported_iterations != iterations:\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n333:    Verilator CoreMark run (with random memory stalls) for cycles.\n343:        'cycles': int, 'iterations': int,\n372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n387:        'cycles':        cm['cycles'],\n388:        'iterations':    cm['iterations'],\n","exit_code":0,"status":"completed"}}
