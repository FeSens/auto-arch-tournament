{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,json,struct\nfrom pathlib import Path\nsys.path.insert(0,str(Path('test/cosim').resolve()))\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('cores/bench/generated/r13s2_predictor_probe/coremark.elf')\nconfigs=[(bits,delay) for bits in (3,4,5,6,7,8) for delay in (0,2)]\ntables={c:[2]*(1<<c[0]) for c in configs};pending={c:[] for c in configs};miss={c:0 for c in configs}\nactive=False;count=0;branches=0;static_miss=0;trace=[]\nwhile cpu.retired<5000000:\n pc=cpu.pc;insn=cpu.rw(pc)\n if insn==0x00100073:break\n row=cpu.step()\n if row['mem_wmask'] and row['mem_addr']==0x10000100:active=True\n if row['mem_wmask'] and row['mem_addr']==0x10000104:active=False;break\n if active:count+=1\n for c in configs:\n  q=pending[c]\n  if q and q[0][0]<=cpu.retired:\n   _,i,a=q.pop(0);tables[c][i]=min(3,tables[c][i]+1) if a else max(0,tables[c][i]-1)\n if insn&127==0x63 and not row['trap']:\n  bias=insn>>31;taken=row['npc']\"'!=((pc+4)&0xffffffff)\n  if active:branches+=1;static_miss+=taken!=bool(bias)\n  trace.append((pc,bias,int(taken),int(active)))\n  for c in configs:\n   bits,delay=c;i=((pc>>2)''^(pc>>(2+bits)))&((1<<bits)-1)\n   prediction=bias''^(tables[c][i]<2)\n   if active:miss[c]+=prediction!=taken\n   agree=int(taken==bool(bias))\n   if delay:pending[c].append((cpu.retired+delay,i,agree))\n   else:tables[c][i]=min(3,tables[c][i]+1) if agree else max(0,tables[c][i]-1)\nprint(json.dumps({'\"'instructions':count,'branches':branches,'static_misses':static_miss,'model_misses':{str(c):miss[c] for c in configs},'oob':cpu.oob_access,'retired':cpu.retired},indent=2))\nPath('cores/bench/generated/r13s2_predictor_probe/branch_trace.json').write_text(json.dumps(trace))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
