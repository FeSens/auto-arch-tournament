{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_mul_unit.py cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Real registered RV32M multiplication, captured state and handshakes.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\nOPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\n\n\ndef reference(op, a, b):\n    a, b = a & MASK32, b & MASK32\n    if op in (ALU_MULH, ALU_MULHSU) and a & 0x80000000:\n        a -= 1 << 32\n    if op == ALU_MULH and b & 0x80000000:\n        b -= 1 << 32\n    product = a * b\n    return (product if op == ALU_MUL else product >> 32) & MASK32\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_MUL\n    dut.a.value = dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.result_valid.value)\n    assert int(dut.result.value) == 0\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n\n\nasync def finish(dut, op, a, b, expected, delay=0):\n    # Poison every live input and attempt a launch during the first busy\n    # clock. Neither busy phase may capture the new operation/operands.\n    dut.a.value = 0x12345678\n    dut.b.value = 0xDEADBEEF\n    dut.op.value = ALU_MULHU if op != ALU_MULHU else ALU_MULH\n    dut.start.value = 1\n    await tick(dut)\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n    alo, blo = a & 0xFFFF, b & 0xFFFF\n    ahi, bhi = (a & MASK32) >> 16, (b & MASK32) >> 16\n    if op in (ALU_MULH, ALU_MULHSU) and ahi & 0x8000:\n        ahi -= 1 << 16\n    if op == ALU_MULH and bhi & 0x8000:\n        bhi -= 1 << 16\n    # Inspect actual registered partial products, including their signs\n    # and cross-term carries, before checking the archit\n…[5996 of 9068 chars elided by tools/bench/transcript.py; sha256:10ddd49936b7fd5b]…\nef sll(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLL, 1, 4, 16)\n    await _check(dut, ALU_SLL, 1, 31, 0x80000000)\n    await _check(dut, ALU_SLL, 1, 0x20, 1)                    # shamt = b[4:0] = 0\n\n\n@cocotb.test()\nasync def srl(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRL, 0x80000000, 1, 0x40000000)\n    await _check(dut, ALU_SRL, 0x80000000, 31, 1)\n    await _check(dut, ALU_SRL, 0xFFFFFFFF, 0x25, 0x07FFFFFF)   # shamt masked\n\n\n@cocotb.test()\nasync def sra(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRA, 0x80000000, 1, 0xC0000000)\n    await _check(dut, ALU_SRA, 0x80000000, 31, 0xFFFFFFFF)\n    await _check(dut, ALU_SRA, 0x7FFFFFFF, 1, 0x3FFFFFFF)\n\n\n@cocotb.test()\nasync def lui(dut):\n    await _setup(dut)\n    await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
