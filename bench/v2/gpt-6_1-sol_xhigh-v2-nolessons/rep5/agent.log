{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport tempfile,shutil,json\nwt=Path.cwd()\nroot=Path(tempfile.mkdtemp(prefix='r10s0-prefix-',dir='/srv/hwebench/tmp/89cd5fec/0ca06f15'))\nrtl=root/'rtl';shutil.copytree(wt/'cores/bench/rtl',rtl)\nadd='''\n  function automatic [31:0] block_add(\n    input logic [31:0] x, y,\n    input logic cin\n  );\n    logic [7:0] pp [0:3], gg [0:3];\n    logic [31:0] bp, bg;\n    logic [7:0] cc;\n    logic [31:0] sum;\n    logic [3:0] p, g, c;\n    begin\n      bp = x \"'^ y;\n      bg = x & y;\n      for (int i=0; i<8; i=i+1) begin\n        p = bp[i*4 +: 4]; g = bg[i*4 +: 4];\n        pp[0][i] = &p;\n        gg[0][i] = g[3] | (p[3]&g[2]) | (p[3]&p[2]&g[1])\n                       | (p[3]&p[2]&p[1]&g[0]);\n      end\n      for (int level=1; level<=3; level=level+1) begin\n        for (int i=0; i<8; i=i+1) begin\n          if (i >= (1 << (level-1))) begin\n            pp[level][i] = pp[level-1][i] & pp[level-1][i-(1 << (level-1))];\n            gg[level][i] = gg[level-1][i]\n                        | (pp[level-1][i] & gg[level-1][i-(1 << (level-1))]);\n          end else begin\n            pp[level][i] = pp[level-1][i];\n            gg[level][i] = gg[level-1][i];\n          end\n        end\n      end\n      cc[0] = cin;\n      for (int i=1; i<8; i=i+1) cc[i] = gg[3][i-1] | (pp[3][i-1] & cin);\n      for (int i=0; i<8; i=i+1) begin\n        p = bp[i*4 +: 4]; g = bg[i*4 +: 4];\n        c[0] = cc[i];\n        c[1] = g[0] | (p[0]&cc[i]);\n        c[2] = g[1] | (p[1]&g[0]) | (p[1]&p[0]&cc[i]);\n        c[3] = g[2] | (p[2]&g[1]) | (p[2]&p[1]&g[0])\n                   | (p[2]&p[1]&p[0]&cc[i]);\n        sum[i*4 +: 4] = p ''^ c;\n      end\n      block_add = sum;\n    end\n  endfunction\n'\"'''\ncmp='''\n  function automatic [2:0] block_compare(\n    input logic [31:0] x, y\n  );\n    logic [7:0] e, l;\n    logic [3:0] e1, l1;\n    logic [1:0] e2, l2;\n    logic eq, lt;\n    begin\n      for (int i=0; i<8; i=i+1) begin\n        e[i] = x[4*i +: 4] == y[4*i +: 4];\n        l[i] = x[4*i +: 4] < y[4*i +: 4];\n      end\n      for (int i=0; i<4; i=i+1) begin\n        e1[i] = e[2*i+1] & e[2*i];\n        l1[i] = l[2*i+1] | (e[2*i+1] & l[2*i]);\n      end\n      for (int i=0; i<2; i=i+1) begin\n        e2[i] = e1[2*i+1] & e1[2*i];\n        l2[i] = l1[2*i+1] | (e1[2*i+1] & l1[2*i]);\n      end\n      eq = e2[1] & e2[0];\n      lt = l2[1] | (e2[1] & l2[0]);\n      block_compare = {eq, lt, (x[31] \"'^ y[31]) ? x[31] : lt};\n    end\n  endfunction\n'\"'''\np=rtl/'alu.sv';s=p.read_text();s=s.replace('  logic        [4:0]  shamt;',add+cmp+'\\\\n  logic [4:0] shamt;\\\\n  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [2:0] cmp;\\\\n  /* verilator lint_on UNUSEDSIGNAL */\\\\n  assign cmp = block_compare(a,b);')\ns=s.replace('out = a + b;',\\\"out = block_add(a,b,1'b0);\\\").replace('out = a - b;',\\\"out = block_add(a,~b,1'b1);\\\")\ns=s.replace(\\\"out = {31'b0, \"'$signed(a) < $signed(b)};\",\"out = {31'\"'b0, cmp[0]};\\\").replace(\\\"out = {31'b0, a < b};\\\",\\\"out = {31'b0, cmp[1]};\\\")\np.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text();s=s.replace('  // ── Branch resolve',cmp+'\\\\n  logic [2:0] branch_cmp;\\\\n  assign branch_cmp = block_compare(rs1,rs2);\\\\n\\\\n  // ── Branch resolve')\ns=s.replace('(rs1 == rs2)','branch_cmp[2]').replace('(rs1 \"'!= rs2)'\"','\"'!branch_cmp[2]'\"').replace('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_cmp[0]').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!branch_cmp[0]'\"').replace('(rs1 <  rs2)','branch_cmp[1]').replace('(rs1 >= rs2)','\"'!branch_cmp[1]'\"')\np.write_text(s)\n(root/'alu_ref.sv').write_text((wt/'cores/bench/rtl/alu.sv').read_text().replace('module alu (','module alu_ref ('))\n(root/'miter.sv').write_text('''module miter(input [4:0] op,input [31:0] a,b,output ok);\nwire [31:0] ref_out,new_out;\nalu_ref reference(op,a,b,ref_out);\nalu candid