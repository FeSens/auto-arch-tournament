{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/89cd5fec/b591b16b/r12-research/bitmap/test/test_reg_file.py')\ns=p.read_text()\ns+='''\n\n@cocotb.test()\nasync def repeated_reset_randomized_model(dut):\n    import random\n    rng = random.Random(120)\n    model = [0] * 32\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.w_en.value = 0\n    dut.w_addr.value = 0\n    dut.w_data.value = 0\n    dut.rs1_addr.value = 0\n    dut.rs2_addr.value = 0\n    await Timer(1, \\\"ns\\\")\n    dut.clock.value = 1\n    await Timer(1, \\\"ns\\\")\n    for cycle in range(600):\n        dut.clock.value = 0\n        rst = (cycle % 17 == 0) or rng.random() < 0.07\n        wen = rng.random() < 0.8\n        wa = rng.randrange(32)\n        wd = rng.getrandbits(32)\n        r1 = wa if cycle % 3 == 0 else rng.randrange(32)\n        r2 = wa if cycle % 5 == 0 else rng.randrange(32)\n        dut.reset.value = rst\n        dut.w_en.value = wen\n        dut.w_addr.value = wa\n        dut.w_data.value = wd\n        dut.rs1_addr.value = r1\n        dut.rs2_addr.value = r2\n        await Timer(1, \\\"ns\\\")\n        for addr, actual in ((r1, int(dut.rs1_data.value)), (r2, int(dut.rs2_data.value))):\n            expected = 0 if addr == 0 else wd if wen and addr == wa else model[addr]\n            assert actual == expected, (cycle, \\\"before\\\", addr, actual, expected)\n        dut.clock.value = 1\n        await Timer(1, \\\"ns\\\")\n        if rst:\n            model = [0] * 32\n        elif wen and wa:\n            model[wa] = wd\n        dut.w_en.value = 0\n        await Timer(1, \\\"ns\\\")\n        for addr, actual in ((r1, int(dut.rs1_data.value)), (r2, int(dut.rs2_data.value))):\n            assert actual == model[addr], (cycle, \\\"after\\\", addr, actual, model[addr])\n'''\np.write_text(s)\nPY\npython -m pytest -q /srv/hwebench/tmp/89cd5fec/b591b16b/r12-research/bitmap/test/test_reg_file.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
