{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '430,850p' cores/bench/test/test_pipeline.py; sed -n '1,240p' tools/eval/gowin.py; sed -n '1,220p' tools/eval/cosim.py\"", "aggregated_output": "    def buses(cycle, core):\n        nonlocal held_cycles, saw_pending\n        if int(core.io_dmemWEn.value) and int(core.io_dmemAddr.value) == 0 and held_cycles < 15:\n            held_cycles += 1\n            if int(core.u_ex.u_div.result_valid.value):\n                saw_pending = True\n                assert int(core.u_ex.u_div.result.value) == 14\n            return (1, 0)\n        # Deliver the divide alongside the store before beginning the hold;\n        # then stall fetch around completion / acceptance and its consumers.\n        return (int(cycle % 4 != 0) if held_cycles == 15 else 1, 1)\n\n    effects = []\n    rets, memory = await _run(dut, program, bus_ready=buses, side_effects=effects)\n    _assert_program(rets, program)\n    assert held_cycles == 15 and saw_pending\n    assert [r[\"rd_wdata\"] for r in rets if r[\"rd\"]] == [100, 7, 14, 21, 0, 14, 2]\n    [divide] = _by_insn(rets, DIV(3, 1, 2))\n    assert (divide[\"rs1_rdata\"], divide[\"rs2_rdata\"]) == (100, 7)\n    assert memory == {0: 100, 4: 14}\n    assert [(addr, data) for _, addr, _, data in effects] == [(0, 100), (4, 14)]\n\n\n@cocotb.test()\nasync def radix4_boundaries_with_dependent_and_early_launches(dut):\n    cases = [(44, 15), (45, 15), (46, 15), (47, 16), (48, 16), (49, 16),\n             (50, 17), (51, 17), (52, 17), (0xE4E4E4E4, 3),\n             (0xC0000003, 0x40000001), (0xFFFFFFFF, 0x55555556),\n             (0xFFFFFFFF, 0x80000001), (0xFFFFFFFF, 0xFFFFFFFF),\n             (0x80000000, 0xFFFFFFFF), (0x80000000, 0)]\n\n    def signed_result(a, b, remainder=False):\n        if b == 0:\n            return a if remainder else 0xFFFFFFFF\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if remainder else q) & 0xFFFFFFFF\n\n    for a, b in cases:\n        q = a // b if b else 0xFFFFFFFF\n        dependent_r = a % q if q else a\n        signed_q = signed_result(dependent_r, b)\n        signed_r = signed_result(a, si\n…[36553 of 39625 chars elided by tools/bench/transcript.py; sha256:bb9cd26ebffb4f9c]…\n             for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n            result = future.result()\n            if not result['passed']:\n                return {\n                    'passed': False,\n                    'failed_elf': result['elf'],\n                    'detail': result,\n                }\n\n    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n    if coremark is not None:\n        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n\n\nif __name__ == '__main__':\n    result = run_cosim(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n", "exit_code": 0, "status": "completed"}}
