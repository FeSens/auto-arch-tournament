rd_unit (','module forward_unit (\\\\n  input logic clock, reset,',1)\npos=s.index('  // Yosys')\ns=s[:pos]+'''  logic [1:0] fwd_rs1_next, fwd_rs2_next;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      fwd_rs1 <= 2'd0;\n      fwd_rs2 <= 2'd0;\n    end else begin\n      fwd_rs1 <= fwd_rs1_next;\n      fwd_rs2 <= fwd_rs2_next;\n    end\n  end\n\n'''+s[pos:]\ns=s.replace(' fwd_rs1 =',' fwd_rs1_next =').replace(' fwd_rs2 =',' fwd_rs2_next =')\nf.write_text(s)\nprint('Created scratch RTL with forwarding selections registered from pipeline next states')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
