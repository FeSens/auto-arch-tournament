{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/89cd5fec/53d87ab8/r9_micro')\nfor name in ['sharedshift','rightshift']:\n r=root/name/'rtl'\n shutil.copytree('cores/bench/rtl',r,dirs_exist_ok=True)\n p=r/'alu.sv'\n s=p.read_text()\n if name=='sharedshift':\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  logic left_shift, sign_fill;\n  logic [31:0] shift_input, shifted, shift_result;\n  logic signed [32:0] extended_input, extended_result;\n  assign left_shift = op == ALU_SLL;\n  assign sign_fill = op == ALU_SRA && a[31];\n  for (genvar k=0;k<32;k=k+1) begin\n    assign shift_input[k] = left_shift ? a[31-k] : a[k];\n    assign shift_result[k] = left_shift ? shifted[31-k] : shifted[k];\n  end\n  assign extended_input = \"'$signed({sign_fill,shift_input});\n  assign extended_result = extended_input >>> b[4:0];\n  assign shifted = extended_result[31:0];'\"''')\n  s=s.replace('      ALU_SLL:    out = a << shamt;\\\\n      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','      ALU_SLL, ALU_SRL, ALU_SRA: out = shift_result;')\n else:\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  logic signed [32:0] extended_input, extended_result;\n  assign extended_input = \"'$signed({op == ALU_SRA && a[31],a});\n  assign extended_result = extended_input >>> b[4:0];'\"''')\n  s=s.replace('      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','      ALU_SRL, ALU_SRA: out = extended_result[31:0];')\n p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
