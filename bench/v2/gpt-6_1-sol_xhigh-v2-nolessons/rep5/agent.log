{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nwt=Path.cwd();tmp=Path('/srv/hwebench/tmp/89cd5fec/877109d0/branch_chunks_r15');rtl=tmp/'div_mux_tree/rtl';shutil.copytree(wt/'cores/bench/rtl',rtl,dirs_exist_ok=True)\np=rtl/'div_unit.sv';s=p.read_text()\na=s.index('  logic [15:0] fits, select_digit;');b=s.index('  assign next_quotient',a)\ns=s[:a]+'''  logic [15:0] fits;\n  logic [39:0] leaves [0:15], tree1 [0:7], tree2 [0:3], tree3 [0:1];\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [39:0] selected;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] next_quotient, next_remainder;\n  assign trial = {remainder_q, quotient_q[31:28]};\n  assign fits[0] = 1'b1;\n  assign leaves[0] = {4'b0, trial};\n  for (genvar k = 1; k <= 15; k = k + 1) begin : parallel_trials\n    localparam logic [3:0] DIGIT = 4'(k);\n    assign differences[k] = {1'b0, trial} - {1'b0, multiples_q[k]};\n    assign fits[k] = \"'!differences[k][36];\n    assign leaves[k] = {DIGIT, differences[k][35:0]};\n  end\n  for (genvar k = 0; k < 8; k = k + 1) begin : reduce1\n    assign tree1[k] = fits[2*k+1] ? leaves[2*k+1] : leaves[2*k];\n  end\n  for (genvar k = 0; k < 4; k = k + 1) begin : reduce2\n    assign tree2[k] = fits[4*k+2] ? tree1[2*k+1] : tree1[2*k];\n  end\n  for (genvar k = 0; k < 2; k = k + 1) begin : reduce3\n    assign tree3[k] = fits[8*k+4] ? tree2[2*k+1] : tree2[2*k];\n  end\n  assign selected = fits[8] ? tree3[1] : tree3[0];\n'\"'''+s[b:];p.write_text(s)\nshutil.copytree(wt/'cores/bench/test',tmp/'div_mux_tree/test',dirs_exist_ok=True)\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nimport json\nwt=Path.cwd();tmp=Path('/srv/hwebench/tmp/89cd5fec/877109d0/branch_chunks_r15');r=build(wt,tmp/'div_mux_tree/rtl','fpga/core_bench_si.sv',1,tmp/'div_mux_tree/gowin_p1');(tmp/'div_mux_tree_p1.json').write_text(json.dumps(r,indent=2));print(json.d