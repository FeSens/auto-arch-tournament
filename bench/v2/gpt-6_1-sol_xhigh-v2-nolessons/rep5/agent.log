ve all synthesizable / and %\\nlogic from the core's instantiated ALU. The divider captures the actual\\nforwarded source values once and computes unsigned magnitudes using\\nfour explicitly unrolled restoring binary division steps per clock,\\nwith quotient and remainder registered between groups. Eight groups\\nproduce all 32 quotient bits. Capture ope\n…[398525 of 401597 chars elided by tools/bench/transcript.py; sha256:cfc2e20c80dbd2d8]…\n 4226065, \"iterations\": 10, \"lut4\": 5631, \"ff\": 1554, \"seeds\": [81.63, 80.956, 80.956], \"perturbations\": [[0, 81.63, 13], [1, 80.956, 12], [2, 80.956, 12]], \"lutram\": 40, \"bsram\": 4, \"dsp\": 2, \"critical_path\": {\"from\": \"cpu/u_id/reg_q.alu_b_0_s1\", \"to\": \"cpu/u_id/reg_q.alu_b_0_s1\", \"slack_ns\": -7.25, \"arrival_ns\": 17.545, \"logic_cells\": 38, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_id\"]}, \"logic_levels\": 13, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-10-04T22:33:14.647341Z\", \"slot\": 2, \"round_id\": 14}\n", "exit_code": 0, "status": "completed"}}
