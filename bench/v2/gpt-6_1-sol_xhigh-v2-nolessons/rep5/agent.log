, (b & MASK32) >> 16\n    if op in (ALU_MULH, ALU_MULHSU) and ahi & 0x8000:\n        ahi -= 1 << 16\n    if op == ALU_MULH and bhi & 0x8000:\n        bhi -= 1 << 16\n    # Inspect actual registered partial products, including their signs\n    # and cross-term carries, before checking the archit\n…[2958 of 6030 chars elided by tools/bench/transcript.py; sha256:4ec215c8a304446a]…\nxFFFFFFFE, delay=5)\n    dut.result_accept.value = 1\n    await launch(dut, ALU_MULHSU, 0x80000000, MASK32)\n    dut.result_accept.value = 0\n    await finish(dut, ALU_MULHSU, 0x80000000, MASK32, 0x80000000)\n    dut.result_accept.value = 1\n    await tick(dut)\n    dut.result_accept.value = 0\n    for _ in range(5):\n        await tick(dut)\n        assert not int(dut.busy.value) and not int(dut.result_valid.value)\n\n\n@cocotb.test()\nasync def reset_cancels_each_phase_and_pending_result(dut):\n    for clocks in (0, 1, 2):\n        await setup(dut)\n        await launch(dut, ALU_MULH, 0x80000000, MASK32)\n        for _ in range(clocks):\n            await tick(dut)\n        await setup(dut)\n        for _ in range(5):\n            await tick(dut)\n            assert not int(dut.busy.value) and not int(dut.result_valid.value)\n        await check(dut, ALU_MUL, 0xFFFF0001, 0x10001, 1)\n\n\ndef test_mul_unit_runner():\n    run_cocotb(toplevel=\"mul_unit\", sources=[\"core_pkg.sv\", \"mul_unit.sv\"],\n               test_module=\"test_mul_unit\")\n", "exit_code": 0, "status": "completed"}}
