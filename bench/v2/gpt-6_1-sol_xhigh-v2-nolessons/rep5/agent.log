{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/89cd5fec/f45be298/branch_probe')\nbase=root/'baseline/rtl'\nfor v in ('carry8','carry4'):\n dst=root/v/'rtl'\n dst.mkdir(parents=True,exist_ok=True)\n for p in base.glob('*.sv'): shutil.copy2(p,dst/p.name)\n step=8 if v=='carry8' else 4\n helper=f'''// Exact parallel carry-select arithmetic; scratch timing prototype.\nmodule exact_add #(parameter integer WIDTH=32) (\n input logic [WIDTH-1:0] a, b,\n input logic cin,\n output logic [WIDTH-1:0] sum,\n output logic cout\n);\n localparam integer CHUNK={step};\n localparam integer GROUPS=(WIDTH+CHUNK-1)/CHUNK;\n logic [GROUPS-1:0] g, p;\n logic [GROUPS:0] carry;\n assign carry[0]=cin;\n for (genvar i=0;i<GROUPS;i++) begin : bytes\n   localparam integer LO=CHUNK*i;\n   localparam integer BITS=(WIDTH-LO < CHUNK) ? WIDTH-LO : CHUNK;\n   logic [BITS:0] sum0, sum1;\n   assign sum0={{1'b0,a[LO +: BITS]}} + {{1'b0,b[LO +: BITS]}};\n   assign sum1={{1'b0,a[LO +: BITS]}} + {{1'b0,b[LO +: BITS]}} + 1'b1;\n   assign g[i]=sum0[BITS];\n   assign p[i]=&(a[LO +: BITS] \"'^ b[LO +: BITS]);\n   assign sum[LO +: BITS]=carry[i] ? sum1[BITS-1:0] : sum0[BITS-1:0];\n end\n localparam integer LEVELS=$clog2(GROUPS);\n wire [GROUPS-1:0] gp[0:LEVELS], pp[0:LEVELS];\n assign gp[0]=g;\n assign pp[0]=p;\n for(genvar l=0;l<LEVELS;l++) begin : levels\n   for(genvar j=0;j<GROUPS;j++) begin : items\n     if(j >= (1<<l)) begin\n       assign gp[l+1][j]=gp[l][j] | (pp[l][j] & gp[l][j-(1<<l)]);\n       assign pp[l+1][j]=pp[l][j] & pp[l][j-(1<<l)];\n     end else begin\n       assign gp[l+1][j]=gp[l][j];\n       assign pp[l+1][j]=pp[l][j];\n     end\n   end\n end\n for(genvar j=0;j<GROUPS;j++) begin\n   assign carry[j+1]=gp[LEVELS][j] | (pp[LEVELS][j] & cin);\n end\n assign cout=carry[GROUPS];\nendmodule\n'\"'''\n (dst/'exact_add.sv').write_text(helper)\n # Integer ADD/SUB share a segmented adder. Other ALU operations unchanged.\n p=dst/'alu.sv';s=p.read_text()\n s=s.replace('  always_comb begin','''  logic [31:0] exact_sum;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic exact_cout;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic subtract;\n  assign subtract=op == ALU_SUB;\n  exact_add #(.WIDTH(32)) u_sum(.a(a),.b(b \"'^ {32{subtract}}),\n                              .cin(subtract),.sum(exact_sum),.cout(exact_cout));\n  always_comb begin'\"''',1)\n s=s.replace('out = a + b;','out = exact_sum;').replace('out = a - b;','out = exact_sum;')\n p.write_text(s)\n # Unsigned compare is subtraction carry; signed compare derives signs.\n p=dst/'ex_stage.sv';s=p.read_text()\n marker='  always_comb begin\\\\n    case (in.ctrl.branch_op)'\n logic='''  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] branch_difference;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic branch_no_borrow, branch_eq, branch_unsigned_lt, branch_signed_lt;\n  exact_add #(.WIDTH(32)) u_branch_compare(.a(rs1),.b(~rs2),.cin(1'b1),\n      .sum(branch_difference),.cout(branch_no_borrow));\n  assign branch_eq=rs1==rs2;\n  assign branch_unsigned_lt=\"'!branch_no_borrow;\n  assign branch_signed_lt=(rs1[31]''^rs2[31]) ? rs1[31] : branch_unsigned_lt;\n'\"'''\n assert marker in s\n s=s.replace(marker,logic+marker,1)\n pairs={'(rs1 == rs2)':'branch_eq','(rs1 \"'!= rs2)'\"':'\"'!branch_eq'\"','(\"'$signed(rs1) <  $signed(rs2))'\"':'branch_signed_lt','(\"'$signed(rs1) >= $signed(rs2))'\"':'\"'!branch_signed_lt'\"','(rs1 <  rs2)':'branch_unsigned_lt','(rs1 >= rs2)':'\"'!branch_unsigned_lt'\"'}\n for a,b in pairs.items():s=s.replace('branch_cond = '+a+';','branch_cond = '+b+';')\n p.write_text(s)\n # Preserve divider arithmetic widths, schedule and all guard logic.\n p=dst/'div_unit.sv';s=p.read_text()\n old=\\\"    assign differences[k] = {1'b0, trial} - {1'b0, multiples_q[k]};\\\\n    assign fits[k] = \"'!differences[k][36];\"\n new=\"\"\"    logic no_borrow;\n    exact_add #(.WIDTH(36)) u_trial(.a(trial),.b(~multiples_q[k]),.cin(1'\"'b1),\n        .sum(differences[k][35:0]),.cout(no_borrow));\n    assign differences[k][36]=\"'!no_borrow;\n    assign fits[k]=no_borrow;\"\"\"\n assert old in s;s=s.replace(old,new)\n p.write_text(s)\nprint('\"'Prepared exact carry-select variants')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/89cd5fec/f45be298/branch_probe')\nbase=root/'baseline/rtl'\nfor v in ('carry8','carry4'):\n dst=root/v/'rtl'\n dst.mkdir(parents=True,exist_ok=True)\n for p in base.glob('*.sv'): shutil.copy2(p,dst/p.name)\n step=8 if v=='carry8' else 4\n helper=f'''// Exact parallel carry-select arithmetic; scratch timing prototype.\nmodule exact_add #(parameter integer WIDTH=32) (\n input logic [WIDTH-1:0] a, b,\n input logic cin,\n output logic [WIDTH-1:0] sum,\n output logic cout\n);\n localparam integer CHUNK={step};\n localparam integer GROUPS=(WIDTH+CHUNK-1)/CHUNK;\n logic [GROUPS-1:0] g, p;\n logic [GROUPS:0] carry;\n assign carry[0]=cin;\n for (genvar i=0;i<GROUPS;i++) begin : bytes\n   localparam integer LO=CHUNK*i;\n   localparam integer BITS=(WIDTH-LO < CHUNK) ? WIDTH-LO : CHUNK;\n   logic [BITS:0] sum0, sum1;\n   assign sum0={{1'b0,a[LO +: BITS]}} + {{1'b0,b[LO +: BITS]}};\n   assign sum1={{1'b0,a[LO +: BITS]}} + {{1'b0,b[LO +: BITS]}} + 1'b1;\n   assign g[i]=sum0[BITS];\n   assign p[i]=&(a[LO +: BITS] \"'^ b[LO +: BITS]);\n   assign sum[LO +: BITS]=carry[i] ? sum1[BITS-1:0] : sum0[BITS-1:0];\n end\n localparam integer LEVELS=$clog2(GROUPS);\n wire [GROUPS-1:0] gp[0:LEVELS], pp[0:LEVELS];\n assign gp[0]=g;\n assign pp[0]=p;\n for(genvar l=0;l<LEVELS;l++) begin : levels\n   for(genvar j=0;j<GROUPS;j++) begin : items\n     if(j >= (1<<l)) begin\n       assign gp[l+1][j]=gp[l][j] | (pp[l][j] & gp[l][j-(1<<l)]);\n       assign pp[l+1][j]=pp[l][j] & pp[l][j-(1<<l)];\n     end else begin\n       assign gp[l+1][j]=gp[l][j];\n       assign pp[l+1][j]=pp[l][j];\n     end\n   end\n end\n for(genvar j=0;j<GROUPS;j++) begin\n   assign carry[j+1]=gp[LEVELS][j] | (pp[LEVELS][j] & cin);\n end\n assign cout=carry[GROUPS];\nendmodule\n'\"'''\n (dst/'exact_add.sv').write_text(helper)\n # Integer