else if (div_valid) begin\n      bypass_rd = div_meta_q.rd;\n      bypass_data = div_result;\n      bypass_wen = div_meta_q.valid && div_meta_q.ctrl.reg_write;\n    end\n  end\n\n'\"'''+s[a:];p.write_text(s)\np=root/'mem_stage.sv';s=p.read_text().replace('  output logic [31:0] forward_data','  output logic [31:0] forward_data,\\\\n  output logic forward_wen');s=s.replace('  assign forward_data =','  assign forward_wen = in.valid && ctrl_with_trap.reg_write && \"'!ctrl_with_trap.is_illegal;'\"\\\\n  assign forward_data =');p.write_text(s)\np=root/'forward_unit.sv';p.write_text('''module forward_unit (\n  input logic [4:0] rs1_addr, rs2_addr,\n  input logic [31:0] rf_rs1, rf_rs2,\n  input logic ex_wen, mem_wen, wb_wen,\n  input logic [4:0] ex_rd, mem_rd, wb_rd,\n  input logic [31:0] ex_data, mem_data, wb_data,\n  output logic [31:0] rs1_data, rs2_data\n);\n  logic e1,m1,w1,r1,e2,m2,w2,r2;\n  always_comb begin\n    e1 = ex_wen && ex_rd \"'!= 0 && ex_rd == rs1_addr;\n    m1 = !e1 && mem_wen && mem_rd != 0 && mem_rd == rs1_addr;\n    w1 = !e1 && !m1 && wb_wen && wb_rd != 0 && wb_rd == rs1_addr;\n    r1 = !e1 && !m1 && !w1;\n    e2 = ex_wen && ex_rd != 0 && ex_rd == rs2_addr;\n    m2 = !e2 && mem_wen && mem_rd != 0 && mem_rd == rs2_addr;\n    w2 = !e2 && !m2 && wb_wen && wb_rd != 0 && wb_rd == rs2_addr;\n    r2 = !e2 && !m2 && !w2;\n    rs1_data = rs1_addr == 0 ? 32'\"'b0 : (ex_data & {32{e1}}) | (mem_data & {32{m1}})\n                | (wb_data & {32{w1}}) | (rf_rs1 & {32{r1}});\n    rs2_data = rs2_addr == 0 ? 32'b0 : (ex_data & {32{e2}}) | (mem_data & {32{m2}})\n                | (wb_data & {32{w2}}) | (rf_rs2 & {32{r2}});\n  end\nendmodule\n''')\np=root/'core.sv';s=p.read_text().replace('  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','''  logic ex_bypass_wen, mem_bypass_wen;\n  logic [4:0] ex_bypass_rd;\n  logic [31:0] ex_bypass_data;\n  logic [31:0] rf_rs1_data_w, rf_rs2_data_w;''')\na=s.index('  reg_file u_rf');b=s.index('  // ── EX',a);s=s[:a]+s[a:b].replace('(rs1_data_w)