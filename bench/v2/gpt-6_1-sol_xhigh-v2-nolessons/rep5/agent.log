{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nwt=Path.cwd();tmp=Path('/srv/hwebench/tmp/89cd5fec/877109d0/branch_chunks_r15')\nfor name in ('branch_copy','branch_copy_preserve','div32'):\n    rtl=tmp/name/'rtl';shutil.copytree(wt/'cores/bench/rtl',rtl,dirs_exist_ok=True)\n    if name.startswith('branch_copy'):\n        p=rtl/'id_stage.sv';s=p.read_text().replace('  output id_ex_t  out\\\\n','  output logic [31:0] branch_rs1,\\\\n  output logic [31:0] branch_rs2,\\\\n  output id_ex_t  out\\\\n')\n        attr='  (* syn_preserve = 1, syn_keep = 1 *) ' if name.endswith('preserve') else '  '\n        ins=attr+'logic [31:0] branch_rs1_q, branch_rs2_q;\\\\n'\n        en='\"'!stall'\"' if name.endswith('preserve') else '\"'!stall && dec_is_branch'\"'\n        ins+=f'''  always_ff @(posedge clock) begin\n    if (reset) begin\n      branch_rs1_q <= 32'b0;\n      branch_rs2_q <= 32'b0;\n    end else if ({en}) begin\n      branch_rs1_q <= rs1_data;\n      branch_rs2_q <= rs2_data;\n    end\n  end\n  assign branch_rs1=branch_rs1_q;\n  assign branch_rs2=branch_rs2_q;\n'''\n        s=s.replace('  assign out = reg_q;\\\\n',ins+'\\\\n  assign out = reg_q;\\\\n');p.write_text(s)\n        p=rtl/'core.sv';s=p.read_text().replace('  // ── IF ─','  logic [31:0] branch_rs1_w, branch_rs2_w;\\\\n\\\\n  // ── IF ─',1)\n        s=s.replace('    .rs2_data (rs2_resolved_w),\\\\n','    .rs2_data (rs2_resolved_w),\\\\n    .branch_rs1(branch_rs1_w),\\\\n    .branch_rs2(branch_rs2_w),\\\\n')\n        s=s.replace('    .in              (id_ex_w),\\\\n','    .in              (id_ex_w),\\\\n    .branch_rs1(branch_rs1_w),\\\\n    .branch_rs2(branch_rs2_w),\\\\n');p.write_text(s)\n        p=rtl/'ex_stage.sv';s=p.read_text().replace('  input  id_ex_t   in,\\\\n','  input  id_ex_t   in,\\\\n  input logic [31:0] branch_rs1, branch_rs2,\\\\n')\n        for old,new in [('(rs1 == rs2)','(branch_rs1 == branch_rs2)'),('(rs1 \"'!= rs2)'\"','(branch_rs1 \"'!= branch_rs2)'\"'),('(\"'$signed(rs1) <  $signed(rs2))'\"','(\"'$signed(branch_rs1) < $signed(branch_rs2))'\"'),('(\"'$signed(rs1) >= $signed(rs2))'\"','(\"'$signed(branch_rs1) >= $signed(branch_rs2))'\"'),('(rs1 <  rs2)','(branch_rs1 < branch_rs2)'),('(rs1 >= rs2)','(branch_rs1 >= branch_rs2)')]:s=s.replace(old,new)\n        p.write_text(s)\n    else:\n        p=rtl/'div_unit.sv';s=p.read_text()\n        s=s.replace('logic [36:0] differences [1:15];','logic [32:0] differences [1:15];').replace(\\\"assign differences[k] = {1'b0, trial} - {1'b0, multiples_q[k]};\\\",\\\"assign differences[k] = {1'b0, trial[31:0]} - {1'b0, multiples_q[k][31:0]};\\\")\n        s=s.replace('assign fits[k] = \"'!differences[k][36];'\"',\\\"assign fits[k] = \"'!(|multiples_q[k][35:32]) && !differences[k][32];\")\n        s=s.replace('\"'{DIGIT, differences[k][35:0]}',\\\"{DIGIT, 4'b0, differences[k][31:0]}\\\")\n        p.write_text(s)\nprint('Three local prototypes created')\nPY\npython -u - <<'PY'\nimport json\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nfrom tools.eval.gowin import build\nwt=Path.cwd();tmp=Path('/srv/hwebench/tmp/89cd5fec/877109d0/branch_chunks_r15')\nnames=('branch_copy','branch_copy_preserve','div32')\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futs={pool.submit(build,wt,tmp/name/'rtl','fpga/core_bench_si.sv',1,tmp/name/'gowin_p1'):name for name in names}\n    for f in as_completed(futs):\n        name=futs[f];r=f.result();(tmp/f'{name}_p1.json').write_text(json.dumps(r,indent=2));print(name,json.dumps(r),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
