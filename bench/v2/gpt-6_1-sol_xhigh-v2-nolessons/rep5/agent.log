{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' tools/eval/_slots.py\nsed -n '1,95p' test/cosim/main.cpp\nsed -n '1,170p' tools/eval/fpga.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' tools/eval/_slots.py\nsed -n '1,95p' test/cosim/main.cpp\nsed -n '1,170p' tools/eval/fpga.py\"", "aggregated_output": "\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\"\n…[10930 of 14002 chars elided by tools/bench/transcript.py; sha256:80682d0f7fa07ce1]…\nd wires; valid for any k (the final measurement uses k > 100).\n    body = \"\".join(f\"  wire w{i} = a[{i % 32}] ^ a[{(i + 1) % 32}];\\n\" for i in range(k))\n    return (\"module zz_calib_pad(input logic [31:0] a, output logic [31:0] y);\\n\"\n            f\"{body}  assign y = a;\\nendmodule\\n\")\n\n\nasync def _synth_variant(k: int, worktree: str, generated_dir: str,\n                         synth_env: dict) -> tuple[str, str | None]:\n    \"\"\"Synthesize perturbation k into <generated_dir>/var<k>/synth.json.\n    Returns (dir, error or None). k=0 reuses the netlist `make` built.\"\"\"\n    if k == 0:\n        return generated_dir, None\n    vdir = f\"{generated_dir}/var{k}\"\n    root = Path(worktree).resolve()\n    (root / vdir).mkdir(parents=True, exist_ok=True)\n    (root / vdir / \"zz_calib_pad.sv\").write_text(pad_module(k))\n    env = {**synth_env, \"GEN_DIR\": vdir, \"SYNTH_PAD\": f\"{vdir}/zz_calib_pad.sv\"}\n    proc = await asyncio.create_subprocess_exec(\n        \"yosys\", \"-q\", \"-l\", f\"{vdir}/synth.log\", \"-c\", \"fpga/scripts/synth.tcl\",\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nscratch=Path('/srv/hwebench/tmp/89cd5fec/4e43c764/predictor_research')\nrtl=scratch/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n(rtl/'branch_compare.sv').write_text('''// Prediction-conditioned, balanced branch comparison.\nmodule branch_compare (\n input logic [31:0] a, b,\n input logic signed_order, ordered_class, condition_invert, error_invert,\n output logic condition, prediction_error\n);\n logic [31:0] ax, bx;\n logic [7:0] leaf_equal, leaf_less;\n logic [3:0] equal1, less1;\n logic [1:0] equal2, less2;\n logic equal3, less3, base_result;\n assign ax = a \"'^ {signed_order,31'\"'b0};\n assign bx = b \"'^ {signed_order,31'\"'b0};\n for (genvar k=0;k<8;k=k+1) begin : leaves\n  assign leaf_equal[k] = ax[k*4+:4] == bx[k*4+:4];\n  assign leaf_less[k] = ax[k*4+:4] < bx[k*4+:4];\n end\n for (genvar k=0;k<4;k=k+1) begin : merge1\n  assign equal1[k] = leaf_equal[2*k+1] && leaf_equal[2*k];\n  assign less1[k] = leaf_less[2*k+1] || (leaf_equal[2*k+1] && leaf_less[2*k]);\n end\n for (genvar k=0;k<2;k=k+1) begin : merge2\n  assign equal2[k] = equal1[2*k+1] && equal1[2*k];\n  assign less2[k] = less1[2*k+1] || (equal1[2*k+1] && less1[2*k]);\n end\n assign equal3 = equal2[1] && equal2[0];\n assign less3 = less2[1] || (equal2[1] && less2[0]);\n assign base_result = ordered_class ? less3 : equal3;\n assign condition = base_result \"'^ condition_invert;\n assign prediction_error = base_result ''^ error_invert;\nendmodule\n'\"''')\np=rtl/'core_pkg.sv';s=p.read_text();needle='  // ID/EX register payload.\\\\n  typedef struct packed {\\\\n';assert s.count(needle)==1;s=s.replace(needle,needle+'    logic branch_ordered, branch_signed, branch_error_invert, branch_recover_eligible;\\\\n');p.write_text(s)\np=rtl/'id_stage.sv';s=p.read_text();needle='    decoded.pc       = in.pc;';assert s.count(needle)==1;s=s.replace(needle,'''    decoded.branch_ordered = dec_branch_op[2];\n    decoded.branch_signed = dec_branch_op[2] && \"'!dec_branch_op[1];\n    decoded.branch_error_invert = dec_branch_op[0] ''^ in.predicted_transfer;\n    decoded.branch_recover_eligible = dec_is_branch && !dec_is_illegal\n                                      && in.direct_target[1:0] == 2'\"'b00;\n'''+needle)\nneedle='      if (\"'!stall) begin'\"\\\\n';assert s.count(needle)==1;s=s.replace(needle,needle+'''        reg_q.branch_ordered <= decoded.branch_ordered;\n        reg_q.branch_signed <= decoded.branch_signed;\n        reg_q.branch_error_invert <= decoded.branch_error_invert;\n''')\nneedle=\\\"        reg_q.valid <= 1'b0;\\\";assert s.count(needle)==1;s=s.replace(needle,needle+\\\"\\\\n        reg_q.branch_recover_eligible <= 1'b0;\\\")\nneedle='        reg_q.valid <= decoded.valid;';assert s.count(needle)==1;s=s.replace(needle,needle+'\\\\n        reg_q.branch_recover_eligible <= decoded.branch_recover_eligible;');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text();begin=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');end=s.index('    branch_taken  =',begin);s=s[:begin]+'''  logic prediction_error;\n  branch_compare u_branch_compare (\n    .a(rs1), .b(rs2), .signed_order(in.branch_signed),\n    .ordered_class(in.branch_ordered), .condition_invert(in.ctrl.branch_op[0]),\n    .error_invert(in.branch_error_invert),\n    .condition(branch_cond), .prediction_error(prediction_error)\n  );\n\n  always_comb begin\n'''+s[end:]\nbegin=s.index('  logic actual_transfer;');end=s.index('  // Only registered instruction kind',begin);s=s[:begin]+'''  logic branch_error, jump_error;\n  assign branch_error = in.branch_recover_eligible && prediction_error;\n  assign jump_error = (in.ctrl.is_jump && \"'!in.ctrl.is_illegal && !misalign_jump)\n                     ''^ (in.predicted_transfer && !in.ctrl.is_branch);\n  assign redirect = in.valid && !stall && !divider_wait\n                    && (branch_error || jump_error);\n'\"'''+s[end:];p.write_text(s)\nprint('Scratch RTL prepared:',rtl)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
