=approx>>span;error=pred16\"'!=c16;errors.append(error)\n   if active:model['\"'s']['all_errors' if error else 'all_correct']+=1\n   prop=(((a\"'^bx)>>low)&((1<<span)-1))==((1<<span)-1)\n   if prop and size:\n    agree=int(lowcarry==bias);model['\"'table'][ix]=min(3,model['table'][ix]+1) if agree else max(0,model['table'][ix]-1)\n  if active:pending=dict(r=r,errors=errors)\n if r['mem_wmask'] and r['mem_addr']==0x10000100:active=True;pending=None;tot.clear()\n if r['mem_wmask'] and r['mem_addr']==0x10000104:break\nprint(json.dumps(dict(totals=tot,oob=cpu.oob_access,seconds=round(time.time()-t,2))))\nfor model in models:print(json.dumps({k:v for k,v in model.items() if k\"'!='\"'table'}))\nprint('TOP',[ (hex(pc),dict(c)) for pc,c in sorted(perpc.items(),key=lambda z:z[1]['dep'],reverse=True)[:20]])\nPY\"", "aggregated_output": "{\"totals\": {\"instructions\": 2922016, \"eligible_arith\": 915184, \"arith_raw_dep\": 236980}, \"oob\": false, \"seconds\": 12.94}\n{\"size\": 0, \"span\": 4, \"s\": {\"all_correct\": 912072, \"dependent_correct\": 234950, \"all_errors\": 3112, \"dependent_errors\": 2030}}\n{\"size\": 0, \"span\": 8, \"s\": {\"all_correct\": 911612, \"dependent_correct\": 233950, \"all_errors\": 3572, \"dependent_errors\": 3030}}\n{\"size\": 0, \"span\": 12, \"s\": {\"all_correct\": 909043, \"dependent_correct\": 230940, \"all_errors\": 6141, \"dependent_errors\": 6040}}\n{\"size\": 16, \"span\": 4, \"s\": {\"all_correct\": 912558, \"dependent_correct\": 235609, \"all_errors\": 2626, \"dependent_errors\": 1371}}\n{\"size\": 16, \"span\": 8, \"s\": {\"all_correct\": 913147, \"dependent_correct\": 235503, \"all_errors\": 2037, \"dependent_errors\": 1477}}\n{\"size\": 16, \"span\": 12, \"s\": {\"all_correct\": 914906, \"dependent_correct\": 236880, \"all_errors\": 278, \"dependent_errors\": 100}}\n{\"size\": 32, \"span\": 4, \"s\": {\"all_correct\": 912124, \"dependent_correct\": 235135, \"all_errors\": 3060, \"dependent_errors\": 1845}}\n{\"size\": 32, \"span\