nder, quotient[31]};\n      difference = trial - {1'b0, divisor};\n      restoring_step = {difference[32] ? trial[31:0] : difference[31:0],\n                        quotient[30:0], !difference[32]};\n    end\n  endfunction\n\n  assign {r1, q1} = restoring_step(quotient_q, remainder_q, divisor_q);\n  assign {r2, q2} = restoring_step(q1, r1, divisor_q);\n  assign {r3, q3} = restoring_step(q2, r2, divisor_q);\n\n…[1556 of 4628 chars elided by tools/bench/transcript.py; sha256:a2ce1c91a0fb0f6c]…\nemainder_q <= (op == ALU_REM || op == ALU_REMU);\n`endif\n      end else if (busy) begin\n`ifndef RISCV_FORMAL_ALTOPS\n        quotient_q <= q4;\n        remainder_q <= r4;\n`endif\n        if (group_q == 3'd7) begin\n          busy <= 1'b0;\n          result_valid <= 1'b1;\n`ifdef RISCV_FORMAL_ALTOPS\n          result <= alt_result_q;\n`else\n          result <= signed_result;\n`endif\n        end else begin\n          group_q <= group_q + 3'd1;\n        end\n      end\n    end\n  end\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 44.18\n  lut4: 3229\n  ff: 600\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261004-001-r2s0\n  updated: '2026-10-04T14:52:22.702734Z'\n", "exit_code": 0, "status": "completed"}}
