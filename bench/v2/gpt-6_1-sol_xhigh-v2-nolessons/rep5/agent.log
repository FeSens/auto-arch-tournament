{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_branch_predictor.py'","aggregated_output":"\"\"\"Agree-table old-state lookup and exactly-once queued training checks.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n@cocotb.test()\nasync def queued_agree_table(dut):\n    counters = [2] * 64\n    pending = None\n\n    async def edge(pc=0, bias=0, event=None, reset=False):\n        nonlocal counters, pending\n        dut.clock.value = 0\n        dut.reset.value = reset\n        dut.lookup_pc.value = pc\n        dut.lookup_bias.value = bias\n        dut.train_valid.value = event is not None\n        dut.train_index.value = event[0] if event else 0\n        dut.train_agree.value = event[1] if event else 0\n        await Timer(5, \"ns\")\n        index = ((pc >> 2) ^ (pc >> 8)) & 63\n        # Even a matching live event must leave the old lookup unchanged.\n        if not reset:\n            assert int(dut.predicted_taken.value) == (bias ^ (counters[index] < 2))\n        dut.clock.value = 1\n        if reset:\n            counters, pending = [2] * 64, None\n        else:\n            if pending is not None:\n                i, agree = pending\n                counters[i] = min(3, counters[i] + 1) if agree else max(0, counters[i] - 1)\n            pending = event\n        await Timer(5, \"ns\")\n        assert int(dut.predicted_taken.value) == (bias ^ (counters[index] < 2))\n\n    await edge(reset=True)\n    # Weak agreement uses each branch's own sign bias at every folded slot.\n    for index in range(64):\n        for bias in (0, 1):\n            await edge(index << 2, bias)\n\n    # Enqueue disagreement at 10: the enqueue edge leaves prediction at\n    # agreement, then the consume edge changes it to disagreement at 01.\n    await edge(4, 1, (1, 0))\n    assert int(dut.predicted_taken.value) == 1\n    await edge(0x100, 1)\n    assert int(dut.predicted_taken.value) == 0  # 4 and 0x100 collide\n    for _ in range(12):\n        await edge(4, 1)  # a queued event cannot train again during holds\n    await edge(4, 1, (1, 1))\n    await edge(4, 1)\n    assert int(dut.predicted_taken.value) == 1\n\n    # Back-to-back same-slot events must saturate the current table state,\n    # rather than updating stale snapshots carried alongside each event.\n    for agree in (1, 0, 1, 0):\n        for _ in range(8):\n            await edge(0x100, 0, (1, agree))\n        await edge(4, 1)\n    # High PC bits and alignment bits do not participate in indexing.\n    await edge(0xFFFF0103, 1)\n    await edge(0x00000100, 0)\n\n    rng = random.Random(0xA6EE)\n    for _ in range(800):\n        pc, bias = rng.getrandbits(32), rng.randrange(2)\n        event = (rng.randrange(64), rng.randrange(2)) if rng.randrange(4) else None\n        await edge(pc, bias, event)\n\n    # Reset cancels a queued disagreement and resets every counter.\n    await edge(event=(0, 0))\n    await edge(reset=True)\n    await edge()\n    for index in range(64):\n        for bias in (0, 1):\n            await edge(index << 2, bias)\n\n\ndef test_branch_predictor_runner():\n    run_cocotb(toplevel=\"branch_predictor\", sources=[\"branch_predictor.sv\"],\n               test_module=\"test_branch_predictor\")\n","exit_code":0,"status":"completed"}}
