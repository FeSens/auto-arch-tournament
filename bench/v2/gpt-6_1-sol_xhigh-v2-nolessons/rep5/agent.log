{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '570,980p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py; head -55 formal/run_all.sh; cat formal/checks_si.cfg\"", "aggregated_output": "\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef _assert_program(rets, program, skipped=()):\n    pcs = [pc for pc in range(0, 4 * len(program), 4) if pc not in skipped]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def divider_dependencies_and_retirement_bound(dut):\n    program = [\n        ADDI(1, 0, 100), ADDI(2, 0, 7),\n        DIV(3, 1, 2), ADD(4, 3, 2), DIVU(5, 4, 2),\n        REM(6, 4, 5), REMU(7, 1, 2), SW(7, 0, 0),\n        ADDI(17, 0, 50), LW(8, 0, 0), DIV(9, 1, 8), BEQ(9, 17, 8),\n        SW(1, 0, 12),  # wrong path must produce no memory request\n        DIVU(10, 9, 8), DIV(11, 10, 8), REM(12, 11, 8),\n        DIV(0, 1, 2), ADD(13, 0, 11), ADDI(14, 0, 8),\n        DIVU(15, 14, 8), LW(16, 15, 0), SW(3, 15, 4), EBREAK(),\n    ]\n    effects = []\n    rets, memory = await _run(dut, program, {4: 123}, side_effects=effects)\n    _assert_program(rets, program, skipped=(48,))\n    expected = {1: 100, 2: 7, 3: 14, 4: 21, 5: 3, 6: 0, 7: 2,\n                8: 2, 9: 50, 10: 25, 11: 12, 12: 0, 13: 12,\n                14: 8, 15: 4, 16: 123, 17: 50}\n    for r in rets:\n        if r[\"rd\"]:\n            assert r[\"rd_wdata\"] == expected[r[\"rd\"]], r\n    [first_div] = _by_insn(rets, DIV(3, 1, 2))\n    assert (first_div[\"rs1_rdata\"], first_div[\"rs2_rdata\"]) == (100, 7)\n    [load_div] = _by_insn(rets, DIV(9, 1, 8))\n    assert (load_div[\"rs1_rdata\"], load_div[\"rs2_rdata\"]) == (100, 2)\n    [discarded] = _by_insn(rets, DIV(0, 1, 2))\n    assert discarded[\"rd\"] == 0 and discarded[\"rd_wdata\"] == 0\n    assert memory == {0: 2, 4: 12\n…[22646 of 25718 chars elided by tools/bench/transcript.py; sha256:df6240a48d3b6ecb]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
