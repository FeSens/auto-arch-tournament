{"type": "item.completed", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/mul_unit.sv'", "aggregated_output": "// Shared RV32M multiplier. Launch captures halfword products directly\n// from registered EX operands. Low MUL completes on that edge; high-half\n// operations spend one busy clock combining the same product bank.\n// Products and completion remain stable until accepted, independently of MEM.\nmodule mul_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        result_valid,\n  output logic [31:0] result,\n  input  logic        result_accept\n);\n  logic select_low_q;\n  logic [31:0] low_result, high_result_q;\n  assign result = select_low_q ? low_result : high_result_q;\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q, launch_result;\n  assign low_result = alt_result_q;\n  always_comb begin\n    case (op)\n      ALU_MUL:    launch_result = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   launch_result = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  launch_result = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: launch_result = (a - b) ^ 32'hecfbe137;\n      default:    launch_result = 32'b0;\n    endcase\n  end\n`else\n  logic signed [16:0] a_hi, b_hi;\n  logic [31:0] p00_comb, p00_q;\n  logic signed [32:0] p01_comb, p10_comb, p01_q, p10_q;\n  // The upper two bits are redundant modulo 2^32 in the high result.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [33:0] p11_comb, p11_q;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [15:0] cross16_q, upper16;\n  logic [33:0] cross_x, cross_y, cross_z, cross_sum, cross_carry;\n  // High-half arithmetic needs the low bits for their carry only.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [33:0] cross_term;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] high_result;\n\n  assign a_hi = {(op == ALU_MULH || op == ALU_MULHSU) && a[31], a[31:16]};\n  assign b_hi = {(op == ALU_MULH) && b[31], b[31:16]};\n  assign p00_comb = a[15:0] * b[15:0];\n  assign p01_comb = $signed({1'b0, a[15:0]}) * b_hi;\n  assign p10_comb = a_hi * $signed({1'b0, b[15:0]});\n  assign p11_comb = a_hi * b_hi;\n\n  // The launch sum uses the very same DSP products captured below.\n  // Forwarding sees only registered products and one sixteen-bit sum.\n  assign upper16 = cross16_q + p00_q[31:16];\n  assign low_result = {upper16, p00_q[15:0]};\n\n  // One carry-save layer, followed by one 34-bit carry-propagate sum.\n  // Keep both the signed cross products and the p00 carry at full width.\n  assign cross_x = {p01_q[32], p01_q};\n  assign cross_y = {p10_q[32], p10_q};\n  assign cross_z = {18'b0, p00_q[31:16]};\n  assign cross_sum = cross_x ^ cross_y ^ cross_z;\n  assign cross_carry = ((cross_x & cross_y) | (cross_x & cross_z)\n                      | (cross_y & cross_z)) << 1;\n  assign cross_term = $signed(cross_sum + cross_carry);\n  assign high_result = p11_q[31:0]\n                     + {{14{cross_term[33]}}, cross_term[33:16]};\n`endif\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      busy <= 1'b0;\n      result_valid <= 1'b0;\n      select_low_q <= 1'b0;\n      high_result_q <= 32'b0;\n`ifdef RISCV_FORMAL_ALTOPS\n      alt_result_q <= 32'b0;\n`else\n      cross16_q <= 16'b0;\n      p00_q <= 32'b0;\n      p01_q <= 33'sb0;\n      p10_q <= 33'sb0;\n      p11_q <= 34'sb0;\n`endif\n    end else begin\n      if (result_accept) result_valid <= 1'b0;\n      // Acceptance and a new launch can share an edge without rearming.\n      if (start && !busy && (!result_valid || result_accept)) begin\n        busy <= (op != ALU_MUL);\n        result_valid <= (op == ALU_MUL);\n        select_low_q <= (op == ALU_MUL);\n`ifdef RISCV_FORMAL_ALTOPS\n        alt_result_q <= launch_result;\n`else\n        p00_q <= p00_comb;\n        p01_q <= p01_comb;\n        p10_q <= p10_comb;\n        p11_q <= p11_comb;\n        cross16_q <= p01_comb[15:0] + p10_comb[15:0];\n`endif\n      end else if (busy) begin\n        busy <= 1'b0;\n        result_valid <= 1'b1;\n`ifdef RISCV_FORMAL_ALTOPS\n        high_result_q <= alt_result_q;\n`else\n        high_result_q <= high_result;\n`endif\n      end\n    end\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
