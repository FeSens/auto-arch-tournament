{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\nfrom pathlib import Path\nimport json,jsonschema,yaml\n# Check the proposed split-register transition against the current whole-\n# bundle register for every control combination, comparing architectural\n# payloads whenever valid and requiring zero side-effect controls otherwise.\ncases=0\nfor old_valid, reset, flush, stall, fetched_valid in product((0,1),repeat=5):\n old_payload=7 if old_valid else 0\n old_control=13 if old_valid else 0\n decoded_payload,decoded_control=19,23\n if reset or flush:\n  ov,op,oc=0,0,0\n elif stall:\n  ov,op,oc=old_valid,old_payload,old_control\n elif fetched_valid:\n  ov,op,oc=1,decoded_payload,decoded_control\n else:\n  ov,op,oc=0,0,0\n if reset:\n  nv,np,nc=0,0,0\n else:\n  np=old_payload if stall else decoded_payload\n  if flush: nv,nc=0,0\n  elif stall: nv,nc=old_valid,old_control\n  elif fetched_valid: nv,nc=1,decoded_control\n  else: nv,nc=0,0\n assert (nv,nc)==(ov,oc)\n assert not nv or np==op\n assert nv or nc==0\n cases+=1\n# The raw-readiness hazard differs only if a correcting instruction could\n# simultaneously be an EX load. Direct-instruction prediction forbids that.\nhazard_cases=0\nfor ready,correct,ex_load,tags_match in product((0,1),repeat=4):\n if correct and ex_load: continue\n old=ready and not correct and ex_load and tags_match\n new=ready and ex_load and tags_match\n assert old==new\n hazard_cases+=1\np=Path('cores/bench/experiments/hypotheses/hyp-20261004-003-r9s2.yaml')\nh=yaml.safe_load(p.read_text())\njsonschema.validate(h,json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nassert h['id']=='hyp-20261004-003-r9s2' and h['category']=='predictor'\nassert type(h['expected_impact']['fitness_delta_pct']) is int\nassert -50<=h['expected_impact']['fitness_delta_pct']<=50\nassert all(c['file'].startswith(('rtl/','test/test_')) for c in h['changes'])\nprint('Sc