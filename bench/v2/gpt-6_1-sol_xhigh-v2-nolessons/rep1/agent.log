{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_div_unit.py; cat cores/bench/test/test_ex_divider.py'", "aggregated_output": "\"\"\"Tests of the registered divider, including the identical ALTOPS schedule.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, RTL, SIM_BUILD, TEST_DIR\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nRUN_CLOCKS = 6\nALTOPS = bool(int(os.environ.get(\"DIV_ALTOPS\", \"0\")))\n\n\ndef reference(op, a, b):\n    a, b = a & MASK, b & MASK\n    if ALTOPS:\n        salt = {ALU_DIV: 0x7f8529ec, ALU_DIVU: 0x10e8fd70,\n                ALU_REM: 0x8da68fa5, ALU_REMU: 0x3138d0e1}[op]\n        return ((a - b) ^ salt) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK\n    return (a % b if op == ALU_REMU else a // b) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.start.value = 0\n    dut.consume.value = 0\n    dut.op.value = ALU_DIVU\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.reset.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert int(dut.busy.value) == 0\n    assert int(dut.result_valid.value) == 0\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK\n    dut.b.value = b & MASK\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    dut.consume.value = 0\n    assert int(dut.busy.value) == 1\n    assert int(dut.result_valid.value) == 0\n\n\nasync def finish(dut, op, a, b, delay=0):\n    expected = reference(op, a, b)\n    for elapsed in range(1, RUN_CLOCKS + 1):\n        # Inputs and even rejected starts can change after acceptance.\n        dut.a.value = (a ^ (elapsed * 0x102\n…[21686 of 24758 chars elided by tools/bench/transcript.py; sha256:20cbade55116cd44]…\ndut.div_wait.value) == 0\n                await tick(dut)  # Exactly one EX/MEM publication after acceptance.\n                out = unpack(EX_MEM, int(dut.out.value))\n                for name, value in dict(valid=1, alu_result=expected, pc=pc,\n                                        pc_next=pc + 4, rd=3, instr=instr,\n                                        rs1_addr=1, rs2_addr=2, rs1_val=a,\n                                        rs2_val=b, write_data=b,\n                                        ctrl=pack(CTRL, dict(alu_op=op, reg_write=1))).items():\n                    assert out[name] == value, f\"captured {name} changed\"\n                dut[\"in\"].value = 0\n                for _ in range(2):\n                    await tick(dut)\n                    assert unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0, \"duplicate issue\"\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"div_unit.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n", "exit_code": 0, "status": "completed"}}
