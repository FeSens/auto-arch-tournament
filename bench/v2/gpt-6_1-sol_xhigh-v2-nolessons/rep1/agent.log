{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '560,1100p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "            assert current[1] - previous[1] == 9, \"consecutive divides changed schedule\"\n    for seed in (7, 0xD181DE):\n        await _run_div_program(dut, program, pcs, seed=seed)\n\n\n@cocotb.test()\nasync def redirects_immediately_to_divide_preserve_ten_cycle_bound(dut):\n    program = [\n        ADDI(1, 0, -10), ADDI(2, 0, 3),\n        BEQ(0, 0, 12), DIV(0, 1, 0), SW(1, 0, 0x200),\n        REM(3, 1, 2),  # branch target: negative final-pair remainder\n        JAL(4, 12), DIV(0, 1, 0), SW(1, 0, 0x204),\n        DIVU(5, 4, 2),  # jump target depends on the captured link value\n        ADDI(11, 0, 56), JALR(12, 11, 0),\n        REM(0, 1, 0), SW(1, 0, 0x208),\n        REMU(6, 12, 2), DIV(7, 3, 2),\n        SW(6, 0, 0x100), LW(8, 0, 0x100), DIVU(9, 8, 2), EBREAK(),\n    ]\n    pcs = [i * 4 for i in range(len(program)) if i not in (3, 4, 7, 8, 12, 13)]\n    rets = await _run_div_program(dut, program, pcs)\n    for previous, current in zip(rets, rets[1:]):\n        if previous[0] in (8, 24, 44):\n            assert current[1] - previous[1] == 10, \"redirect-to-divide recovery schedule\"\n    for seed in (1, 19, 181):\n        await _run_div_program(dut, program, pcs, seed=seed)\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Orde