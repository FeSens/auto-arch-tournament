{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"sed -n '670,750p' cores/bench/generated/hypgen_r11s0/test/test_pipeline.py\"","aggregated_output":"    rets = await _run_div_program(dut, program, pcs, memory)\n    cycles = dict(rets)\n    for load_pc in (8, 16, 24, 32, 40):\n        assert cycles[load_pc + 4] - cycles[load_pc] == 2, \"operand load-use interlock changed\"\n    assert cycles[60] - cycles[56] == 1, \"x0 created a load interlock\"\n    assert cycles[52] - cycles[48] == 9, \"registered load-to-divide schedule changed\"\n    for seed in (1, 19, 181):\n        await _run_div_program(dut, program, pcs, memory, seed=seed)\n\n\n@cocotb.test()\nasync def extended_loads_and_all_multiply_interlocks(dut):\n    # Cover every byte lane, both aligned halfwords, all extension modes,\n    # both MUL sources, and competing older WB / younger MEM writers.\n    program = [ADDI(2, 0, -3)]\n    pairs = []\n    for funct3, offsets in ((0, range(4)), (4, range(4)),\n                            (1, (0, 2)), (5, (0, 2)), (2, (0,))):\n        for offset in offsets:\n            program += [ADDI(1, 0, 17), LOAD(1, 0, 0x100 + offset, funct3), ADD(3, 1, 2)]\n            pairs.append((len(program) * 4 - 8, 2))\n            for mul in (MUL, MULH, MULHU, MULHSU):\n                program += [ADDI(1, 0, 19), LOAD(1, 0, 0x100 + offset, funct3), mul(4, 1, 2)]\n                pairs.append((len(program) * 4 - 8, 2))\n                program += [LOAD(1, 0, 0x100 + offset, funct3), mul(5, 2, 1)]\n                pairs.append((len(program) * 4 - 8, 2))\n    # x0 never interlocks or supplies a loaded value to multiplication.\n    pairs.append((len(program) * 4, 1))\n    program += [LW(0, 0, 0x100), MUL(6, 0, 2), ADDI(1, 0, -1), MULH(7, 1, 2)]\n    for mul, rd in ((MUL, 0), (MULHSU, 6)):\n        pairs.append((len(program) * 4, 2))\n        program += [LW(1, 0, 0x100), mul(rd, 1, 1)]\n    program += [EBREAK()]\n    pcs = list(range(0, len(program) * 4, 4))\n    memory = {0x100: 0x80ff7f01}\n    rets = await _run_div_program(dut, program, pcs, memory)\n    cycles = dict(rets)\n    for pc, gap in pairs:\n        assert cycles[pc + 4] - cycles[pc] == gap, f\"load consumer at {pc + 4} changed schedule\"\n    for seed in (7, 181):\n        await _run_div_program(dut, program, pcs, memory, seed=seed)\n\n\n@cocotb.test()\nasync def illegal_multiply_encoding_never_interlocks(dut):\n    illegal = _r(2, 1, 1, 0, 3, 0x33)\n    program = [ADDI(1, 0, 7), LW(1, 0, 0x100), illegal, ADD(4, 1, 1), EBREAK()]\n    rets, _ = await _run(dut, program, {0x100: 17})\n    load, bad = rets[1:3]\n    assert bad[\"trap\"] == 1 and bad[\"rd\"] == 0 and bad[\"rd_wdata\"] == 0\n    assert bad[\"cycle\"] - load[\"cycle\"] == 1, \"reserved encoding created a MUL interlock\"\n    assert rets[3][\"rd_wdata\"] == 34\n\n\n@cocotb.test()\nasync def misaligned_load_never_becomes_a_forwarding_writer(dut):\n    program = [ADDI(1, 0, 7), LW(1, 0, 0x101), ADD(2, 1, 1),\n               LW(1, 0, 0x101), MUL(3, 1, 2), EBREAK()]\n    rets, memory = await _run(dut, program, {0x100: 0xdeadbeef})\n    for index in (1, 3):\n        assert rets[index][\"trap\"] == 1 and rets[index][\"rd\"] == 0\n        assert rets[index][\"mem_rmask\"] == 0 and rets[index][\"mem_wmask\"] == 0\n    assert rets[2][\"rs1_rdata\"] == rets[2][\"rs2_rdata\"] == 7\n    assert rets[2][\"rd_wdata\"] == 14\n    assert rets[4][\"rs1_rdata\"] == 7 and rets[4][\"rs2_rdata\"] == 14\n    assert rets[4][\"rd_wdata\"] == 98\n    assert memory == {0x100: 0xdeadbeef}\n\n\n@cocotb.test()\nasync def reset_kills_held_payload_and_stale_unavailable_words(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 0\n    dut.io_dmemRData.value = 0xdeadbeef\n    dut.io_imemData.value = NOP()\n\n    async def tick():\n        dut.clock.value = 0\n        await Timer(5, unit=\"ns\")\n","exit_code":0,"status":"completed"}}
