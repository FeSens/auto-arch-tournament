{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\np=Path('/srv/hwebench/tmp/e4e97874/eddcfbf2/predictor_research/coremark.trace')\ntrace=[]\nm=Counter()\nfor line in p.open():\n if not line.startswith('TRACE '):\n  if 'bench_start_cycle' in line: print(line.strip())\n  continue\n _,cycle,pc,insn,nxt,a,b = line.split()\n cycle,pc,insn,nxt,a,b = map(int,(cycle,pc,insn,nxt,a,b))\n if insn&127 \"'!= 99:\n  m[(insn&127,(insn>>12)&7)] += 1\n  continue\n f=(insn>>12)&7\n sa=a-(1<<32) if a>>31 else a\n sb=b-(1<<32) if b>>31 else b\n taken={0:a==b,1:a!=b,4:sa<sb,5:sa>=sb,6:a<b,7:a>=b}[f]\n trace.append((pc,insn,taken))\nprint('\"'Branches',len(trace),'Other control/M ops',dict(m))\nfor n in (16,32,64,128,256):\n for agree in (False,True):\n  cs=[2]*n; miss=0\n  for pc,insn,t in trace:\n   ix=((pc>>2)\"'^(pc>>8))&(n-1)\n   bias=bool(insn>>31)\n   pred=cs[ix]>=2\n   if agree: pred=pred==bias\n   miss+=pred!=t\n   outcome=(t==bias) if agree else t\n   cs[ix]=max(0,min(3,cs[ix]+(1 if outcome else -1)))\n  print('\"'agree' if agree else 'bimodal',n,miss)\nfor bits in (4,5,6,7,8):\n cs=[2]*(1<<bits); mask=(1<<bits)-1; h=0; miss=0\n for pc,insn,t in trace:\n  ix=(((pc>>2)\"'^(pc>>8))''^h)&mask\n  pred=cs[ix]>=2\n  miss+=pred!=t\n  cs[ix]=max(0,min(3,cs[ix]+(1 if t else -1)))\n  h=((h<<1)|t)&mask\n print('\"'gshare',1<<bits,miss)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
