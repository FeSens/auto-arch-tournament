value = 0\n    dut.consume.value = 0\n    assert int(dut.busy.value) == 1\n    assert int(dut.result_valid.value) == 0\n\n\nasync def finish(dut, op, a, b, delay=0):\n    expected = reference(op, a, b)\n    for elapsed in range(1, RUN_CLOCKS + 1):\n        # Inputs and even rejected starts can change after acceptance.\n        dut.a.value = (a ^ (elapsed * 0x102\n…[9662 of 12734 chars elided by tools/bench/transcript.py; sha256:fe0fd36e3f6172a7]…\n(a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: alt_q <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM: alt_q <= (a - b) ^ 32'h8da68fa5;\n        ALU_REMU: alt_q <= (a - b) ^ 32'h3138d0e1;\n        default: alt_q <= 0;\n      endcase\n`else\n      quotient_q <= {magnitude_low, prefix_quotient};\n      remainder_q <= {30'd0, prefix_remainder};\n      divisor_q <= negative_b ? (32'd0 - b) : b;\n      quotient_neg_q <= signed_op && (a[31] ^ b[31]) && b != 0;\n      remainder_neg_q <= negative_a;\n      select_rem_q <= op == ALU_REM || op == ALU_REMU;\n`endif\n    end else begin\n      case (state_q)\n        RUN: begin\n`ifndef RISCV_FORMAL_ALTOPS\n          if (group_q == 0)\n            triple_divisor_q <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\n          quotient_q <= run_q[4];\n          remainder_q <= run_r[4];\n`endif\n          if (group_q == 6) state_q <= READY;\n          else group_q <= group_q + 1'b1;\n        end\n        READY: if (consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
