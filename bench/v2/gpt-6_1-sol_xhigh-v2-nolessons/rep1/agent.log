{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/e4e97874/67486842/r12cmp')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(src,rtl/src.name)\ncmp='''module branch_compare (\n  input logic [31:0] a, b,\n  output logic equal, less_unsigned, less_signed\n);\n  logic [7:0] eq4, lt4;\n  logic [3:0] eq8, lt8;\n  logic [1:0] eq16, lt16;\n  for (genvar i=0; i<8; i++) begin : g_nibble\n    assign eq4[i] = a[4*i +: 4] == b[4*i +: 4];\n    assign lt4[i] = a[4*i +: 4] < b[4*i +: 4];\n  end\n  for (genvar i=0; i<4; i++) begin : g_byte\n    assign eq8[i] = eq4[2*i+1] & eq4[2*i];\n    assign lt8[i] = lt4[2*i+1] | (eq4[2*i+1] & lt4[2*i]);\n  end\n  for (genvar i=0; i<2; i++) begin : g_half\n    assign eq16[i] = eq8[2*i+1] & eq8[2*i];\n    assign lt16[i] = lt8[2*i+1] | (eq8[2*i+1] & lt8[2*i]);\n  end\n  assign equal = eq16[1] & eq16[0];\n  assign less_unsigned = lt16[1] | (eq16[1] & lt16[0]);\n  assign less_signed = (a[31] \"'^ b[31]) ? a[31] : less_unsigned;\nendmodule\n'\"'''\n(rtl/'branch_compare.sv').write_text(cmp)\np=rtl/'ex_stage.sv'\ns=p.read_text()\ns=s.replace('  logic        branch_cond;', '''  logic        branch_equal, branch_less_u, branch_less_s;\n  branch_compare u_branch_compare (\n    .a(rs1), .b(rs2), .equal(branch_equal),\n    .less_unsigned(branch_less_u), .less_signed(branch_less_s)\n  );\n  logic        branch_cond;''')\nfor old,new in [('(rs1 == rs2)','branch_equal'),('(rs1 \"'!= rs2)'\"','\"'!branch_equal'\"'),('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_less_s'),('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!branch_less_s'\"'),('(rs1 <  rs2)','branch_less_u'),('(rs1 >= rs2)','\"'!branch_less_u'\"')]:\n assert old in s,old\n s=s.replace(old,new)\np.write_text(s)\nwrapper='''module compare_proof(input [31:0] a,b, output ok);\nwire eq,lu,ls;\nbranch_compare dut(a,b,eq,lu,ls);\nassign ok=(eq==(a==b)) && (lu==(a<b)) && (ls==(\"'$signed(a)<$signed(b)));\nendmodule\n'\"'''\n(base/'compare_proof.sv').write_text(wrapper)\nprint(base)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
