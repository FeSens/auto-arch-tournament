{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM=(1<<32)-1\nrng=random.Random(0x1707)\ndef compare(x,d):\n pairs=[((x>>(4*i)&15)==(d>>(4*i)&15),(x>>(4*i)&15)>(d>>(4*i)&15)) for i in range(8)]\n while len(pairs)>1:\n  pairs=[(hi[0] and lo[0], hi[1] or (hi[0] and lo[1])) for lo,hi in zip(pairs[::2],pairs[1::2])]\n eq,gt=pairs[0]\n return bool((x>>32) or gt or eq)\ncases=[(rng.getrandbits(33),rng.getrandbits(32)) for _ in range(100000)]\nfor k in range(0,32,4):\n for d in (0,1,(1<<k)-1,1<<k,(1<<k)+1,M):\n  for x in (0,d,max(0,d-1),d+1,1<<32,(1<<33)-1): cases.append((x,d))\nfor x,d in cases: assert compare(x,d)==(x>=d),(x,d)\nprint('Balanced comparison matches unsigned 33-bit reference:',len(cases),'cases')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM=(1<<32)-1\nrng=random.Random(0x1707)\ndef compare(x,d):\n pairs=[((x>>(4*i)&15)==(d>>(4*i)&15),(x>>(4*i)&15)>(d>>(4*i)&15)) for i in range(8)]\n while len(pairs)>1:\n  pairs=[(hi[0] and lo[0], hi[1] or (hi[0] and lo[1])) for lo,hi in zip(pairs[::2],pairs[1::2])]\n eq,gt=pairs[0]\n return bool((x>>32) or gt or eq)\ncases=[(rng.getrandbits(33),rng.getrandbits(32)) for _ in range(100000)]\nfor k in range(0,32,4):\n for d in (0,1,(1<<k)-1,1<<k,(1<<k)+1,M):\n  for x in (0,d,max(0,d-1),d+1,1<<32,(1<<33)-1): cases.append((x,d))\nfor x,d in cases: assert compare(x,d)==(x>=d),(x,d)\nprint('Balanced comparison matches unsigned 33-bit reference:',len(cases),'cases')\nPY\"","aggregated_output":"Balanced comparison matches unsigned 33-bit reference: 100288 cases\n","exit_code":0,"status":"completed"}}
