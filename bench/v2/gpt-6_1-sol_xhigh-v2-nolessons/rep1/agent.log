{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\ncode='''import os,random\nimport cocotb\nfrom cocotb.triggers import Timer\nMASK=0xffffffff\nOPS=(11,12,13,14)\nSALTS={11:0x5876063e,12:0xf6583fb7,13:0x949ce5e8,14:0xecfbe137}\ndef signed(a): return a if a < 0x80000000 else a - (1 << 32)\n@cocotb.test()\nasync def products(dut):\n    separate=bool(int(os.environ.get(\\\"SEPARATE\\\",\\\"0\\\")))\n    altops=bool(int(os.environ.get(\\\"ALTOPS\\\",\\\"0\\\")))\n    rng=random.Random(771915)\n    corners=(0,1,2,3,0xffff,0x10000,0x1ffff,0x20000,0x3ffff,0x40000,0x7fffffff,0x80000000,0x80000001,0xfffffffe,MASK)\n    pairs=[(a,b) for a in corners for b in corners]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(4000)]\n    for a,b in pairs:\n        for op in OPS:\n            dut.op.value=op\n            dut.a.value=(a \"'^ MASK) if separate else a\n            dut.b.value=(b ''^ MASK) if separate else b\n            dut.mul_a.value=a if separate else (a ''^ MASK)\n            dut.mul_b.value=b if separate else (b ''^ MASK)\n            if altops:\n                expected=((a-b if op==14 else a+b)''^SALTS[op]) & MASK\n            elif op==11: expected=(a*b)&MASK\n            elif op==12: expected=((signed(a)*signed(b))>>32)&MASK\n            elif op==13: expected=((a*b)>>32)&MASK\n            else: expected=((signed(a)*b)>>32)&MASK\n            await Timer(1,unit=\"ns\")\n            actual=int(dut.out.value)\n            assert actual==expected,(op,hex(a),hex(b),hex(expected),hex(actual))\n'\"'''\nfor name in ('shared_mul33','shared_mul_unsigned'):\n base=Path('cores/bench/generated')/('r15_'+name)\n (base/'test_r15_products.py').write_text(code)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
