t = \"'$unsigned(mul_ss[63:32])'\"','out = product[63:32]').replace('out = mul_uu[63:32]','out = product[63:32]').replace('out = \"'$unsigned(mul_su[63:32])'\"','out = product[63:32]')\np.write_text(s)\nPY\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
