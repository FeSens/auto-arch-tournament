,\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[7285 of 10357 chars elided by tools/bench/transcript.py; sha256:c293f60f19a9ea33]…\nalu_op == ALU_REMU);\n  // Launch only when the older MEM instruction advances. The forwarded\n  // inputs and their RVFI payload are captured together at this edge.\n  assign div_start = is_div && !div_active_q && !div_busy && !stall && !reset;\n  assign div_consume = div_active_q && div_result_valid && !stall && !reset;\n  assign div_wait = (is_div || div_active_q) && !div_consume;\n\n  div_unit u_div (\n    .clock (clock),\n    .reset (reset),\n    .start (div_start),\n    .op (in.ctrl.alu_op),\n    .a (rs1),\n    .b (rs2),\n1:\"\"\"Tests of the registered divider, including the identical ALTOPS schedule.\"\"\"\n17:ALTOPS = bool(int(os.environ.get(\"DIV_ALTOPS\", \"0\")))\n22:    if ALTOPS:\n45:async def reset(dut):\n51:    dut.reset.value = 1\n53:    dut.reset.value = 0\n111:    await reset(dut)\n134:    await reset(dut)\n149:async def reset_aborts_every_phase(dut):\n150:    await reset(dut)\n155:        await reset(dut)\n170:        args.append(\"+define+RISCV_FORMAL_ALTOPS\")\n176:                extra_env={\"DIV_ALTOPS\": str(int(altops))})\n", "exit_code": 0, "status": "completed"}}
