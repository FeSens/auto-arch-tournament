d;\n  logic equal_hi, equal_lo, less_hi, less_lo;\n  assign equal_hi = in.branch_equal_bytes[3] & in.branch_equal_bytes[2];\n  assign equal_lo = in.branch_equal_bytes[1] & in.branch_equal_bytes[0];\n  assign less_hi = in.branch_less_bytes[3] | (in.branch_equal_bytes[3] & in.branch_less_bytes[2]);\n  assign less_lo = in.branch_less_bytes[1] | (in.branch_equal_bytes[1] & in.branch_less_bytes[0]);\n  assign branch_equal = equal_hi & equal_lo;\n  assign branch_less_unsigned = less_hi | (equal_hi & less_lo);\n  assign branch_less_signed = (in.branch_sign1 \"'^ in.branch_sign2) ? in.branch_sign1 : branch_less_unsigned;\n'\"'''\ns=s.replace(tag,insert+tag)\nfor old,new in [('(rs1 == rs2)','branch_equal'),('(rs1 \"'!= rs2)'\"','\"'!branch_equal'\"'),('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_less_signed'),('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!branch_less_signed'\"'),('(rs1 <  rs2)','branch_less_unsigned'),('(rs1 >= rs2)','\"'!branch_less_unsigned'\"')]:\n assert old in s,old; s=s.replace(old,new)\np.write_text(s)\np=scratch/'test/test_ex_divider.py'; s=p.read_text(); s=s.replace('         (\\\"instr\\\", 32), (\\\"predicted_taken\\\", 1), (\\\"valid\\\", 1)]','         (\\\"branch_equal_bytes\\\", 4), (\\\"branch_less_bytes\\\", 4),\\\\n         (\\\"branch_sign1\\\", 1), (\\\"branch_sign2\\\", 1),\\\\n         (\\\"instr\\\", 32), (\\\"predicted_taken\\\", 1), (\\\"valid\\\", 1)]',1)\ns=s.replace('    values.update(updates)\\\\n    return pack(ID_EX, values)','''    values.update(updates)\n    a,b = values['rs1_val'],values['rs2_val']\n    values.update(branch_equal_bytes=sum(((((a>>(8*k))&255)==((b>>(8*k))&255))<<k) for k in range(4)),\n                  branch_less_bytes=sum(((((a>>(8*k))&255)<((b>>(8*k))&255))<<k) for k in range(4)),\n                  branch_sign1=(a>>31)&1,branch_sign2=(b>>31)&1)\n    return pack(ID_EX, values)''');p.write_text(s)\nprint('Scratch branch-comparison RTL and test copies prepared:',scratch)\nPY\nverilator --lint-only -Wall -Wn