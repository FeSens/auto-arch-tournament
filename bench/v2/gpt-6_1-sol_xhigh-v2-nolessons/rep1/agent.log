p[bit_step][30:0], quotient_step[bit_step][31]}\n      : difference[bit_step][31:0];\n    assign quotient_step[bit_step+1] =\n      {quotient_step[bit_step][30:0], !difference[bit_step][32]};\n  end\n  // Correct both final values in parallel before selecting the operation.\n  // Group six has only two dividend bits left; the registered state still\n  // contains the intermediate values after bit 30 at this edge.\n  assign quotient_signed = quoti\n…[1594 of 4666 chars elided by tools/bench/transcript.py; sha256:d02c5142980ebdbf]…\ndef RISCV_FORMAL_ALTOPS\n            result <= alt_q;\n`else\n            result <= select_rem_q ? remainder_signed : quotient_signed;\n`endif\n            state_q <= DONE;\n          end else begin\n`ifndef RISCV_FORMAL_ALTOPS\n            quotient_q <= quotient_step[5];\n            remainder_q <= remainder_step[5];\n`endif\n            group_q <= group_q + 3'd1;\n          end\n        end\n        DONE: if (consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\nformal/run_all.sh:128:# file exists, is over 10 minutes old, and nobody holds it. A dir with no\nformal/run_all.sh:138:        [ -n \"$(find \"$lock\" -mmin +10 2>/dev/null)\" ] || continue\nformal/checks_si.cfg:11:reg       10  20\nformal/checks_si.cfg:12:pc_fwd    10  20\nformal/checks_si.cfg:13:pc_bwd    10  20\nformal/checks_si.cfg:14:causal    10  20\nformal/checks_si.cfg:18:# liveness — CPU makes forward progress under any symbolic stream\nformal/checks_si.cfg:19:unique     1 10 20\nformal/checks_si.cfg:22:liveness   1 10 20\n", "exit_code": 0, "status": "completed"}}
