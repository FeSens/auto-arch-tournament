{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK32 = (1 << 32) - 1\nMASK35 = (1 << 35) - 1\ndigits_seen = set()\n\ndef radix4(n, d):\n    if not d:\n        return MASK32, n\n    q = r = 0\n    ds = (d, 2*d, 3*d)\n    assert ds[-1] < (1 << 34)\n    for shift in range(30, -1, -2):\n        t = (r << 2) | ((n >> shift) & 3)\n        trials = [(t - x) & MASK35 for x in ds]\n        digit = next((k for k in (3, 2, 1) if not (trials[k-1] >> 34)), 0)\n        r = (trials[digit-1] if digit else t) & MASK32\n        q = ((q << 2) | digit) & MASK32\n        assert r < d\n        digits_seen.add(digit)\n    return q, r\n\ndef as_signed(x):\n    return x - (1 << 32) if x >> 31 else x\n\ndef check(a, b):\n    uq, ur = radix4(a, b)\n    assert (uq, ur) == (divmod(a, b) if b else (MASK32, a))\n    sa, sb = as_signed(a), as_signed(b)\n    mq, mr = radix4(abs(sa), abs(sb))\n    if not b:\n        sq, sr = MASK32, a\n        eq, er = MASK32, a\n    else:\n        sq = (-mq if (sa < 0) \"'!= (sb < 0) else mq) & MASK32\n        sr = (-mr if sa < 0 else mr) & MASK32\n        eq = abs(sa) // abs(sb)\n        eq = -eq if (sa < 0) != (sb < 0) else eq\n        er = sa - eq * sb\n        eq, er = eq & MASK32, er & MASK32\n        assert ((sq * b + sr) & MASK32) == a\n        assert abs(as_signed(sr)) < abs(sb)\n    assert (sq, sr) == (eq, er)\n\nedges = [0, 1, 2, 3, 4, 7, 15, 16, 0x3fffffff, 0x40000000,\n         0x40000001, 0x7fffffff, 0x80000000, 0x80000001,\n         0xfffffffc, 0xfffffffd, 0xfffffffe, 0xffffffff]\nfor a in edges:\n    for b in edges:\n        check(a, b)\nrng = random.Random(20261004)\nfor _ in range(50000):\n    check(rng.getrandbits(32), rng.getrandbits(32))\nassert digits_seen == {0, 1, 2, 3}\nprint(f'\"'Algorithm audit passed: {len(edges)**2 + 50000} operand pairs, unsigned and signed divmod, 35-bit borrow selection, remainder bounds, and all four quotient digits. This is a mathematical model check, not an RTL or FPGA measurement.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
