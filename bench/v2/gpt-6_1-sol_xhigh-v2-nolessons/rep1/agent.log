{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py; sed -n '180,440p' cores/bench/test/test_ex_divider.py; sed -n '300,340p' cores/bench/test/test_pipeline.py; sed -n '802,916p' cores/bench/test/test_pipeline.py; sed -n '1200,1240p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\n@cocotb.test()\nasync def multiply_uses_registered_sources_even_with_live_load(dut):\n    # Deliberately present a live load unlike either registered source.\n    # Even invalid/stall\n…[16022 of 19094 chars elided by tools/bench/transcript.py; sha256:eeaf9097b30f7521]…\n100), EBREAK()]\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"core\"\n    runner.build(\n        hdl_toplevel=\"core\",\n        sources=[str(RTL / source) for source in [\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"operand_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ]],\n        build_dir=str(build_dir), always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\", f\"+incdir+{RTL}\"],\n    )\n    runner.test(\n        hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n        test_dir=str(TEST_DIR), build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
