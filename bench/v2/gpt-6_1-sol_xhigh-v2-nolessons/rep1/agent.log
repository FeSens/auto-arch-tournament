{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK = (1 << 32) - 1\nWIDE_MASK = (1 << 35) - 1\n\ndef proposed(a, d):\n    q, r = a, 0\n    multiples = (d, 2*d, 3*d)\n    for group in range(4):\n        for step in range(4):\n            trial = (r << 2) | (q >> 30)\n            differences = [(trial-m) & WIDE_MASK for m in multiples]\n            ok1, ok2, ok3 = [not (v >> 34) for v in differences]\n            digit = (int(ok2) << 1) | int(ok3 or (ok1 and not ok2))\n            masks = (not ok1, ok1 and not ok2, ok2 and not ok3, ok3)\n            assert sum(masks) == 1\n            r = 0\n            for enable, value in zip(masks, (trial, *differences)):\n                if enable:\n                    r |= value & MASK\n            q = ((q << 2) | digit) & MASK\n            assert d == 0 or r < d\n    return q, r\n\ncorners = (0, 1, 2, 3, 4, 7, 15, 16, 17, (1<<30)-1, 1<<30,\n           (1<<30)+1, (1<<31)-1, 1<<31, (1<<31)+1, MASK-1, MASK)\npairs = [(a,d) for a in corners for d in corners]\nrng = random.Random(0x20261004)\npairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(20000))\nfor a,d in pairs:\n    expect = divmod(a,d) if d else (MASK,a)\n    got = proposed(a,d)\n    assert got == expect, (hex(a), hex(d), got, expect)\nprint(f'Radix-4 recurrence matches unsigned divmod for {len(pairs)} corner/random operand pairs, including divisor zero.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
