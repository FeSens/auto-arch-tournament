   # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b00\n…[15918 of 18990 chars elided by tools/bench/transcript.py; sha256:216edf0156339bb6]…\nf opcode == 0x23 else 0)\n                predictor_log[\"trace\"].append(trace)\n            if rets and seed is None and not imem_holds and not bus_pattern and not dmem_holds:\n                assert cycle - rets[-1][1] <= 10, \"zero-wait retirement liveness gap\"\n            rets.append((pc, cycle))\n            if insn == EBREAK():\n                assert len(rets) == len(expected_pcs)\n                assert stores == model_stores, \"duplicate or wrong-path memory side effect\"\n                assert memory == model_memory\n                return rets\n        dut.clock.value = 1\n        await Timer(5, unit=\"ns\")\n        dut.clock.value = 0\n        await Timer(1, unit=\"ns\")\n    raise AssertionError(\"division program did not complete\")\n\n\n@cocotb.test()\nasync def fetch_queue_overlaps_backend_and_independent_bus_stalls(dut):\n    program = [ADDI(2, 0, 7), LW(1, 0, 0x100), SW(2, 0, 0x104),\n               DIV(3, 1, 2), LW(4, 0, 0x108), MUL(5, 4, 3), DIV(6, 5, 2),\n               BEQ(0, 0, 12), SW(5, 0, 0x200), DIV(0, 1, 0),\n", "exit_code": 0, "status": "completed"}}
