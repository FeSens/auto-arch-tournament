{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,170p' cores/bench/test/test_alu.py; python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/e4e97874/ab83e8b3/div-borrow-r6s0/gowin8_p0/impl/pnr/core_bench.tr')\ns=p.read_text(errors='replace')\npos=s.find('Data Arrival Path:',s.find('3.3.1 Setup Analysis Report',s.find('3.3.1 Setup Analysis Report')+1))\nprint(s[pos:pos+2500])\nPY\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nThe ALU is purely combinational (RV32IM). MUL / DIV / REM use the\nSystemVerilog `*`, `/`, `%` operators and resolve in zero cycles, so\nthere is no clock, reset, or handshake on this module.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    # Default elaboration must ignore the optional isolated operands.\n    dut.mul_a.value = 0x12345678\n    dut.mul_b.value = 0xdeadbeef\n    \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n    `await _setup(dut)` for parity with other test files.\"\"\"\n    return\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    \"\"\"Combinational div/rem — alias for _check. Was a multi-cycle FSM\n    under hyp-20260427-002, reverted in 6688be7 (v2 reset).\"\"\"\n    await _check(dut, op, a, b, expected)\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0\n…[4352 of 7424 chars elided by tools/bench/transcript.py; sha256:cb8b70be8ea232cb]…\n5   tINS   FF   1        R15C40[1][A]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_2_s/COUT  \n  7.332    0.000   tNET   FF   2        R15C40[1][B]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_3_s/CIN   \n  7.367    0.035   tINS   FF   1        R15C40[1][B]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_3_s/COUT  \n  7.367    0.000   tNET   FF   2        R15C40[2][A]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_4_s/CIN   \n  7.402    0.035   tINS   FF   1        R15C40[2][A]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_4_s/COUT  \n  7.402    0.000   tNET   FF   2        R15C40[2][B]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_5_s/CIN   \n  7.438    0.035   tINS   FF   1        R15C40[2][B]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_5_s/COUT  \n  7.438    0.000   tNET   FF   2        R15C41[0][A]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_6_s/CIN   \n  7.473    0.035   tINS   FF   1        R15C41[0][A]   cpu/u_ex/u_div/g_step[0].u_sub/difference[0]_6_s/COUT  \n  7.473    0.000   tNET   FF   2       \n", "exit_code": 0, "status": "completed"}}
