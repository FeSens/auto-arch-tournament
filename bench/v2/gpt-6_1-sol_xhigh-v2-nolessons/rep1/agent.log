{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '200,318p' cores/bench/test/test_pipeline.py; sed -n '440,630p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    for cycle in range(2000):\n        ia = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = program[ia // 4] if ia // 4 < len(program) else EBREAK()\n        dut.io_imemReady.value = int(seed is None or rng.random() >= 0.22)\n        da = int(dut.io_dmemAddr.value)\n        ren = int(dut.io_dmemREn.value)\n        wen = int(dut.io_dmemWEn.value)\n        wd = int(dut.io_dmemWData.value)\n        request = (da, ren, wen, wd)\n        if stalled_request is not None:\n            assert request == stalled_request, \"outstanding dmem request changed under stall\"\n        key = (da, ren, wen)\n        if seed is not None and (ren or wen) and key not in directed_seen:\n            directed_seen.add(key)\n            directed_left = 9\n        ready = seed is None or (directed_left == 0 and rng.random() >= 0.22)\n        if directed_left:\n            directed_left -= 1\n        dut.io_dmemReady.value = int(ready)\n        dut.io_dmemRData.value = memory.get(da & ~3, 0)\n        await Timer(4, unit=\"ns\")\n        stalled_request = request if (ren or wen) and not ready else None\n        if wen and ready:\n            assert wen == 15 and da % 4 == 0\n            memory[da] = wd\n            stores.append((da, wd))\n\n        if int(dut.io_rvfi_valid_0.value):\n            index = len(rets)\n            assert index < len(expected_pcs), \"extra retirement\"\n            pc = int(dut.io_rvfi_pc_rdata_0.value)\n            assert pc == expected_pcs[index], f\"retirement {index}: PC {pc}, expected {expected_pcs[index]}\"\n            assert int(dut.io_rvfi_order_0.value) == index\n            insn = program[pc // 4]\n            assert int(dut.io_rvfi_insn_0.value) == insn\n            assert int(dut.io_rvfi_trap_0.value) == 0\n            rs1, rs2, rd = (insn >> 15) & 31, (insn >> 20) & 31, (insn >> 7) & 31\n            a, b = regs[rs1], regs[rs2]\n            # The existing contract reports raw register fields even for\n            # instructions whose encoding uses those bits as immediates.\n            assert int(dut.io_rvfi_rs1_addr_0.value) == rs1\n  \n…[8881 of 11953 chars elided by tools/bench/transcript.py; sha256:8021845568fe4edc]…\n2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"core\"\n    runner.build(\n        hdl_toplevel=\"core\",\n        sources=[str(RTL / source) for source in [\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ]],\n        build_dir=str(build_dir), always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", f\"+incdir+{RTL}\"],\n    )\n    runner.test(\n        hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n        test_dir=str(TEST_DIR), build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
