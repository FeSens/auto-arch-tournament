{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '250,560p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "            index = len(rets)\n            assert index < len(expected_pcs), \"extra retirement\"\n            pc = int(dut.io_rvfi_pc_rdata_0.value)\n            assert pc == expected_pcs[index], f\"retirement {index}: PC {pc}, expected {expected_pcs[index]}\"\n            assert int(dut.io_rvfi_order_0.value) == index\n            insn = program[pc // 4]\n            assert int(dut.io_rvfi_insn_0.value) == insn\n            assert int(dut.io_rvfi_trap_0.value) == 0\n            rs1, rs2, rd = (insn >> 15) & 31, (insn >> 20) & 31, (insn >> 7) & 31\n            a, b = regs[rs1], regs[rs2]\n            # The existing contract reports raw register fields even for\n            # instructions whose encoding uses those bits as immediates.\n            assert int(dut.io_rvfi_rs1_addr_0.value) == rs1\n            assert int(dut.io_rvfi_rs2_addr_0.value) == rs2\n            assert int(dut.io_rvfi_rs1_rdata_0.value) == a, f\"PC {pc}: rs1 capture mismatch\"\n            assert int(dut.io_rvfi_rs2_rdata_0.value) == b, f\"PC {pc}: rs2 capture mismatch\"\n            opcode, funct3 = insn & 127, (insn >> 12) & 7\n            imm = insn >> 20\n            imm = imm if imm < 0x800 else imm - 0x1000\n            value, write, next_pc = 0, False, pc + 4\n            if opcode == 0x13:\n                value, write = (a + imm) & mask, True\n            elif opcode == 0x37:\n                value, write = insn & 0xfffff000, True\n            elif opcode == 0x33:\n                write = True\n                if insn >> 25 == 0:\n                    value = (a + b) & mask\n                elif funct3 < 4:\n                    sa = a if a < 0x80000000 else a - (1 << 32)\n                    sb = b if b < 0x80000000 else b - (1 << 32)\n                    product = (sa if funct3 in (1, 2) else a) * (sb if funct3 == 1 else b)\n                    value = (product if funct3 == 0 else product >> 32) & mask\n                elif funct3 in (4, 6):\n                    sa = a if a < 0x80000000 else a - (1 << 32)\n                    sb = b if b < 0x80000000 else b - (1 << 32)\n      \n…[11631 of 14703 chars elided by tools/bench/transcript.py; sha256:5e2c1ab29b56de45]…\n\n               DIV(3, 1, 2), REM(4, 1, 2), DIV(5, 1, 0), REM(6, 1, 0),\n               DIVU(7, 1, 0), REMU(8, 1, 0), DIVU(9, 1, 2),\n               REMU(10, 1, 2), DIV(0, 1, 2), ADD(11, 3, 6), EBREAK()]\n    await _run_div_program(dut, program, [i * 4 for i in range(len(program))])\n\n\n@cocotb.test()\nasync def sustained_divide_stream_has_nine_cycle_retirement_gap(dut):\n    program = [ADDI(1, 0, -101), ADDI(2, 0, 7)]\n    for _ in range(4):\n        program += [DIV(3, 1, 2), DIVU(4, 3, 2), REM(5, 4, 2), REMU(6, 5, 2),\n                    DIV(0, 3, 2), DIVU(0, 4, 2), REM(0, 1, 2), REMU(0, 1, 2),\n                    DIV(7, 3, 0), REM(8, 7, 2), REMU(9, 8, 2), DIVU(10, 9, 2)]\n    program += [SW(10, 0, 0x100), EBREAK()]\n    pcs = [i * 4 for i in range(len(program))]\n    rets = await _run_div_program(dut, program, pcs)\n    for previous, current in zip(rets, rets[1:]):\n        if 8 <= previous[0] < current[0] < (len(program) - 2) * 4:\n            assert current[1] - previous[1] == 9, \"consecutive divides changed schedule\"\n", "exit_code": 0, "status": "completed"}}
