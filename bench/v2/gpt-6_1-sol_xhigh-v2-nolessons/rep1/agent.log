{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor name in ('shared_mul33','shared_mul_unsigned'):\n base=Path('cores/bench/generated')/('r15_'+name)\n rtl=base/'rtl'\n rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):\n  shutil.copyfile(p,rtl/p.name)\n p=rtl/'alu.sv'\n s=p.read_text()\n start=s.index('  // 64-bit products')\n end=s.index('  always_comb begin',start)\n if name=='shared_mul33':\n  decl='''  logic signed [32:0] shared_a, shared_b;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] shared_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign shared_a = \"'$signed({((op == ALU_MULH || op == ALU_MULHSU) && product_a[31]), product_a});\n  assign shared_b = $signed({((op == ALU_MULH) && product_b[31]), product_b});\n  assign shared_product = shared_a * shared_b;\n\n'\"'''\n else:\n  decl='''  logic [63:0] shared_product;\n  logic [31:0] correction_a, correction_b;\n  logic [31:0] high_sum, high_carry, high_result;\n  logic [1:0] correction_bias;\n  assign shared_product = {32'd0, product_a} * {32'd0, product_b};\n  assign correction_a = ((op == ALU_MULH || op == ALU_MULHSU) && product_a[31]) ? product_b : 32'd0;\n  assign correction_b = (op == ALU_MULH && product_b[31]) ? product_a : 32'd0;\n  assign high_sum = shared_product[63:32] \"'^ ~correction_a ''^ ~correction_b;\n  assign high_carry = ((shared_product[63:32] & ~correction_a) |\n                       (shared_product[63:32] & ~correction_b) |\n                       (~correction_a & ~correction_b)) << 1;\n  assign high_result = high_sum + high_carry + 32'\"'d2;\n\n'''\n s=s[:start]+decl+s[end:]\n start=s.index('    mul_ss = ')\n end=s.index('    case (op)',start)\n s=s[:start]+s[end:]\n s=s.replace('out = mul_uu[31:0];','out = shared_product[31:0];')\n if name=='shared_mul33':\n  s=s.replace('out = \"'$unsigned(mul_ss[63:32]);'\"','out =