{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])\nfor name,kind in [('branch-normalized','normalize'),('branch-annul','annul')]:\n rtl=root/name/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n if kind=='normalize':\n  p=rtl/'ex_stage.sv';s=p.read_text()\n  s=s.replace('  logic        branch_cond;', '''  logic branch_signed_order, branch_equal, branch_less;\n  logic [31:0] compare_a, compare_b;\n  assign branch_signed_order = \"'!in.ctrl.branch_op[1];\n  assign compare_a = {rs1[31] ''^ branch_signed_order, rs1[30:0]};\n  assign compare_b = {rs2[31] ''^ branch_signed_order, rs2[30:0]};\n  assign branch_equal = rs1 == rs2;\n  assign branch_less = compare_a < compare_b;\n  logic        branch_cond;'\"''')\n  a=s.index('    case (in.ctrl.branch_op)');b=s.index('    branch_taken ',a)\n  s=s[:a]+'''    branch_cond = (in.ctrl.branch_op[2] ? branch_less : branch_equal) \"'^ in.ctrl.branch_op[0];\n    if (in.ctrl.branch_op == 3'\"'d2 || in.ctrl.branch_op == 3'd3) branch_cond = 1'b0;\n'''+s[b:]\n  p.write_text(s)\n else:\n  p=rtl/'operand_stage.sv';s=p.read_text().replace('if (accept && in.valid && \"'!stall && !flush) begin'\"','if (in.valid && \"'!stall) begin'\"')\n  p.write_text(s)\nprint('Prepared normalized comparator and immediate annul prototypes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
