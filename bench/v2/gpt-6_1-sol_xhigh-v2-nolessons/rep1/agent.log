{"type": "item.completed", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_operand_stage.py'", "aggregated_output": "\"\"\"OF acceptance, age ordering, live rereads and isolated launch operands.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, run_cocotb\nfrom test_ex_divider import CTRL, ID_EX, pack, unpack\n\nID_OF = [(\"pc\", 32), (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5),\n         (\"rs2_addr\", 5), (\"use_rs1\", 1), (\"use_rs2\", 1),\n         (\"ctrl\", 22), (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\n\n\ndef decoded(**updates):\n    values = dict(pc=0x40, rd=3, rs1_addr=1, rs2_addr=2,\n                  use_rs1=1, use_rs2=1, valid=1, predicted_taken=1,\n                  instr=0x0220c1b3, ctrl=pack(CTRL, dict(alu_op=ALU_DIV, reg_write=1)))\n    values.update(updates)\n    return pack(ID_OF, values)\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut[\"in\"].value = 0\n    for name in (\"stall\", \"flush\", \"accept\", \"ex_rd\", \"mem_rd\", \"wb_rd\",\n                 \"ex_w_en\", \"ex_normal_w_en\", \"ex_load\", \"mem_w_en\", \"wb_w_en\",\n                 \"rs1_data\", \"rs2_data\", \"ex_result\", \"ex_normal_result\",\n                 \"mem_result\", \"wb_result\"):\n        getattr(dut, name).value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    dut.accept.value = 1\n\n\n@cocotb.test()\nasync def youngest_writer_and_completed_divide_capture(dut):\n    await setup(dut)\n    dut[\"in\"].value = decoded(rs2_addr=1)\n    dut.rs1_data.value = 11\n    dut.rs2_data.value = 11\n    dut.ex_rd.value = dut.mem_rd.value = dut.wb_rd.value = 1\n    dut.ex_result.value = 44\n    dut.ex_normal_result.value = 44\n    dut.mem_result.value = 33\n    dut.wb_result.value = 22\n    dut.mem_w_en.value = dut.wb_w_en.value = 1\n    for ex_enable, mem_enable, wb_enable, expected in (\n            (1, 1, 1, 44), (0, 1, 1, 33), (0, 0, 1, 22), (0, 0, 0, 11)):\n        dut.ex_w_en.value = dut.ex_normal_w_en.value = ex_enable\n        dut.mem_w_en.value = mem_enable\n        dut.wb_w_en.value = wb_enable\n        await tick(dut)\n        out = unpack(ID_EX\n…[2704 of 5776 chars elided by tools/bench/transcript.py; sha256:8fd6b1af9e3150aa]…\nse.value) == 0\n    dut.ex_rd.value = 2\n    dut[\"in\"].value = decoded()\n    dut.stall.value = dut.flush.value = 1\n    dut.accept.value = 0\n    await tick(dut)\n    assert unpack(ID_EX, int(dut.out.value))[\"valid\"] == 0\n    # The older load moves once to MEM; its aligned/extended value is captured.\n    dut.ex_load.value = 0\n    dut.mem_rd.value = 2\n    dut.mem_w_en.value = 1\n    dut.mem_result.value = 0xffffff80\n    dut.stall.value = dut.flush.value = 0\n    dut.accept.value = 1\n    await tick(dut)\n    out = unpack(ID_EX, int(dut.out.value))\n    assert out[\"valid\"] == 1 and out[\"rs2_val\"] == 0xffffff80\n    # Trapping/invalid producers are suppressed by their writer qualification.\n    dut.mem_w_en.value = 0\n    dut.rs2_data.value = 7\n    await tick(dut)\n    assert unpack(ID_EX, int(dut.out.value))[\"rs2_val\"] == 7\n\n\ndef test_operand_stage_runner():\n    run_cocotb(toplevel=\"operand_stage\",\n               sources=[\"core_pkg.sv\", \"forward_unit.sv\", \"operand_stage.sv\"],\n               test_module=\"test_operand_stage\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,210p' tools/eval/cosim.py\"", "aggregated_output": "\"\"\"Runs Verilator cosim for all bench ELFs. Returns structured pass/fail.\n\nCorrectness is gated in two stages:\n  1. Full RVFI trace cosim for selftest and any other small ELF — every\n     retirement is diffed against the Python reference ISS.\n  2. CoreMark CRC validation via the sim's UART capture — full-trace cosim\n     of coremark.elf is skipped because the Python reference is ~10⁴× slower\n     than Verilator (would take 30+ minutes per candidate). Instead we run\n     the sim in --bench mode and verify its UART matches the canonical CRCs\n     with `validate_coremark_uart` (the same check run_fpga_eval uses). This\n     catches any CPU bug that affects CoreMark output without the full trace\n     overhead.\n\"\"\"\nimport os, subprocess, json, sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\nBENCH_DIR = Path(\"bench/programs\")\n\n\ndef _build_cosim_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `bash test/cosim/build.sh`.\n\n    Reads cores/<target>/core.yaml's `nret` (defaults to 2) and injects\n    NRET=<n> so build.sh can pass `-DNRET=<n>` to verilator. main.cpp's\n    channel-1 drain is compiled out under `#if NRET < 2`, so a single-\n    issue core (no `_1` ports) builds cleanly.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[5319 of 8391 chars elided by tools/bench/transcript.py; sha256:5ca3876276821056]…\n             for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n            result = future.result()\n            if not result['passed']:\n                return {\n                    'passed': False,\n                    'failed_elf': result['elf'],\n                    'detail': result,\n                }\n\n    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n    if coremark is not None:\n        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n\n\nif __name__ == '__main__':\n    result = run_cosim(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n", "exit_code": 0, "status": "completed"}}
