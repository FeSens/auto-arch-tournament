{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/e4e97874/67486842/r12mul')\ntest=base/'test';test.mkdir(exist_ok=True)\nfor name in ['_helpers.py','conftest.py','test_alu.py']:shutil.copy2(Path('cores/bench/test')/name,test/name)\np=test/'test_alu.py';s=p.read_text()\ns+='''\n@cocotb.test()\nasync def unified_multiplier_random(dut):\n    import random\n    r=random.Random(120)\n    await _setup(dut)\n    values=[0,1,2,0x7fffffff,0x80000000,0xffffffff,0x80000001,0x12345678]\n    pairs=[(a,b) for a in values for b in values]\n    pairs += [(r.getrandbits(32),r.getrandbits(32)) for _ in range(2000)]\n    for a,b in pairs:\n        sa=a if a<0x80000000 else a-(1<<32)\n        sb=b if b<0x80000000 else b-(1<<32)\n        for op,result in [(ALU_MUL,a*b),(ALU_MULH,(sa*sb)>>32),\n                          (ALU_MULHU,(a*b)>>32),(ALU_MULHSU,(sa*b)>>32)]:\n            await _check(dut,op,a,b,result)\n'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
