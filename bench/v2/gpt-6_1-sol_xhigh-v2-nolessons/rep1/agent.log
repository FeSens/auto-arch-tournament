t). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[5172 of 8244 chars elided by tools/bench/transcript.py; sha256:4fbe2c07c6040d60]…\n::strcmp(argv[i], \"--istall\") == 0) istall     = true;\n79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\n84:    ELF elf; elf.load(argv[1]);\n85:    for(int i=0;i<elf.phnum();i++){\n86:        uint32_t off    = elf.phoff() + i*elf.phentsize();\n87:        uint32_t type   = *reinterpret_cast<uint32_t*>(&elf.data[off]);\n88:        uint32_t foff   = *reinterpret_cast<uint32_t*>(&elf.data[off+4]);\n89:        uint32_t vaddr  = *reinterpret_cast<uint32_t*>(&elf.data[off+8]);\n90:        uint32_t filesz = *reinterpret_cast<uint32_t*>(&elf.data[off+16]);\n92:            memcpy(imem+vaddr, elf.data.data()+foff, filesz);\n93:            memcpy(dmem+vaddr, elf.data.data()+foff, filesz);\n117:        // (zero-wait) by default so existing selftest cosim runs aren't\n131:        //     allowed (markers); anything else outside dmem is OOB (handled\n152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\nls: cannot access 'bench/programs/coremark.elf': No such file or directory\n", "exit_code": 2, "status": "failed"}}
