{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/_helpers.py cores/bench/test/test_ex_divider.py'", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"Exercise EX's launch/hold/transfer protocol directly, including stalls\nafter arithmetic has completed, which an already-drained MEM stage normally\ncannot cause in this single-iss\n…[8217 of 11289 chars elided by tools/bench/transcript.py; sha256:0195148a70c99375]…\nresult\"] == expected\n        assert out[\"rs1_val\"] == a and out[\"rs2_val\"] == b\n        dut.fwd_load_data.value = 0xdeadbeef\n        await tick(dut)\n        assert unpack(EX_MEM, int(dut.out.value))[\"alu_result\"] == expected\n\n\n@cocotb.test()\nasync def redirects_require_valid_and_advance(dut):\n    await setup(dut)\n    ctrl = pack(CTRL, dict(is_branch=1, branch_op=0))\n    for valid, stall in ((0, 0), (1, 1), (0, 1)):\n        dut[\"in\"].value = payload(valid=valid, rs1_val=0, rs2_val=0, imm=8, ctrl=ctrl)\n        dut.stall.value = stall\n        await Timer(1, unit=\"ns\")\n        assert int(dut.redirect.value) == 0\n    dut[\"in\"].value = payload(rs1_val=0, rs2_val=0, imm=8, ctrl=ctrl)\n    dut.stall.value = 0\n    await Timer(1, unit=\"ns\")\n    assert int(dut.redirect.value) == 1\n    assert int(dut.redirect_target.value) == 0x48\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"div_unit.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n", "exit_code": 0, "status": "completed"}}
