{"type": "item.completed", "item": {"id": "item_56", "type": "command_execution", "command": "/bin/bash -c \"sed -n '203,275p' tools/eval/fpga.py\"", "aggregated_output": "def run_coremark_ipc(worktree: str, sim_bin: str | None = None, env: dict | None = None) -> dict:\n    \"\"\"Run CoreMark on Verilator sim, return {iter_per_cycle, completed, cycles, iterations}.\n    Completion is only trusted when the simulation retired an ebreak — otherwise the\n    benchmark hit maxcycles without completing and the cycle count is meaningless.\"\"\"\n    worktree_path = Path(worktree).resolve()\n    if sim_bin is None:\n        sim_bin = str(worktree_path / \"test/cosim/obj_dir/cosim_sim\")\n    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\n    # 50M cycle ceiling: 2K CoreMark with ITERATIONS=10 + iStall+dStall\n    # needs ~5M cycles. 50M gives 10x headroom for slower candidates.\n    try:\n        result = run_pgroup(\n            [sim_bin, elf, \"50000000\"] + COREMARK_SIM_FLAGS,\n            capture_output=True, text=True, timeout=600, env=env\n        )\n    except (subprocess.TimeoutExpired, OSError) as e:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'coremark_harness_error: {e}'}\n    lines = [l for l in result.stdout.splitlines() if l.strip()]\n    if len(lines) < 2:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': 'no output from sim'}\n\n    # Last line is the ebreak/maxcycles marker; second-to-last is the final retirement.\n    try:\n        marker = json.loads(lines[-1])\n        last_retirement = json.loads(lines[-2])\n    except json.JSONDecodeError as e:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'malformed sim output: {e}'}\n\n    if not marker.get('ebreak', False):\n        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n        # a hung CPU with whatever cycle count it happened to reach.\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': 'maxcycles_hit_before_ebreak'}\n\n    # OOB sticky flag from the sim:\n…[1045 of 4117 chars elided by tools/bench/transcript.py; sha256:db167c72eeb3908d]…\nIO bug that\n    # drops 0x10000100/0x10000104 writes would silently get scored on\n    # init+CRC-printing overhead too.\n    if not marker.get('bench_bracketed', False):\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'bench_markers_missing: '\n                          f'start={marker.get(\"bench_start_cycle\")} '\n                          f'stop={marker.get(\"bench_stop_cycle\")}'}\n    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n    if elapsed_cycles <= 0:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\n    ipc = iterations / elapsed_cycles\n    return {'completed': True, 'iter_per_cycle': ipc, 'cycles': elapsed_cycles,\n            'iterations': iterations, 'bracketed_cycles': True}\n\ndef _uart_int(uart: str, pattern: str, base: int = 10):\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c 'cat bench/programs/Makefile'","aggregated_output":"CROSS   := riscv32-unknown-elf\nCC      := $(CROSS)-gcc\n\n# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\n# (2K data size, -O3); tools/eval/fpga.py's COREMARK_EXPECTED CRCs assume\n# exactly these defaults.\n# - COREMARK_SIZE: TOTAL_DATA_SIZE in coremark.h (#ifndef-guarded). 2000 is\n#   the EEMBC canonical reporting config (used by VexRiscv et al.); 6000\n#   makes the matrix/list/state working sets ~3x larger so the score is\n#   harder to inflate via register-resident working sets.\n# - COREMARK_OPT: gcc optimization. -O3 is the standard CoreMark publication\n#   flag; -O2 is what the V0 baseline used.\n# Defaults match VexRiscv's published CoreMark methodology so the\n# orchestrator's fitness number is directly comparable to public CoreMark\n# results. To override (e.g. for the prior 6K -O2 V0 baseline):\n#     make bench/programs/coremark.elf COREMARK_SIZE=6000 COREMARK_OPT=-O2\nCOREMARK_SIZE ?= 2000\nCOREMARK_OPT  ?= -O3\n\nCFLAGS  := -march=rv32im -mabi=ilp32 $(COREMARK_OPT) -static -nostartfiles \\\n           -specs=nano.specs -specs=nosys.specs \\\n           -T bench/programs/link.ld -Ibench/programs/coremark \\\n           -Ibench/programs/coremark/baremetal \\\n           -DTOTAL_DATA_SIZE=$(COREMARK_SIZE)\n\nSRCS := bench/programs/coremark/core_list_join.c \\\n        bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"sed -n '1,80p' cores/bench/test/test_div_unit.py; tail -6 /srv/hwebench/tmp/e4e97874/601ce070/folded_prefix_probe/div_tests.log\"","aggregated_output":"\"\"\"Tests of the registered divider, including the identical ALTOPS schedule.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, RTL, SIM_BUILD, TEST_DIR\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nRUN_CLOCKS = 6\nALTOPS = bool(int(os.environ.get(\"DIV_ALTOPS\", \"0\")))\n\n\ndef reference(op, a, b):\n    a, b = a & MASK, b & MASK\n    if ALTOPS:\n        salt = {ALU_DIV: 0x7f8529ec, ALU_DIVU: 0x10e8fd70,\n                ALU_REM: 0x8da68fa5, ALU_REMU: 0x3138d0e1}[op]\n        return ((a - b) ^ salt) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK\n    return (a % b if op == ALU_REMU else a // b) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.start.value = 0\n    dut.consume.value = 0\n    dut.op.value = ALU_DIVU\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.reset.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert int(dut.busy.value) == 0\n    assert int(dut.result_valid.value) == 0\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK\n    dut.b.value = b & MASK\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    dut.consume.value = 0\n    assert int(dut.busy.value) == 1\n    assert int(dut.result_valid.value) == 0\n\n\nasync def finish(dut, op, a, b, delay=0):\n    expected = reference(op, a, b)\n    for elapsed in range(1, RUN_CLOCKS + 1):\n        # Inputs and even rejected starts can change after acceptance.\n        dut.a.value = (a ^ (elapsed * 0x1020304)) & MASK\n        dut.b.value = (b + elapsed * 13) & MASK\n        dut.op.value = OPS[elapsed % 4]\n        dut.start.value = elapsed & 1\n        dut.consume.value = int(elapsed < RUN_CLOCKS) & (elapsed & 1)\n        await tick(dut)\n        assert int(dut.busy.value) == 1\n     -.--ns INFO     gpi                                ../gpi/GpiCommon.cpp:79   in gpi_print_registered_impl       VPI registered\n     0.00ns INFO     cocotb                             Running on Verilator version 5.047 devel\n     0.00ns INFO     cocotb                             Seeding Python random module with 1791156690\n     0.00ns INFO     cocotb                             Initialized cocotb v2.0.1 from /srv/hwebench/venv/lib/python3.13/site-packages/cocotb\n     0.00ns INFO     cocotb                             Running tests\n     0.00ns INFO     cocotb.regression                  running test_div_unit.arithmetic_capture_latency_and_hold (1/3)\n","exit_code":0,"status":"completed"}}
