{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nbackup=Path('/srv/hwebench/tmp/e4e97874/b737a704')\nPath('cores/bench/rtl/ex_stage.sv').write_text((backup/'ex_stage.sv.original').read_text())\np=Path('cores/bench/rtl/div_unit.sv'); s=p.read_text(); (backup/'div_unit.sv.original').write_text(s)\nstart=s.index('  for (genvar s = 0; s < 2; s++) begin : g_run')\nend=s.index('\\\\n  // Terminal trials',start)\ns=s[:start]+'''  for (genvar s = 0; s < 2; s++) begin : g_run\n    localparam integer W = 28 + 2*s;\n    logic [W-1:0] window, restored;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [W:0] diff1, diff2, diff3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic ok1, ok2, ok3;\n    logic [3:0] mask;\n    assign window = {run_r[s][W-3:0],run_q[s][31:30]};\n    assign diff1 = {1'b0,window} - {1'b0,divisor_once[W-1:0]};\n    assign diff2 = {1'b0,window} - {1'b0,divisor_twice[W-1:0]};\n    assign diff3 = {1'b0,window} - {1'b0,triple_divisor_q[W-1:0]};\n    assign ok1 = \"'!(|divisor_once[33:W]) && !diff1[W];\n    assign ok2 = !(|divisor_twice[33:W]) && !diff2[W];\n    assign ok3 = !(|triple_divisor_q[33:W]) && !diff3[W];\n    assign mask = {ok3,ok2 & !ok3,ok1 & !ok2,!ok1};\n    assign restored = ({W{mask[0]}} & window) |\n                      ({W{mask[1]}} & diff1[W-1:0]) |\n                      ({W{mask[2]}} & diff2[W-1:0]) |\n                      ({W{mask[3]}} & diff3[W-1:0]);\n    assign run_q[s+1] = {run_q[s][29:0],ok2,ok3 | (ok1 & !ok2)};\n    assign run_r[s+1] = {{(32-W){1'\"'b0}},restored};\n  end\n''' +s[end:]\np.write_text(s)\nPY\nmake lint TARGET=bench\npytest -q cores/bench/test/test_div_unit.py cores/bench/test/test_ex_divider.py cores/bench/test/test_pipeline.py > /srv/hwebench/tmp/e4e97874/b737a704/bounded-tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
