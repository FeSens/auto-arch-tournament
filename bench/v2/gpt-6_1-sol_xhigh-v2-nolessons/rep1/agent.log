{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])\nfor name,chunk in [('branch-tree8',8),('branch-tree4',4)]:\n rtl=root/name/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n p=rtl/'ex_stage.sv';s=p.read_text();n=32//chunk\n insert=f'''  logic [{n-1}:0] part_equal, part_lt;\n  logic full_equal, full_lt, signed_lt;\n  for (genvar byte_idx = 0; byte_idx < {n}; byte_idx++) begin : g_relation\n    assign part_equal[byte_idx] = rs1[{chunk}*byte_idx +: {chunk}] == rs2[{chunk}*byte_idx +: {chunk}];\n    assign part_lt[byte_idx] = rs1[{chunk}*byte_idx +: {chunk}] < rs2[{chunk}*byte_idx +: {chunk}];\n  end\n  assign full_equal = &part_equal;\n'''\n for level in range((n.bit_length()-1)):\n  size=n>>(level+1)\n  insert+=f'  logic [{size-1}:0] eq_l{level}, lt_l{level};\\\\n'\n  prev_eq='part_equal' if not level else f'eq_l{level-1}'\n  prev_lt='part_lt' if not level else f'lt_l{level-1}'\n  for j in range(size):\n   insert+=f'  assign eq_l{level}[{j}] = {prev_eq}[{2*j+1}] & {prev_eq}[{2*j}];\\\\n'\n   insert+=f'  assign lt_l{level}[{j}] = {prev_lt}[{2*j+1}] | ({prev_eq}[{2*j+1}] & {prev_lt}[{2*j}]);\\\\n'\n insert+=f'  assign full_lt = lt_l{n.bit_length()-2}[0];\\\\n  assign signed_lt = (rs1[31] \"'^ rs2[31]) ? rs1[31] : full_lt;'\"\\\\n'\n s=s.replace('  logic        branch_cond;',insert+'  logic        branch_cond;')\n s=s.replace('(rs1 == rs2)','full_equal').replace('(rs1 \"'!= rs2)'\"','\"'!full_equal'\"').replace('(\"'$signed(rs1) <  $signed(rs2))'\"','signed_lt').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!signed_lt'\"').replace('(rs1 <  rs2)','full_lt').replace('(rs1 >= rs2)','\"'!full_lt'\"')\n p.write_text(s)\nprint('Prepared two combinational branch-verifier prototypes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
