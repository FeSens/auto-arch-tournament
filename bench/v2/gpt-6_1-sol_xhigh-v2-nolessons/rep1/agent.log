{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,245p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "\"\"\"Tests of the registered divider, including the identical ALTOPS schedule.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, RTL, SIM_BUILD, TEST_DIR\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nRUN_CLOCKS = 7\nALTOPS = bool(int(os.environ.get(\"DIV_ALTOPS\", \"0\")))\n\n\ndef reference(op, a, b):\n    a, b = a & MASK, b & MASK\n    if ALTOPS:\n        salt = {ALU_DIV: 0x7f8529ec, ALU_DIVU: 0x10e8fd70,\n                ALU_REM: 0x8da68fa5, ALU_REMU: 0x3138d0e1}[op]\n        return ((a - b) ^ salt) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK\n    return (a % b if op == ALU_REMU else a // b) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.start.value = 0\n    dut.consume.value = 0\n    dut.op.value = ALU_DIVU\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.reset.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert int(dut.busy.value) == 0\n    assert int(dut.result_valid.value) == 0\n\n\nasync def launch(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK\n    dut.b.value = b & MASK\n    dut.start.value = 1\n    await tick(dut)\n    dut.start.value = 0\n    dut.consume.value = 0\n    assert int(dut.busy.value) == 1\n    assert int(dut.result_valid.value) == 0\n\n\nasync def finish(dut, op, a, b, delay=0):\n    expected = reference(op, a, b)\n    for elapsed in range(1, RUN_CLOCKS + 1):\n        # Inputs and even rejected starts can change after acceptance.\n        dut.a.value = (a ^ (elapsed * 0x102\n…[2918 of 5990 chars elided by tools/bench/transcript.py; sha256:7e1fee0eb6d72fb8]…\n for _ in range(phase):\n            await tick(dut)\n        await reset(dut)\n        for _ in range(8):\n            await tick(dut)\n            assert int(dut.result_valid.value) == 0\n        await launch(dut, ALU_REM, -10, 3)\n        await finish(dut, ALU_REM, -10, 3)\n        await consume(dut)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_div_unit_runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"div_unit_altops\" if altops else \"div_unit\")\n    args = [\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"]\n    if altops:\n        args.append(\"+define+RISCV_FORMAL_ALTOPS\")\n    runner.build(sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"div_unit.sv\")],\n                 hdl_toplevel=\"div_unit\", build_dir=str(build_dir),\n                 always=True, build_args=args)\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir),\n                extra_env={\"DIV_ALTOPS\": str(int(altops))})\n", "exit_code": 0, "status": "completed"}}
