 branch_equal = &in.branch_byte_eq;\n  assign branch_signed_lt = (in.branch_sign1 \"'^ in.branch_sign2) ? in.branch_sign1 : branch_unsigned_lt;\n  logic        branch_cond;'\"''')\ns=s.replace('(rs1 == rs2)','branch_equal').replace('(rs1 \"'!= rs2)'\"','\"'!branch_equal'\"').replace('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_signed_lt').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!branch_signed_lt'\"').replace('(rs1 <  rs2)','branch_unsigned_lt').replace('(rs1 >= rs2)','\"'!branch_unsigned_lt'\"')\np.write_text(s)\nprint(scratch)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
