{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python - <<'PY' > cores/bench/generated/r15_width/cosim.log 2>&1\nimport json\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.cosim import run_one,TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart,parse_iterations\nimport subprocess\nwt=Path('.').resolve()\nbase=wt/'cores/bench/generated/r15_width'\nsim=str(base/'obj_dir/cosim_sim')\nwith ThreadPoolExecutor(max_workers=4) as ex:\n futs=[ex.submit(run_one,elf,sim,str(wt),None,flags) for elf in (base/'elfs').glob('*.elf') if elf.name\"'!='\"'coremark.elf' for flags in TRACE_STALL_MODES]\n for f in futs:\n  r=f.result()\n  print(json.dumps(r),flush=True)\n  assert r['passed'],r\np=subprocess.run([sim,str(base/'elfs/coremark.elf'),'50000000','--bench','--istall','--dstall'],text=True,capture_output=True,timeout=120)\n(base/'coremark_output.log').write_text(p.stdout)\nmarker=json.loads(p.stdout.strip().splitlines()[-1])\nvalid,reason=validate_coremark_uart(marker.get('uart',''),parse_iterations(str(wt)))\nprint('COREMARK',json.dumps(marker),flush=True)\nprint('CRC',valid,reason,flush=True)\nassert p.returncode==0 and marker.get('ebreak') and not marker.get('oob') and valid\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
