{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_alu.py')\nPath('/srv/hwebench/tmp/e4e97874/b737a704/test_alu.original.py').write_text(p.read_text())\np.write_text(p.read_text()+'''\n\n@cocotb.test()\nasync def shared_multiplier_vectors(dut):\n    import random\n    rng = random.Random(140)\n    await _setup(dut)\n    directed = [0,1,2,0xffff,0x10000,0x10001,0x7fff0000,\n                0x7fffffff,0x80000000,0x8000ffff,0xffff0000,0xffffffff]\n    pairs = [(a,b) for a in directed for b in directed]\n    pairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(4000)]\n    def signed(x):\n        return x if x < 0x80000000 else x - 0x100000000\n    for a,b in pairs:\n        for op in (ALU_MUL,ALU_MULH,ALU_MULHU,ALU_MULHSU):\n            if op == ALU_MUL:\n                expected = a*b\n            elif op == ALU_MULH:\n                expected = (signed(a)*signed(b)) >> 32\n            elif op == ALU_MULHU:\n                expected = (a*b) >> 32\n            else:\n                expected = (signed(a)*b) >> 32\n            await _check(dut,op,a,b,expected)\n''')\nPY\npytest -q cores/bench/test/test_alu.py > /srv/hwebench/tmp/e4e97874/b737a704/limb-random-tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
