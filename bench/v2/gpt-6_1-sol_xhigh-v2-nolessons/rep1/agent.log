{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '260,600p' cores/bench/test/test_pipeline.py; sed -n '145,240p' cores/bench/test/test_ex_divider.py\"", "aggregated_output": "                    value = (sa - q * sb if funct3 == 6 else q) & mask\n                else:\n                    value = (a % b if funct3 == 7 else a // b) if b else (a if funct3 == 7 else mask)\n            elif opcode == 0x03:\n                addr = (a + imm) & mask\n                value, write = model_memory.get(addr, 0), True\n                assert int(dut.io_rvfi_mem_addr_0.value) == addr\n                assert int(dut.io_rvfi_mem_rmask_0.value) == 15\n                assert int(dut.io_rvfi_mem_rdata_0.value) == value\n            elif opcode == 0x23:\n                si = ((insn >> 25) << 5) | ((insn >> 7) & 31)\n                si = si if si < 0x800 else si - 0x1000\n                addr = (a + si) & mask\n                model_memory[addr] = b\n                model_stores.append((addr, b))\n                assert int(dut.io_rvfi_mem_addr_0.value) == addr\n                assert int(dut.io_rvfi_mem_wmask_0.value) == 15\n                assert int(dut.io_rvfi_mem_wdata_0.value) == b\n            elif opcode == 0x63:\n                bi = (((insn >> 31) & 1) << 12) | (((insn >> 7) & 1) << 11) \\\n                    | (((insn >> 25) & 63) << 5) | (((insn >> 8) & 15) << 1)\n                bi = bi if bi < 0x1000 else bi - 0x2000\n                if a == b:\n                    next_pc = pc + bi\n            elif insn != EBREAK():\n                raise AssertionError(f\"unsupported test instruction {insn:08x}\")\n            assert int(dut.io_rvfi_pc_wdata_0.value) == next_pc\n            assert int(dut.io_rvfi_rd_addr_0.value) == (rd if write and rd else 0)\n            assert int(dut.io_rvfi_rd_wdata_0.value) == (value if write and rd else 0)\n            if write and rd:\n                regs[rd] = value\n            if rets and seed is None:\n                assert cycle - rets[-1][1] <= 10, \"zero-wait retirement liveness gap\"\n            rets.append((pc, cycle))\n            if insn == EBREAK():\n                assert len(rets) == len(expected_pcs)\n                assert stores == model_stores, \"duplicate or wrong-path memory side e\n…[8766 of 11838 chars elided by tools/bench/transcript.py; sha256:2761af7fbf246865]…\n\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n        dut.stall.value = stall\n        await Timer(1, unit=\"ns\")\n        assert int(dut.redirect.value) == 0\n    dut[\"in\"].value = payload(rs1_val=0, rs2_val=0, imm=8, ctrl=ctrl)\n    dut.stall.value = 0\n    await Timer(1, unit=\"ns\")\n    assert int(dut.redirect.value) == 1\n    assert int(dut.redirect_target.value) == 0x48\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"div_unit.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n", "exit_code": 0, "status": "completed"}}
