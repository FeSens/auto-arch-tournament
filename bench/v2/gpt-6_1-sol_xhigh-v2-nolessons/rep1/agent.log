{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,200p' cores/bench/rtl/div_unit.sv\"", "aggregated_output": "// Shared RV32M divider. Launch captures the operands; six registered\n// five-bit groups (radix 4, radix 4, radix 2) precede a final radix-4 step with\n// fused sign restoration. DONE holds the result until consume, including\n// under bus stalls. ALTOPS preserves the seven-clock execution latency.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        consume,\n  output logic        busy,\n  output logic        result_valid,\n  output logic [31:0] result\n);\n  localparam logic [1:0] IDLE = 2'd0, RUN = 2'd1, DONE = 2'd2;\n  logic [1:0] state_q;\n  logic [2:0] group_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_q;\n`else\n  logic [31:0] quotient_q, remainder_q;\n  logic [33:0] divisor_q, divisor2_q, divisor3_q;\n  logic quotient_neg_q, remainder_neg_q, select_rem_q;\n  logic signed_op;\n  logic [31:0] divisor_magnitude;\n  logic [33:0] divisor_launch, divisor2_launch, divisor3_launch;\n  logic [31:0] quotient_step [0:3];\n  logic [31:0] remainder_step [0:3];\n  logic [32:0] difference;\n  logic [31:0] quotient_signed, remainder_signed;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign divisor_magnitude = (signed_op && b[31]) ? (32'd0 - b) : b;\n  assign divisor_launch = {2'b0, divisor_magnitude};\n  assign divisor2_launch = {1'b0, divisor_magnitude, 1'b0};\n  assign divisor3_launch = divisor_launch + divisor2_launch;\n  assign quotient_step[0] = quotient_q;\n  assign remainder_step[0] = remainder_q;\n  for (genvar digit_step = 0; digit_step < 2; digit_step++) begin : g_digit\n    logic [33:0] trial;\n    // Bits 33:32 of each difference are discarded after restoration:\n    // for nonzero D the selected remainder is less than the 32-bit D.\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [34:0] difference1, difference2, difference3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic ok1, ok2, ok3;\n\n    assign trial = {remainder_step[digit_step], quotient_step[digit_step][31:\n…[2680 of 5752 chars elided by tools/bench/transcript.py; sha256:cf57e0e60f485451]…\nor_launch;\n      divisor2_q <= divisor2_launch;\n      divisor3_q <= divisor3_launch;\n      remainder_q <= 32'd0;\n      // With divisor zero, the recurrence yields all ones and the\n      // original dividend magnitude. Do not negate that quotient.\n      quotient_neg_q <= signed_op && (a[31] ^ b[31]) && (b != 32'd0);\n      remainder_neg_q <= signed_op && a[31];\n      select_rem_q <= (op == ALU_REM || op == ALU_REMU);\n`endif\n    end else begin\n      case (state_q)\n        RUN: begin\n          if (group_q == 3'd6) begin\n`ifdef RISCV_FORMAL_ALTOPS\n            result <= alt_q;\n`else\n            result <= select_rem_q ? remainder_signed : quotient_signed;\n`endif\n            state_q <= DONE;\n          end else begin\n`ifndef RISCV_FORMAL_ALTOPS\n            quotient_q <= quotient_step[3];\n            remainder_q <= remainder_step[3];\n`endif\n            group_q <= group_q + 3'd1;\n          end\n        end\n        DONE: if (consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
