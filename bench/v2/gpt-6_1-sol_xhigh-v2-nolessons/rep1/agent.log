'b0,prefix[2]}; end\n        3: begin high_q={1'b0,&prefix[3:2]}; high_r=&prefix[3:2] ? 2'd0 : prefix[3:2]; end\n        default: ;\n      endcase\n    end\n  end\n  assign launch_d1 = {2'd0,small_magnitude};\n  assign launch_d2 = {1'd0,small_magnitude,1'b0};\n  assign launch_d3 = launch_d1+launch_d2;\n  assign launch_window = {high_r,prefix[1:0]};\n  assign launch_diff1 = {3'd0,launch_window}-{1'b0,launch_d1};\n  assign launch_diff2 = {3'd0,launch_window}-{1'b0,launch_d2};\n  assign launch_diff3 = {3'd0,launch_window}-{1'b0,launch_d3};\n  assign launch_ok1 = \"'!launch_diff1[6];\n  assign launch_ok2 = !launch_diff2[6];\n  assign launch_ok3 = !launch_diff3[6];\n  assign launch_mask = {launch_ok3,launch_ok2 && !launch_ok3,launch_ok1 && !launch_ok2,!launch_ok1};\n  assign prefix_quotient = small_divisor ? {high_q,launch_ok2,launch_ok3 | (launch_ok1 && !launch_ok2)} : 0;\n  assign prefix_remainder = small_divisor ?\n    (({4{launch_mask[0]}} & launch_window) |\n     ({4{launch_mask[1]}} & launch_diff1[3:0]) |\n     ({4{launch_mask[2]}} & launch_diff2[3:0]) |\n     ({4{launch_mask[3]}} & launch_diff3[3:0])) : prefix;\n\n  // Six-bit bootstrap: two radix-8 cells, ten-bit total prefix.\n  assign narrow_r[0] = {6'\"'d0,remainder_q[3:0]};\n  assign narrow_d[1] = {3'd0,divisor_q[9:0]};\n  assign narrow_d[2] = {2'd0,divisor_q[9:0],1'b0};\n  assign narrow_d[3] = narrow_d[1]+narrow_d[2];\n  assign narrow_d[4] = {1'd0,divisor_q[9:0],2'b00};\n  assign narrow_d[5] = narrow_d[1]+narrow_d[4];\n  assign narrow_d[6] = {narrow_d[3][11:0],1'b0};\n  assign narrow_d[7] = {divisor_q[9:0],3'b000}-narrow_d[1];\n  for (genvar s=0; s<2; s++) begin : g_prefix\n    logic [12:0] window;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [10:0] diff [1:7] /* verilator split_var */;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic [7:1] ok;\n    logic [7:0] mask;\n    logic [9:0] restored;\n    logic [2:0] digit;\n    assign window = {narrow_r[s],quotient_q[31-3*s -: 3]};\n    for (genvar k=1; k<8; k++) begin : g_trial\n      assign diff[k] = {1'b0,window[9:0]}-{1'b0,narrow_d[k][9:0]};\n      assign ok[k] = narrow_d[k][12:10] == 0 && \"'!diff[k][10];\n      if (k==7) assign mask[k] = ok[k];\n      else assign mask[k] = ok[k] && !ok[k+1];\n    end\n    assign mask[0] = !ok[1];\n    always_comb begin\n      restored = {10{mask[0]}} & window[9:0];\n      digit = 0;\n      for (int k=1; k<8; k++) begin\n        restored = restored | ({10{mask[k]}} & diff[k][9:0]);\n        digit = digit | ({3{mask[k]}} & 3'\"'(k));\n      end\n    end\n    assign narrow_r[s+1] = restored;\n    assign narrow_digit[5-3*s -: 3] = digit;\n  end\n  assign first_quotient = {quotient_q[25:0],narrow_digit & {6{divisor_q[31:10] == 0}}};\n  assign first_remainder = divisor_q[31:10] \"'!= 0\n    ? {22'\"'d0,remainder_q[3:0],quotient_q[31:26]} : {22'd0,narrow_r[2]};\n''' +s[end:]\ns=s.replace(\\\"remainder_q <= {26'd0, prefix_remainder};\\\", \\\"remainder_q <= {28'd0, prefix_remainder};\\\")\n(p/'rtl/div_unit.sv').write_text(s)\nprint(p)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
