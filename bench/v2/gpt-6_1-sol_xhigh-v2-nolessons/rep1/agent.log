$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[15046 of 18118 chars elided by tools/bench/transcript.py; sha256:ff86f3c1e32ad648]…\nsert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n1008:    rets, _ = await _run(dut, program)\n1010:    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n1025:    rets, dmem = await _run(dut, program)\n1047:    rets, _ = await _run(dut, program)\n1061:    rets, _ = await _run(dut, program)\n1070:    rets, _ = await _run(dut, program, max_cycles=20)\n1085:    rets, _ = await _run(dut, program)\n1090:def test_pipeline_runner():\n1091:    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n1093:    runner.build(\n1097:            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n1106:    runner.test(\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_div_unit.py\ncores/bench/test/test_ex_divider.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_predictor.py\ncores/bench/test/test_fetch_queue.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\n", "exit_code": 0, "status": "completed"}}
