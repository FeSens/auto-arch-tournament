, \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separatel\n…[10970 of 14042 chars elided by tools/bench/transcript.py; sha256:4dbd770f2761c068]…\npt, stall, valid in ((0, 0, 1), (1, 1, 1), (1, 0, 0)):\n        dut.early_accept.value = accept\n        dut.stall.value = stall\n        dut.early_in.value = payload(valid=valid)\n        await tick(dut)\n        assert int(dut.div_wait.value) == 0\n    dut.early_in.value = payload(rs1_val=0xfffffff6, rs2_val=3, op=ALU_REM)\n    dut.stall.value = 0\n    dut.early_accept.value = 1\n    await tick(dut)\n    dut.early_accept.value = 0\n    dut.early_in.value = 0\n    dut.stall.value = 1\n    for _ in range(15):\n        await tick(dut)\n        assert int(dut.div_wait.value) == 1\n        assert unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0\n    dut.stall.value = 0\n    await tick(dut)\n    out = unpack(EX_MEM, int(dut.out.value))\n    assert out[\"alu_result\"] == 0xffffffff\n    assert out[\"rs1_val\"] == 0xfffffff6 and out[\"rs2_val\"] == 3\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"div_unit.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n", "exit_code": 0, "status": "completed"}}
