{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nwt=Path.cwd()\np=Path('/srv/hwebench/tmp/e4e97874/d4582a8f/radix4_terminal_probe')\nr=build_all(wt,p/'rtl','fpga/core_bench_si.sv',p/'timing')\ns=summarize(r)\n(p/'timing.json').write_text(json.dumps({'results':r,'summary':s},indent=2))\nprint(json.dumps(s,indent=2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
