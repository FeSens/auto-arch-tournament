{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/_helpers.py\ncat cores/bench/test/conftest.py\ncat cores/bench/CORE_PHILOSOPHY.md\nsed -n '1,130p' tools/eval/_slots.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py\ncat cores/bench/test/conftest.py\ncat cores/bench/CORE_PHILOSOPHY.md\nsed -n '1,130p' tools/eval/_slots.py\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separatel\n…[1217 of 4289 chars elided by tools/bench/transcript.py; sha256:9930c4a8b862a0b3]…\n   d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypgen_compare')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'div_unit.sv'\ns=p.read_text().replace('logic [32:0] difference [0:4];','logic [31:0] difference [0:4];')\nbegin=s.index('    // A 33-bit subtraction')\nend=s.index('\\\\n  end\\\\n  // Correct both',begin)\ns=s[:begin]+'''    logic [32:0] trial;\n    logic [7:0] eq0, gt0;\n    logic [3:0] eq1, gt1;\n    logic [1:0] eq2, gt2;\n    logic eq3, gt3, take;\n    assign trial = {remainder_step[bit_step], quotient_step[bit_step][31]};\n    assign difference[bit_step] = trial[31:0] - divisor_q;\n    for (genvar block_index=0; block_index<8; block_index++) begin : g_leaf\n      assign eq0[block_index] = trial[4*block_index+:4] == divisor_q[4*block_index+:4];\n      assign gt0[block_index] = trial[4*block_index+:4] > divisor_q[4*block_index+:4];\n    end\n    for (genvar pair_index=0; pair_index<4; pair_index++) begin : g_pair\n      assign eq1[pair_index] = eq0[2*pair_index+1] & eq0[2*pair_index];\n      assign gt1[pair_index] = gt0[2*pair_index+1] | (eq0[2*pair_index+1] & gt0[2*pair_index]);\n    end\n    for (genvar half_index=0; half_index<2; half_index++) begin : g_half\n      assign eq2[half_index] = eq1[2*half_index+1] & eq1[2*half_index];\n      assign gt2[half_index] = gt1[2*half_index+1] | (eq1[2*half_index+1] & gt1[2*half_index]);\n    end\n    assign eq3 = eq2[1] & eq2[0];\n    assign gt3 = gt2[1] | (eq2[1] & gt2[0]);\n    assign take = trial[32] | gt3 | eq3;\n    assign remainder_step[bit_step+1] = take ? difference[bit_step] : trial[31:0];\n    assign quotient_step[bit_step+1] = {quotient_step[bit_step][30:0], take};'''+s[end:]\np.write_text(s)\nprint(rtl.resolve())\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build\nwt=Path.cwd()\nbase=wt/'cores/bench/generated/hypgen_compare'\nr=build(wt,base/'rtl','fpga/core_bench_si.sv',0,base/'gowin_p0')\n(base/'result0.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(r,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
