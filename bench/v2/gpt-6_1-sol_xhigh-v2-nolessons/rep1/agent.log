{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/test/test_ex_divider.py\nsed -n '1,160p' cores/bench/test/test_operand_stage.py\"", "aggregated_output": "\"\"\"Exercise EX's launch/hold/transfer protocol directly, including stalls\nafter arithmetic has completed, which an already-drained MEM stage normally\ncannot cause in this single-issue pipeline.\n\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, ALU_MUL, ALU_MULH,\n                      ALU_MULHU, ALU_MULHSU, run_cocotb)\n\n\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef pack(fields, values):\n    bits = 0\n    for name, width in fields:\n        bits = (bits << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return bits\n\n\ndef unpack(fields, bits):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = bits & ((1 << width) - 1)\n        bits >>= width\n    return result\n\n\ndef payload(op=ALU_DIV, **updates):\n    values = dict(pc=0x40, rs1_val=91, rs2_val=13, rd=3,\n                  rs1_addr=1, rs2_addr=2, instr=0x0220c1b3, valid=1,\n                  ctrl=pack(CTRL, dict(alu_op=op, reg_write=1)))\n    values.update(updates)\n    return pack(ID_EX, values)\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.early_accept.value = 0\n…[9865 of 12937 chars elided by tools/bench/transcript.py; sha256:15c47ddc4a828699]…\nse.value) == 0\n    dut.ex_rd.value = 2\n    dut[\"in\"].value = decoded()\n    dut.stall.value = dut.flush.value = 1\n    dut.accept.value = 0\n    await tick(dut)\n    assert unpack(ID_EX, int(dut.out.value))[\"valid\"] == 0\n    # The older load moves once to MEM; its aligned/extended value is captured.\n    dut.ex_load.value = 0\n    dut.mem_rd.value = 2\n    dut.mem_w_en.value = 1\n    dut.mem_result.value = 0xffffff80\n    dut.stall.value = dut.flush.value = 0\n    dut.accept.value = 1\n    await tick(dut)\n    out = unpack(ID_EX, int(dut.out.value))\n    assert out[\"valid\"] == 1 and out[\"rs2_val\"] == 0xffffff80\n    # Trapping/invalid producers are suppressed by their writer qualification.\n    dut.mem_w_en.value = 0\n    dut.rs2_data.value = 7\n    await tick(dut)\n    assert unpack(ID_EX, int(dut.out.value))[\"rs2_val\"] == 7\n\n\ndef test_operand_stage_runner():\n    run_cocotb(toplevel=\"operand_stage\",\n               sources=[\"core_pkg.sv\", \"forward_unit.sv\", \"operand_stage.sv\"],\n               test_module=\"test_operand_stage\")\n", "exit_code": 0, "status": "completed"}}
