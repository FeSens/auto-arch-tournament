e-<TARGET> and re-execs\n#              itself there. Lets two `make loop` invocations for different\n#              TARGETs run in parallel without git index/merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: `make loop TARGET=v1 WORKTREE=`.\nN        ?= 10\nK        ?= 1\nAGENT    ?\n…[27958 of 31030 chars elided by tools/bench/transcript.py; sha256:6f4f3aaa90481fb9]…\nmm = insn >> 20\n    imm = imm if imm < 0x800 else imm - 0x1000\n    jalr_target = ((a + imm) & mask) & ~1\n    jalr = opcode == 0x67 and funct3 == 0 and not (jalr_target & 3)\n    recover = bool((decode & 1) and not stalled and\n                   ((conditional and (effective != bool((decode >> 1) & 1))) or jalr))\n    assert int(dut.redirect.value) == int(recover)\n    if recover:\n        recovery_pc = jalr_target if jalr else pc + 4 if (decode >> 1) & 1 else branch_target\n        assert int(dut.redirect_target.value) == recovery_pc & mask\n        log[\"recovery\"].append((cycle, pc, (decode >> 1) & 1, recovery_pc, ready))\n        log[\"cleared\"].append((cycle, pc, list(queue), ready))\n\n    flush = int(dut.flush_id.value)\n    stall_id = int(dut.stall_id.value)\n    if not stall_id:\n        held_decode = (offered[0], offered[1], int(head_valid and not flush),\n                       int(head_valid and offered[2] and not flush))\n        if accept:\n            log[\"accepted\"].append((cycle, offered[0], bool(offered[2])))\n", "exit_code": 0, "status": "completed"}}
