{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1\n\ndef digit(q,r,d):\n    t=(r<<2)|(q>>30)\n    differences=[t-k*d for k in (1,2,3)]\n    ok1,ok2,ok3=[v>=0 for v in differences]\n    qdigit=(int(ok2)<<1)|int(ok3 or (ok1 and not ok2))\n    masks=(not ok1,ok1 and not ok2,ok2 and not ok3,ok3)\n    rnext=0\n    for enable,val in zip(masks,[t]+differences):\n        if enable: rnext |= val&MASK\n    return ((q<<2)|qdigit)&MASK,rnext\n\ndef proposed(a,b,signed,rem):\n    sa=a if not signed or a<(1<<31) else a-(1<<32)\n    sb=b if not signed or b<(1<<31) else b-(1<<32)\n    q,r,d=abs(sa),0,abs(sb)\n    # Preparation edge leaves dividend/remainder unchanged.\n    d3=d+(d<<1)\n    assert d3 < (1<<34)\n    for group in range(5):\n        for step in range(3): q,r=digit(q,r,d)\n    q,r=digit(q,r,d)\n    if signed and ((sa<0)\"'!=(sb<0)) and b!=0: q=(-q)&MASK\n    if signed and sa<0: r=(-r)&MASK\n    return r if rem else q\n\ndef reference(a,b,signed,rem):\n    if not b: return a if rem else MASK\n    sa=a if not signed or a<(1<<31) else a-(1<<32)\n    sb=b if not signed or b<(1<<31) else b-(1<<32)\n    q=abs(sa)//abs(sb)\n    if (sa<0)!=(sb<0): q=-q\n    return (sa-q*sb if rem else q)&MASK\n\ncorners=(0,1,2,3,7,0x3fffffff,0x40000000,0x7fffffff,0x80000000,0x80000001,0xfffffffd,0xfffffffe,MASK)\npairs=[(a,b) for a in corners for b in corners]\nrng=random.Random(0x4A51)\npairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(20000)]\ncount=0\nfor a,b in pairs:\n    for signed in (False,True):\n        for rem in (False,True):\n            actual=proposed(a,b,signed,rem)\n            expected=reference(a,b,signed,rem)\n            assert actual==expected,(a,b,signed,rem,actual,expected)\n            count+=1\nprint(f'\"'Proposed 30+2-bit recurrence: PASS, {count} independent exact-result comparisons')\nprint('This validates the algorithm model, not RTL or FPGA timing.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
