rn {\"place_option\": place_option, \"placement_failed\": True,\n162:                \"reason\": f\"Gowin build timeout after {BUILD_TIMEOUT_SEC}s\"}\n164:    if res[\"placement_failed\"]:\n170:def build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\n174:        futs = [ex.submit(build, worktree, rtl_dir, bench_sv, p,\n179:def summarize(results: list[dict]) -> dict:\n180:    \"\"\"Median Fmax over placement options; every option must fit (the flow\n182:    failed = [r for r in results if r[\"placement_failed\"]]\n184:        return {\"placement_failed\": True,\n189:        \"placement_failed\": False,\n199:def main(argv=None) -> int:\n202:    import argparse, json\n204:    ap = argparse.ArgumentParser()\n205:    ap.add_argument(\"target\")\n209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\n213:    res = build_all(wt, wt / \"cores\" / a.target / \"rtl\", _bench_sv(str(wt), a.target),\n214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\n216:        if r[\"placement_failed\"]:\n221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\nfpga/core_bench_si.sv\nfpga/constraints/Tang_Nano_20K.cst\nfpga/constraints/clock.sdc\nfpga/bench_stall_gen.sv\nfpga/core_bench.sv\nfpga/scripts/synth.tcl\nfpga/scripts/nextpnr_run.sh\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n","exit_code":0,"status":"completed"}}
