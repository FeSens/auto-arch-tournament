{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/e4e97874/7db20b19/operand_capture_probe')\nrtl=base/'spatial_rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n(rtl/'div_prefix_digit.sv').write_text('''module div_prefix_digit #(parameter integer P = 14) (\n  input logic [31:0] q,\n  input logic [P-3:0] r,\n  input logic [33:0] d1,d2,d3,\n  output logic [31:0] q_next,\n  output logic [P-1:0] r_next\n);\n  logic [P-1:0] window;\n  logic [P:0] diff1,diff2,diff3;\n  logic ok1,ok2,ok3;\n  logic [3:0] mask;\n  assign window = {r,q[31:30]};\n  assign diff1 = {1'b0,window} - {1'b0,d1[P-1:0]};\n  assign diff2 = {1'b0,window} - {1'b0,d2[P-1:0]};\n  assign diff3 = {1'b0,window} - {1'b0,d3[P-1:0]};\n  assign ok1 = (d1[33:P] == 0) && \"'!diff1[P];\n  assign ok2 = (d2[33:P] == 0) && !diff2[P];\n  assign ok3 = (d3[33:P] == 0) && !diff3[P];\n  assign mask = {ok3,ok2 && !ok3,ok1 && !ok2,!ok1};\n  assign r_next = ({P{mask[0]}} & window) |\n                  ({P{mask[1]}} & diff1[P-1:0]) |\n                  ({P{mask[2]}} & diff2[P-1:0]) |\n                  ({P{mask[3]}} & diff3[P-1:0]);\n  assign q_next = {q[29:0],ok2,ok3 | (ok1 & !ok2)};\nendmodule\n'\"''')\np=rtl/'div_unit.sv'\ns=p.read_text()\ns=s.replace('  logic [31:0] run_q [0:2] /* verilator split_var */;\\\\n  logic [31:0] run_r [0:2] /* verilator split_var */;','''  wire [31:0] spatial_q [0:5];\n  wire [31:0] spatial_r [0:5];\n  wire [31:0] terminal_q, terminal_r;''')\na=s.index('  assign run_q[0] = quotient_q;')\nb=s.index('  // Terminal trials',a)\ns=s[:a]+'''  assign spatial_q[0] = quotient_q;\n  assign spatial_r[0] = remainder_q;\n  assign terminal_q = spatial_q[5];\n  assign terminal_r = spatial_r[5];\n  for (genvar stage = 0; stage < 5; stage++) begin : g_spatial\n    localparam integer P = 14 + 4*stage;\n    logic [31:0] q_mid,q_next,q_q;\n    logic [P-3:0] r_mid;\n    logic [P-1:0] r_next,r_q;\n    div_prefix_digit #(.P(P-2)) u_first (\n      .q(spatial_q[stage]), .r(spatial_r[stage][P-5:0]),\n      .d1(divisor_once), .d2(divisor_twice), .d3(triple_divisor_q),\n      .q_next(q_mid), .r_next(r_mid));\n    div_prefix_digit #(.P(P)) u_second (\n      .q(q_mid), .r(r_mid),\n      .d1(divisor_once), .d2(divisor_twice), .d3(triple_divisor_q),\n      .q_next(q_next), .r_next(r_next));\n    always_ff @(posedge clock) begin\n      if (reset) begin q_q <= 0; r_q <= 0; end\n      else if (state_q == RUN && group_q == 3'(stage+1)) begin\n        q_q <= q_next;\n        r_q <= r_next;\n      end\n    end\n    assign spatial_q[stage+1] = q_q;\n    assign spatial_r[stage+1] = {{(32-P){1'b0}},r_q};\n  end\n\n'''+s[b:]\ns=s.replace('assign final_window = {remainder_q, quotient_q[31:30]};','assign final_window = {terminal_r, terminal_q[31:30]};')\ns=s.replace('~quotient_q[29:0]','~terminal_q[29:0]').replace('(30\\\\'d0 - quotient_q[29:0])',\\\"(30'd0 - terminal_q[29:0])\\\").replace('assign positive_quotient = {quotient_q[29:0], 2\\\\'(k)};',\\\"assign positive_quotient = {terminal_q[29:0], 2'(k)};\\\")\ns=s.replace('''          end else begin\n            quotient_q <= run_q[2];\n            remainder_q <= run_r[2];\n          end''','''          end''')\np.write_text(s)\nprint('Spatial scratch RTL prepared')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
