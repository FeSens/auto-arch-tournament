{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\ns=Path('cores/bench/generated/hypgen_r11s0')\n(s/'test').mkdir(exist_ok=True)\nfor name in ['_helpers.py','conftest.py','test_pipeline.py','test_alu.py']:\n shutil.copy2(Path('cores/bench/test')/name,s/'test'/name)\n(s/'test/test_mul_share.py').write_text('''import os,random\nimport cocotb\nfrom cocotb.triggers import Timer\n\nMASK=(1<<32)-1\ndef signed(x):return x if x<1<<31 else x-(1<<32)\n\n@cocotb.test()\nasync def independent_products(dut):\n    rng=random.Random(1100)\n    isolated=int(os.environ[\\\"TEST_SEPARATE\\\"])\n    corners=[0,1,2,3,0x7fffffff,0x80000000,0xffffffff,0xfffffffe,\n             0x0000ffff,0xffff0000,0x00010000,0x55555555,0xaaaaaaaa]\n    pairs=[(a,b) for a in corners for b in corners]\n    pairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(4096)]\n    checks=0\n    for a,b in pairs:\n        for op in [11,12,13,14]:\n            dut.op.value=op\n            dut.a.value=rng.getrandbits(32) if isolated else a\n            dut.b.value=rng.getrandbits(32) if isolated else b\n            dut.mul_a.value=a if isolated else rng.getrandbits(32)\n            dut.mul_b.value=b if isolated else rng.getrandbits(32)\n            pa=signed(a) if op in [12,14] else a\n            pb=signed(b) if op==12 else b\n            expected=(pa*pb) if op==11 else ((pa*pb)>>32)\n            await Timer(1,unit=\\\"ns\\\")\n            got=int(dut.out.value)\n            assert got==(expected&MASK),(isolated,op,a,b,hex(got),hex(expected&MASK))\n            checks+=1\n    dut._log.info(\\\"%d independent integer-product checks passed; isolated=%d\\\",checks,isolated)\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
