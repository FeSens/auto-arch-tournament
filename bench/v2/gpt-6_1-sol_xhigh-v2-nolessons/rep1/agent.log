{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\noriginal=Path('/srv/hwebench/tmp/e4e97874/b737a704/alu.original.sv').read_text()\nstart=original.index('  // 64-bit products, computed once and selected per op.')\nend=original.index('    case (op)',start)\nnew='''  logic signed [32:0] signed_a, signed_b;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] common_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign signed_a = \"'$signed({((op == ALU_MULH || op == ALU_MULHSU) & product_a[31]), product_a});\n  assign signed_b = $signed({((op == ALU_MULH) & product_b[31]), product_b});\n  assign common_product = signed_a * signed_b;\n\n  always_comb begin\n    shamt = b[4:0];\n\n'\"'''\ns=original[:start]+new+original[end:]\ns=s.replace('out = mul_uu[31:0]','out = common_product[31:0]').replace('out = \"'$unsigned(mul_ss[63:32])'\"','out = common_product[63:32]').replace('out = mul_uu[63:32]','out = common_product[63:32]').replace('out = \"'$unsigned(mul_su[63:32])'\"','out = common_product[63:32]')\nPath('cores/bench/rtl/alu.sv').write_text(s)\nPY\nmake lint TARGET=bench\npytest -q cores/bench/test/test_alu.py cores/bench/test/test_pipeline.py > /srv/hwebench/tmp/e4e97874/b737a704/native33-tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
