{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"sed -n '175,385p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py; cat formal/checks_si.cfg\"", "aggregated_output": "    regs = [0] * 32\n    memory = dict(dmem_init or {})\n    model_memory = dict(memory)\n    rets = []\n    stores = []\n    model_stores = []\n    stalled_request = None\n    directed_seen = set()\n    directed_left = 0\n\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = NOP()\n    dut.io_imemReady.value = 1\n    dut.io_dmemRData.value = 0\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, unit=\"ns\")\n        dut.clock.value = 1\n        await Timer(5, unit=\"ns\")\n        dut.clock.value = 0\n    dut.reset.value = 0\n\n    for cycle in range(2000):\n        ia = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = program[ia // 4] if ia // 4 < len(program) else EBREAK()\n        dut.io_imemReady.value = int(seed is None or rng.random() >= 0.22)\n        da = int(dut.io_dmemAddr.value)\n        ren = int(dut.io_dmemREn.value)\n        wen = int(dut.io_dmemWEn.value)\n        wd = int(dut.io_dmemWData.value)\n        request = (da, ren, wen, wd)\n        if stalled_request is not None:\n            assert request == stalled_request, \"outstanding dmem request changed under stall\"\n        key = (da, ren, wen)\n        if seed is not None and (ren or wen) and key not in directed_seen:\n            directed_seen.add(key)\n            directed_left = 9\n        ready = seed is None or (directed_left == 0 and rng.random() >= 0.22)\n        if directed_left:\n            directed_left -= 1\n        dut.io_dmemReady.value = int(ready)\n        dut.io_dmemRData.value = memory.get(da & ~3, 0)\n        await Timer(4, unit=\"ns\")\n        stalled_request = request if (ren or wen) and not ready else None\n        if wen and ready:\n            assert wen == 15 and da % 4 == 0\n            memory[da] = wd\n            stores.append((da, wd))\n\n        if int(dut.io_rvfi_valid_0.value):\n            index = len(rets)\n            assert index < len(expected_pcs), \"extra retirement\"\n            pc = int(dut.io_rvfi_pc_rdata_0.value)\n            assert pc == expected_pcs[index], f\"retirement {index}: PC {pc}, expect\n…[9504 of 12576 chars elided by tools/bench/transcript.py; sha256:c1ac42648d0dbc47]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
