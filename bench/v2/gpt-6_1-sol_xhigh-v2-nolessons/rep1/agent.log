{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_divider.py'", "aggregated_output": "\"\"\"Exercise EX's launch/hold/transfer protocol directly, including stalls\nafter arithmetic has completed, which an already-drained MEM stage normally\ncannot cause in this single-issue pipeline.\n\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_DIV, ALU_REM, ALU_MUL, ALU_MULH,\n                      ALU_MULHU, ALU_MULHSU, run_cocotb)\n\n\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef pack(fields, values):\n    bits = 0\n    for name, width in fields:\n        bits = (bits << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return bits\n\n\ndef unpack(fields, bits):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = bits & ((1 << width) - 1)\n        bits >>= width\n    return result\n\n\ndef payload(op=ALU_DIV, **updates):\n    values = dict(pc=0x40, rs1_val=91, rs2_val=13, rd=3,\n                  rs1_addr=1, rs2_addr=2, instr=0x0220c1b3, valid=1,\n                  ctrl=pack(CTRL, dict(alu_op=op, reg_write=1)))\n    values.update(updates)\n    return pack(ID_EX, values)\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.mul_fw\n…[6350 of 9422 chars elided by tools/bench/transcript.py; sha256:fbceabc5f83aa018]…\nresult\"] == expected\n        assert out[\"rs1_val\"] == a and out[\"rs2_val\"] == b\n        dut.fwd_load_data.value = 0xdeadbeef\n        await tick(dut)\n        assert unpack(EX_MEM, int(dut.out.value))[\"alu_result\"] == expected\n\n\n@cocotb.test()\nasync def redirects_require_valid_and_advance(dut):\n    await setup(dut)\n    ctrl = pack(CTRL, dict(is_branch=1, branch_op=0))\n    for valid, stall in ((0, 0), (1, 1), (0, 1)):\n        dut[\"in\"].value = payload(valid=valid, rs1_val=0, rs2_val=0, imm=8, ctrl=ctrl)\n        dut.stall.value = stall\n        await Timer(1, unit=\"ns\")\n        assert int(dut.redirect.value) == 0\n    dut[\"in\"].value = payload(rs1_val=0, rs2_val=0, imm=8, ctrl=ctrl)\n    dut.stall.value = 0\n    await Timer(1, unit=\"ns\")\n    assert int(dut.redirect.value) == 1\n    assert int(dut.redirect_target.value) == 0x48\n\n\ndef test_ex_divider_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"alu.sv\", \"div_unit.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_divider\")\n", "exit_code": 0, "status": "completed"}}
