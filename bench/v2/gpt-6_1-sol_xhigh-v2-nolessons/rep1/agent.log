{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypgen_onehot'); rtl=base/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv'; s=p.read_text(); anchor='    logic [31:0] instr;\\\\n    logic        predicted_taken;\\\\n    logic        valid;\\\\n  } id_ex_t;'; s=s.replace(anchor,'    logic [18:0] alu_onehot;\\\\n'+anchor); assert 'alu_onehot' in s; p.write_text(s)\np=rtl/'id_stage.sv'; s=p.read_text(); anchor='        reg_q.ctrl     <= ctrl_decoded;'; s=s.replace(anchor,anchor+'\\\\n        for (int op_index=0; op_index<19; op_index++)\\\\n          reg_q.alu_onehot[op_index] <= dec_alu_op == 5\\\\'(op_index);'); p.write_text(s)\np=rtl/'ex_stage.sv'; s=p.read_text().replace(\\\".SEPARATE_MUL_OPERANDS(1'b1))\\\", \\\".SEPARATE_MUL_OPERANDS(1'b1), .PREDECODED_OP(1'b1))\\\").replace('    .op  (in.ctrl.alu_op),','    .op  (in.ctrl.alu_op),\\\\n    .op_onehot (in.alu_onehot),'); p.write_text(s)\np=rtl/'alu.sv'; s=p.read_text().replace(\\\"parameter bit SEPARATE_MUL_OPERANDS = 1'b0\\\", \\\"parameter bit SEPARATE_MUL_OPERANDS = 1'b0,\\\\n  parameter bit PREDECODED_OP = 1'b0\\\").replace('  input  logic [4:0]  op,','  input  logic [4:0]  op,\\\\n  input  logic [18:0] op_onehot,')\nbegin=s.index('    case (op)',s.index('    mul_ss ='))\nend=s.index('\\\\n  end\\\\n\\\\nendmodule',begin)\ncase=s[begin:end]\ns=s[:begin]+'  end\\\\n\\\\n  function automatic [31:0] calculate(input logic [4:0] selected_op);\\\\n'+case.replace('case (op)','case (selected_op)').replace('out =','calculate =')+'\\\\n  endfunction\\\\n\\\\n  generate\\\\n    if (PREDECODED_OP) begin : g_onehot\\\\n      wire [31:0] result[0:18];\\\\n      for (genvar result_index=0; result_index<19; result_index++) begin : g_result\\\\n        assign result[result_index] = calculate(5\\\\'(result_index));\\\\n      end\\\\n      for (genvar bit_index=0; bit_index<32; bit_index++) begin : g_bit\\\\n        wire [18:0] terms;\\\\n        for (genvar term_index=0; term_index<19; term_index++) begin : g_term\\\\n          assign terms[term_index] = op_onehot[term_index] & result[term_index][bit_index];\\\\n        end\\\\n        assign out[bit_index] = |terms;\\\\n      end\\\\n    end else begin : g_encoded\\\\n      always_comb out = calculate(op);\\\\n    end\\\\n  endgenerate\\\\n\\\\nendmodule\\\\n'\np.write_text(s)\nprint('onehot prototype written')\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build\nwt=Path.cwd(); base=wt/'cores/bench/generated/hypgen_onehot'\nr=build(wt,base/'rtl','fpga/core_bench_si.sv',0,base/'gowin_p0')\n(base/'result0.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(r,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
