{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])\nfor name,early_sign in [('branch-normalized-polarity',False),('branch-predecoded-verify',True)]:\n rtl=root/name/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for src in (root/'branch-normalized/rtl').glob('*.sv'):shutil.copy2(src,rtl/src.name)\n f=rtl/'core_pkg.sv';s=f.read_text();needle='    logic [31:0] instr;\\\\n    logic        predicted_taken;\\\\n    logic        valid;\\\\n  } id_ex_t;'\n flags='    logic branch_recovery_invert;\\\\n'\n if early_sign: flags+='    logic branch_compare_sign1, branch_compare_sign2;\\\\n'\n assert needle in s;s=s.replace(needle,flags+needle);f.write_text(s)\n f=rtl/'operand_stage.sv';s=f.read_text()\n line='        reg_q.predicted_taken <= in.predicted_taken;'\n add='        reg_q.branch_recovery_invert <= in.ctrl.branch_op[0] \"'^ in.predicted_taken;'\"\\\\n'\n if early_sign:\n  add+='''        reg_q.branch_compare_sign1 <= (in.rs1_addr \"'!= 0 && value1[31]) ''^ !in.ctrl.branch_op[1];\n        reg_q.branch_compare_sign2 <= (in.rs2_addr != 0 && value2[31]) ''^ !in.ctrl.branch_op[1];\n'\"'''\n s=s.replace(line,add+line);f.write_text(s)\n f=rtl/'ex_stage.sv';s=f.read_text()\n s=s.replace('  logic branch_signed_order, branch_equal, branch_less;','  logic branch_signed_order, branch_equal, branch_less, branch_wrong;')\n s=s.replace('  logic        branch_cond;','  assign branch_wrong = (in.ctrl.branch_op[2] ? branch_less : branch_equal) \"'^ in.branch_recovery_invert;'\"\\\\n  logic        branch_cond;')\n s=s.replace('(effective_taken \"'^ in.predicted_taken)'\"','(misalign_fault ? in.predicted_taken : branch_wrong)')\n # effective_taken becomes unused after direct verifier input replaces it.\n s=s.replace('logic ex_accept, effective_taken;','logic ex_accept;')\n s=s.replace('  assign effective_taken = branch_taken && \"'!in.ctrl.is_illegal