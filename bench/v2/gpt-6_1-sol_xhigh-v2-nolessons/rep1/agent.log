{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport pickle\ntrace=pickle.load(open('/srv/hwebench/tmp/e4e97874/ef0e9924/predictor_control.pkl','rb'))\nbr=[]\nfor pc,npc,insn,timed in trace:\n if insn&127==0x63:\n  imm=((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1)\n  if imm&4096:imm-=8192\n  taken=int(npc==((pc+imm)&0xffffffff))\n  br.append((pc>>2,taken,timed,int(imm<0)))\nfor n in (32,64,128,256):\n mask=n-1;shift=(n.bit_length()-1)\n for bits in (1,2):\n  tab=[1 if bits==1 else 2]*n;miss=0\n  for p,t,tm,bias in br:\n   idx=(p\"'^(p>>shift))&mask;pred=tab[idx] if bits==1 else tab[idx]>>1\n   miss+=tm and pred!=t\n   tab[idx]=t if bits==1 else min(3,tab[idx]+1) if t else max(0,tab[idx]-1)\n  print('\"'bimodal',n,bits,'miss',miss)\nfor hbits in (1,2,3,4):\n for hsize in (16,32,64):\n  for psize in (64,128,256):\n   h=[0]*hsize;pht=[2]*psize;miss=0;hm=hsize-1;pm=psize-1;hs=hsize.bit_length()-1;ps=psize.bit_length()-1\n   for p,t,tm,bias in br:\n    hi=(p\"'^(p>>hs))&hm\n    idx=((p''^(p>>ps))''^h[hi])&pm\n    miss+=tm and (pht[idx]>>1)!=t\n    pht[idx]=min(3,pht[idx]+1) if t else max(0,pht[idx]-1)\n    h[hi]=((h[hi]<<1)|t)&((1<<hbits)-1)\n   print('\"'local',hsize,hbits,psize,'miss',miss)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
