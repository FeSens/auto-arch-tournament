{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nbackup=Path('/srv/hwebench/tmp/e4e97874/b737a704')\nfor name in ['core_pkg.sv','operand_stage.sv','ex_stage.sv']:\n p=Path('cores/bench/rtl')/name\n (backup/(name+'.original')).write_text(p.read_text())\np=Path('cores/bench/rtl/core_pkg.sv'); s=p.read_text(); s=s.replace('// OF/EX: both operands are fully resolved at the accepting edge.\\\\n  typedef struct packed {\\\\n    logic [31:0] pc;', '// OF/EX: both operands are fully resolved at the accepting edge.\\\\n  typedef struct packed {\\\\n    logic [31:0] pc;\\\\n    logic mul_signed_a;\\\\n    logic mul_signed_b;'); p.write_text(s)\np=Path('cores/bench/rtl/operand_stage.sv'); s=p.read_text(); s=s.replace('reg_q.pc <= in.pc;', '''reg_q.pc <= in.pc;\n        reg_q.mul_signed_a <= in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU;\n        reg_q.mul_signed_b <= in.ctrl.alu_op == ALU_MULH;'''); p.write_text(s)\np=Path('cores/bench/rtl/ex_stage.sv'); s=p.read_text().replace('.SEPARATE_MUL_OPERANDS(1\\\\'b1)', '.SEPARATE_MUL_OPERANDS(1\\\\'b1), .PREDECODED_MUL_SIGNS(1\\\\'b1)').replace('.mul_a (rs1),', '.mul_signed_a (in.mul_signed_a),\\\\n    .mul_signed_b (in.mul_signed_b),\\\\n    .mul_a (rs1),'); p.write_text(s)\np=Path('cores/bench/rtl/alu.sv'); s=p.read_text().replace(\\\"parameter bit SEPARATE_MUL_OPERANDS = 1'b0\\\", \\\"parameter bit SEPARATE_MUL_OPERANDS = 1'b0,\\\\n  parameter bit PREDECODED_MUL_SIGNS = 1'b0\\\").replace('input  logic [31:0] mul_a,','input  logic mul_signed_a, mul_signed_b,\\\\n  input  logic [31:0] mul_a,').replace('((op == ALU_MULH || op == ALU_MULHSU) & product_a[31])', '((PREDECODED_MUL_SIGNS ? mul_signed_a : (op == ALU_MULH || op == ALU_MULHSU)) & product_a[31])').replace('((op == ALU_MULH) & product_b[31])','((PREDECODED_MUL_SIGNS ? mul_signed_b : op == ALU_MULH) & product_b[31])'); p.write_text(s)\np=Path('cores/bench/test/test_ex_divider.py'); (backup/'test_ex_divider.py.original').write_text(p.read_text()); s=p.read_text().replace('ID_EX = [(\\\"pc\\\", 32),', 'ID_EX = [(\\\"pc\\\", 32), (\\\"mul_signed_a\\\", 1), (\\\"mul_signed_b\\\", 1),'); p.write_text(s)\nPY\nmake lint TARGET=bench\npytest -q cores/bench/test/test_alu.py cores/bench/test/test_pipeline.py cores/bench/test/test_operand_stage.py cores/bench/test/test_ex_divider.py > /srv/hwebench/tmp/e4e97874/b737a704/predecode33-tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
