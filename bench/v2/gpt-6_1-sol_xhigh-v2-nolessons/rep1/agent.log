{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl'); dst=Path('cores/bench/generated/microopt_exploration/radix8_4/rtl')\ndst.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'): shutil.copy2(p,dst/p.name)\np=dst/'div_unit.sv'; s=p.read_text()\nstart=s.index('  logic [31:0] quotient_q'); end=s.index('\"'`endif'\"',start)\ns=s[:start]+'''  logic [31:0] quotient_q, remainder_q, divisor_q;\n  logic [34:0] divisor_three_q, divisor_five_q, divisor_seven_q;\n  logic quotient_neg_q, remainder_neg_q, select_rem_q;\n  logic signed_op;\n  wire [31:0] magnitude_b = (signed_op && b[31]) ? (32'd0 - b) : b;\n  wire [34:0] extended_b = {3'b0,magnitude_b};\n  wire [31:0] quotient_first, remainder_first, quotient_done, remainder_done;\n  wire terminal = group_q == 3'd6;\n  wire [31:0] quotient_second_input = terminal ? quotient_q : quotient_first;\n  wire [31:0] remainder_second_input = terminal ? remainder_q : remainder_first;\n  wire [31:0] quotient_signed = quotient_neg_q\n    ? 32'd0 - quotient_done : quotient_done;\n  wire [31:0] remainder_signed = remainder_neg_q\n    ? 32'd0 - remainder_done : remainder_done;\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  restoring_digit #(.BITS(3)) first_digit (\n    .r(remainder_q),.q(quotient_q),.d(divisor_q),\n    .d3(divisor_three_q),.d5(divisor_five_q),.d7(divisor_seven_q),\n    .rout(remainder_first),.qout(quotient_first));\n  restoring_digit #(.BITS(2)) second_digit (\n    .r(remainder_second_input),.q(quotient_second_input),.d(divisor_q),\n    .d3(divisor_three_q),.d5(divisor_five_q),.d7(divisor_seven_q),\n    .rout(remainder_done),.qout(quotient_done));\n'''+s[end:]\ns=s.replace(\\\"      divisor_q <= 32'd0;\\\",\\\"      divisor_q <= 32'd0;\\\\n      divisor_three_q <= 35'd0;\\\\n      divisor_five_q <= 35'd0;\\\\n      divisor_seven_q <= 35'd0;\\\")\ns=s.replace(\\\"      divisor_q <= (signed_op && b[31]) ? (32'd0 - b) : b;\\\",\\\"      divisor_q <= magnitude_b;\\\\n      divisor_three_q <= extended_b + (extended_b << 1);\\\\n      divisor_five_q <= extended_b + (extended_b << 2);\\\\n      divisor_seven_q <= (extended_b << 3) - extended_b;\\\")\ns=s.replace('quotient_q <= quotient_step[5];','quotient_q <= quotient_done;').replace('remainder_q <= remainder_step[5];','remainder_q <= remainder_done;')\ns+='''\nmodule restoring_digit #(parameter integer BITS=3) (\n  input wire [31:0] r,q,d,\n  input wire [34:0] d3,d5,d7,\n  output logic [31:0] rout,qout\n);\n  localparam integer MAX=(1<<BITS)-1;\n  wire [34:0] trial;\n  if (BITS==3) assign trial={r,q[31:29]};\n  else assign trial={1'b0,r,q[31:30]};\n  wire [34:0] multiple [1:7];\n  assign multiple[1]={3'b0,d};\n  assign multiple[2]={2'b0,d,1'b0};\n  assign multiple[3]=d3;\n  assign multiple[4]={1'b0,d,2'b0};\n  assign multiple[5]=d5;\n  assign multiple[6]={d3[33:0],1'b0};\n  assign multiple[7]=d7;\n  wire [35:0] difference [1:MAX];\n  wire [MAX:1] ok;\n  wire [MAX:0] choose;\n  assign choose[0]=\"'!ok[1];\n  for (genvar i=1;i<=MAX;i++) begin : g_trial\n    assign difference[i]={1'\"'b0,trial}-{1'b0,multiple[i]};\n    assign ok[i]=\"'!difference[i][35];\n    if (i==MAX) assign choose[i]=ok[i];\n    else assign choose[i]=ok[i]&&!ok[i+1];\n  end\n  logic [BITS-1:0] digit;\n  always_comb begin\n    rout=trial[31:0]&{32{choose[0]}};\n    digit='\"'0;\n    for (integer i=1;i<=MAX;i++) begin\n      rout=rout|(difference[i][31:0]&{32{choose[i]}});\n      digit=digit|(BITS'(i)&{BITS{choose[i]}});\n    end\n    qout={q[31-BITS:0],digit};\n  end\nendmodule\n'''\np.write_text(s)\nprint('Radix-8/4 scratch RTL ready')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
