   (train_index),\\\\n    .train_taken     (train_taken)\\\\n  );','    .redirect        (ex_redirect),\\\\n    .redirect_target (ex_redirect_target),\\\\n    .train_valid     (),\\\\n    .train_index     (),\\\\n    .train_taken     ()\\\\n  );'); s=s.replace('  ex_stage u_ex (\\\\n','  ex_stage u_ex (\\\\n    .older_kill      (mem_redirect),\\\\n'); insert='''\n  branch_verify u_branch_verify (\n    .reset (reset),\n    .in (ex_mem_w),\n    .redirect (mem_redirect),\n    .redirect_target (mem_redirect_target),\n    .train_valid (train_valid),\n    .train_index (train_index),\n    .train_taken (train_taken)\n  );\n  assign redirect = mem_redirect || ex_redirect;\n  assign redirect_target = mem_redirect ? mem_redirect_target : ex_redirect_target;\n\n'''; s=s.replace('  // ── MEM ─','  '+insert+'  // ── MEM ─'); p.write_text(s)\n(r/'branch_verify.sv').write_text('''module branch_verify (\n  input logic reset,\n  input ex_mem_t in,\n  output logic redirect,\n  output logic [31:0] redirect_target,\n  output logic train_valid,\n  output logic [5:0] train_index,\n  output logic train_taken\n);\n  logic cond, legal_branch, misalign, effective_taken;\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ: cond = (in.branch_rs1 == in.write_data);\n      BR_BNE: cond = (in.branch_rs1 \"'!= in.write_data);\n      BR_BLT: cond = ($signed(in.branch_rs1) < $signed(in.write_data));\n      BR_BGE: cond = ($signed(in.branch_rs1) >= $signed(in.write_data));\n      BR_BLTU: cond = (in.branch_rs1 < in.write_data);\n      BR_BGEU: cond = (in.branch_rs1 >= in.write_data);\n      default: cond = 1'\"'b0;\n    endcase\n    legal_branch = in.valid && in.ctrl.is_branch && \"'!in.ctrl.is_illegal && !reset;\n    misalign = cond && in.branch_target[1:0] != 2'\"'b00;\n    effective_taken = cond && \"'!misalign;\n    redirect = legal_branch && (effective_taken ''^ in.predicted_taken);\n    redirect_target = in.predicted_taken ? (in.pc + 32'\"'d4) : in.branch_target;\n    train_valid = legal_branch && \"'!misalign;\n    train_index = in.pc[7:2] ''^ in.pc[13:8];\n    train_taken = cond;\n  end\nendmodule\n'\"''')\nprint('Experimental RTL copied and branch verification retimed; repository RTL unchanged.')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
