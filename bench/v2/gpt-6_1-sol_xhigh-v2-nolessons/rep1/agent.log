ounter_msb_q[entry] <= counter_msb_q[entry] | hysteresis_q[entry/4];\n        else counter_msb_q[entry] <= counter_msb_q[entry] & hysteresis_q[entry/4];\n      end\n    end\n  end\n  for (genvar bank=0; bank<16; bank++) begin : g_hysteresis\n    wire prediction = counter_msb_q[bank*4 + train_index[1:0]];\n    always_ff @(posedge clock) begin\n      if (reset) hysteresis_q[bank] <= 1'b0;\n      else if (train_valid && train_index[5:2] == 4'(bank))\n        hysteresis_q[bank] <= train_taken\n          ? (prediction | \"'!hysteresis_q[bank])\n          : (prediction & !hysteresis_q[bank]);\n    end\n  end\n\n'\"'''+s[end:]\n p.write_text(s)\nprint('Four isolated predictor prototypes staged.')\nPY\nriscv32-unknown-elf-gcc -march=rv32im -mabi=ilp32 -O3 -static -nostartfiles -specs=nano.specs -specs=nosys.specs -T bench/programs/link.ld -Ibench/programs/coremark -Ibench/programs/coremark/baremetal -DTOTAL_DATA_SIZE=2000 bench/programs/coremark/core_list_join.c bench/programs/coremark/core_main.c bench/programs/coremark/core_matrix.c bench/programs/coremark/core_state.c bench/programs/coremark/core_util.c bench/programs/coremark/baremetal/core_portme.c bench/programs/crt0.S -o /srv/hwebench/tmp/e4e97874/5a8af2ba/coremark.elf\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
