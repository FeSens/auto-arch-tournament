    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b00\n…[6555 of 9627 chars elided by tools/bench/transcript.py; sha256:30d4e6b182b71a79]…\netch_pc\"], \"fetch PC did not follow queue acceptance/recovery\"\n    raw = int(dut.io_imemData.value)\n    branch = raw & 127 == 0x63 and (raw >> 12) & 7 not in (2, 3)\n    direct = branch or raw & 127 == 0x6f\n    fetch_index = _folded_index(fetch_pc)\n    target = (fetch_pc + _direct_offset(raw)) & mask\n    prediction = direct and not (target & 3) and (not branch or state[fetch_index] >= 2)\n    ready = int(dut.io_imemReady.value)\n    queue = log[\"queue\"]\n    offered = queue[0] if queue else (fetch_pc, raw, int(prediction))\n    head_valid = bool(queue) or bool(ready)\n    head = int(dut.if_id_w.value)\n    assert (head >> 34, (head >> 2) & mask, (head >> 1) & 1) == offered\n    assert (head & 1) == int(head_valid)\n    assert int(dut.head_valid.value) == int(head_valid)\n    assert int(dut.u_if.count_q.value) == len(queue)\n    accept = head_valid and not int(dut.stall_id.value) and not int(dut.flush_id.value)\n    assert int(dut.decode_accept.value) == int(accept)\n    fetch_accept = ready and (len(queue) < 2 or accept)\n", "exit_code": 0, "status": "completed"}}
