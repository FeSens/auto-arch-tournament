{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/e4e97874/4734851a/predictor_research')\nfor name,training in [('recovery_free_target_rtl',False),('recovery_feedback_rtl',True)]:\n dst=root/name;shutil.copytree(root/'recovery_refetch_rtl',dst,dirs_exist_ok=True)\n p=dst/'ex_stage.sv';s=p.read_text()\n s=s.replace(\\\"      redirect_target <= 32'd0;\\\\n\\\",'')\n s=s.replace('      if (resolve_redirect) redirect_target <= resolve_target;','')\n s=s.replace('  assign train_valid = ex_accept','  always_ff @(posedge clock) redirect_target <= resolve_target;\\\\n\\\\n  assign train_valid = ex_accept')\n if training:\n  s=s.replace('  assign train_valid = ex_accept && in.ctrl.is_branch &&\\\\n                       \"'!in.ctrl.is_illegal && !misalign_fault;'\"\\\\n  assign train_index = in.pc[7:2] \"'^ in.pc[13:8];'\"\\\\n  assign train_taken = branch_cond;', '''  always_ff @(posedge clock) begin\n    if (reset) train_valid <= 1'b0;\n    else train_valid <= ex_accept && in.ctrl.is_branch &&\n                       \"'!in.ctrl.is_illegal && !misalign_fault;\n    train_index <= in.pc[7:2] ''^ in.pc[13:8];\n    train_taken <= branch_cond;\n  end'\"''')\n p.write_text(s)\nprint('Prepared two branch-feedback register refinements.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
