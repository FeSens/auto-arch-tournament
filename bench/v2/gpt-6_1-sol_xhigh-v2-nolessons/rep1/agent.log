{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_ex_divider.py\"", "aggregated_output": "\"\"\"Exercise EX's launch/hold/transfer protocol directly, including stalls\nafter arithmetic has completed, which an already-drained MEM stage normally\ncannot cause in this single-issue pipeline.\n\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, ALU_MUL, ALU_MULH,\n                      ALU_MULHU, ALU_MULHSU, run_cocotb)\n\n\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef pack(fields, values):\n    bits = 0\n    for name, width in fields:\n        bits = (bits << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return bits\n\n\ndef unpack(fields, bits):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = bits & ((1 << width) - 1)\n        bits >>= width\n    return result\n\n\ndef payload(op=ALU_DIV, **updates):\n    values = dict(pc=0x40, rs1_val=91, rs2_val=13, rd=3,\n                  rs1_addr=1, rs2_addr=2, instr=0x0220c1b3, valid=1,\n                  ctrl=pack(CTRL, dict(alu_op=op, reg_write=1)))\n    values.update(updates)\n    return pack(ID_EX, values)\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.rvfi_mem_rd.value = 0\n\n…[7501 of 10573 chars elided by tools/bench/transcript.py; sha256:cdddc8de83eb2911]…\n\"valid\"] == 0\n        assert int(dut.div_wait.value) == int(elapsed < 6)\n    second = payload(op=ALU_REM, pc=0x44, rs1_val=0xfffffff2,\n                     rs2_val=3, rd=4, rs1_addr=3, instr=0x0221e233)\n    await tick(dut)  # L+7=P+8: first publication; next OF capture.\n    first_out = unpack(EX_MEM, int(dut.out.value))\n    assert first_out[\"alu_result\"] == 0xfffffff2\n    assert first_out[\"rs1_val\"] == 0xffffff9b and first_out[\"rs2_val\"] == 7\n    dut[\"in\"].value = second\n    await tick(dut)  # L+8: the next registered divide launches.\n    for elapsed in range(1, 7):\n        await tick(dut)\n        assert unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0\n        assert int(dut.div_wait.value) == int(elapsed < 6)\n    assert int(dut.div_wait.value) == 0\n    await tick(dut)\n    second_out = unpack(EX_MEM, int(dut.out.value))\n    assert second_out[\"alu_result\"] == 0xfffffffe\n    assert second_out[\"pc\"] == 0x44 and second_out[\"rd\"] == 4\n    assert second_out[\"rs1_val\"] == 0xfffffff2 and second_out[\"rs2_val\"] == 3\n\n\n", "exit_code": 0, "status": "completed"}}
