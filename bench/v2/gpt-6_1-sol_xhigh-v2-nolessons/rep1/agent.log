r\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[30312 of 33384 chars elided by tools/bench/transcript.py; sha256:078cb6e8aa5cef92]…\nbench/test/test_operand_stage.py:6:from test_ex_divider import CTRL, ID_EX, pack, unpack\ncores/bench/test/test_operand_stage.py:10:         (\"ctrl\", 22), (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\ncores/bench/test/test_operand_stage.py:16:                  instr=0x0220c1b3, ctrl=pack(CTRL, dict(alu_op=ALU_DIV, reg_write=1)))\ncores/bench/test/test_operand_stage.py:59:        out = unpack(ID_EX, int(dut.out.value))\ncores/bench/test/test_operand_stage.py:69:    assert unpack(ID_EX, int(dut.out.value))[\"rs1_val\"] == 0xfffffff2\ncores/bench/test/test_operand_stage.py:78:    out = unpack(ID_EX, int(dut.out.value))\ncores/bench/test/test_operand_stage.py:105:    assert unpack(ID_EX, int(dut.out.value))[\"rs1_val\"] == 202\ncores/bench/test/test_operand_stage.py:137:    assert unpack(ID_EX, int(dut.out.value))[\"valid\"] == 0\ncores/bench/test/test_operand_stage.py:146:    out = unpack(ID_EX, int(dut.out.value))\ncores/bench/test/test_operand_stage.py:152:    assert unpack(ID_EX, int(dut.out.value))[\"rs2_val\"] == 7\n", "exit_code": 0, "status": "completed"}}
