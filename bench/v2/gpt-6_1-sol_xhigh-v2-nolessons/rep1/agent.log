SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)             \n…[5420 of 8492 chars elided by tools/bench/transcript.py; sha256:64cdec91f48b4f06]…\nLU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\ncores/bench/rtl/alu.sv:69:      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\ncores/bench/rtl/alu.sv:70:      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\ncores/bench/rtl/alu.sv:76:      ALU_DIV: begin\ncores/bench/rtl/alu.sv:84:      ALU_DIVU: out = (b == 32'b0) ? 32'hFFFFFFFF : (a / b);\ncores/bench/rtl/alu.sv:85:      ALU_REM: begin\ncores/bench/rtl/alu.sv:93:      ALU_REMU: out = (b == 32'b0) ? a : (a % b);\ntools/eval/gowin.py:75:def critical_paths(tr_text: str, n: int = 5) -> list[dict]:\ntools/eval/gowin.py:100:                    \"logic_cells\": len(cells), \"modules\": mods})\ntools/eval/gowin.py:124:        \"critical_paths\": critical_paths(t),\ntools/eval/gowin.py:195:        \"critical_path\": (ref.get(\"critical_paths\") or [None])[0],\ntools/eval/gowin.py:222:        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\ntools/eval/gowin.py:223:            print(f\"  path {i}: {p['arrival_ns']} ns, {p['logic_cells']} cells, {p['from']} -> {p['to']}\")\n", "exit_code": 0, "status": "completed"}}
