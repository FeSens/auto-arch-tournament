{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport sys, collections, json\nsys.path.insert(0,str(Path('test/cosim').resolve()))\nfrom reference import RV32IM\ns=Path('/srv/hwebench/tmp/e4e97874/4dc3a9ac/predictor_probe')\ncpu=RV32IM(); cpu.load_elf(str(s/'coremark.elf'))\nbranches=[]\nactive=False; total=0\nfor i in range(10000000):\n r=cpu.step()\n if r is None: raise RuntimeError('Invalid reference step')\n if r['mem_addr']==0x10000100 and r['mem_wmask']: active=True\n if r['mem_addr']==0x10000104 and r['mem_wmask']: active=False\n if r['insn']&127==0x63:\n  taken=int(r['npc']\"'!=((r['\"'pc']+4)&0xffffffff))\n  branches.append((r['pc'],r['insn'],taken,int(active)))\n if active: total+=1\n if r['insn']==0x00100073: break\nelse: raise RuntimeError('No completion')\n(s/'branches.json').write_text(json.dumps(branches))\nprint(json.dumps({'retired':cpu.retired,'timed_retired':total,'branches':len(branches),'timed_branches':sum(r[3] for r in branches),'oob':cpu.oob_access}))\nfor agree in (False,True):\n table=[2]*64; misses=0\n for pc,insn,taken,timed in branches:\n  j=((pc>>2)\"'^(pc>>8))&63\n  bias=insn>>31\n  pred=int(table[j]>=2)\n  if agree: pred=int(pred==bias)\n  misses+=int(pred!=taken)*timed\n  outcome=int(taken==bias) if agree else taken\n  table[j]=min(3,table[j]+1) if outcome else max(0,table[j]-1)\n print('\"'sequential_replay', 'agree' if agree else 'baseline', 'timed_direction_misses',misses)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
