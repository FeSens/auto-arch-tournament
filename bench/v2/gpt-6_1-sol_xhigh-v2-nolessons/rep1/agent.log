{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1\n\ndef mixed_divmod(a,d):\n q,r=a,0\n def digit(q,r):\n  t=(r<<2)|(q>>30)\n  differences=[t-k*d for k in (1,2,3)]\n  ok=[x>=0 for x in differences]\n  assert not ok[2] or ok[1]\n  assert not ok[1] or ok[0]\n  value=(2*int(ok[1])) | int(ok[2] or (ok[0] and not ok[1]))\n  selected=t-value*d\n  assert 0 <= selected <= MASK\n  if d: assert selected<d\n  return ((q<<2)|value)&MASK,selected\n for _ in range(6):\n  q,r=digit(q,r)\n  q,r=digit(q,r)\n  trial=(r<<1)|(q>>31)\n  bit=int(trial>=d)\n  r=trial-bit*d\n  q=((q<<1)|bit)&MASK\n  if d: assert r<d\n return digit(q,r)\n\ndef actual(op,a,b):\n signed=op in ('DIV','REM')\n a_neg=signed and bool(a>>31)\n b_neg=signed and bool(b>>31)\n a_mag=(-a)&MASK if a_neg else a\n b_mag=(-b)&MASK if b_neg else b\n q,r=mixed_divmod(a_mag,b_mag)\n if signed and (a_neg\"'!=b_neg) and b: q=(-q)&MASK\n if a_neg: r=(-r)&MASK\n return r if op in ('\"'REM','REMU') else q\n\ndef reference(op,a,b):\n if op in ('DIV','REM'):\n  a=a-(1<<32) if a>>31 else a\n  b=b-(1<<32) if b>>31 else b\n if not b: return (a&MASK) if op in ('REM','REMU') else MASK\n magnitude=abs(a)//abs(b)\n q=-magnitude if (a<0)\"'!=(b<0) else magnitude\n r=a-q*b\n return (r if op in ('\"'REM','REMU') else q)&MASK\n\nedges=[0,1,2,3,7,15,31,32,33,127,255,1023,32767,65535,(1<<30)-1,1<<30,(1<<31)-1,1<<31,(1<<31)+1,MASK-1,MASK]\nrng=random.Random(20261004)\npairs=[(a,b) for a in edges for b in edges]\npairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000)]\ncount=0\nfor a,b in pairs:\n for op in ('DIV','DIVU','REM','REMU'):\n  assert actual(op,a,b)==reference(op,a,b),(op,hex(a),hex(b))\n  count+=1\nprint(f'Mixed-radix arithmetic model: {count} independent RV32M result comparisons passed.')\nprint('This checks the proposed recurrence; no RTL or FPGA timing experiment was run.')\nPY\"","aggregated_output":"","exit_code":nu