{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random,json,yaml,jsonschema\nfrom pathlib import Path\nMASK=(1<<32)-1\n\ndef digit(t,d,bits,width,mwidth):\n multiple=[j*d for j in range(1<<bits)]\n ok=[True]+[(m>>width)==0 and t>= (m&((1<<width)-1)) for m in multiple[1:]]+[False]\n winners=[j for j in range(1<<bits) if ok[j] and not ok[j+1]]\n assert len(winners)==1\n j=winners[0]\n return j,t-multiple[j]\n\ndef model(a,b,op):\n signed=op in (15,17)\n aa=a-(1<<32) if signed and a>>31 else a\n bb=b-(1<<32) if signed and b>>31 else b\n A,D=abs(aa),abs(bb)\n prefix=A>>28\n q,r=divmod(prefix,D) if D else (15,prefix)\n assert r < (1<<4)\n for n,shift,width in ((5,23,9),(5,18,14),(3,15,35),(3,12,35),(3,9,35),(3,6,35),(3,3,35)):\n  t=(r<<n)|((A>>shift)&((1<<n)-1))\n  if width in (9,14) and D >= (1<<14): j,r=0,t\n  else:j,r=digit(t,D,n,width,19 if width in (9,14) else 35)\n  q=(q<<n)|j\n  assert r < (1<<(32-shift))\n t=(r<<3)|(A&7)\n k,r=digit(t,D,3,35,35)\n if op in (17,18):result=-r if aa<0 else r\n elif D and (aa<0)\"'!=(bb<0):result=(((-q)<<3)-k)\n else:result=(q<<3)|k\n return result&MASK\n\ndef oracle(a,b,op):\n if not b:return a if op in (17,18) else MASK\n if op in (16,18):return (a//b if op==16 else a%b)&MASK\n aa=a-(1<<32) if a>>31 else a;bb=b-(1<<32) if b>>31 else b\n q=abs(aa)//abs(bb)\n if (aa<0)!=(bb<0):q=-q\n return (q if op==15 else aa-q*bb)&MASK\nedges=[0,1,2,7,31,511,512,513,16383,16384,16385,0x7fffffff,0x80000000,0xfffffffe,MASK]\npairs=[(a,b) for a in edges for b in edges]\nrng=random.Random(1501)\npairs += [(rng.getrandbits(32),rng.getrandbits(rng.randrange(1,33))) for _ in range(5000)]\nfor op in (15,16,17,18):\n for a,b in pairs:assert model(a,b,op)==oracle(a,b,op),(op,a,b)\np=Path('\"'cores/bench/experiments/hypotheses/hyp-20261005-002-r15s1.yaml')\nh=yaml.safe_load(p.read_text())\nh['hypothesis']+='\\\\n\\\\nAn independent Python model of the exact 4/10/15/3 partition passed 20,900 directed/random signed and unsigned quotient/remainder cases, including zero divisors and prefix-width boundaries. This checks the arithmetic partition, not SystemVerilog implementation, formal progress or vendor timing. No measured fitness gain is claimed.'\np.write_text(yaml.safe_dump(h,sort_keys=False,width=95))\njsonschema.validate(h,json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('Arithmetic partition: 20,900 exact-result cases passed. Final YAML schema: passed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
