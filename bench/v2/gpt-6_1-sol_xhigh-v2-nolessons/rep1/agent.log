{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/e4e97874/5a8af2ba'); r=root/'predictor_bankedram'; r.mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,r/p.name)\np=r/'if_stage.sv'; s=p.read_text()\ns=s.replace('logic [63:0] counter_msb_q, counter_lsb_q;', '''logic [63:0] trained_q;\n  logic [1:0] train_counter, train_next;\n  logic [1:0] bank_train [0:3];\n  logic [3:0] bank_predict;\n  logic lookup_taken;\n  assign train_counter = trained_q[train_index] ? bank_train[train_index[5:4]] : 2'b10;\n  assign lookup_taken = trained_q[fetch_index] ? bank_predict[fetch_index[5:4]] : 1'b1;\n  always_comb begin\n    if (train_taken) train_next = train_counter == 2'b11 ? 2'b11 : train_counter + 2'b01;\n    else train_next = train_counter == 2'b00 ? 2'b00 : train_counter - 2'b01;\n  end''')\nbegin=s.index('  // Each entry updates'); end=s.index('  // Raw direct-control')\ns=s[:begin]+'''  always_ff @(posedge clock) begin\n    if (reset) trained_q <= '0;\n    else if (train_valid) trained_q[train_index] <= 1'b1;\n  end\n  for (genvar bank=0; bank<4; bank++) begin : g_bank\n    bht_ram_bank u_bank (\n      .clock(clock),\n      .write_en(\"'!reset && train_valid && train_index[5:4] == 2'\"'(bank)),\n      .write_addr(train_index[3:0]),\n      .train_addr(train_index[3:0]),\n      .predict_addr(fetch_index[3:0]),\n      .write_data(train_next),\n      .train_data(bank_train[bank]),\n      .predict_data(bank_predict[bank])\n    );\n  end\n\n'''+s[end:]\ns=s.replace('counter_msb_q[fetch_index]', 'lookup_taken'); p.write_text(s)\n(r/'bht_ram_bank.sv').write_text('''module bht_ram_bank (\n  input logic clock, write_en,\n  input logic [3:0] write_addr, train_addr, predict_addr,\n  input logic [1:0] write_data,\n  output logic [1:0] train_data,\n  output logic predict_data\n);\n  (* syn_ramstyle = \\\"distributed_ram