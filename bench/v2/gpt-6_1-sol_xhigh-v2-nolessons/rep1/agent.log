{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"cat formal/checks_si.cfg; sed -n '1,200p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n\"\"\"Tests of the registered divider, including the identical ALTOPS schedule.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, RTL, SIM_BUILD, TEST_DIR\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nRUN_CLOCKS = 7\nALTOPS = bool(int(os.environ.get(\"DIV_ALTOPS\", \"0\")))\n\n\ndef reference(op, a, b):\n    a, b = a & MASK, b & MASK\n    if ALTOPS:\n        salt = {ALU_DIV: 0x7f8529ec, ALU_DIVU: 0x10e8fd70,\n        \n…[4363 of 7435 chars elided by tools/bench/transcript.py; sha256:39d3d19da196007b]…\n for _ in range(phase):\n            await tick(dut)\n        await reset(dut)\n        for _ in range(8):\n            await tick(dut)\n            assert int(dut.result_valid.value) == 0\n        await launch(dut, ALU_REM, -10, 3)\n        await finish(dut, ALU_REM, -10, 3)\n        await consume(dut)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_div_unit_runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"div_unit_altops\" if altops else \"div_unit\")\n    args = [\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"]\n    if altops:\n        args.append(\"+define+RISCV_FORMAL_ALTOPS\")\n    runner.build(sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"div_unit.sv\")],\n                 hdl_toplevel=\"div_unit\", build_dir=str(build_dir),\n                 always=True, build_args=args)\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir),\n                extra_env={\"DIV_ALTOPS\": str(int(altops))})\n", "exit_code": 0, "status": "completed"}}
