{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/div_unit.sv cores/bench/test/test_div_unit.py'", "aggregated_output": "// Shared RV32M divider. Launch captures the operands; six registered\n// groups of five restoring steps precede a final two-step group with\n// fused sign restoration. DONE holds the result until consume, including\n// under bus stalls. ALTOPS preserves the seven-clock execution latency.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        consume,\n  output logic        busy,\n  output logic        result_valid,\n  output logic [31:0] result\n);\n  localparam logic [1:0] IDLE = 2'd0, RUN = 2'd1, DONE = 2'd2;\n  logic [1:0] state_q;\n  logic [2:0] group_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_q;\n`else\n  logic [31:0] quotient_q, remainder_q, divisor_q;\n  logic quotient_neg_q, remainder_neg_q, select_rem_q;\n  logic signed_op;\n  logic [31:0] quotient_step [0:5];\n  logic [31:0] remainder_step [0:5];\n  logic [32:0] difference [0:4];\n  logic [31:0] quotient_signed, remainder_signed;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign quotient_step[0] = quotient_q;\n  assign remainder_step[0] = remainder_q;\n  for (genvar bit_step = 0; bit_step < 5; bit_step++) begin : g_step\n    // A 33-bit subtraction provides both the comparison and remainder.\n    assign difference[bit_step] =\n      {remainder_step[bit_step], quotient_step[bit_step][31]} - {1'b0, divisor_q};\n    assign remainder_step[bit_step+1] = difference[bit_step][32]\n      ? {remainder_step[bit_step][30:0], quotient_step[bit_step][31]}\n      : difference[bit_step][31:0];\n    assign quotient_step[bit_step+1] =\n      {quotient_step[bit_step][30:0], !difference[bit_step][32]};\n  end\n  // Correct both final values in parallel before selecting the operation.\n  // Group six has only two dividend bits left; the registered state still\n  // contains the intermediate values after bit 30 at this edge.\n  assign quotient_signed = quotient_neg_q\n    ? (32'd0 - quotient_step[2]) : quotient_step[2];\n  assign remainder_\n…[6977 of 10049 chars elided by tools/bench/transcript.py; sha256:a96e07715d5080b2]…\n for _ in range(phase):\n            await tick(dut)\n        await reset(dut)\n        for _ in range(8):\n            await tick(dut)\n            assert int(dut.result_valid.value) == 0\n        await launch(dut, ALU_REM, -10, 3)\n        await finish(dut, ALU_REM, -10, 3)\n        await consume(dut)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_div_unit_runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"div_unit_altops\" if altops else \"div_unit\")\n    args = [\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"]\n    if altops:\n        args.append(\"+define+RISCV_FORMAL_ALTOPS\")\n    runner.build(sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"div_unit.sv\")],\n                 hdl_toplevel=\"div_unit\", build_dir=str(build_dir),\n                 always=True, build_args=args)\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir),\n                extra_env={\"DIV_ALTOPS\": str(int(altops))})\n", "exit_code": 0, "status": "completed"}}
