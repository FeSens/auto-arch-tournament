/'ex_stage.sv'\ns=p.read_text().replace('logic ex_accept, effective_taken;','logic ex_accept, recovery_wrong;')\ns=s.replace('  assign effective_taken = branch_taken && \"'!in.ctrl.is_illegal && !misalign_fault;'\"','''  assign recovery_wrong =\n    (in.recovery_mode[0] && rs1 == rs2) |\n    (in.recovery_mode[1] && rs1 \"'!= rs2) |\n    (in.recovery_mode[2] && $signed(rs1) < $signed(rs2)) |\n    (in.recovery_mode[3] && $signed(rs1) >= $signed(rs2)) |\n    (in.recovery_mode[4] && rs1 < rs2) |\n    (in.recovery_mode[5] && rs1 >= rs2) | in.recovery_mode[6];'\"''')\ns=s.replace('(effective_taken \"'^ in.predicted_taken)'\"','recovery_wrong')\np.write_text(s)\nprint('Prepared split_only and onehot recovery')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
