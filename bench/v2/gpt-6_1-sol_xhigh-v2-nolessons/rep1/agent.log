{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])\nfor name,independent in [('branch-independent-verify',True),('branch-alignment-verify',False)]:\n rtl=root/name/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for src in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(src,rtl/src.name)\n f=rtl/'ex_stage.sv';s=f.read_text()\n if independent:\n  s=s.replace('  logic        branch_cond;', '''  logic [31:0] verify_a, verify_b;\n  logic verify_equal, verify_less, verify_wrong;\n  assign verify_a = {rs1[31] \"'^ !in.ctrl.branch_op[1], rs1[30:0]};\n  assign verify_b = {rs2[31] ''^ !in.ctrl.branch_op[1], rs2[30:0]};\n  assign verify_equal = rs1 == rs2;\n  assign verify_less = verify_a < verify_b;\n  assign verify_wrong = (in.ctrl.branch_op[2] ? verify_less : verify_equal) ''^\n                        (in.ctrl.branch_op[0] ''^ in.predicted_taken);\n  logic        branch_cond;'\"''')\n  wrong='verify_wrong'\n else:wrong='(branch_cond \"'^ in.predicted_taken)'\"'\n s=s.replace('logic ex_accept, effective_taken;','logic ex_accept;')\n s=s.replace('  assign effective_taken = branch_taken && \"'!in.ctrl.is_illegal && !misalign_fault;'\"\\\\n','')\n s=s.replace('(effective_taken \"'^ in.predicted_taken)'\"',f'(branch_target[1:0] == 0 ? {wrong} : in.predicted_taken)')\n s=s.replace('(in.ctrl.is_jalr && \"'!misalign_fault)'\"','(in.ctrl.is_jalr && jump_target[1:0] == 0)')\n f.write_text(s)\nprint('Prepared independent verifier and alignment factorizations')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
