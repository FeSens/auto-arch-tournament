{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/generated/microopt_exploration/spec_nonrestore/rtl'); dst=Path('cores/bench/generated/microopt_exploration/full_spec_nonrestore/rtl')\ndst.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'): shutil.copy2(p,dst/p.name)\np=dst/'div_unit.sv'; s=p.read_text()\nstart=s.index('    wire [32:0] first_divisor'); end=s.index('    assign quotient_step[K+1]',start)\ns=s[:start]+'''    wire [32:0] first_plus = one_shift + {1'b0,divisor_q};\n    wire [32:0] first_minus = one_shift + divisor_negative_q;\n    wire [32:0] plus_one = two_shift + {1'b0,divisor_q};\n    wire [32:0] plus_three = two_shift + divisor_triple_q;\n    wire [32:0] minus_one = two_shift + divisor_negative_q;\n    wire [32:0] minus_three = two_shift + divisor_negative_triple_q;\n    wire old_negative = remainder_step[K][32];\n    wire [32:0] first_result = old_negative ? first_plus : first_minus;\n    assign remainder_step[K+1] = first_result;\n    assign remainder_step[K+2] = old_negative\n      ? (first_plus[32] ? plus_three : plus_one)\n      : (first_minus[32] ? minus_one : minus_three);\n'''+s[end:]\ns=s.replace(' /* verilator split_var */','')\n# Scalar wires expose the acyclic unrolled chain to Verilator without lint suppressions.\nfor name,width in [('quotient_step',31),('remainder_step',32)]:\n s=s.replace(f'logic [{width}:0] {name} [0:5];','\\\\n'.join(f'wire [{width}:0] {name}_{i};' for i in range(6)))\n import re\n # Expand the generate pair instances to literal indices.\nstart=s.index('  for (genvar pair_step'); end=s.index('  wire [32:0] last_divisor',start)\nbody=s[start:end]; body=body[body.index('    wire [32:0] one_shift'):]; body=body[:body.rfind('  end')]\nexpanded=''\nfor pair_idx in range(2):\n b=body\n for arr in ['quotient_step','remainder_step']:\n  for off in [2,1,0]:\n   expr='K' if off==0 else f'K+{off}'\n   b=b.replace(f'{arr}[{expr}]',f'{arr}_{pair_idx*2+off}')\n expanded+=f'  if (1) begin : g_pair_{pair_idx}\\\\n'+b+'  end\\\\n'\ns=s[:start]+expanded+s[end:]\nfor name in ['quotient_step','remainder_step']:\n for i in range(6): s=s.replace(f'{name}[{i}]',f'{name}_{i}')\np.write_text(s)\nprint('Full speculative pair scratch RTL ready')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
