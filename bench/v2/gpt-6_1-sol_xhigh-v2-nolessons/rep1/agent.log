hell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[17891 of 20963 chars elided by tools/bench/transcript.py; sha256:bedb5ab8ecccb4ce]…\n.getrandbits(32)\n        await model.step(word=word, ready=int(rng.random() >= 0.22),\n                         accept=int(rng.random() >= 0.55),\n                         train=(rng.randrange(64), rng.randrange(2)) if cycle % 5 == 0 else None,\n                         redirect=rng.randrange(0, 0x4000, 4) if cycle % 79 == 0 else None,\n                         reset=cycle % 251 == 0)\n    while model.queue:\n        await model.step(ready=0, accept=1)\n    assert model.fetched == model.delivered\n\n\ndef test_fetch_queue_runner():\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"fetch_queue\"\n    runner.build(sources=[str(RTL / name) for name in (\"core_pkg.sv\", \"if_stage.sv\")],\n                 hdl_toplevel=\"if_stage\", build_dir=str(build_dir), always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"if_stage\", test_module=\"test_fetch_queue\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir))\n", "exit_code": 0, "status": "completed"}}
