{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c 'tail -70 cores/bench/test/test_div_unit.py'","aggregated_output":"              for d in (1, 3, 63, 64)\n              for r in (0, d - 1)\n              for magnitude in (q * d + r,)\n              if magnitude <= MASK\n              for a in (magnitude, -magnitude) for b in (d, -d)]\n    # 2D/3D crossing 32 and 33 bits must not lose trial borrow information.\n    pairs += [(a, b)\n              for b in (0x55555555, 0x55555556, 0x7fffffff, 0x80000000,\n                        0xaaaaaaab, 0xfffffffe, MASK)\n              for a in (0, b - 1, b, (b + 1) & MASK, MASK)]\n    # Uniform full-width divisors mostly produce quotient 0 or 1. Vary\n    # divisor width as well to randomize digits throughout every RUN group.\n    pairs += [(rng.getrandbits(32), rng.getrandbits(rng.randrange(1, 33)))\n              for _ in range(500)]\n    for op in OPS:\n        for a, b in pairs:\n            await launch(dut, op, a, b)\n            await finish(dut, op, a, b, delay=rng.randrange(5))\n            await consume(dut)\n            await tick(dut)\n            assert int(dut.result_valid.value) == 0, \"duplicate completion\"\n\n\n@cocotb.test()\nasync def simultaneous_consume_and_next_launch(dut):\n    await reset(dut)\n    await launch(dut, ALU_DIVU, MASK, 7)\n    await finish(dut, ALU_DIVU, MASK, 7, delay=12)\n    for op, a, b in ((ALU_REM, -101, 7), (ALU_DIV, -101, -7),\n                     (ALU_DIVU, 0, 0), (ALU_REMU, 0x80000000, MASK),\n                     (ALU_DIVU, MASK, 63), (ALU_REMU, MASK, 64),\n                     (ALU_DIVU, MASK, MASK), (ALU_REM, -0x7fffffff, -63)):\n        dut.consume.value = 1\n        await launch(dut, op, a, b)\n        await finish(dut, op, a, b)\n    await consume(dut)\n    for _ in range(10):\n        await tick(dut)\n        assert int(dut.result_valid.value) == 0\n\n\n@cocotb.test()\nasync def reset_aborts_every_phase(dut):\n    await reset(dut)\n    for phase in range(RUN_CLOCKS + 1):\n        await launch(dut, ALU_DIV, 0x80000000, MASK)\n        for _ in range(phase):\n            await tick(dut)\n        await reset(dut)\n        for _ in range(8):\n            await tick(dut)\n            assert int(dut.result_valid.value) == 0\n        await launch(dut, ALU_REM, -10, 3)\n        await finish(dut, ALU_REM, -10, 3)\n        await consume(dut)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_div_unit_runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"div_unit_altops\" if altops else \"div_unit\")\n    args = [\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"]\n    if altops:\n        args.append(\"+define+RISCV_FORMAL_ALTOPS\")\n    runner.build(sources=[str(RTL / s) for s in (\"core_pkg.sv\", \"div_unit.sv\")],\n                 hdl_toplevel=\"div_unit\", build_dir=str(build_dir),\n                 always=True, build_args=args)\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir),\n                extra_env={\"DIV_ALTOPS\": str(int(altops))})\n","exit_code":0,"status":"completed"}}
