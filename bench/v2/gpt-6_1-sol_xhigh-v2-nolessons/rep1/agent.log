0    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b00\n…[7137 of 10209 chars elided by tools/bench/transcript.py; sha256:63c0ce762654ce98]…\nt(dut.if_id_w.value)\n    assert (head >> 34, (head >> 2) & mask, (head >> 1) & 1) == offered\n    assert (head & 1) == int(head_valid)\n    assert int(dut.head_valid.value) == int(head_valid)\n    assert int(dut.u_if.count_q.value) == len(queue)\n    accept = head_valid and not int(dut.stall_id.value) and not int(dut.flush_id.value)\n    assert int(dut.decode_accept.value) == int(accept)\n    fetch_accept = ready and (len(queue) < 2 or accept)\n    assert int(dut.u_if.fetch_accept.value) == int(bool(fetch_accept))\n    log[\"occupancy\"].append(len(queue))\n    if accept and queue and not ready:\n        log[\"buffered\"].append((cycle, offered[0]))\n    if fetch_accept and int(dut.stall_id.value):\n        log[\"overlap\"].append((cycle, fetch_pc, int(dut.div_wait.value),\n                               int(dut.stall_ex_mem.value)))\n    if of_insn & 127 == 0x33 and of_insn >> 25 == 1 and not of_insn & (1 << 14) \\\n            and int(dut.load_use.value) and int(dut.flush_of.value) \\\n            and not int(dut.redirect.value):\n", "exit_code": 0, "status": "completed"}}
