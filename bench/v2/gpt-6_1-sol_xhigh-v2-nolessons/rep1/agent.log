{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport random\nM=(1<<32)-1\n\ndef magnitude(x,signed):\n return (-x)&M if signed and x>>31 else x\n\ndef proposed(a,b,signed):\n A=magnitude(a,signed); D=magnitude(b,signed)\n P=((~(a>>30)+(int((a&((1<<30)-1))==0)))&3) if signed and a>>31 else a>>30\n small=(((b>>2)==((1<<30)-1)) and (b&3)\"'!=0) if signed and b>>31 else (b>>2)==0\n small_D=(-b)&3 if signed and b>>31 else b&3\n assert P==A>>30\n assert small==(D<=3)\n if small:\n  R=0; prefix_q=0\n  for bit in (1,0):\n   T=2*R+((P>>bit)&1)\n   ok=T>=small_D\n   R=T-small_D if ok else T\n   prefix_q=(prefix_q<<1)|ok\n else:\n  prefix_q=0; R=P\n Q=((A&((1<<30)-1))<<2)|prefix_q\n def step(Q,R):\n  T=2*R+(Q>>31)\n  ok=T>=D\n  return ((Q<<1)|ok)&M, T-D if ok else T\n for group in range(7):\n  for _ in range(4): Q,R=step(Q,R)\n ready_state=(Q,R)\n for _ in range(2): Q,R=step(Q,R)\n return Q,R,ready_state\nr=random.Random(8821)\nvals=[0,1,2,3,4,5,(1<<30)-1,1<<30,(1<<31)-1,1<<31,M-3,M-2,M-1,M]\ncount=0\nfor signed in (False,True):\n for a,b in [(a,b) for a in vals for b in vals]+[(r.getrandbits(32),r.getrandbits(32)) for _ in range(30000)]:\n  q,rem,state=proposed(a,b,signed)\n  A=magnitude(a,signed); D=magnitude(b,signed)\n  eq,er=(M,A) if D==0 else divmod(A,D)\n  assert (q,rem)==(eq,er),(a,b,signed,q,rem,eq,er)\n  qneg=signed and bool((a''^b)>>31) and b!=0\n  rneg=signed and bool(a>>31)\n  finalq=(-q if qneg else q)&M\n  finalr=(-rem if rneg else rem)&M\n  aa=a-(1<<32) if signed and a>>31 else a\n  bb=b-(1<<32) if signed and b>>31 else b\n  if b==0: expectedq,expectedr=M,a\n  else:\n   magq=abs(aa)//abs(bb)\n   referenceq=-magq if (aa<0)!=(bb<0) else magq\n   expectedq,expectedr=referenceq&M,(aa-referenceq*bb)&M\n  assert (finalq,finalr)==(expectedq,expectedr)\n  count+=1\nprint('\"'Validated two-bit prefix, 30-bit READY state and final RV32M results for',count,'directed/random signed and unsigned operand pairs.')\nprint('Schedule: launch L; four-bit RUN groups L+1..L+7; valid after L+7; final two bits registered into EX/MEM at L+8.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
