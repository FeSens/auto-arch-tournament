{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/div_unit.sv'","aggregated_output":"// Shared RV32M divider. Launch captures the operands; four registered\n// groups of eight restoring steps are followed by one sign-restoration\n// clock. DONE holds the result until consume, including under bus stalls.\n// ALTOPS changes only the value, never the five-clock execution latency.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic        consume,\n  output logic        busy,\n  output logic        result_valid,\n  output logic [31:0] result\n);\n  localparam logic [1:0] IDLE = 2'd0, RUN = 2'd1,\n                         SIGN = 2'd2, DONE = 2'd3;\n  logic [1:0] state_q;\n  logic [1:0] group_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_q;\n`else\n  logic [31:0] quotient_q, remainder_q, divisor_q;\n  logic quotient_neg_q, remainder_neg_q, select_rem_q;\n  logic signed_op;\n  logic [31:0] quotient_step [0:8];\n  logic [31:0] remainder_step [0:8];\n  logic [32:0] difference [0:7];\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign quotient_step[0] = quotient_q;\n  assign remainder_step[0] = remainder_q;\n  for (genvar bit_step = 0; bit_step < 8; bit_step++) begin : g_step\n    // A 33-bit subtraction provides both the comparison and remainder.\n    assign difference[bit_step] =\n      {remainder_step[bit_step], quotient_step[bit_step][31]} - {1'b0, divisor_q};\n    assign remainder_step[bit_step+1] = difference[bit_step][32]\n      ? {remainder_step[bit_step][30:0], quotient_step[bit_step][31]}\n      : difference[bit_step][31:0];\n    assign quotient_step[bit_step+1] =\n      {quotient_step[bit_step][30:0], !difference[bit_step][32]};\n  end\n`endif\n\n  assign busy = (state_q != IDLE);\n  assign result_valid = (state_q == DONE);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      group_q <= 2'd0;\n      result <= 32'd0;\n`ifdef RISCV_FORMAL_ALTOPS\n      alt_q <= 32'd0;\n`else\n      quotient_q <= 32'd0;\n      remainder_q <= 32'd0;\n      divisor_q <= 32'd0;\n      quotient_neg_q <= 1'b0;\n      remainder_neg_q <= 1'b0;\n      select_rem_q <= 1'b0;\n`endif\n    end else if (start && (state_q == IDLE || (state_q == DONE && consume))) begin\n      state_q <= RUN;\n      group_q <= 2'd0;\n`ifdef RISCV_FORMAL_ALTOPS\n      case (op)\n        ALU_DIV:  alt_q <= (a - b) ^ 32'h7f8529ec;\n        ALU_DIVU: alt_q <= (a - b) ^ 32'h10e8fd70;\n        ALU_REM:  alt_q <= (a - b) ^ 32'h8da68fa5;\n        ALU_REMU: alt_q <= (a - b) ^ 32'h3138d0e1;\n        default:  alt_q <= 32'd0;\n      endcase\n`else\n      quotient_q <= (signed_op && a[31]) ? (32'd0 - a) : a;\n      divisor_q <= (signed_op && b[31]) ? (32'd0 - b) : b;\n      remainder_q <= 32'd0;\n      // With divisor zero, the recurrence yields all ones and the\n      // original dividend magnitude. Do not negate that quotient.\n      quotient_neg_q <= signed_op && (a[31] ^ b[31]) && (b != 32'd0);\n      remainder_neg_q <= signed_op && a[31];\n      select_rem_q <= (op == ALU_REM || op == ALU_REMU);\n`endif\n    end else begin\n      case (state_q)\n        RUN: begin\n`ifndef RISCV_FORMAL_ALTOPS\n          quotient_q <= quotient_step[8];\n          remainder_q <= remainder_step[8];\n`endif\n          group_q <= group_q + 2'd1;\n          if (group_q == 2'd3) state_q <= SIGN;\n        end\n        SIGN: begin\n`ifdef RISCV_FORMAL_ALTOPS\n          result <= alt_q;\n`else\n          result <= select_rem_q\n            ? (remainder_neg_q ? (32'd0 - remainder_q) : remainder_q)\n            : (quotient_neg_q ? (32'd0 - quotient_q) : quotient_q);\n`endif\n          state_q <= DONE;\n        end\n        DONE: if (consume) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\n","exit_code":0,"status":"completed"}}
