{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,115p' cores/bench/test/test_ex_divider.py\"", "aggregated_output": "\"\"\"Exercise EX's launch/hold/transfer protocol directly, including stalls\nafter arithmetic has completed, which an already-drained MEM stage normally\ncannot cause in this single-issue pipeline.\n\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, ALU_MUL, ALU_MULH,\n                      ALU_MULHU, ALU_MULHSU, run_cocotb)\n\n\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"predicted_taken\", 1), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef pack(fields, values):\n    bits = 0\n    for name, width in fields:\n        bits = (bits << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return bits\n\n\ndef unpack(fields, bits):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = bits & ((1 << width) - 1)\n        bits >>= width\n    return result\n\n\ndef payload(op=ALU_DIV, **updates):\n    values = dict(pc=0x40, rs1_val=91, rs2_val=13, rd=3,\n                  rs1_addr=1, rs2_addr=2, instr=0x0220c1b3, valid=1,\n                  ctrl=pack(CTRL, dict(alu_op=op, reg_write=1)))\n    values.update(updates)\n    return pack(ID_EX, values)\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def setup(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.rvfi_mem_rd.value = 0\n    dut.rvfi_wb_rd.value = 0\n    dut.rvfi_mem_w_en.value = 0\n    dut.rvfi_wb_w_en.value = 0\n    dut.rvfi_mem_data.value = 0\n    dut.rvfi_wb_data.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n\n\n@cocotb.test()\nasync def launch_only_on_advance_capture_and_hold_completion(dut):\n    await setup(dut)\n    dut[\"in\"].value = payload(rs1_val=0xffffff9b, rs2_val=7)\n    dut.stall.value = 1\n    for _ in range(10):\n        await tick(dut)\n        assert int(dut.div_wait.value) == 1\n        assert int(dut.out.value) == 0, \"stalled instruction issued\"\n    dut.stall.value = 0\n    await tick(dut)  # accepted launch\n    # Live metadata sources disappear while older instructions drain.\n    dut.rvfi_mem_data.value = 0xdeadbeef\n    dut.rvfi_wb_data.value = 888\n    dut[\"in\"].value = payload(pc=0x80, rd=9, rs1_val=123, rs2_val=17,\n                             rs1_addr=4, rs2_addr=5, instr=0x025244b3)\n    for _ in range(5):\n        await tick(dut)\n        assert int(dut.div_wait.value) == 1\n        assert int(dut.out.value) == 0, \"busy divide published early\"\n    dut.stall.value = 1\n    for _ in range(13):\n        await tick(dut)\n        assert int(dut.div_wait.value) == 1\n        assert int(dut.out.value) == 0, \"finished result ignored MEM backpressure\"\n    dut.stall.value = 0\n    await Timer(1, unit=\"ns\")\n    assert int(dut.div_wait.value) == 0\n    await tick(dut)\n    out = unpack(EX_MEM, int(dut.out.value))\n    assert out[\"valid\"] == 1\n    assert out[\"alu_result\"] == 0xfffffff2  # -14\n    assert out[\"pc\"] == 0x40 and out[\"pc_next\"] == 0x44\n    assert out[\"rd\"] == 3 and out[\"instr\"] == 0x0220c1b3\n    assert out[\"rs1_addr\"] == 1 and out[\"rs2_addr\"] == 2\n    assert out[\"rs1_val\"] == 0xffffff9b and out[\"rs2_val\"] == 7\n    dut[\"in\"].value = 0  # ID/EX advanced at transfer\n    for _ in range(10):\n        await tick(dut)\n        assert unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0, \"duplicate issue\"\n\n\n@cocotb.test()\nasync def reset_aborts_held_divide_and_invalid_never_launches(dut):\n    await setup(dut)\n", "exit_code": 0, "status": "completed"}}
