{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('/srv/hwebench/tmp/5ff8876e/dbfedbe2/r9s0_probe')\nshutil.copytree(probe/'test',probe/'factored/test',dirs_exist_ok=True)\nshutil.copytree(probe/'factored_rtl',probe/'factored/rtl',dirs_exist_ok=True)\np=probe/'factored/test/test_ex_stage.py'\ns=p.read_text().replace('trial > 44 else edges','trial >= 44 else edges')\ns+='''\\\\n\\\\n@cocotb.test()\nasync def aligned_control_flow_selection_independent_model(dut):\n    import random\n    rng = random.Random(9010)\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \\\"in\\\").value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    for trial in range(1600):\n        pc = rng.getrandbits(30) << 2\n        immediate = rng.getrandbits(32)\n        a, b = rng.getrandbits(32), rng.getrandbits(32)\n        op = [0, 1, 4, 5, 6, 7][trial % 6]\n        kind = trial % 4\n        signed_a = a - (1 << 32) if a & (1 << 31) else a\n        signed_b = b - (1 << 32) if b & (1 << 31) else b\n        condition = {0:a == b,1:a \"'!= b,4:signed_a < signed_b,\n                     5:signed_a >= signed_b,6:a < b,7:a >= b}[op]\n        valid = trial % 7 != 0\n        illegal = trial % 11 == 0\n        is_branch, is_jump, is_jalr = kind == 1, kind in (2,3), kind == 3\n        direct_target = (pc + immediate) & MASK\n        jump_target = (((a + immediate) & MASK) & ~1) if is_jalr else direct_target\n        branch_taken = valid and not illegal and is_branch and condition\n        fault = (branch_taken and direct_target & 3) or (valid and not illegal and is_jump and jump_target & 3)\n        actual_next = (pc + 4) & MASK\n        if not illegal and not fault:\n            if is_jump: actual_next = jump_target\n            elif branch_taken: actual_next = direct_target\n        prediction = actual_next if trial % 3 == 0 else actual_next ''^ (1 << (trial % 32))\n        ctrl = (op << 13) | (int(is_branch) << 12) | (int(is_jump) << 11) | (int(is_jalr) << 10) | (2 << 4) | (1 << 3) | (int(is_jump) << 2) | int(illegal)\n        getattr(dut, \"in\").value = _pack(ID_FIELDS, {\"pc\":pc,\"prediction\":prediction,\n            \"rs1\":a,\"rs2\":b,\"imm\":immediate,\"rd\":3,\"rs1_addr\":1,\"rs2_addr\":2,\n            \"ctrl\":ctrl,\"insn\":0x00000063,\"valid\":int(valid)})\n        await Timer(1, \"ns\")\n        assert int(dut.redirect_target.value) == actual_next\n        assert int(dut.prediction_match.value) == int(actual_next == prediction)\n        assert int(dut.redirect.value) == int(valid and actual_next != prediction)\n        assert int(dut.misalign_fault.value) == int(bool(fault))\n        await _tick(dut)\n        if valid:\n            fields = _unpack(EX_FIELDS, int(dut.out.value))\n            assert fields[\"pc_next\"] == actual_next\n            assert bool(fields[\"ctrl\"] & 1) == bool(illegal or fault)\n'\"'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
