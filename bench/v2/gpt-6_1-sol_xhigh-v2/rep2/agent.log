ervices,\n                           monitor=_OperandDeliveryMonitor(program, {12: 97}))\n    _verify_divisions(rets)\n    assert [r[\"pc\"] for r in rets] == [i * 4 for i in range(len(program)) if i != 10]\n    assert not any(r[\"trap\"] for r in rets)\n    assert mem[0] == mem[4] == 0xFFFFFFFA\n    assert m\n…[11475 of 14547 chars elided by tools/bench/transcript.py; sha256:983d47cef55f2d70]…\n     self.events.add(\"full-replacement\")\n                if pop and not self.ready:\n                    self.events.add(\"stalled-head\")\n                if pop:\n                    self.entries.pop(0)\n                if push:\n                    self.entries.append((self.pc, self.raw, self.prediction))\n        else:\n            assert int(dut.u_if.count_q.value) == len(self.entries)\n            expected_pc = (self.target if self.redirect else\n                           self.prediction if self.accept else self.pc)\n            assert int(dut.io_imemAddr.value) == expected_pc\n            if self.redirect:\n                assert int(dut.u_if.read_q.value) == int(dut.u_if.write_q.value) == 0\n            if not self.hold:\n                pc, prediction, insn, valid, _ = _id_snapshot(dut)\n                assert (pc, insn, prediction) == self.head\n                assert valid == (self.available and not self.flush)\n\n\nclass _PredictorMonitor:\n    \"\"\"Independent table model, exact recovery, and validity-only bubbles.\"\"\"\n", "exit_code": 0, "status": "completed"}}
