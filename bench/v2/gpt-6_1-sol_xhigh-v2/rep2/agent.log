{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Divider response holds must delay stale-prediction recovery until transfer.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n                      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb)\n\n\nMASK = 0xFFFFFFFF\nID_FIELDS = [(\"pc\", 32), (\"prediction\", 32), (\"rs1\", 32), (\"rs2\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"ctrl\", 22), (\"insn\", 32), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"result\", 32), (\"write_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1\", 32), (\"rs2\", 32),\n             (\"pc_next\", 32), (\"taken\", 1), (\"target\", 32), (\"ctrl\", 22),\n             (\"insn\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, values):\n    word = 0\n    for name, width in fields:\n        word = (word << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return word\n\n\ndef _unpack(fields, word):\n    values = {}\n    for name, width in reversed(fields):\n        values[name] = word & ((1 << width) - 1)\n        word >>= width\n    return values\n\n\nasync def _tick(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def stale_division_prediction_with_capture_completion_and_response_holds(dut):\n    cases = [(ALU_DIV, -97, 7, -13), (ALU_REM, -97, 7, -6),\n             (ALU_DIVU, 0xFFFFFFFF, 7, 0xFFFFFFFF // 7),\n             (ALU_REMU, 0xFFFFFFFF, 7, 0xFFFFFFFF % 7)]\n    for op, a, b, result in cases:\n        dut.clock.value = 0\n        dut.reset.value = 1\n        dut.stall.value = 0\n        getattr(dut, \"in\").value = 0\n        dut.fwd_rs1_sel.value = 0\n        dut.fwd_rs2_sel.value = 0\n        dut.fwd_ex_mem.value = 0\n        dut.fwd_mem_wb.value = 0\n        await _tick(dut)\n        dut.reset.value = 0\n        pc = 0x80000010\n        insn = (1 << 25) | (2 << 20) | (1 << 15) | ((op - ALU_DIV + 4) << 12) | (3 << 7) | 0x33\n        ctrl = (op << 17) | (2 << 4) | (1 << 3) | (1 << 2)\n        payload = _\n…[5914 of 8986 chars elided by tools/bench/transcript.py; sha256:a6008b30ad42f030]…\n\n        dut.stall.value = 0\n        await Timer(1, \"ns\")\n        assert int(dut.mul_accept.value) == 1 and int(dut.mul_hold.value) == 0\n        assert int(dut.train_valid.value) == 1 and int(dut.train_install.value) == 0\n        assert int(dut.redirect.value) == 1\n        assert int(dut.redirect_target.value) == pc + 4\n        await _tick(dut)  # edge three: one response transfer\n        assert _unpack(EX_FIELDS, int(dut.out.value)) == {**fields, \"result\": result}\n        assert int(dut.mul_rsp_valid.value) == int(dut.mul_pending_q.value) == 0\n        getattr(dut, \"in\").value = payload & ~1\n        await Timer(1, \"ns\")\n        assert not int(dut.mul_req_valid.value)\n        assert not int(dut.train_valid.value) and not int(dut.redirect.value)\n        await _tick(dut)\n        assert int(dut.out.value) == 0\n        # A valid but illegal retained MUL opcode must not launch either.\n        getattr(dut, \"in\").value = payload | (1 << 33)\n        await Timer(1, \"ns\")\n        assert not int(dut.mul_req_valid.value)\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef MUL (rd, rs1, rs2)\n…[74624 of 77696 chars elided by tools/bench/transcript.py; sha256:288c045b0f72a757]…\n          rets, mem = await _run(dut, program, stalls=stalls, monitor=observe,\n                                   services=services, max_cycles=200)\n            assert mem == _check_operand_architecture(rets, program, {}, services)\n            assert arithmetic.launches == arithmetic.acceptances == 3\n            assert {\"arithmetic-drain\", \"response\", \"queued-capture\", \"redirect\", \"both-ex\"} <= monitor.events\n            if operation == DIV and not stalled:\n                by_pc = {r[\"pc\"]: r for r in rets}\n                assert 0 < by_pc[32][\"cycle\"] - by_pc[28][\"cycle\"] <= 10\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
