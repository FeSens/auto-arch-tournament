{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"sed -n '350,520p' cores/bench/test/test_pipeline.py; sed -n '710,735p' cores/bench/test/test_pipeline.py; cat tools/eval/cosim.py\"", "aggregated_output": "@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef _div_model(funct3, a, b):\n    a, b = a & 0xFFFFFFFF, b & 0xFFFFFFFF\n    if b == 0:\n        return a if funct3 in (6, 7) else 0xFFFFFFFF\n    if funct3 in (4, 6):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n        quotient = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            quotient = -quotient\n        result = a - quotient * b if funct3 == 6 else quotient\n    else:\n        result = a % b if funct3 == 7 else a // b\n    return result & 0xFFFFFFFF\n\n\ndef _verify_divisions(rets):\n    regs = [0] * 32\n    for r in rets:\n        insn = r[\"insn\"]\n        if insn & 0xFE00007F == 0x02000033 and (insn >> 12) & 7 >= 4:\n            rs1, rs2 = (insn >> 15) & 31, (insn >> 20) & 31\n            assert r[\"rs1_rdata\"] == regs[rs1], r\n            assert r[\"rs2_rdata\"] == regs[rs2], r\n            if (insn >> 7) & 31:\n                expected = _div_model((insn >> 12) & 7, regs[rs1], regs[rs2])\n                assert r[\"rd_wdata\"] == expected, r\n            else:\n                assert r[\"rd\"] == 0 and r[\"rd_wdata\"] == 0, r\n        if r[\"rd\"]:\n            regs[r[\"rd\"]] = r[\"rd_wdata\"]\n\n\nasync def _division_dependencies(dut, stalls=None):\n    program = [\n        ADDI(1, 0, -97), ADDI(2, 0, 7), ADD(3, 1, 0),\n        DIV(4, 3, 2), A\n…[12958 of 16030 chars elided by tools/bench/transcript.py; sha256:01848ff7c9243e97]…\n             for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n            result = future.result()\n            if not result['passed']:\n                return {\n                    'passed': False,\n                    'failed_elf': result['elf'],\n                    'detail': result,\n                }\n\n    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n    if coremark is not None:\n        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n\n\nif __name__ == '__main__':\n    result = run_cosim(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n", "exit_code": 0, "status": "completed"}}
