{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 -c '\nimport collections, json, subprocess\np = subprocess.Popen([\\\"cores/bench/obj_dir/cosim_sim\\\", \\\"bench/programs/coremark.elf\\\", \\\"50000000\\\", \\\"--istall\\\", \\\"--dstall\\\"], stdout=subprocess.PIPE, text=True)\nactive = False\ncounts = collections.Counter()\nmarkers = {}\nretirements = checked = 0\nprevious = -1\nfor line in p.stdout:\n    if not line.startswith(\\\"{\\\"):\n        continue\n    r = json.loads(line)\n    assert r[\\\"order\\\"] == previous + 1\n    previous = r[\\\"order\\\"]\n    if r[\\\"mem_wmask\\\"] and r[\\\"mem_addr\\\"] == 0x10000100:\n        markers[\\\"start\\\"] = r[\\\"cycle\\\"]\n        active = True\n        continue\n    if r[\\\"mem_wmask\\\"] and r[\\\"mem_addr\\\"] == 0x10000104:\n        markers[\\\"stop\\\"] = r[\\\"cycle\\\"]\n        active = False\n    insn = r[\\\"insn\\\"]\n    if active:\n        retirements += 1\n        if insn & 0xfe00007f == 0x02000033:\n            counts[(insn >> 12) & 7] += 1\n    if insn & 0xfe00007f == 0x02000033 and (insn >> 12) & 7 < 4:\n        f = (insn >> 12) & 7\n        a, b = r[\\\"rs1_rdata\\\"], r[\\\"rs2_rdata\\\"]\n        sa = a - (1 << 32) if a >> 31 else a\n        sb = b - (1 << 32) if b >> 31 else b\n        value = ((a * b) if f == 0 else ((sa * sb) if f == 1 else (sa * b) if f == 2 else (a * b)) >> 32) & 0xffffffff\n        assert r[\\\"rd_wdata\\\"] == (value if r[\\\"rd_addr\\\"] else 0), r\n        checked += 1\nassert p.wait() == 0\nassert \\\"start\\\" in markers and \\\"stop\\\" in markers\nnames = [\\\"MUL\\\", \\\"MULH\\\", \\\"MULHSU\\\", \\\"MULHU\\\", \\\"DIV\\\", \\\"DIVU\\\", \\\"REM\\\", \\\"REMU\\\"]\nprint(json.dumps({\\\"marker_retirement_cycles\\\": markers, \\\"bracketed_cycles\\\": markers[\\\"stop\\\"] - markers[\\\"start\\\"], \\\"bracketed_retirements\\\": retirements, \\\"m_counts\\\": {names[k]: v for k, v in sorted(counts.items())}, \\\"mul_model_checks\\\": checked}))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
