d[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n        result = a - quotient * b if funct3 == 6 else quotient\n    else:\n        result = a % b if funct3 == 7 else a // b\n    return result & 0xFFFFFFFF\n\n\ndef _verify_divisions(rets):\n    regs = [0] * 32\n    for r in rets:\n        insn = r[\"insn\"]\n        if insn & 0xFE00007F == 0x02000033 and (insn >> 12) & 7 >= 4:\n            rs1, rs2 = (insn >> 15) & 31, (insn >> 20) & 31\n            assert r[\"rs1_rdata\"] == regs[rs1], r\n            assert r[\"rs2_rdata\"] == regs[rs2], r\n            if (insn >> 7) & 31:\n                expected = _div_model((insn >> 12) & 7, regs[rs1], regs[rs2])\n                assert r[\"rd_wdata\"] == expected, r\n            else:\n                assert r[\"rd\"] == 0 and r[\"rd_wdata\"] == 0, r\n        if r[\"rd\"]:\n            regs[r[\"rd\"]] = r[\"rd_wdata\"]\n\n\nasync def _division_dependencies(dut, stalls=None):\n    program = [\n        ADDI(1, 0, -97), ADDI(2, 0, 7), ADD(3, 1, 0),\n        DIV(4, 3, 2), ADD(5, 4, 2), SW(5, 0, 0),\n        LW(6, 0, 0), REM(7, 6, 2), SW(7, 0, 4),\n        BEQ(7, 5, 8), DIV(8, 1, 0),  # wrong-path divide by zero\n        DIVU(9, 1, 2), DIV(0, 1, 2), ADD(10, 0, 9), SW(10, 0, 8),\n        LW(11, 0, 12), DIV(12, 11, 2), REMU(13, 11, 2),\n        SW(12, 0, 16), SW(13, 0, 20), EBREAK(),\n    ]\n    services = []\n    rets, mem = await _run(dut, program, dmem_init={12: 97}, max_cycles=600,\n                           stalls=stalls, services=services)\n    _verify_divisions(rets)\n    assert [r[\"pc\"] for r in rets] == [i * 4 for i in range(len(program)) if i != 10]\n    assert not any(r[\"trap\"] for r in rets)\n    assert mem[0] == mem[4] == 0xFFFFFFFA\n    assert mem[8] == _div_model(5, -97, 7)\n    assert mem[16] == 13 and mem[20] == 6\n    # Every accepted memory request must match exactly one retirement.\n    actual = [(a, w, r) for _, a, w, r, _ in services]\n    expected = [(r[\"mem_addr\"], r[\"mem_wmask\"], bool(r[\"mem_rmask\"]))\n                for r in rets if r[\"mem_wmask\"] or r[\"mem_rmask\"]]\n    assert actual == expected, (actual, expected)\n    if stalls is None:\n        # Regression for the formal counterexample: load-use plus division\n        # must also fit the unchanged ten-clock liveness window.\n        [load] = _by_insn(rets, LW(11, 0, 12))\n        [division] = _by_insn(rets, DIV(12, 11, 2))\n        assert 0 < division[\"cycle\"] - load[\"cycle\"] <= 10\n\n\n@cocotb.test()\nasync def division_forwarding_loads_stores_branches_and_x0(dut):\n    await _division_dependencies(dut)\nRefined hypothesis passes schema.\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK32=(1<<32)-1\nDIGITS=set()\n\ndef digit(r,q,multiples,trial_bits):\n    trial=((r<<2)|(q>>30))&((1<<trial_bits)-1)\n    width=trial_bits+1\n    diffs=[(trial-m)&((1<<width)-1) for m in multiples]\n    for k in (3,2,1):\n        if (diffs[k-1]>>(width-1))==0:\n            DIGITS.add(k)\n            return diffs[k-1]&MASK32,((q<<2)|k)&MASK32\n    DIGITS.add(0)\n    return trial, (q<<2)&MASK32\n\ndef recurrence(a,b,signed):\n    sa=a-(1<<32) if signed and (a>>31) else a\n    sb=b-(1<<32) if signed and (b>>31) else b\n    amag,dmag=abs(sa),abs(sb)\n    if dmag>=16:\n        seedq,seedr=0,amag>>28\n    else:\n        r,q=0,amag\n        for _ in range(2):\n            r,q=digit(r,q,(dmag,2*dmag,3*dmag),6)\n        seedq,seedr=q&15,r\n    # Independently check small launch seed, including zero divisor.\n    nibble=amag>>28\n    assert seedq==(nibble//dmag if dmag else 15)\n    assert seedr==(nibble%dmag if dmag else nibble)\n    r,q=seedr,((amag<<4)|seedq)&MASK32\n    multiples=(dmag,2*dmag,3*dmag)\n    for clock in range(7):\n        for _ in range(2):\n            r,q=digit(r,q,multiples,34)\n            if dmag:\n                assert r<dmag\n        assert 0<=r<=MASK32\n    magnitude_q,magnitude_r=q,r\n    if signed and (sa<0)\"'!=(sb<0) and b!=0:\n        q=(-q)&MASK32\n    if signed and sa<0:\n        r=(-r)&MASK32\n    if b==0:\n        eq,er=MASK32,a\n    else:\n        eq=abs(sa)//abs(sb)\n        if (sa<0)!=(sb<0): eq=-eq\n        er=sa-eq*sb\n        eq&=MASK32; er&=MASK32\n    assert (q,r)==(eq,er),(hex(a),hex(b),signed,(q,r),(eq,er))\n    assert magnitude_q<=MASK32 and magnitude_r<=MASK32\n\nvalues=set(range(32))\nfor n in range(1,33):\n    for offset in (-1,0,1):\n        values.add(((1<<n)+offset)&MASK32)\nvalues=sorted(values)\npairs=[(a,b) for a in values for b in values]\n# Exhaust seed nibble and small divisors; both signs are checked below.\npairs += [(n<<28,d) for n in range(16) for d in range(32)]\nrng=random.Random(20260930002)\npairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(20000)]\nfor a,b in pairs:\n    for signed in (False,True):\n        recurrence(a,b,signed)\nassert DIGITS=={0,1,2,3}\nprint(f'\"'Fixed-width seed plus seven-iteration recurrence passed {len(pairs)*2:,} signed/unsigned operand cases ({len(pairs)*4:,} quotient/remainder results); all four radix-4 digits exercised.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
