{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypgen13')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\nhelper='''  function automatic [34:0] segmented_subtract(\n    input logic [33:0] x,\n    input logic [33:0] y\n  );\n    logic [39:0] x_pad, y_pad, difference;\n    logic [8:0] s0 [0:4];\n    logic [8:0] s1 [0:4];\n    logic [4:0] g0,p0,g1,p1,g2,p2,g3,p3;\n    begin\n      x_pad = {6'b0,x};\n      y_pad = {6'b0,y};\n      for (integer j=0; j<5; j=j+1) begin\n        s0[j] = {1'b0,x_pad[8*j +: 8]} +\n                {1'b0,~y_pad[8*j +: 8]} + 9'd1;\n        s1[j] = {1'b0,x_pad[8*j +: 8]} +\n                {1'b0,~y_pad[8*j +: 8]};\n        g0[j] = \"'!s0[j][8];\n        p0[j] = (x_pad[8*j +: 8] == y_pad[8*j +: 8]);\n      end\n      for (integer j=0; j<5; j=j+1) begin\n        if (j>=1) begin\n          g1[j]=g0[j] | (p0[j] & g0[j-1]);\n          p1[j]=p0[j] & p0[j-1];\n        end else begin g1[j]=g0[j]; p1[j]=p0[j]; end\n      end\n      for (integer j=0; j<5; j=j+1) begin\n        if (j>=2) begin\n          g2[j]=g1[j] | (p1[j] & g1[j-2]);\n          p2[j]=p1[j] & p1[j-2];\n        end else begin g2[j]=g1[j]; p2[j]=p1[j]; end\n      end\n      for (integer j=0; j<5; j=j+1) begin\n        if (j>=4) begin\n          g3[j]=g2[j] | (p2[j] & g2[j-4]);\n          p3[j]=p2[j] & p2[j-4];\n        end else begin g3[j]=g2[j]; p3[j]=p2[j]; end\n      end\n      difference[7:0]=s0[0][7:0];\n      for (integer j=1; j<5; j=j+1)\n        difference[8*j +: 8]=g3[j-1] ? s1[j][7:0] : s0[j][7:0];\n      segmented_subtract={g3[4],difference[33:0]};\n    end\n  endfunction\n'\"'''\np=rtl/'divider.sv'\ns=p.read_text()\ns=s.replace('  // Each digit subtracts all three registered multiples concurrently.',helper+'\\\\n  // Each digit subtracts all three registered multiples concurrently.')\nfor k in (1,2,3):\n old=f\\\"diff{k} = {{1'b0, t}} - {{1'b0, d{k}}};\\\"\n assert old in s\n s=s.replace(old,f'diff{k} = segmented_subtract(t,d{k});')\np.write_text(s)\n(root/'subtract_miter.sv').write_text('module subtract_miter(input [33:0] x,y, output good);\\\\n'+helper+\\\"assign good = segmented_subtract(x,y) == ({1'b0,x}-{1'b0,y});\\\\nendmodule\\\\n\\\")\nprint('Created isolated RTL prototype and subtraction equivalence miter')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
