r i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n…[2312 of 5384 chars elided by tools/bench/transcript.py; sha256:ff7aba4256bca3ad]…\nmemWEn && top->io_dmemReady) {\n150:            // MMIO UART at 0x10000000: capture to uart_buf, don't route to dmem\n151:            // (a non-gated ww() would wrap 0x10000000 to dmem[0] and corrupt it).\n154:            // and exclude CoreMark init/CRC-printing from the timing window.\n155:            uint32_t addr = top->io_dmemAddr;\n159:                // Last stop_time() call wins — CoreMark calls it once, but\n164:                    if ((top->io_dmemWEn >> i) & 1) {\n165:                        char c = (top->io_dmemWData >> (i * 8)) & 0xFF;\n170:                ww(dmem, addr, top->io_dmemWData, top->io_dmemWEn);\n172:                // OOB write (neither dmem nor UART). Flag so testbench reports it.\n173:                oob_access = true;\n196:            snprintf(buf, sizeof(buf),\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n272:               oob_access ? \"true\" : \"false\",\n280:    // access occurred. OOB historically silently aliased to dmem[0] which\n283:    if (oob_access)  return 3;\n", "exit_code": 0, "status": "completed"}}
