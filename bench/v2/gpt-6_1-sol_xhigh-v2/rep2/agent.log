    hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 \n…[14237 of 17309 chars elided by tools/bench/transcript.py; sha256:ca685fdad7b7a81d]…\n ws / \"cores\" / target / \"experiments\" / \"hypotheses\"\ntools/agents/hypothesis.py:521:    # The main clone must stay untouched (an agent could still write there\ntools/agents/hypothesis.py:544:                log.write(f'\\n{{\"type\":\"retry_marker\",\"first_rc\":{rc}}}\\n')\ntools/agents/hypothesis.py:557:                                  lambda p: p.startswith(f\"cores/{target}/experiments/hypotheses/\"))\ntools/agents/hypothesis.py:573:        # (file mtime change, no-content-diff write), the breach check\ntools/agents/hypothesis.py:575:        # away in-flight append_log writes, leaving the saved log\ntools/agents/hypothesis.py:592:            # Normalization is best-effort; let the schema validator\ntools/agents/hypothesis.py:602:        # write); it is NOT the right input to a path resolver.\ntools/agents/hypothesis.py:623:                raise FileNotFoundError(\"Hypothesis agent did not write a hypothesis file.\")\ntools/agents/hypothesis.py:628:                f\"Hypothesis agent did not write a file for slot {hyp_id} \"\n", "exit_code": 0, "status": "completed"}}
