{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hyp_probe_r11/test_comparison_probe.py')\np.write_text('''import random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom test_ex_stage import *\nfrom test_ex_stage import _tick, _pack, ID_FIELDS\n\n@cocotb.test()\nasync def branch_comparison_against_integer_oracle(dut):\n    dut.clock.value=0\n    dut.reset.value=1\n    dut.stall.value=0\n    dut.fwd_rs1_sel.value=0\n    dut.fwd_rs2_sel.value=0\n    dut.fwd_ex_mem.value=0\n    dut.fwd_mem_wb.value=0\n    getattr(dut,'in').value=0\n    await _tick(dut)\n    dut.reset.value=0\n    pairs=[]\n    for j in range(16):\n        for a in range(4):\n            for b in range(4):\n                for fill in (0,0xffffffff):\n                    mask=3<<(2*j)\n                    pairs.append(((fill&~mask)|(a<<(2*j)),(fill&~mask)|(b<<(2*j))))\n    for j in range(32):\n        for fill in (0,0xffffffff):\n            high=fill&~((1<<(j+1))-1)\n            for lowa,lowb in ((0,0),((1<<j)-1,0),(0,(1<<j)-1),((1<<j)-1,(1<<j)-1)):\n                a=high|(1<<j)|lowa;b=high|lowb\n                pairs.extend(((a,b),(b,a)))\n    extremes=(0,1,0x7fffffff,0x80000000,0xffffffff)\n    pairs.extend((a,b) for a in extremes for b in extremes)\n    rand=random.Random(110)\n    pairs.extend((rand.getrandbits(32),rand.getrandbits(32)) for _ in range(10000))\n    for a,b in pairs:\n        sa=a-(1<<32) if a>>31 else a\n        sb=b-(1<<32) if b>>31 else b\n        results={0:a==b,1:a\"'!=b,2:False,3:False,4:sa<sb,5:sa>=sb,6:a<b,7:a>=b}\n        for kind,taken in results.items():\n            ctrl=(kind<<13)|(1<<12)|(2<<4)\n            payload=_pack(ID_FIELDS, {'\"'pc':0x100,'prediction':0x104,'rs1':a,'rs2':b,'imm':16,'ctrl':ctrl,'valid':1})\n            getattr(dut,'in').value=payload\n            await Timer(1,'ns')\n            assert bool(int(dut.branch_cond.value))==taken,(kind,hex(a),hex(b))\n            assert bool(int(dut.branch_taken.value))==taken\n            assert bool(int(dut.redirect.value))==taken\n    dut._log.info('Checked %s operand pairs against all 8 branch_op encodings',len(pairs))\n''')\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
