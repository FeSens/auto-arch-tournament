{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"EX comparison, prediction repair, operand and M-transaction contracts.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n                      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n                      BR_BEQ, BR_BNE, BR_BLT, BR_BGE, BR_BLTU, BR_BGEU,\n                      run_cocotb)\n\n\nMASK = 0xFFFFFFFF\nID_FIELDS = [(\"pc\", 32), (\"prediction\", 32), (\"rs1\", 32), (\"rs2\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"ctrl\", 22), (\"insn\", 32), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"result\", 32), (\"write_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1\", 32), (\"rs2\", 32),\n             (\"pc_next\", 32), (\"taken\", 1), (\"target\", 32), (\"ctrl\", 22),\n             (\"insn\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, values):\n    word = 0\n    for name, width in fields:\n        word = (word << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return word\n\n\ndef _unpack(fields, word):\n    values = {}\n    for name, width in reversed(fields):\n        values[name] = word & ((1 << width) - 1)\n        word >>= width\n    return values\n\n\nasync def _tick(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\ndef _comparison_pairs():\n    rng = random.Random(0xB04A32)\n    edges = (0, 1, 2, 0x7FFFFFFF, 0x80000000, 0x80000001,\n             0xFFFFFFFE, MASK)\n    yield from ((a, b) for a in edges for b in edges)\n    for value in (*edges, *(rng.getrandbits(32) for _ in range(256))):\n        yield value, value\n    for j in range(16):\n        shift = 2 * j\n        mask = 3 << shift\n        lower = (1 << shift) - 1\n        for x in range(4):\n            for y in range(4):\n                for common in (0, 0xA5A55A5A, MASK):\n                    a = (common & ~mask) | (x << shift)\n                    b = (common & ~mask) | (y << shift)\n                    yield (a & ~lower) | lower, b & ~lower\n    for bit in range(32\n…[17053 of 20125 chars elided by tools/bench/transcript.py; sha256:57488c86257deaec]…\n, a, b, imm, rd, valid, result, eligible in cases:\n        payload = _pack(ID_FIELDS, {\"pc\": 0x100, \"prediction\": 0x87654320,\n                                    \"rs1\": a, \"rs2\": b, \"imm\": imm, \"rd\": rd,\n                                    \"rs1_addr\": 1, \"rs2_addr\": 2,\n                                    \"ctrl\": ctrl, \"insn\": 0x002082B3, \"valid\": valid})\n        getattr(dut, \"in\").value = payload\n        for blocked in (0, 1):\n            dut.stall.value = blocked\n            await Timer(1, \"ns\")\n            assert int(dut.bypass_w_en.value) == eligible\n            assert int(dut.bypass_rd.value) == rd\n            assert int(dut.bypass_data.value) == result\n            assert int(dut.rs1.value) == a and int(dut.rs2.value) == b\n        dut.stall.value = 0\n        await _tick(dut)\n        if valid:\n            transferred = _unpack(EX_FIELDS, int(dut.out.value))\n            assert (transferred[\"rs1\"], transferred[\"rs2\"], transferred[\"write_data\"]) == (a, b, b)\n            assert transferred[\"result\"] == result\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef MUL (rd, rs1, rs2)\n…[84346 of 87418 chars elided by tools/bench/transcript.py; sha256:83b24b9f9c4d3f19]…\n>= .45))) if stalled else None\n        monitor, services = _OperandDeliveryMonitor(program, initial), []\n        rets, mem = await _run(dut, program, initial, stalls=stalls,\n                               monitor=monitor, services=services, max_cycles=250)\n        assert mem == _check_operand_architecture(rets, program, initial, services)\n        assert len([r for r in rets if r[\"trap\"]]) == 2\n        assert not any(addr in (0x300, 0x304) for _, addr, _, _, _ in services)\n        events.update(monitor.events)\n    assert {\"both-mem\", \"both-ex\", \"flush-hold\", \"redirect\"} <= events\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
