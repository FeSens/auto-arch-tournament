{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM=2**32-1\n\ndef tree(a,b):\n nodes=[((a>>(2*j)&3)==(b>>(2*j)&3),(a>>(2*j)&3)<(b>>(2*j)&3)) for j in range(16)]\n while len(nodes)>1:\n  nodes=[(nodes[j+1][0] and nodes[j][0], nodes[j+1][1] or (nodes[j+1][0] and nodes[j][1])) for j in range(0,len(nodes),2)]\n eq,lt=nodes[0]\n return eq,lt,lt\"'^bool((a''^b)>>31)\n\ndef check(a,b):\n eq,u,s=tree(a,b)\n sa=a-2**32 if a>>31 else a\n sb=b-2**32 if b>>31 else b\n assert (eq,u,s)==(a==b,a<b,sa<sb),(hex(a),hex(b),(eq,u,s))\n\ncount=0\nfor j in range(16):\n for a in range(4):\n  for b in range(4):\n   for equal in [0,M]:\n    mask=3<<(2*j)\n    check((equal&~mask)|(a<<(2*j)),(equal&~mask)|(b<<(2*j)));count+=1\nfor bit in range(32):\n for prefix in [0,M]:\n  high=prefix&~((1<<(bit+1))-1)\n  for low_a,low_b in [(0,0),((1<<bit)-1,0),(0,(1<<bit)-1),((1<<bit)-1,(1<<bit)-1)]:\n   for swap in [False,True]:\n    a=high|(1<<bit)|low_a;b=high|low_b\n    check(b,a) if swap else check(a,b);count+=1\nr=random.Random(110)\nfor _ in range(100000):\n check(r.getrandbits(32),r.getrandbits(32));count+=1\nprint('\"'Comparator recurrence matched independent equality and signed/unsigned less-than for',count,'cases')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
