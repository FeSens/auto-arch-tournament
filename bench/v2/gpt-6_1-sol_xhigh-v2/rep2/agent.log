{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl')\nprobe=Path('cores/bench/generated/hypgen_probe/rtl')\nprobe.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'):\n shutil.copyfile(p,probe/p.name)\nrf='''module reg_file (\n input logic clock, reset,\n input logic read_enable,\n input logic [4:0] rs1_addr, rs2_addr,\n output logic [31:0] rs1_data, rs2_data,\n input logic w_en,\n input logic [4:0] w_addr,\n input logic [31:0] w_data\n);\n logic [31:0] bank_rs1_q [0:3], bank_rs2_q [0:3];\n logic [1:0] select_rs1_q, select_rs2_q;\n logic bypass_rs1_q, bypass_rs2_q;\n logic [31:0] bypass_data_q;\n'''\nfor bank in range(4):\n for row in range(8):\n  reg=bank*8+row\n  if reg:\n   rf+=f' logic [31:0] r{reg};\\\\n always_ff @(posedge clock) begin\\\\n if (reset) r{reg} <= 0;\\\\n else if (w_en && w_addr == 5\\\\'d{reg}) r{reg} <= w_data;\\\\n end\\\\n'\n for port in [1,2]:\n  rf+=f' logic [31:0] bank{bank}_rs{port};\\\\n always_comb begin\\\\n case (rs{port}_addr[2:0])\\\\n'\n  for row in range(8):\n   reg=bank*8+row\n   val='32\\\\'b0' if reg==0 else f'r{reg}'\n   rf+=f' 3\\\\'d{row}: bank{bank}_rs{port} = {val};\\\\n'\n  rf+=f' default: bank{bank}_rs{port} = 0;\\\\n endcase\\\\n end\\\\n'\n rf+=f''' always_ff @(posedge clock) begin\n if (reset) begin bank_rs1_q[{bank}] <= 0; bank_rs2_q[{bank}] <= 0; end\n else if (read_enable) begin\n bank_rs1_q[{bank}] <= bank{bank}_rs1;\n bank_rs2_q[{bank}] <= bank{bank}_rs2;\n end\n end\n'''\nrf+=''' always_ff @(posedge clock) begin\n if (reset) begin\n select_rs1_q <= 0; select_rs2_q <= 0;\n bypass_rs1_q <= 0; bypass_rs2_q <= 0; bypass_data_q <= 0;\n end else if (read_enable) begin\n select_rs1_q <= rs1_addr[4:3]; select_rs2_q <= rs2_addr[4:3];\n bypass_rs1_q <= w_en && w_addr \"'!= 0 && w_addr == rs1_addr;\n bypass_rs2_q <= w_en && w_addr != 0 && w_addr == rs2_addr;\n bypass_data_q <= w_data