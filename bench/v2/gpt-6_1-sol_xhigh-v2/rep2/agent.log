{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nM32=(1<<32)-1\nM64=(1<<64)-1\nM48=(1<<48)-1\n\ndef half_product(a,b,sign_a,sign_b):\n al,bl=a&0xffff,b&0xffff\n ah,bh=a>>16,b>>16\n if sign_a and a>>31: ah-=1<<16\n if sign_b and b>>31: bh-=1<<16\n ll=al*bl\n rows=[ll,(al*bh<<16)&M64,(ah*bl<<16)&M64,(ah*bh<<32)&M64]\n def csa(x,y,z):\n  return x\"'^y''^z, (((x&y)|(x&z)|(y&z))<<1)&M64\n s,c=csa(*rows[:3])\n s,c=csa(s,c,rows[3])\n assert s&0xffff==ll&0xffff\n assert c&0xffff==0\n return (((((s>>16)+(c>>16))&M48)<<16)|(ll&0xffff))&M64\nedges=(0,1,2,0xffff,0x10000,0x10001,0x7fff0000,0x7fffffff,0x80000000,0x80000001,0xffff0000,0xfffffffe,0xffffffff)\nrng=random.Random(0x4D554C)\npairs=[(a,b) for a in edges for b in edges]\npairs +=[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(100000)]\ncount=0\nfor a,b in pairs:\n for sign_a,sign_b in ((False,False),(True,True),(True,False)):\n  sa=a-(1<<32) if sign_a and a>>31 else a\n  sb=b-(1<<32) if sign_b and b>>31 else b\n  got=half_product(a,b,sign_a,sign_b)\n  assert got==(sa*sb)&M64,(a,b,sign_a,sign_b)\n  assert got&M32==(a*b)&M32\n  count+=1\nprint(f'\"'Exact 17-bit-half / two-compressor / 48-bit final-adder model matched {count:,} signed and unsigned products.')\nprint('Low-column zero-carry property verified in every case.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
