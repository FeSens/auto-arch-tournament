return 2\n    y = yaml.safe_load(p.read_text()) or {}\n    n = y.get(\"nret\", 2)\n    if n not in (1, 2):\n        raise ValueError(f\"core.yaml nret must be 1 or 2, got {n!r}\")\n    return n\n\n# Floor on how many .sby tasks must pass for a \"formal: green\" result.\n# V0 baseline produces 53. Allow some slack (≥50) so a future checks.cfg\n# tweak that legitimately drops 1-2 checks doesn't trigger a false alarm,\n# but reject a partial genchecks run that emits 1-2 tasks.\nEXPECTED_MIN_CHECKS = int(os.environ.get(\"FORMAL_M\n…[38181 of 41253 chars elided by tools/bench/transcript.py; sha256:d9dd96844e1a0c0b]…\n no secrets, and pins which toolchain binaries\n# produced each rep's numbers.\n\n# Throwaway harness-verification runs (one-model YAMLs + their output\n# trees). These are reliability checks, not benchmark data — output is\n# regenerable and the YAMLs only encode \"rerun this single model to\n# confirm a fix landed\". Naming convention: `*-verify` for output dirs,\n# `models-*-verify.yaml` for the throwaway model YAML.\nbench/*-verify/\nbench/smoke-*/\ntools/bench/models-*-verify.yaml\n\n# Aborted/partial bench output preserved locally with a debug-tag suffix\n# (e.g. `gpt-5_5.failed-pwd-bug/`, `gpt-5_5.validate-v3/`, sibling\n# `results.jsonl.<tag>`). They document a known-broken state for the\n# author's own postmortem; the canonical results live in the un-suffixed\n# per-model dirs.\nbench/*.failed-*\nbench/*.validate-*\nbench/*.prev-*\nbench/*.stale-*\nbench/*.partial-*\nbench/results.jsonl.*\nlrwxrwxrwx 1 nobody nogroup 66 Sep 30 23:22 formal/riscv-formal -> /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep2/formal/riscv-formal\n20\n", "exit_code": 0, "status": "completed"}}
