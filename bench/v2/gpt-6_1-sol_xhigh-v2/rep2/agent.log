{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'predictor|return.address|gshare|history|associat|BTB|RAS|bimodal' cores/bench/experiments/log.jsonl\"", "aggregated_output": "4:{\"id\": \"hyp-20260930-003-r1s2\", \"title\": \"Small tagged next-PC predictor removes taken-control bubbles\", \"category\": \"predictor\", \"motivation\": \"The baseline has no branch prediction: IF always selects PC+4, and EX\\nredirects and squashes the combinational IF/ID instruction on every taken\\nbranch, JAL, or JALR. Because IF/ID is not registered, this wastes one\\nfetch opportunity per taken control transfer. CoreMark repeatedly executes\\nloops and calls, so learning their direction and target should recover\\nenough cycles to exceed the 4.6 percent acceptance threshold. The reported\\nFmax bottleneck is the combinational arithmetic path; a small predictor\\nshould improve iterations per cycle without lengthening that path. There\\nare no recorded predictor attempts or distilled lessons in this fixture.\\n\", \"hypothesis\": {\"motivation\": \"The baseline has no branch prediction: IF always selects PC+4, and EX\\nredirects and squashes the combinational IF/ID instruction on every taken\\nbranch, JAL, or JALR. Because IF/ID is not registered, this wastes one\\nfetch opportunity per taken control transfer. CoreMark repeatedly executes\\nloops and calls, so learning their direction and target should recover\\nenough cycles to exceed the 4.6 percent acceptance threshold. The reported\\nFmax bottleneck is the combinational arithmetic path; a small predictor\\nshould improve iterations per cycle without lengthening that path. There\\nare no recorded predictor attempts or distilled lessons in this fixture.\\n\", \"hypothesis\": \"Add one 32-entry direct-mapped, fully tagged next-PC predictor inside IF.\\nIndex with PC[6:2], tag with PC[31:7], and store an aligned target[31:2],\\na conditional/unconditional bit, a two-bit saturating direction counter,\\nand valid. Read asynchronously in parallel with instruction fetch, without\\nadding a pipeline stage. On a valid tag hit, predict the cached target for\\nan unconditional transfer or a conditional branch whose counter MSB is 1;\\notherwise predict PC+4. This predicts JAL/JALR as well as conditional\\nbr\n…[340275 of 343347 chars elided by tools/bench/transcript.py; sha256:f97f5300076c21f0]…\null-queue correction/reset.\\n\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Exercise deeper predicted lookahead across blocking arithmetic,\\nmemory holds, subsequent imem stalls and branch corrections;\\nretain exact retirement and wrong-path side-effect assertions.\\n\"}], \"outcome\": \"regression\", \"fitness\": 177.75, \"delta_pct\": -11.52, \"vs_baseline\": 1366.58, \"fmax_mhz\": 71.617, \"ipc_coremark\": 2e-06, \"cycles\": 4029095, \"iterations\": 10, \"lut4\": 5245, \"ff\": 2695, \"seeds\": [69.531, 71.617, 71.617], \"perturbations\": [[0, 69.531, 13], [1, 71.617, 13], [2, 71.617, 13]], \"lutram\": 0, \"bsram\": 7, \"dsp\": 2, \"critical_path\": {\"from\": \"cpu/u_if/read_q_1_s0\", \"to\": \"cpu/u_if/queued_instr[7]_16_s0\", \"slack_ns\": -9.382, \"arrival_ns\": 19.676, \"logic_cells\": 16, \"modules\": [\"clock_ibuf\", \"cpu/u_if\", \"cpu/u_hazard\", \"cpu/u_id\", \"cpu/u_if\"]}, \"logic_levels\": 13, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-10-01T00:34:43.960107Z\", \"slot\": 2, \"round_id\": 14}\n", "exit_code": 0, "status": "completed"}}
