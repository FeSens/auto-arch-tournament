cept) pc <= next_pc;')\ns=s.replace('''    out.pc    = pc;\n    out.instr = imem_data;\n    out.predicted_next_pc = next_pc;\n    out.valid = \"'!reset && !flush;'\"''','''    if (count_q \"'!= 0) out = queue_q[read_q];\n    else begin\n      out.pc = pc;\n      out.instr = imem_data;\n      out.predicted_next_pc = next_pc;\n      out.valid = 1'\"'b1;\n    end\n    out.valid = fetch_available && \"'!flush;'\"''')\np.write_text(s)\np=rtl/'core.sv'\ns=p.read_text()\ns=s.replace('logic       div_hold, mul_hold;','logic       div_hold, mul_hold;\\\\n  logic       fetch_available;')\ns=s.replace('.stall           (stall_if),','.stall           (stall_id),\\\\n    .imem_ready      (io_imemReady),\\\\n    .fetch_available (fetch_available),')\ns=s.replace('.if_id_rs1      (io_imemData[19:15]),','.if_id_rs1      (if_id_w.instr[19:15]),')\ns=s.replace('.if_id_rs2      (io_imemData[24:20]),','.if_id_rs2      (if_id_w.instr[24:20]),')\ns=s.replace('.fetch_available (io_imemReady && \"'!reset),'\"','.fetch_available (fetch_available),')\ns=s.replace('.imem_ready     (io_imemReady),','.imem_ready     (fetch_available),')\np.write_text(s)\nprint('Prepared two-entry predicted-path lookahead prototype')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
