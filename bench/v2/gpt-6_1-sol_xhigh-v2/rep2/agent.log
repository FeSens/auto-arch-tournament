{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('formal/riscv-formal/cores/bench-dividerA/checks/liveness_ch0/engine_0/trace.vcd')\nscope=[]; names={}; rows=[]; vals={}; stamp=None\nfor line in p.read_text().splitlines():\n    s=line.split()\n    if not s: continue\n    if s[0]=='\"'$scope'\"': scope.append(s[2])\n    elif s[0]=='\"'$upscope'\"': scope.pop()\n    elif s[0]=='\"'$var'\"': names[s[3]]='.'.join(scope+[s[4]])\n    elif line.startswith('#'):\n        if stamp is not None and stamp %10==0: rows.append((stamp//10, vals.copy()))\n        stamp=int(line[1:])\n    elif s[0][0]=='b' and len(s)==2: vals[s[1]]=int(s[0][1:],2)\nfields=['cycle','rvfi_valid','rvfi_order','rvfi_insn','rvfi_pc_rdata','wrapper.uut.u_ex.div_pending_q','wrapper.uut.u_ex.div_hold','wrapper.uut.u_ex.div_launch','wrapper.uut.u_ex.u_alu.u_divider.iteration_q','wrapper.uut.u_ex.div_rsp_valid','wrapper.uut.u_hazard.load_use_hazard','wrapper.uut.u_id.reg_q']\nids=[]\nfor field in fields:\n    matches=[(k,n) for k,n in names.items() if n=='rvfi_testbench.'+field]\n    ids.append(matches[0][0] if matches else None)\nprint(fields)\nfor t,v in rows:\n    out=[]\n    for f,k in zip(fields,ids):\n        x=v.get(k)\n        if f=='wrapper.uut.u_id.reg_q' and x is not None: out.append(hex((x>>1)&0xffffffff)+' valid='+str(x&1))\n        else: out.append(hex(x) if x is not None else '?')\n    print(t, ' '.join(out))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
