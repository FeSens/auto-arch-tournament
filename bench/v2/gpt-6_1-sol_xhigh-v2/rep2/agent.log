{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/5ff8876e/01a57940')\nfor mode in ('negative','complement'):\n p=base/('divider_'+mode); (p/'rtl').mkdir(parents=True,exist_ok=True)\n for f in Path('cores/bench/rtl').glob('*.sv'): shutil.copyfile(f,p/'rtl'/f.name)\n s=(p/'rtl/divider.sv').read_text()\n if mode=='negative':\n  s=s.replace('logic [33:0] divisor_q, divisor_twice_q, divisor_thrice_q;', '''logic [33:0] divisor_q, divisor_twice_q, divisor_thrice_q;\n  logic [34:0] negative_divisor_q, negative_twice_q, negative_thrice_q;\n  logic [34:0] negative_once, negative_twice;\n  assign divisor_q = -negative_divisor_q[33:0];\n  assign divisor_twice_q = -negative_twice_q[33:0];\n  assign divisor_thrice_q = -negative_thrice_q[33:0];''')\n  for k in ('d1','d2','d3'): s=s.replace('input logic [33:0] '+k,'input logic [34:0] '+k)\n  for k in (1,2,3): s=s.replace(\\\"diff%d = {1'b0, t} - {1'b0, d%d};\\\"%(k,k),\\\"diff%d = {1'b0, t} + d%d;\\\"%(k,k))\n  s=s.replace('divisor_q, divisor_twice_q, divisor_thrice_q);','negative_divisor_q, negative_twice_q, negative_thrice_q);')\n  s=s.replace('  assign divisor_once =', '''  assign negative_once = (signed_op && b[31]) ? {3'b111,b} : -{3'b000,b};\n  assign negative_twice = negative_once << 1;\n  assign divisor_once =''')\n  s=s.replace(\\\"      divisor_q <= '0;\\\\n      divisor_twice_q <= '0;\\\\n      divisor_thrice_q <= '0;\\\", \\\"      negative_divisor_q <= '0;\\\\n      negative_twice_q <= '0;\\\\n      negative_thrice_q <= '0;\\\")\n  s=s.replace('        divisor_q <= divisor_once;\\\\n        divisor_twice_q <= divisor_twice;\\\\n        divisor_thrice_q <= divisor_once + divisor_twice;', '        negative_divisor_q <= negative_once;\\\\n        negative_twice_q <= negative_twice;\\\\n        negative_thrice_q <= negative_once + negative_twice;')\n else:\n  s=s.replace('logic [33:0] div