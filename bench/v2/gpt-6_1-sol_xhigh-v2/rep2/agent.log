{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/5ff8876e/01a57940/divider_threshold')\n(p/'rtl').mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copyfile(f,p/'rtl'/f.name)\ns=(p/'rtl/divider.sv').read_text()\nhelper='''  // Full unsigned threshold comparison, independently of subtraction.\n  function automatic logic threshold_ge34(\n    input logic [33:0] x,\n    input logic [33:0] y\n  );\n    logic [15:0] e0, l0;\n    logic [7:0] e1, l1;\n    logic [3:0] e2, l2;\n    logic [1:0] e3, l3;\n    logic elow, llow;\n    begin\n      for (integer j=0; j<16; j=j+1) begin\n        e0[j] = (x[2*j +: 2] == y[2*j +: 2]);\n        l0[j] = (x[2*j +: 2] < y[2*j +: 2]);\n      end\n      for (integer j=0; j<8; j=j+1) begin\n        e1[j] = e0[2*j+1] & e0[2*j];\n        l1[j] = l0[2*j+1] | (e0[2*j+1] & l0[2*j]);\n      end\n      for (integer j=0; j<4; j=j+1) begin\n        e2[j] = e1[2*j+1] & e1[2*j];\n        l2[j] = l1[2*j+1] | (e1[2*j+1] & l1[2*j]);\n      end\n      for (integer j=0; j<2; j=j+1) begin\n        e3[j] = e2[2*j+1] & e2[2*j];\n        l3[j] = l2[2*j+1] | (e2[2*j+1] & l2[2*j]);\n      end\n      elow = e3[1] & e3[0];\n      llow = l3[1] | (e3[1] & l3[0]);\n      threshold_ge34 = \"'!((x[33:32] < y[33:32]) |\n                         ((x[33:32] == y[33:32]) & llow));\n    end\n  endfunction\n\n'\"'''\nhelper=helper.replace('    logic elow, llow;','    logic llow;').replace('      elow = e3[1] & e3[0];\\\\n','')\nstart=s.index('  function automatic [63:0] radix4_step(')\ns=s[:start]+helper+s[start:]\ns=s.replace('logic [34:0] diff1, diff2, diff3;', 'logic [31:0] diff1, diff2, diff3;\\\\n    logic ge1, ge2, ge3;')\ns=s.replace(\\\"diff1 = {1'b0, t} - {1'b0, d1};\\\",'diff1 = t[31:0] - d1[31:0];\\\\n      ge1 = threshold_ge34(t,d1);')\ns=s.replace(\\\"diff2 = {1'b0, t} - {1'b0, d2};\\\",'diff2 = t[31:0] - d2[31:0];\\\\n      ge2 = threshold_ge34(t,d2);')\ns=s.replace(\\\"diff3 = {1'b0, t} - {1'b0, d3};\\\",'diff3 = t[31:0] - d3[31:0];\\\\n      ge3 = threshold_ge34(t,d3);')\ns=s.replace('\"'!diff3[34]'\"','ge3').replace('\"'!diff2[34]'\"','ge2').replace('\"'!diff1[34]'\"','ge1')\n(p/'rtl/divider.sv').write_text(s)\noriginal=Path('cores/bench/rtl/divider.sv').read_text()\ndef extract(txt,name):\n st=txt.index('  function automatic [63:0] '+name+'(')\n en=txt.index('  endfunction',st)+len('  endfunction')\n return txt[st:en]\nold=extract(original,'radix4_step').replace('radix4_step','old_step')\nnew=extract(s,'radix4_step').replace('radix4_step','new_step')\nmiter='''module miter(input [31:0] r,q,input [33:0] d1,d2,d3,input [33:0] x,y, output bad_ge,bad_step);\\\\n'''+helper+old+'\\\\n'+new+'''\\\\nassign bad_ge = threshold_ge34(x,y) \"'!= (x>=y);\nassign bad_step = old_step(r,q,d1,d2,d3) != new_step(r,q,d1,d2,d3);\nendmodule\n'\"'''\n(p/'miter.sv').write_text(miter)\n(p/'run_timing.py').write_text('''from pathlib import Path\nimport json\nfrom tools.eval.gowin import build_all,summarize\np=Path('/srv/hwebench/tmp/5ff8876e/01a57940/divider_threshold')\nr=build_all(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',p/'gowin',options=(0,1,2))\n(p/'timing.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(summarize(r)),flush=True)\n''')\n(p/'run_tests.py').write_text('''from pathlib import Path\nimport sys\nsys.path.insert(0,str(Path.cwd()/'cores/bench/test'))\nimport _helpers\np=Path('/srv/hwebench/tmp/5ff8876e/01a57940/divider_threshold')\n_helpers.RTL=p/'rtl'\n_helpers.SIM_BUILD=p/'sim_build'\nimport test_alu\ntest_alu.test_alu_runner()\ntest_alu.test_alu_altops_runner()\n''')\nprint('Isolated prototype:',p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
