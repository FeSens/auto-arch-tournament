{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '717,795p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "        self.correction_holds = set()\n        self.queue = _QueueMonitor()\n\n    def __call__(self, cycle, dut, phase):\n        self.queue(cycle, dut, phase)\n        if phase == \"before\":\n            pc = int(dut.io_imemAddr.value)\n            raw = int(dut.io_imemData.value)\n            entry = self.table.get((pc >> 2) & 63)\n            prediction = (entry[1] if entry and entry[0] == pc >> 8 and\n                          (not entry[2] or entry[3] >= 2) else (pc + 4) & 0xFFFFFFFF)\n            assert int(dut.u_if.next_pc.value) == prediction, (pc, entry, prediction)\n            head_pc, head_raw, head_prediction, available = _if_snapshot(dut)\n            self.before = _id_snapshot(dut)\n            ex_pc, saved_prediction, insn, valid, _ = self.before\n            self.stall = int(dut.stall_id.value)\n            self.flush = int(dut.flush_id.value)\n            self.raw = head_raw\n            self.fetch_pc = head_pc\n            self.fetch_prediction = head_prediction\n            self.fetch_valid = available\n            self.training = int(dut.train_valid.value)\n            self.correction = int(dut.redirect.value)\n            if self.correction:\n                if not int(dut.io_imemReady.value):\n                    self.correction_holds.add(\"imem\")\n                if int(dut.u_hazard.load_use_hazard.value):\n                    self.correction_holds.add(\"load-use\")\n            if not valid:\n                assert not self.training and not self.correction\n                assert not int(dut.u_ex.div_req_valid.value)\n                assert not int(dut.u_ex.mul_req_valid.value)\n                if insn & 0x7F in (0x33, 0x63, 0x67, 0x6F, 0x03, 0x23):\n                    self.invalid_controls.add(insn & 0x7F)\n            assert self.training == bool(valid and not int(dut.stall_ex_mem.value)\n                                         and not int(dut.div_hold.value)\n                                         and not int(dut.mul_hold.value))\n            if self.training:\n                actual = int(dut.redirect_target.value)\n                assert self.correction == (saved_prediction != actual)\n                install = int(dut.train_install.value)\n                conditional = int(dut.train_conditional.value)\n                taken = int(dut.train_taken.value)\n                target = int(dut.train_target.value)\n                assert int(dut.train_pc.value) == ex_pc\n                self.events.append((ex_pc, insn, saved_prediction, actual,\n                                    self.correction, taken, cycle))\n                index = (ex_pc >> 2) & 63\n                old = self.table.get(index)\n                match = old and old[0] == ex_pc >> 8\n                if install:\n                    assert target & 3 == 0\n                    counter = (max(0, min(3, old[3] + (1 if taken else -1)))\n                               if match and conditional and old[2] else 2 if taken else 1)\n                    self.table[index] = (ex_pc >> 8, target, conditional, counter)\n                    self.counters.append((ex_pc, counter))\n                elif match:\n                    del self.table[index]\n                if (not self.correction and actual != (ex_pc + 4) & 0xFFFFFFFF\n                        and not self.stall and self.fetch_valid):\n                    assert head_pc == actual\n                    self.warm_accepts += 1\n        else:\n            after = _id_snapshot(dut)\n            if self.flush:\n                assert not after[3], \"correction/load-use flush must win over hold\"\n            elif self.stall:\n                assert after == self.before, \"instruction/prediction changed during hold\"\n            else:\n                assert after[3] == self.fetch_valid\n            if self.stall:\n                assert after[4] >> 1 == self.before[4] >> 1\n            else:\n                assert after[:3] == (self.fetch_pc, self.fetch_prediction, self.raw), (\n                    \"flush changed decoded payload capture\", after, self.raw)\n            if self.correction:\n                assert int(dut.io_imemAddr.value) == self.events[-1][3]\n\n\n", "exit_code": 0, "status": "completed"}}
