{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '625,1020p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n\ndef _id_snapshot(dut):\n    \"\"\"PC/prediction are the two high words, validity the low bit.\"\"\"\n    value = int(dut.u_id.reg_q.value)\n    width = len(dut.u_id.reg_q)\n    return (value >> (width - 32),\n            (value >> (width - 64)) & 0xFFFFFFFF,\n            (value >> 1) & 0xFFFFFFFF, value & 1, value)\n\n\nclass _PredictorMonitor:\n    \"\"\"Independent table model, exact recovery, and validity-only bubbles.\"\"\"\n    def __init__(self):\n        self.table = {}\n        self.events = []\n        self.counters = []\n        self.warm_accepts = 0\n        self.invalid_controls = set()\n        self.correction_holds = set()\n\n    def __call__(self, cycle, dut, phase):\n        if phase == \"before\":\n            pc = int(dut.io_imemAddr.value)\n            raw = int(dut.io_imemData.value)\n            entry = self.table.get((pc >> 2) & 63)\n            prediction = (entry[1] if entry and entry[0] == pc >> 8 and\n                          (not entry[2] or entry[3] >= 2) else (pc + 4) & 0xFFFFFFFF)\n            assert int(dut.u_if.next_pc.value) == prediction, (pc, entry, prediction)\n            assert int(dut.rs1_addr_w.value) == (raw >> 15) & 31\n            assert int(dut.rs2_addr_w.value) == (raw >> 20) & 31\n            assert (int(dut.if_id_w.value) >> 33) & 0xFFFFFFFF == raw\n            self.before = _id_snapshot(dut)\n            ex_pc, saved_prediction, insn, valid, _ = self.before\n            self.stall = int(dut.stall_id.value)\n            self.flush = int(dut.flush_id.value)\n            self.raw = raw\n            self.fetch_pc = pc\n            self.fetch_prediction = prediction\n            self.fetch_valid = int(dut.io_imemReady.value)\n            self.training = int(dut.train_valid.value)\n            self.correction = int(dut.redirect.value)\n            if self.correction:\n                if not self.fetch_valid:\n                    self.correction_holds.add(\"imem\")\n                if int(dut.u_hazard.load_use_hazard.value):\n                    self.correction_holds.add(\"load-use\")\n            if not valid:\n                asse\n…[15756 of 18828 chars elided by tools/bench/transcript.py; sha256:064efb0e57fbd99c]…\n and not mem\n    program = [ADDI(1, 0, 1), BEQ(0, 1, 2), BEQ(0, 0, 2), JAL(5, 2),\n               ADDI(2, 0, 27), JALR(6, 2, 0), ADDI(2, 0, 33),\n               JALR(7, 2, 0), EBREAK()]\n    monitor = _PredictorMonitor()\n    rets, _ = await _run(dut, program, monitor=monitor)\n    _check_stream(rets, {4 * i: insn for i, insn in enumerate(program)}, list(range(0, 36, 4)))\n    assert [r[\"trap\"] for r in rets] == [0, 0, 1, 1, 0, 1, 0, 0, 0]\n    assert all(r[\"rd\"] == 0 for r in rets if r[\"trap\"])\n    assert rets[-2][\"rd_wdata\"] == 32\n    assert not any(pc in (4, 8, 12, 20) for pc, _ in monitor.counters)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
