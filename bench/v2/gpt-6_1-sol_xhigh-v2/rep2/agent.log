{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_stage.py; cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Fetch acceptance must retain the prediction from before table training.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _bundle(dut):\n    value = int(dut.out.value)\n    return (value >> 65, (value >> 33) & 0xFFFFFFFF,\n            (value >> 1) & 0xFFFFFFFF, value & 1)\n\n\nasync def _edge(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def queue_saves_old_prediction_across_training_and_full_replacement(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.decode_hold.value = 1\n    dut.imem_ready.value = 1\n    dut.imem_data.value = 0x00100093\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = dut.train_target.value = 0\n    dut.train_install.value = 1\n    dut.train_conditional.value = 0\n    dut.train_taken.value = 1\n    await _edge(dut)\n    dut.reset.value = 0\n\n    # A table installation and queued fetch on the same edge use old data.\n    dut.train_valid.value = 1\n    dut.train_pc.value = 0\n    dut.train_target.value = 0x80000100\n    await Timer(1, \"ns\")\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n    await _edge(dut)\n    assert int(dut.imem_addr.value) == 4\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n\n    # Changing the head's table entry must not alter its saved prediction.\n    dut.train_target.value = 0x12345678\n    dut.imem_data.value = 0x00200113\n    await _edge(dut)\n    assert int(dut.count_q.value) == 2\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n\n    # Invalidate the head's entry while replacing a full queue's old head.\n    dut.train_install.value = 0\n    dut.decode_hold.value = 0\n    dut.imem_data.value = 0x00300193\n    await Timer(1, \"ns\")\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n    await _edge(dut)\n    assert int(dut.count_q.value) == 2\n    assert _bundle(dut) == (4, 0x00200113, 8, 1)\n\n    dut.train_valid.value = 0\n    dut.imem_ready.value = 0\n    # Deliberately unre\n…[20909 of 23981 chars elided by tools/bench/transcript.py; sha256:87b8bcc120e2fda4]…\n, a, b, imm, rd, valid, result, eligible in cases:\n        payload = _pack(ID_FIELDS, {\"pc\": 0x100, \"prediction\": 0x87654320,\n                                    \"rs1\": a, \"rs2\": b, \"imm\": imm, \"rd\": rd,\n                                    \"rs1_addr\": 1, \"rs2_addr\": 2,\n                                    \"ctrl\": ctrl, \"insn\": 0x002082B3, \"valid\": valid})\n        getattr(dut, \"in\").value = payload\n        for blocked in (0, 1):\n            dut.stall.value = blocked\n            await Timer(1, \"ns\")\n            assert int(dut.bypass_w_en.value) == eligible\n            assert int(dut.bypass_rd.value) == rd\n            assert int(dut.bypass_data.value) == result\n            assert int(dut.rs1.value) == a and int(dut.rs2.value) == b\n        dut.stall.value = 0\n        await _tick(dut)\n        if valid:\n            transferred = _unpack(EX_FIELDS, int(dut.out.value))\n            assert (transferred[\"rs1\"], transferred[\"rs2\"], transferred[\"write_data\"]) == (a, b, b)\n            assert transferred[\"result\"] == result\n", "exit_code": 0, "status": "completed"}}
