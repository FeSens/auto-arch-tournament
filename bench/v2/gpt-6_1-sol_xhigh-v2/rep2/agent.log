1:0] next_pc;\n  logic [63:0] valid_q;\n  logic [23:0] tag_q [0:63];\n  logic [29:0] target_q [0:63];\n  logic conditional_q [0:63];\n  logic [1:0] counter_q [0:63];\n  logic lookup_hit, train_match;\n  logic [5:0] lookup_index, train_index;\n\n  assign lookup_index = pc[7:2];\n  assign train_index = train_pc[7:2];\n  assign lookup_hit = valid_q[lookup_index] &&\n   \n…[9234 of 12306 chars elided by tools/bench/transcript.py; sha256:390e4b6ec2ea3615]…\n  (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    stall_id      = dmem_stall || load_use_hazard || div_hold;\n    // EX qualifies correction by advance, so it always wins over a\n    // coincident younger load-use hold or unavailable fetch.\n    flush_id      = redirect || (load_use_hazard && !dmem_stall && !div_hold);\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
