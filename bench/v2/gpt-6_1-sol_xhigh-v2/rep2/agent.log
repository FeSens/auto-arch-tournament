eq_ready.value) == 1\n\n\n@cocotb.test()\nasync def reset_cancels_pending_and_completed_division(dut):\n    await _setup(dut)\n    for reset_after in (0, 3, 6, 7, 8):\n        await _launch_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF)\n        for _ in range(reset_after):\n            await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(10):\n            await _tick(dut)\n            assert int(dut.div_rsp_valid.value) == 0\n            assert int(dut.div_req_ready.value) == 1\n        await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, MASK32)\n\n\n@cocotb.test()\nasync def registered_completion_transfers_once(dut):\n    \"\"\"Ready cannot consume iteration seven before its registered response.\"\"\"\n    await _setup(dut)\n    for op in DIV_OPS:\n        for a, b in ((0xFFFFFF85, 7), (0x80000000, 0xFFFFFFFF), (0xDEADBEEF, 0)):\n            await _launch_div(dut, op, a, b)\n            dut.div_rsp_ready.value = 1\n            prior_result = int(dut.out.value)\n            for iteration in range(1, 8):\n                await _tick(dut)\n                assert int(dut.div_rsp_valid.value) == (iteration == 7)\n                assert int(dut.div_req_ready.value) == 0\n                if iteration < 7:\n                    assert int(dut.out.value) == prior_result\n            expected = _expected(op, a, b, _division_model(op, a, b))\n            assert int(dut.out.value) == expected\n            await _tick(dut)\n            dut.div_rsp_ready.value = 0\n            assert int(dut.div_rsp_valid.value) == 0\n            assert int(dut.div_req_ready.value) == 1\n            for _ in range(2):\n19\t4\tcores/bench/rtl/core.sv\n2\t0\tcores/bench/rtl/core_pkg.sv\n52\t13\tcores/bench/rtl/ex_stage.sv\n10\t11\tcores/bench/rtl/hazard_unit.sv\n6\t2\tcores/bench/rtl/id_stage.sv\n59\t9\tcores/bench/rtl/if_stage.sv\n330\t2\tcores/bench/test/test_pipeline.py\n","exit_code":0,"status":"completed"}}
