{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/5ff8876e/a5bf9814/predictor_probe')\nt=base/'test';t.mkdir(exist_ok=True)\nfor name in ('test_if_stage.py','_helpers.py'): shutil.copy2(Path('cores/bench/test')/name,t/name)\n(t/'test_probe.py').write_text('''import random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom test_if_stage import _edge, _bundle\n\n@cocotb.test()\nasync def original_predictor_model(dut):\n    r=random.Random(9232)\n    model=[None]*64\n    dut.clock.value=0\n    dut.reset.value=1\n    dut.decode_hold.value=0\n    dut.imem_ready.value=0\n    dut.imem_data.value=0x13\n    dut.redirect.value=0\n    dut.redirect_target.value=0\n    dut.train_valid.value=0\n    dut.train_pc.value=0\n    dut.train_target.value=0\n    dut.train_install.value=0\n    dut.train_conditional.value=0\n    dut.train_taken.value=0\n    await _edge(dut)\n    dut.reset.value=0\n    for n in range(2400):\n        index=n%64\n        pc=(r.choice([0,1,0x123456,0x800000,0xffffff])<<8)|(index<<2)\n        dut.redirect.value=1\n        dut.redirect_target.value=pc\n        dut.train_valid.value=0\n        await _edge(dut)\n        dut.redirect.value=0\n        row=model[index]\n        want=((row[1]<<2) if row and row[0]==pc>>8 and (not row[2] or row[3]>=2)\n              else (pc+4)&0xffffffff)\n        assert _bundle(dut)[2]==want,(n,hex(pc),row,hex(_bundle(dut)[2]),hex(want))\n        tpc=pc if r.random()<0.7 else pc\"'^0x100\n        tidx=(tpc>>2)&63\n        install=int(r.random()<0.83)\n        taken=r.randrange(2)\n        conditional=r.randrange(2)\n        target=r.getrandbits(30)<<2\n        dut.train_valid.value=1\n        dut.train_pc.value=tpc\n        dut.train_target.value=target\n        dut.train_install.value=install\n        dut.train_conditional.value=conditional\n        dut.train_taken.value=taken\n        await Ti