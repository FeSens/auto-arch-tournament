{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench')\np=base/'generated/r12_predicates'\nshutil.copytree(base/'rtl',p/'rtl',dirs_exist_ok=True)\nshutil.copytree(base/'test',p/'test',dirs_exist_ok=True)\ns=(base/'rtl/divider.sv').read_text()\nf='''  function automatic logic unsigned_ge34(\n    input logic [33:0] x, y\n  );\n    logic [31:0] eq0, lt0;\n    logic [15:0] eq1, lt1;\n    logic [7:0] eq2, lt2;\n    logic [3:0] eq3, lt3;\n    logic [1:0] eq4, lt4;\n    begin\n      for (integer j=0; j<32; j=j+1) begin\n        if (j<17) begin\n          eq0[j] = x[2*j +: 2] == y[2*j +: 2];\n          lt0[j] = x[2*j +: 2] < y[2*j +: 2];\n        end else begin\n          eq0[j] = 1'b1;\n          lt0[j] = 1'b0;\n        end\n      end\n      for (integer j=0; j<16; j=j+1) begin\n        eq1[j] = eq0[2*j+1] & eq0[2*j];\n        lt1[j] = lt0[2*j+1] | (eq0[2*j+1] & lt0[2*j]);\n      end\n      for (integer j=0; j<8; j=j+1) begin\n        eq2[j] = eq1[2*j+1] & eq1[2*j];\n        lt2[j] = lt1[2*j+1] | (eq1[2*j+1] & lt1[2*j]);\n      end\n      for (integer j=0; j<4; j=j+1) begin\n        eq3[j] = eq2[2*j+1] & eq2[2*j];\n        lt3[j] = lt2[2*j+1] | (eq2[2*j+1] & lt2[2*j]);\n      end\n      for (integer j=0; j<2; j=j+1) begin\n        eq4[j] = eq3[2*j+1] & eq3[2*j];\n        lt4[j] = lt3[2*j+1] | (eq3[2*j+1] & lt3[2*j]);\n      end\n      unsigned_ge34 = \"'!(lt4[1] | (eq4[1] & lt4[0]));\n    end\n  endfunction\n\n'\"'''\na=s.index('  // Each digit subtracts')\ns=s[:a]+f+s[a:]\nfor k in range(1,4):s=s.replace(f'\"'!diff{k}[34]'\"',f'unsigned_ge34(t,d{k})')\n(p/'rtl/divider.sv').write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
