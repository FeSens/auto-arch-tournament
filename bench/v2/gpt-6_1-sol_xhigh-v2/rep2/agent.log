{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench')\norig=(base/'rtl/divider.sv').read_text()\ndef balanced(v,op):\n if len(v)==1:return v[0]\n h=len(v)//2\n return '('+balanced(v[:h],op)+' '+op+' '+balanced(v[h:],op)+')'\nfor block in (4,7,8):\n p=base/f'generated/r12_borrow{block}'\n shutil.copytree(base/'rtl',p/'rtl',dirs_exist_ok=True)\n shutil.copytree(base/'test',p/'test',dirs_exist_ok=True)\n s=orig\n num=(35+block-1)//block\n f=['  function automatic [34:0] lookahead_subtract(', '    input logic [34:0] x, y', '  );',f'    logic [{num-1}:0] generate_b, propagate_b;',f'    logic [{num}:0] borrow;']\n for j in range(num):\n  w=min(block,35-j*block)\n  f += [f'    logic [{w}:0] raw{j};',f'    logic [{w-1}:0] one{j};']\n f += ['    begin',\\\"      borrow[0] = 1'b0;\\\"]\n for j in range(num):\n  w=min(block,35-j*block)\n  sl=f'{j*block} +: {w}'\n  f += [f\\\"      raw{j} = {{1'b0,x[{sl}]}} - {{1'b0,y[{sl}]}};\\\",f'      generate_b[{j}] = raw{j}[{w}];',f'      propagate_b[{j}] = (x[{sl}] == y[{sl}]);',f\\\"      one{j} = raw{j}[{w-1}:0] - {w}'d1;\\\"]\n for j in range(1,num+1):\n  terms=[]\n  for k in range(j-1,-1,-1):\n   terms.append(balanced([f'propagate_b[{i}]' for i in range(j-1,k,-1)]+[f'generate_b[{k}]'],'&'))\n  f += [f'      borrow[{j}] = '+balanced(terms,'|')+';']\n for j in range(num):\n  w=min(block,35-j*block)\n  f += [f'      lookahead_subtract[{j*block} +: {w}] = borrow[{j}] ? one{j} : raw{j}[{w-1}:0];']\n f += ['    end','  endfunction','\\\\n']\n insert=s.index('  // Each digit subtracts')\n s=s[:insert]+'\\\\n'.join(f)+s[insert:]\n for k in range(1,4):\n  s=s.replace(f\\\"{{1'b0, t}} - {{1'b0, d{k}}}\\\",f\\\"lookahead_subtract({{1'b0, t}}, {{1'b0, d{k}}})\\\")\n (p/'rtl/divider.sv').write_text(s)\n print('Written borrow-lookahead block',block)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
