{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/core.yaml; sed -n '1,260p' cores/bench/test/test_alu.py\"", "aggregated_output": "name: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 54.927\n  lut4: 3875\n  ff: 1019\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20260930-002-r4s1\n  updated: '2026-09-30T15:48:00.231005Z'\n\"\"\"Unit tests for rtl/alu.sv.\n\nInteger operations remain combinational. MUL uses capture/product/transfer;\nDIV/REM keep capture, seven iterations, and registered response transfer.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nMUL_OPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nALTOPS_MASKS = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n_pending_states = None\n\n\ndef _radix4_digit(r, bits, d, width):\n    \"\"\"Fixed-width subtract/borrow model, separate from the RV32M oracle.\"\"\"\n    t = (r << 2) | bits\n    assert t < (1 << width)\n    for digit in (3, 2, 1):\n        difference = (t - digit * d) & ((1 << (width + 1)) - 1)\n        if not (difference >> width):\n            return difference, digit\n    return t, 0\n\n\ndef _recurrence_states(a, d, digits=None):\n    \"\"\"Check the 6/7-bit seed and 34/35-bit recurrence at every digit.\"\"\"\n    nibble = a >> 28\n    r, seed_q = 0, 0\n    if d >= 16:\n        r = nibble\n    else:\n        for shift in (2, 0):\n            r, digit = _\n…[6153 of 9225 chars elided by tools/bench/transcript.py; sha256:a0b567fac66ed907]…\n   dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value) == 1\n    await _tick(dut)\n    dut.div_req_valid.value = 0\n    assert int(dut.div_req_ready.value) == 0\n    assert int(dut.div_rsp_valid.value) == 0\n    _check_state(dut, _pending_states[0])\n    if os.environ.get(\"ALU_ALTOPS\") != \"1\":\n        assert int(dut.u_divider.divisor_q.value) == mag_b\n        assert int(dut.u_divider.divisor_twice_q.value) == 2 * mag_b\n        assert int(dut.u_divider.divisor_thrice_q.value) == 3 * mag_b\n\n\nasync def _wait_div(dut):\n    for iteration in range(1, 8):\n        await _tick(dut)\n        assert int(dut.div_rsp_valid.value) == (iteration == 7), iteration\n        assert int(dut.div_req_ready.value) == 0\n        _check_state(dut, _pending_states[iteration])\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
