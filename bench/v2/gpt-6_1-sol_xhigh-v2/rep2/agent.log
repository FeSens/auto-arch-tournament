      dut.fwd_rs2_sel.value = 0\n        dut.fwd_ex_mem.value = 0\n        dut.fwd_mem_wb.value = 0\n        await _tick(dut)\n        dut.reset.value = 0\n        pc = 0x80000010\n        insn = (1 << 25) | (2 << 20) | (1 << 15) | ((op - ALU_DIV + 4) << 12) | (3 << 7) | 0x33\n        ctrl = (op << 17) | (2 << 4) | (1 << 3) | (1 << 2)\n        payload = _\n…[5914 of 8986 chars elided by tools/bench/transcript.py; sha256:a6008b30ad42f030]…\n\n        dut.stall.value = 0\n        await Timer(1, \"ns\")\n        assert int(dut.mul_accept.value) == 1 and int(dut.mul_hold.value) == 0\n        assert int(dut.train_valid.value) == 1 and int(dut.train_install.value) == 0\n        assert int(dut.redirect.value) == 1\n        assert int(dut.redirect_target.value) == pc + 4\n        await _tick(dut)  # edge three: one response transfer\n        assert _unpack(EX_FIELDS, int(dut.out.value)) == {**fields, \"result\": result}\n        assert int(dut.mul_rsp_valid.value) == int(dut.mul_pending_q.value) == 0\n        getattr(dut, \"in\").value = payload & ~1\n        await Timer(1, \"ns\")\n        assert not int(dut.mul_req_valid.value)\n        assert not int(dut.train_valid.value) and not int(dut.redirect.value)\n        await _tick(dut)\n        assert int(dut.out.value) == 0\n        # A valid but illegal retained MUL opcode must not launch either.\n        getattr(dut, \"in\").value = payload | (1 << 33)\n        await Timer(1, \"ns\")\n        assert not int(dut.mul_req_valid.value)\n", "exit_code": 0, "status": "completed"}}
