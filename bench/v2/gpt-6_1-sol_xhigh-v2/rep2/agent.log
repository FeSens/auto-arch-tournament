{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypgen13')\nrtl=root/'prefix2_rtl'\nrtl.mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\nhelper='''  function automatic [34:0] prefix_subtract(\n    input logic [33:0] x,\n    input logic [33:0] y\n  );\n    logic [33:0] neq_bits;\n    logic [16:0] g0,p0,g1,p1,g2,p2,g3,p3,g4,p4,g5,p5;\n    logic [16:0] incoming;\n    logic [33:0] difference;\n    begin\n      neq_bits = x \"'^ y;\n      for (integer j=0; j<17; j=j+1) begin\n        g0[j] = (!x[2*j+1] & y[2*j+1]) |\n                (!neq_bits[2*j+1] & !x[2*j] & y[2*j]);\n        p0[j] = !neq_bits[2*j+1] & !neq_bits[2*j];\n      end\n      for (integer j=0; j<17; j=j+1) begin\n        if (j>=1) begin\n          g1[j]=g0[j] | (p0[j] & g0[j-1]);\n          p1[j]=p0[j] & p0[j-1];\n        end else begin g1[j]=g0[j]; p1[j]=p0[j]; end\n      end\n      for (integer j=0; j<17; j=j+1) begin\n        if (j>=2) begin\n          g2[j]=g1[j] | (p1[j] & g1[j-2]);\n          p2[j]=p1[j] & p1[j-2];\n        end else begin g2[j]=g1[j]; p2[j]=p1[j]; end\n      end\n      for (integer j=0; j<17; j=j+1) begin\n        if (j>=4) begin\n          g3[j]=g2[j] | (p2[j] & g2[j-4]);\n          p3[j]=p2[j] & p2[j-4];\n        end else begin g3[j]=g2[j]; p3[j]=p2[j]; end\n      end\n      for (integer j=0; j<17; j=j+1) begin\n        if (j>=8) begin\n          g4[j]=g3[j] | (p3[j] & g3[j-8]);\n          p4[j]=p3[j] & p3[j-8];\n        end else begin g4[j]=g3[j]; p4[j]=p3[j]; end\n      end\n      for (integer j=0; j<17; j=j+1) begin\n        if (j>=16) begin\n          g5[j]=g4[j] | (p4[j] & g4[j-16]);\n          p5[j]=p4[j] & p4[j-16];\n        end else begin g5[j]=g4[j]; p5[j]=p4[j]; end\n      end\n      incoming={g5[15:0],1'\"'b0};\n      for (integer j=0; j<17; j=j+1) begin\n        difference[2*j]=neq_bits[2*j] \"'^ incoming[j];\n        difference[2*j+1]=neq_bits[2*j+1] ''^\n           ((!x[2*j] & y[2*j]) | (!neq_bits[2*j] & incoming[j]));\n      end\n      prefix_subtract={g5[16],difference};\n    end\n  endfunction\n'\"'''\np=rtl/'divider.sv'; s=p.read_text()\ns=s.replace('  // Each digit subtracts all three registered multiples concurrently.',helper+'\\\\n  // Each digit subtracts all three registered multiples concurrently.')\nfor k in (1,2,3): s=s.replace(f\\\"diff{k} = {{1'b0, t}} - {{1'b0, d{k}}};\\\",f'diff{k} = prefix_subtract(t,d{k});')\np.write_text(s)\n(root/'prefix_miter.sv').write_text('module subtract_miter(input [33:0] x,y, output good);\\\\n'+helper+\\\"assign good = prefix_subtract(x,y) == ({1'b0,x}-{1'b0,y});\\\\nendmodule\\\\n\\\")\nprint('Created two-bit prefix subtractor prototype')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
