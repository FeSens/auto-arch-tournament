{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r5s1_rf_probe')\n(root/'rtl').mkdir(parents=True,exist_ok=True)\n(root/'test').mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,root/'rtl'/p.name)\nfor p in Path('cores/bench/test').glob('*.py'): shutil.copy2(p,root/'test'/p.name)\np=root/'rtl/reg_file.sv'\ns=p.read_text()\ns=s[:s.index('  logic [31:0] regs [0:31];')]+'''  logic [31:0] word_q [1:31];\n  logic [31:1] read_one_rs1, read_one_rs2, write_one;\n  logic [31:0] read_rs1, read_rs2;\n\n  for (genvar r = 1; r < 32; r++) begin : g_word\n    assign read_one_rs1[r] = (rs1_addr == r);\n    assign read_one_rs2[r] = (rs2_addr == r);\n    assign write_one[r] = w_en && (w_addr == r);\n    always_ff @(posedge clock) begin\n      if (reset) word_q[r] <= 32'b0;\n      else if (write_one[r]) word_q[r] <= w_data;\n    end\n  end\n\n  always_comb begin\n    read_rs1 = '0;\n    read_rs2 = '0;\n    for (int r = 1; r < 32; r++) begin\n      read_rs1 = read_rs1 | (word_q[r] & {32{read_one_rs1[r]}});\n      read_rs2 = read_rs2 | (word_q[r] & {32{read_one_rs2[r]}});\n    end\n    if (rs1_addr == 0) rs1_data = '0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = read_rs1;\n    if (rs2_addr == 0) rs2_data = '0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = read_rs2;\n  end\nendmodule\n'''\np.write_text(s)\nprint('Isolated register-file prototype prepared')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
