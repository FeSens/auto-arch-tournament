nch),\n    .is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_to_reg (dec_mem_to_reg),\n    .is_illegal (dec_is_illegal)\n  );\n\n  logic [31:0] imm;\n  imm_gen u_imm (.instr(in.instr), .imm(imm));\n\n  // Regfile read addresses\n…[15948 of 19020 chars elided by tools/bench/transcript.py; sha256:349e41318ef36b9e]…\nm/main.cpp:74:    bool istall = false;\ntest/cosim/main.cpp:75:    bool dstall = false;\ntest/cosim/main.cpp:78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\ntest/cosim/main.cpp:79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\ntest/cosim/main.cpp:118:        // slowed down by unrelated stalls.\ntest/cosim/main.cpp:119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\ntest/cosim/main.cpp:120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\ntest/cosim/main.cpp:121:        // Bounds checks: silent wraparound used to mask CPU effective-address bugs\ntest/cosim/main.cpp:151:            // (a non-gated ww() would wrap 0x10000000 to dmem[0] and corrupt it).\ntest/cosim/run_cosim.py:15:    # out-of-bounds memory address that used to silently wrap.\ntest/cosim/run_cosim.py:103:    # Extra args after the ELF are passed to the simulator (e.g. --istall\ntest/cosim/run_cosim.py:104:    # --dstall to run the trace comparison under bus backpressure).\n", "exit_code": 0, "status": "completed"}}
