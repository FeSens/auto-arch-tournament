rror TARGET= required. Available cores: $(notdir $(wildcard cores/*)))\nMakefile:61:ifneq ($(strip $(TARGET)),)\nMakefile:62:  RTL_DIR    := cores/$(TARGET)/rtl\nMakefile:63:  TEST_DIR   := cores/$(TARGET)/test\nMakefile:64:  CORE_NAME  := $(TARGET)\nMakefile:65:  OBJ_DIR    := cores/$(TARGET)/obj_dir\nMakefile:66:  GEN_DIR    := cores/$(TARGET)/generated\nMakefile:67:  ORCH_TARGET_FLAG := --target $(TARGET)\nMakefile:69:  WT_BRANCH  := core-$(TARGET)\nMakefile:70:  WT_PATH    := $(CURDIR)/.worktrees/$(TARGET)\nMakefile:76:\t@echo \"Targets (most accept TARGET=<core_name>):\"\nMakefile:77:\t@echo \"  make lint TARGET=v1     — verilator lint over cores/<TARGET>/rtl/*.sv\"\nMakefile:78:\t@echo \"  make test TARGET=v1     — cocotb unit tests under cores/<TARGET>/test/\"\nMakefile:79:\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\nMakefile:80:\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\nMakefile:81:\t@echo \"  make formal-deep TARGET=v1 — full formal suite without ALTOPS (slow, bitvector-correct)\"\nMakefile:82:\t@echo \"  make fpga TARGET=v1     — FPGA fitness eval (Gowin Fmax + CoreMark cycles)\"\nMakefile:83:\t@echo \"  make timing TARGET=v1   — Gowin Fmax and worst paths (placement option 0)\"\nMakefile:85:\t@echo \"  make next TARGET=v1     — one orchestrator round\"\nMakefile:86:\t@echo \"  make loop TARGET=v1 N=10 — N orchestrator rounds (auto-spawns .worktrees/<TARGET> on branch core-<TARGET>; pass WORKTREE= to opt out)\"\nMakefile:87:\t@echo \"  make report TARGET=v1   — per-core experiment summary\"\nMakefile:88:\t@echo \"  make clean TARGET=v1    — remove per-core build artifacts (use with TARGET=)\"\nMakefile:113:\tpython3 -m tools.eval.cosim . $(TARGET)\nMakefile:137:fpga: cosim-build bench/programs/coremark.elf\nMakefile:138:\tpython3 -m tools.eval.fpga . $(TARGET)\nMakefile:140:timing:\nMakefile:141:\tpython3 -m tools.eval.gowin $(TARGET)\nMakefile:151:\tAGENT_PROVIDER=$(AGENT) python3 -m tools.orch