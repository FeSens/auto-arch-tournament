nibble, including D=0.\n    assert (r, seed_q) == ((nibble % d, nibble // d) if d else (nibble, 15))\n    q = ((a << 4) | seed_q) & MASK32\n    states = [(r, q)]\n    for _ in range(7):\n        for _ in range(2):\n            r, digit = _radix4_digit(r, q >> 30, d, 34)\n            q = ((q << 2) | digit) & MA\n…[2755 of 5827 chars elided by tools/bench/transcript.py; sha256:9fb85b3f000ced9e]…\nue  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    expected = _expected(op, a, b, expected)\n    assert actual == expected, (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\ndef _multiplication_model(op, a, b):\n    \"\"\"Independent signed integer products, rather than high-half corrections.\"\"\"\n    a, b = a & MASK32, b & MASK32\n    sa = a - (1 << 32) if a >> 31 else a\n    sb = b - (1 << 32) if b >> 31 else b\n    if op == ALU_MUL:\n        return (a * b) & MASK32\n    product = sa * sb if op == ALU_MULH else sa * b if op == ALU_MULHSU else a * b\n    return (product >> 32) & MASK32\n\n\nasync def _launch_mul(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.mul_req_valid.value = 1\n    await Timer(1, \"ns\")\n    assert int(dut.mul_req_ready.value) == 1\n    await _tick(dut)\n    dut.mul_req_valid.value = 0\n    assert int(dut.mul_req_ready.value) == 0\n", "exit_code": 0, "status": "completed"}}
