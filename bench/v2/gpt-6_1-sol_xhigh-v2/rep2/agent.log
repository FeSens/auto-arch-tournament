{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/r6_seed_probe/table/test');p.mkdir(exist_ok=True)\nfor f in Path('cores/bench/test').glob('*.py'):shutil.copyfile(f,p/f.name)\nf=p/'test_alu.py'\nf.write_text(f.read_text()+'''\n\n@cocotb.test()\nasync def seed_boundary_vectors(dut):\n    await _setup(dut)\n    divisors = list(range(17)) + list(range(-16, 0)) + [0x7fffffff, 0x80000000, 0x80000001, 0xffffffff]\n    for n in range(16):\n        for low in (0, 1, 0x0fffffff):\n            a = (n << 28) | low\n            for b in divisors:\n                for op in DIV_OPS:\n                    await _check_div(dut, op, a, b, _division_model(op, a, b))\n''')\nPY\npytest -q cores/bench/generated/r6_seed_probe/table/test/test_alu.py cores/bench/generated/r6_seed_probe/table/test/test_ex_stage.py cores/bench/generated/r6_seed_probe/table/test/test_pipeline.py > cores/bench/generated/r6_seed_probe/table/verification.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
