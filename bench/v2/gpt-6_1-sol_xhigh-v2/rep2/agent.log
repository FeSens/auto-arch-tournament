{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor w in (17,8):\n    root=Path(f'/srv/hwebench/tmp/5ff8876e/d474d8ce/divider_carryselect{w}_probe')\n    root.mkdir(exist_ok=True)\n    shutil.copytree(Path('cores/bench/rtl'),root/'rtl',dirs_exist_ok=True)\n    widths=[17,17] if w==17 else [8,8,8,10]\n    parts=['  function automatic [34:0] subtract34(input logic [33:0] x, input logic [33:0] y);']\n    for j,n in enumerate(widths):\n        parts.append(f'    logic [{n}:0] z{j}, o{j};')\n    parts.extend([f'    logic [{len(widths)}:0] borrow;','    logic [33:0] value;','    begin',\\\"      borrow[0] = 1'b0;\\\"])\n    pos=0\n    for j,n in enumerate(widths):\n        parts.append(f\\\"      z{j} = {{1'b0,x[{pos} +: {n}]}} - {{1'b0,y[{pos} +: {n}]}};\\\")\n        parts.append(f\\\"      o{j} = {{1'b0,x[{pos} +: {n}]}} + {{1'b0,~y[{pos} +: {n}]}};\\\")\n        parts.append(f'      value[{pos} +: {n}] = borrow[{j}] ? o{j}[{n-1}:0] : z{j}[{n-1}:0];')\n        parts.append(f'      borrow[{j+1}] = borrow[{j}] ? ~o{j}[{n}] : z{j}[{n}];')\n        pos+=n\n    parts.extend([f'      subtract34 = {{borrow[{len(widths)}],value}};','    end','  endfunction',''])\n    helper='\\\\n'.join(parts)\n    p=root/'rtl/divider.sv'\n    s=p.read_text()\n    needle='  function automatic [63:0] radix4_step('\n    s=s.replace(needle,helper+'\\\\n'+needle)\n    for i in range(1,4): s=s.replace(f\\\"diff{i} = {{1'b0, t}} - {{1'b0, d{i}}};\\\", f'diff{i} = subtract34(t,d{i});')\n    p.write_text(s)\n    (root/'subtract_miter.sv').write_text('module subtract_miter(input [33:0] x,y, output mismatch);\\\\n'+helper+\\\"\\\\nassign mismatch = subtract34(x,y) \"'!= ({1'\"'b0,x}-{1'b0,y});\\\\nendmodule\\\\n\\\")\n    print('Prepared',root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
