{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, subprocess\nfrom pathlib import Path\nscratch = Path(os.environ['TMPDIR']) / 'balanced_compare_sat'\nscratch.mkdir(exist_ok=True)\nrtl = Path('cores/bench/rtl').resolve()\nmiter = scratch / 'comparison_miter.sv'\nmiter.write_text('''\nmodule comparison_miter (\n  input logic [31:0] a, b,\n  input logic [2:0] branch_op,\n  input logic use_signed,\n  output logic mismatch\n);\n  logic [31:0] alu_out;\n  logic branch_taken, native_branch;\n  logic [31:0] native_alu;\n  id_ex_t payload;\n  always_comb begin\n    payload = '0;\n    payload.rs1_val = a;\n    payload.rs2_val = b;\n    payload.ctrl.is_branch = 1'b1;\n    payload.ctrl.branch_op = branch_op;\n    payload.valid = 1'b1;\n    case (branch_op)\n      3'd0: native_branch = (a == b);\n      3'd1: native_branch = (a \"'!= b);\n      3'\"'d4: native_branch = (\"'$signed(a) < $signed(b));\n      3'\"'d5: native_branch = (\"'$signed(a) >= $signed(b));\n      3'\"'d6: native_branch = (a < b);\n      3'd7: native_branch = (a >= b);\n      default: native_branch = 1'b0;\n    endcase\n    native_alu = use_signed ? {31'b0, \"'$signed(a) < $signed(b)}\n                            : {31'\"'b0, a < b};\n  end\n  alu alu_dut (\n    .clock(1'b0), .reset(1'b0),\n    .div_req_valid(1'b0), .div_rsp_ready(1'b0),\n    .mul_req_valid(1'b0), .mul_rsp_ready(1'b0),\n    .op(use_signed ? ALU_SLT : ALU_SLTU), .a(a), .b(b), .out(alu_out)\n  );\n  ex_stage branch_dut (\n    .clock(1'b0), .reset(1'b0), .stall(1'b0), .in(payload),\n    .fwd_rs1_sel(2'b0), .fwd_rs2_sel(2'b0),\n    .fwd_ex_mem(32'b0), .fwd_mem_wb(32'b0), .train_taken(branch_taken)\n  );\n  assign mismatch = (alu_out \"'!= native_alu) | (branch_taken != native_branch);\nendmodule\n'\"''')\nsources = [rtl / name for name in ('core_pkg.sv', 'divider.sv', 'multiplier.sv', 'alu.sv', 'ex_stage.sv')]\nscript = 'read_verilog -sv -D RISCV_FORMAL_ALTOPS -I' + str(rtl) + ' ' + ' '.join(map(str, [*sources, miter])) + '; prep -top comparison_miter -flatten; opt -full; sat -verify -prove mismatch 0 -show-inputs'\nresult = subprocess.run(['yosys', '-p', script], text=True, capture_output=True)\n(scratch / 'yosys.log').write_text(result.stdout + result.stderr)\nprint((result.stdout + result.stderr)[-3500:])\nraise SystemExit(result.returncode)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
