{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/5ff8876e/d9943d9b/predictor-prototype')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv'\ns=p.read_text()\na='''  // ID/EX register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] predicted_next_pc;\n'''\nb=a+'''    logic [31:0] predicted_sequential_target;\n    logic [31:0] predicted_direct_target;\n    logic prediction_sequential_match;\n    logic prediction_direct_match;\n'''\nassert s.count(a)==1\np.write_text(s.replace(a,b))\np=rtl/'id_stage.sv'\ns=p.read_text()\na='      reg_q.predicted_next_pc <= in.predicted_next_pc;'\nb=a+'''\n      reg_q.predicted_sequential_target <= in.pc + 32'd4;\n      reg_q.predicted_direct_target <= in.pc + imm;\n      reg_q.prediction_sequential_match <= (in.predicted_next_pc == in.pc + 32'd4);\n      reg_q.prediction_direct_match <= (in.predicted_next_pc == in.pc + imm);'''\nassert s.count(a)==1\np.write_text(s.replace(a,b))\np=rtl/'ex_stage.sv'\ns=p.read_text()\nfor a,b in [\n ('branch_target = in.pc + in.imm;','branch_target = in.predicted_direct_target;'),\n (\\\"assign sequential_pc = in.pc + 32'd4;\\\",'assign sequential_pc = in.predicted_sequential_target;'),\n ('assign sequential_match = (in.predicted_next_pc == sequential_pc);','assign sequential_match = in.prediction_sequential_match;'),\n ('assign direct_match = (in.predicted_next_pc == branch_target);','assign direct_match = in.prediction_direct_match;')]:\n assert s.count(a)==1,a\n s=s.replace(a,b)\np.write_text(s)\nprint('Prepared isolated early-verification prototype:',root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
