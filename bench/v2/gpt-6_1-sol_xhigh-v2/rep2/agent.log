se []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[20095 of 23167 chars elided by tools/bench/transcript.py; sha256:f32bb69ab67cf7e7]…\niterations(worktree)\n    valid, reason = validate_coremark_uart(uart, iterations)\n    if not valid:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': reason}\n\n    # Bracketed cycles (start_time..stop_time) are the contract per\n    # bench/programs/coremark/baremetal/core_portme.c's start/stop_time.\n    # If both markers aren't present, the run is INVALID for fitness\n    # scoring — DO NOT fall back to total elapsed: a CPU/MMIO bug that\n    # drops 0x10000100/0x10000104 writes would silently get scored on\ntest/cosim/reference.py\ntest/cosim/main.cpp\ntest/cosim/build.sh\ntest/cosim/run_cosim.py\ntest/conftest.py\ntest/_helpers.py\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_ex_stage.py\ncores/bench/test/test_if_stage.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_forward_unit.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\n", "exit_code": 0, "status": "completed"}}
