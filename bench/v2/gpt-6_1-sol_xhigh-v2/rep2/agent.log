ibble, including D=0.\n    assert (r, seed_q) == ((nibble % d, nibble // d) if d else (nibble, 15))\n    q = ((a << 4) | seed_q) & MASK32\n    states = [(r, q)]\n    for _ in range(7):\n        for _ in range(2):\n            r, digit = _radix4_digit(r, q >> 30, d, 34)\n            q = ((q << 2) | digit) & MA\n…[7477 of 10549 chars elided by tools/bench/transcript.py; sha256:8bc78403f7ab83bd]…\n op in (ALU_DIV, ALU_REM)\n    mag_a = ((-a) & MASK32) if signed and a >> 31 else a\n    mag_b = ((-b) & MASK32) if signed and b >> 31 else b\n    _pending_states = _recurrence_states(mag_a, mag_b)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value) == 1\n    if os.environ.get(\"ALU_ALTOPS\") != \"1\":\n        nibble = mag_a >> 28\n        seed_q, seed_r = divmod(nibble, mag_b) if mag_b else (15, nibble)\n        assert int(dut.u_divider.seed.value) == (seed_r << 4) | seed_q\n    await _tick(dut)\n    dut.div_req_valid.value = 0\n    assert int(dut.div_req_ready.value) == 0\n    assert int(dut.div_rsp_valid.value) == 0\n    _check_state(dut, _pending_states[0])\n    if os.environ.get(\"ALU_ALTOPS\") != \"1\":\n        assert int(dut.u_divider.divisor_q.value) == mag_b\n        assert int(dut.u_divider.divisor_twice_q.value) == 2 * mag_b\n        assert int(dut.u_divider.divisor_thrice_q.value) == 3 * mag_b\n\n\n", "exit_code": 0, "status": "completed"}}
