n            pop = bool(self.entries and not self.hold)\n            self.accept = bool(self.ready and (self.count < 2 or pop))\n            push = self.accept and bool(self.entries or self.hold)\n            assert int(dut.u_if.queue_pop.value) == pop\n            assert int(dut.u_if.fetch_accept.value) == self.accept\n            assert int(dut.u_if.queue_push.value) == push\n            if self.redirect:\n                self.corrections.add(self.count)\n                self.entries.clear()\n            else:\n                if self.count == 0 and self.accept and not push:\n                    self.events.add(\"fall-through\")\n                if self.hold and push:\n                    self.events.add(\"held-fill\")\n                if self.count == 2 and self.hold and self.ready:\n                    self.events.add(\"full-backpressure\")\n                if self.count == 2 and push and pop:\n                    self.events.add(\"full-replacement\")\n                if pop and not self.ready:\n                    self.events.add(\"stalled-head\")\n                if pop:\n                    self.entries.pop(0)\n                if push:\n                    self.entries.append((self.pc, self.raw, self.prediction))\n        else:\n            assert int(dut.u_if.count_q.value) == len(self.entries)\n            expected_pc = (self.target if self.redirect else\n                           self.prediction if self.accept else self.pc)\n            assert int(dut.io_imemAddr.value) == expected_pc\n            if self.redirect:\n                assert int(dut.u_if.read_q.value) == int(dut.u_if.write_q.value) == 0\n            if not self.hold:\n                pc, prediction, insn, valid, _ = _id_snapshot(dut)\n                assert (pc, insn, prediction) == self.head\n                assert valid == (self.available and not self.flush)\n\n\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/hazard_unit.sv\n","exit_code":0,"status":"completed"}}
