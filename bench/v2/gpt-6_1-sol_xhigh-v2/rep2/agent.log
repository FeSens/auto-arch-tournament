{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('/srv/hwebench/tmp/5ff8876e/dbfedbe2/r9s0_probe')\nshutil.copytree('cores/bench/test',probe/'test',dirs_exist_ok=True)\np=probe/'test/test_ex_stage.py'\ns=p.read_text()+'''\\\\n\\\\n@cocotb.test()\nasync def jalr_candidate_selection_independent_model(dut):\n    import random\n    rng = random.Random(9000)\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \\\"in\\\").value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    edges = [0, 1, 2, 3, 0x7fffffff, 0x80000000, 0xffffffff,\n             0xfffffffc, 0xffff, 0x10000, 0x7ffffffe]\n    for trial in range(1200):\n        candidates = [rng.getrandbits(32) for _ in range(3)]\n        if trial < 44:\n            candidates[trial % 3] = edges[trial // 4]\n        select = trial % 4\n        idx = select if select < 3 else 0\n        immediate = rng.getrandbits(32) if trial > 44 else edges[trial // 4]\n        operand = candidates[idx]\n        actual_target = ((operand + immediate) & MASK) & ~1\n        pc = 0x80000010\n        misaligned = bool(actual_target & 2)\n        actual_next = ((pc + 4) & MASK) if misaligned else actual_target\n        prediction = actual_target if trial % 3 == 0 else actual_target \"'^ (1 << (trial % 32))\n        ctrl = (1 << 16) | (1 << 11) | (1 << 10) | (2 << 4) | (1 << 3) | (1 << 2)\n        getattr(dut, \"in\").value = _pack(ID_FIELDS, {\"pc\": pc, \"prediction\": prediction,\n            \"rs1\": candidates[0], \"rs2\": 0, \"imm\": immediate, \"rd\": 3,\n            \"rs1_addr\": 1, \"ctrl\": ctrl, \"insn\": 0x000081e7, \"valid\": 1})\n        dut.fwd_rs1_sel.value = select\n        dut.fwd_ex_mem.value = candidates[1]\n        dut.fwd_mem_wb.value = candidates[2]\n        await Timer(1, \"ns\")\n        assert int(dut.jump_target.value) == actual_target\n        assert int(dut.jalr_match.value) == int(prediction == actual_target)\n        assert int(dut.misalign_jump.value) == int(misaligned)\n        assert int(dut.redirect_target.value) == actual_next\n        assert int(dut.redirect.value) == int(prediction != actual_next)\n        assert int(dut.train_target.value) == actual_target\n        assert int(dut.train_install.value) == int(not misaligned)\n        await _tick(dut)\n        fields = _unpack(EX_FIELDS, int(dut.out.value))\n        assert fields[\"rs1\"] == operand\n        assert fields[\"pc_next\"] == actual_next\n        assert fields[\"result\"] == ((pc + 4) & MASK)\n        assert bool(fields[\"ctrl\"] & 1) == misaligned\n        assert bool(fields[\"ctrl\"] & 4) == (not misaligned)\n'\"'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
