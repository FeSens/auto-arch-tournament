eturn (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef MUL (rd, rs1, rs2)\n…[74624 of 77696 chars elided by tools/bench/transcript.py; sha256:288c045b0f72a757]…\n          rets, mem = await _run(dut, program, stalls=stalls, monitor=observe,\n                                   services=services, max_cycles=200)\n            assert mem == _check_operand_architecture(rets, program, {}, services)\n            assert arithmetic.launches == arithmetic.acceptances == 3\n            assert {\"arithmetic-drain\", \"response\", \"queued-capture\", \"redirect\", \"both-ex\"} <= monitor.events\n            if operation == DIV and not stalled:\n                by_pc = {r[\"pc\"]: r for r in rets}\n                assert 0 < by_pc[32][\"cycle\"] - by_pc[28][\"cycle\"] <= 10\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
