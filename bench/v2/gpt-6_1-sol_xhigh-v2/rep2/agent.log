{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/divider.sv; rg -n 'ALTOPS|pytest|COCOTB|runner|seed|formal|cosim|GOWIN' cores/bench/test tools/eval/gowin.py tools/eval/fpga.py test Makefile\"", "aggregated_output": "// Shared blocking RV32M divider: a small four-bit launch seed, seven\n// registered four-bit radix-4 iterations, then response transfer to EX/MEM.\n// The final magnitude and sign are registered before sign correction.\n// Zero divisors and signed overflow follow the same transaction timing.\nmodule divider (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        req_valid,\n  output logic        req_ready,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        rsp_valid,\n  input  logic        rsp_ready,\n  output logic [31:0] result\n);\n  logic busy_q;\n  logic [2:0] iteration_q;\n  logic [31:0] response_magnitude_q;\n  logic response_negative_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] altops_request_q;\n`else\n  logic [31:0] quotient_q, remainder_q;\n  logic [33:0] divisor_q, divisor_twice_q, divisor_thrice_q;\n  logic quotient_negative_q, remainder_negative_q, select_remainder_q;\n  logic signed_op;\n  logic [31:0] dividend_magnitude, divisor_magnitude;\n  logic [33:0] divisor_once, divisor_twice;\n  logic [7:0] seed;\n  logic [63:0] first_step, second_step;\n\n  // Only six-bit trial remainders and seven-bit unsigned differences\n  // belong on the launch seed path. For D >= 16 the entire nibble is\n  // already below D, so both seed digits are zero.\n  function automatic [7:0] small_seed(\n    input logic [3:0] dividend,\n    input logic [3:0] divisor\n  );\n    logic [3:0] r, q;\n    logic [5:0] t, d1, d2, d3;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [6:0] diff1, diff2, diff3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic [1:0] digit;\n    begin\n      r = '0;\n      q = dividend;\n      d1 = {2'b0, divisor};\n      d2 = {1'b0, divisor, 1'b0};\n      d3 = d1 + d2;\n      for (int step = 0; step < 2; step++) begin\n        t = {r, q[3:2]};\n        diff1 = {1'b0, t} - {1'b0, d1};\n        diff2 = {1'b0, t} - {1'b0, d2};\n        diff3 = {1'b0, t} - {1'b0, d3};\n        if (!diff3[6]) begin\n          digit = 2'd3;\n          r = diff3[3:0];\n        end else if (!d\n…[13463 of 16535 chars elided by tools/bench/transcript.py; sha256:aaa60cedeb644eb4]…\n668:def test_alu_altops_runner():\ncores/bench/test/test_alu.py:669:    \"\"\"Run the same edge/capture/latency checks with documented ALTOPS.\"\"\"\ncores/bench/test/test_alu.py:670:    from cocotb_tools.runner import get_runner\ncores/bench/test/test_alu.py:672:    runner = get_runner(\"verilator\")\ncores/bench/test/test_alu.py:674:    runner.build(\ncores/bench/test/test_alu.py:677:        build_args=[\"-Wall\", \"-Wno-fatal\", \"+define+RISCV_FORMAL_ALTOPS\"],\ncores/bench/test/test_alu.py:679:    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=TEST_DIR,\ncores/bench/test/test_alu.py:680:                build_dir=build_dir, extra_env={\"ALU_ALTOPS\": \"1\"})\ncores/bench/test/test_pipeline.py:328:    verifier ignore it on trap=1; both are accepted by riscv-formal.\ncores/bench/test/test_pipeline.py:330:    so cosim stays in lockstep.\"\"\"\ncores/bench/test/test_pipeline.py:436:        # Regression for the formal counterexample: load-use plus division\ncores/bench/test/test_pipeline.py:1499:def test_pipeline_runner():\n", "exit_code": 0, "status": "completed"}}
