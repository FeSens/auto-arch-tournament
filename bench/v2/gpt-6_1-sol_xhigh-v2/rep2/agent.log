{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '350,720p' cores/bench/test/test_pipeline.py && rg -n 'trace|bench|marker|insn|cycles|usage' test/cosim/main.cpp | tail -60\"", "aggregated_output": "@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef _div_model(funct3, a, b):\n    a, b = a & 0xFFFFFFFF, b & 0xFFFFFFFF\n    if b == 0:\n        return a if funct3 in (6, 7) else 0xFFFFFFFF\n    if funct3 in (4, 6):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n        quotient = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            quotient = -quotient\n        result = a - quotient * b if funct3 == 6 else quotient\n    else:\n        result = a % b if funct3 == 7 else a // b\n    return result & 0xFFFFFFFF\n\n\ndef _verify_divisions(rets):\n    regs = [0] * 32\n    for r in rets:\n        insn = r[\"insn\"]\n        if insn & 0xFE00007F == 0x02000033 and (insn >> 12) & 7 >= 4:\n            rs1, rs2 = (insn >> 15) & 31, (insn >> 20) & 31\n            assert r[\"rs1_rdata\"] == regs[rs1], r\n            assert r[\"rs2_rdata\"] == regs[rs2], r\n            if (insn >> 7) & 31:\n                expected = _div_model((insn >> 12) & 7, regs[rs1], regs[rs2])\n                assert r[\"rd_wdata\"] == expected, r\n            else:\n                assert r[\"rd\"] == 0 and r[\"rd_wdata\"] == 0, r\n        if r[\"rd\"]:\n            regs[r[\"rd\"]] = r[\"rd_wdata\"]\n\n\nasync def _division_dependencies(dut, stalls=None):\n    program = [\n        ADDI(1, 0, -97), ADDI(2, 0, 7), ADD(3, 1, 0),\n        DIV(4, 3, 2), A\n…[15954 of 19026 chars elided by tools/bench/transcript.py; sha256:1c7e20fc8461a601]…\n== 0x00100073) { hit_ebreak = true; return true; }\n220:                if (insn == 0x00100073) { hit_ebreak = true; return true; }\n225:        if (emit(top->io_rvfi_valid_0, top->io_rvfi_order_0, top->io_rvfi_insn_0,\n240:        if (emit(top->io_rvfi_valid_1, top->io_rvfi_order_1, top->io_rvfi_insn_1,\n252:    if (bench_mode) {\n253:        // Emit final record, plus an explicit completion marker. Consumers MUST\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n256:        if (bench_last[0]) puts(bench_last);\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n269:               \"\\\"bench_bracketed\\\":%s,\\\"uart\\\":\\\"%s\\\"}\\n\",\n273:               (unsigned long long)bench_start_cycle,\n274:               (unsigned long long)bench_stop_cycle,\n275:               (bench_start_set && bench_stop_set) ? \"true\" : \"false\",\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n", "exit_code": 0, "status": "completed"}}
