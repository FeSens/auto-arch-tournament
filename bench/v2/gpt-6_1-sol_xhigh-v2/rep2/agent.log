{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/test/_helpers.py\"","aggregated_output":"\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'tail -n 55 cores/bench/test/test_alu.py'","aggregated_output":"    await _check(dut, ALU_SRA, 0x80000000, 4, 0xF8000000)\n    await _wait_div(dut)\n    dut.op.value = ALU_DIV\n    await Timer(1, \"ns\")\n    assert int(dut.out.value) == _expected(ALU_DIV, 97, 7, 13)\n    dut.div_rsp_ready.value = 1\n    await _tick(dut)\n    assert int(dut.div_rsp_valid.value) == 0\n    await _check(dut, ALU_MUL, 0x123, 0x456, 0x123 * 0x456)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_fixed_width_radix4_model():\n    \"\"\"Compare 66,562 signed/unsigned magnitude cases with integer division.\"\"\"\n    rng = random.Random(0x4D1A1DE)\n    edges = (0, 1, 2, 3, 4, 7, 15, 16, 17, 0x55555555, 0x55555556,\n             0x7FFFFFFF, 0x80000000, 0x80000001, 0xFFFFFFFE, MASK32)\n    pairs = [(a, b) for a in edges for b in edges]\n    pairs += [((n << 28) | rng.getrandbits(28), d)\n              for n in range(16) for d in range(16)]\n    pairs += [(0xFFFFFFFF, 0xAAAAAAAB)]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(32768)]\n    assert 2 * len(pairs) == 66562\n    digits = set()\n    for a, b in pairs:\n        for signed in (False, True):\n            sa = a - (1 << 32) if signed and a >> 31 else a\n            sb = b - (1 << 32) if signed and b >> 31 else b\n            r, q = _recurrence_states(abs(sa), abs(sb), digits)[-1]\n            quotient = -q if signed and (sa < 0) != (sb < 0) and b else q\n            remainder = -r if signed and sa < 0 else r\n            assert quotient & MASK32 == _division_model(ALU_DIV if signed else ALU_DIVU, a, b)\n            assert remainder & MASK32 == _division_model(ALU_REM if signed else ALU_REMU, a, b)\n    assert digits == {0, 1, 2, 3}\n\n\ndef test_alu_altops_runner():\n    \"\"\"Run the same edge/capture/latency checks with documented ALTOPS.\"\"\"\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, SIM_BUILD, TEST_DIR\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[RTL / s for s in (\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=build_dir, always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"+define+RISCV_FORMAL_ALTOPS\"],\n    )\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"ALU_ALTOPS\": \"1\"})\n","exit_code":0,"status":"completed"}}
