{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/branch_tree_probe');tests=root/'test';tests.mkdir(exist_ok=True)\nfor name in ('conftest.py','_helpers.py','test_pipeline.py','test_ex_stage.py','test_if_stage.py'):\n shutil.copy2(Path('cores/bench/test')/name,tests/name)\np=tests/'test_ex_stage.py'\ns=p.read_text()+'''\n\n@cocotb.test()\nasync def branch_resolution_matches_full_width_reference(dut):\n    import random\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \\\"in\\\").value = 0\n    dut.fwd_rs1_sel.value = dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    rng = random.Random(91832)\n    edges = [0, 1, 255, 256, 65535, 65536, 0x7fffffff, 0x80000000, 0xfffffffe, 0xffffffff]\n    pairs = [(a, b) for a in edges for b in edges]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(300)]\n    for a, b in pairs:\n        sa = a - (1 << 32) if a & (1 << 31) else a\n        sb = b - (1 << 32) if b & (1 << 31) else b\n        outcomes = {0: a == b, 1: a \"'!= b, 4: sa < sb, 5: sa >= sb, 6: a < b, 7: a >= b}\n        for fn, actual in outcomes.items():\n            pc = 0x80000100\n            ctrl = (fn << 13) | (1 << 12) | (2 << 4) | (1 << 3)\n            payload = _pack(ID_FIELDS, {\"pc\":pc, \"prediction\":pc + 4,\n                            \"rs1\":a, \"rs2\":b, \"imm\":16, \"ctrl\":ctrl,\n                            \"insn\":0x63 | (fn << 12), \"valid\":1})\n            getattr(dut, \"in\").value = payload\n            await Timer(1, \"ns\")\n            assert int(dut.branch_cond.value) == actual, (a, b, fn)\n            assert int(dut.train_taken.value) == actual\n            assert int(dut.redirect.value) == actual\n            assert int(dut.redirect_target.value) == pc + (16 if actual else 4)\n'\"'''\np.write_text(s)\nPY\npytest -q cores/bench/generated/branch_tree_probe/test/test_pipeline.py cores/bench/generated/branch_tree_probe/test/test_ex_stage.py cores/bench/generated/branch_tree_probe/test/test_if_stage.py > cores/bench/generated/branch_tree_probe/tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
