uild_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separatel\n…[1845 of 4917 chars elided by tools/bench/transcript.py; sha256:6edaaad634369aa6]…\n72:async def predictor_stale_ordinary_illegal_memory_and_division(dut):\n883:            predictor, division, services = _PredictorMonitor(), _DivisionMonitor(), []\n893:                division(cycle, dut, phase)\n912:            assert division.launches == division.acceptances == (replacement == DIV(6, 1, 2))\n916:                _verify_divisions(rets)\n925:        predictor, division, services = _PredictorMonitor(), _DivisionMonitor(), []\n932:            division(cycle, dut, phase)\n934:        _check_stream(rets, {4 * i: insn for i, insn in enumerate(program)}, [0, 16, 20])\n938:        assert division.launches == division.acceptances == 0\n951:    _check_stream(rets, program, pcs)\n959:async def predictor_simultaneous_lookup_training_uses_saved_prediction(dut):\n986:        _check_stream(rets, {4 * i: insn for i, insn in enumerate(warm)}, [0, 8])\n993:    _check_stream(rets, {4 * i: insn for i, insn in enumerate(program)}, list(range(0, 36, 4)))\n1000:def test_pipeline_runner():\n/srv/hwebench/tmp/5ff8876e/af613feb\n", "exit_code": 1, "status": "failed"}}
