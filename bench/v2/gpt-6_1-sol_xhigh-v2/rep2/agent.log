{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,json\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval import gowin\nroot=Path.cwd()\nbase=root/'cores/bench/generated'\nprobes={}\nfor name in ['branch_compare','shared_shifter']:\n p=base/name\n rtl=p/'rtl'\n rtl.mkdir(parents=True,exist_ok=True)\n for f in (root/'cores/bench/rtl').glob('*.sv'):\n  shutil.copy2(f,rtl/f.name)\n probes[name]=(p,rtl)\np,rtl=probes['branch_compare']\nf=rtl/'ex_stage.sv'\ns=f.read_text()\nstart=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nend=s.index('    branch_taken  =',start)\ns=s[:start]+'''  logic branch_equal, branch_less_unsigned, branch_less_signed;\n  assign branch_equal = \"'!(|(rs1 ''^ rs2));\n  assign branch_less_unsigned = rs1 < rs2;\n  assign branch_less_signed = (rs1[31] != rs2[31]) ? rs1[31] : branch_less_unsigned;\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ, BR_BNE: branch_cond = branch_equal ''^ in.ctrl.branch_op[0];\n      BR_BLT, BR_BGE: branch_cond = branch_less_signed ''^ in.ctrl.branch_op[0];\n      BR_BLTU, BR_BGEU: branch_cond = branch_less_unsigned ''^ in.ctrl.branch_op[0];\n      default: branch_cond = 1'\"'b0;\n    endcase\n'''+s[end:]\nf.write_text(s)\np,rtl=probes['shared_shifter']\nf=rtl/'alu.sv'\ns=f.read_text()\npos=s.index('  always_comb begin')\ns=s[:pos]+'''  logic [31:0] reversed_a, shifter_operand, shifted_value, reversed_shifted;\n  logic [32:0] shifter_value;\n  logic shift_left, shift_sign;\n  assign shift_left = op == ALU_SLL;\n  assign shift_sign = op == ALU_SRA && a[31];\n  for (genvar i=0; i<32; i++) begin : g_reverse\n    assign reversed_a[i] = a[31-i];\n    assign reversed_shifted[i] = shifted_value[31-i];\n  end\n  assign shifter_operand = shift_left ? reversed_a : a;\n  assign shifter_value = \"'$unsigned($signed({shift_sign, shifter_operand}) >>> b[4:0]);\n  assign shifted_value = shifter_value[31:0];\n\n'\"'''+s[pos:]\ns=s.replace('ALU_SLL:    out = a << shamt;','ALU_SLL:    out = reversed_shifted;').replace('ALU_SRL:    out = a >> shamt;','ALU_SRL:    out = shifted_value;').replace('ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','ALU_SRA:    out = shifted_value;')\nf.write_text(s)\ndef run(item):\n name,(p,rtl)=item\n r=gowin.build(root,rtl,'fpga/core_bench_si.sv',0,p/'timing_p0')\n (p/'timing_result.json').write_text(json.dumps(r,indent=2))\n return name,r\nwith ThreadPoolExecutor(max_workers=2) as ex:\n for name,r in ex.map(run,probes.items()):\n  print(name,json.dumps(r),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
