{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_stage.py'", "aggregated_output": "\"\"\"Fetch acceptance must retain the prediction from before table training.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _bundle(dut):\n    value = int(dut.out.value)\n    return (value >> 65, (value >> 33) & 0xFFFFFFFF,\n            (value >> 1) & 0xFFFFFFFF, value & 1)\n\n\nasync def _edge(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def queue_saves_old_prediction_across_training_and_full_replacement(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.decode_hold.value = 1\n    dut.imem_ready.value = 1\n    dut.imem_data.value = 0x00100093\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = dut.train_target.value = 0\n    dut.train_install.value = 1\n    dut.train_conditional.value = 0\n    dut.train_taken.value = 1\n    await _edge(dut)\n    dut.reset.value = 0\n\n    # A table installation and queued fetch on the same edge use old data.\n    dut.train_valid.value = 1\n    dut.train_pc.value = 0\n    dut.train_target.value = 0x80000100\n    await Timer(1, \"ns\")\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n    await _edge(dut)\n    assert int(dut.imem_addr.value) == 4\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n\n    # Changing the head's table entry must not alter its saved prediction.\n    dut.train_target.value = 0x12345678\n    dut.imem_data.value = 0x00200113\n    await _edge(dut)\n    assert int(dut.count_q.value) == 2\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n\n    # Invalidate the head's entry while replacing a full queue's old head.\n    dut.train_install.value = 0\n    dut.decode_hold.value = 0\n    dut.imem_data.value = 0x00300193\n    await Timer(1, \"ns\")\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n    await _edge(dut)\n    assert int(dut.count_q.value) == 2\n    assert _bundle(dut) == (4, 0x00200113, 8, 1)\n\n    dut.train_valid.value = 0\n    dut.imem_ready.value = 0\n    # Deliberately unrelated bus data cannot replace either queued bundle.\n    dut.imem_data.value = 0xFFFFFFFF\n    await _edge(dut)\n    assert _bundle(dut) == (8, 0x00300193, 12, 1)\n    await _edge(dut)\n    assert int(dut.count_q.value) == 0\n    assert _bundle(dut) == (12, 0xFFFFFFFF, 16, 0)\n\n    # Verify a full-width target is used, saved, and retained after retraining.\n    dut.train_valid.value = 1\n    dut.train_pc.value = 12\n    dut.train_target.value = 0x80000100\n    dut.train_install.value = 1\n    await _edge(dut)  # bus unavailable: only table training advances\n    dut.train_valid.value = 0\n    dut.decode_hold.value = 1\n    dut.imem_ready.value = 1\n    dut.imem_data.value = 0x00400213\n    await _edge(dut)\n    assert int(dut.imem_addr.value) == 0x80000100\n    assert _bundle(dut) == (12, 0x00400213, 0x80000100, 1)\n    dut.imem_ready.value = 0\n    dut.train_valid.value = 1\n    dut.train_target.value = 0xF0000100\n    await _edge(dut)\n    assert _bundle(dut) == (12, 0x00400213, 0x80000100, 1)\n\n    dut.train_valid.value = 0\n    dut.imem_ready.value = 1\n    dut.imem_data.value = 0x00500293\n    await _edge(dut)\n    dut.imem_ready.value = 0\n    dut.decode_hold.value = 0\n    await _edge(dut)\n    assert _bundle(dut) == (0x80000100, 0x00500293, 0x80000104, 1)\n    assert int(dut.read_q.value) == 0\n    await _edge(dut)\n    assert int(dut.count_q.value) == 0 and int(dut.read_q.value) == 1\n\n    # Reset must clear a wrapped read pointer and predictor validity too.\n    dut.reset.value = 1\n    await _edge(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.count_q.value) == 0\n    assert int(dut.read_q.value) == int(dut.write_q.value) == 0\n    assert _bundle(dut) == (0, 0x00500293, 4, 0)\n\n\ndef test_if_stage_runner():\n    run_cocotb(\"if_stage\", [\"core_pkg.sv\", \"if_stage.sv\"], \"test_if_stage\")\n", "exit_code": 0, "status": "completed"}}
