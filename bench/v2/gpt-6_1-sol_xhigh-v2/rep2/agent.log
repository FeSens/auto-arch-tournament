{"type":"item.completed","item":{"id":"item_37","type":"agent_message","text":"The smaller match-only version and a shorter-tag table also reduced Fmax. I’ll change direction: compute direct branch and JAL targets from the fetched instruction, with a small target table reserved for JALR. That could reduce predictor storage and lookup work while preserving full next-PC checks in EX."}}
{"type": "item.started", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/5ff8876e/d9943d9b/predictor-direct')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'core.sv'\ns=p.read_text().replace('train_valid, train_install, train_conditional, train_taken;','train_valid, train_install, train_conditional, train_taken, train_indirect;')\ns=s.replace('.train_conditional (train_conditional),','.train_conditional (train_conditional),\\\\n    .train_indirect (train_indirect),')\nassert s.count('.train_indirect (train_indirect)')==2\np.write_text(s)\np=rtl/'ex_stage.sv'\ns=p.read_text().replace('output logic               train_conditional,','output logic               train_conditional,\\\\n  output logic               train_indirect,')\ns=s.replace('assign train_conditional = in.ctrl.is_branch;','assign train_conditional = in.ctrl.is_branch;\\\\n  assign train_indirect = in.ctrl.is_jump && in.ctrl.is_jalr;')\np.write_text(s)\n(rtl/'if_stage.sv').write_text('''\"'`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule if_stage (\n  input logic clock, reset, stall, flush, redirect,\n  input logic [31:0] redirect_target,\n  input logic train_valid,\n  input logic [31:0] train_pc, train_target,\n  input logic train_install, train_conditional, train_taken, train_indirect,\n  output logic [31:0] imem_addr,\n  input logic [31:0] imem_data,\n  output if_id_t out\n);\n  logic [31:0] pc, next_pc;\n  logic [63:0] direction_valid_q;\n  logic [1:0] direction_q [0:63];\n  logic [15:0] indirect_valid_q;\n  logic [25:0] indirect_tag_q [0:15];\n  logic [29:0] indirect_target_q [0:15];\n  logic [5:0] direction_index, direction_train_index;\n  logic [3:0] indirect_index, indirect_train_index;\n  logic indirect_hit, indirect_train_match;\n  logic is_branch, is_jal, is_jalr, predicted_taken;\n  logic [31:0] branch_imm, jal_imm, direct_imm, direct_target;\n\n  assign direction_index = pc[7:2];\n  assign direction_train_index = train_pc[7:2];\n  assign indirect_index = pc[5:2];\n  assign indirect_train_index = train_pc[5:2];\n  assign indirect_hit = indirect_valid_q[indirect_index] &&\n                        indirect_tag_q[indirect_index] == pc[31:6];\n  assign indirect_train_match = indirect_valid_q[indirect_train_index] &&\n                              indirect_tag_q[indirect_train_index] == train_pc[31:6];\n  assign is_branch = imem_data[6:0] == 7'\"'b1100011 &&\n                     imem_data[14:12] \"'!= 3'\"'d2 && imem_data[14:12] \"'!= 3'\"'d3;\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign is_jalr = imem_data[6:0] == 7'b1100111 && imem_data[14:12] == 3'd0;\n  assign branch_imm = {{19{imem_data[31]}}, imem_data[31], imem_data[7],\n                       imem_data[30:25], imem_data[11:8], 1'b0};\n  assign jal_imm = {{11{imem_data[31]}}, imem_data[31], imem_data[19:12],\n                    imem_data[20], imem_data[30:21], 1'b0};\n  assign direct_imm = is_jal ? jal_imm : branch_imm;\n  assign direct_target = pc + direct_imm;\n  assign predicted_taken = direction_valid_q[direction_index]\n                         ? direction_q[direction_index][1] : imem_data[31];\n  always_comb begin\n    next_pc = pc + 32'd4;\n    if (is_jalr && indirect_hit)\n      next_pc = {indirect_target_q[indirect_index], 2'b00};\n    else if ((is_jal || (is_branch && predicted_taken)) && direct_target[1:0] == 0)\n      next_pc = direct_target;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      direction_valid_q <= '0;\n      indirect_valid_q <= '0;\n    end else if (train_valid) begin\n      if (train_install && train_conditional)\n        direction_valid_q[direction_train_index] <= 1'b1;\n      if (train_install && train_indirect)\n        indirect_valid_q[indirect_train_index] <= 1'b1;\n      else if (indirect_train_match)\n        indirect_valid_q[indirect_train_index] <= 1'b0;\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (\"'!reset && train_valid) begin\n      if (train_install && train_indirect) begin\n        indirect_tag_q[indirect_train_index] <= train_pc[31:6];\n        indirect_target_q[indirect_train_index] <= train_target[31:2];\n      end\n      if (train_install && train_conditional) begin\n        if (!direction_valid_q[direction_train_index])\n          direction_q[direction_train_index] <= train_taken ? 2'\"'b10 : 2'b01;\n        else if (train_taken)\n          direction_q[direction_train_index] <= direction_q[direction_train_index] == 2'b11\n                                           ? 2'b11 : direction_q[direction_train_index] + 2'b01;\n        else\n          direction_q[direction_train_index] <= direction_q[direction_train_index] == 2'b00\n                                           ? 2'b00 : direction_q[direction_train_index] - 2'b01;\n      end\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset) pc <= '0;\n    else if (redirect) pc <= redirect_target;\n    else if (\"'!stall) pc <= next_pc;\n  end\n  assign imem_addr = pc;\n  always_comb begin\n    out.pc = pc;\n    out.instr = imem_data;\n    out.predicted_next_pc = next_pc;\n    out.valid = !reset && !flush;\n  end\nendmodule\n'\"''')\nprint('Prepared instruction-driven direct target predictor')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
