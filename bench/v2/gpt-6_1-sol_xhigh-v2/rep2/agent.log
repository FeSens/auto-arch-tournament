{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '75,260p' cores/bench/test/test_pipeline.py; sed -n '420,670p' cores/bench/test/test_pipeline.py; sed -n '770,1080p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200,\n               stalls=None, services=None, monitor=None, fetch=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = (dict(program) if isinstance(program, dict) else\n            {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)})\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Bus requests are serviced only on an accepting clock edge.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    pending_request = None\n    for cycle in range(max_cycles):\n        await Timer(1, \"ns\")\n        ia = int(dut.io_imemAddr.value)\n        da = int(dut.io_dmemAddr.value)\n        iready, dready = stalls(cycle, dut) if stalls else (1, 1)\n        dut.io_imemReady.value = iready\n        dut.io_dmemReady.value = dready\n        if fetch is not None:\n            fetch(cycle, dut, imem)\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        await Timer(4, \"ns\")\n        wen = int(dut.io_dmemWEn.value)\n        ren = int(dut.io_dmemREn.value)\n        wdata = int(dut.io_dmemWData.value)\n        request = (da, wen, ren, wdata)\n        if pending_request is not None:\n           \n…[30674 of 33746 chars elided by tools/bench/transcript.py; sha256:098322f0d8b3f374]…\nsert [r[\"rd_wdata\"] for r in site] == [4] * 6 + [19]\n    assert [r[\"pc\"] for r in rets] == [0] * 7 + [4, 8]\n    assert rets[-2][\"rd_wdata\"] == 42\n    [stale] = [e for e in monitor.events if e[0] == 0 and e[1] == ADDI(7, 0, 19)]\n    assert stale[2:5] == (0, 4, 1)\n    assert monitor.warm_accepts >= 4\n\n\n@cocotb.test()\nasync def predictor_reset_invalidation_and_misaligned_candidates(dut):\n    # Running twice on the same DUT verifies reset clears every valid bit,\n    # including entries with previously learned unconditional predictions.\n    warm = [JAL(5, 8), SW(5, 0, 0x300), EBREAK()]\n    for _ in range(2):\n        monitor = _PredictorMonitor()\n        rets, mem = await _run(dut, warm, monitor=monitor)\n        _check_stream(rets, {4 * i: insn for i, insn in enumerate(warm)}, [0, 8])\n        assert monitor.events[0][2:5] == (4, 8, 1) and not mem\n    program = [ADDI(1, 0, 1), BEQ(0, 1, 2), BEQ(0, 0, 2), JAL(5, 2),\n               ADDI(2, 0, 27), JALR(6, 2, 0), ADDI(2, 0, 33),\n               JALR(7, 2, 0), EBREAK()]\n", "exit_code": 0, "status": "completed"}}
