{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY' > cores/bench/vendor-cosim-local.log 2>&1\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json\nfrom tools.eval.cosim import run_one, run_coremark_crc, TRACE_STALL_MODES\nworktree = str(Path.cwd())\nsim = str(Path('cores/bench/obj_dir_vendor/cosim_sim').resolve())\nwith ThreadPoolExecutor(max_workers=8) as pool:\n    futures = [pool.submit(run_one, elf.resolve(), sim, worktree, None, flags)\n               for elf in sorted(Path('bench/programs').glob('*.elf'))\n               if elf.name \"'!= '\"'coremark.elf' for flags in TRACE_STALL_MODES]\n    results = [f.result() for f in futures]\nresults.append(run_coremark_crc(Path('bench/programs/coremark.elf').resolve(), sim, worktree))\nprint(json.dumps(results, indent=2))\nassert all(r['passed'] for r in results)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY' > cores/bench/coremark-cycles-local.log 2>&1\nfrom pathlib import Path\nimport json, subprocess\nfrom tools.eval.fpga import validate_coremark_uart\nmarkers = []\nfor backend in ('obj_dir', 'obj_dir_vendor'):\n    sim = str(Path('cores/bench', backend, 'cosim_sim').resolve())\n    p = subprocess.run([sim, 'bench/programs/coremark.elf', '50000000', '--bench', '--istall', '--dstall'], capture_output=True, text=True, check=True)\n    marker = json.loads(p.stdout.splitlines()[-1])\n    print(backend, json.dumps(marker), flush=True)\n    assert marker['ebreak'] and not marker['maxcycles_hit'] and not marker['oob']\n    assert marker['bench_start_cycle'] > 0\n    assert marker['bench_stop_cycle'] > marker['bench_start_cycle']\n    assert validate_coremark_uart(marker['uart'], 10)[0]\n    markers.append(marker)\nassert markers[0] == markers[1]\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
