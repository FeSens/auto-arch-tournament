{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_if_stage.py; sed -n '1,260p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Fetch acceptance must retain the prediction from before table training.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _bundle(dut):\n    value = int(dut.out.value)\n    return (value >> 65, (value >> 33) & 0xFFFFFFFF,\n            (value >> 1) & 0xFFFFFFFF, value & 1)\n\n\nasync def _edge(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def queue_saves_old_prediction_across_training_and_full_replacement(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.decode_hold.value = 1\n    dut.imem_ready.value = 1\n    dut.imem_data.value = 0x00100093\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = dut.train_target.value = 0\n    dut.train_install.value = 1\n    dut.train_conditional.value = 0\n    dut.train_taken.value = 1\n    await _edge(dut)\n    dut.reset.value = 0\n\n    # A table installation and queued fetch on the same edge use old data.\n    dut.train_valid.value = 1\n    dut.train_pc.value = 0\n    dut.train_target.value = 0x80000100\n    await Timer(1, \"ns\")\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n    await _edge(dut)\n    assert int(dut.imem_addr.value) == 4\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n\n    # Changing the head's table entry must not alter its saved prediction.\n    dut.train_target.value = 0x12345678\n    dut.imem_data.value = 0x00200113\n    await _edge(dut)\n    assert int(dut.count_q.value) == 2\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n\n    # Invalidate the head's entry while replacing a full queue's old head.\n    dut.train_install.value = 0\n    dut.decode_hold.value = 0\n    dut.imem_data.value = 0x00300193\n    await Timer(1, \"ns\")\n    assert _bundle(dut) == (0, 0x00100093, 4, 1)\n    await _edge(dut)\n    assert int(dut.count_q.value) == 2\n    assert _bundle(dut) == (4, 0x00200113, 8, 1)\n\n    dut.train_valid.value = 0\n    dut.imem_ready.value = 0\n    # Deliberately unre\n…[11227 of 14299 chars elided by tools/bench/transcript.py; sha256:d42f6813819c4133]…\n1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n    assert monitor.load_bubbles == 1\n    [load] = _by_insn(rets, LW(1, 0, 0))\n    assert r2[\"cycle\"] - load[\"cycle\"] == 2\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n", "exit_code": 0, "status": "completed"}}
