{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger operations remain combinational. MUL uses capture/product/transfer;\nDIV/REM keep capture, seven iterations, and registered response transfer.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nMUL_OPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nALTOPS_MASKS = {\n    ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n    ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137,\n    ALU_DIV: 0x7F8529EC, ALU_DIVU: 0x10E8FD70,\n    ALU_REM: 0x8DA68FA5, ALU_REMU: 0x3138D0E1,\n}\n_pending_states = None\n\n\ndef _radix4_digit(r, bits, d, width):\n    \"\"\"Fixed-width subtract/borrow model, separate from the RV32M oracle.\"\"\"\n    t = (r << 2) | bits\n    assert t < (1 << width)\n    for digit in (3, 2, 1):\n        difference = (t - digit * d) & ((1 << (width + 1)) - 1)\n        if not (difference >> width):\n            return difference, digit\n    return t, 0\n\n\ndef _recurrence_states(a, d, digits=None):\n    \"\"\"Check the 6/7-bit seed and 34/35-bit recurrence at every digit.\"\"\"\n    nibble = a >> 28\n    r, seed_q = 0, 0\n    if d >= 16:\n        r = nibble\n    else:\n        for shift in (2, 0):\n            r, digit = _radix4_digit(r, (nibble >> shift) & 3, d, 6)\n            seed_q = (seed_q << 2) | digit\n            if digits is not None:\n                digits.add(digit)\n            assert r < d if d else r <= nibble\n    # Independently check the entire nibble, including D=0.\n    assert (r, seed_q) == ((nibble % d, nibble // d) if d else (nibble, 15))\n    q = ((a << 4) | seed_q) & MASK32\n    states = [(r, q)]\n    for _ in range(7):\n        for _ in range(2):\n            r, digit = _radix4_digit(r, q >> 30, d, 34)\n            q = ((q << 2) | digit) & MA\n…[24657 of 27729 chars elided by tools/bench/transcript.py; sha256:ed5307af49d17249]…\nuotient = -q if signed and (sa < 0) != (sb < 0) and b else q\n            remainder = -r if signed and sa < 0 else r\n            assert quotient & MASK32 == _division_model(ALU_DIV if signed else ALU_DIVU, a, b)\n            assert remainder & MASK32 == _division_model(ALU_REM if signed else ALU_REMU, a, b)\n    assert digits == {0, 1, 2, 3}\n\n\ndef test_alu_altops_runner():\n    \"\"\"Run the same edge/capture/latency checks with documented ALTOPS.\"\"\"\n    from cocotb_tools.runner import get_runner\n    from _helpers import RTL, SIM_BUILD, TEST_DIR\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[RTL / s for s in (\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=build_dir, always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"+define+RISCV_FORMAL_ALTOPS\"],\n    )\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"ALU_ALTOPS\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
