{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_ex_stage.py && sed -n '1,220p' cores/bench/test/_helpers.py && sed -n '1,160p' tools/eval/cosim.py && sed -n '200,265p' tools/eval/gowin.py\"", "aggregated_output": "\"\"\"Divider response holds must delay stale-prediction recovery until transfer.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n                      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb)\n\n\nMASK = 0xFFFFFFFF\nID_FIELDS = [(\"pc\", 32), (\"prediction\", 32), (\"rs1\", 32), (\"rs2\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"ctrl\", 22), (\"insn\", 32), (\"valid\", 1)]\nEX_FIELDS = [(\"pc\", 32), (\"result\", 32), (\"write_data\", 32), (\"rd\", 5),\n             (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1\", 32), (\"rs2\", 32),\n             (\"pc_next\", 32), (\"taken\", 1), (\"target\", 32), (\"ctrl\", 22),\n             (\"insn\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, values):\n    word = 0\n    for name, width in fields:\n        word = (word << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return word\n\n\ndef _unpack(fields, word):\n    values = {}\n    for name, width in reversed(fields):\n        values[name] = word & ((1 << width) - 1)\n        word >>= width\n    return values\n\n\nasync def _tick(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def stale_division_prediction_with_capture_completion_and_response_holds(dut):\n    cases = [(ALU_DIV, -97, 7, -13), (ALU_REM, -97, 7, -6),\n             (ALU_DIVU, 0xFFFFFFFF, 7, 0xFFFFFFFF // 7),\n             (ALU_REMU, 0xFFFFFFFF, 7, 0xFFFFFFFF % 7)]\n    for op, a, b, result in cases:\n        dut.clock.value = 0\n        dut.reset.value = 1\n        dut.stall.value = 0\n        getattr(dut, \"in\").value = 0\n        dut.fwd_rs1_sel.value = 0\n        dut.fwd_rs2_sel.value = 0\n        dut.fwd_ex_mem.value = 0\n        dut.fwd_mem_wb.value = 0\n        await _tick(dut)\n        dut.reset.value = 0\n        pc = 0x80000010\n        insn = (1 << 25) | (2 << 20) | (1 << 15) | ((op - ALU_DIV + 4) << 12) | (3 << 7) | 0x33\n        ctrl = (op << 17) | (2 << 4) | (1 << 3) | (1 << 2)\n        payload = _\n…[17166 of 20238 chars elided by tools/bench/transcript.py; sha256:833ab91f88e8df1d]…\n:\n            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\n            continue\n        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\n              f\"logic {r['logic']}, registers {r['regs']}, LUT-RAM {r['lutram']}, BSRAM {r['bsram']}, DSP {r['dsp']}\")\n        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\n            print(f\"  path {i}: {p['arrival_ns']} ns, {p['logic_cells']} cells, {p['from']} -> {p['to']}\")\n            print(f\"          through: {' > '.join(p['modules'])}\")\n        print(f\"  full report: {tr}\")\n    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "exit_code": 0, "status": "completed"}}
