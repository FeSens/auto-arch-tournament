{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\n\ndef match(a,b,p,n,clear):\n mask=(1<<n)-1\n c=(p\"'^a''^b)&mask\n if clear: c &= ~1\n g=(a&b)|((a''^b)&c)\n return (not (p&1) if clear else not(c&1)) and (c>>1)==(g&((1<<(n-1))-1))\nfor n in range(1,6):\n for a in range(1<<n):\n  for b in range(1<<n):\n   for p in range(1<<n):\n    for clear in (False,True):\n     expected=((a+b)&((1<<n)-1)) & (~1 if clear else -1)\n     assert match(a,b,p,n,clear)==(p==expected),(n,a,b,p,clear)\nrng=random.Random(0xc411)\nfor _ in range(100000):\n a,b=rng.getrandbits(32),rng.getrandbits(32)\n for clear in (False,True):\n  expected=((a+b)&0xffffffff)&(~1 if clear else -1)\n  for p in (expected,expected''^(1<<rng.randrange(32)),rng.getrandbits(32)):\n   assert match(a,b,p,32,clear)==(p==expected)\nprint('\"'Carry identity agrees with independent integer oracle: exhaustive widths 1..5 and 600,000 full-width comparisons')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
