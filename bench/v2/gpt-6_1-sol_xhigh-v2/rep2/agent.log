{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/r12_radix16/test/test_alu.py')\ns=p.read_text()\ns=s.replace('        assert int(dut.u_divider.d3_q.value) == 3 * mag_b','        assert int(dut.u_divider.d3_q.value) == 3 * mag_b\\\\n        for k in range(1,16):\\\\n            assert int(getattr(dut.u_divider, f\\\"d{k}_q\\\").value) == k * mag_b')\ninsert=s.index('\\\\ndef test_alu_runner')\ns=s[:insert]+'''\n@cocotb.test()\nasync def radix16_digit_and_borrow_boundary_transactions(dut):\n    await _setup(dut)\n    covered = set()\n    pairs = set()\n    edges = (0,1,2,3,7,15,16,17,0x0FFFFFFF,0x10000000,\n             0x55555555,0x7FFFFFFF,0x80000000,0x80000001,\n             0xAAAAAAAB,0xFFFFFFFE,MASK32)\n    for d in edges:\n        for digit in range(16):\n            for offset in (-1,0,1):\n                a = digit*d+offset\n                if 0 <= a <= MASK32:\n                    pairs.add((a,d))\n        pairs.add((MASK32,d))\n    pairs.update((digit*0x11111111,1) for digit in range(16))\n    for a,b in sorted(pairs):\n        for op in DIV_OPS:\n            signed=op in (ALU_DIV,ALU_REM)\n            mag_a=(-a)&MASK32 if signed and a>>31 else a\n            mag_b=(-b)&MASK32 if signed and b>>31 else b\n            states=_recurrence_states(mag_a,mag_b)\n            for r,q in states[:-1]:\n                trial=(r<<4)|(q>>28)\n                covered.add(trial//mag_b if mag_b else 15)\n            await _check_div(dut,op,a,b,_division_model(op,a,b))\n    assert covered == set(range(16)), covered\n    dut._log.info(\\\"Radix-16 boundary coverage: %d pairs, all 16 quotient digits\\\",len(pairs))\n\n''' +s[insert:]\n# Verify the helper name before saving.\nassert 'async def _check_div(' in s\np.write_text(s)\nPY\npytest -q cores/bench/generated/r12_radix16/test/test_alu.py > cores/bench/generated/r12_radix16/alu_tests_extended.log 2>&1\"