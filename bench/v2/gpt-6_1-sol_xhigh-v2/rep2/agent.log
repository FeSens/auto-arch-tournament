{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/5ff8876e/d474d8ce/divider_segment_probe')\nroot.mkdir(exist_ok=True)\nfor d in ['rtl','test']:\n    shutil.copytree(Path('cores/bench')/d,root/d,dirs_exist_ok=True)\nparts=['  function automatic [34:0] subtract34(input logic [33:0] x, input logic [33:0] y);', '    logic [4:0] d0, d1, d2, d3, d4, d5, d6, d7;', '    logic [2:0] dh;', '    logic [7:0] p0, g0, p1, g1, p2, g2, p3, g3;', '    logic [7:0] bi;', '    logic [33:0] value;', '    begin']\nfor j in range(8):\n    parts.append(f\\\"      d{j} = {{1'b0,x[{4*j} +: 4]}} - {{1'b0,y[{4*j} +: 4]}};\\\")\n    parts.append(f'      p0[{j}] = (x[{4*j} +: 4] == y[{4*j} +: 4]);')\n    parts.append(f'      g0[{j}] = d{j}[4];')\nfor level,gap in [(1,1),(2,2),(3,4)]:\n    for j in range(8):\n        if j<gap:\n            parts.append(f'      p{level}[{j}] = p{level-1}[{j}];')\n            parts.append(f'      g{level}[{j}] = g{level-1}[{j}];')\n        else:\n            parts.append(f'      p{level}[{j}] = p{level-1}[{j}] & p{level-1}[{j-gap}];')\n            parts.append(f'      g{level}[{j}] = g{level-1}[{j}] | (p{level-1}[{j}] & g{level-1}[{j-gap}]);')\nparts.append(\\\"      bi = {g3[6:0],1'b0};\\\")\nfor j in range(8):\n    parts.append(f\\\"      value[{4*j} +: 4] = bi[{j}] ? d{j}[3:0] - 4'd1 : d{j}[3:0];\\\")\nparts.extend([\\\"      dh = {1'b0,x[33:32]} - {1'b0,y[33:32]};\\\", \\\"      value[33:32] = g3[7] ? dh[1:0] - 2'd1 : dh[1:0];\\\", '      subtract34 = {dh[2] | ((x[33:32] == y[33:32]) & g3[7]),value};','    end','  endfunction',''])\nhelper='\\\\n'.join(parts)\np=root/'rtl/divider.sv'\ns=p.read_text()\nneedle='  function automatic [63:0] radix4_step('\ns=s.replace(needle,helper+'\\\\n'+needle)\nfor i in range(1,4):\n    s=s.replace(f\\\"diff{i} = {{1'b0, t}} - {{1'b0, d{i}}};\\\", f'diff{i} = subtract34(t,d{i});')\np.write_text(s)\n(root/'subtract_miter.sv').write_text('module subtract_miter(input [33:0] x,y, output mismatch);\\\\n'+helper+\\\"\\\\nassign mismatch = subtract34(x,y) \"'!= ({1'\"'b0,x}-{1'b0,y});\\\\nendmodule\\\\n\\\")\nprint('Prepared isolated segmented-subtraction prototype:',root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
