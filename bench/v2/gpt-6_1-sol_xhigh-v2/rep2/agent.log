{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl')\nprobe=Path('cores/bench/generated/hypgen_probe2/rtl')\nprobe.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'):\n shutil.copyfile(p,probe/p.name)\nrf='''module reg_file (\n input logic clock, reset,\n input logic [4:0] rs1_addr, rs2_addr,\n output logic [31:0] rs1_data, rs2_data,\n input logic w_en,\n input logic [4:0] w_addr,\n input logic [31:0] w_data\n);\n'''\nfor reg in range(1,32):\n rf+=f' logic [31:0] r{reg};\\\\n always_ff @(posedge clock) begin\\\\n if (reset) r{reg} <= 0;\\\\n else if (w_en && w_addr == 5\\\\'d{reg}) r{reg} <= w_data;\\\\n end\\\\n'\nfor port in [1,2]:\n rf+=f' logic [31:0] read{port};\\\\n always_comb begin\\\\n case (rs{port}_addr)\\\\n'\n for reg in range(32):\n  val=\\\"32'b0\\\" if reg==0 else f'r{reg}'\n  rf+=f' 5\\\\'d{reg}: read{port} = {val};\\\\n'\n rf+=f' default: read{port} = 0;\\\\n endcase\\\\n end\\\\n'\n rf+=f' assign rs{port}_data = (rs{port}_addr \"'!= 0 && w_en && w_addr == rs{port}_addr) ? w_data : read{port};'\"\\\\n'\nrf+='endmodule\\\\n'\n(probe/'reg_file.sv').write_text(rf)\nprint('Prototype 2: explicit flop architectural registers; complete read selection before ID/EX')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
