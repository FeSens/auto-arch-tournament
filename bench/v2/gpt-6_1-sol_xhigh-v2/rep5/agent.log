{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/rtl/forward_unit.sv; sed -n '23,52p' cores/bench/rtl/mem_stage.sv\"","aggregated_output":"// rtl/forward_unit.sv\n//\n// Next-cycle operand provenance. Match the sources entering (or held in)\n// ID/EX against the producers entering EX/MEM and MEM/WB at the same edge.\n// These one-hot controls select actual data before the ID/EX operand flops:\n//   001 (BASE)   : ID/EX register's rs?_val\n//   010 (EX_MEM) : the in-flight ALU result from the EX/MEM register\n//   100 (MEM_WB) : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds registered raw and complete EX operands.\nmodule forward_unit (\n  input  logic [4:0] next_rs1,\n  input  logic [4:0] next_rs2,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == next_rs1) fwd_rs1 = 3'b010;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == next_rs1) fwd_rs1 = 3'b100;\n    else                                                               fwd_rs1 = 3'b001;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == next_rs2) fwd_rs2 = 3'b010;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == next_rs2) fwd_rs2 = 3'b100;\n    else                                                               fwd_rs2 = 3'b001;\n  end\n\nendmodule\n  // remain visible to forward_unit), but `valid` is cleared so:\n  //   - rvfi_order doesn't increment for held cycles\n  //   - wb_stage doesn't write the regfile twice\n  // Zeroing the whole register would lose the LOAD's load_data, breaking\n  // MEM/WB->EX forwarding for any dependent instruction that's also held\n  // in ID/EX during the stall (e.g. a BNE that consumes a LOAD's result).\n  input  logic               hold_wb,\n  // ex_mem_t carries branch_taken / branch_target / pc_next / rs?_val\n  // for downstream RVFI use; mem_stage only consumes a subset, so the\n  // remaining fields look unused from this module's perspective.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  // MEM/WB register output\n  output mem_wb_t  out,\n  output logic [4:0]         next_rd,\n  output logic               next_w_en,\n  output logic [31:0]        next_data,\n  output producer_t         accepted_producer\n);\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n","exit_code":0,"status":"completed"}}
