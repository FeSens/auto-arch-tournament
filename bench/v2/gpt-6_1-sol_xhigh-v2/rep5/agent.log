{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/_helpers.py cores/bench/test/conftest.py\npython - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import parse_reports\nfor d in sorted(Path('cores/bench/sim_build/predictor_probe/timing_banked').glob('gowin_p*')):\n r=parse_reports(d)\n print(d.name,{k:r.get(k) for k in ('placement_failed','fmax_mhz','logic','regs','lutram','bsram')})\n if not r['placement_failed']: print('worst',r['critical_paths'][:1])\nPY\"","aggregated_output":"\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\ngowin_p0 {'placement_failed': True, 'fmax_mhz': None, 'logic': None, 'regs': None, 'lutram': None, 'bsram': None}\ngowin_p1 {'placement_failed': True, 'fmax_mhz': None, 'logic': None, 'regs': None, 'lutram': None, 'bsram': None}\ngowin_p2 {'placement_failed': True, 'fmax_mhz': None, 'logic': None, 'regs': None, 'lutram': None, 'bsram': None}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/sim_build/predictor_probe/test_banked.py')\ns=Path('cores/bench/test/test_if_stage.py').read_text()\ns=s.replace('from _helpers import run_cocotb','''from pathlib import Path\nfrom cocotb_tools.runner import get_runner\n\ndef _idx(pc):\n    return ((pc >> 2) \"'^ (pc >> 9)) & 127\n\ndef run_cocotb(toplevel, sources, test_module):\n    root = Path(__file__).resolve().parent\n    runner = get_runner(\"verilator\")\n    build = root / \"if_test_build\"\n    runner.build(sources=[root / \"rtl_banked\" / f for f in sources],\n                 hdl_toplevel=toplevel, build_dir=build,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=toplevel, test_module=\"test_banked\",\n                test_dir=root, build_dir=build)\n'\"''')\ns=s.replace('a, b = 0x80000000, 0x80000080','a, b = 0x80000000, 0x80000204')\ns=s.replace('(pc >> 2) & 31','_idx(pc)').replace('pc >> 7','pc >> 9')\ns=s.replace('if eligible and not (pc & 3) and not (target & 3):','if eligible and not (pc & 3) and not (target & 3) and (hit or jump or taken):')\np.write_text(s)\nPY\npytest -q cores/bench/sim_build/predictor_probe/test_banked.py > cores/bench/sim_build/predictor_probe/if_tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
