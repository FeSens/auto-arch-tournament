, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[5648 of 8720 chars elided by tools/bench/transcript.py; sha256:743190fe736ccdbd]…\n        } else if (addr == BENCH_STOP_ADDR) {\n                // Last stop_time() call wins — CoreMark calls it once, but\n                // tolerate multiple if a bench program re-times.\n                bench_stop_cycle = cycle; bench_stop_set = true;\n            } else if (in_uart_range(addr)) {\n                for (int i = 0; i < 4; i++) {\n                    if ((top->io_dmemWEn >> i) & 1) {\n                        char c = (top->io_dmemWData >> (i * 8)) & 0xFF;\n                        if (c) uart_buf.push_back(c);\n                    }\n                }\n            } else if (in_mem_range(addr)) {\n                ww(dmem, addr, top->io_dmemWData, top->io_dmemWEn);\n            } else {\n                // OOB write (neither dmem nor UART). Flag so testbench reports it.\n                oob_access = true;\n            }\n        }\n\n        top->clock = 1; top->eval();\n\n        // Drain channel 0 then channel 1 (NRET=2 contract). For V0\n        // single-issue, channel 1's valid is always 0, so the JSON stream\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport struct,json,collections\nr=list(struct.iter_unpack('<IIBBB',open('cores/bench/.hyp_probe_r13s2/control.bin','rb').read()))\nfor mode in ('base','static_jal','static_jal_btfnt_miss','static_jal_taken_alloc','two_way_32','two_way_16','hash32','btfnt_miss','always_taken_miss'):\n rows={};miss=[0,0,0];why=collections.Counter();hot=collections.Counter()\n for pc,target,op,taken,active in r:\n  ix=(pc>>2)&31\n  if mode=='hash32':ix=((pc>>2)\"'^(pc>>7))&31\n  if mode.startswith('\"'two_way'):ix=(pc>>2)&(31 if mode.endswith('32') else 15)\n  rowset=rows.get(ix,[])\n  hitrow=next((v for v in rowset if v[0]==pc),None)\n  pred=int(hitrow is not None and hitrow[2]>=2);pt=hitrow[1] if hitrow else 0\n  if mode.startswith('static_jal') and op==0x6f:pred=1;pt=target\n  if not hitrow and mode in ('btfnt_miss','static_jal_btfnt_miss') and op==0x63:pred=int(target<pc);pt=target\n  if not hitrow and mode=='always_taken_miss':pred=1;pt=target\n  cat=0 if op==0x63 else 1 if op==0x6f else 2\n  if active and (pred\"'!=taken or taken and pt!=target):\n   miss[cat]+=1;why['\"'direction_hit' if hitrow else 'cold_nt' if not taken else 'cold_t']+=1;hot[(pc,cat)]+=1\n  if mode.startswith('static_jal') and op==0x6f:continue\n  if mode=='static_jal_taken_alloc' and op==0x63 and not taken and not hitrow:continue\n  ct=3 if op\"'!=0x63 else ((min(3,hitrow[2]+1) if taken else max(0,hitrow[2]-1)) if hitrow else (2 if taken else 1))\n  new=(pc,target,ct)\n  rowset=[v for v in rowset if v[0]!=pc]+[new]\n  rows[ix]=rowset[-(2 if mode.startswith('\"'two_way') else 1):]\n print(json.dumps({'mode':mode,'misses':miss,'total':sum(miss),'why':dict(why),'hot':hot.most_common(8)}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
