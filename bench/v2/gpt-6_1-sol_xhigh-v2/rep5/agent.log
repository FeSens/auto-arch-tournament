\": 2,\n  \"critical_path\": {\n    \"from\": \"lfsr_1_s0\",\n    \"to\": \"cpu/u_id/reg_q.direct_target_match_s0\",\n    \"slack_ns\": -7.669,\n    \"arrival_ns\": 17.964,\n    \"logic_cells\": 19,\n    \"modules\": [\n      \"clock_ibuf\",\n      \"cpu/u_id/u_decoder\",\n      \"cpu/u_id/u_imm\",\n      \"cpu/u_id\"\n    ]\n  },\n  \"logic_levels\": 13,\n  \"formal_passed\": true,\n  \"cosim_passed\": true,\n  \"error\": null,\n  \"implementation_notes\": \"\",\n  \"timestamp\": \"2026-10-02T10:54:52.703728Z\",\n  \"slot\": 1,\n  \"round_id\": 9\n}\nhyp-20261002-002-r11s1 \n {\n  \"id\": \"hyp-20261002-002-r11s1\",\n  \"title\": \"Isolate the frontend behind registered fetch and tr\n…[1467 of 4539 chars elided by tools/bench/transcript.py; sha256:2986b830498b0c92]…\n\": [\n    88.343,\n    95.961,\n    95.961\n  ],\n  \"perturbations\": [\n    [\n      0,\n      88.343,\n      9\n    ],\n    [\n      1,\n      95.961,\n      11\n    ],\n    [\n      2,\n      95.961,\n      11\n    ]\n  ],\n  \"lutram\": 44,\n  \"bsram\": 4,\n  \"dsp\": 2,\n  \"critical_path\": {\n    \"from\": \"cpu/u_id/reg_q.alu_a_val_16_s0\",\n    \"to\": \"dmem_3_dmem_3_0_0_s\",\n    \"slack_ns\": -6.319,\n    \"arrival_ns\": 16.618,\n    \"logic_cells\": 9,\n    \"modules\": [\n      \"clock_ibuf\",\n      \"cpu/u_ex/u_alu\",\n      \"cpu/u_ex\"\n    ]\n  },\n  \"logic_levels\": 9,\n  \"formal_passed\": true,\n  \"cosim_passed\": true,\n  \"error\": null,\n  \"implementation_notes\": \"\",\n  \"timestamp\": \"2026-10-02T12:30:35.561365Z\",\n  \"slot\": 1,\n  \"round_id\": 11,\n  \"lesson\": \"- 2026-10-02 hyp-20261002-002-r11s1 (improvement, +11.53%): Pairing a fixed registered fetch head that drains independently of imemReady with registered BTB training-row snapshots combines CoreMark stall overlap with maintenance-path isolation, overcoming the timing cost that defeated flow-through queues.\"\n}\n", "exit_code": 0, "status": "completed"}}
