{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv cores/bench/rtl/hazard_unit.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// The inline tagged predictor chooses the next accepted fetch PC. Raw\n// instruction bits and lookup metadata never depend on EX recovery;\n// validity separately prevents unavailable or wrong-path work entering ID.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  input  logic              train_valid,      // exactly one EX advance\n  input  logic [31:0]       train_pc,\n  input  logic              train_eligible,   // legal, aligned control transfer\n  input  logic              train_jump,\n  input  logic              train_taken,\n  input  logic [31:0]       train_target,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] valid_q;\n  logic [24:0] tags [0:31];\n  logic [29:0] targets [0:31];\n  logic [1:0] counters [0:31];\n  logic [4:0] fetch_index, train_index;\n  logic fetch_hit, train_hit, prediction_selected;\n\n  assign fetch_index = pc[6:2];\n  assign train_index = train_pc[6:2];\n  assign fetch_hit = valid_q[fetch_index] && tags[fetch_index] == pc[31:7];\n  assign train_hit = valid_q[train_index] && tags[train_index] == train_pc[31:7];\n  assign prediction_selected = fetch_hit && counters[fetch_index][1];\n\n  // Only validity needs reset. I\n…[4405 of 7477 chars elided by tools/bench/transcript.py; sha256:4900620df6bafdf5]…\nX register:\n    //   - dmem_stall  -> hold        (preserve in-flight pipeline state)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    stall_id      = dmem_stall || execute_busy || load_use_hazard;\n    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !execute_busy;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
