{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('cores/bench/generated/hypothesis_probe/carry_check')\nrtl=probe/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n(rtl/'target_match.sv').write_text('''module target_match (\n input logic [31:0] a, b, predicted,\n output logic match\n);\n logic [31:0] required_carry;\n logic [30:0] next_carry;\n assign required_carry = a \"'^ b ''^ predicted;\n assign next_carry = (a[30:0] & b[30:0]) |\n                     ((a[30:0] | b[30:0]) & required_carry[30:0]);\n assign match = !required_carry[0] && !(|(required_carry[31:1] ''^ next_carry));\nendmodule\n'\"''')\np=rtl/'id_stage.sv'\ns=p.read_text()\ns=s.replace('  assign direct_target = in.pc + imm;', '''  assign direct_target = in.pc + imm;\n  logic direct_match;\n  target_match u_target_match (.a(in.pc), .b(imm),\n                              .predicted(in.predicted_target), .match(direct_match));''')\nassert 'reg_q.direct_target_match <= direct_target == in.predicted_target;' in s\ns=s.replace('reg_q.direct_target_match <= direct_target == in.predicted_target;','reg_q.direct_target_match <= direct_match;')\np.write_text(s)\n(probe/'miter.sv').write_text('''module miter(input [31:0] a,b,predicted, output mismatch);\nwire match;\nwire [31:0] actual = a+b;\ntarget_match dut(a,b,predicted,match);\nassign mismatch = match \"'!= (actual == predicted);\nendmodule\n'\"''')\n(probe/'run_timing.py').write_text('''from pathlib import Path\nimport json\nfrom tools.eval.gowin import build\nroot=Path.cwd()\nprobe=root/'cores/bench/generated/hypothesis_probe/carry_check'\nres=build(root,probe/'rtl','fpga/core_bench_si.sv',1,probe/'gowin_p1')\n(probe/'timing_p1.json').write_text(json.dumps(res,indent=2))\nprint(json.dumps(res,indent=2),flush=True)\n''')\nprint('Created isolated target-checker prototype and equivalence miter.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
