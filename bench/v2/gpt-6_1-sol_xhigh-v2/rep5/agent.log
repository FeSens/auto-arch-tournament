{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,160p' cores/bench/test/test_pipeline.py; sed -n '200,285p' tools/eval/fpga.py; sed -n '1,160p' .gitignore\"", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _bundle(packed, layout):\n    values = {}\n    for name, width in reversed(layout):\n        values[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    assert packed == 0\n    return values\n\n\n_ID_LAYOUT = [(\"pc\", 32), (\"prediction_selected\", 1), (\"predicted_target\", 32),\n              (\"direct_target\", 32), (\"direct_target_match\", 1),\n              (\"rs1_val\", 32), (\"rs2_val\", 32), (\"alu_a_val\", 32), (\"alu_b_val\", 32),\n              (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n              (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n_EX_LAYOUT = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n              (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n              (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n              (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n              (\"instr\", 32), (\"valid\", 1)]\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef\n…[14114 of 17186 chars elided by tools/bench/transcript.py; sha256:33ec3e8375f4284f]…\npshot: PATH + resolved EDA tool paths)\n# IS tracked, decided at the first v2 rep publish (e1a static, 2026-07-16):\n# it is tiny, contains no secrets, and pins which toolchain binaries\n# produced each rep's numbers.\n\n# Throwaway harness-verification runs (one-model YAMLs + their output\n# trees). These are reliability checks, not benchmark data — output is\n# regenerable and the YAMLs only encode \"rerun this single model to\n# confirm a fix landed\". Naming convention: `*-verify` for output dirs,\n# `models-*-verify.yaml` for the throwaway model YAML.\nbench/*-verify/\nbench/smoke-*/\ntools/bench/models-*-verify.yaml\n\n# Aborted/partial bench output preserved locally with a debug-tag suffix\n# (e.g. `gpt-5_5.failed-pwd-bug/`, `gpt-5_5.validate-v3/`, sibling\n# `results.jsonl.<tag>`). They document a known-broken state for the\n# author's own postmortem; the canonical results live in the un-suffixed\n# per-model dirs.\nbench/*.failed-*\nbench/*.validate-*\nbench/*.prev-*\nbench/*.stale-*\nbench/*.partial-*\nbench/results.jsonl.*\n", "exit_code": 0, "status": "completed"}}
