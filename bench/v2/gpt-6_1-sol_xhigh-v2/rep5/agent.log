{"type": "item.completed", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,230p' cores/bench/rtl/if_stage.sv; git diff -- cores/bench/rtl/core.sv cores/bench/rtl/core_pkg.sv cores/bench/rtl/hazard_unit.sv cores/bench/rtl/ex_stage.sv cores/bench/rtl/id_stage.sv; cat formal/checks_si.cfg\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Three-entry predicted fetch stream. Entry zero is always oldest.\n// An empty stream delivers the current bus snapshot directly to ID;\n// backend holds save accepted snapshots while fetch continues ahead.\n//\n// The inline tagged predictor chooses the next accepted fetch PC. Raw\n// instruction bits and lookup metadata never depend on EX recovery;\n// validity separately prevents unavailable or wrong-path work entering ID.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              backend_ready,    // ID can accept presented word\n  input  logic              redirect,         // accepted registered MEM recovery\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  input  logic              train_valid,      // exactly one MEM acceptance\n  input  logic              train_frontier,   // exact resolving dynamic snapshot\n  input  logic [31:0]       train_pc,\n  input  logic              train_eligible,   // legal, aligned control transfer\n  input  logic              train_jump,\n  input  logic              train_taken,\n  input  logic [31:0]       train_target,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] valid_q;\n  logic [24:0] tags [0:31];\n  logic [29:0] targets [0:31];\n  logic [1:0] counters [0:31];\n  logic [4:0] fetch_index, train_index;\n  logic fetch_hit, train_hit, prediction_selected;\n  logic v0, v1, v2;\n  logic push, pop, bypass, stored_push;\n  logic append0, append1, append2;\n  logic frontier_wait;\n  logic [31:0] frontier_target_q;\n  logic live_frontier, frontier_release;\n  if_id_t live_payload;\n  wire [98:0] snapshot [0:2];\n  wire [2:0] append_en;\n\n  a\n…[13406 of 16478 chars elided by tools/bench/transcript.py; sha256:7a1a5836c4c14042]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
