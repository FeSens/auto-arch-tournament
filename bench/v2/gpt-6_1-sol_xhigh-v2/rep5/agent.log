{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"sed -n '85,255p' cores/bench/rtl/ex_stage.sv\"","aggregated_output":"\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 != rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'b0;\n    endcase\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    jalr_sum    = rs1 + in.imm;\n    jump_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0}\n                                  : (in.pc + in.imm);\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n\n  assign redirect        = in.valid && !stall && !reset && !is_div\n                           && (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q, payload, div_payload_q;\n\n  always_comb begin\n    payload = '0;\n    if (in.valid) begin\n      payload.pc            = in.pc;\n      payload.alu_result    = in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      payload.write_data    = rs2;\n      payload.rd            = in.rd;\n      payload.rs1_addr      = in.rs1_addr;\n      payload.rs2_addr      = in.rs2_addr;\n      payload.rs1_val       = rs1;\n      payload.rs2_val       = rs2;\n      payload.pc_next       = misalign_fault   ? (in.pc + 32'd4)\n                            : in.ctrl.is_jump ? jump_target\n                            : branch_taken    ? branch_target\n                                              : (in.pc + 32'd4);\n      payload.branch_taken  = branch_taken;\n      payload.branch_target = branch_target;\n      payload.ctrl          = ctrl_with_trap;\n      payload.instr         = in.instr;\n      payload.valid         = 1'b1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n      div_payload_q <= '0;\n    end else begin\n      // Capture forwarded operands and all retirement metadata once.\n      if (div_request) div_payload_q <= payload;\n      if (!stall) begin\n        if (in.valid && is_div) begin\n          if (div_consume) begin\n            reg_q <= div_payload_q;\n            reg_q.alu_result <= div_result;\n          end else begin\n            // Older instructions drain; never replay a memory operation.\n            reg_q <= '0;\n          end\n        end else reg_q <= payload;\n      end\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
