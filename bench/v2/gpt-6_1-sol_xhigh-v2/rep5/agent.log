{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypothesis_probe')\nrtl=Path('cores/bench/rtl')\nfor variant in ['block_add','flat_alu']:\n out=base/variant/'rtl'; out.mkdir(parents=True,exist_ok=True)\n for p in rtl.glob('*.sv'): shutil.copy2(p,out/p.name)\n p=out/'alu.sv'; s=p.read_text()\n if variant=='block_add':\n  insertion='''  logic subtract;\n  logic [31:0] b_eff, addsub_result;\n  logic [8:0] sum0 [0:3];\n  logic [7:0] sum1 [0:3];\n  logic [3:0] p_block, g_block;\n  logic [3:0] carry;\n  assign subtract = op == ALU_SUB;\n  assign b_eff = b \"'^ {32{subtract}};\n  assign carry[0] = subtract;\n  assign carry[1] = g_block[0] | (p_block[0] & subtract);\n  assign carry[2] = g_block[1] | (p_block[1] & g_block[0])\n                  | (p_block[1] & p_block[0] & subtract);\n  assign carry[3] = g_block[2] | (p_block[2] & g_block[1])\n                  | (p_block[2] & p_block[1] & g_block[0])\n                  | (p_block[2] & p_block[1] & p_block[0] & subtract);\n  for (genvar i=0; i<4; i++) begin : byte_add\n    assign sum0[i] = {1'\"'b0,a[i*8+:8]} + {1'b0,b_eff[i*8+:8]};\n    assign sum1[i] = a[i*8+:8] + b_eff[i*8+:8] + 8'd1;\n    assign p_block[i] = &(a[i*8+:8] \"'^ b_eff[i*8+:8]);\n    assign g_block[i] = sum0[i][8];\n    assign addsub_result[i*8+:8] = carry[i] ? sum1[i] : sum0[i][7:0];\n  end\n\n'\"'''\n  s=s.replace('  logic        [4:0]  shamt;',insertion+'  logic        [4:0]  shamt;')\n  s=s.replace('out = a + b;','out = addsub_result;').replace('out = a - b;','out = addsub_result;')\n else:\n  begin=s.index('  logic        [4:0]  shamt;')\n  ops=[('ALU_ADD','(a+b)'),('ALU_SUB','(a-b)'),('ALU_AND','(a&b)'),('ALU_OR','(a|b)'),('ALU_XOR','(a\"'^b)'\"'),('ALU_SLT',\\\"{31'b0, \"'$signed(a)<$signed(b)}\"),('\"'ALU_SLTU',\\\"{31'b0, a<b}\\\"),('ALU_SLL','(a << b[4:0])'),('ALU_SRL','(a >> b[4:0])'),('ALU_SRA','(\"'$unsigned($signed(a) >>> b[4:0]))'\"'),('ALU_LUI','b')]\n  s=s[:begin]+'  assign out = '+ '\\\\n             | '.join('('+val+' & {32{op == '+op+'}})' for op,val in ops)+';\\\\nendmodule\\\\n'\n p.write_text(s)\nprint('Created independent ignored RTL probes: block_add and flat_alu')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
