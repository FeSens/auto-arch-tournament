{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe/training_probe')\nrtl=root/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'if_stage.sv'\ns=p.read_text()\ns=s.replace('  logic [1:0] counters [0:31];','  logic [31:0] direction_q;\\\\n  logic [31:0] strength_q;\\\\n  logic event_valid_q, event_eligible_q, event_jump_q, event_taken_q, event_hit_q;\\\\n  logic [4:0] event_index_q;\\\\n  logic [24:0] event_tag_q;\\\\n  logic [29:0] event_target_q;\\\\n  logic probe_hit, probe_eligible;')\ns=s.replace('fetch_hit && counters[fetch_index][1]','fetch_hit && direction_q[fetch_index]')\nstart=s.index('  // Only validity needs reset.')\nend=s.index('  always_comb begin\\\\n    next_pc',start)\ns=s[:start]+'''  // Probe the ordered logical tag image including the event applied on\n  // this same edge. Counter state is read locally only at application.\n  assign probe_eligible = train_eligible && train_pc[1:0] == 2'b00 &&\n                          train_target[1:0] == 2'b00;\n  always_comb begin\n    probe_hit = train_hit;\n    if (event_valid_q && event_index_q == train_index) begin\n      if (event_eligible_q) probe_hit = event_tag_q == train_pc[31:7];\n      else if (event_hit_q) probe_hit = 1'b0;\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset) event_valid_q <= 1'b0;\n    else begin\n      event_valid_q <= train_valid;\n      if (train_valid) begin\n        event_index_q <= train_index;\n        event_tag_q <= train_pc[31:7];\n        event_target_q <= train_target[31:2];\n        event_eligible_q <= probe_eligible;\n        event_jump_q <= train_jump;\n        event_taken_q <= train_taken;\n        event_hit_q <= probe_hit;\n      end\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset) valid_q <= '0;\n    else if (event_valid_q) begin\n      if (event_eligible_q) begin\n        valid_q[event_index_q] <= 1'b1;\n        tags[event_index_q] <= event_tag_q;\n        targets[event_index_q] <= event_target_q;\n      end else if (event_hit_q) valid_q[event_index_q] <= 1'b0;\n    end\n  end\n  for (genvar i = 0; i < 32; i++) begin : g_direction\n    always_ff @(posedge clock) begin\n      if (\"'!reset && event_valid_q && event_index_q == 5'\"'(i) && event_eligible_q) begin\n        if (event_jump_q) begin\n          direction_q[i] <= 1'b1;\n          strength_q[i] <= 1'b1;\n        end else if (\"'!event_hit_q) begin\n          direction_q[i] <= event_taken_q;\n          strength_q[i] <= 1'\"'b0;\n        end else begin\n          direction_q[i] <= strength_q[i] ? direction_q[i] : event_taken_q;\n          strength_q[i] <= direction_q[i] == event_taken_q;\n        end\n      end\n    end\n  end\n\n''' + s[end:]\np.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
