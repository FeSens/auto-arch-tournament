{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nimport shutil, json, subprocess, concurrent.futures\nfrom tools.eval.gowin import build_all, summarize\nroot = Path('cores/bench/generated/hypothesis_probe')\nfor depth in (1, 4):\n    case = root / f'queue_{depth}'\n    rtl = case / 'rtl'\n    rtl.mkdir(parents=True, exist_ok=True)\n    for src in Path('cores/bench/rtl').glob('*.sv'):\n        shutil.copy2(src, rtl / src.name)\n    p = rtl / 'if_stage.sv'\n    s = p.read_text()\n    s = s[:s.index('  // Actual recovery overrides')] + f'''  if_id_t fetched, queue_q [0:{depth-1}];\n  logic [{depth.bit_length()-1}:0] count_q;\n  logic pop, push, accept_fetch;\n  assign pop = count_q \"'!= 0 && !stall;\n  assign accept_fetch = imem_ready && (count_q != {depth} || pop);\n  assign push = accept_fetch && !(count_q == 0 && !stall);\n  always_comb begin\n    fetched.pc = pc;\n    fetched.instr = imem_data;\n    fetched.prediction_selected = prediction_selected;\n    fetched.predicted_target = {{targets[fetch_index], 2'\"'b00}};\n    fetched.valid = imem_ready;\n    out = count_q \"'!= 0 ? queue_q[0] : fetched;\n    out.valid = (count_q != 0 || imem_ready) && !redirect;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      count_q <= 0;\n      for (int i = 0; i < {depth}; i++) queue_q[i] <= '\"'0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count_q <= 0;\n    end else begin\n      if (accept_fetch) pc <= next_pc;\n      if (pop) begin\n        for (int i = 0; i < {depth-1}; i++) queue_q[i] <= queue_q[i+1];\n      end\n      if (push) begin\n        queue_q[pop ? count_q-1'b1 : count_q] <= fetched;\n      end\n      case ({{push,pop}})\n        2'b01: count_q <= count_q - 1'b1;\n        2'b10: count_q <= count_q + 1'b1;\n        default: ;\n      endcase\n    end\n  end\n  assign imem_addr = pc;\nendmodule\n'''\n    p.write_text(s)\n    p = rtl / 'hazard_unit.sv'\n    s = p.read_text().replace('load_use_hazard || imem_stall || dmem_stall || execute_busy', 'load_use_hazard || dmem_stall || execute_busy')\n    s = s.replace('  logic imem_stall;\\\\n', '').replace('    imem_stall = \"'!imem_ready;'\"\\\\n', '')\n    p.write_text(s)\n    def simulate():\n        import os\n        env = dict(os.environ, RTL_DIR=str(rtl), OBJ_DIR=str(case/'obj'), NRET='1')\n        with (case/'build.log').open('w') as log:\n            build = subprocess.run(['bash', 'test/cosim/build.sh'], env=env, stdout=log, stderr=subprocess.STDOUT)\n        if build.returncode:\n            return {'build_failed': True}\n        with (case/'coremark_result.jsonl').open('w') as log, (case/'coremark_uart.txt').open('w') as err:\n            sim = subprocess.run([str(case/'obj/cosim_sim'), str(root/'coremark.elf'), '50000000', '--bench', '--istall', '--dstall'], stdout=log, stderr=err)\n        last = json.loads((case/'coremark_result.jsonl').read_text().splitlines()[-1])\n        return {'rc': sim.returncode, 'bracket_cycles': last['bench_stop_cycle']-last['bench_start_cycle'], 'oob': last['oob'], 'uart': last['uart']}\n    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as ex:\n        sim_future = ex.submit(simulate)\n        res = build_all(Path('.'), rtl, 'fpga/core_bench_si.sv', case / 'timing')\n        summary = summarize(res)\n        sim = sim_future.result()\n    (case/'result.json').write_text(json.dumps({'timing': summary, 'sim': sim, 'results': res}, indent=2))\n    if 'bracket_cycles' in sim:\n        summary['bracket_cycles'] = sim['bracket_cycles']\n        summary['fitness'] = 1e7 * summary['fmax_mhz'] / sim['bracket_cycles']\n    print(depth, json.dumps(summary), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
