{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypothesis_probe/r14_ex_carry_select')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(src,rtl/src.name)\np=rtl/'alu.sv'\ns=p.read_text()\nneedle='  logic        [4:0]  shamt;'\nassert needle in s\ns=s.replace(needle,needle+'''\n  logic subtract;\n  logic [31:0] add_b, add_result;\n  wire [8:0] sum0 [0:3];\n  wire [8:0] sum1 [0:3];\n  wire [3:0] g, p;\n  wire [3:0] carry;\n  assign subtract = op == ALU_SUB;\n  assign add_b = b \"'^ {32{subtract}};\n  for (genvar lane = 0; lane < 4; lane++) begin : g_carry_select\n    assign sum0[lane] = {1'\"'b0,a[8*lane +: 8]} + {1'b0,add_b[8*lane +: 8]};\n    assign sum1[lane] = {1'b0,a[8*lane +: 8]} + {1'b0,add_b[8*lane +: 8]} + 9'd1;\n    assign g[lane] = sum0[lane][8];\n    assign p[lane] = sum1[lane][8];\n    assign add_result[8*lane +: 8] = carry[lane] ? sum1[lane][7:0] : sum0[lane][7:0];\n  end\n  assign carry[0] = subtract;\n  assign carry[1] = g[0] | (p[0] & subtract);\n  assign carry[2] = g[1] | (p[1] & g[0]) | (p[1] & p[0] & subtract);\n  assign carry[3] = g[2] | (p[2] & g[1]) | (p[2] & p[1] & g[0]) |\n                    (p[2] & p[1] & p[0] & subtract);\n''')\ns=s.replace('ALU_ADD:    out = a + b;','ALU_ADD:    out = add_result;')\ns=s.replace('ALU_SUB:    out = a - b;','ALU_SUB:    out = add_result;')\np.write_text(s)\nprint(base)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
