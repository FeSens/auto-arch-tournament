{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl')\nscratch=Path('cores/bench/generated/research_banked_rf/rtl')\nscratch.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'):\n    shutil.copyfile(p,scratch/p.name)\n(scratch/'reg_file.sv').write_text('''// Structural timing experiment: independent flop words, one-hot read trees.\nmodule reg_file (\n input logic clock, reset,\n input logic [4:0] rs1_addr, rs2_addr,\n output logic [31:0] rs1_data, rs2_data,\n input logic w_en,\n input logic [4:0] w_addr,\n input logic [31:0] w_data\n);\n logic [31:0] sel1, sel2;\n wire [31:0] word_q [0:31];\n wire [31:0] bank1 [0:7], bank2 [0:7];\n assign sel1 = 32'b1 << rs1_addr;\n assign sel2 = 32'b1 << rs2_addr;\n assign word_q[0] = 32'b0;\n for (genvar r=1;r<32;r=r+1) begin:g_word\n   logic [31:0] storage_q;\n   always_ff @(posedge clock) begin\n     if(reset) storage_q <= 32'b0;\n     else if(w_en && w_addr == 5'(r)) storage_q <= w_data;\n   end\n   assign word_q[r] = storage_q;\n end\n for(genvar k=0;k<8;k=k+1) begin:g_bank\n   assign bank1[k] = (word_q[4*k] & {32{sel1[4*k]}})\n                   | (word_q[4*k+1] & {32{sel1[4*k+1]}})\n                   | (word_q[4*k+2] & {32{sel1[4*k+2]}})\n                   | (word_q[4*k+3] & {32{sel1[4*k+3]}});\n   assign bank2[k] = (word_q[4*k] & {32{sel2[4*k]}})\n                   | (word_q[4*k+1] & {32{sel2[4*k+1]}})\n                   | (word_q[4*k+2] & {32{sel2[4*k+2]}})\n                   | (word_q[4*k+3] & {32{sel2[4*k+3]}});\n end\n wire [31:0] read1 = bank1[0]|bank1[1]|bank1[2]|bank1[3]|bank1[4]|bank1[5]|bank1[6]|bank1[7];\n wire [31:0] read2 = bank2[0]|bank2[1]|bank2[2]|bank2[3]|bank2[4]|bank2[5]|bank2[6]|bank2[7];\n assign rs1_data = rs1_addr==0 ? 32'b0 : (w_en && w_addr==rs1_addr ? w_data : read1);\n assign rs2_data = rs2_addr==0 ? 32'b0 : (w_en && w_addr==rs2_addr ? w_data : read2);\nendmodule\n''')\nprint(scratch)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
