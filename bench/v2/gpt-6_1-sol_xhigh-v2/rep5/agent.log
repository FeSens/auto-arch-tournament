{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[14914 of 17986 chars elided by tools/bench/transcript.py; sha256:5c28e23c0f2db147]…\n     if r[\"placement_failed\"]:\ntools/eval/gowin.py:219:        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\ntools/eval/gowin.py:226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\ntools/eval/gowin.py:227:        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\ntools/eval/gowin.py:228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\ntools/eval/gowin.py:231:if __name__ == \"__main__\":\ntools/eval/gowin.py:232:    raise SystemExit(main())\n/srv/hwebench/tmp/9d6f718c/838283e5\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n cores/bench/rtl/core.sv        | 11 ++---\n cores/bench/rtl/core_pkg.sv    |  5 ++-\n cores/bench/rtl/ex_stage.sv    |  9 ++--\n cores/bench/rtl/hazard_unit.sv | 16 +++----\n cores/bench/rtl/id_stage.sv    |  1 +\n cores/bench/rtl/if_stage.sv    | 97 +++++++++++++++++++++++++++++++++++-------\n 6 files changed, 105 insertions(+), 34 deletions(-)\n", "exit_code": 0, "status": "completed"}}
