{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"sed -n '530,580p' cores/bench/test/test_pipeline.py\"","aggregated_output":"    assert dmem == {0: 5} and len(events) == 1\n    assert not any(r[\"trap\"] for r in rets)\n\n\n@cocotb.test()\nasync def predictor_counter_saturation_and_once_per_advance(dut):\n    # Hold one not-taken resolution behind a store. A repeated counter\n    # update would erase the taken prediction for the next visit. Later\n    # outcomes exercise saturation at both bounds and both weak states.\n    outcomes = [True, True, True, False, True, False, False, False,\n                False, True, True, True, True]\n    program = [ADDI(2, 0, 99), NOP(), ADDI(1, 0, 0), SW(2, 0, 4),\n               BEQ(1, 0, 16), ADDI(4, 4, 1), JAL(0, -16), SW(2, 0, 8),\n               ADDI(7, 7, 1), JAL(0, -28), EBREAK()]\n    state = {\"visits\": 0, \"hold\": 0, \"fetches\": 0}\n    def update(cycle, imem, rets):\n        state[\"visits\"] = len([r for r in rets if r[\"pc\"] == 16])\n        # A warmed loop can fetch its next iteration before the preceding\n        # branch retires. Supply each operand at its external fetch address.\n        if int(dut.io_imemAddr.value) == 8:\n            n = min(state[\"fetches\"], len(outcomes) - 1)\n            imem[8] = ADDI(1, 0, int(not outcomes[n]))\n            state[\"fetches\"] += 1\n            if n == len(outcomes) - 1:\n                imem[36] = JAL(0, 4)\n    def ready(cycle):\n        if state[\"visits\"] == 3 and int(dut.io_dmemWEn.value) and state[\"hold\"] < 7:\n            state[\"hold\"] += 1\n            return (1, 0)\n        return (1, 1)\n    events = []\n    rets, dmem = await _run(dut, program, max_cycles=200, imem_update=update,\n                           ready=ready, bus_events=events)\n    expected = [0, 4]\n    for taken in outcomes:\n        expected += [8, 12, 16] + ([32, 36] if taken else [20, 24])\n    expected += [40]\n    _check_flow(rets, expected)\n    branches = [r for r in rets if r[\"pc\"] == 16]\n    assert [r[\"rs1_rdata\"] for r in branches] == [int(not t) for t in outcomes]\n    expected_gaps = [2, 1, 1, 2, 1, 2, 2, 1, 1, 2, 2, 1, 1]\n    for branch, gap in zip(branches, expected_gaps):\n        i = rets.index(branch)\n        assert rets[i + 1][\"cycle\"] == branch[\"cycle\"] + gap\n    assert state[\"hold\"] == 7\n    assert dmem == {4: 99} and len(events) == len(outcomes)\n\n\n@cocotb.test()\nasync def predictor_warm_jal_links(dut):\n    program = [ADDI(1, 0, 0), ADDI(2, 0, 8), ADDI(1, 1, 1), JAL(5, 8),\n","exit_code":0,"status":"completed"}}
