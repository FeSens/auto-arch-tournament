{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom array import array\nfrom collections import Counter\nimport json\ntrace=array('I')\nwith open('/srv/hwebench/tmp/9d6f718c/bd97f927/r14s2/controls.bin','rb') as f: trace.frombytes(f.read())\nevents=list(zip(*[iter(trace)]*5))\nfor bits,fold,tagged,policy in [(5,False,True,'baseline'),(5,False,False,'tagless'),(5,True,False,'tagless'),(6,False,False,'tagless'),(6,True,False,'tagless'),(7,False,False,'tagless'),(7,True,False,'tagless'),(8,True,False,'tagless')]:\n mask=(1<<bits)-1;rows=[None]*(1<<bits);misses=Counter();targetmiss=Counter();total=0\n for pc,insn,npc,target,marked in events:\n  op=insn&127;jump=op\"'!=0x63;taken=jump or npc!=pc+4\n  index=((pc>>2)''^((pc>>(2+bits)) if fold else 0))&mask\n  row=rows[index];hit=row is not None and (not tagged or row[0]==pc)\n  selected=hit and row[1]>=2\n  miss=selected!=taken or taken and (not hit or row[2]!=target)\n  if marked and miss: misses[op]+=1\n  if marked and selected and taken and row[2]!=target: targetmiss[op]+=1\n  if marked: total+=1\n  if tagged:\n   counter=3 if jump else min(3,row[1]+1) if hit and taken else max(0,row[1]-1) if hit else 2 if taken else 1\n   rows[index]=(pc,counter,target)\n  elif jump:rows[index]=(pc,3,target)\n  elif taken:rows[index]=(pc,min(3,row[1]+1) if hit else 2,target)\n  elif hit:rows[index]=(row[0],max(0,row[1]-1),row[2])\n print(json.dumps({'\"'entries':1<<bits,'hash':fold,'policy':policy,'misses':sum(misses.values()),'conditional':misses[0x63],'jal':misses[0x6f],'jalr':misses[0x67],'wrong_target':sum(targetmiss.values()),'controls':total}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
