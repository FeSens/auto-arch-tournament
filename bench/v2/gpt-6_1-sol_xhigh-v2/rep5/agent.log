{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Completion acceptance, capture, and drain bubbles under direct EX stalls.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_MUL, ALU_DIVU, run_cocotb\n\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"prediction_selected\", 1), (\"predicted_target\", 32),\n         (\"direct_target\", 32), (\"direct_target_match\", 1),\n         (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, values):\n    packed = 0\n    for name, width in layout:\n        packed = (packed << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return packed\n\n\ndef _unpack(layout, packed):\n    values = {}\n    for name, width in reversed(layout):\n        values[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    return values\n\n\ndef _drive(dut, values):\n    getattr(dut, \"in\").value = _pack(ID_EX, values)\n    ctrl = _unpack(CTRL, values.get(\"ctrl\", 0))\n    dut.alu_a_sel.value = 0b1000 if ctrl[\"is_auipc\"] else 0b0001\n    dut.alu_b_sel.value = 0b1000 if ctrl[\"alu_src\"] else 0b0001\n\n\nasync def _cycle(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    assert len(getattr(dut, \"in\")) == 264 and len(dut.out) == 295\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value\n…[10288 of 13360 chars elided by tools/bench/transcript.py; sha256:53882843b96ab34c]…\n          dut.alu_b_sel.value = 0b1000\n                dut.fwd_ex_mem.value = 0xFFFFFFFF\n                dut.fwd_mem_wb.value = 0x80000000\n                for _ in range(40):\n                    await _cycle(dut)\n                    assert int(dut.out.value) == 0 and int(dut.execute_busy.value)\n                    assert not int(dut.train_valid.value)\n                dut.stall.value = 0\n                await _cycle(dut)\n                result = _unpack(EX_MEM, int(dut.out.value))\n                assert result[\"valid\"] and result[\"pc\"] == 0x80\n                assert (result[\"rs1_val\"], result[\"rs2_val\"]) == (a, b)\n                assert result[\"alu_result\"] == (a * b if op == ALU_MUL else a // b)\n                _drive(dut, {})\n                await _cycle(dut)\n                assert int(dut.out.value) == 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
