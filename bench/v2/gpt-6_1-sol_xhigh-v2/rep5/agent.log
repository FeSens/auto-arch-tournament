rst paths (placement option 0)\"\n85:\t@echo \"  make next TARGET=v1     — one orchestrator round\"\n86:\t@echo \"  make loop TARGET=v1 N=10 — N orchestrator rounds (auto-spawns .worktrees/<TARGET> on branch core-<TARGET>; pass WORKTREE= to opt out)\"\n87:\t@echo \"  make report TARGET=v1   — per-core experiment summary\"\n88:\t@echo \"  make \n…[8347 of 11419 chars elided by tools/bench/transcript.py; sha256:614623068ecc0ac0]…\n      ctrl=_pack(CTRL, dict(alu_op=ALU_ADD, reg_write=1)))\n    for s1, (a, _) in candidates.items():\n        for s2, (_, b) in candidates.items():\n            _drive(dut, dict(instruction, rs1_val=a, rs2_val=b))\n            await Timer(1, \"ns\")\n            assert int(dut.next_rd.value) == 3 and int(dut.next_w_en.value)\n            assert int(dut.next_data.value) == (a + b) & 0xFFFFFFFF\n            await _cycle(dut)\n            result = _unpack(EX_MEM, int(dut.out.value))\n            assert (result[\"rs1_val\"], result[\"rs2_val\"], result[\"write_data\"]) == (a, b, b)\n            assert result[\"alu_result\"] == (a + b) & 0xFFFFFFFF\n\n    held = int(dut.out.value)\n    dut.stall.value = 1\n    _drive(dut, dict(instruction, rd=19))\n    await Timer(1, \"ns\")\n    assert int(dut.next_rd.value) == 3 and int(dut.next_w_en.value)\n    await _cycle(dut)\n    assert int(dut.out.value) == held\n    dut.stall.value = 0\n    _drive(dut, {})\n    await Timer(1, \"ns\")\n    assert int(dut.next_rd.value) == 0 and not int(dut.next_w_en.value)\n", "exit_code": 0, "status": "completed"}}
