{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/forward_unit.sv; sed -n '65,155p' cores/bench/rtl/core_pkg.sv; sed -n '1,160p' cores/bench/rtl/id_stage.sv\"", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Operand forwarding. For each rs in the EX-stage's source list, picks\n// where the freshest value lives:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic [4:0] id_ex_rs1,\n  input  logic [4:0] id_ex_rs2,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs1) fwd_rs1 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs1) fwd_rs1 = 2'd2;\n    else                                                                  fwd_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 2'd2;\n    else                                                                  fwd_rs2 = 2'd0;\n  end\n\nendmodule\n    logic       mem_write;\n    logic [1:0] mem_width;   // 0 = byte, 1 = half, 2 = word\n    logic       mem_sext;    // sign-extend load result\n    logic       reg_write;\n    logic       mem_to_reg;  // 1 = write loaded data, 0 = write ALU result\n    logic       is_illegal;  // default-true in decoder; cleared inside\n                              // validated opcode/funct arms only.\n  } ctrl_t;\n\n  // IF -> ID combinational bundle (no register; PC reg sits in if_stage).\n  typedef struct packed {\n    \n…[5044 of 8116 chars elided by tools/bench/transcript.py; sha256:6b3609bcc7826caf]…\ng = dec_mem_to_reg;\n    ctrl_decoded.is_illegal = dec_is_illegal;\n  end\n\n  // ── ID/EX register ──────────────────────────────────────────────────────\n  id_ex_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (!stall) begin\n      if (!in.valid) begin\n        reg_q <= '0;\n      end else begin\n        reg_q.pc       <= in.pc;\n        reg_q.prediction_selected <= in.prediction_selected;\n        reg_q.predicted_target <= in.predicted_target;\n        reg_q.direct_target <= direct_target;\n        reg_q.direct_target_match <= direct_target == in.predicted_target;\n        reg_q.rs1_val  <= rs1_data;\n        reg_q.rs2_val  <= rs2_data;\n        reg_q.imm      <= imm;\n        reg_q.rd       <= in.instr[11:7];\n        reg_q.rs1_addr <= in.instr[19:15];\n        reg_q.rs2_addr <= in.instr[24:20];\n        reg_q.ctrl     <= ctrl_decoded;\n        reg_q.instr    <= in.instr;\n        reg_q.valid    <= in.valid;\n      end\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
