{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _bundle(packed, layout):\n    values = {}\n    for name, width in reversed(layout):\n        values[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    assert packed == 0\n    return values\n\n\n_ID_LAYOUT = [(\"pc\", 32), (\"prediction_selected\", 1), (\"predicted_target\", 32),\n              (\"direct_target\", 32), (\"direct_target_match\", 1),\n              (\"rs1_val\", 32), (\"rs2_val\", 32), (\"alu_a_val\", 32), (\"alu_b_val\", 32),\n              (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n              (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n_EX_LAYOUT = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n              (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n              (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n              (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n              (\"instr\", 32), (\"valid\", 1)]\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef\n…[69353 of 72425 chars elided by tools/bench/transcript.py; sha256:5d14db4c389f585a]…\nrun(dut, program, pipeline_events=snapshots)\n    _check_linear(rets, program)\n    assert all(b[\"cycle\"] == a[\"cycle\"] + 1 for a, b in zip(rets, rets[1:]))\n    assert dmem == {300: 5}\n    training = [s for s in snapshots if s[\"train\"]][:len(rets)]\n    assert [s[\"train_pc\"] for s in training] == [0, 4, 8, 12, 16, 20]\n    assert [s[\"cycle\"] for s in training] == list(range(training[0][\"cycle\"], training[0][\"cycle\"] + 6))\n    assert [(s[\"eligible\"], s[\"taken\"], s[\"train_target\"]) for s in training[1:3]] == [(1, 0, 20), (1, 0, 24)]\n    assert not any(s[\"redirect\"] for s in snapshots)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
