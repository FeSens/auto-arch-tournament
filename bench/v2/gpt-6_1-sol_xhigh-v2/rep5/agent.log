{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build_all\nwt=Path.cwd()\nfor variant in ['unified_wb','flat_operands']:\n base=wt/'cores/bench/generated/hypothesis_probe'/variant\n results=build_all(wt,base/'rtl','fpga/core_bench_si.sv',base/'timing',options=(0,))\n (base/'results.json').write_text(json.dumps(results,indent=2))\n print(variant,json.dumps(results),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
