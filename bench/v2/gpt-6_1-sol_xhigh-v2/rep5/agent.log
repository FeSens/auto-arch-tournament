{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p cores/bench/generated/hypothesis_probe/r12_balanced_execution\npython3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl');dst=Path('cores/bench/generated/hypothesis_probe/r12_balanced_execution/rtl');shutil.copytree(src,dst,dirs_exist_ok=True)\np=dst/'core_pkg.sv';s=p.read_text().replace('    logic [31:0] alu_b_val;', '''    logic [8:0] add_c0;\n    logic [8:0] add_c1_0, add_c1_1;\n    logic [8:0] add_c2_0, add_c2_1;\n    logic [8:0] add_c3_0, add_c3_1;\n    logic [31:0] alu_b_val;''');p.write_text(s)\np=dst/'id_stage.sv';s=p.read_text().replace('  output decoded_t          decoded,', '''  output decoded_t          decoded,\n  input logic [31:0] early_rf_rs1, early_rf_rs2,\n  input logic wb_w_en,\n  input logic [4:0] wb_w_addr,\n  input logic [31:0] wb_w_data,\n  output logic [31:0] rf_base_rs1, rf_base_rs2,''')\ns=s.replace('  decoded_t decoded_q;', '''  decoded_t decoded_q;\n  logic [31:0] rf_snapshot1_q, rf_snapshot2_q;\n  always_ff @(posedge clock) begin\n    if (reset || squash) begin\n      rf_snapshot1_q <= '0;\n      rf_snapshot2_q <= '0;\n    end else if (\"'!stall) begin\n      rf_snapshot1_q <= early_rf_rs1;\n      rf_snapshot2_q <= early_rf_rs2;\n    end else begin\n      if (wb_w_en && wb_w_addr == decoded_q.rs1_addr && wb_w_addr != 0)\n        rf_snapshot1_q <= wb_w_data;\n      if (wb_w_en && wb_w_addr == decoded_q.rs2_addr && wb_w_addr != 0)\n        rf_snapshot2_q <= wb_w_data;\n    end\n  end\n  assign rf_base_rs1 = decoded_q.rs1_addr == 0 ? 32'\"'b0 :\n    (wb_w_en && wb_w_addr == decoded_q.rs1_addr ? wb_w_data : rf_snapshot1_q);\n  assign rf_base_rs2 = decoded_q.rs2_addr == 0 ? 32'b0 :\n    (wb_w_en && wb_w_addr == decoded_q.rs2_addr ? wb_w_data : rf_snapshot2_q);''')\ns=s.replace('  // EX consumes complete, stable flops, including during blocking work.', '''  logic arithmetic_sub;\n  logic [31:0] arithmetic_b;\n  assign arithmetic_sub = decoded_q.ctrl.alu_op == ALU_SUB ||\n                          decoded_q.ctrl.alu_op == ALU_SLT ||\n                          decoded_q.ctrl.alu_op == ALU_SLTU;\n  assign arithmetic_b = complete_alu_b \"'^ {32{arithmetic_sub}};\n  // EX consumes complete, stable flops, including during blocking work.'\"''')\nextra=''\nfor i in range(4):\n lo=i*8;hi=lo+7\n if i==0: extra+=f\\\"          reg_q.add_c0 <= {{1'b0, complete_alu_a[{hi}:{lo}]}} + {{1'b0, arithmetic_b[{hi}:{lo}]}} + {{8'b0, arithmetic_sub}};\\\\n\\\"\n else:\n  for c in range(2): extra+=f\\\"          reg_q.add_c{i}_{c} <= {{1'b0, complete_alu_a[{hi}:{lo}]}} + {{1'b0, arithmetic_b[{hi}:{lo}]}} + 9'd{c};\\\\n\\\"\ns=s.replace('          reg_q.alu_b_val <= complete_alu_b;','          reg_q.alu_b_val <= complete_alu_b;\\\\n'+extra);p.write_text(s)\np=dst/'ex_stage.sv';s=p.read_text().replace('  logic [31:0] alu_result, div_result, mul_result;', '''  logic [31:0] alu_result, fast_alu_result, div_result, mul_result;\n  logic [8:0] selected_c1, selected_c2, selected_c3;\n  logic [31:0] arithmetic_result;\n  assign selected_c1 = in.add_c0[8] ? in.add_c1_1 : in.add_c1_0;\n  assign selected_c2 = selected_c1[8] ? in.add_c2_1 : in.add_c2_0;\n  assign selected_c3 = selected_c2[8] ? in.add_c3_1 : in.add_c3_0;\n  assign arithmetic_result = {selected_c3[7:0], selected_c2[7:0], selected_c1[7:0], in.add_c0[7:0]};\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_ADD, ALU_SUB: alu_result = arithmetic_result;\n      ALU_SLT: alu_result = {31'b0, in.alu_a_val[31] \"'!= in.alu_b_val[31] ? in.alu_a_val[31] : arithmetic_result[31]};\n      ALU_SLTU: alu_result = {31'\"'b0, \"'!selected_c3[8]};\n      default: alu_result = fast_alu_result;\n    endcase\n  end'\"''').replace('.out(alu_result), .div_busy(div_busy)', '.out(fast_alu_result), .div_busy(div_busy)');p.write_text(s)\np=dst/'core.sv';s=p.read_text().replace('  logic [31:0] rs2_data_w;', '  logic [31:0] rs2_data_w;\\\\n  logic [31:0] rf_base_rs1_w, rf_base_rs2_w;')\ns=s.replace('.decoded  (decoded_w),', '''.decoded  (decoded_w),\n    .early_rf_rs1(rs1_data_w), .early_rf_rs2(rs2_data_w),\n    .wb_w_en(wb_w_en), .wb_w_addr(wb_w_addr), .wb_w_data(wb_w_data),\n    .rf_base_rs1(rf_base_rs1_w), .rf_base_rs2(rf_base_rs2_w),''')\nstart=s.index('  reg_file u_rf (');end=s.index('  // ── EX',start)\na=s[start:end].replace('.rs1_addr (rs1_addr_w)', '.rs1_addr (if_id_w.instr[19:15])').replace('.rs2_addr (rs2_addr_w)', '.rs2_addr (if_id_w.instr[24:20])');s=s[:start]+a+s[end:]\ns=s.replace('.base_rs1(rs1_data_w), .base_rs2(rs2_data_w)', '.base_rs1(rf_base_rs1_w), .base_rs2(rf_base_rs2_w)');p.write_text(s)\nprint('Balanced decoded-RF/partial-arithmetic/EX execution scratch written.')\nPY\nRTL_DIR=cores/bench/generated/hypothesis_probe/r12_balanced_execution/rtl OBJ_DIR=cores/bench/generated/hypothesis_probe/r12_balanced_execution/obj_dir NRET=1 bash test/cosim/build.sh > cores/bench/generated/hypothesis_probe/r12_balanced_execution/cosim_build.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
