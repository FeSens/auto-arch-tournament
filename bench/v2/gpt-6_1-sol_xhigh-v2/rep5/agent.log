{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport yaml,json,jsonschema\np=Path('cores/bench/experiments/hypotheses/hyp-20261002-001-r5s0.yaml')\nd=yaml.safe_load(p.read_text())\nd['expected_impact']['fitness_delta_pct']=5\nold='Median placement timing is still pending; option 0 is not the score.'\nnew='''All three vendor placements complete at [65.265, 67.366, 67.366]\nMHz, for a 67.366 MHz median. With the identical measured CoreMark\ncycles, exploratory fitness is 152.77 iterations/second: 5.48 percent\nabove the 144.84 champion, exceeding the 4.6 percent acceptance margin.\nThis is prototype timing and simulation evidence, not a formal-gated\nacceptance result. The narrow margin makes faithful reconstruction and\nall three vendor placements necessary.'''\nassert old in d['hypothesis']\nd['hypothesis']=d['hypothesis'].replace(old,new)\nclass LiteralDumper(yaml.SafeDumper): pass\ndef rep(dumper,s): return dumper.represent_scalar('tag:yaml.org,2002:str',s,style='|' if '\\\\n' in s else None)\nLiteralDumper.add_representer(str,rep)\np.write_text(yaml.dump(d,Dumper=LiteralDumper,sort_keys=False,width=88))\njsonschema.validate(yaml.safe_load(p.read_text()),json.load(open('schemas/hypothesis.schema.json')))\nassert d['id']=='hyp-20261002-001-r5s0' and d['category']=='micro_opt'\nassert type(d['expected_impact']['fitness_delta_pct']) is int\nassert -50<=d['expected_impact']['fitness_delta_pct']<=50\nfitness=67.366e6*10/4409538\nprint('Schema valid:',p)\nprint('Predicted fitness:',round(fitness,2),'delta:',round((67.366/63.869-1)*100,2),'percent')\nprint('Bytes:',p.stat().st_size)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
