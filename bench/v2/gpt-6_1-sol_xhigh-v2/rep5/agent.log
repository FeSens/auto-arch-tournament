{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypothesis_probe/jalr_verify')\nrtl=base/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'ex_stage.sv'; s=p.read_text()\ns=s.replace('logic recovery_q, recovery_d;', 'logic recovery_q, recovery_d;\\\\n  logic fast_predicted_jalr, verify_jalr_q;\\\\n  logic [31:0] verify_prediction_q;')\ns=s.replace('assign is_blocking = is_div || is_mul || in.ctrl.is_jalr;', '''assign fast_predicted_jalr = in.ctrl.is_jalr && \"'!in.ctrl.is_illegal && in.prediction_selected;\n  assign is_blocking = is_div || is_mul || (in.ctrl.is_jalr && !fast_predicted_jalr);'\"''')\ns=s.replace('completed_payload = pending_payload_q;', 'if (fast_predicted_jalr) fast_recovery = 1\\\\'b0;\\\\n    completed_payload = pending_payload_q;')\ns=s.replace('(\"'!in.ctrl.is_jump || in.direct_target[1:0] == 2'\"\\\\'b00);', '(\"'!in.ctrl.is_jump || (in.ctrl.is_jalr ? !alu_result[1] : in.direct_target[1:0] == 2'\"\\\\'b00));')\ns=s.replace(\\\"recovery_q <= 1'b0;\\\", \\\"recovery_q <= 1'b0;\\\\n      verify_jalr_q <= 1'b0;\\\\n      verify_prediction_q <= '0;\\\",1)\ns=s.replace('recovery_q <= recovery_d;', '''recovery_q <= recovery_d;\n      if (\"'!stall) begin\n        verify_jalr_q <= fast_emit && fast_predicted_jalr;\n        verify_prediction_q <= in.predicted_target;\n      end'\"''')\ns=s.replace('assign redirect = train_valid && recovery_q;', '''assign redirect = train_valid && (recovery_q ||\n                    (verify_jalr_q && (reg_q.ctrl.is_illegal ||\n                     reg_q.branch_target \"'!= verify_prediction_q)));'\"''')\np.write_text(s)\nprint(base)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
