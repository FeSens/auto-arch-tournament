{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"sed -n '85,205p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await _tick(dut)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        if imem_update is not None:\n            imem_update(cycle, imem, retirements)\n        if cycle == reset_cycle:\n            dut.reset.value = 1\n            await _tick(dut)\n            dut.reset.value = 0\n            assert not int(dut.io_rvfi_valid_0.value)\n            assert not int(dut.io_dmemWEn.value)\n            assert not int(dut.io_dmemREn.value)\n            program = after_reset\n            imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n            retirements.clear()\n        iready, dready = ready(cycle) if ready else (1, 1)\n        dut.io_imemReady.value = iready\n        dut.io_dmemReady.value = dready\n        ia        = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())\n        await Timer(1, \"ns\")\n        da        = int(dut.io_dmemAddr.value)\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        await Timer(1, \"ns\")\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen and dready:\n            wdata = int(dut.io_dmemWData.value)\n  \n…[1797 of 4869 chars elided by tools/bench/transcript.py; sha256:121e0559a74ac1b6]…\n else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _check_linear(rets, program):\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert all(r[\"pc_next\"] == r[\"pc\"] + 4 and not r[\"trap\"] for r in rets)\n\n\ndef _check_flow(rets, expected_pcs=None):\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert all(a[\"pc_next\"] == b[\"pc\"] for a, b in zip(rets, rets[1:])), rets\n    if expected_pcs is not None:\n        actual = [r[\"pc\"] for r in rets]\n        assert actual == expected_pcs, f\"PC sequence {actual}, expected {expected_pcs}\"\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
