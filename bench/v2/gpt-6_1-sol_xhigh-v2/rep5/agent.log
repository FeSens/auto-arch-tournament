{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '215,425p' cores/bench/test/test_ex_stage.py; cat cores/bench/test/_helpers.py; sed -n '1,240p' tools/eval/gowin.py\"", "aggregated_output": "\n@cocotb.test()\nasync def complete_alu_choices_preserve_raw_operands(dut):\n    await _setup(dut)\n    candidates = {0b001: (0x12345678, 0x31415926),\n                  0b010: (0x87654321, 0x87654321),\n                  0b100: (0xDEADBEEF, 0xDEADBEEF)}\n    for s1, (raw_a, _) in candidates.items():\n        for s2, (_, raw_b) in candidates.items():\n            for pc_source in (False, True):\n                for imm_source in (False, True):\n                    instruction = dict(\n                        pc=0x40, imm=0xFFFFF080, rs1_val=raw_a,\n                        rs2_val=raw_b, rs1_addr=1, rs2_addr=2, rd=3,\n                        instr=0x002081B3, valid=1,\n                        ctrl=_pack(CTRL, dict(alu_op=ALU_ADD, reg_write=1,\n                                             is_auipc=int(pc_source), alu_src=int(imm_source))))\n                    _drive(dut, instruction)\n                    await _cycle(dut)\n                    result = _unpack(EX_MEM, int(dut.out.value))\n                    a = instruction[\"pc\"] if pc_source else raw_a\n                    b = instruction[\"imm\"] if imm_source else raw_b\n                    assert result[\"alu_result\"] == (a + b) & 0xFFFFFFFF\n                    assert (result[\"rs1_val\"], result[\"rs2_val\"], result[\"write_data\"]) == (\n                        raw_a, raw_b, raw_b)\n\n\n@cocotb.test()\nasync def m_extension_captures_complete_alu_choices_once(dut):\n    # Both blocking units must sample the chosen sources at launch, then\n    # ignore subsequent selector/data changes while completion is held.\n    for op in (ALU_MUL, ALU_DIVU):\n        for s1, a in ((0b0001, 81), (0b0010, 63), (0b0100, 9)):\n            for s2, b in ((0b0001, 7), (0b0010