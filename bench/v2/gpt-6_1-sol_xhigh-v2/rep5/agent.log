{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hypothesis_probe/r14_capture_controls/test/test_pipeline.py')\ns=p.read_text()\nneedle='        assert int(dut.capture_pending_owner.value) == int(dut.u_ex.pending_q.value)'\nassert needle in s\ns=s.replace(needle, '''        decoded = _bundle(int(dut.u_id.decoded.value), _DEC_LAYOUT)\n        if decoded[\\\"valid\\\"] and not int(dut.u_id.flush.value) and not int(dut.u_id.hold_ex.value):\n            producers = [int(dut.u_ex.fast_producer.value),\n                         int(dut.u_ex.link_producer.value),\n                         int(dut.u_ex.completed_producer.value)]\n            event_flags = [int(dut.u_ex.fast_emit.value) and not int(dut.u_ex.link_emit.value),\n                           int(dut.u_ex.link_emit.value), int(dut.u_ex.completed_emit.value)]\n            memory = int(dut.u_mem.accepted_producer.value)\n            references = []\n            for source_number in range(2):\n                addr = decoded[\\\"rs1_addr\\\" if source_number == 0 else \\\"rs2_addr\\\"]\n                provenance_ex = (decoded[\\\"provenance\\\"] >> (3-source_number)) & 1\n                provenance_mem = (decoded[\\\"provenance\\\"] >> (1-source_number)) & 1\n                enabled = [bool(event and ((producer >> 32) & 1) and provenance_ex and addr)\n                           for event, producer in zip(event_flags, producers)]\n                mem_enabled = (not int(dut.hold_mem_wb.value) and ((memory >> 32) & 1)\n                               and provenance_mem and not any(enabled) and addr)\n                value = 0\n                for enable, producer in zip(enabled, producers):\n                    if enable: value |= producer & 0xFFFFFFFF\n                if mem_enabled: value |= memory & 0xFFFFFFFF\n                if not any(enabled) and not mem_enabled and addr:\n                    value = int(getattr(dut,\\\"rs1_data_w\\\" if source_number==0 else \\\"rs2_data_w\\\").value)\n                references.append(value)\n            assert int(dut.resolved_rs1.value) == references[0]\n            assert int(dut.resolved_rs2.value) == references[1]\n            assert int(dut.complete_alu_a.value) == (decoded[\\\"pc\\\"] if decoded[\\\"ctrl\\\"] & (1<<8) else references[0])\n            assert int(dut.complete_alu_b.value) == (decoded[\\\"imm\\\"] if decoded[\\\"ctrl\\\"] & (1<<16) else references[1])\n''' + needle)\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
