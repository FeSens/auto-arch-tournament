{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nE=[]\nfor l in Path('cores/bench/sim_build/predictor_probe/profile.txt').open():\n if l.startswith('PROBE '):\n  _,pc,insn,target,j,t,r=l.split(); E.append((int(pc,16),int(target,16),int(j),int(t)))\nfor btb_n in (32,128):\n for hn,hbits,pn in ((32,8,512),(128,8,512),(128,8,1024),(128,10,1024),(256,8,1024)):\n  btb={}; lht={}; pht={}; stats=Counter()\n  for pc,target,j,t in E:\n   bi=(pc>>2)&(btb_n-1); hi=(pc>>2)&(hn-1)\n   old=lht.get(hi,(None,0)); hist=old[1] if old[0]==pc else 0\n   pi=((pc>>2)\"'^hist)&(pn-1); c=pht.get(pi,1)\n   e=btb.get(bi); hit=e is not None and e[0]==pc\n   selected=hit and (j or c>=2)\n   missed=selected!=bool(t) or bool(t) and (not hit or e[1]!=target)\n   stats['\"'jump' if j else 'branch']+=missed\n   btb[bi]=(pc,target)\n   if not j:\n    pht[pi]=min(3,c+1) if t else max(0,c-1)\n    lht[hi]=(pc,((hist<<1)|t)&((1<<hbits)-1))\n  print('BTB',btb_n,'LHT',hn,'hist',hbits,'PHT',pn,'misses',sum(stats.values()),dict(stats))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
