rite) && lsu_misalign;\n    end\n  end\n  assign memory_request = lsu_q;\n  assign out = reg_q;'\"''')\n(p/'rtl/ex_stage.sv').write_text(s)\ns=(p/'rtl/core.sv').read_text()\ns=s.replace('  ex_mem_t ex_mem_w;','  ex_mem_t ex_mem_w;\\\\n  lsu_request_t lsu_request;')\ns=s.replace('    .out             (ex_mem_w),','    .out             (ex_mem_w),\\\\n    .memory_request  (lsu_request),')\ns=s.replace('    .in         (ex_mem_w),','    .in         (ex_mem_w),\\\\n    .memory_request(lsu_request),')\n(p/'rtl/core.sv').write_text(s)\ns=(p/'rtl/mem_stage.sv').read_text()\ns=s.replace('  input  ex_mem_t  in,','  input  ex_mem_t  in,\\\\n  input lsu_request_t memory_request,')\nstart=s.index('    // Byte/halfword replication for stores.')\nend=s.index('\\\\n    ctrl_with_trap = in.ctrl;',start)\ns=s[:start]+'''    wdata_rep = memory_request.wdata;\n    byte_mask = memory_request.mask;\n    mem_op = in.valid && (in.ctrl.mem_read || in.ctrl.mem_write);\n    mem_misalign = memory_request.misalign;\n'''+s[end:]\ns=s.replace('dmem_addr  = in.alu_result;','dmem_addr  = memory_request.addr;')\ns=s.replace('dmem_wen   = (in.valid && \"'!reset && in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'\"\\\\'b0000;',\\\"dmem_wen   = memory_request.wen && \"'!reset ? byte_mask : 4'\"'b0000;\\\")\ns=s.replace('dmem_ren   = in.valid && \"'!reset && in.ctrl.mem_read && !mem_misalign;'\"','dmem_ren   = memory_request.ren && \"'!reset;'\"')\ns=s.replace('(in.alu_result[1:0] * 8)','(memory_request.addr[1:0] * 8)')\ns=s.replace('{in.alu_result[31:2], 2\\\\'b00}',\\\"{memory_request.addr[31:2], 2'b00}\\\")\n(p/'rtl/mem_stage.sv').write_text(s)\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
