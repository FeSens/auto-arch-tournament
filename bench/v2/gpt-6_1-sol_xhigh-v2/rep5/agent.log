{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nimport shutil, json\nroot = Path('cores/bench/generated/hypothesis_probe')\nfor bits in (4, 3, 2):\n    entries = 1 << bits\n    case = root / f'compact_{entries}'\n    rtl = case / 'rtl'\n    rtl.mkdir(parents=True, exist_ok=True)\n    for src in Path('cores/bench/rtl').glob('*.sv'):\n        shutil.copy2(src, rtl / src.name)\n    p = rtl / 'if_stage.sv'\n    s = p.read_text()\n    for a, b in {\n        'logic [31:0] valid_q': f'logic [{entries-1}:0] valid_q',\n        'logic [24:0] tags [0:31]': f'logic [{29-bits}:0] tags [0:{entries-1}]',\n        'targets [0:31]': f'targets [0:{entries-1}]',\n        'counters [0:31]': f'counters [0:{entries-1}]',\n        'logic [4:0] fetch_index, train_index': f'logic [{bits-1}:0] fetch_index, train_index',\n        'pc[6:2]': f'pc[{bits+1}:2]',\n        'pc[31:7]': f'pc[31:{bits+2}]',\n    }.items():\n        assert a in s, a\n        s = s.replace(a, b)\n    p.write_text(s)\n    res = build_all(Path('.'), rtl, 'fpga/core_bench_si.sv', case / 'timing')\n    summary = summarize(res)\n    (case / 'timing_result.json').write_text(json.dumps({'summary': summary, 'results': res}, indent=2))\n    print(entries, json.dumps(summary), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nimport sys, json, struct\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\ncpu = RV32IM()\ncpu.load_elf('cores/bench/generated/hypothesis_probe/coremark.elf')\nmodels = {n: [None] * n for n in (4, 8, 16, 32, 64)}\nwrong = {n: 0 for n in models}\ncontrols = 0\nbaseline = 0\nin_markers = False\nmax_pc = 0\nout_region = 0\nbracket_insns = 0\nfor step in range(10_000_000):\n    r = cpu.step()\n    pc, insn, npc = r['pc'], r['insn'], r['npc']\n    max_pc = max(max_pc, pc)\n    if r['mem_wmask'] and r['mem_addr'] == 0x10000100:\n        in_markers = True\n    if r['mem_wmask'] and r['mem_addr'] == 0x10000104:\n        in_markers = False\n    if in_markers:\n        bracket_insns += 1\n    op = insn & 127\n    if not r['trap'] and op in (0x63, 0x6f, 0x67):\n        jump = op \"'!= 0x63\n        taken = jump or npc != ((pc + 4) & 0xffffffff)\n        if op == 0x63:\n            imm = ((insn >> 31) << 12) | (((insn >> 7) & 1) << 11) | (((insn >> 25) & 63) << 5) | (((insn >> 8) & 15) << 1)\n            if imm & 4096: imm -= 8192\n            target = (pc + imm) & 0xffffffff\n        else:\n            target = npc\n        if pc >= 0x100000 or target >= 0x100000:\n            out_region += 1\n        if in_markers:\n            controls += 1\n            baseline += taken\n        for n, table in models.items():\n            index = (pc >> 2) & (n - 1)\n            old = table[index]\n            hit = old is not None and old[0] == pc\n            selected = hit and old[2] >= 2\n            miss = selected != taken or (taken and (not hit or old[1] != target))\n            if in_markers: wrong[n] += miss\n            ctr = 3 if jump else ((2 if taken else 1) if not hit else min(3, old[2]+1) if taken else max(0, old[2]-1))\n            table[index] = (pc, target, ctr)\n    if insn == 0x00100073:\n        break\nelse:\n    raise RuntimeError('\"'no EBREAK')\nresult = {'retired': step+1, 'bracket_insns': bracket_insns, 'bracket_controls': controls, 'baseline_taken_bubbles': baseline, 'model_recoveries': wrong, 'max_pc': hex(max_pc), 'out_region_controls': out_region, 'oob': cpu.oob_access}\nPath('cores/bench/generated/hypothesis_probe/trace_model.json').write_text(json.dumps(result, indent=2))\nprint(json.dumps(result, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
