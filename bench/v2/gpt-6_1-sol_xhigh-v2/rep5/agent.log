{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('cores/bench/generated/hypothesis_probe/byte_compare')\nrtl=probe/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n(rtl/'fast_compare32.sv').write_text('''module fast_compare32(input logic [31:0] a,b,\n output logic lt_unsigned,lt_signed,equal);\n logic [3:0] lt,eq;\n for (genvar i=0;i<4;i++) begin:g_byte\n  assign lt[i] = a[8*i+:8] < b[8*i+:8];\n  assign eq[i] = a[8*i+:8] == b[8*i+:8];\n end\n assign lt_unsigned = lt[3] | (eq[3]&lt[2]) | (eq[3]&eq[2]&lt[1]) |\n                      (eq[3]&eq[2]&eq[1]&lt[0]);\n assign lt_signed = a[31] \"'!= b[31] ? a[31] : lt_unsigned;\n assign equal = &eq;\nendmodule\n'\"''')\np=rtl/'alu.sv';s=p.read_text().replace('  logic        [4:0]  shamt;','''  logic unsigned_lt,signed_lt;\n  fast_compare32 u_cmp(.a(a),.b(b),.lt_unsigned(unsigned_lt),\n                      .lt_signed(signed_lt),.equal());\n  logic        [4:0]  shamt;''')\ns=s.replace('\"'$signed(a) < $signed(b)'\"','signed_lt').replace('{31\\\\'b0, a < b}','{31\\\\'b0, unsigned_lt}')\np.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text().replace('  logic branch_cond, branch_taken, misalign_fault;','''  logic cmp_unsigned_lt,cmp_signed_lt,cmp_equal;\n  fast_compare32 u_branch_compare(.a(in.rs1_val),.b(in.rs2_val),\n      .lt_unsigned(cmp_unsigned_lt),.lt_signed(cmp_signed_lt),.equal(cmp_equal));\n  logic branch_cond, branch_taken, misalign_fault;''')\ns=s.replace('in.rs1_val == in.rs2_val','cmp_equal').replace('in.rs1_val \"'!= in.rs2_val'\"','\"'!cmp_equal'\"')\ns=s.replace('\"'$signed(in.rs1_val) < $signed(in.rs2_val)'\"','cmp_signed_lt').replace('\"'$signed(in.rs1_val) >= $signed(in.rs2_val)'\"','\"'!cmp_signed_lt'\"')\ns=s.replace('in.rs1_val < in.rs2_val','cmp_unsigned_lt').replace('in.rs1_val >= in.rs2_val','\"'!cmp_unsigned_lt'\"')\np