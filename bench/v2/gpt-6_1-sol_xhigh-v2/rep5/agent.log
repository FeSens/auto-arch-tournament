{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hypothesis_probe/shift_tests')\np.mkdir(exist_ok=True)\ns=Path('cores/bench/test/test_alu.py').read_text()\ns+='''\\\\n@cocotb.test()\nasync def exhaustive_shamt_structured_and_random(dut):\n    await _setup(dut)\n    rng=random.Random(1300)\n    vectors=[0,0xffffffff,0x80000000,0x7fffffff,0xaaaaaaaa,0x55555555]\n    vectors += [1<<i for i in range(32)] + [0xffffffff\"'^(1<<i) for i in range(32)]\n    vectors += [rng.getrandbits(32) for _ in range(300)]\n    for a in vectors:\n        for sh in range(32):\n            b=(rng.getrandbits(27)<<5)|sh\n            sa=a if a<0x80000000 else a-(1<<32)\n            await _check(dut,ALU_SRL,a,b,a>>sh)\n            await _check(dut,ALU_SRA,a,b,(sa>>sh)&MASK32)\n            await _check(dut,ALU_SLL,a,b,(a<<sh)&MASK32)\n'\"\\\\n@cocotb.test()\nasync def arithmetic_comparison_structured_and_random(dut):\n    await _setup(dut)\n    rng=random.Random(1301)\n    vectors=[0,1,0xffffffff,0xfffffffe,0x7fffffff,0x80000000,0x80000001]\n    pairs=[(a,b) for a in vectors for b in vectors]\n    pairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(6000)]\n    for a,b in pairs:\n        sa=a if a<0x80000000 else a-(1<<32)\n        sb=b if b<0x80000000 else b-(1<<32)\n        for op,expected in ((ALU_ADD,a+b),(ALU_SUB,a-b),(ALU_SLT,int(sa<sb)),(ALU_SLTU,int(a<b)),(ALU_AND,a&b),(ALU_OR,a|b),(ALU_XOR,a\"'^b)):\n            await _check(dut,op,a,b,expected)\n'\"'''\n(p/'test_alu_probe.py').write_text(s)\nprint('Prepared extended arithmetic and shift checks')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
