pt json.JSONDecodeError as e:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'malformed sim output: {e}'}\n\n    if not marker.get('ebreak', False):\n        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n        # a hung CPU with whatever cycle count it happened to reach.\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iter\n…[14217 of 17289 chars elided by tools/bench/transcript.py; sha256:406598615feb5a30]…\n103:    # Extra args after the ELF are passed to the simulator (e.g. --istall\ntest/cosim/run_cosim.py:104:    # --dstall to run the trace comparison under bus backpressure).\ntest/cosim/main.cpp:61:int main(int argc, char** argv) {\ntest/cosim/main.cpp:63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\ntest/cosim/main.cpp:67:    // --bench:  suppress per-retirement output; print only the final record.\ntest/cosim/main.cpp:68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\ntest/cosim/main.cpp:69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\ntest/cosim/main.cpp:77:        if      (std::strcmp(argv[i], \"--bench\")  == 0) bench_mode = true;\ntest/cosim/main.cpp:78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\ntest/cosim/main.cpp:79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\ntest/cosim/main.cpp:80:        else if (std::strcmp(argv[i], \"--seed\")   == 0 && i + 1 < argc)\n", "exit_code": 1, "status": "failed"}}
