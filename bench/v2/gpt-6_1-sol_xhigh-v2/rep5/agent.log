{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nE=[]\nfor l in Path('cores/bench/sim_build/predictor_probe/profile.txt').open():\n if l.startswith('PROBE '):\n  _,pc,insn,target,j,t,r=l.split(); E.append((int(pc,16),int(target,16),int(j),int(t)))\nfor n,shift,ways in [(32,0,1),(64,0,1),(128,0,1),(256,0,1),(32,5,1),(32,7,1),(32,9,1),(64,6,1),(64,7,1),(128,7,1),(128,9,1),(16,0,2),(32,0,2),(64,0,2),(32,5,2),(64,6,2)]:\n table={}; stats=Counter()\n for pc,target,j,t in E:\n  row=((pc>>2)\"'^(pc>>(2+shift)) if shift else pc>>2)&(n-1)\n  entries=table.setdefault(row,[])\n  hit=next((i for i,e in enumerate(entries) if e[0]==pc),None)\n  selected=hit is not None and entries[hit][1]>=2\n  missed= selected!=bool(t) or bool(t) and (hit is None or entries[hit][2]!=target)\n  stats['\"'jump' if j else 'branch']+=int(missed)\n  if hit is None:\n   if len(entries)==ways: entries.pop(0)\n   entries.append((pc,3 if j else 2 if t else 1,target))\n  else:\n   e=entries.pop(hit); entries.append((pc,3 if j else min(3,e[1]+1) if t else max(0,e[1]-1),target))\n print('rows',n,'shift',shift,'ways',ways,'miss',sum(stats.values()), dict(stats))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
