{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/rtl');root=Path('cores/bench/generated/hypothesis_probe/predictor');d=root/'queue2'\nshutil.copytree(base,d,dirs_exist_ok=True)\np=d/'core_pkg.sv';s=p.read_text().replace('logic        prediction_selected;', 'logic        frontier;\\\\n    logic        prediction_selected;').replace('logic        branch_taken;', 'logic        frontier;\\\\n    logic        branch_taken;');p.write_text(s)\np=d/'id_stage.sv';s=p.read_text().replace('reg_q.pc       <= in.pc;', 'reg_q.pc       <= in.pc;\\\\n          reg_q.frontier <= in.frontier;');p.write_text(s)\np=d/'ex_stage.sv';s=p.read_text().replace('output logic               train_valid,','output logic               train_valid,\\\\n  output logic               train_frontier,').replace('payload.pc = in.pc;', 'payload.pc = in.pc;\\\\n      payload.frontier = in.frontier;').replace('{295{','{296{').replace('assign train_pc = reg_q.pc;', 'assign train_pc = reg_q.pc;\\\\n  assign train_frontier = reg_q.frontier;');p.write_text(s)\np=d/'core.sv';s=p.read_text().replace('train_valid, train_eligible', 'train_valid, train_frontier, train_eligible').replace('.train_valid     (train_valid),', '.train_valid     (train_valid),\\\\n    .train_frontier  (train_frontier),');p.write_text(s)\np=d/'hazard_unit.sv';s=p.read_text().replace('imem_stall = \"'!imem_ready;'\"', 'imem_stall = 1\\\\'b0;');p.write_text(s)\np=d/'if_stage.sv';s=p.read_text().replace('input  logic              train_valid,', 'input  logic              train_frontier,\\\\n  input  logic              train_valid,')\nstart=s.index('  // Accepted registered recovery overrides')\ns=s[:start]+'''\n  if_id_t live, head;\n  logic [98:0] slot0_q, slot1_q;\n  logic v0, v1, frontier_wait_q;\n  logic [31:0] frontier_successor_q;\n  logic pop, push, bypass, append0, append1;\n  assign live.pc = pc;\n  assign live.instr = imem_data;\n  assign live.prediction_selected = prediction_selected;\n  assign live.predicted_target = {targets[fetch_index],2'b00};\n  assign live.frontier = next_pc[31:20] \"'!= 12'\"'b0;\n  assign live.valid = 1'b1;\n  assign head = slot0_q;\n  assign push = imem_ready && \"'!v1 && !frontier_wait_q && !reset && !redirect;\n  assign pop = v0 && !stall && !reset && !redirect;\n  assign bypass = !v0 && !stall && push;\n  assign append0 = push && !bypass && (!v0 || pop);\n  assign append1 = push && !bypass && v0 && !pop;\n  always_ff @(posedge clock) begin\n    if(reset)begin\n      pc<=RESET_PC;v0<=1'\"'b0;v1<=1'b0;frontier_wait_q<=1'b0;\n      frontier_successor_q<='0;\n    end else if(redirect)begin\n      pc<=redirect_target;v0<=1'b0;v1<=1'b0;frontier_wait_q<=1'b0;\n    end else begin\n      if(push)begin\n        if(live.frontier)begin\n          frontier_wait_q<=1'b1;frontier_successor_q<=next_pc;\n        end else pc<=next_pc;\n      end else if(frontier_wait_q && train_valid && train_frontier)begin\n        pc<=frontier_successor_q;frontier_wait_q<=1'b0;\n      end\n      if(append0)slot0_q<=live;\n      else if(pop && v1)slot0_q<=slot1_q;\n      if(append1)slot1_q<=live;\n      v0 <= (push && \"'!bypass) || (v0 && !pop) || v1;\n      v1 <= (v1 && !pop) || append1;\n    end\n  end\n  assign imem_addr=pc;\n  always_comb begin\n    out = v0 ? head : live;\n    out.valid = (v0 || (imem_ready && !frontier_wait_q && !v1)) && !redirect;\n  end\nendmodule\n'\"'''\np.write_text(s)\nPY\nRTL_DIR=cores/bench/generated/hypothesis_probe/predictor/queue2 OBJ_DIR=cores/bench/generated/hypothesis_probe/predictor/queue_obj NRET=1 bash test/cosim/build.sh > cores/bench/generated/hypothesis_probe/predictor/queue_build.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
