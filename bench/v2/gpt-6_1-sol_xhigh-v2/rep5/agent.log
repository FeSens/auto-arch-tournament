{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe')\nrtl=root/'prefix'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'alu.sv'\ns=p.read_text()\nnetwork='''  wire subtract = op == ALU_SUB || op == ALU_SLT || op == ALU_SLTU;\n  wire [31:0] effective_b = b \"'^ {32{subtract}};\n  wire [31:0] bit_p = a ''^ effective_b;\n  wire [31:0] bit_g = a & effective_b;\n  wire [7:0] block_p, block_g;\n  wire [7:0] prefix_p [0:3];\n  wire [7:0] prefix_g [0:3];\n  wire [8:0] carry;\n  wire [31:0] arithmetic;\n  assign carry[0] = subtract;\n  for (genvar i=0; i<8; i++) begin : g_block\n    wire [3:0] p = bit_p[i*4 +: 4];\n    wire [3:0] g = bit_g[i*4 +: 4];\n    assign block_p[i] = &p;\n    assign block_g[i] = g[3] | (p[3]&g[2]) | (p[3]&p[2]&g[1]) | (p[3]&p[2]&p[1]&g[0]);\n    wire c1 = g[0] | (p[0]&carry[i]);\n    wire c2 = g[1] | (p[1]&g[0]) | (p[1]&p[0]&carry[i]);\n    wire c3 = g[2] | (p[2]&g[1]) | (p[2]&p[1]&g[0]) | (p[2]&p[1]&p[0]&carry[i]);\n    assign arithmetic[i*4 +: 4] = p ''^ {c3,c2,c1,carry[i]};\n    assign carry[i+1] = prefix_g[3][i] | (prefix_p[3][i]&subtract);\n  end\n  assign prefix_p[0] = block_p;\n  assign prefix_g[0] = block_g;\n  for (genvar level=0;level<3;level++) begin : g_prefix\n    for (genvar i=0;i<8;i++) begin : g_node\n      if (i >= (1<<level)) begin : g_merge\n        assign prefix_p[level+1][i] = prefix_p[level][i]&prefix_p[level][i-(1<<level)];\n        assign prefix_g[level+1][i] = prefix_g[level][i] | (prefix_p[level][i]&prefix_g[level][i-(1<<level)]);\n      end else begin : g_copy\n        assign prefix_p[level+1][i] = prefix_p[level][i];\n        assign prefix_g[level+1][i] = prefix_g[level][i];\n      end\n    end\n  end\n'\"'''\ns=s.replace('  logic        [4:0]  shamt;','  logic        [4:0]  shamt;\\\\n'+network)\ns=s.replace('out = a + b;', 'out = arithmetic;').replace('out = a - b;','out = arithmetic;')\ns=s.replace('out = {31\\\\'b0, \"'$signed(a) < $signed(b)};'\"',\\\"out = {31'b0, (a[31] \"'!= b[31]) ? a[31] : arithmetic[31]};\")\ns=s.replace(\"out = {31'\"'b0, a < b};\\\", \\\"out = {31'b0, \"'!carry[8]};\")\np.write_text(s)\nprint('\"'Prepared isolated EX prefix probe:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
