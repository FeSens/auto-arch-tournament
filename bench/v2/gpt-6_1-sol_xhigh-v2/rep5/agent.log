begin if(directions[direction_train_index]\"'!=2'\"'b11)directions[direction_train_index]<=directions[direction_train_index]+2'b01;end\n      else begin if(directions[direction_train_index]\"'!=2'\"'b00)directions[direction_train_index]<=directions[direction_train_index]-2'b01;end\n    end\n    if(train_eligible && train_indirect && train_pc[1:0]==2'b00 && train_target[1:0]==2'b00)begin\n      indirect_valid_q[indirect_train_index]<=1'b1;tags[indirect_train_index]<=train_pc[31:6];targets[indirect_train_index]<=train_target[31:2];\n    end else if(train_indirect_hit)indirect_valid_q[indirect_train_index]<=1'b0;\n   end\n  end\n end\n assign imem_addr=pc;\n always_comb begin\n  out.pc=pc;out.instr=imem_data;out.prediction_selected=prediction_selected;\n  out.predicted_target=predicted_target;out.valid=imem_ready&&\"'!redirect;\n end\nendmodule\n'\"'''\n(rtl/'if_stage.sv').write_text(s)\nPY\nRTL_DIR=cores/bench/generated/hypothesis_probe/predictor/split64 OBJ_DIR=cores/bench/generated/hypothesis_probe/predictor/split_obj NRET=1 bash test/cosim/build.sh > cores/bench/generated/hypothesis_probe/predictor/split_build.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
