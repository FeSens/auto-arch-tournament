{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/9d6f718c/bd97f927/r14s2/prototype.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/9d6f718c/bd97f927/r14s2')\nfor bits in (6,7):\n rtl=root/f'sig{1<<bits}'/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for src in Path('cores/bench/rtl').glob('*.sv'):shutil.copyfile(src,rtl/src.name)\n source=(rtl/'if_stage.sv').read_text()\n before=source.split('  localparam logic [31:0] RESET_PC')[0]\n after=source[source.index('  always_comb begin\\\\n    next_pc'):]\n body='''  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  logic [31:0] pc, next_pc;\n  logic [ROWS-1:0] valid_q;\n  logic [1:0] tags [0:ROWS-1];\n  logic [29:0] targets [0:ROWS-1];\n  logic [1:0] counters [0:ROWS-1];\n  logic [BITS-1:0] fetch_index, train_index;\n  logic fetch_hit, prediction_selected, control_word;\n  if_id_t head_q, middle_q, tail_q, fetched;\n  logic [1:0] occupancy_q;\n  logic enqueue, dequeue;\n  logic training_q, jump_q, taken_q;\n  logic [BITS-1:0] training_index_q;\n  logic [1:0] training_tag_q, row_tag_q;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] training_target_q;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic row_valid_q;\n  logic [1:0] row_counter_q;\n  logic training_hit, commit_write, post_valid;\n  logic [1:0] post_tag, post_counter;\n  assign fetch_index = pc[BITS+1:2] \"'^ pc[2*BITS+1:BITS+2];\n  assign train_index = train_pc[BITS+1:2] ''^ train_pc[2*BITS+1:BITS+2];\n  assign control_word = (imem_data[6:0] == 7'\"'h63 && imem_data[14:12] \"'!= 3'\"'d2 && imem_data[14:12] \"'!= 3'\"'d3)\n                     || imem_data[6:0] == 7'h6f\n                     || (imem_data[6:0] == 7'h67 && imem_data[14:12] == 3'd0);\n  assign fetch_hit = valid_q[fetch_index] && tags[fetch_index] == pc[BITS+3:BITS+2];\n  assign prediction_selected = control_word && fetch_hit && counters[fetch_index][1];\n  assign training_hit = row_valid_q && row_tag_q == training_tag_q;\n  always_comb begin\n    post_valid = row_valid_q;\n    post_tag = row_tag_q;\n    post_counter = row_counter_q;\n    commit_write = training_q && (jump_q || taken_q || training_hit);\n    if (jump_q || taken_q) begin\n      post_valid = 1'b1;\n      post_tag = training_tag_q;\n      if (jump_q) post_counter = 2'b11;\n      else if (\"'!training_hit) post_counter = 2'\"'b10;\n      else post_counter = {row_counter_q[1] | row_counter_q[0], row_counter_q[1] | \"'!row_counter_q[0]};\n    end else if (training_hit)\n      post_counter = {row_counter_q[1] & row_counter_q[0], row_counter_q[1] & !row_counter_q[0]};\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      valid_q <= '\"'0;\n      training_q <= 1'b0;\n      jump_q <= 1'b0;\n      taken_q <= 1'b0;\n      training_index_q <= '0;\n      training_tag_q <= '0;\n      training_target_q <= '0;\n      row_valid_q <= 1'b0;\n      row_tag_q <= '0;\n      row_counter_q <= '0;\n    end else begin\n      if (commit_write) begin\n        valid_q[training_index_q] <= post_valid;\n        tags[training_index_q] <= post_tag;\n        counters[training_index_q] <= post_counter;\n        if (jump_q || taken_q) targets[training_index_q] <= training_target_q[31:2];\n      end\n      training_q <= train_valid && train_eligible && train_pc[1:0] == 2'b00 && train_target[1:0] == 2'b00;\n      if (train_valid && train_eligible && train_pc[1:0] == 2'b00 && train_target[1:0] == 2'b00) begin\n        training_index_q <= train_index;\n        training_tag_q <= train_pc[BITS+3:BITS+2];\n        training_target_q <= {train_target[31:2], 2'b00};\n        jump_q <= train_jump;\n        taken_q <= train_taken;\n        if (training_q && training_index_q == train_index) begin\n          row_valid_q <= post_valid;\n          row_tag_q <= post_tag;\n          row_counter_q <= post_counter;\n        end else begin\n          row_valid_q <= valid_q[train_index];\n          row_tag_q <= tags[train_index];\n          row_counter_q <= counters[train_index];\n        end\n      end\n    end\n  end\n'''.replace('ROWS',str(1<<bits)).replace('BITS',str(bits))\n (rtl/'if_stage.sv').write_text(before+body+after)\nprint('Generated isolated 64- and 128-row signature predictor probes')\nPY\npython3 /srv/hwebench/tmp/9d6f718c/bd97f927/r14s2/prototype.py\nNRET=1 RTL_DIR=/srv/hwebench/tmp/9d6f718c/bd97f927/r14s2/sig128/rtl OBJ_DIR=/srv/hwebench/tmp/9d6f718c/bd97f927/r14s2/sig128/obj bash test/cosim/build.sh > /srv/hwebench/tmp/9d6f718c/bd97f927/r14s2/sig128/build.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
