t = successor_taken_q ? target_q : seq_q;\n      reg_q.branch_target = target_q;\n    end else reg_q = '0;\n  end\n  assign lsu_addr = address_q;\n  assign lsu_wdata = store_q;\n  assign lsu_wmask = mask_q;\n  assign lsu_ren = meta_q.valid && class_q == C_LSU && read_q;\n  assign lsu_wen = meta_q.valid && class_q == C_LSU && write_q;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      class_q <= C_SCALAR;\n      scalar_q <= 0; link_q <= 0; complete_q <= 0; address_q <= 0;\n      seq_q <= 0; target_q <= 0; successor_taken_q <= 0;\n      store_q <= 0; mask_q <= 0; read_q <= 0; write_q <= 0;\n    end else if (\"'!stall) begin\n      if (completed_emit) begin\n        class_q <= pending_kind_q == P_JALR ? C_LINK : C_COMPLETE;\n        complete_q <= completed_payload.alu_result;\n        link_q <= pending_payload_q.pc + 32'\"'d4;\n        seq_q <= pending_payload_q.pc + 32'd4;\n        target_q <= pending_payload_q.branch_target;\n        successor_taken_q <= pending_successor_taken_q;\n        read_q <= 0; write_q <= 0;\n      end else if (fast_emit) begin\n        class_q <= mem_now ? C_LSU : in.ctrl.is_jump ? C_LINK : C_SCALAR;\n        if (mem_now) begin\n          address_q <= address_now;\n          store_q <= store_now;\n          mask_q <= mask_now;\n        end\n        if (\"'!mem_now && !in.ctrl.is_jump) scalar_q <= alu_result;\n        if (in.ctrl.is_jump) link_q <= in.pc + 32'\"'d4;\n        seq_q <= in.pc + 32'd4;\n        target_q <= in.direct_target;\n        successor_taken_q <= \"'!ctrl_with_trap.is_illegal && (branch_taken || in.ctrl.is_jump);\n        read_q <= in.ctrl.mem_read && !mem_alignment;\n        write_q <= in.ctrl.mem_write && !mem_alignment;\n      end else begin read_q <= 0; write_q <= 0; end\n    end\n  end'\"''')\ns=s.replace(\\\"      reg_q <= '0;\\\", \\\"      meta_q <= '0;\\\\n      pending_successor_taken_q <= 0;\\\")\ns=s.replace('      reg_q <= reg_d;', '      meta_q <= reg_d;')\ns=s.replace('        pending_payload_q