{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv cores/bench/rtl/if_stage.sv; cat formal/checks_si.cfg'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// Forwarding select encoding (driven by forward_unit):\n//   00 = ID/EX register value (no forward)\n//   01 = EX/MEM aluResult (instruction immediately ahead in MEM)\n//   10 = MEM/WB result (instruction two ahead, post regfile-write mux)\n//\n// Latency:        1 cycle (EX/MEM register clocked here).\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               div_ready,     // downstream accepts completed division\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  output ex_mem_t  out,\n  output logic               execute_busy,  // hold IF + ID/EX, let MEM + WB drain\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result, div_res\n…[7056 of 10128 chars elided by tools/bench/transcript.py; sha256:42659b11a0f58d4b]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
