{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom collections import Counter\nfrom pathlib import Path\np=Path('cores/bench/sim_build/predictor_probe/profile.txt')\nif not p.exists(): raise SystemExit('profile not ready')\nstats=Counter(); sites=Counter(); miss=Counter(); ret_targets={}; events=[]\nfor l in p.open():\n if not l.startswith('PROBE '): continue\n _,pc,insn,target,jump,taken,recovery=l.split()\n pc,insn,target=int(pc,16),int(insn,16),int(target,16)\n jump,taken,recovery=int(jump),int(taken),int(recovery)\n rd=(insn>>7)&31; rs1=(insn>>15)&31; imm=insn>>20\n kind='branch' if not jump else 'return' if insn&127==103 and rd==0 and rs1 in (1,5) and imm==0 else 'jalr' if insn&127==103 else 'jal'\n stats[kind]+=1; stats[kind+'_miss']+=recovery; sites[(kind,pc)]+=1; miss[(kind,pc)]+=recovery\n events.append((pc,insn,target,jump,taken,recovery))\nprint('Counts:',dict(stats)); print('Top missed sites',[(k,n,sites[k]) for k,n in miss.most_common(15)])\n# Ideal correct-path sequential local/global direction estimates; these\n# ignore learning delay and speculative wrong-path history.\nfor alg in ('bimodal','gshare','local4','local8'):\n counters={}; gh=0; lh={}; errors=Counter(); total=0\n for pc,insn,target,jump,taken,recovery in events:\n  if jump: continue\n  hist=gh if alg=='gshare' else lh.get(pc,0)\n  idx=pc>>2 if alg=='bimodal' else ((pc>>2)\"'^hist)&255 if alg=='\"'gshare' else (pc,hist)\n  c=counters.get(idx,1); errors['miss']+= (c>=2)\"'!=bool(taken); total+=1\n  counters[idx]=min(3,c+1) if taken else max(0,c-1)\n  gh=((gh<<1)|taken)&255\n  lh[pc]=((hist<<1)|taken)&(15 if alg=='\"'local4' else 255)\n print(alg,'ideal direction misses',errors['miss'],'total',total)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
