{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe/predictor')\nfor n in [3,4]:\n d=root/f'queue{n}';shutil.copytree(root/'queue2',d,dirs_exist_ok=True)\n p=d/'if_stage.sv';s=p.read_text();a=s.index('  if_id_t live, head;')\n setup='''\n  if_id_t live, head;\n  logic [98:0] slots [0:N-1];\n  logic [N-1:0] v;\n  logic frontier_wait_q;\n  logic [31:0] frontier_successor_q;\n  logic pop, push, bypass, stored_push;\n  logic [N-1:0] append;\n  assign live.pc=pc;\n  assign live.instr=imem_data;\n  assign live.prediction_selected=prediction_selected;\n  assign live.predicted_target={targets[fetch_index],2'b00};\n  assign live.frontier=next_pc[31:20] \"'!= 12'\"'b0;\n  assign live.valid=1'b1;\n  assign head=slots[0];\n  assign push=imem_ready && \"'!v[N-1] && !frontier_wait_q && !reset && !redirect;\n  assign pop=v[0] && !stall && !reset && !redirect;\n  assign bypass=!v[0] && !stall && push;\n  assign stored_push=push&&!bypass;\n  assign append[0]=stored_push&&(!v[0]||(pop&&!v[1]));\n  for(genvar i=1;i<N-1;i++)begin\n   assign append[i]=stored_push&&((v[i-1]&&!v[i]&&!pop)||(v[i]&&!v[i+1]&&pop));\n  end\n  assign append[N-1]=stored_push&&v[N-2]&&!pop;\n  for(genvar i=0;i<N;i++)begin:g_slot\n   logic [98:0] payload_q;\n   always_ff @(posedge clock)begin\n    if(append[i])payload_q<=live;\n    else if(pop && i<N-1)payload_q<=slots[(i+1)%N];\n   end\n   assign slots[i]=payload_q;\n  end\n  always_ff @(posedge clock)begin\n   if(reset)begin\n    pc<=RESET_PC;v<='\"'0;frontier_wait_q<=1'b0;frontier_successor_q<='0;\n   end else if(redirect)begin\n    pc<=redirect_target;v<='0;frontier_wait_q<=1'b0;\n   end else begin\n    if(push)begin\n     if(live.frontier)begin frontier_wait_q<=1'b1;frontier_successor_q<=next_pc;end\n     else pc<=next_pc;\n    end else if(frontier_wait_q&&train_valid&&train_frontier)begin\n     pc<=frontier_successor_q;frontier_wait_q<=1'b0;\n    end\n    v[0]<=stored_push||(v[0]&&\"'!pop)||v[1];\n    for(integer j=1;j<N-1;j=j+1)\n     v[j]<=(v[j]&&!pop)||v[j+1]||(stored_push&&v[j-1]&&(!pop||v[j]));\n    v[N-1]<=(v[N-1]&&!pop)||(stored_push&&v[N-2]&&!pop);\n   end\n  end\n  assign imem_addr=pc;\n  always_comb begin\n   out=v[0]?head:live;\n   out.valid=(v[0]||(imem_ready&&!frontier_wait_q&&!v[N-1]))&&!redirect;\n  end\nendmodule\n'\"'''.replace('N',str(n))\n p.write_text(s[:a]+setup)\nPY\nRTL_DIR=cores/bench/generated/hypothesis_probe/predictor/queue4 OBJ_DIR=cores/bench/generated/hypothesis_probe/predictor/queue4_obj NRET=1 bash test/cosim/build.sh > cores/bench/generated/hypothesis_probe/predictor/queue4_build.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
