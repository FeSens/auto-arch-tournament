{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hypothesis_probe/r11_rf_control/test/test_pipeline.py')\ns=p.read_text()\nneedle='''        wen       = int(dut.io_dmemWEn.value)\n'''\nreplacement='''        # Physical RF controls must remain exact under every pipeline hold.\n        wb_en = int(dut.u_wb.w_en.value)\n        wb_addr = int(dut.u_wb.w_addr.value)\n        for port in (1, 2):\n            source = int(getattr(dut.u_id, f\\\"rs{port}_addr\\\").value)\n            select = int(getattr(dut.u_id, f\\\"rs{port}_read_select\\\").value)\n            bypass = int(getattr(dut.u_id, f\\\"rs{port}_writefirst\\\").value)\n            assert select == (0 if source == 0 else 1 << (source - 1))\n            assert bypass == int(bool(wb_en) and wb_addr \"'!= 0 and wb_addr == source)\n        wen       = int(dut.io_dmemWEn.value)\n'\"'''\nassert needle in s\np.write_text(s.replace(needle,replacement))\nPY\nPYTHONPATH=\\\"\"'$PWD/test/cosim${PYTHONPATH:+:$PYTHONPATH}\" python3 -m pytest -q cores/bench/generated/hypothesis_probe/r11_rf_control/test/test_pipeline.py > cores/bench/generated/hypothesis_probe/r11_rf_control/pipeline_controls_test.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hypothesis_probe/r11_rf_control/test/test_pipeline.py')\ns=p.read_text()\nneedle='''        wen       = int(dut.io_dmemWEn.value)\n'''\nreplacement='''        # Physical RF controls must remain exact under every pipeline hold.\n        wb_en = int(dut.u_wb.w_en.value)\n        wb_addr = int(dut.u_wb.w_addr.value)\n        for port in (1, 2):\n            source = int(getattr(dut.u_id, f\\\"rs{port}_addr\\\").value)\n            select = int(getattr(dut.u_id, f\\\"rs{port}_read_select\\\").value)\n            bypass = int(getattr(dut.u_id, f\\\"rs{port}_writefirst\\\").value)\n            assert select == (0 if source == 0 else 1 << (source - 1))\n            assert bypass == int(bool(wb_en) and wb_addr \"'!= 0 and wb_addr == source)\n        wen       = int(dut.io_dmemWEn.value)\n'\"'''\nassert needle in s\np.write_text(s.replace(needle,replacement))\nPY\nPYTHONPATH=\\\"\"'$PWD/test/cosim${PYTHONPATH:+:$PYTHONPATH}\" python3 -m pytest -q cores/bench/generated/hypothesis_probe/r11_rf_control/test/test_pipeline.py > cores/bench/generated/hypothesis_probe/r11_rf_control/pipeline_controls_test.log 2>&1'","aggregated_output":"","exit_code":0,"status":"completed"}}
