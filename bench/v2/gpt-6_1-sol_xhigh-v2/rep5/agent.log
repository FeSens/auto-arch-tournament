{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/sim_build/predictor_probe')\nrtl=root/'rtl_banked'\nshutil.copytree(root/'rtl128',rtl,dirs_exist_ok=True)\np=rtl/'if_stage.sv'; s=p.read_text()\ns=s.replace('  logic [22:0] tags [0:127];\\\\n  logic [29:0] targets [0:127];\\\\n  logic [1:0] counters [0:127];', '''  wire [22:0] fetch_tags [0:3], train_tags [0:3];\n  wire [29:0] fetch_targets [0:3];\n  wire [1:0] fetch_counters [0:3], train_counters [0:3];''')\ns=s.replace('assign fetch_index = pc[8:2];', 'assign fetch_index = pc[8:2] \"'^ pc[15:9];'\"')\ns=s.replace('assign train_index = train_pc[8:2];', 'assign train_index = train_pc[8:2] \"'^ train_pc[15:9];'\"')\ns=s.replace('tags[fetch_index]', 'fetch_tags[fetch_index[6:5]]')\ns=s.replace('counters[fetch_index][1]', 'fetch_counters[fetch_index[6:5]][1]')\ns=s.replace('targets[fetch_index]', 'fetch_targets[fetch_index[6:5]]')\ns=s.replace('tags[train_index]', 'train_tags[train_index[6:5]]')\ns=s.replace('counters[train_index]', 'train_counters[train_index[6:5]]')\ns=s.replace('commit_write = training_q && (eligible_q || training_hit);', 'commit_write = training_q && ((eligible_q && (training_hit || taken_q || jump_q)) || (\"'!eligible_q && training_hit));'\"')\ns=s.replace('if (eligible_q) begin\\\\n      post_valid', 'if (eligible_q && (training_hit || taken_q || jump_q)) begin\\\\n      post_valid')\ns=s.replace(\\\"      valid_q <= '0;\\\\n\\\", '')\nold='''      if (commit_write) begin\n        valid_q[training_index_q] <= post_valid;\n        if (eligible_q) begin\n          tags[training_index_q] <= post_tag;\n          targets[training_index_q] <= training_target_q[31:2];\n          counters[training_index_q] <= post_counter;\n        end\n      end\n'''\nassert old in s\ns=s.replace(old,'')\npos=s.index('  // Reset cancels pending events')\ns=s[:pos]+'''  for (genvar bank = 0; bank < 4; bank++) begin : g_predictor_bank\n    logic [31:0] bank_valid;\n    logic [22:0] tags [0:31];\n    logic [29:0] targets [0:31];\n    logic [1:0] counters [0:31];\n    assign valid_q[32*bank +: 32] = bank_valid;\n    assign fetch_tags[bank] = tags[fetch_index[4:0]];\n    assign train_tags[bank] = tags[train_index[4:0]];\n    assign fetch_targets[bank] = targets[fetch_index[4:0]];\n    assign fetch_counters[bank] = counters[fetch_index[4:0]];\n    assign train_counters[bank] = counters[train_index[4:0]];\n    always_ff @(posedge clock) begin\n      if (reset) bank_valid <= '0;\n      else if (commit_write && training_index_q[6:5] == 2'(bank)) begin\n        bank_valid[training_index_q[4:0]] <= post_valid;\n        if (eligible_q) begin\n          tags[training_index_q[4:0]] <= post_tag;\n          targets[training_index_q[4:0]] <= training_target_q[31:2];\n          counters[training_index_q[4:0]] <= post_counter;\n        end\n      end\n    end\n  end\n\n'''+s[pos:]\np.write_text(s)\nprint('Created four-bank XOR-indexed taken-allocation predictor.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
