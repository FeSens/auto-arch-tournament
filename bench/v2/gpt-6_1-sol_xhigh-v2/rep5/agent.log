{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path.cwd()\nprobe=root/'cores/bench/generated/hypothesis_probe/r11_address_register'\nrtl=probe/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in (root/'cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'ex_stage.sv'\ns=p.read_text().replace('  output ex_mem_t            out,','  output ex_mem_t            out,\\\\n  output logic [31:0]        mem_address,')\npos=s.index('  localparam logic [1:0] P_DIV')\ns=s[:pos]+'''  // Dedicated address storage is not selected from the general ALU word.\n  always_ff @(posedge clock) begin\n    if (reset) mem_address <= 32'b0;\n    else if (\"'!stall) mem_address <= in.alu_a_val + in.alu_b_val;\n  end\n\n'\"''' + s[pos:]\np.write_text(s)\np=rtl/'mem_stage.sv'\ns=p.read_text().replace('  input  ex_mem_t  in,','  input  ex_mem_t  in,\\\\n  input  logic [31:0] effective_address,')\ns=s.replace('in.alu_result[','effective_address[')\ns=s.replace('    dmem_addr  = in.alu_result;','    dmem_addr  = effective_address;')\np.write_text(s)\np=rtl/'core.sv'\ns=p.read_text().replace('  mem_wb_t mem_wb_w;','  mem_wb_t mem_wb_w;\\\\n  logic [31:0] effective_address_w;')\ns=s.replace('    .out             (ex_mem_w),','    .out             (ex_mem_w),\\\\n    .mem_address     (effective_address_w),')\ns=s.replace('    .in         (ex_mem_w),','    .in         (ex_mem_w),\\\\n    .effective_address (effective_address_w),')\np.write_text(s)\ntests=probe/'test'\ntests.mkdir(exist_ok=True)\nfor p in (root/'cores/bench/test').glob('*.py'):\n shutil.copy2(p,tests/p.name)\nprint(probe)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
