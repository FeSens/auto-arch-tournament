{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,210p' cores/bench/test/test_pipeline.py\nsed -n '1,210p' cores/bench/test/test_ex_stage.py\"", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _bundle(packed, layout):\n    values = {}\n    for name, width in reversed(layout):\n        values[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    assert packed == 0\n    return values\n\n\n_ID_LAYOUT = [(\"pc\", 32), (\"prediction_selected\", 1), (\"predicted_target\", 32),\n              (\"direct_target\", 32), (\"direct_target_match\", 1),\n              (\"rs1_val\", 32), (\"rs2_val\", 32), (\"alu_a_val\", 32), (\"alu_b_val\", 32),\n              (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n              (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1)]\n_EX_LAYOUT = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n              (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n              (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n              (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n              (\"instr\", 32), (\"valid\", 1)]\n_DEC_LAYOUT = [(\"pc\", 32), (\"instr\", 32), (\"imm\", 32),\n               (\"prediction_selected\", 1), (\"predicted_target\", 32),\n               (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n               (\"ctrl\", 22), (\"provenance\", 4), (\"valid\", 1)]\n_FETCH_LAYOUT = [(\"pc\", 32), (\"instr\", 32), (\"prediction_selected\", 1),\n                 (\"predicted_target\", 32), (\"valid\", 1)]\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n…[15805 of 18877 chars elided by tools/bench/transcript.py; sha256:58fa7c5c0caa9fbb]…\n  await _cycle(dut)\n            result = _unpack(EX_MEM, int(dut.out.value))\n            assert (result[\"rs1_val\"], result[\"rs2_val\"], result[\"write_data\"]) == (a, b, b)\n            assert result[\"alu_result\"] == (a + b) & 0xFFFFFFFF\n\n    held = int(dut.out.value)\n    dut.stall.value = 1\n    _drive(dut, dict(instruction, rd=19))\n    await Timer(1, \"ns\")\n    assert int(dut.next_rd.value) == 3 and int(dut.next_w_en.value)\n    await _cycle(dut)\n    assert int(dut.out.value) == held\n    dut.stall.value = 0\n    _drive(dut, {})\n    await Timer(1, \"ns\")\n    assert int(dut.next_rd.value) == 0 and not int(dut.next_w_en.value)\n    await _cycle(dut)\n    assert int(dut.out.value) == 0\n\n    # A misaligned direct jump must not advertise its link as a writer.\n    _drive(dut, dict(instruction, direct_target=0x42,\n                    ctrl=_pack(CTRL, dict(is_jump=1, reg_write=1))))\n    await Timer(1, \"ns\")\n    assert int(dut.next_rd.value) == 3 and not int(dut.next_w_en.value)\n    dut.reset.value = 1\n    await Timer(1, \"ns\")\n", "exit_code": 0, "status": "completed"}}
