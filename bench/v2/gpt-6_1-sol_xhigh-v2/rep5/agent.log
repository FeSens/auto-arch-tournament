{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'tail -24 cores/bench/test/test_alu.py; tail -45 cores/bench/test/test_pipeline.py'","aggregated_output":"        await _setup(dut)\n        dut.op.value = ALU_DIVU\n        dut.a.value = MASK32\n        dut.b.value = 7\n        dut.div_request.value = 1\n        await _cycle(dut)\n        dut.div_request.value = 0\n        for _ in range(cycles):\n            await _cycle(dut)\n        dut.reset.value = 1\n        await _cycle(dut)\n        dut.reset.value = 0\n        assert not int(dut.div_busy.value) and not int(dut.div_done.value)\n        for _ in range(36):\n            await _cycle(dut)\n            assert not int(dut.div_done.value), \"cancelled divide completed after reset\"\n        await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, MASK32)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n        if int(dut.io_dmemREn.value) and state[\"load_wait\"] < 20:\n            state[\"load_wait\"] += 1\n            return (1, 0)\n        decoded = _bundle(int(dut.u_id.decoded.value), _DEC_LAYOUT)\n        if decoded[\"valid\"] and decoded[\"pc\"] == 16 and not state[\"gap_started\"]:\n            state[\"gap_started\"] = True\n            state[\"launch_gap\"] = 2\n        if state[\"launch_gap\"]:\n            state[\"launch_gap\"] -= 1\n            return (0, 1)\n        if int(dut.u_ex.completed_emit.value) and not state[\"completed\"]:\n            state[\"completed\"] = True\n            state[\"bus_hold\"] = 14\n        if state[\"bus_hold\"]:\n            state[\"bus_hold\"] -= 1\n            return (0, 1)\n        return (1, 1)\n    rets, memory = await _run(dut, program, {256: 19}, max_cycles=200,\n                             ready=ready, pipeline_events=snapshots, bus_events=transactions)\n    _check_linear(rets, program)\n    assert state[\"load_wait\"] == 20 and state[\"completed\"]\n    assert [r[\"rd_wdata\"] for r in rets[:7]] == [100, 7, 19, 119, 17, 119, 238]\n    assert all(r[\"rs1_rdata\"] == 238 and r[\"rd_wdata\"] == 238 + r[\"rd\"] for r in rets[8:-1])\n    assert memory == {256: 19, 300: 238}\n    assert [(e[1], e[2]) for e in transactions] == [(\"load\", 256), (\"store\", 300)]\n    assert any(s[\"enqueue\"] and s[\"hold\"] and s[\"mem_hold\"] for s in snapshots)\n    assert any(s[\"enqueue\"] and s[\"hold\"] and s[\"pending\"] for s in snapshots)\n    assert any(s[\"occupancy\"] == 3 and s[\"enqueue\"] and s[\"dequeue\"] for s in snapshots)\n    assert any(s[\"dequeue\"] and not s[\"imem_ready\"] for s in snapshots)\n    assert any(s[\"occupancy\"] == 0 and not s[\"imem_ready\"] for s in snapshots)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n","exit_code":0,"status":"completed"}}
