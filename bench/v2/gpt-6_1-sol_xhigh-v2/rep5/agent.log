{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport subprocess,json\nfrom tools.eval.cosim import run_one, TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart\nroot=Path.cwd();p=root/'cores/bench/generated/hypothesis_probe/select';programs=root/'cores/bench/generated/hypothesis_probe/addr';sim=str(p/'obj_dir/cosim_sim')\nresults=[]\nfor name in ['selftest','random1','random2','random3']:\n for flags in TRACE_STALL_MODES:\n  result=run_one(programs/(name+'.elf'),sim,str(root),sim_flags=flags)\n  results.append(result);print(json.dumps(result),flush=True)\nr=subprocess.run([sim,str(programs/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,timeout=120)\n(p/'coremark.stdout').write_text(r.stdout)\nmarker=json.loads(r.stdout.splitlines()[-1]);print('CoreMark marker:',json.dumps(marker),flush=True)\nassert r.returncode==0 and marker.get('ebreak') and not marker.get('oob')\nvalid,reason=validate_coremark_uart(marker.get('uart',''),10)\nassert valid,reason\nassert all(x['passed'] for x in results)\n(p/'cosim.json').write_text(json.dumps({'results':results,'coremark':marker},indent=2))\nprint('Full-trace cosim and canonical stalled CoreMark passed',flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
