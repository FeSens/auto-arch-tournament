{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/rf_probe')\nshutil.copytree('cores/bench/rtl',root/'rtl',dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',root/'test',dirs_exist_ok=True)\n(root/'rtl/reg_file.sv').write_text('''// Explicit word flops and balanced read trees. Existing combinational interface.\nmodule reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output logic [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  wire [31:0] read1_tree [0:62];\n  wire [31:0] read2_tree [0:62];\n  assign read1_tree[31] = 32'b0;\n  assign read2_tree[31] = 32'b0;\n  for (genvar word_index = 1; word_index < 32; word_index++) begin : g_word\n    logic [31:0] word_q;\n    wire word_write = w_en && w_addr == 5'(word_index);\n    wire word_read1 = rs1_addr == 5'(word_index);\n    wire word_read2 = rs2_addr == 5'(word_index);\n    always_ff @(posedge clock) begin\n      if (reset) word_q <= 32'b0;\n      else if (word_write) word_q <= w_data;\n    end\n    assign read1_tree[31 + word_index] = word_q & {32{word_read1}};\n    assign read2_tree[31 + word_index] = word_q & {32{word_read2}};\n  end\n  for (genvar tree_index = 0; tree_index < 31; tree_index++) begin : g_read_tree\n    assign read1_tree[tree_index] = read1_tree[2*tree_index+1] | read1_tree[2*tree_index+2];\n    assign read2_tree[tree_index] = read2_tree[2*tree_index+1] | read2_tree[2*tree_index+2];\n  end\n  always_comb begin\n    if (rs1_addr == 5'b0) rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = read1_tree[0];\n    if (rs2_addr == 5'b0) rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = read2_tree[0];\n  end\nendmodule\n''')\nprint('Scratch prototype ready',root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
