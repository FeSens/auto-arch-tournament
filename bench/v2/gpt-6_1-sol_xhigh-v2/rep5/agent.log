{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe')\nfor name in ('rightshare','logicfactor'):\n rtl=root/name;rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n p=rtl/'alu.sv';s=p.read_text()\n if name=='rightshare':\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  wire [31:0] right_logical = a >> b[4:0];\n  wire [31:0] right_keep = 32'hffffffff >> b[4:0];\n  wire [31:0] right_value = right_logical | (~right_keep & {32{op == ALU_SRA && a[31]}});\n''')\n  s=s.replace('ALU_SRL:    out = a >> shamt;', 'ALU_SRL:    out = right_value;')\n  s=s.replace('ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"', 'ALU_SRA:    out = right_value;')\n else:\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  wire [32:0] difference = {1'b0,a} - {1'b0,b};\n  wire signed_less = (a[31] \"'!= b[31]) ? a[31] : difference[31];\n  wire logic_both = op == ALU_AND || op == ALU_OR;\n  wire logic_either = op == ALU_OR || op == ALU_XOR;\n  wire [31:0] logic_value;\n  for (genvar i=0;i<32;i++) begin : g_logic\n    assign logic_value[i] = (a[i] && b[i]) ? logic_both : ((a[i] || b[i]) && logic_either);\n  end\n'\"''')\n  s=s.replace('ALU_SUB:    out = a - b;', 'ALU_SUB:    out = difference[31:0];')\n  s=s.replace('ALU_AND:    out = a & b;', 'ALU_AND:    out = logic_value;')\n  s=s.replace('ALU_OR:     out = a | b;', 'ALU_OR:     out = logic_value;')\n  s=s.replace('ALU_XOR:    out = a \"'^ b;'\"', 'ALU_XOR:    out = logic_value;')\n  s=s.replace(\\\"out = {31'b0, \"'$signed(a) < $signed(b)};\", \"out = {31'\"'b0, signed_less};\\\")\n  s=s.replace(\\\"out = {31'b0, a < b};\\\", \\\"out = {31'b0, difference[32]};\\\")\n p.write_text(s)\nprint('Prepared local ALU factoring probes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
