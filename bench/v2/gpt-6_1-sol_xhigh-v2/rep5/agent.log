{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path.cwd()\nprobe=root/'cores/bench/generated/hypothesis_probe/r11_rf_control'\nrtl=probe/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in (root/'cores/bench/generated/hypothesis_probe/r11_rf_predecode/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'id_stage.sv'\ns=p.read_text().replace('  input  producer_tag_t     next_ex_tag,','  input  producer_tag_t     next_ex_tag,\\\\n  input  producer_tag_t     next_wb_tag,')\ns=s.replace('  output logic [31:1]       rs2_read_select,','  output logic [31:1]       rs2_read_select,\\\\n  output logic              rs1_writefirst,\\\\n  output logic              rs2_writefirst,')\npos=s.index('  ctrl_t ctrl_decoded;')\ns=s[:pos]+'''  // WB on the next edge is the currently accepted MEM producer.\n  always_ff @(posedge clock) begin\n    if (reset || squash) begin\n      rs1_writefirst <= 1'b0;\n      rs2_writefirst <= 1'b0;\n    end else if (stall) begin\n      rs1_writefirst <= decoded_q.valid && next_wb_tag.writer && next_wb_tag.rd \"'!= 0 &&\n                        next_wb_tag.rd == decoded_q.rs1_addr;\n      rs2_writefirst <= decoded_q.valid && next_wb_tag.writer && next_wb_tag.rd != 0 &&\n                        next_wb_tag.rd == decoded_q.rs2_addr;\n    end else begin\n      rs1_writefirst <= in.valid && next_wb_tag.writer && next_wb_tag.rd != 0 &&\n                        next_wb_tag.rd == in.instr[19:15];\n      rs2_writefirst <= in.valid && next_wb_tag.writer && next_wb_tag.rd != 0 &&\n                        next_wb_tag.rd == in.instr[24:20];\n    end\n  end\n\n'\"''' + s[pos:]\np.write_text(s)\np=rtl/'reg_file.sv'\ns=p.read_text().replace('  input  logic [31:1] rs2_read_select,','  input  logic [31:1] rs2_read_select,\\\\n  input  logic        rs1_writefirst,\\\\n  input  logic        rs2_writefirst,')\ns=s.replace('else if (w_en && w_addr == rs1_addr)','else if (PREDECODED_READS ? rs1_writefirst : w_en && w_addr == rs1_addr)')\ns=s.replace('else if (w_en && w_addr == rs2_addr)','else if (PREDECODED_READS ? rs2_writefirst : w_en && w_addr == rs2_addr)')\np.write_text(s)\np=rtl/'core.sv'\ns=p.read_text().replace('  logic [31:1] rs1_read_select_w, rs2_read_select_w;','  logic [31:1] rs1_read_select_w, rs2_read_select_w;\\\\n  logic rs1_writefirst_w, rs2_writefirst_w;\\\\n  producer_tag_t next_wb_tag_w;\\\\n  assign next_wb_tag_w.rd = wb_accepted.rd;\\\\n  assign next_wb_tag_w.writer = \"'!reset && !hold_mem_wb && wb_accepted.w_en;'\"')\ns=s.replace('    .next_ex_tag (next_ex_tag),','    .next_ex_tag (next_ex_tag),\\\\n    .next_wb_tag (next_wb_tag_w),')\ns=s.replace('    .rs1_read_select(rs1_read_select_w), .rs2_read_select(rs2_read_select_w),','    .rs1_read_select(rs1_read_select_w), .rs2_read_select(rs2_read_select_w),\\\\n    .rs1_writefirst(rs1_writefirst_w), .rs2_writefirst(rs2_writefirst_w),')\np.write_text(s)\ntests=probe/'test'\ntests.mkdir(exist_ok=True)\nfor p in (root/'cores/bench/test').glob('*.py'):\n shutil.copy2(p,tests/p.name)\nprint(probe)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
