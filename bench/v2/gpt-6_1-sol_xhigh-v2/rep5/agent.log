.value = pc\n            dut.train_eligible.value = eligible\n            dut.train_jump.value = jump\n            dut.train_taken.value = taken\n            dut.train_target.value = target\n        await Timer(1, \"ns\")\n        pc = int(dut.imem_addr.value)\n        row = table.get((pc >> 2) & 31, (0, 0, 0, 0))\n \n…[5995 of 9067 chars elided by tools/bench/transcript.py; sha256:5e893edd051afe6d]…\nrt int(dut.imem_addr.value) == 0x80000100\n    dut.train_valid.value = 1\n    dut.train_target.value = 0xF0000200\n    await _edge(dut)\n    dut.train_valid.value = 0\n    await _edge(dut)\n    assert int(dut.occupancy_q.value) == 3\n    assert _record(int(dut.out.value)) == old, \"queued prediction changed at table commit\"\n    dut.redirect.value = 1\n    dut.redirect_target.value = 0\n    dut.imem_ready.value = 0\n    await Timer(1, \"ns\")\n    assert _record(int(dut.out.value)) == old, \"raw registered head depended on recovery\"\n    await _edge(dut)\n    assert not _record(int(dut.out.value))[\"valid\"]\n    assert int(dut.occupancy_q.value) == 0 and int(dut.imem_addr.value) == 0\n    dut.redirect.value = 0\n    dut.imem_ready.value = 1\n    await _edge(dut)\n    new = _record(int(dut.out.value))\n    assert new[\"prediction_selected\"] and new[\"predicted_target\"] == 0xF0000200\n    assert int(dut.imem_addr.value) == 0xF0000200\n\n\ndef test_if_stage_runner():\n    run_cocotb(\"if_stage\", [\"core_pkg.sv\", \"if_stage.sv\"], \"test_if_stage\")\n", "exit_code": 0, "status": "completed"}}
