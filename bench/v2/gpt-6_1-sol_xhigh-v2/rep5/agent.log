{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '265,350p' cores/bench/test/test_alu.py; sed -n '200,280p' tools/eval/gowin.py; cat tools/eval/cosim.py; cat test/cosim/build.sh; cat formal/checks_si.cfg\"", "aggregated_output": "async def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Real divides only (avoid edge-case short-circuit) so each pass\n    # exercises the full 32 restoring steps.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\ndef _signed(value):\n    return value if value < 0x80000000 else value - (1 << 32)\n\n\ndef _division_expected(op, a, b):\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        sa, sb = _signed(a), _signed(b)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK32\n    return (a % b if op == ALU_REMU else a // b) & MASK32\n\n\n@cocotb.test()\nasync def division_corners_and_random(dut):\n    await _setup(dut)\n    rng = random.Random(0xD1A1DE)\n    corners = [0, 1, 2, 3, 0x7FFFFFFF, 0x80000000, 0x80000001, 0xFFFFFFFE, MASK32]\n    pairs = [(a, b) for a in corners for b in corners]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(128)]\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in pairs:\n            await _check_div(dut, op, a, b, _division_expected(op, a, b))\n\n\n@cocotb.test()\nasync def multiplication_exact_vectors(dut):\n    await _setup(dut)\n    rng = random.Random(0xA11)\n    for _ in range(64):\n        a, b = rng.getrandbits(32), rng.getrandbits(32)\n        await _check(dut, ALU_MUL, a, b, a * b)\n        await _check(dut, ALU_MULH, a, b, (_signed(a) * _signed(b)) >> 32)\n        await _check(dut, ALU_MULHU, a, b, (a * b) >> 32)\n        await _check(dut, ALU_MULHSU, a, b, (_signed(a) * b) >> 32)\n\n\n@cocotb.test()\nasync def reset_cancels_division(du\n…[13784 of 16856 chars elided by tools/bench/transcript.py; sha256:8c43f7570cdb05f6]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
