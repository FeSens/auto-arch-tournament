{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv; cat cores/bench/rtl/hazard_unit.sv; cat cores/bench/rtl/if_stage.sv; cat cores/bench/test/test_pipeline.py'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Resolves the operand muxes (forwarding from EX/MEM and\n// MEM/WB), runs the ALU, resolves branches, computes the redirect\n// target. Owns the EX/MEM pipeline register.\n//\n// Forwarding select encoding (driven by forward_unit):\n//   00 = ID/EX register value (no forward)\n//   01 = EX/MEM aluResult (instruction immediately ahead in MEM)\n//   10 = MEM/WB result (instruction two ahead, post regfile-write mux)\n//\n// Latency:        1 cycle (EX/MEM register clocked here).\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               div_ready,     // downstream accepts completed division\n  input  id_ex_t   in,\n  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // WB-stage write-data mux output\n  output ex_mem_t  out,\n  output logic               execute_busy,  // hold IF + ID/EX, let MEM + WB drain\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result, div_res\n…[29269 of 32341 chars elided by tools/bench/transcript.py; sha256:8f305347e0ca7afd]…\ndut):\n    program = [ADDI(1, 0, 42), ADDI(2, 0, 7), DIVU(3, 1, 2), SW(3, 0, 0),\n               BEQ(3, 3, 8), SW(1, 0, 4), ADDI(4, 3, 1), EBREAK()]\n    events = []\n    rets, dmem = await _run(dut, program, max_cycles=150,\n                           ready=lambda c: (int(c % 5 != 2), int(not 38 <= c < 55)),\n                           bus_events=events)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 24, 28]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert rets[-2][\"rd_wdata\"] == 7\n    assert dmem == {0: 6}\n    assert [(e[1], e[2]) for e in events] == [(\"store\", 0)]\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
