{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_ex_stage.py && sed -n '1,300p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Completion acceptance, capture, and drain bubbles under direct EX stalls.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_MUL, run_cocotb\n\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"prediction_selected\", 1), (\"predicted_target\", 32),\n         (\"direct_target\", 32), (\"direct_target_match\", 1),\n         (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, values):\n    packed = 0\n    for name, width in layout:\n        packed = (packed << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return packed\n\n\ndef _unpack(layout, packed):\n    values = {}\n    for name, width in reversed(layout):\n        values[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    return values\n\n\ndef _drive(dut, values):\n    getattr(dut, \"in\").value = _pack(ID_EX, values)\n\n\nasync def _cycle(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    assert len(getattr(dut, \"in\")) == 264 and len(dut.out) == 295\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.div_ready.value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    _drive(dut, {})\n    await _cycle\n…[16043 of 19115 chars elided by tools/bench/transcript.py; sha256:d3fe34859ba09413]…\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
