{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"mkdir -p cores/bench/generated/hypothesis_probe/queue4_current/rtl\npython - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe/queue4_current')\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copyfile(p,root/'rtl'/p.name)\np=root/'rtl/hazard_unit.sv'\ns=p.read_text().replace('load_use_hazard || imem_stall || dmem_stall || execute_busy','load_use_hazard || dmem_stall || execute_busy')\np.write_text(s)\np=root/'rtl/if_stage.sv'\ns=p.read_text()\na=s.index('  // Actual recovery overrides')\ns=s[:a]+'''  typedef struct packed {\n    logic [31:0] instr;\n    logic prediction_selected;\n    logic [29:0] target;\n  } fetch_entry_t;\n  fetch_entry_t queue_q [0:3];\n  logic [2:0] count_q;\n  logic [31:0] dequeue_pc_q;\n  logic id_accept, bus_accept, pop, push;\n  logic [2:0] push_index;\n  assign id_accept = \"'!stall && out.valid && !reset;\n  assign bus_accept = imem_ready && (count_q < 3'\"'d4 || id_accept) && \"'!redirect && !reset;\n  assign pop = count_q != 0 && id_accept;\n  assign push = bus_accept && !(count_q == 0 && id_accept);\n  assign push_index = count_q - {2'\"'b0, pop};\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      dequeue_pc_q <= RESET_PC;\n      count_q <= 0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      dequeue_pc_q <= redirect_target;\n      count_q <= 0;\n    end else begin\n      if (bus_accept) pc <= next_pc;\n      if (id_accept) dequeue_pc_q <= out.prediction_selected\n                                     ? out.predicted_target : dequeue_pc_q + 32'd4;\n      case ({push,pop})\n        2'b10: count_q <= count_q + 3'd1;\n        2'b01: count_q <= count_q - 3'd1;\n        default: ;\n      endcase\n      if (pop) begin\n        for (int i=0; i<3; i++) queue_q[i] <= queue_q[i+1];\n      end\n      if (push) begin\n        queue_q[push_index[1:0]].instr <= imem_data;\n        queue_q[push_index[1:0]].prediction_selected <= prediction_selected;\n        queue_q[push_index[1:0]].target <= targets[fetch_index];\n      end\n    end\n  end\n  assign imem_addr = pc;\n  always_comb begin\n    out.pc = dequeue_pc_q;\n    out.instr = count_q \"'!= 0 ? queue_q[0].instr : imem_data;\n    out.prediction_selected = count_q != 0 ? queue_q[0].prediction_selected : prediction_selected;\n    out.predicted_target = count_q != 0 ? {queue_q[0].target,2'\"'b00} : {targets[fetch_index],2'b00};\n    out.valid = (count_q \"'!= 0 || imem_ready) && !redirect;\n  end\nendmodule\n'\"'''\np.write_text(s)\nprint('Created isolated queue probe:',root)\nPY\ncommand -v riscv32-unknown-elf-gcc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
