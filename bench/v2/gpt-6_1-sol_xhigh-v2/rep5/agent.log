GS  = --iterations $(N) --tournament-size $(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>\n…[71646 of 74718 chars elided by tools/bench/transcript.py; sha256:bc91f2164ae45213]…\nafter = [ADDI(1, 0, 13), ADDI(2, 1, 1), AUIPC(3, imm),\n             SW(2, 0, 108), SW(3, 0, 112), EBREAK()]\n    events = []\n    rets, dmem = await _run(dut, before, max_cycles=100,\n                           ready=lambda c: (1, int(c >= 15)),\n                           reset_cycle=12, after_reset=after, bus_events=events)\n    _check_linear(rets, after)\n    assert rets[1][\"rs1_rdata\"] == 13 and rets[1][\"rd_wdata\"] == 14\n    assert rets[2][\"rd_wdata\"] == 8 + imm\n    assert dmem == {108: 14, 112: 8 + imm}\n    assert [(e[1], e[2]) for e in events] == [(\"store\", 108), (\"store\", 112)]\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
