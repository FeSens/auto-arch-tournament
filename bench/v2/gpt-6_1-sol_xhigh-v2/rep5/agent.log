{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Completion acceptance, capture, and drain bubbles under direct EX stalls.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_MUL, ALU_DIVU, run_cocotb\n\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"prediction_selected\", 1), (\"predicted_target\", 32),\n         (\"direct_target\", 32), (\"direct_target_match\", 1),\n         (\"rs1_val\", 32), (\"rs2_val\", 32),\n         (\"alu_a_val\", 32), (\"alu_b_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, values):\n    packed = 0\n    for name, width in layout:\n        packed = (packed << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return packed\n\n\ndef _unpack(layout, packed):\n    values = {}\n    for name, width in reversed(layout):\n        values[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    return values\n\n\ndef _drive(dut, values):\n    ctrl = _unpack(CTRL, values.get(\"ctrl\", 0))\n    operands = dict(values)\n    operands.setdefault(\"alu_a_val\", values.get(\"pc\", 0) if ctrl[\"is_auipc\"]\n                        else values.get(\"rs1_val\", 0))\n    operands.setdefault(\"alu_b_val\", values.get(\"imm\", 0) if ctrl[\"alu_src\"]\n                        else values.get(\"rs2_val\", 0))\n    getattr(dut, \"in\").value = _pack(ID_EX, operands)\n\n\nasync def _cycle(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value\n…[16120 of 19192 chars elided by tools/bench/transcript.py; sha256:c11c5bdbf3535b59]…\ndict(pc=0x80, direct_target=target, prediction_selected=int(selected),\n                         valid=1, rd=5,\n                         ctrl=_pack(CTRL, dict(is_jump=int(not illegal), reg_write=int(not illegal),\n                                              is_illegal=int(illegal)))))\n        await _cycle(dut)\n        result = _unpack(EX_MEM, int(dut.out.value))\n        assert result[\"pc_next\"] == 0x84\n        ctrl = _unpack(CTRL, result[\"ctrl\"])\n        assert ctrl[\"is_illegal\"] and not ctrl[\"reg_write\"]\n        assert int(dut.train_valid.value) and not int(dut.train_eligible.value)\n        assert bool(int(dut.redirect.value)) == selected\n        assert int(dut.redirect_target.value) == 0x84\n    dut.reset.value = 1\n    await _cycle(dut)\n    assert int(dut.out.value) == 0 and not int(dut.train_valid.value)\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"multiplier.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
