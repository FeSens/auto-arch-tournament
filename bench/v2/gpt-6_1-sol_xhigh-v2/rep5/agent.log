{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv cores/bench/rtl/id_stage.sv'", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Next-cycle operand provenance. Match the sources entering (or held in)\n// ID/EX against the producers entering EX/MEM and MEM/WB at the same edge.\n// Core registers these one-hot controls before the EX operand datapath:\n//   001 (BASE)   : ID/EX register's rs?_val\n//   010 (EX_MEM) : the in-flight ALU result from the EX/MEM register\n//   100 (MEM_WB) : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds registered EX operand controls.\nmodule forward_unit (\n  input  logic [4:0] next_rs1,\n  input  logic [4:0] next_rs2,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == next_rs1) fwd_rs1 = 3'b010;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == next_rs1) fwd_rs1 = 3'b100;\n    else                                                               fwd_rs1 = 3'b001;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == next_rs2) fwd_rs2 = 3'b010;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == next_rs2) fwd_rs2 = 3'b100;\n    else                                                               fwd_rs2 = 3'b001;\n  end\n\nendmodule\n// rtl/id_stage.sv\n//\n// Decode stage. Combinationally drives the regfile read ports and the\n// ID/EX register's next-state from the IF/ID combinational bundle plus\n// the regfile read data. The ID/EX register is owned by this module so\n// the decoded view of instruction n is latched by end of cycle n+1.\n//\n// Latency:        1 cycle (ID/EX register clocked here).\n// RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata\n…[2923 of 5995 chars elided by tools/bench/transcript.py; sha256:a5597f6f5c17f31c]…\n ──────────────────────────────────────────────────────\n  id_ex_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (!stall) begin\n      if (!in.valid) begin\n        reg_q <= '0;\n      end else begin\n        reg_q.pc       <= in.pc;\n        reg_q.prediction_selected <= in.prediction_selected;\n        reg_q.predicted_target <= in.predicted_target;\n        reg_q.direct_target <= direct_target;\n        reg_q.direct_target_match <= direct_target == in.predicted_target;\n        reg_q.rs1_val  <= rs1_data;\n        reg_q.rs2_val  <= rs2_data;\n        reg_q.imm      <= imm;\n        reg_q.rd       <= in.instr[11:7];\n        reg_q.rs1_addr <= in.instr[19:15];\n        reg_q.rs2_addr <= in.instr[24:20];\n        reg_q.ctrl     <= ctrl_decoded;\n        reg_q.instr    <= in.instr;\n        reg_q.valid    <= in.valid;\n      end\n    end else begin\n      reg_q.rs1_val <= forwarded_rs1;\n      reg_q.rs2_val <= forwarded_rs2;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
