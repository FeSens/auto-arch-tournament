{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe')\nfor variant in ['prequalified','prequalified_training1']:\n base=root/variant\n (base/'rtl').mkdir(parents=True,exist_ok=True)\n src=root/'training1/rtl' if variant.endswith('training1') else Path('cores/bench/rtl')\n for p in src.glob('*.sv'):\n  shutil.copy2(p,base/'rtl'/p.name)\n p=base/'rtl/core_pkg.sv'\n s=p.read_text()\n old='    logic        direct_target_match;'\n s=s.replace(old,old+'\\\\n    logic        prediction_wrong_taken;\\\\n    logic        prediction_wrong_not_taken;\\\\n    logic        prediction_train_eligible;')\n p.write_text(s)\n p=base/'rtl/id_stage.sv'\n s=p.read_text()\n marker='  // Regfile read addresses come straight'\n logic='''  logic prediction_wrong_taken, prediction_wrong_not_taken;\n  logic prediction_train_eligible;\n  always_comb begin\n    prediction_wrong_taken = in.prediction_selected;\n    prediction_wrong_not_taken = in.prediction_selected;\n    prediction_train_eligible = \"'!dec_is_illegal && (dec_is_branch || (dec_is_jump && !dec_is_jalr))\n                                && direct_target[1:0] == 2'\"'b00;\n    if (prediction_train_eligible) begin\n      prediction_wrong_taken = \"'!in.prediction_selected || direct_target != in.predicted_target;\n      if (dec_is_jump) prediction_wrong_not_taken = prediction_wrong_taken;\n    end\n  end\n\n'\"'''\n s=s.replace(marker,logic+marker)\n marker='        reg_q.direct_target_match <= direct_target == in.predicted_target;'\n s=s.replace(marker,marker+'''\n        reg_q.prediction_wrong_taken <= prediction_wrong_taken;\n        reg_q.prediction_wrong_not_taken <= prediction_wrong_not_taken;\n        reg_q.prediction_train_eligible <= prediction_train_eligible;''')\n p.write_text(s)\n p=base/'rtl/ex_stage.sv'\n s=p.read_text()\n start=s.index('  // Branch direction arrives')\n end=s.index('  // Training and stale prediction recovery',start)\n s=s[:start]+'''  // Decode prequalifies both possible direct-branch outcomes.\n  // Pending operations use captured controls and registered indirect targets.\n  always_comb begin\n    prediction_wrong = branch_cond ? in.prediction_wrong_taken : in.prediction_wrong_not_taken;\n    if (pending_q) begin\n      prediction_wrong = pending_prediction_q;\n      if (\"'!pending_payload_q.ctrl.is_illegal && pending_payload_q.ctrl.is_jump)\n        prediction_wrong = !pending_prediction_q || pending_payload_q.branch_target != pending_predicted_target_q;\n    end\n  end\n\n'\"'''+s[end:]\n start=s.index('  assign train_eligible =')\n end=s.index('  assign train_jump =',start)\n s=s[:start]+'''  assign train_eligible = pending_q\n                        ? (\"'!pending_payload_q.ctrl.is_illegal && pending_payload_q.ctrl.is_jump\n                            && pending_payload_q.branch_target[1:0] == 2'\"'b00)\n                        : in.prediction_train_eligible;\n'''+s[end:]\n p.write_text(s)\n (base/'test').mkdir(exist_ok=True)\n for p in Path('cores/bench/test').glob('*.py'):\n  shutil.copy2(p,base/'test'/p.name)\n print('Prepared',variant)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
