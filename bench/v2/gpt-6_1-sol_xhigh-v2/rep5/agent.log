{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport struct,json\nr=list(struct.iter_unpack('<IIBBB',open('cores/bench/.hyp_probe_r13s2/control.bin','rb').read()))\nfor bits in (5,6,7,8,9):\n ct={};btb={};miss=[0,0,0];h=0;mask=(1<<bits)-1\n for pc,target,op,taken,active in r:\n  if op==0x6f:continue\n  if op==0x63:\n   ix=((pc>>2)\"'^h)&mask;c=ct.get(ix,1)\n   if active and int(c>=2)!=taken:miss[0]+=1\n   ct[ix]=min(3,c+1) if taken else max(0,c-1)\n   h=((h<<1)|taken)&mask\n  else:\n   ix=(pc>>2)&31;rt=btb.get(ix)\n   if active and rt!=(pc,target):miss[2]+=1\n   btb[ix]=(pc,target)\n print(json.dumps({'\"'gshare_bits':bits,'misses':miss,'total':sum(miss)}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
