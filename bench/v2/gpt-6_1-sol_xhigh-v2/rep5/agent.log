{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"sed -n '1,210p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// fetch flop here; the next stage captures a decoded record only when it\n// has capacity. That record may drain independently of imem_ready.\n//\n// The inline tagged predictor chooses the next accepted fetch PC. Raw\n// instruction bits and lookup metadata never depend on EX recovery;\n// validity separately prevents unavailable or wrong-path work entering ID.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              redirect,         // accepted registered MEM recovery\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  input  logic              train_valid,      // exactly one MEM acceptance\n  input  logic [31:0]       train_pc,\n  input  logic              train_eligible,   // legal, aligned control transfer\n  input  logic              train_jump,\n  input  logic              train_taken,\n  input  logic [31:0]       train_target,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] valid_q;\n  logic [24:0] tags [0:31];\n  logic [29:0] targets [0:31];\n  logic [1:0] counters [0:31];\n  logic [4:0] fetch_index, train_index;\n  logic fetch_hit, train_hit, prediction_selected;\n\n  assign fetch_index = pc[6:2];\n  assign train_index = train_pc[6:2];\n  assign fetch_hit = valid_q[fetch_index] && tags[fetch_index] == pc[31:7];\n  assign train_hit = valid_q[train_index] && tags[train_index] == train_pc[31:7];\n  assign prediction_selected = fetch_hit && counters[fetch_index][1];\n\n  // Only validity needs reset. Invalid entries cannot select a target.\n  // Training uses the current tag, so an old resolution cannot invalidate\n  // an unrelated entry sharing its index.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      valid_q <= '0;\n    end else if (train_valid) begin\n      if (train_eligible && train_pc[1:0] == 2'b00 && train_target[1:0] == 2'b00) begin\n        valid_q[train_index] <= 1'b1;\n        tags[train_index] <= train_pc[31:7];\n        targets[train_index] <= train_target[31:2];\n        if (train_jump) counters[train_index] <= 2'b11;\n        else if (!train_hit) counters[train_index] <= train_taken ? 2'b10 : 2'b01;\n        else if (train_taken) begin\n          if (counters[train_index] != 2'b11)\n            counters[train_index] <= counters[train_index] + 2'b01;\n        end else begin\n          if (counters[train_index] != 2'b00)\n            counters[train_index] <= counters[train_index] - 2'b01;\n        end\n      end else if (train_hit) valid_q[train_index] <= 1'b0;\n    end\n  end\n\n  always_comb begin\n    next_pc = prediction_selected ? {targets[fetch_index], 2'b00} : pc + 32'd4;\n  end\n\n  // Accepted registered recovery overrides instruction-bus, load-use and\n  // younger blocking-operation holds. Held MEM records cannot recover.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_data;\n    out.prediction_selected = prediction_selected;\n    out.predicted_target = {targets[fetch_index], 2'b00};\n    out.valid = imem_ready && !redirect;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
