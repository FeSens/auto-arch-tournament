{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"ls -la formal; cat tools/eval/formal.py; sed -n '1,270p' tools/eval/cosim.py; rg -n 'def |placement|option|TMP|symlink' tools/eval/gowin.py test/cosim/build.sh\"", "aggregated_output": "total 56\ndrwxrwx---+  2 nobody nogroup  4096 Oct  2 06:52 .\ndrwxrwx---+ 12 nobody nogroup  4096 Oct  2 06:53 ..\n-rw-rw----+  1 nobody nogroup  2630 Oct  2 06:52 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Oct  2 06:52 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Oct  2 06:52 checks_si.cfg\nlrwxrwxrwx   1 nobody nogroup    66 Oct  2 06:52 riscv-formal -> /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep5/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Oct  2 06:52 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Oct  2 06:52 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Oct  2 06:52 wrapper_si.sv\n\"\"\"Runs the real riscv-formal suite via formal/run_all.sh.\n\nThe real suite is generated at runtime by formal/run_all.sh (which invokes\ngenchecks.py against our rtl/*.sv + wrapper.sv + checks.cfg) and runs the\n~45 I-base / M-ext insn checks plus reg / pc_fwd / pc_bwd / causal /\nunique / cover / ill / liveness — 53 total against the V0 baseline.\n\nIf genchecks.py crashes mid-run and only emits one .sby task that\nvacuously passes, the old `passed > 0 and failed == 0` rule would\nreturn success. EXPECTED_MIN_CHECKS prevents that.\n\"\"\"\nimport os, shutil, subprocess, json, re, uuid\nfrom pathlib import Path\n\nimport yaml\n\nfrom tools.eval._subprocess import run_pgroup\n\n\ndef read_nret(core_yaml_path: Path) -> int:\n    \"\"\"Read the `nret` field from a core.yaml. Defaults to 2 when the file\n    or field is missing — preserves backward compat with cores authored\n    before the nret-aware fixture (every existing core today).\n\n    Only 1 and 2 are supported. NRET=1 selects the single-issue formal\n    wrapper (wrapper_si.sv + checks_si.cfg); NRET=2 uses the dual-channel\n    default (wrapper.sv + checks.cfg).\n    \"\"\"\n    p = Path(core_yaml_path)\n    if not p.exists():\n        return 2\n    y = yaml.safe_load(p.read_text()) or {}\n    n = y.get(\"nret\", 2)\n    if n not in (1, 2):\n        raise ValueError(f\"core.yaml nret must be 1 or 2, got {n!r}\")\n    return n\n\n# Floor on how many .sby tasks must pass for a \"formal: green\" result.\n# \n…[20583 of 23655 chars elided by tools/bench/transcript.py; sha256:fb1b03b8ea6f0355]…\ny:208:    ap.add_argument(\"--all-options\", action=\"store_true\",\ntools/eval/gowin.py:209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\ntools/eval/gowin.py:212:    opts = PLACE_OPTIONS if a.all_options else PLACE_OPTIONS[:1]\ntools/eval/gowin.py:214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\ntools/eval/gowin.py:216:        if r[\"placement_failed\"]:\ntools/eval/gowin.py:217:            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\ntools/eval/gowin.py:219:        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\ntools/eval/gowin.py:221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\ntools/eval/gowin.py:226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\ntools/eval/gowin.py:228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n", "exit_code": 0, "status": "completed"}}
