{"type": "item.started", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/generated/hypothesis_probe/queue3'); rtl=base/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv'; s=p.read_text(); s=s.replace('logic        prediction_selected;', 'logic        frontier;\\\\n    logic        prediction_selected;',1); s=s.replace('logic        prediction_selected;', 'logic        prediction_selected;',1)\n# Add markers to the registered instruction payloads.\ns=s.replace('logic        prediction_selected;\\\\n    logic [31:0] predicted_target;\\\\n    logic [31:0] direct_target;', 'logic        prediction_selected;\\\\n    logic        frontier;\\\\n    logic [31:0] predicted_target;\\\\n    logic [31:0] direct_target;')\ns=s.replace('logic        branch_taken;', 'logic        frontier;\\\\n    logic        branch_taken;')\np.write_text(s)\np=rtl/'id_stage.sv'; s=p.read_text().replace('reg_q.prediction_selected <= in.prediction_selected;', 'reg_q.prediction_selected <= in.prediction_selected;\\\\n          reg_q.frontier <= in.frontier;'); p.write_text(s)\np=rtl/'ex_stage.sv'; s=p.read_text().replace('output logic               train_valid,','output logic               train_frontier,\\\\n  output logic               train_valid,'); s=s.replace('payload.branch_taken = branch_taken;', 'payload.frontier = in.frontier;\\\\n      payload.branch_taken = branch_taken;'); s=s.replace('{295{', '{\"'$bits(ex_mem_t){'\"'); s=s.replace('assign train_pc = reg_q.pc;', 'assign train_frontier = reg_q.frontier;\\\\n  assign train_pc = reg_q.pc;'); p.write_text(s)\np=rtl/'core.sv'; s=p.read_text(); s=s.replace('logic        train_valid, train_eligible, train_jump, train_taken;', 'logic        train_valid, train_eligible, train_jump, train_taken, train_frontier;'); s=s.replace('.train_valid     (train_valid),', '.train_valid     (train_valid),\\\\n    .train_frontier  (train_frontier),'); s=s.replace('.imem_ready     (io_imemReady)', '.imem_ready     (1\\\\'b1)'); p.write_text(s)\np=rtl/'if_stage.sv'; s=p.read_text(); s=s.replace('input  logic              train_valid,', 'input  logic              train_frontier,\\\\n  input  logic              train_valid,'); start=s.index('  // Accepted registered recovery'); s=s[:start]+'''\n  localparam integer DEPTH = 3;\n  localparam integer CW = \"'$clog2(DEPTH+1);\n  logic [CW-1:0] count_q, append_index;\n  logic push, pop, frontier_wait_q;\n  logic [31:0] frontier_successor_q;\n  if_id_t snapshot;\n  wire [$bits(if_id_t)-1:0] words [0:DEPTH];\n  assign words[DEPTH] = '\"'0;\n  assign pop = count_q \"'!= 0 && !stall && !redirect && !reset;\n  assign push = imem_ready && count_q < DEPTH && !frontier_wait_q && !redirect && !reset;\n  assign append_index = count_q - CW'\"'(pop);\n  always_comb begin\n    snapshot = '0;\n    snapshot.pc = pc;\n    snapshot.instr = imem_data;\n    snapshot.prediction_selected = prediction_selected;\n    snapshot.predicted_target = {targets[fetch_index],2'b00};\n    snapshot.frontier = next_pc[31:20] \"'!= 0;\n    snapshot.valid = 1'\"'b1;\n  end\n  for (genvar i=0; i<DEPTH; i++) begin : g_queue\n    logic [\"'$bits(if_id_t)-1:0] word_q;\n    always_ff @(posedge clock) begin\n      if (push && append_index == CW'\"'(i)) word_q <= snapshot;\n      else if (pop) word_q <= words[i+1];\n    end\n    assign words[i] = word_q;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      count_q <= '0;\n      frontier_wait_q <= 1'b0;\n      frontier_successor_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count_q <= '0;\n      frontier_wait_q <= 1'b0;\n    end else begin\n      case ({push,pop})\n        2'b10: count_q <= count_q + CW'(1);\n        2'b01: count_q <= count_q - CW'(1);\n        default: count_q <= count_q;\n      endcase\n      if (frontier_wait_q && train_valid && train_frontier) begin\n        pc <= frontier_successor_q;\n        frontier_wait_q <= 1'b0;\n      end else if (push) begin\n        if (snapshot.frontier) begin\n          frontier_wait_q <= 1'b1;\n          frontier_successor_q <= next_pc;\n        end else pc <= next_pc;\n      end\n    end\n  end\n  assign imem_addr = pc;\n  always_comb begin\n    out = words[0];\n    out.valid = count_q \"'!= 0 && !redirect;\n  end\nendmodule\n'\"'''; p.write_text(s)\nprint(base)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
