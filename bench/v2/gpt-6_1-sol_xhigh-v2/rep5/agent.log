via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[12139 of 15211 chars elided by tools/bench/transcript.py; sha256:54502211248f3068]…\nme, 'field': 'crc_mismatch',\ntools/eval/cosim.py:122:    return {'passed': True, 'elf': coremark_elf.name}\ntools/eval/cosim.py:125:def run_cosim(worktree: str, target: str | None = None) -> dict:\ntools/eval/cosim.py:148:    # Split ELFs into full-trace cosim vs CRC-validated coremark.\ntools/eval/cosim.py:150:    trace_elfs = [p for p in all_elfs if p.name != \"coremark.elf\"]\ntools/eval/cosim.py:151:    coremark   = next((p for p in all_elfs if p.name == \"coremark.elf\"), None)\ntools/eval/cosim.py:153:    if not trace_elfs and coremark is None:\ntools/eval/cosim.py:158:        futures = {pool.submit(run_one, elf, sim_bin, worktree, env, flags): elf\ntools/eval/cosim.py:169:    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\ntools/eval/cosim.py:170:    if coremark is not None:\ntools/eval/cosim.py:171:        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\ntools/eval/cosim.py:179:    tested = len(trace_elfs) + (1 if coremark else 0)\ntools/eval/cosim.py:184:    result = run_cosim(\n", "exit_code": 0, "status": "completed"}}
