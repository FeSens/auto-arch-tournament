{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport struct,json\nr=list(struct.iter_unpack('<IIBBB',open('cores/bench/.hyp_probe_r13s2/control.bin','rb').read()))\nfor hbits in (0,1,2,3):\n for fallback in (False,True):\n  rows={};miss=[0,0,0];mask=(1<<hbits)-1;patterns=1<<hbits\n  for pc,target,op,taken,active in r:\n   if op==0x6f:continue\n   idx=(pc>>2)&31;row=rows.get(idx);hit=row is not None and row[0]==pc\n   pred=int(row is not None and hit and row[3][row[2]]>=2)\n   pt=row[1] if hit else 0\n   if fallback and not hit and op==0x63:pred=int(target<pc);pt=target\n   if active and (pred\"'!=taken or taken and pt!=target):miss[0 if op==0x63 else 2]+=1\n   if not hit:\n    if not taken and op==0x63:continue\n    rows[idx]=(pc,target,taken&mask,[3 if op!=0x63 else 2]*patterns)\n   elif op!=0x63:rows[idx]=(pc,target,0,[3]*patterns)\n   else:\n    _,_,h,c=row;c[h]=min(3,c[h]+1) if taken else max(0,c[h]-1)\n    rows[idx]=(pc,target,((h<<1)|taken)&mask,c)\n  print(json.dumps({'\"'history_bits':hbits,'btfnt':fallback,'taken_alloc':True,'misses':miss,'total':sum(miss)}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
