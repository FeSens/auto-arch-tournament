     (\"predicted_target\", 32), (\"valid\", 1)]\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n…[14215 of 17287 chars elided by tools/bench/transcript.py; sha256:2a8b92b19f74a06d]…\nommits independently of every pipeline hold.\"\"\"\n    table = {}\n    pending = None\n    for s in events:\n        assert s[\"training_pending\"] == int(pending is not None)\n        assert s[\"btb_valid\"] == sum(1 << i for i, row in table.items() if row[0])\n        if pending is not None:\n            index, tag, eligible, jump, taken, target = pending\n            valid, row_tag, counter, old_target = table.get(index, (0, 0, 0, 0))\n            assert s[\"training_index\"] == index and s[\"training_tag\"] == tag\n            assert s[\"row_valid\"] == valid\n            if valid:\n                assert (s[\"row_tag\"], s[\"row_counter\"]) == (row_tag, counter)\n            hit = bool(valid and row_tag == tag)\n            assert s[\"commit_write\"] == int(eligible or hit)\n            if eligible:\n                if jump:\n                    counter = 3\n                elif not hit:\n                    counter = 2 if taken else 1\n                else:\n                    counter = min(counter + 1, 3) if taken else max(counter - 1, 0)\n", "exit_code": 0, "status": "completed"}}
