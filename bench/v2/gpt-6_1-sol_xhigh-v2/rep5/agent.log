e \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[18366 of 21438 chars elided by tools/bench/transcript.py; sha256:16fb3e9de807547c]…\nert int(dut.out.value) == 0\n    assert not int(dut.train_valid.value) and not int(dut.redirect.value)\n\n\n@cocotb.test()\nasync def indirect_target_capture_alignment_and_prediction(dut):\n    await _setup(dut)\n    for base, imm, predicted, expected_target, trap in (\n            (59, 5, False, 64, False),\n            (0x43, 0, False, 0x42, True),\n            (63, 1, True, 64, False)):\n        instruction = dict(pc=0x80, rs1_val=base, rs2_val=17, imm=imm, rd=5,\n                           rs1_addr=1, instr=0x000082E7, valid=1,\n                           prediction_selected=int(predicted), predicted_target=64,\n                           ctrl=_pack(CTRL, dict(alu_op=ALU_ADD, alu_src=1,\n                                                 is_jump=1, is_jalr=1, reg_write=1)))\n        _drive(dut, instruction)\n        await Timer(1, \"ns\")\n        assert int(dut.execute_busy.value), \"even predicted JALR must hold at launch\"\n        assert not int(dut.train_valid.value) and not int(dut.redirect.value)\n        await _cycle(dut)\n", "exit_code": 0, "status": "completed"}}
