{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"sed -n '1,95p' cores/bench/test/test_ex_stage.py\"","aggregated_output":"\"\"\"Completion acceptance, capture, and drain bubbles under direct EX stalls.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_ADD, ALU_MUL, ALU_DIVU, run_cocotb\n\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"prediction_selected\", 1), (\"predicted_target\", 32),\n         (\"direct_target\", 32), (\"direct_target_match\", 1),\n         (\"rs1_val\", 32), (\"rs2_val\", 32),\n         (\"alu_a_val\", 32), (\"alu_b_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, values):\n    packed = 0\n    for name, width in layout:\n        packed = (packed << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return packed\n\n\ndef _unpack(layout, packed):\n    values = {}\n    for name, width in reversed(layout):\n        values[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    return values\n\n\ndef _drive(dut, values):\n    ctrl = _unpack(CTRL, values.get(\"ctrl\", 0))\n    operands = dict(values)\n    operands.setdefault(\"alu_a_val\", values.get(\"pc\", 0) if ctrl[\"is_auipc\"]\n                        else values.get(\"rs1_val\", 0))\n    operands.setdefault(\"alu_b_val\", values.get(\"imm\", 0) if ctrl[\"alu_src\"]\n                        else values.get(\"rs2_val\", 0))\n    getattr(dut, \"in\").value = _pack(ID_EX, operands)\n\n\nasync def _cycle(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _setup(dut):\n    assert len(getattr(dut, \"in\")) == 328 and len(dut.out) == 295\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.div_ready.value = 0\n    dut.squash.value = 0\n    _drive(dut, {})\n    await _cycle(dut)\n    dut.reset.value = 0\n\n\n@cocotb.test()\nasync def multiply_completion_held_and_stale_prediction(dut):\n    await _setup(dut)\n    # An older memory request must survive a stall before slow launch.\n    store = dict(pc=0x1C, rs1_val=100, rs2_val=55, instr=0x0220A023,\n                 valid=1, ctrl=_pack(CTRL, dict(alu_op=ALU_ADD, alu_src=1,\n                                               mem_write=1, mem_width=2)))\n    _drive(dut, store)\n    await _cycle(dut)\n    older = int(dut.out.value)\n    instruction = dict(pc=0x20, rs1_val=1, rs2_val=2, rd=3,\n                       rs1_addr=1, rs2_addr=2, instr=0x022081B3, valid=1,\n                       prediction_selected=1, predicted_target=0x200,\n                       ctrl=_pack(CTRL, dict(alu_op=ALU_MUL, reg_write=1)))\n    _drive(dut, instruction)\n    dut.stall.value = 1\n    for _ in range(3):\n        await _cycle(dut)\n        assert int(dut.out.value) == older\n        assert not int(dut.train_valid.value) and not int(dut.redirect.value)\n    _drive(dut, dict(instruction, rs1_val=0xFFFFFFFD, rs2_val=7))\n    dut.stall.value = 0\n    await _cycle(dut)\n    assert int(dut.out.value) == 0, \"launch did not drain a completely zeroed bubble\"\n","exit_code":0,"status":"completed"}}
