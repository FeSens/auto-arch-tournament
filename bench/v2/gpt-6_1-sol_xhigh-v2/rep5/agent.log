{"type":"item.started","item":{"id":"item_94","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe')\nfor name in ('rightsigned','masklate'):\n rtl=root/name;rtl.mkdir(exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n p=rtl/'alu.sv';s=p.read_text()\n if name=='rightsigned':\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  wire signed [32:0] right_input = {(op == ALU_SRA) && a[31],a};\n  wire signed [32:0] right_shifted = right_input >>> b[4:0];\n''')\n  s=s.replace('ALU_SRL:    out = a >> shamt;', 'ALU_SRL:    out = right_shifted[31:0];')\n  s=s.replace('ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"', 'ALU_SRA:    out = right_shifted[31:0];')\n else:\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  wire [31:0] right_logical = a >> b[4:0];\n  wire [31:0] right_keep = 32'hffffffff >> b[4:0];\n  wire [31:0] right_arithmetic = right_logical | (~right_keep & {32{a[31]}});\n''')\n  s=s.replace('ALU_SRL:    out = a >> shamt;', 'ALU_SRL:    out = right_logical;')\n  s=s.replace('ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"', 'ALU_SRA:    out = right_arithmetic;')\n p.write_text(s)\nprint('Prepared two right-shift sharing implementations')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
