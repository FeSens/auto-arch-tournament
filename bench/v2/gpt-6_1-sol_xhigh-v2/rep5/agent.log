{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build,summarize\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nroot=Path('cores/bench/generated/hypothesis_probe/alu_provenance_wb')\nwith ThreadPoolExecutor(max_workers=2) as ex:\n    fs=[ex.submit(build,Path.cwd(),root/'rtl','fpga/core_bench_si.sv',p,root/f'gowin_p{p}') for p in [0,2]]\n    results=[f.result() for f in fs]\nfor r in results:\n    (root/f\\\"timing_p{r['place_option']}.json\\\").write_text(json.dumps(r,indent=2))\n    print(json.dumps(r),flush=True)\nresults.append(json.loads((root/'timing_p1.json').read_text()))\nresults.sort(key=lambda x:x['place_option'])\ns=summarize(results)\n(root/'timing_summary.json').write_text(json.dumps(s,indent=2))\nprint(json.dumps(s,indent=2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
