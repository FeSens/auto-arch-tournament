{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypothesis_probe')\nprobe=root/'nibble_compare'\nrtl=probe/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n(rtl/'compare32.sv').write_text('''module compare32 (\n  input logic [31:0] a, b,\n  output logic equal, unsigned_less, signed_less\n);\n  wire [14:0] eq_tree, lt_tree;\n  for (genvar i=0; i<8; i++) begin : g_slice\n    assign eq_tree[7+i] = a[4*i +: 4] == b[4*i +: 4];\n    assign lt_tree[7+i] = a[4*i +: 4] < b[4*i +: 4];\n  end\n  for (genvar i=0; i<7; i++) begin : g_merge\n    assign eq_tree[i] = eq_tree[2*i+2] & eq_tree[2*i+1];\n    assign lt_tree[i] = lt_tree[2*i+2] | (eq_tree[2*i+2] & lt_tree[2*i+1]);\n  end\n  assign equal = eq_tree[0];\n  assign unsigned_less = lt_tree[0];\n  assign signed_less = (a[31] \"'^ b[31]) ? a[31] : unsigned_less;\nendmodule\n'\"''')\np=rtl/'ex_stage.sv'\ns=p.read_text()\ns=s.replace('  always_comb begin\\\\n    case (in.ctrl.branch_op)', '''  logic compare_equal, compare_unsigned_less, compare_signed_less;\n  logic branch_base, branch_supported;\n  compare32 u_branch_compare (\n    .a(rs1), .b(rs2), .equal(compare_equal),\n    .unsigned_less(compare_unsigned_less), .signed_less(compare_signed_less)\n  );\n  assign branch_base = in.ctrl.branch_op[2]\n                       ? (in.ctrl.branch_op[1] ? compare_unsigned_less : compare_signed_less)\n                       : compare_equal;\n  assign branch_supported = in.ctrl.branch_op[2] || \"'!in.ctrl.branch_op[1];\n\n  always_comb begin\n    case (in.ctrl.branch_op)'\"''')\nstart=s.index('    case (in.ctrl.branch_op)')\nend=s.index('    branch_taken',start)\ns=s[:start]+'''    branch_cond = branch_supported && (branch_base \"'^ in.ctrl.branch_op[0]);\n'\"'''+s[end:]\np.write_text(s)\np=rtl/'alu.sv'\ns=p.read_text()\ns=s.replace('  always_comb begin', '''  logic compare_equal, compare_unsigned_less, compare_signed_less;\n  compare32 u_slt_compare (\n    .a(a), .b(b), .equal(compare_equal),\n    .unsigned_less(compare_unsigned_less), .signed_less(compare_signed_less)\n  );\n\n  always_comb begin''')\ns=s.replace('\"'$signed(a) < $signed(b)'\"', 'compare_signed_less').replace('a < b','compare_unsigned_less')\np.write_text(s)\nlog=Path('cores/bench/experiments/baseline_timing_probe.log')\nif log.exists(): log.rename(root/'baseline_timing_probe.log')\nprint('Created isolated comparator prototype:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
