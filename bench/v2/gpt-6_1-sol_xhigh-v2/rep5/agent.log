{"type": "item.completed", "item": {"id": "item_60", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,195p' cores/bench/rtl/if_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Three complete registered predicted-fetch snapshots. Prefix occupancy\n// controls constant-bank append enables; bank zero is the sole decode\n// source. Fetch acceptance is independent of backend consumption and an\n// initially full queue cannot replace a popped word on the same edge.\n// A frontier snapshot stops speculative physical fetch until that exact\n// instruction is accepted in MEM, or recovery cancels the wait.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // backend cannot consume head\n  input  logic              redirect,         // accepted registered MEM recovery\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  input  logic              train_valid,      // exactly one MEM acceptance\n  input  logic [31:0]       train_pc,\n  input  logic              train_eligible,   // legal, aligned control transfer\n  input  logic              train_jump,\n  input  logic              train_taken,\n  input  logic [31:0]       train_target,\n  input  logic              train_frontier,   // marker on accepted MEM record\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] valid_q;\n  logic [24:0] tags [0:31];\n  logic [31:0] targets [0:31];\n  logic [1:0] counters [0:31];\n  logic [4:0] fetch_index, train_index;\n  logic fetch_hit, train_hit, prediction_selected;\n  logic v0, v1, v2;\n  logic push, pop;\n  logic [2:0] append;\n  logic frontier_wait_q;\n  logic [31:0] frontier_successor_q;\n  if_id_t accepted_word;\n  // The head's stored valid bit is constant one; prefix occupancy owns\n  // presentation validity. Higher banks carry it only in whole-word shifts.\n  /* verilator lint_off UNUSEDSIGNAL */\n  wire [296:0] queu\n…[2882 of 5954 chars elided by tools/bench/transcript.py; sha256:b0ae2fcad164b6d9]…\nntrols validity separately\n  // and installs the full resolved target regardless of either bus hold.\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      v0 <= 1'b0;\n      v1 <= 1'b0;\n      v2 <= 1'b0;\n      frontier_wait_q <= 1'b0;\n      pc <= reset ? RESET_PC : redirect_target;\n    end else begin\n      v0 <= push || (v0 && !pop) || v1;\n      v1 <= (v1 && !pop) || v2 || (push && v0 && (!pop || v1));\n      v2 <= (v2 && !pop) || (push && v1 && !pop);\n      if (frontier_wait_q && train_valid && train_frontier) begin\n        frontier_wait_q <= 1'b0;\n        pc <= frontier_successor_q;\n      end else if (push) begin\n        if (accepted_word.frontier) begin\n          frontier_wait_q <= 1'b1;\n          frontier_successor_q <= next_pc;\n        end else pc <= next_pc;\n      end\n    end\n  end\n\n  assign imem_addr = pc;\n\n  assign {out.pc, out.instr, out.prediction_selected,\n          out.predicted_target, out.frontier} = queue_words[98:1];\n  assign out.valid = v0 && !reset && !redirect;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
