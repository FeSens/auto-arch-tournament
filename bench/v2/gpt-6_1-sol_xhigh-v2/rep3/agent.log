{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypgen_r11s0'); p=root/'div_borrow_groups'; r=p/'rtl'; r.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,r/f.name)\nf=r/'div_unit.sv'; s=f.read_text()\ns=s.replace(\\\"    assign trial8[k] = {1'b0, numerator8} - {1'b0, divisor_multiple_q[k]};\\\", \\\"    div_trial_sub36 u_trial (.a({1'b0, numerator8}), .b({1'b0, divisor_multiple_q[k]}), .difference(trial8[k]));\\\")\ns=s.replace(\\\"    assign trial4[k] = {1'b0, numerator4} - {1'b0, divisor_multiple_q[k]};\\\", \\\"    div_trial_sub36 u_trial (.a({1'b0, numerator4}), .b({1'b0, divisor_multiple_q[k]}), .difference(trial4[k]));\\\")\ns+='''\n// Four parallel nine-bit subtractors; local borrow generates/propagates\n// form prefix incoming borrows before selecting each short difference.\nmodule div_trial_sub36(input logic [35:0] a, b, output logic [35:0] difference);\n  logic [9:0] add_no_borrow [0:3], add_with_borrow [0:3];\n  logic [3:0] generate_borrow, propagate_borrow;\n  logic [3:0] borrow_in;\n  for (genvar j=0; j<4; j++) begin : g_slice\n    assign add_no_borrow[j] = {1'b0,a[j*9 +: 9]} + {1'b0,~b[j*9 +: 9]} + 10'd1;\n    assign add_with_borrow[j] = {1'b0,a[j*9 +: 9]} + {1'b0,~b[j*9 +: 9]};\n    assign generate_borrow[j] = \"'!add_no_borrow[j][9];\n    assign propagate_borrow[j] = a[j*9 +: 9] == b[j*9 +: 9];\n    assign difference[j*9 +: 9] = borrow_in[j] ? add_with_borrow[j][8:0] : add_no_borrow[j][8:0];\n  end\n  assign borrow_in[0]=1'\"'b0;\n  assign borrow_in[1]=generate_borrow[0];\n  assign borrow_in[2]=generate_borrow[1] | (propagate_borrow[1]&generate_borrow[0]);\n  assign borrow_in[3]=generate_borrow[2] | (propagate_borrow[2]&generate_borrow[1]) |\n                      (propagate_borrow[2]&propagate_borrow[1]&generate_borrow[0]);\nendmodule\n'''\nf.write_text(s)\nprint('Prepared parallel borrow prototype.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
