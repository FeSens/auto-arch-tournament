{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\ns = Path('cores/bench/generated/timing/gowin_p1/placed_unpacked.v').read_text()\nalias = dict(re.findall(r'assign (\\\\w+) = (\"'`?'\"\\\\w+);', s))\nalias.update(dict(re.findall(r'\"'`define ('\"\\\\w+) (\"'`?'\"\\\\w+)\\\\s*\"'$'\"', s, re.M)))\ncells = {}\nfor typ, name, body in re.findall(r'(LUT4|MUX2|DFF\\\\w*|ALU)\\\\s+(\\\\w+)\\\\s*\\\\((.*?)\\\\);', s, re.S):\n    ports = dict(re.findall(r'\\\\.(\\\\w+)\\\\(([\"'^)]+)'\"\\\\)', body))\n    output = ports.get('F') if typ == 'LUT4' else ports.get('O') if typ == 'MUX2' else ports.get('Q') if typ.startswith('DFF') else None\n    if output:\n        cells[output] = (typ, name, ports)\ninits = dict(re.findall(r\\\"defparam (\\\\w+)\\\\.INIT = 16'h(\\\\w+);\\\", s))\ndef resolve(n):\n    seen = set()\n    while n.lstrip('\"'`'\"') in alias and n not in seen:\n        seen.add(n)\n        n = alias[n.lstrip('\"'`'\"')]\n    return n.lstrip('\"'`'\"')\ndef trace(n, depth, indent=''):\n    n = resolve(n)\n    if n not in cells:\n        print(indent + n)\n        return\n    typ, name, ports = cells[n]\n    print(indent + name + ' ' + typ + (' INIT=' + inits.get(name, '?') if typ == 'LUT4' else ''))\n    if depth and not typ.startswith('DFF'):\n        for p, v in ports.items():\n            if p.startswith('I') or p.startswith('S'):\n                print(indent + '  ' + p + ':', end=' ')\n                trace(v, depth - 1, indent + '  ')\ntrace('R39C15_F0', 3)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
