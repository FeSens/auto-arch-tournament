re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\n@cocotb.test()\nasync def bimodal_loop_warmup_and_exit(dut):\n    program = [ADDI(1, 0, 8), ADDI(1, 1\n…[28044 of 31116 chars elided by tools/bench/transcript.py; sha256:4d17c1bff4aa82e5]…\ncycle = cycle; bench_start_set = true; }\ntest/cosim/main.cpp:161:                bench_stop_cycle = cycle; bench_stop_set = true;\ntest/cosim/main.cpp:253:        // Emit final record, plus an explicit completion marker. Consumers MUST\ntest/cosim/main.cpp:255:        // benchmark hit maxcycles without completing and the reading is invalid.\ntest/cosim/main.cpp:267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\ntest/cosim/main.cpp:268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\ntest/cosim/main.cpp:273:               (unsigned long long)bench_start_cycle,\ntest/cosim/main.cpp:274:               (unsigned long long)bench_stop_cycle,\ntest/cosim/main.cpp:279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_core_div.py\n M cores/bench/test/test_if_predictor.py\n M cores/bench/test/test_pipeline.py\n?? cores/bench/test/test_fetch_queue.py\n", "exit_code": 0, "status": "completed"}}
