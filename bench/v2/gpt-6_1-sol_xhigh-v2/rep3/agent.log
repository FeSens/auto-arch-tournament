{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"git diff --stat; sed -n '1,130p' tools/eval/formal.py; rg -n 'cycles|markers|mmio|bracket' test/cosim/main.cpp | tail -35; ls -l /opt/gowin/IDE/bin/gw_sh; for p in /AGENTS.md /srv/AGENTS.md /srv/hwebench/AGENTS.md /srv/hwebench/clones/AGENTS.md /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep3/AGENTS.md /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep3/cores/AGENTS.md /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep3/cores/bench/AGENTS.md; do if [ -f \\\"\"'$p\" ]; then cat \"$p\"; fi; done'", "aggregated_output": " cores/bench/rtl/core_pkg.sv  |  1 +\n cores/bench/rtl/mem_stage.sv |  3 ++-\n cores/bench/rtl/wb_stage.sv  | 11 +++++------\n 3 files changed, 8 insertions(+), 7 deletions(-)\n\"\"\"Runs the real riscv-formal suite via formal/run_all.sh.\n\nThe real suite is generated at runtime by formal/run_all.sh (which invokes\ngenchecks.py against our rtl/*.sv + wrapper.sv + checks.cfg) and runs the\n~45 I-base / M-ext insn checks plus reg / pc_fwd / pc_bwd / causal /\nunique / cover / ill / liveness — 53 total against the V0 baseline.\n\nIf genchecks.py crashes mid-run and only emits one .sby task that\nvacuously passes, the old `passed > 0 and failed == 0` rule would\nreturn success. EXPECTED_MIN_CHECKS prevents that.\n\"\"\"\nimport os, shutil, subprocess, json, re, uuid\nfrom pathlib import Path\n\nimport yaml\n\nfrom tools.eval._subprocess import run_pgroup\n\n\ndef read_nret(core_yaml_path: Path) -> int:\n    \"\"\"Read the `nret` field from a core.yaml. Defaults to 2 when the file\n    or field is missing — preserves backward compat with cores authored\n    before the nret-aware fixture (every existing core today).\n\n    Only 1 and 2 are supported. NRET=1 selects the single-issue formal\n    wrapper (wrapper_si.sv + checks_si.cfg); NRET=2 uses the dual-channel\n    default (wrapper.sv + checks.cfg).\n    \"\"\"\n    p = Path(core_yaml_path)\n    if not p.exists():\n        return 2\n    y = yaml.safe_load(p.read_text()) or {}\n    n = y.get(\"nret\", 2)\n    if n not in (1, 2):\n        raise ValueError(f\"core.yaml nret must be 1 or 2, got {n!r}\")\n    return n\n\n# Floor on how many .sby tasks must pass for a \"formal: green\" result.\n# V0 baseline produces 53. Allow some slack (≥50) so a future checks.cfg\n# tweak that legitimately drops 1-2 checks doesn't trigger a false alarm,\n# but reject a partial genchecks run that emits 1-2 tasks.\nEXPECTED_MIN_CHECKS = int(os.environ.get(\"FORMAL_MIN_CHECKS\", \"50\"))\n\n\n# Patterns that prove SBY actually executed at least one check before the\n# post-run `*.sby` glob came up empty. Any one of these in the output\n# means `no_checks_gene\n…[3759 of 6831 chars elided by tools/bench/transcript.py; sha256:b232d5b513763990]…\n_env(worktree_path, target)\n32:// Benchmark-time MMIO markers. CoreMark's portme.c writes to BENCH_START\n35:// bench_cycles = stop - start, excluding init/CRC-printing overhead.\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n66:    uint64_t maxcycles = argc > 2 ? atoll(argv[2]) : 50000000ULL;\n113:    for(uint64_t cycle=0; cycle<maxcycles; cycle++) {\n131:        //     allowed (markers); anything else outside dmem is OOB (handled\n152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\n153:            // cycle counts so the bench harness can bracket the benchmark loop\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n269:               \"\\\"bench_bracketed\\\":%s,\\\"uart\\\":\\\"%s\\\"}\\n\",\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n", "exit_code": 0, "status": "completed"}}
