{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_core_div.py'", "aggregated_output": "\"\"\"Shared M execution dependencies, retirement bounds and memory ordering.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\nfrom test_m_unit import expected, MASK, OPS, MUL_OPS\n\n\ndef addi(rd, rs1, imm):\n    return ((imm & 0xFFF) << 20) | (rs1 << 15) | (rd << 7) | 0x13\n\n\ndef m_op(op, rd, rs1, rs2):\n    funct3 = dict(zip(OPS, (0, 1, 3, 2, 4, 5, 6, 7)))[op]\n    return (1 << 25) | (rs2 << 20) | (rs1 << 15) | (funct3 << 12) | (rd << 7) | 0x33\n\n\ndef lw(rd, addr):\n    return (addr << 20) | (2 << 12) | (rd << 7) | 3\n\n\ndef sw(rs, addr):\n    return ((addr >> 5) << 25) | (rs << 20) | (2 << 12) | ((addr & 31) << 7) | 0x23\n\n\ndef beq(rs1, rs2, offset):\n    imm = offset & 0x1FFF\n    return (((imm >> 12) << 31) | (((imm >> 5) & 63) << 25) |\n            (rs2 << 20) | (rs1 << 15) | (((imm >> 1) & 15) << 8) |\n            (((imm >> 11) & 1) << 7) | 0x63)\n\n\ndef bne(rs1, rs2, offset):\n    return beq(rs1, rs2, offset) | (1 << 12)\n\n\ndef jal(rd, offset):\n    imm = offset & 0x1FFFFF\n    return (((imm >> 20) << 31) | (((imm >> 1) & 1023) << 21) |\n            (((imm >> 11) & 1) << 20) | (((imm >> 12) & 255) << 12) |\n            (rd << 7) | 0x6F)\n\n\ndef jalr(rd, rs1, imm):\n    return ((imm & 0xFFF) << 20) | (rs1 << 15) | (rd << 7) | 0x67\n\n\ndef sext(value, bits):\n    return value - (1 << bits) if value & (1 << (bits - 1)) else value\n\n\nEBREAK = 0x00100073\n\n\nasync def edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def run(dut, program, memory=None, stalls=False, long_stall=None, events