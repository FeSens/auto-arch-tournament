{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_predictor.py'", "aggregated_output": "\"\"\"Raw predecode, old-value counter lookup and fetch acceptance controls.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b, _prediction\n\n\nasync def edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n    dut.imem_data.value = NOP()\n    for _ in range(3):\n        await edge(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    return [1] * 64\n\n\nasync def at_pc(dut, pc):\n    # Recovery overrides both fetch stall and invalid fetch status.\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    dut.train_valid.value = 0\n    await edge(dut)\n    assert int(dut.imem_addr.value) == pc\n    dut.redirect.value = 0\n    dut.flush.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def check_fetch(dut, counters, pc, instr, *, stall=False, flush=False,\n                      training=None, recovery=None):\n    await at_pc(dut, pc)\n    dut.imem_data.value = instr\n    dut.stall.value = int(stall)\n    dut.flush.value = int(flush)\n    dut.redirect.value = int(recovery is not None)\n    if recovery is not None:\n        dut.redirect_target.value = recovery\n    dut.train_valid.value = int(training is not None)\n    if training is not None:\n        dut.train_pc.value, dut.train_taken.value = training\n    await Timer(1, \"ns\")\n    prediction, predicted_pc = _prediction(pc, instr, counters)\n    fetched = int(dut.out.value)\n    assert fetched >> 34 == pc\n    assert (fetched >> 2) & 0xFFFFFFFF == instr\n    assert (fetched >> 1) & 1 == int(prediction)\n    assert fetched & 1 == int(not flush and recovery is None)\n    await e\n…[2649 of 5721 chars elided by tools/bench/transcript.py; sha256:7af9190337e9a62b]…\n in range(8):\n        assert not await check_fetch(dut, counters, 0x100, JALR(1, 2, 0) | (funct3 << 12))\n\n\n@cocotb.test()\nasync def raw_payload_and_recovery_acceptance(dut):\n    counters = await reset(dut)\n    for instr in (JAL(1, 16), BEQ(3, 4, 16), 0xFFFFFFFF, 0x0220C233):\n        for stall in (False, True):\n            for flush in (False, True):\n                await check_fetch(dut, counters, 0x100, instr, stall=stall, flush=flush)\n                await check_fetch(dut, counters, 0x100, instr, stall=stall,\n                                  flush=flush, recovery=0x200)\n\n\ndef test_if_predictor_runner():\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"if_predictor\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"if_stage.sv\"],\n                 hdl_toplevel=\"if_stage\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"if_stage\", test_module=\"test_if_predictor\",\n                test_dir=TEST_DIR, build_dir=build)\n", "exit_code": 0, "status": "completed"}}
