nces[(shamt + index) % len(op_sequences)]:\n+                    await _check(dut, op, a, upper | shamt, expected[op])\n+                    checks += 1\n+    dut._log.info(\"Passed %d directed/random shift checks\", checks)\n+\n+\n @cocotb.test()\n async def lui(dut):\n     await _setup(dut)\n", "exit_code": 0, "status": "completed"}}
