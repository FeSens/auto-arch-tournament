{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_div_unit.py; sed -n '1,220p' cores/bench/rtl/div_unit.sv; cat cores/bench/core.yaml\"", "aggregated_output": "\"\"\"Exact RV32M arithmetic and registered divider handshake tests.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = dict(zip(OPS, (0x7F8529EC, 0x10E8FD70, 0x8DA68FA5, 0x3138D0E1)))\n\n\ndef expected(op, a, b, alt=False):\n    a, b = a & MASK, b & MASK\n    if alt:\n        return ((a - b) ^ ALTOPS[op]) & MASK\n    if not b:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK\n    return (a % b if op == ALU_REMU else a // b) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.reset.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n\n\nasync def check(dut, op, a, b, exact=None, hold=0):\n    alt = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n    want = expected(op, a, b, alt)\n    if exact is not None and not alt:\n        assert want == exact\n    assert not int(dut.busy.value)\n    dut.start.value = 1\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    await tick(dut)\n    assert int(dut.busy.value) and not int(dut.done.value)\n    # Keep start asserted with changing inputs: busy requests must be ignored.\n    for elapsed in range(1, 7):\n        dut.a.value = (a + elapsed) & MASK\n        dut.b.value = (b ^ elapsed) & MASK\n        dut.op.value = OPS[elapsed % 4]\n        await tick(dut)\n…[6647 of 9719 chars elided by tools/bench/transcript.py; sha256:0ce6389cd0df58a6]…\nw_q) result <= 32'b0;\n            else result <= remainder_negative_q ? -remainder_q : remainder_q;\n          end else begin\n            if (zero_q) result <= 32'hffffffff;\n            else if (overflow_q) result <= 32'h80000000;\n            else result <= quotient_negative_q ? -quotient_q : quotient_q;\n          end\n`endif\n          state_q <= DONE;\n        end\n        DONE: if (accept) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 30.617\n  lut4: 3010\n  ff: 712\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261001-002-r1s1\n  updated: '2026-10-01T01:50:50.265643Z'\n", "exit_code": 0, "status": "completed"}}
