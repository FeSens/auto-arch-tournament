{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_div_unit.py cores/bench/test/test_core_div.py'", "aggregated_output": "\"\"\"Exact RV32M arithmetic and registered divider handshake tests.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = dict(zip(OPS, (0x7F8529EC, 0x10E8FD70, 0x8DA68FA5, 0x3138D0E1)))\n\n\ndef expected(op, a, b, alt=False):\n    a, b = a & MASK, b & MASK\n    if alt:\n        return ((a - b) ^ ALTOPS[op]) & MASK\n    if not b:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK\n    return (a % b if op == ALU_REMU else a // b) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.reset.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n\n\nasync def check(dut, op, a, b, exact=None, hold=0):\n    alt = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n    want = expected(op, a, b, alt)\n    if exact is not None and not alt:\n        assert want == exact\n    assert not int(dut.busy.value)\n    dut.start.value = 1\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    await tick(dut)\n    assert int(dut.busy.value) and not int(dut.done.value)\n    # Keep start asserted with changing inputs: busy requests must be ignored.\n    for elapsed in range(1, 7):\n        dut.a.value = (a + elapsed) & MASK\n        dut.b.value = (b ^ elapsed) & MASK\n        dut.op.value = OPS[elapsed % 4]\n        await tick(dut)\n…[11173 of 14245 chars elided by tools/bench/transcript.py; sha256:859f55c2f934aa48]…\n)\n        memory[260 + 8 * index] = rng.getrandbits(32)\n        program += [lw(1, 256 + 8 * index), lw(2, 260 + 8 * index),\n                    m_op((ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)[index % 4], 3, 1, 2),\n                    addi(4, 3, 1)]\n    program.append(EBREAK)\n    await run(dut, program, memory, stalls=True)\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_core_div_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"core_div_alt\" if alt else \"core_div\")\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\")\n    runner.build(sources=sources, hdl_toplevel=\"core\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_core_div\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n", "exit_code": 0, "status": "completed"}}
