{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/nonrestoring_probe')\nfor sub in ('rtl','test'):\n (root/sub).mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench',sub).glob('*'):\n  if p.is_file():shutil.copy2(p,root/sub/p.name)\np=root/'rtl/div_unit.sv';s=p.read_text()\ns=s.replace('logic [31:0] a_q, divisor_q, remainder_q;','logic [31:0] a_q, divisor_q;\\\\n  logic signed [32:0] remainder_q, remainder_next, negative_divisor_q;')\ns=s.replace('logic [31:0] remainder_next, magnitude_a, magnitude_b;','logic [31:0] magnitude_a, magnitude_b, restored_remainder;')\ns=s.replace('logic [32:0] shifted, trial;','logic signed [33:0] shifted, trial;\\\\n  logic signed [32:0] divisor_term;')\ns=s.replace('logic [3:0] seed_quotient, seed_remainder;','logic [3:0] seed_quotient;\\\\n  logic signed [4:0] seed_remainder;')\ns=s.replace('logic [4:0] seed_shifted, seed_trial;','logic signed [5:0] seed_shifted, seed_trial, seed_neg_divisor;')\ns=s.replace(\\\"seed_remainder = 4'b0;\\\",\\\"seed_remainder = 5'b0;\\\").replace(\\\"seed_shifted = 5'b0;\\\",\\\"seed_shifted = 6'b0;\\\").replace(\\\"seed_trial = 5'b0;\\\",\\\"seed_trial = 6'b0;\\\\n    seed_neg_divisor = -\"'$signed({2'\"'b0,magnitude_b[3:0]});\\\")\ns=s.replace(\\\"seed_trial = seed_shifted - {1'b0, magnitude_b[3:0]};\\\",\\\"seed_trial = seed_shifted + (seed_remainder[4] ? \"'$signed({2'\"'b0,magnitude_b[3:0]}) : seed_neg_divisor);\\\")\ns=s.replace(\\\"seed_quotient = {seed_quotient[2:0], \"'!seed_trial[4]};\",\"seed_quotient = {seed_quotient[2:0], !seed_trial[5]};\")\ns=s.replace(\"seed_remainder = seed_trial[4] ? seed_shifted[3:0] : seed_trial[3:0];\",\"seed_remainder = seed_trial[4:0];\")\ns=s.replace('\"'seed_remainder = magnitude_a[31:28];',\\\"seed_remainder = {1'b0,magnitude_a[31:28]};\\\")\ns=s.replace(\\\"shifted = 33'b0;\\\",\\\"shifted = 34'b0;\\\").replace(\\\"trial = 33'b0;\\\",\\\"trial = 34'b0;\\\\n    divisor_term = 33'b0;\\\")\ns=s.replace(\\\"trial = shifted - {1'b0, divisor_q};\\\",\\\"divisor_term = remainder_next[32] ? \"'$signed({1'\"'b0,divisor_q}) : negative_divisor_q;\\\\n      trial = shifted + \"'$signed({divisor_term[32],divisor_term});\")\ns=s.replace('\"'\"'!trial[32]'\"','\"'!trial[33]'\"').replace(\\\"remainder_next = trial[32] ? shifted[31:0] : trial[31:0];\\\",\\\"remainder_next = trial[32:0];\\\")\ns=s.replace('  // These sources remain',\\\"  assign restored_remainder = remainder_q[32] ? (remainder_q[31:0] + divisor_q) : remainder_q[31:0];\\\\n\\\\n  // These sources remain\\\")\ns=s.replace('remainder_negative_q ? -remainder_q : remainder_q','remainder_negative_q ? -restored_remainder : restored_remainder')\ns=s.replace(\\\"remainder_q <= 32'b0;\\\",\\\"remainder_q <= 33'b0;\\\\n      negative_divisor_q <= 33'b0;\\\")\ns=s.replace('divisor_q <= magnitude_b;','''divisor_q <= magnitude_b;\n          negative_divisor_q <= signed_op && b[31] ? \"'$signed({1'\"'b1,b}) : -\"'$signed({1'\"'b0,b});''')\ns=s.replace(\\\"remainder_q <= {28'b0, seed_remainder};\\\",\\\"remainder_q <= {{28{seed_remainder[4]}}, seed_remainder};\\\")\np.write_text(s)\nprint('Created fixed-latency non-restoring divider prototype.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
