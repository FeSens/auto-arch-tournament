{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nroot=Path('cores/bench/generated/hypgen_scratch')\np=root/'test_branch_relations.py'\np.write_text('''from pathlib import Path\nimport sys\nimport cocotb\nsys.path.insert(0,str(Path.cwd()/\\\"cores/bench/test\\\"))\nfrom test_pipeline import _run, _b, LW, ADDI, NOP, EBREAK\n\n@cocotb.test()\nasync def forwarded_branch_relations_at_sign_boundaries(dut):\n    pairs=[(0,0),(0xffffffff,0),(0,0xffffffff),\n           (0x7fffffff,0x80000000),(0x80000000,0x7fffffff),\n           (0x80000000,0x80000000),(0xffffffff,0xfffffffe),\n           (0x10000,0xffff),(0x80000001,0x80000000)]\n    signed=lambda x:x-(1<<32) if x&(1<<31) else x\n    for a,b in pairs:\n        for op in (0,1,4,5,6,7):\n            taken={0:a==b,1:a\"'!=b,4:signed(a)<signed(b),\n                   5:signed(a)>=signed(b),6:a<b,7:a>=b}[op]\n            for delivery in ([],[NOP(),NOP()], [ADDI(1,1,0),ADDI(2,2,0)]):\n                prefix=[LW(1,0,64),LW(2,0,68)]+delivery\n                pc=len(prefix)*4\n                insn=_b(8,2,1,op,0x63)\n                program=prefix+[insn,NOP(),EBREAK()]\n                for stalls in (False,(True,False),(False,True),True):\n                    events=[]\n                    rets,_=await _run(dut,program,{64:a,68:b},stalls=stalls,\n                                      events=events,long_stall=(64,68) if stalls else None)\n                    branch=next(r for r in rets if r[\"pc\"]==pc)\n                    assert branch[\"rs1_rdata\"]==a and branch[\"rs2_rdata\"]==b\n                    assert branch[\"pc_next\"]==pc+(8 if taken else 4)\n                    assert not branch[\"trap\"]\n                    assert [r[\"pc\"] for r in rets]==list(range(0,pc+4,4))+([pc+8] if taken else [pc+4,pc+8])\n                    trains=[e for e in events if e[\"train\"]]\n                    assert len(trains)==1 and trains[0][\"train_taken\"]==taken\n'\"''')\nprint('Boundary and forwarding checks written for isolated prototypes.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
