{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/bf842e9a/6ae4036a/r12s0-arithmetic')\nbase.mkdir(exist_ok=True)\nfor name in ['baseline','cs8']:\n dst=base/name/'rtl'; dst.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,dst/p.name)\nhelper='''module fast_add32 (\n input logic [31:0] a, b,\n input logic carry_in,\n output logic [31:0] sum\n);\n logic [8:0] s0 [0:3], s1 [0:3];\n logic [3:0] p, g;\n logic [3:0] c;\n for (genvar k=0; k<4; k++) begin : g_block\n   assign s0[k] = {1'b0,a[k*8 +: 8]} + {1'b0,b[k*8 +: 8]};\n   assign s1[k] = {1'b0,a[k*8 +: 8]} + {1'b0,b[k*8 +: 8]} + 9'd1;\n   assign p[k] = &(a[k*8 +: 8] \"'^ b[k*8 +: 8]);\n   assign g[k] = s0[k][8];\n   assign sum[k*8 +: 8] = c[k] ? s1[k][7:0] : s0[k][7:0];\n end\n assign c[0] = carry_in;\n assign c[1] = g[0] | (p[0] & carry_in);\n assign c[2] = g[1] | (p[1]&g[0]) | (p[1]&p[0]&carry_in);\n assign c[3] = g[2] | (p[2]&g[1]) | (p[2]&p[1]&g[0]) | (p[2]&p[1]&p[0]&carry_in);\nendmodule\n'\"'''\n(base/'cs8'/'rtl'/'fast_add32.sv').write_text(helper)\np=base/'cs8'/'rtl'/'alu.sv'; s=p.read_text();s=s.replace('  logic        [4:0]  shamt;','''  logic        [4:0]  shamt;\n  logic [31:0] fast_add, fast_sub;\n  fast_add32 u_add(.a(a), .b(b), .carry_in(1'b0), .sum(fast_add));\n  fast_add32 u_sub(.a(a), .b(~b), .carry_in(1'b1), .sum(fast_sub));''').replace('out = a + b;','out = fast_add;').replace('out = a - b;','out = fast_sub;');p.write_text(s)\n(base/'run_timing.py').write_text('''from pathlib import Path\nimport json, sys, time\nfrom tools.eval import gowin\nroot=Path.cwd()\nbase=Path('/srv/hwebench/tmp/bf842e9a/6ae4036a/r12s0-arithmetic')\nfor name in sys.argv[1:]:\n start=time.monotonic()\n result=gowin.build_all(root,base/name/'rtl','fpga/core_bench_si.sv',base/name/'build',options=(1,))\n (base/name/'result.json').write_text(json.dumps(result,indent=2))\n print(json.dumps({'variant':name,'elapsed':time.monotonic()-start,'results':result}),flush=True)\n''')\nprint(base)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
