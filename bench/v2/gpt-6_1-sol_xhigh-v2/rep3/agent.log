{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,240p' tools/eval/gowin.py; sed -n '100,165p' Makefile; cat test/cosim/build.sh; cat .gitignore\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[17887 of 20959 chars elided by tools/bench/transcript.py; sha256:7933b64e4d97b383]…\npshot: PATH + resolved EDA tool paths)\n# IS tracked, decided at the first v2 rep publish (e1a static, 2026-07-16):\n# it is tiny, contains no secrets, and pins which toolchain binaries\n# produced each rep's numbers.\n\n# Throwaway harness-verification runs (one-model YAMLs + their output\n# trees). These are reliability checks, not benchmark data — output is\n# regenerable and the YAMLs only encode \"rerun this single model to\n# confirm a fix landed\". Naming convention: `*-verify` for output dirs,\n# `models-*-verify.yaml` for the throwaway model YAML.\nbench/*-verify/\nbench/smoke-*/\ntools/bench/models-*-verify.yaml\n\n# Aborted/partial bench output preserved locally with a debug-tag suffix\n# (e.g. `gpt-5_5.failed-pwd-bug/`, `gpt-5_5.validate-v3/`, sibling\n# `results.jsonl.<tag>`). They document a known-broken state for the\n# author's own postmortem; the canonical results live in the un-suffixed\n# per-model dirs.\nbench/*.failed-*\nbench/*.validate-*\nbench/*.prev-*\nbench/*.stale-*\nbench/*.partial-*\nbench/results.jsonl.*\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/bf842e9a/1951cc13/predictor_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(f,rtl/f.name)\nf=rtl/'if_stage.sv'\ns=f.read_text()\ns=s.replace('  logic [1:0] counters_q [0:63];','  logic [7:0] train_bank_enable, train_row_enable;\\\\n  logic [7:0] bank_directions [0:7];\\\\n  logic [7:0] bank_prediction;\\\\n  logic predicted_direction;')\na=s.index('  // Nonblocking training writes')\nb=s.index('  always_comb begin',a)\ns=s[:a]+'''  for (genvar bank = 0; bank < 8; bank++) begin : g_bank\n    assign train_bank_enable[bank] = train_valid && (train_index[5:3] == 3'(bank));\n    assign train_row_enable[bank] = (train_index[2:0] == 3'(bank));\n    for (genvar row = 0; row < 8; row++) begin : g_row\n      logic [1:0] counter_q;\n      always_ff @(posedge clock) begin\n        if (reset) counter_q <= 2'b01;\n        else if (train_bank_enable[bank] && train_row_enable[row]) begin\n          if (train_taken)\n            counter_q <= {counter_q[1] | counter_q[0], counter_q[1] | ~counter_q[0]};\n          else\n            counter_q <= {counter_q[1] & counter_q[0], counter_q[1] & ~counter_q[0]};\n        end\n      end\n      assign bank_directions[bank][row] = counter_q[1];\n    end\n    assign bank_prediction[bank] = bank_directions[bank][fetch_index[2:0]];\n  end\n  assign predicted_direction = bank_prediction[fetch_index[5:3]];\n\n'''+s[b:]\ns=s.replace('counters_q[fetch_index][1]','predicted_direction')\nf.write_text(s)\nprint(root)\nprint('Gowin executable exists:',Path('/opt/gowin/IDE/bin/gw_sh').exists())\nfor state in range(4):\n d,h=state>>1,state&1\n for taken in (0,1):\n  actual=((d|h)<<1)|(d|(1-h)) if taken else ((d&h)<<1)|(d&(1-h))\n  expected=min(state+1,3) if taken else max(state-1,0)\n  assert actual==expected\nprint('All Boolean transitions exact')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
