ntools/eval/test_formal_reclassify.py\ntools/eval/test_formal_workdir_cleanup.py\ntools/eval/test_fpga_report.py\ntools/eval/test_gate_sanity.py\ntools/eval/test_holdout.py\ntools/eval/test_process_reaper.py\ntools/eval/test_remove_path.py\ntools/eval/test_rvfi_lint.py\ntools/eval/test_slots.py\ntools/eval/test_subprocess_pgroup.py\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n// rtl/alu.sv\n//\n// Combinational RV32I / multiply datapath. Division-class operations are\n// executed exclusively by div_unit; they return the default zero here.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  lo\n…[9928 of 13000 chars elided by tools/bench/transcript.py; sha256:fc6d30b9b6e30d43]…\nute PC+4 here.\n      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= rs1;\n      reg_q.rs2_val       <= rs2;\n      // pc_next reverts to pc+4 on misalign trap so the pc_fwd checker\n      // (asserting next retirement's pc_rdata == this pc_wdata) stays\n      // consistent with the suppressed redirect.\n      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : (in.pc + 32'd4);\n      reg_q.branch_taken  <= branch_taken;\n      reg_q.branch_target <= branch_target;\n      reg_q.ctrl          <= ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
