{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_probe')\nextra='''\n\n@cocotb.test()\nasync def carry_boundaries_and_random(dut):\n    import random\n    rng = random.Random(20261001)\n    values = {0, 1, 0xffffffff, 0x7fffffff, 0x80000000, 0xaaaaaaaa, 0x55555555}\n    for bit in range(1,32):\n        values.update({(1 << bit)-1, 1 << bit, (1 << bit)+1})\n    for a in sorted(values):\n        for b in sorted(values):\n            await _check(dut, ALU_ADD, a, b, a+b)\n            await _check(dut, ALU_SUB, a, b, a-b)\n    for i in range(50000):\n        a, b = rng.getrandbits(32), rng.getrandbits(32)\n        await _check(dut, ALU_ADD, a, b, a+b)\n        await _check(dut, ALU_SUB, a, b, a-b)\n'''\nfor tag in ['cs8','cs4']:\n dest=root/tag/'test'; dest.mkdir(parents=True,exist_ok=True)\n for name in ['_helpers.py','conftest.py','test_alu.py']:\n  shutil.copy2(Path('cores/bench/test')/name,dest/name)\n with (dest/'test_alu.py').open('a') as f: f.write(extra)\nprint('Prepared independent arithmetic tests in scratch copies.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
