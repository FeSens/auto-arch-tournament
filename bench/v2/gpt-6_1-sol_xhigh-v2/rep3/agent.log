{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv cores/bench/test/test_if_predictor.py'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Raw instruction predecode and a folded-PC bimodal table predict direct\n// transfers. Squashes affect validity alone, keeping recovery out of the\n// decoder, regfile addresses and ID/EX payload capture.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // invalidate fetch this cycle\n  input  logic              redirect,         // advancing EX misprediction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_valid,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0]       train_pc,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic              train_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [1:0] counters_q [0:63];\n  logic [5:0] fetch_index, train_index;\n  logic legal_branch, direct_jal, predicted_taken;\n  logic [31:0] direct_imm, direct_target;\n\n  assign fetch_index = pc[7:2] ^ pc[13:8];\n  assign train_index = train_pc[7:2] ^ train_pc[13:8];\n\n  // Nonblocking training writes leave this edge's lookup on the old\n  // counter, including when the two folded indices alias.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 64; i++) counters_q[i] <= 2'b01;\n    end else if (train_valid) begin\n      if (train_taken) begin\n        if (counters_q[train_index] != 2'b11)\n          \n…[6614 of 9686 chars elided by tools/bench/transcript.py; sha256:a101e8780f0a4cca]…\n in range(8):\n        assert not await check_fetch(dut, counters, 0x100, JALR(1, 2, 0) | (funct3 << 12))\n\n\n@cocotb.test()\nasync def raw_payload_and_recovery_acceptance(dut):\n    counters = await reset(dut)\n    for instr in (JAL(1, 16), BEQ(3, 4, 16), 0xFFFFFFFF, 0x0220C233):\n        for stall in (False, True):\n            for flush in (False, True):\n                await check_fetch(dut, counters, 0x100, instr, stall=stall, flush=flush)\n                await check_fetch(dut, counters, 0x100, instr, stall=stall,\n                                  flush=flush, recovery=0x200)\n\n\ndef test_if_predictor_runner():\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"if_predictor\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"if_stage.sv\"],\n                 hdl_toplevel=\"if_stage\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"if_stage\", test_module=\"test_if_predictor\",\n                test_dir=TEST_DIR, build_dir=build)\n", "exit_code": 0, "status": "completed"}}
