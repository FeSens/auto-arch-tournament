{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport subprocess,json,collections,time\np=subprocess.Popen(['cores/bench/obj_dir/cosim_sim','bench/programs/coremark.elf','50000000','--istall','--dstall'],stdout=subprocess.PIPE,text=True)\nactive=False; counts=collections.Counter(); dep=collections.Counter(); prev=None; start=time.time()\nfor line in p.stdout:\n r=json.loads(line)\n if 'insn' not in r: continue\n insn=r['insn']; op=insn&127; f3=(insn>>12)&7\n if r['mem_wmask'] and r['mem_addr']==0x10000100:\n  active=True; prev=None; counts['start_cycle']=r['cycle']\n if r['mem_wmask'] and r['mem_addr']==0x10000104:\n  active=False; counts['stop_cycle']=r['cycle']\n if not active: continue\n kind='load' if op==3 else 'store' if op==35 else 'branch' if op==99 else 'jal' if op==111 else 'jalr' if op==103 else 'mul' if op==51 and insn>>25==1 and f3<4 else 'div' if op==51 and insn>>25==1 else 'shift' if op in [19,51] and f3 in [1,5] else 'scalar'\n counts[kind]+=1\n if prev and prev[0]:\n  rs1=(insn>>15)&31; rs2=(insn>>20)&31\n  use1=op in [3,19,35,51,99,103]; use2=op in [35,51,99]\n  if (use1 and rs1==prev[0]) or (use2 and rs2==prev[0]):\n   dep[prev[1]+'->'+kind]+=1\n prev=(r['rd_addr'],kind)\np.wait(); print(json.dumps({'counts':dict(counts),'adjacent_dependencies':dict(dep),'seconds':time.time()-start},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
