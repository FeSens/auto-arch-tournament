{"type":"item.completed","item":{"id":"item_138","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/scalar_lanes.sv'","aggregated_output":"`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n// Decode-registered operation enables drive parallel RV32I lanes. No\n// encoded opcode or link arbitration remains beyond the ID/EX boundary.\nmodule scalar_lanes (\n  input  logic [11:0] en,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic [31:0] sequential_pc,\n  output logic [31:0] out\n);\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [32:0] arithmetic_wide; // low carry-seeding bit is deliberately discarded\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] left_result;\n  logic signed [32:0] right_input;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [32:0] right_result;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] masked [0:7];\n\n  // A single widened addition expresses carry-in without a second\n  // incrementer: bit zero produces carry one exactly for subtraction.\n  // Bits [32:1] are the complete modulo-2^32 ADD/SUB result.\n  assign arithmetic_wide = {a, 1'b1} +\n                            {b ^ {32{en[4'(ALU_SUB)]}}, en[4'(ALU_SUB)]};\n  assign left_result = a << b[4:0];\n  // SRL is positive in 33 signed bits; SRA extends the RV32 sign bit.\n  assign right_input = $signed({en[4'(ALU_SRA)] && a[31], a});\n  assign right_result = right_input >>> b[4:0];\n\n  assign masked[0] = arithmetic_wide[32:1] & {32{en[4'(ALU_ADD)] | en[4'(ALU_SUB)]}};\n  assign masked[1] = (a & b) & {32{en[4'(ALU_AND)]}};\n  assign masked[2] = (a | b) & {32{en[4'(ALU_OR)]}};\n  assign masked[3] = (a ^ b) & {32{en[4'(ALU_XOR)]}};\n  assign masked[4] = {31'b0, (en[4'(ALU_SLT)] && ($signed(a) < $signed(b))) |\n                            (en[4'(ALU_SLTU)] && (a < b))};\n  assign masked[5] = left_result & {32{en[4'(ALU_SLL)]}};\n  assign masked[6] = right_result[31:0] & {32{en[4'(ALU_SRL)] | en[4'(ALU_SRA)]}};\n  assign masked[7] = (b & {32{en[4'(ALU_LUI)]}}) |\n                     (sequential_pc & {32{en[11]}});\n  assign out = ((masked[0] | masked[1]) | (masked[2] | masked[3])) |\n               ((masked[4] | masked[5]) | (masked[6] | masked[7]));\nendmodule\n","exit_code":0,"status":"completed"}}
