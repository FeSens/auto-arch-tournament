{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'tail -n 50 cores/bench/test/test_div_unit.py'","aggregated_output":"    for phase in range(8):\n        await reset(dut)\n        dut.start.value = 1\n        dut.op.value, dut.a.value, dut.b.value = ALU_DIVU, MASK, 7\n        await tick(dut)\n        dut.start.value = 0\n        for _ in range(phase):\n            await tick(dut)\n        assert int(dut.busy.value)\n        assert int(dut.done.value) == (phase == 7)\n        await reset(dut)\n        for _ in range(8):\n            await tick(dut)\n            assert not int(dut.busy.value) and not int(dut.done.value)\n        await check(dut, ALU_REM, 0xFFFFFFF6, 3, MASK)\n\n\n@cocotb.test()\nasync def long_completion_hold_and_reset_priority(dut):\n    await reset(dut)\n    for op in OPS:\n        await check(dut, op, 0x80000000, MASK, hold=97)\n        await check(dut, op, 0xDEADBEEF, 0, hold=97)\n    for phase in (0, 3, 7):\n        dut.start.value = 1\n        dut.accept.value = 1\n        dut.op.value, dut.a.value, dut.b.value = ALU_DIV, 103, 7\n        await tick(dut)\n        for _ in range(phase):\n            await tick(dut)\n        dut.reset.value = 1\n        await tick(dut)\n        assert not int(dut.busy.value) and not int(dut.done.value)\n        dut.reset.value = 0\n        dut.start.value = 0\n        dut.accept.value = 0\n        await check(dut, ALU_REMU, 103, 7, 5)\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_div_unit_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"div_unit_alt\" if alt else \"div_unit\")\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"div_unit.sv\"],\n                 hdl_toplevel=\"div_unit\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'tail -n 38 cores/bench/test/test_core_div.py'","aggregated_output":"    for op in OPS:\n        result = expected(op, 256, 4, alt)\n        offset = (-result) & 3\n        address = (result + offset) & MASK\n        program = [addi(1, 0, 256), addi(2, 0, 4), addi(9, 0, 123),\n                   sw(9, 80), m_op(op, 3, 1, 2),\n                   sw(3, offset, 3), lw(4, offset, 3),\n                   m_op(op, 5, 4, 2), sw(5, 84), sw(0, offset, 3), EBREAK]\n        for stalls in (False, (True, False), (False, True), True):\n            rets, stores, held = await run(dut, program, stalls=stalls,\n                                           long_stall=(80, address) if stalls else None)\n            second = expected(op, result, 4, alt)\n            assert stores == [(80, 123, 15), (address, result, 15),\n                              (84, second, 15), (address, 0, 15)]\n            assert next(r for r in rets if r[\"pc_rdata\"] == 24)[\"rd_wdata\"] == result\n            first_m = next(r for r in rets if r[\"pc_rdata\"] == 16)\n            following_store = next(r for r in rets if r[\"pc_rdata\"] == 20)\n            assert following_store[\"rs1_rdata\"] == result\n            assert following_store[\"rs2_rdata\"] == result\n            if not stalls:\n                assert following_store[\"cycle\"] - first_m[\"cycle\"] == 1\n                assert first_m[\"cycle\"] - rets[3][\"cycle\"] == (3 if op in MUL_OPS else 9)\n                assert first_m[\"cycle\"] - rets[3][\"cycle\"] <= 10\n            else:\n                assert held >= 3\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_core_div_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"core_div_alt\" if alt else \"core_div\")\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\")\n    runner.build(sources=sources, hdl_toplevel=\"core\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_core_div\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n","exit_code":0,"status":"completed"}}
