{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nfrom pathlib import Path\nimport subprocess,json\nroot=Path('cores/bench/generated/r6_probe').resolve();gold=Path('cores/bench/rtl/alu.sv').read_text().replace('module alu (','module alu_gold (')\nfor tag in ['localauipc','localauipc_shared']:\n d=root/tag/'equiv';d.mkdir(parents=True,exist_ok=True);rtl=root/tag/'rtl'\n (d/'alu_gold.sv').write_text(gold)\n (d/'alu_equiv.sv').write_text('''module alu_equiv(input logic [4:0] op, input logic [31:0] a,b,pc,input logic is_auipc, output logic equal);\nlogic [31:0] actual, expected,reference_a;\nassign reference_a = (op == ALU_ADD && is_auipc) ? pc : a;\nalu dut(.op(op),.a(a),.b(b),.pc(pc),.is_auipc(is_auipc),.out(actual));\nalu_gold reference(.op(op),.a(reference_a),.b(b),.out(expected));\nassign equal = actual == expected;\nendmodule\n''')\n script=f'read_verilog -formal -sv -I{rtl} {rtl}/core_pkg.sv {rtl}/alu.sv {d}/alu_gold.sv {d}/alu_equiv.sv; prep -top alu_equiv -flatten; sat -verify -prove equal 1'\n with (d/'yosys.log').open('w') as f:r=subprocess.run(['yosys','-p',script],stdout=f,stderr=subprocess.STDOUT,timeout=60)\n print(json.dumps({'tag':tag,'formal_equiv_returncode':r.returncode}),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
