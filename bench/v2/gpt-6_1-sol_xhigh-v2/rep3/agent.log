{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"sed -n '1,130p' cores/bench/generated/r6_probe/cs8/rtl/alu.sv; rg --files bench/programs test/cosim | head -n 40\"","aggregated_output":"`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n// rtl/alu.sv\n//\n// Combinational RV32I datapath. All M operations execute in m_unit.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic [31:0] add_fast, sub_fast;\n  carry_select32 u_add(.a(a), .b(b), .cin(1'b0), .sum(add_fast));\n  carry_select32 u_sub(.a(a), .b(~b), .cin(1'b1), .sum(sub_fast));\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = add_fast;\n      ALU_SUB:    out = sub_fast;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n\nmodule carry_select32 (input logic [31:0] a, b, input logic cin, output logic [31:0] sum);\n  logic [8:0] s0 [0:3], s1 [0:3];\n  logic [3:0] g, p, c;\n  for (genvar k=0; k<4; k++) begin : g_local\n    assign s0[k] = {1'b0,a[k*8+:8]} + {1'b0,b[k*8+:8]};\n    assign s1[k] = {1'b0,a[k*8+:8]} + {1'b0,b[k*8+:8]} + 9'd1;\n    assign g[k] = s0[k][8];\n    assign p[k] = &(a[k*8+:8] ^ b[k*8+:8]);\n    assign sum[k*8+:8] = c[k] ? s1[k][7:0] : s0[k][7:0];\n  end\n  assign c[0] = cin;\n  assign c[1] = (g[0]) | (p[0] & cin);\n  assign c[2] = (p[1] & g[0]) | (g[1]) | (p[1] & p[0] & cin);\n  assign c[3] = (p[2] & p[1] & g[0]) | (p[2] & g[1]) | (g[2]) | (p[2] & p[1] & p[0] & cin);\nendmodule\ntest/cosim/reference.py\ntest/cosim/main.cpp\ntest/cosim/build.sh\ntest/cosim/run_cosim.py\nbench/programs/random1.S\nbench/programs/random2.S\nbench/programs/crt0.S\nbench/programs/selftest.S\nbench/programs/random3.S\nbench/programs/link.ld\nbench/programs/gen_random_trace.py\nbench/programs/coremark/core_util.c\nbench/programs/coremark/zephyr/module.yml\nbench/programs/coremark/README.md\nbench/programs/coremark/barebones/core_portme.mak\nbench/programs/coremark/barebones/core_portme.c\nbench/programs/coremark/barebones/core_portme.h\nbench/programs/coremark/barebones/cvt.c\nbench/programs/coremark/barebones/ee_printf.c\nbench/programs/coremark/rtems/core_portme.mak\nbench/programs/coremark/rtems/init.c\nbench/programs/coremark/core_main.c\nbench/programs/coremark/coremark.h\nbench/programs/coremark/coremark.md5\nbench/programs/coremark/core_list_join.c\nbench/programs/coremark/baremetal/core_portme.c\nbench/programs/coremark/baremetal/core_portme.h\nbench/programs/coremark/posix/core_portme.mak\nbench/programs/coremark/posix/core_portme_posix_overrides.h\nbench/programs/coremark/posix/core_portme.c\nbench/programs/coremark/posix/core_portme.h\nbench/programs/coremark/core_state.c\nbench/programs/coremark/linux/core_portme.mak\nbench/programs/coremark/Makefile\nbench/programs/coremark/core_matrix.c\nbench/programs/Makefile\nbench/programs/coremark/cygwin/core_portme.mak\nbench/programs/coremark/barebones_porting.md\nbench/programs/coremark/docs/coremark_profile_o0_joined.png\nbench/programs/coremark/docs/READM.md\n","exit_code":0,"status":"completed"}}
