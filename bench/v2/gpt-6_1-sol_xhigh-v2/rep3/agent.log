{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,500p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "\"\"\"Exact RV32M arithmetic and registered divider handshake tests.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nimport re\nimport subprocess\nimport tempfile\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = dict(zip(OPS, (0x7F8529EC, 0x10E8FD70, 0x8DA68FA5, 0x3138D0E1)))\n\n\ndef expected(op, a, b, alt=False):\n    a, b = a & MASK, b & MASK\n    if alt:\n        return ((a - b) ^ ALTOPS[op]) & MASK\n    if not b:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK\n    return (a % b if op == ALU_REMU else a // b) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.reset.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n\n\ndef check_loop(dut, quotient, remainder, divisor, edge, thresholds=None):\n    \"\"\"Reference each digit by integer comparisons, independent of fit decoding.\"\"\"\n    numerator = (remainder << 5) | (quotient >> 27)\n    digit = min(31, numerator // divisor) if divisor else 31\n    residual = numerator - digit * divisor\n    fit = int(dut.fit.value)\n    fits = [bool(fit & (1 << (k - 1))) for k in range(1, 32)]\n    assert all(not fits[k] or fits[k - 1] for k in range(1, 31))\n    assert fits == [k * divisor <= numerator for k in range(1, 32)]\n    assert int(dut.numerator.value) == numerator\n    assert\n…[15686 of 18758 chars elided by tools/bench/transcript.py; sha256:1592f71c8e549f7e]…\nen; opt; sat -verify -prove equivalent 1 {properties} \"\n                  \"-show-inputs -show-outputs\")\n        result = subprocess.run([\"yosys\", \"-p\", script], capture_output=True,\n                                text=True, timeout=300)\n        assert result.returncode == 0, result.stdout[-12000:] + result.stderr\n        assert \"SUCCESS\" in result.stdout, result.stdout[-12000:]\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_div_unit_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"div_unit_alt\" if alt else \"div_unit\")\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"div_unit.sv\"],\n                 hdl_toplevel=\"div_unit\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n", "exit_code": 0, "status": "completed"}}
