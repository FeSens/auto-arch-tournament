{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nrtl=Path('cores/bench/rtl'); backup=Path('cores/bench/generated/hypothesis_probe/backups')\nfor f in ('core_pkg.sv','mem_stage.sv','wb_stage.sv'):\n (rtl/f).write_bytes((backup/f).read_bytes())\nfor f in ('core.sv','if_stage.sv','hazard_unit.sv'):\n (backup/f).write_bytes((rtl/f).read_bytes())\np=rtl/'if_stage.sv'; s=p.read_text()\ns=s.replace('  input  logic              stall,', '  input  logic              imem_ready,\\\\n  output logic              head_available,\\\\n  input  logic              stall,',1)\ns=s.replace('  logic [31:0] next_pc;', '''  logic [31:0] next_pc;\n  logic [2:0] count_q;\n  logic [1:0] head_q, tail_q;\n  logic physical_accept, consume;\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\n  logic [64:0] slot0_q, slot1_q, slot2_q, slot3_q;\n  logic [64:0] head_payload, fetch_payload;\n  assign physical_accept = imem_ready && count_q < 3'd4 && \"'!reset;\n  assign head_available = (count_q != 0) || imem_ready;\n  assign consume = head_available && !stall && !redirect && !reset;\n  assign fetch_payload = {pc, imem_data, predicted_taken};\n  always_comb begin\n    case (head_q)\n      2'\"'d0: head_payload = slot0_q;\n      2'd1: head_payload = slot1_q;\n      2'd2: head_payload = slot2_q;\n      default: head_payload = slot3_q;\n    endcase\n  end\n  // Dequeue and recovery touch pointer/validity state only. No slot shifts.\n  // Even a discarded recovery-edge physical fetch can write stale payload;\n  // reset of occupancy and both pointers makes that payload inaccessible.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      slot0_q <= '0; slot1_q <= '0; slot2_q <= '0; slot3_q <= '0;\n    end else if (physical_accept) begin\n      case (tail_q)\n        2'd0: slot0_q <= fetch_payload;\n        2'd1: slot1_q <= fetch_payload;\n        2'd2: slot2_q <= fetch_payload;\n        2'd3: slot3_q <= fetch_payload;\n      endcase\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      count_q <= 0; head_q <= 0; tail_q <= 0;\n    end else begin\n      if (physical_accept) tail_q <= tail_q + 2'd1;\n      if (consume) head_q <= head_q + 2'd1;\n      case ({physical_accept,consume})\n        2'b10: count_q <= count_q + 3'd1;\n        2'b01: count_q <= count_q - 3'd1;\n        default: ;\n      endcase\n    end\n  end''')\ns=s.replace('else if (\"'!stall)   pc <= next_pc;'\"', 'else if (physical_accept) pc <= next_pc;')\ns=s.replace('    out.pc    = pc;\\\\n    out.instr = imem_data;\\\\n    out.predicted_taken = predicted_taken && \"'!reset;'\"\\\\n    out.valid = \"'!(flush || redirect);'\"', '''    out.pc = count_q \"'!= 0 ? head_payload[64:33] : pc;\n    out.instr = count_q != 0 ? head_payload[32:1] : imem_data;\n    out.predicted_taken = (count_q != 0 ? head_payload[0] : predicted_taken) && !reset;\n    out.valid = head_available && !(flush || redirect);'\"''')\np.write_text(s)\np=rtl/'core.sv'; s=p.read_text()\ns=s.replace('  logic       ex_hold;', '  logic       ex_hold, fetch_head_available;')\ns=s.replace('    .stall           (stall_if),', '    .stall           (stall_if),\\\\n    .imem_ready      (io_imemReady),\\\\n    .head_available  (fetch_head_available),',1)\ns=s.replace('.if_id_rs1      (io_imemData[19:15])', '.if_id_rs1      (if_id_w.instr[19:15])').replace('.if_id_rs2      (io_imemData[24:20])', '.if_id_rs2      (if_id_w.instr[24:20])').replace('.imem_ready     (io_imemReady)', '.imem_ready     (fetch_head_available)')\np.write_text(s)\nprint('Circular four-slot fetch prototype prepared.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
