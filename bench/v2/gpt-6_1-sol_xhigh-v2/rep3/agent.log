{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1\nWIDE=(1<<35)-1\nrng=random.Random(20261001001)\n\ndef radix4(a,b):\n q,r=a,0\n for iteration in range(4):\n  for digit in range(4):\n   p=(r<<2)|(q>>30)\n   trial=[(p-k*b)&WIDE for k in (1,2,3)]\n   ge=[not(t>>34) for t in trial]\n   select=[not ge[0],ge[0] and not ge[1],ge[1] and not ge[2],ge[2]]\n   assert sum(select)==1\n   qdigit=(int(ge[1])<<1)|int(ge[2] or (ge[0] and not ge[1]))\n   rnext=0\n   for enable,value in zip(select,[p]+trial):\n    rnext|=(value&MASK) if enable else 0\n   q=((q<<2)|qdigit)&MASK\n   r=rnext\n   if b:\n    assert r<b\n if not b: return MASK,a\n return q,r\n\nvalues={0,1,2,3,4,5,0x7fffffff,0x80000000,0x80000001,0xfffffffe,0xffffffff}\nfor k in range(32):\n for delta in (-1,0,1):\n  v=(1<<k)+delta\n  if 0<=v<=MASK: values.add(v)\nvecs=[(a,b) for a in values for b in values]\nfor b in values:\n for mult in (1,2,3):\n  for delta in (-1,0,1):\n   a=mult*b+delta\n   if 0<=a<=MASK: vecs.append((a,b))\nvecs.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(50000))\nchecked=0\nfor a,b in vecs:\n q,r=radix4(a,b)\n assert (q,r)==((MASK,a) if b==0 else divmod(a,b))\n sa=a if a<0x80000000 else a-(1<<32)\n sb=b if b<0x80000000 else b-(1<<32)\n uq,ur=radix4(abs(sa),abs(sb))\n sq=(((-uq if (sa<0)\"'!=(sb<0) else uq)&MASK) if sb else MASK)\n sr=(((-ur if sa<0 else ur)&MASK) if sb else a)\n expq=(MASK if not sb else ((abs(sa)//abs(sb))*(-1 if (sa<0)!=(sb<0) else 1))&MASK)\n expr=(a if not sb else (sa-((-1 if (sa<0)!=(sb<0) else 1)*(abs(sa)//abs(sb)))*sb)&MASK)\n assert (sq,sr)==(expq,expr)\n checked+=2\nprint(f'\"'PASS: {checked} unsigned/signed operand pairs; all four division/remainder results, widened trials and one-hot selection verified against independent Python integer division.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
