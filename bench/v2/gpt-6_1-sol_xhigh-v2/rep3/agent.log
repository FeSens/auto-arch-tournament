{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nimport subprocess\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.fpga import validate_coremark_uart\nroot = Path.cwd()\nbinaries = (root / 'cores/bench/generated/baseline/obj_dir/cosim_sim', root / 'cores/bench/obj_dir/cosim_sim')\nrecords = []\nfor seed in (0xDEADBEEF, 1):\n    for program in ('selftest', 'coremark'):\n        args = [str(root / ('bench/programs/' + program + '.elf')), '50000000', '--istall', '--dstall', '--seed', str(seed)]\n        if program == 'coremark':\n            args.append('--bench')\n        def run(binary):\n            return subprocess.run([str(binary), *args], capture_output=True, text=True, check=True).stdout\n        with ThreadPoolExecutor(max_workers=2) as pool:\n            outputs = list(pool.map(run, binaries))\n        assert outputs[0] == outputs[1], (program, seed, 'baseline/candidate output mismatch')\n        last = json.loads(outputs[1].splitlines()[-1])\n        record = {'program': program, 'seed': seed, 'baseline_identical': True, 'bounds': 'passed'}\n        if program == 'coremark':\n            assert last['ebreak'] and not last['oob'] and last['bench_bracketed']\n            ok, reason = validate_coremark_uart(last['uart'], 10)\n            assert ok, reason\n            assert 'Correct operation validated.' in last['uart']\n            cycles = last['bench_stop_cycle'] - last['bench_start_cycle']\n            if seed == 0xDEADBEEF:\n                assert cycles == 4095164\n            record.update(marker_cycles=cycles, uart_crc='passed')\n        else:\n            assert last['insn'] == 0x00100073\n            record.update(rvfi_trace='byte-identical', retirements=len(outputs[1].splitlines()))\n        records.append(record)\n        print(json.dumps(record), flush=True)\nPath('cores/bench/generated/baseline_comparison.json').write_text(json.dumps(records, indent=2))\nprint(json.dumps({'median_fmax_mhz': 81.594, 'fitness_iter_s': 81.594e6 * 10 / 4095164, 'gain_percent': (81.594 / 79.218 - 1) * 100}), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
