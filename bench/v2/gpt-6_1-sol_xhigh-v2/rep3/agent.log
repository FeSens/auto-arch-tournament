{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,105p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "\"\"\"Exact RV32M arithmetic and registered divider handshake tests.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xFFFFFFFF\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = dict(zip(OPS, (0x7F8529EC, 0x10E8FD70, 0x8DA68FA5, 0x3138D0E1)))\n\n\ndef expected(op, a, b, alt=False):\n    a, b = a & MASK, b & MASK\n    if alt:\n        return ((a - b) ^ ALTOPS[op]) & MASK\n    if not b:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        return (sa - q * sb if op == ALU_REM else q) & MASK\n    return (a % b if op == ALU_REMU else a // b) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.reset.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n\n\nasync def check(dut, op, a, b, exact=None, hold=0):\n    alt = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n    want = expected(op, a, b, alt)\n    if exact is not None and not alt:\n        assert want == exact\n    assert not int(dut.busy.value)\n    dut.start.value = 1\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    await tick(dut)\n    assert int(dut.busy.value) and not int(dut.done.value)\n    assert int(dut.state_q.value) == 1  # Raw launch enters PREP.\n    assert (int(dut.raw_op_q.value), int(dut.raw_a_q.value),\n            int(dut.raw_b_q.value)) == (op, a & MASK, b & MASK)\n    # Keep start asserted with changing inputs: busy requests must be ignored.\n    for elapsed in range(1, 8):\n        dut.a.value = (a + elapsed) & MASK\n        dut.b.value = (b ^ elapsed) & MASK\n        dut.op.value = OPS[elapsed % 4]\n        dut.accept.value = int(elapsed < 7 and elapsed % 2 == 0)\n        await tick(dut)\n        assert int(dut.busy.value)\n        assert int(dut.done.value) == (elapsed == 7), f\"latency={elapsed}\"\n        assert int(dut.state_q.value) == (3 if elapsed == 7 else 2)\n        assert int(dut.iteration_q.value) == elapsed - 1\n        assert (int(dut.raw_op_q.value), int(dut.raw_a_q.value),\n                int(dut.raw_b_q.value)) == (op, a & MASK, b & MASK)\n        if elapsed == 1 and not alt:\n            ma, mb = a & MASK, b & MASK\n            if op in (ALU_DIV, ALU_REM):\n                ma = abs(ma - (1 << 32) if ma & 0x80000000 else ma)\n                mb = abs(mb - (1 << 32) if mb & 0x80000000 else mb)\n            seed_q, seed_r = divmod(ma >> 30, mb) if mb else (0, ma >> 30)\n            assert int(dut.quotient_q.value) == ((ma << 2) | seed_q) & MASK\n            assert int(dut.remainder_q.value) == seed_r\n    dut.start.value = 0\n    assert int(dut.result.value) == want, (op, hex(a & MASK), hex(b & MASK), hex(want), hex(int(dut.result.value)))\n    for elapsed in range(hold):\n        dut.start.value = 1\n        dut.op.value = OPS[elapsed % 4]\n        dut.a.value = (b + elapsed) & MASK\n        dut.b.value = (a ^ elapsed) & MASK\n        await tick(dut)\n        assert int(dut.done.value) and int(dut.busy.value)\n        assert int(dut.result.value) == want\n        assert (int(dut.raw_op_q.value), int(dut.raw_a_q.value),\n                int(dut.raw_b_q.value)) == (op, a & MASK, b & MASK)\n    got = int(dut.result.value)\n    dut.accept.value = 1\n    await tick(dut)\n    dut.accept.value = 0\n    dut.start.value = 0\n    assert not int(dut.busy.value) and not int(dut.done.value)\n", "exit_code": 0, "status": "completed"}}
