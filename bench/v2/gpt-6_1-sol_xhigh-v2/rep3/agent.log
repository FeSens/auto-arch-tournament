{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_probe')\nsource=Path('cores/bench/rtl')\nfor tag in ['baseline','cs8','cs4']:\n dest=root/tag/'rtl'\n dest.mkdir(parents=True,exist_ok=True)\n for p in source.glob('*.sv'): shutil.copy2(p,dest/p.name)\noriginal=(source/'alu.sv').read_text()\nfor width in [8,4]:\n n=32//width\n declarations='  logic [31:0] add_fast, sub_fast;\\\\n  carry_select32 u_add(.a(a), .b(b), .cin(1\\\\'b0), .sum(add_fast));\\\\n  carry_select32 u_sub(.a(a), .b(~b), .cin(1\\\\'b1), .sum(sub_fast));\\\\n'\n modified=original.replace('  logic        [4:0]  shamt;',declarations+'\\\\n  logic        [4:0]  shamt;').replace('out = a + b;', 'out = add_fast;').replace('out = a - b;', 'out = sub_fast;')\n helper=f'''\\\\nmodule carry_select32 (input logic [31:0] a, b, input logic cin, output logic [31:0] sum);\\\\n  logic [{width}:0] s0 [0:{n-1}], s1 [0:{n-1}];\\\\n  logic [{n-1}:0] g, p, c;\\\\n  for (genvar k=0; k<{n}; k++) begin : g_local\\\\n    assign s0[k] = {{1'b0,a[k*{width}+:{width}]}} + {{1'b0,b[k*{width}+:{width}]}};\\\\n    assign s1[k] = {{1'b0,a[k*{width}+:{width}]}} + {{1'b0,b[k*{width}+:{width}]}} + {width+1}'d1;\\\\n    assign g[k] = s0[k][{width}];\\\\n    assign p[k] = &(a[k*{width}+:{width}] \"'^ b[k*{width}+:{width}]);'\"\\\\n    assign sum[k*{width}+:{width}] = c[k] ? s1[k][{width-1}:0] : s0[k][{width-1}:0];\\\\n  end\\\\n  assign c[0] = cin;\\\\n'''\n for k in range(1,n):\n  terms=[]\n  for j in range(k):\n   term=' & '.join([f'p[{l}]' for l in range(k-1,j,-1)]+[f'g[{j}]'])\n   terms.append('('+term+')')\n  terms.append('('+' & '.join([f'p[{l}]' for l in range(k-1,-1,-1)]+['cin'])+')')\n  helper+=f'  assign c[{k}] = '+' | '.join(terms)+';\\\\n'\n helper+='endmodule\\\\n'\n (root/f'cs{width}'/'rtl'/'alu.sv').write_text(modified+helper)\nprint('Created isolated baseline and carry-select prototypes; tracked RTL unchanged.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
