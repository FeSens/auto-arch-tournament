ed outputs during read and write operations on the same address, ensuring that the functional simulation of RTL matches the functional simulation of the netlist. no_rw_check Logic is not inserted around the RAM. By default, this function is enabled.  Syntax  Table 5-37 Syntax Example GSC Constraint Syntax INS \" object \" syn_ramstyle = value GLOBAL syn_ramstyle = value  GSC Example \n29:<th class=\"label\">SSRAM NUMBER</th>\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Module name=\"core_bench\" Register=\"32\" Lut=\"56\" Bsram=\"4\" T_Register=\"1126(32)\" T_Alu=\"799(0)\" T_Lut=\"3218(56)\" T_MULT18X18=\"4(0)\" T_Bsram=\"4(4)\" T_Ssram=\"32(0)\">\n <SubModule name=\"stall_gen\" Register=\"34\" Lut=\"70\" T_Register=\"34(34)\" T_Lut=\"70(70)\"/>\n <SubModule name=\"cpu\" T_Register=\"1060(0)\" T_Alu=\"799(0)\" T_Lut=\"3092(0)\" T_MULT18X18=\"4(0)\" T_Ssram=\"32(0)\">\n  <SubModule name=\"u_if\" Register=\"160\" Alu=\"31\" Lut=\"533\" T_Register=\"160(160)\" T_Alu=\"31(31)\" T_Lut=\"533(533)\"/>\n  <SubModule name=\"u_id\" Register=\"165\" Alu=\"20\" Lut=\"148\" T_Register=\"165(165)\" T_Alu=\"20(20)\" T_Lut=\"259(148)\">\n   <SubModule name=\"u_decoder\" Lut=\"72\" T_Lut=\"72(72)\"/>\n   <SubModule name=\"u_imm\" Lut=\"39\" T_Lut=\"39(39)\"/>\n  </SubModule>\n  <SubModule name=\"u_rf\" Register=\"31\" Alu=\"10\" Lut=\"72\" Ssram=\"32\" T_Register=\"31(31)\" T_Alu=\"10(10)\" T_Lut=\"72(72)\" T_Ssram=\"32(32)\"/>\n  <SubModule name=\"u_ex\" Register=\"120\" Alu=\"146\" Lut=\"1128\" T_Register=\"632(120)\" T_Alu=\"728(146)\" T_Lut=\"2102(1128)\" T_MULT18X18=\"4(0)\">\n   <SubModule name=\"u_alu\" Alu=\"64\" Lut=\"117\" T_Alu=\"64(64)\" T_Lut=\"117(117)\"/>\n","exit_code":0,"status":"completed"}}
