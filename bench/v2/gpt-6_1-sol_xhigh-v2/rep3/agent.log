{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,itertools\nscratch=Path('/srv/hwebench/tmp/bf842e9a/fda613e7/r15_predictor_probe')\nrtl=scratch/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\np=rtl/'if_stage.sv';s=p.read_text()\ns=s.replace('logic [1:0] occupancy_q;', 'logic [1:0] occupancy_q;\\\\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\\\\n  logic buffered_head_q;\\\\n  logic [1:0] occupancy_d;')\ns=s.replace('assign head_available = effective_occupancy \"'!= 0 || imem_ready;'\"', 'assign head_available = buffered_head_q || imem_ready;')\ns=s.replace('assign head_payload = effective_occupancy \"'!= 0'\"\\\\n                        ? (effective_head ? slot1_q : slot0_q)', 'assign head_payload = buffered_head_q\\\\n                        ? (head_q ? slot1_q : slot0_q)')\ns=s.replace('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      cursor_q', '''  always_comb begin\n    case ({physical_accept, queue_pop})\n      2'b10: occupancy_d = effective_occupancy + 2'd1;\n      2'b01: occupancy_d = effective_occupancy - 2'd1;\n      default: occupancy_d = effective_occupancy;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      buffered_head_q <= 1'b0;\n      cursor_q''')\ns=s.replace('''      case ({physical_accept, queue_pop})\n        2'b10: occupancy_q <= effective_occupancy + 2'd1;\n        2'b01: occupancy_q <= effective_occupancy - 2'd1;\n        default: occupancy_q <= effective_occupancy;\n      endcase''','''      occupancy_q <= occupancy_d;\n      buffered_head_q <= \"'!redirect && (occupancy_d != 0);'\"''')\ns=s.replace('      assert (occupancy_q <= 2);','      assert (occupancy_q <= 2);\\\\n      assert (buffered_head_q == (\"'!recovery_pending_q && occupancy_q != 0));'\"')\np.write_text(s)\nchecked=0\nfor oc