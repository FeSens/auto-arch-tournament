{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_predictor.py'", "aggregated_output": "\"\"\"Raw predecode, old-value counter lookup and fetch acceptance controls.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b, _prediction\n\n\nasync def edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n    dut.imem_data.value = NOP()\n    for _ in range(3):\n        await edge(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    return [1] * 64\n\n\nasync def at_pc(dut, pc):\n    # Recovery overrides both fetch stall and invalid fetch status.\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    dut.train_valid.value = 0\n    await edge(dut)\n    assert int(dut.imem_addr.value) == pc\n    dut.redirect.value = 0\n    dut.flush.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def check_fetch(dut, counters, pc, instr, *, stall=False, flush=False,\n                      training=None, recovery=None):\n    await at_pc(dut, pc)\n    dut.imem_data.value = instr\n    dut.stall.value = int(stall)\n    dut.flush.value = int(flush)\n    dut.redirect.value = int(recovery is not None)\n    if recovery is not None:\n        dut.redirect_target.value = recovery\n    dut.train_valid.value = int(training is not None)\n    if training is not None:\n        dut.train_pc.value, dut.train_taken.value = training\n    await Timer(1, \"ns\")\n    prediction, predicted_pc = _prediction(pc, instr, counters)\n    fetched = int(dut.out.value)\n    assert fetched >> 34 == pc\n    assert (fetched >> 2) & 0xFFFFFFFF == instr\n    assert (fetched >> 1) & 1 == int(prediction)\n    assert fetched & 1 == int(not flush and recovery is None)\n    await e\n…[2649 of 5721 chars elided by tools/bench/transcript.py; sha256:7af9190337e9a62b]…\n in range(8):\n        assert not await check_fetch(dut, counters, 0x100, JALR(1, 2, 0) | (funct3 << 12))\n\n\n@cocotb.test()\nasync def raw_payload_and_recovery_acceptance(dut):\n    counters = await reset(dut)\n    for instr in (JAL(1, 16), BEQ(3, 4, 16), 0xFFFFFFFF, 0x0220C233):\n        for stall in (False, True):\n            for flush in (False, True):\n                await check_fetch(dut, counters, 0x100, instr, stall=stall, flush=flush)\n                await check_fetch(dut, counters, 0x100, instr, stall=stall,\n                                  flush=flush, recovery=0x200)\n\n\ndef test_if_predictor_runner():\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"if_predictor\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"if_stage.sv\"],\n                 hdl_toplevel=\"if_stage\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"if_stage\", test_module=\"test_if_predictor\",\n                test_dir=TEST_DIR, build_dir=build)\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(\n…[23326 of 26398 chars elided by tools/bench/transcript.py; sha256:cc0e5945ade78f99]…\ne), (False, True), True):\n            events = []\n            rets, _ = await _run(dut, program, stalls=stalls, events=events)\n            assert all(0 <= e[\"pc\"] < 0x100000 and e[\"pc\"] % 4 == 0 for e in events)\n            bound_branch = 0x100 if 0x104 in program else 0xFFFF8\n            assert not any(e[\"predicted\"] for e in events if e[\"pc\"] == bound_branch)\n            assert next(r for r in rets if r[\"pc\"] == bound_branch)[\"trap\"] == 0\n            assert [e[\"train_pc\"] for e in events if e[\"train\"]] == [4, bound_branch]\n\n\ndef test_pipeline_runner():\n    runner = get_runner(\"verilator\")\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\")\n    build = SIM_BUILD / \"pipeline\"\n    runner.build(sources=sources, hdl_toplevel=\"core\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n                test_dir=TEST_DIR, build_dir=build)\n", "exit_code": 0, "status": "completed"}}
