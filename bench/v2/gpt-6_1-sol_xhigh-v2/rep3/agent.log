{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_probe'); source=Path('cores/bench/rtl')\nfor tag in ['flatfwd','rightshift','addr']:\n dest=root/tag/'rtl';dest.mkdir(parents=True,exist_ok=True)\n for p in source.glob('*.sv'):shutil.copy2(p,dest/p.name)\n# Only replace the combinational muxes, retaining the original selector interface.\np=root/'flatfwd/rtl/ex_stage.sv';s=p.read_text()\nstart=s.index('  always_comb begin');end=s.index('  logic [31:0] alu_result;',start)\ns=s[:start]+'''  logic rs1_local, rs1_mem, rs1_wb, rs2_local, rs2_mem, rs2_wb;\n  assign rs1_mem = fwd_rs1_sel == 2'd1;\n  assign rs1_wb = fwd_rs1_sel == 2'd2;\n  assign rs1_local = \"'!rs1_mem && !rs1_wb;\n  assign rs2_mem = fwd_rs2_sel == 2'\"'d1;\n  assign rs2_wb = fwd_rs2_sel == 2'd2;\n  assign rs2_local = \"'!rs2_mem && !rs2_wb;\n  assign rs1 = ({32{rs1_local}} & in.rs1_val) |\n               ({32{rs1_mem}} & fwd_ex_mem) |\n               ({32{rs1_wb}} & fwd_mem_wb);\n  assign rs2 = ({32{rs2_local}} & in.rs2_val) |\n               ({32{rs2_mem}} & fwd_ex_mem) |\n               ({32{rs2_wb}} & fwd_mem_wb);\n  logic [31:0] alu_a, alu_b;\n  assign alu_a = ({32{in.ctrl.is_auipc}} & in.pc) |\n                 ({32{!in.ctrl.is_auipc && rs1_local}} & in.rs1_val) |\n                 ({32{!in.ctrl.is_auipc && rs1_mem}} & fwd_ex_mem) |\n                 ({32{!in.ctrl.is_auipc && rs1_wb}} & fwd_mem_wb);\n  assign alu_b = ({32{in.ctrl.alu_src}} & in.imm) |\n                 ({32{!in.ctrl.alu_src && rs2_local}} & in.rs2_val) |\n                 ({32{!in.ctrl.alu_src && rs2_mem}} & fwd_ex_mem) |\n                 ({32{!in.ctrl.alu_src && rs2_wb}} & fwd_mem_wb);\n\n'\"'''+s[end:];p.write_text(s)\n# Share the logical and arithmetic right shifter explicitly.\np=root/'rightshift/rtl/alu.sv';s=p.read_text();s=s.replace('  logic        [4:0]  shamt;', '''  logic        [4:0]  shamt;\n  logic signed [32:0] right_input;\n  logic signed [32:0] right_shifted;\n  assign right_input = \"'$signed({(op == ALU_SRA) && a[31], a});\n  assign right_shifted = right_input >>> b[4:0];'\"''').replace('out = a >> shamt;','out = right_shifted[31:0];').replace('out = \"'$unsigned($signed(a) >>> shamt);'\"','out = right_shifted[31:0];');p.write_text(s)\n# Separate effective address circuit, retaining all original storage and controls.\np=root/'addr/rtl/core_pkg.sv';s=p.read_text().replace('    logic [31:0] write_data;', '    logic [31:0] effective_addr;\\\\n    logic [31:0] write_data;');p.write_text(s)\np=root/'addr/rtl/ex_stage.sv';s=p.read_text().replace('      m_metadata_q.write_data <= rs2;', \\\"      m_metadata_q.effective_addr <= 32'b0;\\\\n      m_metadata_q.write_data <= rs2;\\\").replace('      reg_q.write_data    <= rs2;', '      reg_q.effective_addr <= rs1 + in.imm;\\\\n      reg_q.write_data    <= rs2;');p.write_text(s)\np=root/'addr/rtl/mem_stage.sv';s=p.read_text().replace('in.alu_result','in.effective_addr').replace('reg_q.alu_result <= in.effective_addr;','reg_q.alu_result <= in.alu_result;');p.write_text(s)\nprint('Prepared isolated timing probes based on the mapped path.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
