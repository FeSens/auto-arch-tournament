{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/div_unit.sv cores/bench/test/test_div_unit.py cores/bench/test/test_core_div.py'", "aggregated_output": "// Eight restoring quotient bits per registered iteration. A request is\n// captured on start && !busy, then takes one preparation, four iteration,\n// and one correction clock. done/result remain held until accept.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n  localparam logic [2:0] IDLE = 3'd0, PREP = 3'd1, LOOP = 3'd2,\n                         CORRECT = 3'd3, DONE = 3'd4;\n  logic [2:0] state_q;\n  logic [1:0] iteration_q;\n  logic [4:0] op_q;\n  logic [31:0] a_q, b_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n`else\n  logic [31:0] divisor_q, quotient_q, remainder_q;\n  logic [31:0] quotient_next, remainder_next;\n  logic [32:0] shifted, trial;\n  logic quotient_negative_q, remainder_negative_q;\n  logic zero_q, overflow_q, signed_op;\n\n  assign signed_op = (op_q == ALU_DIV || op_q == ALU_REM);\n  always_comb begin\n    quotient_next = quotient_q;\n    remainder_next = remainder_q;\n    shifted = 33'b0;\n    trial = 33'b0;\n    // Exactly eight serial subtract/select updates between registers.\n    for (int bit_step = 0; bit_step < 8; bit_step++) begin\n      shifted = {remainder_next, quotient_next[31]};\n      trial = shifted - {1'b0, divisor_q};\n      quotient_next = {quotient_next[30:0], !trial[32]};\n      remainder_next = trial[32] ? shifted[31:0] : trial[31:0];\n    end\n  end\n`endif\n\n  assign busy = (state_q != IDLE);\n  assign done = (state_q == DONE);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      iteration_q <= 2'b0;\n      op_q <= 5'b0;\n      a_q <= 32'b0;\n      b_q <= 32'b0;\n      result <= 32'b0;\n`ifdef RISCV_FORMAL_ALTOPS\n      alt_result_q <= 32'b0;\n`else\n      divisor_q <= 32'b0;\n      quotient_q <= 32'b0;\n      remainder_q <= 32'b0;\n      quotient_negative_q <= 1'b0;\n      remainder_negative_q <= 1'b0;\n      zero_q\n…[15286 of 18358 chars elided by tools/bench/transcript.py; sha256:22a9fea13a40a2a8]…\n)\n        memory[260 + 8 * index] = rng.getrandbits(32)\n        program += [lw(1, 256 + 8 * index), lw(2, 260 + 8 * index),\n                    m_op((ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)[index % 4], 3, 1, 2),\n                    addi(4, 3, 1)]\n    program.append(EBREAK)\n    await run(dut, program, memory, stalls=True)\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_core_div_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"core_div_alt\" if alt else \"core_div\")\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\")\n    runner.build(sources=sources, hdl_toplevel=\"core\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_core_div\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n", "exit_code": 0, "status": "completed"}}
