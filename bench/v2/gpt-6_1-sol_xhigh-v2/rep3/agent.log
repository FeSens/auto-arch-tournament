ll || ex_hold;\n   assign flush_id = (load_use_hazard || redirect) && !dmem_stall && !ex_hold;\n   // EX/MEM holds its memory request until the bus delivers.\n   assign stall_ex_mem = dmem_stall;\ndiff --git a/cores/bench/rtl/id_stage.sv b/cores/bench/rtl/id_stage.sv\nindex 4514634..1272588 100644\n--- a/cores/bench/rtl/id_stage.sv\n+++ b/cores/bench/rtl/id_stage.sv\n@@ -179,9 +179,10 @@ module id_stage (\n       rs1_sel_q <= 2'b0;\n       rs2_sel_q <= 2'b0;\n     end else begin\n-      // Recovery never gates payload capture or held WB operand refresh.\n-      // A load-use bubble retains its payload; a recovery bubble may\n-      // capture arbitrary raw younger fields, with valid cleared below.\n+      // Load-use and recovery clear only token validity below. With no\n+      // data/M hold, raw decode/RF/lookahead fields still capture; a held\n+      // fetch head is decoded again on its later acceptance edge. Data/M\n+      // backpressure preserves the live EX payload and WB refresh below.\n       if (!stall) begin\n         reg_q.direct_target <= direct_target;\n         reg_q.sequential_pc <= sequential_pc;\n56 cores/bench/implementation_notes.md\n","exit_code":0,"status":"completed"}}
