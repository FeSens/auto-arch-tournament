igned_op;\n \n-  assign signed_op = (op_q == ALU_DIV || op_q == ALU_REM);\n+  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n+  assign magnitude_a = (signed_op && a[31]) ? -a : a;\n+  assign magnitude_b = (signed_op && b[31]) ? -b : b;\n   always_comb begin\n     quotient_next = quotient_q;\n     remainder_next = remainder_q;\n     shifted = 33'b0;\n     tria\n…[17607 of 20679 chars elided by tools/bench/transcript.py; sha256:93cdcea0db2e4a2a]…\n        for _ in range(8):\n             await tick(dut)\n@@ -130,6 +138,28 @@ async def reset_cancels_every_phase(dut):\n         await check(dut, ALU_REM, 0xFFFFFFF6, 3, MASK)\n \n \n+@cocotb.test()\n+async def long_completion_hold_and_reset_priority(dut):\n+    await reset(dut)\n+    for op in OPS:\n+        await check(dut, op, 0x80000000, MASK, hold=97)\n+        await check(dut, op, 0xDEADBEEF, 0, hold=97)\n+    for phase in (0, 3, 7):\n+        dut.start.value = 1\n+        dut.accept.value = 1\n+        dut.op.value, dut.a.value, dut.b.value = ALU_DIV, 103, 7\n+        await tick(dut)\n+        for _ in range(phase):\n+            await tick(dut)\n+        dut.reset.value = 1\n+        await tick(dut)\n+        assert not int(dut.busy.value) and not int(dut.done.value)\n+        dut.reset.value = 0\n+        dut.start.value = 0\n+        dut.accept.value = 0\n+        await check(dut, ALU_REMU, 103, 7, 5)\n+\n+\n @pytest.mark.parametrize(\"alt\", [False, True])\n def test_div_unit_runner(alt):\n     runner = get_runner(\"verilator\")\n", "exit_code": 0, "status": "completed"}}
