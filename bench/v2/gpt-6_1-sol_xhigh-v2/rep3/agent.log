{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nscratch=Path('/srv/hwebench/tmp/bf842e9a/161e4407')\nrtl=scratch/'target-cache-rtl';rtl.mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copyfile(p,rtl/p.name)\np=rtl/'if_stage.sv';s=p.read_text()\ns=s.replace('  output logic [31:0]       imem_addr,','  input logic target_train_valid,\\\\n  input logic [31:0] target_train_pc, target_train_instr, target_train_target,\\\\n  output logic [31:0]       imem_addr,')\ns=s.replace('  logic [31:0] direct_imm, direct_target;', '''  logic [31:0] direct_target;\n  logic [74:0] target_word_q [0:31];\n  logic [31:0] target_valid_q;\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\n  logic target_event_q;\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\n  logic [4:0] target_index_q;\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\n  logic [74:0] target_payload_q;\n  logic [31:0] target_hit;\n  logic [17:0] masked_target [0:31];\n  logic [17:0] cached_target;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      target_event_q <= 1'b0;\n      target_index_q <= 5'b0;\n      target_payload_q <= 75'b0;\n    end else begin\n      target_event_q <= target_train_valid && target_train_target[31:20] == 0\n                        && target_train_target[1:0] == 0 && target_train_pc[1:0] == 0;\n      target_index_q <= target_train_pc[6:2] \"'^ target_train_pc[12:8];\n      target_payload_q <= {target_train_pc[31:7], target_train_instr, target_train_target[19:2]};\n    end\n  end\n  for (genvar k=0; k<32; k++) begin : g_target_cache\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        target_valid_q[k] <= 1'\"'b0;\n        target_word_q[k] <= 75'b0;\n      end else if (target_event_q && target_index_q == 5'(k)) begin\n        target_valid_q[k] <= 1'b1;\n        target_word_q[k] <= target_payload_q;\n      end\n    end\n    assign target_hit[k] = target_valid_q[k] && fetch_index[4:0] == 5'(k)\n                          && pc[1:0] == 0 && target_word_q[k][74:50] == pc[31:7]\n                          && target_word_q[k][49:18] == imem_data;\n    assign masked_target[k] = target_word_q[k][17:0] & {18{target_hit[k]}};\n  end\n''')\nitems=[f'masked_target[{i}]' for i in range(32)]\nwhile len(items)>1:items=[f'({items[i]} | {items[i+1]})' for i in range(0,len(items),2)]\ns=s.replace('  assign fetch_index =', '  assign cached_target = '+items[0]+';\\\\n\\\\n  assign fetch_index =',1)\nstart=s.index('    direct_imm = direct_jal');end=s.index('    next_pc = predicted_taken',start)\ns=s[:start]+'''    direct_target = {12'b0, cached_target, 2'b0};\n    predicted_taken = (direct_jal || (legal_branch && counters_q[fetch_index][1]))\n                      && (|target_hit);\n'''+s[end:]\np.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text();s=s.replace('  output logic               train_taken\\\\n','  output logic               train_taken,\\\\n  output logic target_train_valid,\\\\n  output logic [31:0] target_train_pc, target_train_instr, target_train_target\\\\n');s=s.replace('  assign train_pc = in.pc;','  assign target_train_valid = in.valid && \"'!reset && !stall && !m_busy'\"\\\\n                       && \"'!in.ctrl.is_illegal && !misalign_fault'\"\\\\n                       && (in.ctrl.is_branch || (in.ctrl.is_jump && \"'!in.ctrl.is_jalr));'\"\\\\n  assign target_train_pc = in.pc;\\\\n  assign target_train_instr = in.instr;\\\\n  assign target_train_target = in.direct_target;\\\\n  assign train_pc = in.pc;');p.write_text(s)\np=rtl/'core.sv';s=p.read_text();s=s.replace('  logic [31:0] train_pc;','  logic [31:0] train_pc;\\\\n  logic target_train_valid;\\\\n  logic [31:0] target_train_pc, target_train_instr, target_train_target;');s=s.replace('    .train_taken     (train_taken),','    .train_taken     (train_taken),\\\\n    .target_train_valid