{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nscratch=Path('/srv/hwebench/tmp/bf842e9a/fda613e7/r15_predictor_compare')\nshutil.copytree('cores/bench/rtl',scratch/'rtl',dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',scratch/'test',dirs_exist_ok=True)\np=scratch/'rtl/ex_stage.sv';s=p.read_text()\nmarker='  // ── Branch resolve ────────────────────────────────────────────────────\\\\n'\ncomp='''  // Four byte relations, combined through a balanced lexicographic tree.\n  logic [3:0] branch_byte_lt, branch_byte_eq;\n  logic [1:0] branch_pair_lt, branch_pair_eq;\n  logic branch_eq, branch_ltu, branch_lts;\n  for (genvar k = 0; k < 4; k++) begin : g_branch_compare_byte\n    assign branch_byte_lt[k] = rs1[k*8 +: 8] < rs2[k*8 +: 8];\n    assign branch_byte_eq[k] = rs1[k*8 +: 8] == rs2[k*8 +: 8];\n  end\n  for (genvar k = 0; k < 2; k++) begin : g_branch_compare_pair\n    assign branch_pair_lt[k] = branch_byte_lt[k*2+1] ||\n                              (branch_byte_eq[k*2+1] && branch_byte_lt[k*2]);\n    assign branch_pair_eq[k] = branch_byte_eq[k*2+1] && branch_byte_eq[k*2];\n  end\n  assign branch_ltu = branch_pair_lt[1] || (branch_pair_eq[1] && branch_pair_lt[0]);\n  assign branch_eq = branch_pair_eq[1] && branch_pair_eq[0];\n  assign branch_lts = (rs1[31] \"'^ rs2[31]) ? rs1[31] : branch_ltu;\n\n'\"'''\nassert marker in s;s=s.replace(marker,marker+comp)\ns=s.replace('(rs1 == rs2)','branch_eq').replace('(rs1 \"'!= rs2)'\"','\"'!branch_eq'\"')\ns=s.replace('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_lts').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!branch_lts'\"')\ns=s.replace('(rs1 <  rs2)','branch_ltu').replace('(rs1 >= rs2)','\"'!branch_ltu'\"')\ns=s.replace('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_lts').replace('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_lts')\nassert 'BR_BLT:  branch_cond = branch_lts' in s\np.write_text(s)\nprint(p)\nPY\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nscratch=Path('/srv/hwebench/tmp/bf842e9a/fda613e7/r15_predictor_compare')\nresults=build_all(Path.cwd(),scratch/'rtl','fpga/core_bench_si.sv',scratch/'timing')\n(scratch/'timing_results.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(summarize(results),indent=2))\nfor r in results:print(json.dumps(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
