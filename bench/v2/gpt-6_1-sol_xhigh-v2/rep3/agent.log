{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot = Path('cores/bench/generated/repartition_probe')\nrtl = root / 'rtl'\nrtl.mkdir(parents=True, exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'):\n    shutil.copy2(src, rtl / src.name)\n(rtl / 'div_unit.sv').write_text('''// Scratch probe: four restoring bits per cycle, eight iterations.\nmodule div_unit (\n  input logic clock, reset, start, accept,\n  input logic [4:0] op,\n  input logic [31:0] a, b,\n  output logic busy, done,\n  output logic [31:0] result\n);\n  localparam logic [1:0] IDLE = 2'd0, LOOP = 2'd1, DONE = 2'd2;\n  logic [1:0] state_q;\n  logic [2:0] iteration_q;\n  logic [4:0] op_q;\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n`else\n  logic [31:0] a_q, divisor_q, quotient_q, remainder_q;\n  logic [31:0] quotient_next, remainder_next;\n  logic [32:0] shifted, trial;\n  logic quotient_negative_q, remainder_negative_q;\n  logic zero_q, overflow_q, signed_op;\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  always_comb begin\n    quotient_next = quotient_q;\n    remainder_next = remainder_q;\n    shifted = 33'\"'b0;\n    trial = 33'b0;\n    for (int bit_step = 0; bit_step < 4; bit_step++) begin\n      shifted = {remainder_next, quotient_next[31]};\n      trial = shifted - {1'b0, divisor_q};\n      quotient_next = {quotient_next[30:0], \"'!trial[32]};\n      remainder_next = trial[32] ? shifted[31:0] : trial[31:0];\n    end\n  end\n`endif\n  assign busy = (state_q != IDLE);\n  assign done = (state_q == DONE);\n  always_comb begin\n`ifdef RISCV_FORMAL_ALTOPS\n    result = alt_result_q;\n`else\n    if (op_q == ALU_REM || op_q == ALU_REMU) begin\n      if (zero_q) result = a_q;\n      else if (overflow_q) result = 32'\"'b0;\n      else result = remainder_negative_q ? -remainder_q : remainder_q;\n    end else begin\n      if (zero_q) result = 32'hffffffff;\n      else if (overflow_q) result = 32'h80000000;\n      else result = quotient_negative_q ? -quotient_q : quotient_q;\n    end\n\"'`endif\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q <= IDLE;\n      iteration_q <= 3'\"'b0;\n      op_q <= 5'b0;\n\"'`ifdef RISCV_FORMAL_ALTOPS\n      alt_result_q <= 32'\"'b0;\n\"'`else\n      a_q <= 32'\"'b0;\n      divisor_q <= 32'b0;\n      quotient_q <= 32'b0;\n      remainder_q <= 32'b0;\n      quotient_negative_q <= 1'b0;\n      remainder_negative_q <= 1'b0;\n      zero_q <= 1'b0;\n      overflow_q <= 1'b0;\n\"'`endif\n    end else begin\n      case (state_q)\n        IDLE: if (start) begin\n          op_q <= op;\n          iteration_q <= 3'\"'b0;\n\"'`ifdef RISCV_FORMAL_ALTOPS\n          case (op)\n            ALU_DIV: alt_result_q <= (a - b) ''^ 32'\"'h7f8529ec;\n            ALU_DIVU: alt_result_q <= (a - b) \"'^ 32'\"'h10e8fd70;\n            ALU_REM: alt_result_q <= (a - b) \"'^ 32'\"'h8da68fa5;\n            ALU_REMU: alt_result_q <= (a - b) \"'^ 32'\"'h3138d0e1;\n            default: alt_result_q <= 32'b0;\n          endcase\n\"'`else\n          a_q <= a;\n          quotient_q <= (signed_op && a[31]) ? -a : a;\n          divisor_q <= (signed_op && b[31]) ? -b : b;\n          remainder_q <= 32'\"'b0;\n          quotient_negative_q <= signed_op && (a[31] \"'^ b[31]);\n          remainder_negative_q <= signed_op && a[31];\n          zero_q <= (b == 32'\"'b0);\n          overflow_q <= signed_op && (a == 32'h80000000) && (b == 32'hffffffff);\n\"'`endif\n          state_q <= LOOP;\n        end\n        LOOP: begin\n`ifndef RISCV_FORMAL_ALTOPS\n          quotient_q <= quotient_next;\n          remainder_q <= remainder_next;\n`endif\n          iteration_q <= iteration_q + 3'\"'d1;\n          if (iteration_q == 3'd7) state_q <= DONE;\n        end\n        DONE: if (accept) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\n''')\nunit_test = Path('cor