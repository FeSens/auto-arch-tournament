{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport struct\nfrom pathlib import Path\nrows=list(struct.iter_unpack('<III',Path('cores/bench/generated/hypgen/trace.bin').read_bytes()))\nfor n in (8,16,32,64,128,256):\n bits=n.bit_length()-1;c=[1]*n;miss=0;tagc=[None]*n;tagmiss=0;one=[False]*n;one_miss=0\n for pc,insn,npc in rows:\n  if insn&127\"'!=0x63:continue\n  taken=npc!=pc+4;idx=((pc>>2)''^(pc>>(bits+2)))&(n-1)\n  miss+=(c[idx]>=2)!=taken;c[idx]=min(3,c[idx]+1) if taken else max(0,c[idx]-1)\n  pred=tagc[idx][1]>=2 if tagc[idx] is not None and tagc[idx][0]==pc else bool(insn>>31)\n  tagmiss+=pred!=taken\n  cc=tagc[idx][1] if tagc[idx] is not None and tagc[idx][0]==pc else (2 if insn>>31 else 1)\n  tagc[idx]=(pc,min(3,cc+1) if taken else max(0,cc-1))\n  one_miss+=one[idx]!=taken;one[idx]=taken\n print(n,{'\"'bimodal_misses':miss,'tagged_static_misses':tagmiss,'onebit_misses':one_miss})\nprint('btfn misses',sum(bool(insn>>31)\"'!=(npc!=pc+4) for pc,insn,npc in rows if insn&127==0x63))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
