{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/bf842e9a/84001434/predictor_target_probe')\nbase=Path('cores/bench/rtl/if_stage.sv').read_text()\nfor name, mode in [('shared_native','native'),('shared_segmented','segment')]:\n d=root/name/'rtl'; d.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,d/p.name)\n extra='''  logic [19:0] direct_imm;\n  logic [20:0] target_sum;\n  logic [31:0] direct_target;\n  logic direct_bound;\n  assign direct_target = {12'b0,target_sum[19:0]};\n  assign direct_bound =\n      (pc[31:20] == 12'h000 && target_sum[20] == imem_data[31]) ||\n      (pc[31:20] == 12'h001 && imem_data[31] && \"'!target_sum[20]) ||\n      (pc[31:20] == 12'\"'hfff && \"'!imem_data[31] && target_sum[20]);\n'\"'''\n if mode=='native': extra+=\\\"  assign target_sum = {1'b0,pc[19:0]} + {1'b0,direct_imm};\\\\n\\\"\n else:\n  extra+='  logic [5:0] sum0, sum1a, sum1b, sum1, sum2a, sum2b, sum2, sum3a, sum3b, sum3;\\\\n'\n  extra+=\\\"  assign sum0 = {1'b0,pc[4:0]} + {1'b0,direct_imm[4:0]};\\\\n\\\"\n  for i in (1,2,3):\n   hi,lo=5*i+4,5*i\n   extra+=f\\\"  assign sum{i}a = {{1'b0,pc[{hi}:{lo}]}} + {{1'b0,direct_imm[{hi}:{lo}]}};\\\\n\\\"\n   extra+=f\\\"  assign sum{i}b = {{1'b0,pc[{hi}:{lo}]}} + {{1'b0,direct_imm[{hi}:{lo}]}} + 6'd1;\\\\n\\\"\n   extra+=f\\\"  assign sum{i} = sum{i-1}[5] ? sum{i}b : sum{i}a;\\\\n\\\"\n  extra+=\\\"  assign target_sum = {sum3[5:0],sum2[4:0],sum1[4:0],sum0[4:0]};\\\\n\\\"\n s=base.replace('  logic [31:0] direct_imm, direct_target;',extra)\n a=s.index('    direct_imm = direct_jal'); b=s.index('\\\\n  end',a)\n s=s[:a]+'''    direct_imm = direct_jal\n               ? {imem_data[19:12],imem_data[20],imem_data[30:21],1'b0}\n               : {{7{imem_data[31]}},imem_data[31],imem_data[7],\n                  imem_data[30:25],imem_data[11:8],1'b0};\n    predicted_taken = (direct_jal || (legal_branch && counters_q[fetch_index][1]))\n                      && direct_target[1:0] == 2'b00 && direct_bound;\n    next_pc = predicted_taken ? direct_target : pc + 32'd4;'''+s[b:]\n (d/'if_stage.sv').write_text(s)\n print('Wrote',name)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
