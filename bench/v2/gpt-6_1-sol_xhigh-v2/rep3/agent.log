{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat fpga/core_bench_si.sv formal/checks_si.cfg'", "aggregated_output": "// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[2322 of 5394 chars elided by tools/bench/transcript.py; sha256:4a819f6a2f574183]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/CORE_PHILOSOPHY.md cores/bench/test/test_alu.py cores/bench/test/test_core_div.py'", "aggregated_output": "\"\"\"Combinational RV32I and multiply tests; division lives in test_div_unit.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n    `await _setup(dut)` for parity with other test files.\"\"\"\n    return\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)              # -1 < 0\n    await _check(dut, ALU_SLT, 1, 0, 0)\n    await _check(dut, ALU_SLT, 0x7FFFFFFF, 0x80000000, 0)     # MAX > MIN\n\n\n@cocotb.test()\nasync def sltu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n    await _check(dut, ALU_SLTU, 0, 1, 1)\n\n\n@cocotb.test()\nasync def sll(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLL, 1, 4, 16)\n    awa\n…[19205 of 22277 chars elided by tools/bench/transcript.py; sha256:37693e1ea4c914da]…\n       assert gaps == [10, 9, 9, 10], gaps\n    events = []\n    await run(dut, program, {80: 123}, stalls=True, long_stall=80, events=events)\n    held = [e for e in events if e[\"ex_pc\"] == 16 and e[\"ex_valid\"] and e[\"stall_ex_mem\"]]\n    assert len(held) >= 10\n    assert not any(e[\"train\"] or e[\"redirect\"] for e in held)\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_core_div_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"core_div_alt\" if alt else \"core_div\")\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\")\n    runner.build(sources=sources, hdl_toplevel=\"core\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_core_div\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n", "exit_code": 0, "status": "completed"}}
