{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport subprocess\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nroot = Path.cwd()\nstage = root / 'cores/bench/generated/baseline'\nrtl = stage / 'rtl'\nrtl.mkdir(parents=True, exist_ok=True)\nfor source in (root / 'cores/bench/rtl').glob('*.sv'):\n    data = subprocess.check_output(['git', 'show', 'HEAD:cores/bench/rtl/' + source.name])\n    (rtl / source.name).write_bytes(data)\nenv = os.environ.copy()\nenv.update(RTL_DIR=str(rtl), OBJ_DIR=str(stage / 'obj_dir'), NRET='1')\nwith (stage / 'build.log').open('w') as log:\n    subprocess.run(['bash', 'test/cosim/build.sh'], env=env, stdout=log, stderr=subprocess.STDOUT, check=True)\nprint('Baseline cosim binary built', flush=True)\nfrom tools.eval.fpga import validate_coremark_uart\nimport json\nbaseline = stage / 'obj_dir/cosim_sim'\ncandidate = root / 'cores/bench/obj_dir/cosim_sim'\nfor seed in (0xDEADBEEF, 1):\n    flags = ['--istall', '--dstall', '--seed', str(seed)]\n    for program in ('selftest', 'coremark'):\n        elf = root / ('bench/programs/' + program + '.elf')\n        args = [str(elf), '50000000', *flags]\n        if program == 'coremark':\n            args.append('--bench')\n        def run(binary):\n            return subprocess.run([str(binary), *args], capture_output=True, text=True, check=True).stdout\n        with ThreadPoolExecutor(max_workers=2) as pool:\n            outputs = list(pool.map(run, (baseline, candidate)))\n        assert outputs[0] == outputs[1], (program, seed, 'baseline/candidate output mismatch')\n        marker = json.loads(outputs[1].splitlines()[-1])\n        assert marker['ebreak'] and not marker['oob']\n        if program == 'coremark':\n            assert marker['bench_bracketed']\n            ok, reason = validate_coremark_uart(marker['uart'], 10)\n            assert ok, reason\n            assert 'Correct operation validated.' in marker['uart']\n            cycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\n            if seed == 0xDEADBEEF:\n                assert cycles == 4095164\n            print(json.dumps({'program': program, 'seed': seed, 'baseline_identical': True, 'marker_cycles': cycles, 'uart_crc': 'passed', 'bounds': 'passed'}), flush=True)\n        else:\n            print(json.dumps({'program': program, 'seed': seed, 'rvfi_trace_identical': True, 'bounds': 'passed'}), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
