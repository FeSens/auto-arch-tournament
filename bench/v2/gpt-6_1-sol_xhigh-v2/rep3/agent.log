{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/hypgen_scratch')\nsrc=Path('cores/bench/rtl')\nold='''    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 \"'!= rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'\"'b0;\n    endcase'''\nnew='''    branch_equal = ~|(rs1 \"'^ rs2);\n    branch_unsigned_lt = rs1 < rs2;\n    branch_signed_lt = (rs1[31] ''^ rs2[31]) ? rs1[31] : branch_unsigned_lt;\n    branch_relation = in.ctrl.branch_op[2]\n                      ? (in.ctrl.branch_op[1] ? branch_unsigned_lt : branch_signed_lt)\n                      : branch_equal;\n    branch_cond = (in.ctrl.branch_op[2] || !in.ctrl.branch_op[1])\n                  && (branch_relation ''^ in.ctrl.branch_op[0]);'\"'''\nnew_sign='''    branch_equal = ~|(rs1 \"'^ rs2);\n    branch_low_lt = rs1[30:0] < rs2[30:0];\n    branch_less = (rs1[31] ''^ rs2[31])\n                  ? (rs1[31] ''^ !in.ctrl.branch_op[1]) : branch_low_lt;\n    branch_relation = in.ctrl.branch_op[2] ? branch_less : branch_equal;\n    branch_cond = (in.ctrl.branch_op[2] || !in.ctrl.branch_op[1])\n                  && (branch_relation ''^ in.ctrl.branch_op[0]);'\"'''\nfor name,body,signals in [\n ('compact',new,'  logic branch_equal, branch_unsigned_lt, branch_signed_lt, branch_relation;\\\\n'),\n ('signfirst',new_sign,'  logic branch_equal, branch_low_lt, branch_less, branch_relation;\\\\n')]:\n rtl=root/name/'rtl'\n shutil.copytree(src,rtl,dirs_exist_ok=True)\n p=rtl/'ex_stage.sv'\n s=p.read_text()\n assert s.count(old)==1\n s=s.replace(old,body).replace('  logic        branch_cond;','  logic        branch_cond;\\\\n'+signals)\n p.w