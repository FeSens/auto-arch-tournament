{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nfor hi in range(4096):\n for sign in (0,1):\n  for carry in (0,1):\n   old = ((hi-sign+carry)&4095)==0\n   new = (hi==0 and carry==sign) or (hi==1 and sign and not carry) or (hi==4095 and not sign and carry)\n   assert bool(old)==bool(new),(hi,sign,carry)\nrng=random.Random(0x93)\nfor _ in range(500000):\n pc=rng.randrange(1<<32)\n imm=rng.randrange(-(1<<20),1<<20)*2\n # JAL range is signed 21 bits, bit zero is implicit zero.\n imm=((imm+(1<<20))%(1<<21))-(1<<20)\n old_target=(pc+imm)&0xffffffff\n lo= (pc&0xfffff)+(imm&0xfffff)\n hi=pc>>20; sign=int(imm<0); carry=lo>>20\n pred=(hi==0 and carry==sign) or (hi==1 and sign and not carry) or (hi==4095 and not sign and carry)\n assert bool(pred)==(old_target<0x100000)\n if pred: assert (lo&0xfffff)==old_target\nprint('Exact high-PC predicate: all 16384 cases pass; 500000 randomized target calculations pass.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
