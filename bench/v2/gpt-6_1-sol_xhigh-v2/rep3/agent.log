= line.lstrip(\"[\").rstrip(\"]\")\n            cfgsubsection = None\n            if cfgsection.startswith(\"assume \") or cfgsection == \"assume\":\n                cfgsubsection = cfgsection.split()[1:]\n                cfgsection = \"assume\"\n            continue\n\n        if cfgsection is not None:\n            if cfgsubsection is None:\n                if cfgsection not in config:\n                    config[cfgsection] = \"\"\n                config[cfgsection] += f\"{line}\\n\"\n            else:\n                if cfgsection not in config:\n                    config[cfgsection] = []\n                config[cfgsection].append((cfgsubsection, line))\n\nif \"options\" in config:\n    for line in config[\"options\"].split(\"\\n\"):\n        line = line.split()\n\n        if len(line) == 0:\n            continue\n\n        elif line[0] == \"nret\":\n            assert len(line) == 2\n            nret = int(line[1])\n\n        elif line[0] == \"isa\":\n38:basedir = f\"{os.getcwd()}/../..\"\n271:hargs[\"basedir\"] = basedir\n427:                : @basedir@/checks/rvfi_macros.vh\n428:                : @basedir@/checks/rvfi_channel.sv\n429:                : @basedir@/checks/rvfi_testbench.sv\n434:                    : @basedir@/checks/rvfi_csr_ill_check.sv\n438:                    : @basedir@/checks/rvfi_csrw_check.sv\n442:                    : @basedir@/checks/rvfi_insn_check.sv\n443:                    : @basedir@/insns/insn_@insn@.v\n550:        with open(f\"../../insns/isa_{isa}.txt\", \"r\") as isa_file:\n702:                : @basedir@/checks/rvfi_macros.vh\n703:                : @basedir@/checks/rvfi_channel.sv\n704:                : @basedir@/checks/rvfi_testbench.sv\n705:                : @basedir@/checks/rvfi_@check@_check.sv\n","exit_code":0,"status":"completed"}}
