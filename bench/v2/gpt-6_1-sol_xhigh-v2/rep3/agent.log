{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nm=json.loads(Path('cores/bench/sim_build/if_structure.json').read_text())['modules']['if_stage']\nnames={b:n for n,v in m['netnames'].items() if not n.startswith('\"'$'\"') for b in v['bits'] if isinstance(b,int)}\ndrivers={b:(n,c) for n,c in m['cells'].items() for p,d in c['port_directions'].items() if d=='output' for b in c['connections'][p] if isinstance(b,int)}\ndef cone(bits,seen=None):\n    seen=set() if seen is None else seen\n    inputs=set()\n    for b in bits:\n        if not isinstance(b,int) or b in seen: continue\n        seen.add(b)\n        if b not in drivers:\n            inputs.add(names.get(b,str(b))); continue\n        n,c=drivers[b]\n        if 'dff' in c['type']:\n            inputs.add(names.get(b,str(b))); continue\n        for p,d in c['port_directions'].items():\n            if d=='input': inputs |= cone(c['connections'][p],seen)\n    return inputs\nfor name in ('cursor_q','recovery_target_q','recovery_pending_q','train_valid_q','train_taken_q','train_index_q'):\n    bits=m['netnames'][name]['bits']\n    cells={drivers[b][0] for b in bits if b in drivers}\n    print(name,len(bits),'bits',m['netnames'][name]['attributes'])\n    for n in sorted(cells):\n        c=m['cells'][n]\n        print(' ',c['type'],{p:sorted(cone(c['connections'][p])) for p in ('D','EN','SRST') if p in c['connections']})\nprint('imem selector',[(c['type'], {p: sorted({names.get(b,str(b)) for b in bs}) for p,bs in c['connections'].items()}) for c in m['cells'].values() if c['connections'].get('Y')==m['ports']['imem_addr']['bits']])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
