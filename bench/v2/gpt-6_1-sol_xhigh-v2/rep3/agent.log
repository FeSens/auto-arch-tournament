{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/seed_probe')\n(root/'rtl').mkdir(parents=True,exist_ok=True)\n(root/'test').mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,root/'rtl'/p.name)\nfor p in Path('cores/bench/test').glob('*.py'):shutil.copy2(p,root/'test'/p.name)\np=root/'rtl/div_unit.sv'\ns=p.read_text().replace('  logic [4:0] seed_shifted, seed_trial;','  logic [3:0] seed_numerator, seed_divisor;\\\\n  logic [7:0] seed_pair;\\\\n  logic seed_small;')\nstart=s.index('  // The launch numerator')\nend=s.index('  always_comb begin\\\\n    quotient_next',start)\ntable='''  assign seed_numerator = (signed_op && a[31])\n      ? (~a[31:28] + {3'b0, (a[27:0] == 28'b0)}) : a[31:28];\n  assign seed_small = (signed_op && b[31])\n      ? (b[31:4] == 28'hfffffff && b[3:0] \"'!= 4'\"'b0)\n      : (b[31:4] == 28'b0);\n  assign seed_divisor = (signed_op && b[31]) ? (4'b0-b[3:0]) : b[3:0];\n  always_comb begin\n    case ({seed_divisor,seed_numerator})\n'''\nfor d in range(16):\n for n in range(16):\n  q,r=divmod(n,d) if d else (15,n)\n  table+=f\\\"      8'h{d*16+n:02x}: seed_pair = 8'h{q*16+r:02x};\\\\n\\\"\ntable+='''      default: seed_pair = 8'b0;\n    endcase\n  end\n  assign seed_quotient = seed_small ? seed_pair[7:4] : 4'b0;\n  assign seed_remainder = seed_small ? seed_pair[3:0] : seed_numerator;\n'''\np.write_text(s[:start]+table+s[end:])\nprint('Created isolated divider-seed prototype in',root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
