{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/generated/repartition_five_probe/test_core_div_trial.py')\ns = Path('cores/bench/test/test_core_div.py').read_text()\nold = '''        if long_stall is not None and not dready and int(dut.u_ex.u_div.done.value):'''\nnew = '''        # Each accepted divider request owns a distinct completion interval.\n        # Preserve stability assertions throughout that interval; stop\n        # comparing against a different instruction after completion leaves DONE.\n        if not int(dut.u_ex.u_div.done.value):\n            done_result = None\n        if long_stall is not None and not dready and int(dut.u_ex.u_div.done.value):'''\nassert old in s\ns = s.replace(old, new)\ns += '''\\\\n\\\\n@cocotb.test()\nasync def taken_transfers_before_division(dut):\n    # Forward BEQ, JAL, and JALR jump to the division at PC 24.\n    # No instruction/data stalls: this checks the formal ten-clock deadline.\n    for transfer in (0x00000663, 0x00c0006f, 0x00048067):\n        program = [addi(1, 0, -100), addi(2, 0, 7), addi(9, 0, 24),\n                   transfer, sw(1, 64), addi(3, 0, 123),\n                   m_op(ALU_DIV, 3, 1, 2), EBREAK]\n        dut.reset.value = 1\n        dut.io_imemReady.value = 1\n        dut.io_dmemReady.value = 1\n        dut.io_imemData.value = 0\n        dut.io_dmemRData.value = 0\n        for _ in range(3):\n            await edge(dut)\n        dut.reset.value = 0\n        expected_pcs = [0, 4, 8, 12, 24, 28]\n        index = 0\n        previous = None\n        for cycle in range(100):\n            dut.clock.value = 0\n            await Timer(1, 'ns')\n            pc = int(dut.io_imemAddr.value)\n            dut.io_imemData.value = program[pc // 4] if pc // 4 < len(program) else EBREAK\n            await Timer(1, 'ns')\n            assert int(dut.io_dmemWEn.value) == 0, 'wrong-path store escaped'\n            if int(dut.io_rvfi_valid_0.value):\n                got_pc = int(dut.io_rvfi_pc_rdata_0.value)\n                assert got_pc == expected_pcs[index]\n                assert int(dut.io_rvfi_order_0.value) == index\n                assert int(dut.io_rvfi_trap_0.value) == 0\n                if got_pc == 12:\n                    previous = cycle\n                    assert int(dut.io_rvfi_pc_wdata_0.value) == 24\n                if got_pc == 24:\n                    gap = cycle - previous\n                    dut._log.info('Transfer %08x -> DIV retirement gap: %d', transfer, gap)\n                    assert gap <= 10\n                    assert int(dut.io_rvfi_rd_addr_0.value) == 3\n                    alt = os.environ.get('DIV_ALTOPS') == '1'\n                    assert int(dut.io_rvfi_rd_wdata_0.value) == expected(ALU_DIV, -100 & MASK, 7, alt)\n                index += 1\n                if got_pc == 28:\n                    assert index == len(expected_pcs)\n                    break\n            dut.clock.value = 1\n            await Timer(5, 'ns')\n        else:\n            raise AssertionError('transfer/division stream did not complete')\n'''\np.write_text(s)\nprint('Scratch tests now check per-request completion stability and all three taken transfer classes.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
