{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'cat /srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep3/formal/riscv-formal/checks/rvfi_liveness_check.sv'","aggregated_output":"// Copyright (C) 2017  Claire Xenia Wolf <claire@yosyshq.com>\n//\n// Permission to use, copy, modify, and/or distribute this software for any\n// purpose with or without fee is hereby granted, provided that the above\n// copyright notice and this permission notice appear in all copies.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\" AND THE AUTHOR DISCLAIMS ALL WARRANTIES\n// WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF\n// MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR\n// ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n// WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN\n// ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\nmodule rvfi_liveness_check (\n\tinput clock, reset, trig, check,\n\t`RVFI_INPUTS\n);\n\t`rvformal_rand_const_reg [63:0] insn_order;\n\treg found_next_insn = 0;\n\n\tinteger channel_idx;\n\talways @(posedge clock) begin\n\t\tif (reset) begin\n\t\t\tfound_next_insn = 0;\n\t\tend else begin\n\t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,190p' fpga/core_bench_si.sv\"", "aggregated_output": "// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic is part of the\n  // timed netlist (fpga/bench_stall_gen.sv).\n  logic imem_ready, dmem_ready;\n  bench_stall_gen stall_gen (\n    .clock      (clock),\n    .reset      (reset),\n    .imem_ready (imem_ready),\n    .dmem_ready (dmem_ready)\n  );\n\n  core cpu (\n    .clock            (clock),\n    .reset            (reset),\n    .io_imemAddr      (imem_addr),\n    .io_imemData      (lfsr),\n    .io_imemReady     (imem_ready),\n    .io_dmemAddr      (dmem_addr),\n    .io_dmemWData     (dmem_wdata),\n    .io_dmemRData     (dmem_rdata),\n    .io_dmemWEn       (dmem_wen),\n    .io_dmemREn       (dmem_ren),\n    .io_dmemReady     (dmem_ready),\n    .io_rvfi_valid_0    (rvfi_valid_0),\n    .io_rvfi_order_0    (rvfi_order_0),\n    .io_rvfi_insn_0     (rvfi_insn_0),\n    .io_rvfi_trap_0     (rvfi_trap_0),\n    .io_rvfi_halt_0     (rvfi_halt_0),\n    .io_rvfi_intr_0     (rvfi_intr_0),\n    .io_rvfi_mode_0     (rvfi_mode_0),\n    .io_rvfi_ixl_0      (rvfi_ixl_0),\n    .io_rvfi_rs1_addr_0 (rvfi_rs1_addr_0),\n    .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata_0),\n    .io_rvfi_rs2_addr_0 (rvfi_rs2_addr_0),\n    .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata_0),\n    .io_rvfi_rd_addr_0  (rvfi_rd_addr_0),\n    .io_rvfi_rd_wdata_0 (rvfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // V2: observe only the memory-side outputs. Everything the core computes\n  // reaches the fetch address or a store, so the datapath stays in the\n  // netlist; logic that only drives RVFI (a verification port a deployed\n  // core would not have) is pruned and does not count toward Fmax or area.\n  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/experiments/hypotheses/hyp-20261001-003-r7s2.yaml'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/experiments/hypotheses/hyp-20261001-003-r7s2.yaml'", "aggregated_output": "id: hyp-20261001-003-r7s2\ntitle: \"Split normal and recovery fetch-address registers\"\ncategory: predictor\nmotivation: |\n  The champion scores 146.62 at median Fmax 64.191 MHz and 4378154\n  CoreMark marker cycles. Its reported worst Gowin path now ends at\n  u_if/pc after register-file, ID and EX logic: 21.444 ns and 37 cells.\n  Predictor accuracy is already high: prior profiling found only 41558\n  conditional direction errors and 13735 JALRs in the timed trace.\n  Eliminating all of them would save only about 1.3 percent of cycles.\n  Larger tables, carried direct successors, LUT-RAM initialization and\n  banked counter feedback have not produced an accepted gain. The new\n  opportunity is to remove recovery arbitration from the target's\n  register input now that EX-to-fetch feedback limits timing.\nhypothesis: |\n  Split the fetch address into a normal-PC register and an independently\n  captured recovery-target register, selected AFTER their clocked\n  boundaries by a registered recovery bit. Preserve the current BHT,\n  direct JAL prediction and one-bit EX mismatch detection. This is one\n  predictor recovery-topology change, with identical accepted fetches\n  and no additional recovery cycle or pipeline stage.\n\n  In IF, capture the existing full-width EX redirect_target into a\n  dedicated register on every non-reset edge, unconditionally and with\n  no redirect, frontend-stall, memory-stall or M-hold data enable.\n  Capture redirect into a one-bit recovery selector on every edge;\n  reset it to zero. Preserve both register boundaries against synthesis\n  absorption/retiming using Gowin-compatible register attributes. Their\n  D cones must end at the existing EX target and mismatch computations,\n  before the current normal/predicted/redirect/hold arbitration.\n\n  Define the effective fetch PC as recovery_select_q ? recovery_target_q\n  : normal_pc_q. Drive imem_addr and out.pc from this effective PC, and\n  use it consistently for the folded BHT lookup, direct target adder\n  and sequential successor. Existing EX redirect still imm\n…[3920 of 6992 chars elided by tools/bench/transcript.py; sha256:a819a21c6447aedd]…\niginal single-PC recurrence. Check exact public address,\n      raw payload, prediction and validity equivalence across redirects,\n      simultaneous stalls, stalled recovery-target fetches, repeated\n      stalls, consecutive redirects and reset during selected recovery.\n  - file: test/test_pipeline.py\n    description: |\n      Preserve existing pipeline and RVFI assertions. Exercise corrected\n      branches/JALRs with instruction-memory stalls on detection and on\n      the first target cycle, wrong-path stores and M payloads, and\n      back-to-back transfers. Assert no added correction bubble, precise\n      target PC, exact-once training/retirement and suppressed side effects.\n  - file: test/test_core_div.py\n    description: |\n      Keep every existing ten-clock retirement and branch-to-DIV/REM\n      bound unchanged. Add recovery-target fetch stalls before real and\n      ALTOPS M operations and reset during the selected recovery cycle;\n      verify no wrong-path launch, lost target or repeated memory request.\n", "exit_code": 0, "status": "completed"}}
