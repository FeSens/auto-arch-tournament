{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"mkdir -p cores/bench/generated/microopt_probe\npython3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl')\ndst=Path('cores/bench/generated/microopt_probe/rtl')\ndst.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'): shutil.copyfile(p,dst/p.name)\np=dst/'forward_unit.sv'\ns=p.read_text().replace('output logic [1:0] fwd_rs1','output logic [2:0] fwd_rs1').replace('output logic [1:0] fwd_rs2','output logic [2:0] fwd_rs2')\npos=s.index('  // Yosys')\ns=s[:pos]+'''  logic ex1, ex2, wb1, wb2;\n  assign ex1 = ex_mem_w_en && ex_mem_rd \"'!= 5'\"'b0 && ex_mem_rd == id_ex_rs1;\n  assign ex2 = ex_mem_w_en && ex_mem_rd \"'!= 5'\"'b0 && ex_mem_rd == id_ex_rs2;\n  assign wb1 = mem_wb_w_en && mem_wb_rd \"'!= 5'\"'b0 && mem_wb_rd == id_ex_rs1;\n  assign wb2 = mem_wb_w_en && mem_wb_rd \"'!= 5'\"'b0 && mem_wb_rd == id_ex_rs2;\n  assign fwd_rs1 = {(\"'!ex1 && wb1), ex1, (!ex1 && !wb1)};\n  assign fwd_rs2 = {(!ex2 && wb2), ex2, (!ex2 && !wb2)};\nendmodule\n'\"'''\np.write_text(s)\np=dst/'core.sv'\ns=p.read_text().replace('logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', 'logic [2:0] fwd_rs1_sel, fwd_rs2_sel;')\np.write_text(s)\np=dst/'ex_stage.sv'\ns=p.read_text().replace('logic [1:0]         fwd_rs1_sel','logic [2:0]         fwd_rs1_sel').replace('logic [1:0]         fwd_rs2_sel','logic [2:0]         fwd_rs2_sel')\nstart=s.index('  always_comb begin')\nend=s.index('  logic [31:0] alu_result;',start)\ns=s[:start]+'''  assign rs1 = ({32{fwd_rs1_sel[0]}} & in.rs1_val)\n             | ({32{fwd_rs1_sel[1]}} & fwd_ex_mem)\n             | ({32{fwd_rs1_sel[2]}} & fwd_mem_wb);\n  assign rs2 = ({32{fwd_rs2_sel[0]}} & in.rs2_val)\n             | ({32{fwd_rs2_sel[1]}} & fwd_ex_mem)\n             | ({32{fwd_rs2_sel[2]}} & fwd_mem_wb);\n  logic [31:0] alu_a, alu_b;\n  logic [3:0] ena, enb;\n  assign ena = {in.ctrl.is_auipc, ({3{\"'!in.ctrl.is_auipc}} & fwd_rs1_sel)};\n  as