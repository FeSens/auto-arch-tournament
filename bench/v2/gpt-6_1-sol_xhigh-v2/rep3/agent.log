{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"mkdir -p cores/bench/generated/hypgen; python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/hypgen/profile.py')\np.write_text('''import sys, struct, json\nfrom collections import Counter\nsys.path.insert(0, str(Path(__file__).resolve().parents[4] / 'test/cosim'))\nfrom reference import RV32IM\ncpu=RV32IM(); cpu.load_elf('bench/programs/coremark.elf')\nactive=False; counts=Counter(); jalr_sites=Counter(); tables={n:{} for n in (16,32,64,128,256)}; hits=Counter(); returns=0; ras_hits=0; ras=[]\nwith open('cores/bench/generated/hypgen/trace.bin','wb') as trace:\n for i in range(15000000):\n  r=cpu.step()\n  if r is None: break\n  if r['mem_wmask'] and r['mem_addr']==0x10000100:\n   active=True\n  if active:\n   pc,insn,npc=r['pc'],r['insn'],r['npc']; op=insn&127\n   trace.write(struct.pack('<III',pc,insn,npc)); counts[op]+=1\n   if op==0x67:\n    jalr_sites[pc]+=1\n    for n,t in tables.items():\n     bits=n.bit_length()-1; idx=((pc>>2)\"'^(pc>>(bits+2)))&(n-1)\n     if t.get(idx)==(pc,npc): hits[n]+=1\n     t[idx]=(pc,npc)\n    rs=(insn>>15)&31; rd=(insn>>7)&31\n    if rs in (1,5) and rd not in (1,5):\n     returns+=1\n     if ras and ras[-1]==npc: ras_hits+=1\n     if ras: ras.pop()\n   if op in (0x6f,0x67) and (insn>>7)&31 in (1,5): ras.append((pc+4)&0xffffffff)\n  if r['\"'mem_wmask'] and r['mem_addr']==0x10000104: break\nprint(json.dumps({'executed':i+1,'counts':dict(counts),'jalr_sites':dict(jalr_sites),'target_hits':dict(hits),'returns':returns,'ras_hits':ras_hits,'oob':cpu.oob_access},indent=2))\n'''.replace('import sys, struct, json','import sys, struct, json\\\\nfrom pathlib import Path'))\nPY\npython3 cores/bench/generated/hypgen/profile.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
