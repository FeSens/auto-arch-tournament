{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,240p' cores/bench/rtl/div_unit.sv\"", "aggregated_output": "// Seed four quotient bits on launch, then perform seven registered groups\n// of four restoring quotient bits. DONE freezes the raw result and\n// metadata; sign/exception correction feeds the EX/MEM acceptance edge.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n  localparam logic [1:0] IDLE = 2'd0, LOOP = 2'd1, DONE = 2'd2;\n  logic [1:0] state_q;\n  logic [2:0] iteration_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n  assign result = alt_result_q;\n`else\n  logic [4:0] op_q;\n  logic [31:0] a_q, divisor_q, remainder_q;\n  logic [31:0] quotient_q, quotient_next;\n  logic [31:0] remainder_next, magnitude_b;\n  // Only the lower 28 magnitude bits are captured; the seed uses raw a.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] magnitude_a;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [32:0] shifted, trial;\n  logic quotient_negative_q, remainder_negative_q;\n  logic zero_q, overflow_q, signed_op;\n  logic neg_a, neg_b, seed_small_divisor;\n  logic [3:0] seed_numerator, seed_divisor;\n  logic [3:0] seed_quotient, seed_remainder;\n  logic [4:0] seed_trial;\n  logic [7:0] seed_decode, seed_boolean;\n  logic [7:0] seed_terms [0:7];\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign neg_a = signed_op && a[31];\n  assign neg_b = signed_op && b[31];\n  assign magnitude_a = neg_a ? -a : a;\n  assign magnitude_b = neg_b ? -b : b;\n\n  // The upper magnitude nibble depends only on the raw upper nibble\n  // and whether negation carries out of the lower 28 bits.\n  assign seed_numerator = neg_a\n                          ? (~a[31:28] + {3'b0, !(|a[27:0])})\n                          : a[31:28];\n  // Exactly raw -1 through -15 qualify on the negative signed path.\n  // In particular, -16 must not alias the zero-divisor seed.\n  assign seed_small_divisor = neg_b\n      \n…[4308 of 7380 chars elided by tools/bench/transcript.py; sha256:4f6f7a540d14964e]…\nesult_q <= (a - b) ^ 32'h8da68fa5;\n            ALU_REMU: alt_result_q <= (a - b) ^ 32'h3138d0e1;\n            default:  alt_result_q <= 32'b0;\n          endcase\n`else\n          op_q <= op;\n          a_q <= a;\n          quotient_q <= {magnitude_a[27:0], seed_quotient};\n          divisor_q <= magnitude_b;\n          remainder_q <= {28'b0, seed_remainder};\n          quotient_negative_q <= signed_op && (a[31] ^ b[31]);\n          remainder_negative_q <= signed_op && a[31];\n          zero_q <= (b == 32'b0);\n          overflow_q <= signed_op && (a == 32'h80000000)\n                                 && (b == 32'hffffffff);\n`endif\n          state_q <= LOOP;\n        end\n        LOOP: begin\n`ifndef RISCV_FORMAL_ALTOPS\n          quotient_q <= quotient_next;\n          remainder_q <= remainder_next;\n`endif\n          iteration_q <= iteration_q + 3'd1;\n          if (iteration_q == 3'd6) state_q <= DONE;\n        end\n        DONE: if (accept) state_q <= IDLE;\n        default: state_q <= IDLE;\n      endcase\n    end\n  end\nendmodule\n", "exit_code": 0, "status": "completed"}}
