{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/div_unit.sv\nsed -n '1,120p' tools/eval/cosim.py\nsed -n '1,90p' tools/eval/gowin.py\nrg -n 'AGENTS|implementation_notes|generated|formal/last|elf|sim_build' .gitignore\"", "aggregated_output": "// Capture operand magnitudes on start && !busy, then perform seven\n// registered groups of five restoring quotient bits. The three leading\n// dividend zeros make all groups uniform. DONE freezes the raw result and\n// metadata; sign/exception correction feeds the EX/MEM acceptance edge.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n  localparam logic [1:0] IDLE = 2'd0, LOOP = 2'd1, DONE = 2'd2;\n  logic [1:0] state_q;\n  logic [2:0] iteration_q;\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result_q;\n  assign result = alt_result_q;\n`else\n  logic [4:0] op_q;\n  logic [31:0] a_q, divisor_q, remainder_q;\n  logic [34:0] quotient_q, quotient_next;\n  logic [31:0] remainder_next, magnitude_a, magnitude_b;\n  logic [32:0] shifted, trial;\n  logic quotient_negative_q, remainder_negative_q;\n  logic zero_q, overflow_q, signed_op;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign magnitude_a = (signed_op && a[31]) ? -a : a;\n  assign magnitude_b = (signed_op && b[31]) ? -b : b;\n  always_comb begin\n    quotient_next = quotient_q;\n    remainder_next = remainder_q;\n    shifted = 33'b0;\n    trial = 33'b0;\n    // Exactly five serial subtract/select updates between registers.\n    for (int bit_step = 0; bit_step < 5; bit_step++) begin\n      shifted = {remainder_next, quotient_next[34]};\n      trial = shifted - {1'b0, divisor_q};\n      quotient_next = {quotient_next[33:0], !trial[32]};\n      remainder_next = trial[32] ? shifted[31:0] : trial[31:0];\n    end\n  end\n\n  // These sources remain frozen throughout DONE, including older memory\n  // stalls. Correction is outside the registered LOOP recurrence.\n  always_comb begin\n    if (op_q == ALU_REM || op_q == ALU_REMU) begin\n      if (zero_q) result = a_q;\n      else if (overflow_q) result = 32'b0;\n      else result = remainder_n\n…[10512 of 13584 chars elided by tools/bench/transcript.py; sha256:79c237a3a7105b34]…\n from Gowin's timing report.\"\"\"\n    # The headings also appear, indented, in the report's table of contents.\n    m = re.search(r\"^3\\.3\\.1 Setup Analysis Report\", tr_text, re.M)\n    if not m:\n        return []\n    sec = tr_text[m.end():]\n    h = re.search(r\"^3\\.3\\.2 Hold Analysis Report\", sec, re.M)\n    sec = sec[:h.start()] if h else sec\n    out = []\n    for block in re.split(r\"^\\s*Path\\d+\\s*$\", sec, flags=re.M)[1:n + 1]:\n        def field(name):\n            m = re.search(rf\"^{name}\\s*:\\s*(.+)$\", block, re.M)\n            return m.group(1).strip() if m else None\n        arrival = block.split(\"Data Arrival Path:\")[-1].split(\"Data Required Path:\")[0]\n17:# Formal run output (regenerated per run; surfaced via stdout to the orchestrator).\n23:formal/last_run*.log\n51:generated/\n52:sim_build/\n54:test/cosim/sim_build/\n55:test/**/sim_build/\n64:bench/programs/*.elf\n70:bench/holdout/build/*.elf\n78:#   the latest state is always viewable from GitHub. Regenerated and\n85:cores/*/generated/\n87:cores/*/implementation_notes.md\n", "exit_code": 0, "status": "completed"}}
