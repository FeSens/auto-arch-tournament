{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/bf842e9a/4e4902de/r6s1-rf')\np=base/'banked';shutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',p/'test',dirs_exist_ok=True)\n(p/'rtl/reg_file.sv').write_text('''module reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output logic [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  wire [31:0] read1_mask, read2_mask;\n  wire [31:0] masked1 [0:31], masked2 [0:31];\n  wire [31:0] group1 [0:7], group2 [0:7];\n  wire [31:0] half1 [0:1], half2 [0:1];\n  for (genvar r=0;r<32;r++) begin : g_word\n    assign read1_mask[r] = (rs1_addr == 5'(r));\n    assign read2_mask[r] = (rs2_addr == 5'(r));\n    if (r == 0) begin : g_zero\n      assign masked1[r] = 32'b0;\n      assign masked2[r] = 32'b0;\n    end else begin : g_data\n      (* syn_preserve=1, syn_keep=1 *) logic [31:0] word_q;\n      always_ff @(posedge clock) begin\n        if (reset) word_q <= 32'b0;\n        else if (w_en && w_addr == 5'(r)) word_q <= w_data;\n      end\n      assign masked1[r] = word_q & {32{read1_mask[r]}};\n      assign masked2[r] = word_q & {32{read2_mask[r]}};\n    end\n  end\n  for (genvar g=0;g<8;g++) begin : g_group\n    assign group1[g] = (masked1[4*g] | masked1[4*g+1]) | (masked1[4*g+2] | masked1[4*g+3]);\n    assign group2[g] = (masked2[4*g] | masked2[4*g+1]) | (masked2[4*g+2] | masked2[4*g+3]);\n  end\n  for (genvar h=0;h<2;h++) begin : g_half\n    assign half1[h] = (group1[4*h] | group1[4*h+1]) | (group1[4*h+2] | group1[4*h+3]);\n    assign half2[h] = (group2[4*h] | group2[4*h+1]) | (group2[4*h+2] | group2[4*h+3]);\n  end\n  always_comb begin\n    if (rs1_addr == 0) rs1_data = 0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = half1[0] | half1[1];\n    if (rs2_addr == 0) rs2_data = 0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = half2[0] | half2[1];\n  end\nendmodule\n''')\nprint('Created banked flop RF prototype')\nPY\nPYTHONPATH=\\\"\"'$PWD\" python /srv/hwebench/tmp/bf842e9a/4e4902de/r6s1-rf/timing.py banked'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
