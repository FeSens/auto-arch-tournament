t_q[31:27]};\n  for (genvar k = 1; k <= 31; k++) begin : g_radix32_trial\n    assign trial[k] = {1'b0, numerator} - {1'b0, divisor_multiple_q[k]};\n    assign fit[k] = \"'!trial[k][37];\n  end\n  assign select_digit[0] = !fit[1];\n  for (genvar k = 1; k < 31; k++) begin : g_radix32_select\n    assign select_digit[k] = fit[k] && !fit[k+1];\n  end\n  assign select_digit[31] = fit[31];\n  assign residual_tree[32] = {32{select_digit[0]}} & numerator[31:0];\n  for (genvar k = 1; k <= 31; k++) begin : g_radix32_mask\n    assign residual_tree[32+k] = {32{select_digit[k]}} & trial[k][31:0];\n  end\n  for (genvar k = 1; k < 32; k++) begin : g_residual_reduce\n    assign residual_tree[k] = residual_tree[k*2] | residual_tree[k*2+1];\n  end\n'\"'''\nfor bit in range(5):\n mask=sum(1<<k for k in range(32) if k&(1<<bit))\n loop+=f\\\"  assign digit[{bit}] = |(select_digit & 32'h{mask:08x});\\\\n\\\"\nloop+=\\\"  assign quotient_next = {quotient_q[26:0], digit};\\\\n  assign remainder_next = residual_tree[1];\\\\n\\\\n\\\"\ns=s[:a]+loop+s[b:]\ns=s.replace(\\\"for (int k = 1; k <= 7; k++) divisor_multiple_q[k] <= 35'b0;\\\",\\\"for (int k = 1; k <= 31; k++) divisor_multiple_q[k] <= 37'b0;\\\")\na=s.index('          divisor_multiple_q[1] <=');b=s.index('          quotient_negative_q <=',a)\ns=s[:a]+'          for (int k = 1; k <= 31; k++) divisor_multiple_q[k] <= multiple_d[k];\\\\n'+s[b:]\n(scratch/'rtl/div_unit.sv').write_text(s)\nprint(scratch)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
