ry is not None)\n    push = ready and len(ref.fifo) < 2\n    assert int(dut.physical_accept.value) == push\n    assert int(dut.queue_pop.value) == int((bool(ref.fifo) or ready) and not hold)\n    cursor, saved_target = int(dut.cursor_q.value), int(dut.recovery_target_q.value)\n    pending = ref.pending\n    \n…[3223 of 6295 chars elided by tools/bench/transcript.py; sha256:b0c96d1fe5d7c758]…\n                            JAL(0, -4), 0xFFFFFFFF))\n        await fetch_tick(dut, ref, instr, ready=ready, hold=hold,\n                         recovery=recovery, flush=recovery is not None,\n                         training=(rng.randrange(0x4000), rng.randrange(2))\n                         if rng.random() < 0.2 else None)\n        held = ref.fifo[0] if hold and ref.fifo and recovery is None else None\n    while ref.fifo or ref.pending:\n        await fetch_tick(dut, ref, ready=False if ref.fifo else True)\n    assert ref.accepted == ref.popped + ref.discarded\n\n\ndef test_fetch_queue_runner():\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / \"fetch_queue\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"if_stage.sv\"],\n                 hdl_toplevel=\"if_stage\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"if_stage\", test_module=\"test_fetch_queue\",\n                test_dir=TEST_DIR, build_dir=build)\n", "exit_code": 0, "status": "completed"}}
