{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"find .. -name AGENTS.md -print; sed -n '1,240p' cores/bench/test/test_if_predictor.py; sed -n '1,220p' Makefile\"", "aggregated_output": "\"\"\"Raw predecode, old-value counter lookup and fetch acceptance controls.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b, _prediction\n\n\nasync def edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n    dut.imem_data.value = NOP()\n    for _ in range(3):\n        await edge(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    return [1] * 64\n\n\nasync def at_pc(dut, pc):\n    # Recovery overrides both fetch stall and invalid fetch status.\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    dut.train_valid.value = 0\n    await edge(dut)\n    assert int(dut.imem_addr.value) == pc\n    dut.redirect.value = 0\n    dut.flush.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def check_fetch(dut, counters, pc, instr, *, stall=False, flush=False,\n                      training=None, recovery=None):\n    await at_pc(dut, pc)\n    dut.imem_data.value = instr\n    dut.stall.value = int(stall)\n    dut.flush.value = int(flush)\n    dut.redirect.value = int(recovery is not None)\n    if recovery is not None:\n        dut.redirect_target.value = recovery\n    dut.train_valid.value = int(training is not None)\n    if training is not None:\n        dut.train_pc.value, dut.train_taken.value = training\n    await Timer(1, \"ns\")\n    prediction, predicted_pc = _prediction(pc, instr, counters)\n    fetched = int(dut.out.value)\n    assert fetched >> 34 == pc\n    assert (fetched >> 2) & 0xFFFFFFFF == instr\n    assert (fetched >> 1) & 1 == int(prediction)\n    assert fetched & 1 == int(not flush and recovery is None)\n    await e\n…[10306 of 13378 chars elided by tools/bench/transcript.py; sha256:60ab7d7d005bf4d7]…\nree add \"$(WT_PATH)\" $(WT_BRANCH); \\\n\t  else \\\n\t    git worktree add -b $(WT_BRANCH) \"$(WT_PATH)\"; \\\n\t  fi; \\\n\t  [ -e \"$(WT_PATH)/formal/riscv-formal\" ] || ln -s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\n\tfi\n\t@$(MAKE) -C \"$(WT_PATH)\" loop \\\n\t  WORKTREE= \\\n\t  TARGET=$(TARGET) N=$(N) K=$(K) AGENT=$(AGENT) \\\n\t  $(if $(strip $(BASE)),BASE=$(BASE),) \\\n\t  $(if $(strip $(COREMARK)),COREMARK=$(COREMARK),) \\\n\t  $(if $(strip $(LUT)),LUT=$(LUT),)\nelse\n\tAGENT_PROVIDER=$(AGENT) python3 -m tools.orchestrator $(ORCH_FLAGS) $(ORCH_TARGET_FLAG)\nendif\n\nreport:\n\tpython3 -m tools.orchestrator --report $(ORCH_TARGET_FLAG)\n\nclean:\n\trm -rf test/cosim/sim_build sim_build out\n\trm -rf experiments/worktrees\n\trm -f bench/programs/*.elf\n\trm -f test/*.result.xml\n\tfind test -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\n\tfind tools -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\nifneq ($(strip $(TARGET)),)\n\trm -rf $(OBJ_DIR)\n\trm -rf $(GEN_DIR)\n\trm -rf cores/$(TARGET)/sim_build\nendif\n", "exit_code": 0, "status": "completed"}}
