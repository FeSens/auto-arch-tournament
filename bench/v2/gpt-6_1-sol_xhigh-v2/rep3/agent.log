{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('cores/bench/rtl'); out=Path('cores/bench/generated/hyp_alu/rtl'); out.mkdir(parents=True,exist_ok=True)\nfor p in base.glob('*.sv'): shutil.copy2(p,out/p.name)\np=out/'core_pkg.sv';s=p.read_text();s=s.replace('    // Decode-owned recovery lane;', '    logic [11:0] scalar_sel;\\\\n    // Decode-owned recovery lane;',1);p.write_text(s)\np=out/'id_stage.sv';s=p.read_text().replace('  typedef struct packed {\\\\n', '  typedef struct packed {\\\\n    logic [11:0] scalar_sel;\\\\n',1).replace('        reg_q.direct_target <= direct_target;', '''        for (int k = 0; k <= 10; k++)\n          reg_q.scalar_sel[k] <= \"'!dec_is_jump && dec_alu_op == 5'\"'(k);\n        reg_q.scalar_sel[11] <= dec_is_jump;\n        reg_q.direct_target <= direct_target;''',1).replace('    out.direct_target = reg_q.direct_target;','    out.scalar_sel = reg_q.scalar_sel;\\\\n    out.direct_target = reg_q.direct_target;',1);p.write_text(s)\np=out/'ex_stage.sv';s=p.read_text().replace('  alu u_alu (\\\\n    .op  (in.ctrl.alu_op),','  scalar_alu u_alu (\\\\n    .sel (in.scalar_sel),\\\\n    .link(in.sequential_pc),',1).replace('reg_q.alu_result    <= in.ctrl.is_jump ? in.sequential_pc : alu_result;','reg_q.alu_result    <= alu_result;',1);p.write_text(s)\np=out/'alu.sv';p.write_text('''\"'`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\nmodule alu (\n  input logic [4:0] op,\n  input logic [31:0] a,b,\n  output logic [31:0] out\n);\n  logic [11:0] sel;\n  for (genvar k=0; k<=10; k++) begin : g_sel\n    assign sel[k] = op == 5'\"'(k);\n  end\n  assign sel[11] = 1'b0;\n  scalar_alu u_scalar(.sel(sel), .a(a), .b(b), .link(32'b0), .out(out));\nendmodule\nmodule scalar_alu (\n  input logic [11:0] sel,\n  input logic [31:0] a,b,link,\n  output logic [31:0] out\n);\n  logic signed [32:0] right_input, right_shifted;\n  logic [31:0]