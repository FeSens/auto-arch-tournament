_next=quotient_q;\n    remainder_next=remainder_q;\n    shifted=0;trial1=0;trial2=0;trial3=0;digit=0;\n    sel0=0;sel1=0;sel2=0;sel3=0;\n    shifted_bit=0;trial_bit=0;\n    for (int step=0;step<2;step++) begin\n      shifted={remainder_next,quotient_next[31:30]};\n      trial1={1'b0,shifted}-{1'b0,d_q};\n      trial2={1'b0,shifted}-{1'b0,d2_q};\n      trial3={1'b0,shifted}-{1'b0,d3_q};\n      sel3=\"'!trial3[34];\n      sel2=trial3[34] && !trial2[34];\n      sel1=trial2[34] && !trial1[34];\n      sel0=trial1[34];\n      digit={sel2|sel3,sel1|sel3};\n      remainder_next=({32{sel0}}&shifted[31:0]) |\n                     ({32{sel1}}&trial1[31:0]) |\n                     ({32{sel2}}&trial2[31:0]) |\n                     ({32{sel3}}&trial3[31:0]);\n      quotient_next={quotient_next[29:0],digit};\n    end\n    if (iteration_q<4) begin\n      shifted_bit={remainder_next,quotient_next[31]};\n      trial_bit=shifted_bit-d_q[32:0];\n      quotient_next={quotient_next[30:0],!trial_bit[32]};\n      remainder_next=trial_bit[32] ? shifted_bit[31:0] : trial_bit[31:0];\n    end\n  end\n  always_comb begin\n    if (op_q==ALU_REM || op_q==ALU_REMU) begin\n      if (zero_q) result=raw_a_q;\n      else if (overflow_q) result=0;\n      else result=remainder_negative_q ? -remainder_q : remainder_q;\n    end else begin\n      if (zero_q) result=32'\"'hffffffff;\n      else if (overflow_q) result=32'h80000000;\n      else result=quotient_negative_q ? -quotient_q : quotient_q;\n    end\n  end\n\"'`endif\n  assign busy=state_q!=IDLE;\n  assign done=state_q==DONE;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q<=IDLE;iteration_q<=0;raw_a_q<=0;raw_b_q<=0;op_q<=0;\n`ifdef RISCV_FORMAL_ALTOPS\n      alt_result_q<=0;\n`else\n      quotient_q<=0;remainder_q<=0;d_q<=0;d2_q<=0;d3_q<=0;\n      quotient_negative_q<=0;remainder_negative_q<=0;zero_q<=0;overflow_q<=0;\n`endif\n    end else case (state_q)\n      IDLE: if (start) begin\n        raw_a_q<=a;raw_b_q<=b;op_q<=op;ite