{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/bf842e9a/1495d723')\nfor variant in ('r9_reverse','r9_fastsub'):\n root=base/variant;rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n p=rtl/'div_unit.sv';s=p.read_text()\n if variant=='r9_reverse':\n  s=s.replace('quotient_next, remainder_next, quotient_radix8','quotient_next, remainder_next, quotient_radix4')\n  s=s.replace('assign numerator8 = {remainder_q, quotient_q[31:29]};','assign numerator8 = {residual4[31:0], quotient_radix4[31:29]};')\n  s=s.replace('assign quotient_radix8 = {quotient_q[28:0], digit8};','assign quotient_radix4 = {quotient_q[29:0], digit4};')\n  s=s.replace(\\\"assign numerator4 = {1'b0, residual8[31:0], quotient_radix8[31:30]};\\\",\\\"assign numerator4 = {1'b0, remainder_q, quotient_q[31:30]};\\\")\n  s=s.replace('assign quotient_next = {quotient_radix8[29:0], digit4};','assign quotient_next = {quotient_radix4[28:0], digit8};')\n  s=s.replace('assign remainder_next = residual4[31:0];','assign remainder_next = residual8[31:0];')\n else:\n  prefix=[]\n  for i in range(1,6):\n   terms=[]\n   for j in range(i):terms.append('('+' & '.join([f'gen_b[{j}]']+[f'prop_b[{k}]' for k in range(j+1,i)])+')')\n   prefix.append(f'      borrow_b[{i}] = '+ ' | '.join(terms)+';')\n  fn='''  function automatic [35:0] fast_sub(input logic [35:0] lhs, rhs);\n    logic [5:0] gen_b, prop_b, borrow_b;\n    logic [5:0] d0 [0:5], d1 [0:5];\n    begin\n      for (int i=0;i<6;i++) begin\n        gen_b[i] = lhs[i*6+:6] < rhs[i*6+:6];\n        prop_b[i] = lhs[i*6+:6] == rhs[i*6+:6];\n        d0[i] = lhs[i*6+:6] - rhs[i*6+:6];\n        d1[i] = lhs[i*6+:6] + ~rhs[i*6+:6];\n      end\n      borrow_b[0] = 1'b0;\n'''+ '\\\\n'.join(prefix)+'''\n      for (int i=0;i<6;i++) fast_sub[i*6+:6] = borrow_b[i] ? d1[i] : d0[i];\n    end\n  endfunction\n\n'''\n  s=s.replace('  assign numerator8',fn+'  assign numerator8')\n  s=s.replace(\\\"{1'b0, numerator8} - {1'b0, divisor_multiple_q[k]}\\\",\\\"fast_sub({1'b0,numerator8}, {1'b0,divisor_multiple_q[k]})\\\")\n  s=s.replace(\\\"{1'b0, numerator4} - {1'b0, divisor_multiple_q[k]}\\\",\\\"fast_sub({1'b0,numerator4}, {1'b0,divisor_multiple_q[k]})\\\")\n p.write_text(s)\nprint('Small recurrence variants ready')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
