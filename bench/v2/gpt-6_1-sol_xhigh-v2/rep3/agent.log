{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_probe');src=Path('cores/bench/rtl')\nfor tag in ['allshift','shift_flatcase','right64']:\n dest=root/tag/'rtl';dest.mkdir(parents=True,exist_ok=True)\n for p in src.glob('*.sv'):shutil.copy2(p,dest/p.name)\n s=(root/'rightshift/rtl/alu.sv').read_text()\n if tag=='allshift':\n  old='  logic signed [32:0] right_input;'\n  s=s.replace(old,\\\"  logic left_shift;\\\\n  logic [31:0] shift_operand, shift_result;\\\\n  assign left_shift = op == ALU_SLL;\\\\n  for (genvar k = 0; k < 32; k++) begin : g_reverse\\\\n    assign shift_operand[k] = left_shift ? a[31-k] : a[k];\\\\n    assign shift_result[k] = left_shift ? right_shifted[31-k] : right_shifted[k];\\\\n  end\\\\n\\\"+old)\n  s=s.replace('&& a[31], a}', '&& a[31], shift_operand}')\n  s=s.replace('ALU_SLL:    out = a << shamt;', 'ALU_SLL:    out = shift_result;').replace('out = right_shifted[31:0];','out = shift_result;')\n elif tag=='right64':\n  s=s.replace('[32:0]','[63:0]').replace('{(op == ALU_SRA) && a[31], a}', '{{32{(op == ALU_SRA) && a[31]}}, a}')\n else:\n  start=s.index('  always_comb begin');end=s.index('\\\\nendmodule',start)\n  ops=[('ALU_ADD','a + b'),('ALU_SUB','a - b'),('ALU_AND','a & b'),('ALU_OR','a | b'),('ALU_XOR','a \"'^ b'\"'),('ALU_SLT',\\\"{31'b0, \"'$signed(a) < $signed(b)}\"),('\"'ALU_SLTU',\\\"{31'b0, a < b}\\\"),('ALU_SLL','a << b[4:0]'),('ALU_SRL || op == ALU_SRA','right_shifted[31:0]'),('ALU_LUI','b')]\n  parts=[f'({{32{{op == {op}}}}} & ({value}))' for op,value in ops]\n  while len(parts)>1:parts=[f'({parts[i]} | {parts[i+1]})' if i+1<len(parts) else parts[i] for i in range(0,len(parts),2)]\n  s=s[:start]+'  assign shamt = b[4:0];\\\\n  assign out = '+parts[0]+';\\\\n'+s[end:]\n (dest/'alu.sv').write_text(s)\nprint('Prepared unified-shift and output-selection refinements.')\nPY\"","aggregated_outpu