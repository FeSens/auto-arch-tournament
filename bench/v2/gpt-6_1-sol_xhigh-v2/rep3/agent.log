int(dut.busy.value) and not int(dut.done.value)\n    # Keep start asserted with changing inputs: busy requests must be ignored.\n    for elapsed in range(1, 8):\n        dut.a.value = (a + elapsed) & MASK\n        dut.b.value = (b ^ elapsed) & MASK\n        dut.op.value = OPS[elapsed % 4]\n        dut.accept.valu\n…[3475 of 6547 chars elided by tools/bench/transcript.py; sha256:d45f1718e1ae9f89]…\nalue, dut.a.value, dut.b.value = ALU_DIV, 103, 7\n        await tick(dut)\n        for _ in range(phase):\n            await tick(dut)\n        dut.reset.value = 1\n        await tick(dut)\n        assert not int(dut.busy.value) and not int(dut.done.value)\n        dut.reset.value = 0\n        dut.start.value = 0\n        dut.accept.value = 0\n        await check(dut, ALU_REMU, 103, 7, 5)\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_div_unit_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"div_unit_alt\" if alt else \"div_unit\")\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"div_unit.sv\"],\n                 hdl_toplevel=\"div_unit\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n", "exit_code": 0, "status": "completed"}}
