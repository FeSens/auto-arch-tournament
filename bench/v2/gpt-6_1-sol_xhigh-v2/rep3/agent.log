{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re,zlib\np=Path('/opt/gowin/IDE/doc/EN/SUG550-2.0.1E_GowinSynthesis User Guide.pdf').read_bytes()\nparts=[]\nfor i,m in enumerate(re.finditer(rb'stream\\\\r?\\\\n(.*?)\\\\r?\\\\nendstream',p,re.S)):\n try:s=zlib.decompress(m.group(1))\n except zlib.error:continue\n if b'syn_ramstyle' not in s:continue\n for text in re.findall(rb'\\\\[(.*?)\\\\]\\\\s*TJ',s,re.S):\n  words=[]\n  for item in re.findall(rb'<([0-9a-fA-F]+)>|\\\\(([\"'^()]*)'\"\\\\)',text):\n   if item[0]:\n    h=item[0].decode();words.append(''.join(chr(int(h[j:j+4],16)+29) for j in range(0,len(h),4)))\n   else:words.append(item[1].decode('latin1'))\n  parts.append(''.join(words))\nprint(''.join(parts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
