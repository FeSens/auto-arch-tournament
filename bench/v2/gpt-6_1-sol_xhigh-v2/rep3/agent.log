{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench')\np=Path('/srv/hwebench/tmp/bf842e9a/0b01ba2d/r7s1-rf-prototype')\np.mkdir(exist_ok=True)\nshutil.copytree(src/'rtl',p/'rtl',dirs_exist_ok=True)\nshutil.copytree(src/'test',p/'test',dirs_exist_ok=True)\nrf='''module reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output logic [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  logic [3:0] bank1, bank2, bankw;\n  logic [7:0] row1, row2, roww;\n  logic [31:0] read1_bank [0:3], read2_bank [0:3];\n  for (genvar k=0;k<4;k++) begin : g_bank_decode\n    assign bank1[k] = rs1_addr[4:3] == 2'(k);\n    assign bank2[k] = rs2_addr[4:3] == 2'(k);\n    assign bankw[k] = w_en && w_addr[4:3] == 2'(k);\n  end\n  for (genvar k=0;k<8;k++) begin : g_row_decode\n    assign row1[k] = rs1_addr[2:0] == 3'(k);\n    assign row2[k] = rs2_addr[2:0] == 3'(k);\n    assign roww[k] = w_addr[2:0] == 3'(k);\n  end\n  for (genvar b=0;b<4;b++) begin : g_bank\n    logic [31:0] masked1 [0:7], masked2 [0:7];\n    for (genvar r=0;r<8;r++) begin : g_word\n      (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\n      logic [31:0] word_q;\n      if (b==0 && r==0) begin : g_zero\n        assign word_q = 32'b0;\n      end else begin : g_register\n        always_ff @(posedge clock)\n          if (reset) word_q <= 32'b0;\n          else if (bankw[b] && roww[r]) word_q <= w_data;\n      end\n      assign masked1[r] = {32{row1[r]}} & word_q;\n      assign masked2[r] = {32{row2[r]}} & word_q;\n    end\n    assign read1_bank[b] = {32{bank1[b]}} &\n        (((masked1[0] | masked1[1]) | (masked1[2] | masked1[3])) |\n         ((masked1[4] | masked1[5]) | (masked1[6] | masked1[7])));\n    assign read2_bank[b] = {32{bank2[b]}} &\n        (((masked2[0] | masked2[1]) | (masked2[2] | masked2[3])) |\n         ((masked2[4] | masked2[5]) | (masked2[6] | masked2[7])));\n  end\n  always_comb begin\n    if (rs1_addr == 5'b0) rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = (read1_bank[0] | read1_bank[1]) | (read1_bank[2] | read1_bank[3]);\n    if (rs2_addr == 5'b0) rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = (read2_bank[0] | read2_bank[1]) | (read2_bank[2] | read2_bank[3]);\n  end\nendmodule\n'''\n(p/'rtl/reg_file.sv').write_text(rf)\nf=p/'rtl/id_stage.sv'\ns=f.read_text().replace('  id_ex_t reg_q;','  id_ex_t reg_q;\\\\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\\\\n  logic [31:0] rs1_val_q, rs2_val_q;')\ns=s.replace(\\\"      reg_q <= '0;\\\", \\\"      reg_q <= '0;\\\\n      rs1_val_q <= 32'b0;\\\\n      rs2_val_q <= 32'b0;\\\")\ns=s.replace('reg_q.rs1_val','rs1_val_q').replace('reg_q.rs2_val','rs2_val_q')\ns=s.replace('  assign out = reg_q;', '  always_comb begin\\\\n    out = reg_q;\\\\n    out.rs1_val = rs1_val_q;\\\\n    out.rs2_val = rs2_val_q;\\\\n  end')\nf.write_text(s)\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
