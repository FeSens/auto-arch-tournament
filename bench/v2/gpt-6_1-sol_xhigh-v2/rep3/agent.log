i]=fits8[i-1] && !fits8[i];\n    select8[7]=fits8[6];\n    digit8={select8[4]|select8[5]|select8[6]|select8[7],\n            select8[2]|select8[3]|select8[6]|select8[7],\n            select8[1]|select8[3]|select8[5]|select8[7]};\n    remainder_next=({32{select8[0]}} & shifted8[31:0]);\n    for (int i=1;i<8;i++) remainder_next=remainder_next|({32{select8[i]}}&trials8[i][31:0]);\n    quotient_next={quotient_q[28:0],digit8};\n    shifted4={remainder_next,quotient_next[31:30]};\n    trial1={1'\"'b0,shifted4}-d_q;\n    trial2={1'b0,shifted4}-d2_q;\n    trial3={1'b0,shifted4}-d3_q;\n    sel3=\"'!trial3[34];\n    sel2=trial3[34] && !trial2[34];\n    sel1=trial2[34] && !trial1[34];\n    sel0=trial1[34];\n    digit4={sel2|sel3,sel1|sel3};\n    remainder_next=({32{sel0}}&shifted4[31:0]) |\n                   ({32{sel1}}&trial1[31:0]) |\n                   ({32{sel2}}&trial2[31:0]) |\n                   ({32{sel3}}&trial3[31:0]);\n    quotient_next={quotient_next[29:0],digit4};\n  end\n'\"'''+s[b:]\ns=s.replace('d_q<=0;d2_q<=0;d3_q<=0;', 'd_q<=0;d2_q<=0;d3_q<=0;d4_q<=0;d5_q<=0;d6_q<=0;d7_q<=0;')\ns=s.replace(\\\"quotient_q<={magnitude_a[27:0],seed[7:4]};\\\", \\\"quotient_q<={magnitude_a[29:0],seed[3:2]};\\\")\ns=s.replace(\\\"remainder_q<={28'b0,seed[3:0]};\\\", \\\"remainder_q<={30'b0,seed[1:0]};\\\")\ns=s.replace(\\\"d_q<={2'b0,magnitude_b};\\\\n        d2_q<={1'b0,magnitude_b,1'b0};\\\\n        d3_q<={2'b0,magnitude_b}+{1'b0,magnitude_b,1'b0};\\\", \\\"\\\"\\\"d_q<={3'b0,magnitude_b};\n        d2_q<={2'b0,magnitude_b,1'b0};\n        d3_q<={3'b0,magnitude_b}+{2'b0,magnitude_b,1'b0};\n        d4_q<={1'b0,magnitude_b,2'b0};\n        d5_q<={3'b0,magnitude_b}+{1'b0,magnitude_b,2'b0};\n        d6_q<={2'b0,magnitude_b,1'b0}+{1'b0,magnitude_b,2'b0};\n        d7_q<={magnitude_b,3'b0}-{3'b0,magnitude_b};\\\"\\\"\\\")\n(p/'rtl/div_unit.sv').write_text(s)\nprint('Prepared second isolated prototype')\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval import g