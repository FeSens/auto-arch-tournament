2:0]  dec_branch_op;\n  logic        dec_is_branch;\n  logic        dec_is_jump;\n  logic        dec_is_jalr;\n  logic        dec_is_lui;\n  logic        dec_is_auipc;\n  logic        dec_mem_read;\n  logic        dec_mem_write;\n  logic [1:0]  dec_mem_width;\n  logic        dec_mem_sext;\n  logic        dec_reg_write;\n  logic        dec_mem_to_reg;\n  logic        dec_is_illegal;\n\n  decoder u_decoder (\n    .instr      (in.instr),\n    .alu_op     (dec_alu_op),\n    .alu_src    (dec_alu_src),\n    .branch_op  (dec_branch_op),\n    .is_branch  (dec_is_branch),\n    .is_jump    (d\n…[2766 of 5838 chars elided by tools/bench/transcript.py; sha256:c0522c632b9f0163]…\ns1 <= mem_w_en && mem_rd != 5'b0 && mem_rd == reg_q.rs1_addr ? 2'd2 : 2'd0;\n          fwd_rs2 <= mem_w_en && mem_rd != 5'b0 && mem_rd == reg_q.rs2_addr ? 2'd2 : 2'd0;\n        end\n        if (wb_w_en && wb_w_addr != 5'b0 && wb_w_addr == reg_q.rs1_addr)\n          rs1_val_q <= wb_w_data;\n        if (wb_w_en && wb_w_addr != 5'b0 && wb_w_addr == reg_q.rs2_addr)\n          rs2_val_q <= wb_w_data;\n      end\n\n      if (flush) reg_q.valid <= 1'b0;\n      else if (!stall) reg_q.valid <= in.valid;\n    end\n  end\n\n  always_comb begin\n    out = reg_q;\n    out.rs1_val = rs1_val_q;\n    out.rs2_val = rs2_val_q;\n  end\n\nendmodule\n      reg_q.valid         <= in.valid;\n    end\n  end\n\n  assign pending_rd = m_accept ? m_metadata_q.rd : in.rd;\n  assign pending_w_en = !reset && !stall &&\n      ((m_accept && m_metadata_q.valid && m_metadata_q.ctrl.reg_write) ||\n       (!is_m && !m_busy && in.valid && ctrl_with_trap.reg_write &&\n        !ctrl_with_trap.is_illegal && !mem_misalign && !in.ctrl.mem_read));\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
