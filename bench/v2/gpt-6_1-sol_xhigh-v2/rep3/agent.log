{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY' > cores/bench/generated/repartition_probe/tests.log 2>&1\nfrom pathlib import Path\nimport sys\nfrom cocotb_tools.runner import get_runner\nroot = Path.cwd()\nprobe = root / 'cores/bench/generated/repartition_probe'\nrtl = probe / 'rtl'\ntests = root / 'cores/bench/test'\nsys.path.insert(0, str(tests))\nfor alt in (False, True):\n    defines = {'RISCV_FORMAL_ALTOPS': 1} if alt else {}\n    extra_env = {'DIV_ALTOPS': '1' if alt else '0', 'PYTHONPATH': str(tests)}\n    for top, mod, testdir in [('div_unit', 'test_div_unit_trial', probe), ('core', 'test_core_div', tests)]:\n        sources = [rtl / 'core_pkg.sv', rtl / 'div_unit.sv'] if top == 'div_unit' else [rtl / 'core_pkg.sv'] + sorted(p for p in rtl.glob('*.sv') if p.name \"'!= '\"'core_pkg.sv')\n        build = probe / f'{top}_{int(alt)}'\n        runner = get_runner('verilator')\n        runner.build(sources=sources, hdl_toplevel=top, build_dir=build, always=True,\n                     defines=defines, build_args=['-Wall', '-Wno-fatal', '-Wno-style', '--public-flat-rw'])\n        runner.test(hdl_toplevel=top, test_module=mod, test_dir=testdir, build_dir=build, extra_env=extra_env)\n        print('COMPLETE', top, 'ALTOPS' if alt else 'REAL', flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
