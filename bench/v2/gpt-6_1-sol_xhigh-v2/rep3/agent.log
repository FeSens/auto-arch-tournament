);\n+  assign cond_not_U = (in.ctrl.branch_op == BR_BGEU) |\n+                      (((in.ctrl.branch_op == BR_BGE) & !sign_diff) |\n+                       ((in.ctrl.branch_op == BR_BLT) & sign_diff));\n+  assign branch_cond =\n+      (((in.ctrl.branch_op == BR_BEQ) & branch_eq) |\n+       ((in.ctrl.branch_op == BR_BNE) & !branch_eq)) |\n+      ((cond_U & branch_ltu) | (cond_not_U & !branch_ltu));\n+\n   always_comb begin\n-    case (in.ctrl.branch_op)\n-      BR_BEQ:  branch_cond = (rs1 == rs2);\n-      BR_BNE:  branch_cond = (rs1 != rs2);\n-      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n-      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n-      BR_BLTU: branch_cond = (rs1 <  rs2);\n-      BR_BGEU: branch_cond = (rs1 >= rs2);\n-      default: branch_cond = 1'b0;\n-    endcase\n     branch_taken  = in.ctrl.is_branch && branch_cond;\n     branch_target = in.direct_target;\n     // JALR clears bit 0 (RV spec); JAL uses imm directly.\n@@ -211,12 +234,8 @@ module ex_stage (\n   // arbitration, trap selection or prediction XOR on its way to fetch.\n   logic branch_recovery;\n   assign branch_recovery =\n-      (in.recover_eq  && (rs1 == rs2)) |\n-      (in.recover_ne  && (rs1 != rs2)) |\n-      (in.recover_lt  && ($signed(rs1) <  $signed(rs2))) |\n-      (in.recover_ge  && ($signed(rs1) >= $signed(rs2))) |\n-      (in.recover_ltu && (rs1 <  rs2)) |\n-      (in.recover_geu && (rs1 >= rs2));\n+      ((in.recover_eq & branch_eq) | (in.recover_ne & !branch_eq)) |\n+      ((recover_U & branch_ltu) | (recover_not_U & !branch_ltu));\n   assign redirect = in.valid && !reset && !stall && !m_busy\n                     && (branch_recovery || in.recover_jal ||\n                         (in.recover_jalr && !jalr_sum[1]));\ncores/bench/test/test_decoder_runner.result.xml\ncores/bench/test/test_imm_gen_runner.result.xml\ncores/bench/test/test_div_unit_runner[False].result.xml\ncores/bench/test/test_core_div_runner[True].result.xml\ncores/bench/test/test_reg_file_runner.result.xml\ncores/bench/test/test_m_unit_runner[False].result.xml\ncores/bench/test/test_alu_runner.result.xml\ncores/bench/test/test_m_unit_runner[True].result.xml\ncores/bench/test/test_pipeline_runner.result.xml\ncores/bench/test/test_div_unit_runner[True].result.xml\ncores/bench/test/test_core_div_runner[False].result.xml\ncores/bench/test/test_if_predictor_runner.result.xml\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/test/test_pipeline.py\n", "exit_code": 0, "status": "completed"}}
