{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nimport json,time\nfrom tools.eval.gowin import build,summarize\nwt=Path.cwd();root=wt/'cores/bench/generated/r6_probe/rightshift'\ndef run(opt):\n t=time.monotonic();r=build(wt,root/'rtl','fpga/core_bench_si.sv',opt,root/f'gowin_p{opt}')\n (root/f'timing_p{opt}.json').write_text(json.dumps(r,indent=2));return opt,round(time.monotonic()-t,1),r\nresults=[json.loads((root/'timing.json').read_text())]\nwith ThreadPoolExecutor(max_workers=2) as ex:\n for f in as_completed([ex.submit(run,opt) for opt in [1,2]]):\n  opt,t,r=f.result();results.append(r);print(json.dumps([opt,t,r]),flush=True)\nsummary=summarize(results);(root/'timing_summary.json').write_text(json.dumps(summary,indent=2));print('SUMMARY',json.dumps(summary),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_probe/rightshift');dest=root/'test';dest.mkdir(parents=True,exist_ok=True)\nfor name in ['_helpers.py','conftest.py','test_alu.py']:\n shutil.copy2(Path('cores/bench/test')/name,dest/name)\nextra='''\n\n@cocotb.test()\nasync def exhaustive_shift_amounts_and_random(dut):\n    import random\n    rng = random.Random(20261001)\n    def signed(a):\n        return a if a < 0x80000000 else a - 0x100000000\n    values = {0, 1, 0xffffffff, 0x7fffffff, 0x80000000, 0xaaaaaaaa, 0x55555555}\n    for bit in range(32):\n        values.update({1 << bit, (0xffffffff \"'^ (1 << bit))})\n    checks=0\n    for a in sorted(values):\n        for shift in range(32):\n            for b in [shift, (0xffffffe0 | shift)]:\n                await _check(dut, ALU_SRL, a, b, a >> shift)\n                await _check(dut, ALU_SRA, a, b, signed(a) >> shift)\n                await _check(dut, ALU_SLL, a, b, a << shift)\n                checks += 3\n    for i in range(50000):\n        a, b = rng.getrandbits(32), rng.getrandbits(32)\n        shift = b & 31\n        await _check(dut, ALU_SRL, a, b, a >> shift)\n        await _check(dut, ALU_SRA, a, b, signed(a) >> shift)\n        await _check(dut, ALU_SLL, a, b, a << shift)\n        checks += 3\n    dut._log.info('\"'Verified %d directed/random shift results', checks)\n'''\nwith (dest/'test_alu.py').open('a') as f:f.write(extra)\nprint('Prepared full shift-amount and opcode-switch coverage.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_probe/rightshift');dest=root/'test';dest.mkdir(parents=True,exist_ok=True)\nfor name in ['_helpers.py','conftest.py','test_alu.py']:\n shutil.copy2(Path('cores/bench/test')/name,dest/name)\nextra='''\n\n@cocotb.test()\nasync def exhaustive_shift_amounts_and_random(dut):\n    import random\n    rng = random.Random(20261001)\n    def signed(a):\n        return a if a < 0x80000000 else a - 0x100000000\n    values = {0, 1, 0xffffffff, 0x7fffffff, 0x80000000, 0xaaaaaaaa, 0x55555555}\n    for bit in range(32):\n        values.update({1 << bit, (0xffffffff \"'^ (1 << bit))})\n    checks=0\n    for a in sorted(values):\n        for shift in range(32):\n            for b in [shift, (0xffffffe0 | shift)]:\n                await _check(dut, ALU_SRL, a, b, a >> shift)\n                await _check(dut, ALU_SRA, a, b, signed(a) >> shift)\n                await _check(dut, ALU_SLL, a, b, a << shift)\n                checks += 3\n    for i in range(50000):\n        a, b = rng.getrandbits(32), rng.getrandbits(32)\n        shift = b & 31\n        await _check(dut, ALU_SRL, a, b, a >> shift)\n        await _check(dut, ALU_SRA, a, b, signed(a) >> shift)\n        await _check(dut, ALU_SLL, a, b, a << shift)\n        checks += 3\n    dut._log.info('\"'Verified %d directed/random shift results', checks)\n'''\nwith (dest/'test_alu.py').open('a') as f:f.write(extra)\nprint('Prepared full shift-amount and opcode-switch coverage.')\nPY\"","aggregated_output":"Prepared full shift-amount and opcode-switch coverage.\n","exit_code":0,"status":"completed"}}
