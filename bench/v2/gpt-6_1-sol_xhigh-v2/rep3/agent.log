{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nrtl=Path('cores/bench/rtl')\nbackup=Path('cores/bench/generated/hypothesis_probe/backups')\nbackup.mkdir(parents=True,exist_ok=True)\nfor f in ('core_pkg.sv','mem_stage.sv','wb_stage.sv'):\n (backup/f).write_bytes((rtl/f).read_bytes())\np=rtl/'core_pkg.sv'\ns=p.read_text().replace('    logic [31:0] alu_result;\\\\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)','    logic [31:0] writeback_value; // final scalar or extracted load result')\np.write_text(s)\np=rtl/'mem_stage.sv'\ns=p.read_text().replace('  mem_wb_t reg_q;','  mem_wb_t reg_q;\\\\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\\\\n  logic [31:0] writeback_value_q;')\ns=s.replace(\\\"      reg_q <= '0;\\\", \\\"      reg_q <= '0;\\\\n      writeback_value_q <= 32'b0;\\\")\ns=s.replace('      reg_q.alu_result <= in.alu_result;\\\\n      reg_q.read_data  <= load_data;', '      writeback_value_q <= in.ctrl.mem_to_reg ? load_data : in.alu_result;')\ns=s.replace('  assign out = reg_q;', '  always_comb begin\\\\n    out = reg_q;\\\\n    out.writeback_value = writeback_value_q;\\\\n  end')\n# reg_q.writeback_value is overridden by the separate preserved register.\n# Tie unused metadata member to avoid an undriven packed-struct warning.\ns=s.replace(\\\"      reg_q.pc         <= in.pc;\\\", \\\"      reg_q.writeback_value <= 32'b0;\\\\n      reg_q.pc         <= in.pc;\\\")\np.write_text(s)\np=rtl/'wb_stage.sv'\ns=p.read_text().replace('    w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;', '    w_data = in.writeback_value;')\np.write_text(s)\nprint('Temporary writeback prototype prepared; originals backed up.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
