{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl'); dst=Path('cores/bench/generated/scalar_proto/rtl');dst.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'): shutil.copy2(p,dst/p.name)\np=dst/'core_pkg.sv';s=p.read_text();needle='  // ID/EX register payload.\\\\n  typedef struct packed {\\\\n';assert needle in s;s=s.replace(needle,needle+'    logic [11:0] scalar_ops;\\\\n    logic [3:0] scalar_a_sel, scalar_b_sel;\\\\n',1);p.write_text(s)\np=dst/'id_stage.sv';s=p.read_text();needle='  id_payload_t reg_q;';assert needle in s;s=s.replace(needle,needle+'''\\\\n  logic [11:0] scalar_ops_q, scalar_ops_d;\n  logic [3:0] scalar_a_sel_q, scalar_b_sel_q;\n  logic [3:0] rs1_sources_d, rs2_sources_d;\n  always_comb begin\n    rs1_sources_d = 4'b0001;\n    rs2_sources_d = 4'b0001;\n    case (next_rs1_sel)\n      2'd1: rs1_sources_d = 4'b0010;\n      2'd2: rs1_sources_d = 4'b0100;\n      default: ;\n    endcase\n    case (next_rs2_sel)\n      2'd1: rs2_sources_d = 4'b0010;\n      2'd2: rs2_sources_d = 4'b0100;\n      default: ;\n    endcase\n    scalar_ops_d = 12'b0;\n    if (\"'!dec_is_illegal) begin\n      if (dec_is_jump) scalar_ops_d[11] = 1'\"'b1;\n      else case (dec_alu_op)\n        ALU_ADD: scalar_ops_d[0] = 1'b1;\n        ALU_SUB: scalar_ops_d[1] = 1'b1;\n        ALU_AND: scalar_ops_d[2] = 1'b1;\n        ALU_OR: scalar_ops_d[3] = 1'b1;\n        ALU_XOR: scalar_ops_d[4] = 1'b1;\n        ALU_SLT: scalar_ops_d[5] = 1'b1;\n        ALU_SLTU: scalar_ops_d[6] = 1'b1;\n        ALU_SLL: scalar_ops_d[7] = 1'b1;\n        ALU_SRL: scalar_ops_d[8] = 1'b1;\n        ALU_SRA: scalar_ops_d[9] = 1'b1;\n        ALU_LUI: scalar_ops_d[10] = 1'b1;\n        default: ;\n      endcase\n    end\n  end\n''',1)\nneedle=\\\"      reg_q <= '0;\\\";s=s.replace(needle,needle+\\\"\\\\n      scalar_ops_q <= 12'b0;\\\\n      scalar_a_sel_q <= 4'b0001;\\\\n      scalar_b_sel_q <= 4'b0001;\\\",1)\nneedle='      if (\"'!stall) begin'\"';s=s.replace(needle,needle+'''\\\\n        scalar_ops_q <= scalar_ops_d;\n        scalar_a_sel_q <= dec_is_auipc ? 4'b1000 : rs1_sources_d;\n        scalar_b_sel_q <= dec_alu_src ? 4'b1000 : rs2_sources_d;''',1)\nneedle='        if (mem_advance) begin';s=s.replace(needle,needle+'''\\\\n          if (\"'!reg_q.ctrl.is_auipc) scalar_a_sel_q <= mem_match_rs1 ? 4'\"'b0100 : 4'b0001;\n          if (\"'!reg_q.ctrl.alu_src) scalar_b_sel_q <= mem_match_rs2 ? 4'\"'b0100 : 4'b0001;''',1)\nneedle=\\\"          if (rs1_sel_q \"'!= 2'\"'d1 && refresh_rs1) rs1_sel_q <= 2'd0;\\\";s=s.replace(needle,\\\"          if (\"'!reg_q.ctrl.is_auipc && !scalar_a_sel_q[1] && refresh_rs1) scalar_a_sel_q <= 4'\"'b0001;\\\\n          if (\"'!reg_q.ctrl.alu_src && !scalar_b_sel_q[1] && refresh_rs2) scalar_b_sel_q <= 4'\"'b0001;\\\\n\\\"+needle,1)\nneedle='  always_comb begin\\\\n    out.direct_target';s=s.replace(needle,'  always_comb begin\\\\n    out.scalar_ops = scalar_ops_q;\\\\n    out.scalar_a_sel = scalar_a_sel_q;\\\\n    out.scalar_b_sel = scalar_b_sel_q;\\\\n    out.direct_target',1);p.write_text(s)\np=dst/'ex_stage.sv';s=p.read_text();start=s.index('  // ── ALU operand selection');end=s.index('  // Complete memory requests',start);s=s[:start]+'''  logic [31:0] alu_a, alu_b, alu_result;\n  assign alu_a = ((in.rs1_val & {32{in.scalar_a_sel[0]}}) |\n                  (fwd_ex_mem & {32{in.scalar_a_sel[1]}})) |\n                 ((fwd_mem_wb & {32{in.scalar_a_sel[2]}}) |\n                  (in.pc & {32{in.scalar_a_sel[3]}}));\n  assign alu_b = ((in.rs2_val & {32{in.scalar_b_sel[0]}}) |\n                  (fwd_ex_mem & {32{in.scalar_b_sel[1]}})) |\n                 ((fwd_mem_wb & {32{in.scalar_b_sel[2]}}) |\n                  (in.imm & {32{in.scalar_b_sel[3]}}));\n  scalar_lanes u_scalar (.op_en(in.scalar_ops), .a(alu_a), .b(alu_b),\n                         .link(in.sequential_pc), .out(alu_result));\n\n'''+s[end:];needle='in.ctrl.is_jump ? in.sequential_pc : alu_result';assert needle in s;s=s.replace(needle,'alu_result',1);p.write_text(s)\n(dst/'scalar_lanes.sv').write_text('''module scalar_lanes (\n  input logic [11:0] op_en,\n  input logic [31:0] a, b, link,\n  output logic [31:0] out\n);\n  logic signed [32:0] right_input, right_result;\n  logic [31:0] lane [0:11];\n  assign right_input = \"'$signed({op_en[9] && a[31], a});\n  assign right_result = right_input >>> b[4:0];\n  assign lane[0] = (a + b) & {32{op_en[0]}};\n  assign lane[1] = (a - b) & {32{op_en[1]}};\n  assign lane[2] = (a & b) & {32{op_en[2]}};\n  assign lane[3] = (a | b) & {32{op_en[3]}};\n  assign lane[4] = (a ''^ b) & {32{op_en[4]}};\n  assign lane[5] = {31'\"'b0, op_en[5] && (\"'$signed(a) < $signed(b))};\n  assign lane[6] = {31'\"'b0, op_en[6] && (a < b)};\n  assign lane[7] = (a << b[4:0]) & {32{op_en[7]}};\n  assign lane[8] = right_result[31:0] & {32{op_en[8] | op_en[9]}};\n  assign lane[9] = 32'b0;\n  assign lane[10] = b & {32{op_en[10]}};\n  assign lane[11] = link & {32{op_en[11]}};\n  assign out = (((lane[0] | lane[1]) | (lane[2] | lane[3])) |\n                ((lane[4] | lane[5]) | (lane[6] | lane[7]))) |\n               ((lane[8] | lane[9]) | (lane[10] | lane[11]));\nendmodule\n''')\nprint('Scalar prototype written to',dst)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
