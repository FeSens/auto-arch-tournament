{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/bf842e9a/84001434/predictor_target_probe')\nfor name,source in [('split_native32',Path('cores/bench/rtl')),('split_segment20',root/'shared_segmented/rtl')]:\n d=root/name/'rtl';d.mkdir(parents=True,exist_ok=True)\n for p in source.glob('*.sv'):shutil.copy2(p,d/p.name)\n p=d/'if_stage.sv';s=p.read_text()\n s=s.replace('  logic [31:0] cursor_q, recovery_target_q;', '''  logic [31:0] sequential_cursor_q, direct_cursor_q, recovery_target_q;\n  (* syn_preserve = 1, syn_keep = 1, keep = 1, dont_touch = 1 *)\n  logic cursor_taken_q;\n  logic [31:0] cursor_q;\n  assign cursor_q = cursor_taken_q ? direct_cursor_q : sequential_cursor_q;''')\n s=s.replace('      cursor_q <= RESET_PC;', '''      sequential_cursor_q <= RESET_PC;\n      direct_cursor_q <= RESET_PC;\n      cursor_taken_q <= 1'b0;''')\n s=s.replace('      if (physical_accept) cursor_q <= next_pc;', '''      if (physical_accept) begin\n        sequential_cursor_q <= pc + 32'd4;\n        direct_cursor_q <= direct_target;\n        cursor_taken_q <= predicted_taken;\n      end''')\n s=s.replace('  logic [31:0] next_pc;','')\n s=s.replace('    next_pc = predicted_taken ? direct_target : pc + 32\\\\'d4;','')\n p.write_text(s)\n print('Wrote',name)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
