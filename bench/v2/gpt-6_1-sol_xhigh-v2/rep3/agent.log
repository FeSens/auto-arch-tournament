                    assert branch[\"pc_next\"] == (0x110 if taken else 0x104)\n                    assert memory == {128: a, 132: b, 160: 22 if taken else 11}\n                    trains = [e for e in events if e[\"train\"] and e[\"train_pc\"] == 0x100]\n                    assert len(trains) == 1\n                    assert (trains[0][\"train_taken\"], trains[0][\"ex_predicted\"]) == (\n                        int(taken), int(predicted))\n                    recoveries = [e for e in events if e[\"redirect\"] and e[\"ex_pc\"] == 0x100]\n                    assert len(recoveries) == int(taken != predicted)\n                    path = [0, 4] + ([] if predicted else [8]) + [12, 16, 0x100]\n                    path += [0x110, 0x114] if taken else [0x104, 0x108]\n                    assert [r[\"pc\"] for r in rets] == path + [0x118, 0x11C]\n\n\n@cocotb.test()\nrg: /srv/hwebench/tmp/bf842e9a/ccb897fc/predictor_byte/timing/gowin_p1/impl/gwsynthesis/core_bench.v: IO error for operation on /srv/hwebench/tmp/bf842e9a/ccb897fc/predictor_byte/timing/gowin_p1/impl/gwsynthesis/core_bench.v: No such file or directory (os error 2)\n","exit_code":0,"status":"completed"}}
