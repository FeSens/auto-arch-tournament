h and not redirect)\n        await edge(dut)\n        expected_pc = 0 if do_reset else target if redirect else pc if stall else next_pc\n        assert int(dut.imem_addr.value) == expected_pc, (cycle,expected_pc)\n        if do_reset: counters = [1] * 64\n        elif train_valid:\n            index = ((train_pc >> 2) \"'^ (train_pc >> 8)) & 63\n            counters[index] = min(3,counters[index]+1) if train_taken else max(0,counters[index]-1)\n'\"'''.replace('0xBHT if False else ',''))\nprint('Streaming reference test written')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
