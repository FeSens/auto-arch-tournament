{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"The expanded suite passes, including byte/sign boundaries across RF, EX, MEM, and WB operands, load-use, competing writers, and 16-cycle holds. SAT also proves the actual RTL equations for arbitrary operands, all eight branch operations, and all recovery-flag combinations. CoreMark remains at exactly 4,378,154 bracketed cycles; measured fitness is 180.921, below the acceptance threshold.\n"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport os\nimport subprocess\nimport sys\nimport tempfile\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.cosim import run_one\nsys.path.insert(0, str(Path('cores/bench/test').resolve()))\nfrom test_pipeline import ADDI, NOP, LW, SW, EBREAK, _b\nunequal = [(0x12345600, 0x12345601), (0x123400ff, 0x12340100),\n           (0x1234ff00, 0x123500ff), (0x12ffff00, 0x130000ff),\n           (0x00ffffff, 0x01000000), (0x7fffffff, 0x80000000),\n           (0x800000ff, 0x80000100), (0xffffffff, 0)]\npairs = unequal + [(b, a) for a, b in unequal] + [(0, 0), (0x12345678, 0x12345678),\n        (0x80000000, 0x80000000), (0xffffffff, 0xffffffff)]\nassembly = ['.option norelax', '.section .text.start', '.globl _start', '_start:',\n            'la x21, operands', 'lui x20, 0x30', 'addi x5, x0, 0']\nfor funct3 in (0, 1, 4, 5, 6, 7):\n    for index, pair in enumerate(pairs):\n        offset = index * 8\n        modes = [\n            [ADDI(1,10,0),ADDI(2,11,0),NOP(),NOP(),NOP()],\n            [ADDI(2,11,0),NOP(),NOP(),ADDI(1,10,0)],\n            [ADDI(1,10,0),NOP(),NOP(),ADDI(2,11,0)],\n            [ADDI(2,11,0),NOP(),ADDI(1,10,0),NOP()],\n            [ADDI(1,10,0),NOP(),ADDI(2,11,0),NOP()],\n            [ADDI(2,11,0),ADDI(1,10,0),NOP(),NOP()],\n            [ADDI(1,10,0),ADDI(2,11,0),NOP(),NOP()],\n            [ADDI(1,10,0),ADDI(2,11,0)],\n            [ADDI(2,11,0),ADDI(1,10,0)],\n            [ADDI(2,11,0),NOP(),NOP(),LW(1,21,offset)],\n            [ADDI(1,10,0),NOP(),NOP(),LW(2,21,offset+4)],\n            [ADDI(2,11,0),NOP(),ADDI(1,12,0),ADDI(1,10,0)],\n            [ADDI(1,10,0),NOP(),ADDI(2,12,0),ADDI(2,11,0)],\n            [ADDI(2,11,0),ADDI(1,12,0),ADDI(1,10,0),SW(0,20,4)],\n            [ADDI(1,10,0),ADDI(2,12,0),ADDI(2,11,0),LW(31,20,4)],\n        ]\n        for setup in modes:\n            words = [LW(10,21,offset), LW(11,21,offset+4), ADDI(12,10,1),\n                     NOP(), NOP(), NOP()] + setup\n            words += [_b(8,2,1,funct3,0x63), ADDI(5,5,1), SW(5,20,0), NOP()]\n            assembly += [f'.word 0x{word:08x}' for word in words]\nassembly += [f'.word 0x{EBREAK():08x}', '.section .rodata', '.align 2', 'operands:']\nassembly += [f'.word 0x{a:08x}, 0x{b:08x}' for a,b in pairs]\nwith tempfile.TemporaryDirectory(dir=os.environ['TMPDIR']) as scratch:\n    elf = Path(scratch) / 'branch_byte_sources.elf'\n    subprocess.run(['riscv32-unknown-elf-gcc', '-march=rv32im', '-mabi=ilp32',\n                    '-nostdlib', '-nostartfiles', '-Wl,--no-relax', '-T',\n                    'bench/programs/link.ld', '-x', 'assembler', '-', '-o', str(elf)],\n                   input='\\\\n'.join(assembly)+'\\\\n', text=True, check=True)\n    sim = str(Path('cores/bench/obj_dir/cosim_sim').resolve())\n    modes = [(), ('--istall',), ('--dstall',), ('--istall','--dstall')]\n    jobs = [(program, flags) for program in (Path('bench/programs/selftest.elf'), elf) for flags in modes]\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        futures = [pool.submit(run_one, program, sim, '.', None, flags) for program,flags in jobs]\n        results = [future.result() for future in futures]\n    for result in results:\n        print(result)\n    assert all(result['passed'] for result in results)\n    print('Eight full-trace ISS comparisons passed; boundary program has 1800 branches.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
