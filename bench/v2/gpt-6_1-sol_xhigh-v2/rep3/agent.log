{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_probe')\nfor tag in ['localauipc','localauipc_shared']:\n dest=root/tag/'test';dest.mkdir(parents=True,exist_ok=True)\n for p in (root/'rightshift/test').glob('*.py'):shutil.copy2(p,dest/p.name)\n p=dest/'test_alu.py';s=p.read_text().replace('    dut.op.value = op','    dut.pc.value = 0\\\\n    dut.is_auipc.value = 0\\\\n    dut.op.value = op')\n s+='''\n\n@cocotb.test()\nasync def local_auipc_add_operand(dut):\n    import random\n    rng = random.Random(932)\n    for i in range(10000):\n        a, pc, b = (rng.getrandbits(32) for _ in range(3))\n        dut.a.value = a\n        dut.b.value = b\n        dut.pc.value = pc\n        dut.op.value = ALU_ADD\n        dut.is_auipc.value = 1\n        await Timer(1, \\\"ns\\\")\n        assert int(dut.out.value) == ((pc + b) & MASK32)\n        dut.is_auipc.value = 0\n        await Timer(1, \\\"ns\\\")\n        assert int(dut.out.value) == ((a + b) & MASK32)\n'''\n p.write_text(s)\nprint('Prepared ALU tests covering operation-local AUIPC operands.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
