{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,145p' cores/bench/test/test_m_unit.py; rg -n 'bsram|rs1|rs2|u_id' cores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.timing_paths | head -10; git diff cores/bench/rtl/ex_stage.sv cores/bench/rtl/id_stage.sv\"", "aggregated_output": "\"\"\"Registered RV32M arithmetic, operation transitions and handshake timing.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (RTL, SIM_BUILD, TEST_DIR, ALU_MUL, ALU_MULH,\n                      ALU_MULHU, ALU_MULHSU, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nfrom test_div_unit import expected as div_expected, tick, reset, MASK\n\nMUL_OPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nOPS = MUL_OPS + DIV_OPS\nMUL_ALTOPS = dict(zip(MUL_OPS, (0x5876063E, 0xF6583FB7, 0x949CE5E8, 0xECFBE137)))\n\n\ndef expected(op, a, b, alt=False):\n    a, b = a & MASK, b & MASK\n    if op in DIV_OPS:\n        return div_expected(op, a, b, alt)\n    if alt:\n        return ((a - b if op == ALU_MULHSU else a + b) ^ MUL_ALTOPS[op]) & MASK\n    sa = a - (1 << 32) if a & 0x80000000 else a\n    sb = b - (1 << 32) if b & 0x80000000 else b\n    product = (sa * sb if op == ALU_MULH else\n               sa * b if op == ALU_MULHSU else a * b)\n    return (product if op == ALU_MUL else product >> 32) & MASK\n\n\nasync def check(dut, op, a, b, exact=None, hold=0):\n    alt = os.environ.get(\"M_ALTOPS\") == \"1\"\n    want = expected(op, a, b, alt)\n    if exact is not None and not alt:\n        assert want == exact\n    assert not int(dut.busy.value) and not int(dut.done.value)\n    dut.start.value = 1\n    dut.accept.value = 1  # Premature acceptance must not cancel work.\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    await tick(dut)\n    assert int(dut.busy.value) and not int(dut.done.value)\n    latency = 1 if op in MUL_OPS else 7\n    for elapsed in range(1, latency + 1):\n        dut.op.value = OPS[elapsed % 8]\n        dut.a.value = (a + elapsed) & MASK\n        dut.b.value = (b ^ elapsed) & MASK\n        await tick(dut)\n        assert int(dut.busy.value)\n        assert int(dut.done.value) == (elapsed == latency)\n    assert int(dut.result.value) == want, (op, hex(a & MASK), hex(b & MASK), hex(want), hex(\n…[8882 of 11954 chars elided by tools/bench/transcript.py; sha256:d72476b81b9ff5c2]…\nM is fresher.\n+          rs1_sel_q <= mem_match_rs1 ? 2'd2 : 2'd0;\n+          rs2_sel_q <= mem_match_rs2 ? 2'd2 : 2'd0;\n+        end else begin\n+          // A data stall holds EX/MEM while WB drains. Preserve that\n+          // younger producer even if older WB also refreshes the flop.\n+          if (rs1_sel_q != 2'd1 && refresh_rs1) rs1_sel_q <= 2'd0;\n+          if (rs2_sel_q != 2'd1 && refresh_rs2) rs2_sel_q <= 2'd0;\n+        end\n       end\n \n       if (flush) reg_q.valid <= 1'b0;\n@@ -123,6 +164,20 @@ module id_stage (\n     end\n   end\n \n-  assign out = reg_q;\n+  always_comb begin\n+    out.pc = reg_q.pc;\n+    out.rs1_val = rs1_val_q;\n+    out.rs2_val = rs2_val_q;\n+    out.imm = reg_q.imm;\n+    out.rd = reg_q.rd;\n+    out.rs1_addr = reg_q.rs1_addr;\n+    out.rs2_addr = reg_q.rs2_addr;\n+    out.ctrl = reg_q.ctrl;\n+    out.instr = reg_q.instr;\n+    out.predicted_taken = reg_q.predicted_taken;\n+    out.valid = reg_q.valid;\n+  end\n+  assign fwd_rs1_sel = rs1_sel_q;\n+  assign fwd_rs2_sel = rs2_sel_q;\n \n endmodule\n", "exit_code": 0, "status": "completed"}}
