{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport re, random\nfrom pathlib import Path\nsource = Path('cores/bench/generated/inspection/impl/pnr/core_bench.vo').read_text()\ncells = re.findall(r'\"'^(LUT'\"\\\\d|ALU)\\\\s+(\\\\\\\\\\\\S+)\\\\s*\\\\((.*?)\\\\);', source, re.M | re.S)\nparams = dict(re.findall(r'\"'^defparam'\"\\\\s+(\\\\\\\\\\\\S+)\\\\s*\\\\.(?:INIT|ALU_MODE)=(.*?);', source, re.M))\nnorm = lambda s: re.sub(r'\\\\s+', '', s)\ndrivers = {}\nfor kind, name, body in cells:\n    ports = {key: norm(value) for key, value in re.findall(r'\\\\.(\\\\w+)\\\\((.*?)\\\\)', body)}\n    p = params[name]\n    value = int(p.split(\\\"'h\\\")[1], 16) if \\\"'h\\\" in p else int(p)\n    for port in ('F', 'COUT', 'SUM'):\n        if port in ports:\n            drivers[ports[port]] = (kind, name, ports, value, port)\ndef evaluate(a, b):\n    cache = {'GND': 0, 'VCC': 1}\n    for stem, value in ((r'\\\\cpu/u_ex/rs1_0', a), (r'\\\\cpu/u_ex/rs2_0', b),\n                        (r'\\\\cpu/rs1', a), (r'\\\\cpu/rs2', b),\n                        (r'\\\\cpu/rs1_val_q', a), (r'\\\\cpu/rs2_val_q', b)):\n        for bit in range(32):\n            cache[f'{stem}[{bit}]'] = (value >> bit) & 1\n    for stem in (r'\\\\cpu/fwd_rs1_sel', r'\\\\cpu/fwd_rs2_sel'):\n        for bit in range(2):\n            cache[f'{stem}[{bit}]'] = 0\n    def signal(net):\n        if net not in cache:\n            if net not in drivers:\n                cache[net] = 0\n                return 0\n            kind, name, ports, p, output = drivers[net]\n            inputs = [signal(ports[f'I{bit}']) for bit in range(int(kind[3:]))] if kind.startswith('LUT') else []\n            if inputs:\n                cache[net] = (p >> sum(value << bit for bit, value in enumerate(inputs))) & 1\n            else:\n                assert p == 3, (name, p)\n                i0, i1, cin = (signal(ports[key]) for key in ('I0', 'I1', 'CIN'))\n                eq = i0 == i1\n                cache[net] = (cin if eq else 1) if output == 'COUT' else int(eq) \"'^ cin\n        return cache[net]\n    return [signal(r'\"'\\\\cpu/train_taken_' + str(k)) for k in (7, 8, 11, 15, 16)], signal\nfor a, b in ((0,0),(1,0),(0,1),(0x100,0xff),(0xff,0x100),\n             (0x10000,0xffff),(0xffff,0x10000),(0x1000000,0xffffff),\n             (0xffffff,0x1000000),(0x80000000,0x7fffffff),(0x7fffffff,0x80000000)):\n    result, signal = evaluate(a,b)\n    print(hex(a),hex(b),'word7/8/eq/15/16=',result, 'byte01=',\n          [signal(r'\\\\cpu/u_ex/train_taken_' + str(k)) for k in (12,13)], 'native_lt=', a<b)\nrng = random.Random(39)\nfor _ in range(10000):\n    a,b = rng.getrandbits(32),rng.getrandbits(32)\n    values, signal = evaluate(a,b)\n    assert values[2] == int(a==b)\n    assert (values[0] or values[1]) == int(a < b), (hex(a),hex(b),values)\n    assert signal(r'\\\\cpu/u_ex/train_taken_12') == int((a&255) >= (b&255))\n    assert signal(r'\\\\cpu/u_ex/train_taken_13') == int(((a>>8)&255) >= ((b>>8)&255))\nprint('Actual post-route LUT functions: equality and reconstructed unsigned_lt match 10000 native comparisons; low-byte order cones independently verified.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
