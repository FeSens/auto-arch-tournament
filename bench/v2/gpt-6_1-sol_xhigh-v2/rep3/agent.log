{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/regfile_probe')\nfor sub in ('rtl','test'):\n (root/sub).mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench',sub).glob('*'):\n  if p.is_file():shutil.copy2(p,root/sub/p.name)\np=root/'rtl/reg_file.sv'\ns=p.read_text();start=s.index('  logic [31:0] regs [0:31];')\ns=s[:start]+'''  logic [31:0] bank_read1[0:31], bank_read2[0:31];\n  for (genvar r=0; r<32; r++) begin: bank\n    if (r==0) begin\n      assign bank_read1[r] = 32'b0;\n      assign bank_read2[r] = 32'b0;\n    end else begin\n      (* syn_preserve=1 *) logic [31:0] value_q;\n      always_ff @(posedge clock) begin\n        if (reset) value_q <= 32'b0;\n        else if (w_en && w_addr == r) value_q <= w_data;\n      end\n      assign bank_read1[r] = value_q & {32{rs1_addr==r}};\n      assign bank_read2[r] = value_q & {32{rs2_addr==r}};\n    end\n  end\n  logic [31:0] read1,read2;\n  always_comb begin\n    read1 = 32'b0;\n    read2 = 32'b0;\n    for (int r=1;r<32;r++) begin\n      read1 = read1 | bank_read1[r];\n      read2 = read2 | bank_read2[r];\n    end\n    rs1_data = rs1_addr==5'b0 ? 32'b0 : (w_en && w_addr==rs1_addr) ? w_data : read1;\n    rs2_data = rs2_addr==5'b0 ? 32'b0 : (w_en && w_addr==rs2_addr) ? w_data : read2;\n  end\nendmodule\n'''\np.write_text(s)\nprint('Created isolated flop-bank register-file prototype.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
