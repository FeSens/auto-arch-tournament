{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"sed -n '260,350p' test/cosim/main.cpp; sed -n '1,90p' cores/bench/test/test_pipeline.py; python3 - <<'PY'\nimport importlib.util\nfrom pathlib import Path\nspec=importlib.util.spec_from_file_location('rvref', 'test/cosim/reference.py')\nm=importlib.util.module_from_spec(spec)\nimport sys\nsys.modules[spec.name]=m;spec.loader.exec_module(m)\nprint(m.RV32IM)\nPY\"", "aggregated_output": "            if (c == '\\\\' || c == '\"') { esc.push_back('\\\\'); esc.push_back(c); }\n            else if (c == '\\n') { esc += \"\\\\n\"; }\n            else if (c == '\\r') { esc += \"\\\\r\"; }\n            else if (c == '\\t') { esc += \"\\\\t\"; }\n            else if (c >= 0x20 && c < 0x7F) { esc.push_back(c); }\n            // drop other non-printables silently\n        }\n        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n               \"\\\"bench_bracketed\\\":%s,\\\"uart\\\":\\\"%s\\\"}\\n\",\n               hit_ebreak ? \"true\" : \"false\",\n               hit_ebreak ? \"false\" : \"true\",\n               oob_access ? \"true\" : \"false\",\n               (unsigned long long)bench_start_cycle,\n               (unsigned long long)bench_stop_cycle,\n               (bench_start_set && bench_stop_set) ? \"true\" : \"false\",\n               esc.c_str());\n    }\n    delete top;\n    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\n    // access occurred. OOB historically silently aliased to dmem[0] which\n    // could mask CPU effective-address bugs — now it fails loud.\n    if (!hit_ebreak) return 2;\n    if (oob_access)  return 3;\n    return 0;\n}\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\n…[1825 of 4897 chars elided by tools/bench/transcript.py; sha256:21070a74ac6765ca]…\nex_request(payload):\n    \"\"\"Decode the request lane above the unchanged 199-bit EX/MEM suffix.\"\"\"\n    return ((payload >> 240) & 0xFFFFFFFF, (payload >> 208) & 0xFFFFFFFF,\n            (payload >> 200) & 15, (payload >> 204) & 15,\n            (payload >> 199) & 1)\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\ndef _prediction(pc, insn, counters):\n    \"\"\"Independent direct-target / counter model, evaluated before training.\"\"\"\n    opcode, funct3 = insn & 127, (insn >> 12) & 7\n    branch = opcode == 0x63 and funct3 in (0, 1, 4, 5, 6, 7)\n    if opcode == 0x6F:\n        imm = (((insn >> 31) << 20) | (((insn >> 12) & 255) << 12) |\n               (((insn >> 20) & 1) << 11) | (((insn >> 21) & 1023) << 1))\n        imm = imm - (1 << 21) if imm & (1 << 20) else imm\n    else:\n        imm = (((insn >> 31) << 12) | (((insn >> 7) & 1) << 11) |\n               (((insn >> 25) & 63) << 5) | (((insn >> 8) & 15) << 1))\n        imm = imm - (1 << 13) if imm & (1 << 12) else imm\n<class 'rvref.RV32IM'>\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport importlib.util,sys,json,time\nfrom pathlib import Path\nfrom collections import Counter\nspec=importlib.util.spec_from_file_location('rvref','test/cosim/reference.py')\nm=importlib.util.module_from_spec(spec);sys.modules[spec.name]=m;spec.loader.exec_module(m)\nc=m.RV32IM();c.load_elf('/srv/hwebench/tmp/bf842e9a/a772c715/predictor_study/coremark.elf')\nstats=Counter();pcs=Counter();active=False;prev=None;counters=[1]*64\nfor i in range(8000000):\n r=c.step()\n if r is None: break\n insn=r['insn'];op=insn&127\n if r['mem_wmask'] and r['mem_addr']==0x10000100:\n  active=True\n elif r['mem_wmask'] and r['mem_addr']==0x10000104:\n  break\n if op==0x63 and not r['trap']:\n  idx=((r['pc']>>2)\"'^(r['\"'pc']>>8))&63\n  taken=r['npc']\"'!=((r['\"'pc']+4)&0xffffffff)\n  miss=(counters[idx]>=2)\"'!=taken\n  counters[idx]=min(3,counters[idx]+1) if taken else max(0,counters[idx]-1)\n  if active:\n   stats['\"'branches']+=1;stats['branch_errors']+=miss\n   if prev and prev['insn']&127==3 and prev['rd'] and prev['rd'] in (r['rs1'],r['rs2']):\n    stats['load_branch']+=1;stats['load_branch_errors']+=miss;pcs[r['pc']]+=1\n if active: stats['instructions']+=1\n prev=r\nout={'stats':dict(stats),'loadbranch_pc':dict(pcs),'retired':c.retired,'oob':c.oob_access}\np=Path('/srv/hwebench/tmp/bf842e9a/a772c715/predictor_study/profile.json');p.write_text(json.dumps(out,indent=2));print(json.dumps(out))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
