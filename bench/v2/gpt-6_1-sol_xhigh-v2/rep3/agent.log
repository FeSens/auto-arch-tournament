{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,245p' cores/bench/test/test_core_div.py\"", "aggregated_output": "\"\"\"Division dependencies, retirement bounds, and stalled memory ordering.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\nfrom test_div_unit import expected, MASK\n\n\ndef addi(rd, rs1, imm):\n    return ((imm & 0xFFF) << 20) | (rs1 << 15) | (rd << 7) | 0x13\n\n\ndef m_op(op, rd, rs1, rs2):\n    funct3 = {ALU_DIV: 4, ALU_DIVU: 5, ALU_REM: 6, ALU_REMU: 7}[op]\n    return (1 << 25) | (rs2 << 20) | (rs1 << 15) | (funct3 << 12) | (rd << 7) | 0x33\n\n\ndef lw(rd, addr):\n    return (addr << 20) | (2 << 12) | (rd << 7) | 3\n\n\ndef sw(rs, addr):\n    return ((addr >> 5) << 25) | (rs << 20) | (2 << 12) | ((addr & 31) << 7) | 0x23\n\n\ndef beq(rs1, rs2, offset):\n    imm = offset & 0x1FFF\n    return (((imm >> 12) << 31) | (((imm >> 5) & 63) << 25) |\n            (rs2 << 20) | (rs1 << 15) | (((imm >> 1) & 15) << 8) |\n            (((imm >> 11) & 1) << 7) | 0x63)\n\n\ndef jal(rd, offset):\n    imm = offset & 0x1FFFFF\n    return (((imm >> 20) << 31) | (((imm >> 1) & 1023) << 21) |\n            (((imm >> 11) & 1) << 20) | (((imm >> 12) & 255) << 12) |\n            (rd << 7) | 0x6F)\n\n\ndef jalr(rd, rs1, imm):\n    return ((imm & 0xFFF) << 20) | (rs1 << 15) | (rd << 7) | 0x67\n\n\ndef sext(value, bits):\n    return value - (1 << bits) if value & (1 << (bits - 1)) else value\n\n\nEBREAK = 0x00100073\n\n\nasync def edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def run(dut, program, memory=None, stalls=False, long_stall=None):\n    \"\"\"Use the bus handshake at the rising edge, recording each request once.\"\"\"\n    dut.reset.value = 1\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    for _ in range(3):\n        await edge(dut)\n    dut.reset.value = 0\n    memory = dict(memory or {})\n    regs = [0] * 32\n    retires, stores = [], [\n…[7302 of 10374 chars elided by tools/bench/transcript.py; sha256:9c11389f27bdc6c2]…\nJALR\"):\n        for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n            for stalls in (False, (True, False), (False, True), True):\n                # Transfer at PC 16 skips two wrong-path stores. JAL/JALR\n                # feed their freshly written link register to the divider.\n                transfer = {\"BEQ\": beq(1, 1, 12), \"JAL\": jal(3, 12),\n                            \"JALR\": jalr(3, 9, 0)}[kind]\n                dividend = 1 if kind == \"BEQ\" else 3\n                program = [addi(1, 0, -100), addi(2, 0, 7),\n                           addi(9, 0, 29), lw(10, 80), transfer,\n                           sw(1, 96), sw(2, 100),\n                           m_op(op, 4, dividend, 2), sw(4, 104), EBREAK]\n                rets, stores, _ = await run(dut, program, {80: 123}, stalls=stalls)\n                assert [r[\"pc_rdata\"] for r in rets] == [0, 4, 8, 12, 16, 28, 32, 36]\n                assert [s[0] for s in stores] == [104], (kind, op, stalls, stores)\n                gap = rets[5][\"cycle\"] - rets[4][\"cycle\"]\n", "exit_code": 0, "status": "completed"}}
