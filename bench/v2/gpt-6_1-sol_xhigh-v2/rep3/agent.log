{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_predictor.py; cat cores/bench/test/test_core_div.py'", "aggregated_output": "\"\"\"Raw predecode, old-value counter lookup and fetch acceptance controls.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import RTL, SIM_BUILD, TEST_DIR\nfrom test_pipeline import BEQ, JAL, JALR, NOP, _b, _prediction\n\n\nasync def edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.flush.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n    dut.imem_data.value = NOP()\n    for _ in range(3):\n        await edge(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    return [1] * 64\n\n\nasync def at_pc(dut, pc):\n    # Recovery overrides both fetch stall and invalid fetch status.\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    dut.train_valid.value = 0\n    await edge(dut)\n    assert int(dut.imem_addr.value) == pc\n    dut.redirect.value = 0\n    dut.flush.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def check_fetch(dut, counters, pc, instr, *, stall=False, flush=False,\n                      training=None, recovery=None):\n    await at_pc(dut, pc)\n    dut.imem_data.value = instr\n    dut.stall.value = int(stall)\n    dut.flush.value = int(flush)\n    dut.redirect.value = int(recovery is not None)\n    if recovery is not None:\n        dut.redirect_target.value = recovery\n    dut.train_valid.value = int(training is not None)\n    if training is not None:\n        dut.train_pc.value, dut.train_taken.value = training\n    await Timer(1, \"ns\")\n    prediction, predicted_pc = _prediction(pc, instr, counters)\n    fetched = int(dut.out.value)\n    assert fetched >> 34 == pc\n    assert (fetched >> 2) & 0xFFFFFFFF == instr\n    assert (fetched >> 1) & 1 == int(prediction)\n    assert fetched & 1 == int(not flush and recovery is None)\n    await e\n…[33741 of 36813 chars elided by tools/bench/transcript.py; sha256:9a7ba892cb5d0d5e]…\nata\"] == result\n            if not stalls:\n                assert following_store[\"cycle\"] - first_m[\"cycle\"] == 1\n                assert first_m[\"cycle\"] - rets[3][\"cycle\"] == (3 if op in MUL_OPS else 9)\n                assert first_m[\"cycle\"] - rets[3][\"cycle\"] <= 10\n            else:\n                assert held >= 3\n\n\n@pytest.mark.parametrize(\"alt\", [False, True])\ndef test_core_div_runner(alt):\n    runner = get_runner(\"verilator\")\n    build = SIM_BUILD / (\"core_div_alt\" if alt else \"core_div\")\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\") if p.name != \"core_pkg.sv\")\n    runner.build(sources=sources, hdl_toplevel=\"core\", build_dir=build, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if alt else {},\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"--public-flat-rw\"])\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_core_div\",\n                test_dir=TEST_DIR, build_dir=build,\n                extra_env={\"DIV_ALTOPS\": \"1\" if alt else \"0\"})\n", "exit_code": 0, "status": "completed"}}
