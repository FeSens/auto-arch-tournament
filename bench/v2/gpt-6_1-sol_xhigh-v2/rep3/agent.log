{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nmask=0xffffffff\nrng=random.Random(0x55EEDD)\ncount=0\nfor signed in (False,True):\n pairs=[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(12000)]\n pairs += [((n<<28)|lo,b) for n in range(16) for lo in (0,1,0xfffffff) for b in list(range(18))+[(-d)&mask for d in range(18)]+[0x80000000,0x7fffffff,0xffffffff]]\n for a,b in pairs:\n  na=signed and bool(a>>31);nb=signed and bool(b>>31)\n  ma=(-a if na else a)&mask;mb=(-b if nb else b)&mask\n  n=((~(a>>28)+int((a&0xfffffff)==0))&15) if na else a>>28\n  small=((b>>4)==0xfffffff and (b&15)\"'!=0) if nb else b>>4==0\n  d=(-b if nb else b)&15\n  q,r=divmod(n,d) if small and d else (15,n) if small else (0,n)\n  q=((ma&0xfffffff)<<4)|q\n  for _ in range(28):\n   r=(r<<1)|(q>>31);q=(q<<1)&mask\n   if r>=mb:r-=mb;q|=1\n  if b:\n   assert (q,r)==divmod(ma,mb),(signed,hex(a),hex(b),q,r)\n  count+=1\nprint('\"'Seed plus unchanged 28-bit recurrence agrees with independent division on',count,'pairs, including negative small divisors and nibble carries.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
