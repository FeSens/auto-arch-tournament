{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1\nEXT=(1<<35)-1\n\ndef divider(a,b,signed,remainder):\n    a &= MASK; b &= MASK\n    ma=(-a)&MASK if signed and a>>31 else a\n    d=(-b)&MASK if signed and b>>31 else b\n    q=ma; r=0\n    # Independent narrow launch datapath: consumed prefix widths 1..4.\n    for width in range(1,5):\n        t=(r<<1)|(q>>31)\n        low=d&((1<<width)-1)\n        diff=(t-low)&((1<<(width+1))-1)\n        fits=(d>>width)==0 and (diff>>width)==0\n        r=diff if fits else t\n        q=((q<<1)|fits)&MASK\n    assert r<=15\n    multiples=[0,d,2*d,3*d]\n    for edge in range(7):\n        # Two full radix-4 digits on each registered busy edge.\n        for digit in range(2):\n            t=(r<<2)|(q>>30)\n            differences=[(t-m)&EXT for m in multiples]\n            fits=[((v>>34)==0) for v in differences]\n            selected=max(i for i,f in enumerate(fits) if f)\n            r=differences[selected]\n            q=((q<<2)|selected)&MASK\n            assert r<=MASK\n            assert d==0 or r<d\n    if remainder:\n        return (-r)&MASK if signed and a>>31 else r\n    return (-q)&MASK if signed and ((a\"'^b)>>31) and b else q\n\ndef ref(a,b,signed,remainder):\n    a &= MASK; b &= MASK\n    if b==0: return a if remainder else MASK\n    x=a-(1<<32) if signed and a>>31 else a\n    y=b-(1<<32) if signed and b>>31 else b\n    q=abs(x)//abs(y)\n    if (x<0)!=(y<0): q=-q\n    return (x-q*y if remainder else q)&MASK\n\npairs=set()\nvalues=[0,1,2,3,4,7,8,15,16,31,32,63,64,127,128,255,256,\n        0x7fffffff,0x80000000,0x80000001,0xfffffffd,0xfffffffe,MASK]\nfor a in values:\n    for b in values: pairs.add((a,b))\nfor k in range(32):\n    for off in (-1,0,1):\n        b=((1<<k)+off)&MASK\n        for scale in (1,2,3):\n            for delta in (-1,0,1): pairs.add(((scale*b+delta)&MASK,b))\n        # First-prefix boundaries exercise all four launch-width guards.\n        for prefix in range(16):\n            for tail in (0,0x0fffffff): pairs.add(((prefix<<28)|tail,b))\nrng=random.Random(0x20261001)\nfor _ in range(30000): pairs.add((rng.getrandbits(32),rng.getrandbits(32)))\nfor _ in range(10000): pairs.add((rng.getrandbits(32),rng.randrange(256)))\nchecks=0\nfor a,b in pairs:\n    for signed in (False,True):\n        for rem in (False,True):\n            got=divider(a,b,signed,rem); want=ref(a,b,signed,rem)\n            assert got==want,(a,b,signed,rem,got,want)\n            checks+=1\nprint(f'\"'PASS: {checks:,} independent signed/unsigned quotient/remainder comparisons')\nprint('Model uses a four-bit launch prefix plus seven edges with two radix-4 digits each.')\nprint('This checks the proposed algorithm, not implemented RTL or FPGA timing.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
