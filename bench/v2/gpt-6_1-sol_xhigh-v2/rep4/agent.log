{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport subprocess\nfrom concurrent.futures import ThreadPoolExecutor\nroot=Path('cores/bench/generated/predictor_probe')\nbase=['riscv32-unknown-elf-gcc','-march=rv32im','-mabi=ilp32','-static','-nostartfiles','-T','bench/programs/link.ld']\nsmall=[('selftest', 'bench/programs/selftest.S')]+[(f'random{i}',f'bench/programs/random{i}.S') for i in range(1,4)]\ncmds=[base+[src,'-o',str(root/f'{name}.elf')] for name,src in small]\ncmds.append(base+['-O3','-specs=nano.specs','-specs=nosys.specs','-Ibench/programs/coremark','-Ibench/programs/coremark/baremetal','-DTOTAL_DATA_SIZE=2000']+[str(Path('bench/programs/coremark')/s) for s in ['core_list_join.c','core_main.c','core_matrix.c','core_state.c','core_util.c','baremetal/core_portme.c']]+['bench/programs/crt0.S','-o',str(root/'coremark.elf')])\nwith ThreadPoolExecutor() as ex:\n    r=list(ex.map(lambda c: subprocess.run(c,capture_output=True,text=True),cmds))\nfor i,res in enumerate(r):\n    print(cmds[i][-1],res.returncode,res.stderr[:1500])\n    assert res.returncode==0\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
