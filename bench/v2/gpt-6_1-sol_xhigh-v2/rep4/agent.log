{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_divider_formal.py'", "aggregated_output": "\"\"\"Prove the real divider's local arithmetic invariants without ALTOPS.\n\nThe prefix identity N = Q*D + R and 0 <= R < D uniquely identify unsigned\ndivision. Proving the captured prefix and fused digit for arbitrary bounded state\ncovers the recurrence independently of the vendored division operator.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nimport subprocess\nimport tempfile\n\n\n_ARITHMETIC_PROPERTIES = \"\"\"\n  always @* begin\n    if (magnitude_b_q != 0) begin\n      assert (prefix_remainder < magnitude_b_q);\n      assert (({32'b0, prefix_quotient} * {8'b0, magnitude_b_q}) +\n              {32'b0, prefix_remainder} == {32'b0, magnitude_a_q[31:24]});\n    end else begin\n      assert (prefix_quotient == 8'hff);\n      assert (prefix_remainder == magnitude_a_q[31:24]);\n    end\n    if (magnitude_b_q[31:8] != 0) begin\n      assert (prefix_quotient == 0);\n      assert (prefix_remainder == magnitude_a_q[31:24]);\n    end\n    if (prefix_divisor != 0) begin\n      assert (nibble_remainder < prefix_divisor);\n      assert ({8'b0, nibble_quotient} * {4'b0, prefix_divisor} +\n              {8'b0, nibble_remainder} == {8'b0, magnitude_a_q[31:28]});\n    end else begin\n      assert (nibble_quotient == 4'hf);\n      assert (nibble_remainder == magnitude_a_q[31:28]);\n    end\n    if (prefix_divisor[7:4] != 0) begin\n      assert (nibble_quotient == 0);\n      assert (nibble_remainder == magnitude_a_q[31:28]);\n    end\n    if (divisor_q[35:32] == 0 && divisor_q != 0 && remainder_q < divisor_q &&\n        triple_divisor_q == divisor_q + (divisor_q << 1) &&\n        five_divisor_q == divisor_q + (divisor_q << 2) &&\n        seven_divisor_q == (divisor_q << 3) - divisor_q &&\n        nine_divisor_q == divisor_q + (divisor_q << 3) &&\n        eleven_divisor_q == divisor_q + (divisor_q << 1) + (divisor_q << 3) &&\n        thirteen_divisor_q == divisor_q + (divisor_q << 2) + (divisor_q << 3) &&\n        fifteen_divisor_q == (divisor_q << 4) - divisor_q) begin\n      assert (remainder_next < divisor_q);\n      assert (divisor_q * {3\n…[4479 of 7551 chars elided by tools/bench/transcript.py; sha256:a3c00a3114304848]…\nsserts -verify -set-def-inputs\")],\n            cwd=work, capture_output=True, text=True, timeout=300,\n        )\n        assert proof.returncode == 0, proof.stdout + proof.stderr\n        if smt:\n            proof = subprocess.run(\n                [\"yosys-smtbmc\", \"-s\", \"bitwuzla\", \"-t\", \"1\", \"--presat\",\n                 \"--noprogress\", \"proof.smt2\"],\n                cwd=work, capture_output=True, text=True, timeout=300,\n            )\n            assert proof.returncode == 0, proof.stdout + proof.stderr\n            assert \"Status: PASSED\" in proof.stdout\n        else:\n            assert \"SAT proof finished - no model found: SUCCESS!\" in proof.stdout\n\n\ndef test_divider_arithmetic_invariants():\n    _prove(_ARITHMETIC_PROPERTIES, smt=True)\n\n\ndef test_divider_complete_byte_prefix_equivalence():\n    _prove(_PREFIX_EQUIVALENCE)\n\n\ndef test_divider_edge_two_registered_multiples():\n    _prove(_REGISTER_PROPERTIES,\n           \"-seq 3 -set-init-zero -set reset 0 -set launch 0 \"\n           \"-set-at 1 launch 1 -set op 16\")\n", "exit_code": 0, "status": "completed"}}
