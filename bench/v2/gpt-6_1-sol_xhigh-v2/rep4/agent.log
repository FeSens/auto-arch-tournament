{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/555e5898/7a5f92cb')\n# Single pair of read trees with two independently decoded fetch sources.\nroot=base/'predecode_rf'; rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in (base/'late_rf'/'rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'core.sv';s=p.read_text()\ns=s.replace('  logic [31:0] bus_rs1_data, bus_rs2_data, queued_rs1_data, queued_rs2_data;\\\\n  assign rs1_data_w = queued_select ? queued_rs1_data : bus_rs1_data;\\\\n  assign rs2_data_w = queued_select ? queued_rs2_data : bus_rs2_data;','')\ns=s.replace('.rs1_data (bus_rs1_data)','.rs1_data (rs1_data_w)').replace('.rs2_data (bus_rs2_data)','.rs2_data (rs2_data_w)')\ns=s.replace('    .rs3_data (queued_rs1_data),\\\\n    .rs4_data (queued_rs2_data),','    .read_use_alt (queued_select),')\np.write_text(s)\ns=Path('cores/bench/rtl/reg_file.sv').read_text()\ns=s.replace('  output logic [31:0] rs2_data,','  output logic [31:0] rs2_data,\\\\n  input logic [4:0] rs3_addr,\\\\n  input logic [4:0] rs4_addr,\\\\n  input logic read_use_alt,')\ns=s.replace('  wire [31:0] rs1_read, rs2_read;','  wire [31:0] rs1_read, rs2_read;\\\\n  wire [7:0] rs3_low_select, rs4_low_select;\\\\n  wire [3:0] rs3_high_select, rs4_high_select;\\\\n  wire rs1_bypass = w_en && w_addr \"'!= 5'\"\\\\'b0 && (read_use_alt ? w_addr == rs3_addr : w_addr == rs1_addr);\\\\n  wire rs2_bypass = w_en && w_addr \"'!= 5'\"\\\\'b0 && (read_use_alt ? w_addr == rs4_addr : w_addr == rs2_addr);')\nfor name,extra in [('rs1', 'rs3'),('rs2','rs4')]:\n    for kind in ['low','high']:\n        target=f'    assign {name}_{kind}_select[n] = ({name}_addr'\n        start=s.index(target);end=s.index(';',start)+1\n        line=s[start:end]\n        s=s[:end]+'\\\\n'+line.replace(name,extra)+s[end:]\n    target=f'    assign {name}_select[r] = {name}_high_select[r/8] &&