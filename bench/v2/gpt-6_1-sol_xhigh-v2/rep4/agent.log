{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/555e5898/c60c054b/probe_r13s0.py <<'PY'\nfrom pathlib import Path\nimport shutil, json, concurrent.futures\nfrom tools.eval import gowin\nwt=Path.cwd()\nroot=Path('/srv/hwebench/tmp/555e5898/c60c054b/r13s0_binary_rf')\n(root/'rtl').mkdir(parents=True,exist_ok=True)\n(root/'test').mkdir(exist_ok=True)\nfor p in (wt/'cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,root/'rtl'/p.name)\nfor name in ('test_reg_file.py','conftest.py','_helpers.py'):\n shutil.copy2(wt/'cores/bench/test'/name,root/'test'/name)\noriginal=(root/'rtl/reg_file.sv').read_text()\nheader=original[:original.index('  wire [31:0] words')]\nbody='''  wire [31:0] words [0:31];\n  wire [7:0] write_low_select;\n  wire [3:0] write_high_select;\n  wire [31:0] rs1_read, rs2_read;\n  assign words[0] = 32'b0;\n  for (genvar r = 1; r < 32; r++) begin : g_word\n    logic [31:0] word_q;\n    wire write_enable = w_en && write_high_select[r/8] && write_low_select[r%8];\n    always_ff @(posedge clock) begin\n      if (reset) word_q <= 32'b0;\n      else if (write_enable) word_q <= w_data;\n    end\n    assign words[r] = word_q;\n  end\n  for (genvar n = 0; n < 8; n++) begin : g_low_decode\n    localparam logic [2:0] LOW_ADDR = 3'(n);\n    assign write_low_select[n] = (w_addr[2:0] == LOW_ADDR);\n  end\n  for (genvar n = 0; n < 4; n++) begin : g_high_decode\n    localparam logic [1:0] HIGH_ADDR = 2'(n);\n    assign write_high_select[n] = (w_addr[4:3] == HIGH_ADDR);\n  end\n'''\nfor port in (1,2):\n for level in range(5):\n  count=16>>level\n  body+=f'  wire [31:0] rs{port}_level{level} [0:{count-1}];\\\\n'\n  prev='words' if level==0 else f'rs{port}_level{level-1}'\n  body+=f'  for (genvar n = 0; n < {count}; n++) begin : g_rs{port}_level{level}\\\\n'\n  body+=f'    assign rs{port}_level{level}[n] = rs{port}_addr[{level}] ? {prev}[2*n+1] : {prev}[2*n];\\\\n  end\\\\n'\n body+=f'  assign rs{port}_read = rs{port}_level4[0];\\\\n'\nbody+=original[original.index('  always_comb begin'):]\n(root/'rtl/reg_file.sv').write_text(header+body)\nprint('Probe RTL:',root/'rtl/reg_file.sv',flush=True)\ndef run(p):\n x=gowin.build(wt,root/'rtl','fpga/core_bench_si.sv',p,root/f'gowin_p{p}')\n (root/f'result_p{p}.json').write_text(json.dumps(x,indent=2))\n print(json.dumps(x),flush=True)\n return x\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as ex:\n futures=[ex.submit(run,p) for p in gowin.PLACE_OPTIONS]\n results=[f.result() for f in futures]\nprint('SUMMARY',json.dumps(gowin.summarize(results)),flush=True)\nPY\nPYTHONPATH=. python3 /srv/hwebench/tmp/555e5898/c60c054b/probe_r13s0.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
