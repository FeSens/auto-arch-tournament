{"type": "item.completed", "item": {"id": "item_84", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_multiplier.py'", "aggregated_output": "\"\"\"Physical MEM multiplier arithmetic, including the original ALU vectors.\"\"\"\nfrom __future__ import annotations\n\nimport ast\nimport os\nfrom pathlib import Path\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb)\n\nMASK = 0xFFFFFFFF\nOPS = (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU)\nCONSTANTS = dict(ALU_MUL=ALU_MUL, ALU_MULH=ALU_MULH,\n                 ALU_MULHU=ALU_MULHU, ALU_MULHSU=ALU_MULHSU)\nALTOPS = {ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7,\n          ALU_MULHU: 0x949CE5E8, ALU_MULHSU: 0xECFBE137}\n\n\ndef _reference(op, a, b):\n    if os.environ.get(\"MEM_MULTIPLIER_ALTOPS\"):\n        return ((a - b if op == ALU_MULHSU else a + b) ^ ALTOPS[op]) & MASK\n    sa = a if a < 0x80000000 else a - (1 << 32)\n    sb = b if b < 0x80000000 else b - (1 << 32)\n    product = sa * sb if op == ALU_MULH else sa * b if op == ALU_MULHSU else a * b\n    return (product if op == ALU_MUL else product >> 32) & MASK\n\n\nasync def _check(dut, op, a, b, expected):\n    dut.op.value = op\n    dut.a.value = a & MASK\n    dut.b.value = b & MASK\n    await Timer(1, \"ns\")\n    assert int(dut.result.value) == expected & MASK, (\n        op, hex(a & MASK), hex(b & MASK), hex(expected & MASK), hex(int(dut.result.value)))\n\n\n@cocotb.test()\nasync def all_original_vectors_and_seeded_products(dut):\n    # Read every literal MUL vector from the unchanged ALU suite so a new\n    # arithmetic expectation there automatically exercises the MEM hardware.\n    tree = ast.parse(Path(__file__).with_name(\"test_alu.py\").read_text())\n    literal_vectors = []\n    for node in ast.walk(tree):\n        if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and\n                node.func.id == \"_check\" and len(node.args) == 5 and\n                isinstance(node.args[1], ast.Name) and node.args[1].id in CONSTANTS):\n            op = CONSTANTS[node.args[1].id]\n            a, b, expected = (ast.literal_eval(n) for n in node.args[2:])\n            literal_vectors.append((op, a, b, expected))\n   \n…[1237 of 4309 chars elided by tools/bench/transcript.py; sha256:3c9aa16778234334]…\n2)\n        for op in OPS:\n            await _check(dut, op, a, b, _reference(op, a, b))\n    for op in (0, 10, 15, 16, 17, 18, 31):\n        await _check(dut, op, MASK, MASK, 0)\n\n\ndef test_multiplier_runner():\n    run_cocotb(toplevel=\"multiplier\", sources=[\"core_pkg.sv\", \"multiplier.sv\"],\n               test_module=\"test_multiplier\")\n\n\ndef test_multiplier_altops_runner():\n    from cocotb_tools.runner import get_runner\n    core = Path(__file__).resolve().parents[1]\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = core / \"sim_build\" / \"multiplier_altops\"\n    runner.build(sources=[core / \"rtl\" / \"core_pkg.sv\", core / \"rtl\" / \"multiplier.sv\"],\n                 hdl_toplevel=\"multiplier\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\", \"-DRISCV_FORMAL_ALTOPS\"])\n    runner.test(hdl_toplevel=\"multiplier\", test_module=\"test_multiplier\",\n                test_dir=core / \"test\", build_dir=build,\n                extra_env={\"MEM_MULTIPLIER_ALTOPS\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
