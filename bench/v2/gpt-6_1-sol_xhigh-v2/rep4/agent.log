{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p cores/bench/generated/r12_probe\ncat > cores/bench/generated/r12_probe/prepare.py <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/r12_probe/rtl')\np.mkdir(parents=True,exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(src,p/src.name)\nf=p/'if_stage.sv'\ns=f.read_text().replace('  output if_id_t  out','  output logic [4:0] queue_rs1_addr, queue_rs2_addr, response_rs1_addr, response_rs2_addr,\\\\n  output logic use_queue,\\\\n  output if_id_t  out')\ns=s.replace('  assign imem_addr = fetch_pc;','  assign imem_addr = fetch_pc;\\\\n  assign queue_rs1_addr = head.instr[19:15];\\\\n  assign queue_rs2_addr = head.instr[24:20];\\\\n  assign response_rs1_addr = imem_data[19:15];\\\\n  assign response_rs2_addr = imem_data[24:20];\\\\n  assign use_queue = count_q \"'!= 3'\"\\\\'d0;')\nf.write_text(s)\nf=p/'core.sv'\ns=f.read_text().replace('  // ── IF ─', '  logic [4:0] queue_rs1_addr, queue_rs2_addr, response_rs1_addr, response_rs2_addr;\\\\n  logic use_queue;\\\\n  logic [31:0] queue_rs1_data, queue_rs2_data, response_rs1_data, response_rs2_data;\\\\n  assign rs1_data_w = use_queue ? queue_rs1_data : response_rs1_data;\\\\n  assign rs2_data_w = use_queue ? queue_rs2_data : response_rs2_data;\\\\n\\\\n  // ── IF ─',1)\ns=s.replace('    .out             (if_id_w)','    .queue_rs1_addr(queue_rs1_addr), .queue_rs2_addr(queue_rs2_addr),\\\\n    .response_rs1_addr(response_rs1_addr), .response_rs2_addr(response_rs2_addr),\\\\n    .use_queue(use_queue),\\\\n    .out             (if_id_w)')\ns=s.replace('    .rs1_addr (rs1_addr_w),\\\\n    .rs2_addr (rs2_addr_w),\\\\n    .rs1_data (rs1_data_w),\\\\n    .rs2_data (rs2_data_w),\\\\n    .w_en', '    .rs1_addr (queue_rs1_addr),\\\\n    .rs2_addr (queue_rs2_addr),\\\\n    .rs3_addr (response_rs1_addr), .rs4_addr(response_rs2_addr),\\\\n    .rs1_data (queue_rs1_data),\\\\n    .rs2_data (queue_rs2_data),\\\\n    .rs3_data (response_rs1_data), .rs4_data(response_rs2_data),\\\\n    .w_en')\nf.write_text(s)\nports=['input logic clock, reset']\nfor r in range(1,5):\n ports += [f'input logic [4:0] rs{r}_addr',f'output logic [31:0] rs{r}_data']\nports += ['input logic w_en', 'input logic [4:0] w_addr','input logic [31:0] w_data']\ns='module reg_file (\\\\n  '+',\\\\n  '.join(ports)+'\\\\n);\\\\n'\ns+='  wire [31:0] words [0:31];\\\\n  wire [7:0] write_low_select;\\\\n  wire [3:0] write_high_select;\\\\n'\nfor r in range(1,5):\n s+=f'  wire [31:0] rs{r}_select, rs{r}_read;\\\\n  wire [7:0] rs{r}_low_select;\\\\n  wire [3:0] rs{r}_high_select;\\\\n  wire [31:0] rs{r}_masked [0:31], rs{r}_group [0:3];\\\\n'\ns+='''  assign words[0] = 32'b0;\n  for (genvar r = 1; r < 32; r++) begin : g_word\n    logic [31:0] word_q;\n    wire write_enable = w_en && write_high_select[r/8] && write_low_select[r%8];\n    always_ff @(posedge clock) begin\n      if (reset) word_q <= 32'b0;\n      else if (write_enable) word_q <= w_data;\n    end\n    assign words[r] = word_q;\n  end\n  for (genvar n = 0; n < 8; n++) begin : g_low_decode\n    localparam logic [2:0] LOW_ADDR = 3'(n);\n    assign write_low_select[n] = (w_addr[2:0] == LOW_ADDR);\n'''\nfor r in range(1,5):\n s+=f'    assign rs{r}_low_select[n] = (rs{r}_addr[2:0] == LOW_ADDR);\\\\n'\ns+='''  end\n  for (genvar n = 0; n < 4; n++) begin : g_high_decode\n    localparam logic [1:0] HIGH_ADDR = 2'(n);\n    assign write_high_select[n] = (w_addr[4:3] == HIGH_ADDR);\n'''\nfor r in range(1,5):\n s+=f'    assign rs{r}_high_select[n] = (rs{r}_addr[4:3] == HIGH_ADDR);\\\\n'\ns+='  end\\\\n  for (genvar n = 0; n < 32; n++) begin : g_read\\\\n'\nfor r in range(1,5):\n s+=f'    assign rs{r}_select[n] = rs{r}_high_select[n/8] && rs{r}_low_select[n%8];\\\\n    assign rs{r}_masked[n] = words[n] & {{32{{rs{r}_select[n]}}}};\\\\n'\ns+='  end\\\\n  for (genvar g = 0; g < 4; g++) begin : g_group\\\\n'\nfor r in range(1,5):\n s+=f'''    assign rs{r}_group[g] =\n        ((rs{r}_masked[g*8]   | rs{r}_masked[g*8+1]) |\n         (rs{r}_masked[g*8+2] | rs{r}_masked[g*8+3])) |\n        ((rs{r}_masked[g*8+4] | rs{r}_masked[g*8+5]) |\n         (rs{r}_masked[g*8+6] | rs{r}_masked[g*8+7]));\n'''\ns+='  end\\\\n'\nfor r in range(1,5):\n s+=f'  assign rs{r}_read = (rs{r}_group[0] | rs{r}_group[1]) | (rs{r}_group[2] | rs{r}_group[3]);\\\\n'\ns+='  always_comb begin\\\\n'\nfor r in range(1,5):\n s+=f'''    if (rs{r}_addr == 5'b0) rs{r}_data = 32'b0;\n    else if (w_en && w_addr == rs{r}_addr) rs{r}_data = w_data;\n    else rs{r}_data = rs{r}_read;\n'''\ns+='  end\\\\nendmodule\\\\n'\n(p/'reg_file.sv').write_text(s)\nPY\npython3 cores/bench/generated/r12_probe/prepare.py\nverilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+cores/bench/generated/r12_probe/rtl cores/bench/generated/r12_probe/rtl/core_pkg.sv cores/bench/generated/r12_probe/rtl/*.sv\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
