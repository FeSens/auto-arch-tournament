{"type": "item.completed", "item": {"id": "item_55", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,90p' cores/bench/rtl/id_stage.sv; tail -n 65 cores/bench/test/test_id_stage.py\"", "aggregated_output": "// rtl/id_stage.sv\n//\n// Decode stage. Combinationally drives the regfile read ports and the\n// ID/EX register's next-state from the IF/ID combinational bundle plus\n// the regfile read data. The ID/EX register is owned by this module so\n// the decoded view of instruction n is latched by end of cycle n+1.\n//\n// Latency:        1 cycle (ID/EX register clocked here).\n// RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata, insn,\n//                 trap (via ctrl.is_illegal).\nmodule id_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              hold,\n  input  logic              kill,\n  input  if_id_t  in,\n  // regfile read interface\n  output logic [4:0]        rs1_addr,\n  output logic [4:0]        rs2_addr,\n  input  logic [31:0]       rs1_data,\n  input  logic [31:0]       rs2_data,\n  // ID/EX register output\n  output id_ex_t  out\n);\n\n  // ── Combinational decode ────────────────────────────────────────────────\n  logic [4:0]  dec_alu_op;\n  logic        dec_alu_src;\n  logic [2:0]  dec_branch_op;\n  logic        dec_is_branch;\n  logic        dec_is_jump;\n  logic        dec_is_jalr;\n  logic        dec_is_lui;\n  logic        dec_is_auipc;\n  logic        dec_mem_read;\n  logic        dec_mem_write;\n  logic [1:0]  dec_mem_width;\n  logic        dec_mem_sext;\n  logic        dec_reg_write;\n  logic        dec_mem_to_reg;\n  logic        dec_is_illegal;\n\n  decoder u_decoder (\n    .instr      (in.instr),\n    .alu_op     (dec_alu_op),\n    .alu_src    (dec_alu_src),\n    .branch_op  (dec_branch_op),\n    .is_branch  (dec_is_branch),\n    .is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_to_reg (dec_mem_to_reg),\n    .is_illegal (dec_is_illegal)\n  );\n\n  logic [31:0] imm;\n  imm_gen u_imm (.instr(in.instr), .imm(imm));\n\n  // Compute both wrapping ca\n…[2652 of 5724 chars elided by tools/bench/transcript.py; sha256:a8b686ab7669e221]…\nitive/negative B/J and I immediates, including bit-1 faults.\n    for insn in (0x00208463, 0xFE208EE3, 0x002000EF, 0xFFDFF0EF,\n                 0xFFF080E7, 0x800080E7, 0x7FF080E7):\n        for pc in (0, 1, 2, 3, 0x7FFFFFFF, 0xFFFFFFFC, 0xFFFFFFFF):\n            for prediction in (0, 1):\n                for kill in (0, 1):\n                    dut.kill.value = kill\n                    getattr(dut, \"in\").value = (prediction << 65) | (pc << 33) | (insn << 1) | 1\n                    await _edge(dut)\n                    fields = _fields(int(dut.out.value))\n                    assert fields[\"imm\"] == _immediate(insn) & 0xFFFFFFFF\n                    assert fields[\"direct_recovery_pc\"] == \\\n                        (pc + (4 if prediction else _immediate(insn))) & 0xFFFFFFFF\n                    assert fields[\"valid\"] == (not kill)\n\n\ndef test_id_stage_runner():\n    run_cocotb(toplevel=\"id_stage\",\n               sources=[\"core_pkg.sv\", \"decoder.sv\", \"imm_gen.sv\", \"id_stage.sv\"],\n               test_module=\"test_id_stage\")\n", "exit_code": 0, "status": "completed"}}
