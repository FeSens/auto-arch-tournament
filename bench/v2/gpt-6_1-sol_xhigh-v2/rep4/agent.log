{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c 'tail -15 \"$TMPDIR/bench-timing.log\"; git status --short; cat cores/bench/rtl/branch_predictor.sv'","aggregated_output":"python3 -m tools.eval.gowin bench\n M cores/bench/rtl/branch_predictor.sv\n M cores/bench/rtl/core.sv\n M cores/bench/test/test_branch_predictor.py\n M cores/bench/test/test_pipeline.py\n// Eight fixed resolved-local-history agreement banks, six state bits each.\n// Fetch reads only cached agreement, with no history-to-counter lookup.\n// Word-address arithmetic drops only immediate bits known to be zero when\n// prediction is enabled, and wraps naturally at the RV32 address boundary.\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [31:0] pc,\n  input  logic [31:0] instr,\n  input  logic        train_valid,\n  // Only the hash bits are used; eligibility is checked at the core boundary.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0] train_pc,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic        train_bias,\n  input  logic        train_taken,\n  output logic        predicted_taken,\n  output logic [31:0] predicted_target\n);\n  logic legal_branch, is_jal;\n  logic [29:0] offset_word, target_word;\n  wire [2:0] fetch_index = pc[4:2] ^ pc[7:5];\n  wire [2:0] train_index = train_pc[4:2] ^ train_pc[7:5];\n  wire agreement = (train_taken == train_bias);\n  wire [7:0] disagreement_leaf;\n  wire disagreement;\n\n  for (genvar bank = 0; bank < 8; bank++) begin : g_bank\n    localparam logic [2:0] INDEX = 3'(bank);\n    logic history_q, agreement_q;\n    logic [1:0] counter0_q, counter1_q;\n    wire [1:0] candidate0, candidate1;\n    wire next0_high, next1_high;\n    // Exact two-bit saturation, independently wired for both contexts.\n    assign candidate0[1] = (counter0_q[1] & counter0_q[0]) |\n                          (agreement & (counter0_q[1] | counter0_q[0]));\n    assign candidate0[0] = (counter0_q[1] & ~counter0_q[0]) |\n                          (agreement & (counter0_q[1] | ~counter0_q[0]));\n    assign candidate1[1] = (counter1_q[1] & counter1_q[0]) |\n                          (agreement & (counter1_q[1] | counter1_q[0]));\n    assign candidate1[0] = (counter1_q[1] & ~counter1_q[0]) |\n                          (agreement & (counter1_q[1] | ~counter1_q[0]));\n    assign next0_high = history_q ? counter0_q[1] : candidate0[1];\n    assign next1_high = history_q ? candidate1[1] : counter1_q[1];\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        history_q <= 1'b0;\n        counter0_q <= 2'b11;\n        counter1_q <= 2'b11;\n        agreement_q <= 1'b1;\n      end else if (train_valid && train_index == INDEX) begin\n        history_q <= train_taken;\n        if (!history_q) counter0_q <= candidate0;\n        if (history_q) counter1_q <= candidate1;\n        // Includes the just-updated counter when the next context repeats.\n        agreement_q <= train_taken ? next1_high : next0_high;\n      end\n    end\n    assign disagreement_leaf[bank] = (fetch_index == INDEX) & ~agreement_q;\n  end\n  assign disagreement =\n      ((disagreement_leaf[0] | disagreement_leaf[1]) |\n       (disagreement_leaf[2] | disagreement_leaf[3])) |\n      ((disagreement_leaf[4] | disagreement_leaf[5]) |\n       (disagreement_leaf[6] | disagreement_leaf[7]));\n\n  always_comb begin\n    legal_branch = (instr[6:0] == 7'b1100011) &&\n                   (instr[14:12] != 3'd2 && instr[14:12] != 3'd3);\n    is_jal = (instr[6:0] == 7'b1101111);\n    predicted_taken = (pc[1:0] == 2'b00) &&\n                      ((legal_branch && (instr[31] ^ disagreement) && !instr[8]) ||\n                       (is_jal && !instr[21]));\n    offset_word = is_jal\n                ? {{12{instr[31]}}, instr[19:12], instr[20], instr[30:22]}\n                : {{20{instr[31]}}, instr[7], instr[30:25], instr[11:9]};\n    target_word = pc[31:2] + offset_word;\n    predicted_target = {target_word, 2'b00};\n  end\nendmodule\n","exit_code":0,"status":"completed"}}
