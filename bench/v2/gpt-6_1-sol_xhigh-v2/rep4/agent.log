{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"sed -n '980,1100p' cores/bench/test/test_pipeline.py; cat formal/checks_si.cfg; sed -n '1,150p' tools/eval/_slots.py; sed -n '1,100p' tools/eval/gowin.py\"", "aggregated_output": "@cocotb.test()\nasync def reset_during_divider_with_predicted_younger_fetch(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    dut.io_imemData.value = JAL(1, 8)\n    dut.io_dmemRData.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.reset.value = 0\n    program = {0: JAL(1, 8), 4: SW(0, 0, 64),\n               8: DIVU(2, 1, 0), 12: BEQ(0, 0, -4)}\n    for _ in range(20):\n        dut.clock.value = 0\n        await Timer(1, \"ns\")\n        pc = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = program.get(pc, EBREAK())\n        await Timer(4, \"ns\")\n        resetting = bool(int(dut.u_ex.u_alu.div_busy.value))\n        if resetting:\n            assert pc == 12 and int(dut.u_predictor.predicted_taken.value)\n            assert int(dut.u_id.hold.value) and int(dut.u_if.stall.value)\n            dut.reset.value = 1\n            await Timer(1, \"ns\")\n            assert not int(dut.u_ex.redirect.value)\n            assert not int(dut.u_ex.div_launch.value)\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        if resetting:\n            assert int(dut.io_imemAddr.value) == 0\n            assert int(dut.u_id.out.value) == 0\n            assert not int(dut.u_ex.u_alu.div_busy.value)\n            assert not int(dut.u_ex.u_alu.div_result_valid.value)\n            assert not int(dut.io_rvfi_valid_0.value)\n            assert int(dut.io_rvfi_order_0.value) == 0\n            break\n    else:\n        raise AssertionError(\"divider never launched before reset\")\n    rets, dmem = await _run(dut, [JAL(1, 8), SW(0, 0, 64),\n                       