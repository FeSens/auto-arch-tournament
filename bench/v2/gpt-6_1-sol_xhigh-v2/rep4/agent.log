{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef LUI (rd, imm):      return (imm & 0xFFFFF000) | ((rd & 31) << 7) | 0x37\ndef ADD (rd, rs\n…[51349 of 54421 chars elided by tools/bench/transcript.py; sha256:93726355186f61ba]…\nrs2.value) == 0\n            assert not int(dut.u_ex.u_alu.div_busy.value)\n            assert not int(dut.u_ex.u_alu.div_result_valid.value)\n            assert not int(dut.io_rvfi_valid_0.value)\n            assert int(dut.io_rvfi_order_0.value) == 0\n            break\n    else:\n        raise AssertionError(\"divider never launched before reset\")\n    rets, dmem = await _run(dut, [JAL(1, 8), SW(0, 0, 64),\n                                 ADD(2, 1, 0), EBREAK()])\n    _check_sequence(rets, [0, 8, 12])\n    assert rets[1][\"rs1_rdata\"] == rets[1][\"rd_wdata\"] == 4\n    assert not dmem\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"branch_predictor.sv\", \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py; cat cores/bench/test/test_divider_formal.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic and multiplication remain combinational. DIV/REM launch\ncaptures operands, completes on iteration edge eight, and holds its result\nuntil consumed.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_launch.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_result_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_launch.value = 1\n    await _tick(dut)\n    dut.div_launch.value = 0\n    signed = op in (ALU_DIV, ALU_REM)\n    sa, sb = a & MASK32, b & MASK32\n    if signed:\n        sa = sa if sa < 0x80000000 else sa - (1 << 32)\n        sb = sb if sb < 0x80000000 else sb - (1 << 32)\n    magnitude_a, magnitude_b = abs(sa), abs(sb)\n    # Changing inputs and attempting another launch cannot alter an\n    # accepted request. The first chunk already executed on l\n…[14227 of 17299 chars elided by tools/bench/transcript.py; sha256:a0c75d820b9892eb]…\n begin\"\n    assert source.count(clocked_block) == 1\n    source = source.replace(clocked_block, _ARITHMETIC_PROPERTIES + clocked_block)\n    scratch_root = Path(os.environ.get(\"TMPDIR\", str(core_dir / \"sim_build\")))\n    scratch_root.mkdir(parents=True, exist_ok=True)\n    with tempfile.TemporaryDirectory(prefix=\"bench-divider-proof-\", dir=scratch_root) as scratch:\n        work = Path(scratch)\n        (work / \"core_pkg.sv\").write_text((rtl_dir / \"core_pkg.sv\").read_text())\n        (work / \"divider.sv\").write_text(source)\n        proof = subprocess.run(\n            [\"yosys\", \"-Q\", \"-T\", \"-p\",\n             \"read_verilog -sv -formal core_pkg.sv divider.sv; \"\n             \"prep -top divider; flatten; chformal -lower; \"\n             \"sat -seq 1 -prove-asserts -verify -set-def-inputs -set-init-def\"],\n            cwd=work, capture_output=True, text=True, timeout=300,\n        )\n        assert proof.returncode == 0, proof.stdout + proof.stderr\n        assert \"SAT proof finished - no model found: SUCCESS!\" in proof.stdout\n", "exit_code": 0, "status": "completed"}}
