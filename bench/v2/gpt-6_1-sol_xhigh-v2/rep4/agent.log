{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/555e5898/17f8d4bf/r8-fast-add')\nfor sub in ('rtl','test'):shutil.copytree(Path('cores/bench')/sub,p/sub,dirs_exist_ok=True)\nf=p/'rtl/alu.sv';s=f.read_text()\na='  logic        [4:0]  shamt;'\nfn='''  function automatic [31:0] add_blocks(input [31:0] x, y, input cin);\n    reg [4:0] sum0 [0:7], sum1 [0:7];\n    reg [7:0] g [0:3], p [0:3];\n    reg carry;\n    integer k, level, stride;\n    begin\n      for (k = 0; k < 8; k = k + 1) begin\n        sum0[k] = {1'b0,x[k*4 +: 4]} + {1'b0,y[k*4 +: 4]};\n        sum1[k] = {1'b0,x[k*4 +: 4]} + {1'b0,y[k*4 +: 4]} + 5'd1;\n        g[0][k] = sum0[k][4];\n        p[0][k] = &sum0[k][3:0];\n      end\n      g[0][0] = g[0][0] | (p[0][0] & cin);\n      for (level = 1; level < 4; level = level + 1) begin\n        stride = 1 << (level-1);\n        for (k = 0; k < 8; k = k + 1) begin\n          if (k >= stride) begin\n            g[level][k] = g[level-1][k] | (p[level-1][k] & g[level-1][k-stride]);\n            p[level][k] = p[level-1][k] & p[level-1][k-stride];\n          end else begin\n            g[level][k] = g[level-1][k];\n            p[level][k] = p[level-1][k];\n          end\n        end\n      end\n      for (k = 0; k < 8; k = k + 1) begin\n        carry = k == 0 ? cin : g[3][k-1];\n        add_blocks[k*4 +: 4] = carry ? sum1[k][3:0] : sum0[k][3:0];\n      end\n    end\n  endfunction\n\n'''\nassert a in s\ns=s.replace(a,fn+a).replace('ALU_ADD:    out = a + b;',\\\"ALU_ADD:    out = add_blocks(a, b, 1'b0);\\\").replace('ALU_SUB:    out = a - b;',\\\"ALU_SUB:    out = add_blocks(a, ~b, 1'b1);\\\")\nf.write_text(s)\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
