{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_divider_formal.py'","aggregated_output":"\"\"\"Prove the real divider's local arithmetic invariants without ALTOPS.\n\nThe prefix identity N = Q*D + R and 0 <= R < D uniquely identify unsigned\ndivision. Proving the captured prefix and both digit stages for arbitrary bounded state\ncovers the recurrence independently of the vendored division operator.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nimport subprocess\nimport tempfile\n\n\n_ARITHMETIC_PROPERTIES = \"\"\"\n  always @* begin\n    if (magnitude_b_q != 0) begin\n      assert (prefix_remainder < magnitude_b_q);\n      assert (({32'b0, prefix_quotient} * {8'b0, magnitude_b_q}) +\n              {32'b0, prefix_remainder} == {32'b0, magnitude_a_q[31:24]});\n    end else begin\n      assert (prefix_quotient == 8'hff);\n      assert (prefix_remainder == magnitude_a_q[31:24]);\n    end\n    if (magnitude_b_q[31:8] != 0) begin\n      assert (prefix_quotient == 0);\n      assert (prefix_remainder == magnitude_a_q[31:24]);\n    end\n    if (magnitude_b_q[31:4] != 0) begin\n      assert (prefix_q_step[0] == 0);\n      assert (prefix_r_step[0] == {4'b0, magnitude_a_q[31:28]});\n    end\n    if (divisor_q[33:32] == 0 && divisor_q != 0 && remainder_q < divisor_q &&\n        triple_divisor_q == divisor_q + (divisor_q << 1)) begin\n      for (integer stage = 0; stage < 2; stage = stage + 1) begin\n        assert (remainder_step[stage+1] < divisor_q);\n        assert (divisor_q * {32'b0, digit[stage]} +\n                {2'b0, remainder_step[stage+1]} == shifted_step[stage]);\n      end\n    end\n    // Before a four-bit edge, a zero-divisor prefix has at most 28 bits.\n    if (divisor_q == 0 && triple_divisor_q == 0 && remainder_q[31:28] == 0) begin\n      assert (digit[0] == 2'd3 && digit[1] == 2'd3);\n      assert (remainder_step[2] == {remainder_q[27:0], quotient_q[31:28]});\n    end\n  end\n\"\"\"\n\n\ndef test_divider_arithmetic_invariants():\n    core_dir = Path(__file__).resolve().parents[1]\n    rtl_dir = core_dir / \"rtl\"\n    source = (rtl_dir / \"divider.sv\").read_text()\n    clocked_block = \"  always_ff @(posedge clock) begin\"\n    assert source.count(clocked_block) == 1\n    source = source.replace(clocked_block, _ARITHMETIC_PROPERTIES + clocked_block)\n    scratch_root = Path(os.environ.get(\"TMPDIR\", str(core_dir / \"sim_build\")))\n    scratch_root.mkdir(parents=True, exist_ok=True)\n    with tempfile.TemporaryDirectory(prefix=\"bench-divider-proof-\", dir=scratch_root) as scratch:\n        work = Path(scratch)\n        (work / \"core_pkg.sv\").write_text((rtl_dir / \"core_pkg.sv\").read_text())\n        (work / \"divider.sv\").write_text(source)\n        proof = subprocess.run(\n            [\"yosys\", \"-Q\", \"-T\", \"-p\",\n             \"read_verilog -sv -formal core_pkg.sv divider.sv; \"\n             \"prep -top divider; flatten; chformal -lower; \"\n             \"sat -seq 1 -prove-asserts -verify -set-def-inputs -set-init-def\"],\n            cwd=work, capture_output=True, text=True, timeout=300,\n        )\n        assert proof.returncode == 0, proof.stdout + proof.stderr\n        assert \"SAT proof finished - no model found: SUCCESS!\" in proof.stdout\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic remains combinational. MUL captures on edge one and completes\non edge two; DIV/REM completes on edge eight. Both hold until consumed.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.mul_launch.value = 0\n    dut.mul_consume.value = 0\n    dut.div_launch.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Retain exact arithmetic vectors with the operation's real handshake.\"\"\"\n    if op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        await _check_mul(dut, op, a, b, expected)\n        return\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_mul(dut, op, a, b, expected):\n    assert not int(dut.mul_busy.value)\n    assert not int(dut.mul_result_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.mul_launch.value = 1\n    await _tick(dut)\n    assert int(dut.mul_busy.value), \"missing operand capture on edge one\"\n    assert not int(dut.mul_result_valid.value), \"multiply completed before edge two\"\n    assert int(dut.mul_a_q.value) == a & MASK32\n    assert\n…[15696 of 18768 chars elided by tools/bench/transcript.py; sha256:d907a4947f5e3b26]…\n.out.value) == 15\n    dut.mul_consume.value = 1\n    dut.op.value = ALU_MULH\n    dut.a.value = 0x80000000\n    dut.b.value = 2\n    await _tick(dut)\n    dut.mul_launch.value = 0\n    dut.mul_consume.value = 0\n    assert int(dut.mul_busy.value) and not int(dut.mul_result_valid.value)\n    await _tick(dut)\n    assert int(dut.mul_result_valid.value) and int(dut.out.value) == MASK32\n    dut.mul_consume.value = 1\n    await _tick(dut)\n    dut.mul_consume.value = 0\n    # An unrelated operation is never a request for either M engine.\n    dut.op.value = ALU_ADD\n    dut.mul_launch.value = 1\n    dut.div_launch.value = 1\n    await _tick(dut)\n    assert not int(dut.mul_busy.value) and not int(dut.div_busy.value)\n    assert not int(dut.mul_result_valid.value) and not int(dut.div_result_valid.value)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
