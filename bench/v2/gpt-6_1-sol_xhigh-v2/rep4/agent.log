str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separatel\n…[12990 of 16062 chars elided by tools/bench/transcript.py; sha256:ac2326d26a6fdd81]…\npred for pc, pred in admitted if pc in (32, 36, 44)][:5] == [1] * 5\n        assert launches == [20, 24] * 3 + [92]\n        assert [r[\"rs1_rdata\"] for r in rets if r[\"pc\"] == 32] == [2, 1, 0]\n        assert [r[\"rs1_rdata\"] for r in rets if r[\"pc\"] == 20] == [2, 1, 0]\n        assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 24] == [2, 1, 0]\n        [jalr] = [r for r in rets if r[\"pc\"] == 60]\n        assert jalr[\"rs1_rdata\"] == 80 and jalr[\"rd_wdata\"] == 64\n        [added] = [r for r in rets if r[\"pc\"] == 80]\n        assert (added[\"rs1_rdata\"], added[\"rs2_rdata\"], added[\"rd_wdata\"]) == (64, 48, 112)\n        [multiply] = [r for r in rets if r[\"pc\"] == 92]\n        assert (multiply[\"rs1_rdata\"], multiply[\"rs2_rdata\"], multiply[\"rd_wdata\"]) == (112, 1, 112)\n        assert dmem == {64: 0, 68: 40, 72: 112, 76: 112}\n        assert [(a, w, r) for _, a, w, r, _ in accesses] == \\\n            [(64, 15, 0)] + [(64, 0, 1), (64, 15, 0)] * 3 \\\n            + [(68, 15, 0), (72, 15, 0), (72, 0, 1), (76, 15, 0)]\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
