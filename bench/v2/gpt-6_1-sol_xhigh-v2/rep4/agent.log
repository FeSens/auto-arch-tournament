.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\n@cocotb.test()\nasync def m_result_retained_until_memory_acceptance(dut):\n    # Exact inde\n…[13506 of 16578 chars elided by tools/bench/transcript.py; sha256:efeb4386f68ba9a2]…\nixed_multiply_load_store_branch_stalls(dut):\n1427:    \"\"\"All variants, immediate memory/control dependents and four bus modes.\"\"\"\n1459:                if int(ex.stall.value):\n1483:@cocotb.test()\n1484:async def invalid_and_wrong_path_multiply_never_launch(dut):\n1513:@cocotb.test()\n1514:async def reset_in_each_multiply_phase(dut):\n1548:                assert not int(dut.io_rvfi_valid_0.value)\n1549:                assert int(dut.io_rvfi_order_0.value) == 0\n1559:def test_pipeline_runner():\ntest/cosim/reference.py\ntest/conftest.py\ntest/cosim/main.cpp\ntest/cosim/build.sh\ntest/cosim/run_cosim.py\ntest/_helpers.py\ncores/bench/test/test_alu.py\ncores/bench/test/test_if_stage_queue.py\ncores/bench/test/test_id_stage.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_ex_stage.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_branch_predictor.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_divider_formal.py\n", "exit_code": 0, "status": "completed"}}
