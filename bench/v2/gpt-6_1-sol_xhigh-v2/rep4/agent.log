{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_branch_predictor.py'","aggregated_output":"\"\"\"Check static predecode, alignment suppression and RV32 target arithmetic.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _check(dut, pc, instr):\n    opcode = instr & 127\n    if opcode == 0x6F:\n        imm = (((instr >> 31) & 1) << 20) | (((instr >> 12) & 255) << 12) \\\n            | (((instr >> 20) & 1) << 11) | (((instr >> 21) & 1023) << 1)\n        if imm & (1 << 20):\n            imm -= 1 << 21\n        taken = not (imm & 2)\n    else:\n        imm = (((instr >> 31) & 1) << 12) | (((instr >> 7) & 1) << 11) \\\n            | (((instr >> 25) & 63) << 5) | (((instr >> 8) & 15) << 1)\n        if imm & (1 << 12):\n            imm -= 1 << 13\n        taken = opcode == 0x63 and ((instr >> 12) & 7) in (0, 1, 4, 5, 6, 7) \\\n            and imm < 0 and not (imm & 2)\n    dut.pc.value = pc\n    dut.instr.value = instr\n    await Timer(2, \"ns\")\n    assert int(dut.predicted_taken.value) == (taken and not (pc & 3))\n    # Byte-address reference deliberately reconstructs the full immediate;\n    # round down only the bits the predictor omits, then apply RV32 wrap.\n    expected = ((pc & ~3) + (imm & ~3)) & 0xFFFFFFFF\n    assert int(dut.predicted_target.value) == expected, (hex(pc), hex(instr), hex(expected))\n\n\n@cocotb.test()\nasync def exhaustive_branch_offsets_and_reserved_encodings(dut):\n    rng = random.Random(0xB7F)\n    pcs = (0, 4, 0xFFFFFFFC, 0x80000000, 0x7FFFFFFC)\n    for imm in range(-4096, 4096, 2):\n        for funct3 in range(8):\n            bits = imm & 8191\n            instr = (((bits >> 12) & 1) << 31) | (((bits >> 11) & 1) << 7) \\\n                | (((bits >> 5) & 63) << 25) | (((bits >> 1) & 15) << 8) \\\n                | (rng.randrange(32) << 20) | (rng.randrange(32) << 15) | (funct3 << 12) | 0x63\n            await _check(dut, pcs[(imm // 2 + funct3) % len(pcs)], instr)\n    for alignment in (1, 2, 3):\n        await _check(dut, 0x100 + alignment, 0xFE000EE3)  # BEQ x0,x0,-4\n\n\n@cocotb.test()\nasync def jal_offsets_and_sequential_opcodes(dut):\n    rng = random.Random(0x1A1)\n    offsets = [-1048576, -1048574, -8, -4, -2, 0, 2, 4, 8, 1048572, 1048574]\n    offsets += [sign * (1 << bit) for bit in range(1, 20) for sign in (-1, 1)]\n    offsets += [rng.randrange(-524288, 524288) * 2 for _ in range(2000)]\n    for imm in offsets:\n        bits = imm & 0x1FFFFF\n        instr = (((bits >> 20) & 1) << 31) | (((bits >> 12) & 255) << 12) \\\n            | (((bits >> 11) & 1) << 20) | (((bits >> 1) & 1023) << 21) \\\n            | (rng.randrange(32) << 7) | 0x6F\n        for pc in (0, 0xFFFFFFFC, rng.getrandbits(32)):\n            await _check(dut, pc, instr)\n    for opcode in range(128):\n        if opcode in (0x63, 0x6F):\n            continue\n        for _ in range(16):\n            await _check(dut, rng.getrandbits(32), (rng.getrandbits(32) & ~127) | opcode)\n\n\ndef test_branch_predictor_runner():\n    run_cocotb(toplevel=\"branch_predictor\", sources=[\"branch_predictor.sv\"],\n               test_module=\"test_branch_predictor\")\n","exit_code":0,"status":"completed"}}
