nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suf\n…[6306 of 9378 chars elided by tools/bench/transcript.py; sha256:068914e5d6f39e9a]…\nR: could not create a work dir under $RISCV_FORMAL/cores\" >&2\n88:    NRET=$(CORE_YAML=\"$CORE_YAML\" python3 -c '\n92:    print(int(d.get(\"nret\", 2)))\n96:    if [ \"$NRET\" = \"1\" ]; then\n99:        echo \"[run_all.sh] auto-detected nret=1 from $CORE_YAML; using wrapper_si.sv + checks_si.cfg\"\n114:if [ ! -d \"$RISCV_FORMAL\" ]; then\n120:# OSS CAD Suite for consistent yosys / sby / bitwuzla. Homebrew yosys\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n198:# going past per-check errors so the .sby tally below sees every result\n199:# (NRET=2 means a few `_ch1` checks may PREUNSAT-error on single-issue\n208:for sby_file in *.sby; do\n209:    name=\"${sby_file%.sby}\"\n214:        # Vacuous pass on channel-1 checks. NRET=2 contract: when a\n229:    FAILED+=(\"no_checks_generated\")\n94:WARN  (PR1014) : Generic routing resource will be used to clock signal 'clock_d' by the specified constraint. And then it may lead to the excessive delay or skew\n", "exit_code": 0, "status": "completed"}}
