{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/555e5898/378d9cd2/r14-branch')\nf=p/'cores/bench/rtl/ex_stage.sv';s=f.read_text();s=s.replace('''      assign branch_eq[i*3+j] = branch_source_a[i] == branch_source_b[j];\n      assign branch_lt[i*3+j] = branch_source_a[i] < branch_source_b[j];''','''      if (i == j && i \"'!= 0) begin : same_bypass\n        assign branch_eq[i*3+j] = 1'\"'b1;\n        assign branch_lt[i*3+j] = 1'b0;\n      end else if (i == 2 && j == 1) begin : reversed_bypass\n        assign branch_eq[i*3+j] = branch_eq[5];\n        assign branch_lt[i*3+j] = \"'!branch_eq[5] && !branch_lt[5];\n      end else begin : distinct_sources\n        assign branch_eq[i*3+j] = branch_source_a[i] == branch_source_b[j];\n        assign branch_lt[i*3+j] = branch_source_a[i] < branch_source_b[j];\n      end'\"''');f.write_text(s)\nf=p/'cores/bench/test/test_ex_stage.py';s=f.read_text(); pos=s.index('\\\\ndef test_ex_stage_runner')\ns=s[:pos]+'''\n@cocotb.test()\nasync def branch_predicates_before_bypass_independent_reference(dut):\n    import random\n    rng = random.Random(0x14C0)\n    await _reset(dut)\n    directed = (0, 1, 0x7fffffff, 0x80000000, 0xffffffff, 0x55555555, 0xaaaaaaaa)\n    def signed(value):\n        return value if value < (1 << 31) else value - (1 << 32)\n    for n in range(120):\n        words = ([directed[(n+i) % len(directed)] for i in range(4)] if n < 28\n                 else [rng.getrandbits(32) for _ in range(4)])\n        if n % 5 == 0: words[3] = words[2]\n        for sa in range(3):\n            for sb in range(3):\n                a = (words[0], words[2], words[3])[sa]\n                b = (words[1], words[2], words[3])[sb]\n                for op in range(8):\n                    dut.fwd_rs1_sel.value = sa\n                    dut.fwd_rs2_sel.value = sb\n                    dut.fwd_ex_mem.value = words[2]\n                    dut.fwd_mem_wb.value = words[3]\n                    dut[\\\"in\\\"].value = _control_payload(a=words[0], b=words[1],\n                        pc=4, imm=8, branch=True, branch_op=op)\n                    await Timer(1, \\\"ns\\\")\n                    expected = {0:a == b, 1:a \"'!= b, 4:signed(a) < signed(b),\n                        5:signed(a) >= signed(b), 6:a < b, 7:a >= b}.get(op, False)\n                    assert bool(dut.branch_cond.value) == expected, (n,sa,sb,op,a,b)\n                    assert bool(dut.direct_redirect.value) == expected\n'\"''' +s[pos:]; f.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
