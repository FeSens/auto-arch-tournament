e next0_high, next1_high;\n+    // Exact two-bit saturation, independently wired for both contexts.\n+    assign candidate0[1] = (counter0_q[1] & counter0_q[0]) |\n+                          (agreement & (counter0_q[1] | counter0_q[0]));\n+    assign candidate0[0] = (counter0_q[1] & ~counter0_q[0]) |\n+                          (agreement & (counter0_q[1] | ~counter0_q[0]));\n+    assign candidate1[1] = (count\n…[11291 of 14363 chars elided by tools/bench/transcript.py; sha256:b564a3af928284dc]…\nssert jalr[\"rs1_rdata\"] == 53 and jalr[\"pc_next\"] == 52\n        [added] = _by_insn(rets, ADD(7, 1, 3))\n        assert added[\"rs1_rdata\"] == 4 and added[\"rs2_rdata\"] == 20\n        assert added[\"rd_wdata\"] == 24\n        assert dmem == {64: 24}\n        assert [(a, w, r) for _, a, w, r, _ in accesses] == [(64, 15, 0)]\n        if seed is None:\n            assert all(rets[i + 1][\"cycle\"] - rets[i][\"cycle\"] == 1 for i in range(5))\n            assert rets[7][\"cycle\"] - rets[6][\"cycle\"] == 2\n\n\n@cocotb.test()\nasync def static_reserved_and_misaligned_controls(dut):\n    for taken in (False, True):\n        # Both signs of the omitted immediate bit must suppress prediction.\n        program = [ADDI(1, 0, int(taken)),\n                   _b(-4, 0, 0, 2, 0x63), _b(-4, 0, 0, 3, 0x63),\n                   _b(-2, 1, 0, 1, 0x63), _b(2, 1, 0, 1, 0x63),\n                   JAL(2, -2), JAL(3, 2), ADDI(4, 0, 2), JALR(5, 4, 0),\n                   _i(0, 0, 1, 6, 0x67), ADD(7, 2, 3), SW(7, 0, 64), EBREAK()]\n        for seed in (None, 91):\n", "exit_code": 0, "status": "completed"}}
