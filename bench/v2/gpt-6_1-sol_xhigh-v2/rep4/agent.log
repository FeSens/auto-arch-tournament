{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/555e5898/0816cfd6')\nfor bits,shift in ((4,0),(5,7)):\n out=root/f'r9_agree{1<<bits}'/'rtl';shutil.copytree('cores/bench/rtl',out,dirs_exist_ok=True)\n p=out/'branch_predictor.sv';s=p.read_text();s=s.replace('  input  logic [31:0] pc,','  input logic clock, reset, update_valid, update_agrees,\\\\n  input logic [31:0] update_pc,\\\\n  input  logic [31:0] pc,')\n ix=f'pc[{bits+1}:2]'+(f' \"'^ pc[{shift+bits-1}:{shift}]'\"' if shift else '')\n ux=f'update_pc[{bits+1}:2]'+(f' \"'^ update_pc[{shift+bits-1}:{shift}]'\"' if shift else '')\n code=f'''  logic [{bits-1}:0] pending_index_q;\n  logic pending_valid_q, pending_agrees_q;\n  wire [{bits-1}:0] lookup_index = {ix};\n  wire [{(1<<bits)-1}:0] disagree;\n  wire invert_prediction = |disagree;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pending_valid_q <= 1'b0;\n      pending_index_q <= '0;\n      pending_agrees_q <= 1'b0;\n    end else begin\n      pending_valid_q <= update_valid;\n      pending_index_q <= {ux};\n      pending_agrees_q <= update_agrees;\n    end\n  end\n  for (genvar n = 0; n < {1<<bits}; n++) begin : agreement_word\n    logic [1:0] counter_q;\n    wire selected = pending_valid_q && pending_index_q == {bits}'(n);\n    always_ff @(posedge clock) begin\n      if (reset) counter_q <= 2'b11;\n      else if (selected) begin\n        if (pending_agrees_q) begin\n          if (counter_q \"'!= 2'\"'b11) counter_q <= counter_q + 2'd1;\n        end else begin\n          if (counter_q \"'!= 2'\"'b00) counter_q <= counter_q - 2'd1;\n        end\n      end\n    end\n    assign disagree[n] = \"'!counter_q[1] && (lookup_index == {bits}'\"'(n));\n  end\n'''\n s=s.replace('  always_comb begin',code+'\\\\n  always_comb begin',1).replace('legal_branch && instr[31] && \"'!instr[8]'\"','legal_branch && (instr[31] \"'^ invert_prediction) && !instr[8]'\"');p.write_text(s)\n p=out/'ex_stage.sv';s=p.read_text().replace('  output logic               redirect,','  output logic               predictor_update_valid,\\\\n  output logic [31:0]        predictor_update_pc,\\\\n  output logic               predictor_update_agrees,\\\\n  output logic               redirect,')\n s=s.replace('  // ── EX/MEM register', '''  assign predictor_update_valid = in.valid && \"'!reset && !stall && !divider_wait &&\n                                  in.ctrl.is_branch && !in.ctrl.is_illegal &&\n                                  in.pc[1:0] == 2'\"'b00 && \"'!in.imm[1];\n  assign predictor_update_pc = in.pc;\n  assign predictor_update_agrees = branch_taken == in.instr[31];\n\n  // ── EX/MEM register'\"''');p.write_text(s)\n p=out/'core.sv';s=p.read_text().replace('  logic        decode_ready;','  logic        decode_ready;\\\\n  logic predictor_update_valid, predictor_update_agrees;\\\\n  logic [31:0] predictor_update_pc;')\n s=s.replace('  branch_predictor u_predictor (','  branch_predictor u_predictor (\\\\n    .clock(clock), .reset(reset),\\\\n    .update_valid(predictor_update_valid), .update_agrees(predictor_update_agrees),\\\\n    .update_pc(predictor_update_pc),')\n s=s.replace('    .redirect        (redirect),\\\\n    .redirect_target (redirect_target)\\\\n  );','    .predictor_update_valid(predictor_update_valid),\\\\n    .predictor_update_pc(predictor_update_pc),\\\\n    .predictor_update_agrees(predictor_update_agrees),\\\\n    .redirect        (redirect),\\\\n    .redirect_target (redirect_target)\\\\n  );');p.write_text(s)\n print('Created isolated agreement predictor',1<<bits)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
