{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,os\nroot=Path(os.environ['TMPDIR'])/'r10-prefix-prototype'\n(root/'rtl').mkdir(parents=True,exist_ok=True)\n(root/'test').mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,root/'rtl'/p.name)\nfor p in Path('cores/bench/test').glob('*.py'): shutil.copy2(p,root/'test'/p.name)\np=root/'rtl/divider.sv'\ns=p.read_text()\ns=s.replace('// Shared RV32M divider: magnitude capture, eight-bit prefix initialization,','// Shared RV32M divider: nibble capture, eight-bit prefix initialization,')\ns=s.replace('  logic [31:0] magnitude_a, magnitude_b;', '  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [31:0] magnitude_a;\\\\n  /* verilator lint_on UNUSEDSIGNAL */\\\\n  logic [31:0] magnitude_b;\\\\n  wire neg_a = signed_op && a[31];\\\\n  wire neg_b = signed_op && b[31];\\\\n  wire [3:0] raw_prefix_a = neg_a ? ((~a[31:28]) + {3\\\\'b0, (a[27:0] == 0)}) : a[31:28];\\\\n  wire [3:0] raw_prefix_b = neg_b ? (4\\\\'b0 - b[3:0]) : b[3:0];\\\\n  wire small_divisor = neg_b ? ((&b[31:4]) && (|b[3:0])) : \"'!(|b[31:4]);'\"')\ns=s.replace('  // Q holds the untouched dividend before initialization. Captured D feeds\\\\n  // only edge two; the recurrence\\\\'s whole odd-multiple bank starts there.\\\\n  wire [31:0] magnitude_a_q = quotient_q;', '  // Launch consumes the first nibble; edge two consumes the next nibble.\\\\n  // The recurrence\\\\'s whole odd-multiple bank still starts on edge two.')\ns=s.replace('  wire [3:0] nibble_quotient = (|prefix_divisor[7:4]) ? 4\\\\'b0 : nibble_q;\\\\n  wire [3:0] nibble_remainder = (|prefix_divisor[7:4])\\\\n                              ? magnitude_a_q[31:28] : nibble_r;\\\\n  wire [7:0] prefix_trial = {nibble_remainder, magnitude_a_q[27:24]};','  wire [3:0] nibble_quotient = small_divisor ? nibble_q : 4\\\\'b0;\\\\n  wire [3:0] nibble_remainder = small_divisor ? nibble_r : raw_prefix_a;\\\\n  wire [7:0] prefix_trial = {remainder_q[3:0], quotient_q[31:28]};')\ns=s.replace('  assign prefix_x = {magnitude_b_q[3:0], magnitude_a_q[31:28]};','  assign prefix_x = {raw_prefix_b, raw_prefix_a};')\ns=s.replace('  assign prefix_quotient = (|magnitude_b_q[31:8]) ? 8\\\\'b0\\\\n                        : {nibble_quotient, prefix_digit};\\\\n  assign prefix_remainder = (|magnitude_b_q[31:8]) ? magnitude_a_q[31:24]\\\\n                         : (prefix_oct_r[0] | prefix_oct_r[1]);','  assign prefix_quotient = {quotient_q[3:0], (|magnitude_b_q[31:8]) ? 4\\\\'b0 : prefix_digit};\\\\n  assign prefix_remainder = (|magnitude_b_q[31:8]) ? prefix_trial\\\\n                         : (prefix_oct_r[0] | prefix_oct_r[1]);')\ns=s.replace('// Edge one captures magnitudes and metadata only: zero bits consumed.','// Edge one captures normalized state after consuming four bits.')\ns=s.replace('        quotient_q <= magnitude_a;\\\\n        remainder_q <= 32\\\\'b0;','        quotient_q <= {magnitude_a[27:0], nibble_quotient};\\\\n        remainder_q <= {28\\\\'b0, nibble_remainder};')\ns=s.replace('quotient_q <= {magnitude_a_q[23:0], prefix_quotient};','quotient_q <= {quotient_q[27:4], prefix_quotient};')\nassert 'magnitude_a_q' not in s\np.write_text(s)\nt=root/'test/test_alu.py'\ns=t.read_text()\ns=s.replace('bits_consumed = 0 if edge == 1 else 4 * edge', 'bits_consumed = 4 if edge == 1 else 4 * edge')\nt.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
