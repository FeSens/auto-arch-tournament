{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,os\nroot=Path(os.environ['TMPDIR'])/'r10-compare-prototype';(root/'rtl').mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,root/'rtl'/p.name)\ns=(root/'rtl/divider.sv').read_text()\nfunctions='''\n  // Parallel nibble comparisons with balanced lexicographic reduction.\n  // These decide fit independently from the native low-result subtractors.\n  function automatic ge12(input [11:0] x, input [11:0] y);\n    reg [2:0] gt, eq;\n    reg upper_gt, upper_eq;\n    begin\n      for (integer i=0;i<3;i=i+1) begin\n        gt[i] = x[4*i+:4] > y[4*i+:4];\n        eq[i] = x[4*i+:4] == y[4*i+:4];\n      end\n      upper_gt = gt[2] | (eq[2] & gt[1]);\n      upper_eq = eq[2] & eq[1];\n      ge12 = upper_gt | (upper_eq & (gt[0] | eq[0]));\n    end\n  endfunction\n  function automatic ge36(input [35:0] x, input [35:0] y);\n    reg [8:0] gt, eq;\n    reg [3:0] pair_gt, pair_eq;\n    reg [1:0] quad_gt, quad_eq;\n    reg eight_gt, eight_eq;\n    begin\n      for (integer i=0;i<9;i=i+1) begin\n        gt[i] = x[4*i+:4] > y[4*i+:4];\n        eq[i] = x[4*i+:4] == y[4*i+:4];\n      end\n      for (integer i=0;i<4;i=i+1) begin\n        pair_gt[i] = gt[2*i+1] | (eq[2*i+1] & gt[2*i]);\n        pair_eq[i] = eq[2*i+1] & eq[2*i];\n      end\n      for (integer i=0;i<2;i=i+1) begin\n        quad_gt[i] = pair_gt[2*i+1] | (pair_eq[2*i+1] & pair_gt[2*i]);\n        quad_eq[i] = pair_eq[2*i+1] & pair_eq[2*i];\n      end\n      eight_gt = quad_gt[1] | (quad_eq[1] & quad_gt[0]);\n      eight_eq = quad_eq[1] & quad_eq[0];\n      ge36 = gt[8] | (eq[8] & (eight_gt | eight_eq));\n    end\n  endfunction\n'''\ns=s.replace('  always_comb begin\\\\n    signed_op',functions+'\\\\n  always_comb begin\\\\n    signed_op',1)\ns=s.replace('wire [12:0] prefix_difference [1:15];','wire [7:0] prefix_difference [1:15];')