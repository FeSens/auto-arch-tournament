 node.func.id == \"_check\" and len(node.args) == 5 and\n                isinstance(node.args[1], ast.Name) and node.args[1].id in CONSTANTS):\n            op = CONSTANTS[node.args[1].id]\n            a, b, expected = (ast.literal_eval(n) for n in node.args[2:])\n            literal_vectors.append((op, a, b, expected))\n   \n…[14904 of 17976 chars elided by tools/bench/transcript.py; sha256:a6d53959aa698efa]…\n           dut.fwd_mem_wb.value = 0x87654321\n                await _tick(dut)\n                assert not int(dut.indirect_landing_q.value)\n                assert int(dut.indirect_target_q.value) == retained_target\n                dut.stall.value = 0\n    # Reset has priority on the capture edge and on the landing edge.\n    for after_capture in (False, True):\n        dut.fwd_rs1_sel.value = 0\n        dut[\"in\"].value = _control_payload(a=0x201, jump=True, jalr=True)\n        if after_capture:\n            await _tick(dut)\n            assert int(dut.indirect_landing_q.value)\n        dut.reset.value = 1\n        await Timer(1, \"ns\")\n        assert not int(dut.redirect.value)\n        await _tick(dut)\n        assert not int(dut.indirect_landing_q.value)\n        assert int(dut.indirect_target_q.value) == 0\n        dut.reset.value = 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"cat formal/run_all.sh; rg -n 'pytest|cocotb|def test_|multiply|ex_mem|hold|replay' cores/bench/test/test_pipeline.py tools/eval/gowin.py\"", "aggregated_output": "#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env vars (orchestrator-driven, override $1 and defaults):\n#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n# When BOTH are unset, the script auto-detects nret from\n# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n# invoking `bash formal/run_all.sh` directly therefore get the\n# right wrapper without needing to know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[20420 of 23492 chars elided by tools/bench/transcript.py; sha256:d583871017e07266]…\n\ncores/bench/test/test_pipeline.py:1860:        aliases, replay = [], []\ncores/bench/test/test_pipeline.py:1863:            if int(dut.u_hazard.multiply_use_hazard.value):\ncores/bench/test/test_pipeline.py:1864:                replay.append(cycle)\ncores/bench/test/test_pipeline.py:1868:                if int(dut.u_ex.mem_is_multiply.value):\ncores/bench/test/test_pipeline.py:1874:        assert aliases and not replay\ncores/bench/test/test_pipeline.py:1892:@cocotb.test()\ncores/bench/test/test_pipeline.py:1893:async def multiply_unused_illegal_fields_preserve_raw_metadata(dut):\ncores/bench/test/test_pipeline.py:1898:        replay = []\ncores/bench/test/test_pipeline.py:1901:            if int(dut.u_hazard.multiply_use_hazard.value):\ncores/bench/test/test_pipeline.py:1902:                replay.append(cycle)\ncores/bench/test/test_pipeline.py:1913:        assert not replay and dmem == {64: 63}\ncores/bench/test/test_pipeline.py:1916:def test_pipeline_runner():\ncores/bench/test/test_pipeline.py:1917:    run_cocotb(\n", "exit_code": 0, "status": "completed"}}
