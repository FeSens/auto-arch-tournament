{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_id_stage.py; cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Check the raw ID/EX payload capture boundary independently of validity.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _fields(value):\n    fields = {}\n    for name, width in ((\"valid\", 1), (\"instr\", 32), (\"ctrl\", 22),\n                        (\"rs2_addr\", 5), (\"rs1_addr\", 5), (\"rd\", 5),\n                        (\"imm\", 32), (\"rs2_val\", 32), (\"rs1_val\", 32), (\"pc\", 32),\n                        (\"predicted_taken\", 1), (\"direct_recovery_pc\", 32)):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    assert value == 0\n    return fields\n\n\nasync def _edge(dut):\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n    dut.clock.value = 1\n    await Timer(2, \"ns\")\n    dut.clock.value = 0\n    await Timer(2, \"ns\")\n\n\n@cocotb.test()\nasync def raw_capture_kill_readiness_hold_and_reset(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.hold.value = 0\n    dut.kill.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.rs1_data.value = 0\n    dut.rs2_data.value = 0\n    await _edge(dut)\n    assert int(dut.out.value) == 0\n    dut.reset.value = 0\n    rng = random.Random(0x1DE0)\n    # Writing ALU, load, store, divide, branch, jumps and illegal payloads.\n    instructions = (0x06308093, 0x00012183, 0x00312223, 0x0220C1B3,\n                    0x00208463, 0x008001EF, 0x000081E7, 0xFFFFFFFF)\n    for insn in instructions:\n        for ready in (0, 1):\n            for kill in (0, 1):\n                pc, rs1, rs2 = (rng.getrandbits(32) for _ in range(3))\n                prediction = rng.getrandbits(1)\n                getattr(dut, \"in\").value = (prediction << 65) | (pc << 33) | (insn << 1) | ready\n                dut.rs1_data.value = rs1\n                dut.rs2_data.value = rs2\n                dut.kill.value = kill\n                dut.hold.value = 0\n                await Timer(1, \"ns\")\n                assert int(dut.rs1_addr.value) == (insn >> 15) & 31\n                assert int(dut.rs2_addr.value) == (insn >> 20) & 31\n    \n…[16212 of 19284 chars elided by tools/bench/transcript.py; sha256:e5b2a78df66c5578]…\n           dut.fwd_mem_wb.value = 0x87654321\n                await _tick(dut)\n                assert not int(dut.indirect_landing_q.value)\n                assert int(dut.indirect_target_q.value) == retained_target\n                dut.stall.value = 0\n    # Reset has priority on the capture edge and on the landing edge.\n    for after_capture in (False, True):\n        dut.fwd_rs1_sel.value = 0\n        dut[\"in\"].value = _control_payload(a=0x201, jump=True, jalr=True)\n        if after_capture:\n            await _tick(dut)\n            assert int(dut.indirect_landing_q.value)\n        dut.reset.value = 1\n        await Timer(1, \"ns\")\n        assert not int(dut.redirect.value)\n        await _tick(dut)\n        assert not int(dut.indirect_landing_q.value)\n        assert int(dut.indirect_target_q.value) == 0\n        dut.reset.value = 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
