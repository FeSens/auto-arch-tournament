{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nroot=Path(os.environ['TMPDIR'])/'r10-prefix-prototype'\np=root/'proof';p.mkdir(exist_ok=True)\ns=(root/'rtl/divider.sv').read_text().split('  always_ff @(posedge clock) begin')[0]\ns+='''\n  assign quotient_q = {magnitude_a[27:0], nibble_quotient};\n  assign remainder_q = {28'b0, nibble_remainder};\n  assign magnitude_b_q = magnitude_b;\n  wire [7:0] ref_q [0:8], ref_r [0:8];\n  assign ref_q[0] = 0;\n  assign ref_r[0] = 0;\n  for (genvar j=0; j<8; j++) begin : ref_bit\n    wire [7:0] trial = {ref_r[j][6:0], magnitude_a[31-j]};\n    wire [8:0] diff = {1'b0,trial} - {1'b0,magnitude_b[7:0]};\n    wire fits = \"'!(|magnitude_b[31:8]) && !diff[8];\n    assign ref_r[j+1] = fits ? diff[7:0] : trial;\n    assign ref_q[j+1] = {ref_q[j][6:0],fits};\n  end\n  always @* begin\n    assert(raw_prefix_a == magnitude_a[31:28]);\n    assert(raw_prefix_b == magnitude_b[3:0]);\n    assert(small_divisor == !(|magnitude_b[31:4]));\n    assert(prefix_quotient == ref_q[8]);\n    assert(prefix_remainder == ref_r[8]);\n  end\nendmodule\n'\"'''\n(p/'divider.sv').write_text(s)\n(p/'core_pkg.sv').write_text((root/'rtl/core_pkg.sv').read_text())\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
