{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/test/test_alu.py\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic remains combinational. MUL captures on edge one and completes\non edge two; DIV/REM completes on edge eight. Both hold until consumed.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.mul_launch.value = 0\n    dut.mul_consume.value = 0\n    dut.div_launch.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Retain exact arithmetic vectors with the operation's real handshake.\"\"\"\n    if op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        await _check_mul(dut, op, a, b, expected)\n        return\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_mul(dut, op, a, b, expected):\n    assert not int(dut.mul_busy.value)\n    assert not int(dut.mul_result_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.mul_launch.value = 1\n    await _tick(dut)\n    assert int(dut.mul_busy.value), \"missing operand capture on edge one\"\n    assert not int(dut.mul_result_valid.value), \"multiply completed before edge two\"\n    assert int(dut.mul_a_q.value) == a & MASK32\n    assert\n…[3067 of 6139 chars elided by tools/bench/transcript.py; sha256:665b2e73eafe9a7e]…\nt.div_launch.value = 1\n        await _tick(dut)\n        assert int(dut.div_result_valid.value)\n        assert not int(dut.div_busy.value)\n        assert int(dut.out.value) == actual, \"held result changed\"\n    dut.div_launch.value = 0\n    dut.div_consume.value = 1\n    await _tick(dut)\n    dut.div_consume.value = 0\n    assert not int(dut.div_result_valid.value)\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)              # -1 < 0\n", "exit_code": 0, "status": "completed"}}
