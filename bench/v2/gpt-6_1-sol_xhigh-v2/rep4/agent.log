at downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[5108 of 8180 chars elided by tools/bench/transcript.py; sha256:01471bb192fcd45b]…\normal/cores/bench-wuKFUl6B2/mem_stage.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/alu.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/if_stage.sv\nformal/riscv-formal/bus/rvfi_bus_util.sv\nformal/riscv-formal/bus/rvfi_bus_axi4.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/status\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/status.sqlite\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/src/insn_and.v\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/src/insn_and_ch0.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/src/rvfi_macros.vh\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/src/rvfi_insn_check.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/src/rvfi_channel.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/src/defines.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/src/rvfi_testbench.sv\nformal/riscv-formal/cores/bench-wuKFUl6B2/checks/insn_and_ch0/logfile.txt\n/opt/gowin\n", "exit_code": 0, "status": "completed"}}
