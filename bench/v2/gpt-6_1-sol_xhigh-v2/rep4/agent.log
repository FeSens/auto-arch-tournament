{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/predictor_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\ndef edit(name,old,new):\n    p=rtl/name\n    s=p.read_text()\n    assert old in s,(name,old)\n    p.write_text(s.replace(old,new))\nedit('core_pkg.sv','    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;','    logic [31:0] instr;\\\\n    logic        predicted_taken;\\\\n    logic        valid;\\\\n  } if_id_t;')\nedit('core_pkg.sv','    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;','    logic [31:0] instr;\\\\n    logic        predicted_taken;\\\\n    logic        valid;\\\\n  } id_ex_t;')\nedit('id_stage.sv','      reg_q.pc       <= in.pc;','      reg_q.predicted_taken <= in.predicted_taken;\\\\n      reg_q.pc       <= in.pc;')\nedit('if_stage.sv','  input  logic [31:0]       redirect_target,','  input  logic [31:0]       redirect_target,\\\\n  input  logic              predicted_taken,\\\\n  input  logic [31:0]       predicted_target,')\nedit('if_stage.sv',\\\"    next_pc = redirect ? redirect_target : pc + 32'd4;\\\",\\\"    next_pc = predicted_taken ? predicted_target : pc + 32'd4;\\\")\nedit('if_stage.sv','    out.pc    = pc;','    out.predicted_taken = predicted_taken;\\\\n    out.pc    = pc;')\nedit('ex_stage.sv','  output logic               divider_wait,','  output logic               divider_wait,\\\\n  output logic               predict_train_valid,\\\\n  output logic [31:0]        predict_train_pc,\\\\n  output logic               predict_train_taken,')\nedit('ex_stage.sv',\\\"  assign redirect        = in.valid && \"'!stall && !reset &&'\"\\\\n                           (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"\\\\n  assign redirect_target = in.ctrl.is_jump