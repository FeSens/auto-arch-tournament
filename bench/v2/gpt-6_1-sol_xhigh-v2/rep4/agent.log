{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1000,1050p' cores/bench/test/test_pipeline.py; sed -n '1240,1310p' cores/bench/test/test_pipeline.py; sed -n '190,260p' cores/bench/test/test_ex_stage.py; sed -n '1,100p' tools/eval/gowin.py; cat test/cosim/build.sh\"", "aggregated_output": "        assert dependent[\"rd_wdata\"] == quotient + value\n        assert dmem == {64: value, 68: quotient, 72: 0xDEADBEEF}\n        assert [(addr, wen, ren) for _, addr, wen, ren, _ in accesses] == [\n            (64, 15, 0), (68, 15, 0), (68, 0, 1),\n        ]\n\n\n@cocotb.test()\nasync def invalid_load_use_payloads_replay_once(dut):\n    \"\"\"An invalid captured dependent load must not become a new hazard.\"\"\"\n    for case in range(160):\n        rng = random.Random(0x10AD000 + case)\n        base = (case % 4) * 8\n        a, b, c, d, e = [base + i for i in range(1, 6)]\n        value = rng.randrange(1, 1000)\n        program = [\n            ADDI(b, 0, 7), LW(a, 0, 64), LW(a, a, 0),\n            ADD(c, a, b), DIVU(d, c, b), SW(d, 0, 68),\n            LW(e, 0, 68), ADD(a, e, c), EBREAK(),\n        ]\n        accesses = []\n        rets, dmem = await _run(dut, program, {64: 128, 128: value},\n                                max_cycles=300,\n                                stall_seed=None if case == 0 else 0x10AD000 + case,\n                                accesses=accesses)\n        _check_sequence(rets, list(range(0, len(program) * 4, 4)))\n        [first] = _by_insn(rets, LW(a, 0, 64))\n        [second] = _by_insn(rets, LW(a, a, 0))\n        assert first[\"rd_wdata\"] == 128\n        assert second[\"rs1_rdata\"] == 128 and second[\"rd_wdata\"] == value\n        [added] = _by_insn(rets, ADD(c, a, b))\n        assert added[\"rs1_rdata\"] == value and added[\"rs2_rdata\"] == 7\n        assert added[\"rd_wdata\"] == value + 7\n        quotient = (value + 7) // 7\n        _check_div_retirement(rets, DIVU(d, c, b), value + 7, 7, quotient)\n        [last] = _by_insn(rets, ADD(a, e, c))\n        assert last[\"rs1_rdata\"] == quotient and last[\"rs2_rdata\"] == value + 7\n        assert last[\"rd_wdata\"] == quotient + value + 7\n        if case == 0:\n            # Ready-high replay introduces exactly one slot per dependency.\n            assert second[\"cycle\"] - first[\"cycle\"] == 2\n            assert added[\"cycle\"] - second[\"cycle\"] == 2\n        assert dmem == {64: 128, 128: \n…[11951 of 15023 chars elided by tools/bench/transcript.py; sha256:6afdfead5bac0466]…\nRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n", "exit_code": 0, "status": "completed"}}
