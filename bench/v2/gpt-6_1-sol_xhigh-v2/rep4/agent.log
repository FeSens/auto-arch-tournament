{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"sed -n '1890,1960p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\n\n@cocotb.test()\nasync def multiply_unused_illegal_fields_preserve_raw_metadata(dut):\n    illegal = (3 << 20) | (3 << 15) | (3 << 7) | 0x7F\n    program = [ADDI(1, 0, 7), ADDI(2, 0, 9), MUL(3, 1, 2), illegal,\n               SW(3, 0, 64), EBREAK()]\n    for seed in (None, 0x111E6A1):\n        replay = []\n\n        def observe(cycle, pc, ri, rd):\n            if int(dut.u_hazard.multiply_use_hazard.value):\n                replay.append(cycle)\n\n        rets, dmem = await _run(dut, program, stall_seed=seed, observe=observe)\n        assert [r[\"pc\"] for r in rets] == list(range(0, 24, 4))\n        assert [r[\"order\"] for r in rets] == list(range(6))\n        assert [r[\"trap\"] for r in rets] == [0, 0, 0, 1, 0, 0]\n        assert [r[\"pc_next\"] for r in rets[:-1]] == list(range(4, 24, 4))\n        _check_raw_registers(rets)\n        assert rets[3][\"rs1_rdata\"] == rets[3][\"rs2_rdata\"] == 63\n        assert rets[3][\"rd\"] == rets[3][\"rd_wdata\"] == 0\n        assert rets[3][\"mem_wmask\"] == rets[3][\"mem_rmask\"] == 0\n        assert not replay and dmem == {64: 63}\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"branch_predictor.sv\", \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"multiplier.sv\", \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n","exit_code":0,"status":"completed"}}
