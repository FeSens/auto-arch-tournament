{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.cosim import run_one\nfrom tools.eval.fpga import validate_coremark_uart\nimport subprocess,json\nwt=Path.cwd();probe=wt/'cores/bench/generated/r12_final';sim=str(probe/'obj_dir/cosim_sim');programs=Path('/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep4/bench/programs')\ncases=[(elf,flags) for elf in programs.glob('*.elf') if elf.name\"'!='\"'coremark.elf' for flags in [(),('--istall','--dstall')]]\nwith ThreadPoolExecutor(max_workers=8) as pool:r=list(pool.map(lambda x:run_one(x[0],sim,str(wt),sim_flags=x[1]),cases))\nprint(json.dumps(r,indent=2),flush=True)\nx=subprocess.run([sim,str(programs/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,timeout=120);m=json.loads(x.stdout.splitlines()[-1]);valid,reason=validate_coremark_uart(m.get('uart',''),10)\nres={'traces':r,'coremark':{'rc':x.returncode,'ebreak':m.get('ebreak'),'oob':m.get('oob'),'bench_bracketed':m.get('bench_bracketed'),'valid':valid,'reason':reason,'cycles':m.get('bench_stop_cycle',0)-m.get('bench_start_cycle',0)}}\n(probe/'validation.json').write_text(json.dumps(res,indent=2));print(json.dumps(res['coremark'],indent=2),flush=True)\nassert all(y['passed'] for y in r)\nassert x.returncode==0 and valid and m.get('ebreak') and not m.get('oob') and m.get('bench_bracketed')\nassert res['coremark']['cycles']==4052037\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
