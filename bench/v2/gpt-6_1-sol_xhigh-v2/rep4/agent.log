always_comb begin\n    selected_eq = |(branch_row_eq & branch_sel_a);\n    selected_lt = |(branch_row_lt & branch_sel_a);\n    selected_signed_lt = (rs1[31] \"'!= rs2[31]) ? rs1[31] : selected_lt;\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = selected_eq;\n      BR_BNE:  branch_cond = !selected_eq;\n      BR_BLT:  branch_cond = selected_signed_lt;\n      BR_BGE:  branch_cond = !selected_signed_lt;\n      BR_BLTU: branch_cond = selected_lt;\n      BR_BGEU: branch_cond = !selected_lt;\n      default: branch_cond = 1'\"'b0;\n    endcase\n'''\ns=s[:insert]+code+s[end:]; f.write_text(s)\nprint(p)\nPY\npython /srv/hwebench/tmp/555e5898/378d9cd2/probe_branch.py\npython - <<'PY'\nfrom pathlib import Path\nimport subprocess\nr=Path('/srv/hwebench/tmp/555e5898/378d9cd2/r14-branch/cores/bench/rtl')\nsrc=[r/'core_pkg.sv']+sorted(f for f in r.glob('*.sv') if f.name\"'!='\"'core_pkg.sv')\np=subprocess.run(['verilator','--lint-only','-Wall','-Wno-MULTITOP','-sv','+incdir+'+str(r),*map(str,src)],capture_output=True,text=True)\nprint(p.stdout+p.stderr); print('lint exit',p.returncode)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
