{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/555e5898/2e8eeb41/r5s0_bypass')\np.mkdir(exist_ok=True)\nshutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',p/'test',dirs_exist_ok=True)\nf=p/'rtl/forward_unit.sv'\nf.write_text('''module forward_unit (\n  input logic clock, reset,\n  input logic hold_id, stall_ex_mem,\n  input logic [4:0] if_id_rs1, if_id_rs2,\n  input logic [4:0] id_ex_rd,\n  input logic id_ex_w_en,\n  input logic [4:0] ex_mem_rd,\n  input logic ex_mem_w_en,\n  output logic [1:0] fwd_rs1, fwd_rs2\n);\n  logic rs1_match_m, rs1_match_w, rs2_match_m, rs2_match_w;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      rs1_match_m <= 0; rs1_match_w <= 0;\n      rs2_match_m <= 0; rs2_match_w <= 0;\n    end else if (\"'!hold_id) begin\n      rs1_match_m <= id_ex_w_en && id_ex_rd != 0 && id_ex_rd == if_id_rs1;\n      rs2_match_m <= id_ex_w_en && id_ex_rd != 0 && id_ex_rd == if_id_rs2;\n      rs1_match_w <= ex_mem_w_en && ex_mem_rd != 0 && ex_mem_rd == if_id_rs1;\n      rs2_match_w <= ex_mem_w_en && ex_mem_rd != 0 && ex_mem_rd == if_id_rs2;\n    end else if (!stall_ex_mem) begin\n      rs1_match_w <= rs1_match_m && ex_mem_w_en;\n      rs2_match_w <= rs2_match_m && ex_mem_w_en;\n      rs1_match_m <= 0; rs2_match_m <= 0;\n    end\n  end\n  assign fwd_rs1 = rs1_match_m ? 2'\"'d1 : (rs1_match_w ? 2'd2 : 2'd0);\n  assign fwd_rs2 = rs2_match_m ? 2'd1 : (rs2_match_w ? 2'd2 : 2'd0);\nendmodule\n''')\ne=p/'rtl/ex_stage.sv';s=e.read_text().replace('  output logic               divider_wait,','  output logic               divider_wait,\\\\n  output logic               next_bypass_w_en,')\ns=s.replace('  // Legal aligned direct controls use','  assign next_bypass_w_en = in.valid && ctrl_with_trap.reg_write && \"'!divider_wait;'\"\\\\n\\\\n  // Legal aligned direct controls use')\ne.