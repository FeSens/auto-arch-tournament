 2), BEQ(5, 0, 8),\n            SW(1, 0, 72), REM(6, 1, 3), SW(6, 3, 4), EBREAK(),\n        ]\n        accesses = []\n        rets, dmem = await _run(dut, program, {64: 1}, stall_seed=seed,\n                                accesses=accesses)\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_if_stage_queue.py\"", "aggregated_output": "\"\"\"Independent deque model for acquisition, fall-through and recovery.\"\"\"\nfrom collections import deque\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n@cocotb.test()\nasync def queue_matches_independent_deque(dut):\n    rng = random.Random(0xF37C4)\n    queue = deque()\n    pc = 0\n    coverage = set()\n    controls = set()\n    steps = 0\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.imem_ready.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.predicted_taken.value = 0\n    dut.predicted_target.value = 0\n    dut.imem_data.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n    async def step(ready, hold, *, reset=False, correction=False, taken=None):\n        nonlocal pc, steps\n        steps += 1\n        # Fresh random response values also exercise changing unready data.\n        instr = rng.getrandbits(32)\n        prediction = bool(rng.getrandbits(1)) if taken is None else taken\n        target = rng.getrandbits(30) << 2\n        redirect_pc = rng.getrandbits(30) << 2\n        before = len(queue)\n        coverage.add((before, bool(ready), bool(hold), bool(reset), bool(correction)))\n        dut.clock.value = 0\n        dut.reset.value = reset\n        dut.stall.value = hold\n        dut.imem_ready.value = ready\n        dut.redirect.value = correction\n        dut.redirect_target.value = redirect_pc\n        dut.predicted_taken.value = prediction\n        dut.predicted_target.value = target\n        dut.imem_data.value = instr\n        await Timer(5, unit=\"ns\")\n\n        assert int(dut.imem_addr.value) == pc\n        assert int(dut.count_q.value) == before\n        available = bool(queue) or ready\n        assert int(dut.decode_ready.value) == available\n        selected = queue[0] if queue else (pc, instr, prediction)\n        expected = (int(selected[2]) << 65) | (selected[0] << 33) \\\n                 | (selected[1] << 1) | int(available)\n        assert int(dut.out.value) == expected,\n…[2170 of 5242 chars elided by tools/bench/transcript.py; sha256:b9dc66ab6f4eeedf]…\n      await step(True, True, taken=True)\n    for _ in range(8):\n        await step(True, True, taken=True)\n    for _ in range(12):\n        await step(True, False, taken=True)\n    for _ in range(5):\n        await step(False, False)\n\n    while steps < 5000:\n        await step(rng.random() >= 0.22, rng.random() < 0.5,\n                   reset=rng.random() < 0.025, correction=rng.random() < 0.075)\n    for occupancy in range(5):\n        for ready in (False, True):\n            for hold in (False, True):\n                for reset, correction in ((False, False), (True, False),\n                                          (False, True), (True, True)):\n                    assert (occupancy, ready, hold, reset, correction) in coverage\n    assert controls == {\"bypass\", \"capture\", \"full_hold\", \"full_refill\",\n                        \"queued_unready\", \"queued_ready\"}\n\n\ndef test_if_stage_queue_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n               test_module=\"test_if_stage_queue\")\n", "exit_code": 0, "status": "completed"}}
