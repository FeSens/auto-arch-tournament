{"type": "item.started", "item": {"id": "item_57", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('/srv/hwebench/tmp/555e5898/17f8d4bf/r8-onehot')\np=Path('/srv/hwebench/tmp/555e5898/17f8d4bf/r8-predecode')\nfor sub in ('rtl','test'):shutil.copytree(src/sub,p/sub,dirs_exist_ok=True)\nf=p/'rtl/forward_unit.sv';s=f.read_text()\ns=s.replace('  input  logic       id_is_auipc,','  input  logic [4:0] id_alu_op,\\\\n  input  logic       id_is_jump,\\\\n  input  logic       id_is_auipc,')\ns=s.replace('  output logic [3:0] alu_a_sel,','  output logic [13:0] result_sel,\\\\n  output logic [3:0] alu_a_sel,')\ns=s.replace(\\\"      fwd_rs1 <= 3'b001;\\\", \\\"      result_sel <= 14'b1;\\\\n      fwd_rs1 <= 3'b001;\\\",1)\ns=s.replace('      fwd_rs1 <= next_rs1;', '''      for (integer k = 0; k < 11; k = k + 1)\n        result_sel[k] <= \"'!id_is_jump && (id_alu_op == 5'\"'(k));\n      result_sel[11] <= \"'!id_is_jump && (id_alu_op >= ALU_MUL && id_alu_op <= ALU_MULHSU);\n      result_sel[12] <= !id_is_jump && (id_alu_op >= ALU_DIV && id_alu_op <= ALU_REMU);\n      result_sel[13] <= id_is_jump;\n      fwd_rs1 <= next_rs1;'\"''')\nf.write_text(s)\nf=p/'rtl/id_stage.sv';s=f.read_text()\ns=s.replace('  output logic              decoded_is_auipc,','  output logic [4:0]        decoded_alu_op,\\\\n  output logic              decoded_is_jump,\\\\n  output logic              decoded_is_auipc,')\ns=s.replace('  assign decoded_is_auipc', '  assign decoded_alu_op = dec_alu_op;\\\\n  assign decoded_is_jump = dec_is_jump;\\\\n  assign decoded_is_auipc',1);f.write_text(s)\nf=p/'rtl/core.sv';s=f.read_text().replace('  logic [3:0] alu_a_sel, alu_b_sel;','  logic [13:0] result_sel;\\\\n  logic [4:0] decoded_alu_op;\\\\n  logic decoded_is_jump;\\\\n  logic [3:0] alu_a_sel, alu_b_sel;')\ns=s.replace('    .decoded_is_auipc(decoded_is_auipc),','    .decoded_alu_op(decoded_alu_op),\\\\n    .decoded_is_jump(decoded_is_jump),