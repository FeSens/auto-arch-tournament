{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,210p' cores/bench/test/test_ex_stage.py\"", "aggregated_output": "\"\"\"Exercise M completion when EX/MEM acceptance is explicitly blocked.\n\nThe full core drains older memory before launch, so its ordinary bus model\ncannot create a new downstream hold during an isolated M request. Drive the\nexisting EX memory-hold input directly to cover that handshake independently.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nMASK = 0xFFFFFFFF\nID_FIELDS = ((\"prediction\", 1), (\"pc\", 32), (\"a\", 32), (\"b\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1\", 5), (\"rs2\", 5),\n             (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1))\nMEM_FIELDS = ((\"pc\", 32), (\"result\", 32), (\"write_data\", 32),\n              (\"rd\", 5), (\"rs1\", 5), (\"rs2\", 5), (\"a\", 32), (\"b\", 32),\n              (\"pc_next\", 32), (\"taken\", 1), (\"target\", 32),\n              (\"ctrl\", 22), (\"instr\", 32), (\"valid\", 1))\n\n\ndef _payload(op, a=0, b=0, valid=True, illegal=False, pc=4):\n    values = dict(pc=pc, a=a, b=b, rd=3, rs1=1, rs2=2,\n                  ctrl=(op << 17) | (0 if illegal else 4) | int(illegal),\n                  instr=(1 << 25) | (2 << 20) | (1 << 15) | (3 << 7) | 0x33,\n                  valid=int(valid))\n    packed = 0\n    for name, width in ID_FIELDS:\n        packed = (packed << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return packed\n\n\ndef _out(dut):\n    value = int(dut.out.value)\n    fields = {}\n    for name, width in reversed(MEM_FIELDS):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    assert value == 0\n    return fields\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut[\"in\"].value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\n@cocotb.test()\nasync def m_result_retained_until_memory_acceptance(dut):\n    # Exact inde\n…[2694 of 5766 chars elided by tools/bench/transcript.py; sha256:d8374519e2bf50b5]…\nick(dut)\n            assert not _out(dut)[\"valid\"]\n            assert not int(busy.value) and not int(complete.value)\n\n\n@cocotb.test()\nasync def invalid_or_illegal_m_opcode_has_no_request(dut):\n    await _reset(dut)\n    for op in range(11, 19):\n        for valid, illegal in ((False, False), (False, True), (True, True)):\n            dut[\"in\"].value = _payload(op, MASK, 0, valid=valid, illegal=illegal)\n            for _ in range(3):\n                await _tick(dut)\n                assert not int(dut.mul_launch.value) and not int(dut.div_launch.value)\n                assert not int(dut.u_alu.mul_busy.value) and not int(dut.u_alu.div_busy.value)\n                assert not int(dut.u_alu.mul_result_valid.value)\n                assert not int(dut.u_alu.div_result_valid.value)\n                assert not int(dut.divider_wait.value)\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
