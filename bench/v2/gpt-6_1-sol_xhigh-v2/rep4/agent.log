   in,\\\\n  input  logic [1:0] direct_redirect_mask,')\ns=s.replace('  logic direct_taken, control_accept, indirect_accept;','  logic control_accept, indirect_accept;')\ns=s.replace('''  assign direct_taken = (branch_target[1:0] == 2'b00) && \"'!in.ctrl.is_illegal &&\n                        (branch_taken || (in.ctrl.is_jump && !in.ctrl.is_jalr));'\"''','')\ns=s.replace('assign direct_redirect = control_accept && (direct_taken \"'^ in.predicted_taken);'\"','assign direct_redirect = control_accept &&\\\\n                           (branch_cond ? direct_redirect_mask[1] : direct_redirect_mask[0]);');f.write_text(s)\nf=p/'cores/bench/test/test_ex_stage.py';s=f.read_text()\ns=s.replace('def _payload(op,','def _payload(dut, op,').replace('= _payload(', '= _payload(dut, ')\ns=s.replace('    values = dict(pc=pc, a=a, b=b, rd=3,','    dut.direct_redirect_mask.value = 0\\\\n    values = dict(pc=pc, a=a, b=b, rd=3,')\ns=s.replace('def _control_payload(*,','def _control_payload(dut, *,').replace('= _control_payload(', '= _control_payload(dut, ')\ns=s.replace('    control = (branch_op << 13)', '''    aligned = ((pc + imm) & 3) == 0\n    bj = bool(jump and not jalr and not illegal and aligned)\n    bb = bool(branch and not illegal and aligned)\n    dut.direct_redirect_mask.value = (int(bool(prediction) \"'^ bool(bj or bb)) << 1) | int(bool(prediction) ''^ bj)\n    control = (branch_op << 13)'\"''')\ns=s.replace('    dut.stall.value = 0\\\\n    dut[\\\"in\\\"].value = 0','    dut.stall.value = 0\\\\n    dut.direct_redirect_mask.value = 0\\\\n    dut[\\\"in\\\"].value = 0')\nf.write_text(s)\nprint(p)\nPY\npython /srv/hwebench/tmp/555e5898/378d9cd2/probe_recovery.py\npython - <<'PY'\nfrom pathlib import Path\nimport subprocess\nr=Path('/srv/hwebench/tmp/555e5898/378d9cd2/r14-recovery/cores/bench/rtl')\nsrc=[r/'core_pkg.sv']+sorted(f for f in r.glob('*.sv') if f.name\"'!='\"'core_pkg.sv')\np=subprocess.run(['verilator','--lint-only','-Wall','-Wno-MULTITOP','-sv','+incdir+'+str(r),*map(str,src)],capture_output=True,text=True)\nprint(p.stdout+p.stderr);print('lint exit',p.returncode)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
