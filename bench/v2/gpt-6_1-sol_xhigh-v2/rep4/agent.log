{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/forward_unit.sv cores/bench/rtl/hazard_unit.sv cores/bench/test/test_pipeline.py'", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Operand forwarding. For each rs in the EX-stage's source list, picks\n// where the freshest value lives:\n//   00 (NONE)    : ID/EX register's rs?_val (= regfile read of one cycle ago)\n//   01 (EX_MEM)  : the in-flight ALU result from the EX/MEM register\n//   10 (MEM_WB)  : the WB-stage's regfile-write data\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic [4:0] id_ex_rs1,\n  input  logic [4:0] id_ex_rs2,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [1:0] fwd_rs1,\n  output logic [1:0] fwd_rs2\n);\n\n  // Yosys's Verilog frontend rejects SV-style `function … return …`,\n  // so the per-rs selection is open-coded in two always_comb blocks.\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs1) fwd_rs1 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs1) fwd_rs1 = 2'd2;\n    else                                                                  fwd_rs1 = 2'd0;\n  end\n\n  always_comb begin\n    if      (ex_mem_w_en && ex_mem_rd != 5'b0 && ex_mem_rd == id_ex_rs2) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 2'd2;\n    else                                                                  fwd_rs2 = 2'd0;\n  end\n\nendmodule\n// rtl/hazard_unit.sv\n//\n// Detects the only data hazard the textbook 5-stage doesn't cover via\n// forwarding: load-use. A LOAD in EX produces its data only after MEM,\n// so an instruction immediately behind that consumes the LOAD's rd\n// must be stalled by exactly one cycle.\n//\n// Downstream memory/divider backpressure holds both ID/EX payload and\n// validity. Load-use holds only the PC and kills the newly captured slot,\n// so the load advances and its dependent is replayed on the next edge.\n// An \n…[46858 of 49930 chars elided by tools/bench/transcript.py; sha256:9b60ccb054d579ef]…\nout.value) == 0\n            assert not int(dut.u_ex.u_alu.div_busy.value)\n            assert not int(dut.u_ex.u_alu.div_result_valid.value)\n            assert not int(dut.io_rvfi_valid_0.value)\n            assert int(dut.io_rvfi_order_0.value) == 0\n            break\n    else:\n        raise AssertionError(\"divider never launched before reset\")\n    rets, dmem = await _run(dut, [JAL(1, 8), SW(0, 0, 64),\n                                 ADD(2, 1, 0), EBREAK()])\n    _check_sequence(rets, [0, 8, 12])\n    assert rets[1][\"rs1_rdata\"] == rets[1][\"rd_wdata\"] == 4\n    assert not dmem\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"branch_predictor.sv\", \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
