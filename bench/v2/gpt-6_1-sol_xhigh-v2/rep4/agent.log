/core_state.c:164:            case 2: /* int */\nbench/programs/coremark/core_state.c:168:            case 3: /* float */\nbench/programs/coremark/core_state.c:169:            case 4: /* float */\nbench/programs/coremark/core_state.c:173:            case 5: /* scientific */\nbench/programs/coremark/core_state.c:174:            case 6: /* scientific */\nbench/programs/coremark/core_state.c:178:      \n…[1845 of 4917 chars elided by tools/bench/transcript.py; sha256:6ed03defd0d203e1]…\nist_join.c:77:    if (optype) /* if cached, use cache */\nbench/programs/coremark/core_list_join.c:80:    {                             /* otherwise calculate and cache the result */\nbench/programs/coremark/core_list_join.c:81:        ee_s16 flag = data & 0x7; /* bits 0-2 is type of function to perform */\nbench/programs/coremark/core_list_join.c:84:               & 0xf);       /* bits 3-6 is specific data for the operation */\nbench/programs/coremark/core_list_join.c:85:        dtype |= dtype << 4; /* replicate the lower 4 bits to get an 8b value */\nbench/programs/coremark/core_list_join.c:89:                if (dtype < 0x22) /* set min period for bit corruption */\nbench/programs/coremark/core_list_join.c:111:        *pdata = (data & 0xff00) | 0x0080 | retval; /* cache the result */\nbench/programs/coremark/core_list_join.c:115:/* Function: cmp_complex\nbench/programs/coremark/core_list_join.c:119:*/\nbench/programs/coremark/core_list_join.c:128:/* Function: cmp_idx\nbench/programs/coremark/core_list_join.c:132:*/\n", "exit_code": 0, "status": "completed"}}
