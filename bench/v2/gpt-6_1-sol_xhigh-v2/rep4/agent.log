{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nprobe=Path('/srv/hwebench/tmp/555e5898/806fbb2b/operand_boundary_probe')\n(probe/'probe_cases.py').write_text('''import cocotb\nfrom test_pipeline import _run, ADDI, ADD, LW, SW, DIV, JAL, JALR, ECALL, EBREAK\n\n@cocotb.test()\nasync def killed_payload_has_no_effect(dut):\n    payloads=[ADDI(1,0,-7),LW(1,0,64),SW(2,0,64),DIV(1,1,2),JALR(1,1,0),ECALL(),EBREAK(),0xffffffff]\n    for payload in payloads:\n        for seed in range(32):\n            accesses=[]\n            program=[ADDI(1,0,17),ADDI(2,0,3),JAL(0,8),payload,ADDI(3,1,5),SW(3,0,64),EBREAK()]\n            rets,mem=await _run(dut,program,stall_seed=seed,accesses=accesses)\n            assert [r['pc'] for r in rets]==[0,4,8,16,20,24]\n            assert [r['order'] for r in rets]==list(range(6))\n            assert all(not r['trap'] for r in rets)\n            assert rets[3]['rs1_rdata']==17 and rets[3]['rd_wdata']==22\n            assert mem=={64:22}\n            assert len(accesses)==1 and accesses[0][1:4]==(64,15,0)\n            for a,b in zip(rets,rets[1:]): assert a['pc_next']==b['pc']\n\n@cocotb.test()\nasync def invalid_load_use_copy_cannot_forward(dut):\n    for seed in range(64):\n        accesses=[]\n        program=[ADDI(1,0,17),LW(2,0,64),ADD(3,2,1),ADDI(4,3,3),SW(4,0,68),EBREAK()]\n        rets,mem=await _run(dut,program,{64:7},stall_seed=seed,accesses=accesses)\n        assert [r['pc'] for r in rets]==[0,4,8,12,16,20]\n        assert [r['order'] for r in rets]==list(range(6))\n        assert rets[2]['rs1_rdata']==7 and rets[2]['rs2_rdata']==17 and rets[2]['rd_wdata']==24\n        assert rets[3]['rs1_rdata']==24 and rets[3]['rd_wdata']==27\n        assert mem=={64:7,68:27}\n        assert len(accesses)==2\n''')\n(probe/'run_extra.py').write_text('''import sys\nfrom pathlib import Path\nfrom cocotb_tools.runner import get_runner\nprobe=Path('/srv/hwebench/tmp/555e5898/806fbb2b/operand_boundary_probe')\nsys.path.insert(0,str(Path.cwd()/'cores/bench/test'))\nsys.path.insert(0,str(probe))\nrunner=get_runner('verilator')\nrunner.test(hdl_toplevel='core', test_module='probe_cases', test_dir=probe, build_dir=probe/'sim_build', results_xml=probe/'extra.xml')\n''')\nprint('Prepared 320 adversarial stalled instruction sequences.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
