{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' tools/eval/gowin.py; sed -n '1,180p' cores/bench/test/_helpers.py; rg -n 'timing|gowin|build_dir|RTL_DIR|NRET|unit|pytest' Makefile tools/eval/fpga.py tools/eval/gowin.py fpga -g '*.py' -g '*.sh' -g '*.sv'\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[12823 of 15895 chars elided by tools/bench/transcript.py; sha256:b2008387a814146a]…\ntools.eval import gowin\ntools/eval/fpga.py:30:    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\ntools/eval/fpga.py:323:    res = gowin.build_all(worktree, rtl, _bench_sv(worktree, target), gen)\ntools/eval/fpga.py:324:    summ = gowin.summarize(res)\ntools/eval/fpga.py:332:    Vendor place-and-route (tools/eval/gowin.py) for Fmax and area, and the\ntools/eval/fpga.py:340:        'fmax_mhz': float,               — median over gowin.PLACE_OPTIONS\ntools/eval/fpga.py:361:    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\ntools/eval/fpga.py:363:    fp = gowin.summarize(results)\nfpga/core_bench_si.sv:38:  // Single-channel RVFI port set (NRET=1 contract). Connected for\nfpga/bench_stall_gen.sv:13:// That logic then saved simulated cycles at no area or timing cost. With\nfpga/core_bench.sv:13://      forwarding muxes all stay in the netlist for timing.\nfpga/core_bench.sv:59:  // 2-channel RVFI port set (NRET=2 contract). Connected for elaboration\nfpga/scripts/nextpnr_run.sh:26:  --timing-allow-fail \\\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json\nfrom pathlib import Path\nfor line in Path('cores/bench/experiments/log.jsonl').read_text().splitlines():\n d=json.loads(line)\n if d['id']=='hyp-20261001-001-r2s0':\n  h=d['hypothesis']; print(h.get('hypothesis') if isinstance(h,dict) else h); print(d.get('implementation_notes',''))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json\nfrom pathlib import Path\nfor line in Path('cores/bench/experiments/log.jsonl').read_text().splitlines():\n d=json.loads(line)\n if d['id']=='hyp-20261001-001-r2s0':\n  h=d['hypothesis']; print(h.get('hypothesis') if isinstance(h,dict) else h); print(d.get('implementation_notes',''))\nPY\"","aggregated_output":"Replace each of the existing four 33-bit restoring trial subtractors\nwith an explicitly segmented carry-select subtractor. Keep the restoring\nalgorithm, four quotient bits per edge, first chunk on launch, eight\niteration edges, and sticky result-valid/consume protocol unchanged.\nThis is a local combinational arithmetic optimization; do not add stages,\nalter pipeline backpressure, or change the divider's completion latency.\n\nPartition the low 32 bits into four 8-bit blocks. For each block j,\nindependently compute the 9-bit unsigned differences Xj-Dj and Xj-Dj-1,\nrepresenting incoming borrow zero and one. All operands must be explicitly\nzero-extended before subtraction. Define block borrow-generate Gj as\nbit 8 of Xj-Dj and borrow-propagate Pj as Xj==Dj. With B0=0, compute\nevery incoming block borrow directly with a balanced prefix network:\nB1=G0; B2=G1|(P1&G0); B3=G2|(P2&G1)|(P2&P1&G0);\nB4=G3|(P3&G2)|(P3&P2&G1)|(P3&P2&P1&G0).\nSelect each block's low eight difference bits using Bj. The divisor's\nbit 32 is zero, so difference[32]=X[32]^B4 exactly reproduces the original\n33-bit modular subtraction, including its sign/underflow decision.\nRetain the existing choice between shifted remainder and difference\nusing difference[32], and the existing quotient-bit construction.\nAvoid a serial four-block borrow recurrence or a fresh full-width\nsubtract in parallel with the segmented network; either would defeat\nthe intended shortening of the timing path.\n\nThe full-width carry chain becomes parallel short native carry chains,\na small borrow-prefix network, and block muxes. Apply this same helper\nat all four restoring steps so both launch and busy feedback paths\nbenefit. Keep signed magnitude normalization and final sign correction\nas they are. Preserve divide-by-zero, INT_MIN/-1, unsigned high-bit\noperands, and signed remainder semantics. Preserve the ALTOPS formulas\nand their existing eight-edge handshake exactly. Keep nret=1, all traps,\nin-order retirement, memory side effects, and bus-ready handling intact.\n\nValidate subtraction against an independent 33-bit arithmetic reference,\nespecially borrow propagation through equal blocks and across bit 31.\nRun the existing ALU and pipeline tests, formal ALTOPS gate, and cosim;\nextend actual DIV/DIVU/REM/REMU vectors around byte boundaries and use\nseeded random signed and unsigned operands. ALTOPS alone cannot validate\nthe real arithmetic. Measure median Gowin Fmax times canonical stalled,\nmarker-bracketed CoreMark iterations/cycle. Marked cycles should remain\nidentical to the champion's 4,491,485 for ten iterations. The expected\ngain is from Fmax, with some additional LUTs and routing as the main risk;\nacceptance still requires more than 4.6% measured fitness improvement.\n\nA standalone bit-accurate model of the specified block arithmetic passed\n101,682 comparisons against independent 33-bit subtraction and 43,364\nRV32M quotient/remainder comparisons against independent integer\narithmetic. These include directed block boundaries, both values of the\nshifted remainder's top bit, random operands, zero divisors, and signed\noverflow. This verifies the proposed equations, not implementing RTL\nor FPGA timing; the predicted fitness gain remains unmeasured.\n\n\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport tempfile, shutil, json\nroot=Path.cwd()\np=Path(tempfile.mkdtemp(prefix='radix16_',dir='/srv/hwebench/tmp/555e5898/70573578'))\nshutil.copytree(root/'cores/bench/rtl',p/'rtl')\nshutil.copytree(root/'cores/bench/test',p/'test')\ns=(p/'rtl/divider.sv').read_text()\ns=s.replace('logic [33:0] divisor_q, triple_divisor_q;', 'logic [33:0] divisor_q;')\na=s.index('  logic [33:0] double_divisor;')\nb=s.index('\\\\n  always_comb begin',a)\ns=s[:a]+'''  logic [35:0] odd_mult_q [0:7], odd_next [0:7];\n  logic [35:0] shifted_radix16;\n  logic [35:0] multiples [0:15];\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [36:0] difference [0:15];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [16:0] fit;\n  logic [15:0] select_digit;\n  logic [31:0] masked [0:15], merged [0:7], merged2 [0:3], merged3 [0:1];\n  logic [31:0] next_remainder, next_quotient;\n  logic [3:0] quotient_digit;\n  logic [35:0] d36;\n  function automatic [35:0] add3(input logic [35:0] x, y, z);\n    reg [35:0] sum_bits, carry_bits;\n    begin\n      sum_bits = x \"'^ y ''^ z;\n      carry_bits = ((x & y) | (x & z) | (y & z)) << 1;\n      add3 = sum_bits + carry_bits;\n    end\n  endfunction\n  assign d36 = {4'\"'b0, magnitude_b_q};\n  assign odd_next[0] = d36;\n  assign odd_next[1] = (d36 << 1) + d36;\n  assign odd_next[2] = (d36 << 2) + d36;\n  assign odd_next[3] = add3(d36 << 2, d36 << 1, d36);\n  assign odd_next[4] = (d36 << 3) + d36;\n  assign odd_next[5] = add3(d36 << 3, d36 << 1, d36);\n  assign odd_next[6] = add3(d36 << 3, d36 << 2, d36);\n  assign odd_next[7] = (d36 << 4) - d36;\n''' + s[b:]\na=s.index('  always_comb begin\\\\n    double_divisor =')\nb=s.index('\\\\n  always_comb begin\\\\n    result =',a)\nblock='''  assign shifted_radix16 = {remainder_q, quotient_q[31:28]};\n  assign fit[0] = 1'b1;\n  assign fit[16] = 1'b0;\n  assign multiples[0] = 36'b0;\n  assign difference[0] = {1'b0, shifted_radix16};\n'''\nfor k in range(1,16):\n t=(k & -k).bit_length()-1\n odd=k>>t\n block+=f'  assign multiples[{k}] = odd_mult_q[{(odd-1)//2}] << {t};\\\\n'\n block+=f\\\"  assign difference[{k}] = {{1'b0, shifted_radix16}} - {{1'b0, multiples[{k}]}};\\\\n\\\"\n block+=f'  assign fit[{k}] = \"'!difference[{k}][36];'\"\\\\n'\nblock+='''  for (genvar k = 0; k < 16; k++) begin : radix16_select\n    assign select_digit[k] = fit[k] && \"'!fit[k+1];\n    assign masked[k] = difference[k][31:0] & {32{select_digit[k]}};\n  end\n  for (genvar k = 0; k < 8; k++) begin : radix16_merge1\n    assign merged[k] = masked[2*k] | masked[2*k+1];\n  end\n  for (genvar k = 0; k < 4; k++) begin : radix16_merge2\n    assign merged2[k] = merged[2*k] | merged[2*k+1];\n  end\n  for (genvar k = 0; k < 2; k++) begin : radix16_merge3\n    assign merged3[k] = merged2[2*k] | merged2[2*k+1];\n  end\n  assign next_remainder = merged3[0] | merged3[1];\n'\"'''\nfor bit in range(4):\n terms=[f'select_digit[{k}]' for k in range(16) if (k>>bit)&1]\n block+=f'  assign quotient_digit[{bit}] = '+ ' | '.join(terms)+';\\\\n'\nblock+='  assign next_quotient = {quotient_q[27:0], quotient_digit};\\\\n'\ns=s[:a]+block+s[b:]\ns=s.replace(\\\"      triple_divisor_q <= 34'b0;\\\", \\\"      for (int k=0; k<8; k++) odd_mult_q[k] <= 36'b0;\\\")\ns=s.replace(\\\"          triple_divisor_q <= {2'b0, magnitude_b_q} + {1'b0, magnitude_b_q, 1'b0};\\\", \\\"          for (int k=0; k<8; k++) odd_mult_q[k] <= odd_next[k];\\\")\ns=s.replace('quotient_step[2]', 'next_quotient').replace('remainder_step[2]', 'next_remainder')\n(p/'rtl/divider.sv').write_text(s)\n(p/'build_timing.py').write_text('''import json,sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build,summarize\np=Path(sys.argv[1]); root=Path(sys.argv[2])\nresults=[]\nfor option in (0,1,2):\n r=build(root,p/'rtl','fpga/core_bench_si.sv',option,p/f'gowin_p{option}')\n results.append(r); print(json.dumps(r),flush=True)\n (p/'timing_results.json').write_text(json.dumps(results,indent=2))\n if r['placement_failed']: break\nif len(results)==3: print(json.dumps(summarize(results)),flush=True)\n''')\nprint(p)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
