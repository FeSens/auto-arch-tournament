{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/r12_final');(p/'test').mkdir(exist_ok=True)\nfor f in Path('cores/bench/test').glob('*.py'):shutil.copy2(f,p/'test'/f.name)\nf=p/'test/reg_file_fixture.sv';f.write_text('''module reg_file_fixture(input logic clock,reset,w_en,input logic [4:0] rs1_addr,rs2_addr,w_addr,input logic [31:0] w_data,output logic [31:0] rs1_data,rs2_data);\n wire [15:0] rs1_low_select,rs2_low_select;\n for(genvar r=0;r<16;r++)begin\n assign rs1_low_select[r]=rs1_addr[3:0]==4'(r);\n assign rs2_low_select[r]=rs2_addr[3:0]==4'(r);\n end\n reg_file dut_rf(.*);\nendmodule\n''')\nf=p/'test/test_reg_file.py';s=f.read_text().replace('toplevel=\\\"reg_file\\\"','toplevel=\\\"reg_file_fixture\\\"').replace('sources=[\\\"reg_file.sv\\\"]','sources=[\\\"reg_file.sv\\\",\\\"../test/reg_file_fixture.sv\\\"]');f.write_text(s)\nf=p/'test/test_if_stage_queue.py';s=f.read_text().replace('        assert int(dut.out.value) == expected, (steps, before, selected)','        assert int(dut.out.value) == expected, (steps, before, selected)\\\\n        assert int(dut.rs1_low_select.value) == 1 << ((selected[1] >> 15) & 15)\\\\n        assert int(dut.rs2_low_select.value) == 1 << ((selected[1] >> 20) & 15)');f.write_text(s)\n(p/'formal/riscv-formal/cores').mkdir(parents=True,exist_ok=True)\nfor name in ['run_all.sh','checks_si.cfg','wrapper_si.sv']:shutil.copy2(Path('formal')/name,p/'formal'/name)\nfor name in ['checks','insns']:shutil.copytree(Path('formal/riscv-formal')/name,p/'formal/riscv-formal'/name,dirs_exist_ok=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
