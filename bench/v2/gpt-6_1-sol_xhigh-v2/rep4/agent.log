{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/branch_predictor.sv'","aggregated_output":"// Hashed agreement with backward-taken / forward-not-taken static bias.\n// Training comes only from an accepted, registered EX/MEM branch result.\n// Word-address arithmetic drops only immediate bits known to be zero when\n// prediction is enabled, and wraps naturally at the RV32 address boundary.\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [31:0] pc,\n  input  logic [31:0] instr,\n  input  logic        update_valid,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0] update_pc,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic        update_agrees,\n  output logic        predicted_taken,\n  output logic [31:0] predicted_target\n);\n  logic legal_branch, is_jal;\n  logic [29:0] offset_word, target_word;\n  wire [4:0] read_index = pc[6:2] ^ pc[11:7];\n  wire [4:0] update_index = update_pc[6:2] ^ update_pc[11:7];\n  wire [7:0] read_low_select, update_low_select;\n  wire [3:0] read_high_select, update_high_select;\n  wire [31:0] disagreement;\n  wire [15:0] pair_disagreement;\n  wire [7:0] quad_disagreement;\n  wire [3:0] oct_disagreement;\n  wire [1:0] half_disagreement;\n  wire invert_static = half_disagreement[0] | half_disagreement[1];\n\n  // Share the small address decoders across each fixed bank. The final\n  // word enable remains independent and lookup still reads only one bit.\n  for (genvar k = 0; k < 8; k++) begin : g_low_decode\n    localparam logic [2:0] INDEX = 3'(k);\n    assign read_low_select[k] = (read_index[2:0] == INDEX);\n    assign update_low_select[k] = update_valid && (update_index[2:0] == INDEX);\n  end\n  for (genvar k = 0; k < 4; k++) begin : g_high_decode\n    localparam logic [1:0] INDEX = 2'(k);\n    assign read_high_select[k] = (read_index[4:3] == INDEX);\n    assign update_high_select[k] = (update_index[4:3] == INDEX);\n  end\n\n  // Fixed words, independently enabled: no variable-index storage access\n  // or RAM. Each next-state bit is exactly a three-input Boolean function.\n  for (genvar k = 0; k < 32; k++) begin : g_counter\n    logic [1:0] counter_q;\n    wire h = counter_q[1];\n    wire l = counter_q[0];\n    wire h_next = (h & l) | (update_agrees & (h | l));\n    wire l_next = (h & ~l) | (update_agrees & (h | ~l));\n    always_ff @(posedge clock) begin\n      if (reset) counter_q <= 2'b11;\n      else if (update_high_select[k/8] && update_low_select[k%8])\n        counter_q <= {h_next, l_next};\n    end\n    // Only the MSB enters lookup; the LSB stays local to its word.\n    assign disagreement[k] = read_high_select[k/8] && read_low_select[k%8] && !counter_q[1];\n  end\n  for (genvar k = 0; k < 16; k++) begin : g_pair\n    assign pair_disagreement[k] = disagreement[2*k] | disagreement[2*k+1];\n  end\n  for (genvar k = 0; k < 8; k++) begin : g_quad\n    assign quad_disagreement[k] = pair_disagreement[2*k] | pair_disagreement[2*k+1];\n  end\n  for (genvar k = 0; k < 4; k++) begin : g_oct\n    assign oct_disagreement[k] = quad_disagreement[2*k] | quad_disagreement[2*k+1];\n  end\n  for (genvar k = 0; k < 2; k++) begin : g_half\n    assign half_disagreement[k] = oct_disagreement[2*k] | oct_disagreement[2*k+1];\n  end\n\n  always_comb begin\n    legal_branch = (instr[6:0] == 7'b1100011) &&\n                   (instr[14:12] != 3'd2 && instr[14:12] != 3'd3);\n    is_jal = (instr[6:0] == 7'b1101111);\n    predicted_taken = (pc[1:0] == 2'b00) &&\n                      ((legal_branch && (instr[31] ^ invert_static) && !instr[8]) ||\n                       (is_jal && !instr[21]));\n    offset_word = is_jal\n                ? {{12{instr[31]}}, instr[19:12], instr[20], instr[30:22]}\n                : {{20{instr[31]}}, instr[7], instr[30:25], instr[11:9]};\n    target_word = pc[31:2] + offset_word;\n    predicted_target = {target_word, 2'b00};\n  end\nendmodule\n","exit_code":0,"status":"completed"}}
