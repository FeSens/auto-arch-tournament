{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os,json\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.cosim import run_one,TRACE_STALL_MODES\nfrom tools.eval.fpga import run_coremark_ipc\nroot=Path(os.environ['TMPDIR'])/'r10-compare-prototype'\nbenchroot=Path(os.environ['TMPDIR'])/'r10-prefix-prototype'\nsim=str(root/'obj_dir/cosim_sim')\nassert Path(sim).exists()\nargs=[(elf,flags) for elf in (benchroot/'bench/programs').glob('*.elf') if elf.name\"'!='\"'coremark.elf' for flags in TRACE_STALL_MODES]\nwith ThreadPoolExecutor() as p:\n r=list(p.map(lambda a:run_one(a[0],sim,str(Path.cwd()),sim_flags=a[1]),args))\nprint('TRACE',json.dumps(r),flush=True)\ncm=run_coremark_ipc(str(benchroot),sim_bin=sim)\nprint('COREMARK',json.dumps(cm),flush=True)\n(root/'cosim_results.json').write_text(json.dumps({'traces':r,'coremark':cm},indent=2))\nassert all(a['passed'] for a in r)\nassert cm['completed'] and cm['cycles']==4052037\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
