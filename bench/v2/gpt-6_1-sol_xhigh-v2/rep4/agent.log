{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'git diff --stat; cat cores/bench/rtl/if_stage.sv; rg -n imem_ready cores/bench/rtl/core.sv'","aggregated_output":" cores/bench/rtl/core.sv           |  6 +--\n cores/bench/rtl/core_pkg.sv       |  2 +-\n cores/bench/rtl/hazard_unit.sv    | 13 +++---\n cores/bench/rtl/if_stage.sv       | 71 ++++++++++++++++++++--------\n cores/bench/test/test_pipeline.py | 98 +++++++++++++++++++++++++++++++++++++--\n 5 files changed, 154 insertions(+), 36 deletions(-)\n// rtl/if_stage.sv\n//\n// Predictor-directed fetch PC and a two-entry fall-through queue. An empty\n// queue bypasses the ready response directly to ID; downstream holds can\n// capture up to two responses independently of ID/EX admission. Fixed FF\n// payload banks have explicit write enables and validity-only reset.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // decode cannot consume head\n  input  logic              imem_ready,       // current bus response ready\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic             predicted_taken,\n  input  logic [31:0]      predicted_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic head_valid, tail_valid;\n  logic [64:0] head_q, tail_q;\n  logic [64:0] response;\n  logic consumption, response_accept;\n  logic head_write, tail_write;\n\n  assign response = {predicted_taken, pc, imem_data};\n  assign consumption = !stall && !redirect;\n  assign response_accept = imem_ready && (!tail_valid || consumption) && !redirect;\n\n  // Popping a full queue promotes the tail. Otherwise a replacement or\n  // an unconsumed empty-queue response writes the head from the bus.\n  assign head_write = (consumption && head_valid && (tail_valid || response_accept)) ||\n                      (!consumption && !head_valid && response_accept);\n  assign tail_write = response_accept && head_valid && (!consumption || tail_valid);\n\n  always_ff @(posedge clock) begin\n    if (!reset) begin\n      if (head_write) head_q <= tail_valid ? tail_q : response;\n      if (tail_write) tail_q <= response;\n    end\n  end\n\n  always_comb begin\n    next_pc = predicted_taken ? predicted_target : pc + 32'd4;\n  end\n\n  // Accepted EX correction atomically discards queued and bus wrong-path\n  // instructions, overriding ordinary holds. EX defers correction while\n  // an older data request is stalled.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      head_valid <= 1'b0;\n      tail_valid <= 1'b0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      head_valid <= 1'b0;\n      tail_valid <= 1'b0;\n    end else begin\n      if (response_accept) pc <= next_pc;\n      if (consumption) begin\n        head_valid <= tail_valid || (head_valid && response_accept);\n        tail_valid <= tail_valid && response_accept;\n      end else if (response_accept) begin\n        head_valid <= 1'b1;\n        tail_valid <= head_valid;\n      end\n    end\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    {out.predicted_taken, out.pc, out.instr} = head_valid ? head_q : response;\n    out.valid = head_valid || imem_ready;\n  end\n\nendmodule\n113:    .imem_ready      (io_imemReady),\n198:    .imem_ready     (if_id_w.valid),\n","exit_code":0,"status":"completed"}}
