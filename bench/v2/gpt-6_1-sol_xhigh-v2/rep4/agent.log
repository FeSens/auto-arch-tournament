{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/LESSONS.md schemas/hypothesis.schema.json'", "aggregated_output": "- 2026-10-01 hyp-20261001-001-r1s0 (regression, +4.37%): Sharing DIV/DIVU/REM/REMU in a tapered radix-4 divider reduced logic cells by 60%, but parallel trial-subtract selection and routing kept division on the forwarding-to-ALU critical path, limiting Fmax improvement to 4.37% with unchanged CoreMark cycles.\n- 2026-10-01 hyp-20261001-002-r1s1 (improvement, +522.03%): A shared eight-edge divider with four restoring steps per clock breaks the combinational / and % chain feeding the EX result mux, making the Fmax gain outweigh blocking DIV/REM latency in CoreMark.\n- 2026-10-01 hyp-20261001-002-r2s1 (improvement, +30.03%): Separating a four-bit launch prefix with high-divisor guards from two radix-4 stages fed by registered D/3D multiples improves divider timing by removing live-operand muxing and halving serial full-width subtract/select decisions while retaining eight-edge latency.\n- 2026-10-01 hyp-20261001-003-r2s2 (regression, +16.21%): A 64-entry direction table with decoded B/J targets cuts stalled CoreMark cycles by 6.45%, but the register-file-to-divider launch path remains critical, so its throughput gain trails retiming that path.\n- 2026-10-01 hyp-20261001-001-r3s0 (regression, +6.69%): Combining forwarding and PC/immediate selection in parallel one-hot masked-OR muxes removes serial operand selection and improves Fmax with unchanged CoreMark cycles, shifting the critical path to divider launch.\n- 2026-10-01 hyp-20261001-002-r3s1 (improvement, +10.05%): Combining explicit flip-flop RF storage with validity-only ID/EX squash removes both BSRAM read-output absorption and redirect feedback through RF addresses and operand capture, improving Fmax with unchanged stalled CoreMark cycles.\n- 2026-10-01 hyp-20261001-001-r4s0 (regression, +11.57%): Boolean nibble quotient/remainder equations plus direct raw-operand normalization remove four dependent launch subtract/select stages and full-width magnitude dependencies, shifting the timing bottleneck to forwarding/ALU-to-memory with unchanged CoreMark cycles.\n- 2026-1\n…[2807 of 5879 chars elided by tools/bench/transcript.py; sha256:b99bce03438d1d1f]…\nnLength\": 5},\n    \"category\": {\"type\": \"string\", \"enum\": [\"micro_opt\",\"structural\",\"extension\",\"predictor\",\"memory\"]},\n    \"motivation\":  {\"type\": \"string\", \"minLength\": 20},\n    \"hypothesis\":  {\"type\": \"string\", \"minLength\": 20},\n    \"expected_impact\": {\n      \"type\": \"object\",\n      \"required\": [\"fitness_delta_pct\",\"confidence\"],\n      \"properties\": {\n        \"fitness_delta_pct\": {\"type\": \"integer\"},\n        \"confidence\": {\"type\": \"string\", \"enum\": [\"low\",\"medium\",\"high\"]}\n      }\n    },\n    \"changes\": {\n      \"type\": \"array\", \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"file\",\"description\"],\n        \"properties\": {\n          \"file\":        {\n            \"type\": \"string\",\n            \"description\": \"Must be under rtl/ (any extension) or be a test/test_*.py cocotb suite. Anything else is rejected by the runtime sandbox check.\",\n            \"pattern\": \"^(rtl/[^.].*|test/test_[^/]+\\\\.py)$\"\n          },\n          \"description\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_branch_predictor.py cores/bench/core.yaml'","aggregated_output":"\"\"\"Check static predecode, alignment suppression and RV32 target arithmetic.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _check(dut, pc, instr):\n    opcode = instr & 127\n    if opcode == 0x6F:\n        imm = (((instr >> 31) & 1) << 20) | (((instr >> 12) & 255) << 12) \\\n            | (((instr >> 20) & 1) << 11) | (((instr >> 21) & 1023) << 1)\n        if imm & (1 << 20):\n            imm -= 1 << 21\n        taken = not (imm & 2)\n    else:\n        imm = (((instr >> 31) & 1) << 12) | (((instr >> 7) & 1) << 11) \\\n            | (((instr >> 25) & 63) << 5) | (((instr >> 8) & 15) << 1)\n        if imm & (1 << 12):\n            imm -= 1 << 13\n        taken = opcode == 0x63 and ((instr >> 12) & 7) in (0, 1, 4, 5, 6, 7) \\\n            and imm < 0 and not (imm & 2)\n    dut.pc.value = pc\n    dut.instr.value = instr\n    await Timer(2, \"ns\")\n    assert int(dut.predicted_taken.value) == (taken and not (pc & 3))\n    # Byte-address reference deliberately reconstructs the full immediate;\n    # round down only the bits the predictor omits, then apply RV32 wrap.\n    expected = ((pc & ~3) + (imm & ~3)) & 0xFFFFFFFF\n    assert int(dut.predicted_target.value) == expected, (hex(pc), hex(instr), hex(expected))\n\n\n@cocotb.test()\nasync def exhaustive_branch_offsets_and_reserved_encodings(dut):\n    rng = random.Random(0xB7F)\n    pcs = (0, 4, 0xFFFFFFFC, 0x80000000, 0x7FFFFFFC)\n    for imm in range(-4096, 4096, 2):\n        for funct3 in range(8):\n            bits = imm & 8191\n            instr = (((bits >> 12) & 1) << 31) | (((bits >> 11) & 1) << 7) \\\n                | (((bits >> 5) & 63) << 25) | (((bits >> 1) & 15) << 8) \\\n                | (rng.randrange(32) << 20) | (rng.randrange(32) << 15) | (funct3 << 12) | 0x63\n            await _check(dut, pcs[(imm // 2 + funct3) % len(pcs)], instr)\n    for alignment in (1, 2, 3):\n        await _check(dut, 0x100 + alignment, 0xFE000EE3)  # BEQ x0,x0,-4\n\n\n@cocotb.test()\nasync def jal_offsets_and_sequential_opcodes(dut):\n    rng = random.Random(0x1A1)\n    offsets = [-1048576, -1048574, -8, -4, -2, 0, 2, 4, 8, 1048572, 1048574]\n    offsets += [sign * (1 << bit) for bit in range(1, 20) for sign in (-1, 1)]\n    offsets += [rng.randrange(-524288, 524288) * 2 for _ in range(2000)]\n    for imm in offsets:\n        bits = imm & 0x1FFFFF\n        instr = (((bits >> 20) & 1) << 31) | (((bits >> 12) & 255) << 12) \\\n            | (((bits >> 11) & 1) << 20) | (((bits >> 1) & 1023) << 21) \\\n            | (rng.randrange(32) << 7) | 0x6F\n        for pc in (0, 0xFFFFFFFC, rng.getrandbits(32)):\n            await _check(dut, pc, instr)\n    for opcode in range(128):\n        if opcode in (0x63, 0x6F):\n            continue\n        for _ in range(16):\n            await _check(dut, rng.getrandbits(32), (rng.getrandbits(32) & ~127) | opcode)\n\n\ndef test_branch_predictor_runner():\n    run_cocotb(toplevel=\"branch_predictor\", sources=[\"branch_predictor.sv\"],\n               test_module=\"test_branch_predictor\")\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 73.757\n  lut4: 5642\n  ff: 1775\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261001-001-r7s0\n  updated: '2026-10-01T18:30:02.651333Z'\n","exit_code":0,"status":"completed"}}
