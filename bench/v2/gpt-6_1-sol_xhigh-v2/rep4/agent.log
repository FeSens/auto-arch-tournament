{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"sed -n '1,150p' tools/eval/_slots.py\"","aggregated_output":"\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nimport tempfile\nroot=Path.cwd()\nproto=Path(tempfile.mkdtemp(prefix='r11s1-pc-banks-',dir='/srv/hwebench/tmp/555e5898/e735592b'))\nshutil.copytree(root/'cores/bench/rtl',proto/'rtl')\nshutil.copytree(root/'cores/bench/test',proto/'test')\n(proto/'repo_root.txt').write_text(str(root))\np=proto/'rtl/ex_stage.sv'\ns=p.read_text()\ns=s.replace('  output logic [31:0]        redirect_target\\\\n','  output logic [31:0]        redirect_target,\\\\n  output logic [31:0]        recovery_resolved_target,\\\\n  output logic [31:0]        recovery_fallthrough_target,\\\\n  output logic               recovery_use_fallthrough\\\\n')\nanchor='  // ── EX/MEM register'\naddition='''  assign recovery_resolved_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0} : branch_target;\n  assign recovery_fallthrough_target = in.pc + 32'd4;\n  assign recovery_use_fallthrough = in.predicted_taken && \"'!direct_taken;\n\n'\"'''\nassert anchor in s\ns=s.replace(anchor,addition+anchor)\np.write_text(s)\np=proto/'rtl/core.sv';s=p.read_text()\ns=s.replace('  logic [31:0] redirect_target;','  logic [31:0] redirect_target;\\\\n  logic [31:0] recovery_resolved_target, recovery_fallthrough_target;\\\\n  logic recovery_use_fallthrough;')\ns=s.replace('    .redirect_target (redirect_target),','    .recovery_resolved_target (recovery_resolved_target),\\\\n    .recovery_fallthrough_target (recovery_fallthrough_target),\\\\n    .recovery_use_fallthrough (recovery_use_fallthrough),',1)\ns=s.replace('    .redirect_target (redirect_target)\\\\n','    .redirect_target (redirect_target),\\\\n    .recovery_resolved_target (recovery_resolved_target),\\\\n    .recovery_fallthrough_target (recovery_fallthrough_target),\\\\n    .recovery_use_fallthrough (recovery_use_fallthrough)\\\\n',1)\np.write_text(s)\np=proto/'rtl/if_stage.sv';s=p.read_text()\ns=s.replace('  input  logic [31:0]       redirect_target,','  input  logic [31:0]       recovery_resolved_target,\\\\n  input  logic [31:0]       recovery_fallthrough_target,\\\\n  input  logic              recovery_use_fallthrough,')\ns=s.replace('  logic [31:0] pc;','  logic [31:0] pc;\\\\n  logic [31:0] normal_pc_q, resolved_target_q, fallthrough_target_q;\\\\n  logic resolved_active_q, fallthrough_active_q;')\nold='''      pc <= RESET_PC;\n      count_q <= 3'd0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count_q <= 3'd0;\n    end else begin\n      if (storage_accept) pc <= next_pc;'''\nnew='''      count_q <= 3'd0;\n    end else if (redirect) begin\n      count_q <= 3'd0;\n    end else begin'''\nassert old in s;s=s.replace(old,new)\ns=s.replace('  assign imem_addr = pc;','''  always_ff @(posedge clock) begin\n    resolved_target_q <= recovery_resolved_target;\n    fallthrough_target_q <= recovery_fallthrough_target;\n    if (reset) begin\n      normal_pc_q <= RESET_PC;\n      resolved_active_q <= 1'b0;\n      fallthrough_active_q <= 1'b0;\n    end else begin\n      resolved_active_q <= redirect && \"'!recovery_use_fallthrough;\n      fallthrough_active_q <= redirect && recovery_use_fallthrough;\n      if (storage_accept) normal_pc_q <= next_pc;\n      else if (resolved_active_q || fallthrough_active_q) normal_pc_q <= pc;\n    end\n  end\n\n  assign pc = (normal_pc_q & {32{!(resolved_active_q || fallthrough_active_q)}}) |\n              (resolved_target_q & {32{resolved_active_q}}) |\n              (fallthrough_target_q & {32{fallthrough_active_q}});\n  assign imem_addr = pc;'\"''')\np.write_text(s)\np=proto/'test/test_if_stage_queue.py';s=p.read_text()\ns=s.replace('dut.redirect_target.value = 0','dut.recovery_resolved_target.value = 0\\\\n    dut.recovery_fallthrough_target.value = 0\\\\n    dut.recovery_use_fallthrough.value = 0')\ns=s.replace('        redirect_pc = rng.getrandbits(30) << 2','''        resolved_pc = rng.getrandbits(30) << 2