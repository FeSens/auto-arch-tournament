v\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[19750 of 22822 chars elided by tools/bench/transcript.py; sha256:835f7faf4a0d220e]…\nutdir))\n159:    if timed_out:\n160:        return {\"place_option\": place_option, \"placement_failed\": True,\n161:                \"fmax_mhz\": None, \"timed_out\": True,\n162:                \"reason\": f\"Gowin build timeout after {BUILD_TIMEOUT_SEC}s\"}\n164:    if res[\"placement_failed\"]:\n180:    \"\"\"Median Fmax over placement options; every option must fit (the flow\n182:    failed = [r for r in results if r[\"placement_failed\"]]\n184:        return {\"placement_failed\": True,\n189:        \"placement_failed\": False,\n190:        \"fmax_mhz\": round(statistics.median(r[\"fmax_mhz\"] for r in results), 3),\n202:    import argparse, json\n204:    ap = argparse.ArgumentParser()\n209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\n216:        if r[\"placement_failed\"]:\n226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n227:        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n", "exit_code": 1, "status": "failed"}}
