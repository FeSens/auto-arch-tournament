{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/555e5898/6a8ba861/fetch_probe/cores/bench/rtl/if_stage.sv')\ns=p.read_text(); p.with_name('if_stage_v1.txt').write_text(s)\ns=s.replace(' && \"'!redirect && !reset'\"','')\ns=s.replace('      if (pop) begin','    end\\\\n  end\\\\n  // Speculative payload writes are harmless when occupancy is flushed.\\\\n  // Only PC/count need correction/reset qualification.\\\\n  always_ff @(posedge clock) begin\\\\n      if (pop) begin',1)\ns=s.replace('''      end\n    end\n  end\nendmodule\n''','''      end\n  end\nendmodule\n''')\np.write_text(s)\nprint(s)\nPY\"","aggregated_output":"// Four-entry fall-through predictor-directed acquisition probe.\nmodule if_stage (\n  input logic clock, reset, stall, imem_ready, redirect,\n  input logic [31:0] redirect_target,\n  input logic predicted_taken,\n  input logic [31:0] predicted_target,\n  output logic [31:0] imem_addr,\n  input logic [31:0] imem_data,\n  output if_id_t out\n);\n  logic [31:0] pc;\n  logic [2:0] count;\n  logic [65:0] q0, q1, q2, q3;\n  if_id_t response;\n  wire pop = (count != 0) && !stall;\n  wire accept_bus = imem_ready && ((count < 4) || pop);\n  wire bypass = (count == 0) && !stall;\n  wire enqueue = accept_bus && !bypass;\n  wire [2:0] append_at = count - {2'b0, pop};\n  assign imem_addr = pc;\n  always_comb begin\n    response.predicted_taken = predicted_taken;\n    response.pc = pc;\n    response.instr = imem_data;\n    response.valid = imem_ready;\n    out = (count != 0) ? if_id_t'(q0) : response;\n    out.valid = (count != 0) || imem_ready;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= 32'b0;\n      count <= 3'b0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count <= 3'b0;\n    end else begin\n      if (accept_bus) pc <= predicted_taken ? predicted_target : pc + 32'd4;\n      case ({enqueue,pop})\n        2'b10: count <= count + 3'd1;\n        2'b01: count <= count - 3'd1;\n        default: ;\n      endcase\n    end\n  end\n  // Speculative payload writes are harmless when occupancy is flushed.\n  // Only PC/count need correction/reset qualification.\n  always_ff @(posedge clock) begin\n      if (pop) begin\n        q0 <= q1;\n        q1 <= q2;\n        q2 <= q3;\n      end\n      if (enqueue) begin\n        case (append_at)\n          3'd0: q0 <= response;\n          3'd1: q1 <= response;\n          3'd2: q2 <= response;\n          3'd3: q3 <= response;\n          default: ;\n        endcase\n      end\n  end\nendmodule\n\n","exit_code":0,"status":"completed"}}
