{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random, json\nfrom pathlib import Path\nrng=random.Random(0x7160)\nM32=(1<<32)-1; M36=(1<<36)-1; M37=(1<<37)-1\ncount=0\n\ndef step(r,n,d):\n global count\n t=(r<<4)|n\n odd=[(k*d)&M36 for k in range(1,16,2)]\n multi=[0]\n for k in range(1,16):\n  z=(k & -k).bit_length()-1\n  multi.append((odd[((k>>z)-1)//2]<<z)&M36)\n diff=[(t-x)&M37 for x in multi]\n fit=[True]+[not (x>>36) for x in diff[1:]]+[False]\n sel=[fit[k] and not fit[k+1] for k in range(16)]\n assert sum(sel)==1\n digit=sum(k for k in range(16) if sel[k])\n rem=0\n for k in range(16):\n  if sel[k]: rem|=diff[k]&M32\n refq,refr=divmod(t,d) if d else (15,t)\n assert digit==refq and rem==refr,(r,n,d,digit,rem,refq,refr)\n oldr=r; oldq=0\n for shift in (2,0):\n  oldr=(oldr<<2)|((n>>shift)&3)\n  q=max(k for k in range(4) if oldr>=k*d)\n  oldr-=q*d; oldq=(oldq<<2)|q\n assert (digit,rem)==(oldq,oldr)\n count+=1\n return digit,rem\n\nfor d in range(1,129):\n for r in range(d):\n  for n in range(16): step(r,n,d)\nvalues=[0,1,2,3,7,15,16,17,255,256,257,65535,65536,65537,0x10000001,0x7fffffff,0x80000000,0x80000001,0xfffffffe,M32]\nfor d in values:\n if d:\n  for r in {0,d//2,d-1}:\n   for n in range(16):step(r,n,d)\n  for k in range(16):\n   for delta in (-1,0,1):\n    t=k*d+delta\n    if 0<=t and (t>>4)<d:step(t>>4,t&15,d)\n else:\n  for r in (0,1,0x0fffffff):\n   for n in range(16):step(r,n,d)\nfor _ in range(100000):\n d=rng.randint(1,M32); step(rng.randrange(d),rng.randrange(16),d)\n\ndef divide(a,b,signed,remop):\n aa=a-(1<<32) if signed and a>>31 else a\n bb=b-(1<<32) if signed and b>>31 else b\n A=abs(aa); D=abs(bb)\n prefix=A>>24\n q,r=divmod(prefix,D) if D else (255,prefix)\n for shift in range(20,-1,-4):\n  digit,r=step(r,(A>>shift)&15,D)\n  q=(q<<4)|digit\n if remop:\n  got=-r if signed and aa<0 else r\n else:\n  got=-q if signed and ((aa<0) \"'!= (bb<0)) and D else q\n if not bb:ref=aa if remop else -1\n else:\n  rq=abs(aa)//abs(bb)\n  if (aa<0)!=(bb<0):rq=-rq\n  ref=aa-rq*bb if remop else rq\n assert got&M32==ref&M32,(a,b,signed,remop,got,ref)\nfor a in values:\n for b in values:\n  for signed in (False,True):\n   for remop in (False,True):divide(a,b,signed,remop)\nfor _ in range(10000):\n a=rng.getrandbits(32); b=rng.choice(values) if rng.randrange(2) else rng.getrandbits(32)\n for signed in (False,True):\n  for remop in (False,True):divide(a,b,signed,remop)\nresult={'\"'radix16_steps':count,'complete_rv32m_comparisons':len(values)**2*4+10000*4,'result':'PASS'}\nprint(json.dumps(result))\nPath('/srv/hwebench/tmp/555e5898/70573578/radix16_zotqbm4i/model_results.json').write_text(json.dumps(result))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
