{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,itertools\nroot=Path('cores/bench/generated/nibble_probe');rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\ndef expr(points):\n if not points:return \\\"1'b0\\\"\n if len(points)==16:return \\\"1'b1\\\"\n cubes=[]\n for bits in itertools.product([-1,0,1],repeat=4):\n  covered={a for a in range(16) if all(b<0 or ((a>>i)&1)==b for i,b in enumerate(bits))}\n  if covered<=points:cubes.append((bits,covered))\n cubes=[c for c in cubes if not any(c[1]<d[1] for d in cubes)]\n selected=[];remaining=set(points)\n while remaining:\n  essentials=[]\n  for a in sorted(remaining):\n   opts=[c for c in cubes if a in c[1]]\n   if len(opts)==1 and opts[0] not in essentials:essentials.append(opts[0])\n  if essentials:\n   for c in essentials:selected.append(c);remaining-=c[1]\n  else:\n   c=max(cubes,key=lambda c:(len(c[1]&remaining),-sum(b>=0 for b in c[0]),c[0]));selected.append(c);remaining-=c[1]\n return ' | '.join('('+' & '.join(('~' if b==0 else '')+f'prefix_x[{i}]' for i,b in enumerate(bits) if b>=0)+')' for bits,_ in selected)\nlines=['  // Shannon-decomposed four-input Boolean leaves; fixed-index mux tree.',\n'  wire [7:0] nibble_leaf [0:15], nibble_pair [0:7];',\n'  wire [7:0] nibble_quad [0:3], nibble_oct [0:1];',\n'  wire [7:0] nibble_selected;','  assign prefix_x = {magnitude_b_q[3:0], magnitude_a_q[31:28]};']\nfor d in range(16):\n for bit in range(8):\n  values={a:(((a//d if d else 15)<<4)|(a%d if d else a)) for a in range(16)}\n  points={a for a,v in values.items() if (v>>bit)&1}\n  lines.append(f'  assign nibble_leaf[{d}][{bit}] = {expr(points)};')\nfor lev,src,dst,count in [(0,'nibble_leaf','nibble_pair',8),(1,'nibble_pair','nibble_quad',4),(2,'nibble_quad','nibble_oct',2)]:\n for k in range(count):lines.append(f'  assign {dst}[{k}] =