{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot = Path.cwd()\nprobe = Path('/srv/hwebench/tmp/555e5898/806fbb2b/banked_rf_probe')\nrtl = probe / 'rtl'\nrtl.mkdir(parents=True, exist_ok=True)\nfor src in (root / 'cores/bench/rtl').glob('*.sv'):\n    shutil.copy2(src, rtl / src.name)\n(rtl / 'reg_file.sv').write_text('''module reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output logic [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  wire [31:0] words [0:31];\n  wire [31:0] masked1 [0:31], masked2 [0:31];\n  wire [31:0] groups1 [0:3], groups2 [0:3];\n  wire [31:0] read1, read2;\n  assign words[0] = 32'b0;\n  for (genvar r = 1; r < 32; r++) begin : regs\n    logic [31:0] q;\n    always_ff @(posedge clock) begin\n      if (reset) q <= 32'b0;\n      else if (w_en && w_addr == 5'(r)) q <= w_data;\n    end\n    assign words[r] = q;\n  end\n  for (genvar r = 0; r < 32; r++) begin : reads\n    assign masked1[r] = words[r] & {32{rs1_addr == 5'(r)}};\n    assign masked2[r] = words[r] & {32{rs2_addr == 5'(r)}};\n  end\n  for (genvar b = 0; b < 4; b++) begin : banks\n    assign groups1[b] = (masked1[8*b] | masked1[8*b+1]) |\n      (masked1[8*b+2] | masked1[8*b+3]) |\n      (masked1[8*b+4] | masked1[8*b+5]) |\n      (masked1[8*b+6] | masked1[8*b+7]);\n    assign groups2[b] = (masked2[8*b] | masked2[8*b+1]) |\n      (masked2[8*b+2] | masked2[8*b+3]) |\n      (masked2[8*b+4] | masked2[8*b+5]) |\n      (masked2[8*b+6] | masked2[8*b+7]);\n  end\n  assign read1 = (groups1[0] | groups1[1]) | (groups1[2] | groups1[3]);\n  assign read2 = (groups2[0] | groups2[1]) | (groups2[2] | groups2[3]);\n  always_comb begin\n    rs1_data = rs1_addr == 0 ? 32'b0 :\n      (w_en && w_addr == rs1_addr ? w_data : read1);\n    rs2_data = rs2_addr == 0 ? 32'b0 :\n      (w_en && w_addr == rs2_addr ? w_data : read2);\n  end\nendmodule\n''')\nold = Path('/srv/hwebench/tmp/555e5898/806fbb2b/validity_probe/run_pipeline.py').read_text()\n(probe / 'run_pipeline.py').write_text(old.replace('validity_probe', 'banked_rf_probe'))\nprint('Prepared banked register-file prototype on unmodified champion pipeline.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
