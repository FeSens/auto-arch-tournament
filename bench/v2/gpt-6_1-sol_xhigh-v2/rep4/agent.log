{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_branch_predictor.py cores/bench/test/conftest.py cores/bench/core.yaml; sed -n '1,240p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Check static predecode, alignment suppression and RV32 target arithmetic.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _check(dut, pc, instr):\n    opcode = instr & 127\n    if opcode == 0x6F:\n        imm = (((instr >> 31) & 1) << 20) | (((instr >> 12) & 255) << 12) \\\n            | (((instr >> 20) & 1) << 11) | (((instr >> 21) & 1023) << 1)\n        if imm & (1 << 20):\n            imm -= 1 << 21\n        taken = not (imm & 2)\n    else:\n        imm = (((instr >> 31) & 1) << 12) | (((instr >> 7) & 1) << 11) \\\n            | (((instr >> 25) & 63) << 5) | (((instr >> 8) & 15) << 1)\n        if imm & (1 << 12):\n            imm -= 1 << 13\n        taken = opcode == 0x63 and ((instr >> 12) & 7) in (0, 1, 4, 5, 6, 7) \\\n            and imm < 0 and not (imm & 2)\n    dut.pc.value = pc\n    dut.instr.value = instr\n    await Timer(2, \"ns\")\n    assert int(dut.predicted_taken.value) == (taken and not (pc & 3))\n    # Byte-address reference deliberately reconstructs the full immediate;\n    # round down only the bits the predictor omits, then apply RV32 wrap.\n    expected = ((pc & ~3) + (imm & ~3)) & 0xFFFFFFFF\n    assert int(dut.predicted_target.value) == expected, (hex(pc), hex(instr), hex(expected))\n\n\n@cocotb.test()\nasync def exhaustive_branch_offsets_and_reserved_encodings(dut):\n    rng = random.Random(0xB7F)\n    pcs = (0, 4, 0xFFFFFFFC, 0x80000000, 0x7FFFFFFC)\n    for imm in range(-4096, 4096, 2):\n        for funct3 in range(8):\n            bits = imm & 8191\n            instr = (((bits >> 12) & 1) << 31) | (((bits >> 11) & 1) << 7) \\\n                | (((bits >> 5) & 63) << 25) | (((bits >> 1) & 15) << 8) \\\n                | (rng.randrange(32) << 20) | (rng.randrange(32) << 15) | (funct3 << 12) | 0x63\n            await _check(dut, pcs[(imm // 2 + funct3) % len(pcs)], instr)\n    for alignment in (1, 2, 3):\n        await _check(dut, 0x100 + alignment, 0xFE000EE3)  # BEQ x0,x0,-4\n\n\n@cocotb.test()\nasync def jal_offsets_and_sequential_\n…[10441 of 13513 chars elided by tools/bench/transcript.py; sha256:90cb9e2fa899869b]…\n123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n", "exit_code": 0, "status": "completed"}}
