{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/r12_probe')\n(p/'test').mkdir(exist_ok=True)\nfor f in Path('cores/bench/test').glob('*.py'):\n shutil.copy2(f,p/'test'/f.name)\nf=p/'test/test_reg_file.py'\ns=f.read_text()\ns+='''\\\\n\\\\n@cocotb.test()\nasync def four_candidate_ports_independent_reference(dut):\n    await _manual_reset(dut)\n    ref = [0]*32\n    rng = random.Random(0x12F04)\n    for cycle in range(2048):\n        dest = rng.randrange(32)\n        value = rng.getrandbits(32)\n        enable = bool(cycle%3)\n        addrs = [rng.randrange(32) for _ in range(4)]\n        addrs[cycle%4] = dest\n        if cycle%8 == 0:\n            addrs = [dest]*4\n        dut.w_en.value = enable\n        dut.w_addr.value = dest\n        dut.w_data.value = value\n        for port,addr in enumerate(addrs,1):\n            getattr(dut,f'rs{port}_addr').value=addr\n        await Timer(1,'ns')\n        for port,addr in enumerate(addrs,1):\n            expect = 0 if addr == 0 else value if enable and addr == dest else ref[addr]\n            assert int(getattr(dut,f'rs{port}_data').value) == expect\n        await _manual_edge(dut)\n        if enable and dest:\n            ref[dest]=value\n        dut.w_en.value=0\n        await Timer(1,'ns')\n        for port,addr in enumerate(addrs,1):\n            assert int(getattr(dut,f'rs{port}_data').value)==ref[addr]\n'''\nf.write_text(s)\n(p/'formal/riscv-formal/cores').mkdir(parents=True,exist_ok=True)\nfor name in ['run_all.sh','checks_si.cfg','wrapper_si.sv']:\n shutil.copy2(Path('formal')/name,p/'formal'/name)\nfor name in ['checks','insns']:\n shutil.copytree(Path('formal/riscv-formal')/name,p/'formal/riscv-formal'/name,dirs_exist_ok=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
