{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY' > /srv/hwebench/tmp/555e5898/2ab38d95/loop_profile.log\nimport json\nfrom pathlib import Path\nes=json.loads(Path('/srv/hwebench/tmp/555e5898/2ab38d95/branch_events.json').read_text())\nfor n in [32,64]:\n for nl in [4,8,16]:\n  table=[3]*n;loops=[[-1,0,0,0,False] for _ in range(nl)];miss=0;overrides=0;nb=n.bit_length()-1;lb=nl.bit_length()-1\n  for pc,b,t,m,seq in es:\n   i=((pc>>2)\"'^(pc>>(nb+2)))&(n-1)\n   il=((pc>>2)''^(pc>>(lb+2)))&(nl-1)\n   tag,count,trip,conf,overflow=loops[il]\n   pred=b ''^ (table[i]<2)\n   if b and tag==pc and conf==3 and count==trip and trip>0 and not overflow:\n    pred=0;overrides+=m\n   miss+=m and (pred!=t)\n   c=table[i];table[i]=min(3,c+1) if b==t else max(0,c-1)\n   if b:\n    if tag!=pc:\n     # Allocate only on loop exit: don'\"'t displace trained loops on taken noise.\n     if not t: loops[il]=[pc,0,0,0,False]\n    elif t:\n     if count<15:count+=1\n     else:overflow=True;conf=0\n     loops[il]=[tag,count,trip,conf,overflow]\n    else:\n     if not overflow and count>0:\n      conf=min(3,conf+1) if count==trip else 0\n      trip=count\n     else:conf=0\n     loops[il]=[tag,0,trip,conf,False]\n  print(n,nl,miss,overrides,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
