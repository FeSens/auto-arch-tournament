{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nBase arithmetic and multiplication remain combinational. DIV/REM launch\ncaptures operands, completes on iteration edge eight, and holds its result\nuntil consumed.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_launch.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_result_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_launch.value = 1\n    await _tick(dut)\n    dut.div_launch.value = 0\n    signed = op in (ALU_DIV, ALU_REM)\n    sa, sb = a & MASK32, b & MASK32\n    if signed:\n        sa = sa if sa < 0x80000000 else sa - (1 << 32)\n        sb = sb if sb < 0x80000000 else sb - (1 << 32)\n    magnitude_a, magnitude_b = abs(sa), abs(sb)\n    # Changing inputs and attempting another launch cannot alter an\n    # accepted request. The first chunk already executed on l\n…[11477 of 14549 chars elided by tools/bench/transcript.py; sha256:fe3d7bd031274935]…\n dut.a.value = 100\n    dut.b.value = 7\n    dut.div_launch.value = 1\n    await _tick(dut)\n    dut.div_launch.value = 0\n    for _ in range(7):\n        await _tick(dut)\n    assert int(dut.div_result_valid.value) and int(dut.out.value) == 14\n    dut.op.value = ALU_REM\n    dut.a.value = (-101) & MASK32\n    dut.b.value = 7\n    dut.div_consume.value = 1\n    dut.div_launch.value = 1\n    await _tick(dut)\n    dut.div_consume.value = 0\n    dut.div_launch.value = 0\n    assert int(dut.div_busy.value) and not int(dut.div_result_valid.value)\n    for edge in range(7):\n        await _tick(dut)\n        assert int(dut.div_result_valid.value) == (edge == 6)\n    assert int(dut.out.value) == (-3) & MASK32\n    dut.div_consume.value = 1\n    await _tick(dut)\n    assert not int(dut.div_result_valid.value)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"divider.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
