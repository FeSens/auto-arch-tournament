{"type": "item.started", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r6_launch_probe')\nshutil.copytree('cores/bench/rtl',root/'rtl',dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',root/'test',dirs_exist_ok=True)\np=root/'rtl/divider.sv'\ns=p.read_text()\ns=s.replace('  logic [3:0] launch_remainder [0:4];\\\\n  logic [3:0] launch_digit;','''  logic [3:0] launch_digit, launch_final_remainder;\n  logic negate_a, negate_b, small_divisor;\n  logic [3:0] prefix_nibble, divisor_nibble;\n  logic [5:0] launch_multiple_one, launch_multiple_two, launch_multiple_three;\n  wire [3:0] prefix_remainder [0:2];\n  wire [1:0] prefix_digit [0:1];''')\nstart=s.index('  assign launch_remainder[0]')\nend=s.index('\\\\n  always_comb begin\\\\n    double_divisor',start)\ns=s[:start]+'''  assign negate_a = signed_op && a[31];\n  assign negate_b = signed_op && b[31];\n  assign prefix_nibble = negate_a\n      ? (~a[31:28] + {3'b0, (a[27:0] == 0)}) : a[31:28];\n  assign divisor_nibble = negate_b ? (~b[3:0] + 4'd1) : b[3:0];\n  assign small_divisor = negate_b\n      ? ((&b[31:4]) && (b[3:0] \"'!= 0)) : !(|b[31:4]);\n  assign launch_multiple_one = {2'\"'b0, divisor_nibble};\n  assign launch_multiple_two = launch_multiple_one << 1;\n  assign launch_multiple_three = launch_multiple_one + launch_multiple_two;\n  assign prefix_remainder[0] = 4'b0;\n  for (genvar g = 0; g < 2; g++) begin : launch_prefix\n    localparam integer W = 2*(g+1);\n    wire [W-1:0] trial;\n    wire [W:0] delta_one, delta_two, delta_three;\n    wire fit_one, fit_two, fit_three;\n    if (g == 0) begin : first_digit\n      assign trial = prefix_nibble[3:2];\n    end else begin : next_digit\n      assign trial = {prefix_remainder[g][W-3:0], prefix_nibble[1:0]};\n    end\n    assign delta_one = {1'b0,trial} - {1'b0,launch_multiple_one[W-1:0]};\n    assign delta_two = {1'b0,trial} - {1'b0,launch_multiple_two[W-1:0]};\n    assign delta_three = {1'b0,trial} - {1'b0,launch_multiple_three[W-1:0]};\n    assign fit_one = small_divisor && \"'!(|launch_multiple_one[5:W]) && !delta_one[W];\n    assign fit_two = small_divisor && !(|launch_multiple_two[5:W]) && !delta_two[W];\n    assign fit_three = small_divisor && !(|launch_multiple_three[5:W]) && !delta_three[W];\n    assign prefix_digit[g] = {fit_two, fit_three || (!fit_two && fit_one)};\n    assign prefix_remainder[g+1] = {{(4-W){1'\"'b0}},\n        (prefix_digit[g][1]\n         ? (prefix_digit[g][0] ? delta_three[W-1:0] : delta_two[W-1:0])\n         : (prefix_digit[g][0] ? delta_one[W-1:0] : trial))};\n  end\n  assign launch_digit = {prefix_digit[0],prefix_digit[1]};\n  assign launch_final_remainder = prefix_remainder[2];\n''' + s[end:]\ns=s.replace(\\\"remainder_q <= {28'b0, launch_remainder[4]};\\\",\\\"remainder_q <= {28'b0, launch_final_remainder};\\\")\np.write_text(s)\nprint('Temporary candidate:',root)\nPY\npython - <<'PY'\nimport random\nrng=random.Random(0x6001)\ndef prefix(a,b,signed):\n neg_a=signed and bool(a>>31); neg_b=signed and bool(b>>31)\n p=(((~(a>>28)) + (a&0xfffffff==0))&15) if neg_a else a>>28\n d=((~b+1)&15) if neg_b else b&15\n small= ((b>>4)==0xfffffff and b&15\"'!=0) if neg_b else b>>4==0\n q=r=0\n for shift in (2,0):\n  w=4-shift;t=(r<<2)|((p>>shift)&3)\n  fits=[small and (k*d)<(1<<w) and t>=k*d for k in (1,2,3)]\n  digit=(2*fits[1])+(fits[2] or (not fits[1] and fits[0]))\n  r=t-digit*d;q=(q<<2)|digit\n return p,q,r\ncount=0\nfor a,b in [(p<<28,d) for p in range(16) for d in range(32)]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000)]+[(a,b&0xffffffff) for a in (0,1,0x10000000,0x10000001,0x80000000,0x80000001,0xffffffff) for b in range(-32,33)]:\n for signed in (False,True):\n  ma=abs(a-(1<<32)) if signed and a>>31 else a\n  mb=abs(b-(1<<32)) if signed and b>>31 else b\n  p,q,r=prefix(a,b,signed)\n  assert p==ma>>28\n  assert (q,r)==(divmod(p,mb) if mb else (15,p)),(he