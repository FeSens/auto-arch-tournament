{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/555e5898/69cc8ea0/snoop_probe')\nr=Path('/srv/hwebench/tmp/555e5898/69cc8ea0/snoop_ring_probe')\nshutil.copytree(p/'rtl',r/'rtl',dirs_exist_ok=True)\nshutil.copytree(p/'test',r/'test',dirs_exist_ok=True)\nf=r/'rtl/if_stage.sv'\ns=f.read_text()\ns=s.replace('  logic [65:0] payload0_q, payload1_q, payload2_q, payload3_q;', '''  logic [4:0] head_onehot_q, tail_onehot_q;\n  wire [65:0] payload_q [0:4];\n  wire [63:0] coherent [0:4];\n  wire [65:0] head_masked [0:4];\n  wire [63:0] operands_masked [0:4];\n  wire [63:0] head_operands;''')\ns=s.replace('  logic [2:0] append_index;','')\ns=s.replace('  assign append_index = count_q - (storage_pop ? 3\\\\'d1 : 3\\\\'d0);\\\\n','')\ns=s.replace('  assign head = payload0_q;','''  assign head = (head_masked[0] | head_masked[1]) | (head_masked[2] | head_masked[3]) | head_masked[4];\n  assign head_operands = (operands_masked[0] | operands_masked[1]) | (operands_masked[2] | operands_masked[3]) | operands_masked[4];''')\nstart=s.index('  always_ff @(posedge clock) begin\\\\n    if (storage_pop) begin')\nend=s.index('  // Only direct corrections',start)\ns=s[:start]+'''  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      head_onehot_q <= 5'b00001;\n      tail_onehot_q <= 5'b00001;\n    end else begin\n      if (storage_pop) head_onehot_q <= {head_onehot_q[3:0],head_onehot_q[4]};\n      if (storage_enqueue) tail_onehot_q <= {tail_onehot_q[3:0],tail_onehot_q[4]};\n    end\n  end\n\n'''+s[end:]\nstart=s.index('  logic [63:0] operands0_q')\nend=s.index('  assign imem_addr = fetch_pc;',start)\ns=s[:start]+'''  for (genvar k=0; k<5; k++) begin : stationary_bank\n    logic [65:0] payload;\n    logic [63:0] operands;\n    wire hit1 = wb_en && (wb_addr \"'!= 0) && (wb_addr == payload[20:16]);\n    wire hit2 = wb_en && (wb_addr != 0) && (wb_addr == payload[25:21]);\n    assign payload_q[k] = payload;\n    assign coherent[k][63:32] = (payload[20:16] == 0) ? 32'\"'b0\n                             : hit1 ? wb_data : operands[63:32];\n    assign coherent[k][31:0] = (payload[25:21] == 0) ? 32'b0\n                             : hit2 ? wb_data : operands[31:0];\n    assign head_masked[k] = payload & {66{head_onehot_q[k]}};\n    assign operands_masked[k] = coherent[k] & {64{head_onehot_q[k]}};\n    always_ff @(posedge clock) begin\n      if (hit1) operands[63:32] <= wb_data;\n      if (hit2) operands[31:0] <= wb_data;\n      if (imem_ready && tail_onehot_q[k]) begin\n        payload <= response;\n        operands <= {raw_rs1_data,raw_rs2_data};\n      end\n    end\n  end\n  assign selected_rs1_data = (count_q \"'!= 0) ? head_operands[63:32] : raw_rs1_data;\n  assign selected_rs2_data = (count_q != 0) ? head_operands[31:0] : raw_rs2_data;\n\n'\"'''+s[end:]\nf.write_text(s)\nprint(r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
