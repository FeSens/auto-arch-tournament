tall --dstall]\"\n  },\n  {\n    \"passed\": true,\n    \"elf\": \"selftest.elf\"\n  },\n  {\n    \"passed\": true,\n    \"elf\": \"selftest.elf [--istall --dstall]\"\n  }\n]\n{\n  \"rc\": 0,\n  \"ebreak\": true,\n  \"oob\": false,\n  \"bench_bracketed\": true,\n  \"valid\": true,\n  \"reason\": null,\n  \"cycles\": 4052037\n}\n","exit_code":0,"status":"completed"}}
