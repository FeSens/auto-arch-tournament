{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/555e5898/d34a48d7/probe_prefix.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/555e5898/d34a48d7/prefix_probe')\nroot.mkdir(exist_ok=True)\nrtl=root/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\ns=(rtl/'divider.sv').read_text()\nstart=s.index('  assign launch_remainder[0]')\nend=s.index('  always_comb begin\\\\n    double_divisor',start)\nlines=['  logic neg_a, neg_b, small_divisor;', '  logic [3:0] prefix_nibble, divisor_nibble;', '  logic [7:0] prefix_table;', '  assign neg_a = signed_op && a[31];', '  assign neg_b = signed_op && b[31];', \\\"  assign prefix_nibble = neg_a ? (~a[31:28] + {3'b0, (a[27:0] == 0)}) : a[31:28];\\\", \\\"  assign divisor_nibble = neg_b ? (4'b0 - b[3:0]) : b[3:0];\\\", '  assign small_divisor = neg_b ? ((&b[31:4]) && (|b[3:0])) : \"'!(|b[31:4]);'\"', '  always_comb begin', '    case ({divisor_nibble,prefix_nibble})']\nfor d in range(16):\n for p in range(16):\n  q,r=(p//d,p%d) if d else (15,p)\n  lines.append(f\\\"      8'h{d*16+p:02x}: prefix_table = 8'h{q*16+r:02x};\\\")\nlines += [\\\"      default: prefix_table = 8'b0;\\\", '    endcase', '  end', \\\"  assign launch_digit = small_divisor ? prefix_table[7:4] : 4'b0;\\\", '  assign launch_remainder[4] = small_divisor ? prefix_table[3:0] : prefix_nibble;', '']\ns=s[:start]+'\\\\n'.join(lines)+'\\\\n'+s[end:]\ns=s.replace('  logic [3:0] launch_remainder [0:4];','  wire [3:0] launch_remainder [0:4];\\\\n  for (genvar unused_prefix = 0; unused_prefix < 4; unused_prefix++) begin\\\\n    assign launch_remainder[unused_prefix] = 4\\\\'b0;\\\\n  end')\n(rtl/'divider.sv').write_text(s)\nproof='''\n  always @* begin\n    assert(prefix_nibble == magnitude_a[31:28]);\n    assert(divisor_nibble == magnitude_b[3:0]);\n    assert(small_divisor == \"'!(|magnitude_b[31:4]));\n    if (magnitude_b != 0) begin\n      assert(launch_remainder[4] < magnitude_b);\n      assert(({32'\"'b0, launch_digit} * {4'b0, magnitude_b}) +\n              {32'b0, launch_remainder[4]} == {32'b0, magnitude_a[31:28]});\n    end else begin\n      assert(launch_digit == 4'hf);\n      assert(launch_remainder[4] == magnitude_a[31:28]);\n    end\n    if (divisor_q[33:32] == 0 && divisor_q \"'!= 0 && remainder_q < divisor_q &&\n        triple_divisor_q == divisor_q + (divisor_q << 1)) begin\n      for (integer stage = 0; stage < 2; stage = stage + 1) begin\n        assert(remainder_step[stage+1] < divisor_q);\n        assert(divisor_q * {32'\"'b0, digit[stage]} +\n                {2'b0, remainder_step[stage+1]} == shifted_step[stage]);\n      end\n    end\n    if (divisor_q == 0 && triple_divisor_q == 0 && remainder_q[31:28] == 0) begin\n      assert(digit[0] == 2'd3 && digit[1] == 2'd3);\n      assert(remainder_step[2] == {remainder_q[27:0], quotient_q[31:28]});\n    end\n  end\n'''\n(root/'proof.sv').write_text(s.replace('  always_ff @(posedge clock) begin',proof+'  always_ff @(posedge clock) begin'))\nprint(root)\nPY\npython /srv/hwebench/tmp/555e5898/d34a48d7/probe_prefix.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
