!stall && !divider_wait &&\n                           in.ctrl.is_jalr && !in.ctrl.is_illegal && !misalign_jump;\n  assign recovery_kill = direct_redirect || indirect_launch || indirect_pending_q;\n  assign recovery_wait = indirect_launch || indirect_pending_q;\n  assign redirect = direct_redirect || indirect_pending_q;\n  assign redirect_target = indirect_pending_q ? indirect_target_q : in.direct_recovery_pc;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      indirect_pending_q <= 1'\"'b0;\n      indirect_target_q <= 32'b0;\n    end else begin\n      indirect_pending_q <= indirect_launch;\n      if (indirect_launch) indirect_target_q <= jump_target;\n    end\n  end\n\n'''+s[end:]; p.write_text(s)\np=rtl/'if_stage.sv'; s=p.read_text(); s=s.replace('  input  logic              redirect,','  input  logic              recovery_wait,\\\\n  input  logic              redirect,'); s=s.replace('    end else begin\\\\n      if (storage_accept) pc <= next_pc;','    end else if (recovery_wait) begin\\\\n      count_q <= 3\\\\'d0;\\\\n    end else begin\\\\n      if (storage_accept) pc <= next_pc;'); p.write_text(s)\np=rtl/'core.sv'; s=p.read_text(); s=s.replace('  logic        redirect;','  logic        recovery_kill, recovery_wait;\\\\n  logic        redirect;'); s=s.replace('    .redirect        (redirect),\\\\n    .redirect_target (redirect_target),','    .recovery_wait   (recovery_wait),\\\\n    .redirect        (redirect),\\\\n    .redirect_target (redirect_target),',1); s=s.replace('    .divider_wait    (divider_wait),\\\\n    .redirect        (redirect),','    .divider_wait    (divider_wait),\\\\n    .recovery_kill   (recovery_kill),\\\\n    .recovery_wait   (recovery_wait),\\\\n    .redirect        (redirect),'); s=s.replace('    .redirect       (redirect),','    .redirect       (recovery_kill),'); p.write_text(s)\nprint('Created isolated probe RTL:',rtl)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
