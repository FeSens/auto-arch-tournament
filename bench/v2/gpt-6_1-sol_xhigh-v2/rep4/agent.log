{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport importlib.util\nroot=Path('/srv/hwebench/tmp/555e5898/b96f5cdc/r10-divider-probe')\nspec=importlib.util.spec_from_file_location('original_proof',Path('cores/bench/test/test_divider_formal.py'))\nm=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\ns=(root/'rtl/divider.sv').read_text()\n# Probe storage exists only in proof staging and preserves the independent raw magnitude reference.\nprops='''\n\"'`ifndef RISCV_FORMAL_ALTOPS\n  logic [31:0] reference_full_a_q;\n  always @(posedge clock) begin\n    if (reset) reference_full_a_q <= 0;\n    else if (launch && !busy && (!result_valid || consume) &&\n      (op == ALU_DIV || op == ALU_DIVU || op == ALU_REM || op == ALU_REMU))\n      reference_full_a_q <= (signed_op && a[31]) ? -a : a;\n  end\n  wire [7:0] proof_prefix_q = (|magnitude_b_q[31:8]) ? 8'\"'b0 : {quotient_q[3:0], prefix_digit};\n'''\np=m._PREFIX_EQUIVALENCE.replace('magnitude_a_q','reference_full_a_q').replace('prefix_quotient','proof_prefix_q')\n# Original first nibble reference uses raw Boolean nibble wires; replace by an independent four-bit restoring model.\na=p.index('  assign reference_q[0]')\nb=p.index('  for (genvar stage',a)\np=p[:a]+'''  wire [4:0] nibble_reference_r [0:4];\n  wire [3:0] nibble_reference_q [0:4];\n  assign nibble_reference_r[0] = 0;\n  assign nibble_reference_q[0] = 0;\n  for (genvar stage=0; stage<4; stage++) begin\n    wire [4:0] trial = {nibble_reference_r[stage][3:0],reference_full_a_q[31-stage]};\n    wire fits = magnitude_b_q[31:4]==0 && trial >= {1'b0,magnitude_b_q[3:0]};\n    assign nibble_reference_r[stage+1] = fits ? trial - {1'b0,magnitude_b_q[3:0]} : trial;\n    assign nibble_reference_q[stage+1] = {nibble_reference_q[stage][2:0],fits};\n  end\n  assign reference_q[0] = {4'b0,nibble_reference_q[4]};\n  assign reference_r[0] = {3'b0,nibble_reference_r[4]};\n'''+p[b:]\np=p.replace('  always @* begin','  always @* if (busy && remaining_q == 7) begin')\nprops+=p+'\\\\n\"'`endif'\"\\\\n'\ns=s.replace('  always_ff @(posedge clock) begin',props+'  always_ff @(posedge clock) begin')\nproof=root/'proof';proof.mkdir(exist_ok=True)\n(proof/'divider.sv').write_text(s)\n(proof/'core_pkg.sv').write_text((root/'rtl/core_pkg.sv').read_text())\nprint('Created independent sequential byte-prefix equivalence proof')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
