{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/555e5898/1885ec6f/partitioned_execute_probe'); (p/'test').mkdir(exist_ok=True)\nshutil.copy('cores/bench/test/_helpers.py',p/'test/_helpers.py')\n(p/'test/test_multiplier.py').write_text('''import random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\nMASK=(1<<32)-1\nSIGNED=lambda v: v-(1<<32) if v>>31 else v\n@cocotb.test()\nasync def rv32m_independent_reference(dut):\n    r=random.Random(8021)\n    corners=[0,1,2,0x7fffffff,0x80000000,0x80000001,0xfffffffe,0xffffffff]\n    pairs=[(a,b) for a in corners for b in corners]+[(r.getrandbits(32),r.getrandbits(32)) for _ in range(2048)]\n    for a,b in pairs:\n        products=[a*b,SIGNED(a)*SIGNED(b),a*b,SIGNED(a)*b]\n        for op,value in zip([11,12,13,14],products):\n            expected=(value if op==11 else value>>32)&MASK\n            dut.op.value=op; dut.a.value=a; dut.b.value=b\n            await Timer(1,\\\"ns\\\")\n            assert int(dut.out.value)==expected,(op,a,b,expected,int(dut.out.value))\n    dut.op.value=0\n    await Timer(1,\\\"ns\\\")\n    assert int(dut.out.value)==0\nif __name__==\\\"__main__\\\":\n    run_cocotb(\\\"multiplier\\\",[\\\"core_pkg.sv\\\",\\\"multiplier.sv\\\"],\\\"test_multiplier\\\")\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
