{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/555e5898/378d9cd2/probe_r14.py <<'PY'\nfrom pathlib import Path\nimport shutil, re\nsrc=Path.cwd()\np=Path('/srv/hwebench/tmp/555e5898/378d9cd2/r14-probe')\n(p/'cores/bench').mkdir(parents=True,exist_ok=True)\nfor part in ['rtl','test']:\n shutil.copytree(src/'cores/bench'/part,p/'cores/bench'/part,dirs_exist_ok=True)\nshutil.copy2(src/'cores/bench/core.yaml',p/'cores/bench/core.yaml')\nr=p/'cores/bench/rtl'\n(r/'forward_unit.sv').write_text('''module forward_unit (\n  input logic clock, reset, hold,\n  input logic [4:0] id_rs1, id_rs2, ex_rd,\n  input logic ex_w_en,\n  input logic [4:0] mem_rd,\n  input logic mem_w_en,\n  input logic id_is_auipc, id_alu_src,\n  output logic [2:0] fwd_rs1, fwd_rs2,\n  output logic [3:0] fwd_alu_a, fwd_alu_b\n);\n  logic [2:0] next_rs1, next_rs2;\n  always_comb begin\n    if (ex_w_en && ex_rd \"'!= 0 && ex_rd == id_rs1) next_rs1 = 3'\"'b010;\n    else if (mem_w_en && mem_rd \"'!= 0 && mem_rd == id_rs1) next_rs1 = 3'\"'b100;\n    else next_rs1 = 3'b001;\n    if (ex_w_en && ex_rd \"'!= 0 && ex_rd == id_rs2) next_rs2 = 3'\"'b010;\n    else if (mem_w_en && mem_rd \"'!= 0 && mem_rd == id_rs2) next_rs2 = 3'\"'b100;\n    else next_rs2 = 3'b001;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      fwd_rs1 <= 3'b001; fwd_rs2 <= 3'b001;\n      fwd_alu_a <= 4'b0001; fwd_alu_b <= 4'b0001;\n    end else if (\"'!hold) begin\n      fwd_rs1 <= next_rs1; fwd_rs2 <= next_rs2;\n      fwd_alu_a <= {id_is_auipc, next_rs1 & {3{!id_is_auipc}}};\n      fwd_alu_b <= {id_alu_src, next_rs2 & {3{!id_alu_src}}};\n    end\n  end\nendmodule\n'\"''')\nf=r/'id_stage.sv'; s=f.read_text().replace('  output id_ex_t  out','  output logic decoded_is_auipc,\\\\n  output logic decoded_alu_src,\\\\n  output id_ex_t  out')\ns=s.replace('  // ── ID/EX register','  assign decoded_is_auipc = dec_is_auipc;\\\\n  assign decoded_alu_src = dec_alu_src;\\\\n\\\\n  // ── ID/EX register'); f.write_text(s)\nf=r/'core.sv';s=f.read_text().replace('logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','logic [2:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n  logic [3:0] fwd_alu_a, fwd_alu_b;\\\\n  logic decoded_is_auipc, decoded_alu_src;')\ns=s.replace('    .rs1_addr (rs1_addr_w),','    .decoded_is_auipc(decoded_is_auipc),\\\\n    .decoded_alu_src(decoded_alu_src),\\\\n    .rs1_addr (rs1_addr_w),',1)\ns=s.replace('    .fwd_rs1_sel     (fwd_rs1_sel),','    .fwd_alu_a(fwd_alu_a), .fwd_alu_b(fwd_alu_b),\\\\n    .fwd_rs1_sel     (fwd_rs1_sel),')\ns=s.replace('    .id_rs1      (rs1_addr_w),','    .id_is_auipc(decoded_is_auipc), .id_alu_src(decoded_alu_src),\\\\n    .fwd_alu_a(fwd_alu_a), .fwd_alu_b(fwd_alu_b),\\\\n    .id_rs1      (rs1_addr_w),');f.write_text(s)\nf=r/'ex_stage.sv';s=f.read_text().replace('logic [1:0]         fwd_rs1_sel','logic [2:0]         fwd_rs1_sel').replace('logic [1:0]         fwd_rs2_sel','logic [2:0]         fwd_rs2_sel')\ns=s.replace('  input  logic [31:0]        fwd_ex_mem,','  input  logic [3:0]         fwd_alu_a, fwd_alu_b,\\\\n  input  logic [31:0]        fwd_ex_mem,')\na=s.index('  always_comb begin'); b=s.index('  logic [31:0] alu_result;',a)\ns=s[:a]+'''  assign rs1 = (in.rs1_val & {32{fwd_rs1_sel[0]}}) |\n               (fwd_ex_mem & {32{fwd_rs1_sel[1]}}) |\n               (fwd_mem_wb & {32{fwd_rs1_sel[2]}});\n  assign rs2 = (in.rs2_val & {32{fwd_rs2_sel[0]}}) |\n               (fwd_ex_mem & {32{fwd_rs2_sel[1]}}) |\n               (fwd_mem_wb & {32{fwd_rs2_sel[2]}});\n  logic [31:0] alu_a, alu_b;\n  assign alu_a = ((in.rs1_val & {32{fwd_alu_a[0]}}) |\n                  (fwd_ex_mem & {32{fwd_alu_a[1]}})) |\n                 ((fwd_mem_wb & {32{fwd_alu_a[2]}}) |\n                  (in.pc & {32{fwd_alu_a[3]}}));\n  assign alu_b = ((in.rs2_val & {32{fwd_alu_b[0]}}) |\n                  (fwd_ex_mem & {32{fwd_alu_b[1]}})) |\n                 ((fwd_mem_wb & {32{fwd_alu_b[2]}}) |\n                  (in.imm & {32{fwd_alu_b[3]}}));\n\n'''+s[b:]\ns=s.replace(\\\"fwd_rs1_sel == 2'd1\\\",\\\"fwd_rs1_sel[1]\\\").replace(\\\"fwd_rs2_sel == 2'd1\\\",\\\"fwd_rs2_sel[1]\\\");f.write_text(s)\nf=p/'cores/bench/test/test_pipeline.py';s=f.read_text();s=s.replace('MASK =','MASK =')\ns='''def _selector(value):\n    mask = int(value)\n    assert mask in (1,2,4), f\\\"invalid source mask {mask}\\\"\n    return {1:0,2:1,4:2}[mask]\n\n'''+s if False else s\n# Insert after imports, preserve future-import legality.\ns=s.replace('# ── RV32I instruction encoder helpers', '''def _selector(value):\n    mask = int(value)\n    assert mask in (1, 2, 4), f\\\"invalid source mask {mask}\\\"\n    return {1: 0, 2: 1, 4: 2}[mask]\n\n\n# ── RV32I instruction encoder helpers''')\ns=re.sub(r'int\\\\((dut\\\\.u_fwd\\\\.fwd_rs[12]\\\\.value)\\\\)',r'_selector(\\\\1)',s);f.write_text(s)\nf=p/'cores/bench/test/test_ex_stage.py';s=f.read_text();s=re.sub(r'(\\\\s*)dut\\\\.fwd_rs([12])_sel\\\\.value = ([\"'^'\"\\\\n]+)',lambda m:m[1]+'dut.fwd_rs'+m[2]+'_sel.value = 1 << ('+m[3]+')'+m[1]+'dut.fwd_alu_'+('a' if m[2]=='1' else 'b')+'.value = 1 << ('+m[3]+')',s);f.write_text(s)\nprint(p)\nPY\npython /srv/hwebench/tmp/555e5898/378d9cd2/probe_r14.py\npython - <<'PY'\nfrom pathlib import Path\nimport subprocess\nr=Path('/srv/hwebench/tmp/555e5898/378d9cd2/r14-probe/cores/bench/rtl')\nsrc=[r/'core_pkg.sv']+sorted(f for f in r.glob('*.sv') if f.name\"'!='\"'core_pkg.sv')\np=subprocess.run(['verilator','--lint-only','-Wall','-Wno-MULTITOP','-sv','+incdir+'+str(r),*map(str,src)],capture_output=True,text=True)\nprint(p.stdout+p.stderr);print('lint exit',p.returncode)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
