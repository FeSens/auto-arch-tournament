{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/555e5898/7a5f92cb/tree_compare');rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv';s=p.read_text()\nf='''\n  function automatic logic tree_unsigned_lt(input logic [31:0] x, input logic [31:0] y);\n    logic [7:0] lt0, eq0;\n    logic [3:0] lt1, eq1;\n    logic [1:0] lt2, eq2;\n    for (integer k=0;k<8;k=k+1) begin\n      lt0[k] = x[k*4+:4] < y[k*4+:4];\n      eq0[k] = x[k*4+:4] == y[k*4+:4];\n    end\n    for (integer k=0;k<4;k=k+1) begin\n      lt1[k] = lt0[2*k+1] | (eq0[2*k+1] & lt0[2*k]);\n      eq1[k] = eq0[2*k+1] & eq0[2*k];\n    end\n    for (integer k=0;k<2;k=k+1) begin\n      lt2[k] = lt1[2*k+1] | (eq1[2*k+1] & lt1[2*k]);\n      eq2[k] = eq1[2*k+1] & eq1[2*k];\n    end\n    tree_unsigned_lt = lt2[1] | (eq2[1] & lt2[0]);\n  endfunction\n'''\ns=s.replace('\"'`endif // CORE_PKG_DEFINED'\"',f+'\\\\n\"'`endif // CORE_PKG_DEFINED'\"');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text()\ns=s.replace('  logic        branch_cond;','  logic        branch_cond;\\\\n  wire branch_lt_u = tree_unsigned_lt(rs1,rs2);\\\\n  wire branch_lt_s = (rs1[31] \"'^ rs2[31]) ? rs1[31] : branch_lt_u;'\"')\ns=s.replace('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_lt_s').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!branch_lt_s'\"').replace('(rs1 <  rs2)','branch_lt_u').replace('(rs1 >= rs2)','\"'!branch_lt_u'\"');p.write_text(s)\np=rtl/'alu.sv';s=p.read_text()\ns=s.replace('  logic        [4:0]  shamt;','  logic        [4:0]  shamt;\\\\n  wire alu_lt_u = tree_unsigned_lt(a,b);\\\\n  wire alu_lt_s = (a[31] \"'^ b[31]) ? a[31] : alu_lt_u;'\"')\ns=s.replace('\"'$signed(a) < $signed(b)'\"','alu_lt_s').replace(\\\"{31'b0, a < b}\\\",\\\"{31'b0, alu_lt_u}\\\");p.write_text(s)\nprint('Created balanced eigh