{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'radix16g/test/test_alu.py'\ns=p.read_text()\ns=s.replace('        assert int(dut.div_busy.value), f\\\"completed early at edge {edge}\\\"', '''        assert int(dut.div_busy.value), f\\\"completed early at edge {edge}\\\"\n        assert bool(int(dut.u_divider.small4_q.value)) == (magnitude_b < 16)\n        assert bool(int(dut.u_divider.small8_q.value)) == (magnitude_b < 256)''')\ns+='''\n\n@cocotb.test()\nasync def radix16_digit_boundaries_and_captured_width_guards(dut):\n    await _setup(dut)\n    values=set()\n    for b in (0, 1, 2, 3, 7, 15, 16, 17, 31, 63, 127, 255, 256, 257,\n              65535, 65536, 0x0fffffff, 0x10000000, 0x7fffffff, 0x80000000, 0xffffffff):\n        for digit in range(16):\n            for adjust in (-1, 0, 1):\n                a=b*digit+adjust\n                if 0 <= a <= MASK32:\n                    values.add((a,b))\n    rng=random.Random(0x16A7)\n    values.update((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(2048))\n    for a,b in sorted(values):\n        for op in (ALU_DIV,ALU_DIVU,ALU_REM,ALU_REMU):\n            await _check_div(dut,op,a,b,_reference_div(op,a,b))\n'''\np.write_text(s)\nprint('Added independent arithmetic boundary checks and captured-guard association assertions to isolated test suite.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'radix16g/test/test_alu.py'\ns=p.read_text()\ns=s.replace('        assert int(dut.div_busy.value), f\\\"completed early at edge {edge}\\\"', '''        assert int(dut.div_busy.value), f\\\"completed early at edge {edge}\\\"\n        assert bool(int(dut.u_divider.small4_q.value)) == (magnitude_b < 16)\n        assert bool(int(dut.u_divider.small8_q.value)) == (magnitude_b < 256)''')\ns+='''\n\n@cocotb.test()\nasync def radix16_digit_boundaries_and_captured_width_guards(dut):\n    await _setup(dut)\n    values=set()\n    for b in (0, 1, 2, 3, 7, 15, 16, 17, 31, 63, 127, 255, 256, 257,\n              65535, 65536, 0x0fffffff, 0x10000000, 0x7fffffff, 0x80000000, 0xffffffff):\n        for digit in range(16):\n            for adjust in (-1, 0, 1):\n                a=b*digit+adjust\n                if 0 <= a <= MASK32:\n                    values.add((a,b))\n    rng=random.Random(0x16A7)\n    values.update((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(2048))\n    for a,b in sorted(values):\n        for op in (ALU_DIV,ALU_DIVU,ALU_REM,ALU_REMU):\n            await _check_div(dut,op,a,b,_reference_div(op,a,b))\n'''\np.write_text(s)\nprint('Added independent arithmetic boundary checks and captured-guard association assertions to isolated test suite.')\nPY\"","aggregated_output":"Added independent arithmetic boundary checks and captured-guard association assertions to isolated test suite.\n","exit_code":0,"status":"completed"}}
