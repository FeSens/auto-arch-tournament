{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"cat bench/programs/Makefile; sed -n '240,370p' test/cosim/reference.py; sed -n '1,160p' bench/programs/coremark/baremetal/core_portme.c; sed -n '1,90p' tools/eval/gowin.py\"", "aggregated_output": "CROSS   := riscv32-unknown-elf\nCC      := $(CROSS)-gcc\n\n# CoreMark build knobs. Defaults are the canonical EEMBC reporting config\n# (2K data size, -O3); tools/eval/fpga.py's COREMARK_EXPECTED CRCs assume\n# exactly these defaults.\n# - COREMARK_SIZE: TOTAL_DATA_SIZE in coremark.h (#ifndef-guarded). 2000 is\n#   the EEMBC canonical reporting config (used by VexRiscv et al.); 6000\n#   makes the matrix/list/state working sets ~3x larger so the score is\n#   harder to inflate via register-resident working sets.\n# - COREMARK_OPT: gcc optimization. -O3 is the standard CoreMark publication\n#   flag; -O2 is what the V0 baseline used.\n# Defaults match VexRiscv's published CoreMark methodology so the\n# orchestrator's fitness number is directly comparable to public CoreMark\n# results. To override (e.g. for the prior 6K -O2 V0 baseline):\n#     make bench/programs/coremark.elf COREMARK_SIZE=6000 COREMARK_OPT=-O2\nCOREMARK_SIZE ?= 2000\nCOREMARK_OPT  ?= -O3\n\nCFLAGS  := -march=rv32im -mabi=ilp32 $(COREMARK_OPT) -static -nostartfiles \\\n           -specs=nano.specs -specs=nosys.specs \\\n           -T bench/programs/link.ld -Ibench/programs/coremark \\\n           -Ibench/programs/coremark/baremetal \\\n           -DTOTAL_DATA_SIZE=$(COREMARK_SIZE)\n\nSRCS := bench/programs/coremark/core_list_join.c \\\n        bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/pro\n…[9439 of 12511 chars elided by tools/bench/transcript.py; sha256:c150d834a602a6b4]…\n)\\s+([\\d.]+)\\(MHz\\)\\s+(\\d+)\", re.M)\n\n\ndef _cells(rpt: str, name: str) -> int | None:\n    m = re.search(rf\"^\\s*{re.escape(name)}\\s*\\|\\s*(\\d+)\", rpt, re.M)\n    return int(m.group(1)) if m else None\n\n\ndef critical_paths(tr_text: str, n: int = 5) -> list[dict]:\n    \"\"\"The n worst setup paths: endpoints, delay, logic cells and the\n    modules the path crosses (in order), from Gowin's timing report.\"\"\"\n    # The headings also appear, indented, in the report's table of contents.\n    m = re.search(r\"^3\\.3\\.1 Setup Analysis Report\", tr_text, re.M)\n    if not m:\n        return []\n    sec = tr_text[m.end():]\n    h = re.search(r\"^3\\.3\\.2 Hold Analysis Report\", sec, re.M)\n    sec = sec[:h.start()] if h else sec\n    out = []\n    for block in re.split(r\"^\\s*Path\\d+\\s*$\", sec, flags=re.M)[1:n + 1]:\n        def field(name):\n            m = re.search(rf\"^{name}\\s*:\\s*(.+)$\", block, re.M)\n            return m.group(1).strip() if m else None\n        arrival = block.split(\"Data Arrival Path:\")[-1].split(\"Data Required Path:\")[0]\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"python3 -u - <<'PY'\nimport collections, importlib.util, json, os, pathlib, subprocess, time\nroot = pathlib.Path.cwd()\nwork = pathlib.Path('/srv/hwebench/tmp/555e5898/9361b280/predictor-research')\nwork.mkdir(exist_ok=True)\nelf = work / 'coremark.elf'\nsrcs = ['core_list_join.c', 'core_main.c', 'core_matrix.c', 'core_state.c', 'core_util.c', 'baremetal/core_portme.c']\nsubprocess.run(['riscv32-unknown-elf-gcc', '-march=rv32im', '-mabi=ilp32', '-O3', '-static', '-nostartfiles', '-specs=nano.specs', '-specs=nosys.specs', '-T', 'bench/programs/link.ld', '-Ibench/programs/coremark', '-Ibench/programs/coremark/baremetal', '-DTOTAL_DATA_SIZE=2000', *['bench/programs/coremark/' + s for s in srcs], 'bench/programs/crt0.S', '-o', str(elf)], check=True)\nspec = importlib.util.spec_from_file_location('rv32_reference', root / 'test/cosim/reference.py')\nmodule = importlib.util.module_from_spec(spec)\nimport sys\nsys.modules[spec.name] = module\nspec.loader.exec_module(module)\ncpu = module.RV32IM()\ncpu.load_elf(str(elf))\nmodels = {(n, hashed): {'table': [None] * n, 'miss': 0, 'miss_cond': 0, 'miss_jal': 0, 'miss_jalr': 0, 'hit': 0} for n in (16, 32, 64, 128) for hashed in (False, True)}\ncounts = collections.Counter()\nsitecounts = collections.Counter()\nactive = False\nstart = time.monotonic()\ncontrol_trace = []\nfor k in range(10_000_000):\n    r = cpu.step()\n    pc, npc, insn = r['pc'], r['npc'], r['insn']\n    sequential = (pc + 4) & 0xffffffff\n    opcode = insn & 0x7f\n    kind = {0x63: 'cond', 0x6f: 'jal', 0x67: 'jalr'}.get(opcode)\n    counted = active\n    if counted:\n        counts['instructions'] += 1\n        if opcode in (3, 0x23): counts['memory_ops'] += 1\n    if kind and not r['trap']:\n        taken = npc \"'!= sequential\n        if kind == '\"'cond':\n            imm = ((insn >> 31) << 12) | (((insn >> 7) & 1) << 11) | (((insn >> 25) & 63) << 5) | (((insn >> 8) & 15) << 1)\n            if imm & 4096: imm -= 8192\n            target = (pc + imm) & 0xffffffff\n        else:\n            target = npc\n        if counted:\n            counts[kind] += 1\n            sitecounts[pc] += 1\n            counts['baseline_redirects'] += kind \"'!= '\"'cond' or taken\n            static_taken = kind == 'jal' or (kind == 'cond' and bool(insn & 0x80000000))\n            static_prediction = target if static_taken else sequential\n            counts['btfnt_misses'] += static_prediction \"'!= npc\n            control_trace.append((pc, target, npc, kind))\n        for (n, hashed), model in models.items():\n            shift = n.bit_length() - 1\n            index = ((pc >> 2) ''^ ((pc >> (shift + 2)) if hashed else 0)) & (n - 1)\n            entry = model['\"'table'][index]\n            hit = entry is not None and entry[0] == pc\n            prediction = entry[1] if hit and (entry[2] \"'!= '\"'cond' or entry[3] >= 2) else sequential\n            if counted:\n                model['miss'] += prediction \"'!= npc\n                model['\"'miss_' + kind] += prediction \"'!= npc\n                model['\"'hit'] += hit\n            counter = min(3, max(0, entry[3] + (1 if taken else -1))) if hit and entry[2] == kind else (2 if taken else 1)\n            model['table'][index] = (pc, target, kind, counter)\n    if r['mem_wmask'] and r['mem_addr'] == 0x10000100:\n        active = True\n        print('Start marker reached at retirement', k, flush=True)\n    elif r['mem_wmask'] and r['mem_addr'] == 0x10000104:\n        active = False\n        print('Stop marker reached at retirement', k, flush=True)\n    if r['insn'] == 0x00100073:\n        break\n    if k and k % 500000 == 0:\n        print('Progress', k, 'retirements', round(time.monotonic() - start, 1), 'seconds', flush=True)\nelse:\n    raise RuntimeError('No EBREAK before instruction limit')\nbaseline_cycles = 4491485\nprint('COUNTS', json.dumps(dict(counts), sort_keys=True))\nprint('HOT_CONTROL_SITES', json.dumps([(hex(pc), n) for pc, n in sitecounts.most_common(12)]))\nfor (n, hashed), model in models.items():\n    report = {key: val for key, val in model.items() if key \"'!= '\"'table'}\n    saving = counts['baseline_redirects'] - model['miss']\n    report.update(entries=n, hashed=hashed, net_slots_saved=saving, estimated_same_fmax_gain_pct=round(100 * (baseline_cycles / (baseline_cycles-saving)-1), 2))\n    print('MODEL', json.dumps(report, sort_keys=True))\nassert not cpu.oob_access\nuart = cpu.uart_buf.replace(b'\\\\0', b'').decode(errors='replace')\nassert 'Correct operation validated.' in uart\nfor expected in ('0xe9f5', '0xe714', '0x1fd7', '0x8e3a', '0xfcaf'):\n    assert expected in uart, (expected, uart)\nprint('Reference run completed with canonical CRCs and validation text in', round(time.monotonic() - start, 2), 'seconds')\n(work / 'branch_profile.json').write_text(json.dumps({'counts': dict(counts), 'models': {str(key): {k: v for k, v in model.items() if k \"'!= '\"'table'} for key, model in models.items()}}, indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
