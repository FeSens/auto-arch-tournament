 build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"Runs the real riscv-formal suite via formal/run_all.sh.\n\nThe real suite is generated at runtime by formal/run_all.sh (which invokes\ngenchecks.py against our rtl/*.sv + wrapper.sv\n…[17594 of 20666 chars elided by tools/bench/transcript.py; sha256:13f78493794f9b56]…\n== previous_selectors, \"held bypass selectors changed\"\n        hold_id = int(dut.u_id.hold.value)\n        if hold_id:\n            assert held\n            if payload & 1 and (payload >> (len(dut.u_id.out) - 1)) & 1:\n                waits[\"predicted_hold\"] += 1\n        previous_payload = (hold_id, payload)\n        previous_selectors = selectors\n\n    accesses = []\n    rets, dmem = await _run(dut, program, {64: 2}, max_cycles=250,\n                            bus_ready=ready, observe=observe, accesses=accesses)\n    _check_sequence(rets, [0, 4, 8] + [12, 16, 20, 24, 28] * 3 + [32, 36])\n    assert all(waits.values()) and load_stalls == store_stalls == 0\n    assert [r[\"rs1_rdata\"] for r in rets if r[\"pc\"] == 28] == [2, 1, 0]\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 12] == [3, 2, 1]\n    assert dmem == {64: 0, 68: 1}\n    assert [(a, w, r) for _, a, w, r, _ in accesses] == [\n        (64, 15, 0), (64, 0, 1), (64, 15, 0), (64, 0, 1),\n        (64, 15, 0), (64, 0, 1), (64, 15, 0), (68, 15, 0)]\n\n\n@cocotb.test()\n", "exit_code": 0, "status": "completed"}}
