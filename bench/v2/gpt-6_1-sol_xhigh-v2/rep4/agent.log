, 1, funct3, 0x63)\n                program = [ADDI(1, 0, a), ADDI(2, 0, b)]\n                if backward:\n                    program += [JAL(7, 12), ADDI(3, 0, 42), JAL(8, 8),\n                                branch, SW(3, 0, 64), EBREAK()]\n                    pcs = [0, 4, 8, 20] + ([12, 16] if tak\n…[11951 of 15023 chars elided by tools/bench/transcript.py; sha256:6d86cdc7ee83431b]…\nrs2.value) == 0\n            assert not int(dut.u_ex.u_alu.div_busy.value)\n            assert not int(dut.u_ex.u_alu.div_result_valid.value)\n            assert not int(dut.io_rvfi_valid_0.value)\n            assert int(dut.io_rvfi_order_0.value) == 0\n            break\n    else:\n        raise AssertionError(\"divider never launched before reset\")\n    rets, dmem = await _run(dut, [JAL(1, 8), SW(0, 0, 64),\n                                 ADD(2, 1, 0), EBREAK()])\n    _check_sequence(rets, [0, 8, 12])\n    assert rets[1][\"rs1_rdata\"] == rets[1][\"rd_wdata\"] == 4\n    assert not dmem\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"divider.sv\", \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"branch_predictor.sv\", \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
