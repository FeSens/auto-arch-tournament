{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os,shutil,subprocess\nroot=Path(os.environ['TMPDIR'])/'r10-mux-prototype'\nf=root/'formal';f.mkdir(exist_ok=True)\nfor name in ['run_all.sh','wrapper.sv','wrapper_si.sv','checks.cfg','checks_si.cfg','checks-deep.cfg']:shutil.copy2(Path('formal')/name,f/name)\nshared=Path('formal/riscv-formal').resolve()\nfor name in ['checks','insns','bus','monitor']:shutil.copytree(shared/name,f/'riscv-formal'/name,dirs_exist_ok=True)\n(f/'riscv-formal/cores').mkdir(exist_ok=True)\n(root/'cores/bench').mkdir(parents=True,exist_ok=True)\nshutil.copy2('cores/bench/core.yaml',root/'cores/bench/core.yaml')\ns=(root/'rtl/divider.sv').read_text()\nstart=s.index('  for (genvar k = 0; k < 8; k++) begin : pairs')\nend=s.index('  always_comb begin\\\\n    result',start)\nbody=s[start:end]\np=root/'proof';p.mkdir(exist_ok=True)\nsource='''module selection_proof(input [3:0] rank,input [511:0] payload);\n  wire [16:0] fit;\n  wire [31:0] candidate_r [0:15], pair_r [0:7], quad_r [0:3], oct_r [0:1];\n  wire [3:0] candidate_digit [0:15], pair_digit [0:7],quad_digit [0:3],oct_digit [0:1];\n  wire [31:0] remainder_next, quotient_next;\n  wire [31:0] quotient_q = 0;\n  wire [3:0] digit;\n  wire [31:0] old_mask [0:15];\n  wire [3:0] old_digit_mask [0:15];\n  assign fit[16]=0;\n  for(genvar k=0;k<16;k++)begin\n    assign fit[k]=(k<=rank);\n    assign candidate_r[k]=payload[k*32+:32];\n    assign candidate_digit[k]=4'(k);\n    assign old_mask[k]=candidate_r[k]&{32{fit[k]&&\"'!fit[k+1]}};\n    assign old_digit_mask[k]=4'\"'(k)&{4{fit[k]&&\"'!fit[k+1]}};\n  end\n'\"'''+body\nsource+='  wire [31:0] old_r = '+' | '.join('old_mask[%d]'%k for k in range(16))+';\\\\n'\nsource+='  wire [3:0] old_digit = '+' | '.join('old_digit_mask[%d]'%k for k in range(16))+';\\\\n'\nsource+='  always @* begin assert(remainder_next==old_r); assert(digit==old_digit); end\\\\nendmodule\\\\n'\n(p/'selection_proof.sv').write_text(source)\nr=subprocess.run(['yosys','-Q','-T','-p','read_verilog -sv -formal selection_proof.sv; prep -top selection_proof; flatten; chformal -lower; sat -prove-asserts -verify -set-def-inputs'],cwd=p,capture_output=True,text=True,timeout=40)\n(p/'proof.log').write_text(r.stdout+r.stderr)\nassert r.returncode==0,(r.stdout+r.stderr)[-2500:]\nprint('Production mux-tree versus masked-OR equivalence: PASS')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
