{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"sed -n '100,145p' cores/bench/test/test_alu.py\"","aggregated_output":"async def _check_div(dut, op, a, b, expected):\n    assert not int(dut.div_busy.value)\n    assert not int(dut.div_result_valid.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_launch.value = 1\n    await _tick(dut)\n    dut.div_launch.value = 0\n    signed = op in (ALU_DIV, ALU_REM)\n    sa, sb = a & MASK32, b & MASK32\n    if signed:\n        sa = sa if sa < 0x80000000 else sa - (1 << 32)\n        sb = sb if sb < 0x80000000 else sb - (1 << 32)\n    magnitude_a, magnitude_b = abs(sa), abs(sb)\n    # Changing inputs and attempting another launch cannot alter an\n    # accepted request. Launch captures only; edge two consumes eight bits.\n    for edge in range(1, 8):\n        assert int(dut.div_busy.value), f\"completed early at edge {edge}\"\n        assert not int(dut.div_result_valid.value)\n        bits_consumed = 0 if edge == 1 else 4 * edge\n        prefix = magnitude_a >> (32 - bits_consumed)\n        remainder = int(dut.u_divider.remainder_q.value)\n        assert remainder == (prefix % magnitude_b if magnitude_b else prefix)\n        assert remainder < magnitude_b if magnitude_b else remainder <= MASK32\n        prefix_quotient = prefix // magnitude_b if magnitude_b else (1 << bits_consumed) - 1\n        assert int(dut.u_divider.quotient_q.value) == (\n            ((magnitude_a << bits_consumed) & MASK32) | prefix_quotient\n        ), f\"incorrect quotient prefix at edge {edge}\"\n        assert int(dut.u_divider.remaining_q.value) == 8 - edge\n        if edge >= 2:\n            for multiple, name in ((1, \"divisor_q\"), (3, \"triple_divisor_q\"),\n                    (5, \"five_divisor_q\"), (7, \"seven_divisor_q\"),\n                    (9, \"nine_divisor_q\"), (11, \"eleven_divisor_q\"),\n                    (13, \"thirteen_divisor_q\"), (15, \"fifteen_divisor_q\")):\n                assert int(getattr(dut.u_divider, name).value) == multiple * magnitude_b\n        dut.a.value = (a + edge * 19) & MASK32\n        dut.b.value = (b ^ (edge * 31)) & MASK32\n        dut.op.value = ALU_REMU\n        dut.div_launch.value = edge == 3\n        await _tick(dut)\n    dut.div_launch.value = 0\n    assert not int(dut.div_busy.value)\n    assert int(dut.div_result_valid.value), \"missing result on edge eight\"\n    remainder = int(dut.u_divider.remainder_q.value)\n    assert remainder == (magnitude_a % magnitude_b if magnitude_b else magnitude_a)\n","exit_code":0,"status":"completed"}}
