{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom itertools import product\nchecked=0\nfor n,ready,stall,reset,redirect in product(range(5),[0,1],[0,1],[0,1],[0,1]):\n v=(1<<n)-1\n bits=[bool(v&(1<<i)) for i in range(4)]\n pop=bits[0] and not stall\n accept=ready and (not bits[3] or pop)\n bypass=not bits[0] and not stall\n enq=accept and not bypass\n boundary_no=[not bits[0],bits[0] and not bits[1],bits[1] and not bits[2],bits[2] and not bits[3]]\n boundary_pop=[bits[0] and not bits[1],bits[1] and not bits[2],bits[2] and not bits[3],bits[3]]\n app=[enq and b for b in (boundary_pop if pop else boundary_no)]\n assert sum(app)==int(enq)\n if enq: assert app[n-int(pop)]\n nextv=0 if reset or redirect else ((v<<1|1)&15) if enq and not pop else (v>>1) if pop and not enq else v\n nextn=0 if reset or redirect else n+int(enq)-int(pop)\n assert nextv==(1<<nextn)-1\n checked+=1\nprint('All',checked,'control/occupancy combinations match integer occupancy and append index')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
