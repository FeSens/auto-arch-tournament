{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"git status --short\nsed -n '115,170p' cores/bench/rtl/ex_stage.sv\nrg -n 'CPU|cpu|time|Total|Elapsed' cores/bench/generated/timing/gowin_p0/gw.log | tail -12\nls cores/bench/test\"","aggregated_output":" M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/id_stage.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_id_stage.py\n M cores/bench/test/test_pipeline.py\n?? cores/bench/rtl/branch_predictor.sv\n?? cores/bench/test/test_branch_predictor.py\n  // instruction, suppress the redirect (PC stays linear), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n\n  // Legal aligned direct controls use the same target in IF and EX, so\n  // only their direction bit needs recovery. JALR is always resolved here.\n  logic direct_taken;\n  assign direct_taken = !misalign_fault && !in.ctrl.is_illegal &&\n                        (branch_taken || (in.ctrl.is_jump && !in.ctrl.is_jalr));\n  assign redirect = in.valid && !reset && !stall && !divider_wait &&\n                    ((direct_taken ^ in.predicted_taken) ||\n                     (in.ctrl.is_jalr && !misalign_fault && !in.ctrl.is_illegal));\n  // A predicted-taken correction is a loop exit; every other correction\n  // uses the resolved target, including sequentially predicted JALR.\n  assign redirect_target = in.predicted_taken ? (in.pc + 32'd4)\n                           : (in.ctrl.is_jump ? jump_target : branch_target);\n\n  // ── EX/MEM register ───────────────────────────────────────────────────\n  ex_mem_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (stall) begin\n      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\n      // stays in MEM stage waiting on the bus.\n      reg_q <= reg_q;\n    end else if (divider_wait) begin\n      // Older instructions drain once while ID/EX holds the divide.\n      // Only a genuine dmem stall above retains an EX/MEM request.\n      reg_q <= '0;\n    end else begin\n      reg_q.pc            <= in.pc;\n      // For JAL/JALR, the rd_wdata is PC+4 (return address), not the ALU's\n      // sum (which is the jump target). The MEM/WB register's read-data\n      // mux only kicks in for LOADs, so we route PC+4 here.\n      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n__pycache__\n_helpers.py\nconftest.py\ntest_alu.py\ntest_branch_predictor.py\ntest_branch_predictor_runner.result.xml\ntest_decoder.py\ntest_divider_formal.py\ntest_id_stage.py\ntest_id_stage_runner.result.xml\ntest_imm_gen.py\ntest_pipeline.py\ntest_pipeline_runner.result.xml\ntest_reg_file.py\n","exit_code":0,"status":"completed"}}
