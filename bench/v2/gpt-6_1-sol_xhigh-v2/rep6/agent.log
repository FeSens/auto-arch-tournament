{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'rg --files cores/bench/test; cat cores/bench/rtl/if_stage.sv cores/bench/rtl/hazard_unit.sv; cat cores/bench/test/test_id_stage.py'", "aggregated_output": "cores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_div_unit.py\ncores/bench/test/test_ex_stage.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_id_stage.py\ncores/bench/test/test_mul_unit.py\ncores/bench/test/test_alu.py\n// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// Raw instruction bits never depend on EX recovery. Validity and the\n// ID/EX register squash discard an unavailable or wrong-path fetch.\n// Direct targets and pc+4 are added in parallel with a direction lookup;\n// prediction selects completed addresses rather than an adder operand.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // invalidate this fetch\n  input  logic              redirect,         // advancing EX prediction correction\n  input  logic [31:0]       redirect_target,\n  input  logic              branch_update,\n  input  logic [6:0]        branch_index,\n  input  logic              branch_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] sequential_pc, direct_imm, direct_target;\n  logic direct_branch, direct_jal, predicted_taken;\n  logic [1:0] counters [0:127];\n\n  always_comb begin\n    direct_branch = imem_data[6:0] == 7'b1100011\n                    && imem_data[14:12] != 3'd2\n    \n…[8159 of 11231 chars elided by tools/bench/transcript.py; sha256:b49438aef97475da]…\nDBEEF\n        dut.fwd_mem_data.value = 0xCAFEBABE\n        after = await _edge(dut)\n        if stall:\n            assert after & _PAYLOAD_MASK == before & _PAYLOAD_MASK\n        else:\n            assert after >> 263 == 0xA0  # PC advances on every unstalled edge\n            assert (after >> 34) & 0xFFFFFFFF == 0xABCD1297\n            assert (after >> 1) & 0xFFFFFFFF == 0xCC\n            assert after & _PAYLOAD_MASK != before & _PAYLOAD_MASK\n        if flush or (not stall and not valid):\n            assert after & _CONTROL_MASK == 0\n        elif stall:\n            assert after & _CONTROL_MASK == before & _CONTROL_MASK\n        else:\n            assert after & 1 and after & _PRED_MASK\n            assert (after >> 66) & ((1 << 22) - 1) == int(dut.ctrl_decoded.value)\n\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 0\n    assert await _edge(dut) == 0\n\n\ndef test_id_stage_runner():\n    run_cocotb(\"id_stage\", [\"core_pkg.sv\", \"decoder.sv\", \"imm_gen.sv\", \"id_stage.sv\"],\n               \"test_id_stage\")\n", "exit_code": 0, "status": "completed"}}
