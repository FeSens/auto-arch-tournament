{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nbase=Path(os.environ['TMPDIR'])/'r12s0-probes'\nfor name in ['shift_modes','shift_onehot']:\n rtl=base/name/'rtl'\n shutil.copytree(base/'shared_shift/rtl',rtl,dirs_exist_ok=True)\n p=rtl/'core_pkg.sv';s=p.read_text().replace('    logic [31:0] alu_b;','    logic [31:0] alu_b;\\\\n    logic        shift_left;\\\\n    logic        shift_arith;');p.write_text(s)\n p=rtl/'id_stage.sv';s=p.read_text().replace('        reg_q.alu_b    <= dec_alu_src ? imm : rs2_value;','        reg_q.alu_b    <= dec_alu_src ? imm : rs2_value;\\\\n        reg_q.shift_left <= dec_alu_op == ALU_SLL;\\\\n        reg_q.shift_arith <= dec_alu_op == ALU_SRA;');p.write_text(s)\n p=rtl/'alu.sv';s=p.read_text().replace('module alu (','module alu #(parameter PREDECODED_SHIFT = 0) (').replace('  output logic [31:0] out','  input logic shift_left_in,\\\\n  input logic shift_arith_in,\\\\n  output logic [31:0] out').replace('assign shift_left = op == ALU_SLL;', 'assign shift_left = PREDECODED_SHIFT ? shift_left_in : (op == ALU_SLL);').replace('assign shift_signed = op == ALU_SRA;', 'assign shift_signed = PREDECODED_SHIFT ? shift_arith_in : (op == ALU_SRA);');p.write_text(s)\n p=rtl/'ex_stage.sv';s=p.read_text().replace('  alu u_alu (','  alu #(.PREDECODED_SHIFT(1)) u_alu (').replace('    .op  (in.ctrl.alu_op),','    .op  (in.ctrl.alu_op),\\\\n    .shift_left_in (in.shift_left),\\\\n    .shift_arith_in (in.shift_arith),');p.write_text(s)\n# Replace binary right barrel with 4x8 two-stage mask selections in second probe.\np=base/'shift_onehot/rtl/alu.sv';s=p.read_text()\ns=s.replace('  assign signed_shifted = signed_input >>> b[4:0];','''  logic [3:0] low_select;\n  logic [7:0] high_select;\n  logic signed [32:0] low_shifted;\n  always_comb begin\n    low_select = 4'b0001 << b[1:0];\n    high_select = 8'b00000001 << b[4:2];\n    low_shifted = '0;\n    signed_shifted = '0;\n    for (int j = 0; j < 4; j++)\n      low_shifted = low_shifted | ((\"'$signed(signed_input) >>> j) & {33{low_select[j]}});\n    for (int j = 0; j < 8; j++)\n      signed_shifted = signed_shifted | (($signed(low_shifted) >>> (j*4)) & {33{high_select[j]}});\n  end'\"''')\np.write_text(s)\nprint('prepared shift mode probes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
