{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'rg --files cores/bench/sim_build | head -15\ncat tools/eval/_slots.py\nls -l \"$TMPDIR\"/bench-*.log'","aggregated_output":"cores/bench/sim_build/div_unit/Vtop__pch.h\ncores/bench/sim_build/div_unit/verilated_vpi.d\ncores/bench/sim_build/div_unit/div_unit\ncores/bench/sim_build/div_unit/Vtop__ALL.d\ncores/bench/sim_build/div_unit/Vtop__ver.d\ncores/bench/sim_build/div_unit/Vtop.h\ncores/bench/sim_build/div_unit/verilated_vpi.o\ncores/bench/sim_build/div_unit/Vtop.mk\ncores/bench/sim_build/div_unit/verilated.o\ncores/bench/sim_build/div_unit/Vtop___024root__0__Slow.cpp\ncores/bench/sim_build/div_unit/Vtop__Dpi.h\ncores/bench/sim_build/div_unit/Vtop_classes.mk\ncores/bench/sim_build/div_unit/Vtop__ALL.a\ncores/bench/sim_build/div_unit/verilated_dpi.o\ncores/bench/sim_build/div_unit/verilated_dpi.d\n\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n-rw-rw----+ 1 hwebench3 hwebench3   5009 Oct  2 20:21 /srv/hwebench/tmp/6b356b5e/d8832785/bench-cosim.log\n-rw-rw----+ 1 hwebench3 hwebench3 254179 Oct  2 20:19 /srv/hwebench/tmp/6b356b5e/d8832785/bench-formal.log\n-rw-rw----+ 1 hwebench3 hwebench3    314 Oct  2 20:21 /srv/hwebench/tmp/6b356b5e/d8832785/bench-programs.log\n-rw-rw----+ 1 hwebench3 hwebench3      0 Oct  2 20:21 /srv/hwebench/tmp/6b356b5e/d8832785/bench-timing-median.log\n-rw-rw----+ 1 hwebench3 hwebench3     34 Oct  2 20:21 /srv/hwebench/tmp/6b356b5e/d8832785/bench-timing.log\n-rw-rw----+ 1 hwebench3 hwebench3     99 Oct  2 20:21 /srv/hwebench/tmp/6b356b5e/d8832785/bench-units.log\n","exit_code":0,"status":"completed"}}
