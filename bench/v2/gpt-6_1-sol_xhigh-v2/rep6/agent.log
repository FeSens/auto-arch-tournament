{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport subprocess,json,collections,struct\nfrom pathlib import Path\ncounts=collections.Counter(); sites=collections.defaultdict(collections.Counter); ras=[]; ras_hits=0; active=False\nout=Path('/srv/hwebench/tmp/6b356b5e/c0f8be90/r11-control-trace.bin').open('wb')\np=subprocess.Popen(['cores/bench/obj_dir/cosim_sim','bench/programs/coremark.elf','10000000','--istall','--dstall'],stdout=subprocess.PIPE,text=True)\nfor line in p.stdout:\n if not line.startswith('{'): continue\n e=json.loads(line)\n if 'insn' not in e:\n  print(e);continue\n ins=e['insn']; op=ins&127; pc=e['pc_rdata']; nxt=e['pc_wdata']; rd=(ins>>7)&31; rs1=(ins>>15)&31\n if e['mem_wmask'] and e['mem_addr']==0x10000100: active=True\n if e['mem_wmask'] and e['mem_addr']==0x10000104: active=False\n if active:\n  counts['instructions']+=1\n  if op in (0x63,0x67,0x6f):\n   out.write(struct.pack('<IIII',pc,ins,nxt,e['cycle']))\n   counts[{0x63:'branch',0x67:'jalr',0x6f:'jal'}[op]]+=1\n  if op==0x67:\n   sites[pc][nxt]+=1\n   if rd==0 and rs1 in (1,5) and ins>>20==0:\n    counts['returns']+=1\n    if ras and ras[-1]==nxt: ras_hits+=1\n if op in (0x67,0x6f) and not e['trap']:\n  if rd in (1,5):\n   ras.append(pc+4); ras=ras[-8:]\n  elif op==0x67 and rd==0 and rs1 in (1,5) and ins>>20==0 and ras: ras.pop()\nout.close(); rc=p.wait()\nprint('sim_rc',rc,'counts',dict(counts),'ideal_committed_ras_hits',ras_hits)\nprint('jalr_sites', {hex(k):dict(v) for k,v in sites.items()})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
