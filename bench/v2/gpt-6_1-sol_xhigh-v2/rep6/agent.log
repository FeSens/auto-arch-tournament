{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('/srv/hwebench/tmp/6b356b5e/601cf521/r5-retimed-branch')\nrtl=probe/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,rtl/f.name)\ndef edit(name,old,new):\n p=rtl/name;s=p.read_text();assert s.count(old)==1,(name,s.count(old));p.write_text(s.replace(old,new))\nedit('core_pkg.sv','    logic [31:0] alu_b;','    logic [15:0] branch_eq;\\\\n    logic [15:0] branch_lt;\\\\n    logic        branch_signed_top_lt;\\\\n    logic [31:0] alu_b;')\nedit('id_stage.sv','        reg_q.imm      <= imm;','''        for (int k = 0; k < 16; k++) begin\n          reg_q.branch_eq[k] <= (rs1_value[2*k +: 2] == rs2_value[2*k +: 2]);\n          reg_q.branch_lt[k] <= (rs1_value[2*k +: 2] < rs2_value[2*k +: 2]);\n        end\n        reg_q.branch_signed_top_lt <= (\"'$signed(rs1_value[31:30]) < $signed(rs2_value[31:30]));\n        reg_q.imm      <= imm;'\"''')\np=rtl/'ex_stage.sv';s=p.read_text()\na=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nb=s.index('    branch_taken  = ',a)\ns=s[:a]+'''  logic [7:0] eq4, lt4;\n  logic [3:0] eq8, lt8;\n  logic [1:0] eq16, lt16;\n  logic eq32, lt32;\n  logic [15:0] selected_lt;\n  always_comb begin\n    selected_lt = in.branch_lt;\n    if (in.ctrl.branch_op == BR_BLT || in.ctrl.branch_op == BR_BGE)\n      selected_lt[15] = in.branch_signed_top_lt;\n    for (int k = 0; k < 8; k++) begin\n      eq4[k] = in.branch_eq[2*k+1] && in.branch_eq[2*k];\n      lt4[k] = selected_lt[2*k+1] || (in.branch_eq[2*k+1] && selected_lt[2*k]);\n    end\n    for (int k = 0; k < 4; k++) begin\n      eq8[k] = eq4[2*k+1] && eq4[2*k];\n      lt8[k] = lt4[2*k+1] || (eq4[2*k+1] && lt4[2*k]);\n    end\n    for (int k = 0; k < 2; k++) begin\n      eq16[k] = eq8[2*k+1] && eq8[2*k];\n      lt16[k] = lt8[2*k+1] || (eq8[2*k+1] && lt8[2*k]);\n    en