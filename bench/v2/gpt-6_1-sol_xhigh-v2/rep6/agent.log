{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('/srv/hwebench/tmp/6b356b5e/fcee66c5/r6s0_probe')\nfor name,base in [('prefix_alu','base'),('prefix_cmp','shared_cmp')]:\n    dst=probe/name/'rtl'\n    shutil.copytree(probe/base/'rtl',dst,dirs_exist_ok=True)\n    p=dst/'alu.sv'\n    s=p.read_text()\n    start=s.index('  always_comb begin')\n    s=s[:start]+'''  logic [31:0] add_result, sub_result;\n  alu_prefix_add u_add(.a(a), .b(b), .cin(1'b0), .sum(add_result));\n  alu_prefix_add u_sub(.a(a), .b(~b), .cin(1'b1), .sum(sub_result));\n\n'''+s[start:]\n    s=s.replace('ALU_ADD:    out = a + b;','ALU_ADD:    out = add_result;').replace('ALU_SUB:    out = a - b;','ALU_SUB:    out = sub_result;')\n    s+='''\nmodule alu_prefix_add (\n  input logic [31:0] a, b,\n  input logic cin,\n  output logic [31:0] sum\n);\n  wire [4:0] partial [0:7];\n  wire [7:0] g0, p0, g1, p1, g2, p2, g3, p3;\n  wire [7:0] c;\n  genvar i;\n  generate\n    for (i=0; i<8; i=i+1) begin : chunk\n      assign partial[i] = {1'b0,a[i*4 +: 4]} + {1'b0,b[i*4 +: 4]};\n      assign g0[i] = partial[i][4];\n      assign p0[i] = &(a[i*4 +: 4] \"'^ b[i*4 +: 4]);\n      if (i>=1) begin\n        assign g1[i] = g0[i] | (p0[i] & g0[i-1]);\n        assign p1[i] = p0[i] & p0[i-1];\n      end else begin\n        assign g1[i] = g0[i]; assign p1[i] = p0[i];\n      end\n      if (i>=2) begin\n        assign g2[i] = g1[i] | (p1[i] & g1[i-2]);\n        assign p2[i] = p1[i] & p1[i-2];\n      end else begin\n        assign g2[i] = g1[i]; assign p2[i] = p1[i];\n      end\n      if (i>=4) begin\n        assign g3[i] = g2[i] | (p2[i] & g2[i-4]);\n        assign p3[i] = p2[i] & p2[i-4];\n      end else begin\n        assign g3[i] = g2[i]; assign p3[i] = p2[i];\n      end\n      if (i==0) assign c[i] = cin;\n      else assign c[i] = g3[i-1] | (p3[i-1] & cin);\n      assign sum[i*4 +: 4] = partial[i][3:0] + c[i];