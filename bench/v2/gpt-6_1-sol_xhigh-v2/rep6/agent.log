& is_divide && !div_result_valid;\n'\"'''+s[b:]\na=s.index('  assign mul_launch = ')\nb=s.index('\\\\n  mul_unit u_mul (',a)\ns=s[:a]+'''  assign mul_launch = ex_advance && is_multiply && mul_req_ready\n                      && ctrl_with_trap.reg_write && \"'!ctrl_with_trap.is_illegal;\n'\"'''+s[b:]\ns=s.replace('.result_valid (mul_result_valid), .result_ready (mul_transfer),','.result_valid (mul_result_valid), .result_ready (mul_result_ready),')\na=s.index('  assign bypass_data = ')\nb=s.index('  // Capture the registered operands',a)\ns=s[:a]+'''  assign bypass_data = is_divide ? div_result : execute_payload.alu_result;\n  assign bypass_rd = is_divide ? divide_payload_q.rd : in.rd;\n  assign bypass_w_en = ex_advance && \"'!is_multiply && (bypass_rd != 5'\"'b0)\n                      && (is_divide\n                          ? (div_transfer && divide_payload_q.valid\n                             && divide_payload_q.ctrl.reg_write\n                             && \"'!divide_payload_q.ctrl.is_illegal\n                             && !divide_payload_q.ctrl.mem_read)\n                          : (ctrl_with_trap.reg_write\n                             && !ctrl_with_trap.is_illegal\n                             && !ctrl_with_trap.mem_read));\n\n'\"'''+s[b:]\na=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset) multiply_payload_q')\nb=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      reg_q',a)\ns=s[:a]+s[b:]\ns=s.replace('''    end else if (mul_transfer) begin\n      reg_q <= multiply_payload_q;\n      reg_q.alu_result <= mul_result;\n''','')\np.write_text(s)\nedit('mem_stage.sv','  input  logic               hold_wb,','''  input  logic               hold_wb,\n  input  logic [31:0]         mul_result,\n  input  logic               mul_result_valid,\n  output logic               mul_result_ready,''')\nedit('mem_stage.sv','  logic [31:0] load_data;','''  logic [31:0] load_data;\n  logic [31:0] completed_result;\n  assign completed_result = in.ctrl.is_multiply ? mul_result : in.alu_result;\n  assign mul_result_ready = in.valid && in.ctrl.is_multiply && \"'!reset && !hold_wb\n                            && mul_result_valid;'\"''')\nedit('mem_stage.sv','assign bypass_data = in.ctrl.mem_to_reg ? load_data : in.alu_result;','assign bypass_data = in.ctrl.mem_to_reg ? load_data : completed_result;')\nedit('mem_stage.sv','reg_q.alu_result <= in.alu_result;','reg_q.alu_result <= completed_result;')\nedit('core.sv','  logic       ex_busy;','''  logic       ex_busy;\n  logic [31:0] mul_result_w;\n  logic mul_result_valid_w, mul_result_ready_w;''')\nedit('core.sv','    .busy            (ex_busy),','''    .mul_result      (mul_result_w),\n    .mul_result_valid (mul_result_valid_w),\n    .mul_result_ready (mul_result_ready_w),\n    .busy            (ex_busy),''')\nedit('core.sv','    .hold_wb    (hold_mem_wb),','''    .hold_wb    (hold_mem_wb),\n    .mul_result (mul_result_w),\n    .mul_result_valid (mul_result_valid_w),\n    .mul_result_ready (mul_result_ready_w),''')\nedit('core.sv','    .id_ex_mem_read (id_ex_w.ctrl.mem_read),','    .id_ex_mem_read (id_ex_w.ctrl.mem_read | id_ex_w.ctrl.is_multiply),')\nprint('Prototype RTL prepared:',rtl)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
