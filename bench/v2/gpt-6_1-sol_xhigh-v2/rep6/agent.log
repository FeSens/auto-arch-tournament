{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe')\nfor name,exsource in [('recovery_squash_target','recovery'),('recovery_squash_control','recovery_control')]:\n dst=root/name/'rtl';shutil.copytree(root/'recovery_squash'/'rtl',dst,dirs_exist_ok=True)\n shutil.copyfile(root/exsource/'rtl'/'ex_stage.sv',dst/'ex_stage.sv')\nprint('Created integrated local recovery prototypes')\nPY\npython3 -u - <<'PY'\nimport json\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build\nwt=Path.cwd();root=Path('/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe')\ndef evaluate(task):\n name,p=task;d=root/name;result=build(wt,d/'rtl','fpga/core_bench_si.sv',p,d/f'gowin_p{p}')\n (d/f'timing{p}.json').write_text(json.dumps(result,indent=2))\n print(name,p,result['fmax_mhz'],result.get('logic'),result.get('regs'),flush=True)\nwith ThreadPoolExecutor(max_workers=4) as executor:\n list(executor.map(evaluate,[(name,p) for name in ['recovery_squash_target','recovery_squash_control'] for p in [0,1]]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
