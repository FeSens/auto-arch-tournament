{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py; sed -n '260,580p' cores/bench/test/test_pipeline.py; sed -n '900,1180p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"\n…[25896 of 28968 chars elided by tools/bench/transcript.py; sha256:bbef6d3c5dcfa7c6]…\n         break\n        else:\n            raise AssertionError(\"reset scenario never reached the multiply boundary\")\n        fresh = [ADDI(1, 0, 3), MUL(2, 1, 1), SW(2, 0, 0x104), EBREAK()]\n        events = []\n        rets, mem = await _run(dut, fresh, memory_events=events)\n        assert [r[\"insn\"] for r in rets] == fresh\n        assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12]\n        assert rets[1][\"rs1_rdata\"] == rets[1][\"rs2_rdata\"] == 3\n        assert rets[1][\"rd_wdata\"] == 9\n        assert mem == {0x104: 9}\n        assert len(events) == 1 and events[0][1:4] == (0x104, 15, 0)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
