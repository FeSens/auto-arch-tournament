{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1')\nroot=base/'retimed'\nrtl=root/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\np=rtl/'core_pkg.sv'\ns=p.read_text().replace('logic [31:0] alu_b;\\\\n    logic [31:0] imm;','logic [31:0] alu_b;\\\\n    logic [31:0] arith_sum0;\\\\n    logic [31:0] arith_sum1;\\\\n    logic [3:0] arith_g;\\\\n    logic [3:0] arith_p;\\\\n    logic arith_sub;\\\\n    logic [31:0] imm;')\nassert 'arith_sum0' in s\np.write_text(s)\np=rtl/'id_stage.sv'\ns=p.read_text()\na=s.index('  // ── ID/EX register')\ns=s[:a]+'''  logic [31:0] prepare_a, prepare_b, adjusted_b;\n  logic prepare_sub;\n  logic [31:0] prepare_sum0, prepare_sum1;\n  logic [3:0] prepare_g, prepare_p;\n  logic [8:0] block_sum [0:3];\n  always_comb begin\n    prepare_a = dec_is_auipc ? in.pc : rs1_value;\n    prepare_b = dec_alu_src ? imm : rs2_value;\n    prepare_sub = dec_is_branch || (dec_alu_op == ALU_SUB)\n                  || (dec_alu_op == ALU_SLT) || (dec_alu_op == ALU_SLTU);\n    adjusted_b = prepare_b \"'^ {32{prepare_sub}};\n    for (int i = 0; i < 4; i++) begin\n      block_sum[i] = {1'\"'b0, prepare_a[i*8 +: 8]}\n                     + {1'b0, adjusted_b[i*8 +: 8]};\n      prepare_sum0[i*8 +: 8] = block_sum[i][7:0];\n      prepare_sum1[i*8 +: 8] = block_sum[i][7:0] + 8'd1;\n      prepare_g[i] = block_sum[i][8];\n      prepare_p[i] = &(prepare_a[i*8 +: 8] \"'^ adjusted_b[i*8 +: 8]);\n    end\n  end\n\n'\"'''+s[a:]\ns=s.replace('reg_q.imm      <= imm;','reg_q.arith_sum0 <= prepare_sum0;\\\\n        reg_q.arith_sum1 <= prepare_sum1;\\\\n        reg_q.arith_g <= prepare_g;\\\\n        reg_q.arith_p <= prepare_p;\\\\n        reg_q.arith_sub <= prepare_sub;\\\\n        reg_q.imm      <= imm;')\np.write_text(s)\np=rtl/'alu.sv'\ns=p.read_text().replace('module alu (','module