{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os,shutil\nfrom pathlib import Path\nbase=Path(os.environ['TMPDIR'])\nfor name,size,shift in [('agree64fold',64,8),('bimodal64fold',64,6)]:\n p=base/name;rtl=p/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n src=(base/'agree128/rtl') if name.startswith('agree') else Path('cores/bench/rtl')\n for f in src.glob('*.sv'):shutil.copy2(f,rtl/f.name)\n bits=size.bit_length()-1\n for fn in ['if_stage.sv','ex_stage.sv','core.sv']:\n  f=rtl/fn;s=f.read_text().replace('[6:0]        branch_index',f'[{bits-1}:0]        branch_index').replace('[6:0]         branch_index',f'[{bits-1}:0]         branch_index').replace('[6:0]        branch_index',f'[{bits-1}:0]        branch_index')\n  s=s.replace('[6:0]        branch_index;',f'[{bits-1}:0]        branch_index;').replace('[6:0]        branch_index,',f'[{bits-1}:0]        branch_index,')\n  s=s.replace('[0:127]',f'[0:{size-1}]').replace('i < 128',f'i < {size}')\n  if fn=='if_stage.sv':s=s.replace('pc[8:2]',f'(pc[{bits+1}:2] \"'^ pc[{shift+bits-1}:{shift}])'\"')\n  if fn=='ex_stage.sv':s=s.replace('in.pc[8:2]',f'(in.pc[{bits+1}:2] \"'^ in.pc[{shift+bits-1}:{shift}])'\"')\n  f.write_text(s)\n print(name,rtl)\nPY\nRTL_DIR=\\\"\"'$TMPDIR/agree64fold/rtl\" OBJ_DIR=\"$TMPDIR/agree64fold/obj_dir\" NRET=1 bash test/cosim/build.sh > \"$TMPDIR/agree64fold/build.log\" 2>&1\n\"$TMPDIR/agree64fold/obj_dir/cosim_sim\" bench/programs/coremark.elf 10000000 --bench --istall --dstall > \"$TMPDIR/agree64fold/coremark.jsonl\"\ncat \"$TMPDIR/agree64fold/coremark.jsonl\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
