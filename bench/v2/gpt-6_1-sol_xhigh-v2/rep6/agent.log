{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_id_stage.py; sed -n '1,300p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"ID/EX hold/squash priorities with a live prediction and nonzero payload.\"\"\"\nimport itertools\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# Packed id_ex_t has valid at bit 0, target at 32:1, direction at 33,\n# instruction at 65:34 and the entire 22-bit ctrl_t at 87:66.\n_CTRL_MASK = ((1 << 22) - 1) << 66\n_PRED_MASK = 1 << 33\n_CONTROL_MASK = _CTRL_MASK | _PRED_MASK | 1\n_PAYLOAD_MASK = ((1 << 295) - 1) ^ _CONTROL_MASK\n\n\ndef _fetch(pc, instr, predicted_taken, target, valid):\n    return (((((pc << 32) | instr) << 1 | predicted_taken) << 32 | target) << 1) | valid\n\n\nasync def _edge(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    result = int(dut.out.value)\n    dut.clock.value = 0\n    return result\n\n\n@cocotb.test()\nasync def squash_hold_advance_priority(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)  # MUL x3,x1,x2\n    dut.rs1_data.value = 0x12345678\n    dut.rs2_data.value = 0x87654321\n    dut.fwd_rs1_sel.value = 1\n    dut.fwd_rs2_sel.value = 2\n    dut.fwd_ex_data.value = 0xA5A55A5A\n    dut.fwd_mem_data.value = 0x55AA33CC\n    assert len(dut.out) == 295\n    assert await _edge(dut) == 0, \"reset clears payload even during a hold/squash\"\n    dut.reset.value = 0\n\n    for stall, flush, valid in itertools.product((0, 1), repeat=3):\n        # Seed each case with nonzero payload, arithmetic controls and a\n        # prediction. This makes a missed direction clear visible on holds.\n        dut.stall.value = 0\n        dut.flush.value = 0\n        dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)\n        before = await _edge(dut)\n        assert before & _CTRL_MASK and before & _PRED_MASK and before & 1\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut[\"in\"].value = _fetch(0xA0, 0xABCD1297, 1, 0xCC, valid)  # AUIPC x5\n        dut.fwd_ex_data.value = 0xDEADBEEF\n        dut.fwd_mem_data.value = 0xCAFEBABE\n        afte\n…[13378 of 16450 chars elided by tools/bench/transcript.py; sha256:0279752447591264]…\n EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — capture current MEM's result.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n", "exit_code": 0, "status": "completed"}}
