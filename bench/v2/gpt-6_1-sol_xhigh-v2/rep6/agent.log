{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '550,760p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "        if not seed:\n            assert rets[1][\"cycle\"] == rets[0][\"cycle\"] + 1\n            assert rets[2][\"cycle\"] == rets[1][\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def predictor_correction_overrides_unavailable_imem(dut):\n    program = {0: BEQ(0, 0, 8), 4: SW(0, 0, 0x100),\n               8: ADDI(1, 0, 24), 12: JALR(2, 1, 0),\n               16: LW(3, 0, 0x104), 24: EBREAK()}\n    fetches, events = [], []\n    # The wrong-path fetch never becomes ready. Both corrections must\n    # update PC anyway, without accepting its decoded memory controls.\n    rets, mem = await _run(\n        dut, program, memory_events=events, fetch_events=fetches,\n        bus_schedule=lambda cycle, ia, da, wen, ren: (ia not in (4, 16), True))\n    assert [r[\"pc\"] for r in rets] == [0, 8, 12, 24]\n    assert [r[\"pc_next\"] for r in rets] == [8, 12, 24, 28]\n    assert rets[2][\"rd_wdata\"] == 16 and rets[2][\"rs1_rdata\"] == 24\n    assert {ia for _, ia, ready, _ in fetches if not ready} == {4, 16}\n    assert not events and not mem\n\n\n@cocotb.test()\nasync def predictor_invalid_raw_memory_is_a_bubble(dut):\n    program = [LW(1, 0, 0x100), SW(1, 0, 0x104), EBREAK()]\n    waits = {0: 7, 4: 7}\n    def schedule(cycle, ia, da, wen, ren):\n        remaining = waits.get(ia, 0)\n        if remaining:\n            waits[ia] = remaining - 1\n        return not remaining, True\n    events = []\n    rets, mem = await _run(dut, program, {0x100: 0x12345678},\n                           memory_events=events, bus_schedule=schedule)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8]\n    assert [r[\"pc_next\"] for r in rets] == [4, 8, 12]\n    assert [(da, wen, ren) for _, da, wen, ren, _ in events] == [\n        (0x100, 0, 1), (0x104, 15, 0)]\n    assert mem[0x104] == rets[0][\"rd_wdata\"] == 0x123456