op\n    dut.req_a.value = a & MASK\n    dut.req_b.value = b & MASK\n    dut.result_ready.value = 0\n    await _tick(dut)  # accepted launch\n    assert int(dut.req_ready.value) == 0\n    # Leave a conflicting request asserted throughout computation and\n    # backpressure: it must never overwrite the accepted transaction.\n    dut.req_a.value = (a ^ MASK) & MASK\n    dut.req_b.value = (b + 17) & MASK\n    dut.re\n…[11470 of 14542 chars elided by tools/bench/transcript.py; sha256:7134cc7a756488e2]…\n         break\n\n        await Timer(4, \"ns\")\n        dut.clock.value = 0\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
