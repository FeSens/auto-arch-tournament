{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os, shutil\nroot=Path(os.environ['TMPDIR'])/'compare_probe_r8s0'\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\ndef tree(a,b,prefix):\n return f'''  logic [30:0] {prefix}_eq, {prefix}_lt;\n  logic {prefix}_slt;\n  for (genvar i=0; i<16; i=i+1) begin : {prefix}_leaves\n    assign {prefix}_eq[15+i] = ({a}[2*i +: 2] == {b}[2*i +: 2]);\n    assign {prefix}_lt[15+i] = ({a}[2*i +: 2] < {b}[2*i +: 2]);\n  end\n  for (genvar n=0; n<15; n=n+1) begin : {prefix}_nodes\n    assign {prefix}_eq[n] = {prefix}_eq[2*n+2] & {prefix}_eq[2*n+1];\n    assign {prefix}_lt[n] = {prefix}_lt[2*n+2] | ({prefix}_eq[2*n+2] & {prefix}_lt[2*n+1]);\n  end\n  assign {prefix}_slt = ({a}[31] \"'^ {b}[31]) ? {a}[31] : {prefix}_lt[0];\n'\"'''\np=rtl/'ex_stage.sv'\ns=p.read_text()\ns=s.replace('  logic        branch_cond;',tree('rs1','rs2','cmp')+'\\\\n  logic        branch_cond;')\nreplacements={'(rs1 == rs2)':'cmp_eq[0]','(rs1 \"'!= rs2)'\"':'\"'!cmp_eq[0]'\"','(\"'$signed(rs1) <  $signed(rs2))'\"':'cmp_slt','(\"'$signed(rs1) >= $signed(rs2))'\"':'\"'!cmp_slt'\"','(rs1 <  rs2)':'cmp_lt[0]','(rs1 >= rs2)':'\"'!cmp_lt[0]'\"'}\nfor a,b in replacements.items():\n assert a in s,a\n s=s.replace(a,b)\np.write_text(s)\np=rtl/'alu.sv'\ns=p.read_text().replace('  always_comb begin',tree('a','b','cmp')+'\\\\n  always_comb begin',1)\ns=s.replace(\\\"\"'$signed(a) < $signed(b)\",'\"'cmp_slt').replace('a < b','cmp_lt[0]')\np.write_text(s)\n(root/'compare_miter.sv').write_text('module compare_miter(input [31:0] a,b, output mismatch);\\\\n'+tree('a','b','cmp')+'\\\\nassign mismatch = (cmp_eq[0] \"'!= (a==b)) | (cmp_lt[0] != (a<b)) | (cmp_slt != ($signed(a)<$signed(b)));'\"\\\\nendmodule\\\\n')\n(root/'run_vendor.py').write_text('''from pathlib import Path\nimport json, os\nfrom tools.eval.gowin import build_all,summarize\nroot=Path(os.environ['TMPDIR'])/'compare_probe_r8s0'\nr=build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'timing_results.json').write_text(json.dumps({'builds':r,'summary':summarize(r)},indent=2))\nprint(json.dumps({'builds':r,'summary':summarize(r)},indent=2),flush=True)\n''')\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
