{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/6b356b5e/27a319cc/predictor-r14s2')\nfor name in ['gray-counter-shared','gray-counter-local','fold-prediction-polarity']:\n rtl=base/name/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n if name.startswith('gray-counter'):\n  p=rtl/'if_stage.sv';s=p.read_text();start=s.index('  // Train only');end=s.index('  assign imem_addr',start)\n  if name=='gray-counter-shared':\n   block='''  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 128; i++) counters[i] <= 2'b01;\n    end else if (branch_update) begin\n      counters[branch_index][1] <= branch_taken\n          ? (counters[branch_index][1] | counters[branch_index][0])\n          : (counters[branch_index][1] & counters[branch_index][0]);\n      counters[branch_index][0] <= counters[branch_index][1] \"'^ branch_taken;\n    end\n  end\n\n'\"'''\n  else:\n   block='''  for (genvar g = 0; g < 128; g++) begin : bht_cell\n    always_ff @(posedge clock) begin\n      if (reset) counters[g] <= 2'b01;\n      else if (branch_update && branch_index == g) begin\n        counters[g][1] <= branch_taken\n            ? (counters[g][1] | counters[g][0])\n            : (counters[g][1] & counters[g][0]);\n        counters[g][0] <= counters[g][1] \"'^ branch_taken;\n      end\n    end\n  end\n\n'\"'''\n  s=s[:start]+block+s[end:];p.write_text(s)\n else:\n  p=rtl/'id_stage.sv';s=p.read_text().replace('ctrl_decoded.branch_op  = dec_branch_op;','ctrl_decoded.branch_op  = {dec_branch_op[2:1], dec_branch_op[0] \"'^ (dec_is_branch && in.predicted_taken)};'\"');p.write_text(s)\n  p=rtl/'ex_stage.sv';s=p.read_text().replace('branch_taken  = in.ctrl.is_branch && branch_cond;','branch_taken  = in.ctrl.is_branch && (branch_cond \"'^ in.predicted_taken);'\"')\n  s=s