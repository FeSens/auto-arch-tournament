{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\np = Path('formal')\nlogs = sorted(p.glob('last_run-*.log'), key=lambda f: f.stat().st_mtime)\nprint([(str(f), f.stat().st_size) for f in logs])\nroot = Path('formal/riscv-formal/cores')\nfor d in sorted(root.glob('bench-*'), key=lambda f: f.stat().st_mtime)[-2:]:\n    c = d / 'checks'\n    tasks = list(c.glob('*.sby'))\n    status = {}\n    pending = []\n    for s in tasks:\n        log = c / s.stem / 'logfile.txt'\n        data = log.read_text() if log.exists() else ''\n        final = re.search(r'DONE \\\\((\\\\w+)', data)\n        if final:\n            status[final[1]] = status.get(final[1], 0) + 1\n        else:\n            pending.append((s.stem, data.splitlines()[-1] if data else 'not started'))\n    print(str(d), len(tasks), status)\n    for item in pending:\n        print(item)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
