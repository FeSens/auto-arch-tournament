{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/6b356b5e/c0f8be90/r11-hysteresis')\nrtl=root/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,rtl/f.name)\nf=rtl/'if_stage.sv'; s=f.read_text().replace('logic [1:0] counters [0:127];','logic [127:0] direction_q;\\\\n  logic [127:0] strength_q;').replace('counters[pc[8:2]][1]','direction_q[pc[8:2]]')\na=s.index('  // Train only on the single EX-to-EX/MEM acceptance event,'); b=s.index('\\\\n  assign imem_addr = pc;',a)\ns=s[:a]+'''  // Same four-state hysteresis, recoded into direction and strength.\n  // Each row updates from its own bits; no indexed training read mux.\n  for (genvar i = 0; i < 128; i++) begin : g_history\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        direction_q[i] <= 1'b0;\n        strength_q[i] <= 1'b0;\n      end else if (branch_update && branch_index == 7'(i)) begin\n        direction_q[i] <= strength_q[i] ? direction_q[i] : branch_taken;\n        strength_q[i] <= (direction_q[i] == branch_taken);\n      end\n    end\n  end\n''' + s[b:]\nf.write_text(s)\nprint(rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
