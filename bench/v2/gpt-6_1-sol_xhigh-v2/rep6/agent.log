{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport subprocess, json\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nroot=Path('/srv/hwebench/tmp/6b356b5e/b5c23683/r14s0_classes_probe')\nsim=root/'obj_dir/cosim_sim'\nfor name in ('selftest','random1','random2','random3'):\n for flags in ([],['--istall','--dstall']):\n  run=subprocess.run(['python','test/cosim/run_cosim.py',str(sim),str(root/f'{name}.elf'),*flags],capture_output=True,text=True,timeout=120)\n  print(name,flags,'PASS' if run.returncode==0 else (run.stdout+run.stderr)[-1500:],flush=True)\nrun=subprocess.run([str(sim),str(root/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,timeout=120)\nmarker=json.loads(run.stdout.strip().splitlines()[-1])\nvalid,reason=validate_coremark_uart(marker.get('uart',''),10)\ncycles=int(marker['bench_stop_cycle'])-int(marker['bench_start_cycle'])\nprint('CoreMark',{'rc':run.returncode,'crc_valid':valid,'reason':reason,'oob':marker.get('oob'),'ebreak':marker.get('ebreak'),'bracketed':marker.get('bench_bracketed'),'cycles':cycles},flush=True)\n(root/'cosim_result.json').write_text(json.dumps({'crc_valid':valid,'cycles':cycles,'marker':marker},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
