{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor variant in ['right','addsub']:\n root=Path('cores/bench/generated/hypgen_'+variant);rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n p=rtl/'alu.sv';s=p.read_text()\n if variant=='right':\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  logic signed [32:0] right_input;\n  logic signed [32:0] right_result;\n  assign right_input = \"'$signed({((op == ALU_SRA) && a[31]), a});\n  assign right_result = right_input >>> b[4:0];'\"''')\n  s=s.replace('ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','ALU_SRL, ALU_SRA: out = right_result[31:0];')\n else:\n  s=s.replace('  logic        [4:0]  shamt;', '''  logic [4:0] shamt;\n  logic subtract;\n  logic [31:0] addend_b;\n  logic [32:0] arithmetic_result;\n  logic unsigned_less, signed_less;\n  assign subtract = (op == ALU_SUB) || (op == ALU_SLT) || (op == ALU_SLTU);\n  assign addend_b = b \"'^ {32{subtract}};\n  assign arithmetic_result = {1'\"'b0, a} + {1'b0, addend_b} + {32'b0, subtract};\n  assign unsigned_less = \"'!arithmetic_result[32];\n  assign signed_less = (a[31] ''^ b[31]) ? a[31] : unsigned_less;'\"''')\n  s=s.replace('ALU_ADD:    out = a + b;\\\\n      ALU_SUB:    out = a - b;','ALU_ADD, ALU_SUB: out = arithmetic_result[31:0];')\n  s=s.replace(\\\"ALU_SLT:    out = {31'b0, \"'$signed(a) < $signed(b)};\", \"ALU_SLT:    out = {31'\"'b0, signed_less};\\\")\n  s=s.replace(\\\"ALU_SLTU:   out = {31'b0, a < b};\\\", \\\"ALU_SLTU:   out = {31'b0, unsigned_less};\\\")\n p.write_text(s)\n (root/'alu_reference.sv').write_text(Path('cores/bench/rtl/alu.sv').read_text().replace('module alu (','module alu_reference ('))\n print('Created',variant,'prototype')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
