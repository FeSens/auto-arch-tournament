{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch=Path(os.environ['TMPDIR'])/'r12s0-carry-probe'\nscratch.mkdir(exist_ok=True)\nrtl=scratch/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\np=rtl/'alu.sv'\ns=p.read_text()\nnew='''  logic [31:0] add_result, sub_result;\n  logic [31:0] sub_b;\n  logic [3:0] add_g, add_p, sub_g, sub_p;\n  logic [3:0] add_c, sub_c;\n  assign sub_b = ~b;\n  assign add_c[0] = 1'b0;\n  assign sub_c[0] = 1'b1;\n  assign add_c[1] = add_g[0];\n  assign add_c[2] = add_g[1] | (add_p[1] & add_g[0]);\n  assign add_c[3] = add_g[2] | (add_p[2] & add_g[1])\n                                  | (add_p[2] & add_p[1] & add_g[0]);\n  assign sub_c[1] = sub_g[0] | sub_p[0];\n  assign sub_c[2] = sub_g[1] | (sub_p[1] & sub_g[0])\n                                  | (sub_p[1] & sub_p[0]);\n  assign sub_c[3] = sub_g[2] | (sub_p[2] & sub_g[1])\n                                  | (sub_p[2] & sub_p[1] & sub_g[0])\n                                  | (sub_p[2] & sub_p[1] & sub_p[0]);\n  for (genvar i = 0; i < 4; i++) begin: carry_block\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [8:0] add0, add1, sub0, sub1;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign add0 = {1'b0, a[i*8 +: 8]} + {1'b0, b[i*8 +: 8]};\n    assign add1 = {1'b0, a[i*8 +: 8]} + {1'b0, b[i*8 +: 8]} + 9'd1;\n    assign sub0 = {1'b0, a[i*8 +: 8]} + {1'b0, sub_b[i*8 +: 8]};\n    assign sub1 = {1'b0, a[i*8 +: 8]} + {1'b0, sub_b[i*8 +: 8]} + 9'd1;\n    assign add_g[i] = add0[8];\n    assign add_p[i] = &(a[i*8 +: 8] \"'^ b[i*8 +: 8]);\n    assign sub_g[i] = sub0[8];\n    assign sub_p[i] = &(a[i*8 +: 8] ''^ sub_b[i*8 +: 8]);\n    assign add_result[i*8 +: 8] = add_c[i] ? add1[7:0] : add0[7:0];\n    assign sub_result[i*8 +: 8] = sub_c[i] ? sub1[7:0] : sub0[7:0];\n  end\n'\"'''\ns=s.replace('  logic        [4:0]  shamt;','  logic        [4:0]  shamt;\\\\n\\\\n'+new)\ns=s.replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = add_result;').replace('ALU_SUB:    out = a - b;', 'ALU_SUB:    out = sub_result;')\np.write_text(s)\nref=scratch/'alu_ref.sv'\nref.write_text(Path('cores/bench/rtl/alu.sv').read_text().replace('module alu (','module alu_ref ('))\n(scratch/'equiv.sv').write_text('''module equiv(input [4:0] op, input [31:0] a,b, output ok);\nwire [31:0] x,y;\nalu dut(op,a,b,x);\nalu_ref ref_dut(op,a,b,y);\nassign ok = x == y;\nendmodule\n''')\nprint(scratch)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
