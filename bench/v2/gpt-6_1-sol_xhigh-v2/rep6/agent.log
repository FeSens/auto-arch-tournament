{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1')\nfor suffix in ['single','double']:\n rtl=base/('predecoded-'+suffix)/'rtl'\n shutil.copytree(base/('isolated-'+suffix)/'rtl',rtl,dirs_exist_ok=True)\n p=rtl/'core_pkg.sv'\n s=p.read_text()\n old='logic [31:0] direct_target;\\\\n    logic        valid;\\\\n  } if_id_t;'\n assert old in s\n s=s.replace(old,'logic [31:0] direct_target;\\\\n    ctrl_t ctrl;\\\\n    logic [31:0] imm;\\\\n    logic        valid;\\\\n  } if_id_t;')\n p.write_text(s)\n p=rtl/'if_stage.sv'\n s=p.read_text()\n at=s.index('  localparam logic [31:0] RESET_PC')\n ctrlfields=['alu_op','alu_src','branch_op','is_branch','is_jump','is_jalr','is_lui','is_auipc','mem_read','mem_write','mem_width','mem_sext','reg_write','mem_to_reg','is_illegal']\n decode='  ctrl_t fetch_ctrl;\\\\n  logic [31:0] fetch_imm;\\\\n  decoder u_fetch_decode (\\\\n    .instr(imem_data),\\\\n'+',\\\\n'.join('    .'+f+'(fetch_ctrl.'+f+')' for f in ctrlfields)+'\\\\n  );\\\\n  imm_gen u_fetch_imm (.instr(imem_data), .imm(fetch_imm));\\\\n\\\\n'\n s=s[:at]+decode+s[at:]\n if suffix=='single':\n  s=s.replace(\\\"saved_q.valid <= 1'b1;\\\",\\\"saved_q.ctrl <= fetch_ctrl;\\\\n      saved_q.imm <= fetch_imm;\\\\n      saved_q.valid <= 1'b1;\\\")\n else:\n  s=s.replace(\\\"slots[tail_q].valid <= 1'b1;\\\",\\\"slots[tail_q].ctrl <= fetch_ctrl;\\\\n      slots[tail_q].imm <= fetch_imm;\\\\n      slots[tail_q].valid <= 1'b1;\\\")\n s=s.replace(\\\"out.valid = 1'b1;\\\",\\\"out.ctrl = fetch_ctrl;\\\\n      out.imm = fetch_imm;\\\\n      out.valid = 1'b1;\\\")\n p.write_text(s)\n p=rtl/'id_stage.sv'\n s=p.read_text()\n a=s.index('  decoder u_decoder (')\n b=s.index('  // Regfile read addresses',a)\n s=s[:a]+'\\\\n'.join('  assign dec_'+f+' = in.ctrl.'+f+';' for f in ctrlfields)+'\\\\n\\\\n  logic [31:0] imm;\\\\n  assign imm = in.imm;\\\\n\\\\n'+s[b:]\n p.write_text(s)\n print('Prepared',suffix)\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build\nimport json\nbase=Path('/srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1')\ndef run(name):\n root=base/name\n r=build(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',0,root/'timing-p0')\n (root/'timing-p0.json').write_text(json.dumps(r,indent=2))\n print(name,json.dumps(r),flush=True)\nwith ThreadPoolExecutor(max_workers=2) as pool:list(pool.map(run,['predecoded-single','predecoded-double']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
