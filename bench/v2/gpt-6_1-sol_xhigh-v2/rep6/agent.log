{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport struct\nrows=list(struct.iter_unpack('<III',open('/srv/hwebench/tmp/6b356b5e/413e7dab/predictor-profile/branches.bin','rb').read()))\nfor size in [32,64,128,256,512]:\n cache=[None]*size; ctr=[1]*128;dir_miss=0;all_miss=0;target_miss=0;jal_miss=0;hits=0\n for pc,npc,insn in rows:\n  op=insn&127;taken=npc\"'!=pc+4\n  if op==0x67:continue\n  ci=(pc>>2)&(size-1);bi=pc>>2&127\n  pd=op==0x6f or ctr[bi]>=2; hit=cache[ci]==pc;pred=pd and hit\n  dir_miss+=pd!=taken;all_miss+=pred!=taken;target_miss+=taken and pd and not hit;jal_miss+=op==0x6f and not hit;hits+=hit\n  cache[ci]=pc\n  if op==0x63:ctr[bi]=min(3,ctr[bi]+1) if taken else max(0,ctr[bi]-1)\n print('\"'cache',size,'dir_miss',dir_miss,'all_miss',all_miss,'delta',all_miss-dir_miss,'target_miss',target_miss,'jal_miss',jal_miss,'hits',hits)\nprint('hashed 2-bit directions')\nbranches=[(pc,npc\"'!=pc+4) for pc,npc,i in rows if i&127==0x63]\nfor bits in [4,5,6,7,8]:\n for shift in [4,5,6,7,8,9,10,11]:\n  tab=[1]*(1<<bits);mask=len(tab)-1;m=0\n  for pc,t in branches:\n   x=pc>>2;i=(x''^(x>>shift))&mask;m+=(tab[i]>=2)!=t;tab[i]=min(3,tab[i]+1) if t else max(0,tab[i]-1)\n  print(bits,shift,m)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
