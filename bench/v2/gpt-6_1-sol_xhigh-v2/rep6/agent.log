ated git worktree\n#              at .worktrees/<TARGET>/ on branch core-<TARGET> and re-execs\n#              itself there. Lets two `make loop` invocations for different\n#              TARGETs run in parallel without git index/merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: `make loo\n…[11924 of 14996 chars elided by tools/bench/transcript.py; sha256:cd0068afc246ef6f]…\nt on a ready edge, matching the cosim bus contract.\n        ia        = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())\n        dut.io_imemReady.value = int(not stalls or rng.random() >= 0.22)\n        await Timer(1, \"ns\")\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n        request = (da, wen, ren) if wen or ren else None\n        if stalls and request is not None and request != previous_request:\n            forced_wait = 5  # exercise a multi-cycle older LOAD/STORE stall\n        previous_request = request\n        dready = not stalls or (forced_wait == 0 and rng.random() >= 0.22)\n        if forced_wait:\n            forced_wait -= 1\n        if bus_schedule is not None:\n            iready, dready = bus_schedule(cycle, ia, da, wen, ren)\n            dut.io_imemReady.value = int(iready)\n        dut.io_dmemReady.value = int(dready)\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n", "exit_code": 0, "status": "completed"}}
