{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl')\nprobe=Path('/srv/hwebench/tmp/6b356b5e/d8a4eaa8/shift_probe')\nrtl=probe/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'): shutil.copy2(p,rtl/p.name)\ndef edit(file,old,new):\n p=rtl/file;s=p.read_text();assert old in s,(file,old);p.write_text(s.replace(old,new))\nedit('core_pkg.sv','    logic       alu_src;', '    logic       is_shift;\\\\n    logic       alu_src;')\nedit('id_stage.sv','    ctrl_decoded.alu_op     = dec_alu_op;', '    ctrl_decoded.alu_op     = dec_alu_op;\\\\n    ctrl_decoded.is_shift = \"'!dec_is_illegal && dec_reg_write &&'\"\\\\n      (dec_alu_op == ALU_SLL || dec_alu_op == ALU_SRL || dec_alu_op == ALU_SRA);')\nedit('alu.sv', '      ALU_SLL:    out = a << shamt;\\\\n      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"', '      ALU_SLL, ALU_SRL, ALU_SRA: out = 32\\\\'b0;')\nedit('ex_stage.sv','  output logic [31:0]        bypass_data,', '  output logic [31:0]        shift_result,\\\\n  output logic [31:0]        bypass_data,')\nedit('ex_stage.sv','  // ── Branch resolve', '''  shift_unit u_shift (\n    .clock(clock), .reset(reset),\n    .advance(ex_advance && in.ctrl.is_shift && in.ctrl.reg_write && \"'!in.ctrl.is_illegal),\n    .op(in.ctrl.alu_op), .a(in.alu_a), .b(in.alu_b), .result(shift_result)\n  );\n\n  // ── Branch resolve'\"''')\nedit('ex_stage.sv','  assign bypass_w_en = ex_advance && (bypass_rd \"'!= 5'\"\\\\'b0)', '  assign bypass_w_en = ex_advance && \"'!in.ctrl.is_shift && (bypass_rd != 5'\"\\\\'b0)')\nedit('mem_stage.sv','  input  logic               reset,', '  input  logic               reset,\\\\n  input  logic [31:0]         shift_result,')\nedit('mem_stage.sv','  logic [31:0] wdata_rep;', '  logic [31:0] architectural_result;\\\\n  assign architectural_result = in.ctrl.is_shift ? shift_result : in.alu_result;\\\\n  logic [31:0] wdata_rep;')\nedit('mem_stage.sv','in.ctrl.mem_to_reg ? load_data : in.alu_result', 'in.ctrl.mem_to_reg ? load_data : architectural_result')\nedit('mem_stage.sv','reg_q.alu_result <= in.alu_result;', 'reg_q.alu_result <= architectural_result;')\nedit('core.sv','  logic [31:0] ex_bypass_data, mem_bypass_data;', '  logic [31:0] ex_bypass_data, mem_bypass_data, shift_result;')\nedit('core.sv','    .bypass_data     (ex_bypass_data),','    .shift_result    (shift_result),\\\\n    .bypass_data     (ex_bypass_data),')\nedit('core.sv','    .hold_wb    (hold_mem_wb),','    .shift_result (shift_result),\\\\n    .hold_wb    (hold_mem_wb),')\nedit('core.sv','    .id_ex_mem_read (id_ex_w.ctrl.mem_read),','    .id_ex_mem_read (id_ex_w.valid && (id_ex_w.ctrl.mem_read || id_ex_w.ctrl.is_shift)),')\n(rtl/'shift_unit.sv').write_text('''module shift_unit (\n input logic clock, reset, advance,\n input logic [4:0] op,\n input logic [31:0] a, b,\n output logic [31:0] result\n);\n logic [31:0] value;\n always_comb begin\n   case (op)\n     ALU_SLL: value = a << b[4:0];\n     ALU_SRL: value = a >> b[4:0];\n     ALU_SRA: value = \"'$unsigned($signed(a) >>> b[4:0]);\n     default: value = 32'\"'b0;\n   endcase\n end\n always_ff @(posedge clock) begin\n   if (reset) result <= '0;\n   else if (advance) result <= value;\n end\nendmodule\n''')\nprint('Isolated shift prototype:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
