{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil,subprocess\nbase=Path('/srv/hwebench/tmp/6b356b5e/845f610c/predictor-r10s2')\nfor name,bits,style in [('gshare64',6,'share'),('gselect64',6,'select'),('gshare32',5,'share')]:\n rtl=base/f'{name}-rtl';shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n def edit(name,old,new,count=1):\n  p=rtl/name;s=p.read_text();assert s.count(old)==count,(name,old,s.count(old));p.write_text(s.replace(old,new))\n edit('core_pkg.sv','logic        predicted_taken;',f'logic        predicted_taken;\\\\n    logic [{bits-1}:0] prediction_index;',2)\n edit('if_stage.sv','input  logic [6:0]        branch_index,',f'input  logic [{bits-1}:0]        branch_index,')\n expr=f'(pc[{bits+1}:2] \"'^ {{{bits-1}'\"\\\\'b0, history_q}})' if style=='share' else f'{{history_q, pc[{bits}:2]}}'\n edit('if_stage.sv','logic [1:0] counters [0:127];',f'''logic [1:0] counters [0:{(1<<bits)-1}];\n  logic history_q;\n  logic [{bits-1}:0] fetch_index;\n  assign fetch_index = {expr};\n  always_ff @(posedge clock) begin\n    if (reset) history_q <= 1'b0;\n    else if (branch_update) history_q <= branch_taken;\n  end''')\n edit('if_stage.sv','counters[pc[8:2]]','counters[fetch_index]')\n edit('if_stage.sv','i < 128',f'i < {1<<bits}')\n edit('if_stage.sv','out.predicted_taken = predicted_taken;','out.predicted_taken = predicted_taken;\\\\n    out.prediction_index = fetch_index;')\n edit('id_stage.sv',\\\"reg_q.predicted_taken <= 1'b0;\\\",\\\"reg_q.predicted_taken <= 1'b0;\\\\n        reg_q.prediction_index <= '0;\\\")\n edit('id_stage.sv','reg_q.predicted_taken <= in.predicted_taken;','reg_q.predicted_taken <= in.predicted_taken;\\\\n        reg_q.prediction_index <= in.prediction_index;')\n edit('ex_stage.sv','output logic [6:0]         branch_index,',f'output logic [{bits-1}:0]         branch_index,')\n edit('ex_stage.sv','assign branch_index = in.pc[8:2];','assign branch_index = in.prediction_index;')\n edit('core.sv','logic [6:0]  branch_index;',f'logic [{bits-1}:0]  branch_index;')\n files=[str(rtl/'core_pkg.sv')]+[str(p) for p in sorted(rtl.glob('*.sv')) if p.name\"'!='\"'core_pkg.sv']\n r=subprocess.run(['verilator','--lint-only','-Wall','-Wno-MULTITOP','-sv','+incdir+'+str(rtl),*files],capture_output=True,text=True);assert r.returncode==0,r.stderr\nprint('Created and linted history-indexed predictor prototypes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
