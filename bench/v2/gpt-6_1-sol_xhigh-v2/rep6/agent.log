se if(req_valid && req_ready) begin pending_q<=1; result_q<=next_result; end\n  else if(result_ready && result_valid) pending_q<=0;\n end\nendmodule\n'\"''')\np=rtl/'ex_stage.sv';t=p.read_text()\nt=t.replace('  logic is_divide, div_req_ready, div_result_valid;', '''  logic is_divide, div_req_ready, div_result_valid;\n  ex_mem_t multiply_payload_q;\n  logic is_multiply, mul_req_ready, mul_result_valid, mul_launch, mul_transfer;\n  logic [31:0] mul_result;\n  assign is_multiply = (in.ctrl.alu_op == ALU_MUL) ||\n                      (in.ctrl.alu_op == ALU_MULH) ||\n                      (in.ctrl.alu_op == ALU_MULHU) ||\n                      (in.ctrl.alu_op == ALU_MULHSU);\n  assign mul_launch = in.valid && is_multiply && \"'!stall && mul_req_ready;\n  assign mul_transfer = in.valid && is_multiply && !stall && mul_result_valid;\n  mul_unit u_mul (\n    .clock(clock), .reset(reset),\n    .req_valid(mul_launch), .req_ready(mul_req_ready),\n    .req_op(in.ctrl.alu_op), .req_a(rs1), .req_b(rs2),\n    .result_valid(mul_result_valid), .result_ready(mul_transfer), .result(mul_result)\n  );\n  always_ff @(posedge clock) begin\n    if(reset) multiply_payload_q <= '\"'0;\n    else if(mul_launch) multiply_payload_q <= execute_payload;\n  end''')\nt=t.replace('assign busy = in.valid && is_divide && \"'!div_result_valid;'\"', 'assign busy = in.valid && ((is_divide && \"'!div_result_valid) || (is_multiply && !mul_result_valid));'\"')\nt=t.replace('assign bypass_data = is_divide ? div_result : execute_payload.alu_result;', 'assign bypass_data = is_multiply ? mul_result : (is_divide ? div_result : execute_payload.alu_result);')\nt=t.replace('assign bypass_rd = is_divide ? divide_payload_q.rd : in.rd;', 'assign bypass_rd = is_multiply ? multiply_payload_q.rd : (is_divide ? divide_payload_q.rd : in.rd);')\nt=t.replace('&& (is_divide\\\\n                          ?', '''&& (is_multiply\n                          ? (mul_transfer && multiply_payload_q.valid\n                             &