{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '280,580p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — capture current MEM's result.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n    [load] = _by_insn(rets, LW(1, 0, 0))\n    assert r2[\"cycle\"] == load[\"cycle\"] + 2, \"exactly one load-use bubble\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked,\n…[8908 of 11980 chars elided by tools/bench/transcript.py; sha256:0a6a04135c71b9cc]…\n         8: ADDI(1, 0, 24), 12: JALR(2, 1, 0),\n               16: LW(3, 0, 0x104), 24: EBREAK()}\n    fetches, events = [], []\n    # The wrong-path fetch never becomes ready. Both corrections must\n    # update PC anyway, without accepting its decoded memory controls.\n    rets, mem = await _run(\n        dut, program, memory_events=events, fetch_events=fetches,\n        bus_schedule=lambda cycle, ia, da, wen, ren: (ia not in (4, 16), True))\n    assert [r[\"pc\"] for r in rets] == [0, 8, 12, 24]\n    assert [r[\"pc_next\"] for r in rets] == [8, 12, 24, 28]\n    assert rets[2][\"rd_wdata\"] == 16 and rets[2][\"rs1_rdata\"] == 24\n    assert {ia for _, ia, ready, _ in fetches if not ready} == {4, 16}\n    assert not events and not mem\n\n\n@cocotb.test()\nasync def predictor_invalid_raw_memory_is_a_bubble(dut):\n    program = [LW(1, 0, 0x100), SW(1, 0, 0x104), EBREAK()]\n    waits = {0: 7, 4: 7}\n    def schedule(cycle, ia, da, wen, ren):\n        remaining = waits.get(ia, 0)\n        if remaining:\n            waits[ia] = remaining - 1\n", "exit_code": 0, "status": "completed"}}
