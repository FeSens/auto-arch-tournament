{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport subprocess\nbase=Path('/srv/hwebench/tmp/6b356b5e/4a1495cc')\nfor width in (4,8):\n n=32//width\n s=f'''module comparator_miter(input [31:0] a,b, input [2:0] op, output ok);\n wire [{2*n-2}:0] eq,lt;\n genvar k;\n generate for(k=0;k<{n};k=k+1) begin\n assign eq[{n-1}+k]=a[{width}*k+:{width}]==b[{width}*k+:{width}];\n assign lt[{n-1}+k]=a[{width}*k+:{width}]<b[{width}*k+:{width}];\n end\n for(k=0;k<{n-1};k=k+1) begin\n assign eq[k]=eq[2*k+2]&eq[2*k+1];\n assign lt[k]=lt[2*k+2]|(eq[2*k+2]&lt[2*k+1]);\n end endgenerate\n wire slt=(a[31]\"'^b[31])?a[31]:lt[0];\n reg old_cond,new_cond;\n always @* begin\n case(op)\n 0:old_cond=(a==b); 1:old_cond=(a!=b);\n 4:old_cond=($signed(a)<$signed(b)); 5:old_cond=($signed(a)>=$signed(b));\n 6:old_cond=(a<b); 7:old_cond=(a>=b); default:old_cond=0;\n endcase\n case(op)\n 0:new_cond=eq[0]; 1:new_cond=!eq[0]; 4:new_cond=slt; 5:new_cond=!slt;\n 6:new_cond=lt[0]; 7:new_cond=!lt[0]; default:new_cond=0;\n endcase\n end\n assign ok=(old_cond==new_cond);\n endmodule\n'\"'''\n p=base/f'comparator{width}_miter.sv';p.write_text(s)\n r=subprocess.run(['yosys','-Q','-p',f'read_verilog -sv {p}; prep -top comparator_miter; flatten; sat -verify -prove ok 1 -show-inputs'],text=True,capture_output=True)\n (base/f'comparator{width}_proof.log').write_text(r.stdout+r.stderr)\n print(width, r.returncode, 'proven' if 'SUCCESS' in r.stdout else r.stdout[-500:])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
