{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/6b356b5e/a76b405a/r9s0-probes')\nrtl=Path('cores/bench/rtl').resolve()\nbase.mkdir(exist_ok=True)\nfor name in ['baseline','byte_lookahead']:\n shutil.copytree(rtl,base/name,dirs_exist_ok=True)\np=base/'byte_lookahead'/'alu.sv'\ns=p.read_text()\nnetwork='''\n  logic [31:0] fast_add, fast_sub;\n  logic [31:0] add_gen, sub_gen;\n  logic [31:0] add_prop, sub_prop;\n  logic [3:0] ag, ap, sg, sp;\n  logic [3:0] ac, sc;\n  assign ac[0] = 1'b0;\n  assign ac[1] = ag[0];\n  assign ac[2] = ag[1] | (ap[1] & ag[0]);\n  assign ac[3] = ag[2] | (ap[2] & ag[1]) | (ap[2] & ap[1] & ag[0]);\n  assign sc[0] = 1'b1;\n  assign sc[1] = sg[0] | sp[0];\n  assign sc[2] = sg[1] | (sp[1] & sg[0]) | (sp[1] & sp[0]);\n  assign sc[3] = sg[2] | (sp[2] & sg[1]) | (sp[2] & sp[1] & sg[0]) | (sp[2] & sp[1] & sp[0]);\n  assign add_gen = a & b;\n  assign add_prop = a \"'^ b;\n  assign sub_gen = a & ~b;\n  assign sub_prop = a ''^ ~b;\n  for (genvar j=0;j<4;j=j+1) begin : byte_arith\n    wire [8:0] az = {1'\"'b0,a[j*8 +: 8]} + {1'b0,b[j*8 +: 8]};\n    wire [8:0] sz = {1'b0,a[j*8 +: 8]} + {1'b0,~b[j*8 +: 8]};\n    wire [7:0] ao = a[j*8 +: 8] + b[j*8 +: 8] + 8'd1;\n    wire [7:0] so = a[j*8 +: 8] + ~b[j*8 +: 8] + 8'd1;\n    assign ag[j] = az[8];\n    assign sg[j] = sz[8];\n    assign ap[j] = &add_prop[j*8 +: 8];\n    assign sp[j] = &sub_prop[j*8 +: 8];\n    assign fast_add[j*8 +: 8] = ac[j] ? ao : az[7:0];\n    assign fast_sub[j*8 +: 8] = sc[j] ? so : sz[7:0];\n  end\n'''\nnetwork=network.replace('  logic [31:0] add_gen, sub_gen;\\\\n','').replace('  assign add_gen = a & b;\\\\n','').replace('  assign sub_gen = a & ~b;\\\\n','')\ns=s.replace('  always_comb begin',network+'\\\\n  always_comb begin',1).replace('out = a + b;','out = fast_add;').replace('out = a - b;','out = fast_sub;')\np.write_text(s)\n(base/'probe_timing.py'