{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor delayed in (False,True):\n name='hypgen_local_delayed' if delayed else 'hypgen_local'\n p=Path('cores/bench/generated')/name\n src='cores/bench/generated/hypgen_train/rtl' if delayed else 'cores/bench/rtl'\n shutil.copytree(src,p/'rtl',dirs_exist_ok=True)\n s=p/'rtl/if_stage.sv'\n t=s.read_text()\n start=t.index('  // Train only on the single EX-to-EX/MEM acceptance event,')\n end=t.index('  assign imem_addr',start)\n valid,index,taken=('train_valid_q','train_index_q','train_taken_q') if delayed else ('branch_update','branch_index','branch_taken')\n update=f'''  // Each row updates from its own state; no shared training read mux.\n  for (genvar row = 0; row < 128; row++) begin : g_counter\n    always_ff @(posedge clock) begin\n      if (reset) counters[row] <= 2'b01;\n      else if ({valid} && {index} == 7'(row)) begin\n        if ({taken}) begin\n          counters[row][1] <= counters[row][1] | counters[row][0];\n          counters[row][0] <= counters[row][1] | \"'!counters[row][0];\n        end else begin\n          counters[row][1] <= counters[row][1] & counters[row][0];\n          counters[row][0] <= counters[row][1] & !counters[row][0];\n        end\n      end\n    end\n  end\n\n'\"'''\n s.write_text(t[:start]+update+t[end:])\n print(name,'ready')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
