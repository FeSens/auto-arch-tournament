{"type": "item.started", "item": {"id": "item_57", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport yaml,json,jsonschema\np=Path('cores/bench/experiments/hypotheses/hyp-20261002-003-r5s2.yaml');h=yaml.safe_load(p.read_text())\nh['title']='Local prediction squash clears control while freeing payload registers'\ns=h['hypothesis']\ns=s.replace('control/valid update logic','control/valid/prediction update logic')\ns=s.replace('ALU inputs, rd,\\\\npredicted_taken and direct_target','ALU inputs, rd and direct_target')\ns=s.replace('ALU inputs and destination metadata','ALU inputs and destination metadata')\ns=s.replace('ALU inputs','ALU inputs')\ns=s.replace('ALU inputs,','ALU inputs,')\ns=s.replace('alu_a/alu_b, rd,\\\\npredicted_taken and direct_target','alu_a/alu_b, rd and direct_target')\ns=s.replace('clears the entire ctrl_t plus valid.','clears the entire ctrl_t plus valid and predicted_taken.')\ns=s.replace('Also clear ctrl_t and valid when','Also clear ctrl_t, valid and predicted_taken when')\ns=s.replace('otherwise an unstalled valid input','otherwise an unstalled valid input')\ns=s.replace('existing decoded control bundle and sets valid; a stall without flush\\\\nholds both control and valid.','existing decoded control bundle and predicted_taken, and sets valid; a\\\\nstall without flush holds control, valid and predicted_taken.')\ns=s.replace('An invalid payload\\\\'s preserved prediction bit cannot affect correction\\\\nbecause ex_advance requires valid.','A bubble must clear predicted_taken as part of prediction control, keeping\\\\ninactive speculation out of the next EX correction cone; ex_advance still\\\\nrequires valid.')\nstart=s.index('An isolated RTL prototype gives option-0')\ns=s[:start]+'''An isolated prototype of this exact policy gives placement-option 0/1\nFmax 90.815 and 93.817 MHz, with option 2 being verified. The expected\nmedian is 93.817 MHz if option 2 agrees, giving 218.360 iter/s