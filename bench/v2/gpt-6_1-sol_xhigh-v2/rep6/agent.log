{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_id_stage.py; cat cores/bench/test/conftest.py; cat cores/bench/core.yaml'", "aggregated_output": "\"\"\"ID/EX hold/squash priorities with a live prediction and nonzero payload.\"\"\"\nimport itertools\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# Packed id_ex_t has valid at bit 0, target at 32:1, direction at 33,\n# instruction at 65:34 and the entire 22-bit ctrl_t at 87:66.\n_CTRL_MASK = ((1 << 22) - 1) << 66\n_PRED_MASK = 1 << 33\n_CONTROL_MASK = _CTRL_MASK | _PRED_MASK | 1\n_PAYLOAD_MASK = ((1 << 295) - 1) ^ _CONTROL_MASK\n\n\ndef _fetch(pc, instr, predicted_taken, target, valid):\n    return (((((pc << 32) | instr) << 1 | predicted_taken) << 32 | target) << 1) | valid\n\n\nasync def _edge(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    result = int(dut.out.value)\n    dut.clock.value = 0\n    return result\n\n\n@cocotb.test()\nasync def squash_hold_advance_priority(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)  # MUL x3,x1,x2\n    dut.rs1_data.value = 0x12345678\n    dut.rs2_data.value = 0x87654321\n    dut.fwd_rs1_sel.value = 1\n    dut.fwd_rs2_sel.value = 2\n    dut.fwd_ex_data.value = 0xA5A55A5A\n    dut.fwd_mem_data.value = 0x55AA33CC\n    assert len(dut.out) == 295\n    assert await _edge(dut) == 0, \"reset clears payload even during a hold/squash\"\n    dut.reset.value = 0\n\n    for stall, flush, valid in itertools.product((0, 1), repeat=3):\n        # Seed each case with nonzero payload, arithmetic controls and a\n        # prediction. This makes a missed direction clear visible on holds.\n        dut.stall.value = 0\n        dut.flush.value = 0\n        dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)\n        before = await _edge(dut)\n        assert before & _CTRL_MASK and before & _PRED_MASK and before & 1\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut[\"in\"].value = _fetch(0xA0, 0xABCD1297, 1, 0xCC, valid)  # AUIPC x5\n        dut.fwd_ex_data.value = 0xDEADBEEF\n        dut.fwd_mem_data.value = 0xCAFEBABE\n        after = await _edge(dut)\n        if stall:\n            assert after & _PAYLOAD_MASK == before & _PAYLOAD_MASK\n        else:\n            assert after >> 263 == 0xA0  # PC advances on every unstalled edge\n            assert (after >> 34) & 0xFFFFFFFF == 0xABCD1297\n            assert (after >> 1) & 0xFFFFFFFF == 0xCC\n            assert after & _PAYLOAD_MASK != before & _PAYLOAD_MASK\n        if flush or (not stall and not valid):\n            assert after & _CONTROL_MASK == 0\n        elif stall:\n            assert after & _CONTROL_MASK == before & _CONTROL_MASK\n        else:\n            assert after & 1 and after & _PRED_MASK\n            assert (after >> 66) & ((1 << 22) - 1) == int(dut.ctrl_decoded.value)\n\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 0\n    assert await _edge(dut) == 0\n\n\ndef test_id_stage_runner():\n    run_cocotb(\"id_stage\", [\"core_pkg.sv\", \"decoder.sv\", \"imm_gen.sv\", \"id_stage.sv\"],\n               \"test_id_stage\")\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 93.817\n  lut4: 3675\n  ff: 1090\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261002-003-r5s2\n  updated: '2026-10-02T19:22:34.323434Z'\n", "exit_code": 0, "status": "completed"}}
