 [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_id/reg_q.rs1_val_29_s0\", \"slack_ns\": -8.181, \"arrival_ns\": 18.475, \"logic_cells\": 37, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_id\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_id/reg_q.alu_b_17_s0\", \"slack_ns\": -8.169, \"arrival_ns\": 18.463, \"logic_cells\": 38, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_id\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_if/counters_counters_RAMREG_0_G[83]_s0\", \"slack_ns\": -8.135, \"arrival_ns\": 18.429, \"logic_cells\": 38, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\"]}]}\nrecovery_squash {\"place_option\": 0, \"placement_failed\": false, \"fmax_mhz\": 93.588, \"levels\": 12, \"logic\": 3675, \"regs\": 1090, \"lutram\": 40, \"bsram\": 4, \"dsp\": 2, \"critical_paths\": [{\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_id/reg_q.rs2_val_6_s0\", \"slack_ns\": -5.685, \"arrival_ns\": 15.979, \"logic_cells\": 37, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_id\"]}, {\"from\": \"lfsr_17_s0\", \"to\": \"cpu/u_id/reg_q.alu_a_22_s0\", \"slack_ns\": -5.681, \"arrival_ns\": 15.976, \"logic_cells\": 9, \"modules\": [\"clock_ibuf\", \"cpu/u_rf\", \"cpu/u_id\"]}, {\"from\": \"dmem_3_dmem_3_0_0_s\", \"to\": \"cpu/u_id/reg_q.alu_b_14_s0\", \"slack_ns\": -5.681, \"arrival_ns\": 15.976, \"logic_cells\": 9, \"modules\": [\"clock_ibuf\", \"cpu/u_mem\", \"cpu/u_id\"]}, {\"from\": \"cpu/u_id/reg_q.alu_a_16_s0\", \"to\": \"dmem_0_dmem_0_0_0_s\", \"slack_ns\": -5.68, \"arrival_ns\": 15.974, \"logic_cells\": 10, \"modules\": [\"clock_ibuf\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\", \"cpu/u_id\", \"cpu/u_ex\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_id/reg_q.alu_b_29_s0\", \"slack_ns\": -5.669, \"arrival_ns\": 15.964, \"logic_cells\": 38, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_id\"]}]}\n", "exit_co