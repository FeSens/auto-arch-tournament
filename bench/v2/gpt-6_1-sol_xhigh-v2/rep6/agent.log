{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 -B - <<'PY'\nimport sys,json,collections\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM(); cpu.load_elf('/srv/hwebench/tmp/6b356b5e/bbd81d95/predictor_coremark.elf')\nactive=False; counts=collections.Counter(); sites=collections.Counter(); btbs={n:{} for n in [4,8,16,32,64]}; correct=collections.Counter(); stacks={n:[] for n in [2,4,8,16]}; ras_correct=collections.Counter(); maxdepth=0; depth=0\nfor num in range(10000000):\n r=cpu.step(); ins=r['insn']; pc=r['pc']; op=ins&127; rd=(ins>>7)&31; rs1=(ins>>15)&31\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True; continue\n if r['mem_wmask'] and r['mem_addr']==0x10000104: break\n if active:\n  counts['instructions']+=1\n  if op==0x63: counts['branches']+=1\n  if op==0x6f: counts['jal']+=1\n  if op==0x67:\n   counts['jalr']+=1; sites[hex(pc)]+=1\n   if rd==0 and rs1 in [1,5] and ins>>20==0:\n    counts['return']+=1\n    for n,s in stacks.items():\n     if s and s[-1]==r['npc']: ras_correct[n]+=1\n   for n,t in btbs.items():\n    idx=(pc>>2)&(n-1)\n    if t.get(idx)==(pc,r['npc']):correct[n]+=1\n    t[idx]=(pc,r['npc'])\n if not r['trap']:\n  if op in [0x6f,0x67] and rd in [1,5]:\n   depth+=1;maxdepth=max(maxdepth,depth)\n   for n,s in stacks.items():\n    if len(s)==n:s.pop(0)\n    s.append((pc+4)&0xffffffff)\n  elif op==0x67 and rd==0 and rs1 in [1,5] and ins>>20==0:\n   depth=max(0,depth-1)\n   for n,s in stacks.items():\n    if s:s.pop()\nprint(json.dumps({'counts':counts,'jalr_sites':sites,'btb_correct':correct,'ras_return_correct':ras_correct,'maxdepth':maxdepth,'retired':num},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
