{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/6b356b5e/8e384919/fetch_queue_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(src,rtl/src.name)\np=rtl/'if_stage.sv'\ns=p.read_text().replace('  input  logic              stall,','  input  logic              imem_ready,\\\\n  input  logic              stall,',1)\nstart=s.index('  // A ready correction overrides')\nend=s.index('  // Train only',start)\ns=s[:start]+'''  if_id_t head_q, tail_q, fetch_payload;\n  logic [1:0] count_q;\n  logic pop, push;\n  assign pop = (count_q \"'!= 0) && !stall && !flush && !reset;\n  assign push = imem_ready && !reset && !redirect\n                && ((count_q != 2) || pop);\n  always_comb begin\n    fetch_payload.pc = pc;\n    fetch_payload.instr = imem_data;\n    fetch_payload.predicted_taken = predicted_taken;\n    fetch_payload.direct_target = direct_target;\n    fetch_payload.valid = 1'\"'b1;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      count_q <= 0;\n      head_q <= '0;\n      tail_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count_q <= 0;\n    end else begin\n      if (push) pc <= next_pc;\n      case ({push, pop})\n        2'b10: count_q <= count_q + 2'd1;\n        2'b01: count_q <= count_q - 2'd1;\n        default: count_q <= count_q;\n      endcase\n      if (pop && count_q == 2) head_q <= tail_q;\n      if (push) begin\n        if (count_q == 0 || (pop && count_q == 1)) head_q <= fetch_payload;\n        else tail_q <= fetch_payload;\n      end\n    end\n  end\n\n'''+s[end:]\nstart=s.index('  always_comb begin\\\\n    out.pc')\ns=s[:start]+'''  always_comb begin\n    out = head_q;\n    out.valid = (count_q \"'!= 0) && !flush && !reset;\n  end\n\nendmodule\n'\"'''\np.write_text(s)\np=rtl/'core.sv'\ns=p.read_text().replace('    .stall           (stall_if),','    .imem_ready      (io_imemReady),\\\\n    .stall           (stall_if),',1)\np.write_text(s)\np=rtl/'hazard_unit.sv'\ns=p.read_text().replace('    imem_stall = \"'!imem_ready;'\"','    imem_stall = 1\\\\'b0;')\np.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
