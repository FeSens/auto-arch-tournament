{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor variant in ['predicate','treepredicate']:\n root=Path('cores/bench/generated/hypgen_'+variant);rtl=root/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\n p=rtl/'ex_stage.sv';s=p.read_text()\n start=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');end=s.index('    branch_taken  = ',start)\n if variant=='treepredicate':\n  decl='''  wire [30:0] compare_eq, compare_lt;\n  wire equal_operands = compare_eq[0];\n  wire unsigned_less = compare_lt[0];\n  generate\n    for (genvar i=0; i<16; i=i+1) begin: compare_leaf\n      assign compare_eq[15+i] = rs1[2*i +: 2] == rs2[2*i +: 2];\n      assign compare_lt[15+i] = rs1[2*i +: 2] < rs2[2*i +: 2];\n    end\n    for (genvar n=0; n<15; n=n+1) begin: compare_node\n      assign compare_eq[n] = compare_eq[2*n+2] & compare_eq[2*n+1];\n      assign compare_lt[n] = compare_lt[2*n+2] | (compare_eq[2*n+2] & compare_lt[2*n+1]);\n    end\n  endgenerate\n'''\n else:\n  decl='''  wire equal_operands = rs1 == rs2;\n  wire unsigned_less = rs1 < rs2;\n'''\n decl += '''  wire signed_less = (rs1[31] \"'^ rs2[31]) ? rs1[31] : unsigned_less;\n  wire selected_less = in.ctrl.branch_op[1] ? unsigned_less : signed_less;\n\n  always_comb begin\n    branch_cond = (in.ctrl.branch_op[2] ? selected_less : equal_operands)\n                  ''^ in.ctrl.branch_op[0];\n    if (!in.ctrl.branch_op[2] && in.ctrl.branch_op[1]) branch_cond = 1'\"'b0;\n'''\n s=s[:start]+decl+s[end:];p.write_text(s)\n print('Created',variant)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
