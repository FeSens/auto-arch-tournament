{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom importlib.util import spec_from_file_location,module_from_spec\nfrom collections import Counter\nimport sys,json\np=Path.cwd()\nspec=spec_from_file_location('reference',p/'test/cosim/reference.py')\nm=module_from_spec(spec); sys.modules['reference']=m; spec.loader.exec_module(m)\ncpu=m.RV32IM(); cpu.load_elf(str(p.parents[3]/'bench/programs/coremark.elf'))\ncounts=Counter(); active=False; n=0\nwhile n<10000000:\n insn=cpu.rw(cpu.pc)\n r=cpu.step()\n n+=1\n if active:\n  counts['instructions']+=1\n  if (insn & 0xfe00007f)==0x02000033:\n   counts['mul' if ((insn>>12)&7)<4 else 'div']+=1\n if r and r.get('mem_wmask') and r.get('mem_addr')==0x10000100:\n  active=True\n if r and r.get('mem_wmask') and r.get('mem_addr')==0x10000104:\n  break\n if insn==0x00100073: break\nprint(json.dumps({'counts':counts,'steps':n,'active':active,'mul_per_baseline_cycle':counts['mul']/4202272,'oob':cpu.oob_access}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
