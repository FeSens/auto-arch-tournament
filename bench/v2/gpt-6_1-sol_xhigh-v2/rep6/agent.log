{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nwt=Path.cwd()\nbase=Path('/srv/hwebench/tmp/6b356b5e/7019e6c2/r11-probes')\nbase.mkdir(exist_ok=True)\nfor width in [4,8,16]:\n d=base/f'carry{width}'/'rtl'; d.mkdir(parents=True,exist_ok=True)\n for p in (wt/'cores/bench/rtl').glob('*.sv'): shutil.copyfile(p,d/p.name)\n n=32//width\n s=(d/'alu.sv').read_text()\n decl=['  logic arith_sub;','  logic [31:0] arith_b, arith_result;',f'  logic [{n}:0] arith_carry;',f'  logic [{n-1}:0] group_g, group_p;',f'  logic [{width}:0] sum0 [0:{n-1}];',f'  logic [{width}:0] sum1 [0:{n-1}];','  assign arith_sub = (op == ALU_SUB);',\\\"  assign arith_b = b \"'^ {32{arith_sub}};\",'\"'  assign arith_carry[0] = arith_sub;']\n for i in range(n):\n  sl=f'[{i*width} +: {width}]'\n  decl += [f\\\"  assign sum0[{i}] = {{1'b0, a{sl}}} + {{1'b0, arith_b{sl}}};\\\",f\\\"  assign sum1[{i}] = {{1'b0, a{sl}}} + {{1'b0, arith_b{sl}}} + {width+1}'d1;\\\",f'  assign group_g[{i}] = sum0[{i}][{width}];',f'  assign group_p[{i}] = &(a{sl} \"'^ arith_b{sl});'\"',f'  assign arith_result{sl} = arith_carry[{i}] ? sum1[{i}][{width-1}:0] : sum0[{i}][{width-1}:0];']\n # Parallel-doubling group prefix; bounded group counts only.\n prevg='group_g'; prevp='group_p'\n depth=(n-1).bit_length()\n for l in range(depth):\n  g=f'prefix_g{l}';p=f'prefix_p{l}';decl += [f'  logic [{n-1}:0] {g}, {p};']\n  for i in range(n):\n   dist=1<<l\n   if i<dist: decl += [f'  assign {g}[{i}] = {prevg}[{i}];',f'  assign {p}[{i}] = {prevp}[{i}];']\n   else: decl += [f'  assign {g}[{i}] = {prevg}[{i}] | ({prevp}[{i}] & {prevg}[{i-dist}]);',f'  assign {p}[{i}] = {prevp}[{i}] & {prevp}[{i-dist}];']\n  prevg=g;prevp=p\n for i in range(n): decl += [f'  assign arith_carry[{i+1}] = {prevg}[{i}] | ({prevp}[{i}] & arith_sub);']\n s=s.replace('  logic        [4:0]  shamt;', '  logic        [4:0]  shamt;\\\\n\\\\n'+'\\\\n'.join(decl))\n s=s.