{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,95p' cores/bench/test/test_ex_stage.py; tail -5 formal/last_run-wxOuyknA8.log; git status --short\"", "aggregated_output": "\"\"\"EX acceptance, saved multiply metadata and response backpressure tests.\"\"\"\nfrom __future__ import annotations\n\nimport os\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import ALU_ADD, ALU_MUL, ALU_MULH, ALU_MULHSU, RTL, TEST_DIR, SIM_BUILD\n\nMASK = 0xFFFFFFFF\nALTOPS = os.environ.get(\"BENCH_EX_ALTOPS\") == \"1\"\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32),\n         (\"alu_a\", 32), (\"alu_b\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"predicted_taken\", 1), (\"direct_target\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"recovery_pending\", 1),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, values):\n    packed = 0\n    for name, width in layout:\n        packed = (packed << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return packed\n\n\ndef _unpack(layout, packed):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    assert packed == 0\n    return fields\n\n\ndef _input(op=ALU_MUL, a=9, b=7, rd=3, pc=0x40, valid=1, **controls):\n    funct3 = {ALU_MUL: 0, ALU_MULH: 1, ALU_MULHSU: 2}.get(op, 0)\n    instr = (1 << 25) | (2 << 20) | (1 << 15) | (funct3 << 12) | (rd << 7) | 0x33\n    ctrl = _pack(CTRL, dict(alu_op=op, reg_write=1, **controls))\n    return _pack(ID_EX, dict(pc=pc, rs1_val=a, rs2_val=b, alu_a=a, alu_b=b,\n                            rd=rd, rs1_addr=1, rs2_addr=2, ctrl=ctrl, instr=instr, valid=valid))\n\n\ndef _want(op, a, b):\n    if ALTOPS:\n        constant = {ALU_MUL: 0x5876063E, ALU_MULH: 0xF6583FB7, ALU_MULHSU: 0xECFBE137}[op]\n        return ((a - b if op == ALU_MULHSU else a + b) ^ constant) & MASK\n    sa = a - (1 << 32) if a >> 31 and op != ALU_MUL else a\n    sb = b - (1 << 32) if b >> 31 and op == ALU_MULH else b\n    return ((sa * sb) >> (0 if op == ALU_MUL else 32)) & MASK\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.kill.value = 0\n    dut[\"in\"].value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.out.value) == 0\n    assert int(dut.bypass_w_en.value) == int(dut.busy.value) == 0\n\n\n@cocotb.test()\nasync def older_memory_priority_and_held_multiply_response(dut):\n    await _reset(dut)\n    # An older store is held in EX/MEM until accepted; multiply cannot launch\n    # or replace it during that hold.\n    dut[\"in\"].value = _input(ALU_ADD, 0x100, 4, rd=0, mem_write=1)\n    await _tick(dut)\n    older = int(dut.out.value)\n    assert _unpack(CTRL, _unpack(EX_MEM, older)[\"ctrl\"])[\"mem_write\"] == 1\n    op, a, b = ALU_MULHSU, 0x80000000, MASK\n    original = _input(op, a, b, rd=5, pc=0x44)\nSBY  4:45:55 [insn_xor_ch0] engine_0: ##   0:00:00  Skipping step 16..\nSBY  4:45:55 [insn_xor_ch0] engine_0: ##   0:00:00  Skipping step 17..\nSBY  4:45:55 [insn_xor_ch0] engine_0: ##   0:00:00  Skipping step 18..\nSBY  4:45:56 [insn_xor_ch0] engine_0: ##   0:00:00  Skipping step 19..\nSBY  4:45:56 [insn_xor_ch0] engine_0: ##   0:00:00  Checking assumptions in step 20..\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_ex_stage.py\n M cores/bench/test/test_pipeline.py\n", "exit_code": 0, "status": "completed"}}
