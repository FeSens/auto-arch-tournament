                   && imem_data[14:12] != 3'd3;\n    direct_jal = imem_data[6:0] == 7'b1101111;\n    direct_imm = direct_jal\n               ? {{11{imem_data[31]}}, imem_data[31], imem_data[19:12],\n                  imem_data[20], imem_data[30:21], 1'b0}\n               : {{19{imem_data[31]}}, imem_data[31], imem_data[7],\n                  imem_data[30:25], imem\n…[8594 of 11666 chars elided by tools/bench/transcript.py; sha256:b0d0406a3e31cebc]…\nc_mem_to_reg;\n    ctrl_decoded.is_illegal = dec_is_illegal;\n  end\n\n  // ── ID/EX register ──────────────────────────────────────────────────────\n  id_ex_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (!stall) begin\n      if (!in.valid) begin\n        // Raw unavailable instructions still decode combinationally, but\n        // no control may enter MEM/forwarding with an invalid bubble.\n        reg_q <= '0;\n      end else begin\n        reg_q.pc       <= in.pc;\n        reg_q.rs1_val  <= rs1_data;\n        reg_q.rs2_val  <= rs2_data;\n        reg_q.imm      <= imm;\n        reg_q.rd       <= in.instr[11:7];\n        reg_q.rs1_addr <= in.instr[19:15];\n        reg_q.rs2_addr <= in.instr[24:20];\n        reg_q.ctrl     <= ctrl_decoded;\n        reg_q.instr    <= in.instr;\n        reg_q.predicted_taken <= in.predicted_taken;\n        reg_q.direct_target <= in.direct_target;\n        reg_q.valid    <= 1'b1;\n      end\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
