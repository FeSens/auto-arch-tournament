{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/6b356b5e/27a319cc/predictor-r14s2')\nvariants=['last-outcome-128','bimodal-32-folded','bimodal-64-folded','bimodal-256-folded']\nfor name in variants:\n rtl=base/name/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\n p=rtl/'if_stage.sv';s=p.read_text()\n if name=='last-outcome-128':\n  s=s.replace('logic [1:0] counters [0:127]','logic counters [0:127]').replace('counters[pc[8:2]][1]','counters[pc[8:2]]')\n  s=s.replace(\\\"counters[i] <= 2'b01\\\",\\\"counters[i] <= 1'b0\\\")\n  start=s.index('      if (branch_taken && counters');end=s.index('\\\\n    end\\\\n  end',start)\n  s=s[:start]+'      counters[branch_index] <= branch_taken;'+s[end:]\n else:\n  n=int(name.split('-')[1]);b=n.bit_length()-1\n  s=s.replace('logic [6:0]        branch_index',f'logic [{b-1}:0]        branch_index')\n  s=s.replace('counters [0:127]',f'counters [0:{n-1}]').replace('i < 128',f'i < {n}')\n  s=s.replace('counters[pc[8:2]][1]',f'counters[pc[{b+1}:2] \"'^ pc[{b*2+1}:{b+2}]][1]'\"')\n  e=rtl/'ex_stage.sv';es=e.read_text().replace('logic [6:0]         branch_index',f'logic [{b-1}:0]         branch_index').replace('in.pc[8:2]',f'in.pc[{b+1}:2] \"'^ in.pc[{b*2+1}:{b+2}]'\"');e.write_text(es)\n  c=rtl/'core.sv';cs=c.read_text().replace('logic [6:0]  branch_index',f'logic [{b-1}:0]  branch_index');c.write_text(cs)\n p.write_text(s)\nprint('Temporary predictor variants ready:',variants)\nPY\npython3 - <<'PY'\nfrom tools.eval.gowin import build_all,summarize\nfrom pathlib import Path\nimport json,time\nbase=Path('/srv/hwebench/tmp/6b356b5e/27a319cc/predictor-r14s2')\nfor name in ['last-outcome-128','bimodal-32-folded','bimodal-64-folded','bimodal-256-folded']:\n begin=time.monotonic();s=base/name\n result=summarize(build_all(Path.cwd(),s/'rtl','fpga/core_bench_si.sv',s/'timing'))\n (s/'timing-summary.json').write_text(json.dumps(result,indent=2))\n print(name,json.dumps(result),'ELAPSED',round(time.monotonic()-begin,1),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
