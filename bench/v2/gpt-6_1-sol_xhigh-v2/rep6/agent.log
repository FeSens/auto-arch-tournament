{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"EX acceptance, saved multiply metadata and response backpressure tests.\"\"\"\nfrom __future__ import annotations\n\nimport os\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import ALU_ADD, ALU_MUL, ALU_MULH, ALU_MULHSU, RTL, TEST_DIR, SIM_BUILD\n\nMASK = 0xFFFFFFFF\nALTOPS = os.environ.get(\"BENCH_EX_ALTOPS\") == \"1\"\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"rs1_val\", 32), (\"rs2_val\", 32),\n         (\"alu_a\", 32), (\"alu_b\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"predicted_taken\", 1), (\"direct_target\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(layout, values):\n    packed = 0\n    for name, width in layout:\n        packed = (packed << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return packed\n\n\ndef _unpack(layout, packed):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = packed & ((1 << width) - 1)\n        packed >>= width\n    assert packed == 0\n    return fields\n\n\ndef _input(op=ALU_MUL, a=9, b=7, rd=3, pc=0x40, valid=1, **controls):\n    funct3 = {ALU_MUL: 0, ALU_MULH: 1, ALU_MULHSU: 2}.get(op, 0)\n    instr = (1 << 25) | (2 << 20) | (1 << 15) | (funct3 << 12) | (rd << 7) | 0x33\n    ctrl = _pack(CTRL, dict(alu_op=op, reg_write=1, **controls))\n    return _pack(ID_EX, dict(pc=pc, rs1_val=a, rs2_val=b, alu_a=a, alu_b=b,\n                            rd=rd\n…[4130 of 7202 chars elided by tools/bench/transcript.py; sha256:8045df4e03835887]…\nsult_valid.value) == 1\n    assert int(dut.bypass_w_en.value) == 0  # x0 still executes and retires\n    await _tick(dut)\n    assert _unpack(EX_MEM, int(dut.out.value))[\"alu_result\"] == _want(ALU_MUL, 3, 4)\n\n\ndef _runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"ex_stage_altops\" if altops else \"ex_stage\")\n    runner.build(sources=[RTL / filename for filename in\n                         (\"core_pkg.sv\", \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"ex_stage.sv\")],\n                 hdl_toplevel=\"ex_stage\", build_dir=build_dir, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if altops else {},\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"])\n    runner.test(hdl_toplevel=\"ex_stage\", test_module=\"test_ex_stage\",\n                test_dir=TEST_DIR, build_dir=build_dir,\n                extra_env={\"BENCH_EX_ALTOPS\": \"1\" if altops else \"0\"})\n\n\ndef test_ex_stage_runner():\n    _runner(False)\n\n\ndef test_ex_stage_altops_runner():\n    _runner(True)\n", "exit_code": 0, "status": "completed"}}
