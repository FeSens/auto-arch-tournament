{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '110,330p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = (dict(program) if isinstance(program, dict) else\n            {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)})\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    rng = random.Random(int(stalls))\n    forced_wait = 0\n    previous_request = None\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n\n    assert int(dut.id_ex_w.value) == 0, \"reset must clear the entire ID/EX bundle\"\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        # Drive buses before the accepting edge. A held request only has\n        # a side effect on a ready edge, matching the cosim bus contract.\n        ia        = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())\n        dut.io_imemReady.value = int(not stalls or rng.random() >= 0.22)\n        await Timer(1, \"ns\")\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n        request = (da, wen, ren) if wen or ren else None\n        if stalls and request is not None and request != previous_request:\n            forced_wait = 5  # exercise a multi-cycle older LOAD/STORE stall\n        previous_request = request\n        dready = not stalls or (forced_wait == 0 and rng.random() >= 0.22)\n        if forced_wait:\n            forced_wait -= 1\n        if bus_schedule is not None:\n            iready, dready = bus_schedule(cycle, ia, da, wen, ren)\n            dut.io_imemReady.value = int(iready)\n        dut.io_dmemReady.value = int(dread\n…[7012 of 10084 chars elided by tools/bench/transcript.py; sha256:a8f71a3d4f42ec30]…\n      # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n    [load] = _by_insn(rets, LW(1, 0, 0))\n    assert r2[\"cycle\"] == load[\"cycle\"] + 2, \"exactly one load-use bubble\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n", "exit_code": 0, "status": "completed"}}
