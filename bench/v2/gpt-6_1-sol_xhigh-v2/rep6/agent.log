{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,time,json,collections\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nr=RV32IM();r.load_elf('/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep6/bench/programs/coremark.elf')\nactive=False; counters=[1]*128; stats=collections.Counter(); sites=collections.defaultdict(collections.Counter)\nbegin=time.monotonic()\nfor i in range(12000000):\n pc=r.pc;insn=r.rw(pc);branch=insn&127==0x63\n if branch:\n  a=r.regs[(insn>>15)&31];b=r.regs[(insn>>20)&31];f=(insn>>12)&7\n  sa=a if a<0x80000000 else a-0x100000000;sb=b if b<0x80000000 else b-0x100000000\n  taken={0:a==b,1:a\"'!=b,4:sa<sb,5:sa>=sb,6:a<b,7:a>=b}[f]\n  idx=(pc>>2)&127;pred=counters[idx]>=2;static=bool(insn>>31)\n  if active:\n   stats['\"'branches']+=1;stats['bimodal_misses']+=pred\"'!=taken;stats['\"'static_misses']+=static\"'!=taken\n   sites[pc]['\"'count']+=1;sites[pc]['static_misses']+=static\"'!=taken;sites[pc]['\"'bimodal_misses']+=pred\"'!=taken\n  counters[idx]=min(3,counters[idx]+1) if taken else max(0,counters[idx]-1)\n ret=r.step()\n if ret is None: break\n if active:stats['\"'instructions']+=1\n if ret['mem_wmask'] and ret['mem_addr']==0x10000100:active=True;stats['start_order']=r.retired\n if ret['mem_wmask'] and ret['mem_addr']==0x10000104:\n  stats['stop_order']=r.retired;active=False;break\n if i%500000==0:print('Profile progress:',i,'instructions',round(time.monotonic()-begin,1),'seconds',flush=True)\nprint('PROFILE',json.dumps(dict(stats)))\nprint('TOP_STATIC_COST',json.dumps([(hex(pc),dict(v)) for pc,v in sorted(sites.items(),key=lambda x:x[1]['static_misses']-x[1]['bimodal_misses'],reverse=True)[:12]]))\nprint('ELAPSED',round(time.monotonic()-begin,1))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
