gents run `make timing`\ntools/eval/gowin.py:195:        \"critical_path\": (ref.get(\"critical_paths\") or [None])[0],\ntools/eval/gowin.py:200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\ntools/eval/gowin.py:214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\ntools/eval/gowin.py:220:              f\"logic {r['logic']}, registers {r['regs']}, LUT-RAM {r['lutram']}, BSRAM {r['bsram']}, DSP {r['dsp']}\")\ntools/eval/gowin.py:221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\ntools/eval/gowin.py:222:        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\nfpga/scripts/synth.tcl:5:# files inside $rtl_dir/, so a hardcoded list would silently break\nfpga/scripts/synth.tcl:21:# visible to subsequent files.\nfpga/scripts/synth.tcl:34:# Both files define a module named core_bench; only one is read per run.\nfpga/scripts/nextpnr_run.sh:16:# path; cores/<target>/generated/synth.json for multi-core).\nfpga/scripts/nextpnr_run.sh:26:  --timing-allow-fail \\\n","exit_code":0,"status":"completed"}}
