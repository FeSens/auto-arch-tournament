{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_alu.py')\nPath('cores/bench/generated/test_alu_original.py').write_text(p.read_text())\ns=p.read_text()\ns+='''\n\n@cocotb.test()\nasync def shared_multiply_vectors(dut):\n    from random import Random\n    rng = Random(0x33)\n    edge = [0, 1, 2, 0x7fffffff, 0x80000000, 0x80000001,\n            0xfffffffe, 0xffffffff, 0x55555555, 0xaaaaaaaa,\n            0x0000ffff, 0xffff0000, 0x00010000, 0x8000ffff]\n    pairs = [(a, b) for a in edge for b in edge]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(1000)]\n    for a, b in pairs:\n        sa = a if a < 0x80000000 else a - (1 << 32)\n        sb = b if b < 0x80000000 else b - (1 << 32)\n        for op, product, high in [(ALU_MULH, sa * sb, True),\n                                  (ALU_MULHU, a * b, True),\n                                  (ALU_MULHSU, sa * b, True),\n                                  (ALU_MUL, a * b, False)]:\n            bits = product & ((1 << 64) - 1)\n            expected = (bits >> 32) if high else (bits & MASK32)\n            await _check(dut, op, a, b, expected)\n'''\np.write_text(s)\nPY\npytest -q cores/bench/test/test_alu.py cores/bench/test/test_pipeline.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
