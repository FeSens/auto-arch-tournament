{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1')\nroot=base/'prefix'\nrtl=root/'rtl'\nshutil.copytree(base/'retimed/rtl',rtl,dirs_exist_ok=True)\np=rtl/'core_pkg.sv'\ns=p.read_text().replace('logic [31:0] arith_sum0;\\\\n    logic [31:0] arith_sum1;\\\\n    logic [3:0] arith_g;\\\\n    logic [3:0] arith_p;','logic [31:0] arith_g;\\\\n    logic [31:0] arith_p;')\np.write_text(s)\np=rtl/'id_stage.sv'\ns=p.read_text()\na=s.index('  logic [31:0] prepare_a')\nb=s.index('  // ── ID/EX register',a)\ns=s[:a]+'''  logic [31:0] prepare_a, prepare_b, adjusted_b;\n  logic prepare_sub;\n  logic [31:0] prepare_g, prepare_p;\n  always_comb begin\n    prepare_a = dec_is_auipc ? in.pc : rs1_value;\n    prepare_b = dec_alu_src ? imm : rs2_value;\n    prepare_sub = dec_is_branch || (dec_alu_op == ALU_SUB)\n                  || (dec_alu_op == ALU_SLT) || (dec_alu_op == ALU_SLTU);\n    adjusted_b = prepare_b \"'^ {32{prepare_sub}};\n    prepare_g = prepare_a & adjusted_b;\n    prepare_p = prepare_a ''^ adjusted_b;\n  end\n\n'\"'''+s[b:]\ns=s.replace('reg_q.arith_sum0 <= prepare_sum0;\\\\n        reg_q.arith_sum1 <= prepare_sum1;\\\\n        ','')\np.write_text(s)\np=rtl/'ex_stage.sv'\ns=p.read_text()\na=s.index('  logic [4:0] carry;')\nb=s.index('  // ── Branch resolve',a)\ns=s[:a]+'''  logic [32:0] carry;\n  logic [31:0] prefix_g [0:5], prefix_p [0:5];\n  logic [31:0] prepared_result;\n  logic prepared_slt, prepared_sltu, prepared_equal;\n  always_comb begin\n    prefix_g[0] = in.arith_g;\n    prefix_p[0] = in.arith_p;\n    for (int level = 0; level < 5; level++) begin\n      for (int bitno = 0; bitno < 32; bitno++) begin\n        if (bitno >= (1 << level)) begin\n          prefix_g[level+1][bitno] = prefix_g[level][bitno]\n              | (prefix_p[level][bitno] & prefix_g[level][bitno-(1 << level)]);\n          prefix_p[level+1][bitno] = prefix_p[level][bitno]\n              & prefix_p[level][bitno-(1 << level)];\n        end else begin\n          prefix_g[level+1][bitno] = prefix_g[level][bitno];\n          prefix_p[level+1][bitno] = prefix_p[level][bitno];\n        end\n      end\n    end\n    carry[0] = in.arith_sub;\n    for (int bitno = 0; bitno < 32; bitno++) begin\n      carry[bitno+1] = prefix_g[5][bitno]\n                       | (prefix_p[5][bitno] & in.arith_sub);\n      prepared_result[bitno] = in.arith_p[bitno] \"'^ carry[bitno];\n    end\n    prepared_sltu = !carry[32];\n    prepared_slt = (in.alu_a[31] ''^ in.alu_b[31])\n                   ? in.alu_a[31] : prepared_sltu;\n    prepared_equal = &in.arith_p;\n    case (in.ctrl.alu_op)\n      ALU_ADD, ALU_SUB: alu_result = prepared_result;\n      ALU_SLT: alu_result = {31'\"'b0, prepared_slt};\n      ALU_SLTU: alu_result = {31'b0, prepared_sltu};\n      default: alu_result = other_result;\n    endcase\n  end\n\n'''+s[b:]\np.write_text(s)\nprint(root)\nPY\nRTL_DIR=/srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1/prefix/rtl OBJ_DIR=/srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1/prefix/obj NRET=1 bash test/cosim/build.sh > /srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1/prefix/build.log 2>&1\npython3 - <<'PY'\nfrom pathlib import Path\nimport subprocess,json,sys\nroot=Path('/srv/hwebench/tmp/6b356b5e/7e1fa6ce/fallthrough-r10s1')\nsim=root/'prefix/obj/cosim_sim'\nfor name in ['selftest','random1','random2','random3']:\n r=subprocess.run([sys.executable,'test/cosim/run_cosim.py',str(sim),str(root/(name+'.elf')),'--istall','--dstall'],capture_output=True,text=True,timeout=120)\n print(name,r.returncode,r.stdout.strip(),flush=True)\n if r.returncode:sys.exit(r.returncode)\nr=subprocess.run([str(sim),str(root/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,timeout=600)\n(root/'prefix/coremark.out').write_text(r.stdout)\nm=json.loads(r.stdout.splitlines()[-1])\nfrom tools.eval.fpga import validate_coremark_uart\nprint('CoreMark',r.returncode,validate_coremark_uart(m.get('uart',''),10),m['bench_stop_cycle']-m['bench_start_cycle'],flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
