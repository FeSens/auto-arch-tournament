    next_pc = predicted_taken ? direct_target : sequential_pc;\n    fetched = '0;\n    fetched.pc = pc;\n    fetched.instr = imem_data;\n    fetched.predicted_taken = predicted_taken;\n    fetched.direct_target = direct_target;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      head_q <= '0;\n      for (int i=0; i<4; i++) backing_q[i] <= '0;\n    end else begin\n      if (replace_head) begin\n        if (count_q \"'!= 0) head_q <= backing_q[read_q];\n        else if (fetch_opportunity) head_q <= fetched;\n      end\n      if (fetch_opportunity && !(replace_head && count_q == 0))\n        backing_q[write_q] <= fetched;\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= '\"'0;\n      head_valid_q <= 1'b0;\n      count_q <= '0;\n      read_q <= '0;\n      write_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      head_valid_q <= 1'b0;\n      count_q <= '0;\n      read_q <= '0;\n      write_q <= '0;\n    end else begin\n      if (push) pc <= next_pc;\n      if (replace_head) head_valid_q <= count_q \"'!= 0 || push;\n      if (promote) read_q <= read_q + 2'\"'d1;\n      if (push_back) write_q <= write_q + 2'd1;\n      case ({push_back, promote})\n        2'b10: count_q <= count_q + 3'd1;\n        2'b01: count_q <= count_q - 3'd1;\n        default: ;\n      endcase\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 128; i++) counters[i] <= 2'b01;\n    end else if (branch_update) begin\n      if (branch_taken && counters[branch_index] \"'!= 2'\"'b11)\n        counters[branch_index] <= counters[branch_index] + 2'd1;\n      else if (\"'!branch_taken && counters[branch_index] != 2'\"'b00)\n        counters[branch_index] <= counters[branch_index] - 2'd1;\n    end\n  end\n  assign imem_addr = pc;\n  always_comb begin\n    out = head_q;\n    out.valid = head_valid_q && \"'!flush;\n  end\nendmodule\n'\"'''\n(rtl/'if_stage.sv').write_text(head+body)