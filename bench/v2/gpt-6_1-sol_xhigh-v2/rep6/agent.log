back to its defaults.\nORCH_FLAGS  = --iterations $(N) --tournament-size $(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>\n…[17780 of 20852 chars elided by tools/bench/transcript.py; sha256:e22dcb48d6062c03]…\n(ops, constants):\n        for a, b in pairs:\n            expected = 0\n            if os.environ.get(\"BENCH_ALU_ALTOPS\") == \"1\":\n                expected = ((a + b) if op in ops[:3] else (a - b)) ^ constant\n            await _check(dut, op, a, b, expected)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_alu_altops_runner():\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"alu.sv\"],\n                 hdl_toplevel=\"alu\", build_dir=build_dir, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1},\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"])\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\",\n                test_dir=TEST_DIR, build_dir=build_dir,\n                extra_env={\"BENCH_ALU_ALTOPS\": \"1\"})\n", "exit_code": 0, "status": "completed"}}
