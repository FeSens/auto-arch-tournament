{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"sed -n '620,1100p' cores/bench/test/test_pipeline.py; cat cores/bench/test/conftest.py cores/bench/test/_helpers.py\"", "aggregated_output": "@cocotb.test()\nasync def predictor_direct_and_indirect_misalignment_traps(dut):\n    program = [BEQ(0, 0, 2), JAL(1, 2), ADDI(2, 0, 27), JALR(3, 2, 0),\n               BNE(0, 0, 2), _b(8, 0, 0, 2, 0x63), EBREAK()]\n    for seed in (False, 59):\n        rets, _ = await _run(dut, program, stalls=seed)\n        assert [r[\"pc\"] for r in rets] == list(range(0, 28, 4))\n        assert [r[\"pc_next\"] for r in rets] == list(range(4, 32, 4))\n        assert [r[\"trap\"] for r in rets] == [1, 1, 0, 1, 0, 1, 0]\n        assert rets[1][\"rd\"] == rets[3][\"rd\"] == 0\n        assert rets[1][\"rd_wdata\"] == rets[3][\"rd_wdata\"] == 0\n        assert rets[3][\"rs1_rdata\"] == 27\n        assert all(r[\"mem_wmask\"] == r[\"mem_rmask\"] == 0 for r in rets)\n\n\n@cocotb.test()\nasync def resolved_operand_priority_and_multiply_throughput(dut):\n    # Three simultaneous writers to x1 exercise EX > MEM > WB on both\n    # source ports. The remaining chain alternates ALU and real multiply.\n    program = [ADDI(1, 0, 3), ADDI(1, 0, 5), ADDI(1, 0, 7),\n               ADD(2, 1, 1), MUL(3, 2, 1), ADDI(3, 3, 1),\n               MUL(4, 3, 2), ADD(5, 4, 3), ADDI(0, 5, -1),\n               ADD(6, 0, 5), ADDI(7, 7, 11), NOP(), NOP(),\n               ADD(8, 7, 6), EBREAK()]\n    expected = {3: (7, 7, 14), 4: (14, 7, 98), 5: (98, 7, 99),\n                6: (99, 14, 1386), 7: (1386, 99, 1485),\n                9: (0, 1485, 1485), 13: (11, 1485, 1496)}\n    for seed in (False, 41, 82):\n        rets, _ = await _run(dut, program, stalls=seed)\n        assert [r[\"insn\"] for r in rets] == program\n        assert [r[\"pc\"] for r in rets] == list(range(0, len(program) * 4, 4))\n        assert [r[\"pc_next\"] for r in rets] == list(range(4, len(program) * 4 + 4, 4))\n        for index, values in expected.items():\n            r = rets[index]\n            assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"]) == values\n        assert rets[8][\"rd\"] == rets[8][\"rd_wdata\"] == 0\n        assert rets[10][\"rs1_rdata\"] == 0 and rets[10][\"rd_wdata\"] == 11\n        assert all(r[\"trap\"] == 0 for r in rets)\n        \n…[7944 of 11016 chars elided by tools/bench/transcript.py; sha256:71f5a7a709a61bc9]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
