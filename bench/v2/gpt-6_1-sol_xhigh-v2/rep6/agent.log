{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\ns=Path('cores/bench/generated/mapping_keep/impl/pnr/core_bench.vo').read_text()\nparams=dict(re.findall(r'\"'^defparam'\"\\\\s+(\\\\S+)\\\\s*\\\\.INIT\\\\s*=\\\\s*([\"'^;]+);'\"',s,re.M))\nnormalize=lambda n:re.sub(r'\\\\s+','',n).lstrip('\\\\\\\\')\ndrivers={}\nfor typ,name,body in re.findall(r'\"'^(LUT'\"\\\\d)\\\\s+(\\\\S+)\\\\s*\\\\((.*?)\\\\);',s,re.M|re.S):\n    ports={p:normalize(n) for p,n in re.findall(r'\\\\.(\\\\w+)\\\\(([\"'^()]*)'\"\\\\)',body)}\n    init=int(params[name].split(\\\"'h\\\")[1],16)\n    drivers[ports['F']]=(typ,name,ports,init)\ndef evaluate(n,op):\n    if n=='GND':return 0\n    if n=='VCC':return 1\n    m=re.fullmatch(r'cpu/id_ex_w.ctrl.alu_op\\\\[(\\\\d)\\\\]',n)\n    if m:return (op>>int(m[1]))&1\n    typ,name,ports,init=drivers[n]\n    index=sum(evaluate(ports[f'I{i}'],op)<<i for i in range(int(typ[3:])))\n    return (init>>index)&1\nfor op in range(32):\n    assert evaluate('cpu/u_ex/u_alu/xor_en',op)==int(op in (3,4))\n    assert evaluate('cpu/u_ex/u_alu/and_en',op)==int(op in (2,3))\nresults=[d for n,d in drivers.items() if re.search(r'logic_result(?:_0)?\\\\[',n)]\nassert len(results)==32\nbits=[]\nfor typ,name,ports,init in results:\n    assert typ=='LUT4'\n    a_bits=[int(re.search(r'\\\\[(\\\\d+)\\\\]',n)[1]) for n in ports.values() if 'id_ex_w.alu_a[' in n]\n    b_bits=[int(re.search(r'\\\\[(\\\\d+)\\\\]',n)[1]) for n in ports.values() if 'id_ex_w.alu_b[' in n]\n    assert len(a_bits)==len(b_bits)==1 and a_bits==b_bits\n    bits.append(a_bits[0])\n    for and_en in range(2):\n        for xor_en in range(2):\n            for a in range(2):\n                for b in range(2):\n                    values={'cpu/u_ex/u_alu/and_en':and_en,'cpu/u_ex/u_alu/xor_en':xor_en,\n                            f'cpu/id_ex_w.alu_a[{a_bits[0]}]':a,f'cpu/id_ex_w.alu_b[{b_bits[0]}]':b}\n                    index=sum(values[ports[f'I{i}']]<<i for i in range(4))\n                    assert ((init>>index)&1)==(((a\"'^b)&xor_en)|((a&b)&and_en))\nassert sorted(bits)==list(range(32))\nprint('\"'PASS: both retained scalar enables are exact for all 32 opcodes.')\nprint('PASS: all 32 result bits each use one LUT4; every 16-entry truth table is exact.')\nprint('LUT4 INIT values:', sorted({hex(d[3]) for d in results}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
