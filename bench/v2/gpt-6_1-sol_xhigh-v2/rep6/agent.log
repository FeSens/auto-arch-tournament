{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_id_stage.py'","aggregated_output":"\"\"\"ID/EX hold/squash priorities with a live prediction and nonzero payload.\"\"\"\nimport itertools\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# Packed id_ex_t has valid at bit 0, target at 32:1, direction at 33,\n# instruction at 65:34 and the entire 22-bit ctrl_t at 87:66.\n_CTRL_MASK = ((1 << 22) - 1) << 66\n_PRED_MASK = 1 << 33\n_CONTROL_MASK = _CTRL_MASK | _PRED_MASK | 1\n_PAYLOAD_MASK = ((1 << 295) - 1) ^ _CONTROL_MASK\n\n\ndef _fetch(pc, instr, predicted_taken, target, valid):\n    return (((((pc << 32) | instr) << 1 | predicted_taken) << 32 | target) << 1) | valid\n\n\nasync def _edge(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    result = int(dut.out.value)\n    dut.clock.value = 0\n    return result\n\n\n@cocotb.test()\nasync def squash_hold_advance_priority(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)  # MUL x3,x1,x2\n    dut.rs1_data.value = 0x12345678\n    dut.rs2_data.value = 0x87654321\n    dut.fwd_rs1_sel.value = 1\n    dut.fwd_rs2_sel.value = 2\n    dut.fwd_ex_data.value = 0xA5A55A5A\n    dut.fwd_mem_data.value = 0x55AA33CC\n    assert len(dut.out) == 295\n    assert await _edge(dut) == 0, \"reset clears payload even during a hold/squash\"\n    dut.reset.value = 0\n\n    for stall, flush, valid in itertools.product((0, 1), repeat=3):\n        # Seed each case with nonzero payload, arithmetic controls and a\n        # prediction. This makes a missed direction clear visible on holds.\n        dut.stall.value = 0\n        dut.flush.value = 0\n        dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)\n        before = await _edge(dut)\n        assert before & _CTRL_MASK and before & _PRED_MASK and before & 1\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut[\"in\"].value = _fetch(0xA0, 0xABCD1297, 1, 0xCC, valid)  # AUIPC x5\n        dut.fwd_ex_data.value = 0xDEADBEEF\n        dut.fwd_mem_data.value = 0xCAFEBABE\n        after = await _edge(dut)\n        if stall:\n            assert after & _PAYLOAD_MASK == before & _PAYLOAD_MASK\n        else:\n            assert after >> 263 == 0xA0  # PC advances on every unstalled edge\n            assert (after >> 34) & 0xFFFFFFFF == 0xABCD1297\n            assert (after >> 1) & 0xFFFFFFFF == 0xCC\n            assert after & _PAYLOAD_MASK != before & _PAYLOAD_MASK\n        if flush or (not stall and not valid):\n            assert after & _CONTROL_MASK == 0\n        elif stall:\n            assert after & _CONTROL_MASK == before & _CONTROL_MASK\n        else:\n            assert after & 1 and after & _PRED_MASK\n            assert (after >> 66) & ((1 << 22) - 1) == int(dut.ctrl_decoded.value)\n\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 0\n    assert await _edge(dut) == 0\n\n\ndef test_id_stage_runner():\n    run_cocotb(\"id_stage\", [\"core_pkg.sv\", \"decoder.sv\", \"imm_gen.sv\", \"id_stage.sv\"],\n               \"test_id_stage\")\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: operand capture (advancing EX/completing MEM/write-first WB), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0\n…[52391 of 55463 chars elided by tools/bench/transcript.py; sha256:186b4094e5ffb16f]…\n         break\n        else:\n            raise AssertionError(\"reset scenario never reached the multiply boundary\")\n        fresh = [ADDI(1, 0, 3), MUL(2, 1, 1), SW(2, 0, 0x104), EBREAK()]\n        events = []\n        rets, mem = await _run(dut, fresh, memory_events=events)\n        assert [r[\"insn\"] for r in rets] == fresh\n        assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12]\n        assert rets[1][\"rs1_rdata\"] == rets[1][\"rs2_rdata\"] == 3\n        assert rets[1][\"rd_wdata\"] == 9\n        assert mem == {0x104: 9}\n        assert len(events) == 1 and events[0][1:4] == (0x104, 15, 0)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
