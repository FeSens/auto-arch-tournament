{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"riscv32-unknown-elf-objdump -d bench/programs/coremark.elf > cores/bench/experiments/coremark.dis\npython3 - <<'PY'\nimport struct,sys\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nc=RV32IM();c.load_elf('bench/programs/coremark.elf')\ntrace=[]\nfor pc,npc,t in struct.iter_unpack('<IIB',Path('cores/bench/experiments/branch_profile.bin').read_bytes()):\n insn=struct.unpack_from('<I',c.mem,pc)[0]\n trace.append((pc,t,insn>>31))\nprint('branches',len(trace),'static_misses',sum(t\"'!=back for pc,t,back in trace))\nfor n in (16,32,64,128,256,512):\n for kind in ('\"'bimodal','last','agree_last','agree2'):\n  for ix in ('low','fold'):\n   mask=n-1; table=[1 if kind in ('bimodal','agree2') else 0]*n; miss=0\n   for pc,t,back in trace:\n    idx=((pc>>2)\"'^((pc>>6) if ix=='\"'fold' else 0))&mask\n    pred=int(table[idx]>=2) if kind in ('bimodal','agree2') else table[idx]\n    if kind.startswith('agree'): pred=back\"'^pred\n    miss+=pred!=t\n    if kind in ('\"'bimodal','agree2'):\n     update=t\"'^back if kind=='\"'agree2' else t\n     table[idx]=min(3,table[idx]+1) if update else max(0,table[idx]-1)\n    else: table[idx]=t\"'^back if kind=='\"'agree_last' else t\n   print(n,kind,ix,miss)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"riscv32-unknown-elf-objdump -d bench/programs/coremark.elf > cores/bench/experiments/coremark.dis\npython3 - <<'PY'\nimport struct,sys\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nc=RV32IM();c.load_elf('bench/programs/coremark.elf')\ntrace=[]\nfor pc,npc,t in struct.iter_unpack('<IIB',Path('cores/bench/experiments/branch_profile.bin').read_bytes()):\n insn=struct.unpack_from('<I',c.mem,pc)[0]\n trace.append((pc,t,insn>>31))\nprint('branches',len(trace),'static_misses',sum(t\"'!=back for pc,t,back in trace))\nfor n in (16,32,64,128,256,512):\n for kind in ('\"'bimodal','last','agree_last','agree2'):\n  for ix in ('low','fold'):\n   mask=n-1; table=[1 if kind in ('bimodal','agree2') else 0]*n; miss=0\n   for pc,t,back in trace:\n    idx=((pc>>2)\"'^((pc>>6) if ix=='\"'fold' else 0))&mask\n    pred=int(table[idx]>=2) if kind in ('bimodal','agree2') else table[idx]\n    if kind.startswith('agree'): pred=back\"'^pred\n    miss+=pred!=t\n    if kind in ('\"'bimodal','agree2'):\n     update=t\"'^back if kind=='\"'agree2' else t\n     table[idx]=min(3,table[idx]+1) if update else max(0,table[idx]-1)\n    else: table[idx]=t\"'^back if kind=='\"'agree_last' else t\n   print(n,kind,ix,miss)\nPY\"","aggregated_output":"branches 532346 static_misses 111790\n16 bimodal low 70957\n16 bimodal fold 73112\n16 last low 98650\n16 last fold 107341\n16 agree_last low 84758\n16 agree_last fold 88760\n16 agree2 low 55571\n16 agree2 fold 63316\n32 bimodal low 55998\n32 bimodal fold 63610\n32 last low 90289\n32 last fold 94210\n32 agree_last low 81992\n32 agree_last fold 87094\n32 agree2 low 52449\n32 agree2 fold 58809\n64 bimodal low 52238\n64 bimodal fold 53081\n64 last low 85894\n64 last fold 76323\n64 agree_last low 75984\n64 agree_last fold 75280\n64 agree2 low 46707\n64 agree2 fold 51200\n128 bimodal low 54846\n128 bimodal fold 41152\n128 las