if (payload_push) slots[payload_index[1:0]] <= fetch_payload;\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset || redirect) count_q <= '0;\n    else case ({push,pop})\n      2'b10: count_q <= count_q + 3'd1;\n      2'b01: count_q <= count_q - 3'd1;\n      default: ;\n    endcase\n  end\n''' + s[b:]\ns=s.replace('slots[head_q]','slots[0]');f.write_text(s)\nf=rtl/'hazard_unit.sv';s=f.read_text().replace('output logic       stall_if,','output logic       issue_hold,\\\\n  output logic       stall_if,').replace('stall_if      = dmem_stall','issue_hold = dmem_stall || ex_busy || load_use_hazard;\\\\n    stall_if      = dmem_stall');f.write_text(s)\nf=rtl/'core.sv';s=f.read_text().replace('logic fetch_available;','logic fetch_available;\\\\n  logic issue_hold, fetch_buffered;\\\\n  logic [31:0] fetch_buffered_instr;\\\\n  logic [31:0] rf_raw_1, rf_raw_2, rf_buffer_1, rf_buffer_2;')\ns=s.replace('.stall           (stall_id),','.stall           (issue_hold),').replace('.available       (fetch_available),','.available       (fetch_available),\\\\n    .buffered        (fetch_buffered),\\\\n    .buffered_instr  (fetch_buffered_instr),')\ns=s.replace('.rs1_addr (rs1_addr_w),\\\\n    .rs2_addr (rs2_addr_w),\\\\n    .rs1_data (rs1_data_w),\\\\n    .rs2_data (rs2_data_w),\\\\n    .w_en', '.rs1_addr (io_imemData[19:15]),\\\\n    .rs2_addr (io_imemData[24:20]),\\\\n    .rs1_data (rf_raw_1),\\\\n    .rs2_data (rf_raw_2),\\\\n    .w_en')\npos=s.index('\\\\n  // ── EX ')\ns=s[:pos]+'''\n  reg_file u_rf_buffer (\n    .clock(clock), .reset(reset),\n    .rs1_addr(fetch_buffered_instr[19:15]),\n    .rs2_addr(fetch_buffered_instr[24:20]),\n    .rs1_data(rf_buffer_1), .rs2_data(rf_buffer_2),\n    .w_en(wb_w_en), .w_addr(wb_w_addr), .w_data(wb_w_data)\n  );\n  assign rs1_data_w = fetch_buffered ? rf_buffer_1 : rf_raw_1;\n  assign rs2_data_w = fetch_buffered ? rf_buffer_2 : rf_raw_2;\n''' + s[pos:]\ns=s.replace('.stall_if       (stall_if),','.issue_hold     (issue_hold),\\\\n