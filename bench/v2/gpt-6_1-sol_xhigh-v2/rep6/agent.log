{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nrng=random.Random(0x12_52)\nchampion=[1]*128\nforwarded=[1]*128\nlast=None\nex=None\ncounts={'cycles':0,'updates':0,'same_index_forwardings':0,'held_ex_cycles':0,'reset_cycles':0,'saturated_updates':0}\nfor cycle in range(600000):\n counts['cycles']+=1\n reset=cycle==0 or rng.randrange(20000)==0\n held=ex is not None and rng.random()<0.32\n # Read the pre-write fetch value. Favor aliases and recurring branches.\n index=ex[0] if ex and rng.random()<0.6 else rng.randrange(128)\n snap=champion[index]\n assert snap==forwarded[index]\n fetch_is_branch=rng.random()<0.72\n fetch_legal=rng.random()<0.98\n target_aligned=rng.random()<0.97\n outcome=rng.random()<0.62\n fetch_valid=rng.random()<0.78\n load_use=rng.random()<0.09\n correction=ex is not None and ex[1] and not held and rng.random()<0.08\n if reset:\n  champion=[1]*128;forwarded=[1]*128;last=None;ex=None\n  counts['reset_cycles']+=1\n  continue\n if ex is not None and not held and ex[1]:\n  ex_index,eligible,ex_snapshot,ex_outcome=ex\n  base=last[1] if last is not None and last[0]==ex_index else ex_snapshot\n  assert base==champion[ex_index],(cycle,ex,last,base,champion[ex_index])\n  if last is not None and last[0]==ex_index: counts['same_index_forwardings']+=1\n  old=champion[ex_index]\n  champion[ex_index]=min(3,old+1) if ex_outcome else max(0,old-1)\n  forwarded[ex_index]=min(3,base+1) if ex_outcome else max(0,base-1)\n  last=(ex_index,forwarded[ex_index])\n  counts['updates']+=1\n  counts['saturated_updates']+=old==champion[ex_index]\n assert champion==forwarded\n if held:\n  counts['held_ex_cycles']+=1\n elif correction or load_use or not fetch_valid:\n  ex=None\n else:\n  ex=(index,fetch_is_branch and fetch_legal and target_aligned,snap,outcome)\nprint('Independent one-owner predictor model: exact live-counter equivalence')\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
