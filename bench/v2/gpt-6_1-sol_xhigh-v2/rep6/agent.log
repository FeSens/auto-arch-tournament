{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK = (1 << 32) - 1\n\ndef proposed(a, b):\n    remainder = 0\n    quotient = 0\n    for k in range(1, 33):\n        trial = (remainder << 1) | ((a >> (32 - k)) & 1)\n        width_mask = (1 << k) - 1\n        difference = (trial - (b & width_mask)) & ((1 << (k + 1)) - 1)\n        take = (b >> k) == 0 and (difference >> k) == 0\n        remainder = (difference & width_mask) if take else trial\n        quotient |= int(take) << (32 - k)\n    return quotient, remainder\n\ndef signed_result(a, b):\n    sa = a - (1 << 32) if a >> 31 else a\n    sb = b - (1 << 32) if b >> 31 else b\n    q, r = proposed(abs(sa), abs(sb))\n    if b == 0:\n        return MASK, a\n    if (sa < 0) \"'!= (sb < 0):\n        q = -q\n    if sa < 0:\n        r = -r\n    return q & MASK, r & MASK\n\ncorners = {0, 1, 2, 3, 0x7fffffff, 0x80000000, 0x80000001, MASK}\nfor bit in range(32):\n    corners.update({(1 << bit) - 1, 1 << bit, ((1 << bit) + 1) & MASK})\ncases = [(a, b) for a in corners for b in corners]\nrng = random.Random(20261002)\ncases += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\nfor a, b in cases:\n    expected = (MASK, a) if b == 0 else divmod(a, b)\n    assert proposed(a, b) == expected, (a, b, proposed(a, b), expected)\n    sa = a - (1 << 32) if a >> 31 else a\n    sb = b - (1 << 32) if b >> 31 else b\n    if sb == 0:\n        expected_signed = MASK, a\n    else:\n        q = abs(sa) // abs(sb)\n        if (sa < 0) != (sb < 0):\n            q = -q\n        r = sa - q * sb\n        expected_signed = q & MASK, r & MASK\n    assert signed_result(a, b) == expected_signed\nprint(f'\"'Proposed divider recurrence and signed correction passed {len(cases)} unsigned and {len(cases)} signed model checks.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
