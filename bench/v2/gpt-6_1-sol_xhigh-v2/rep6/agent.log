{"type": "item.started", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nprobe=Path('/srv/hwebench/tmp/6b356b5e/d8a4eaa8/branch_probe');rtl=probe/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(p,rtl/p.name)\ndef edit(file,old,new):\n p=rtl/file;s=p.read_text();assert old in s,(file,old);p.write_text(s.replace(old,new))\nedit('core_pkg.sv','    logic        branch_taken;','    logic        predicted_taken;\\\\n    logic        branch_taken;')\nedit('ex_stage.sv','  input  logic               reset,','  input  logic               reset,\\\\n  input  logic               flush,')\np=rtl/'ex_stage.sv';s=p.read_text();a=s.index('  assign redirect =');b=s.index('  // ── EX/MEM',a);s=s[:a]+s[b:]\ns=s.replace('  output logic               redirect,\\\\n  output logic [31:0]        redirect_target,\\\\n  output logic               branch_update,\\\\n  output logic [6:0]         branch_index,\\\\n  output logic               branch_outcome','  output logic               unused_probe')\ns=s.replace('in.valid && \"'!reset && !stall && !busy;'\"', 'in.valid && \"'!reset && !stall && !busy && !flush;'\"')\ns=s.replace('assign busy = in.valid && \"'!reset'\"','assign busy = in.valid && \"'!reset && !flush'\"')\ns=s.replace('&& \"'!reset && !stall && div_req_ready'\"','&& \"'!reset && !stall && !flush && div_req_ready'\"')\ns=s.replace('&& \"'!reset && !stall && mul_req_ready'\"','&& \"'!reset && !stall && !flush && mul_req_ready'\"')\ns=s.replace('&& \"'!reset && !stall'\"\\\\n                        && div_result_valid','&& \"'!reset && !stall && !flush'\"\\\\n                        && div_result_valid')\ns=s.replace('&& \"'!reset && !stall'\"\\\\n                        && mul_result_valid','&& \"'!reset && !stall && !flush'\"\\\\n                        && mul_result_valid')\ns=s.replace('    execute_payload.branch_taken = branch_t