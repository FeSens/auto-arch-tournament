{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"mkdir -p /srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe\npython3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe')\nfor count in (16,32):\n target=root/f'agree{count}'/'rtl'; target.mkdir(parents=True,exist_ok=True)\n for source in Path('cores/bench/rtl').glob('*.sv'): shutil.copyfile(source,target/source.name)\n k=count.bit_length()-1\n p=target/'if_stage.sv'; s=p.read_text()\n s=s.replace('input  logic [6:0]        branch_index,',f'input  logic [{k-1}:0]        branch_index,')\n s=s.replace('logic [1:0] counters [0:127];',f'logic [1:0] counters [0:{count-1}];')\n s=s.replace('direct_branch && counters[pc[8:2]][1]',f'direct_branch && (imem_data[31] \"'^ counters[pc[{k+1}:2]][1])'\"')\n s=s.replace('i < 128','i < '+str(count))\n p.write_text(s)\n p=target/'ex_stage.sv'; s=p.read_text()\n s=s.replace('output logic [6:0]         branch_index,',f'output logic [{k-1}:0]         branch_index,')\n s=s.replace('assign branch_index = in.pc[8:2];',f'assign branch_index = in.pc[{k+1}:2];')\n s=s.replace('assign branch_outcome = branch_taken;','// Residual direction: train disagreement with the static backward-taken bias.\\\\n  assign branch_outcome = branch_taken \"'^ in.instr[31];'\"')\n p.write_text(s)\n p=target/'core.sv'; s=p.read_text().replace('logic [6:0]  branch_index;',f'logic [{k-1}:0]  branch_index;');p.write_text(s)\nprint('Created isolated agree16 and agree32 prototypes')\nPY\nRTL_DIR=/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe/agree16/rtl OBJ_DIR=/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe/agree16/obj NRET=1 bash test/cosim/build.sh > /srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe/agree16/cosim-build.log 2>&1\n/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe/agree16/obj/cosim_sim bench/programs/coremark.elf 10000000 --bench --istall --dstall > /srv/hwebench/tmp/6b356b5e/c