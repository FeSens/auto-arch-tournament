d.value = 1\n    dut.req_op.value = op\n    dut.req_a.value = a & MASK\n    dut.req_b.value = b & MASK\n    dut.result_ready.value = int(ready_at_launch)\n    await Timer(1, \"ns\")\n    assert int(dut.result_valid.value) == 0, \"no combinational result bypass\"\n    await _tick(dut)\n    # Exactly one edge produces the response, even with ready asserted.\n    assert int(dut.req_ready.value) == 0\n    assert int(dut.re\n…[15805 of 18877 chars elided by tools/bench/transcript.py; sha256:8079b5609d98fca0]…\nsult_valid.value) == 1\n    assert int(dut.bypass_w_en.value) == 0  # x0 still executes and retires\n    await _tick(dut)\n    assert _unpack(EX_MEM, int(dut.out.value))[\"alu_result\"] == _want(ALU_MUL, 3, 4)\n\n\ndef _runner(altops):\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / (\"ex_stage_altops\" if altops else \"ex_stage\")\n    runner.build(sources=[RTL / filename for filename in\n                         (\"core_pkg.sv\", \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"ex_stage.sv\")],\n                 hdl_toplevel=\"ex_stage\", build_dir=build_dir, always=True,\n                 defines={\"RISCV_FORMAL_ALTOPS\": 1} if altops else {},\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"])\n    runner.test(hdl_toplevel=\"ex_stage\", test_module=\"test_ex_stage\",\n                test_dir=TEST_DIR, build_dir=build_dir,\n                extra_env={\"BENCH_EX_ALTOPS\": \"1\" if altops else \"0\"})\n\n\ndef test_ex_stage_runner():\n    _runner(False)\n\n\ndef test_ex_stage_altops_runner():\n    _runner(True)\n", "exit_code": 0, "status": "completed"}}
