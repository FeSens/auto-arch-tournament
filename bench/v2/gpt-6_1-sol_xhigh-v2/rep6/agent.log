{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/core.yaml; cat cores/bench/rtl/alu.sv; rg --files cores/bench/test tools/eval fpga | head -100'","aggregated_output":"name: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 93.817\n  lut4: 3675\n  ff: 1090\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261002-003-r5s2\n  updated: '2026-10-02T19:22:34.323434Z'\n// rtl/alu.sv\n//\n// RV32I combinational ALU. Multiply, division and remainder execute in\n// registered units; their real ALU outputs are inactive.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations\n      // are substituted for tractable algebraic stand-ins so bitwuzla\n      // can solve the BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined and\n      // run the real arithmetic.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\n`else\n      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU: out = 32'b0;\n      ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: out = 32'b0;\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\nfpga/core_bench_si.sv\nfpga/core_bench.sv\nfpga/bench_stall_gen.sv\nfpga/constraints/Tang_Nano_20K.cst\nfpga/constraints/clock.sdc\ncores/bench/test/test_alu.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_id_stage.py\ncores/bench/test/test_mul_unit.py\ncores/bench/test/test_ex_stage.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/conftest.py\ncores/bench/test/test_div_unit.py\ncores/bench/test/test_imm_gen.py\nfpga/scripts/synth.tcl\nfpga/scripts/nextpnr_run.sh\ntools/eval/test_formal_reclassify.py\ntools/eval/rvfi_lint.py\ntools/eval/test_remove_path.py\ntools/eval/test_subprocess_pgroup.py\ntools/eval/__init__.py\ntools/eval/test_slots.py\ntools/eval/test_bench_stall_gen.py\ntools/eval/test_fpga_report.py\ntools/eval/test_formal_nret.py\ntools/eval/cosim.py\ntools/eval/_slots.py\ntools/eval/test_holdout.py\ntools/eval/fpga.py\ntools/eval/test_formal_workdir_cleanup.py\ntools/eval/test_rvfi_lint.py\ntools/eval/test_process_reaper.py\ntools/eval/gowin.py\ntools/eval/formal.py\ntools/eval/holdout.py\ntools/eval/test_gate_sanity.py\ntools/eval/_subprocess.py\n","exit_code":0,"status":"completed"}}
