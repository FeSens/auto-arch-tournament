─────\n  logic        branch_cond;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] jump_target;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond =\n…[11726 of 14798 chars elided by tools/bench/transcript.py; sha256:ac22105c0f3f03a0]…\nld        (preserve in-flight pipeline state)\n    //   - ex_busy     -> hold        (multiply/divide owns the instruction)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    stall_id      = dmem_stall || ex_busy || (load_use_hazard && !redirect);\n    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !ex_busy;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: preserve existing data retention under dmem stalls,\n    // clearing valid so we don't double-retire / double-write the regfile.\n    // ID/EX holds its already resolved operands throughout the same stall.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
