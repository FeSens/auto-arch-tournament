{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p /srv/hwebench/tmp/6b356b5e/eebe8132/r5_forward; python - <<'PY'\nfrom pathlib import Path\nimport shutil,re\nbase=Path('/srv/hwebench/tmp/6b356b5e/eebe8132/r5_forward')\na=base/'a'/'rtl'\nshutil.copytree(Path('cores/bench/rtl'),a,dirs_exist_ok=True)\np=a/'forward_unit.sv';s=p.read_text().replace('output logic [1:0] fwd_rs1','output logic [2:0] fwd_rs1').replace('output logic [1:0] fwd_rs2','output logic [2:0] fwd_rs2');s=s[:s.index('  // Yosys')]+'''  logic ex_hit1, ex_hit2, mem_hit1, mem_hit2;\n  assign ex_hit1 = ex_w_en && ex_rd == if_id_rs1 && if_id_rs1 \"'!= 0;\n  assign ex_hit2 = ex_w_en && ex_rd == if_id_rs2 && if_id_rs2 != 0;\n  assign mem_hit1 = mem_w_en && mem_rd == if_id_rs1 && if_id_rs1 != 0;\n  assign mem_hit2 = mem_w_en && mem_rd == if_id_rs2 && if_id_rs2 != 0;\n  assign fwd_rs1 = {mem_hit1 && !ex_hit1, ex_hit1, !mem_hit1 && !ex_hit1};\n  assign fwd_rs2 = {mem_hit2 && !ex_hit2, ex_hit2, !mem_hit2 && !ex_hit2};\nendmodule\n'\"''';p.write_text(s)\np=a/'core.sv';s=p.read_text().replace('logic [1:0] fwd_rs1_sel, fwd_rs2_sel;','logic [2:0] fwd_rs1_sel, fwd_rs2_sel;');p.write_text(s)\np=a/'id_stage.sv';s=p.read_text().replace('logic [1:0]        fwd_rs1_sel','logic [2:0]        fwd_rs1_sel').replace('logic [1:0]        fwd_rs2_sel','logic [2:0]        fwd_rs2_sel');start=s.index('  logic [31:0] rs1_value, rs2_value;');end=s.index('\\\\n  ctrl_t ctrl_decoded;',start);s=s[:start]+'''  logic [31:0] rs1_value, rs2_value, alu_a_value, alu_b_value;\n  always_comb begin\n    rs1_value = ({32{fwd_rs1_sel[0]}} & rs1_data)\n              | ({32{fwd_rs1_sel[1]}} & fwd_ex_data)\n              | ({32{fwd_rs1_sel[2]}} & fwd_mem_data);\n    rs2_value = ({32{fwd_rs2_sel[0]}} & rs2_data)\n              | ({32{fwd_rs2_sel[1]}} & fwd_ex_data)\n              | ({32{fwd_rs2_sel[2]}} & fwd_mem_data);\n    if (rs1_addr == 0) rs1_value = 0;\n    if (rs2_addr == 0) rs2_