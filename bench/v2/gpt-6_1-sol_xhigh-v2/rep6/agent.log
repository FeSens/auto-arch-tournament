{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"sed -n '846,905p' cores/bench/test/test_pipeline.py; sed -n '945,1075p' cores/bench/test/test_pipeline.py; sed -n '195,235p' tools/eval/gowin.py; sed -n '125,190p' tools/eval/cosim.py; sed -n '330,410p' tools/eval/fpga.py; cat test/cosim/build.sh\"", "aggregated_output": "async def resolved_operand_priority_and_multiply_throughput(dut):\n    # Three simultaneous writers to x1 exercise EX > MEM > WB on both\n    # source ports. The remaining chain alternates ALU and real multiply.\n    program = [ADDI(1, 0, 3), ADDI(1, 0, 5), ADDI(1, 0, 7),\n               ADD(2, 1, 1), MUL(3, 2, 1), ADDI(3, 3, 1),\n               MUL(4, 3, 2), ADD(5, 4, 3), ADDI(0, 5, -1),\n               ADD(6, 0, 5), ADDI(7, 7, 11), NOP(), NOP(),\n               ADD(8, 7, 6), EBREAK()]\n    expected = {3: (7, 7, 14), 4: (14, 7, 98), 5: (98, 7, 99),\n                6: (99, 14, 1386), 7: (1386, 99, 1485),\n                9: (0, 1485, 1485), 13: (11, 1485, 1496)}\n    for seed in (False, 41, 82):\n        rets, _ = await _run(dut, program, stalls=seed)\n        assert [r[\"insn\"] for r in rets] == program\n        assert [r[\"pc\"] for r in rets] == list(range(0, len(program) * 4, 4))\n        assert [r[\"pc_next\"] for r in rets] == list(range(4, len(program) * 4 + 4, 4))\n        for index, values in expected.items():\n            r = rets[index]\n            assert (r[\"rs1_rdata\"], r[\"rs2_rdata\"], r[\"rd_wdata\"]) == values\n        assert rets[8][\"rd\"] == rets[8][\"rd_wdata\"] == 0\n        assert rets[10][\"rs1_rdata\"] == 0 and rets[10][\"rd_wdata\"] == 11\n        assert all(r[\"trap\"] == 0 for r in rets)\n        if not seed:\n            for index, (a, b) in enumerate(zip(rets, rets[1:]), 1):\n                penalty = int(index in (4, 6))\n                assert b[\"cycle\"] == a[\"cycle\"] + 1 + penalty\n            assert rets[-1][\"cycle\"] - rets[0][\"cycle\"] == len(program) - 1 + 2\n\n\n@cocotb.test()\nasync def resolved_alu_inputs_preserve_architectural_metadata(dut):\n    # These U-immediates encode raw rs1=x1, rs2=x2. AUIPC/LUI must\n    # select PC/immediate for arithmetic while retaining architectural\n    # read values for RVFI. A predicted JAL forwards its link at once.\n    auipc = 0x00208000 | (3 << 7) | 0x17\n    lui = 0x00208000 | (4 << 7) | 0x37\n    program = {0: ADDI(1, 0, 17), 4: ADDI(2, 0, 23), 8: auipc,\n               12: lui, 16: JAL(5,\n…[16610 of 19682 chars elided by tools/bench/transcript.py; sha256:1f7c08d5d0973827]…\nRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n", "exit_code": 0, "status": "completed"}}
