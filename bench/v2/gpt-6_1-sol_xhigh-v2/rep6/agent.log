ss'}\n249:    uart = marker.get('uart', '')\n251:    valid, reason = validate_coremark_uart(uart, iterations)\n253:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n256:    # Bracketed cycles (start_time..stop_time) are the contract per\n257:    #\n…[1701 of 4773 chars elided by tools/bench/transcript.py; sha256:119b7a71fc8c854c]…\n92:        ('crcmatrix', _uart_int(uart, r'\\[0\\]crcmatrix\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n293:        ('crcstate',  _uart_int(uart, r'\\[0\\]crcstate\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n294:        ('crcfinal',  _uart_int(uart, r'\\[0\\]crcfinal\\s*:\\s*0x([0-9a-fA-F]+)', 16)),\n301:    reported_iterations = _uart_int(uart, r'Iterations\\s*:\\s*(\\d+)')\n306:def _bench_sv(worktree: str, target: str | None) -> str:\n309:        return \"fpga/core_bench.sv\"\n311:    return \"fpga/core_bench_si.sv\" if nret == 1 else \"fpga/core_bench.sv\"\n323:    res = gowin.build_all(worktree, rtl, _bench_sv(worktree, target), gen)\n333:    Verilator CoreMark run (with random memory stalls) for cycles.\n337:      {'bench_failed': True, ...}        — bench didn't reach ebreak, or\n343:        'cycles': int, 'iterations': int,\n361:    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\n368:        return {'bench_failed': True, 'placement_failed': False,\n375:            'bench_failed': True,\n387:        'cycles':        cm['cycles'],\n", "exit_code": 0, "status": "completed"}}
