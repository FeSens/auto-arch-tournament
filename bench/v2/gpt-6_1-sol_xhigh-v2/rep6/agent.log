{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_id_stage.py; sed -n '1,130p' cores/bench/test/test_pipeline.py; cat tools/eval/_slots.py; sed -n '1,160p' tools/eval/cosim.py\"", "aggregated_output": "\"\"\"ID/EX hold/squash priorities with a live prediction and nonzero payload.\"\"\"\nimport itertools\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\n# Packed id_ex_t has valid at bit 0, target at 32:1, direction at 33,\n# instruction at 65:34 and the entire 22-bit ctrl_t at 87:66.\n_CTRL_MASK = ((1 << 22) - 1) << 66\n_PRED_MASK = 1 << 33\n_CONTROL_MASK = _CTRL_MASK | _PRED_MASK | 1\n_PAYLOAD_MASK = ((1 << 295) - 1) ^ _CONTROL_MASK\n\n\ndef _fetch(pc, instr, predicted_taken, target, valid):\n    return (((((pc << 32) | instr) << 1 | predicted_taken) << 32 | target) << 1) | valid\n\n\nasync def _edge(dut):\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    result = int(dut.out.value)\n    dut.clock.value = 0\n    return result\n\n\n@cocotb.test()\nasync def squash_hold_advance_priority(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.flush.value = 1\n    dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)  # MUL x3,x1,x2\n    dut.rs1_data.value = 0x12345678\n    dut.rs2_data.value = 0x87654321\n    dut.fwd_rs1_sel.value = 1\n    dut.fwd_rs2_sel.value = 2\n    dut.fwd_ex_data.value = 0xA5A55A5A\n    dut.fwd_mem_data.value = 0x55AA33CC\n    assert len(dut.out) == 295\n    assert await _edge(dut) == 0, \"reset clears payload even during a hold/squash\"\n    dut.reset.value = 0\n\n    for stall, flush, valid in itertools.product((0, 1), repeat=3):\n        # Seed each case with nonzero payload, arithmetic controls and a\n        # prediction. This makes a missed direction clear visible on holds.\n        dut.stall.value = 0\n        dut.flush.value = 0\n        dut[\"in\"].value = _fetch(0x40, 0x022081B3, 1, 0x80, 1)\n        before = await _edge(dut)\n        assert before & _CTRL_MASK and before & _PRED_MASK and before & 1\n        dut.stall.value = stall\n        dut.flush.value = flush\n        dut[\"in\"].value = _fetch(0xA0, 0xABCD1297, 1, 0xCC, valid)  # AUIPC x5\n        dut.fwd_ex_data.value = 0xDEADBEEF\n        dut.fwd_mem_data.value = 0xCAFEBABE\n        afte\n…[14769 of 17841 chars elided by tools/bench/transcript.py; sha256:4a1e267771d9e931]…\n       env[\"RTL_DIR\"] = str(worktree_path / \"cores\" / target / \"rtl\")\n        env[\"OBJ_DIR\"] = str(worktree_path / \"cores\" / target / \"obj_dir\")\n    obj_dir = Path(env.get(\"OBJ_DIR\", \"test/cosim/obj_dir\"))\n    if not obj_dir.is_absolute():\n        obj_dir = worktree_path / obj_dir\n    sim_bin = str(obj_dir / \"cosim_sim\")\n\n    # Split ELFs into full-trace cosim vs CRC-validated coremark.\n    all_elfs = list((worktree_path / \"bench/programs\").glob(\"*.elf\"))\n    trace_elfs = [p for p in all_elfs if p.name != \"coremark.elf\"]\n    coremark   = next((p for p in all_elfs if p.name == \"coremark.elf\"), None)\n\n    if not trace_elfs and coremark is None:\n        return {'passed': False, 'failed_elf': 'none', 'detail': 'no ELFs found'}\n\n    # 1. Full-trace cosim of small ELFs (parallel).\n    with ThreadPoolExecutor() as pool:\n        futures = {pool.submit(run_one, elf, sim_bin, worktree, env, flags): elf\n                   for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n", "exit_code": 0, "status": "completed"}}
