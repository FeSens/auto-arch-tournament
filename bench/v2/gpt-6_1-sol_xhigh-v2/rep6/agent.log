{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/generated/r8s2_probe')\nrtl=root/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'ex_stage.sv';s=p.read_text()\ns=s.replace('assign actual_nonsequential = \"'!in.ctrl.is_illegal && !misalign_fault'\"\\\\n                               && (branch_taken || in.ctrl.is_jump);', '''assign actual_nonsequential = \"'!in.ctrl.is_illegal\n                               && ((in.ctrl.is_branch && branch_cond\n                                    && branch_target[1:0] == 2'\"'b00)\n                                   || (in.ctrl.is_jump\n                                       && jump_target[1:0] == 2'b00));''')\ns=s.replace('&& ctrl_with_trap.reg_write && \"'!ctrl_with_trap.is_illegal;'\"', '''&& in.ctrl.reg_write && \"'!in.ctrl.is_illegal\n                      && !in.ctrl.is_branch && !in.ctrl.is_jump;'\"''')\ns=s.replace('''(ctrl_with_trap.reg_write\n                             && \"'!ctrl_with_trap.is_illegal\n                             && !ctrl_with_trap.mem_read)'\"''','''(in.ctrl.reg_write && \"'!in.ctrl.is_illegal\n                             && !in.ctrl.is_branch && !in.ctrl.mem_read\n                             && (!in.ctrl.is_jump || !misalign_jump))'\"''')\np.write_text(s)\nprint('Temporary candidate created:',rtl)\nprint('Replacement counts:', s.count('&& \"'!in.ctrl.is_branch && !in.ctrl.is_jump'\"'), s.count('&& (\"'!in.ctrl.is_jump || !misalign_jump)'\"'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
