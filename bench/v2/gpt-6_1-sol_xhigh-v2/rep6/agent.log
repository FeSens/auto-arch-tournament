{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('/srv/hwebench/tmp/6b356b5e/1b6202c7/fetch_fifo_probe')\nhead=(src/'rtl/if_stage.sv').read_text().split('  logic [31:0] pc,')[0]\npredict=(src/'rtl/if_stage.sv').read_text().split('  always_comb begin\\\\n    direct_branch',1)[1].split('  always_ff',1)[0]\npredict='  always_comb begin\\\\n    direct_branch'+predict\nfor depth in (4,8):\n root=src.parent/('fetch_circular'+str(depth))\n shutil.copytree(src/'rtl',root/'rtl',dirs_exist_ok=True)\n width=(depth-1).bit_length()\n body=f'''  logic [31:0] pc, next_pc, sequential_pc, direct_imm, direct_target;\n  logic direct_branch, direct_jal, predicted_taken;\n  logic [1:0] counters [0:127];\n  if_id_t slots_q [0:{depth-1}], fetched;\n  logic [{width-1}:0] read_q, write_q;\n  logic [{width}:0] count_q;\n  logic raw_pop, fetch_opportunity, push, pop;\n  assign raw_pop = count_q \"'!= 0 && !stall;\n  assign fetch_opportunity = imem_ready && (count_q < {width+1}'\"'d{depth} || raw_pop);\n  assign push = fetch_opportunity && \"'!redirect && !reset;\n  assign pop = raw_pop && !redirect && !reset;\n'\"'''+predict+f'''  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i=0; i<{depth}; i++) slots_q[i] <= '0;\n    end else if (fetch_opportunity) slots_q[write_q] <= fetched;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= '0;\n      count_q <= '0;\n      read_q <= '0;\n      write_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count_q <= '0;\n      read_q <= '0;\n      write_q <= '0;\n    end else begin\n      if (push) begin\n        pc <= next_pc;\n        write_q <= write_q + {width}'d1;\n      end\n      if (pop) read_q <= read_q + {width}'d1;\n      case ({{push,pop}})\n        2'b10: count_q <= count_q + {width+1}'d1;\n        2'b01: count_q <= count_q - {width+1}'d1;\n        default: ;\n      endcase\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 128; i++) counters[i] <= 2'b01;\n    end else if (branch_update) begin\n      if (branch_taken && counters[branch_index] \"'!= 2'\"'b11)\n        counters[branch_index] <= counters[branch_index] + 2'd1;\n      else if (\"'!branch_taken && counters[branch_index] != 2'\"'b00)\n        counters[branch_index] <= counters[branch_index] - 2'd1;\n    end\n  end\n  assign imem_addr = pc;\n  always_comb begin\n    out = slots_q[read_q];\n    out.valid = count_q \"'!= 0 && !flush;\n  end\nendmodule\n'\"'''\n (root/'rtl/if_stage.sv').write_text(head+body)\n print(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
