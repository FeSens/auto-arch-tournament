{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])/'shift_probe_r8s0'\nrtl=root/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'alu.sv'; s=p.read_text()\ns=s.replace('  always_comb begin','''  logic shift_left, shift_arithmetic;\n  logic [31:0] shift_input, shift_result;\n  logic signed [32:0] shift_extended, shift_moved;\n  assign shift_left = (op == ALU_SLL);\n  assign shift_arithmetic = (op == ALU_SRA);\n  for (genvar i=0; i<32; i=i+1) begin : reverse_bits\n    assign shift_input[i] = shift_left ? a[31-i] : a[i];\n    assign shift_result[i] = shift_left ? shift_moved[31-i] : shift_moved[i];\n  end\n  assign shift_extended = \"'$signed({shift_arithmetic && a[31], shift_input});\n  assign shift_moved = shift_extended >>> b[4:0];\n\n  always_comb begin'\"''',1)\ns=s.replace('      ALU_SLL:    out = a << shamt;\\\\n      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','      ALU_SLL, ALU_SRL, ALU_SRA: out = shift_result;')\ns=s.replace('  logic        [4:0]  shamt;\\\\n','').replace('    shamt = b[4:0];\\\\n','')\np.write_text(s)\n(root/'run_vendor.py').write_text('''from pathlib import Path\nimport json,os\nfrom tools.eval.gowin import build_all,summarize\nroot=Path(os.environ['TMPDIR'])/'shift_probe_r8s0'\nr=build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'timing_results.json').write_text(json.dumps({'builds':r,'summary':summarize(r)},indent=2))\nprint(json.dumps({'summary':summarize(r),'paths':[x['critical_paths'][:2] for x in r]},indent=2),flush=True)\n''')\nprint(root)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 \"$TMPDIR/shift_probe_r8s0/run_vendor.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
