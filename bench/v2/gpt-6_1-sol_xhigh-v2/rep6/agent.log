b(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[9306 of 12378 chars elided by tools/bench/transcript.py; sha256:fa23da4ed49974c4]…\n             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\nls: cannot access 'bench/programs/*.elf': No such file or directory\ncores/bench/test/test_pipeline.py:1172:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:1174:            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"rg --files cores/bench/test; sed -n '260,860p' cores/bench/test/test_pipeline.py; cat cores/bench/test/_helpers.py; cat tools/eval/cosim.py\"", "aggregated_output": "cores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_div_unit.py\ncores/bench/test/test_ex_stage.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_id_stage.py\ncores/bench/test/test_mul_unit.py\ncores/bench/test/test_alu.py\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — capture current EX's result in ID.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — capture current MEM's result.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n…[34640 of 37712 chars elided by tools/bench/transcript.py; sha256:2bb9ea72f6373bcf]…\n             for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n            result = future.result()\n            if not result['passed']:\n                return {\n                    'passed': False,\n                    'failed_elf': result['elf'],\n                    'detail': result,\n                }\n\n    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n    if coremark is not None:\n        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n\n\nif __name__ == '__main__':\n    result = run_cosim(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n", "exit_code": 0, "status": "completed"}}
