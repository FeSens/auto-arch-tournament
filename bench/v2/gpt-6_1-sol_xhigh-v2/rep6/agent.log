{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe')\nfor name in ('recovery_registered','recovery_squash'):\n dst=root/name/'rtl';dst.mkdir(parents=True,exist_ok=True)\n for p in Path('cores/bench/rtl').glob('*.sv'):shutil.copyfile(p,dst/p.name)\n if name=='recovery_registered':\n  p=dst/'core_pkg.sv';s=p.read_text().replace('logic [31:0] direct_target;','logic [31:0] direct_target;\\\\n    logic [31:0] correction_pc;');p.write_text(s)\n  p=dst/'if_stage.sv';s=p.read_text().replace('out.direct_target = direct_target;','out.direct_target = direct_target;\\\\n    out.correction_pc = predicted_taken ? sequential_pc : direct_target;');p.write_text(s)\n  p=dst/'id_stage.sv';s=p.read_text().replace('reg_q.direct_target <= in.direct_target;','reg_q.direct_target <= in.direct_target;\\\\n        reg_q.correction_pc <= in.correction_pc;');p.write_text(s)\n  p=dst/'ex_stage.sv';s=p.read_text();old='''  assign redirect_target = actual_nonsequential\n                           ? (in.ctrl.is_jump ? jump_target : branch_target)\n                           : sequential_pc;''';assert old in s\n  s=s.replace(old,'''  // Saved address of the path opposite the accepted direct prediction.\n  assign redirect_target = in.ctrl.is_jalr ? jump_target : in.correction_pc;''');p.write_text(s)\n else:\n  p=dst/'id_stage.sv';s=p.read_text();start=s.index('  always_ff @(posedge clock) begin',s.index('id_ex_t reg_q;'));end=s.index('\\\\n  assign out = reg_q;',start)\n  s=s[:start]+'''  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else begin\n      // Data is harmless in a bubble; predictor recovery clears side effects.\n      if (\"'!stall) begin\n        reg_q.pc       <= in.pc;\n        reg_q.rs1_val  <= rs1_value;\n        reg_q.rs2_val  <= rs2_value;\n        reg_q.alu_a    <= dec_is_auipc ? in.pc : rs1_value;\n        reg_q.alu_b    <= dec_alu_src ? imm : rs2_value;\n        reg_q.imm      <= imm;\n        reg_q.rd       <= in.instr[11:7];\n        reg_q.rs1_addr <= in.instr[19:15];\n        reg_q.rs2_addr <= in.instr[24:20];\n        reg_q.instr    <= in.instr;\n        reg_q.predicted_taken <= in.predicted_taken;\n        reg_q.direct_target <= in.direct_target;\n      end\n      if (flush || (!stall && !in.valid)) begin\n        reg_q.ctrl <= '\"'0;\n        reg_q.valid <= 1'b0;\n      end else if (\"'!stall) begin\n        reg_q.ctrl <= ctrl_decoded;\n        reg_q.valid <= 1'\"'b1;\n      end\n    end\n  end\n''' +s[end:];p.write_text(s)\nprint('Created registered opposite-path and local squash prototypes')\nPY\npython3 -u - <<'PY'\nimport json\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build\nwt=Path.cwd();root=Path('/srv/hwebench/tmp/6b356b5e/c42a2843/predictor_probe')\ndef evaluate(name):\n d=root/name; result=build(wt,d/'rtl','fpga/core_bench_si.sv',0,d/'gowin_p0')\n (d/'timing0.json').write_text(json.dumps(result,indent=2))\n print(name,json.dumps(result),flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n list(executor.map(evaluate,['recovery_registered','recovery_squash']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
