{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"rg -n 'RTL_DIR|TARGET|CONFIG|check|formal|CORE|WRAPPER' formal/run_all.sh | head -n 50\"","aggregated_output":"2:# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n3:# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n5:# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n6:# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n10:# Usage: bash formal/run_all.sh [checks-cfg-path]\n11:#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n12:#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n15:#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n16:#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n18:# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n19:# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n20:# invoking `bash formal/run_all.sh` directly therefore get the\n24:if [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n25:  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n26:  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n32:RISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n34:# riscv-formal checkout (the K concurrent agents of a run share it through\n35:# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n38:# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n39:# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n40:# its own dir afterwards. genchecks.py derives @core@ from the dir's\n41:# basename (genchecks.py:39), so @core@ = \"$CORE_NAME-<suffix>\".\n48:    CORE_DIR=\"$RISCV_FORMAL/cores/$CORE_NAME-$FORMAL_WORK_ID\"\n49:    mkdir \"$CORE_DIR\"\n54:    CORE_DIR=\n56:        try=\"$(mktemp -u \"$RISCV_FORMAL/cores/$CORE_NAME-wXXXXXXXX\")\"\n57:        if mkdir \"$try\" 2>/dev/null; then CORE_DIR=\"$try\"; break; fi\n59:    if [ -z \"$CORE_DIR\" ]; then\n64:WORK_ID=\"${CORE_DIR##*-}\"\n73:    exec 9>\"$CORE_DIR/.owner.lock\"\n78:# Auto-detect single-issue cores from core.yaml when WRAPPER + CHECKS_CFG\n79:# are both unset and $1 (checks-cfg-path) wasn't given either. Explicit\n83:CORE_YAML=\"$PROJECT_ROOT/cores/$CORE_NAME/core.yaml\"\n84:if [ -z \"${WRAPPER:-}\" ] && [ -z \"${CHECKS_CFG:-}\" ] && [ -z \"${1:-}\" ] \\\n85:   && [ -f \"$CORE_YAML\" ]; then\n88:    NRET=$(CORE_YAML=\"$CORE_YAML\" python3 -c '\n91:    d = yaml.safe_load(open(os.environ[\"CORE_YAML\"]).read()) or {}\n97:        WRAPPER=\"$SCRIPT_DIR/wrapper_si.sv\"\n98:        CHECKS_CFG=\"$SCRIPT_DIR/checks_si.cfg\"\n99:        echo \"[run_all.sh] auto-detected nret=1 from $CORE_YAML; using wrapper_si.sv + checks_si.cfg\"\n103:CHECKS_CFG=\"${CHECKS_CFG:-${1:-$SCRIPT_DIR/checks.cfg}}\"\n104:WRAPPER=\"${WRAPPER:-$SCRIPT_DIR/wrapper.sv}\"\n106:    echo \"ERROR: checks.cfg not found at $CHECKS_CFG\"\n109:if [ ! -f \"$WRAPPER\" ]; then\n110:    echo \"ERROR: wrapper not found at $WRAPPER\"\n115:    echo \"ERROR: formal/riscv-formal not found. Clone it:\"\n116:    echo \"  git clone https://github.com/YosysHQ/riscv-formal $SCRIPT_DIR/riscv-formal\"\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n135:        [ \"$stale\" = \"$CORE_DIR\" ] && continue\n147:# Truncate the run log; genchecks + make are tee'd here in full.\n","exit_code":0,"status":"completed"}}
