{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nsrc=Path('cores/bench/rtl')\ndst=Path('/srv/hwebench/tmp/6b356b5e/9bf263ff/skid_probe/rtl')\ndst.mkdir(parents=True,exist_ok=True)\nfor p in src.glob('*.sv'): shutil.copy2(p,dst/p.name)\np=dst/'if_stage.sv'; s=p.read_text()\ns=s.replace('  input  logic              stall,            // hold PC (load-use)', '  input  logic              stall,            // retained interface\\\\n  input  logic              imem_ready,\\\\n  input  logic              issue_hold,')\ns=s.replace('  logic [1:0] counters [0:127];','  logic [1:0] counters [0:127];\\\\n  if_id_t slot_q;\\\\n  logic occupied_q;\\\\n  logic fetch_opportunity;\\\\n  assign fetch_opportunity = imem_ready && (\"'!occupied_q || !issue_hold);'\"')\ns=s.replace('    else if (\"'!stall)   pc <= next_pc;'\"', '    else if (fetch_opportunity) pc <= next_pc;')\nold='''  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_data;\n    out.predicted_taken = predicted_taken;\n    out.direct_target = direct_target;\n    out.valid = \"'!flush;\n  end'\"'''\nnew='''  always_ff @(posedge clock) begin\n    if (reset) begin\n      slot_q <= '0;\n      occupied_q <= 1'b0;\n    end else begin\n      if (fetch_opportunity) begin\n        slot_q.pc <= pc;\n        slot_q.instr <= imem_data;\n        slot_q.predicted_taken <= predicted_taken;\n        slot_q.direct_target <= direct_target;\n        slot_q.valid <= 1'b1;\n      end\n      if (redirect) occupied_q <= 1'b0;\n      else if (occupied_q && \"'!issue_hold) occupied_q <= imem_ready;\n      else if (!occupied_q && imem_ready) occupied_q <= issue_hold;\n    end\n  end\n\n  always_comb begin\n    out = slot_q;\n    if (!occupied_q) begin\n      out.pc = pc;\n      out.instr = imem_data;\n      out.predicted_taken = predicted_taken;\n      out.direct_target = direct_target;\n    end\n    out.valid = !flush && (occupied_q || imem_ready);\n  end'\"'''\nassert old in s;s=s.replace(old,new)\ns=s.replace('  input  logic              stall,            // retained interface\\\\n','')\np.write_text(s)\np=dst/'hazard_unit.sv';s=p.read_text();s=s.replace('  output logic       stall_if,','  output logic       issue_hold,\\\\n  output logic       stall_if,')\ns=s.replace('    flush_if      = redirect || imem_stall;', '    flush_if      = redirect;\\\\n    issue_hold    = dmem_stall || ex_busy || load_use_hazard;')\np.write_text(s)\np=dst/'core.sv';s=p.read_text();s=s.replace('  logic       stall_if, stall_id, flush_if, flush_id;', '  logic       stall_if, stall_id, flush_if, flush_id;\\\\n  logic       issue_hold;')\ns=s.replace('    .stall           (stall_if),','    .imem_ready      (io_imemReady),\\\\n    .issue_hold      (issue_hold),')\ns=s.replace('    .stall_if       (stall_if),','    .issue_hold     (issue_hold),\\\\n    .stall_if       (stall_if),')\ns=s.replace('  logic       stall_if, stall_id, flush_if, flush_id;', '  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic       stall_if;\\\\n  /* verilator lint_on UNUSEDSIGNAL */\\\\n  logic       stall_id, flush_if, flush_id;')\np.write_text(s)\nprint('Isolated probe sources:',dst)\nPY\nmake bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
