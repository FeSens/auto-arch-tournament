sert [r[\"pc\"] for r in rets] == [0, 4, 8] + [12, 16, 20, 24] * 4 + [28]\n        assert len(events) == 4 and all(e[1:4] == (0x100, 0, 1) for e in events)\n        assert all((r[\"rd_wdata\"], r[\"rs1_rdata\"], r[\"rs2_rdata\"]) == (5, 30, 6)\n                   for r in rets if r[\"pc\"] == 16)\n        assert all(r[\"trap\"] == 0 for r in rets)\n        assert training == [(6, 1)] * 3 + [(6, 0)]\n\n\n@cocotb.test()\nasync def predictor_deferred_correction_retains_load_forwarding(dut):\n    program = [ADDI(1, 0, 77), SW(1, 0, 0x100), LW(2, 0, 0x100),\n               SW(1, 0, 0x104), BEQ(2, 1, 12),\n               LW(3, 0, 0x108), SW(2, 0, 0x10C), EBREAK()]\n    events, training = [], []\n    rets, mem = await _run(dut, program, stalls=83, memory_events=events,\n                          training_events=training)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 28]\n    assert [r[\"pc_next\"] for r in rets] == [4, 8, 12, 16, 28, 32]\n    assert rets[4][\"rs1_rdata\"] == rets[4][\"rs2_rdata\"] == 77\n    assert [(da, wen, ren) for _, da, wen, ren, _ in events] == [\n        (0x100, 15, 0), (0x100, 0, 1), (0x104, 15, 0)]\n    assert mem == {0x100: 77, 0x104: 77}\n    assert training == [(4, 1)]\n\n\n@cocotb.test()\nasync def predictor_direct_and_indirect_misalignment_traps(dut):\n    program = [BEQ(0, 0, 2), JAL(1, 2), ADDI(2, 0, 27), JALR(3, 2, 0),\n               BNE(0, 0, 2), _b(8, 0, 0, 2, 0x63), EBREAK()]\n    for seed in (False, 59):\n        rets, _ = await _run(dut, program, stalls=seed)\n        assert [r[\"pc\"] for r in rets] == list(range(0, 28, 4))\n        assert [r[\"pc_next\"] for r in rets] == list(range(4, 32, 4))\n        assert [r[\"trap\"] for r in rets] == [1, 1, 0, 1, 0, 1, 0]\n        assert rets[1][\"rd\"] == rets[3][\"rd\"] == 0\n        assert rets[1][\"rd_wdata\"] == rets[3][\"rd_wdata\"] == 0\n        assert rets[3][\"rs1_rdata\"] == 27\n        assert all(r[\"mem_wmask\"] == r[\"mem_rmask\"] == 0 for r in rets)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
