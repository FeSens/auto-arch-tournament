{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os,shutil\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'predtree';rtl=p/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(f,rtl/f.name)\nf=rtl/'ex_stage.sv';s=f.read_text();a=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)');b=s.index('    branch_taken  =',a)\ns=s[:a]+'''  logic [30:0] compare_eq, compare_lt;\n  logic compare_signed_lt;\n  generate\n    for (genvar i = 0; i < 16; i++) begin : compare_leaves\n      assign compare_eq[15+i] = (rs1[2*i +: 2] == rs2[2*i +: 2]);\n      assign compare_lt[15+i] = (rs1[2*i +: 2] < rs2[2*i +: 2]);\n    end\n    for (genvar i = 0; i < 15; i++) begin : compare_nodes\n      assign compare_eq[i] = compare_eq[2*i+2] && compare_eq[2*i+1];\n      assign compare_lt[i] = compare_lt[2*i+2]\n                            || (compare_eq[2*i+2] && compare_lt[2*i+1]);\n    end\n  endgenerate\n  assign compare_signed_lt = (rs1[31] \"'^ rs2[31]) ? rs1[31] : compare_lt[0];\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = compare_eq[0];\n      BR_BNE:  branch_cond = !compare_eq[0];\n      BR_BLT:  branch_cond = compare_signed_lt;\n      BR_BGE:  branch_cond = !compare_signed_lt;\n      BR_BLTU: branch_cond = compare_lt[0];\n      BR_BGEU: branch_cond = !compare_lt[0];\n      default: branch_cond = 1'\"'b0;\n    endcase\n''' + s[b:];f.write_text(s)\nprint('Prototype RTL:',rtl)\nPY\nRTL_DIR=\\\"\"'$TMPDIR/predtree/rtl\" OBJ_DIR=\"$TMPDIR/predtree/obj_dir\" NRET=1 bash test/cosim/build.sh > \"$TMPDIR/predtree/build.log\" 2>&1\n\"$TMPDIR/predtree/obj_dir/cosim_sim\" bench/programs/coremark.elf 10000000 --bench --istall --dstall > \"$TMPDIR/predtree/coremark.jsonl\"\ncat \"$TMPDIR/predtree/coremark.jsonl\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
