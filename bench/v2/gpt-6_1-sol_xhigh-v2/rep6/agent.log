{"type": "item.started", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/6b356b5e/a424d400/forwarding-prototype')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(src,rtl/src.name)\np=rtl/'ex_stage.sv'\ns=p.read_text().replace('  output logic [31:0]        bypass_data,','''  output logic [31:0]        bypass_data,\n  output logic [31:0]        bypass_alu_data,\n  output logic [31:0]        bypass_link_data,\n  output logic [31:0]        bypass_mul_data,\n  output logic [31:0]        bypass_div_data,\n  output logic [3:0]         bypass_class,''')\npos=s.index('  // Capture the registered operands')\ns=s[:pos]+'''  assign bypass_alu_data = alu_result;\n  assign bypass_link_data = sequential_pc;\n  assign bypass_mul_data = mul_result;\n  assign bypass_div_data = div_result;\n  assign bypass_class[0] = bypass_w_en && \"'!is_multiply && !is_divide && !in.ctrl.is_jump;\n  assign bypass_class[1] = bypass_w_en && !is_multiply && !is_divide && in.ctrl.is_jump;\n  assign bypass_class[2] = bypass_w_en && is_multiply;\n  assign bypass_class[3] = bypass_w_en && is_divide;\n\n'\"'''+s[pos:]\np.write_text(s)\np=rtl/'forward_unit.sv'\np.write_text('''module forward_unit (\n input logic [4:0] if_id_rs1, if_id_rs2,\n input logic [4:0] ex_rd,\n input logic ex_w_en,\n input logic [3:0] ex_class,\n input logic [4:0] mem_rd,\n input logic mem_w_en,\n output logic [5:0] fwd_rs1, fwd_rs2\n);\n logic ex_match1, ex_match2, mem_match1, mem_match2;\n always_comb begin\n  ex_match1 = if_id_rs1 \"'!= 0 && ex_w_en && ex_rd != 0 && ex_rd == if_id_rs1;\n  ex_match2 = if_id_rs2 != 0 && ex_w_en && ex_rd != 0 && ex_rd == if_id_rs2;\n  mem_match1 = if_id_rs1 != 0 && mem_w_en && mem_rd != 0 && mem_rd == if_id_rs1;\n  mem_match2 = if_id_rs2 != 0 && mem_w_en && mem_rd != 0 && mem_rd == if_id_rs2;\n  fwd_rs1[3:0] = ex_class & {4{ex_match1}};\n  fwd_rs2[3:0] = ex_class & {4{ex_match2}};\n  fwd_rs1[4] = mem_match1 && !ex_match1;\n  fwd_rs2[4] = mem_match2 && !ex_match2;\n  fwd_rs1[5] = if_id_rs1 != 0 && !ex_match1 && !mem_match1;\n  fwd_rs2[5] = if_id_rs2 != 0 && !ex_match2 && !mem_match2;\n end\nendmodule\n'\"''')\np=rtl/'id_stage.sv'\ns=p.read_text().replace('logic [1:0]        fwd_rs1_sel','logic [5:0]        fwd_rs1_sel').replace('logic [1:0]        fwd_rs2_sel','logic [5:0]        fwd_rs2_sel').replace('  input  logic [31:0]       fwd_ex_data,','''  input  logic [31:0]       fwd_alu_data,\n  input  logic [31:0]       fwd_link_data,\n  input  logic [31:0]       fwd_mul_data,\n  input  logic [31:0]       fwd_div_data,''')\nstart=s.index('  logic [31:0] rs1_value, rs2_value;')\nend=s.index('\\\\n  ctrl_t ctrl_decoded;',start)\ns=s[:start]+'''  logic [31:0] rs1_value, rs2_value, alu_a_value, alu_b_value;\n  logic [5:0] alu_a_sel, alu_b_sel;\n  function automatic [31:0] select_operand;\n    input [5:0] sel;\n    input [31:0] rf_data;\n    begin\n      select_operand = ({32{sel[0]}} & fwd_alu_data)\n                     | ({32{sel[1]}} & fwd_link_data)\n                     | ({32{sel[2]}} & fwd_mul_data)\n                     | ({32{sel[3]}} & fwd_div_data)\n                     | ({32{sel[4]}} & fwd_mem_data)\n                     | ({32{sel[5]}} & rf_data);\n    end\n  endfunction\n  always_comb begin\n    rs1_value = select_operand(fwd_rs1_sel, rs1_data);\n    rs2_value = select_operand(fwd_rs2_sel, rs2_data);\n    alu_a_sel = fwd_rs1_sel & {6{\"'!dec_is_auipc}};\n    alu_b_sel = fwd_rs2_sel & {6{!dec_alu_src}};\n    alu_a_value = select_operand(alu_a_sel, rs1_data) | ({32{dec_is_auipc}} & in.pc);\n    alu_b_value = select_operand(alu_b_sel, rs2_data) | ({32{dec_alu_src}} & imm);\n  end\n'\"'''+s[end:]\ns=s.replace('reg_q.alu_a    <= dec_is_auipc ? in.pc : rs1_value;','reg_q.alu_a    <= alu_a_value;').replace('reg_q.alu_b    <= dec_alu_src ? imm : rs2_value;','reg_q.alu_b    <=