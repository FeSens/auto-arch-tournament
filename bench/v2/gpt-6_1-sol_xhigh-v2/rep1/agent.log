{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/micro_probe')\nbase=(p/'baseline/rtl/ex_stage.sv').read_text()\nparallel=(p/'parallel/rtl/ex_stage.sv').read_text()\nstart=parallel.index('  logic [7:0] cmp_eq, cmp_lt;')\nend=parallel.index('  always_comb begin',start)\nshared='''  logic branch_eq, branch_ult, branch_slt;\n  assign branch_eq = rs1 == rs2;\n  assign branch_ult = rs1 < rs2;\n  assign branch_slt = (rs1[31] \"'^ rs2[31]) ? rs1[31] : branch_ult;\n\n'\"'''\ntree='''  logic [7:0] cmp_eq, cmp_lt;\n  logic [3:0] pair_eq, pair_lt;\n  logic [1:0] half_eq, half_lt;\n  logic branch_eq, branch_ult, branch_slt;\n  genvar cmp_i;\n  generate\n    for (cmp_i = 0; cmp_i < 8; cmp_i = cmp_i + 1) begin : cmp_nibble\n      assign cmp_eq[cmp_i] = rs1[cmp_i*4 +: 4] == rs2[cmp_i*4 +: 4];\n      assign cmp_lt[cmp_i] = rs1[cmp_i*4 +: 4] < rs2[cmp_i*4 +: 4];\n    end\n    for (cmp_i = 0; cmp_i < 4; cmp_i = cmp_i + 1) begin : cmp_pair\n      assign pair_eq[cmp_i] = cmp_eq[cmp_i*2+1] & cmp_eq[cmp_i*2];\n      assign pair_lt[cmp_i] = cmp_lt[cmp_i*2+1] | (cmp_eq[cmp_i*2+1] & cmp_lt[cmp_i*2]);\n    end\n    for (cmp_i = 0; cmp_i < 2; cmp_i = cmp_i + 1) begin : cmp_half\n      assign half_eq[cmp_i] = pair_eq[cmp_i*2+1] & pair_eq[cmp_i*2];\n      assign half_lt[cmp_i] = pair_lt[cmp_i*2+1] | (pair_eq[cmp_i*2+1] & pair_lt[cmp_i*2]);\n    end\n  endgenerate\n  assign branch_eq = half_eq[1] & half_eq[0];\n  assign branch_ult = half_lt[1] | (half_eq[1] & half_lt[0]);\n  assign branch_slt = (rs1[31] \"'^ rs2[31]) ? rs1[31] : branch_ult;\n\n'\"'''\nfor name,logic in [('shared',shared),('tree',tree)]:\n d=p/name/'rtl'\n shutil.copytree(p/'baseline/rtl',d,dirs_exist_ok=True)\n (d/'ex_stage.sv').write_text(parallel[:start]+logic+parallel[end:])\nprint('Prepared shared-native and balanced-tree branch-comparator variants')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
