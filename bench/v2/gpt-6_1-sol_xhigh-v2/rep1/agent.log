itself there. Lets two `make loop` invocations for different\n#              TARGETs run in parallel without git index/merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: `make loop TARGET=v1 WORKTREE=`.\nN        ?= 10\nK        ?= 1\nAGENT    \n…[32423 of 35495 chars elided by tools/bench/transcript.py; sha256:fbe1e3249b072738]…\nemory.items():\n        struct.pack_into(\"<I\", cpu.mem, address, value)\n    reference_trace = []\n    for _ in range(len(program)):\n        retired = cpu.step()\n        assert retired is not None\n        reference_trace.append(retired)\n        if retired[\"insn\"] == EBREAK():\n            break\n    assert reference_trace[-1][\"insn\"] == EBREAK()\n    names = {\"pc\": \"pc_rdata\", \"pc_next\": \"pc_wdata\", \"rd\": \"rd_addr\"}\n    sim_trace = [{names.get(key, key): value for key, value in retired.items()}\n                 for retired in rets]\n    result = compare(reference_trace, sim_trace)\n    assert result[\"passed\"], result\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
