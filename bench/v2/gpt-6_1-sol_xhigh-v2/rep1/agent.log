{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/_helpers.py'","aggregated_output":"\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/e2005e29/8949e26d/control_lane')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(p,rtl/p.name)\np=rtl/'core_pkg.sv'\ns=p.read_text(); marker='    logic [31:0] rs1_val;\\\\n'\nfields='''    logic [31:0] sequential_pc;\n    logic [31:0] pc_target;\n    logic        sequential_mismatch;\n    logic        pc_target_mismatch;\n    logic        pc_target_fault;\n    logic        write_nonjump;\n    logic        write_jal;\n    logic        write_jalr;\n'''\nassert s.count(marker)==1\np.write_text(s.replace(marker,fields+marker))\np=rtl/'id_stage.sv';s=p.read_text()\nmarker='  // ── ID/EX register '\npos=s.index(marker)\ns=s[:pos]+'''  logic [31:0] sequential_pc, pc_target;\n  assign sequential_pc = in.pc + 32'd4;\n  assign pc_target = in.pc + imm;\n\n'''+s[pos:]\nmarker='        reg_q.rs1_val           <= rs1_data;'\nfields='''        reg_q.sequential_pc      <= sequential_pc;\n        reg_q.pc_target          <= pc_target;\n        reg_q.sequential_mismatch <= in.predicted_next_pc \"'!= sequential_pc;\n        reg_q.pc_target_mismatch <= in.predicted_next_pc != pc_target;\n        reg_q.pc_target_fault    <= pc_target[1:0] != 2'\"'b00;\n        reg_q.write_nonjump      <= dec_reg_write && \"'!dec_is_illegal && !dec_is_jump;\n        reg_q.write_jal          <= dec_reg_write && !dec_is_illegal && dec_is_jump && !dec_is_jalr;\n        reg_q.write_jalr         <= dec_reg_write && !dec_is_illegal && dec_is_jalr;\n'\"'''\nassert marker in s;s=s.replace(marker,fields+marker);p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text()\ns=s.replace('branch_target = in.pc + in.imm;','branch_target = in.pc_target;')\ns=s.replace(': (in.pc + in.imm);',': in.pc_target;')\ns=s.replace(\\\"&& (branch_target[1:0] \"'!= 2'\"'b00);\\\",'&& in.pc_target_fault;')\ns=s.replace(\\\"misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] \"'!= 2'\"'b00);\\\",\\\"misalign_jump   = in.ctrl.is_jump && (in.ctrl.is_jalr ? jalr_alignment[1] : in.pc_target_fault);\\\")\nold='  assign forward_write = in.valid && \"'!redirect && ctrl_with_trap.reg_write;'\"'\nnew='''  logic [1:0] jalr_alignment;\n  assign jalr_alignment = rs1[1:0] + in.imm[1:0];\n  assign forward_write = in.valid && \"'!redirect &&\n                         (in.write_nonjump ||\n                          (in.write_jal && !in.pc_target_fault) ||\n                          (in.write_jalr && !jalr_alignment[1]));'\"'''\nassert old in s;s=s.replace(old,new)\ns=s.replace(\\\"assign sequential_pc = in.pc + 32'd4;\\\",'assign sequential_pc = in.sequential_pc;')\ns=s.replace('assign mismatch_sequential = in.predicted_next_pc \"'!= sequential_pc;'\"','assign mismatch_sequential = in.sequential_mismatch;')\ns=s.replace('assign mismatch_target = in.predicted_next_pc \"'!= control_target;'\"', '''assign mismatch_target = in.ctrl.is_jalr\n                         ? in.predicted_next_pc \"'!= jump_target : in.pc_target_mismatch;'\"''')\ns=s.replace(\\\"in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result\\\",'in.ctrl.is_jump ? in.sequential_pc : alu_result')\np.write_text(s)\nprint(base)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
