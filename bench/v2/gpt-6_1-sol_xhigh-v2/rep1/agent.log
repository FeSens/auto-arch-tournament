{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, os\nfrom collections import Counter\nfrom pathlib import Path\nmodule = json.loads((Path(os.environ['TMPDIR']) / 'bench-cone.json').read_text())['modules']['core']\nprint('Cell types:', dict(Counter(c['type'] for c in module['cells'].values())))\ndrivers = {}\nfor cell in module['cells'].values():\n    kind = cell['type']\n    if 'DFF' in kind or 'LATCH' in kind or kind.startswith('\"'$mem'\"'):\n        continue\n    inputs = {bit for port, bits in cell['connections'].items()\n              if cell['port_directions'][port] == 'input' for bit in bits if isinstance(bit, int)}\n    for port, bits in cell['connections'].items():\n        if cell['port_directions'][port] == 'output':\n            for bit in bits:\n                if isinstance(bit, int):\n                    drivers[bit] = inputs\n\ndef ancestors(name):\n    pending = list(module['netnames'][name]['bits'])\n    visited = set()\n    while pending:\n        bit = pending.pop()\n        if bit in visited or not isinstance(bit, int):\n            continue\n        visited.add(bit)\n        pending.extend(drivers.get(bit, ()))\n    return visited\n\nwb = module['netnames']['u_ex.fwd_mem_wb']['bits']\nfor signal in ('u_ex.writer_allowed', 'near_write', 'fwd_rs1_sel', 'fwd_rs2_sel', 'u_ex.misalign_jump', 'u_ex.misalign_branch', 'u_ex.computed_redirect'):\n    cone = ancestors(signal)\n    print(signal, 'depends on current WB data bits:', [i for i, bit in enumerate(wb) if bit in cone])\nPY\n tail -n 5 \\\"\"'$TMPDIR/bench-unit-pipeline.log\"; tail -n 6 \"$TMPDIR/bench-formal.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
