{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/probe_branch')\ns=(p/'rtl/ex_stage.sv').read_text()\nnew=s[s.index('  function automatic logic pair_branch'):s.index('  always_comb begin\\\\n    branch_taken')]\nnew=new.replace('in.ctrl.branch_op','operation').replace('in.fwd_rs1_sel','sel_a').replace('in.fwd_rs2_sel','sel_b').replace('in.rs1_val','saved_a').replace('in.rs2_val','saved_b')\nhead='''module branch_miter(input [31:0] fwd_ex_mem, fwd_mem_wb, saved_a, saved_b,\n input [2:0] sel_a, sel_b, operation, output equivalent);\nlocalparam BR_BEQ=0, BR_BNE=1, BR_BLT=4, BR_BGE=5, BR_BLTU=6, BR_BGEU=7;\nlogic branch_cond;\nlogic [31:0] a, b;\nlogic reference_cond;\nassign a = ({32{sel_a[0]}} & fwd_ex_mem) | ({32{sel_a[1]}} & fwd_mem_wb) | ({32{sel_a[2]}} & saved_a);\nassign b = ({32{sel_b[0]}} & fwd_ex_mem) | ({32{sel_b[1]}} & fwd_mem_wb) | ({32{sel_b[2]}} & saved_b);\nalways_comb begin\n case(operation)\n  BR_BEQ: reference_cond = a == b;\n  BR_BNE: reference_cond = a \"'!= b;\n  BR_BLT: reference_cond = $signed(a) < $signed(b);\n  BR_BGE: reference_cond = $signed(a) >= $signed(b);\n  BR_BLTU: reference_cond = a < b;\n  BR_BGEU: reference_cond = a >= b;\n  default: reference_cond = 0;\n endcase\nend\nwire legal_a = sel_a == 1 || sel_a == 2 || sel_a == 4;\nwire legal_b = sel_b == 1 || sel_b == 2 || sel_b == 4;\nassign equivalent = !(legal_a && legal_b) || branch_cond == reference_cond;\n'\"'''\n(p/'branch_miter.sv').write_text(head+new+'endmodule\\\\n')\nPY\nyosys -Q -T -p 'read_verilog -sv cores/bench/generated/probe_branch/branch_miter.sv; prep -top branch_miter; flatten; sat -verify -prove equivalent 1' > cores/bench/generated/probe_branch/miter.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
