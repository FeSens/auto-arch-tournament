{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"cat > cores/bench/generated/probe_shift_orders.py <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom itertools import permutations\nimport shutil, json, time\nfrom tools.eval.gowin import build\nfrom tools.eval._slots import eval_slot\nwt=Path.cwd(); root=wt/'cores/bench/generated/shift_orders';root.mkdir(exist_ok=True)\noriginal=(wt/'cores/bench/rtl/alu.sv').read_text()\nstart=original.index('  logic [3:0] low_sel, mid_sel;')\nend=original.index('  localparam logic [1:0] MUL_IDLE')\n\ndef code(groups):\n    lines=['  logic fill;','  assign fill = (op == ALU_SRA) && a[31];']\n    left=right='a'\n    for stage,(offset,width) in enumerate(groups):\n        l=f'shift_left_{stage}';r=f'shift_right_{stage}'\n        lines.append(f'  logic [31:0] {l}, {r};')\n        if width==1:\n            shift=1<<offset\n            lines.append(f\\\"  assign {l} = b[{offset}] ? {{{left}[{31-shift}:0], {shift}'b0}} : {left};\\\")\n            lines.append(f\\\"  assign {r} = b[{offset}] ? {{{{{shift}{{fill}}}}, {right}[31:{shift}]}} : {right};\\\")\n        else:\n            sel=f'shift_sel_{stage}';lines.append(f'  logic [3:0] {sel};')\n            lines.append(f\\\"  assign {sel} = 4'b0001 << b[{offset+width-1}:{offset}];\\\")\n            ls=[];rs=[]\n            for digit in range(4):\n                shift=digit<<offset\n                lexpr=left if shift==0 else f\\\"{{{left}[{31-shift}:0], {shift}'b0}}\\\"\n                rexpr=right if shift==0 else f'{{{{{shift}{{fill}}}}, {right}[31:{shift}]}}'\n                ls.append(f'({{32{{{sel}[{digit}]}}}} & {lexpr})')\n                rs.append(f'({{32{{{sel}[{digit}]}}}} & {rexpr})')\n            lines.append(f'  assign {l} = '+' | '.join(ls)+';')\n            lines.append(f'  assign {r} = '+' | '.join(rs)+';')\n        left=l;right=r\n    lines.extend(['  wire [31:0] left_word = '+left+';', '  wire [31:0] right_word = '+right+';',''])\n    return '\\\\n'.join(lines)\n\nvariants=[]\nfor widths in [(2,2,1),(2,1,2),(1,2,2)]:\n    offset=0; groups=[]\n    for width in widths:\n        groups.append((offset,width));offset+=width\n    for order in permutations(groups):\n        if order==((0,2),(2,2),(4,1)):continue\n        name='g'+'_'.join(f'{o}x{w}' for o,w in order)\n        p=root/name;rtl=p/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n        for f in (wt/'cores/bench/rtl').glob('*.sv'):shutil.copy2(f,rtl/f.name)\n        (rtl/'alu.sv').write_text(original[:start]+code(order)+original[end:])\n        variants.append((name,p))\n\ndef measure(v):\n    name,p=v;t=time.time();r=build(wt,p/'rtl','fpga/core_bench_si.sv',0,p/'timing')\n    (p/'timing_result.json').write_text(json.dumps(r,indent=2))\n    return {'name':name,'elapsed_s':round(time.time()-t,1),**r}\nresults=[]\nwith eval_slot('gowin'),ThreadPoolExecutor(max_workers=3) as pool:\n    for f in as_completed([pool.submit(measure,v) for v in variants]):\n        r=f.result();results.append(r)\n        print(json.dumps({k:r.get(k) for k in ['name','elapsed_s','fmax_mhz','logic','placement_failed','reason','critical_paths']},separators=(',',':')),flush=True)\n        (root/'results.json').write_text(json.dumps(results,indent=2))\nprint('BEST',json.dumps(sorted(results,key=lambda r:r.get('fmax_mhz') or 0,reverse=True)[:3],indent=2),flush=True)\nPY\npython cores/bench/generated/probe_shift_orders.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
