{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import OrderedDict\nimport struct,json,time\np=Path('/srv/hwebench/tmp/e2005e29/80f04ad5/predictor_probe')\ncs=list(struct.iter_unpack('<IIII',(p/'controls.bin').read_bytes()))\nresults={}\nfor n in [16,32,64,128]:\n tab=[None]*n; miss=0; cold=0\n for pc,target,unc,taken in cs:\n  i=(pc>>2)&(n-1);e=tab[i];hit=e and e[0]==pc\n  pred=e[1] if hit and (e[2] or e[3]>=2) else (pc+4)&0xffffffff\n  actual=target if unc or taken else (pc+4)&0xffffffff\n  miss+=pred\"'!=actual;cold+=not hit\n  counter=min(3,e[3]+1) if hit and taken else max(0,e[3]-1) if hit else 2 if taken else 1\n  tab[i]=(pc,target,unc,counter)\n results[f'\"'direct_{n}']={'mispredictions':miss,'allocations':cold}\nfor n in [8,16,24,32,48,64]:\n for policy in ['rr','lru']:\n  tab=OrderedDict();order=[];ptr=0;miss=0;cold=0\n  for pc,target,unc,taken in cs:\n   e=tab.get(pc)\n   pred=e[0] if e and (e[1] or e[2]>=2) else (pc+4)&0xffffffff\n   actual=target if unc or taken else (pc+4)&0xffffffff\n   miss+=pred\"'!=actual;cold+=e is None\n   counter=min(3,e[2]+1) if e and taken else max(0,e[2]-1) if e else 2 if taken else 1\n   if not e and len(tab)==n:\n    tab.popitem(last=False)\n   tab[pc]=(target,unc,counter)\n   if policy=='\"'lru':tab.move_to_end(pc)\n  results[f'assoc_{n}_{policy}']={'mispredictions':miss,'allocations':cold}\n(p/'model_results.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(results,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
