s[lookup_index] == pc[31:8];\n  assign update_hit = valid_q[update_index] && tags[update_index] == update.pc[31:8];\n\n  always_comb begin\n    predicted_next_pc = pc + 32'd4;\n    if (lookup_hit && (unconditional[lookup_index] || counters[lookup_index][1]))\n      predicted_next_pc = {targets[lookup_index], 2'b00};\n  end\n\n  // Only validity resets. The payload memories have asynchronous\n…[3922 of 6994 chars elided by tools/bench/transcript.py; sha256:ab12594285f8d257]…\n    = in.valid;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      div_owned_q <= 1'b0;\n      mul_owned_q <= 1'b0;\n      blocking_instruction_q <= '0;\n    end else if (div_req_valid && div_req_ready) begin\n      div_owned_q <= 1'b1;\n      // Capture the forwarded source values and all retirement metadata\n      // once. Older forwarding sources can disappear while execution runs.\n      blocking_instruction_q <= fast_instruction;\n    end else if (mul_req_valid && mul_req_ready) begin\n      mul_owned_q <= 1'b1;\n      blocking_instruction_q <= fast_instruction;\n    end else if (div_result_valid && div_result_ready) begin\n      div_owned_q <= 1'b0;\n    end else if (mul_result_valid && mul_result_ready) begin\n      mul_owned_q <= 1'b0;\n    end\n  end\n\n  always_ff @(posedge clock) begin\nls: cannot access '.toolchain/bin': No such file or directory\nls: cannot access '.toolchain/oss-cad-suite/bin/verilator': No such file or directory\nls: cannot access 'bench/programs/*.elf': No such file or directory\n", "exit_code": 2, "status": "failed"}}
{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '180,355p' cores/bench/test/test_pipeline.py; rg -n 'predict|monitor|fetch_control|loop|fence' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    await Timer(1, \"ns\")\n\n\nasync def _run_blocking(dut, program, dmem_init=None, bus_control=None,\n                        max_cycles=2000, reset_cycle=None, restart_program=None,\n                        fetch_control=None, monitor=None):\n    \"\"\"Sample retirement and accepted stores before the active clock edge.\n\n    This harness counts accepted transactions, so a repeated store under\n    blocking EX wait or a memory stall fails even if it writes the same value.\n    \"\"\"\n    imem = {i * 4: word for i, word in enumerate(program)}\n    memory = dict(dmem_init or {})\n    retirements, stores = [], []\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await _pipeline_tick(dut)\n    dut.reset.value = 0\n\n    fields = {\n        \"order\": \"order\", \"insn\": \"insn\", \"pc\": \"pc_rdata\",\n        \"pc_next\": \"pc_wdata\", \"rd\": \"rd_addr\", \"rd_wdata\": \"rd_wdata\",\n        \"rs1_addr\": \"rs1_addr\", \"rs1_rdata\": \"rs1_rdata\",\n        \"rs2_addr\": \"rs2_addr\", \"rs2_rdata\": \"rs2_rdata\", \"trap\": \"trap\",\n        \"mem_addr\": \"mem_addr\", \"mem_wmask\": \"mem_wmask\",\n        \"mem_rmask\": \"mem_rmask\", \"mem_rdata\": \"mem_rdata\",\n        \"mem_wdata\": \"mem_wdata\",\n        \"halt\": \"halt\", \"intr\": \"intr\", \"mode\": \"mode\", \"ixl\": \"ixl\",\n    }\n    for cycle in range(max_cycles):\n        if cycle == reset_cycle:\n            # Reset must cancel the in-flight blocking operation and order.\n            assert not any(r[\"insn\"] in program[2:3] for r in retirements)\n            dut.reset.value = 1\n            await _pipeline_tick(dut)\n            dut.reset.value = 0\n            retirements.clear()\n            if restart_program is not None:\n                imem = {i * 4: word for i, word in enumerate(restart_program)}\n\n        ia = int(dut.io_imemAddr.value)\n        da = int(dut.io_dmemAddr.value)\n        word = imem.get(ia, EBREAK())\n        if fetch_control:\n            word = fetch_control(cycle, ia, word)\n        dut.io\n…[9605 of 12677 chars elided by tools/bench/transcript.py; sha256:d3b184ff886e7b7e]…\nin monitor.events)\n1253:        assert [u[\"pc\"] for u in monitor.updates if u[\"pc\"] in pcs] == pcs\n1257:async def fetch_skid_warm_back_to_back_predictions_survive_stalled_memory(dut):\n1266:    monitor = _FetchMonitor()\n1284:        dut, program, bus_control=buses, monitor=monitor,\n1291:        updates = [u for u in monitor.updates if u[\"pc\"] == pc]\n1293:        assert [u[\"prediction\"] for u in updates] == [pc + 4] + [target] * 3\n1294:    assert [u[\"pc\"] for u in monitor.updates if u[\"pc\"] in pcs] == pcs\n1295:    assert any(event == \"refill\" for event, _, _ in monitor.events)\n1356:        monitor = _BypassMonitor()\n1375:            dut, program, {128: 19}, bus_control=buses, monitor=monitor,\n1398:            assert (8, (2, 2), 0, 1) in monitor.choices, \"canceled JAL hid older writer\"\n1399:            choices = {pc: choice for pc, choice, _, _ in monitor.choices}\n1410:    monitor = _BypassMonitor()\n1422:        bus_control=buses, monitor=monitor,\n1425:    assert held == 19 and monitor.retained_far_cycles >= 18\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py; sed -n '1,180p' tools/eval/gowin.py; sed -n '1,200p' tools/eval/cosim.py; cat formal/checks_si.cfg\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analys\n…[16173 of 19245 chars elided by tools/bench/transcript.py; sha256:ac7b21c40acba596]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
