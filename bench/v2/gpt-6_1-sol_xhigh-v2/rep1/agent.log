{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport collections, json, subprocess\nprocess = subprocess.Popen(['cores/bench/obj_dir/cosim_sim', 'bench/programs/coremark.elf', '50000000', '--istall', '--dstall'], stdout=subprocess.PIPE, text=True)\ncounts = {phase: collections.Counter() for phase in ('before', 'bracket', 'after')}\npcs = collections.Counter()\nphase = 'before'\nretirements = 0\nstart_cycle = stop_cycle = None\nfor line in process.stdout:\n    row = json.loads(line)\n    retirements += 1\n    if row['mem_wmask'] and row['mem_addr'] == 0x10000100:\n        phase, start_cycle = 'bracket', row['cycle']\n    elif row['mem_wmask'] and row['mem_addr'] == 0x10000104:\n        phase, stop_cycle = 'after', row['cycle']\n    insn = row['insn']\n    if insn & 0xFE00007F == 0x02000033:\n        funct3 = (insn >> 12) & 7\n        if funct3 >= 4:\n            operation = ('DIV', 'DIVU', 'REM', 'REMU')[funct3 - 4]\n            counts[phase][operation] += 1\n            if phase == 'bracket':\n                pcs[hex(row['pc_rdata'])] += 1\nassert process.wait() == 0\nprint(json.dumps({'dynamic_divides': counts, 'bracket_divide_pcs': pcs, 'retirements': retirements, 'retirement_marker_cycle_difference': stop_cycle - start_cycle}, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
