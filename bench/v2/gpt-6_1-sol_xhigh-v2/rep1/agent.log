n result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    assert value == 0\n    return fields\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n…[19934 of 23006 chars elided by tools/bench/transcript.py; sha256:9d593ae7f44132d4]…\nert int(dut.out.value) == owner, \"owner must still be available to MEM at acceptance\"\n            await _tick(dut)\n            assert int(dut.out.value) == 0 and int(dut.redirect.value) == 0\n            assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n            getattr(dut, \"in\").value = 0\n            await _tick(dut)\n            assert _unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0\n\n    # Reset also cancels pending recovery while downstream remains stalled.\n    await _setup(dut)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=0x40, predicted_next_pc=0x100, valid=1)\n    await _tick(dut)\n    assert int(dut.redirect.value) == 1\n    dut.stall.value = dut.reset.value = 1\n    await _tick(dut)\n    assert int(dut.redirect.value) == 0 and int(dut.out.value) == 0\n    assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
