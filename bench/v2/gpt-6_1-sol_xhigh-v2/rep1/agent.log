{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/e2005e29/7f876844/rf_probe')\nrtl=base/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor src in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(src,rtl/src.name)\n(rtl/'reg_file.sv').write_text('''module reg_file (\n  input logic clock, reset,\n  input logic [4:0] rs1_addr, rs2_addr,\n  output logic [31:0] rs1_data, rs2_data,\n  input logic w_en,\n  input logic [4:0] w_addr,\n  input logic [31:0] w_data\n);\n  wire [31:0] masked1 [0:31];\n  wire [31:0] masked2 [0:31];\n  wire [31:0] tree1 [1:63];\n  wire [31:0] tree2 [1:63];\n  assign masked1[0] = 32'b0;\n  assign masked2[0] = 32'b0;\n  for (genvar word_idx = 1; word_idx < 32; word_idx++) begin : g_word\n    logic [31:0] word_q;\n    wire write_sel = w_en && w_addr == 5'(word_idx);\n    wire read1_sel = rs1_addr == 5'(word_idx);\n    wire read2_sel = rs2_addr == 5'(word_idx);\n    always_ff @(posedge clock)\n      if (reset) word_q <= 32'b0;\n      else if (write_sel) word_q <= w_data;\n    assign masked1[word_idx] = word_q & {32{read1_sel}};\n    assign masked2[word_idx] = word_q & {32{read2_sel}};\n  end\n  for (genvar leaf = 0; leaf < 32; leaf++) begin : g_leaf\n    assign tree1[32+leaf] = masked1[leaf];\n    assign tree2[32+leaf] = masked2[leaf];\n  end\n  for (genvar node = 1; node < 32; node++) begin : g_node\n    assign tree1[node] = tree1[2*node] | tree1[2*node+1];\n    assign tree2[node] = tree2[2*node] | tree2[2*node+1];\n  end\n  always_comb begin\n    if (rs1_addr == 5'b0) rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = tree1[1];\n    if (rs2_addr == 5'b0) rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = tree2[1];\n  end\nendmodule\n''')\nprint(base)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
