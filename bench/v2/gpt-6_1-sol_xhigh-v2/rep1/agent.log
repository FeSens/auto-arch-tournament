{"type": "item.started", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/e2005e29/cee6b67a/block_probe/variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path.cwd(); probe=Path('/srv/hwebench/tmp/e2005e29/cee6b67a/block_probe')\nfor name in ['rf_flat','branch_shared','btb_banked']:\n rtl=probe/name/'rtl';shutil.copytree(root/'cores/bench/rtl',rtl,dirs_exist_ok=True)\n if name=='rf_flat':\n  p=rtl/'reg_file.sv';s=p.read_text();start=s.index('  always_comb begin\\\\n    if (rs1_addr')\n  s=s[:start]+'''  logic bypass1, bypass2, saved1, saved2;\n  assign bypass1 = rs1_addr \"'!= 5'\"'b0 && w_en && w_addr == rs1_addr;\n  assign bypass2 = rs2_addr \"'!= 5'\"'b0 && w_en && w_addr == rs2_addr;\n  assign saved1 = rs1_addr \"'!= 5'\"'b0 && \"'!bypass1 && written_q[rs1_addr];\n  assign saved2 = rs2_addr != 5'\"'b0 && \"'!bypass2 && written_q[rs2_addr];\n  assign rs1_data = ({32{bypass1}} & w_data) | ({32{saved1}} & stored1);\n  assign rs2_data = ({32{bypass2}} & w_data) | ({32{saved2}} & stored2);\nendmodule\n'\"''';p.write_text(s)\n if name=='branch_shared':\n  p=rtl/'ex_stage.sv';s=p.read_text().replace('  logic        branch_cond;','''  logic branch_less;\n  logic [31:0] compare_a, compare_b;\n  logic compare_signed;\n  assign compare_signed = \"'!in.ctrl.branch_op[1];\n  assign compare_a = {rs1[31] ''^ compare_signed, rs1[30:0]};\n  assign compare_b = {rs2[31] ''^ compare_signed, rs2[30:0]};\n  assign branch_less = compare_a < compare_b;\n  logic        branch_cond;'\"''')\n  s=s.replace('(\"'$signed(rs1) <  $signed(rs2))'\"','branch_less').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!branch_less'\"')\n  s=s.replace('(rs1 <  rs2)','branch_less').replace('(rs1 >= rs2)','\"'!branch_less'\"');p.write_text(s)\n if name=='btb_banked':\n  p=rtl/'if_stage.sv';s=p.read_text();start=s.index('  logic [23:0] tags');end=s.index('  // An empty entry')\n  s=s[:start]+'''  logic [5:0] lookup_index, update_index;\n  logic [3:0] lookup_bank, update_bank, hits, takes;\n  logic [31:0] bank_target [0:3];\n  if_id_t fetch_token, skid_q;\n  logic fetch_accept;\n  assign lookup_index = pc[7:2];\n  assign update_index = update.pc[7:2];\n  assign lookup_bank = 4'b0001 << pc[7:6];\n  assign update_bank = 4'b0001 << update.pc[7:6];\n  genvar bi;\n  generate for (bi=0; bi<4; bi=bi+1) begin: predictor_bank\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [23:0] tags [0:15];\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [29:0] targets [0:15];\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic unconditional [0:15];\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counters [0:15];\n    logic update_hit;\n    assign hits[bi] = valid_q[bi*16+lookup_index[3:0]] && tags[lookup_index[3:0]] == pc[31:8];\n    assign takes[bi] = lookup_bank[bi] && hits[bi] &&\n                        (unconditional[lookup_index[3:0]] || counters[lookup_index[3:0]][1]);\n    assign bank_target[bi] = {targets[lookup_index[3:0]],2'b00};\n    assign update_hit = valid_q[bi*16+update_index[3:0]] && tags[update_index[3:0]] == update.pc[31:8];\n    always_ff @(posedge clock) begin\n      if (reset) valid_q[bi*16+:16] <= '0;\n      else if (update.valid && update_bank[bi]) begin\n        if (update.allocate) valid_q[bi*16+update_index[3:0]] <= 1'b1;\n        else if (update_hit) valid_q[bi*16+update_index[3:0]] <= 1'b0;\n      end\n      if (\"'!reset && update.valid && update.allocate && update_bank[bi]) begin\n        tags[update_index[3:0]] <= update.pc[31:8];\n        targets[update_index[3:0]] <= update.target[31:2];\n        unconditional[update_index[3:0]] <= update.unconditional;\n        if (!update_hit) counters[update_index[3:0]] <= update.taken ? 2'\"'b10 : 2'b01;\n        else if (update.taken) begin\n          if (counters[update_index[3:0]] \"'!= 2'\"'b11) counters[update_index[3:0]] <= counters[update_index[3:0]]+2'b01;\n        end else begin\n          if (counters[update_index[3:0]] \"'!= 2'\"'b00) counters[update_index[3:0]] <= counters[update_index[3:0]]-2'b01;\n        end\n      end\n    end\n  end endgenerate\n  assign predicted_next_pc = ({32{takes[0]}} & bank_target[0]) |\n                             ({32{takes[1]}} & bank_target[1]) |\n                             ({32{takes[2]}} & bank_target[2]) |\n                             ({32{takes[3]}} & bank_target[3]) |\n                             ({32{\"'!(|takes)}} & (pc+32'\"'d4));\n\n'''+s[end:];p.write_text(s)\nprint('Variants ready')\nPY\npython /srv/hwebench/tmp/e2005e29/cee6b67a/block_probe/variants.py\npython -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build\nroot=Path.cwd();probe=Path('/srv/hwebench/tmp/e2005e29/cee6b67a/block_probe')\nwith ThreadPoolExecutor(max_workers=3) as pool:\n fs={pool.submit(build,root,probe/n/'rtl','fpga/core_bench_si.sv',1,probe/n/'gowin_p1'):n for n in ['rf_flat','branch_shared','btb_banked']}\n for f in as_completed(fs):\n  n=fs[f];r=f.result();(probe/n/'timing.json').write_text(json.dumps(r,indent=2)); print(n,json.dumps(r),flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
