h_op),\n    .is_branch  (dec_is_branch),\n    .is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_to_reg (dec_mem_to_reg),\n    .is_illegal (dec_is_illegal)\n  );\n\n  logic [31:0\n…[19287 of 22359 chars elided by tools/bench/transcript.py; sha256:be5238a1389db888]…\nal/holdout.py\ntools/eval/gowin.py\ntools/eval/formal.py\ntools/eval/test_gate_sanity.py\ntools/eval/_subprocess.py\ntools/eval/test_holdout.py\ntools/eval/fpga.py\ntools/eval/test_formal_workdir_cleanup.py\ntools/eval/test_rvfi_lint.py\ntools/eval/test_process_reaper.py\ntools/eval/test_formal_reclassify.py\ntools/eval/rvfi_lint.py\ntools/eval/test_remove_path.py\ntools/eval/test_subprocess_pgroup.py\ntools/eval/__init__.py\ntools/eval/test_slots.py\ntools/eval/test_bench_stall_gen.py\ntools/eval/test_fpga_report.py\ntools/eval/test_formal_nret.py\ntools/eval/cosim.py\ntools/eval/_slots.py\ntest/_helpers.py\ntest/conftest.py\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_mem_stage.py\ncores/bench/test/test_ex_stage.py\ncores/bench/test/test_if_stage.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\ntest/cosim/run_cosim.py\ntest/cosim/build.sh\ntest/cosim/main.cpp\ntest/cosim/reference.py\n", "exit_code": 0, "status": "completed"}}
