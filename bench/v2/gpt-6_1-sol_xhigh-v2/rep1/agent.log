 source = payload if int(dut.stall_id.value) else int(dut.if_id_w.value)\n            pc_shift = 212 if int(dut.stall_id.value) else 65\n            prediction_shift = 180 if int(dut.stall_id.value) else 33\n            self.killed_data = ((source >> pc_shift) & 0xFFFFFFFF,\n                                (source >> prediction_shift) & 0xFFFFFFFF,\n                                (source >> 1) & 0xFFFFFFFF)\n        update = int(dut.predictor_update.value)\n20:from _helpers import run_cocotb\n1710:def test_pipeline_runner():\n1711:    run_cocotb(\n", "exit_code": 0, "status": "completed"}}
