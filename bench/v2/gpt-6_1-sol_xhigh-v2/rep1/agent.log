{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re, zlib\nfor name in ('SUG550-2.0.1E_GowinSynthesis User Guide.pdf', 'SUG100-4.4.2E_Gowin Software User Guide.pdf'):\n    data = (Path('/opt/gowin/IDE/doc/EN') / name).read_bytes()\n    for match in re.finditer(rb'stream\\\\r?\\\\n(.*?)endstream', data, re.S):\n        try:\n            content = zlib.decompress(match[1].rstrip())\n        except zlib.error:\n            continue\n        lines = re.findall(rb'\\\\[(.*?)\\\\]\\\\s*TJ', content, re.S)\n        text = '\\\\n'.join(b''.join(re.findall(rb'\\\\(((?:\\\\\\\\.|[\"'^)])*)'\"\\\\)', line)).decode('latin1') for line in lines)\n        if any(term in text.lower() for term in ('syn_preserve', 'syn_keep', 'netlist', 'encrypt')):\n            for key in ('syn_preserve', 'syn_keep', 'netlist', 'encrypt'):\n                for hit in re.finditer(key, text, re.I):\n                    print(name, text[max(0, hit.start()-200):hit.end()+750])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
