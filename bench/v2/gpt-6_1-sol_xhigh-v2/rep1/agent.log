{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Execute-stage blocking arithmetic, completion backpressure and redirects.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_ADD, ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n                      ALU_DIV, ALU_REMU, run_cocotb)\n\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"predicted_next_pc\", 32),\n         (\"rs1_val\", 32), (\"rs2_val\", 32), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\nUPDATE = [(\"valid\", 1), (\"allocate\", 1), (\"unconditional\", 1),\n          (\"taken\", 1), (\"pc\", 32), (\"target\", 32)]\n\n\ndef _pack(layout, **values):\n    result = 0\n    for name, width in layout:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    assert value == 0\n    return fields\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.v\n…[12457 of 15529 chars elided by tools/bench/transcript.py; sha256:a8cdc7f3e50d8e5d]…\nack(EX_MEM, int(dut.out.value))\n        assert retired[\"pc_next\"] == actual\n        ctrl = _unpack(CTRL, retired[\"ctrl\"])\n        if controls.get(\"is_jump\") and allocation:\n            assert retired[\"alu_result\"] == 0x84 and ctrl[\"reg_write\"] == 1\n        if (controls.get(\"is_jump\") or (controls.get(\"is_branch\") and a == b)) and not allocation:\n            assert ctrl[\"is_illegal\"] == 1 and ctrl[\"reg_write\"] == 0\n\n    for valid, stalled, reset in ((0, 0, 0), (1, 1, 0), (1, 0, 1)):\n        getattr(dut, \"in\").value = _pack(\n            ID_EX, pc=0x80, predicted_next_pc=0x90, valid=valid,\n            ctrl=_pack(CTRL, reg_write=1),\n        )\n        dut.stall.value = stalled\n        dut.reset.value = reset\n        await Timer(1, \"ns\")\n        assert int(dut.redirect.value) == 0\n        assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
