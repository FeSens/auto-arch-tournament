{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_stage.py cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"PC-only predictor and elastic, fall-through fetch acceptance.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _update(pc, target=0, *, valid=1, allocate=1, unconditional=0, taken=1):\n    flags = (valid << 3) | (allocate << 2) | (unconditional << 1) | taken\n    return (flags << 64) | (pc << 32) | target\n\n\ndef _prediction(dut):\n    return (int(dut.out.value) >> 33) & 0xFFFFFFFF\n\n\ndef _token(dut):\n    value = int(dut.out.value)\n    return ((value >> 65) & 0xFFFFFFFF, (value >> 33) & 0xFFFFFFFF,\n            (value >> 1) & 0xFFFFFFFF, value & 1)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    # Predictor-only tests must not enqueue fetches during their ID holds.\n    dut.imem_ready.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.imem_data.value = 0xDEADBEEF\n    dut.update.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _at(dut, pc):\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    await _tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.imem_addr.value) == pc\n\n\nasync def _train(dut, pc, target=0, **flags):\n    dut.update.value = _update(pc, target, **flags)\n    await _tick(dut)\n    dut.update.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def counters_saturate_and_lookup_has_no_update_bypass(dut):\n    await _setup(dut)\n    await _at(dut, 0x40)\n    assert _prediction(dut) == 0x44\n    dut.update.value = _update(0x40, 0x100)\n    await Timer(1, \"ns\")\n    assert _prediction(dut) == 0x44, \"allocation bypassed the pre-edge table\"\n    await _tick(dut)\n    dut.update.value = 0\n    await Timer(1, \"ns\")\n    assert _prediction(dut) == 0x100  # new taken branch is weak taken\n    for taken, expected in [(1, 0x100), (1, 0x100), (0, 0x100),\n        \n…[30539 of 33611 chars elided by tools/bench/transcript.py; sha256:1a7290fb0455375a]…\nert int(dut.out.value) == owner, \"owner must still be available to MEM at acceptance\"\n            await _tick(dut)\n            assert int(dut.out.value) == 0 and int(dut.redirect.value) == 0\n            assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n            getattr(dut, \"in\").value = 0\n            await _tick(dut)\n            assert _unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0\n\n    # Reset also cancels pending recovery while downstream remains stalled.\n    await _setup(dut)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=0x40, predicted_next_pc=0x100, valid=1)\n    await _tick(dut)\n    assert int(dut.redirect.value) == 1\n    dut.stall.value = dut.reset.value = 1\n    await _tick(dut)\n    assert int(dut.redirect.value) == 0 and int(dut.out.value) == 0\n    assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
