r(1, \"ns\")\n    assert _prediction(dut) == 0x44, \"allocation bypassed the pre-edge table\"\n    await _tick(dut)\n    dut.update.value = 0\n    await Timer(1, \"ns\")\n    assert _prediction(dut) == 0x100  # new taken branch is weak taken\n    for taken, expected in [(1, 0x100), (1, 0x100), (0, 0x100),\n        \n…[7577 of 10649 chars elided by tools/bench/transcript.py; sha256:40f1927850812a25]…\ned = queued or raw\n        assert int(dut.imem_addr.value) == pc\n        assert _token(dut) == offered\n        if reset or recovery:\n            pc, queued = (0 if reset else target), None\n            pending.clear()\n        else:\n            accept = ready and (queued is None or not stalled)\n            if accept:\n                pending.append(raw)\n            if offered[3] and not stalled:\n                assert pending.pop(0) == offered, \"duplicate or reordered acceptance\"\n                assert offered[2] not in consumed\n                consumed.add(offered[2])\n            if accept and (queued is not None or stalled):\n                queued = raw\n            elif not stalled:\n                queued = None\n            if accept:\n                pc += 4\n        await _tick(dut)\n    assert len(consumed) > 300, \"insufficient progress in randomized fetch test\"\n\n\ndef test_if_stage_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n               test_module=\"test_if_stage\")\n", "exit_code": 0, "status": "completed"}}
