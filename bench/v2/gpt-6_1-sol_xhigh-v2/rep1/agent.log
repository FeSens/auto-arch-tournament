{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"sed -n '1,70p' cores/bench/test/test_ex_stage.py\"","aggregated_output":"\"\"\"Execute-stage blocking arithmetic, completion backpressure and redirects.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_ADD, ALU_SUB, ALU_XOR, ALU_SLL, ALU_SRL, ALU_SRA,\n                      ALU_LUI, ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n                      ALU_DIV, ALU_REMU, run_cocotb)\n\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"predicted_next_pc\", 32),\n         (\"rs1_val\", 32), (\"rs2_val\", 32),\n         (\"fwd_rs1_sel\", 3), (\"fwd_rs2_sel\", 3), (\"imm\", 32),\n         (\"alu_a_sel\", 4), (\"alu_b_sel\", 4),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"effective_address\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\nUPDATE = [(\"valid\", 1), (\"allocate\", 1), (\"unconditional\", 1),\n          (\"taken\", 1), (\"pc\", 32), (\"target\", 32)]\n\n\ndef _pack(layout, **values):\n    if layout is ID_EX:\n        values = {\"fwd_rs1_sel\": 4, \"fwd_rs2_sel\": 4, **values}\n        controls = _unpack(CTRL, values.get(\"ctrl\", 0))\n        values.setdefault(\"alu_a_sel\", 8 if controls[\"is_auipc\"] else values[\"fwd_rs1_sel\"])\n        values.setdefault(\"alu_b_sel\", 8 if controls[\"alu_src\"] else values[\"fwd_rs2_sel\"])\n    result = 0\n    for name, width in layout:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    assert value == 0\n    return fields\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    await _tick(dut)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json,shutil\nfrom pathlib import Path\nfrom tools.eval import gowin\nwt=Path.cwd()\nscratch=Path('/srv/hwebench/tmp/e2005e29/615dbe62/r10_writer_permission')\nrtl=scratch/'rtl'\nshutil.copytree(wt/'cores/bench/rtl',rtl,dirs_exist_ok=True)\np=rtl/'ex_stage.sv'\ns=p.read_text()\ns=s.replace('  logic misalign_fault;\\\\n','  logic misalign_fault;\\\\n  logic [1:0] jal_low_sum, jalr_low_sum;\\\\n  logic writer_permission;\\\\n\\\\n  assign jal_low_sum = in.pc[1:0] + in.imm[1:0];\\\\n  assign jalr_low_sum = rs1[1:0] + in.imm[1:0];\\\\n  assign writer_permission = in.ctrl.reg_write && \"'!in.ctrl.is_illegal &&'\"\\\\n                             \"'!in.ctrl.is_branch && !misalign_jump;'\"\\\\n')\ns=s.replace(\\\"    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] \"'!= 2'\"'b00);\\\", \\\"    misalign_jump   = in.ctrl.is_jump &&\\\\n                      (in.ctrl.is_jalr ? jalr_low_sum[1] : (jal_low_sum \"'!= 2'\"'b00));\\\")\ns=s.replace(\\\"      ctrl_with_trap.reg_write  = 1'b0;\\\\n    end\\\\n  end\\\", \\\"    end\\\\n    ctrl_with_trap.reg_write = writer_permission;\\\\n  end\\\",1)\ns=s.replace('assign forward_write = in.valid && \"'!redirect && ctrl_with_trap.reg_write;'\"', 'assign forward_write = in.valid && \"'!redirect && writer_permission;'\"')\np.write_text(s)\nprint('Prototype RTL prepared',flush=True)\nresults=gowin.build_all(wt,rtl,'fpga/core_bench_si.sv',scratch/'timing')\n(scratch/'timing_results.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(gowin.summarize(results),indent=2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
