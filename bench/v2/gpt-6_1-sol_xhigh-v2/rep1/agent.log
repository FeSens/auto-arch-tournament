{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py; cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger operations remain combinational. MUL and DIV/REM use clocked\nrequest/completion handshakes; multiply operands and products are registered.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    dut.mul_req_valid.value = 0\n    dut.mul_result_ready.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.div_req_ready.value) == 1\n    assert int(dut.div_result_valid.value) == 0\n    assert int(dut.mul_req_ready.value) == 1\n    assert int(dut.mul_result_valid.value) == 0\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Check exact results using the operation's execution protocol.\"\"\"\n    if op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        await _check_mul(dut, op, a, b, expected)\n        return\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _launch_mul(dut, op, a, b):\n    assert int(dut.mul_req_ready.value) == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.mul_req_valid.value = 1\n    await _tick(dut)\n    dut.mul_req_valid.\n…[89904 of 92976 chars elided by tools/bench/transcript.py; sha256:1efa7d7e31b1b68f]…\n), (4, 15, 0x642),\n    ]\n    expected = {8: (0, 0xFFFFFFFC), 12: (0, 0xFFFFFFFC),\n                28: (0x10000100, 0x10000108), 32: (0x10000100, 0x10000108),\n                40: (0, 4), 44: (0, 4), 52: (4, 0), 56: (4, 0)}\n    for retired in rets:\n        if retired[\"pc\"] in expected:\n            address, base = expected[retired[\"pc\"]]\n            assert retired[\"mem_addr\"] == address and retired[\"rs1_rdata\"] == base\n            assert retired[\"mem_wmask\"] | retired[\"mem_rmask\"] == 15\n    assert memory[0] == memory[4] == memory[0x10000100] == 0x642\n    assert _by_insn(rets, LW(9, 0, 4))[0][\"rd_wdata\"] == 0x642\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
