{"type": "item.completed", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c \"git diff --check; git status --short; sed -n '98,190p' cores/bench/rtl/ex_stage.sv\"", "aggregated_output": " M cores/bench/rtl/ex_stage.sv\n M cores/bench/test/test_ex_stage.py\n  logic [31:0] branch_a [0:2];\n  logic [31:0] branch_b [0:2];\n  logic [8:0]  branch_eq, branch_ltu, branch_lts;\n  logic [8:0]  branch_pair_sel;\n  logic        branch_selected_eq, branch_selected_ltu, branch_selected_lts;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] jump_target;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  // Compare every candidate pair before forwarding selection. Only a\n  // one-bit predicate passes through the registered source masks; the raw\n  // source muxes remain independent for stores, JALR, arithmetic and RVFI.\n  assign branch_a[0] = fwd_ex_mem;\n  assign branch_a[1] = fwd_mem_wb;\n  assign branch_a[2] = in.rs1_val;\n  assign branch_b[0] = fwd_ex_mem;\n  assign branch_b[1] = fwd_mem_wb;\n  assign branch_b[2] = in.rs2_val;\n\n  for (genvar a = 0; a < 3; a = a + 1) begin : g_branch_a\n    for (genvar b = 0; b < 3; b = b + 1) begin : g_branch_b\n      // Both operands selecting the same producer need no comparator.\n      // The two saved RF values are independent even for the (2,2) pair.\n      if (a == b && a < 2) begin : g_same_producer\n        assign branch_eq[3*a+b]  = 1'b1;\n        assign branch_ltu[3*a+b] = 1'b0;\n        assign branch_lts[3*a+b] = 1'b0;\n      end else begin : g_compare\n        assign branch_eq[3*a+b]  = branch_a[a] == branch_b[b];\n        assign branch_ltu[3*a+b] = branch_a[a] < branch_b[b];\n        assign branch_lts[3*a+b] = $signed(branch_a[a]) < $signed(branch_b[b]);\n      end\n      assign branch_pair_sel[3*a+b] = in.fwd_rs1_sel[a] && in.fwd_rs2_sel[b];\n    end\n  end\n\n  assign branch_selected_eq  = |(branch_pair_sel & branch_eq);\n  assign branch_selected_ltu = |(branch_pair_sel & branch_ltu);\n  assign branch_selected_lts = |(branch_pair_sel & branch_lts);\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = branch_selected_eq;\n      BR_BNE:  branch_cond = !branch_selected_eq;\n      BR_BLT:  branch_cond = branch_selected_lts;\n      BR_BGE:  branch_cond = !branch_selected_lts;\n      BR_BLTU: branch_cond = branch_selected_ltu;\n      BR_BGEU: branch_cond = !branch_selected_ltu;\n      default: branch_cond = 1'b0;\n    endcase\n  end\n\n  always_comb begin\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    jalr_sum    = rs1 + in.imm;\n    jump_target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0}\n                                  : (in.pc + in.imm);\n  end\n\n  // ── Misaligned branch / jump target trap ──────────────────────────────\n  // riscv-formal's spec demands rvfi_trap=1 when next_pc is misaligned\n  // (without C extension that means [1:0] != 0). We trap the offending\n  // instruction, resolve to PC+4 (recovering a stale prediction), and clear\n  // reg_write so JAL/JALR don't write the return address on trap.\n  logic misalign_branch;\n  logic misalign_jump;\n  logic misalign_fault;\n  ctrl_t ctrl_with_trap;\n\n  always_comb begin\n    misalign_branch = in.ctrl.is_branch && branch_taken\n                      && (branch_target[1:0] != 2'b00);\n    misalign_jump   = in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n    misalign_fault  = misalign_branch || misalign_jump;\n\n    ctrl_with_trap = in.ctrl;\n    if (misalign_fault) begin\n      ctrl_with_trap.is_illegal = 1'b1;\n      ctrl_with_trap.reg_write  = 1'b0;\n    end\n  end\n\n  // ID/EX is held throughout M ownership, including the completion edge.\n  // Its identity and control therefore also describe the saved M producer.\n  // Consumer capture is disabled while EX waits or dmem holds.\n  assign forward_write = in.valid && !redirect && ctrl_with_trap.reg_write;\n\n  logic [31:0] sequential_pc, control_target;\n", "exit_code": 0, "status": "completed"}}
