{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_if_stage.py\"", "aggregated_output": "\"\"\"PC-only predictor direction, tagging, invalidation and fetch acceptance.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _update(pc, target=0, *, valid=1, allocate=1, unconditional=0, taken=1):\n    flags = (valid << 3) | (allocate << 2) | (unconditional << 1) | taken\n    return (flags << 64) | (pc << 32) | target\n\n\ndef _prediction(dut):\n    return (int(dut.out.value) >> 33) & 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    dut.imem_ready.value = 1\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.imem_data.value = 0xDEADBEEF\n    dut.update.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _at(dut, pc):\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    await _tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.imem_addr.value) == pc\n\n\nasync def _train(dut, pc, target=0, **flags):\n    dut.update.value = _update(pc, target, **flags)\n    await _tick(dut)\n    dut.update.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def counters_saturate_and_lookup_has_no_update_bypass(dut):\n    await _setup(dut)\n    await _at(dut, 0x40)\n    assert _prediction(dut) == 0x44\n    dut.update.value = _update(0x40, 0x100)\n    await Timer(1, \"ns\")\n    assert _prediction(dut) == 0x44, \"allocation bypassed the pre-edge table\"\n    await _tick(dut)\n    dut.update.value = 0\n    await Timer(1, \"ns\")\n    assert _prediction(dut) == 0x100  # new taken branch is weak taken\n    for taken, expected in [(1, 0x100), (1, 0x100), (0, 0x100),\n                            (0, 0x44), (0, 0x44), (0, 0x44),\n                            (1, 0x44), (1, 0x100)]:\n        await _train(dut, 0x40, 0x100, taken=taken)\n        assert _prediction(dut) == expected\n    dut.update.value = _update(0x40, 0x200)\n  \n…[1156 of 4228 chars elided by tools/bench/transcript.py; sha256:e096c927b9a20396]…\nvalue = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    await _at(dut, 0x80000040)\n    assert _prediction(dut) == 0x80000044\n\n\n@cocotb.test()\nasync def fetch_acceptance_and_priority_recovery_keep_instruction_raw(dut):\n    await _setup(dut)\n    await _train(dut, 0, 0x100, unconditional=1)\n    dut.stall.value = 0\n    dut.imem_ready.value = 0\n    await _tick(dut)\n    assert int(dut.imem_addr.value) == 0\n    assert int(dut.out.value) & 1 == 0\n    assert (int(dut.out.value) >> 1) & 0xFFFFFFFF == 0xDEADBEEF\n    dut.stall.value = 1\n    await _at(dut, 0x80)\n    assert int(dut.imem_addr.value) == 0x80\n    assert (int(dut.out.value) >> 1) & 0xFFFFFFFF == 0xDEADBEEF\n    await _at(dut, 0)\n    dut.imem_ready.value = 1\n    dut.stall.value = 0\n    await _tick(dut)\n    assert int(dut.imem_addr.value) == 0x100\n    await _tick(dut)\n    assert int(dut.imem_addr.value) == 0x104\n\n\ndef test_if_stage_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n               test_module=\"test_if_stage\")\n", "exit_code": 0, "status": "completed"}}
