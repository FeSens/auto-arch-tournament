{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/probe_shift')\nrtl=p/'rtl'; rtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(f,rtl/f.name)\na=rtl/'alu.sv';s=a.read_text();s=s.replace('  input  logic [31:0] b,','  input  logic [31:0] b,\\\\n  input  logic [3:0] shift_low_sel,\\\\n  input  logic [3:0] shift_mid_sel,\\\\n  input  logic shift_word_sel,')\ns=s.replace(\\\"assign low_sel = 4'b0001 << b[1:0];\\\",\\\"assign low_sel = shift_low_sel;\\\").replace(\\\"assign mid_sel = 4'b0001 << b[3:2];\\\",\\\"assign mid_sel = shift_mid_sel;\\\").replace('b[4] ?','shift_word_sel ?')\na.write_text(s)\ne=rtl/'ex_stage.sv';s=e.read_text()\nspot='  logic [31:0] alu_result;'\nblock='''  logic [3:0] shift_low_sel, shift_mid_sel;\n  logic shift_word_sel;\n  assign shift_low_sel =\n    ({4{in.alu_b_sel[0]}} & (4'b0001 << fwd_ex_mem[1:0])) |\n    ({4{in.alu_b_sel[1]}} & (4'b0001 << fwd_mem_wb[1:0])) |\n    ({4{in.alu_b_sel[2]}} & (4'b0001 << in.rs2_val[1:0])) |\n    ({4{in.alu_b_sel[3]}} & (4'b0001 << in.imm[1:0]));\n  assign shift_mid_sel =\n    ({4{in.alu_b_sel[0]}} & (4'b0001 << fwd_ex_mem[3:2])) |\n    ({4{in.alu_b_sel[1]}} & (4'b0001 << fwd_mem_wb[3:2])) |\n    ({4{in.alu_b_sel[2]}} & (4'b0001 << in.rs2_val[3:2])) |\n    ({4{in.alu_b_sel[3]}} & (4'b0001 << in.imm[3:2]));\n  assign shift_word_sel =\n    (in.alu_b_sel[0] && fwd_ex_mem[4]) |\n    (in.alu_b_sel[1] && fwd_mem_wb[4]) |\n    (in.alu_b_sel[2] && in.rs2_val[4]) |\n    (in.alu_b_sel[3] && in.imm[4]);\n\n'''\ns=s.replace(spot,block+spot).replace('    .b   (alu_b),','    .b   (alu_b),\\\\n    .shift_low_sel (shift_low_sel),\\\\n    .shift_mid_sel (shift_mid_sel),\\\\n    .shift_word_sel (shift_word_sel),')\ne.write_text(s)\nprint('Staged shift-control decoding prototype')\nPY\npython - <<'PY'\nfrom tools.eval.gowin import build_all,summarize\nfrom pathlib import Path\nimport json,time\nwt=Path.cwd();p=wt/'cores/bench/generated/probe_shift';t=time.time()\nr=build_all(wt,p/'rtl','fpga/core_bench_si.sv',p/'timing')\nx={'elapsed_s':time.time()-t,'results':r,'summary':summarize(r)}\n(p/'timing_result.json').write_text(json.dumps(x,indent=2))\nprint(json.dumps({'elapsed_s':x['elapsed_s'],'summary':x['summary']},indent=2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
