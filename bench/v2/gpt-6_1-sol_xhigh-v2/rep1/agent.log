{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/e2005e29/8c34c79b/ras-profile/prototype-rtl/if_stage.sv');s=p.read_text()\na=s.index('  logic [31:0] pc;');b=s.index('  // An empty entry can accept')\ns=s[:a]+'''  logic [31:0] pc;\n  logic [31:0] predicted_next_pc;\n  logic [63:0] valid_q;\n  logic [3:0] predict_bank, update_hit_bank;\n  logic [29:0] masked_target [0:3];\n  logic [5:0] update_index;\n  logic update_hit;\n  if_id_t fetch_token, skid_q;\n  logic fetch_accept;\n  assign update_index = update.pc[7:2];\n  assign update_hit = |update_hit_bank;\n  always_comb begin\n    predicted_next_pc = pc + 32'd4;\n    if (|predict_bank)\n      predicted_next_pc = {masked_target[0] | masked_target[1] |\n                           masked_target[2] | masked_target[3], 2'b00};\n  end\n  always_ff @(posedge clock) begin\n    if (reset) valid_q <= '0;\n    else if (update.valid) begin\n      if (update.allocate) valid_q[update_index] <= 1'b1;\n      else if (update_hit) valid_q[update_index] <= 1'b0;\n    end\n  end\n  genvar g;\n  generate for (g=0;g<4;g=g+1) begin: g_btb\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [23:0] tags [0:15];\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [29:0] targets [0:15];\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic unconditional [0:15];\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counters [0:15];\n    logic hit, uhit;\n    assign hit = valid_q[g*16 + int'(pc[5:2])] && tags[pc[5:2]] == pc[31:8];\n    assign uhit = valid_q[g*16 + int'(update.pc[5:2])] &&\n                  tags[update.pc[5:2]] == update.pc[31:8];\n    assign update_hit_bank[g] = update.pc[7:6] == 2'(g) && uhit;\n    assign predict_bank[g] = pc[7:6] == 2'(g) && hit &&\n           (unconditional[pc[5:2]] || counters[pc[5:2]][1]);\n    assign masked_target[g] = targets[pc[5:2]] & {30{predict_bank[g]}};\n    always_ff @(posedge clock) begin\n      if (\"'!reset && update.valid && update.allocate && update.pc[7:6] == 2'\"'(g)) begin\n        tags[update.pc[5:2]] <= update.pc[31:8];\n        targets[update.pc[5:2]] <= update.target[31:2];\n        unconditional[update.pc[5:2]] <= update.unconditional;\n        if (\"'!uhit) counters[update.pc[5:2]] <= update.taken ? 2'\"'b10 : 2'b01;\n        else if (update.taken) begin\n          if (counters[update.pc[5:2]] \"'!= 2'\"'b11)\n            counters[update.pc[5:2]] <= counters[update.pc[5:2]] + 2'b01;\n        end else begin\n          if (counters[update.pc[5:2]] \"'!= 2'\"'b00)\n            counters[update.pc[5:2]] <= counters[update.pc[5:2]] - 2'b01;\n        end\n      end\n    end\n  end endgenerate\n\n''' +s[b:];p.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python -u - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nimport json\np=Path('/srv/hwebench/tmp/e2005e29/8c34c79b/ras-profile')\nr=build_all(Path.cwd(),p/'prototype-rtl','fpga/core_bench_si.sv',p/'banked-timing')\n(p/'banked-timing-result.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(summarize(r),indent=2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
