{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_if_stage.py cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"PC-only predictor and elastic, fall-through fetch acceptance.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _update(pc, target=0, *, valid=1, allocate=1, unconditional=0, taken=1):\n    flags = (valid << 3) | (allocate << 2) | (unconditional << 1) | taken\n    return (flags << 64) | (pc << 32) | target\n\n\ndef _prediction(dut):\n    return (int(dut.out.value) >> 33) & 0xFFFFFFFF\n\n\ndef _token(dut):\n    value = int(dut.out.value)\n    return ((value >> 65) & 0xFFFFFFFF, (value >> 33) & 0xFFFFFFFF,\n            (value >> 1) & 0xFFFFFFFF, value & 1)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.stall.value = 1\n    # Predictor-only tests must not enqueue fetches during their ID holds.\n    dut.imem_ready.value = 0\n    dut.redirect.value = 0\n    dut.redirect_target.value = 0\n    dut.imem_data.value = 0xDEADBEEF\n    dut.update.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _at(dut, pc):\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    await _tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.imem_addr.value) == pc\n\n\nasync def _train(dut, pc, target=0, **flags):\n    dut.update.value = _update(pc, target, **flags)\n    await _tick(dut)\n    dut.update.value = 0\n    await Timer(1, \"ns\")\n\n\n@cocotb.test()\nasync def counters_saturate_and_lookup_has_no_update_bypass(dut):\n    await _setup(dut)\n    await _at(dut, 0x40)\n    assert _prediction(dut) == 0x44\n    dut.update.value = _update(0x40, 0x100)\n    await Timer(1, \"ns\")\n    assert _prediction(dut) == 0x44, \"allocation bypassed the pre-edge table\"\n    await _tick(dut)\n    dut.update.value = 0\n    await Timer(1, \"ns\")\n    assert _prediction(dut) == 0x100  # new taken branch is weak taken\n    for taken, expected in [(1, 0x100), (1, 0x100), (0, 0x100),\n        \n…[24599 of 27671 chars elided by tools/bench/transcript.py; sha256:3cc9b8eb03253d5b]…\n_tick(dut)\n            assert int(dut.mul_result_valid.value) == 0\n            dut.reset.value = 0\n            await Timer(1, \"ns\")\n            assert int(dut.mul_req_ready.value) == int(dut.div_req_ready.value) == 1\n            for _ in range(4):\n                await _tick(dut)\n                assert int(dut.mul_result_valid.value) == 0\n            await _check_mul(dut, ALU_MUL, 11, 13, 143)\n\n\n@cocotb.test()\nasync def nonmultiply_request_does_not_start_multiplier(dut):\n    await _setup(dut)\n    dut.mul_req_valid.value = 1\n    for op in (ALU_ADD, ALU_SUB, ALU_DIV):\n        dut.op.value = op\n        await _tick(dut)\n        assert int(dut.mul_req_ready.value) == 1\n        assert int(dut.mul_result_valid.value) == 0\n    dut.mul_req_valid.value = 0\n    await _check_mul(dut, ALU_MUL, 17, 19, 323)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
