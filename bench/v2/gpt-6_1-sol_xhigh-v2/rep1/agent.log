{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK=(1<<32)-1\nWIDE=(1<<35)-1\n\ndef radix4(n,d):\n    r=q=0\n    for shift in range(30,-1,-2):\n        t=(r<<2)|((n>>shift)&3)\n        trials=[(t-k*d)&WIDE for k in (1,2,3)]\n        borrows=[bool(v&(1<<34)) for v in trials]\n        picks=[borrows[0],not borrows[0] and borrows[1],not borrows[1] and borrows[2],not borrows[2]]\n        assert sum(picks)==1\n        digit=picks.index(True)\n        r=(t if digit==0 else trials[digit-1])&MASK\n        q=(q<<2)|digit\n        if d:\n            assert r<d\n            assert ((n>>shift)==q*d+r)\n    return q,r\n\ndef signed(x):\n    return x-(1<<32) if x&(1<<31) else x\n\ndef wrapped(n,d,is_signed):\n    a,b=(signed(n),signed(d)) if is_signed else (n,d)\n    q,r=radix4(abs(a),abs(b))\n    if is_signed:\n        if (a<0)\"'!=(b<0): q=(-q)&MASK\n        if a<0: r=(-r)&MASK\n    if d==0: return MASK,n\n    if is_signed and n==0x80000000 and d==MASK: return n,0\n    return q,r\n\nrng=random.Random(20260929)\nedge=[0,1,2,3,4,7,8,15,16,31,32,0x3fffffff,0x40000000,0x7ffffffe,0x7fffffff,0x80000000,0x80000001,0xfffffffe,MASK]\npairs=[(a,b) for a in edge for b in edge]\nfor d in edge[1:]:\n    for k in [1,2,3,4,7,15]:\n        for delta in [-1,0,1]:\n            a=k*d+delta\n            if 0<=a<=MASK: pairs.append((a,d))\npairs.extend((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(100000))\nfor a,b in pairs:\n    for is_signed in [False,True]:\n        aa,bb=(signed(a),signed(b)) if is_signed else (a,b)\n        if bb==0: expected=(MASK,a)\n        else:\n            q=abs(aa)//abs(bb)\n            if (aa<0)!=(bb<0): q=-q\n            expected=(q&MASK,(aa-q*bb)&MASK)\n        assert wrapped(a,b,is_signed)==expected,(a,b,is_signed)\nprint(f'\"'Radix-4 width/borrow/sign model passed {2*len(pairs):,} signed/unsigned quotient-remainder pairs, including boundary and zero-divisor cases.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
