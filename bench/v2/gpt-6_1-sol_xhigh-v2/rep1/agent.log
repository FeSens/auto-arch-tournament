{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nscratch=Path('/srv/hwebench/tmp/e2005e29/80f04ad5/predictor_probe')\nrtl=scratch/'rtl'\nrtl.mkdir(exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'):\n shutil.copy2(f,rtl/f.name)\np=rtl/'if_stage.sv'\ns=p.read_text()\na=s.index('  logic [63:0] valid_q;')\nb=s.index('  // An empty entry can accept',a)\ns=s[:a]+'''  wire [63:0] predict_entry;\n  wire [29:0] target_entry [0:63];\n  wire [29:0] target_l1 [0:15];\n  wire [29:0] target_l2 [0:3];\n  wire [29:0] target_selected;\n  if_id_t fetch_token, skid_q;\n  logic fetch_accept;\n\n  genvar e, k;\n  generate\n    for (e = 0; e < 64; e = e + 1) begin : g_entry\n      logic valid_q;\n      logic [23:0] tag_q;\n      logic [29:0] target_q;\n      logic unconditional_q;\n      logic [1:0] counter_q;\n      wire lookup_index_match = pc[7:2] == e;\n      wire update_index_match = update.pc[7:2] == e;\n      wire lookup_hit = valid_q && lookup_index_match && tag_q == pc[31:8];\n      wire update_hit = valid_q && tag_q == update.pc[31:8];\n      assign predict_entry[e] = lookup_hit && (unconditional_q || counter_q[1]);\n      assign target_entry[e] = target_q & {30{predict_entry[e]}};\n      always_ff @(posedge clock) begin\n        if (reset) valid_q <= 1'b0;\n        else if (update.valid && update_index_match) begin\n          if (update.allocate) valid_q <= 1'b1;\n          else if (update_hit) valid_q <= 1'b0;\n        end\n      end\n      always_ff @(posedge clock) begin\n        if (\"'!reset && update.valid && update_index_match && update.allocate) begin\n          tag_q <= update.pc[31:8];\n          target_q <= update.target[31:2];\n          unconditional_q <= update.unconditional;\n          if (!update_hit) counter_q <= update.taken ? 2'\"'b10 : 2'b01;\n          else if (update.taken) begin\n            if (counter_q \"'!= 2'\"'b11) counter_q <= counter_q + 2'b01;\n          end else begin\n            if (counter_q \"'!= 2'\"'b00) counter_q <= counter_q - 2'b01;\n          end\n        end\n      end\n    end\n    for (k = 0; k < 16; k = k + 1) begin : g_l1\n      assign target_l1[k] = target_entry[4*k] | target_entry[4*k+1] |\n                            target_entry[4*k+2] | target_entry[4*k+3];\n    end\n    for (k = 0; k < 4; k = k + 1) begin : g_l2\n      assign target_l2[k] = target_l1[4*k] | target_l1[4*k+1] |\n                            target_l1[4*k+2] | target_l1[4*k+3];\n    end\n  endgenerate\n  assign target_selected = target_l2[0] | target_l2[1] | target_l2[2] | target_l2[3];\n  assign predicted_next_pc = (|predict_entry) ? {target_selected, 2'b00} : pc + 32'd4;\n\n'''+s[b:]\np.write_text(s)\nprint('Created isolated constant-entry predictor timing probe.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
