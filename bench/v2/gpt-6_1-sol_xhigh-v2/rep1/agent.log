{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport sys,json,time,collections\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM(); cpu.load_elf('cores/bench/generated/hypgen_profile/coremark.elf')\nactive=False; stats=collections.Counter(); sites=collections.Counter(); last=None; trace=[]\nstarted=time.monotonic()\nfor i in range(10000000):\n r=cpu.step()\n if r is None: raise RuntimeError('unsupported')\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True; last=None; continue\n if r['mem_wmask'] and r['mem_addr']==0x10000104: active=False; break\n if active:\n  instr=r['insn']; op=instr&127; stats['instructions']+=1\n  if op==0x63: stats['conditional']+=1\n  if op==0x67: stats['jalr']+=1\n  if op==0x6f: stats['jal']+=1\n  if last is not None and (last['insn']&127)==3 and last['rd'] and last['rd'] in ((instr>>15)&31,(instr>>20)&31):\n   stats['adjacent_load_raw_match']+=1\n   if op==0x63:\n    stats['load_dependent_branch']+=1; sites[r['pc']]+=1\n   elif op==0x67: stats['load_dependent_jalr']+=1\n   else: stats['load_dependent_other_raw_match']+=1\n  trace.append((r['pc'],instr,r['npc'],r['rd']))\n  last=r\nprint(json.dumps(dict(stats),indent=2))\nprint('load-dependent branch sites',sites.most_common(20))\nprint('elapsed',round(time.monotonic()-started,2),'oob',cpu.oob_access)\nimport struct\nwith open('cores/bench/generated/hypgen_profile/trace.bin','wb') as f:\n for row in trace: f.write(struct.pack('<4I',*row))\nPath('cores/bench/generated/hypgen_profile/stats.json').write_text(json.dumps(dict(stats),indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
