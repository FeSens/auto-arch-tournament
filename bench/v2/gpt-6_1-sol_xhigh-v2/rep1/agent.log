{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/e2005e29/0c3c73a9/r15s0-carry-probe')\nbase.mkdir(exist_ok=True)\nrtl=base/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n(rtl/'add32_fast.sv').write_text('''module add32_fast (\n  input logic [31:0] a, b,\n  output logic [31:0] sum\n);\n  logic [4:0] sum0 [0:7];\n  logic [4:0] sum1 [0:7];\n  logic [7:0] g0, p0, g1, p1, g2, p2, g3;\n  genvar j;\n  generate for (j=0; j<8; j=j+1) begin: block_sum\n    assign sum0[j] = {1'b0,a[4*j+:4]} + {1'b0,b[4*j+:4]};\n    assign sum1[j] = {1'b0,a[4*j+:4]} + {1'b0,b[4*j+:4]} + 5'd1;\n    assign g0[j] = sum0[j][4];\n    assign p0[j] = &(a[4*j+:4] \"'^ b[4*j+:4]);\n    if (j>=1) begin\n      assign g1[j] = g0[j] | (p0[j] & g0[j-1]);\n      assign p1[j] = p0[j] & p0[j-1];\n    end else begin\n      assign g1[j] = g0[j];\n      assign p1[j] = p0[j];\n    end\n    if (j>=2) begin\n      assign g2[j] = g1[j] | (p1[j] & g1[j-2]);\n      assign p2[j] = p1[j] & p1[j-2];\n    end else begin\n      assign g2[j] = g1[j];\n      assign p2[j] = p1[j];\n    end\n    if (j>=4) begin\n      assign g3[j] = g2[j] | (p2[j] & g2[j-4]);\n    end else begin\n      assign g3[j] = g2[j];\n    end\n    if (j==0) assign sum[4*j+:4] = sum0[j][3:0];\n    else assign sum[4*j+:4] = g3[j-1] ? sum1[j][3:0] : sum0[j][3:0];\n  end endgenerate\nendmodule\n'\"''')\np=rtl/'alu.sv'; s=p.read_text(); assert s.count('ALU_ADD:    out = a + b;')==1\ns=s.replace('  logic [3:0] low_sel, mid_sel;', '  logic [31:0] add_result;\\\\n  add32_fast u_add (.a(a), .b(b), .sum(add_result));\\\\n\\\\n  logic [3:0] low_sel, mid_sel;')\ns=s.replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = add_result;'); p.write_text(s)\np=rtl/'ex_stage.sv'; s=p.read_text()\ns=s.replace('  logic        branch_cond;', '  logic [31:0] pc_imm_sum, rs1_imm_sum;\\\\n  add32_fast u_pc_imm (.a(in.pc), .b(