{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/mul_bypass_probe/test/test_alu.py')\ns=p.read_text()\ni=s.index('\\\\ndef test_alu_runner():')\ns=s[:i]+'''\n@cocotb.test()\nasync def probe_independent_multiplier_operands(dut):\n    await _setup(dut)\n    pairs=[(3,4),(0xffffffff,0xffffffff),(0x80000000,0xffffffff),\n           (0x80000000,0x80000000),(0x10000,0xffff0000)]\n    for a,b in pairs:\n        for op,expected in [(ALU_MUL,a*b),\n                            (ALU_MULH,(_signed(a)*_signed(b))>>32),\n                            (ALU_MULHU,(a*b)>>32),\n                            (ALU_MULHSU,(_signed(a)*b)>>32)]:\n            dut.a.value=9\n            dut.b.value=7\n            dut.mul_a.value=a\n            dut.mul_b.value=b\n            dut.op.value=op\n            await Timer(1,\\\"ns\\\")\n            assert int(dut.out.value)==(expected&MASK32)\n        dut.op.value=ALU_ADD\n        await Timer(1,\\\"ns\\\")\n        assert int(dut.out.value)==16\n\n'''+s[i:]\np.write_text(s)\nprint('Added independent operand routing verification')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
