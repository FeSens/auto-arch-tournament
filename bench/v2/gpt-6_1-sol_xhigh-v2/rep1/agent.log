{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor width in [4,8]:\n p=Path(f'/srv/hwebench/tmp/e2005e29/80f04ad5/seg{width}_probe');rtl=p/'rtl';rtl.mkdir(parents=True,exist_ok=True)\n for f in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(f,rtl/f.name)\n f=rtl/'ex_stage.sv';s=f.read_text();a=s.index('  assign mismatch_target = ');b=s.index('\\\\n',a)\n code=f'''  function automatic target_mismatch;\n    input [31:0] operand_a;\n    input [31:0] operand_b;\n    input [31:0] predicted;\n    reg [31:0] inferred_carry;\n    reg [{width}:0] block_sum;\n    reg [{32//width-1}:0] bad_blocks;\n    integer block_idx;\n    begin\n      inferred_carry = operand_a \"'^ operand_b ''^ predicted;\n      for (block_idx = 0; block_idx < {32//width}; block_idx = block_idx + 1) begin\n        block_sum = {{1'\"'b0, operand_a[block_idx*{width} +: {width}]}} +\n                    {{1'b0, operand_b[block_idx*{width} +: {width}]}} +\n                    {{{{{width}{{1'b0}}}}, (block_idx == 0 ? 1'b0 : inferred_carry[block_idx*{width}])}};\n        bad_blocks[block_idx] = block_sum[{width-1}:0] \"'!= predicted[block_idx*{width} +: {width}];\n        if (block_idx < {32//width-1})\n          bad_blocks[block_idx] = bad_blocks[block_idx] ||\n                                 block_sum[{width}] != inferred_carry[(block_idx+1)*{width}];\n      end\n      target_mismatch = |bad_blocks;\n    end\n  endfunction\n\n  assign mismatch_target = in.ctrl.is_jalr\n    ? (in.predicted_next_pc[0] || target_mismatch(rs1, in.imm,\n        {{in.predicted_next_pc[31:1], rs1[0] ''^ in.imm[0]}}))\n    : target_mismatch(in.pc, in.imm, in.predicted_next_pc);'\"'''\n s=s[:a]+code+s[b:];f.write_text(s)\nprint('Created isolated four- and eight-bit exact-verification probes.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
