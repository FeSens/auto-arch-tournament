{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench')\nprobe=root/'generated'/'rf_probe'\nrtl=probe/'rtl'\nrtl.mkdir(parents=True,exist_ok=True)\nfor src in (root/'rtl').glob('*.sv'):\n    shutil.copy2(src,rtl/src.name)\np=rtl/'reg_file.sv'\ns=p.read_text()\nstart=s.index('  logic [31:0] regs [0:31];')\ns=s[:start]+'''  logic [31:0] rs1_terms [0:31];\n  logic [31:0] rs2_terms [0:31];\n  logic [31:0] rs1_array_data, rs2_array_data;\n  assign rs1_terms[0] = 32'b0;\n  assign rs2_terms[0] = 32'b0;\n  generate\n    for (genvar r = 1; r < 32; r = r + 1) begin : g_word\n      logic [31:0] value_q;\n      always_ff @(posedge clock) begin\n        if (reset) value_q <= 32'b0;\n        else if (w_en && w_addr == 5'(r)) value_q <= w_data;\n      end\n      assign rs1_terms[r] = value_q & {32{rs1_addr == 5'(r)}};\n      assign rs2_terms[r] = value_q & {32{rs2_addr == 5'(r)}};\n    end\n  endgenerate\n  always_comb begin\n    rs1_array_data = 32'b0;\n    rs2_array_data = 32'b0;\n    for (int r = 1; r < 32; r = r + 1) begin\n      rs1_array_data = rs1_array_data | rs1_terms[r];\n      rs2_array_data = rs2_array_data | rs2_terms[r];\n    end\n    if (rs1_addr == 5'b0) rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr) rs1_data = w_data;\n    else rs1_data = rs1_array_data;\n    if (rs2_addr == 5'b0) rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr) rs2_data = w_data;\n    else rs2_data = rs2_array_data;\n  end\nendmodule\n'''\np.write_text(s)\nprint(f'Staged independent register-file candidate in {rtl}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
