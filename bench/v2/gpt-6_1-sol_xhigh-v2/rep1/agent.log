$unsigned(mul_ss[63:32]);'\"','out = mul_product[63:32];').replace('out = mul_uu[63:32];','out = mul_product[63:32];').replace('out = \"'$unsigned(mul_su[63:32]);'\"','out = mul_product[63:32];')\np.write_text(s)\nprint('Isolated multiplier probe prepared:',rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
