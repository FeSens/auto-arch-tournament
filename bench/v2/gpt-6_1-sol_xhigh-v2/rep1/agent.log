{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/e2005e29/63e9e2af/match_probe');rtl=p/'rtl';rtl.mkdir(parents=True,exist_ok=True)\nfor f in Path('cores/bench/rtl').glob('*.sv'):shutil.copyfile(f,rtl/f.name)\nf=rtl/'id_stage.sv';s=f.read_text().replace('  output id_ex_t  out','  input logic [4:0] ex_rd, mem_rd,\\\\n  output logic [1:0] fwd_mem_match, fwd_wb_match,\\\\n  output id_ex_t  out')\npos=s.index('  assign out = reg_q;');s=s[:pos]+'''  always_ff @(posedge clock) begin\n    if (reset) begin\n      fwd_mem_match <= 2'b0;\n      fwd_wb_match <= 2'b0;\n    end else if (\"'!stall) begin\n      fwd_mem_match[0] <= ex_rd != 5'\"'b0 && ex_rd == in.instr[19:15];\n      fwd_mem_match[1] <= ex_rd \"'!= 5'\"'b0 && ex_rd == in.instr[24:20];\n      fwd_wb_match[0] <= mem_rd \"'!= 5'\"'b0 && mem_rd == in.instr[19:15];\n      fwd_wb_match[1] <= mem_rd \"'!= 5'\"'b0 && mem_rd == in.instr[24:20];\n    end\n  end\n\n'''+s[pos:];f.write_text(s)\nf=rtl/'forward_unit.sv';s=f.read_text();start=s.index('module forward_unit');s=s[:start]+'''module forward_unit (\n  input logic [1:0] mem_match, wb_match,\n  input logic ex_mem_w_en, mem_wb_w_en,\n  output logic [1:0] fwd_rs1, fwd_rs2\n);\n  always_comb begin\n    if (ex_mem_w_en && mem_match[0]) fwd_rs1 = 2'd1;\n    else if (mem_wb_w_en && wb_match[0]) fwd_rs1 = 2'd2;\n    else fwd_rs1 = 2'd0;\n    if (ex_mem_w_en && mem_match[1]) fwd_rs2 = 2'd1;\n    else if (mem_wb_w_en && wb_match[1]) fwd_rs2 = 2'd2;\n    else fwd_rs2 = 2'd0;\n  end\nendmodule\n''';f.write_text(s)\nf=rtl/'core.sv';s=f.read_text().replace('  // EX redirect','  logic [1:0] fwd_mem_match, fwd_wb_match;\\\\n\\\\n  // EX redirect');s=s.replace('    .rs2_data (rs2_data_w),\\\\n    .out','    .rs2_data (rs2_data_w),\\\\n    .ex_rd (id_ex_w.rd),\\\\n    .mem_rd (ex_mem_w.rd),\\\\n    .fwd_mem_match (fwd_mem_match),\\\\n    .fwd_wb_match (fwd_wb_match),\\\\n    .out');s=s.replace('    .id_ex_rs1   (id_ex_w.rs1_addr),\\\\n    .id_ex_rs2   (id_ex_w.rs2_addr),\\\\n    .ex_mem_rd   (ex_mem_w.rd),','    .mem_match (fwd_mem_match),\\\\n    .wb_match (fwd_wb_match),');s=s.replace('    .mem_wb_rd   (mem_wb_w.rd),\\\\n','');f.write_text(s)\nprint(p)\nPY\nRTL_DIR=/srv/hwebench/tmp/e2005e29/63e9e2af/match_probe/rtl OBJ_DIR=/srv/hwebench/tmp/e2005e29/63e9e2af/match_probe/obj_dir NRET=1 bash test/cosim/build.sh > /srv/hwebench/tmp/e2005e29/63e9e2af/match_probe/build_cosim.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
