st is the final retirement.\n    try:\n        marker = json.loads(lines[-1])\n        last_retirement = json.loads(lines[-2])\n    except json.JSONDecodeError as e:\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': f'malformed sim output: {e}'}\n\n    if not marker.get('ebreak', False):\n        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n        # a hung CPU with whatever cycle count it happened to reach.\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': 'maxcycles_hit_before_ebreak'}\n\n    # OOB sticky flag from the sim:\n…[12352 of 15424 chars elided by tools/bench/transcript.py; sha256:9a29111201382248]…\n      R13C30[2][B]   cpu/u_ex/computed_redirect_target_0_s0/F   \ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr:2126:  16.516   0.000   tNET   RR   1        R13C30[2][B]   cpu/u_ex/redirect_target_0_s0/D            \ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr:2135:  10.329   3.241    tNET   RR   1        R13C30[2][B]   cpu/u_ex/redirect_target_0_s0/CLK  \ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr:2136:  10.294   -0.035   tSu         1        R13C30[2][B]   cpu/u_ex/redirect_target_0_s0      \ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr:2156:To                : cpu/u_ex/redirect_target_1_s0\ncores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.tr:2233:  15.967   0.734   tNET   FF   1        R13C30[2][A]   cpu/u_ex/computed_redirect_target_1_s0/I0  \nSBY 14:11:19 [insn_sub_ch0] summary: engine_0 did not produce any traces\nSBY 14:11:19 [insn_sub_ch0] DONE (PASS, rc=0)\nSBY 14:15:10 [reg_ch0] engine_0: ##   0:05:01  waiting for solver (5 minutes)\n", "exit_code": 0, "status": "completed"}}
