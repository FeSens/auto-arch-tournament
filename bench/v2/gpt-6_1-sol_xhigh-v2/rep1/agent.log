{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c 'git diff -- cores/bench/rtl/ex_stage.sv'","aggregated_output":"diff --git a/cores/bench/rtl/ex_stage.sv b/cores/bench/rtl/ex_stage.sv\nindex d2eb50d..3d7f40f 100644\n--- a/cores/bench/rtl/ex_stage.sv\n+++ b/cores/bench/rtl/ex_stage.sv\n@@ -94,6 +94,8 @@ module ex_stage (\n   );\n \n   // ── Branch resolve ────────────────────────────────────────────────────\n+  logic [7:0]  nibble_equal, nibble_less, less_terms;\n+  logic        branch_equal, unsigned_less, signed_less;\n   logic        branch_cond;\n   logic        branch_taken;\n   logic [31:0] branch_target;\n@@ -102,14 +104,44 @@ module ex_stage (\n   logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n   /* verilator lint_on UNUSEDSIGNAL */\n \n+  // All local comparisons read the same forwarded operands in parallel.\n+  // Each less-than term requires equality only in the more significant\n+  // nibbles; fixed reductions avoid a serial comparison-result cascade.\n+  for (genvar nibble = 0; nibble < 8; nibble++) begin : g_branch_nibble\n+    logic [3:0] a, b, equal_bits, bit_terms;\n+    assign a = rs1[nibble*4 +: 4];\n+    assign b = rs2[nibble*4 +: 4];\n+    assign equal_bits = ~(a ^ b);\n+    assign nibble_equal[nibble] = &equal_bits;\n+    assign bit_terms[3] = ~a[3] & b[3];\n+    assign bit_terms[2] = equal_bits[3] & ~a[2] & b[2];\n+    assign bit_terms[1] = (&equal_bits[3:2]) & ~a[1] & b[1];\n+    assign bit_terms[0] = (&equal_bits[3:1]) & ~a[0] & b[0];\n+    assign nibble_less[nibble] = (bit_terms[3] | bit_terms[2]) |\n+                                 (bit_terms[1] | bit_terms[0]);\n+  end\n+  assign less_terms[7] = nibble_less[7];\n+  assign less_terms[6] = nibble_equal[7]   & nibble_less[6];\n+  assign less_terms[5] = (&nibble_equal[7:6]) & nibble_less[5];\n+  assign less_terms[4] = (&nibble_equal[7:5]) & nibble_less[4];\n+  assign less_terms[3] = (&nibble_equal[7:4]) & nibble_less[3];\n+  assign less_terms[2] = (&nibble_equal[7:3]) & nibble_less[2];\n+  assign less_terms[1] = (&nibble_equal[7:2]) & nibble_less[1];\n+  assign less_terms[0] = (&nibble_equal[7:1]) & nibble_less[0];\n+  assign unsigned_less = ((less_terms[7] | less_terms[6]) |\n+                          (less_terms[5] | less_terms[4])) |\n+                         ((less_terms[3] | less_terms[2]) |\n+                          (less_terms[1] | less_terms[0]));\n+  assign branch_equal = &nibble_equal;\n+  assign signed_less = (rs1[31] ^ rs2[31]) ? rs1[31] : unsigned_less;\n+\n   always_comb begin\n-    case (in.ctrl.branch_op)\n-      BR_BEQ:  branch_cond = (rs1 == rs2);\n-      BR_BNE:  branch_cond = (rs1 != rs2);\n-      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n-      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n-      BR_BLTU: branch_cond = (rs1 <  rs2);\n-      BR_BGEU: branch_cond = (rs1 >= rs2);\n+    // Registered funct3 bits choose equality/signed/unsigned, then bit 0\n+    // inverts BEQ/BLT/BLTU for BNE/BGE/BGEU. Values 2 and 3 stay false.\n+    case (in.ctrl.branch_op[2:1])\n+      2'b00: branch_cond = branch_equal  ^ in.ctrl.branch_op[0];\n+      2'b10: branch_cond = signed_less   ^ in.ctrl.branch_op[0];\n+      2'b11: branch_cond = unsigned_less ^ in.ctrl.branch_op[0];\n       default: branch_cond = 1'b0;\n     endcase\n     branch_taken  = in.ctrl.is_branch && branch_cond;\n","exit_code":0,"status":"completed"}}
