{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/e2005e29/497045f1/r9probe');q=p/'group_correct';shutil.copytree(p/'group_shift',q/'rtl',dirs_exist_ok=True);shutil.copytree(Path.cwd()/'cores/bench/test',q/'test',dirs_exist_ok=True)\nf=q/'test/test_alu.py';s=f.read_text();anchor='@cocotb.test()\\\\nasync def add';s=s.replace(anchor,'''@cocotb.test()\nasync def all_shift_groups_and_masking(dut):\n    await _setup(dut)\n    rng = random.Random(9030)\n    operands = [0, 1, 0xFFFFFFFF, 0x80000000, 0x7FFFFFFF, 0xAAAAAAAA, 0x55555555]\n    operands += [1 << i for i in range(32)] + [rng.getrandbits(32) for _ in range(200)]\n    for a in operands:\n        for n in range(32):\n            b = n | (rng.getrandbits(27) << 5)\n            await _check(dut, ALU_SLL, a, b, a << n)\n            await _check(dut, ALU_SRL, a, b, a >> n)\n            await _check(dut, ALU_SRA, a, b, _signed(a) >> n)\n\n'''+anchor);f.write_text(s)\nold=(Path.cwd()/'cores/bench/rtl/alu.sv').read_text().replace('module alu (','module alu_old (');new=(p/'group_shift/alu.sv').read_text().replace('module alu (','module alu_new (');pkg=(Path.cwd()/'cores/bench/rtl/core_pkg.sv').read_text()\nmiter='''\nmodule shift_miter(input [31:0] a,b, input [1:0] mode, output equal_result);\nwire [4:0] op = mode == 0 ? ALU_SLL : mode == 1 ? ALU_SRL : ALU_SRA;\nwire [31:0] old_out,new_out;\nalu_old u_old(.clock(1'b0),.reset(1'b0),.op(op),.a(a),.b(b),.out(old_out),\n .mul_req_valid(1'b0),.mul_result_ready(1'b0),.div_req_valid(1'b0),.div_result_ready(1'b0));\nalu_new u_new(.clock(1'b0),.reset(1'b0),.op(op),.a(a),.b(b),.out(new_out),\n .mul_req_valid(1'b0),.mul_result_ready(1'b0),.div_req_valid(1'b0),.div_result_ready(1'b0));\nassign equal_result = old_out == new_out;\nendmodule\n'''\n(p/'shift_miter.sv').write_text(pkg+'\\\\n'+old+'\\\\n'+new+miter)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
