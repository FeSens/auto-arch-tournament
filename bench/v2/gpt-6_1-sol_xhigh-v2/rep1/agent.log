{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/e2005e29/cd5ac3c3/r7s0_probe')\ndst=root/'rtl_address'\nshutil.copytree(Path('cores/bench/rtl'),dst,dirs_exist_ok=True)\np=dst/'core_pkg.sv';s=p.read_text();s=s.replace('    logic [31:0] write_data;     // raw rs2', '    logic [31:0] effective_addr; // dedicated memory-only address result\\\\n    logic [31:0] write_data;     // raw rs2');p.write_text(s)\np=dst/'ex_stage.sv';s=p.read_text().replace('    fast_instruction.write_data    = rs2;', '    fast_instruction.effective_addr = rs1 + in.imm;\\\\n    fast_instruction.write_data    = rs2;');p.write_text(s)\np=dst/'mem_stage.sv';s=p.read_text().replace('in.alu_result[','in.effective_addr[').replace('dmem_addr  = in.alu_result;', 'dmem_addr  = in.effective_addr;');p.write_text(s)\nprint(dst)\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval import gowin\nimport json\nroot=Path('/srv/hwebench/tmp/e2005e29/cd5ac3c3/r7s0_probe')\nr=gowin.build_all(Path.cwd(),root/'rtl_address','fpga/core_bench_si.sv',root/'timing_address')\n(root/'timing_address_result.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(gowin.summarize(r),indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
