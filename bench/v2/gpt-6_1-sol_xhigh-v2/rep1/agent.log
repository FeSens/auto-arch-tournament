{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport json,yaml\np=Path('cores/bench/experiments/hypotheses/hyp-20260930-001-r8s0.yaml')\nh=yaml.safe_load(p.read_text())\nold='''These are prototype results, not an accepted tournament evaluation.\n'''\nnew='''All eight selftest/random1/random2/random3 trace-cosim cases pass,\nincluding combined imem/dmem stalls. The unchanged run_coremark_ipc\nvalidator passes canonical CRCs, UART, memory bounds and timing markers,\ncompleting ten iterations in exactly 4,193,876 bracketed cycles. These\nare prototype results, not an accepted tournament evaluation. An isolated\ncopy of the unchanged formal runner, wrapper, checks and upstream\nframework is checking this prototype; full formal completion remains\nrequired during implementation.\n'''\nassert old in h['hypothesis'];h['hypothesis']=h['hypothesis'].replace(old,new)\nclass BlockDumper(yaml.SafeDumper):pass\ndef represent_str(dumper,value):return dumper.represent_scalar('tag:yaml.org,2002:str',value,style='|' if '\\\\n' in value else None)\nBlockDumper.add_representer(str,represent_str)\np.write_text(yaml.dump(h,Dumper=BlockDumper,sort_keys=False,width=80))\nprint('Updated prototype verification evidence.')\nf=Path('cores/bench/generated/r8s0_operand_flat/formal')\nlogs=list(f.glob('last_run-*.log'))\nfor l in logs:\n s=l.read_text(errors='replace')\n print('Formal progress:',s.count('DONE (PASS'), 'passing tasks,',s.count('DONE (FAIL'),'failing tasks')\n print('\\\\n'.join(s.splitlines()[-5:]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
