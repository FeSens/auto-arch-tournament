ocol.\"\"\"\n    if op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        await _check_mul(dut, op, a, b, expected)\n        return\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op\n…[13291 of 16363 chars elided by tools/bench/transcript.py; sha256:3fbaa891f250aff5]…\n_tick(dut)\n            assert int(dut.mul_result_valid.value) == 0\n            dut.reset.value = 0\n            await Timer(1, \"ns\")\n            assert int(dut.mul_req_ready.value) == int(dut.div_req_ready.value) == 1\n            for _ in range(4):\n                await _tick(dut)\n                assert int(dut.mul_result_valid.value) == 0\n            await _check_mul(dut, ALU_MUL, 11, 13, 143)\n\n\n@cocotb.test()\nasync def nonmultiply_request_does_not_start_multiplier(dut):\n    await _setup(dut)\n    dut.mul_req_valid.value = 1\n    for op in (ALU_ADD, ALU_SUB, ALU_DIV):\n        dut.op.value = op\n        await _tick(dut)\n        assert int(dut.mul_req_ready.value) == 1\n        assert int(dut.mul_result_valid.value) == 0\n    dut.mul_req_valid.value = 0\n    await _check_mul(dut, ALU_MUL, 17, 19, 323)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_ex_stage.py'", "aggregated_output": "\"\"\"Execute-stage blocking arithmetic, completion backpressure and redirects.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (ALU_ADD, ALU_SUB, ALU_XOR, ALU_LUI, ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n                      ALU_DIV, ALU_REMU, run_cocotb)\n\n\n# Packed port layouts from core_pkg.sv, in declaration order.\nCTRL = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3),\n        (\"is_branch\", 1), (\"is_jump\", 1), (\"is_jalr\", 1),\n        (\"is_lui\", 1), (\"is_auipc\", 1), (\"mem_read\", 1),\n        (\"mem_write\", 1), (\"mem_width\", 2), (\"mem_sext\", 1),\n        (\"reg_write\", 1), (\"mem_to_reg\", 1), (\"is_illegal\", 1)]\nID_EX = [(\"pc\", 32), (\"predicted_next_pc\", 32),\n         (\"rs1_val\", 32), (\"rs2_val\", 32),\n         (\"fwd_rs1_sel\", 3), (\"fwd_rs2_sel\", 3), (\"imm\", 32),\n         (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"ctrl\", 22),\n         (\"instr\", 32), (\"valid\", 1)]\nEX_MEM = [(\"pc\", 32), (\"alu_result\", 32), (\"effective_address\", 32), (\"write_data\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"branch_taken\", 1), (\"branch_target\", 32), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\nUPDATE = [(\"valid\", 1), (\"allocate\", 1), (\"unconditional\", 1),\n          (\"taken\", 1), (\"pc\", 32), (\"target\", 32)]\n\n\ndef _pack(layout, **values):\n    if layout is ID_EX:\n        values = {\"fwd_rs1_sel\": 4, \"fwd_rs2_sel\": 4, **values}\n    result = 0\n    for name, width in layout:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(layout, value):\n    fields = {}\n    for name, width in reversed(layout):\n        fields[name] = value & ((1 << width) - 1)\n        value >>= width\n    assert value == 0\n    return fields\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n…[19890 of 22962 chars elided by tools/bench/transcript.py; sha256:61552a1d1915ad41]…\nert int(dut.out.value) == owner, \"owner must still be available to MEM at acceptance\"\n            await _tick(dut)\n            assert int(dut.out.value) == 0 and int(dut.redirect.value) == 0\n            assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n            getattr(dut, \"in\").value = 0\n            await _tick(dut)\n            assert _unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0\n\n    # Reset also cancels pending recovery while downstream remains stalled.\n    await _setup(dut)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=0x40, predicted_next_pc=0x100, valid=1)\n    await _tick(dut)\n    assert int(dut.redirect.value) == 1\n    dut.stall.value = dut.reset.value = 1\n    await _tick(dut)\n    assert int(dut.redirect.value) == 0 and int(dut.out.value) == 0\n    assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
