{"type": "item.completed", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"tail -n 1 cores/bench/generated/hypgen/timing_loop64.log; cp cores/bench/rtl/if_stage.sv cores/bench/generated/hypgen/loop64_if_stage.sv; sed -n '1,150p' cores/bench/rtl/if_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. A one-entry fall-through skid buffer captures\n// ready fetches while ID is held. The empty-buffer path remains combinational\n// so ID/EX can accept the current fetch without an extra pipeline cycle.\n//\n// The tagged next-PC table reads only the registered fetch PC.\n// Each queued token retains the exact prediction used to advance fetch.\n// Recovery cancels the queue; ID kills validity and side effects rather than\n// putting recovery on the decode data path.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // offered ID token backpressure\n  input  logic              imem_ready,\n  input  logic              redirect,         // EX prediction mismatch\n  input  logic [31:0]       redirect_target,\n  input  predictor_update_t update,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] predicted_next_pc;\n  logic [63:0] valid_q;\n  logic [23:0] tags [0:63];\n  logic [29:0] targets [0:63];\n  logic unconditional [0:63];\n  logic [1:0] counters [0:63];\n  logic [5:0] lookup_index, update_index;\n  logic lookup_hit, update_hit;\n  if_id_t fetch_token, skid_q;\n  logic fetch_accept;\n  localparam integer LOOP_WORDS = 64;\n  localparam integer LOOP_BITS = $clog2(LOOP_WORDS);\n  predictor_update_t discovery_q;\n  logic loop_valid_q;\n  logic [31:0] loop_base_q, loop_end_q;\n  logic [LOOP_WORDS-1:0] loop_filled_q;\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] loop_words [0:LOOP_WORDS-1];\n  logic [31:0] discovery_span;\n  logic discovery_eligible, discovery_replaces, in_loop, replay_hit;\n  logic [LOOP_BITS-1:0] loop_index;\n  logic fence_i;\n\n  assign fence_i = update.valid && update.fe\n…[2972 of 6044 chars elided by tools/bench/transcript.py; sha256:a93840146b5a16eb]…\n while ID is held. A full entry can\n  // accept only when its head drains, replacing that head at the same edge.\n  // Neither the queue nor ID consumes the same raw fetch twice.\n  assign fetch_accept = (imem_ready || replay_hit) && (!skid_q.valid || !stall);\n\n  // Recovery overrides a full queue and an unavailable imem bus. EX holds\n  // defer recovery until advancement; no redirect is lost under dmem or\n  // arithmetic backpressure. Only an accepted fetch advances on prediction.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (fetch_accept) pc <= predicted_next_pc;\n  end\n\n  // Redirect discards both the queued younger instruction and any same-edge\n  // raw fetch. Queue ownership depends only on this narrow validity bit.\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      skid_q.valid <= 1'b0;\n    end else if (fetch_accept) begin\n      skid_q.valid <= skid_q.valid || stall;\n    end else if (!stall) begin\n", "exit_code": 0, "status": "completed"}}
