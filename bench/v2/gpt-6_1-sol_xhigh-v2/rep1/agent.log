on\",\n  \"outcome\": \"regression\",\n  \"fitness\": 119.6,\n  \"delta_pct\": 0.48,\n  \"fmax_mhz\": 48.612,\n  \"cycles\": 4064411,\n  \"lut4\": 3693,\n  \"lutram\": 32,\n  \"bsram\": 8,\n  \"ff\": 1074,\n  \"critical_path\": {\n    \"from\": \"cpu/u_rf/regs_regs_0_0_s0\",\n    \"to\": \"dmem_1_dmem_1_0_0_s\",\n    \"slack_ns\": -15.597,\n    \"arrival_ns\": 25.892,\n    \"logic_cells\": 16,\n    \"modules\": [\n      \"clock_ibuf\",\n      \"cpu/u_id\",\n      \"cpu/u_ex\",\n      \"cpu/u_ex/u_alu\",\n      \"cpu/u_ex\"\n    ]\n  },\n  \"error\": null\n}\n{\n  \"id\": \"hyp-20260929-003-r4s2\",\n  \"title\": \"Predictor-guided fall-through fetch skid buffer\",\n  \"outcome\": \"improvement\",\n  \"fitness\": 137.7,\n  \"delta_pct\": 6.32,\n  \"fmax_mhz\": 56.873,\n  \"cycles\": 4130235,\n  \"lut4\": 3373,\n  \"lutram\": 8,\n  \"bsram\n…[8300 of 11372 chars elided by tools/bench/transcript.py; sha256:537b2bddc7e794f1]…\np-20260930-003-r12s2/formal/riscv-formal/cores/bench-hdd4add2c8b194f2/checks/<check>/logfile.txt\\n/srv/hwebench/clones/gpt-6_1-sol_xhigh-v2-rep1/cores/bench/worktrees/hyp-20260930-003-r12s2/formal/run_all.sh: line 204: 3414153 Killed                     make -j\\\"$JOBS\\\" -k -f makefile 2>&1\\n     3414154                          | tee -a \\\"$LOG\\\"\\n     3414155                          | grep -E \\\"^(make|SBY|yosys|==|ERROR)\\\"\"\n}\n{\n  \"id\": \"hyp-20260930-003-r13s2\",\n  \"title\": \"Validate predicted successors with parallel carry consistency\",\n  \"outcome\": \"regression\",\n  \"fitness\": 220.65,\n  \"delta_pct\": -1.25,\n  \"fmax_mhz\": 92.538,\n  \"cycles\": 4193876,\n  \"lut4\": 3752,\n  \"lutram\": 32,\n  \"bsram\": 7,\n  \"ff\": 1188,\n  \"critical_path\": {\n    \"from\": \"cpu/u_id/reg_q.alu_b_sel_2_s0\",\n    \"to\": \"cpu/u_ex/reg_q.alu_result_5_s0\",\n    \"slack_ns\": -6.379,\n    \"arrival_ns\": 16.673,\n    \"logic_cells\": 13,\n    \"modules\": [\n      \"clock_ibuf\",\n      \"cpu/u_ex\",\n      \"cpu/u_ex/u_al