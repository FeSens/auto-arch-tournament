{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport collections, json, pathlib, struct, subprocess, sys, tempfile, time\nsys.dont_write_bytecode = True\nsys.path.insert(0, str(pathlib.Path('test/cosim').resolve()))\nfrom reference import RV32IM\noutdir = pathlib.Path(tempfile.mkdtemp(prefix='predictor-profile-', dir='/srv/hwebench/tmp/e2005e29/1012a11b'))\nelf = outdir / 'coremark.elf'\nsources = ['core_list_join.c', 'core_main.c', 'core_matrix.c', 'core_state.c', 'core_util.c']\ncmd = ['riscv32-unknown-elf-gcc', '-march=rv32im', '-mabi=ilp32', '-O3', '-static', '-nostartfiles', '-specs=nano.specs', '-specs=nosys.specs', '-T', 'bench/programs/link.ld', '-Ibench/programs/coremark', '-Ibench/programs/coremark/baremetal', '-DTOTAL_DATA_SIZE=2000']\ncmd += ['bench/programs/coremark/' + source for source in sources]\ncmd += ['bench/programs/coremark/baremetal/core_portme.c', 'bench/programs/crt0.S', '-o', str(elf)]\nsubprocess.run(cmd, check=True, capture_output=True, text=True)\ncpu = RV32IM()\ncpu.load_elf(str(elf))\nsizes = [16, 32, 64, 128, 256]\ntables = {size: [None] * size for size in sizes}\nmisses = collections.Counter()\nhits = collections.Counter()\nevictions = collections.Counter()\ncounts = collections.Counter()\nactive = False\nstart = time.monotonic()\nfor k in range(10000000):\n    record = cpu.step()\n    pc, npc, instr = record['pc'], record['npc'], record['insn']\n    op = instr & 127\n    is_control = op in (0x63, 0x6f, 0x67) and not record['trap']\n    taken = npc \"'!= ((pc + 4) & 0xffffffff)\n    if op == 0x63:\n        immediate = ((instr >> 31) << 12) | (((instr >> 7) & 1) << 11) | (((instr >> 25) & 63) << 5) | (((instr >> 8) & 15) << 1)\n        immediate -= (1 << 13) if immediate & (1 << 12) else 0\n        target = (pc + immediate) & 0xffffffff\n    else:\n        target = npc\n    if active:\n        counts['\"'instructions'] += 1\n        counts['baseline_redirects'] += is_control and taken\n        if is_control:\n            counts[{0x63: 'branch', 0x6f: 'jal', 0x67: 'jalr'}[op]] += 1\n            counts['taken_controls'] += taken\n        counts['load'] += op == 0x03\n        counts['store'] += op == 0x23\n    for size in sizes:\n        index = (pc >> 2) & (size - 1)\n        entry = tables[size][index]\n        hit = entry is not None and entry[0] == pc\n        predicted = entry[1] if hit and (entry[2] or entry[3] >= 2) else (pc + 4) & 0xffffffff\n        if active:\n            misses[size] += predicted \"'!= npc\n            hits[size] += hit and is_control\n        if is_control and not (target & 3):\n            unconditional = op != 0x63\n            if hit:\n                counter = min(3, entry[3] + 1) if taken else max(0, entry[3] - 1)\n            else:\n                counter = 2 if taken else 1\n                if active:\n                    evictions[size] += entry is not None\n            tables[size][index] = (pc, target, unconditional, counter)\n        elif hit:\n            tables[size][index] = None\n    if record['\"'mem_wmask'] and record['mem_addr'] == 0x10000100:\n        active = True\n    if record['mem_wmask'] and record['mem_addr'] == 0x10000104:\n        break\n    if k and k % 500000 == 0:\n        print(json.dumps({'progress_insns': k, 'seconds': round(time.monotonic()-start, 1)}), flush=True)\nelse:\n    raise RuntimeError('Stop marker not reached')\nassert not cpu.oob_access\nbaseline_cycles = 4491485\nresult = {'profile_kind': 'architectural trace, immediate predictor training, no pipeline or bus timing', 'counts': dict(counts), 'table_profiles': {size: {'next_pc_errors': misses[size], 'control_hits': hits[size], 'control_evictions': evictions[size], 'estimated_redirects_saved': counts['baseline_redirects'] - misses[size], 'ideal_fitness_gain_pct_at_same_fmax': round(100 * (baseline_cycles / (baseline_cycles - counts['baseline_redirects'] + misses[size]) - 1), 2)} for size in sizes}, 'elapsed_seconds': round(time.monotonic()-start, 1)}\nprint(json.dumps(result, indent=2), flush=True)\n(outdir / 'profile.json').write_text(json.dumps(result, indent=2))\nprint(str(outdir / 'profile.json'))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
