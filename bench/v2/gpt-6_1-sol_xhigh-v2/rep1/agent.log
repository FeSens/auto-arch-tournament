{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nrng=random.Random(0x20260930)\nmask=0xffffffff\nfor k in range(200000):\n a=rng.getrandbits(32);imm=rng.randrange(-2048,2048)\n target=((a+imm)&mask)&~1\n pred=target if k%3==0 else rng.getrandbits(32)\n base0=(pred-imm)&mask;base1=(pred+1-imm)&mask\n inverse=(pred&1)==0 and (a==base0 or a==base1)\n assert inverse==(target==pred),(a,imm,pred)\nfor a in [0,1,2,3,0x7fffffff,0x80000000,0xfffffffd,0xfffffffe,0xffffffff]:\n for imm in range(-2048,2048):\n  target=((a+imm)&mask)&~1\n  for pred in [target,target|1,(target+2)&mask,(target-2)&mask]:\n   assert (((pred&1)==0) and (a==((pred-imm)&mask) or a==((pred+1-imm)&mask)))==(target==pred)\nprint('JALR inverse successor predicate: 200,000 random cases and signed-immediate boundary sweep passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
