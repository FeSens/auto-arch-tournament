s/eval/cosim.py:70:def run_coremark_crc(coremark_elf: Path, sim_bin: str, worktree: str, env: dict | None = None) -> dict:\ntools/eval/cosim.py:113:                'detail': 'maxcycles hit before ebreak'}\ntools/eval/cosim.py:125:def run_cosim(worktree: str, target: str | None = None) -> dict:\ntest/cosim/main.cpp:63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\ntest/cosim/main.cpp:66:    uint64_t maxcycles = argc > 2 ? atoll(argv[2]) : 50000000ULL;\ntest/cosim/main.cpp:70:    //           (tools/eval/fpga.py:run_coremark_ipc) passes BOTH so the\ntest/cosim/main.cpp:113:    for(uint64_t cycle=0; cycle<maxcycles; cycle++) {\ntest/cosim/main.cpp:255:        // benchmark hit maxcycles without completing and the reading is invalid.\ntest/cosim/main.cpp:267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n","exit_code":0,"status":"completed"}}
