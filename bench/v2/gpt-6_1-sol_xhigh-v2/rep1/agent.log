{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nscratch=Path('/srv/hwebench/tmp/e2005e29/b0edac33/r7s1-effectsplit')\n(scratch/'stale_memory.S').write_text('''.section .text\n.globl _start\n_start:\n    la s0, function\n    lw s2, 0(s0)\n    li s3, 0x00052283\n    la a0, data_word\n    li s4, 100\n    li t6, 1234\nloop:\n    sw s2, 0(s0)\n    fence.i\n    jal ra, function\n    sw s3, 0(s0)\n    fence.i\n    li t0, 0\n    jal ra, function\n    bne t0, t6, fail\n    addi s4, s4, -1\n    bne s4, zero, loop\n    ebreak\nfail:\n    li a1, 0x10000000\n    li a2, 70\n    sb a2, 0(a1)\n    ebreak\nfunction:\n    jal zero, target\n    jalr zero, 0(ra)\ntarget:\n    jalr zero, 0(ra)\n.section .data\n.align 2\ndata_word:\n    .word 1234\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
