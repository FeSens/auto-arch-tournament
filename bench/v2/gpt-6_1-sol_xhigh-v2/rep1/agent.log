{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"cat > cores/bench/generated/probe_shift_two.py <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nfrom itertools import permutations\nimport shutil,json,time\nfrom tools.eval.gowin import build_all,summarize\nwt=Path.cwd();root=wt/'cores/bench/generated/shift_two';root.mkdir(exist_ok=True)\ns=(wt/'cores/bench/rtl/alu.sv').read_text();start=s.index('  logic [3:0] low_sel, mid_sel;');end=s.index('  localparam logic [1:0] MUL_IDLE')\ndef code(groups):\n lines=['  logic fill;', '  assign fill = (op == ALU_SRA) && a[31];'];left=right='a'\n for stage,(offset,width) in enumerate(groups):\n  l=f'left{stage}';r=f'right{stage}';sel=f'sel{stage}';count=1<<width\n  lines += [f'  logic [31:0] {l}, {r};',f'  logic [{count-1}:0] {sel};',f\\\"  assign {sel} = {count}'b1 << b[{offset+width-1}:{offset}];\\\"]\n  ls=[];rs=[]\n  for digit in range(count):\n   sh=digit<<offset;la=left if sh==0 else f\\\"{{{left}[{31-sh}:0], {sh}'b0}}\\\";ra=right if sh==0 else f'{{{{{sh}{{fill}}}}, {right}[31:{sh}]}}'\n   ls.append(f'({{32{{{sel}[{digit}]}}}} & {la})');rs.append(f'({{32{{{sel}[{digit}]}}}} & {ra})')\n  lines += [f'  assign {l} = '+' | '.join(ls)+';',f'  assign {r} = '+' | '.join(rs)+';'];left=l;right=r\n return '\\\\n'.join(lines+[f'  wire [31:0] left_word = {left};',f'  wire [31:0] right_word = {right};',''])\nvariants=[]\nfor widths in [(3,2),(2,3)]:\n groups=[(0,widths[0]),(widths[0],widths[1])]\n for order in permutations(groups):\n  name='g'+'_'.join(f'{o}x{w}' for o,w in order);p=root/name;r=p/'rtl';r.mkdir(parents=True,exist_ok=True)\n  for f in (wt/'cores/bench/rtl').glob('*.sv'):shutil.copy2(f,r/f.name)\n  (r/'alu.sv').write_text(s[:start]+code(order)+s[end:]);variants.append((name,p))\ndef measure(v):\n name,p=v;t=time.time();rs=build_all(wt,p/'rtl','fpga/core_bench_si.sv',p/'timing');x={'name':name,'elapsed_s':time.time()-t,'results':rs,'summary':summarize(rs)}\n (p/'timing_result.json').write_text(json.dumps(x,indent=2));return x\nresults=[]\nwith ThreadPoolExecutor(max_workers=2) as pool:\n for f in as_completed([pool.submit(measure,v) for v in variants]):\n  x=f.result();results.append(x);print(json.dumps({'name':x['name'],'elapsed_s':x['elapsed_s'],'summary':x['summary']}),flush=True);(root/'results.json').write_text(json.dumps(results,indent=2))\nPY\nPYTHONPATH=. python cores/bench/generated/probe_shift_two.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
