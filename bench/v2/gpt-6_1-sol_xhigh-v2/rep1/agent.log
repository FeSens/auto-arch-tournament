{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('cores/bench/generated/micro_probe')\nhelper='''module fast_add32(input logic [31:0] a, b, output logic [31:0] sum);\nlogic [3:0] g, p;\nlogic [3:0] c;\nlogic [8:0] z[0:3], o[0:3];\ngenvar i;\ngenerate for(i=0;i<4;i=i+1) begin : chunks\nassign z[i] = {1'b0,a[i*8+:8]} + {1'b0,b[i*8+:8]};\nassign o[i] = {1'b0,a[i*8+:8]} + {1'b0,b[i*8+:8]} + 9'd1;\nassign g[i] = z[i][8];\nassign p[i] = &(a[i*8+:8] \"'^ b[i*8+:8]);\nassign sum[i*8+:8] = c[i] ? o[i][7:0] : z[i][7:0];\nend endgenerate\nassign c[0] = 1'\"'b0;\nassign c[1] = g[0];\nassign c[2] = g[1] | (p[1] & g[0]);\nassign c[3] = g[2] | (p[2] & g[1]) | (p[2] & p[1] & g[0]);\nendmodule\n'''\nfor name in ['add_ex','add_alu']:\n d=p/name/'rtl'; shutil.copytree(p/'baseline/rtl',d,dirs_exist_ok=True); (d/'fast_add32.sv').write_text(helper)\n if name=='add_ex':\n  f=d/'ex_stage.sv'; s=f.read_text(); s=s.replace('  always_comb begin\\\\n    case (in.ctrl.branch_op)', '''  logic [31:0] fast_pc_imm, fast_rs1_imm;\n  fast_add32 pc_add(.a(in.pc),.b(in.imm),.sum(fast_pc_imm));\n  fast_add32 rs_add(.a(rs1),.b(in.imm),.sum(fast_rs1_imm));\n\n  always_comb begin\n    case (in.ctrl.branch_op)''',1)\n  s=s.replace('in.pc + in.imm','fast_pc_imm').replace('rs1 + in.imm','fast_rs1_imm')\n else:\n  f=d/'alu.sv'; s=f.read_text(); old='  always_comb begin\\\\n    case (op)'\n  s=s.replace(old,'''  logic [31:0] fast_add_result;\n  fast_add32 ordinary_add(.a(a),.b(b),.sum(fast_add_result));\n\n'''+old,1).replace('ALU_ADD:    out = a + b;','ALU_ADD:    out = fast_add_result;')\n f.write_text(s)\nprint('Prepared carry-select addition with parallel byte carries')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
