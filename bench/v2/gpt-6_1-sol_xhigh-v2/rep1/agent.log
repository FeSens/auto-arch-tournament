c_cells\": 13, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}, {\"from\": \"cpu/u_id/reg_q.alu_a_sel_0_s0\", \"to\": \"dmem_1_dmem_1_0_0_s\", \"slack_ns\": -8.784, \"arrival_ns\": 19.079, \"logic_cells\": 12, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}, {\"from\": \"cpu/u_id/reg_q.alu_a_sel_0_s0\", \"to\": \"dmem_0_dmem_0_0_0_s\", \"slack_ns\": -8.784, \"arrival_ns\": 19.079, \"logic_cells\": 12, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}, {\"from\": \"cpu/u_id/reg_q.pc_30_s0\", \"to\": \"dmem_2_dmem_2_0_0_s\", \"slack_ns\": -8.756, \"arrival_ns\": 19.051, \"logic_cells\": 13, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}, {\"from\": \"cpu/u_id/reg_q.alu_a_sel_0_s0\", \"to\": \"dmem_2_dmem_2_0_0_s\", \"slack_ns\": -8.756, \"arrival_ns\": 19.051, \"logic_cells\": 12, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}]}\ngroup_result {\"place_option\": 0, \"placement_failed\": false, \"fmax_mhz\": 69.171, \"levels\": 15, \"logic\": 3404, \"regs\": 1027, \"lutram\": 32, \"bsram\": 7, \"dsp\": 2, \"critical_paths\": [{\"from\": \"cpu/u_id/reg_q.rs1_val_22_s0\", \"to\": \"dmem_1_dmem_1_0_0_s\", \"slack_ns\": -9.457, \"arrival_ns\": 19.752, \"logic_cells\": 15, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}, {\"from\": \"cpu/u_id/reg_q.rs1_val_22_s0\", \"to\": \"dmem_0_dmem_0_0_0_s\", \"slack_ns\": -9.457, \"arrival_ns\": 19.752, \"logic_cells\": 15, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}, {\"from\": \"cpu/u_id/reg_q.fwd_rs1_sel_2_s1\", \"to\": \"cpu/u_if/counters_counters_RAMREG_35_G[1]_s1\", \"slack_ns\": -9.456, \"arrival_ns\": 19.75, \"logic_cells\": 39, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\"]}, {\"from\": \"cpu/u_id/reg_q.fwd_rs1_sel_2_s1\", \"to\": \"cpu/u_if/counters_counters_RAMREG_7_G[1]_s1\", \"slack_ns\": -9.456