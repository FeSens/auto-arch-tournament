{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"head -35 cores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.timing_paths; cat cores/bench/rtl/reg_file.sv; rg -n 'WARN|ERROR' cores/bench/generated/timing/gowin_p0/gw.log\"","aggregated_output":"head: cannot open 'cores/bench/generated/timing/gowin_p0/impl/pnr/core_bench.timing_paths' for reading: No such file or directory\n// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// x1..x31 are independently enabled fabric flop words with synchronous\n// zero reset. Constant word addresses and decoded, balanced read trees\n// avoid RAM inference, keeping the existing ID/EX operand flops as the\n// boundary between register selection and execution.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  wire [31:0] rs1_l0 [0:31], rs2_l0 [0:31];\n  wire [31:0] rs1_l1 [0:15], rs2_l1 [0:15];\n  wire [31:0] rs1_l2 [0:7], rs2_l2 [0:7];\n  wire [31:0] rs1_l3 [0:3], rs2_l3 [0:3];\n  wire [31:0] rs1_l4 [0:1], rs2_l4 [0:1];\n  wire [31:0] rs1_l5, rs2_l5;\n\n  assign rs1_l0[0] = 32'b0;\n  assign rs2_l0[0] = 32'b0;\n\n  generate\n    for (genvar r = 1; r < 32; r++) begin : g_regs\n      localparam logic [4:0] ADDR = 5'(r);\n      logic [31:0] value_q;\n\n      always_ff @(posedge clock) begin\n        if (reset) value_q <= 32'b0;\n        else if (w_en && w_addr == ADDR) value_q <= w_data;\n      end\n\n      assign rs1_l0[r] = value_q & {32{rs1_addr == ADDR}};\n      assign rs2_l0[r] = value_q & {32{rs2_addr == ADDR}};\n    end\n\n    // Separate arrays for each reduction level expose an acyclic,\n    // complete 32-leaf binary tree on both combinational read ports.\n    for (genvar node = 0; node < 16; node++) begin : g_level1\n      assign rs1_l1[node] = rs1_l0[2*node] | rs1_l0[2*node+1];\n      assign rs2_l1[node] = rs2_l0[2*node] | rs2_l0[2*node+1];\n    end\n    for (genvar node = 0; node < 8; node++) begin : g_level2\n      assign rs1_l2[node] = rs1_l1[2*node] | rs1_l1[2*node+1];\n      assign rs2_l2[node] = rs2_l1[2*node] | rs2_l1[2*node+1];\n    end\n    for (genvar node = 0; node < 4; node++) begin : g_level3\n      assign rs1_l3[node] = rs1_l2[2*node] | rs1_l2[2*node+1];\n      assign rs2_l3[node] = rs2_l2[2*node] | rs2_l2[2*node+1];\n    end\n    for (genvar node = 0; node < 2; node++) begin : g_level4\n      assign rs1_l4[node] = rs1_l3[2*node] | rs1_l3[2*node+1];\n      assign rs2_l4[node] = rs2_l3[2*node] | rs2_l3[2*node+1];\n    end\n  endgenerate\n\n  assign rs1_l5 = rs1_l4[0] | rs1_l4[1];\n  assign rs2_l5 = rs2_l4[0] | rs2_l4[1];\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = rs1_l5;\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = rs2_l5;\n  end\n\nendmodule\n","exit_code":1,"status":"failed"}}
