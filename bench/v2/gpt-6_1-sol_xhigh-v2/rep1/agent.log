{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat formal/run_all.sh; cat cores/bench/test/conftest.py; cat cores/bench/test/_helpers.py'", "aggregated_output": "#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env vars (orchestrator-driven, override $1 and defaults):\n#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n# When BOTH are unset, the script auto-detects nret from\n# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n# invoking `bash formal/run_all.sh` directly therefore get the\n# right wrapper without needing to know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[9745 of 12817 chars elided by tools/bench/transcript.py; sha256:d219f4e925d9f016]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_mem_stage.py; sed -n '280,700p' cores/bench/test/test_ex_stage.py\"", "aggregated_output": "\"\"\"The registered address lane controls every memory and RVFI address use.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_ex_stage import CTRL, EX_MEM, _pack, _unpack, _tick\n\n\nMEM_WB = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32), (\"write_value\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"mem_addr\", 32), (\"mem_rdata\", 32), (\"mem_wdata\", 32),\n          (\"mem_wmask\", 4), (\"mem_rmask\", 4), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\n@cocotb.test()\nasync def memory_uses_address_instead_of_integer_result(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.hold_wb.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.dmem_rdata.value = 0x89ABCDEF\n    await _tick(dut)\n    dut.reset.value = 0\n    for base in (0, 0x10000100, 0xFFFFFFFC):\n        for width, offset, signed, expected in (\n            (0, 0, 1, 0xFFFFFFEF), (0, 3, 0, 0x89),\n            (1, 0, 0, 0xCDEF), (1, 2, 1, 0xFFFF89AB),\n            (2, 0, 1, 0x89ABCDEF),\n        ):\n            address = base + offset\n            mask = ((1 << (1 << width)) - 1) << offset\n            for load in (0, 1):\n                # Deliberately misalign the unrelated integer result.\n                getattr(dut, \"in\").value = _pack(\n                    EX_MEM, pc=0x40, pc_next=0x44, alu_result=0x24680001,\n                    effective_address=address, write_data=0x01234567, rd=5, valid=1,\n                    ctrl=_pack(CTRL, mem_read=load, mem_write=1-load,\n                               mem_width=width, mem_sext=signed, reg_write=load,\n                               mem_to_reg=load),\n                )\n                await Timer(1, \"ns\")\n                replicated = (0x67676767, 0x45674567, 0x01234567)[width]\n                assert int(dut.dmem_addr.value) == address\n                assert int(dut.dmem_wdata.value) == replicated\n                assert int(dut.dmem_wen.value) == (0 if load else mask)\n                assert \n…[15494 of 18566 chars elided by tools/bench/transcript.py; sha256:94e2d6e8d85fdce0]…\nert int(dut.out.value) == owner, \"owner must still be available to MEM at acceptance\"\n            await _tick(dut)\n            assert int(dut.out.value) == 0 and int(dut.redirect.value) == 0\n            assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n            getattr(dut, \"in\").value = 0\n            await _tick(dut)\n            assert _unpack(EX_MEM, int(dut.out.value))[\"valid\"] == 0\n\n    # Reset also cancels pending recovery while downstream remains stalled.\n    await _setup(dut)\n    getattr(dut, \"in\").value = _pack(ID_EX, pc=0x40, predicted_next_pc=0x100, valid=1)\n    await _tick(dut)\n    assert int(dut.redirect.value) == 1\n    dut.stall.value = dut.reset.value = 1\n    await _tick(dut)\n    assert int(dut.redirect.value) == 0 and int(dut.out.value) == 0\n    assert _unpack(UPDATE, int(dut.predictor_update.value))[\"valid\"] == 0\n\n\ndef test_ex_stage_runner():\n    run_cocotb(toplevel=\"ex_stage\", sources=[\"core_pkg.sv\", \"alu.sv\", \"ex_stage.sv\"],\n               test_module=\"test_ex_stage\")\n", "exit_code": 0, "status": "completed"}}
