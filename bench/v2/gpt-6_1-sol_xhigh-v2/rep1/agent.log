{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,200p' cores/bench/test/test_mem_stage.py\"", "aggregated_output": "\"\"\"The registered address lane controls every memory and RVFI address use.\"\"\"\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_ex_stage import CTRL, EX_MEM, _pack, _unpack, _tick\n\n\nMEM_WB = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32), (\"write_value\", 32),\n          (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n          (\"rs1_val\", 32), (\"rs2_val\", 32), (\"pc_next\", 32),\n          (\"mem_addr\", 32), (\"mem_rdata\", 32), (\"mem_wdata\", 32),\n          (\"mem_wmask\", 4), (\"mem_rmask\", 4), (\"ctrl\", 22),\n          (\"instr\", 32), (\"valid\", 1)]\n\n\n@cocotb.test()\nasync def memory_uses_address_instead_of_integer_result(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.hold_wb.value = 0\n    getattr(dut, \"in\").value = 0\n    dut.dmem_rdata.value = 0x89ABCDEF\n    await _tick(dut)\n    dut.reset.value = 0\n    for base in (0, 0x10000100, 0xFFFFFFFC):\n        for width, offset, signed, expected in (\n            (0, 0, 1, 0xFFFFFFEF), (0, 3, 0, 0x89),\n            (1, 0, 0, 0xCDEF), (1, 2, 1, 0xFFFF89AB),\n            (2, 0, 1, 0x89ABCDEF),\n        ):\n            address = base + offset\n            mask = ((1 << (1 << width)) - 1) << offset\n            for load in (0, 1):\n                # Deliberately misalign the unrelated integer result.\n                getattr(dut, \"in\").value = _pack(\n                    EX_MEM, pc=0x40, pc_next=0x44, alu_result=0x24680001,\n                    effective_address=address, write_data=0x01234567, rd=5, valid=1,\n                    ctrl=_pack(CTRL, mem_read=load, mem_write=1-load,\n                               mem_width=width, mem_sext=signed, reg_write=load,\n                               mem_to_reg=load),\n                )\n                await Timer(1, \"ns\")\n                replicated = (0x67676767, 0x45674567, 0x01234567)[width]\n                assert int(dut.dmem_addr.value) == address\n                assert int(dut.dmem_wdata.value) == replicated\n                assert int(dut.dmem_wen.value) == (0 if load else mask)\n                assert \n…[1153 of 4225 chars elided by tools/bench/transcript.py; sha256:07dc997cdeabf8a9]…\n aligned integer result must not hide an address-lane trap.\n            getattr(dut, \"in\").value = _pack(\n                EX_MEM, alu_result=0, effective_address=address, valid=1,\n                ctrl=_pack(CTRL, mem_read=load, mem_write=1-load,\n                           mem_width=width, reg_write=load, mem_to_reg=load),\n            )\n            await Timer(1, \"ns\")\n            assert int(dut.dmem_addr.value) == address\n            assert int(dut.dmem_wen.value) == int(dut.dmem_ren.value) == 0\n            assert int(dut.forward_write.value) == 0\n            await _tick(dut)\n            wb = _unpack(MEM_WB, int(dut.out.value))\n            assert wb[\"valid\"] == 1 and wb[\"mem_addr\"] == 0\n            assert wb[\"mem_rmask\"] == wb[\"mem_wmask\"] == 0\n            ctrl = _unpack(CTRL, wb[\"ctrl\"])\n            assert ctrl[\"is_illegal\"] == 1 and ctrl[\"reg_write\"] == 0\n\n\ndef test_mem_stage_runner():\n    run_cocotb(toplevel=\"mem_stage\", sources=[\"core_pkg.sv\", \"mem_stage.sv\"],\n               test_module=\"test_mem_stage\")\n", "exit_code": 0, "status": "completed"}}
