{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport sys, json, collections, time\nfrom pathlib import Path\nsys.path.insert(0, str(Path('test/cosim').resolve()))\nfrom reference import RV32IM\ncpu = RV32IM()\ncpu.load_elf('/srv/hwebench/tmp/e4e97874/39ed1bea/predictor-coremark.elf')\nsizes = (32, 64, 128)\ntables = {n: [None] * n for n in sizes}\ncounts = collections.Counter()\nmisses = collections.Counter()\nmiss_types = {n: collections.Counter() for n in sizes}\nactive = False\npending = None\nstart = time.monotonic()\nfor step in range(10000000):\n    pc = cpu.pc\n    predictions = {}\n    for n in sizes:\n        entry = tables[n][(pc >> 2) & (n - 1)]\n        predictions[n] = entry[1] if entry is not None and entry[0] == pc and (entry[3] or entry[2] >= 2) else (pc + 4) & 0xffffffff\n    if pending is not None:\n        ppc, target, taken, unconditional = pending\n        for n in sizes:\n            index = (ppc >> 2) & (n - 1)\n            entry = tables[n][index]\n            counter = (min(3, entry[2] + 1) if taken else max(0, entry[2] - 1)) if entry is not None and entry[0] == ppc else (2 if taken else 1)\n            tables[n][index] = (ppc, target, 3 if unconditional else counter, unconditional)\n    r = cpu.step()\n    if r['trap']:\n        raise RuntimeError(f\\\"unexpected trap at {pc:#x}\\\")\n    op = r['insn'] & 0x7f\n    taken = r['npc'] \"'!= (pc + 4) & 0xffffffff\n    kind = '\"'branch' if op == 0x63 else 'jal' if op == 0x6f else 'jalr' if op == 0x67 else 'normal'\n    pending = None\n    if op == 0x63:\n        insn = r['insn']\n        immediate = ((insn >> 31) << 12) | (((insn >> 7) & 1) << 11) | (((insn >> 25) & 0x3f) << 5) | (((insn >> 8) & 0xf) << 1)\n        if immediate & 0x1000:\n            immediate -= 0x2000\n        target = (pc + immediate) & 0xffffffff\n        if not target & 3:\n            pending = (pc, target, taken, False)\n    elif op in (0x6f, 0x67):\n        pending = (pc, r['npc'], True, True)\n    if active:\n        counts['instructions'] += 1\n        counts[kind] += 1\n        counts['taken_control'] += int(taken and op in (0x63, 0x6f, 0x67))\n        for n in sizes:\n            if predictions[n] \"'!= r['\"'npc']:\n                misses[n] += 1\n                miss_types[n][kind] += 1\n    if r['mem_wmask'] and r['mem_addr'] == 0x10000100:\n        active = True\n    if r['mem_wmask'] and r['mem_addr'] == 0x10000104:\n        active = False\n    if r['insn'] == 0x00100073:\n        break\nelse:\n    raise RuntimeError('reference did not finish')\nassert not cpu.oob_access\nuart = cpu.uart_buf.replace(b'\\\\x00', b'').decode(errors='replace')\nassert 'Correct operation validated.' in uart\nbase_cycles = 4491485\nresults = []\nfor n in sizes:\n    saved = counts['taken_control'] - misses[n]\n    gain = 100 * (base_cycles / (base_cycles - saved) - 1)\n    results.append({'entries':n, 'mispredictions':misses[n], 'miss_types':dict(miss_types[n]), 'net_bubbles_saved':saved, 'gain_pct_if_one_cycle_per_miss_and_unchanged_fmax':round(gain, 2)})\nprint(json.dumps({'instructions':dict(counts), 'predictors':results, 'wall_s':round(time.monotonic()-start,2), 'reference_completed':True, 'uart':uart}, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
