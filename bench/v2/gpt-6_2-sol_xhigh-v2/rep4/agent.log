{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'target_dir=/srv/hwebench/tmp/58928045/5f571fcf/fetch-queue.quYgF7\nmkdir -p \"$target_dir/agu_rtl\" &&\ncp cores/bench/rtl/*.sv \"$target_dir/agu_rtl/\" &&\npython - \"$target_dir/agu_rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\np = rtl / \\\"core_pkg.sv\\\"\ns = p.read_text().replace(\\\"logic [31:0] write_data;     // raw rs2\\\", \\\"logic [31:0] data_addr;\\\\n    logic [31:0] write_data;     // raw rs2\\\")\np.write_text(s)\np = rtl / \\\"ex_stage.sv\\\"\ns = p.read_text().replace(\\\"reg_q.write_data    <= rs2;\\\", \\\"reg_q.data_addr     <= jalr_sum;\\\\n      reg_q.write_data    <= rs2;\\\")\np.write_text(s)\np = rtl / \\\"mem_stage.sv\\\"\ns = p.read_text().replace(\\\"in.alu_result\\\", \\\"in.data_addr\\\").replace(\\\"reg_q.alu_result <= in.data_addr\\\", \\\"reg_q.alu_result <= in.alu_result\\\")\np.write_text(s)\nPY\ncat > \\\"\"'$target_dir/time.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build, summarize\ntmp, rtl, tag = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    jobs = [pool.submit(build, Path.cwd(), rtl, \\\"fpga/core_bench_si.sv\\\", i, tmp / f\\\"gowin_{tag}_{i}\\\") for i in range(3)]\n    results = []\n    for i, job in enumerate(jobs):\n        result = job.result()\n        print(f\\\"Option {i}\\\", result.get(\\\"fmax_mhz\\\"), result.get(\\\"reason\\\"), (result.get(\\\"critical_paths\\\") or [])[:2], flush=True)\n        results.append(result)\nprint(summarize(results))\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=\\\"\"'$PWD\" python \"$target_dir/time.py\" \"$target_dir\" \"$target_dir/agu_rtl\" agu'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
