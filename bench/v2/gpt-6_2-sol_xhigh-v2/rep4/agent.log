{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c 'set -e\nscratch_root=\"$TMPDIR/bench-r8s1-prototype\"\nmkdir -p \"$scratch_root\"\ncp -a cores/bench/rtl \"$scratch_root/\"\ncp -a bench \"$scratch_root/\"\npython3 - \"$scratch_root/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot=Path(sys.argv[1])\ndef edit(name, pairs):\n    p=root/name\n    data=p.read_text()\n    for old,new in pairs:\n        assert old in data, (name,old)\n        data=data.replace(old,new,1)\n    p.write_text(data)\n\nedit('core_pkg.sv', [\n    ('logic [31:0] direct_target;','logic        fetch_boundary;'),\n    ('logic [31:0] direct_target;','logic [20:0] direct_offset;\\\\n    logic        fetch_boundary;'),\n])\nedit('id_stage.sv', [\n    ('reg_q.direct_target     <= in.direct_target;', 'reg_q.direct_offset     <= imm[20:0];\\\\n      reg_q.fetch_boundary    <= in.fetch_boundary;'),\n])\nedit('ex_stage.sv', [\n    ('assign direct_target  = in.direct_target;', \\\"assign direct_target  = in.pc + {{11{in.direct_offset[20]}}, in.direct_offset};\\\"),\n    ('in.direct_target[1]', 'in.direct_offset[1]'),\n    ('\"'!direct_target[1]'\"', '\"'!in.direct_offset[1]'\"'),\n    ('(in.predicted_taken \"'!= actual_taken)'\"', '(in.fetch_boundary || in.predicted_taken \"'!= actual_taken)'\"'),\n    ('in.direct_target[1]', 'in.direct_offset[1]'),\n    ('<= in.direct_target;', '<= direct_target;'),\n])\nedit('core.sv', [\n    ('  logic        ex_advance, ex_direct_taken, ex_indirect_taken;', '  logic        ex_direct_taken, ex_indirect_taken;'),\n    ('    .ex_advance      (ex_advance),\\\\n',''),\n    ('    .advance         (ex_advance),','    .advance         (),'),\n])\nedit('if_stage.sv', [\n    ('  input  logic              ex_advance,\\\\n',''),\n    ('logic [31:0] direct_target;', 'logic        fetch_boundary;'),\n    ('SLOT_WIDTH = 95;', 'SLOT_WIDTH = 64;'),\n    ('logic        parked_q, park;', 'logic        parked_q, park;\\\\n  logic        predicted_window_q, predicted_last_q;\\\\n  logic        seq_window_q, seq_last_q, dir_window_q, dir_last_q;\\\\n  logic        request_window, request_last, seq_next_window, seq_next_last;'),\n    ('assign recovery_pending = redirect || (parked_q && ex_advance);','assign recovery_pending = redirect;'),\n    ('    select_sequential_q      <=','    seq_window_q <= (ex_sequential_pc[31:20] == 12\\\\'b0);\\\\n    seq_last_q <= (ex_sequential_pc == LAST_MAPPED_PC);\\\\n    dir_window_q <= (ex_direct_target[31:20] == 12\\\\'b0);\\\\n    dir_last_q <= (ex_direct_target == LAST_MAPPED_PC);\\\\n    select_sequential_q      <='),\n    ('parked_q           <= park || (parked_q && \"'!ex_advance);'\"','parked_q           <= park || (parked_q && \"'!recovery_pending_q);'\"'),\n    ('  logic [31:0] sequential_pc, direct_target;', '''  assign request_window = (\"'!recovery_pending_q && predicted_window_q)\n                        || (select_sequential_q && seq_window_q)\n                        || (select_direct_q && dir_window_q)\n                        || (select_indirect_q && mem_indirect_target[31:20] == 12'\"'b0);\n  assign request_last = (\"'!recovery_pending_q && predicted_last_q)\n                      || (select_sequential_q && seq_last_q)\n                      || (select_direct_q && dir_last_q)\n                      || (select_indirect_q && mem_indirect_target == LAST_MAPPED_PC);\n\n  logic [31:0] sequential_pc;'\"'''),\n    ('  logic [18:0] word_offset;', '  logic [17:0] word_offset;'),\n    (\\\"\\\"\\\"  logic [18:0] target_low;\n  logic [10:0] pc_high, pc_high_inc, pc_high_dec, target_high;\n  logic        target_high_zero;\\\"\\\"\\\", \\\"\\\"\\\"  logic [17:0] target_low;\n  logic [11:0] sequential_page;\n  logic [17:0] sequential_low;\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  assign sequential_pc = imem_addr + 32'd4;\\\"\\\"\\\", \\\"\\\"\\\"  assign sequential_low = imem_addr[19:2] + 18'd1;\n  assign sequential_page = imem_addr[31:20] + {11'b0, &imem_addr[19:2]};\n  assign sequential_pc = {sequential_page, sequential_low, 2'b0};\n  assign seq_next_window = request_window || (&imem_addr[31:2]);\n  assign seq_next_last = request_window && imem_addr[19:2] == 18'h3fffe;\\\"\\\"\\\"),\n    (\\\"\\\"\\\"? {imem_data[31], imem_data[19:12], imem_data[20], imem_data[30:22]}\n                        : {{9{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:9]};\\\"\\\"\\\", \\\"\\\"\\\"? {imem_data[19:12], imem_data[20], imem_data[30:22]}\n                        : {{8{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:9]};\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  // The fetch PC is word aligned. Add bits [20:2] first and select the\n  // upper sum using the low carry minus the sign of the offset.\n  assign {low_carry, target_low} = {1'b0, imem_addr[20:2]} + {1'b0, word_offset};\n  assign pc_high     = imem_addr[31:21];\n  assign pc_high_inc = pc_high + 11'd1;\n  assign pc_high_dec = pc_high - 11'd1;\n  assign target_high = ({11{ low_carry && \"'!imem_data[31]}} & pc_high_inc)\n                     | ({11{!low_carry &&  imem_data[31]}} & pc_high_dec)\n                     | ({11{ low_carry ==  imem_data[31]}} & pc_high);\n  assign direct_target = {target_high, target_low, halfword_offset, 1'\"'b0};\n  // Check the upper candidates for zero in parallel with the address sum.\n  assign target_high_zero = (low_carry == imem_data[31] && pc_high == 11'd0)\n                         || (low_carry && \"'!imem_data[31] && (&pc_high))\n                         || (!low_carry && imem_data[31] && pc_high == 11'\"'d1);\\\"\\\"\\\", \\\"\\\"\\\"  // Only in-window aligned targets can be requested speculatively.\n  assign {low_carry, target_low} = {1'b0, imem_addr[19:2]} + {1'b0, word_offset};\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  assign predict_taken = \"'!halfword_offset && !target_low[18] && target_high_zero\n                      && (is_jal || (is_branch && fetch_direction));\"\"\", \"\"\"  assign predict_taken = request_wind