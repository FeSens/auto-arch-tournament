{"type": "item.started", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r13-replay/directory.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\n\npath = Path(sys.argv[1])/'if_stage.sv'\noptions = set(sys.argv[2:])\nsv=path.read_text()\nsv=sv.replace(\\\"logic [BUFFER_BITS-1:0] lookup_slot;\\\", \\\"\\\"\\\"logic [BUFFER_BITS-1:0] lookup_slot, producer_slot;\n  logic [BUFFER_SLOTS-1:0] block_hit;\n  logic [LANES-1:0] fill_lanes, producer_lanes, selected_valid;\n  logic [PAYLOAD_WIDTH-1:0] replay_payload;\\\"\\\"\\\")\na=sv.index(\\\"  assign lookup_slot\\\")\nb=sv.index(\\\"  assign ram_write_index\\\",a)\nsv=sv[:a]+\\\"\\\"\\\"  // Keep adjacent aligned blocks in different slots.\n  assign lookup_slot = lookup_block_q[BUFFER_BITS-1:0] \"'^ {(BUFFER_BITS-1)'\"'(lookup_block_q >> 4), 1'b0};\n  assign producer_slot = producer_block[BUFFER_BITS-1:0] \"'^ {(BUFFER_BITS-1)'\"'(producer_block >> 4), 1'b0};\n\\\"\\\"\\\"+sv[b:]\na=sv.index(\\\"  for (genvar lane\\\")\nb=sv.index(\\\"  // Explicit vectors\\\",a)\nsv=sv[:a]+\\\"\\\"\\\"\n  for (genvar slot = 0; slot < BUFFER_SLOTS; slot++) begin : gen_dir\n    logic [BLOCK_BITS-1:0] block_q;\n    logic [LANES-1:0] valid_q;\n    logic install;\n    assign install = (|fill_lanes) && lookup_slot == BUFFER_BITS'(slot);\n    assign block_hit[slot] = block_q == producer_block;\n    assign selected_valid[slot] = block_hit[slot] &&\n                                 valid_q[predicted_pc_q[LANE_BITS+1:2]];\n    always_ff @(posedge clock) begin\n      if (reset || fence_i) valid_q <= '0;\n      else if (install) begin\n        block_q <= lookup_block_q;\n        valid_q <= fill_lanes | (valid_q & {LANES{block_q == lookup_block_q}});\n      end\n    end\n  end\n\n  for (genvar lane = 0; lane < LANES; lane++) begin : gen_ram\n    (* syn_ramstyle = \\\"block_ram\\\" *) logic [RECORD_WIDTH-1:0] prediction_ram [0:(1<<INDEX_BITS)-1];\n    prediction_record_t lookup_record_q;\n    logic lane