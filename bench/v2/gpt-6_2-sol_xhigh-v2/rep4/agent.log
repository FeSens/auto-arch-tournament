{"type": "item.completed", "item": {"id": "item_61", "type": "command_execution", "command": "/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY' > timing-variants-6.log 2>&1\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nrtl = root / \\\"cores/bench/rtl\\\"\nsource = (rtl / \\\"if_stage.sv\\\").read_text()\nmux_start = \\\"  assign imem_addr\\\"\nmux_end = \\\"  logic [31:0] sequential_pc\\\"\nold_mux = source[source.index(mux_start):source.index(mux_end)]\njoint_variant = (root / \\\"timing-variants/joint_addr_idx_mux/rtl/if_stage.sv\\\").read_text()\njoint_mux = joint_variant[joint_variant.index(\\\"  // Share the selection masks\\\"):joint_variant.index(mux_end)]\nreuse_last_word = [\n    (\\\"  localparam logic [31:0] LAST_MAPPED_PC = 32'h000f_fffc;\\\\n\\\", \\\"\\\"),\n    (\\\"  assign last_word_fallthrough = imem_addr == LAST_MAPPED_PC && \"'!predict_taken;\",\n     \"\"\"  assign last_word_fallthrough = pc_page == 12'\"'d0 && sequential_carry\n                               && imem_addr[1:0] == 2'b00 && \"'!predict_taken;\"\"\"),\n]\nrange_start = source.index(\"  assign target_in_window\")\nrange_end = source.index(\"  assign sequential_low\", range_start)\nold_range = source[range_start:range_end]\nparallel_window_match = \"\"\"  assign target_in_window = ((&pc_page) && page_up)\n                         || (!(|pc_page[11:1]) && !page_up && pc_page[0] != page_same);\n\n\"\"\"\nold_target_page = \"\"\"  assign target_page = ({12{page_up}}   & pc_page_inc)\n                     | ({12{page_down}} & pc_page_dec)\n                     | ({12{page_same}} & pc_page);\"\"\"\nshared_page_matches = [\n    (\"  logic [11:0] pc_page, pc_page_inc, pc_page_dec, target_page;\",\n     \"  logic [11:0] pc_page, pc_page_inc, target_page;'\"\\\\n  logic [10:0] pc_page_dec_upper;\\\\n  logic        target_page_bit_zero;\\\"),\n    (\\\"  assign pc_page_dec = pc_page - 12'd1;\\\",\n     \\\"  assign pc_page_dec_upper = pc_page[11:1] - {10'b0, \"'!pc_page[0]};\"),\n    (old_target_page, \"\"\"  assign target_page[11:1] = ({11{page_up}}   & pc_page_inc[11:1])\n                           | ({11{page_down}} & pc_page_dec_upper)\n                           | ({11{page_same}} & pc_page[11:1]);\n  assign target_page_bit_zero = pc_page[0] == page_same;\n  assign target_page[0] = target_page_bit_zero;\"\"\"),\n    (\"&& (pc_page[0] != page_same)\", \"&& !target_page_bit_zero\"),\n]\npc_update_start = source.index(\"    end else if (accept_fetch || recovery_pending_q) begin\")\nzero_page = (root / \"timing-variants/zero_page/rtl/if_stage.sv\").read_text()\nzero_page_start = zero_page.index(\"    end else if (accept_fetch || recovery_pending_q) begin\")\nscoped_pc_update = \"\"\"    end else if (accept_fetch) begin\n      predicted_pc_q <= predict_taken ? direct_target : sequential_pc;\n    end else if (recovery_pending_q) begin\n      predicted_pc_q <= imem_addr;\n    end\n  end\n\nendmodule\n\"\"\"\nvariants = {\n    \"factored_joint_mux\": [(old_mux, joint_mux)],\n    \"factored_reuse_last_word\": reuse_last_word,\n    \"factored_shared_lsb\": shared_page_matches,\n    \"factored_parallel_window_match\": [(old_range, parallel_window_match)],\n    \"factored_zero_page\": [(source[pc_update_start:], zero_page[zero_page_start:])],\n    \"factored_pc_update\": [(source[pc_update_start:], scoped_pc_update)],\n}\n\ndef run(item):\n    name, replacements = item\n    variant_rtl = root / \"timing-variants\" / name / \"rtl\"\n    shutil.copytree(rtl, variant_rtl)\n    variant_source = source\n    for original, replacement in replacements:\n        assert original in variant_source\n        variant_source = variant_source.replace(original, replacement)\n    (variant_rtl / \"if_stage.sv\").write_text(variant_source)\n    result = build(root, variant_rtl, \"fpga/core_bench_si.sv\", 1, variant_rtl.parent / \"gowin_p1\")\n    print(name, result[\"fm