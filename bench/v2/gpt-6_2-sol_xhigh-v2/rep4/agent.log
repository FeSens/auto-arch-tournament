{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c 'trial_root=\"$TMPDIR/branch-recovery.briux8\"\ntrial_dir=\"$trial_root/issue-select\"\nmkdir -p \"$trial_dir/cores/bench\"\ncp -r cores/bench/rtl \"$trial_dir/cores/bench/\"\ncp cores/bench/core.yaml \"$trial_dir/cores/bench/\"\nln -s \"$PWD/fpga\" \"$trial_dir/fpga\"\npython - \"$trial_dir/cores/bench/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot=Path(sys.argv[1])\nlanes = [\n ('ADD','add_sum'), ('SUB','a - b'), ('AND','a & b'), ('OR','a | b'),\n ('XOR','a \"'^ b'\"'), ('SLT',\\\"{31'b0, \"'$signed(a) < $signed(b)}\"),\n ('\"'SLTU',\\\"{31'b0, a < b}\\\"), ('SLL','a << b[4:0]'), ('SRL','a >> b[4:0]'),\n ('SRA','\"'$unsigned($signed(a) >>> b[4:0])'\"'), ('LUI','b'),\n ('MUL','mul_low'), ('MULH','mul_high'), ('DIV','div_result'), ('LINK','link')\n]\n\np=root/'alu.sv'\ns=p.read_text()\ns += '''\nmodule execute_result (\n  input  logic [14:0] select_result,\n  input  logic [31:0] a, b,\n  input  logic [31:0] mul_low, mul_high, div_result, link,\n  output logic [31:0] out, add_sum\n);\n  assign add_sum = a + b;\n'''\ns += '  assign out = ' + '\\\\n             | '.join(\\\"({{32{{select_result[{}]}}}} & ({}))\\\".format(i, value) for i, (_,value) in enumerate(lanes)) + ';\\\\nendmodule\\\\n'\np.write_text(s)\n\np=root/'core_pkg.sv'\ns=p.read_text()\ns=s.replace('    logic [11:0] addr_offset;', '    logic [11:0] addr_offset;\\\\n    logic [14:0] select_result;')\np.write_text(s)\n\np=root/'id_stage.sv'\ns=p.read_text()\nidx=s.index('  // ── ID/EX register')\nexpr='  logic [14:0] select_result;\\\\n'\nfor i,(op,_) in enumerate(lanes):\n    if op == 'LINK':\n        selector = 'dec_is_jump'\n    elif op == 'MULH':\n        selector = 'dec_alu_op == ALU_MULH || dec_alu_op == ALU_MULHSU || dec_alu_op == ALU_MULHU'\n    elif op == 'DIV':\n        selector = 'dec_alu_op == ALU_DIV || dec_alu_op == ALU_DIVU || dec_alu_op == ALU_REM || dec_alu_op == ALU_REMU'\n    else:\n        selector = f'dec_alu_op == ALU_{op}' + (' && \"'!dec_is_jump'\"' if op == 'ADD' else '')\n    expr+=f'  assign select_result[{i}] = {selector};\\\\n'\ns=s[:idx]+expr+'\\\\n'+s[idx:]\ns=s.replace('      reg_q.addr_offset <= imm[11:0];','      reg_q.addr_offset <= imm[11:0];\\\\n      reg_q.select_result <= select_result;')\np.write_text(s)\n\np=root/'ex_stage.sv'\ns=p.read_text()\nstart=s.index('  logic [31:0] alu_result, effective_addr;')\nend=s.index('  // ID selects forwarded rs1',start)\ns=s[:start]+'''  logic [31:0] alu_result, effective_addr;\n'''+s[end:]\ns=s.replace('  logic        mul_low_instr;\\\\n','')\ns=s.replace('  assign mul_low_instr = in.ctrl.alu_op == ALU_MUL;\\\\n','')\nstart=s.index('  // ── EX/MEM register')\ns=s[:start]+'''  execute_result u_result (\n    .select_result (in.select_result),\n    .a             (alu_a),\n    .b             (alu_b),\n    .mul_low       (mul_low_result),\n    .mul_high      (mul_high_result),\n    .div_result    (div_result),\n    .link          (sequential_pc),\n    .out           (alu_result),\n    .add_sum       (effective_addr)\n  );\n\n'''+s[start:]\ns=s.replace('  logic use_alu_result;\\\\n\\\\n','')\nstart=s.index('  // The low multiply reaches')\nend=s.index('  assign transfer_valid',start)\ns=s[:start]+s[end:]\nstart=s.index('      reg_q.alu_result    <=')\nend=s.index('      reg_q.effective_addr',start)\ns=s[:start]+'      reg_q.alu_result    <= alu_result;\\\\n'+s[end:]\np.write_text(s)\nPY\npython -m tools.eval.gowin bench --worktree \\\"\"'$trial_dir\" --all-options --paths 8 > \"$trial_dir/timing.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
