{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name, base_variant in (('free_div', 'control'), ('free_div_retimed', 'retimed')):\n    variant = root / name\n    source = root / base_variant\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    path = variant / 'cores/bench/rtl/div_unit.sv'\n    rtl = path.read_text()\n    i = rtl.index('  always_ff', rtl.index('  logic [31:0] uncorrected_base'))\n    j = rtl.index('  // The downward estimate',i)\n    seed_capture = '    seed         <= rom_seed;\\\\n' if name == 'free_div_retimed' else ''\n    rtl = rtl[:i] + '''  always_ff @(posedge clock) begin\n    // Held launch operands feed the stages until completion is consumed.\n    dividend_q           <= a_negative ? -a_q : a_q;\n    divisor_q            <= b_negative ? -b_q : b_q;\n    remainder_op_q       <= (op_q == ALU_REM) || (op_q == ALU_REMU);\n    remainder_negative_q <= a_negative;\n    quotient_negative_q  <= a_negative \"'^ b_negative;\n    divisor_zero_q       <= b_q == 32'\"'b0;\n\n    normalized_q <= normalized;\n    shift_q      <= shift;\n''' + seed_capture + '''    n0_q <= dividend_product[44:10];\n    e0_q <= negated_divisor_product[34:10];\n    n1_q <= n0_q + {9'b0, n0_product[47:22]};\n    e1_q <= {3'b0, e0_q[11:0]} + e0_product[36:22];\n    n2_high_q <= 32'((n1_q + {19'b0, n1_product[49:34]}) >> 3);\n    quotient_q               <= n2_high_q >> (~shift_q);\n    dividend_minus_divisor_q <= {1'b0, dividend_q} - {1'b0, divisor_q};\n\n    product_q                     <= quotient_q * divisor_q;\n    signed_quotient_q             <= quotient_negative_q ? -quotient_q : quotient_q;\n    signed_incremented_quotient_q <= quotient_negative_q ? ~quotient_q : quotient_q + 32'd1;\n  end\n\n''' + rtl[j:]\n    rtl = rtl.replace(\\\".read_en (iterate && \"'!reset && cycles_left_q == 3'\"'d6),\\\", \\\".read_en (1'b1),\\\")\n    rtl = rtl.replace(\\\".read_en (iterate && \"'!reset && cycles_left_q == 3'\"'d7),\\\", \\\".read_en (1'b1),\\\")\n    path.write_text(rtl)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(task):\n    name, option = task\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', option, variant / 'timing' / f'p{option}')\n    print(name, option, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    list(executor.map(trial, [(name,option) for name in ('free_div','free_div_retimed') for option in (0,1)]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
