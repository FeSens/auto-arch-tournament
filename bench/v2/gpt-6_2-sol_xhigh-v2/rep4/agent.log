0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): r\n…[8911 of 11983 chars elided by tools/bench/transcript.py; sha256:120c2ba27703d03a]…\nrect_squashes_raw_fetch_and_overrides_hold(dut):\n    program = [\n        JAL(0, 8),\n        SW(0, 0, 0x40),\n        BEQ(0, 0, 8),\n        JAL(5, 0x40),\n        JAL(0, 8),\n        SW(0, 0, 0x44),\n        ADDI(3, 0, 42),\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, store_requests=requests,\n                         unready_fetches={20: program[5]})\n\n    assert requests == []\n    assert [r[\"pc\"] for r in rets] == [0, 8, 16, 24, 28]\n    assert rets[-2][\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n/srv/hwebench/venv/bin/python3\n/usr/bin/make\nbin\noss-cad-suite\nxpack-riscv-none-elf-gcc-15.2.0-1\n", "exit_code": 0, "status": "completed"}}
