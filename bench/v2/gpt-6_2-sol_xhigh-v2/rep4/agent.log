{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"cat > prototype.py <<'PY'\nfrom pathlib import Path\nrtl = Path(\\\"cores/bench/rtl\\\")\n\ndef edit(file, replacements):\n    p = rtl / file\n    data = p.read_text()\n    for old, new in replacements:\n        assert data.count(old) == 1, (file, old, data.count(old))\n        data = data.replace(old, new)\n    p.write_text(data)\n\nedit(\\\"core_pkg.sv\\\", [\n    (\\\"  // ID/EX register payload.\\\", \\\"\\\"\\\"  typedef struct packed {\n    logic young;\n    logic older;\n  } bypass_match_t;\n\n  // ID/EX register payload.\\\"\\\"\\\"),\n    (\\\"    logic [31:0] imm;\\\\n\\\", \\\"\\\"\\\"    logic [31:0] imm;\n    bypass_match_t rs1_match;\n    bypass_match_t rs2_match;\n    logic [31:0] alu_a_base;\n    logic [31:0] alu_b_base;\n\\\"\\\"\\\"),\n    (\\\"\\\"\\\"    logic [31:0] alu_result;\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)\n\\\"\\\"\\\", \\\"    logic [31:0] wb_data;\\\\n\\\"),\n])\n\n(rtl / \\\"forward_unit.sv\\\").write_text(\\\"\\\"\\\"// Match decode sources against the two producers entering the bypass slots.\nmodule forward_unit (\n  input  logic [4:0] decode_rs1,\n  input  logic [4:0] decode_rs2,\n  input  logic [4:0] young_rd,\n  input  logic       young_valid,\n  input  logic [4:0] older_rd,\n  input  logic       older_valid,\n  output bypass_match_t rs1_match,\n  output bypass_match_t rs2_match\n);\n  logic young_candidate, older_candidate;\n  assign young_candidate = young_valid && young_rd \"'!= 5'\"'b0;\n  assign older_candidate = older_valid && older_rd \"'!= 5'\"'b0;\n\n  assign rs1_match.young = young_candidate && young_rd == decode_rs1;\n  assign rs1_match.older = older_candidate && older_rd == decode_rs1;\n  assign rs2_match.young = young_candidate && young_rd == decode_rs2;\n  assign rs2_match.older = older_candidate && older_rd == decode_rs2;\nendmodule\n\\\"\\\"\\\")\nedit(\\\"core.sv\\\", [\n    (\\\"  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\\\", \\\"  bypass_match_t rs1_match, rs2_match;\\\"),\n    (\\\"    .rs2_data (rs2_data_w),\\\\n    .out      (id_ex_w)\\\", \\\"\\\"\\\"    .rs2_data (rs2_data_w),\n    .rs1_match (rs1_match),\n    .rs2_match (rs2_match),\n    .out      (id_ex_w)\\\"\\\"\\\"),\n    (\\\"\\\"\\\"    .fwd_rs1_sel     (fwd_rs1_sel),\n    .fwd_rs2_sel     (fwd_rs2_sel),\n\\\"\\\"\\\", \\\"\\\"\\\"    .fwd_ex_mem_wr   (ex_mem_w.ctrl.reg_write),\n    .fwd_mem_wb_wr   (mem_wb_w.ctrl.reg_write),\n\\\"\\\"\\\"),\n    (\\\"\\\"\\\"    .id_ex_rs1   (id_ex_w.rs1_addr),\n    .id_ex_rs2   (id_ex_w.rs2_addr),\n    .ex_mem_rd   (ex_mem_w.rd),\n    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\n    .mem_wb_rd   (mem_wb_w.rd),\n    .mem_wb_w_en (mem_wb_w.ctrl.reg_write),\n    .fwd_rs1     (fwd_rs1_sel),\n    .fwd_rs2     (fwd_rs2_sel)\n\\\"\\\"\\\", \\\"\\\"\\\"    .decode_rs1  (rs1_addr_w),\n    .decode_rs2  (rs2_addr_w),\n    .young_rd    (id_ex_w.rd),\n    .young_valid (id_ex_w.valid),\n    .older_rd    (ex_mem_w.rd),\n    .older_valid (ex_mem_w.valid),\n    .rs1_match   (rs1_match),\n    .rs2_match   (rs2_match)\n\\\"\\\"\\\"),\n])\nedit(\\\"id_stage.sv\\\", [\n    (\\\"  // ID/EX register output\\\", \\\"\\\"\\\"  input  bypass_match_t    rs1_match,\n  input  bypass_match_t    rs2_match,\n  // ID/EX register output\\\"\\\"\\\"),\n    (\\\"      reg_q.imm      <= imm;\\\", \\\"\\\"\\\"      reg_q.imm      <= imm;\n      reg_q.rs1_match <= rs1_match;\n      reg_q.rs2_match <= rs2_match;\n      reg_q.alu_a_base <= dec_is_auipc ? in.pc : rs1_data;\n      reg_q.alu_b_base <= dec_alu_src ? imm : rs2_data;\\\"\\\"\\\"),\n])\nedit(\\\"ex_stage.sv\\\", [\n    (\\\"\\\"\\\"  input  logic [1:0]         fwd_rs1_sel,\n  input  logic [1:0]         fwd_rs2_sel,\n\\\"\\\"\\\", \\\"\\\"\\\"  input  logic               fwd_ex_mem_wr,\n  input  logic               fwd_mem_wb_wr,\n\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\\\"\\\"\\\", \\\"\\\"\\\"  logic rs1_young, rs1_older, rs1_local;\n  logic rs2_young, rs2_older, rs2_local;\n  assign rs1_young = in.rs1_match.young && fwd_ex_mem_wr;\n  assign rs1_older = in.rs1_match.older && fwd_mem_wb_wr && \"'!rs1_young;\n  assign rs1_local = !(rs1_young || rs1_older);\n  assign rs2_young = in.rs2_match.young && fwd_ex_mem_wr;\n  assign rs2_older = in.rs2_match.older && fwd_mem_wb_wr && !rs2_young;\n  assign rs2_local = !(rs2_young || rs2_older);\n\n  assign rs1 = ({32{rs1_young}} & fwd_ex_mem)\n             | ({32{rs1_older}} & fwd_mem_wb)\n             | ({32{rs1_local}} & in.rs1_val);\n  assign rs2 = ({32{rs2_young}} & fwd_ex_mem)\n             | ({32{rs2_older}} & fwd_mem_wb)\n             | ({32{rs2_local}} & in.rs2_val);\n\n  // Select the ALU'\"'s operand with the PC/immediate selection folded into\n  // the bypass masks.\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  assign alu_a = ({32{rs1_young && \"'!in.ctrl.is_auipc}} & fwd_ex_mem)\n               | ({32{rs1_older && !in.ctrl.is_auipc}} & fwd_mem_wb)\n               | ({32{rs1_local || in.ctrl.is_auipc}} & in.alu_a_base);\n  assign alu_b = ({32{rs2_young && !in.ctrl.alu_src}} & fwd_ex_mem)\n               | ({32{rs2_older && !in.ctrl.alu_src}} & fwd_mem_wb)\n               | ({32{rs2_local || in.ctrl.alu_src}} & in.alu_b_base);\n\"\"\"),\n])\nedit(\"mem_stage.sv\", [\n    (\"\"\"      reg_q.alu_result <= in.alu_result;\n      reg_q.read_data  <= load_data;\n\"\"\", \"\"\"      reg_q.wb_dat