{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c 'set -e\nwork=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\ncp -r \"$work/rtl-loop-target\" \"$work/rtl-loop-compact\"\npython3 - \"$work/rtl-loop-compact\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot = Path(sys.argv[1])\np = root / 'core_pkg.sv'\ns = p.read_text().replace('    logic [31:0] direct_target;\\\\n', '')\np.write_text(s)\np = root / 'id_stage.sv'\ns = p.read_text().splitlines(keepends=True)\np.write_text(''.join(line for line in s if 'reg_q.direct_target' not in line))\np = root / 'ex_stage.sv'\ns = p.read_text().replace('  assign direct_target  = in.direct_target;',\n'''  assign direct_target  = {in.pc[31:2] + in.imm[31:2], in.imm[1], 1'b0};''')\ns = s.replace('in.direct_target[1]', 'in.imm[1]').replace('reg_q.branch_target <= in.direct_target;', 'reg_q.branch_target <= direct_target;')\ns = s.replace('(&in.imm[31:7]) && (|in.imm[6:2])', '(&in.imm[31:8]) && (|in.imm[7:2])')\np.write_text(s)\np = root / 'if_stage.sv'\ns = p.read_text().replace('    logic [31:0] direct_target;\\\\n', '').replace('SLOT_WIDTH = 95', 'SLOT_WIDTH = 63')\ns = s.replace('  logic [31:0] sequential_pc, bus_direct_target, loop_direct_target;',\n'''  logic [31:0] sequential_pc;\n  logic [17:0] loop_direct_target;''')\ns = s.replace('logic        halfword_offset, low_carry;', 'logic        halfword_offset, bus_target_valid, loop_target_valid;')\nstart = s.index('  logic [10:0] pc_high')\nstop = s.index('\\\\n\\\\n', start)\ns = s[:start] + s[stop:]\nstart = s.index('  // The fetch PC is word aligned.')\nstop = s.index('  logic [5:0]  fetch_index;', start)\ns = s[:start] + '''  // For an in-window source, bit 18 of the wrapped 19-bit word sum\n  // catches both positive and negative out-of-window direct targets.\n  assign target_low = {1'b0, producer_pc[19:2]} + word_offset;\n  assign bus_target_valid = producer_pc[31:20] == 12'b0 && \"'!halfword_offset && !target_low[18];\n\n'\"''' + s[stop:]\ns = s.replace('\"'!halfword_offset && bus_direct_target[31:20] == 12'\"\\\\'b0', 'bus_target_valid')\ns = s.replace('loop_direct_target[31:20] == 12\\\\'b0 && \"'!loop_direct_target[1]'\"', 'loop_target_valid')\ns = s.replace('logic [31:0] loop_valid_q;', 'logic [63:0] loop_valid_q;').replace('logic [64:0] loop_words [0:31];', 'logic [51:0] loop_words [0:63];')\ns = s.replace('logic [4:0]  loop_index;', 'logic [5:0]  loop_read_index, loop_write_index;')\ns = s.replace('assign loop_index = producer_pc[6:2];', '''assign loop_read_index = predicted_pc_q[7:2];\n  assign loop_write_index = producer_pc[7:2];''')\ns = s.replace('''loop_present_q && producer_pc[31:20] == 12'b0 &&\n                    (producer_pc[19:7] == loop_first_q[17:5] || producer_pc[19:7] == loop_last_q[17:5]) &&\n                    producer_pc[7] == loop_page && loop_valid_q[loop_index]''',\n'''loop_present_q && \"'!recovery_pending_q && predicted_pc_q[31:20] == 12'\"'b0 &&\n                    (predicted_pc_q[19:8] == loop_first_q[17:6] || predicted_pc_q[19:8] == loop_last_q[17:6]) &&\n                    predicted_pc_q[8] == loop_page && loop_valid_q[loop_read_index]''')\ns = s.replace('{loop_page, loop_direct_target, loop_instr} = loop_words[loop_index]',\n'''{loop_page, loop_target_valid, loop_direct_target, loop_instr} = loop_words[loop_read_index]''')\ns = s.replace('loop_valid_q[loop_index]', 'loop_valid_q[loop_write_index]')\ns = s.replace('loop_words[loop_index] <= {producer_pc[7], bus_direct_target, imem_data};',\n'''loop_words[loop_write_index] <= {producer_pc[8], bus_target_valid, target_low[17:0], imem_data};''')\ns = ''.join(line for line in s.splitlines(keepends=True) if 'produced.direct_target' not in line and 'out.direct_target' not in line)\ns = s.replace('& bus_direct_target)', \\\"& {12'b0, target_low[17:0], 2'b00})\\\")\ns = s.replace('& loop_direct_target)', \\\"& {12'b0, loop_direct_target, 2'b00})\\\")\np.write_text(s)\nPY\nRTL_DIR=\\\"\"'$work/rtl-loop-compact\" OBJ_DIR=\"$work/obj-loop-compact\" NRET=1 bash test/cosim/build.sh > \"$work/build-loop-compact.log\" 2>&1\n\"$work/obj-loop-compact/cosim_sim\" \"$work/coremark.elf\" 50000000 --bench --istall --dstall > \"$work/coremark-compact.jsonl\"\ntail -1 \"$work/coremark-compact.jsonl\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
