{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c 'trial_dir=\"$TMPDIR/branch-recovery.briux8/trial\"\nmkdir -p \"$trial_dir/cores/bench\"\ncp -a cores/bench/rtl cores/bench/core.yaml \"$trial_dir/cores/bench/\"\nln -s \"$PWD/fpga\" \"$trial_dir/fpga\"\npython - \"$trial_dir/cores/bench/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nroot = Path(sys.argv[1])\n\np = root / 'core.sv'\ns = p.read_text()\ns = s.replace('logic        redirect;', '''logic        annul, ex_advance;\n  logic [31:0] ex_indirect_target;''')\ns = s.replace('.redirect        (redirect),', '''.annul           (annul),\n    .ex_advance      (ex_advance),\n    .ex_predicted_taken (id_ex_w.predicted_taken),\n    .ex_last_mapped_word (id_ex_w.last_mapped_word),''', 1)\ns = s.replace('.mem_indirect_target ({ex_mem_w.effective_addr[31:2], 2\\\\'b00})', '.ex_indirect_target (ex_indirect_target)')\ns = s.replace('.flush    (load_use_hazard || redirect),', '''.flush    (load_use_hazard),\n    .annul    (annul),''')\ns = s.replace('.redirect        (redirect),', '''.advance         (ex_advance),\n    .indirect_target (ex_indirect_target),''')\np.write_text(s)\n\np = root / 'ex_stage.sv'\ns = p.read_text()\ns = s.replace('output logic               redirect,', '''output logic               advance,\n  output logic [31:0]        indirect_target,''')\ns = s.replace('logic transfer_valid, advance;', 'logic transfer_valid;')\ns = s.replace('  assign redirect        = advance && (in.last_mapped_word || (in.predicted_taken \"'!= actual_taken));'\"', \\\"  assign indirect_target = {effective_addr[31:2], 2'b00};\\\")\ns = s.replace('  input  id_ex_t   in,', '''  /* verilator lint_off UNUSEDSIGNAL */\n  input  id_ex_t   in,\n  /* verilator lint_on UNUSEDSIGNAL */''')\np.write_text(s)\n\np = root / 'id_stage.sv'\ns = p.read_text()\ns = s.replace('  input  logic              flush,', '''  input  logic              flush,\n  input  logic              annul,''')\ns = s.replace('      reg_q.valid    <= in.valid && \"'!flush;'\"\\\\n    end', '''      reg_q.valid    <= in.valid && \"'!flush;\n    end else if (annul) begin\n      reg_q.valid <= 1'\"'b0;\n    end''')\ns = s.replace('  assign out = reg_q;', '''  always_comb begin\n    out       = reg_q;\n    out.valid = reg_q.valid && \"'!annul;\n  end'\"''')\np.write_text(s)\n\np = root / 'if_stage.sv'\ns = p.read_text()\ns = s.replace('  input  logic              redirect,         // advancing EX correction', '''  output logic              annul,\n  input  logic              ex_advance,\n  input  logic              ex_predicted_taken,\n  input  logic              ex_last_mapped_word,''')\ns = s.replace('mem_indirect_target', 'ex_indirect_target')\nlow, high = s.index('  logic        recovery_pending_q;'), s.index('  logic [31:0] sequential_pc;')\ns = s[:low] + '''  logic        recovery_valid_q, recovery_predicted_taken_q, recovery_last_mapped_q;\n  logic        recovery_direct_taken_q, recovery_indirect_taken_q;\n  logic        use_recovery, retain_recovery, recovery_retained_q;\n  logic        select_sequential, select_direct, select_indirect, select_predicted, select_parked;\n  logic [31:0] recovery_sequential_pc_q, recovery_direct_target_q, recovery_indirect_target_q;\n  logic        recovery_sequential_in_window_q, recovery_direct_in_window_q, recovery_indirect_in_window_q;\n  logic        recovery_sequential_last_word_q, recovery_direct_last_word_q, recovery_indirect_last_word_q;\n  logic        request_in_window, request_last_word;\n  logic        parked_q, park, accept_fetch;\n\n  assign use_recovery = recovery_valid_q && (recovery_last_mapped_q ||\n                        (recovery_predicted_taken_q \"'!= (recovery_direct_taken_q || recovery_indirect_taken_q)));\n  assign annul = use_recovery && !recovery_retained_q;\n  assign retain_recovery = use_recovery && !accept_fetch;\n\n  always_ff @(posedge clock) begin\n    if (!retain_recovery) begin\n      recovery_sequential_pc_q   <= ex_sequential_pc;\n      recovery_direct_target_q   <= ex_direct_target;\n      recovery_indirect_target_q <= ex_indirect_target;\n      recovery_sequential_in_window_q <= ex_sequential_pc[31:20] == 12'\"'b0;\n      recovery_direct_in_window_q     <= ex_direct_target[31:20] == 12'b0;\n      recovery_indirect_in_window_q   <= ex_indirect_target[31:20] == 12'b0;\n      recovery_sequential_last_word_q <= ex_sequential_pc == LAST_MAPPED_PC;\n      recovery_direct_last_word_q     <= ex_direct_target == LAST_MAPPED_PC;\n      recovery_indirect_last_word_q   <= ex_indirect_target == LAST_MAPPED_PC;\n      recovery_direct_taken_q   <= ex_direct_taken;\n      recovery_indirect_taken_q <= ex_indirect_taken;\n      recovery_predicted_taken_q <= ex_predicted_taken;\n      recovery_last_mapped_q     <= ex_last_mapped_word;\n    end\n\n    if (reset) begin\n      recovery_valid_q    <= 1'b0;\n      recovery_retained_q <= 1'b0;\n      parked_q            <= 1'b0;\n    end else begin\n      if (\"'!retain_recovery) recovery_valid_q <= ex_advance;\n      recovery_retained_q <= retain_recovery;\n      parked_q            <= park || (parked_q && !annul);\n    end\n  end\n\n  assign select_sequential = use_recovery && !recovery_direct_taken_q && !recovery_indirect_taken_q;\n  assign select_direct     = use_recovery && recovery_direct_taken_q;\n  assign select_indirect   = use_recovery && recovery_indirect_taken_q;\n  assign select_predicted  = !use_recovery && !parked_q;\n  assign select_parked     = !use_recovery && parked_q;\n  assign imem_addr = ({32{select_predicted}}  & predicted_pc_q)\n                   | ({32{select_parked}}     & LAST_MAPPED_PC)\n                   | ({32{select_sequential}} & recovery_sequential_pc_q)\n                   | ({32{select_direct}}     & recovery_direct_target_q)\n                   | ({32{select_indirect}}   & recovery_indirect_target_q);\n\n  assign request_in_window = (select_predicted && predicted_in_window_q)\n                          || select_parked\n                          || (select_sequential && recovery_sequential_in_window_q)\n                          || (select_direct && recovery_direct_in_window_q)\n                          || (select_indirect && recovery_indirect_in_window_q);\n  assign request_last_word = (select_predicted && predicted_last_word_q)\n                          || select_parked\n                          || (select_sequential && recovery_sequential_last_word_q)\n                          || (select_direct && recovery_direct_last_word_q)\n                          || (select_indirect && recovery_indirect_last_word_q);\n\n'\"''' + s[high:]\ns = s.replace('empty, full, fetch_valid, accept_fetch, enqueue, pop;', 'empty, full, fetch_valid, enqueue, pop;')\ns = s.replace('recovery_pending_q', 'annul')\ns = s.replace('(\"'!parked_q || annul)'\"', '(\"'!parked_q || use_recovery)'\"')\nlow = s.index('  // When a corrected response stalls or parks')\ns = s[:low] + '''  always_ff @(posedge clock) begin\n    if (reset) begin\n      predicted_pc_q        <= '0;\n      predicted_in_window_q <= 1'b1;\n      predicted_last_word_q <= 1'b0;\n    end else if (step_fetch) begin\n      predicted_pc_q <= ({32{step_taken}}      & {12'b0, target_word, 2'b00})\n                      | ({32{step_sequential}} & sequential_pc);\n      predicted_in_window_q <= step_taken || (step_sequential && sequential_in_window);\n      predicted_last_word_q <= (step_taken && target_last_word)\n                            || (step_sequential && sequential_last_word);\n    end\n  end\n\nendmodule\n'''\np.write_text(s)\nPY\nRTL_DIR=\\\"\"'$trial_dir/cores/bench/rtl\" OBJ_DIR=\"$trial_dir/obj_dir\" NRET=1 bash test/cosim/build.sh > \"$trial_dir/build.log\" 2>&1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
