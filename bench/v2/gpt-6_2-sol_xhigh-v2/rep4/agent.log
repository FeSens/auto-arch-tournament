{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom itertools import product\nfrom random import Random\n\nmask=(1<<32)-1\n\ndef carry_select(a,b,subtract):\n    b \"'^= mask if subtract else 0\n    generate = []\n    propagate = []\n    sub_sums = []\n    for shift in (0,8,16,24):\n        a_byte = (a >> shift) & 255\n        b_byte = (b >> shift) & 255\n        generate.append((a_byte+b_byte) >> 8)\n        propagate.append((a_byte ''^ b_byte) == 255)\n        sub_sums.append(((a_byte+b_byte) & 255,(a_byte+b_byte+1) & 255))\n    g0,g1,g2,_=generate\n    p0,p1,p2,_=propagate\n    c0=int(subtract)\n    c1=g0 | (p0 & c0)\n    c2=g1 | (p1 & g0) | (p1 & p0 & c0)\n    c3=g2 | (p2 & g1) | (p2 & p1 & g0) | (p2 & p1 & p0 & c0)\n    return sum(sub_sums[i][c] << (8*i) for i,c in enumerate((c0,c1,c2,c3)))\n\nedge = (0,1,254,255,256,257,65535,65536,16777215,16777216,(1<<31)-1,1<<31,mask-1,mask)\nrng=Random(42)\nfor a,b in list(product(edge,repeat=2)) + [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(10000)]:\n    assert carry_select(a,b,False) == (a+b)&mask\n    assert carry_select(a,b,True) == (a-b)&mask\nprint('\"'Proposed carry-select arithmetic matches 32-bit ADD/SUB on 10,196 operand pairs')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
