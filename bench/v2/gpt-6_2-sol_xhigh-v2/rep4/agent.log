{"type": "item.started", "item": {"id": "item_40", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p /srv/hwebench/tmp/58928045/2966b888/divider_hyp_early_commit/cores/bench\ncp -r cores/bench/{rtl,test,core.yaml} /srv/hwebench/tmp/58928045/2966b888/divider_hyp_early_commit/cores/bench/\ncp -r fpga bench test formal /srv/hwebench/tmp/58928045/2966b888/divider_hyp_early_commit/\ncat > /srv/hwebench/tmp/58928045/2966b888/divider_hyp_early_commit/prototype.py <<'PY'\nfrom pathlib import Path\nroot = Path(__file__).parent / 'cores/bench'\np = root / 'rtl/div_unit.sv'\nrtl = p.read_text()\nrtl = rtl.replace('logic [2:0] cycles_left_q;', 'logic [3:0] cycles_left_q;')\nrtl = rtl.replace(\\\"cycles_left_q == 3'd\\\", \\\"cycles_left_q == 4'd\\\")\nrtl = rtl.replace(\\\"cycles_left_q <= 3'd0\\\", \\\"cycles_left_q <= 4'd0\\\")\nrtl = rtl.replace(\\\"cycles_left_q <= 3'd7\\\", \\\"cycles_left_q <= 4'd8\\\")\nrtl = rtl.replace(\\\"cycles_left_q - 3'd1\\\", \\\"cycles_left_q - 4'd1\\\")\nrtl = rtl.replace('  logic       iterate;', '''  logic       iterate;\n  logic       prepare;\n  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n\n  assign prepare = iterate && cycles_left_q == 4'd8;\n\n  always_ff @(posedge clock) begin\n    if (launch) begin\n      a_q  <= a;\n      b_q  <= b;\n      op_q <= op;\n    end\n  end''')\nbefore, after = rtl.split('\"'`ifdef RISCV_FORMAL_ALTOPS'\"', 1)\nimport re\nafter = re.sub(r'\\\\b(a|b|op)\\\\b(?=(?:\\\\[| -|\\\\)| ==| \"'!=|;))'\"', r'\\\\1_q', after)\nafter = after.replace('(a_q - b_q)', '(a_q - b_q)').replace('-b : b_q', '-b_q : b_q')\nafter = after.replace('if (launch)', 'if (prepare)')\nrtl = before + '\"'`ifdef RISCV_FORMAL_ALTOPS'\"' + after\np.write_text(rtl)\n\np = root / 'rtl/mem_stage.sv'\nrtl = p.read_text().replace('  output mem_wb_t  out\\\\n', '  output mem_wb_t  out,\\\\n  output mem_wb_t  early_out\\\\n')\nrtl = rtl.replace('  mem_wb_t reg_q;', '''  mem_wb_t reg_q, completed;\n  logic early_div;\n  assign early_div