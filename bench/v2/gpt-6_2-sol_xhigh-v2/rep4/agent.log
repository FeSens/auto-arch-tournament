{"type": "item.started", "item": {"id": "item_64", "type": "command_execution", "command": "/bin/bash -c 'set -e\nbench_r11=\"$TMPDIR/bench_r11_recovery\"\ncat > \"$bench_r11/opposite.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nscratch = Path(sys.argv[1])\nsource = sys.argv[2]\nvariant = sys.argv[3]\npreadd = bool(int(sys.argv[4]))\nrtl = scratch / variant / \\\"rtl\\\"\nshutil.copytree(scratch / source / \\\"rtl\\\", rtl, dirs_exist_ok=True)\n\np = rtl / \\\"ex_stage.sv\\\"\ns = p.read_text()\ni = s.index(\\\"  output logic               redirect,\\\")\nj = s.index(\\\"  output logic               train_valid,\\\", i)\ns = s[:i] + \\\"\\\"\\\"  output logic               redirect,\n  output logic               recover_candidate,\n  output logic               recover_boundary_fallthrough,\n  output logic               recover_indirect,\n  output logic [31:0]        candidate_pc,\n\\\"\\\"\\\" + s[j:]\ns = s.replace(\\\"  logic        transfer_taken, actual_taken;\\\", \\\"  logic        transfer_taken, actual_taken, direct_taken, indirect_taken;\\\")\ns = s.replace(\\\"  logic        transfer_taken, actual_taken, direct_taken, indirect_taken;\\\", \\\"\\\"\\\"  logic        transfer_taken, direct_taken, indirect_taken;\n  logic        conditional_recovery;\n  logic [31:0] sequential_pc, direct_target;\\\"\\\"\\\")\ni = s.index(\\\"  assign actual_taken\\\")\nj = s.index(\\\"  assign train_valid\\\", i)\ns = s[:i] + \\\"\\\"\\\"  // A normal failed prediction always corrects to the opposite path.\n  // The last mapped word cannot predict a target. Its sequential\n  // successor is a fixed address and uses its own recovery select.\n  assign conditional_recovery = in.predicted_taken \"'!= direct_taken;\n  assign recover_indirect = advance && indirect_taken;\n  assign recover_boundary_fallthrough = advance && in.last_mapped_word\n                                     && !direct_taken && !indirect_taken;\n  assign recover_candidate = advance && !in.ctrl.is_jalr && conditional_recovery;\n  assign redirect = recover_candidate || recover_boundary_fallthrough || recover_indirect;\n  assign candidate_pc = in.predicted_taken ? sequential_pc : direct_target;\n  assign resolved_pc = ({32{!direct_taken && !indirect_taken}} & sequential_pc)\n                     | ({32{direct_taken}} & direct_target)\n                     | ({32{indirect_taken}} & {effective_addr[31:1], 1'\"'b0});\n\n\\\"\\\"\\\" + s[j:]\nif preadd:\n    s = s.replace(\\\"  assign candidate_pc = in.predicted_taken ? sequential_pc : direct_target;\\\", \\\"\\\"\\\"  logic [29:0] candidate_offset, candidate_word;\n  assign candidate_offset = in.predicted_taken ? 30'd1\n                          : {{11{in.direct_offset[20]}}, in.direct_offset[20:2]};\n  assign candidate_word = in.pc[31:2] + candidate_offset;\n  assign candidate_pc = {candidate_word, 2'b00};\\\"\\\"\\\")\np.write_text(s)\n\np = rtl / \\\"if_stage.sv\\\"\ns = p.read_text()\ni = s.index(\\\"  input  logic              ex_direct_taken,\\\")\nj = s.index(\\\"  input  logic [31:0]       mem_indirect_target,\\\", i)\ns = s[:i] + \\\"\\\"\\\"  input  logic              recover_candidate,\n  input  logic              recover_boundary_fallthrough,\n  input  logic              recover_indirect,\n  input  logic [31:0]       candidate_pc,\n\\\"\\\"\\\" + s[j:]\ns = s.replace(\\\"  logic [31:0] recovery_sequential_pc_q, recovery_direct_target_q;\\\", \\\"\\\"\\\"  localparam logic [31:0] MAPPED_FALLTHROUGH = LAST_MAPPED_PC + 32'd4;\n  logic [31:0] recovery_direct_target_q;\\\"\\\"\\\")\ns = s.replace(\\\"recovery_sequential_in_window_q, \\\", \\\"\\\").replace(\\\"recovery_sequential_last_word_q, \\\", \\\"\\\")\ns = s.replace(\\\"    recovery_sequential_pc_q <= ex_sequential_pc;\\\\n\\\", \\\"\\\").replace(\n    \\\"    recovery_sequential_in_window_q <= ex_sequential_pc[31:20] == 12'b0;\\\\n\\\", \\\"\\\").replace(\n    \\\"    recovery_sequential_last_word_q     <= ex_sequential_pc == LAST_MAPPED_PC;\\\\n\\\", \\\"\\\")\ns = s.replace(\\\"ex_direct_target\\\", \\\"candidate_pc\\\").replace(\n    \\\"redirect && \"'!ex_direct_taken && !ex_indirect_taken\", \"recover_boundary_fallthrough\").replace(\n    \"redirect && ex_direct_taken\", \"recover_candidate\").replace(\n    \"redirect && ex_indirect_taken\", \"recover_indirect\")\ns = s.replace(\"recovery_sequential_pc_q\", \"MAPPED_FALLTHROUGH\")\ns = s.replace(\"                          || (select_sequential_q && recovery_sequential_in_window_q)'\"\\\\n\\\",\\\"\\\").replace(\n    \\\"                          || (select_sequential_q && recovery_sequential_last_word_q)\\\\n\\\",\\\"\\\")\np.write_text(s)\n\np = rtl / \\\"core.sv\\\"\ns = p.read_text()\ns = s.replace(\\\"\\\"\\\"  logic        ex_direct_taken, ex_indirect_taken;\n  logic [31:0] ex_sequential_pc, ex_direct_target;\\\"\\\"\\\", \\\"\\\"\\\"  logic        recover_candidate, recover_boundary_fallthrough, recover_indirect;\n  logic [31:0] candidate_pc;\\\"\\\"\\\")\ni = s.index(\\\"    .ex_direct_taken\\\")\nj = s.index(\\\"    .mem_indirect_target\\\", i)\nwiring = \\\"\\\"\\\"    .recover_candidate (recover_candidate),\n    .recover_boundary_fallthrough (recover_boundary_fallthrough),\n    .recover_indirect  (recover_indirect),\n    .candidate_pc      (candidate_pc),\n\\\"\\\"\\\"\ns = s[:i] + wiring + s[j:]\ni = s.index(\\\"    .direct_taken\\\")\nj = s.index(\\\"    .train_valid\\\", i)\ns = s[:i] + wiring + s[j:]\np.write_text(s)\nPY\npython3 \\\"\"'$bench_r11/opposite.py\" \"$bench_r11\" champion opposite 0\npython3 \"$bench_r11/opposite.py\" \"$bench_r11\" champion opposite_add 1\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
