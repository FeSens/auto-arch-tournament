{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c 'set -e\nmkdir -p \"$TMPDIR/bench_r11_recovery\"\ncat > \"$TMPDIR/bench_r11_recovery/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nrepo = Path.cwd()\nscratch = Path(sys.argv[1])\nvariant = sys.argv[2]\nlate = variant == \\\"late\\\"\nrtl = scratch / variant / \\\"rtl\\\"\nshutil.copytree(repo / \\\"cores\\\" / \\\"bench\\\" / \\\"rtl\\\", rtl, dirs_exist_ok=True)\n\ndef change(file_name, replacements):\n    p = rtl / file_name\n    s = p.read_text()\n    for old, new in replacements:\n        assert s.count(old) == 1, (file_name, old, s.count(old))\n        s = s.replace(old, new)\n    p.write_text(s)\n\np = rtl / \\\"ex_stage.sv\\\"\ns = p.read_text()\ns = s.replace(\\\"  input  id_ex_t   in,\\\", (\\\"  input  logic               squash,\\\\n\\\" if late else \\\"\\\") + \\\"  input  id_ex_t   in,\\\")\ns = s.replace(\\\"\\\"\\\"  output logic               redirect,\n  output logic               direct_taken,\n  output logic               indirect_taken,\\\"\\\"\\\", \\\"\\\"\\\"  output logic               recover_sequential,\n  output logic               recover_direct,\n  output logic               recover_jalr,\\\"\\\"\\\")\nfirst = s.index(\\\"  // ID selects forwarded rs1\\\")\nlast = s.index(\\\"  // ── RV32M\\\", first)\ns = s[:first] + s[last:]\nif late:\n    s = s.replace(\\\"in.valid\\\", \\\"instruction_valid\\\")\n    s = s.replace(\\\"  logic        mul_low_instr;\\\", \\\"  logic        instruction_valid;\\\\n  logic        mul_low_instr;\\\")\n    s = s.replace(\\\"  assign mul_low_instr\\\", \\\"  assign instruction_valid = in.valid && \"'!squash;'\"\\\\n  assign mul_low_instr\\\")\ns = s.replace(\\\"  logic        transfer_taken, actual_taken;\\\", \\\"  logic        direct_taken;\\\")\ns = s.replace(\\\"  assign transfer_taken = branch_taken || in.ctrl.is_jump;\\\\n\\\", \\\"\\\")\nfirst = s.index(\\\"  // 