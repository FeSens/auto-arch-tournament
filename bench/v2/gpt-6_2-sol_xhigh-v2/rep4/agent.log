{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c 'profile_dir=\"$TMPDIR/predictor-profile\"\ncat > \"$profile_dir/variants.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nroot = Path(sys.argv[1])\nfor kind, depth, refill in [\n    ('shift', 2, True), ('shift', 3, True), ('shift', 4, True), ('ring', 2, True),\n    ('ring', 3, True), ('ring', 4, True), ('shift', 3, False), ('ring', 4, False)\n]:\n    name = f'{kind}{depth}{\\\"f\\\" if refill else \\\"n\\\"}'\n    src = root / name\n    shutil.copytree(root / 'queue_rtl', src)\n    p = src / 'if_stage.sv'\n    s = p.read_text().replace('\"'`QUEUE_DEPTH'\"', str(depth))\n    s = s[:s.index('  logic [COUNT_W-1:0]')]\n    s += \\\"\\\"\\\"  logic empty, full, consume_head, bypass, recv, push;\n  logic final_word, final_sequential;\n  logic [DEPTH-1:0] occupied_q;\n\\\"\\\"\\\"\n    if kind == 'ring':\n        s += \\\"\\\"\\\"  logic [DEPTH-1:0] head_q, tail_q;\n  if_id_t selected [0:DEPTH];\n\\\"\\\"\\\"\n    s += f\\\"\\\"\\\"\n  assign empty = \"'!occupied_q[0];\n  assign full = occupied_q[DEPTH-1];\n  assign consume_head = !stall && !empty;\n  assign bypass = !stall && empty;\n  assign final_word = pc == 32'\"'h000f_fffc;\n  assign final_sequential = final_word && \"'!predict_taken;\n  assign recv = imem_ready && (!full{'\"' || consume_head' if refill else ''}) && (\"'!final_sequential || bypass);\n  assign push = recv && !bypass;\n\n  assign received.index = fetch_index;\n  assign received.payload.pc = pc;\n  assign received.payload.instr = imem_data;\n  assign received.payload.direct_target = direct_target;\n  assign received.payload.predicted_taken = predict_taken;\n  assign received.payload.direction_counter = (train_valid && train_index == fetch_index)\n                                               ? train_counter : lookup_counter;\n  assign received.payload.valid = imem_ready;\n  for (genvar i = 0; i < DEPTH; i++) begin\n    always_comb begin\n      updated[i] = queue_q[i];\n      if (train_valid && train_index == queue_q[i].index) begin\n        updated[i].payload.direction_counter = train_counter;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= '\"'0;\n      occupied_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      occupied_q <= '0;\n    end else begin\n      if (recv) pc <= predict_taken ? direct_target : sequential_pc;\n      case ({{push, consume_head}})\n        2'b01: occupied_q <= occupied_q >> 1;\n        2'b10: occupied_q <= {{occupied_q[DEPTH-2:0], 1'b1}};\n        default: ;\n      endcase\n    end\n  end\n\\\"\\\"\\\"\n    if kind == 'shift':\n        s += \\\"\\\"\\\"\n  logic [DEPTH:0] append_pos;\n  assign append_pos = {(occupied_q \"'^ (occupied_q << 1)), 1'\"'b0};\n  for (genvar i = 0; i < DEPTH; i++) begin\n    logic append_here;\n    if (i == 0) begin\n      assign append_here = push && ((consume_head && (occupied_q[0] && \"'!occupied_q[1])) ||\n                                    (!consume_head && !occupied_q[0]));\n    end else if (i == DEPTH-1) begin\n      assign append_here = push && ((consume_head && occupied_q[i]) ||\n                                    (!consume_head && occupied_q[i-1] && !occupied_q[i]));\n    end else begin\n      assign append_here = push && ((consume_head && occupied_q[i] && !occupied_q[i+1]) ||\n                                    (!consume_head && occupied_q[i-1] && !occupied_q[i]));\n    end\n\n    if (i < DEPTH - 1) begin\n      always_ff @(posedge clock) begin\n        if (append_here) queue_q[i] <= received;\n        else if (consume_head) queue_q[i] <= updated[i+1];\n        else queue_q[i] <= updated[i];\n      end\n    end else begin\n      always_ff @(posedge clock) begin\n        if (append_here) queue_q[i] <= received;\n        else queue_q[i] <= updated[i];\n      end\n    end\n  end\n\n  assign out = empty ? received.payload : updated[0].payload;\n\"\"\"\n    else:\n        s += \"\"\"\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      head_q <= DEPTH'\"'(1);\n      tail_q <= DEPTH'(1);\n    end else begin\n      if (consume_head) head_q <= {head_q[DEPTH-2:0], head_q[DEPTH-1]};\n      if (push) tail_q <= {tail_q[DEPTH-2:0], tail_q[DEPTH-1]};\n    end\n  end\n\n  assign selected[0] = {\"'$bits(if_id_t){empty}} & received.payload;\n\n  for (genvar i = 0; i < DEPTH; i++) begin\n    always_ff @(posedge clock) begin\n      if (push && tail_q[i]) queue_q[i] <= received;\n      else queue_q[i] <= updated[i];\n    end\n    assign selected[i+1] = selected[i] | ({$bits(if_id_t){!empty && head_q[i]}} & updated[i].payload);\n  end\n\n  assign out = selected[DEPTH];\n\"\"\"\n    s = s.replace(\"  localparam integer COUNT_W = $clog2(DEPTH + 1);'\"\\\\n\\\", \\\"\\\").replace(\\\"  logic [DEPTH:0] append_pos;\\\\n  assign append_pos = {(occupied_q \"'^ (occupied_q << 1)), 1'\"'b0};\\\\n\\\", \\\"\\\")\n    s += \\\"\\\"\\\"\n  assign imem_addr = pc;\nendmodule\n\\\"\\\"\\\"\n    p.write_text(s)\nPY\npython3 \\\"\"'$profile_dir/variants.py\" \"$profile_dir\"\ncat > \"$profile_dir/run_variant.sh\" <<'\"'SH'\n#\"'!/usr/bin/env bash\nset -euo pipefail\nprofile_dir=\"$1\"\nvariant=\"$2\"\nsrc=\"$profile_dir/$variant\"\nfiles=(\"$src/core_pkg.sv\")\nfor path in \"$src\"/*.sv; do if [[ \"$path\" != \"$src/core_pkg.sv\" ]]; then files+=(\"$path\"); fi; done\nverilator --cc --exe --build -j 2 -Mdir \"$profile_dir/obj_$variant\" \"+incdir+$src\" --top-module core -Wall -Wno-fatal -Wno-style -CFLAGS '\"'-DNRET=1' \\\"\"'${files[@]}\" \"$profile_dir/eval.cpp\" -o variant_sim > \"$profile_dir/build_$variant.log\" 2>&1\n\"$profile_dir/obj_$variant/variant_sim\" \"$profile_dir/coremark.elf\" 10000000 --bench --istall --dstall > \"$profile_dir/$variant.jsonl\"\nSH\nprintf '\"'%s\\\\n' shift2f shift3f shift4f ring2f ring3f ring4f shift3n ring4n | xargs -P 4 -I '{}' bash \\\"\"'$profile_dir/run_variant.sh\" \"$profile_dir\" '\"'{}'\npython3 - \\\"\"'$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nimport json, sys\nroot = Path(sys.argv[1])\nfor p in sorted(list(root.glob('shift*.jsonl')) + list(root.glob('ring*.jsonl'))):\n    r = json.loads(p.read_text().splitlines()[-1])\n    print(p.name, r['bench_stop_cycle']-r['bench_start_cycle'], r['ebreak'], r['oob'], validate_coremark_uart(r['uart'], 10))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
