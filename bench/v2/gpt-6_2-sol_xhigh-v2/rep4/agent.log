{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom shutil import copytree, copy2\nimport tempfile\nrepo = Path.cwd()\nsource = Path('/srv/hwebench/tmp/58928045/727b862e/bench-divider.ppTzjH')\nscratch = Path(tempfile.mkdtemp(prefix='bench-two-bit-seed.', dir=source.parent))\nfor item in ('bench', 'fpga', 'test', 'cores/bench/rtl', 'cores/bench/test'):\n    copytree(repo / item, scratch / item)\nfor item in ('Makefile', 'cores/bench/core.yaml'):\n    copy2(repo / item, scratch / item)\npath = scratch / 'cores/bench/rtl/div_unit.sv'\noriginal = path.read_text()\nrtl = original.replace(original[:original.index('module div_unit')], '// RV32M divider with a two-bit launch seed.\\\\n')\nstart = rtl.index('  logic [27:0] dividend_tail;')\nend = rtl.index('  logic [33:0] triple_divisor_q;')\nrtl = rtl[:start] + '''  logic [31:0] a_magnitude, b_magnitude;\n  logic [9:0]  triple_narrow;\n  logic [9:0]  triple_narrow_q;\n  logic [9:0]  positive_narrow, negative_narrow;\n  logic [9:0]  neg_x, neg_y, neg_z;\n  logic [1:0]  a_prefix, seed_remainder, seed_quotient;\n  logic [3:0]  first_mid_remainder;\n  logic [5:0]  first_quotient;\n  logic [7:0]  first_remainder;\n  logic [3:0]  first_prefix;\n  logic [7:0]  final_prefix;\n''' + rtl[end:]\nstart = rtl.index('  // Each pair of bits')\nend = rtl.index('  function automatic logic [33:0] radix4_step', start)\nsignal = '''  function automatic logic [31:0] with_sign(input logic [31:0] value, input logic negate);\n    with_sign[7:0] = negate ? -value[7:0] : value[7:0];\n    with_sign[15:8] = negate ? (~value[15:8] + {7'b0, value[7:0] == 0}) : value[15:8];\n    with_sign[23:16] = negate ? (~value[23:16] + {7'b0, value[15:0] == 0}) : value[23:16];\n    with_sign[31:24] = negate ? (~value[31:24] + {7'b0, value[23:0] == 0}) : value[31:24];\n  endfunction\n\n  assign a_magnitude = with_sign(a, a_negative);\n  assign b_magnitude = with_sign(b, b_negative);\n  assign a_prefix = a_magnitude[31:30];\n\n  always_comb begin\n    case (b)\n      32'h0: {seed_quotient, seed_remainder} = {2'b11, a_prefix};\n      32'h1: {seed_quotient, seed_remainder} = {a_prefix, 2'b00};\n      32'h2: {seed_quotient, seed_remainder} = {1'b0, a_prefix[1], 1'b0, a_prefix[0]};\n      32'h3: {seed_quotient, seed_remainder} = (&a_prefix) ? 4'b0100 : {2'b00, a_prefix};\n      32'hffffffff: {seed_quotient, seed_remainder} = b_negative ? {a_prefix, 2'b00} : {2'b00, a_prefix};\n      32'hfffffffe: {seed_quotient, seed_remainder} = b_negative\n                             ? {1'b0, a_prefix[1], 1'b0, a_prefix[0]} : {2'b00, a_prefix};\n      32'hfffffffd: {seed_quotient, seed_remainder} = (b_negative && (&a_prefix))\n                             ? 4'b0100 : {2'b00, a_prefix};\n      default: {seed_quotient, seed_remainder} = {2'b00, a_prefix};\n    endcase\n  end\n\n  // Precompute the low divisor multiple needed in the first iteration.\n  assign positive_narrow = b[9:0] + {b[8:0], 1'b0};\n  assign neg_x = ~b[9:0];\n  assign neg_y = {~b[8:0], 1'b0};\n  assign neg_z = 10'd3;\n  assign negative_narrow = (neg_x \"'^ neg_y ''^ neg_z) +\n                              (((neg_x & neg_y) | ((neg_x | neg_y) & neg_z)) << 1);\n  assign triple_narrow = b_negative ? negative_narrow : positive_narrow;\n  assign first_iteration = (cycles_left_q == 3'\"'d7);\n  assign first_prefix = {remainder_q[1:0], dividend_quotient_q[31:30]};\n  assign final_prefix = {first_mid_remainder, dividend_quotient_q[29:26]};\n'''\ndef narrow(width, count, prefix, qname, rname):\n    result = [f'  wire [{width}:0] diff_{width} [{1}:{count-1}];',\n              f'  wire [{count-1}:0] take_{width};',\n              f'  assign take_{width}[0] = diff_{width}[1][{width}];']\n    # 2- or 4-bit digit. A multiple must also fit in the prefix width.\n    for digit in range(1,count):\n        m = f'digit_{width}_{digit}'\n        if digit in (1,2,4,8):\n            base, sh = 'divisor_q[7:0]', (digit.bit_length()-1)\n            expr = f\\\"({{4'b0, {base}}} << {sh})\\\"\n        elif digit in (3,6,12):\n            base, sh = 'triple_narrow_q', (digit//3).bit_length()-1\n            expr = f\\\"({{2'b0, {base}}} << {sh})\\\"\n        else:\n            base = \\\"{4'b0, divisor_q[7:0]}\\\"\n            terms = {5:[(2,'+'),(0,'+')],7:[(3,'+'),(0,'-')],9:[(3,'+'),(0,'+')],\n                     10:[(3,'+'),(1,'+')],11:[(3,'+'),(1,'+'),(0,'+')],\n                     13:[(3,'+'),(2,'+'),(0,'+')],14:[(4,'+'),(1,'-')],15:[(4,'+'),(0,'-')]}[digit]\n            expr = ' '.join((f'{sign} ' if i else '') + f'({base} << {sh})' for i,(sh,sign) in enumerate(terms))\n        result += [f'  wire [11:0] {m} = {expr};',\n                   f\\\"  assign diff_{width}[{digit}][{width-1}:0] = {prefix} - {m}[{width-1}:0];\\\",\n                   f\\\"  assign diff_{width}[{digit}][{width}] = (|{m}[11:{width}]) || ({prefix} < {m}[{width-1}:0]);\\\"]\n        upper = f' && diff_{width}[{digit+1}][{width}]' if digit+1 < count else ''\n        result += [f'  assign take_{width}[{digit}] = \"'!diff_{width}[{digit}][{width}]{upper};'\"']\n    qwidth = count.bit_length()-1\n    data = '_4' if width == 4 else '_8'\n    result += ['  always_comb begin',\n               f'    {rname} = ({{{width}{{take_{width}[0]}}}} & {prefix});',\n               f\\\"    {qname} = '0;\\\",\n               f'    for (int n = 1; n < {count}; n++) begin',\n               f'      {rname} |= ({{{width}{{take_{width}[n]}}}} & diff_{width}[n][{width-1}:0]);',\n               f'      {qname} |= ({{{qwidth}{{take_{width}[n]}}}} & n[{qwidth-1}:0]);',\n               '    end',\n               '    if (|divisor_q[31:8]) begin',\n               f'      {rname} = {prefix};',\n               f\\\"      {qname} = '0;\\\",\n               '    end',\n               '  end']\n    return '\\\\n'.join(result)\nnew_seed = narrow(4, 4, 'first_prefix', 'first_quotient[5:4]', 'first_mid_remainder') + '\\\\n'\nnew_seed += narrow(8, 16, 'final_prefix', 'first_quotient[3:0]', 'first_remainder') + '\\\\n\\\\n'\nrtl = rtl[:start] + signal + new_seed + rtl[end:]\nstart = rtl.index('      divisor_q            <= b_negative')\nend = rtl.index('      remainder_op_q       <= remainder_op;', start)\nrtl = rtl[:start] + '''      divisor_q            <= b_magnitude;\n      triple_narrow_q      <= triple_narrow;\n      dividend_quotient_q  <= {a_magnitude[29:0], seed_quotient};\n      remainder_q          <= {30'b0, seed_remainder};\n''' + rtl[end:]\nrtl = rtl.replace('{dividend_quotient_q[27:0], first_quotient}', '{dividend_quotient_q[25:0], first_quotient}')\nrtl = rtl.replace('assign result    = negate_q ? -magnitude : magnitude;', 'assign result    = with_sign(magnitude, negate_q);')\npath.write_text(rtl)\nprint(scratch)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
