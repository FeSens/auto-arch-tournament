{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'set -e\nscratch=$(mktemp -d -p \"$TMPDIR\" bench-rf-r4s0.XXXXXXXX)\nmkdir -p \"$scratch/cores/bench\"\ncp -R Makefile tools bench fpga test \"$scratch/\"\ncp -R cores/bench/rtl cores/bench/test cores/bench/core.yaml \"$scratch/cores/bench/\"\npython3 - \"$scratch\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\n\nrf = Path(sys.argv[1]) / 'cores/bench/rtl/reg_file.sv'\nsrc = rf.read_text().split('  logic [31:0] regs [0:31];')[0]\nrf.write_text(src + '''  logic [31:0] regs [1:31];\n  logic [31:1] rs1_select, rs2_select;\n\n  for (genvar word = 1; word < 32; word++) begin : g_word\n    localparam logic [4:0] INDEX = 5'(word);\n\n    always_ff @(posedge clock) begin\n      if (reset) regs[word] <= '0;\n      else if (w_en && w_addr == INDEX) regs[word] <= w_data;\n    end\n\n    assign rs1_select[word] = rs1_addr == INDEX;\n    assign rs2_select[word] = rs2_addr == INDEX;\n  end\n\n  logic [31:0] rs1_stored, rs2_stored;\n  for (genvar bit_index = 0; bit_index < 32; bit_index++) begin : g_read\n    logic [31:1] rs1_bits, rs2_bits;\n\n    for (genvar word = 1; word < 32; word++) begin : g_read_word\n      assign rs1_bits[word] = rs1_select[word] && regs[word][bit_index];\n      assign rs2_bits[word] = rs2_select[word] && regs[word][bit_index];\n    end\n\n    assign rs1_stored[bit_index] = |rs1_bits;\n    assign rs2_stored[bit_index] = |rs2_bits;\n  end\n\n  logic write_nonzero;\n  assign write_nonzero = w_en && w_addr \"'!= 0;\n  assign rs1_data = (write_nonzero && w_addr == rs1_addr) ? w_data : rs1_stored;\n  assign rs2_data = (write_nonzero && w_addr == rs2_addr) ? w_data : rs2_stored;\n\nendmodule\n'\"''')\nPY\necho \\\"\"'$scratch\"\ncd \"$scratch\"\nmake lint TARGET=bench'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
