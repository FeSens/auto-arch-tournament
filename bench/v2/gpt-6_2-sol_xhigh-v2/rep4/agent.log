{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c 'set -- single_mul_div narrowrad\ncat > \"$TMPDIR/r3s0/narrow_probe.py\" <<'\"'PY'\nimport os, shutil, sys\nfrom pathlib import Path\nfrom tools.eval import gowin\n\nroot = Path.cwd()\ntmp = Path(os.environ['TMPDIR']) / 'r3s0'\nbase, method = sys.argv[1:]\nrtl = tmp / f'{base}_{method}' / 'rtl'\nshutil.copytree(tmp / base / 'rtl', rtl, dirs_exist_ok=True)\n\np = rtl / 'div_unit.sv'\ns = p.read_text()\nif method == 'gate':\n    s = s.replace('if (diff[8] || |divisor_q[31:8])', 'if (diff[8])')\n    s = s.replace('      dividend_quotient_q  <= {dividend_quotient_q[27:0], narrow_quotient};', \\\"      dividend_quotient_q  <= {dividend_quotient_q[27:0], |divisor_q[31:8] ? 4'b0 : narrow_quotient};\\\")\n    s = s.replace(\\\"      remainder_q          <= {24'b0, narrow_remainder};\\\", \\\"      remainder_q          <= {24'b0, |divisor_q[31:8] ? {remainder_q[3:0], dividend_quotient_q[31:28]} : narrow_remainder};\\\")\nelse:\n    start = s.index('  // The first feedback iteration')\n    end = s.index('  // Try all nonzero', start)\n    s = s[:start] + \\\"\\\"\\\"  logic [9:0] narrow_triple;\n  logic [33:0] narrow_digit1, narrow_digit2;\n  assign narrow_triple = {2'b0, divisor_q[7:0]} + {1'b0, divisor_q[7:0], 1'b0};\n  assign narrow_digit1 = radix4({28'b0, remainder_q[3:0], dividend_quotient_q[31:30]},\n                                 {24'b0, divisor_q[7:0]}, {24'b0, narrow_triple});\n  assign narrow_digit2 = radix4({26'b0, narrow_digit1[5:0], dividend_quotient_q[29:28]},\n                                 {24'b0, divisor_q[7:0]}, {24'b0, narrow_triple});\n  assign narrow_quotient = |divisor_q[31:8] ? 4'b0 : {narrow_digit1[33:32], narrow_digit2[33:32]};\n  assign narrow_remainder = |divisor_q[31:8] ? {remainder_q[3:0], dividend_quotient_q[31:28]}\n                                              : narrow_digit2[7:0];\n\n\\\"\\\"\\\" + s[end:]\np.write_text(s)\nfor result in gowin.