ot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(name):\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', 1, variant / 'timing' / 'p1')\n    print(name, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n    list(executor.map(trial, ('masked_ex','masked_ex_retimed')))\nPY\"", "aggregated_output": "masked_ex_retimed 75.929 None [{'from': 'cpu/u_id/reg_q.rs2_sel_1_s0', 'to': 'cpu/u_ex/reg_q.alu_result_26_s0', 'slack_ns': -8.17, 'arrival_ns': 18.464, 'logic_cells': 11, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_mul', 'cpu/u_ex']}, {'from': 'cpu/u_id/reg_q.alu_b_sel_0_s0', 'to': 'cpu/u_ex/reg_q.alu_result_17_s0', 'slack_ns': -8.127, 'arrival_ns': 18.422, 'logic_cells': 9, 'modules': ['clock_ibuf', 'cpu/u_ex']}, {'from': 'cpu/u_id/reg_q.rs2_sel_1_s0', 'to': 'cpu/u_ex/reg_q.alu_result_29_s0', 'slack_ns': -8.083, 'arrival_ns': 18.378, 'logic_cells': 10, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_mul', 'cpu/u_ex']}]\nmasked_ex 77.739 None [{'from': 'cpu/u_mem/reg_q.write_value_21_s0', 'to': 'cpu/u_ex/reg_q.alu_result_29_s0', 'slack_ns': -7.864, 'arrival_ns': 18.158, 'logic_cells': 10, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_mul', 'cpu/u_ex']}, {'from': 'cpu/u_mem/reg_q.write_value_21_s0', 'to': 'cpu/u_ex/reg_q.alu_result_22_s0', 'slack_ns': -7.859, 'arrival_ns': 18.153, 'logic_cells': 10, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_mul', 'cpu/u_ex']}, {'from': 'cpu/u_mem/reg_q.write_value_21_s0', 'to': 'cpu/u_ex/reg_q.alu_result_25_s0', 'slack_ns': -7.842, 'arrival_ns': 18.136, 'logic_cells': 10, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_mul', 'cpu/u_ex']}]\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name, use_id_only in (('reset_id',True), ('reset_payload',False)):\n    variant = root / name\n    source = root / 'control'\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    rtl_dir = variant / 'cores/bench/rtl'\n    path = rtl_dir / 'id_stage.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace(\\\"    if (reset) begin\\\\n      reg_q <= '0;\\\\n    end else if (\"'!stall) begin\", \"    if (!stall) begin\")\n    rtl = rtl.replace('\"'      reg_q.valid    <= in.valid && \"'!flush;'\"\\\\n    end', '''    end\n    if (reset) reg_q.valid <= 1'b0;\n    else if (\"'!stall) reg_q.valid <= in.valid && !flush;'\"''')\n    path.write_text(rtl)\n    if use_id_only:\n        continue\n    path = rtl_dir / 'ex_stage.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace(\\\"    if (reset) begin\\\\n      reg_q <= '0;\\\\n    end else if (stall) begin\\\\n      // dmem stall: hold the EX/MEM register so the in-flight LOAD/STORE\\\\n      // stays in MEM stage waiting on the bus.\\\\n      reg_q <= reg_q;\\\\n    end else begin\\\", \\\"    if (\"'!stall) begin\")\n    rtl = rtl.replace(\"      reg_q.ctrl          <= transfer_valid ? ctrl_with_trap : '\"'0;\\\\n\\\", \\\"\\\")\n    rtl = rtl.replace('      reg_q.valid         <= transfer_valid;\\\\n    end', '''    end\n    if (reset) begin\n      reg_q.ctrl  <= '0;\n      reg_q.valid <= 1'b0;\n    end else if (\"'!stall) begin\n      reg_q.ctrl  <= transfer_valid ? ctrl_with_trap : '\"'0;\n      reg_q.valid <= transfer_valid;\n    end''')\n    path.write_text(rtl)\n    path = rtl_dir / 'mem_stage.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace(\\\"    if (reset) begin\\\\n      reg_q <= '0;\\\\n    end else if (hold_wb) begin\\\\n      // The held EX instruction can still select this MEM/WB value.\\\\n      reg_q.valid <= 1'b0;\\\\n    end else begin\\\\n      reg_q <= next_wb;\\\\n    end\\\", '''    if (\"'!hold_wb) reg_q[$bits(mem_wb_t)-1:1] <= next_wb[$bits(mem_wb_t)-1:1];\n    reg_q.valid <= next_wb.valid && !reset && !hold_wb;'\"''')\n    path.write_text(rtl)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(name):\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', 1, variant / 'timing' / 'p1')\n    print(name, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n    list(executor.map(trial, ('reset_id','reset_payload')))\nPY\"", "aggregated_output": "reset_payload 84.897 None [{'from': 'cpu/u_id/reg_q.alu_b_sel_1_s0', 'to': 'cpu/u_ex/reg_q.alu_result_30_s0', 'slack_ns': -6.779, 'arrival_ns': 17.073, 'logic_cells': 37, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_alu', 'cpu/u_ex']}, {'from': 'cpu/u_id/reg_q.rs2_sel_2_s0', 'to': 'cpu/u_if/select_indirect_q_s0', 'slack_ns': -6.774, 'arrival_ns': 17.069, 'logic_cells': 41, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_if', 'cpu/u_ex', 'cpu/u_id', 'cpu/u_if']}, {'from': 'cpu/u_id/reg_q.rs2_sel_2_s0', 'to': 'cpu/u_if/select_direct_q_s0', 'slack_ns': -6.774, 'arrival_ns': 17.069, 'logic_cells': 41, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_if', 'cpu/u_ex', 'cpu/u_id', 'cpu/u_if']}]\nreset_id 88.921 None [{'from': 'cpu/u_id/reg_q.rs1_sel_1_s0', 'to': 'cpu/u_ex/reg_q.alu_result_1_s0', 'slack_ns': -6.246, 'arrival_ns': 16.54, 'logic_cells': 7, 'modules': ['clock_ibuf', 'cpu/u_ex',