{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'work=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\ncp -r cores/bench/rtl \"$work/rtl-loop\"\npython3 - \"$work/rtl-loop\" <<'\"'PY'\nfrom pathlib import Path\nimport re, sys\n\nroot = Path(sys.argv[1])\np = root / 'if_stage.sv'\ns = p.read_text()\nheader, body = s.split('  localparam int QUEUE_DEPTH', 1)\nbody = re.sub(r'\\\\bimem_addr\\\\b', 'producer_pc', body)\nbody = re.sub(r'\\\\bimem_data\\\\b', 'producer_data', body)\nheader = header.replace('  output logic [31:0]       imem_addr,', '''  input  logic              loop_train,\n  input  logic [17:0]       loop_tail,\n  input  logic              invalidate_loop,\n  input  logic              accepted_store,\n  input  logic [29:0]       store_word,\n  output logic [31:0]       imem_addr,''')\nbody = body.replace('  logic [31:0] predicted_pc_q;', '''  logic [31:0] predicted_pc_q;\n  logic [31:0] producer_pc, producer_data;\n  logic stale_request_q, stale_request, bus_word_valid;\n  logic [31:0] held_request_q;''')\nbody = body.replace('  logic [31:0] sequential_pc, direct_target;', '''  assign stale_request = stale_request_q && \"'!recovery_pending_q;\n  assign imem_addr = stale_request ? held_request_q : producer_pc;\n  assign bus_word_valid = imem_ready && !stale_request;\n\n  logic [31:0] sequential_pc, direct_target;'\"''')\nbody = body.replace('  // Apply the corrected cycle', '''  always_ff @(posedge clock) begin\n    if (reset) begin\n      stale_request_q <= 1'b0;\n    end else begin\n      stale_request_q <= \"'!imem_ready && (stale_request || accept_fetch);\n    end\n    if (!imem_ready && !stale_request) held_request_q <= producer_pc;\n  end\n\n  logic [17:0] loop_first_q, loop_last_q, trained_first_q, trained_last_q;\n  logic        loop_update_q, loop_present_q, replace_loop, erase_loop;\n  logic [31:0] loop_valid_q;\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] loop_words [0:31];\n  logic        producer_in_loop, loop_hit, refill_loop;\n  logic [4:0]  loop_index;\n\n  assign replace_loop = loop_update_q && (!loop_present_q ||\n                         trained_first_q < loop_first_q || trained_last_q > loop_last_q);\n  assign erase_loop = invalidate_loop || (accepted_store && loop_present_q\n                      && store_word >= {12'\"'b0, loop_first_q}\n                      && store_word <= {12'b0, loop_last_q});\n  assign producer_in_loop = loop_present_q && producer_pc[31:20] == 12'b0 &&\n                            producer_pc[19:2] >= loop_first_q &&\n                            producer_pc[19:2] <= loop_last_q;\n  assign loop_index = producer_pc[6:2];\n  assign loop_hit = producer_in_loop && loop_valid_q[loop_index];\n  assign refill_loop = accept_fetch && bus_word_valid && producer_in_loop;\n  assign producer_data = bus_word_valid ? imem_data : loop_words[loop_index];\n\n  always_ff @(posedge clock) begin\n    if (loop_train) begin\n      trained_first_q <= ex_direct_target[19:2];\n      trained_last_q  <= loop_tail;\n    end\n    if (reset || invalidate_loop) begin\n      loop_update_q  <= 1'b0;\n      loop_present_q <= 1'b0;\n      loop_valid_q   <= '0;\n    end else begin\n      loop_update_q <= loop_train;\n      if (replace_loop) begin\n        loop_present_q <= 1'b1;\n        loop_first_q <= trained_first_q;\n        loop_last_q <= trained_last_q;\n      end\n      if (erase_loop || replace_loop) begin\n        loop_valid_q <= '0;\n      end else if (refill_loop) begin\n        loop_valid_q[loop_index] <= 1'b1;\n      end\n    end\n    if (refill_loop) loop_words[loop_index] <= imem_data;\n  end\n\n  // Apply the corrected cycle''')\nbody = body.replace('assign fetch_valid = imem_ready && \"'!parked_q;'\"', 'assign fetch_valid = (bus_word_valid || loop_hit) && \"'!parked_q;'\"')\np.write_text(header + '  localparam int QUEUE_DEPTH' + body)\n\np = root / 'core.sv'\ns = p.read_text().replace('  logic        train_valid;', '  logic        train_valid, loop_train, fence_i;')\ns = s.replace('    .imem_addr       (io_imemAddr),', '''    .loop_train      (loop_train),\n    .loop_tail       (id_ex_w.pc[19:2]),\n    .invalidate_loop (fence_i),\n    .accepted_store  (io_dmemReady && (|io_dmemWEn)),\n    .store_word      (io_dmemAddr[31:2]),\n    .imem_addr       (io_imemAddr),''')\ns = s.replace('    .train_counter   (train_counter)\\\\n', '''    .train_counter   (train_counter),\n    .loop_train      (loop_train),\n    .fence_i         (fence_i)\n''')\np.write_text(s)\n\np = root / 'ex_stage.sv'\ns = p.read_text().replace('  output logic [1:0]         train_counter\\\\n', '''  output logic [1:0]         train_counter,\n  output logic               loop_train,\n  output logic               fence_i\n''')\ns = s.replace('  assign redirect        = advance && (in.predicted_taken \"'!= actual_taken);'\"', '''  assign fence_i         = advance && (in.instr[14:12] == 3'b001) &&\n                           (in.instr[6:0] == 7'b0001111);\n  assign redirect        = (advance && (in.predicted_taken \"'!= actual_taken)) || fence_i;'\"''')\ns = s.replace('  // Saturation and the one-step', '''  assign loop_train = train_valid && direct_taken && (&in.imm[31:7]) && (|in.imm[6:2])\n                      && in.pc[31:20] == 12'b0 && direct_target[31:20] == 12'b0;\n\n  // Saturation and the one-step''')\np.write_text(s)\nPY\nRTL_DIR=\\\"\"'$work/rtl-loop\" OBJ_DIR=\"$work/obj-loop\" NRET=1 bash test/cosim/build.sh > \"$work/build-loop.log\" 2>&1 && \"$work/obj-loop/cosim_sim\" \"$work/coremark.elf\" 50000000 --bench --istall --dstall'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
