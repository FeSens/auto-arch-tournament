{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/recovery-research/unify.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])/'recovery-research'\n\ndef new(name,base='cores/bench/rtl'):\n    global variant\n    variant=root/name\n    shutil.copytree(base,variant,dirs_exist_ok=True)\n\ndef replace(file,old,new):\n    p=variant/file\n    s=p.read_text()\n    assert s.count(old)==1,(file,old)\n    p.write_text(s.replace(old,new))\n\ndef unify(cmp, capture):\n    p=variant/'ex_stage.sv'\n    s=p.read_text().replace('assign jalr_addr_low = rs1[1:0]', 'assign jalr_addr_low = alu_a[1:0]')\n    s=s.replace('(rs1),','(alu_a),').replace('(rs2),','(alu_b),')\n    s=s.replace('  <= rs1;', '  <= alu_a;').replace('  <= rs2;', '  <= alu_b;')\n    a=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n    b=s.index('\\\\n  assign branch_taken',a)\n    lines=s[a:b].replace('rs1','alu_a').replace('rs2','alu_b')\n    if cmp:\n        lines='''  logic cmp_eq, cmp_unsigned, cmp_signed;\n  assign cmp_eq = alu_a == alu_b;\n  assign cmp_unsigned = alu_a < alu_b;\n  assign cmp_signed = cmp_unsigned \"'^ alu_a[31] ''^ alu_b[31];\n  assign branch_cond = (in.ctrl.branch_op[2]\n                       ? (in.ctrl.branch_op[1] ? cmp_unsigned : cmp_signed)\n                       : cmp_eq) ''^ in.ctrl.branch_op[0];\n'\"'''\n    s=s[:a]+lines+s[b:]\n    if capture:\n        s=s.replace('assign sequential_pc  = in.pc + 32\\\\'d4;', 'assign sequential_pc  = in.sequential_pc;')\n    p.write_text(s)\n    if capture:\n        replace('core_pkg.sv','  // ID/EX register payload.\\\\n  typedef struct packed {\\\\n    logic [31:0] pc;', '''  // ID/EX register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] sequential_pc;''')\n        replace('id_stage.sv','      reg_q.pc       <= in.pc;','''      reg_q.pc       <= in.pc;\n      reg_q.sequential_pc <= in.pc + 32'd4;''')\n\ndef physicalwb():\n    replace('core_pkg.sv','    logic        reg_write;\\\\n    logic        trap;', '    logic        reg_write;\\\\n    logic        rf_valid;\\\\n    logic        trap;')\n    replace('mem_stage.sv','    next_wb.valid       = in.valid && \"'!retire_divide;'\"','    next_wb.valid       = in.valid && \"'!retire_divide;'\"\\\\n    next_wb.rf_valid    = in.valid;')\n    replace('mem_stage.sv','      reg_q.valid <= 1\\\\'b0;', '      reg_q.valid    <= 1\\\\'b0;\\\\n      reg_q.rf_valid <= 1\\\\'b0;')\n    replace('core.sv','''  wb_stage u_wb (\n    .in     (commit),\n    .w_en   (wb_w_en),\n    .w_addr (wb_w_addr),\n    .w_data (wb_w_data)\n  );''','''  logic rvfi_w_en;\n  logic [4:0] rvfi_w_addr;\n  logic [31:0] rvfi_w_data;\n  wb_stage u_wb (\n    .in     (commit),\n    .w_en   (rvfi_w_en),\n    .w_addr (rvfi_w_addr),\n    .w_data (rvfi_w_data)\n  );\n\n  assign wb_w_en   = mem_wb_w.rf_valid && mem_wb_w.reg_write && mem_wb_w.rd \"'!= 5'\"'b0;\n  assign wb_w_addr = mem_wb_w.rd;\n  assign wb_w_data = mem_wb_w.write_value;''')\n    replace('core.sv','wb_w_en ? wb_w_addr','rvfi_w_en ? rvfi_w_addr')\n    replace('core.sv','wb_w_en ? wb_w_data','rvfi_w_en ? rvfi_w_data')\n\nnew('unify')\nunify(False,False)\nnew('unicmp')\nunify(True,True)\nnew('rfwb')\nphysicalwb()\nPY\npython \\\"\"'$TMPDIR/recovery-research/unify.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" unify:1 unicmp:1 rfwb:1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
