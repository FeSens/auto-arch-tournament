{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os\nfrom pathlib import Path\n\np = Path(os.environ['TMPDIR']) / 'predictor-scratch/ring5wide/test/test_pipeline.py'\ns = p.read_text()\ns = s.replace('store_requests=stores, unready_fetches={(8, 6): program[5]})',\n              'store_requests=stores, unready_fetches={(28, 4): program[5], (32, 1): program[5]})')\ns = s.replace('''    branch_fetches = [i for i, (addr, _) in enumerate(fetches) if addr == 28]\n    assert len(branch_fetches) == 3\n    assert [fetches[i + 1] for i in branch_fetches[:2]] == [(8, True)] * 2\n    exit_fetch = branch_fetches[-1]\n    assert fetches[exit_fetch + 1:exit_fetch + 6] == [(8, True)] * 3 + [(8, False), (32, True)]\n''', '''    assert fetches[:18] == [\n        (0, True), (4, True), (28, True), (8, True), (12, True), (16, True),\n        (28, True), (8, True), (12, True), (16, True),\n        (24, True), (28, True), (8, True), (12, True), (16, True),\n        (28, False), (32, False), (32, True),\n    ], fetches\n''')\ns += '''\n\n@cocotb.test()\nasync def queue_fills_and_reopens_after_a_pop(dut):\n    program = [ADDI(1, 0, 7), SW(1, 0, 0x44)]\n    program += [ADDI(2, 2, 1)] * 8\n    program.append(EBREAK())\n    fetches, stores = [], []\n    rets, dmem = await _run(\n        dut, program, store_stalls=7, store_requests=stores,\n        fetch_requests=fetches, unready_fetches={(32, 4): SW(0, 0, 0x48)},\n    )\n    assert [r['pc'] for r in rets] == list(range(0, len(program) * 4, 4))\n    assert [r['order'] for r in rets] == list(range(len(program)))\n    assert [r['rd_wdata'] for r in rets[2:-1]] == list(range(1, 9))\n    assert [b['cycle'] - a['cycle'] for a, b in zip(rets[1:-1], rets[2:])] == [1] * 9\n    assert stores == [(0x44, 15, 7, False)] * 7 + [(0x44, 15, 7, True)]\n    assert dmem == {0x44: 7}\n    assert fetches[:14] == [\n        *[(pc, True) for pc in range(0, 32, 4)],\n        (32, True), (32, True), (32, True), (32, False), (32, True), (36, True),\n    ], fetches\n\n\n@cocotb.test()\nasync def stalled_jalr_uses_registered_address_and_clears_old_queue(dut):\n    program = [\n        ADDI(1, 0, 29),\n        ADDI(2, 0, 99),\n        SW(2, 0, 0x44),\n        JALR(3, 1, 0),\n        SW(0, 0, 0x48),\n        ADDI(3, 0, 0),\n        SW(0, 0, 0x4C),\n        ADDI(4, 3, 42),\n        EBREAK(),\n    ]\n    fetches, stores = [], []\n    rets, dmem = await _run(\n        dut, program, store_stalls=3, store_requests=stores,\n        fetch_requests=fetches, unready_fetches={(28, 1): program[4], (28, 2): program[4]},\n    )\n    assert [r['pc'] for r in rets] == [0, 4, 8, 12, 28, 32]\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert (rets[3]['pc_next'], rets[3]['rd_wdata'], rets[4]['rd_wdata']) == (28, 16, 58)\n    assert stores == [(0x44, 15, 99, False)] * 3 + [(0x44, 15, 99, True)]\n    assert dmem == {0x44: 99}\n    assert fetches[:11] == [\n        (0, True), (4, True), (8, True), (12, True), (16, True), (20, True),\n        (24, True), (28, False), (28, False), (28, True), (32, True),\n    ], fetches\n\n\n@cocotb.test()\nasync def last_word_parks_until_jalr_resolves(dut):\n    last = 0x000FFFFC\n    program = [NOP()] * (last // 4 + 1)\n    program[0] = JAL(0, last)\n    program[2] = EBREAK()\n    program[-1] = JALR(1, 0, 9)\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_requests=fetches,\n                         unready_fetches={(last, 1): NOP(), (8, 1): NOP()})\n    assert [r['pc'] for r in rets] == [0, last, 8]\n    assert rets[1]['pc_next'] == 8\n    assert rets[1]['rd_wdata'] == 0x00100000\n    assert fetches[:6] == [(0, True), (last, False), (last, True), (last, True),\n                          (8, False), (8, True)], fetches\n    assert all(pc <= last for pc, _ in fetches)\n'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
