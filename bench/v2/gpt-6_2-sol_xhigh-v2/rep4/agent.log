{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name in ('free_div_carry','free_div_shifter','free_div_shared_add'):\n    variant = root / name\n    source = root / 'free_div'\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    rtl_dir = variant / 'cores/bench/rtl'\n\n    if name == 'free_div_carry':\n        shutil.copy2(root / 'word_slices/cores/bench/rtl/alu.sv', rtl_dir / 'alu.sv')\n        continue\n\n    path = rtl_dir / 'alu.sv'\n    rtl = path.read_text()\n    if name == 'free_div_shifter':\n        rtl = rtl.replace('  always_comb begin', '''  logic shift_left, sign_fill;\n  logic [31:0] reversed_a, shift_input, shifted, reversed_shifted;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [32:0] extended_shift;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign shift_left = op == ALU_SLL;\n  assign sign_fill = (op == ALU_SRA) && a[31];\n  assign shift_input = shift_left ? reversed_a : a;\n  assign extended_shift = \"'$signed({sign_fill, shift_input}) >>> b[4:0];\n  assign shifted = extended_shift[31:0];\n  for (genvar bit_index = 0; bit_index < 32; bit_index++) begin : gen_reverse\n    assign reversed_a[bit_index] = a[31-bit_index];\n    assign reversed_shifted[bit_index] = shifted[31-bit_index];\n  end\n\n  always_comb begin'\"''')\n        rtl = rtl.replace('      ALU_SLL:    out = a << shamt;', '      ALU_SLL:    out = reversed_shifted;')\n        rtl = rtl.replace('      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"',\n                          '      ALU_SRL, ALU_SRA: out = shifted;')\n        rtl = rtl.replace('  logic        [4:0]  shamt;\\\\n', '').replace('    shamt = b[4:0];\\\\n','')\n        path.write_text(rtl)\n        continue\n\n    rtl = rtl.replace('  output logic [31:0] out', '  output logic [31:0] sum,\\\\n  output logic [31:0] out')\n    rtl = rtl.replace('  always_comb begin', '  assign sum = a + b;\\\\n\\\\n  always_comb begin')\n    rtl = rtl.replace('out = a + b;', 'out = sum;')\n    path.write_text(rtl)\n    path = rtl_dir / 'ex_stage.sv'\n    rtl = path.read_text().replace('  logic [31:0] alu_result;', '  logic [31:0] alu_result, effective_addr;')\n    rtl = rtl.replace('    .out (alu_result)', '    .sum (effective_addr),\\\\n    .out (alu_result)')\n    start = rtl.index('  // Loads, stores, and JALR add')\n    end = rtl.index('  // ── RV32M arithmetic', start)\n    rtl = rtl[:start] + '''  // Only JALR target bit 1 is needed on the branch eligibility path.\n  logic [1:0] link_low;\n  assign link_low = rs1[1:0] + in.addr_offset[1:0];\n\n''' + rtl[end:]\n    rtl = rtl.replace('addr_low[1]', 'link_low[1]').replace('\"'!effective_addr[1]'\"', '\"'!link_low[1]'\"')\n    path.write_text(rtl)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(name):\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', 1, variant / 'timing' / 'p1')\n    print(name, res['fmax_mhz'], res.get('reason'), res.get('logic'),res.get('critical_paths', [])[:2], flush=True)\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    list(executor.map(trial, ('free_div_carry','free_div_shifter','free_div_shared_add')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name in ('free_div_done','free_div_token'):\n    variant = root / name\n    source = root / 'free_div'\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    path = variant / 'cores/bench/rtl/div_unit.sv'\n    rtl = path.read_text()\n    if name == 'free_div_done':\n        rtl=rtl.replace('  assign done    = active_q && \"'!prepare_q && (cycles_left_q == 3'\"\\\\'d0);\\\\n','')\n        rtl=rtl.replace('    prepare_q <= launch;', '''    prepare_q <= launch;\n    if (reset) done <= 1'b0;\n    else if (iterate && cycles_left_q == 3'd1) done <= 1'b1;\n    else if (consume) done <= 1'b0;''')\n    else:\n        i = rtl.index('  logic       prepare_q')\n        j = rtl.index('\"'`ifdef RISCV_FORMAL_ALTOPS'\"')\n        rtl = rtl[:i] + '''  logic [7:0] phase_q;\n  logic       launch;\n  logic [4:0] op_q;\n  logic [31:0] a_q, b_q;\n\n  assign ready  = \"'!active_q;\n  assign launch = start && ready && !reset;\n\n  always_ff @(posedge clock) begin\n    if (launch) begin\n      op_q <= op;\n      a_q  <= a;\n      b_q  <= b;\n    end\n    if (reset) begin\n      active_q <= 1'\"'b0;\n      done     <= 1'b0;\n      phase_q  <= '0;\n    end else begin\n      phase_q <= {phase_q[6:0], launch};\n      if (launch) active_q <= 1'b1;\n      else if (done && consume) active_q <= 1'b0;\n      done <= phase_q[7] || (done && \"'!consume);\n    end\n  end\n\n'\"''' + rtl[j:]\n        rtl = rtl.replace('if (prepare_q && \"'!reset)'\"', 'if (phase_q[0] && \"'!reset)'\"')\n    path.write_text(rtl)\n\nfree = root / 'free_div'\nfor relative in ('cores/bench/test','test/cosim','bench/programs'):\n    shutil.copytree(Path.cwd() / relative, free / relative, dirs_exist_ok=True)\nshutil.copy2(Path.cwd() / 'Makefile', free / 'Makefile')\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(task):\n    name,option=task\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', option, variant / 'timing' / f'p{option}')\n    print(name, option, res['fmax_mhz'], res.get('reason'), res.get('logic'),res.get('critical_paths', [])[:2], flush=True)\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    list(executor.map(trial, [('free_div_done',1),('free_div_token',1),('free_div',2)]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
