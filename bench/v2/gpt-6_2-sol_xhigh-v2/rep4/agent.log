{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -c 'set -e\nscratch_root=\"$TMPDIR/bench-r8s1-trained\"\ncat >>\"$scratch_root/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\nasync def mapped_edge_direct_jump_recovers_to_full_backward_target(dut):\n    last = 0x000FFFFC\n    target = 0x80\n    program = {\n        0: JAL(0, last),\n        last: JAL(1, target - last),\n        target: ADDI(2, 1, 1),\n        target + 4: EBREAK(),\n    }\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_requests=fetches,\n                         unready_fetches={(target, 1): SW(1, 0, 0x44)})\n    assert all(0 <= pc <= last and pc % 4 == 0 for pc, _ in fetches)\n    assert [rec[\\\"pc\\\"] for rec in rets] == [0, last, target, target + 4]\n    assert [rec[\\\"order\\\"] for rec in rets] == list(range(len(rets)))\n    assert (rets[1][\\\"pc_next\\\"], rets[1][\\\"rd_wdata\\\"], rets[1][\\\"trap\\\"]) == (target, last + 4, 0)\n    assert rets[2][\\\"rd_wdata\\\"] == last + 5\nPY\ncd \\\"\"'$scratch_root\"\npytest -q test/test_pipeline.py > directed-all-summary.log 2>&1\ntail -8 directed-all-summary.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
