\n    s=s.replace('  assign wait_for_recovery_word = recovery_pending_q && \"'!imem_ready;'\"', '  assign wait_for_recovery_word = recovery_pending_q;')\n    s=s.replace('& request_pc[19:2]);', '& (recovery_pending_q ? request_pc[19:2] : predicted_pc_q[19:2]));')\n    s=s.replace('''    end else if (accept_bus || accept_replay || recovery_pending_q) begin''','''    end else if (recovery_pending_q) begin\n      predicted_pc_q        <= request_pc;\n      predicted_in_window_q <= request_in_window;\n      predicted_last_word_q <= request_last_word;\n    end else if (accept_bus || accept_replay) begin''')\n    s=s.replace('|| ((accept_bus || recovery_pending_q) && request_in_window);','|| (accept_bus && predicted_in_window_q);').replace('|| ((accept_bus || recovery_pending_q) && request_last_word);','|| (accept_bus && predicted_last_word_q);')\n    s=s.replace('& (recovery_pending_q ? request_pc[19:2] : predicted_pc_q[19:2]));', '& predicted_pc_q[19:2]);').replace('     | ({12{wait_for_recovery_word}} & request_pc[31:20]);',';')\n    s=s.replace('assign bus_word.word_pc          = request_pc[31:2];','assign bus_word.word_pc          = predicted_pc_q[31:2];').replace('assign bus_word.last_mapped_word = request_last_word;','assign bus_word.last_mapped_word = predicted_last_word_q;')\n    s=s.replace('fill_index_q  <= request_pc[', 'fill_index_q  <= predicted_pc_q[').replace(\\\"fill_record_q <= {1'b1, request_pc[\\\", \\\"fill_record_q <= {1'b1, predicted_pc_q[\\\")\n    s=s.replace(\\\"l0_fill_index_q <= request_pc[\\\", \\\"l0_fill_index_q <= predicted_pc_q[\\\").replace(\\\"l0_fill_record_q <= {request_pc[\\\", \\\"l0_fill_record_q <= {predicted_pc_q[\\\")\n    s=s.replace('&& request_in_window', '&& predicted_in_window_q')\n    s=s.replace('&& \"'!request_last_word'\"', '&& \"'!predicted_last_word_q'\"')\n    s=s.replace('assign park = accept_bus && request_last_word;', 'assign park = accept_bus && predicted_last_word_q;')\n    s=s.replace('assign select_park_pc = request_last_word || wait_for_recovery_word;', 'assign select_park_pc = predicted_last_word_q;')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/hyp_profile/recovery_stage_proto.py\"\nfor variant in recover_stage seq32_recover_stage; do\n  bash \"$TMPDIR/hyp_profile/build_variant.sh\" \"$variant\" &\ndone\nwait'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
