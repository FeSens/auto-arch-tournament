{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\nfrom jsonschema import Draft7Validator\nimport json\nimport yaml\n\nroot = Path('cores/bench')\nhyp_id = 'hyp-20261121-001-r5s0'\npath = root / 'experiments' / 'hypotheses' / (hyp_id + '.yaml')\ndoc = yaml.safe_load(path.read_text())\nschema = json.loads(Path('schemas/hypothesis.schema.json').read_text())\nDraft7Validator(schema).validate(doc)\nassert doc['id'] == hyp_id\nassert doc['category'] == 'micro_opt'\nassert type(doc['expected_impact']['fitness_delta_pct']) is int\nassert all((root / change['file']).is_file() for change in doc['changes'])\nscratch_tests = Path(os.environ['TMPDIR']) / 'rv32-bypass' / root / 'test'\ncount = 0\nfor result in scratch_tests.glob('*.result.xml'):\n    tree = ET.parse(result)\n    assert not tree.findall('.//failure') and not tree.findall('.//error')\n    cases = [case for case in tree.findall('.//testcase') if case.find('skipped') is None]\n    if result.name == 'test_pipeline_runner.result.xml':\n        names = {case.attrib['name'] for case in cases}\n        assert {'bypass_priority_and_trapping_writers', 'held_load_feeds_consumer_behind_stalled_store'} <= names\n    count += len(cases)\nprint(f'Schema valid. Scratch cocotb cases passed: {count}')\nPY\ngit diff --exit-code\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
