{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'work=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\npython3 - \"$work\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport sys\nfrom pathlib import Path\nfrom tools.eval import gowin\nwork = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futures = [pool.submit(gowin.build, Path.cwd(), work / 'rtl-loop', 'fpga/core_bench_si.sv', i, work / f'gowin-loop-p{i}') for i in range(3)]\n    for f in futures:\n        print(f.result(), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'work=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\npython3 - \"$work/ref-trace.jsonl.gz\" <<'\"'PY'\nimport gzip, json, collections, sys\ncounts = collections.Counter()\nsizes = collections.Counter()\nregion = None\ncovered = 0\ntotal = 0\nwith gzip.open(sys.argv[1], 'rt') as trace:\n for line in trace:\n  rec = json.loads(line)\n  addr, nxt, insn = rec['pc_rdata'], rec['pc_wdata'], rec['insn']\n  size = (addr - nxt) // 4 + 1\n  if not 14126 <= rec['cycle'] <= 3970230:\n   continue\n  total += 1\n  if region is not None and region[0] <= addr <= region[1]:\n   covered += 1\n  if insn & 0x7f == 0x63 and 1 < size <= 32:\n   counts[nxt, addr] += 1\n   sizes[size] += 1\n   if region is None or (nxt < region[0] or addr > region[1]):\n    region = (nxt, addr)\nprint(f'{total=} {covered=} {covered/total:.4%}')\nprint('top backedges', [(hex(h),hex(t),(t-h)//4+1,n) for ((h,t),n) in counts.most_common(20)])\nprint('backedge counts by span', sorted(sizes.items()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
