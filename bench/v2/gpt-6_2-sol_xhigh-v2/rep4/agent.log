{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"python - '/srv/hwebench/tmp/58928045/0e90a360/bench-r12s0.WfYhLO/cores/bench/rtl/if_stage.sv' <<'PY'\nfrom pathlib import Path\nimport sys\npath = Path(sys.argv[1])\ns = path.read_text()\nstart = s.index(\\\"  // Explicit vectors keep\\\")\nend = s.index(\\\"  // Once replay advances\\\", start)\ns = s[:start] + \\\"\\\"\\\"  // The fixed head drives decode. The tail selects its oldest entry\n  // in parallel with issue, so the tail mux is off the decode path.\n  localparam int TAIL_DEPTH = QUEUE_DEPTH - 1;\n  localparam logic [TAIL_DEPTH-1:0] FIRST_TAIL_SLOT = 4'b0001;\n\n  logic [SLOT_WIDTH-1:0] tail_slots_q [0:TAIL_DEPTH-1];\n  fetch_slot_t bus_word, produced, head_q, next_head, tail_head, head;\n  logic [TAIL_DEPTH-1:0] tail_read_q, tail_write_q;\n  logic [QUEUE_DEPTH-1:0] occupancy_q, occupancy;\n  logic [QUEUE_DEPTH-1:0] occupancy_on_hold, occupancy_on_issue;\n  logic empty, full, bus_valid, accept_replay, accept_word;\n  logic tail_push, tail_pop;\n  logic step_bus_taken, step_bus_sequential, step_outside_window;\n  logic wait_for_recovery_word, retain_request;\n  logic bus_successor_last_word, replay_last_word;\n  logic [17:0] replay_next_word;\n\n  // Apply the corrected cycle's handshakes to a fresh queue.\n  assign occupancy = occupancy_q & {QUEUE_DEPTH{\"'!recovery_pending_q}};\n  assign empty     = !occupancy[0];\n  assign full      = occupancy[QUEUE_DEPTH-1];\n\n  assign bus_word.word_pc          = request_pc[31:2];\n  assign bus_word.instr            = imem_data;\n  assign bus_word.predicted_taken  = predict_taken;\n  assign bus_word.last_mapped_word = request_last_word;\n  assign produced.word_pc          = bus_word.word_pc;\n  assign produced.instr            = bus_valid ? bus_word.instr : replay_prediction.instr;\n  assign produced.predicted_taken  = bus_valid ? bus_word.predicted_taken : replay_prediction.taken;\n  assign produced.last_mapped_word = bus_word.last_mapped_word;\n\n  always_comb begin\n    tail_head = '\"'0;\n    for (int slot = 0; slot < TAIL_DEPTH; slot++) begin\n      tail_head |= {SLOT_WIDTH{tail_read_q[slot]}} & tail_slots_q[slot];\n    end\n  end\n\n  assign head = empty ? bus_word : head_q;\n  assign out.pc               = {head.word_pc, 2'b00};\n  assign out.instr            = head.instr;\n  assign out.predicted_taken  = head.predicted_taken;\n  assign out.last_mapped_word = head.last_mapped_word;\n  assign out.valid            = \"'!empty || bus_valid;\n\n  assign bus_valid = imem_ready && (recovery_pending_q || (!parked_q && !stale_request_q));\n  assign accept_bus = bus_valid && !full;\n  assign accept_replay = (|replay_match) && predicted_in_window_q && !parked_q\n                      && !recovery_pending_q && !full && (!imem_ready || stale_request_q);\n  assign accept_word = accept_bus || accept_replay;\n  assign park = accept_bus && request_last_word;\n\n  assign next_head = occupancy[1] ? tail_head : produced;\n  always_ff @(posedge clock) begin\n    if (empty || !issue_hold) head_q <= next_head;\n  end\n\n  // A held head appends to the tail. With only one buffered word, an\n  // issuing head is replaced directly by the producer, if accepted.\n  assign tail_pop  = occupancy[1] && !issue_hold;\n  assign tail_push = accept_word && !empty && (occupancy[1] || issue_hold);\n  for (genvar slot = 0; slot < TAIL_DEPTH; slot++) begin : gen_tail\n    // An unoccupied tail slot can be written independently of issue.\n    always_ff @(posedge clock) begin\n      if (!empty && !full && tail_write_q[slot]) tail_slots_q[slot] <= produced;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || recovery_pending_q) begin\n      tail_read_q  <= FIRST_TAIL_SLOT;\n      tail_write_q <= FIRST_TAIL_SLOT;\n    end else begin\n      if (tail_pop)  tail_read_q  <= {tail_read_q[TAIL_DEPTH-2:0], tail_read_q[TAIL_DEPTH-1]};\n      if (tail_push) tail_write_q <= {tail_write_q[TAIL_DEPTH