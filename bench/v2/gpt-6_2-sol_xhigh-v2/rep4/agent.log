{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r13-replay/prototype.py\" <<'\"'PY'\nimport sys\nimport shutil\nfrom pathlib import Path\n\nout = Path(sys.argv[1])\nbuffer_log = int(sys.argv[2])\nblock_log = int(sys.argv[3])\noptions = set(sys.argv[4:])\nout.mkdir(parents=True, exist_ok=True)\nfor path in Path(\\\"cores/bench/rtl\\\").glob(\\\"*.sv\\\"):\n    shutil.copy(path, out / path.name)\n\npath = out / 'if_stage.sv'\nsv = path.read_text()\na = sv.index(\\\"  // A synchronous lookup starts\\\")\nb = sv.index(\\\"  // Explicit vectors\\\", a)\nlogic = \\\"\\\"\\\"\n  // Read all lanes of the same aligned block.\n  localparam int LANE_BITS = BLOCK_LOG;\n  localparam int BLOCK_BITS = 18 - LANE_BITS;\n  localparam int INDEX_BITS = 10 - LANE_BITS;\n  localparam int LANES = 1 << LANE_BITS;\n  localparam int BUFFER_BITS = BUFFER_LOG;\n  localparam int BUFFER_SLOTS = 1 << BUFFER_BITS;\n\n  typedef struct packed {\n    logic [31:0] instr;\n    logic        taken;\n    logic [17:0] successor;\n    logic        next_last;\n  } prediction_t;\n  typedef struct packed {\n    logic valid;\n    logic [7:0] tag;\n    prediction_t prediction;\n  } prediction_record_t;\n  localparam int PAYLOAD_WIDTH = 52;\n  localparam int RECORD_WIDTH = 61;\n\n  prediction_t replay_prediction;\n  prediction_record_t fill_record_q;\n  logic [9:0] fill_index_q;\n  logic [INDEX_BITS-1:0] sweep_index_q, ram_write_index;\n  logic fill_pending_q, sweeping_q, accept_bus;\n  logic [RECORD_WIDTH-1:0] ram_write_data;\n  logic [17:0] lookahead_word;\n  logic [BLOCK_BITS-1:0] lookup_block_q, lookup_block, producer_block;\n  logic [BUFFER_BITS-1:0] producer_slot, lookup_slot;\n  logic lookup_valid_q, buffer_hit;\n  logic [LANES-1:0] lane_hit;\n  logic [PAYLOAD_WIDTH-1:0] selected_lane [0:LANES-1];\n\n  assign lookahead_word = predicted_pc_q[19:2] + 18'dLEAD;\n  assign lookup_block = lookahead_word[17:LANE_BITS];\n  assign producer_block = predicted_pc_q[19:2+LANE_BITS];\n  assign producer_slot = producer_block[BUFFER_BITS-1:0] HASH_PRODUCER;\n  assign lookup_slot = lookup_block_q[BUFFER_BITS-1:0] HASH_LOOKUP;\n  assign ram_write_index = sweeping_q ? sweep_index_q : fill_index_q[9:LANE_BITS];\n  assign ram_write_data = sweeping_q ? '0 : fill_record_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) begin\n      sweeping_q <= 1'b1;\n      sweep_index_q <= '0;\n      fill_pending_q <= 1'b0;\n      lookup_valid_q <= 1'b0;\n    end else begin\n      if (sweeping_q) begin\n        sweep_index_q <= sweep_index_q + 1'b1;\n        sweeping_q <= \"'!(&sweep_index_q);\n      end\n      fill_pending_q <= !sweeping_q && accept_bus && request_in_window && !request_last_word;\n      lookup_valid_q <= !sweeping_q && predicted_in_window_q LOOK_LIMIT;\n    end\n\n    fill_index_q <= request_pc[11:2];\n    fill_record_q <= {1'\"'b1, request_pc[19:12], imem_data, predict_taken,\n                      predict_taken ? target_word : sequential_word,\n                      predict_taken ? target_last_word : sequential_last_word};\n    lookup_block_q <= lookup_block;\n  end\n\n  for (genvar lane = 0; lane < LANES; lane++) begin : gen_ram\n    (* syn_ramstyle = \\\"block_ram\\\" *) logic [RECORD_WIDTH-1:0] prediction_ram [0:(1<<INDEX_BITS)-1];\n    prediction_record_t lookup_record_q;\n    logic lane_fill, lane_valid_q, lane_store;\n    logic [BUFFER_SLOTS-1:0] slot_match;\n    logic [PAYLOAD_WIDTH-1:0] slot_payload [0:BUFFER_SLOTS-1];\n    logic [PAYLOAD_WIDTH-1:0] fetched_payload;\n\n    assign lane_fill = fill_pending_q && fill_index_q[LANE_BITS-1:0] == LANE_BITS'(lane);\n    assign lane_store = lookup_valid_q && lane_valid_q && lookup_record_q.valid\n                        && lookup_record_q.tag == lookup_block_q[BLOCK_BITS-1:INDEX_BITS]\n                        && \"'!( (&lookup_block_q) && lane == LANES-1);\n    always_ff @(posedge clock) begin\n      if (!reset && !fence_i && (sweeping_q || lane_fill))\n        prediction_ram[ram_write_index] <= ram_write_data;\n      lookup_record_q <= prediction_ram[lookup_block[INDEX_BITS-1:0]];\n      lane_valid_q <= !(lane_fill && fill_index_q[9:LANE_BITS] == lookup_block[INDEX_BITS-1:0]);\n    end\n\n    for (genvar slot = 0; slot < BUFFER_SLOTS; slot++) begin : gen_buf\n      logic valid_q;\n      logic [BLOCK_BITS-1:0] block_q;\n      logic [PAYLOAD_WIDTH-1:0] payload_q;\n      assign slot_payload[slot] = payload_q;\n      assign slot_match[slot] = valid_q && block_q == producer_block\n                             && predicted_pc_q[LANE_BITS+1:2] == LANE_BITS'\"'(lane);\n      always_ff @(posedge clock) begin\n        if (reset || fence_i) valid_q <= 1'b0;\n        else if (lane_store && lookup_slot == BUFFER_BITS'(slot)) begin\n          valid_q <= 1'b1;\n          block_q <= lookup_block_q;\n          payload_q <= lookup_record_q.prediction;\n        end\n      end\n    end\n    assign lane_hit[lane] = |slot_match;\n    always_comb begin\n      fetched_payload = '0;\n      for (int slot = 0; slot < BUFFER_SLOTS; slot++) begin\n        fetched_payload |= {PAYLOAD_WIDTH{slot_match[slot]}} & slot_payload[slot];\n      end\n    end\n    assign selected_lane[lane] = fetched_payload;\n  end\n\n  always_comb begin\n    replay_prediction = '0;\n    for (int lane = 0; lane < LANES; lane++) begin\n      replay_prediction |= selected_lane[lane];\n    end\n  end\n  assign buffer_hit = |lane_hit;\n\\\"\\\"\\\"\nlogic = logic.replace(\\\"BLOCK_LOG\\\", str(block_log)).replace(\\\"BUFFER_LOG\\\", str(buffer_log))\nlogic = logic.replace(\\\"LOOK_LIMIT\\\", \\\"&& \"'!( (&predicted_pc_q[19:4]) && (|predicted_pc_q[3:2]))\")\nlogic = logic.replace(\"LEAD\", \"2\")\nfor name, word in [('\"'PRODUCER', 'producer_block'), ('LOOKUP', 'lookup_block_q')]:\n    logic = logic.replace(\\\"HASH_\\\" + name, f\\\"\"'^ {word}[BUFFER_BITS+3:4]\" if '\"'hash' in options else '')\nlogic = logic.replace(\\\"  logic [BUFFER_BITS-1:0] producer_slot, lookup_slot;\\\", \\\"  logic [BUFFER_BITS-1:0] lookup_slot;\\\")\nlogic = '\\\\n'.join(l for l in logic.split('\\\\n') if 'assign producer_slot' not in l)\nsv = sv[:a] + logic + \\\"\\\\n\\\" + sv[b:]\nsv = sv.replace(\\\"(|replay_match)\\\", \\\"buffer_hit\\\")\na = sv.index(\\\"  assign replay_next_word =\\\")\nb = sv.index(\\\"  // When a corrected\\\", a)\nsv = sv[:a] + \\\"\\\"\\\"  assign replay_next_word = replay_prediction.successor;\n  assign replay_last_word = replay_prediction.next_last;\n\n\\\"\\\"\\\" + sv[b:]\npath.write_text(sv)\nPY\npython \\\"\"'$TMPDIR/r13-replay/prototype.py\" \"$TMPDIR/r13-replay/b4/rtl\" 2 2\npython \"$TMPDIR/r13-replay/prototype.py\" \"$TMPDIR/r13-replay/b8/rtl\" 3 2 hash\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
