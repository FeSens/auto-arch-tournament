ence_no_borrow = {1'b0, x} - {1'b0, y};\n      wire [7:0] difference_with_borrow = x + ~y;\n      assign borrow_generated[chunk] = difference_no_borrow[8];\n      assign borrow_propagated[chunk] = x == y;\n      assign differences[digit][chunk*8 +: 8] = borrow_in[chunk] ? difference_with_borrow : difference_no_borrow[7:0];\n    end\n    assign differences[digit][32] = (shifted_remainder[35:32] < multiples_q[digit][35:32])\n      | ((shifted_remainder[35:32] == multiples_q[digit][35:32]) & borrow_in[4]);''')\nassert 'difference_no_borrow' in rtl\npath.write_text(rtl)\nprint(scratch)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
