{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\nrng=Random(7122)\npairs=[]\nfor divisor in range(1,8192):\n q=(2**32-1)//divisor\n for multiple in (q,q//2,rng.randrange(q+1)):\n  for d in (-1,0,1):\n   a=divisor*multiple+d\n   if 0<=a<2**32:\n    pairs.append((a,divisor))\nfor _ in range(500000):\n pairs.append((rng.getrandbits(32),rng.randrange(1,2**rng.randrange(1,33))))\ncorrections=0\nfor a,b in pairs:\n s=32-b.bit_length()\n norm=b<<s\n seed=(1<<23)//((norm>>21)+1)\n nr0=a*seed>>10\n err0=((1<<44)-norm*seed)>>10\n f0=err0>>12\n nr1=nr0+(nr0*f0>>22)\n err1=(err0&4095)+(err0*f0>>22)\n nr2=nr1+(nr1*err1>>34)\n guess=nr2>>(34-s)\n expected=a//b\n assert err0<2**25 and err1<2**15 and expected-1<=guess<=expected, (a,b,guess,expected,err0,err1)\n corrections+=expected\"'!=guess\nprint(len(pairs), '\"'quotient estimates checked,',corrections,'required correction')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
