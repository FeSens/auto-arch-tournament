{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom shutil import copytree, copy2\nrepo = Path.cwd()\nscratch = Path('/srv/hwebench/tmp/58928045/727b862e/bench-divider.ppTzjH')\nfor item in ('bench', 'fpga', 'test', 'cores/bench/rtl', 'cores/bench/test'):\n    copytree(repo / item, scratch / item)\nfor item in ('Makefile', 'cores/bench/core.yaml'):\n    copy2(repo / item, scratch / item)\npath = scratch / 'cores/bench/rtl/div_unit.sv'\nsource = path.read_text()\nhead = source[:source.index('\"'`else'\"')]\nhead = '// Fixed-latency RV32M restoring divider.\\\\n' + head[head.index('module div_unit'):]\nhead = head.replace('logic [31:0] alt_result_q;', '''logic [31:0] alt_result_q;''')\nnative = r'''\"'`else\n  logic signed_op, remainder_op, a_negative, b_negative;\n  logic remainder_op_q, negate_q;\n  logic [31:0] a_abs_q, d_q;\n  logic [31:0] rq_q, remainder_q;\n  logic [35:0] multiples_q [1:15];\n  logic [35:0] shifted_remainder;\n  logic [36:0] differences [1:15];\n  logic [15:0] take;\n  logic [31:0] next_remainder;\n  logic [3:0] next_digit;\n  logic [3:0] narrowed_digit_hi, narrowed_digit_lo;\n  logic [3:0] narrowed_remainder_hi;\n  logic [7:0] narrowed_remainder_lo;\n  logic [7:0] seed_quotient, seed_remainder;\n  logic [31:0] magnitude;\n\n  function automatic logic [31:0] with_sign(input logic [31:0] value, input logic negate);\n    with_sign[7:0] = negate ? -value[7:0] : value[7:0];\n    with_sign[15:8] = negate ? (~value[15:8] + {7'\"'b0, value[7:0] == 0}) : value[15:8];\n    with_sign[23:16] = negate ? (~value[23:16] + {7'b0, value[15:0] == 0}) : value[23:16];\n    with_sign[31:24] = negate ? (~value[31:24] + {7'b0, value[23:0] == 0}) : value[31:24];\n  endfunction\n\n  function automatic logic [35:0] add_three(\n    input logic [35:0] x, input logic [35:0] y, input logic [35:0] z\n  );\n    add_three = (x \"'^ y ''^ z) + (((x & y) | ((x | y) & z)) << 1);\n  endfunction\n\n  logic [35:0] d;\n  assign d = {4'\"'b0, d_q};\n  always_ff @(posedge clock) begin\n    if (iterate && cycles_left_q == 3'd7) begin\n      multiples_q[1] <= d;\n      multiples_q[2] <= d << 1;\n      multiples_q[3] <= (d << 1) + d;\n      multiples_q[4] <= d << 2;\n      multiples_q[5] <= (d << 2) + d;\n      multiples_q[6] <= (d << 2) + (d << 1);\n      multiples_q[7] <= (d << 3) - d;\n      multiples_q[8] <= d << 3;\n      multiples_q[9] <= (d << 3) + d;\n      multiples_q[10] <= (d << 3) + (d << 1);\n      multiples_q[11] <= add_three(d << 3, d << 1, d);\n      multiples_q[12] <= (d << 3) + (d << 2);\n      multiples_q[13] <= add_three(d << 3, d << 2, d);\n      multiples_q[14] <= (d << 4) - (d << 1);\n      multiples_q[15] <= (d << 4) - d;\n    end\n  end\n\n  assign shifted_remainder = {remainder_q, rq_q[31:28]};\n  assign take[0] = differences[1][36];\n\n  for (genvar digit = 1; digit <= 15; digit++) begin : wide\n    assign differences[digit] = {1'b0, shifted_remainder} - {1'b0, multiples_q[digit]};\n    if (digit == 15) begin\n      assign take[digit] = \"'!differences[digit][36];\n    end else begin\n      assign take[digit] = !differences[digit][36] && differences[digit+1][36];\n    end\n  end\n\n  always_comb begin\n    next_remainder = {32{take[0]}} & shifted_remainder[31:0];\n    next_digit = '\"'0;\n    for (int digit = 1; digit <= 15; digit++) begin\n      next_remainder |= {32{take[digit]}} & differences[digit][31:0];\n      next_digit |= {4{take[digit]}} & digit[3:0];\n    end\n  end\n\n  wire [7:0] low_prefix = {narrowed_remainder_hi, a_abs_q[27:24]};\n  wire [8:0] high_diff [1:15];\n  wire [12:0] low_diff [1:15];\n  wire [15:0] take_hi, take_lo;\n  assign take_hi[0] = high_diff[1][8];\n  assign take_lo[0] = low_diff[1][12];\n\n  for (genvar digit = 1; digit <= 15; digit++) begin : narrow\n    wire [7:0] high_multiple = d_q[3:0] * digit;\n    wire [11:0] low_multiple = d_q[7:0] * digit;\n    assign high_diff[digit] = {5'b0, a_abs_q[31:28]} - {1'b0, high_multiple};\n    assign low_diff[digit] = {5'b0, low_prefix} - {1'b0, low_multiple};\n    if (digit == 15) begin\n      assign take_hi[digit] = \"'!high_diff[digit][8];\n      assign take_lo[digit] = !low_diff[digit][12];\n    end else begin\n      assign take_hi[digit] = !high_diff[digit][8] && high_diff[digit+1][8];\n      assign take_lo[digit] = !low_diff[digit][12] && low_diff[digit+1][12];\n    end\n  end\n\n  always_comb begin\n    narrowed_remainder_hi = {4{take_hi[0]}} & a_abs_q[31:28];\n    narrowed_digit_hi = '\"'0;\n    narrowed_remainder_lo = {8{take_lo[0]}} & low_prefix;\n    narrowed_digit_lo = '0;\n    for (int digit = 1; digit <= 15; digit++) begin\n      narrowed_remainder_hi |= {4{take_hi[digit]}} & high_diff[digit][3:0];\n      narrowed_digit_hi |= {4{take_hi[digit]}} & digit[3:0];\n      narrowed_remainder_lo |= {8{take_lo[digit]}} & low_diff[digit][7:0];\n      narrowed_digit_lo |= {4{take_lo[digit]}} & digit[3:0];\n    end\n  end\n\n  // A divisor of at least 16 cannot subtract from a nibble, and a\n  // divisor of at least 256 cannot subtract from a byte.\n  assign seed_quotient = (|d_q[31:8]) ? '0\n    : {((|d_q[7:4]) ? 4'b0 : narrowed_digit_hi), narrowed_digit_lo};\n  assign seed_remainder = (|d_q[31:8]) ? a_abs_q[31:24] : narrowed_remainder_lo;\n\n  assign signed_op    = (op == ALU_DIV) || (op == ALU_REM);\n  assign remainder_op = (op == ALU_REM) || (op == ALU_REMU);\n  assign a_negative   = signed_op && a[31];\n  assign b_negative   = signed_op && b[31];\n\n  always_ff @(posedge clock) begin\n    if (launch) begin\n      a_abs_q        <= with_sign(a, a_negative);\n      d_q            <= with_sign(b, b_negative);\n      remainder_op_q <= remainder_op;\n      negate_q       <= remainder_op ? a_negative : ((a_negative \"'^ b_negative) && (b != 0));\n    end else if (iterate) begin\n      if (cycles_left_q == 3'\"'d7) begin\n        rq_q        <= {a_abs_q[23:0], seed_quotient};\n        remainder_q <= {24'b0, seed_remainder};\n      end else begin\n        rq_q        <= {rq_q[27:0], next_digit};\n        remainder_q <= next_remainder;\n      end\n    end\n  end\n\n  assign magnitude = remainder_op_q ? remainder_q : rq_q;\n  assign result = with_sign(magnitude, negate_q);\n\"'`endif\n\nendmodule\n'\"'''\nnative = native.replace('wire [7:0] low_prefix = {narrowed_remainder_hi, a_abs_q[27:24]};',\n'''wire [7:0] low_prefix = {((|d_q[7:4]) ? a_abs_q[31:28] : narrowed_remainder_hi), a_abs_q[27:24]};''')\n# Emit narrow multiples as shifts and additions to keep them in LUTs.\ndef multiple(digit, bus, width):\n    bus = f\\\"{{{width - int(bus.split('[')[1].split(':')[0]) - 1}'b0, {bus}}}\\\"\n    terms = {\n        1: [(0, '+')], 2: [(1, '+')], 3: [(2, '+'), (0, '-')],\n        4: [(2, '+')], 5: [(2, '+'), (0, '+')], 6: [(3, '+'), (1, '-')],\n        7: [(3, '+'), (0, '-')], 8: [(3, '+')], 9: [(3, '+'), (0, '+')],\n        10: [(3, '+'), (1, '+')], 11: [(3, '+'), (1, '+'), (0, '+')],\n        12: [(4, '+'), (2, '-')], 13: [(4, '+'), (1, '-'), (0, '-')],\n        14: [(4, '+'), (1, '-')], 15: [(4, '+'), (0, '-')]\n    }[digit]\n    return ' '.join((f'{sign} ' if i else '') + (f'({bus} << {shift})' if shift else bus) for i, (shift, sign) in enumerate(terms))\nfor symbol, bus, width in [('high', 'd_q[3:0]', 8), ('low', 'd_q[7:0]', 12)]:\n    old = f'wire [{width-1}:0] {symbol}_multiple = {bus} * digit;'\n    expression = ('\\\\n      '.join(f'digit == {digit} ? {multiple(digit, bus, width)} :' for digit in range(1, 15))\n                + '\\\\n      ' + multiple(15, bus, width))\n    native = native.replace(old, f'wire [{width-1}:0] {symbol}_multiple =\\\\n      {expression};')\npath.write_text(head + native)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
