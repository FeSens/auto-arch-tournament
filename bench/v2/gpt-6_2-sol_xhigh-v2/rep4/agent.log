{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"mkdir -p \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy\\\"\ncp -r cores/bench/rtl \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy\\\"\ncp test/cosim/main.cpp \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/main.cpp\\\"\npython - \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy\\\" <<'PY'\nfrom pathlib import Path\nimport sys\nbase = Path(sys.argv[1]) / 'rtl'\ncore_file = base / 'core.sv'\ncore = core_file.read_text().replace('  input  logic        reset,', '''  input  logic        reset,\n  input  logic        proxy_valid,\n  input  logic        proxy_taken,\n  output logic        proxy_admit,\n  output logic        proxy_squash,\n  output logic        proxy_corrected,\n  output logic        proxy_ex_valid,\n  output logic        proxy_ex_taken,\n  output logic        proxy_ex_trap,\n  output logic [31:0] proxy_ex_pc,\n  output logic [31:0] proxy_ex_word,\n  output logic [31:0] proxy_ex_successor,''')\ncore = core.replace('  // ── RVFI ─', '''  assign proxy_admit        = u_if.accept_fetch;\n  assign proxy_squash       = redirect;\n  assign proxy_corrected    = u_if.recovery_pending_q;\n  assign proxy_ex_valid     = u_ex.advance;\n  assign proxy_ex_taken     = ex_direct_taken;\n  assign proxy_ex_trap      = id_ex_w.ctrl.is_illegal || u_ex.misalign_fault;\n  assign proxy_ex_pc        = id_ex_w.pc;\n  assign proxy_ex_word      = id_ex_w.instr;\n  assign proxy_ex_successor = u_ex.resolved_pc;\n\n  // ── RVFI ─''').replace('    .issue_hold      (stall_id || load_use_hazard),', '''    .issue_hold      (stall_id || load_use_hazard),\n    .proxy_valid     (proxy_valid),\n    .proxy_taken     (proxy_taken),''')\ncore_file.write_text(core)\nif_file = base / 'if_stage.sv'\nstage = if_file.read_text().replace('  input  logic              issue_hold,', '''  input  logic              issue_hold,\n  input  logic              proxy_valid,\n  input  logic              proxy_taken,''').replace('  assign predict_taken = request_in_window', '''  assign predict_taken = proxy_valid ? proxy_taken : request_in_window''')\nif_file.write_text(stage)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
