{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c \"python3 - '/srv/hwebench/tmp/58928045/cbdb4f18/bench-r15s0.YYc3qT' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nscratch = Path(sys.argv[1])\nfor name, base in (\n    ('replayrf', 'replaybankmask'),\n    ('replayrfq', 'replayreadq'),\n):\n    rtl = scratch / name / 'rtl'\n    shutil.copytree(scratch / base / 'rtl', rtl)\n    def edit(file, fn):\n        p = rtl / file\n        p.write_text(fn(p.read_text()))\n    edit('if_stage.sv', lambda source: source.replace('  output if_id_t  out', '''  output logic [4:0]       bus_queue_rs1, bus_queue_rs2,\n  output logic [4:0]       replay_rs1, replay_rs2,\n  output logic             issue_replay,\n  output if_id_t  out''').replace('logic issue_bus, issue_replay, issue_buffered;', 'logic issue_bus, issue_buffered;').replace('  assign out.instr =', '''  assign bus_queue_rs1 = issue_buffered ? buffered_head.instr[19:15] : imem_data[19:15];\n  assign bus_queue_rs2 = issue_buffered ? buffered_head.instr[24:20] : imem_data[24:20];\n  assign replay_rs1 = replay_prediction.instr[19:15];\n  assign replay_rs2 = replay_prediction.instr[24:20];\n  assign out.instr ='''))\n    def core(source):\n        source = source.replace('  logic [4:0]  rs1_addr_w;', '''  logic [4:0]  normal_rs1, normal_rs2, replay_rs1, replay_rs2;\n  logic         issue_replay;\n  logic [4:0]  rs1_addr_w;''')\n        source = source.replace('    .imem_ready      (io_imemReady),', '''    .imem_ready      (io_imemReady),\n    .bus_queue_rs1   (normal_rs1),\n    .bus_queue_rs2   (normal_rs2),\n    .replay_rs1      (replay_rs1),\n    .replay_rs2      (replay_rs2),\n    .issue_replay    (issue_replay),''')\n        source = source.replace('    .rs1_addr (rs1_addr_w),\\\\n    .rs2_addr (rs2_addr_w),\\\\n    .rs1_data (rs1_data_w),\\\\n    .rs2_data (rs2_data_w),\\\\n    .w_en', '''    .rs1_addr (normal_rs1),\n    .rs2_addr (normal_rs2),\n    .alt_rs1_addr (replay_rs1),\n    .alt_rs2_addr (replay_rs2),\n    .alt_read     (issue_replay),\n    .rs1_data (rs1_data_w),\n    .rs2_data (rs2_data_w),\n    .w_en''')\n        return source\n    edit('core.sv', core)\n    def regfile(source):\n        source = source.replace('  output logic [31:0] rs1_data,', '''  input  logic [4:0] alt_rs1_addr,\n  input  logic [4:0] alt_rs2_addr,\n  input  logic       alt_read,\n  output logic [31:0] rs1_data,''')\n        source = source[:source.index('  always_comb begin')] + \\\"\\\"\\\"  function automatic logic [31:0] read_value(input logic [4:0] addr);\n    if (addr == 5'b0)\n      read_value = 32'b0;\n    else if (w_en && w_addr == addr)\n      read_value = w_data;\n    else\n      read_value = written[addr] ? regs[addr] : 32'b0;\n  endfunction\n\n  assign rs1_data = alt_read ? read_value(alt_rs1_addr) : read_value(rs1_addr);\n  assign rs2_data = alt_read ? read_value(alt_rs2_addr) : read_value(rs2_addr);\n\nendmodule\n\\\"\\\"\\\"\n        return source\n    edit('reg_file.sv', regfile)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
