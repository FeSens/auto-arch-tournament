{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$(mktemp -d \"${HWE_AGENT_TMP}/r7s0.XXXXXX\")\"\ncat > \"$scratch/probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\n\nroot = Path.cwd()\nscratch = Path(__file__).resolve().parent\nchampion = (root / 'cores/bench/rtl/div_unit.sv').read_text()\n\ndef variant(which, width):\n    if which == 'base':\n        return champion\n    num_blocks = (34 + width - 1) // width\n    decl = []\n    logic = []\n    for i in range(num_blocks):\n        lo = i * width\n        hi = min(lo + width, 34) - 1\n        n = hi - lo + 1\n        a, b, diff = f'block_a_{i}', f'block_b_{i}', f'diff_{i}'\n        decl.extend([f'logic [{n-1}:0] {a}, {b};', f'logic [{n}:0] {diff};'])\n        logic.extend([\n            f'{a} = a[{hi}:{lo}];',\n            f'{b} = b[{hi}:{lo}];',\n            f\\\"{diff} = {{1'b0, {a}}} - {{1'b0, {b}}};\\\",\n            f'g[{i}] = {diff}[{n}];',\n        ])\n        if i > 0:\n            logic.append(f'p[{i}] = ({a} == {b});')\n        if lo < 32:\n            last = min(hi, 31)\n            nout = last - lo + 1\n            out = f'trial_difference[{last}:{lo}]'\n            local = f'{diff}[{nout-1}:0]'\n            if i == 0:\n                logic.append(f'{out} = {local};')\n            elif which == 'mux':\n                alt = f'borrowed_{i}'\n                decl.append(f'logic [{nout-1}:0] {alt};')\n                logic.extend([\n                    f\\\"{alt} = {a}[{nout-1}:0] + ~{b}[{nout-1}:0];\\\",\n                    f'{out} = carry[{i}] ? {alt} : {local};',\n                ])\n            else:\n                logic.append(f\\\"{out} = {local} - {{{{{nout-1}{{1'b0}}}}, carry[{i}]}};\\\")\n    for i in range(1, num_blocks + 1):\n        terms = [f'(g[{j}] && (&p[{i-1}:{j+1}]))' for j in range(i-1)]\n        terms.append(f'g[{i-1}]')\n        dest = f'carry[{i}]' if i < num_blocks else 'trial_difference[32]'\n        logic.append(f'{dest} = {\\\" || \\\".join(terms)};')\n    # Function assigns in dependency order for compiled simulation.\n    logic = [s for s in logic if not s.startswith('trial_difference[')] + [s for s in logic if s.startswith('trial_difference[')]\n    decl = [f'logic [{num_blocks-1}:0] g;', f'logic [{num_blocks-1}:1] p, carry;'] + decl\n    indented = '\\\\n'.join('    ' + line for line in [*decl, '', *logic])\n    helper = f\\\"\\\"\\\"  function automatic logic [32:0] trial_difference (\n    input logic [33:0] a,\n    input logic [33:0] b\n  );\n{indented}\n  endfunction\n\n\\\"\\\"\\\"\n    source = champion.replace('  function automatic logic [33:0] radix4_step (', helper + '  function automatic logic [33:0] radix4_step (')\n    source = source.replace('logic [34:0] diff_d, diff_2d, diff_3d;', 'logic [32:0] diff_d, diff_2d, diff_3d;')\n    source = source.replace(\\\"{1'b0, shifted_remainder} - {3'b0, divisor}\\\", \\\"trial_difference(shifted_remainder, {2'b0, divisor})\\\")\n    source = source.replace(\\\"{1'b0, shifted_remainder} - {2'b0, divisor, 1'b0}\\\", \\\"trial_difference(shifted_remainder, {1'b0, divisor, 1'b0})\\\")\n    source = source.replace(\\\"{1'b0, shifted_remainder} - {1'b0, triple_divisor}\\\", \\\"trial_difference(shifted_remainder, triple_divisor)\\\")\n    return source.replace('diff_3d[34]', 'diff_3d[32]').replace('diff_2d[34]', 'diff_2d[32]').replace('diff_d[34]', 'diff_d[32]')\n\ndef prep(which, width):\n    work = scratch / f'{which}{width}'\n    rtl = work / 'rtl'\n    shutil.copytree(root / 'cores/bench/rtl', rtl, dirs_exist_ok=True)\n    (rtl / 'div_unit.sv').write_text(variant(which, width))\n    return work\n\nif __name__ == '__main__':\n    from tools.eval.gowin import build_all, summarize\n    from tools.eval.fpga import _bench_sv\n    which, width = sys.argv[1:3]\n    work = prep(which, int(width))\n    options = tuple(map(int, sys.argv[3:])) or (0, 1, 2)\n    res = build_all(root, work / 'rtl', _bench_sv(str(root), 'bench'), work / 'timing', options=options)\n    for item in res:\n        print(item, flush=True)\n    if 0 in options:\n        print(summarize(res), flush=True)\nPY\nprintf '%s\\\\n' \\\"\"'$scratch\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
