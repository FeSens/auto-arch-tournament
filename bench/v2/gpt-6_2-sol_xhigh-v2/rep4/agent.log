{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY' > timing-variants.log 2>&1\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build_all, summarize\n\nroot = Path.cwd()\nrtl = root / \\\"cores/bench/rtl\\\"\nsource = (rtl / \\\"if_stage.sv\\\").read_text()\nold_increment = \\\"\\\"\\\"  assign sequential_low   = imem_addr[19:2] + 18'd1;\n  assign sequential_carry = &imem_addr[19:2];\\\"\\\"\\\"\nnew_increment = \\\"\\\"\\\"  assign {sequential_carry, sequential_low} = {1'b0, imem_addr[19:2]} + 19'd1;\\\"\\\"\\\"\nold_range = \\\"\\\"\\\"  assign target_in_window = (page_up   && pc_page == 12'hfff)\n                         || (page_down && pc_page == 12'd1)\n                         || (page_same && pc_page == 12'd0);\\\"\\\"\\\"\nnew_range = \\\"\\\"\\\"  assign target_in_window = low_carry\n                         ? (offset_negative ? pc_page == 12'd0 : pc_page == 12'hfff)\n                         : (offset_negative ? pc_page == 12'd1 : pc_page == 12'd0);\\\"\\\"\\\"\nold_pc = \\\"\\\"\\\"      predicted_pc_q <= ({32{accept_fetch && predict_taken}}  & direct_target)\n                      | ({32{accept_fetch && \"'!predict_taken}} & sequential_pc)\n                      | ({32{!accept_fetch}}                  & imem_addr);\"\"\"\nnew_pc = \"\"\"      // A taken prediction always targets page zero.\n      predicted_pc_q[31:20] <= ({12{accept_fetch && !predict_taken}} & sequential_pc[31:20])\n                             | ({12{!accept_fetch}}                  & imem_addr[31:20]);\n      predicted_pc_q[19:0] <= ({20{accept_fetch && predict_taken}}  & direct_target[19:0])\n                            | ({20{accept_fetch && !predict_taken}} & sequential_pc[19:0])\n                            | ({20{!accept_fetch}}                  & imem_addr[19:0]);\"\"\"\nvariants = {\n    \"increment_carry\": [(old_increment, new_increment)],\n    \"zero_page\": [(old_pc, new_pc)],\n    \"carry_selected_window\": [(old_range, new_range)],\n}\n\ndef run(item):\n    name, replacements = item\n    variant_rtl = root / \"timing-variants\" / name / \"rtl\"\n    shutil.copytree(rtl, variant_rtl)\n    variant_source = source\n    for original, replacement in replacements:\n        assert original in variant_source\n        variant_source = variant_source.replace(original, replacement)\n    (variant_rtl / \"if_stage.sv\").write_text(variant_source)\n    results = build_all(root, variant_rtl, \"fpga/core_bench_si.sv\", variant_rtl.parent / \"timing\")\n    print(name, summarize(results), flush=True)\n\nwith ThreadPoolExecutor(max_workers=3) as workers:\n    list(workers.map(run, variants.items()))\nPY\nbench_timing_rc=$?\ncat timing-variants.log\nexit \"$bench_timing_rc\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
