0({narrow_mid, dividend_quotient_q[29:28]}, divisor_q[19:0], triple_divisor_q[21:0]);\n\\\"\\\"\\\"\n    functions = func(32) + func(20)\nelse:\n    decl += \\\"\\\"\\\"\n  logic [23:0] multiple_q [1:15];\n  logic [23:0] narrow_shift;\n  logic [24:0] trial [1:15];\n  logic [15:0] fits, take;\n\\\"\\\"\\\"\n    functions = func(32) + \\\"\\\"\\\"\n  function automatic logic [23:0] add_three(\n    input logic [23:0] a, b, c\n  );\n    add_three = (a \"'^ b ''^ c) + (((a & b) | (a & c) | (b & c)) << 1);\n  endfunction\n\"\"\"\n    if mode == '\"'selected':\n        decl += \\\"  logic [19:0] selected_multiple;\\\\n\\\"\n    narrow_trial = \\\"\\\"\\\"\n  assign narrow_shift = {remainder_q[19:0], dividend_quotient_q[31:28]};\n  assign fits[0] = 1'b1;\n  assign take[14:0] = fits[14:0] & ~fits[15:1];\n  assign take[15] = fits[15];\n  for (genvar d = 1; d < 16; d++) begin : gen_trial\n    assign trial[d] = {1'b0, narrow_shift} - {1'b0, multiple_q[d]};\n    assign fits[d] = \"'!trial[d][24];\n  end\n\"\"\"\n    if mode == '\"'selected':\n        narrow_trial += \\\"  assign selected_multiple = \\\"\n        narrow_trial += '\\\\n    | '.join(f\\\"({{20{{take[{i}]}}}} & multiple_q[{i}][19:0])\\\" for i in range(1,16))\n        narrow_trial += \\\";\\\\n  assign narrow_remainder_next = narrow_shift[19:0] - selected_multiple;\\\\n\\\"\n    else:\n        narrow_trial += \\\"  assign narrow_remainder_next = \\\"\n        narrow_trial += '\\\\n    | '.join([\\\"({20{take[0]}} & narrow_shift[19:0])\\\",\n                        *(f\\\"({{20{{take[{i}]}}}} & trial[{i}][19:0])\\\" for i in range(1,16))]) + ';\\\\n'\n    narrow_trial += '\\\\n' + '\\\\n'.join(f\\\"  assign narrow_digit[{j}] = \\\" + ' | '.join(\n        f'take[{i}]' for i in range(1,16) if ((i>>j)&1)) + ';' for j in range(4)) + '\\\\n'\n    terms = {j:f\\\"{{{4-j}'b0, divisor_q[19:0], {j}'b0}}\\\" for j in range(1,4)}\n    terms[0]=\\\"{4'b0, divisor_q[19:0]}\\\"\n    terms[4]=\\\"{divisor_q[19:0], 4'b0}\\\"\n    mu