{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c 'profile_dir=\"$TMPDIR/predictor-profile\"\npython3 - \"$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nroot=Path(sys.argv[1])\nfor name, narrow, merge in [('shift4_narrow',True,False), ('shift4_merge',False,True), ('shift4_window',True,True)]:\n    src=root/name\n    shutil.copytree(root/'shift4_fixed',src)\n    p=src/'if_stage.sv'\n    s=p.read_text()\n    if narrow:\n        s=s.replace('  logic        halfword_offset, low_carry;','  logic        halfword_offset;')\n        s=s.replace('  logic [10:0] pc_high, pc_high_inc, pc_high_dec, target_high;\\\\n','')\n        a=s.index('  // The fetch PC is word aligned.')\n        b=s.index('  logic [5:0]  fetch_index;',a)\n        s=s[:a]+\\\"\\\"\\\"  // For an in-window source the signed sum fits the fetch window iff\n  // bit 18 is clear. EX reconstructs the full architectural target.\n  assign target_low = {1'b0, pc[19:2]} + word_offset;\n  assign direct_target = {12'b0, target_low[17:0], 2'b00};\n\n\\\"\\\"\\\"+s[b:]\n        s=s.replace(\\\"\"'!halfword_offset && direct_target[31:20] == 12'\"'b0\\\", \\\"\"'!halfword_offset && !target_low[18] && pc[31:20] == 12'\"'b0\\\")\n    if merge:\n        s=s.replace('end else if (redirect) begin', 'end else if (redirect || (boundary_wait_q && advance_ex)) begin')\n        s=s.replace(\\\"\\\"\\\"      if (boundary_wait_q && advance_ex) begin\n        boundary_wait_q <= 1'b0;\n        pc <= sequential_pc;\n      end else if (recv) begin\\\"\\\"\\\",\\\"      if (recv) begin\\\")\n    p.write_text(s)\nPY\nprintf '%s\\\\n' shift4_fixed shift4_narrow shift4_merge shift4_window | xargs -P 4 -I '{}' bash \\\"\"'$profile_dir/run_variant.sh\" \"$profile_dir\" '\"'{}'\npython3 - \\\"\"'$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nimport json, sys\nfor n in ('shift4_fixed', 'shift4_narrow', 'shift4_merge', 'shift4_window'):\n    p=Path(sys.argv[1])/f'{n}.jsonl'\n    r = json.loads(p.read_text().splitlines()[-1])\n    print(p.name, r['bench_stop_cycle']-r['bench_start_cycle'], r['ebreak'], r['oob'], validate_coremark_uart(r['uart'], 10))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
