{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c 'profile_dir=\"$TMPDIR/predictor-profile\"\ncat > \"$profile_dir/ram_variants.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nroot = Path(sys.argv[1])\nfor name, base, depth, compact in [\n    ('ram4', 'shift4f_decode', 4, False), ('ram8', 'shift4f_decode', 8, False),\n    ('ram4_compact', 'shift4f_decode', 4, True), ('ram8_compact', 'shift4f_decode', 8, True),\n    ('shift4_compact', 'shift4f_decode', 4, True)\n]:\n    src = root / name\n    shutil.copytree(root / base, src)\n    p = src / 'if_stage.sv'\n    s = p.read_text().replace('localparam integer DEPTH = 4;', f'localparam integer DEPTH = {depth};')\n    if name.startswith('ram'):\n        a = s.index('  for (genvar i')\n        b = s.index('  queued_t issuing;', a)\n        s = s[:a] + \\\"\\\"\\\"  localparam integer PTR_W = \"'$clog2(DEPTH);\n  logic [PTR_W-1:0] head_q, tail_q;\n\n  always_ff @(posedge clock) begin\n    if (push) queue_q[tail_q] <= received;\n    if (reset || redirect) begin\n      head_q <= '\"'0;\n      tail_q <= '0;\n    end else begin\n      if (consume_head) head_q <= head_q + 1'b1;\n      if (push) tail_q <= tail_q + 1'b1;\n    end\n  end\n\n\\\"\\\"\\\" + s[b:]\n        s = s.replace('received : queue_q[0]', 'received : queue_q[head_q]')\n    if compact:\n        s = s.replace('  assign received.payload.direct_target = direct_target;\\\\n', '')\n        pkg = src / 'core_pkg.sv'\n        pkg.write_text(pkg.read_text().replace('    logic [31:0] direct_target;\\\\n', ''))\n        idstage = src / 'id_stage.sv'\n        idstage.write_text(idstage.read_text().replace('      reg_q.direct_target     <= in.direct_target;\\\\n', ''))\n        exstage = src / 'ex_stage.sv'\n        ex = exstage.read_text()\n        ex = ex.replace('  logic [31:0] sequential_pc;', '  logic [31:0] sequential_pc, resolved_direct;')\n        ex = ex.replace('  assign sequential_pc  = in.pc + 32\\\\'d4;', \\\"\\\"\\\"  assign sequential_pc  = in.pc + 32'd4;\n  assign resolved_direct = in.pc + in.imm;\\\"\\\"\\\")\n        ex = ex.replace('in.direct_target[1]', 'in.imm[1]').replace('in.direct_target', 'resolved_direct')\n        exstage.write_text(ex)\n    p.write_text(s)\nPY\npython3 \\\"\"'$profile_dir/ram_variants.py\" \"$profile_dir\"\nprintf '\"'%s\\\\n' ram4 ram8 ram4_compact ram8_compact shift4_compact | xargs -P 4 -I '{}' bash \\\"\"'$profile_dir/run_variant.sh\" \"$profile_dir\" '\"'{}'\npython3 - \\\"\"'$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nimport json, sys\nroot = Path(sys.argv[1])\nfor p in sorted(list(root.glob('ram*.jsonl')) + list(root.glob('shift4_compact.jsonl'))):\n    r = json.loads(p.read_text().splitlines()[-1])\n    print(p.name, r['bench_stop_cycle']-r['bench_start_cycle'], r['ebreak'], r['oob'], validate_coremark_uart(r['uart'], 10))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
