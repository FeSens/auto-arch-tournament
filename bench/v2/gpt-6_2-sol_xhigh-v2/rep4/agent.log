ts, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n    assert rj[\"pc_next\"] == 8 and r3[\"cycle\"] == rj[\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def predicted_loop_exit_waits_for_older_store(dut):\n    loop_branch = BNE(1, 0, -20)\n    program = [\n        \n…[11865 of 14937 chars elided by tools/bench/transcript.py; sha256:8ec130e8b7203d88]…\n 15, 0x21, False)] * 5 + [(0x40, 15, 0x21, True)]\n    assert dmem == {0x40: 0x21}\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_seed_rom.sv\", \"div_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
