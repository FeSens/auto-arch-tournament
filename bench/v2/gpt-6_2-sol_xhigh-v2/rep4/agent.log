{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -c \"set -e\npython3 - <<'PY'\nfrom pathlib import Path\ntest = Path('cores/bench/test')\np = test / 'test_div_unit.py'\ns = p.read_text().replace('0xF1234567)\\\\n        for b in (15, 16, -15, -16)', '0xF1234567, 0xFF012345)\\\\n        for b in (15, 16, -15, -16, 255, 256, -255, -256)')\np.write_text(s)\np = test / 'test_pipeline.py'\ns = p.read_text()\na = s.index('def test_pipeline_runner')\ns = s[:a] + '''@cocotb.test()\nasync def effective_address_crosses_page_boundary(dut):\n    program = [\n        ADDI(2, 0, 0x5A),\n        0x000010B7,  # lui x1, 1\n        ADDI(1, 1, -2),\n        _s(3, 2, 1, 0b000, 0b0100011),   # sb at 0x1001\n        ADDI(1, 1, 4),\n        _i(-1, 1, 0b100, 3, 0b0000011),  # lbu at 0x1001\n        ADDI(1, 1, 0),\n        _s(-4, 3, 1, 0b001, 0b0100011),  # sh at 0x0ffe\n        _i(-4, 1, 0b101, 4, 0b0000011),  # lhu at 0x0ffe\n        _i(-3, 1, 0b001, 5, 0b0000011),  # misaligned lh at 0x0fff\n        EBREAK(),\n    ]\n    requests = []\n    rets, dmem = await _run(dut, program, store_stalls=3, store_requests=requests)\n    assert len(rets) == len(program)\n    assert requests == [(0x1001, 2, 0x5A5A5A5A, False)] * 3 + [\n        (0x1001, 2, 0x5A5A5A5A, True),\n        (0x0FFE, 12, 0x005A005A, True),\n    ]\n    assert dmem == {0x1000: 0x5A00, 0x0FFC: 0x005A0000}\n    assert (rets[5][\\\"rd_wdata\\\"], rets[5][\\\"mem_addr\\\"], rets[5][\\\"mem_rmask\\\"]) == (0x5A, 0x1000, 2)\n    assert (rets[8][\\\"rd_wdata\\\"], rets[8][\\\"mem_addr\\\"], rets[8][\\\"mem_rmask\\\"]) == (0x5A, 0x0FFC, 12)\n    assert (rets[9][\\\"trap\\\"], rets[9][\\\"rd\\\"], rets[9][\\\"mem_rmask\\\"]) == (1, 0, 0)\n\n\n''' + s[a:]\np.write_text(s)\np = test / 'test_reg_file.py'\ns = p.read_text()\na = s.index('def test_reg_file_runner')\ns = s[:a] + '''@cocotb.test()\nasync def reset_hides_stale_words_in_both_banks(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \\\"ns\\\").start())\n    await _reset(dut)\n    await _write(dut, 1, 0xDEADBEEF)\n    await _write(dut, 17, 0xCAFEBABE)\n    assert await _read(dut, 1, 17) == (0xDEADBEEF, 0xCAFEBABE)\n    await _reset(dut)\n    assert await _read(dut, 17, 1) == (0, 0)\n    await _write(dut, 17, 7)\n    assert await _read(dut, 1, 17) == (0, 7)\n\n\n''' + s[a:]\np.write_text(s)\nPY\npytest -q cores/bench/test/test_pipeline.py cores/bench/test/test_div_unit.py cores/bench/test/test_reg_file.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
