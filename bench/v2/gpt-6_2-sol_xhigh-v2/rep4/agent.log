{"type": "item.started", "item": {"id": "item_86", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/58928045/7e77942a/predictor.rLBnR8/pair.py <<'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\nroot = Path(__file__).parent\nbase = root / sys.argv[2] / \\\"rtl\\\"\nname = sys.argv[1]\ntarget = root / name / \\\"rtl\\\"\ncopytree(base, target, dirs_exist_ok=True)\nsource = target / \\\"if_stage.sv\\\"\ns = source.read_text()\nstart = s.index(\\\"  always_comb begin\\\\n    buffered_head\\\")\nend = s.index(\\\"  assign head =\\\",start)\ns = s[:start] + \\\"\\\"\\\"\n  logic pair_valid_q, pair_at_head_q, pair_head, primary_enq, ring_pop;\n  logic [QUEUE_DEPTH-1:0] pair_marker_q, next_read_ptr, next_write_ptr;\n  logic pair_from_seq, pair_from_hint, pair_accept;\n  logic [17:0] primary_successor;\n  logic [17:0] pair_pc;\n  prediction_t pair_prediction;\n  fetch_slot_t pair_payload_q, ring_head;\n\n  assign ring_pop = pop && \"'!pair_head;\n  assign primary_enq = accept_replay || (accept_bus && (!empty || issue_hold));\n  assign next_read_ptr = ring_pop ? {read_ptr[QUEUE_DEPTH-2:0], read_ptr[QUEUE_DEPTH-1]} : read_ptr;\n  assign next_write_ptr = primary_enq ? {write_ptr[QUEUE_DEPTH-2:0], write_ptr[QUEUE_DEPTH-1]} : write_ptr;\n  assign primary_successor = bus_valid ? predict_taken ? target_word : sequential_word : replay_next_word;\n  assign pair_from_seq = lookup_hit && lookup_word_q == primary_successor\n                        && lookup_word_q != 18'\"'h3ffff;\n  assign pair_from_hint = 1'b0;\n  assign pair_accept = (pair_from_seq || pair_from_hint) && (accept_bus || accept_replay)\n                    && predicted_in_window_q && \"'!request_last_word && !recovery_pending_q\n                    && !pair_valid_q && !occupancy[3];\n  assign pair_pc = lookup_word_q;\n  assign pair_prediction = lookup_record_q.prediction;\n  assign pair_head = !recovery_pending_q && pair_valid_q && pair_at_head_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || recovery_pending_q) begin\n      pair_valid_q <= 1'\"'b0;\n      pair_at_head_q <= 1'b0;\n    end else if (pair_accept) begin\n      pair_valid_q <= 1'b1;\n      pair_at_head_q <= next_read_ptr == next_write_ptr;\n      pair_marker_q <= next_write_ptr;\n      pair_payload_q <= {{12'b0, pair_pc}, pair_prediction.instr,\n                          pair_prediction.taken, 1'b0};\n    end else if (pair_head && pop) begin\n      pair_valid_q <= 1'b0;\n      pair_at_head_q <= 1'b0;\n    end else if (pair_valid_q && next_read_ptr == pair_marker_q) begin\n      pair_at_head_q <= 1'b1;\n    end\n  end\n\n  always_comb begin\n    ring_head = '0;\n    for (int slot = 0; slot < QUEUE_DEPTH; slot++) begin\n      ring_head = ring_head | ({SLOT_WIDTH{read_ptr_q[slot]}} & slots_q[slot]);\n    end\n  end\n\n  assign buffered_head = pair_head ? pair_payload_q : ring_head;\n\n\\\"\\\"\\\" + s[end:]\nif \\\"hinted_ram\\\" in s:\n    s = s.replace(\\\"assign pair_from_hint = 1'b0;\\\", \\\"\\\"\\\"assign pair_from_hint = \"'!pair_from_seq && hint_lookup_hit && hinted_word_q == primary_successor\n                          && hinted_word_q != 18'\"'h3ffff;\\\"\\\"\\\")\n    s = s.replace(\\\"assign pair_pc = lookup_word_q;\\\", \\\"assign pair_pc = pair_from_hint ? hinted_word_q : lookup_word_q;\\\")\n    s = s.replace(\\\"assign pair_prediction = lookup_record_q.prediction;\\\", \\\"assign pair_prediction = pair_from_hint ? hint_record_q.prediction : lookup_record_q.prediction;\\\")\ns = s.replace(\\\"  assign enqueue = accept_replay || (accept_bus && (\"'!empty || issue_hold));\", \"  assign enqueue = primary_enq || pair_accept;\")\ns = s.replace(\"      read_ptr_q  <= pop     ? {read_ptr[QUEUE_DEPTH-2:0],  read_ptr[QUEUE_DEPTH-1]}  : read_ptr;\", \"      read_ptr_q <= next_read_ptr;\")\ns = s.replace(\"      write_ptr_q <= enqueue ? {write_ptr[QUEUE_DEPTH-2:0], write_ptr[QUEUE_DEPTH-1]} : write_ptr;\", \"      write_ptr_q <= next_write_ptr;\")\ns = s