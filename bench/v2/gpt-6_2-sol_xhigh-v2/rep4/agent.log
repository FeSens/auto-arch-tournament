{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/d4a09a5b/r7s0.0bynWt/fastpc.py' <<'PY'\nfrom pathlib import Path\nimport re, shutil, sys\nfrom probe import root, scratch\nwhich = sys.argv[1]\nsrc = root / 'cores/bench' if which == 'fastpc' else scratch / 'parallel'\nwork = scratch / which\nrtl = work / 'rtl'\nshutil.copytree(src / 'rtl', rtl, dirs_exist_ok=True)\n\np = rtl / 'ex_stage.sv'\ns = p.read_text()\ns = s.replace('  output logic [31:0]        direct_target,', '  output logic [31:0]        direct_target,\\\\n  output logic [31:0]        indirect_target,')\ns = s.replace('  assign direct_target  = in.direct_target;', \\\"  assign direct_target  = in.direct_target;\\\\n  assign indirect_target = {effective_addr[31:1], 1'b0};\\\")\np.write_text(s)\np = rtl / 'core.sv'\ns = p.read_text()\ns = s.replace('ex_sequential_pc, ex_direct_target;', 'ex_sequential_pc, ex_direct_target, ex_indirect_target;')\ns = s.replace('.mem_indirect_target ({ex_mem_w.effective_addr[31:1], 1\\\\'b0})', '.ex_indirect_target (ex_indirect_target)')\ns = s.replace('.direct_target   (ex_direct_target),', '.direct_target   (ex_direct_target),\\\\n    .indirect_target (ex_indirect_target),')\np.write_text(s)\np = rtl / 'if_stage.sv'\ns = p.read_text().replace('mem_indirect_target','ex_indirect_target')\na = s.index('  logic        select_sequential_q')\nb = s.index('  logic [31:0] sequential_pc, direct_target;', a)\ns = s[:a] + \\\"\\\"\\\"  logic parked_q, park;\n\n  assign recovery_pending = redirect || (parked_q && ex_advance);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      recovery_pending_q <= 1'b0;\n      parked_q <= 1'b0;\n    end else begin\n      recovery_pending_q <= recovery_pending;\n      parked_q <= park || (parked_q && \"'!ex_advance);\n    end\n  end\n\n  assign imem_addr = predicted_pc_q;\n\n\"\"\" + s[b:]\na = s.index('\"'  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      predicted_pc_q')\ns = s[:a] + \\\"\\\"\\\"  logic select_direct, select_sequential, select_indirect;\n  logic select_predict_taken, select_predict_fallthrough;\n  assign select_direct = recovery_pending && ex_direct_taken;\n  assign select_sequential = recovery_pending && \"'!ex_direct_taken && !ex_indirect_taken;\n  assign select_indirect = recovery_pending && ex_indirect_taken;\n  assign select_predict_taken = !recovery_pending && accept_fetch && predict_taken;\n  assign select_predict_fallthrough = !recovery_pending && accept_fetch && !predict_taken;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      predicted_pc_q <= '\"'0;\n    end else if (accept_fetch || recovery_pending) begin\n      predicted_pc_q <= ({32{select_predict_taken}} & direct_target)\n                      | ({32{select_predict_fallthrough}} & sequential_pc)\n                      | ({32{select_sequential}} & ex_sequential_pc)\n                      | ({32{select_direct}} & ex_direct_target)\n                      | ({32{select_indirect}} & ex_indirect_target);\n    end\n  end\n\nendmodule\n\\\"\\\"\\\"\np.write_text(s)\n\nfrom tools.eval.gowin import build_all\nfrom tools.eval.fpga import _bench_sv\nopts = tuple(map(int, sys.argv[2:])) or (0, 1, 2)\nres = build_all(root, rtl, _bench_sv(str(root), 'bench'), work / 'timing', options=opts)\nfor r in res:\n    paths = r.pop('critical_paths', [])\n    print(r, *paths[:3], sep='\\\\n', flush=True)\nPY\nPYTHONPATH=. python '/srv/hwebench/tmp/58928045/d4a09a5b/r7s0.0bynWt/fastpc.py' fastpc 0 1 2\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
