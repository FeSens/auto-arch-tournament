{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/recovery-research\"\ncat > \"$TMPDIR/recovery-research/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\n\nroot = Path(os.environ['TMPDIR']) / 'recovery-research'\nrtl = Path('cores/bench/rtl')\nvariant = root / 'split'\nshutil.copytree(rtl, variant, dirs_exist_ok=True)\n\ndef change(file, replacements):\n    path = variant / file\n    text = path.read_text()\n    for old,new in replacements:\n        assert text.count(old) == 1, (file,old)\n        text = text.replace(old,new)\n    path.write_text(text)\n\nchange('ex_stage.sv', [\n('  output logic               direct_taken,\\\\n  output logic               indirect_taken,',\n '  output logic               recover_sequential,\\\\n  output logic               recover_direct,\\\\n  output logic               recover_indirect,'),\n('''  /* verilator lint_off UNUSEDSIGNAL */\n  logic [1:0] jalr_addr_low;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign jalr_addr_low = rs1[1:0] + in.addr_offset[1:0];''',\n'''  logic jalr_misaligned;\n  function automatic logic unaligned(input logic [1:0] base, offset);\n    return base[1] \"'^ offset[1] ''^ (base[0] & offset[0]);\n  endfunction\n  assign jalr_misaligned =\n      (in.rs1_sel[2] && unaligned(fwd_ex_mem[1:0], in.addr_offset[1:0]))\n    | (in.rs1_sel[1] && unaligned(fwd_mem_wb[1:0], in.addr_offset[1:0]))\n    | (in.rs1_sel[0] && unaligned(in.rs1_val[1:0], in.addr_offset[1:0]));'\"'''),\n('  assign target_misaligned = in.ctrl.is_jalr ? jalr_addr_low[1] : in.direct_offset[1];',\n '  assign target_misaligned = in.ctrl.is_jalr ? jalr_misaligned : in.direct_offset[1];'),\n('  logic        transfer_taken, actual_taken;',\n '  logic        transfer_taken, actual_taken, direct_taken, indirect_taken;\\\\n  logic        recover_taken_pc, recover_sequential_pc;'),\n('''  assign indirect_taken  = in.ctrl.is_jalr && \"'!in.ctrl.is_illegal && !jalr_addr_low[1];\n  assign actual_taken    = direct_taken || indirect_taken;\n  assign redirect        = advance && (in.last_mapped_word || (in.predicted_taken != actual_taken));'\"''',\n'''  assign indirect_taken  = in.ctrl.is_jalr && \"'!in.ctrl.is_illegal && !jalr_misaligned;\n  assign actual_taken    = direct_taken || indirect_taken;\n  assign recover_taken_pc = advance && (in.last_mapped_word || !in.predicted_taken);\n  assign recover_sequential_pc = advance && (in.last_mapped_word || in.predicted_taken);\n  assign recover_indirect = recover_taken_pc && indirect_taken;\n  assign recover_direct = recover_taken_pc && direct_taken;\n  assign recover_sequential = recover_sequential_pc && !direct_taken && !indirect_taken;\n  assign redirect = recover_sequential || recover_direct || recover_indirect;'\"'''),\n])\nchange('if_stage.sv', [\n('  input  logic              ex_direct_taken,\\\\n  input  logic              ex_indirect_taken,',\n '  input  logic              recover_sequential,\\\\n  input  logic              recover_direct,\\\\n  input  logic              recover_indirect,'),\n('''    select_sequential_q <= redirect && \"'!ex_direct_taken && !ex_indirect_taken;\n    select_direct_q     <= redirect && ex_direct_taken;\n    select_indirect_q   <= redirect && ex_indirect_taken;'\"''',\n'''    select_sequential_q <= recover_sequential;\n    select_direct_q     <= recover_direct;\n    select_indirect_q   <= recover_indirect;'''),\n])\nchange('core.sv', [\n('  logic        ex_direct_taken, ex_indirect_taken;',\n '  logic        recover_sequential, recover_direct, recover_indirect;'),\n('''    .ex_direct_taken (ex_direct_taken),\n    .ex_indirect_taken (ex_indirect_taken),''',\n'''    .recover_sequential (recover_sequential),\n    .recover_direct     (recover_direct),\n    .recover_indirect   (recover_indirect),'''),\n('''    .direct_taken    (ex_direct_taken),\n    .indirect_taken  (ex_indirect_taken),''',\n'''    .recover_sequential (recover_sequential),\n    .recover_direct     (recover_direct),\n    .recover_indirect   (recover_indirect),'''),\n])\nPY\ncat > \\\"\"'$TMPDIR/recovery-research/timing.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom functools import partial\nfrom pathlib import Path\nimport json, sys\n\nfrom tools.eval.gowin import build\n\nroot = Path(__file__).parent\ntasks = [(name, int(opt)) for name, opt in (arg.split(':') for arg in sys.argv[1:])]\ndef run(task):\n    name, opt = task\n    rtl = Path('cores/bench/rtl') if name == 'baseline' else root / name\n    result = build('.', rtl, 'fpga/core_bench_si.sv', opt, root / f'{name}-{opt}')\n    print(name, opt, result.get('fmax_mhz'), result.get('reason', ''), flush=True)\n    paths = result.get('critical_paths', [])\n    for path in paths:\n        print(name, opt, path['from'], 'to', path['to'], path['slack_ns'], flush=True)\n    (root / f'{name}-{opt}.json').write_text(json.dumps(result, indent=2))\nwith ThreadPoolExecutor(max_workers=min(3,len(tasks))) as pool:\n    list(pool.map(run, tasks))\nPY\npython \\\"\"'$TMPDIR/recovery-research/prototype.py\"\nPYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" baseline:1 split:1 split:0'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
