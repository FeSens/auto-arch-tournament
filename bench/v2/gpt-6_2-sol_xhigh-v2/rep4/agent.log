{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nroot = Path('cores/bench')\npath = root / 'rtl/ex_stage.sv'\nrtl = path.read_text().replace('  input  id_ex_t   in,', '''  // The top-level forwarding unit consumes in.bypass_hits.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  id_ex_t   in,\n  /* verilator lint_on UNUSEDSIGNAL */''')\npath.write_text(rtl)\npath = root / 'test/test_pipeline.py'\nsource = path.read_text()\ninsertion = source.index('@cocotb.test()\\\\nasync def forwarding_ex_to_ex(')\ntests = '''@cocotb.test()\nasync def registered_bypass_age_priority(dut):\n    consumer = ADD(6, 5, 5)\n    program = [ADDI(5, 0, 11), ADDI(5, 0, 22), consumer, EBREAK()]\n    rets, _ = await _run(dut, program)\n    [res] = _by_insn(rets, consumer)\n    assert (res[\\\"rs1_rdata\\\"], res[\\\"rs2_rdata\\\"], res[\\\"rd_wdata\\\"]) == (22, 22, 44)\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n\n\n@cocotb.test()\nasync def trapped_link_exposes_older_writer(dut):\n    trap, consumer = JALR(5, 0, 2), ADD(6, 5, 5)\n    program = [ADDI(5, 0, 37), trap, consumer, EBREAK()]\n    rets, _ = await _run(dut, program)\n    [fault] = _by_insn(rets, trap)\n    [res] = _by_insn(rets, consumer)\n    assert fault[\\\"trap\\\"] and fault[\\\"rd\\\"] == 0 and fault[\\\"pc_next\\\"] == 8\n    assert (res[\\\"rs1_rdata\\\"], res[\\\"rs2_rdata\\\"], res[\\\"rd_wdata\\\"]) == (37, 37, 74)\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n\n\n@cocotb.test()\nasync def load_bypass_survives_stalled_store(dut):\n    consumer = ADD(6, 5, 5)\n    program = [LB(5, 0, 0x100), SW(0, 0, 0x104), consumer, EBREAK()]\n    stores = []\n    rets, _ = await _run(dut, program, dmem_init={0x100: 0x81}, store_stalls=3,\n                         store_requests=stores)\n    [res] = _by_insn(rets, consumer)\n    assert (res[\\\"rs1_rdata\\\"], res[\\\"rs2_rdata\\\"], res[\\\"rd_wdata\\\"]) == (\n        0xFFFFFF81, 0xFFFFFF81, 0xFFFFFF02)\n    assert stores == [(0x104, 15, 0, False)] * 3 + [(0x104, 15, 0, True)]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n\n\n@cocotb.test()\nasync def alu_override_keeps_raw_rvfi_bypasses(dut):\n    # Source fields in the two immediates alias actual older destinations.\n    u_imm = (5 << 15) | (4 << 20)\n    auipc = u_imm | (6 << 7) | 0x17\n    addi = ADDI(7, 6, 5)\n    program = [ADDI(4, 0, 23), ADDI(5, 0, 51), auipc, addi, EBREAK()]\n    rets, _ = await _run(dut, program)\n    [u] = _by_insn(rets, auipc)\n    [i] = _by_insn(rets, addi)\n    assert (u[\\\"rs1_addr\\\"], u[\\\"rs1_rdata\\\"], u[\\\"rs2_addr\\\"], u[\\\"rs2_rdata\\\"]) == (5, 51, 4, 23)\n    assert u[\\\"rd_wdata\\\"] == u_imm + 8\n    assert (i[\\\"rs1_rdata\\\"], i[\\\"rs2_rdata\\\"], i[\\\"rd_wdata\\\"]) == (u_imm + 8, 51, u_imm + 13)\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n\n\n'''\npath.write_text(source[:insertion] + tests + source[insertion:])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
