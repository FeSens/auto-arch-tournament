{"type": "item.started", "item": {"id": "item_64", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/b697edee/bench-r8s0.b2RJMn/make_split_variants.py' <<'PY'\nfrom pathlib import Path\nimport re\nimport shutil\nimport sys\n\nscratch = Path(__file__).resolve().parent\nrtl_dir = Path('cores/bench/rtl')\nfor variant in sys.argv[1:]:\n    base = scratch / 'seg_9_9+zerorange'\n    work = scratch / variant\n    shutil.copytree(base / rtl_dir, work / rtl_dir)\n    shutil.copy2(base / 'cores/bench/core.yaml', work / 'cores/bench/core.yaml')\n    shutil.copytree(base / 'fpga', work / 'fpga')\n    p = work / rtl_dir / 'if_stage.sv'\n    rtl = p.read_text()\n    first = rtl.index('  logic [17:0] word_offset;')\n    last = rtl.index('  assign pc_high    ', first)\n    rtl = rtl[:first] + '''  logic        halfword_offset, low_carry;\n  logic [17:0] target_low, j_offset;\n  logic [9:0]  b_offset, b_low;\n  logic [7:0]  b_upper, b_high, b_high_inc, b_high_dec;\n  logic [8:0]  j_upper, j_lower, j_high_sum;\n  logic        b_inner_carry, b_carry, j_inner_carry, j_carry, j_high_gen, j_high_prop;\n  logic        b_upper_inc, b_upper_dec, b_upper_same;\n  logic [11:0] pc_high, pc_high_inc, pc_high_dec, target_high;\n  logic        target_high_zero;\n  logic        page_zero, page_one, page_max;\n  logic        carry_allowed, no_carry_allowed;\n  logic        upper_inc, upper_dec, upper_same;\n  logic [17:0] sequential_low;\n  logic        sequential_carry;\n\n  assign is_jal    = imem_data[6:0] == 7'b1101111;\n  assign is_branch = imem_data[6:0] == 7'b1100011 && (imem_data[14] || \"'!imem_data[13]);\n\n  assign {sequential_carry, sequential_low} = {1'\"'b0, imem_addr[19:2]} + 19'd1;\n  assign sequential_pc = {sequential_carry ? pc_high_inc : pc_high, sequential_low, 2'b0};\n\n  assign use_j_offset = imem_data[3];\n  assign halfword_offset = use_j_offset ? imem_data[21] : imem_data[8];\n\n  // B offsets adjust the upper slice by the carry minus the displacement sign.\n  assign b_offset = {imem_data[7], imem_data[30:25], imem_data[11:9]};\n  assign {b_inner_carry, b_low} = {1'b0, imem_addr[11:2]} + {1'b0, b_offset};\n  assign b_high = imem_addr[19:12];\n  assign b_high_inc = b_high + 8'd1;\n  assign b_high_dec = b_high - 8'd1;\n  assign b_upper_inc = b_inner_carry && \"'!imem_data[31];\n  assign b_upper_dec = !b_inner_carry && imem_data[31];\n  assign b_upper_same = b_inner_carry == imem_data[31];\n  assign b_upper = ({8{b_upper_inc}} & b_high_inc)\n                 | ({8{b_upper_dec}} & b_high_dec)\n                 | ({8{b_upper_same}} & b_high);\n  assign b_carry = imem_data[31] ? b_inner_carry || (|b_high)\n                                : b_inner_carry && (&b_high);\n\n  assign j_offset = {imem_data[19:12], imem_data[20], imem_data[30:22]};\n  assign {j_inner_carry, j_lower} = {1'\"'b0, imem_addr[10:2]} + {1'b0, j_offset[8:0]};\n  assign {j_high_gen, j_high_sum}  = {1'b0, imem_addr[19:11]} + {1'b0, j_offset[17:9]};\n  assign j_high_prop = &(imem_addr[19:11] \"'^ j_offset[17:9]);\n  assign j_upper = j_high_sum + {8'\"'b0, j_inner_carry};\n  assign j_carry = j_high_gen || (j_high_prop && j_inner_carry);\n\n  assign target_low = use_j_offset ? {j_upper, j_lower} : {b_upper, b_low};\n  assign low_carry = use_j_offset ? j_carry : b_carry;\n\n''' + rtl[last:]\n    if variant == 'split-bank':\n        rtl = rtl.replace('  assign target_high_zero = low_carry ? carry_allowed : no_carry_allowed;', '''  assign target_high_zero = (use_j_offset && (j_carry ? carry_allowed : no_carry_allowed))\n                         || (\"'!use_j_offset && (b_carry ? carry_allowed : no_carry_allowed));'\"''')\n    if variant == 'split-carry-select':\n        rtl = rtl.replace('  assign j_upper = j_high_sum + {8\\\\'b0, j_inner_carry};', '''  logic [8:0] j_high_plus_one;\n  assign j_high_plus_one = imem_addr[19:11] + j_offset[17:9] + 9'd1;\n  assign j_upper = j_inner_carry ? j_high_plus_one : j_high_sum;''')\n    if variant == 's