{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/hwe-toolchain/oss-cad-suite/lib/python3.11/site-packages python3 - <<'PY'\nfrom importlib.resources import files\nfrom apycula import bitmatrix, bslib, chipdb, gowin_pack\n\nchip = chipdb.load_chipdb(str(files('apycula').joinpath('GW2A-18C.msgpack.xz')))\nseeds = [(1 << 23) // (i + 1025) for i in range(1024)]\ninit = {\n    f'INIT_RAM_{block:02X}': f'{sum(word << (16 * i) for i, word in enumerate(seeds[block * 16: (block + 1) * 16])):0256b}'\n    for block in range(64)\n}\ngowin_pack.device = 'GW2A-18C'\nrows = sorted(chip.simplio_rows)\nfirst_col = next(col for col in range(chip.cols) if 'BSRAM' in chip[rows[0], col].bels)\ngowin_pack.store_bsram_init_val(chip, rows[0], first_col, 'ROM', init, {'BSRAM_SUBTYPE': ''})\nx = sum(chip[0, j].width for j in range(first_col))\nexpected = [row[x:x + 180] for row in gowin_pack.bsram_init_map[:256]]\nfor placement in range(3):\n    path = f'cores/bench/generated/timing/gowin_p{placement}/impl/pnr/core_bench.fs'\n    bitmap, _, _, _ = bslib.read_bitstream(path)\n    matches = []\n    for row_index, row in enumerate(rows):\n        y = chip.height + row_index * 256\n        for col in range(chip.cols):\n            if 'BSRAM' not in chip[row, col].bels:\n                continue\n            x = sum(chip[0, j].width for j in range(col))\n            if all(list(bitmap[y + idx][x:x + 180]) == list(expected[idx]) for idx in range(256)):\n                matches.append((row, col))\n    assert len(matches) == 1, f'Placement {placement} ROM matches: {matches}'\n    print(f'Placement {placement}: all 1,024 ROM contents match at row {matches[0][0]}, column {matches[0][1]}', flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
