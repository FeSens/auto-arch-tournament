{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '420,520p' cores/bench/test/test_pipeline.py && sed -n '1030,1335p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert len(branch_fetches) == 3\n    assert [fetches[i + 1] for i in branch_fetches[:2]] == [(8, True)] * 2\n    exit_fetch = branch_fetches[-1]\n    assert fetches[exit_fetch + 1:exit_fetch + 8] == [\n        (8, True), (12, True), (16, True), (28, False), (32, False), (32, True), (36, True),\n    ]\n\n\n@cocotb.test()\nasync def consecutive_aliased_branches_bypass_pending_training(dut):\n    # The XOR index is 32 at 0x80, 0x1ffc, and 0x2000. The adjacent\n    # branches at 0x1ffc and 0x2000 train on consecutive edges.\n    program = [NOP()] * (0x2028 // 4)\n    for pc, insn in {\n        0x0000: JAL(0, 0x80),\n        0x0080: BEQ(0, 0, 8),             # cold forward: 01 -> 10\n        0x0084: SW(0, 0, 0x40),          # squashed by the cold branch\n        0x0088: JAL(0, 0x1FFC - 0x88),\n        0x1FFC: BNE(0, 0, 2),             # untaken, unaligned target: 10 -> 01\n        0x2000: BEQ(1, 0, 0x20),          # taken once: bypassed 01 -> 10\n        0x2004: ADDI(2, 2, 1),\n        0x2008: BNE(2, 1, 8),            # exit after the second fall-through\n        0x200C: JAL(0, -0xC),\n        0x2010: EBREAK(),\n        0x2020: ADDI(1, 0, 1),\n        0x2024: JAL(0, -0x24),\n    }.items():\n        program[pc // 4] = insn\n\n    fetches, stores = [], []\n    rets, _ = await _run(dut, program, fetch_requests=fetches, store_requests=stores)\n    assert stores == []\n    assert [r[\"pc\"] for r in rets] == [\n        0, 0x80, 0x88, 0x1FFC, 0x2000, 0x2020, 0x2024,\n        0x2000, 0x2004, 0x2008, 0x200C, 0x2000, 0x2004, 0x2008, 0x2010,\n    ]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert rets[4][\"cycle\"] == rets[3][\"cycle\"] + 1\n    assert all(r[\"trap\"] == 0 for r in rets)\n    [unaligned_branc