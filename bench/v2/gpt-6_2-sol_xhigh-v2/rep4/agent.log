st_word),''')\n\ndef predecode():\n    replace('core_pkg.sv','    logic [31:0] alu_a_base;', '    logic [10:0] alu_select;\\\\n    logic [31:0] alu_a_base;')\n    replace('id_stage.sv','  // ── ID/EX register','''  logic [10:0] alu_select;\n  for (genvar op_index = 0; op_index < 11; op_index++) begin : gen_select\n    assign alu_select[op_index] = \"'!dec_is_jump && dec_alu_op == 5'\"'(op_index);\n  end\n\n  // ── ID/EX register''')\n    replace('id_stage.sv','      reg_q.alu_a_sel  <=', '      reg_q.alu_select <= alu_select;\\\\n      reg_q.alu_a_sel  <=')\n    replace('ex_stage.sv','  alu u_alu (\\\\n    .op      (in.ctrl.alu_op),','  alu_datapath u_alu (\\\\n    .select_op (in.alu_select),')\n    replace('ex_stage.sv','  logic use_alu_result;\\\\n','')\n    replace('ex_stage.sv','  // The low multiply reaches its EX/MEM register through the final mux.\\\\n  // Decode makes the remaining result sources mutually exclusive.\\\\n  assign use_alu_result = \"'!(in.ctrl.is_jump || mul_high_instr || div_instr);'\"\\\\n\\\\n','')\n    replace('ex_stage.sv','''      reg_q.alu_result    <= mul_low_instr ? mul_low_result\n                           : (({32{in.ctrl.is_jump}} & sequential_pc)\n                           |  ({32{mul_high_instr}}  & mul_high_result)\n                           |  ({32{div_instr}}       & div_result)\n                           |  ({32{use_alu_result}}  & alu_result));''','''      reg_q.alu_result    <= alu_result\n                           | ({32{mul_low_instr}}     & mul_low_result)\n                           | ({32{in.ctrl.is_jump}}   & sequential_pc)\n                           | ({32{mul_high_instr}}    & mul_high_result)\n                           | ({32{div_instr}}         & div_result);''')\n    (variant/'alu.sv').write_text('''module alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a, b,\n  output logic [31:0] out, add_sum\n);\n  logic [10:0] select_op;\n  for (genvar op_index = 0; op_index < 11; op_index++) begin : gen_decode\n    assign select_op[op_index] = op == 5'(op_index);\n  end\n  alu_datapath u_datapath (.*);\nendmodule\n\n/* verilator lint_off DECLFILENAME */\nmodule alu_datapath (\n  input  logic [10:0] select_op,\n  input  logic [31:0] a, b,\n  output logic [31:0] out, add_sum\n);\n  assign add_sum = a + b;\n  logic [31:0] sub, left, right;\n  logic [32:0] shift_input;\n  logic eq_sign, unsigned_less;\n  assign sub = a - b;\n  assign unsigned_less = a < b;\n  assign eq_sign = a[31] \"'^ b[31];\n  assign left = a << b[4:0];\n  assign shift_input = {select_op[ALU_SRA] & a[31], a};\n  assign right = 32'\"'(\"'$signed(shift_input) >>> b[4:0]);\n  assign out = ({32{select_op[ALU_ADD]}}  & add_sum)\n             | ({32{select_op[ALU_SUB]}}  & sub)\n             | ({32{select_op[ALU_AND]}}  & (a & b))\n             | ({32{select_op[ALU_OR]}}   & (a | b))\n             | ({32{select_op[ALU_XOR]}}  & (a ''^ b))\n             | {31'\"'b0, select_op[ALU_SLT] & (unsigned_less \"'^ eq_sign)}\n             | {31'\"'b0, select_op[ALU_SLTU] & unsigned_less}\n             | ({32{select_op[ALU_SLL]}}  & left)\n             | ({32{select_op[ALU_SRL] | select_op[ALU_SRA]}} & right)\n             | ({32{select_op[ALU_LUI]}}  & b);\nendmodule\n/* verilator lint_on DECLFILENAME */\n''')\n    # Restrict packed-vector indexing to the select bus width in lint.\n    p=variant/'alu.sv'\n    import re\n    p.write_text(re.sub(r'select_op\\\\[(ALU_\\\\w+)\\\\]',r'select_op[4\\\\'(\\\\1)]',p.read_text()))\n\nnew('compare')\ncomparator()\npreflags()\nnew('decode')\npredecode()\nnew('both','compare')\npredecode()\nPY\npython \\\"\"'$TMPDIR/recovery-research/refine.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" compare:1 decode:1 both:1'", "aggregated_output": "decode 1 None ERROR (EX3863) : Syntax error near '\\'(ALU_SRA)]'(\"/srv/hwebench/tmp/58928045/476803ea/recovery-research/decode/alu.sv\":27); ERROR (EX3863) : Syntax error near '\\'(ALU_ADD)]}}'(\"/srv/hwebench/tmp/58928045/476803ea/recovery-research/decode/alu.sv\":29); ERROR (EX3863) : Syntax error near '\\'(ALU_SLT)]'(\"/srv/hwebench/tmp/58928045/476803ea/recovery-research/decode/alu.sv\":34)\nboth 1 None ERROR (EX3863) : Syntax error near '\\'(ALU_SRA)]'(\"/srv/hwebench/tmp/58928045/476803ea/recovery-research/both/alu.sv\":27); ERROR (EX3863) : Syntax error near '\\'(ALU_ADD)]}}'(\"/srv/hwebench/tmp/58928045/476803ea/recovery-research/both/alu.sv\":29); ERROR (EX3863) : Syntax error near '\\'(ALU_SLT)]'(\"/srv/hwebench/tmp/58928045/476803ea/recovery-research/both/alu.sv\":34)\ncompare 1 88.793 \ncompare 1 cpu/u_id/reg_q.rs2_sel_1_s0 to cpu/u_if/train_pending_q_s0 -6.262\ncompare 1 cpu/u_id/reg_q.alu_b_sel_1_s0 to cpu/u_ex/reg_q.alu_result_9_s0 -6.26\ncompare 1 cpu/u_mem/reg_q.write_value_4_s0 to cpu/u_ex/reg_q.alu_result_13_s0 -6.258\ncompare 1 cpu/u_ex/reg_q.ctrl.mem_read_s0 to cpu/u_id/reg_q.alu_a_base_31_s0 -6.242\ncompare 1 cpu/u_ex/reg_q.ctrl.mem_read_s0 to cpu/u_id/reg_q.rs2_val_16_s0 -6.233\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"git log --oneline -- cores/bench/rtl/reg_file.sv; rg 'hyp-20261121-001-r4s0' cores/bench/experiments/log.jsonl | python -c 'import sys,json; j=json.load(sys.stdin);print(j[\\\"implementation_notes\\\"])'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"git log --oneline -- cores/bench/rtl/reg_file.sv; rg 'hyp-20261121-001-r4s0' cores/bench/experiments/log.jsonl | python -c 'import sys,json; j=json.load(sys.stdin);print(j[\\\"implementation_notes\\\"])'\"","aggregated_output":"391f3f0 hyp-20261121-001-r4s0: Split and parallelize the EX operand-to-result path (+11.1%)\n29c86c4 bench fixture root\n# Bench EX datapath implementation\n\n- EX computes the effective address from forwarded `rs1` and the decoded I- or S-type immediate. The 12-bit sum runs in parallel with three upper-word candidates. EX/MEM holds the full address with the store payload and memory controls through data-bus stalls. MEM uses it for the bus address, alignment, lane masks, load extraction, and aligned RVFI address.\n- EX ORs five independently masked results for the jump link, low multiply, high multiply, division or remainder, and base ALU. This preserves the forwarding schedule, branch prediction, load-use interlock, and single-cycle low `MUL`.\n- The two asynchronous register reads share one 32-word distributed RAM array. Reset clears the written bits. Reads retain hardwired `x0` and matching-write priority on both ports.\n- The divider launches with four seed bits, consumes four more bits with eight-bit restoring arithmetic while registering `3D`, then performs two radix-4 steps on each of six edges. Each radix-4 step compares all three multiples in parallel. The hardware and ALTOPS paths retain the launch-to-completion schedule and hold completion until consumed.\n\nJALR also uses the split address adder because it has the same signed 12-bit offset. It still clears target bit zero before redirecting. The existing four-bit divider seed computes the magnitude of its two high bit pairs with independent carry inputs to shorten the launch path.\n\n## Local verification\n\n- Verilator `-Wall` lint passed in both hardware and ALTOPS modes.\n- All seven cocotb suites passed. The added coverage checks forwarded offsets across 4 KiB boundaries, 32-bit address wraparound, load and store alignment traps, subword lanes, a held store, register reset and bypass, and all four divide operations at divisor magnitudes 255 and 256 and with wide unsigned operands.\n- `bash formal/run_all.sh` passed all 53 single-channel ALTOPS checks, including `reg_ch0`, with zero corrective retries. A separate induction check on the synthesized register-file model proved both read ports equivalent to the original after reset for arbitrary write sequences.\n- `NRET=1 make cosim TARGET=bench` passed selftest against the ISS with and without stalls and passed stalled CoreMark CRC validation.\n\n## Gowin score\n\n`NRET=1 make fpga TARGET=bench` completed all three placements.\n\n| Placement | Fmax (MHz) |\n| --- | ---: |\n| 0 | 62.587 |\n| 1 | 64.657 |\n| 2 | 64.657 |\n\nThe median of **64.657 MHz** gives **154.30 CoreMark iterations/sec** at 10 iterations in 4,190,307 timed cycles. That is **11.06% above the champion** and 6.41 iterations/sec below the scratch result. Placement zero used 3,443 logic cells, 805 registers, 36 LUT RAMs, four block RAMs, and two DSPs.\n\nThe worst setup path starts at MEM/WB's destination register and crosses forwarding into the ordinary ALU in placement zero and into the divider launch seed in placements one and two.\n\n","exit_code":0,"status":"completed"}}
