{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name, base_variant in (('logic_seed', 'control'), ('free_logic_seed', 'free_div')):\n    variant = root / name\n    source = root / base_variant\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    path = variant / 'cores/bench/rtl/div_seed_rom.sv'\n    lut_bits = []\n    for bank in range(64):\n        entry = [(1 << 23) // (1025 + bank * 16 + low) for low in range(16)]\n        value = []\n        for col in range(13):\n            table = sum(((seed >> col) & 1) << bit for bit, seed in enumerate(entry))\n            value.append(f\\\"16'h{table:04x}\\\")\n        lut_bits.append(f\\\"      6'd{bank}: lut_bits = {{\\\" + ', '.join(reversed(value)) + '};')\n    path.write_text('''module div_seed_rom (\n  input logic clock,\n  input logic read_en,\n  input logic [9:0] addr,\n  output logic [12:0] seed\n);\n  logic [12:0] bank_values [0:63];\n\n  function automatic logic [207:0] bank_luts(input logic [5:0] bank);\n    logic [207:0] lut_bits;\n    case (bank)\n''' + '\\\\n'.join(lut_bits) + '''\n    endcase\n    return lut_bits;\n  endfunction\n\n  for (genvar bank = 0; bank < 64; bank++) begin : gen_bank\n    localparam logic [207:0] LUTS = bank_luts(6'(bank));\n    for (genvar bit_index = 0; bit_index < 13; bit_index++) begin : gen_bit\n      localparam logic [15:0] LUT = LUTS[16 * bit_index +: 16];\n      assign bank_values[bank][bit_index] = LUT[addr[3:0]];\n    end\n  end\n  always_ff @(posedge clock)\n    if (read_en) seed <= bank_values[addr[9:4]];\nendmodule\n''')\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(name):\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', 1, variant / 'timing' / 'p1')\n    print(name, res['fmax_mhz'], res.get('reason'), res.get('logic'),res.get('bsram'),res.get('critical_paths', [])[:2], flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n    list(executor.map(trial, ('logic_seed','free_logic_seed')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
