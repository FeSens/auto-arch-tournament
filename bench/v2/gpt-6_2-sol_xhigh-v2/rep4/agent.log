{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat >\"$TMPDIR/hyp_profile/seq_proto.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport shutil\n\nscratch=Path(os.environ['TMPDIR'])/'hyp_profile'\nfor variant, source, bits, cautious in (\n        ('seq32','target32',5,False),\n        ('seq32_head','target32_bypass',5,False),\n        ('seq64','target64',6,False),\n        ('seq16','target32',4,False),\n):\n    dst=scratch/variant/'rtl'\n    shutil.copytree(scratch/source/'rtl',dst,dirs_exist_ok=True)\n    p=dst/'if_stage.sv'\n    s=p.read_text()\n    s=s.replace('localparam int L0_INDEX_WIDTH = 5;',f'localparam int L0_INDEX_WIDTH = {bits};')\n    begin=s.index('  localparam int L0_INDEX_WIDTH')\n    end=s.index('  // Explicit vectors keep', begin)\n    x=s[begin:end]\n    x=x.replace('    prediction_t prediction;', '    logic [31:0] instr;')\n    x=x.replace('  prediction_t selected_replay;', '  logic replay_predict_taken;\\\\n  logic [31:0] replay_instr;')\n    x=x.replace('assign selected_replay = (|replay_match) ? replay_prediction : l0_read.prediction;',\n                '''assign replay_predict_taken = replay_prediction.taken;\n  assign replay_instr = (|replay_match) ? replay_prediction.instr : l0_read.instr;''')\n    x=x.replace(', imem_data, predict_taken, target_word', ', imem_data')\n    x=x.replace('&& \"'!request_last_word && target_words_left_q'\"', '&& \"'!request_last_word && !predict_taken && target_words_left_q'\"')\n    x=x.replace('selected_replay.taken', 'replay_predict_taken')\n    s=s[:begin]+x+s[end:]\n    s=s.replace('selected_replay.instr','replay_instr').replace('selected_replay.taken','replay_predict_taken')\n    s=s.replace('selected_replay.target','replay_prediction.target')\n    s=s.replace('((|replay_match) ? (|replay_target_last) : (&l0_read.prediction.target))','(|replay_target_last)')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/hyp_profile/seq_proto.py\"\nfor variant in seq32 seq32_head seq64 seq16; do\n  bash \"$TMPDIR/hyp_profile/build_variant.sh\" \"$variant\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
