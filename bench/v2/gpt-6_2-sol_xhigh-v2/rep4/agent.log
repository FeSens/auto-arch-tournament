{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/predictor-profile\"\ncat > analyze.cpp <<'\"'CPP'\n#include <algorithm>\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <map>\n#include <vector>\nusing namespace std;\nstruct Row { uint32_t cycle, pc, insn, npc, trap; };\nint main(int argc, char**argv) {\n  int lo=atoi(argv[1]), hi=atoi(argv[2]);\n  auto f=fopen(\\\"retired.bin\\\",\\\"rb\\\");\n  Row r;\n  vector<Row> controls;\n  size_t retire=0;\n  bool prev=false;\n  int adjacent=0, jumps=0, jalr=0,ret=0, calls=0, branches=0, mem=0;\n  while(fread(&r,sizeof r,1,f)==1) {\n    if(r.cycle>hi) break;\n    bool timed = r.cycle>=lo;\n    unsigned op = r.insn&127;\n    retire+=timed;\n    mem+=timed&&(op==3||op==0x23);\n    if(r.trap || (op\"'!=0x63 && op!=0x6f && op!=0x67)) { prev=false; continue; }\n    controls.push_back(r);\n    if(timed) {\n      if(op==0x63) {branches++; adjacent+=prev;}\n      if(op==0x6f) jumps++;\n      if(op==0x67) {jalr++; ret+=r.insn==0x8067;}\n      if((op==0x6f || op==0x67) && ((r.insn>>7)&31)==1) calls++;\n    }\n    prev=op==0x63;\n  }\n  printf(\"retired=%zu mem=%d branch=%d adjacent_branch=%d jal=%d jalr=%d ret=%d calls=%d'\"\\\\n\\\",retire,mem,branches,adjacent,jumps,jalr,ret,calls);\n  map<int,array<int,2>> counts;\n  for(auto r: controls) if(r.cycle>=lo && (r.insn&127)==0x63) counts[r.pc][r.npc\"'!=r.pc+4]++;\n  int ideal=0;\n  for(auto [pc,c]: counts) ideal+=min(c[0],c[1]);\n  printf(\"static branches %zu oracle fixed direction misses %d'\"\\\\n\\\",counts.size(),ideal);\n  auto run = [&](int indexbits, int historybits, bool local, bool perbranch, bool speculative) {\n    int m=(1<<indexbits)-1,h=(1<<historybits)-1, ghr=0, oldghr=0, miss=0, misses_adjacent=0;\n    vector<int> pht(1<<indexbits,-1);\n    vector<int> lht(1024,0);\n    map<int,int> miss_pc;\n    Row p={};\n    for(auto r: controls) {\n      if ((r.insn&127)\"'!=0x63) continue;\n      auto pc=r.pc>>2;\n      auto hash=(pc''^(pc>>indexbits))&m;\n      if(indexbits==6) hash=((pc>>6)''^pc)&63;\n      int lhidx=(pc''^(pc>>10))&1023;\n      bool adjacent = r.cycle==p.cycle+1;\n      int history=local?lht[lhidx]:(adjacent&&!speculative?oldghr:ghr);\n      auto ix=perbranch?((hash<<historybits)|history)&m:(hash''^history)&m;\n      int cold = (r.insn>>31)?2:1;\n      int dir=pht[ix]==-1?cold:pht[ix];\n      bool t=r.npc!=r.pc+4;\n      if(r.cycle>=lo && bool(dir>>1)!=t) { miss++; miss_pc[r.pc]++; misses_adjacent+=adjacent; }\n      pht[ix]=t?min(3,dir+1):max(0,dir-1);\n      oldghr=ghr;\n      ghr=((ghr<<1)|t)&h;\n      lht[lhidx]=((lht[lhidx]<<1)|t)&h;\n      p=r;\n    }\n    printf(\"miss %7d (%5d adjacent) idx=%2d hist=%2d %s %s'\"\\\\n\\\",miss,misses_adjacent,indexbits,historybits,local?\\\"local\\\":(speculative?\\\"spec-global\\\":\\\"resolved-global\\\"),perbranch?\\\"concat\\\":\\\"xor\\\");\n    if(indexbits==6 && historybits==0){\n      vector<pair<int,int>> sorted;\n      for(auto [pc,n]:miss_pc) sorted.push_back({n,pc});\n      sort(sorted.rbegin(),sorted.rend());\n      for(int i=0;i<20 && i<(int)sorted.size();i++) {auto [n,pc]=sorted[i]; printf(\\\"%05x miss=%d n=%d t=%d\\\\n\\\",pc,n,counts[pc][0],counts[pc][1]);}\n    }\n  };\n  run(6,0,false,false,false);\n  for(int i:{7,8,9,10,11,12}) {\n    run(i,0,false,false,false);\n    for(int h:{2,3,4,5,6,8,9,10,12}) {\n      run(i,h,false,false,false);\n      run(i,h,false,false,true);\n      run(i,h,true,false,false);\n      if(h+4<=i) run(i,h,true,true,false);\n    }\n  }\n}\nCPP\ng++ -O2 -include cstdlib -o analyze analyze.cpp\ncat baseline.jsonl\nread -r start stop < <(python3 -c 'import json; r=json.loads(open(\\\"baseline.jsonl\\\").read().splitlines()[-1]); print(r[\\\"bench_start_cycle\\\"],r[\\\"bench_stop_cycle\\\"])')\n./analyze \\\"\"'$start\" \"$stop\" > analyze.txt\nhead -24 analyze.txt\nrg '\"'idx=' analyze.txt | sort -k2n | head -30\"","aggregated_output":"","exit_code":null,"status"