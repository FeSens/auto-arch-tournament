{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'scratch=$(cat \"$TMPDIR/bench-r15s1-dir\")\nfor variant in q6 q7 q8 metadata\ndo\n  mkdir -p \"$scratch/$variant/cores/bench\"\n  cp -r \"$scratch/banked_fast/cores/bench/rtl\" \"$scratch/banked_fast/cores/bench/core.yaml\" \"$scratch/$variant/cores/bench/\"\n  cp -r \"$scratch/fpga\" \"$scratch/$variant/\"\ndone\npython - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfor variant in ('q6','q7','q8','metadata'):\n p=Path(sys.argv[1])/variant/'cores/bench/rtl/if_stage.sv'\n s=p.read_text()\n if variant.startswith('q'):\n  depth=int(variant[1:])\n  s=s.replace(\\\"QUEUE_DEPTH = 5\\\", f\\\"QUEUE_DEPTH = {depth}\\\").replace(\\\"FIRST_SLOT = 5'b00001\\\", \\\"FIRST_SLOT = QUEUE_DEPTH'(1)\\\")\n else:\n  s=s.replace(\\\"  logic [17:0] fill_successor_word;\\\", \\\"\\\"\\\"  logic [17:0] fill_successor_word;\n  logic [17:0] lane_fill_word [0:3];\n  logic [5:0]  lane_fill_index [0:3];\n  logic [3:0]  lane_fill_last;\n  logic        fill_last;\\\"\\\"\\\")\n  a=s.index(\\\"  assign fill_successor_word\\\")\n  b=s.index(\\\"  for (genvar bank\\\", a)\n  s=s[:a]+s[b:]\n  s=s.replace(\\\"fill_successor_index, (&fill_successor_word)\\\", \\\"fill_successor_index, fill_last\\\")\n  stem=\\\"\\\"\\\"    assign lane_fill_word[path] = candidate_taken[path] ? candidate_target[path] : sequential_word;\n    assign lane_fill_index[path] = candidate_taken[path] ? target_index : sequential_index;\n    assign lane_fill_last[path] = candidate_taken[path] ? (&candidate_target[path]) : sequential_last;\n\\\"\\\"\\\"\n  s=s.replace(\\\"    assign target_index = candidate_target[path][5:0] \"'^ candidate_target[path][11:6];'\"\\\\n\\\", \\\"    assign target_index = candidate_target[path][5:0] \"'^ candidate_target[path][11:6];'\"\\\\n\\\"+stem)\n  s=s.replace(\\\"    target_word = '0;\\\", \\\"    target_word = '0;\\\\n    fill_successor_word = '0;\\\\n    fill_successor_index = '0;\\\\n    fill_last = '0;\\\")\n  s=s.replace(\\\"      predict_taken |= select_request[path]\\\", \\\"\\\"\\\"      fill_successor_word |= {18{select_request[path]}} & lane_fill_word[path];\n      fill_successor_index |= {6{select_request[path]}} & lane_fill_index[path];\n      fill_last |= select_request[path] && lane_fill_last[path];\n      predict_taken |= select_request[path]\\\"\\\"\\\")\n p.write_text(s)\nPY\nfor variant in q6 q7 q8 metadata\ndo\n (NRET=1 RTL_DIR=\\\"\"'$scratch/$variant/cores/bench/rtl\" OBJ_DIR=\"$scratch/$variant/obj\" bash test/cosim/build.sh > \"$scratch/$variant/verilator.log\" 2>&1 &&\n  \"$scratch/$variant/obj/cosim_sim\" \"$scratch/sliced/bench/programs/coremark.elf\" 10000000 --bench --istall --dstall > \"$scratch/$variant/coremark.log\") &\n if test \"$variant\" = metadata; then\n  (python -m tools.eval.gowin bench --worktree \"$scratch/$variant\" --all-options --paths 4 > \"$scratch/$variant/timing.log\") &\n fi\ndone\nwait\nfor variant in q6 q7 q8 metadata; do printf '\"'%s\\\\n' \\\"\"'$variant\"; tail -n 1 \"$scratch/$variant/coremark.log\"; if test -f \"$scratch/$variant/timing.log\"; then cat \"$scratch/$variant/timing.log\"; fi; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
