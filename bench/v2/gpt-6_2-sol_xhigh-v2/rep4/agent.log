append(pc)\n            if pc == 16 and lookup_pc == 24 and int(fetch.lookup_hit.value):\n                repeated_hits += 1\n        if addr == alias + 24 and not int(dut.io_imemReady.value):\n            assert not int(fetch.accept_replay.value)\n            assert not int(fetch.replay_match.value)\n        # The old index still contains a valid word, with a dif\n…[5902 of 8974 chars elided by tools/bench/transcript.py; sha256:a95702b8c100ab9f]…\n [0x108, 0x10C, 0x100, 0x104, 0x108]\n    assert stores == []\n\n\n@cocotb.test()\nasync def fence_i_replaces_warm_code_and_restarts_the_sweep(dut):\n    old_instr, new_instr = ADDI(4, 4, 1), ADDI(4, 4, 7)\n    replacement_pc = 0x118\n    program = {\n676:async def jalr_recovery_waits_for_older_store_and_holds_target(dut):\n709:async def last_mapped_jalr_parks_fetch_until_ex_advances(dut):\n741:async def last_mapped_jalr_waits_for_space_in_full_queue(dut):\n908:    load_wrapped = LW(13, 1, 5)\n917:        ADDI(1, 0, -1), load_wrapped,                  # 0xffffffff + 5 wraps to 4\n948:        (load_wrapped, 0xFFFFFFFF, 4, 0b1111, 0x12345678),\n1196:async def replay_discards_stale_responses_and_yields_to_indirect_recovery(dut):\n1235:        recovery = int(fetch.recovery_pending_q.value)\n1237:            assert not stale and not recovery\n1245:            if recovery:\n1346:            if not int(fetch.recovery_pending_q.value) and not int(fetch.stale_request_q.value):\n1350:            assert int(fetch.recovery_pending_q.value)\n", "exit_code": 0, "status": "completed"}}
