{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r13-replay/timing.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nfrom concurrent.futures import ThreadPoolExecutor\nimport os,sys,json\nscratch=Path(os.environ['TMPDIR'])/'r13-replay'/sys.argv[1]\noptions=list(map(int,sys.argv[2:])) or [0,1,2]\nwith ThreadPoolExecutor(max_workers=len(options)) as ex:\n    futures = [ex.submit(build, Path.cwd(), scratch/'rtl','fpga/core_bench_si.sv',i,scratch/f'p{i}') for i in options]\n    results=[]\n    for f in futures:\n        r=f.result()\n        r['critical_paths']=r.get('critical_paths',[])[:2]\n        results.append(r)\n        print(json.dumps(r),flush=True)\nif len(results)==3:\n    print(json.dumps(summarize(results)))\nPY\nexport PYTHONPATH=\\\"\"'$PWD\"\npython -u \"$TMPDIR/r13-replay/timing.py\" d4l8b > \"$TMPDIR/r13-replay/d4l8b/timing.log\" &\npython -u \"$TMPDIR/r13-replay/timing.py\" d4p 1 > \"$TMPDIR/r13-replay/d4p/timing.log\" &\nwait\ncat \"$TMPDIR/r13-replay/d4l8b/timing.log\" \"$TMPDIR/r13-replay/d4p/timing.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
