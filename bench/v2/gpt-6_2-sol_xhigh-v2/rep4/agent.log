{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/b6587cd1/bench-predictor/late_recovery.py' <<'PY'\nfrom pathlib import Path\nfrom sys import argv\nroot=Path(argv[1])\nex=root/'ex_stage.sv'\ntop=root/'core.sv'\nifi=root/'if_stage.sv'\ns=ex.read_text()\ns=s.replace('  input  logic               stall,', '  input  logic               kill,\\\\n  input  logic               stall,')\ns=s.replace('  output logic               redirect,', '  output logic               recovery_advance,')\ns=s.replace('in.valid', 'valid_in')\ns=s.replace('  // ── Operand forwarding', '  logic valid_in;\\\\n  assign valid_in = in.valid && \"'!kill;'\"\\\\n\\\\n  // ── Operand forwarding')\ns=s.replace('  assign redirect        = advance && (in.last_mapped_word || (in.predicted_taken \"'!= actual_taken));'\"',\n            '  assign recovery_advance = advance;')\ns=s.replace('  assign redirect        = advance && (fence_i || in.last_mapped_word || (in.predicted_taken \"'!= actual_taken));'\"',\n            '  assign recovery_advance = advance;')\nex.write_text(s)\n\ns=top.read_text()\ns=s.replace('  logic        ex_direct_taken, ex_indirect_taken;', '''  logic        ex_direct_taken, ex_indirect_taken, recovery_advance;\n  logic        direct_taken_q, indirect_taken_q, recovery_valid_q;\n  logic        predicted_taken_q, last_mapped_word_q;\n  always_ff @(posedge clock) begin\n    direct_taken_q <= ex_direct_taken;\n    indirect_taken_q <= ex_indirect_taken;\n    predicted_taken_q <= id_ex_w.predicted_taken;\n    last_mapped_word_q <= id_ex_w.last_mapped_word;\n    recovery_valid_q <= \"'!reset && recovery_advance;\n  end\n  assign redirect = recovery_valid_q && (last_mapped_word_q ||\n      (predicted_taken_q != (direct_taken_q || indirect_taken_q)));'\"''')\ns=s.replace('.ex_direct_taken (ex_direct_taken)', '.ex_direct_taken (direct_taken_q)')\ns=s.replace('.ex_indirect_taken (ex_indirect_taken)', '.ex_indirect_taken (indirect_taken_q)')\ns=s.replace('.flush    (load_use_hazard || redirect)', '.flush    (load_use_hazard)')\ns=s.replace('    .stall           (stall_ex_mem),', '    .kill            (redirect),\\\\n    .stall           (stall_ex_mem),')\ns=s.replace('    .redirect        (redirect),\\\\n    .direct_taken', '    .recovery_advance (recovery_advance),\\\\n    .direct_taken')\ns=s.replace('.id_ex_valid     (id_ex_w.valid)', '.id_ex_valid     (id_ex_w.valid && \"'!redirect)'\"')\nif 'fence_i;' in s:\n    s=s.replace('  assign redirect =', '  logic fence_i_q;\\\\n  always_ff @(posedge clock) fence_i_q <= fence_i;\\\\n  assign redirect =')\n    s=s.replace('&& (last_mapped_word_q ||', '&& (fence_i_q || last_mapped_word_q ||')\ntop.write_text(s)\n\ns=ifi.read_text()\nfor n in ['sequential','direct','indirect']:\n    s=s.replace(f'    select_{n}_q',f'  assign select_{n}_q',1)\npos=s.index('  assign select_sequential_q')\nend=s.index('    if (reset) begin',pos)\nsels=s[pos:end]\ns=s[:pos]+s[end:]\ns=s.replace('      recovery_pending_q <= 1\\\\'b0;\\\\n','')\ns=s.replace('      recovery_pending_q <= redirect;\\\\n','')\ns=s.replace('  assign '+('producer_pc' if 'producer_pc' in s else 'imem_addr')+' =', \\\"  assign recovery_pending_q = redirect;\\\\n\\\"+sels+'  assign '+('producer_pc' if 'producer_pc' in s else 'imem_addr')+' =')\nifi.write_text(s)\nPY\nset -e\nfor model in champion champion-split; do\n  mkdir -p '/srv/hwebench/tmp/58928045/b6587cd1/bench-predictor/'\\\"\"'$model\"'\"'-late-rtl'\n  cp '/srv/hwebench/tmp/58928045/b6587cd1/bench-predictor/'\\\"\"'$model\"'\"'-rtl/'*.sv '/srv/hwebench/tmp/58928045/b6587cd1/bench-predictor/'\\\"\"'$model\"'\"'-late-rtl/'\n  python3 '/srv/hwebench/tmp/58928045/b6587cd1/bench-predictor/late_recovery.py' '/srv/hwebench/tmp/58928045/b6587cd1/bench-predictor/'\\\"\"'$model\"'\"'-late-rtl'\ndone\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
