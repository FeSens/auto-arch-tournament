{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,240p' formal/wrapper_si.sv; sed -n '1,85p' Makefile; rg -n 'synth|dmem|imem' fpga/core_bench_si.sv | head -45; git status --short --ignored cores/bench/experiments/hypotheses\"", "aggregated_output": "// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[4713 of 7785 chars elided by tools/bench/transcript.py; sha256:9559012b16a8d0be]…\n logic [3:0]  dmem_wen;\n27:  logic        dmem_ren;\n30:    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n31:    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n32:    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n33:    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n35:  assign dmem_rdata = dmem[dmem_addr[12:2]];\n37:  logic [31:0] imem_addr;\n39:  // elaboration only; nothing observes it, so synthesis prunes it.\n53:  logic imem_ready, dmem_ready;\n57:    .imem_ready (imem_ready),\n58:    .dmem_ready (dmem_ready)\n64:    .io_imemAddr      (imem_addr),\n65:    .io_imemData      (lfsr),\n66:    .io_imemReady     (imem_ready),\n67:    .io_dmemAddr      (dmem_addr),\n68:    .io_dmemWData     (dmem_wdata),\n69:    .io_dmemRData     (dmem_rdata),\n70:    .io_dmemWEn       (dmem_wen),\n71:    .io_dmemREn       (dmem_ren),\n72:    .io_dmemReady     (dmem_ready),\n100:  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n", "exit_code": 0, "status": "completed"}}
