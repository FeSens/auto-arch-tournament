) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    \n…[10250 of 13322 chars elided by tools/bench/transcript.py; sha256:928db39cb5173449]…\n requests = []\n    rets, _ = await _run(dut, program, store_requests=requests, unready_fetches={\n        (4, 1): SW(1, 0, 0x40),\n        (8, 1): JAL(5, 0x40),\n        (12, 1): LW(3, 0, 0x40),  # The ready fetch uses x3.\n        (16, 1): MULH(5, 1, 2),\n    })\n\n    assert requests == []\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert [r[\"rd_wdata\"] for r in rets[:-1]] == [1, 2, 3, 4, 5]\n    cycles = [r[\"cycle\"] for r in rets]\n    assert [b - a for a, b in zip(cycles, cycles[1:])] == [2, 2, 2, 2, 1]\n\n\n@cocotb.test()\nasync def fetch_queue_fills_and_issues_during_imem_stall(dut):\n    program = [ADDI(1, 0, 23), SW(1, 0, 0x40)]\n    program += [ADDI(reg, reg - 1, 1) for reg in range(2, 10)]\n    program += [EBREAK()]\n    fetches, stores = [], []\n    rets, dmem = await _run(\n        dut, program, fetch_requests=fetches, store_requests=stores, store_stalls=7,\n        unready_fetches={(36, n): SW(1, 0, 0x44) for n in range(1, 4)},\n    )\n", "exit_code": 0, "status": "completed"}}
