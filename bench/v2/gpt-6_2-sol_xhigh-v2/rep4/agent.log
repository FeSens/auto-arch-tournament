{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\n\nrtl = Path(\\\"cores/bench/rtl\\\")\n\ndef edit(name, blocks):\n    path = rtl / name\n    source = path.read_text()\n    for old, new in blocks:\n        assert source.count(old) == 1, (path, old)\n        source = source.replace(old, new)\n    path.write_text(source)\n\nex = (rtl / \\\"ex_stage.sv\\\").read_text()\nstart = ex.index(\\\"  // ── RV32M arithmetic\\\")\nend = ex.index(\\\"  // ── Branch resolve\\\")\nedit(\\\"ex_stage.sv\\\", [\n    (\\\"  output logic               arithmetic_wait,  // hold IF and ID/EX\\\",\n     \\\"\\\"\\\"  input  logic               div_consume,\n  output logic               div_done,\n  output logic [31:0]        div_result,\\\"\\\"\\\"),\n    (ex[start:end], \\\"\\\"\\\"  logic div_instr;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic div_ready;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign div_instr = in.valid && (in.ctrl.alu_op == ALU_DIV || in.ctrl.alu_op == ALU_DIVU ||\n                                  in.ctrl.alu_op == ALU_REM || in.ctrl.alu_op == ALU_REMU);\n\n  div_unit u_div (\n    .clock   (clock),\n    .reset   (reset),\n    .start   (div_instr && \"'!stall),\n    .consume (div_consume),\n    .op      (in.ctrl.alu_op),\n    .a       (rs1),\n    .b       (rs2),\n    .ready   (div_ready),\n    .done    (div_done),\n    .result  (div_result)\n  );\n\n\"\"\"),\n    (\"in.valid && !arithmetic_wait\", \"in.valid\"),\n    (\"\"\"in.ctrl.is_jump            ? (in.pc + 32'\"'d4)\n                            : in.ctrl.alu_op == ALU_MUL ? mul_low_result\n                            : mul_high_instr           ? mul_high_result\n                            : div_instr                ? div_result\n                                                       : alu_result;\\\"\\\"\\\",\n     \\\"in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\\\"),\n    (\\\"(mul_high_instr || div_instr) ? issued_rs1_q : rs1\\\", \\\"rs1\\\"),\n    (\\\"(mul_high_instr || div_instr) ? issued_rs2_q : rs2\\\", \\\"rs2\\\"),\n])\nedit(\\\"mul_unit.sv\\\", [\n    (\\\"\\\"\\\"  logic        active_q;\n  logic        launch, finish;\\\"\\\"\\\", \\\"  logic        launch;\\\"),\n    (\\\"assign ready  = \"'!active_q;\", \"assign ready  = !done;\"),\n    (\"  assign finish = active_q && !done;\", \"  assign high_result = corrected_high;\"),\n    (\"\"\"    if (reset) begin\n      active_q <= 1'\"'b0;\n      done     <= 1'b0;\n    end else if (launch) begin\n      active_q <= 1'b1;\n    end else if (finish) begin\n      done     <= 1'b1;\n    end else if (done && consume) begin\n      active_q <= 1'b0;\n      done     <= 1'b0;\n    end\n\n    if (finish) high_result <= corrected_high;\\\"\\\"\\\",\n     \\\"\\\"\\\"    if (reset || consume) done <= 1'b0;\n    else if (launch)      done <= 1'b1;\\\"\\\"\\\"),\n])\nedit(\\\"div_unit.sv\\\", [\n    (\\\"assign ready   = \"'!active_q;\", \"assign ready   = !active_q || (done && consume);\"),\n    (\"  logic [31:0] magnitude;\", \"\"\"  logic [31:0] magnitude;\n  logic [33:0] divisor_triple_q;\"\"\"),\n    (\"\"\"    for (int step = 0; step < 4; step++) begin\n      logic [32:0] shifted_remainder;\n      // Bit 33 is the borrow. A successful subtraction leaves a 32-bit\n      // remainder, so bit 32 of the difference is discarded.\n      /* verilator lint_off UNUSEDSIGNAL */\n      logic [33:0] difference;\n      /* verilator lint_on UNUSEDSIGNAL */\n      shifted_remainder = {remainder_next, dividend_quotient_next[31]};\n      difference = {1'\"'b0, shifted_remainder} - {2'b0, divisor_q};\n      remainder_next = difference[33] ? shifted_remainder[31:0] : difference[31:0];\n      dividend_quotient_next = {dividend_quotient_next[30:0], \"'!difference[33]};\n    end\"\"\",\n     \"\"\"    if (cycles_left_q == 3'\"'d7) begin\n      for (int step = 0; step < 4; step++) begin\n        logic [7:0] shifted;\n        logic [8:0] difference;\n        logic fits;\n        shifted = {remainder_next[6:0], dividend_quotient_next[31]};\n        difference = {1'b0, shifted} - {1'b0, divisor_q[7:0]};\n        fits = divisor_q[31:8] == 24'b0 && \"'!difference[8];\n        remainder_next = {24'\"'b0, fits ? difference[7:0] : shifted};\n        dividend_quotient_next = {dividend_quotient_next[30:0], fits};\n      end\n    end else begin\n      for (int step = 0; step < 2; step++) begin\n        logic [34:0] shifted;\n        /* verilator lint_off UNUSEDSIGNAL */\n        logic [34:0] difference_one, difference_two, difference_three;\n        /* verilator lint_on UNUSEDSIGNAL */\n        logic [1:0] digit;\n        shifted = {1'b0, remainder_next, dividend_quotient_next[31:30]};\n        difference_one = shifted - {3'b0, divisor_q};\n        difference_two = shifted - {2'b0, divisor_q, 1'b0};\n        difference_three = shifted - {1'b0, divisor_triple_q};\n        if (\"'!difference_three[34]) begin\n          remainder_next = difference_three[31:0];\n          digit = 2'\"'d3;\n        end else if (\"'!difference_two[34]) begin\n          remainder_next = difference_two[31:0];\n          digit = 2'\"'d2;\n        end else if (\"'!difference_one[34]) begin\n          remainder_next = difference_one[31:0];\n          digit = 2'\"'d1;\n        end else begin\n          remainder_next = shifted[31:0];\n          digit = 2'd0;\n        end\n        dividend_quotient_next = {dividend_quotient_next[29:0], digit};\n      end\n    end\\\"\\\"\\\"),\n    (\\\"\\\"\\\"    end else if (iterate) begin\n      dividend_quotient_q\\\"\\\"\\\", \\\"\\\"\\\"    end else if (iterate) begin\n      if (cycles_left_q == 3'd7)\n        divisor_triple_q <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\n      dividend_quotient_q\\\"\\\"\\\"),\n])\nedit(\\\"core_pkg.sv\\\", [\n    (\\\"\\\"\\\"    logic [31:0] alu_result;\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)\\\"\\\"\\\",\n     \\\"\\