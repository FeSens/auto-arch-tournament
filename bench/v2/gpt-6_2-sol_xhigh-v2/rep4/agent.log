{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"python3 - '/srv/hwebench/tmp/58928045/39c9f928/bench-predictor.kwJcyq' <<'PY'\nimport collections\nimport json\nfrom pathlib import Path\nimport struct\nimport sys\n\np = Path(sys.argv[1])\nmeta = json.loads((p/'baseline.jsonl').read_text().splitlines()[-1])\nstart, stop = (meta['bench_start_cycle'], meta['bench_stop_cycle'])\ncycles = stop-start\nentries = struct.iter_unpack('<IIIII', (p/'trace.bin').read_bytes())\nkinds = {0x63: 'branch', 0x6f: 'JAL', 0x67: 'JALR'}\nstats = collections.Counter()\ntransfers = []\nfor cycle, pc, nxt, insn, trap in entries:\n    if cycle >= stop:\n        break\n    timed = cycle >= start\n    if timed:\n        stats['retired'] += 1\n    kind = kinds.get(insn & 0x7f)\n    if kind is None or trap:\n        continue\n    fallthrough = (pc+4)&0xffffffff\n    taken = kind \"'!= '\"'branch' or nxt \"'!= fallthrough\n    if timed:\n        stats[kind] += 1\n        stats['\"'nonsequential'] += nxt \"'!= fallthrough\n        stats[kind+'\"'_taken'] += taken\n        if kind == 'branch' and (insn >> 31) \"'!= 0:\n            stats['\"'bwd'] += 1\n            stats['bwd_taken'] += taken\n        static_prediction = kind=='JAL' or (kind=='branch' and insn>>31)\n        stats['bftnt_misses'] += static_prediction \"'!= (taken and kind != '\"'JALR') or kind=='JALR'\n    transfers.append((pc, nxt, fallthrough, kind, taken, timed))\n\nprint(stats, 'branch transfer opportunities')\nprint('static BTFNT+JAL modeled net redirects avoided:', stats['nonsequential']-stats['bftnt_misses'])\nfor n in (16, 32, 64, 128, 256):\n    for width in (1, 2):\n        for indirect in (False, True):\n            table = [(-1, 0, 0)]*n\n            misses = collections.Counter()\n            for pc, nxt, fallthrough, kind, taken, timed in transfers:\n                slot = (pc>>2) & (n-1)\n                tag, target, state = table[slot]\n                hit = tag == pc\n                predicts_taken = hit and state >= 1 << (width-1)\n                prediction = target if predicts_taken else fallthrough\n                if timed and nxt \"'!= prediction:\n                    misses[kind] += 1\n                if kind == '\"'JALR' and not indirect:\n                    continue\n                if kind == 'branch':\n                    if hit:\n                        updated = min(state+1, (1<<width)-1) if taken else max(state-1,0)\n                        table[slot] = (pc, nxt if taken else target, updated)\n                    elif taken:\n                        table[slot] = (pc, nxt, 1 << (width-1))\n                else:\n                    table[slot] = (pc, nxt, (1<<width)-1)\n            saved = stats['nonsequential'] - misses.total()\n            print(n, width, indirect, 'misses', dict(misses), 'redirects avoided', saved, 'baseline cycles %', round(100*saved/cycles,2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
