{"type":"item.completed","item":{"id":"item_36","type":"agent_message","text":"The 32-entry target buffer cut nearly 100,000 timed cycles in scratch simulation. Gowin timing showed that the asynchronous lookup erased that gain, and sending replay straight to decode cost even more clock speed. I’m testing whether reading the target buffer one cycle earlier can retain the cycle savings."}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c 'cat >\"$TMPDIR/hyp_profile/pair_proto.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport shutil\n\nscratch=Path(os.environ['TMPDIR'])/'hyp_profile'\nfor version, src, both, storage in [\n        ('pair_dist', 'seq32_fast', False, 'distributed_ram'),\n        ('pair_block', 'seq32_fast', False, 'block_ram'),\n        ('pair_both', 'seq32_fast', True, 'distributed_ram'),\n]:\n    dst=scratch/version/'rtl'\n    shutil.copytree(scratch/src/'rtl',dst,dirs_exist_ok=True)\n    p=dst/'if_stage.sv'\n    s=p.read_text()\n    begin=s.index('  localparam int L0_INDEX_WIDTH')\n    end=s.index('  // Explicit vectors keep',begin)\n    x=s[begin:end]\n    x=x.replace('  (* syn_ramstyle = \\\"distributed_ram\\\" *)\\\\n  logic [\"'$bits(l0_record_t)-1:0] l0_ram [0:L0_DEPTH-1];'\"\\\\n','')\n    x=x.replace('  l0_record_t l0_read, l0_fill_record_q;',\n      '  l0_record_t l0_read, l0_fill_record_q;')\n    i=x.index('  assign l0_index')\n    j=x.index('  assign replay_predict_taken',i)\n    x=x[:i]+'''  logic [L0_INDEX_WIDTH-1:0] short_bus_target, short_target, short_target_plus_one;\n  logic [L0_INDEX_WIDTH-1:0] bank_index [0:1];\n  logic [L0_INDEX_WIDTH-1:0] even_index_q, odd_index_q;\n  logic [1:0] bank_valid_q;\n  l0_record_t lookup_even_q, lookup_odd_q;\n\n  // Address the two parity banks in parallel. Tags and the accepted\n  // producer give the final authorization in the following cycle.\n  assign short_bus_target = request_pc[L0_INDEX_WIDTH+1:2] + word_offset[L0_INDEX_WIDTH-1:0];\n  assign short_target = '''+('bus_valid ? short_bus_target : replay_prediction.target[L0_INDEX_WIDTH-1:0]' if both else 'short_bus_target')+''';\n  assign short_target_plus_one = short_target + 1'b1;\n  assign bank_index[0] = {short_target[0] ? short_target_plus_one[L0_INDEX_WIDTH-1:1]\n                                          : short_target[L0_INDEX_WIDTH-1:1], 1'b0};\n  assign bank_index[1] = {short_target[L0_INDEX_WIDTH-1:1], 1'b1};\n\n  logic launch_pair;\n  assign launch_pair = step_bus_taken'''+(' || (accept_replay && replay_predict_taken)' if both else '')+''';\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) bank_valid_q <= '0;\n    else if (launch_pair) begin\n      bank_valid_q[0] <= l0_valid_q[bank_index[0]]\n                         && \"'!(l0_fill_q && l0_fill_index_q == bank_index[0]);\n      bank_valid_q[1] <= l0_valid_q[bank_index[1]]\n                         && !(l0_fill_q && l0_fill_index_q == bank_index[1]);\n      even_index_q <= bank_index[0];\n      odd_index_q <= bank_index[1];\n    end\n  end\n\n  (* syn_ramstyle = \"'\"'''+storage+'''\\\" *)\n  logic [\"'$bits(l0_record_t)-1:0] l0_even [0:L0_DEPTH/2-1];\n  (* syn_ramstyle = \"'\"'''+storage+'''\\\" *)\n  logic [\"'$bits(l0_record_t)-1:0] l0_odd [0:L0_DEPTH/2-1];\n\n  always_ff @(posedge clock) begin\n    if (l0_fill_q && !l0_fill_index_q[0])\n      l0_even[l0_fill_index_q[L0_INDEX_WIDTH-1:1]] <= l0_fill_record_q;\n    if (l0_fill_q && l0_fill_index_q[0])\n      l0_odd[l0_fill_index_q[L0_INDEX_WIDTH-1:1]] <= l0_fill_record_q;\n    if (launch_pair) begin\n      lookup_even_q <= l0_even[bank_index[0][L0_INDEX_WIDTH-1:1]];\n      lookup_odd_q  <= l0_odd[bank_index[1][L0_INDEX_WIDTH-1:1]];\n    end\n  end\n\n  assign l0_index = predicted_pc_q[L0_INDEX_WIDTH+1:2];\n  assign l0_read = l0_index[0] ? lookup_odd_q : lookup_even_q;\n  assign l0_hit = (l0_index[0] ? bank_valid_q[1] && odd_index_q == l0_index\n                              : bank_valid_q[0] && even_index_q == l0_index)\n              && l0_read.tag == predicted_pc_q[19:L0_INDEX_WIDTH+2];\n'\"'''+x[j:]\n    x=x.replace('    if (l0_fill_q) l0_ram[l0_fill_index_q] <= l0_fill_record_q;\\\\n','')\n    p.write_text(s[:begin]+x+s[end:])\nPY\npython \\\"\"'$TMPDIR/hyp_profile/pair_proto.py\"\nfor variant in pair_dist pair_block pair_both; do\n  bash \"$TMPDIR/hyp_profile/build_variant.sh\" \"$variant\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
