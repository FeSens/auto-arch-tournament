{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c 'work=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\npython3 - \"$work/ref-trace.jsonl.gz\" <<'\"'PY'\nimport gzip, json, sys\nschemes = [(5,0),(6,0),(7,0),(8,0),(5,1),(6,1),(7,1),(5,2),(6,2),(7,2),(8,2)]\nregions = [[None] * (1 << bankbits) for _, bankbits in schemes]\ncoverage = [0] * len(schemes)\ntotal = 0\nwith gzip.open(sys.argv[1], 'rt') as trace:\n for line in trace:\n  rec = json.loads(line)\n  if not 14126 <= rec['cycle'] <= 3970230:\n   continue\n  p, t, insn = rec['pc_rdata'], rec['pc_wdata'], rec['insn']\n  backward = t < p and insn & 0x7f == 0x63\n  total += 1\n  for i,(bits,bankbits) in enumerate(schemes):\n   shift = bits+2\n   bank = (p>>shift) & ((1<<bankbits)-1)\n   region = regions[i][bank]\n   if region is not None and region[0] <= p <= region[1]:\n    coverage[i] += 1\n   if backward and (p >> shift) == (t >> shift):\n    if region is None or (t < region[0] or p > region[1]):\n     regions[i][bank] = (t,p)\nprint(*[(1<<bits,1<<bankbits,round(c/total,4)) for (bits,bankbits),c in zip(schemes,coverage)],sep='\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
