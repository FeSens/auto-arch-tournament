{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY' > timing-variants-3.log 2>&1\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nrtl = root / \\\"cores/bench/rtl\\\"\nsource = (rtl / \\\"if_stage.sv\\\").read_text()\nstart = source.index(\\\"  assign target_in_window\\\")\nend = source.index(\\\"  assign sequential_low\\\", start)\nold_range = source[start:end]\nchange_select_range = \\\"\\\"\\\"  assign target_in_window = page_changed\n                         ? (offset_negative ? pc_page == 12'd1 : pc_page == 12'hfff)\n                         : pc_page == 12'd0;\n\n\\\"\\\"\\\"\nnegative_select_range = \\\"\\\"\\\"  assign target_in_window = offset_negative\n                         ? (pc_page[11:1] == 11'd0 && pc_page[0] \"'!= low_carry)\n                         : (low_carry ? pc_page == 12'\"'hfff : pc_page == 12'd0);\n\n\\\"\\\"\\\"\ncarry_select_lsb_range = \\\"\\\"\\\"  assign target_in_window = low_carry\n                         ? (offset_negative ? pc_page == 12'd0 : pc_page == 12'hfff)\n                         : (pc_page[11:1] == 11'd0 && pc_page[0] == offset_negative);\n\n\\\"\\\"\\\"\npage_constants = \\\"\\\"\\\"  logic page_is_zero, page_is_one, page_is_max;\n  assign page_is_zero = pc_page == 12'd0;\n  assign page_is_one  = pc_page == 12'd1;\n  assign page_is_max  = pc_page == 12'hfff;\n  assign target_in_window = (page_up && page_is_max) || (page_down && page_is_one)\n                         || (page_same && page_is_zero);\n\n\\\"\\\"\\\"\nstart = source.index(\\\"  assign page_up\\\")\nend = source.index(\\\"  assign direct_target\\\", start)\nold_select = source[start:end]\nselect_changed_page = \\\"\\\"\\\"  assign page_changed = low_carry \"'!= offset_negative;\n  assign adjusted_page = offset_negative ? pc_page_dec : pc_page_inc;\n  assign target_page = page_changed ? adjusted_page : pc_page;\n\"\"\"\nchange_declarations = [\n    (\"  logic        page_up, page_down, page_same, target_in_window;\", \n     \"  logic        page_changed, target_in_window;'\"\\\\n  logic [11:0] adjusted_page;\\\"),\n    (old_select, select_changed_page),\n]\nvariants = {\n    \\\"page_change_mux\\\": [*change_declarations, (old_range, change_select_range)],\n    \\\"negative_selected_window\\\": [(old_range, negative_select_range)],\n    \\\"carry_selected_window_lsb\\\": [(old_range, carry_select_lsb_range)],\n    \\\"named_page_compares\\\": [(old_range, page_constants)],\n    \\\"carry_selected_window_aligned\\\": [\n        (source, (root / \\\"timing-variants/carry_selected_window/rtl/if_stage.sv\\\").read_text()),\n        (\\\"sequential_low, imem_addr[1:0]};\\\", \\\"sequential_low, 2'b00};\\\"),\n    ],\n}\n\ndef run(item):\n    name, replacements = item\n    variant_rtl = root / \\\"timing-variants\\\" / name / \\\"rtl\\\"\n    shutil.copytree(rtl, variant_rtl)\n    variant_source = source\n    for original, replacement in replacements:\n        assert original in variant_source\n        variant_source = variant_source.replace(original, replacement)\n    (variant_rtl / \\\"if_stage.sv\\\").write_text(variant_source)\n    result = build(root, variant_rtl, \\\"fpga/core_bench_si.sv\\\", 1, variant_rtl.parent / \\\"gowin_p1\\\")\n    print(name, result[\\\"fmax_mhz\\\"], result[\\\"logic\\\"], (result[\\\"critical_paths\\\"] or [None])[0], flush=True)\n\nwith ThreadPoolExecutor(max_workers=4) as workers:\n    list(workers.map(run, variants.items()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
