{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c 'set -e\nscratch_root=\"$TMPDIR/bench-r8s1-trained\"\ncat >>\"$scratch_root/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\nasync def older_redirect_discards_queued_mapped_edge(dut):\n    last = 0x000FFFFC\n    program = {\n        0: ADDI(5, 0, 0x21),\n        4: JAL(0, last - 12),\n        last - 8: SW(5, 0, 0x40),\n        last - 4: JALR(1, 5, 0),\n        last: SW(5, 0, 0x44),\n        0x20: ADDI(7, 1, 42),\n        0x24: EBREAK(),\n    }\n    fetches, stores = [], []\n    rets, dmem = await _run(\n        dut, program, fetch_requests=fetches, store_requests=stores, store_stalls=4,\n        unready_fetches={(0x20, 1): SW(5, 0, 0x48)},\n    )\n    assert (last, True) in fetches\n    target = fetches.index((0x20, False))\n    assert fetches[target+1] == (0x20, True)\n    assert all(0 <= pc <= last and pc % 4 == 0 for pc, _ in fetches)\n    assert [rec[\\\"pc\\\"] for rec in rets] == [0, 4, last-8, last-4, 0x20, 0x24]\n    assert [rec[\\\"order\\\"] for rec in rets] == list(range(len(rets)))\n    assert rets[3][\\\"rd_wdata\\\"] == last\n    assert dmem == {0x40: 0x21}\n    assert all(addr == 0x40 for addr, _, _, _ in stores)\n\n\n@cocotb.test()\nasync def mapped_edge_jalr_followed_by_divide_keeps_retirement_bound(dut):\n    last = 0x000FFFFC\n    program = {\n        0: ADDI(5, 0, 0x21),\n        4: JAL(0, last - 4),\n        last: JALR(1, 5, 0),\n        0x20: DIV(7, 1, 5),\n        0x24: EBREAK(),\n    }\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_requests=fetches)\n    assert all(0 <= pc <= last and pc % 4 == 0 for pc, _ in fetches)\n    assert [rec[\\\"pc\\\"] for rec in rets] == [0, 4, last, 0x20, 0x24]\n    assert [rec[\\\"order\\\"] for rec in rets] == list(range(len(rets)))\n    assert rets[2][\\\"rd_wdata\\\"] == last + 4 and rets[2][\\\"pc_next\\\"] == 0x20\n    assert rets[3][\\\"rd_wdata\\\"] == (last + 4) // 0x21\n    assert rets[3][\\\"cycle\\\"] - rets[2][\\\"cycle\\\"] <= 10\nPY\ncd \\\"\"'$scratch_root\"\nstatus=0\npytest -q test/test_pipeline.py > directed-summary.log 2>&1 || status=$?\ntail -40 directed-summary.log\nexit \"$status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
