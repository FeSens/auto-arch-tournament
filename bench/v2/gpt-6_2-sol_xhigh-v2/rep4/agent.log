\"\"\")\n    a = source.index(\"  assign normal_head = empty\")\n    b = source.index(\"  // Form the normal ring\", a)\n    source = source[:a] + \"\"\"  assign normal_head = empty ? produced : buffered_head;\n  assign out.pc               = recovery_pending_q ? request_pc : {normal_head.word_pc, 2'\"'b00};\n  assign out.instr            = recovery_pending_q ? imem_data : normal_head.instr;\n  assign out.predicted_taken  = recovery_pending_q ? predict_taken : normal_head.predicted_taken;\n  assign out.last_mapped_word = recovery_pending_q ? request_last_word : normal_head.last_mapped_word;\n  assign out.valid            = recovery_pending_q ? imem_ready : (\"'!empty || normal_bus_valid || normal_accept_replay);\n\n\"\"\" + source[b:]\n    if direct_decode:\n        source = source.replace(\"  assign out.instr            = recovery_pending_q ? imem_data : normal_head.instr;\", \"\"\"  logic issue_bus, issue_replay, issue_buffered;\n  assign issue_bus = recovery_pending_q || (empty && normal_bus_valid);\n  assign issue_buffered = !recovery_pending_q && !empty;\n  assign issue_replay = !recovery_pending_q && empty && !normal_bus_valid;\n  assign out.instr = ({32{issue_bus}} & imem_data)\n                   | ({32{issue_buffered}} & buffered_head.instr)\n                   | ({32{issue_replay}} & replay_prediction.instr);\"\"\")\n    source = source.replace(\"(normal_bus_valid ? bus_follower : '\"'0)\\\", \\\"(normal_bus_valid ? bus_follower : (normal_accept_replay ? replay_follower : '0))\\\")\n    source = source.replace(\\\"\\\"\\\"  assign enqueue = normal_accept_replay || (normal_accept_bus &&\n                   (\"'!empty || issue_hold || (load_in_ex && bus_follower.interlock)));\"\"\", \"\"\"  assign enqueue = (normal_accept_replay &&\n                   (!empty || issue_hold || (load_in_ex && replay_follower.interlock))) ||\n                   (normal_accept_bus &&\n                   (!empty || issue_hold || (load_in_ex && bus_follower.interlock)));\"\"\")\n 