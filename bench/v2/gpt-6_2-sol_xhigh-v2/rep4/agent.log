{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -c \"mkdir -p divider_equivalence\nsed 's/module div_unit (/module baseline_divider (/' /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep4/cores/bench/worktrees/hyp-20261121-002-r6s1-hypgen/cores/bench/rtl/div_unit.sv > divider_equivalence/baseline_divider.sv\ncat > divider_equivalence/divider_miter.sv <<'SV'\nmodule divider_miter(input logic clock);\n  (* anyconst *) logic [31:0] a, b;\n  (* anyconst *) logic [4:0] op;\n  logic [3:0] cycle_q;\n  logic baseline_done, candidate_done;\n  logic baseline_ready, candidate_ready;\n  logic [31:0] baseline_result, candidate_result;\n\n  always_ff @(posedge clock)\n    if (cycle_q \"'!= 4'\"'d15) cycle_q <= cycle_q + 4'd1;\n\n  baseline_divider baseline (\n    .clock(clock), .reset(cycle_q == 4'd0), .start(cycle_q == 4'd2),\n    .consume(cycle_q == 4'd13), .a(a), .b(b), .op(op),\n    .ready(baseline_ready), .done(baseline_done), .result(baseline_result)\n  );\n  div_unit candidate (\n    .clock(clock), .reset(cycle_q == 4'd0), .start(cycle_q == 4'd1),\n    .consume(cycle_q == 4'd13), .a(a), .b(b), .op(op),\n    .ready(candidate_ready), .done(candidate_done), .result(candidate_result)\n  );\n\n  always_comb begin\n    if (cycle_q >= 4'd3) begin\n      assert(baseline_done == candidate_done && baseline_ready == candidate_ready);\n      if (baseline_done) assert(baseline_result == candidate_result);\n    end\n    if (cycle_q >= 4'd10 && cycle_q <= 4'd13) assert(candidate_done);\n  end\nendmodule\nSV\nyosys -Q -T -p 'read_verilog -formal -sv cores/bench/rtl/core_pkg.sv divider_equivalence/baseline_divider.sv cores/bench/rtl/div_unit.sv divider_equivalence/divider_miter.sv; prep -top divider_miter -flatten; chformal -lower; opt_clean; sat -set-init-zero -seq 15 -prove-asserts -verify -timeout 90' > divider_equivalence/proof.log\ntail -n 13 divider_equivalence/proof.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
