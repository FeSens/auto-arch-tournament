ILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[2666 of 5738 chars elided by tools/bench/transcript.py; sha256:ce09e3dce7303343]…\n str, sim_bin: str | None = None, env: dict | None = None) -> dict:\n210:    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\n220:                'reason': f'coremark_harness_error: {e}'}\n251:    valid, reason = validate_coremark_uart(uart, iterations)\n257:    # bench/programs/coremark/baremetal/core_portme.c's start/stop_time.\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n284:            return False, f'coremark_unvalidated_seed_or_size: {uart[-500:]}'\n286:            return False, f'coremark_reported_error: {uart[-500:]}'\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n299:            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n341:        'ipc_coremark': float,           — iter/cycle\n372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n", "exit_code": 0, "status": "completed"}}
