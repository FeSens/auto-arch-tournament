{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name, seed_variant in (('recovery', 'control'), ('recovery_retimed', 'retimed')):\n    variant = root / name\n    source = root / seed_variant\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    rtl_dir = variant / 'cores/bench/rtl'\n    path = rtl_dir / 'ex_stage.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace('  output logic               direct_taken,\\\\n  output logic               indirect_taken,',\n                      '  output logic               recover_direct,\\\\n  output logic               recover_indirect,\\\\n  output logic               recover_sequential,')\n    rtl = rtl.replace('  logic        transfer_taken, actual_taken;',\n                      '  logic        transfer_taken, actual_taken, direct_taken, indirect_taken;')\n    start = rtl.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n    end = rtl.index('\\\\n  assign branch_taken', start)\n    alt = (root / 'word_slices/cores/bench/rtl/ex_stage.sv').read_text()\n    rtl = rtl[:start] + alt[alt.index('  logic [3:0] byte_eq, byte_lt;'):alt.index('\\\\n  assign branch_taken')] + rtl[end:]\n    rtl = rtl.replace('  assign redirect        = advance && (in.last_mapped_word || (in.predicted_taken \"'!= actual_taken));'\"',\n                      '''  assign redirect           = advance && (in.last_mapped_word || (in.predicted_taken \"'!= actual_taken));\n  assign recover_direct     = advance && direct_taken && (in.last_mapped_word || !in.predicted_taken);\n  assign recover_indirect   = advance && indirect_taken && (in.last_mapped_word || !in.predicted_taken);\n  assign recover_sequential = advance && !actual_taken && (in.last_mapped_word || in.predicted_taken);'\"''')\n    rtl = rtl.replace('assign train_taken = branch_taken;', 'assign train_taken = branch_cond;')\n    path.write_text(rtl)\n    path = rtl_dir / 'core.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace('ex_direct_taken', 'recover_direct').replace('ex_indirect_taken', 'recover_indirect')\n    rtl = rtl.replace('logic        recover_direct, recover_indirect;', 'logic        recover_direct, recover_indirect, recover_sequential;')\n    rtl = rtl.replace('.recover_indirect (recover_indirect),', '.recover_indirect (recover_indirect),\\\\n    .recover_sequential (recover_sequential),')\n    rtl = rtl.replace('.direct_taken    (recover_direct),', '.recover_direct  (recover_direct),')\n    rtl = rtl.replace('.indirect_taken  (recover_indirect),', '.recover_indirect (recover_indirect),\\\\n    .recover_sequential (recover_sequential),')\n    path.write_text(rtl)\n    path = rtl_dir / 'if_stage.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace('ex_direct_taken', 'recover_direct').replace('ex_indirect_taken', 'recover_indirect')\n    rtl = rtl.replace('  input  logic              recover_indirect,\\\\n','  input  logic              recover_indirect,\\\\n  input  logic              recover_sequential,\\\\n')\n    rtl = rtl.replace('redirect && \"'!recover_direct && !recover_indirect'\"', 'recover_sequential').replace('redirect && recover_', 'recover_')\n    path.write_text(rtl)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(task):\n    name, option = task\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', option, variant / 'timing' / f'p{option}')\n    print(name, option, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    list(executor.map(trial, [(name,option) for name in ('recovery','recovery_retimed') for option in (0,1)]))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
