{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"sed -n '122,230p' tools/eval/gowin.py && rg -n 'timing\\\\b' Makefile tools/eval/gowin.py && sed -n '1,145p' fpga/core_bench_si.sv\"", "aggregated_output": "        \"bsram\": _cells(r, \"BSRAM\") or 0,\n        \"dsp\": _cells(r, \"DSP\") or 0,\n        \"critical_paths\": critical_paths(t),\n    }\n\n\ndef _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n    \"\"\"Run the build; True if it hit BUILD_TIMEOUT_SEC (its process group is\n    killed).\"\"\"\n    import subprocess\n    with log.open(\"w\") as f:\n        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n                                stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,\n                                env=env, start_new_session=True)\n        try:\n            proc.wait(timeout=BUILD_TIMEOUT_SEC)\n            return False\n        except subprocess.TimeoutExpired:\n            try:\n                os.killpg(proc.pid, 9)\n            except ProcessLookupError:\n                pass\n            proc.wait()\n            return True\n\n\ndef build(worktree: str | Path, rtl_dir: str | Path, bench_sv: str,\n                place_option: int, outdir: str | Path, env: dict | None = None) -> dict:\n    worktree, rtl_dir, outdir = Path(worktree).resolve(), Path(rtl_dir).resolve(), Path(outdir).resolve()\n    remove_path(outdir)\n    outdir.mkdir(parents=True)\n    (outdir / \"build.tcl\").write_text(project_tcl(worktree, rtl_dir, bench_sv, place_option))\n    log = outdir / \"gw.log\"\n    # Plain threads and blocking waits, no asyncio: agents run `make timing`\n    # inside sandboxes that block socket sends (Codex's network filter), and\n    # asyncio wakes its event loop through a socket, so it hung there.\n    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n    if timed_out:\n        return {\"place_option\": place_option, \"placement_failed\": True,\n                \"fmax_mhz\": None, \"timed_out\": True,\n                \"reason\": f\"Gowin build timeout after {BUILD_TIMEOUT_SEC}s\"}\n    res = parse_reports(outdir)\n    if res[\"placement_failed\"]:\n        errs = [l for l in log.read_text(errors=\"replace\").splitlines() if \"ERROR\" in l]\n        res[\"reason\"] = res.get(\"reason\") or (\"; \".join(errs[\n…[7482 of 10554 chars elided by tools/bench/transcript.py; sha256:162287f934ad16ad]…\nde_0     (rvfi_mode_0),\n    .io_rvfi_ixl_0      (rvfi_ixl_0),\n    .io_rvfi_rs1_addr_0 (rvfi_rs1_addr_0),\n    .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata_0),\n    .io_rvfi_rs2_addr_0 (rvfi_rs2_addr_0),\n    .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata_0),\n    .io_rvfi_rd_addr_0  (rvfi_rd_addr_0),\n    .io_rvfi_rd_wdata_0 (rvfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // V2: observe only the memory-side outputs. Everything the core computes\n  // reaches the fetch address or a store, so the datapath stays in the\n  // netlist; logic that only drives RVFI (a verification port a deployed\n  // core would not have) is pruned and does not count toward Fmax or area.\n  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cat >\"$TMPDIR/hyp_profile/queue_proto.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport shutil\n\nsrc = Path('cores/bench/rtl')\nscratch = Path(os.environ['TMPDIR']) / 'hyp_profile'\nfor key in ('bypass', 'head', 'head_bypass'):\n    dst = scratch / key / 'rtl'\n    shutil.copytree(src, dst, dirs_exist_ok=True)\n    p = (dst / 'if_stage.sv')\n    s = p.read_text()\n    has_head = key \"'!= '\"'bypass'\n    has_bypass = key \"'!= '\"'head'\n    if has_head:\n        s=s.replace(\\\"localparam logic [QUEUE_DEPTH-1:0] FIRST_SLOT = 5'b00001;\\\", \\\"\\\"\\\"localparam int TAIL_DEPTH = QUEUE_DEPTH - 1;\n  localparam logic [TAIL_DEPTH-1:0] FIRST_SLOT = 4'b0001;\\\"\\\"\\\")\n        s=s.replace(\\\"  logic [SLOT_WIDTH-1:0] slots_q [0:QUEUE_DEPTH-1];\\\\n  fetch_slot_t bus_word, produced, buffered_head, head;\\\\n  logic [QUEUE_DEPTH-1:0] read_ptr_q, write_ptr_q, occupancy_q;\\\\n  logic [QUEUE_DEPTH-1:0] read_ptr, write_ptr, occupancy;\\\", \\\"\\\"\\\"  logic [SLOT_WIDTH-1:0] slots_q [0:TAIL_DEPTH-1];\n  fetch_slot_t bus_word, produced, buffered_head, buffered_tail, head;\n  logic [TAIL_DEPTH-1:0] read_ptr_q, write_ptr_q, read_ptr, write_ptr;\n  logic [QUEUE_DEPTH-1:0] occupancy_q, occupancy;\n  logic pop_tail, push_tail, fill_head;\\\"\\\"\\\")\n        s=s.replace(\\\"\\\"\\\"    buffered_head = '0;\n    for (int slot = 0; slot < QUEUE_DEPTH; slot++) begin\n      buffered_head = buffered_head | ({SLOT_WIDTH{read_ptr_q[slot]}} & slots_q[slot]);\n    end\\\"\\\"\\\",\\\"\\\"\\\"    buffered_tail = '0;\n    for (int slot = 0; slot < TAIL_DEPTH; slot++) begin\n      buffered_tail = buffered_tail | ({SLOT_WIDTH{read_ptr_q[slot]}} & slots_q[slot]);\n    end\\\"\\\"\\\")\n        lo=s.index('  for (genvar slot = 0; slot < QUEUE_DEPTH; slot++)')\n        hi=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      read_ptr_q',lo)\n        s=s[:lo]+\\\"\\\"\\\"  assign pop_tail = pop && occupancy[1];\n  assign fill_head = enqueue && (empty || (pop && \"'!occupancy[1]));\n  assign push_tail = enqueue && !fill_head;\n\n  always_ff @(posedge clock) begin\n    if (pop_tail) buffered_head <= buffered_tail;\n    else if (fill_head) buffered_head <= produced;\n  end\n\n  for (genvar slot = 0; slot < TAIL_DEPTH; slot++) begin : gen_slot\n    always_ff @(posedge clock) begin\n      if (push_tail && write_ptr[slot]) slots_q[slot] <= produced;\n    end\n  end\n\n\"\"\"+s[hi:]\n        s=s.replace(\"pop     ? {read_ptr[QUEUE_DEPTH-2:0]\", \"pop_tail  ? {read_ptr[TAIL_DEPTH-2:0]\").replace(\"read_ptr[QUEUE_DEPTH-1]}\", \"read_ptr[TAIL_DEPTH-1]}\").replace(\"enqueue ? {write_ptr[QUEUE_DEPTH-2:0]\", \"push_tail ? {write_ptr[TAIL_DEPTH-2:0]\").replace(\"write_ptr[QUEUE_DEPTH-1]}\", \"write_ptr[TAIL_DEPTH-1]}\")\n    if has_bypass:\n        s = s.replace('\"'assign head = empty ? bus_word : buffered_head;', '''assign head.word_pc = empty ? bus_word.word_pc : buffered_head.word_pc;\n  assign head.last_mapped_word = empty ? bus_word.last_mapped_word : buffered_head.last_mapped_word;\n  assign head.instr = ({32{\"'!empty}} & buffered_head.instr)\n                    | ({32{empty && bus_valid}} & bus_word.instr)\n                    | ({32{empty && !bus_valid}} & replay_prediction.instr);\n  assign head.predicted_taken = (!empty && buffered_head.predicted_taken)\n                             || (empty && bus_valid && bus_word.predicted_taken)\n                             || (empty && !bus_valid && replay_prediction.taken);'\"''')\n        s = s.replace('\"'!empty || bus_valid;'\"', '\"'!empty || bus_valid || accept_replay;'\"')\n        s = s.replace('accept_replay || (accept_bus && (\"'!empty || issue_hold));'\"', '(accept_replay || accept_bus) && (\"'!empty || issue_hold);'\"')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/hyp_profile/queue_proto.py\"\ncat >\"$TMPDIR/hyp_profile/build_variant.sh\" <<'\"'SH'\nset -euo pipefail\nvariant_path=\\\"\"'$TMPDIR/hyp_profile/$1\"\nrtl_path=\"$variant_path/rtl\"\nverilator --cc --exe --build -j 3 -Mdir \"$variant_path/obj\" \"+incdir+$rtl_path\" --top-module core -Wno-fatal -CFLAGS -DNRET=1 \"$rtl_path/core_pkg.sv\" $(rg --files \"$rtl_path\" -g '\"'*.sv' -g '\"'!core_pkg.sv'\"' | sort) \\\"\"'$PWD/test/cosim/main.cpp\" -o cosim_sim >\"$variant_path/build.log\" 2>&1\n\"$variant_path/obj/cosim_sim\" \"$TMPDIR/hyp_profile/coremark.elf\" 5000000 --bench --istall --dstall >\"$variant_path/bench.jsonl\"\npython - \"$variant_path/bench.jsonl\" <<'\"'PY'\nimport json,sys\nfrom tools.eval.fpga import validate_coremark_uart\nd=json.loads(open(sys.argv[1]).read().splitlines()[-1])\nassert d['ebreak'] and not d['oob'] and d['bench_bracketed']\nassert validate_coremark_uart(d['uart'],10)[0]\nprint(sys.argv[1],d['bench_stop_cycle']-d['bench_start_cycle'])\nPY\nSH\nfor variant in bypass head head_bypass; do\n  bash \\\"\"'$TMPDIR/hyp_profile/build_variant.sh\" \"$variant\" &\ndone\nwait'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c 'cat >\"$TMPDIR/hyp_profile/timing.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nfrom concurrent.futures import ThreadPoolExecutor\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nvariants = sys.argv[2:] or ['head_bypass']\nwith ThreadPoolExecutor(max_workers=6) as pool:\n    jobs = []\n    for v in variants:\n        for p in range(3):\n            jobs.append((v, pool.submit(build, root, scratch / v / 'rtl',\n                        'fpga/core_bench_si.sv', p, scratch / v / f'gowin_p{p}')))\n    done = {}\n    for v, job in jobs:\n        l = done.setdefault(v, [])\n        r = job.result()\n        print(v, r if r['placement_failed'] else {k:r[k] for k in ('fmax_mhz','logic','regs','place_option')},flush=True)\n        l.append(r)\n    for v, r in done.items():\n        print(v, summarize(r),flush=True)\nPY\nPYTHONPATH=. python \\\"\"'$TMPDIR/hyp_profile/timing.py\" \"$TMPDIR/hyp_profile\" head_bypass bypass'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
