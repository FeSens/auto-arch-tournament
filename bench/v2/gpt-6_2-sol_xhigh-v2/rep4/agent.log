{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,280p' cores/bench/test/test_div_unit.py; sed -n '1,360p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"RV32M arithmetic, latency and handshake tests for the clocked divider.\"\"\"\nfrom __future__ import annotations\n\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.ready.value == 1 and dut.done.value == 0\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await _tick(dut)\n    dut.start.value = 0\n    assert dut.ready.value == 0 and dut.done.value == 0\n\n\nasync def _check(dut, op, a, b, expected, hold_cycles=0):\n    await _start(dut, op, a, b)\n\n    # Change every input after launch, including requesting another operation\n    # during the calculation and while a result is waiting for consumption.\n    dut.op.value = ALU_DIVU if op != ALU_DIVU else ALU_REM\n    dut.a.value = (a ^ MASK32) & MASK32\n    dut.b.value = (b ^ MASK32) & MASK32\n    dut.start.value = 1\n    for cycle in range(1, 8):\n        await _tick(dut)\n        assert dut.ready.value == 0\n        assert dut.done.value == (cycle == 7), f\"unexpected done on iteration cycle {cycle}\"\n\n    expected &= MASK32\n    for cycle in range(hold_cycles + 1):\n        if cycle:\n            await _tick(dut)\n        assert dut.ready.value == 0 and dut.done.value == 1\n        actual = int(dut.result.value)\n        assert actual == expected, (\n            f\"op={op} a={a & MASK32:#010x} b={b & MASK32:#010x} \"\n            f\"expected={expected:#010x} got={actual:#010x}\"\n        )\n\n    dut.start.value = 0\n    dut.consume.value = 1\n    await _tick(dut)\n    dut.consume.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\ndef _reference(o\n…[17479 of 20551 chars elided by tools/bench/transcript.py; sha256:d332fceb9462b2d1]…\nt fetches[:6] == [(0, True), (8, True), (12, True), (16, True), (20, False), (24, True)]\n    assert [r[\"pc\"] for r in rets] == [0, 8, 16, 24, 28]\n    assert rets[-2][\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"A cold JAL sends the first accepted fetch directly to its target.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_requests=fetches)\n    assert fetches[:3] == [(0, True), (8, True), (12, True)]\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n    assert rj[\"pc_next\"] == 8 and r3[\"cycle\"] == rj[\"cycle\"] + 1\n\n\n", "exit_code": 0, "status": "completed"}}
