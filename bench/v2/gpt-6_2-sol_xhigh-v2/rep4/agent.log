{"type": "item.completed", "item": {"id": "item_66", "type": "command_execution", "command": "/bin/bash -c \"sed -n '235,395p' cores/bench/test/test_pipeline.py && ls -l \\\"\"'$TMPDIR/predictor-profile/formal_scratch/output.log\" && tail -5 \"$TMPDIR/predictor-profile/formal_scratch/output.log\"'", "aggregated_output": "    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def unready_fetch_cannot_issue(dut):\n    program = [ADDI(reg, reg - 1, 1) for reg in range(1, 6)] + [EBREAK()]\n    requests = []\n    rets, _ = await _run(dut, program, store_requests=requests, unready_fetches={\n        (4, 1): SW(1, 0, 0x40),\n        (8, 1): JAL(5, 0x40),\n        (12, 1): LW(3, 0, 0x40),  # The ready fetch uses x3.\n        (16, 1): MULH(5, 1, 2),\n    })\n\n    assert requests == []\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert [r[\"rd_wdata\"] for r in rets[:-1]] == [1, 2, 3, 4, 5]\n    cycles = [r[\"cycle\"] for r in rets]\n    assert [b - a for a, b in zip(cycles, cycles[1:])] == [2, 2, 2, 2, 1]\n\n\n@cocotb.test()\nasync def redirect_squashes_raw_fetch_and_overrides_hold(dut):\n    program = [\n        JAL(0, 8),\n        SW(0, 0, 0x40),\n        BEQ(0, 0, 8),\n      \n…[4224 of 7296 chars elided by tools/bench/transcript.py; sha256:a2610904c527922f]…\nC // 4])\n    assert unaligned_branch[\"pc_next\"] == 0x2000\n    # First prediction uses the old 10, even while 01 is being written.\n    # First training uses 01, so the second visit's untaken outcome brings\n    # 10 back to 01, and the third visit predicts sequential.\n    assert [fetches[i + 1][0] for i, (addr, _) in enumerate(fetches) if addr == 0x2000] == [\n        0x2020, 0x2020, 0x2004,\n    ]\n    assert [r[\"pc_next\"] for r in rets if r[\"pc\"] == 0x2000] == [0x2020, 0x2004, 0x2004]\n\n\n@cocotb.test()\n-rw-rw----+ 1 hwebench hwebench 181989 Nov 21 15:54 /srv/hwebench/tmp/58928045/a45509e9/predictor-profile/formal_scratch/output.log\nSBY 15:54:01 [causal_ch0] summary: engine_0 did not produce any traces\nSBY 15:54:01 [causal_ch0] DONE (ERROR, rc=16)\n\nFull run log: /srv/hwebench/tmp/58928045/a45509e9/predictor-profile/formal_scratch/formal/last_run-wseJLEy2i.log\nPer-check logs in: /srv/hwebench/tmp/58928045/a45509e9/predictor-profile/formal_scratch/formal/riscv-formal/cores/bench-wseJLEy2i/checks/<check>/logfile.txt\n", "exit_code": 0, "status": "completed"}}
