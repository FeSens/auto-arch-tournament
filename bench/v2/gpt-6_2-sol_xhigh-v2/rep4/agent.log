{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom shutil import copytree, copy2\nimport tempfile\nrepo = Path.cwd()\nsource = Path('/srv/hwebench/tmp/58928045/727b862e/bench-divider.ppTzjH')\nscratch = Path(tempfile.mkdtemp(prefix='bench-ex-retime.', dir=source.parent))\nfor item in ('bench', 'fpga', 'test', 'cores/bench/rtl', 'cores/bench/test'):\n    copytree(repo / item, scratch / item)\nfor item in ('Makefile', 'cores/bench/core.yaml'):\n    copy2(repo / item, scratch / item)\nroot = scratch / 'cores/bench/rtl'\n\ndef edit(file, *edits):\n    path = root / file\n    text = path.read_text()\n    for old, new in edits:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nedit('core_pkg.sv',\n     ('    ctrl_t       ctrl;\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;',\n      '    logic [3:0]  bypass_hits;\\\\n    ctrl_t       ctrl;\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;'),\n     ('    logic [31:0] alu_result;\\\\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)',\n      '    logic [31:0] write_value;'))\nedit('id_stage.sv',\n     ('  input  logic [31:0]       rs2_data,','''  input  logic [31:0]       rs2_data,\n  input  logic [4:0]        ex_rd,\n  input  logic [4:0]        mem_rd,'''),\n     ('      reg_q.ctrl     <= ctrl_decoded;', '''      reg_q.bypass_hits <= {\n        mem_rd \"'!= 0 && mem_rd == rs2_addr, ex_rd != 0 && ex_rd == rs2_addr,\n        mem_rd != 0 && mem_rd == rs1_addr, ex_rd != 0 && ex_rd == rs1_addr};\n      reg_q.ctrl     <= ctrl_decoded;'\"'''))\nedit('core.sv',\n     ('  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', '  logic [2:0] fwd_rs1_sel, fwd_rs2_sel;'),\n     ('    .rs2_data (rs2_data_w),\\\\n    .out', '    .rs2_data (rs2_data_w),\\\\n    .ex_rd    (id_ex_w.rd),\\\\n    .mem_rd   (ex_mem_w.rd),\\\\n    .out'),\n     ('''    .id_ex_rs1   (id_ex_w.rs1_addr),\n    .id_ex_rs2   (id_ex_w.rs2_addr),\n    .ex_mem_rd   (ex_mem_w.rd),\n    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\n    .mem_wb_rd   (mem_wb_w.rd),''',\n      '''    .hits        (id_ex_w.bypass_hits),\n    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),'''))\n(root / 'forward_unit.sv').write_text('''// Select one of the two older writers or the captured register-file read.\nmodule forward_unit (\n  input  logic [3:0] hits,\n  input  logic       ex_mem_w_en,\n  input  logic       mem_wb_w_en,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  function automatic logic [2:0] choose (\n    input logic [1:0] matches,\n    input logic       young_writes,\n    input logic       old_writes\n  );\n    logic young, old;\n    young = matches[0] && young_writes;\n    old = matches[1] && old_writes;\n    choose = {\"'!young && !old, !young && old, young};\n  endfunction\n\n  assign fwd_rs1 = choose(hits[1:0], ex_mem_w_en, mem_wb_w_en);\n  assign fwd_rs2 = choose(hits[3:2], ex_mem_w_en, mem_wb_w_en);\n\nendmodule\n'\"''')\nedit('ex_stage.sv',\n     ('  input  logic [1:0]         fwd_rs1_sel,\\\\n  input  logic [1:0]         fwd_rs2_sel,',\n      '  input  logic [2:0]         fwd_rs1_sel,\\\\n  input  logic [2:0]         fwd_rs2_sel,'),\n     ('''  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end''',\n      '''  assign rs1 = ({32{fwd_rs1_sel[0]}} & fwd_ex_mem)\n             | ({32{fwd_rs1_sel[1]}} & fwd_mem_wb)\n             | ({32{fwd_rs1_sel[2]}} & in.rs1_val);\n  assign rs2 = ({32{fwd_rs2_sel[0]}} & fwd_ex_mem)\n             | ({32{fwd_rs2_sel[1]}} & fwd_mem_wb)\n             | ({32{fwd_rs2_sel[2]}} & in.rs2_val);'''),\n     ('''  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end''',\n      '''  assign alu_a = ({32{in.ctrl.is_auipc}} & in.pc)\n               | ({32{\"'!in.ctrl.is_auipc && fwd_rs1_sel[0]}} & fwd_ex_mem)\n               | ({32{!in.ctrl.is_auipc && fwd_rs1_sel[1]}} & fwd_mem_wb)\n               | ({32{!in.ctrl.is_auipc && fwd_rs1_sel[2]}} & in.rs1_val);\n  assign alu_b = ({32{in.ctrl.alu_src}} & in.imm)\n               | ({32{!in.ctrl.alu_src && fwd_rs2_sel[0]}} & fwd_ex_mem)\n               | ({32{!in.ctrl.alu_src && fwd_rs2_sel[1]}} & fwd_mem_wb)\n               | ({32{!in.ctrl.alu_src && fwd_rs2_sel[2]}} & in.rs2_val);'\"'''))\nedit('mem_stage.sv',\n     ('      reg_q.alu_result <= in.alu_result;\\\\n      reg_q.read_data  <= load_data;',\n      '      reg_q.write_value <= in.ctrl.mem_to_reg ? load_data : in.alu_result;'))\nedit('wb_stage.sv',\n     ('    w_data = in.ctrl.mem_to_reg ? in.read_data : in.alu_result;', '    w_data = in.write_value;'))\nprint(scratch)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
