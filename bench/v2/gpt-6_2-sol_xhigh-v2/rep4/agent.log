t +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load\n…[6103 of 9175 chars elided by tools/bench/transcript.py; sha256:e62b21fa96065e25]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/recovery-research/refine.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nroot=Path(os.environ['TMPDIR'])/'recovery-research'\n\ndef new(name, base='split'):\n    global variant\n    variant=root/name\n    shutil.copytree(root/base,variant,dirs_exist_ok=True)\n\ndef replace(file, old, new):\n    p=variant/file\n    s=p.read_text()\n    assert s.count(old)==1,(file,old)\n    p.write_text(s.replace(old,new))\n\ndef comparator():\n    p=variant/'ex_stage.sv'\n    s=p.read_text()\n    start=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n    end=s.index('\\\\n  assign branch_taken',start)\n    s=s[:start]+'''  logic [3:0] compare_less, compare_equal;\n  logic less_unsigned, less_signed;\n  for (genvar group_index = 0; group_index < 4; group_index++) begin : gen_compare\n    assign compare_less[group_index] =\n      rs1[group_index*8 +: 8] < rs2[group_index*8 +: 8];\n    assign compare_equal[group_index] =\n      rs1[group_index*8 +: 8] == rs2[group_index*8 +: 8];\n  end\n  assign less_unsigned = compare_less[3]\n                       | (compare_equal[3] & compare_less[2])\n                       | (compare_equal[3] & compare_equal[2] & compare_less[1])\n                       | (compare_equal[3] & compare_equal[2] & compare_equal[1] & compare_less[0]);\n  assign less_signed = less_unsigned \"'^ rs1[31] ''^ rs2[31];\n  assign branch_cond = (in.ctrl.branch_op[2]\n                       ? (in.ctrl.branch_op[1] ? less_unsigned : less_signed)\n                       : (&compare_equal)) ''^ in.ctrl.branch_op[0];\n'\"''' +s[end:]\n    p.write_text(s)\n    replace('ex_stage.sv','  assign recover_taken_pc = advance &&','  assign recover_taken_pc = recovery_advance &&')\n    replace('ex_stage.sv','  assign recover_sequential_pc = advance &&','  assign recover_sequential_pc = recovery_advance &&')\n    replace('ex_stage.sv','  logic        recover_taken_pc, recover_sequential_pc;','''  logic        recover_taken_pc, recover_sequential_pc, recovery_advance;\n  // Branch and jump operations are always single-cycle.\n  assign recovery_advance = in.valid && \"'!stall && !reset\n                         && (in.ctrl.is_jump || in.ctrl.is_branch || !arithmetic_wait);'\"''')\n\ndef preflags():\n    replace('if_stage.sv','  input  logic [31:0]       ex_sequential_pc,','''  input  logic [31:0]       ex_sequential_pc,\n  input  logic              ex_sequential_in_window,\n  input  logic              ex_sequential_last_word,''')\n    replace('if_stage.sv','ex_sequential_pc[31:20] == 12\\\\'b0','ex_sequential_in_window')\n    replace('if_stage.sv','ex_sequential_pc == LAST_MAPPED_PC','ex_sequential_last_word')\n    replace('ex_stage.sv','  output logic [31:0]        sequential_pc,','''  output logic [31:0]        sequential_pc,\n  output logic               sequential_in_window,\n  output logic               sequential_last_word,''')\n    replace('ex_stage.sv','  assign sequential_pc  = in.pc + 32\\\\'d4;','''  assign sequential_pc  = in.pc + 32'd4;\n  assign sequential_in_window = (in.pc[31:20] == 12'b0 && in.pc[19:2] \"'!= 18'\"'h3ffff)\n                             || in.pc[31:2] == 30'h3fffffff;\n  assign sequential_last_word = in.pc[31:2] == 30'h0003fffe;''')\n    replace('core.sv','  logic [31:0] ex_sequential_pc, ex_direct_target;','''  logic [31:0] ex_sequential_pc, ex_direct_target;\n  logic        ex_sequential_in_window, ex_sequential_last_word;''')\n    replace('core.sv','    .ex_sequential_pc  (ex_sequential_pc),','''    .ex_sequential_pc        (ex_sequential_pc),\n    .ex_sequential_in_window (ex_sequential_in_window),\n    .ex_sequential_last_word (ex_sequential_last_word),''')\n    replace('core.sv','    .sequential_pc   (ex_sequential_pc),','''    .sequential_pc        (ex_sequential_pc),\n    .sequential_in_window (ex_sequential_in_window),\n    .sequential_last_word (ex_sequential_last_word),''')\n\ndef predecode():\n    replace('core_pkg.sv','    logic [31:0] alu_a_base;', '    logic [10:0] alu_select;\\\\n    logic [31:0] alu_a_base;')\n    replace('id_stage.sv','  // ── ID/EX register','''  logic [10:0] alu_select;\n  for (genvar op_index = 0; op_index < 11; op_index++) begin : gen_select\n    assign alu_select[op_index] = \"'!dec_is_jump && dec_alu_op == 5'\"'(op_index);\n  end\n\n  // ── ID/EX register''')\n    replace('id_stage.sv','      reg_q.alu_a_sel  <=', '      reg_q.alu_select <= alu_select;\\\\n      reg_q.alu_a_sel  <=')\n    replace('ex_stage.sv','  alu u_alu (\\\\n    .op      (in.ctrl.alu_op),','  alu_datapath u_alu (\\\\n    .select_op (in.alu_select),')\n    replace('ex_stage.sv','  logic use_alu_result;\\\\n','')\n    replace('ex_stage.sv','  // The low multiply reaches its EX/MEM register through the final mux.\\\\n  // Decode makes the remaining result sources mutually exclusive.\\\\n  assign use_alu_result = \"'!(in.ctrl.is_jump || mul_high_instr || div_instr);'\"\\\\n\\\\n','')\n    replace('ex_stage.sv','''      reg_q.alu_result    <= mul_low_instr ? mul_low_result\n                           : (({32{in.ctrl.is_jump}} & sequential_pc)\n                           |  ({32{mul_high_instr}}  & mul_high_result)\n                           |  ({32{div_instr}}       & div_result)\n                           |  ({32{use_alu_result}}  & alu_result));''','''      reg_q.alu_result    <= alu_result\n                           | ({32{mul_low_instr}}     & mul_low_result)\n                           | ({32{in.ctrl.is_jump}}   & sequential_pc)\n                           | ({32{mul_high_instr}}    & mul_high_result)\n                           | ({32{div_instr}}         & div_result);''')\n    (variant/'alu.sv').write_text('''module alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a, b,\n  output logic [31:0] out, add_sum\n);\n  logic [10:0] select_op;\n  for (genvar op_index = 0; op_index < 11; op_index++) begin : gen_decode\n    assign select_op[op_index] = op == 5'(op_index);\n  end\n  alu_datapath u_datapath (.*);\nendmodule\n\n/* verilator lint_off DECLFILENAME */\nmodule alu_datapath (\n  input  logic [10:0] select_op,\n  input  logic [31:0] a, b,\n  output logic [31:0] out, add_sum\n);\n  assign add_sum = a + b;\n  logic [31:0] sub, left, right;\n  logic [32:0] shift_input;\n  logic eq_sign, unsigned_less;\n  assign sub = a - b;\n  assign unsigned_less = a < b;\n  assign eq_sign = a[31] \"'^ b[31];\n  assign left = a << b[4:0];\n  assign shift_input = {select_op[ALU_SRA] & a[31], a};\n  assign right = 32'\"'(\"'$signed(shift_input) >>> b[4:0]);\n  assign out = ({32{select_op[ALU_ADD]}}  & add_sum)\n             | ({32{select_op[ALU_SUB]}}  & sub)\n             | ({32{select_op[ALU_AND]}}  & (a & b))\n             | ({32{select_op[ALU_OR]}}   & (a | b))\n             | ({32{select_op[ALU_XOR]}}  & (a ''^ b))\n             | {31'\"'b0, select_op[ALU_SLT] & (unsigned_less \"'^ eq_sign)}\n             | {31'\"'b0, select_op[ALU_SLTU] & unsigned_less}\n             | ({32{select_op[ALU_SLL]}}  & left)\n             | ({32{select_op[ALU_SRL] | select_op[ALU_SRA]}} & right)\n             | ({32{select_op[ALU_LUI]}}  & b);\nendmodule\n/* verilator lint_on DECLFILENAME */\n''')\n    # Restrict packed-vector indexing to the select bus width in lint.\n    p=variant/'alu.sv'\n    import re\n    p.write_text(re.sub(r'select_op\\\\[(ALU_\\\\w+)\\\\]',r'select_op[4\\\\'(\\\\1)]',p.read_text()))\n\nnew('compare')\ncomparator()\npreflags()\nnew('decode')\npredecode()\nnew('both','compare')\npredecode()\nPY\npython \\\"\"'$TMPDIR/recovery-research/refine.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" compare:1 decode:1 both:1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
