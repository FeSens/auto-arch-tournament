{"type": "item.started", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/recovery-research/defer.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])/'recovery-research'\n\ndef replace(file,old,new):\n    p=variant/file\n    s=p.read_text()\n    assert s.count(old)==1,(file,old)\n    p.write_text(s.replace(old,new))\n\ndef defer():\n    replace('core_pkg.sv','    logic [11:0] addr_offset;', '''    logic [11:0] addr_offset;\n    logic        deferred_branch;''')\n    replace('core_pkg.sv','    logic        is_divide;', '''    logic        is_divide;\n    logic        deferred_branch;\n    logic        branch_equal;\n    logic        branch_prediction;\n    logic        branch_boundary;\n    logic [5:0]  branch_index;\n    logic [31:0] branch_target;\n    logic        branch_negative;''')\n    replace('id_stage.sv','  input  logic              flush,','''  input  logic              flush,\n  input  logic              deferred_branch,''')\n    replace('id_stage.sv','      reg_q.addr_offset <= imm[11:0];','''      reg_q.addr_offset <= imm[11:0];\n      reg_q.deferred_branch <= deferred_branch;''')\n    replace('core.sv','  logic       fast_branch_head;', '''  logic       fast_branch_head, deferred_branch_head, branch_train_hazard;\n  logic       ex_redirect, mem_redirect, mem_direct_taken;\n  logic       ex_train_valid, ex_train_taken, ex_train_negative;\n  logic       mem_train_valid, mem_train_taken, mem_train_negative;\n  logic [5:0] ex_train_index, mem_train_index;''')\n    replace('core.sv','  ) u_if (','  ) u_if (') if False else None\n    replace('core.sv','  // ── IF ─', '''  assign deferred_branch_head = fast_branch_head && id_ex_w.valid && id_ex_w.ctrl.mem_read\n                            && id_ex_w.rd \"'!= 5'\"'b0\n                            && (id_ex_w.rd == if_id_w.instr[19:15] || id_ex_w.rd == if_id_w.instr[24:20]);\n  assign branch_train_hazard = id_ex_w.valid && id_ex_w.deferred_branch\n                               && if_id_w.valid && if_id_w.instr[6:0] == 7'h63;\n  assign redirect = ex_redirect || mem_redirect;\n  assign train_valid = mem_train_valid || ex_train_valid;\n  assign train_taken = ex_mem_w.deferred_branch ? mem_train_taken : ex_train_taken;\n  assign train_negative = ex_mem_w.deferred_branch ? mem_train_negative : ex_train_negative;\n  assign train_index = ex_mem_w.deferred_branch ? mem_train_index : ex_train_index;\n\n  // ── IF ─''')\n    replace('core.sv','    .issue_hold      (stall_id || load_use_hazard),', '''    .issue_hold      (stall_id || load_use_hazard || branch_train_hazard),''')\n    replace('core.sv','    .ex_direct_taken (ex_direct_taken),','''    .ex_direct_taken (mem_redirect ? mem_direct_taken : ex_direct_taken),''')\n    replace('core.sv','    .ex_indirect_taken (ex_indirect_taken),','''    .ex_indirect_taken (\"'!mem_redirect && ex_indirect_taken),'\"''')\n    replace('core.sv','    .ex_sequential_pc  (ex_sequential_pc),','''    .ex_sequential_pc  (mem_redirect ? ex_mem_w.pc_next : ex_sequential_pc),''')\n    replace('core.sv','    .ex_direct_target  (ex_direct_target),','''    .ex_direct_target  (mem_redirect ? ex_mem_w.branch_target : ex_direct_target),''')\n    replace('core.sv','    .flush    (load_use_hazard || redirect),','''    .flush    (load_use_hazard || branch_train_hazard || redirect),\n    .deferred_branch (deferred_branch_head),''')\n    replace('core.sv','    .stall           (stall_ex_mem),','''    .stall           (stall_ex_mem),\n    .squash          (mem_redirect),''')\n    replace('core.sv','''    .arithmetic_wait (arithmetic_wait),\n    .redirect        (redirect),''','''    .arithmetic_wait (arithmetic_wait),\n    .redirect        (ex_redirect),''')\n    replace('core.sv','''    .train_valid     (train_valid),\n    .train_index     (train_index),\n    .train_taken     (train_taken),\n    .train_negative  (train_negative)\n  );''','''    .train_valid     (ex_train_valid),\n    .train_index     (ex_train_index),\n    .train_taken     (ex_train_taken),\n    .train_negative  (ex_train_negative)\n  );''')\n    replace('core.sv','    .load_value (mem_load_value),','''    .load_value (mem_load_value),\n    .branch_redirect (mem_redirect),\n    .branch_direct_taken (mem_direct_taken),\n    .train_valid (mem_train_valid),\n    .train_index (mem_train_index),\n    .train_taken (mem_train_taken),\n    .train_negative (mem_train_negative),''')\n    replace('ex_stage.sv','  input  logic               stall,         // freeze EX/MEM register (dmem stall)','''  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               squash,''')\n    replace('ex_stage.sv','  assign mul_start = mul_high_instr && mul_ready && \"'!stall;'\"', '  assign mul_start = mul_high_instr && mul_ready && \"'!stall && !squash;'\"')\n    replace('ex_stage.sv','  assign div_start = div_instr && div_ready && \"'!stall;'\"', '  assign div_start = div_instr && div_ready && \"'!stall && !squash;'\"')\n    replace('ex_stage.sv','''      BR_BEQ:  branch_cond = compare_equal;\n      BR_BNE:  branch_cond = \"'!compare_equal;'\"''','''      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 \"'!= rs2);'\"''')\n    replace('ex_stage.sv','  assign branch_taken   = in.ctrl.is_branch && branch_cond;', '  assign branch_taken   = in.ctrl.is_branch && \"'!in.deferred_branch && branch_cond;'\"')\n    replace('ex_stage.sv','  assign transfer_valid = in.valid && \"'!arithmetic_wait;'\"', '  assign transfer_valid = in.valid && \"'!arithmetic_wait && !squash;'\"')\n    replace('ex_stage.sv','  assign redirect        = advance && (in.last_mapped_word || (in.predicted_taken \"'!= actual_taken));'\"', '  assign redirect        = advance && \"'!in.deferred_branch && (in.last_mapped_word || (in.predicted_taken != actual_taken));'\"')\n    replace('ex_stage.sv','  assign train_valid = advance && in.ctrl.is_branch && \"'!in.ctrl.is_illegal'\"','  assign train_valid = advance && in.ctrl.is_branch && \"'!in.deferred_branch && !in.ctrl.is_illegal'\"')\n    replace('ex_stage.sv','      reg_q.is_divide     <= div_instr;', '''      reg_q.is_divide     <= div_instr;\n      reg_q.deferred_branch <= in.deferred_branch && transfer_valid;\n      reg_q.branch_equal    <= compare_equal;\n      reg_q.branch_prediction <= in.predicted_taken;\n      reg_q.branch_boundary   <= in.last_mapped_word;\n      reg_q.branch_index      <= in.direction_index;\n      reg_q.branch_target     <= direct_target;\n      reg_q.branch_negative   <= in.direct_offset[20];''')\n    replace('mem_stage.sv','  output logic [31:0]        load_value,','''  output logic [31:0]        load_value,\n  output logic               branch_redirect,\n  output logic               branch_direct_taken,\n  output logic               train_valid,\n  output logic [5:0]         train_index,\n  output logic               train_taken,\n  output logic               train_negative,''')\n    replace('mem_stage.sv','  logic retire_divide;', '''  logic retire_divide;\n  logic deferred_trap;\n  assign train_taken = in.branch_equal \"'^ in.ctrl.branch_op[0];\n  assign deferred_trap = in.deferred_branch && train_taken && in.branch_target[1];\n  assign branch_direct_taken = train_taken && !in.branch_target[1];\n  assign branch_redirect = in.valid && in.deferred_branch\n                         && (in.branch_boundary || in.branch_prediction != branch_direct_taken);\n  assign train_valid = in.valid && in.deferred_branch && !deferred_trap;\n  assign train_index = in.branch_index;\n  assign train_negative = in.branch_negative;'\"''')\n    replace('mem_stage.sv','    next_wb.pc_next     = in.pc_next;', '    next_wb.pc_next     = in.deferred_branch && branch_direct_taken ? in.branch_target : in.pc_next;')\n    replace('mem_stage.sv','    next_wb.trap        = in.ctrl.is_illegal || mem_misalign;', '    next_wb.trap        = in.ctrl.is_illegal || mem_misalign || deferred_trap;')\n\nfor name,base in (('defer','bypass'),('defermux','bypassmux'),('deferzero','bypasszero')):\n    variant=root/name\n    shutil.copytree(root/base,variant,dirs_exist_ok=True)\n    defer()\nPY\npython \\\"\"'$TMPDIR/recovery-research/defer.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" defer:1 defermux:1 deferzero:1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
