{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"sed -n '335,402p' cores/bench/rtl/if_stage.sv && rg -n 'clock|duration' formal/checks_si.cfg | head\"","aggregated_output":"  // Any pointer or count updates on the squash edge are discarded by\n  // registered recovery. Keep the live EX mismatch off those updates.\n  assign pop   = !empty && !issue_hold;\n\n  // A pop from full opens space on the next cycle. Once accepted, the\n  // boundary word parks the request whether it bypasses or gets queued.\n  assign accept_bus = bus_valid && !full;\n  assign accept_replay = (|replay_match) && predicted_in_window_q && !parked_q\n                      && !recovery_pending_q && !full && (!imem_ready || stale_request_q);\n  assign enqueue = accept_replay || (accept_bus && (!empty || issue_hold));\n  assign park = accept_bus && request_last_word;\n\n  for (genvar slot = 0; slot < QUEUE_DEPTH; slot++) begin : gen_slot\n    // The write pointer names an unused slot whenever the queue has\n    // space. Only enqueue publishes its data by advancing the pointer.\n    always_ff @(posedge clock) begin\n      if (!full && write_ptr[slot]) slots_q[slot] <= produced;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      read_ptr_q  <= FIRST_SLOT;\n      write_ptr_q <= FIRST_SLOT;\n      occupancy_q <= '0;\n    end else begin\n      read_ptr_q  <= pop     ? {read_ptr[QUEUE_DEPTH-2:0],  read_ptr[QUEUE_DEPTH-1]}  : read_ptr;\n      write_ptr_q <= enqueue ? {write_ptr[QUEUE_DEPTH-2:0], write_ptr[QUEUE_DEPTH-1]} : write_ptr;\n      case ({enqueue, pop})\n        2'b10:   occupancy_q <= {occupancy[QUEUE_DEPTH-2:0], 1'b1};\n        2'b01:   occupancy_q <= {1'b0, occupancy[QUEUE_DEPTH-1:1]};\n        default: occupancy_q <= occupancy;\n      endcase\n    end\n  end\n\n  // Once replay advances past an unready request, discard its response\n  // even if a later replay step returns the producer to the same PC.\n  always_ff @(posedge clock) begin\n    if (reset || recovery_pending_q || imem_ready) stale_request_q <= 1'b0;\n    else if (accept_replay) stale_request_q <= 1'b1;\n\n    if (!stale_request_q) held_word_q <= predicted_pc_q[19:2];\n  end\n\n  assign step_outside_window = accept_bus && !request_in_window;\n  assign wait_for_recovery_word = recovery_pending_q && !imem_ready;\n  assign retain_request = park || wait_for_recovery_word;\n  assign bus_successor_last_word = predict_direct ? target_last_word : sequential_last_word;\n\n  assign replay_last_word = replay_prediction.taken ? (|replay_target_last)\n                          : predicted_pc_q[19:2] == 18'h3fffe;\n\n  // Capture both low-word successors so the prediction only selects\n  // between registers. Replay uses the same request PC as the bus in\n  // ordinary fetch, even while the external bus holds a stale address.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      predicted_target_word_q      <= '0;\n      predicted_fallthrough_word_q <= '0;\n      select_predicted_target_q    <= 1'b0;\n      predicted_page_q             <= '0;\n      predicted_in_window_q        <= 1'b1;\n      predicted_last_word_q        <= 1'b0;\n    end else if (accept_bus || accept_replay || recovery_pending_q) begin\n      predicted_target_word_q      <= bus_valid ? target_word : replay_prediction.target;\n      predicted_fallthrough_word_q <= retain_request ? request_pc[19:2] : sequential_word;\n      select_predicted_target_q    <= (accept_bus && predict_taken)\n","exit_code":0,"status":"completed"}}
