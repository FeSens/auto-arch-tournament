== (4, 3)\n    assert divide[\"cycle\"] - store[\"cycle\"] == 9\n    assert consumer[\"cycle\"] - divide[\"cycle\"] == 1\n\n\n@cocotb.test()\nasync def multiply_forwarding_and_latency(dut):\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(1, 0, -3),\n        MUL(3, 1, 2),\n        SW(3, 0, 0x40),\n        MULH(4, 3, 2),\n        MULHU(5, 4, 2),\n        ADD(6, 5, 2),\n        EB\n…[5603 of 8675 chars elided by tools/bench/transcript.py; sha256:3fa1531ffa653a88]…\nF, 0x80000000)\n    await _check_high(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def signed_corrections(dut):\n    await _reset(dut)\n    rng = Random(0)\n    for _ in range(64):\n        a = rng.getrandbits(32)\n        b = rng.getrandbits(32)\n        signed_a = a - (1 << 32) if a & (1 << 31) else a\n        signed_b = b - (1 << 32) if b & (1 << 31) else b\n        await _check_low(dut, a, b, a * b)\n        await _check_high(dut, ALU_MULH, a, b, (signed_a * signed_b) >> 32)\n        await _check_high(dut, ALU_MULHSU, a, b, (signed_a * b) >> 32)\n        await _check_high(dut, ALU_MULHU, a, b, (a * b) >> 32)\n\n\n@cocotb.test()\nasync def completion_holds_until_consumed(dut):\n    await _reset(dut)\n    await _check_high(dut, ALU_MULHSU, -1, MASK32, -1, hold_cycles=5)\n    await _check_high(dut, ALU_MULH, -2, -3, 0, hold_cycles=3)\n\n\ndef test_mul_unit_runner():\n    run_cocotb(toplevel=\"mul_unit\",\n               sources=[\"core_pkg.sv\", \"mul_unit.sv\"],\n               test_module=\"test_mul_unit\")\n", "exit_code": 0, "status": "completed"}}
