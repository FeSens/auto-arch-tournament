{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"sed -n '301,720p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert requests == []\n    assert fetches[:6] == [(0, True), (8, True), (12, True), (16, True), (20, False), (24, True)]\n    assert [r[\"pc\"] for r in rets] == [0, 8, 16, 24, 28]\n    assert rets[-2][\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"A cold JAL sends the first accepted fetch directly to its target.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    fetches = []\n    rets, _ = await _run(dut, program, fetch_requests=fetches)\n    assert fetches[:3] == [(0, True), (8, True), (12, True)]\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n    assert rj[\"pc_next\"] == 8 and r3[\"cycle\"] == rj[\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def predicted_loop_exit_waits_for_older_store(dut):\n    loop_branch = BNE(1, 0, -20)\n    program = [\n        ADDI(1, 0, 2),          # 0\n        JAL(0, 24),             # 4: enter loop at its branch\n        ADDI(1, 1, -1),         # 8: predicted loop target\n        BEQ(1, 0, 12),          # 12: issue the store just before loop exit\n        JAL(0, 12),             # 16: back to the branch without the store\n        SW(1, 0, 0x48),         # 20: skipped\n        SW(1, 0, 0x44),         # 24: older store stalls with the branch in EX\n        loop_branch,            # 28\n        ADDI(2, 1, 42),         # 32: loop exit\n        EBREAK(),\n    ]\n    fetches, stores = [], []\n    rets, dmem = await _run(dut, program, fetch_requests=fetches, store_stalls=3,\n                           store_requests=stores, unready_fetches={(8, 6): program[5]})\n\n    assert [r[\"pc\"] for r in rets] == [0, 4, 28, 8, 12, 16, 28, 8, 12, 24, 28, 32, 36]\n    assert [r[\"order\"] for r in rets] \n…[11468 of 14540 chars elided by tools/bench/transcript.py; sha256:abf92bc923328a2e]…\n= await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
