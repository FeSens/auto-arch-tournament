{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/e6a4ebd3/bench-r14s0.it6aVfvF/prepare.py' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path(__file__).parent\nvariant = sys.argv[1]\nwidths = [int(n) for n in sys.argv[2].split(',')]\nstyle = sys.argv[3]\ndest = root / variant / 'rtl'\nshutil.copytree('cores/bench/rtl', dest)\nif variant == 'baseline':\n    sys.exit()\nif sum(widths) \"'!= 32:\n    raise ValueError(widths)\nalu = dest / '\"'alu.sv'\nsrc = alu.read_text()\nsections = []\noffset = 0\nfor group, width in enumerate(widths):\n    hi = offset + width - 1\n    lo = offset\n    lhs = f'x[{hi}:{lo}]'\n    rhs = f'y[{hi}:{lo}]'\n    code = [f'    logic [{width}:0] base{group};']\n    if group:\n        code.append(f'    logic carry{group};')\n    if style == 'select' and group:\n        code.append(f'    logic [{width-1}:0] plus{group};')\n    if group < len(widths) - 1:\n        if group:\n            code.append(f'    logic p{group};')\n        code.append(f'    logic g{group};')\n    sections += code\n    offset += width\nsections.append('')\noffset = 0\nfor group, width in enumerate(widths):\n    hi = offset + width - 1\n    lo = offset\n    lhs = f'x[{hi}:{lo}]'\n    rhs = f'y[{hi}:{lo}]'\n    code = [f\\\"    base{group} = {{1'b0, {lhs}}} + {{1'b0, {rhs}}};\\\"]\n    if group < len(widths) - 1:\n        if group:\n            code.append(f'    p{group} = &({lhs} | {rhs});')\n        code.append(f'    g{group} = base{group}[{width}];')\n    if group:\n        terms = []\n        for prev in range(group-1, -1, -1):\n            terms.append('(' + ' & '.join([f'g{prev}'] + [f'p{k}' for k in range(prev+1, group)]) + ')')\n        if style == 'sub-carry':\n            terms.append('(' + ' & '.join(['cin'] + [f'p{k}' for k in range(group)]) + ')')\n        code.append(f\\\"    carry{group} = \\\" + ' | '.join(terms) + ';')\n    if style == 'select' and group:\n        code.append(f\\\"    plus{group} = {lhs} + {rhs} + {width}'d1;\\\")\n        value = f'carry{group} ? plus{group} : base{group}[{width-1}:0]'\n    elif group:\n        value = f\\\"{lhs} + {rhs} + {{ {width-1}'b0, carry{group} }}\\\"\n    else:\n        value = f'base{group}[{width-1}:0]'\n    code.append(f'    grouped_sum[{hi}:{lo}] = {value};')\n    code.append('')\n    sections += code\n    offset += width\n\nif style == 'sub-carry':\n    raise ValueError(style)\nbody = '  function automatic logic [31:0] grouped_sum(input logic [31:0] x, y);\\\\n' + '\\\\n'.join(sections) + '\\\\n  endfunction\\\\n'\nif sys.argv[4] == 'both':\n    src = src.replace('a - b', \\\"~grouped_sum(~a, b)\\\")\nalu.write_text(src.replace('  assign add_sum = a + b;', body + '\\\\n  assign add_sum = grouped_sum(a, b);'))\nPY\npython '/srv/hwebench/tmp/58928045/e6a4ebd3/bench-r14s0.it6aVfvF/prepare.py' baseline 8,8,8,8 select keep\npython '/srv/hwebench/tmp/58928045/e6a4ebd3/bench-r14s0.it6aVfvF/prepare.py' cs8 8,8,8,8 select both\npython '/srv/hwebench/tmp/58928045/e6a4ebd3/bench-r14s0.it6aVfvF/prepare.py' cla8 8,8,8,8 lookahead both\npython '/srv/hwebench/tmp/58928045/e6a4ebd3/bench-r14s0.it6aVfvF/prepare.py' cla6 6,6,6,7,7 lookahead both\ncat > '/srv/hwebench/tmp/58928045/e6a4ebd3/bench-r14s0.it6aVfvF/timing.py' <<'PY'\nimport json\nimport sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build\n\nscratch = Path(__file__).resolve().parent\nvariant = sys.argv[1]\nplacement = int(sys.argv[2])\nprint(json.dumps(build(Path.cwd(), scratch / variant / 'rtl', 'fpga/core_bench_si.sv',\n                 scratch / variant / f'p{placement}')), flush=True)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
