{"type": "item.completed", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,235p' cores/bench/test/test_div_unit.py && sed -n '1,220p' cores/bench/test/test_mul_unit.py\"", "aggregated_output": "\"\"\"RV32M arithmetic, latency and handshake tests for the clocked divider.\"\"\"\nfrom __future__ import annotations\n\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.ready.value == 1 and dut.done.value == 0\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await _tick(dut)\n    dut.start.value = 0\n    assert dut.ready.value == 0 and dut.done.value == 0\n\n\nasync def _check(dut, op, a, b, expected, hold_cycles=0):\n    await _start(dut, op, a, b)\n\n    # Change every input after launch, including requesting another operation\n    # during the calculation and while a result is waiting for consumption.\n    dut.op.value = ALU_DIVU if op != ALU_DIVU else ALU_REM\n    dut.a.value = (a ^ MASK32) & MASK32\n    dut.b.value = (b ^ MASK32) & MASK32\n    dut.start.value = 1\n    for cycle in range(1, 8):\n        await _tick(dut)\n        assert dut.ready.value == 0\n        assert dut.done.value == (cycle == 7), f\"unexpected done on iteration cycle {cycle}\"\n\n    expected &= MASK32\n    for cycle in range(hold_cycles + 1):\n        if cycle:\n            await _tick(dut)\n        assert dut.ready.value == 0 and dut.done.value == 1\n        actual = int(dut.result.value)\n        assert actual == expected, (\n            f\"op={op} a={a & MASK32:#010x} b={b & MASK32:#010x} \"\n            f\"expected={expected:#010x} got={actual:#010x}\"\n        )\n\n    dut.start.value = 0\n    dut.consume.value = 1\n    await _tick(dut)\n    dut.consume.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\n@cocotb.test()\na\n…[5472 of 8544 chars elided by tools/bench/transcript.py; sha256:afb2ff50d471bfe7]…\nF, 0x80000000)\n    await _check_high(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def signed_corrections(dut):\n    await _reset(dut)\n    rng = Random(0)\n    for _ in range(64):\n        a = rng.getrandbits(32)\n        b = rng.getrandbits(32)\n        signed_a = a - (1 << 32) if a & (1 << 31) else a\n        signed_b = b - (1 << 32) if b & (1 << 31) else b\n        await _check_low(dut, a, b, a * b)\n        await _check_high(dut, ALU_MULH, a, b, (signed_a * signed_b) >> 32)\n        await _check_high(dut, ALU_MULHSU, a, b, (signed_a * b) >> 32)\n        await _check_high(dut, ALU_MULHU, a, b, (a * b) >> 32)\n\n\n@cocotb.test()\nasync def completion_holds_until_consumed(dut):\n    await _reset(dut)\n    await _check_high(dut, ALU_MULHSU, -1, MASK32, -1, hold_cycles=5)\n    await _check_high(dut, ALU_MULH, -2, -3, 0, hold_cycles=3)\n\n\ndef test_mul_unit_runner():\n    run_cocotb(toplevel=\"mul_unit\",\n               sources=[\"core_pkg.sv\", \"mul_unit.sv\"],\n               test_module=\"test_mul_unit\")\n", "exit_code": 0, "status": "completed"}}
