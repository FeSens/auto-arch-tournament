{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'cat >\"$TMPDIR/hyp_profile/target_proto.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport shutil\nscratch = Path(os.environ['TMPDIR']) / 'hyp_profile'\nfor key, bits, limited, direct, parent in (\n    ('target32', 5, True, False, None),\n    ('target64', 6, True, False, None),\n    ('target32_bypass', 5, True, True, 'head_bypass'),\n    ('cache64', 6, False, False, None),\n):\n    src = scratch / parent / 'rtl' if parent else Path('cores/bench/rtl')\n    dst = scratch / key / 'rtl'\n    shutil.copytree(src, dst, dirs_exist_ok=True)\n    p = dst / 'if_stage.sv'\n    s = p.read_text()\n    at = s.index(\\\"  // Explicit vectors keep\\\")\n    s=s[:at]+f\\\"\\\"\\\"  localparam int L0_INDEX_WIDTH = {bits};\n  localparam int L0_TAG_WIDTH = 18 - L0_INDEX_WIDTH;\n  localparam int L0_DEPTH = 1 << L0_INDEX_WIDTH;\n  typedef struct packed {{\n    logic [L0_TAG_WIDTH-1:0] tag;\n    prediction_t prediction;\n  }} l0_record_t;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *)\n  logic [\"'$bits(l0_record_t)-1:0] l0_ram [0:L0_DEPTH-1];\n  logic [L0_DEPTH-1:0] l0_valid_q;\n  logic [1:0] target_words_left_q;\n  logic [L0_INDEX_WIDTH-1:0] l0_index, l0_fill_index_q;\n  logic l0_hit, l0_fill_q;\n  l0_record_t l0_read, l0_fill_record_q;\n  prediction_t selected_replay;\n\n  assign l0_index = predicted_pc_q[L0_INDEX_WIDTH+1:2];\n  assign l0_read = l0_ram[l0_index];\n  assign l0_hit = l0_valid_q[l0_index]\n                && l0_read.tag == predicted_pc_q[19:L0_INDEX_WIDTH+2];\n  assign selected_replay = (|replay_match) ? replay_prediction : l0_read.prediction;\n\n  always_ff @(posedge clock) begin\n    l0_fill_index_q <= request_pc[L0_INDEX_WIDTH+1:2];\n    l0_fill_record_q <= {{request_pc[19:L0_INDEX_WIDTH+2], imem_data, predict_taken, target_word}};\n    if (reset || fence_i) begin\n      l0_valid_q <= '\"'0;\n      l0_fill_q <= 1'b0;\n    end else begin\n      l0_fill_q <= accept_bus && request_in_window && \"'!request_last_word{('\"' && target_words_left_q \"'!= 0 && !recovery_pending_q'\"' if limited else '')};\n      if (l0_fill_q) l0_valid_q[l0_fill_index_q] <= 1'b1;\n    end\n    if (l0_fill_q) l0_ram[l0_fill_index_q] <= l0_fill_record_q;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || recovery_pending_q) target_words_left_q <= '0;\n    else if (step_bus_taken || (accept_replay && selected_replay.taken))\n      target_words_left_q <= 2'd2;\n    else if ((accept_bus || accept_replay) && target_words_left_q \"'!= 0)\n      target_words_left_q <= target_words_left_q - 2'\"'d1;\n  end\n\n\\\"\\\"\\\"+s[at:]\n    at = s.index(\\\"  // Explicit vectors keep\\\")\n    s=s[:at]+s[at:].replace('replay_prediction.', 'selected_replay.').replace(\\\"(|replay_match) && predicted_in_window_q\\\", \\\"((|replay_match) || l0_hit) && predicted_in_window_q\\\").replace(\\\"&& \"'!parked_q'\"\\\\n                      && \"'!recovery_pending_q\", \"&& !parked_q && !predicted_last_word_q'\"\\\\n                      && \"'!recovery_pending_q\").replace(\"(|replay_target_last)\", \"((|replay_match) ? (|replay_target_last) : (&l0_read.prediction.target))\")\n    p.write_text(s)\nPY\npython \"$TMPDIR/hyp_profile/target_proto.py\"\nfor variant in target32 target64 target32_bypass cache64; do\n  bash \"$TMPDIR/hyp_profile/build_variant.sh\" \"$variant\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
