{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c 'set -e\nwork=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\npython3 - \"$work\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nwork = Path(sys.argv[1])\nfor base in ('fast', 'fast3', 'bram'):\n    rtl = work / f'rtl-loop-{base}ramq'\n    shutil.copytree(work / f'rtl-loop-{base}', rtl)\n    p = rtl / 'if_stage.sv'\n    s = p.read_text()\n    s = '\\\\n'.join(line for line in s.split('\\\\n') if 'FIRST_SLOT =' not in line)\n    s = s.replace('  logic [SLOT_WIDTH-1:0] slots_q [0:QUEUE_DEPTH-1];', '''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [SLOT_WIDTH-1:0] slots_q [0:QUEUE_DEPTH-1];\n  localparam int POINTER_WIDTH = \"'$clog2(QUEUE_DEPTH);\n  localparam logic [POINTER_WIDTH-1:0] LAST_SLOT = POINTER_WIDTH'\"'(QUEUE_DEPTH - 1);''')\n    s = s.replace('logic [QUEUE_DEPTH-1:0] read_ptr_q, write_ptr_q, occupancy_q;', '''logic [POINTER_WIDTH-1:0] read_ptr_q, write_ptr_q;\n  logic [QUEUE_DEPTH-1:0] occupancy_q;''')\n    s = s.replace('logic [QUEUE_DEPTH-1:0] read_ptr, write_ptr, occupancy;', '''logic [POINTER_WIDTH-1:0] read_ptr, write_ptr;\n  logic [QUEUE_DEPTH-1:0] occupancy;''')\n    s = s.replace('FIRST_SLOT', \\\"'0\\\")\n    start = s.index('  always_comb begin\\\\n    buffered_head')\n    end = s.index('  assign head', start)\n    s = s[:start] + '  assign buffered_head = slots_q[read_ptr_q];\\\\n\\\\n' + s[end:]\n    start = s.index('  for (genvar slot')\n    end = s.index('  always_ff @(posedge clock) begin\\\\n    if (reset)', start)\n    s = s[:start] + '''  always_ff @(posedge clock) begin\n    if (write_slot) slots_q[write_ptr] <= produced;\n  end\n\n  function automatic logic [POINTER_WIDTH-1:0] next_slot(input logic [POINTER_WIDTH-1:0] pointer);\n    next_slot = pointer == LAST_SLOT ? '0 : pointer + 1'b1;\n  endfunction\n\n''' + s[end:]\n    s = s.replace('{read_ptr[QUEUE_DEPTH-2:0],  read_ptr[QUEUE_DEPTH-1]}', 'next_slot(read_ptr)')\n    s = s.replace('{write_ptr[QUEUE_DEPTH-2:0], write_ptr[QUEUE_DEPTH-1]}', 'next_slot(write_ptr)')\n    p.write_text(s)\nPY\nfor combo in fastramq fast3ramq bramramq; do\n  (RTL_DIR=\\\"\"'$work/rtl-loop-$combo\" OBJ_DIR=\"$work/obj-loop-$combo\" NRET=1 bash test/cosim/build.sh > \"$work/build-loop-$combo.log\" 2>&1 &&\n   \"$work/obj-loop-$combo/cosim_sim\" \"$work/coremark.elf\" 50000000 --bench --istall --dstall > \"$work/coremark-$combo.jsonl\") &\ndone\nwait\npython3 - \"$work\" <<'\"'PY'\nimport json, sys\nfrom pathlib import Path\nwork = Path(sys.argv[1])\nfor combo in ('fastramq','fast3ramq','bramramq'):\n    m = json.loads((work / f'coremark-{combo}.jsonl').read_text().splitlines()[-1])\n    print(combo, m['bench_stop_cycle']-m['bench_start_cycle'], m['ebreak'], m['oob'], 'Correct operation validated.' in m['uart'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
