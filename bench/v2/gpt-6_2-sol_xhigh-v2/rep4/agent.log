nstr,\n  output logic       paired_branch,\n  output logic       paired_load,\n  output logic [1:0] paired_alias,'''),\n    ('''  assign load_use_hazard = id_ex_valid && id_ex_mem_read && head_valid\n                        && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)\n                        && (id_ex_rd \"'!= 5'\"'b0);''','''  logic load_dependency;\n  logic legal_load;\n  assign paired_alias = {id_ex_rd == if_id_rs2, id_ex_rd == if_id_rs1};\n  assign load_dependency = id_ex_valid && id_ex_mem_read && head_valid\n                        && (|paired_alias) && (id_ex_rd \"'!= 5'\"'b0);\n  assign legal_load = head_instr[14:12] == 3'd0 || head_instr[14:12] == 3'd1\n                   || head_instr[14:12] == 3'd2 || head_instr[14:12] == 3'd4\n                   || head_instr[14:12] == 3'd5;\n  assign paired_branch = load_dependency && head_instr[6:0] == 7'b1100011\n                      && head_instr[14:13] == 2'b00;\n  assign paired_load = load_dependency && paired_alias[0] && id_ex_mem_width == 2'd2\n                    && head_instr[6:0] == 7'b0000011 && legal_load\n                    && head_instr[31:22] == 10'b0;\n  assign load_use_hazard = load_dependency && \"'!paired_branch && !paired_load;'\"'''),\n])\n\nedit('ex_stage', [\n    ('  input  id_ex_t   in,','''  input  id_ex_t   in,\n  input  logic               kill,\n  input  logic [31:0]        paired_word,\n  input  logic [1:0]         response_width,\n  input  logic [3:0]         response_mask,\n  input  logic               response_sext,\n  input  logic               response_writes,'''),\n    ('  logic [31:0] alu_result, effective_addr;', '''  logic [31:0] alu_result, effective_addr;\n  logic [31:0] pointer_address, other_operand, expected_bytes;\n  logic [3:0] byte_match;\n  logic extension_match;\n  logic [2:0] low_address;\n\n  assign low_address = {1'b0, paired_word[1:0]} + {1'b0, in.addr_offset[1:0]};\n  assign pointer_address[1:0] = low_address[1:0];\n  assign pointer_address[7:2] = paired_wor