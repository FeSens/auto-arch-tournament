 \\\"\\\"\\\"      predicted_pc_q        <= '0;\n      replay_bank_q          <= 4'b0001;\\\"\\\"\\\")\n        source = source.replace(\\\"      predicted_pc_q        <= next_pc;\\\", \\\"\\\"\\\"      predicted_pc_q        <= next_pc;\n      replay_bank_q          <= next_replay_bank;\\\"\\\"\\\")\n    if inline:\n        begin = source.index(\\\"  assign out.instr = ({32{issue_bus}}\\\")\n        end = source.index(\\\"  assign out.predicted_taken\\\", begin)\n        bank_expression = \\\"replay_bank_q[slot]\\\" if onehot else \\\"(predicted_pc_q[3:2] == 2'(slot))\\\"\n        source = source[:begin] + \\\"\\\"\\\"  always_comb begin\n    out.instr = {32{issue_bus}} & imem_data;\n    for (int slot = 0; slot < QUEUE_DEPTH; slot++) begin\n      fetch_slot_t payload;\n      payload = slots_q[slot];\n      out.instr |= {32{issue_buffered && read_ptr_q[slot]}} & payload.instr;\n    end\n    for (int slot = 0; slot < 4; slot++) begin\n      prediction_t payload;\n      payload = replay_payload_q[slot];\n      out.instr |= {32{issue_replay && \\\"\\\"\\\" + bank_expression + \\\"\\\"\\\"}} & payload.instr;\n    end\n  end\n\\\"\\\"\\\" + source[end:]\n    p.write_text(source)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
