{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/predictor-scratch\"\nfor v in ring2 ring2wide ring3 ring2refill skid1 skid1wide; do\n  build=\"$scratch/$v\"\n  NRET=1 RTL_DIR=\"$build/rtl\" OBJ_DIR=\"$build/obj\" bash test/cosim/build.sh > \"$build/verilator.log\" 2>&1 &&\n  \"$build/obj/cosim_sim\" \"$scratch/coremark.elf\" 50000000 --bench --istall --dstall > \"$build/coremark.jsonl\" &\ndone\nwait\nPYTHONDONTWRITEBYTECODE=1 python - <<'\"'PY'\nimport json, os\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nfor p in sorted((Path(os.environ['TMPDIR']) / 'predictor-scratch').glob('*/coremark.jsonl')):\n    d = json.loads(p.read_text().splitlines()[-1])\n    ok = validate_coremark_uart(d['uart'],10)[0] and d['ebreak'] and d['bench_bracketed'] and not d['oob']\n    cycles = d['bench_stop_cycle'] - d['bench_start_cycle']\n    print(p.parent.name, ok, cycles, 'required MHz', round(154.3*1.046*cycles/10e6,3))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
