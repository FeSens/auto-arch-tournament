{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r13-replay/recovery.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\np=Path(sys.argv[1])/'if_stage.sv'\ns=p.read_text()\ns=s.replace('  logic [5:0]  recovery_sequential_index_q, recovery_direct_index_q;\\\\n','')\ns='\\\\n'.join(l for l in s.split('\\\\n') if 'recovery_sequential_index_q <=' not in l and 'recovery_direct_index_q     <=' not in l)\na=s.index('  assign fetch_index =')\nb=s.index('  // An unused entry',a)\ns=s[:a]+'  assign fetch_index = predicted_pc_q[7:2] \"'^ predicted_pc_q[13:8];'\"\\\\n'+s[b:]\ns=s.replace('{1\\\\'b0, request_pc[19:2]} + {1\\\\'b0, word_offset}', '{1\\\\'b0, predicted_pc_q[19:2]} + {1\\\\'b0, word_offset}')\ns=s.replace('assign predict_direct = request_in_window && \"'!halfword_offset'\"', 'assign predict_direct = \"'!recovery_pending_q && predicted_in_window_q && !halfword_offset'\"')\np.write_text(s)\nPY\nfor pair in chainmr:chainm d4pr:d4p; do\n  variant=\"'${pair%:*}\n  source_variant=${pair#*:}\n  mkdir -p \"$TMPDIR/r13-replay/$variant\"\n  cp -r \"$TMPDIR/r13-replay/$source_variant/rtl\" \"$TMPDIR/r13-replay/$variant/\"\n  python \"$TMPDIR/r13-replay/recovery.py\" \"$TMPDIR/r13-replay/$variant/rtl\"\n  ( NRET=1 RTL_DIR=\"$TMPDIR/r13-replay/$variant/rtl\" OBJ_DIR=\"$TMPDIR/r13-replay/$variant/obj\" bash test/cosim/build.sh > \"$TMPDIR/r13-replay/$variant/build.log\" 2>&1 && \"$TMPDIR/r13-replay/$variant/obj/cosim_sim\" \"$TMPDIR/r13-replay/coremark.elf\" 10000000 --bench --istall --dstall >\"$TMPDIR/r13-replay/$variant/coremark.jsonl\" ) &\ndone\nexport PYTHONPATH=\"$PWD\"\npython -u \"$TMPDIR/r13-replay/timing.py\" chainmr > \"$TMPDIR/r13-replay/chainmr/timing.log\" &\npython -u \"$TMPDIR/r13-replay/timing.py\" d4pr 1 > \"$TMPDIR/r13-replay/d4pr/timing.log\" &\nwait\ncat \"$TMPDIR/r13-replay/chainmr/timing.log\" \"$TMPDIR/r13-replay/d4pr/timing.log\"\nfor variant in chainmr d4pr; do tail -1 \"$TMPDIR/r13-rep