{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\nfrom random import Random\n\nmask32 = (1 << 32) - 1\nmask35 = (1 << 35) - 1\n\n\ndef as_int(value, signed):\n    return value - (1 << 32) if signed and value >> 31 else value\n\n\ndef restoring(raw_a, raw_b, signed):\n    a, b = as_int(raw_a, signed), as_int(raw_b, signed)\n    if not b:\n        return mask32, raw_a\n    quotient_buffer, divisor = abs(a), abs(b)\n    remainder = 0\n    for _ in range(7):\n        for _ in range(5):\n            trial = (remainder << 1) | (quotient_buffer >> 34)\n            difference = trial - divisor\n            remainder = difference if difference >= 0 else trial\n            quotient_buffer = ((quotient_buffer << 1) & mask35) | (difference >= 0)\n    quotient = -quotient_buffer if (a < 0) \"'^ (b < 0) else quotient_buffer\n    remainder = -remainder if a < 0 else remainder\n    return quotient & mask32, remainder & mask32\n\n\ndef reference(raw_a, raw_b, signed):\n    a, b = as_int(raw_a, signed), as_int(raw_b, signed)\n    if not b:\n        return mask32, raw_a\n    quotient = abs(a) // abs(b)\n    if (a < 0) ''^ (b < 0):\n        quotient = -quotient\n    return quotient & mask32, (a - b * quotient) & mask32\n\n\nedges = [0, 1, 2, 7, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, mask32]\nrng = Random(32)\npairs = list(product(edges, repeat=2))\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\nfor a, b in pairs:\n    for signed in (False, True):\n        assert restoring(a, b, signed) == reference(a, b, signed), (a, b, signed)\nprint(f'\"'Restoring-division model matched {len(pairs) * 2:,} signed and unsigned operand pairs.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
