n_ram[direction_index]\n                            : {imem_data[31], \"'!imem_data[31]};\n\n  always_ff @(posedge clock) begin\n    if (reset) direction_valid <= '\"'0;\n    else if (train) direction_valid[train_index] <= 1'b1;\n    if (train && \"'!reset) direction_ram[train_index] <= train_value;\n  end\n\n  assign is_jal = imem_data[6:0] == 7'\"'b1101111;\n  assign is_branch = imem_data[6:0] == 7'b1100011 &&\n                     (imem_data[14] || \"'!imem_data[13]);\n  assign halfword = is_jal ? imem_data[21] : imem_data[8];\n  assign immediate_words = is_jal\n      ? {imem_data[31], imem_data[19:12], imem_data[20], imem_data[30:22]}\n      : {{9{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:9]};\n  assign low_sum = {1'\"'b0, pc[20:2]} + {1'b0, immediate_words};\n  assign upper_pc = pc[31:21];\n  assign upper_sum = low_sum[19] == imem_data[31] ? upper_pc\n                   : low_sum[19] ? upper_pc + 11'd1 : upper_pc - 11'd1;\n  assign direct_target = {upper_sum, low_sum[18:0], halfword, 1'b0};\n  assign sequential_pc = pc + 32'd4;\n  assign predicted_taken = \"'!halfword && (is_jal || (is_branch && prediction_counter[1]));\"\"\")\nreplace(\"if_stage.sv\", \"else if (!stall)   pc <= pc + 32'\"'d4;\\\", \\\"\\\"\\\"else if (\"'!stall)   pc <= predicted_taken ? direct_target : sequential_pc;\"\"\")\nreplace(\"if_stage.sv\", \"    out.valid = imem_ready;\", \"\"\"    out.valid = imem_ready;\n    out.direct_target = direct_target;\n    out.predicted_taken = predicted_taken;\n    out.direction_counter = (train && train_index == direction_index)\n                          ? train_value : prediction_counter;\"\"\")\nreplace(\"ex_stage.sv\", \"  output logic [31:0]        redirect_target\", \"\"\"  output logic [31:0]        redirect_target,\n  output logic               train,\n  output logic [1:0]         train_value\"\"\")\nreplace(\"ex_stage.sv\", \"branch_target = in.pc + in.imm;\", \"branch_target = in.direct_target;\")\nreplace(\"ex_stage.sv\", \