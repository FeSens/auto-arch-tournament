ets if r[\"trap\"])\n    assert rets[-2][\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def misaligned_writers_allow_older_values_to_forward(dut):\n.\n..\n__pycache__\n_helpers.py\nconftest.py\ntest_alu.py\ntest_alu_runner.result.xml\ntest_decoder.py\ntest_decoder_runner.result.xml\ntest_div_unit.py\ntest_div_unit_runner.result.xml\ntest_imm_gen.py\ntest_imm_gen_runner.result.xml\ntest_mul_unit.py\ntest_mul_unit_runner.result.xml\ntest_pipeline.py\ntest_pipeline_runner.result.xml\ntest_reg_file.py\n", "exit_code": 0, "status": "completed"}}
