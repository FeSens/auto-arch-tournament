{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r13-replay/chained.py\" <<'\"'PY'\nimport sys\nimport shutil\nfrom pathlib import Path\nout = Path(sys.argv[1])\noptions=set(sys.argv[2:])\nout.mkdir(parents=True, exist_ok=True)\nfor p in Path(\\\"cores/bench/rtl\\\").glob(\\\"*.sv\\\"):\n    shutil.copy(p,out/p.name)\np=out/'if_stage.sv'\nsv=p.read_text()\nif 'parallel' in options:\n    # Store successor instead of bare target. Taken bit still distinguishes a\n    # nonsequential chain lookup from a fall-through prediction.\n    sv=sv.replace('logic [17:0] target;', 'logic [17:0] target;')\n    sv=sv.replace('imem_data, predict_taken, target_word};', 'imem_data, predict_taken,\\\\n                      predict_taken ? target_word : sequential_word};')\n    sv=sv.replace('assign replay_next_word = replay_prediction.taken ? replay_prediction.target\\\\n                          : predicted_pc_q[19:2] + 18\\\\'d1;', 'assign replay_next_word = replay_prediction.target;')\na=sv.index('  // Explicit vectors')\nsv=sv[:a]+\\\"\\\"\\\"\n  // Read around the taken target advertised by the first BRAM response.\n  // The snapshot corresponds to the instruction two positions ahead when\n  // the first read was launched. This read uses the registered snapshot\n  // and can finish before a taken prediction at that instruction.\n  logic [17:0] chain_target, chain_target_next;\n  logic chain_issue, chain_valid_q, chain_hit;\n  logic [1:0] chain_matches;\n  logic [PREDICTION_WIDTH-1:0] chain_lanes [0:1];\n  prediction_t chain_prediction, selected_replay_prediction;\n  logic chain_last, selected_replay_last;\n\n  assign chain_target = lookup_record_q.prediction.target;\n  assign chain_target_next = chain_target + 18'd1;\n  assign chain_issue = lookup_hit && lookup_record_q.prediction.taken;\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) chain_valid_q <= 1'b0;\n    else chain_valid_q <= chain_issue;\n  end\n\n  for (genvar parity = 0; parity < 2; parity++) begin : gen_chain\n    (* syn_ramstyle = \\\"block_ram\\\" *) logic [RECORD_WIDTH-1:0] targets [0:511];\n    logic [17:0] chain_word, chain_word_q, hold_word_q;\n    logic collision_q, valid_q;\n    prediction_record_t word_q;\n    prediction_t hold_prediction_q;\n    assign chain_word = chain_target[0] == 1'(parity) ? chain_target : chain_target_next;\n    assign chain_matches[parity] = valid_q && hold_word_q == predicted_pc_q[19:2];\n    assign chain_lanes[parity] = {PREDICTION_WIDTH{chain_matches[parity]}} & hold_prediction_q;\n    always_ff @(posedge clock) begin\n      if (ram_write_en && ram_write_index[0] == 1'(parity))\n        targets[ram_write_index[9:1]] <= ram_write_data;\n\n      word_q <= targets[chain_word[9:1]];\n      chain_word_q <= chain_word;\n      collision_q <= ram_write_en && ram_write_index == chain_word[9:0];\n\n      if (reset || fence_i) valid_q <= 1'b0;\n      else if (chain_valid_q && \"'!collision_q && chain_word_q != 18'\"'h3ffff\n               && word_q.valid && word_q.tag == chain_word_q[17:10]) begin\n        valid_q <= 1'b1;\n        hold_word_q <= chain_word_q;\n        hold_prediction_q <= word_q.prediction;\n      end\n    end\n  end\n  assign chain_hit = |chain_matches;\n  assign chain_prediction = chain_lanes[0] | chain_lanes[1];\n  assign chain_last = chain_prediction.taken ? (&chain_prediction.target) :\n                      predicted_pc_q[19:2] == 18'h3fffe;\n  assign selected_replay_prediction = (|replay_match) ? replay_prediction : chain_prediction;\n  assign selected_replay_last = (|replay_match) ? replay_last_word : chain_last;\n\n\\\"\\\"\\\" + sv[a:]\nif 'parallel' in options:\n    sv=sv.replace(\\\"assign chain_last = chain_prediction.taken ? (&chain_prediction.target) :\\\\n                      predicted_pc_q[19:2] == 18'h3fffe;\\\", \\\"assign chain_last = &chain_prediction.target;\\\")\n    sv=sv.replace(\\\"assign replay_last_word = replay_prediction.taken ? (|replay_target_last)\\\\n                          : predicted_pc_q[19:2] == 18'h3fffe;\\\", \\\"assign replay_last_word = |replay_target_last;\\\")\nsv=sv.replace('  logic [17:0] replay_next_word;', '  logic [17:0] replay_next_word, chain_next_word;')\nif 'parallel' in options:\n    sv=sv.replace('  assign replay_next_word', '  assign chain_next_word = chain_prediction.target;\\\\n  assign replay_next_word')\nelse:\n    sv=sv.replace('  assign replay_next_word','  assign chain_next_word = chain_prediction.taken ? chain_prediction.target : predicted_pc_q[19:2] + 18\\\\'d1;\\\\n  assign replay_next_word')\nsv=sv.replace('bus_word.instr : replay_prediction.instr', 'bus_word.instr : selected_replay_prediction.instr')\nsv=sv.replace('bus_word.predicted_taken : replay_prediction.taken', 'bus_word.predicted_taken : selected_replay_prediction.taken')\nsv=sv.replace('accept_replay = (|replay_match)', 'accept_replay = ((|replay_match) || chain_hit)')\nsv=sv.replace('& replay_next_word)', '& ((|replay_match) ? replay_next_word : chain_next_word))')\nsv=sv.replace('accept_replay && replay_last_word', 'accept_replay && selected_replay_last')\nif 'bypass' in options:\n    sv=sv.replace('assign head = empty ? bus_word : buffered_head;', 'assign head = empty ? produced : buffered_head;')\n    sv=sv.replace('= \"'!empty || bus_valid;'\"', '= \"'!empty || bus_valid || accept_replay;'\"')\n    sv=sv.replace('enqueue = accept_replay || (accept_bus && (\"'!empty || issue_hold));'\"', 'enqueue = (accept_replay || accept_bus) && (\"'!empty || issue_hold);'\"')\nif 'multi' in options:\n    # Match sources separately and keep the primary/secondary select out of\n    # the data mux.\n    sv=sv.replace('  prediction_t chain_prediction, selected_replay_prediction;\\\\n  logic chain_last, selected_replay_last;', '  prediction_t chain_prediction;\\\\n  logic chain_last;\\\\n  logic accept_primary, accept_chain;')\n    start=sv.index('  assign selected_replay_prediction')\n    end=sv.index('  // Explicit vectors',start)\n    sv=sv[:start]+sv[end:]\n    sv=sv.replace('assign produced.instr            = bus_valid ? bus_word.instr : selected_replay_prediction.instr;',\n    '''assign produced.instr = ({32{bus_valid}} & bus_word.instr)\n                        | ({32{\"'!bus_valid && (|replay_match)}} & replay_prediction.instr)\n                        | ({32{!bus_valid && !(|replay_match)}} & chain_prediction.instr);'\"''')\n    sv=sv.replace('assign produced.predicted_taken  = bus_valid ? bus_word.predicted_taken : selected_replay_prediction.taken;',\n    '''assign produced.predicted_taken = (bus_valid && bus_word.predicted_taken)\n                                  || (\"'!bus_valid && (|replay_match) && replay_prediction.taken)\n                                  || (!bus_valid && !(|replay_match) && chain_prediction.taken);'\"''')\n    sv=sv.replace('  assign enqueue =', '  assign accept_primary = accept_replay && (|replay_match);\\\\n  assign accept_chain = accept_replay && \"'!(|replay_match);'\"\\\\n  assign enqueue =')\n    sv=sv.replace('({18{accept_replay}}       & ((|replay_match) ? replay_next_word : chain_next_word))',\n        '({18{accept_primary}}      & replay_next_word)\\\\n                            | ({18{accept_chain}}        & chain_next_word)')\n    sv=sv.replace('(accept_replay && selected_replay_last)', '(accept_primary && replay_last_word)\\\\n                            || (accept_chain && chain_last)')\np.write_text(sv)\nPY\nfor variant in chain chainp chainm; do\n  case \\\"\"'$variant\" in\n    chain) args='\"'' ;;\n    chainp) args='parallel' ;;\n    chainm) args='parallel multi' ;;\n  esac\n  python \\\"\"'$TMPDIR/r13-replay/chained.py\" \"$TMPDIR/r13-replay/$variant/rtl\" $args\n  ( NRET=1 RTL_DIR=\"$TMPDIR/r13-replay/$variant/rtl\" OBJ_DIR=\"$TMPDIR/r13-replay/$variant/obj\" bash test/cosim/build.sh > \"$TMPDIR/r13-replay/$variant/build.log\" 2>&1 && \"$TMPDIR/r13-replay/$variant/obj/cosim_sim\" \"$TMPDIR/r13-replay/coremark.elf\" 10000000 --bench --istall --dstall >\"$TMPDIR/r13-replay/$variant/coremark.jsonl\" ) &\ndone\nwait\npython - <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nimport os,json\nfor path in sorted((Path(os.environ['TMPDIR']) / 'r13-replay').glob('chain*/coremark.jsonl')):\n  lines = path.read_text().splitlines()\n  if not lines:\n    continue\n  result=json.loads(lines[-1])\n  print(path.parent.name, result.get('bench_stop_cycle',0)-result.get('bench_start_cycle',0), result.get('ebreak'), result.get('oob'), validate_coremark_uart(result.get('uart',''),10))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
