{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\nfrom random import Random\n\nWORD_MASK = (1 << 32) - 1\nSUB_MASK = (1 << 35) - 1\nBORROW = 1 << 34\n\ndef scheduled_divide(a, b):\n    top = a >> 30\n    if b == 1:\n        quotient, remainder = top, 0\n    elif b == 2:\n        quotient, remainder = top >> 1, top & 1\n    elif b == 3 and top == 3:\n        quotient, remainder = 1, 0\n    else:\n        quotient, remainder = 0, top\n    multiples = (b, 2 * b, 3 * b)\n    for group in range(5):\n        for digit in range(3):\n            bit_offset = 28 - 2 * (3 * group + digit)\n            trial = (remainder << 2) | ((a >> bit_offset) & 3)\n            differences = [(trial - multiple) & SUB_MASK for multiple in multiples]\n            quotient_digit = 0\n            for candidate_digit, difference in enumerate(differences, start=1):\n                if difference < BORROW:\n                    quotient_digit, trial = candidate_digit, difference\n            quotient = (quotient << 2) | quotient_digit\n            remainder = trial\n    return quotient, remainder\n\ndef signed_word(value):\n    return value if value < 2**31 else value - 2**32\n\ndef check(a, b, signed):\n    x, y = (signed_word(a), signed_word(b)) if signed else (a, b)\n    q, r = scheduled_divide(abs(x), abs(y))\n    if b == 0:\n        q, r = WORD_MASK, a\n        reference_q, reference_r = WORD_MASK, a\n    else:\n        if (x < 0) \"'!= (y < 0):\n            q = -q\n        if x < 0:\n            r = -r\n        reference_q = x // y\n        if (x < 0) != (y < 0) and x % y:\n            reference_q += 1\n        reference_r = x - reference_q * y\n    assert (q & WORD_MASK, r & WORD_MASK) == (reference_q & WORD_MASK, reference_r & WORD_MASK), (a, b, signed)\n\nedges = [0, 1, 2, 3, 4, 2**30 - 1, 2**30, 2**31 - 1, 2**31, 2**31 + 1, 2**32 - 2, 2**32 - 1]\nchecks = 0\nfor a, b, signed in product(edges, edges, (False, True)):\n    check(a, b, signed)\n    checks += 1\nrng = Random(20261121)\nfor _ in range(25000):\n    a, b = rng.getrandbits(32), rng.getrandbits(32)\n    for divisor in (b, b >> rng.randrange(32)):\n        for signed in (False, True):\n            check(a, divisor, signed)\n            checks += 1\nprint(f'\"'Proposed radix-4 recurrence matched quotient and remainder on {checks:,} signed/unsigned cases.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
