{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c 'set -e\nwork=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\npython3 - \"$work\" <<'\"'PY'\nfrom pathlib import Path\nimport re, shutil, sys\nwork = Path(sys.argv[1])\nfor base in ('page','page128'):\n    rtl = work / f'rtl-loop-{base}lean'\n    shutil.copytree(work / f'rtl-loop-{base}', rtl)\n    p = rtl / 'if_stage.sv'\n    s = p.read_text()\n    s = s.replace('  logic        loop_branch, loop_jal;', '  logic        loop_backedge;')\n    a = s.index('  assign loop_jal =')\n    b = s.index('  assign predict_taken', a)\n    s = s[:a] + '''  assign loop_predict_taken = loop_backedge && (\"'!table_known || table_taken);\n'\"''' + s[b:]\n    s = s.replace('halfword_offset, bus_target_valid, loop_target_valid', 'halfword_offset, bus_target_valid')\n    s = re.sub(r'logic \\\\[50:0\\\\] loop_words', 'logic [32:0] loop_words', s)\n    s = s.replace('  logic [50:0] fill_data_q;', '''  logic [50:0] fill_data_q;\n  logic [31:0] fill_instr;\n  logic [17:0] fill_target;\n  logic        fill_target_valid, fill_branch, fill_jal, fill_backedge;''')\n    firstbit = '5' if base == 'page' else '6'\n    s = s.replace('  assign refill_loop = fill_valid_q && fill_in_loop;',\nf'''  assign {{fill_target_valid, fill_target, fill_instr}} = fill_data_q;\n  assign fill_jal = fill_instr[6:0] == 7'b1101111;\n  assign fill_branch = fill_instr[6:0] == 7'b1100011 && (fill_instr[14] || \"'!fill_instr[13]);\n  assign fill_backedge = fill_branch && fill_target_valid &&\n                         fill_pc_q[{firstbit}:0] == loop_last_q && fill_target == loop_first_q;\n  assign refill_loop = fill_valid_q && fill_in_loop && (fill_backedge || !(fill_branch || fill_jal));'\"''')\n    s = s.replace('assign {loop_target_valid, loop_direct_target, loop_instr} =', 'assign {loop_backedge, loop_instr} =')\n    s = s.replace('assign producer_data = loop_instr;', 'assign loop_direct_target = loop_first_q;')\n    s = s.replace('  logic [31:0] producer_pc, producer_data;', '  logic [31:0] producer_pc;')\n    s = s.replace('loop_words[loop_write_index] <= fill_data_q;', 'loop_words[loop_write_index] <= {fill_backedge, fill_instr};')\n    p.write_text(s)\nPY\nfor combo in pagelean page128lean; do\n  (RTL_DIR=\\\"\"'$work/rtl-loop-$combo\" OBJ_DIR=\"$work/obj-loop-$combo\" NRET=1 bash test/cosim/build.sh > \"$work/build-loop-$combo.log\" 2>&1 &&\n   \"$work/obj-loop-$combo/cosim_sim\" \"$work/coremark.elf\" 50000000 --bench --istall --dstall > \"$work/coremark-$combo.jsonl\") &\ndone\nwait\npython3 - \"$work\" <<'\"'PY'\nimport json, sys\nfrom pathlib import Path\nwork = Path(sys.argv[1])\nfor combo in ('pagelean','page128lean'):\n    m = json.loads((work / f'coremark-{combo}.jsonl').read_text().splitlines()[-1])\n    print(combo, m['bench_stop_cycle']-m['bench_start_cycle'], m['ebreak'], m['oob'], 'Correct operation validated.' in m['uart'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
