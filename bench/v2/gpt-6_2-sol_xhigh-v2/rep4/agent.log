n    s=s[:start]+new+s[end:]\n\nrep('  input  logic              ex_direct_taken,\\\\n','')\nrep('  input  logic [5:0]        mem_indirect_index,\\\\n','')\nrep('  input  logic [5:0]        train_index,\\\\n  input  logic              train_negative,','  input  logic [31:0]       direct_source_q,\\\\n  input  logic [17:0]       predicted_target_q,')\nrep('    logic        predicted_taken;','    logic        predicted_taken;\\\\n    logic [17:0] predicted_target;')\nrep('  localparam int SLOT_WIDTH = 64;','  localparam int SLOT_WIDTH = \"'$bits(fetch_slot_t);'\"')\nrep('  logic [5:0]  predicted_index_q;\\\\n','')\nrep('  logic        select_sequential_q, legacy_direct_q, select_indirect_q;','  logic        select_sequential_q, select_indirect_q;')\nrep('  logic [5:0]  recovery_sequential_index_q, recovery_direct_index_q;\\\\n','')\ncut('    recovery_sequential_index_q <=','    recovery_sequential_in_window_q')\nrep('    select_sequential_q <= redirect && \"'!ex_direct_taken && !recover_indirect;'\"\\\\n    legacy_direct_q     <= redirect && ex_direct_taken;', '    select_sequential_q <= redirect && \"'!recover_indirect;'\"')\nrep('  assign branch_direct = branch.taken && branch.direct_if_taken;', '''  logic target_mismatch;\n  assign target_mismatch = \"'!recovery_direct_in_window_q ||\n                           recovery_direct_target_q[19:2] != predicted_target_q;\n  assign branch_direct = branch.taken && (branch.direct_if_taken ||\n                                           (branch.check_target && target_mismatch));'\"''')\nrep('  assign select_direct = legacy_direct_q || branch_direct;','  assign select_direct = branch_direct;')\nrep('  logic [5:0]  fetch_index [0:3];\\\\n','')\ncut('  assign fetch_index[NORMAL]', '  assign imem_addr')\ncut('  logic [17:0] target_word, word_offset;', '  // A synchronous lookup', '''  logic [17:0] target_word;\n  logic is_jal, is_branch, predict_taken;\n\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign is_branch = imem_d