''')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/recovery-research/free.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" free:1 freectrl:1 freesplit:1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
