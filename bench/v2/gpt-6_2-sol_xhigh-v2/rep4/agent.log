      always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ntotal 40\n-rw-rw----+ 1 nobody nogroup  2630 Nov 21 18:33 checks-deep.cfg\n-rw-rw----+ 1 nobody nogroup  2658 Nov 21 18:33 checks.cfg\n-rw-rw----+ 1 nobody nogroup  1455 Nov 21 18:33 checks_si.cfg\nlrwxrwxrwx+ 1 nobody nogroup    66 Nov 21 18:33 riscv-formal -> /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep4/formal/riscv-formal\n-rwxrwx---+ 1 nobody nogroup 10597 Nov 21 18:33 run_all.sh\n-rw-rw----+ 1 nobody nogroup  4615 Nov 21 18:33 wrapper.sv\n-rw-rw----+ 1 nobody nogroup  2863 Nov 21 18:33 wrapper_si.sv\n0\tformal/riscv-formal/.agents\n0\tformal/riscv-formal/.aws\n0\tformal/riscv-formal/.codex\n24K\tformal/riscv-formal/.github\n36K\tformal/riscv-formal/monitor\n44K\tformal/riscv-formal/bus\n124K\tformal/riscv-formal/tests\n144K\tformal/riscv-formal/docs\n996K\tformal/riscv-formal/checks\n2.2M\tformal/riscv-formal/.git\n4.5M\tformal/riscv-formal/insns\n420M\tformal/riscv-formal/cores\n428M\tformal/riscv-formal/\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_seed_rom.sv\", \"div_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n","exit_code":0,"status":"completed"}}
