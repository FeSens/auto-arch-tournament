{"type": "item.started", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/recovery-research/addlane.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nroot=Path(os.environ['TMPDIR'])/'recovery-research'\n\ndef replace(file, old, new):\n    p=variant/file\n    s=p.read_text()\n    assert s.count(old)==1,(file,old)\n    p.write_text(s.replace(old,new))\n\ndef split(lane=True, simplify=False):\n    replace('core_pkg.sv','  typedef logic [2:0] operand_sel_t;','  typedef logic [3:0] operand_sel_t;')\n    replace('core_pkg.sv','OPERAND_FALLBACK = 3\\\\'b001', 'OPERAND_FALLBACK = 4\\\\'b0001')\n    replace('core_pkg.sv','    logic [31:0] effective_addr;', '    logic [31:0] effective_addr;\\\\n    logic        result_is_sum;')\n    replace('forward_unit.sv','  input  logic       ex_write_eligible,','  input  logic       ex_write_eligible,\\\\n  input  logic       ex_result_is_sum,')\n    for num in (1,2):\n        replace('forward_unit.sv',f'{{rs{num}_ex, rs{num}_mem && \"'!rs{num}_ex, !(rs{num}_ex || rs{num}_mem)}}'\"',\n                f'{{rs{num}_ex && ex_result_is_sum, rs{num}_ex && \"'!ex_result_is_sum,'\"\\\\n                     rs{num}_mem && \"'!rs{num}_ex, !(rs{num}_ex || rs{num}_mem)}}'\"')\n    replace('core.sv','  logic       ex_write_eligible, mem_write_eligible;','  logic       ex_write_eligible, mem_write_eligible, ex_result_is_sum;')\n    replace('core.sv','    .fwd_ex_mem      (ex_mem_w.alu_result),','''    .fwd_ex_mem      (ex_mem_w.alu_result),\n    .fwd_sum         (ex_mem_w.effective_addr),\n    .result_is_sum   (ex_result_is_sum),''')\n    replace('core.sv','    .ex_write_eligible  (ex_write_eligible),','''    .ex_write_eligible  (ex_write_eligible),\n    .ex_result_is_sum   (ex_result_is_sum),''')\n    replace('ex_stage.sv','  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)','''  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_sum,\n  output logic               result_is_sum,''')\n    for op in ('rs1','rs2','alu_a','alu_b'):\n        replace('ex_stage.sv',f'assign {op} = ({{32{{in.{op}_sel[2]}}}} & fwd_ex_mem)',\n                f'assign {op} = ({{32{{in.{op}_sel[3]}}}} & fwd_sum)\\\\n               | ({{32{{in.{op}_sel[2]}}}} & fwd_ex_mem)')\n    replace('ex_stage.sv','  assign use_alu_result = \"'!(in.ctrl.is_jump || mul_high_instr || div_instr);'\"','''  assign use_alu_result = \"'!(in.ctrl.is_jump || mul_high_instr || div_instr);\n  assign result_is_sum = (in.ctrl.alu_op == ALU_ADD) && !in.ctrl.is_jump;'\"''')\n    replace('ex_stage.sv','      reg_q.effective_addr <= effective_addr;', '      reg_q.effective_addr <= effective_addr;\\\\n      reg_q.result_is_sum <= result_is_sum;')\n    replace('ex_stage.sv','  alu u_alu (','  alu #(.INCLUDE_ADD(0)) u_alu (')\n    replace('alu.sv','module alu (','module alu #(parameter bit INCLUDE_ADD = 1) (')\n    replace('alu.sv','ALU_ADD:    out = add_sum;', 'ALU_ADD:    out = INCLUDE_ADD ? add_sum : 32\\\\'b0;')\n    replace('mem_stage.sv','    next_wb.write_value = in.ctrl.mem_to_reg ? load_data : in.alu_result;','''    next_wb.write_value = ({32{in.ctrl.mem_to_reg}} & load_data)\n                        | ({32{\"'!in.ctrl.mem_to_reg && in.result_is_sum}} & in.effective_addr)\n                        | ({32{!in.ctrl.mem_to_reg && !in.result_is_sum}} & in.alu_result);'\"''')\n    if simplify:\n        replace('ex_stage.sv','''      reg_q.alu_result    <= mul_low_instr ? mul_low_result\n                           : (({32{in.ctrl.is_jump}} & sequential_pc)\n                           |  ({32{mul_high_instr}}  & mul_high_result)\n                           |  ({32{div_instr}}       & div_result)\n                           |  ({32{use_alu_result}}  & alu_result));''','''      reg_q.alu_result    <= ({32{mul_low_instr}}     & mul_low_result)\n                           | ({32{in.ctrl.is_jump}}  & sequential_pc)\n                           | ({32{mul_high_instr}}   & mul_high_result)\n                           | ({32{div_instr}}        & div_result)\n                           | ({32{use_alu_result}}   & alu_result);''')\n\nfor name,base,simple in (\n    ('addlane','cores/bench/rtl',False),\n    ('addflat','cores/bench/rtl',True),\n    ('addsplit',root/'split',True),\n):\n    variant=root/name\n    shutil.copytree(base,variant,dirs_exist_ok=True)\n    split(simplify=simple)\nPY\npython \\\"\"'$TMPDIR/recovery-research/addlane.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" addlane:1 addflat:1 addsplit:1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
