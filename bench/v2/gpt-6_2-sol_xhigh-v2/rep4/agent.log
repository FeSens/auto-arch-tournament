{"type": "item.completed", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/bash -c \"sed -n '421,511p' cores/bench/test/test_pipeline.py && sed -n '1,120p' formal/checks_si.cfg\"", "aggregated_output": "    assert [fetches[i + 1] for i in branch_fetches[:2]] == [(8, True)] * 2\n    exit_fetch = branch_fetches[-1]\n    assert fetches[exit_fetch + 1:exit_fetch + 8] == [\n        (8, True), (12, True), (16, True), (28, False), (32, False), (32, True), (36, True),\n    ]\n\n\n@cocotb.test()\nasync def consecutive_aliased_branches_bypass_pending_training(dut):\n    # The XOR index is 32 at 0x80, 0x1ffc, and 0x2000. The adjacent\n    # branches at 0x1ffc and 0x2000 train on consecutive edges.\n    program = [NOP()] * (0x2028 // 4)\n    for pc, insn in {\n        0x0000: JAL(0, 0x80),\n        0x0080: BEQ(0, 0, 8),             # cold forward: 01 -> 10\n        0x0084: SW(0, 0, 0x40),          # squashed by the cold branch\n        0x0088: JAL(0, 0x1FFC - 0x88),\n        0x1FFC: BNE(0, 0, 2),             # untaken, unaligned target: 10 -> 01\n        0x2000: BEQ(1, 0, 0x20),          # taken once: bypassed 01 -> 10\n        0x2004: ADDI(2, 2, 1),\n        0x2008: BNE(2, 1, 8),            # exit after the second fall-through\n        0x200C: JAL(0, -0xC),\n        0x2010: EBREAK(),\n        0x2020: ADDI(1, 0, 1),\n        0x2024: JAL(0, -0x24),\n    }.items():\n        program[pc // 4] = insn\n\n    fetches, stores = [], []\n    rets, _ = await _run(dut, program, fetch_requests=fetches, store_requests=stores)\n    assert stores == []\n    assert [r[\"pc\"] for r in rets] == [\n        0, 0x80, 0x88, 0x1FFC, 0x2000, 0x2020, 0x2024,\n        0x2000, 0x2004, 0x2008, 0x200C, 0x2000, 0x2004, 0x2008, 0x2010,\n    ]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert rets[4][\"cycle\"] == rets[3][\"cycle\"] + 1\n    assert all(r[\"trap\"] == 0 for r in rets)\n    [unaligned_branch] = _by_insn(rets, program[0x1FFC // 4])\n    assert unaligned_branch[\"pc_next\"] == 0x2000\n    # First prediction uses the old 10, even while 01 is being written.\n    # First training uses 01, so the second visit's untaken outcome brings\n    # 10 back to 01, and the third visit predicts sequential.\n    assert [fetches[i + 1][0] for i, (addr, _) in enumerate(fetches) if addr\n…[2453 of 5525 chars elided by tools/bench/transcript.py; sha256:d18dbe7fd37073e3]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
