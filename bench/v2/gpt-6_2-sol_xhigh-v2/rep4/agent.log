{"type": "item.started", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c 'dsp_dir=$(mktemp -d \"$TMPDIR/hyp-r7s1-reciprocal.XXXXXX\") &&\nmkdir -p \"$dsp_dir/cores/bench\" &&\ncp -R '\"'/srv/hwebench/tmp/58928045/18f4746e/hyp-r7s1-base.hwwVfS/fpga' \\\"\"'$dsp_dir/\" &&\ncp -R '\"'/srv/hwebench/tmp/58928045/18f4746e/hyp-r7s1-base.hwwVfS/cores/bench/core.yaml' '/srv/hwebench/tmp/58928045/18f4746e/hyp-r7s1-base.hwwVfS/cores/bench/rtl' \\\"\"'$dsp_dir/cores/bench/\" &&\ncp -R Makefile bench test \"$dsp_dir/\" &&\ncp -R cores/bench/test \"$dsp_dir/cores/bench/\" &&\npython - \"$dsp_dir/cores/bench/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl=Path(sys.argv[1])\npath=rtl/'div_unit.sv'\ns=path.read_text()\ns=s[:s.index('\"'`else'\"\\\\n')] + \\\"\\\"\\\"\"'`else\n  logic signed_op, rem_op, a_neg, b_neg;\n  logic rem_q, negate_quot_q, negate_rem_q, zero_q;\n  logic [31:0] abs_a_q, abs_b_q;\n  logic [31:0] norm_b_q;\n  logic [4:0] shift_q, leading_zeros;\n  logic [3:0] upper_group;\n  logic [15:0] nz16;\n  logic [7:0] nz8;\n  logic [3:0] nz4;\n  logic [1:0] nz2;\n  logic [12:0] seed;\n  logic [44:0] init_num;\n  logic [34:0] init_den, nr0_q, nr1_q, nr2_q;\n  logic [24:0] err0_q;\n  logic [12:0] factor0;\n  logic [36:0] err_product;\n  logic [47:0] refine0;\n  logic [49:0] refine1;\n  logic [14:0] err1_q;\n  logic [31:0] guess_q;\n  logic [31:0] check_prod_q;\n  logic [31:0] a_minus_b_q;\n  logic        a_ge_b_q;\n  logic [31:0] quot0_q, quot1_q;\n  logic [31:0] remainder0, remainder1, rem_final;\n  logic        adjust;\n\n  assign signed_op = op_q == ALU_DIV || op_q == ALU_REM;\n  assign rem_op = op_q == ALU_REM || op_q == ALU_REMU;\n  assign a_neg = signed_op && a_q[31];\n  assign b_neg = signed_op && b_q[31];\n\n  assign leading_zeros[4] = !(|abs_b_q[31:16]);\n  assign nz16 = leading_zeros[4] ? abs_b_q[15:0] : abs_b_q[31:16];\n  assign leading_zeros[3] = !(|nz16[15:8]);\n  assign nz8 = leading_zeros[3] ? nz16[7:0] : nz16[15:8];\n  assign leading_zeros[2] = !(|nz8[7:4]);\n  assign nz4 = leading_zeros[2] ? nz8[3:0] : nz8[7:4];\n  assign leading_zeros[1] = !(|nz4[3:2]);\n  assign nz2 = leading_zeros[1] ? nz4[1:0] : nz4[3:2];\n  assign leading_zeros[0] = !nz2[1];\n\n  div_seed_rom u_seed (\n    .clock(clock),\n    .address(norm_b_q[30:21]),\n    .seed(seed)\n  );\n\n  // Q0.32 operands multiplied by a Q1.12 seed. Capture the numerator\n  // rounded down and the denominator deficit rounded down in Q*.34.\n  assign init_num = abs_a_q * seed;\n  assign init_den = norm_b_q * seed;\n  assign factor0 = err0_q[24:12];\n  assign err_product = err0_q * factor0;\n  assign refine0 = nr0_q * factor0;\n  assign refine1 = nr1_q * err1_q;\n\n  always_ff @(posedge clock) begin\n    if (prepare_q) begin\n      abs_a_q <= a_neg ? -a_q : a_q;\n      abs_b_q <= b_neg ? -b_q : b_q;\n      rem_q <= rem_op;\n      negate_quot_q <= a_neg ''^ b_neg;\n      negate_rem_q <= a_neg;\n      zero_q <= (b_q == 0);\n    end else if (iterate) begin\n      case (cycles_left_q)\n        3'\"'d7: begin\n          norm_b_q <= abs_b_q << leading_zeros;\n          shift_q  <= leading_zeros;\n        end\n        // 3'd6: the synchronous seed ROM registers its output.\n        3'd5: begin\n          nr0_q <= init_num[44:10];\n          err0_q <= ~init_den[34:10] + {24'b0, \"'!(|init_den[9:0])};\n        end\n        3'\"'d4: begin\n          nr1_q <= nr0_q + {9'b0, refine0[47:22]};\n          err1_q <= {3'b0, err0_q[11:0]} + err_product[36:22];\n        end\n        3'd3: begin\n          nr2_q <= nr1_q + {19'b0, refine1[49:34]};\n        end\n        3'd2: begin\n          guess_q <= nr2_q[34:3] >> ~shift_q;\n          a_minus_b_q <= abs_a_q - abs_b_q;\n          a_ge_b_q <= abs_a_q >= abs_b_q;\n        end\n        3'd1: begin\n          check_prod_q <= guess_q * abs_b_q;\n          quot0_q <= negate_quot_q ? -guess_q : guess_q;\n          quot1_q <= negate_quot_q ? ~guess_q : guess_q + 32'd1;\n        end\n        default: ;\n      endcase\n    end\n  end\n  assign adjust = a_ge_b_q && (check_prod_q <= a_minus_b_q);\n  assign remainder0 = negate_rem_q ? (check_prod_q - abs_a_q) : (abs_a_q - check_prod_q);\n  assign remainder1 = negate_rem_q ? (check_prod_q - a_minus_b_q) : (a_minus_b_q - check_prod_q);\n  assign rem_final = adjust ? remainder1 : remainder0;\n  assign result = zero_q ? (rem_q ? a_q : 32'hffffffff)\n                : rem_q ? rem_final : adjust ? quot1_q : quot0_q;\n\"'`endif\n\nendmodule\n\"\"\"\ns=s.replace(\"  logic [3:0] upper_group;'\"\\\\n\\\",\\\"\\\")\npath.write_text(s)\nrom = ['module div_seed_rom (input logic clock, input logic [9:0] address, output logic [12:0] seed);',\n       '  always_ff @(posedge clock) begin',\n       '    case (address)']\nrom.extend(f\\\"      10'd{i}: seed <= 13'd{(1<<23)//(1025+i)};\\\" for i in range(1024))\nrom += [\\\"      default: seed <= 13'd4096;\\\", \\\"    endcase\\\", \\\"  end\\\", \\\"endmodule\\\"]\n(rtl/'div_seed_rom.sv').write_text('\\\\n'.join(rom)+'\\\\n')\nPY\nprintf '%s\\\\n' \\\"\"'$dsp_dir\" &&\npython -m tools.eval.gowin bench --worktree \"$dsp_dir\" --all-options'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
