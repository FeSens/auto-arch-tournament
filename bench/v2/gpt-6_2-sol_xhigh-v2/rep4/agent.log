{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/b697edee/bench-r8s0.b2RJMn/make_cmp_variants.py' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(__file__).resolve().parent\nrtl_dir = Path('cores/bench/rtl')\n\ndef compare_parts(n, prefix, a, b):\n    lines = []\n    add = lines.append\n    size = 32 // n\n    add(f'  logic [{n-1}:0] {prefix}_eq, {prefix}_lt;')\n    for group in range(n):\n        low = group * size\n        high = low + size - 1\n        add(f'  assign {prefix}_eq[{group}] = {a}[{high}:{low}] == {b}[{high}:{low}];')\n        add(f'  assign {prefix}_lt[{group}] = {a}[{high}:{low}] <  {b}[{high}:{low}];')\n    terms = []\n    for group in range(n-1, -1, -1):\n        lt = f'{prefix}_lt[{group}]'\n        terms.append(lt if group == n-1 else f'(&{prefix}_eq[{n-1}:{group+1}] && {lt})')\n    add(f'  assign {prefix}_equal = &{prefix}_eq;')\n    add(f'  assign {prefix}_unsigned_lt = ' + '\\\\n                 || '.join(terms) + ';')\n    return '\\\\n'.join(lines) + '\\\\n'\n\nfor name in sys.argv[1:]:\n    base, branch, alu = name.split('-')\n    work = scratch / name\n    parent = root if base == 'orig' else scratch / base\n    shutil.copytree(parent / rtl_dir, work / rtl_dir)\n    shutil.copy2(root / 'cores/bench/core.yaml', work / 'cores/bench/core.yaml')\n    shutil.copytree(root / 'fpga', work / 'fpga')\n    if int(branch):\n        file = work / rtl_dir / 'ex_stage.sv'\n        rtl = file.read_text()\n        low = rtl.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n        high = rtl.index('  assign branch_taken', low)\n        rtl = rtl[:low] + '''  logic cmp_equal, cmp_unsigned_lt, cmp_signed_lt, cmp_ordered;\n''' + compare_parts(int(branch), 'cmp', 'rs1', 'rs2') + '''\n  assign cmp_signed_lt = (rs1[31] \"'!= rs2[31]) ? rs1[31] : cmp_unsigned_lt;\n  assign cmp_ordered = in.ctrl.branch_op[1] ? cmp_uns