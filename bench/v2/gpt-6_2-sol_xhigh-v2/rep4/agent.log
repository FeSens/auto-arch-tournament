ange_gt[1]) ||\n                          ((&range_eq[2:1]) && range_gt[0]);\\\"\\\"\\\")\n    return source\n\ndef first_correction_sequential(source):\n    return source.replace(\\\"assign predict_direct = fetch_in_window[path]\\\", \\\"assign predict_direct = path == NORMAL && fetch_in_window[path]\\\")\n\nfor name, source in (\n    ('flatseg', flattened(segmented)),\n    ('flatrange', flattened(cap_range(original))),\n    ('seqrec', flattened(first_correction_sequential(original))),\n):\n    rtl = scratch / name / 'rtl'\n    shutil.copytree(repo_rtl, rtl, dirs_exist_ok=True)\n    (rtl / 'if_stage.sv').write_text(source)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
