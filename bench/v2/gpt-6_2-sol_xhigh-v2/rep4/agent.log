{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'scratch=$(cat \"$TMPDIR/bench-r15s1-dir\")\nfor variant in banked_share banked_stage banked_2048\ndo\n  mkdir -p \"$scratch/$variant/cores/bench\"\n  cp -r \"$scratch/banked_fast/cores/bench/rtl\" \"$scratch/banked_fast/cores/bench/core.yaml\" \"$scratch/$variant/cores/bench/\"\n  cp -r \"$scratch/fpga\" \"$scratch/$variant/\"\ndone\npython - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfor variant in ('banked_share', 'banked_stage', 'banked_2048'):\n p=Path(sys.argv[1])/variant/'cores/bench/rtl/if_stage.sv'\n s=p.read_text()\n s=s.replace(\\\"  logic [17:0] fill_successor_word;\\\\n  logic [5:0] fill_successor_index;\\\\n\\\",\\\"\\\")\n s=s.replace(\\\"  assign fill_successor_word = predict_taken ? target_word : request_pc[19:2] + 18'd1;\\\\n  assign fill_successor_index = fill_successor_word[11:6] \"'^ fill_successor_word[5:0];'\"\\\\n\\\",\\\"\\\")\n s=s.replace(\\\"                      fill_successor_word, fill_successor_index, (&fill_successor_word)};\\\",\\\"                      next_pc[19:2], next_index, next_last_word};\\\")\n if variant == 'banked_stage':\n  s=s.replace(\\\"  prediction_record_t fill_record_q;\\\", \\\"\\\"\\\"  prediction_record_t fill_record_q;\n  logic        fill_capture_q, fill_taken_q;\n  logic [9:0]  fill_capture_index_q;\n  logic [7:0]  fill_tag_q;\n  logic [31:0] fill_instr_q;\\\"\\\"\\\")\n  s=s.replace(\\\"      fill_pending_q <= 1'b0;\\\",\\\"      fill_capture_q <= 1'b0;\\\\n      fill_pending_q <= 1'b0;\\\")\n  s=s.replace(\\\"      fill_pending_q <= \"'!sweeping_q && accept_bus && request_in_window && !request_last_word;\",\n              \"      fill_capture_q <= !sweeping_q && accept_bus && request_in_window && !request_last_word;'\"\\\\n      fill_pending_q <= fill_capture_q;\\\")\n  s=s.replace(\\\"\\\"\\\"    fill_index_q <= request_pc[11:2];\n    fill_record_q <= {1'b1, request_pc[19:12], imem_data, pred