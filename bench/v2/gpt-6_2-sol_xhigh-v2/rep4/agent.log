.split(\"\\0\"):\n        if len(entry) < 4:\n            continue\n        path = entry[3:]\n        fp[f\"{label}/{path}\"] = _hash_file(rf / path)\n    return fp\n\n\ndef _toolchain_fingerprint() -> dict[str, str]:\n    fp = {}\n-rw-rw----+ 1 hwebench hwebench 101853 Nov 21 18:17 formal/last_run-ww5Ljsl56.log\n-rw-rw----+ 1 hwebench hwebench 269968 Nov 21 18:16 formal/last_run-wdYk7zbid.log\n-rw-rw----+ 1 hwebench hwebench   1690 Nov 21 18:16 Vtop_classes.mk\n-rwxrwx---+ 1 hwebench hwebench 358016 Nov 21 18:16 div_unit\n-rw-rw----+ 1 hwebench hwebench    937 Nov 21 18:16 verilated.d\n-rw-rw----+ 1 hwebench hwebench 259392 Nov 21 18:16 verilated.o\n-rw-rw----+ 1 hwebench hwebench    937 Nov 21 18:16 verilated_dpi.d\n-rw-rw----+ 1 hwebench hwebench  30872 Nov 21 18:16 verilated_dpi.o\n-rw-rw----+ 1 hwebench hwebench    564 Nov 21 18:16 verilated_threads.d\n-rw-rw----+ 1 hwebench hwebench  57152 Nov 21 18:16 verilated_threads.o\n-rw-rw----+ 1 hwebench hwebench   1024 Nov 21 18:16 verilated_vpi.d\n-rw-rw----+ 1 hwebench hwebench 242864 Nov 21 18:16 verilated_vpi.o\n-rw-rw----+ 1 hwebench hwebench   1037 Nov 21 18:16 verilator.d\n-rw-rw----+ 1 hwebench hwebench  10720 Nov 21 18:16 verilator.o\n","exit_code":0,"status":"completed"}}
