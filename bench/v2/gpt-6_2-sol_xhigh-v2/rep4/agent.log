     auto pc=r.pc>>2;\n      auto hash=(pc''^(pc>>indexbits))&m;\n      if(indexbits==6) hash=((pc>>6)''^pc)&63;\n      int lhidx=(pc''^(pc>>10))&1023;\n      bool adjacent = r.cycle==p.cycle+1;\n      int history=local?lht[lhidx]:(adjacent&&!speculative?oldghr:ghr);\n      auto ix=perbranch?((hash<<historybits)|history)&m:(hash''^history)&m;\n      int cold = (r.insn>>31)?2:1;\n      int dir=pht[ix]==-1?cold:pht[ix];\n      bool t=r.npc!=r.pc+4;\n      if(r.cycle>=lo && bool(dir>>1)!=t) { miss++; miss_pc[r.pc]++; misses_adjacent+=adjacent; }\n      pht[ix]=t?min(3,dir+1):max(0,dir-1);\n      oldghr=ghr;\n      ghr=((ghr<<1)|t)&h;\n      lht[lhidx]=((lht[lhidx]<<1)|t)&h;\n      p=r;\n    }\n    printf(\"miss %7d (%5d adjacent) idx=%2d hist=%2d %s %s'\"\\\\n\\\",miss,misses_adjacent,indexbits,historybits,local?\\\"local\\\":(speculative?\\\"spec-global\\\":\\\"resolved-global\\\"),perbranch?\\\"concat\\\":\\\"xor\\\");\n    if(indexbits==6 && historybits==0){\n      vector<pair<int,int>> sorted;\n      for(auto [pc,n]:miss_pc) sorted.push_back({n,pc});\n      sort(sorted.rbegin(),sorted.rend());\n      for(int i=0;i<20 && i<(int)sorted.size();i++) {auto [n,pc]=sorted[i]; printf(\\\"%05x miss=%d n=%d t=%d\\\\n\\\",pc,n,counts[pc][0],counts[pc][1]);}\n    }\n  };\n  run(6,0,false,false,false);\n  for(int i:{7,8,9,10,11,12}) {\n    run(i,0,false,false,false);\n    for(int h:{2,3,4,5,6,8,9,10,12}) {\n      run(i,h,false,false,false);\n      run(i,h,false,false,true);\n      run(i,h,true,false,false);\n      if(h+4<=i) run(i,h,true,true,false);\n    }\n  }\n}\nCPP\ng++ -O2 -include cstdlib -o analyze analyze.cpp\ncat baseline.jsonl\nread -r start stop < <(python3 -c 'import json; r=json.loads(open(\\\"baseline.jsonl\\\").read().splitlines()[-1]); print(r[\\\"bench_start_cycle\\\"],r[\\\"bench_stop_cycle\\\"])')\n./analyze \\\"\"'$start\" \"$stop\" > analyze.txt\nhead -24 analyze.txt\nrg '\"'idx=' analyze.txt | sort -k2n | head -30\"", "aggregated_output": "{\"order\":2937