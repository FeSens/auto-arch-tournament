]} + {1'b0,b[15:0]};\n  assign add_high = a[31:16] + b[31:16];\n  assign add_sum[31:16] = add_carry ? add_high + 16'd1 : add_high;\n  assign {sub_borrow, difference[15:0]} = {1'b0,a[15:0]} - {1'b0,b[15:0]};\n  assign sub_high = a[31:16] - b[31:16];\n  assign difference[31:16] = sub_borrow ? sub_high - 16'd1 : sub_high;\\\"\\\"\\\")\n    s = s.replace(\\\"out = a - b;\\\", \\\"out = difference;\\\")\np.write_text(s)\np = rtl / \\\"ex_stage.sv\\\"\ns = p.read_text()\ns = s.replace(\\\"  alu u_alu (\\\", \\\"  logic equal, signed_less, unsigned_less;\\\\n  alu u_alu (\\\")\ns = s.replace(\\\"    .add_sum (effective_addr)\\\", \\\"\\\"\\\"    .add_sum (effective_addr),\n    .equal (equal),\n    .unsigned_less (unsigned_less),\n    .signed_less (signed_less)\\\"\\\"\\\")\nif \\\"  logic [7:0] equal_groups;\\\" in s:\n    i = s.index(\\\"  logic [7:0] equal_groups;\\\")\n    j = s.index(\\\"  always_comb begin\\\\n    case (in.ctrl.branch_op\\\", i)\n    s = s[:i] + \\\"  logic selected_condition;\\\\n\\\" + s[j:]\nelse:\n    i = s.index(\\\"  always_comb begin\\\\n    case (in.ctrl.branch_op)\\\")\n    j = s.index(\\\"  assign branch_taken\\\", i)\n    s = s[:i] + \\\"\\\"\\\"  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = equal;\n      BR_BNE:  branch_cond = \"'!equal;\n      BR_BLT:  branch_cond = signed_less;\n      BR_BGE:  branch_cond = !signed_less;\n      BR_BLTU: branch_cond = unsigned_less;\n      BR_BGEU: branch_cond = !unsigned_less;\n      default: branch_cond = 1'\"'b0;\n    endcase\n  end\n\n\\\"\\\"\\\" + s[j:]\np.write_text(s)\nPY\npython3 \\\"\"'$bench_r11/share.py\" \"$bench_r11\" champion shared_cmp 0\npython3 \"$bench_r11/share.py\" \"$bench_r11\" split4 shared_cmp_split 0\npython3 \"$bench_r11/share.py\" \"$bench_r11\" split4 shared_cmp_carry 1\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
