ll_shifted = {remainder_q[SMALL_BITS-1:0], dividend_quotient_q[31:30]};\"\"\")\ns=s.replace(\"\"\"assign multiple[1] = {2'\"'b0, divisor_q};\n  assign multiple[2] = {1'b0, divisor_q, 1'b0};\n  assign multiple[3] = triple_divisor_q;\\\"\\\"\\\", \\\"\\\"\\\"assign multiple[1] = {3'b0, divisor_q};\n  assign multiple[2] = {2'b0, divisor_q, 1'b0};\n  assign multiple[3] = triple_divisor_q;\n  assign multiple[4] = {1'b0, divisor_q, 2'b00};\n  assign multiple[5] = quintuple_divisor_q;\n  assign multiple[6] = triple_divisor_q << 1;\n  assign multiple[7] = septuple_divisor_q;\\\"\\\"\\\")\ns=s.replace(\\\"assign small_candidate[0] = shifted[SMALL_BITS-1:0];\\\",\\\"assign small_candidate[0] = small_shifted[SMALL_BITS-1:0];\\\")\np=s.index(\\\"  for (genvar digit = 1; digit <= 3; digit++) begin : g_trial\\\")\nq=s.index(\\\"  assign small_take\\\", p)\ns=s[:p] + \\\"\\\"\\\"  for (genvar digit = 1; digit <= 3; digit++) begin : g_small_trial\n    /* verilator lint_off UNUSEDSIGNAL */\n    wire [SMALL_TRIAL:0] lo, second;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign low_multiple[digit] = multiple[digit][SMALL_TRIAL-1:0];\n    assign lo = {1'b0, small_shifted} - {1'b0, low_multiple[digit]};\n    assign second = {1'b0, second_shifted} - {1'b0, low_multiple[digit]};\n    assign small_fit[digit] = \"'!lo[SMALL_TRIAL];\n    assign second_fit[digit] = !second[SMALL_TRIAL];\n    assign small_candidate[digit] = lo[SMALL_BITS-1:0];\n    assign second_candidate[digit] = second[SMALL_BITS-1:0];\n  end\n\n  for (genvar digit = 1; digit <= 7; digit++) begin : g_wide_trial\n    /* verilator lint_off UNUSEDSIGNAL */\n    wire [WIDE_TRIAL:0] difference;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign difference = {1'\"'b0, shifted} - {1'b0, multiple[digit]};\n    assign large_fit[digit] = \"'!difference[WIDE_TRIAL];\n    assign large_candidate[digit] = difference[31:0];\n  end\n\n\"\"\" + s[q:]\ns=s.replace(\"~{1'\"'b0, large_fit[3:1]}\\\",\\\"~{1'b0, large_fit[7:1]}\\\")\ns=s.r