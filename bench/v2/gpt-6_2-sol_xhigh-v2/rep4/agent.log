{"type": "item.started", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"cat > \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/coverage.cpp\\\" <<'CPP'\n#include <algorithm>\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <fstream>\n#include <iostream>\n#include <map>\n#include <tuple>\n#include <vector>\n\nstruct Word {\n    unsigned pc, next, insn, trap, store, addr;\n    bool backedge() const {\n        return (insn & 127) == 99 && next < pc && (pc - next) / 4 < 128 && next % 4 == 0 && \"'!trap;\n    }\n};\n\nbool contains(unsigned first, unsigned last, unsigned pc) {\n    return first <= pc && pc <= last;\n}\n\nstruct Trace {\n    unsigned header = 0, tail = 0;\n    unsigned replay_cursor = 0;\n    size_t start_at = 0;\n    bool waiting = false, capturing = false, ready = false, playing = false;\n    std::vector<Word> records;\n    size_t n_hit = 0, n_start = 0, n_mismatch = 0, n_complete = 0;\n    std::map<std::pair<unsigned, unsigned>, size_t> hits;\n    void clear() {\n        waiting = capturing = ready = playing = false;\n        records.clear();\n    }\n    void handle(const Word &w, size_t i, unsigned exe_delay, bool keep_enclosing, bool adapt) {\n        if (w.store && contains(header, tail + 3, w.addr)) clear();\n        if (ready && !playing && i >= start_at && w.pc == header) {\n            playing = true;\n            replay_cursor = 0;\n            ++n_start;\n        }\n        if (playing) {\n            const Word& recorded = records[replay_cursor];\n            if (w.pc == recorded.pc && w.insn == recorded.insn) {\n                ++n_hit;\n                ++hits[{header, tail}];\n                if (w.next == recorded.next) {\n                    replay_cursor = (replay_cursor + 1) % records.size();\n                } else {\n                    ++n_mismatch;\n                    playing = false;\n                    if (adapt && w.pc != tail) clear();\n                }\n            } else {\n                playing = false;\n            }\n        }\n        if (waiting && w.pc == header) {\n            capturing = true;\n            waiting = false;\n        }\n        bool replace = w.backedge() && !capturing && !waiting &&\n                       (!ready || w.next < header || w.pc > tail || (!keep_enclosing && (w.next != header || w.pc != tail)));\n        if (capturing) {\n            if ((w.insn & 127) == 103 || (w.insn & 0x707f) == 0x100f || w.trap || !contains(header, tail, w.pc)\n                || !contains(header, tail, w.next) || records.size() == 128) {\n                clear();\n                replace = w.backedge();\n            } else {\n                records.push_back(w);\n                if (w.pc == tail && w.next == header) {\n                    ++n_complete;\n                    capturing = false;\n                    ready = true;\n                    start_at = i + exe_delay + 1;\n                }\n            }\n        }\n        if (replace) {\n            clear();\n            header = w.next;\n            tail = w.pc;\n            start_at = 0;\n            waiting = true;\n        }\n    }\n};\n\nint main(int argc, char** argv) {\n    std::ifstream input(argv[1]);\n    const int start = atoi(argv[2]);\n    const int stop = atoi(argv[3]);\n    std::map<std::pair<unsigned, unsigned>, size_t> backedges;\n    std::array<Trace, 8> traces;\n    uint32_t first = 1, last = 0;\n    std::array<bool, 128> range_valid{};\n    size_t range_hits=0, i=0;\n    for (std::string line; std::getline(input, line); ) {\n        unsigned cycle;\n        Word w{};\n        if (sscanf(line.c_str(), \"'\"\\\\\\\"cycle\\\\\\\":%u,\\\\\\\"insn\\\\\\\":%u,\\\\\\\"pc_rdata\\\\\\\":%u,\\\\\\\"pc_wdata\\\\\\\":%u,\\\\\\\"mem_addr\\\\\\\":%u,\\\\\\\"mem_wmask\\\\\\\":%u,\\\\\\\"trap\\\\\\\":%u\\\", &cycle,&w.insn,&w.pc,&w.next,&w.addr,&w.store,&w.trap) \"'!= 7) continue;\n        if (cycle < start) continue;\n        if (cycle >= stop) break;\n        ++i;\n        if (w.store && contains(first, last + 3, w.addr)) range_valid.fill(false);\n        if (contains(first,last,w.pc)) {\n            auto &valid = range_valid[(w.pc >> 2) % 128];\n            range_hits += valid;\n            valid = true;\n        }\n        if (w.backedge()) {\n            ++backedges[{w.next, w.pc}];\n            if (w.next < first || w.pc > last) {\n                first = w.next;\n                last = w.pc;\n                range_valid.fill(false);\n            }\n        }\n        for (unsigned j = 0; j < traces.size(); ++j) {\n            traces[j].handle(w, i, j % 2 ? 5 : 0, j / 2 % 2 == 0, j >= 4);\n        }\n    }\n    std::cout << \"total=\" << i << \" range model hits=\" << range_hits << '\"'\\\\n';\n    for (unsigned j = 0; j < traces.size(); ++j) {\n        const auto &t = traces[j];\n        std::cout << \\\"delay=\\\" << (j%2 ? 5 : 0) << \\\" enclose=\\\" << (j/2%2==0) << \\\" adapt=\\\" << (j>=4)\n                  << \\\": hits=\\\" << t.n_hit << \\\" starts=\\\" << t.n_start << \\\" misses=\\\" << t.n_mismatch\n                  << \\\" published=\\\" << t.n_complete << '\\\\n';\n        if (j == 1) for (const auto &[key, count] : t.hits) if (count >= 1000)\n            printf(\\\"  %x -> %x : %zu hits\\\\n\\\", key.first, key.second, count);\n    }\n    for (const auto &[key, count] : backedges) if (count >= 1000)\n        printf(\\\"%x -> %x : %zu taken\\\\n\\\", key.first, key.second, count);\n}\nCPP\nc++ -O2 \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/coverage.cpp\\\" -o \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/coverage\\\" && \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/coverage\\\" \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/trace.csv\\\" 14126 3970230\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
