{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'predictor-scratch'\np = root / 'make_variants.py'\ns = p.read_text().replace(\\\"\\\"\\\"    ('ring5', 5, False, False, True),\n    ('ring4', 4, True, False, True),\n    ('ring6ram', 6, False, True, True),\n    ('ring5wide', 5, False, False, False),\\\"\\\"\\\", \\\"\\\"\\\"    ('ring2', 2, False, False, True),\n    ('ring2wide', 2, False, False, False),\n    ('ring3', 3, False, False, True),\n    ('ring2refill', 2, True, False, True),\\\"\\\"\\\")\n(root / 'make_small.py').write_text(s)\nPY\npython \\\"\"'$TMPDIR/predictor-scratch/make_small.py\"\npython - <<'\"'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'predictor-scratch'\nfor name, source in [('skid1', 'ring2'), ('skid1wide', 'ring2wide')]:\n    d = root / name / 'rtl'\n    shutil.copytree(root / source / 'rtl', d, dirs_exist_ok=True)\n    p = d / 'if_stage.sv'\n    s = p.read_text()\n    start = s.index('  localparam int DEPTH')\n    end = s.index('  // The registered recovery', start)\n    old = s[start:end]\n    payload_parameters = next(line for line in old.splitlines() if 'localparam int PAYLOAD_WIDTH' in line)\n    fetch_payload = next(line for line in old.splitlines() if 'assign fetch_payload' in line)\n    s = s[:start] + f\\\"\\\"\\\"{payload_parameters}\n  logic [PAYLOAD_WIDTH-1:0] fetch_payload, issue_payload, buffer_q;\n  logic [5:0] issue_index;\n  logic buffered_q, buffered, pump, accepted, boundary;\n\n  assign buffered = buffered_q && \"'!recovering_q;\n  assign boundary = pc == 32'\"'h000ffffc && \"'!predict_taken;\n{fetch_payload}\n  assign issue_payload = buffered ? buffer_q : fetch_payload;\n  assign pump = imem_ready && !parked && (!buffered || !stall);\n  assign accepted = pump && (!boundary || (!buffered && !stall));\n\n  always_ff @(posedge clock) begin\n    if (reset) buffered_q <= 1'\"'b0;\n    else buffered_q <= (buffered && stall) || (accepted && (buffered || stall));\n    if (pump && \"'!boundary) buffer_q <= fetch_payload;\n  end\n\n\"\"\" + s[end:]\n    s = s.replace('\"'assign out.valid = \"'!empty ||'\"', 'assign out.valid = buffered ||')\n    p.write_text(s)\nPY\nfor v in ring2 ring2wide ring3 ring2refill skid1 skid1wide; do\n  rtl=\\\"\"'$TMPDIR/predictor-scratch/$v/rtl\"\n  verilator --lint-only -Wall --top-module core -I\"$rtl\" \"$rtl/core_pkg.sv\" \"$rtl\"/*.sv || exit\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
