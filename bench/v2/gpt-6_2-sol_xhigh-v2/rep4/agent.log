{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/fixed-head\"\nmkdir -p \"$scratch/replay-bypass\"\ncp -r \"$scratch/rtl\" \"$scratch/replay-bypass/rtl\"\npython3 - \"$scratch/replay-bypass/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\np = rtl / \\\"if_stage.sv\\\"\ns = p.read_text()\ns = s.replace(\\\"  output logic       bus_valid,\\\", \\\"\\\"\\\"  output logic [4:0] bypass_rs1,\n  output logic [4:0] bypass_rs2,\n  output logic       bypass_valid,\\\"\\\"\\\")\ns = s.replace(\\\"  logic empty, full, accept_replay, enqueue, pop;\\\", \\\"  logic empty, full, bus_valid, accept_replay, enqueue, pop;\\\")\ns = s.replace(\\\"  assign head = empty ? bus_word : front_q;\\\", \\\"\\\"\\\"  assign head = empty ? produced : front_q;\n  assign bypass_rs1 = produced.instr[19:15];\n  assign bypass_rs2 = produced.instr[24:20];\n  assign bypass_valid = bus_valid || accept_replay;\\\"\\\"\\\")\ns = s.replace(\\\"assign out.valid           = \"'!empty || bus_valid;\", \"assign out.valid           = !empty || bypass_valid;\")\ns = s.replace(\"assign enqueue = accept_replay || (accept_bus && (!empty || issue_hold));\", \"assign enqueue = (accept_replay || accept_bus) && (!empty || issue_hold);\")\np.write_text(s)\np = rtl / \"core.sv\"\ns = p.read_text()\ns = s.replace(\"logic       buffered_valid, fetch_bus_valid;\", \"logic       buffered_valid, bypass_valid;\")\ns = s.replace(\"logic [4:0] buffered_rs1, buffered_rs2;\", \"logic [4:0] buffered_rs1, buffered_rs2, bypass_rs1, bypass_rs2;\")\ns = s.replace(\"    .bus_valid       (fetch_bus_valid),'\"\\\\n    .out\\\", \\\"\\\"\\\"    .bypass_rs1      (bypass_rs1),\n    .bypass_rs2      (bypass_rs2),\n    .bypass_valid    (bypass_valid),\n    .out\\\"\\\"\\\")\ns = s.replace(\\\"\\\"\\\"    .bus_rs1         (io_imemData[19:15]),\n    .bus_rs2         (io_imemData[24:20]),\n    .bus_valid       (fetch_bus_valid),\\\"\\\"\\\", \\\"\\\"\\\"    .bus_rs1         (bypass_rs1),\n    .bus_rs2         (bypass_rs2),\n    .bus_valid       (bypass_valid),\\\"\\\"\\\")\np.write_text(s)\nPY\nverilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+\\\"\"'$scratch/replay-bypass/rtl\" \"$scratch/replay-bypass/rtl/core_pkg.sv\" \"$scratch/replay-bypass/rtl/\"*.sv\nRTL_DIR=\"$scratch/replay-bypass/rtl\" OBJ_DIR=\"$scratch/replay-bypass/obj_dir\" NRET=1 bash test/cosim/build.sh > \"$scratch/replay-bypass/verilator.log\" 2>&1\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport json, sys\nfrom tools.eval.fpga import run_coremark_ipc\nbase = Path(sys.argv[1])\nvariant = base / 'replay-bypass'\nr = run_coremark_ipc(str(base), str(variant / 'obj_dir/cosim_sim'))\nprint(json.dumps(r, indent=2))\n(variant / 'coremark.json').write_text(json.dumps(r, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
