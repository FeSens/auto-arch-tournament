{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'work=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\nmake -f bench/programs/Makefile -n bench/programs/selftest.elf bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf | sed \"s#-o bench/programs/#-o $work/#\" | bash -e\npython3 - \"$work\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport sys\nfrom tools.eval.cosim import run_one, run_coremark_crc, TRACE_STALL_MODES\nwork = Path(sys.argv[1])\nbin_name = str(work / 'obj-loop/cosim_sim')\nnames = ('selftest', 'random1', 'random2', 'random3')\nwith ThreadPoolExecutor(max_workers=6) as pool:\n    tasks = [pool.submit(run_one, work / f'{name}.elf', bin_name, '.', sim_flags=flags) for name in names for flags in TRACE_STALL_MODES]\n    tasks.append(pool.submit(run_coremark_crc, work / 'coremark.elf', bin_name, '.'))\n    results = [task.result() for task in tasks]\n    print(*results, sep='\\\\n')\n    sys.exit(any(not r['passed'] for r in results))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
