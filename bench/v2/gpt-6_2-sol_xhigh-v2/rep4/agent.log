FORMAL/cores/$CORE_NAME-$FORMAL_WORK_ID\"\n56:        try=\"$(mktemp -u \"$RISCV_FORMAL/cores/$CORE_NAME-wXXXXXXXX\")\"\n83:CORE_YAML=\"$PROJECT_ROOT/cores/$CORE_NAME/core.yaml\"\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n175:        echo \"@basedir@/cores/@core@/core_pkg.sv\"\n180:        echo \"@basedir@/cores/@core@/$name\"\n182:    echo \"@basedir@/cores/@core@/wrapper.sv\"\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n195:JOBS=\"${JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)}\"\n196:echo \"=== make -j$JOBS -k ===\" | tee -a \"$LOG\"\n202:make -j\"$JOBS\" -k -f makefile 2>&1 \\\n204:    | grep -E \"^(make|SBY|yosys|==|ERROR)\" || true\n216:        # BMC's assumption (rvfi_valid_1=1) is unsatisfiable, and SBY\n","exit_code":0,"status":"completed"}}
