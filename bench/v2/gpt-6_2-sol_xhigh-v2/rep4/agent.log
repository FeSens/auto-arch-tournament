{"type": "item.completed", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/bash -c \"rg -A70 -B15 'async def corrected_fetch_observes_previous_edge_training' cores/bench/test/test_pipeline.py && ls -a cores/bench/test | tail -20\"", "aggregated_output": "    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert rets[4][\"cycle\"] == rets[3][\"cycle\"] + 1\n    assert all(r[\"trap\"] == 0 for r in rets)\n    [unaligned_branch] = _by_insn(rets, program[0x1FFC // 4])\n    assert unaligned_branch[\"pc_next\"] == 0x2000\n    # First prediction uses the old 10, even while 01 is being written.\n    # First training uses 01, so the second visit's untaken outcome brings\n    # 10 back to 01, and the third visit predicts sequential.\n    assert [fetches[i + 1][0] for i, (addr, _) in enumerate(fetches) if addr == 0x2000] == [\n        0x2020, 0x2020, 0x2004,\n    ]\n    assert [r[\"pc_next\"] for r in rets if r[\"pc\"] == 0x2000] == [0x2020, 0x2004, 0x2004]\n\n\n@cocotb.test()\nasync def corrected_fetch_observes_previous_edge_training(dut):\n    # PCs 4 and 0x100 share index 1. The first fetch and issue at 0x100\n    # happen on the cycle immediately after the branch at PC 4 trains it.\n    program = {\n        0: ADDI(3, 0, 2),\n        4: BEQ(0, 0, 0xFC),          # cold forward: 01 -> 10\n        8: SW(3, 0, 0x40),\n        0x100: BEQ(1, 0, 0x20),      # first taken: 10 -> 11\n        0x104: ADDI(2, 2, 1),\n        0x108: BEQ(2, 3, 0x20),\n        0x10C: JAL(0, -0xC),\n        0x120: ADDI(1, 0, 1),\n        0x124: JAL(0, -0x24),\n        0x128: EBREAK(),\n    }\n    fetches, stores = [], []\n    rets, _ = await _run(dut, program, fetch_requests=fetches, store_requests=stores)\n\n    assert fetches[:5] == [(pc, True) for pc in (0, 4, 8, 0x100, 0x120)]\n    # The second visit trains 11 -> 10, so the third still predicts taken.\n    assert [fetches[i + 1][0] for i, (addr, _) in enumerate(fetches) if addr == 0x100] == [0x120] * 3\n   