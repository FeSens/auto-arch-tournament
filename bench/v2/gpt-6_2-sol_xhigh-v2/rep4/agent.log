{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'profile_dir=\"$TMPDIR/predictor-profile\"\ncp -r cores/bench/rtl \"$profile_dir/queue_rtl\"\npython3 - \"$profile_dir/queue_rtl/if_stage.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np = Path(sys.argv[1])\ns = p.read_text()\ns = s.replace('  assign predict_taken = \"'!halfword_offset && (is_jal ||'\"\\\\n                         (is_branch && lookup_counter[1] && direct_target[31:20] == 12\\\\'b0));', \\\"\\\"\\\"  assign predict_taken = \"'!halfword_offset && direct_target[31:20] == 12'\"'b0\n                         && (is_jal || (is_branch && lookup_counter[1]));\\\"\\\"\\\")\ns = s[:s.index('  // A correction')]\ns += \\\"\\\"\\\"  localparam integer DEPTH = \"'`QUEUE_DEPTH;\n  localparam integer COUNT_W = $clog2(DEPTH + 1);\n  typedef struct packed {\n    if_id_t payload;\n    logic [5:0] index;\n  } queued_t;\n\n  queued_t queue_q [0:DEPTH-1];\n  queued_t updated [0:DEPTH-1];\n  queued_t received;\n  logic [COUNT_W-1:0] count_q;\n  logic empty, full, consume_head, bypass, recv, push;\n  logic final_word, final_sequential;\n\n  assign empty = count_q == 0;\n  assign full = count_q == COUNT_W'\"'(DEPTH);\n  assign consume_head = \"'!stall && !empty;\n  assign bypass = !stall && empty;\n  assign final_word = pc == 32'\"'h000f_fffc;\n  assign final_sequential = final_word && \"'!predict_taken;\n  assign recv = imem_ready && !full && (!final_sequential || bypass);\n  assign push = recv && !bypass;\n\n  assign received.index = fetch_index;\n  assign received.payload.pc = pc;\n  assign received.payload.instr = imem_data;\n  assign received.payload.direct_target = direct_target;\n  assign received.payload.predicted_taken = predict_taken;\n  assign received.payload.direction_counter = (train_valid && train_index == fetch_index)\n                                               ? train_counter : lookup_counter;\n  assign received.payload.valid = imem_ready;\n  for (genvar i = 0; i < DEPTH; i++) begin\n    always_comb begin\n      updated[i] = queue_q[i];\n      if (train_valid && train_index == queue_q[i].index) begin\n        updated[i].payload.direction_counter = train_counter;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= '\"'0;\n      count_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count_q <= '0;\n    end else begin\n      if (recv) pc <= predict_taken ? direct_target : sequential_pc;\n      case ({push, consume_head})\n        2'b01: count_q <= count_q - COUNT_W'(1);\n        2'b10: count_q <= count_q + COUNT_W'(1);\n        default: ;\n      endcase\n    end\n  end\n\n  for (genvar i = 0; i < DEPTH; i++) begin\n    if (i < DEPTH - 1) begin\n      always_ff @(posedge clock) begin\n        if (push && count_q == COUNT_W'(i) + COUNT_W'(consume_head))\n          queue_q[i] <= received;\n        else if (consume_head)\n          queue_q[i] <= updated[i+1];\n        else\n          queue_q[i] <= updated[i];\n      end\n    end else begin\n      always_ff @(posedge clock) begin\n        if (push && count_q == COUNT_W'(i) + COUNT_W'(consume_head))\n          queue_q[i] <= received;\n        else\n          queue_q[i] <= updated[i];\n      end\n    end\n  end\n\n  assign imem_addr = pc;\n  assign out = empty ? received.payload : updated[0].payload;\nendmodule\n\\\"\\\"\\\"\np.write_text(s)\nPY\ncat > \\\"\"'$profile_dir/build_queue.sh\" <<'\"'SH'\n#\"'!/usr/bin/env bash\nset -euo pipefail\nprofile_dir=\"$1\"\ndepth=\"$2\"\nsrc=\"$profile_dir/queue_rtl\"\nfiles=(\"$src/core_pkg.sv\")\nfor path in \"$src\"/*.sv; do if [[ \"$path\" != \"$src/core_pkg.sv\" ]]; then files+=(\"$path\"); fi; done\nverilator -DQUEUE_DEPTH=\"$depth\" --cc --exe --build -j 3 -Mdir \"$profile_dir/obj_queue$depth\" \"+incdir+$src\" --top-module core -Wall -Wno-fatal -Wno-style -CFLAGS '\"'-DNRET=1' \\\"\"'${files[@]}\" \"$profile_dir/eval.cpp\" -o queue_sim > \"$profile_dir/build_queue$depth.log\" 2>&1\n\"$profile_dir/obj_queue$depth/queue_sim\" \"$profile_dir/coremark.elf\" 10000000 --bench --istall --dstall > \"$profile_dir/queue$depth.jsonl\"\nSH\ncp test/cosim/main.cpp \"$profile_dir/eval.cpp\"\nfor depth in 1 2 3 4; do bash \"$profile_dir/build_queue.sh\" \"$profile_dir\" \"$depth\" & done\nwait\npython3 - \"$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport json, sys\nroot = Path(sys.argv[1])\nfor p in sorted(root.glob('queue?.jsonl')):\n    r = json.loads(p.read_text().splitlines()[-1])\n    print(p.name, r['bench_stop_cycle']-r['bench_start_cycle'], r['ebreak'], r['oob'], 'Correct operation validated.' in r['uart'])\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
