{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport os\nfrom pathlib import Path\n\nrtl = Path(os.environ['TMPDIR']) / 'predictor-scratch/rtl'\np = rtl / 'if_stage.sv'\ns = p.read_text()\ns = s.replace(\\\"  input  logic              stall,\\\\n\\\", \\\"  input  logic              stall,\\\\n  input  logic              ex_advance,\\\\n\\\")\ns = s.replace('  logic [31:0] pc;', '''  logic [31:0] pc, predicted_pc_q, recovery_pc_q;\n  logic recovering_q, parked_q, parked;\n  assign pc = recovering_q ? recovery_pc_q : predicted_pc_q;\n  assign parked = parked_q && \"'!recovering_q;'\"''')\ns = s.replace('  logic [1:0]  lookup_counter;', '  logic [1:0]  issued_counter;')\ns = s.replace('''  assign lookup_counter = counter_valid[fetch_index] ? direction_table[fetch_index]\n                                                     : {imem_data[31], \"'!imem_data[31]};\n  assign predict_taken = !halfword_offset && (is_jal ||\n                         (is_branch && lookup_counter[1] && direct_target[31:20] == 12'\"'b0));''','''  assign predict_taken = \"'!halfword_offset && direct_target[31:20] == 12'\"'b0 &&\n                         pc[31:20] == 12'b0 &&\n                         (is_jal || (is_branch && (counter_valid[fetch_index]\n                                             ? direction_table[fetch_index][1]\n                                             : imem_data[31])));''')\ns = s.replace('''    else if (train_valid) counter_valid[train_index] <= 1'b1;''', '''    else if (train_valid) counter_valid[train_index] <= 1'b1;''')\ns = s[:s.index('  // A correction from advancing EX')]\ns += '''  localparam int PAYLOAD_WIDTH = 97;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [PAYLOAD_WIDTH-1:0] queue [0:3];\n  logic [PAYLOAD_WIDTH-1:0] fetch_payload, issue_payload, queued_payload;\n  logic [2:0] read_q, write_q, read_ptr, write_ptr;\n  logic [5:0] issue_index;\n  logic empty, full, pop, push, accepted, boundary, boundary_wait;\n  \n  assign read_ptr  = recovering_q ? 3'b0 : read_q;\n  assign write_ptr = recovering_q ? 3'b0 : write_q;\n  assign empty = read_ptr == write_ptr;\n  assign full = read_ptr[1:0] == write_ptr[1:0] && read_ptr[2] \"'!= write_ptr[2];\n  assign boundary = pc == 32'\"'h000ffffc && \"'!predict_taken;\n  assign boundary_wait = boundary && !empty;\n  assign fetch_payload = {pc, imem_data, direct_target, predict_taken};\n  assign queued_payload = queue[read_ptr[1:0]];\n  assign issue_payload = empty ? fetch_payload : queued_payload;\n  assign pop = !empty && !stall;\n  assign accepted = imem_ready && !parked && !boundary_wait &&\n                    (!boundary || !stall) && (!full || pop);\n  assign push = accepted && (!empty || stall);\n  \n  always_ff @(posedge clock) begin\n    if (reset) begin\n      read_q  <= '\"'0;\n      write_q <= '0;\n    end else begin\n      read_q  <= read_ptr + {2'b0, pop};\n      write_q <= write_ptr + {2'b0, push};\n    end\n    if (push) queue[write_ptr[1:0]] <= fetch_payload;\n  end\n\n  // The registered recovery select invalidates the old queue and provides\n  // the corrected fetch address during the first post-squash cycle.\n  always_ff @(posedge clock) begin\n    recovery_pc_q <= redirect_target;\n    if (reset) begin\n      recovering_q   <= 1'b0;\n      parked_q       <= 1'b0;\n      predicted_pc_q <= '0;\n    end else begin\n      recovering_q <= redirect || (parked && ex_advance);\n      parked_q <= parked || (accepted && boundary);\n      if (accepted && \"'!boundary)\n        predicted_pc_q <= predict_taken ? direct_target : sequential_pc;\n      else if (recovering_q)\n        predicted_pc_q <= pc;\n    end\n  end\n\n  assign imem_addr = pc;\n  assign {out.pc, out.instr, out.direct_target, out.predicted_taken} = issue_payload;\n  assign issue_index = out.pc[7:2] ''^ out.pc[13:8];\n  assign issued_counter = counter_valid[issue_index] ? direction_table[issue_index]\n                                                    : {out.instr[31], !out.instr[31]};\n  assign out.direction_counter = (train_valid && train_index == issue_index)\n                                 ? train_counter : issued_counter;\n  assign out.valid = !empty || (imem_ready && !parked);\nendmodule\n'\"'''\n# In the empty boundary case, out.valid stays high on a ready word to\n# avoid feeding stall back into decode validity.\np.write_text(s)\n\np = rtl / 'core.sv'\ns = p.read_text().replace('  logic        redirect;', '  logic        redirect, ex_advance;')\ns = s.replace('    .stall           (stall_if),', '    .stall           (stall_if),\\\\n    .ex_advance      (ex_advance),')\ns = s.replace('    .arithmetic_wait (arithmetic_wait),\\\\n    .redirect', '    .arithmetic_wait (arithmetic_wait),\\\\n    .advance         (ex_advance),\\\\n    .redirect', 1)\np.write_text(s)\n\np = rtl / 'ex_stage.sv'\ns = p.read_text().replace('  output logic               redirect,', '  output logic               advance,\\\\n  output logic               redirect,')\ns = s.replace('  logic transfer_valid, advance;', '  logic transfer_valid;')\np.write_text(s)\nPY\nverilator --lint-only -Wall -Wno-DECLFILENAME --top-module core -I\\\"\"'$TMPDIR/predictor-scratch/rtl\" \"$TMPDIR/predictor-scratch/rtl/core_pkg.sv\" \"$TMPDIR\"/predictor-scratch/rtl/*.sv'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
