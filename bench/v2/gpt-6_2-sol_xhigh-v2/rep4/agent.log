{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r3s0/probe.py\" <<'\"'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nsandbox = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"r3s0\\\"\nrtl = Path(\\\"cores/bench/rtl\\\")\nprobe = sandbox / \\\"retime\\\" / \\\"rtl\\\"\nshutil.copytree(rtl, probe, dirs_exist_ok=True)\n\np = probe / \\\"ex_stage.sv\\\"\ns = p.read_text()\ns = s.replace(\\\"logic        mul_high_instr, mul_start\\\", \\\"logic        mul_instr, mul_high_instr, mul_start\\\")\ns = s.replace(\\\"  assign div_instr =\\\", \\\"  assign mul_instr = mul_high_instr || (in.valid && in.ctrl.alu_op == ALU_MUL);\\\\n  assign div_instr =\\\")\ns = s.replace(\\\"(mul_high_instr && \"'!mul_done)\", \"(mul_instr && !mul_done)\")\ns = s.replace(\"mul_high_instr && mul_ready\", \"mul_instr && mul_ready\")\ns = s.replace(\"mul_high_instr && mul_done\", \"mul_instr && mul_done\")\ns = s.replace(\"(mul_high_instr || div_instr) ? issued\", \"(mul_instr || div_instr) ? issued\")\np.write_text(s)\n\np = probe / \"mul_unit.sv\"\ns = p.read_text()\nstart = s.index(\"  logic        active_q;\")\nstop = s.index(\"`ifdef RISCV_FORMAL_ALTOPS\")\ns = s[:start] + \"\"\"  logic        active_q, high_q;\n  logic        launch, finish, high_ready_q;\n  logic [31:0] a_q, b_q;\n\n  assign ready  = !active_q;\n  assign launch = start && ready;\n  assign finish = active_q && high_q && !high_ready_q;\n  assign done   = active_q && (!high_q || high_ready_q);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      active_q     <= 1'\"'b0;\n      high_ready_q <= 1'b0;\n    end else if (launch) begin\n      active_q     <= 1'b1;\n      high_q       <= op \"'!= ALU_MUL;\n      a_q          <= a;\n      b_q          <= b;\n    end else if (finish) begin\n      high_ready_q <= 1'\"'b1;\n    end else if (done && consume) begin\n      active_q     <= 1'b0;\n      high_ready_q <= 1'b0;\n    end\n  end\n\n\\\"\\\"\\\" + s[stop:]\ni = s.index(\\\"\"'`ifdef RISCV_FORMAL_ALTOPS\")\nj = s.index(\"`else\", i)\ns = s[:i] + \"\"\"`ifdef RISCV_FORMAL_ALTOPS\n  logic [4:0] op_q;\n  logic [31:0] alt_high;\n\n  assign low_result = (a_q + b_q) ''^ 32'\"'h5876063e;\n\n  always_comb begin\n    case (op_q)\n      ALU_MULH:   alt_high = (a_q + b_q) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  alt_high = (a_q + b_q) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: alt_high = (a_q - b_q) \"'^ 32'\"'hecfbe137;\n      default:    alt_high = 32'b0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (launch) op_q <= op;\n    if (finish) high_result <= alt_high;\n  end\n\\\"\\\"\\\" + s[j:]\ns = s.replace(\\\"product    = a * b\\\", \\\"product    = a_q * b_q\\\")\ns = s.replace(\\\"    if (launch) begin\\\\n      unsigned_high_q <= product[63:32];\\\\n      correction_q    <= (a_negative ? b : 32'b0) + (b_negative ? a : 32'b0);\\\\n    end\\\",\\\"    if (launch) correction_q <= (a_negative ? b : 32'b0) + (b_negative ? a : 32'b0);\\\\n    if (finish) unsigned_high_q <= product[63:32];\\\")\ns = s.replace(\\\"assign corrected_high = unsigned_high_q - correction_q;\\\", \\\"assign high_result = unsigned_high_q - correction_q;\\\")\np.write_text(s)\n\np = probe / \\\"div_unit.sv\\\"\ns = p.read_text()\ni = s.index(\\\"  always_comb begin\\\\n    remainder_next\\\")\nj = s.index(\\\"  always_ff @(posedge clock) begin\\\\n    if (launch) begin\\\", i)\ns = s[:i] + \\\"\\\"\\\"  logic [33:0] triple_q;\n  logic [7:0] narrow_remainder;\n  logic [3:0] narrow_quotient;\n\n  // The first feedback iteration has consumed at most eight dividend bits.\n  always_comb begin\n    narrow_remainder = {4'b0, remainder_q[3:0]};\n    narrow_quotient = 4'b0;\n    for (int step = 0; step < 4; step++) begin\n      logic [7:0] prefix;\n      logic [8:0] diff;\n      prefix = {narrow_remainder[6:0], dividend_quotient_q[31-step]};\n      diff = {1'b0, prefix} - {1'b0, divisor_q[7:0]};\n      if (diff[8] || |divisor_q[31:8]