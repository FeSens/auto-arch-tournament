{"type": "item.started", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c \"python - '/srv/hwebench/tmp/58928045/18f4746e/hyp-r7s1-width.NgIuKV/cores/bench/rtl/div_unit.sv' <<'PY'\nfrom pathlib import Path\nimport sys\npath = Path(sys.argv[1])\ns = path.read_text().replace(\\\"consumes four more, then six iterations of two radix-4 steps finish.\\\",\n    \\\"consumes four more, then six width-adaptive radix-4 updates finish.\\\")\nstart = s.index(\\\"  logic [33:0] triple_divisor_q;\\\")\nend = s.index(\\\"  logic [31:0] magnitude;\\\", start)\ns = s[:start] + \\\"\\\"\\\"  localparam int SMALL_BITS = 20;\n  localparam int SHORT_BITS = 32 - SMALL_BITS;\n  localparam int SMALL_TRIAL = SMALL_BITS + 2;\n  localparam int WIDE_TRIAL = 34;\n  localparam int UPPER_TRIAL = WIDE_TRIAL - SMALL_TRIAL;\n  logic [33:0] triple_divisor_q;\n  logic [31:0] dividend_mag;\n  logic        divisor_large, large_q, zero_q;\n  logic [31:0] large_remainder_next, signed_result;\n  logic [SMALL_BITS-1:0] small_remainder_mid, small_remainder_next;\n  logic [1:0]  large_digit, small_digit_hi, small_digit_lo;\n  logic [WIDE_TRIAL-1:0] shifted;\n  logic [SMALL_TRIAL-1:0] low_multiple [1:3];\n  logic [WIDE_TRIAL-1:0] multiple [1:3];\n  logic [3:0] small_fit, large_fit, small_take, large_take;\n  logic [3:0] second_fit, second_take;\n  logic [SMALL_BITS-1:0] small_candidate [0:3], second_candidate [0:3];\n  logic [31:0] large_candidate [0:3];\n  logic [SMALL_TRIAL-1:0] second_shifted;\n\\\"\\\"\\\" + s[end:]\nstart = s.index(\\\"  function automatic logic [33:0] radix4_step\\\")\nend = s.index(\\\"  always_ff @(posedge clock) begin\\\\n    if (prepare_q) begin\\\", start)\ns = s[:start] + \\\"\\\"\\\"  // A divisor of at least 2\"'^20 cannot take any digit while the\n  // longest available dividend prefix is 20 bits.\n  assign dividend_mag = {dividend_prefix, dividend_tail};\n  assign divisor_large = b_negative\n      ? (!(&b_q[31:SMALL_BITS]) || !(|b_q[SMALL_BITS-1:0]))\n      : (|b_q[31:SMALL_BITS]);\n\n  assign shifted = {remainder_q, dividend_quotient_q[31:30]};\n  assign second_shifted = {small_remainder_mid, dividend_quotient_q[29:28]};\n  assign multiple[1] = {2'\"'b0, divisor_q};\n  assign multiple[2] = {1'b0, divisor_q, 1'b0};\n  assign multiple[3] = triple_divisor_q;\n\n  assign small_fit[0] = 1'b1;\n  assign large_fit[0] = 1'b1;\n  assign second_fit[0] = 1'b1;\n  assign small_candidate[0] = shifted[SMALL_BITS-1:0];\n  assign large_candidate[0] = shifted[31:0];\n  assign second_candidate[0] = second_shifted[SMALL_BITS-1:0];\n\n  for (genvar digit = 1; digit <= 3; digit++) begin : g_trial\n    /* verilator lint_off UNUSEDSIGNAL */\n    wire [SMALL_TRIAL:0] lo, second;\n    wire [UPPER_TRIAL:0] hi;\n    wire [UPPER_TRIAL-1:0] corrected_hi;\n    /* verilator lint_on UNUSEDSIGNAL */\n\n    assign low_multiple[digit] = multiple[digit][SMALL_TRIAL-1:0];\n    assign lo = {1'b0, shifted[SMALL_TRIAL-1:0]} - {1'b0, low_multiple[digit]};\n    assign hi = {1'b0, shifted[WIDE_TRIAL-1:SMALL_TRIAL]}\n                - {1'b0, multiple[digit][WIDE_TRIAL-1:SMALL_TRIAL]};\n    assign corrected_hi = hi[UPPER_TRIAL-1:0] - {{(UPPER_TRIAL-1){1'b0}}, lo[SMALL_TRIAL]};\n    assign second = {1'b0, second_shifted} - {1'b0, low_multiple[digit]};\n    assign small_fit[digit] = \"'!lo[SMALL_TRIAL];\n    assign large_fit[digit] = !hi[UPPER_TRIAL] && (!(hi[UPPER_TRIAL-1:0] == 0) || !lo[SMALL_TRIAL]);\n    assign second_fit[digit] = !second[SMALL_TRIAL];\n    assign small_candidate[digit] = lo[SMALL_BITS-1:0];\n    assign large_candidate[digit] = {corrected_hi[31-SMALL_TRIAL:0], lo[SMALL_TRIAL-1:0]};\n    assign second_candidate[digit] = second[SMALL_BITS-1:0];\n  end\n\n  assign small_take = small_fit & ~{1'\"'b0, small_fit[3:1]};\n  assign large_take = large_fit & ~{1'b0, large_fit[3:1]};\n  assign second_take = second_fit & ~{1'b0, second_fit[3:1]};\n  assign small_digit_hi = {(|small_take[3:2]), (small_take[3] || small_take[1])};\n  assign small_digit_lo = {(|second_take[3:2]), (second_take[3] || second_take[1])};\n  assign large_digit = {(|large_take[3:2]), (large_take[3] || large_take[1])};\n\n  always_comb begin\n    small_remainder_mid = '0;\n    small_remainder_next = '0;\n    large_remainder_next = '0;\n    for (int digit = 0; digit <= 3; digit++) begin\n      small_remainder_mid = small_remainder_mid |\n                            ({SMALL_BITS{small_take[digit]}} & small_candidate[digit]);\n      small_remainder_next = small_remainder_next |\n                             ({SMALL_BITS{second_take[digit]}} & second_candidate[digit]);\n      large_remainder_next = large_remainder_next |\n                             ({32{large_take[digit]}} & large_candidate[digit]);\n    end\n  end\n\n\\\"\\\"\\\" + s[end:]\ns = s.replace(\n    \\\"\\\"\\\"      dividend_quotient_q  <= {dividend_tail, divisor_is_small ? seed_quotient : 4'b0};\n      remainder_q          <= {28'b0, divisor_is_small ? seed_remainder : dividend_prefix};\n\\\"\\\"\\\", \\\"\\\"\\\"      if (divisor_large) begin\n        dividend_quotient_q <= {dividend_mag[SHORT_BITS-1:0], {SMALL_BITS{1'b0}}};\n        remainder_q <= {{SHORT_BITS{1'b0}}, dividend_mag[31:SHORT_BITS]};\n      end else begin\n        dividend_quotient_q <= {dividend_tail, divisor_is_small ? seed_quotient : 4'b0};\n        remainder_q <= {28'b0, divisor_is_small ? seed_remainder : dividend_prefix};\n      end\n      large_q              <= divisor_large;\n      zero_q               <= (b_q == 0);\n\\\"\\\"\\\",\n).replace(\n    \\\"\\\"\\\"        dividend_quotient_q <= {dividend_quotient_q[27:0], first_quotient};\n        remainder_q         <= {24'b0, first_remainder};\n      end else begin\n        dividend_quotient_q <= {dividend_quotient_q[27:0], radix_quotient_hi, radix_quotient_lo};\n        remainder_q         <= radix_remainder_next;\n\\\"\\\"\\\",\n    \\\"\\\"\\\"        if (\"'!large_q) begin\n          dividend_quotient_q <= {dividend_quotient_q[27:0], first_quotient};\n          remainder_q         <= {24'\"'b0, first_remainder};\n        end\n      end else if (large_q) begin\n        dividend_quotient_q <= {dividend_quotient_q[29:0], large_digit};\n        remainder_q         <= large_remainder_next;\n      end else begin\n        dividend_quotient_q <= {dividend_quotient_q[27:0], small_digit_hi, small_digit_lo};\n        remainder_q         <= {{SHORT_BITS{1'b0}}, small_remainder_next};\n\\\"\\\"\\\",\n).replace(\\\"  assign result    = negate_q ? -magnitude : magnitude;\\\",\n    \\\"\\\"\\\"  assign signed_result = negate_q ? -magnitude : magnitude;\n  assign result = (zero_q && remainder_op_q) ? a_q : signed_result;\\\"\\\"\\\")\npath.write_text(s)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
