on.successor[9:0];\n  assign read_select = {accept_replay, \"'!accept_replay};\n\"\"\"\n  bankn=2\n else:\n  stem=\"\"\"  assign read_index[0] = keep_or_sequential;\n  assign read_index[1] = branch_low_index;\n  assign read_index[2] = replay_prediction.successor[9:0];\n  assign read_select = {accept_replay, bus_target_step, !(bus_target_step || accept_replay)};\n\"\"\"\n  bankn=3\n s=s.replace(\"  assign fill_successor_word\", stem + \"  assign fill_successor_word\")\n s=s.replace(\"PC_FOR_LOW\", \"request_pc\" if variant == '\"'three_exact' else \\\"predicted_pc_q\\\")\n s=s.replace(\\\"logic [3:0] read_select, read_select_q, collision_q;\\\", f\\\"logic [{bankn-1}:0] read_select, read_select_q, collision_q;\\\")\n s=s.replace(\\\"logic [3:0] bank_hit;\\\", f\\\"logic [{bankn-1}:0] bank_hit;\\\")\n s=s.replace(\\\"read_prediction [0:3]\\\", f\\\"read_prediction [0:{bankn-1}]\\\")\n s=s.replace(\\\"read_index [0:3]\\\", f\\\"read_index [0:{bankn-1}]\\\")\n s=s.replace(\\\"bank < 4\\\", f\\\"bank < {bankn}\\\")\n s=s.replace(\\\"  assign fill_successor_word = predict_taken ? target_word : request_pc[19:2] + 18'd1;\\\", \\\"\\\"\\\"  logic fill_last;\n  assign fill_successor_word = predict_taken ? target_word : request_pc[19:2] + 18'd1;\n  assign fill_last = predict_taken ? (&target_word) : request_pc[19:2] == 18'h3fffe;\\\"\\\"\\\")\n s=s.replace(\\\"fill_successor_index, (&fill_successor_word)\\\", \\\"fill_successor_index, fill_last\\\")\n p.write_text(s)\nPY\nfor variant in two three three_exact\ndo\n (NRET=1 RTL_DIR=\\\"\"'$scratch/$variant/cores/bench/rtl\" OBJ_DIR=\"$scratch/$variant/obj\" bash test/cosim/build.sh > \"$scratch/$variant/verilator.log\" 2>&1 &&\n  \"$scratch/$variant/obj/cosim_sim\" \"$scratch/sliced/bench/programs/coremark.elf\" 10000000 --bench --istall --dstall > \"$scratch/$variant/coremark.log\") &\n (python -m tools.eval.gowin bench --worktree \"$scratch/$variant\" --all-options --paths 4 > \"$scratch/$variant/timing.log\") &\ndone\nwait\nf