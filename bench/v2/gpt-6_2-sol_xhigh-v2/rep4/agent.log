{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"sed -n '90,160p' tools/tournament.py\"","aggregated_output":"    return [\n        f\"hyp-{today}-{(first_seq + s):03d}-r{round_id}s{s}\"\n        for s in range(tournament_size)\n    ]\n\n\ndef pick_winner(entries: list[dict],\n                current_best: float,\n                current_lut: float | None = None,\n                coremark_target: float | None = None,\n                lut_target: float | None = None) -> Optional[dict]:\n    \"\"\"Return the round's winner via the accept-rule module.\n\n    With no targets set, behavior is identical to the legacy \"highest\n    fitness > current_best\" rule. With targets set, accept() is called\n    per-candidate with (perf, lut) tuples.\n\n    Tie-break: among candidates that all pass accept, prefer the one\n    that maximizes (fitness, -lut4, -slot). This degenerates to the\n    legacy \"highest fitness, lowest slot\" tie-break when LUT is\n    unconstrained.\n    \"\"\"\n    from tools.accept_rule import accept\n\n    valid = [e for e in entries\n             if isinstance(e.get(\"fitness\"), (int, float))]\n    if not valid:\n        return None\n\n    old = (current_best, current_lut)\n\n    candidates = []\n    for e in valid:\n        new = (e[\"fitness\"], e.get(\"lut4\"))\n        if accept(old, new,\n                  coremark_target=coremark_target, lut_target=lut_target):\n            candidates.append(e)\n\n    if not candidates:\n        return None\n    # A missing LUT4 ranks worst, never best (0 would win the tie-break).\n    def _lut(e):\n        v = e.get(\"lut4\")\n        return v if isinstance(v, (int, float)) else float(\"inf\")\n    return max(candidates,\n               key=lambda e: (e[\"fitness\"], -_lut(e), -e[\"slot\"]))\n\n\n# Per-phase capacity, per orchestrator process. Both gates are CPU gates:\n#\n# - formal=1: run_all.sh runs `make -j<ncpu>` over ~50-100 SBY tasks. Each\n#   invocation stages into its own formal/riscv-formal/cores/<core>-<pid>/\n#   dir, so concurrent runs no longer corrupt each other, but two at once\n#   halve each one's CPU and push slow SMT problems past the 45-minute\n#   timeout (recorded as broken). Across processes (bench --parallel reps,\n#   two `make loop`s) the same contention is prevented by the machine-wide\n#   lock in phase_gate below.\n#\n# - fpga=1: each slot's run_fpga_eval already forks 3 parallel nextpnr\n#   seeds; N slots x 3 seeds at once would thrash on most hardware.\n#   nextpnr results depend only on the seed, so this is throughput only.\n#\n# Phase 3 (lint/synth/build) and Phase 5 (cosim) are not gated: each\n# worktree has its own generated/ + bench/programs/*.elf + obj_dir/, so no\n# shared-state risk; with N=3 they may CPU-thrash but the round still\n# completes correctly.\nPHASE_CAPACITY: dict[str, int] = {\n    \"formal\": 1,\n    \"fpga\":   1,\n}\n\n","exit_code":0,"status":"completed"}}
