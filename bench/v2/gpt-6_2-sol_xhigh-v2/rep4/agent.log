y;\n+  logic [7:0] stall_sequential_index;\n+  logic [7:0] stall_hint_index [0:STALL_READS-1];\n+  logic [STALL_READS-1:0] stall_match;\n+  logic [31:0] stall_payload_q [0:STALL_READS-1];\n+  logic [31:0] stall_instr;\n+\n+  // The first 256 steps of the PC+8 sweep also clear all stall rows.\n+  // The PC+8 fill regist\n…[7893 of 10965 chars elided by tools/bench/transcript.py; sha256:7986b3954762f996]…\ndiction.target[5:0] ^ replay_prediction.target[11:6];\n     assign successor_index[path] = ({6{step_direct}} & target_index)\n-                                 | ({6{step_sequential}} & sequential_index)\n+                                 | ({6{use_sequential}} & sequential_index)\n                                  | ({6{replay_taken}} & replay_index)\n-                                 | ({6{retain}} & fetch_index[path]);\n+                                 | ({6{use_retain}} & fetch_index[path]);\n     assign successor_in_window[path] = fetch_in_window[path]\n                                     || (step_bus && sequential_carry && (&word_pc[29:18]));\n     assign successor_last_word[path] = fetch_last_word[path] || (step_direct && (&candidate_target[path]))\n                                     || (replay_taken && (|replay_target_last))\n-                                    || (step_sequential && sequential_last);\n+                                    || (use_sequential && sequential_last);\n   end\n \n   always_comb begin\n", "exit_code": 0, "status": "completed"}}
