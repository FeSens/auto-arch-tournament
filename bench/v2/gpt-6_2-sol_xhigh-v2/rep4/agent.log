{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/fixed-head\"\nmkdir -p \"$scratch/shift\"\ncp -r \"$scratch/rtl\" \"$scratch/shift/rtl\"\npython3 - \"$scratch/shift/rtl/if_stage.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np = Path(sys.argv[1])\ns = p.read_text()\ns = s.replace(\\\"  localparam int TAIL_DEPTH = QUEUE_DEPTH - 1;\\\\n  localparam logic [TAIL_DEPTH-1:0] FIRST_TAIL = 4'b0001;\\\\n\\\", \\\"\\\")\nstart = s.index(\\\"  logic [SLOT_WIDTH-1:0] tail_slots_q \\\")\nend = s.index(\\\"  logic step_bus_taken\\\", start)\ns = s[:start] + \\\"\\\"\\\"  logic [SLOT_WIDTH-1:0] slots_q [0:QUEUE_DEPTH-1];\n  fetch_slot_t bus_word, produced, front_q, head;\n  logic [QUEUE_DEPTH-1:0] occupancy_q, occupancy;\n  logic empty, full, accept_replay, accept_input;\n\\\"\\\"\\\" + s[end:]\ns = s.replace(\\\"\\\"\\\"  assign read_ptr    = recovery_pending_q ? FIRST_TAIL : read_ptr_q;\n  assign write_ptr   = recovery_pending_q ? FIRST_TAIL : write_ptr_q;\n\\\"\\\"\\\", \\\"\\\")\nstart = s.index(\\\"  always_comb begin\\\\n    tail_head\\\")\nend = s.index(\\\"  assign head\\\", start)\ns = s[:start] + \\\"  assign front_q = slots_q[0];\\\\n\\\" + s[end:]\ns = s.replace(\\\"\\\"\\\"  assign pop   = \"'!empty && !issue_hold;\n\n\"\"\", \"\")\ns = s.replace(\"  assign enqueue = accept_replay || (accept_bus && (!empty || issue_hold));\", \"  assign accept_input = accept_bus || accept_replay;\")\nstart = s.index(\"  assign tail_present\")\nend = s.index(\"  // Once replay advances\", start)\ns = s[:start] + \"\"\"  for (genvar slot = 0; slot < QUEUE_DEPTH; slot++) begin : gen_slot\n    logic occupied, younger, older, write_hold, write_issue;\n    logic [SLOT_WIDTH-1:0] next_payload;\n\n    assign occupied = occupancy[slot];\n    if (slot == 0) begin : gen_head\n      assign older = 1'\"'b1;\n      assign write_issue = younger || (accept_input && occupied) || (empty && accept_replay);\n    end else begin : gen_tail\n      assign older = occupancy[slot - 1];\n      assign write_issue = younger || (accept_input && occupied);\n    end\n    if (slot == QUEUE_DEPTH - 1) begin : gen_last\n      assign younger = 1'b0;\n      assign next_payload = produced;\n    end else begin : gen_next\n      assign younger = occupancy[slot + 1];\n      assign next_payload = younger ? slots_q[slot + 1] : produced;\n    end\n    assign write_hold = accept_input && older && \"'!occupied;\n\n    always_ff @(posedge clock) begin\n      if (issue_hold ? write_hold : write_issue) slots_q[slot] <= next_payload;\n    end\n  end\n\n  logic [QUEUE_DEPTH-1:0] hold_occupancy, issue_occupancy;\n  assign hold_occupancy = accept_input ? {occupancy[QUEUE_DEPTH-2:0], 1'\"'b1} : occupancy;\n  assign issue_occupancy = accept_input\n                         ? occupancy | {{(QUEUE_DEPTH-1){1'b0}}, accept_replay}\n                         : {1'b0, occupancy[QUEUE_DEPTH-1:1]};\n\n  always_ff @(posedge clock) begin\n    if (reset) occupancy_q <= '0;\n    else occupancy_q <= issue_hold ? hold_occupancy : issue_occupancy;\n  end\n\n\\\"\\\"\\\" + s[end:]\n# Empty replay enqueues, whereas replay concurrent with a queued pop keeps the count.\np.write_text(s)\nPY\nverilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+\\\"\"'$scratch/shift/rtl\" \"$scratch/shift/rtl/core_pkg.sv\" \"$scratch/shift/rtl/\"*.sv\npython3 - \"$scratch/shift\" <<'\"'PY'\nimport json, sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nbase = Path(sys.argv[1])\nres = build_all(Path.cwd(), base / 'rtl', 'fpga/core_bench_si.sv', base / 'timing')\nprint(json.dumps(summarize(res), indent=2))\n(base / 'timing.json').write_text(json.dumps(res, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
