l_q <= (redirect && \"'!ex_direct_taken && !ex_indirect_taken) || load_branch_sequential;'\"')\n    s=s.replace('select_direct_q     <= redirect && ex_direct_taken;',\n                'select_direct_q     <= (redirect && ex_direct_taken) || load_branch_direct;')\n    s=s.replace('recovery_pending_q <= redirect;',\n                'recovery_pending_q <= redirect || load_branch_sequential || load_branch_direct;')\n    p.write_text(s)\n    p=v/'core.sv'\n    s=p.read_text().replace('  logic       ex_redirect, mem_redirect, mem_direct_taken;', '''  logic       ex_redirect, mem_redirect, mem_direct_taken;\n  logic       load_branch_sequential, load_branch_direct;''')\n    s=s.replace('''    .mem_redirect      (mem_redirect),\n    .mem_direct_taken  (mem_direct_taken),''','''    .load_branch_sequential (load_branch_sequential),\n    .load_branch_direct     (load_branch_direct),''')\n    s=s.replace('    .redirect        (ex_redirect),','''    .redirect        (ex_redirect),\n    .load_branch_sequential (load_branch_sequential),\n    .load_branch_direct     (load_branch_direct),''')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/recovery-research/late_select.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" deferselect:1 deferselectmux:1 deferselectzero:1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
