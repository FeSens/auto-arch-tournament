        new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n                dmem[wa] = new\n            else:\n                store_stalls -= 1\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_\n…[6577 of 9649 chars elided by tools/bench/transcript.py; sha256:8cd8c7d86ca097f2]…\n       bench/programs/coremark/core_main.c \\\n        bench/programs/coremark/core_matrix.c \\\n        bench/programs/coremark/core_state.c \\\n        bench/programs/coremark/core_util.c \\\n        bench/programs/coremark/baremetal/core_portme.c \\\n        bench/programs/crt0.S\n\nbench/programs/coremark.elf: $(SRCS)\n\t$(CC) $(CFLAGS) $^ -o $@\n\nbench/programs/selftest.elf: bench/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,170p' formal/wrapper_si.sv && sed -n '1,165p' formal/checks_si.cfg && rg -n 'GOWIN|gws|gw_sh|argparse|def main|seeds|options' tools/eval/gowin.py && rg -n 'random|coremark|cosim' tools/eval/cosim.py\"", "aggregated_output": "// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[5230 of 8302 chars elided by tools/bench/transcript.py; sha256:3fade2f62b78a721]…\nuart', ''), iterations)\n120:        return {'passed': False, 'elf': coremark_elf.name, 'field': 'crc_mismatch',\n122:    return {'passed': True, 'elf': coremark_elf.name}\n125:def run_cosim(worktree: str, target: str | None = None) -> dict:\n130:                cosim_sim from cores/<target>/obj_dir/cosim_sim instead of\n131:                the default test/cosim/obj_dir/cosim_sim, and injects\n143:    obj_dir = Path(env.get(\"OBJ_DIR\", \"test/cosim/obj_dir\"))\n146:    sim_bin = str(obj_dir / \"cosim_sim\")\n148:    # Split ELFs into full-trace cosim vs CRC-validated coremark.\n150:    trace_elfs = [p for p in all_elfs if p.name != \"coremark.elf\"]\n151:    coremark   = next((p for p in all_elfs if p.name == \"coremark.elf\"), None)\n153:    if not trace_elfs and coremark is None:\n156:    # 1. Full-trace cosim of small ELFs (parallel).\n170:    if coremark is not None:\n171:        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n179:    tested = len(trace_elfs) + (1 if coremark else 0)\n184:    result = run_cosim(\n", "exit_code": 0, "status": "completed"}}
