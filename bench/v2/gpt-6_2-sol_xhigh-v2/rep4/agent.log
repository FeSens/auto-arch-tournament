{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('/srv/hwebench/tmp/58928045/2966b888/divider_hyp_execute_boundary/cores/bench/test/test_pipeline.py')\ntext = p.read_text()\nmarker = '@cocotb.test()\\\\nasync def multiply_forwarding_and_latency'\ntest = '''@cocotb.test()\nasync def divide_at_redirect_then_back_to_back_commit(dut):\n    program = [\n        ADDI(1, 0, 28),\n        ADDI(2, 0, 2),\n        JALR(5, 1, 0),\n        ADDI(6, 0, 99),\n        SW(6, 0, 0x40),\n        NOP(),\n        NOP(),\n        DIV(3, 5, 2),\n        DIV(4, 3, 2),\n        SW(4, 0, 0x40),\n        ADD(6, 3, 4),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, store_stalls=3)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 28, 32, 36, 40, 44]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    redirect, first, second, store, consumer = rets[2:7]\n    assert (first[\\\"rs1_rdata\\\"], first[\\\"rd_wdata\\\"]) == (12, 6)\n    assert (second[\\\"rs1_rdata\\\"], second[\\\"rd_wdata\\\"]) == (6, 3)\n    assert first[\\\"cycle\\\"] - redirect[\\\"cycle\\\"] == 10\n    assert second[\\\"cycle\\\"] - first[\\\"cycle\\\"] == 10\n    assert (store[\\\"rs2_rdata\\\"], consumer[\\\"rd_wdata\\\"]) == (3, 9)\n    assert dmem == {0x40: 3}\n\n\n'''\nassert marker in text\np.write_text(text.replace(marker,test+marker))\nPY\npython3 -m pytest -q cores/bench/test/test_pipeline.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
