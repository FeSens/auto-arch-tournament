{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c \"python3 - '/srv/hwebench/tmp/58928045/cbdb4f18/bench-r15s0.YYc3qT' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nscratch = Path(sys.argv[1])\nrepo_rtl = Path('cores/bench/rtl')\nfor name, split_mul in (('reuseadd', False), ('reusemul', True)):\n    rtl = scratch / name / 'rtl'\n    shutil.copytree(repo_rtl, rtl)\n    def edit(name, fn):\n        path = rtl / name\n        path.write_text(fn(path.read_text()))\n    def types(source):\n        source = source.replace('typedef logic [2:0] operand_sel_t;', 'typedef logic [4:0] operand_sel_t;')\n        source = source.replace(\\\"OPERAND_FALLBACK = 3'b001\\\", \\\"OPERAND_FALLBACK = 5'b00001\\\")\n        return source.replace('    logic [31:0] effective_addr;', '''    logic [31:0] effective_addr;\n    logic [31:0] mul_value;\n    logic        sum_result;\n    logic        mul_result;''')\n    def forward(source):\n        source = source.replace('  input  logic       ex_write_eligible,', '''  input  logic       ex_write_eligible,\n  input  logic       ex_use_sum,\n  input  logic       ex_use_mul,''')\n        for reg in ('rs1', 'rs2'):\n            source = source.replace('{' + reg + '_ex,', f'''{{{reg}_ex && ex_use_sum, {reg}_ex && ex_use_mul,\n                      {reg}_ex && \"'!(ex_use_sum || ex_use_mul),'\"''')\n        return source\n    def ex(source):\n        source = source.replace('  input  logic [31:0]        fwd_mem_wb,', '''  input  logic [31:0]        fwd_sum,\n  input  logic [31:0]        fwd_mul,\n  input  logic [31:0]        fwd_mem_wb,''')\n        source = source.replace('  output logic               arithmetic_wait,', '''  output logic               use_sum_for_write,\n  output logic               use_mul_for_write,\n  output logic               arithmetic_wait,''')\n        for reg in ('rs1', 'rs2', 'alu_a', 'alu_b'):\n            source = source.replace(f'assign {reg} = ({{32{{in.{reg}_sel[2]}}}} & fwd_ex_mem)', f'''assign {reg} = ({{32{{in.{reg}_sel[4]}}}} & fwd_sum)\n               | ({{32{{in.{reg}_sel[3]}}}} & fwd_mul)\n               | ({{32{{in.{reg}_sel[2]}}}} & fwd_ex_mem)''')\n        source = source.replace('  alu u_alu (', \\\"  alu #(.EXCLUDE_ADD(1'b1)) u_alu (\\\")\n        source = source.replace('  assign transfer_valid', '''  assign use_sum_for_write = (in.ctrl.alu_op == ALU_ADD) && \"'!in.ctrl.is_jump;\n  assign use_mul_for_write = '\"''' + (\\\"mul_low_instr;\\\" if split_mul else \\\"1'b0;\\\") + '''\n  assign transfer_valid''')\n        if split_mul:\n            source = source.replace('mul_low_instr ? mul_low_result\\\\n                           : ((', '((')\n        return source.replace('      reg_q.effective_addr <= effective_addr;', '''      reg_q.effective_addr <= effective_addr;\n      reg_q.mul_value     <= ''' + (\\\"mul_low_result;\\\" if split_mul else \\\"'0;\\\") + '''\n      reg_q.sum_result    <= use_sum_for_write;\n      reg_q.mul_result    <= use_mul_for_write;''')\n    def core(source):\n        source = source.replace('  logic       load_in_ex;', '  logic       load_in_ex, ex_use_sum, ex_use_mul;')\n        source = source.replace('    .fwd_mem_wb', '''    .fwd_sum         (ex_mem_w.effective_addr),\n    .fwd_mul         (ex_mem_w.mul_value),\n    .use_sum_for_write (ex_use_sum),\n    .use_mul_for_write (ex_use_mul),\n    .fwd_mem_wb''')\n        return source.replace('    .mem_rd', '''    .ex_use_sum         (ex_use_sum),\n    .ex_use_mul         (ex_use_mul),\n    .mem_rd''')\n    def mem(source):\n        return source.replace('    next_wb.write_value = in.ctrl.mem_to_reg ? load_data : in.alu_result;', '''    next_wb.write_value = ({32{in.ctrl.mem_to_reg}} & load_data)\n                        | ({32{\"'!in.ctrl.mem_to_reg && in.sum_result}} & in.effective_addr)\n                        | ({32{!in.ctrl.mem_to_reg && in.mul_result}} & in.mul_value)\n                        | ({32{!(in.ctrl.mem_to_reg || in.sum_result || in.mul_result)}} & in.alu_result);'\"''')\n    edit('core_pkg.sv', types)\n    edit('forward_unit.sv', forward)\n    edit('ex_stage.sv', ex)\n    edit('core.sv', core)\n    edit('mem_stage.sv', mem)\n    edit('alu.sv', lambda source: source.replace('module alu (', \\\"module alu #(parameter bit EXCLUDE_ADD = 1'b0) (\\\")\n         .replace('ALU_ADD:    out = add_sum;', \\\"ALU_ADD:    out = EXCLUDE_ADD ? 32'b0 : add_sum;\\\"))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
