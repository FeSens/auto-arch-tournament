rd(dut):\n    program = [\n        ADDI(5, 0, 29), JAL(5, 2), ADD(6, 5, 5),\n        ADDI(7, 0, 27), JALR(7, 7, 0), ADD(8, 7, 7),\n        ADDI(9, 0, 13), LW(9, 0, 0x41), ADD(10, 9, 9),\n        EBREAK(),\n    ]\n    stores, loads = [], []\n    rets, dmem = await _run(dut, program, {0x40: 0x12345678},\n                            store_requests=stores, load_requests=loads)\n\n    pcs = list(range(0, 4 * len(program), 4))\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets] == [pc + 4 for pc in pcs]\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"insn\"] for r in rets if r[\"trap\"]] == [program[i] for i in (1, 4, 7)]\n    assert loads == stores == []\n    assert dmem == {0x40: 0x12345678}\n    for index, value in ((1, 29), (4, 27), (7, 13)):\n        fault, consumer = rets[index:index + 2]\n        assert (fault[\"rd\"], fault[\"rd_wdata\"]) == (0, 0)\n        assert (fault[\"mem_addr\"], fault[\"mem_rmask\"], fault[\"mem_wmask\"]) == (0, 0, 0)\n        assert (consumer[\"rs1_rdata\"], consumer[\"rs2_rdata\"], consumer[\"rd_wdata\"]) == (\n            value, value, 2 * value,\n        )\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"JALR adds a forwarded base modulo 2^32, clears bit zero, and writes PC+4.\"\"\"\n","exit_code":0,"status":"completed"}}
