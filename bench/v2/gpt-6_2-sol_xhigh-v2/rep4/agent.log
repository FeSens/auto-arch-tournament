{"type": "item.started", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name, seed_variant in (('masked_ex', 'control'), ('masked_ex_retimed', 'retimed')):\n    variant = root / name\n    source = root / seed_variant\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    rtl_dir = variant / 'cores/bench/rtl'\n    path = rtl_dir / 'core_pkg.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace('    logic [11:0] addr_offset;', '    logic [11:0] addr_offset;\\\\n    logic [10:0] alu_mask;')\n    path.write_text(rtl)\n    path = rtl_dir / 'id_stage.sv'\n    rtl = path.read_text().replace('  id_ex_t reg_q;', '''  id_ex_t reg_q;\n  logic [10:0] alu_mask;\n  for (genvar op = 0; op < 11; op++) begin : gen_alu_decode\n    assign alu_mask[op] = \"'!dec_is_jump && (dec_alu_op == 5'\"'(op));\n  end''')\n    rtl = rtl.replace('      reg_q.rd       <=', '      reg_q.alu_mask <= alu_mask;\\\\n      reg_q.rd       <=')\n    path.write_text(rtl)\n    path = rtl_dir / 'alu.sv'\n    path.write_text('''module alu_masked (\n  input  logic [10:0] op_mask,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n  logic [31:0] add_result, sub_result, left_result, right_result, arith_result;\n  logic signed_lt, unsigned_lt;\n  wire [4:0] shamt = b[4:0];\n  assign add_result   = a + b;\n  assign sub_result   = a - b;\n  assign unsigned_lt  = a < b;\n  assign signed_lt    = (a[31] \"'!= b[31]) ? a[31] : unsigned_lt;\n  assign left_result  = a << shamt;\n  assign right_result = a >> shamt;\n  assign arith_result = $unsigned($signed(a) >>> shamt);\n\n  assign out = ({32{op_mask[ALU_ADD]}}  & add_result)\n             | ({32{op_mask[ALU_SUB]}}  & sub_result)\n             | ({32{op_mask[ALU_AND]}}  & (a & b))\n             | ({32{op_mask[ALU_OR]}}   & (a | b))\n             | ({32{op_mask[ALU_XOR]}}  & (a ''^ b))\n             | {31'\"'b0, op_mask[ALU_SLT] & signed_lt}\n             | {31'b0, op_mask[ALU_SLTU] & unsigned_lt}\n             | ({32{op_mask[ALU_SLL]}}  & left_result)\n             | ({32{op_mask[ALU_SRL]}}  & right_result)\n             | ({32{op_mask[ALU_SRA]}}  & arith_result)\n             | ({32{op_mask[ALU_LUI]}}  & b);\nendmodule\n\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n  logic [10:0] op_mask;\n  for (genvar candidate = 0; candidate < 11; candidate++) begin : gen_decode\n    assign op_mask[candidate] = (op == 5'(candidate));\n  end\n\n  alu_masked u_base (.op_mask(op_mask), .a(a), .b(b), .out(out));\nendmodule\n''')\n    path = rtl_dir / 'ex_stage.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace('  alu u_alu (\\\\n    .op  (in.ctrl.alu_op),', '  alu_masked u_alu (\\\\n    .op_mask (in.alu_mask),')\n    rtl = rtl.replace('  logic use_alu_result;','')\n    start = rtl.index('  // The low multiply reaches its')\n    end = rtl.index('  assign transfer_valid',start)\n    rtl = rtl[:start] + rtl[end:]\n    start = rtl.index('      reg_q.alu_result    <= mul_low_instr')\n    end = rtl.index('      reg_q.effective_addr',start)\n    rtl = rtl[:start] + '''      reg_q.alu_result    <= alu_result\n                           | ({32{in.ctrl.is_jump}} & sequential_pc)\n                           | ({32{mul_low_instr}}  & mul_low_result)\n                           | ({32{mul_high_instr}} & mul_high_result)\n                           | ({32{div_instr}}      & div_result);\n''' + rtl[end:]\n    path.write_text(rtl)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(name):\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', 1, variant / 'timing' / 'p1')\n    print(name, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n    list(executor.map(trial, ('masked_ex','masked_ex_retimed')))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
