{"type":"item.completed","item":{"id":"item_40","type":"agent_message","text":"The first recovery split moved the worst path into the ALU, and its clock fell below the champion’s. CoreMark profiling showed that about two-thirds of load-use interlocks feed equality branches. I’m checking whether a branch-only load bypass can recover those cycles within the clock budget."}}
{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/recovery-research/branchload.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])/'recovery-research'\n\ndef new(name,base='cores/bench/rtl'):\n    global variant\n    variant=root/name\n    shutil.copytree(base,variant,dirs_exist_ok=True)\n\ndef replace(file,old,new):\n    p=variant/file\n    s=p.read_text()\n    assert s.count(old)==1,(file,old)\n    p.write_text(s.replace(old,new))\n\ndef bypass(zero, compare):\n    replace('core.sv','  logic       arithmetic_wait;', '''  logic       arithmetic_wait;\n  logic       fast_branch_head;\n  logic [31:0] mem_load_value;\n\n  assign fast_branch_head = if_id_w.instr[6:0] == 7'b1100011\n                         && \"'!if_id_w.instr[14] && !if_id_w.instr[13]'\"''' +\n                         ('''\n                         && (if_id_w.instr[19:15] == 5'd0 || if_id_w.instr[24:20] == 5'd0)''' if zero else '') + ';')\n    replace('core.sv','    .fwd_mem_wb      (mem_wb_w.write_value),','''    .fwd_mem_wb      (mem_wb_w.write_value),\n    .fwd_load_value  (mem_load_value),\n    .ex_mem_is_load  (ex_mem_w.ctrl.mem_read),''')\n    replace('core.sv','    .dmem_ren   (io_dmemREn),','''    .dmem_ren   (io_dmemREn),\n    .load_value (mem_load_value),''')\n    replace('core.sv','    .head_valid      (if_id_w.valid),','''    .head_valid      (if_id_w.valid && \"'!fast_branch_head),'\"''')\n    replace('mem_stage.sv','  output logic               dmem_ren,','''  output logic               dmem_ren,\n  output logic [31:0]        load_value,''')\n    replace('mem_stage.sv','  // ── MEM/WB register','  assign load_value = load_data;\\\\n\\\\n  // ── MEM/WB register')\n    replace('ex_stage.sv','  input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_value (registered)','''  input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_value (registered)\n  input  logic [31:0]        fwd_load_value,\n  input  logic               ex_mem_is_load,''')\n    replace('ex_stage.sv','''  assign write_eligible = in.valid && in.ctrl.reg_write && \"'!in.ctrl.mem_read\n                        && !(in.ctrl.is_jump && target_misaligned);'\"''','''  logic load_misaligned;\n  assign load_misaligned = in.ctrl.mem_read\n                         && ((in.ctrl.mem_width == 2'd2 && jalr_addr_low \"'!= 2'\"'b00)\n                          || (in.ctrl.mem_width == 2'd1 && jalr_addr_low[0]));\n  assign write_eligible = in.valid && in.ctrl.reg_write && \"'!load_misaligned\n                        && !(in.ctrl.is_jump && target_misaligned);'\"''')\n    compare_load = '''  logic loaded_rs1, loaded_rs2, equal_branch, compare_equal;\n  assign equal_branch = in.ctrl.is_branch && \"'!in.ctrl.branch_op[2];\n  assign loaded_rs1 = equal_branch && ex_mem_is_load && in.rs1_sel[2];\n  assign loaded_rs2 = equal_branch && ex_mem_is_load && in.rs2_sel[2];\n'\"'''\n    if zero:\n        compare_load += '''  assign compare_equal = (loaded_rs1 || loaded_rs2) ? (fwd_load_value == 0) : (rs1 == rs2);\n'''\n    elif compare == 'parallel':\n        compare_load += '''  assign compare_equal = (loaded_rs1 && loaded_rs2) ||\n                         (loaded_rs1 && (fwd_load_value == rs2)) ||\n                         (loaded_rs2 && (fwd_load_value == rs1)) ||\n                         (\"'!loaded_rs1 && !loaded_rs2 && (rs1 == rs2));\n'\"'''\n    else:\n        compare_load += '''  assign compare_equal = (loaded_rs1 ? fwd_load_value : rs1)\n                       == (loaded_rs2 ? fwd_load_value : rs2);\n'''\n    replace('ex_stage.sv','  always_comb begin\\\\n    case (in.ctrl.branch_op)',compare_load+'\\\\n  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n    replace('ex_stage.sv','''      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 \"'!= rs2);'\"''','''      BR_BEQ:  branch_cond = compare_equal;\n      BR_BNE:  branch_cond = \"'!compare_equal;'\"''')\n    replace('ex_stage.sv','''      reg_q.rs1_val       <= (mul_high_instr || div_instr) ? issued_rs1_q : rs1;\n      reg_q.rs2_val       <= (mul_high_instr || div_instr) ? issued_rs2_q : rs2;''','''      reg_q.rs1_val       <= (mul_high_instr || div_instr) ? issued_rs1_q\n                          : (loaded_rs1 ? fwd_load_value : rs1);\n      reg_q.rs2_val       <= (mul_high_instr || div_instr) ? issued_rs2_q\n                          : (loaded_rs2 ? fwd_load_value : rs2);''')\n\nnew('bypass')\nbypass(False,'parallel')\nnew('bypassmux')\nbypass(False,'mux')\nnew('bypasszero')\nbypass(True,'parallel')\nPY\npython \\\"\"'$TMPDIR/recovery-research/branchload.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" bypass:1 bypassmux:1 bypasszero:1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
