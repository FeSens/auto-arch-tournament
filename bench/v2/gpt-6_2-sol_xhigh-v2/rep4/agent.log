{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/58928045/2966b888/divider_hyp_check/prototype.py <<'PY'\nfrom pathlib import Path\np = Path(__file__).parent / 'cores/bench/rtl/div_unit.sv'\nrtl = p.read_text()\nstart = rtl.index('  logic        signed_op, remainder_op, first_iteration;')\nseed_start = rtl.index('  // Process the four bits in two pairs.')\nseed_end = rtl.index('  assign first_iteration')\nbase = rtl[:start]\nbase = '// Registered-operand RV32M divider with one wide radix-16 step.\\\\n' + base[base.index('module div_unit'):]\nbase = base.replace('  logic       iterate;', '''  logic       iterate;\n  logic [4:0]  op_q;\n  logic [31:0] a_q, b_q;\n\n  always_ff @(posedge clock) begin\n    if (launch) begin\n      op_q <= op;\n      a_q  <= a;\n      b_q  <= b;\n    end\n  end''')\nbase = base.replace('case (op)', 'case (op_q)').replace('if (launch) alt_result_q <= (a - b)', \\\"if (iterate && cycles_left_q == 3'd7) alt_result_q <= (a_q - b_q)\\\")\nbase += '''  logic signed_op, remainder_op, a_negative, b_negative;\n  logic remainder_op_q, negate_q;\n  logic [31:0] divisor_q, remainder_q, dividend_quotient_q;\n  logic [27:0] dividend_tail;\n  logic [3:0] dividend_prefix, small_divisor, seed_remainder, seed_quotient;\n  logic divisor_is_small;\n  logic [1:0] prefix_hi, remainder_hi, quotient_hi;\n  logic [3:0] prefix_lo;\n  logic [4:0] twice_divisor;\n  logic [5:0] three_divisors;\n  logic [4:0] diff_one, diff_two, diff_three;\n\n  assign signed_op = (op_q == ALU_DIV) || (op_q == ALU_REM);\n  assign remainder_op = (op_q == ALU_REM) || (op_q == ALU_REMU);\n  assign a_negative = signed_op && a_q[31];\n  assign b_negative = signed_op && b_q[31];\n  assign dividend_tail = a_negative ? -a_q[27:0] : a_q[27:0];\n  assign dividend_prefix[3:2] = a_negative ? (~a_q[31:30] + {1'b0, (a_q[29:0] == 30'b0)}) : a_q[31:30];\n  assign dividend_prefix[1:0] = a_negative ? (~a_q[29:28] + {1'b0, (a_q[27:0] == 28'b0)}) : a_q[29:28];\n  assign divisor_is_small = b_negative ? ((&b_q[31:4]) && (|b_q[3:0])) : (b_q[31:4] == 28'b0);\n  assign small_divisor = b_negative ? -b_q[3:0] : b_q[3:0];\n\n'''\nbase += rtl[seed_start:seed_end]\nbase += '''  logic [35:0] multiples [1:15];\n  logic [35:0] multiples_q [1:15];\n  logic [35:0] d;\n  logic [31:0] magnitude;\n  logic [7:0]  short_r;\n  logic [11:0] medium_r;\n  logic [31:0] wide_r;\n  logic [3:0] short_q, medium_q, wide_q;\n\n  assign d = {4'b0, divisor_q};\n  assign multiples[1]  = d;\n  assign multiples[3]  = (d << 1) + d;\n  assign multiples[5]  = (d << 2) + d;\n  assign multiples[7]  = (d << 3) - d;\n  assign multiples[9]  = (d << 3) + d;\n  assign multiples[11] = ((d << 3) \"'^ (d << 1) ''^ d)\n                       + ((((d << 3) & (d << 1)) | ((d << 3) & d) | ((d << 1) & d)) << 1);\n  assign multiples[13] = ((d << 3) ''^ (d << 2) ''^ d)\n                       + ((((d << 3) & (d << 2)) | ((d << 3) & d) | ((d << 2) & d)) << 1);\n  assign multiples[15] = (d << 4) - d;\n\n  for (genvar n = 1; n <= 15; n++) begin : gen_multiples\n    if (n % 2 == 0) begin\n      assign multiples[n] = multiples[n/2] << 1;\n      assign multiples_q[n] = multiples_q[n/2] << 1;\n    end else if (n == 1) begin\n      assign multiples_q[n] = d;\n    end else begin\n      always_ff @(posedge clock)\n        if (iterate && cycles_left_q == 3'\"'d6) multiples_q[n] <= multiples[n];\n    end\n  end\n\n'''\nfor width, name, radicand, multiple, out_width in (\n    (8, 'short', '{remainder_q[3:0], dividend_quotient_q[31:28]}', 'multiples', 8),\n    (12, 'medium', '{short_r, dividend_quotient_q[27:24]}', 'multiples', 12),\n    (36, 'wide', '{remainder_q, dividend_quotient_q[31:28]}', 'multiples_q', 32),\n):\n    upper = f' && ({multiple}[n][35:{width}] == 0)' if width < 36 else ''\n    base += f'''  logic [{width-1}:0] {name}_prefix;\n  logic [16:0] {name}_fits;\n  logic [{width}:0] {name}_difference [0:15];\n  logic [15:0] {name}_take;\n\n  assign {name}_prefix = {radicand};\n  assign {name}_fits[0] = 1'b1;\n  assign {name}_fits[16] = 1'b0;\n  assign {name}_difference[0] = {{1'b0, {name}_prefix}};\n  for (genvar n = 1; n <= 15; n++) begin : gen_{name}\n    assign {name}_difference[n] = {{1'b0, {name}_prefix}} - {{1'b0, {multiple}[n][{width-1}:0]}};\n    assign {name}_fits[n] = \"'!{name}_difference[n][{width}]{upper};\n  end\n  for (genvar n = 0; n <= 15; n++) begin : gen_{name}_take\n    assign {name}_take[n] = {name}_fits[n] && !{name}_fits[n+1];\n  end\n  always_comb begin\n    {name}_r = '\"'0;\n    {name}_q = '0;\n    for (int n = 0; n <= 15; n++) begin\n      {name}_r |= ({{{out_width}{{{name}_take[n]}}}} & {name}_difference[n][{out_width-1}:0]);\n      {name}_q |= ({{4{{{name}_take[n]}}}} & 4'(n));\n    end\n  end\n\n'''\nbase += '''  always_ff @(posedge clock) begin\n    if (iterate) begin\n      case (cycles_left_q)\n        3'd7: begin\n          divisor_q <= b_negative ? -b_q : b_q;\n          dividend_quotient_q <= {dividend_tail, divisor_is_small ? seed_quotient : 4'b0};\n          remainder_q <= {28'b0, divisor_is_small ? seed_remainder : dividend_prefix};\n          remainder_op_q <= remainder_op;\n          negate_q <= remainder_op ? a_negative : ((a_negative \"'^ b_negative) && (b_q != 0));\n        end\n        3'\"'d6: begin\n          dividend_quotient_q <= {dividend_quotient_q[23:0], short_q, medium_q};\n          remainder_q <= {20'b0, medium_r};\n        end\n        default: begin\n          dividend_quotient_q <= {dividend_quotient_q[27:0], wide_q};\n          remainder_q <= wide_r;\n        end\n      endcase\n    end\n  end\n\n  assign magnitude = remainder_op_q ? remainder_q : dividend_quotient_q;\n  assign result = negate_q ? -magnitude : magnitude;\n\"'`endif\nendmodule\n'\"'''\np.write_text(base)\nPY\npython3 /srv/hwebench/tmp/58928045/2966b888/divider_hyp_check/prototype.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
