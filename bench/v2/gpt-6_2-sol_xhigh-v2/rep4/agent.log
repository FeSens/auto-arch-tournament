.index('  // Explicit vectors',start)\n    sv=sv[:start]+sv[end:]\n    sv=sv.replace('assign produced.instr            = bus_valid ? bus_word.instr : selected_replay_prediction.instr;',\n    '''assign produced.instr = ({32{bus_valid}} & bus_word.instr)\n                        | ({32{\"'!bus_valid && (|replay_match)}} & replay_prediction.instr)\n                        | ({32{!bus_valid && !(|replay_match)}} & chain_prediction.instr);'\"''')\n    sv=sv.replace('assign produced.predicted_taken  = bus_valid ? bus_word.predicted_taken : selected_replay_prediction.taken;',\n    '''assign produced.predicted_taken = (bus_valid && bus_word.predicted_taken)\n                                  || (\"'!bus_valid && (|replay_match) && replay_prediction.taken)\n                                  || (!bus_valid && !(|replay_match) && chain_prediction.taken);'\"''')\n    sv=sv.replace('  assign enqueue =', '  assign accept_primary = accept_replay && (|replay_match);\\\\n  assign accept_chain = accept_replay && \"'!(|replay_match);'\"\\\\n  assign enqueue =')\n    sv=sv.replace('({18{accept_replay}}       & ((|replay_match) ? replay_next_word : chain_next_word))',\n        '({18{accept_primary}}      & replay_next_word)\\\\n                            | ({18{accept_chain}}        & chain_next_word)')\n    sv=sv.replace('(accept_replay && selected_replay_last)', '(accept_primary && replay_last_word)\\\\n                            || (accept_chain && chain_last)')\np.write_text(sv)\nPY\nfor variant in chain chainp chainm; do\n  case \\\"\"'$variant\" in\n    chain) args='\"'' ;;\n    chainp) args='parallel' ;;\n    chainm) args='parallel multi' ;;\n  esac\n  python \\\"\"'$TMPDIR/r13-replay/chained.py\" \"$TMPDIR/r13-replay/$variant/rtl\" $args\n  ( NRET=1 RTL_DIR=\"$TMPDIR/r13-replay/$variant/rtl\" OBJ_DIR=\"$TMPDIR/r13-replay/$variant/obj\" bash test/cosim/build.sh > \"$TMPDIR/r13-replay/$variant/build.log\" 2>&1 && \"$TMPDIR/r13-replay/$variant/obj/cosim_sim\" \"$TMPDIR/r13-replay/coremark.elf\" 10000000 --bench --istall --dstall >\"$TMPDIR/r13-replay/$variant/coremark.jsonl\" ) &\ndone\nwait\npython - <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nimport os,json\nfor path in sorted((Path(os.environ['TMPDIR']) / 'r13-replay').glob('chain*/coremark.jsonl')):\n  lines = path.read_text().splitlines()\n  if not lines:\n    continue\n  result=json.loads(lines[-1])\n  print(path.parent.name, result.get('bench_stop_cycle',0)-result.get('bench_start_cycle',0), result.get('ebreak'), result.get('oob'), validate_coremark_uart(result.get('uart',''),10))\nPY\"", "aggregated_output": "chain 3465186 True False (True, None)\nchainm 3465186 True False (True, None)\nchainp 3465186 True False (True, None)\n", "exit_code": 0, "status": "completed"}}
