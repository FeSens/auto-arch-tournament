{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,300p' cores/bench/test/test_div_unit.py && sed -n '1,420p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"RV32M arithmetic, latency and handshake tests for the clocked divider.\"\"\"\nfrom __future__ import annotations\n\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.ready.value == 1 and dut.done.value == 0\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await _tick(dut)\n    dut.start.value = 0\n    assert dut.ready.value == 0 and dut.done.value == 0\n\n\nasync def _check(dut, op, a, b, expected, hold_cycles=0):\n    await _start(dut, op, a, b)\n\n    # Change every input after launch, including requesting another operation\n    # during the calculation and while a result is waiting for consumption.\n    dut.op.value = ALU_DIVU if op != ALU_DIVU else ALU_REM\n    dut.a.value = (a ^ MASK32) & MASK32\n    dut.b.value = (b ^ MASK32) & MASK32\n    dut.start.value = 1\n    for cycle in range(1, 8):\n        await _tick(dut)\n        assert dut.ready.value == 0\n        assert dut.done.value == (cycle == 7), f\"unexpected done on iteration cycle {cycle}\"\n\n    expected &= MASK32\n    for cycle in range(hold_cycles + 1):\n        if cycle:\n            await _tick(dut)\n        assert dut.ready.value == 0 and dut.done.value == 1\n        actual = int(dut.result.value)\n        assert actual == expected, (\n            f\"op={op} a={a & MASK32:#010x} b={b & MASK32:#010x} \"\n            f\"expected={expected:#010x} got={actual:#010x}\"\n        )\n\n    dut.start.value = 0\n    dut.consume.value = 1\n    await _tick(dut)\n    dut.consume.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\n@cocotb.test()\na\n…[18236 of 21308 chars elided by tools/bench/transcript.py; sha256:4517ef2695d5e6aa]…\n 7, 0xFFFFFFFF)\n    assert (mulhu[\"rs1_rdata\"], mulhu[\"rs2_rdata\"], mulhu[\"rd_wdata\"]) == (0xFFFFFFFF, 7, 6)\n    assert consumer[\"rd_wdata\"] == 13\n    assert mul[\"cycle\"] - producer[\"cycle\"] == 1\n    assert mulh[\"cycle\"] - store[\"cycle\"] == 3\n    assert mulhu[\"cycle\"] - mulh[\"cycle\"] == 3\n    assert consumer[\"cycle\"] - mulhu[\"cycle\"] == 1\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\n    cores report rd_addr = instr[11:7] regardless of trap and let the\n    verifier ignore it on trap=1; both are accepted by riscv-formal.\n    Our reference.py and DUT both follow the zeroed-on-trap convention,\n    so cosim stays in lockstep.\"\"\"\n    program = [\n        0xFFFFFFFF,\n        EBREAK(),\n    ]\n", "exit_code": 0, "status": "completed"}}
