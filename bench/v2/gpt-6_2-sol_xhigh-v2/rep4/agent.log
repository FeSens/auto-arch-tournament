{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/58928045/0e90a360/bench-r12s0.WfYhLO' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nscratch = Path(sys.argv[1])\nfor name, source in (('carry', Path('cores/bench/rtl')), ('headcarry', scratch/'cores/bench/rtl')):\n    destination = scratch/name/'rtl'\n    destination.mkdir(parents=True)\n    for file in source.glob('*.sv'):\n        shutil.copyfile(file, destination/file.name)\n    path = destination / 'if_stage.sv'\n    sv = path.read_text()\n    old = \\\"  assign {target_carry, target_word} = {1'b0, request_pc[19:2]} + {1'b0, word_offset};\\\"\n    new = \\\"\\\"\\\"  logic [6:0] target_low, target_middle, target_high;\n  logic [5:0] target_middle_cin, target_high_cin;\n  logic middle_propagates, high_propagates;\n  logic carry_middle;\n  assign target_low = {1'b0, request_pc[7:2]} + {1'b0, word_offset[5:0]};\n  assign target_middle = {1'b0, request_pc[13:8]} + {1'b0, word_offset[11:6]};\n  assign target_high = {1'b0, request_pc[19:14]} + {1'b0, word_offset[17:12]};\n  assign middle_propagates = &(request_pc[13:8] \"'^ word_offset[11:6]);\n  assign high_propagates = &(request_pc[19:14] ''^ word_offset[17:12]);\n  assign carry_middle = target_middle[6] || (middle_propagates && target_low[6]);\n  assign target_carry = target_high[6]\n                      || (high_propagates && target_middle[6])\n                      || (high_propagates && middle_propagates && target_low[6]);\n  assign target_middle_cin = request_pc[13:8] + word_offset[11:6] + 6'\"'d1;\n  assign target_high_cin = request_pc[19:14] + word_offset[17:12] + 6'd1;\n  assign target_word = {carry_middle ? target_high_cin : target_high[5:0],\n                        target_low[6] ? target_middle_cin : target_middle[5:0],\n                        target_low[5:0]};\\\"\\\"\\\"\n    assert old in sv\n    path.write_text(sv.replace(old, new))\nPY\npython - '/srv/hwebenc