k_ibuf', 'cpu/u_if', 'cpu/u_hazard', 'cpu/u_id', 'cpu/u_if']}}\nbypass {'placement_failed': False, 'fmax_mhz': 70.462, 'seeds': [71.534, 70.462, 70.462], 'perturbations': [[0, 71.534, 13], [1, 70.462, 13], [2, 70.462, 13]], 'lut4': 4625, 'ff': 1881, 'lutram': 40, 'bsram': 9, 'dsp': 9, 'logic_levels': 13, 'critical_path': {'from': 'cpu/u_if/predicted_pc_q_11_s0', 'to': 'cpu/u_id/reg_q.alu_b_base_21_s0', 'slack_ns': -8.979, 'arrival_ns': 19.277, 'logic_cells': 19, 'modules': ['clock_ibuf', 'cpu/u_if', 'cpu/u_rf', 'cpu/u_id']}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c 'cat >\"$TMPDIR/hyp_profile/seq_fast_proto.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport shutil\nscratch=Path(os.environ['TMPDIR'])/'hyp_profile'\nfor version, src in [('seq32_fast', 'seq32'), ('seq32_head_fast','seq32_head')]:\n    dst=scratch/version/'rtl'\n    shutil.copytree(scratch/src/'rtl',dst,dirs_exist_ok=True)\n    p=dst/'if_stage.sv'\n    s=p.read_text()\n    s=s.replace('  logic step_bus_taken, step_bus_sequential, step_outside_window;',\n      '  logic step_bus_taken, step_outside_window;\\\\n  logic select_bus_target, select_bus_linear, select_replay_next, select_park_pc;')\n    s=s.replace('  logic wait_for_recovery_word, retain_request;', '  logic wait_for_recovery_word;')\n    s=s.replace('  assign step_bus_sequential = accept_bus && \"'!predict_taken && !request_last_word;'\"\\\\n','')\n    s=s.replace('  assign retain_request = park || wait_for_recovery_word;', '''  // Select a candidate whenever its source is eligible. The producer's\n  // write enable separately checks whether any word was accepted.\n  assign select_bus_target = bus_valid && predict_taken;\n  assign select_bus_linear = bus_valid && \"'!predict_taken && !request_last_word;\n  assign select_replay_next = !bus_valid && !recovery_pending_q;\n  assign select_park_pc = request_last_word || wait_for_recovery_word;'\"''')\n    s=s.replace('''({18{step_bus_taken}}      & target_word)\n                            | ({18{step_bus_sequential}} & sequential_word)\n                            | ({18{accept_replay}}       & replay_next_word)\n                            | ({18{retain_request}}      & request_pc[19:2])''',\n    '''({18{select_bus_target}}  & target_word)\n                            | ({18{select_bus_linear}}  & sequential_word)\n                            | ({18{select_replay_next}} & replay_next_word)\n                            | ({18{select_park_pc}}     & reques