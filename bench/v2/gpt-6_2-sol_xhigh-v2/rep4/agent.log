{1'b0, prefix} - {1'b0, divisor_triple};\n\n    if      (!trial_three[34]) radix4_step = {trial_three[31:0], 2'd3};\n    else if (!trial_two[34])   radix4_step = {trial_two[31:0], 2'd2};\n    else if (!trial_one[34])   radix4_step = {trial_one[31:0], 2'd1};\n    else                      radix4_step = {prefix[31:0], 2'd0};\n  endfunction\n\n  assign {remainder_mid, full_digits[3:2]} =\n      radix4_step({remainder_q, dividend_quotient_q[31:30]}, divisor_q, divisor_triple_q);\n  assign {full_remainder, full_digits[1:0]} =\n      radix4_step({remainder_mid, dividend_quotient_q[29:28]}, divisor_q, divisor_triple_q);\n\n  always_ff @(posedge clock) begin\n    if (launch) begin\n      divisor_q            <= b_negative ? -b : b;\n      // A divisor of at least 16 cannot subtract from a four-bit prefix.\n      dividend_quotient_q  <= {dividend_tail, divisor_is_small ? seed_quotient : 4'b0};\n      remainder_q          <= {28'b0, divisor_is_small ? seed_remainder : dividend_prefix};\n      remainder_op_q       <= remainder_op;\n      // A zero divisor yields all quotient bits set and leaves the\n      // dividend magnitude in the remainder. Sign-correct only the remainder.\n      negate_q             <= remainder_op ? a_negative : ((a_negative ^ b_negative) && (b != 0));\n    end else if (iterate && cycles_left_q == 3'd7) begin\n      divisor_triple_q <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\n      if (|divisor_q[31:8]) begin\n        dividend_quotient_q <= {dividend_quotient_q[27:0], 4'b0};\n        remainder_q         <= {24'b0, remainder_q[3:0], dividend_quotient_q[31:28]};\n      end else begin\n        dividend_quotient_q <= {dividend_quotient_q[27:0], narrow_digits};\n        remainder_q         <= {24'b0, narrow_remainder};\n      end\n    end else if (iterate) begin\n      dividend_quotient_q <= {dividend_quotient_q[27:0], full_digits};\n      remainder_q         <= full_remainder;\n    end\n  end\n\n  // For INT_MIN / -1 the positive quotient magnitude is a