{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"cat >> cores/bench/test/test_pipeline.py <<'PY'\n\n\n@cocotb.test()\nasync def registered_source_priority_and_trapped_link(dut):\n    first_add = ADD(6, 5, 5)\n    second_add = ADD(7, 5, 5)\n    trapped_link = JALR(5, 5, 1)\n    program = [\n        ADDI(5, 0, 9), ADDI(5, 0, 6), first_add,\n        ADDI(5, 0, 1), trapped_link, second_add, EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [first] = _by_insn(rets, first_add)\n    [link] = _by_insn(rets, trapped_link)\n    [second] = _by_insn(rets, second_add)\n    assert (first[\\\"rs1_rdata\\\"], first[\\\"rs2_rdata\\\"], first[\\\"rd_wdata\\\"]) == (6, 6, 12)\n    assert link[\\\"trap\\\"] == 1 and link[\\\"rd\\\"] == 0 and link[\\\"rs1_rdata\\\"] == 1\n    assert (second[\\\"rs1_rdata\\\"], second[\\\"rs2_rdata\\\"], second[\\\"rd_wdata\\\"]) == (1, 1, 2)\n\n\n@cocotb.test()\nasync def registered_source_after_a_misaligned_load(dut):\n    bad_load = LW(5, 0, 2)\n    consumer = ADDI(6, 5, 5)\n    program = [ADDI(5, 0, 7), bad_load, consumer, EBREAK()]\n    reads = []\n    rets, _ = await _run(dut, program, dmem_init={0: 0xffffffff}, load_requests=reads)\n    [load] = _by_insn(rets, bad_load)\n    [result] = _by_insn(rets, consumer)\n    assert load[\\\"trap\\\"] == 1 and load[\\\"rd\\\"] == 0 and not reads\n    assert (result[\\\"rs1_rdata\\\"], result[\\\"rs2_rdata\\\"], result[\\\"rd_wdata\\\"]) == (7, 7, 12)\n\n\n@cocotb.test()\nasync def registered_load_bypass_survives_a_stalled_store(dut):\n    load = LW(5, 0, 0)\n    store = SW(0, 0, 8)\n    consumer = ADD(6, 5, 5)\n    requests = []\n    rets, _ = await _run(dut, [load, store, consumer, EBREAK()],\n                         dmem_init={0: 11}, store_stalls=4, store_requests=requests)\n    [result] = _by_insn(rets, consumer)\n    assert (result[\\\"rs1_rdata\\\"], result[\\\"rs2_rdata\\\"], result[\\\"rd_wdata\\\"]) == (11, 11, 22)\n    assert [ready for