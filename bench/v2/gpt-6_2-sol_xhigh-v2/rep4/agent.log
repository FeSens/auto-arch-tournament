{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name, seed_variant in (('id_mem_forward', 'control'), ('id_mem_forward_retimed', 'retimed')):\n    variant = root / name\n    source = root / seed_variant\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    rtl_dir = variant / 'cores/bench/rtl'\n    path = rtl_dir / 'core_pkg.sv'\n    rtl = path.read_text()\n    for field in ('rs1', 'rs2', 'alu_a', 'alu_b'):\n        rtl = rtl.replace(f'operand_sel_t {field}_sel;', f'logic        {field}_sel;')\n    path.write_text(rtl)\n    path = rtl_dir / 'mem_stage.sv'\n    rtl = path.read_text().replace('  output mem_wb_t  divide_commit,','  output logic [31:0] bypass_data,\\\\n  output mem_wb_t  divide_commit,')\n    rtl = rtl.replace('  // A divide holds EX', '  assign bypass_data = next_wb.write_value;\\\\n\\\\n  // A divide holds EX')\n    path.write_text(rtl)\n    path = rtl_dir / 'id_stage.sv'\n    rtl = path.read_text().replace('  input  operand_sel_t      rs1_sel,', '  input  logic [31:0]       bypass_data,\\\\n  input  operand_sel_t      rs1_sel,')\n    rtl = rtl.replace('  id_ex_t reg_q;', '''  id_ex_t reg_q;\n  logic [31:0] captured_rs1, captured_rs2;\n  assign captured_rs1 = rs1_sel[1] ? bypass_data : rs1_data;\n  assign captured_rs2 = rs2_sel[1] ? bypass_data : rs2_data;''')\n    rtl = rtl.replace('<= rs1_data;', '<= captured_rs1;').replace('<= rs2_data;', '<= captured_rs2;')\n    rtl = rtl.replace('<= rs1_sel;', '<= rs1_sel[2];').replace('<= rs2_sel;', '<= rs2_sel[2];')\n    rtl = rtl.replace('dec_is_auipc ? OPERAND_FALLBACK : rs1_sel', '\"'!dec_is_auipc && rs1_sel[2]'\"')\n    rtl = rtl.replace('dec_alu_src  ? OPERAND_FALLBACK : rs2_sel', '\"'!dec_alu_src && rs2_sel[2]'\"')\n    rtl = rtl.replace('in.pc : rs1_data;', 'in.pc : captured_rs1;')\n    rtl = rtl.replace('imm   : rs2_data;', 'imm   : captured_rs2;')\n    path.write_text(rtl)\n    path = rtl_dir / 'ex_stage.sv'\n    rtl = path.read_text().replace('  input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_value (registered)\\\\n', '')\n    start = rtl.index('  assign rs1 =')\n    end = rtl.index('  logic [31:0] alu_result',start)\n    rtl = rtl[:start] + '''  assign rs1   = in.rs1_sel   ? fwd_ex_mem : in.rs1_val;\n  assign rs2   = in.rs2_sel   ? fwd_ex_mem : in.rs2_val;\n  assign alu_a = in.alu_a_sel ? fwd_ex_mem : in.alu_a_base;\n  assign alu_b = in.alu_b_sel ? fwd_ex_mem : in.alu_b_base;\n\n''' + rtl[end:]\n    path.write_text(rtl)\n    path = rtl_dir / 'core.sv'\n    rtl = path.read_text().replace('  logic [31:0] rs2_data_w;', '  logic [31:0] rs2_data_w;\\\\n  logic [31:0] mem_bypass_data;')\n    rtl = rtl.replace('    .rs1_sel  (rs1_sel),','    .bypass_data (mem_bypass_data),\\\\n    .rs1_sel  (rs1_sel),')\n    rtl = rtl.replace('    .fwd_mem_wb      (mem_wb_w.write_value),\\\\n', '')\n    rtl = rtl.replace('    .divide_commit  (divide_commit),','    .bypass_data    (mem_bypass_data),\\\\n    .divide_commit  (divide_commit),')\n    path.write_text(rtl)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(name):\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', 1, variant / 'timing' / 'p1')\n    print(name, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n    list(executor.map(trial, ('id_mem_forward','id_mem_forward_retimed')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name, base_variant in (('training', 'control'), ('training_recovery', 'recovery_retimed')):\n    variant = root / name\n    source = root / base_variant\n    shutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n    rtl_dir = variant / 'cores/bench/rtl'\n    path = rtl_dir / 'ex_stage.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace('  output logic               train_negative', '  output logic               train_misaligned,\\\\n  output logic               train_negative')\n    rtl = rtl.replace('assign train_valid = advance && in.ctrl.is_branch && \"'!in.ctrl.is_illegal'\"\\\\n                     && \"'!(branch_taken && in.direct_offset[1]);'\"',\n                      'assign train_valid = advance && in.ctrl.is_branch && \"'!in.ctrl.is_illegal;'\"\\\\n  assign train_misaligned = in.direct_offset[1];')\n    rtl = rtl.replace('assign train_taken = branch_taken;', 'assign train_taken = branch_cond;')\n    path.write_text(rtl)\n    path = rtl_dir / 'core.sv'\n    rtl = path.read_text()\n    rtl = rtl.replace('logic        train_valid, train_taken, train_negative;', 'logic        train_valid, train_taken, train_negative, train_misaligned;')\n    rtl = rtl.replace('    .train_negative', '    .train_misaligned (train_misaligned),\\\\n    .train_negative')\n    path.write_text(rtl)\n    path = rtl_dir / 'if_stage.sv'\n    rtl = path.read_text().replace('  input  logic              train_negative,', '  input  logic              train_negative,\\\\n  input  logic              train_misaligned,')\n    rtl = rtl.replace('  logic [1:0]