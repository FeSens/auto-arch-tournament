{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predictor-scratch/make_variants.py\" <<'\"'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'predictor-scratch'\nbaseline = Path('cores/bench/rtl')\nfor variant, depth, refill, use_ram, compact in [\n    ('ring5', 5, False, False, True),\n    ('ring4', 4, True, False, True),\n    ('ring6ram', 6, False, True, True),\n    ('ring5wide', 5, False, False, False),\n]:\n    rtl = root / variant / 'rtl'\n    rtl.mkdir(parents=True, exist_ok=True)\n    for src in baseline.glob('*.sv'):\n        shutil.copyfile(src, rtl / src.name)\n    s = (root / 'rtl/if_stage.sv').read_text()\n    s = s.replace(\\\"  input  logic [31:0]       redirect_target,\\\",\n                  \\\"\\\"\\\"  input  logic [31:0]       ex_sequential_pc,\n  input  logic [31:0]       ex_direct_target,\n  input  logic [31:0]       resolved_jalr_target,\n  input  logic              ex_direct_taken,\n  input  logic              ex_indirect_taken,\\\"\\\"\\\")\n    s = s.replace(\\\"\\\"\\\"  logic [31:0] pc, predicted_pc_q, recovery_pc_q;\n  logic recovering_q, parked_q, parked;\n  assign pc = recovering_q ? recovery_pc_q : predicted_pc_q;\\\"\\\"\\\",\n                  \\\"\\\"\\\"  logic [31:0] pc, predicted_pc_q, recovery_seq_pc_q, recovery_direct_pc_q;\n  logic recovering_q, recovery_direct_q, recovery_indirect_q;\n  logic parked_q, parked, recover;\n  assign pc = ({32{\"'!recovering_q}} & predicted_pc_q)\n            | ({32{ recovering_q && !recovery_direct_q && !recovery_indirect_q}} & recovery_seq_pc_q)\n            | ({32{ recovering_q && recovery_direct_q}} & recovery_direct_pc_q)\n            | ({32{ recovering_q && recovery_indirect_q}} & resolved_jalr_target);\"\"\")\n    s = s.replace('\"'  logic [1:0]  issued_counter;', '''  logic [63:0] direction_valid_q;\n  logic direction_msb [0:63];\n  logic [1:0]  issued_counter;\n  logic [31:0] issued_pc, issued_insn;\n  logic issued_taken;''')\n    s = s.replace('counter_valid[fetch_index]\\\\n                                             ? direction_table[fetch_index][1]',\n                  'direction_valid_q[fetch_index]\\\\n                                             ? direction_msb[fetch_index]')\n    s = s.replace(\\\"  always_ff @(posedge clock) begin\\\\n    if (reset) counter_valid\\\", \\\"\\\"\\\"  always_ff @(posedge clock) begin\n    if (reset) direction_valid_q <= '0;\n    else if (train_valid) direction_valid_q[train_index] <= 1'b1;\n    if (train_valid) direction_msb[train_index] <= train_counter[1];\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) counter_valid\\\"\\\"\\\")\n    if compact:\n        s = s.replace('  logic [18:0] word_offset;', '  logic [18:0] word_offset, target_word;')\n        s = s.replace('  logic        halfword_offset, low_carry;', '  logic        halfword_offset;')\n        s = s.replace('  logic [18:0] target_low;\\\\n  logic [10:0] pc_high, pc_high_inc, pc_high_dec, target_high;\\\\n', '')\n        start = s.index('  // The fetch PC is word aligned.')\n        end = s.index('  logic [5:0]  fetch_index;', start)\n        s = s[:start] + \\\"\\\"\\\"  assign target_word = {1'b0, pc[19:2]} + word_offset;\n  assign direct_target = {12'b0, target_word[17:0], 2'b00};\n\n\\\"\\\"\\\" + s[end:]\n        s = s.replace(\\\"direct_target[31:20] == 12'b0\\\", \\\"\"'!target_word[18]\")\n    start = s.index('\"'  localparam int PAYLOAD_WIDTH')\n    end = s.index('  // The registered recovery', start)\n    packed_fields = 'pc[31:2], imem_data, predict_taken'\n    unpacked_fields = 'issued_pc[31:2], issued_insn, issued_taken'\n    if not compact:\n        s = s.replace('  logic issued_taken;', '  logic issued_taken;\\\\n  logic [31:0] issued_direct;')\n        packed_fields += ', direct_target'\n        unpacked_fields += ', issued_direct'\n    s = s[:start] + f\\\"\\\"\\\"  localparam int DEPTH = {depth};\n  localparam int PAYLOAD_WIDTH = {63 if compact else 95};\n  logic [PAYLOAD_WIDTH-1:0] fetch_payload, issue_payload, queued_payload;\n  logic [DEPTH-1:0] reader_q, writer_q, reader, writer, count_q, count;\n  logic [5:0] issue_index;\n  logic empty, full, pop, push, pump, accepted, boundary;\n\n  assign reader = recovering_q ? {depth}'b1 : reader_q;\n  assign writer = recovering_q ? {depth}'b1 : writer_q;\n  assign count = recovering_q ? '0 : count_q;\n  assign empty = \"'!count[0];\n  assign full = count[DEPTH-1];\n  assign boundary = pc == 32'\"'h000ffffc && \"'!predict_taken;\n  assign fetch_payload = {{{packed_fields}}};\n  assign issue_payload = empty ? fetch_payload : queued_payload;\n  assign pop = !empty && !stall;\n  assign pump = imem_ready && !parked && ({'\"'\"'!full || pop'\"' if refill else '\"'!full'\"'});\n  assign accepted = pump && (\"'!boundary || (empty && !stall));\n  assign push = accepted && (!empty || stall);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reader_q <= {depth}'\"'b1;\n      writer_q <= {depth}'b1;\n      count_q <= '0;\n    end else begin\n      reader_q <= pop ? {{reader[DEPTH-2:0], reader[DEPTH-1]}} : reader;\n      writer_q <= push ? {{writer[DEPTH-2:0], writer[DEPTH-1]}} : writer;\n      case ({{push, pop}})\n        2'b10: count_q <= {{count[DEPTH-2:0], 1'b1}};\n        2'b01: count_q <= {{1'b0, count[DEPTH-1:1]}};\n        default: count_q <= count;\n      endcase\n    end\n  end\n\n\\\"\\\"\\\" + s[end:]\n    if use_ram:\n        s = s.replace('  // The registered recovery', '''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [PAYLOAD_WIDTH-1:0] queue [0:DEPTH-1];\n  logic [\"'$clog2(DEPTH)-1:0] raddr, waddr;\n  always_comb begin\n    raddr = '\"'0;\n    waddr = '0;\n    for (int slot = 0; slot < DEPTH; slot++) begin\n      if (reader[slot]) raddr = \"'$clog2(DEPTH)'\"'(slot);\n      if (writer[slot]) waddr = \"'$clog2(DEPTH)'\"'(slot);\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (pump && \"'!boundary) queue[waddr] <= fetch_payload;\n  end\n  assign queued_payload = queue[raddr];\n\n  // The registered recovery'\"''')\n    else:\n        s = s.replace('  // The registered recovery', '''  logic [PAYLOAD_WIDTH-1:0] selected_word [0:DEPTH-1];\n  for (genvar slot = 0; slot < DEPTH; slot++) begin : gen_queue\n    logic [PAYLOAD_WIDTH-1:0] payload_q;\n    always_ff @(posedge clock) begin\n      if (pump && \"'!boundary && writer[slot]) payload_q <= fetch_payload;\n    end\n    assign selected_word[slot] = payload_q & {PAYLOAD_WIDTH{reader[slot]}};\n  end\n  always_comb begin\n    queued_payload = '\"'0;\n    for (int slot = 0; slot < DEPTH; slot++) begin\n      queued_payload = queued_payload | selected_word[slot];\n    end\n  end\n\n  // The registered recovery''')\n    s = s.replace('  always_ff @(posedge clock) begin\\\\n    recovery_pc_q <= redirect_target;',\n                  '''  assign recover = redirect || (parked && ex_advance);\n  always_ff @(posedge clock) begin\n    recovery_seq_pc_q <= ex_sequential_pc;\n    recovery_direct_pc_q <= ex_direct_target;\n    recovery_direct_q <= ex_direct_taken;\n    recovery_indirect_q <= ex_indirect_taken;''')\n    s = s.replace('recovering_q <= redirect || (parked && ex_advance);', 'recovering_q <= recover;')\n    s = s.replace('if (accepted && \"'!boundary)'\"', 'if (pump && \"'!boundary)'\"')\n    s = s.replace('assign {out.pc, out.instr, out.direct_target, out.predicted_taken} = issue_payload;',\n                  f'''assign {{{unpacked_fields}}} = issue_payload;\n  assign issued_pc[1:0] = 2'b00;\n  assign out.pc = issued_pc;\n  assign out.instr = issued_insn;\n  assign out.predicted_taken = issued_taken;'''\n                  + ('' if compact else '\\\\n  assign out.direct_target = issued_direct;'))\n    s = s.replace('assign issue_index = out.pc[7:2] \"'^ out.pc[13:8];'\"',\n                  'assign issue_index = issued_pc[7:2] \"'^ issued_pc[13:8];'\"')\n    s = s.replace('{out.instr[31], \"'!out.instr[31]}'\"', '{issued_insn[31], \"'!issued_insn[31]}'\"')\n    (rtl / 'if_stage.sv').write_text(s)\n    s = (root / 'rtl/ex_stage.sv').read_text()\n    s = s.replace('  output logic [31:0]        redirect_target,', '''  output logic [31:0]        sequential_pc,\n  output logic [31:0]        direct_target,\n  output logic               direct_taken,\n  output logic               indirect_taken,''')\n    s = s.replace('  logic        transfer_taken, actual_taken, direct_taken, indirect_taken;\\\\n  logic [31:0] sequential_pc;', '''  logic        transfer_taken, actual_taken;\n  logic [31:0] redirect_target;''')\n    s = s.replace('  assign sequential_pc  = in.pc + 32\\\\'d4;', '''  assign sequential_pc  = in.pc + 32'd4;\n  assign direct_target  = ''' + (\\\"{in.pc[31:2] + in.imm[31:2], in.imm[1], 1'b0};\\\" if compact else 'in.direct_target;'))\n    s = s.replace('effective_addr[1] : in.direct_target[1]', 'effective_addr[1] : direct_target[1]')\n    s = s.replace('& in.direct_target)', '& direct_target)').replace('<= in.direct_target;', '<= direct_target;')\n    (rtl / 'ex_stage.sv').write_text(s)\n    s = (root / 'rtl/core.sv').read_text()\n    s = s.replace('  logic [31:0] redirect_target;', '''  logic [31:0] ex_sequential_pc, ex_direct_target;\n  logic ex_direct_taken, ex_indirect_taken;''')\n    s = s.replace('    .redirect_target (redirect_target),', '''    .ex_sequential_pc (ex_sequential_pc),\n    .ex_direct_target (ex_direct_target),\n    .resolved_jalr_target ({ex_mem_w.effective_addr[31:1], 1'b0}),\n    .ex_direct_taken (ex_direct_taken),\n    .ex_indirect_taken (ex_indirect_taken),''', 1)\n    s = s.replace('    .redirect_target (redirect_target),', '''    .sequential_pc   (ex_sequential_pc),\n    .direct_target   (ex_direct_target),\n    .direct_taken    (ex_direct_taken),\n    .indirect_taken  (ex_indirect_taken),''', 1)\n    (rtl / 'core.sv').write_text(s)\n    if compact:\n        for fname in ('core_pkg.sv','id_stage.sv'):\n            p = rtl / fname\n            p.write_text(''.join(line for line in p.read_text().splitlines(keepends=True) if 'direct_target' not in line))\nPY\npython \\\"\"'$TMPDIR/predictor-scratch/make_variants.py\"\nfor design in ring5 ring4 ring6ram ring5wide; do\n  rtl=\"$TMPDIR/predictor-scratch/$design/rtl\"\n  verilator --lint-only -Wall --top-module core -I\"$rtl\" \"$rtl/core_pkg.sv\" \"$rtl\"/*.sv || exit\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
