ssert dut.ready.value == 0 and dut.done.value == 1\n        actual = int(dut.result.value)\n        assert actual == expected, (\n            f\"op={op} a={a & MASK32:#010x} b={b & MASK32:#010x} \"\n            f\"expected={expected:#010x} got={actual:#010x}\"\n        )\n\n    dut.start.value = 0\n    dut.consume.value = 1\n    await _tick(dut)\n    dut.consume.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\n@cocotb.test()\na\n…[8557 of 11629 chars elided by tools/bench/transcript.py; sha256:fc43a42cbf659678]…\n-+  1 nobody nogroup   3684 Nov 21 16:02 selftest.S\n\nformal:\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Nov 21 16:02 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 21 16:02 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 21 16:02 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 21 16:02 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 21 16:02 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    66 Nov 21 16:02 riscv-formal -> /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep4/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 21 16:02 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 21 16:02 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 21 16:02 wrapper_si.sv\n\ntest:\ntotal 32\ndrwxrwx---+  3 nobody nogroup 4096 Nov 21 16:02 .\ndrwxrwx---+ 12 nobody nogroup 4096 Nov 21 16:02 ..\n-rw-rw----+  1 nobody nogroup    0 Nov 21 16:02 .gitkeep\n-rw-rw----+  1 nobody nogroup 2297 Nov 21 16:02 _helpers.py\n-rw-rw----+  1 nobody nogroup  361 Nov 21 16:02 conftest.py\ndrwxrwx---+  2 nobody nogroup 4096 Nov 21 16:02 cosim\n", "exit_code": 0, "status": "completed"}}
