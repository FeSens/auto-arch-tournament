he check.\n  logic jalr_misaligned;\n  logic [1:0] jalr_offset;\n  assign jalr_offset = in.addr_offset[1:0];\n\n  assign jalr_misaligned = jalr_offset[1] \"'^\n       ((in.rs1_sel[2] && (fwd_ex_mem[1] ''^ (fwd_ex_mem[0] && jalr_offset[0])))\n     || (in.rs1_sel[1] && (fwd_mem_wb[1] ''^ (fwd_mem_wb[0] && jalr_offset[0])))\n     || (in.rs1_sel[0] && (in.rs1_val[1] ''^ (in.rs1_val[0] && jalr_offset[0]))));\n\n'\"''' + s[high:]\ns = s.replace('  logic        transfer_taken, actual_taken;', '  logic        transfer_taken, actual_taken, direct_taken, indirect_taken;')\ns = s.replace('jalr_addr_low[1]', 'jalr_misaligned')\ns = s.replace('  assign redirect        = advance && (in.last_mapped_word || (in.predicted_taken \"'!= actual_taken));'\"', '''  // Each recovery class is independently qualified and captured.\n  // The fetch predictor never predicts an indirect transfer as taken.\n  assign recover_direct = advance && direct_taken\n                        && (in.last_mapped_word || \"'!in.predicted_taken);\n  assign recover_indirect = advance && indirect_taken;\n  assign recover_sequential = advance && !direct_taken && !indirect_taken\n                            && (in.last_mapped_word || in.predicted_taken);'\"''')\np.write_text(s)\n\np = root / 'if_stage.sv'\ns = p.read_text()\ns = s.replace('  input  logic              redirect,         // advancing EX correction\\\\n  input  logic              ex_direct_taken,\\\\n  input  logic              ex_indirect_taken,', '''  input  logic              recover_sequential,\n  input  logic              recover_direct,\n  input  logic              recover_indirect,''')\ns = s.replace('select_sequential_q <= redirect && \"'!ex_direct_taken && !ex_indirect_taken;'\"', 'select_sequential_q <= recover_sequential;')\ns = s.replace('select_direct_q     <= redirect && ex_direct_taken;', 'select_direct_q     <= recover_direct;')\ns = s.replace('select_indirect_q   <= redirect && ex_indirect_taken;', 'select_indirect_q   <= recover_indirect;')\ns = s.replace('recovery_pending_q <= redirect;', 'recovery_pending_q <= recover_sequential || recover_direct || recover_indirect;')\np.write_text(s)\nPY\npython -m tools.eval.gowin bench --worktree \\\"\"'$trial_dir\" --all-options --paths 8 > \"$trial_dir/timing.log\" 2>&1'", "aggregated_output": "", "exit_code": 0, "status": "completed"}}
