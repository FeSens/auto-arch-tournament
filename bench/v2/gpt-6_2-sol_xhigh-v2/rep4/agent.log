{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nfor name in ('signed_seed','split_negate'):\n    variant = root / name\n    shutil.copytree(root / 'control/cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\n    shutil.copytree(root / 'control/fpga', variant / 'fpga', dirs_exist_ok=True)\n    shutil.copy2(root / 'control/cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\n\ndef change(path, replacements):\n    rtl = path.read_text()\n    for old,new in replacements.items():\n        assert rtl.count(old) == 1, old\n        rtl = rtl.replace(old,new)\n    path.write_text(rtl)\n\nrtl = root / 'signed_seed/cores/bench/rtl'\nchange(rtl / 'div_seed_rom.sv', {\n    'output logic [12:0] seed': 'output logic [12:0] seed,\\\\n  output logic [12:0] neg_seed_bits',\n    'logic [12:0] seeds [0:1023];': 'logic [25:0] seeds [0:1023];',\n    \\\"seeds[addr_index] = 13'((1 << 23) / (1025 + addr_index));\\\":\n        \\\"seeds[addr_index] = {13'(-((1 << 23) / (1025 + addr_index))),\\\\n                           13'((1 << 23) / (1025 + addr_index))};\\\",\n    'if (read_en) seed <= seeds[addr];': 'if (read_en) {neg_seed_bits, seed} <= seeds[addr];',\n})\nchange(rtl / 'div_unit.sv', {\n    'logic [12:0] seed;': 'logic [12:0] seed, neg_seed_bits;',\n    '.seed    (seed)': '.seed    (seed),\\\\n    .neg_seed_bits (neg_seed_bits)',\n    'assign negated_divisor_product = -(normalized_q * seed);':\n        \\\"assign negated_divisor_product = \"'$signed({1'\"'b0, normalized_q}) * \"'$signed({1'\"'b1, neg_seed_bits});\\\",\n})\nrtl = root / 'split_negate/cores/bench/rtl'\nchange(rtl / 'div_unit.sv', {\n    'logic [34:0] negated_divisor_product;':\n        'logic [34:0] divisor_product;\\\\n  logic [24:0] deficit;',\n    'assign negated_divisor_product = -(normalized_q * seed);':\n        '''assign divisor_product = normalized_q * seed;\n  assign deficit[7:0]   = ~divisor_product[17:10] + {7'b0, divisor_product[9:0] == '0};\n  assign deficit[15:8]  = ~divisor_product[25:18] + {7'b0, divisor_product[17:0] == '0};\n  assign deficit[24:16] = ~divisor_product[34:26] + {8'b0, divisor_product[25:0] == '0};''',\n    'e0_q <= negated_divisor_product[34:10];': 'e0_q <= deficit;',\n})\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\ndef trial(task):\n    name, option = task\n    variant = root / name\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', option, variant / 'timing' / f'p{option}')\n    print(name, option, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    list(executor.map(trial, [(name,option) for name in ('signed_seed','split_negate') for option in (0,1)]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed'\nvariant = root / 'word_slices'\nsource = root / 'split_negate'\nshutil.copytree(source / 'cores/bench/rtl', variant / 'cores/bench/rtl', dirs_exist_ok=True)\nshutil.copytree(source / 'fpga', variant / 'fpga', dirs_exist_ok=True)\nshutil.copy2(source / 'cores/bench/core.yaml', variant / 'cores/bench/core.yaml')\npath = variant / 'cores/bench/rtl/alu.sv'\nrtl = path.read_text()\nrtl = rtl.replace('  always_comb begin', '''  logic [15:0] add_lo, add_hi0, add_hi1;\n  logic [15:0] sub_lo, sub_hi0, sub_hi1;\n  logic add_carry, sub_borrow;\n  logic [16:0] add_hi_biased, sub_hi_biased;\n\n  assign {add_carry, add_lo} = {1'b0, a[15:0]} + {1'b0, b[15:0]};\n  assign add_hi0 = a[31:16] + b[31:16];\n  assign add_hi_biased = {a[31:16], 1'b1} + {b[31:16], 1'b1};\n  assign add_hi1 = add_hi_biased[16:1];\n  assign {sub_borrow, sub_lo} = {1'b0, a[15:0]} - {1'b0, b[15:0]};\n  assign sub_hi0 = a[31:16] - b[31:16];\n  assign sub_hi_biased = {a[31:16], 1'b0} - {b[31:16], 1'b1};\n  assign sub_hi1 = sub_hi_biased[16:1];\n\n  always_comb begin''')\nrtl=rtl.replace('ALU_ADD:    out = a + b;', 'ALU_ADD:    out = {add_carry ? add_hi1 : add_hi0, add_lo};')\nrtl=rtl.replace('ALU_SUB:    out = a - b;', 'ALU_SUB:    out = {sub_borrow ? sub_hi1 : sub_hi0, sub_lo};')\npath.write_text(rtl)\npath = variant / 'cores/bench/rtl/ex_stage.sv'\nrtl = path.read_text()\nleft = rtl.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nright = rtl.index('\\\\n  assign branch_taken', left)\nrtl = rtl[:left] + '''  logic [3:0] byte_eq, byte_lt;\n  logic words_equal, unsigned_less, signed_less;\n\n  for (genvar byte_index = 0; byte_index < 4; byte_index++) begin : gen_compare\n    assign byte_eq[byte_index] = rs1[8*byte_index +: 8] == rs2[8*byte_index +: 8];\n    assign byte_lt[byte_index] = rs1[8*byte_index +: 8] < rs2[8*byte_index +: 8];\n  end\n  assign words_equal = &byte_eq;\n  assign unsigned_less = byte_lt[3]\n                      || (byte_eq[3] && byte_lt[2])\n                      || ((&byte_eq[3:2]) && byte_lt[1])\n                      || ((&byte_eq[3:1]) && byte_lt[0]);\n  assign signed_less = (rs1[31] \"'!= rs2[31]) ? rs1[31] : unsigned_less;\n  assign branch_cond = (in.ctrl.branch_op[2]\n       ? (in.ctrl.branch_op[1] ? unsigned_less : signed_less)\n       : words_equal) ''^ in.ctrl.branch_op[0];\n'\"''' + rtl[right:]\npath.write_text(rtl)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nfrom tools.eval.gowin import build\nvariant = Path(os.environ['TMPDIR']) / 'bench-r9s0-seed/word_slices'\ndef trial(option):\n    res = build(variant, variant / 'cores/bench/rtl', 'fpga/core_bench_si.sv', option, variant / 'timing' / f'p{option}')\n    print(option, res['fmax_mhz'], res.get('reason'), res.get('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n    list(executor.map(trial, (0,1)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
