arithmetic_wait;\n  logic       late_m_ex, late_m_mem, mul_high_mem, div_mem;\n  logic       mul_done, mul_ready, div_done, div_consume;\n  logic       uses_rs1, uses_rs2;\n  logic [31:0] mul_low, mul_high, div_result, m_result;\n\n  function automatic logic is_high_mul(input logic [4:0] op);\n    is_high_mul = (op == ALU_MULH || op == ALU_MULHSU || op == ALU_MULHU);\n  endfunction\n\n  function automatic logic is_div(input logic [4:0] op);\n    is_div = (op == ALU_DIV || op == ALU_DIVU || op == ALU_REM || op == ALU_REMU);\n  endfunction\n\n  assign late_m_ex = id_ex_w.ctrl.alu_op == ALU_MUL ||\n                     is_high_mul(id_ex_w.ctrl.alu_op) || is_div(id_ex_w.ctrl.alu_op);\n  assign mul_high_mem = ex_mem_w.valid && is_high_mul(ex_mem_w.ctrl.alu_op);\n  assign div_mem = ex_mem_w.valid && is_div(ex_mem_w.ctrl.alu_op);\n  assign late_m_mem = (ex_mem_w.valid && ex_mem_w.ctrl.alu_op == ALU_MUL) ||\n                      mul_high_mem || div_mem;\n  assign arithmetic_wait = (mul_high_mem && \"'!mul_done) || (div_mem && !div_done);\n  assign m_result = div_mem ? div_result : mul_high_mem ? mul_high : mul_low;\n  assign div_consume = div_mem && div_done;\n\n  always_comb begin\n    uses_rs1 = 1'\"'b0;\n    uses_rs2 = 1'b0;\n    case (if_id_w.instr[6:0])\n      7'b0110011, 7'b0100011, 7'b1100011: begin\n        uses_rs1 = 1'b1;\n        uses_rs2 = 1'b1;\n      end\n      7'b0000011, 7'b0010011, 7'b1100111: uses_rs1 = 1'b1;\n      default: ;\n    endcase\n  end\n\n  mul_unit u_mul (\n    .clock       (clock),\n    .reset       (reset),\n    .start       (mul_high_mem && mul_ready),\n    .consume     (mul_high_mem && mul_done),\n    .op          (ex_mem_w.ctrl.alu_op),\n    .a           (ex_mem_w.rs1_val),\n    .b           (ex_mem_w.rs2_val),\n    .ready       (mul_ready),\n    .done        (mul_done),\n    .low_result  (mul_low),\n    .high_result (mul_high)\n  );\\\"\\\"\\\"),\n    (\\\"    .arithmetic_wait (arithmetic_wait),\\\\n    .redirect\\\", \\\"\\\"\\\"    .div_consume     (div_consume),\n    .div_done        (div_done),\n    .div_result      (div_result),\n    .redirect\\\"\\\"\\\"),\n    (\\\"    .hold_wb    (hold_mem_wb),\\\", \\\"\\\"\\\"    .hold_wb    (hold_mem_wb),\n    .late_m     (late_m_mem),\n    .m_result   (m_result),\\\"\\\"\\\"),\n    (\\\"    .id_ex_mem_read  (id_ex_w.ctrl.mem_read),\\\", \\\"\\\"\\\"    .id_ex_mem_read  (id_ex_w.ctrl.mem_read),\n    .id_ex_late_m    (late_m_ex),\n    .if_id_uses_rs1  (uses_rs1),\n    .if_id_uses_rs2  (uses_rs2),\\\"\\\"\\\"),\n    (\\\"(ex_mem_w.ctrl.reg_write),\\\", \\\"(ex_mem_w.ctrl.reg_write && \"'!late_m_mem),\"),\n])\nPY\nmake lint TARGET=bench'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
