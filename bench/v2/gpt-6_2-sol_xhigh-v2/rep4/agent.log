{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"python3 - '/srv/hwebench/tmp/58928045/39c9f928/bench-predictor.kwJcyq' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nscratch = Path(sys.argv[1])\nrtl = scratch / 'rtl_32'\nshutil.copytree('cores/bench/rtl', rtl)\n\ndef replace(name, before, after):\n    path = rtl / name\n    text = path.read_text()\n    assert text.count(before) == 1, (name, before)\n    path.write_text(text.replace(before, after))\n\nname = 'ex_stage.sv'\nreplace(name, '''  output logic               redirect,\n  output logic [31:0]        redirect_target''', '''  output logic               resolved_taken,\n  output logic               resolved_trap,\n  output logic [31:0]        resolved_next_pc''')\nreplace(name, '''  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;'\"''', '''  assign resolved_taken   = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign resolved_trap    = ctrl_with_trap.is_illegal;\n  assign resolved_next_pc = resolved_taken\n                          ? (in.ctrl.is_jump ? jump_target : branch_target)\n                          : in.pc + 32'\"'d4;''')\nreplace(name, '''      reg_q.pc_next       <= misalign_fault     ? (in.pc + 32'd4)\n                            : in.ctrl.is_jump   ? jump_target\n                            : branch_taken      ? branch_target\n                                                : (in.pc + 32'd4);''', '''      reg_q.pc_next       <= resolved_next_pc;''')\n\nname = 'core.sv'\nreplace(name, '''  logic [31:0] redirect_target;''', '''  logic [31:0] resolved_next_pc;\n  logic        resolved_taken, resolved_trap;\n  logic        ex_advance, train_valid;\n\n  assign ex_advance = id_ex_w.valid && \"'!stall_ex_mem;\n  assign redirect = ex_advance && resolved_next_pc != io_imemAddr;\n  assign train_valid = ex_advance