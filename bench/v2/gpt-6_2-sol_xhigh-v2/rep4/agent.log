{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"cat > \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/replay.hpp\\\" <<'CPP'\n#include <array>\n#include <optional>\n#include <limits>\n\nstruct Record {\n    uint32_t pc;\n    uint32_t word;\n    uint32_t next;\n    bool taken;\n    bool trap;\n};\n\nstruct Replay {\n    struct Entry {\n        unsigned header = 0;\n        unsigned tail = 0;\n        unsigned length = 0;\n        uint64_t touched = 0;\n        uint64_t published = 0;\n        std::array<Record, 128> records{};\n        bool valid = false;\n    };\n    std::array<Entry, 4> entries{};\n    std::optional<Record> pending;\n    int owner = -1;\n    int writer = -1;\n    unsigned cursor = 0;\n    uint64_t covered = 0;\n    uint64_t stalled_covered = 0;\n    uint64_t starts = 0;\n    uint64_t squashes = 0;\n    uint64_t published = 0;\n    unsigned publish_delay = 0;\n\n    static bool fence(const Record &record) {\n        return (record.word & 0x707fu) == 0x100fu;\n    }\n    void invalidate(int index) {\n        entries[index].valid = false;\n        if (index == owner) owner = -1;\n        if (index == writer) writer = -1;\n    }\n    void invalidate_store(unsigned addr) {\n        for (int i = 0; i < int(entries.size()); ++i) {\n            const auto &entry = entries[i];\n            if ((entry.valid || i == writer) && addr >= entry.header && addr <= entry.tail + 3)\n                invalidate(i);\n        }\n    }\n    const Record* use(uint32_t pc, uint32_t word) {\n        if (owner == -1) return nullptr;\n        const auto &record = entries[owner].records[cursor];\n        if (record.pc == pc && record.word == word) return &record;\n        owner = -1;\n        return nullptr;\n    }\n    void admit(uint64_t cycle, uint32_t pc, uint32_t word, bool stalled, bool corrected) {\n        if (owner \"'!= -1) {\n            ++covered;\n            stalled_covered += stalled;\n            if (++cursor == entries[owner].length) cursor = 0;\n            return;\n        }\n        if (corrected) return;\n        for (int i = 0; i < int(entries.size()); ++i) {\n            auto &entry = entries[i];\n            if (entry.valid && entry.header == pc && entry.records[0].word == word\n                && cycle > entry.published + publish_delay) {\n                owner = i;\n                cursor = 1;\n                entry.touched = cycle;\n                ++starts;\n                return;\n            }\n        }\n    }\n    void train(const Record &record, uint64_t cycle) {\n        if (fence(record)) {\n            for (int i = 0; i < int(entries.size()); ++i) invalidate(i);\n            return;\n        }\n        const unsigned opcode = record.word & 0x7fu;\n        if (writer != -1) {\n            auto &entry = entries[writer];\n            const bool header = entry.length == 0;\n            const bool unsafe = record.trap || opcode == 103u\n                || record.pc < entry.header || record.pc > entry.tail\n                || record.next < entry.header || record.next > entry.tail\n                || entry.length == 128\n                || (header && (record.pc != entry.header || opcode == 99u || opcode == 111u));\n            if (unsafe) {\n                invalidate(writer);\n            } else {\n                entry.records[entry.length++] = record;\n                if (record.pc == entry.tail && record.next == entry.header && record.taken) {\n                    entry.valid = true;\n                    entry.published = cycle;\n                    entry.touched = cycle;\n                    writer = -1;\n                    ++published;\n                }\n                return;\n            }\n        }\n        const bool backedge = opcode == 99u && record.taken && !record.trap\n            && record.next < record.pc && record.pc < 0xffffcu\n            && record.pc - record.next < 128 * 4;\n        if (!backedge) return;\n        int victim = -1;\n        for (int i = 0; i < int(entries.size()); ++i) {\n            auto &entry = entries[i];\n            if (entry.valid && entry.header <= record.next && entry.tail >= record.pc)\n                return;\n            if (i == owner) continue;\n            if (victim < 0 || (!entry.valid && entries[victim].valid)\n                || (entry.valid == entries[victim].valid && entry.touched < entries[victim].touched))\n                victim = i;\n        }\n        if (victim != -1) {\n            entries[victim].valid = false;\n            entries[victim].header = record.next;\n            entries[victim].tail = record.pc;\n            entries[victim].length = 0;\n            writer = victim;\n        }\n    }\n};\nCPP\npython - \"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/main.cpp\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np = Path(sys.argv[1])\ns = p.read_text().replace('#include \\\"verilated.h\\\"', '#include \\\"verilated.h\\\"\\\\n#include \\\"replay.hpp\\\"')\ns = s.replace('    top->reset = 1; top->clock = 0;', '''    const bool use_proxy = std::getenv(\\\"BENCH_TRACE_PROXY\\\") \"'!= nullptr;\n    Replay replay;\n    if (const char* delay = std::getenv(\"BENCH_TRACE_PUBLISH_DELAY\"))\n        replay.publish_delay = std::atoi(delay);\n    top->proxy_valid = 0;\n    top->proxy_taken = 0;\n    top->reset = 1; top->clock = 0;'\"''')\ns = s.replace('        top->io_imemData  = rw(imem, top->io_imemAddr);', '''        top->io_imemData  = rw(imem, top->io_imemAddr);\n        const bool ext_imem_ready = top->io_imemReady;\n        const auto* record = use_proxy ? replay.use(top->io_imemAddr, top->io_imemData) : nullptr;\n        top->proxy_valid = record \"'!= nullptr;\n        top->proxy_taken = record != nullptr && record->taken;\n        if (record) top->io_imemReady = 1;'\"''')\ns = s.replace('        top->clock = 1; top->eval();\\\\n\\\\n        // Drain', '''        if (use_proxy) {\n            if (top->proxy_squash) {\n                replay.squashes += replay.owner \"'!= -1;\n                replay.owner = -1;\n            } else if (top->proxy_admit) {\n                replay.admit(cycle, top->io_imemAddr, top->io_imemData,\n                             !ext_imem_ready, top->proxy_corrected);\n            }\n            if (replay.pending) replay.train(*replay.pending, cycle);\n            if (top->proxy_ex_valid)\n                replay.pending = Record{top->proxy_ex_pc, top->proxy_ex_word, top->proxy_ex_successor,\n                                        bool(top->proxy_ex_taken), bool(top->proxy_ex_trap)};\n            else\n                replay.pending.reset();\n            if (top->io_dmemWEn && top->io_dmemReady) replay.invalidate_store(top->io_dmemAddr);\n        }\n        top->clock = 1; top->eval();\n\n        // Drain'\"''')\ns = s.replace('    delete top;', '''    if (use_proxy)\n        std::cerr << \\\"starts \\\" << replay.starts << \\\", replay words \\\" << replay.covered\n                  << \\\", stalled words \\\" << replay.stalled_covered << \\\", squashes \\\" << replay.squashes\n                  << \\\", published \\\" << replay.published << '\\\\\\\\n';\n    delete top;''')\np.write_text(s)\nPY\nverilator --cc --exe --build -j 4 -Mdir \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/obj\\\" \\\"+incdir+/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/rtl\\\" --top-module core -Wall -Wno-fatal -Wno-style -CFLAGS \\\"-DNRET=1\\\" \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/rtl/core_pkg.sv\\\" \"'$(find \"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/rtl\" -name '\"'*.sv' \"'! -name core_pkg.sv | sort) \"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/main.cpp\" -o proxy_sim > \"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/proxy/build.log\" 2>&1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
