{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - '/srv/hwebench/tmp/58928045/28afb5ce/divider-profile.R4kgC8u3' <<'PY'\nimport json\nimport subprocess\nimport sys\nfrom collections import Counter\nfrom pathlib import Path\n\nscratch = Path(sys.argv[1])\nargs = [scratch / 'obj/cosim_sim', scratch / 'coremark.elf', '50000000', '--istall', '--dstall']\ndividers = Counter()\nretired = 0\nstart = stop = None\nebreak = False\nwith subprocess.Popen(args, stdout=subprocess.PIPE, bufsize=1024 * 1024) as sim:\n    for line in sim.stdout:\n        _, _, payload = line.partition(b'\\\"insn\\\":')\n        if not payload:\n            continue\n        insn = int(payload.split(b',', 1)[0])\n        ebreak |= insn == 0x00100073\n        if b'\\\"mem_addr\\\":26843571' in line:\n            record = json.loads(line)\n            if record['mem_wmask']:\n                if record['mem_addr'] == 0x10000100 and start is None:\n                    start = record['cycle']\n                elif record['mem_addr'] == 0x10000104:\n                    stop = record['cycle']\n                continue\n        if start is not None and stop is None:\n            retired += 1\n            if insn & 0xfe00007f == 0x02000033:\n                funct = (insn >> 12) & 7\n                if funct >= 4:\n                    dividers[['DIV', 'DIVU', 'REM', 'REMU'][funct - 4]] += 1\n    assert sim.wait() == 0\nassert ebreak and stop > start\ncount = sum(dividers.values())\nprint(f'Baseline trace over {stop - start:,} timed cycles and {retired:,} retirements: {dict(dividers)}, {count:,} total.')\nprint(f'Seven slots each = {7 * count:,} cycles ({7 * count / (stop - start):.3%} of baseline), before stall overlap or reseeding effects.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
