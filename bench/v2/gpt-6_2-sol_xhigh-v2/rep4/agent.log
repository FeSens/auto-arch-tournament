{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '315,510p' cores/bench/test/test_pipeline.py && sed -n '1,225p' cores/bench/test/_helpers.py\"", "aggregated_output": "        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def divide_behind_stalled_store(dut):\n    program = [\n        ADDI(2, 0, 5),\n        ADDI(1, 0, -37),\n        SW(1, 0, 0x40),\n        DIV(3, 1, 2),\n        ADDI(4, 3, 10),\n        EBREAK(),\n    ]\n    requests = []\n    rets, dmem = await _run(dut, program, store_stalls=3, store_requests=requests)\n\n    dividend = 0xFFFFFFDB\n    quotient = 0xFFFFFFF9\n    assert requests == [(0x40, 0b1111, dividend, False)] * 3 + [\n        (0x40, 0b1111, dividend, True),\n    ]\n    assert dmem == {0x40: dividend}\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n    store, divide, consumer = rets[2:5]\n    assert (store[\"mem_addr\"], store[\"mem_wmask\"], store[\"mem_wdata\"]) == (0x40, 15, dividend)\n    assert (divide[\"rs1_addr\"], divide[\"rs1_rdata\"]) == (1, dividend)\n    assert (divide[\"rs2_addr\"], divide[\"rs2_rdata\"]) == (2, 5)\n    assert (divide[\"rd\"], divide[\"rd_wdata\"]) == (3, quotient)\n    assert (consumer[\"rs1_addr\"], consumer[\"rs1_rdata\"]) == (3, quotient)\n    assert (consumer[\"rd\"], consumer[\"rd_wdata\"]) == (4, 3)\n    as\n…[4351 of 7423 chars elided by tools/bench/transcript.py; sha256:7193aa4c0c3b4e6f]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
