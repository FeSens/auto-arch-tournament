{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -c 'set -e\nwork=/srv/hwebench/tmp/58928045/3bdb60c8/bench-loop.c1PCxo\nmkdir -p \"$work/cocotb-directed\"\ncp -r cores/bench/test \"$work/cocotb-directed/\"\nln -s \"$work/rtl-loop-bramramq\" \"$work/cocotb-directed/rtl\"\npython3 - \"$work/cocotb-directed/test/test_pipeline.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1])\ns=p.read_text()\ns=s.replace('store_requests=None, load_requests=None):','store_requests=None, load_requests=None, coherent_imem=False):')\ns=s.replace('                dmem[wa] = new\\\\n','                dmem[wa] = new\\\\n                if coherent_imem and wa in imem:\\\\n                    imem[wa] = new\\\\n')\ns+='''\n@cocotb.test()\nasync def warm_loop_replay_hides_imem_waits(dut):\n    code = [\n        ADDI(1, 0, 8), ADDI(2, 0, 0), ADDI(2, 2, 1),\n        ADDI(1, 1, -1), BNE(1, 0, -8), SW(2, 0, 0x40), EBREAK(),\n    ]\n    requests = []\n    retires, memory = await _run(\n        dut, code, fetch_requests=requests,\n        unready_fetches={(8, n): SW(1, 0, 0x44) for n in range(5, 17)},\n    )\n    assert [r[\\\"pc\\\"] for r in retires] == [0, 4] + [8, 12, 16] * 8 + [20, 24]\n    assert [r[\\\"order\\\"] for r in retires] == list(range(len(retires)))\n    assert memory == {0x40: 8}\n    first_wait = requests.index((8, False))\n    wait_end = next(c for c in range(first_wait, len(requests)) if requests[c][1])\n    assert requests[first_wait:wait_end] == [(8, False)] * (wait_end - first_wait)\n    assert sum(first_wait + 2 <= r[\\\"cycle\\\"] < wait_end and r[\\\"pc\\\"] == 16\n               for r in retires) >= 2, (requests, retires)\n    assert requests[wait_end] == (20, True), requests\n\n\n@cocotb.test()\nasync def fence_i_refetches_a_patched_loop(dut):\n    patch = ADDI(2, 2, 2)\n    code = {\n        0: ADDI(1, 0, 6), 4: ADDI(6, 0, 0), 8: JAL(0, 0x80 - 8),\n        0x80: ADDI(2, 2, 1), 0x84: ADDI(1, 1, -1), 0x88: BNE(1, 0, -8),\n        0x8c: BNE(6, 0, 0x1c), 0x90: ADDI(6, 0, 1), 0x94: ADDI(1, 0, 4),\n        0x98: LW(3, 0, 0x100), 0x9c: SW(3, 0, 0x80), 0xa0: 0x0000100f,\n        0xa4: JAL(0, 0x80 - 0xa4), 0xa8: SW(2, 0, 0x104), 0xac: EBREAK(),\n    }\n    requests = []\n    retires, memory = await _run(dut, code, {0x100: patch}, coherent_imem=True,\n                                 fetch_requests=requests, store_stalls=3)\n    assert [r[\\\"insn\\\"] for r in retires if r[\\\"pc\\\"] == 0x80] == [code[0x80]] * 6 + [patch] * 4\n    assert [r[\\\"order\\\"] for r in retires] == list(range(len(retires)))\n    assert memory == {0x100: patch, 0x80: patch, 0x104: 14}\n    assert requests.count((0xa4, True)) >= 2\n'''\np.write_text(s)\nPY\ncd \\\"\"'$work/cocotb-directed\"\nCOCOTB_TEST_FILTER='\"'warm_loop_replay_hides_imem_waits|fence_i_refetches_a_patched_loop' python3 -m pytest --rootdir=. -q test/test_pipeline.py > \\\"\"'$work/cocotb-replay-directed.log\" 2>&1\ntail -12 \"$work/cocotb-replay-directed.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
