{"type": "item.completed", "item": {"id": "item_81", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_div_unit.py; sed -n '1,160p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"RV32M arithmetic, latency and handshake tests for the clocked divider.\"\"\"\nfrom __future__ import annotations\n\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.ready.value == 1 and dut.done.value == 0\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await _tick(dut)\n    dut.start.value = 0\n    assert dut.ready.value == 0 and dut.done.value == 0\n\n\nasync def _check(dut, op, a, b, expected, hold_cycles=0):\n    await _start(dut, op, a, b)\n\n    # Change every input after launch, including requesting another operation\n    # during the calculation and while a result is waiting for consumption.\n    dut.op.value = ALU_DIVU if op != ALU_DIVU else ALU_REM\n    dut.a.value = (a ^ MASK32) & MASK32\n    dut.b.value = (b ^ MASK32) & MASK32\n    dut.start.value = 1\n    for cycle in range(1, 8):\n        await _tick(dut)\n        assert dut.ready.value == 0\n        assert dut.done.value == (cycle == 7), f\"unexpected done on iteration cycle {cycle}\"\n\n    expected &= MASK32\n    for cycle in range(hold_cycles + 1):\n        if cycle:\n            await _tick(dut)\n        assert dut.ready.value == 0 and dut.done.value == 1\n        actual = int(dut.result.value)\n        assert actual == expected, (\n            f\"op={op} a={a & MASK32:#010x} b={b & MASK32:#010x} \"\n            f\"expected={expected:#010x} got={actual:#010x}\"\n        )\n\n    dut.start.value = 0\n    dut.consume.value = 1\n    await _tick(dut)\n    dut.consume.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\n@cocotb.test()\na\n…[8648 of 11720 chars elided by tools/bench/transcript.py; sha256:17ac6811c95b180d]…\n(4):\n                    if (wen >> i) & 1:\n                        bv = (wdata >> (i * 8)) & 0xFF\n                        new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n                dmem[wa] = new\n            else:\n                store_stalls -= 1\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n", "exit_code": 0, "status": "completed"}}
