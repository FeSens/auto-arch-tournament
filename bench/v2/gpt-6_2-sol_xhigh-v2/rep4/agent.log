c               direct_taken,\n  output logic               indirect_taken,\"\"\", \"\"\"  output logic               redirect,\n  output logic               recover_sequential,\n  output logic               recover_direct,\n  output logic               recover_indirect,\"\"\")\n    s = s.replace(\"  logic        transfer_taken, actual_taken;\", \"  logic        transfer_taken, actual_taken, direct_taken, indirect_taken;\")\n    s = s.replace(\"\"\"  assign redirect        = advance && (in.last_mapped_word || (in.predicted_taken != actual_taken));\"\"\", \"\"\"  assign recover_sequential = advance && !actual_taken\n                            && (in.last_mapped_word || in.predicted_taken);\n  assign recover_direct = advance && direct_taken\n                        && (in.last_mapped_word || !in.predicted_taken);\n  assign recover_indirect = advance && indirect_taken;\n  assign redirect = recover_sequential || recover_direct || recover_indirect;\"\"\")\n    p_if = rtl / \"if_stage.sv\"\n    t = p_if.read_text().replace(\"\"\"  input  logic              ex_direct_taken,\n  input  logic              ex_indirect_taken,\"\"\", \"\"\"  input  logic              recover_sequential,\n  input  logic              recover_direct,\n  input  logic              recover_indirect,\"\"\")\n    t = t.replace(\"redirect && !ex_direct_taken && !ex_indirect_taken\", \"recover_sequential\").replace(\n        \"redirect && ex_direct_taken\", \"recover_direct\").replace(\"redirect && ex_indirect_taken\", \"recover_indirect\")\n    p_if.write_text(t)\n    p_core = rtl / \"core.sv\"\n    t = p_core.read_text().replace(\"ex_direct_taken, ex_indirect_taken\", \"recover_sequential, recover_direct, recover_indirect\")\n    t = t.replace(\"\"\"    .ex_direct_taken (ex_direct_taken),\n    .ex_indirect_taken (ex_indirect_taken),\"\"\", \"\"\"    .recover_sequential (recover_sequential),\n    .recover_direct     (recover_direct),\n    .recover_indirect   (recover_indirect),\"\"\")\n    t = t.replace(\"\"\"    .direct_taken    (ex_direct_taken),\n    .indirect_taken  (ex_indirect_taken),\"\"\", \"\"\"    .recover_sequential (recover_sequential),\n    .recover_direct     (recover_direct),\n    .recover_indirect   (recover_indirect),\"\"\")\n    p_core.write_text(t)\np.write_text(s)\nPY\npython3 \"$bench_r11/compare.py\" \"$bench_r11\" compare8 8 0\npython3 \"$bench_r11/compare.py\" \"$bench_r11\" split8 8 1\npython3 \"$bench_r11/compare.py\" \"$bench_r11\" split4 4 1\nfor variant in compare8 split8 split4; do\n  bench_r11_rtl=\"$bench_r11/$variant/rtl\"\n  verilator --lint-only -Wall --top-module core -sv \"+incdir+$bench_r11_rtl\" \"$bench_r11_rtl/core_pkg.sv\" \"$bench_r11_rtl/\"*.sv\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
