{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/b697edee/bench-r8s0.b2RJMn/prove_variant.py' <<'PY'\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nroot = Path.cwd()\nscratch = Path(__file__).resolve().parent\nrtl_dir = Path('cores/bench/rtl')\n\nfor name in sys.argv[1:]:\n    def make_model(source, model):\n        rtl = source.read_text()\n        address = rtl[rtl.index('  assign imem_addr'):rtl.index('  logic [5:0]  fetch_index;')]\n        prediction = rtl[rtl.index('  assign predict_taken'):rtl.index('  // The most recent committed update')]\n        prediction = prediction.replace('  assign predict_taken', '  logic predict_taken;\\\\n  assign predict_taken')\n        boundary = rtl[rtl.index('  logic request_is_last'):rtl.index('  assign park =')] if 'logic request_is_last' in rtl else '''  assign last_word_fallthrough = imem_addr == LAST_MAPPED_PC && \"'!predict_taken;'\"\\\\n'''\n        return f'''module {model}(\n    input logic [31:0] predicted_pc_q, recovery_sequential_pc_q, recovery_direct_target_q, mem_indirect_target,\n    input logic recovery_pending_q, select_sequential_q, select_direct_q, select_indirect_q,\n    input logic [31:0] imem_data,\n    input logic fetch_direction,\n    output logic [96:0] observed\n);\n  localparam logic [31:0] LAST_MAPPED_PC = 32'h000f_fffc;\n  logic last_word_fallthrough;\n  logic [31:0] imem_addr;\n{address}\n{prediction}\n{boundary}\n  assign observed = {{imem_addr, direct_target, sequential_pc, last_word_fallthrough}};\nendmodule\n'''\n    args = '''predicted_pc_q, recovery_sequential_pc_q, recovery_direct_target_q,\n      mem_indirect_target, recovery_pending_q, select_sequential_q, select_direct_q,\n      select_indirect_q, imem_data, fetch_direction'''\n    proof = scratch / name / 'check.sv'\n    proof.write_text(make_model(root / rtl_dir / 'if_stage.sv', 'original') +\n                     make_model(scratch / name / rtl_dir / 'if_stage.sv', 'candidate') + f'''\nmodule check(\n    input logic [31:0] predicted_pc_q, recovery_sequential_pc_q, recovery_direct_target_q, mem_indirect_target,\n    input logic recovery_pending_q, select_sequential_q, select_direct_q, select_indirect_q,\n    input logic [31:0] imem_data,\n    input logic fetch_direction\n);\n  logic [96:0] original_out, candidate_out;\n  original u_org({args}, original_out);\n  candidate u_new({args}, candidate_out);\n\n  always_comb begin\n    assume(\"'$onehot({{!recovery_pending_q, select_sequential_q, select_direct_q, select_indirect_q}}));\n    assume({{predicted_pc_q[1:0], recovery_sequential_pc_q[1:0],\n             recovery_direct_target_q[1:0], mem_indirect_target[1:0]}} == 0);\n    assert(original_out == candidate_out);\n  end\nendmodule\n'\"''')\n    command = f'read_verilog -formal -sv {proof}; prep -top check -flatten; chformal -lower; sat -verify -set-assumes -prove-asserts'\n    subprocess.run(['yosys', '-Q', '-q', '-p', command], check=True)\n    print(name + ' passed address and last-word equivalence')\nPY\npython '/srv/hwebench/tmp/58928045/b697edee/bench-r8s0.b2RJMn/prove_variant.py' park seg_6_6_6 seg_9_9\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
