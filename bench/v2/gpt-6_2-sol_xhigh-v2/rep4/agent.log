{"type": "item.started", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/bash -c 'scratch=$(cat \"$TMPDIR/bench-r15s1-dir\")\nfor variant in seq128 seq256\ndo\n  mkdir -p \"$scratch/$variant/cores/bench\"\n  cp -r \"$scratch/direct/cores/bench/rtl\" \"$scratch/direct/cores/bench/core.yaml\" \"$scratch/$variant/cores/bench/\"\n  cp -r \"$scratch/fpga\" \"$scratch/$variant/\"\ndone\npython - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfor variant in ('seq128', 'seq256'):\n p=Path(sys.argv[1])/variant/'cores/bench/rtl/if_stage.sv'\n s=p.read_text()\n s=s.replace(\\\"\\\"\\\"  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [RECORD_WIDTH-1:0] fallback_ram [0:127];\n  prediction_record_t fallback_record;\n  logic fallback_hit;\n\n  assign fallback_record = fallback_ram[predicted_pc_q[8:2]];\n  always_ff @(posedge clock) begin\n    if (ram_write_en)\n      fallback_ram[ram_write_index[6:0]] <= sweeping_q || |fill_record_q.tag[7:5] ? '0\n          : {1'b1, fill_record_q.tag[4:0], fill_index_q[9:7], fill_record_q.prediction};\n  end\n  assign fallback_hit = \"'!sweeping_q && fallback_record.valid\n                     && fallback_record.tag == predicted_pc_q[16:9]\n                     && predicted_pc_q[19:17] == 3'\"'b0;\\\"\\\"\\\", \\\"\\\"\\\"  localparam int FALLBACK_BITS = 7;\n  localparam int FALLBACK_TAG_BITS = 18 - FALLBACK_BITS;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [32+FALLBACK_TAG_BITS:0] fallback_ram [0:(1<<FALLBACK_BITS)-1];\n  logic [FALLBACK_TAG_BITS-1:0] fallback_tag;\n  logic [31:0] fallback_instr;\n  logic fallback_valid, fallback_hit, fallback_step;\n\n  assign {fallback_valid, fallback_tag, fallback_instr}\n    = fallback_ram[predicted_pc_q[2+:FALLBACK_BITS]];\n  always_ff @(posedge clock) begin\n    if (sweeping_q && ram_write_en)\n      fallback_ram[ram_write_index[FALLBACK_BITS-1:0]] <= '0;\n    else if (ram_write_en)\n      fallback_ram[ram_write_index[FALLBACK_BITS-1:0]]\n        <= {\"'!fill_record_q.prediction.taken,\n            fill_record_q.tag, fill_index_q[9:FALLBACK_BITS], fill_record_q.prediction.instr};\n  end\n  assign fallback_hit = !sweeping_q && fallback_valid\n                     && fallback_tag == predicted_pc_q[19:2+FALLBACK_BITS];\"\"\")\n if variant == '\"'seq256':\n  s=s.replace(\\\"FALLBACK_BITS = 7\\\", \\\"FALLBACK_BITS = 8\\\")\n s=s.replace(\\\"\\\"\\\"    replay_prediction = (|replay_match) || \"'!fallback_hit\n                        ? '\"'0 : fallback_record.prediction;\\\"\\\"\\\", \\\"\\\"\\\"    replay_prediction = '0;\\\"\\\"\\\")\n s=s.replace(\\\"produced.instr            = normal_bus_valid ? imem_data : replay_prediction.instr;\\\", \\\"\\\"\\\"produced.instr            = normal_bus_valid ? imem_data :\n                                            (|replay_match) ? replay_prediction.instr : fallback_instr;\\\"\\\"\\\")\n s=s.replace(\\\"\\\"\\\"assign normal_accept_replay = ((|replay_match) || fallback_hit) && predicted_in_window_q && \"'!parked_q && !predicted_last_word_q\n                             && !full && (!imem_ready || stale_request_q);\"\"\",\"\"\"  logic normal_replay_can_step;\n  assign normal_replay_can_step = predicted_in_window_q && !parked_q && !predicted_last_word_q\n                               && !full && (!imem_ready || stale_request_q);\n  assign fallback_step = !(|replay_match) && fallback_hit && normal_replay_can_step;\n  assign normal_accept_replay = ((|replay_match) && normal_replay_can_step) || fallback_step;\"\"\")\n s=s.replace(\"assign replay_step = path == NORMAL && normal_accept_replay;\", \"assign replay_step = path == NORMAL && (|replay_match) && normal_replay_can_step;\")\n s=s.replace(\"|| (replay_step && !replay_prediction.taken);\", \"|| (replay_step && !replay_prediction.taken) || (path == NORMAL && fallback_step);\")\n s=s.replace(\"!(step_bus || replay_step) || fetch_last_word[path]\", \"!(step_bus || replay_step || (path == NORMAL && fallback_step)) || fetch_last_word[path]\")\n s=s.replace(\"(replay_taken && (&replay_prediction.target))\", \"(replay_taken && (|replay_target_last))\")\n p.write_text(s)\nPY\nfor variant in seq128 seq256\ndo\n  (NRET=1 RTL_DIR=\"$scratch/$variant/cores/bench/rtl\" OBJ_DIR=\"$scratch/$variant/obj\" bash test/cosim/build.sh > \"$scratch/$variant/verilator.log\" 2>&1 &&\n   \"$scratch/$variant/obj/cosim_sim\" \"$scratch/sliced/bench/programs/coremark.elf\" 50000000 --bench --istall --dstall > \"$scratch/$variant/coremark.log\") &\n  (python -m tools.eval.gowin bench --worktree \"$scratch/$variant\" --all-options --paths 3 > \"$scratch/$variant/timing.log\") &\ndone\nwait\nfor variant in seq128 seq256; do printf '\"'%s\\\\n' \\\"\"'$variant\"; tail -n 1 \"$scratch/$variant/coremark.log\"; cat \"$scratch/$variant/timing.log\"; done'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.started", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c 'scratch=$(cat \"$TMPDIR/bench-r15s1-dir\")\nfor variant in late128 late256\ndo\n  mkdir -p \"$scratch/$variant/cores/bench\"\n  cp -r \"$scratch/cores/bench/rtl\" \"$scratch/cores/bench/core.yaml\" \"$scratch/$variant/cores/bench/\"\n  cp -r \"$scratch/fpga\" \"$scratch/$variant/\"\ndone\npython - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfor variant in ('late128', 'late256'):\n p=Path(sys.argv[1])/variant/'cores/bench/rtl/if_stage.sv'\n s=p.read_text()\n s=s.replace(\\\"  logic        predicted_in_window_q, predicted_last_word_q;\\\", \\\"\\\"\\\"  logic        predicted_in_window_q, predicted_last_word_q;\n  logic [31:0] normal_pc_q;\n  logic [5:0]  normal_index_q;\n  logic        normal_in_window_q, normal_last_word_q;\n  logic [17:0] fallback_word_q;\n  logic [5:0]  fallback_index_q;\n  logic        fallback_last_q, fallback_selected_q;\n  assign predicted_pc_q = fallback_selected_q ? {12'b0, fallback_word_q, 2'b00} : normal_pc_q;\n  assign predicted_index_q = fallback_selected_q ? fallback_index_q : normal_index_q;\n  assign predicted_in_window_q = fallback_selected_q || normal_in_window_q;\n  assign predicted_last_word_q = fallback_selected_q ? fallback_last_q : normal_last_word_q;\\\"\\\"\\\")\n s=s.replace(\\\"  assign lookup_hit = \\\", \\\"\\\"\\\"  localparam int FALLBACK_BITS = FALLBACK_BITS_VALUE;\n  localparam int FALLBACK_TAG_BITS = 18 - FALLBACK_BITS;\n  typedef struct packed {\n    logic        valid;\n    logic [FALLBACK_TAG_BITS-1:0] tag;\n    logic [31:0] instr;\n    logic        taken;\n    logic [17:0] successor;\n    logic [5:0]  index;\n    logic        last_word;\n  } fallback_t;\n  fallback_t fallback_data, fallback_fill_q;\n  logic fallback_hit, fallback_step;\n  localparam int FALLBACK_WIDTH = \"'$bits(fallback_data);\n  (* syn_ramstyle = \"distributed_ram\" *) logic [FALLBACK_WIDTH-1:0]\n      fallback_ram [0:(1<<FALLBACK_BITS)-1];\n  logic [17:0] bus_successor;\n  assign bus_successor = predict_taken ? target_word : request_pc[19:2] + 18'\"'d1;\n\n  assign fallback_data = fallback_ram[predicted_pc_q[2+:FALLBACK_BITS]];\n  assign fallback_hit = \"'!sweeping_q && fallback_data.valid\n                     && fallback_data.tag == predicted_pc_q[19:2+FALLBACK_BITS];\n  always_ff @(posedge clock) begin\n    fallback_fill_q <= {1'\"'b1, request_pc[19:2+FALLBACK_BITS], imem_data, predict_taken,\n                        bus_successor, (bus_successor[11:6] \"'^ bus_successor[5:0]), &bus_successor};\n    if (ram_write_en) fallback_ram[ram_write_index[FALLBACK_BITS-1:0]]\n                      <= sweeping_q ? '\"'0 : fallback_fill_q;\n\n    fallback_word_q <= fallback_data.successor;\n    fallback_index_q <= fallback_data.index;\n    fallback_last_q <= fallback_data.last_word;\n    fallback_selected_q <= \"'!reset && !recovery_pending_q && fallback_step;\n  end\n\n  assign lookup_hit = \"\"\".replace(\"FALLBACK_BITS_VALUE\", \"7\" if variant == \"late128\" else \"8\"))\n s=s.replace(\"produced.instr            = normal_bus_valid ? imem_data : replay_prediction.instr;\", \"\"\"produced.instr            = normal_bus_valid ? imem_data :\n                                            (|replay_match) ? replay_prediction.instr : fallback_data.instr;\"\"\")\n s=s.replace(\"produced.predicted_taken  = normal_bus_valid ? candidate_taken[NORMAL] : replay_prediction.taken;\", \"\"\"produced.predicted_taken  = normal_bus_valid ? candidate_taken[NORMAL] :\n                                            (|replay_match) ? replay_prediction.taken : fallback_data.taken;\"\"\")\n s=s.replace(\"\"\"  assign accept_replay = normal_accept_replay && !recovery_pending_q;\"\"\",\"\"\"  assign fallback_step = fallback_hit && !(|replay_match) && predicted_in_window_q\n                       && !predicted_last_word_q && !parked_q && !full\n                       && (!imem_ready || stale_request_q);\n  assign accept_r