{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c 'trial_dir=$(mktemp -d \"$TMPDIR/hyp-r7s1-radix16.XXXXXX\") &&\nmkdir -p \"$trial_dir/cores/bench\" &&\ncp -a Makefile bench fpga test \"$trial_dir/\" &&\ncp -a cores/bench/core.yaml cores/bench/rtl cores/bench/test \"$trial_dir/cores/bench/\" &&\npython - \"$trial_dir/cores/bench/rtl/div_unit.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\npath = Path(sys.argv[1])\ns = path.read_text().replace(\n    \\\"consumes four more, then six iterations of two radix-4 steps finish.\\\",\n    \\\"consumes four more, then six exact radix-16 steps finish.\\\",\n).replace(\n    \\\"\\\"\\\"  logic [33:0] triple_divisor_q;\n  logic [31:0] radix_remainder_mid, radix_remainder_next;\n  logic [1:0]  radix_quotient_hi, radix_quotient_lo;\n\\\"\\\"\\\",\n    \\\"\\\"\\\"  logic [35:0] odd_multiple_q [3:15];\n  logic [35:0] divisor_wide;\n  logic [35:0] shifted_remainder;\n  logic [31:0] trial_remainder [0:15];\n  logic [15:0] fits, take;\n  logic [31:0] next_remainder;\n  logic [3:0]  next_digit;\n\\\"\\\"\\\",\n)\nsetup = \\\"\\\"\\\"  assign divisor_wide = {4'b0, divisor_q};\n  assign shifted_remainder = {remainder_q, dividend_quotient_q[31:28]};\n\n  // Three shifted terms reduce to one carry-propagating addition.\n  function automatic logic [35:0] add_three (\n    input logic [35:0] x, y, z\n  );\n    add_three = (x \"'^ y ''^ z) + (((x & y) | (x & z) | (y & z)) << 1);\n  endfunction\n\n  assign fits[0] = 1'\"'b1;\n  assign trial_remainder[0] = shifted_remainder[31:0];\n  for (genvar digit = 1; digit <= 15; digit++) begin : g_trial\n    localparam int SHIFT = (digit % 2) ? 0 : (digit % 4) ? 1 : (digit % 8) ? 2 : 3;\n    localparam int ODD = digit >> SHIFT;\n    wire [35:0] multiple;\n    /* verilator lint_off UNUSEDSIGNAL */\n    wire [36:0] difference;\n    /* verilator lint_on UNUSEDSIGNAL */\n\n    if (ODD == 1) assign multiple = divisor_wide << SHIFT;\n    else          assign multiple = odd_multiple_q[ODD] << SHIFT;\n\n    assign difference = {1'b0, shifted_remainder} - {1'b0, multiple};\n    assign fits[digit] = \"'!difference[36];\n    assign trial_remainder[digit] = difference[31:0];\n  end\n\n  assign take = fits & ~{1'\"'b0, fits[15:1]};\n  for (genvar bit_index = 0; bit_index < 32; bit_index++) begin : g_remainder\n    wire [15:0] selected_bits;\n    for (genvar digit = 0; digit <= 15; digit++) begin : g_bit\n      assign selected_bits[digit] = take[digit] && trial_remainder[digit][bit_index];\n    end\n    assign next_remainder[bit_index] = |selected_bits;\n  end\n  assign next_digit = {|(take & 16'hff00), |(take & 16'hf0f0),\n                       |(take & 16'hcccc), |(take & 16'haaaa)};\n\n\\\"\\\"\\\"\ns = s[:s.index(\\\"  function automatic logic [33:0] radix4_step\\\")] + setup + s[s.index(\\\"  always_ff @(posedge clock) begin\\\\n    if (prepare_q) begin\\\"):]\ns = s.replace(\n    \\\"        triple_divisor_q    <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\\\",\n    \\\"\\\"\\\"        odd_multiple_q[3]  <= (divisor_wide << 1) + divisor_wide;\n        odd_multiple_q[5]  <= (divisor_wide << 2) + divisor_wide;\n        odd_multiple_q[7]  <= (divisor_wide << 3) - divisor_wide;\n        odd_multiple_q[9]  <= (divisor_wide << 3) + divisor_wide;\n        odd_multiple_q[11] <= add_three(divisor_wide << 3, divisor_wide << 1, divisor_wide);\n        odd_multiple_q[13] <= add_three(divisor_wide << 3, divisor_wide << 2, divisor_wide);\n        odd_multiple_q[15] <= (divisor_wide << 4) - divisor_wide;\\\"\\\"\\\",\n).replace(\n    \\\"{dividend_quotient_q[27:0], radix_quotient_hi, radix_quotient_lo}\\\",\n    \\\"{dividend_quotient_q[27:0], next_digit}\\\",\n).replace(\\\"remainder_q         <= radix_remainder_next;\\\", \\\"remainder_q         <= next_remainder;\\\")\npath.write_text(s)\nPY\nprintf '%s\\\\n' \\\"\"'$trial_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
