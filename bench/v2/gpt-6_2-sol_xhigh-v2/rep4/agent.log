FFFFFF, 0x80000000, 0)     # MAX > MIN\n\n\n@cocotb.test()\nasync def sltu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n    await _check(dut, ALU_SLTU, 0, 1, 1)\n\n\n@cocotb.test()\nasync def sll(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLL, 1, 4, 16)\n    await _check(d\n…[5517 of 8589 chars elided by tools/bench/transcript.py; sha256:c8cdd8be44cd6191]…\n    quotient = -quotient\n                remainder = dividend - quotient * divisor\n            else:\n                quotient, remainder = MASK32, dividend\n            expected = quotient if op in (ALU_DIV, ALU_DIVU) else remainder\n            await _check(dut, op, a, b, expected)\n\n\n@cocotb.test()\nasync def completion_holds_until_consumed(dut):\n    await _reset(dut)\n    await _check(dut, ALU_REM, -37, 5, -2, hold_cycles=5)\n    await _check(dut, ALU_DIVU, MASK32, 0x80000000, 1, hold_cycles=9)\n\n\n@cocotb.test()\nasync def reset_cancels_divide(dut):\n    await _reset(dut)\n    for cycles_before_reset in (3, 7):\n        await _start(dut, ALU_DIV, 19, 5)\n        for _ in range(cycles_before_reset):\n            await _tick(dut)\n        assert dut.done.value == (cycles_before_reset == 7)\n        await _reset(dut)\n        await _check(dut, ALU_REMU, 3, 2, 1)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
