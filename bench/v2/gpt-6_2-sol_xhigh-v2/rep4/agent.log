{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/58928045/0e90a360/bench-r12s0.WfYhLO' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nscratch = Path(sys.argv[1])\nfor name, src in (('sharedops', Path('cores/bench/rtl')), ('pcbankshared', scratch/'pcbank/rtl')):\n    rtl = scratch/name/'rtl'; rtl.mkdir(parents=True)\n    for sv in src.glob('*.sv'): shutil.copyfile(sv, rtl/sv.name)\n    path = rtl/'ex_stage.sv'\n    sv = path.read_text()\n    sv = sv.replace('assign jalr_addr_low = rs1[1:0]', 'assign jalr_addr_low = alu_a[1:0]')\n    sv = sv.replace('(rs1),', '(alu_a),').replace('(rs2),', '(alu_b),')\n    start = sv.index('    case (in.ctrl.branch_op)')\n    end = sv.index('    endcase', start)\n    sv = sv[:start] + sv[start:end].replace('rs1','alu_a').replace('rs2','alu_b') + sv[end:]\n    path.write_text(sv)\nPY\npython - '/srv/hwebench/tmp/58928045/0e90a360/bench-r12s0.WfYhLO' <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval import gowin\np = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    submitted = {pool.submit(gowin.build, '.', p/n/'rtl','fpga/core_bench_si.sv',1,p/n/'p1'): n\n                 for n in ('sharedops','pcbankshared')}\n    for f in as_completed(submitted):\n        r = f.result()\n        print(submitted[f], r.get('fmax_mhz'), r.get('reason'), (r.get('critical_paths') or [])[:3], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
