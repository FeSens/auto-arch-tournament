strengthen or weaken matching entries on outcomes. Install legal\\naligned jumps as strongly taken. Train once per advancing valid EX control\\ninstruction and suppress training for traps. Reset the valid bits and leave\\nthe payload arrays unreset to allow distributed RAM inference.\\n\\nUse only the fetch-indexed table read. On an accepted fetch, register that\\ninstruction's lookup hit and counter alongside the IF PC update for use by\\nEX training one stage later. If EX writes the same index on tha\n…[30349 of 33421 chars elided by tools/bench/transcript.py; sha256:48b3baf268602425]…\n training and the last mapped word.'}]\noutcome: regression\nfitness: 150.3\ndelta_pct: 8.18\nvs_baseline: 1140.1\nfmax_mhz: 59.469\nipc_coremark: 3e-06\ncycles: 3956704\niterations: 10\nlut4: 3323\nff: 1037\nseeds: [58.706, 59.469, 59.469]\nperturbations: [[0, 58.706, 26], [1, 59.469, 25], [2, 59.469, 25]]\nlutram: 16\nbsram: 6\ndsp: 2\ncritical_path: {'from': 'cpu/u_ex/u_div/remainder_q_1_s1', 'to': 'cpu/u_ex/u_div/remainder_q_2_s1', 'slack_ns': -12.034, 'arrival_ns': 22.328, 'logic_cells': 129, 'modules': ['clock_ibuf', 'cpu/u_ex/u_div']}\nlogic_levels: 26\nformal_passed: True\ncosim_passed: True\nerror: None\ntimestamp: 2026-11-21T15:22:30.528155Z\nslot: 2\nround_id: 4\nlesson: - 2026-11-21 hyp-20261121-003-r4s2 (regression, +8.18%): A four-entry fall-through queue cut stalled CoreMark cycles by 5.57% by fetching through decode holds, and after moving EX correction out of the queue payload enables, divider and EX-to-IF recovery timing limited median Gowin Fmax to 59.469 MHz, below the 61.05 MHz needed to match the round winner.\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"ls -l /opt/gowin/IDE/bin/gw_sh && sed -n '1,180p' fpga/core_bench_si.sv && sed -n '1,180p' test/cosim/build.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"ls -l /opt/gowin/IDE/bin/gw_sh && sed -n '1,180p' fpga/core_bench_si.sv && sed -n '1,180p' test/cosim/build.sh\"", "aggregated_output": "-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\n// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same s\n…[3107 of 6179 chars elided by tools/bench/transcript.py; sha256:2c2367875417dc88]…\nRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"rg '\\\"id\\\": \\\"hyp-20261121-003-r4s2\\\"' cores/bench/experiments/log.jsonl | python -c 'import json,sys; print(json.loads(sys.stdin.readline())[\\\"implementation_notes\\\"])'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"rg '\\\"id\\\": \\\"hyp-20261121-001-r4s0\\\"' cores/bench/experiments/log.jsonl | python -c 'import json,sys; d=json.loads(sys.stdin.readline()); print(d[\\\"fitness\\\"],d[\\\"cycles\\\"],d[\\\"fmax_mhz\\\"]); print(d[\\\"implementation_notes\\\"])'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"rg '\\\"id\\\": \\\"hyp-20261121-003-r4s2\\\"' cores/bench/experiments/log.jsonl | python -c 'import json,sys; print(json.loads(sys.stdin.readline())[\\\"implementation_notes\\\"])'\"","aggregated_output":"# Predicted-path fetch queue\n\nIF runs the folded-index 64-entry predictor at the instruction bus and holds up to four ready instructions in a shift queue. Each slot carries the full PC, instruction, six-bit index and selected direction. Decode bypasses an empty queue. A load-use bubble or EX hold retains the decode head, and a full queue can refill on the same edge that decode consumes its head. An advancing EX correction clears all occupancy and squashes decode even when the bus is unready.\n\nThe fetch and issue lookups use separately inferred RAMs. The fetch RAM mirrors each counter's high bit and reads the pre-edge direction. The queue head selects the issue index independently of its prediction bit. An advancing, nontrapping conditional branch trains both copies, and its write forwards into a same-index issue snapshot.\n\nIF qualifies the 19-bit word sum for source window, target window and halfword alignment. A fall-through from the last mapped word enters ID/EX directly, then parks fetch until EX advances with the resolved successor. EX reconstructs the full RV32 direct target in word units and uses the immediate's bit 1 for alignment. The resolved successor drives RVFI and recovery, and JAL and JALR links remain PC+4.\n\n## Timing changes\n\n- Queue shift and refill candidates are calculated alongside EX correction. Correction has priority over the occupancy update and decode admission. Keeping the correction out of the payload enables removed a path through EX comparison into the queue flops.\n- EX shares the forwarded base-plus-immediate sum between JALR and the registered load/store address. MEM uses the address register for the bus and byte-lane alignment. This removes the general ALU result selector from the data-memory setup path. The bus address during cycles without a memory strobe can differ from the champion.\n- The divider and the EX-to-IF recovery path now limit or nearly limit Gowin timing. The four queue slots contribute to the increase in area. Placement option 0 used 3,323 reported logic cells, 1,037 registers, 16 LUT RAMs, six block RAMs and two DSPs.\n\n## Local verification\n\n- Strict Verilator lint passed with and without the cocotb VPI switches.\n- `bash formal/run_all.sh` passed all 53 single-channel ALTOPS checks on the final logic, including liveness. The first attempt's `pc_fwd_ch0` trace expected retirement at `0x000ff8e4` after a load-use bubble and observed PC zero. Yosys treated the packed-struct array as bit slices. On the first retry, Yosys rejected the typedef argument to `$bits` in the packed-vector array declaration. Switching to `$bits(fetched)` passed the second retry. The final timing changes passed the suite again.\n- All seven cocotb runners passed, including 23 pipeline cases. The directed cases cover loop recovery over an unready bus, full refill, buffered issue during unready fetch, same-index training, last-word parking and full-width out-of-window resolution.\n- `make cosim TARGET=bench NRET=1` matched the ISS for selftest and three random programs with zero-wait and stalled buses. Stalled CoreMark passed all five canonical CRCs, reported `Correct operation validated.` and performed no out-of-bounds memory access.\n\n## CoreMark and Gowin\n\n| Gowin placement | Fmax |\n| --- | ---: |\n| 0 | 58.706 MHz |\n| 1 | 59.469 MHz |\n| 2 | 59.469 MHz |\n| Median | 59.469 MHz |\n\n`make fpga TARGET=bench NRET=1` reproduced all three placement results. The 10-iteration run took 3,956,704 marker-bracketed cycles with both stalls enabled, down 5.57% from the champion. The median gives **150.30 iterations/s**, up 8.18% from 138.94 iterations/s.\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"rg '\\\"id\\\": \\\"hyp-20261121-001-r4s0\\\"' cores/bench/experiments/log.jsonl | python -c 'import json,sys; d=json.loads(sys.stdin.readline()); print(d[\\\"fitness\\\"],d[\\\"cycles\\\"],d[\\\"fmax_mhz\\\"]); print(d[\\\"implementation_notes\\\"])'\"","aggregated_output":"154.3 4190307 64.657\n# Bench EX datapath implementation\n\n- EX computes the effective address from forwarded `rs1` and the decoded I- or S-type immediate. The 12-bit sum runs in parallel with three upper-word candidates. EX/MEM holds the full address with the store payload and memory controls through data-bus stalls. MEM uses it for the bus address, alignment, lane masks, load extraction, and aligned RVFI address.\n- EX ORs five independently masked results for the jump link, low multiply, high multiply, division or remainder, and base ALU. This preserves the forwarding schedule, branch prediction, load-use interlock, and single-cycle low `MUL`.\n- The two asynchronous register reads share one 32-word distributed RAM array. Reset clears the written bits. Reads retain hardwired `x0` and matching-write priority on both ports.\n- The divider launches with four seed bits, consumes four more bits with eight-bit restoring arithmetic while registering `3D`, then performs two radix-4 steps on each of six edges. Each radix-4 step compares all three multiples in parallel. The hardware and ALTOPS paths retain the launch-to-completion schedule and hold completion until consumed.\n\nJALR also uses the split address adder because it has the same signed 12-bit offset. It still clears target bit zero before redirecting. The existing four-bit divider seed computes the magnitude of its two high bit pairs with independent carry inputs to shorten the launch path.\n\n## Local verification\n\n- Verilator `-Wall` lint passed in both hardware and ALTOPS modes.\n- All seven cocotb suites passed. The added coverage checks forwarded offsets across 4 KiB boundaries, 32-bit address wraparound, load and store alignment traps, subword lanes, a held store, register reset and bypass, and all four divide operations at divisor magnitudes 255 and 256 and with wide unsigned operands.\n- `bash formal/run_all.sh` passed all 53 single-channel ALTOPS checks, including `reg_ch0`, with zero corrective retries. A separate induction check on the synthesized register-file model proved both read ports equivalent to the original after reset for arbitrary write sequences.\n- `NRET=1 make cosim TARGET=bench` passed selftest against the ISS with and without stalls and passed stalled CoreMark CRC validation.\n\n## Gowin score\n\n`NRET=1 make fpga TARGET=bench` completed all three placements.\n\n| Placement | Fmax (MHz) |\n| --- | ---: |\n| 0 | 62.587 |\n| 1 | 64.657 |\n| 2 | 64.657 |\n\nThe median of **64.657 MHz** gives **154.30 CoreMark iterations/sec** at 10 iterations in 4,190,307 timed cycles. That is **11.06% above the champion** and 6.41 iterations/sec below the scratch result. Placement zero used 3,443 logic cells, 805 registers, 36 LUT RAMs, four block RAMs, and two DSPs.\n\nThe worst setup path starts at MEM/WB's destination register and crosses forwarding into the ordinary ALU in placement zero and into the divider launch seed in placements one and two.\n\n","exit_code":0,"status":"completed"}}
