{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/recovery-research/train.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,shutil\nroot=Path(os.environ['TMPDIR'])/'recovery-research'\ndef replace(file,old,new):\n    p=variant/file\n    s=p.read_text()\n    assert s.count(old)==1,(file,old)\n    p.write_text(s.replace(old,new))\n\ndef train(select_late):\n    for f,name in (('ex_stage.sv','train_negative'),('if_stage.sv','train_negative')):\n        p=variant/f\n        s=p.read_text()\n        if f=='ex_stage.sv':\n            s=s.replace('output logic               train_negative','output logic               train_misaligned,\\\\n  output logic               train_negative')\n            s=s.replace(''' && \"'!in.ctrl.is_illegal\n                     && !(branch_taken && in.direct_offset[1]);'\"''',''' && \"'!in.ctrl.is_illegal;\n  assign train_misaligned = in.direct_offset[1];'\"''')\n        else:\n            s=s.replace('  input  logic              train_negative,','  input  logic              train_negative,\\\\n  input  logic              train_misaligned,')\n        p.write_text(s)\n    replace('core.sv','  logic        train_valid, train_taken, train_negative;', '''  logic        train_valid, train_taken, train_negative, train_misaligned;''')\n    p=variant/'core.sv'\n    s=p.read_text().replace('    .train_taken     (train_taken),','    .train_taken     (train_taken),\\\\n    .train_misaligned (train_misaligned),')\n    p.write_text(s)\n    replace('if_stage.sv','  logic        train_pending_q;', '''  logic        train_pending_q, pending_valid, pending_taken_q, pending_misaligned_q;''')\n    replace('if_stage.sv','  logic [1:0]  pending_counter_q;', '''  logic [1:0]  pending_counter;\n  logic [1:0]  pending_increment_q, pending_decrement_q;''')\n    p=variant/'if_stage.sv'\n    s=p.read_text().replace('train_pending_q && pending_index_q','pending_valid && pending_index_q')\n    s=s.replace('pending_counter_q','pending_counter')\n    s=s.replace('  logic [1:0]  train_base_counter, train_counter;\\\\n  logic        train_hi_or_taken, train_hi_and_taken;', '''  logic [1:0]  train_base_counter;\n  logic [1:0]  train_increment, train_decrement;\n  assign pending_valid = train_pending_q && \"'!(pending_taken_q && pending_misaligned_q);\n  assign pending_counter = pending_taken_q ? pending_increment_q : pending_decrement_q;'\"''')\n    start=s.index('  assign train_hi_or_taken')\n    end=s.index('    if (reset) begin\\\\n      train_pending_q', start)\n    s=s[:start]+'''  assign train_increment = {train_base_counter[1] || train_base_counter[0],\n                            train_base_counter[1] || \"'!train_base_counter[0]};\n  assign train_decrement = {train_base_counter[1] && train_base_counter[0],\n                            train_base_counter[1] && !train_base_counter[0]};\n\n  always_ff @(posedge clock) begin\n    pending_taken_q <= train_taken;\n    if (train_valid) begin\n      pending_index_q <= train_index;\n      pending_misaligned_q <= train_misaligned;\n      pending_increment_q <= train_increment;\n      pending_decrement_q <= train_decrement;\n    end\n\n'\"'''+s[end:]\n    s=s.replace('if (train_pending_q)', 'if (pending_valid)')\n    if select_late == 'base':\n        s=s.replace('logic [1:0]  pending_increment_q, pending_decrement_q;', 'logic [1:0]  pending_base_q;')\n        s=s.replace('  logic [1:0]  train_increment, train_decrement;', '  logic [1:0]  train_increment, train_decrement;')\n        s=s.replace('pending_taken_q ? pending_increment_q : pending_decrement_q', 'pending_taken_q ? train_increment : train_decrement')\n        a=s.index('  assign train_increment')\n        b=s.index('  always_ff',a)\n        s=s[:a]+s[a:b].replace('train_base_counter','pending_base_q')+s[b:]\n        s=s.replace('      pending_increment_q <= train_increment;\\\\n      pending_decrement_q <= train_decrement;', '      pending_base_q <= train_base_counter;')\n    p.write_text(s)\n\nfor name,base,mode in (\n    ('train','cores/bench/rtl','candidates'),\n    ('trainsplit',root/'split','candidates'),\n    ('trainbase',root/'split','base'),\n):\n    variant=root/name\n    shutil.copytree(base,variant,dirs_exist_ok=True)\n    train(mode)\nPY\npython \\\"\"'$TMPDIR/recovery-research/train.py\" && PYTHONPATH=\"$PWD\" python \"$TMPDIR/recovery-research/timing.py\" train:1 trainsplit:1 trainbase:1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
