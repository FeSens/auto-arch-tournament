tor. Empty vars produce\n# empty strings so the orchestrator falls back to its defaults.\nORCH_FLAGS  = --iterations $(N) --tournament-size $(K)\nifneq ($(strip $(BASE)),)\n  ORCH_FLAGS += --base $(BASE)\nendif\nifneq ($(strip $(COREMARK)),)\n  ORCH_FLAGS += --coremark-target $(COREMARK)\nendif\nifneq ($(strip $(LUT)),)\n  ORCH_FLAGS += --lut-target $(LUT)\nendif\n\n# Multi-core: TARGET selects the core under cores/<TARGET>\n…[4341 of 7413 chars elided by tools/bench/transcript.py; sha256:0639c26904f9f09d]…\nmacros.vh\n428:                : @basedir@/checks/rvfi_channel.sv\n429:                : @basedir@/checks/rvfi_testbench.sv\n434:                    : @basedir@/checks/rvfi_csr_ill_check.sv\n438:                    : @basedir@/checks/rvfi_csrw_check.sv\n442:                    : @basedir@/checks/rvfi_insn_check.sv\n443:                    : @basedir@/insns/insn_@insn@.v\n702:                : @basedir@/checks/rvfi_macros.vh\n703:                : @basedir@/checks/rvfi_channel.sv\n704:                : @basedir@/checks/rvfi_testbench.sv\n705:                : @basedir@/checks/rvfi_@check@_check.sv\ntotal 40K\ndrwxrwx---+ 5 hwebench hwebench 4.0K Nov 21 23:22 .\ndrwxrwx---+ 3 hwebench hwebench 4.0K Nov 21 23:22 ..\ndrwxrwx---+ 4 hwebench hwebench 4.0K Nov 21 23:22 gowin_p0\ndrwxrwx---+ 4 hwebench hwebench 4.0K Nov 21 23:22 gowin_p1\ndrwxrwx---+ 4 hwebench hwebench 4.0K Nov 21 23:22 gowin_p2\nitcl4.0.4\nlibAssistant.so\nlibCmdOption.so\nlibDevice.so\nlibEditor.so\nlibExtSys.so\nlibGLX.so.0\nlibGLdispatch.so.0\nlibGWTE.so\nlibGaoUtils.so\n", "exit_code": 0, "status": "completed"}}
