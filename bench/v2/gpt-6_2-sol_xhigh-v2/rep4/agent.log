{"type": "item.started", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/b697edee/bench-r8s0.b2RJMn/make_select_variants.py' <<'PY'\nfrom pathlib import Path\nimport re\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(__file__).resolve().parent\nrtl_dir = Path('cores/bench/rtl')\n\nfor name in sys.argv[1:]:\n    base, variant = name.rsplit('~', 1)\n    work = scratch / name\n    parent = scratch / base\n    shutil.copytree(parent / rtl_dir, work / rtl_dir)\n    shutil.copy2(root / 'cores/bench/core.yaml', work / 'cores/bench/core.yaml')\n    shutil.copytree(root / 'fpga', work / 'fpga')\n    file = work / rtl_dir / 'if_stage.sv'\n    rtl = file.read_text()\n\n    if 'cin' in variant:\n        for first, high, low, size, group in re.findall(r'assign target_low\\\\[(\\\\d+):(\\\\d+)\\\\] = sum_(\\\\d+) \\\\+ \\\\{(\\\\d+)\\\\x27b0, carry_in\\\\[(\\\\d+)\\\\]\\\\};', rtl):\n            # Match target slice and carry group. Use a single add with carry.\n            assert low == group\n            rtl = rtl.replace(\n                f\\\"sum_{group} + {{{size}'b0, carry_in[{group}]}};\\\",\n                f\\\"imem_addr[{int(first)+2}:{int(high)+2}] + word_offset[{first}:{high}] + carry_in[{group}];\\\"\n            )\n            rtl = rtl.replace(f'sum_{group};', f\\\"unused_sum_{group};\\\").replace(f', sum_{group}}}', f', unused_sum_{group}}}')\n    if 'csel' in variant:\n        for high, low, s, size, group in re.findall(r'assign target_low\\\\[(\\\\d+):(\\\\d+)\\\\] = sum_(\\\\d+) \\\\+ \\\\{(\\\\d+)\\\\x27b0, carry_in\\\\[(\\\\d+)\\\\]\\\\};', rtl):\n            assert s == group\n            rtl = rtl.replace(\n                f\\\"sum_{group} + {{{size}'b0, carry_in[{group}]}};\\\",\n                f\\\"carry_in[{group}] ? sum_{group}_inc : sum_{group};\\\"\n            )\n            rtl = rtl.replace(\n                f'  logic [{size}:0] sum_{group};',\n                f\\\"  logic [{size}:0] sum_{group}, sum_{group}_inc;\\\\n\\\"\n                f\\\"  assign sum_{group}_inc = imem_addr[{int(high)+2}:{int(low)+2}] + word_offset[{high}:{low}] + {int(size)+1}'d1;\\\"\n            )\n    if 'banks' in variant:\n        rtl = rtl.replace('  logic [31:0] predicted_pc_q;', '''  logic [31:0] held_pc_q, sequential_pc_q;\n  logic [17:0] target_word_q;\n  logic select_held_q, select_next_sequential_q, select_target_q;\n  logic [31:0] predicted_pc_q;''')\n        rtl = rtl.replace('  assign imem_addr = ', '''  assign predicted_pc_q = ({32{select_held_q}} & held_pc_q)\n                        | ({32{select_next_sequential_q}} & sequential_pc_q)\n                        | ({32{select_target_q}} & {12'b0, target_word_q, 2'b0});\n  assign imem_addr = ''') if 'flat' not in variant else rtl.replace('''  assign imem_addr = ({32{\"'!recovery_pending_q}} & predicted_pc_q)'\"''', '''  assign predicted_pc_q = ({32{select_held_q}} & held_pc_q)\n                        | ({32{select_next_sequential_q}} & sequential_pc_q)\n                        | ({32{select_target_q}} & {12'b0, target_word_q, 2'b0});\n  assign imem_addr = ({32{\"'!recovery_pending_q && select_held_q}} & held_pc_q)\n                   | ({32{!recovery_pending_q && select_next_sequential_q}} & sequential_pc_q)\n                   | ({32{!recovery_pending_q && select_target_q}} & {12'\"'b0, target_word_q, 2'b0})''')\n        i = rtl.index(\\\"  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      predicted_pc_q <= '0;\\\")\n        rtl = rtl[:i] + '''  always_ff @(posedge clock) begin\n    target_word_q <= direct_target[19:2];\n    sequential_pc_q <= sequential_pc;\n    held_pc_q <= reset ? 32'b0 : imem_addr;\n    select_next_sequential_q <= \"'!reset && accept_fetch && !predict_taken;\n    select_target_q <= !reset && accept_fetch && predict_taken;\n    select_held_q <= reset || !accept_fetch;\n  end\n\nendmodule\n'\"'''\n        if 'flat' in variant:\n            rtl = rtl.replace('  logic [31:0] predicted_pc_q;\\\\n','')\n            s = rtl.index('  assign predicted_pc_q')\n            e = rtl.index('  assign imem_addr',s)\n            rtl = rtl[:s]+rtl[e:]\n            rtl = rtl.replace(\\\"(\"'!recovery_pending_q && predicted_pc_q == LAST_MAPPED_PC)\", \"\"\"(!recovery_pending_q && ((select_held_q && held_pc_q == LAST_MAPPED_PC)\n                                                  || (select_next_sequential_q && sequential_pc_q == LAST_MAPPED_PC)\n                                                  || (select_target_q && (&target_word_q))))\"\"\")\n            for page, pred in [('\"'zero', '== 12\\\\'d0'), ('one', '== 12\\\\'d1'), ('max', '')]:\n                before = f\\\"predicted_pc_q[31:20] {pred}\\\" if pred else \\\"(&predicted_pc_q[31:20])\\\"\n                hold = f\\\"held_pc_q[31:20] {pred}\\\" if pred else \\\"(&held_pc_q[31:20])\\\"\n                seq = f\\\"sequential_pc_q[31:20] {pred}\\\" if pred else \\\"(&sequential_pc_q[31:20])\\\"\n                after = f\\\"((select_held_q && {hold}) || (select_next_sequential_q && {seq})\\\" + (\\\" || select_target_q)\\\" if page == 'zero' else \\\")\\\")\n                rtl = rtl.replace(before, after)\n    if variant.endswith('xor'):\n        # Realize carry generate independently of the output sum and avoid\n        # a Gowin carry chain for each block's equality.\n        for group, a, b in re.findall(r\\\"assign \\\\{carry_generate\\\\[(\\\\d+)\\\\], sum_\\\\d+\\\\} = \\\\{1'b0, ([\"'^}]+)'\"\\\\} \\\\+ \\\\{1'b0, ([\"'^}]+)'\"\\\\};\\\", rtl):\n            before = f\\\"assign {{carry_generate[{group}], sum_{group}}} = {{1'b0, {a}}} + {{1'b0, {b}}};\\\"\n            after = f\\\"assign sum_{group} = {a} + {b};\\\\n  assign carry_generate[{group}] = {a} > ~{b};\\\"\n            rtl = rtl.replace(before, after)\n    file.write_text(rtl)\nPY\npython '/srv/hwebench/tmp/58928045/b697edee/bench-r8s0.b2RJMn/make_select_variants.py' 'seg_9_9+zerorange~csel' 'seg_9_9+zerorange~cin' 'seg_9_9+zerorange~banksflat' 'park+zero~banksflat' 'seg_9_9+zerorange~cselxor'\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
