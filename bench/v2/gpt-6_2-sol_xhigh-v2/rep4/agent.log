{"type": "item.started", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c 'p=\"$TMPDIR/predictor-profile\"\ncat > \"$p/training_variants.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nroot = Path(sys.argv[1])\nfor base in ('shift2f', 'shift3n', 'shift4f'):\n  for config in ('decode', 'delayed'):\n    variant = f'{base}_{config}'\n    path = root / variant\n    shutil.copytree(root / base, path)\n    p = path / 'if_stage.sv'\n    text = p.read_text()\n    if config == 'decode':\n      text = text.replace('  queued_t updated [0:DEPTH-1];\\\\n', '')\n      text = text.replace('  assign received.payload.direction_counter = (train_valid && train_index == fetch_index)\\\\n                                               ? train_counter : lookup_counter;', \\\"  assign received.payload.direction_counter = '0;\\\")\n      a = text.index('  for (genvar i = 0; i < DEPTH; i++) begin')\n      b = text.index('  always_ff',a)\n      text = text[:a] + text[b:]\n      text = text.replace('updated[', 'queue_q[')\n      text = text.replace('        else queue_q[i] <= queue_q[i];\\\\n', '')\n      text = text.replace('  assign out = empty ? received.payload : queue_q[0].payload;', \\\"\\\"\\\"  queued_t issuing;\n  logic [1:0] decode_counter;\n  assign issuing = empty ? received : queue_q[0];\n  assign decode_counter = counter_valid[issuing.index] ? direction_table[issuing.index]\n                                                       : {issuing.payload.instr[31], \"'!issuing.payload.instr[31]};\n  always_comb begin\n    out = issuing.payload;\n    out.direction_counter = (train_valid && train_index == issuing.index)\n                            ? train_counter : decode_counter;\n  end\"\"\")\n      # Split out the empty fast path and make queue payload validity implicit.\n      text = text.replace('\"'received.payload.valid = imem_ready;', \\\"received.payload.valid = 1'b1;\\\")\n      text = text.replace('    out = issuing.payload;', '    out = issuing.payload;\\\\n    out.valid = \"'!empty || imem_ready;'\"')\n    else:\n      text = text.replace('  logic [5:0]  fetch_index;', \\\"\\\"\\\"  logic pending_valid_q;\n  logic [5:0] pending_index_q;\n  logic [1:0] pending_counter_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) pending_valid_q <= 1'b0;\n    else       pending_valid_q <= train_valid;\n    if (train_valid) begin\n      pending_index_q   <= train_index;\n      pending_counter_q <= train_counter;\n    end\n  end\n\n  logic [5:0]  fetch_index;\\\"\\\"\\\")\n      pos = text.index('  always_ff', text.index('assign predict_taken'))\n      text = text[:pos] + text[pos:].replace('train_valid', 'pending_valid_q').replace('train_index', 'pending_index_q').replace('train_counter', 'pending_counter_q')\n      q = path / 'core.sv'\n      core = q.read_text()\n      pos = core.index('  assign train_index')\n      core = core[:pos] + \\\"\\\"\\\"  logic [1:0] last_counter_q;\n  logic [5:0] last_index_q;\n  logic last_valid_q;\n  id_ex_t ex_with_train;\n\n  always_ff @(posedge clock) begin\n    if (reset) last_valid_q <= 1'b0;\n    else if (train_valid) begin\n      last_valid_q <= 1'b1;\n      last_index_q <= train_index;\n      last_counter_q <= train_counter;\n    end\n  end\n\n  always_comb begin\n    ex_with_train = id_ex_w;\n    if (last_valid_q && last_index_q == train_index)\n      ex_with_train.direction_counter = last_counter_q;\n  end\n\n\\\"\\\"\\\" + core[pos:]\n      core = core.replace('    .in              (id_ex_w),', '    .in              (ex_with_train),')\n      q.write_text(core)\n    p.write_text(text)\nPY\npython3 \\\"\"'$p/training_variants.py\" \"$p\"\nprintf '\"'%s\\\\n' shift2f_decode shift3n_decode shift4f_decode shift2f_delayed shift3n_delayed shift4f_delayed | xargs -P 4 -I '{}' bash \\\"\"'$p/run_variant.sh\" \"$p\" '\"'{}'\npython3 - \\\"\"'$p\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nimport json, sys\nfor p in sorted(Path(sys.argv[1]).glob('shift*_*.jsonl')):\n    r = json.loads(p.read_text().splitlines()[-1])\n    print(p.name, r['bench_stop_cycle']-r['bench_start_cycle'], r['ebreak'], r['oob'], validate_coremark_uart(r['uart'], 10))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
