 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b001\n…[11348 of 14420 chars elided by tools/bench/transcript.py; sha256:28b4996c305872ff]…\nit):\ncores/bench/rtl/ex_stage.sv:15:module ex_stage (\ncores/bench/rtl/wb_stage.sv:1:// rtl/wb_stage.sv\ncores/bench/rtl/wb_stage.sv:10:module wb_stage (\ncores/bench/rtl/core.sv:7://   |    +-----+    forward_unit drives EX-stage rs1/rs2 muxes\ncores/bench/rtl/core.sv:125:  id_stage u_id (\ncores/bench/rtl/core.sv:151:  ex_stage u_ex (\ncores/bench/rtl/core.sv:173:  mem_stage u_mem (\ncores/bench/rtl/core.sv:187:  wb_stage u_wb (\ncores/bench/rtl/core.sv:211:  forward_unit u_fwd (\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 66.827\n  lut4: 4034\n  ff: 1362\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261121-003-r5s2\n  updated: '2026-11-21T16:04:49.849328Z'\n", "exit_code": 0, "status": "completed"}}
