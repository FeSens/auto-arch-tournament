{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"ls -la cores/bench/test && sed -n '1,260p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "total 100\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 21 17:49 .\ndrwxrwx---+ 5 nobody nogroup  4096 Nov 21 17:49 ..\n-rw-rw----+ 1 nobody nogroup  2143 Nov 21 17:49 _helpers.py\n-rw-rw----+ 1 nobody nogroup   361 Nov 21 17:49 conftest.py\n-rw-rw----+ 1 nobody nogroup  2923 Nov 21 17:49 test_alu.py\n-rw-rw----+ 1 nobody nogroup 11218 Nov 21 17:49 test_decoder.py\n-rw-rw----+ 1 nobody nogroup  5891 Nov 21 17:49 test_div_unit.py\n-rw-rw----+ 1 nobody nogroup  2478 Nov 21 17:49 test_imm_gen.py\n-rw-rw----+ 1 nobody nogroup  3467 Nov 21 17:49 test_mul_unit.py\n-rw-rw----+ 1 nobody nogroup 37165 Nov 21 17:49 test_pipeline.py\n-rw-rw----+ 1 nobody nogroup  3204 Nov 21 17:49 test_reg_file.py\n\"\"\"RV32M arithmetic, latency and handshake tests for the clocked divider.\"\"\"\nfrom __future__ import annotations\n\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert dut.ready.value == 1 and dut.done.value == 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.ready.value == 1 and dut.done.value == 0\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await _tick(dut)\n    dut.start.value = 0\n    assert dut.ready.value == 0 and dut.done.value == 0\n\n\nasync def _check(dut, op, a, b, expected, hold_cycles=0):\n    await _start(dut, op, a, b)\n\n    # Change every input after launch, including requesting another operation\n    # during the calculation and while a result is waiting for consumption.\n    dut.op.value = ALU_DIVU if op != ALU_DIVU else ALU_REM\n    dut.a.value = (a ^ MASK32) & MASK32\n    dut.b.value = (b ^ MASK32) & MASK32\n    dut.start.value = 1\n    await _tick(dut)  # Prepare from the operands captured at\n…[3498 of 6570 chars elided by tools/bench/transcript.py; sha256:2265fb8b1a991d43]…\nD and 3D in the radix-4 comparisons.\n    pairs += [(MASK32, b) for b in (0x55555555, 0x55555556, 0x80000000, MASK32)]\n    for a, b in pairs:\n        for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n            await _check(dut, op, a, b, _reference(op, a, b), hold_cycles=3)\n\n\n@cocotb.test()\nasync def completion_holds_until_consumed(dut):\n    await _reset(dut)\n    await _check(dut, ALU_REM, -37, 5, -2, hold_cycles=5)\n    await _check(dut, ALU_DIVU, MASK32, 0x80000000, 1, hold_cycles=9)\n\n\n@cocotb.test()\nasync def reset_cancels_divide(dut):\n    await _reset(dut)\n    for cycles_before_reset in (0, 1, 4, 8):\n        await _start(dut, ALU_DIV, 19, 5)\n        for _ in range(cycles_before_reset):\n            await _tick(dut)\n        assert dut.done.value == (cycles_before_reset == 8)\n        await _reset(dut)\n        await _check(dut, ALU_REMU, 3, 2, 1)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
