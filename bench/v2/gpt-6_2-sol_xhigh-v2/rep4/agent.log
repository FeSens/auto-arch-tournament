{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/58928045/5e018585/r13s1-profile.oB84fK/make-probe.py' <<'PY'\nfrom pathlib import Path\nimport re\nimport sys\n\nbase = Path(sys.argv[1])\nrtl = Path(sys.argv[2])\n\ndef edit(name, changes):\n    text = (base / (name + '.sv')).read_text()\n    for a, b in changes:\n        assert a in text, (name, a)\n        text = text.replace(a, b)\n    (rtl / (name + '.sv')).write_text(text)\n\nedit('core_pkg', [\n    ('    logic [11:0] addr_offset;', '''    logic [11:0] addr_offset;\n    logic        paired_branch, paired_load;\n    logic [1:0]  paired_alias;'''),\n    ('    logic        is_divide;', '''    logic        is_divide;\n    logic        paired_branch, pair_response_used;\n    logic [1:0]  paired_alias;\n    logic [3:0]  pair_byte_match, pair_byte_mask;\n    logic        pair_extension_match, pair_fallback_equal;\n    logic        pair_beq, pair_negative, pair_misaligned;\n    logic        pair_pred_taken, pair_last_word;\n    logic [5:0]  pair_train_index;\n    logic [31:0] pair_sequential_pc, pair_direct_target;'''),\n])\n\nedit('core', [\n    ('  operand_sel_t rs1_sel, rs2_sel;', '''  operand_sel_t rs1_sel, rs2_sel;\n  logic paired_branch, paired_load;\n  logic [1:0] paired_alias;\n  logic [1:0] response_width;\n  logic [3:0] response_mask;\n  logic response_sext, response_writes;\n  logic late_redirect, late_direct, late_sequential;\n  logic late_train_valid, late_train_taken, late_train_negative;\n  logic [5:0] late_train_index;\n\n  assign late_redirect = late_direct || late_sequential;'''),\n    ('    .redirect        (redirect),', '''    .redirect        (redirect),\n    .late_direct     (late_direct),\n    .late_sequential (late_sequential),\n    .late_train_valid    (late_train_valid),\n    .late_train_taken    (late_train_taken),\n    .late_train_negative (late_train_negative),\n    .late_train_index    (late_train_index),''')