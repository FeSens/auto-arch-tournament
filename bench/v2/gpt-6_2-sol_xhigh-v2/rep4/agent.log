n\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[12526 of 15598 chars elided by tools/bench/transcript.py; sha256:58c7f5ea77475113]…\netail': 'no ELFs found'}\n\n    # 1. Full-trace cosim of small ELFs (parallel).\n    with ThreadPoolExecutor() as pool:\n        futures = {pool.submit(run_one, elf, sim_bin, worktree, env, flags): elf\n                   for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n20:    wire [31:0] imem_addr;\n21:    wire [31:0] dmem_addr;\n27:        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n28:        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n29:        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n30:        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n36:        .io_imemAddr        (imem_addr),\n39:        .io_dmemAddr        (dmem_addr),\n41:        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n57:        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n59:        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n61:        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n65:        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n", "exit_code": 0, "status": "completed"}}
