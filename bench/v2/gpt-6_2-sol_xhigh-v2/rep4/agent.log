{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\n\nrtl = Path('cores/bench/rtl')\ndef edit(name, replacements):\n    path = rtl / (name + '.sv')\n    src = path.read_text()\n    for old, new in replacements:\n        assert old in src, (name, old)\n        src = src.replace(old, new, 1)\n    path.write_text(src)\n\nedit('core_pkg', [\n    ('  localparam operand_sel_t OPERAND_FALLBACK = 3\\\\'b001;\\\\n',''),\n    ('  operand_sel_t rs1_sel;\\\\n    operand_sel_t rs2_sel;\\\\n    operand_sel_t alu_a_sel;\\\\n    operand_sel_t alu_b_sel;', '  logic        rs1_late;\\\\n    logic        rs2_late;\\\\n    logic        alu_a_late;\\\\n    logic        alu_b_late;'),\n])\nedit('id_stage', [\n    ('  input  operand_sel_t      rs1_sel,', '  input  logic [31:0]       mem_value,\\\\n  input  operand_sel_t      rs1_sel,'),\n    ('  id_ex_t reg_q;', '''  id_ex_t reg_q;\n  logic [31:0] captured_rs1, captured_rs2;\n\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic unused_fallback_selects;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign unused_fallback_selects = rs1_sel[0] \"'^ rs2_sel[0];\n  assign captured_rs1 = rs1_sel[1] ? mem_value : rs1_data;\n  assign captured_rs2 = rs2_sel[1] ? mem_value : rs2_data;'\"'''),\n    ('''      reg_q.rs1_val  <= rs1_data;\n      reg_q.rs2_val  <= rs2_data;\n      reg_q.rs1_sel  <= rs1_sel;\n      reg_q.rs2_sel  <= rs2_sel;\n      reg_q.alu_a_sel  <= dec_is_auipc ? OPERAND_FALLBACK : rs1_sel;\n      reg_q.alu_b_sel  <= dec_alu_src  ? OPERAND_FALLBACK : rs2_sel;\n      reg_q.alu_a_base <= dec_is_auipc ? in.pc : rs1_data;\n      reg_q.alu_b_base <= dec_alu_src  ? imm   : rs2_data;''',\n    '''      reg_q.rs1_val  <= captured_rs1;\n      reg_q.rs2_val  <= captured_rs2;\n      reg_q.rs1_late <= rs1_sel[2];\n      reg_q.rs2_late <= rs2_sel[2];\n      reg_q.alu_a_late <= \"'!dec_is_auipc && rs1_sel[2];\n      reg_q.alu_b_late <= !dec_alu_src  && rs2_sel[2];\n      reg_q.alu_a_base <= dec_is_auipc ? in.pc : captured_rs1;\n      reg_q.alu_b_base <= dec_alu_src  ? imm   : captured_rs2;'\"'''),\n])\nedit('mem_stage', [\n    ('  output mem_wb_t  divide_commit,','  output logic [31:0]        issue_value,\\\\n  output mem_wb_t  divide_commit,'),\n    ('  always_comb begin\\\\n    next_wb.pc','  assign issue_value = in.ctrl.mem_to_reg ? load_data : in.alu_result;\\\\n\\\\n  always_comb begin\\\\n    next_wb.pc'),\n    ('next_wb.write_value = in.ctrl.mem_to_reg ? load_data : in.alu_result;', 'next_wb.write_value = issue_value;'),\n])\nedit('ex_stage', [\n    ('  input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_value (registered)\\\\n',''),\n    ('''  assign rs1 = ({32{in.rs1_sel[2]}} & fwd_ex_mem)\n             | ({32{in.rs1_sel[1]}} & fwd_mem_wb)\n             | ({32{in.rs1_sel[0]}} & in.rs1_val);\n  assign rs2 = ({32{in.rs2_sel[2]}} & fwd_ex_mem)\n             | ({32{in.rs2_sel[1]}} & fwd_mem_wb)\n             | ({32{in.rs2_sel[0]}} & in.rs2_val);\n  assign alu_a = ({32{in.alu_a_sel[2]}} & fwd_ex_mem)\n               | ({32{in.alu_a_sel[1]}} & fwd_mem_wb)\n               | ({32{in.alu_a_sel[0]}} & in.alu_a_base);\n  assign alu_b = ({32{in.alu_b_sel[2]}} & fwd_ex_mem)\n               | ({32{in.alu_b_sel[1]}} & fwd_mem_wb)\n               | ({32{in.alu_b_sel[0]}} & in.alu_b_base);''', '''  assign rs1   = in.rs1_late   ? fwd_ex_mem : in.rs1_val;\n  assign rs2   = in.rs2_late   ? fwd_ex_mem : in.rs2_val;\n  assign alu_a = in.alu_a_late ? fwd_ex_mem : in.alu_a_base;\n  assign alu_b = in.alu_b_late ? fwd_ex_mem : in.alu_b_base;'''),\n])\nedit('core', [\n    ('  operand_sel_t rs1_sel, rs2_sel;', '  operand_sel_t rs1_sel, rs2_sel;\\\\n  logic [31:0] mem_issue_value;'),\n    ('    .rs1_sel  (rs1_sel),', '    .mem_value (mem_issue_value),\\\\n    .rs1_sel  (rs1_sel),'),\n    ('    .fwd_mem_wb      (mem_wb_w.write_value),\\\\n',''),\n    ('    .divide_commit  (divide_commit),','    .issue_value    (mem_issue_value),\\\\