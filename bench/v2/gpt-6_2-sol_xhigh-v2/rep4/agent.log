{"type": "item.started", "item": {"id": "item_92", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY' > \\\"\"'$TMPDIR/bench-fetch-transition-proof.log\" 2>&1\nfrom pathlib import Path\nimport subprocess\nimport tempfile\n\nrtl = Path(\"cores/bench/rtl\")\ncurrent = (rtl / \"if_stage.sv\").read_text()\nreference = subprocess.check_output([\"git\", \"show\", \"HEAD:cores/bench/rtl/if_stage.sv\"], text=True)\nports = \"\"\"output if_id_t out,\n  output logic [855:0] state,\n  output logic geometry, index_consistent\n\"\"\"\nexport_state = \"\"\"\n  assign state[365:0] =\n      {train_pending_q, pending_index_q, pending_counter_q, counter_valid,\n       predicted_pc_q, recovery_pending_q, select_sequential_q, select_direct_q,\n       select_indirect_q, parked_q, recovery_sequential_pc_q, recovery_direct_target_q,\n       read_ptr_q, write_ptr_q, occupancy_q};\n  for (genvar i = 0; i < 64; i++) begin : export_prediction_ram\n    assign state[366 + 3*i +: 3] = {direction_table[i], fetch_direction_table[i]};\n  end\n  for (genvar i = 0; i < 5; i++) begin : export_queue\n    assign state[558 + 95*i +: 95] = slots_q[i];\n  end\n  assign geometry = $onehot({!recovery_pending_q, select_sequential_q,\n                              select_direct_q, select_indirect_q})\n                 && predicted_pc_q[1:0] == 0 && recovery_sequential_pc_q[1:0] == 0\n                 && (!select_direct_q || recovery_direct_target_q[1:0] == 0);\n\"\"\"\n# The first 189 bits are scalar state, the next 192 store predictors,\n# and the final 475 are the queue payloads.\nexport_state = export_state.replace(\"[365:0]\", \"[188:0]\").replace(\"366 +\", \"189 +\").replace(\"558 +\", \"381 +\")\nexport_index = \"\"\"\n  assign index_consistent =\n      predicted_index_q == (predicted_pc_q[7:2] ''^ predicted_pc_q[13:8])\n   && recovery_sequential_index_q == (recovery_sequential_pc_q[7:2] ''^ recovery_sequential_pc_q[13:8])\n   && recovery_direct_index_q == (recovery_direct_target_q[7:2] ''^ recovery_direct_target_q[13:8]);\n\"\"\"\n\ndef instrument(source, module, index_check):\n    src = source.replace(\"module if_stage (\", f\"module {module} (\", 1)\n    src = src.replace(\"output if_id_t  out'\"\\\\n\\\", ports, 1)\n    return src.rstrip().removesuffix(\\\"endmodule\\\") + export_state + index_check + \\\"endmodule\\\\n\\\"\n\ntop = \\\"\\\"\\\"\nmodule if_transition_equiv (\n  input logic clock, reset, issue_hold, redirect, ex_advance,\n  input logic ex_direct_taken, ex_indirect_taken,\n  input logic [31:0] ex_sequential_pc, ex_direct_target, mem_indirect_target,\n  input logic train_valid,\n  input logic [5:0] train_index,\n  input logic [1:0] train_counter,\n  input logic [31:0] imem_data,\n  input logic imem_ready\n);\n  logic [31:0] ref_addr, new_addr;\n  if_id_t ref_out, new_out;\n  logic [855:0] ref_state, new_state;\n  logic ref_geometry, new_geometry, ref_index_ok, new_index_ok;\n\n  if_stage_reference reference_stage (\n    clock, reset, issue_hold, redirect, ex_advance, ex_direct_taken, ex_indirect_taken,\n    ex_sequential_pc, ex_direct_target, mem_indirect_target, train_valid, train_index,\n    train_counter, ref_addr, imem_data, imem_ready, ref_out, ref_state, ref_geometry, ref_index_ok\n  );\n  if_stage_changed changed_stage (\n    clock, reset, issue_hold, redirect, ex_advance, ex_direct_taken, ex_indirect_taken,\n    ex_sequential_pc, ex_direct_target, mem_indirect_target, train_valid, train_index,\n    train_counter, new_addr, imem_data, imem_ready, new_out, new_state, new_geometry, new_index_ok\n  );\n\n  always_comb begin\n    if (reset) assume (\"'!redirect && !ex_advance);\n    assume (!(ex_direct_taken && ex_indirect_taken));\n    assume (ex_sequential_pc[1:0] == 0);\n    if (ex_direct_taken) assume (ex_direct_target[1:0] == 0);\n    assume (mem_indirect_target[1:0] == 0);\n\n    assert (ref_addr == new_addr);\n    assert (ref_out == new_out);\n    if ($initstate) begin\n      assume (ref_state == new_state);\n      assume (new_geometry && new_index_ok);\n    end else begin\n      assert (ref_state == new_state);\n      assert (new_geometry && new_index_ok);\n    end\n  end\nendmodule\n\"\"\"\n\nwith tempfile.TemporaryDirectory(prefix=\"bench-fetch-transition-\") as scratch:\n    source = Path(scratch) / \"if_transition.sv\"\n    source.write_text(instrument(reference, \"if_stage_reference\", \"  assign index_consistent = 1'\"'b1;\\\\n\\\")\n                      + instrument(current, \\\"if_stage_changed\\\", export_index) + top)\n    command = (f\\\"read_verilog -sv -formal {rtl / 'core_pkg.sv'} {source}; \\\"\n               \\\"prep -top if_transition_equiv -flatten; chformal -lower; \\\"\n               \\\"memory_map; opt; sat -seq 2 -set-assumes -prove-asserts -verify\\\")\n    raise SystemExit(subprocess.run([\\\"timeout\\\", \\\"150\\\", \\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", command]).returncode)\nPY\nresult=\"'$?\ntail -28 \"$TMPDIR/bench-fetch-transition-proof.log\"\nexit \"$result\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
