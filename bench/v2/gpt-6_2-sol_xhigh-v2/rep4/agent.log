{"type": "item.completed", "item": {"id": "item_120", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/if_stage.sv; cat cores/bench/implementation_notes.md'", "aggregated_output": "diff --git a/cores/bench/rtl/if_stage.sv b/cores/bench/rtl/if_stage.sv\nindex a3355b3..40d6923 100644\n--- a/cores/bench/rtl/if_stage.sv\n+++ b/cores/bench/rtl/if_stage.sv\n@@ -1,7 +1,8 @@\n // rtl/if_stage.sv\n //\n-// Predict from the active bus word and look two words ahead in the replay\n-// RAM. A ready bus word can bypass an empty queue. Replay uses the queue.\n+// Predict from the active bus word and read the possible next PCs in\n+// parallel. A ready bus word can bypass an empty queue. Replay uses it\n+// only for ordered enqueue, and enters decode through the queue head.\n // Registered EX recovery replaces the bus request and flushes the queue.\n module if_stage (\n   input  logic              clock,\n@@ -56,7 +57,7 @@ module if_stage (\n   logic        recovery_sequential_last_word_q, recovery_direct_last_word_q;\n   logic        request_in_window, request_last_word;\n   logic        parked_q, park;\n-  logic        stale_request_q;\n+  logic        stale_request_q, await_corrected_q;\n   logic [17:0] held_word_q;\n \n   // Select the registered address and its window flags in parallel.\n@@ -165,100 +166,100 @@ module if_stage (\n     end\n   end\n \n-  // A synchronous lookup starts two words ahead of the registered producer.\n-  // Repeating the lookup during a hold leaves the current and next word's\n-  // slots intact because each word selects a slot with its low two bits.\n+  localparam int RETAIN_BANK = 0, SEQUENTIAL_BANK = 1, DIRECT_BANK = 2, REPLAY_BANK = 3;\n+\n   typedef struct packed {\n     logic [31:0] instr;\n     logic        taken;\n-    logic [17:0] target;\n-  } prediction_t;\n+    logic [17:0] successor;\n+    logic [5:0]  successor_index;\n+    logic        successor_last;\n+  } replay_payload_t;\n \n   typedef struct packed {\n     logic        valid;\n     logic [7:0]  tag;\n-    prediction_t prediction;\n-  } prediction_record_t;\n-\n-  prediction_t replay_prediction;\n-  prediction_record_t fill_record_q, lookup_record_q;\n-  localparam int PREDICTION_WIDTH = $bits(replay_prediction);\n-  localparam int RECORD_WIDTH = $bits(look\n…[13478 of 16550 chars elided by tools/bench/transcript.py; sha256:149d4c3a022e9dc8]…\ncross all four banks. The new taken-target test warms distinct target and sequential instructions under the same tag, stalls the target response, and checks the exact retirement and store sequence.\n\n## Local verification\n\n- The requested Verilator lint command passed without warnings.\n- The unchanged single-issue `formal/run_all.sh` gate passed 53 checks with the one-hot payload mux. The suite is running again for the indexed payload mux.\n- `make cosim TARGET=bench` passed with `NRET=1` for selftest and all three random ELFs with ready and stalled buses. CoreMark reproduced all five canonical CRCs and completed in 3,241,015 marker-bracketed cycles with both stalls enabled.\n- Gowin placements reached 90.197, 90.822, and 90.822 MHz with 21 block RAMs. The median yields 280.23 CoreMark iterations per second at the measured cycle count, a 5.80% gain over the champion. The longest path at the median placement runs from a replay RAM output to the registered producer PC. The 91 MHz target remains open by 0.178 MHz.\n", "exit_code": 0, "status": "completed"}}
