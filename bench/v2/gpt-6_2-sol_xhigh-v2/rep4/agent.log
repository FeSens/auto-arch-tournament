{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -c 'profile_dir=\"$TMPDIR/predictor-profile\"\npython3 - \"$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, sys\nroot=Path(sys.argv[1])\nfor name, depth in [('shift4_shortpc',4), ('shift2_shortpc',2)]:\n    src=root/name\n    shutil.copytree(root/'shift4_window',src)\n    p=src/'if_stage.sv'\n    s=p.read_text().replace('  localparam integer DEPTH = 4;', f'  localparam integer DEPTH = {depth};')\n    s=s.replace('  logic final_word, final_sequential, boundary_wait_q;', '  logic final_word, final_sequential, boundary_wait_q, pc_in_window;')\n    s=s.replace(\\\"  assign final_word = pc == 32'h000f_fffc;\\\", \\\"  assign pc_in_window = pc[31:20] == '0;\\\\n  assign final_word = pc == 32'h000f_fffc;\\\")\n    s=s.replace('&& (\"'!final_sequential || bypass);'\"', '&& ((\"'!final_sequential && pc_in_window) || bypass);'\"')\n    s=s.replace('  assign received.payload.pc = pc;', '  assign received.payload.pc = {12\\\\'b0, pc[19:2], 2\\\\'b0};')\n    s=s.replace(\\\"&& pc[31:20] == 12'b0\\\", '&& pc_in_window')\n    p.write_text(s)\nPY\nprintf '%s\\\\n' shift4_shortpc shift2_shortpc | xargs -P 2 -I '{}' bash \\\"\"'$profile_dir/run_variant.sh\" \"$profile_dir\" '\"'{}'\npython3 - \\\"\"'$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart\nimport json, sys\nfor p in sorted(Path(sys.argv[1]).glob('shift*_shortpc.jsonl')):\n    r = json.loads(p.read_text().splitlines()[-1])\n    print(p.name, r['bench_stop_cycle']-r['bench_start_cycle'], r['ebreak'], r['oob'], validate_coremark_uart(r['uart'], 10))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
