{"type": "item.completed", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/rtl/div_unit.sv && sed -n '1,230p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "// Launch captures the operands. Preparation and seven reciprocal pipeline\n// updates follow. Completion holds until the EX/MEM transfer consumes it.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        consume,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        ready,\n  output logic        done,\n  output logic [31:0] result\n);\n\n  logic       active_q;\n  logic       prepare_q;\n  logic [2:0] cycles_left_q;\n  logic       launch;\n  logic       iterate;\n  logic [4:0] op_q;\n  logic [31:0] a_q, b_q;\n\n  assign ready   = !active_q;\n  assign done    = active_q && !prepare_q && (cycles_left_q == 3'd0);\n  assign launch  = start && ready && !reset;\n  assign iterate = active_q && !prepare_q && !done;\n\n  always_ff @(posedge clock) begin\n    if (launch) begin\n      op_q <= op;\n      a_q  <= a;\n      b_q  <= b;\n    end\n\n    prepare_q <= launch;\n    if (reset) begin\n      active_q      <= 1'b0;\n      cycles_left_q <= 3'd0;\n    end else if (launch) begin\n      active_q      <= 1'b1;\n    end else if (prepare_q) begin\n      cycles_left_q <= 3'd7;\n    end else if (iterate) begin\n      cycles_left_q <= cycles_left_q - 3'd1;\n    end else if (done && consume) begin\n      active_q      <= 1'b0;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  // Keep the native divider's handshake and update schedule.\n  logic [31:0] alt_mask;\n  logic [31:0] alt_result_q;\n\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  alt_mask = 32'h7f8529ec;\n      ALU_DIVU: alt_mask = 32'h10e8fd70;\n      ALU_REM:  alt_mask = 32'h8da68fa5;\n      ALU_REMU: alt_mask = 32'h3138d0e1;\n      default:  alt_mask = 32'b0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (prepare_q && !reset) alt_result_q <= (a_q - b_q) ^ alt_mask;\n  end\n\n  assign result = alt_result_q;\n`else\n  logic        signed_op, a_negative, b_negative;\n  logic        remainder_op_q, remainder_negative_q, quotient_negative_q;\n  logic        divisor_zero_q;\n  logic [31:0] dividen\n…[11703 of 14775 chars elided by tools/bench/transcript.py; sha256:8d940557579294ff]…\nck(dut, op, a, b, _reference(op, a, b))\n\n\n@cocotb.test()\nasync def zero_divisor(dut):\n    await _reset(dut)\n    for a in (0, 123, -123, 0x80000000, MASK32):\n        for op in DIV_OPS:\n            await _check(dut, op, a, 0, _reference(op, a, 0), hold_cycles=2)\n\n\n@cocotb.test()\nasync def completion_holds_until_consumed(dut):\n    await _reset(dut)\n    await _check(dut, ALU_REM, -37, 5, -2, hold_cycles=5)\n    await _check(dut, ALU_DIVU, MASK32, 0x80000000, 1, hold_cycles=9)\n\n\n@cocotb.test()\nasync def reset_cancels_divide(dut):\n    await _reset(dut)\n    for cycles_before_reset in range(9):\n        await _start(dut, ALU_DIV, 19, 5)\n        for _ in range(cycles_before_reset):\n            await _tick(dut)\n        assert dut.done.value == (cycles_before_reset == 8)\n        await _reset(dut)\n        await _check(dut, ALU_REMU, 3, 2, 1)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_seed_rom.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
