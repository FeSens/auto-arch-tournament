rain_valid(train_valid),\n    .train_index(train_index),\n    .train_counter(train_counter),\n    .imem_data(imem_data),\n    .imem_ready(imem_ready),\n    .imem_addr(new_addr),\n    .out(new_out),\n    .state(new_state),\n    .geometry(new_geometry),\n    .index_consistent(new_index_ok)\n  );\n\n  always_comb begin\n    if (reset) assume (\"'!redirect && !ex_advance);\n    assume (!(ex_direct_taken && ex_indirect_taken));\n    assume (ex_sequential_pc[1:0] == 0);\n    if (ex_direct_taken) assume (ex_direct_target[1:0] == 0);\n    assume (mem_indirect_target[1:0] == 0);\n\n    assert (ref_addr == new_addr);\n    assert (ref_out == new_out);\n    if ($initstate) begin\n      assume (ref_state == new_state);\n      assume (new_geometry && new_index_ok);\n    end else begin\n      assert (ref_state == new_state);\n      assert (new_geometry && new_index_ok);\n    end\n  end\nendmodule\n\"\"\"\n\nwith tempfile.TemporaryDirectory(prefix=\"bench-fetch-transition-\") as scratch:\n    source = Path(scratch) / \"if_transition.sv\"\n    source.write_text(instrument(reference, \"if_stage_reference\", \"  assign index_consistent = 1'\"'b1;\\\\n\\\")\n                      + instrument(current, \\\"if_stage_changed\\\", export_index) + top)\n    command = (f\\\"read_verilog -sv -formal {rtl / 'core_pkg.sv'} {source}; \\\"\n               \\\"prep -top if_transition_equiv -flatten; chformal -lower; \\\"\n               \\\"memory_map; opt; sat -seq 2 -set-assumes -prove-asserts -verify\\\")\n    raise SystemExit(subprocess.run([\\\"timeout\\\", \\\"150\\\", \\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", command]).returncode)\nPY\nresult=\"'$?\ntail -30 \"$TMPDIR/bench-fetch-transition-proof.log\"\nexit \"$result\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
