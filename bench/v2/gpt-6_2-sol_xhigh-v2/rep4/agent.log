{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c \"cat > \\\"/srv/hwebench/tmp/58928045/855779d9/bench-trace.C0Naqh/multi.cpp\\\" <<'CPP'\n#define main single\n#include \\\"coverage.cpp\\\"\n#undef main\n\nstruct Model {\n    unsigned ways, delay;\n    bool priority_inner;\n    std::vector<Trace> entries;\n    std::vector<size_t> touched;\n    int owner = -1, writer = -1;\n    unsigned cursor = 0;\n    size_t hits = 0, mismatches = 0, nested = 0, publications = 0;\n    Model(unsigned count, unsigned d, bool inner)\n        : ways(count), delay(d), priority_inner(inner), entries(ways), touched(ways) {}\n    void handle(const Word &w, size_t i) {\n        for (unsigned s = 0; s < ways; ++s) {\n            auto &e = entries[s];\n            if (w.store && contains(e.header, e.tail + 3, w.addr)) {\n                e.clear();\n                if (writer == s) writer = -1;\n                if (owner == s) owner = -1;\n            }\n        }\n        if (owner < 0) {\n            for (unsigned s = 0; s < ways; ++s) {\n                auto &e = entries[s];\n                if (e.ready && w.pc == e.header && i >= e.start_at) {\n                    owner = s;\n                    cursor = 0;\n                    break;\n                }\n            }\n        }\n        if (owner >= 0) {\n            auto &e = entries[owner];\n            const auto &r = e.records[cursor];\n            if (r.pc == w.pc && r.insn == w.insn) {\n                ++hits;\n                touched[owner] = i;\n                if (r.next == w.next) {\n                    cursor = (cursor + 1) % e.records.size();\n                } else {\n                    ++mismatches;\n                    owner = -1;\n                }\n            } else {\n                owner = -1;\n            }\n        }\n        if (writer >= 0) {\n            auto &e = entries[writer];\n            if (e.waiting && w.pc == e.header) {\n                e.waiting = false;\n                e.capturing = true;\n            }\n            if (e.capturing) {\n                if ((w.insn & 127) == 103 || (w.insn & 0x707f) == 0x100f || w.trap || \"'!contains(e.header,e.tail,w.pc)\n                    || !contains(e.header,e.tail,w.next) || e.records.size() == 128) {\n                    e.clear();\n                    writer = -1;\n                } else {\n                    e.records.push_back(w);\n                    if (w.pc == e.tail && w.next == e.header) {\n                        ++publications;\n                        e.capturing = false;\n                        e.ready = true;\n                        e.start_at = i + delay + 1;\n                        touched[writer] = i;\n                        writer = -1;\n                    }\n                }\n            }\n        }\n        if (writer < 0 && w.backedge()) {\n            int victim = -1;\n            for (unsigned s = 0; s < ways; ++s) {\n                const auto &e = entries[s];\n                if (e.ready && (priority_inner ? (e.header == w.next && e.tail == w.pc)\n                                              : (e.header <= w.next && w.pc <= e.tail))) {\n                    victim = -1;\n                    ++nested;\n                    break;\n                }\n                if (s != owner && (victim < 0 || !e.ready || (entries[victim].ready && touched[s] < touched[victim]))) victim = s;\n            }\n            if (victim >= 0) {\n                auto &e = entries[victim];\n                e.clear();\n                e.header = w.next;\n                e.tail = w.pc;\n                e.waiting = true;\n                writer = victim;\n            }\n        }\n    }\n};\nint main(int argc, char** argv) {\n    std::ifstream input(argv[1]);\n    const int start = atoi(argv[2]), stop = atoi(argv[3]);\n    std::vector<Model> models;\n    for (auto w : {1, 2, 4, 8}) for (auto d : {0, 5}) for (auto p : {false, true}) models.emplace_back(w,d,p);\n