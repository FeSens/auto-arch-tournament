t('critical_paths', [])[:3], flush=True)\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    list(executor.map(trial, [(name,option) for name in ('recovery','recovery_retimed') for option in (0,1)]))\nPY\"", "aggregated_output": "recovery 0 82.859 None [{'from': 'cpu/u_ex/reg_q.effective_addr_2_s0', 'to': 'cpu/u_if/predicted_pc_q_7_s0', 'slack_ns': -7.069, 'arrival_ns': 17.363, 'logic_cells': 15, 'modules': ['clock_ibuf', 'cpu/u_if']}, {'from': 'cpu/u_ex/reg_q.effective_addr_2_s0', 'to': 'cpu/u_if/predicted_pc_q_8_s0', 'slack_ns': -7.069, 'arrival_ns': 17.363, 'logic_cells': 15, 'modules': ['clock_ibuf', 'cpu/u_if']}, {'from': 'cpu/u_ex/reg_q.effective_addr_2_s0', 'to': 'cpu/u_if/predicted_pc_q_12_s0', 'slack_ns': -7.058, 'arrival_ns': 17.353, 'logic_cells': 15, 'modules': ['clock_ibuf', 'cpu/u_if']}]\nrecovery_retimed 0 82.339 None [{'from': 'cpu/u_ex/reg_q.alu_result_21_s0', 'to': 'cpu/u_if/train_pending_q_s0', 'slack_ns': -7.145, 'arrival_ns': 17.439, 'logic_cells': 11, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_if', 'cpu/u_ex']}, {'from': 'cpu/u_ex/reg_q.alu_result_5_s0', 'to': 'cpu/u_ex/reg_q.effective_addr_30_s0', 'slack_ns': -7.133, 'arrival_ns': 17.428, 'logic_cells': 17, 'modules': ['clock_ibuf', 'cpu/u_ex']}, {'from': 'cpu/u_ex/reg_q.alu_result_5_s0', 'to': 'cpu/u_ex/reg_q.effective_addr_31_s0', 'slack_ns': -7.133, 'arrival_ns': 17.428, 'logic_cells': 17, 'modules': ['clock_ibuf', 'cpu/u_ex']}]\nrecovery 1 87.018 None [{'from': 'cpu/u_ex/reg_q.effective_addr_2_s0', 'to': 'cpu/u_if/predicted_pc_q_15_s0', 'slack_ns': -6.492, 'arrival_ns': 16.786, 'logic_cells': 15, 'modules': ['clock_ibuf', 'cpu/u_if']}, {'from': 'cpu/u_ex/reg_q.effective_addr_2_s0', 'to': 'cpu/u_if/predicted_pc_q_17_s0', 'slack_ns': -6.492, 'arrival_ns': 16.786, 'logic_cells': 15, 'modules': ['clock_ibuf', 'cpu/u_if']}, {'from': 'cpu/u_if/read_ptr_q_1_s0', 'to': 'cpu/u_id/reg_q.alu_a_base_11_s0', 'slack_ns': -6.488, 'arrival_ns': 16.783, 'logic_cells': 11, 'modules': ['clock_ibuf', 