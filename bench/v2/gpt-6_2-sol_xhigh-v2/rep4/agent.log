{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\ndef check():\n    cases=0\n    for count, recover, hold, mode in product(range(6), (0,1), (0,1), ('none','bus','replay')):\n        n = 0 if recover else count\n        bus = mode=='bus' and n\"'!=5\n        replay = mode=='\"'replay' and n\"'!=5 and not recover\n        pop = bool(n and not hold)\n        enqueue = bool(replay or bus and (n or hold))\n        accept = bus or replay\n        expect = n - pop + enqueue\n        occ = (1 << n) - 1\n        held = ((occ << 1) | 1) if accept else occ\n        issuing = (occ | int(replay)) if accept else (occ >> 1)\n        assert (held if hold else issuing) == (1 << expect) - 1\n        entries = list(range(n))\n        expected = entries[pop:] + ([99] if enqueue else [])\n        front = entries[0] if entries else None\n        tail = entries[1:]\n        append = accept and (n>=2 or n and hold)\n        refill = (not n and accept) if hold else (n>=2 or accept and (n or replay))\n        if refill:\n            front = tail[0] if tail else 99\n        if not hold and n>=2:\n            tail = tail[1:]\n        if append:\n            tail = tail + [99]\n        actual = [front]+tail if expect else []\n        assert actual == expected, (n,hold,mode,actual,expected)\n        cases += 1\n    return cases\nprint(f'\"'Equivalent FIFO transitions across {check()} admission and recovery cases')\nPY\nfor base in \\\"\"'$TMPDIR/fixed-head/later-select\" \"$TMPDIR/fixed-head/replay-bypass\" \"$TMPDIR/slot-interlock\"; do\n printf '\"'%s\\\\n' \\\"\"'$base\"\n for p in \"$base\"/timing/gowin*/impl/pnr/core_bench.tr; do if test -f \"$p\"; then rg -m1 '\"'200.000\\\\(MHz\\\\)' \\\"\"'$p\"; fi; done\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
