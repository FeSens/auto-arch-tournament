{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c 'proposal_scratch=\"$TMPDIR/bench-rf-issue.FwieuV\"\nPROPOSAL_SCRATCH=\"$proposal_scratch\" python - <<'\"'PY'\nimport os\nfrom pathlib import Path\nroot = Path(os.environ['PROPOSAL_SCRATCH']) / 'test'\npipe = root / 'test_pipeline.py'\nsource = pipe.read_text()\nsource = source.replace('store_stalls=None, accepted_stores=None):', 'store_stalls=None, accepted_stores=None, fetch_stalls=None):')\nsource = source.replace('    held_store = None\\\\n    pending_store', '    fetch_stalls = dict(fetch_stalls or {})\\\\n    held_store = None\\\\n    pending_store', 1)\nsource = source.replace('        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())', '''        if fetch_stalls.get(ia, 0) > 0:\n            dut.io_imemReady.value = 0\n            fetch_stalls[ia] -= 1\n        else:\n            dut.io_imemReady.value = 1\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())''')\nsource = source.replace('\\\"hazard_unit.sv\\\", \\\"forward_unit.sv\\\",', '\\\"hazard_unit.sv\\\",')\nsource += '''\n\n@cocotb.test()\nasync def capture_match_priority_and_held_writeback(dut):\n    young_consumer = ADDI(23, 20, 0)\n    held_consumer = ADDI(22, 21, 1)\n    program = [\n        ADDI(20, 0, 1), ADDI(20, 0, 2), young_consumer,\n        ADDI(21, 0, 9), SW(0, 0, 4), held_consumer,\n        SW(22, 0, 8), EBREAK(),\n    ]\n    stores = []\n    retires, mem = await _run(dut, program, store_stalls={4: 3}, accepted_stores=stores)\n    assert _by_insn(retires, young_consumer)[0]['rs1_rdata'] == 2\n    assert _by_insn(retires, held_consumer)[0]['rs1_rdata'] == 9\n    assert stores == [(4, 15, 0), (8, 15, 10)]\n    assert mem[8] == 10\n    assert [r['order'] for r in retires] == list(range(len(program)))\n\n\n@cocotb.test()\nasync def raw_store_squashed_on_redirect_with_bus_stalls(dut):\n    program = [ADDI(20, 0, 55), SW(20, 0, 4), BEQ(0, 0, 8),\n               SW(20, 0, 8), SW(20, 0, 12), EBREAK()]\n    stores = []\n    retires, _ = await _run(dut, program, store_stalls={4: 3},\n                            fetch_stalls={12: 5, 16: 2}, accepted_stores=stores)\n    assert stores == [(4, 15, 55), (12, 15, 55)]\n    assert [r['pc'] for r in retires] == [0, 4, 8, 16, 20]\n    assert [r['order'] for r in retires] == list(range(5))\n'''\npipe.write_text(source)\nregs = root / 'test_reg_file.py'\nwith regs.open('a') as output:\n    output.write('''\n\n@cocotb.test()\nasync def both_banks_write_first_and_reset(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \\\"ns\\\").start())\n    await _reset(dut)\n    await _write(dut, 1, 0xAAAAAAAA)\n    await _write(dut, 17, 0xBBBBBBBB)\n    assert await _read(dut, 1, 17) == (0xAAAAAAAA, 0xBBBBBBBB)\n    dut.w_en.value = 1\n    dut.w_addr.value = 17\n    dut.w_data.value = 0xCCCCCCCC\n    assert await _read(dut, 17, 17) == (0xCCCCCCCC, 0xCCCCCCCC)\n    await _reset(dut)\n    assert await _read(dut, 1, 17) == (0, 0)\n''')\nPY\ncd \\\"\"'$proposal_scratch\" || exit\nPYTHONDONTWRITEBYTECODE=1 pytest --rootdir=. -q -p no:cacheprovider test/test_reg_file.py test/test_pipeline.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
