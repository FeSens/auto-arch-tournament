{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"sed -n '79,235p' cores/bench/test/test_pipeline.py; sed -n '925,1210p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "async def _run(dut, program, dmem_init=None, max_cycles=200, *,\n               store_stalls=None, load_stalls=None, imem_stalls=None,\n               accepted_stores=None, accepted_loads=None, fetch_trace=None,\n               imem_patch_addresses=(), stop_on_trap=False, stalled_rdata=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores update dmem on acceptance. store_stalls and load_stalls map\n    data addresses to stall counts. imem_stalls maps fetch PCs or\n    (PC, prior ready offers) pairs to stall counts. The request lists collect accepted\n    writes as (address, mask, data) and reads as byte addresses.\n    fetch_trace records (offered PC, imem ready, dmem ready) for each cycle.\n    stalled_rdata can override the data offered with ready low.\n\n    Full stores to imem_patch_addresses also update instruction memory.\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    if isinstance(program, dict):\n        imem = {pc: instr & 0xFFFFFFFF for pc, instr in program.items()}\n    else:\n        imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    store_stalls = dict(store_stalls or {})\n    load_stalls = dict(load_stalls or {})\n    imem_stalls = dict(imem_stalls or {})\n    held_request = None\n    ready_offers = {0: 1}\n    pending_store = None\n    pending_load = None\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # The buses start ready. Tests can stall individual requests below.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    f\n…[13232 of 16304 chars elided by tools/bench/transcript.py; sha256:66fcc732b885aad9]…\n_retires_logical_pc(dut):\n    fetches = []\n    rets, _ = await _run(dut, {0: JAL(1, 0xFFFFC), 0xFFFFC: ADDI(2, 1, 1)},\n                         stop_on_trap=True, fetch_trace=fetches)\n\n    assert [r[\"order\"] for r in rets] == [0, 1, 2]\n    assert [r[\"pc\"] for r in rets] == [0, 0xFFFFC, 0x100000]\n    assert [r[\"pc_next\"] for r in rets] == [0xFFFFC, 0x100000, 0x100004]\n    assert [(r[\"trap\"], r[\"rd_wdata\"]) for r in rets] == [(0, 4), (0, 5), (1, 0)]\n    assert rets[-1][\"insn\"] == 0\n    assert all(0 <= pc < 0x100000 for pc, _, _ in fetches)\n    assert [pc for pc, _, _ in fetches][-3:] == [0, 0, 0]\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\", \"replay_train.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -c 'for p in AGENTS.md cores/AGENTS.md cores/bench/AGENTS.md cores/bench/rtl/AGENTS.md cores/bench/test/AGENTS.md; do if test -f \"$p\"; then cat \"$p\"; fi; done; sed -n '\"'1,160p' formal/wrapper_si.sv; git log -5 --oneline\"","aggregated_output":"// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n        .io_rvfi_trap_0     (rvfi_trap),\n        .io_rvfi_halt_0     (rvfi_halt),\n        .io_rvfi_intr_0     (rvfi_intr),\n        .io_rvfi_mode_0     (rvfi_mode),\n        .io_rvfi_ixl_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\nee6d186 log: hyp-20261121-003-r13s2 regression\ne06324e log: hyp-20261121-002-r13s1 improvement\n9b7be47 log: hyp-20261121-001-r13s0 regression\n52ea908 hyp-20261121-002-r13s1: Separate the registered load-response and fetch-repair paths (+5.7%)\n47ae90c log: hyp-20261121-003-r12s2 regression\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"sed -n '1,248p' tools/eval/gowin.py; sed -n '90,143p' Makefile; sed -n '1,90p' bench/programs/Makefile; ls -l /opt /srv/hwebench/toolchain; env | cut -d= -f1 | sort; cat formal/checks_si.cfg\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,248p' tools/eval/gowin.py; sed -n '90,143p' Makefile; sed -n '1,90p' bench/programs/Makefile; ls -l /opt /srv/hwebench/toolchain; env | cut -d= -f1 | sort; cat formal/checks_si.cfg\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[13697 of 16769 chars elided by tools/bench/transcript.py; sha256:c2c106baa6f4d828]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
