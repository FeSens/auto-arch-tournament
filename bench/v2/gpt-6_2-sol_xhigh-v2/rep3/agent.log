{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"sed -n '340,430p' cores/bench/test/test_pipeline.py; sed -n '500,623p' cores/bench/test/test_pipeline.py; sed -n '755,990p' cores/bench/test/test_pipeline.py; sed -n '1,160p' cores/bench/test/_helpers.py\"", "aggregated_output": "        ADDI(4, 0, 0x33),     # Older x4 is on the regfile's WB bypass.\n        LW(4, 0, 0),         # MEM/WB retains the load during the store stall.\n        SW(3, 0, 4),         # Raw rd field also matches x4, with reg_write clear.\n        ADD(5, 4, rs2),      # Held in EX with a bypass and either default or bypass.\n        ADD(6, 5, 4),        # Immediately consumes the released EX result.\n        EBREAK(),\n    ]\n    stores = []\n    rets, dmem = await _run(dut, program, {0: load_value},\n                            store_stalls={4: stall_cycles}, accepted_stores=stores)\n\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert not any(r[\"trap\"] for r in rets)\n    load, store, consumer, adjacent = rets[2:6]\n    rs2_value = store_value if rs2 == 3 else load_value\n    consumer_value = load_value + rs2_value\n    assert store[\"cycle\"] - load[\"cycle\"] == stall_cycles + 1\n    assert consumer[\"cycle\"] == store[\"cycle\"] + 1\n    assert (load[\"rd\"], load[\"rd_wdata\"]) == (4, load_value)\n    assert (consumer[\"rs1_addr\"], consumer[\"rs1_rdata\"]) == (4, load_value)\n    assert (consumer[\"rs2_addr\"], consumer[\"rs2_rdata\"]) == (rs2, rs2_value)\n    assert (consumer[\"rd\"], consumer[\"rd_wdata\"]) == (5, consumer_value)\n    assert adjacent[\"cycle\"] == consumer[\"cycle\"] + 1\n    assert (adjacent[\"rs1_rdata\"], adjacent[\"rs2_rdata\"]) == (consumer_value, load_value)\n    assert (adjacent[\"rd\"], adjacent[\"rd_wdata\"]) == (6, consumer_value + load_value)\n    assert (store[\"mem_addr\"], store[\"mem_wmask\"], store[\"mem_wdata\"]) == (4, 0xF, store_value)\n    assert stores == [(4, 0xF, store_value)]\n    assert dmem == {0: load_value, 4: store_value}\n\n\n@cocotb.test()\n@cocotb.parametrize(stall_cycles=[0, 5])\nasync def load_use_stalls(dut, stall_cycles):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n    \n…[17329 of 20401 chars elided by tools/bench/transcript.py; sha256:18337f4452991672]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
