   (\"\"\"  assign redirect        = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\"\"\",\n     \"\"\"  assign redirect        = in.valid && !stall && (branch_taken || in.ctrl.is_jump) && !misalign_fault;\"\"\"),\n    (\"reg_q.ctrl          <= divide_wait ? '\"'0 : ctrl_with_trap;\\\",\n     \\\"reg_q.ctrl          <= (\"'!in.valid || divide_wait) ? '\"'0 : ctrl_with_trap;\\\"),\n])\nPY\nvariant_root=\\\"\"'$TMPDIR/bench-r3-research\"\npython3 \"$variant_root/cut.py\" \"$variant_root/radix8\" \"$variant_root/cut\"\npython3 - \"$variant_root\" <<'\"'PY'\nimport json\nfrom pathlib import Path\nimport sys\nfrom tools.eval import gowin\nroot = Path(sys.argv[1])\nout = root / 'cut-timing'\nrecords = gowin.build_all(Path.cwd(), root / 'cut', 'fpga/core_bench_si.sv', out)\nfor record in records:\n    print(json.dumps({**record, 'critical_paths': record.get('critical_paths', [])[:3]}), flush=True)\nprint(json.dumps(gowin.summarize(records)), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
