{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\npath = Path(\\\"cores/bench/test/test_pipeline.py\\\")\nsrc = path.read_text()\nsrc = src.replace(\\\"store_stalls=None, accepted_stores=None):\\\", \\\"store_stalls=None, accepted_stores=None, imem_ready=None):\\\")\nsrc = src.replace(\\\"        dut.io_imemData.value  = imem.get\\\", \n                  \\\"        if imem_ready is not None:\\\\n            dut.io_imemReady.value = imem_ready(ia)\\\\n        dut.io_imemData.value  = imem.get\\\")\nsrc = src.replace('\\\\ndef test_pipeline_runner():', '''\n@cocotb.test()\nasync def btb_alias_on_non_control_with_imem_stall(dut):\n    alias = 0x4000\n    program = [NOP()] * (alias // 4 + 2)\n    program[0] = JAL(0, 8)\n    program[2] = JAL(0, alias - 8)\n    program[alias // 4] = ADDI(1, 0, 42)\n    program[alias // 4 + 1] = EBREAK()\n    fetches = []\n\n    def imem_ready(addr):\n        fetches.append(addr)\n        return addr \"'!= 8 or fetches.count(8) == 1\n\n    rets, _ = await _run(dut, program, imem_ready=imem_ready)\n    assert fetches.count(8) == 2\n    assert [r[\"pc\"] for r in rets] == [0, 8, alias, alias + 4]\n    assert [r[\"pc_next\"] for r in rets] == [8, alias, alias + 4, alias + 8]\n    assert rets[2][\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def btb_retarget_and_trap_with_dmem_stall(dut):\n    program = [NOP()] * 15\n    program[0:4] = [ADDI(5, 0, 32), SW(5, 6, 0), JALR(1, 5, 0), EBREAK()]\n    program[8:11] = [ADDI(5, 0, 48), ADDI(6, 0, 4), JAL(0, 4 - 40)]\n    program[12:15] = [ADDI(5, 0, 34), ADDI(6, 0, 8), JAL(0, 4 - 56)]\n    stores = []\n    rets, _ = await _run(dut, program, store_stalls={4: 3, 8: 2},\n                         accepted_stores=stores)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 32, 36, 40, 4, 8, 48, 52, 56, 4, 8, 12]\n    jumps = [(r[\"pc_next\"], r[\"trap\"], r[\"rd_wdata\"]) for r in rets if r[\"pc\"] == 8]\n    assert