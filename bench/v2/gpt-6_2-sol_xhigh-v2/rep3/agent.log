{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/prototype.py' <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nsrc = Path.cwd() / 'cores/bench/rtl'\nrtl = scratch / 'rtl'\nshutil.copytree(src, rtl, dirs_exist_ok=True)\n\ndef edit(name, *replacements):\n    path = rtl / (name + '.sv')\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (path, old, text.count(old))\n        text = text.replace(old, new)\n    path.write_text(text)\n\nedit('core_pkg', ('''    logic [1:0]  ex_mem_match;  // Source tag matches, indexed as {rs2, rs1}.\n    logic [1:0]  mem_wb_match;''', '''    logic [1:0][4:0] bypass;'''))\nedit('id_stage',\n     ('''  input  logic [4:0]        ex_rd,\n  input  logic [4:0]        mem_rd,''', '''  input  logic [1:0][4:0]   bypass,'''),\n     ('''      // These destination tags advance to EX/MEM and MEM/WB at this edge.\n      reg_q.ex_mem_match <= {rs2_addr == ex_rd, rs1_addr == ex_rd} & {2{ex_rd \"'!= 5'\"'d0}};\n      reg_q.mem_wb_match <= {rs2_addr == mem_rd, rs1_addr == mem_rd} & {2{mem_rd \"'!= 5'\"'d0}};''',\n      '''      reg_q.bypass       <= bypass;'''))\nedit('core',\n     ('''  logic [1:0] fwd_ex_mem_en, fwd_mem_wb_en, fwd_reg_file_en;''',\n      '''  logic [1:0][4:0] bypass;\n  logic next_ex_write, next_mem_write, next_mul_low, next_mul_high;\n  logic [31:0] ex_normal;\n  logic [63:0] ex_product;'''),\n     ('''    .ex_rd    (id_ex_w.rd),\n    .mem_rd   (ex_mem_w.rd),''', '''    .bypass   (bypass),'''),\n     ('''    .fwd_ex_mem_en   (fwd_ex_mem_en),\n    .fwd_mem_wb_en   (fwd_mem_wb_en),\n    .fwd_reg_file_en (fwd_reg_file_en),\n    .fwd_ex_mem      (ex_mem_w.alu_result),  // selected EX/MEM result\n    .fwd_mem_wb      (mem_wb_w.write_data),''',\n      '''    .next_ex_write   (next_ex_write),\n    .next_mul_low    (next_mul_low),\n    .next_mul_high   (next_mul_high),\n    .ex_normal       (ex_normal),\n    .ex_product      (ex_product),\n    .fwd_mem_wb      (mem_wb_w.write_data),'''),\n     ('''    .dmem_ren   (io_dmemREn),\n    .out''', '''    .dmem_ren   (io_dmemREn),\n    .next_mem_write (next_mem_write),\n    .out'''),\n     ('''  // MEM/WB retains reg_write for the held EX consumer after valid clears.\n  forward_unit u_fwd (\n    .ex_mem_match    (id_ex_w.ex_mem_match),\n    .mem_wb_match    (id_ex_w.mem_wb_match),\n    .ex_mem_w_en     (ex_mem_w.ctrl.reg_write),\n    .mem_wb_w_en     (mem_wb_w.ctrl.reg_write),\n    .fwd_ex_mem_en   (fwd_ex_mem_en),\n    .fwd_mem_wb_en   (fwd_mem_wb_en),\n    .fwd_reg_file_en (fwd_reg_file_en)\n  );''',\n      '''  forward_unit u_fwd (\n    .rs1             (rs1_addr_w),\n    .rs2             (rs2_addr_w),\n    .ex_rd           (id_ex_w.rd),\n    .mem_rd          (ex_mem_w.rd),\n    .ex_write        (next_ex_write),\n    .mem_write       (next_mem_write),\n    .mul_low         (next_mul_low),\n    .mul_high        (next_mul_high),\n    .bypass          (bypass)\n  );'''))\nedit('ex_stage',\n     ('''  input  logic [1:0]         fwd_ex_mem_en,\n  input  logic [1:0]         fwd_mem_wb_en,\n  input  logic [1:0]         fwd_reg_file_en,\n  input  logic [31:0]        fwd_ex_mem,    // selected EX/MEM result\n  input  logic [31:0]        fwd_mem_wb,''',\n      '''  output logic               next_ex_write,\n  output logic               next_mul_low,\n  output logic               next_mul_high,\n  output logic [31:0]        ex_normal,\n  output logic [63:0]        ex_product,\n  input  logic [31:0]        fwd_mem_wb,'''),\n     ('''  assign rs1 = ({32{fwd_ex_mem_en[0]}}   & fwd_ex_mem)\n             | ({32{fwd_mem_wb_en[0]}}   & fwd_mem_wb)\n             | ({32{fwd_reg_file_en[0]}} & in.rs1_val);\n  assign rs2 = ({32{fwd_ex_mem_en[1]}}   & fwd_ex_mem)\n             | ({32{fwd_mem_wb_en[1]}}   & fwd_mem_wb)\n             | ({32{fwd_reg_file_en[1]}} & in.rs2_val);''',\n      '''  assign rs1 = ({32{in.bypass[0][0]}} & ex_normal)\n             | ({32{in.bypass[0][1]}} & ex_product[31:0])\n             | ({32{in.bypass[0][2]}} & ex_product[63:32])\n             | ({32{in.bypass[0][3]}} & fwd_mem_wb)\n             | ({32{in.bypass[0][4]}} & in.rs1_val);\n  assign rs2 = ({32{in.bypass[1][0]}} & ex_normal)\n             | ({32{in.bypass[1][1]}} & ex_product[31:0])\n             | ({32{in.bypass[1][2]}} & ex_product[63:32])\n             | ({32{in.bypass[1][3]}} & fwd_mem_wb)\n             | ({32{in.bypass[1][4]}} & in.rs2_val);'''),\n     ('''  always_comb begin\n    out = reg_q;''',\n      '''  assign next_ex_write = ex_valid && ctrl_with_trap.reg_write;\n  assign next_mul_low = mul_low;\n  assign next_mul_high = mul_high;\n  assign ex_normal = reg_q.alu_result;\n  assign ex_product = product_q;\n\n  always_comb begin\n    out = reg_q;'''))\nedit('mem_stage',\n     ('''  // MEM/WB register output\n  output mem_wb_t  out''', '''  output logic               next_mem_write,\n  // MEM/WB register output\n  output mem_wb_t  out'''),\n     ('''  assign out = reg_q;''', '''  assign next_mem_write = ctrl_with_trap.reg_write;\n  assign out = reg_q;'''))\n(rtl/'forward_unit.sv').write_text('''module forward_unit (\n  input  logic [4:0] rs1, rs2,\n  input  logic [4:0] ex_rd, mem_rd,\n  input  logic ex_write, mem_write,\n  input  logic mul_low, mul_high,\n  output logic [1:0][4:0] bypass\n);\n  logic [1:0] ex_hit;\n  logic [1:0] mem_hit;\n  assign ex_hit = {rs2 == ex_rd, rs1 == ex_rd} & {2{ex_write && ex_rd \"'!= 0}};\n  assign mem_hit = {rs2 == mem_rd, rs1 == mem_rd} & {2{mem_write && mem_rd != 0}};\n  for (genvar i = 0; i < 2; i++) begin : gen_select\n    assign bypass[i][0] = ex_hit[i] && !mul_low && !mul_high;\n    assign bypass[i][1] = ex_hit[i] && mul_low;\n    assign bypass[i][2] = ex_hit[i] && mul_high;\n    assign bypass[i][3] = !ex_hit[i] && mem_hit[i];\n    assign bypass[i][4] = !ex_hit[i] && !mem_hit[i];\n  end\nendmodule\n'\"''')\nPY\npython '/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/prototype.py'\nverilator --lint-only -Wall --top-module core -I\\\"/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/rtl\\\" \\\"/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/rtl/core_pkg.sv\\\" \\\"/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN\\\"/rtl/*.sv\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
