{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom array import array\nfrom collections import Counter\nfrom itertools import islice\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'bench-predictor.HSKuJwMl/base/retire.dat'\nrecords=array('I',p.read_bytes())\ntaken=Counter(); nt=Counter(); jal=Counter(); jr=Counter()\nfor pc,npc,w in zip(records[::3],records[1::3],records[2::3]):\n op=w & 127\n if op==0x63:\n  (nt if npc==pc+4 else taken)[pc]+=1\n elif op==0x6f: jal[pc]+=1\n elif op==0x67: jr[pc]+=1\nprint(len(records)//3)\nfor c in taken,nt,jal,jr:\n print(sum(c.values()),len(c),c.most_common(16))\nbanks=[Counter() for _ in range(32)]\nfor pc,n in (taken+jal).items(): banks[(pc>>2)&31][pc]=n\nprint(sum(sum(c.values())-max(c.values(),default=0) for c in banks), 'compulsory misses if permanent rows')\nfor i,c in enumerate(banks):\n if len(c) > 1: print(i, c.most_common(5))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
