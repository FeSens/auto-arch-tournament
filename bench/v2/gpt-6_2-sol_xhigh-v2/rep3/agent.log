ign pending_row = update_index == write_index;\n  assign pending_install = install_q && pending_row;\n  assign matching_update = pending_install\n                         ? write_pc_q[19:7] == update.source_pc[19:7]\n                           && write_source_q == update.s\n…[8591 of 11663 chars elided by tools/bench/transcript.py; sha256:f1e4f9b830787cd9]…\n          | ({32{use_queued_bus}} & bus_words[next_head])\n                    | ({32{use_replay}} & next_replay_word);\n      issue_synthetic_q <= (use_response && !in_window)\n                        || (use_queued_bus && synthetic_q[next_head]);\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      head_q <= 2'd0;\n      tail_q <= 2'd0;\n      occupancy_q <= 5'b00001;\n      lane_q <= 5'b00001;\n    end else if (repair) begin\n      head_q <= 2'd0;\n      tail_q <= {1'b0, imem_ready};\n      occupancy_q <= {3'b0, imem_ready, !imem_ready};\n      lane_q <= 5'b00001;\n    end else begin\n      case ({push, pop})\n        2'b10: occupancy_q <= {occupancy_q[3:0], 1'b0};\n        2'b01: occupancy_q <= {1'b0, occupancy_q[4:1]};\n        default: ;\n      endcase\n      if (push) tail_q <= tail_q + 2'd1;\n      if (pop) head_q <= next_head;\n      if (issue) lane_q <= pop ? 5'b00001 : {lane_q[3:0], 1'b0};\n      if (issue) replay_pc_q <= lane_q[0] ? replay_target[head_q] : replay_next;\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
