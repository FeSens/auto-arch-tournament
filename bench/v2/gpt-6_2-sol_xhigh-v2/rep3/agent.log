'capture','compute')\nedit('ex_stage.sv',ex[start:end],'')\nedit('ex_stage.sv', '''      reg_q.result.product <= product;\n''', '')\nedit('ex_stage.sv', 'ex_valid && ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read;'\"', '''ex_valid && ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read\n                       && !in.result_sel.mul_low && !in.result_sel.mul_high;'\"''')\nedit('mem_stage.sv', '''  logic [31:0] write_data;''', '''  logic [31:0] write_data;\n\n'''+mul)\nedit('mem_stage.sv', 'in.result.product[31:0]', 'product[31:0]')\nedit('mem_stage.sv', 'in.result.product[63:32]', 'product[63:32]')\nedit('hazard_unit.sv', '  input  logic       id_ex_mem_read,    // valid LOAD in EX', '  input  logic       id_ex_late_rd,     // valid late result in EX')\nedit('hazard_unit.sv', 'load_use_hazard = id_ex_mem_read', 'load_use_hazard = id_ex_late_rd')\nedit('core.sv', '    .id_ex_mem_read (id_ex_w.valid && id_ex_w.ctrl.mem_read),', '''    .id_ex_late_rd  (id_ex_w.valid && (id_ex_w.ctrl.mem_read ||\n                     id_ex_w.result_sel.mul_low || id_ex_w.result_sel.mul_high)),''')\nif __import__('sys').argv[1:] == ['--no-timing']:\n    raise SystemExit\noutputs = build_all(root, rtl, _bench_sv(str(root), \\\"bench\\\"), scratch / \\\"timing\\\")\nprint(summarize(outputs))\nfor result in outputs:\n    for item in result.get(\\\"critical_paths\\\", [])[:3]:\n        print(result[\\\"place_option\\\"], item[\\\"arrival_ns\\\"], item[\\\"from\\\"], item[\\\"to\\\"])\nPY\nPYTHONPATH=\\\"\"'$PWD\" PYTHONDONTWRITEBYTECODE=1 python3 \"$TMPDIR/bench-r7s1-late-mul.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
