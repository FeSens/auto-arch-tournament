{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json, shutil\nfrom tools.eval.gowin import build\n\nwt = Path.cwd()\nbase = wt / 'cores/bench/rtl'\nroot = Path('/srv/hwebench/tmp/5a1ea1b1/226d8738/bench-r14s0-_uwsxihw')\nfor mode in ('div-sub', 'special-sub', 'simple-diff', 'simple-diff-div-sub'):\n    dst = root / mode\n    shutil.copytree(base, dst)\n    ids = dst / 'id_stage.sv'\n    idstr = ids.read_text()\n    if 'simple-diff' in mode:\n        old = \\\"\\\"\\\"      reg_q.direct_target_differs <= (dec_is_branch || (dec_is_jump && \"'!dec_is_jalr))\n                                  && imm != 32'\"'d4;\\\"\\\"\\\"\n        new = \\\"\\\"\\\"      reg_q.direct_target_differs <= (instr[6:0] == 7'h63 &&\n                                      {instr[31], instr[7], instr[30:25], instr[11:8]} \"'!= 12'\"'d2)\n                                  || (instr[6:0] == 7'h6f &&\n                                      {instr[31], instr[19:12], instr[20], instr[30:21]} \"'!= 20'\"'d2);\\\"\\\"\\\"\n        idstr = idstr.replace(old, new)\n    if mode in ('div-sub', 'special-sub', 'simple-diff-div-sub'):\n        idstr = idstr.replace('ALU_SUB:                      result_sel.sub',\n             'ALU_SUB, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: result_sel.sub')\n        ex = dst / 'ex_stage.sv'\n        estr = ex.read_text()\n        start = estr.index('      reg_q.result.sub')\n        end = estr.index('      reg_q.result.product', start)\n        div_value = '({32{divide}} & div_result)'\n        specials = '''({32{in.ctrl.is_auipc}} & {direct_pc.addr, 2'b00})\n                           | ({32{in.ctrl.is_jump}}  & {in.pc.addr_plus_four, 2'b00})'''\n        sub_values = div_value\n        other_values = 'other_result | ' + specials\n        if mode == 'special-sub':\n            idstr = idstr.replace('        result_sel.other = 1\\\\'b1;', \\\"        result_sel.sub = 1'b1;\\\")\n            sub_values += ' | ' + specials\n            other_values = 'other_result'\n        estr = estr[:start] + f'''      reg_q.result.sub    <= ({{32{{in.ctrl.alu_op == ALU_SUB}}}} & sub_result) | {sub_values};\n      reg_q.result.other  <= {other_values};\n''' + estr[end:]\n        ex.write_text(estr)\n    ids.write_text(idstr)\n\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    futs = {pool.submit(build, wt, root / mode, 'fpga/core_bench_si.sv', 1, root / f'{mode}_p1'):mode\n            for mode in ('div-sub', 'special-sub', 'simple-diff', 'simple-diff-div-sub')}\n    for f in as_completed(futs):\n        r = f.result()\n        print(futs[f], r['fmax_mhz'], json.dumps(r.get('critical_paths', [])[:3]), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json, shutil\nfrom tools.eval.gowin import build\n\nwt = Path.cwd()\nroot = Path('/srv/hwebench/tmp/5a1ea1b1/226d8738/bench-r14s0-_uwsxihw')\nbase = wt / 'cores/bench/rtl'\nfor mode in ('no-jalr-forward', 'registered-ex-tag', 'ex-tag-disp'):\n    dst = root / mode\n    shutil.copytree(base, dst)\n    ex = dst / 'ex_stage.sv'\n    old = 'assign write_eligible = ex_valid && ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read;'\"'\n    if mode == 'no-jalr-forward':\n        new = '''assign write_eligible = in.valid && in.ctrl.reg_write && \"'!in.ctrl.mem_read &&\n                          !in.ctrl.is_jalr && !(in.ctrl.is_jump && in.imm[1]);'\"'''\n    else:\n        new = 'assign write_eligible = in.adjacent_write;'\n        pkg = dst / 'core_pkg.sv'\n        pkg.write_text(pkg.read_text().replace('    logic        direct_target_differs;',\n            '    logic        direct_target_differs;\\\\n    logic        adjacent_write;'))\n        ids = dst / 'id_stage.sv'\n        idstr = ids.read_text()\n        old_valid = \\\"\\\"\\\"    if (reset || flush) reg_q.valid <= 1'b0;\n    else if (\"'!stall)    reg_q.valid <= in.valid;\"\"\"\n        new_valid = \"\"\"    if (reset || flush) begin\n      reg_q.valid <= 1'\"'b0;\n      reg_q.adjacent_write <= 1'b0;\n    end else if (\"'!stall) begin\n      reg_q.valid <= in.valid;\n      reg_q.adjacent_write <= in.valid && dec_reg_write && !dec_mem_read && !dec_is_jalr\n                           && !(dec_is_jump && instr[21]);\n    end\"\"\"\n        assert old_valid in idstr\n        idstr = idstr.replace(old_valid, new_valid)\n        if mode == '\"'ex-tag-disp':\n            old_diff = \\\"\\\"\\\"      reg_q.direct_target_differs <= (dec_is_branch || (dec_is_jump && \"'!dec_is_jalr))\n                                  && imm != 32'\"'d4;\\\"\\\"\\\"\n            new_diff = \\\"\\\"\\\"      reg_q.direct_target_differs <= (dec_is_branch &&\n                                      {instr[31], instr[7], instr[30:25], instr[11:8]} \"'!= 12'\"'d2)\n                                  || (dec_is_jump && \"'!dec_is_jalr &&\n                                      {instr[31], instr[19:12], instr[20], instr[30:21]} != 20'\"'d2);\\\"\\\"\\\"\n            idstr = idstr.replace(old_diff, new_diff)\n        ids.write_text(idstr)\n    estr = ex.read_text()\n    assert old in estr\n    ex.write_text(estr.replace(old, new))\n\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futs = {pool.submit(build, wt, root / mode, 'fpga/core_bench_si.sv', 1, root / f'{mode}_p1'):mode\n            for mode in ('no-jalr-forward', 'registered-ex-tag', 'ex-tag-disp')}\n    for f in as_completed(futs):\n        r = f.result()\n        print(futs[f], r['fmax_mhz'], json.dumps(r.get('critical_paths', [])[:3]), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
