/programs/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\n23:GOWIN_VERSION = \"1.9.11.03 Education\"\n33:def gowin_env(base: dict | None, workdir: Path) -> dict:\n35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n36:    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n173:    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\n175:                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\n221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n/srv/hwebench/tmp/5a1ea1b1/9a475349\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n","exit_code":1,"status":"failed"}}
