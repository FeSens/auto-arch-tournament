{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\n\ndef replace(name, pairs):\n    path = Path(f'cores/bench/rtl/{name}.sv')\n    src = path.read_text()\n    for old, new in pairs:\n        assert src.count(old) == 1, (name, old, src.count(old))\n        src = src.replace(old, new, 1)\n    path.write_text(src)\n\nreplace('core_pkg', [\n    ('logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;', 'logic [31:0] instr;\\\\n    logic [29:0] pc_plus_four;\\\\n    logic        valid;\\\\n  } if_id_t;'),\n    ('logic [31:0] imm;\\\\n    logic [4:0]  rd;', 'logic [31:0] imm;\\\\n    logic [29:0] direct_target;\\\\n    logic [29:0] direct_successor;\\\\n    logic [4:0]  rd;'),\n])\nreplace('id_stage', [\n    ('      reg_q.imm          <= imm;', '''      reg_q.imm          <= imm;\n      reg_q.direct_target <= in.pc[31:2] + imm[31:2];\n      reg_q.direct_successor <= in.pc_plus_four + imm[31:2];'''),\n])\nreplace('ex_stage', [\n    ('  output logic [31:0]        redirect_target', '''  output logic [31:0]        redirect_target,\n  output logic               direct_redirect,\n  output logic [29:0]        direct_target,\n  output logic [29:0]        direct_successor'''),\n    ('  logic [31:0] direct_target;\\\\n', ''),\n    ('  assign direct_target = in.pc + in.imm;', '''  assign direct_target = in.direct_target;\n  assign direct_successor = in.direct_successor;'''),\n    (\\\"  assign redirect_target = in.ctrl.is_jalr ? {effective_addr[31:1], 1'b0} : direct_target;\\\", \\\"  assign redirect_target = {effective_addr[31:2], 2'b00};\\\"),\n    ('  assign redirect = ex_valid && \"'!stall && control_taken && !target_misaligned;'\"', '''  assign redirect = ex_valid && \"'!stall && control_taken && !target_misaligned && in.ctrl.is_jalr;\n  assign direct_redirect = ex_valid && !stall && control_taken && !target_misaligned && !in.ctrl.is_jalr;'\"'''),\n    ('      reg_q.pc_next       <= redirect ? redirect_target : pc_plus_four;', '''      reg_q.pc_next       <= direct_redirect ? {direct_target, 2'b00}\n                             : redirect       ? redirect_target\n                                              : pc_plus_four;'''),\n])\nreplace('if_stage', [\n    ('  output logic [31:0]       imem_addr,', '''  input  logic              direct_redirect,\n  input  logic [29:0]       direct_target,\n  input  logic [29:0]       direct_successor,\n  output logic [31:0]       imem_addr,'''),\n    (\\\"  localparam logic [31:0] RESET_PC = 32'h0000_0000;\\\", \\\"  localparam logic [29:0] RESET_PC = 30'd0;\\\"),\n    ('  logic [31:0] pc;', '''  logic [29:0] pc;\n  logic [29:0] seq_pc;\n  assign seq_pc = pc + 30'd1;'''),\n    ('''    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (\"'!stall)   pc <= pc + 32'\"'d4;\n  end\n\n  assign imem_addr = pc;''', '''    if      (reset)           pc <= RESET_PC;\n    else if (redirect)        pc <= redirect_target[31:2];\n    else if (direct_redirect) pc <= imem_ready ? direct_successor : direct_target;\n    else if (\"'!stall)          pc <= seq_pc;\n  end\n\n  assign imem_addr = {direct_redirect ? direct_target : pc, 2'\"'b00};'''),\n    ('    out.pc    = pc;', '''    out.pc    = imem_addr;\n    out.pc_plus_four = direct_redirect ? direct_successor : seq_pc;'''),\n    ('input  logic [31:0]       redirect_target,', 'input  logic [29:0]       redirect_target,'),\n    ('pc <= redirect_target[31:2]', 'pc <= redirect_target'),\n])\nreplace('core', [\n    ('  logic [31:0] redirect_target;', '''  logic [31:0] redirect_target;\n  logic        direct_redirect;\n  logic [29:0] direct_target, direct_successor;'''),\n    ('    .redirect_target (redirect_target),', '''    .redirect_target (redirect_target[31:2]),\n    .direct_redirect  (direct_redirect),\n    .direct_target    (direct_target),\n    .direct_successor (direct_successor),'''),\n    ('    .redirect_target 