{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'scratch=\"${TMPDIR:-/tmp}/bench-r12s1-checks\"\ncat >> \"$scratch/cores/bench/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\n@cocotb.parametrize(\n    pointer=[0x100, 0x102, 0x101],\n    stall_cycles=[0, 5],\n)\nasync def load_response_pair_offset_two(dut, pointer, stall_cycles):\n    program = [LW(2, 0, 0), LHU(3, 2, 2), EBREAK()]\n    loads = []\n    rets, _ = await _run(\n        dut, program, {0: pointer, 0x100: 0xABCD1234, 0x104: 0xBEEF},\n        load_stalls={0: stall_cycles}, accepted_loads=loads,\n    )\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    older, younger = rets[:2]\n    assert older[\\\"rd_wdata\\\"] == pointer\n    assert younger[\\\"rs1_rdata\\\"] == younger[\\\"rs2_rdata\\\"] == pointer\n    if pointer == 0x100:\n        assert younger[\\\"rd_wdata\\\"] == 0xABCD and not younger[\\\"trap\\\"]\n        assert younger[\\\"cycle\\\"] == older[\\\"cycle\\\"] + 1\n        assert loads == [0, 0x102]\n    elif pointer == 0x102:\n        assert younger[\\\"rd_wdata\\\"] == 0xBEEF and not younger[\\\"trap\\\"]\n        assert younger[\\\"cycle\\\"] == older[\\\"cycle\\\"] + 2\n        assert loads == [0, 0x104]\n    else:\n        assert younger[\\\"trap\\\"] and younger[\\\"mem_rmask\\\"] == 0\n        assert loads == [0]\n\n\n@cocotb.test()\nasync def load_response_pair_trap_retries_old_base(dut):\n    program = [ADDI(2, 0, 0x100), LW(2, 0, 2), LHU(3, 2, 2), EBREAK()]\n    loads = []\n    rets, _ = await _run(dut, program, {0x100: 0xABCD1234}, accepted_loads=loads)\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert rets[1][\\\"trap\\\"]\n    assert rets[2][\\\"rs1_rdata\\\"] == rets[2][\\\"rs2_rdata\\\"] == 0x100\n    assert rets[2][\\\"rd_wdata\\\"] == 0xABCD and not rets[2][\\\"trap\\\"]\n    assert loads == [0x102]\n\n\n@cocotb.test()\nasync def load_response_pair_chases_chain(dut):\n    program = [LW(2, 0, 0), LW(3, 2, 0), LW(4, 3, 0), BEQ(4, 0, 8), EBREAK(), EBREAK()]\n    loads = []\n    rets, _ = await _run(dut, program, {0: 0x100, 0x100: 0x104, 0x104: 0},\n                        load_stalls={0x100: 4}, accepted_loads=loads)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 12, 20]\n    assert [r[\\\"order\\\"] for r in rets] == [0, 1, 2, 3, 4]\n    assert not any(r[\\\"trap\\\"] for r in rets)\n    assert [r[\\\"rd_wdata\\\"] for r in rets[:3]] == [0x100, 0x104, 0]\n    assert loads == [0, 0x100, 0x104]\nPY\ncd \\\"\"'$scratch\"\npython -m pytest -q cores/bench/test/test_pipeline.py > pipeline-result.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
