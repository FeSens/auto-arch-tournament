{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nimport os\nimport shutil\nimport tempfile\n\nfrom tools.eval.gowin import build, summarize\n\nworktree = Path.cwd()\nchampion = worktree / 'cores/bench/rtl'\nroot = Path(tempfile.mkdtemp(prefix='bench-r14s0-'))\nprint(root, flush=True)\nrtl = root / 'mux-first'\nshutil.copytree(champion, rtl)\nex = rtl / 'ex_stage.sv'\nsource = ex.read_text().replace('effective_addr, response_addr;', 'effective_addr, next_mem_addr, address_base;\\\\n  logic [1:0] paired_offset;')\nstart = source.index('  // Offsets 0, 1 and 2')\nend = source.index('  // ── Control flow', start)\nsource = source[:start] + '''  // The ordinary selection is independent of the response carry tree.\n  assign address_base = use_load_response ? raw_response : effective_addr;\n  assign paired_offset = {2{use_load_response}} & in.imm[1:0];\n  assign carry_one = raw_response[0] && paired_offset[0];\n  assign carry_two = raw_response[1] && (paired_offset[1] || carry_one);\n  assign next_mem_addr[0] = address_base[0] \"'^ paired_offset[0];\n  assign next_mem_addr[1] = address_base[1] ''^ paired_offset[1] ''^ carry_one;\n\n  logic [7:0] group_full;\n  logic [7:0] group_carry;\n  assign group_carry[0] = carry_two;\n  for (genvar grp = 0; grp < 8; grp++) begin : gen_group\n    localparam int LOW_BIT = 2 + 4 * grp;\n    if (grp < 7) assign group_full[grp] = &raw_response[LOW_BIT +: 4];\n    if (grp > 0) assign group_carry[grp] = carry_two && (&group_full[grp-1:0]);\n    for (genvar local_bit = 0; local_bit < 4; local_bit++) begin : gen_bit\n      localparam int BIT_IDX = LOW_BIT + local_bit;\n      if (BIT_IDX < 32) begin : gen_addr\n        if (local_bit == 0) assign next_mem_addr[BIT_IDX] = address_base[BIT_IDX] ''^ group_carry[grp];\n        else assign next_mem_addr[BIT_IDX] = address_base[BIT_IDX] ''^\n             (group_carry[grp] && (&raw_response[BIT_IDX-1:LOW_BIT]));\n      end\n    end\n  end\n\n'\"''' + source[end:]\nsource = source.replace('use_load_response ? response_addr : effective_addr;', 'next_mem_addr;')\nex.write_text(source)\n\nbench_sv = 'fpga/core_bench_si.sv'\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    ref = pool.submit(build, worktree, champion, bench_sv, 1, root / 'champion_p1')\n    variants = [pool.submit(build, worktree, rtl, bench_sv, p, root / f'mux_first_p{p}') for p in range(3)]\n    print('champion', json.dumps(ref.result()), flush=True)\n    results = [v.result() for v in variants]\n    for r in results:\n        print('mux-first', json.dumps(r), flush=True)\n    print('summary', json.dumps(summarize(results)), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
