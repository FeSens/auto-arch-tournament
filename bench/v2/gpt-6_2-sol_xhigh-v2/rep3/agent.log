r `#if NRET < 2`, so a single-\n    issue core (no `_1` ports) builds cleanly.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    ret\n…[5814 of 8886 chars elided by tools/bench/transcript.py; sha256:23632c6123aac6f5]…\ndut, ALU_MULH, 1, 1, 0)\n\n\n@cocotb.test()\nasync def mulhu(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n\n\n@cocotb.test()\nasync def mulhsu(dut):\n    await _setup(dut)\n    # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    # (-1) * unsigned -> high half is sign extension\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup_div(dut):\n    dut.reset.value = 1\n    dut.issue.value = 0\n    dut.result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    assert int(dut.issue_ready.value) == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.issue.value = 1\n", "exit_code": 0, "status": "completed"}}
