{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nrtl = Path(\\\"cores/bench/rtl\\\")\n\ndef edit(name, pairs):\n    path = rtl / name\n    src = path.read_text()\n    for old, new in pairs:\n        assert src.count(old) == 1, (name, old, src.count(old))\n        src = src.replace(old, new)\n    path.write_text(src)\n\nedit(\\\"core.sv\\\", [\n    (\\\"  logic [31:0] redirect_target;\\\", \\\"\\\"\\\"  logic [31:0] redirect_target;\n  logic        predict_taken, successor_mismatch;\n  logic        train_control, train_taken;\n  logic [31:0] predict_target, train_target;\n\n  assign redirect = id_ex_w.valid && \"'!stall_ex_mem && successor_mismatch;\n\n  branch_predictor u_predictor (\n    .clock        (clock),\n    .reset        (reset),\n    .fetch_pc     (io_imemAddr),\n    .predict_taken(predict_taken),\n    .predict_target(predict_target),\n    .train        (train_control && !stall_ex_mem),\n    .train_pc     (id_ex_w.pc),\n    .train_target (train_target),\n    .train_taken  (train_taken),\n    .train_jump   (id_ex_w.ctrl.is_jump)\n  );\"\"\"),\n    (\".stall           (stall_if),\", \".stall           (stall_if),'\"\\\\n    .predict_taken   (predict_taken),\\\\n    .predict_target  (predict_target),\\\"),\n    (\\\".divide_wait     (divide_wait),\\\\n    .redirect        (redirect),\\\\n    .redirect_target (redirect_target)\\\", \\\"\\\"\\\".divide_wait     (divide_wait),\n    .predicted_pc    (io_imemAddr),\n    .mismatch        (successor_mismatch),\n    .resolved_pc     (redirect_target),\n    .train_control   (train_control),\n    .train_taken     (train_taken),\n    .train_target    (train_target)\\\"\\\"\\\"),\n])\n\nedit(\\\"if_stage.sv\\\", [\n    (\\\"  input  logic              flush,\\\", \\\"\\\"\\\"  input  logic              predict_taken,\n  input  logic [31:0]       predict_target,\n  input  logic              flush,\\\"\\\"\\\"),\n    (\\\"next_pc = redirect ? redirect_target : pc + 32'd4;\\\", \\\"next_pc = predict_taken ? predict_target : pc + 32'd4;\\\"),\n    (\\\"(flush || redirect) ? 32'h0000_0013 : imem_data\\\", \\\"flush ? 32'h0000_0013 : imem_data\\\"),\n    (\\\"\"'!(flush || redirect)\", \"!flush\"),\n])\n\nedit(\"hazard_unit.sv\", [\n    (\"  logic imem_stall;'\"\\\\n  logic dmem_stall;\\\", \\\"\\\"\\\"  logic imem_stall;\n  logic dmem_stall;\n  assign imem_stall = \"'!imem_ready;\n  assign flush_if = imem_stall;\n  assign dmem_stall = !dmem_ready && ex_mem_mem_op;\n  assign stall_ex_mem = dmem_stall;\"\"\"),\n    (\"\"\"    imem_stall = !imem_ready;\n    // dmem stall only matters if there'\"'s actually a memory op in EX/MEM\n    // — otherwise bus-not-ready is irrelevant to the pipeline.\n    dmem_stall = \"'!dmem_ready && ex_mem_mem_op;\n\"\"\", \"\"),\n    (\"\"\"    // IF/ID combinational payload: NOP whenever we wouldn'\"'t have a valid\n    // instruction this cycle (redirect target unknown to IF, or imem\n    // didn't deliver).\n    flush_if      = redirect || imem_stall;\n\\\"\\\"\\\", \\\"\\\"),\n    (\\\"\\\"\\\"    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n\\\"\\\"\\\", \\\"\\\"),\n])\n\nedit(\\\"ex_stage.sv\\\", [\n    (\\\"\\\"\\\"  output logic               redirect,\n  output logic [31:0]        redirect_target\\\"\\\"\\\", \\\"\\\"\\\"  input  logic [31:0]        predicted_pc,\n  output logic               mismatch,\n  output logic [31:0]        resolved_pc,\n  output logic               train_control,\n  output logic               train_taken,\n  output logic [31:0]        train_target\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\"\"\", \"\"\"  logic [31:0] sequential_pc;\n  logic target_mismatch, sequential_mismatch;\n\n  assign sequential_pc