{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r10s1-candidate/count.py\" <<'\"'PY'\nimport re, sys\nfrom collections import Counter\np = re.compile(rb'\\\"cycle\\\":(\\\\d+),\\\"insn\\\":(\\\\d+),\\\"pc_rdata\\\":(\\\\d+),\\\"pc_wdata\\\":(\\\\d+),\\\"rd_addr\\\":(\\\\d+)')\nstart, stop = 14335, 3764917\ncounts = Counter()\npairs = Counter()\nprev = 0\nprev_rd = 0\nprev_cycle = 0\nfor line in sys.stdin.buffer:\n    m = p.search(line)\n    if not m:\n        continue\n    c,i,pc,npc,rd = map(int,m.groups())\n    opcode = i & 0x7f\n    if c < start:\n        continue\n    if c > stop:\n        break\n    counts['retired'] += 1\n    counts[opcode] += 1\n    if opcode in {0x63,0x6f,0x67}:\n        counts[(opcode,'taken')] += npc \"'!= ((pc+4)&0xffffffff)\n        counts[(opcode,'\"'gap')] += max(0, c-prev_cycle-1)\n    if prev & 0x7f == 3 and prev_rd:\n        rs1 = (i >> 15) & 31\n        rs2 = (i >> 20) & 31\n        s1 = opcode in {0x33,0x13,0x03,0x23,0x63,0x67}\n        s2 = opcode in {0x33,0x23,0x63}\n        if prev_rd in (rs1,rs2):\n            pairs[(opcode, int(s1 and rs1==prev_rd), int(s2 and rs2==prev_rd))] += 1\n            counts['loadadj_raw'] += 1\n            if (s1 and rs1==prev_rd) or (s2 and rs2==prev_rd):\n                counts['loadadj_true'] += 1\n    prev, prev_rd, prev_cycle = i, rd, c\nprint(counts)\nprint(pairs)\nPY\n\\\"\"'$TMPDIR/bench-r10s1-candidate/obj/cosim_sim\" \"$TMPDIR/bench-r10s1-candidate/bench/programs/coremark.elf\" 50000000 --istall --dstall | python3 \"$TMPDIR/bench-r10s1-candidate/count.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
