{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c 'cat > \"${TMPDIR:-/tmp}/bench-r12s1-skid.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nimport shutil\n\nroot = Path(os.environ['TMPDIR'])\n\ndef add_skid(base, name):\n    new = root / f'bench-r12s1-{name}'\n    shutil.copytree(root / f'bench-r12s1-{base}', new, dirs_exist_ok=True)\n    p = new / 'core.sv'\n    t = p.read_text()\n    t = t.replace('  if_id_t  if_id_w;', '''  if_id_t  if_id_w, if_fifo_w, skid_q;\n  logic skid_valid_q;\n\n  assign if_id_w = skid_valid_q ? skid_q : if_fifo_w;\n\n  always_ff @(posedge clock) begin\n    if (\"'!skid_valid_q) skid_q <= if_fifo_w;\n    if (reset || repair) skid_valid_q <= 1'\"'b0;\n    else if (skid_valid_q) begin\n      if (issue_if) skid_valid_q <= 1'b0;\n    end else begin\n      skid_valid_q <= if_fifo_w.valid && \"'!issue_if;\n    end\n  end'\"''')\n    t = t.replace('    .issue_enable    (issue_if),', '    .issue_enable    (\"'!skid_valid_q),'\"')\n    t = t.replace('    .out             (if_id_w)', '    .out             (if_fifo_w)')\n    p.write_text(t)\n\nadd_skid('class','skid')\nadd_skid('classlane','skidlane')\nPY\npython \\\"\"'${TMPDIR:-/tmp}/bench-r12s1-skid.py\"\nfor v in skid skidlane; do export PYTHONPATH=\"$PWD\"; python \"${TMPDIR:-/tmp}/bench-r12s1-time.py\" \"$v\" > \"${TMPDIR:-/tmp}/bench-r12s1-$v-timing.log\" & done\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
