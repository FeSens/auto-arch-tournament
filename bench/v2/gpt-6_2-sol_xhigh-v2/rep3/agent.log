gh_equal && low_less), !high_less})\n    | ({2{pair_branch}} & (response_equal | {2{in.pair_rs2}}));\n  assign take_if_both = in.branch_sel.eq || in.branch_sel.ge;\n  assign take_if_either_clear = in.branch_sel.ne || in.branch_sel.lt;\"\"\"),\n    (\"\"\"  assign branch_taken = (in.branch_sel.eq && branch_equal)\n                      || (in.branch_sel.ne && !branch_equal)\n                      || (in.branch_sel.lt && branch_less)\n                      || (in.branch_sel.ge && !branch_less);\n  assign direct_taken = !in.imm[1] && (branch_taken || (in.ctrl.is_jump && !in.ctrl.is_jalr));\"\"\",\n     \"\"\"  assign direct_taken = !in.imm[1] && in.ctrl.is_jump && !in.ctrl.is_jalr;\"\"\"),\n    (\"  assign misalign_fault = (branch_taken && in.imm[1]) || jump_misaligned;\", \"\"),\n    (\"      fence_i_q <= 1'\"'b0;\\\", \\\"\\\"\\\"      fence_i_q <= 1'b0;\n      branch_repair_yes_q <= 1'b0;\n      branch_repair_no_q <= 1'b0;\\\"\\\"\\\"),\n    (\\\"      repair_jalr_q <= ex_valid && jalr_taken;\\\", \\\"\\\"\\\"      repair_jalr_q <= ex_valid && jalr_taken;\n      branch_repair_yes_q <= ex_valid && in.direct_target_differs && \"'!in.ctrl.is_jump\n                          && ((take_if_both && !in.imm[1]) != in.predicted_taken);\n      branch_repair_no_q <= ex_valid && in.direct_target_differs && !in.ctrl.is_jump\n                         && ((take_if_either_clear && !in.imm[1]) != in.predicted_taken);\"\"\"),\n    (\"(in.direct_target_differs && in.predicted_taken && !direct_taken)\", \"(in.ctrl.is_jump && in.direct_target_differs && in.predicted_taken && !direct_taken)\"),\n    (\"      repair_to_direct_q <= direct_taken;\", \"\"\"      repair_to_direct_q <= direct_taken;\n      branch_yes_q <= take_if_both;\n      branch_no_q <= take_if_either_clear;\n      branch_aligned_q <= !in.imm[1];\n      groups_q <= groups;\n      branch_repair_pc_q <= in.predicted_taken\n                          ? {in.pc.addr_plus_four, in.pc.addr_plus_four + 30'\"'d1}\n                   