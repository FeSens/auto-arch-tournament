{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/5a1ea1b1/7c4fbf7b/tmp.5Evixz2QTZ' <<'PY'\nimport numpy as np\nfrom pathlib import Path\nfrom collections import Counter\nimport sys\nt=np.fromfile(Path(sys.argv[1])/'retire.bin',dtype='uint32').reshape(-1,6)\ncy,p,q,i,m,a=t.T\ngap=np.diff(cy.astype('i8'),prepend=cy[0]-1)-1\nop=i&127\neligible=(op==0x63)&(q<=p)&((p-q)<=60)\nlens=(p[eligible]-q[eligible])//4+1\nsites=Counter(zip(p[eligible],q[eligible]))\ngap_est=0\ncovered=np.zeros(len(p),bool)\nfor (tail,head),cnt in sites.most_common(35):\n sel=np.where(eligible&(p==tail)&(q==head))[0]\n l=(int(tail)-int(head))//4+1\n sel=sel[sel+l<len(p)]\n ix=sel[:,None]+np.arange(1,l+1)\n ok=np.all(p[ix]==int(head)+4*np.arange(l),axis=1)&np.all(~np.isin(op[ix[:,:-1]],(0x6f,0x67,0x73,0x0f)),axis=1)\n coverage=ix[ok,:]\n overlap=covered[coverage].sum()\n covered[coverage]=True\n print(hex(tail),hex(head),str(l).rjust(2),str(cnt).rjust(5),str(ok.sum()).rjust(5),'words',coverage.size,'gap',gap[coverage].sum(),'LS',m[coverage].astype(bool).sum(),'overlap',overlap)\nprint('totals:',covered.sum(),gap[covered].sum(),m[covered].astype(bool).sum(),Counter(lens))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
