{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/bench-r10s1-candidate/cores/bench\"\ncp -r fpga \"$TMPDIR/bench-r10s1-candidate/\"\ncp -r cores/bench/rtl cores/bench/test cores/bench/core.yaml \"$TMPDIR/bench-r10s1-candidate/cores/bench/\"\npython3 - <<'\"'PY'\nimport os\nfrom pathlib import Path\n\npath = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"bench-r10s1-candidate/cores/bench/rtl/if_stage.sv\\\"\ns = path.read_text()\ndef replace(old, new):\n    global s\n    assert s.count(old) == 1, old\n    s = s.replace(old, new)\n\nreplace(\\\"  logic retry_q, in_window;\\\", \\\"  logic retry_q, in_window;\\\\n  logic accepted_response;\\\")\nreplace(\\\"  logic response, push, issue, pop;\\\", \\\"\\\"\\\"  logic response, push, issue, pop, issue_ring;\n  logic correction_valid_q, correction_in, correction_out;\n  pc_pair_t correction_pc_q;\\\"\\\"\\\")\nreplace(\\\"\\\"\\\"  assign response = imem_ready && (repair || \"'!occupancy_q[4]);\n  assign push = response && !reject;\n  assign write_slot = repair ? 2'\"'d0 : tail_q;\\\"\\\"\\\",\n\\\"\\\"\\\"  assign response = imem_ready && \"'!(occupancy_q[4] || (correction_valid_q && occupancy_q[3]));\n  assign push = response && !reject;\n  assign correction_in = repair && imem_ready;\n  assign accepted_response = repair ? imem_ready : response;\n  assign write_slot = tail_q;\"\"\")\nreplace(\"response ? request_next : request_pc\", \"accepted_response ? request_next : request_pc\")\nreplace(\"retry_q <= repair && !response;\", \"retry_q <= repair && !imem_ready;\")\nreplace(\"\"\"  assign out.valid = !occupancy_q[0];\n  assign out.predicted_taken = lane_q[0] && predicted_taken;\"\"\",\n\"\"\"  assign out.valid = correction_valid_q || !occupancy_q[0];\n  assign out.predicted_taken = !correction_valid_q && lane_q[0] && predicted_taken;\"\"\")\nreplace(\"\"\"  assign out.pc = lane_q[0] ? head_bus_pc : {12'\"'b0, replay_pc_q, 12'b0, replay_next};\n  assign issue = issue_enable && out.valid;\n  assign pop = issue &&\\\"\\\"\\\",\n\\\"\\\"\\\"  assign out.pc = correction_valid_q ? correction_pc_q :\n                  lane_q[0] ? head_bus_pc : {12'b0, replay_pc_q, 12'b0, replay_next};\n  assign issue = issue_enable && out.valid;\n  assign issue_ring = issue_enable && \"'!correction_valid_q && !occupancy_q[0];\n  assign correction_out = issue_enable && correction_valid_q;\n  assign pop = issue_ring &&\"\"\")\nreplace(\"logic response, push, issue, pop, issue_ring;\", \"logic response, push, pop, issue_ring;\")\nreplace(\"  assign issue = issue_enable && out.valid;'\"\\\\n\\\", \\\"\\\")\nreplace(\\\"\\\"\\\"  logic [31:0] next_replay_word;\\\"\\\"\\\",\\\"\\\"\\\"  logic [31:0] next_replay_word;\n  logic [1:0] queued_slot;\n  logic capture_ring_word;\\\"\\\"\\\")\nreplace(\\\"\\\"\\\"  assign use_response = repair || occupancy_q[0] || (payload_last && occupancy_q[1]);\n  assign use_queued_bus = \"'!use_response && payload_last;\n  assign use_replay = !use_response && !payload_last;\n  assign capture_issue_word = (repair || occupancy_q[0]) ? response\n                            : issue && (!payload_last || !occupancy_q[1] || response);\"\"\",\n\"\"\"  assign use_response = repair || occupancy_q[0] ||\n                        (!correction_valid_q && payload_last && occupancy_q[1]);\n  assign use_queued_bus = !use_response && (correction_valid_q || payload_last);\n  assign use_replay = !use_response && !use_queued_bus;\n  assign queued_slot = correction_valid_q ? head_q : next_head;\n  assign capture_ring_word = correction_valid_q ? correction_out && (!occupancy_q[0] || push)\n                           : occupancy_q[0] ? push\n                           : issue_ring && (!payload_last || !occupancy_q[1] || response);\n  assign capture_issue_word = repair ? imem_ready : capture_ring_word;\"\"\")\nreplace(\"bus_words[next_head]\", \"bus_words[queued_slot]\")\nreplace(\"synthetic_q[next_head]\", \"synthetic_q[queued_slot]\")