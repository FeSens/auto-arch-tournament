{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cat > profile.py <<'PY'\nimport collections, json, sys\n\ndef controls(rows):\n    seen = False\n    for line in rows:\n        item = json.loads(line)\n        if item['mem_wmask']:\n            if item['mem_addr'] == 0x10000100:\n                seen = True\n            if item['mem_addr'] == 0x10000104:\n                return\n        op = item['insn'] & 127\n        if op in (0x63, 0x6f, 0x67):\n            pc = item['pc_rdata']\n            taken = item['pc_wdata'] \"'!= (pc + 4)\n            yield seen, pc, (item['\"'insn'] >> 31) \"'!= 0, op, taken\n\npreds = [(bits, shift, [None] * (1 << bits)) for bits in (4, 5, 6, 7, 8, 9) for shift in (0, 4, 5, 6)]\ncounts = collections.Counter()\nmisses = collections.Counter()\nfor in_window, pc, backward, op, taken in controls(sys.stdin):\n    if in_window:\n        counts[op, taken] += 1\n    if op != 0x63:\n        continue\n    for bits, shift, table in preds:\n        idx = ((pc >> 2) ''^ ((pc >> (2 + shift)) if shift else 0)) & ((1 << bits) - 1)\n        old = table[idx]\n        guess = backward if old is None else old >= 2 \n        if in_window:\n            misses[bits, shift] += guess != taken\n        table[idx] = (2 if taken else 1) if old is None else (min(3, old + 1) if taken else max(0, old - 1))\n    if in_window:\n        misses['\"'btfnt'] += backward \"'!= taken\nprint('\"'taken and fall-through counts by opcode', { (hex(op), taken): n for (op, taken), n in counts.items() })\nprint('direction misses', misses.most_common())\nPY\nset -o pipefail\nbase_obj/cosim_sim bench/programs/coremark.elf 6000000 --istall --dstall | python3 profile.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
