[30:22]}\n                      : {{19{slot_instr_q[31]}}, slot_instr_q[31], slot_instr_q[7],\n                         slot_instr_q[30:25], slot_instr_q[11:9]};\n  assign target = slot_pc_q.addr + displacement;\n  assign target_successor = slot_pc_q.addr - ~displacement;\n`ifdef BENCH_DISABLE_STATIC_LOOKAHEAD\n  assign predict_taken = 1'\"'b0;\n\"'`else\n  assign predict_taken = aligned && (is_jal || (is_branch && slot_instr_q[31]))\n                       && target[31:20] == 12'\"'b0;\n\"'`endif\n  assign select_predicted_target = predict_taken;\n  assign next_slot_pc.addr = select_predicted_target ? target : slot_pc_q.addr_plus_four;\n  assign next_slot_pc.addr_plus_four = select_predicted_target ? target_successor\n                                                               : slot_pc_q.addr + 30'\"'d2;\n  assign lookahead_safe = next_slot_pc.addr[31:20] == 12'b0;\n\n  assign direct_repair = repair_taken || repair_fallthrough;\n  assign repair_pc = repair_taken ? direct_pc : fallthrough_pc;\n  assign use_slot = slot_valid_q && \"'!direct_repair;\n  assign normal_pc = use_slot && lookahead_safe ? next_slot_pc\n                   : use_slot ? slot_pc_q : base_pc;\n  assign request_pc = direct_repair ? repair_pc : normal_pc;\n  assign imem_addr = {request_pc.addr, 2'\"'b00};\n  assign blocked = stall || hold_state;\n\n  always_comb begin\n    out.sequential_pc = use_slot ? slot_pc_q : base_pc;\n    out.direct_pc = repair_pc;\n    out.use_direct_pc = direct_repair;\n    out.predicted_taken = use_slot && predict_taken;\n    out.instr = use_slot ? slot_instr_q : imem_data;\n    out.valid = use_slot || imem_ready;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sequential_pc_q <= '0;\n      redirect_pc_q <= '0;\n      use_redirect_pc_q <= 1'b0;\n      slot_valid_q <= 1'b0;\n    end else begin\n      if (\"'!blocked) begin\n        sequential_pc_q <= use_slot ? next_slot_pc.addr\n                         : imem_ready ? base_pc.addr_plus_four 