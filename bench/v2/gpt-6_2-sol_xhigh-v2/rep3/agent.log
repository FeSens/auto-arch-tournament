{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c 'study_dir=\"$TMPDIR/bench-predictor.HSKuJwMl\"\ncat > \"$study_dir/bothpaths.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\n\nrtl = Path(sys.argv[1])\ndef patch(filename, replacements):\n    f = rtl / filename\n    text = f.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (filename, old)\n        text = text.replace(old, new)\n    f.write_text(text)\n\npatch('core.sv', [\n    ('logic [31:0]    train_target;', 'logic [31:0]    unused_train_target;'),\n    ('.train_target    (train_target)', '.train_target    (unused_train_target)'),\n    ('.pc_next (train_target)', '.pc_next (ex_mem_w.pc_next)'),\n])\npatch('replay_train.sv', [\n    ('  logic not_taken;', '  logic source_taken_q;'),\n    ('  assign not_taken = advance && direct && \"'!taken && word_in_window;'\"\\\\n', ''),\n    ('advance && direct && taken && word_in_window', 'advance && direct && word_in_window'),\n    ('      source_instr_q <= instr;', '      source_instr_q <= instr;\\\\n      source_taken_q <= taken;'),\n    ('''  // A not-taken branch can terminate an older prefix. Queue its counter\n  // update behind that prefix. The next taken source drains this queue\n  // before another prefix can finish.\n  logic deferred_valid_q;\n  logic [19:2] deferred_pc_q;\n  logic [31:0] deferred_instr_q;\n''',''),\n    ('''    if (reset || fence_i) begin\n      deferred_valid_q <= 1'b0;\n      update_q.valid <= 1'b0;\n    end else begin\n      deferred_valid_q <= not_taken && (finish_prefix || deferred_valid_q);\n      update_q.valid <= finish_prefix || deferred_valid_q || not_taken;\n    end\n\n    if (not_taken && (finish_prefix || deferred_valid_q)) begin\n      deferred_pc_q <= pc[19:2];\n      deferred_instr_q <= instr;\n    end\n\n    update_q.taken <= finish_prefix;\n    update_q.source_pc <= finish_prefix ? source_pc_q : deferred_valid_q ? deferred_pc_q : pc[19: