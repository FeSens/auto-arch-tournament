{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json, shutil\nfrom tools.eval.gowin import build\n\nwt = Path.cwd()\nroot = Path('/srv/hwebench/tmp/5a1ea1b1/226d8738/bench-r14s0-_uwsxihw')\nbase = root / 'drain-repair-reg-tag'\nmodes = ('repair-valid', 'independent-div-wait', 'repair-valid-div-wait', 'repair-bubble-valid', 'repair-addr-ready')\nfor mode in modes:\n    dst = root / mode\n    shutil.copytree(base, dst)\n    ex = dst / 'ex_stage.sv'\n    estr = ex.read_text()\n    if 'repair-valid' in mode:\n        estr = estr.replace('<= ex_valid && (repair_always', '<= in.valid && (repair_always')\n        estr = estr.replace('<= ex_valid && fence_i_resolved', '<= in.valid && fence_i_resolved')\n    if 'div-wait' in mode:\n        estr = estr.replace('assign divide_wait = divide && \"'!div_result_valid;'\"', 'assign divide_wait = in.valid && in.divide && \"'!div_result_valid;'\"')\n    if mode == 'repair-bubble-valid':\n        estr = estr.replace('assign ex_valid = in.valid && \"'!divide_wait && !repair;'\"',\n                              'assign ex_valid = in.valid && \"'!repair && (!in.divide || div_result_valid);'\"')\n    if mode == 'repair-addr-ready':\n        estr = estr.replace('if (\"'!stall) begin'\"\\\\n      if (in.ctrl.is_jalr)', 'if (\"'!stall && !repair) begin'\"\\\\n      if (in.ctrl.is_jalr)')\n    ex.write_text(estr)\n\nwith ThreadPoolExecutor(max_workers=5) as pool:\n    futs = {pool.submit(build, wt, root / mode, 'fpga/core_bench_si.sv', 1, root / f'{mode}_p1'):mode for mode in modes}\n    for f in as_completed(futs):\n        r = f.result()\n        print(futs[f], r['fmax_mhz'], r.get('reason', ''), json.dumps(r.get('critical_paths', [])[:2]), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
