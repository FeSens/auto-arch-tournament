{"type": "item.started", "item": {"id": "item_40", "type": "command_execution", "command": "/bin/bash -c 'set -euo pipefail\ncat > \"$TMPDIR/bench-r7s1-compound.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport tempfile\nimport sys\nfrom tools.eval.fpga import _bench_sv\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nmode, baseline = sys.argv[1:3]\nscratch = Path(tempfile.mkdtemp(prefix=f\\\"bench-r7s1-{mode}-\\\"))\nprint(scratch, flush=True)\nrtl = scratch / \\\"rtl\\\"\nshutil.copytree(Path(tempfile.gettempdir()) / baseline / \\\"rtl\\\", rtl)\ndef edit(file, old, new):\n    path = rtl / file\n    text = path.read_text()\n    assert text.count(old) == 1, (file, old)\n    path.write_text(text.replace(old, new))\n\nif \\\"shift\\\" in mode:\n    edit('core_pkg.sv', '    logic other;', '    logic other;\\\\n    logic shift;')\n    edit('core_pkg.sv', '    logic [31:0] other;', '    logic [31:0] other;\\\\n    logic [31:0] shift;')\n    edit('core_pkg.sv', '    logic ex_other;', '    logic ex_other;\\\\n    logic ex_shift;')\n    edit('core_pkg.sv', '    logic        alu_b_imm;', '''    logic        alu_b_imm;\n    logic        shift_left;\n    logic        shift_right;\n    logic        shift_arith;''')\n    edit('id_stage.sv', '          ALU_SUB:                      result_sel.sub      = 1\\\\'b1;', '''          ALU_SUB:                      result_sel.sub      = 1'b1;\n          ALU_SLL, ALU_SRL, ALU_SRA:    result_sel.shift    = 1'b1;''')\n    for tag,i in [('rs1',0),('rs2',1)]:\n        edit('id_stage.sv',f'  assign {tag}_sel.ex_other = ex_hit[{i}] && ex_result_sel.other;', f'''  assign {tag}_sel.ex_other = ex_hit[{i}] && ex_result_sel.other;\n  assign {tag}_sel.ex_shift = ex_hit[{i}] && ex_result_sel.shift;''')\n    edit('id_stage.sv', '      reg_q.alu_b_imm    <= dec_alu_src;', '''      reg_q.alu_b_imm    <= dec_alu_src;\n      reg_q.shift_left   <= dec_alu_op == ALU_SLL;\n      reg_q.shift_right  <= dec_alu_op == ALU_SRL || dec_alu_op