{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom collections import Counter\nimport json\nimport subprocess\nc = Counter()\nprocess = subprocess.Popen(['cores/bench/obj_dir/cosim_sim', 'bench/programs/coremark.elf', '6000000', '--istall', '--dstall'], stdout=subprocess.PIPE, text=True)\nstarted = False\nfor line in process.stdout:\n    if not line.startswith('{\\\"order\\\"'):\n        continue\n    r = json.loads(line)\n    if r['mem_wmask']:\n        if r['mem_addr'] == 0x10000100:\n            started = True\n        if r['mem_addr'] == 0x10000104:\n            started = False\n    if not started:\n        continue\n    instr = r['insn']\n    opcode = instr & 127\n    funct3 = (instr >> 12) & 7\n    if opcode == 0x63 and r['pc_wdata'] \"'!= (r['\"'pc_rdata'] + 4) & 0xffffffff:\n        c[(hex(opcode), funct3)] += 1\n    if opcode in (0x6f, 0x67):\n        c[(hex(opcode), None)] += 1\nprint(c)\nassert process.wait() == 0\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
