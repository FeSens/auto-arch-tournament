()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fat\n…[1836 of 4908 chars elided by tools/bench/transcript.py; sha256:a398ff8fb90134f7]…\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\ntotal 464\ndrwxrwx---+  3 nobody nogroup   4096 Nov 21 03:56 .\ndrwxrwx---+  3 nobody nogroup   4096 Nov 21 03:56 ..\n-rw-rw----+  1 nobody nogroup   2317 Nov 21 03:56 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 21 03:56 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 21 03:56 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 21 03:56 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 21 03:56 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 21 03:56 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 21 03:56 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 21 03:56 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 21 03:56 selftest.S\n", "exit_code": 0, "status": "completed"}}
