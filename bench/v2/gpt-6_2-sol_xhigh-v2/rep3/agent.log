{"type": "item.started", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c 'cat > \"${TMPDIR:-/tmp}/bench-r12s1-refine.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nimport shutil\n\nscratch = Path(os.environ['TMPDIR'])\np = scratch / 'bench-r12s1-prototype'\ne = (p / 'ex_stage.sv').read_text()\ntop = (p / 'core.sv').read_text()\nt = (p / 'core_pkg.sv').read_text()\n\ndef build_variant(name, edits):\n    v = scratch / f'bench-r12s1-{name}'\n    shutil.copytree(p, v, dirs_exist_ok=True)\n    for file, src in edits.items():\n        (v / file).write_text(src)\n\na = e.index('  logic retry_q')\nb = e.index('  // Compute partial', a)\nexact = e[:a] + '''  logic pair_address, pair_compare;\n  logic [31:0] pair_addr, basic_addr;\n  assign pair_address = in.valid && in.pair_load && mem_load_valid;\n  assign pair_compare = in.pair_branch && mem_load_valid;\n  assign pair_addr[0] = mem_load_raw[0];\n  for (genvar bit_idx = 1; bit_idx < 32; bit_idx++) begin : gen_pointer_step\n    if (bit_idx == 1)\n      assign pair_addr[bit_idx] = mem_load_raw[bit_idx] \"'^ in.pair_offset_two;\n    else\n      assign pair_addr[bit_idx] = mem_load_raw[bit_idx]\n                                 ''^ (in.pair_offset_two && (&mem_load_raw[bit_idx-1:1]));\n  end\n\n'\"''' + e[b:]\nexact = exact.replace(' && \"'!load_retry;'\"', ';')\nexact = exact.replace('  output logic               load_retry,\\\\n', '')\nexact = exact.replace('  assign effective_addr = pair_address ? pair_addr : (retry_q ? retry_base_q : rs1) + in.imm;', '''  assign basic_addr = rs1 + in.imm;\n  assign effective_addr = ({32{pair_address}} & pair_addr) | ({32{\"'!pair_address}} & basic_addr);'\"''')\nexact = exact.replace(' : pair_address ? mem_load_raw\\\\n                           : retry_q ? retry_base_q : rs1;', ' : pair_address ? mem_load_raw : rs1;')\nexact = exact.replace(' : retry_q ? retry_rs2_q : rs2;', ' : rs2;')\nassert 'retry' not in exact\nstaged = top.replace('logic       pair_eligible, load_retry;', 'logic       pair_eligible;')\nstaged = staged.replace('    .load_retry      (load_retry),\\\\n','').replace('    .load_retry     (load_retry),\\\\n','')\na = staged.index('  replay_train u_replay_train')\nb = staged.index('  // ── MEM', a)\nstaged = staged[:a] + '''  logic train_valid_q, train_taken_q, train_direct_q;\n  logic [31:0] train_pc_q, train_target_q, train_instr_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) train_valid_q <= 1'b0;\n    else train_valid_q <= ex_mem_w.valid && \"'!hold_mem_wb;\n    train_pc_q <= ex_mem_w.pc;\n    train_target_q <= train_target;\n    train_instr_q <= ex_mem_w.instr;\n    train_direct_q <= train_direct;\n    train_taken_q <= train_taken;\n  end\n\n  replay_train u_replay_train (\n    .clock   (clock),\n    .reset   (reset),\n    .fence_i (fence_i),\n    .advance (train_valid_q),\n    .pc      (train_pc_q),\n    .pc_next (train_target_q),\n    .instr   (train_instr_q),\n    .direct  (train_direct_q),\n    .taken   (train_taken_q),\n    .update  (replay_update)\n  );\n\n'\"''' + staged[b:]\nh = (p / 'hazard_unit.sv').read_text().replace('  input  logic       load_retry,\\\\n','').replace(' || load_retry','')\nf = (p / 'if_stage.sv').read_text()\nbuild_variant('exact', {'core.sv': staged, 'ex_stage.sv': exact, 'hazard_unit.sv': h})\n\nlocal = h.replace('assign issue_if = \"'!stall_id && !load_use && !repair;'\"', 'assign issue_if = \"'!stall_id && !load_use;'\"')\nlocal_if = f.replace('assign issue = issue_enable && out.valid;', 'assign issue = issue_enable && out.valid && \"'!repair;'\"')\nbuild_variant('local', {'core.sv': staged, 'ex_stage.sv': exact, 'hazard_unit.sv': local, 'if_stage.sv': local_if})\n\n# Preserve the champion's EX repair boundary for ordinary and paired branches.\nold = (Path('cores/bench/rtl') / 'ex_stage.sv').read_text()\nfull = exact[:exact.index('  // Compute partial')] + exact[exact.index('  // ── EX/MEM register'):]\na = old.index('  // ── Branch resolve')\nb = old.index('  // ── EX/MEM register', a)\nnormal_branch = old[a:b]\nc = exact.index('  logic [3:0] load_byte_match;')\nd = exact.index('  logic eq_compare',c)\nnormal_branch = normal_branch.replace('  logic        branch_equal, branch_less;', exact[c:d]+'  logic        branch_equal, branch_less;\\\\n  logic [7:0] expected_byte [0:3];')\nc = exact.index('    assign expected_byte')\nd = exact.index('  assign hi_equal',c)\nnormal_branch = normal_branch.replace('  end\\\\n\\\\n  // The highest', exact[c:d]+'\\\\n  // The highest',1)\nnormal_branch = normal_branch.replace('  assign branch_equal = &byte_equal;', '  assign branch_equal = pair_compare ? (load_lo && load_hi) : (&byte_equal);')\nc = exact.index('  assign basic_addr')\nd = exact.index('  assign jalr_misaligned')\nnormal_branch = normal_branch.replace('  assign effective_addr = rs1 + in.imm;', exact[c:d].rstrip())\nfull = full.replace('  // ── EX/MEM register', normal_branch+'  // ── EX/MEM register',1)\nfull = full.replace('logic repair_jalr_q, train_direct_q;', 'logic repair_direct_q, repair_sequential_q, repair_jalr_q;')\nfull = full.replace('pc_pair_t direct_repair_q;', 'pc_pair_t direct_repair_q, fallthrough_repair_q;')\nfull = full.replace(\\\"train_direct_q <= 1'b0;\\\", \\\"train_direct <= 1'b0;\\\")\nfull = full.replace('      train_direct_q      <= ex_valid && (conditional_branch || direct_jump)\\\\n                           && \"'!ctrl_with_trap.is_illegal;'\"', '      train_direct        <= ex_valid && is_direct && \"'!ctrl_with_trap.is_illegal;'\"')\nfull = full.replace(\\\"if (direct_taken) out.pc_next = {direct_repair_q.addr, 2'b00};\\\\n    if (branch_taken && \"'!target_aligned_q) out.ctrl.is_illegal = 1'\"'b1;\\\", \\\"if (repair_to_direct_q) out.pc_next = {direct_repair_q.addr, 2'b00};\\\")\nfull = full.replace('  assign train_direct = train_direct_q && \"'!(branch_taken && !target_aligned_q);'\"\\\\n  assign train_taken = direct_taken;', '  assign train_taken = repair_to_direct_q;')\nbuild_variant('earlycmp', {'core.sv': staged, 'ex_stage.sv': full, 'hazard_unit.sv': local, 'if_stage.sv': local_if})\nPY\npython \\\"\"'${TMPDIR:-/tmp}/bench-r12s1-refine.py\"\ncat > \"${TMPDIR:-/tmp}/bench-r12s1-time.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nimport sys\nfrom tools.eval.gowin import build, PLACE_OPTIONS, summarize\n\nname = sys.argv[1]\nworktree = Path.cwd()\nscratch = Path(os.environ['TMPDIR'])\nrtl = scratch / f'bench-r12s1-{name}'\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    fs = [executor.submit(build, worktree, rtl, 'fpga/core_bench_si.sv', p,\n          scratch / f'bench-r12s1-{name}-timing' / f'p{p}') for p in PLACE_OPTIONS]\n    results = [f.result() for f in fs]\nfor r in results:\n    print(r, flush=True)\nprint(summarize(results), flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
