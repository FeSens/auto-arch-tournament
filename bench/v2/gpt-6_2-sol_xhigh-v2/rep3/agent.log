{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/simple.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nbase=Path('cores/bench/rtl')\nroot=Path(sys.argv[1])\noriginal=(base/'div_unit.sv').read_text()\nretimed=(root/'split_blocks/rtl/div_unit.sv').read_text()\nstart=original.index('  // Appending four bits')\nstop=original.index('  always_ff @(posedge clock) begin\\\\n    if (issue && issue_ready)', start)\nstart_new=retimed.index('  // Appending four bits')\nstop_new=retimed.index('  always_ff @(posedge clock) begin\\\\n    if (issue && issue_ready)', start_new)\nsimple=retimed[:start_new]+original[start:stop]+retimed[stop_new:]\n\ngroup_start=retimed.index('  wire [3:0] group_sel')\ngroup_only=retimed[group_start:stop_new]\ncarry=original[start:original.index('  for (genvar digit = 0;', start)].replace('logic [36:0] wide_diff [1:15];', 'logic [36:0] full_diff [1:15];\\\\n  logic [31:0] wide_diff [0:15];').replace('logic [15:0] wide_select;', '').replace('    assign wide_diff[digit] =','    assign full_diff[digit] =').replace('wide_diff[digit][36];', 'full_diff[digit][36];\\\\n    assign wide_diff[digit] = full_diff[digit][31:0];')\ncarry += \\\"  assign wide_diff[0] = wide_trial[31:0];\\\\n\\\"\nmux_group = simple[:start_new]+carry+group_only+retimed[stop_new:]\n\nfor name, text in [('retime',simple),('group_only',mux_group)]:\n    output=root/name/'rtl'\n    copytree(base,output,dirs_exist_ok=True)\n    (output/'div_unit.sv').write_text(text)\nPY\npython \\\"\"'$probe/simple.py\" \"$probe\"\nPYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/group_only\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
