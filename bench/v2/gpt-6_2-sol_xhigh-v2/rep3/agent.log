TMPDIR:-/tmp}/bench-r12s1-exact-tests\"\nmkdir -p \"$target\"\nln -s \"${TMPDIR:-/tmp}/bench-r12s1-exact\" \"$target/rtl\"\ncp -r \"$scratch/cores/bench/test\" \"$target/\"\ncd \"$target\"\npython -m pytest -q test/test_response_exact.py > result.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
