{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - \\\"/srv/hwebench/tmp/5a1ea1b1/9b3c9d5f/bench-predictor.WSITHwtk\\\" <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nscratch = Path(sys.argv[1])\nfor name, original in [('32_page', 'rtl'), ('32_parallel', 'rtl'), ('16_page', 'rtl_16_14')]:\n    rtl = scratch / ('rtl_' + name)\n    shutil.copytree(scratch / original, rtl)\n    p = rtl / 'branch_predictor.sv'\n    if name.endswith('page'):\n        s = p.read_text().replace('logic [17:0] targets', 'logic [12:0] targets')\n        s = s.replace('&& (target_pc[31:20] == 12\\\\'b0) && (target_pc[1:0] == 2\\\\'b0);',\n                     '&& (target_pc[31:15] == train_pc[31:15]) && (target_pc[1:0] == 2\\\\'b0);')\n        s = s.replace(\\\"{12'b0, targets[fetch_index], 2'b0}\\\", \\\"{fetch_pc[31:15], targets[fetch_index], 2'b0}\\\")\n        s = s.replace('target_pc[19:2]', 'target_pc[14:2]')\n        p.write_text(s)\n    else:\n        p = rtl / 'ex_stage.sv'\n        s = p.read_text().replace('  output logic               resolved_taken', '''  output logic               resolved_taken,\n  input  logic [31:0]        fetched_pc,\n  output logic               miss''')\n        s = s.replace('  assign resolved_pc = resolved_taken ? (in.ctrl.is_jump ? jump_target : branch_target)\\\\n                                     : (in.pc + 32\\\\'d4);',\n                      '''  logic [31:0] control_target;\n  logic [31:0] fallthrough;\n  assign control_target = in.ctrl.is_jump ? jump_target : branch_target;\n  assign fallthrough = in.pc + 32'd4;\n  assign resolved_pc = resolved_taken ? control_target : fallthrough;\n  assign miss = resolved_taken ? (control_target \"'!= fetched_pc) : (fallthrough != fetched_pc);'\"''')\n        assert 'assign miss =' in s\n        p.write_text(s)\n        p = rtl / 'core.sv'\n        s = p.read_text().replace('  logic        recover;', '  logic        recover;\\\\n  logic        miss;')\n        s = s.replace('(resolved_pc \"'!= io_imemAddr)'\"', 'miss')\n        s = s.replace('.resolved_taken  (resolved_taken)\\\\n', '.resolved_taken  (resolved_taken),\\\\n    .fetched_pc      (io_imemAddr),\\\\n    .miss            (miss)\\\\n')\n        p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
