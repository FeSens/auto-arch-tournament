rect && !taken)\"+(\" || taken_in_window\" if b_format == 1 else \" || (taken_in_window && instr[6:0] == 7'\"'h6f)\\\")+\\\")\\\")\ns = s.replace(\\\"(\"'!collect_word || last_q[2])\", f\"(!collect_word || take_tail || last_q[{length-2}])\")\ns = s.replace(\"assign resume = collect_word\", \"assign resume = take_tail ? {1'\"'b0, pc_next[19:2]} : collect_word\\\")\ns = s.replace(\\\"(last_q == 4'b0000) ? 4'b0001 : {last_q[2:0], 1'b0}\\\", f\\\"(last_q == 0) ? {length}'b1 : {{last_q[{length-2}:0], 1'b0}}\\\")\ns = s.replace(\\\"lane < 4; lane++\\\", f\\\"lane < {length}; lane++\\\")\ns = s.replace(\\\"    update_q.taken <= finish_prefix;\\\", \\\"    update_q.taken <= finish_prefix;\\\\n    update_q.taken_tail <= take_tail;\\\")\nif staged:\n    for name in ('advance', 'pc', 'pc_next', 'instr', 'direct', 'taken'):\n        import re\n        s = re.sub(r'(?<\"'![A-Za-z0-9_.])'\"'+name+r'(?\"'![A-Za-z0-9_])'\"',name+'_input',s,count=1)\n    loc=s.index(\\\"\\\\n  logic collecting_q;\\\")\n    s=s[:loc]+\\\"\\\"\\\"\n  logic advance, direct, taken;\n  logic [31:0] pc, pc_next, instr;\n\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) advance <= 1'b0;\n    else advance <= advance_input;\n    direct <= direct_input;\n    taken <= taken_input;\n    pc <= pc_input;\n    pc_next <= pc_next_input;\n    instr <= instr_input;\n  end\n\\\"\\\"\\\"+s[loc:]\nf.write_text(s)\n\nf = p/'core.sv'\ns = f.read_text()\nif staged:\n    a=s.index(\\\"  replay_train u_replay_train (\\\")\n    b=s.index(\\\"  );\\\",a)\n    frag=s[a:b]\n    import re\n    frag=re.sub(r'\\\\.(advance|direct|taken|pc|pc_next|instr) ',r'.\\\\1_input ',frag)\n    s=s[:a]+frag+s[b:]\nf.write_text(s)\n\nf = p/'if_stage.sv'\ns = f.read_text()\nif map_mode \"'!= 0:\n    s = s.replace(\"logic [6:2] fetch_index, update_index, write_index;\", f\"\"\"logic [{idx_bits-1}:0] fetch_index, update_index, write_index;\n  function automatic [{idx_bits-1}:0] index_for(input logic [19:2] addr);\n    index_for = {in