{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"cat > direct_prototype.py <<'PY'\nfrom pathlib import Path\n\nrtl = Path('cores/bench/rtl')\n\ndef change(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old, text.count(old))\n        text = text.replace(old, new)\n    path.write_text(text)\n\nfields = '''    logic [31:0] direct_pc;\n    logic [31:0] sequential_pc;\n    logic        direct_nonseq;\n    logic        predicted_taken;\n'''\nchange('core_pkg.sv', [\n('    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;', fields + '    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;'),\n('    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;', fields + '    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;')])\n\nchange('id_stage.sv', [\n('      reg_q.pc           <= in.pc;', '''      reg_q.pc           <= in.pc;\n      reg_q.direct_pc    <= in.direct_pc;\n      reg_q.sequential_pc <= in.sequential_pc;\n      reg_q.direct_nonseq <= in.direct_nonseq;\n      reg_q.predicted_taken <= in.predicted_taken;''')])\n\nchange('if_stage.sv', [\n('  output if_id_t  out', '''  input  logic       direction_valid,\n  input  logic       direction_taken,\n  output if_id_t  out'''),\n('  logic [31:0] pc;', '''  logic [31:0] pc;\n  logic direct_jal, direct_branch;\n  logic [29:0] word_offset;\n  logic [31:0] direct_pc, sequential_pc;\n  logic direct_aligned, direct_nonseq, predicted_taken;\n\n  assign direct_jal = imem_data[6:0] == 7'b1101111;\n  assign direct_branch = imem_data[6:0] == 7'b1100011 &&\n                         imem_data[14:13] \"'!= 2'\"'b01;\n  assign word_offset = direct_jal\n      ? {{11{imem_data[31]}}, imem_data[31], imem_data[19:12],\n         imem_data[20], imem_data[30:22]}\n      : {{19{imem_data[31]}}, imem_data[31], imem_data[7],\n         imem_data[30:25], imem_data[11:9]};\n  assign direct_pc = {pc[31:2] + word_offset, 2'b00};\n  assign sequential_pc = {pc[31:2] + 30'd1, 2'b00};\n  assign direct_aligned = \"'!(direct_jal ? imem_data[21] : imem_data[8]);\n  assign direct_nonseq = word_offset != 30'\"'d1;\n  assign predicted_taken = direct_aligned && direct_pc[31:20] == 12'b0 &&\n      (direct_jal || (direct_branch &&\n                     (direction_valid ? direction_taken : imem_data[31])));'''),\n('    else if (\"'!stall)   pc <= pc + 32'\"\\\\'d4;', '''    else if (\"'!stall)   pc <= predicted_taken ? direct_pc : sequential_pc;'\"'''),\n('    out.pc    = pc;', '''    out.pc    = pc;\n    out.direct_pc = direct_pc;\n    out.sequential_pc = sequential_pc;\n    out.direct_nonseq = direct_nonseq;\n    out.predicted_taken = predicted_taken;''')])\n\nchange('ex_stage.sv', [\n('  output logic [31:0]        redirect_target', '''  output logic [31:0]        redirect_target,\n  output logic               train_valid,\n  output logic               train_taken'''),\n('  logic [31:0] direct_target;\\\\n', ''),\n('  logic [31:0] pc_plus_four;\\\\n', '''  logic [31:0] pc_next;\n  logic        direct_taken;\n  logic        indirect_taken;\n'''),\n('  assign direct_target = in.pc + in.imm;\\\\n', ''),\n(\\\"  assign pc_plus_four = in.pc + 32'd4;\\\\n\\\", ''),\n(\\\"  assign redirect_target = in.ctrl.is_jalr ? {effective_addr[31:1], 1'b0} : direct_target;\\\\n\\\", ''),\n('  assign redirect = ex_valid && \"'!stall && control_taken && !target_misaligned;'\"', '''  assign direct_taken = control_taken && \"'!target_misaligned && !in.ctrl.is_jalr;\n  assign indirect_taken = control_taken && !target_misaligned && in.ctrl.is_jalr;\n  assign pc_next = ({32{direct_taken}} & in.direct_pc)\n                 | ({32{indirect_taken}} & {effective_addr[31:1], 1'\"'b0})\n                 | ({32{\"'!(direct_taken || indirect_taken)}} & in.sequential_pc);\n  assign redirect_target = pc_next;\n  assign redirect = ex_valid && !stall &&\n      (indirect_taken || (in.direct_nonseq && (direct_taken != in.predicted_taken)));\n  assign train_valid = ex_valid && !stall && in.ctrl.is_branch &&\n                       !in.ctrl.is_illegal && !misalign_fault;\n  assign train_taken = branch_taken;'\"'''),\n('in.ctrl.is_jump ? pc_plus_four', 'in.ctrl.is_jump ? in.sequential_pc'),\n('reg_q.pc_next       <= redirect ? redirect_target : pc_plus_four;', 'reg_q.pc_next       <= pc_next;')])\n\nchange('core.sv', [\n('  logic [31:0] redirect_target;', '''  logic [31:0] redirect_target;\n  logic direction_valid, direction_taken;\n  logic train_valid, train_taken;\n\n  branch_predictor u_predictor (\n    .clock           (clock),\n    .reset           (reset),\n    .fetch_index     (io_imemAddr[8:2]),\n    .direction_valid (direction_valid),\n    .direction_taken (direction_taken),\n    .train_index     (id_ex_w.pc[8:2]),\n    .train_valid     (train_valid),\n    .train_taken     (train_taken)\n  );'''),\n('    .imem_ready      (io_imemReady),\\\\n    .out', '''    .imem_ready      (io_imemReady),\n    .direction_valid (direction_valid),\n    .direction_taken (direction_taken),\n    .out'''),\n('    .redirect_target (redirect_target)\\\\n  );', '''    .redirect_target (redirect_target),\n    .train_valid     (train_valid),\n    .train_taken     (train_taken)\n  );''')])\n\n(rtl / 'branch_predictor.sv').write_text('''module branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic [6:0]  fetch_index,\n  output logic        direction_valid,\n  output logic        direction_taken,\n  input  logic [6:0]  train_index,\n  input  logic        train_valid,\n  input  logic        train_taken\n);\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counters [0:127];\n  logic [127:0] valid;\n  logic       update_valid;\n  logic       update_taken;\n  logic [6:0] update_index;\n  logic [1:0] update_old, update_new;\n\n  assign direction_valid = valid[fetch_index];\n  assign direction_taken = counters[fetch_index][1];\n  assign update_old = counters[update_index];\n  always_comb begin\n    if (\"'!valid[update_index])\n      update_new = update_taken ? 2'\"'b10 : 2'b01;\n    else if (update_taken)\n      update_new = update_old == 2'b11 ? update_old : update_old + 2'b01;\n    else\n      update_new = update_old == 2'b00 ? update_old : update_old - 2'b01;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      update_valid <= 1'b0;\n      valid <= '0;\n    end else begin\n      update_valid <= train_valid;\n      if (update_valid) valid[update_index] <= 1'b1;\n    end\n    if (train_valid) begin\n      update_index <= train_index;\n      update_taken <= train_taken;\n    end\n    if (update_valid) counters[update_index] <= update_new;\n  end\nendmodule\n''')\nPY\npython3 direct_prototype.py && make lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
