{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c 'bench_scratch=$(mktemp -d \"$TMPDIR/bench-fetch.XXXXXX\")\ncp -a Makefile bench cores fpga test \"$bench_scratch/\"\nprintf '\"'%s\\\\n' \\\"\"'$bench_scratch\"\npython3 - \"$bench_scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1]) / 'cores/bench/rtl'\np = rtl / 'if_stage.sv'\np.write_text(\\\"\\\"\\\"module if_stage (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        consume,\n  input  logic        redirect,\n  input  logic [31:0] redirect_target,\n  output logic [31:0] imem_addr,\n  input  logic [31:0] imem_data,\n  input  logic        imem_ready,\n  output if_id_t      out\n);\n\n  logic [31:0] pc_q;\n  logic [63:0] head_q, tail_q;\n  logic head_valid_q, tail_valid_q;\n  logic fetch_accept;\n\n  assign fetch_accept = imem_ready && \"'!tail_valid_q;\n  assign imem_addr = pc_q;\n\n  assign {out.pc, out.instr} = head_valid_q ? head_q : {pc_q, imem_data};\n  assign out.valid = head_valid_q || fetch_accept;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_q <= 32'\"'b0;\n    end else if (redirect) begin\n      pc_q <= redirect_target;\n    end else if (fetch_accept) begin\n      pc_q <= pc_q + 32'd4;\n    end\n\n    if (reset || redirect) begin\n      head_valid_q <= 1'b0;\n      tail_valid_q <= 1'b0;\n    end else begin\n      if (consume)\n        head_valid_q <= tail_valid_q || (head_valid_q && fetch_accept);\n      else if (fetch_accept)\n        head_valid_q <= 1'b1;\n\n      if (consume)\n        tail_valid_q <= 1'b0;\n      else if (head_valid_q && fetch_accept)\n        tail_valid_q <= 1'b1;\n    end\n\n    if (consume && tail_valid_q)\n      head_q <= tail_q;\n    else if (fetch_accept && (\"'!head_valid_q || consume))\n      head_q <= {pc_q, imem_data};\n\n    if (head_valid_q && !consume && fetch_accept)\n      tail_q <= {pc_q, imem_data};\n  end\nendmodule\n\"\"\")\n\np = r