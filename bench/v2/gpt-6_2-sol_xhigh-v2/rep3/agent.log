{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom tools.eval.gowin import build_all\n\nscratch = Path('/srv/hwebench/tmp/5a1ea1b1/e19c4c92/bench-r10s0-vu6d70fw')\n\ndef variant(name, style):\n rtl = scratch / name / 'rtl'\n shutil.copytree(scratch / 'local_repair' / 'rtl', rtl)\n p = rtl / 'if_stage.sv'\n s = p.read_text()\n def edit(a,b):\n  nonlocal s\n  assert s.count(a)==1,a\n  s=s.replace(a,b)\n if style == 'canonical':\n  for f in ('core_pkg.sv','core.sv','id_stage.sv'):\n   shutil.copyfile(scratch/'fetch_illegal'/'rtl'/f, rtl/f)\n  edit('  logic [3:0] synthetic_q;\\\\n  logic issue_synthetic_q;','  logic [31:0] accepted_bus_word;')\n  edit('  assign normal_response =','  assign accepted_bus_word = {32{in_window}} & imem_data;\\\\n  assign normal_response =')\n  edit('bus_words[write_slot] <= imem_data;', 'bus_words[write_slot] <= accepted_bus_word;')\n  edit('      synthetic_q[write_slot] <= \"'!in_window;'\"\\\\n','')\n  edit('  assign out.synthetic = issue_synthetic_q;\\\\n','')\n  edit('({32{use_response}} & imem_data)', '({32{use_response}} & accepted_bus_word)')\n  edit('      issue_synthetic_q <= (use_response && \"'!in_window)'\"\\\\n                        || (use_queued_bus && synthetic_q[next_head]);\\\\n','')\n elif style == 'pc':\n  edit('logic [59:0] bus_pc [0:3];','logic [31:2] bus_pc [0:3];')\n  edit('bus_pc[write_slot] <= {request_pc, request_next};','bus_pc[write_slot] <= request_pc;')\n  edit('assign head_bus_pc = bus_pc[head_q];',\n       'assign head_bus_pc.addr = bus_pc[head_q];\\\\n  assign head_bus_pc.addr_plus_four = head_bus_pc.addr + 30\\\\'d1;')\n p.write_text(s)\n return rtl\n\nnames = ['canonical_repair','compact_pc_repair']\nwith ThreadPoolExecutor(max_workers=2) as executor:\n jobs=[executor.submit(build_all, Path.cwd(), variant(name, style), 'fpga/core_bench_si.sv', scratch/name)\n       for name,style in zip(names,['canonical','pc'])]\n for name,job in zip(names,jobs):\n  for r in job.result():\n   print(name, r['place_option'], r['fmax_mhz'], r.get('critical_paths', [])[:2], r.get('reason', ''), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
