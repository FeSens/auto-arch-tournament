{"type": "item.started", "item": {"id": "item_73", "type": "command_execution", "command": "/bin/bash -c 'for name in fast-target-in-id fast-last-outcome; do\n  mkdir -p \"variants/$name/cores/bench\" &&\n  cp -r variants/fast-recover/cores/bench/rtl variants/fast-recover/cores/bench/test cores/bench/core.yaml \"variants/$name/cores/bench/\" &&\n  cp -r fpga \"variants/$name/\" &&\n  ln -s '\"'/srv/hwebench/tmp/5a1ea1b1/dacb2f47/predictor-r5-PTBzWH/bench' \\\"variants/\"'$name/bench\" &&\n  ln -s '\"'/srv/hwebench/tmp/5a1ea1b1/dacb2f47/predictor-r5-PTBzWH/test' \\\"variants/\"'$name/test\" || exit 1\ndone &&\npython3 - <<'\"'PY'\nfrom pathlib import Path\ndef patch(name,file,pairs):\n    p = Path('variants') / name / 'cores/bench/rtl' / file\n    s = p.read_text()\n    for old, new in pairs:\n        assert s.count(old) == 1, (file,old,s.count(old))\n        s = s.replace(old,new,1)\n    p.write_text(s)\npatch('fast-target-in-id','core_pkg.sv',[\n    ('    logic [31:0] rs1_val;\\\\n    logic [31:0] rs2_val;\\\\n    logic [1:0]  ex_mem_match;',\n     '    logic [31:0] direct_target;\\\\n    logic [31:0] rs1_val;\\\\n    logic [31:0] rs2_val;\\\\n    logic [1:0]  ex_mem_match;'),\n])\npatch('fast-target-in-id','id_stage.sv',[\n    ('  // ── ID/EX register', '''  logic [29:0] branch_offset, jump_offset, direct_offset, direct_target_word;\n  logic direct_low_bit;\n  assign branch_offset = {{19{in.instr[31]}}, in.instr[31], in.instr[7],\n                         in.instr[30:25], in.instr[11:9]};\n  assign jump_offset = {{11{in.instr[31]}}, in.instr[31], in.instr[19:12],\n                       in.instr[20], in.instr[30:22]};\n  assign direct_offset = in.instr[3] ? jump_offset : branch_offset;\n  assign direct_target_word = in.pc[31:2] + direct_offset;\n  assign direct_low_bit = in.instr[3] ? in.instr[21] : in.instr[8];\n\n  // ── ID/EX register'''),\n    ('      reg_q.pc           <= in.pc;',\n     \\\"      reg_q.pc           <= in.pc;\\\\n      reg_q.direct_target <= {