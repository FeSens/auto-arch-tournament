div_lane #(.PREFIX(14), .WIDTH(20), .RADIX_BITS(3)) u_d20 (\n    .clock(clock), .setup(lane_setup), .step(lane_step),\n    .selected(select_q[2]), .dividend(dividend_abs_q), .divisor(divisor_abs_q[19:0]),\n    .remainder(remainder_op_q), .result(lane_result_20)\n  );\n  div_lane #(.PREFIX(20), .WIDTH(32), .RADIX_BITS(2)) u_d32 (\n    .clock(clock), .setup(lane_setup), .step(lane_step),\n    .selected(select_q[3]), .dividend(dividend_abs_q), .divisor(divisor_abs_q),\n    .remainder(remainder_op_q), .result(lane_result_32)\n  );\n\n  assign magnitude = lane_result_14 | lane_result_20 | lane_result_32;\n  assign corrected = conditional_negate(magnitude, negate_q);\n\n  always_comb begin\n    if (divide_by_zero_q)\n      result = remainder_op_q ? src_a : 32'\"'hffff_ffff;\n    else\n      result = select_q[0] ? narrow_result_q : corrected;\n  end\n\"'`endif\n\nendmodule\n'\"'''\nunit.write_text(s)\npkg=root/'core_pkg.sv'\ns=pkg.read_text().replace('    branch_sel_t branch_sel;', '    branch_sel_t branch_sel;\\\\n    logic sub_capture;\\\\n    logic div_capture;')\npkg.write_text(s)\nid_stage=root/'id_stage.sv'\ns=id_stage.read_text().replace('  result_sel_t result_sel;', '''  logic divide_op;\n  assign divide_op = dec_alu_op == ALU_DIV || dec_alu_op == ALU_DIVU\n                  || dec_alu_op == ALU_REM || dec_alu_op == ALU_REMU;\n\n  result_sel_t result_sel;''').replace('          ALU_SUB:', '          ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, ALU_SUB:').replace('      reg_q.branch_sel   <= branch_sel;', '''      reg_q.branch_sel   <= branch_sel;\n      reg_q.sub_capture  <= dec_alu_op == ALU_SUB;\n      reg_q.div_capture  <= divide_op;''')\nid_stage.write_text(s)\nex_stage=root/'ex_stage.sv'\ns=ex_stage.read_text().replace('  assign divide = in.valid && (in.ctrl.alu_op == ALU_DIV || in.ctrl.alu_op == ALU_DIVU\\\\n                           || in.ctrl.alu_op == ALU_REM || in.ctrl.alu_op == ALU_REMU);','  assign divide = in.valid && in.div_capture;').replace('      reg_q.r