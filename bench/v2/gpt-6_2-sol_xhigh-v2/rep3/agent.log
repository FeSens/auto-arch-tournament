{"type": "item.started", "item": {"id": "item_40", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, os\n\nstudy = Path(os.environ['TMPDIR'])/'r7s0-study'\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nrtl = study/'divseg'\nshutil.copytree('cores/bench/rtl', rtl, dirs_exist_ok=True)\nupdate('div_unit.sv', [\n    ('  logic [36:0] wide_diff [1:15];', '  logic [31:0] wide_diff [1:15];'),\n    ('''    assign wide_diff[digit] = {1'b0, wide_trial} - {1'b0, multiple_q[digit]};\n    assign wide_borrow[digit] = wide_diff[digit][36];''',\n     '''    logic [3:0] gen_borrow, propagate;\n    logic [4:0] borrow;\n    assign borrow[0] = 1'b0;\n    assign borrow[1] = gen_borrow[0];\n    assign borrow[2] = gen_borrow[1] || (propagate[1] && gen_borrow[0]);\n    assign borrow[3] = gen_borrow[2] || (propagate[2] && gen_borrow[1])\n                    || ((&propagate[2:1]) && gen_borrow[0]);\n    assign borrow[4] = gen_borrow[3] || (propagate[3] && gen_borrow[2])\n                    || ((&propagate[3:2]) && gen_borrow[1])\n                    || ((&propagate[3:1]) && gen_borrow[0]);\n    assign wide_borrow[digit] = borrow[4];\n    for (genvar section = 0; section < 4; section++) begin : gen_section\n      localparam int WIDTH = section == 3 ? 12 : 8;\n      logic [WIDTH-1:0] lhs, rhs;\n      logic [WIDTH:0] local_diff;\n      assign lhs = wide_trial[8*section +: WIDTH];\n      assign rhs = multiple_q[digit][8*section +: WIDTH];\n      assign local_diff = {1'b0, lhs} - {1'b0, rhs};\n      assign gen_borrow[section] = local_diff[WIDTH];\n      assign propagate[section] = lhs == rhs;\n      if (section < 3) begin : gen_low\n        if (section == 0)\n          assign wide_diff[digit][8*section +: 8] = local_diff[7:0];\n        else\n          assign wide_diff[digit][8*section +: 8] =\n            borrow[section] ? (local_diff[7:0] - 8'd1) : local_diff[7:0];\n      end else begin : gen_high\n        assign wide_diff[digit][31:24] = borrow[section] ? (local_diff[7:0] - 8'd1) : local_diff[7:0];\n      end\n    end''')\n])\n\nrtl = study/'branchlut'\nshutil.copytree(study/'preselect', rtl, dirs_exist_ok=True)\nupdate('ex_stage.sv', [\n    ('  logic [3:0]  byte_equal, byte_less;','  logic [15:0] cmp_equal, cmp_less;\\\\n  logic [7:0] p4, g4;\\\\n  logic [3:0] p8, g8;\\\\n  logic [1:0] p16, g16;'),\n    ('''  for (genvar i = 0; i < 4; i++) begin : gen_branch_compare\n    assign byte_equal[i] = rs1[8*i +: 8] == rs2[8*i +: 8];\n    assign byte_less[i]  = rs1[8*i +: 8] <  rs2[8*i +: 8];\n  end\n\n  // The highest unequal byte decides ordering. Opposite signs can only\n  // reverse the comparison in the high byte.\n  assign branch_equal = &byte_equal;\n  assign branch_less = (byte_less[3] \"'^ (in.branch_sel.signed_compare && (rs1[31] != rs2[31])))\n                     | (byte_equal[3]      & byte_less[2])\n                     | ((&byte_equal[3:2]) & byte_less[1])\n                     | ((&byte_equal[3:1]) & byte_less[0]);'\"''',\n    '''  for (genvar i = 0; i < 16; i++) begin : gen_branch_compare\n    assign cmp_equal[i] = rs1[2*i +: 2] == rs2[2*i +: 2];\n    assign cmp_less[i] = rs1[2*i +: 2] < rs2[2*i +: 2];\n  end\n  for (genvar i = 0; i < 8; i++) begin : gen_cmp4\n    assign p4[i] = cmp_equal[2*i+1] & cmp_equal[2*i];\n    assign g4[i] = cmp_less[2*i+1] | (cmp_equal[2*i+1] & cmp_less[2*i]);\n  end\n  for (genvar i = 0; i < 4; i++) begin : gen_cmp8\n    assign p8[i] = p4[2*i+1] & p4[2*i];\n    assign g8[i] = g4[2*i+1] | (p4[2*i+1] & g4[2*i]);\n  end\n  for (genvar i = 0; i < 2; i++) begin : gen_cmp16\n    assign p16[i] = p8[2*i+1] & p8[2*i];\n    assign g16[i] = g8[2*i+1] | (p8[2*i+1] & g8[2*i]);\n  end\n  assign branch_equal = &p16;\n  assign branch_less = (g16[1] | (p16[1] & g16[0]))\n                     \"'^ (in.branch_sel.signed_compare && (rs1[31] != rs2[31]));'\"'''),\n])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/r7s0-study/synth.py\" divseg'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
