{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/stage_shift.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nroot=Path(sys.argv[1])\nbase=Path('cores/bench/rtl')\ndef variant(name, keep_short):\n    dest=root/name/'rtl'\n    copytree(base,dest,dirs_exist_ok=True)\n    for f in ('core_pkg','core','id_stage','alu','ex_stage','mem_stage'):\n        p=dest/(f+'.sv')\n        s=p.read_text()\n        if f=='core_pkg':\n            s=s.replace('    branch_sel_t branch_sel;', '    branch_sel_t branch_sel;\\\\n    logic late_shift;')\n            s=s.replace('    result_lanes_t result;', '    result_lanes_t result;\\\\n    logic late_shift;\\\\n    logic [2:0] shift_hi;')\n        if f=='core':\n            s=s.replace('id_ex_w.valid && id_ex_w.ctrl.mem_read', 'id_ex_w.valid && (id_ex_w.ctrl.mem_read || id_ex_w.late_shift)')\n        if f=='id_stage':\n            line = ' && \"'!(dec_alu_src && imm[4:2] == 3'\"\\\\'b000)' if keep_short else ''\n            s=s.replace('      reg_q.branch_sel   <= branch_sel;', f'''      reg_q.branch_sel   <= branch_sel;\n      reg_q.late_shift   <= (dec_alu_op == ALU_SLL || dec_alu_op == ALU_SRL || dec_alu_op == ALU_SRA){line};''')\n        if f=='alu':\n            s=s.replace('module alu (','module alu #(parameter bit PARTIAL_SHIFT = 1\\\\'b0) (')\n            s=s.replace('assign shamt = b[4:0];', 'assign shamt = PARTIAL_SHIFT ? {3\\\\'b0, b[1:0]} : b[4:0];')\n        if f=='ex_stage':\n            s=s.replace('  alu u_alu (','  alu #(.PARTIAL_SHIFT(1)) u_alu (')\n            s=s.replace('&& \"'!in.ctrl.mem_read;'\"', '&& \"'!in.ctrl.mem_read && !in.late_shift;'\"')\n            s=s.replace('      reg_q.result.add    <= add_result;', '''      reg_q.result.add    <= add_result;\n      reg_q.late_shift    <= in.late_shift;\n      reg_q.shift_hi      <= alu_b[4:2];''')\n        if f=='mem_stage':\n            s=s.replace('  // The load has no EX result class', '''  logic [31:0] other_result;\n  logic signed [32:0] partial_shift;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [32:0] late_shift_result;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign partial_shift = \"'$signed({(in.ctrl.alu_op == ALU_SRA) && in.result.other[31], in.result.other});\n  assign late_shift_result = partial_shift >>> {in.shift_hi, 2'\"'b0};\n  assign other_result = \"'!in.late_shift ? in.result.other\n                      : (in.ctrl.alu_op == ALU_SLL) ? (in.result.other << {in.shift_hi, 2'\"'b0})\n                      : late_shift_result[31:0];\n\n  // The load has no EX result class''')\n            s=s.replace('& in.result.other)\\\\n', '& other_result)\\\\n')\n        p.write_text(s)\nvariant('shift_all',False)\nvariant('shift_long',True)\nPY\npython \\\"\"'$probe/stage_shift.py\" \"$probe\"\nfor variant in shift_all shift_long; do\n  PYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/$variant\" > \"$probe/$variant/out.log\" 2>&1 &\ndone\nwait\nfor variant in shift_all shift_long; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  cat \"$probe/$variant/out.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
