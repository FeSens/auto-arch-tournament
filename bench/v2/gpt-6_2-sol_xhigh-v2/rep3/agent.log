{"type":"item.completed","item":{"id":"item_53","type":"agent_message","text":"The block-borrow prototypes passed the arithmetic tests and reproduced 3,750,582 CoreMark cycles, but their best median fell to 84.436 MHz. The control build reproduced 101.544 MHz. I’m testing a smaller shared threshold bank that keeps Gowin’s native carry chains."}}
{"type": "item.started", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/bash -c 'for name in bank bank_ex ex_decode trim; do\n    mkdir -p \"$name/cores/bench\"\n    cp -R base/Makefile base/fpga base/tools \"$name/\"\n    cp -R base/cores/bench/core.yaml base/cores/bench/rtl \"$name/cores/bench/\"\n    ln -s ../base/.toolchain \"$name/.toolchain\"\ndone\ncat > make_bank.py <<'\"'PY'\nfrom pathlib import Path\np = Path(\\\"cores/bench/rtl/div_unit.sv\\\")\nbase = (Path(\\\"base\\\") / p).read_text()\nstart = base.index(\\\"  // Appending four bits\\\")\nend = base.index(\\\"  // Each mask\\\", start)\n\nbank = \\\"\\\"\\\"\n  logic radix16_q, radix8_q, radix4_q;\n  logic radix16, radix8, radix4;\n  logic [19:0] seed_trial, seed_remainder;\n  logic [20:0] seed_diff [1:3];\n  logic [4:0] seed_borrow;\n  logic [3:0] seed_select;\n  logic [1:0] seed_digit;\n\n  assign radix16 = \"'!(|divisor_abs_q[31:12]);\n  assign radix4 = |divisor_abs_q[31:18];\n  assign radix8 = !radix16 && !radix4;\n  assign seed_trial = radix4 ? dividend_abs_q[31:12]\n                             : {6'\"'b0, dividend_abs_q[31:18]};\n  assign seed_borrow[0] = 1'b0;\n  assign seed_borrow[4] = 1'b1;\n  for (genvar k = 1; k <= 3; k++) begin : gen_seed\n    logic [35:0] threshold;\n    if (k == 1) assign threshold = d;\n    if (k == 2) assign threshold = d_times_2;\n    if (k == 3) assign threshold = d_times_2 + d;\n    assign seed_diff[k] = {1'b0, seed_trial} - {1'b0, threshold[19:0]};\n    assign seed_borrow[k] = (|threshold[35:20]) || seed_diff[k][20];\n  end\n  for (genvar k = 0; k < 4; k++) begin : gen_seed_select\n    assign seed_select[k] = \"'!seed_borrow[k] && seed_borrow[k+1];\n  end\n  assign seed_remainder = ({20{seed_select[0]}} & seed_trial)\n                        | ({20{seed_select[1]}} & seed_diff[1][19:0])\n                        | ({20{seed_select[2]}} & seed_diff[2][19:0])\n                        | ({20{seed_select[3]}} & seed_diff[3][19:0]);\n  assign seed_digit = {|seed_select[3:2], seed_select[3] || seed_select[1]};\n\n  logic [31:0] wide_trial;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] diff_candidate [0:15];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [16:0] wide_borrow;\n  logic [15:0] wide_select;\n  logic [31:0] wide_remainder_next;\n  logic [3:0] wide_digit;\n\n  // At every step the trial fits in the processed dividend prefix.\n  // The prefixes never exceed 32 bits.\n  assign wide_trial = ({32{radix16_q}} & {wide_remainder_q[27:0], wide_dividend_quotient_q[23:20]})\n                    | ({32{radix8_q}}  & {wide_remainder_q[28:0], wide_dividend_quotient_q[23:21]})\n                    | ({32{radix4_q}}  & {wide_remainder_q[29:0], wide_dividend_quotient_q[23:22]});\n  assign diff_candidate[0] = wide_trial;\n  assign wide_borrow[0] = 1'\"'b0;\n  assign wide_borrow[16] = 1'b1;\n  for (genvar digit = 1; digit < 16; digit++) begin : gen_wide_diff\n    localparam int TRIAL_BITS = digit < 4 ? 32 : digit < 8 ? 21 : 16;\n    logic [TRIAL_BITS:0] delta;\n    assign delta = {1'b0, wide_trial[TRIAL_BITS-1:0]}\n                 - {1'b0, multiple_q[digit][TRIAL_BITS-1:0]};\n    assign diff_candidate[digit] = 32'(delta[TRIAL_BITS-1:0]);\n    if (digit < 4) begin : gen_full_width\n      assign wide_borrow[digit] = wide_multiple_over_q[digit] || delta[TRIAL_BITS];\n    end else if (digit < 8) begin : gen_medium_width\n      assign wide_borrow[digit] = radix4_q || delta[TRIAL_BITS];\n    end else begin : gen_small_width\n      assign wide_borrow[digit] = \"'!radix16_q || delta[TRIAL_BITS];\n    end\n  end\n  for (genvar digit = 0; digit < 16; digit++) begin : gen_wide_select\n    assign wide_select[digit] = !wide_borrow[digit] && wide_borrow[digit + 1];\n  end\n  for (genvar bit_idx = 0; bit_idx < 32; bit_idx++) begin : gen_wide_remainder\n    logic [15:0] selected_bits;\n    for (genvar digit = 0; digit < 16; digit++) begin : gen_candidate\n      assign selected_bits[digit] = diff_candidate[digit][bit_idx] & wide_select[digit];\n    end\n    assign wide_remainder_next[bit_idx] = |selected_bits;\n  end\n\n\"\"\"\ns = base[:start] + bank + base[end:]\ns = s.replace(\"  logic [35:0] multiple_q [1:15];\", \"\"\"  /* verilator lint_off UNUSEDSIGNAL */\n  logic [35:0] multiple_q [1:15];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [3:1] wide_multiple_over_q;\"\"\")\ns = s.replace(\"      wide_q <= wide_divisor;\", \"\"\"      wide_q <= wide_divisor;\n      radix16_q <= radix16;\n      radix8_q <= radix8;\n      radix4_q <= radix4;\n      wide_multiple_over_q[1] <= 1'\"'b0;\n      wide_multiple_over_q[2] <= divisor_abs_q[31];\n      wide_multiple_over_q[3] <= (d_times_2 + d) >= 36'h1_0000_0000;\\\"\\\"\\\")\nstart = s.index(\\\"      if (wide_divisor) begin\\\")\nend = s.index(\\\"    end else if (phase_q >= FIRST_GROUP\\\", start)\ns = s[:start] + \\\"\\\"\\\"      if (radix16) begin\n        wide_remainder_q <= {24'b0, dividend_abs_q[31:24]};\n        wide_dividend_quotient_q <= dividend_abs_q[23:0];\n      end else begin\n        wide_remainder_q <= {12'b0, seed_remainder};\n        wide_dividend_quotient_q <= radix4 ? {dividend_abs_q[11:0], 10'b0, seed_digit}\n                                          : {dividend_abs_q[17:0], 4'b0, seed_digit};\n      end\n\\\"\\\"\\\" + s[end:]\ns = s.replace(\\\"wide_dividend_quotient_q <= {wide_dividend_quotient_q[19:0], wide_digit};\\\",\n\\\"\\\"\\\"wide_dividend_quotient_q <=\n          ({24{radix16_q}} & {wide_dividend_quotient_q[19:0], wide_digit})\n        | ({24{radix8_q}}  & {wide_dividend_quotient_q[20:0], wide_digit[2:0]})\n        | ({24{radix4_q}}  & {wide_dividend_quotient_q[21:0], wide_digit[1:0]});\\\"\\\"\\\")\nfor name in (\\\"bank\\\",\\\"bank_ex\\\"):\n    (Path(name) / p).write_text(s)\n\ntrim = base.replace(\\\"  logic [35:0] wide_trial;\\\", \\\"  logic [31:0] wide_trial;\\\")\ntrim = trim.replace(\\\"  logic [36:0] wide_diff [1:15];\\\", \\\"  logic [32:0] wide_diff [1:15];\\\")\ntrim = trim.replace(\n    \\\"  assign wide_trial = {wide_remainder_q, wide_dividend_quotient_q[23:20]};\\\",\n    \\\"  assign wide_trial = {wide_remainder_q[27:0], wide_dividend_quotient_q[23:20]};\\\")\ntrim = trim.replace(\\\" - {1'b0, multiple_q[digit]};\\\",\n                    \\\" - {1'b0, multiple_q[digit][31:0]};\\\")\ntrim = trim.replace(\\\" = wide_diff[digit][36];\\\",\n                    \\\" = wide_diff[digit][32] || (|multiple_q[digit][35:32]);\\\")\n(Path(\\\"trim\\\") / p).write_text(trim)\nPY\npython make_bank.py\nfor name in bank trim; do\n    make -C \\\"\"'$name\" lint TARGET=bench\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
