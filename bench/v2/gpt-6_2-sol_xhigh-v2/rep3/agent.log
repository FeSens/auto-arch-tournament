{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, os\n\nstudy = Path(os.environ['TMPDIR'])/'r7s0-study'\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nrtl = study/'unified'\nshutil.copytree(study/'preselect', rtl, dirs_exist_ok=True)\n\nupdate('id_stage.sv', [\n    ('  logic [1:0] ex_hit, mem_hit;', '  logic [1:0] ex_hit, mem_hit;\\\\n  logic execution_b_immediate;\\\\n  assign execution_b_immediate = dec_alu_src && \"'!dec_mem_write;'\"'),\n    (\\\"      reg_q.alu_b_sel    <= dec_alu_src ? '0 : rs2_sel;\\\", \\\"      reg_q.alu_b_sel    <= execution_b_immediate ? '0 : rs2_sel;\\\"),\n    ('\"'!dec_alu_src && !(ex_hit[1] || mem_hit[1])'\"','\"'!execution_b_immediate && !(ex_hit[1] || mem_hit[1])'\"'),\n    ('({32{dec_alu_src}} & imm);','({32{execution_b_immediate}} & imm);'),\n])\nupdate('ex_stage.sv', [\n    ('(rs1 + rs2) \"'^'\"', '(rs1 + alu_b) \"'^'\"'), # MULTIPLE occurrences replaced separately below\n] if False else [\n    ('  assign mul_b = \"'$signed({rs2[31] && (in.ctrl.alu_op == ALU_MULH), rs2});'\"','  assign mul_b = \"'$signed({alu_b[31] && (in.ctrl.alu_op == ALU_MULH), alu_b});'\"'),\n    ('    .b            (rs2),','    .b            (alu_b),'),\n    ('== rs2[8*i +: 8];','== alu_b[8*i +: 8];'),\n    ('<  rs2[8*i +: 8];','<  alu_b[8*i +: 8];'),\n    ('rs1[31] \"'!= rs2[31]'\"', 'rs1[31] \"'!= alu_b[31]'\"'),\n    ('      reg_q.write_data    <= rs2;', '      reg_q.write_data    <= alu_b;'),\n])\npath = rtl/'ex_stage.sv'\npath.write_text(path.read_text().replace('(rs1 + rs2)', '(rs1 + alu_b)').replace('(rs1 - rs2)', '(rs1 - alu_b)'))\n\nrtl = study/'branchsplit'\nshutil.copytree(study/'preselect', rtl, dirs_exist_ok=True)\nupdate('core_pkg.sv', [\n    ('    lo