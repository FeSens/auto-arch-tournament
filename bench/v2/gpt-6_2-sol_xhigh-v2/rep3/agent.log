{"type": "item.started", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/5a1ea1b1/7c4fbf7b/tmp.5Evixz2QTZ/model.cpp' <<'CPP'\n#include <algorithm>\n#include <array>\n#include <cassert>\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <cstring>\n#include <deque>\n#include <elf.h>\n#include <vector>\n\nstruct Retire {\n    uint32_t cycle, pc, next, word, mask, addr;\n};\nstruct Word {\n    uint32_t pc = 0, word = 0;\n    bool taken = false;\n};\nstruct Entry {\n    bool valid = false, direction = false;\n    unsigned ctr = 0;\n    uint32_t pc = 0, word = 0, resume = 0;\n    int bank = 0, len = 0;\n    Word body[16];\n};\nstruct Update {\n    bool valid = false, install = false, taken = false;\n    Entry entry;\n};\nstruct Pack {\n    Word bus;\n    unsigned len = 0, pos = 0;\n    int handle = -1;\n    Word body[16];\n};\nstruct PipeSlot {\n    bool valid = false;\n    int idx = -1;\n    Word op;\n};\nunsigned opcode(uint32_t insn) { return insn & 127; }\nbool branch(uint32_t insn) { return opcode(insn) == 0x63; }\nbool jal(uint32_t insn) { return opcode(insn) == 0x6f; }\nbool jalr(uint32_t insn) { return opcode(insn) == 0x67; }\nbool load(uint32_t insn) { return opcode(insn) == 3; }\nbool store(uint32_t insn) { return opcode(insn) == 0x23; }\nbool divop(uint32_t insn) { return opcode(insn) == 0x33 && (insn >> 25) == 1 && (insn & 0x4000) \"'!= 0; }\nbool direct(uint32_t insn) { return branch(insn) || jal(insn); }\nbool legal_direct(uint32_t insn) { return jal(insn) || (branch(insn) && ((insn >> 13) & 3) != 1); }\nbool ends_trace(uint32_t insn) { return jalr(insn) || opcode(insn) == 0x73 || opcode(insn) == 0xf; }\nbool fence_i(uint32_t insn) { return opcode(insn) == 0xf && ((insn >> 12) & 7) == 1; }\nbool in_window(uint32_t pc) { return pc < (1u << 20) && (pc & 3) == 0; }\nbool target_differs(uint32_t insn) {\n    if (branch(insn))\n        return (((insn >> 31) << 12) | (((insn >> 7) & 1) <<