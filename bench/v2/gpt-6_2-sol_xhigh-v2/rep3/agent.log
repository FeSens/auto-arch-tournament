{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"sed -n '102,266p' cores/bench/test/test_alu.py && cat formal/checks-deep.cfg\"", "aggregated_output": "    await _setup(dut)\n    await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup_div(dut):\n    dut.reset.value = 1\n    dut.issue.value = 0\n    dut.result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    assert int(dut.issue_ready.value) == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.issue.value = 1\n    dut.result_ready.value = int(hold_cycles == 0)\n    await _tick(dut)\n\n    # Forwarding inputs can change as older instructions leave the pipeline.\n    dut.issue.value = 0\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n    dut.op.value = ALU_ADD\n\n    for elapsed in range(7):\n        assert int(dut.issue_ready.value) == 0\n        assert int(dut.result_valid.value) == 0, f\"early result at cycle {elapsed}\"\n        await _tick(dut)\n\n    # A pending request must leave the held result and its sources intact.\n    if hold_cycles:\n        dut.op.value = ALU_DIVU\n        dut.issue.value = 1\n    for held in range(hold_cycles + 1):\n        assert int(dut.result_valid.value) == 1\n        assert int(dut.issue_ready.value) == 0\n        assert int(dut.src_a.value) == (a & MASK32)\n        assert int(dut.src_b.value) == (b & MASK32)\n        actual = int(dut.result.value)\n        assert actual == (expected & MASK32), (\n            f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n            f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n        )\n        if held < hold_cycles:\n            await _tick(dut)\n\n    dut.result_ready.value = 1\n    await _tick(dut)\n    dut.issue.value = 0\n    assert int(dut.result_valid.value) == 0\n    assert int(dut.issue_ready.value) == 1\n\n\n@cocotb.test()\nasync def divide_vectors(dut):\n    await _setup_div(dut)\n    vectors = [\n        (ALU_DIV, 10, 3, 3),\n        (ALU_DIV, -4, 2, -2),\n        (ALU_DIV, 7, -2, -3),\n     \n…[4993 of 8065 chars elided by tools/bench/transcript.py; sha256:58726a5b8ed0bc8a]…\nference.py — every retired MUL/DIV/REM\n#      diff'd field-by-field.\n#   3. `make formal-deep` — same checks without ALTOPS. SLOW (~hours per\n#      M-ext check) but proves real arithmetic. Run periodically, not in\n#      the per-iteration orchestrator loop.\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\n# A vacuous suite (nothing ever retires) would fail this — no symbolic\n# trace can make rvfi_valid && !rvfi_trap go true.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n@basedir@/cores/@core@/core_pkg.sv\n@basedir@/cores/@core@/alu.sv\n@basedir@/cores/@core@/decoder.sv\n@basedir@/cores/@core@/imm_gen.sv\n@basedir@/cores/@core@/reg_file.sv\n@basedir@/cores/@core@/if_stage.sv\n@basedir@/cores/@core@/id_stage.sv\n@basedir@/cores/@core@/ex_stage.sv\n@basedir@/cores/@core@/mem_stage.sv\n@basedir@/cores/@core@/wb_stage.sv\n@basedir@/cores/@core@/hazard_unit.sv\n@basedir@/cores/@core@/forward_unit.sv\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
