{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c 'ls -la /srv/hwebench/tmp/5a1ea1b1/aedc2df2 && cat fpga/bench_stall_gen.sv && ls -la cores/bench/rtl'","aggregated_output":"total 24\ndrwxrwx---+  7 nobody    nogroup   4096 Nov 21 01:12 .\ndrwxrwx---+  5 nobody    nogroup   4096 Nov 21 01:09 ..\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 01:12 .agents\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 01:12 .aws\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 01:12 .codex\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 21 01:12 .git\ndrwxrwx---+ 12 hwebench2 hwebench2 4096 Nov 21 01:12 codex-bwrap-synthetic-mount-targets-1002\n// fpga/bench_stall_gen.sv\n//\n// Memory-ready generator for the timed FPGA wrapper (HWE Bench V2).\n//\n// It reproduces, cycle for cycle, the bus backpressure that\n// test/cosim/main.cpp applies when CoreMark is run for fitness\n// (--istall --dstall): an xorshift32 seeded with 0xDEADBEEF, advanced\n// twice per cycle (first draw -> imem ready, second draw -> dmem ready),\n// accepting when (state & 0x7F) < 100.\n//\n// Why it exists: in V1 the wrapper tied both ready signals to 1, so\n// synthesis deleted any core logic that only acts while a ready is low.\n// That logic then saved simulated cycles at no area or timing cost. With\n// the ready signals driven by this generator, the timed netlist is the\n// circuit whose cycles are counted.\n//\n// Both ready outputs come straight from flip-flops, so the generator adds\n// no combinational depth to paths inside the core. The reset values hold\n// the first cycle's draws; each clock precomputes the next cycle's pair.\nmodule bench_stall_gen (\n  input  logic clock,\n  input  logic reset,\n  output logic imem_ready,\n  output logic dmem_ready\n);\n\n  function automatic [31:0] xs32(input [31:0] s);\n    reg [31:0] t;\n    begin\n      t = s ^ (s << 13);\n      t = t ^ (t >> 17);\n      xs32 = t ^ (t << 5);\n    end\n  endfunction\n\n  function automatic accept(input [31:0] s);\n    accept = (s[6:0] < 7'd100);\n  endfunction\n\n  // State after the two draws of the current cycle.\n  logic [31:0] state;\n  logic [31:0] next_i, next_d;\n  assign next_i = xs32(state);\n  assign next_d = xs32(next_i);\n\n  // Reset values: state after the two draws of cycle 0, and the accept\n  // bits of those two draws (seed 0xDEADBEEF; see test_bench_stall_gen.py).\n  always_ff @(posedge clock or posedge reset) begin\n    if (reset) begin\n      state      <= 32'h8E1D9142;\n      imem_ready <= 1'b1;\n      dmem_ready <= 1'b1;\n    end else begin\n      state      <= next_d;\n      imem_ready <= accept(next_i);\n      dmem_ready <= accept(next_d);\n    end\n  end\n\nendmodule\ntotal 112\ndrwxrwx---+ 2 nobody nogroup 4096 Nov 21 01:09 .\ndrwxrwx---+ 5 nobody nogroup 4096 Nov 21 01:09 ..\n-rw-rw----+ 1 nobody nogroup 1333 Nov 21 01:09 alu.sv\n-rw-rw----+ 1 nobody nogroup 9836 Nov 21 01:09 core.sv\n-rw-rw----+ 1 nobody nogroup 5979 Nov 21 01:09 core_pkg.sv\n-rw-rw----+ 1 nobody nogroup 8860 Nov 21 01:09 decoder.sv\n-rw-rw----+ 1 nobody nogroup 8556 Nov 21 01:09 div_unit.sv\n-rw-rw----+ 1 nobody nogroup 8896 Nov 21 01:09 ex_stage.sv\n-rw-rw----+ 1 nobody nogroup 3569 Nov 21 01:09 hazard_unit.sv\n-rw-rw----+ 1 nobody nogroup 6224 Nov 21 01:09 id_stage.sv\n-rw-rw----+ 1 nobody nogroup 2311 Nov 21 01:09 if_stage.sv\n-rw-rw----+ 1 nobody nogroup 1317 Nov 21 01:09 imm_gen.sv\n-rw-rw----+ 1 nobody nogroup 6463 Nov 21 01:09 mem_stage.sv\n-rw-rw----+ 1 nobody nogroup 1957 Nov 21 01:09 reg_file.sv\n-rw-rw----+ 1 nobody nogroup  686 Nov 21 01:09 wb_stage.sv\n","exit_code":0,"status":"completed"}}
