{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'scratch_div=\"$TMPDIR/bench-div-r4.oDolNH\"\ndual_validation=\"$scratch_div/validation-dual16\"\nmkdir -p \"$dual_validation/cores/bench\" \"$dual_validation/formal/riscv-formal\"\ncp -R --no-preserve=all \"$scratch_div/dual16clean\" \"$dual_validation/cores/bench/rtl\"\ncp -R --no-preserve=all cores/bench/test cores/bench/core.yaml \"$dual_validation/cores/bench/\"\ncp -R --no-preserve=all \"$scratch_div/bench\" test tools Makefile \"$dual_validation/\"\ncp -R --no-preserve=all formal/checks*.cfg formal/wrapper*.sv formal/run_all.sh \"$dual_validation/formal/\"\nfor folder in checks insns; do\n    cp -R -L --no-preserve=all \"$PWD/formal/riscv-formal/$folder\" \"$dual_validation/formal/riscv-formal/\"\ndone\ncd \"$dual_validation\" || exit\ncat >> cores/bench/test/test_alu.py <<'\"'PY'\n\n\n@cocotb.test()\nasync def divide_width_boundary(dut):\n    await _setup_div(dut)\n    for denominator in (0xFE, 0xFF, 0x100, 0x101, 0x102, 0x80000000, 0xFFFFFFFF):\n        values = {0, denominator - 1, denominator, 0x7FFFFFFF, MASK32}\n        values.update(denominator * digit + offset\n                      for digit in range(1, 17)\n                      for offset in (-1, 0, 1)\n                      if denominator * digit + offset <= MASK32)\n        for numerator in sorted(values):\n            quotient, remainder = divmod(numerator, denominator)\n            await _check_div(dut, ALU_DIVU, numerator, denominator, quotient)\n            await _check_div(dut, ALU_REMU, numerator, denominator, remainder)\n    for denominator in (-257, -256, -255, 255, 256, 257):\n        for numerator in (-0x80000000, -0x76543210, -65537, -33, -1,\n                          0, 1, 33, 65537, 0x76543210, 0x7FFFFFFF):\n            quotient = abs(numerator) // abs(denominator)\n            if (numerator < 0) \"'!= (denominator < 0):\n                quotient = -quotient\n            await _check_div(dut, ALU_DIV, numerator, denominator, quotient)\n            await _check_div(dut, ALU_REM, numerator, denominator,\n                             numerator - quotient * denominator)\nPY\nprintf '\"'%s\\\\n' \\\"\"'$dual_validation\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
