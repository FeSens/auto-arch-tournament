{"type": "item.completed", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,155p' formal/riscv-formal/checks/rvfi_liveness_check.sv; sed -n '1,110p' formal/wrapper_si.sv; rg -n 'gap|liveness|progress|RESULT_CYCLE' cores/bench/test/test_alu.py formal/checks*.cfg\"", "aggregated_output": "// Copyright (C) 2017  Claire Xenia Wolf <claire@yosyshq.com>\n//\n// Permission to use, copy, modify, and/or distribute this software for any\n// purpose with or without fee is hereby granted, provided that the above\n// copyright notice and this permission notice appear in all copies.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\" AND THE AUTHOR DISCLAIMS ALL WARRANTIES\n// WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF\n// MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR\n// ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n// WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN\n// ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\nmodule rvfi_liveness_check (\n\tinput clock, reset, trig, check,\n\t`RVFI_INPUTS\n);\n\t`rvformal_rand_const_reg [63:0] insn_order;\n\treg found_next_insn = 0;\n\n\tinteger channel_idx;\n\talways @(posedge clock) begin\n\t\tif (reset) begin\n\t\t\tfound_next_insn = 0;\n\t\tend else begin\n\t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    inp\n…[1747 of 4819 chars elided by tools/bench/transcript.py; sha256:70292930a634fa28]…\n_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\nformal/checks_si.cfg:18:# liveness — CPU makes forward progress under any symbolic stream\nformal/checks_si.cfg:22:liveness   1 10 20\nformal/checks.cfg:18:# liveness — CPU makes forward progress under any symbolic stream\nformal/checks.cfg:22:liveness   1 10 20\nformal/checks-deep.cfg:18:# liveness — CPU makes forward progress under any symbolic stream\nformal/checks-deep.cfg:22:liveness   1 10 20\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"agent_message","text":"The scratch build confirmed that none of the 58,220 paired load responses in timed CoreMark needed an address correction. Gowin still scored the variant below the champion because execute forwarding became limiting. I’ll test an optimization for that path before settling on the final proposal."}}
{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c 'set -eu\ntrial_dir=\"$TMPDIR/r15s0-address-carry\"\nfor candidate in producer_eligibility alu_onehot alu_grouped divide_borrow; do\n  mkdir -p \"$trial_dir/$candidate\"\n  cp cores/bench/rtl/*.sv \"$trial_dir/$candidate/\"\ndone\npython - \"$trial_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\ntrial = Path(sys.argv[1])\n\ndef edit(directory, name, changes):\n    p=trial/directory/f\\\"{name}.sv\\\"\n    text=p.read_text()\n    for old,new in changes:\n        assert text.count(old)==1, (directory,name,old)\n        text=text.replace(old,new)\n    p.write_text(text)\n\nedit(\\\"producer_eligibility\\\",\\\"core_pkg\\\", [\n    (\\\"    logic        divide;\\\", \\\"    logic        divide;\\\\n    logic        early_write;\\\"),\n])\nedit(\\\"producer_eligibility\\\",\\\"id_stage\\\", [\n    (\\\"      reg_q.divide       <=\\\", \\\"\\\"\\\"      // A successful JALR flushes the sequential consumer. A trapping\n      // JALR has no destination value, so neither can use the EX bypass.\n      reg_q.early_write  <= dec_reg_write && \"'!dec_mem_read && !dec_is_jalr\n                         && (!dec_is_jump || !imm[1]);\n      reg_q.divide       <=\"\"\"),\n])\nedit(\"producer_eligibility\",\"ex_stage\", [\n    (\"assign write_eligible = ex_valid && ctrl_with_trap.reg_write && !in.ctrl.mem_read;\",\n     \"assign write_eligible = in.valid && in.early_write;\"),\n])\n\nfor candidate in (\"alu_onehot\",\"alu_grouped\"):\n    edit(candidate,\"core_pkg\", [\n        (\"  // ── Branch operations\", \"\"\"  typedef struct packed {\n    logic bit_and;\n    logic bit_or;\n    logic bit_xor;\n    logic slt;\n    logic sltu;\n    logic sll;\n    logic right_shift;\n    logic sign_shift;\n    logic lui;\n  } alu_select_t;\n\n  function automatic alu_select_t decode_alu_select(input logic [4:0] op);\n    alu_select_t sel;\n    sel.bit_and = op == ALU_AND;\n    sel.bit_or = op == ALU_OR;\n    sel.bit_xor = op == ALU_XOR;\n    sel.slt = op == ALU_SLT;\n    sel.sltu = op == ALU_SLTU;\n    sel.sll = op == ALU_SLL;\n    sel.right_shift = op == ALU_SRL || op == ALU_SRA;\n    sel.sign_shift = op == ALU_SRA;\n    sel.lui = op == ALU_LUI;\n    decode_alu_select = sel;\n  endfunction\n\n  // ── Branch operations\"\"\"),\n        (\"    ctrl_t       ctrl;'\"\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;\\\",\n         \\\"    alu_select_t alu_select;\\\\n    ctrl_t       ctrl;\\\\n    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;\\\"),\n    ])\n    edit(candidate,\\\"id_stage\\\", [\n        (\\\"      reg_q.ctrl         <= ctrl_decoded;\\\",\n         \\\"      reg_q.ctrl         <= ctrl_decoded;\\\\n      reg_q.alu_select   <= decode_alu_select(dec_alu_op);\\\"),\n    ])\n    edit(candidate,\\\"ex_stage\\\", [\n        (\\\"\\\"\\\"  logic [31:0] add_result, sub_result, other_result, unused_alu_result;\n  alu u_alu (\n    .op           (in.ctrl.alu_op),\n    .a            (rs1),\n    .b            (alu_b),\n    .out          (unused_alu_result),\n    .add_result   (add_result),\n    .sub_result   (sub_result),\n    .other_result (other_result)\n  );\\\"\\\"\\\",\n        \\\"\\\"\\\"  logic [31:0] add_result, sub_result, other_result;\n  logic [31:0] bitwise_word, shift_word, upper_word;\n  logic less;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [32:0] right_shifted;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign add_result = rs1 + alu_b;\n  assign sub_result = rs1 - alu_b;\n  assign right_shifted = \"'$signed({rs1[31] && in.alu_select.sign_shift, rs1}) >>> alu_b[4:0];\n  assign bitwise_word = ({32{in.alu_select.bit_and}} & (rs1 & alu_b))\n                      | ({32{in.alu_select.bit_or}}  & (rs1 | alu_b))\n                      | ({32{in.alu_select.bit_xor}} & (rs1 ''^ alu_b));\n  assign shift_word = ({32{in.alu_select.sll}} & (rs1 << alu_b[4:0]))\n                    | ({32{in.alu_select.right_shift}} & right_shifted[31:0]);\n  assign less = (in.alu_select.slt && ($signed(rs1) < $signed(alu_b)))\n             || (in.alu_select.sltu && (rs1 < alu_b));\n  assign upper_word = {32{in.alu_select.lui}} & alu_b;\n  assign other_result = bitwise_word | shift_word | upper_word | {31'\"'b0, less};\\\"\\\"\\\"),\n    ])\nedit(\\\"alu_grouped\\\",\\\"ex_stage\\\", [\n    (\\\"  logic less;\\\", \\\"  logic less;\\\\n  logic [3:0] alu_byte_less, alu_byte_eq;\\\"),\n    (\\\"\\\"\\\"  assign less = (in.alu_select.slt && (\"'$signed(rs1) < $signed(alu_b)))\n             || (in.alu_select.sltu && (rs1 < alu_b));\"\"\",\n     \"\"\"  for (genvar byte_idx = 0; byte_idx < 4; byte_idx++) begin : gen_alu_less\n    assign alu_byte_less[byte_idx] = rs1[byte_idx*8 +: 8] < alu_b[byte_idx*8 +: 8];\n    assign alu_byte_eq[byte_idx] = rs1[byte_idx*8 +: 8] == alu_b[byte_idx*8 +: 8];\n  end\n  logic alu_low_less;\n  assign alu_low_less = (alu_byte_eq[3] && alu_byte_less[2])\n                     || ((&alu_byte_eq[3:2]) && alu_byte_less[1])\n                     || ((&alu_byte_eq[3:1]) && alu_byte_less[0]);\n  assign less = ((in.alu_select.slt || in.alu_select.sltu) && alu_low_less)\n             || (in.alu_select.sltu && alu_byte_less[3])\n             || (in.alu_select.slt && (alu_byte_less[3] ''^ (rs1[31] != alu_b[31])));\"\"\"),\n])\n\nedit(\"divide_borrow\",\"div_unit\", [\n    (\"  logic [36:0] wide_diff [1:15];\", \"  logic [35:0] wide_diff [1:15];\"),\n    (\"\"\"    assign wide_diff[digit] = {1'\"'b0, wide_trial} - {1'b0, multiple_q[digit]};\n    assign wide_borrow[digit] = wide_diff[digit][36];\\\"\\\"\\\",\n     \\\"\\\"\\\"    logic [3:0] gen_borrow, pass_borrow;\n    logic [4:0] borrow;\n    assign borrow[0] = 1'b0;\n    for (genvar group = 0; group < 4; group++) begin : gen_chunk\n      logic [8:0] trial_chunk, threshold_chunk;\n      logic [9:0] diff_no_borrow;\n      assign trial_chunk = wide_trial[9*group +: 9];\n      assign threshold_chunk = multiple_q[digit][9*group +: 9];\n      assign diff_no_borrow = {1'b0, trial_chunk} - {1'b0, threshold_chunk};\n      assign gen_borrow[group] = diff_no_borrow[9];\n      assign pass_borrow[group] = trial_chunk == threshold_chunk;\n      assign wide_diff[digit][9*group +: 9] = diff_no_borrow[8:0] - {8'b0, borrow[group]};\n    end\n    assign borrow[1] = gen_borrow[0];\n    assign borrow[2] = gen_borrow[1] | (pass_borrow[1] & gen_borrow[0]);\n    assign borrow[3] = gen_borrow[2] | (pass_borrow[2] & gen_borrow[1])\n                     | ((&pass_borrow[2:1]) & gen_borrow[0]);\n    assign borrow[4] = gen_borrow[3] | (pass_borrow[3] & gen_borrow[2])\n                     | ((&pass_borrow[3:2]) & gen_borrow[1])\n                     | ((&pass_borrow[3:1]) & gen_borrow[0]);\n    assign wide_borrow[digit] = borrow[4];\\\"\\\"\\\"),\n])\nPY\nPYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport os\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build\ntrial = Path(os.environ[\\\"TMPDIR\\\"])/\\\"r15s0-address-carry\\\"\nnames = (\\\"producer_eligibility\\\",\\\"alu_onehot\\\",\\\"alu_grouped\\\",\\\"divide_borrow\\\")\ndef run(name):\n    r=build(Path.cwd(), trial/name, \\\"fpga/core_bench_si.sv\\\", 1, trial/f\\\"timing_{name}\\\"/\\\"gowin_p1\\\")\n    print(name,r,flush=True)\nwith ThreadPoolExecutor(max_workers=len(names)) as e:\n    list(e.map(run,names))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
