es],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n195:JOBS=\"${JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)}\"\n196:echo \"=== make -j$JOBS -k ===\" | tee -a \"$LOG\"\n202:make -j\"$JOBS\" -k -f makefile 2>&1 \\\n996K\tformal/riscv-formal/checks\n4.5M\tformal/riscv-formal/insns\n1.1G\tformal/riscv-formal/cores\n/srv/hwebench/venv/bin/pytest\n2.0.1\n","exit_code":0,"status":"completed"}}
