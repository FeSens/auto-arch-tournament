ex_load_word && instr[6:0] == 7'\"'h03 &&\n                        (instr[14:12] == 3'd0 || instr[14:12] == 3'd1 ||\n                         instr[14:12] == 3'd2 || instr[14:12] == 3'd4 ||\n                         instr[14:12] == 3'd5) && \"'!instr[31:22] && !(&instr[21:20]);\n  assign late_pair = late_branch || late_address;\n\n  // ── ID/EX register\"\"\"),\n    (\"      reg_q.rs1_sel       <= rs1_sel;\", \"\"\"      reg_q.rs1_sel       <= rs1_sel;\n      reg_q.late_branch   <= late_branch;\n      reg_q.late_address  <= late_address;\n      reg_q.late_rs2      <= rs2_addr == ex_rd;\"\"\"),\n])\nedit(\"hazard_unit.sv\", [\n    (\"  input  logic       repair,\", \"  input  logic       repair,'\"\\\\n  input  logic       late_pair,\\\"),\n    (\\\"assign load_use = id_ex_mem_read &&\\\", \\\"assign load_use = \"'!late_pair && id_ex_mem_read &&\"),\n])\nedit(\"core.sv\", [\n    (\"  logic       ex_write_eligible, mem_write_eligible;\", \"\"\"  logic       ex_write_eligible, mem_write_eligible;\n  logic       late_pair, load_can_forward;\n  logic [31:0] load_value;\"\"\"),\n    (\"    .in                 (if_id_w),\", \"\"\"    .in                 (if_id_w),\n    .ex_load            (id_ex_w.valid && id_ex_w.ctrl.mem_read),\n    .ex_load_word       (id_ex_w.ctrl.mem_width == 2'\"'d2),\n    .late_pair          (late_pair),\\\"\\\"\\\"),\n    (\\\"    .fwd_mem_wb      (mem_wb_w.write_data),\\\", \\\"\\\"\\\"    .fwd_mem_wb      (mem_wb_w.write_data),\n    .load_can_forward(load_can_forward),\n    .load_raw        (io_dmemRData),\n    .load_value      (load_value),\\\"\\\"\\\"),\n    (\\\"    .dmem_rdata     (io_dmemRData),\\\", \\\"\\\"\\\"    .dmem_rdata     (io_dmemRData),\n    .load_can_forward(load_can_forward),\n    .load_value     (load_value),\\\"\\\"\\\"),\n    (\\\"    .repair         (repair),\\\\n    .divide_wait\\\", \\\"\\\"\\\"    .repair         (repair),\n    .late_pair      (late_pair),\n    .divide_wait\\\"\\\"\\\"),\n])\nedit(\\\"mem_stage.sv\\\", [\