'b0;\n    else if (\"'!stall && !repair)\n      address_fix_pending <= ex_valid && use_load_response && response_low_sum[2];\n  end'\"'''),\n    ('      reg_q <= \\\\'0;\\\\n    end else if (\"'!stall && !repair) begin'\"', '''      reg_q <= '0;\n    end else if (address_fix_pending) begin\n      reg_q.mem_addr[31:2] <= reg_q.mem_addr[31:2] + 30'd1;\n    end else if (\"'!stall && !repair) begin'\"'''),\n])\nreplace('hazard_unit.sv', [\n    ('  input  logic       dmem_ready,', '  input  logic       dmem_ready,\\\\n  input  logic       address_fix_pending,'),\n    ('  assign stall_ex_mem = ex_mem_mem_op && \"'!dmem_ready;'\"', '  assign stall_ex_mem = address_fix_pending || (ex_mem_mem_op && \"'!dmem_ready);'\"'),\n])\nreplace('mem_stage.sv', [\n    ('  input  logic               hold_wb,', '  input  logic               hold_wb,\\\\n  input  logic               address_fix_pending,'),\n    ('    dmem_ren   = in.ctrl.mem_read  && \"'!mem_misalign;'\"', '    dmem_ren   = in.ctrl.mem_read  && \"'!mem_misalign && !address_fix_pending;'\"'),\n])\nreplace('core.sv', [\n    ('  logic       divide_wait, load_use;', '  logic       divide_wait, load_use, address_fix_pending;'),\n    ('    .divide_wait     (divide_wait),', '    .divide_wait     (divide_wait),\\\\n    .address_fix_pending (address_fix_pending),'),\n    ('    .hold_wb        (hold_mem_wb),', '    .hold_wb        (hold_mem_wb),\\\\n    .address_fix_pending (address_fix_pending),'),\n    ('    .dmem_ready     (io_dmemReady),', '    .dmem_ready     (io_dmemReady),\\\\n    .address_fix_pending (address_fix_pending),'),\n])\nPY\nprintf '%s\\\\n' \\\"\"'$task_scratch\"\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
