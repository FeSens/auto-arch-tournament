{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json, shutil\nfrom tools.eval.gowin import build\n\nwt = Path.cwd()\nbase = wt / 'cores/bench/rtl'\nroot = Path('/srv/hwebench/tmp/5a1ea1b1/226d8738/bench-r14s0-_uwsxihw')\nfor mode in ('raw-disp', 'normalized', 'normalized-raw-disp'):\n    dst = root / mode\n    shutil.copytree(base, dst)\n    ids = dst / 'id_stage.sv'\n    idstr = ids.read_text()\n    if 'raw-disp' in mode:\n        old = \\\"\\\"\\\"      reg_q.direct_target_differs <= (dec_is_branch || (dec_is_jump && \"'!dec_is_jalr))\n                                  && imm != 32'\"'d4;\\\"\\\"\\\"\n        new = \\\"\\\"\\\"      reg_q.direct_target_differs <= (dec_is_branch &&\n                                      {instr[31], instr[7], instr[30:25], instr[11:8]} \"'!= 12'\"'d2)\n                                  || (dec_is_jump && \"'!dec_is_jalr &&\n                                      {instr[31], instr[19:12], instr[20], instr[30:21]} != 20'\"'d2);\\\"\\\"\\\"\n        assert old in idstr\n        idstr = idstr.replace(old, new)\n    if 'normalized' in mode:\n        idstr = idstr.replace(\\\"assign instr = in.synthetic ? 32'b0 : in.instr;\\\", 'assign instr = in.instr;')\n        idstr = idstr.replace('in.valid && \"'!in.synthetic && (|response_match)'\"', 'in.valid && (|response_match)')\n        pkg = dst / 'core_pkg.sv'\n        pkg.write_text(pkg.read_text().replace('    logic        synthetic;\\\\n',''))\n        fs = dst / 'if_stage.sv'\n        ls = fs.read_text()\n        for line in ('  logic [3:0] synthetic_q;', '  logic issue_synthetic_q;',\n                     '      synthetic_q[write_slot] <= \"'!in_window;'\"', '  assign out.synthetic = issue_synthetic_q;',\n                     '      issue_synthetic_q <= (use_response && \"'!in_window)'\"',\n                     '                        || (use_queued_bus && synthetic_q[next_head]);'):\n            assert line in ls\n            ls = ls.replace(line + '\\\\n','')\n        ls = ls.replace('  assign bus_pair = decode_pair(imem_data[31:20], imem_data[14:12], imem_data[6:0]);', '''  logic [33:0] accepted_bus_word;\n  assign bus_pair = decode_pair(imem_data[31:20], imem_data[14:12], imem_data[6:0]);\n  assign accepted_bus_word = {34{in_window}} & {bus_pair, imem_data};''')\n        ls = ls.replace('bus_words[write_slot] <= {bus_pair, imem_data};','bus_words[write_slot] <= accepted_bus_word;')\n        ls = ls.replace('issue_synthetic_q ? \\\\'0 : issue_pair_q', 'issue_pair_q')\n        ls = ls.replace('({34{use_response}} & {bus_pair, imem_data})','({34{use_response}} & accepted_bus_word)')\n        fs.write_text(ls)\n    ids.write_text(idstr)\n\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futs = {pool.submit(build, wt, root / mode, 'fpga/core_bench_si.sv', 1, root / f'{mode}_p1'):mode\n            for mode in ('raw-disp', 'normalized', 'normalized-raw-disp')}\n    for f in as_completed(futs):\n        r = f.result()\n        print(futs[f], json.dumps(r), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
