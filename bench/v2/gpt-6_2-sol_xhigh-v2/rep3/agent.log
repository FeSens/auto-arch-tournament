{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, os\n\nstudy = Path(os.environ['TMPDIR'])/'r7s0-study'\nrtl = study/'preselect'\nshutil.copytree('cores/bench/rtl', rtl, dirs_exist_ok=True)\n\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nupdate('core_pkg.sv', [\n    ('    logic        reg_file;\\\\n', ''),\n    ('    logic        alu_b_imm;\\\\n', '    logic [31:0] alu_b_val;\\\\n'),\n])\nupdate('id_stage.sv', [\n    ('  assign rs1_sel.reg_file = \"'!(ex_hit[0] || mem_hit[0]);'\"\\\\n',''),\n    ('  assign rs2_sel.reg_file = \"'!(ex_hit[1] || mem_hit[1]);'\"\\\\n',''),\n    ('      reg_q.alu_b_imm    <= dec_alu_src;\\\\n',''),\n    ('      reg_q.rs1_val      <= rs1_data;\\\\n      reg_q.rs2_val      <= rs2_data;',\n     '''      reg_q.rs1_val      <= (ex_hit[0] || mem_hit[0]) ? 32'b0 : rs1_data;\n      reg_q.rs2_val      <= (ex_hit[1] || mem_hit[1]) ? 32'b0 : rs2_data;\n      reg_q.alu_b_val    <= ({32{\"'!dec_alu_src && !(ex_hit[1] || mem_hit[1])}} & rs2_data)\n                         | ({32{dec_alu_src}} & imm);'\"'''),\n])\nupdate('ex_stage.sv', [\n    ('                    | ({32{sel.reg_file}}       & reg_value);','                    | reg_value;'),\n    ('  assign alu_b = forward_operand(in.alu_b_sel, in.rs2_val)\\\\n               | ({32{in.alu_b_imm}} & in.imm);',\n     '  assign alu_b = forward_operand(in.alu_b_sel, in.alu_b_val);'),\n])\nPY\npython - <<'PY'\nfrom pathlib import Path\nfrom tools.eval import gowin\nimport os\np = Path(os.environ['TMPDIR'])/'r7s0-study'\nr = gowin.build_all(Path('.'), p/'preselect', 'fpga/core_bench_si.sv', p/'preselect-synth')\nfor item in r:\n    print(item)\nprint(gowin.summarize(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
