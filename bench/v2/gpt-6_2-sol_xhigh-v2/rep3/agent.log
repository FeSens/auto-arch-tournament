{"type": "item.started", "item": {"id": "item_53", "type": "command_execution", "command": "/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/load_predicate.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nroot=Path(sys.argv[1])\nbase=Path('cores/bench/rtl')\ntarget=root/'load_predicate'/'rtl'\ncopytree(base,target,dirs_exist_ok=True)\nfor f in ('core','core_pkg','id_stage','ex_stage','mem_stage','hazard_unit'):\n    p=target/(f+'.sv')\n    s=p.read_text()\n    if f=='core_pkg':\n        s=s.replace('    branch_sel_t branch_sel;', '''    branch_sel_t branch_sel;\n    logic branch_load_rs1, branch_load_rs2;''')\n    elif f=='core':\n        s=s.replace('  // EX direct fetch', '''  logic branch_load_rs1_w, branch_load_rs2_w;\n  logic [31:0] mem_load_data_w;\n  logic mem_load_zero_w;\n\n  assign branch_load_rs1_w = id_ex_w.valid && id_ex_w.ctrl.mem_read\n                             && (id_ex_w.rd \"'!= 5'\"'d0) && (id_ex_w.rd == if_id_w.instr[19:15])\n                             && (if_id_w.instr[24:20] == 5'd0)\n                             && (if_id_w.instr[6:0] == 7'h63);\n  assign branch_load_rs2_w = id_ex_w.valid && id_ex_w.ctrl.mem_read\n                             && (id_ex_w.rd \"'!= 5'\"'d0) && (id_ex_w.rd == if_id_w.instr[24:20])\n                             && (if_id_w.instr[19:15] == 5'd0)\n                             && (if_id_w.instr[6:0] == 7'h63);\n\n  // EX direct fetch''')\n        s=s.replace('    .in                 (if_id_w),','''    .in                 (if_id_w),\n    .branch_load_rs1    (branch_load_rs1_w),\n    .branch_load_rs2    (branch_load_rs2_w),''')\n        s=s.replace('    .fwd_mem_wb      (mem_wb_w.write_data),','''    .fwd_mem_wb      (mem_wb_w.write_data),\n    .mem_load_valid  (io_dmemREn),\n    .mem_load_data   (mem_load_data_w),\n    .mem_load_zero   (mem_load_zero_w),''')\n        s=s.replace('    .dmem_ren      (io_dmemREn),','''    .dmem_ren      (io_dmemREn),\n    .load_data     (mem_load_data_w),\n    .load_zero     (mem_load_zero_w),''')\n        s=s.replace('    .id_ex_mem_read (id_ex_w.valid && id_ex_w.ctrl.mem_read),','''    .id_ex_mem_read (id_ex_w.valid && id_ex_w.ctrl.mem_read\n                    && \"'!(branch_load_rs1_w || branch_load_rs2_w)),'\"''')\n    elif f=='id_stage':\n        s=s.replace('  input  if_id_t  in,','''  input  if_id_t  in,\n  input  logic        branch_load_rs1,\n  input  logic        branch_load_rs2,''')\n        s=s.replace('      reg_q.branch_sel   <= branch_sel;', '''      reg_q.branch_sel   <= branch_sel;\n      reg_q.branch_load_rs1 <= branch_load_rs1;\n      reg_q.branch_load_rs2 <= branch_load_rs2;''')\n    elif f=='ex_stage':\n        s=s.replace('  output ex_mem_t  out,','''  input  logic        mem_load_valid,\n  input  logic [31:0] mem_load_data,\n  input  logic        mem_load_zero,\n  output ex_mem_t  out,''')\n        s=s.replace('  logic        branch_taken;', '''  logic        branch_taken, ordinary_taken, load_taken;\n  logic        load_compare, load_less;\n  logic        load_negative;\n  assign load_compare = mem_load_valid && (in.branch_load_rs1 || in.branch_load_rs2);\n  assign load_negative = in.branch_sel.signed_compare && mem_load_data[31];\n  assign load_less = in.branch_load_rs1 ? load_negative : (\"'!mem_load_zero && !load_negative);\n  assign load_taken = (in.branch_sel.eq && mem_load_zero)\n                    || (in.branch_sel.ne && !mem_load_zero)\n                    || (in.branch_sel.lt && load_less)\n                    || (in.branch_sel.ge && !load_less);\n  assign branch_taken = load_compare ? load_taken : ordinary_taken;'\"''')\n        s=s.replace('  assign branch_taken = (in.branch_sel.eq', '  assign ordinary_taken = (in.branch_sel.eq')\n        s=s.replace('assign direct_redirect = in.valid && direct_taken && \"'!in.imm[1];'\"',\n                    'assign direct_redirect = in.valid && direct_taken && \"'!in.imm[1] && !(load_compare && stall);'\"')\n        for i,ch in ((1,'a'),(2,'b')):\n            s=s.replace(f'divide ? div_src_{ch} : rs{i};', f'divide ? div_src_{ch} : (load_compare && in.branch_load_rs{i}) ? mem_load_data : rs{i};')\n    elif f=='mem_stage':\n        s=s.replace('  output logic               write_eligible,','''  output logic               write_eligible,\n  output logic [31:0]        load_data,\n  output logic               load_zero,''')\n        s=s.replace('  logic [31:0] load_data;','''  logic [3:0] byte_zero;\n  for (genvar b = 0; b < 4; b++) begin : gen_zero\n    assign byte_zero[b] = \"'!(|dmem_rdata[b*8 +: 8]);\n  end\n  assign load_zero = &(byte_zero | ~byte_mask);'\"''')\n    p.write_text(s)\nPY\npython \\\"\"'$probe/load_predicate.py\" \"$probe\"\nPYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/load_predicate\" > \"$probe/load_predicate/out.log\" 2>&1\ncat \"$probe/load_predicate/out.log\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
