{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-predictor.HSKuJwMl/time_variants.py\" <<'\"'PY'\nimport json, os, sys\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nroot=Path.cwd()\nstudy = Path(os.environ[\\\"TMPDIR\\\"])/\\\"bench-predictor.HSKuJwMl\\\"\n\ndef run(v, option):\n p = study/v\n res = build(root, p/\\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", option, p/\\\"gowin\\\"/f\\\"gowin_p{option}\\\")\n print(v, option, json.dumps({k:res.get(k) for k in ('fmax_mhz','logic','regs','reason')}), res.get(\\\"critical_paths\\\", [None])[0], flush=True)\n\nwith ThreadPoolExecutor(max_workers=6) as ex:\n futures=[]\n for variant in sys.argv[2:]:\n  for option in (int(i) for i in sys.argv[1].split(',')):\n   futures.append(ex.submit(run,variant,option))\n for f in as_completed(futures):\n  f.result()\nPY\nPYTHONPATH=. python3 \\\"\"'$TMPDIR/bench-predictor.HSKuJwMl/time_variants.py\" 1 pin4reg pin8reg frame short2 both64'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
