{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c 'ls -ld \"$TMPDIR\"/bench-r8-probe.n03SbQ .bench-r8-timing.iMp9iX 2>/dev/null\nsed -n '\"'1,122p' cores/bench/test/test_alu.py\nsed -n '250,325p' cores/bench/test/test_alu.py\ngit status --short\"", "aggregated_output": "drwx------+ 4 hwebench2 hwebench2 4096 Nov 21 01:12 /srv/hwebench/tmp/5a1ea1b1/e339a989/bench-r8-probe.n03SbQ\n\"\"\"Exact bit results for the combinational ALU and clocked divider.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n    `await _setup(dut)` for parity with other test files.\"\"\"\n    return\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)              # -1 < 0\n    await _check(dut, ALU_SLT, 1, 0, 0)\n    await _check(dut, ALU_SLT, 0x7FFFFFFF, 0x80000000, 0)     # MAX > MIN\n\n\n@cocotb.test()\nasync def sltu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n    await _check(dut, ALU_SLTU, 0, \n…[1258 of 4330 chars elided by tools/bench/transcript.py; sha256:04f91072237393ae]…\n(1, 33)) or 1\n        q, r = divmod(a, b)\n        await _check_div(dut, ALU_DIVU, a, b, q)\n        await _check_div(dut, ALU_REMU, a, b, r)\n\n        signed_a = a if a < 0x80000000 else a - (1 << 32)\n        signed_b = (b & 0x7FFFFFFF) or 1\n        if rng.getrandbits(1):\n            signed_b = -signed_b\n        q = abs(signed_a) // abs(signed_b)\n        if (signed_a < 0) != (signed_b < 0):\n            q = -q\n        await _check_div(dut, ALU_DIV, signed_a, signed_b, q)\n        await _check_div(dut, ALU_REM, signed_a, signed_b, signed_a - q * signed_b)\n\n\ndef test_alu_runner(monkeypatch):\n    monkeypatch.setenv(\"COCOTB_TEST_FILTER\", r\"^test_alu\\.(?!divide_)\")\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n\n\ndef test_div_unit_runner(monkeypatch):\n    monkeypatch.setenv(\"COCOTB_TEST_FILTER\", r\"^test_alu\\.divide_\")\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/design.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nbase = Path('cores/bench/rtl')\nroot = Path(sys.argv[1])\n\ndef variant(name, style, widths):\n    output = root / name / 'rtl'\n    copytree(base, output, dirs_exist_ok=True)\n    source = (base / 'div_unit.sv').read_text()\n    source = source.replace('logic remainder_op_q, negate_q, divide_by_zero_q;', 'logic remainder_op_q, negate_q, divide_by_zero_q, a_negative_q;')\n    source = source.replace('logic [31:0] dividend_abs_q, divisor_abs_q;', '''logic [31:0] dividend_abs_q, divisor_abs_q, setup_dividend_magnitude;\n  assign setup_dividend_magnitude = conditional_negate(src_a, a_negative_q);''')\n    source = source.replace('dividend_abs_q <= conditional_negate(a, a_negative);', 'a_negative_q <= a_negative;')\n    source = source.replace('wide_q <= wide_divisor;', 'dividend_abs_q <= setup_dividend_magnitude;\\\\n      wide_q <= wide_divisor;')\n    source = source.replace('dividend_abs_q[31:24]', 'setup_dividend_magnitude[31:24]').replace('dividend_abs_q[23:0]', 'setup_dividend_magnitude[23:0]')\n    start = source.index('  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [36:0] wide_diff')\n    end = source.index('  always_ff @(posedge clock) begin\\\\n    if (issue && issue_ready)', start)\n    code = ['''  logic [31:0] wide_diff [0:15];\n  logic [15:0] wide_borrow;\n  logic [31:0] wide_remainder_next;\n  logic [3:0] wide_digit;\n\n  assign wide_trial = {wide_remainder_q, wide_dividend_quotient_q[23:20]};\n  assign wide_borrow[0] = 1'b0;\n  assign wide_diff[0] = wide_trial[31:0];\n  for (genvar digit = 1; digit < 16; digit++) begin : gen_wide_diff''']\n    lo = 0\n    num = len(widths)\n    for block, width in enumerate(widths):\n        hi = lo + width - 1\n        code.append(f'''    wire [{width-1}:0] a{block} = wide_trial[{hi}:{lo}];\n    wire [{width-1}:0] b{block} = multiple_q[digit][{hi}:{lo}];\n    wire g{block} = a{block} < b{block};''')\n        if block:\n            code.append(f'    wire p{block} = a{block} == b{block};')\n        terms = []\n        for gen in range(block, -1, -1):\n            factors = [f'p{prop}' for prop in range(block, gen, -1)] + [f'g{gen}']\n            terms.append('(' + ' && '.join(factors) + ')' if len(factors) > 1 else factors[0])\n        cout = f'borrow{block}' if block \"'!= num-1 else '\"'wide_borrow[digit]'\n        prefix = 'wire ' if block \"'!= num-1 else '\"'assign '\n        code.append(f'    {prefix}{cout} = ' + ' || '.join(terms) + ';')\n        if style == 'block':\n            if block == 0:\n                code.append(f'    assign wide_diff[digit][{hi}:{lo}] = a{block} - b{block};')\n            else:\n                out_width = min(32 - lo, width)\n                if out_width > 0:\n                    code.append(f'''    wire [{out_width}:0] local_sum{block} =\n        {{a{block}[{out_width-1}:0], \"'!borrow{block-1}}} + {{~b{block}[{out_width-1}:0], 1'\"'b1}};\n    assign wide_diff[digit][{lo + out_width - 1}:{lo}] = local_sum{block}[{out_width}:1];''')\n        lo += width\n    if style == 'carry':\n        code.append('    assign wide_diff[digit] = wide_trial[31:0] - multiple_q[digit][31:0];')\n    code.append('''  end\n\n  wire [3:0] group_sel = { \"'!wide_borrow[12], !wide_borrow[8] && wide_borrow[12],\n                           !wide_borrow[4] && wide_borrow[8], wide_borrow[4] };\n  logic [31:0] group_rem [0:3];\n  logic [1:0] group_digit [0:3];\n  for (genvar group = 0; group < 4; group++) begin : gen_wide_group\n    localparam int BASE = group * 4;\n    wire [3:0] sel = { !wide_borrow[BASE+3],\n                       !wide_borrow[BASE+2] && wide_borrow[BASE+3],\n                       !wide_borrow[BASE+1] && wide_borrow[BASE+2],\n                       wide_borrow[BASE+1] };\n    for (genvar bit_idx = 0; bit_idx < 32; bit_idx++) begin : gen_wide_rem\n      assign group_rem[group][bit_idx] =\n          (wide_diff[BASE  ][bit_idx] & sel[0])\n        | (wide_diff[BASE+1][bit_idx] & sel[1])\n        | (wide_diff[BASE+2][bit_idx] & sel[2])\n        | (wide_diff[BASE+3][bit_idx] & sel[3]);\n    end\n    assign group_digit[group] = {|(sel & 4'\"'b1100), |(sel & 4'b1010)};\n  end\n  for (genvar bit_idx = 0; bit_idx < 32; bit_idx++) begin : gen_wide_remainder\n    assign wide_remainder_next[bit_idx] =\n        (group_rem[0][bit_idx] & group_sel[0])\n      | (group_rem[1][bit_idx] & group_sel[1])\n      | (group_rem[2][bit_idx] & group_sel[2])\n      | (group_rem[3][bit_idx] & group_sel[3]);\n  end\n  assign wide_digit[1:0] =\n      ({2{group_sel[0]}} & group_digit[0])\n    | ({2{group_sel[1]}} & group_digit[1])\n    | ({2{group_sel[2]}} & group_digit[2])\n    | ({2{group_sel[3]}} & group_digit[3]);\n  assign wide_digit[2] = |(group_sel & 4'b1010);\n  assign wide_digit[3] = |(group_sel & 4'b1100);\n\n''')\n    source = source[:start] + '\\\\n'.join(code) + source[end:]\n    (output / 'div_unit.sv').write_text(source)\n\nvariant('split_blocks', 'block', (12, 12, 12))\nvariant('split_compare', 'carry', (12, 12, 12))\nPY\npython \\\"\"'$probe/design.py\" \"$probe\"\ncat > \"$probe/measure.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path.cwd()\nprobe = Path(sys.argv[1])\nout = build_all(root, probe / 'rtl', 'fpga/core_bench_si.sv', probe / 'timing')\nfor x in out:\n    print(x.get('place_option'), x.get('fmax_mhz'), x.get('logic'), x.get('reason'), flush=True)\n    for path in x.get('critical_paths', [])[:3]:\n        print(path, flush=True)\nif all(not x['placement_failed'] for x in out): print('Median:', summarize(out)['fmax_mhz'], flush=True)\nPY\nPYTHONPATH=\\\"\"'$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/split_blocks\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
