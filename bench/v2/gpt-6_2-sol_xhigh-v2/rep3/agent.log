{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/merge.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\nroot=Path(sys.argv[1])\nbase=Path('cores/bench/rtl')\ndef variant(name, combined_adder, predecode):\n    origin=base if not predecode else root/'predecode8/rtl'\n    dest=root/name/'rtl'\n    copytree(origin,dest,dirs_exist_ok=True)\n    for f in ('core_pkg','id_stage','ex_stage','mem_stage'):\n        p=dest/(f+'.sv')\n        s=p.read_text()\n        if f=='core_pkg':\n            s=s.replace('    logic sub;\\\\n','').replace('    logic [31:0] sub;\\\\n','')\n        if f=='id_stage':\n            s=s.replace('ALU_SUB:                      result_sel.sub      = 1\\\\'b1;', 'ALU_SUB:                      result_sel.add      = 1\\\\'b1;')\n        if f=='ex_stage':\n            s=s.replace('''    add_sub  = ({32{sel.ex_mem.add}}      & reg_q.result.add)\n             | ({32{sel.ex_mem.sub}}      & reg_q.result.sub);''','''    add_sub  = ({32{sel.ex_mem.add}}      & reg_q.result.add);''')\n            if combined_adder:\n                if predecode:\n                    s=s.replace('  logic [31:0] add_result, sub_result;', '  logic [31:0] add_result;')\n                    s=s.replace('  assign add_result = rs1 + alu_b;\\\\n  assign sub_result = rs1 - alu_b;', '')\n                else:\n                    s=s.replace('  logic [31:0] add_result, sub_result, other_result, unused_alu_result;', '  logic [31:0] add_result, unused_add, unused_sub, other_result, unused_alu_result;')\n                    s=s.replace('.add_result   (add_result)', '.add_result   (unused_add)').replace('.sub_result   (sub_result)', '.sub_result   (unused_sub)')\n                s=s.replace('  logic [63:0] product;','''  logic is_sub;\n  logic [31:0] add_operand_b;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [32:0] sum;\n  /* verilator lint_on UNUS