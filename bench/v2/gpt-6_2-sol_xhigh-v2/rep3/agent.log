{"type": "item.completed", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,175p' cores/bench/rtl/replay_train.sv; git diff --stat; rg -n 'train_fallthrough|target_pc' cores/bench/rtl/core.sv cores/bench/rtl/ex_stage.sv\"", "aggregated_output": "// Learn a target prefix from the ordered EX/MEM-to-WB stream. A slot is\n// trained only after it survives stalls and any older repair.\nmodule replay_train (\n  input  logic           clock,\n  input  logic           reset,\n  input  logic           fence_i,\n  input  logic           advance,\n  input  logic [31:0]    pc,\n  input  logic [31:0]    target_pc,\n  input  logic [31:0]    instr,\n  input  logic           direct,\n  input  logic           taken,\n  output replay_update_t update\n);\n\n  logic collecting_q;\n  logic [19:2] source_pc_q, target_q;\n  logic [31:0] source_instr_q;\n  logic [19:2] expected_q, next_pc, resume;\n  logic [3:0] last_q, next_last;\n  logic [127:0] words_q, collected_words;\n  logic word_in_window, terminates, fits_prefix, collect_word, start_prefix, finish_prefix;\n  logic not_taken;\n\n  assign word_in_window = pc[31:20] == 12'b0 && pc[1:0] == 2'b0;\n  assign not_taken = advance && direct && !taken && word_in_window;\n  assign start_prefix = advance && direct && taken && word_in_window\n                      && target_pc[31:20] == 12'b0 && target_pc[1:0] == 2'b0;\n\n  always_comb begin\n    case (instr[6:0])\n      // EX/MEM selects its registered PC+4 for a legal B that resolves not taken.\n      7'h63: terminates = !direct || taken;\n      7'h6f, 7'h67, 7'h73, 7'h0f: terminates = 1'b1;\n      default: terminates = 1'b0;\n    endcase\n  end\n\n  // The final word of imem has no in-window resume address.\n  assign fits_prefix = word_in_window && !terminates && pc[19:2] == expected_q && !(&expected_q);\n  assign collect_word = advance && collecting_q && fits_prefix;\n  assign finish_prefix = advance && collecting_q && (!fits_prefix || last_q[2]);\n  assign next_pc = expected_q + 18'd1;\n  assign resume = collect_word ? next_pc : expected_q;\n  assign next_last = (last_q == 4'b0000) ? 4'b0001 : {last_q[2:0], 1'b0};\n\n  always_comb begin\n    collected_words = words_q;\n    for (int lane = 0; lane < 4; lane++) begin\n      if (collect_word && next_last[lane]) collected_words[32*lane +: 32] = instr;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) collecting_q <= 1'b0;\n    else if (start_prefix || finish_prefix) collecting_q <= start_prefix;\n\n    if (start_prefix) begin\n      source_pc_q <= pc[19:2];\n      source_instr_q <= instr;\n      target_q <= target_pc[19:2];\n      expected_q <= target_pc[19:2];\n      last_q <= '0;\n    end else if (collect_word) begin\n      expected_q <= next_pc;\n      last_q <= next_last;\n    end\n    words_q <= collected_words;\n  end\n\n  // When a not-taken branch ends a prefix, queue its counter update behind\n  // the install. It cannot also start a prefix, so the pending event drains\n  // before another prefix can finish.\n  logic deferred_valid_q;\n  logic [19:2] deferred_pc_q;\n  logic [31:0] deferred_instr_q;\n  replay_update_t update_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || fence_i) begin\n      deferred_valid_q <= 1'b0;\n      update_q.valid <= 1'b0;\n    end else begin\n      deferred_valid_q <= not_taken && (finish_prefix || deferred_valid_q);\n      update_q.valid <= finish_prefix || deferred_valid_q || not_taken;\n    end\n\n    // The payload is only consumed when its corresponding valid bit is set.\n    deferred_pc_q <= pc[19:2];\n    deferred_instr_q <= instr;\n\n    update_q.taken <= finish_prefix;\n    update_q.source_pc <= finish_prefix ? source_pc_q : deferred_valid_q ? deferred_pc_q : pc[19:2];\n    update_q.source_instr <= finish_prefix ? source_instr_q : deferred_valid_q ? deferred_instr_q : instr;\n    update_q.last <= finish_prefix ? (collect_word ? next_last : last_q) : '0;\n    update_q.target <= target_q;\n    update_q.resume <= resume;\n    update_q.words <= collected_words;\n  end\n\n  assign update = update_q;\n\nendmodule\n cores/bench/rtl/core.sv           |  2 +-\n cores/bench/rtl/if_stage.sv       | 34 +++++++++++----\n cores/bench/rtl/replay_train.sv   | 46 ++++++++++----------\n cores/bench/test/test_pipeline.py | 92 +++++++++++++++++++++++++++++++++++++--\n 4 files changed, 139 insertions(+), 35 deletions(-)\ncores/bench/rtl/core.sv:167:    .target_pc (train_target),\n", "exit_code": 0, "status": "completed"}}
