,\n('  logic tail_in_entry;\\\\n',''),\n('slot_valid_q <= head && tail_in_entry;','slot_valid_q <= head;'),\n])\n\npath=rtl/'branch_target_replay.sv'\npath.write_text('''module branch_target_replay (\n  input  logic        clock, reset, hold_state,\n  input  logic        direct_redirect, fence_i,\n  input  replay_key_t key,\n  input  ex_mem_t     ex_mem,\n  output logic        hit,\n  output logic [31:0] first_word, second_word\n);\n  logic [63:0] valid_q;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [32:0] tag_ram [0:63];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] first_ram [0:63];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] second_ram [0:63];\n  logic [5:0] index;\n  logic [32:0] tag;\n  assign index = key.pc[7:2];\n  assign tag = {key.pc[19:8], key.displacement, key.jal};\n  assign first_word = first_ram[index];\n  assign second_word = second_ram[index];\n  assign hit = \"'!(|key.pc[31:20]) && valid_q[index] && tag_ram[index] == tag;\n\n  // Keep the source signature with its advancing EX instruction.\n  logic seen_direct_q;\n  logic [5:0] source_index_q;\n  logic [32:0] source_tag_q;\n  always_ff @(posedge clock) begin\n    if (reset) seen_direct_q <= 0;\n    else if (!hold_state) begin\n      seen_direct_q <= direct_redirect && !(|key.pc[31:20]);\n      source_index_q <= index;\n      source_tag_q <= tag;\n    end\n  end\n\n  // Advance the two-event history only for surviving pipeline advances.\n  // The first survivor following a taken direct transfer is its target.\n  // Publish the packet once another survivor proves a sequential pair.\n  logic prev_direct_q, prev_prev_direct_q, prev_valid_q, redirected_word_ok;\n  logic [5:0] prev_index_q, prev_prev_index_q;\n  logic [32:0] prev_tag_q, prev_prev_tag_q;\n  logic [31:2] prev_next_q;\n  logic [31:0] prev_word_q;\n  assign redirected_word_ok = !(|ex_mem.pc[31:20]);\n\n  logic pending_valid_q;\n  logic [5:0] pending_index_q;\n  logic [32:0] pending_tag_q;\n  logic [31:0] pending_first_q, pending_second_q;\n  logic clear;\n  assign clear = reset || (!hold_state && fence_i);\n  always_ff @(posedge clock) begin\n    if (clear) begin\n      prev_valid_q <= 0;\n      prev_direct_q <= 0;\n      prev_prev_direct_q <= 0;\n      pending_valid_q <= 0;\n    end else begin\n      pending_valid_q <= 0;\n      if (!hold_state && ex_mem.valid) begin\n        prev_valid_q <= redirected_word_ok;\n        prev_direct_q <= seen_direct_q;\n        prev_prev_direct_q <= prev_direct_q;\n\n        prev_index_q <= source_index_q;\n        prev_prev_index_q <= prev_index_q;\n        prev_tag_q <= source_tag_q;\n        prev_prev_tag_q <= prev_tag_q;\n        prev_next_q <= ex_mem.pc[31:2] + 30'\"'d1;\n        prev_word_q <= ex_mem.instr;\n\n        pending_valid_q <= prev_prev_direct_q && prev_valid_q\n                        && redirected_word_ok && ex_mem.pc[31:2] == prev_next_q;\n        pending_index_q <= prev_prev_index_q;\n        pending_tag_q <= prev_prev_tag_q;\n        pending_first_q <= prev_word_q;\n        pending_second_q <= ex_mem.instr;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (clear) valid_q <= '0;\n    else if (pending_valid_q) valid_q[pending_index_q] <= 1'b1;\n    if (pending_valid_q && \"'!clear) begin\n      tag_ram[pending_index_q] <= pending_tag_q;\n      first_ram[pending_index_q] <= pending_first_q;\n      second_ram[pending_index_q] <= pending_second_q;\n    end\n  end\nendmodule\n'\"''')\nPY\npython '/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/pipeline_train.py' '/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/piped'\nverilator --cc --exe --build -j 4 -Mdir '/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/obj4' '+incdir+/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/piped' --top-module core -Wno-fatal -CFLAGS '-DNRET=1' '/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/piped/core_pkg.sv' '/srv/hwebench/tmp/