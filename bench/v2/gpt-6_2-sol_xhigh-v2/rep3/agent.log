{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/r7s0-study\"\npython - <<'\"'PY'\nfrom pathlib import Path\nimport shutil, os\n\nrtl = Path(os.environ['TMPDIR'])/'r7s0-study'/'shift'\nshutil.copytree('cores/bench/rtl', rtl, dirs_exist_ok=True)\n\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nupdate('core_pkg.sv', [\n    ('    logic sub;\\\\n', '    logic sub;\\\\n    logic shift;\\\\n'),\n    ('    logic [31:0] sub;\\\\n', '    logic [31:0] sub;\\\\n    logic [31:0] shift;\\\\n'),\n    ('    logic        alu_b_imm;\\\\n', '    logic        alu_b_imm;\\\\n    logic        shift_left;\\\\n    logic        shift_right;\\\\n    logic        shift_arithmetic;\\\\n'),\n])\nupdate('id_stage.sv', [\n    (\\\"          ALU_SUB:                      result_sel.sub      = 1'b1;\\\", \\\"          ALU_SUB:                      result_sel.sub      = 1'b1;\\\\n          ALU_SLL, ALU_SRL, ALU_SRA:    result_sel.shift    = 1'b1;\\\"),\n    ('      reg_q.alu_b_imm    <= dec_alu_src;', '      reg_q.alu_b_imm    <= dec_alu_src;\\\\n      reg_q.shift_left   <= dec_alu_op == ALU_SLL;\\\\n      reg_q.shift_right  <= dec_alu_op == ALU_SRL || dec_alu_op == ALU_SRA;\\\\n      reg_q.shift_arithmetic <= dec_alu_op == ALU_SRA;'),\n])\nupdate('alu.sv', [\n    ('module alu (', \\\"module alu #(parameter logic EXTERNAL_SHIFT = 1'b0) (\\\"),\n    ('other_result = a << shamt;', \\\"other_result = EXTERNAL_SHIFT ? 32'b0 : a << shamt;\\\"),\n    ('other_result = shifted_right[31:0];', \\\"other_result = EXTERNAL_SHIFT ? 32'b0 : shifted_right[31:0];\\\"),\n])\nupdate('ex_stage.sv', [\n    ('                    | ({32{sel.ex_mem.sub}}      & reg_q.result.sub)', '                    | ({32{sel.ex_mem.sub}}      & reg_q.result.sub)\\\\n  