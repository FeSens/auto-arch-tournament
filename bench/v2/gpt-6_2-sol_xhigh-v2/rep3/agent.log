{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'scratch=/srv/hwebench/tmp/5a1ea1b1/05cf7d75\ncat > \"$scratch/r9-fetch-model.cpp\" <<'\"'CPP'\n#include <cstdint>\n#include <deque>\n#include <fstream>\n#include <iostream>\n#include <vector>\n\nstruct Ret {\n    uint32_t pc, next, insn, rd, flags;\n    bool mem() const { return flags & 4; }\n    bool load() const { return (insn & 127) == 3; }\n    bool jalr() const { return (insn & 127) == 0x67 && \"'!(flags & 8); }\n    bool control() const { return (insn & 127) == 0x63 || (insn & 127) == 0x6f || jalr(); }\n    bool direct() const { return !jalr() && (next != pc + 4 || (insn & 127) == 0x6f); }\n};\n\nstruct Rng {\n    uint32_t state = 0xdeadbeef;\n    bool ready() {\n        state ''^= state << 13;\n        state ''^= state >> 17;\n        state ''^= state << 5;\n        return (state & 127) < 100;\n    }\n};\n\nvoid run(const std::vector<Ret> &trace, unsigned depth, bool freeze_control) {\n    Rng rng;\n    Ret bubble{};\n    const Ret *ex = &bubble, *mem = &bubble;\n    std::deque<uint32_t> q;\n    uint32_t request = 0;\n    uint64_t start = 0;\n    size_t issue = 0;\n    for (uint64_t cycle = 0; cycle < 5000000; cycle++) {\n        bool ir = rng.ready(), dr = rng.ready();\n        bool ds = mem->mem() && !dr;\n        const auto &next = trace[issue];\n        bool jump = ex->jalr(), dir = ex->direct() && ex != &bubble;\n        bool hazard = ex->load() && ex->rd && (ex->rd == (next.insn >> 15 & 31) ||\n                                                ex->rd == (next.insn >> 20 & 31));\n        bool flow = !ds && !hazard && !jump;\n        bool fetchable = !freeze_control || !ex->control();\n        bool take = false;\n\n        if (jump) {\n            if (!ds) {\n                q.clear();\n                request = ex->next;\n            }\n        } else if (dir) {\n            if (!ds) {\n                q.clear();\n                take = ir;\n                request = ex->next + (ir ? 4 : 0);\n            }\n        } else {\n            if (flow && !q.empty()) {\n                if (q.front() != next.pc) { std::cerr << \"bad head'\"\\\\n\\\"; return; }\n                q.pop_front();\n                take = true;\n            } else if (flow && ir && request == next.pc) {\n                take = true;\n                request += 4;\n                ir = false;\n            }\n            if (ir && q.size() < depth && fetchable) {\n                q.push_back(request);\n                request += 4;\n            }\n        }\n\n        if (\"'!ds && (mem->flags & 3) == 1) start = cycle;\n        if (!ds && (mem->flags & 3) == 2) {\n            std::cout << \"depth \" << depth << \", freeze \" << freeze_control\n                      << \": \" << cycle-start << \"'\"\\\\n\\\";\n            return;\n        }\n        if (\"'!ds) {\n            mem = ex;\n            ex = take ? &trace[issue++] : &bubble;\n        }\n    }\n}\n\nint main(int n, char **a) {\n    if (n < 2) return 1;\n    std::ifstream in(a[1],std::ios::binary);\n    Ret word;\n    std::vector<Ret> trace;\n    while(in.read(reinterpret_cast<char *>(&word), sizeof(word))) trace.push_back(word);\n    trace.resize(trace.size()+5);\n    for (unsigned depth: {0,1,2,3,4,6,8,16,128}) for (bool freeze: {true,false}) run(trace,depth,freeze);\n}\nCPP\ng++ -std=c++17 -O3 \"$scratch/r9-fetch-model.cpp\" -o \"$scratch/r9-fetch-model\" && \"$scratch/r9-fetch-model\" \"$scratch/r9-trace.bin\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
