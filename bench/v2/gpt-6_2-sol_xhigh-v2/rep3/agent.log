n            ready_offers[ia] = visit + 1\n        else:\n            imem_stalls[stall_key] -= 1\n        dut.io_imemReady.value = int(fetch_ready)\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        if fetch_trace is not None:\n            await Timer(1, \"ns\")\n            assert int(dut.io_imemAddr.value) == ia, \"bus readiness changed the offered fetch\"\n            fetch_trace.append((ia, fetch_ready, not data_waiting))\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _assert_path(retirements, pcs):\n    assert [r[\"order\"] for r in retirements] == list(range(len(pcs)))\n    assert [r[\"pc\"] for r in retirements] == pcs\n    assert [r[\"pc_next\"] for r in retirements] == pcs[1:] + [pcs[-1] + 4]\n    assert not any(r[\"trap\"] for r in retirements)\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n","exit_code":0,"status":"completed"}}
