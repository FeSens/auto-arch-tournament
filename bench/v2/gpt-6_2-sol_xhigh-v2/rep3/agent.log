{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'scratch_div=\"$TMPDIR/bench-div-r4.oDolNH\"\npython - \"$scratch_div\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, subprocess, sys\n\nscratch = Path(sys.argv[1])\nsrc = subprocess.check_output([\\\"git\\\", \\\"show\\\", \\\"HEAD:cores/bench/rtl/div_unit.sv\\\"], text=True)\nhead, tail = src.split(\\\"  localparam logic [3:0] FIRST_GROUP\\\", 1)\ntests = [\\\"input logic [31:0] divisor_abs_q\\\", \\\"  assign corrected =\\\"]\n\ndef build_two_widths(variant, wide_bits):\n    cutoff = 32-6*wide_bits\n    dwidth = 32+wide_bits\n    cnt = (1<<wide_bits)-1\n    target = scratch / variant\n    shutil.copytree(scratch / \\\"cores/bench/rtl\\\", target)\n    start = head + f\\\"\\\"\\\"  localparam logic [3:0] FIRST_GROUP = 4'd2;\n\n  logic signed_op, remainder_op;\n  logic a_negative, b_negative;\n  logic remainder_op_q, negate_q, overflow_q, wide_q;\n  logic [31:0] divisor_abs_q;\n  logic [{dwidth-1}:0] d_q [1:{cnt}];\n  logic [35:0] dividend_quotient_q;\n  logic [31:0] remainder_q, magnitude, corrected;\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign remainder_op = (op == ALU_REM || op == ALU_REMU);\n  assign a_negative = signed_op && a[31];\n  assign b_negative = signed_op && b[31];\n\n  function automatic [{dwidth-1}:0] csa_sum(input logic [{dwidth-1}:0] x, y, z);\n    csa_sum = (x \"'^ y ''^ z) + (((x & y) | (x & z) | (y & z)) << 1);\n  endfunction\n\n\"\"\"\n    functions = \"\"\n    for name, w, bits in [(\"narrow_digit\",cutoff,3), (\"wide_digit\",32,wide_bits)]:\n        t=w+bits\n        count=(1<<bits)-1\n        funcs = f\"  function automatic [{t-1}:0] {name}('\"\\\\n    input logic [{t-1}:0] trial\\\"\n        funcs += \\\",\\\".join([\\\"\\\"]+[f\\\"\\\\n    input logic [{t-1}:0] multiple{i}\\\" for i in range(1,count+1)])+\\\"\\\\n  );\\\\n\\\"\n        funcs += f\\\"\\\"\\\"    logic [{t}:0] diff [1:{count}];\n    logic [{count}:0] pick;\n    logic [{w-1}:0] r;\n    logic [{bits-1}:0] q;\n\n\\\"\\\"\\\"\n        funcs += ''.join([f\\\"    diff[{i}] = {{1'b0, trial}} - {{1'b0, multiple{i}}};\\\\n\\\" for i in range(1,count+1)])\n        funcs += f\\\"    pick[0] = diff[1][{t}];\\\\n\\\"\n        funcs += ''.join([f\\\"    pick[{i}] = \"'!diff[{i}][{t}] && diff[{i+1}][{t}];'\"\\\\n\\\" for i in range(1,count)])\n        funcs += f\\\"    pick[{count}] = \"'!diff[{count}][{t}];'\"\\\\n\\\"\n        fs = [f\\\"({{{w}{{pick[0]}}}} & trial[{w-1}:0])\\\"] + [f\\\"({{{w}{{pick[{i}]}}}} & diff[{i}][{w-1}:0])\\\" for i in range(1,count+1)]\n        funcs += \\\"    r = \\\"+\\\"\\\\n      | \\\".join(fs)+\\\";\\\\n\\\"\n        fs = [f\\\"({{{bits}{{pick[{i}]}}}} & {bits}'d{i})\\\" for i in range(1,count+1)]\n        funcs += \\\"    q = \\\"+\\\"\\\\n      | \\\".join(fs)+\\\";\\\\n\\\"\n        funcs += f\\\"    {name} = {{r, q}};\\\\n  endfunction\\\\n\\\\n\\\"\n        functions += funcs\n\n    narrow_s_args = \\\", \\\".join([f\\\"d_q[{i}][{cutoff+2}:0]\\\" for i in range(1,8)])\n    w_s_args = \\\", \\\".join([f\\\"d_q[{i}]\\\" for i in range(1,cnt+1)])\n    body = f\\\"\\\"\\\"  logic [{cutoff+2}:0] small0, small1;\n  logic [{dwidth-1}:0] large;\n\n  assign small0 = narrow_digit({{remainder_q[{cutoff-1}:0], dividend_quotient_q[35:33]}},\n                              {narrow_s_args});\n  assign small1 = narrow_digit({{small0[{cutoff+2}:3], dividend_quotient_q[32:30]}},\n                              {narrow_s_args});\n  assign large = wide_digit({{remainder_q, dividend_quotient_q[35:{36-wide_bits}]}},\n                           {w_s_args});\n  wire [{dwidth-1}:0] divisor_ext = {{{wide_bits}'b0, divisor_abs_q}};\n  always_ff @(posedge clock) begin\n    if (issue && issue_ready) begin\n      dividend_quotient_q <= {{4'b0, a_negative ? -a : a}};\n      divisor_abs_q <= b_negative ? -b : b;\n      remainder_q <= 32'b0;\n      remainder_op_q <= remainder_op;\n      negate_q <= a_negative \"'^ (b_negative && !remainder_op);\n      overflow_q <= signed_op && a == 32'\"'h8000_0000 && b == 32'hffff_ffff;\n    end else if (phase_q == SETUP) begin\n      wide_q <= |divisor_abs_q[31:{cutoff}];\n      if (|divisor_abs_q[31:{cutoff}]) begin\n        remainder_q <= {{{32-cutoff}'b0, dividend_quotient_q[31:{32-cutoff}]}};\n        dividend_quotient_q <= {{dividend_quotient_q[{31-cutoff}:0], {cutoff+4}'b0}};\n      end\n      d_q[1] <= divisor_ext;\n      d_q[3] <= (divisor_ext << 1) + divisor_ext;\n      d_q[5] <= (divisor_ext << 2) + divisor_ext;\n      d_q[7] <= (divisor_ext << 3) - divisor_ext;\n\\\"\\\"\\\"\n    if wide_bits == 4:\n        body += \\\"\\\"\\\"      d_q[9] <= (divisor_ext << 3) + divisor_ext;\n      d_q[11] <= csa_sum(divisor_ext << 3, divisor_ext << 1, divisor_ext);\n      d_q[13] <= csa_sum(divisor_ext << 3, divisor_ext << 2, divisor_ext);\n      d_q[15] <= (divisor_ext << 4) - divisor_ext;\n\\\"\\\"\\\"\n    body += f\\\"\\\"\\\"    end else if (phase_q >= FIRST_GROUP && phase_q < COMPLETE) begin\n      if (wide_q) begin\n        dividend_quotient_q <= {{dividend_quotient_q[{35-wide_bits}:0], large[{wide_bits-1}:0]}};\n        remainder_q <= large[{dwidth-1}:{wide_bits}];\n      end else begin\n        dividend_quotient_q <= {{dividend_quotient_q[29:0], small0[2:0], small1[2:0]}};\n        remainder_q <= {{{32-cutoff}'b0, small1[{cutoff+2}:3]}};\n      end\n    end\n  end\n\n  for (genvar j = 2; j <= {cnt}; j += 2) begin : even_multiple\n    assign d_q[j] = d_q[j/2] << 1;\n  end\n\n\\\"\\\"\\\"\n    last = src[src.index(\\\"  assign magnitude =\\\"):].replace(\\\"d1_q == 35'b0\\\", \\\"divisor_abs_q == 32'b0\\\")\n    (target / \\\"div_unit.sv\\\").write_text(start + functions + body + last)\n\nbuild_two_widths(\\\"dual8\\\", 3)\nbuild_two_widths(\\\"dual16\\\", 4)\nPY\nPYTHONDONTWRITEBYTECODE=1 python - \\\"\"'$scratch_div\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build\ns = Path(sys.argv[1])\nvariants = (\\\"dual8\\\", \\\"dual16\\\")\nwith ThreadPoolExecutor(max_workers=2) as ex:\n    fs = {v:ex.submit(build, s, s/v, \\\"fpga/core_bench_si.sv\\\", 0, s/\\\"timing\\\"/v/\\\"gowin_p0\\\") for v in variants}\n    for v in variants:\n        r=fs[v].result()\n        print(v,r.get(\\\"fmax_mhz\\\"),r.get(\\\"logic\\\"),r.get(\\\"reason\\\"),r.get(\\\"critical_paths\\\", [])[:3],flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
