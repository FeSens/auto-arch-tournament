{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, os\n\nstudy = Path(os.environ['TMPDIR'])/'r7s0-study'\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nrtl = study/'abase'\nshutil.copytree('cores/bench/rtl', rtl, dirs_exist_ok=True)\nupdate('id_stage.sv', [\n    ('  assign rs1_sel.reg_file = \"'!(ex_hit[0] || mem_hit[0]);'\"', \\\"  assign rs1_sel.reg_file = 1'b1;\\\"),\n    ('      reg_q.rs1_val      <= rs1_data;', \\\"      reg_q.rs1_val      <= (ex_hit[0] || mem_hit[0]) ? 32'b0 : rs1_data;\\\"),\n])\n\nrtl = study/'bbase'\nshutil.copytree('cores/bench/rtl', rtl, dirs_exist_ok=True)\nupdate('core_pkg.sv', [\n    ('    logic        alu_b_imm;','    logic [31:0] alu_b_val;'),\n])\nupdate('id_stage.sv', [\n    (\\\"      reg_q.alu_b_imm    <= dec_alu_src;\\\", '''      reg_q.alu_b_val    <= ({32{\"'!dec_alu_src && !(ex_hit[1] || mem_hit[1])}} & rs2_data)\n                         | ({32{dec_alu_src}} & imm);'\"'''),\n])\nupdate('ex_stage.sv', [\n    ('''  assign alu_b = forward_operand(in.alu_b_sel, in.rs2_val)\n               | ({32{in.alu_b_imm}} & in.imm);''','  assign alu_b = forward_operand(in.alu_b_sel, 32\\\\'b0) | in.alu_b_val;'),\n])\n\nrtl = study/'abbase'\nshutil.copytree(study/'abase', rtl, dirs_exist_ok=True)\nupdate('id_stage.sv', [\n    ('  assign rs2_sel.reg_file = \"'!(ex_hit[1] || mem_hit[1]);'\"', \\\"  assign rs2_sel.reg_file = 1'b1;\\\"),\n    ('      reg_q.rs2_val      <= rs2_data;', \\\"      reg_q.rs2_val      <= (ex_hit[1] || mem_hit[1]) ? 32'b0 : rs2_data;\\\"),\n])\n\nrtl = study/'prefixsel'\nshutil.copytree(study/'preselect', rtl, dirs_exist_ok=True)\nupdate('ex_stage.sv', [\n    ('''    forward_operand = ({32{sel.ex_mem.add}}''','''    logic [31:0] pair0, pair1, pair2;\n    pair0 = ({32{sel.ex_mem.add}}'''),\n    ('''                    | ({32{sel.ex_mem.sub}}      & reg_q.result.sub)\n                    | ({32{sel.ex_mem.other}}    & reg_q.result.other)\n                    | ({32{sel.ex_mem.mul_low}}  & reg_q.result.product[31:0])\n                    | ({32{sel.ex_mem.mul_high}} & reg_q.result.product[63:32])\n                    | ({32{sel.mem_wb}}         & fwd_mem_wb)\n                    | reg_value;''','''          | ({32{sel.ex_mem.sub}} & reg_q.result.sub);\n    pair1 = ({32{sel.ex_mem.other}} & reg_q.result.other)\n          | ({32{sel.mem_wb}} & fwd_mem_wb);\n    pair2 = ({32{sel.ex_mem.mul_high}} & reg_q.result.product[63:32])\n          | ({32{sel.ex_mem.mul_low}} & reg_q.result.product[31:0]);\n    forward_operand = pair0 | pair1 | pair2 | reg_value;''')\n])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/r7s0-study/synth.py\" abase'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
