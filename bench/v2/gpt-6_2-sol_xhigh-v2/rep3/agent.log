{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/5a1ea1b1/7c4fbf7b/tmp.5Evixz2QTZ' <<'PY'\nimport numpy as n\nfrom pathlib import Path\nfrom collections import Counter\nimport sys\ns=Path(sys.argv[1])\ncy,p,q,i,m,a=n.fromfile(s/'retire.bin','u4').reshape(-1,6).T\nmc,ip,occ,flags,word=n.fromfile(s/'micro.bin','u4').reshape(-1,5).T\ndef top(k,mask):\n print(' '.join(f'{x:#06x}={y}' for x,y in Counter(k[mask]).most_common(18)))\nb=[(flags&(1<<i))\"'!=0 for i in range(9)]\nissue,ds,lu,dr,sr,jr,reject,ready,guess=b\nprint('\"'cycles',len(mc),'issue',issue.sum(),'ds',ds.sum(),'LU (outside d)',(lu&~ds).sum(),'repairs',dr.sum(),sr.sum(),jr.sum(),'reject',reject.sum())\nfempty=(occ==1)&~(ds|lu|dr|sr|jr)\nprint('empty',fempty.sum(),'starve with bus not ready', (fempty&~ready).sum());top(ip,fempty)\ntarget=(i&127==0x63)&(p==q-4)\nstarts=Counter()\ncov=n.zeros(len(p),bool)\nfor j in range(1,5):\n ix=n.where(target[:-j])[0]+j\n valid=(p[ix]==p[ix-j]+4*j)&~n.isin(i[ix]&127,(0x63,0x6f,0x67,0xf,0x73))\n if j>1:\n  valid &= ~n.isin(i[ix-1]&127,(0x63,0x6f,0x67,0xf,0x73))\n ix=ix[valid]\n cov[ix]=True\n starts.update(p[ix-j])\nprint('fallthrough contiguous profile',cov.sum(), starts.most_common(10))\nprint('starve PCs that are fall-through cacheable pairs',n.isin(ip,n.unique(p[cov]))[fempty].sum())\nprint('starve next retire is fall-through cacheable',cov[n.minimum(n.searchsorted(cy,mc[fempty],side='left')+0,len(cy)-1)].sum())\nhistory=Counter()\nindices=n.where(fempty)[0]\nlook=n.searchsorted(cy,mc[indices],side='right')-1\nprint('after prev retired branch opcode',Counter((i[look]&127).tolist()).most_common(8))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
