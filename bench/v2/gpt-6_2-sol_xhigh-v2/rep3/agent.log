{"type":"item.started","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -c \"cat > cores/bench/test/test_predictor_metadata.py <<'PY'\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\n\n\ndef update(pc, target, taken, snapshot=0):\n    return (pc << 39) | (target << 7) | (1 << 6) | (taken << 5) | snapshot\n\n\n@cocotb.test()\nasync def prioritize_recent_writes(dut):\n    dut.clock.value = 0\n    dut.fetch_pc.value = 0\n    dut.reset.value = 1\n    dut.update.value = 0\n\n    async def edge(record):\n        dut.update.value = record\n        await Timer(1, unit=\\\"ns\\\")\n        dut.clock.value = 1\n        await Timer(1, unit=\\\"ns\\\")\n        dut.clock.value = 0\n\n    await edge(0)\n    dut.reset.value = 0\n    await edge(update(0, 8, 1))\n    await edge(update(4, 12, 1))\n    await edge(update(0, 8, 0))   # stale miss predates both writes\n    await edge(0)\n    assert int(dut.prediction.value) == 0b1010\n\n    await edge(update(128, 136, 1))\n    await edge(update(0, 8, 0, 0b1010))  # stale hit has been evicted\n    await edge(0)\n    assert int(dut.prediction.value) >> 3 == 0\n    dut.fetch_pc.value = 128\n    await Timer(1, unit=\\\"ns\\\")\n    assert int(dut.prediction.value) == 0b1101\n    assert int(dut.predicted_target.value) == 136\n\n\ndef test_predictor_metadata_runner():\n    run_cocotb(\\\"branch_predictor\\\", [\\\"core_pkg.sv\\\", \\\"branch_predictor.sv\\\"], \\\"test_predictor_metadata\\\")\nPY\npython3 -m pytest -q cores/bench/test/test_predictor_metadata.py > metadata.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
