{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nnew_cases = '''\n@cocotb.test()\nasync def btb_retarget_flushes_wrong_path_divide(dut):\n    program = [NOP() for _ in range(14)]\n    program[:4] = [ADDI(1, 0, 32), SW(0, 1, 0), JALR(5, 1, 0), EBREAK()]\n    program[8:11] = [_r(1, 0, 0, 0b101, 7, 0b0110011), ADDI(1, 0, 48), JAL(0, -36)]\n    program[12:14] = [ADDI(1, 0, 50), JAL(0, -44)]\n    stores = []\n    rets, _ = await _run(dut, program, store_stalls={48: 4}, imem_stalls={48: 2},\n                         accepted_stores=stores)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 32, 36, 40, 4, 8, 48, 52, 8, 12]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert [(r[\\\"pc_next\\\"], r[\\\"trap\\\"], r[\\\"rd_wdata\\\"]) for r in rets if r[\\\"pc\\\"] == 8] == [\n        (32, 0, 12), (48, 0, 12), (12, 1, 0),\n    ]\n    assert stores == [(32, 15, 0), (48, 15, 0)]\n\n\n@cocotb.test()\nasync def btb_partial_tag_alias_squashes_wrong_path_store(dut):\n    program = [NOP() for _ in range(0x1002)]\n    program[0] = JAL(0, 8)\n    program[2] = SW(0, 0, 32)\n    program[3] = JAL(0, 0x4000 - 12)\n    program[0x1000] = ADDI(1, 0, 42)\n    program[0x1001] = EBREAK()\n    stores = []\n    rets, _ = await _run(dut, program, accepted_stores=stores)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 8, 12, 0x4000, 0x4004]\n    assert rets[3][\\\"pc_next\\\"] == 0x4004\n    assert rets[3][\\\"rd_wdata\\\"] == 42\n    assert stores == [(32, 15, 0)]\n\n\n@cocotb.test()\nasync def btb_repeated_taken_branch_and_exit(dut):\n    branch = _b(-4, 0, 1, 0b001, 0b1100011)\n    program = [ADDI(1, 0, 8), ADDI(1, 1, -1), branch, EBREAK()]\n    rets, _ = await _run(dut, program)\n    branches = _by_insn(rets, branch)\n    assert [r[\\\"pc_next\\\"] for r in branches] == [4] * 7 + [12]\n    assert branches[-2][\\\"cycle\\\"] == branches[-3][\\\"cycle\\\"] + 2\n    assert rets[-1][\\\"pc\\\"] == 12\n\n\n'''\nfor name in ('late','indirect','early'):\n    p = Path('variants') / name / 'cores/bench/test/test_pipeline.py'\n    s = p.read_text()\n    p.write_text(s.replace('def test_pipeline_runner():', new_cases + 'def test_pipeline_runner():'))\nPY\npython3 -m pytest -q variants/indirect/cores/bench/test > indirect-pytest.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
