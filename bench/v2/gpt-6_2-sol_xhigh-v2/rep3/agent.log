{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"ls -l /opt/gowin; rg -n 'argparse|def.*timing|GOWIN|gw_sh|project' tools/eval/gowin.py | head -65; sed -n '135,144p' Makefile; cat formal/checks_si.cfg\"","aggregated_output":"total 16\ndrwxr-xr-x 10 nobody nogroup 4096 Jul 10  2025 IDE\ndrwxr-xr-x  5 nobody nogroup 4096 Jul  5  2025 Programmer\ndrwxr-xr-x  4 nobody nogroup 4096 Sep 28 04:16 deps\n-rw-r--r--  1 nobody nogroup   76 Sep 28 04:15 gowin.tgz.sha256\n22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\n23:GOWIN_VERSION = \"1.9.11.03 Education\"\n35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n51:def project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n153:    (outdir / \"build.tcl\").write_text(project_tcl(worktree, rtl_dir, bench_sv, place_option))\n158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n202:    import argparse, json\n204:    ap = argparse.ArgumentParser()\n# FPGA timing and area come from the vendor flow, Gowin EDA\n# (tools/eval/gowin.py); V2 does not synthesize with Yosys.\nfpga: cosim-build bench/programs/coremark.elf\n\tpython3 -m tools.eval.fpga . $(TARGET)\n\ntiming:\n\tpython3 -m tools.eval.gowin $(TARGET)\n\nbench/programs/coremark.elf: bench/programs/Makefile bench/programs/crt0.S \\\n                              $(wildcard bench/programs/coremark/*.c) \\\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n","exit_code":0,"status":"completed"}}
