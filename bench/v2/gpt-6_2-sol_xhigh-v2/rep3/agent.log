{"type": "item.started", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nroot=Path('cores/bench/rtl')\np=root/'ex_stage.sv'\ns=p.read_text()\na=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nb=s.index('  assign direct_target', a)\ns=s[:a]+'''  // Compare four bytes in parallel, then use the first differing byte.\n  logic [3:0] branch_byte_eq, branch_byte_lt;\n  logic branch_eq, branch_lt, branch_ordered;\n  for (genvar byte_idx = 0; byte_idx < 4; byte_idx++) begin : gen_branch_byte\n    assign branch_byte_eq[byte_idx] =\n      rs1[8*byte_idx +: 8] == rs2[8*byte_idx +: 8];\n    assign branch_byte_lt[byte_idx] =\n      rs1[8*byte_idx +: 8] < rs2[8*byte_idx +: 8];\n  end\n  assign branch_eq = &branch_byte_eq;\n  assign branch_lt = branch_byte_lt[3]\n                   || (branch_byte_eq[3] && branch_byte_lt[2])\n                   || (&branch_byte_eq[3:2] && branch_byte_lt[1])\n                   || (&branch_byte_eq[3:1] && branch_byte_lt[0]);\n  assign branch_ordered = (\"'!in.ctrl.branch_op[1] && (rs1[31] ''^ rs2[31]))\n                        ? rs1[31] : branch_lt;\n  assign branch_cond = (in.ctrl.branch_op[2] ? branch_ordered : branch_eq)\n                     ''^ in.ctrl.branch_op[0];\n\n  assign branch_taken = in.ctrl.is_branch && branch_cond;\n  assign control_taken = branch_taken || in.ctrl.is_jump;\n'\"'''+s[b:]\ns=s.replace('  logic        target_misaligned;', '  logic        jalr_misaligned;').replace('  logic        control_taken;\\\\n','')\ns=s.replace('  assign control_taken = branch_taken || in.ctrl.is_jump;\\\\n','')\na=s.index('  assign target_misaligned')\nb=s.index('  always_comb begin',a)\ns=s[:a]+\\\"\\\"\\\"  assign jalr_misaligned = rs1[1] \"'^ in.imm[1] ''^ (rs1[0] & in.imm[0]);\n  assign misalign_fault = ((branch_taken || (in.ctrl.is_jump && !in.ctrl.is_jalr)) && in.imm[1])\n                       || (in.ctrl.is_jalr && jalr_misaligned);\n  assign red