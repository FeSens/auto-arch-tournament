{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'scratch_div=\"$(mktemp -d \"$TMPDIR/bench-div-r4.XXXXXX\")\"\ncp -a bench cores formal fpga schemas test tools Makefile \"$scratch_div/\"\npython - \"$scratch_div\" <<'\"'PY'\nfrom pathlib import Path\nimport re, sys\n\nscratch = Path(sys.argv[1])\nsrc = (scratch / 'cores/bench/rtl/div_unit.sv').read_text()\nfor newdir, width in [('lookahead7', 7), ('lookahead5', 5)]:\n    target = scratch / newdir\n    target.mkdir()\n    for path in (scratch / 'cores/bench/rtl').glob('*.sv'):\n        (target / path.name).write_bytes(path.read_bytes())\n    helper = f\\\"\\\"\\\"\n  localparam integer BLOCK_W = {width};\n  localparam integer NUM_BLOCKS = 35 / BLOCK_W;\n  localparam integer PREFIX_LEVELS = \"'$clog2(NUM_BLOCKS);\n\n  function automatic [35:0] block_subtract(\n    input logic [34:0] trial,\n    input logic [34:0] multiple\n  );\n    logic [NUM_BLOCKS-1:0] generate_borrow [0:PREFIX_LEVELS];\n    logic [NUM_BLOCKS-1:0] propagate_borrow [0:PREFIX_LEVELS];\n    logic [34:0] difference, difference_if_borrow;\n    logic [35:0] answer;\n\n    for (integer block_idx = 0; block_idx < NUM_BLOCKS; block_idx++) begin\n      logic [BLOCK_W-1:0] lhs, rhs;\n      lhs = trial[block_idx*BLOCK_W +: BLOCK_W];\n      rhs = multiple[block_idx*BLOCK_W +: BLOCK_W];\n      {{generate_borrow[0][block_idx], difference[block_idx*BLOCK_W +: BLOCK_W]}}\n          = {{1'\"'b0, lhs}} - {{1'b0, rhs}};\n      difference_if_borrow[block_idx*BLOCK_W +: BLOCK_W] = lhs + ~rhs;\n      propagate_borrow[0][block_idx] = lhs == rhs;\n    end\n\n    for (integer level = 0; level < PREFIX_LEVELS; level++) begin\n      for (integer block_idx = 0; block_idx < NUM_BLOCKS; block_idx++) begin\n        if (block_idx >= (1 << level)) begin\n          generate_borrow[level+1][block_idx] = generate_borrow[level][block_idx] |\n            (propagate_borrow[level][block_idx] & generate_borrow[level][block_idx-(1 << level)]);\n          propagate_borrow[level+1][block_idx] = propagate_borrow[level][block_idx] &\n            propagate_borrow[level][block_idx-(1 << level)];\n        end else begin\n          generate_borrow[level+1][block_idx] = generate_borrow[level][block_idx];\n          propagate_borrow[level+1][block_idx] = propagate_borrow[level][block_idx];\n        end\n      end\n    end\n\n    answer[BLOCK_W-1:0] = difference[BLOCK_W-1:0];\n    for (integer block_idx = 1; block_idx < NUM_BLOCKS; block_idx++) begin\n      answer[block_idx*BLOCK_W +: BLOCK_W] = generate_borrow[PREFIX_LEVELS][block_idx-1] ?\n        difference_if_borrow[block_idx*BLOCK_W +: BLOCK_W] : difference[block_idx*BLOCK_W +: BLOCK_W];\n    end\n    answer[35] = generate_borrow[PREFIX_LEVELS][NUM_BLOCKS-1];\n    block_subtract = answer;\n  endfunction\n\n\\\"\\\"\\\"\n    source = re.sub(r\\\"\\\\{1'b0, trial\\\\} - \\\\{1'b0, (d[1-7])\\\\}\\\", r\\\"block_subtract(trial, \\\\1)\\\", src)\n    source = source.replace('  // Appending three', helper + '  // Appending three')\n    (target / 'div_unit.sv').write_text(source)\nprint(scratch)\nPY\nprintf '%s\\\\n' \\\"\"'$scratch_div\"\nPYTHONDONTWRITEBYTECODE=1 python - \"$scratch_div\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build, summarize\ns = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=3) as ex:\n    fs = {(v, p):ex.submit(build, s, s / v, \\\"fpga/core_bench_si.sv\\\", p, s / \\\"timing\\\" / v / f\\\"gowin_p{p}\\\") for v in (\\\"lookahead7\\\", \\\"lookahead5\\\") for p in (0,1,2)}\n    for variant in (\\\"lookahead7\\\", \\\"lookahead5\\\"):\n        trials = [fs[variant,p].result() for p in (0,1,2)]\n        print(variant, summarize(trials), flush=True)\n        for t in trials:\n            print(t[\\\"place_option\\\"], t.get(\\\"reason\\\"), t.get(\\\"fmax_mhz\\\"), t.get(\\\"critical_paths\\\", [])[:2], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
