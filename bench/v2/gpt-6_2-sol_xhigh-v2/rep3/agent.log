{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"cat formal/checks_si.cfg && sed -n '1,250p' formal/wrapper_si.sv\"", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) \n…[1232 of 4304 chars elided by tools/bench/transcript.py; sha256:e375e6514f4ce086]…\ndirectly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n        .io_rvfi_trap_0     (rvfi_trap),\n        .io_rvfi_halt_0     (rvfi_halt),\n        .io_rvfi_intr_0     (rvfi_intr),\n        .io_rvfi_mode_0     (rvfi_mode),\n        .io_rvfi_ixl_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'fetch|cycle|stalls|redirect' cores/bench/test/test_pipeline.py && ls -la formal && ls -la /opt\"", "aggregated_output": "4:fetch/load model and captures RVFI retirements. Covers the §8 phase-2\n6:load/store byte lanes, load-use and divide stalls, multiply forwarding,\n79:async def _run(dut, program, dmem_init=None, max_cycles=200, *,\n80:               store_stalls=None, load_stalls=None, imem_stalls=None,\n81:               accepted_stores=None, accepted_loads=None, fetch_trace=None):\n82:    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n84:    imem is read combinationally each cycle from imemAddr; dmem similarly.\n85:    Stores update dmem on acceptance. store_stalls and load_stalls map\n86:    data addresses to stall counts. imem_stalls maps fetch PCs to stall\n89:    fetch_trace records (offered PC, imem ready, dmem ready) for each cycle.\n92:    sampled on every cycle that rvfi_valid=1.\n96:    store_stalls = dict(store_stalls or {})\n97:    load_stalls = dict(load_stalls or {})\n98:    imem_stalls = dict(imem_stalls or {})\n116:    # Deassert reset and prime the imem read for the first PC=0 fetch.\n120:    for cycle in range(max_cycles):\n131:        # The previous cycle's ready request was accepted at this edge.\n166:                \"cycle\":     cycle,\n172:        # Drive next cycle's imem fetch and dmem read combinationally.\n178:            assert ia == held_pc, \"fetch PC advanced before the older data request was accepted\"\n179:        stalls = load_stalls if ren else store_stalls\n180:        data_waiting = (ren or wen) and stalls.get(da, 0) > 0\n183:            stalls[da] -= 1\n191:        fetch_ready = imem_stalls.get(ia, 0) == 0\n192:        if not fetch_ready:\n193:            imem_stalls[ia] -= 1\n194:        dut.io_imemReady.value = int(fetch_ready)\n197:        if fetch_trace is not None:\n199:            assert int(dut.io_imemAddr.value) == ia, \"bus readiness changed the offered fetch\"\n200:            fetch_trace.append((ia, fetch_ready, not data_waiting))\n202:        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n259:    cycles = [r[\"cycle\"] for r in rets]\n260:    assert cycles == list(\n…[3112 of 6184 chars elided by tools/bench/transcript.py; sha256:ca575338063f30d5]…\ncycle\"] + 1\n664:    assert register[\"cycle\"] == immediate[\"cycle\"] + 1\n725:    rets, _ = await _run(dut, program, max_cycles=20)\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Nov 21 01:28 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 21 01:28 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 21 01:28 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 21 01:28 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 21 01:28 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    66 Nov 21 01:28 riscv-formal -> /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep3/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 21 01:28 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 21 01:28 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 21 01:28 wrapper_si.sv\ntotal 20\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 05:13 .\ndrwxr-xr-x 20 nobody nogroup 4096 Sep 28 01:00 ..\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 05:13 gowin\ndrwxr-xr-x  4 nobody nogroup 4096 Sep 28 02:57 hwe-python\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 02:44 hwe-toolchain\n", "exit_code": 0, "status": "completed"}}
