n && \"'!in.imm[1] && (!(|in.branch_load) || !stall);'\"'),\n    ('  assign write_eligible = ex_valid', '''  assign load_aligned = ex_valid && in.ctrl.mem_read &&\n    (in.ctrl.mem_width == 2'd0 ||\n     (in.ctrl.mem_width == 2'd1 && \"'!effective_addr[0]) ||\n     (in.ctrl.mem_width == 2'\"'d2 && effective_addr[1:0] == 2'b0));\n  assign write_eligible = ex_valid'''),\n    ('      reg_q.rs1_val       <= divide ? div_src_a : rs1;',\n     '      reg_q.rs1_val       <= divide ? div_src_a : in.branch_load[0] ? rvfi_load_data : rs1;'),\n    ('      reg_q.rs2_val       <= divide ? div_src_b : rs2;',\n     '      reg_q.rs2_val       <= divide ? div_src_b : in.branch_load[1] ? rvfi_load_data : rs2;')\n])\nupdate('mem_stage.sv', [\n    ('  output logic               write_eligible,','  output logic               write_eligible,\\\\n  output logic [31:0]        load_forward_data,'),\n    ('  assign write_eligible = in.valid', '  assign load_forward_data = load_data;\\\\n  assign write_eligible = in.valid'),\n])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/r7s0-study/synth.py\" loadbranch'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
