{"type": "item.started", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/bench-r3-research\"\ncat > \"$TMPDIR/bench-r3-research/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nbaseline = Path(sys.argv[1])\nscratch = Path(__file__).parent\npartition = scratch / 'partition'\nshutil.copytree(baseline, partition, dirs_exist_ok=True)\n\ndef edit(root, name, changes):\n    f = root / name\n    t = f.read_text()\n    for old, new in changes:\n        if t.count(old) \"'!= 1:\n            raise ValueError((name, old, t.count(old)))\n        t = t.replace(old, new)\n    f.write_text(t)\n\nedit(partition, '\"'core_pkg.sv', [\n    ('    logic [31:0] write_data;     // raw rs2', '    logic [31:0] effective_addr;\\\\n    logic [31:0] write_data;     // raw rs2'),\n])\nedit(partition, 'mem_stage.sv', [\n    ('    dmem_addr  = in.alu_result;', '    dmem_addr  = in.effective_addr;'),\n    ('in.alu_result[1:0]', 'in.effective_addr[1:0]'),\n] if False else [('    dmem_addr  = in.alu_result;', '    dmem_addr  = in.effective_addr;')])\nmem = partition / 'mem_stage.sv'\ntext = mem.read_text().replace('in.alu_result[', 'in.effective_addr[')\nmem.write_text(text)\n\nalu = partition / 'alu.sv'\ntext = alu.read_text()\ntext = text[:text.index('  // 64-bit products')] + text[text.index('  always_comb begin'):]\ntext = text[:text.index('    mul_ss = ')] + text[text.index('    case (op)'):]\ntext = text[:text.index('      // M-extension.')] + text[text.index('      default:'):]\nalu.write_text(text)\n\nedit(partition, 'ex_stage.sv', [\n    ('  logic divide;','''  logic mul_selected, mul_selected_q;\n  logic [31:0] mul_word;\n  assign mul_selected = in.valid && (in.ctrl.alu_op == ALU_MUL\n                    || in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU\n                    || in.ctrl.alu_op == ALU_MULHU);\n  always_ff @(posedge clock) begin\n    if (reset) mul_selected_q <= 1'b0;\n    else if (\"'!stall) mul_selected_q <= mul_selected;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] mul_value;\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_MUL:    mul_value = (rs1 + rs2) ''^ 32'\"'h5876063e;\n      ALU_MULH:   mul_value = (rs1 + rs2) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  mul_value = (rs1 + rs2) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: mul_value = (rs1 - rs2) \"'^ 32'\"'hecfbe137;\n      default:    mul_value = 32'b0;\n    endcase\n  end\n  always_ff @(posedge clock) begin\n    if (\"'!stall) mul_word <= mul_value;\n  end\n`else\n  logic signed [32:0] mul_a, mul_b;\n  logic [63:0] mul_product_q;\n  logic mul_high_q;\n  assign mul_a = $signed({rs1[31] && (in.ctrl.alu_op == ALU_MULH\n                                   || in.ctrl.alu_op == ALU_MULHSU), rs1});\n  assign mul_b = $signed({rs2[31] && (in.ctrl.alu_op == ALU_MULH), rs2});\n  always_ff @(posedge clock) begin\n    if (!stall) begin\n      mul_product_q <= 64'\"'(mul_a * mul_b);\n      mul_high_q <= in.ctrl.alu_op \"'!= ALU_MUL;\n    end\n  end\n  assign mul_word = mul_high_q ? mul_product_q[63:32] : mul_product_q[31:0];\n`endif\n\n  logic divide;'\"'''),\n    ('      reg_q.write_data    <= rs2;', '      reg_q.effective_addr <= jalr_sum;\\\\n      reg_q.write_data    <= rs2;'),\n    ('  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    out.alu_result = mul_selected_q ? mul_word : reg_q.alu_result;\n  end'''),\n])\n\nvariant = scratch / 'radix8'\nshutil.copytree(partition, variant, dirs_exist_ok=True)\ndiv = variant / 'div_unit.sv'\nold = div.read_text()\nheader = old[:old.index('  logic [31:0] divisor_abs_q, divisor_q;')]\ndecls = '''  logic [31:0] divisor_abs_q, divisor_q;\n  logic [34:0] d2_q, d3_q, d4_q, d5_q, d6_q, d7_q;\n  logic [35:0] dividend_quotient_q;\n  logic [31:0] remainder_q, magnitude, corrected;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign remainder_op = (op == ALU_REM || op == ALU_REMU);\n  assign a_negative = signed_op && a[31];\n  assign b_negative = signed_op && b[31];\n\n  function automatic [34:0] radix8_digit(\n    input logic [34:0] trial,\n    input logic [31:0] d1,\n    input logic [34:0] d2, d3, d4, d5, d6, d7\n  );\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [35:0] diff1, diff2, diff3, diff4, diff5, diff6, diff7;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic use0, use1, use2, use3, use4, use5, use6, use7;\n    logic [31:0] next_remainder;\n    begin\n'''\ndigits = '\\\\n'.join([\n    *[f\\\"      diff{i} = {{1'b0, trial}} - {{1'b0, {'3\\\\'b0, ' if i == 1 else ''}d{i}}};\\\" for i in []],\n])\nfor i in range(1, 8):\n    prefix = \\\"4'b0\\\" if i == 1 else \\\"1'b0\\\"\n    digits += f\\\"      diff{i} = {{1'b0, trial}} - {{{prefix}, d{i}}};\\\\n\\\"\ndigits += '      use0 = diff1[35];\\\\n'\nfor i in range(1, 7):\n    digits += f'      use{i} = \"'!diff{i}[35] && diff{i+1}[35];'\"\\\\n'\ndigits += '      use7 = \"'!diff7[35];'\"\\\\n'\ndigits += '      next_remainder = ({32{use0}} & trial[31:0])\\\\n'\nfor i in range(1,8):\n    digits += f\\\"                     | ({{32{{use{i}}}}} & diff{i}[31:0]){' ;' if i==7 else ''}\\\\n\\\"\ndigits += '''      radix8_digit = {next_remainder, use4 | use5 | use6 | use7,\n                                         use2 | use3 | use6 | use7, use1 | use3 | use5 | use7};\n    end\n  endfunction\n\n  logic [34:0] digit0, digit1;\n  assign digit0 = radix8_digit({remainder_q, dividend_quotient_q[35:33]},\n                             divisor_q, d2_q, d3_q, d4_q, d5_q, d6_q, d7_q);\n  assign digit1 = radix8_digit({digit0[34:3], dividend_quotient_q[32:30]},\n                             divisor_q, d2_q, d3_q, d4_q, d5_q, d6_q, d7_q);\n\n'''\ntail = old[old.index('  always_ff @(posedge clock) begin\\\\n    if (issue && issue_ready) begin\\\\n      dividend_quotient_q'):]\nstart = tail.index('      divisor_twice_q')\nend = tail.index('\\\\n    end\\\\n  end', start)\ntail = tail[:start] + '''      d2_q <= {2'b0, divisor_abs_q, 1'b0};\n      d3_q <= {3'b0, divisor_abs_q} + {2'b0, divisor_abs_q, 1'b0};\n      d4_q <= {1'b0, divisor_abs_q, 2'b0};\n      d5_q <= {3'b0, divisor_abs_q} + {1'b0, divisor_abs_q, 2'b0};\n      d6_q <= {2'b0, divisor_abs_q, 1'b0} + {1'b0, divisor_abs_q, 2'b0};\n      d7_q <= {divisor_abs_q, 3'b0} - {3'b0, divisor_abs_q};\n    end else if (phase_q >= FIRST_GROUP && phase_q < COMPLETE) begin\n      dividend_quotient_q <= {dividend_quotient_q[29:0], digit0[2:0], digit1[2:0]};\n      remainder_q <= digit1[34:3];''' + tail[end:]\ndiv.write_text(header + decls + digits + tail)\nPY\nsed -i '/\"'^digits = /,+2c'\"\\\\digits = \\\"\\\"' \\\"\"'$TMPDIR/bench-r3-research/prototype.py\"\npython3 \"$TMPDIR/bench-r3-research/prototype.py\" cores/bench/rtl\nfor variant in partition radix8; do\n  rtl_dir=\"$TMPDIR/bench-r3-research/$variant\"\n  verilator --lint-only -Wall -Wno-MULTITOP -sv \"+incdir+$rtl_dir\" \"$rtl_dir/core_pkg.sv\" \"$rtl_dir\"/*.sv || exit\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
