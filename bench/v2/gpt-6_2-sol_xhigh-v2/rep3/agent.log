{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'scratch_dir=\"$TMPDIR/predictor.iiXp9k\"\npython3 - \"$scratch_dir\" <<'\"'PY'\nimport shutil,sys\nfrom pathlib import Path\nd=Path(sys.argv[1])\nfor variant, use_pipe, use_lookahead in [('term_stage', True, False),('term_dual',False,True),('term_both',True,True)]:\n    t=d/variant\n    shutil.copytree(d/'terminal_credits',t,copy_function=shutil.copyfile)\n    if use_pipe:\n        p=t/'core.sv'\n        s=p.read_text()\n        i=s.index('  replay_train u_replay_train')\n        j=s.index('  // ── MEM',i)\n        s=s[:i]+'''  logic train_valid_q, train_direct_q, train_taken_q;\n  logic [31:0] train_pc_q, train_target_q, train_instr_q;\n\n  always_ff @(posedge clock) begin\n    train_valid_q <= \"'!reset && !fence_i && ex_mem_w.valid && !hold_mem_wb;\n    train_pc_q <= ex_mem_w.pc;\n    train_target_q <= train_target;\n    train_instr_q <= ex_mem_w.instr;\n    train_direct_q <= train_direct;\n    train_taken_q <= train_taken;\n  end\n\n  replay_train u_replay_train (\n    .clock   (clock),\n    .reset   (reset),\n    .fence_i (fence_i),\n    .advance (train_valid_q),\n    .pc      (train_pc_q),\n    .pc_next (train_target_q),\n    .instr   (train_instr_q),\n    .direct  (train_direct_q),\n    .taken   (train_taken_q),\n    .update  (replay_update)\n  );\n\n'\"'''+s[j:]\n        p.write_text(s)\n    if use_lookahead:\n        p=t/'if_stage.sv'\n        s=p.read_text()\n        s=s.replace('logic [5:1] fetch_forecast;', '''logic [5:1] sequential_forecast, resume_forecast;\n  logic sequential_guess, resume_guess;\n  logic [6:2] sequential_index, resume_index;''')\n        s=s.replace('  assign fetch_forecast = forecast[fetch_index][5:1];','''  assign sequential_index = fallthrough_q[6:2];\n  assign resume_index = resume_q[6:2];\n  assign sequential_forecast = forecast[sequential_index][5:1];\n  assign resume_forecast = forecast[resume_index][5:1];\n  assign sequential_guess = fallthrough_q[31:20] == 12'b0 && valid_q[sequential_index]\n                         && sequential_forecast[1] && sequential_forecast[5:2] == fallthrough_q[10:7];\n  assign resume_guess = valid_q[resume_index] && resume_forecast[1] && resume_forecast[5:2] == resume_q[10:7];''')\n        s=s.replace('&& in_window && valid_q[fetch_index]\\\\n              && fetch_forecast[1] && fetch_forecast[5:2] == cursor[10:7]', '&& (guess_q ? resume_guess : sequential_guess)')\n        p.write_text(s)\nPY\npython3 -u - \\\"\"'$scratch_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(sys.argv[1])\ndef timed(design):\n    results = build_all(Path.cwd(), scratch/design, 'fpga/core_bench_si.sv', scratch/(design+'_timing'))\n    print(design,summarize(results),flush=True)\n    for result in results:\n        print(design,result.get('place_option'), result.get('reason') or result.get('critical_paths',[None])[0],flush=True)\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    list(executor.map(timed,('term_stage','term_dual','term_both')))\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
