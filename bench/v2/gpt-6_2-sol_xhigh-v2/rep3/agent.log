{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'trial_dir=\"$TMPDIR/r13s1-profile/trial\"\nmkdir -p \"$trial_dir/cores/bench\"\ncp -R cores/bench/rtl \"$trial_dir/cores/bench/\"\ncp cores/bench/core.yaml \"$trial_dir/cores/bench/\"\ncp -R fpga \"$trial_dir/\"\npython - <<'\"'PY'\nimport os\nfrom pathlib import Path\nrtl = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"r13s1-profile/trial/cores/bench/rtl\\\"\ndef replace(file, edits):\n    p = rtl / file\n    s = p.read_text()\n    for before, after in edits:\n        assert s.count(before) == 1, (file, before, s.count(before))\n        s = s.replace(before, after)\n    p.write_text(s)\n\nreplace(\\\"if_stage.sv\\\", [\n    (\\\"  logic response, push, issue, pop;\\\", \\\"  logic response, push, issue, pop;\\\\n  logic transfer_word, landing_valid, landing_accepted;\\\\n  if_id_t queued;\\\"),\n    (\\\"  assign push = response && \"'!reject;\", \"\"\"  assign transfer_word = imem_data[6:0] == 7'\"'h63 || imem_data[6:0] == 7'h6f;\n  assign landing_valid = response && \"'!reject\n                      && (repair || retry_q || (occupancy_q[0] && !transfer_word));\n  assign landing_accepted = landing_valid && (repair || issue_enable);\n  assign push = response && !reject && !landing_accepted;\"\"\"),\n    (\"&& (imem_data[6:0] == 7'\"'h63 || imem_data[6:0] == 7'h6f);\\\", \\\"&& transfer_word;\\\"),\n    (\\\"    if (repair || push) retry_q <= repair && \"'!response;\", \"    if (repair || response) retry_q <= repair && !response;\"),\n    (\"\"\"  assign out.valid = !occupancy_q[0];\n  assign out.predicted_taken = lane_q[0] && predicted_taken;\n  assign out.instr = issue_word_q;\n  assign out.synthetic = issue_synthetic_q;\n  assign replay_next = replay_pc_q + 18'\"'d1;\n  assign out.pc = lane_q[0] ? head_bus_pc : {12'b0, replay_pc_q, 12'b0, replay_next};\n  assign issue = issue_enable && out.valid;\\\"\\\"\\\", \\\"\\\"\\\"  assign queued.valid = \"'!occupancy_q[0];\n  assign queued.predicted_taken = lane_q[0] && predicted_taken;\n  assign queued.instr = issue_word_q;\n  assign queued.synthetic = issue_synthetic_q;\n  assign replay_next = replay_pc_q + 18'\"'d1;\n  assign queued.pc = lane_q[0] ? head_bus_pc : {12'b0, replay_pc_q, 12'b0, replay_next};\n  assign issue = issue_enable && queued.valid;\n  assign out = landing_valid\n             ? {request_pc, request_next, 1'b0, imem_data, \"'!in_window, 1'\"'b1}\n             : queued;\\\"\\\"\\\"),\n    (\\\"capture_issue_word = (repair || occupancy_q[0]) ? response\\\", \\\"capture_issue_word = (repair || occupancy_q[0]) ? push\\\"),\n])\n\nreplace(\\\"id_stage.sv\\\", [\n    (\\\"  input  logic              flush,\\\", \\\"  input  logic              flush,\\\\n  input  logic              repair,\\\\n  input  logic              repair_landing,\\\"),\n    (\\\"    if (\"'!stall) begin\", \"    if (!stall || repair) begin\"),\n    (\"    if (reset || flush) reg_q.valid <= 1'\"'b0;\\\", \\\"\\\"\\\"    if (reset) reg_q.valid <= 1'b0;\n    else if (repair) reg_q.valid <= repair_landing;\n    else if (flush) reg_q.valid <= 1'b0;\\\"\\\"\\\"),\n])\n\nreplace(\\\"core.sv\\\", [\n    (\\\"    .flush              (flush_id),\\\", \\\"    .flush              (flush_id),\\\\n    .repair             (repair),\\\\n    .repair_landing     (repair && io_imemReady),\\\"),\n])\nreplace(\\\"hazard_unit.sv\\\", [\n    (\\\"assign hold_mem_wb = stall_ex_mem || repair;\\\", \\\"assign hold_mem_wb = stall_ex_mem;\\\"),\n])\nreplace(\\\"ex_stage.sv\\\", [\n    (\\\"    end else if (\"'!stall && !repair) begin'\"\\\\n      reg_q.pc\\\", \\\"\\\"\\\"    end else if (repair) begin\n      reg_q.valid         <= 1'b0;\n      reg_q.ctrl          <= '0;\n      train_direct        <= 1'b0;\n    end else if (\"'!stall) begin\n      reg_q.pc\"\"\"),\n])\nPY\nrtl_dir=\"$trial_dir/cores/bench/rtl\"\nsources=(\"$rtl_dir/core_pkg.sv\")\nfor source in \"$rtl_dir\"/*.sv; do if [[ \"$source\" != \"$rtl_dir/core_pkg.sv\" ]]; then sources+=(\"$source\"); fi; done\nverilator --cc --exe --build -j 8 -Mdir \"$trial_dir/sim\" \"+incdir+$rtl_dir\" --top-module core -Wno-fatal -CFLAGS \"-DNRET=1\" \"${sources[@]}\" \"$PWD/test/cosim/main.cpp\" -o cosim_sim > \"$trial_dir/sim-build.log\" 2>&1 && \"$trial_dir/sim/cosim_sim\" \"$TMPDIR/r13s1-profile/coremark.elf\" 7000000 --bench --istall --dstall'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
