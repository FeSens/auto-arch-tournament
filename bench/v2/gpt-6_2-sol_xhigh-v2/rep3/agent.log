{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -c 'for name in fast-link-lane fast-fetch-select; do\n  mkdir -p \"variants/$name/cores/bench\" &&\n  cp -r variants/fast-recover/cores/bench/rtl variants/fast-recover/cores/bench/test cores/bench/core.yaml \"variants/$name/cores/bench/\" &&\n  cp -r fpga \"variants/$name/\" &&\n  ln -s '\"'/srv/hwebench/tmp/5a1ea1b1/dacb2f47/predictor-r5-PTBzWH/bench' \\\"variants/\"'$name/bench\" &&\n  ln -s '\"'/srv/hwebench/tmp/5a1ea1b1/dacb2f47/predictor-r5-PTBzWH/test' \\\"variants/\"'$name/test\" || exit 1\ndone &&\npython3 - <<'\"'PY'\nfrom pathlib import Path\ndef patch(name,file,pairs):\n    p = Path('variants') / name / 'cores/bench/rtl' / file\n    s = p.read_text()\n    for old, new in pairs:\n        assert s.count(old) == 1, (file,old,s.count(old))\n        s = s.replace(old,new,1)\n    p.write_text(s)\npatch('fast-link-lane','ex_stage.sv',[\n    ('  ex_mem_t reg_q;', '''  ex_mem_t reg_q;\n  logic link_q, integer_result_q;\n  logic [31:0] link_pc_q;'''),\n    (\\\"      mul_high_q <= 1'b0;\\\", \\\"      mul_high_q <= 1'b0;\\\\n      link_q <= 1'b0;\\\\n      integer_result_q <= 1'b0;\\\"),\n    ('''      reg_q.alu_result    <= divide          ? div_result\n                           : in.ctrl.is_jump ? pc_plus_four\n                                             : alu_result;''', '''      reg_q.alu_result    <= divide ? div_result : alu_result;\n      link_q              <= in.ctrl.is_jump;\n      integer_result_q    <= \"'!(in.ctrl.is_jump || mul_low || mul_high);'\"'''),\n    ('    if (\"'!stall) product_q <= product;'\"', '''    if (\"'!stall) begin\n      product_q <= product;\n      link_pc_q <= pc_plus_four;\n    end'\"'''),\n    ('''    out.alu_result = ({32{\"'!(mul_low_q || mul_high_q)}} & reg_q.alu_result)\n                   | ({32{mul_low_q}} & product_q[31:0])\n                   | ({32{mul_high_q}} & product_q[63:32]);'\"''', '''    out.alu_result = ({32{integer_result_q}} & reg_q.alu_result)\n                   | ({32{link_q}} & link_pc_q)\n                   | ({32{mul_low_q}} & product_q[31:0])\n                   | ({32{mul_high_q}} & product_q[63:32]);'''),\n])\npatch('fast-fetch-select','if_stage.sv',[\n    ('''  logic [31:0] pc_plus_four;\n  assign pc_plus_four = imem_addr + 32'd4;\n\n  // A valid EX redirect takes priority over instruction-bus backpressure.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (\"'!stall)   pc <= prediction.predicted_taken ? predicted_target : pc_plus_four;\n    else if (redirect) pc <= redirect_target;\n  end'\"''', '''  logic [31:0] pc_plus_four, redirect_plus_four;\n  logic advance_prediction, advance_sequential, advance_recovery, hold_recovery;\n  assign redirect_plus_four = redirect_target + 32'd4;\n  assign pc_plus_four = pc + 32'd4;\n  assign advance_prediction = \"'!stall && prediction.predicted_taken;\n  assign advance_sequential = !stall && !prediction.predicted_taken && !redirect;\n  assign advance_recovery = !stall && !prediction.predicted_taken && redirect;\n  assign hold_recovery = stall && redirect;\n\n  always_ff @(posedge clock) begin\n    if (reset) pc <= RESET_PC;\n    else if (!stall || redirect)\n      pc <= ({32{advance_prediction}} & predicted_target)\n          | ({32{advance_sequential}} & pc_plus_four)\n          | ({32{advance_recovery}} & redirect_plus_four)\n          | ({32{hold_recovery}} & redirect_target);\n  end'\"'''),\n    ('predicted_target \"'!= pc_plus_four;'\"', 'predicted_target \"'!= (redirect ? redirect_plus_four : pc_plus_four);'\"'),\n])\nPY\nfor name in fast-link-lane fast-fetch-select; do\n    verilator --lint-only -Wall -Wno-MULTITOP -sv -Ivariants/\"'$name/cores/bench/rtl variants/$name/cores/bench/rtl/core_pkg.sv variants/$name/cores/bench/rtl/*.sv || exit 1\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
