{"type":"item.completed","item":{"id":"item_213","type":"command_execution","command":"/bin/bash -c 'cat \"$TMPDIR/bench-rtl-v7/imm_gen.sv\"'","aggregated_output":"// rtl/imm_gen.sv\n//\n// RV32I immediate generator. Sign-extends I/S/B/J immediates, zero-fills\n// the low bits of U immediates. Opcodes that don't carry an immediate\n// (R-type, FENCE, etc.) emit 0.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds the EX-stage immediate path (rd_wdata for ADDI,\n//                 mem_addr for LOAD/STORE, pc_wdata for branches/jumps).\nmodule imm_gen (\n  input  logic [31:0] instr,\n  output logic [31:0] imm\n);\n\n  logic [6:0] opcode;\n  logic use_i, use_s, use_b, use_u, use_j;\n\n  assign opcode = instr[6:0];\n  assign use_i = opcode == 7'h03 || opcode == 7'h13 || opcode == 7'h67 || opcode == 7'h73;\n  assign use_s = opcode == 7'h23;\n  assign use_b = opcode == 7'h63;\n  assign use_u = opcode == 7'h37 || opcode == 7'h17;\n  assign use_j = opcode == 7'h6f;\n\n  assign imm = ({32{use_i}} & {{20{instr[31]}}, instr[31:20]})\n             | ({32{use_s}} & {{20{instr[31]}}, instr[31:25], instr[11:7]})\n             | ({32{use_b}} & {{20{instr[31]}}, instr[7], instr[30:25], instr[11:8], 1'b0})\n             | ({32{use_u}} & {instr[31:12], 12'b0})\n             | ({32{use_j}} & {{12{instr[31]}}, instr[19:12], instr[20], instr[30:21], 1'b0});\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_214", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/mem_stage.sv'", "aggregated_output": "// rtl/mem_stage.sv\n//\n// Memory access stage. Drives the dmem read/write ports combinationally\n// from the EX/MEM register. Selects the extended load or EX result for\n// the MEM/WB register.\n//\n// Byte-lane discipline:\n//   - Write data is replicated across all four byte lanes; the\n//     byte-mask (mem_wmask) selects the actual destination bytes.\n//   - Load: shift the raw word right by `addr[1:0]*8`, then sign- or\n//     zero-extend the low 8/16 bits per the LB/LBU/LH/LHU encoding.\n//   - For RVFI ALIGNED_MEM, mem_addr is reported word-aligned and the\n//     byte position is captured in mem_rmask / mem_wmask.\n//\n// Latency:        1 cycle (MEM/WB register clocked here).\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata via the loaded-data path.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // hold_wb retains the previously retired producer's word for the held\n  // EX consumer. Clear valid while the dmem stall is in effect so:\n  //   - rvfi_order doesn't increment for held cycles\n  //   - wb_stage doesn't write the regfile twice\n  // Zeroing the whole register would lose the LOAD's load_data, breaking\n  // MEM/WB->EX forwarding for any dependent instruction that's also held\n  // in ID/EX during the stall (e.g. a BNE that consumes a LOAD's result).\n  input  logic               hold_wb,\n  input  ex_mem_t  in,\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  output logic               write_eligible,\n  // MEM/WB register output\n  output mem_wb_t  out\n);\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  // shifted[31:16] is dropped on byte/halfword loads; only [15:0] feeds\n  // the sign/zero-extension mux.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] shifted;\n  /* verilator lint_on UNUSEDSIGNAL \n…[3283 of 6355 chars elided by tools/bench/transcript.py; sha256:8b0e5134783783e1]…\n<= '0;\n    end else if (hold_wb) begin\n      // Clear valid (no double-retire / no double-regfile-write), but\n      // KEEP every other field. Forwarding from MEM/WB to a stalled\n      // dependent in ID/EX needs the held producer's rd/write_data/ctrl\n      // alive for as many cycles as the dmem stall lasts.\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.write_data <= write_data;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= dmem_rdata;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= dmem_wen;\n      reg_q.mem_rmask  <= dmem_ren ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
