{"type": "item.completed", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c \"cat formal/checks-deep.cfg; sed -n '185,267p' tools/eval/fpga.py; sed -n '168,235p' \\\"\"'$TMPDIR/bench-r10s1-baseline/cores/bench/generated/timing/gowin_p1/impl/pnr/core_bench.tr\"; sed -n '\"'1,125p' cores/bench/test/test_alu.py; sed -n '1,130p' /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep3/formal/riscv-formal/checks/rvfi_liveness_check.sv\"", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Substitutes M-ext mul/div/rem with\n# simpler XOR-of-add/sub formulas so bitwuzla solves them inside the\n# 20-step BMC budget (rvfi.rst §7.6 \"Alternative arithmetic operations\").\n#\n# IMPORTANT — what this DOES and DOES NOT prove:\n#   ✓ proves: M-ext bypassing, operand routing (rs1/rs2 -> unit -> rd),\n#             stall/forwarding behavior on mul/div, all I-base arithmetic\n#             and trap discipline.\n#   ✗ does NOT prove: the actual MUL/DIV/REM arithmetic is correct.\n#     The DUT and the spec both implement the same XOR substitute under\n#     this define, so a wrong real multiplier can still pass formal here.\n#\n# M-extension arithmetic correctness is covered separately by:\n#   1. test/test_alu.py — 30+ vectors per M-ext op, exact bit results.\n#   2. cosim against test/cosim/reference.py — every retired MUL/DIV/REM\n#      diff'd field-by-field.\n#   3. `make formal-deep` — same checks without ALTOPS. SLOW (~hours per\n#      M-ext check) but proves real arithmetic. Run periodically, not in\n#      the per-iteration orchestrator loop.\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\n# A vacuous suite (nothing ever retires) would fail this — no symbolic\n# trace can make rvfi_valid && !rvfi_trap go true.\nal\n…[12949 of 16021 chars elided by tools/bench/transcript.py; sha256:ff19fe80d38dd0dd]…\n OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n// WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN\n// ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\nmodule rvfi_liveness_check (\n\tinput clock, reset, trig, check,\n\t`RVFI_INPUTS\n);\n\t`rvformal_rand_const_reg [63:0] insn_order;\n\treg found_next_insn = 0;\n\n\tinteger channel_idx;\n\talways @(posedge clock) begin\n\t\tif (reset) begin\n\t\t\tfound_next_insn = 0;\n\t\tend else begin\n\t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n", "exit_code": 0, "status": "completed"}}
