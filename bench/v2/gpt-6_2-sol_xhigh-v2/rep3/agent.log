{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/profile.py' <<'PY'\nimport collections\nimport json\nimport sys\n\ncounts = collections.Counter()\nops = { 0x03: 'load', 0x13: 'alu_imm', 0x17:'auipc', 0x23: 'store', 0x33: 'alu_reg', 0x37: 'lui', 0x63: 'branch', 0x67: 'jalr', 0x6f: 'jal' }\nprev_load = 0\nstart, stop = map(int, sys.argv[1:])\nfor line in sys.stdin.buffer:\n    r = json.loads(line)\n    if not start <= r.get('cycle', 0) < stop:\n        continue\n    insn = r['insn']\n    op = insn & 0x7f\n    name = ops.get(op, 'other')\n    counts[name, 'retired'] += 1\n    rs1 = r['rs1_addr']\n    rs2 = r['rs2_addr']\n    if prev_load and prev_load in (rs1, rs2):\n        needs1 = rs1 == prev_load and name in ('load', 'alu_imm', 'store', 'alu_reg', 'branch', 'jalr')\n        needs2 = rs2 == prev_load and name in ('store', 'alu_reg', 'branch')\n        counts[name, { (False, True): 'rs2', (True, False): 'rs1', (True, True): 'both' }.get((needs1, needs2), 'false')] += 1\n    prev_load = r['rd_addr'] if name == 'load' else 0\nfor k,v in sorted(counts.items()):\n    print(k,v)\nPY\nreadarray -t bracket < <('/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/obj_dir/cosim_sim' '/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/sim/bench/programs/coremark.elf' 10000000 --bench --istall --dstall | tail -1 | python -c 'import sys,json; d=json.load(sys.stdin); print(d[\\\"bench_start_cycle\\\"]); print(d[\\\"bench_stop_cycle\\\"])')\n'/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/obj_dir/cosim_sim' '/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/sim/bench/programs/coremark.elf' 10000000 --istall --dstall | python '/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/profile.py' \\\"\"'${bracket[@]}\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
