ed-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[7209 of 10281 chars elided by tools/bench/transcript.py; sha256:b249bc0b49455991]…\nclones/gpt-6_2-sol_xhigh-v2-rep3/cores/bench/obj_dir/verilated_threads.d\n/srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep3/cores/bench/obj_dir/verilated.d\n/srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep3/cores/bench/obj_dir/cosim_sim\n8e2af32 log: hyp-20261121-003-r11s2 regression\nf2f4502 log: hyp-20261121-002-r11s1 regression\n8549080 log: hyp-20261121-001-r11s0 regression\n9d66550 log: hyp-20261121-003-r10s2 broken\n2aababd log: hyp-20261121-002-r10s1 regression\n73fece6 log: hyp-20261121-001-r10s0 regression\n108f2f2 log: hyp-20261121-003-r9s2 improvement\nbd7529e log: hyp-20261121-002-r9s1 regression\n07cbaac log: hyp-20261121-001-r9s0 regression\n36ae7a4 hyp-20261121-003-r9s2: Steer fetch early and validate target replay alongside decode (+7.9%)\n21953b5 log: hyp-20261121-003-r8s2 regression\n94e8383 log: hyp-20261121-002-r8s1 regression\ne34933e log: hyp-20261121-001-r8s0 regression\nd64b989 log: hyp-20261121-003-r7s2 regression\n4a46e5e log: hyp-20261121-002-r7s1 regression\n3123b4a log: hyp-20261121-001-r7s0 improvement\n", "exit_code": 0, "status": "completed"}}
