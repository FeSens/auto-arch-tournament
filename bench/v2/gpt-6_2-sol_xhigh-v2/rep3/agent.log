{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/prototype.py' <<'PY'\nfrom pathlib import Path\nimport sys\n\nroot = Path(sys.argv[1])\ndef edit(file, *pairs):\n    path = root / file\n    data = path.read_text()\n    for before, after in pairs:\n        assert data.count(before) == 1, (file, before, data.count(before))\n        data = data.replace(before, after)\n    path.write_text(data)\n\nedit('core_pkg.sv',\n    ('    logic [31:0] imm;', '    logic [4:0]  result_sel;\\\\n    logic [31:0] imm;'),\n    ('    logic [31:0] alu_result;    // EX result selected for forwarding and WB', '''    logic [4:0]  result_sel;\n    logic [31:0] add_result;\n    logic [31:0] sub_result;\n    logic [31:0] other_result;\n    logic [63:0] product;'''),\n    ('  // MEM/WB register payload', '''  function automatic [31:0] select_result(\n    input ex_mem_t producer,\n    input logic [4:0] sel\n  );\n    select_result = ({32{sel[0]}} & producer.add_result)\n                  | ({32{sel[1]}} & producer.sub_result)\n                  | ({32{sel[2]}} & producer.other_result)\n                  | ({32{sel[3]}} & producer.product[31:0])\n                  | ({32{sel[4]}} & producer.product[63:32]);\n  endfunction\n\n  // MEM/WB register payload'''))\n\nedit('id_stage.sv',\n    ('  id_ex_t reg_q;', '''  id_ex_t reg_q;\n  logic [4:0] result_sel;\n  assign result_sel[0] = dec_alu_op == ALU_ADD && \"'!dec_is_auipc && !dec_is_jump;\n  assign result_sel[1] = dec_alu_op == ALU_SUB;\n  assign result_sel[2] = !(result_sel[0] || result_sel[1] || result_sel[3] || result_sel[4]);\n  assign result_sel[3] = dec_alu_op == ALU_MUL;\n  assign result_sel[4] = dec_alu_op == ALU_MULH\n                      || dec_alu_op == ALU_MULHSU || dec_alu_op == ALU_MULHU;'\"'''),\n    ('      reg_q.imm          <= imm;', '      reg_q.imm          <= imm;\\\\n      reg_q.result_sel   <= result_sel;'))\n\nedit('alu.sv',\n    ('  output logic [31:0] out', '''  output logic [31:0] out,\n  output logic [31:0] add_result,\n  output logic [31:0] sub_result,\n  output logic [31:0] other_result'''),\n    ('  always_comb begin', '''  assign add_result = a + b;\n  assign sub_result = a - b;\n  assign out = op == ALU_ADD ? add_result\n             : op == ALU_SUB ? sub_result : other_result;\n\n  always_comb begin'''),\n    ('      ALU_ADD:    out = a + b;\\\\n      ALU_SUB:    out = a - b;\\\\n', ''))\npath = root / 'alu.sv'\npath.write_text(path.read_text().replace('    out =', '    other_result =').replace('default:  out =', 'default:  other_result ='))\n\nedit('forward_unit.sv',\n    ('  input  logic       ex_mem_w_en,', '  input  logic       ex_mem_w_en,\\\\n  input  logic [4:0] ex_mem_lanes,'),\n    ('  output logic [1:0] fwd_ex_mem_en,', '  output logic [4:0] fwd_ex_mem_rs1_en,\\\\n  output logic [4:0] fwd_ex_mem_rs2_en,'),\n    ('  logic [1:0] mem_wb_hit;', '  logic [1:0] mem_wb_hit, ex_mem_hit;'),\n    ('''  assign fwd_ex_mem_en   = ex_mem_match & {2{ex_mem_w_en}};\n  assign fwd_mem_wb_en   = mem_wb_hit & ~fwd_ex_mem_en;\n  assign fwd_reg_file_en = ~(fwd_ex_mem_en | mem_wb_hit);''',\n    '''  assign ex_mem_hit = ex_mem_match & {2{ex_mem_w_en}};\n  assign fwd_ex_mem_rs1_en = {5{ex_mem_hit[0]}} & ex_mem_lanes;\n  assign fwd_ex_mem_rs2_en = {5{ex_mem_hit[1]}} & ex_mem_lanes;\n  assign fwd_mem_wb_en = mem_wb_hit & ~ex_mem_hit;\n  assign fwd_reg_file_en = ~(ex_mem_hit | mem_wb_hit);'''))\n\nedit('ex_stage.sv',\n    ('  input  logic [1:0]         fwd_ex_mem_en,',\n     '  input  logic [4:0]         fwd_ex_mem_rs1_en,\\\\n  input  logic [4:0]         fwd_ex_mem_rs2_en,'),\n    ('  input  logic [31:0]        fwd_ex_mem,    // selected EX/MEM result\\\\n', ''),\n    ('({32{fwd_ex_mem_en[0]}}   & fwd_ex_mem)', 'select_result(reg_q, fwd_ex_mem_rs1_en)'),\n    ('({32{fwd_ex_mem_en[1]}}   & fwd_ex_mem)', 'select_result(reg_q, fwd_ex_mem_rs2_en)'),\n    ('''  assign alu_b = in.ctrl.alu_src ? in.imm : rs2;\n\n  logic [31:0] alu_result;''',\n     '''  logic rs2_is_reg;\n  assign rs2_is_reg = \"'!in.ctrl.alu_src;\n  assign alu_b = select_result(reg_q, fwd_ex_mem_rs2_en & {5{rs2_is_reg}})\n               | ({32{fwd_mem_wb_en[1] && rs2_is_reg}} & fwd_mem_wb)\n               | ({32{fwd_reg_file_en[1] && rs2_is_reg}} & in.rs2_val)\n               | ({32{!rs2_is_reg}} & in.imm);\n\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] alu_result;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:0] add_result, sub_result, other_result;'\"'''),\n    ('    .out (alu_result)', '''    .out          (alu_result),\n    .add_result   (add_result),\n    .sub_result   (sub_result),\n    .other_result (other_result)'''),\n    ('''  logic mul_low, mul_high;\n  logic mul_low_q, mul_high_q;\n  logic [63:0] product, product_q;\n\n  assign mul_low = in.ctrl.alu_op == ALU_MUL;\n  assign mul_high = in.ctrl.alu_op == ALU_MULH || in.ctrl.alu_op == ALU_MULHSU\n                 || in.ctrl.alu_op == ALU_MULHU;''', '  logic [63:0] product;'),\n    ('  ex_mem_t reg_q;\\\\n', ''),\n    ('  logic [31:0] rs2;', '  logic [31:0] rs2;\\\\n  ex_mem_t reg_q;'),\n    ('''      mul_low_q <= 1'b0;\n      mul_high_q <= 1'b0;\n''', ''),\n    ('''      reg_q.alu_result    <= ({32{select_alu}}       & alu_result)''',\n     '''      reg_q.result_sel    <= in.result_sel;\n      reg_q.add_result    <= add_result;\n      reg_q.sub_result    <= sub_result;\n      reg_q.other_result  <= ({32{select_alu}}       & other_result)'''),\n    ('''      mul_low_q           <= mul_low;\n      mul_high_q          <= mul_high;\n''', ''),\n    ('''    if (\"'!stall) product_q <= product;'\"''', '''    if (\"'!stall) reg_q.product <= product;'\"'''),\n    ('''  always_comb begin\n    out = reg_q;\n    out.alu_result = ({32{\"'!(mul_low_q || mul_high_q)}} & reg_q.alu_result)\n                   | ({32{mul_low_q}} & product_q[31:0])\n                   | ({32{mul_high_q}} & product_q[63:32]);\n  end'\"''', '  assign out = reg_q;'))\n\n# Keep product on a separate physical register signal as in the champion.\npath = root / 'ex_stage.sv'\ndata = path.read_text()\ndata = data.replace('  logic [63:0] product;', '  logic [63:0] product, product_q;')\ndata = data.replace('    if (\"'!stall) reg_q.product <= product;'\"', '    if (\"'!stall) product_q <= product;'\"')\ndata = data.replace('  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    out.product = product_q;\n  end''')\ndata = data.replace('select_result(reg_q,', 'select_result(out,')\npath.write_text(data)\n\nedit('mem_stage.sv',\n    ('in.ctrl.mem_to_reg ? load_data : in.alu_result',\n     'in.ctrl.mem_to_reg ? load_data : select_result(in, in.result_sel)'))\n\nedit('core.sv',\n    ('  logic [1:0] fwd_ex_mem_en, fwd_mem_wb_en, fwd_reg_file_en;',\n     '  logic [4:0] fwd_ex_mem_rs1_en, fwd_ex_mem_rs2_en;\\\\n  logic [1:0] fwd_mem_wb_en, fwd_reg_file_en;'),\n    ('''    .fwd_ex_mem_en   (fwd_ex_mem_en),\n    .fwd_mem_wb_en   (fwd_mem_wb_en),\n    .fwd_reg_file_en (fwd_reg_file_en),\n    .fwd_ex_mem      (ex_mem_w.alu_result),  // selected EX/MEM result''',\n     '''    .fwd_ex_mem_rs1_en (fwd_ex_mem_rs1_en),\n    .fwd_ex_mem_rs2_en (fwd_ex_mem_rs2_en),\n    .fwd_mem_wb_en   (fwd_mem_wb_en),\n    .fwd_reg_file_en (fwd_reg_file_en),'''),\n    ('''    .fwd_ex_mem_en   (fwd_ex_mem_en),''',\n     '''    .ex_mem_lanes    (ex_mem_w.result_sel),\n    .fwd_ex_mem_rs1_en (fwd_ex_mem_rs1_en),\n    .fwd_ex_mem_rs2_en (fwd_ex_mem_rs2_en),'''))\nPY\npython3 '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/prototype.py' '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/cores/bench/rtl'\nRTL_DIR='/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/cores/bench/rtl' OBJ_DIR='/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/obj_dir' NRET=1 bash test/cosim/build.sh\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
