{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, os\n\nstudy = Path(os.environ['TMPDIR'])/'r7s0-study'\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nrtl = study/'balanced'\nshutil.copytree(study/'addsub', rtl, dirs_exist_ok=True)\nupdate('core_pkg.sv',[\n    ('    logic add;\\\\n','    logic add;\\\\n    logic shift;\\\\n'),\n    ('    logic [31:0] add;\\\\n','    logic [31:0] add;\\\\n    logic [31:0] shift;\\\\n'),\n    ('    logic        subtract;\\\\n','    logic        subtract;\\\\n    logic        shift_left, shift_right, shift_arithmetic;\\\\n'),\n])\nupdate('id_stage.sv',[\n    (\\\"          ALU_ADD, ALU_SUB:             result_sel.add      = 1'b1;\\\", \\\"          ALU_ADD, ALU_SUB:             result_sel.add      = 1'b1;\\\\n          ALU_SLL, ALU_SRL, ALU_SRA:    result_sel.shift    = 1'b1;\\\"),\n    ('      reg_q.subtract     <= dec_alu_op == ALU_SUB;', '''      reg_q.subtract     <= dec_alu_op == ALU_SUB;\n      reg_q.shift_left   <= dec_alu_op == ALU_SLL;\n      reg_q.shift_right  <= dec_alu_op == ALU_SRL || dec_alu_op == ALU_SRA;\n      reg_q.shift_arithmetic <= dec_alu_op == ALU_SRA;''')\n])\nshutil.copyfile(study/'shift'/'alu.sv',rtl/'alu.sv')\nupdate('ex_stage.sv',[\n    ('                    | ({32{sel.ex_mem.other}}    & reg_q.result.other)', '                    | ({32{sel.ex_mem.shift}}    & reg_q.result.shift)\\\\n                    | ({32{sel.ex_mem.other}}    & reg_q.result.other)'),\n    ('  alu u_alu (','''  logic signed [32:0] shift_right_result;\n  logic [31:0] shift_left_result;\n  assign shift_right_result = \"'$signed({in.shift_arithmetic && rs1[31], rs1}) >>> alu_b[4:0];\n  assign shift_left_result = rs1 << alu_b[4:0];\n\n  alu #(.EXTERNAL_SHIFT(1)) u_alu ('\"'''),\n    ('      reg_q.result.add    <= sum;', '''      reg_q.result.add    <= sum;\n      reg_q.result.shift  <= ({32{in.shift_left}} & shift_left_result)\n                           | ({32{in.shift_right}} & shift_right_result[31:0]);''')\n])\nupdate('mem_stage.sv', [\n    ('                    | ({32{in.result_sel.other}}    & in.result.other)', '                    | ({32{in.result_sel.shift}}    & in.result.shift)\\\\n                    | ({32{in.result_sel.other}}    & in.result.other)'),\n])\n\nrtl = study/'flat'\nshutil.copytree(study/'preselect', rtl, dirs_exist_ok=True)\nupdate('core_pkg.sv', [\n    ('  // ID/EX register payload.', '''  typedef struct packed {\n    logic bit_and, bit_or, bit_xor, lt, lt_signed;\n    logic shift_l, shift_r, shift_arithmetic, imm;\n  } alu_sel_t;\n\n  // ID/EX register payload.'''),\n    ('    branch_sel_t branch_sel;\\\\n','    branch_sel_t branch_sel;\\\\n    alu_sel_t    alu_sel;\\\\n    logic        is_divide;\\\\n'),\n])\nupdate('id_stage.sv', [\n    ('      reg_q.branch_sel   <= branch_sel;', '''      reg_q.branch_sel   <= branch_sel;\n      reg_q.alu_sel.bit_and <= dec_alu_op == ALU_AND;\n      reg_q.alu_sel.bit_or  <= dec_alu_op == ALU_OR;\n      reg_q.alu_sel.bit_xor <= dec_alu_op == ALU_XOR;\n      reg_q.alu_sel.lt <= dec_alu_op == ALU_SLT || dec_alu_op == ALU_SLTU;\n      reg_q.alu_sel.lt_signed <= dec_alu_op == ALU_SLT;\n      reg_q.alu_sel.shift_l <= dec_alu_op == ALU_SLL;\n      reg_q.alu_sel.shift_r <= dec_alu_op == ALU_SRL || dec_alu_op == ALU_SRA;\n      reg_q.alu_sel.shift_arithmetic <= dec_alu_op == ALU_SRA;\n      reg_q.alu_sel.imm <= dec_alu_op == ALU_LUI;\n      reg_q.is_divide <= dec_alu_op == ALU_DIV || dec_alu_op == ALU_DIVU\n                      || dec_alu_op == ALU_REM || dec_alu_op == ALU_REMU;''')\n])\nupdate('ex_stage.sv', [\n    ('''  logic [31:0] add_result, sub_result, other_result, unused_alu_result;\n  alu u_alu (\n    .op           (in.ctrl.alu_op),\n    .a            (rs1),\n    .b            (alu_b),\n    .out          (unused_alu_result),\n    .add_result   (add_result),\n    .sub_result   (sub_result),\n    .other_result (other_result)\n  );''',\n     '''  logic [31:0] add_result, sub_result, shift_left;\n  logic signed [32:0] shift_right;\n  logic alu_less;\n  logic [31:0] other_result;\n  assign add_result = rs1 + alu_b;\n  assign sub_result = rs1 - alu_b;\n  assign shift_left = rs1 << alu_b[4:0];\n  assign shift_right = \"'$signed({in.alu_sel.shift_arithmetic && rs1[31], rs1}) >>> alu_b[4:0];\n  assign alu_less = (rs1 < alu_b) ''^ (in.alu_sel.lt_signed && (rs1[31] != alu_b[31]));\n  assign other_result = ({32{in.alu_sel.bit_and}} & (rs1 & alu_b))\n                      | ({32{in.alu_sel.bit_or}}  & (rs1 | alu_b))\n                      | ({32{in.alu_sel.bit_xor}} & (rs1 ''^ alu_b))\n                      | {31'\"'b0, in.alu_sel.lt && alu_less}\n                      | ({32{in.alu_sel.shift_l}} & shift_left)\n                      | ({32{in.alu_sel.shift_r}} & shift_right[31:0])\n                      | ({32{in.alu_sel.imm}}     & alu_b);'''),\n    ('''  assign divide = in.valid && (in.ctrl.alu_op == ALU_DIV || in.ctrl.alu_op == ALU_DIVU\n                           || in.ctrl.alu_op == ALU_REM || in.ctrl.alu_op == ALU_REMU);''',\n     '  assign divide = in.valid && in.is_divide;')\n])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/r7s0-study/synth.py\" flat'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
