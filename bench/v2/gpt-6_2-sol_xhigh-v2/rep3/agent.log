t = 0;\n        return entry.count > 0;\n    };\n    for (unsigned c = 0; c < 8000000; ++c) {\n        bool ir = stall.ready(), dr = stall.ready();\n        bool hold = m && m->mem() && !dr;\n        const Event* update = hold ? nullptr : m;\n        if (update) {\n            auto at = unsigned(update - events.data());\n            if (at == start_index) {\n                start = c;\n                redirect_count = replays = words = discarded = starvation = 0;\n            }\n            if (at == stop_index) {\n                std::cout << \"L \" << length << \" credits \" << depth << \" entries \" << entries\n                          << \" staged \" << staged << \" fast repair \" << fast_repair << \" cycles \" << c-start\n                          << \" repairs \" << redirect_count << \" hits \" << replays << \" words \" << words\n                          << \" discarded sequential reads \" << discarded << \" starvation \" << starvation << \"'\"\\\\n\\\";\n                return;\n            }\n        }\n        if (repair && hold) continue;\n        bool repairing = repair;\n        bool can_move = \"'!hold && !div;\n        if (!hold && div) --div;\n        repair = false;\n        if (can_move && !repairing && x && x->next != x_prediction) {\n            repair_addr = x->next;\n            repair = true;\n            ++redirect_count;\n        }\n\n        // Credits are determined before ID consumes a queue entry.\n        bool credit = queue.size() + response.valid < depth;\n        if (repairing) {\n            queue.clear();\n            response.valid = false;\n            fetch = repair_addr;\n            if (ir && fast_repair) {\n                queue.push_back(Packet{fetch, Entry{}});\n                fetch += 4;\n                credit = false;\n            } else {\n                credit = true;\n            }\n        } else if (can_move && !repair) {\n            const Event* fresh = nullptr;\n            if (!queue.empty()) {\n                auto& packet = queue.front();\n                auto& entry = packet.prediction;\n                unsigned lane = packet.consumed;\n                uint32_t pc = lane == 0 ? packet.pc : entry.target + 4 * (lane-1);\n                if (!x || !x->hazard(instr(pc))) {\n                    auto &candidate = events.at(nxt++);\n                    if (pc != candidate.pc) {\n                        std::cerr << \"Candidate \" << nxt-1 << \" mismatches \" << pc << \" vs \" << candidate.pc << \"'\"\\\\n\\\";\n                        std::exit(4);\n                    }\n                    if (lane == 0 && entry.count) {\n                        ++replays;\n                        words += entry.count;\n                    }\n                    x_prediction = lane == 0 && entry.count ? entry.target : pc + 4;\n                    fresh = &candidate;\n                    if (++packet.consumed > entry.count) queue.pop_front();\n                }\n            } else {\n                ++starvation;\n            }\n            m = x;\n            x = fresh;\n            if (x && x->divide()) div = 8;\n        } else if (\"'!hold) {\n            m = can_move && !repairing ? x : nullptr;\n            if (can_move) x = nullptr;\n        }\n\n        if (response.valid) {\n            auto& packet = response.packet;\n            bool hit = classify(packet);\n            queue.push_back(packet);\n            response.valid = false;\n            if (hit) {\n                fetch = packet.prediction.target + 4 * packet.prediction.count;\n                if (credit && ir) ++discarded;\n                credit = false;\n            }\n        }\n        if (credit && ir) {\n            auto packet = capture(fetch);\n            if (staged) {\n                response = Response{packet, true};\n                fetch += 4;\n            } else {\n                bool hit = classify(packet);\n                queue.push_back(packet);\n                fetch = hit ? packet.prediction.target + 4 * packet.prediction.count : fetch + 4;\n            }\n        }\n\n        // Known prefix lengths model the eventual contents after collection.\n        // Apply new entries only once their last replay word reaches MEM/WB.\n        if (!update) continue;\n        auto at = unsigned(update - events.data());\n        if (update->direct() && !update->jumps()) {\n            auto& entry = table[index(update->pc)];\n            if (entry.pc == update->pc && entry.insn == update->insn && entry.ctr) --entry.ctr;\n        }\n        for (unsigned span = 1; span <= length && span <= at; ++span) {\n            auto &branch = events.at(at-span);\n            if (!branch.direct() || !branch.jumps() || branch.next != events.at(at-span+1).pc) continue;\n            bool clean = true;\n            for (unsigned step = 1; step <= span; ++step) {\n                auto &w = events.at(at-span+step);\n                if (w.direct() || w.indirect() || w.op() == 0xf || w.op() == 0x73 || w.pc != branch.next + 4*(step-1)) clean = false;\n            }\n            if (!clean) continue;\n            if (span < length && at+1 < events.size()) {\n                auto& following = events[at+1];\n                if (!following.direct() && !following.indirect() && following.op() != 0xf &&\n                    following.op() != 0x73 && following.pc == update->pc + 4) continue;\n            }\n            auto& entry = table[index(branch.pc)];\n            unsigned ctr = branch.op() == 0x6f ? 3 : 2;\n            if (entry.pc == branch.pc && entry.insn == branch.insn) ctr = std::min(3u, entry.ctr+1);\n            entry = {branch.pc, branch.insn, branch.next, span, ctr};\n        }\n    }\n    std::cerr << \"Timeout'\"\\\\n\\\";\n    std::exit(5);\n}\n\nint main(int argc, char **argv) {\n    assert(argc == 4);\n    std::ifstream file(argv[1], std::ios::binary);\n    Event e;\n    while (file.read(reinterpret_cast<char*>(&e), sizeof(e))) {\n        if (e.cycle == std::strtoul(argv[2], nullptr, 1