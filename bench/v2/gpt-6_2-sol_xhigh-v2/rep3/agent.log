{"type": "item.started", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/bash -c 'cat > \"${TMPDIR:-/tmp}/bench-r12s1-predecode.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nimport shutil\n\nroot = Path(os.environ['TMPDIR'])\n\ndef make_variant(base, name, merge_repair, conservative):\n    new = root / f'bench-r12s1-{name}'\n    shutil.copytree(root / f'bench-r12s1-{base}', new, dirs_exist_ok=True)\n\n    def rewrite(file, *edits):\n        p = new / f'{file}.sv'\n        src = p.read_text()\n        for old, text in edits:\n            assert src.count(old) == 1, f'{file}: {old}: {src.count(old)} matches'\n            src = src.replace(old, text)\n        p.write_text(src)\n\n    rewrite('core_pkg',\n        ('    logic        synthetic;\\\\n', '''    logic        synthetic;\n    logic [1:0]  pair_class;\n'''))\n    rewrite('id_stage',\n        ('  assign pair_offset_two = imm == 32\\\\'d2;', '  assign pair_offset_two = instr[21];'),\n        (\\\"\\\"\\\"  assign pair_load = pair_rs1 && ex_lw && dec_mem_read\n                    && (imm == 32'd0 || pair_offset_two);\\\"\\\"\\\",\n         '  assign pair_load = pair_rs1 && ex_lw && \"'!in.synthetic && in.pair_class[0];'\"'),\n        ('pair_rs1 && (branch_sel.eq || branch_sel.ne)', 'pair_rs1 && \"'!in.synthetic && in.pair_class[1]'\"'))\n    if conservative and base \"'!= '\"'separate':\n        rewrite('id_stage', ('&& (pair_rs2 || \"'!mem_hit[1]);'\"', \\\"&& (pair_rs2 || rs2_addr == 5'd0 || rs2_addr \"'!= mem_rd);\"))\n    rewrite('\"'if_stage',\n        ('  logic [4:0] occupancy_q;', '''  function automatic [1:0] predecode_pair(input logic [31:0] word);\n    predecode_pair[1] = word[6:0] == 7'h63 && word[14:13] == 2'b00;\n    predecode_pair[0] = word[6:0] == 7'h03\n                      && {word[31:22], word[20]} == 11'b0\n                      && (word[14] ? \"'!word[13] : (word[13:12] != 2'\"'b11));\n  endfunction\n\n  logic [4:0] occupancy_q;'''),\n        ('  logic [3:0] synthetic_q;', '''  (* mem2reg, syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] bus_class [0:3];\n  logic [1:0] issue_class_q;\n  logic [3:0] synthetic_q;'''),\n        ('      bus_words[write_slot] <= imem_data;', '''      bus_words[write_slot] <= imem_data;\n      bus_class[write_slot] <= predecode_pair(imem_data);'''),\n        ('  logic [31:0] head_replay_word [0:3];', '''  logic [31:0] head_replay_word [0:3];\n  logic [1:0] head_replay_class [0:3];'''),\n        ('    always_ff @(posedge clock) begin\\\\n      if (install) words[write_index]', '''    (* mem2reg, syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] slot_class [0:3];\n\n    always_ff @(posedge clock) begin\n      if (response) slot_class[write_slot] <= predecode_pair(words[fetch_index]);\n      if (install) words[write_index]'''),\n        ('    assign head_replay_word[lane] = slot_word[head_q];', '''    assign head_replay_word[lane] = slot_word[head_q];\n    assign head_replay_class[lane] = slot_class[head_q];'''),\n        ('  assign out.instr = issue_word_q;', '''  assign out.instr = issue_word_q;\n  assign out.pair_class = issue_class_q;'''),\n        ('  logic [31:0] next_replay_word;', '''  logic [31:0] next_replay_word;\n  logic [1:0] next_replay_class;\n  assign next_replay_class = ({2{lane_q[0]}} & head_replay_class[0])\n                           | ({2{lane_q[1]}} & head_replay_class[1])\n                           | ({2{lane_q[2]}} & head_replay_class[2])\n                           | ({2{lane_q[3]}} & head_replay_class[3]);'''),\n        ('      issue_synthetic_q <=', '''      issue_class_q <= ({2{use_response}} & predecode_pair(imem_data))\n                     | ({2{use_queued_bus}} & bus_class[next_head])\n                     | ({2{use_replay}} & next_replay_class);\n      issue_synthetic_q <='''))\n\n    if merge_repair:\n        rewrite('ex_stage',\n            ('  logic true_mismatch, false_mismatch, repair_branch;', '''  logic true_mismatch, false_mismatch, repair_branch, un