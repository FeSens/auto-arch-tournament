{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c \"set -e\nmkdir -p '/srv/hwebench/tmp/5a1ea1b1/06662a0c/bench-r14-address.ufOiuz2Z/late-alu'\ncp -R cores/bench/rtl '/srv/hwebench/tmp/5a1ea1b1/06662a0c/bench-r14-address.ufOiuz2Z/late-alu/rtl'\ncat > '/srv/hwebench/tmp/5a1ea1b1/06662a0c/bench-r14-address.ufOiuz2Z/late-alu/prototype.py' <<'PY'\nfrom pathlib import Path\nimport sys\n\nroot = Path(sys.argv[1])\nmode = sys.argv[2]\ndef replace(name, replacements):\n    path = root / name\n    content = path.read_text()\n    for old, new in replacements:\n        assert content.count(old) == 1, (name, old)\n        content = content.replace(old, new)\n    path.write_text(content)\n\nreplace('core_pkg.sv', [\n    ('    logic        divide;', '    logic        divide;\\\\n    logic        late_alu;'),\n    ('    logic [31:0] mem_addr;      // effective byte address',\n     '''    logic        late_alu;\n    logic [31:0] late_a;\n    logic [31:0] late_b;\n    logic [31:0] mem_addr;      // effective byte address''')\n])\nreplace('ex_stage.sv', [\n    ('ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read;'\"', 'ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read && !in.late_alu;'\"'),\n    ('      reg_q.result.other  <= other_result', '      reg_q.result.other  <= ({32{\"'!in.late_alu}} & other_result)'\"'),\n    ('      reg_q.result.product <= product;', '''      reg_q.result.product <= product;\n      reg_q.late_alu      <= in.late_alu;\n      reg_q.late_a        <= rs1;\n      reg_q.late_b        <= alu_b;'''),\n])\nif mode == 'all':\n    replace('ex_stage.sv', [\n        ('''  logic [31:0] add_result, sub_result, other_result, unused_alu_result;\n  alu u_alu (\n    .op           (in.ctrl.alu_op),\n    .a            (rs1),\n    .b            (alu_b),\n    .out          (unused_alu_result),\n    .add_result   (add_result),\n    .sub_result   (sub_result),\n    .other_result (other_result)\n  );''',\n         '''  logic [31:0