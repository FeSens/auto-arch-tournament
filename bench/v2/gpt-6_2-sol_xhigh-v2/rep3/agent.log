{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"sed -n '65,150p' cores/bench/rtl/ex_stage.sv && sed -n '65,115p' cores/bench/rtl/hazard_unit.sv && rg -n 'ram_style|syn_ramstyle' /opt/gowin/IDE -g '*.sv' -g '*.v' -m 5\"", "aggregated_output": "  logic [31:0] div_result, div_src_a, div_src_b;\n\n  assign divide = in.valid && (in.ctrl.alu_op == ALU_DIV || in.ctrl.alu_op == ALU_DIVU\n                           || in.ctrl.alu_op == ALU_REM || in.ctrl.alu_op == ALU_REMU);\n  assign divide_wait = divide && !div_result_valid;\n\n  div_unit u_div (\n    .clock        (clock),\n    .reset        (reset),\n    .issue        (divide && div_issue_ready && !stall),\n    .issue_ready  (div_issue_ready),\n    .op           (in.ctrl.alu_op),\n    .a            (rs1),\n    .b            (rs2),\n    .result_valid (div_result_valid),\n    .result_ready (divide && !stall),\n    .result       (div_result),\n    .src_a        (div_src_a),\n    .src_b        (div_src_b)\n  );\n\n  // ── Branch resolve ────────────────────────────────────────────────────\n  logic        branch_cond;\n  logic        branch_taken;\n  logic [31:0] branch_target;\n  logic [31:0] jump_target;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 != rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'b0;\n    endcase\n    branch_taken  = in.ctrl.is_branch && branch_cond;\n    branch_target = in.pc + in.imm;\n    // JALR clears bit 0 (RV spec); JAL uses imm directly.\n    jalr_sum    = rs1 + in.imm;\n    jump_target = in.ctrl.is_ja