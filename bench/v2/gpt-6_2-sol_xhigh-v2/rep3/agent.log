                  | '.join(f'({{32{{lane_q[{k}]}}}} & head_replay_word[{k}])' for k in range(n))+';\\\\n'+s[j:]\n    p.write_text(s)\nPY\nprintf '%s\\\\n' term_len6 term_len8 term_len12 term_len16 base_len8 term_stage term_dual term_both | xargs -P 5 -I {} bash \\\"\"'$scratch_dir/simulate.sh\" \"$scratch_dir\" \"$PWD\" {}\npython3 - \"$scratch_dir\" <<'\"'PY'\nimport sys,json\nfrom pathlib import Path\nfor p in sorted(Path(sys.argv[1]).glob('*bench.log')):\n    d=json.loads(p.read_text().splitlines()[-1])\n    print(p.stem, d['bench_stop_cycle']-d['bench_start_cycle'], 'validated' in d['uart'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
