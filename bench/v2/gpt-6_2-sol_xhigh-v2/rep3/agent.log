it signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef LUI (rd, imm):       return (imm & 0xFFFFF000) | (rd << 7) | 0b0110111\ndef AUIPC(rd, imm):      r\n…[16357 of 19429 chars elided by tools/bench/transcript.py; sha256:a3be4ba35146e665]…\nK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n744:    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n748:async def rvfi_order_strictly_monotonic(dut):\n749:    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n764:    branch = BEQ(1, 0, 0x40)\n766:        0: branch,\n774:        0x800: branch,  # Same short tag, index, and instruction. Now not taken.\n832:    rets, _ = await _run(dut, program, imem_stalls={(0x50, 1): 10}, fetch_trace=fetches,\n865:    dmem = dict(zip(range(0, 20, 4), [0, 0, 1, 1, 1]))\n866:    rets, _ = await _run(dut, program, dmem, fetch_trace=fetches,\n883:    branch = BEQ(0, 0, 0x40)\n886:        0: branch,\n894:        0x800: branch,  # Accepted concurrently with EX resolving the older JAL.\n900:    rets, _ = await _run(dut, program, imem_stalls={0x900: correction_wait},\n951:                         stop_on_trap=True, fetch_trace=fetches)\n956:    assert [(r[\"trap\"], r[\"rd_wdata\"]) for r in rets] == [(0, 4), (0, 5), (1, 0)]\n", "exit_code": 0, "status": "completed"}}
