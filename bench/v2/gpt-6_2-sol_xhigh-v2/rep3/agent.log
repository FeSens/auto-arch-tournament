{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, os\n\nstudy = Path(os.environ['TMPDIR'])/'r7s0-study'\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nrtl = study/'loadfwd'\nshutil.copytree('cores/bench/rtl', rtl, dirs_exist_ok=True)\nupdate('core_pkg.sv', [\n    ('    logic        mem_wb;\\\\n','    logic        mem_wb;\\\\n    logic        mem_load;\\\\n'),\n])\nupdate('core.sv', [\n    ('  logic       ex_write_eligible, mem_write_eligible;', '  logic       ex_write_eligible, mem_write_eligible;\\\\n  logic       ex_fast_load;\\\\n  logic [31:0] mem_load_data;'),\n    ('    .ex_write_eligible  (ex_write_eligible),','    .ex_write_eligible  (ex_write_eligible),\\\\n    .ex_fast_load       (ex_fast_load),'),\n    ('    .fwd_mem_wb      (mem_wb_w.write_data),','    .fwd_mem_wb      (mem_wb_w.write_data),\\\\n    .fwd_mem_load    (mem_load_data),\\\\n    .fast_load       (ex_fast_load),'),\n    ('    .write_eligible (mem_write_eligible),','    .write_eligible (mem_write_eligible),\\\\n    .load_forward_data (mem_load_data),'),\n    ('(id_ex_w.valid && id_ex_w.ctrl.mem_read),','(id_ex_w.valid && id_ex_w.ctrl.mem_read && \"'!ex_fast_load),'\"')\n])\nupdate('id_stage.sv', [\n    ('  input  logic              ex_write_eligible,','  input  logic              ex_write_eligible,\\\\n  input  logic              ex_fast_load,'),\n    ('& {2{ex_write_eligible && ex_rd \"'!= 5'\"\\\\'d0}};', '& {2{(ex_write_eligible || ex_fast_load) && ex_rd \"'!= 5'\"\\\\'d0}};'),\n    ('  assign rs1_sel.mem_wb', '  assign rs1_sel.mem_load = ex_hit[0] && ex_fast_load;\\\\n  assign rs2_sel.mem_load = ex_hit[1] && ex_fast_load;\\\\n  assign rs1_sel.mem_wb')\n])\nupdate('ex_stage.sv', [\n    ('  output e