read_text()\n        c=c.replace('  logic       divide_wait;','  logic       divide_wait, load_match;')\n        c=c.replace('    .out             (if_id_w)', '    .load_rd         (id_ex_w.rd),\\\\n    .match_head      (load_match),\\\\n    .out             (if_id_w)')\n        c=c.replace('''    .if_id_rs1      (if_id_w.instr[19:15]),\n    .if_id_rs2      (if_id_w.instr[24:20]),''','''    .load_match     (load_match),''')\n        c=c.replace('    .imem_ready     (if_id_w.valid),\\\\n    .dmem_ready', '    .dmem_ready')\n        g.write_text(c)\n        g=rtl/'hazard_unit.sv'\n        c=g.read_text()\n        c=c.replace('''  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)''','''  input  logic       load_match,''')\n        c=c.replace('  input  logic       imem_ready,\\\\n','')\n        c=c.replace('''id_ex_mem_read && imem_ready\n                   && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2)''','''id_ex_mem_read && load_match''')\n        g.write_text(c)\n    f.write_text(s)\nPY\npython '/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN/prefetchctrl.py'\npython -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nbase=Path.cwd()\ns=Path('/srv/hwebench/tmp/5a1ea1b1/6c376096/bench-r6-timing.p7cteN')\ndef run(v):\n r=build_all(base,s/(v+'_rtl'),'fpga/core_bench_si.sv',s/(v+'_timing'))\n print(v,summarize(r),flush=True)\n for x in r:\n  print(v,x['place_option'],x.get('critical_paths', [None])[0],flush=True)\nwith ThreadPoolExecutor(max_workers=3) as pool:\n for _ in pool.map(run, ('earlyopcode','earlyhazard','earlyboth')): pass\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
