e u_rf (\n    .clock    (clock),\n    .reset    (reset),\n    .rs1_addr (rs1_addr_w),\n    .rs2_addr (rs2_addr_w),\n    .rs1_data (rs1_data_w),\n    .rs2_data (rs2_data_w),\n    .w_en     (wb_w_en),\n    .w_addr   (wb_w_addr),\n    .w_data   (wb_w_data)\n  );\n\n  // ── EX ────────────────────────────────────────────────────────────────\n  ex_st\n…[5686 of 8758 chars elided by tools/bench/transcript.py; sha256:642af97b6cf12020]…\nposedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n      mul_low_q <= 1'b0;\n      mul_high_q <= 1'b0;\n    end else if (!stall) begin\n      reg_q.pc            <= in.pc;\n      // JAL/JALR write the return address. Loads use the MEM/WB read data.\n      reg_q.alu_result    <= divide          ? div_result\n                           : in.ctrl.is_jump ? pc_plus_four\n                                             : alu_result;\n      reg_q.mem_addr      <= effective_addr;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= divide ? div_src_a : rs1;\n      reg_q.rs2_val       <= divide ? div_src_b : rs2;\n      reg_q.pc_next       <= redirect ? redirect_target : pc_plus_four;\n      // Bubbles have no forwarding, writeback, or memory side effects.\n      reg_q.ctrl          <= ex_valid ? ctrl_with_trap : '0;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= ex_valid;\n", "exit_code": 0, "status": "completed"}}
