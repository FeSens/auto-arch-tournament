{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom tools.eval.gowin import build_all\n\nscratch = Path('/srv/hwebench/tmp/5a1ea1b1/e19c4c92/bench-r10s0-vu6d70fw')\n\ndef variant(name, group):\n rtl = scratch / name / 'rtl'\n shutil.copytree(scratch / 'local_repair' / 'rtl', rtl)\n p=rtl/'if_stage.sv'\n s=p.read_text()\n def edit(a,b):\n  nonlocal s\n  assert s.count(a)==1,a\n  s=s.replace(a,b)\n edit('logic guess_q, checked_hit, head_guess, reject, predicted_taken;',\n      'logic guess_q, exact_match, checked_hit, head_guess, reject, predicted_taken;')\n if group:\n  edit('  assign checked_hit = guess_q && checked_tag_q == response_tag_q\\\\n                     && checked_source_q == response_word_q;',\n '''  (* syn_keep = 1 *) logic [15:0] word_match;\n  (* syn_keep = 1 *) logic [5:0] tag_match;\n  for (genvar subword = 0; subword < 16; subword++) begin : gen_match_word\n    assign word_match[subword] = checked_source_q[2*subword +: 2] == response_word_q[2*subword +: 2];\n  end\n  for (genvar subtag = 0; subtag < 6; subtag++) begin : gen_match_tag\n    assign tag_match[subtag] = checked_tag_q[7+2*subtag +: 2] == response_tag_q[7+2*subtag +: 2];\n  end\n  assign exact_match = (&word_match) && (&tag_match) && (checked_tag_q[19] == response_tag_q[19]);\n  assign checked_hit = guess_q && exact_match;''')\n else:\n  edit('  assign checked_hit = guess_q && checked_tag_q == response_tag_q\\\\n                     && checked_source_q == response_word_q;',\n       '''  assign exact_match = checked_tag_q == response_tag_q && checked_source_q == response_word_q;\n  assign checked_hit = guess_q && exact_match;''')\n edit('assign normal_reject = guess_q && \"'!checked_hit;'\"', 'assign normal_reject = guess_q && \"'!exact_match;'\"')\n p.write_text(s)\n return rtl\n\nnames = ['keep_validation', 'exact_credits']\nwith ThreadPoolExecutor(max_workers=2) as executor:\n jobs=[executor.submit(build_all, Path.cwd(), variant(name, group), 'fpga/core_bench_si.sv', scratch/name)\n       for name,group in zip(names,[True,False])]\n for name,job in zip(names,jobs):\n  for r in job.result():\n   print(name, r['place_option'], r['fmax_mhz'], r.get('critical_paths', [])[:3], r.get('reason', ''), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
