{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/wb.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nroot=Path(sys.argv[1])\nbase=Path('cores/bench/rtl')\ndef variant(name, rm_mul=False):\n    origin=base if not rm_mul else root/'mem_mul_pair/rtl'\n    target=root/name/'rtl'\n    copytree(origin,target,dirs_exist_ok=True)\n    types=(target/'core_pkg.sv').read_text()\n    core=(target/'core.sv').read_text()\n    ident=(target/'id_stage.sv').read_text()\n    ex=(target/'ex_stage.sv').read_text()\n    mem=(target/'mem_stage.sv').read_text()\n    types=types.replace('    logic        mem_wb;\\\\n', '')\n    core=core.replace('  logic [31:0] wb_w_data;', '  logic [31:0] wb_w_data, mem_write_data;')\n    core=core.replace('    .mem_write_eligible (mem_write_eligible),', '    .mem_write_eligible (mem_write_eligible),\\\\n    .mem_write_data     (mem_write_data),')\n    core=core.replace('    .fwd_mem_wb      (mem_wb_w.write_data),\\\\n','')\n    core=core.replace('    .write_eligible (mem_write_eligible),', '    .write_eligible (mem_write_eligible),\\\\n    .write_data     (mem_write_data),')\n    ident=ident.replace('  input  logic        mem_write_eligible,', '  input  logic        mem_write_eligible,\\\\n  input  logic [31:0] mem_write_data,')\n    for i in (1,2):\n        ident=ident.replace(f'  assign rs{i}_sel.mem_wb = mem_hit[{i-1}] && \"'!ex_hit[{i-1}];'\"\\\\n', '')\n        ident=ident.replace(f\\\"  assign rs{i}_default = (ex_hit[{i-1}] || mem_hit[{i-1}]) ? '0 : rs{i}_data;\\\",f'''  assign rs{i}_default = ({{32{{\"'!ex_hit[{i-1}] && mem_hit[{i-1}]}}}} & mem_write_data)\n                      | ({{32{{!ex_hit[{i-1}] && !mem_hit[{i-1}]}}}} & rs{i}_data);'\"''')\n    ex=ex.replace('  input  logic [31:0]        fwd_mem_wb,    // selected MEM/WB writeback word\\\\n','')\n    ex=ex.replace('    other_wb = ({32{sel.ex_mem.other}}    & reg_q.result.other)\\\\n             | ({32{sel.mem_wb}}          & fwd_mem_wb);', '    other_wb = ({32{sel.ex_mem.other}}    & reg_q.result.other);')\n    mem=mem.replace('  output logic               write_eligible,', '  output logic               write_eligible,\\\\n  output logic [31:0]        write_data,').replace('  logic [31:0] write_data;\\\\n','')\n    for file, source in [('core_pkg.sv',types),('core.sv',core),('id_stage.sv',ident),('ex_stage.sv',ex),('mem_stage.sv',mem)]:\n        (target/file).write_text(source)\nvariant('mem_capture')\nvariant('mem_capture_m')\nPY\npython \\\"\"'$probe/wb.py\" \"$probe\"\nfor variant in mem_capture mem_capture_m; do\n  PYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/$variant\" > \"$probe/$variant/out.log\" 2>&1 &\ndone\nwait\nfor variant in mem_capture mem_capture_m; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  cat \"$probe/$variant/out.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
