{"type": "item.started", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c 'hyp_scratch=\"$(mktemp -d \"$TMPDIR/hyp-r4s1.XXXXXXXX\")\"\nmkdir -p \"$hyp_scratch/cores/bench\"\ncp -r cores/bench/rtl cores/bench/test \"$hyp_scratch/cores/bench/\"\ncp cores/bench/core.yaml \"$hyp_scratch/cores/bench/\"\nprintf '\"'%s\\\\n' \\\"\"'$hyp_scratch\"\ncat > \"$hyp_scratch/build_prototype.py\" <<'\"'PY'\nfrom pathlib import Path\n\nrtl = Path(__file__).parent / 'cores/bench/rtl/div_unit.sv'\nsrc = rtl.read_text()\nsrc = src[:src.index('\"'`else'\"')]\nsrc = '''// Blocking RV32M divider with a dedicated recurrence for each divisor width.\n''' + src[src.index('module div_unit'):]\nsrc += '''\"'`else\n  localparam logic [3:0] FIRST_GROUP = 4'\"'d2;\n\n  logic signed_op, remainder_op;\n  logic a_negative, b_negative;\n  logic remainder_op_q, negate_q, overflow_q, wide_q;\n  logic [31:0] dividend_abs, divisor_abs_q;\n  logic [35:0] narrow_dividend_quotient_q;\n  logic [23:0] wide_dividend_quotient_q;\n  logic [7:0] narrow_remainder_q;\n  logic [31:0] wide_remainder_q;\n  logic [31:0] magnitude, corrected, unsigned_quotient, unsigned_remainder;\n  logic [35:0] multiple_q [1:15];\n  logic [35:0] d;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign remainder_op = (op == ALU_REM || op == ALU_REMU);\n  assign a_negative = signed_op && a[31];\n  assign b_negative = signed_op && b[31];\n  assign dividend_abs = a_negative ? -a : a;\n  assign d = {4'b0, divisor_abs_q};\n\n  // Compute the three-term odd multiples in one carry-propagate addition.\n  function automatic logic [35:0] sum3(\n    input logic [35:0] x, y, z\n  );\n    logic [35:0] xor_sum, carry;\n    begin\n      xor_sum = x \"'^ y ''^ z;\n      carry = (x & y) | ((x | y) & z);\n      sum3 = xor_sum + (carry << 1);\n    end\n  endfunction\n\n'\"'''\nfor name, width, digit_width, trial in [\n    ('narrow0', 8, 3, '{narrow_remainder_q, narrow_dividend_quotient_q[35:33]}'),\n    ('narrow1', 8, 3, '{narrow0_remainder, narrow_dividend_quotient_q[32:30]}'),\n    ('wide', 32, 4, '{wide_remainder_q, wide_dividend_quotient_q[23:20]}'),\n]:\n    trial_width = width + digit_width\n    n = 1 << digit_width\n    src += f'''\n  logic [{trial_width-1}:0] {name}_trial;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [{trial_width}:0] {name}_diff [1:{n-1}];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [{n-1}:0] {name}_use;\n  logic [{width-1}:0] {name}_remainder;\n  logic [{digit_width-1}:0] {name}_digit;\n  assign {name}_trial = {trial};\n  for (genvar k = 1; k < {n}; k++) begin : g_{name}_subtract\n    assign {name}_diff[k] = {{1'b0, {name}_trial}} - {{1'b0, multiple_q[k][{trial_width-1}:0]}};\n  end\n  assign {name}_use[0] = {name}_diff[1][{trial_width}];\n'''\n    for k in range(1, n-1):\n        src += f'  assign {name}_use[{k}] = \"'!{name}_diff[{k}][{trial_width}] && {name}_diff[{k+1}][{trial_width}];'\"\\\\n'\n    src += f'  assign {name}_use[{n-1}] = \"'!{name}_diff[{n-1}][{trial_width}];'\"\\\\n'\n    terms = [f'({{{width}{{{name}_use[0]}}}} & {name}_trial[{width-1}:0])']\n    terms += [f'({{{width}{{{name}_use[{k}]}}}} & {name}_diff[{k}][{width-1}:0])' for k in range(1, n)]\n    src += f'  assign {name}_remainder = ' + '\\\\n' + '    ' + '\\\\n    | '.join(terms) + ';\\\\n'\n    for bit in range(digit_width):\n        terms = [f'{name}_use[{k}]' for k in range(1, n) if k & (1 << bit)]\n        src += f'  assign {name}_digit[{bit}] = ' + ' | '.join(terms) + ';\\\\n'\nsrc += '''\n  always_ff @(posedge clock) begin\n    if (issue && issue_ready) begin\n      narrow_dividend_quotient_q <= {4'b0, dividend_abs};\n      wide_dividend_quotient_q <= dividend_abs[23:0];\n      divisor_abs_q <= b_negative ? -b : b;\n      narrow_remainder_q <= 8'b0;\n      remainder_op_q <= remainder_op;\n      negate_q <= a_negative \"'^ (b_negative && !remainder_op);\n      overflow_q <= signed_op && a == 32'\"'h8000_0000 && b == 32'hffff_ffff;\n    end else if (phase_q == SETUP) begin\n      wide_q <= |divisor_abs_q[31:8];\n      wide_remainder_q <= {24'b0, narrow_dividend_quotient_q[31:24]};\n      multiple_q[1] <= d;\n      multiple_q[2] <= d << 1;\n      multiple_q[3] <= (d << 1) + d;\n      multiple_q[4] <= d << 2;\n      multiple_q[5] <= (d << 2) + d;\n      multiple_q[6] <= (d << 2) + (d << 1);\n      multiple_q[7] <= (d << 3) - d;\n      multiple_q[8] <= d << 3;\n      multiple_q[9] <= (d << 3) + d;\n      multiple_q[10] <= (d << 3) + (d << 1);\n      multiple_q[11] <= sum3(d << 3, d << 1, d);\n      multiple_q[12] <= (d << 3) + (d << 2);\n      multiple_q[13] <= sum3(d << 3, d << 2, d);\n      multiple_q[14] <= (d << 4) - (d << 1);\n      multiple_q[15] <= (d << 4) - d;\n    end else if (phase_q >= FIRST_GROUP && phase_q < COMPLETE) begin\n      if (wide_q) begin\n        wide_dividend_quotient_q <= {wide_dividend_quotient_q[19:0], wide_digit};\n        wide_remainder_q <= wide_remainder;\n      end else begin\n        narrow_dividend_quotient_q <= {narrow_dividend_quotient_q[29:0], narrow0_digit, narrow1_digit};\n        narrow_remainder_q <= narrow1_remainder;\n      end\n    end\n  end\n\n  assign unsigned_quotient = wide_q ? {8'b0, wide_dividend_quotient_q} : narrow_dividend_quotient_q[31:0];\n  assign unsigned_remainder = wide_q ? wide_remainder_q : {24'b0, narrow_remainder_q};\n  assign magnitude = remainder_op_q ? unsigned_remainder : unsigned_quotient;\n  assign corrected = negate_q ? -magnitude : magnitude;\n\n  always_comb begin\n    if (divisor_abs_q == 32'b0)\n      result = remainder_op_q ? src_a : 32'hffff_ffff;\n    else if (overflow_q)\n      result = remainder_op_q ? 32'b0 : 32'h8000_0000;\n    else\n      result = corrected;\n  end\n\"'`endif\n\nendmodule\n'\"'''\nrtl.write_text(src)\nPY\npython \\\"\"'$hyp_scratch/build_prototype.py\"\nverilator --lint-only -Wall -I\"$hyp_scratch/cores/bench/rtl\" \"$hyp_scratch/cores/bench/rtl/\"*.sv --top-module core\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
