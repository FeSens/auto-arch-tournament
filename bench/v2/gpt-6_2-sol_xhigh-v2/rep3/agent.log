{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom random import Random\nM = (1 << 32) - 1\nrng = Random(0x4200c0de)\ncounts = [set(), set()]\ndef check(a, d):\n    if d < 4096:\n        recip = min(M, (1 << 32) // d)\n        q = a*recip >> 32\n        r = (a - q*d) & ((1 << 13) - 1)\n        if r >= d:\n            q += 1\n            r -= d\n    else:\n        k = 3 if d < 131072 else 2\n        lo = 6*k\n        q, r = divmod(a >> lo, d)\n        assert q < (4 if k == 3 else 8)\n        counts[(k==2)].add(q)\n        for shift in range(lo-k, -1, -k):\n            trial = (r << k) | ((a >> shift) & ((1<<k)-1))\n            assert trial < (d << k)\n            digit = max(i for i in range(1<<k) if i*d <= trial)\n            r = trial - digit*d\n            q = (q << k) + digit\n        assert 0 <= r < d\n    assert (q,r) == divmod(a,d)\nfor d in [1, 2, 255, 256, 1023, 4095, 4096, 4097, 16383, 16384, 131071, 131072, 131073, 1048575, 1048576, 0x80000000, M]:\n    for a in [0, 1, d-1, d, min(M,d+1), M-1, M, *[rng.randrange(M+1) for _ in range(256)]]:\n        check(a,d)\nfor lo,hi in [(1,4096),(4096,131072),(131072,M+1)]:\n    for _ in range(25_000):\n        check(rng.randrange(M+1), rng.randrange(lo,hi))\nassert counts == [set(range(4)), set(range(8))]\nprint('Arithmetic model matched divmod across both new recurrence schedules, magnitude boundaries and all reachable setup digits.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
