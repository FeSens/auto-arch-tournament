{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom tools.eval.gowin import build_all\n\nscratch = Path('/srv/hwebench/tmp/5a1ea1b1/e19c4c92/bench-r10s0-vu6d70fw')\nrtl = scratch / 'prototype' / 'rtl'\nshutil.copytree('cores/bench/rtl', rtl)\n\ndef edit(file, replacements):\n p = rtl / file\n original = p.read_text()\n for before, after in replacements:\n  assert original.count(before) == 1, (file, before)\n  original = original.replace(before, after)\n p.write_text(original)\n\nedit('ex_stage.sv', [('assign divide_wait = divide && \"'!div_result_valid;'\"', 'assign divide_wait = in.valid && in.divide && \"'!div_result_valid;'\"')])\nedit('hazard_unit.sv', [\n ('assign stall_id = stall_ex_mem || divide_wait;', 'assign stall_id = stall_ex_mem || (divide_wait && \"'!repair);'\"'),\n ('assign issue_if = \"'!stall_id && !load_use && !repair;'\"', 'assign issue_if = \"'!stall_ex_mem && !divide_wait && !load_use;'\"')])\nedit('if_stage.sv', [\n ('logic response, push, issue, pop;', 'logic response, push, issue, pop;\\\\n  logic normal_response, normal_push, normal_reject;'),\n ('assign response = imem_ready && (repair || \"'!occupancy_q[4]);'\"\\\\n  assign push = response && \"'!reject;'\"', 'assign normal_response = imem_ready && \"'!occupancy_q[4];'\"\\\\n  assign normal_push = normal_response && \"'!normal_reject;'\"\\\\n  assign response = repair ? imem_ready : normal_response;\\\\n  assign push = repair ? imem_ready : normal_push;'),\n ('assign reject = guess_q && \"'!checked_hit && !repair;'\"', 'assign normal_reject = guess_q && \"'!checked_hit;'\"\\\\n  assign reject = normal_reject && \"'!repair;'\"'),\n ('guess_q <= push && \"'!repair'\"', 'guess_q <= normal_push && \"'!repair'\"'),\n ('tail_q <= (\"'!reset && push) ? 2'\"\\\\'d1 : 2\\\\'d0;', 'tail_q <= (\"'!reset && imem_ready) ? 2'\"\\\\'d1 : 2\\\\'d0;'),\n ('occupancy_q <= (\"'!reset && push) ? 5'\"\\\\'b00010 : 5\\\\'b00001;', 'occupancy_q <= (\"'!reset && imem_ready) ? 5'\"\\\\'b00010 : 5\\\\'b00001;'),\n ('case ({push, pop})', 'case ({normal_push, pop})'),\n ('if (push) tail_q <= tail_q + 2\\\\'d1;', 'if (normal_push) tail_q <= tail_q + 2\\\\'d1;'),\n ('if (issue) replay_pc_q <=', 'if (issue && \"'!repair) replay_pc_q <='\"')])\nfor result in build_all(Path.cwd(), rtl, 'fpga/core_bench_si.sv', scratch / 'prototype'):\n print(result, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
