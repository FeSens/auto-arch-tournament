umps == [(32, 0, 12), (48, 0, 12), (12, 1, 0)]\n    assert stores == [(0, 0xF, 32), (4, 0xF, 48), (8, 0xF, 34)]\n\n\ndef test_pipeline_runner():'\"''')\nsrc = src.replace('            \\\"core.sv\\\",','            \\\"branch_predictor.sv\\\", \\\"core.sv\\\",')\npath.write_text(src)\nPY\nPYTHONDONTWRITEBYTECODE=1 pytest -q cores/bench/test > prototype-cocotb.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
