{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r7s0-study/profile.py\" <<'\"'PY'\nimport collections\nimport json\nimport sys\n\nmost = collections.Counter()\ndelay = collections.Counter()\nprevious = None\nfor line in sys.stdin:\n    item = json.loads(line)\n    if item.get('cycle',0) < 14678 or item.get('cycle',0) >= 4163181: continue\n    if previous and previous['insn'] & 0x7f == 3 and previous['rd_addr'] \"'!= 0:\n        rd = previous['\"'rd_addr']\n        insn = item['insn']\n        op = insn & 0x7f\n        f3 = insn >> 12 & 7\n        rs1 = item['rs1_addr'] == rd\n        rs2 = item['rs2_addr'] == rd\n        needs1 = op in (3, 0x13, 0x23, 0x33, 0x63, 0x67)\n        needs2 = op in (0x23, 0x33, 0x63)\n        if rs1 or rs2:\n            label = (hex(op), f3, rs1 and needs1, rs2 and needs2)\n            most[label] += 1\n            delay[label] += item['cycle'] > previous['cycle'] + 1\n    previous = item\nprint(most.total(), delay.total())\nprint(*[(k, v, delay[k]) for k, v in most.most_common(25)], sep='\\\\n')\nPY\nset -o pipefail\n\\\"\"'$TMPDIR/r7s0-study/base-obj/cosim_sim\" bench/programs/coremark.elf 10000000 --istall --dstall | python \"$TMPDIR/r7s0-study/profile.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
