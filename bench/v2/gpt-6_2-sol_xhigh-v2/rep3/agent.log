{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -c 'for name in branch_fast load_fast; do\n    mkdir -p \"$name/cores/bench\"\n    cp -R base/Makefile base/fpga base/tools base/bench base/test \"$name/\"\n    cp -R base/cores/bench/core.yaml base/cores/bench/test \"$name/cores/bench/\"\n    ln -s ../base/.toolchain \"$name/.toolchain\"\ndone\ncp -R branch_local/cores/bench/rtl branch_fast/cores/bench/\ncp -R load_short/cores/bench/rtl load_fast/cores/bench/\npython - <<'\"'PY'\nfrom pathlib import Path\nfor name in (\\\"branch_fast\\\", \\\"load_fast\\\"):\n    rtl = Path(name) / \\\"cores/bench/rtl\\\"\n    p = rtl / \\\"id_stage.sv\\\"\n    s = p.read_text()\n    start = s.index(\\\"  // Pair only\\\")\n    end = s.index(\\\"  assign rs1_sel.ex_mem\\\", start)\n    s = s[:start] + \\\"\\\"\\\"  assign load_eq_pair = ex_load && ex_rd \"'!= 5'\"'d0\n                     && in.instr[19:15] == ex_rd\n                     && in.instr[6:0] == 7'h63 && in.instr[14:13] == 2'b00;\n\n\\\"\\\"\\\" + s[end:]\n    s = s.replace(\\\"  assign load_ptr_pair = ex_lw && in.valid && dec_mem_read && (imm == 32'd0 || imm == 32'd1 || imm == 32'd2)\\\\n                       && ex_rd \"'!= 5'\"'d0 && rs1_addr == ex_rd;\\\",\n\\\"\\\"\\\"  assign load_ptr_pair = ex_lw && ex_rd \"'!= 5'\"'d0 && in.instr[19:15] == ex_rd\n                       && in.instr[6:0] == 7'h03 && in.instr[14:12] \"'!= 3'\"'d3\n                       && in.instr[14:13] \"'!= 2'\"'b11\n                       && in.instr[31:22] == 10'b0 && in.instr[21:20] \"'!= 2'\"'b11;\\\"\\\"\\\")\n    # Synthetic entries must not launch a pair. Hazard validity independently\n    # drops synthetic instructions, but the stored flags also require this.\n    s = s.replace(\\\"reg_q.load_eq_pair <= load_eq_pair;\\\", \\\"reg_q.load_eq_pair <= load_eq_pair && \"'!in.synthetic;\")\n    s = s.replace(\"reg_q.load_ptr_pair <= load_ptr_pair;\", \"reg_q.load_ptr_pair <= load_ptr_pair && !in.synthetic;\")\n    p.write_text(s)\n    p = rtl / \"core.sv\"\n    s = p.read_text().replace(\"  logic [31:0] load_value;\", \"\"\"  logic [31:0] load_value, branch_expected;\n  assign branch_expected = id_ex_w.rs2_default\n                         | ({32{id_ex_w.rs2_sel.mem_wb}} & mem_wb_w.write_data);\"\"\")\n    s = s.replace(\".expected_load  (id_ex_w.rs2_default)\", \".expected_load  (branch_expected)\")\n    p.write_text(s)\n    p = rtl / \"ex_stage.sv\"\n    s = p.read_text().replace(\"assign divide_wait = divide && !div_result_valid;\",\n          \"assign divide_wait = in.valid && in.divide && !div_result_valid;\")\n    s = s.replace(\"assign write_eligible = ex_valid && ctrl_with_trap.reg_write && !in.ctrl.mem_read;\",\n          \"assign write_eligible = in.valid && ctrl_with_trap.reg_write && !in.ctrl.mem_read;\")\n    p.write_text(s)\n    p = rtl / \"hazard_unit.sv\"\n    s = p.read_text().replace(\"assign issue_if = !stall_id && !load_use && !repair;\",\n          \"assign issue_if = !stall_id && !load_use;\")\n    p.write_text(s)\n    # IF uses normal issue only for non-repair queue transitions. Replay PC\n    # updates during repair are unobserved until lane zero loads a new target.\nPY\nfor name in branch_fast load_fast; do make -C \"$name\" lint TARGET=bench; done\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
