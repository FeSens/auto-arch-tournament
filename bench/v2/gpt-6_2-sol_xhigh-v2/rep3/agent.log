{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json, shutil, re\nfrom tools.eval.gowin import build\n\nwt = Path.cwd()\nroot = Path('/srv/hwebench/tmp/5a1ea1b1/226d8738/bench-r14s0-_uwsxihw')\nbase = root / 'drain-repair-reg-tag'\nmodes = ('repair-fast-div', 'repair-fast-div-overflow')\nfor mode in modes:\n    dst = root / mode\n    shutil.copytree(base, dst)\n    div = dst / 'div_unit.sv'\n    s = div.read_text().replace(\\\"COMPLETE = 4'd8\\\", \\\"COMPLETE = 4'd7\\\")\n    start = s.index('      multiple_q[1]')\n    end = s.index('      if (wide_divisor)', start)\n    computes = re.findall(r'multiple_q\\\\[(\\\\d+)\\\\]\\\\s*<= ([\"'^;]+);'\"', s[start:end])\n    assert len(computes) == 15\n    s = s[:start] + '      for (int digit = 1; digit < 16; digit++)\\\\n        multiple_q[digit] <= multiple[digit];\\\\n\\\\n' + s[end:]\n    overflow = '(|multiple[digit][35:12])' if mode == 'repair-fast-div' else \\\"(divisor_abs_q > 32'(4095 / digit))\\\"\n    early = '''  logic [35:0] multiple [1:15];\n''' + ''.join(f'  assign multiple[{n}] = {rhs};\\\\n' for n,rhs in computes) + f'''\n  logic [11:0] seed_trial, seed_remainder;\n  logic [12:0] seed_diff [1:15];\n  logic [16:0] seed_borrow;\n  logic [15:0] seed_select;\n  logic [3:0] seed_digit;\n  assign seed_trial = dividend_abs_q[31:20];\n  assign seed_borrow[0] = 1'b0;\n  assign seed_borrow[16] = 1'b1;\n  for (genvar digit = 1; digit < 16; digit++) begin : gen_seed_diff\n    assign seed_diff[digit] = {{1'b0, seed_trial}} - {{1'b0, multiple[digit][11:0]}};\n    assign seed_borrow[digit] = {overflow} || seed_diff[digit][12];\n  end\n  for (genvar digit = 0; digit < 16; digit++) begin : gen_seed_select\n    assign seed_select[digit] = \"'!seed_borrow[digit] && seed_borrow[digit + 1];\n  end\n  for (genvar bit_idx = 0; bit_idx < 12; bit_idx++) begin : gen_seed_remainder\n    logic [15:0] selected_bits;\n    assign selected_bits[0] = seed_trial[bit_idx] && seed_select[0];\n    for (genvar digit = 1; digit < 16; digit++) begin : gen_seed_candidate\n      assign selected_bits[digit] = seed_diff[digit][bit_idx] && seed_select[digit];\n    end\n    assign seed_remainder[bit_idx] = |selected_bits;\n  end\n  assign seed_digit[0] = |(seed_select & 16'\"'haaaa);\n  assign seed_digit[1] = |(seed_select & 16'hcccc);\n  assign seed_digit[2] = |(seed_select & 16'hf0f0);\n  assign seed_digit[3] = |(seed_select & 16'hff00);\n\n'''\n    s = s.replace('  // Appending four bits', early + '  // Appending four bits')\n    s = s.replace(\\\"wide_remainder_q <= {24'b0, dividend_abs_q[31:24]};\\\\n        wide_dividend_quotient_q <= dividend_abs_q[23:0];\\\", \\\"wide_remainder_q <= {20'b0, seed_remainder};\\\\n        wide_dividend_quotient_q <= {dividend_abs_q[19:0], seed_digit};\\\")\n    div.write_text(s)\n\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    futs = {pool.submit(build, wt, root / mode, 'fpga/core_bench_si.sv', 1, root / f'{mode}_p1'):mode for mode in modes}\n    for f in as_completed(futs):\n        r = f.result()\n        print(futs[f], r['fmax_mhz'], r.get('reason', ''), json.dumps(r.get('critical_paths', [])[:2]), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
