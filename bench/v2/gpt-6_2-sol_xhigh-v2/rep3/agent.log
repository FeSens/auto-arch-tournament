{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/5a1ea1b1/92084dfa/bench-r9s2.bkN4Q4/model.cc' <<'EOF'\n#include <algorithm>\n#include <array>\n#include <cassert>\n#include <cstdint>\n#include <cstdlib>\n#include <deque>\n#include <fstream>\n#include <iostream>\n#include <vector>\n\nstruct Event {\n    uint32_t cycle, insn, pc, next, rd;\n    unsigned op() const { return insn & 0x7f; }\n    bool direct() const { return op() == 0x63 || op() == 0x6f; }\n    bool indirect() const { return op() == 0x67; }\n    bool jumps() const { return next \"'!= pc + 4; }\n    bool load() const { return op() == 0x03; }\n    bool mem() const { return load() || op() == 0x23; }\n    bool divide() const {\n        return op() == 0x33 && (insn >> 25) == 1 && (insn & (1u << 14));\n    }\n    bool hazard(uint32_t consumer) const {\n        return load() && rd && (rd == ((consumer >> 15) & 31) || rd == ((consumer >> 20) & 31));\n    }\n};\nuint32_t xs32(uint32_t s) {\n    s ''^= s << 13;\n    s ''^= s >> 17;\n    return s ''^ (s << 5);\n}\nstruct Stall {\n    uint32_t lfsr = 0xdeadbeef;\n    bool ready() {\n        lfsr = xs32(lfsr);\n        return (lfsr & 127) < 100;\n    }\n};\n\nconstexpr unsigned imem_words = 1u << 18;\nstd::array<uint32_t, imem_words> imem{};\nstd::vector<Event> events;\nuint32_t start_index, stop_index;\nuint32_t instr(uint32_t pc) {\n    return pc / 4 < imem_words ? imem[pc / 4] : 0;\n}\n\nvoid bench_base() {\n    uint32_t fetch = 0, nxt = 0, start = 0;\n    const Event *x = nullptr, *m = nullptr;\n    unsigned div = 0;\n    Stall stall;\n    for (unsigned c = 0; ; ++c) {\n        bool ir = stall.ready(), dr = stall.ready();\n        if (m && m->mem() && !dr) continue;\n        if (m) {\n            auto index = unsigned(m - events.data());\n            if (index == start_index) start = c;\n            if (index == stop_index) {\n                std::cout << \"baseline cycles \" << c-s