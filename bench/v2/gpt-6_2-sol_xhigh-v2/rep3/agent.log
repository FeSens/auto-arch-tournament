5) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) \n…[9886 of 12958 chars elided by tools/bench/transcript.py; sha256:71c9e1969e6783ba]…\n0\n        SW(5, 0, 4),\n        _r(1, 2, 5, 0b100, 6, 0b0110011),  # DIV  x6, x5, x2 = 1\n        SW(6, 0, 8),\n        _r(1, 0, 1, 0b111, 7, 0b0110011),  # REMU x7, x1, x0 = 101\n        EBREAK(),\n    ]\n    stores = []\n    rets, dmem = await _run(dut, program, {0: 101}, max_cycles=64,\n                            store_stalls={4: 4}, accepted_stores=stores)\n\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert not any(r[\"trap\"] for r in rets)\n    for index, expected in (\n        (2, (1, 101, 2, 7, 3, 14)),\n        (3, (1, 101, 3, 14, 4, 3)),\n        (4, (4, 3, 2, 7, 5, 10)),\n        (6, (5, 10, 2, 7, 6, 1)),\n        (8, (1, 101, 0, 0, 7, 101)),\n    ):\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\n", "exit_code": 0, "status": "completed"}}
