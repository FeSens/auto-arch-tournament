ward_write,\\\\n  output mem_wb_t  out')\ns = s.replace('  // ── MEM/WB register', '  assign forward_write = in.valid && ctrl_with_trap.reg_write;\\\\n\\\\n  // ── MEM/WB register')\npath.write_text(s)\npath = output/'core.sv'\ns = path.read_text().replace('  logic [1:0] fwd_ex_mem_en, fwd_mem_wb_en, fwd_reg_file_en;','  logic mem_forward_write;')\ns = s.replace('    .mem_rd   (ex_mem_w.rd),','''    .mem_rd   (ex_mem_w.rd),\n    .ex_w_en  (id_ex_w.valid && id_ex_w.ctrl.reg_write &&\n               \"'!id_ex_w.ctrl.is_jump && !id_ex_w.ctrl.mem_read),\n    .mem_w_en (mem_forward_write),'\"''')\nfor source in ('ex_mem','mem_wb','reg_file'):\n    s = s.replace('('+f'fwd_{source}_en'+')','('+f'id_ex_w.fwd_{source}_en'+')')\ns = s.replace('    .dmem_ren   (io_dmemREn),','    .dmem_ren   (io_dmemREn),\\\\n    .forward_write (mem_forward_write),')\nstart = s.index('  // MEM/WB retains reg_write')\nend = s.index('  // ── RVFI', start)\ns = s[:start] + s[end:]\npath.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nimport os\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(os.environ['BENCH_HYP_SCRATCH'])\nname = 'registered-forward'\nresults = build_all(Path.cwd(), scratch/name, 'fpga/core_bench_si.sv', scratch/f'{name}-timing')\nprint(summarize(results))\nfor result in results:\n    print(result['place_option'], result.get('critical_paths', [])[:3])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
