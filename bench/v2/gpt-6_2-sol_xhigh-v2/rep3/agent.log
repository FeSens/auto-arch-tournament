{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport json, os, shutil, subprocess\nfrom tools.eval.gowin import build_all\nfrom tools.eval.fpga import validate_coremark_uart\n\nscratch = Path('/srv/hwebench/tmp/5a1ea1b1/e19c4c92/bench-r10s0-vu6d70fw')\nname = 'late_multiply'\nrtl = scratch / name / 'rtl'\nshutil.copytree('cores/bench/rtl', rtl)\ndef read(file): return (rtl/file).read_text()\ndef write(file,s): (rtl/file).write_text(s)\ndef edit(file,pairs):\n s=read(file)\n for a,b in pairs:\n  assert s.count(a)==1,(file,a)\n  s=s.replace(a,b)\n write(file,s)\nedit('core.sv',[('id_ex_w.valid && id_ex_w.ctrl.mem_read',\n '''id_ex_w.valid && (id_ex_w.ctrl.mem_read || id_ex_w.result_sel.mul_low || id_ex_w.result_sel.mul_high)''')])\ns=read('ex_stage.sv')\nstart=s.index('  logic [63:0] product;')\nend=s.index('  logic divide;', start)\nmul=s[start:end]\nwrite('ex_stage.sv',s[:start]+s[end:])\nedit('ex_stage.sv',[\n ('logic [31:0] add_sub, other_wb, mul;', 'logic [31:0] add_sub, other_wb;'),\n ('''    mul      = ({32{sel.ex_mem.mul_low}}  & reg_q.result.product[31:0])\n             | ({32{sel.ex_mem.mul_high}} & reg_q.result.product[63:32]);\n    forward_operand = default_value | add_sub | other_wb | mul;''',\n  '    forward_operand = default_value | add_sub | other_wb;'),\n ('\"'!in.ctrl.mem_read;'\"', '\"'!in.ctrl.mem_read && !in.result_sel.mul_low && !in.result_sel.mul_high;'\"'),\n ('reg_q.result.product <= product;', 'reg_q.result.product <= {rs2, rs1};')])\nmul=mul.replace('in.ctrl.alu_op','in.ctrl.alu_op').replace('rs1','mul_rs1').replace('rs2','mul_rs2')\nedit('mem_stage.sv',[\n ('  // The load has no EX result class,', '''  logic [31:0] mul_rs1, mul_rs2;\n  assign {mul_rs2, mul_rs1} = in.result.product;\n\n''' + mul + '  // The load has no EX result class,'),\n ('in.result.product[31:0])','product[31:0])'),\n ('in.result.product[63:32])','product[63:32])')])\n\ndef sim():\n obj=scratch/name/'obj'\n with (scratch/name/'verilator.log').open('w') as f:\n  subprocess.run(['bash','test/cosim/build.sh'],check=True,stdout=f,stderr=f,\n    env={**os.environ,'NRET':'1','RTL_DIR':str(rtl),'OBJ_DIR':str(obj)})\n out=subprocess.check_output([str(obj/'cosim_sim'),str(scratch/'coremark.elf'),'50000000','--bench','--istall','--dstall'],text=True)\n marker=json.loads(out.splitlines()[-1])\n assert marker['ebreak'] and not marker['oob'] and marker['bench_bracketed']\n assert validate_coremark_uart(marker['uart'],10)==(True,None)\n print('Validated CoreMark marker cycles:',marker['bench_stop_cycle']-marker['bench_start_cycle'],flush=True)\nwith ThreadPoolExecutor(max_workers=2) as ex:\n sim_job=ex.submit(sim)\n timing_job=ex.submit(build_all,Path.cwd(),rtl,'fpga/core_bench_si.sv',scratch/name)\n sim_job.result()\n for r in timing_job.result():\n  print(r['place_option'], r['fmax_mhz'],r.get('critical_paths',[])[:3],r.get('reason',''),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
