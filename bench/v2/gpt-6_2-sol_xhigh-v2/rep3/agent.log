te_mask = in.byte_mask;\n    mem_op = in.ctrl.mem_read || in.ctrl.mem_write;\n    mem_misalign = mem_op && in.mem_misalign;\n\n'''))\n    if lane:\n        rewrite('core_pkg', ('    logic other;\\\\n','    logic other;\\\\n    logic pc_or_div;\\\\n'),\n                             ('    logic [31:0] other;\\\\n','    logic [31:0] other;\\\\n    logic [31:0] pc_or_div;\\\\n'))\n        rewrite('id_stage',\n            (\\\"        result_sel.other = 1'b1;\\\", \\\"        result_sel.pc_or_div = 1'b1;\\\"),\n            ('          default:                      result_sel.other', '''          ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU:\n                                        result_sel.pc_or_div = 1'b1;\n          default:                      result_sel.other'''))\n        rewrite('ex_stage',\n            ('    logic [31:0] add_sub, other_wb, mul;', '    logic [31:0] add_sub, other_wb, mul, pc_default;'),\n            ('    forward_operand = default_value | add_sub | other_wb | mul;', '''    pc_default = ({32{sel.ex_mem.pc_or_div}} & reg_q.result.pc_or_div) | default_value;\n    forward_operand = pc_default | add_sub | other_wb | mul;'''),\n            ('''      reg_q.result.other  <= other_result\n                           | ({32{in.ctrl.is_auipc}} & {direct_pc.addr, 2'b00})''', '''      reg_q.result.other  <= other_result;\n      reg_q.result.pc_or_div <= ({32{in.ctrl.is_auipc}} & {direct_pc.addr, 2'b00})'''))\n        rewrite('mem_stage', ('& in.result.other)\\\\n', '& in.result.other)\\\\n                    | ({32{in.result_sel.pc_or_div}} & in.result.pc_or_div)\\\\n'))\n    if simple:\n        rewrite('id_stage', ('&& (pair_rs2 || \"'!mem_hit[1]);'\"', \\\"&& (pair_rs2 || rs2_addr == 5'd0 || rs2_addr \"'!= mem_rd);\"))\n\nmake_variant('\"'local','earlyalign',True,False,False)\nmake_variant('local','separate',False,True,True)\nmake_variant('earlycmp','earlyboth',True,True,False)\nPY\npython \\\"\"'${TMPDIR:-/tmp}/bench-r12s1-timing-refine.py\"'","aggregated_output":