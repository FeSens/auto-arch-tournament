{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\npath = Path('cores/bench/test/test_pipeline.py')\nold = path.read_text()\nmarker = '@cocotb.test()\\\\nasync def forwarding_ex_to_ex'\nassert marker in old\ntest = '''@cocotb.test()\nasync def registered_bypass_ignores_traps_and_holds_priority(dut):\n    program = [\n        ADDI(5, 0, 2),\n        ADDI(5, 0, 7),\n        ADD(6, 5, 5),\n        ADDI(5, 0, 19),\n        JALR(5, 0, 2),\n        ADDI(6, 5, 1),\n        ADDI(5, 0, 41),\n        LW(5, 0, 1),\n        ADDI(6, 5, 1),\n        ADDI(7, 0, 31),\n        SW(7, 0, 64),\n        ADD(10, 7, 6),\n        EBREAK(),\n    ]\n    stores = []\n    loads = []\n    trace, _ = await _run(\n        dut, program, store_stalls={64: 5},\n        accepted_stores=stores, accepted_loads=loads,\n    )\n    assert [r[\\\"insn\\\"] for r in trace] == program\n    assert [r[\\\"order\\\"] for r in trace] == list(range(len(program)))\n    assert trace[2][\\\"rd_wdata\\\"] == 14\n    assert [r[\\\"pc\\\"] for r in trace if r[\\\"trap\\\"]] == [16, 28]\n    assert trace[5][\\\"rd_wdata\\\"] == 20\n    assert trace[8][\\\"rd_wdata\\\"] == 42\n    assert trace[11][\\\"rd_wdata\\\"] == 73\n    assert stores == [(64, 15, 31)]\n    assert loads == []\n\n\n'''\npath.write_text(old.replace(marker, test + marker))\nPY\npython3 -m pytest -q cores/bench/test/test_pipeline.py > directed.log 2>&1\ncat directed.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
