{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c 'r7_scratch=\"$TMPDIR/r7s2.iFMSEb2U\"\nmkdir -p \"$r7_scratch/staged/cores/bench\" &&\ncp -r \"$r7_scratch/reg_repair/cores/bench/rtl\" \"$r7_scratch/staged/cores/bench\" &&\ncp \"$r7_scratch/cores/bench/core.yaml\" \"$r7_scratch/staged/cores/bench\" &&\ncp -r fpga \"$r7_scratch/staged\" &&\npython3 - \"$r7_scratch/staged/cores/bench/rtl/if_stage.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1])\ns=p.read_text().replace('logic in_window, cursor_in_window, repair_in_window, response_ready;', 'logic cursor_in_window, response_ready;')\na=s.index('  assign address =')\nb=s.index('  assign lookup_index =',a)\ns=s[:a]+'''  assign address = cursor_q;\n  assign sequential = cursor_q + 30'd1;\n  assign cursor_in_window = cursor_q[31:20] == 12'd0;\n  assign imem_addr = {12'b0, (cursor_in_window ? cursor_q[19:2] : 18'b0), 2'b00};\n  assign response_ready = \"'!cursor_in_window || imem_ready;\n  assign response_word = cursor_in_window ? imem_data : '\"'0;\n\n'''+s[b:]\ns=s.replace('cursor_in_window && \"'!repair && valid_q'\"', 'cursor_in_window && valid_q')\ns=s[:s.index('  logic [92:0] packets')]+'''  logic [92:0] packets [0:3];\n  logic [31:0] target_words [0:3];\n  packet_t first;\n  logic accept, issue, pop, second_q;\n  logic [2:0] count_q;\n  logic [1:0] head_q, tail_q;\n\n  assign first = packets[head_q];\n  assign out.valid = count_q \"'!= 0 && !repair;\n  assign out.instr = second_q ? target_words[head_q] : first.first_word;\n  assign out.pc.addr = second_q ? first.pred : first.pc;\n  assign out.pc.addr_plus_four = out.pc.addr + 30'\"'d1;\n  assign out.pred_next = second_q ? out.pc.addr_plus_four : first.pred;\n\n  assign issue = out.valid && \"'!hold_id;\n  assign pop = issue && (!first.has_target || second_q);\n  assign accept = response_ready && count_q != 3'\"'d4;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      cursor_q <= '0