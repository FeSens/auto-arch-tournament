{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c 'set -eu\nscratch=\"$TMPDIR/bench-r6s2\"\npython3 - \"$scratch/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\n\ndef edit(name, substitutions):\n    path = rtl / name\n    s = path.read_text()\n    for old, new in substitutions:\n        assert old in s, (name, old)\n        s = s.replace(old, new)\n    path.write_text(s)\n\nedit('core_pkg.sv', [('    logic        use_direct_pc;', '    logic        use_direct_pc;\\\\n    logic        predicted_taken;')])\nedit('id_stage.sv', [('      reg_q.use_direct_pc <= in.use_direct_pc;', '      reg_q.use_direct_pc <= in.use_direct_pc;\\\\n      reg_q.predicted_taken <= in.predicted_taken;')])\nedit('ex_stage.sv', [\n    ('  output logic               direct_redirect,', '  output logic               repair_taken,\\\\n  output logic               repair_fallthrough,\\\\n  output pc_pair_t           fallthrough_pc,'),\n    ('  logic        direct_taken;', '  logic        direct_taken;\\\\n  logic        direct_redirect;'),\n    (\\\"  assign direct_redirect = in.valid && direct_taken && \"'!in.imm[1];\", \"\"\"  assign direct_redirect = in.valid && direct_taken && !in.imm[1];\n  assign repair_taken = direct_redirect && !in.predicted_taken;\n  assign repair_fallthrough = in.valid && !direct_redirect && in.predicted_taken;\n  assign fallthrough_pc.addr = pc.addr_plus_four;\n  assign fallthrough_pc.addr_plus_four = pc.addr + 30'\"'d2;\\\"\\\"\\\")\n])\nedit('core.sv', [\n    ('  logic        direct_redirect, jalr_redirect;', '  logic        repair_taken, repair_fallthrough, jalr_redirect;'),\n    ('  pc_pair_t    direct_pc;', '  pc_pair_t    direct_pc, fallthrough_pc;'),\n    ('    .direct_redirect (direct_redirect),', '    .repair_taken (repair_taken),\\\\n    .repair_fallthrough (repair_fallthrough),\\\\n    .fallthrough_pc (fallthrough_pc),'),\n    ('    .imem_ready     (io_imemReady),', '    .if_id_valid    (if_id_w.valid),'),\n])\nedit('hazard_unit.sv', [\n    ('  input  logic       imem_ready,', '  input  logic       if_id_valid,'),\n    ('  logic imem_stall;\\\\n', ''),\n    ('id_ex_mem_read && imem_ready', 'id_ex_mem_read && if_id_valid'),\n    ('    imem_stall = \"'!imem_ready;'\"\\\\n', ''),\n    ('load_use_hazard || imem_stall || divide_wait', 'load_use_hazard || divide_wait'),\n])\nPY\ncat >\\\"\"'$scratch/rtl/if_stage.sv\" <<'\"'SV'\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              hold_state,\n  input  logic              repair_taken,\n  input  logic              repair_fallthrough,\n  input  pc_pair_t          direct_pc,\n  input  pc_pair_t          fallthrough_pc,\n  input  logic              jalr_redirect,\n  input  logic [31:2]       jalr_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t            out\n);\n  logic [31:2] sequential_pc_q, redirect_pc_q;\n  logic use_redirect_pc_q;\n  pc_pair_t base_pc, repair_pc, request_pc;\n  logic slot_valid_q;\n  pc_pair_t slot_pc_q, next_slot_pc, normal_pc;\n  logic [31:0] slot_instr_q;\n  logic [31:2] displacement, target, target_successor;\n  logic is_branch, is_jal, aligned, predict_taken;\n  logic select_predicted_target, lookahead_safe, use_slot, blocked;\n  logic direct_repair;\n\n  assign base_pc.addr = use_redirect_pc_q ? redirect_pc_q : sequential_pc_q;\n  assign base_pc.addr_plus_four = base_pc.addr + 30'd1;\n\n  assign is_branch = slot_instr_q[6:0] == 7'b1100011\n                 && slot_instr_q[14:13] \"'!= 2'\"'b01;\n  assign is_jal = slot_instr_q[6:0] == 7'b1101111;\n  assign aligned = is_jal ? \"'!slot_instr_q[21] : !slot_instr_q[8];\n  assign displacement = is_jal\n                      ? {{11{slot_instr_q[31]}}, slot_instr_q[31:12][0], slot_instr_q[19:12], slot_instr_q[20], slot_instr_q[30:22]}\n                      : {{19{slot_instr_q[31]}}, slot_instr_q[31], slot_instr_q[7],\n                         slot_instr_q[30:25], slot_instr_q[11:9]};\n  assign target = slot_pc_q.addr + displacement;\n  assign target_successor = slot_pc_q.addr - ~displacement;\n`ifdef BENCH_DISABLE_STATIC_LOOKAHEAD\n  assign predict_taken = 1'\"'b0;\n\"'`else\n  assign predict_taken = aligned && (is_jal || (is_branch && slot_instr_q[31]))\n                       && target[31:20] == 12'\"'b0;\n\"'`endif\n  assign select_predicted_target = predict_taken;\n  assign next_slot_pc.addr = select_predicted_target ? target : slot_pc_q.addr_plus_four;\n  assign next_slot_pc.addr_plus_four = select_predicted_target ? target_successor\n                                                               : slot_pc_q.addr + 30'\"'d2;\n  assign lookahead_safe = next_slot_pc.addr[31:20] == 12'b0;\n\n  assign direct_repair = repair_taken || repair_fallthrough;\n  assign repair_pc = repair_taken ? direct_pc : fallthrough_pc;\n  assign use_slot = slot_valid_q && \"'!direct_repair;\n  assign normal_pc = use_slot && lookahead_safe ? next_slot_pc\n                   : use_slot ? slot_pc_q : base_pc;\n  assign request_pc = direct_repair ? repair_pc : normal_pc;\n  assign imem_addr = {request_pc.addr, 2'\"'b00};\n  assign blocked = stall || hold_state;\n\n  always_comb begin\n    out.sequential_pc = use_slot ? slot_pc_q : base_pc;\n    out.direct_pc = repair_pc;\n    out.use_direct_pc = direct_repair;\n    out.predicted_taken = use_slot && predict_taken;\n    out.instr = use_slot ? slot_instr_q : imem_data;\n    out.valid = use_slot || imem_ready;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sequential_pc_q <= '0;\n      redirect_pc_q <= '0;\n      use_redirect_pc_q <= 1'b0;\n      slot_valid_q <= 1'b0;\n    end else begin\n      if (\"'!blocked) begin\n        sequential_pc_q <= use_slot ? next_slot_pc.addr\n                         : imem_ready ? base_pc.addr_plus_four : base_pc.addr;\n        redirect_pc_q <= jalr_redirect ? jalr_target\n                       : imem_ready ? repair_pc.addr_plus_four : repair_pc.addr;\n        use_redirect_pc_q <= jalr_redirect || direct_repair;\n        slot_valid_q <= !jalr_redirect && use_slot && imem_ready && lookahead_safe;\n      end else if (!slot_valid_q && !direct_repair && !jalr_redirect && imem_ready) begin\n        slot_valid_q <= 1'\"'b1;\n      end\n      if ((\"'!blocked && !jalr_redirect && use_slot && imem_ready && lookahead_safe)\n          || (blocked && !slot_valid_q && !direct_repair && !jalr_redirect && imem_ready)) begin\n        slot_instr_q <= imem_data;\n        slot_pc_q <= request_pc;\n      end\n    end\n  end\nendmodule\nSV\nsed -i '\"'s/slot_instr_q\\\\[31:12\\\\]\\\\[0\\\\]/slot_instr_q[31]/' \\\"\"'$scratch/rtl/if_stage.sv\"\nRTL_DIR=\"$scratch/rtl\" OBJ_DIR=\"$scratch/lookahead\" NRET=1 bash test/cosim/build.sh >\"$scratch/lookahead-build.log\" 2>&1\n\"$scratch/lookahead/cosim_sim\" \"$scratch/coremark.elf\" 20000000 --bench --istall --dstall >\"$scratch/lookahead.json\"\ntail -1 \"$scratch/lookahead.json\"\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
