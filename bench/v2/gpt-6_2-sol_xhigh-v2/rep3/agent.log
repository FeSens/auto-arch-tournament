{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json, shutil\nfrom tools.eval.gowin import build\n\nwt = Path.cwd()\nroot = Path('/srv/hwebench/tmp/5a1ea1b1/226d8738/bench-r14s0-_uwsxihw')\nbase = root / 'drain-repair-reg-tag'\nmodes = ('adj-rd', 'load-elig', 'dest-tags', 'rd-jumpdecompose', 'local-load-match')\nfor mode in modes:\n    dst = root / mode\n    shutil.copytree(base, dst)\n    ids = dst / 'id_stage.sv'\n    idstr = ids.read_text()\n    if mode in ('adj-rd', 'dest-tags'):\n        idstr = idstr.replace('ex_write_eligible && ex_rd \"'!= 5'\"\\\\'d0', 'ex_write_eligible')\n        idstr = idstr.replace('<= in.valid && dec_reg_write && \"'!dec_mem_read && !dec_is_jalr'\"',\n                              \\\"<= in.valid && (|instr[11:7]) && dec_reg_write && \"'!dec_mem_read && !dec_is_jalr\")\n    if mode in ('\"'load-elig', 'dest-tags'):\n        pkg = dst / 'core_pkg.sv'\n        pkg.write_text(pkg.read_text().replace('    logic        adjacent_write;', '    logic        adjacent_write;\\\\n    logic        pending_load;'))\n        core = dst / 'core.sv'\n        core.write_text(core.read_text().replace('(id_ex_w.valid && id_ex_w.ctrl.mem_read)', '(id_ex_w.pending_load)'))\n        idstr = idstr.replace('ex_load && ex_rd \"'!= 5'\"\\\\'d0', 'ex_load')\n        idstr = idstr.replace(\\\"      reg_q.adjacent_write <= 1'b0;\\\", \\\"      reg_q.adjacent_write <= 1'b0;\\\\n      reg_q.pending_load <= 1'b0;\\\")\n        idstr = idstr.replace('      reg_q.valid <= in.valid;', '      reg_q.valid <= in.valid;\\\\n      reg_q.pending_load <= in.valid && dec_mem_read && (|instr[11:7]);')\n    if mode == 'rd-jumpdecompose':\n        idstr = idstr.replace('&& \"'!dec_is_jalr'\"\\\\n                           && \"'!(dec_is_jump && instr[21])'\"',\n                              '&& (\"'!dec_is_jump || (!dec_is_jalr && !instr[21]))'\"')\n    if mode == 'local-load-match':\n        old = 'assign load_use = in.valid && \"'!in.synthetic && (|response_match) && !load_pair && !branch_pair;'\"'\n        new = '''assign load_use = in.valid && \"'!in.synthetic &&\n       ((response_match[0] && !load_pair &&\n         (!in.pair_decode.equality_branch || (older_match[1] && !response_match[1]))) ||\n        (!response_match[0] && response_match[1] &&\n         (!in.pair_decode.equality_branch || older_match[0])));'\"'''\n        assert old in idstr\n        idstr = idstr.replace(old, new)\n    ids.write_text(idstr)\n\nwith ThreadPoolExecutor(max_workers=5) as pool:\n    futs = {pool.submit(build, wt, root / mode, 'fpga/core_bench_si.sv', 1, root / f'{mode}_p1'):mode for mode in modes}\n    for f in as_completed(futs):\n        r = f.result()\n        print(futs[f], r['fmax_mhz'], r.get('reason', ''), json.dumps(r.get('critical_paths', [])[:2]), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
