{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport random\nimport subprocess\nfrom tools.eval.cosim import TRACE_STALL_MODES, run_one\n\nrng = random.Random(20261120)\nworktree = Path(os.environ['TMPDIR']) / 'bench-r2s1-combined'\nasm = worktree / 'multiply-variants.S'\nelf = asm.with_suffix('.elf')\nasm_lines = ['.text', '.globl _start', '_start:']\nvalues = (0, 1, 2, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, 0xffffffff)\npairs = [(a, b) for a in values for b in values]\npairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(448))\nasm_lines.extend(['  lui t6, 0xc0', '  sw zero, 0(t6)'])\nfor a, b in pairs:\n    asm_lines.extend([\n        f'  li t0, 0x{a:x}', f'  li t1, 0x{b:x}',\n        '  mul t2, t0, t1',\n        '  mulh t3, t0, t1',\n        '  mulhu t4, t0, t1',\n        '  sw t4, 0(t6)',\n        '  mulhsu t5, t0, t1',\n        '  xor t2, t5, t2',\n        '  sw t2, 4(t6)',\n        '  lw t3, 4(t6)',\n        '  mul t4, t3, t5',\n    ])\nasm_lines.append('  ebreak')\nasm.write_text('\\\\n'.join(asm_lines) + '\\\\n')\nsubprocess.run(['riscv32-unknown-elf-gcc', '-march=rv32im', '-mabi=ilp32',\n                '-static', '-nostartfiles', '-T', str(worktree / 'bench/programs/link.ld'),\n                str(asm), '-o', str(elf)], check=True, cwd=worktree)\nfor flags in TRACE_STALL_MODES:\n    outcome = run_one(elf, str(worktree / 'cores/bench/obj_dir/cosim_sim'), str(worktree), sim_flags=flags)\n    print(outcome)\n    assert outcome['passed']\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
