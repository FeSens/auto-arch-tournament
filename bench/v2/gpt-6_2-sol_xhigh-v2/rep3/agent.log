{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'scratch_div=\"$TMPDIR/bench-div-r4.oDolNH\"\npython - \"$scratch_div\" <<'\"'PY'\nimport re, shutil, sys\nfrom pathlib import Path\ns=Path(sys.argv[1])\nbase=(s/\\\"radix32neg\\\"/\\\"div_unit.sv\\\").read_text()\npos=(s/\\\"radix32\\\"/\\\"div_unit.sv\\\").read_text()\nfor v, input_src in [('neg_clean',base),('neg_flag',base),('pos_clean',pos)]:\n    p=s/v\n    shutil.copytree(s/\\\"radix32neg\\\",p)\n    t=input_src\n    t=t.replace(\\\"  logic [36:0] d_q [1:31];\\\", \\\"  logic [36:0] odd_multiple_q [0:15];\\\\n  wire [36:0] d_q [1:31];\\\")\n    t=t.replace(\\\"if (i > 0) begin\\\",\\\"if (i > 0) begin : nonzero_threshold\\\")\n    t=t.replace(\\\"if (i < 31) assign pick[i] = \"'!diff[i][37] && diff[i+1][37];\", \"if (i < 31) begin : interior_threshold'\"\\\\n        assign pick[i] = \"'!diff[i][37] && diff[i+1][37];'\"\\\\n      end\\\")\n    t=re.sub(r'd_q\\\\[(\\\\d+)\\\\] <=', lambda m: 'odd_multiple_q[%d] <=' % ((int(m[1])-1)//2), t)\n    t=t.replace('''  for (genvar j = 2; j <= 31; j += 2) begin : even_multiple\n    assign d_q[j] = d_q[j/2] << 1;\n  end''','''  function automatic integer shift_count(input integer factor);\n    integer n;\n    begin\n      n = 0;\n      for (integer bit_idx = 0; bit_idx < 5; bit_idx++) begin\n        if ((factor & ((1 << (bit_idx + 1)) - 1)) == 0)\n          n = bit_idx + 1;\n      end\n      shift_count = n;\n    end\n  endfunction\n\n  for (genvar j = 1; j <= 31; j++) begin : divisor_multiple\n    localparam integer SHIFT = shift_count(j);\n    localparam integer ODD_INDEX = ((j >> SHIFT) - 1) / 2;\n    assign d_q[j] = odd_multiple_q[ODD_INDEX] << SHIFT;\n  end''')\n    if v == 'neg_flag':\n        t=t.replace(\\\"logic remainder_op_q, negate_q, overflow_q;\\\", \\\"logic remainder_op_q, negate_q, overflow_q, divisor_nonzero_q;\\\")\n        t=t.replace(\\\"(d_q[i] \"'!= '\"'0)\\\", \\\"divisor_nonzero_q\\\")\n        t=t.replace(\\\"      divisor_abs_q <= b_negative\\\", \\\"      divisor_nonzero_q <= b \"'!= 32'\"'b0;\\\\n      divisor_abs_q <= b_negative\\\")\n        t=t.replace(\\\"if (divisor_abs_q == 32'b0)\\\", \\\"if (\"'!divisor_nonzero_q)\")\n    (p/\"div_unit.sv\").write_text(t)\nPY\nPYTHONDONTWRITEBYTECODE=1 python - \"$scratch_div\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build, summarize\ns = Path(sys.argv[1])\nvariants = (\\\"neg_clean\\\", \\\"neg_flag\\\", \\\"pos_clean\\\")\nwith ThreadPoolExecutor(max_workers=4) as ex:\n    fs = {(v, p):ex.submit(build, s, s/v, \\\"fpga/core_bench_si.sv\\\", p, s/\\\"timing\\\"/v/f\\\"gowin_p{p}\\\") for v in variants for p in (0,1,2)}\n    for v in variants:\n        res = [fs[v,p].result() for p in (0,1,2)]\n        print(v, summarize(res), flush=True)\n        for t in res:\n            print(v,t[\\\"place_option\\\"],t.get(\\\"fmax_mhz\\\"),t.get(\\\"reason\\\"),t.get(\\\"critical_paths\\\", [])[:1],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
