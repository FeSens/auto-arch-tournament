{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nr = Path(os.environ['TMPDIR']) / 'bench-micro-probe/rtl-fwd'\nfor name in ('core.sv','ex_stage.sv','forward_unit.sv'):\n    p = r/name\n    s = p.read_text()\n    s = s.replace('[1:0] fwd_rs', '[2:0] fwd_rs').replace('[1:0]         fwd_rs','[2:0]         fwd_rs').replace('[1:0] fwd_rs','[2:0] fwd_rs')\n    if name == 'ex_stage.sv':\n        start = s.index('  always_comb begin')\n        end = s.index('  // ── ALU operand')\n        s = s[:start] + ''.join(f'''  assign rs{n} = ({{32{{fwd_rs{n}_sel[2]}}}} & in.rs{n}_val)\n             | ({{32{{fwd_rs{n}_sel[1]}}}} & fwd_ex_mem)\n             | ({{32{{fwd_rs{n}_sel[0]}}}} & fwd_mem_wb);\n''' for n in (1,2)) + '\\\\n'+s[end:]\n    if name == 'forward_unit.sv':\n        s = s[:s.index('  // Yosys')] + ''.join(f'''  logic ex{n}, wb{n};\n  assign ex{n} = ex_mem_w_en && ex_mem_rd \"'!= 5'\"'b0 && ex_mem_rd == id_ex_rs{n};\n  assign wb{n} = mem_wb_w_en && mem_wb_rd \"'!= 5'\"'b0 && mem_wb_rd == id_ex_rs{n};\n  assign fwd_rs{n} = {{\"'!(ex{n} || wb{n}), ex{n}, !ex{n} && wb{n}}};\n'\"''' for n in (1,2)) + 'endmodule\\\\n'\n    p.write_text(s)\nPY\nverilator --lint-only -Wno-fatal --top-module core -I\\\"\"'$TMPDIR/bench-micro-probe/rtl-fwd\" \"$TMPDIR/bench-micro-probe/rtl-fwd/core_pkg.sv\" \"$TMPDIR/bench-micro-probe/rtl-fwd/\"*.sv\npython3 - <<'\"'PY'\nimport os\nfrom pathlib import Path\nfrom tools.eval import gowin\nroot = Path.cwd()\nprobe = Path(os.environ['TMPDIR']) / 'bench-micro-probe'\nresults = gowin.build_all(root, probe/'rtl-fwd', 'fpga/core_bench_si.sv', probe/'fwd')\nprint(gowin.summarize(results))\nfor r in results:\n    print(r['place_option'], *(r.get('critical_paths') or [])[:2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nr = Path(os.environ['TMPDIR']) / 'bench-micro-probe/rtl-mul'\np = r/'alu.sv'\ns = p.read_text()\ns = s[:s.index('  // 64-bit products')] + s[s.index('  always_comb begin'):]\ns = s[:s.index('    mul_ss =')] + s[s.index('    case (op)'):]\ns = s[:s.index('      // M-extension')] + s[s.index('      default:  out'):]\np.write_text(s)\np = r/'ex_stage.sv'\ns = p.read_text()\ns = s.replace('  assign divide_wait = divide && \"'!div_result_valid;'\"', '''  logic multiply, mul_issue_ready, mul_result_valid;\n  logic [31:0] mul_result, mul_src_a, mul_src_b;\n  assign multiply = in.valid && (in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH\n                             || in.ctrl.alu_op == ALU_MULHSU || in.ctrl.alu_op == ALU_MULHU);\n  assign divide_wait = (divide && \"'!div_result_valid) || (multiply && !mul_result_valid);\n  mul_unit u_mul (\n    .clock(clock), .reset(reset), .issue(multiply && !stall),\n    .issue_ready(mul_issue_ready), .op(in.ctrl.alu_op), .a(rs1), .b(rs2),\n    .result_valid(mul_result_valid), .result_ready(multiply && !stall),\n    .result(mul_result), .src_a(mul_src_a), .src_b(mul_src_b)\n  );'\"''')\ns = s.replace('.issue(multiply && \"'!stall)'\"', '.issue(multiply && mul_issue_ready && \"'!stall)'\"')\ns = s.replace('? div_result\\\\n', '? div_result\\\\n                           : multiply        ? mul_result\\\\n')\ns = s.replace('divide ? div_src_a : rs1;', 'divide ? div_src_a : multiply ? mul_src_a : rs1;')\ns = s.replace('divide ? div_src_b : rs2;', 'divide ? div_src_b : multiply ? mul_src_b : rs2;')\np.write_text(s)\n(r/'mul_unit.sv').write_text('''module mul_unit(\n  input logic clock, reset, issue,\n  output logic issue_ready,\n  input logic [4:0] op,\n  input logic [31:0] a, b,\n  output logic result_valid,\n  input logic result_ready,\n  output logic [31:0] result, src_a, src_b\n);\n  logic [1:0] phase_q;\n  assign issue_ready = phase_q == 0;\n  assign result_valid = phase_q == 2;\n  always_ff @(posedge clock) begin\n    if (reset) phase_q <= 0;\n    else if (issue_ready && issue) phase_q <= 1;\n    else if (phase_q == 1) phase_q <= 2;\n    else if (result_valid && result_ready) phase_q <= 0;\n  end\n  always_ff @(posedge clock) begin\n    if (issue && issue_ready) begin\n      src_a <= a;\n      src_b <= b;\n    end\n  end\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) if (issue && issue_ready) begin\n    case (op)\n      ALU_MUL:    result <= (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   result <= (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  result <= (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: result <= (a - b) \"'^ 32'\"'hecfbe137;\n      default:   result <= '0;\n    endcase\n  end\n\"'`else\n  logic a_signed_q, b_signed_q, high_q;\n  logic signed [16:0] a_lo, a_hi, b_lo, b_hi;\n  logic signed [33:0] p00, p01, p10, p11;\n  logic [63:0] v00, v01, v10, v11, sum0, carry0, sum1, carry1, product;\n  always_ff @(posedge clock) if (issue && issue_ready) begin\n    a_signed_q <= op == ALU_MULH || op == ALU_MULHSU;\n    b_signed_q <= op == ALU_MULH;\n    high_q <= op != ALU_MUL;\n  end\n  assign a_lo = {1'\"'b0, src_a[15:0]};\n  assign b_lo = {1'b0, src_b[15:0]};\n  assign a_hi = {a_signed_q && src_a[31], src_a[31:16]};\n  assign b_hi = {b_signed_q && src_b[31], src_b[31:16]};\n  always_ff @(posedge clock) if (phase_q == 1) begin\n    p00 <= a_lo * b_lo;\n    p01 <= a_lo * b_hi;\n    p10 <= a_hi * b_lo;\n    p11 <= a_hi * b_hi;\n  end\n  assign v00 = {32'b0, p00[31:0]};\n  assign v01 = {{14{p01[33]}}, p01, 16'b0};\n  assign v10 = {{14{p10[33]}}, p10, 16'b0};\n  assign v11 = {p11[31:0], 32'b0};\n  assign sum0   = v00 \"'^ v01 ''^ v10;\n  assign carry0 = ((v00 & v01) | (v00 & v10) | (v01 & v10)) << 1;\n  assign sum1   = sum0 ''^ carry0 ''^ v11;\n  assign carry1 = ((sum0 & carry0) | (sum0 & v11) | (carry0 & v11)) << 1;\n  assign product = sum1 + carry1;\n  assign result = high_q ? product[63:32] : product[31:0];\n`endif\nendmodule\n'\"''')\nPY\nverilator --lint-only -Wno-fatal --top-module core -I\\\"\"'$TMPDIR/bench-micro-probe/rtl-mul\" \"$TMPDIR/bench-micro-probe/rtl-mul/core_pkg.sv\" \"$TMPDIR/bench-micro-probe/rtl-mul/\"*.sv\npython3 - <<'\"'PY'\nimport os\nfrom pathlib import Path\nfrom tools.eval import gowin\nroot = Path.cwd()\nprobe = Path(os.environ['TMPDIR']) / 'bench-micro-probe'\nresults = gowin.build_all(root, probe/'rtl-mul', 'fpga/core_bench_si.sv', probe/'mul')\nprint(gowin.summarize(results))\nfor r in results:\n    print(r['place_option'], *(r.get('critical_paths') or [])[:3])\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"cat test/cosim/build.sh && rg -n 'def (run_coremark|validate_coremark_uart)|coremark\\\\.elf|COREMARK_SIM_FLAGS' tools/eval/fpga.py test/cosim/run_cosim.py && cat formal/checks_si.cfg\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"cat test/cosim/build.sh && rg -n 'def (run_coremark|validate_coremark_uart)|coremark\\\\.elf|COREMARK_SIM_FLAGS' tools/eval/fpga.py test/cosim/run_cosim.py && cat formal/checks_si.cfg\"", "aggregated_output": "#!/usr/bin/env bash\n# Build the Verilator-based cosim binary that drives `core` against an ELF\n# program. Produces $OBJ_DIR/cosim_sim (default: test/cosim/obj_dir/cosim_sim).\n#\n# RTL_DIR (default: rtl/) is globbed dynamically (with core_pkg.sv forced\n# first because its compilation-unit-scope typedefs and localparams must be\n# visible before any module references them). Hypotheses are allowed to add,\n# rename, or delete files inside rtl/, so a hardcoded file list would\n# silently break restructuring hypotheses.\nset -euo pipefail\n\nREPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\nCOSIM_DIR=\"$REPO_ROOT/test/cosim\"\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${OBJ_DIR:-}\" ]; then\n  echo \"ERROR: test/cosim/build.sh requires RTL_DIR and OBJ_DIR env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl OBJ_DIR=cores/v1/obj_dir bash test/cosim/build.sh\" >&2\n  exit 2\nfi\n\n# NRET picks which RVFI port set main.cpp expects on `core`.\n# 1 = single-issue (only `_0` ports); 2 = dual-channel (both `_0` and `_1`).\n# Default 2 preserves existing behavior; orchestrator sets to 1 for cores\n# whose core.yaml declares nret: 1.\nNRET=\"${NRET:-2}\"\n\n# Ensure OSS CAD Suite tools are on PATH for non-interactive shells.\nTOOLCHAIN=\"$REPO_ROOT/.toolchain\"\nif [ -d \"$TOOLCHAIN/oss-cad-suite/bin\" ]; then\n  export PATH=\"$TOOLCHAIN/oss-cad-suite/bin:$PATH\"\nfi\n\nmkdir -p \"$OBJ_DIR\"\n\n# Glob $RTL_DIR/*.sv. core_pkg.sv first; the rest in a stable lexicographic\n# order (modulo case-insensitive sort, which Verilator/gcc don't care\n# about). If core_pkg.sv is missing the build will catch that downstream\n# via undefined-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\ntools/eval/fpga.py:77:COREMARK_SIM_FLAGS = [\"--bench\", \"--istall\", \"--dstall\"]\ntools/eval/fpga.py:203:def run_coremark_ipc(worktree: str, sim_bin: str | None = None, env: dict | None = None) -> dict:\ntools/eval/fpga.py:210:    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\ntools/eval/fpga.py:215:            [sim_bin, elf, \"50000000\"] + COREMARK_SIM_FLAGS,\ntools/eval/fpga.py:279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
