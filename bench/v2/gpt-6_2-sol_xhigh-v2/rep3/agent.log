{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r9s0.KF2wMe/borrowonly.py\" <<'\"'PY'\nimport shutil\nfrom pathlib import Path\n\nscratch=Path(__file__).resolve().parent\nfor radix, slices, mode in ((16, (9,9,9,9), 'compare'), (16, (12,12,12), 'compare'),\n                             (16, (0,), 'early'), (16, (8,8,8,8,4), 'compare')):\n    dest=scratch/f'borrow-{mode}-{slices[0]}'\n    src=Path.cwd()/'cores/bench/rtl'\n    shutil.copytree(src,dest,dirs_exist_ok=True)\n    div=dest/'div_unit.sv'\n    text=div.read_text()\n    if mode == 'compare':\n        names = ('p0','p1','p2','p3','p4')\n        code = ''\n        start = 0\n        terms = []\n        for i, width in enumerate(slices):\n            n=names[i]\n            code += f'    wire g{i} = wide_trial[{start} +: {width}] < multiple_q[digit][{start} +: {width}];\\\\n'\n            if i:\n                code += f'    wire {n} = wide_trial[{start} +: {width}] == multiple_q[digit][{start} +: {width}];\\\\n'\n            start += width\n        for i in range(len(slices)-1, -1, -1):\n            terms.append(f'g{i}' + ''.join(f' & {names[k]}' for k in range(i+1,len(slices))))\n        code += '    assign wide_borrow[digit] = ' + ' | '.join('('+term+')' for term in terms) + ';'\n        text=text.replace('    assign wide_borrow[digit] = wide_diff[digit][36];',code)\n    else:\n        code='''\n    logic [4:0] low_q;\n    wire [3:0] initial_multiple = 4'(digit) * divisor_abs_q[3:0];\n    always_ff @(posedge clock) begin\n      if (phase_q == SETUP)\n        low_q <= {1'b0, dividend_abs_q[23:20]} - {1'b0, initial_multiple};\n      else\n        low_q <= {1'b0, wide_dividend_quotient_q[19:16]} - {1'b0, multiple_q[digit][3:0]};\n    end\n    logic [33:0] high_add;\n    assign high_add = {1'b0, wide_remainder_q, 1'b1}\n                    + {1'b0, ~multiple_q[digit][35:4], ~low_q[4]};\n    assign wide_diff[digit] = {5'b0, high_add[28:1], low_q[3:0]};\n    assign wide_borrow[digit] = \"'!high_add[33];\n'\"'''\n        text=text.replace(\\\"    assign wide_diff[digit] = {1'b0, wide_trial} - {1'b0, multiple_q[digit]};\\\\n    assign wide_borrow[digit] = wide_diff[digit][36];\\\",code)\n    div.write_text(text)\nPY\npython3 \\\"\"'$TMPDIR/bench-r9s0.KF2wMe/borrowonly.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
