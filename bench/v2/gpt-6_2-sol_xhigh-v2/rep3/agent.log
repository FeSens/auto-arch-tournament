{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'bench_proto_dir=\"$(mktemp -d \"$TMPDIR/bench-opmux.XXXXXX\")\"\nprintf '\"'%s\\\\n' \\\"\"'$bench_proto_dir\"\npython3 - \"$bench_proto_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nworkspace = Path(sys.argv[1])\nsrc = Path('cores/bench/rtl')\nfor variant in ['flat', 'raw']:\n    dst = workspace / variant\n    shutil.copytree(src, dst)\n    for name in ['core.sv', 'forward_unit.sv', 'ex_stage.sv']:\n        p = dst / name\n        body = p.read_text()\n        body = body.replace('[1:0] fwd_rs1_sel, fwd_rs2_sel', '[2:0] fwd_rs1_sel, fwd_rs2_sel')\n        body = body.replace('[1:0]         fwd_rs', '[2:0]         fwd_rs')\n        body = body.replace('[1:0] fwd_rs', '[2:0] fwd_rs')\n        if name == 'forward_unit.sv':\n            body = body[:body.index('  // Yosys')] + \\\"\\\"\\\"  logic ex1, ex2, wb1, wb2;\n  assign ex1 = ex_mem_w_en && ex_mem_rd \"'!= 5'\"'b0 && ex_mem_rd == id_ex_rs1;\n  assign ex2 = ex_mem_w_en && ex_mem_rd \"'!= 5'\"'b0 && ex_mem_rd == id_ex_rs2;\n  assign wb1 = mem_wb_w_en && mem_wb_rd \"'!= 5'\"'b0 && mem_wb_rd == id_ex_rs1;\n  assign wb2 = mem_wb_w_en && mem_wb_rd \"'!= 5'\"'b0 && mem_wb_rd == id_ex_rs2;\n  assign fwd_rs1 = {ex1, \"'!ex1 && wb1, !(ex1 || wb1)};\n  assign fwd_rs2 = {ex2, !ex2 && wb2, !(ex2 || wb2)};\nendmodule\n\"\"\"\n        if name == '\"'ex_stage.sv':\n            lo = body.index('  always_comb begin')\n            hi = body.index('  logic [31:0] alu_result;')\n            body = body[:lo] + \\\"\\\"\\\"  assign rs1 = ({32{fwd_rs1_sel[2]}} & fwd_ex_mem)\n             | ({32{fwd_rs1_sel[1]}} & fwd_mem_wb)\n             | ({32{fwd_rs1_sel[0]}} & in.rs1_val);\n  assign rs2 = ({32{fwd_rs2_sel[2]}} & fwd_ex_mem)\n             | ({32{fwd_rs2_sel[1]}} & fwd_mem_wb)\n             | ({32{fwd_rs2_sel[0]}} & in.rs2_val);\n\n  logic [31:0] alu_a, alu_b;\n  assign alu_a = ({32{fwd_rs1_sel[2] && \"'!in.ctrl.is_auipc}} & fwd_ex_mem)\n               | ({32{fwd_rs1_sel[1] && !in.ctrl.is_auipc}} & fwd_mem_wb)\n               | ({32{fwd_rs1_sel[0] && !in.ctrl.is_auipc}} & in.rs1_val)\n               | ({32{in.ctrl.is_auipc}} & in.pc);\n  assign alu_b = ({32{fwd_rs2_sel[2] && !in.ctrl.alu_src}} & fwd_ex_mem)\n               | ({32{fwd_rs2_sel[1] && !in.ctrl.alu_src}} & fwd_mem_wb)\n               | ({32{fwd_rs2_sel[0] && !in.ctrl.alu_src}} & in.rs2_val)\n               | ({32{in.ctrl.alu_src}} & in.imm);\n\n\"\"\" + body[hi:]\n        p.write_text(body)\n    if variant != '\"'raw':\n        continue\n    p = dst / 'reg_file.sv'\n    body = p.read_text()\n    body = body[:body.index('  always_comb begin')] + \\\"\\\"\\\"  assign rs1_data = regs[rs1_addr];\n  assign rs2_data = regs[rs2_addr];\nendmodule\n\\\"\\\"\\\"\n    p.write_text(body)\n    p = dst / 'core_pkg.sv'\n    body = p.read_text()\n    body = body.replace('    logic [31:0] rs2_val;\\\\n    logic [31:0] imm;', '    logic [31:0] rs2_val;\\\\n    logic [31:0] sampled_wb;\\\\n    logic wb_hit1, wb_hit2;\\\\n    logic [31:0] imm;', 1)\n    p.write_text(body)\n    p = dst / 'id_stage.sv'\n    body = p.read_text()\n    body = body.replace('  // ID/EX register output', '  input logic wb_w_en,\\\\n  input logic [4:0] wb_w_addr,\\\\n  input logic [31:0] wb_w_data,\\\\n  // ID/EX register output')\n    body = body.replace('      reg_q.imm      <= imm;', '      reg_q.sampled_wb <= wb_w_data;\\\\n      reg_q.wb_hit1 <= wb_w_en && wb_w_addr \"'!= 0 && wb_w_addr == rs1_addr;'\"\\\\n      reg_q.wb_hit2 <= wb_w_en && wb_w_addr \"'!= 0 && wb_w_addr == rs2_addr;'\"\\\\n      reg_q.imm      <= imm;')\n    p.write_text(body)\n    p = dst / 'core.sv'\n    body = p.read_text()\n    body = body.replace('    .out      (id_ex_w)', '    .wb_w_en (wb_w_en),\\\\n    .wb_w_addr (wb_w_addr),\\\\n    .wb_w_data (wb_w_data),\\\\n    .out      (id_ex_w)')\n    p.write_text(body)\n    p = dst / 'ex_stage.sv'\n    body = p.read_text()\n    for i in [1, 2]:\n        body = body.replace(f'| ({{32{{fwd_rs{i}_sel[0]}}}} & in.rs{i}_val);', f'| ({{32{{fwd_rs{i}_sel[0] && \"'!in.wb_hit{i} && in.rs{i}_addr != 0}}}} & in.rs{i}_val)'\"\\\\n             | ({{32{{fwd_rs{i}_sel[0] && in.wb_hit{i}}}}} & in.sampled_wb);')\n        ctrl = 'is_auipc' if i == 1 else 'alu_src'\n        body = body.replace(f'| ({{32{{fwd_rs{i}_sel[0] && \"'!in.ctrl.{ctrl}}}}} & in.rs{i}_val)'\"', f'| ({{32{{fwd_rs{i}_sel[0] && \"'!in.ctrl.{ctrl} && !in.wb_hit{i} && in.rs{i}_addr != 0}}}} & in.rs{i}_val)'\"\\\\n               | ({{32{{fwd_rs{i}_sel[0] && \"'!in.ctrl.{ctrl} && in.wb_hit{i}}}}} & in.sampled_wb)'\"')\n    p.write_text(body)\nPY\npython3 - \\\"\"'$bench_proto_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build_all, summarize\n\nworkspace = Path(sys.argv[1])\nfor variant in ('flat', 'raw'):\n    result = build_all(Path.cwd(), workspace / variant, 'fpga/core_bench_si.sv', workspace / f'timing-{variant}')\n    print(variant, summarize(result), flush=True)\n    for entry in result:\n        print(entry.get('reason') or entry['critical_paths'][:3], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
