{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build_all\n\nscratch = Path('/srv/hwebench/tmp/5a1ea1b1/e19c4c92/bench-r10s0-vu6d70fw')\n\ndef variant(name, group):\n rtl = scratch / name / 'rtl'\n shutil.copytree(scratch / 'local_repair' / 'rtl', rtl)\n p = rtl / 'if_stage.sv'\n s = p.read_text()\n def edit(before, after):\n  nonlocal s\n  assert s.count(before) == 1, before\n  s = s.replace(before,after)\n if group:\n  edit('  logic [19:7] checked_tag_q, response_tag_q;\\\\n  logic [31:0] checked_source_q, response_word_q;',\n       '''  logic [10:0] checked_group_q;\n  for (genvar group = 0; group < 8; group++) begin : gen_check_word\n    always_ff @(posedge clock)\n      checked_group_q[group] <= source_instr[fetch_index][group*4 +: 4] == imem_data[group*4 +: 4];\n  end\n  always_ff @(posedge clock) begin\n    checked_group_q[8] <= full_tag[fetch_index][19:15] == cursor[19:15];\n    checked_group_q[9] <= full_tag[fetch_index][14:11] == cursor[14:11];\n    checked_group_q[10] <= full_tag[fetch_index][10:7] == cursor[10:7];\n  end''')\n  edit('    checked_tag_q <= full_tag[fetch_index];\\\\n    checked_source_q <= source_instr[fetch_index];\\\\n    response_tag_q <= cursor[19:7];\\\\n    response_word_q <= imem_data;\\\\n','')\n  edit('guess_q && checked_tag_q == response_tag_q\\\\n                     && checked_source_q == response_word_q','guess_q && (&checked_group_q)')\n else:\n  edit('  logic [4:0] occupancy_q;', '''  logic [4:0] occupancy_q;\n  logic [4:0] occupancy_normal;\n  logic enqueue_only, dequeue_only, no_change;\n  assign enqueue_only = normal_push && \"'!pop;\n  assign dequeue_only = !normal_push && pop;\n  assign no_change = normal_push == pop;\n  assign occupancy_normal = ({5{enqueue_only}} & {occupancy_q[3:0], 1'\"'b0})\n                          | ({5{de