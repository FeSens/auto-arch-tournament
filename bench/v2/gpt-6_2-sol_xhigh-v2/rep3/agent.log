tient_q})\n                   : (remainder_op_q ? {15'b0, wide_remainder_q} : {12'b0, wide_dividend_quotient_q});\n\\\"\\\"\\\" + src[end:]\n# Negate each lane before the lane select so the final result has no\n# serial extra selection followed by 32-bit sign correction.\nsrc=src.replace('  logic [31:0] magnitude, corrected;', '  logic [31:0] large_magnitude, wide_magnitude;\\\\n  logic [31:0] large_corrected, wide_corrected;')\nstart=src.index('  assign magnitude = ')\nend=src.index('  always_comb begin\\\\n    if (divide_by_zero_q)',start)\nsrc=src[:start]+\\\"\\\"\\\"  assign wide_magnitude = remainder_op_q ? {15'b0, wide_remainder_q}\n                                         : {12'b0, wide_dividend_quotient_q};\n  assign large_magnitude = remainder_op_q ? large_remainder_q : {17'b0, large_dividend_quotient_q};\n  assign wide_corrected = conditional_negate(wide_magnitude, negate_q);\n  assign large_corrected = conditional_negate(large_magnitude, negate_q);\n\n\\\"\\\"\\\"+src[end:]\nsrc=src.replace('    else\\\\n      result = wide_q ? corrected : narrow_result_q;', '''    else\n      result = ({32{wide_q && large_q}} & large_corrected)\n             | ({32{wide_q && \"'!large_q}} & wide_corrected)\n             | ({32{!wide_q}} & narrow_result_q);'\"''')\n(base/'three-lane/div_unit.sv').write_text(src)\nPY\npython3 \\\"\"'$scratch/three_lane.py\"\nverilator --lint-only -Wall -Wno-fatal -Wno-style --top-module core \"+incdir+$scratch/three-lane\" \"$scratch/three-lane/core_pkg.sv\" \"$scratch/three-lane/\"*.sv'", "aggregated_output": "- V e r i l a t i o n   R e p o r t: Verilator 5.047 devel rev v5.046-331-g2cd9b8df6 (mod)\n- Verilator: Built from 0.768 MB sources in 14 modules, into 0.866 MB in 5 C++ files needing 0.000 MB\n- Verilator: Walltime 0.744 s (elab=0.163, cvt=0.564, bld=0.000); cpu 0.744 s on 1 threads; allocated 47.926 MB\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nbase=Path('/srv/hwebench/tmp/5a1ea1b1/3ed9613f/tmp.grqtxll6Qw')\nresults=build_all(Path.cwd(),base/'three-lane','fpga/core_bench_si.sv',base/'place-three-lane')\nprint(summarize(results))\nfor r in results:\n print(r.get('place_option'), r.get('critical_paths',[])[:3],r.get('reason'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.started", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c 'scratch=/srv/hwebench/tmp/5a1ea1b1/3ed9613f/tmp.grqtxll6Qw\nfor variant in four-six four-five; do cp -r cores/bench/rtl \"$scratch/$variant\"; done\ncat > \"$scratch/bins.py\" <<'\"'PY'\nfrom pathlib import Path\n\nbase = Path(__file__).parent\nfor variant, phases, prototype in [\n    ('four-six',6,'../does-not-exist'),\n    ('four-five',5,'partition/div_unit.sv'),\n]:\n    orig = Path('cores/bench/rtl/div_unit.sv') if phases == 6 else base / prototype\n    s = orig.read_text()\n    start = s.index('  logic wide_divisor, wide_q;')\n    end = s.index('  assign signed_op',start)\n    s = s[:start] + ('  logic a_negative_q, b_negative_q;\\\\n' if phases == 5 and 'logic a_negative_q' not in s else '') + '''  logic [2:0] recurring_lane, recurring_lane_q;\n  logic [31:0] dividend_abs_q, divisor_abs_q;\n  logic [35:0] d, d_times_2, d_times_4, d_times_8, d_times_16;\n  logic [35:0] multiple_q [1:15];\n  logic [31:0] narrow_quotient_q, narrow_result_q;\n''' + ('  logic [7:0] narrow_remainder_q;\\\\n' if phases == 6 else '  logic [11:0] narrow_remainder_q;\\\\n') + '\\\\n' + s[end:]\n    s = s.replace('  logic a_negative_q, b_negative_q;\\\\n  logic [2:0] recurring_lane,', '  logic a_negative_q, b_negative_q;\\\\n  logic [2:0] recurring_lane,')\n    s = s.replace('''  assign wide_divisor = |divisor_abs_q[31:8];''','')\n    s = s.replace('''  assign wide_divisor = |divisor_abs_q[31:12];''','')\n    narrow_cut, mid_cut, high_cut = (32-phases*radix for radix in (4,3,2))\n    controls = f\\\"\\\"\\\"  assign recurring_lane[0] = (|divisor_abs_q[31:{narrow_cut}])\n                           && \"'!(|divisor_abs_q[31:{mid_cut}]);\n  assign recurring_lane[1] = (|divisor_abs_q[31:{mid_cut}])\n                           && !(|divisor_abs_q[31:{high_cut}]);\n  assign recurring_lane[2] = |divisor_abs_q[31:{high_cut}];\n\"\"\"\n    s = s.replace('\"'  assign d          =', controls+'\\\\n  assign d          =')\n    start = s.index('  // Appending four bits')\n    end = s.index('  always_ff @(posedge clock) begin\\\\n    if (issue && issue_ready) begin',start)\n    blocks = []\n    for lane, radix, remainder_width in [('mid',4,mid_cut),('high',3,high_cut),('top',2,32)]:\n        divisor_width = remainder_width\n        trial_width = remainder_width + radix\n        q_width = radix*phases\n        max_digit = 2**radix - 1\n        blocks.append(f\\\"\\\"\\\"\n  logic [{remainder_width-1}:0] {lane}_remainder_q, {lane}_remainder_next;\n  logic [{q_width-1}:0] {lane}_dividend_quotient_q;\n  logic [{trial_width-1}:0] {lane}_trial;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [{trial_width}:0] {lane}_diff [1:{max_digit}];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [{max_digit+1}:0] {lane}_borrow;\n  logic [{max_digit}:0] {lane}_select;\n  logic [{radix-1}:0] {lane}_digit;\n  logic [31:0] {lane}_magnitude, {lane}_corrected;\n  assign {lane}_trial = {{{lane}_remainder_q, {lane}_dividend_quotient_q[{q_width-1}:{q_width-radix}]}};\n  assign {lane}_borrow[0] = 1'b0;\n  assign {lane}_borrow[{max_digit+1}] = 1'b1;\n  for (genvar digit = 1; digit <= {max_digit}; digit++) begin : gen_{lane}_diff\n    assign {lane}_diff[digit] = {{1'b0, {lane}_trial}} - {{1'b0, multiple_q[digit][{trial_width-1}:0]}};\n    assign {lane}_borrow[digit] = {lane}_diff[digit][{trial_width}];\n  end\n  for (genvar digit = 0; digit <= {max_digit}; digit++) begin : gen_{lane}_select\n    assign {lane}_select[digit] = \"'!{lane}_borrow[digit] && {lane}_borrow[digit+1];\n  end\n  for (genvar bit_idx = 0; bit_idx < {remainder_width}; bit_idx++) begin : gen_{lane}_remainder\n    logic [{max_digit}:0] selected_bits;\n    assign selected_bits[0] = {lane}_trial[bit_idx] & {lane}_select[0];\n    for (genvar digit = 1; digit <= {max_digit}; digit++) begin : gen_candidate\n      assign selected_bits[digit] = {lane}_diff[digit][bit_idx] & {lane}_select[digit];\n    end\n    assign {lane}_remainder_next[bit_idx] = |selected_bits;\n  end\n\"\"\")\n        for digit_bit in range(radix):\n            mask = sum(1<<value for value in range(max_digit+1) if value>>digit_bit&1)\n            blocks.append(f\"  assign {lane}_digit[{digit_bit}] = |({lane}_select & {max_digit+1}'\"'h{mask:x});\\\\n\\\")\n        blocks.append(f\\\"\\\"\\\"  assign {lane}_magnitude = remainder_op_q ? 32'({lane}_remainder_q)\n                                            : 32'({lane}_dividend_quotient_q);\n  assign {lane}_corrected = conditional_negate({lane}_magnitude, negate_q);\n\\\"\\\"\\\")\n    s = s[:start]+''.join(blocks)+'\\\\n'+s[end:]\n    s = s.replace('      wide_q <= wide_divisor;', '      recurring_lane_q <= recurring_lane;')\n    start = s.index('      if (wide_divisor) begin')\n    end = s.index('  always_comb begin\\\\n    if (divide_by_zero_q)',start)\n    process = []\n    recurring = []\n    lanes = [('mid',4,mid_cut),('high',3,high_cut),('top',2,32)]\n    for idx, (lane, radix, remainder_width) in enumerate(lanes):\n        q_width = radix*phases\n        process.append(f\\\"\\\"\\\"      if (recurring_lane[{idx}]) begin\n        {lane}_remainder_q <= {remainder_width}'(dividend_abs_q[31:{q_width}]);\n        {lane}_dividend_quotient_q <= dividend_abs_q[{q_width-1}:0];\n      end\n\\\"\\\"\\\")\n        recurring.append(f\\\"\\\"\\\"      if (recurring_lane_q[{idx}]) begin\n        {lane}_remainder_q <= {lane}_remainder_next;\n        {lane}_dividend_quotient_q <= {{{lane}_dividend_quotient_q[{q_width-radix-1}:0], {lane}_digit}};\n      end\n\\\"\\\"\\\")\n    s = s[:start]+''.join(process)+'''    end else if (phase_q >= FIRST_GROUP && phase_q < COMPLETE) begin\n'''+''.join(recurring)+'''    end\n  end\n\n'''+s[end:]\n    s = s.replace('result = wide_q ? corrected : narrow_result_q;', '''result = ({32{recurring_lane_q[0]}} & mid_corrected)\n             | ({32{recurring_lane_q[1]}} & high_corrected)\n             | ({32{recurring_lane_q[2]}} & top_corrected)