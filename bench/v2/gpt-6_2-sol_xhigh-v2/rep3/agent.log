{"type": "item.completed", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep3/formal/riscv-formal/checks/rvfi_liveness_check.sv; sed -n '112,170p' cores/bench/test/test_alu.py; rg -n 'path|Ram' /srv/hwebench/tmp/5a1ea1b1/226d8738/bench-r14s0-_uwsxihw/normalized-raw-disp_p1/impl/pnr/core_bench.tr -m 4\"", "aggregated_output": "// Copyright (C) 2017  Claire Xenia Wolf <claire@yosyshq.com>\n//\n// Permission to use, copy, modify, and/or distribute this software for any\n// purpose with or without fee is hereby granted, provided that the above\n// copyright notice and this permission notice appear in all copies.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\" AND THE AUTHOR DISCLAIMS ALL WARRANTIES\n// WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF\n// MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR\n// ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n// WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN\n// ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\nmodule rvfi_liveness_check (\n\tinput clock, reset, trig, check,\n\t`RVFI_INPUTS\n);\n\t`rvformal_rand_const_reg [63:0] insn_order;\n\treg found_next_insn = 0;\n\n\tinteger channel_idx;\n\talways @(posedge clock) begin\n\t\tif (reset) begin\n\t\t\tfound_next_insn = 0;\n\t\tend else begin\n\t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n\nasync def _setup_div(dut):\n    dut.reset.value = 1\n    dut.issue.value = 0\n    dut.result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    assert int(dut.issue_ready.value) == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.issue.value = 1\n    dut.result_ready.value = int(hold_cycles == 0)\n    await _tick(dut)\n\n    # Forwarding inputs can change as older instructions leave the pipeline.\n    dut.issue.value = 0\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n    dut.op.value = ALU_ADD\n\n    for elapsed in range(7):\n        assert int(dut.issue_ready.value) == 0\n        assert int(dut.result_valid.value) == 0, f\"early result at cycle {elapsed}\"\n        await _tick(dut)\n\n    # A pending request must leave the held result and its sources intact.\n    if hold_cycles:\n        dut.op.value = ALU_DIVU\n        dut.issue.value = 1\n    for held in range(hold_cycles + 1):\n        assert int(dut.result_valid.value) == 1\n        assert int(dut.issue_ready.value) == 0\n        assert int(dut.src_a.value) == (a & MASK32)\n        assert int(dut.src_b.value) == (b & MASK32)\n        actual = int(dut.result.value)\n        assert actual == (expected & MASK32), (\n            f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n            f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n        )\n        if held < hold_cycles:\n            await _tick(dut)\n\n    dut.result_ready.value = 1\n    await _tick(dut)\n    dut.issue.value = 0\n    assert int(dut.result_valid.value) == 0\n    assert int(dut.issue_ready.value) == 1\n\n\n@cocotb.test()\nasync def divide_vectors(dut):\n    await _setup_div(dut)\n    vectors = [\n        (ALU_DIV, 10, 3, 3),\n        (ALU_DIV, -4, 2, -2),\n84:<Report Command>:report_timing -setup -max_paths 25 -max_common_paths 1\n114:<Report Command>:report_timing -hold -max_paths 25 -max_common_paths 1\n144:<Report Command>:report_timing -recovery -max_paths 25 -max_common_paths 1\n147:<Report Command>:report_timing -removal -max_paths 25 -max_common_paths 1\n", "exit_code": 0, "status": "completed"}}
