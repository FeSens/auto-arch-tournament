, queue.size(), micro[5*cycle+2],\n                    issue, (mflags&1)\"'!=0, id.idx, ex.idx);\n        }\n        Pack incoming;\n        bool new_guess = false, new_hit = false;\n        if (push) {\n            incoming.bus = {req, insn(req), false};\n            const auto row = predictor.index(cursor);\n            const auto& e = predictor.table[row];\n            new_guess = !repair && !retry && in_window(req) && predictor.short_hit(e, cursor, incoming.bus.word);\n            new_hit = new_guess && e.pc == req && e.word == incoming.bus.word;\n            resume = e.resume;\n            if (new_guess) incoming.handle = 2*row + e.bank;\n            if (new_hit) {\n                incoming.bus.taken = e.direction;\n                incoming.len = e.len;\n                std::copy_n(e.body, e.len, incoming.body);\n            }\n        }\n        if (timed) {\n            if (issue && queue.front().pos) ++insns_from_trace;\n            if (issue && !queue.front().pos && queue.front().len) ++trace_starts;\n            if (queue.empty() && !(stall || repair || load_use || divide_wait)) ++empty;\n            if (reject) ++misses;\n        }\n        if (!stall && !repair && memop && store(ex.op.word) && ex.idx >= 0) {\n            if (trace[ex.idx].addr == 0x10000100 && start == 0) start = cycle;\n            if (trace[ex.idx].addr == 0x10000104) { stop = cycle; break; }\n        }\n        if (baseline) predictor.train((repair || stall) ? PipeSlot{} : ex, queue);\n        else predictor.train(wb_pipe_placeholder, queue);\n        predictor.baseline_write();\n        if (!reject) fallthrough = response ? req + 4 : req;\n        guess = new_guess;\n        guess_hit = new_hit;\n        if (repair || push) retry = repair && !response;\n        auto next_id = id;\n        if (repair) {\n            next_id = PipeSlot{};\n            next_issue = ex.idx + 1;\n            queue.clear();\n        } else if (!(stall || divide_wait)) {\n            next_id = PipeSlot{};\n