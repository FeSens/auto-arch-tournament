 || mem_hit[1]) ? 32'b0 : rs2_data;\n      reg_q.alu_b_val    <= ({32{\"'!dec_alu_src && !(ex_hit[1] || mem_hit[1])}} & rs2_data)\n                         | ({32{dec_alu_src}} & imm);'\"''',\n     '''      reg_q.rs1_val      <= ({32{\"'!ex_hit[0] && !mem_hit[0]}} & rs1_data)\n                         | ({32{!ex_hit[0] && mem_hit[0]}} & mem_write_data);\n      reg_q.rs2_val      <= ({32{!ex_hit[1] && !mem_hit[1]}} & rs2_data)\n                         | ({32{!ex_hit[1] && mem_hit[1]}} & mem_write_data);\n      reg_q.alu_b_val    <= ({32{!dec_alu_src && !(ex_hit[1] || mem_hit[1])}} & rs2_data)\n                         | ({32{!dec_alu_src && !ex_hit[1] && mem_hit[1]}} & mem_write_data)\n                         | ({32{dec_alu_src}} & imm);'\"''')\n])\nupdate('ex_stage.sv', [\n    ('  input  logic [31:0]        fwd_mem_wb,    // selected MEM/WB writeback word\\\\n',''),\n    ('                    | ({32{sel.mem_wb}}         & fwd_mem_wb)\\\\n',''),\n])\nupdate('mem_stage.sv', [\n    ('  output logic               write_eligible,','  output logic               write_eligible,\\\\n  output logic [31:0]        next_write_data,'),\n    ('  assign write_eligible = in.valid', '  assign next_write_data = write_data;\\\\n  assign write_eligible = in.valid'),\n])\n\nrtl = study/'addsub'\nshutil.copytree(study/'preselect', rtl, dirs_exist_ok=True)\nupdate('core_pkg.sv', [\n    ('    logic sub;\\\\n',''),\n    ('    logic [31:0] sub;\\\\n',''),\n    ('    logic [31:0] alu_b_val;\\\\n','    logic [31:0] alu_b_val;\\\\n    logic        subtract;\\\\n'),\n])\nupdate('id_stage.sv', [\n    (\\\"          ALU_ADD:                      result_sel.add      = 1'b1;\\\\n          ALU_SUB:                      result_sel.sub      = 1'b1;\\\", \\\"          ALU_ADD, ALU_SUB:             result_sel.add      = 1'b1;\\\"),\n    ('      reg_q.result_sel   <= result_sel;', '      reg_q.result_sel   <= result_sel;\\\\n      reg_q.subtract     <= dec_alu_op == ALU_SUB;'),\n])\nupdate('ex_stage.sv'