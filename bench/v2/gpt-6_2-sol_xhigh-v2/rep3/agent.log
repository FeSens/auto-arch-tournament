{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\nfrom pathlib import Path\nfrom xml.etree import ElementTree\nimport json, yaml, jsonschema\n\npath = Path('cores/bench/experiments/hypotheses/hyp-20261121-001-r10s0.yaml')\nhypothesis = yaml.safe_load(path.read_text())\njsonschema.Draft7Validator(json.loads(Path('schemas/hypothesis.schema.json').read_text())).validate(hypothesis)\nassert hypothesis['id'] == path.stem\nassert hypothesis['category'] == 'micro_opt'\nassert type(hypothesis['expected_impact']['fitness_delta_pct']) is int\nassert all((Path('cores/bench') / change['file']).is_file() for change in hypothesis['changes'])\nfor count in range(5):\n    for reset, repair, ready, reject, issue, last in product((False, True), repeat=6):\n        push = ready and count < 4 and not reject\n        pop = issue and count > 0 and last\n        normal_count = count + push - pop\n        reference = 0 if reset else int(ready) if repair else normal_count\n        normal_bits = (1 << normal_count) if not reset and not repair else 0\n        repaired_one = int(not reset and repair and ready) << 1\n        repaired_empty = int(reset or (repair and not ready))\n        assert (normal_bits | repaired_one | repaired_empty) == 1 << reference\nprint('Schema, file scope, and all 320 FIFO count transitions verified.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
