{"type":"item.completed","item":{"id":"item_115","type":"command_execution","command":"/bin/bash -c \"sed -n '781,851p' cores/bench/test/test_pipeline.py && rg -n '<failure' cores/bench/test/test_pipeline_runner.result.xml\"","aggregated_output":"@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"The adjacent JAL target consumes the forwarded link.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 1, 42),        # PC=8 — target reads x1\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    jump, target, _ = rets\n    assert (jump[\"pc_next\"], jump[\"rd\"], jump[\"rd_wdata\"]) == (8, 1, 4)\n    assert target[\"cycle\"] == jump[\"cycle\"] + 2\n    assert (target[\"rs1_addr\"], target[\"rs1_rdata\"]) == (1, 4)\n    assert (target[\"pc_next\"], target[\"rd\"], target[\"rd_wdata\"]) == (12, 3, 46)\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"JALR clears target bit 0 and writes the link for the odd input sum.\"\"\"\n    program = [\n        ADDI(5, 0, 13),        # PC=0;  x5 := 13\n        JALR(1, 5, 0),         # PC=4;  jump to 13 with bit 0 cleared\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    jump = rets[1]\n    assert (jump[\"trap\"], jump[\"pc_next\"], jump[\"rd\"], jump[\"rd_wdata\"]) == (0, 12, 1, 8)\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\n@cocotb.parametrize(nops_before_jump=[0, 2])\nasync def jalr_misalignment_carry_suppresses_link(dut, nops_before_jump):\n    # The immediate consumer gets x5 from MEM/WB with no gap, and from\n    # the regfile when two NOPs move writeback before its ID cycle.\n    jump_index = 2 + nops_before_jump\n    program = [ADDI(1, 0, 17), ADDI(5, 0, 42)] + [NOP()] * nops_before_jump\n    program += [JALR(5, 1, 1), ADDI(6, 5, 1), ADD(7, 5, 5), EBREAK()]\n    rets, _ = await _run(dut, program)\n\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [i for i, r in enumerate(rets) if r[\"trap\"]] == [jump_index]\n    jump, immediate, register = rets[jump_index:jump_index + 3]\n    jump_pc = 4 * jump_index\n    assert (jump[\"rs1_addr\"], jump[\"rs1_rdata\"]) == (1, 17)\n    assert (jump[\"pc\"], jump[\"pc_next\"], jump[\"rd\"], jump[\"rd_wdata\"]) == (jump_pc, jump_pc + 4, 0, 0)\n    assert immediate[\"cycle\"] == jump[\"cycle\"] + 1\n    assert (immediate[\"rs1_addr\"], immediate[\"rs1_rdata\"]) == (5, 42)\n    assert (immediate[\"rd\"], immediate[\"rd_wdata\"]) == (6, 43)\n    assert register[\"cycle\"] == immediate[\"cycle\"] + 1\n    assert (register[\"rs1_addr\"], register[\"rs1_rdata\"]) == (5, 42)\n    assert (register[\"rs2_addr\"], register[\"rs2_rdata\"]) == (5, 42)\n    assert (register[\"rd\"], register[\"rd_wdata\"]) == (7, 84)\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n47:      <failure error_type=\"AssertionError\" error_msg=\"assert 54 == (53 + 2)\" />\n50:      <failure error_type=\"AssertionError\" error_msg=\"assert 62 == (61 + 2)\" />\n","exit_code":0,"status":"completed"}}
