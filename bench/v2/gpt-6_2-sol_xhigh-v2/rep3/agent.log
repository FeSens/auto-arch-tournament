{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c 'scratch=/srv/hwebench/tmp/5a1ea1b1/0cb059a4/bench-r3s0.Eq3jC4\nexport BENCH_HYP_SCRATCH=\"$scratch\"\nPYTHONDONTWRITEBYTECODE=1 python3 - <<'\"'PY'\nimport os\nimport shutil\nfrom pathlib import Path\nscratch = Path(os.environ['BENCH_HYP_SCRATCH'])\nrtl = Path('cores/bench/rtl')\noutput = scratch/'redirect-bypass'\nshutil.copytree(rtl, output)\npath = output/'if_stage.sv'\ns = path.read_text()\nstart = s.index('  logic [31:0] pc;')\ns = s[:start]+'''  logic [31:0] pc;\n  logic issued_q;\n  logic [31:0] sequential_addr;\n\n  assign sequential_addr = {pc[31:2] + {29'b0, issued_q}, pc[1:0]};\n  assign imem_addr = redirect ? redirect_target : sequential_addr;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      issued_q <= 1'b0;\n    end else if (redirect || \"'!stall) begin\n      pc <= imem_addr;\n      issued_q <= !stall;\n    end\n  end\n\n  assign out.pc = imem_addr;\n  assign out.instr = flush ? 32'\"'h0000_0013 : imem_data;\n  assign out.valid = \"'!flush;\nendmodule\n'\"'''\npath.write_text(s)\npath = output/'hazard_unit.sv'\ns = path.read_text()\ns = s.replace('    flush_if      = redirect || imem_stall;', '    flush_if      = imem_stall;')\ns = s.replace('    flush_id      = (load_use_hazard || redirect) && \"'!dmem_stall;'\"', '    flush_id      = load_use_hazard && \"'!dmem_stall;'\"')\ns = s.replace('  input  logic       redirect,          // EX has resolved a branch/jump\\\\n', '')\npath.write_text(s)\npath = output/'core.sv'\ns = path.read_text()\ns = s.replace('    .redirect       (redirect),\\\\n    .divide_wait', '    .divide_wait')\npath.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nimport os\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(os.environ['BENCH_HYP_SCRATCH'])\nname = 'redirect-bypass'\nresults = build_all(Path.cwd(), scratch/name, 'fpga/core_bench_si.sv', scratch/f'{name}-timing')\nprint(summarize(results))\nfor result in results:\n    print(result['place_option'], result.get('critical_paths', [])[:3])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
