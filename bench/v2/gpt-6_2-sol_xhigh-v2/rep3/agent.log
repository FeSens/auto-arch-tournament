{l+1}]) & lt_group[{l}])' for l in range(n-2,-1,-1))+';\\\\n\\\\n'\n    p.write_text(s[:start]+code+s[stop:])\nsetup('compare32',None,False,32)\nsetup('compare16',None,False,16)\nsetup('compare_shared32','predecode8',True,32)\nsetup('compare_shared8','predecode8',True,8)\nPY\npython \\\"\"'$probe/compare.py\" \"$probe\"\nfor variant in compare32 compare16 compare_shared32 compare_shared8; do\n  PYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/$variant\" > \"$probe/$variant/out.log\" 2>&1 &\ndone\nwait\nfor variant in compare32 compare16 compare_shared32 compare_shared8; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  cat \"$probe/$variant/out.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
