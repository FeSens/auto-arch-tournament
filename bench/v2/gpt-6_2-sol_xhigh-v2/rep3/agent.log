m[31:2];\n  assign fallthrough_pc.addr = in.pc.addr_plus_four;\n  assign fallthrough_pc.addr_plus_four = in.pc.addr_plus_four + 30'\"'d1;\n  assign effective_addr = pair_address ? pair_addr : (retry_q ? retry_base_q : rs1) + in.imm;\n  assign jalr_misaligned = rs1[1] \"'^ in.imm[1] ''^ (rs1[0] & in.imm[0]);\n  assign direct_jump = in.ctrl.is_jump && !in.ctrl.is_jalr;\n  assign fence_i_resolved = in.instr[6:0] == 7'\"'h0f && in.instr[14:12] == 3'b001;\n  assign jump_misaligned = in.ctrl.is_jump && (in.ctrl.is_jalr ? jalr_misaligned : in.imm[1]);\n  assign branch_taken = conditional_q && ((lo_predicate_q && hi_predicate_q) \"'^ invert_predicate_q);\n  assign direct_taken = target_aligned_q && (branch_taken || repair_to_direct_q);\n\n  logic true_mismatch, false_mismatch, repair_branch;\n  assign true_mismatch = in.direct_target_differs &&\n                         ((!in.imm[1] && (direct_jump || (conditional_branch && !invert_predicate)))\n                           != in.predicted_taken);\n  assign false_mismatch = in.direct_target_differs &&\n                          ((!in.imm[1] && (direct_jump || (conditional_branch && invert_predicate)))\n                           != in.predicted_taken);\n\n  always_ff @(posedge clock) begin\n    if (reset || repair) begin\n      repair_if_true_q <= 1'\"'b0;\n      repair_if_false_q <= 1'b0;\n      repair_jalr_q <= 1'b0;\n      fence_i_q <= 1'b0;\n    end else if (\"'!stall) begin\n      repair_if_true_q <= ex_valid && (fence_i_resolved || true_mismatch);\n      repair_if_false_q <= ex_valid && (fence_i_resolved || false_mismatch);\n      repair_jalr_q <= ex_valid && in.ctrl.is_jalr && !jalr_misaligned;\n      fence_i_q <= ex_valid && fence_i_resolved;\n    end\n\n    if (!stall && !repair) begin\n      lo_predicate_q <= lo_predicate;\n      hi_predicate_q <= hi_predicate;\n      conditional_q <= conditional_branch;\n      invert_predicate_q <= invert_predicate;\n      target_aligned_q <= !in.imm[1];\n      repair_to_direct_q <