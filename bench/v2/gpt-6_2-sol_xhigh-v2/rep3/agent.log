{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-r9s0.KF2wMe\"\ncp -r cores/bench/test \"$scratch/test\"\ncat >> \"$scratch/test/test_alu.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def divide_segmented_thresholds(dut):\n    await _setup_div(dut)\n    rng = random.Random(0x533541)\n    divisors = [4095, 4096, 4097, 4223, 4224, 4225, 16383, 16384, 16385,\n                131070, 131071, 131072, 131073, 0, 0x80000000, 0xffffffff]\n    divisors += [rng.randrange(4096, 131072) for _ in range(160)]\n    divisors += [rng.randrange(131072, 1 << 32) for _ in range(40)]\n    for b in divisors:\n        for k in range(16):\n            a = max(0, (b * k + rng.choice([-1, 0, 1]))) & MASK32\n            q, r = divmod(a, b) if b else (MASK32, a)\n            await _check_div(dut, ALU_DIVU, a, b, q)\n            await _check_div(dut, ALU_REMU, a, b, r)\n        a = rng.randrange(1 << 32)\n        q, r = divmod(a, b) if b else (MASK32, a)\n        await _check_div(dut, ALU_DIVU, a, b, q, hold_cycles=2)\n        await _check_div(dut, ALU_REMU, a, b, r)\nPY\ncd \\\"\"'$scratch\"\npytest -q test/test_alu.py -k test_div_unit_runner'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
