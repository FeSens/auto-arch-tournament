{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -c \"cat > trace_stats.py <<'PY'\nimport collections\nimport json\nimport sys\n\ncounts = collections.Counter()\nprev = None\nactive = False\nfor line in sys.stdin:\n    r = json.loads(line)\n    if r['mem_wmask']:\n        if r['mem_addr'] == 0x10000100:\n            active = True\n        if r['mem_addr'] == 0x10000104:\n            break\n    insn = r['insn']\n    op = insn & 127\n    if active:\n        counts['instructions'] += 1\n        if op == 0x33 and (insn >> 25) == 1:\n            counts[('M-extension', insn >> 12 & 7)] += 1\n        if prev and prev['insn'] & 127 == 3 and (rd := prev['rd_addr']):\n            rd1, rd2 = rd == r['rs1_addr'], rd == r['rs2_addr']\n            uses_rs1 = op in (0x67, 3, 0x13, 0x63, 0x33, 0x23)\n            uses_rs2 = op in (0x63, 0x33, 0x23)\n            if (rd1 or rd2) and not (rd1 and uses_rs1 or rd2 and uses_rs2):\n                counts['false load interlock'] += 1\n            if rd1 and uses_rs1 or rd2 and uses_rs2:\n                counts['true load interlock'] += 1\n                counts[('consumer op', f'{op:#04x}')] += 1\n                if op == 0x63:\n                    counts[('branch funct3', insn >> 12 & 7)] += 1\n                    if not r['rs2_addr']:\n                        counts[('branch with x0', insn >> 12 & 7)] += 1\n                if op == 0x23 and not rd1:\n                    counts['store data only'] += 1\n    prev = r\nfor k,n in counts.most_common():\n    print(k,n)\nPY\ncores/bench/obj_dir/cosim_sim bench/programs/coremark.elf 50000000 --istall --dstall | python trace_stats.py > trace_stats.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
