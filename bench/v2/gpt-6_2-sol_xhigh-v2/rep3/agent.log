{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"set -e\npython3 - <<'PY'\nfrom pathlib import Path\nimport os, shutil, tempfile\ntmp = Path(os.environ['TMPDIR'])\nsource=tmp/'bench-redirect-lazy.6Si9ua'\nfor label in ['mux', 'chunk']:\n    root=Path(tempfile.mkdtemp(prefix=f'bench-redirect-{label}.', dir=tmp))\n    for sub in ['fpga','test/cosim','cores/bench/rtl','bench/programs']:\n        dst=root/sub\n        dst.parent.mkdir(parents=True, exist_ok=True)\n        shutil.copytree(source/sub,dst,copy_function=shutil.copyfile)\n    shutil.copyfile(source/'cores/bench/core.yaml', root/'cores/bench/core.yaml')\n    shutil.copyfile(source/'Makefile', root/'Makefile')\n    p=root/'cores/bench/rtl/if_stage.sv'\n    s=p.read_text()\n    s=s.replace('  logic        bump_q;', '  logic        bump_q, pc_update;')\n    s=s.replace('  always_ff @(posedge clock)', \\\"  assign pc_update = \"'!stall || (redirect && advance_redirect);'\"\\\\n\\\\n  always_ff @(posedge clock)\\\")\n    s=s.replace(\\\"\\\"\\\"    end else if (redirect && advance_redirect) begin\n      base_word_q <= redirect_target[31:2];\n      bump_q <= \"'!stall;\n    end else if (!stall) begin\n      base_word_q <= sequential_word;\n      bump_q <= 1'\"'b1;\n\\\"\\\"\\\",\\\"\\\"\\\"    end else if (pc_update) begin\n      base_word_q <= imem_addr[31:2];\n      bump_q <= \"'!stall;\n\"\"\")\n    if label=='\"'chunk':\n        s=s.replace(\\\"  assign sequential_word = base_word_q + {29'b0, bump_q};\\\", \\\"\\\"\\\"  assign sequential_word[5:0] = base_word_q[5:0] + {5'b0, bump_q};\n  for (genvar i = 6; i < 30; i += 6) begin : gen_seq_word\n    logic carry_in;\n    assign carry_in = bump_q && (&base_word_q[i-1:0]);\n    assign sequential_word[i+:6] = base_word_q[i+:6] + {5'b0, carry_in};\n  end\\\"\\\"\\\")\n    p.write_text(s)\n    print(label,root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
