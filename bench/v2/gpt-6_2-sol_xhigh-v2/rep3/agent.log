{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nrtl = Path('cores/bench/rtl')\ndef replace(name, replacements):\n    p = rtl / name\n    s = p.read_text()\n    for old, new in replacements:\n        assert s.count(old) == 1, (name, old, s.count(old))\n        s = s.replace(old, new, 1)\n    p.write_text(s)\nreplace('core_pkg.sv', [\n    ('  // IF -> ID combinational bundle', '''  typedef struct packed {\n    logic       hit;\n    logic [1:0] counter;\n    logic       predicted_taken;\n  } prediction_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] target;\n    logic        valid;\n    logic        taken;\n    logic        jump;\n    prediction_t prediction;\n  } btb_update_t;\n\n  // IF -> ID combinational bundle'''),\n    ('    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } if_id_t;', '    logic [31:0] instr;\\\\n    prediction_t prediction;\\\\n    logic        valid;\\\\n  } if_id_t;'),\n    ('    logic [31:0] instr;\\\\n    logic        valid;\\\\n  } id_ex_t;', '    logic [31:0] instr;\\\\n    prediction_t prediction;\\\\n    logic        valid;\\\\n  } id_ex_t;'),\n])\nreplace('id_stage.sv', [\n    ('      reg_q.instr        <= in.instr;', '      reg_q.instr        <= in.instr;\\\\n      reg_q.prediction   <= in.prediction;'),\n])\nreplace('if_stage.sv', [\n    ('  output logic [31:0]       imem_addr,','''  input  prediction_t  prediction,\n  input  logic [31:0]       predicted_target,\n  output logic [31:0]       imem_addr,'''),\n    ('  // A valid EX redirect', '  logic [31:0] pc_plus_four;\\\\n  assign pc_plus_four = pc + 32\\\\'d4;\\\\n\\\\n  // A valid EX redirect'),\n    (\\\"    else if (\"'!stall)   pc <= pc + 32'\"'d4;\\\", \\\"    else if (\"'!stall)   pc <= prediction.predicted_taken ? predicted_target : pc_plus_four;\"),\n    ('\"'    out.valid = imem_ready;', '''    out.valid = imem_ready;\n    out.prediction = prediction;\n    out.prediction.predicted_taken = prediction.predicted_taken && predicted_target \"'!= pc_plus_four;'\"'''),\n])\nreplace('ex_stage.sv', [\n    ('  output logic [31:0]        redirect_target','''  input  logic [31:0]        fetch_pc,\n  output btb_update_t          btb_update,\n  output logic [31:0]        redirect_target'''),\n    ('''  assign redirect_target = in.ctrl.is_jalr ? {effective_addr[31:1], 1'b0} : direct_target;''', '''  logic [31:0] jalr_target, taken_target;\n  assign jalr_target = {effective_addr[31:1], 1'b0};\n  assign taken_target = in.ctrl.is_jalr ? jalr_target : direct_target;'''),\n    ('''  assign redirect = ex_valid && \"'!stall && control_taken && !target_misaligned;'\"''', '''  logic take_transfer, wrong_target;\n  assign take_transfer = control_taken && \"'!target_misaligned;\n  assign wrong_target = in.ctrl.is_jalr ? jalr_target != fetch_pc : direct_target != fetch_pc;\n  assign redirect_target = take_transfer ? taken_target : pc_plus_four;\n  assign redirect = ex_valid && !stall &&\n                    (take_transfer ? wrong_target : in.prediction.predicted_taken);\n\n  assign btb_update.valid = ex_valid && !stall && !in.ctrl.is_illegal &&\n                            !target_misaligned && (in.ctrl.is_branch || in.ctrl.is_jump);\n  assign btb_update.pc = in.pc;\n  assign btb_update.target = taken_target;\n  assign btb_update.taken = control_taken;\n  assign btb_update.jump = in.ctrl.is_jump;\n  assign btb_update.prediction = in.prediction;'\"'''),\n    ('      reg_q.pc_next       <= redirect ? redirect_target : pc_plus_four;', '      reg_q.pc_next       <= redirect_target;'),\n])\nreplace('core.sv', [\n    ('  // regfile interface', '''  prediction_t prediction;\n  btb_update_t btb_update;\n  logic [31:0] predicted_target;\n\n  // regfile interface'''),\n    ('  // ── IF', '''  branch_predictor u_predictor (\n    .clock(clock),\n    .reset(reset),\n    .fetch_pc(io_imemAddr),\n    .prediction(prediction),\n    .predicted_target(predicted_target),\n    .update(btb_update)\n  );\n\n  // ── IF'''),\n    ('    .imem_addr       (io_imemAddr),','''    .prediction      (prediction),\n    .predicted_target (predicted_target),\n    .imem_addr       (io_imemAddr),'''),\n    ('    .divide_wait     (divide_wait),', '''    .fetch_pc        (io_imemAddr),\n    .btb_update      (btb_update),\n    .divide_wait     (divide_wait),'''),\n])\n(rtl / 'branch_predictor.sv').write_text(\\\"\\\"\\\"module branch_predictor (\n  input  logic          clock,\n  input  logic          reset,\n  input  logic [31:0]   fetch_pc,\n  output prediction_t   prediction,\n  output logic [31:0]   predicted_target,\n  input  btb_update_t   update\n);\n  localparam int INDEX_BITS = 5;\n  localparam int TAG_BITS = 7;\n  localparam int ENTRIES = 1 << INDEX_BITS;\n  localparam int TAG_LO = 2 + INDEX_BITS;\n\n  typedef struct packed {\n    logic [TAG_BITS-1:0] tag;\n    logic [1:0] counter;\n    logic [17:0] target;\n  } entry_t;\n\n  typedef struct packed {\n    logic valid;\n    logic [INDEX_BITS-1:0] index;\n    logic [TAG_BITS-1:0] tag;\n    logic [1:0] counter;\n  } write_meta_t;\n\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) entry_t entries [0:ENTRIES-1];\n  logic [ENTRIES-1:0] valid_q;\n  logic [INDEX_BITS-1:0] fetch_index, write_index;\n  entry_t fetch_entry, next_entry;\n  btb_update_t update_q;\n  write_meta_t last_write_q, older_write_q;\n\n  assign fetch_index = fetch_pc[2 +: INDEX_BITS];\n  assign fetch_entry = entries[fetch_index];\n  assign prediction.hit = valid_q[fetch_index] && fetch_pc[31:20] == 0 &&\n                          fetch_pc[1:0] == 0 && fetch_entry.tag == fetch_pc[TAG_LO +: TAG_BITS];\n  assign prediction.counter = fetch_entry.counter;\n  assign prediction.predicted_taken = prediction.hit && fetch_entry.counter[1];\n  assign predicted_target = {12'b0, fetch_entry.target, 2'b00};\n  assign write_index = update_q.pc[2 +: INDEX_BITS];\n\n  logic hit, write_entry;\n  logic [1:0] previous_counter, coun