1;\n             fetch_blocked = false;\n             room = true;\n        } else if (!queue.empty() && !hold) {\n            auto& head = queue.front();\n            bool ready = true;\n            if (exi && exi->divide() && divide_phase != 8) ready = false;\n            if (exi && exi->load() && trace[head.tail].rs_match(exi->rd())) ready = false;\n            if (ready) {\n                incoming = {head.tail, head.tail == head.head && head.repair};\n                if (++head.tail == head.end) queue.pop_front();\n            }\n        }\n        if (ir && room && !fetch_blocked && fetch_idx < int(trace.size())) {\n            const auto& f = trace[fetch_idx];\n            const auto e = table[(f.pc>>2) & (size-1)];\n            const bool hit = e.pc == f.pc && e.len && (f.opcode() == 0x63 || f.opcode() == 0x6f);\n            const int counter = direction[(f.pc>>2) & 127];\n            const bool pred_dir = hit && (f.opcode() == 0x6f || counter >= 2 ||\n                                        (counter < 0 && (f.bits >> 31)));\n            const bool wrong = f.jalr() || (f.direct() != pred_dir)\n                             || (pred_dir && f.next_pc != e.dest) || f.fence_i();\n            int words = pred_dir && !wrong ? e.len : 0;\n            if (wrong) { fetch_blocked = true; miss_count += counted; }\n            if (words) { hit_count += counted; replay_count += counted ? words : 0; }\n            for (int i=0;i<words;++i) {\n                if (trace[fetch_idx+i+1].pc != e.dest + 4*i || control(trace[fetch_idx+i+1])) {\n                    fprintf(stderr,\"unexpected replay pc'\"\\\\\\\\n\\\"); exit(1);\n                }\n            }\n            queue.push_back({fetch_idx, fetch_idx, fetch_idx+1+words, wrong});\n            fetch_idx += 1+words;\n        }\n        if (update.pc \"'!= -1u) table[(update.pc>>2)&(size-1)] = update;\n        update = {};\n        if (memi && !hold && !repair_now) {\n            if (fill.source >= 0) {\n                const bool valid_word = mem.index == fill.next + fill.words && !control(*memi);\n                if (valid_word) ++fill.words;\n                if (!valid_word || fill.words == max_words) {\n                    if (fill.words != 0) update = {trace[fill.source].pc,trace[fill.source].next_pc,fill.words};\n                    fill = {};\n                }\n            }\n            if (memi->direct()) fill = {mem.index, mem.index+1,0};\n            if (memi->opcode() == 0x63) {\n                auto& c = direction[(memi->pc>>2)&127];\n                if (c<0) c=memi->direct()?2:1;\n                else c=memi->direct()?(c<3?c+1:3):(c>0?c-1:0);\n            }\n        }\n        const bool div_wait = exi && exi->divide() && divide_phase != 8;\n        if (exi && exi->divide()) {\n            if ((divide_phase == 0 && !hold) || (divide_phase > 0 && divide_phase < 8)) ++divide_phase;\n            else if (divide_phase == 8 && !hold) divide_phase = 0;\n        }\n        if (repair_now) {\n            ex = {};\n            repair = false;\n        } else if (!hold) {\n            mem = div_wait ? Word{} : ex;\n            repair = mem.repair;\n            if (!div_wait) ex = incoming;\n        }\n    }\n    printf(\"%3d %2d  %u %u %u  hits=%d words=%d repairs=%d'\"\\\\\\\\n\\\",size,max_words,start,stop,stop-start,hit_count,replay_count,miss_count);\n}\n\nint main(int argc, char** argv) {\n    FILE* input = fopen(argv[1], \\\"rb\\\");\n    if (\"'!input) return 1;\n    std::vector<Instruction> trace;\n    for (Instruction record; fread(&record, sizeof record, 1, input); ) trace.push_back(record);\n    for (int size : {32, 64, 128}) {\n        for (int words : {1, 2, 4, 6, 8}) run(trace,size,words);\n    }\n}\n'\"''')\nPY\ng++ -O3 '/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/packet_model.cpp' -o '/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/packet_model' && '/srv/hwebench/tmp/5a1ea1b1/aedc2df2/target-replay-profile.BUkyIP/packet_model