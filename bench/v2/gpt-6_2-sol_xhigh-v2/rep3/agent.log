ools/eval/gowin.py:35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\ntools/eval/gowin.py:133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\nCORE_PHILOSOPHY.md\nLESSONS.md\ncore.yaml\nexperiments\nrtl\ntest\ngowin\nhwe-python\nhwe-toolchain\n","exit_code":0,"status":"completed"}}
