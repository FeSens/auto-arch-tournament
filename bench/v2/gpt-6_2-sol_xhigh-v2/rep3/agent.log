{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"sed -n '1,120p' cores/bench/rtl/reg_file.sv; sed -n '1,100p' formal/checks_si.cfg\"","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// Reset clears only the written bitmap. Unwritten words read as zero,\n// allowing the payload to infer distributed RAM without reset logic.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs [0:31];\n  logic [31:0] written_q;\n  logic        write_en;\n  logic        rs1_nonzero, rs2_nonzero;\n  logic        rs1_bypass, rs2_bypass;\n  logic        rs1_ram_en, rs2_ram_en;\n\n  assign write_en = w_en && (w_addr != 5'd0);\n\n  always_ff @(posedge clock) begin\n    if (write_en) regs[w_addr] <= w_data;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)         written_q <= '0;\n    else if (write_en) written_q[w_addr] <= 1'b1;\n  end\n\n  assign rs1_nonzero = (rs1_addr != 5'd0);\n  assign rs2_nonzero = (rs2_addr != 5'd0);\n  assign rs1_bypass  = rs1_nonzero && w_en && (w_addr == rs1_addr);\n  assign rs2_bypass  = rs2_nonzero && w_en && (w_addr == rs2_addr);\n  assign rs1_ram_en  = rs1_nonzero && written_q[rs1_addr] && !rs1_bypass;\n  assign rs2_ram_en  = rs2_nonzero && written_q[rs2_addr] && !rs2_bypass;\n\n  assign rs1_data = ({32{rs1_bypass}} & w_data) | ({32{rs1_ram_en}} & regs[rs1_addr]);\n  assign rs2_data = ({32{rs2_bypass}} & w_data) | ({32{rs2_ram_en}} & regs[rs2_addr]);\n\nendmodule\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n","exit_code":0,"status":"completed"}}
