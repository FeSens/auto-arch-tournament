{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c 'python3 - \"$TMPDIR/bench-r7s1-profile-vKuZvg1B/trace.jsonl.gz\" <<'\"'PY'\nfrom collections import Counter\nimport gzip\nimport json\nimport sys\n\nprev = None\non = False\ninsns = Counter()\nraw_deps = Counter()\ntrue_deps = Counter()\ngap_on_raw = Counter()\ndef classify(word):\n    op, funct3, funct7 = word & 127, (word >> 12) & 7, word >> 25\n    if op == 3:\n        return 'load'\n    if op == 0x33 and funct7 == 1:\n        return 'mul' if funct3 < 4 else 'div'\n    if op in (0x13, 0x33):\n        if funct3 in (1,5):\n            return 'shift'\n        if funct3 in (2,3):\n            return 'slt'\n        if funct3 in (4,6,7):\n            return 'logic'\n        return 'add/sub'\n    return hex(op)\nfor line in gzip.open(sys.argv[1], 'rt'):\n    row = json.loads(line)\n    if row.get('ebreak'):\n        print({k:v for k,v in row.items() if k \"'!= '\"'uart'}, flush=True)\n        break\n    if 'cycle' not in row:\n        continue\n    if row['mem_wmask'] and row['mem_addr'] == 0x10000100:\n        on = True\n    if row['mem_wmask'] and row['mem_addr'] == 0x10000104:\n        on = False\n    if not on:\n        continue\n    word = row['insn']\n    opcode = word & 127\n    insns[classify(word)] += 1\n    if prev and prev['rd_addr']:\n        name = classify(prev['insn'])\n        r1, r2 = (word >> 15) & 31, (word >> 20) & 31\n        rd = prev['rd_addr']\n        if rd in (r1,r2):\n            raw_deps[name] += 1\n            gap_on_raw[name, row['cycle'] - prev['cycle']] += 1\n        use_r1 = opcode in (3,0x13,0x23,0x33,0x63,0x67)\n        use_r2 = opcode in (0x23,0x33,0x63)\n        if (use_r1 and rd == r1) or (use_r2 and rd == r2):\n            true_deps[name] += 1\n    prev = row\nprint(insns)\nprint(raw_deps)\nprint(true_deps)\nprint({n:[gap_on_raw[n,d] for d in range(1,6)] for n in ('load','mul','shift','slt','logic','div')})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
