{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\npython - \"$probe\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\nroot=Path(sys.argv[1])\norigin=root/'compare_shared8/rtl'\nfor name, l in [('compare_prequal',False),('compare_prequal_shift',True)]:\n    dest=root/name/'rtl'\n    copytree(origin,dest,dirs_exist_ok=True)\n    p=dest/'id_stage.sv'\n    s=p.read_text().replace('assign branch_sel.signed_compare = \"'!dec_branch_op[1];'\"',\n        \\\"assign branch_sel.signed_compare = (dec_is_branch && \"'!dec_branch_op[1]) || dec_alu_op == ALU_SLT;\")\n    p.write_text(s)\n    p=dest/'\"'ex_stage.sv'\n    s=p.read_text().replace('(in.branch_sel.enable ? in.branch_sel.signed_compare : in.integer_sel.slt_op)', 'in.branch_sel.signed_compare')\n    if l:\n        s=s.replace('''assign signed_shift_input = \"'$signed({in.integer_sel.arithmetic_right && rs1[31], rs1});'\"''',\n      '''assign signed_shift_input = \"'$signed({in.integer_sel.arithmetic_right && rs1[31], ({32{in.integer_sel.right_op}} & rs1)});'\"''')\n        s=s.replace('assign shift_left = rs1 << alu_b[4:0];', 'assign shift_left = ({32{in.integer_sel.sll_op}} & rs1) << alu_b[4:0];')\n        s=s.replace('assign shift_logic = ({32{in.integer_sel.sll_op}} & shift_left)\\\\n                     | ({32{in.integer_sel.right_op}} & shift_right);',\n        'assign shift_logic = shift_left | shift_right;')\n    p.write_text(s)\nPY\nfor variant in compare_prequal compare_prequal_shift; do\n  PYTHONPATH=\\\"\"'$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/$variant\" > \"$probe/$variant/out.log\" 2>&1 &\ndone\nwait\nfor variant in compare_prequal compare_prequal_shift; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  cat \"$probe/$variant/out.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
