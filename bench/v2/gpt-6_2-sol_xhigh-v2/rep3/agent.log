imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef LUI (rd, imm):       return (imm & 0xFFFFF000) | (rd << 7) | 0b0110111\ndef ADDI(rd, rs1, imm): re\n…[9589 of 12661 chars elided by tools/bench/transcript.py; sha256:000a79ee097f43d0]…\nftest.py\n-rw-rw----+ 1 nobody nogroup  8217 Nov 20 23:30 test_alu.py\n-rw-rw----+ 1 nobody nogroup 11218 Nov 20 23:30 test_decoder.py\n-rw-rw----+ 1 nobody nogroup  2478 Nov 20 23:30 test_imm_gen.py\n-rw-rw----+ 1 nobody nogroup 27208 Nov 20 23:30 test_pipeline.py\n-rw-rw----+ 1 nobody nogroup  3351 Nov 20 23:30 test_reg_file.py\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\ntotal 56\ndrwxrwx---+  2 nobody nogroup  4096 Nov 20 23:30 .\ndrwxrwx---+ 12 nobody nogroup  4096 Nov 20 23:30 ..\n-rw-rw----+  1 nobody nogroup  2630 Nov 20 23:30 checks-deep.cfg\n-rw-rw----+  1 nobody nogroup  2658 Nov 20 23:30 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 20 23:30 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    66 Nov 20 23:30 riscv-formal -> /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep3/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 20 23:30 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 20 23:30 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 20 23:30 wrapper_si.sv\n", "exit_code": 0, "status": "completed"}}
