k_eq[3:1]) & chunk_lt[0]);\n  assign signed_lt = (rs1[31] \"'^ rs2[31]) ? rs1[31] : unsigned_lt;\n\n  always_comb begin\n    case (in.ctrl.branch_op)'\"'''),\n    ('(rs1 == rs2)', 'compare_eq'),\n    ('(rs1 \"'!= rs2)'\"', '\"'!compare_eq'\"'),\n    ('(\"'$signed(rs1) <  $signed(rs2))'\"', 'signed_lt'),\n    ('(\"'$signed(rs1) >= $signed(rs2))'\"', '\"'!signed_lt'\"'),\n    ('(rs1 <  rs2)', 'unsigned_lt'),\n    ('(rs1 >= rs2)', '\"'!unsigned_lt'\"'),\n    ('''  logic take_transfer;\n  logic [31:0] resolved_successor;\n  assign take_transfer = control_taken && \"'!target_misaligned;\n  assign resolved_successor = take_transfer ? taken_target : pc_plus_four;'\"''', '''  logic direct_taken, indirect_taken, fall_through;\n  logic [31:0] resolved_successor;\n  assign direct_taken = control_taken && \"'!in.ctrl.is_jalr && !in.imm[1];\n  assign indirect_taken = in.ctrl.is_jalr && !target_misaligned;\n  assign fall_through = !(direct_taken || indirect_taken);\n  assign resolved_successor = ({32{direct_taken}} & direct_target)\n                            | ({32{indirect_taken}} & jalr_target)\n                            | ({32{fall_through}} & pc_plus_four);'\"'''),\n    ('''  logic wrong_target;\n  assign wrong_target = in.ctrl.is_jalr ? jalr_target \"'!= fetch_pc : direct_target != fetch_pc;\n  always_ff @(posedge clock) begin\n    if (reset) mismatch <= 1'\"'b0;\n    else if (\"'!stall)\n      mismatch <= ex_valid && (take_transfer ? wrong_target : in.prediction.predicted_taken);\n  end'\"''', '''  logic wrong_successor;\n  assign wrong_successor = (direct_taken && direct_target \"'!= fetch_pc)\n                        || (indirect_taken && jalr_target != fetch_pc)\n                        || (fall_through && in.prediction.predicted_taken);\n  always_ff @(posedge clock) begin\n    if (reset) mismatch <= 1'\"'b0;\n    else if (\"'!stall) mismatch <= ex_valid && wrong_successor;\n  end'\"'''),\n])\npatch('fast-compare','core.sv',[\n    ('  logic        redirect, mismatch;