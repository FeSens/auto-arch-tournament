{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil, os\n\nstudy = Path(os.environ['TMPDIR'])/'r7s0-study'\ndef update(file, replacements):\n    path = rtl / file\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (file, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nfor basis, name in [('preselect','lanefit'), ('flat','laneflat')]:\n    rtl = study/name\n    shutil.copytree(study/basis, rtl, dirs_exist_ok=True)\n    update('id_stage.sv', [\n        ('''      if (dec_is_jump || dec_is_auipc) begin\n        result_sel.other = 1'b1;''','''      if (dec_is_jump || dec_is_auipc) begin\n        result_sel.add = 1'b1;'''),\n        (\\\"          ALU_SUB:                      result_sel.sub      = 1'b1;\\\",\n         \\\"          ALU_SUB, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU: result_sel.sub = 1'b1;\\\"),\n    ])\n    update('ex_stage.sv', [\n        ('''      reg_q.result.add    <= add_result;\n      reg_q.result.sub    <= sub_result;\n      // Jumps, AUIPC and divides have no base ALU other result.\n      reg_q.result.other  <= other_result\n                           | ({32{in.ctrl.is_auipc}} & {direct_pc.addr, 2'b00})\n                           | ({32{in.ctrl.is_jump}}  & {pc.addr_plus_four, 2'b00})\n                           | ({32{divide}}           & div_result);''',\n         '''      reg_q.result.add    <= ({32{\"'!in.ctrl.is_auipc && !in.ctrl.is_jump}} & add_result)\n                           | ({32{in.ctrl.is_auipc}} & {direct_pc.addr, 2'\"'b00})\n                           | ({32{in.ctrl.is_jump}}  & {pc.addr_plus_four, 2'b00});\n      reg_q.result.sub    <= divide ? div_result : sub_result;\n      reg_q.result.other  <= other_result;'''),\n    ])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/r7s0-study/synth.py\" lanefit'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
