{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"cores/bench/obj_dir/cosim_sim bench/programs/coremark.elf 50000000 --bench --istall --dstall | tail -n 1 > baseline.marker\ncat baseline.marker\ncores/bench/obj_dir/cosim_sim bench/programs/coremark.elf 50000000 --istall --dstall | python -c '\nimport collections, json, sys\nmarker = json.load(open(\\\"baseline.marker\\\"))\nstart = marker[\\\"bench_start_cycle\\\"]\nstop = marker[\\\"bench_stop_cycle\\\"]\ncount = collections.Counter()\nlast=None\nfor line in sys.stdin:\n    row=json.loads(line)\n    if not start <= row.get(\\\"cycle\\\",0) <= stop: continue\n    insn=row[\\\"insn\\\"]\n    op=insn&127\n    if last and last[\\\"mem_rmask\\\"] and last[\\\"rd_addr\\\"]:\n        rd=last[\\\"rd_addr\\\"]\n        a=row[\\\"rs1_addr\\\"]==rd\n        b=row[\\\"rs2_addr\\\"]==rd\n        if a or b:\n            count[(\\\"raw\\\",op)] += 1\n            if row[\\\"cycle\\\"] == last[\\\"cycle\\\"]+2: count[(\\\"raw-1gap\\\",op)]+=1\n            uses_a=op in (0x33,0x13,3,0x23,0x63,0x67)\n            uses_b=op in (0x33,0x23,0x63)\n            if not ((a and uses_a) or (b and uses_b)): count[(\\\"false\\\",op)] += 1\n            if a and uses_a and not (b and uses_b): count[(\\\"real-rs1\\\",op)] += 1\n            if not (a and uses_a) and b and uses_b: count[(\\\"real-rs2\\\",op)] += 1\n            if op==0x33 or op==0x13: count[(\\\"arith\\\",op, (insn>>12)&7, a, b)] += 1\n    last=row\nfor k,v in count.most_common(110): print(k,v)\n' > load-use-profile.log\ncat load-use-profile.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
