{"type":"item.completed","item":{"id":"item_44","type":"agent_message","text":"The divider prototypes preserved the cycle count, but the fastest reached 97.332 MHz. The timing reports showed the EX shifter and branch redirect taking over as bottlenecks. I’ll test a narrower change to the execute control path before choosing the final proposal."}}
{"type": "item.started", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/ex_controls.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nroot = Path(sys.argv[1])\nbase = Path('cores/bench/rtl')\ndef variant(name, width=8, alu=True, compact_branch=True, divider_variant=None):\n    output = root/name/'rtl'\n    copytree(base,output,dirs_exist_ok=True)\n    pkg = (base/'core_pkg.sv').read_text()\n    ident = (base/'id_stage.sv').read_text()\n    ex = (base/'ex_stage.sv').read_text()\n    decoder = (base/'decoder.sv').read_text()\n    if divider_variant:\n        (output/'div_unit.sv').write_text((root/divider_variant/'rtl/div_unit.sv').read_text())\n    if compact_branch:\n        pkg = pkg.replace('''    logic eq;\n    logic ne;\n    logic lt;\n    logic ge;\n    logic signed_compare;''','''    logic enable;\n    logic order_compare;\n    logic invert_predicate;\n    logic signed_compare;''')\n        start=ident.index('  assign branch_sel.eq')\n        stop=ident.index('  result_sel_t result_sel;',start)\n        ident=ident[:start]+'''  assign branch_sel.enable = dec_is_branch;\n  assign branch_sel.order_compare = dec_branch_op[2];\n  assign branch_sel.invert_predicate = dec_branch_op[0];\n  assign branch_sel.signed_compare = \"'!dec_branch_op[1];\n\n'\"'''+ident[stop:]\n        n = 32//width\n        assert n*width == 32\n        ex = ex.replace('logic [3:0]  byte_equal, byte_less;', f'logic [{n-1}:0]  group_equal, group_less;')\n        start=ex.index('  for (genvar i = 0; i < 4;')\n        stop=ex.index('  assign pc =',start)\n        ex=ex[:start]+f'''  for (genvar i = 0; i < {n}; i++) begin : gen_branch_compare\n    assign group_equal[i] = rs1[{width}*i +: {width}] == rs2[{width}*i +: {width}];\n    assign group_less[i] = rs1[{width}*i +: {width}] < rs2[{width}*i +: {width}];\n  end\n  assign branch_equal = &group_equal;\n  assign branch_less = (group_less[{n-1}] \"'^ (in.branch_sel.signed_compare && (rs1[31] != rs2[31])))\n                    '\"''' + ''.join(f'\\\\n                     | ((&group_equal[{n-1}:{l+1}]) & group_less[{l}])' for l in range(n-2,-1,-1)) + f''';\n\n'''+ex[stop:]\n        start=ex.index('  assign branch_taken =')\n        stop=ex.index('  assign direct_taken',start)\n        ex=ex[:start]+'''  assign branch_taken = in.branch_sel.enable &&\n                        ((in.branch_sel.order_compare ? branch_less : branch_equal) \"'^ in.branch_sel.invert_predicate);\n'\"'''+ex[stop:]\n    if alu:\n        pkg = pkg.replace('  // Aligned fetch addresses','''  typedef struct packed {\n    logic and_op, or_op, xor_op, slt_op, sltu_op;\n    logic sll_op, right_op, arithmetic_right, lui_op;\n  } integer_sel_t;\n\n  // Aligned fetch addresses''').replace('    branch_sel_t branch_sel;', '    branch_sel_t branch_sel;\\\\n    integer_sel_t integer_sel;')\n        ident = ident.replace('  result_sel_t result_sel;', '''  integer_sel_t integer_sel;\n  assign integer_sel.and_op           = dec_alu_op == ALU_AND;\n  assign integer_sel.or_op            = dec_alu_op == ALU_OR;\n  assign integer_sel.xor_op           = dec_alu_op == ALU_XOR;\n  assign integer_sel.slt_op           = dec_alu_op == ALU_SLT;\n  assign integer_sel.sltu_op          = dec_alu_op == ALU_SLTU;\n  assign integer_sel.sll_op           = dec_alu_op == ALU_SLL;\n  assign integer_sel.right_op         = dec_alu_op == ALU_SRL || dec_alu_op == ALU_SRA;\n  assign integer_sel.arithmetic_right = dec_alu_op == ALU_SRA;\n  assign integer_sel.lui_op           = dec_alu_op == ALU_LUI;\n\n  result_sel_t result_sel;''').replace('      reg_q.branch_sel   <= branch_sel;', '      reg_q.branch_sel   <= branch_sel;\\\\n      reg_q.integer_sel  <= integer_sel;')\n        start=ex.index('  logic [31:0] add_result')\n        stop=ex.index('  logic [63:0] product;',start)\n        ex=ex[:start]+'''  logic [31:0] add_result, sub_result;\n  assign add_result = rs1 + alu_b;\n  assign sub_result = rs1 - alu_b;\n\n  logic [31:0] shift_left, shift_right;\n  logic [31:0] bitwise_logic, shift_logic, misc_logic;\n  logic signed [32:0] signed_shift_input;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [32:0] signed_shift_result;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign signed_shift_input = \"'$signed({in.integer_sel.arithmetic_right && rs1[31], rs1});\n  assign signed_shift_result = signed_shift_input >>> alu_b[4:0];\n  assign shift_left = rs1 << alu_b[4:0];\n  assign shift_right = signed_shift_result[31:0];\n  assign shift_logic = ({32{in.integer_sel.sll_op}} & shift_left)\n                     | ({32{in.integer_sel.right_op}} & shift_right);\n  assign bitwise_logic = ({32{in.integer_sel.and_op}} & (rs1 & alu_b))\n                       | ({32{in.integer_sel.or_op}} & (rs1 | alu_b))\n                       | ({32{in.integer_sel.xor_op}} & (rs1 ''^ alu_b));\n  assign misc_logic = ({32{in.integer_sel.lui_op}} & alu_b)\n                    | {31'\"'d0, (in.integer_sel.slt_op && \"'$signed(rs1) < $signed(alu_b))\n                           || (in.integer_sel.sltu_op && rs1 < alu_b)};\n\n'\"'''+ex[stop:]\n        ex=ex.replace('reg_q.result.other  <= other_result','reg_q.result.other  <= shift_logic | bitwise_logic | misc_logic')\n    for file, source in [('core_pkg.sv',pkg),('id_stage.sv',ident),('ex_stage.sv',ex),('decoder.sv',decoder)]:\n        (output/file).write_text(source)\nvariant('compact8', 8, False)\nvariant('compact4', 4, False)\nvariant('predecode8', 8, True)\nvariant('predecode4', 4, True)\nPY\npython \\\"\"'$probe/ex_controls.py\" \"$probe\"\nfor variant in compact8 compact4 predecode8 predecode4; do\n  PYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/$variant\" > \"$probe/$variant/out.log\" 2>&1 &\ndone\nwait\nfor variant in compact8 compact4 predecode8 predecode4; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  cat \"$probe/$variant/out.log\"\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/fast_shift.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nroot=Path(sys.argv[1])\nfor source_name in ('predecode4','predecode8'):\n    variant=root/(source_name+'_radix4')\n    copytree(root/source_name/'rtl',variant/'rtl',dirs_exist_ok=True)\n    path=variant/'rtl/ex_stage.sv'\n    ex=path.read_text()\n    start=ex.index('  logic [31:0] shift_left')\n    stop=ex.index('  assign bitwise_logic',start)\n    code='''  logic [31:0] shift_left, shift_right;\n  logic [31:0] bitwise_logic, shift_logic, misc_logic;\n  logic [31:0] left_4, left_16, right_4, right_16;\n  logic [3:0] sel_low, sel_high;\n  logic sign_bit;\n  assign sign_bit = in.integer_sel.arithmetic_right && rs1[31];\n  for (genvar amount = 0; amount < 4; amount++) begin : gen_shamt\n    assign sel_low[amount] = alu_b[1:0] == 2'(amount);\n    assign sel_high[amount] = alu_b[3:2] == 2'(amount);\n  end\n  assign left_4 = ({32{sel_low[0]}} & rs1)\n                | ({32{sel_low[1]}} & (rs1 << 1))\n                | ({32{sel_low[2]}} & (rs1 << 2))\n                | ({32{sel_low[3]}} & (rs1 << 3));\n  assign right_4 = ({32{sel_low[0]}} & rs1)\n                 | ({32{sel_low[1]}} & {   sign_bit,   rs1[31:1]})\n                 | ({32{sel_low[2]}} & {{2{sign_bit}}, rs1[31:2]})\n                 | ({32{sel_low[3]}} & {{3{sign_bit}}, rs1[31:3]});\n  assign left_16 = ({32{sel_high[0]}} & left_4)\n                 | ({32{sel_high[1]}} & (left_4 << 4))\n                 | ({32{sel_high[2]}} & (left_4 << 8))\n                 | ({32{sel_high[3]}} & (left_4 << 12));\n  assign right_16 = ({32{sel_high[0]}} & right_4)\n                  | ({32{sel_high[1]}} & {{4{sign_bit}},  right_4[31:4]})\n                  | ({32{sel_high[2]}} & {{8{sign_bit}},  right_4[31:8]})\n                  | ({32{sel_high[3]}} & {{12{sign_bit}}, right_4[31:12]});\n  assign shift_left = alu_b[4] ? (left_16 << 16) : left_16;\n  assign shift_right = alu_b[4] ? {{16{sign_bit}}, right_16[31:16]} : right_16;\n  assign shift_logic = ({32{in.integer_sel.sll_op}} & shift_left)\n                     | ({32{in.integer_sel.right_op}} & shift_right);\n'''\n    path.write_text(ex[:start]+code+ex[stop:])\nPY\npython \\\"\"'$probe/fast_shift.py\" \"$probe\"\nfor variant in predecode4_radix4 predecode8_radix4; do\n  PYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/$variant\" > \"$probe/$variant/out.log\" 2>&1 &\ndone\nwait\nfor variant in predecode4_radix4 predecode8_radix4; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  cat \"$probe/$variant/out.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\nfor variant in compact8 compact4 predecode8 predecode4 predecode8_radix4 predecode4_radix4; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  if test -s \"$probe/$variant/out.log\"; then rg '\"'\"'^0 |''^1 |''^2 |''^Median|FAILED|ERROR'\"' \\\"\"'$probe/$variant/out.log\"; else for f in \"$probe/$variant\"/timing/gowin_p*/gw.log; do tail -n 1 \"$f\"; done; fi\ndone\ndate -u'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
