{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/tiers.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nbase = Path('cores/bench/rtl')\nroot = Path(sys.argv[1])\n\ndef recurrence(name, dividend, divisor, remainder_width, rbits, quotient_width, init_hi, common_setup):\n    trial_width = remainder_width + rbits\n    candidates = (1<<rbits) - 1\n    selected_width = candidates + 1\n    pieces = [f'''\n  logic [{remainder_width-1}:0] {name}_remainder_q, {name}_next;\n  logic [{quotient_width-1}:0] {name}_quotient_q;\n  logic [{trial_width-1}:0] {name}_trial;\n  logic [{trial_width-1}:0] {name}_multiple_q [1:{candidates}];\n  logic [{trial_width-1}:0] {name}_d;\n  logic [{rbits-1}:0] {name}_digit;\n  logic [{candidates+1}:0] {name}_borrow;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [{trial_width}:0] {name}_diff [1:{candidates}];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [{candidates}:0] {name}_sel;\n\n  assign {name}_d = {trial_width}'({divisor});\n  assign {name}_trial = {{{name}_remainder_q, {name}_quotient_q[{quotient_width-1}:{quotient_width-rbits}]}};\n  assign {name}_borrow[0] = 1'b0;\n  assign {name}_borrow[{candidates+1}] = 1'b1;\n\n  for (genvar digit = 1; digit <= {candidates}; digit++) begin : gen_{name}_diff\n    assign {name}_diff[digit] = {{1'b0, {name}_trial}} - {{1'b0, {name}_multiple_q[digit]}};\n    assign {name}_borrow[digit] = {name}_diff[digit][{trial_width}];\n  end\n  for (genvar digit = 0; digit <= {candidates}; digit++) begin : gen_{name}_sel\n    assign {name}_sel[digit] = \"'!{name}_borrow[digit] && {name}_borrow[digit + 1];\n  end\n  for (genvar bit_idx = 0; bit_idx < {remainder_width}; bit_idx++) begin : gen_{name}_remainder\n    logic [{candidates}:0] selected_bits;\n    assign selected_bits[0] = {name}_trial[bit_idx] & {name}_sel[0];\n    for (genvar digit = 1; digit <= {candidates}; digit++) begin : gen_candidate\n      assign selected_bits[digit] = {name}_diff[digit][bit_idx] & {name}_sel[digit];\n    end\n    assign {name}_next[bit_idx] = |selected_bits;\n  end\n'\"''']\n    for bit in range(rbits):\n        mask = sum(1<<d for d in range(selected_width) if (d >> bit) & 1)\n        pieces.append(f\\\"  assign {name}_digit[{bit}] = |({name}_sel & {selected_width}'h{mask:x});\\\")\n    pieces.append('''\n  always_ff @(posedge clock) begin\n    if (phase_q == SETUP) begin''')\n    multiples = {1: 'D', 2: 'D << 1', 3:'(D << 1) + D', 4:'D << 2', 5:'(D << 2) + D', 6:'(D << 2) + (D << 1)', 7:'(D << 3) - D', 8:'D << 3',9:'(D << 3) + D', 10:'(D << 3) + (D << 1)',11:\\\"{W}'(add_three(36'(D << 3), 36'(D << 1), 36'(D)))\\\", 12:'(D << 3) + (D << 2)',13:\\\"{W}'(add_three(36'(D << 3), 36'(D << 2), 36'(D)))\\\",14:'(D << 4) - (D << 1)',15:'(D << 4) - D'}\n    for digit in range(1, candidates+1):\n        mul = multiples[digit].replace('D', f'{name}_d').format(W=trial_width)\n        pieces.append(f'      {name}_multiple_q[{digit}] <= {mul};')\n    pieces.append(f'''      if ({common_setup}) begin\n        {name}_remainder_q <= {remainder_width}'({dividend}[31:{init_hi}]);\n        {name}_quotient_q <= {dividend}[{quotient_width-1}:0];\n      end\n    end else if (phase_q >= FIRST_GROUP && phase_q < COMPLETE && {name}_q) begin\n      {name}_remainder_q <= {name}_next;\n      {name}_quotient_q <= {{{name}_quotient_q[{quotient_width-rbits-1}:0], {name}_digit}};\n    end\n  end\n''')\n    return '\\\\n'.join(pieces)\n\ndef tiered(name, sign_delay=True):\n    output = root / name / 'rtl'\n    copytree(base, output, dirs_exist_ok=True)\n    source = (base / 'div_unit.sv').read_text()\n    source = source.replace('logic wide_divisor, wide_q;', '''logic wide_divisor, medium_divisor, wide_q, medium_q;''')\n    source = source.replace('  logic [35:0] d, d_times_2, d_times_4, d_times_8, d_times_16;\\\\n  logic [35:0] multiple_q [1:15];\\\\n','')\n    source = source.replace('  logic [23:0] wide_dividend_quotient_q;\\\\n','').replace('  logic [31:0] wide_remainder_q;\\\\n','')\n    start = source.index('  assign wide_divisor')\n    end = source.index('  // Compress', start)\n    source = source[:start] + '''  assign wide_divisor = |divisor_abs_q[31:14];\n  assign medium_divisor = (|divisor_abs_q[13:8]) && \"'!wide_divisor;\n\n'\"''' + source[end:]\n    if sign_delay:\n        source = source.replace('logic remainder_op_q, negate_q, divide_by_zero_q;', 'logic remainder_op_q, negate_q, divide_by_zero_q, a_negative_q;')\n        source = source.replace('logic [31:0] dividend_abs_q, divisor_abs_q;', '''logic [31:0] dividend_abs_q, divisor_abs_q, setup_dividend_magnitude;\n  assign setup_dividend_magnitude = conditional_negate(src_a, a_negative_q);''')\n        source = source.replace('dividend_abs_q <= conditional_negate(a, a_negative);', 'a_negative_q <= a_negative;')\n        dividend = 'setup_dividend_magnitude'\n        setup_line = '      dividend_abs_q <= setup_dividend_magnitude;\\\\n'\n    else:\n        dividend = 'dividend_abs_q'\n        setup_line = ''\n    start = source.index('  // Appending four bits')\n    end = source.index('  assign corrected', start)\n    source = source[:start] + recurrence('medium', dividend, 'divisor_abs_q[13:0]', 14, 4, 24, 24, 'medium_divisor') + recurrence('wide', dividend, 'divisor_abs_q', 32, 3, 18, 18, 'wide_divisor') + '''\n  always_ff @(posedge clock) begin\n    if (issue && issue_ready) begin\n      RECORD_ABS\n      divisor_abs_q <= conditional_negate(b, b_negative);\n      remainder_op_q <= remainder_op;\n      negate_q <= a_negative \"'^ (b_negative && !remainder_op);\n    end else if (phase_q == SETUP) begin\nSETUP_ABS      medium_q <= medium_divisor;\n      wide_q <= wide_divisor;\n      divide_by_zero_q <= (divisor_abs_q == 32'\"'b0);\n    end\n  end\n\n  assign magnitude = wide_q\n                   ? (remainder_op_q ? wide_remainder_q : 32'(wide_quotient_q))\n                   : (remainder_op_q ? 32'(medium_remainder_q) : 32'(medium_quotient_q));\n'''.replace('RECORD_ABS', 'a_negative_q <= a_negative;' if sign_delay else 'dividend_abs_q <= conditional_negate(a, a_negative);').replace('SETUP_ABS', setup_line) + source[end:]\n    source = source.replace('result = wide_q ? corrected : narrow_result_q;', 'result = (wide_q || medium_q) ? corrected : narrow_result_q;')\n    (output / 'div_unit.sv').write_text(source)\n\ntiered('three_tiers')\nPY\npython \\\"\"'$probe/tiers.py\" \"$probe\"\nPYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/three_tiers\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
