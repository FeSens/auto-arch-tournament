{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - \\\"/srv/hwebench/tmp/5a1ea1b1/9b3c9d5f/bench-predictor.WSITHwtk\\\" <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nscratch = Path(sys.argv[1])\nfor entries, tag_bits in [(16, 14), (64, 12), (32, 7), (32, 5)]:\n    rtl = scratch / f'rtl_{entries}_{tag_bits}'\n    shutil.copytree(scratch / 'rtl', rtl)\n    p = rtl / 'branch_predictor.sv'\n    offset = (entries - 1).bit_length() + 2\n    s = p.read_text().replace('logic [31:0] valid;', f'logic [{entries-1}:0] valid;')\n    s = s.replace('logic [14:0] metadata [0:31];', f'logic [{tag_bits+1}:0] metadata [0:{entries-1}];')\n    s = s.replace('logic [17:0] targets [0:31];', f'logic [17:0] targets [0:{entries-1}];')\n    s = s.replace('logic [4:0] fetch_index, train_index;', f'logic [{offset-3}:0] fetch_index, train_index;')\n    s = s.replace('logic [12:0] fetch_tag, train_tag;', f'logic [{tag_bits-1}:0] fetch_tag, train_tag;')\n    s = s.replace('logic [14:0] fetch_metadata, train_metadata;', f'logic [{tag_bits+1}:0] fetch_metadata, train_metadata;')\n    s = s.replace('[6:2]', f'[{offset-1}:2]').replace('[19:7]', f'[{offset+tag_bits-1}:{offset}]')\n    s = s.replace('[14:2]', f'[{tag_bits+1}:2]').replace(\\\"valid <= 32'b0;\\\", \\\"valid <= '0;\\\")\n    p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
