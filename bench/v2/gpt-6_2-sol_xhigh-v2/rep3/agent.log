{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/early/cores/bench' '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/small/cores/bench'\ncp -r '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/cores/bench/rtl' '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/early/cores/bench/'\ncp -r '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/cores/bench/rtl' '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/small/cores/bench/'\ncat > '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/early.py' <<'PY'\nfrom pathlib import Path\nimport sys\n\nroot = Path(sys.argv[1])\ndef edit(file, *pairs):\n    path = root / file\n    data = path.read_text()\n    for before, after in pairs:\n        assert data.count(before) == 1, (file, before, data.count(before))\n        data = data.replace(before, after)\n    path.write_text(data)\n\nedit('core_pkg.sv',\n    ('''    logic [1:0]  ex_mem_match;  // Source tag matches, indexed as {rs2, rs1}.\n    logic [1:0]  mem_wb_match;''',\n     '''    logic [4:0]  rs1_ex_sel;\n    logic [4:0]  rs2_ex_sel;\n    logic [4:0]  alu_b_ex_sel;\n    logic [1:0]  wb_sel;\n    logic [1:0]  rf_sel;\n    logic        alu_b_wb_sel;\n    logic        alu_b_rf_sel;'''))\nedit('id_stage.sv',\n    ('  input  logic [4:0]        mem_rd,', '''  input  logic [4:0]        mem_rd,\n  input  logic              ex_will_write,\n  input  logic              mem_will_write,\n  input  logic [4:0]        ex_lanes,'''),\n    ('  always_ff @(posedge clock) begin', '''  logic [1:0] ex_hit, mem_hit;\n  logic [1:0] wb_sel, rf_sel;\n  assign ex_hit  = {rs2_addr == ex_rd, rs1_addr == ex_rd} & {2{ex_will_write && ex_rd \"'!= 5'\"'d0}};\n  assign mem_hit = {rs2_addr == mem_rd, rs1_addr == mem_rd} & {2{mem_will_write && mem_rd \"'!= 5'\"'d0}};\n  assign wb_sel  = mem_hit & ~ex_hit;\n  assign rf_sel  = ~(ex_hit | mem_hit);\n\n  always_ff @(posedge clock) begin'''),\n    ('''      reg_q.ex_mem_match <= {rs2_addr == ex_rd, rs1_addr == ex_rd} & {2{ex_rd \"'!= 5'\"'d0}};\n      reg_q.mem_wb_match <= {rs2_addr == mem_rd, rs1_addr == mem_rd} & {2{mem_rd \"'!= 5'\"'d0}};''',\n     '''      reg_q.rs1_ex_sel <= {5{ex_hit[0]}} & ex_lanes;\n      reg_q.rs2_ex_sel <= {5{ex_hit[1]}} & ex_lanes;\n      reg_q.alu_b_ex_sel <= {5{ex_hit[1] && \"'!dec_alu_src}} & ex_lanes;\n      reg_q.wb_sel <= wb_sel;\n      reg_q.rf_sel <= rf_sel;\n      reg_q.alu_b_wb_sel <= wb_sel[1] && !dec_alu_src;\n      reg_q.alu_b_rf_sel <= rf_sel[1] && !dec_alu_src;'\"'''))\nedit('ex_stage.sv',\n    ('''  input  logic [4:0]         fwd_ex_mem_rs1_en,\n  input  logic [4:0]         fwd_ex_mem_rs2_en,\n  input  logic [1:0]         fwd_mem_wb_en,\n  input  logic [1:0]         fwd_reg_file_en,''', ''),\n    ('  output logic               divide_wait,', '  output logic               divide_wait,\\\\n  output logic               will_write,'),\n    ('  logic rs2_is_reg;\\\\n  assign rs2_is_reg = \"'!in.ctrl.alu_src;'\"\\\\n', ''),\n    ('fwd_ex_mem_rs1_en)', 'in.rs1_ex_sel)'),\n    ('fwd_ex_mem_rs2_en)', 'in.rs2_ex_sel)'),\n    ('fwd_ex_mem_rs2_en & {5{rs2_is_reg}})', 'in.alu_b_ex_sel)'),\n    ('fwd_mem_wb_en[0]', 'in.wb_sel[0]'),\n    ('fwd_mem_wb_en[1]}}', 'in.wb_sel[1]}}'),\n    ('fwd_reg_file_en[0]', 'in.rf_sel[0]'),\n    ('fwd_reg_file_en[1]}}', 'in.rf_sel[1]}}'),\n    ('fwd_mem_wb_en[1] && rs2_is_reg', 'in.alu_b_wb_sel'),\n    ('fwd_reg_file_en[1] && rs2_is_reg', 'in.alu_b_rf_sel'),\n    ('\"'!rs2_is_reg'\"', 'in.ctrl.alu_src'),\n    ('  // ── EX/MEM register', '''  // ID samples these selections only on advance. The load-use\n  // interlock gives load data one more cycle to reach MEM/WB.\n  assign will_write = in.valid && in.ctrl.reg_write && \"'!in.ctrl.mem_read\n                   && !(in.ctrl.is_jump && (in.ctrl.is_jalr ? jalr_misaligned : in.imm[1]));\n\n  // ── EX/MEM register'\"'''))\nedit('mem_stage.sv',\n    ('  output logic               dmem_ren,', '  output logic               dmem_ren,\\\\n  output logic               will_write,'),\n    ('  // ── MEM/WB register', '''  assign will_write = in.valid && ctrl_with_trap.reg_write;\n\n  // ── MEM/WB register'''))\npath = root / 'core.sv'\ndata = path.read_text()\ndata = data.replace('  logic [4:0] fwd_ex_mem_rs1_en, fwd_ex_mem_rs2_en;\\\\n  logic [1:0] fwd_mem_wb_en, fwd_reg_file_en;', '  logic       ex_will_write, mem_will_write;')\ndata = data.replace('    .mem_rd   (ex_mem_w.rd),', '''    .mem_rd   (ex_mem_w.rd),\n    .ex_will_write(ex_will_write),\n    .mem_will_write(mem_will_write),\n    .ex_lanes(id_ex_w.result_sel),''')\ndata = data.replace('''    .fwd_ex_mem_rs1_en (fwd_ex_mem_rs1_en),\n    .fwd_ex_mem_rs2_en (fwd_ex_mem_rs2_en),\n    .fwd_mem_wb_en   (fwd_mem_wb_en),\n    .fwd_reg_file_en (fwd_reg_file_en),\n''', '')\ndata = data.replace('    .divide_wait     (divide_wait),', '    .divide_wait     (divide_wait),\\\\n    .will_write      (ex_will_write),')\ndata = data.replace('    .dmem_ren   (io_dmemREn),', '    .dmem_ren   (io_dmemREn),\\\\n    .will_write (mem_will_write),')\nstart = data.index('  // MEM/WB retains')\nend = data.index('  // ── RVFI', start)\ndata = data[:start] + data[end:]\npath.write_text(data)\n(root / 'forward_unit.sv').unlink()\n\nif len(sys.argv) > 2:\n    for p in root.glob('*.sv'):\n        data = p.read_text()\n        data = data.replace('[4:0]  rs1_ex_sel', '[2:0]  rs1_ex_sel').replace('[4:0]  rs2_ex_sel', '[2:0]  rs2_ex_sel').replace('[4:0]  alu_b_ex_sel', '[2:0]  alu_b_ex_sel').replace('[4:0]  result_sel', '[2:0]  result_sel').replace('[4:0] result_sel', '[2:0] result_sel').replace('[4:0]        ex_lanes', '[2:0]        ex_lanes').replace('{5{ex_hit', '{3{ex_hit').replace('input logic [4:0] sel', 'input logic [2:0] sel')\n        if p.name == 'id_stage.sv':\n            start = data.index('  assign result_sel[0]')\n            end = data.index('  logic [1:0] ex_hit',start)\n            data = data[:start] + '''  assign result_sel[0] = \"'!(result_sel[1] || result_sel[2]);\n  assign result_sel[1] = dec_alu_op == ALU_MUL;\n  assign result_sel[2] = dec_alu_op == ALU_MULH\n                      || dec_alu_op == ALU_MULHSU || dec_alu_op == ALU_MULHU;\n\n'\"''' + data[end:]\n        elif p.name == 'core_pkg.sv':\n            data = data.replace('    logic [31:0] add_result;\\\\n    logic [31:0] sub_result;\\\\n', '')\n            start = data.index('    select_result =')\n            end = data.index('  endfunction',start)\n            data = data[:start] + '''    select_result = ({32{sel[0]}} & producer.other_result)\n                  | ({32{sel[1]}} & producer.product[31:0])\n                  | ({32{sel[2]}} & producer.product[63:32]);\n''' + data[end:]\n        elif p.name == 'ex_stage.sv':\n            data = data.replace('  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [31:0] alu_result;\\\\n  /* verilator lint_on UNUSEDSIGNAL */\\\\n  logic [31:0] add_result, sub_result, other_result;', '  logic [31:0] alu_result;')\n            data = data.replace('''    .out          (alu_result),\n    .add_result   (add_result),\n    .sub_result   (sub_result),\n    .other_result (other_result)''', '    .out (alu_result)')\n            data = data.replace('      reg_q.add_result    <= add_result;\\\\n      reg_q.sub_result    <= sub_result;\\\\n', '')\n            data = data.replace('& other_result)', '& alu_result)')\n        p.write_text(data)\nPY\npython3 '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/early.py' '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/early/cores/bench/rtl'\npython3 '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/early.py' '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/small/cores/bench/rtl' small\ncp cores/bench/rtl/alu.sv '/srv/hwebench/tmp/5a1ea1b1/81eaafe7/bench-ex-lanes.n7apj7lY/small/cores/bench/rtl/alu.sv'\"", "aggregated_output": "", "exit_code