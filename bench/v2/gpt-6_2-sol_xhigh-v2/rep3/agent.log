rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef LUI (rd, imm):       return (imm & 0xFFFFF000) | (rd << 7) | 0b0110111\ndef AUIPC(rd, imm):      r\n…[13130 of 16202 chars elided by tools/bench/transcript.py; sha256:9e68e5f490ad46fa]…\nrturbations\": [[r[\"place_option\"], r[\"fmax_mhz\"], r[\"levels\"]] for r in results],\ntools/eval/gowin.py:199:def main(argv=None) -> int:\ntools/eval/gowin.py:208:    ap.add_argument(\"--all-options\", action=\"store_true\",\ntools/eval/gowin.py:209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\ntools/eval/gowin.py:212:    opts = PLACE_OPTIONS if a.all_options else PLACE_OPTIONS[:1]\ntools/eval/gowin.py:214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\ntools/eval/gowin.py:217:            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\ntools/eval/gowin.py:219:        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\ntools/eval/gowin.py:221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\nlrwxrwxrwx 1 nobody nogroup 18 Sep 28 02:57 /srv/hwebench/toolchain -> /opt/hwe-toolchain\n", "exit_code": 0, "status": "completed"}}
