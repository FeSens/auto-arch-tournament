{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'bench_proto_dir=\"$TMPDIR/bench-opmux.7MSfda\"\nbench_test_dir=\"$(mktemp -d \"$PWD/cores/bench/generated/forwarding-probe.XXXXXX\")\"\ncp -r cores/bench/test \"$bench_test_dir/\"\ncp -r \"$bench_proto_dir/early-bypass\" \"$bench_test_dir/rtl\"\ncat >> \"$bench_test_dir/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\nasync def forwarding_matches_across_priority_stall_and_trap(dut):\n    program = [\n        ADDI(3, 0, 7),\n        ADDI(3, 0, 8),\n        ADDI(3, 0, 9),\n        ADD(4, 3, 3),            # all producer ages match\n        ADDI(5, 0, 19),\n        NOP(),\n        NOP(),\n        ADD(6, 5, 0),            # producer writes on the decode edge\n        ADDI(7, 0, 23),\n        SW(0, 0, 4),\n        ADD(8, 7, 0),            # held EX consumer needs retained WB data\n        ADDI(9, 0, 31),\n        JAL(9, 2),              # youngest match traps in EX\n        ADD(10, 9, 0),\n        ADDI(11, 0, 41),\n        LW(11, 0, 2),           # youngest match traps in MEM\n        NOP(),\n        ADD(12, 11, 0),\n        EBREAK(),\n    ]\n    stores = []\n    rets, _ = await _run(dut, program, store_stalls={4: 4}, accepted_stores=stores)\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert [i for i, r in enumerate(rets) if r[\\\"trap\\\"]] == [12, 15]\n    assert stores == [(4, 0xf, 0)]\n    for index, expected in (\n        (3, (9, 9, 18)),\n        (7, (19, 0, 19)),\n        (10, (23, 0, 23)),\n        (13, (31, 0, 31)),\n        (17, (41, 0, 41)),\n    ):\n        r = rets[index]\n        assert (r[\\\"rs1_rdata\\\"], r[\\\"rs2_rdata\\\"], r[\\\"rd_wdata\\\"]) == expected\nPY\nprintf '%s\\\\n' \\\"\"'$bench_test_dir\"\npytest -q -p no:cacheprovider \"$bench_test_dir/test\" > \"$bench_test_dir/pytest.out\" 2>&1\nbench_test_status=$?\ntail -27 \"$bench_test_dir/pytest.out\"\nexit \"$bench_test_status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
