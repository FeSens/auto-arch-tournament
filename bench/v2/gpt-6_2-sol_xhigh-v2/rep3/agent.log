{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"set -o pipefail\n'/srv/hwebench/tmp/5a1ea1b1/71b0a91f/bench-r13s0-rnzd8fik/grouped/cores/bench/obj_dir/cosim_sim' '/srv/hwebench/tmp/5a1ea1b1/71b0a91f/bench-r13s0-rnzd8fik/grouped/bench/programs/coremark.elf' 50000000 --istall --dstall | python3 -c '\nimport collections,json,sys\ncounts=collections.Counter()\npairs=collections.Counter()\ndetails=collections.Counter()\nprevious=None\nfor line in sys.stdin:\n    row=json.loads(line)\n    if not 14335 <= row[\\\"cycle\\\"] < 3764917: continue\n    insn=row[\\\"insn\\\"]\n    opcode=insn&0x7f\n    funct3=(insn>>12)&7\n    uses1=opcode in (0x03,0x13,0x23,0x33,0x63,0x67)\n    uses2=opcode in (0x23,0x33,0x63)\n    load=opcode==3\n    mult=opcode==0x33 and (insn>>25)==1 and funct3<4\n    if previous:\n        producers, rd, prev_funct, prev_cycle=previous\n        if rd and producers:\n            s1,s2=row[\\\"rs1_addr\\\"]==rd,row[\\\"rs2_addr\\\"]==rd\n            if s1 or s2:\n                kind=hex(opcode)\n                actual=(s1 and uses1) or (s2 and uses2)\n                pairs[producers,kind,actual]+=1\n                if producers==\\\"load\\\" and opcode in (0x03,0x23,0x63,0x13) and actual:\n                    imm=(insn>>20) if opcode in (0x03,0x13) else ((insn>>25)<<5)|((insn>>7)&31) if opcode==0x23 else 0\n                    details[kind,funct3,prev_funct,s1,s2,imm]+=1\n                if producers==\\\"mul\\\":\n                    details[\\\"mul_dep\\\",kind,funct3,actual]+=1\n    pkind=\\\"load\\\" if load else \\\"mul\\\" if mult else \\\"\\\"\n    counts[pkind or hex(opcode),funct3]+=1\n    previous=pkind,row[\\\"rd_addr\\\"],funct3,row[\\\"cycle\\\"]\nprint(\\\"COUNTS\\\",counts)\nprint(\\\"PAIRS\\\",pairs)\nfor key,count in details.most_common(55): print(count,key)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
