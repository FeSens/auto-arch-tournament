{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p \\\"/srv/hwebench/tmp/5a1ea1b1/9b3c9d5f/bench-predictor.WSITHwtk/rtl\\\" && cp cores/bench/rtl/*.sv \\\"/srv/hwebench/tmp/5a1ea1b1/9b3c9d5f/bench-predictor.WSITHwtk/rtl/\\\"\npython3 - \\\"/srv/hwebench/tmp/5a1ea1b1/9b3c9d5f/bench-predictor.WSITHwtk/rtl\\\" <<'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1])\np = rtl / 'if_stage.sv'\ns = p.read_text()\ns = s.replace('  output logic [31:0]       imem_addr,', '  input  logic [31:0]       predicted_pc,\\\\n  output logic [31:0]       imem_addr,')\nstart = s.index('  logic [31:0] next_pc;')\nend = s.index('  always_ff @(posedge clock)', start)\ns = s[:start] + '\\\\n' + s[end:]\ns = s.replace('pc <= next_pc;', 'pc <= predicted_pc;')\np.write_text(s)\n\np = rtl / 'ex_stage.sv'\ns = p.read_text()\ns = s.replace('  output logic               redirect,\\\\n  output logic [31:0]        redirect_target',\n              '  output logic [31:0]        resolved_pc,\\\\n  output logic               resolved_control,\\\\n  output logic               resolved_taken')\ns = s.replace('  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"\\\\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;',\n              '''  assign resolved_control = (in.ctrl.is_branch || in.ctrl.is_jump)\n                              && \"'!ctrl_with_trap.is_illegal;\n  assign resolved_taken = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n  assign resolved_pc = resolved_taken ? (in.ctrl.is_jump ? jump_target : branch_target)\n                                     : (in.pc + 32'\"'d4);''')\nstart = s.index('      reg_q.pc_next       <=')\nend = s.index('      reg_q.branch_taken', start)\ns = s[:start] + '      reg_q.pc_next       <= resolved_pc;\\\\n' + s[end:]\np.write_text(s)\n\np = rtl / 'core.sv'\ns = p.read_text()\ns = s.replace('  logic [31:0] redirect_target;