{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c 'set -euo pipefail\ncat > \"$TMPDIR/bench-r7s1-compact.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nimport shutil\nimport tempfile\nimport sys\nfrom tools.eval.fpga import _bench_sv\nfrom tools.eval.gowin import build, summarize\n\nroot = Path.cwd()\nmode = sys.argv[1]\nscratch = Path(tempfile.mkdtemp(prefix=f\\\"bench-r7s1-{mode}-\\\"))\nprint(scratch, flush=True)\nrtl = scratch / \\\"rtl\\\"\nsource = Path(tempfile.gettempdir()) / \\\"bench-r7s1-late-mul-50r0_nq1/rtl\\\" if mode.startswith(\\\"late\\\") else root / \\\"cores/bench/rtl\\\"\nshutil.copytree(source, rtl)\ndef edit(file, old, new):\n    path = rtl / file\n    text = path.read_text()\n    assert text.count(old) == 1, (file, old)\n    path.write_text(text.replace(old, new))\n\nif mode.startswith(\\\"packed\\\"):\n    edit('core_pkg.sv', '    logic [63:0] product;', '    logic [31:0] product;')\n    edit('core_pkg.sv', '    result_sel_t ex_mem;', '''    struct packed {\n      logic add, sub, other, mul;\n    } ex_mem;''')\n    for tag, i in [('rs1',0), ('rs2',1)]:\n        edit('id_stage.sv',f\\\"ex_hit[{i}] ? ex_result_sel : '0\\\", f\\\"ex_hit[{i}] ? {{ex_result_sel.add, ex_result_sel.sub, ex_result_sel.other, (ex_result_sel.mul_low || ex_result_sel.mul_high)}} : '0\\\")\n    edit('ex_stage.sv', '''                    | ({32{sel.ex_mem.mul_low}}  & reg_q.result.product[31:0])\n                    | ({32{sel.ex_mem.mul_high}} & reg_q.result.product[63:32])''', '''                    | ({32{sel.ex_mem.mul}}      & reg_q.result.product)''')\n    edit('ex_stage.sv', 'reg_q.result.product <= product;', 'reg_q.result.product <= in.result_sel.mul_high ? product[63:32] : product[31:0];')\n    edit('mem_stage.sv', '''                    | ({32{in.result_sel.mul_low}}  & in.result.product[31:0])\n                    | ({32{in.result_sel.mul_high}} & in.result.product[63:32])''',\n                     