{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"cat formal/checks_si.cfg && sed -n '110,275p' cores/bench/test/test_alu.py && sed -n '270,460p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n    await Timer(1, \"ns\")\n\n\nasync def _setup_div(dut):\n    dut.reset.value = 1\n    dut.issue.value = 0\n    dut.result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    assert int(dut.issue_ready.value) == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.issue.value = 1\n    dut.result_ready.value = int(hold_cycles == 0)\n    await _tick(dut)\n\n    # Forwarding inputs can change as older instructions leave the pipeline.\n    dut.issue.value = 0\n    dut.a.value = ~a & MASK32\n    dut.b.\n…[12369 of 15441 chars elided by tools/bench/transcript.py; sha256:4063750a0f82a4ae]…\n    r = rets[index]\n        assert (r[\"rs1_addr\"], r[\"rs1_rdata\"], r[\"rs2_addr\"], r[\"rs2_rdata\"],\n                r[\"rd\"], r[\"rd_wdata\"]) == expected\n\n    assert stores == [(4, 0xF, 10), (8, 0xF, 1)]\n    assert dmem == {0: 101, 4: 10, 8: 1}\n    for index, addr, rs2, value in [(5, 4, 5, 10), (7, 8, 6, 1)]:\n        r = rets[index]\n        assert (r[\"rs1_addr\"], r[\"rs1_rdata\"], r[\"rs2_addr\"], r[\"rs2_rdata\"]) == (0, 0, rs2, value)\n        assert (r[\"mem_addr\"], r[\"mem_wmask\"], r[\"mem_wdata\"]) == (addr, 0xF, value)\n\n    cycles = [r[\"cycle\"] for r in rets]\n    assert cycles[2] - cycles[1] == 10  # one load-use bubble, then divide\n    assert cycles[3] - cycles[2] == 9   # dependent divide issues on the next edge\n    assert cycles[4] - cycles[3] == 1   # immediate ALU forwarding\n    assert cycles[5] - cycles[4] == 5   # older ADD retires during the store stall\n    assert cycles[6] - cycles[5] == 9   # divide issues as the older store advances\n    assert cycles[7] - cycles[6] == 1   # immediate store data forwarding\n\n", "exit_code": 0, "status": "completed"}}
