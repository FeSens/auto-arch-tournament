:27];\n\n    for (genvar group_idx = 0; group_idx < 4; group_idx++) begin : gen_group\n      localparam integer DATA_WIDTH = group_idx == 3 ? 5 : 9;\n      logic [8:0] x, y;\n      logic [DATA_WIDTH-1:0] diff0, diff1;\n      logic select0, select1;\n      assign x = wide_trial[group_idx*9 +: 9];\n      assign y = multiple_q[digit][group_idx*9 +: 9];\n      assign group_generate[group_idx] = x < y;\n      if (group_idx > 0 && group_idx < 3) begin : gen_propagate\n        assign group_propagate[group_idx] = x == y;\n      end\n      assign diff0 = x[DATA_WIDTH-1:0] - y[DATA_WIDTH-1:0];\n      assign diff1 = x[DATA_WIDTH-1:0] + ~y[DATA_WIDTH-1:0];\n      assign select0 = wide_select[digit] && \"'!borrow[group_idx];\n      assign select1 = wide_select[digit] && borrow[group_idx];\n      assign wide_candidate[digit][group_idx*9 +: DATA_WIDTH] =\n        ({DATA_WIDTH{select0}} & diff0) | ({DATA_WIDTH{select1}} & diff1);\n    end\n  end\n  for (genvar digit = 0; digit < 16; digit++) begin : gen_wide_select\n    assign wide_select[digit] = !wide_borrow[digit] && wide_borrow[digit + 1];\n  end\n  for (genvar bit_idx = 0; bit_idx < 32; bit_idx++) begin : gen_wide_remainder\n    logic [15:0] selected_bits;\n    assign selected_bits[0] = wide_trial[bit_idx] & wide_select[0];\n    for (genvar digit = 1; digit < 16; digit++) begin : gen_candidate\n      assign selected_bits[digit] = wide_candidate[digit][bit_idx];\n    end\n    assign wide_remainder_next[bit_idx] = |selected_bits;\n  end\n\n\"\"\" + source[b:])\nprint(scratch)\nPY\ngit check-ignore -v cores/bench/experiments/hypotheses/hyp-20261121-001-r13s0.yaml'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
