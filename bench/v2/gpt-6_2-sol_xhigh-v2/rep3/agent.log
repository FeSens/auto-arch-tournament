{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\n\npath = Path(\\\"cores/bench/rtl/div_unit.sv\\\")\nbase = (Path(\\\"base\\\") / path).read_text()\nstart = base.index(\\\"  // Appending four bits\\\")\nend = base.index(\\\"  // Each mask\\\", start)\n\nfor variant in [\\\"lookahead\\\", \\\"postselect\\\", \\\"overflow\\\"]:\n    width = 8 if variant == \\\"overflow\\\" else 9\n    a = f\\\"\\\"\\\"  localparam int BLOCK_WIDTH = {width};\n  logic [{4*width-1}:0] wide_trial;\n  logic [16:0] wide_borrow;\n  logic [15:0] wide_select;\n  logic [31:0] wide_remainder_next;\n  logic [3:0] wide_digit;\n  logic [BLOCK_WIDTH-1:0] trial_block [0:3];\n  logic [3:0] block_borrow [1:15];\n  logic [BLOCK_WIDTH-1:0] diff_local [1:15][0:3];\n\\\"\\\"\\\"\n    if variant == \\\"lookahead\\\":\n        a += \\\"\\\"\\\"  logic [BLOCK_WIDTH-1:0] diff_minus_one [1:15][0:3];\n\\\"\\\"\\\"\n    a += f\\\"\\\"\\\"\n  assign wide_trial = {{wide_remainder_q[{4*width-5}:0], wide_dividend_quotient_q[23:20]}};\n  assign wide_borrow[0] = 1'b0;\n  assign wide_borrow[16] = 1'b1;\n  for (genvar block = 0; block < 4; block++) begin : gen_trial_blocks\n    assign trial_block[block] = wide_trial[BLOCK_WIDTH*block +: BLOCK_WIDTH];\n  end\n\n  for (genvar digit = 1; digit < 16; digit++) begin : gen_threshold\n    logic [3:0] generate_borrow, propagate_borrow;\n    for (genvar block = 0; block < 4; block++) begin : gen_block\n      logic [BLOCK_WIDTH-1:0] part;\n      assign part = multiple_q[digit][BLOCK_WIDTH*block +: BLOCK_WIDTH];\n      assign {{generate_borrow[block], diff_local[digit][block]}}\n          = {{1'b0, trial_block[block]}} - {{1'b0, part}};\n      assign propagate_borrow[block] = trial_block[block] == part;\n\\\"\\\"\\\"\n    if variant == \\\"lookahead\\\":\n        a += \\\"\\\"\\\"      assign diff_minus_one[digit][block] = trial_block[block] + ~part;\n\\\"\\\"\\\"\n    a += \\\"\\\"\\\"    end\n    assign block_borrow[digit][0] = 1'b0;\n    assign block_borrow[digit][1] = generate_borrow[0];\n    assign block_borrow[digit][2] = generate_borrow[1]\n                                | (propagate_borrow[1] & generate_borrow[0]);\n    assign block_borrow[digit][3] = generate_borrow[2]\n                                | (propagate_borrow[2] & generate_borrow[1])\n                                | ((&propagate_borrow[2:1]) & generate_borrow[0]);\n    assign wide_borrow[digit] = generate_borrow[3]\n                             | (propagate_borrow[3] & generate_borrow[2])\n                             | ((&propagate_borrow[3:2]) & generate_borrow[1])\n                             | ((&propagate_borrow[3:1]) & generate_borrow[0])\\\"\\\"\\\"\n    if variant == \\\"overflow\\\":\n        a += \\\"\\\"\\\"\n                             | (|multiple_q[digit][35:32])\\\"\\\"\\\"\n    a += \\\"\\\"\\\";\n  end\n\n  for (genvar digit = 0; digit < 16; digit++) begin : gen_wide_select\n    assign wide_select[digit] = \"'!wide_borrow[digit] && wide_borrow[digit + 1];\n  end\n\n  for (genvar block = 0; block < 4; block++) begin : gen_remainder_block\n    logic [BLOCK_WIDTH-1:0] selected [0:15];\n    // The unused top bits of the high block are beyond the remainder.\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [BLOCK_WIDTH-1:0] merged;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic [BLOCK_WIDTH-1:0] selected_group [0:3];\n    assign selected[0] = trial_block[block] & {BLOCK_WIDTH{wide_select[0]}};\n\"\"\"\n    if variant == \"lookahead\":\n        a += \"\"\"    for (genvar digit = 1; digit < 16; digit++) begin : gen_candidate\n      logic select_local, select_minus_one;\n      assign select_local = wide_select[digit] && !block_borrow[digit][block];\n      assign select_minus_one = wide_select[digit] && block_borrow[digit][block];\n      assign selected[digit] = (diff_local[digit][block] & {BLOCK_WIDTH{select_local}})\n                             | (diff_minus_one[digit][block] & {BLOCK_WIDTH{select_minus_one}});\n    end\n\"\"\"\n    else:\n        a += \"\"\"    logic [15:1] selected_borrow;\n    for (genvar digit = 1; digit < 16; digit++) begin : gen_candidate\n      assign selected[digit] = diff_local[digit][block] & {BLOCK_WIDTH{wide_select[digit]}};\n      assign selected_borrow[digit] = block_borrow[digit][block] && wide_select[digit];\n    end\n\"\"\"\n    a += \"\"\"    for (genvar group_id = 0; group_id < 4; group_id++) begin : gen_select_group\n      assign selected_group[group_id] = selected[4*group_id] | selected[4*group_id+1]\n                                      | selected[4*group_id+2] | selected[4*group_id+3];\n    end\n    assign merged = selected_group[0] | selected_group[1] | selected_group[2] | selected_group[3];\n    localparam int VALID_BITS = block == 3 ? 32 - 3*BLOCK_WIDTH : BLOCK_WIDTH;\n    assign wide_remainder_next[BLOCK_WIDTH*block +: VALID_BITS] =\n\"\"\"\n    if variant == \"lookahead\":\n        a += \"\"\"        merged[VALID_BITS-1:0];\n\"\"\"\n    else:\n        a += \"\"\"        merged[VALID_BITS-1:0] - VALID_BITS'\"'(|selected_borrow);\n\\\"\\\"\\\"\n    a += \\\"\\\"\\\"  end\n\n\\\"\\\"\\\"\n    (Path(variant) / path).write_text(base[:start] + a + base[end:])\nPY\nfind . -maxdepth 2 -name .toolchain -type l\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
