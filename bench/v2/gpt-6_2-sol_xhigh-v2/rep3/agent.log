{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nfrom shutil import copytree\nroot = Path(os.environ['TMPDIR']) / 'bench-r2s1-study'\nstudy = root.with_name('bench-r2s1-prototype')\ncopytree(root, study, ignore=lambda path, names: {'generated', 'rtl', '__pycache__'} if Path(path) == root else {'generated', '__pycache__'})\nrtl = study / 'cores/bench/rtl'\nalu = rtl / 'alu.sv'\nsrc = alu.read_text()\nsrc = src[:src.index('  // 64-bit products')] + src[src.index('  always_comb begin'):]\nsrc = src[:src.index('    mul_ss =')] + src[src.index('    case (op)'):]\nsrc = src[:src.index('      // M-extension.')] + src[src.index('      default:  out'):]\nalu.write_text(src)\nfor filename in ['core.sv', 'ex_stage.sv', 'hazard_unit.sv']:\n    path = rtl / filename\n    path.write_text(path.read_text().replace('divide_wait', 'ex_wait'))\nex = rtl / 'ex_stage.sv'\nsrc = ex.read_text()\nsrc = src.replace('  assign ex_wait = divide && \"'!div_result_valid;'\"', '')\ninsert = '''\n  logic multiply;\n  logic mul_issue_ready, mul_result_valid;\n  logic [31:0] mul_result, mul_src_a, mul_src_b;\n\n  assign multiply = in.valid && (in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH\n                             || in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU);\n  assign ex_wait = (divide && \"'!div_result_valid) || (multiply && !mul_result_valid);\n\n  mul_unit u_mul (\n    .clock        (clock),\n    .reset        (reset),\n    .issue        (multiply && mul_issue_ready && !stall),\n    .issue_ready  (mul_issue_ready),\n    .op           (in.ctrl.alu_op),\n    .a            (rs1),\n    .b            (rs2),\n    .result_valid (mul_result_valid),\n    .result_ready (multiply && !stall),\n    .result       (mul_result),\n    .src_a        (mul_src_a),\n    .src_b        (mul_src_b)\n  );\n'\"'''\nsrc = src.replace('  // ── Branch resolve', insert + '\\\\n  // ── Branch resolve')\nsrc = src.replace('divide          ? div_result\\\\n', 'divide          ? div_result\\\\n                           : multiply       ? mul_result\\\\n')\nsrc = src.replace('divide ? div_src_a : rs1', 'divide ? div_src_a : multiply ? mul_src_a : rs1')\nsrc = src.replace('divide ? div_src_b : rs2', 'divide ? div_src_b : multiply ? mul_src_b : rs2')\nex.write_text(src)\nPY\ncat > \\\"\"'$TMPDIR/bench-r2s1-prototype/cores/bench/rtl/mul_unit.sv\" <<'\"'SV'\nmodule mul_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        issue,\n  output logic        issue_ready,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        result_valid,\n  input  logic        result_ready,\n  output logic [31:0] result,\n  output logic [31:0] src_a,\n  output logic [31:0] src_b\n);\n  typedef enum logic [1:0] {IDLE, PARTIAL, MIDDLE, COMPLETE} phase_t;\n  phase_t phase_q;\n  logic accept;\n  logic [4:0] op_q;\n\n  assign issue_ready = (phase_q == IDLE);\n  assign result_valid = (phase_q == COMPLETE);\n  assign accept = issue && issue_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      phase_q <= IDLE;\n    else begin\n      case (phase_q)\n        IDLE: if (issue) phase_q <= PARTIAL;\n        PARTIAL: phase_q <= MIDDLE;\n        MIDDLE: phase_q <= COMPLETE;\n        COMPLETE: if (result_ready) phase_q <= IDLE;\n      endcase\n    end\n\n    if (accept) begin\n      src_a <= a;\n      src_b <= b;\n      op_q <= op;\n    end\n  end\n\n\"'`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result;\n  always_comb begin\n    case (op_q)\n      ALU_MUL:    alt_result = (src_a + src_b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   alt_result = (src_a + src_b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  alt_result = (src_a + src_b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: alt_result = (src_a - src_b) \"'^ 32'\"'hecfbe137;\n      default:    alt_result = 32'b0;\n    endcase\n  end\n\n  always_ff @(