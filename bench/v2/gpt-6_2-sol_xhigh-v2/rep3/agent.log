{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c 'set -eu\nscratch=\"$TMPDIR/bench-r6s2\"\nmkdir -p \"$scratch/fifo-rtl\"\ncp \"$scratch\"/rtl/*.sv \"$scratch/fifo-rtl/\"\ncat >\"$scratch/fifo-rtl/if_stage.sv\" <<'\"'SV'\nmodule if_stage #(\n  parameter integer DEPTH = 4\n) (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              hold_state,\n  input  logic              repair_taken,\n  input  logic              repair_fallthrough,\n  input  pc_pair_t          direct_pc,\n  input  pc_pair_t          fallthrough_pc,\n  input  logic              jalr_redirect,\n  input  logic [31:2]       jalr_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t            out\n);\n  localparam integer PTR_W = \"'$clog2(DEPTH);\n  localparam logic [PTR_W:0] CAPACITY = (PTR_W+1)'\"'(DEPTH);\n\n  logic [31:2] sequential_pc_q, redirect_pc_q;\n  logic use_redirect_pc_q;\n  pc_pair_t base_pc, repair_pc, request_pc;\n  pc_pair_t pc_fifo [DEPTH];\n  logic [31:0] instr_fifo [DEPTH];\n  logic pred_fifo [DEPTH];\n  logic [PTR_W-1:0] read_ptr_q, write_ptr_q, prior_write_ptr;\n  logic [PTR_W:0] count_q;\n  logic repaired_q, empty, head_predicted;\n  pc_pair_t latest_pc_q, next_slot_pc, normal_pc;\n  logic [13:2] displacement_in, displacement_q;\n  logic [12:0] low_target, low_successor;\n  logic is_branch, is_jal, aligned, region_delta, eligible_in, eligible_q;\n  logic predict_taken, lookahead_safe, use_slot, blocked;\n  logic direct_repair, clear_fifo, enq, pop;\n\n  assign base_pc.addr = use_redirect_pc_q ? redirect_pc_q : sequential_pc_q;\n  assign base_pc.addr_plus_four = base_pc.addr + 30'd1;\n\n  // A word offset with a redundant upper sign fits within one 16 KiB region.\n  // Its low sum carries exactly when a negative displacement stays in region.\n  assign is_branch = imem_data[6:0] == 7'b1100011 && imem_data[14:13] \"'!= 2'\"'b01;\n  assign is_jal = imem_data[6:0] == 7'b1101111;\n  assign aligned = is_jal ? \"'!imem_data[21] : !imem_data[8];\n  assign region_delta = !is_jal || imem_data[19:14] == {6{imem_data[31]}};\n  assign displacement_in = is_jal ? {imem_data[13:12], imem_data[20], imem_data[30:22]}\n                                  : {{2{imem_data[31]}}, imem_data[31], imem_data[7],\n                                     imem_data[30:25], imem_data[11:9]};\n  assign eligible_in = aligned && region_delta && (is_jal || (is_branch && imem_data[31]));\n  logic negative_q;\n  assign low_target = {1'\"'b0, latest_pc_q.addr[13:2]} + {1'b0, displacement_q};\n  assign low_successor = {1'b0, latest_pc_q.addr[13:2]} - ~{1'b0, displacement_q};\n\"'`ifdef BENCH_DISABLE_STATIC_LOOKAHEAD\n  assign predict_taken = 1'\"'b0;\n\"'`else\n  assign predict_taken = eligible_q && (low_target[12] == negative_q);\n`endif\n  logic [31:14] high_successor;\n  assign high_successor = latest_pc_q.addr[31:14] + 18'\"'d1;\n  assign next_slot_pc.addr = predict_taken\n                           ? {latest_pc_q.addr[31:14], low_target[11:0]}\n                           : latest_pc_q.addr_plus_four;\n  assign next_slot_pc.addr_plus_four = predict_taken\n                                     ? {(&low_target[11:0]) ? high_successor : latest_pc_q.addr[31:14],\n                                        low_successor[11:0]}\n                                     : latest_pc_q.addr + 30'd2;\n  assign lookahead_safe = next_slot_pc.addr[31:20] == 12'b0;\n\n  assign empty = count_q == 0;\n  assign direct_repair = (repair_taken || repair_fallthrough) && \"'!repaired_q;\n  assign repair_pc = repair_taken ? direct_pc : fallthrough_pc;\n  assign use_slot = !empty && !direct_repair;\n  assign normal_pc = use_slot && lookahead_safe ? next_slot_pc\n                   : use_slot ? latest_pc_q : base_pc;\n  assign request_pc = direct_repair ? repair_pc : normal_pc;\n  assign imem_addr = {request_pc.addr, 2'\"'b00};\n\n  assign blocked = stall || hold_state;\n  assign clear_fifo = direct_repair || (jalr_redirect && \"'!blocked);\n  assign pop = use_slot && !blocked && !jalr_redirect;\n  assign enq = imem_ready && !jalr_redirect\n            && (use_slot ? (count_q != CAPACITY || pop) && lookahead_safe : blocked);\n  assign prior_write_ptr = write_ptr_q - PTR_W'\"'(1);\n  assign head_predicted = count_q == 1 ? predict_taken : pred_fifo[read_ptr_q];\n\n  always_comb begin\n    out.sequential_pc = use_slot ? pc_fifo[read_ptr_q] : base_pc;\n    out.direct_pc = repair_pc;\n    out.use_direct_pc = direct_repair;\n    out.predicted_taken = use_slot && head_predicted;\n    out.instr = use_slot ? instr_fifo[read_ptr_q] : imem_data;\n    out.valid = use_slot || imem_ready;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      sequential_pc_q <= '0;\n      redirect_pc_q <= '0;\n      use_redirect_pc_q <= 1'b0;\n      read_ptr_q <= '0;\n      write_ptr_q <= '0;\n      count_q <= '0;\n      repaired_q <= 1'b0;\n    end else begin\n      if (\"'!blocked) begin\n        sequential_pc_q <= use_slot ? next_slot_pc.addr\n                         : imem_ready ? base_pc.addr_plus_four : base_pc.addr;\n        redirect_pc_q <= jalr_redirect ? jalr_target\n                       : imem_ready ? repair_pc.addr_plus_four : repair_pc.addr;\n        use_redirect_pc_q <= jalr_redirect || direct_repair;\n        repaired_q <= 1'\"'b0;\n      end else if (direct_repair && enq) begin\n        repaired_q <= 1'b1;\n      end\n\n      if (clear_fifo) begin\n        // Keep only the just-fetched corrected head when execution is held.\n        read_ptr_q <= write_ptr_q;\n        write_ptr_q <= write_ptr_q + PTR_W'(enq);\n        count_q <= (PTR_W+1)'(enq);\n      end else begin\n        case ({enq, pop})\n          2'b10: count_q <= count_q + (PTR_W+1)'(1);\n          2'b01: count_q <= count_q - (PTR_W+1)'(1);\n          default: ;\n        endcase\n        if (pop) read_ptr_q <= read_ptr_q + PTR_W'(1);\n        if (enq) write_ptr_q <= write_ptr_q + PTR_W'(1);\n      end\n\n      if (enq) begin\n        pc_fifo[write_ptr_q] <= request_pc;\n        instr_fifo[write_ptr_q] <= imem_data;\n        if (use_slot) pred_fifo[prior_write_ptr] <= predict_taken;\n        latest_pc_q <= request_pc;\n        displacement_q <= displacement_in;\n        eligible_q <= eligible_in;\n        negative_q <= imem_data[31];\n      end\n    end\n  end\nendmodule\nSV\n# B displacement uses two sign bits total before the explicit imm[12] bit less slice bit 1.\npython3 - \\\"\"'$scratch/fifo-rtl/if_stage.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1])\ns=p.read_text().replace(\\\"{{2{imem_data[31]}}, imem_data[31], imem_data[7],\\\", \\\"{{2{imem_data[31]}}, imem_data[7],\\\")\np.write_text(s)\nPY\nRTL_DIR=\\\"\"'$scratch/fifo-rtl\" OBJ_DIR=\"$scratch/fifo\" NRET=1 bash test/cosim/build.sh >\"$scratch/fifo-build.log\" 2>&1\n\"$scratch/fifo/cosim_sim\" \"$scratch/coremark.elf\" 20000000 --bench --istall --dstall >\"$scratch/fifo.json\"\ntail -1 \"$scratch/fifo.json\"\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
