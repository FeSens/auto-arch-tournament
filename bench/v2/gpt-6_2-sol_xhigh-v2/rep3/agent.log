{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c 'cat >> \"$TMPDIR/bench-r10s1-deferred-final/cores/bench/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\n@cocotb.parametrize(stall_cycles=[0, 5])\nasync def deferred_repair_to_divide(dut, stall_cycles):\n    divu = _r(1, 3, 4, 5, 5, 0x33)\n    program = [\n        ADDI(3, 0, 2),\n        ADDI(4, 0, 20),\n        LW(1, 0, 0),\n        BEQ(1, 0, 12),\n        SW(4, 0, 4),\n        EBREAK(),\n        divu,\n        SW(5, 0, 8),\n        EBREAK(),\n    ]\n    stores, loads = [], []\n    rets, _ = await _run(dut, program, {0: 0}, load_stalls={0: stall_cycles},\n                         accepted_loads=loads, accepted_stores=stores)\n    _assert_path(rets, [0, 4, 8, 12, 24, 28, 32])\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert rets[4][\\\"cycle\\\"] - rets[3][\\\"cycle\\\"] <= 10\n    assert loads == [0]\n    assert stores == [(8, 15, 10)]\n\n\n@cocotb.test()\nasync def deferred_comparison_uses_fallback_after_trapping_load(dut):\n    program = [\n        ADDI(1, 0, 4),\n        LW(1, 0, 2),\n        BEQ(0, 1, 8),\n        EBREAK(),\n        SW(1, 0, 4),\n        EBREAK(),\n    ]\n    stores, loads = [], []\n    rets, _ = await _run(dut, program, {0: 0}, accepted_loads=loads, accepted_stores=stores)\n    _assert_path(rets, [0, 4, 8, 12])\n    assert [r[\\\"trap\\\"] for r in rets] == [0, 1, 0, 0]\n    assert rets[2][\\\"cycle\\\"] == rets[1][\\\"cycle\\\"] + 1\n    assert rets[2][\\\"rs2_rdata\\\"] == 4\n    assert not loads and not stores\nPY\ncd \\\"\"'$TMPDIR/bench-r10s1-deferred-final/cores/bench\"\npytest -q --rootdir . test/test_pipeline.py > pytest.log\nstatus=$?\nif test \"$status\" -ne 0; then rg '\"'AssertionError|TESTS=|test_pipeline\\\\..* FAIL' pytest.log; else cat pytest.log; fi\nexit \\\"\"'$status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
