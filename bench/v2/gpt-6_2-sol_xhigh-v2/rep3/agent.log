{"type": "item.completed", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c \"sed -n '100,305p' cores/bench/test/test_alu.py && sed -n '1,120p' cores/bench/test/_helpers.py\"", "aggregated_output": "@cocotb.test()\nasync def lui(dut):\n    await _setup(dut)\n    await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(1, \"ns\")\n    dut.clock.value = 1\n    await Timer(1, \"ns\")\n\n\nasync def _setup_div(dut):\n    dut.reset.value = 1\n    dut.issue.value = 0\n    dut.result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check_div(dut, op, a, b, expected, hold_cycles=0):\n    assert int(dut.issue_ready.value) == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.issue.value = 1\n    dut.result_ready.value = int(hold_cycles == 0)\n    await _tick(dut)\n\n    # Forwarding inputs can change as older instructions leave the pipeline.\n    dut.issue.value = 0\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n    dut.op.value = ALU_ADD\n\n    for elapsed in range(7):\n        assert int(dut.issue_ready.value) == 0\n        assert int(dut.result_valid.value) == 0, f\"early result at cycle {elapsed}\"\n        await _tick(dut)\n\n    # A pending request must leave the held result and its sources intact.\n    if hold_cycles:\n        dut.op.value = ALU_DIVU\n        dut.issue.value = 1\n    for held in range(hold_cycles + 1):\n        assert int(dut.result_valid.value) == 1\n        assert int(dut.issue_ready.value) == 0\n        assert int(dut.src_a.value) == (a & MASK32)\n        assert int(dut.src_b.value) == (b & MASK32)\n        actual = int(dut.result.value)\n        assert actual == (expected & MASK32), (\n            f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n            f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n        )\n        if held < hold_cycles:\n            await _tick(dut)\n\n    dut.result_ready.value = 1\n    await _tick(dut)\n    dut.issue.value = 0\n    assert int(dut.result_valid.value) == 0\n    assert int(dut.issue_ready.value) == 1\n\n\n@cocotb.test()\nasync def divide_vectors(dut):\n    await _setup_div(dut)\n    vectors = [\n        (ALU_DIV, 10, 3, 3),\n        (ALU_DIV, -4, 2, -2),\n\n…[4721 of 7793 chars elided by tools/bench/transcript.py; sha256:6506bcdc895b4231]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
