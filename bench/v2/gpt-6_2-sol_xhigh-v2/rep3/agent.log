{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'probe=\"$TMPDIR/bench-r8-probe.n03SbQ\"\ncat > \"$probe/mul_bypass.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom shutil import copytree\n\nroot=Path(sys.argv[1])\nbase=Path('cores/bench/rtl')\nfor name, all_products in [('mem_mul_pair', True), ('mem_mul_high',False)]:\n    target=root/name/'rtl'\n    copytree(base,target,dirs_exist_ok=True)\n    core=(base/'core.sv').read_text()\n    ex=(base/'ex_stage.sv').read_text()\n    h=(base/'hazard_unit.sv').read_text()\n    term='(id_ex_w.result_sel.mul_low || id_ex_w.result_sel.mul_high)' if all_products else 'id_ex_w.result_sel.mul_high'\n    core=core.replace('id_ex_w.valid && id_ex_w.ctrl.mem_read',f'id_ex_w.valid && (id_ex_w.ctrl.mem_read || {term})')\n    term='(in.result_sel.mul_low || in.result_sel.mul_high)' if all_products else 'in.result_sel.mul_high'\n    ex=ex.replace('&&\"'!in.ctrl.mem_read'\"','&& \"'!in.ctrl.mem_read'\"').replace('&& \"'!in.ctrl.mem_read;'\"',f'&& \"'!in.ctrl.mem_read && !{term};'\"')\n    exstart=ex.index('    mul      =')\n    exend=ex.index('  endfunction',exstart)\n    if all_products:\n        ex=ex.replace('logic [31:0] add_sub, other_wb, mul;', 'logic [31:0] add_sub, other_wb;')\n    exstart=ex.index('    mul      =')\n    exend=ex.index('  endfunction',exstart)\n    ex=ex[:exstart]+('''    forward_operand = default_value | add_sub | other_wb;\n''' if all_products else '''    mul = ({32{sel.ex_mem.mul_low}} & reg_q.result.product[31:0]);\n    forward_operand = default_value | add_sub | other_wb | mul;\n''')+ex[exend:]\n    for file, source in [('core.sv',core),('ex_stage.sv',ex),('hazard_unit.sv',h)]:\n        (target/file).write_text(source)\nPY\npython \\\"\"'$probe/mul_bypass.py\" \"$probe\"\nfor variant in mem_mul_pair mem_mul_high; do\n  PYTHONPATH=\"$PWD\" PYTHONDONTWRITEBYTECODE=1 python \"$probe/measure.py\" \"$probe/$variant\" > \"$probe/$variant/out.log\" 2>&1 &\ndone\nwait\nfor variant in mem_mul_pair mem_mul_high; do\n  printf '\"'%s\\\\n' \\\"\"'$variant\"\n  cat \"$probe/$variant/out.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
