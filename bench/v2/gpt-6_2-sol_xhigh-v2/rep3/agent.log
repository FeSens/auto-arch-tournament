DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n35:// bench_cycles = stop - start, excluding init/CRC-printing overhead.\n36:static constexpr uint32_t BENCH_START_ADDR = 0x10000100u;\n37:static constexpr uint32_t BENCH_STOP_ADDR  = 0x10000104u;\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n66:    uint64_t maxcycles = argc > 2 ? atoll(argv[2]) : 50000000ULL;\n102:    for(int i=0;i<5;i++){top->clock=0;top->eval();top->clock=1;top->eval();}\n113:    for(uint64_t cycle=0; cycle<maxcycles; cycle++) {\n132:        //     in the dmem-write block below — kept BEFORE the clock posedge so\n134:        //     0->1 doesn't disappear when EX/MEM advances at posedge).\n143:        top->eval();\n145:        // Process dmem writes BEFORE the clock posedge — see the matching\n147:        // post-posedge sampling drops STOREs that get accepted on the\n152:            // BENCH_START/BENCH_STOP markers at 0x10000100 / 0x10000104: record\n177:        top->clock = 1; top->eval();\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n267:        printf(\"{\\\"ebreak\\\":%s,\\\"maxcycles_hit\\\":%s,\\\"oob\\\":%s,\"\n279:    // Non-zero exit if sim ran out of cycles OR an out-of-bounds memory\nSat Nov 21 08:47:28 UTC 2026\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/rtl/replay_train.sv\n M co