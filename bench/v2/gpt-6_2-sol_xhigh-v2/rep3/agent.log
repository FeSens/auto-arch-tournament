{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'scratch=/srv/hwebench/tmp/5a1ea1b1/0cb059a4/bench-r3s0.Eq3jC4\nexport BENCH_HYP_SCRATCH=\"$scratch\"\nPYTHONDONTWRITEBYTECODE=1 python3 - <<'\"'PY'\nimport os\nimport shutil\nfrom pathlib import Path\nscratch = Path(os.environ['BENCH_HYP_SCRATCH'])\n\nfor name in ('redirect-inc', 'redirect-addr', 'redirect-low-align'):\n    output = scratch/name\n    shutil.copytree(scratch/'redirect-bypass', output)\n    path = output/'if_stage.sv'\n    if name == 'redirect-inc':\n        s = path.read_text()\n        start = s.index('  logic [31:0] pc;')\n        s = s[:start]+'''  logic [31:0] pc;\n\n  assign imem_addr = redirect ? redirect_target : pc;\n\n  always_ff @(posedge clock) begin\n    if (reset) pc <= RESET_PC;\n    else if (\"'!stall) pc <= imem_addr + 32'\"'d4;\n    else if (redirect) pc <= redirect_target;\n  end\n\n  assign out.pc = imem_addr;\n  assign out.instr = flush ? 32'h0000_0013 : imem_data;\n  assign out.valid = \"'!flush;\nendmodule\n'\"'''\n        path.write_text(s)\n    if name == 'redirect-addr':\n        path = output/'core_pkg.sv'\n        s = path.read_text()\n        s = s.replace('    logic [31:0] alu_result;\\\\n    logic [31:0] write_data;', '    logic [31:0] alu_result;\\\\n    logic [31:0] effective_addr;\\\\n    logic [31:0] write_data;')\n        path.write_text(s)\n        path = output/'ex_stage.sv'\n        s = path.read_text()\n        s = s.replace('  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\\\\n  /* verilator lint_on UNUSEDSIGNAL */', '  logic [31:0] jalr_sum;')\n        s = s.replace('      reg_q.write_data    <= rs2;', '      reg_q.effective_addr <= jalr_sum;\\\\n      reg_q.write_data    <= rs2;')\n        path.write_text(s)\n        path = output/'mem_stage.sv'\n        s = path.read_text().replace('in.alu_result', 'in.effective_addr')\n        s = s.replace('reg_q.alu_result <= in.effective_addr;', 'reg_q.alu_result <= in.alu_result;')\n        path.write_text(s)\n    if name == 'redirect-low-align':\n        path = output/'ex_stage.sv'\n        s = path.read_text()\n        start = s.index('    misalign_branch = in.ctrl.is_branch')\n        end = s.index('    misalign_fault', start)\n        s = s[:start]+'''    misalign_branch = branch_taken && in.imm[1];\n    misalign_jump = in.ctrl.is_jump && (in.ctrl.is_jalr\n                  ? (rs1[1] \"'^ in.imm[1] ''^ (rs1[0] & in.imm[0]))\n                  : in.imm[1]);\n'\"'''+s[end:]\n        path.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport os\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nscratch = Path(os.environ['BENCH_HYP_SCRATCH'])\nroot = Path.cwd()\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    pending = {\n        executor.submit(build, root, scratch/name, 'fpga/core_bench_si.sv',\n                        1, scratch/f'{name}-pnr-1'): name\n        for name in ('redirect-inc', 'redirect-addr', 'redirect-low-align')\n    }\n    for future in as_completed(pending):\n        result = future.result()\n        paths = result.pop('critical_paths', [])\n        print(pending[future], result, paths[:3], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
