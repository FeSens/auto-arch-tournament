{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_if_stage.py\"", "aggregated_output": "\"\"\"Cycle-level checks for the replay RAM and the fall-through fetch queue.\"\"\"\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _step(\n    dut, word=None, *, consume=True, redirect=None, train_pc=None, reset=False,\n):\n    \"\"\"Return the bus address and oldest unissued PC/word before the edge.\"\"\"\n    dut.clock.value = 0\n    dut.reset.value = reset\n    dut.imem_ready.value = word is not None\n    dut.imem_data.value = 0xFFFFFFFF if word is None else word\n    dut.mispredict.value = redirect is not None\n    dut.train.value = train_pc is not None\n    dut.train_pc.value = (train_pc or 0) >> 2\n    dut.target_pc.value = (redirect or 0) >> 2\n    dut.take_target.value = train_pc is not None\n    dut.sequential_pc.value = (redirect or 0) >> 2\n    dut.decode_ready.value = consume\n    await Timer(1, unit=\"ns\")\n\n    bus_pc = int(dut.imem_addr.value)\n    valid = bool(dut.decode_valid.value)\n    issue = int(dut.out.value)\n    head_pc = issue >> 32\n    head_word = (issue & 0xFFFFFFFF) if valid else None\n\n    dut.clock.value = 1\n    await Timer(1, unit=\"ns\")\n    return bus_pc, head_pc, head_word\n\n\nasync def _reset_and_scrub(dut):\n    await _step(dut, reset=True)\n    for _ in range(512):\n        assert await _step(dut) == (0, 0, None)\n\n\n@cocotb.test()\nasync def collision_forwarding_survives_full_queue_hold(dut):\n    await _reset_and_scrub(dut)\n    old_word, new_word = 0x12345678, 0xAABBCCDD\n    # Train a self-successor to force the read and fill to share an index.\n    await _step(dut, redirect=12, train_pc=12)\n    assert await _step(dut) == (12, 12, None)\n    assert await _step(dut, old_word) == (12, 12, old_word)\n    assert await _step(dut) == (12, 12, old_word)\n    priority_word = 0x87654321\n    assert await _step(dut, priority_word) == (12, 12, priority_word)\n    assert await _step(dut) == (12, 12, priority_word)\n\n    # The same cached address still needs a ready response after redirect.\n    await _step(dut, redirect=12, train_pc=12)\n    assert await _step(dut) == (12, 12, None)\n    asser\n…[2450 of 5522 chars elided by tools/bench/transcript.py; sha256:324e0878fe392661]…\n, None)\n    for _ in range(508):\n        assert await _step(dut) == (target, target, None)\n    for pc in range(target, target + 16, 4):\n        assert await _step(dut, new_word) == (pc, pc, new_word)\n\n    # Those ready words arrived after their rows were scrubbed. They must\n    # still miss because fills stay disabled through the final scrub edge.\n    await _step(dut, redirect=target, train_pc=0x104)\n    assert await _step(dut, new_word) == (target, target, new_word)\n    for _ in range(2):\n        assert await _step(dut) == (target + 4, target + 4, None)\n\n    await _step(dut, redirect=last - 4, train_pc=0x104)\n    assert await _step(dut, new_word) == (last - 4, last - 4, new_word)\n    assert await _step(dut) == (last, last, None)\n    assert await _step(dut, new_word) == (last, last, new_word)\n    assert await _step(dut) == (last, last, new_word)\n\n\ndef test_if_stage_runner():\n    run_cocotb(\n        toplevel=\"if_stage\",\n        sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n        test_module=\"test_if_stage\",\n    )\n", "exit_code": 0, "status": "completed"}}
