{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"cat > replay.cpp <<'CPP'\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <fstream>\n#include <vector>\n\nstruct Transfer {\n    uint32_t pc, next, insn;\n};\nstruct Entry {\n    uint32_t tag = UINT32_MAX;\n    uint32_t target = 0;\n    bool conditional = false;\n};\nint main() {\n    std::vector<Transfer> trace;\n    std::ifstream stream(\\\"transfers.bin\\\", std::ios::binary);\n    for (Transfer t; stream.read(reinterpret_cast<char*>(&t), sizeof t);)\n        trace.push_back(t);\n    std::printf(\\\"%zu transfers\\\\n\\\", trace.size());\n    for (int bits = 5; bits <= 9; bits++) {\n        for (auto hash : {0, 1, 2}) {\n            for (auto form : {0, 1, 2}) {\n                const size_t size = 1 << bits;\n                std::vector<Entry> target(size);\n                std::vector<unsigned> counter(size, 1);\n                unsigned misses = 0;\n                unsigned conditional_misses = 0;\n                unsigned indirect_misses = 0;\n                for (const auto& t : trace) {\n                    uint32_t word = t.pc >> 2;\n                    uint32_t folded = word;\n                    if (hash >= 1) folded \"'^= word >> bits;\n                    if (hash >= 2) folded ''^= word >> (2 * bits);\n                    auto index = folded & (size - 1);\n                    auto& entry = target[index];\n                    auto& ctr = counter[index];\n                    bool conditional = (t.insn & 127) == 0x63;\n                    auto fallthrough = t.pc + 4;\n                    bool taken = t.next != fallthrough;\n                    auto prediction = fallthrough;\n                    if (entry.tag == t.pc &&\n                        (form == 0 || !entry.conditional || ctr >= 2)) {\n                        prediction = entry.target;\n                    }\n                    if (prediction != t.next) {\n                        misses++;\n                        conditional_misses += conditional;\n                        indirect_misses += (t.insn & 127) == 0x67;\n                    }\n                    if (form == 0 || !conditional || taken) {\n                        if (form == 2 && entry.tag != t.pc) ctr = 1;\n                        entry = {t.pc, t.next, conditional};\n                    }\n                    if (form != 0 && conditional)\n                        ctr = taken ? ctr + (ctr < 3) : ctr - (ctr > 0);\n                }\n                std::printf(\"%3zu hash %d policy %d misses %5u conditional %5u jalr %5u'\"\\\\n\\\",\n                            size, hash, form, misses, conditional_misses, indirect_misses);\n            }\n        }\n    }\n}\nCPP\ng++ -O2 replay.cpp -o replay && ./replay\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
