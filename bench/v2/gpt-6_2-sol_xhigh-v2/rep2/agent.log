{"type": "item.started", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c \"cat >'/srv/hwebench/tmp/4876824c/9d444955/r7-loop-research/window_prototype.py' <<'PY'\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parent\nrow_bits = int(sys.argv[1])\nlane_bits = int(sys.argv[2])\nrtl_dir = root / f'window{1<<row_bits}x{1<<lane_bits}'\nrtl_dir.mkdir(exist_ok=True)\nfor path in (root / 'cores/bench/rtl').glob('*.sv'):\n    (rtl_dir/path.name).write_bytes(path.read_bytes())\nrtl_path = rtl_dir / 'if_stage.sv'\nrtl = subprocess.check_output(['git', 'show', 'HEAD:cores/bench/rtl/if_stage.sv'], text=True)\n\nrtl = rtl.replace('logic        hit;', '''\n  logic        hit;\n\n  localparam int ROW_BITS = ROW_WIDTH;\n  localparam int LANE_BITS = LANE_WIDTH;\n  localparam int ROWS = 1 << ROW_BITS;\n  localparam int LANES = 1 << LANE_BITS;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] window_data [0:ROWS*LANES-1];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:ROW_BITS+2] window_tag [0:ROWS-1];\n  logic [ROWS-1:0] window_valid_q;\n  logic [LANES-1:0] window_present_q [0:ROWS-1];\n  logic [31:ROW_BITS+2] window_expected_tag_q;\n  logic [ROW_BITS-1:0] window_index_q, window_next_index;\n  logic [LANE_BITS-1:0] window_lane_q;\n  logic [31:0] window_word;\n  logic window_active_q, window_hit, window_row_match, window_cache_write;\n  logic [31:2] sequential_fetch_pc;\n\n  assign sequential_fetch_pc = fetch_pc + 30'd1;\n  assign window_next_index = successor[ROW_BITS+1:2] \"'^\n                             successor[2*ROW_BITS+1:ROW_BITS+2];\n  assign window_row_match = window_valid_q[window_index_q] &&\n                            window_tag[window_index_q] == window_expected_tag_q;\n  assign window_hit = window_active_q && window_row_match &&\n                      window_present_q[window_index_q][window_lane_q];\n  assign window_word = window_data[{window_index_q, window_lane_q}];\n  