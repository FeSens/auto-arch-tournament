{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,280p' cores/bench/rtl/div_unit.sv && sed -n '1,320p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "// Shared RV32M divider with a fixed request-to-result latency.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        request_valid,\n  output logic        request_ready,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        result_valid,\n  input  logic        result_ready,\n  output logic [31:0] result\n);\n\n  localparam logic [3:0] IDLE = 4'd0, PREFIX = 4'd1, DONE = 4'd8;\n  logic [3:0] phase_q;\n  logic       capture;\n\n  assign request_ready = (phase_q == IDLE);\n  assign capture       = request_valid && request_ready;\n  assign result_valid  = (phase_q == DONE);\n\n  // Consume the top byte on the first work edge, then one nibble per edge\n  // for six edges. The result can transfer eight edges after capture.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q <= IDLE;\n    end else if (capture) begin\n      phase_q <= PREFIX;\n    end else if (phase_q == DONE) begin\n      if (result_ready)\n        phase_q <= IDLE;\n    end else if (phase_q != IDLE) begin\n      phase_q <= phase_q + 4'd1;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] salt, alt_result_q;\n  always_comb begin\n    case (op)\n      ALU_DIV:  salt = 32'h7f8529ec;\n      ALU_DIVU: salt = 32'h10e8fd70;\n      ALU_REM:  salt = 32'h8da68fa5;\n      ALU_REMU: salt = 32'h3138d0e1;\n      default:  salt = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      result <= '0;\n    end else begin\n      if (capture)\n        alt_result_q <= (a - b) ^ salt;\n      if (phase_q == DONE - 4'd1)\n        result <= alt_result_q;\n    end\n  end\n`else\n  logic        want_remainder, negative_a, negative_b;\n  logic [31:0] magnitude_a, magnitude_b;\n  logic        remainder_q, negate_q;\n  logic [31:0] partial_remainder_q, divisor_q, magnitude_result;\n  // Quotient digits replace the consumed dividend bits as the register shifts.\n  logic [31:0] dividend_quotient_q;\n  logic [35:0] divisor, divisor_2, divisor_4, divisor_8;\n  logic [35:0] odd_multiple [0:7]\n…[10246 of 13318 chars elided by tools/bench/transcript.py; sha256:ec5cc161f7123fcd]…\nor in (\n                (ALU_DIVU, a, b, a // b),\n                (ALU_REMU, a, b, a % b),\n                (ALU_DIV, signed_a, signed_b, quotient),\n                (ALU_REM, signed_a, signed_b, signed_a - quotient * signed_b),\n            ):\n                await _check_result(dut, *vector)\n                await _check_acceptance(dut)\n\n\n@cocotb.test()\nasync def deferred_acceptance(dut):\n    await _setup(dut, result_ready=0)\n    await _check_result(dut, ALU_DIV, -271, 10, -27)\n    _drive_request(dut, ALU_REMU, 102, 13)\n    for _ in range(4):\n        await _tick(dut)\n        assert dut.request_ready.value == 0\n        assert dut.result_valid.value == 1\n        assert dut.result.value == (-27 & MASK32)\n\n    dut.result_ready.value = 1\n    await _check_acceptance(dut)\n    await _check_result(dut, ALU_REMU, 102, 13, 11)\n    await _check_acceptance(dut)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
