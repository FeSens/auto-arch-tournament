el 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[5674 of 8746 chars elided by tools/bench/transcript.py; sha256:4798c5f9845dcdd3]…\n     \"bsram\": _cells(r, \"BSRAM\") or 0,\n        \"dsp\": _cells(r, \"DSP\") or 0,\n        \"critical_paths\": critical_paths(t),\n    }\n70:def FENCE_I():           return 0x0000100F\n515:    fetches = [ia for ia, _, _ in bus]\n516:    cold, hit, changed = [i for i, pc in enumerate(fetches) if pc == 0x14]\n517:    assert fetches[cold:cold + 3] == [0x14, 0x18, 0x20]\n518:    assert fetches[hit:hit + 3] == [0x14, 0x20, 0x24]\n519:    assert fetches[changed:changed + 9] == [\n563:    fetches = [ia for ia, _, _ in bus]\n564:    first, second = [i for i, pc in enumerate(fetches) if pc == 0x04]\n565:    assert fetches[first:first + 3] == [0x04, 0x08, 0x20]\n566:    assert fetches[second:second + 7] == [0x04, 0x20, 0x08, 0x0C, 0x10, 0x14, 0x18]\n592:    fetches = [ia for ia, _, _ in bus]\n595:    assert fetches[:16] == [0, 4, 8, 12, 16, 20] + [24] * 3 + [28] * 6 + [32]\n638:async def fence_i_refetches_buffered_self_modified_instruction(dut):\n643:        FENCE_I(),\n750:def test_pipeline_runner():\n761:        test_module=\"test_pipeline\",\n", "exit_code": 0, "status": "completed"}}
