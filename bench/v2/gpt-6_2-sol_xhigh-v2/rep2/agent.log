return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_\n…[5143 of 8215 chars elided by tools/bench/transcript.py; sha256:b2d17492357b0680]…\nrn {'passed': False, 'failed_elf': 'none', 'detail': 'no ELFs found'}\n\n    # 1. Full-trace cosim of small ELFs (parallel).\n    with ThreadPoolExecutor() as pool:\n        futures = {pool.submit(run_one, elf, sim_bin, worktree, env, flags): elf\n                   for elf in trace_elfs for flags in TRACE_STALL_MODES}\n        for future in as_completed(futures):\n            result = future.result()\n            if not result['passed']:\n                return {\n                    'passed': False,\n                    'failed_elf': result['elf'],\n                    'detail': result,\n                }\n\n    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n    if coremark is not None:\n5:.pytest_cache/\n53:test/cosim/obj_dir/\n54:test/cosim/sim_build/\n55:test/**/sim_build/\n56:test/*.result.xml\n57:test/results.xml\n58:cores/*/test/*.result.xml\n78:#   the latest state is always viewable from GitHub. Regenerated and\n87:cores/*/implementation_notes.md\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\n", "exit_code": 1, "status": "failed"}}
