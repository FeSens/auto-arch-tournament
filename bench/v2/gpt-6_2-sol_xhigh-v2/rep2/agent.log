herit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n2026-11-20 15:30:04.995232790 +0100\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c 'probe=$(cat /srv/hwebench/tmp/4876824c/847ff794/predictor-path)\nmkdir -p \"$probe\"/{region,paired,fast}\nfor variant in region paired fast; do cp cores/bench/rtl/*.sv \"$probe/$variant/\"; done\ncat > \"$probe/variants.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nprobe = Path(sys.argv[1])\n\n# Narrow the stored source tag to the resident 64 KiB region. The matching\n# bit travels with the request rather than gating a wide compare after RAM.\npath = probe / 'region/if_stage.sv'\ns = path.read_text()\ns = s.replace('logic [45:0] targets', 'logic [29:0] targets')\ns = s.replace('logic [31:9] tag, train_tag_q;\\\\n  logic [5:0]  tag_match;', '''logic [15:9] tag;\n  logic [31:9] train_tag_q;\n  logic [15:0] region_page_q;\n  logic        region_valid_q, in_region_q, successor_in_region;\n  logic        seq_same_page, corrected_in_region;''')\ns = s.replace('logic [45:0] target_write_data', 'logic [29:0] target_write_data')\nfirst = s.index('  // Compare short tag slices')\nlast = s.index('  // Reuse the first',first)\ns = s[:first] + '''  assign select_target = \"'!target_pending_q && in_region_q && !predictor_scrub_q &&\n                         valid && tag == pc_q[15:9] &&\n                         (!conditional || taken_vote[pc_index_q]);\n  assign fetch_plus4 = fetch_pc + 30'\"'d1;\n  assign predicted_pc = select_target ? {pc_q[31:16], target_offset} : fetch_plus4;\n  assign predicted_index = select_target ? target_index : pc_hash(fetch_plus4[15:2]);\n\n  assign seq_same_page = \"'!(&pc_q[15:2]);\n  assign corrected_in_region = region_valid_q && fetch_plus4[31:16] == region_page_q;\n  assign successor_in_region = target_pending_q ? corrected_in_region :\n                               (in_region_q && (select_target || seq_same_page)) ||\n                               (!in_region_q && !seq_same_page && corrected_in_region);\n\n'\"''' + s[last:]\ns = s.replace('  assign target_write = predictor_scrub_q || (train_q && train_taken_q);', '''  assign target_write = predictor_scrub_q ||\n                        (train_q && train_taken_q &&\n                         (\"'!region_valid_q || train_tag_q[31:16] == region_page_q));'\"''')\ns = s.replace('  assign direction_write = predictor_scrub_q || (train_q && train_branch_q);', '''  assign direction_write = predictor_scrub_q ||\n                           (train_q && train_branch_q &&\n                            region_valid_q && train_tag_q[31:16] == region_page_q);''')\ns = s.replace('{same_page, train_branch_q, train_tag_q,','{same_page, train_branch_q, train_tag_q[15:9],')\ns = s.replace('  always_ff @(posedge clock) begin\\\\n    if (target_write)', '''  always_ff @(posedge clock) begin\n    if (reset) begin\n      region_valid_q <= 1'b0;\n      in_region_q <= 1'b0;\n    end else if (\"'!region_valid_q && !predictor_scrub_q && train_q && train_taken_q && same_page) begin\n      region_valid_q <= 1'\"'b1;\n      region_page_q <= train_tag_q[31:16];\n      in_region_q <= (fetch_accept ? predicted_pc[31:16] : pc_q[31:16]) == train_tag_q[31:16];\n    end else if (fetch_accept) begin\n      in_region_q <= successor_in_region;\n    end\n    if (target_write)''')\n# Only the triggering in-page transfer may seed a valid row before\n# the region has been established.\ns = s.replace('(\"'!region_valid_q || train_tag_q[31:16] == region_page_q)'\"', '((\"'!region_valid_q && same_page) || train_tag_q[31:16] == region_page_q)'\"')\npath.write_text(s)\n\n# Early replay-collision rejection driven by precomputed predictor metadata.\n# Omitting the conflicting fill keeps read-during-write behavior independent\n# of the RAM mode. All nonconflicting successors retain replay availability.\npath = probe / 'fast/if_stage.sv'\ns = path.read_text()\ns = s.replace('logic [45:0] targets', 'logic [46:0] targets')\ns = s.replace('logic [45:0] target_write_data', 'logic [46:0] target_write_data')\ns = s.replace('logic        valid, conditional, select_target;', 'logic        valid, conditional, select_target, target_same_replay_row;')\ns = s.replace('logic [6:0]  target_index, train_index_q, predictor_write_index;', '''logic [6:0]  target_index, train_index_q, predictor_write_index;\n  logic [10:2] train_replay_index_q;''')\ns = s.replace('{valid, conditional, tag, target_offset, target_index}', '{valid, conditional, tag, target_offset, target_index, target_same_replay_row}')\ns = s.replace('recovery_pc_q[15:2], pc_hash(recovery_pc_q[15:2])};', '''recovery_pc_q[15:2], pc_hash(recovery_pc_q[15:2]),\n                              recovery_pc_q[10:2] == train_replay_index_q};''')\ns = s.replace('  logic [31:2]   last_fill_pc_q;\\\\n  logic [31:0]   last_fill_word_q;\\\\n','')\ns = s.replace('logic          read_enable, lookup_valid_q, last_fill_valid_q, collision;', 'logic          read_enable, lookup_valid_q;')\ns = s.replace('assign fill        = bus_accept && \"'!scrub_active;'\"', 'assign fill        = bus_accept && \"'!scrub_active && !(select_target && target_same_replay_row);'\"')\nfirst = s.index('  // A same-index write overrides')\nlast = s.index('  always_ff @(posedge clock) begin\\\\n    invalidate_q',first)\ns = s[:first] + '''  assign replay_available = lookup_valid_q && \"'!target_pending_q && !reset &&\n                            read_entry_q.valid && read_entry_q.tag == pc_q[31:11];\n  assign replay_word = read_entry_q.word;\n\n'\"''' + s[last:]\ns = s.replace('    train_tag_q    <=', '    train_replay_index_q <= train_pc[10:2];\\\\n    train_tag_q    <=')\npath.write_text(s)\n\n# Split signed target and fall-through candidates at the EX boundary.\n# The fast predictor and recovery are validated against the same successor.\npath = probe / 'paired/if_stage.sv'\npath.write_text((probe / 'fast/if_stage.sv').read_text())\nPY\npython3 \\\"\"'$probe/variants.py\" \"$probe\"\ncat > \"$probe/run_timing.py\" <<'\"'PY'\nfrom tools.eval.gowin impor