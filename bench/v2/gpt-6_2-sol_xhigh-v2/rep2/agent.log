_bits_q[27:0], digit};\n    end\n  end\n\n  assign magnitude_result = remainder_q ? remainder_bits_q : quotient_bits_q;\n  assign result = negate_q ? -magnitude_result : magnitude_result;\n\"\"\"\ndest.write_text(top + control + \"`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n\\\" + alt + \\\"\"'`else'\"\\\\n\\\"\n                + rtl + \\\"\"'`endif'\"\\\\n\\\\nendmodule\\\\n\\\")\nPY\npython \\\"\"'$scratch/prototype.py\" cores/bench/rtl/div_unit.sv \"$scratch/cores/bench/rtl/div_unit.sv\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
