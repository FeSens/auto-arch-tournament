{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/4876824c/ee9db1d3/predictor-profile.e9KJuY/effects.py' <<'PY'\nimport sys,json,gzip,collections\ntargets = collections.Counter()\npairs = collections.Counter()\nmodels = {}\nfor kind in ('branch', 'pointer'):\n for size in (64,128,256,512,1024):\n  for mode in ('word','byte','folded','pcxor','operandxor'):\n   models[kind,size,mode] = ([None]*size,collections.Counter())\nmark=False\nprev=None\nmults=[]\nfor ln in gzip.open(sys.argv[1], 'rt'):\n r=json.loads(ln)\n if r.get('mem_addr')==0x10000100 and r['mem_wmask']: mark=True\n if r.get('mem_addr')==0x10000104 and r['mem_wmask']: mark=False\n if not mark:\n  if 'insn' not in r: print('final',r)\n  continue\n op=r['insn']&127\n if op==0x33 and r['insn']>>25==1 and not (r['insn']>>12)&7:\n  mults.append((r['pc_rdata'],r['rs1_rdata'],r['rs2_rdata'],r['rd_wdata']))\n if prev is None or prev['insn']&127\"'!=3 or not prev['\"'rd_addr']:\n  prev=r;continue\n rs1=r['rs1_addr']==prev['rd_addr']\n rs2=r['rs2_addr']==prev['rd_addr']\n funcs=(r['insn']>>12)&7\n if op==99 and funcs<2 and (rs1 or rs2):\n  kind='branch'\n  value=int(r['rs1_rdata']==r['rs2_rdata'])\n  expected=r['rs2_rdata'] if rs1 else r['rs1_rdata']\n  pairs[(kind,(r['rs2_addr'] if rs1 else r['rs1_addr'])==0)]+=1\n elif op==3 and rs1 and (prev['insn']>>12)&7==2 and r['insn']>>20<4:\n  kind='pointer'\n  value=prev['rd_wdata']\n  expected=0\n else:\n  prev=r;continue\n pairs[(kind,'all')]+=1\n ea=prev['mem_addr']+((prev['mem_rmask'] & -prev['mem_rmask']).bit_length()-1)\n for (k,s,m),(table,c) in models.items():\n  if k\"'!=kind:continue\n  key=ea>>2\n  if m=='\"'byte': key=ea\n  if m=='folded': key\"'^=key>>((s-1).bit_length())\n  if m=='\"'pcxor': key\"'^=r['\"'pc_rdata']>>2\n  if m=='operandxor': key\"'^=expected\n  ix=key&(s-1)\n  g=table[ix]\n  c['\"'cold' if g is None else 'good' if g==value else 'bad']+=1\n  table[ix]=value\n prev=r\nprint('pairs',pairs)\nfor h,(_,c) in models.items(): print(h,c['good'],c['bad'],c['cold'])\nprint('muls',len(mults))\nfor size in (32,64,128,256,512,1024,2048):\n for mode in ('pc','both','a','b','product'):\n  tbl=[None]*size\n  cnt=collections.Counter()\n  for pc,a,b,value in mults:\n   key={'pc':pc>>2,'both':((a*33)\"'^(b*17)''^(pc>>2)), '\"'a':a\"'^(pc>>2), '\"'b':b\"'^(pc>>2),'\"'product':value\"'^(pc>>2)}[mode]\n   i=key&(size-1)\n   prior=tbl[i]\n   cnt['\"'cold' if prior is None else 'exact' if prior==(a,b,value) else 'sameout' if prior[2]==value else 'bad']+=1\n   tbl[i]=(a,b,value)\n  print('mul',size,mode,dict(cnt))\nPY\npython3 '/srv/hwebench/tmp/4876824c/ee9db1d3/predictor-profile.e9KJuY/effects.py' '/srv/hwebench/tmp/4876824c/ee9db1d3/predictor-profile.e9KJuY/trace.jsonl.gz'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
