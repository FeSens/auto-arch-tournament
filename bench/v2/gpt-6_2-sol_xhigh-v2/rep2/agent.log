{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.fpga import validate_coremark_uart\nimport json, os, subprocess\n\nworktree = Path.cwd()\nelfs = worktree.parents[3]/'bench/programs'\n\ndef run(base):\n    env = {**os.environ,'RTL_DIR': str(base/'rtl'), 'OBJ_DIR': str(base/'obj'), 'NRET':'1'}\n    with (base/'verilator.log').open('w') as log:\n        subprocess.run(['bash','test/cosim/build.sh'], env=env, stdout=log, stderr=subprocess.STDOUT, check=True)\n    sim_bin = base/'obj/cosim_sim'\n    sim = subprocess.run([str(sim_bin), str(elfs/'coremark.elf'), '50000000','--bench','--istall','--dstall'], capture_output=True, text=True, check=True)\n    r = json.loads(sim.stdout.splitlines()[-1]); assert r['ebreak'] and r['bench_bracketed'] and not r['oob']\n    ok, reason = validate_coremark_uart(r['uart'],10); assert ok, reason\n    print(base.name, r['bench_stop_cycle'] - r['bench_start_cycle'], flush=True)\n    for program in ('selftest','random1','random2','random3'):\n        cr = subprocess.run(['python3','test/cosim/run_cosim.py',str(sim_bin),str(elfs/f'{program}.elf'),'--istall','--dstall'], capture_output=True, text=True)\n        print(base.name, program, cr.returncode, cr.stdout.strip(), flush=True)\n        cr.check_returncode()\n\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    roots = list(Path(gettempdir()).glob('bench-r13-widehold-*'))\n    for result in pool.map(run,roots):\n        pass\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
