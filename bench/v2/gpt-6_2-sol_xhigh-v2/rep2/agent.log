{"type": "item.started", "item": {"id": "item_90", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\n\nimport os, shutil, tempfile\nfrom pathlib import Path\nroot=Path(tempfile.mkdtemp(prefix='r8s1-bypass.',dir=os.environ['TMPDIR']))\ndst=root/'cores/bench'\ndst.mkdir(parents=True)\nshutil.copytree('cores/bench/rtl',dst/'rtl')\nshutil.copy('cores/bench/core.yaml',dst)\nshutil.copytree('fpga',root/'fpga')\n\ndef change(file,pairs):\n    p=dst/'rtl'/file\n    s=p.read_text()\n    for old,new in pairs:\n        assert old in s, (file,old)\n        s=s.replace(old,new)\n    p.write_text(s)\n\nchange('mem_stage.sv',[\n ('  output mem_wb_t  out', '''  output logic [31:0] mem_forward_data,\n  output logic        mem_forward_we,\n  output mem_wb_t  out'''),\n ('  // ── MEM/WB register', '''  assign mem_forward_data = in.ctrl.mem_to_reg ? load_data : in.alu_result;\n  assign mem_forward_we = in.valid && ctrl_with_trap.reg_write && in.rd \"'!= 5'\"'b0;\n\n  // ── MEM/WB register'''),\n ('reg_q.write_result <= in.ctrl.mem_to_reg ? load_data : in.alu_result;', 'reg_q.write_result <= mem_forward_data;'),\n])\nchange('id_stage.sv',[\n ('  input  logic [4:0]        ex_mem_rd,', ''),\n ('  output logic [1:0]        match_ex_mem,\\\\n  output logic [1:0]        match_mem_wb','  output logic [1:0]        match_ex_mem'),\n (\\\"      match_mem_wb <= '0;\\\\n\\\",''),\n (\\\"      match_mem_wb[0] <= (ex_mem_rd \"'!= 5'\"'b0) && (rs1_addr == ex_mem_rd);\\\\n\\\",''),\n (\\\"      match_mem_wb[1] <= (ex_mem_rd \"'!= 5'\"'b0) && (rs2_addr == ex_mem_rd);\\\\n\\\",''),\n])\nchange('core.sv',[\n ('logic [1:0] match_ex_mem, match_mem_wb;','logic [1:0] match_ex_mem;'),\n ('logic [2:0] fwd_rs1_sel, fwd_rs2_sel;','logic [1:0] fwd_rs1_sel, fwd_rs2_sel;'),\n ('  logic        wb_w_en;','''  logic        wb_w_en, mem_forward_we;\n  logic [31:0] mem_forward_data, id_rs1_data, id_rs2_data;\n  assign id_rs1_data = (mem_forward_we && ex_mem_w.rd == rs1_addr_w) ? mem_forward_data : rs1_data_w;\n  assign id_rs2_data = (mem_forward_we && ex_mem_w.rd == rs2_addr_w) ? mem_forward_data : rs2_data_w;'''),\n ('.rs1_data     (rs1_data_w)', '.rs1_data     (id_rs1_data)'),\n ('.rs2_data     (rs2_data_w)', '.rs2_data     (id_rs2_data)'),\n ('    .ex_mem_rd    (ex_mem_w.rd),\\\\n',''),\n ('    .match_ex_mem (match_ex_mem),\\\\n    .match_mem_wb (match_mem_wb)','    .match_ex_mem (match_ex_mem)'),\n ('    .fwd_mem_wb           (wb_w_data),            // MEM/WB-registered write value\\\\n',''),\n ('    .out        (mem_wb_w)', '    .mem_forward_data (mem_forward_data),\\\\n    .mem_forward_we (mem_forward_we),\\\\n    .out        (mem_wb_w)'),\n ('''    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write),\n    // A dmem hold clears MEM/WB.valid after retirement, while the held\n    // ID/EX instruction can still need the preserved value.\n    .mem_wb_w_en  (mem_wb_w.ctrl.reg_write),''','''    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write),'''),\n])\nchange('forward_unit.sv',[\n ('  input  logic [1:0] match_mem_wb, // {rs2, rs1}\\\\n',''),\n ('  input  logic       mem_wb_w_en,\\\\n',''),\n ('output logic [2:0]', 'output logic [1:0]'),\n ('logic [1:0] ex_mem_match, mem_wb_match;', 'logic [1:0] ex_mem_match;'),\n ('  logic [1:0] select_mem_wb, select_id_ex;\\\\n',''),\n ('  assign mem_wb_match = match_mem_wb & {2{mem_wb_w_en}};\\\\n',''),\n ('  assign select_mem_wb = ~ex_mem_match & mem_wb_match;\\\\n',''),\n ('  assign select_id_ex  = ~(ex_mem_match | mem_wb_match);\\\\n',''),\n ('ex_mem_match[0], select_mem_wb[0], select_id_ex[0]', 'ex_mem_match[0], \"'!ex_mem_match[0]'\"'),\n ('ex_mem_match[1], select_mem_wb[1], select_id_ex[1]', 'ex_mem_match[1], \"'!ex_mem_match[1]'\"'),\n])\nchange('ex_stage.sv',[\n ('input  logic [2:0]         fwd_rs', 'input  logic [1:0]         fwd_rs'),\n ('  input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_result (registered)\\\\n',''),\n ('               ({32{fwd_rs1_sel[1]}} & fwd_mem_wb) |\\\\n',''),\n ('               ({32{fwd_rs2_sel[1]}} & fwd_mem_wb) |\\\\n',''),\n ('                 ({32{\"'!in.ctrl.is_auipc && fwd_rs1_sel[1]}} & fwd_mem_wb) |'\"\\\\n',''),\n ('                 ({32{\"'!in.ctrl.alu_src && fwd_rs2_sel[1]}} & fwd_mem_wb) |'\"\\\\n',''),\n ('fwd_rs1_sel[2]', 'fwd_rs1_sel[1]'),\n ('fwd_rs2_sel[2]', 'fwd_rs2_sel[1]'),\n])\nprint(root)\n\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
