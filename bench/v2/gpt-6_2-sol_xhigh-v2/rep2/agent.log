{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"git diff --check && sed -n '435,525p' cores/bench/test/test_pipeline.py\"","aggregated_output":"    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_prediction_recovers_after_stalls(dut):\n    \"\"\"Train a JALR, hit once, then change the target while both buses stall.\"\"\"\n    jalr = JALR(1, 5, 0)\n    program = {\n        0x00: ADDI(5, 0, 0x20),\n        0x04: ADDI(6, 0, 2),\n        0x08: JAL(0, 0x14 - 0x08),\n        0x0C: ADDI(5, 0, 0x48),\n        0x10: SW(5, 0, 0x44),       # Holds the third JALR in EX.\n        0x14: jalr,\n        0x18: SW(5, 0, 0x4C),       # Cold fall-through, always annulled.\n        0x20: SW(5, 0, 0x40),       # Reached twice, then speculatively a third time.\n        0x24: ADDI(6, 6, -1),\n        0x28: BEQ(6, 0, 0x0C - 0x28),\n        0x2C: JAL(0, 0x14 - 0x2C),\n        0x48: ADDI(7, 1, 1),\n        0x4C: EBREAK(),\n    }\n    bus = []\n    rets, dmem = await _run(\n        dut, lambda pc: program.get(pc, NOP()),\n        dmem_stalls={0x44: 2}, imem_stalls={0x48: 3}, bus_trace=bus,\n    )\n\n    fetches = [ia for ia, _, _ in bus]\n    cold, hit, changed = [i for i, pc in enumerate(fetches) if pc == 0x14]\n    assert fetches[cold:cold + 3] == [0x14, 0x18, 0x20]\n    assert fetches[hit:hit + 3] == [0x14, 0x20, 0x24]\n    assert fetches[changed:changed + 9] == [\n        0x14, 0x20, 0x20, 0x20, 0x48, 0x48, 0x48, 0x48, 0x4C,\n    ]\n    assert [da for _, da, wen in bus if wen] == [0x40, 0x40, 0x44, 0x44, 0x44]\n    assert dmem == {0x40: 0x20, 0x44: 0x48}\n    assert [r[\"pc\"] for r in rets] == [\n        0x00, 0x04, 0x08, 0x14, 0x20, 0x24, 0x28, 0x2C, 0x14, 0x20,\n        0x24, 0x28, 0x0C, 0x10, 0x14, 0x48, 0x4C,\n    ]\n    first, second, third = _by_insn(rets, jalr)\n    assert [r[\"pc_next\"] for r in (first, second, third)] == [0x20, 0x20, 0x48]\n    first_store, second_store = [r for r in rets if r[\"pc\"] == 0x20]\n    assert first_store[\"cycle\"] == first[\"cycle\"] + 2\n    assert second_store[\"cycle\"] == second[\"cycle\"] + 1\n    assert rets[-2][\"cycle\"] == third[\"cycle\"] + 5\n    assert rets[-2][\"rd_wdata\"] == 0x19\n\n\n@cocotb.test()\nasync def stale_prediction_on_load_recovers_during_dmem_stall(dut):\n    \"\"\"Replace a trained JAL with an LW and annul the stale target's divide.\"\"\"\n    program = {\n        0x00: ADDI(4, 0, 6),\n        0x04: JAL(0, 0x20 - 0x04),\n        0x08: ADDI(2, 1, 1),\n        0x0C: EBREAK(),\n        0x20: JAL(0, 0x04 - 0x20),\n    }\n\n    def read_imem(pc):\n        instr = program.get(pc, NOP())\n        if pc == 0x20:\n            program[0x04] = LW(1, 0, 0)\n            program[0x20] = DIV(1, 4, 4)\n        return instr\n\n    bus = []\n    rets, _ = await _run(\n        dut, read_imem, {0: 42}, dmem_stalls={0: 3}, bus_trace=bus,\n    )\n\n    assert [r[\"pc\"] for r in rets] == [0x00, 0x04, 0x20, 0x04, 0x08, 0x0C]\n    fetches = [ia for ia, _, _ in bus]\n    first, second = [i for i, pc in enumerate(fetches) if pc == 0x04]\n    assert fetches[first:first + 3] == [0x04, 0x08, 0x20]\n    assert fetches[second:second + 7] == [0x04, 0x20, 0x08, 0x08, 0x08, 0x08, 0x0C]\n    load, use = rets[3:5]\n    assert load[\"insn\"] == LW(1, 0, 0)\n    assert load[\"pc_next\"] == 0x08 and load[\"rd_wdata\"] == 42\n    assert use[\"rd_wdata\"] == 43 and use[\"cycle\"] == load[\"cycle\"] + 2\n    assert not any(wen for _, _, wen in bus)\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n","exit_code":0,"status":"completed"}}
