ed) == cycles\n        assert observed == list(range(observed[0], observed[0] + cycles))\n\n\n\\\"\\\"\\\"\nmarker = \\\"@cocotb.test()\\\\nasync def load_use_stalls\\\"\nassert marker in data\npath.write_text(data.replace(marker, test + marker))\nPY\npython3 -m pytest -q --rootdir=\\\"/srv/hwebench/tmp/4876824c/ce6ba31b/r5s0-divider-ph66bjn6/clean\\\" --confcutdir=\\\"/srv/hwebench/tmp/4876824c/ce6ba31b/r5s0-divider-ph66bjn6/clean\\\" test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
