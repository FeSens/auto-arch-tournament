lways_ff @(posedge clock) begin\n    if (train_q)\n      entries[train_pc_q[7:2]] <= {train_pc_q[31:8], recovery_pc};\n\n    if (reset)\n      valid_q <= '0;\n    else if (train_q)\n      valid_q[train_pc_q[7:2]] <= 1'b1;\n  end\n\n  logic       fetch_available, fetch_accept, bus_accept;\n  logic       empty, full;\n\n  // The read a\n…[10474 of 13546 chars elided by tools/bench/transcript.py; sha256:d8d97583c9d54885]…\n, None)\n    for _ in range(508):\n        assert await _step(dut) == (target, target, None)\n    for pc in range(target, target + 16, 4):\n        assert await _step(dut, new_word) == (pc, pc, new_word)\n\n    # Those ready words arrived after their rows were scrubbed. They must\n    # still miss because fills stay disabled through the final scrub edge.\n    await _step(dut, redirect=target, train_pc=0x104)\n    assert await _step(dut, new_word) == (target, target, new_word)\n    for _ in range(2):\n        assert await _step(dut) == (target + 4, target + 4, None)\n\n    await _step(dut, redirect=last - 4, train_pc=0x104)\n    assert await _step(dut, new_word) == (last - 4, last - 4, new_word)\n    assert await _step(dut) == (last, last, None)\n    assert await _step(dut, new_word) == (last, last, new_word)\n    assert await _step(dut) == (last, last, new_word)\n\n\ndef test_if_stage_runner():\n    run_cocotb(\n        toplevel=\"if_stage\",\n        sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n        test_module=\"test_if_stage\",\n    )\n", "exit_code": 0, "status": "completed"}}
