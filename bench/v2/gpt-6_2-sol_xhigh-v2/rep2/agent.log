{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c \"python3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all, summarize\n\ndef reduce_write_gating(rtl):\n    p = rtl / 'ex_stage.sv'\n    t = p.read_text().replace('  ctrl_t ctrl_out;', '''  logic write_advance, bad_link;\n  assign write_advance = ex_advance && \"'!in.ctrl.is_illegal;\n  assign bad_link = in.ctrl.is_jump && !(in.ctrl.is_jalr ? jalr_aligned : relative_aligned);\n\n  ctrl_t ctrl_out;'\"''').replace('in.ctrl.reg_write && side_effects', 'in.ctrl.reg_write && write_advance && \"'!bad_link'\"').replace('in.ctrl.mem_read  && side_effects','in.ctrl.mem_read  && write_advance').replace('in.ctrl.mem_write && side_effects', 'in.ctrl.mem_write && write_advance')\n    p.write_text(t)\n\ndef forward_early(rtl):\n    reduce_write_gating(rtl)\n    p = rtl / 'ex_stage.sv'\n    t = p.read_text().replace('  output logic               ex_valid,','  output logic               issue_write,\\\\n  output logic               ex_valid,').replace('  ex_mem_t reg_q;', '  assign issue_write = ctrl_out.reg_write;\\\\n  ex_mem_t reg_q;')\n    t = t.replace('  input  logic [2:0]         fwd_rs2_sel,','  input  logic [2:0]         fwd_rs2_sel,\\\\n  input  logic [2:0]         fwd_b_sel,')\n    start=t.index('  assign alu_b =')\n    end=t.index('\\\\n\\\\n',start)\n    t=t[:start]+'''  assign alu_b = ({32{fwd_b_sel[2]}} & fwd_ex_mem) |\n                 ({32{fwd_b_sel[1]}} & fwd_mem_wb) |\n                 ({32{fwd_b_sel[0]}} & in.alu_b_base);'''+t[end:]\n    p.write_text(t)\n    p = rtl / 'mem_stage.sv'\n    t=p.read_text().replace('  output mem_wb_t  out','  output logic     issue_write,\\\\n  output mem_wb_t  out').replace('  mem_wb_t reg_q;', '  assign issue_write = ctrl_with_trap.reg_write;\\\\n  mem_wb_t reg_q;')\n    p.write_text(t)\n    p = rtl / 'core_pkg.sv'\n    t=p.read_text().replace('logic [31:0] rs2_val;\\\\n    logic [31:0] imm;', 'logic [31:0] rs2_val;\\\\n    logic [31:0] alu_b_base;\\\\n    logic [31:0] imm;')\n    p.write_text(t)\n    p = rtl / 'id_stage.sv'\n    t=p.read_text().replace('  input  logic [4:0]        ex_mem_rd,','  input  logic [4:0]        ex_mem_rd,\\\\n  input  logic              ex_issue_write,\\\\n  input  logic              mem_issue_write,')\n    t=t.replace('  output logic [1:0]        match_ex_mem,\\\\n  output logic [1:0]        match_mem_wb','  output logic [2:0]        fwd_rs1_sel,\\\\n  output logic [2:0]        fwd_rs2_sel,\\\\n  output logic [2:0]        fwd_b_sel')\n    t=t.replace('  id_ex_t reg_q;', '''  id_ex_t reg_q;\n  logic [1:0] match_ex_mem, match_mem_wb;\n  logic [2:0] forward_rs1, forward_rs2;\n\n  assign match_ex_mem = (reg_q.rd \"'!= 5'\"'b0) ? {rs2_addr == reg_q.rd, rs1_addr == reg_q.rd} : 2'b0;\n  assign match_mem_wb = (ex_mem_rd \"'!= 5'\"'b0) ? {rs2_addr == ex_mem_rd, rs1_addr == ex_mem_rd} : 2'b0;\n  forward_unit u_fwd (\n    .match_ex_mem (match_ex_mem),\n    .match_mem_wb (match_mem_wb),\n    .ex_mem_w_en  (ex_issue_write),\n    .mem_wb_w_en  (mem_issue_write),\n    .fwd_rs1      (forward_rs1),\n    .fwd_rs2      (forward_rs2)\n  );''')\n    t=t.replace(\\\"      match_ex_mem <= '0;\\\\n      match_mem_wb <= '0;\\\", \\\"      fwd_rs1_sel <= '0;\\\\n      fwd_rs2_sel <= '0;\\\\n      fwd_b_sel <= '0;\\\")\n    t=t.replace('      reg_q.rs2_val  <= rs2_data;', '      reg_q.rs2_val  <= rs2_data;\\\\n      reg_q.alu_b_base <= dec_alu_src ? imm : rs2_data;')\n    start=t.index('      // Compare against')\n    end=t.index('\\\\n    end',start)\n    t=t[:start]+'''      fwd_rs1_sel <= forward_rs1;\n      fwd_rs2_sel <= forward_rs2;\n      fwd_b_sel <= dec_alu_src ? 3'b001 : forward_rs2;'''+t[end:]\n    p.write_text(t)\n    p = rtl / 'core.sv'\n    t=p.read_text().replace('  logic [1:0] match_ex_mem, match_mem_wb;\\\\n  logic [2:0] fwd_rs1_sel, fwd_rs2_sel;', '  logic       ex_issue_write, mem_issue_write;\\\\n  logic [2:0] fwd_rs1_sel, fwd_rs2_sel, fwd_b_sel;')\n    t=t.replace('    .match_ex_mem (match_ex_mem),\\\\n    .match_mem_wb (match_mem_wb)', '    .ex_issue_write (ex_issue_write),\\\\n    .mem_issue_write (mem_issue_write),\\\\n    .fwd_rs1_sel  (fwd_rs1_sel),\\\\n    .fwd_rs2_sel  (fwd_rs2_sel),\\\\n    .fwd_b_sel    (fwd_b_sel)',1)\n    t=t.replace('    .fwd_rs2_sel          (fwd_rs2_sel),','    .fwd_rs2_sel          (fwd_rs2_sel),\\\\n    .fwd_b_sel            (fwd_b_sel),').replace('    .ex_valid             (ex_valid),', '    .issue_write          (ex_issue_write),\\\\n    .ex_valid             (ex_valid),',1).replace('    .out        (mem_wb_w)','    .issue_write (mem_issue_write),\\\\n    .out        (mem_wb_w)')\n    start=t.index('  forward_unit u_fwd (')\n    end=t.index('\\\\n\\\\n',start)\n    p.write_text(t[:start]+t[end:])\n\ndef test(change):\n    base = Path(mkdtemp(prefix=f'bench-r13-{change.__name__}-'))\n    print(base, flush=True)\n    rtl = base / 'rtl'\n    copytree('cores/bench/rtl', rtl)\n    change(rtl)\n    res = build_all(Path.cwd(), rtl, 'fpga/core_bench_si.sv', base, options=(0,1))\n    print(change.__name__, summarize(res), flush=True)\n    for r in res:\n        print(change.__name__, r['place_option'], r.get('critical_paths', [])[:3], flush=True)\n\nwith ThreadPoolExecutor() as pool:\n    jobs = [pool.submit(test, change) for change in (reduce_write_gating, forward_early)]\n    for job in jobs:\n        job.result()\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
