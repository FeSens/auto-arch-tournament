{"type": "item.started", "item": {"id": "item_40", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r11-veprb4la/early_forward.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path(__file__).resolve().parent\nchampion = Path('cores/bench/rtl')\nvariants = [('early-forward', champion), ('early-forward-split', root/'split-miss-collision'), ('early-forward-pc', root/'pc-compare')]\nfor variant, src in variants:\n    dst=root/variant\n    shutil.copytree(src, dst)\n    p=dst/'core.sv'\n    s=p.read_text()\n    s=s.replace('logic [2:0] fwd_rs1_sel, fwd_rs2_sel;', '''logic [2:0] fwd_rs1_sel, fwd_rs2_sel;\n  logic [2:0] fwd_rs1_next, fwd_rs2_next;\n  logic       ex_write_next, mem_write_next;''')\n    s=s.replace('.match_mem_wb (match_mem_wb)\\\\n  );', '''.match_mem_wb (match_mem_wb),\n    .fwd_rs1_next (fwd_rs1_next),\n    .fwd_rs2_next (fwd_rs2_next),\n    .fwd_rs1_sel  (fwd_rs1_sel),\n    .fwd_rs2_sel  (fwd_rs2_sel)\n  );''')\n    s=s.replace('.out                  (ex_mem_w),', '.out                  (ex_mem_w),\\\\n    .forward_write_next   (ex_write_next),')\n    s=s.replace('.out        (mem_wb_w)', '.forward_write_next (mem_write_next),\\\\n    .out        (mem_wb_w)')\n    s=s.replace('.ex_mem_w_en  (ex_mem_w.ctrl.reg_write),', '.ex_mem_w_en  (ex_write_next),')\n    s=s.replace('.mem_wb_w_en  (mem_wb_w.ctrl.reg_write),', '.mem_wb_w_en  (mem_write_next),')\n    s=s.replace('.fwd_rs1      (fwd_rs1_sel),', '.fwd_rs1      (fwd_rs1_next),')\n    s=s.replace('.fwd_rs2      (fwd_rs2_sel)', '.fwd_rs2      (fwd_rs2_next)')\n    p.write_text(s)\n    p=dst/'ex_stage.sv'\n    s=p.read_text().replace('output ex_mem_t  out,', 'output ex_mem_t  out,\\\\n  output logic               forward_write_next,')\n    s=s.replace('  // ── EX/MEM register', '  assign forward_write_next = ctrl_out.reg_write;\\\\n\\\\n  // ── EX/MEM register')\n    p.write_text(s)\n    p=dst/'mem_stage.sv'\n    s=p.read_text().replace('output mem_wb_t  out', 'output mem_wb_t  out,\\\\n  output logic forward_write_next')\n    s=s.replace('  // ── MEM/WB register', '  assign forward_write_next = ctrl_with_trap.reg_write;\\\\n\\\\n  // ── MEM/WB register')\n    p.write_text(s)\n    p=dst/'id_stage.sv'\n    s=p.read_text().replace('output logic [1:0]        match_mem_wb', '''output logic [1:0]        match_mem_wb,\n  input  logic [2:0]        fwd_rs1_next,\n  input  logic [2:0]        fwd_rs2_next,\n  output logic [2:0]        fwd_rs1_sel,\n  output logic [2:0]        fwd_rs2_sel''')\n    s=s.replace(\\\"      match_ex_mem <= '0;\\\\n      match_mem_wb <= '0;\\\", \\\"      fwd_rs1_sel <= '0;\\\\n      fwd_rs2_sel <= '0;\\\")\n    a=s.index('      // Compare against the producers')\n    b=s.index('    end\\\\n  end\\\\n', a)\n    s=s[:a]+'''      fwd_rs1_sel <= fwd_rs1_next;\n      fwd_rs2_sel <= fwd_rs2_next;\n'''+s[b:]\n    s=s.replace('  assign out = reg_q;', '''  assign match_ex_mem[0] = (reg_q.rd \"'!= 5'\"'b0) && (rs1_addr == reg_q.rd);\n  assign match_ex_mem[1] = (reg_q.rd \"'!= 5'\"'b0) && (rs2_addr == reg_q.rd);\n  assign match_mem_wb[0] = (ex_mem_rd \"'!= 5'\"'b0) && (rs1_addr == ex_mem_rd);\n  assign match_mem_wb[1] = (ex_mem_rd \"'!= 5'\"'b0) && (rs2_addr == ex_mem_rd);\n  assign out = reg_q;''')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/bench-r11-veprb4la/early_forward.py\"\npython - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path('/srv/hwebench/tmp/4876824c/bf7d2cca/bench-r11-veprb4la')\nvariants = ('early-forward', 'early-forward-split', 'early-forward-pc')\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    futs = [(name, executor.submit(build_all, Path.cwd(), root / name, 'fpga/core_bench_si.sv', root / ('gowin-' + name))) for name in variants]\n    for name, fut in futs:\n        records = fut.result()\n        print(name, summarize(records), flush=True)\n        print([(r['place_option'], [(p['from'], p['to']) for p in r.get('critical_paths', [])[:3]]) for r in records], flush=True)\nPY\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
