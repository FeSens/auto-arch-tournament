{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile' <<'PY'\nimport concurrent.futures, pathlib, shlex, subprocess, sys\nfrom tools.eval.cosim import run_one, TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart\nimport json\nscratch = pathlib.Path(sys.argv[1])\nsim = str(scratch / 'refined_obj/cosim_sim')\ncommand = [sim, str(scratch / 'coremark.elf'), '6000000', '--bench', '--istall', '--dstall']\nout = subprocess.run(command, capture_output=True, text=True, check=True)\nresult = json.loads(out.stdout.splitlines()[-1])\nassert result['bench_bracketed'] and result['ebreak'] and not result['oob']\nassert validate_coremark_uart(result['uart'], 10) == (True, None)\nprint('CoreMark canonical CRCs passed in', result['bench_stop_cycle'] - result['bench_start_cycle'], 'cycles', flush=True)\nprograms = ('selftest', 'random1', 'random2', 'random3')\nelfs = []\nfor program in programs:\n    cmd = subprocess.check_output(['make', '-Bn', '-f', 'bench/programs/Makefile', f'bench/programs/{program}.elf'], text=True)\n    args = shlex.split(cmd)\n    assert args[0] == 'riscv32-unknown-elf-gcc'\n    args[0] = '/srv/hwebench/toolchain/bin/' + args[0]\n    elf = scratch / f'{program}.elf'\n    args[-1] = str(elf)\n    subprocess.run(args, check=True)\n    elfs.append(elf)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = [pool.submit(run_one, elf, sim, str(pathlib.Path.cwd()), sim_flags=flags)\n            for elf in elfs for flags in TRACE_STALL_MODES]\n    for job in jobs:\n        print(job.result(), flush=True)\n    assert all(job.result()['passed'] for job in jobs)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
