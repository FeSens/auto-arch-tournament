h_pc + 30'd1;\n\n  always_ff @(posedge clock) begin\n    if (train_q)\n      entries[train_pc_q[7:2]] <= {train_pc_q[31:8], recovery_pc};\n\n    if (reset)\n      valid_q <= '0;\n    else if (train_q)\n      valid_q[train_pc_q[7:2]] <= 1'b1;\n  end\n\n  logic       fetch_available, fetch_accept, bus_accept;\n  logic       empty, full;\n\n  // The read a\n…[9806 of 12878 chars elided by tools/bench/transcript.py; sha256:36c3e1b779078864]…\n0x2000)\n    assert await _step(dut) == (8, 8, None)\n\n\n@cocotb.test()\nasync def redirect_scrubs_replay_while_external_fetch_advances(dut):\n    await _reset_and_scrub(dut)\n    last = 0x7FC\n    old_word, new_word = 0x12345678, 0x11223344\n    await _step(dut, redirect=last, train_pc=last)\n    await _step(dut)\n    assert await _step(dut, old_word) == (last, last, old_word)\n    assert await _step(dut) == (last, last, old_word)\n\n    # A non-training redirect invalidates the replay hit immediately.\n    # Progress over external fetches, while permitting the last row to scrub.\n    target = 0x1000\n    assert await _step(dut, redirect=target, consume=False) == (last, last, None)\n    for _ in range(508):\n        assert await _step(dut) == (target, target, None)\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/div_unit.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_div_unit.py\n M cores/bench/test/test_pipeline.py\n?? cores/bench/test/test_if_stage.py\n", "exit_code": 0, "status": "completed"}}
