{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"sed -n '1,100p' cores/bench/rtl/forward_unit.sv && sed -n '250,310p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/forward_unit.sv\n//\n// Qualify nonzero tag matches with the producer write enables before ID/EX\n// capture. Select order is {EX/MEM, MEM/WB, ID/EX}.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic [1:0] match_ex_mem, // {rs2, rs1}\n  input  logic [1:0] match_mem_wb, // {rs2, rs1}\n  input  logic       ex_mem_w_en,\n  input  logic       mem_wb_w_en,\n  output logic [1:0] ex_mem_match,\n  output logic [1:0] mem_wb_match,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  logic [1:0] select_mem_wb, select_id_ex;\n\n  assign ex_mem_match  = match_ex_mem & {2{ex_mem_w_en}};\n  assign mem_wb_match  = match_mem_wb & {2{mem_wb_w_en}};\n  assign select_mem_wb = ~ex_mem_match & mem_wb_match;\n  assign select_id_ex  = ~(ex_mem_match | mem_wb_match);\n\n  assign fwd_rs1 = {ex_mem_match[0], select_mem_wb[0], select_id_ex[0]};\n  assign fwd_rs2 = {ex_mem_match[1], select_mem_wb[1], select_id_ex[1]};\n\nendmodule\n      end else if (push) begin\n        queue_empty_q <= 1'b0;\n      end\n      if (push)\n        write_ptr_q <= write_ptr_q + 3'd1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_q                <= '0;\n      pc_index_q          <= '0;\n      normal_hold_q       <= 1'b0;\n      late_hold_q         <= 1'b0;\n      recovery_wait_q     <= 1'b0;\n      reject_target_q     <= 1'b0;\n      reject_sequential_q <= 1'b0;\n    end else begin\n      if (fetch_accept) begin\n        pc_q <= predicted_pc;\n        pc_index_q <= predicted_index;\n      end\n      // Fetch can continue as soon as the target response is buffered.\n      // EX remains squashed until decode issues that first instruction.\n      normal_hold_q <= normal_correction && !imem_ready;\n      late_hold_q <= late_correction && !imem_ready;\n      // EX is squashed during recovery, so only a dmem hold blocks issue.\n      recovery_wait_q <= recovering && !(recovery_issue_ready && decode_valid);\n      reject_target_q <= reject_target;\n      reject_sequential_q <= reject_sequential;\n    end\n\n    // Capture the resolved address independently of EX's comparison.\n    // Hold it while the corrected fetch waits, and use it as the staged\n    // target when an advancing control transfer was taken.\n    if (!recovering)\n      recovery_pc_q <= take_target ? target_pc : sequential_pc;\n    take_target_q        <= take_target;\n    train_tag_q          <= train_pc[31:9];\n    train_index_q        <= pc_hash(train_pc[15:2]);\n    train_replay_index_q <= train_pc[10:2];\n    train_branch_q       <= train_branch;\n    train_q              <= !reset && train;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
