not marker.get('ebreak', False):\n        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n        # a hung CPU with whatever cycle count it happened to reach.\n        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n                'reason': 'maxcycles_hit_before_ebreak'}\n\n    # OOB sticky flag from the sim:\n…[7104 of 10176 chars elided by tools/bench/transcript.py; sha256:675edf0a5b41bb50]…\nformed_marker',\n                'detail': f'{e}: {lines[-1][:500]}'}\n    if not marker.get('ebreak', False):\n        return {'passed': False, 'elf': coremark_elf.name, 'field': 'no_ebreak',\n                'detail': 'maxcycles hit before ebreak'}\n    if marker.get('oob', False):\n        return {'passed': False, 'elf': coremark_elf.name, 'field': 'oob_access',\n                'detail': marker.get('uart', '')[-500:]}\n    iterations = parse_iterations(worktree)\n    valid, reason = validate_coremark_uart(marker.get('uart', ''), iterations)\n    if not valid:\n        return {'passed': False, 'elf': coremark_elf.name, 'field': 'crc_mismatch',\n70:    //           (tools/eval/fpga.py:run_coremark_ipc) passes BOTH so the\n100:    top->io_imemReady = 1;\n101:    top->io_dmemReady = 1;\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n141:            if (top->io_dmemREn) oob_access = true;\n149:        if(top->io_dmemWEn && top->io_dmemReady) {\n", "exit_code": 0, "status": "completed"}}
