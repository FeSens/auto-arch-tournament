{"type":"item.started","item":{"id":"item_134","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nsimple_targets={}\ntagged_targets={}\ndirections={}\nsimple_misses=0\nhysteresis_misses=0\ntransfers=0\nfor line in open('controls.log'):\n    if not line.startswith('B '):\n        continue\n    _,pc,following,target,conditional,_,taken=line.split()\n    pc,following,target=[int(x,16)>>2 for x in (pc,following,target)]\n    conditional,taken=int(conditional),int(taken)\n    transfers+=1\n    simple_index=pc&63\n    simple_pc,simple_prediction=simple_targets.get(simple_index,(-1,0))\n    simple_misses+=(simple_prediction if simple_pc==pc else pc+1)\"'!=following\n    simple_targets[simple_index]=(pc,following)\n    index=(pc''^(pc>>6))&63\n    tag,prediction,conditional_entry=tagged_targets.get(index,(-1,0,0))\n    direction=directions.get(index,1)\n    hysteresis_misses+=(prediction if tag==pc and (not conditional_entry or direction>=2) else pc+1)!=following\n    if (pc>>14)==(target>>14):\n        tagged_targets[index]=(pc,target,conditional)\n    else:\n        tagged_targets.pop(index,None)\n    if conditional:\n        directions[index]=max(0,min(3,direction+(1 if taken else -1)))\nprint(transfers,simple_misses,hysteresis_misses,100*(1-hysteresis_misses/simple_misses))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
