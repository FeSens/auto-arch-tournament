{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '290,700p' cores/bench/test/test_pipeline.py; sed -n '1,200p' cores/bench/test/_helpers.py\"", "aggregated_output": "    assert [(addr, ren, wen, ready) for addr, ren, wen, _, ready in requests] == (\n        [(3, 1, 0, True)]\n        + [(0x4B, 0, 0x8, False)] * 3 + [(0x4B, 0, 0x8, True)]\n        + [(0x43, 1, 0, False)] * 2 + [(0x43, 1, 0, True)]\n    )\n    assert [wdata for _, _, wen, wdata, _ in requests if wen] == [0x4C4C4C4C] * 4\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def divide_after_stalled_store(dut):\n    program = [\n        ADDI(2, 0, 7),\n        LW(1, 0, 0),\n        SW(2, 0, 4),\n        DIV(3, 1, 2),\n        ADDI(4, 3, 2),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, {0: 100}, dmem_stalls={4: 3})\n\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert all(r[\"trap\"] == 0 for r in rets)\n    _, load, store, divide, use, _ = rets\n    assert load[\"rd_wdata\"] == 100\n    assert store[\"mem_addr\"] == 4 and store[\"mem_wmask\"] == 0xF\n    assert store[\"mem_wdata\"] == dmem[4] == 7\n    assert store[\"cycle\"] - load[\"cycle\"] == 4\n    assert divide[\"cycle\"] - store[\"cycle\"] == 9\n    assert divide[\"rs1_rdata\"] == 100 and divide[\"rs2_rdata\"] == 7\n    assert divide[\"rd\"] == 3 and divide[\"rd_wdata\"] == \n…[12173 of 15245 chars elided by tools/bench/transcript.py; sha256:4fb871e382c116a9]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
