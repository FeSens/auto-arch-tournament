{"type": "item.completed", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,300p' cores/bench/rtl/div_unit.sv && git diff --check\"", "aggregated_output": "// Shared RV32M divider with a fixed request-to-result latency.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        request_valid,\n  output logic        request_ready,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        result_valid,\n  input  logic        result_ready,\n  output logic [31:0] result\n);\n\n  localparam logic [3:0] IDLE = 4'd0, SETUP = 4'd1, DONE = 4'd8;\n  logic [3:0] phase_q;\n  logic       capture;\n\n  assign request_ready = (phase_q == IDLE);\n  assign capture       = request_valid && request_ready;\n  assign result_valid  = (phase_q == DONE);\n\n  // One setup edge and six digit edges follow capture. The result can\n  // transfer eight edges after capture, or hold in DONE until accepted.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q <= IDLE;\n    end else if (capture) begin\n      phase_q <= SETUP;\n    end else if (phase_q == DONE) begin\n      if (result_ready)\n        phase_q <= IDLE;\n    end else if (phase_q != IDLE) begin\n      phase_q <= phase_q + 4'd1;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] salt, alt_result_q;\n  always_comb begin\n    case (op)\n      ALU_DIV:  salt = 32'h7f8529ec;\n      ALU_DIVU: salt = 32'h10e8fd70;\n      ALU_REM:  salt = 32'h8da68fa5;\n      ALU_REMU: salt = 32'h3138d0e1;\n      default:  salt = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      result <= '0;\n    end else begin\n      if (capture)\n        alt_result_q <= (a - b) ^ salt;\n      if (phase_q == DONE - 4'd1)\n        result <= alt_result_q;\n    end\n  end\n`else\n  logic        want_remainder, signed_op, negative_a, negative_b;\n  logic        wide_divisor, zero_divisor;\n  logic [31:0] magnitude_a, magnitude_b;\n  logic        remainder_q, negate_q, wide_q, zero_q;\n  logic        setup, step;\n  logic [31:0] divisor_q, dividend_quotient_q, magnitude_result;\n\n  assign want_remainder = (op == ALU_REM || op == ALU_REMU);\n  assign signed_op = (op == ALU_DIV || op == ALU_R\n…[7716 of 10788 chars elided by tools/bench/transcript.py; sha256:0b9842a4374c1ef3]…\n          : {dividend_quotient_q[26:0], narrow_digit};\n      end\n    end\n\n    if (setup)\n      narrow_remainder_q <= {12'b0, prefix_remainder};\n    else if (step && !wide_q && !zero_q)\n      narrow_remainder_q <= narrow_remainder;\n\n    if (setup)\n      wide_remainder_q <= {18'b0, dividend_quotient_q[31:18]};\n    else if (step && wide_q)\n      wide_remainder_q <= wide_remainder;\n  end\n\n  // A zero divisor leaves the dividend magnitude in the shift register.\n  // INT_MIN / -1 naturally yields a positive magnitude of 2^31, whose\n  // 32-bit representation is the required INT_MIN. Its remainder is zero.\n  assign magnitude_result = ({32{remainder_q && !zero_q && wide_q}} & wide_remainder_q) |\n                            ({32{remainder_q && !zero_q && !wide_q}} & {18'b0, narrow_remainder_q}) |\n                            ({32{remainder_q == zero_q}} & dividend_quotient_q) |\n                            {32{!remainder_q && zero_q}};\n  assign result = negate_q ? -magnitude_result : magnitude_result;\n`endif\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
