e begin\n\t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c \"R8_MATCH_ROOT='/srv/hwebench/tmp/4876824c/7a4a8d78/r8s1-lanes.465noxe0' python - <<'PY'\n\nfrom pathlib import Path\nimport os, shutil, tempfile\nparent=Path(tempfile.mkdtemp(prefix='r8s1-div.',dir=os.environ['TMPDIR']))\nfor variant in ('two','three','three_check'):\n    root=parent/variant\n    dst=root/'cores/bench'\n    dst.mkdir(parents=True)\n    shutil.copytree('cores/bench/rtl',dst/'rtl')\n    shutil.copy('cores/bench/core.yaml',dst)\n    shutil.copytree('fpga',root/'fpga')\n    if variant=='three_check':\n        shutil.copy(Path(os.environ['R8_MATCH_ROOT'])/'jalr/cores/bench/rtl/ex_stage.sv',dst/'rtl')\n    p=dst/'rtl/div_unit.sv'\n    s=p.read_text().split('\"'`else'\"',1)[0]+\\\"\"'`else'\"\\\\n\\\"\n    lanes=[\n        ('small',5,14,19,19,2),\n        ('medium',3,20,23,23,14),\n        ('large',2,32,32,34,20),\n    ] if variant\"'!='\"'two' else [\n        ('small',5,14,19,19,2),\n        ('large',3,32,32,35,14),\n    ]\n    s+=\\\"\\\"\\\"\n  logic [31:0] dividend_quotient_q, divisor_q;\n  logic        remainder_q, negate_q, zero_q;\n  logic        negative_a, negative_b, want_remainder;\n  logic [31:0] dividend, divisor, remainder, selected_magnitude;\n  logic [31:0] next_dividend_quotient;\n  logic is_small, is_medium;\n  assign want_remainder = (op == ALU_REM || op == ALU_REMU);\n  assign negative_a = (op == ALU_DIV || op == ALU_REM) && a[31];\n  assign negative_b = (op == ALU_DIV || op == ALU_REM) && b[31];\n  assign dividend = negative_a ? -a : a;\n  assign divisor = negative_b ? -b : b;\n  assign is_small  = negative_b ? (b > 32'hffffc000) : (b < 32'h00004000);\n\\\"\\\"\\\"\n    if len(lanes)==3:\n        s+=\\\"  assign is_medium = negative_b ? (b > 32'hfff00000) : (b < 32'h00100000);\\\\n\\\"\n    else:\n        s=s.replace('is_small, is_medium','is_small')\n    s+=\\\"\\\"\\\"\n  logic [1:0] small_prefix_in, small_prefix_digit, small_prefix_rem;\n  assign small_prefix_in = dividend_quotient_q[31:30];\n  always_comb begin\n    small_prefix_digit = '0;\n    small_prefix_rem = small_prefix_in;\n    case (divisor_q[13:0])\n      14'd1: begin\n        small_prefix_digit = small_prefix_in;\n        small_prefix_rem = '0;\n      end\n      14'd2: begin\n        small_prefix_digit = {1'b0, small_prefix_in[1]};\n        small_prefix_rem = {1'b0, small_prefix_in[0]};\n      end\n      14'd3: begin\n        small_prefix_digit = {1'b0, &small_prefix_in};\n        small_prefix_rem = (&small_prefix_in) ? 2'd0 : small_prefix_in;\n      end\n      default: ;\n    endcase\n  end\n\\\"\\\"\\\"\n    for name,k,w,tw,mw,prefix in lanes:\n        size=1<<k\n        s+=f\\\"\\\"\\\"\n  logic {name}_q;\n  logic [{w-1}:0] {name}_r_q, {name}_r_next;\n  logic [{mw-1}:0] {name}_multiples [0:{(size//2)-1}];\n  logic [{tw-1}:0] {name}_trial;\n  logic [{tw}:0] {name}_diff [0:{size-1}];\n  logic [{size}:0] {name}_borrow;\n  logic [{size-1}:0] {name}_pick;\n  logic [{k-1}:0] {name}_digit;\n  wire [{mw-1}:0] {name}_divisor = {mw}'(divisor_q[{w-1}:0]);\n\n  assign {name}_multiples[0] = {name}_divisor;\n  assign {name}_trial = {tw}'({{{name}_r_q, dividend_quotient_q[31:{32-k}]}}); \n  assign {name}_diff[0] = {{1'b0, {name}_trial}};\n  assign {name}_borrow[{size}] = 1'b1;\n  assign {name}_borrow[0] = 1'b0;\n\\\"\\\"\\\"\n        s+=f'''\n  function automatic logic [{mw-1}:0] {name}_sum3(\n    input logic [{mw-1}:0] x, y, z\n  );\n    {name}_sum3 = (x \"'^ y ''^ z) + (((x & y) | ((x | y) & z)) << 1);\n  endfunction\n'\"''' if k>=3 else \\\"\\\"\n        def shifted(v):\n            d=f'{name}_divisor'\n            return (f'({d} << {v})' if v else d)\n        for j in range(1,size//2):\n            n=2*j+1\n            width=n.bit_length()\n            parts=[shifted(i) for i in range(width) if n&(1<<i)]\n            signed_parts=[shifted(i) for i in range(width+1) if (n+1)&(1<<i)]\n            if len(signed_parts)==1:\n                expression=signed_parts[0]+f' - {shifted(0)}'\n            elif len(parts) == 2:\n                expression=' + '.join(parts)\n            elif len(signed_parts)==2 and len(parts)>=4:\n                expression=f'{name}_sum3({signed_parts[0]}, {signed_parts[1]}, ~{shifted(0)}) + {mw}\\\\'d1'\n            elif len(parts)==3:\n                expression=f\\\"{name}_sum3({', '.join(parts)})\\\"\n            else:\n                expression=f\\\"{name}_sum3({', '.join(parts[:3])}) + {parts[3]}\\\"\n            s+=f'''\n  always_ff @(posedge clock)\n    if (phase_q == PREFIX)\n      {name}_multiples[{j}] <= {expression};\n'''\n        s+=f\\\"\\\"\\\"\n  for (genvar digit = 1; digit < {size}; digit++) begin : gen_{name}_trial\n    localparam int SHIFT = (digit % 2 \"'!= 0) ? 0 : (digit % 4 != 0) ? 1 :\n                           (digit % 8 != 0) ? 2 : (digit % 16 != 0) ? 3 : 4;\n    logic [{mw-1}:0] multiple;\n    assign multiple = {name}_multiples[(digit >> SHIFT) / 2] << SHIFT;\n    assign {name}_diff[digit] = {{1'\"'b0, {name}_trial}} - {{1'b0, multiple[{tw-1}:0]}};\n    assign {name}_borrow[digit] = {name}_diff[digit][{tw}]{' || |multiple['+str(mw-1)+':'+str(tw)+']' if mw>tw else ''};\n  end\n  for (genvar digit = 0; digit < {size}; digit++) begin : gen_{name}_select\n    assign {name}_pick[digit] = {name}_borrow[digit+1] && \"'!{name}_borrow[digit];\n  end\n\n  always_comb begin\n    {name}_r_next = '\"'0;\n    {name}_digit = '0;\n    for (int digit = 0; digit < {size}; digit++) begin\n      {name}_r_next |= {{{w}{{{name}_pick[digit]}}}} & {name}_diff[digit][{w-1}:0];\n      {name}_digit |= {{{k}{{{name}_pick[digit]}}}} & {k}'(digit);\n    end\n  end\n\\\"\\\"\\\"\n    s+=\\\"\\\\n  assign next_dividend_quotient = \\\"+' |\\\\n      '.join(f\\\"({{32{{{name}_q}}}} & {{dividend_quotient_q[{31-k}:0], {name}_digit}})\\\" for name,k,*_ in lanes)+\\\";\\\\n\\\"\n    s+=\\\"\\\\n  assign remainder = \\\"+' |\\\\n      '.join(f\\\"({{32{{{name}_q}}}} & 32'({name}_r_q))\\\" for name,*_ in lanes)+\\\";\\\\n\\\"\n    s+=\\\"\\\"\\\"\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      dividend_quotient_q <= dividend;\n      divisor_q <= divisor;\n      remainder_q <= want_remainder;\n      negate_q <= want_remainder ? negative_a : ((negative_a \"'^ negative_b) && b != 0);\n      zero_q <= b == 0;\n      small_q <= is_small;\n\"\"\"\n    if len(lanes)==3:\n        s+=\"      medium_q <= !is_small && is_medium;'\"\\\\n      large_q <= \"'!is_medium;'\"\\\\n\\\"\n    else:\n        s+=\\\"      large_q <= \"'!is_small;'\"\\\\n\\\"\n    s+=\\\"\\\"\\\"    end else if (phase_q == PREFIX && \"'!zero_q) begin\n      small_r_q <= 14'\"'(small_prefix_rem);\n      if (small_q)\n        dividend_quotient_q <= {dividend_quotient_q[29:0], small_prefix_digit};\n\\\"\\\"\\\"\n    for name,k,w,tw,mw,prefix in lanes[1:]:\n        s+=f\\\"\\\"\\\"      {name}_r_q <= {w}'(dividend_quotient_q[31:{32-prefix}]);\n      if ({name}_q)\n        dividend_quotient_q <= {{dividend_quotient_q[{31-prefix}:0], {prefix}'d0}};\n\\\"\\\"\\\"\n    s+=\\\"\\\"\\\"    end else if (phase_q > PREFIX && phase_q < DONE && \"'!zero_q) begin\n      dividend_quotient_q <= next_dividend_quotient;\n\"\"\"\n    for name,*_ in lanes:\n        s+=f'\"'      {name}_r_q <= {name}_r_next;\\\\n'\n    s+=\\\"\\\"\\\"    end\n  end\n\n  assign selected_magnitude = remainder_q ? (zero_q ? dividend_quotient_q : remainder)\n                                          : (zero_q ? 32'hffffffff : dividend_quotient_q);\n  assign result = negate_q ? -selected_magnitude : selected_magnitude;\n\"'`endif\nendmodule\n\"\"\"\n    p.write_text(s)\nprint(parent)\n\nPY'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
