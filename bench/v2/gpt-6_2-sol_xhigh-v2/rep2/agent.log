{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/4876824c/c0ad7f1d/bench-predictor.TVISEp/replay.cpp' <<'CPP'\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <vector>\n#include <string>\n\nstruct Record { uint32_t pc, insn, next, cycle, trap; };\nstruct Entry { uint32_t tag = 0, target = 0; int counter = 0; bool valid = false; };\nstruct Predictor {\n    unsigned index_bits;\n    bool xor_index;\n    bool bimodal;\n    std::vector<Entry> table;\n    uint64_t errors = 0;\n    std::array<uint64_t, 3> errors_by_type{};\n    Predictor(unsigned bits, bool hash, bool c)\n        : index_bits(bits), xor_index(hash), bimodal(c), table(1u << bits) {}\n    void apply(const Record& r, int type, bool measured) {\n        uint32_t word_pc = r.pc >> 2;\n        uint32_t index = word_pc;\n        if (xor_index) index \"'^= word_pc >> index_bits;\n        Entry& e = table[index & (table.size() - 1)];\n        const bool hit = e.valid && e.tag == r.pc;\n        const uint32_t fallthrough = r.pc + 4;\n        const uint32_t guess = hit && (!bimodal || e.counter >= 2) ? e.target : fallthrough;\n        if (measured && guess != r.next) {\n            ++errors;\n            if (type >= 0) ++errors_by_type[type];\n        }\n        if (type < 0 || r.trap) return;\n        if (!bimodal || type > 0) {\n            e = {r.pc, r.next, 3, true};\n            return;\n        }\n        const bool taken = r.next != fallthrough;\n        if (!hit) {\n            e = {r.pc, r.next, taken ? 2 : 1, true};\n        } else if (taken) {\n            e.target = r.next;\n            if (e.counter < 3) ++e.counter;\n        } else if (e.counter > 0) {\n            --e.counter;\n        }\n    }\n};\nint main(int argc, char** argv) {\n    auto* trace = std::fopen(argv[1], \"rb\");\n    if (!trace) return 1;\n    unsigned start = std::stoul(argv[2]), stop = std::stoul(argv[3]);\n    std::vector<Predictor> predictors;\n    for (unsigned bits = 3; bits <= 8; ++bits)\n        for (bool hash : {false, true})\n            for (bool c : {false, true}) predictors.emplace_back(bits, hash, c);\n    uint64_t count = 0, baseline = 0, btfnt = 0;\n    std::array<uint64_t, 3> controls{}, baseline_by_type{}, btfnt_by_type{};\n    Record r;\n    while (std::fread(&r, sizeof(r), 1, trace) == 1) {\n        const unsigned opcode = r.insn & 127;\n        int type = opcode == 0x63 ? 0 : opcode == 0x6f ? 1 : opcode == 0x67 ? 2 : -1;\n        const bool measured = r.cycle >= start && r.cycle < stop;\n        for (auto& p : predictors) p.apply(r, type, measured);\n        if (!measured) continue;\n        ++count;\n        if (type < 0) continue;\n        ++controls[type];\n        if (r.next != r.pc + 4) {\n            ++baseline;\n            ++baseline_by_type[type];\n        }\n        const bool static_taken = type == 1 || (type == 0 && (r.insn >> 31) != 0);\n        if (static_taken != (r.next != r.pc + 4)) {\n            ++btfnt;\n            ++btfnt_by_type[type];\n        }\n    }\n    std::printf(\"Count %llu'\"\\\\n\\\", (unsigned long long) count);\n    std::printf(\\\"Controls branches=%llu JAL=%llu JALR=%llu\\\\n\\\", (unsigned long long) controls[0], (unsigned long long) controls[1], (unsigned long long) controls[2]);\n    std::printf(\\\"Baseline %llu (%llu, %llu, %llu)\\\\n\\\", (unsigned long long) baseline, (unsigned long long) baseline_by_type[0], (unsigned long long) baseline_by_type[1], (unsigned long long) baseline_by_type[2]);\n    std::printf(\\\"Static   %llu (%llu, %llu, %llu)\\\\n\\\", (unsigned long long) btfnt, (unsigned long long) btfnt_by_type[0], (unsigned long long) btfnt_by_type[1], (unsigned long long) btfnt_by_type[2]);\n    for (const auto& p : predictors) {\n        const double base_cycles = stop - start;\n        const double gain_pct = 100 * (base_cycles / (base_cycles - baseline + p.errors) - 1.0);\n        std::printf(\\\"%3zu %3s %7s %7llu (%6llu, %5llu, %5llu) proxy %+5.2f%%\\\\n\\\",\n                    p.table.size(), p.xor_index ? \\\"xor\\\" : \\\"lo\\\", p.bimodal ? \\\"bimodal\\\" : \\\"last\\\",\n                    (unsigned long long) p.errors, (unsigned long long) p.errors_by_type[0],\n                    (unsigned long long) p.errors_by_type[1], (unsigned long long) p.errors_by_type[2], gain_pct);\n    }\n}\nCPP\ng++ -std=c++17 -O3 '/srv/hwebench/tmp/4876824c/c0ad7f1d/bench-predictor.TVISEp/replay.cpp' -o '/srv/hwebench/tmp/4876824c/c0ad7f1d/bench-predictor.TVISEp/replay'\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
