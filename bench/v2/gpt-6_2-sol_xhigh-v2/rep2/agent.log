{"type":"item.started","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_pipeline.py')\ns=p.read_text()\ns=s.replace('0x14, 0x20, 0x20, 0x20, 0x48, 0x48, 0x48, 0x48, 0x4C,', '0x14, 0x20, 0x24, 0x28, 0x48, 0x48, 0x48, 0x48, 0x4C,')\ns=s.replace('[0x04, 0x20, 0x08, 0x08, 0x08, 0x08, 0x0C]', '[0x04, 0x20, 0x08, 0x0C, 0x10, 0x14, 0x18]')\ntag='@cocotb.test()\\\\nasync def sw_lw_roundtrip'\ns=s.replace(tag, '''@cocotb.test()\nasync def full_fetch_queue_pops_and_refills(dut):\n    increment = ADDI(1, 1, 1)\n    bus = []\n    rets, dmem = await _run(\n        dut, [SW(0, 0, 0x80)] + [increment] * 24 + [EBREAK()],\n        dmem_stalls={0x80: 25}, imem_stalls={0x50: 4}, bus_trace=bus,\n    )\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, 26 * 4, 4))\n    assert [r[\\\"rd_wdata\\\"] for r in _by_insn(rets, increment)] == list(range(1, 25))\n    assert dmem == {0x80: 0}\n    last_store_cycle = [i for i, (_, da, wen) in enumerate(bus) if wen and da == 0x80][-1]\n    fetches = [ia for ia, _, _ in bus]\n    assert fetches[last_store_cycle-1:last_store_cycle+2] == [0x4C, 0x4C, 0x50]\n    assert fetches[last_store_cycle+1:last_store_cycle+6] == [0x50] * 5\n    assert all(b[\\\"cycle\\\"] == a[\\\"cycle\\\"] + 1 for a,b in zip(rets, rets[1:]))\n\n\n@cocotb.test()\nasync def full_fetch_queue_discards_wrong_path_on_cross_page_redirect(dut):\n    program = {\n        0x00: SW(0, 0, 0x80),\n        0x04: JAL(0, 0x10008 - 0x04),\n        0x08: SW(0, 0, 0x84),\n        0x10008: DIV(2, 0, 0),\n        0x1000C: EBREAK(),\n    }\n    bus = []\n    rets, dmem = await _run(\n        dut, lambda pc: program.get(pc, NOP()),\n        dmem_stalls={0x80: 25}, bus_trace=bus,\n    )\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 0x10008, 0x1000C]\n    assert rets[1][\\\"pc_next\\\"] == 0x10008 and rets[2][\\\"rd_wdata\\\"] == 0xFFFFFFFF\n    assert rets[2][\\\"cycle\\\"] == rets[1][\\\"cycle\\\"] + 10\n    assert dmem == {0x80: 0}\n    assert [da for _, da, wen in bus if wen] == [0x80] * 26\n    assert sum(ia == 0x4C for ia, _, _ in bus) > 4\n\n\n@cocotb.test()\nasync def branch_counter_keeps_predicting_taken_after_one_fallthrough(dut):\n    program = [\n        ADDI(1, 0, 0x100),\n        ADDI(2, 0, 0x110),\n        LW(3, 1, 0),\n        ADDI(1, 1, 4),\n        BEQ(3, 0, 8),\n        ADDI(4, 4, 1),\n        BEQ(1, 2, 8),\n        JAL(0, -20),\n        EBREAK(),\n    ]\n    bus = []\n    rets, _ = await _run(\n        dut, program, {0x100: 0, 0x104: 0, 0x108: 1, 0x10C: 0},\n        bus_trace=bus,\n    )\n    assert [r[\\\"pc_next\\\"] for r in rets if r[\\\"pc\\\"] == 0x10] == [0x18, 0x18, 0x14, 0x18]\n    [fallthrough] = [r for r in rets if r[\\\"pc\\\"] == 0x14]\n    assert fallthrough[\\\"rd_wdata\\\"] == 1\n    fetches = [ia for ia, _, _ in bus]\n    assert [fetches[i+1] for i, pc in enumerate(fetches) if pc == 0x10] == [\n        0x14, 0x18, 0x18, 0x18,\n    ]\n\n\n''' + tag)\np.write_text(s)\nPY\npytest -q cores/bench/test/test_pipeline.py > cocotb_pipeline.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
