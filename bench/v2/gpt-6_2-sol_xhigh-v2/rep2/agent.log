{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom shutil import copytree\norig=Path.cwd()/'cores/bench/rtl'\nroot=Path('/srv/hwebench/tmp/4876824c/4ece65a7/bench-r9-protos-ks1k0g5j')\nfor variant in ('early_branch','early_branch_load'):\n p=root/variant; copytree(orig,p)\n f=p/'core.sv'\n s=f.read_text().replace('  logic       m_wait, ex_valid;', '  logic       m_wait, ex_valid;\\\\n  logic       early_load_consumer;\\\\n  logic [31:0] dmem_load_result;')\n s=s.replace('    .fwd_mem_wb ', '    .dmem_load_result     (dmem_load_result),\\\\n    .ex_mem_load          (io_dmemREn),\\\\n    .fwd_mem_wb ')\n s=s.replace('    .dmem_rdata (io_dmemRData),', '    .dmem_rdata (io_dmemRData),\\\\n    .load_result (dmem_load_result),')\n branch=\\\"if_id_w.instr[6:0] == 7'h63 && \"'!if_id_w.instr[14] && !if_id_w.instr[13]\"\n load=\"if_id_w.instr[6:0] == 7'\"'h03\\\"\n eligibility=f'({branch})' if variant=='early_branch' else f'({branch}) || ({load})'\n s=s.replace('  hazard_unit u_hazard (', f'  assign early_load_consumer = {eligibility};\\\\n  hazard_unit u_hazard (')\n s=s.replace('(id_ex_w.ctrl.mem_read),', '(id_ex_w.ctrl.mem_read && \"'!early_load_consumer),'\"')\n s=s.replace('(ex_mem_w.ctrl.reg_write),','(ex_mem_w.ctrl.reg_write && (\"'!ex_mem_w.ctrl.mem_read || io_dmemREn)),'\"')\n f.write_text(s)\n f=p/'mem_stage.sv'\n s=f.read_text().replace('  output logic        dmem_ren,', '  output logic        dmem_ren,\\\\n  output logic [31:0] load_result,')\n s=s.replace('  // ── MEM/WB register', '  assign load_result = load_data;\\\\n\\\\n  // ── MEM/WB register')\n f.write_text(s)\n f=p/'ex_stage.sv'\n s=f.read_text().replace('  input  logic [31:0]        fwd_mem_wb,', '  input  logic [31:0]        dmem_load_result,\\\\n  input  logic               ex_mem_load,\\\\n  input  logic [31:0]        fwd_mem_wb,')\n s=s.replace('  always_comb begin\\\\n    case (in.ctrl.branch_op)', '''  logic early_rs1, early_rs2, branch_equal;\n  assign early_rs1 = ex_mem_load && fwd_rs1_sel[2];\n  assign early_rs2 = ex_mem_load && fwd_rs2_sel[2];\n  assign branch_equal = early_rs1 || early_rs2\n                        ? ((early_rs1 && early_rs2) || dmem_load_result == (early_rs1 ? rs2 : rs1))\n                        : (rs1 == rs2);\n\n  always_comb begin\n    case (in.ctrl.branch_op)''')\n s=s.replace('(rs1 == rs2);\\\\n      BR_BNE:', 'branch_equal;\\\\n      BR_BNE:').replace('branch_cond = (rs1 \"'!= rs2);'\"','branch_cond = \"'!branch_equal;'\"')\n s=s.replace('? m_rs1_q : rs1;', '? m_rs1_q : (early_rs1 ? dmem_load_result : rs1);').replace('? m_rs2_q : rs2;', '? m_rs2_q : (early_rs2 ? dmem_load_result : rs2);')\n if variant=='early_branch_load':\n  s=s.replace('reg_q.eff_addr      <= rs1_plus_imm;', 'reg_q.eff_addr      <= (early_rs1 && in.ctrl.mem_read) ? dmem_load_result + in.imm : rs1_plus_imm;')\n f.write_text(s)\nPY\npython3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nwt=Path.cwd()\nroot=Path('/srv/hwebench/tmp/4876824c/4ece65a7/bench-r9-protos-ks1k0g5j')\nnames=('early_branch','early_branch_load')\nwith ThreadPoolExecutor(max_workers=4) as pool:\n futures={name:[pool.submit(build,wt,root/name,'fpga/core_bench_si.sv',opt,root/'reports'/name/str(opt)) for opt in (0,1)] for name in names}\n for name, fs in futures.items():\n  for job in fs:\n   run=job.result()\n   print(name, run['place_option'], run.get('fmax_mhz'),run.get('logic'),run.get('critical_paths',[])[:2], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
