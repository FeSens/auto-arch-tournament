{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c 'trial=\"$TMPDIR/bench-predictor.k3uYFP\"\ncat > \"$trial/retime.py\" <<'\"'PY'\nimport shutil\nimport sys\nfrom pathlib import Path\n\nroot = Path(sys.argv[1])\nbase = sys.argv[2]\nname = sys.argv[3]\nmode = sys.argv[4]\nout = root / name / 'rtl'\nshutil.copytree(root / base / 'rtl', out, dirs_exist_ok=True)\np = out / 'if_stage.sv'\ns = p.read_text()\ns = s.replace('*) predictor_entry_t entries', '*) logic [\"'$bits(predictor_entry_t)-1:0] entries'\"')\nif mode in ('index', 'onehot', 'norecoveryregister'):\n    s = s.replace('    logic [15:2]  target;', '    logic [15:2]  target;\\\\n    logic [INDEX_BITS-1:0] target_index;')\n    s = s.replace('  logic [INDEX_BITS-1:0] fetch_index, train_index, predictor_write_index;', '''  logic [INDEX_BITS-1:0] fetch_index_q, train_index, predictor_write_index;\n  logic [INDEX_BITS-1:0] predicted_index;''')\n    s = s.replace('  assign fetch_index = predictor_index(predictor_pc);\\\\n','')\n    s = s.replace('[fetch_index]', '[fetch_index_q]')\n    s = s.replace('  assign predicted_pc = target_pending_q ? increment_pc(recovery_pc_q) : normal_prediction;',\n                  '''  logic [31:2] recovery_fall_through;\n  assign recovery_fall_through = increment_pc(recovery_pc_q);\n  assign predicted_pc = target_pending_q ? recovery_fall_through : normal_prediction;\n  assign predicted_index = target_pending_q ? predictor_index(recovery_fall_through) :\n                           hit ? entry.target_index : predictor_index(fall_through);''')\n    s = s.replace('recovery_pc[15:2]};', 'recovery_pc[15:2], predictor_index(recovery_pc)};')\n    s = s.replace(\\\"      pc_q             <= '0;\\\", \\\"      pc_q             <= '0;\\\\n      fetch_index_q    <= '0;\\\")\n    s = s.replace('      if (fetch_accept)\\\\n        pc_q <= predicted_pc;', '      if (fetch_accept) begin\\\\n        pc_q <= predicted_pc;\\\\n        fetch_index_q <= predicted_index;\\\\n      end')\nif mode in ('onehot','norecoveryregister'):\n    s = s.replace('  logic [31:2] fall_through, normal_prediction;', '''  logic [31:2] fall_through;\n  logic use_target, use_fall_through;''')\n    s = s.replace('  assign normal_prediction = hit ? {predictor_pc[31:16], entry.target} : fall_through;\\\\n','')\n    s = s.replace('  assign predicted_pc = target_pending_q ? recovery_fall_through : normal_prediction;\\\\n  assign predicted_index = target_pending_q ? predictor_index(recovery_fall_through) :\\\\n                           hit ? entry.target_index : predictor_index(fall_through);',\n                  '''  assign use_target = \"'!target_pending_q && hit;\n  assign use_fall_through = !target_pending_q && !hit;\n  assign predicted_pc = ({30{use_target}} & {predictor_pc[31:16], entry.target}) |\n                        ({30{use_fall_through}} & fall_through) |\n                        ({30{target_pending_q}} & recovery_fall_through);\n  assign predicted_index = ({INDEX_BITS{use_target}} & entry.target_index) |\n                           ({INDEX_BITS{use_fall_through}} & predictor_index(fall_through)) |\n                           ({INDEX_BITS{target_pending_q}} & predictor_index(recovery_fall_through));'\"''')\nif mode == 'norecoveryregister':\n    s = s.replace('  logic [31:2] recovery_pc_q, train_pc_q;', '  logic [31:2] sequential_pc_q, target_pc_q, train_pc_q;')\n    s = s.replace('  assign recovery_pc = recovery_pc_q;\\\\n  assign fetch_pc = target_pending_q ? recovery_pc_q : pc_q;', '''  assign recovery_pc = take_target_q ? target_pc_q : sequential_pc_q;\n  assign fetch_pc = ({30{\"'!target_pending_q}} & pc_q) |\n                    ({30{target_pending_q && take_target_q}} & target_pc_q) |\n                    ({30{target_pending_q && !take_target_q}} & sequential_pc_q);'\"''')\n    s = s.replace('increment_pc(recovery_pc_q)', 'increment_pc(recovery_pc)')\n    s = s.replace('      recovery_pc_q   <= take_target ? target_pc : sequential_pc;', '      sequential_pc_q <= sequential_pc;\\\\n      target_pc_q     <= target_pc;')\np.write_text(s)\nPY\npython \\\"\"'$trial/retime.py\" \"$trial\" compact128 vector128 vector\npython \"$trial/retime.py\" \"$trial\" compact128 vector128-index index\npython \"$trial/retime.py\" \"$trial\" compact128 vector128-onehot onehot\npython \"$trial/retime.py\" \"$trial\" compact128-hot vector128-hot vector\ncat > \"$trial/time_trial.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nfrom tools.eval import gowin\ntrial=Path(sys.argv[1])/sys.argv[2]\nopts=gowin.build_all(Path.cwd(),trial/'rtl','fpga/core_bench_si.sv',trial/'timing',options=tuple(map(int, sys.argv[3:])))\nfor opt in opts:\n print({**opt,'critical_paths':opt.get('critical_paths',[])[:3]})\nif len(opts)==3:\n print(gowin.summarize(opts))\nPY\nls -ld \\\"\"'$trial\"/vector*'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
