{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"rg -n 'liveness|depth|cover|fair|ready' formal/checks_si.cfg formal/wrapper_si.sv && rg -n 'coremark|riscv|perf|stall' Makefile | head -n 60 && ls -la /srv/hwebench/tmp/4876824c/6cfe845a\"","aggregated_output":"formal/checks_si.cfg:6:[depth]\nformal/checks_si.cfg:7:# BMC depth per check. 2nd column (where present) is the k-induction prove\nformal/checks_si.cfg:8:# depth. Keep depths matched to the current pipeline so bugs within ~20\nformal/checks_si.cfg:16:# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\nformal/checks_si.cfg:18:# liveness — CPU makes forward progress under any symbolic stream\nformal/checks_si.cfg:20:cover      1    20\nformal/checks_si.cfg:22:liveness   1 10 20\nformal/checks_si.cfg:28:# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\nformal/checks_si.cfg:31:[cover]\nformal/checks_si.cfg:32:# Sanity cover: the CPU must retire at least one non-trapping instruction.\nformal/checks_si.cfg:33:always @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n42:  ORCH_FLAGS += --coremark-target $(COREMARK)\n80:\t@echo \"  make formal TARGET=v1   — riscv-formal fast suite (with ALTOPS)\"\n84:\t@echo \"  make bench              — build selftest + coremark ELFs\"\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n137:fpga: cosim-build bench/programs/coremark.elf\n143:bench/programs/coremark.elf: bench/programs/Makefile bench/programs/crt0.S \\\n144:                              $(wildcard bench/programs/coremark/*.c) \\\n145:                              $(wildcard bench/programs/coremark/*.h) \\\n146:                              $(wildcard bench/programs/coremark/baremetal/*.c) \\\n147:                              $(wildcard bench/programs/coremark/baremetal/*.h)\n148:\t$(MAKE) -f bench/programs/Makefile bench/programs/coremark.elf\n162:\t  [ -e \"$(WT_PATH)/formal/riscv-formal\" ] || ln -s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\ntotal 24\ndrwxrwx---+  7 nobody    nogroup   4096 Nov 20 18:00 .\ndrwxrwx---+  5 nobody    nogroup   4096 Nov 20 17:59 ..\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 20 18:00 .agents\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 20 18:00 .aws\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 20 18:00 .codex\ndr-xr-xr-x   2 hwebench2 hwebench2   40 Nov 20 18:00 .git\ndrwxrwx---+ 12 hwebench2 hwebench2 4096 Nov 20 18:00 codex-bwrap-synthetic-mount-targets-1002\n","exit_code":0,"status":"completed"}}
