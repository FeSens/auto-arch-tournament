_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n.gitignore:88:cores/*/experiments/hypotheses/\tcores/bench/experiments/hypotheses/hyp-20261120-001-r14s0.yaml\nFri Nov 20 17:04:39 UTC 2026\n","exit_code":0,"status":"completed"}}
