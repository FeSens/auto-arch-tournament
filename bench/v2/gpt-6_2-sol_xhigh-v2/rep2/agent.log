                        (wide_diff[i+1][32] || |wide_multiple[i+1][33:32]);\n  end\n  always_comb begin\n    wide_remainder = '\"'0;\n    wide_digit = '0;\n    for (int j = 0; j < 8; j++) begin\n      wide_remainder |= {32{wide_take[j]}} & wide_diff[j][31:0];\n      wide_digit |= {3{wide_take[j]}} & 3'(j);\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      dividend_quotient_q <= {narrow ? first_result[3:0] : magnitude_a[31:28], magnitude_a[27:0]};\n      first_remainder_q <= first_result[7:4];\n      byte_divisor_fits_q <= byte_divisor_fits;\n      divisor_q <= magnitude_b;\n      narrow_q <= narrow;\n      remainder_q <= want_remainder;\n      negate_q <= want_remainder ? negative_a : ((negative_a \"'^ negative_b) && b != 0);\n    end else if (phase_q == PREFIX) begin\n      small_remainder_q <= {4'\"'b0, prefix_remainder};\n      partial_remainder_q <= {18'b0, wide_prefix_remainder};\n      dividend_quotient_q <= narrow_q\n          ? {dividend_quotient_q[23:0], dividend_quotient_q[31:28], prefix_digit}\n          : {dividend_quotient_q[17:0], 12'b0, wide_prefix_digit};\n    end else if (phase_q > PREFIX && phase_q < DONE) begin\n      small_remainder_q <= next_remainder;\n      partial_remainder_q <= wide_remainder;\n      dividend_quotient_q <= narrow_q\n          ? {dividend_quotient_q[27:0], quotient_digit}\n          : {dividend_quotient_q[28:0], wide_digit};\n    end\n  end\n\n  assign magnitude_result = remainder_q\n            ? (narrow_q ? {20'b0, small_remainder_q} : partial_remainder_q)\n            : dividend_quotient_q;\n  assign result = negate_q ? -magnitude_result : magnitude_result;\n\"'`endif\n\nendmodule\n'\"'''\n# Wide trial multiples need 35 bits for 7*0xffffffff.\ns = s.replace('logic [33:0] wide_divisor,', 'logic [34:0] wide_divisor,')\ns = s.replace('logic [33:0] wide_multiple', 'logic [34:0] wide_multiple')\ns = s.replace('logic [7:0] wide_borrow;\\\\n  ', '').replace(\\\"  assign wide_borrow[7] = 1'b1;\\\