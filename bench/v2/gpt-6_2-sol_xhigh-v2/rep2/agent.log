{"type": "item.started", "item": {"id": "item_67", "type": "command_execution", "command": "/bin/bash -c 'proposal_scratch=/srv/hwebench/tmp/4876824c/052b005e/carry.uzFkhE\ncat > \"$proposal_scratch/late_issue.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nscratch=Path(__file__).parent\n\ndef variant(name, source, omit_head=False, narrowed=False):\n    old=scratch/source/'rtl'\n    rtl=scratch/name/'rtl'\n    if not rtl.exists():\n        shutil.copytree(old,rtl)\n    def edit(file, edits):\n        p=rtl/(file+'.sv')\n        v=(old/p.name).read_text()\n        for a,b in edits:\n            assert a in v,(file,a)\n            v=v.replace(a,b,1)\n        p.write_text(v)\n\n    edit('if_stage',[\n        ('  input  logic              decode_ready,', '''  input  logic              decode_ready,\n  input  logic              issue_stall,\n  input  logic              live_load, live_lw,\n  input  logic [4:0]        load_dest,\n  output logic              load_hazard,'''),\n        ('  assign pop   = \"'!empty && decode_ready;'\"', '  assign pop   = \"'!empty && !issue_stall && !queued_hazard;'\"'),\n        ('  assign late_classes = empty ? fetch_classes : queue_classes[read_ptr_q[1:0]];', '''  logic [1:0] queued_classes;\n  logic [31:0] queued_word;\n  logic queued_hazard, bus_hazard, replay_hazard;\n  assign queued_classes = queue_classes[read_ptr_q[1:0]];\n  assign queued_word = queue_words[read_ptr_q[1:0]];\n  assign late_classes = empty ? fetch_classes : queued_classes;\n  function automatic logic interlock(\n    input logic [31:0] word_data,\n    input logic [1:0] classes\n  );\n    logic word_compare, m1, m2;\n    m1 = word_data[19:15] == load_dest;\n    m2 = word_data[24:20] == load_dest;\n    word_compare = word_data[19:15] == 5'd0 || word_data[24:20] == 5'd0 || (m1 && m2);\n    return live_load && (m1 || m2) &&\n           \"'!(classes[0] && (!live_lw || word_compare)) &&\n           !(classes[1] && live_lw && m1);\n  endfunction\n  assign queued_hazard = interlock(queued_word, queued_classes);\n  assign bus_hazard = interlock(imem_data, classify(imem_data));\n  assign replay_hazard = interlock(read_entry_q.word, classify(read_entry_q.word));\n  assign load_hazard = empty ? (imem_ready ? bus_hazard : replay_hazard) : queued_hazard;'\"''')\n    ]+([\n        ('  logic [31:2] head_pc_q;', '  wire [31:2] head_pc_q = queue_pcs[read_ptr_q[1:0]];'),\n        ('''    if (empty || pop)\n      head_pc_q <= (empty || next_read_ptr == write_ptr_q) ? fetch_pc\n                                                          : queue_pcs[next_read_ptr[1:0]];\n''', '')\n    ] if omit_head else [\n        ('    if (empty || pop)', '    if (empty || \"'!issue_stall && !queued_hazard)'\"')\n    ]))\n    edit('core',[\n        ('  logic late_retry;', '  logic late_retry, load_hazard;') if 'unmasked_write' not in (old/'core.sv').read_text() else\n        ('logic late_retry, unmasked_write,', 'logic load_hazard, late_retry, unmasked_write,'),\n        ('    .decode_ready         (decode_ready),', '''    .decode_ready         (decode_ready),\n    .issue_stall          (stall_id),\n    .live_load            (ex_valid && id_ex_w.ctrl.mem_read && id_ex_w.rd \"'!= 5'\"'d0),\n    .live_lw              (id_ex_w.ctrl.mem_width == 2'd2),\n    .load_dest            (id_ex_w.rd),\n    .load_hazard          (load_hazard),'''),\n        ('''    .if_id_late_classes (late_classes),\n    .id_ex_is_lw    (id_ex_w.ctrl.mem_width == 2'd2),\n    .id_ex_mem_read (id_ex_w.ctrl.mem_read),\n    .id_ex_rd       (id_ex_w.rd),\n    .ex_valid       (ex_valid),\n    .if_id_rs1      (if_id_w.instr[19:15]),\n    .if_id_rs2      (if_id_w.instr[24:20]),''',\n         '    .load_use_hazard (load_hazard),')\n    ])\n    edit('hazard_unit',[\n        ('''  input  logic [1:0] if_id_late_classes,''','''  input  logic       load_use_hazard,'''),\n        ((old/'hazard_unit.sv').read_text().split('\\\\n  input  logic       id_ex_is_lw,')[1].split('  input  logic       m_wait')[0],\n         '\\\\n'),\n        ('  logic load_use_hazard;\\\\n',''),\n        ((old/'hazard_unit.sv').read_text().split('  logic dmem_stall;\\\\n')[1].split('  assign dmem_stall')[0],\n         '\\\\n'),\n    ])\n    if narrowed:\n        edit('ex_stage',[\n            ('  logic retry_q;', '  logic retry_q;'),\n            ('    if (retry_q) begin','    if (retry_q) begin')\n        ])\n\nvariant('late_issue','late_predicates_origq')\nvariant('late_issue_qram','late_predicates_origq',omit_head=True)\nvariant('late_issue_timing','late_timing')\nPY\npython3 \\\"\"'$proposal_scratch/late_issue.py\" && PYTHONPATH=\"$PWD\" python3 \"$proposal_scratch/trial.py\" late_issue late_issue_qram late_issue_timing'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
