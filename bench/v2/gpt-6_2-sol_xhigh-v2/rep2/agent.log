{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'scratch=/srv/hwebench/tmp/4876824c/d11de99c/pred-profile.W3B9vT\ncat > \"$scratch/effects.cc\" <<'\"'CPP'\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <string>\n#include <map>\nstruct T {uint32_t instr, pc, succ, rd, value, rs1, a, rs2, b, addr, rmask, data, wmask, trap, cycle;};\nstruct E {uint32_t key=~0U, v=0;};\nstruct S {unsigned hits[2]={},falses[2]={}, total[2]={};};\nunsigned h(uint32_t x,unsigned bits) {return (x\"'^(x>>bits)''^(x>>(bits*2)))&((1u<<bits)-1);}\nunsigned abs_addr(T r) {return r.addr+__builtin_ctz(r.rmask|16);}\nunsigned fu(T r) {return (r.instr>>12)&7;}\nunsigned val(T r,uint32_t raw) {unsigned shift=(abs_addr(r)&3)*8;switch(fu(r)) {case 0:return static_cast<int8_t>(raw>>shift); case 1:return static_cast<int16_t>(raw>>shift); case 4:return static_cast<uint8_t>(raw>>shift); case 5:return static_cast<uint16_t>(raw>>shift); default:return raw;}}\nint main(int argc,char** argv){\n FILE* f=fopen(argv[1],\"rb\");\n T r{},n{};\n if (!fread(&r,sizeof(r),1,f)) return 1;\n struct M{const char* name;unsigned bits;int keyMode;bool raw;bool tag;int idxMode; S s;std::array<E,1024> table;};\n M m[]={\n   {\"PC formatted\",7,0,false,false,0},\n   {\"Base formatted\",6,1,false,false,0},\n   {\"Base formatted\",7,1,false,false,0},\n   {\"Base formatted\",8,1,false,false,0},\n   {\"Base formatted\",9,1,false,false,0},\n   {\"Base+offset formatted\",6,2,false,false,0},\n   {\"Base+offset formatted\",7,2,false,false,0},\n   {\"Base+offset formatted\",8,2,false,false,0},\n   {\"Base+offset formatted\",9,2,false,false,0},\n   {\"Base+offset formatted (no high hash)\",7,2,false,false,1},\n   {\"Base+offset formatted (no high hash)\",8,2,false,false,1},\n   {\"Address formatted\",8,3,false,false,0},\n   {\"Address formatted\",9,3,false,false,0},\n   {\"Address raw\",6,4,true,false,0},\n   {\"Address raw\",7,4,true,false,0},\n   {\"Address raw\",8,4,true,false,0},\n   {\"Address raw\",9,4,true,false,0},\n   {\"Base+offset formatted tagged load\",7,2,false,true,0},\n   {\"Base+offset formatted tagged load\",8,2,false,true,0},\n   {\"Base+offset formatted tagged load\",9,2,false,true,0},\n };\n std::map<unsigned,std::array<unsigned,4>> stats;\n while(fread(&n,sizeof(n),1,f)) {\n    if ((r.instr & 127) == 3 && r.rmask && r.rd && !r.trap) {\n       bool branch = (n.instr&127)==0x63 && fu(n)<2 && (n.rs1==r.rd||n.rs2==r.rd);\n       bool load = (n.instr&127)==3 && n.rs1==r.rd && fu(r)==2;\n       for (auto& p:m) {\n          const unsigned base=r.a, a=abs_addr(r), off=(r.instr>>20);\n          uint32_t key, pure;\n          switch(p.keyMode){\n            case 0: key=r.pc>>2; pure=key; break;\n            case 1: key=base; pure=base>>2; break;\n            case 2: key=base ''^ ((off''^fu(r))*0x9e3779b9); pure=(base>>2)''^((off>>2) << 3)''^((off&3)<<1)''^(fu(r)<<2); break;\n            case 3: key=a''^(fu(r)<<20); pure=(a>>2)''^(fu(r)<<2); break;\n            default:key=a>>2; pure=key;\n          }\n          const unsigned idx=p.idxMode ? pure & ((1u<<p.bits)-1) : h(pure,p.bits);\n          E &e=p.table[idx];\n          if (branch || load) {\n             const unsigned k=branch?0:1;\n             ++p.s.total[k];\n             if (e.key != ~0U && (!p.tag || branch || e.key==key)) {\n                unsigned guess=p.raw?val(r,e.v):e.v;\n                bool same=branch?(((n.rs1==r.rd?guess:n.a)==(n.rs2==r.rd?guess:n.b))==(n.a==n.b)):guess==r.value;\n                ++(same?p.s.hits:p.s.falses)[k];\n             }\n          }\n          e={key,p.raw?r.data:r.value};\n       }\n       if (branch) {\n          auto& x=stats[r.pc]; ++x[0];\n          bool static_eq=n.instr&0x1000 ? n.succ==n.pc+4 : n.succ!=n.pc+4;\n          x[1]+=(n.a==n.b); x[2] += !!(n.rs1==0 || n.rs2==0);\n       }\n    }\n    r=n;\n }\n for (const auto&p:m) {\n    printf(\"%-38s %3u\",p.name,1u<<p.bits);\n    for (unsigned i=0;i<2;++i) printf(\"  %6u hit %6u miss /%u\",p.s.hits[i],p.s.falses[i],p.s.total[i]);\n    printf(\"  net %d'\"\\\\n\\\", int(p.s.hits[0]+p.s.hits[1])-int(p.s.falses[0]+p.s.falses[1]));\n }\n for(auto [pc,s]:stats) if(s[0]>1000) printf(\\\"%04x %u eq %u x0 %u\\\\n\\\",pc,s[0],s[1],s[2]);\n}\nCPP\ng++ -std=c++20 -O3 \\\"\"'$scratch/effects.cc\" -o \"$scratch/effects\" && \"$scratch/effects\" \"$scratch/trace.bin\"\ntail -c 1800 \"$scratch/trace.bin\" | strings | tail -5'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
