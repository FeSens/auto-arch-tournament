{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_div_unit.py && sed -n '1,300p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Check RV32M division arithmetic and the EX divider handshake.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut, result_ready=1):\n    dut.reset.value = 1\n    dut.request_valid.value = 0\n    dut.result_ready.value = result_ready\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _tick(dut)\n    dut.reset.value = 0\n\n\ndef _drive_request(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.request_valid.value = 1\n\n\nasync def _check_result(dut, op, a, b, expected):\n    assert dut.request_ready.value == 1\n    _drive_request(dut, op, a, b)\n    await _tick(dut)  # capture\n    dut.request_valid.value = 0\n\n    for _ in range(7):\n        assert dut.request_ready.value == 0\n        assert dut.result_valid.value == 0\n        await _tick(dut)\n\n    assert dut.request_ready.value == 0\n    assert dut.result_valid.value == 1\n    actual = int(dut.result.value)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_acceptance(dut):\n    await _tick(dut)  # result transfer, eight rising edges after capture if ready\n    assert dut.result_valid.value == 0\n    assert dut.request_ready.value == 1\n\n\n@cocotb.test()\nasync def division_vectors(dut):\n    await _setup(dut)\n    # Requests start in the first cycle available after the preceding transfer.\n    vectors = [\n        (ALU_DIV, 10, 3, 3),\n        (ALU_DIV, -4, 2, -2),\n        (ALU_DIV, 7, -2, -3),\n        (ALU_DIV, 123, 0, -1),\n        (ALU_DIV, 0, 0, -1),\n        (ALU_DIV, -123, 0, -1),\n        (ALU_DIV, -0x80000000, -1, -0x80000000),\n        (ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF),\n        (ALU_\n…[13076 of 16148 chars elided by tools/bench/transcript.py; sha256:6d0c1e4461eed010]…\nl(r[\"trap\"] == 0 for r in rets)\n    _, prior, multiply, divide, use, _ = rets\n    assert multiply[\"cycle\"] - prior[\"cycle\"] == 2\n    assert (multiply[\"rs1_rdata\"], multiply[\"rs2_rdata\"]) == (0xFFFFFFEF, 9)\n    assert (multiply[\"rd\"], multiply[\"rd_wdata\"]) == (3, 0xFFFFFF67)\n    assert divide[\"cycle\"] - multiply[\"cycle\"] == 9\n    assert (divide[\"rs1_rdata\"], divide[\"rs2_rdata\"]) == (0xFFFFFF67, 9)\n    assert (divide[\"rd\"], divide[\"rd_wdata\"]) == (4, 0xFFFFFFEF)\n    assert use[\"cycle\"] - divide[\"cycle\"] == 1\n    assert use[\"rd_wdata\"] == 0xFFFFFFF0\n\n\n@cocotb.test()\nasync def multiply_after_stalled_store(dut):\n    program = [\n        ADDI(2, 0, 7),\n        LW(1, 0, 0),\n        SW(2, 0, 4),\n        MUL(3, 1, 2),\n        SW(3, 0, 8),\n        EBREAK(),\n    ]\n    bus = []\n    rets, dmem = await _run(dut, program, {0: 100}, dmem_stalls={4: 4}, bus_trace=bus)\n\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert all(r[\"trap\"] == 0 for r in rets)\n", "exit_code": 0, "status": "completed"}}
