{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'for source in queue4-pc queue-head-pc; do\n  mkdir -p \"$TMPDIR/div-study/$source-retime\"\n  cp -r \"$TMPDIR/div-study/$source/rtl\" \"$TMPDIR/div-study/$source-retime/\"\ndone\npython - <<'\"'PY'\nimport os\nfrom pathlib import Path\nroot = Path(os.environ['TMPDIR']) / 'div-study'\nfor name in ('queue4-pc-retime','queue-head-pc-retime'):\n    rtl=root/name/'rtl'\n    p=rtl/'ex_stage.sv'\n    s=p.read_text().replace('  output logic [31:2]        resolved_pc','''  output logic [31:2]        alternative_pc,\n  output logic [31:2]        sequential_pc,\n  output logic               use_alternative''')\n    s=s.replace('  logic [31:0] pc_plus4, relative_target;', '  logic [31:0] pc_plus4, relative_target;\\\\n  logic [31:2] resolved_pc;')\n    s=s.replace('  // Compare the possible successors', '''  assign alternative_pc = in.ctrl.is_jalr ? rs1_plus_imm[31:2] : relative_target[31:2];\n  assign sequential_pc = pc_plus4[31:2];\n  assign use_alternative = \"'!use_sequential;\n\n  // Compare the possible successors'\"''')\n    p.write_text(s)\n    p=rtl/'if_stage.sv'\n    s=p.read_text().replace('  input  logic [31:2]       resolved_pc,', '''  input  logic [31:2]       alternative_pc,\n  input  logic [31:2]       sequential_pc,\n  input  logic              use_alternative,''')\n    s=s.replace('logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;', '''logic [31:2] pc_q, recovery_pc, fetch_pc, predicted_pc;\n  logic [31:2] recovery_alt_q, recovery_seq_q, train_pc_q;\n  logic recovery_use_alt_q, train_q;\n  assign recovery_pc = recovery_use_alt_q ? recovery_alt_q : recovery_seq_q;''')\n    s=s.replace('redirect_pending_q ? recovery_pc_q : pc_q', 'redirect_pending_q ? recovery_pc : pc_q')\n    s=s.replace('''    if (train)\n      entries[train_pc[7:2]] <= {train_pc[31:8], resolved_pc};\n\n    if (reset)\n      valid_q <= '0;\n    else if (train)\n      valid_q[train_pc[7:2]]