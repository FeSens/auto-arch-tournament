{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'probe=$(cat /srv/hwebench/tmp/4876824c/847ff794/predictor-path)\npython3 - \"$probe/cocotb-check/test/test_if_stage.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1])\ns=p.read_text()\ns=s.replace('dut, word=None, *, consume=True, redirect=None, training=None, reset=False,', 'dut, word=None, *, consume=True, redirect=None, training=None, reset=False, rejections=None,')\ns=s.replace('    dut.miss_target.value = redirect is not None\\\\n    dut.miss_sequential.value = redirect is not None', '''    if rejections is None:\n        rejections = (redirect is not None, redirect is not None)\n    dut.miss_target.value, dut.miss_sequential.value = rejections''')\ninsert='''\n@cocotb.test()\nasync def registered_direction_selects_a_single_rejection(dut):\n    await _reset_and_scrub(dut)\n    word = 0x13\n    # The selected candidate matches. The other candidate may disagree.\n    assert await _step(dut, word, training=(0, 0x80, False),\n                       rejections=(False, True)) == (0, 0, word)\n    assert await _step(dut, word, rejections=(True, False)) == (4, 4, word)\n    # A taken miss selects the registered aligned target and squashes EX.\n    assert await _step(dut, word, training=(8, 0x80, False),\n                       rejections=(True, False)) == (8, 8, word)\n    assert dut.recovering.value\n    assert await _step(dut) == (0x80, 0x80, None)\n    assert dut.recovering.value\n    # A blocked decode leaves the accepted correction at the head.\n    assert await _step(dut, word, consume=False) == (0x80, 0x80, word)\n    assert dut.recovering.value\n    assert await _step(dut) == (0x84, 0x80, word)\n    assert not dut.recovering.value\n    # The fall-through rejection can independently redirect, too.\n    assert await _step(dut, word, redirect=0xC,\n                       rejections=(False, True)) == (0x84, 0x84, word)\n    assert dut.recovering.value\n    assert await _step(dut, word) == (0xC, 0xC, word)\n    assert not dut.recovering.value\n\n'''\ns=s.replace('\\\\ndef test_if_stage_runner():', '\\\\n'+insert+'\\\\ndef test_if_stage_runner():')\np.write_text(s)\nPY\ncd \\\"\"'$probe/cocotb-check\"\npytest -q test/test_if_stage.py > \"$probe/reject-test.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
