{"type": "item.completed", "item": {"id": "item_113", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch with a tagged taken-target predictor, PC-indexed\n// instruction replay, and a four-entry fall-through queue. The oldest unissued PC is\n// visible even without a response.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              decode_ready,\n  input  logic              recovery_issue_ready,\n  input  logic              mispredict,\n  input  logic [31:2]       sequential_pc,\n  input  logic [31:2]       target_pc,\n  input  logic              take_target,\n  input  logic              train,\n  input  logic [31:2]       train_pc,\n  input  logic              train_branch,\n  output logic              recovering,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output logic              decode_valid,\n  output if_id_t            out\n);\n\n  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;\n  logic [31:2] fetch_plus4;\n  logic [6:0]  pc_index_q, predicted_index;\n  logic        target_pending_q;\n  logic [8:0]  scrub_index_q;\n\n  function automatic logic [6:0] pc_hash(input logic [15:2] pc);\n    pc_hash = pc[8:2] ^ pc[15:9];\n  endfunction\n\n  // Valid, conditional, source tag, page-local target word, target hash.\n  // The hash and source tag together distinguish all aligned source PCs.\n  (* syn_ramstyle = \"distributed_ram\" *) logic [45:0] targets [0:127];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] direction [0:127];\n  (* syn_ramstyle = \"distributed_ram\" *) logic taken_vote [0:127];\n  logic        valid, conditional, select_target;\n  logic [31:9] tag, train_tag_q;\n  logic [5:0]  tag_match;\n  logic [15:2] target_offset;\n  logic [6:0]  target_index, train_index_q, predictor_write_index;\n  logic        train_q, train_branch_q, train_taken_q, predictor_scrub_q;\n  logic        target_write, direction_write, same_page;\n  logic [45:0] target_write_data;\n  logic [1:0]  counter, counter_next;\n\n  assign fetch_pc = target_pending_q ? recovery_pc_q : pc_q;\n \n…[8024 of 11096 chars elided by tools/bench/transcript.py; sha256:c26db06502649b78]…\n     if (fetch_accept) begin\n        pc_q <= predicted_pc;\n        pc_index_q <= predicted_index;\n      end\n      // Fetch can continue as soon as the target response is buffered.\n      // EX remains squashed until decode issues that first instruction.\n      target_pending_q <= mispredict || (target_pending_q && !imem_ready);\n      // EX is squashed during recovery, so only a dmem hold blocks issue.\n      recovering <= mispredict || (recovering && !(recovery_issue_ready && (!empty || fetch_available)));\n    end\n\n    // Capture the resolved address independently of EX's comparison.\n    // Hold it while the corrected fetch waits, and use it as the staged\n    // target when an advancing control transfer was taken.\n    if (!target_pending_q)\n      recovery_pc_q <= take_target ? target_pc : sequential_pc;\n    train_tag_q    <= train_pc[31:9];\n    train_index_q  <= pc_hash(train_pc[15:2]);\n    train_branch_q <= train_branch;\n    train_taken_q  <= take_target;\n    train_q        <= !reset && train;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_112", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/mem_stage.sv'", "aggregated_output": "// rtl/mem_stage.sv\n//\n// Memory access stage. Drives the dmem read/write ports combinationally\n// from EX/MEM. Selects the ALU result, extended load, or low product\n// into the MEM/WB write-value register.\n//\n// Byte-lane discipline:\n//   - Write data is replicated across all four byte lanes; the\n//     byte-mask (mem_wmask) selects the actual destination bytes.\n//   - Load: shift the raw word right by `addr[1:0]*8`, then sign- or\n//     zero-extend the low 8/16 bits per the LB/LBU/LH/LHU encoding.\n//   - For RVFI ALIGNED_MEM, mem_addr is reported word-aligned and the\n//     byte position is captured in mem_rmask / mem_wmask.\n//\n// Latency:        1 cycle (MEM/WB register clocked here).\n// RVFI fields:    feeds mem_addr, mem_rmask, mem_wmask, mem_rdata,\n//                 mem_wdata, plus rd_wdata via the loaded-data path.\nmodule mem_stage (\n  input  logic               clock,\n  input  logic               reset,\n  // A dmem stall holds the write result, destination, and write enable\n  // for forwarding to the held ID/EX instruction. Clearing valid allows\n  // the producer to retire and write the regfile exactly once.\n  input  logic               hold_wb,\n  input  ex_mem_t  in,\n  input  logic [31:0]        low_mul_result,\n  // dmem interface\n  output logic [31:0]        dmem_addr,\n  output logic [31:0]        dmem_wdata,\n  input  logic [31:0]        dmem_rdata,\n  output logic [3:0]         dmem_wen,\n  output logic               dmem_ren,\n  // MEM/WB register output\n  output logic               next_reg_write,\n  output mem_wb_t  out\n);\n\n  logic [31:0] wdata_rep;\n  logic [3:0]  byte_mask;\n  logic [31:0] aligned_addr;\n  // shifted[31:16] is dropped on byte/halfword loads; only [15:0] feeds\n  // the sign/zero-extension mux.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [31:0] shifted;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [7:0]  byte_val;\n  logic [15:0] hword_val;\n  logic [31:0] load_data;\n\n  // Misaligned mem-access trap. RV32I requires word-aligned LW/SW and\n  // halfword-aligned LH/LHU/SH; byte ops are a\n…[2592 of 5664 chars elided by tools/bench/transcript.py; sha256:dd0f24f2ca3c538a]…\nwb) begin\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      // Low MUL supplies zero on the EX result bus.\n      reg_q.write_result <= ({32{!in.ctrl.mem_to_reg}} & in.alu_result) |\n                            ({32{in.ctrl.mem_to_reg}} & load_data) |\n                            ({32{in.low_mul}} & low_mul_result);\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= in.pc_next;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= dmem_rdata;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
