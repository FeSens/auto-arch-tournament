{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os\np = Path(os.environ['TMPDIR']) / 'div-study/lane-three/test/test_div_unit.py'\ns = p.read_text()\nat = s.index('\\\\ndef test_div_unit_runner()')\nsuite = '''\n@cocotb.test()\nasync def width_lane_boundaries(dut):\n    await _setup(dut)\n    for b in (253, 254, 255, 256, 257, 258, 16381, 16382, 16383, 16384, 16385, 16386):\n        for q in (0, 1, 7, 15, 31, 32, MASK32 // b):\n            for delta in (-1, 0, 1):\n                a = b * q + delta\n                if not 0 <= a <= MASK32:\n                    continue\n                await _check_unsigned_pair(dut, a, b)\n                if a > 0x7fffffff:\n                    continue\n                for signed_a, signed_b in ((-a, b), (a, -b), (-a, -b)):\n                    signed_q = abs(signed_a) // abs(signed_b)\n                    if (signed_a < 0) \"'!= (signed_b < 0):\n                        signed_q = -signed_q\n                    await _check_result(dut, ALU_DIV, signed_a, signed_b, signed_q)\n                    await _check_acceptance(dut)\n                    await _check_result(dut, ALU_REM, signed_a, signed_b,\n                                        signed_a - signed_q * signed_b)\n                    await _check_acceptance(dut)\n\n\n@cocotb.test()\nasync def hold_and_reset_each_lane(dut):\n    await _setup(dut, result_ready=0)\n    for b in (255, 256, 16384):\n        await _check_result(dut, ALU_DIVU, MASK32, b, MASK32 // b)\n        for _ in range(3):\n            _drive_request(dut, ALU_REMU, 123, 4)\n            await _tick(dut)\n            assert dut.result_valid.value == 1\n            assert dut.request_ready.value == 0\n            assert dut.result.value == MASK32 // b\n        dut.request_valid.value = 0\n        dut.result_ready.value = 1\n        await _check_acceptance(dut)\n        dut.result_ready.value = 0\n\n        _drive_request(dut, ALU_REMU, MASK32, b)\n        await _tick(dut)\n        dut.request_valid.value = 0\n        await _tick(dut)\n        await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(9):\n            assert dut.request_ready.value == 1\n            assert dut.result_valid.value == 0\n            await _tick(dut)\n'\"'''\np.write_text(s[:at] + suite + s[at:])\nPY\ncd \\\"\"'$TMPDIR/div-study/lane-three\" && pytest -q test/'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
