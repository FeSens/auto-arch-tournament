{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os\np=Path(os.environ['TMPDIR'])/'div-study/queue4-pc-retime/test/test_pipeline.py'\ns=p.read_text()\ns=s.replace('    dmem_stalls=None, imem_stalls=None, bus_trace=None, dmem_trace=None,',\n            '    dmem_stalls=None, imem_stalls=None, bus_trace=None, dmem_trace=None,\\\\n    shared_memory=False,')\ns=s.replace('        dut.io_imemData.value = read_imem(ia & ~3)', '''        aligned_pc = ia & ~3\n        dut.io_imemData.value = (\n            dmem[aligned_pc] if shared_memory and aligned_pc in dmem else read_imem(aligned_pc)\n        )''')\nix=s.index('\\\\ndef test_pipeline_runner()')\ntests='''\n@cocotb.test()\nasync def fetch_queue_drains_under_imem_stalls(dut):\n    instructions = [LW(1, 0, 64), ADDI(2, 1, 1)]\n    instructions.extend(ADDI(rd, 0, rd) for rd in range(3, 9))\n    instructions.append(EBREAK())\n    bus = []\n    rets, _ = await _run(dut, instructions, {64: 42}, dmem_stalls={64: 8},\n                         imem_stalls={20: 20}, bus_trace=bus)\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, 36, 4))\n    assert [r[\\\"order\\\"] for r in rets] == list(range(9))\n    assert rets[1][\\\"rd_wdata\\\"] == 43\n    assert [r[\\\"rd_wdata\\\"] for r in rets[2:8]] == list(range(3, 9))\n    assert all(bus[r[\\\"cycle\\\"]][0] == 20 for r in rets[1:5])\n    assert [r[\\\"cycle\\\"] for r in rets[1:5]] == list(range(rets[1][\\\"cycle\\\"], rets[1][\\\"cycle\\\"] + 4))\n\n\n@cocotb.test()\nasync def full_fetch_queue_pops_and_refills(dut):\n    instructions = [LW(1, 0, 64), ADDI(2, 1, 1)]\n    instructions.extend(ADDI(rd, 0, rd) for rd in range(3, 9))\n    instructions.append(EBREAK())\n    bus = []\n    rets, _ = await _run(dut, instructions, {64: 42}, dmem_stalls={64: 8}, bus_trace=bus)\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, 36, 4))\n    assert [r[\\\"order\\\"] for r in rets] == list(range(9))\n    assert rets[1][\\\"rd_wdata\\\"] == 43\n    assert [r[\\\"rd_wdata\\\"] for r in rets[2:8]] == list(range(3, 9))\n    assert [r[\\\"cycle\\\"] for r in rets] == list(range(rets[0][\\\"cycle\\\"], rets[0][\\\"cycle\\\"] + 9))\n    held = [i for i, (addr, _, _) in enumerate(bus) if addr == 20]\n    assert len(held) > 1\n    assert [a for a, _, _ in bus[held[-1]:held[-1]+3]] == [20, 24, 28]\n\n\n@cocotb.test()\nasync def fence_i_discards_prefetched_word(dut):\n    replacement = ADDI(7, 0, 42)\n    instructions = [LW(1, 0, 64), SW(1, 0, 12), 0x0000100F, ADDI(7, 0, 11), EBREAK()]\n    bus = []\n    requests = []\n    rets, mem = await _run(\n        dut, instructions, {64: replacement}, dmem_stalls={12: 7},\n        bus_trace=bus, dmem_trace=requests, shared_memory=True,\n    )\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 12, 16]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(5))\n    assert rets[2][\\\"trap\\\"] == 0\n    assert rets[3][\\\"insn\\\"] == replacement and rets[3][\\\"rd_wdata\\\"] == 42\n    assert mem[12] == replacement\n    blocked = [i for i, (pc, addr, wen) in enumerate(bus) if pc == 12 and addr == 12 and wen]\n    assert blocked and blocked[0] < rets[1][\\\"cycle\\\"]\n    assert [r for r in requests if r[2] and r[4]] == [(12, 0, 15, replacement, True)]\n'''\np.write_text(s[:ix] + tests + s[ix:])\nPY\ncd \\\"\"'$TMPDIR/div-study/queue4-pc-retime\" && pytest -q test/ > all-tests.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
