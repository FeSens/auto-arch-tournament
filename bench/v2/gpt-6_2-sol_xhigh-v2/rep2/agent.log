{"type": "item.completed", "item": {"id": "item_93", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch with a tagged taken-target predictor, PC-indexed\n// instruction replay, and a four-entry fall-through queue. The oldest unissued PC is\n// visible even without a response.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              decode_ready,\n  input  logic              recovery_issue_ready,\n  input  logic              reject_target,\n  input  logic              reject_sequential,\n  input  logic [31:2]       sequential_pc,\n  input  logic [31:2]       target_pc,\n  input  logic              take_target,\n  input  logic              train,\n  input  logic [31:2]       train_pc,\n  input  logic              train_branch,\n  input  logic              late_branch,\n  input  logic              check_branch,\n  input  logic              branch_on_inequality,\n  input  logic              branch_target_aligned,\n  input  logic              late_branch_equal,\n  input  logic              late_take_target,\n  input  logic              late_train,\n  input  logic              retry,\n  input  logic [31:0]       retry_instr,\n  input  logic              load_pending,\n  input  logic              load_word,\n  input  logic [4:0]        load_rd,\n  output logic              load_use_hazard,\n  output load_consumer_t    consumer,\n  output logic [31:0]       next_issue_pc,\n  output logic              recovering,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output logic              decode_valid,\n  output if_id_t            out\n);\n\n  logic [31:2] pc_q, sequential_pc_q, target_pc_q, retry_pc_q, fetch_pc, predicted_pc;\n  logic [31:2] fetch_plus4;\n  logic [6:0]  pc_index_q, predicted_index;\n  logic        reject_target_q, reject_sequential_q, take_target_q;\n  logic        late_target_eq_q, late_target_ne_q, late_sequential_eq_q, late_sequential_ne_q;\n  logic        equal_takes_target, unequal_takes_target;\n  logic        mispredict, redirect, correction_pending, recovery_wait_q;\n\n…[13268 of 16340 chars elided by tools/bench/transcript.py; sha256:c866672803c2f78a]…\n_target && !check_branch;\n      reject_sequential_q  <= reject_sequential && !check_branch;\n      late_target_eq_q     <= reject_target && check_branch && equal_takes_target;\n      late_target_ne_q     <= reject_target && check_branch && unequal_takes_target;\n      late_sequential_eq_q <= reject_sequential && check_branch && !equal_takes_target;\n      late_sequential_ne_q <= reject_sequential && check_branch && !unequal_takes_target;\n    end\n\n    // Capture both successors and the retry PC before the late verdict.\n    // Keep all three addresses if the first corrected bus word stalls.\n    if (!recovering) begin\n      sequential_pc_q <= sequential_pc;\n      target_pc_q     <= target_pc;\n      retry_pc_q      <= train_pc;\n    end\n    take_target_q        <= take_target;\n    train_tag_q          <= train_pc[31:9];\n    train_index_q        <= pc_hash(train_pc[15:2]);\n    train_replay_index_q <= train_pc[10:2];\n    train_branch_q       <= train_branch;\n    train_q              <= !reset && train;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
