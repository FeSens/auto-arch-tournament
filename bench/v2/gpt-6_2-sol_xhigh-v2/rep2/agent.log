{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'for source in queue4 queue-head; do\n  mkdir -p \"$TMPDIR/div-study/$source-pc\"\n  cp -r \"$TMPDIR/div-study/$source/rtl\" \"$TMPDIR/div-study/$source-pc/\"\ndone\npython - <<'\"'PY'\nfrom pathlib import Path\nimport os\nroot=Path(os.environ['TMPDIR'])/'div-study'\nbase=Path.cwd()/'cores/bench/rtl'\nfor design in ('queue4-pc','queue-head-pc'):\n    rtl=root/design/'rtl'\n    for name in ('core_pkg.sv','id_stage.sv'):\n        (rtl/name).write_text((base/name).read_text())\n    p=rtl/'if_stage.sv'\n    s=p.read_text().replace('logic [93:0] queue','logic [63:0] queue')\n    p.write_text(s.replace('  assign incoming.successor = predicted_pc;\\\\n',''))\n    p=rtl/'ex_stage.sv'\n    s=p.read_text().replace('  input  id_ex_t   in,','  input  logic [31:2]        fetch_pc,\\\\n  input  id_ex_t   in,')\n    p.write_text(s.replace('in.successor','fetch_pc'))\n    p=rtl/'core.sv'\n    s=p.read_text().replace('    .squash          (recovering),','    .squash          (recovering),\\\\n    .fetch_pc        (if_id_w.pc[31:2]),')\n    p.write_text(s)\nPY\npython -u - <<'PY'\nimport os\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build_all, summarize\nroot=Path(os.environ['TMPDIR'])/'div-study'\ndef run(design):\n    p=root/design\n    results=build_all(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',p/'timing')\n    print(design, summarize(results), flush=True)\n    for r in results:\n        print(design,r['place_option'],r.get('critical_paths',[None])[0], flush=True)\nwith ThreadPoolExecutor() as ex:\n    tuple(ex.map(run, ['queue4-pc','queue-head-pc']))\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c 'for design in queue4-pc queue-head-pc; do\n  RTL_DIR=\"$TMPDIR/div-study/$design/rtl\" OBJ_DIR=\"$TMPDIR/div-study/$design/obj_dir\" NRET=1 bash test/cosim/build.sh > \"$TMPDIR/div-study/$design/sim.log\" 2>&1 || exit\ndone\npython - <<'\"'PY'\nimport os\nfrom pathlib import Path\nfrom tools.eval.fpga import run_coremark_ipc\nroot = Path(os.environ['TMPDIR'])/'div-study'\nfor name in ('queue4-pc', 'queue-head-pc'):\n    print(name, run_coremark_ipc(str(root/'programs'),str(root/name/'obj_dir/cosim_sim')), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
