{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - '/srv/hwebench/tmp/4876824c/1d68acd7/bench-predictor.6uRI2e' <<'PY'\nimport concurrent.futures\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom tools.eval import cosim, fpga\n\nworktree = str(Path.cwd())\nprobe = Path(sys.argv[1])\nbench = probe/'bench/programs'\nsim = str(probe/'cores/bench/obj_dir/cosim_sim')\nwith concurrent.futures.ThreadPoolExecutor() as pool:\n    checks = [pool.submit(cosim.run_one, elf, sim, worktree, sim_flags=flags)\n              for elf in sorted(bench.glob('*.elf')) if elf.name \"'!= '\"'coremark.elf'\n              for flags in cosim.TRACE_STALL_MODES]\n    run = pool.submit(subprocess.run, [sim, str(bench/'coremark.elf'), '50000000', '--bench',\n                      '--istall', '--dstall'], capture_output=True, check=True, text=True)\n    for check in checks:\n        print(check.result(), flush=True)\n    marker = json.loads(run.result().stdout.strip().splitlines()[-1])\n    print(marker)\n    print(fpga.validate_coremark_uart(marker['uart'], fpga.parse_iterations(worktree)))\n    assert marker['ebreak'] and not marker['oob']\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
