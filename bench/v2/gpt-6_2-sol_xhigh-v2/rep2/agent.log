{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/4876824c/c3d24903/predictor-r4s2.LRNxlnua/directed.py <<'PY'\n\n@cocotb.test()\nasync def predictor_fifo_drains_during_imem_stall(dut):\n    program = [\n        ADDI(1, 0, 20),\n        ADDI(2, 0, 3),\n        DIV(3, 1, 2),\n        ADDI(4, 3, 1),\n        LW(5, 0, 0),\n        ADD(6, 4, 5),\n        SW(6, 0, 4),\n        EBREAK(),\n    ]\n    bus = []\n    rets, dmem = await _run(\n        dut, program, {0: 30}, imem_stalls={0x1C: 16}, bus_trace=bus,\n    )\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, 0x20, 4))\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert dmem == {0: 30, 4: 37}\n    assert [(ia, da, wen) for ia, da, wen in bus if wen] == [(0x1C, 4, 0xF)]\n\n\n@cocotb.test()\nasync def branch_recovery_discards_full_predictor_fifo(dut):\n    program = {\n        0x00: ADDI(1, 0, 5),\n        0x04: SW(1, 0, 0x40),\n        0x08: BEQ(0, 0, 0x18),\n        0x0C: SW(1, 0, 0x44),\n        0x10: SW(1, 0, 0x48),\n        0x14: SW(1, 0, 0x4C),\n        0x18: SW(1, 0, 0x50),\n        0x1C: SW(1, 0, 0x54),\n        0x20: SW(1, 0, 0x58),\n        0x24: EBREAK(),\n    }\n    bus = []\n    rets, dmem = await _run(\n        dut, lambda pc: program.get(pc, NOP()), dmem_stalls={0x40: 6},\n        imem_stalls={0x20: 3}, bus_trace=bus,\n    )\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 0x20, 0x24]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(5))\n    fetches = [ia for ia, _, _ in bus]\n    corrected = fetches.index(0x20)\n    assert fetches[:corrected].count(0x1C) >= 2\n    assert fetches[corrected:corrected+5] == [0x20]*4 + [0x24]\n    assert [da for _, da, wen in bus if wen] == [0x40]*7 + [0x58]\n    assert dmem == {0x40: 5, 0x58: 5}\n\n\n@cocotb.test()\nasync def trained_jump_fetches_target_while_divide_holds(dut):\n    program = {\n        0x00: ADDI(1, 0, 20),\n        0x04: ADDI(2, 0, 2),\n        0x08: ADDI(7, 0, 1),\n        0x0C: JAL(0, 0x24 - 0x0C),\n        0x20: DIV(3, 1, 2),\n        0x24: JAL(0, 0x40 - 0x24),\n        0x28: SW(1, 0, 0x40),\n        0x40: ADDI(7, 7, -1),\n        0x44: BEQ(7, 0, 0x4C - 0x44),\n        0x48: EBREAK(),\n        0x4C: JAL(0, 0x20 - 0x4C),\n    }\n    bus = []\n    rets, dmem = await _run(dut, lambda pc: program.get(pc, NOP()), bus_trace=bus)\n    pcs = [r[\\\"pc\\\"] for r in rets]\n    assert pcs == [0, 4, 8, 0x0C, 0x24, 0x40, 0x44, 0x4C, 0x20, 0x24, 0x40, 0x44, 0x48]\n    assert dmem == {}\n    fetches = [ia for ia, _, _ in bus]\n    div = pcs.index(0x20)\n    # The predicted second visit to 0x40 is already in flight well before DIV retires.\n    resumed = fetches.index(0x24, fetches.index(0x20)+1)\n    assert fetches[resumed+1] == 0x40\n    assert resumed+1 < rets[div][\\\"cycle\\\"] - 4\nPY\ntail -n 34 /srv/hwebench/tmp/4876824c/c3d24903/predictor-r4s2.LRNxlnua/headtrain4w/cocotb.log\ndate -u\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
