{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r13-lane-groups.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp,gettempdir\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all\n\nsrc = Path('cores/bench/rtl')\nterms = {'integer': '({32{is_alu_result}} & alu_result)', 'link': '({32{in.ctrl.is_jump}} & pc_plus4)',\n         'auipc': '({32{in.ctrl.is_auipc}} & relative_target)', 'mul': '({32{is_mul}} & mul_result)',\n         'div': '({32{is_div}} & div_result)'}\nconfigs = {\n   'int_pc_m': [['integer'], ['link','auipc'], ['mul','div']],\n   'int_nondiv_div': [['integer'], ['link','auipc','mul'], ['div']],\n   'nondiv_div': [['integer','link','auipc','mul'], ['div']],\n   'integer_mux': [['integer'], ['link','auipc','mul','div']],\n   'intmul_pcd': [['integer','mul'], ['link','auipc','div']],\n   'intlink_apcm': [['integer','link'], ['auipc','mul','div']],\n}\n\ndef setup(rtl, variant):\n    groups=configs[variant]\n    fields=['alu_result', *[f'result_group{n}' for n in range(1,len(groups))]]\n    for p in rtl.glob('*.sv'):\n        t=p.read_text()\n        if p.name=='core_pkg.sv':\n            t=t.replace('logic [31:0] alu_result;', '\\\\n    '.join(f'logic [31:0] {f};' for f in fields))\n        if p.name=='ex_stage.sv':\n            t=t.replace('  input  logic [31:0]        fwd_ex_mem,',''.join(f'  input  logic [31:0]        fwd_{f},\\\\n' for f in fields[1:])+'  input  logic [31:0]        fwd_ex_mem,')\n            for lhs in ('fwd_rs1_sel[2]','fwd_rs2_sel[2]','\"'!in.ctrl.alu_src && fwd_rs2_sel[2]'\"'):\n                term=f'({{32{{{lhs}}}}} & fwd_ex_mem) |'\n                if variant=='integer_mux':\n                    repl=f'({{32{{{lhs}}}}} & (fwd_ex_mem | fwd_{fields[1]})) |'\n                else:\n                    repl=term+''.join(f'\\\\n               ({{32{{{lhs}}}}} & fwd_{f}) |' for f in fields[1:])\n                t=t.replace(term,repl)\n            i=t.index('      reg_q.alu_result')\n            j=t.index('      reg_q.eff_addr',i)\n            t=t[:i]+''.join(f'      reg_q.{f} <= ' + ' |\\\\n                             '.join(terms[k] for k in g)+';\\\\n' for f,g in zip(fields,groups))+t[j:]\n        if p.name=='core.sv':\n            term='    .fwd_ex_mem           (ex_mem_w.alu_result),'\n            t=t.replace(term,term+'\\\\n'+''.join(f'    .fwd_{f:<21} (ex_mem_w.{f}),\\\\n' for f in fields[1:]).rstrip())\n        if p.name=='mem_stage.sv':\n            if variant == 'integer_mux':\n                t=t.replace('in.ctrl.mem_to_reg ? load_data : in.alu_result;', '({32{in.ctrl.mem_to_reg}} & load_data) | ({32{\"'!in.ctrl.mem_to_reg}} & in.alu_result) | ({32{!in.ctrl.mem_to_reg}} & in.result_group1);'\"')\n            else:\n                t=t.replace('load_data : in.alu_result;', 'load_data : ('+' | '.join(f'in.{f}' for f in fields)+');')\n        if t\"'!=p.read_text(): p.write_text(t)\n\n\ndef test(variant):\n    base=Path(mkdtemp(prefix=f'\"'bench-r13-group-{variant}-'))\n    print(variant,base,flush=True)\n    rtl=base/'rtl'; copytree(src,rtl); setup(rtl,variant)\n    res=build_all(Path.cwd(),rtl,'fpga/core_bench_si.sv',base,options=(1,2))\n    for r in res:\n        print(variant,r['place_option'],r['fmax_mhz'],r.get('logic'),r.get('critical_paths',[])[:2],r.get('reason'),flush=True)\n\nwith ThreadPoolExecutor() as pool:\n    jobs=[pool.submit(test,v) for v in configs]\n    for j in jobs:\n        j.result()\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 -u \"$TMPDIR/bench-r13-lane-groups.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r13-shifts.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp,gettempdir\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all\n\nsrc=next(Path(gettempdir()).glob('bench-r13-register_integer_lane-*'))/'rtl'\n\ndef setup(rtl, variant):\n    p=rtl/'alu.sv'; t=p.read_text()\n    if variant in ('both_right','reverse'):\n        code='''  logic signed [32:0] right_arg;\n  logic [32:0] shifted_right;\n  assign right_arg = \"'$signed({a[31] && op == ALU_SRA, a});\n  assign shifted_right = $unsigned(right_arg >>> shamt);\n'\"'''\n        t=t.replace('  always_comb begin',code+'\\\\n  always_comb begin')\n        t=t.replace('      ALU_SRL:    out = a >> shamt;\\\\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);'\"','      ALU_SRL, ALU_SRA: out = shifted_right[31:0];')\n        if variant=='reverse':\n            t=t.replace('  logic signed [32:0] right_arg;', '  logic [31:0] reversed, shifted_left;\\\\n  logic signed [32:0] right_arg;')\n            t=t.replace('  assign right_arg = \"'$signed({a[31] && op == ALU_SRA, a});'\"', '''  for (genvar i = 0; i < 32; i++) begin : gen_reverse\n    assign reversed[i] = a[31-i];\n    assign shifted_left[i] = shifted_right[31-i];\n  end\n  assign right_arg = \"'$signed({a[31] && op == ALU_SRA, (op == ALU_SLL) ? reversed : a});'\"''')\n            t=t.replace('out = a << shamt;', 'out = shifted_left;')\n    else:\n        code='''  function automatic logic [31:0] shift_right(\n    input logic [31:0] operand,\n    input logic [4:0] amt,\n    input logic fill\n  );\n    logic signed [32:0] data;\n    logic signed [32:0] groups [0:1];\n    data = \"'$signed({fill, operand});\n    groups[0] = '\"'0;\n    groups[1] = '0;\n    for (int stage_amt = 0; stage_amt < 4; stage_amt++) begin\n      groups[0] |= \"'$signed({33{amt[1:0] == 2'\"'(stage_amt)}}) & (data >>> stage_amt);\n    end\n    for (int stage_amt = 0; stage_amt < 4; stage_amt++) begin\n      groups[1] |= \"'$signed({33{amt[3:2] == 2'\"'(stage_amt)}}) & (groups[0] >>> (4*stage_amt));\n    end\n    shift_right = amt[4] ? 32'(groups[1] >>> 16) : groups[1][31:0];\n  endfunction\n\n  function automatic logic [31:0] reverse_bits(input logic [31:0] x);\n    for(int bit_index = 0; bit_index < 32; bit_index++)\n      reverse_bits[bit_index] = x[31-bit_index];\n  endfunction\n'''\n        t=t.replace('  always_comb begin',code+'\\\\n  always_comb begin')\n        t=t.replace('out = a >> shamt;', \\\"out = shift_right(a, shamt, 1'b0);\\\")\n        t=t.replace('out = \"'$unsigned($signed(a) >>> shamt);'\"', 'out = shift_right(a, shamt, a[31]);')\n        t=t.replace('out = a << shamt;', \\\"out = reverse_bits(shift_right(reverse_bits(a), shamt, 1'b0));\\\")\n    p.write_text(t)\n\n\ndef test(variant):\n    base=Path(mkdtemp(prefix=f'bench-r13-shift-{variant}-'))\n    print(variant,base,flush=True)\n    rtl=base/'rtl'; copytree(src,rtl); setup(rtl,variant)\n    res=build_all(Path.cwd(),rtl,'fpga/core_bench_si.sv',base,options=(1,2))\n    for r in res:\n        print(variant,r['place_option'],r['fmax_mhz'],r.get('logic'),r.get('critical_paths',[])[:2],r.get('reason'),flush=True)\n\nwith ThreadPoolExecutor() as pool:\n    jobs=[pool.submit(test,v) for v in ('both_right','reverse','radix4')]\n    for j in jobs:\n        j.result()\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 -u \"$TMPDIR/bench-r13-shifts.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r13-zero.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp,gettempdir\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all\n\nsplit_src=next(Path(gettempdir()).glob('bench-r13-register_integer_lane-*'))/'rtl'\n\ndef test(variant):\n    base=Path(mkdtemp(prefix=f'bench-r13-zero-{variant}-'))\n    print(variant,base,flush=True)\n    rtl=base/'rtl'\n    copytree(split_src if 'split' in variant else 'cores/bench/rtl', rtl)\n    p=rtl/'id_stage.sv'; t=p.read_text()\n    if 'reg' in variant:\n        t=t.replace('ctrl_decoded.alu_op     = dec_alu_op;', \\\"ctrl_decoded.alu_op     = (dec_is_jump || dec_is_auipc) ? 5'd31 : dec_alu_op;\\\")\n    else:\n        p=rtl/'ex_stage.sv'; t=p.read_text()\n        t=t.replace('.op  (in.ctrl.alu_op),', \\\".op  ((in.ctrl.is_jump || in.ctrl.is_auipc) ? 5'd31 : in.ctrl.alu_op),\\\")\n    p.write_text(t)\n    p=rtl/'ex_stage.sv'; t=p.read_text()\n    t=t.replace('logic        is_alu_result, m_active;', 'logic        m_active;').replace('  assign is_alu_result = \"'!(is_mul || is_div || in.ctrl.is_jump || in.ctrl.is_auipc);'\"\\\\n','')\n    t=t.replace('({32{is_alu_result}} & alu_result)', 'alu_result').replace('{32{is_alu_result}} & alu_result','alu_result')\n    p.write_text(t)\n    res=build_all(Path.cwd(),rtl,'fpga/core_bench_si.sv',base,options=(1,2))\n    for r in res:\n        print(variant,r['place_option'],r['fmax_mhz'],r.get('logic'),r.get('critical_paths',[])[:2],r.get('reason'),flush=True)\n\nwith ThreadPoolExecutor() as pool:\n    jobs=[pool.submit(test,v) for v in ('reg_orig','comb_orig','reg_split','comb_split')]\n    for j in jobs:\n        j.result()\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 -u \"$TMPDIR/bench-r13-zero.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
