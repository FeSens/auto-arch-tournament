{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all, summarize\n\ndef early_b(rtl):\n    p = rtl / 'core_pkg.sv'\n    t = p.read_text().replace('logic [31:0] rs2_val;\\\\n    logic [31:0] imm;', 'logic [31:0] rs2_val;\\\\n    logic [31:0] alu_b_base;\\\\n    logic [31:0] imm;')\n    p.write_text(t)\n    p = rtl / 'id_stage.sv'\n    t = p.read_text().replace('reg_q.rs2_val  <= rs2_data;', 'reg_q.rs2_val  <= rs2_data;\\\\n      reg_q.alu_b_base <= dec_alu_src ? imm : rs2_data;')\n    p.write_text(t)\n    p = rtl / 'ex_stage.sv'\n    t = p.read_text().replace('({32{\"'!in.ctrl.alu_src && fwd_rs2_sel[0]}} & in.rs2_val) |'\"\\\\n                 ({32{in.ctrl.alu_src}} & in.imm);', '({32{in.ctrl.alu_src || fwd_rs2_sel[0]}} & in.alu_b_base);')\n    p.write_text(t)\n\ndef register_integer_lane(rtl):\n    p = rtl / 'core_pkg.sv'\n    t = p.read_text().replace('logic [31:0] alu_result;', 'logic [31:0] alu_result;\\\\n    logic [31:0] integer_result;')\n    p.write_text(t)\n    p = rtl / 'ex_stage.sv'\n    t = p.read_text().replace('input  logic [31:0]        fwd_ex_mem,', 'input  logic [31:0]        fwd_integer,\\\\n  input  logic [31:0]        fwd_ex_mem,').replace(' & fwd_ex_mem)', ' & fwd_ex_mem)').replace('assign rs1 = ({32{fwd_rs1_sel[2]}} & fwd_ex_mem) |', 'assign rs1 = ({32{fwd_rs1_sel[2]}} & fwd_ex_mem) |\\\\n               ({32{fwd_rs1_sel[2]}} & fwd_integer) |').replace('assign rs2 = ({32{fwd_rs2_sel[2]}} & fwd_ex_mem) |', 'assign rs2 = ({32{fwd_rs2_sel[2]}} & fwd_ex_mem) |\\\\n               ({32{fwd_rs2_sel[2]}} & fwd_integer) |').replace('assign alu_b = ({32{\"'!in.ctrl.alu_src && fwd_rs2_sel[2]}} & fwd_ex_mem) |'\"', 'assign alu_b = ({32{\"'!in.ctrl.alu_src && fwd_rs2_sel[2]}} & fwd_ex_mem) |'\"\\\\n                 ({32{\"'!in.ctrl.alu_src && fwd_rs2_sel[2]}} & fwd_integer) |'\"').replace('reg_q.alu_result    <= ({32{is_alu_result}} & alu_result) |\\\\n                             ({32{in.ctrl.is_jump}} & pc_plus4) |', 'reg_q.integer_result <= {32{is_alu_result}} & alu_result;\\\\n      reg_q.alu_result    <= ({32{in.ctrl.is_jump}} & pc_plus4) |')\n    p.write_text(t)\n    p = rtl / 'core.sv'\n    t = p.read_text().replace('    .fwd_ex_mem           (ex_mem_w.alu_result),', '    .fwd_integer          (ex_mem_w.integer_result),\\\\n    .fwd_ex_mem           (ex_mem_w.alu_result),')\n    p.write_text(t)\n    p = rtl / 'mem_stage.sv'\n    t = p.read_text().replace('load_data : in.alu_result;', 'load_data : (in.alu_result | in.integer_result);')\n    p.write_text(t)\n\ndef test(change):\n    base = Path(mkdtemp(prefix=f'bench-r13-{change.__name__}-'))\n    print(base, flush=True)\n    rtl = base / 'rtl'\n    copytree('cores/bench/rtl', rtl)\n    change(rtl)\n    res = build_all(Path.cwd(), rtl, 'fpga/core_bench_si.sv', base, options=(0,1))\n    print(change.__name__, summarize(res), flush=True)\n    for r in res:\n        print(change.__name__, r['place_option'], r.get('critical_paths', [])[:3], flush=True)\n\nwith ThreadPoolExecutor() as pool:\n    jobs = [pool.submit(test, change) for change in (early_b, register_integer_lane)]\n    for job in jobs:\n        job.result()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
