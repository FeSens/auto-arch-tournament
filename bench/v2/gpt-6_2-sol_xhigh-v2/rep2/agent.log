{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c \"cat >'/srv/hwebench/tmp/4876824c/9d444955/r7-loop-research/fast_prototype.py' <<'PY'\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parent\nmode = sys.argv[1]\nrtl_dir = root / ('fast_' + mode)\nrtl_dir.mkdir(exist_ok=True)\nfor path in (root / 'cores/bench/rtl').glob('*.sv'):\n    (rtl_dir/path.name).write_bytes(path.read_bytes())\nrtl_path = rtl_dir / 'if_stage.sv'\nrtl = subprocess.check_output(['git', 'show', 'HEAD:cores/bench/rtl/if_stage.sv'], text=True)\nrtl = rtl.replace('logic        hit;', '''\n  logic        hit;\n\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] loop_words [0:15];\n  logic [31:2] capture_next_q;\n  logic [31:6] capture_previous_block_q;\n  logic [3:0] capture_count_q;\n  logic [31:2] loop_start_q, replay_pc_q, replay_pc_plus1;\n  logic [3:0] loop_end_q, capture_distance;\n  logic same_block, adjacent_block, continues_capture, loop_enter;\n  logic replay_q, external_accept, replay_accept;\n  logic [31:2] sequential_fetch_pc;\n  logic [31:0] replay_word;\n\n  assign sequential_fetch_pc  = fetch_pc + 30'd1;\n  assign continues_capture = fetch_pc == capture_next_q && fetch_pc \"'!= 0;\n  assign capture_distance = fetch_pc[5:2] - successor[5:2];\n  assign same_block = successor[31:6] == fetch_pc[31:6] && successor[5:2] < fetch_pc[5:2];\n  assign adjacent_block = successor[31:6] == capture_previous_block_q &&\n                          successor[5:2] > fetch_pc[5:2];\n  assign loop_enter = external_accept && hit && continues_capture && (same_block || adjacent_block) &&\n                      capture_distance <= capture_count_q ENTER_MOD;\n  assign replay_word = loop_words[(replay_q ? replay_pc_q[5:2] : fetch_pc[5:2])];\n  assign replay_pc_plus1 = replay_pc_q + 30'\"'d1;\n\n  always_ff @(posedge clock) begin\n    if (external_accept) begin\n      loop_words[fetch_pc[5:2]] <= imem_data;\n      capture_next_q <= sequential_fetch_pc;\n      capture_previous_block_q <= fetch_pc[31:6] - 26'd1;\n      loop_start_q <= successor;\n      loop_end_q   <= fetch_pc[5:2];\n      replay_pc_q <= successor;\n    end else if (replay_accept) begin\n      replay_pc_q <= replay_pc_q[5:2] == loop_end_q ? loop_start_q : replay_pc_plus1;\n    end\n\n    if (reset || mispredict) begin\n      replay_q <= 1'b0;\n      capture_count_q <= '0;\n    end else if (external_accept) begin\n      if (loop_enter)\n        replay_q <= 1'b1;\n      if (\"'!continues_capture)\n        capture_count_q <= 4'\"'d1;\n      else if (capture_count_q \"'!= 4'\"'hf)\n        capture_count_q <= capture_count_q + 4'd1;\n    end\n  end'''.replace('ENTER_MOD', '&& push' if mode == 'fifo' else ''))\n# Derive the upper block immediately preceding capture_next rather than\n# preceding fetch_pc, since fetch_pc may be first word of the new block.\nrtl = rtl.replace(\\\"capture_previous_block_q <= fetch_pc[31:6] - 26'd1;\\\",\n                  \\\"capture_previous_block_q <= (&fetch_pc[5:2]) ? fetch_pc[31:6] : fetch_pc[31:6] - 26'd1;\\\")\nrtl = rtl.replace(\\\"assign predicted_pc = hit ? successor : fetch_pc + 30'd1;\\\",\n                  \\\"assign predicted_pc = hit ? successor : sequential_fetch_pc;\\\")\nrtl = rtl.replace('assign fetch_accept = imem_ready && (\"'!full || pop);'\"', '''\n  assign external_accept = \"'!replay_q && imem_ready && (!full || pop);\n  assign replay_accept = replay_q && (!full || pop);\n  assign fetch_accept = external_accept || replay_accept;'\"''')\nrtl = rtl.replace('assign decode_valid = \"'!empty || imem_ready;'\"',\n                  'assign decode_valid = \"'!empty || (!replay_q && imem_ready);'\"'\n                  if mode == 'fifo' else 'assign decode_valid = \"'!empty || replay_q || imem_ready;'\"')\nfifo_data = \\\"replay_q ? {replay_pc_q, 2'b00, replay_word} : {imem_addr, imem_data}\\\"\nrtl = rtl.replace('{imem_addr, imem_data} : queue', f'({fifo_data}) : queue' if mode == 'bypass' else '{imem_addr, imem_data} : queue')\nrtl = rtl.replace('queue[write_ptr_q[1:0]] <= {imem_addr, imem_data};',\n                  'queue[write_ptr_q[1:0]] <= ' + fifo_data + ';')\nrtl = rtl.replace('if (fetch_accept)\\\\n        pc_q', 'if (external_accept)\\\\n        pc_q')\nrtl_path.write_text(rtl)\nPY\npython3 '/srv/hwebench/tmp/4876824c/9d444955/r7-loop-research/fast_prototype.py' fifo && python3 '/srv/hwebench/tmp/4876824c/9d444955/r7-loop-research/fast_prototype.py' bypass\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
