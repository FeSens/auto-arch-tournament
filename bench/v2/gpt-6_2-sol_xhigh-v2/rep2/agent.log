{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r13-mul.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp,gettempdir\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all\n\n\ndef edit(rtl, name, before, after):\n    path = rtl/name\n    t = path.read_text()\n    assert before in t, (name, before)\n    path.write_text(t.replace(before, after,1))\n\n\ndef setup(rtl, split):\n    edit(rtl,'core_pkg.sv','logic [31:0] alu_result;', 'logic [31:0] alu_result;\\\\n    logic        low_mul;')\n    edit(rtl,'mul_unit.sv','module mul_unit (', 'module mul_unit #(parameter bit PIPE_LOW = 1\\\\'b0) (')\n    edit(rtl,'mul_unit.sv','      phase_q <= PRODUCTS;', \\\"      phase_q <= (PIPE_LOW && op == ALU_MUL) ? IDLE : PRODUCTS;\\\")\n    edit(rtl,'ex_stage.sv','  output logic               m_wait,', '  output logic [31:0]        mem_mul_result,\\\\n  output logic               m_wait,')\n    edit(rtl,'ex_stage.sv','  logic        is_div,', '  logic        is_low_mul;\\\\n  logic        is_div,')\n    edit(rtl,'ex_stage.sv','  assign is_div =', '  assign is_low_mul = in.ctrl.alu_op == ALU_MUL;\\\\n  assign mem_mul_result = mul_result;\\\\n  assign is_div =')\n    edit(rtl,'ex_stage.sv','((is_mul && \"'!mul_result_valid)'\"', '((is_mul && \"'!is_low_mul && !mul_result_valid)'\"')\n    edit(rtl,'ex_stage.sv','  mul_unit u_mul (', \\\"  mul_unit #(.PIPE_LOW(1'b1)) u_mul (\\\")\n    edit(rtl,'ex_stage.sv','({32{is_mul}} & mul_result)', '({32{is_mul && \"'!is_low_mul}} & mul_result)'\"')\n    edit(rtl,'ex_stage.sv','      reg_q.eff_addr', '      reg_q.low_mul       <= is_low_mul;\\\\n      reg_q.eff_addr')\n    edit(rtl,'ex_stage.sv','(is_mul || is_div) ? m_rs1_q', '((is_mul && \"'!is_low_mul) || is_div) ? m_rs1_q'\"')\n    edit(rtl,'ex_stage.sv','(is_mul || is_div) ? m_rs2_q', '((is_mul && \"'!is_low_mul) || is_div) ? m_rs2_q'\"')\n    edit(rtl,'core.sv','  logic       m_wait, ex_valid;', '  logic       m_wait, ex_valid;\\\\n  logic [31:0] mem_mul_result;')\n    edit(rtl,'core.sv','    .m_wait               (m_wait),', '    .mem_mul_result       (mem_mul_result),\\\\n    .m_wait               (m_wait),')\n    edit(rtl,'core.sv','    .hold_wb    (hold_mem_wb),','    .hold_wb    (hold_mem_wb),\\\\n    .mul_result (mem_mul_result),')\n    edit(rtl,'core.sv','(id_ex_w.ctrl.mem_read),','(id_ex_w.ctrl.mem_read || id_ex_w.ctrl.alu_op == ALU_MUL),')\n    edit(rtl,'mem_stage.sv','  input  logic               hold_wb,', '  input  logic               hold_wb,\\\\n  input  logic [31:0]        mul_result,')\n    alu = '(in.alu_result | in.integer_result)' if split else 'in.alu_result'\n    edit(rtl,'mem_stage.sv',f'in.ctrl.mem_to_reg ? load_data : {alu};', f'''({{32{{in.ctrl.mem_to_reg}}}} & load_data) |\n                            ({{32{{in.low_mul}}}} & mul_result) |\n                            ({{32{{\"'!in.ctrl.mem_to_reg && !in.low_mul}}}} & {alu});'\"''')\n\n\ndef test(split):\n    base=Path(mkdtemp(prefix=f'bench-r13-mul-{split}-'))\n    print(split,base,flush=True)\n    rtl=base/'rtl'\n    if split:\n        src=next(Path(gettempdir()).glob('bench-r13-register_integer_lane-*'))/'rtl'\n    else:\n        src=Path('cores/bench/rtl')\n    copytree(src,rtl)\n    setup(rtl,split)\n    res=build_all(Path.cwd(),rtl,'fpga/core_bench_si.sv',base)\n    for r in res:\n        print(split,r['place_option'],r['fmax_mhz'],r.get('logic'),r.get('critical_paths',[])[:3],r.get('reason'),flush=True)\n\nwith ThreadPoolExecutor() as e:\n    jobs=[e.submit(test,split) for split in (False,True)]\n    for j in jobs:\n        j.result()\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 -u \"$TMPDIR/bench-r13-mul.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.fpga import validate_coremark_uart\nimport json, os, subprocess\n\nworktree = Path.cwd()\nelf = worktree.parents[3]/'bench/programs/coremark.elf'\n\ndef run(base):\n    env = {**os.environ,'RTL_DIR': str(base/'rtl'), 'OBJ_DIR': str(base/'obj'), 'NRET':'1'}\n    with (base/'verilator.log').open('w') as log:\n        subprocess.run(['bash','test/cosim/build.sh'], env=env, stdout=log, stderr=subprocess.STDOUT, check=True)\n    sim = subprocess.run([str(base/'obj/cosim_sim'), str(elf), '50000000','--bench','--istall','--dstall'], capture_output=True, text=True, check=True)\n    r = json.loads(sim.stdout.splitlines()[-1]); assert r['ebreak'] and r['bench_bracketed'] and not r['oob']\n    ok, reason = validate_coremark_uart(r['uart'],10); assert ok, reason\n    print(base.name, r['bench_stop_cycle'] - r['bench_start_cycle'], flush=True)\n\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    roots = [*Path(gettempdir()).glob('bench-r13-mul-*'), *Path(gettempdir()).glob('bench-r13-register_integer_lane-*')]\n    for result in pool.map(run,roots):\n        pass\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
