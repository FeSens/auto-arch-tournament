{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\n\nfrom pathlib import Path\n\nrtl=Path('cores/bench/rtl')\ndef edit(file, old, new):\n    path=rtl/file\n    data=path.read_text()\n    assert old in data, (file,old)\n    path.write_text(data.replace(old,new))\n\nedit('core_pkg.sv','    logic [31:0] alu_result;\\\\n','''    logic [31:0] alu_result;\n    logic [31:0] special_result;\n    logic        result_special;\n    logic        result_low_mul;\n''')\nedit('core.sv','logic [2:0] fwd_rs1_sel, fwd_rs2_sel;','''logic [3:0] fwd_rs1_sel, fwd_rs2_sel;\n  logic [31:0] low_product;\n  logic        ex_late_result;''')\nedit('core.sv','    .fwd_ex_mem           (ex_mem_w.alu_result),  // EX/MEM-registered ALU result','''    .fwd_ex_mem           (ex_mem_w.alu_result),\n    .fwd_special          (ex_mem_w.special_result),\n    .low_product          (low_product),\n    .ex_late_result       (ex_late_result),''')\nedit('core.sv','    .in         (ex_mem_w),','''    .in         (ex_mem_w),\n    .low_product(low_product),''')\nedit('core.sv','.id_ex_mem_read (id_ex_w.ctrl.mem_read),','.id_ex_late_result (ex_late_result),')\nedit('core.sv','    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write),','''    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write),\n    .ex_mem_special (ex_mem_w.result_special),''')\nedit('hazard_unit.sv','id_ex_mem_read','id_ex_late_result')\nedit('ex_stage.sv','logic [2:0]         fwd_rs','logic [3:0]         fwd_rs')\nedit('ex_stage.sv','  input  logic [31:0]        fwd_ex_mem,','''  output logic               ex_late_result,\n  output logic [31:0]        low_product,\n  input  logic [31:0]        fwd_special,\n  input  logic [31:0]        fwd_ex_mem,''')\nedit('ex_stage.sv','  assign rs1 = ','  assign rs1 = ({32{fwd_rs1_sel[3]}} & fwd_special) |\\\\n               ')\nedit('ex_stage.sv','  assign rs2 = ','  assign rs2 = ({32{fwd_rs2_sel[3]}} & fwd_special) |\\\\n               ')\nedit('ex_stage.sv',