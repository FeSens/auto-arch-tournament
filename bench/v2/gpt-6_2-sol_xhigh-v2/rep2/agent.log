{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\n\nmask = (1 << 32) - 1\nrng = random.Random(20261120)\nedge = [0, 1, 2, 3, 7, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, mask]\nvectors = [(a, b) for a in edge for b in edge]\nvectors += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(50_000)]\n\ndef signed(x):\n    return x if x < (1 << 31) else x - (1 << 32)\n\ndef run(a, b, is_signed):\n    ai = signed(a) if is_signed else a\n    bi = signed(b) if is_signed else b\n    if bi == 0:\n        return mask, a\n    d = abs(bi)\n    multiples = (0, d, d << 1, 3 * d)\n    remainder = quotient = 0\n    for cycle in range(6):\n        for digit in range(cycle * 3, cycle * 3 + 3):\n            trial = (remainder << 2) | ((abs(ai) >> (34 - digit * 2)) & 3)\n            assert trial < (1 << 34)\n            candidates = [((trial - multiple) & ((1 << 35) - 1)) for multiple in multiples]\n            q_digit = max(index for index, diff in enumerate(candidates) if not diff >> 34)\n            remainder = candidates[q_digit]\n            quotient = (quotient << 2) | q_digit\n            assert 0 <= remainder < d\n    return (-quotient if (ai < 0) \"'!= (bi < 0) else quotient) & mask, (-remainder if ai < 0 else remainder) & mask\n\nfor a, b in vectors:\n    for is_signed in (False, True):\n        ai = signed(a) if is_signed else a\n        bi = signed(b) if is_signed else b\n        if bi == 0:\n            expected = (mask, a)\n        else:\n            q = abs(ai) // abs(bi)\n            if (ai < 0) != (bi < 0):\n                q = -q\n            expected = (q & mask, (ai - q * bi) & mask)\n        assert run(a, b, is_signed) == expected, (a, b, is_signed, expected)\nprint(f\"Radix-4 model matched quotient and remainder for {len(vectors) * 2:,} signed and unsigned operand cases\")\n\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
