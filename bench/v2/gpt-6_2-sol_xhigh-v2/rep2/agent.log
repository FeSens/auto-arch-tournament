{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r11-veprb4la/queue_count.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path(__file__).resolve().parent\nchampion = Path('cores/bench/rtl')\nvariants = [('queue-count', champion), ('queue-count-split', root/'split-miss'),\n            ('queue-count-resolved', champion)]\nfor variant, src in variants:\n    dst=root/variant\n    shutil.copytree(src, dst)\n    p=dst/'if_stage.sv'\n    s=p.read_text()\n    if variant == 'queue-count-resolved':\n        s=s.replace('  logic [31:2] pc_q, recovery_pc, fetch_pc, predicted_pc;', '  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;')\n        s=s.replace('  logic [31:2] sequential_pc_q, target_pc_q, train_pc_q;', '  logic [31:2] train_pc_q;')\n        s=s.replace('  logic        take_target_q, train_q, target_pending_q;', '  logic        train_q, target_pending_q;')\n        a=s.index('  assign recovery_pc')\n        b=s.index('  assign {tag, successor}',a)\n        s=s[:a]+'  assign fetch_pc = target_pending_q ? recovery_pc_q : pc_q;\\\\n'+s[b:]\n        s=s.replace('train_pc_q[31:8], recovery_pc}', 'train_pc_q[31:8], recovery_pc_q}')\n        a=s.index('    if (\"'!target_pending_q) begin'\"')\n        b=s.index('    train_pc_q', a)\n        s=s[:a]+'''    if (\"'!target_pending_q)\n      recovery_pc_q <= take_target ? target_pc : sequential_pc;\n'\"'''+s[b:]\n        s=s.replace('bus_accept && \"'!scrub_active_q && !invalidate;'\"', 'bus_accept && \"'!scrub_active_q;'\"')\n    pending='target_pending' if variant == 'queue-count-split' else 'target_pending_q'\n    s=s.replace('  // The wrap bit distinguishes full from empty at equal RAM indices.', '  // The one-hot occupancy determines whether the ring has space or a head.')\n    s=s.replace('logic [2:0] read_ptr_q, write_ptr_q;', 'logic [1:0] read_ptr_q, write_ptr_q;\\\\n  logic [4:0] occupancy_q;')\n    s=s.replace('logic [2:0]