ion -gen_text_timing_rpt 1\",\n        \"run all\",\n        \"\",\n    ])\n\n\n_MAXF = re.compile(r\"^\\s*\\d+\\s+\\S+\\s+[\\d.]+\\(MHz\\)\\s+([\\d.]+)\\(MHz\\)\\s+(\\d+)\", re.M)\n\n\ndef _cells(rpt: str, name: str) -> int | None:\n    m = re.search(rf\"^\\s*{re.escape(name)}\\s*\\|\\s*(\\d+)\", rpt, re.M)\n\n\ndef _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n    \"\"\"Run the build; True if it hit BUILD_TIMEOUT_SEC (its process group is\n    killed).\"\"\"\n    import subprocess\n    with log.open(\"w\") \n…[9753 of 12825 chars elided by tools/bench/transcript.py; sha256:a022b036c6408c9e]…\nVM_SC=0 -DVM_TIMING=0 -DVM_TRACE=0 -DVM_TRACE_FST=0 -DVM_TRACE_VCD=0 -DVM_TRACE_SAIF=0 -faligned-new -fcf-protection=none -Wno-bool-operation -Wno-int-in-bool-context -Wno-shadow -Wno-sign-compare -Wno-subobject-linkage -Wno-tautological-compare -Wno-uninitialized -Wno-unused-but-set-parameter -Wno-unused-but-set-variable -Wno-unused-parameter -Wno-unused-variable    -DNRET=1   -c -o Vcore__ALL.o Vcore__ALL.cpp\ng++    main.o verilated.o verilated_threads.o Vcore__ALL.a    -pthread -lpthread -latomic   -o cosim_sim\nrm Vcore__ALL.verilator_deplist.tmp\nmake: Leaving directory '/srv/hwebench/tmp/4876824c/8df95641/bench_profile/queue_obj'\n- V e r i l a t i o n   R e p o r t: Verilator 5.047 devel rev v5.046-331-g2cd9b8df6 (mod)\n- Verilator: Built from 0.650 MB sources in 15 modules, into 0.296 MB in 7 C++ files needing 0.001 MB\n- Verilator: Walltime 4.368 s (elab=0.003, cvt=0.021, bld=4.335); cpu 0.033 s on 1 threads; allocated 24.008 MB\nBuilt: /srv/hwebench/tmp/4876824c/8df95641/bench_profile/queue_obj/cosim_sim\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cat tools/eval/_slots.py && rg -n '\"'^[[:space:]]*def|cosim'\"' test/cosim/run_cosim.py | tail -35 && cat formal/checks_si.cfg\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"cat tools/eval/_slots.py && rg -n '\"'^[[:space:]]*def|cosim'\"' test/cosim/run_cosim.py | tail -35 && cat formal/checks_si.cfg\"", "aggregated_output": "\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n6:def run_verilator(sim_bin, elf, maxcycles=50_000_000, timeout=120, sim_flags=()):\n22:def run_reference(elf, max_insns=10_000_000):\n36:def _mismatch(i, ref, field, expected, got):\n41:def compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\n47:        # inside fields cosim used to ignore.\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
