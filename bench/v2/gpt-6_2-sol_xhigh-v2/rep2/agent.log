{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom collections import Counter\nfrom pathlib import Path\nimport json\nimport subprocess\n\nproc = subprocess.Popen(['obj/cosim_sim','bench/programs/coremark.elf','8000000','--istall','--dstall'], stdout=subprocess.PIPE)\ncounts = Counter()\nlast = None\nactive = False\nfor line in proc.stdout:\n    trace = json.loads(line)\n    if 'insn' not in trace:\n        continue\n    if trace['mem_wmask'] and trace['mem_addr'] == 0x10000100:\n        active = True\n    if trace['mem_wmask'] and trace['mem_addr'] == 0x10000104:\n        break\n    if active and last is not None:\n        prev = last['insn']; insn = trace['insn']; op = insn & 127\n        uses1 = op in {3, 19, 35, 51, 99, 103}\n        uses2 = op in {35, 51, 99}\n        m1 = last['rd_addr'] \"'!= 0 and last['\"'rd_addr'] == (insn >> 15 & 31)\n        m2 = last['rd_addr'] \"'!= 0 and last['\"'rd_addr'] == (insn >> 20 & 31)\n        if prev & 127 == 3 and (m1 or m2):\n            if not (m1 and uses1 or m2 and uses2):\n                counts['false hazard'] += 1\n                counts['false hazard opcode ' + hex(op)] += 1\n            elif op == 35 and not m1:\n                counts['store data only'] += 1\n        if prev & 0xfe00707f == 0x02000033 and not (m1 and uses1 or m2 and uses2):\n            counts['MUL independent successor'] += 1\n    last = trace\nproc.stdout.close()\nproc.wait()\nprint(counts)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
