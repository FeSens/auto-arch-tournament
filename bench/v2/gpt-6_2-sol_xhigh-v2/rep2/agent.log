id && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n1:\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n4:route and static timing analysis) instead of Yosys + nextpnr, whose timing\n22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\n33:def gowin_env(base: dict | None, workdir: Path) -> dict:\n61:        \"set_option -gen_text_timing_rpt 1\",\n77:    modules the path crosses (in order), from Gowin's timing report.\"\"\"\n114:        return {\"placement_failed\": True, \"fmax_mhz\": None, \"reason\": \"no Fmax in timing report\"}\n155:    # Plain threads and blocking waits, no asyncio: agents run `make timing`\n158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n173:    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\n175:                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\n200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\n214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\n221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\nbin\noss-cad-suite\nxpack-riscv-none-elf-gcc-15.2.0-1\n/srv/hwebench/tmp/4876824c/e5f6fb8e\n","exit_code":0,"status":"completed"}}
