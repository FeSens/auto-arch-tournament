{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\n\nrtl = Path(\\\"cores/bench/rtl\\\")\n\ndef edit(file, replacements):\n    path = rtl / file\n    source = path.read_text()\n    for old, new in replacements:\n        assert source.count(old) == 1, (file, old, source.count(old))\n        source = source.replace(old, new)\n    path.write_text(source)\n\nedit(\\\"core_pkg.sv\\\", [\n    (\\\"// IF -> ID combinational bundle (no register; PC reg sits in if_stage).\\\", \\\"// Registered fetch head and its predicted successor.\\\"),\n    (\\\"logic [31:0] instr;\\\\n  } if_id_t;\\\", \\\"logic [31:0] instr;\\\\n    logic [31:2] predicted_pc;\\\\n  } if_id_t;\\\"),\n    (\\\"logic [31:0] pc;\\\\n    logic [31:0] rs1_val;\\\", \\\"logic [31:0] pc;\\\\n    logic [31:2] predicted_pc;\\\\n    logic [31:0] rs1_val;\\\"),\n])\nedit(\\\"core.sv\\\", [\n    (\\\"logic       fetch_accept, stall_id;\\\", \\\"logic       fetch_accept, fetch_available, stall_id;\\\"),\n    (\\\".accept          (fetch_accept),\\\", \\\".accept          (fetch_accept),\\\\n    .imem_ready      (io_imemReady),\\\\n    .available       (fetch_available),\\\"),\n    (\\\".stall        (stall_id),\\\", \\\".stall        (stall_id),\\\\n    .squash       (recovering),\\\"),\n    (\\\"    .fetch_pc        (io_imemAddr[31:2]),\\\\n\\\", \\\"\\\"),\n    (\\\".imem_ready     (io_imemReady),\\\", \\\".fetch_available (fetch_available),\\\"),\n])\nedit(\\\"id_stage.sv\\\", [\n    (\\\"input  logic              stall,\\\", \\\"input  logic              stall,\\\\n  input  logic              squash,\\\"),\n    (\\\"reg_q.pc       <= in.pc;\\\", \\\"reg_q.pc       <= in.pc;\\\\n      reg_q.predicted_pc <= in.predicted_pc;\\\"),\n    (\\\"match_mem_wb[1] <= (ex_mem_rd \"'!= 5'\"'b0) && (rs2_addr == ex_mem_rd);\\\\n    end\\\", \\\"match_mem_wb[1] <= (ex_mem_rd \"'!= 5'\"'b0) && (rs2_addr == ex_mem_rd);\\\\n    end else if (squash) begin\\\\n      reg_q.valid <= 1'b0;\\\\n    end\\\"),\n])\nedit(\\\"ex_stage.sv\\\", [\n    (\\\"  input  logic [31:2]        fetch_pc,      // successor predicted when EX was in ID\\\\n\\\", \\\"\\\"),\n    (\\\"// PC still holds EX's prediction while EX is stalled.\\\", \\\"// prediction is held with the instruction while EX is stalled.\\\"),\n    (\\\"== fetch_pc);\\\\n  assign target_match\\\", \\\"== in.predicted_pc);\\\\n  assign target_match\\\"),\n    (\\\"== fetch_pc);\\\\n  assign successor_match\\\", \\\"== in.predicted_pc);\\\\n  assign successor_match\\\"),\n])\nedit(\\\"hazard_unit.sv\\\", [\n    (\\\"  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\\\\n  // random ~22% stall in vex_main.cpp). When low, the corresponding\\\\n  // memory request is NOT serviced this cycle.\\\\n  input  logic       imem_ready,\\\", \\\"  input  logic       fetch_available,  // registered head has a usable instruction\\\"),\n    (\\\"= imem_ready && ex_valid\\\", \\\"= fetch_available && ex_valid\\\"),\n    (\\\"= imem_ready && \"'!load_use_hazard\", \"= fetch_available && !load_use_hazard\"),\n])\nPY\ncat > cores/bench/rtl/if_stage.sv <<'\"'SV'\n// Instruction fetch with a tagged last-successor predictor and a registered\n// decode head. The pending request follows the youngest queued instruction.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              accept,\n  input  logic              imem_ready,\n  output logic              available,\n  input  logic              mispredict,\n  input  logic [31:2]       resolved_pc,\n  input  logic              train,\n  input  logic [31:2]       train_pc,\n  output logic              recovering,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t            out\n);\n\n  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;\n  logic [63:0] valid_q;\n  logic [53:0] entries [0:63];\n  logic [23:0] tag;\n  logic [31:2] successor;\n  logic        hit;\n  logic        train_q;\n  logic [31:2] train_pc_q, train_successor_q;\n\n  localparam int QUEUE_DEPTH = 4;\n  logic [QUEUE_DEPTH-1:0] full_q;\n  logic [61:0] packets [0:QUEUE_DEPTH-1];\n  logic        push, pop;\n  logic [61:0] response;\n\n  assign fetch_pc = recovering ? recovery_pc_q : pc_q;\n  assign {tag, successor} = entries[fetch_pc[7:2]];\n  assign hit = valid_q[fetch_pc[7:2]] && (tag == fetch_pc[31:8]);\n  assign predicted_pc = hit ? successor : fetch_pc + 30'd1;\n\n  assign available = full_q[0] && \"'!recovering;\n  assign pop = accept;\n  assign push = imem_ready && (recovering || !full_q[QUEUE_DEPTH-1] || pop);\n  assign response = {fetch_pc, imem_data};\n  for (genvar slot = 0; slot < QUEUE_DEPTH; slot = slot + 1) begin : queue\n    logic        shift_valid, fill, has_younger;\n    logic [61:0] younger;\n    if (slot < QUEUE_DEPTH - 1) begin : next_slot\n      assign has_younger = full_q[slot+1];\n      assign younger = packets[slot+1];\n    end else begin : end_slot\n      assign has_younger = 1'\"'b0;\n      assign younger = '0;\n    end\n    assign shift_valid = pop ? has_younger : full_q[slot];\n    if (slot == 0) begin : head\n      assign fill = push && (recovering || \"'!shift_valid);\n    end else begin : tail\n      assign fill = push && !recovering && !shift_valid &&\n                    (pop ? full_q[slot] : full_q[slot-1]);\n    end\n\n    always_ff @(posedge clock) begin\n      if (reset)\n        full_q[slot] <= 1'\"'b0;\n      else\n        full_q[slot] <= fill || (\"'!recovering && shift_valid);\n\n      if (fill)\n        packets[slot] <= response;\n      else if (pop && has_younger)\n        packets[slot] <= younger;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      train_q <= 1'\"'b0;\n    else\n      train_q <= train;\n    if (train) begin\n      train_pc_q <= train_pc;\n      train_successor_q <= resolved_pc;\n    end\n\n    if (reset)\n      valid_q <= '0;\n    else if (train_q)\n      valid_q[train_pc_q[7:2]] <= 1'b1;\n    if (train_q)\n      entries[train_pc_q[7:2]] <= {train_pc_q[31:8], train_successor_q};\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_q       <= '0;\n      recovering <= 1'b0;\n    end else begin\n      if (push)\n        pc_q <= predicted_pc;\n      recovering <= mispredict || (recovering && \"'!push);\n    end\n\n    if (!recovering)\n      recovery_pc_q <= resolved_pc;\n  end\n\n  assign imem_addr        = {fetch_pc, 2'\"'b00};\n  assign out.pc           = {packets[0][61:32], 2'b00};\n  assign out.instr        = packets[0][31:0];\n  assign out.predicted_pc = full_q[1] ? packets[1][61:32] : fetch_pc;\nendmodule\nSV\nverilator --lint-only -Wall -Wno-style +incdir+cores/bench/rtl --top-module core cores/bench/rtl/core_pkg.sv \"'$(find cores/bench/rtl -name '\"'*.sv' \"'! -name core_pkg.sv | sort)'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
