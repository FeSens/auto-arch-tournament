ext(s)\n    if variant == 'prefix-and-replay':\n        p=path/'if_stage.sv'\n        s=p.read_text().replace('  // Ready bus data can bypass to decode. Replay enters through the queue.\\\\n  assign decode_valid = \"'!empty || imem_ready;'\"','  assign decode_valid = \"'!empty || imem_ready || replay_available;'\"')\n        p.write_text(s.replace('assign out = empty ? {imem_addr, imem_data}', 'assign out = empty ? {imem_addr, fetch_word}'))\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom tools.eval.gowin import build_all, summarize\nworktree = Path.cwd()\nfor name in ('prefix-launch', 'prefix-and-replay'):\n    variant = Path(gettempdir()) / 'bench-r8s0' / name\n    results = build_all(worktree, variant / 'rtl', 'fpga/core_bench_si.sv', variant / 'timing')\n    print(name, summarize(results))\n    for result in results:\n        print(result['place_option'], result.get('critical_paths', [])[:2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
