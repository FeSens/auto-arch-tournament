c bench/programs/coremark/core_main.c bench/programs/coremark/core_matrix.c bench/programs/coremark/core_state.c bench/programs/coremark/core_util.c bench/programs/coremark/baremetal/core_portme.c bench/programs/crt0.S -o /srv/hwebench/tmp/4876824c/847ff794/predictor.AFUHyG/coremark.elf\n{\"order\":2937036,\"cycle\":3507080,\"insn\":1048691,\"pc_rdata\":20,\"pc_wdata\":24,\"rd_addr\":0,\"rd_wdata\":0,\"rs1_addr\":0,\"rs1_rdata\":0,\"rs2_addr\":1,\"rs2_rdata\":20,\"mem_addr\":0,\"mem_rmask\":0,\"mem_rdata\":196887,\"mem_wmask\":0,\"mem_wdata\":20,\"trap\":0,\"halt\":0,\"intr\":0,\"mode\":3,\"ixl\":1}\n{\"ebreak\":true,\"maxcycles_hit\":false,\"oob\":false,\"bench_start_cycle\":12351,\"bench_stop_cycle\":3501479,\"bench_bracketed\":true,\"uart\":\"2K performance run parameters for coremark.\\nCoreMark Size    : 666\\nTotal ticks      : 0\\nTotal time (secs): 10\\nIterations/Sec   : 1\\nIterations       : 10\\nCompiler version : riscv32-elf-gcc\\nCompiler flags   : -O2 -march=rv32im\\nMemory location  : STACK\\nseedcrc          : 0xe9f5\\n[0]crclist       : 0xe714\\n[0]crcmatrix     : 0x1fd7\\n[0]crcstate      : 0x8e3a\\n[0]crcfinal      : 0xfcaf\\nCorrect operation validated. See README.md for run and reporting rules.\\n\"}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'probe=$(cat /srv/hwebench/tmp/4876824c/847ff794/predictor-path)\ncat > \"$probe/sweep.py\" <<'\"'PY'\nimport collections\nimport json\nimport struct\nimport sys\nfrom pathlib import Path\n\ndata = Path(sys.argv[1])\nstats = json.loads((data / 'champion.jsonl').read_text().splitlines()[-1])\nevents = [(pc, nxt, op) for cycle,pc,nxt,op in struct.iter_unpack('IIII',(data/'branch-trace.bin').read_bytes()) if stats['bench_start_cycle'] <= cycle < stats['bench_stop_cycle']]\nuniq = collections.Counter((pc, op) for pc,nxt,op in events)\nprint('cycles', stats['bench_stop_cycle']-stats['bench_start_cycle'], 'events',len(events), 'dynamic',collections.Counter(x[2] for x in events), 'static',collections.Counter(x[1] for x in uniq))\nprint('frequent', [(hex(pc),hex(op),n) for (pc,op),n in uniq.most_common(20)])\n\ndef simulate(size, hist_bits=0, global_bits=0, tag_train=False, bypass=True, fallback=False, aggressive=False):\n    width = (size-1).bit_length()\n    def index(pc):\n        pc >>= 2\n        return (pc \"'^ (pc>>width)) & (size-1)\n    nstates=1<<hist_bits\n    memory = [None] * size\n    branchid = [-1] * size\n    counter = [bytearray([1]*nstates) for _ in range(size)]\n    hist = [0] * size\n    glob = 0\n    gtable = bytearray([1]*(1<<global_bits))\n    missed = collections.Counter()\n    missed_pc = collections.Counter()\n    pending = None\n    for pc, nxt, op in events:\n        sequential = pc+4\n        idx = index(pc)\n        gi = ((pc>>2)''^glob) & ((1<<global_bits)-1)\n        taken = nxt != sequential\n        entry = memory[idx]\n        new_site = branchid[idx] != pc\n        if new_site and tag_train:\n            ctr = bytearray([1]*nstates)\n            last = 0\n        else:\n            ctr = counter[idx]\n            last = hist[idx]\n        choose_taken = (gtable[gi] if global_bits else ctr[last]) >= 2\n        if fallback and global_bits and gtable[gi] in (1,2):\n            choose_taken=ctr[last]>=2\n        hit = entry and entry[0] == pc\n        predicted = sequential\n        if pending == pc and bypass:\n            kind = '\"'corrected'\n        elif not hit:\n            if aggressive and op==0x63 and choose_taken and taken:\n                predicted=nxt\n            kind = 'no entry'\n        elif op==0x63 and not choose_taken:\n            kind = 'dir'\n        else:\n            predicted = entry[1]\n            kind = 'dir' if op==0x63 and not taken else 'target'\n        if predicted \"'!= nxt:\n            missed[(kind, op)] += 1\n            missed_pc[pc] += 1\n            pending=nxt\n        else:\n            pending=None\n        if op==0x63:\n            branchid[idx]=pc\n            ctr[last] = min(3,ctr[last]+1) if taken else max(0,ctr[last]-1)\n            counter[idx]=ctr\n            hist[idx] = ((last<<1)|taken)&(nstates-1)\n            gtable[gi] = min(3,gtable[gi]+1) if taken else max(0,gtable[gi]-1)\n            glob = ((glob<<1)|taken) & ((1<<global_bits)-1)\n        if taken:\n            memory[idx]=(pc,nxt)\n    return f'\"'{sum(missed.values()):6}  '+ str(dict(missed)), missed_pc\n\nfor size in (64,128,256,512,1024):\n    for local,glob,tag,bypass in ((0,0,False,True),(0,0,False,False),(2,0,False,True),(2,0,True,True),(4,0,True,True)):\n        result, pcs = simulate(size,local,glob,tag,bypass)\n        print(size, 'L'+str(local), 'G'+str(glob), tag,bypass,result)\n    for bits in (6,8,10,12):\n        r,_ = simulate(size,0,bits,False,True)\n        print(size,'G'+str(bits),r)\n    print()\nPY\nif test -s \\\"\"'$probe/champion.jsonl\"; then python3 \"$probe/sweep.py\" \"$probe\"; else tail -12 \"$probe/verilator.log\"; fi'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
