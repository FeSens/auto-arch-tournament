{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"cat > replay.py <<'PY'\nfrom collections import Counter,defaultdict\nrows=[]\nfor line in open('controls.log'):\n    if line.startswith('B '):\n        _,pc,nextpc,target,branch,jalr,taken=line.split()\n        rows.append((int(pc,16)>>2,int(nextpc,16)>>2,int(target,16)>>2,int(branch),int(jalr),int(taken)))\nprint('total',len(rows), 'sites', len({r[0] for r in rows}), 'types',Counter((r[3],r[4]) for r in rows))\nprint('cross',sum(p>>14\"'!=d>>14 for p,n,d,_,_,_ in rows), '\"'4k cross',sum(p>>10\"'!=d>>10 for p,n,d,_,_,_ in rows))\ndef replay(seek, policy, buf=64, local=0, history=0):\n    mask=buf-1\n    table={}\n    bimodal={}\n    gh=0\n    miss=Counter()\n    by_pc=Counter()\n    for pc,n,target,branch,jalr,taken in rows:\n        index=seek(pc)&mask\n        state = table.get(index)\n        hit = state is not None and state[0] == pc\n        if policy=='\"'last':\n            pred=state[1] if hit else pc+1\n            if not local or pc>>local == n>>local:\n                table[index]=(pc,n,0)\n            else:\n                table.pop(index,None)\n        else:\n            dindex=((pc \"'^ gh) & 255) if history else index\n            cnt = bimodal.get(dindex,1) if history else state[2] if hit else 1\n            pred=state[1] if hit and (not branch or cnt>=2) else pc+1\n            dest=target if branch else n\n            if not local or pc>>local == dest>>local:\n                table[index]=(pc,dest, max(0,min(3,cnt + (1 if taken else -1))))\n            else:\n                table.pop(index,None)\n            if history and branch:\n                bimodal[dindex]=max(0,min(3,cnt + (1 if taken else -1)))\n                gh=((gh<<1)|taken) & ((1<<history)-1)\n        if pred != n:\n            miss[(branch,jalr)]+=1\n            by_pc[pc<<2]+=1\n    return sum(miss.values()),dict(miss),[(hex(k),v) for k,v in by_pc.most_common(8)]\nfor n in [32,64,128,256,1<<22]:\n    for p in ['\"'last','2bit']:\n        print(n,p,replay(lambda x:x,p,n,14))\nfor shift in range(1,17):\n    print('xor',shift, ' '.join(str(replay(lambda x:x\"'^(x>>shift),p,64,14)[0]) for p in ('\"'last','2bit')))\nfor b in range(1,9):\n    print('gh',b,replay(lambda x:x,'2bit',64,14,b))\nPY\npython3 replay.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
