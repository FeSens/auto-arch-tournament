{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom subprocess import run\nimport json\nfrom tools.eval.fpga import validate_coremark_uart\nbase=Path('/srv/hwebench/tmp/4876824c/c3d24903/predictor-r4s2.LRNxlnua')\ndef bench(label):\n sim = base / ('champion' if label == 'champion' else f'{label}/obj') / 'cosim_sim'\n r = run([str(sim),str(base/'coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True)\n marker = json.loads(r.stdout.splitlines()[-1])\n assert marker['ebreak'] and marker['bench_bracketed'] and not marker['oob'], marker\n valid,reason = validate_coremark_uart(marker['uart'], 10)\n assert valid, reason\n return label, marker['bench_stop_cycle']-marker['bench_start_cycle']\nwith ThreadPoolExecutor() as ex:\n for label,cycles in ex.map(bench, ['champion','q2','q4','q8']): print(label,cycles)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
