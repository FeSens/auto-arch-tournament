ms/selftest.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n/opt/hwe-toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-gcc\n/srv/hwebench/toolchain/xpack-riscv-none-elf-gcc-15.2.0-1/bin/riscv-none-elf-gcc\ntotal 464\ndrwxrwx---+  3 nobody nogroup   4096 Nov 20 06:28 .\ndrwxrwx---+  3 nobody nogroup   4096 Nov 20 06:28 ..\n-rw-rw----+  1 nobody nogroup   2317 Nov 20 06:28 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 20 06:28 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 20 06:28 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 20 06:28 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 20 06:28 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 20 06:28 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 20 06:28 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 20 06:28 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 20 06:28 selftest.S\n","exit_code":0,"status":"completed"}}
