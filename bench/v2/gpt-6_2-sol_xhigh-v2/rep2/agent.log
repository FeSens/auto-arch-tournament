active_q;\n  assign fill        = bus_accept && !scrub_active_q;\n  assign write_index = scrub_active_q ? scrub_index_q : fetch_pc[10:2];\n  assign write_entry = scrub_active_q ? '\"'0 : {1'b1, fetch_pc[31:11], imem_data};\\\"\\\"\\\", \\\"\\\"\\\"  assign invalidate  = redirect_now && \"'!train_q;\n  assign scrub_write = scrub_active_q || invalidate;\n  assign read_enable = fetch_accept && !scrub_write;\n  assign fill        = bus_accept && !scrub_write;\n  assign write_index = scrub_write ? scrub_index_q : fetch_pc[10:2];\n  assign write_entry = scrub_write ? '\"'0 : {1'b1, fetch_pc[31:11], imem_data};\\\"\\\"\\\")\ns = s.replace(\\\"if (scrub_active_q || fill)\\\", \\\"if (scrub_write || fill)\\\")\ns = s.replace(\\\"if (bus_accept && \"'!scrub_active_q)\", \"if (fill)\")\ns = s.replace(\"if (reset || invalidate)'\"\\\\n      scrub_active_q <= 1'b1;\\\\n    else if (scrub_active_q && (&scrub_index_q))\\\\n      scrub_active_q <= 1'b0;\\\",\n              \\\"if (reset)\\\\n      scrub_active_q <= 1'b1;\\\\n    else if (scrub_write)\\\\n      scrub_active_q <= \"'!(&scrub_index_q);\")\ns = s.replace(\"else if (scrub_active_q)\", \"else if (scrub_write)\").replace(\"if (reset || scrub_active_q)\", \"if (reset || scrub_write)\")\ns = s.replace(\"(replay_available && !invalidate)\", \"replay_available\")\ns = s.replace(\"      target_pending <= 1'\"'b0;\\\\n      recovering       <= 1'b0;\\\",\n              \\\"      target_hold_q  <= 1'b0;\\\\n      recovery_hold_q <= 1'b0;\\\")\ns = s.replace(\\\"      target_pending <= mispredict || (target_pending && \"'!imem_ready);'\"\\\\n      recovering <= mispredict || (recovering && (backend_stall || (target_pending && \"'!imem_ready)));\",\n              \"      target_hold_q <= target_pending && !imem_ready;'\"\\\\n      recovery_hold_q <= recovering && (backend_stall || (target_pending && \"'!imem_ready));\")\ns = s.replace(\"      take_target_q   <= take_target;\", \"\"\"      take_target_q   <= take_target;\n      fen