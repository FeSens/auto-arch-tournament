{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r11-veprb4la/direct_pc.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nroot=Path(__file__).resolve().parent\nvariants=(('direct-pc', Path('cores/bench/rtl')), ('direct-pc-forward', root/'early-forward'),\n          ('direct-pc-mul', root/'mul-mem-flag'))\nfor variant, src in variants:\n    dst=root/variant\n    shutil.copytree(src, dst)\n    p=dst/'if_stage.sv'\n    s=p.read_text()\n    s=s.replace('pc_q, recovery_pc, fetch_pc, predicted_pc;', 'pc_q, recovery_pc_q, fetch_pc, predicted_pc;')\n    s=s.replace('  logic [31:2] sequential_pc_q, target_pc_q, train_pc_q;', '  logic [31:2] train_pc_q;')\n    s=s.replace('  logic        take_target_q, train_q, target_pending_q;', '  logic        train_q, target_pending_q;')\n    a=s.index('  assign recovery_pc')\n    b=s.index('  assign {tag, successor}',a)\n    s=s[:a]+'  assign fetch_pc = pc_q;\\\\n'+s[b:]\n    s=s.replace('train_pc_q[31:8], recovery_pc}', 'train_pc_q[31:8], recovery_pc_q}')\n    a=s.index('    if (\"'!target_pending_q) begin'\"')\n    b=s.index('    train_pc_q',a)\n    s=s[:a]+'    recovery_pc_q <= take_target ? target_pc : sequential_pc;\\\\n'+s[b:]\n    s=s.replace('      if (fetch_accept)\\\\n        pc_q <= predicted_pc;', '''      if (fetch_accept || mispredict)\n        pc_q <= ({30{\"'!mispredict}} & predicted_pc) |\n                ({30{mispredict && take_target}} & target_pc) |\n                ({30{mispredict && !take_target}} & sequential_pc);'\"''')\n    s=s.replace('bus_accept && \"'!scrub_active_q && !invalidate;'\"', 'bus_accept && \"'!scrub_active_q;'\"')\n    p.write_text(s)\n    p=dst/'core.sv'\n    p.write_text(p.read_text().replace('(decode_ready && decode_valid && \"'!mispredict)'\"', '(decode_ready && decode_valid)'))\nPY\npython \\\"\"'$TMPDIR/bench-r11-veprb4la/direct_pc.py\"\npython - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom p