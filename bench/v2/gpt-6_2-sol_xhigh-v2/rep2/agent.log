{"type": "item.completed", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c \"sed -n '210,310p' cores/bench/test/test_if_stage.py && rg -n 'BENCH|start_cycle|dmem_rdata|GOWIN' fpga/core_bench_si.sv tools/eval/fpga.py | head -65\"", "aggregated_output": "\n@cocotb.test()\nasync def distinct_row_fill_and_replay_survive_a_full_queue(dut):\n    await _reset_and_scrub(dut)\n    word_at_16 = 0x5000\n    await _step(dut, training=(12, 16, False))\n    await _step(dut, training=(16, 12, False))\n    await _jump_to(dut, 16)\n    assert await _step(dut, word_at_16) == (16, 16, word_at_16)\n    await _jump_to(dut, 0)\n    words = [0x1000, 0x2000, 0x3000, 0x4000]\n    for pc, word in zip(range(0, 16, 4), words):\n        assert await _step(dut, word, consume=False) == (pc, 0, words[0])\n\n    # The ready response while full is rejected even on the first pop.\n    assert await _step(dut, 0xDEADBEEF, consume=False) == (16, 0, words[0])\n    assert await _step(dut, consume=False) == (16, 0, words[0])\n    assert await _step(dut, 0xDEADBEEF) == (16, 0, words[0])\n    assert await _step(dut) == (16, 4, words[1])\n    assert await _step(dut) == (12, 8, words[2])\n    assert await _step(dut) == (16, 12, words[3])\n    assert await _step(dut) == (12, 16, word_at_16)\n    assert await _step(dut) == (16, 12, words[3])\n\n\n@cocotb.test()\nasync def same_row_target_preserves_old_word_and_checks_its_tag(dut):\n    await _reset_and_scrub(dut)\n    # The addresses share a replay index and are in the same predictor page.\n    a, b = 0x40, 0x840\n    old_word, new_word = 0xABCDEF01, 0xAA55AA55\n    await _step(dut, training=(a, b, False))\n    await _jump_to(dut, b)\n    assert await _step(dut) == (b, b, None)\n    assert await _step(dut, old_word) == (b, b, old_word)\n\n    await _jump_to(dut, a - 4)\n    assert await _step(dut, old_word) == (a - 4, a - 4, old_word)\n    assert await _step(dut, new_word) == (a, a, new_word)\n    assert await _step(dut) == (b, b, old_word)\n\n    # Fill the shared row with A via correction. B then misses on A's tag.\n    await _jump_to(dut, a)\n    assert await _step(dut, new_word) == (a, a, new_word)\n    await _jump_to(dut, a - 4)\n    assert await _step(dut, old_word) == (a - 4, a - 4, old_word)\n    assert await _step(dut) == (a, a, new_word)\n    assert await _step(dut) == (b, b, None)\n\n\n@cocotb.t\n…[2040 of 5112 chars elided by tools/bench/transcript.py; sha256:6f1198886cfa78a5]…\nle=\"test_if_stage\",\ntools/eval/fpga.py:21:    nret=1, injects BENCH=fpga/core_bench_si.sv so synth.tcl reads the\ntools/eval/fpga.py:23:    default dual-channel core_bench.sv. nret=2 leaves BENCH unset and\ntools/eval/fpga.py:34:        env[\"BENCH\"] = \"fpga/core_bench_si.sv\"\ntools/eval/fpga.py:265:                          f'start={marker.get(\"bench_start_cycle\")} '\ntools/eval/fpga.py:267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\ntools/eval/fpga.py:270:                'reason': f'invalid_bench_bracket: start={marker.get(\"bench_start_cycle\")} stop={marker.get(\"bench_stop_cycle\")}'}\nfpga/core_bench_si.sv:5:// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\nfpga/core_bench_si.sv:23:  logic [31:0] dmem_rdata;\nfpga/core_bench_si.sv:35:  assign dmem_rdata = dmem[dmem_addr[12:2]];\nfpga/core_bench_si.sv:69:    .io_dmemRData     (dmem_rdata),\nfpga/core_bench_si.sv:100:  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n", "exit_code": 0, "status": "completed"}}
