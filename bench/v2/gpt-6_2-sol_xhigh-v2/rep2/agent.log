pected)\n    47\t\n    48\t\n    49\t@cocotb.test()\n    50\tasync def add(dut):\n    51\t    await _setup(dut)\n    52\t    await _check(dut, ALU_ADD, 5, 3, 8)\n    53\t    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n    54\t\n    55\t\n    56\t@cocotb.test()\n    57\tasync def sub(dut):\n    58\t    await _setup(dut)\n    59\t    await _check(dut, AL\n…[5469 of 8541 chars elided by tools/bench/transcript.py; sha256:57ec985fd19ab5a7]…\niv(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n   217\t\n   218\t\n   219\t@cocotb.test()\n   220\tasync def back_to_back_divides(dut):\n   221\t    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n   222\t    divides — no carry-over of operands or state from the previous op.\n   223\t    \"\"\"\n   224\t    await _setup(dut)\n   225\t    # Real divides only (avoid edge-case short-circuit) so each pass\n   226\t    # exercises the full 33-cycle FSM.\n   227\t    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n   228\t    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n   229\t    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n   230\t    await _check_div(dut, ALU_REM, 10, 3, 1)\n   231\t    await _check_div(dut, ALU_REMU, 7, 3, 1)\n   232\t\n   233\t\n   234\tdef test_alu_runner():\n   235\t    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n   236\t    run_cocotb(toplevel=\"alu\",\n   237\t               sources=[\"core_pkg.sv\", \"alu.sv\"],\n   238\t               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
