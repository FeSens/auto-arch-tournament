{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path(\\\"test/test_pipeline.py\\\")\ns=p.read_text()\na=s.index('    print(\\\"JALR FETCHES\\\"')\nb=s.index('\\\\n\\\\n@cocotb.test()',a)\ns=s[:a]+'''    cold, hit, changed = [i for i, pc in enumerate(fetches) if pc == 0x104]\n    assert fetches[cold:cold + 3] == [0x104, 0x108, 0x10C]\n    assert fetches[hit:hit + 3] == [0x104, 0x20, 0x24]\n    assert fetches[changed:changed + 10] == [\n        0x104, 0x20, 0x24, 0x28, 0x2C, 0x48, 0x48, 0x48, 0x48, 0x4C,\n    ]\n    assert [da for _, da, wen in bus if wen] == [0x1C, 0x40, 0x1C, 0x40, 0x44, 0x44, 0x44]\n    assert dmem == {0x1C: 0x20, 0x40: 0x20, 0x44: 0x48}\n    assert [r[\\\"pc\\\"] for r in rets] == [\n        0x00, 0x04, 0x08, 0x100, 0x104, 0x20, 0x24, 0x28, 0x2C, 0x100,\n        0x104, 0x20, 0x24, 0x28, 0x0C, 0x10, 0x100, 0x104, 0x48, 0x4C,\n    ]\n    first, second, third = _by_insn(rets, jalr)\n    assert [r[\\\"pc_next\\\"] for r in (first, second, third)] == [0x20, 0x20, 0x48]\n    first_store, second_store = [r for r in rets if r[\\\"pc\\\"] == 0x20]\n    assert first_store[\\\"cycle\\\"] == first[\\\"cycle\\\"] + 3\n    assert second_store[\\\"cycle\\\"] == second[\\\"cycle\\\"] + 1\n    assert rets[-2][\\\"cycle\\\"] == third[\\\"cycle\\\"] + 6\n    assert rets[-2][\\\"rd_wdata\\\"] == 0x109\n'''+s[b:]\na=s.index('    print(\\\"STALE FETCHES\\\"')\nb=s.index('\\\\n\\\\n@cocotb.test()',a)\ns=s[:a]+'''    assert [r[\\\"pc\\\"] for r in rets] == [0x00, 0x04, 0x20, 0x00, 0x04, 0x08, 0x0C]\n    fetches = [ia for ia, _, _ in bus]\n    first, second = [i for i, pc in enumerate(fetches) if pc == 0x04]\n    assert fetches[first:first + 4] == [0x04, 0x08, 0x0C, 0x20]\n    assert fetches[second:second + 5] == [0x04, 0x20, 0x00, 0x08, 0x0C]\n    load, use = rets[4:6]\n    assert load[\\\"insn\\\"] == LW(1, 0, 0)\n    assert load[\\\"pc_next\\\"] == 0x08 and load[\\\"rd_wdata\\\"] == 42\n    assert use[\\\"rd_wdata\\\"] == 43 and use[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 2\n    assert not any(wen for _, _, wen in bus)\n\n\n@cocotb.test()\nasync def page_alias_on_ordinary_instruction_recovers(dut):\n    \\\"\\\"\\\"A same-offset instruction on another page can see a stale target.\\\"\\\"\\\"\n    program = {\n        0x00: JAL(0, 0x20),\n        0x20: ADDI(1, 0, 1),\n        0x24: JAL(0, 0x80 - 0x24),\n        0x28: SW(1, 0, 16),\n        0x80: JAL(0, 0x10020 - 0x80),\n        0x10020: ADDI(2, 0, 42),\n        0x10024: ADDI(3, 2, 1),\n        0x10028: SW(3, 0, 8),\n        0x1002C: EBREAK(),\n        0x10080: SW(1, 0, 12),\n    }\n    bus = []\n    rets, dmem = await _run(dut, lambda pc: program.get(pc, NOP()), bus_trace=bus)\n    fetches = [ia for ia, _, _ in bus]\n    alias = fetches.index(0x10024)\n    assert fetches[alias + 1] == 0x10080\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 0x20, 0x24, 0x80, 0x10020, 0x10024, 0x10028, 0x1002C]\n    assert [da for _, da, wen in bus if wen] == [8]\n    assert dmem == {8: 43}\n\n\n@cocotb.test()\nasync def full_fetch_queue_drains_after_dmem_hold(dut):\n    \\\"\\\"\\\"Drain a full queue when a data hold ends and imem stalls.\\\"\\\"\\\"\n    program = [ADDI(1, 0, 42), SW(1, 0, 0), ADDI(2, 0, 0)]\n    program += [ADDI(2, 2, 1)] * 24 + [SW(2, 0, 4), EBREAK()]\n    bus = []\n    rets, dmem = await _run(\n        dut, program, dmem_stalls={0: 25}, imem_stalls={0x50: 4}, bus_trace=bus,\n    )\n    assert sum(ia == 0x4C and da == 0 and bool(wen) for ia, da, wen in bus) >= 5\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, len(program) * 4, 4))\n    assert dmem == {0: 42, 4: 24}\n'''+s[b:]\np.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 pytest -q -s -p no:cacheprovider test/test_pipeline.py > revised_pipeline.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
