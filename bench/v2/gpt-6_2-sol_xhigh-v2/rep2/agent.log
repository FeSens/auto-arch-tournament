{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"tail -45 cores/bench/test/test_div_unit.py && rg -n 'def test|from tempfile' tools/eval/cosim.py\"","aggregated_output":"async def mixed_magnitudes(dut):\n    await _setup(dut)\n    rng = random.Random(4)\n    for width in range(1, 33):\n        for _ in range(2):\n            a = rng.getrandbits(32)\n            b = rng.getrandbits(width) | (1 << (width - 1))\n            signed_a = a - (1 << 32) if a >> 31 else a\n            signed_b = b - (1 << 32) if b >> 31 else b\n            if width < 32 and rng.getrandbits(1):\n                signed_b = -signed_b\n            quotient = abs(signed_a) // abs(signed_b)\n            if (signed_a < 0) != (signed_b < 0):\n                quotient = -quotient\n            for vector in (\n                (ALU_DIVU, a, b, a // b),\n                (ALU_REMU, a, b, a % b),\n                (ALU_DIV, signed_a, signed_b, quotient),\n                (ALU_REM, signed_a, signed_b, signed_a - quotient * signed_b),\n            ):\n                await _check_result(dut, *vector)\n                await _check_acceptance(dut)\n\n\n@cocotb.test()\nasync def deferred_acceptance(dut):\n    await _setup(dut, result_ready=0)\n    await _check_result(dut, ALU_DIV, -271, 10, -27)\n    _drive_request(dut, ALU_REMU, 102, 13)\n    for _ in range(4):\n        await _tick(dut)\n        assert dut.request_ready.value == 0\n        assert dut.result_valid.value == 1\n        assert dut.result.value == (-27 & MASK32)\n\n    dut.result_ready.value = 1\n    await _check_acceptance(dut)\n    await _check_result(dut, ALU_REMU, 102, 13, 11)\n    await _check_acceptance(dut)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n","exit_code":1,"status":"failed"}}
