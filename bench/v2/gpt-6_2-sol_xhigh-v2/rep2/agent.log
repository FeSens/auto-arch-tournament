{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c 'scratch=/srv/hwebench/tmp/4876824c/b810a303/divider.jH0L18\nmkdir -p \"$scratch/cores/bench\"\ncp -r cores/bench/rtl cores/bench/test cores/bench/core.yaml \"$scratch/cores/bench/\"\ncp -r fpga \"$scratch/\"\ncat > \"$scratch/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nsrc = Path(sys.argv[1]).read_text()\ndest = Path(sys.argv[2])\ntop = src[:src.index('  localparam logic [3:0]')]\nalt = src[src.index('  logic [31:0] salt;'):src.index('\"'`else'\"')]\nalt = alt.replace('final_result <= (a - b) \"'^ salt;'\"', 'result <= (a - b) \"'^ salt;'\"')\ncontrol = \\\"\\\"\\\"  localparam logic [3:0] IDLE = 4'd0, PREFIX = 4'd1, DONE = 4'd8;\n  logic [3:0] phase_q;\n  logic capture;\n\n  assign request_ready = (phase_q == IDLE);\n  assign result_valid = (phase_q == DONE);\n  assign capture = request_valid && request_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      phase_q <= IDLE;\n    else if (capture)\n      phase_q <= PREFIX;\n    else if (result_valid && result_ready)\n      phase_q <= IDLE;\n    else if (\"'!request_ready && !result_valid)\n      phase_q <= phase_q + 4'\"'d1;\n  end\n\n\\\"\\\"\\\"\nrtl = \\\"\\\"\\\"  logic want_remainder, negative_a, negative_b;\n  logic remainder_q, negate_q;\n  logic [31:0] divisor_q, remainder_bits_q, quotient_bits_q, magnitude_result;\n  logic [35:0] multiple [0:15];\n  logic [11:0] narrow_multiple [0:15];\n  logic [11:0] narrow_divisor;\n  logic [35:0] full_divisor;\n\n  assign want_remainder = (op == ALU_REM || op == ALU_REMU);\n  assign negative_a = (op == ALU_DIV || op == ALU_REM) && a[31];\n  assign negative_b = (op == ALU_DIV || op == ALU_REM) && b[31];\n  assign narrow_divisor = {4'b0, divisor_q[7:0]};\n  assign full_divisor = {4'b0, divisor_q};\n  assign multiple[0] = '0;\n  assign multiple[1] = full_divisor;\n  assign narrow_multiple[0] = '0;\n  assign narrow_multiple[1] = narrow_divisor;\n\n  for (genvar k = 2; k < 16; k++) begin : gen_multiple\n    if ((k & 1) == 0) begin\n      assign multiple[k] = multiple[k/2] << 1;\n      assign narrow_multiple[k] = narrow_multiple[k/2] << 1;\n    end else begin\n      localparam int OFF = \"'$clog2(k + 1);\n      localparam int POP = $countones(k);\n      if (POP == OFF) begin\n        always_ff @(posedge clock)\n          if (phase_q == PREFIX)\n            multiple[k] <= (full_divisor << OFF) - full_divisor;\n        assign narrow_multiple[k] = (narrow_divisor << OFF) - narrow_divisor;\n      end else if (POP == 2) begin\n        always_ff @(posedge clock)\n          if (phase_q == PREFIX)\n            multiple[k] <= (full_divisor << (OFF-1)) + full_divisor;\n        assign narrow_multiple[k] = (narrow_divisor << (OFF-1)) + narrow_divisor;\n      end else begin\n        logic [35:0] p, q, sum_bits, carry_bits;\n        assign p = full_divisor << 3;\n        assign q = full_divisor << ((k == 11) ? 1 : 2);\n        assign sum_bits = p ''^ q ''^ full_divisor;\n        assign carry_bits = ((p & q) | ((p | q) & full_divisor)) << 1;\n        always_ff @(posedge clock)\n          if (phase_q == PREFIX)\n            multiple[k] <= sum_bits + carry_bits;\n        assign narrow_multiple[k] = (narrow_divisor << 3)\n                                   + (narrow_divisor << ((k == 11) ? 1 : 2))\n                                   + narrow_divisor;\n      end\n    end\n  end\n\n  logic [7:0] prefix;\n  logic [3:0] first_qdigit, first_remainder;\n  logic [7:0] next_trial, prefix_remainder;\n  logic [3:0] next_qdigit;\n  logic [16:0] first_borrow, next_borrow;\n  logic [15:0] first_take, next_take;\n  logic [3:0] first_diff [0:15];\n  logic [7:0] next_diff [0:15];\n\n  assign prefix = quotient_bits_q[31:24];\n  assign next_trial = {first_remainder, prefix[3:0]};\n  assign first_borrow[0] = 1'\"'b0;\n  assign first_borrow[16] = 1'b1;\n  assign next_borrow[0] = 1'b0;\n  assign next_borrow[16] = 1'b1;\n\n  assign first_diff[0] = prefix[7:4];\n  assign next_diff[0] = next_trial;\n  for (genvar k = 1; k < 16; k++) begin : gen_prefix\n    logic [7:0] short_divisor, short_multiple;\n    logic [8:0] first_sub;\n    logic [12:0] next_sub;\n    assign short_divisor = {4'b0, divisor_q[3:0]};\n    assign short_multiple = short_divisor * 8'(k);\n    assign first_sub = {5'b0, prefix[7:4]} - {1'b0, short_multiple};\n    assign next_sub = {5'b0, next_trial} - {1'b0, narrow_multiple[k]};\n    assign first_borrow[k] = (|divisor_q[31:4]) | first_sub[8];\n    assign next_borrow[k] = (|divisor_q[31:8]) | next_sub[12];\n    assign first_diff[k] = first_sub[3:0];\n    assign next_diff[k] = next_sub[7:0];\n  end\n\n  assign first_take = ~first_borrow[15:0] & first_borrow[16:1];\n  assign next_take = ~next_borrow[15:0] & next_borrow[16:1];\n  always_comb begin\n    first_qdigit = '0;\n    first_remainder = '0;\n    next_qdigit = '0;\n    prefix_remainder = '0;\n    for (int k = 0; k < 16; k++) begin\n      first_qdigit |= {4{first_take[k]}} & 4'(k);\n      first_remainder |= {4{first_take[k]}} & first_diff[k];\n      next_qdigit |= {4{next_take[k]}} & 4'(k);\n      prefix_remainder |= {8{next_take[k]}} & next_diff[k];\n    end\n  end\n\n  logic [35:0] trial;\n  logic [16:0] borrow;\n  logic [15:0] take;\n  logic [31:0] difference [0:15];\n  logic [31:0] next_remainder;\n  logic [3:0] digit;\n  assign trial = {remainder_bits_q, quotient_bits_q[31:28]};\n  assign borrow[0] = 1'b0;\n  assign borrow[16] = 1'b1;\n  assign difference[0] = trial[31:0];\n\n  for (genvar digit_index = 1; digit_index < 16; digit_index++) begin : gen_digit\n    logic [8:0] g, p;\n    logic [2:0] group_g, group_p;\n    logic [3:0] group_borrow;\n    logic [8:0] slice_borrow;\n\n    for (genvar s = 0; s < 9; s++) begin : gen_slice\n      wire [3:0] x = trial[4*s +: 4];\n      wire [3:0] y = multiple[digit_index][4*s +: 4];\n      assign g[s] = x < y;\n      assign p[s] = x == y;\n      if (s < 8) begin\n        wire [3:0] diff0 = x