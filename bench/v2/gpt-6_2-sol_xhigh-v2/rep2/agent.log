{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/if_stage.sv && sed -n '70,210p' cores/bench/rtl/core.sv && sed -n '1,90p' test/cosim/build.sh && sed -n '320,415p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch with a tagged last-successor predictor. ID sees the\n// raw instruction bus and captures the addressed instruction on accept.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              accept,\n  input  logic              mispredict,\n  input  logic [31:2]       resolved_pc,\n  input  logic              train,\n  input  logic [31:2]       train_pc,\n  output logic              recovering,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;\n  logic [63:0] valid_q;\n  // One asynchronous lookup and one synchronous write. Only the valid\n  // bits need reset, so the tag and successor can map to distributed RAM.\n  logic [53:0] entries [0:63];\n  logic [23:0] tag;\n  logic [31:2] successor;\n  logic        hit;\n\n  assign fetch_pc = recovering ? recovery_pc_q : pc_q;\n  assign {tag, successor} = entries[fetch_pc[7:2]];\n  assign hit = valid_q[fetch_pc[7:2]] && (tag == fetch_pc[31:8]);\n  assign predicted_pc = hit ? successor : fetch_pc + 30'd1;\n\n  always_ff @(posedge clock) begin\n    if (train)\n      entries[train_pc[7:2]] <= {train_pc[31:8], resolved_pc};\n\n    if (reset)\n      valid_q <= '0;\n    else if (train)\n      valid_q[train_pc[7:2]] <= 1'b1;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_q       <= '0;\n      recovering <= 1'b0;\n    end else begin\n      if (accept)\n        pc_q <= predicted_pc;\n      recovering <= mispredict || (recovering && !accept);\n    end\n\n    // Sample the resolved address independently of the comparison.\n    // Once selected, keep it until ID accepts the recovery instruction.\n    if (!recovering)\n      recovery_pc_q <= resolved_pc;\n  end\n\n  assign imem_addr = {fetch_pc, 2'b00};\n  assign out.pc    = imem_addr;\n  assign out.instr = imem_data;\n\nendmodule\n  output logic [3:0]  io_rvfi_mem_wmask_0,\n  output logic [31:0] io_rvfi_mem_rdata_0,\n  output logic [31:0] io_rvfi_mem_\n…[8773 of 11845 chars elided by tools/bench/transcript.py; sha256:d04b0da579fac803]…\nor r in rets] == [0x00, 0x04, 0x20, 0x04, 0x08, 0x0C]\n    fetches = [ia for ia, _, _ in bus]\n    first, second = [i for i, pc in enumerate(fetches) if pc == 0x04]\n    assert fetches[first:first + 3] == [0x04, 0x08, 0x20]\n    assert fetches[second:second + 7] == [0x04, 0x20, 0x08, 0x08, 0x08, 0x08, 0x0C]\n    load, use = rets[3:5]\n    assert load[\"insn\"] == LW(1, 0, 0)\n    assert load[\"pc_next\"] == 0x08 and load[\"rd_wdata\"] == 42\n    assert use[\"rd_wdata\"] == 43 and use[\"cycle\"] == load[\"cycle\"] + 2\n    assert not any(wen for _, _, wen in bus)\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n", "exit_code": 0, "status": "completed"}}
