 MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_acceptance(dut):\n    await _tick(dut)  # result transfer, eight rising edges after capture if ready\n    assert dut.result_valid.value == 0\n    assert dut.request_ready.value == 1\n\n\nasync def _check_unsigned_pair(dut, a, b):\n    quotient, remainder = divmod(a, b) if b else (MA\n…[7602 of 10674 chars elided by tools/bench/transcript.py; sha256:66369e501c2372ef]…\ntters when at least one mask is non-zero. With\n        # both masks 0 (no mem op — common on traps), an addr discrepancy\n        # is meaningless garbage. The trap field itself is checked above.\n        if (ref_rmask | ref_wmask) and ref_addr != sim.get('mem_addr', 0):\n            return _mismatch(i, ref, 'mem_addr', ref_addr, sim.get('mem_addr', 0))\n        # Only compare rdata bytes that are actually read. The reference keeps\n        # sub-word values unshifted; RVFI ALIGNED_MEM reports the full memory word.\n        if ref_rmask:\n            mask_bits = sum(0xFF << (j * 8) for j in range(4) if (ref_rmask >> j) & 1)\n            if (ref_rdata & mask_bits) != (sim.get('mem_rdata', 0) & mask_bits):\n                return _mismatch(i, ref, 'mem_rdata',\n                                 ref_rdata & mask_bits, sim.get('mem_rdata', 0) & mask_bits)\n        # Only compare wdata bytes that are actually written.\n        if ref_wmask:\n            mask_bits = sum(0xFF << (j * 8) for j in range(4) if (ref_wmask >> j) & 1)\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nimport shutil\nroot=Path(gettempdir())/'bench-r8s0'\npath=root/'late-load-branch'/'rtl'\nshutil.copytree(root/'load-branch-eq'/'rtl',path,dirs_exist_ok=True)\n\np=path/'ex_stage.sv'\ns=p.read_text()\ns=s.replace('  output logic               train,','''  output logic               train,\n  output logic               late_valid,\n  output logic               late_miss,\n  output logic               late_train,\n  output logic               late_take,''')\ns=s.replace('BR_BEQ:  branch_cond = (branch_rs1 == branch_rs2);','BR_BEQ:  branch_cond = (rs1 == rs2);')\ns=s.replace('BR_BNE:  branch_cond = (branch_rs1 \"'!= branch_rs2);'\"','BR_BNE:  branch_cond = (rs1 \"'!= rs2);'\"')\ns=s.replace('  assign mispredict       = ex_advance && (fence_i || \"'!successor_match);'\"', '  assign mispredict       = ex_advance && \"'!late_branch && (fence_i || !successor_match);'\"')\ns=s.replace('  assign train            = side_effects && (in.ctrl.is_branch || in.ctrl.is_jump);', '''  assign train            = side_effects && \"'!late_branch && (in.ctrl.is_branch || in.ctrl.is_jump);\n\n  logic late_branch;\n  logic late_eq_q, late_ne_q, late_align_q, late_rel_match_q, late_seq_match_q;\n  logic late_condition, late_fault;\n  logic [31:2] late_relative_q, late_sequential_q;\n\n  assign late_branch = in.ctrl.is_branch && !in.ctrl.branch_op[2] && fwd_ex_is_load &&\n                       (fwd_rs1_sel[2] || fwd_rs2_sel[2]);\n  assign late_condition = late_eq_q ''^ late_ne_q;\n  assign late_take = late_condition && late_align_q;\n  assign late_fault = late_condition && !late_align_q;\n  assign late_train = late_valid && !late_fault;\n  assign late_miss = late_valid && !(late_take ? late_rel_match_q : late_seq_match_q);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      late_valid <= 1'\"'b0;\n    end else begin\n      late_valid <= ex_advance && late_branch;\n    end\n    late_eq_q <= branch_rs1 == branch_rs2;\n    late_ne_q <= in.ctrl.branch_op[0];\n    late_align_q <= relative_aligned;\n    late_rel_match_q <= relative_target == next_issue_pc;\n    late_seq_match_q <= pc_plus4 == next_issue_pc;\n    late_relative_q <= relative_target[31:2];\n    late_sequential_q <= pc_plus4[31:2];\n  end''')\ns=s.replace('  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    if (late_valid) begin\n      out.ctrl.is_illegal = late_fault;\n      out.pc_next = {late_take ? late_relative_q : late_sequential_q, 2'b00};\n    end\n  end''')\np.write_text(s)\n\np=path/'core.sv'\ns=p.read_text()\ns=s.replace('  logic        mispredict, recovering, train, take_target;', '  logic        mispredict, recovering, train, take_target;\\\\n  logic        late_valid, late_miss, late_train, late_take;')\ns=s.replace('    .mispredict      (mispredict),','''    .mispredict      (mispredict),\n    .late_valid      (late_valid),\n    .late_miss       (late_miss),\n    .late_train      (late_train),\n    .late_take       (late_take),''')\ns=s.replace('    .mispredict           (mispredict),','''    .mispredict           (mispredict),\n    .late_valid           (late_valid),\n    .late_miss            (late_miss),\n    .late_train           (late_train),\n    .late_take            (late_take),''')\np.write_text(s)\n\np=path/'if_stage.sv'\ns=p.read_text()\ns=s.replace('  input  logic              mispredict,','''  input  logic              mispredict,\n  input  logic              late_valid,\n  input  logic              late_miss,\n  input  logic              late_train,\n  input  logic              late_take,''')\ns=s.replace('  logic        take_target_q, train_q, target_pending_q;', '''  logic        take_target_q, train_q, target_pending_q;\n  logic        target_pending_hold_q, recovering_hold_q;''')\ns=s.replace('  assign recovery_pc = take_target_q ? target_pc_q : sequen