 dividend - quotient * divisor)\n            await _check_acceptance(dut)\n\n\n@cocotb.test()\nasync def adjacent_to_exact_multiples(dut):\n    await _setup(dut)\n    for divisor in (1, 3, 7, 15, 16, 17, 255, 256, 257, 0x10001, 0x10000001, 0x80000000):\n        for quotient in (1, 15, 16, 17, 0x12345, MASK32 // divisor):\n            for delta in (-1, 0, 1):\n                a = divisor * quotient + delta\n                if a <= MASK32:\n                    await _check_unsigned_pair(dut, a, divisor)\n\n\n@cocotb.test()\nasync def mixed_magnitudes(dut):\n    await _setup(dut)\n    rng = random.Random(4)\n    for width in range(1, 33):\n        for _ in range(2):\n            a = rng.getrandbits(32)\n            b = rng.getrandbits(width) | (1 << (width - 1))\n            signed_a = a - (1 << 32) if a >> 31 else a\n            signed_b = b - (1 << 32) if b >> 31 else b\n            if width < 32 and rng.getrandbits(1):\n                signed_b = -signed_b\n            quotient = abs(signed_a) // abs(signed_b)\n            if (signed_a < 0) != (signed_b < 0):\n                quotient = -quotient\n            for vector in (\n                (ALU_DIVU, a, b, a // b),\n                (ALU_REMU, a, b, a % b),\n                (ALU_DIV, signed_a, signed_b, quotient),\n                (ALU_REM, signed_a, signed_b, signed_a - quotient * signed_b),\n            ):\n                await _check_result(dut, *vector)\n                await _check_acceptance(dut)\n\n\n@cocotb.test()\nasync def deferred_acceptance(dut):\n    await _setup(dut, result_ready=0)\n","exit_code":0,"status":"completed"}}
