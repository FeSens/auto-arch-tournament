ned imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b0\n…[9935 of 13007 chars elided by tools/bench/transcript.py; sha256:f64ebc8ec86f2e13]…\nriscv-formal fast suite (with ALTOPS)\"\n106:test:\n109:test-infra:\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n121:formal:\n129:formal-deep:\n136:# (tools/eval/gowin.py); V2 does not synthesize with Yosys.\n140:timing:\n141:\tpython3 -m tools.eval.gowin $(TARGET)\n162:\t  [ -e \"$(WT_PATH)/formal/riscv-formal\" ] || ln -s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 45.18\n  lut4: 2971\n  ff: 632\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261120-001-r1s0\n  updated: '2026-11-20T02:53:55.975416Z'\n", "exit_code": 0, "status": "completed"}}
