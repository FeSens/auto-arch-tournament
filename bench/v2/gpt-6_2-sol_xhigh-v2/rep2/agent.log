{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'trial=\"$TMPDIR/bench-predictor.k3uYFP\"\ncat > \"$trial/profile.cpp\" <<'\"'CPP'\n#include <cstdint>\n#include <fstream>\n#include <iomanip>\n#include <iostream>\n#include <map>\n#include <string>\n#include <vector>\nstruct Record { uint32_t pc, next, instruction; };\nstruct Entry {\n    uint32_t pc = ~0u, target = 0;\n    bool branch = false;\n    int direction = 1;\n    unsigned local = 0;\n};\nstruct Count { unsigned miss = 0, missOnRecovery = 0, b = 0, j = 0, i = 0, other = 0, cold = 0; };\n\nvoid profile(const std::vector<Record>& records, unsigned width, bool hashed,\n             bool last, unsigned globalBits, bool cold, unsigned localBits) {\n    std::vector<Entry> btb(1u << width);\n    std::vector<int> global(1u << globalBits, 1);\n    std::vector<int> local(1u << (width + localBits), 1);\n    const unsigned mask = btb.size() - 1;\n    const unsigned globalMask = global.size() - 1;\n    const unsigned localMask = (1u << localBits) - 1;\n    unsigned history = 0;\n    Count count;\n    bool recovering = false;\n    for (const auto& record : records) {\n        const unsigned op = record.instruction & 127;\n        const bool branch = op == 99, direct = op == 111, indirect = op == 103;\n        const bool taken = record.next \"'!= record.pc + 4;\n        const unsigned word = record.pc >> 2;\n        const unsigned idx = (word ''^ (hashed ? word >> width : 0)) & mask;\n        auto& entry = btb[idx];\n        const auto hit = entry.pc == record.pc;\n        const auto globalIndex = (word ''^ history) & globalMask;\n        const auto localIndex = idx << localBits | entry.local;\n        const bool vote =\n            globalBits ? global[globalIndex] >= 2 :\n            localBits ? local[localIndex] >= 2 : entry.direction >= 2;\n        const auto target = (hit && (last || !entry.branch || vote)) ?\n            entry.target : record.pc + 4;\n        count.cold += recovering && target != record.pc+4;\n        auto predicted = (cold && recovering) ? record.pc+4 : target;\n        const bool miss = predicted != record.next;\n        if (miss) {\n            count.miss++;\n            count.missOnRecovery += recovering;\n            count.b += branch;\n            count.j += direct;\n            count.i += indirect;\n            count.other += !branch && !direct && !indirect;\n        }\n        recovering = miss;\n        if (branch || direct || indirect) {\n            if (last || taken) {\n                entry.pc = (last || ((record.pc ''^ record.next) >> 16) == 0) ? record.pc : ~0u;\n                entry.target = record.next;\n                entry.branch = branch;\n            }\n        }\n        if (branch) {\n            auto update = [taken](int& n) {\n                if (taken && n < 3) ++n;\n                if (!taken && n > 0) --n;\n            };\n            update(entry.direction);\n            update(global[globalIndex]);\n            update(local[localIndex]);\n            history = (history << 1 | taken) & globalMask;\n            entry.local = (entry.local << 1 | taken) & localMask;\n        }\n    }\n    std::cout << \"index \" << width << (hashed ? \" xor\" : \" seq\") << (last ? \" last\" : \" target\")\n              << (cold ? \" cold\" : \" hot\") << \" G\" << globalBits << \" L\" << localBits\n              << \"  misses \" << count.miss << \" b/j/i \" << count.b << '\"'/' << count.j << '/' << count.i\n              << \\\" redirects after recovery \\\" << count.missOnRecovery << '\\\\n';\n}\nint main(int argc, char** argv) {\n    std::ifstream stream(argv[1], std::ios::binary);\n    std::vector<Record> records;\n    for (Record r; stream.read(reinterpret_cast<char*>(&r), sizeof r);) records.push_back(r);\n    profile(records, 6, false, true, 0, false, 0);\n    for (bool cold : {false, true}) {\n        for (unsigned i : {6, 7, 8, 9, 10}) {\n            for (bool hashed : {false, true}) profile(records, i, hashed, false, 0, cold, 0);\n        }\n        for (unsigned history : {4, 6, 8, 10}) profile(records, 7, true, false, history, cold, 0);\n        for (unsigned history : {1, 2, 3, 4}) profile(records, 7, true, false, 0, cold, history);\n    }\n}\nCPP\ng++ -O3 -o \\\"\"'$trial/profile\" \"$trial/profile.cpp\" &&\n\"$trial/profile\" \"$trial/retire.bin\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
