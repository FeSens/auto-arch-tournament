{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r11-veprb4la/mul_mem.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path(__file__).resolve().parent\nchampion = Path('cores/bench/rtl')\nvariants = [('mul-mem', champion), ('mul-mem-recovery', root/'split-miss'),\n            ('mul-mem-timed', root/'early-forward-split')]\nfor variant, src in variants:\n    dst=root/variant\n    shutil.copytree(src, dst)\n    p=dst/'core.sv'\n    s=p.read_text()\n    s=s.replace('  logic       m_wait, ex_valid;', '  logic       m_wait, ex_valid;\\\\n  logic [31:0] low_mul_result;')\n    s=s.replace('    .m_wait               (m_wait),','    .m_wait               (m_wait),\\\\n    .low_mul_result       (low_mul_result),')\n    s=s.replace('    .in         (ex_mem_w),','    .in         (ex_mem_w),\\\\n    .low_mul_result (low_mul_result),')\n    s=s.replace('.id_ex_mem_read (id_ex_w.ctrl.mem_read)', '.id_ex_late_result (id_ex_w.ctrl.mem_read || id_ex_w.ctrl.alu_op == ALU_MUL)')\n    p.write_text(s)\n    p=dst/'ex_stage.sv'\n    s=p.read_text()\n    s=s.replace('  output logic               m_wait,', '  output logic [31:0]        low_mul_result,\\\\n  output logic               m_wait,')\n    s=s.replace('  logic        is_mul, mul_request,', '  logic        is_low_mul, mem_low_mul;\\\\n  logic        is_mul, mul_request,')\n    s=s.replace('  assign is_mul = in.ctrl.alu_op == ALU_MUL ||', '''  assign is_low_mul = in.ctrl.alu_op == ALU_MUL;\n  assign mem_low_mul = out.valid && out.ctrl.alu_op == ALU_MUL;\n  assign low_mul_result = mul_result;\n  assign is_mul = is_low_mul ||''')\n    s=s.replace('  assign m_wait = m_active && ((is_mul && \"'!mul_result_valid) || (is_div && !div_result_valid));'\"', '''  assign m_wait = m_active && ((is_low_mul && \"'!mul_request_ready) ||\n                 (is_mul && !is_low_mul && (!mul_result_valid || mem_low_mul)) ||\n                 (is_div && !div_result_valid));'\"''')\n    s=s.replace('.result_ready  (mul_request),', '.result_ready  (mem_low_mul || (mul_request && \"'!is_low_mul)),'\"')\n    s=s.replace('({32{is_mul}} & mul_result)', '({32{is_mul && \"'!is_low_mul}} & mul_result)'\"')\n    s=s.replace('(is_mul || is_div) ? m_rs', '((is_mul && \"'!is_low_mul) || is_div) ? m_rs'\"')\n    p.write_text(s)\n    p=dst/'mem_stage.sv'\n    s=p.read_text()\n    s=s.replace('  input  ex_mem_t  in,','  input  ex_mem_t  in,\\\\n  input  logic [31:0]        low_mul_result,')\n    s=s.replace('reg_q.write_result <= in.ctrl.mem_to_reg ? load_data : in.alu_result;', '''reg_q.write_result <= ({32{in.ctrl.mem_to_reg}} & load_data) |\n                            ({32{in.ctrl.alu_op == ALU_MUL}} & low_mul_result) |\n                            ({32{\"'!in.ctrl.mem_to_reg && in.ctrl.alu_op != ALU_MUL}} & in.alu_result);'\"''')\n    p.write_text(s)\n    p=dst/'hazard_unit.sv'\n    s=p.read_text().replace('id_ex_mem_read', 'id_ex_late_result')\n    p.write_text(s)\n    p=dst/'mul_unit.sv'\n    s=p.read_text().replace('assign request_ready = (phase_q == IDLE);', '''assign request_ready = (phase_q == IDLE) ||\n                         (phase_q == PRODUCTS && \"'!high_half_q && result_ready);'\"''')\n    p.write_text(s)\nPY\npython \\\"\"'$TMPDIR/bench-r11-veprb4la/mul_mem.py\"\npython - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path('/srv/hwebench/tmp/4876824c/bf7d2cca/bench-r11-veprb4la')\nvariants = ('mul-mem', 'mul-mem-recovery', 'mul-mem-timed')\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    futs = [(name, executor.submit(build_all, Path.cwd(), root / name, 'fpga/core_bench_si.sv', root / ('gowin-' + name))) for name in variants]\n    for name, fut in futs:\n        records = fut.result()\n        print(name, summarize(records), flush=True)\n        print([(r['place_option'], [(p['from'], p['to']) for p in r.get('critical_paths', [])[:3]]) for r in records], flush=True)\nPY\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
