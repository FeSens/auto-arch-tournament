{"type": "item.started", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/bash -c \"cp -r \\\"/srv/hwebench/tmp/4876824c/28c89be3/bench-r12.BVKrzn/rtl-mul-b\\\" \\\"/srv/hwebench/tmp/4876824c/28c89be3/bench-r12.BVKrzn/rtl-mul-c\\\"\ncat > \\\"/srv/hwebench/tmp/4876824c/28c89be3/bench-r12.BVKrzn/onehot.py\\\" <<'PY'\nimport sys\nfrom pathlib import Path\nrtl = Path(sys.argv[1])\n\ndef edit(file, changes):\n    path = rtl / file\n    source = path.read_text()\n    for a, b in changes:\n        assert a in source, (file, a)\n        source = source.replace(a,b,1)\n    path.write_text(source)\n\nops = {\n    'ADD': 'a + b',\n    'SUB': 'a - b',\n    'AND': 'a & b',\n    'OR': 'a | b',\n    'XOR': 'a \"'^ b'\"',\n    'SLT': \\\"{31'b0, \"'$signed(a) < $signed(b)}\",\n    '\"'SLTU': \\\"{31'b0, a < b}\\\",\n    'SLL': 'a << shamt',\n    'SRL': 'a >> shamt',\n    'SRA': '\"'$unsigned($signed(a) >>> shamt)'\"',\n    'LUI': 'b',\n}\n(rtl / 'alu.sv').write_text('''module alu (\n  input  logic [10:0] enable,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n  logic [4:0] shamt;\n  assign shamt = b[4:0];\n  assign out = ''' + ' |\\\\n               '.join(f'({{32{{enable[ALU_{op}]}}}} & ({term}))' for op,term in ops.items()) + ';\\\\nendmodule\\\\n')\nedit('core_pkg.sv', [\n    ('logic [31:0] imm;','logic [31:0] imm;\\\\n    logic [10:0] alu_enable;\\\\n    logic [31:0] alu_base_a, alu_base_b;\\\\n    logic alu_a_from_pc, alu_b_from_imm;'),\n])\nedit('id_stage.sv', [\n    ('input  logic [4:0]        ex_mem_rd,','''input  logic [4:0]        ex_mem_rd,\n  input  logic              next_ex_mem_wen,\n  input  logic              next_mem_wb_wen,\n  output logic [2:0]        alu_a_sel,\n  output logic [2:0]        alu_b_sel,'''),\n    ('output logic [1:0]        match_ex_mem,\\\\n  output logic [1:0]        match_mem_wb','output logic [2:0]        fwd_rs1,\\\\n  output logic [2:0]        fwd_rs2'),\n    ('  id_ex_t reg_q;','''  id_ex_t reg_q;\n  logic [10:0] alu_enable;\n  logic [1:0] match_ex_mem, match_mem_wb;\n  logic [2:0] next_rs1, next_rs2;\n  assign match_ex_mem[0] = next_ex_mem_wen && reg_q.rd \"'!= 5'\"'b0 && rs1_addr == reg_q.rd;\n  assign match_ex_mem[1] = next_ex_mem_wen && reg_q.rd \"'!= 5'\"'b0 && rs2_addr == reg_q.rd;\n  assign match_mem_wb[0] = next_mem_wb_wen && ex_mem_rd \"'!= 5'\"'b0 && rs1_addr == ex_mem_rd;\n  assign match_mem_wb[1] = next_mem_wb_wen && ex_mem_rd \"'!= 5'\"'b0 && rs2_addr == ex_mem_rd;\n  assign next_rs1 = {match_ex_mem[0], \"'!match_ex_mem[0] && match_mem_wb[0], !match_ex_mem[0] && !match_mem_wb[0]};\n  assign next_rs2 = {match_ex_mem[1], !match_ex_mem[1] && match_mem_wb[1], !match_ex_mem[1] && !match_mem_wb[1]};\n  for (genvar i=0; i < 11; i++) begin : gen_enable\n    assign alu_enable[i] = dec_alu_op == 5'\"'(i) && \"'!dec_is_jump;\n  end'\"'''),\n    (\\\"      match_ex_mem <= '0;\\\\n      match_mem_wb <= '0;\\\",'''      fwd_rs1 <= 3'b001;\n      fwd_rs2 <= 3'b001;\n      alu_a_sel <= 3'b001;\n      alu_b_sel <= 3'b001;'''),\n    ('      reg_q.imm      <= imm;', '''      reg_q.imm      <= imm;\n      reg_q.alu_enable <= alu_enable;\n      reg_q.alu_base_a <= dec_is_auipc ? in.pc : rs1_data;\n      reg_q.alu_base_b <= dec_alu_src ? imm : rs2_data;'''),\n    ('''      match_ex_mem[0] <= (reg_q.rd \"'!= 5'\"'b0) && (rs1_addr == reg_q.rd);\n      match_ex_mem[1] <= (reg_q.rd \"'!= 5'\"'b0) && (rs2_addr == reg_q.rd);\n      match_mem_wb[0] <= (ex_mem_rd \"'!= 5'\"'b0) && (rs1_addr == ex_mem_rd);\n      match_mem_wb[1] <= (ex_mem_rd \"'!= 5'\"'b0) && (rs2_addr == ex_mem_rd);''','''      fwd_rs1 <= next_rs1;\n      fwd_rs2 <= next_rs2;\n      alu_a_sel <= dec_is_auipc ? 3'b001 : next_rs1;\n      alu_b_sel <= dec_alu_src ? 3'b001 : next_rs2;''')\n])\nex = (rtl/'ex_stage.sv').read_text()\nstart = ex.index('  // Include PC and immediate')\nend = ex.index('  logic [31:0] alu_result;', start)\nedit('ex_stage.sv', [\n    ('  output logic               ex_valid,','''  input  logic [2:0]         alu_a_sel, alu_b_sel,\n  output logic               next_ex_mem_wen,\n  output logic               ex_valid,'''),\n    (ex[start:end], '''  assign alu_a = ({32{alu_a_sel[2]}} & fwd_ex_mem) |\n                 ({32{alu_a_sel[1]}} & fwd_mem_wb) |\n                 ({32{alu_a_sel[0]}} & in.alu_base_a);\n  assign alu_b = ({32{alu_b_sel[2]}} & fwd_ex_mem) |\n                 ({32{alu_b_sel[1]}} & fwd_mem_wb) |\n                 ({32{alu_b_sel[0]}} & in.alu_base_b);\n\n'''),\n    ('.op  (in.ctrl.alu_op),','.enable (in.alu_enable),'),\n    ('logic        is_alu_result, m_active;', 'logic        m_active;'),\n    ('  assign is_alu_result = \"'!(is_low_mul || is_mul || is_div || in.ctrl.is_jump);'\"\\\\n',''),\n    ('// ── EX/MEM register','assign next_ex_mem_wen = ctrl_out.reg_write;\\\\n\\\\n  // ── EX/MEM register'),\n    ('({32{is_alu_result}} & alu_result)', 'alu_result'),\n])\nedit('mem_stage.sv',[\n    ('output mem_wb_t  out','output mem_wb_t  out,\\\\n  output logic next_mem_wb_wen'),\n    ('  assign out = reg_q;','  assign out = reg_q;\\\\n  assign next_mem_wb_wen = ctrl_with_trap.reg_write;'),\n])\ncore = (rtl/'core.sv').read_text()\nstart = core.index('  forward_unit u_fwd')\nend = core.index('  // ── RVFI',start)\nedit('core.sv', [\n    ('logic [1:0] match_ex_mem, match_mem_wb;', 'logic next_ex_mem_wen, next_mem_wb_wen;\\\\n  logic [2:0] alu_a_sel, alu_b_sel;'),\n    ('''.match_ex_mem (match_ex_mem),\n    .match_mem_wb (match_mem_wb)''','''.next_ex_mem_wen (next_ex_mem_wen),\n    .next_mem_wb_wen (next_mem_wb_wen),\n    .fwd_rs1 (fwd_rs1_sel),\n    .fwd_rs2 (fwd_rs2_sel),\n    .alu_a_sel (alu_a_sel),\n    .alu_b_sel (alu_b_sel)'''),\n    ('.ex_valid             (ex_valid),','''.ex_valid             (ex_valid),\n    .next_ex_mem_wen      (next_ex_mem_wen),\n    .alu_a_sel            (alu_a_sel),\n    .alu_b_sel            (alu_b_sel),'''),\n    ('.out        (mem_wb_w)', '.out        (mem_wb_w),\\\\n    .next_mem_wb_wen (next_m