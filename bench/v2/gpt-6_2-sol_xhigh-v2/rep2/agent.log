{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -c \"R8_LOOK='/srv/hwebench/tmp/4876824c/7a4a8d78/r8s1-lookahead.m3ahotnc' python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nroot=Path(os.environ['R8_LOOK'])\nfor size in (512,1024,2048):\n    source=root/f'{min(size,1024)}_enable'\n    variant=root/f'{size}_drop'\n    variant.mkdir()\n    target=variant/'cores'/'bench'\n    target.mkdir(parents=True)\n    for directory in ('rtl','test'):\n      shutil.copytree(source/'cores'/'bench'/directory,target/directory)\n    shutil.copy(source/'cores'/'bench'/'core.yaml',target)\n    for directory in ('fpga','bench','test'):\n      shutil.copytree(source/directory,variant/directory)\n    shutil.copy(source/'Makefile',variant)\n    p=target/'rtl'/'if_stage.sv'\n    s=p.read_text()\n    s=s.replace('replay_read_q, bypass_entry_q, replay_entry, write_entry','replay_read_q, write_entry')\n    s=s.replace('  assign replay_entry = (write_enable_q && write_index_q == pc_q[INDEX_BITS+1:2]) ? bypass_entry_q : replay_read_q;\\\\n','')\n    s=s.replace('replay_entry[','replay_read_q[')\n    s=s.replace('&& replay_read_q[ENTRY_BITS-1]','&& \"'!(write_enable_q && write_index_q == pc_q[INDEX_BITS+1:2])'\"\\\\n                         && replay_read_q[ENTRY_BITS-1]')\n    s=s.replace('      bypass_entry_q <= write_entry;\\\\n','')\n    if size==2048:\n        s=s.replace('INDEX_BITS = 10','INDEX_BITS = 11').replace('replay_entries [0:1023]','replay_entries [0:2047]')\n    p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
