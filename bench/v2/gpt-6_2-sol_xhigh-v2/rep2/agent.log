gn late_mispredict = ex_mem_w.valid && ex_mem_w.late_branch &&\n                           !(branch_target_selected ? ex_mem_w.branch_relative_match :\n                                                      ex_mem_w.branch_sequential_match);\n  assign late_train = ex_mem_w.valid && ex_mem_w.late_branch && !branch_misaligned;\n\n  always_comb begin\n    mem_input = ex_mem_w;\n    if (ex_mem_w.late_branch) begin\n      mem_input.pc_next = {late_next_pc, 2'\"'b00};\n      mem_input.ctrl.is_illegal = branch_misaligned;\n      if (ex_mem_w.branch_load_a)\n        mem_input.rs1_val = wb_w_data;\n      if (ex_mem_w.branch_load_b)\n        mem_input.rs2_val = wb_w_data;\n    end\n  end\n\n  // ── EX''')\n    s = s.replace('    .next_issue_pc        (if_id_w.pc),','''    .next_issue_pc        (if_id_w.pc),\n    .mem_load             (io_dmemREn),\n    .late_mispredict      (late_mispredict),''')\n    s = s.replace('    .in         (ex_mem_w),', '    .in         (mem_input),')\n    s = s.replace('.id_ex_mem_read (id_ex_w.ctrl.mem_read)', '.id_ex_mem_read (id_ex_w.ctrl.mem_read && \"'!fast_branch)'\"')\n    s = s.replace('.ex_mem_w_en  (ex_mem_w.ctrl.reg_write)', '.ex_mem_w_en  (ex_mem_w.ctrl.reg_write && (\"'!ex_mem_w.ctrl.mem_read || io_dmemREn))'\"')\n    return s\namend('core',core)\n\ndef fetch(s):\n    s = s.replace('  input  logic              mispredict,','''  input  logic              mispredict,\n  input  logic              late_mispredict,\n  input  logic              late_train,\n  input  logic [31:2]       late_train_pc,\n  input  logic [31:2]       late_next_pc,''')\n    s = s.replace('  logic [31:2] pc_q, recovery_pc, fetch_pc, predicted_pc;', '''  logic [31:2] pc_q, recovery_pc, front_pc, fetch_pc, predicted_pc;\n  logic [31:2] late_train_next_q;\n  logic train_late_q;''')\n    s = s.replace('  assign fetch_pc =', '  assign front_pc =')\n    s = s.replace('  assign {tag, successor}', '  assign fetch_pc = late_mispredict ? late_next_pc : front_pc;\\\\n  assign {t