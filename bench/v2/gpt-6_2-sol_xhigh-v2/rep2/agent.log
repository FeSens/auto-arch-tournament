& fwd_mem_wb) |\n                      ({32{fwd_rs2_sel[0]}} & in.rs2_val);'\"''')\n    start=s.index('    case (in.ctrl.branch_op)')\n    end=s.index('    endcase',start)\n    new=s[start:end].replace('rs1','branch_rs1').replace('rs2','branch_rs2')\n    if eq_only:\n        new=new.replace('signed(branch_rs1)','signed(rs1)').replace('signed(branch_rs2)','signed(rs2)')\n        new=new.replace('branch_rs1 <  branch_rs2','rs1 <  rs2').replace('branch_rs1 >= branch_rs2','rs1 >= rs2')\n    s=s[:start]+new+s[end:]\n    s=s.replace('? m_rs1_q : rs1;', '? m_rs1_q : (in.ctrl.is_branch ? branch_rs1 : rs1);')\n    s=s.replace('? m_rs2_q : rs2;', '? m_rs2_q : (in.ctrl.is_branch ? branch_rs2 : rs2);')\n    p.write_text(s)\n    p = path / 'core.sv'\n    s = p.read_text()\n    s = s.replace('  logic       m_wait, ex_valid;', '  logic       m_wait, ex_valid;\\\\n  logic [31:0] early_load_value;\\\\n  logic       early_load_aligned;')\n    s = s.replace('    .fwd_ex_mem           (', '    .load_value           (early_load_value),\\\\n    .fwd_ex_is_load       (ex_mem_w.ctrl.mem_read),\\\\n    .fwd_ex_mem           (')\n    s = s.replace('    .dmem_ren   (io_dmemREn),', '    .dmem_ren   (io_dmemREn),\\\\n    .load_value (early_load_value),\\\\n    .load_aligned (early_load_aligned),')\n    early_condition = \\\"if_id_w.instr[6:0] == 7'b1100011\\\"\n    if eq_only:\n        early_condition += \\\" && if_id_w.instr[14:13] == 2'b00\\\"\n    s = s.replace('    .id_ex_rd       (id_ex_w.rd),',f'    .id_ex_rd       (id_ex_w.rd),\\\\n    .early_branch   ({early_condition}),')\n    s = s.replace('    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write),', '    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write && early_load_aligned),')\n    # A current misaligned store never had a forwarding write enable.\n    p.write_text(s)\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom tools.eval.gowin import build_all, summarize\nworktree = Path.cwd()\nfor name in ('load-branch-eq', 'lo