{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"\npython - <<'PY'\nimport os, shutil, tempfile\nfrom pathlib import Path\nparent=Path(tempfile.mkdtemp(prefix='r8s1-lanes.',dir=os.environ['TMPDIR']))\nfor variant in ('jalr','all'):\n    root=parent/variant\n    dst=root/'cores/bench'\n    dst.mkdir(parents=True)\n    shutil.copytree('cores/bench/rtl',dst/'rtl')\n    shutil.copy('cores/bench/core.yaml',dst)\n    shutil.copytree('fpga',root/'fpga')\n    p=dst/'rtl/ex_stage.sv'\n    s=p.read_text()\n    s=s.replace('logic [31:0] pc_plus4, relative_target, jalr_target;', 'logic [31:0] pc_plus4, relative_target;')\n    s=s.replace(\\\"  assign jalr_target     = {rs1_plus_imm[31:1], 1'b0};\\\\n\\\", '')\n    s=s.replace('jalr_target[31:2]', 'rs1_plus_imm[31:2]')\n    s=s.replace('\"'!rs1_plus_imm[1]'\"', \\\"((rs1[1:0] + in.imm[1:0]) < 2'd2)\\\")\n    start=s.index('  // Compare each candidate')\n    end=s.index('  assign fence_i',start)\n    s=s[:start]+\\\"\\\"\\\"  logic [31:1] required_jalr, outgoing_jalr, check_jalr;\n  assign required_jalr = rs1[31:1] \"'^ in.imm[31:1] ''^ next_issue_pc[31:1];\n  assign outgoing_jalr[1] = rs1[0] & in.imm[0];\n  for (genvar bit_index = 2; bit_index < 32; bit_index++) begin : gen_jalr_check\n    localparam int PREV = bit_index - 1;\n    assign outgoing_jalr[bit_index] = (rs1[PREV] ''^ in.imm[PREV])\n                                    ? !next_issue_pc[PREV] : rs1[PREV];\n  end\n  assign check_jalr = required_jalr ''^~ outgoing_jalr;\n\n  // The FIFO and the fetch address always present a word-aligned next PC.\n  assign successor_match = (use_jalr       && (&check_jalr)) ||\n                           (use_relative   && relative_target == next_issue_pc) ||\n                           (use_sequential && pc_plus4 == next_issue_pc);\n\"\"\"+s[end:]\n    if variant=='\"'all':\n        # The common sequential successor can be checked as a word address.\n        extra=\\\"\\\"\\\"  logic [31:2] required_relative, outgoing_relative, check_relative;\n  logic [31:2] required_seq, outgoing_seq, check_seq;\n  assign required_relative = in.pc[31:2] \"'^ in.imm[31:2] ''^ next_issue_pc[31:2];\n  assign required_seq = in.pc[31:2] ''^ next_issue_pc[31:2] ''^ 30'\"'d1;\n  assign outgoing_relative[2] = 1'b0;\n  assign outgoing_seq[2] = 1'b0;\n  assign outgoing_seq[3] = \"'!next_issue_pc[2];\n  for (genvar bit_index = 3; bit_index < 32; bit_index++) begin : gen_relative_check\n    localparam int PREV = bit_index - 1;\n    assign outgoing_relative[bit_index] = (in.pc[PREV] ''^ in.imm[PREV])\n                                        ? !next_issue_pc[PREV] : in.pc[PREV];\n    if (bit_index != 3) begin : gen_sequential_check\n      assign outgoing_seq[bit_index] = in.pc[PREV] && !next_issue_pc[PREV];\n    end\n  end\n  assign check_relative = required_relative ''^~ outgoing_relative;\n  assign check_seq = required_seq ''^~ outgoing_seq;\n\n\"\"\"\n        s=s.replace('\"'  // The FIFO',extra+'  // The FIFO')\n        s=s.replace('relative_target == next_issue_pc','(&check_relative)').replace('pc_plus4 == next_issue_pc','(&check_seq)')\n    p.write_text(s)\nprint(parent)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
