{"type": "item.started", "item": {"id": "item_40", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r13-lanes.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp,gettempdir\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all\n\nchamp = Path('cores/bench/rtl')\nsplit_int = next(Path(gettempdir()).glob('bench-r13-register_integer_lane-*')) / 'rtl'\n\n\ndef edit(rtl, name, before, after):\n    path = rtl / name\n    t = path.read_text()\n    assert t.count(before) == 1, (name, before, t.count(before))\n    path.write_text(t.replace(before, after))\n\n\ndef setup(rtl, variant):\n    if variant == 'arithmetic' or variant == 'arithmetic_and_shifts':\n        ops = ('ALU_ADD', 'ALU_SUB')\n        if variant == 'arithmetic_and_shifts':\n            ops += ('ALU_SLL', 'ALU_SRL', 'ALU_SRA')\n        for op in ops:\n            path = rtl / 'alu.sv'\n            t = path.read_text()\n            lines = t.splitlines()\n            match = next(l for l in lines if l.strip().startswith(op+':'))\n            path.write_text(t.replace(match, ''))\n        terms = {'ALU_ADD': '(rs1 + alu_b)', 'ALU_SUB': '(rs1 - alu_b)',\n                 'ALU_SLL': '(rs1 << alu_b[4:0])', 'ALU_SRL': '(rs1 >> alu_b[4:0])',\n                 'ALU_SRA': '\"'$unsigned($signed(rs1) >>> alu_b[4:0])'\"'}\n        late = ' |\\\\n                              '.join(f'({{32{{in.ctrl.alu_op == {op} && is_alu_result}}}} & {terms[op]})' for op in ops)\n        edit(rtl, 'ex_stage.sv', 'reg_q.integer_result <= {32{is_alu_result}} & alu_result;', 'reg_q.integer_result <= '+late+';')\n        edit(rtl, 'ex_stage.sv', 'reg_q.alu_result    <= ({32{in.ctrl.is_jump}}', 'reg_q.alu_result    <= ({32{is_alu_result}} & alu_result) |\\\\n                             ({32{in.ctrl.is_jump}}')\n    if variant == 'int_and_pc':\n        edit(rtl, 'ex_stage.sv', '''reg_q.integer_result <= {32{is_alu_result}} & alu_result;\n      reg_q.alu_result    <= ({32{in.ctrl.is_jump}} & pc_plus4) |\n                             ({32{in.ctrl.is_auipc}} & relative_target) |''', '''reg_q.integer_result <= ({32{is_alu_result}} & alu_result) |\n                              ({32{in.ctrl.is_jump}} & pc_plus4) |\n                              ({32{in.ctrl.is_auipc}} & relative_target);\n      reg_q.alu_result    <= ''')\n    if variant in ('int_early', 'int_early_and_link', 'onehot'):\n        p=rtl/'alu.sv'\n        t=p.read_text()\n        terms=dict(zip(('ADD', 'SUB', 'AND', 'OR', 'XOR', 'SLT', 'SLTU', 'SLL', 'SRL', 'SRA', 'LUI'), ('a + b','a - b','a & b','a | b','a \"'^ b'\"',\\\"{31'b0, \"'$signed(a) < $signed(b)}\", \"{31'\"'b0, a < b}\\\",'a << b[4:0]','a >> b[4:0]','\"'$unsigned($signed(a) >>> b[4:0])'\"','b')))\n        enc='\\\\n'.join(f'  assign sel[{i}] = op == ALU_{op};' for i, op in enumerate(terms))\n        masked=' |\\\\n               '.join(f'({{32{{sel[{i}]}}}} & ({term}))' for i, term in enumerate(terms.values()))\n        p.write_text(t[:t.index('  logic')]+f'''  logic [10:0] sel;\n{enc}\n  integer_result_mux u_integer (.sel(sel), .a(a), .b(b), .out(out));\nendmodule\n\nmodule integer_result_mux (\n  input  logic [10:0] sel,\n  input  logic [31:0] a, b,\n  output logic [31:0] out\n);\n  assign out = {masked};\nendmodule\n''')\n        edit(rtl, 'core_pkg.sv', 'logic [31:0] imm;', 'logic [31:0] imm;\\\\n    logic [10:0] int_op;')\n        enc='\\\\n'.join(f'      reg_q.int_op[{i}] <= dec_alu_op == ALU_{op} && \"'!dec_is_auipc && !dec_is_jump;'\"' for i, op in enumerate(terms))\n        edit(rtl, 'id_stage.sv', '      reg_q.imm      <= imm;', '      reg_q.imm      <= imm;\\\\n'+enc)\n        edit(rtl, 'ex_stage.sv', '  alu u_alu (\\\\n    .op  (in.ctrl.alu_op),', '  integer_result_mux u_alu (\\\\n    .sel (in.int_op),')\n        ep=rtl/'ex_stage.sv'\n        t=ep.read_text().replace('logic        is_alu_result, m_active;', 'logic        m_active;').replace('  assign is_alu_result = \"'!(is_mul || is_div || in.ctrl.is_jump || in.ctrl.is_auipc);'\"\\\\n','')\n        t=t.replace('({32{is_alu_result}} & alu_result)', 'alu_result').replace('{32{is_alu_result}} & alu_result','alu_result')\n        if variant == 'int_early_and_link':\n            t=t.replace('reg_q.integer_result <= alu_result;\\\\n      reg_q.alu_result    <= ({32{in.ctrl.is_jump}} & pc_plus4) |', 'reg_q.integer_result <= alu_result | ({32{in.ctrl.is_jump}} & pc_plus4);\\\\n      reg_q.alu_result    <= ')\n        ep.write_text(t)\n\n\ndef test(variant):\n    base = Path(mkdtemp(prefix=f'bench-r13-{variant}-'))\n    print(variant, base, flush=True)\n    rtl = base/'rtl'\n    copytree(champ if variant == 'onehot' else split_int, rtl)\n    setup(rtl, variant)\n    res = build_all(Path.cwd(), rtl, 'fpga/core_bench_si.sv', base, options=(1,2))\n    for r in res:\n        print(variant, r['place_option'], r['fmax_mhz'], r.get('logic'), r.get('critical_paths', [])[:3], r.get('reason'), flush=True)\n\nif __name__ == '__main__':\n    with ThreadPoolExecutor() as pool:\n        jobs = [pool.submit(test, v) for v in ('arithmetic','arithmetic_and_shifts','int_and_pc','int_early','int_early_and_link','onehot')]\n        for job in jobs:\n            job.result()\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 -u \"$TMPDIR/bench-r13-lanes.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
