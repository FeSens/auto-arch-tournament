{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile' <<'PY'\nfrom pathlib import Path\nfrom tools.eval.cosim import run_one, TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart\nimport sys, json, subprocess, concurrent.futures\np=Path(sys.argv[1])\nwith concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:\n    for n in (5,6):\n        sim=str(p/f'opt{n}_obj/cosim_sim')\n        out=subprocess.run([sim,str(p/'coremark.elf'),'6000000','--bench','--istall','--dstall'],capture_output=True,text=True,check=True)\n        line=json.loads(out.stdout.splitlines()[-1])\n        assert line['bench_bracketed'] and line['ebreak'] and not line['oob']\n        assert validate_coremark_uart(line['uart'],10) == (True,None)\n        print(n,'canonical CRCs passed in',line['bench_stop_cycle']-line['bench_start_cycle'],'marked cycles',flush=True)\n        jobs=[pool.submit(run_one,p/f'{name}.elf',sim,str(Path.cwd()),sim_flags=flags)\n              for name in ('selftest','random1','random2','random3') for flags in TRACE_STALL_MODES]\n        for job in jobs:\n            data=job.result()\n            print(n,data)\n            assert data['passed']\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
