{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c 'proposal_scratch=$(mktemp -d /srv/hwebench/tmp/4876824c/052b005e/carry.XXXXXX)\ncat > \"$proposal_scratch/trial.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nimport shutil\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build\n\nworktree = Path.cwd()\nscratch = Path(__file__).parent\n\ndef run(variant, option):\n    if variant == 'baseline':\n        rtl = worktree / 'cores/bench/rtl'\n    else:\n        rtl = scratch / variant / 'rtl'\n    result = build(worktree, rtl, 'fpga/core_bench_si.sv', option, scratch / variant / f'place{option}')\n    print(variant, option, result, flush=True)\n    return result\n\ndef prepare(name, widths, method, agu):\n    rtl = scratch / name / 'rtl'\n    shutil.copytree(worktree / 'cores/bench/rtl', rtl)\n    lines = [\n        'module fast_add #(parameter bit SUB = 1\\\\'b0) (',\n        '  input logic [31:0] a, b,',\n        '  output logic [31:0] y',\n        ');',\n    ]\n    low = 0\n    for i, w in enumerate(widths):\n        hi = low + w - 1\n        lines += [\n            f'  logic [{w-1}:0] ai{i}, bi{i};',\n            f'  assign ai{i} = a[{hi}:{low}];',\n            f'  assign bi{i} = b[{hi}:{low}];',\n        ]\n        ci = \\\"1'b0\\\" if i == 0 else f'c{i}'\n        if i > 0:\n            terms = [' & '.join([f'g{j}'] + [f'p{k}' for k in range(j+1, i)]) for j in range(i)]\n            lines += [f'  logic {ci};', f'  assign {ci} = {\\\" | \\\".join(f\\\"({term})\\\" for term in terms)};']\n        cmp = f'({{1\\\\'b0, ai{i}}} - {{1\\\\'b0, bi{i}}})' if False else ''\n        if method == 'inc':\n            lines += [f'  logic [{w}:0] raw{i};',\n                      f\\\"  assign raw{i} = SUB ? {{1'b0, ai{i}}} - {{1'b0, bi{i}}} : {{1'b0, ai{i}}} + {{1'b0, bi{i}}};\\\"]\n            if i == 0:\n                lines += [f'  assign y[{hi}:{low}] = raw{i}[{w-1}:0];']\n            else:\n                lines += [f\\\"  assign y[{hi}:{low}] = {ci} ? (SUB ? raw{i}[{w-1}:0] - {w}'d1 : raw{i}[{w-1}:0] + {w}'d1) : raw{i}[{w-1}:0];\\\"]\n        elif method == 'select':\n            lines += [f'  logic [{w}:0] raw{i};',\n                      f\\\"  assign raw{i} = SUB ? {{1'b0, ai{i}}} - {{1'b0, bi{i}}} : {{1'b0, ai{i}}} + {{1'b0, bi{i}}};\\\"]\n            if i == 0:\n                lines += [f'  assign y[{hi}:{low}] = raw{i}[{w-1}:0];']\n            else:\n                lines += [\n                    f'  logic [{w-1}:0] offset{i};',\n                    f\\\"  assign offset{i} = SUB ? ai{i} + ~bi{i} : {w}'(~({{1'b0, ~ai{i}}} + {{1'b0, ~bi{i}}}));\\\",\n                    f'  assign y[{hi}:{low}] = {ci} ? offset{i} : raw{i}[{w-1}:0];',\n                ]\n        elif method == 'carry':\n            lines += [\n                f'  logic [{w-1}:0] b_eff{i};',\n                f'  assign b_eff{i} = SUB ? ~bi{i} : bi{i};',\n                f\\\"  assign y[{hi}:{low}] = ai{i} + b_eff{i} + {{{w-1}'d0, SUB \"'^ {ci}}};\",\n            ]\n        if i < len(widths)-1:\n            lines += [f'\"'  logic g{i};']\n            if method in ('select', 'inc'):\n                lines += [f'  assign g{i} = raw{i}[{w}];']\n            else:\n                lines += [f'  assign g{i} = SUB ? (ai{i} < bi{i}) : (ai{i} > ~bi{i});']\n            if i > 0:\n                lines += [f'  logic p{i};',\n                          f'  assign p{i} = SUB ? (ai{i} == bi{i}) : (&(ai{i} \"'^ bi{i}));'\"']\n        low = hi + 1\n    (rtl / 'fast_add.sv').write_text('\\\\n'.join(lines + ['endmodule', '']))\n    p = rtl / 'alu.sv'\n    v = p.read_text().replace('  always_comb begin', '''\n  logic [31:0] add_result, sub_result;\n  fast_add add (.a(a), .b(b), .y(add_result));\n  fast_add #(.SUB(1'b1)) sub (.a(a), .b(b), .y(sub_result));\n\n  always_comb begin''').replace('out = a + b;', 'out = add_result;').replace('out = a - b;', 'out = sub_result;')\n    p.write_text(v)\n    if agu:\n        p = rtl / 'ex_stage.sv'\n        p.write_text(p.read_text().replace('assign rs1_plus_imm    = rs1 + in.imm;', 'fast_add agu (.a(rs1), .b(in.imm), .y(rs1_plus_imm));'))\n\nif __name__ == '__main__':\n    specs = {\n        'bytesel': ([8, 8, 8, 8], 'select', True),\n        'bytealu': ([8, 8, 8, 8], 'select', False),\n        'bytecarry': ([8, 8, 8, 8], 'carry', True),\n    }\n    for spec, variant in ((specs[n], n) for n in sys.argv[1:] if n in specs):\n        if not (scratch / variant / 'rtl').exists():\n            prepare(variant, *spec)\n    jobs = [(name, 1) for name in sys.argv[1:]]\n    with ThreadPoolExecutor(max_workers=len(jobs)) as pool:\n        for task in [pool.submit(run, name, place) for name, place in jobs]:\n            task.result()\nPY\nsed -i '/        cmp = /d' \\\"\"'$proposal_scratch/trial.py\"\necho \"$proposal_scratch\"\nPYTHONPATH=\"$PWD\" python3 \"$proposal_scratch/trial.py\" baseline bytesel bytealu bytecarry'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
