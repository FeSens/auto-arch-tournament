{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_if_stage.py; sed -n '1,270p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Cycle-level checks for the predictor, replay RAM and fetch queue.\"\"\"\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _step(\n    dut, word=None, *, consume=True, training=None, sequential_pc=None, target_pc=None,\n    reject_sequential=False, reject_target=False, reset=False,\n):\n    \"\"\"Return the bus address and oldest unissued PC/word before the edge.\"\"\"\n    source, branch = 0, False\n    if training is not None:\n        source, target_pc, branch = training\n    dut.clock.value = 0\n    dut.reset.value = reset\n    dut.imem_ready.value = word is not None\n    dut.imem_data.value = 0xFFFFFFFF if word is None else word\n    dut.reject_target.value = reject_target\n    dut.reject_sequential.value = reject_sequential\n    dut.train.value = training is not None\n    dut.train_pc.value = source >> 2\n    dut.train_branch.value = branch\n    dut.target_pc.value = (target_pc or 0) >> 2\n    dut.take_target.value = target_pc is not None\n    dut.sequential_pc.value = (source + 4 if sequential_pc is None else sequential_pc) >> 2\n    dut.decode_ready.value = consume\n    dut.recovery_issue_ready.value = consume\n    await Timer(1, unit=\"ns\")\n\n    bus_pc = int(dut.imem_addr.value)\n    valid = bool(dut.decode_valid.value)\n    issue = int(dut.out.value)\n    head_pc = issue >> 32\n    head_word = (issue & 0xFFFFFFFF) if valid else None\n\n    dut.clock.value = 1\n    await Timer(1, unit=\"ns\")\n    return bus_pc, head_pc, head_word\n\n\nasync def _reset_and_scrub(dut):\n    await _step(dut, reset=True)\n    for _ in range(512):\n        assert await _step(dut) == (0, 0, None)\n\n\nasync def _jump_to(dut, pc):\n    # Model a jump from a separate predictor slot to keep replay warm.\