{"type":"item.completed","item":{"id":"item_94","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/alu.sv'","aggregated_output":"// rtl/alu.sv\n//\n// Combinational RV32I ALU. RV32M operations use the clocked units in EX.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      default:    out = 32'b0;\n    endcase\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
