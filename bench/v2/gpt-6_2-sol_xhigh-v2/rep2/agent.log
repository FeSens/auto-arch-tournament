{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport collections\nimport numpy as np\na=np.fromfile('/srv/hwebench/tmp/4876824c/8df95641/bench_profile/retire.bin', dtype='<u4').reshape(-1,7)\npc,npc,insn,value,address,mask,_=a.T\nop=insn&127\nld=op==3\nrd=(insn[:-1]>>7)&31\nsrc1=np.isin(op[1:], [3,19,35,51,99,103])\nsrc2=np.isin(op[1:], [35,51,99])\nf1=((insn[1:]>>15)&31)==rd\nf2=((insn[1:]>>20)&31)==rd\nhaz=ld[:-1]&(rd\"'!=0)&((f1&src1)|(f2&src2))\nfalse=ld[:-1]&(rd!=0)&(f1|f2)&~haz\nprint(len(a),sum(ld),sum(haz),sum(false), collections.Counter(map(hex,op[1:][haz])))\nlast_by_pc={}\nlast_by_addr={}\nconf_by_pc={}\nstats=collections.Counter()\nclasses=collections.Counter()\nhazard=np.append(haz,False)\nfor i in np.nonzero(ld)[0]:\n    k,p,d,v = map(int, (pc[i],op[i+1],address[i],value[i]))\n    prev,streak=last_by_pc.get(k,(-1,0))\n    if hazard[i]:\n        stats['\"'pc_any']+=prev==v\n        stats['addr_any']+=last_by_addr.get(d,-1)==v\n        for confidence in range(1,5):\n            if streak>=confidence:\n                stats[confidence,prev==v]+=1\n                classes[p, confidence,prev==v]+=1\n    last_by_pc[k]=(v,1+streak if prev==v else 1)\n    last_by_addr[d]=v\nprint(stats)\nprint(classes)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
