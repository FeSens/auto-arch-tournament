{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c 'nl -ba cores/bench/rtl/hazard_unit.sv; git diff --stat'","aggregated_output":"     1\t// rtl/hazard_unit.sv\n     2\t//\n     3\t// Detects the only data hazard the textbook 5-stage doesn't cover via\n     4\t// forwarding: load-use. A LOAD in EX produces its data only after MEM,\n     5\t// so an instruction immediately behind that consumes the LOAD's rd\n     6\t// must be stalled by exactly one cycle. Also handles dmem backpressure\n     7\t// and holds ID/EX while the M-extension lane works.\n     8\t//\n     9\t// Latency:        combinational.\n    10\t// RVFI fields:    n/a (governs validity of subsequent retirements).\n    11\tmodule hazard_unit (\n    12\t  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n    13\t  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n    14\t  input  logic       ex_valid,          // EX has a live instruction\n    15\t  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n    16\t  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n    17\t  input  logic       m_wait,            // EX holds an M instruction without a result\n    18\t  input  logic       dmem_ready,\n    19\t  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n    20\t  // would actually be holding up). Computed at top level from the\n    21\t  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n    22\t  input  logic       ex_mem_mem_op,\n    23\t  output logic       decode_ready,      // ID/EX can accept if a word is valid\n    24\t  output logic       stall_id,          // ID/EX register holds (vs. bubble)\n    25\t  output logic       stall_ex_mem,      // EX/MEM register holds\n    26\t  output logic       hold_mem_wb        // MEM/WB clears valid only;\n    27\t                                        // data fields stay (for fwd)\n    28\t);\n    29\t\n    30\t  logic load_use_hazard;\n    31\t  logic dmem_stall;\n    32\t\n    33\t  assign load_use_hazard = ex_valid && id_ex_mem_read\n    34\t                        && (id_ex_rd != 5'b0)\n    35\t                        && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n    36\t  assign dmem_stall = !dmem_ready && ex_mem_mem_op;\n    37\t\n    38\t  // If ID/EX can advance, load-use or an unavailable word inserts a bubble.\n    39\t  assign stall_id      = dmem_stall || m_wait;\n    40\t  assign decode_ready  = !load_use_hazard && !stall_id;\n    41\t  assign stall_ex_mem  = dmem_stall;\n    42\t  // MEM/WB clears retirement while preserving its forwarding data.\n    43\t  assign hold_mem_wb  = dmem_stall;\n    44\t\n    45\tendmodule\n cores/bench/rtl/core_pkg.sv     | 26 ++++++++++++++++++++++++++\n cores/bench/rtl/forward_unit.sv |  4 ++--\n cores/bench/rtl/id_stage.sv     | 40 ++++++++++++++++++++++++++--------------\n 3 files changed, 54 insertions(+), 16 deletions(-)\n","exit_code":0,"status":"completed"}}
