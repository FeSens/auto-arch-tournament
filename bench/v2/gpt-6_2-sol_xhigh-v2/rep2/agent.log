{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'for design in lane-two lane-three lane-shared; do\n  mkdir -p \"$TMPDIR/div-study/$design\"\n  cp -r \"$TMPDIR/div-study/lane-compact/rtl\" \"$TMPDIR/div-study/$design/\"\ndone\npython - <<'\"'PY'\nfrom pathlib import Path\nimport os\nroot=Path(os.environ['TMPDIR'])/'div-study'\nfor count,name in [(2,'lane-two'),(3,'lane-three'),(4,'lane-shared')]:\n    path=root/name/'rtl/div_unit.sv'\n    s=path.read_text()\n    if count < 4:\n        s=s.replace('logic [3:0] lane_q;',f'logic [{count-1}:0] lane_q;').replace('[0:3];',f'[0:{count-1}];').replace('lane < 4',f'lane < {count}')\n        first=s.index('      if (magnitude_b[31:20]')\n        end=s.index('\\\\n    end',first)\n        cases=''\n        for lane in reversed(range(1,count)):\n            cutoff=8 if lane==1 else 14\n            lead='if' if not cases else 'else if'\n            cases+=f\\\"      {lead} (magnitude_b[31:{cutoff}] \"'!= 0)'\"\\\\n        lane_q <= {count}'d{1<<lane};\\\\n\\\"\n        cases+=f\\\"      else\\\\n        lane_q <= {count}'d1;\\\"\n        s=s[:first]+cases+s[end:]\n        s=s.replace('lane == 0 ? 8 : lane == 1 ? 14 : lane == 2 ? 20 : 32', 'lane == 0 ? 8 : 32' if count==2 else 'lane == 0 ? 8 : lane == 1 ? 14 : 32')\n    else:\n        s=s.replace('  logic [31:0] dividend_q, divisor_q, magnitude_a, magnitude_b, zero_result_q;', '''\n  logic [31:0] dividend_q, shifted_dividend, divisor_q, magnitude_a, magnitude_b, zero_result_q;\n  always_comb begin\n    if (phase_q == PREFIX)\n      shifted_dividend = ({32{lane_q[0]}} & (dividend_q << 2)) |\n                         ({32{lane_q[1]}} & (dividend_q << 8)) |\n                         ({32{lane_q[2]}} & (dividend_q << 14)) |\n                         ({32{lane_q[3]}} & (dividend_q << 20));\n    else\n      shifted_dividend = ({32{lane_q[0]}} & (dividend_q << 5)) |\n                         ({32{lane_q[1]}} & (dividend_q << 4)) |\n                         ({32{lane_q[2]}} & (dividend_q << 3)) |\n                         ({32{lane_q[3]}} & (dividend_q << 2));\n  end\n''')\n        s=s.replace(\\\"        lane_q <= 4'b0001;\\\\n    end\\\", \\\"        lane_q <= 4'b0001;\\\\n    end else if (phase_q >= PREFIX && phase_q < DONE) begin\\\\n      dividend_q <= shifted_dividend;\\\\n    end\\\")\n        s=s.replace('    logic [31:0] dq_q;', \\\"    localparam int QUOTIENT_W = lane == 0 ? 32 : 6*BITS;\\\\n    logic [QUOTIENT_W-1:0] dq_q;\\\")\n        s=s.replace('dq_q[31 -: BITS]','dividend_q[31 -: BITS]')\n        s=s.replace('= dq_q;', \\\"= 32'(dq_q);\\\")\n        s=s.replace(\\\"dq_q <= {dividend_q[31-PREFIX_BITS:0], prefix_digit};\\\", \\\"dq_q <= QUOTIENT_W'(prefix_digit);\\\")\n        s=s.replace(\\\"dq_q[31-BITS:0]\\\", \\\"dq_q[QUOTIENT_W-1-BITS:0]\\\")\n    path.write_text(s)\nPY\npython -u - <<'PY'\nimport os\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build_all, summarize\nroot=Path(os.environ['TMPDIR'])/'div-study'\ndef run(design):\n    p=root/design\n    results=build_all(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',p/'timing')\n    print(design, summarize(results), flush=True)\n    for r in results:\n        print(design,r['place_option'],r.get('critical_paths',[None])[0], flush=True)\nwith ThreadPoolExecutor() as ex:\n    tuple(ex.map(run, ['lane-two','lane-three','lane-shared']))\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
