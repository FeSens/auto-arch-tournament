{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"cat > replay_local.py <<'PY'\nfrom collections import Counter\nrows=[]\nfor line in open('controls.log'):\n    if line.startswith('B '):\n        _,pc,nextpc,target,branch,jalr,taken=line.split()\n        rows.append((int(pc,16)>>2,int(nextpc,16)>>2,int(target,16)>>2,int(branch),int(jalr),int(taken)))\ndef replay(history,t_size,d_size,shift, alias):\n    tm=t_size-1\n    dm=d_size-1\n    hm=(1<<history)-1\n    targets={}\n    past={}\n    counters={}\n    misses=0\n    for pc,n,target,branch,jalr,taken in rows:\n        idx=(pc\"'^(pc>>shift))&tm if shift else pc & tm\n        pidx=pc&dm\n        state=targets.get(idx)\n        hit=state is not None and state[0]==pc\n        prior=past.get(pidx,0)\n        dindex=((pc<<history)|prior)&dm if alias else (pidx,prior)\n        cn=counters.get(dindex,1)\n        pred=state[1] if hit and (not branch or cn >= 2) else pc+1\n        if n != pred:\n            misses+=1\n        targets[idx]=(pc,target)\n        if branch:\n            counters[dindex]=max(0,min(3,cn+(1 if taken else -1)))\n            past[pidx]=((prior<<1)|taken)&hm\n    return misses\nfor shift in (0,3,6):\n    for size in (64,128):\n        print('\"'shift=%d tags=%d'%(shift,size), [[replay(hist,size,d,shift,0) for d in (64,128,1<<15)] for hist in range(5)],flush=True)\nPY\npython3 replay_local.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
