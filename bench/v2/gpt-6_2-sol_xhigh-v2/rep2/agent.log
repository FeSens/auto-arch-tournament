{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nimport shutil\nroot=Path(gettempdir())/'bench-r8s0'\nfor variant, base in (('narrow-div-fixed','narrow-div'),('narrow-div-fwd','early-mem-fwd')):\n    path=root/variant/'rtl'\n    shutil.copytree(root/base/'rtl',path,dirs_exist_ok=True)\n    src=(root/'narrow-div'/'rtl/div_unit.sv').read_text()\n    src=src.replace('logic [15:0] wide_prefix_diff', 'logic [16:0] wide_prefix_diff')\n    # Include a separate borrow bit above the 16-bit multiple.\n    src=src.replace(\\\"{2'b0, wide_prefix_a}\\\", \\\"{3'b0, wide_prefix_a}\\\")\n    src=src.replace(\\\"{2'b0, wide_prefix_d}\\\", \\\"{3'b0, wide_prefix_d}\\\")\n    src=src.replace(\\\"{1'b0, wide_prefix_d, 1'b0}\\\", \\\"{2'b0, wide_prefix_d, 1'b0}\\\")\n    src=src.replace('wide_prefix_diff[i][15]', 'wide_prefix_diff[i][16]')\n    (path/'div_unit.sv').write_text(src)\nPY\npython -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom tools.eval.gowin import build, summarize\nworktree = Path.cwd()\nroot = Path(gettempdir()) / 'bench-r8s0'\nfor name in ('narrow-div-fixed', 'narrow-div-fwd'):\n    variant=root/name\n    with ThreadPoolExecutor(max_workers=3) as jobs:\n        results = list(jobs.map(lambda p: build(worktree, variant/'rtl', 'fpga/core_bench_si.sv', p, variant/'timing'/f'gowin_p{p}'), range(3)))\n    print(name, summarize(results), flush=True)\n    for result in results:\n        print(result['place_option'], result.get('critical_paths', [])[:2], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
