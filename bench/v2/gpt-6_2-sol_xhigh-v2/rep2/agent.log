{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r13-select.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp,gettempdir\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all\nimport re\n\nsrc=next(Path(gettempdir()).glob('bench-r13-register_integer_lane-*'))/'rtl'\n\ndef setup(rtl, variant):\n    for p in rtl.glob('*.sv'):\n        t=p.read_text()\n        if p.name=='core_pkg.sv':\n            t=t.replace('logic [31:0] integer_result;', 'logic [31:0] integer_result;\\\\n    logic        integer_valid;')\n        if p.name=='ex_stage.sv':\n            t=t.replace('input  logic [31:0]        fwd_integer,','input  logic               fwd_integer_valid,\\\\n  input  logic [31:0]        fwd_integer,')\n            t=t.replace('reg_q.integer_result <= {32{is_alu_result}} & alu_result;', 'reg_q.integer_result <= alu_result;\\\\n      reg_q.integer_valid  <= is_alu_result;')\n            for lhs in ('fwd_rs1_sel[2]','fwd_rs2_sel[2]','\"'!in.ctrl.alu_src && fwd_rs2_sel[2]'\"'):\n                t=t.replace(f'{{32{{{lhs}}}}} & fwd_integer',f'{{32{{{lhs} && fwd_integer_valid}}}} & fwd_integer')\n                if variant in ('both','maskb'):\n                    t=t.replace(f'{{32{{{lhs}}}}} & fwd_ex_mem',f'{{32{{{lhs} && \"'!fwd_integer_valid}}}} & fwd_ex_mem'\"')\n            if variant == 'maskb':\n                t=t.replace('  assign alu_b =', '  (* syn_keep = 1 *) logic [2:0] b_sel;\\\\n  assign b_sel = fwd_rs2_sel & {3{\"'!in.ctrl.alu_src}};'\"\\\\n  assign alu_b =')\n                t=t.replace('\"'!in.ctrl.alu_src && fwd_rs2_sel[2]'\"', 'b_sel[2]').replace('\"'!in.ctrl.alu_src && fwd_rs2_sel[1]'\"', 'b_sel[1]').replace('\"'!in.ctrl.alu_src && fwd_rs2_sel[0]'\"', 'b_sel[0]')\n        if p.name=='core.sv':\n            t=t.replace('    .fwd_integer          (ex_mem_w.integer_result),','    .fwd_integer_valid    (ex_mem_w.integer_valid),\\\\n    .fwd_integer          (ex_mem_w.integer_result),')\n        if p.name=='mem_stage.sv':\n            w='(in.integer_valid ? in.integer_result : in.alu_result)' if variant in ('both','maskb') else '(in.alu_result | ({32{in.integer_valid}} & in.integer_result))'\n            t=t.replace('(in.alu_result | in.integer_result)',w)\n        p.write_text(t)\n\n\ndef test(variant):\n    base=Path(mkdtemp(prefix=f'bench-r13-select-{variant}-'))\n    print(variant,base,flush=True)\n    rtl=base/'rtl'; copytree(src,rtl); setup(rtl,variant)\n    res=build_all(Path.cwd(),rtl,'fpga/core_bench_si.sv',base)\n    for r in res:\n        print(variant,r['place_option'],r['fmax_mhz'],r.get('logic'),r.get('critical_paths',[])[:3],r.get('reason'),flush=True)\n\nwith ThreadPoolExecutor() as pool:\n    jobs=[pool.submit(test,v) for v in ('intonly','both','maskb')]\n    for j in jobs:\n        j.result()\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 -u \"$TMPDIR/bench-r13-select.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
