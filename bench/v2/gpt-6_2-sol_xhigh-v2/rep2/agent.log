               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               squash,        // registered recovery annuls ID/EX\n  input  logic [31:2]        fetch_pc,      // successor predicted when EX was in ID\n  input  id_ex_t   in,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // MEM/WB.write_result (registered)\n  output ex_mem_t  out,\n  output logic               next_fwd_write,\n  output logic               ex_valid,\n  output logic               m_wait,         // hold fetch and ID/EX\n  output logic               mispredict,\n  output logic               train,\n  output logic [31:2]        resolved_pc\n);\n\n  assign ex_valid = in.valid && !squash;\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = ({32{in.fwd_rs1_sel[2]}} & fwd_ex_mem) |\n               ({32{in.fwd_rs1_sel[1]}} & fwd_mem_wb) |\n               ({32{in.fwd_rs1_sel[0]}} & in.rs1_val);\n  assign rs2 = ({32{in.fwd_rs2_sel[2]}} & fwd_ex_mem) |\n               ({32{in.fwd_rs2_sel[1]}} & fwd_mem_wb) |\n               ({32{in.fwd_rs2_sel[0]}} & in.rs2_val);\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n M cores/bench/rtl/alu.sv\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/div_unit.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/forward_unit.sv\n M cores/bench/rtl/id_stage.sv\n M cores/bench/rtl/mem_stage.sv\n M cores/bench/test/test_alu.py\n M cores/bench/test/test_div_unit.py\n M cores/bench/test/test_pipeline.py\n?? cores/bench/rtl/alu_one_hot.sv\n","exit_code":0,"status":"completed"}}
