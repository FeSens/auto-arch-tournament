{"type": "item.started", "item": {"id": "item_81", "type": "command_execution", "command": "/bin/bash -c \"python3 - '/srv/hwebench/tmp/4876824c/b58d6b92/bench-r8-predictor.ZnBoac/plain-1024-pipe/test/test_pipeline.py' <<'PY'\nfrom pathlib import Path\nimport sys\np = Path(sys.argv[1])\ns = p.read_text()\ns = s.replace('async def predicted_fallthrough_replays_sixteen_words(dut):\\\\n    branch, start, end, exit_pc = 0x04, 0x08, 0x48, 0x80', 'async def predicted_fallthrough_replays_across_sectors(dut):\\\\n    branch, start, end, exit_pc = 0x04, 0x08, 0x58, 0x80')\ns = s.replace('    tail_stalls = 3\\\\n\\\\n    def stall_imem(pc):\\\\n        nonlocal visits, tail_stalls', '\\\\n    def stall_imem(pc):\\\\n        nonlocal visits')\ns = s.replace('''        if pc in stream:\n            return True\n        if pc == end and tail_stalls:\n            tail_stalls -= 1\n            return True\n        return False''','''        return pc in stream or pc == end''')\ns = s.replace('    assert fetches[third:third + 22] == [branch] + stream + [end] * 4 + [end + 4]', '    expected_fetches = [branch] + stream + [end, end + 4]\\\\n    assert fetches[third:third + len(expected_fetches)] == expected_fetches')\ns = s.replace('    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == stream[-1]] == [136, 272, 408]', '''    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == stream[-1]] == [210, 420, 630]\n    third_issue = [i for i, r in enumerate(rets) if r[\\\"pc\\\"] == branch][2]\n    cycles = [r[\\\"cycle\\\"] for r in rets[third_issue:third_issue + len(expected_fetches)]]\n    assert cycles == list(range(cycles[0], cycles[0] + len(cycles)))''')\ns = s.replace('async def colliding_stream_replaces_only_its_contiguous_prefix(dut):\\\\n    # Both stream starts hash to row 16, with byte-address tags 0 and 1.\\\\n    a, b = 0x40, 0xC4\\\\n    launch_a, launch_b, exit_pc = 0x08, 0x90, 0x110', '''async def colliding_sector_replaces_its_mask(dut):\n    # A and B have the same sector row and offsets, with distinct full tags.\n    a, b = 0x40, 0x1040\n    launch_a, launch_b, exit_pc = 0x08, 0x1010, 0x10C0''')\ns = s.replace('    cold_offsets = {b: 3, b + 8: 3}', '    cold_offsets = {b + 4: 3, b + 8: 3}')\ns = s.replace('        if b_visits == 2 and cold_offsets.get(pc, 0):', '        if b_visits == 1 and cold_offsets.get(pc, 0):')\ns = s.replace('        return b_visits == 3 and pc in (b, b + 4)', '        return b_visits == 2 and pc in (b, b + 4, b + 8)')\nstart = s.index('    second, third = [i for i, pc in enumerate(fetches) if pc == launch_b]')\nend = s.index('    a_body =', start)\ns = s[:start] + '''    first_b = fetches.index(b)\n    second_launch = [i for i, pc in enumerate(fetches) if pc == launch_b][1]\n    # Filling B's first offset must not make A's later words visible as B.\n    cold_fetches = [b] + [b + 4] * 4 + [b + 8] * 4 + [b + 12]\n    assert fetches[first_b:first_b + len(cold_fetches)] == cold_fetches\n    assert fetches[second_launch:second_launch + 5] == [launch_b, b, b + 4, b + 8, b + 12]\n''' + s[end:]\nwhere=s.index('@cocotb.test()\\\\nasync def stale_prediction_on_load')\ns = s[:where] + '''@cocotb.test()\nasync def replay_read_conflict_does_not_escape_a_fetch_hold(dut):\n    target, branch, exit_pc = 0x40, 0x44, 0x48\n    program = {\n        0: ADDI(1, 0, 2),\n        4: JAL(0, branch - 4),\n        target: ADDI(1, 1, -1),\n        branch: _b(target - branch, 0, 1, 1, 0b1100011),\n        exit_pc: EBREAK(),\n    }\n    branch_visits = 0\n    remaining_stalls = 3\n    bus = []\n\n    def stall_imem(pc):\n        nonlocal branch_visits, remaining_stalls\n        if pc == branch:\n            branch_visits += 1\n        if branch_visits == 2 and pc == target and remaining_stalls:\n            remaining_stalls -= 1\n            return True\n        return False\n\n    rets, dmem = await _run(dut, lambda pc: program.get(pc, NOP()),\n                            imem_stalls=stall_imem, bus_trace=bus)\n    fetches = [pc for pc, _, _ in bus]\n    second_branch = [i for i, pc in enumerate(fetches) if pc == branch][1]\n    assert fetches[second_branch:second_branch + 6] == [branch] + [target] * 4 + [branch]\n    expected = [0, 4, branch, target, branch, target, branch, exit_pc]\n    assert [r[\\\"pc\\\"] for r in rets] == expected\n    assert [r[\\\"insn\\\"] for r in rets] == [program[pc] for pc in expected]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(expected)))\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == target] == [1, 0]\n    assert all(r[\\\"trap\\\"] == 0 for r in rets) and not dmem\n\n\n''' + s[where:]\np.write_text(s)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
