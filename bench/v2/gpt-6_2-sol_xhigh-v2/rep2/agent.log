{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"rg -n 'Cycle|READY|sw|stall' test/cosim/main.cpp | head -85 && cat cores/bench/rtl/forward_unit.sv\"","aggregated_output":"50:// ~22% stall). Replicating exactly so CoreMark/MHz numbers from this\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\n69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\n74:    bool istall = false;\n75:    bool dstall = false;\n78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\n79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\n118:        // slowed down by unrelated stalls.\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n// rtl/forward_unit.sv\n//\n// Qualify the registered, nonzero tag matches with the producer write\n// enables. Each operand selects one source in {EX/MEM, MEM/WB, ID/EX} order.\n//\n// Latency:        combinational.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic [1:0] match_ex_mem, // {rs2, rs1}\n  input  logic [1:0] match_mem_wb, // {rs2, rs1}\n  input  logic       ex_mem_w_en,\n  input  logic       mem_wb_w_en,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  logic [1:0] ex_mem_match, mem_wb_match;\n  logic [1:0] select_mem_wb, select_id_ex;\n\n  assign ex_mem_match  = match_ex_mem & {2{ex_mem_w_en}};\n  assign mem_wb_match  = match_mem_wb & {2{mem_wb_w_en}};\n  assign select_mem_wb = ~ex_mem_match & mem_wb_match;\n  assign select_id_ex  = ~(ex_mem_match | mem_wb_match);\n\n  assign fwd_rs1 = {ex_mem_match[0], select_mem_wb[0], select_id_ex[0]};\n  assign fwd_rs2 = {ex_mem_match[1], select_mem_wb[1], select_id_ex[1]};\n\nendmodule\n","exit_code":0,"status":"completed"}}
