{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile/rtl'\ncp cores/bench/rtl/*.sv '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile/rtl/'\ncat > '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile/prototype.py' <<'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\n\ndef edit(file, replacements):\n    p = rtl / file\n    source = p.read_text()\n    for old, new in replacements:\n        assert source.count(old) == 1, (file, old, source.count(old))\n        source = source.replace(old, new)\n    p.write_text(source)\n\nedit('core_pkg.sv', [('    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)', '''    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    logic [31:0] branch_target;\n    logic        branch_sequential_match;\n    logic        branch_relative_match;\n    logic [1:0]  late_sources;\n    logic        late_x0, late_byte, late_bne, late_upper_match;\n    logic [15:0] late_other_low;''')])\n\nedit('hazard_unit.sv', [('  input  logic       id_ex_mem_read,', '  input  logic [1:0] id_ex_mem_width,\\\\n  input  logic       equality_branch,\\\\n  input  logic       id_ex_mem_read,'),\n('  logic dmem_stall;','''  logic dmem_stall;\n  logic rs1_match, rs2_match, late_branch;\n  assign rs1_match = id_ex_rd == if_id_rs1;\n  assign rs2_match = id_ex_rd == if_id_rs2;\n  assign late_branch = equality_branch &&\n                       (id_ex_mem_width \"'!= 2'\"'d2 || (rs1_match && rs2_match) ||\n                        if_id_rs1 == 5'd0 || if_id_rs2 == 5'd0);'''),\n('&& (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);','&& (rs1_match || rs2_match) && \"'!late_branch;'\"')])\n\nedit('ex_stage.sv', [\n('  input  logic               squash,', '''  input  logic               late_flush,\n  input  logic               previous_load,\n  input  logic [1:0]         previous_width,\n  input  logic        