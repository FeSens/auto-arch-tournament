ed-typedef errors.\nRTL_FILES=()\n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[10822 of 13894 chars elided by tools/bench/transcript.py; sha256:dac615cd34a67379]…\nild/\n78:#   the latest state is always viewable from GitHub. Regenerated and\n85:cores/*/generated/\n87:cores/*/implementation_notes.md\ntotal 56\ndrwxr-xr-x 13 nobody nogroup 4096 Sep 29 20:56 .\ndrwxr-xr-x  3 nobody nogroup 4096 Sep 28 02:56 ..\ndrwxrws---  2 nobody nogroup 4096 Nov 19 14:13 auth\ndrwxr-xr-x  3 nobody nogroup 4096 Sep 28 02:57 bin\ndrwxr-xr-x  6 nobody nogroup 4096 Nov 19 14:25 cli\ndrwx--x--x  4 nobody nogroup 4096 Nov 20 03:33 clones\ndrwx-wx-wt  4 nobody nogroup 4096 Nov 20 03:33 homes\ndrwx------  6 nobody nogroup 4096 Sep 29 04:18 old-clones-incident05\ndrwx------  6 nobody nogroup 4096 Sep 29 07:59 old-clones-incident06\ndrwx------  7 nobody nogroup 4096 Sep 29 11:06 old-clones-incident07\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 29 20:41 old-clones-incident09\n-rw-r--r--  1 nobody nogroup  835 Sep 28 02:57 setup-check.log\ndrwx--x--x  4 nobody nogroup 4096 Nov 20 03:33 tmp\nlrwxrwxrwx  1 nobody nogroup   18 Sep 28 02:57 toolchain -> /opt/hwe-toolchain\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 02:57 venv\n", "exit_code": 0, "status": "completed"}}
