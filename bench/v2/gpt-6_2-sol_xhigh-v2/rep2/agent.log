{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -c 'set -e\nprofile_dir=/srv/hwebench/tmp/4876824c/8df95641/bench_profile\ntest_root=\"$profile_dir/pipeline_stage\"\nmkdir -p \"$test_root/test\"\nln -sfn \"$profile_dir/mapped_shift2_p16\" \"$test_root/rtl\"\ncp cores/bench/test/{_helpers,test_pipeline}.py \"$test_root/test\"\ncat >> \"$test_root/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\nasync def queued_fetch_drains_during_imem_stall(dut):\n    program = [\n        ADDI(1, 0, 13),\n        SW(1, 0, 0x40),\n        ADDI(2, 0, 20),\n        ADDI(3, 2, 1),\n        SW(3, 0, 0x44),\n        EBREAK(),\n    ]\n    bus = []\n    rets, dmem = await _run(\n        dut, program, dmem_stalls={0x40: 5}, imem_stalls={0x14: 7}, bus_trace=bus,\n    )\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, 0x18, 4))\n    assert dmem == {0x40: 13, 0x44: 21}\n    assert [a for a, da, wen in bus if da == 0x40 and wen][:3] == [0x0C, 0x10, 0x14]\n    assert bus[rets[3][\\\"cycle\\\"]][0] == 0x14\n\n\n@cocotb.test()\nasync def stale_prediction_discards_queued_divide_and_store(dut):\n    program = {\n        0x00: ADDI(4, 0, 6),\n        0x04: JAL(0, 0x20 - 0x04),\n        0x08: ADDI(2, 1, 1),\n        0x0C: EBREAK(),\n        0x20: JAL(0, 0x04 - 0x20),\n        0x24: SW(4, 0, 0x34),\n    }\n\n    def read_imem(pc):\n        instr = program.get(pc, NOP())\n        if pc == 0x20:\n            program[0x04] = LW(1, 0, 0)\n            program[0x20] = DIV(1, 4, 4)\n        return instr\n\n    bus = []\n    rets, dmem = await _run(\n        dut, read_imem, {0: 42}, dmem_stalls={0: 3}, bus_trace=bus,\n    )\n    assert dmem == {0: 42}\n    assert not any(wen for _, _, wen in bus)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 0x20, 4, 8, 0x0C]\n    assert rets[3][\\\"pc_next\\\"] == 8 and rets[3][\\\"rd_wdata\\\"] == 42\n    assert rets[4][\\\"rd_wdata\\\"] == 43\n\n\n@cocotb.test()\nasync def cross_page_target_resolves_at_full_width(dut):\n    program = {0: JAL(0, 0x10000), 0x10000: ADDI(3, 0, 9), 0x10004: JAL(0, -0x10000), 4: EBREAK()}\n    rets, _ = await _run(dut, lambda pc: program.get(pc, NOP()))\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 0x10000, 0x10004, 4]\n    assert [r[\\\"pc_next\\\"] for r in rets] == [0x10000, 0x10004, 4, 8]\nPY\ncd \\\"\"'$test_root\"\nPYTHONDONTWRITEBYTECODE=1 COCOTB_TEST_FILTER='\"'queued_fetch_drains|stale_prediction_discards|cross_page_target' python -m pytest -p no:cacheprovider -q test/test_pipeline.py > \\\"\"'$profile_dir/pipeline_checks.log\" 2>&1\ntail -12 \"$profile_dir/pipeline_checks.log\"'","aggregated_output":".                                                                        [100%]\n1 passed in 8.02s\n","exit_code":0,"status":"completed"}}
