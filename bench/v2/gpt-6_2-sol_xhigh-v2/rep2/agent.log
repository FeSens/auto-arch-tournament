{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\n\nimport os, shutil, tempfile\nfrom pathlib import Path\nroot=Path(tempfile.mkdtemp(prefix='r8s1-lookahead.',dir=os.environ['TMPDIR']))\nfor entries in (256,512,1024):\n    variant=root/str(entries)\n    dest=variant/'cores/bench'\n    dest.mkdir(parents=True)\n    shutil.copytree('cores/bench/rtl',dest/'rtl')\n    shutil.copy('cores/bench/core.yaml',dest)\n    shutil.copytree('fpga',variant/'fpga')\n    p=dest/'rtl/if_stage.sv'\n    s=p.read_text()\n    start=s.index('  logic        stream_active_q')\n    end=s.index('  // The wrap bit',start)\n    k=entries.bit_length()-1\n    s=s[:start]+f\\\"\\\"\\\"\n  localparam int INDEX_BITS = {k};\n  localparam int TAG_BITS = 30 - INDEX_BITS;\n  localparam int ENTRY_BITS = 1 + TAG_BITS + 32;\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [ENTRY_BITS-1:0] replay_entries [0:{entries-1}];\n  logic [ENTRY_BITS-1:0] replay_read_q, bypass_entry_q, replay_entry, write_entry;\n  logic [INDEX_BITS-1:0] replay_index, write_index;\n  logic [INDEX_BITS-1:0] clear_index_q;\n  logic [31:2] replay_pc, replay_pc_q;\n  logic [31:0] replay_word;\n  logic fetch_accept, replay_available, write_enable, invalidate, clear_q, bypass_q;\n\n  assign invalidate = mispredict && \"'!train;\n  assign replay_pc = fetch_accept ? predicted_pc : fetch_pc;\n  assign replay_index = replay_pc[INDEX_BITS+1:2];\n  assign write_enable = clear_q || (fetch_accept && imem_ready);\n  assign write_index = clear_q ? clear_index_q : fetch_pc[INDEX_BITS+1:2];\n  assign write_entry = clear_q ? '\"'0 : {{1'b1, fetch_pc[31:INDEX_BITS+2], imem_data}};\n  assign replay_entry = bypass_q ? bypass_entry_q : replay_read_q;\n  assign replay_word = replay_entry[31:0];\n  assign replay_available = \"'!clear_q && !target_pending_q && replay_pc_q == fetch_pc\n                         && replay_entry[ENTRY_BITS-1]\n                         && replay_entry[ENTRY_BITS-2:32] == fetch_pc[31:INDEX_BITS+2];\n\n  always_ff @(posedge clock) begin\n    replay_read_q <= replay_entries[replay_index];\n    replay_pc_q <= replay_pc;\n    if (write_enable)\n      replay_entries[write_index] <= write_entry;\n    bypass_q <= write_enable && write_index == replay_index;\n    bypass_entry_q <= write_entry;\n\n    if (reset || invalidate) begin\n      clear_q <= 1'\"'b1;\n      clear_index_q <= '0;\n    end else if (clear_q) begin\n      clear_index_q <= clear_index_q + 1'b1;\n      if (&clear_index_q)\n        clear_q <= 1'b0;\n    end\n  end\n\n\\\"\\\"\\\"+s[end:]\n    p.write_text(s)\nprint(root)\n\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
