{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c 'scratch=/srv/hwebench/tmp/4876824c/d11de99c/pred-profile.W3B9vT\ncat > \"$scratch/profile.cc\" <<'\"'CPP'\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <map>\n#include <string>\n#include <unordered_map>\n\nstruct Trace {uint32_t instr, pc, succ, rd, value, rs1, a, rs2, b, addr, rmask, data, wmask, trap, cycle;};\nstruct Entry {uint64_t tag = ~0ULL; uint32_t last = 0, delta = 0; unsigned conf = 0, stride_conf = 0;};\nstruct Stats {unsigned eligible=0; std::array<unsigned,4> hit{}, miss{}, branch_effective{};};\nuint32_t fields(uint32_t a, uint32_t b) {return a \"'^ (b * 1234567);}\nuint32_t canonical_addr(const Trace &r) {return r.addr + __builtin_ctz(r.rmask | 16);}\nuint64_t index(uint64_t tag, unsigned bits) {tag ''^= tag>>13; tag ''^= tag>>7; tag ''^= tag>>19; return tag & ((1u << bits)-1);}\nint main(int argc,char **argv) {\n  FILE *f = fopen(argv[1], \"rb\");\n  Trace r{}, n{};\n  if (!fread(&r,sizeof(r),1,f)) return 1;\n  std::array<std::pair<std::string, unsigned>, 10> models{{{\"PC last\",7},{\"PC last\",9},{\"PC stride\",7},{\"Addr last\",7},{\"Addr last\",9},{\"Addr last\",11},{\"PC+addr last\",9},{\"PC+addr last\",11},{\"Addr last\",13},{\"PC last\",13}}};\n  std::array<std::array<Stats,3>,models.size()> stats;\n  std::array<std::array<Entry,8192>,models.size()> pred;\n  std::map<uint32_t,std::array<unsigned,4>> sites;\n  std::unordered_map<uint32_t,std::unordered_map<uint32_t,unsigned>> valhist;\n  std::map<unsigned,unsigned> takens;\n  uint32_t count = 0;\n  while(fread(&n,sizeof(n),1,f)) {\n    if (++count % 600000 == 0) fprintf(stderr,\"...%u'\"\\\\n\\\",count);\n    if ((r.instr & 127) == 3 && r.rmask && r.rd && \"'!r.trap) {\n      unsigned op = n.instr & 127, f3 = (n.instr >> 12) & 7;\n      bool branch = op == 0x63 && f3 < 2 && (n.rs1 == r.rd || n.rs2 == r.rd);\n      bool load = op == 3 && n.rs1 == r.rd;\n      bool eligible = branch || load;\n      if (eligible) {\n        sites[r.pc][0]++;\n        sites[r.pc][branch ? 1 : 2]++;\n        valhist[r.pc][r.value]++;\n      }\n      for (unsigned k = 0; k < models.size(); ++k) {\n        auto [name,bits] = models[k];\n        unsigned width = (r.instr >> 12) & 7;\n        uint64_t addr = (static_cast<uint64_t>(canonical_addr(r)) << 3) | width;\n        uint64_t tag = name.starts_with(\"Addr\") ? addr : name.starts_with(\"PC+\") ? (static_cast<uint64_t>(r.pc) << 24) | addr : r.pc >> 2;\n        bool stride = name.ends_with(\"stride\");\n        Entry &e = pred[k][index(tag,bits)];\n        uint32_t guess = e.last + (stride ? e.delta : 0);\n        unsigned conf = stride ? e.stride_conf : e.conf;\n        if (eligible) {\n          for (unsigned type : {branch ? 0u : 1u, 2u}) {\n            Stats &s = stats[k][type]; ++s.eligible;\n            if (e.tag == tag) for (unsigned threshold=0; threshold < 4; ++threshold) {\n              if (conf < threshold) break;\n              ++(guess == r.value ? s.hit : s.miss)[threshold];\n              if (branch && ((n.rs1 == r.rd ? guess : n.a) == (n.rs2 == r.rd ? guess : n.b)) == (n.a == n.b))\n                  ++s.branch_effective[threshold];\n            }\n          }\n        }\n        if (e.tag != tag) e = {tag,r.value,0,0,0};\n        else {\n          e.conf = r.value == e.last ? (e.conf < 3 ? e.conf + 1 : 3) : 0;\n          e.stride_conf = r.value - e.last == e.delta ? (e.stride_conf < 3 ? e.stride_conf + 1 : 3) : 0;\n          e.delta = r.value - e.last;\n          e.last = r.value;\n        }\n      }\n    }\n    if ((n.instr & 127)==0x63 || (n.instr & 127)==0x67 || (n.instr & 127)==0x6f) takens[n.instr & 127]++;\n    r = n;\n  }\n  for (unsigned k=0; k<models.size(); ++k) {\n    printf(\"%s %u'\"\\\\n\\\",models[k].first.c_str(), models[k].second);\n    for (unsigned type=0;type<3;++type) {\n      const Stats &s = stats[k][type];\n      printf(\\\"    %u (N=%u)\\\",type,s.eligible);\n      for (unsigned c=0;c<4;++c) printf(\\\"  %u/%u (%u)\\\",s.hit[c],s.miss[c],s.branch_effective[c]);\n      puts(\\\"\\\");\n    }\n  }\n  for (auto [pc,s]:sites) if (s[0] > 1000) {\n    unsigned max=0, common=0;\n    for (auto [value,freq] : valhist[pc]) if (freq > max) {max = freq; common = value;}\n    printf(\\\"%04x  total=%u  branches=%u  loads=%u  vals=%zu  common=%08x:%u\\\\n\\\",pc,s[0],s[1],s[2],valhist[pc].size(),common,max);\n  }\n  for(auto [op,total]:takens) printf(\\\"op %02x number %u\\\\n\\\",op,total);\n}\nCPP\ng++ -std=c++20 -O3 \\\"\"'$scratch/profile.cc\" -o \"$scratch/stats\" && \"$scratch/stats\" \"$scratch/trace.bin\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
