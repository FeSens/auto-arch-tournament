{"type": "item.started", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nimport shutil, tempfile\nfrom pathlib import Path\nparent = Path('/srv/hwebench/tmp/4876824c/16d5aec7/r5s2.ram.fvxWHe').parent\nvariants = [('bimodal', '/srv/hwebench/tmp/4876824c/16d5aec7/r5s2.local.cvw8idii', 6, 6), ('bimodal_bypass', '/srv/hwebench/tmp/4876824c/16d5aec7/r5s2.bypass.33zy78nv', 6, 3), ('bimodal_128', '/srv/hwebench/tmp/4876824c/16d5aec7/r5s2.local.cvw8idii', 7, 0), ('bimodal_small', '/srv/hwebench/tmp/4876824c/16d5aec7/r5s2.local.cvw8idii', 5, 0)]\nfor variant, staging, bits, fold in variants:\n    base = Path(staging)\n    root = Path(tempfile.mkdtemp(prefix=f'r5s2.{variant}.', dir=parent))\n    for name in ('cores', 'fpga', 'test', 'tools', 'bench', 'formal'):\n        shutil.copytree(base/name, root/name, ignore=shutil.ignore_patterns('generated', 'obj_dir', '__pycache__'), symlinks=True)\n    shutil.copyfile(base/'Makefile', root/'Makefile')\n    expath=root/'cores/bench/rtl/ex_stage.sv'\n    s=expath.read_text().replace('  output logic               train,', '''  output logic               train,\n  output logic               train_branch,\n  output logic               train_taken,\n  output logic [31:2]        train_target,''')\n    s=s.replace('  ctrl_t ctrl_out;', '''  assign train_branch = in.ctrl.is_branch;\n  assign train_taken = use_target;\n  assign train_target = control_target[31:2];\n  ctrl_t ctrl_out;''').replace('&& \"'!in.ctrl.is_illegal && !misalign_fault;'\"', \\\"&& \"'!in.ctrl.is_illegal && (control_target[1:0] == 2'\"'b00);\\\")\n    expath.write_text(s)\n    cpath=root/'cores/bench/rtl/core.sv'\n    s=cpath.read_text().replace('  logic [31:2] resolved_pc;', '''  logic [31:2] resolved_pc, train_target;\n  logic train_branch, train_taken;''')\n    s=s.replace('    .train           (train),', '''    .train           (train),\n    .train_branch    (train_branch),\n    .train_taken     (train_taken),\n    .train_target    (train_target),''')\n    cpath.write_text(s)\n    path = root/'cores/bench/rtl/if_stage.sv'\n    s = path.read_text().replace('  input  logic              train,', '''  input  logic              train,\n  input  logic              train_branch,\n  input  logic              train_taken,\n  input  logic [31:2]       train_target,''')\n    s = s[:s.index('  logic [63:0] valid_q;')] + f'''  localparam int BTB_BITS = {bits};\n  localparam int BTB_DEPTH = 1 << BTB_BITS;\n  logic [BTB_DEPTH-1:0] valid_q;\n  logic [BTB_DEPTH-1:0] direction_valid_q;\n  localparam int TAG_BITS = 30 - BTB_BITS;\n  logic [TAG_BITS+14:0] entries [0:BTB_DEPTH-1];\n  logic [1:0] directions [0:BTB_DEPTH-1];\n  logic [TAG_BITS-1:0] tag;\n  logic [15:2] successor;\n  logic        hit, branch;\n  logic        train_q, train_branch_q, train_taken_q;\n  logic [31:2] train_pc_q;\n  logic [15:2] train_successor_q;\n  logic page_match_q;\n  logic [BTB_BITS-1:0] fetch_index, train_index;\n  logic [1:0] old_direction, new_direction;\n\n''' + s[s.index('  localparam int INDEX_BITS'):]\n    hashalg=f'pc[{bits+1}:2]' + (f' \"'^ pc[{bits+1+fold}:{2+fold}]'\"' if fold else '')\n    s = s[:s.index('  assign {tag, successor}')] + f'''  function automatic logic [BTB_BITS-1:0] btb_index(input logic [31:2] pc);\n    return {hashalg};\n  endfunction\n\n  assign fetch_index = btb_index(fetch_pc);\n  assign train_index = btb_index(train_pc_q);\n  assign {{tag, branch, successor}} = entries[fetch_index];\n  assign hit = valid_q[fetch_index] && (tag == fetch_pc[31:BTB_BITS+2]) &&\n               (\"'!branch || (direction_valid_q[fetch_index] && directions[fetch_index][1]));\n  assign predicted_pc = hit ? {{fetch_pc[31:16], successor}} : fetch_pc + 30'\"'d1;\n\n  assign old_direction = direction_valid_q[train_index] ? directions[train_index] : 2'b01;\n  assign new_direction = train_taken_q ? (old_direction == 2'b11 ? old_direction : old_direction + 2'b01)\n                                       : (old_direction == 2'b00 ? old_direction : old_direction - 2'b01);\n''' + s[s.index('\\\\n  assign tail_valid'):]\n    s = s.replace('train_successor_q <= resolved_pc[15:2];\\\\n      page_match_q <= resolved_pc[31:16] == train_pc[31:16];', '''train_successor_q <= train_target[15:2];\n      train_branch_q <= train_branch;\n      train_taken_q <= train_taken;\n      page_match_q <= train_target[31:16] == train_pc[31:16];''')\n    s = s.replace(\\\"    if (reset)\\\\n      valid_q <= '0;\\\\n    else if (train_q)\\\\n      valid_q[train_pc_q[7:2]] <= page_match_q;\\\\n    if (train_q)\\\\n      entries[train_pc_q[7:2]] <= {train_pc_q[31:8], train_successor_q};\\\", '''    if (reset) begin\n      valid_q <= '0;\n      direction_valid_q <= '0;\n    end else if (train_q) begin\n      valid_q[train_index] <= page_match_q;\n      if (train_branch_q)\n        direction_valid_q[train_index] <= 1'b1;\n    end\n    if (train_q)\n      entries[train_index] <= {train_pc_q[31:BTB_BITS+2], train_branch_q, train_successor_q};\n    if (train_q && train_branch_q)\n      directions[train_index] <= new_direction;''')\n    path.write_text(s)\n    print(variant, root)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
