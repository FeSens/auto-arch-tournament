{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r13-branch.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tempfile import mkdtemp\nfrom shutil import copytree\nfrom tools.eval.gowin import build_all\n\n\ndef edit(rtl, name, before, after):\n    path = rtl/name\n    t = path.read_text()\n    assert before in t, (name,before)\n    path.write_text(t.replace(before,after,1))\n\n\ndef setup(rtl, forkpc):\n    edit(rtl,'hazard_unit.sv','  input  logic       m_wait,','  input  logic       permit_load_branch,\\\\n  input  logic       m_wait,')\n    edit(rtl,'hazard_unit.sv','ex_valid && id_ex_mem_read','ex_valid && id_ex_mem_read && \"'!permit_load_branch'\"')\n    edit(rtl,'mem_stage.sv','  output logic               dmem_ren,','  output logic               dmem_ren,\\\\n  output logic [31:0]        formatted_load,')\n    edit(rtl,'mem_stage.sv','  // ── MEM/WB register','  assign formatted_load = load_data;\\\\n\\\\n  // ── MEM/WB register')\n    edit(rtl,'ex_stage.sv','  input  logic [31:0]        fwd_ex_mem,','''  input  logic               load_forward_valid,\n  input  logic [1:0]         load_matches,\n  input  logic [1:0]         load_width, load_addr,\n  input  logic               load_sext,\n  input  logic [31:0]        load_raw, load_formatted,\n  input  logic [31:0]        fwd_ex_mem,''')\n    edit(rtl,'ex_stage.sv','  logic        branch_cond;', '''  logic        branch_cond, late_eq, late_branch;\n  logic        load_eq, equal, extension8, extension16;\n  logic [31:0] other;\n  logic [3:0]  eq_byte;\n  logic [1:0]  eq_half;\n  assign late_branch = in.ctrl.is_branch && \"'!in.ctrl.branch_op[2] &&\n                       load_forward_valid && (|load_matches);\n  assign other = load_matches[0] ? rs2 : rs1;\n  for (genvar byte_lane = 0; byte_lane < 4; byte_lane++) begin : gen_byte_eq\n    assign eq_byte[byte_lane] = load_raw[8*byte_lane +: 8] == other[7:0];\n  end\n  assign eq_half[0] = load_raw[15:0] == other[15:0];\n  assign eq_half[1] = load_raw[31:16] == other[15:0];\n  assign extension8 = other[31:8] == {24{load_sext && other[7]}};\n  assign extension16 = other[31:16] == {16{load_sext && other[15]}};\n  assign load_eq = (load_width == 2'\"'d0 && extension8 && eq_byte[load_addr]) ||\n                   (load_width == 2'd1 && extension16 && eq_half[load_addr[1]]) ||\n                   (load_width == 2'd2 && eq_half[0] && load_raw[31:16] == other[31:16]);\n  assign late_eq = (&load_matches) || load_eq;\n  assign equal = late_branch ? late_eq : (rs1 == rs2);''')\n    edit(rtl,'ex_stage.sv','BR_BEQ:  branch_cond = (rs1 == rs2);\\\\n      BR_BNE:  branch_cond = (rs1 \"'!= rs2);'\"','BR_BEQ:  branch_cond = equal;\\\\n      BR_BNE:  branch_cond = \"'!equal;'\"')\n    edit(rtl,'ex_stage.sv','  ctrl_t ctrl_out;','''  logic write_advance, bad_link;\n  assign write_advance = ex_advance && \"'!in.ctrl.is_illegal;\n  assign bad_link = in.ctrl.is_jump && !(in.ctrl.is_jalr ? jalr_aligned : relative_aligned);\n  ctrl_t ctrl_out;'\"''')\n    edit(rtl,'ex_stage.sv','in.ctrl.reg_write && side_effects','in.ctrl.reg_write && write_advance && \"'!bad_link'\"')\n    edit(rtl,'ex_stage.sv','in.ctrl.mem_read  && side_effects','in.ctrl.mem_read  && write_advance')\n    edit(rtl,'ex_stage.sv','in.ctrl.mem_write && side_effects','in.ctrl.mem_write && write_advance')\n    edit(rtl,'ex_stage.sv','? m_rs1_q : rs1;', '? m_rs1_q : (late_branch && load_matches[0] ? load_formatted : rs1);')\n    edit(rtl,'ex_stage.sv','? m_rs2_q : rs2;', '? m_rs2_q : (late_branch && load_matches[1] ? load_formatted : rs2);')\n    edit(rtl,'core.sv','  logic       m_wait, ex_valid;','  logic       m_wait, ex_valid;\\\\n  logic [31:0] formatted_load;')\n    edit(rtl,'core.sv','    .fwd_ex_mem           (ex_mem_w.alu_result),','''    .load_forward_valid   (io_dmemREn),\n    .load_matches         (match_ex_mem),\n    .load_width           (ex_mem_w.ctrl.mem_width),\n    .load_addr            (ex_mem_w.eff_addr[1:0]),\n    .load_sext            (ex_mem_w.ctrl.mem_sext),\n    .load_raw             (io_dmemRData),\n    .load_formatted       (formatted_load),\n    .fwd_ex_mem           (ex_mem_w.alu_result),''')\n    edit(rtl,'core.sv','    .dmem_ren   (io_dmemREn),','    .dmem_ren   (io_dmemREn),\\\\n    .formatted_load (formatted_load),')\n    edit(rtl,'core.sv','    .m_wait         (m_wait),','''    .permit_load_branch ({if_id_w.instr[14:13], if_id_w.instr[6:0]} == 9'b00_1100011),\n    .m_wait         (m_wait),''')\n    edit(rtl,'core.sv','    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write),','    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write && (\"'!ex_mem_w.ctrl.mem_read || io_dmemREn)),'\"')\n    if forkpc:\n        edit(rtl, 'if_stage.sv', '  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;', '  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;\\\\n  logic [31:2] recovery_target_q, recovery_seq_q;\\\\n  logic recovery_dir_q;\\\\n  assign recovery_pc_q = recovery_dir_q ? recovery_target_q : recovery_seq_q;')\n        edit(rtl, 'if_stage.sv', '    if (\"'!recovering)'\"\\\\n      recovery_pc_q <= take_target ? target_pc : sequential_pc;', '    if (\"'!recovering) begin'\"\\\\n      recovery_target_q <= target_pc;\\\\n      recovery_seq_q <= sequential_pc;\\\\n      recovery_dir_q <= take_target;\\\\n    end')\n\n\ndef test(forkpc):\n    base = Path(mkdtemp(prefix=f'bench-r13-branch-{forkpc}-'))\n    rtl = base/'rtl'\n    print(base, flush=True)\n    copytree('cores/bench/rtl',rtl)\n    setup(rtl,forkpc)\n    res = build_all(Path.cwd(),rtl,'fpga/core_bench_si.sv',base)\n    for r in res:\n        print(forkpc,r['place_option'],r['fmax_mhz'],r.get('logic'),r.get('critical_paths',[])[:3],r.get('reason'),flush=True)\n\nwith ThreadPoolExecutor() as pool:\n    jobs = [pool.submit(test, f) for f in (False,True)]\n    for job in jobs:\n        job.result()\nPY\nPYTHONPATH=\\\"\"'$PWD\" python3 -u \"$TMPDIR/bench-r13-branch.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
