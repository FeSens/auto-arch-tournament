{"type": "item.started", "item": {"id": "item_84", "type": "command_execution", "command": "/bin/bash -c 'trial=\"$TMPDIR/bench-predictor.k3uYFP\"\npython - \"$trial/final128/test\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\n\ndirectory=Path(sys.argv[1])\np=directory/'test_if_stage.py'\ns=p.read_text()\ns=s.replace(\n    '    dut, word=None, *, consume=True, redirect=None, train_pc=None, reset=False,',\n    '''    dut, word=None, *, consume=True, redirect=None, train_pc=None,\n    train_target=None, conditional=False, taken=None, reset=False,''',\n)\ns=s.replace(\n    '    dut.target_pc.value = (redirect or 0) >> 2\\\\n    dut.take_target.value = train_pc is not None',\n    '''    dut.target_pc.value = ((redirect or 0) if train_target is None else train_target) >> 2\n    dut.take_target.value = train_pc is not None if taken is None else taken\n    dut.train_conditional.value = conditional''',\n)\ns=s.replace(\n    '''    # Train a self-successor to force the read and fill to share an index.\n    await _step(dut, redirect=12, train_pc=12)\n    assert await _step(dut) == (12, 12, None)''',\n    '''    # Reach the trained self-loop from a normal predicted fetch.\n    await _step(dut, train_pc=12, train_target=12)\n    for pc in (0, 4, 8):\n        assert await _step(dut, priority_word := 0x87654321) == (pc, pc, priority_word)\n    assert await _step(dut) == (12, 12, None)''',\n)\ns=s.replace('    priority_word = 0x87654321\\\\n','',1)\ns=s.replace('    # Both addresses have index zero. Train A -> B and warm B via the redirect.\\\\n    a, b = 0, 0x80000',\n            '    # Both addresses share a replay index within the same predictor page.\\\\n    a, b = 4, 0x804')\ns=s.replace(\n    '''    await _step(dut, redirect=a, train_pc=0x104)\n    assert await _step(dut, new_word) == (a, a, new_word)''',\n    '''    await _step(dut, redirect=a - 4, train_pc=0x104)\n    assert await _step(dut, new_word) == (a - 4, a - 4, new_word)\n    assert await _step(dut, new_word) == (a, a, new_word)''',\n)\ns=s.replace(\n    '''    await _step(dut, redirect=last, train_pc=last)\n    await _step(dut)\n    assert await _step(dut, old_word) == (last, last, old_word)''',\n    '''    await _step(dut, train_pc=last, train_target=last)\n    await _step(dut, redirect=last - 4, train_pc=0x104)\n    assert await _step(dut, old_word) == (last - 4, last - 4, old_word)\n    assert await _step(dut, old_word) == (last, last, old_word)''',\n)\ns=s.replace(\n    '\\\\ndef test_if_stage_runner():',\n    '''\n@cocotb.test()\nasync def tagged_direction_saturates_and_holds_lookup(dut):\n    await _reset_and_scrub(dut)\n    source, target = 4, 0x24\n\n    async def train(taken):\n        await _step(dut, train_pc=source, train_target=target, conditional=True, taken=taken)\n        await _step(dut)\n\n    async def check_successor(expected):\n        await _step(dut, redirect=0, train_pc=0x300)\n        assert await _step(dut) == (0, 0, None)\n        assert await _step(dut, 0x1000) == (0, 0, 0x1000)\n        assert await _step(dut, 0x2000) == (source, source, 0x2000)\n        assert (await _step(dut))[0] == expected\n\n    await train(True)\n    await train(True)\n    await check_successor(target)\n    await train(False)\n    await check_successor(target)\n    await train(False)\n    await check_successor(source + 4)\n\n\ndef test_if_stage_runner():''',\n)\np.write_text(s)\n\np=directory/'test_pipeline.py'\ns=p.read_text()\na=s.index('async def jalr_prediction_recovers_after_stalls')\nb=s.index('\\\\n@cocotb.test()',a)\nt=s[a:b]\nt=t.replace('JAL(0, 0x14 - 0x68)', 'JAL(0, 0x10 - 0x68)')\nt=t.replace('SW(5, 0, 0x44)', 'SW(5, 5, -4)')\nt=t.replace('JAL(0, 0x14 - 0x2C)', 'JAL(0, 0x10 - 0x2C)')\nt=t.replace('[0x40, 0x40, 0x44, 0x44, 0x44]','[0x1C, 0x40, 0x1C, 0x40, 0x44, 0x44, 0x44]')\nt=t.replace('{0x40: 0x20, 0x44: 0x48}', '{0x1C: 0x20, 0x40: 0x20, 0x44: 0x48}')\nt=t.replace('0x60, 0x64, 0x68, 0x14, 0x20, 0x24, 0x28, 0x2C, 0x14, 0x20,','0x60, 0x64, 0x68, 0x10, 0x14, 0x20, 0x24, 0x28, 0x2C, 0x10, 0x14, 0x20,')\ns=s[:a]+t+s[b:]\n\na=s.index('async def stale_prediction_on_load_recovers_during_dmem_stall')\nb=s.index('\\\\n@cocotb.test()',a)\nt=s[a:b]\nt=t.replace('    program = {\\\\n        0x00: ADDI(4, 0, 6),\\\\n        0x04: JAL(0, 0x20 - 0x04),\\\\n        0x08: ADDI(2, 1, 1),\\\\n        0x0C: EBREAK(),\\\\n        0x20: JAL(0, 0x04 - 0x20),\\\\n    }','''    program, startup = _replay_warmup(0x04)\n    program.update({\n        0x04: ADDI(4, 0, 6),\n        0x08: JAL(0, 0x20 - 0x08),\n        0x0C: ADDI(2, 1, 1),\n        0x10: EBREAK(),\n        0x20: JAL(0, 0x04 - 0x20),\n    })''')\nt=t.replace('program[0x04] = LW', 'program[0x08] = LW')\nt=t.replace('dmem_stalls={0: 3}, bus_trace=bus,', 'dmem_stalls={0: 3}, bus_trace=bus, max_cycles=700,')\nt=t.replace('== [0x00, 0x04, 0x20, 0x04, 0x08, 0x0C]', '== startup + [0x04, 0x08, 0x20, 0x04, 0x08, 0x0C, 0x10]')\nt=t.replace('if pc == 0x04]', 'if pc == 0x08]')\nt=t.replace('== [0x04, 0x08, 0x20]', '== [0x08, 0x0C, 0x20]')\nt=t.replace('== [0x04, 0x20, 0x08, 0x0C, 0x10, 0x14, 0x18]', '== [0x08, 0x20, 0x0C, 0x10, 0x14, 0x18, 0x1C]')\nt=t.replace('load, use = rets[3:5]', 'load, use = rets[-3:-1]')\nt=t.replace('load[\\\"pc_next\\\"] == 0x08', 'load[\\\"pc_next\\\"] == 0x0C')\ns=s[:a]+t+s[b:]\n\na=s.index('async def fence_i_invalidates_replay_entry')\nb=s.index('\\\\n@cocotb.test()',a)\nt=s[a:b]\nt=t.replace('    patched =', '    approach = entry - 4\\\\n    patched =',1)\nt=t.replace('        entry: JAL(0, target - entry),','        approach: NOP(),\\\\n        entry: JAL(0, target - entry),')\nfor pc in ('0x68', '0x18', '0x58'):\n t=t.replace(f'JAL(0, entry - {pc})', f'JAL(0, approach - {pc})')\nt=t.replace('body = [entry, target,', 'body = [approach, entry, target,')\ns=s[:a]+t+s[b:]\np.write_text(s)\nPY\ncd \\\"\"'$trial/final128\" && MAKEFLAGS=-j3 python -m pytest -q test/test_pipeline.py test/test_if_stage.py > scratch-cocotb.log 2>&1\nresult=$?\nif test \"$result\" = 0; then\n tail -8 \"$trial/final128/scratch-cocotb.log\"\nelse\n rg -n '\"'test_(if_stage|pipeline)\\\\..*failed|AssertionError:|ERROR .*runner' \\\"\"'$trial/final128/scratch-cocotb.log\"\nfi\nexit \"$result\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
