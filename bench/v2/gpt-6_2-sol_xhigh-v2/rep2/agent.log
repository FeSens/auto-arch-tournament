3][\\\"cycle\\\"] == first[\\\"cycle\\\"] + 2\n    assert retired[7][\\\"cycle\\\"] == second[\\\"cycle\\\"] + 1\n''')\np=suite/'test_div_unit.py'\np.write_text(p.read_text() + '''\n\n@cocotb.test()\nasync def signed_prefix_capture(dut):\n    await _setup(dut)\n    dividends = (-0x80000000, -0x7FFFFFFF, -0x30000001, -0x30000000,\n                 -0x2FFFFFFF, 0x30000000, 0x30000001)\n    divisors = (-257, -256, -255, -17, -16, -15, -1, 0, 1, 15, 16, 17,\n                255, 256, 257)\n    for a in dividends:\n        for b in divisors:\n            if b:\n                quotient = abs(a) // abs(b)\n                if (a < 0) \"'!= (b < 0):\n                    quotient = -quotient\n                remainder = a - b * quotient\n            else:\n                quotient, remainder = -1, a\n            await _check_result(dut, ALU_DIV, a, b, quotient)\n            await _check_acceptance(dut)\n            await _check_result(dut, ALU_REM, a, b, remainder)\n            await _check_acceptance(dut)\n'\"''')\nPY\ncd \\\"\"'$scratch/carry\"\npytest -q -p no:cacheprovider --rootdir=. test/test_pipeline.py test/test_div_unit.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
