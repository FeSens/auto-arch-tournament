20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[9045 of 12117 chars elided by tools/bench/transcript.py; sha256:c39e0173133cfe40]…\n_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\ncores/bench/rtl/if_stage.sv:1:// rtl/if_stage.sv\ncores/bench/rtl/if_stage.sv:16:module if_stage (\ncores/bench/rtl/hazard_unit.sv:1:// rtl/hazard_unit.sv\ncores/bench/rtl/hazard_unit.sv:19:module hazard_unit (\ncores/bench/rtl/ex_stage.sv:1:// rtl/ex_stage.sv\ncores/bench/rtl/ex_stage.sv:15:module ex_stage (\ncores/bench/rtl/core.sv:9://   +- stall <- hazard_unit (load-use)\ncores/bench/rtl/core.sv:98:  if_stage u_if (\ncores/bench/rtl/core.sv:137:  ex_stage u_ex (\ncores/bench/rtl/core.sv:174:  hazard_unit u_hazard (\ncores/bench/rtl/core_pkg.sv:74:  // IF -> ID combinational bundle (no register; PC reg sits in if_stage).\ncores/bench/test/test_pipeline.py:350:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:352:            \"hazard_unit.sv\", \"forward_unit.sv\",\n.\n..\nCORE_PHILOSOPHY.md\ncore.yaml\nexperiments\nrtl\ntest\n", "exit_code": 0, "status": "completed"}}
