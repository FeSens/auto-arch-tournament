{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport os\np = Path(os.environ['TMPDIR']) / 'div-study'\nfor name in ('queue4', 'queue-head'):\n    f = p / name / 'rtl/ex_stage.sv'\n    text = f.read_text()\n    old = '  assign mispredict       = ex_advance && \"'!successor_match;'\"'\n    new = \\\"  // FENCE.I discards prefetched instructions before resuming at pc+4.\\\\n  assign mispredict       = ex_advance && (\"'!successor_match || in.instr[14:12] == 3'\"'d1 && in.instr[6:0] == 7'h0f);\\\"\n    assert old in text\n    f.write_text(text.replace(old, new))\nPY\npython -u - <<'PY'\nimport os\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.gowin import build_all, summarize\nroot=Path(os.environ['TMPDIR'])/'div-study'\ndef run(design):\n    p=root/design\n    results=build_all(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',p/'timing')\n    print(design, summarize(results), flush=True)\n    for r in results:\n        print(design,r['place_option'],r.get('critical_paths',[None])[0], flush=True)\nwith ThreadPoolExecutor() as ex:\n    tuple(ex.map(run, ['queue4','queue-head']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
