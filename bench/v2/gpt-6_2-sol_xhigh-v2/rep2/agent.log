ady.value == 1\n\n\nasync def _check_unsigned_pair(dut, a, b):\n    quotient, remainder = divmod(a, b) if b else (MASK32, a)\n    await _check_result(dut, ALU_DIVU, a, b, quotient)\n    await _check_acceptance(dut)\n    await _check_result(dut, ALU_REMU, a, b, remainder)\n    await _check_acceptance(dut)\n\n\nasync def\n…[4312 of 7384 chars elided by tools/bench/transcript.py; sha256:7ea30b241659acaf]…\nd_b\n            await _check_unsigned_pair(dut, a, b)\n            await _check_signed_pair(dut, signed_a, signed_b)\n\n\n@cocotb.test()\nasync def deferred_acceptance(dut):\n    await _setup(dut)\n    for op, a, b, expected in (\n        (ALU_DIV, -271, 10, -27),\n        (ALU_REMU, 0xFFFFFFFF, 4096, 4095),\n        (ALU_REM, -0x71234567, 0, -0x71234567),\n    ):\n        dut.result_ready.value = 0\n        await _check_result(dut, op, a, b, expected)\n        _drive_request(dut, ALU_REMU, 102, 13)\n        for _ in range(4):\n            await _tick(dut)\n            assert dut.request_ready.value == 0\n            assert dut.result_valid.value == 1\n            assert dut.result.value == (expected & MASK32)\n        dut.result_ready.value = 1\n        await _check_acceptance(dut)\n\n    await _check_result(dut, ALU_REMU, 102, 13, 11)\n    await _check_acceptance(dut)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
