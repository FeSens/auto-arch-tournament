e []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[12070 of 15142 chars elided by tools/bench/transcript.py; sha256:3e33f5e9deb42280]…\n['iter_per_cycle'] * 1_000_000  # iter/sec\n    return {\n        **fp,\n        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n        'fitness':       round(fitness, 2),\n        'cycles':        cm['cycles'],\n        'iterations':    cm['iterations'],\n    }\n\nif __name__ == '__main__':\n    import sys\n    result = run_fpga_eval(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 79.292\n  lut4: 7539\n  ff: 1104\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261120-003-r7s2\n  updated: '2026-11-20T08:11:27.290823Z'\n", "exit_code": 0, "status": "completed"}}
