fer_load ? late_addr_low \"'!= 0 : rs1_plus_imm[1:0] != 0)) ||\n                         (in.ctrl.mem_width == 2'\"'d1 &&\n                          (defer_load ? late_addr_low[0] : rs1_plus_imm[0]));''')\ns = s.replace('(in.ctrl.is_branch && branch_cond)', '(in.ctrl.is_branch && \"'!defer_branch && branch_cond)'\"')\ns = s.replace('ex_advance && (fence_i || \"'!successor_match)'\"', 'ex_advance && \"'!defer_branch && (fence_i || !successor_match)'\"')\ns = s.replace('side_effects && (in.ctrl.is_branch || in.ctrl.is_jump)', 'side_effects && \"'!defer_branch && (in.ctrl.is_branch || in.ctrl.is_jump)'\"')\ns = s.replace('in.ctrl.reg_write && side_effects;', 'in.ctrl.reg_write && side_effects && \"'!(in.ctrl.mem_read && load_misalign);'\"')\ns = s.replace('      reg_q.eff_addr      <= rs1_plus_imm;', '''      reg_q.eff_addr      <= rs1_plus_imm;\n      reg_q.late_load     <= defer_load && ex_advance;\n      reg_q.late_offset   <= in.imm[1:0];\n      reg_q.late_branch   <= defer_branch && ex_advance;\n      reg_q.late_from_load <= {fwd_rs2_sel[2], fwd_rs1_sel[2]};\n      reg_q.late_other     <= fwd_rs1_sel[2] ? rs2 : rs1;\n      reg_q.late_sequential <= pc_plus4[31:2];\n      reg_q.late_target     <= relative_target[31:2];\n      reg_q.late_aligned    <= relative_aligned;\n      reg_q.late_seq_match  <= pc_plus4 == next_issue_pc;\n      reg_q.late_target_match <= relative_target == next_issue_pc;''')\np.write_text(s)\n\np = rtl / 'mem_stage.sv'\ns = p.read_text()\ns = s.replace('  output mem_wb_t  out', '''  output logic late_mispredict,\n  output logic late_train,\n  output logic [31:2] late_pc,\n  output logic [1:0] load_data_low,\n  output mem_wb_t  out''')\na = s.index('  always_comb begin')\ns = s[:a] + \\\"\\\"\\\"  mem_wb_t reg_q;\n  logic late_equal, late_taken, late_fault;\n  logic [31:0] effective_addr;\n\n  assign effective_addr = in.late_load ? reg_q.write_result + {30'b0, in.late_offset}\n                                        : in.eff_addr;\n  assign late