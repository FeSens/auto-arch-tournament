{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/4876824c/bf7d2cca/bench-r11-veprb4la')\nbench=Path('cores/bench/rtl')\nfor variant in ('pc-compare', 'pc-compare-order', 'pc-compare-r8'):\n    dst=root/variant\n    shutil.copytree(bench if variant == 'pc-compare-r8' else root/'recovery-only', dst)\n    p=dst/'ex_stage.sv'\n    s=p.read_text()\n    begin=s.index('  // Compare each candidate')\n    end=s.index('  assign fence_i', begin)\n    s=s[:begin]+'''  // Check each word-address addition without propagating its carry.\n  function automatic logic sum_matches_pc(\n    input logic [29:0] base, offset, expected\n  );\n    logic [29:0] inverse, sum_bits, carry_bits;\n    inverse = ~expected;\n    sum_bits = base \"'^ offset ''^ inverse;\n    carry_bits = ((base & offset) | ((base | offset) & inverse)) << 1;\n    sum_matches_pc = &(sum_bits ''^ carry_bits);\n  endfunction\n\n  logic sequential_match, relative_match;\n  assign sequential_match = sum_matches_pc(in.pc[31:2], 30'\"'d1, next_issue_pc[31:2]);\n  assign relative_match = sum_matches_pc(in.pc[31:2], in.imm[31:2], next_issue_pc[31:2]);\n  assign successor_match  = (use_jalr       && jalr_match) ||\n                            (use_relative   && relative_match) ||\n                            (use_sequential && sequential_match);\n'''+s[end:]\n    s=s.replace('(relative_target[1:0] == 2\\\\'b00)', '\"'!in.imm[1]'\"')\n    if variant == 'pc-compare-order':\n        begin=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n        end=s.index('  assign pc_plus4',begin)\n        s=s[:begin]+'''  logic [3:0] byte_eq, byte_lt;\n  logic unsigned_lt, signed_lt;\n  for (genvar lane = 0; lane < 4; lane++) begin : gen_cmp\n    assign byte_eq[lane] = rs1[8*lane +: 8] == rs2[8*lane +: 8];\n    assign byte_lt[lane] = rs1[8*lane +: 8] < rs2[8*lane +: 8];\n  end\n  assign unsigned_lt = byte_lt[3] || (byte_eq[3] && byte_lt[2]) ||\n                       ((&byte_eq[3:2]) && byte_lt[1]) || ((&byte_eq[3:1]) && byte_lt[0]);\n  assign signed_lt = (rs1[31] \"'!= rs2[31]) ? rs1[31] : unsigned_lt;\n  assign branch_cond = (in.ctrl.branch_op[2] ?\n                        (in.ctrl.branch_op[1] ? unsigned_lt : signed_lt) : (&byte_eq)) ''^\n                       in.ctrl.branch_op[0];\n\n'\"'''+s[end:]\n    p.write_text(s)\nPY\npython - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path('/srv/hwebench/tmp/4876824c/bf7d2cca/bench-r11-veprb4la')\nvariants = ('pc-compare', 'pc-compare-order', 'pc-compare-r8')\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    futs = [(name, executor.submit(build_all, Path.cwd(), root / name, 'fpga/core_bench_si.sv', root / ('gowin-' + name))) for name in variants]\n    for name, fut in futs:\n        records = fut.result()\n        print(name, summarize(records), flush=True)\n        print([(r['place_option'], [(p['from'], p['to']) for p in r.get('critical_paths', [])[:3]]) for r in records], flush=True)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
