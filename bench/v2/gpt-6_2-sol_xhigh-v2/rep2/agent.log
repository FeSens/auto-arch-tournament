s[current] = new_state\n     if kind == 'global':\n      table[((a >> 2) \"'^ hist)&1023] = new_state\n     local_hist = ((local_hist << 1) | taken) & 7\n     hist = ((hist << 1) | taken) & 63\n    seen[idx] = a,target,states,local_hist\n   if size <= 256 or (not hashed and kind in ('\"'last','perfect_cond')):\n    print(size, hashed, kind, sum(misses.values()), misses, 'top', [(hex(pc), n) for pc,n in pc_misses.most_common(3)], flush=True)\nPY\npython3 \\\"\"'$scratch/profile.py\" \"$scratch/retired.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
