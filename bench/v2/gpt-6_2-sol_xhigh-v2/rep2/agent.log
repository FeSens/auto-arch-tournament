{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/test/test_div_unit.py; git branch -a --list '*r4s*'\"", "aggregated_output": "\"\"\"Check RV32M division arithmetic and the EX divider handshake.\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _tick(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut, result_ready=1):\n    dut.reset.value = 1\n    dut.request_valid.value = 0\n    dut.result_ready.value = result_ready\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _tick(dut)\n    dut.reset.value = 0\n\n\ndef _drive_request(dut, op, a, b):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.request_valid.value = 1\n\n\nasync def _check_result(dut, op, a, b, expected):\n    assert dut.request_ready.value == 1\n    _drive_request(dut, op, a, b)\n    await _tick(dut)  # capture\n    dut.request_valid.value = 0\n\n    for _ in range(7):\n        assert dut.request_ready.value == 0\n        assert dut.result_valid.value == 0\n        await _tick(dut)\n\n    assert dut.request_ready.value == 0\n    assert dut.result_valid.value == 1\n    actual = int(dut.result.value)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_acceptance(dut):\n    await _tick(dut)  # result transfer, eight rising edges after capture if ready\n    assert dut.result_valid.value == 0\n    assert dut.request_ready.value == 1\n\n\n@cocotb.test()\nasync def division_vectors(dut):\n    await _setup(dut)\n    # Requests start in the first cycle available after the preceding transfer.\n    vectors = [\n        (ALU_DIV, 10, 3, 3),\n        (ALU_DIV, -4, 2, -2),\n        (ALU_DIV, 7, -2, -3),\n        (ALU_DIV, 123, 0, -1),\n        (ALU_DIV, 0, 0, -1),\n        (ALU_DIV, -123, 0, -1),\n        (ALU_DIV, -0x80000000, -1, -0x80000000),\n        (ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF),\n        (ALU_\n…[1610 of 4682 chars elided by tools/bench/transcript.py; sha256:7fe71259d57b55b9]…\nor in (\n                (ALU_DIVU, a, b, a // b),\n                (ALU_REMU, a, b, a % b),\n                (ALU_DIV, signed_a, signed_b, quotient),\n                (ALU_REM, signed_a, signed_b, signed_a - quotient * signed_b),\n            ):\n                await _check_result(dut, *vector)\n                await _check_acceptance(dut)\n\n\n@cocotb.test()\nasync def deferred_acceptance(dut):\n    await _setup(dut, result_ready=0)\n    await _check_result(dut, ALU_DIV, -271, 10, -27)\n    _drive_request(dut, ALU_REMU, 102, 13)\n    for _ in range(4):\n        await _tick(dut)\n        assert dut.request_ready.value == 0\n        assert dut.result_valid.value == 1\n        assert dut.result.value == (-27 & MASK32)\n\n    dut.result_ready.value = 1\n    await _check_acceptance(dut)\n    await _check_result(dut, ALU_REMU, 102, 13, 11)\n    await _check_acceptance(dut)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
