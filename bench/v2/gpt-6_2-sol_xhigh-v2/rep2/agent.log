{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\n\nfrom pathlib import Path\nrtl=Path(\\\"cores/bench/rtl\\\")\ndef edit(file,old,new):\n    p=rtl/file\n    t=p.read_text()\n    assert old in t, (file,old)\n    p.write_text(t.replace(old,new))\n\nedit('hazard_unit.sv','  input  logic       ex_valid,', '''  input  logic       load_branch_bypass,\n  input  logic       ex_valid,''')\nedit('hazard_unit.sv','                        && (id_ex_rd \"'!= 5'\"\\\\'b0)',\\\"                        && \"'!load_branch_bypass && (id_ex_rd != 5'\"'b0)\\\")\nedit('core.sv','  logic [2:0] fwd_rs1_sel, fwd_rs2_sel;', '''  logic [2:0] fwd_rs1_sel, fwd_rs2_sel;\n  logic [31:0] load_value;\n  logic        load_branch_bypass;\n\n  assign load_branch_bypass = id_ex_w.ctrl.mem_read &&\n                              if_id_w.instr[6:0] == 7'b1100011 &&\n                              if_id_w.instr[14:13] == 2'b00 &&\n                              (id_ex_w.ctrl.mem_width \"'!= 2'\"'d2 ||\n                               if_id_w.instr[19:15] == 5'd0 || if_id_w.instr[24:20] == 5'd0 ||\n                               if_id_w.instr[19:15] == if_id_w.instr[24:20]);''')\nedit('core.sv','    .fwd_mem_wb           (wb_w_data),', '''    .load_match           (match_ex_mem & {2{io_dmemREn}}),\n    .load_width           (ex_mem_w.ctrl.mem_width),\n    .load_sext            (ex_mem_w.ctrl.mem_sext),\n    .load_lane            (ex_mem_w.eff_addr[1:0]),\n    .load_raw             (io_dmemRData),\n    .load_value           (load_value),\n    .fwd_mem_wb           (wb_w_data),''')\nedit('core.sv','    .dmem_rdata (io_dmemRData),','    .dmem_rdata (io_dmemRData),\\\\n    .load_data  (load_value),')\nedit('core.sv','    .ex_valid       (ex_valid),','    .ex_valid       (ex_valid),\\\\n    .load_branch_bypass (load_branch_bypass),')\nedit('core.sv','    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write),','    .ex_mem_w_en  (ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.ctrl.mem_read),'\"')\nedit('mem_stage.sv','  input  logic [31:0] dmem_rdata,','  input  logic [31:0] dmem_rdata,\\\\n  output logic [31:0] load_data,')\nedit('mem_stage.sv','  logic [31:0] load_data;\\\\n','')\nedit('ex_stage.sv','  input  logic [31:0]        fwd_mem_wb,', '''  input  logic [1:0]         load_match,\n  input  logic [1:0]         load_width,\n  input  logic               load_sext,\n  input  logic [1:0]         load_lane,\n  input  logic [31:0]        load_raw,\n  input  logic [31:0]        load_value,\n  input  logic [31:0]        fwd_mem_wb,''')\nedit('ex_stage.sv','  logic        branch_cond;', '''  logic        branch_cond, branch_eq, bypass_eq, bypass_branch;\n  logic [31:0] load_other;\n  logic [3:0]  byte_eq, word_chunk_eq;\n  logic [1:0]  half_eq;\n  logic        byte_ext_ok, half_ext_ok;\n  assign bypass_branch = (|load_match) && in.ctrl.is_branch && in.ctrl.branch_op[2:1] == 2'b00;\n  assign load_other = load_match[0] ? rs2 : rs1;\n  assign byte_ext_ok = load_other[31:8] == {24{load_sext && load_other[7]}};\n  assign half_ext_ok = load_other[31:16] == {16{load_sext && load_other[15]}};\n  for (genvar lane = 0; lane < 4; lane++) begin : gen_load_compare\n    assign byte_eq[lane] = load_raw[8*lane +: 8] == load_other[7:0];\n    assign word_chunk_eq[lane] = load_raw[8*lane +: 8] == load_other[8*lane +: 8];\n  end\n  for (genvar half = 0; half < 2; half++) begin : gen_load_compare_half\n    assign half_eq[half] = load_raw[16*half +: 16] == load_other[15:0];\n  end\n  always_comb begin\n    case (load_width)\n      2'd0: bypass_eq = byte_ext_ok && byte_eq[load_lane];\n      2'd1: bypass_eq = half_ext_ok && half_eq[load_lane[1]];\n      default: bypass_eq = &word_chunk_eq;\n    endcase\n  end\n  assign branch_eq = bypass_branch ? ((&load_match) || bypass_eq) : (rs1 == rs2);''')\nedit('ex_stage.sv','BR_BEQ:  branch_cond = (rs1 == rs2);','BR_BEQ:  branch_cond = branch_eq;')\nedit('ex_stage.sv','BR_BNE:  branch_cond = (rs1 \"'!= rs2);'\"','BR_BNE:  branch_cond = \"'!branch_eq;'\"')\nedit('ex_stage.sv','(is_mul || is_div) ? m_rs1_q : rs1;', '(is_mul || is_div) ? m_rs1_q : (bypass_branch && load_match[0] ? load_value : rs1);')\nedit('ex_stage.sv','(is_mul || is_div) ? m_rs2_q : rs2;', '(is_mul || is_div) ? m_rs2_q : (bypass_branch && load_match[1] ? load_value : rs2);')\nedit('ex_stage.sv','logic        ex_advance, side_effects;', 'logic        ex_advance, side_effects, live_legal;')\nedit('ex_stage.sv','  assign side_effects     = ex_advance && \"'!in.ctrl.is_illegal && !misalign_fault;'\"', '''  assign live_legal       = ex_advance && \"'!in.ctrl.is_illegal;\n  assign side_effects     = live_legal && !misalign_fault;'\"''')\nedit('ex_stage.sv','    ctrl_out.reg_write  = in.ctrl.reg_write && side_effects;\\\\n    ctrl_out.mem_read   = in.ctrl.mem_read  && side_effects;\\\\n    ctrl_out.mem_write  = in.ctrl.mem_write && side_effects;', '''    ctrl_out.reg_write  = in.ctrl.reg_write && live_legal &&\n                          (\"'!in.ctrl.is_jump || (in.ctrl.is_jalr ? jalr_aligned : relative_aligned));\n    ctrl_out.mem_read   = in.ctrl.mem_read  && live_legal;\n    ctrl_out.mem_write  = in.ctrl.mem_write && live_legal;'\"''')\nedit('if_stage.sv','  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;', '  logic [31:2] pc_q, recovery_target_q, recovery_seq_q, fetch_pc, predicted_pc;')\nedit('if_stage.sv','  assign fetch_pc = correction_pending ? recovery_pc_q : pc_q;', '''  assign fetch_pc = ({30{\"'!correction_pending}} & pc_q) |\n                    ({30{correction_pending && take_target_q}} & recovery_target_q) |\n                    ({30{correction_pending && !take_target_q}} & recovery_seq_q);'\"''')\nedit('if_stage.sv','recovery_pc_q','recovery_target_q')\nedit('if_stage.sv','''    if (\"'!recovering)\n      recovery_target_q <= take_target ? target_pc : sequential_pc;\n    take_target_q        <= take_target;'\"''','''    if (\"'!recovering) begin\n      recovery_target_q <= target_pc;\n      recovery_seq_q    <= sequential_pc;\n      take_target_q     <= take_target;\n    end'\"''')\n\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
