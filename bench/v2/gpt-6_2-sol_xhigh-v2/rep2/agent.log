{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nfrom tempfile import gettempdir\n\nroot = Path(gettempdir()) / 'bench-r8s0'\nfor variant, direct in (('split-stream', False), ('split-stream-bypass', True)):\n    path = root / variant / 'rtl'\n    shutil.copytree(Path('cores/bench/rtl'), path, dirs_exist_ok=True)\n    if_path = path / 'if_stage.sv'\n    f = if_path.read_text()\n    f = f.replace('(* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] stream_words', '''(* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] stream_head [0:31];\n  (* syn_ramstyle = \\\"block_ram\\\" *) logic [31:0] stream_words''')\n    f = f.replace('  logic [31:0] replay_word;', '''  logic [31:0] replay_word, ram_word_q, fill_forward_word_q;\n  logic [3:0]  next_stream_offset;\n  logic [8:0]  read_word_addr, write_word_addr;\n  logic        fill_forward_q;''')\n    f = f.replace('  assign replay_word = stream_words[{stream_row_q, stream_offset_q}];', '''  assign next_stream_offset = stream_offset_q + 4'(fetch_accept);\n  assign read_word_addr = {stream_row_q, next_stream_offset};\n  assign write_word_addr = {fill_row_q, fill_offset_q};\n  assign replay_word = (stream_offset_q == 0) ? stream_head[stream_row_q]\n                      : (fill_forward_q ? fill_forward_word_q : ram_word_q);\n\n  // Offset zero uses the asynchronous head, so the BRAM read address\n  // comes from the ongoing stream even when a different stream launches.\n  always_ff @(posedge clock) begin\n    ram_word_q <= stream_words[read_word_addr];\n    if (fill_valid_q && fill_offset_q \"'!= 0)\n      stream_words[write_word_addr] <= fill_word_q;\n    fill_forward_q <= fill_valid_q && read_word_addr == write_word_addr;\n    fill_forward_word_q <= fill_word_q;\n  end'\"''')\n    f = f.replace('      stream_words[{fill_row_q, fill_offset_q}] <= fill_word_q;',\n                  '''      if (fill_offset_q == 0)\n        stream_head[fill_row_q] <= fill_word_q;''')\n    if direct:\n        f = f.replace('  // Ready bus data can bypass to decode. Replay enters through the queue.\\\\n  assign decode_valid = \"'!empty || imem_ready;'\"','  assign decode_valid = \"'!empty || imem_ready || replay_available;'\"')\n        f = f.replace('assign out = empty ? {imem_addr, imem_data}', 'assign out = empty ? {imem_addr, fetch_word}')\n    if_path.write_text(f)\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom tools.eval.gowin import build_all, summarize\nworktree = Path.cwd()\nfor name in ('split-stream-bypass', 'split-stream'):\n    variant = Path(gettempdir()) / 'bench-r8s0' / name\n    results = build_all(worktree, variant / 'rtl', 'fpga/core_bench_si.sv', variant / 'timing')\n    print(name, summarize(results))\n    for result in results:\n        print(result['place_option'], result.get('critical_paths', [])[:3])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nfrom tempfile import gettempdir\n\nroot = Path(gettempdir()) / 'bench-r8s0'\nfor variant, carry in (('queued-successor', False), ('queued-carry', True)):\n    path = root / variant / 'rtl'\n    shutil.copytree(Path('cores/bench/rtl'), path, dirs_exist_ok=True)\n    if carry:\n        shutil.copy(root / 'carry-check' / 'rtl/ex_stage.sv', path)\n    p = path / 'core_pkg.sv'\n    s = p.read_text().replace('    logic [31:0] pc;\\\\n    logic [31:0] instr;', '    logic [31:0] pc;\\\\n    logic [31:2] predicted_next;\\\\n    logic [31:0] instr;', 1)\n    s = s.replace('    logic [31:0] pc;\\\\n    logic [31:0] rs1_val;', '    logic [31:0] pc;\\\\n    logic [31:2] predicted_next;\\\\n    logic [31:0] rs1_val;', 1)\n    p.write_text(s)\n    p = path / 'core.sv'\n    p.write_text(p.read_text().replace('.next_issue_pc        (if_id_w.pc)',\\\".next_issue_pc        ({id_ex_w.predicted_next, 2'b00})\\\"))\n    p = path / 'id_stage.sv'\n    p.write_text(p.read_text().replace('      reg_q.pc       <= in.pc;', '      reg_q.pc       <= in.pc;\\\\n      reg_q.predicted_next <= in.predicted_next;'))\n    p = path / 'if_stage.sv'\n    s = p.read_text().replace('  // Each RAM word is {PC, instruction}.','  // Each RAM word is {predicted successor, instruction}.').replace('logic [63:0] queue', 'logic [61:0] queue')\n    s = s.replace('  logic [31:0] fetch_word;', '  logic [31:0] fetch_word;\\\\n  logic [31:2] decode_pc_q;')\n    s = s.replace('''  // When decode holds, the first buffered PC takes over from imem_addr\n  // at the same address. EX can compare against it throughout the hold.\n  assign out = empty ? {imem_addr, imem_data} : queue[read_ptr_q[1:0]];''', '''  assign out.pc = target_pending_q ? imem_addr : {decode_pc_q, 2'b00};\n  assign {out.predicted_next, out.instr} = empty ? {predicted_pc, imem_data}\n                                                   : queue[read_ptr_q[1:0]];\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      decode_pc_q <= '0;\n    else if (decode_accept)\n      decode_pc_q <= out.predicted_next;\n    else if (target_pending_q)\n      decode_pc_q <= recovery_pc;\n  end''')\n    s = s.replace('queue[write_ptr_q[1:0]] <= {imem_addr, fetch_word};', 'queue[write_ptr_q[1:0]] <= {predicted_pc, fetch_word};')\n    p.write_text(s)\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nfrom tempfile import gettempdir\nfrom tools.eval.gowin import build_all, summarize\nworktree = Path.cwd()\nfor name in ('queued-successor', 'queued-carry'):\n    variant = Path(gettempdir()) / 'bench-r8s0' / name\n    results = build_all(worktree, variant / 'rtl', 'fpga/core_bench_si.sv', variant / 'timing')\n    print(name, summarize(results))\n    for result in results:\n        print(result['place_option'], result.get('critical_paths', [])[:3])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
