kg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[12352 of 15424 chars elided by tools/bench/transcript.py; sha256:184784539fa4663f]…\n  'ipc_coremark':  round(cm['iter_per_cycle'], 6),\ntools/eval/fpga.py:387:        'cycles':        cm['cycles'],\ntools/eval/cosim.py:24:def _build_cosim_env(worktree, target: str | None,\ntools/eval/cosim.py:42:# Stall modes for the full-trace comparison. The stalled mode uses the same\ntools/eval/cosim.py:44:# memory port stalls (which V2 now times and scores) is trace-checked too.\ntools/eval/cosim.py:45:TRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\ntools/eval/cosim.py:48:def run_one(elf: Path, sim_bin: str, worktree: str, env: dict | None = None,\ntools/eval/cosim.py:70:def run_coremark_crc(coremark_elf: Path, sim_bin: str, worktree: str, env: dict | None = None) -> dict:\ntools/eval/cosim.py:87:             \"--bench\", \"--istall\", \"--dstall\"],\ntools/eval/cosim.py:113:                'detail': 'maxcycles hit before ebreak'}\ntools/eval/cosim.py:125:def run_cosim(worktree: str, target: str | None = None) -> dict:\ntools/eval/cosim.py:169:    # 2. CoreMark CRC validation (sequential — runs the 500M-cycle sim).\n", "exit_code": 0, "status": "completed"}}
