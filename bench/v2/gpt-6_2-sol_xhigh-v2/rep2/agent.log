signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd,\n…[7179 of 10251 chars elided by tools/bench/transcript.py; sha256:86496cc03932832b]…\nnsn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert all(r[\"trap\"] == 0 for r in rets)\n    _, load, store, divide, use, _ = rets\n    assert load[\"rd_wdata\"] == 100\n    assert store[\"mem_addr\"] == 4 and store[\"mem_wmask\"] == 0xF\n    assert store[\"mem_wdata\"] == dmem[4] == 7\n    assert store[\"cycle\"] - load[\"cycle\"] == 4\n    assert divide[\"cycle\"] - store[\"cycle\"] == 9\n    assert divide[\"rs1_rdata\"] == 100 and divide[\"rs2_rdata\"] == 7\n    assert divide[\"rd\"] == 3 and divide[\"rd_wdata\"] == 14\n    assert use[\"cycle\"] - divide[\"cycle\"] == 1\n    assert use[\"rs1_rdata\"] == 14 and use[\"rd_wdata\"] == 16\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\nlrwxrwxrwx 1 nobody nogroup 18 Sep 28 02:57 /srv/hwebench/toolchain -> /opt/hwe-toolchain\n", "exit_code": 0, "status": "completed"}}
