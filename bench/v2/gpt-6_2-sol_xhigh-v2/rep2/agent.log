{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r11-veprb4la/pc_fallback.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nroot=Path(__file__).resolve().parent\nvariants=(('split-fallback', 'early-forward-split'), ('split-fallback-rf', 'early-forward-split'),\n          ('split-fallback-mul', 'mul-mem-timed'))\nfor variant, src in variants:\n    dst=root/variant\n    shutil.copytree(root/src, dst)\n    p=dst/'if_stage.sv'\n    s=p.read_text()\n    s=s.replace('  assign predicted_pc = hit ? successor : fetch_pc + 30\\\\'d1;', '''  logic [31:2] fallback_pc;\n  assign fallback_pc = target_pending ? recovery_pc_q + 30'd1 : pc_q + 30'd1;\n  assign predicted_pc = hit ? successor : fallback_pc;''')\n    s=s.replace('<= \"'!target_pending && miss_target;'\"', '<= miss_target;')\n    s=s.replace('<= \"'!target_pending && miss_sequential;'\"', '<= miss_sequential;')\n    p.write_text(s)\n    if variant == 'split-fallback-rf':\n        p=dst/'reg_file.sv'\n        s=p.read_text()\n        a=s.index('  always_comb begin')\n        b=s.index('\\\\nendmodule', a)\n        body=''\n        for operand in (1, 2):\n            body+=f'''  logic bypass_rs{operand}, use_lo_rs{operand}, use_hi_rs{operand};\n  assign bypass_rs{operand} = write_reg && w_addr == rs{operand}_addr;\n  assign use_lo_rs{operand} = \"'!bypass_rs{operand} && !rs{operand}_addr[4] && written_q[rs{operand}_addr];\n  assign use_hi_rs{operand} = !bypass_rs{operand} && rs{operand}_addr[4] && written_q[rs{operand}_addr];\n  assign rs{operand}_data = ({{32{{bypass_rs{operand}}}}} & w_data) |\n                    ({{32{{use_lo_rs{operand}}}}} & regs_lo[rs{operand}_addr[3:0]]) |\n                    ({{32{{use_hi_rs{operand}}}}} & regs_hi[rs{operand}_addr[3:0]]);\n\n'\"'''\n        p.write_text(s[:a]+body+s[b:])\nPY\npython \\\"\"'$TMPDIR/bench-r11-veprb4la/pc_fallback.py\"\npython - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path('/srv/hwebench/tmp/4876824c/bf7d2cca/bench-r11-veprb4la')\nvariants = ('split-fallback', 'split-fallback-rf', 'split-fallback-mul')\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    futs = [(name, executor.submit(build_all, Path.cwd(), root / name, 'fpga/core_bench_si.sv', root / ('gowin-' + name))) for name in variants]\n    for name, fut in futs:\n        records = fut.result()\n        print(name, summarize(records), flush=True)\n        print([(r['place_option'], [(p['from'], p['to']) for p in r.get('critical_paths', [])[:3]]) for r in records], flush=True)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
