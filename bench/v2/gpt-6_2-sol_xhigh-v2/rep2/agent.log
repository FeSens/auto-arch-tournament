{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/4876824c/bf7d2cca/bench-r11-veprb4la')\nfor variant, src in [('split-miss', 'recovery-only'), ('split-miss-pc', 'pc-compare'), ('split-miss-collision', 'retimed')]:\n    dst=root/variant\n    shutil.copytree(root/src, dst)\n    p=dst/'core.sv'\n    s=p.read_text()\n    assert 'decode_ready && decode_valid)' in s\n    s=s.replace('logic        mispredict, recovering, train, take_target;', 'logic        miss_target, miss_sequential, recovering, train, take_target;')\n    s=s.replace('.mispredict      (mispredict),', '.miss_target     (miss_target),\\\\n    .miss_sequential (miss_sequential),')\n    s=s.replace('.mispredict           (mispredict),', '.miss_target          (miss_target),\\\\n    .miss_sequential      (miss_sequential),')\n    assert 'mispredict' not in s\n    p.write_text(s)\n    p=dst/'ex_stage.sv'\n    s=p.read_text()\n    s=s.replace('  output logic               mispredict,', '  output logic               miss_target,\\\\n  output logic               miss_sequential,')\n    s=s.replace('use_sequential, successor_match;', 'use_sequential;')\n    if 'function automatic logic sum_matches_pc' not in s:\n        s=s.replace('  // Compare each candidate in parallel with branch direction and target type.', '''  logic sequential_match, relative_match;\n  assign sequential_match = pc_plus4 == next_issue_pc;\n  assign relative_match = relative_target == next_issue_pc;''')\n    a=s.index('  assign successor_match')\n    b=s.index('  assign fence_i', a)\n    s=s[:a]+s[b:]\n    s=s.replace('  assign mispredict       = ex_advance && (fence_i || \"'!successor_match);'\"', '''  assign miss_target      = ex_advance && (fence_i || \"'!(in.ctrl.is_jalr ? jalr_match : relative_match));\n  assign miss_sequential  = ex_advance && (fence_i || !sequential_match);'\"''')\n    p.write_text(s)\n    p=dst/'if_stage.sv'\n    s=p.read_text()\n    s=s.replace('  input  logic              mispredict,', '  input  logic              miss_target,\\\\n  input  logic              miss_sequential,')\n    s=s.replace('logic        train_q, target_pending_q;', '''logic        train_q, target_pending, fresh_redirect;\n  logic        miss_target_q, miss_sequential_q, take_target_q;\n  logic        pending_hold_q, recovering_hold_q;\n\n  assign fresh_redirect = take_target_q ? miss_target_q : miss_sequential_q;\n  assign target_pending = fresh_redirect || pending_hold_q;\n  assign recovering = target_pending || recovering_hold_q;''')\n    s=s.replace('target_pending_q', 'target_pending')\n    a=s.index('  always_ff @(posedge clock) begin\\\\n    if (reset)\\\\n      invalidate')\n    b=s.index('  assign read_enable', a)\n    s=s[:a]+'''  assign invalidate = fresh_redirect && \"'!train_q;\n'\"'''+s[b:]\n    a=s.index('      target_pending <=')\n    b=s.index('\\\\n    end', a)\n    s=s[:a]+'''      pending_hold_q    <= 1'b0;\n      recovering_hold_q <= 1'b0;\n      miss_target_q     <= 1'b0;\n      miss_sequential_q <= 1'b0;'''+s[b:]\n    a=s.index('      target_pending <=')\n    b=s.index('\\\\n    end', a)\n    s=s[:a]+'''      pending_hold_q    <= target_pending && \"'!imem_ready;\n      recovering_hold_q <= recovering && !(decode_ready && (!empty || fetch_available));\n      miss_target_q     <= !target_pending && miss_target;\n      miss_sequential_q <= !target_pending && miss_sequential;'\"'''+s[b:]\n    a=s.index('    if (\"'!target_pending)'\"')\n    b=s.index('    train_pc_q', a)\n    s=s[:a]+'''    if (\"'!target_pending) begin\n      recovery_pc_q <= take_target ? target_pc : sequential_pc;\n      take_target_q <= take_target;\n    end\n'\"'''+s[b:]\n    assert 'mispredict ' not in s\n    p.write_text(s)\nPY\npython - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path('/srv/hwebench/tmp/4876824c/bf7d2cca/bench-r11-veprb4la')\nvariants = ('split-miss', 'split-miss-pc', 'split-miss-collision')\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    futs = [(name, executor.submit(build_all, Path.cwd(), root / name, 'fpga/core_bench_si.sv', root / ('gowin-' + name))) for name in variants]\n    for name, fut in futs:\n        records = fut.result()\n        print(name, summarize(records), flush=True)\n        print([(r['place_option'], [(p['from'], p['to']) for p in r.get('critical_paths', [])[:3]]) for r in records], flush=True)\nPY\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
