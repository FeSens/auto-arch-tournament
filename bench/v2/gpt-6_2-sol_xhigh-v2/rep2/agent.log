{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -c \"R8_LOOK='/srv/hwebench/tmp/4876824c/7a4a8d78/r8s1-lookahead.m3ahotnc' python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nroot=Path(os.environ['R8_LOOK'])\nfor size,mode in ((512,'enable'),(1024,'enable'),(256,'lutram')):\n    variant=root/f'{size}_{mode}'\n    source=root/f'{size}_forward' if mode=='enable' else root/f'{size}_bypass'\n    variant.mkdir()\n    target=variant/'cores'/'bench'\n    target.mkdir(parents=True)\n    for directory in ('rtl','test'):\n      shutil.copytree(source/'cores'/'bench'/directory,target/directory)\n    shutil.copy(source/'cores'/'bench'/'core.yaml',target)\n    for directory in ('fpga','bench','test'):\n      shutil.copytree(source/directory,variant/directory)\n    shutil.copy(source/'Makefile',variant)\n    p=target/'rtl'/'if_stage.sv'\n    s=p.read_text()\n    if mode=='enable':\n        s=s.replace('fetch_accept ? predicted_pc[INDEX_BITS+1:2] : fetch_pc[INDEX_BITS+1:2]', 'predicted_pc[INDEX_BITS+1:2]')\n        s=s.replace('    replay_read_q <= replay_entries[replay_index];', '    if (fetch_accept)\\\\n      replay_read_q <= replay_entries[replay_index];')\n        s=s.replace('    write_enable_q <= write_enable;\\\\n    write_index_q <= write_index;\\\\n    bypass_entry_q <= write_entry;',\n                    '    if (fetch_accept) begin\\\\n      write_enable_q <= write_enable;\\\\n      write_index_q <= write_index;\\\\n      bypass_entry_q <= write_entry;\\\\n    end')\n    else:\n        s=s.replace('syn_ramstyle = \\\"block_ram\\\"','syn_ramstyle = \\\"distributed_ram\\\"')\n        s=s.replace('replay_read_q, bypass_entry_q, replay_entry, write_entry','replay_entry, write_entry')\n        s=s.replace('replay_index, write_index','write_index')\n        s=s.replace('  logic [31:2] replay_pc, replay_pc_q;\\\\n','')\n        s=s.replace('invalidate, clear_q, bypass_q','invalidate, clear_q')\n        s=s.replace('  assign replay_pc = fetch_accept ? predicted_pc : fetch_pc;\\\\n','')\n        s=s.replace('  assign replay_index = replay_pc[INDEX_BITS+1:2];\\\\n','')\n        s=s.replace('bypass_q ? bypass_entry_q : replay_read_q','replay_entries[pc_q[INDEX_BITS+1:2]]')\n        s=s.replace('replay_pc_q == fetch_pc','\"'!target_pending_q'\"')\n        s=s.replace('    replay_read_q <= replay_entries[replay_index];\\\\n','')\n        s=s.replace('    replay_pc_q <= replay_pc;\\\\n','')\n        s=s.replace('    bypass_q <= write_enable && write_index == replay_index;\\\\n','')\n        s=s.replace('    bypass_entry_q <= write_entry;\\\\n','')\n    p.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
