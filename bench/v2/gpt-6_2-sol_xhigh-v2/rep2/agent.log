{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r3-coremark/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nbase = Path(sys.argv[1])\nfor name in ['native', 'limbs', 'address']:\n    rtl = base / name / 'rtl'\n    shutil.copytree(root/'cores/bench/rtl', rtl)\n    def edit(file, old, new):\n        path = rtl / file\n        original = path.read_text()\n        assert original.count(old) == 1, (name, file, old)\n        path.write_text(original.replace(old, new))\n\n    if name == 'address':\n        edit('core_pkg.sv', '    logic [31:0] write_data;', '    logic [31:0] mem_address;\\\\n    logic [31:0] write_data;')\n        edit('ex_stage.sv', '      reg_q.write_data', '      reg_q.mem_address   <= jalr_sum;\\\\n      reg_q.write_data')\n        path = rtl/'mem_stage.sv'\n        path.write_text(path.read_text().replace('in.alu_result', 'in.mem_address').replace('reg_q.alu_result <= in.mem_address;', 'reg_q.alu_result <= in.alu_result;'))\n        continue\n\n    alu = rtl/'alu.sv'\n    source = alu.read_text()\n    low = source.index('\"'`ifndef RISCV_FORMAL_ALTOPS'\"')\n    high = source.index('    case (op)')\n    source = source[:low] + '  always_comb begin\\\\n    shamt = b[4:0];\\\\n' + source[high:]\n    low = source.index('      // M-extension.')\n    high = source.index('      default:  out', low)\n    alu.write_text(source[:low] + source[high:])\n\n    if name == 'native':\n        width = 64\n        calc = \\\"\\\"\\\"  logic signed [32:0] wide_a, wide_b;\n  assign wide_a = \"'$signed({signed_a && a[31], a});\n  assign wide_b = $signed({signed_b && b[31], b});\n  assign partials = 64'\"'(wide_a * wide_b);\n\\\"\\\"\\\"\n        finish = '  assign result = high_half ? partials[63:32] : partials[31:0];\\\\n'\n    else:\n        width = 134\n        calc = \\\"\\\"\\\"  logic signed [16:0] alo, blo, ahi, bhi;\n  logic [31:0] ll;\n  logic signed [33:0] hl, lh, hh;\n  assign alo = \"'$signed({1'\"'b0, a[15:0]});\n  assign blo = \"'$signed({1'\"'b0, b[15:0]});\n  assign ahi = \"'$signed({signed_a && a[31], a[31:16]});\n  assign bhi = $signed({signed_b && b[31], b[31:16]});\n  assign ll = a[15:0] * b[15:0];\n  assign hl = ahi * blo;\n  assign lh = alo * bhi;\n  assign hh = ahi * bhi;\n  assign partials = {hh, hl, lh, ll};\n\"\"\"\n        finish = \"\"\"  logic [47:0] ll, hl, lh, hh, sum0, carry0, sum1, carry1, upper;\n  logic [63:0] product;\n  assign ll = {32'\"'b0, partials[31:16]};\n  assign lh = {{14{partials[65]}}, partials[65:32]};\n  assign hl = {{14{partials[99]}}, partials[99:66]};\n  assign hh = {partials[131:100], 16'b0};\n  assign sum0 = ll \"'^ lh ''^ hl;\n  assign carry0 = ((ll & lh) | (ll & hl) | (lh & hl)) << 1;\n  assign sum1 = sum0 ''^ carry0 ''^ hh;\n  assign carry1 = ((sum0 & carry0) | (sum0 & hh) | (carry0 & hh)) << 1;\n  assign upper = sum1 + carry1;\n  assign product = {upper, partials[15:0]};\n  assign result = high_half ? product[63:32] : product[31:0];\n\"\"\"\n    (rtl/'\"'mul_unit.sv').write_text(f\\\"\\\"\\\"module mul_ex (\n  input logic [4:0] op,\n  input logic [31:0] a, b,\n  output logic [{width-1}:0] partials,\n  output logic high_half\n);\n  assign high_half = op \"'!= ALU_MUL;\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] result;\n  always_comb begin\n    case (op)\n      ALU_MUL:    result = (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   result = (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  result = (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: result = (a - b) \"'^ 32'\"'hecfbe137;\n      default: result = 32'b0;\n    endcase\n  end\n  assign partials = {{{width-32}'b0, result}};\n\"'`else\n  logic signed_a, signed_b;\n  assign signed_a = op == ALU_MULH || op == ALU_MULHSU;\n  assign signed_b = op == ALU_MULH;\n{calc}`endif\nendmodule\n\nmodule mul_mem (\n  input logic [{width-1}:0] partials,\n  input logic high_half,\n  output logic [31:0] result\n);\n`ifdef RISCV_FORMAL_ALTOPS\n  assign result = partials[31:0];\n`else\n{finish}`endif\nendmodule\n\"\"\")\n    edit('\"'core_pkg.sv', '    logic [31:0] write_data;', f'    logic [{width-1}:0] mul_partials;\\\\n    logic mul_pending, mul_high;\\\\n    logic [31:0] write_data;')\n    edit('ex_stage.sv', '  output logic               div_wait,', '  output logic               mul_late,\\\\n  output logic               div_wait,')\n    edit('ex_stage.sv', '  logic        is_div,', f\\\"\\\"\\\"  logic [{width-1}:0] mul_partials;\n  logic mul_high;\n  assign mul_late = in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH ||\n                    in.ctrl.alu_op == ALU_MULHU || in.ctrl.alu_op == ALU_MULHSU;\n  mul_ex u_mul (.op(in.ctrl.alu_op), .a(rs1), .b(rs2),\n                .partials(mul_partials), .high_half(mul_high));\n\n  logic        is_div,\\\"\\\"\\\")\n    edit('ex_stage.sv', '      reg_q.write_data', '      reg_q.mul_partials  <= mul_partials;\\\\n      reg_q.mul_pending   <= mul_late && ex_advance;\\\\n      reg_q.mul_high      <= mul_high;\\\\n      reg_q.write_data')\n    edit('mem_stage.sv', '  mem_wb_t reg_q;', '  mem_wb_t reg_q;\\\\n  logic [31:0] mul_result;\\\\n  mul_mem u_mul_finish (.partials(in.mul_partials), .high_half(in.mul_high), .result(mul_result));')\n    edit('mem_stage.sv', 'reg_q.alu_result <= in.alu_result;', 'reg_q.alu_result <= in.mul_pending ? mul_result : in.alu_result;')\n    edit('core.sv', '  logic       div_wait, ex_valid;', '  logic       div_wait, ex_valid, mul_late;')\n    edit('core.sv', '    .ex_valid        (ex_valid),','    .ex_valid        (ex_valid),\\\\n    .mul_late        (mul_late),')\n    edit('core.sv', '.id_ex_mem_read (id_ex_w.ctrl.mem_read),','.id_ex_mem_read (id_ex_w.ctrl.mem_read || mul_late),')\n    edit('core.sv', '.ex_mem_w_en (ex_mem_w.ctrl.reg_write),','.ex_mem_w_en (ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.mul_pending),'\"')\nPY\npython3 \\\"\"'$TMPDIR/bench-r3-coremark/prototype.py\" \"$TMPDIR/bench-r3-coremark\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
