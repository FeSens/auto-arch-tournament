 if_id_t queue_q [0:DEPTH-1];\n  if_id_t response;\n  logic queued, dequeue, fetch, enqueue;\n\n  assign queued = count_q != 0 && !recovering;\n  assign head_ready = queued || imem_ready;\n  assign dequeue = queued && accept;\n  assign fetch = imem_ready && (recovering || count_q < (PTR_W+1)'\"'(DEPTH) || dequeue);\n  assign enqueue = fetch && (queued || \"'!accept);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_q <= '\"'0;\n      recovering <= 1'b0;\n      count_q <= '0;\n      head_q <= '0;\n      tail_q <= '0;\n    end else begin\n      if (fetch)\n        pc_q <= predicted_pc;\n      recovering <= mispredict || (recovering && \"'!fetch);\n\n      if (recovering) begin\n        count_q <= {{PTR_W{1'\"'b0}}, enqueue};\n        head_q <= '0;\n        tail_q <= {{(PTR_W-1){1'b0}}, enqueue};\n        if (enqueue)\n          queue_q[0] <= response;\n      end else begin\n        if (enqueue) begin\n          queue_q[tail_q] <= response;\n          tail_q <= tail_q + 1'b1;\n        end\n        if (dequeue)\n          head_q <= head_q + 1'b1;\n        case ({enqueue, dequeue})\n          2'b10: count_q <= count_q + 1'b1;\n          2'b01: count_q <= count_q - 1'b1;\n          default: ;\n        endcase\n      end\n    end\n\n    if (\"'!recovering)\n      recovery_pc_q <= resolved_pc;\n  end\n\n  assign imem_addr = {fetch_pc, 2'\"'b00};\n  assign response = {imem_addr, imem_data, predicted_pc};\n  assign out = queued ? queue_q[head_q] : response;\nendmodule\n'''\nf.write_text(s)\nPY\nprofile_dir=/srv/hwebench/tmp/4876824c/8df95641/bench_profile\nRTL_DIR=\\\"\"'$profile_dir/queue\" OBJ_DIR=\"$profile_dir/queue_obj\" NRET=1 bash test/cosim/build.sh > \"$profile_dir/queue_build.log\" 2>&1 &&\n\"$profile_dir/queue_obj/cosim_sim\" \"$profile_dir/coremark.elf\" 10000000 --bench --istall --dstall'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
