{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile/profile.py' <<'PY'\nimport collections\nimport json\nimport pathlib\nimport subprocess\nimport sys\n\nfrom tools.eval.fpga import validate_coremark_uart\n\nscratch = pathlib.Path(sys.argv[1])\ncommand = [str(scratch / 'obj/cosim_sim'), str(scratch / 'coremark.elf'), '6000000', '--istall', '--dstall']\nrun = subprocess.run(command + ['--bench'], capture_output=True, text=True, check=True)\nresult = json.loads(run.stdout.splitlines()[-1])\nassert result['bench_bracketed'] and result['ebreak'] and not result['oob']\nprint(result, flush=True)\nprint(validate_coremark_uart(result['uart']), flush=True)\nstart, stop = result['bench_start_cycle'], result['bench_stop_cycle']\nprint('marked cycles', stop - start, flush=True)\nrs1_opcodes = {0x03, 0x13, 0x23, 0x33, 0x63, 0x67}\nrs2_opcodes = {0x23, 0x33, 0x63}\narchitectural = collections.Counter()\ngap_counts = collections.Counter()\npcs = collections.defaultdict(collections.Counter)\nprevious = None\nwith subprocess.Popen(command, stdout=subprocess.PIPE) as trace:\n    for line in trace.stdout:\n        record = json.loads(line)\n        cycle = record['cycle']\n        if not start <= cycle < stop:\n            previous = None\n            continue\n        inst = record['insn']\n        op = inst & 0x7f\n        funct = (inst >> 12) & 7\n        if previous and (previous['insn'] & 0x7f) == 0x03 and previous['rd_addr']:\n            rd = previous['rd_addr']\n            raw1 = (inst >> 15) & 31\n            raw2 = (inst >> 20) & 31\n            rs1 = op in rs1_opcodes and rd == raw1\n            rs2 = op in rs2_opcodes and rd == raw2\n            if rs1 or rs2:\n                kind = ('dependency', op, funct, rs1, rs2)\n            elif rd in (raw1, raw2):\n                kind = ('alias', op, funct, False, False)\n            else:\n                kind = None\n            if kind:\n                architectural[kind] += 1\n                gap_counts[kind] += cycle - previous['cycle'] > 1\n                pcs[kind][record['pc_rdata']] += 1\n        previous = record\n    assert trace.wait() == 0\nfor key, n in architectural.most_common():\n    print(key[0], hex(key[1]), *key[2:], n, gap_counts[key], [(hex(p), count) for p, count in pcs[key].most_common(4)])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python '\"'/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile/profile.py' '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile' > '/srv/hwebench/tmp/4876824c/8571b2eb/bench-r10-profile/profile.log'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
