{"type":"item.completed","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/mul_unit.sv'","aggregated_output":"// Shared RV32M limb products for a pipelined low half and blocking high halves.\nmodule mul_unit (\n  input  logic        clock,\n  input  logic        reset,\n  // EX advances a low multiply on this edge. Its result goes to MEM/WB\n  // on the next edge, which can also capture a new set of limbs here.\n  input  logic        low_launch,\n  output logic [31:0] low_result,\n  // High-half requests own the shared registers until the result transfers.\n  input  logic        request_valid,\n  output logic        request_ready,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        result_valid,\n  input  logic        result_ready,\n  output logic [31:0] result\n);\n\n  typedef enum logic [1:0] {IDLE, PRODUCTS, HIGH_RESULT} phase_t;\n  phase_t phase_q;\n  logic capture_high, capture;\n\n  assign request_ready = (phase_q == IDLE);\n  assign capture_high = request_valid && request_ready;\n  assign capture = !reset && (low_launch || capture_high);\n  assign result_valid = (phase_q == HIGH_RESULT);\n\n  // A high half registers its cross-term carry after launch and transfers\n  // one edge later. The low path leaves the high-half FSM idle.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      phase_q <= IDLE;\n    end else if (capture_high) begin\n      phase_q <= PRODUCTS;\n    end else if (phase_q == PRODUCTS) begin\n      phase_q <= HIGH_RESULT;\n    end else if (result_valid && result_ready) begin\n      phase_q <= IDLE;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_result;\n  always_comb begin\n    case (op)\n      ALU_MUL:    alt_result = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   alt_result = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  alt_result = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: alt_result = (a - b) ^ 32'hecfbe137;\n      default:    alt_result = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (capture)\n      result <= alt_result;\n  end\n  assign low_result = result;\n`else\n  logic signed [16:0] a_lo, b_lo, a_hi, b_hi;\n  logic        [31:0] low_low_q, high_high_q;\n  logic signed [33:0] low_high_q, high_low_q;\n  logic        [33:0] low_carry, sum_bits, carry_bits;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [33:0] middle;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic        [15:0] middle_low;\n  logic        [31:0] middle_high_q;\n\n  assign a_lo = $signed({1'b0, a[15:0]});\n  assign b_lo = $signed({1'b0, b[15:0]});\n  assign a_hi = $signed({a[31] && (op == ALU_MULH || op == ALU_MULHSU), a[31:16]});\n  assign b_hi = $signed({b[31] && (op == ALU_MULH), b[31:16]});\n\n  // Compress the two signed cross products and the unsigned low-product\n  // carry before the single carry-propagate addition.\n  assign low_carry  = {18'b0, low_low_q[31:16]};\n  assign sum_bits   = low_high_q ^ high_low_q ^ low_carry;\n  assign carry_bits = ((low_high_q & high_low_q) |\n                       ((low_high_q | high_low_q) & low_carry)) << 1;\n  assign middle = $signed(sum_bits + carry_bits);\n  // Modulo 2^32 discards the high-high term and all carry past bit 31.\n  assign middle_low = sum_bits[15:0] + carry_bits[15:0];\n  assign low_result = {middle_low, low_low_q[15:0]};\n\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      low_low_q   <= a_lo * b_lo;\n      low_high_q  <= a_lo * b_hi;\n      high_low_q  <= a_hi * b_lo;\n      high_high_q <= a_hi * b_hi;\n    end\n    if (phase_q == PRODUCTS)\n      middle_high_q <= {{14{middle[33]}}, middle[33:16]};\n  end\n\n  assign result = high_high_q + middle_high_q;\n`endif\n\nendmodule\n","exit_code":0,"status":"completed"}}
