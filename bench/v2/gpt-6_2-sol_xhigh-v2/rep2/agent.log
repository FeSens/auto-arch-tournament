{"type":"item.completed","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/reg_file.sv'","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// Reset clears the written bitmap. The data banks have asynchronous reads\n// and no array reset so Gowin can infer distributed RAM for both ports.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_lo [0:15];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [31:0] regs_hi [0:15];\n  logic [31:0] written_q;\n  logic        write_reg;\n\n  assign write_reg = w_en && (w_addr != 5'b0);\n\n  always_ff @(posedge clock) begin\n    if (!reset && write_reg && !w_addr[4])\n      regs_lo[w_addr[3:0]] <= w_data;\n    if (!reset && write_reg && w_addr[4])\n      regs_hi[w_addr[3:0]] <= w_data;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      written_q <= '0;\n    else if (write_reg)\n      written_q[w_addr] <= 1'b1;\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (write_reg && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else if (written_q[rs1_addr])\n      rs1_data = rs1_addr[4] ? regs_hi[rs1_addr[3:0]] : regs_lo[rs1_addr[3:0]];\n    else\n      rs1_data = 32'b0;\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (write_reg && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else if (written_q[rs2_addr])\n      rs2_data = rs2_addr[4] ? regs_hi[rs2_addr[3:0]] : regs_lo[rs2_addr[3:0]];\n    else\n      rs2_data = 32'b0;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
