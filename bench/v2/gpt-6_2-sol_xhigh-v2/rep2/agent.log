{"type": "item.started", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c 'set -e\nscratch=/srv/hwebench/tmp/4876824c/8a23b80d/bench-r3s1.9yfM6wt8\npython3 - \"$scratch\" <<'\"'PY'\n\nfrom pathlib import Path\nimport sys\n\nt = Path(sys.argv[1]) / \\\"cores/bench/test\\\"\nalu = t / \\\"test_alu.py\\\"\nat = alu.read_text()\nmultests = at[at.index(\\\"@cocotb.test()\\\\nasync def mul(\\\"):at.index(\\\"\\\\ndef test_alu_runner()\\\")]\nalu.write_text(at[:at.index(\\\"@cocotb.test()\\\\nasync def mul(\\\")] + at[at.index(\\\"def test_alu_runner()\\\"):])\n(t / \\\"test_mul_unit.py\\\").write_text('''\\\"\\\"\\\"Exercise the real clocked multiplier.\\\"\\\"\\\"\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb\n\nMASK = 0xffffffff\n\n\nasync def _tick(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \\\"ns\\\")\n\n\nasync def _setup(dut):\n    dut.reset.value = 1\n    dut.request_valid.value = 0\n    dut.result_ready.value = 1\n    cocotb.start_soon(Clock(dut.clock, 10, \\\"ns\\\").start())\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected, hold=0):\n    assert dut.request_ready.value == 1\n    dut.op.value = op\n    dut.a.value = a & MASK\n    dut.b.value = b & MASK\n    dut.request_valid.value = 1\n    dut.result_ready.value = (hold == 0)\n    await _tick(dut)\n    dut.request_valid.value = 0\n    if op \"'!= ALU_MUL:\n        assert dut.result_valid.value == 0\n        await _tick(dut)\n    for _ in range(hold + 1):\n        assert dut.request_ready.value == 0\n        assert dut.result_valid.value == 1\n        assert int(dut.result.value) == (expected & MASK), (op, a, b, expected)\n        if _ < hold:\n            await _tick(dut)\n    dut.result_ready.value = 1\n    await _tick(dut)\n    assert dut.request_ready.value == 1\n    assert dut.result_valid.value == 0\n\n\ndef signed(a):\n    return a - (1 << 32) if a & (1 << 31) else a\n\n\n@cocotb.test()\nasync def full_bit_and_limb_boundary_values(dut):\n    await _setup(dut)\n    rng = random.Random(11793)\n    edges = [0, 1, 0xfffe, 0xffff, 0x10000, 0x10001, 0x7fffffff,\n             0x80000000, 0x8000ffff, 0xffff0000, 0xfffffffe, 0xffffffff]\n    inputs = [(a, b) for a in edges for b in edges]\n    inputs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(512))\n    for a, b in inputs:\n        await _check(dut, ALU_MUL, a, b, a * b)\n        await _check(dut, ALU_MULH, a, b, (signed(a) * signed(b)) >> 32)\n        await _check(dut, ALU_MULHSU, a, b, (signed(a) * b) >> 32)\n        await _check(dut, ALU_MULHU, a, b, (a * b) >> 32)\n    await _check(dut, ALU_MUL, 0x75430001, 0x1234ffff, 0x75430001 * 0x1234ffff, hold=5)\n    await _check(dut, ALU_MULHSU, 0x80000001, MASK, (signed(0x80000001) * MASK) >> 32, hold=5)\n\n\n@cocotb.test()\nasync def reset_during_multiply(dut):\n    await _setup(dut)\n    dut.op.value = ALU_MULHU\n    dut.a.value = MASK\n    dut.b.value = MASK\n    dut.request_valid.value = 1\n    await _tick(dut)\n    dut.request_valid.value = 0\n    dut.reset.value = 1\n    await _tick(dut)\n    assert dut.result_valid.value == 0\n    assert dut.request_ready.value == 1\n    dut.reset.value = 0\n    await _check(dut, ALU_MUL, 6, 7, 42)\n\n\n'\"''' + multests + '''\ndef test_mul_unit_runner():\n    run_cocotb(toplevel=\\\"mul_unit\\\",\n               sources=[\\\"core_pkg.sv\\\", \\\"mul_unit.sv\\\"],\n               test_module=\\\"test_mul_unit\\\")\n''')\ndiv = t / \\\"test_div_unit.py\\\"\ns = div.read_text()\nanchor = \\\"def test_div_unit_runner():\\\"\ns = s.replace(anchor, '''@cocotb.test()\nasync def first_two_bit_trials(dut):\n    await _setup(dut)\n    for prefix in range(4):\n        for divisor in range(5):\n            dividend = prefix << 30 | 0x3560beef\n            quo = dividend // divisor if divisor else MASK32\n            rem = dividend % divisor if divisor else dividend\n            await _check_result(dut, ALU_DIVU, dividend, divisor, quo)\n            await _check_acceptance(dut)\n            await _check_result(dut, ALU_REMU, dividend, divisor, rem)\n            await _check_acceptance(dut)\n\n\n''' + anchor)\ndiv.write_text(s)\npipe = t / \\\"test_pipeline.py\\\"\ns = pipe.read_text().replace('\\\"alu.sv\\\", \\\"div_unit.sv\\\",', '\\\"alu.sv\\\", \\\"div_unit.sv\\\", \\\"mul_unit.sv\\\",')\npipe.write_text(s)\n\nPY\npytest -q -o cache_dir=\\\"\"'$scratch/pytest_cache\" \"$scratch/cores/bench/test\" > \"$scratch/m_cocotb.log\" 2>&1\ntail -n 8 \"$scratch/m_cocotb.log\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
