t SHIFT = (digit % 2 \"'!= 0) ? 0 : (digit % 4 != 0) ? 1 : 2;\n    localparam int ODD_FACTOR = digit >> SHIFT;\n    logic [35:0] multiple;\n    assign multiple = odd_multiple_q[ODD_FACTOR / 2] << SHIFT;\n    assign {label}_diff[digit] = {{1'\"'b0, {label}_trial}} - {{1'b0, multiple[31:0]}};\n    assign {label}_borrow[digit] = (|multiple[35:32]) || {label}_diff[digit][32];\n  end\n  for (genvar digit = 0; digit < {count}; digit++) begin : gen_{label}_select\n    assign {label}_take[digit] = \"'!{label}_borrow[digit] && {label}_borrow[digit+1];\n  end\n  always_comb begin\n    {label}_remainder = '\"'0;\n    {label}_digit = '0;\n    for (int digit = 0; digit < {count}; digit++) begin\n      {label}_remainder |= {{32{{{label}_take[digit]}}}} & {label}_diff[digit][31:0];\n      {label}_digit |= {{{bits}{{{label}_take[digit]}}}} & {bits}'(digit);\n    end\n  end\n\\\"\\\"\\\"\nbegin = s.index(\\\"  always_comb begin\\\\n    next_remainder = '0;\\\")\nend = s.index('  always_ff @(posedge clock) begin',begin)\ns = s[:begin]+slice_digit('high', high, f'{{partial_remainder_q[{31-high}:0], dividend_quotient_q[31:{32-high}]}}')+slice_digit('low', low, f'{{high_remainder[{31-low}:0], dividend_quotient_q[{31-high}:28]}}')+\\\"\\\"\\\"\n  assign quotient_digit = {high_digit, low_digit};\n  assign next_remainder = low_remainder;\n\n\\\"\\\"\\\"+s[end:]\ndiv.write_text(s)\nPY\npython3 \\\"\"'$scratch/div_staged.py\" div22 2 2\npython3 \"$scratch/div_staged.py\" div13 1 3\npython3 \"$scratch/div_staged.py\" div31 3 1\nfor candidate in if_press if_spec_read if_packed_spec if_candidate_pc if_spec_collision; do\n  printf '\"'%s ' \\\"\"'$candidate\"\n  rg -o '\"'[0-9.]+\\\\(MHz\\\\)\\\\s+[0-9.]+\\\\(MHz\\\\)' \\\"\"'$scratch/$candidate/gowin_p1/impl/pnr/core_bench.tr\" 2>/dev/null || tail -1 \"$scratch/$candidate/gowin_p1/gw.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
