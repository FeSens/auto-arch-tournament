{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/test/test_pipeline.py')\nanchor = '\\\\n\\\\n@cocotb.test()\\\\nasync def illegal_traps(dut):'\ndirected_case = '''\n\n@cocotb.test()\nasync def effective_addresses_cross_page_under_backpressure(dut):\n    store_byte = _s(2, 2, 1, 0b000, 0b0100011)\n    load_unsigned_byte = _i(0xFFF, 4, 0b100, 5, 0b0000011)\n    load_signed_byte = _i(1, 4, 0b000, 6, 0b0000011)\n    misaligned_load = LW(7, 4, 1)\n    program = [\n        ADDI(2, 0, -5),\n        0x000010b7,  # LUI x1, 1\n        ADDI(1, 1, -1),\n        store_byte,\n        ADDI(4, 1, 1),\n        load_unsigned_byte,\n        load_signed_byte,\n        misaligned_load,\n        ADDI(8, 0, -4),\n        LW(9, 8, 8),\n        EBREAK(),\n    ]\n    bus = []\n    rets, dmem = await _run(\n        dut, program, {4: 123, 0xFFC: 0xAABBCCDD, 0x1000: 0x11223344},\n        dmem_stalls={0x1001: 3, 0xFFF: 2}, bus_trace=bus,\n    )\n    assert [r['order'] for r in rets] == list(range(len(program)))\n    assert [r['insn'] for r in rets] == program\n    assert [(addr, wen) for _, addr, wen in bus if wen] == [(0x1001, 2)] * 4\n    assert dmem[0x1000] == 0x1122FB44\n    [store] = _by_insn(rets, store_byte)\n    [unsigned] = _by_insn(rets, load_unsigned_byte)\n    [signed] = _by_insn(rets, load_signed_byte)\n    [misaligned] = _by_insn(rets, misaligned_load)\n    [wrapped] = _by_insn(rets, LW(9, 8, 8))\n    assert (store['mem_addr'], store['mem_wmask']) == (0x1000, 2)\n    assert (unsigned['mem_addr'], unsigned['mem_rmask'], unsigned['rd_wdata']) == (0xFFC, 8, 0xAA)\n    assert (signed['mem_addr'], signed['mem_rmask'], signed['rd_wdata']) == (0x1000, 2, 0xFFFFFFFB)\n    assert (misaligned['trap'], misaligned['mem_rmask'], misaligned['rd']) == (1, 0, 0)\n    assert (wrapped['mem_addr'], wrapped['mem_rmask'], wrapped['rd_wdata']) == (4, 15, 123)\n'''\nsrc = p.read_text()\nass