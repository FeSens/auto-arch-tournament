{"type":"item.completed","item":{"id":"item_98","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nn=4008388\ns=49800000*10/n\nprint(s, 100*(s/117.93-1), 117.93*1.046, (117.93*1.046)*n/1e7)\nPY\nsed -n '1,160p' /srv/hwebench/tmp/4876824c/8df95641/bench_profile/mapped_ring2_p16/if_stage.sv\"","aggregated_output":"124.23946983176279 5.3501821688822115 123.35478 49.445381989464\n// rtl/if_stage.sv\n//\n// Instruction fetch with a tagged last-successor predictor. ID sees the\n// raw instruction bus and captures the addressed instruction on accept.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              accept,\n  input  logic              imem_ready,\n  output logic              head_ready,\n  input  logic              mispredict,\n  input  logic [31:2]       resolved_pc,\n  input  logic              train,\n  input  logic [31:2]       train_pc,\n  output logic              recovering,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [31:2] pc_q, recovery_pc_q, fetch_pc, predicted_pc;\n  logic [63:0] valid_q;\n  // One asynchronous lookup and one synchronous write. Only the valid\n  // bits need reset, so the tag and successor can map to distributed RAM.\n  logic [37:0] entries [0:63];\n  logic [23:0] tag;\n  logic [15:2] successor;\n  logic same_page;\n  logic        hit;\n\n  assign fetch_pc = recovering ? recovery_pc_q : pc_q;\n  assign {tag, successor} = entries[fetch_pc[7:2]];\n  assign hit = valid_q[fetch_pc[7:2]] && (tag == fetch_pc[31:8]);\n  assign same_page = train_pc[31:16] == resolved_pc[31:16];\n  assign predicted_pc = hit ? {fetch_pc[31:16], successor} : fetch_pc + 30'd1;\n\n  always_ff @(posedge clock) begin\n    if (train && same_page)\n      entries[train_pc[7:2]] <= {train_pc[31:8], resolved_pc[15:2]};\n\n    if (reset)\n      valid_q <= '0;\n    else if (train)\n      valid_q[train_pc[7:2]] <= same_page;\n  end\n\n\n  localparam int DEPTH = 2;\n  localparam int PTR_W = $clog2(DEPTH);\n  logic [PTR_W:0] count_q;\n  logic [PTR_W-1:0] head_q, tail_q;\n  logic [63:0] queue_q [0:DEPTH-1];\n  if_id_t response;\n  logic queued, dequeue, fetch, enqueue;\n\n  assign queued = count_q != 0 && !recovering;\n  assign head_ready = queued || imem_ready;\n  assign dequeue = queued && accept;\n  assign fetch = imem_ready && (recovering || count_q < (PTR_W+1)'(DEPTH) || dequeue);\n  assign enqueue = fetch && (queued || !accept);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_q <= '0;\n      recovering <= 1'b0;\n      count_q <= '0;\n      head_q <= '0;\n      tail_q <= '0;\n    end else begin\n      if (fetch)\n        pc_q <= predicted_pc;\n      recovering <= mispredict || (recovering && !fetch);\n\n      if (recovering) begin\n        count_q <= {{PTR_W{1'b0}}, enqueue};\n        head_q <= '0;\n        tail_q <= {{(PTR_W-1){1'b0}}, enqueue};\n        if (enqueue)\n          queue_q[0] <= response;\n      end else begin\n        if (enqueue) begin\n          queue_q[tail_q] <= response;\n          tail_q <= tail_q + 1'b1;\n        end\n        if (dequeue)\n          head_q <= head_q + 1'b1;\n        case ({enqueue, dequeue})\n          2'b10: count_q <= count_q + 1'b1;\n          2'b01: count_q <= count_q - 1'b1;\n          default: ;\n        endcase\n      end\n    end\n\n    if (!recovering)\n      recovery_pc_q <= resolved_pc;\n  end\n\n  assign imem_addr = {fetch_pc, 2'b00};\n  assign response = {imem_addr, imem_data};\n  assign out = queued ? queue_q[head_q] : response;\nendmodule\n","exit_code":0,"status":"completed"}}
