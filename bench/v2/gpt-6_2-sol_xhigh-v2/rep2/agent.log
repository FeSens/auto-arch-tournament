\n',''),\n    ('    .imem_ready     (io_imemReady),', '    .imem_ready     (fetch_valid),'),\n])\nedit('if_stage.sv', [\n    ('  input  logic              accept,', '  input  logic              accept,\\\\n  input  logic              imem_ready,\\\\n  output logic              available,'),\n    ('  assign fetch_pc = recovering ? recovery_pc_q : pc_q;',\n     '''\n  localparam int QUEUE_AW = 3;\n  logic redirect_pending_q;\n  logic full, empty, fetch_take, push, pop;\n  logic [QUEUE_AW:0] wr_q, rd_q;\n  if_id_t incoming;\n  logic [93:0] queue [0:(1 << QUEUE_AW)-1];\n  logic same_index;\n\n  assign same_index = wr_q[QUEUE_AW-1:0] == rd_q[QUEUE_AW-1:0];\n  assign empty = same_index && wr_q[QUEUE_AW] == rd_q[QUEUE_AW];\n  assign full  = same_index && wr_q[QUEUE_AW] \"'!= rd_q[QUEUE_AW];\n  assign available = !empty || imem_ready;\n  assign fetch_take = imem_ready && (!full || accept);\n  assign push = fetch_take && (!empty || !accept);\n  assign pop = !empty && accept;\n\n  assign incoming.pc = imem_addr;\n  assign incoming.instr = imem_data;\n  assign incoming.successor = predicted_pc;\n  assign out = empty ? incoming : queue[rd_q[QUEUE_AW-1:0]];\n\n  always_ff @(posedge clock) begin\n    if (push)\n      queue[wr_q[QUEUE_AW-1:0]] <= incoming;\n    if (reset || mispredict) begin\n      wr_q <= '\"'0;\n      rd_q <= '0;\n    end else begin\n      if (push)\n        wr_q <= wr_q + 1'b1;\n      if (pop)\n        rd_q <= rd_q + 1'b1;\n    end\n  end\n\n  assign fetch_pc = redirect_pending_q ? recovery_pc_q : pc_q;'''),\n    (\\\"      recovering <= 1'b0;\\\\n    end else begin\\\\n      if (accept)\\\\n        pc_q <= predicted_pc;\\\\n      recovering <= mispredict || (recovering && \"'!accept);\",\n     \"      recovering <= 1'\"'b0;\\\\n      redirect_pending_q <= 1'b0;\\\\n    end else begin\\\\n      if (fetch_take)\\\\n        pc_q <= predicted_pc;\\\\n      recovering <= mispredict || (recovering && \"'!accept);'\"\\\\n      redirect_pending_q <= mispredict || (redirect_pending_q && \"'!fetch_take);\"),\n    ('\"'  assign out.pc    = imem_addr;\\\\n  assign out.instr = imem_data;\\\\n',''),\n])\nPY\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
