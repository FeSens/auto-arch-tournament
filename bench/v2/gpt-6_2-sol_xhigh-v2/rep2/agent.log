{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\n\nfrom pathlib import Path\nrtl = Path('cores/bench/rtl')\ndef apply(name, pairs):\n    p = rtl / name\n    s = p.read_text()\n    for old,new in pairs:\n        assert old in s, (name, old)\n        s = s.replace(old,new)\n    p.write_text(s)\napply('ex_stage.sv', [\n    ('  output logic               mispredict,', '''  output logic               resolve_valid,\n  output logic               force_redirect,\n  output logic [2:0]         resolve_path,\n  output logic [11:0]        resolve_match,'''),\n    ('use_sequential, successor_match', 'use_sequential'),\n    ('assign jalr_aligned     = \"'!rs1_plus_imm[1];'\"',\n     \\\"assign jalr_aligned     = (rs1[1:0] + in.imm[1:0]) < 2'd2;\\\"),\n    ('''  // Compare each candidate in parallel with branch direction and target type.\n  assign successor_match  = (use_jalr       && jalr_target == next_issue_pc) ||\n                            (use_relative   && relative_target == next_issue_pc) ||\n                            (use_sequential && pc_plus4 == next_issue_pc);''', '''  logic [3:0] expected_carry;\n  assign expected_carry[0] = 1'b0;\n  assign resolve_path = {use_jalr, use_relative, use_sequential};\n  for (genvar chunk = 0; chunk < 4; chunk++) begin : gen_successor\n    localparam int START = chunk * 8;\n    if (chunk \"'!= 0)\n      assign expected_carry[chunk] = next_issue_pc[START] ''^ rs1[START] ''^ in.imm[START];\n    logic [8:0] sum;\n    assign sum = {1'\"'b0, rs1[START +: 8]} + {1'b0, in.imm[START +: 8]}\n                 + {8'b0, expected_carry[chunk]};\n    if (chunk == 0)\n      assign resolve_match[8 + chunk] = (sum[7:1] == next_issue_pc[7:1]) &&\n                                        (sum[8] == expected_carry[1]);\n    else if (chunk == 3)\n      assign resolve_match[8 + chunk] = sum[7:0] == next_issue_pc[START +: 8];\n    else\n      assign resolve_match[8 + chunk] = (sum[7:0] == next_issue_pc[START +: 8]) &&\n                                        (sum[8] == expected_carry[chunk+1]);\n    assign resolve_match[4 + chunk] = relative_target[START +: 8] == next_issue_pc[START +: 8];\n    assign resolve_match[chunk] = pc_plus4[START +: 8] == next_issue_pc[START +: 8];\n  end'''),\n    ('assign mispredict       = ex_advance && (fence_i || \"'!successor_match);'\"',\n     'assign resolve_valid    = ex_advance;\\\\n  assign force_redirect   = fence_i;')\n])\napply('core.sv', [\n    ('logic        mispredict, recovering, train, take_target;', '''logic        resolve_valid, force_redirect, recovering, train, take_target;\n  logic [2:0]  resolve_path;\n  logic [11:0] resolve_match;'''),\n    ('.mispredict      (mispredict),', '''.resolve_valid   (resolve_valid),\n    .force_redirect  (force_redirect),\n    .resolve_path    (resolve_path),\n    .resolve_match   (resolve_match),'''),\n    ('.accept       (decode_accept && \"'!mispredict),'\"', '.accept       (decode_accept),'),\n    ('.mispredict           (mispredict),', '''.resolve_valid        (resolve_valid),\n    .force_redirect       (force_redirect),\n    .resolve_path         (resolve_path),\n    .resolve_match        (resolve_match),'''),\n])\napply('if_stage.sv', [\n    ('  input  logic              mispredict,', '''  input  logic              resolve_valid,\n  input  logic              force_redirect,\n  input  logic [2:0]        resolve_path,\n  input  logic [11:0]       resolve_match,'''),\n    ('  logic        take_target_q, train_q, target_pending_q;', '''  logic        take_target_q, train_q, target_pending;\n  logic        resolve_q, force_redirect_q, redirect_now, successor_match;\n  logic        target_wait_q, resume_wait_q;\n  logic [2:0]  resolve_path_q;\n  logic [11:0] resolve_match_q;\n\n  assign successor_match = (resolve_path_q[0] && (&resolve_match_q[3:0])) ||\n                           (resolve_path_q[1] && (&resolve_match_q[7:4])) ||\n                           (resolve