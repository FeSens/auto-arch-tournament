rn (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) <<\n…[9874 of 12946 chars elided by tools/bench/transcript.py; sha256:1f38933e1c89c487]…\nr\"], store[\"mem_rmask\"], store[\"mem_wmask\"], store[\"mem_wdata\"]) == (\n        0x48, 0, 0x8, 0x4C4C4C4C,\n    )\n    assert dmem[0x48] == 0x4C345678\n    assert load[\"cycle\"] == store[\"cycle\"] + 3\n    assert (load[\"rs1_rdata\"], load[\"rd_wdata\"]) == (0x45, 0xFFFFFFA6)\n    assert (load[\"mem_addr\"], load[\"mem_rmask\"], load[\"mem_wmask\"], load[\"mem_rdata\"]) == (\n        0x40, 0x8, 0, 0xA6123456,\n    )\n    assert [(addr, ren, wen, ready) for addr, ren, wen, _, ready in requests] == (\n        [(3, 1, 0, True)]\n        + [(0x4B, 0, 0x8, False)] * 3 + [(0x4B, 0, 0x8, True)]\n        + [(0x43, 1, 0, False)] * 2 + [(0x43, 1, 0, True)]\n    )\n    assert [wdata for _, _, wen, wdata, _ in requests if wen] == [0x4C4C4C4C] * 4\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\ncores/bench/test/test_pipeline.py:652:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:654:            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
