covering);\n  assign accept_response = response_valid && !full && !reset;\n  assign out = empty ? response : fifo[rd_q];\n  assign issue = (!empty || response_valid) && !issue_stall && !reset;\n\n  always_ff @(posedge clock) begin\n    if (accept_response)\n      fifo[wr_q] <= response;\n    if (reset) begin\n      occupancy_q <= 5'\"'b00001;\n      rd_q <= '0;\n      wr_q <= '0;\n    end else begin\n      if (recovering) begin\n        occupancy_q <= (accept_response && \"'!issue) ? 5'\"'b00010 : 5'b00001;\n        rd_q <= wr_q + {1'b0, issue};\n      end else begin\n        if (accept_response && \"'!issue) occupancy_q <= {occupancy_q[3:0], 1'\"'b0};\n        if (issue && \"'!accept_response) occupancy_q <= {1'\"'b0, occupancy_q[4:1]};\n        if (issue) rd_q <= rd_q + 2'd1;\n      end\n      if (accept_response) wr_q <= wr_q + 2'd1;\n    end\n  end\nendmodule\n\\\"\\\"\\\"\nhead = \\\"\\\"\\\"  issue_packet_t head_q;\n  logic [\"'$bits(response)-1:0] tail [0:3];\n  logic [1:0] rd_q, wr_q;\n  logic [3:0] tail_count_q;\n  logic head_valid_q, head_valid, tail_valid;\n  logic to_head, to_tail, tail_pop;\n\n  assign head_valid = head_valid_q && !recovering;\n  assign tail_valid = !tail_count_q[0] && !recovering;\n  assign response_valid = imem_ready && (!aperture_wait_q || recovering);\n  assign accept_response = response_valid && !(tail_count_q[3] && !recovering) && !reset;\n  assign out = head_valid ? head_q : response;\n  assign issue = (head_valid || response_valid) && !issue_stall && !reset;\n\n  assign tail_pop = tail_valid && issue;\n  assign to_head = accept_response && (!head_valid || (issue && !tail_valid));\n  assign to_tail = accept_response && !to_head;\n\n  always_ff @(posedge clock) begin\n    if (tail_pop)\n      head_q <= tail[rd_q];\n    else if (to_head)\n      head_q <= response;\n\n    if (to_tail)\n      tail[wr_q] <= response;\n\n    if (reset || recovering) begin\n      head_valid_q <= !reset && accept_response && !issue;\n      rd_q <= '\"'0;