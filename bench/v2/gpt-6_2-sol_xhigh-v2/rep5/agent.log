{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-predictor.35FE9v\"\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nfrom struct import iter_unpack\nimport sys\nfrom collections import Counter\nrecs = Path(sys.argv[1]).joinpath('trace.bin').read_bytes()\nbs=[]\nclasses=Counter()\nfor pc,insn,nxt in iter_unpack('<III',recs):\n    op=insn&127\n    if op==0x63 and (insn>>12&7) not in (2,3):\n        bs.append((pc>>2,nxt \"'!= (pc+4)&0xffffffff))\n        classes[op]+=1\n    elif op in (0x6f,0x67): classes[op]+=1\nprint('\"'static conditional PCs',len({pc for pc,t in bs}), 'control counts', classes)\nfor idxsize in (6,7,8,9,10):\n    for hlen in (0,2,3,4,5,6,8):\n        for hash_fold in (False, True):\n            mask=(1<<idxsize)-1\n            hist=0\n            cnt=[1]*(mask+1)\n            miss=0\n            for pc, actual in bs:\n                p = ((pc \"'^ (pc >> idxsize) if hash_fold else pc) ''^ hist) & mask\n                c=cnt[p]\n                miss += (c >= 2)!=actual\n                cnt[p]= min(3,c+1) if actual else max(0,c-1)\n                hist=((hist<<1)|actual)&((1<<hlen)-1)\n            if miss<44000 or (idxsize==hlen+4 and idxsize<9 and not hash_fold):\n                print(idxsize,hlen,hash_fold,miss)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
