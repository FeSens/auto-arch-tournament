{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nscratch = Path(os.environ['TMPDIR']) / 'fetch-target-study'\nscratch.mkdir(exist_ok=False)\nfor folder in ('bench', 'tools', 'fpga', 'test'):\n    shutil.copytree(folder, scratch / folder)\nshutil.copy2('Makefile', scratch / 'Makefile')\nbaseline = scratch / 'baseline'\nduts = {'baseline': baseline}\nfor variant in ('split', 'select', 'early'):\n    duts[variant] = scratch / variant\nfor variant, dest in duts.items():\n    shutil.copytree('cores/bench', dest / 'cores/bench')\n    for name in ('fpga',):\n        (dest / name).symlink_to(scratch / name, target_is_directory=True)\n    if variant == 'baseline':\n        continue\n    p = dest / 'cores/bench/rtl/if_stage.sv'\n    rtl = p.read_text()\n    rtl = rtl.replace('logic [20:2] offset_word;', '''logic [19:2] offset_word;\n  logic [18:0] target_low;\n  logic [11:0] pc_upper, target_upper;\n  logic        offset_negative, low_carry, target_in_aperture;\n  logic        upper_zero, upper_one, upper_all_ones;''')\n    rtl = rtl.replace('''{is_jal ? {imem_data[31], imem_data[19:12], imem_data[20]}\n                               : {{9{imem_data[31]}}, imem_data[7]},''', '''{is_jal ? {imem_data[19:12], imem_data[20]}\n                               : {{8{imem_data[31]}}, imem_data[7]},''')\n    if variant == 'early':\n        rtl = rtl.replace('offset_word = {is_jal ?', 'offset_word = {imem_data[2] ?')\n        rtl = rtl.replace('is_jal ? imem_data[24:22]', 'imem_data[2] ? imem_data[24:22]')\n        rtl = rtl.replace('direct_bit1 = is_jal ?', 'direct_bit1 = imem_data[2] ?')\n    rtl = rtl.replace('  assign direct_word = pc_word + {{11{imem_data[31]}}, offset_word};', '''  assign offset_negative = imem_data[31];\n  assign pc_upper = pc_word[31:20];\n  assign target_low = {1'b0, pc_word[19:2]} + {1'b0, offset_word};\n  assign low_carry = target_low[18];\n  assign target_upper = low_carry ?\n                        (offset_negative ? pc_upper : pc_upper + 12'd1) :\n                        (offset_negative ? pc_upper - 12'd1 : pc_upper);\n  assign upper_zero = pc_upper == 12'd0;\n  assign upper_one = pc_upper == 12'd1;\n  assign upper_all_ones = &pc_upper;\n  assign target_in_aperture = low_carry ?\n                              (offset_negative ? upper_zero : upper_all_ones) :\n                              (offset_negative ? upper_one : upper_zero);\n  assign direct_word = {target_upper, target_low[17:0]};''')\n    rtl = rtl.replace(\\\"imem_ready && \"'!direct_bit1 && direct_word[31:20] == 12'\"'b0\\\", \\\"\"'!direct_bit1 && target_in_aperture\")\n    if variant in ('\"'select', 'early'):\n        rtl = rtl.replace('  logic response_valid, accept_response;', '''  logic response_valid, accept_response;\n  logic take_target, take_sequential, copy_redirect;\n  logic [31:2] sequential_word;\n  assign take_target = accept_response && predicted_taken;\n  assign take_sequential = resume_fetch || (accept_response && \"'!predicted_taken && !hold_last_word);\n  assign copy_redirect = redirect_pending_q && !(take_target || take_sequential);\n  assign sequential_word = pc_word + 30'\"'d1;''')\n        rtl = rtl.replace('''    // Without a redirect, the held packet resolved to its sequential PC.\n    else if (resume_fetch || (accept_response && \"'!hold_last_word))\n      request_word_q <= predicted_taken && !aperture_wait_q ? direct_word : pc_word + 30'\"'d1;\n    else if (redirect_pending_q)\n      request_word_q <= redirect_target_q;''', '''    else if (take_target || take_sequential || redirect_pending_q)\n      request_word_q <= {12'b0, ({18{take_target}} & target_low[17:0])}\n                     | ({30{take_sequential}} & sequential_word)\n                     | ({30{copy_redirect}} & redirect_target_q);''')\n    else:\n        rtl = rtl.replace(' ? direct_word : pc_word +', \\\" ? {12'b0, target_low[17:0]} : pc_word +\\\")\n    p.write_text(rtl)\nfor name in ('bench', 'tools', 'test', 'Makefile'):\n    (duts['early'] / name).symlink_to(scratch / name, target_is_directory=(name \"'!= '\"'Makefile'))\nprint(scratch)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
