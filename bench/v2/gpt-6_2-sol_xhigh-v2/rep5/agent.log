r(max_workers=3) as executor:\n    list(executor.map(run_arg, sys.argv[1:]))\nPY\npython -u /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/time_variants.py champion:1 alu_8x4:1 alu_16x2:1 alu_8x4_cin:1 alu_12_10_10:1 alu_8x4_select:1 alu_add_8x4:1 agu_only:1 mux_b:1 mux_b_alu_8x4:1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
