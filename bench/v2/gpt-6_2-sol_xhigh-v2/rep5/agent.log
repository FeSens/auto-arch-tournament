{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,240p' tools/eval/test_gate_sanity.py; rg -n 'pytest|check.*unit|gate_sanity|safety_margin' tools/tournament.py tools/eval tools/orchestrator.py; sed -n '1,115p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Gate sanity check (V2): replaces V1's static and random-mutation runs.\n\nThe unchanged starting core must pass the full-trace co-simulation, and\nthree planted bugs must each be rejected by it. Two of them (DIVU by zero,\nDIV INT_MIN / -1) passed every V1 gate: selftest, CoreMark CRCs, and\nALTOPS formal, which abstracts division.\n\nSlow (builds four Verilator simulators): runs only with HWE_SLOW=1, and is\npart of the pre-launch checklist in research/v2/PLAN.md.\n\"\"\"\nimport os\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nREPO = Path(__file__).resolve().parents[2]\nTOOLCHAIN = [REPO / \".toolchain\" / \"oss-cad-suite\" / \"bin\", REPO / \".toolchain\" / \"bin\"]\nTRACE_ELFS = [\"selftest\", \"random1\", \"random2\", \"random3\"]\n\npytestmark = pytest.mark.skipif(os.environ.get(\"HWE_SLOW\") != \"1\",\n                                reason=\"slow: set HWE_SLOW=1\")\n\nBUGS = {\n    \"divu_by_zero\": (\"alu.sv\",\n                     \"ALU_DIVU: out = (b == 32'b0) ? 32'hFFFFFFFF : (a / b);\",\n                     \"ALU_DIVU: out = (b == 32'b0) ? 32'h0 : (a / b);\"),\n    \"div_overflow\": (\"alu.sv\", None, None),  # applied by _div_overflow_bug\n    \"rs2_forwarding\": (\"forward_unit.sv\",\n                       \"    else if (mem_wb_w_en && mem_wb_rd != 5'b0 && mem_wb_rd == id_ex_rs2) fwd_rs2 = 2'd2;\\n\",\n                       \"\"),\n}\n\n\ndef _env() -> dict:\n    env = os.environ.copy()\n    env[\"PATH\"] = os.pathsep.join([*map(str, TOOLCHAIN), env[\"PATH\"]])\n    return env\n\n\ndef _v0_rtl(dest: Path) -> Path:\n    subprocess.run(f\"git -C {REPO} archive bench-v2 cores/bench/rtl | tar -x -C {dest}\",\n                   shell=True, check=True)\n    return dest / \"cores\" / \"bench\" / \"rtl\"\n\n\ndef _div_overflow_bug(rtl: Path) -> None:\n    p = rtl / \"alu.sv\"\n    s = p.read_text()\n    i = s.index(\"ALU_DIV: begin\")\n    j = s.index(\"else if (a == 32'h80000000 && b == 32'hFFFFFFFF)\", i)\n    k = s.index(\"out =\", j)\n    e = s.index(\";\", k)\n    p.write_text(s[:k] + \"out = 32'h0\" + s[e:])\n\n\ndef _build(rtl: Path, obj: Path) -> Path:\n    r = subprocess.r\n…[7458 of 10530 chars elided by tools/bench/transcript.py; sha256:8c5a7894c2501621]…\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport itertools\nimport random\n\nmask32 = (1 << 32) - 1\nmask35 = (1 << 35) - 1\nrng = random.Random(20261122)\nedges = [0, 1, 2, 3, 4, 7, 0x7ffffffe, 0x7fffffff,\n         0x80000000, 0x80000001, 0xfffffffe, 0xffffffff]\n\ndef as_signed(x):\n    return x if x < (1 << 31) else x - (1 << 32)\n\ndef divide(a, b, signed):\n    negative_a = signed and a >> 31\n    negative_b = signed and b >> 31\n    mag_a = (-a) & mask32 if negative_a else a\n    mag_b = (-b) & mask32 if negative_b else b\n    if mag_b == 0:\n        return mask32, a\n    if signed and a == 0x80000000 and b == 0xffffffff:\n        return 0x80000000, 0\n    quo = rem = 0\n    multiples = (0, mag_b, mag_b << 1, (mag_b << 1) + mag_b)\n    for block in range(5, -1, -1):\n        for within_block in range(2, -1, -1):\n            shift = 6 * block + 2 * within_block\n            trial = (rem << 2) | ((mag_a >> shift) & 3)\n            differences = [(trial - m) & mask35 for m in multiples]\n            digit = max(i for i, diff in enumerate(differences) if diff >> 34 == 0)\n            rem = differences[digit]\n            quo = (quo << 2) | digit\n            assert 0 <= rem < mag_b\n    return ((-quo if negative_a \"'!= negative_b else quo) & mask32,\n            (-rem if negative_a else rem) & mask32)\n\npairs = itertools.chain(itertools.product(edges, repeat=2),\n                        ((rng.getrandbits(32), rng.getrandbits(32))\n                         for _ in range(20000)))\ncount = 0\nfor a, b in pairs:\n    for signed in (False, True):\n        x, y = (as_signed(a), as_signed(b)) if signed else (a, b)\n        if y == 0:\n            expected = mask32, a\n        else:\n            q = abs(x) // abs(y)\n            if (x < 0) != (y < 0):\n                q = -q\n            expected = q & mask32, (x - q * y) & mask32\n        assert divide(a, b, signed) == expected, (a, b, signed)\n        count += 1\nprint(f'\"'Fixed-width radix-4 arithmetic model matched {count} signed/unsigned quotient-and-remainder vectors.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
