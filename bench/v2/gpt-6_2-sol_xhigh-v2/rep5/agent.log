is_jal)\n                                                     : !aperture_wait_q);'\"''')\npath.write_text(data)\nPY\npython3 \\\"\"'$TMPDIR/r15-profile/make_retry.py\"\nRTL_DIR=\"$TMPDIR/r15-profile/retry_rtl\" OBJ_DIR=\"$TMPDIR/r15-profile/retry_obj\" NRET=1 bash test/cosim/build.sh > \"$TMPDIR/r15-profile/retry_build.log\" 2>&1\n\"$TMPDIR/r15-profile/retry_obj/cosim_sim\" \"$TMPDIR/r15-profile/coremark.elf\" 10000000 --bench --istall --dstall\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
