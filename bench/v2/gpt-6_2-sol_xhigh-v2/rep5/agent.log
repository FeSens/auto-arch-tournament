rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[3783 of 6855 chars elided by tools/bench/transcript.py; sha256:7b07063dfdc7427e]…\nMark cycles)\"\nMakefile:83:\t@echo \"  make timing TARGET=v1   — Gowin Fmax and worst paths (placement option 0)\"\nMakefile:84:\t@echo \"  make bench              — build selftest + coremark ELFs\"\nMakefile:112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\nMakefile:135:# FPGA timing and area come from the vendor flow, Gowin EDA\nMakefile:137:fpga: cosim-build bench/programs/coremark.elf\nMakefile:140:timing:\nMakefile:143:bench/programs/coremark.elf: bench/programs/Makefile bench/programs/crt0.S \\\nMakefile:144:                              $(wildcard bench/programs/coremark/*.c) \\\nMakefile:145:                              $(wildcard bench/programs/coremark/*.h) \\\nMakefile:146:                              $(wildcard bench/programs/coremark/baremetal/*.c) \\\nMakefile:147:                              $(wildcard bench/programs/coremark/baremetal/*.h)\nMakefile:148:\t$(MAKE) -f bench/programs/Makefile bench/programs/coremark.elf\nMakefile:168:\t  $(if $(strip $(COREMARK)),COREMARK=$(COREMARK),) \\\n", "exit_code": 1, "status": "failed"}}
