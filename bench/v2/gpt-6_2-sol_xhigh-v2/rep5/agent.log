{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -c \"sed -n '820,890p' cores/bench/test/test_pipeline.py && rg -n 'fmax' cores/bench/generated/timing/gowin_p*/impl/pnr/core_bench.tr | head -12 && date\"","aggregated_output":"\n@cocotb.test()\nasync def divide_waits_for_stalled_store(dut):\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),          # MEM/WB forward must survive the store stall.\n        SW(2, 0, 0x40),\n        DIVU(3, 1, 2),\n        ADDI(4, 3, 1),          # Immediate consumer forwards the quotient.\n        SW(4, 0, 0x44),\n        EBREAK(),\n    ]\n    requests = []\n\n    def ready(addr, ren, wen):\n        if not (ren or wen):\n            return True\n        requests.append((addr, ren, wen, int(dut.io_dmemWData.value)))\n        return len(requests) > 3\n\n    rets, dmem = await _run(dut, program, dmem_ready=ready)\n    assert requests == [(0x40, 0, 0xF, 7)] * 4 + [(0x44, 0, 0xF, 15)]\n    assert dmem == {0x40: 7, 0x44: 15}\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n\n    older, div, consumer, younger = rets[2:6]\n    assert div[\"cycle\"] - older[\"cycle\"] == 9\n    assert consumer[\"cycle\"] - div[\"cycle\"] == 1\n    assert younger[\"cycle\"] - consumer[\"cycle\"] == 2\n    assert (div[\"rs1_addr\"], div[\"rs1_rdata\"]) == (1, 100)\n    assert (div[\"rs2_addr\"], div[\"rs2_rdata\"]) == (2, 7)\n    assert (div[\"rd\"], div[\"rd_wdata\"], div[\"trap\"]) == (3, 14, 0)\n    assert (div[\"mem_rmask\"], div[\"mem_wmask\"], div[\"pc_next\"]) == (0, 0, 16)\n    assert (consumer[\"rs1_rdata\"], consumer[\"rd_wdata\"]) == (14, 15)\n    assert (older[\"mem_addr\"], older[\"mem_wmask\"], older[\"mem_wdata\"]) == (0x40, 0xF, 7)\n    assert (younger[\"mem_addr\"], younger[\"mem_wmask\"], younger[\"mem_wdata\"]) == (0x44, 0xF, 15)\n\n\n@cocotb.test()\n@cocotb.parametrize(predict_jal=[False, True], wrong_path=[MUL, DIVU])\nasync def divide_after_load_use_and_transfer(dut, predict_jal, wrong_path):\n    program = [\n        ADDI(1, 0, 7),\n        LW(2, 0, 0x40),\n        DIVU(3, 2, 1),\n        REMU(4, 3, 1),\n        ADD(5, 3, 4),\n        JAL(0, 8) if predict_jal else BEQ(0, 0, 8),\n        wrong_path(6, 0, 0),\n        REMU(6, 5, 1),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, dmem_init={0x40: 110})\n    assert dmem == {0x40: 110}\n    assert [r[\"insn\"] for r in rets] == program[:6] + program[7:]\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 20, 28, 32]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    _, load, div, rem, consumer, jump, target, _ = rets\n    assert (div[\"rs1_rdata\"], div[\"rs2_rdata\"], div[\"rd_wdata\"]) == (110, 7, 15)\n    assert (rem[\"rs1_rdata\"], rem[\"rs2_rdata\"], rem[\"rd_wdata\"]) == (15, 7, 1)\n    assert consumer[\"rd_wdata\"] == 16\n    assert (target[\"rs1_rdata\"], target[\"rs2_rdata\"], target[\"rd_wdata\"]) == (16, 7, 2)\n    assert div[\"cycle\"] - load[\"cycle\"] == 10\n    assert rem[\"cycle\"] - div[\"cycle\"] == 10\n    assert consumer[\"cycle\"] - rem[\"cycle\"] == 1\n    assert jump[\"pc_next\"] == 28\n    assert target[\"cycle\"] - jump[\"cycle\"] == (9 if predict_jal else 10)\n\n\nrg: cores/bench/generated/timing/gowin_p*/impl/pnr/core_bench.tr: IO error for operation on cores/bench/generated/timing/gowin_p*/impl/pnr/core_bench.tr: No such file or directory (os error 2)\nSun Nov 22 19:49:28 CET 2026\n","exit_code":0,"status":"completed"}}
