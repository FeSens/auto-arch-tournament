{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,300p' formal/run_all.sh && sed -n '1,280p' Makefile && sed -n '1,200p' cores/bench/test/conftest.py && sed -n '1,110p' cores/bench/core.yaml\"", "aggregated_output": "#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env vars (orchestrator-driven, override $1 and defaults):\n#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n# When BOTH are unset, the script auto-detects nret from\n# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n# invoking `bash formal/run_all.sh` directly therefore get the\n# right wrapper without needing to know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[16079 of 19151 chars elided by tools/bench/transcript.py; sha256:9d94a7ea754d67b0]…\nnull || true\nifneq ($(strip $(TARGET)),)\n\trm -rf $(OBJ_DIR)\n\trm -rf $(GEN_DIR)\n\trm -rf cores/$(TARGET)/sim_build\nendif\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 54.869\n  lut4: 3413\n  ff: 735\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261122-002-r3s1\n  updated: '2026-11-22T03:51:12.284002Z'\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,290p' cores/bench/rtl/divider.sv && sed -n '1,290p' cores/bench/test/test_divider.py\"", "aggregated_output": "// Shared blocking RV32M divider. Launch consumes the leading nibble,\n// followed by seven work cycles. EX can hand off on the last work edge,\n// which registers the final state used for the MEM result.\nmodule divider (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        launch,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        idle,\n  output logic        handoff_ready,\n  output logic [31:0] result\n);\n\n  // 0 = idle, 8..2 = seven work cycles, 1 = result pending.\n  logic [3:0] phase_q;\n  logic starting, stepping;\n\n  assign idle          = phase_q == 4'd0;\n  assign handoff_ready = phase_q == 4'd2 || phase_q == 4'd1;\n  assign starting      = idle && launch;\n  assign stepping      = |phase_q[3:1];\n\n  always_ff @(posedge clock) begin\n    if (reset)                        phase_q <= 4'd0;\n    else if (starting)                phase_q <= 4'd8;\n    else if (handoff_ready && accept) phase_q <= 4'd0;\n    else if (stepping)                phase_q <= phase_q - 4'd1;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_mask;\n\n  always_comb begin\n    case (op)\n      ALU_DIV:  alt_mask = 32'h7f8529ec;\n      ALU_DIVU: alt_mask = 32'h10e8fd70;\n      ALU_REM:  alt_mask = 32'h8da68fa5;\n      ALU_REMU: alt_mask = 32'h3138d0e1;\n      default:  alt_mask = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)         result <= '0;\n    else if (starting) result <= (a - b) ^ alt_mask;\n  end\n`else\n  logic signed_op, want_remainder, a_negative, b_negative;\n  logic [27:0] a_mag_lo;\n  logic [3:0] a_mag_hi, b_mag_nibble;\n  logic [31:0] b_magnitude;\n  logic small_divisor;\n  logic [31:0] divisor_q, remainder_q;\n  logic [33:0] three_divisor_q;\n  logic [31:0] quotient_q;\n  logic        want_remainder_q, negate_q;\n  logic [31:0] magnitude;\n\n  assign signed_op      = op == ALU_DIV || op == ALU_REM;\n  assign want_remainder = op == ALU_REM || op == ALU_REMU;\n  assign a_negative     = signed_op && a[31];\n  assign b_negative     \n…[9470 of 12542 chars elided by tools/bench/transcript.py; sha256:bece064c8be6a885]…\n.launch.value = 0\n    dut.accept.value = 0\n    for _ in range(4):\n        await _edge(dut)\n        assert dut.idle.value == 0\n        assert dut.handoff_ready.value == 1\n        assert int(dut.result.value) == (-20 & MASK32)\n    await _accept(dut)\n    assert int(dut.result.value) == (-20 & MASK32)\n    await _check(dut, ALU_REMU, 17, 5, 2)\n\n\n@cocotb.test()\nasync def reset_discards_in_flight_and_pending_results(dut):\n    await _reset(dut)\n    await _launch(dut, ALU_REM, -61, 3)\n    await _edge(dut)\n    await _edge(dut)\n    await _reset(dut)\n    for _ in range(7):\n        await _edge(dut)\n        assert dut.idle.value == 1\n        assert dut.handoff_ready.value == 0\n\n    await _launch(dut, ALU_DIVU, 101, 7)\n    await _reach_final_work_edge(dut)\n    await _edge(dut)\n    assert dut.handoff_ready.value == 1\n    await _reset(dut)\n    await _check(dut, ALU_DIV, -19, 2, -9)\n\n\ndef test_divider_runner():\n    run_cocotb(toplevel=\"divider\", sources=[\"core_pkg.sv\", \"divider.sv\"],\n               test_module=\"test_divider\")\n", "exit_code": 0, "status": "completed"}}
