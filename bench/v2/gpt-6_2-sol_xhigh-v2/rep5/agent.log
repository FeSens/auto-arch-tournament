{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/recovery_variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\norig = (base / 'if_stage.sv').read_text()\nfor variant, method, normal in [\n    ('recovery_unified', 'unified', 0),\n    ('recovery_unified_normal', 'unified', 1),\n    ('recovery_onehot', 'onehot', 0),\n    ('recovery_onehot_normal', 'onehot', 1),\n    ('recovery_masked', 'masked', 0),\n    ('recovery_unified_normal_pre', 'unified', 2),\n]:\n    p = scratch / variant\n    shutil.copytree(base, p)\n    s = orig\n    if method == 'unified':\n        s = s.replace('retry_q, ex_target_q, mem_target_q;', 'retry_q, recovery_target_q;')\n        s = s.replace(\\\"({30{mem_recovery}} & mem_target_q)\\\\n                 | ({30{ex_recovery && \"'!mem_recovery}} & ex_target_q)\", '\"'({30{recovering}} & recovery_target_q)')\n        s = s.replace('    ex_target_q <= ex_redirect_word;\\\\n    mem_target_q <= mem_redirect_word;', '    recovery_target_q <= mem_redirect ? mem_redirect_word : ex_redirect_word;')\n    elif method == 'onehot':\n        s = s.replace('ex_recovery && \"'!mem_recovery'\"', 'ex_recovery')\n        s = s.replace('ex_recovery <= \"'!reset && ex_redirect;'\"', 'ex_recovery <= \"'!reset && ex_redirect && !mem_redirect;'\"')\n    else:\n        s = s.replace('({30{mem_recovery}} & mem_target_q)', 'mem_target_q')\n        s = s.replace('({30{ex_recovery && \"'!mem_recovery}} & ex_target_q)'\"', 'ex_target_q')\n        s = s.replace('    ex_target_q <= ex_redirect_word;\\\\n    mem_target_q <= mem_redirect_word;', \\\"    ex_target_q <= (\"'!reset && ex_redirect && !mem_redirect) ? ex_redirect_word : '\"'0;\\\\n    mem_target_q <= (\"'!reset && mem_redirect) ? mem_redirect_word : '\"'0;\\\")\n    if normal:\n        s = s.replace('  logic [1:0]  history_q;', '  logic [1:0]  history_q;\\\\n  logic        recovery_select_q;')\n        s = s.replace('  assign recovering = mem_recovery || ex_recovery;', '  assign recovering = recovery_select_q;')\n        s = s.replace('    mem_recovery <= \"'!reset && mem_redirect;'\"', '    mem_recovery <= \"'!reset && mem_redirect;'\"\\\\n    recovery_select_q <= \"'!reset && (mem_redirect || ex_redirect);'\"')\n        if normal == 2:\n            s = s.replace('sequential_select_q && \"'!recovering'\"', 'sequential_select_q').replace('predicted_select_q && \"'!recovering'\"', 'predicted_select_q').replace('retry_select_q && \"'!recovering'\"', 'retry_select_q')\n            s = s.replace('<= \"'!reset && advance_request'\"', '<= \"'!reset && !mem_redirect && !ex_redirect && advance_request'\"')\n            s = s.replace('<= reset || \"'!advance_request;'\"', '<= reset || (\"'!mem_redirect && !ex_redirect && !advance_request);'\"')\n    (p/'if_stage.sv').write_text(s)\nPY\npython /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/recovery_variants.py\npython -u /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/time_variants.py recovery_unified:1 recovery_onehot:1 recovery_unified_normal:1 recovery_masked:1 recovery_onehot_normal:1 recovery_unified_normal_pre:1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/bht_local.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\norig = (base / 'if_stage.sv').read_text()\nleft = orig.index('  logic [1:0]  counters')\nright = orig.index('  logic        is_branch', left)\n\nfor name, bank_bits, encoding, decode_wr in [\n    ('bht_local_16', 2, 'direction', True),\n    ('bht_local_16_binary', 2, 'binary', True),\n    ('bht_local_16_comb', 2, 'direction', False),\n    ('bht_local_32', 1, 'direction', True),\n    ('bht_local_16_ff', 2, 'direction_ff', True),\n]:\n    p = scratch / name\n    shutil.copytree(base, p)\n    banks = 2**bank_bits\n    bits = 6-bank_bits\n    tab = 2**bits\n    addr = f'[{bits-1}:0]'\n    s = f'''  logic update_valid_q, update_taken_q;\n  logic [5:0] update_index_q, prediction_index;\n  logic [{banks-1}:0] pred_taken_lane, update_bank_sel{'_q' if decode_wr else ''};\n  for (genvar bank = 0; bank < {banks}; bank++) begin : gen_bht\n    logic [{tab-1}:0] written_q;\n    logic write_row, prediction_hit;\n    logic [1:0] old_counter, next_counter;\n    assign prediction_hit = prediction_index[5:{bits}] == {bank_bits}'(bank);\n    assign write_row = \"'!reset && update_valid_q && update_bank_sel{'\"'_q' if decode_wr else ''}[bank];\n'''\n    if decode_wr:\n        s += f'''    always_ff @(posedge clock)\n      if (train_branch) update_bank_sel_q[bank] <= train_index[5:{bits}] == {bank_bits}'(bank);\n'''\n    else:\n        s += f'    assign update_bank_sel[bank] = update_index_q[5:{bits}] == {bank_bits}\\\\'(bank);\\\\n'\n    if encoding == 'direction_ff':\n        s += f'''\n    logic [{tab-1}:0] direction_q;\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic weak_q [0:{tab-1}];\n    assign old_counter = {{direction_q[update_index_q{addr}],\n                           written_q[update_index_q{addr}] ? weak_q[update_index_q{addr}] : 1'b1}};\n    assign pred_taken_lane[bank] = prediction_hit && direction_q[prediction_index{addr}];\n    always_ff @(posedge clock) begin\n      if (reset) direction_q <= '0;\n      else if (write_row) direction_q[update_index_q{addr}] <= next_counter[1];\n      if (write_row) weak_q[update_index_q{addr}] <= next_counter[0];\n    end\n'''\n    else:\n        s += f'''\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counter [0:{tab-1}];\n    assign old_counter = written_q[update_index_q{addr}] ? counter[update_index_q{addr}] : 2'b01;\n    assign pred_taken_lane[bank] = prediction_hit && written_q[prediction_index{addr}]\n                                                && counter[prediction_index{addr}][1];\n    always_ff @(posedge clock)\n      if (write_row) counter[update_index_q{addr}] <= next_counter;\n'''\n    if encoding.startswith('direction'):\n        s += '''    assign next_counter = {old_counter[0] ? update_taken_q : old_counter[1],\n                           old_counter[1] \"'^ update_taken_q};\n'\"'''\n    else:\n        s += '''    assign next_counter = update_taken_q\n        ? (old_counter == 2'b11 ? old_counter : old_counter + 2'd1)\n        : (old_counter == 2'b00 ? old_counter : old_counter - 2'd1);\n'''\n    s += f'''\n    always_ff @(posedge clock) begin\n      if (reset) written_q <= '0;\n      else if (write_row) written_q[update_index_q{addr}] <= 1'b1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      history_q      <= 2'b00;\n      update_valid_q <= 1'b0;\n      update_taken_q <= 1'b0;\n      update_index_q <= 6'b0;\n    end else begin\n      update_valid_q <= train_branch;\n      if (train_branch) begin\n        history_q      <= {{history_q[0], train_taken}};\n        update_index_q <= train_index;\n        update_taken_q <= train_taken;\n      end\n    end\n  end\n\n'''\n    text = (orig[:left]+s+orig[right:]).replace('  logic [5:0]  pred