 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1,\n…[17121 of 20193 chars elided by tools/bench/transcript.py; sha256:0241f8821c80c483]…\nHz median Gowin Fmax against an 85.238 MHz promotion target.\n- 2026-11-22 hyp-20261122-001-r9s0 (regression, +3.27%): Registering one-hot EX result selects and sharing SRL/SRA in a signed 33-bit shifter cut the measured shift path from 11.505 to 7.706 ns in Gowin placement 0, while the divider quotient-to-remainder path in the other two placements capped median Fmax at 89.183 MHz, below the 90.33 MHz needed for promotion at the same CoreMark cycle count.\n- 2026-11-22 hyp-20261122-002-r9s1 (regression, +0.52%): Reusing fall-through packets from a shared decoded store saved 6.60% of stalled CoreMark cycles, and registering the issue head still left the EX redirect path to the request slot register capping median Gowin Fmax at 81.083 MHz, below the 84.38 MHz needed for promotion.\ncores/bench/test/test_pipeline.py:921:def test_pipeline_runner():\ncores/bench/test/test_pipeline.py:927:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:932:        test_module=\"test_pipeline\",\n", "exit_code": 0, "status": "completed"}}
