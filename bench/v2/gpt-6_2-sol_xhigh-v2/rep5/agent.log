n  assign fresh_in.prediction_index = prediction_index;\nendmodule\n'''\n        elif f.name == 'core.sv':\n            code = code.replace('(stall_if),\\\\n    .imem_ready', '(stall_id),\\\\n    .imem_ready')\n        (name/f.name).write_text(code)\nPY\nrtl=\\\"\"'$PWD/cores/bench/rtl\"\nverilator --cc --exe --build -Mdir \"$scratch/profile\" \"+incdir+$rtl\" --top-module core -Wno-fatal -CFLAGS \"-DNRET=1\" \"$rtl/core_pkg.sv\" \"$rtl/\"*.sv \"$scratch/profile.cpp\" -o cosim_sim > \"$scratch/profile-build.log\" 2>&1 &\nfor depth in 1 2 4 8; do\n  NRET=1 RTL_DIR=\"$scratch/rtl-queue$depth\" OBJ_DIR=\"$scratch/queue$depth\" bash test/cosim/build.sh > \"$scratch/queue$depth-build.log\" 2>&1 &\ndone\nwait\nelf=\"$TMPDIR/hyp-20261122-003-r3s2-coremark.elf\"\n\"$scratch/profile/cosim_sim\" \"$elf\" 10000000 --bench --istall --dstall \"$scratch/trace.bin\"\nfor depth in 1 2 4 8; do\n  \"$scratch/queue$depth/cosim_sim\" \"$elf\" 10000000 --bench --istall --dstall > \"$scratch/queue$depth-results.jsonl\" &\ndone\nwait\nfor depth in 1 2 4 8; do\n  tail -1 \"$scratch/queue$depth-results.jsonl\"\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
