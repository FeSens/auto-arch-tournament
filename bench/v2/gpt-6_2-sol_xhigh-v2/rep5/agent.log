{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\n\npath = Path(os.environ['TMPDIR']) / 'r4s2-predictor/free4-clear/cores/bench/test/test_pipeline.py'\nsource = path.read_text()\nsource = source.replace(\\\"0x00C: BEQ(0, 0, 0),     # Wrong path while the store is held.\\\", \\\"0x00C: SW(1, 0, 0x44),   # Wrong path while the store is held.\\\")\nsource = source.replace(\\\"return addr \"'!= 0x00C or len(requests) < 4\", \"return addr != 0x110 or fetches.count(0x110) > 1\")\nsource = source.replace(\"assert fetches[:7] == [4, 8, 0x00C, 0x00C, 0x00C, 0x00C, 0x010]\", \"assert fetches[:7] == [4, 8, 0x00C, 0x010, 0x10C, 0x110, 0x010]\")\nmarker = '\"'@cocotb.test()\\\\nasync def jalr_target(dut):'\nsource = source.replace(marker, '''@cocotb.test()\nasync def prefetched_packets_drain_and_wrap(dut):\n    \\\"\\\"\\\"Fill four slots per divide, then drain while the next request stalls.\\\"\\\"\\\"\n    program = [\n        ADDI(1, 0, 48),\n        ADDI(2, 0, 6),\n        DIVU(3, 1, 2),\n        ADDI(4, 0, 10), ADDI(5, 0, 11), ADDI(6, 0, 12), ADDI(7, 0, 13),\n        DIVU(3, 1, 2),\n        ADDI(4, 0, 14), ADDI(5, 0, 15), ADDI(6, 0, 16), ADDI(7, 0, 17),\n        EBREAK(),\n    ]\n    stalled_pcs = {0x1C: 0, 0x30: 0}\n    fetches = []\n\n    def ready(addr):\n        fetches.append(addr)\n        if addr in stalled_pcs:\n            stalled_pcs[addr] += 1\n            return stalled_pcs[addr] >= 8\n        return True\n\n    rets, _ = await _run(dut, program, imem_ready=ready)\n    assert [ret[\\\"insn\\\"] for ret in rets] == program\n    assert [ret[\\\"pc\\\"] for ret in rets] == list(range(0, len(program) * 4, 4))\n    assert [ret[\\\"order\\\"] for ret in rets] == list(range(len(program)))\n    for div_index in (2, 7):\n        group = rets[div_index:div_index + 5]\n        assert [ret[\\\"cycle\\\"] - group[0][\\\"cycle\\\"] for ret in group] == [0, 1, 2, 3, 4]\n        assert group[0][\\\"rd_wdata\\\"] == 8\n    assert stalled_pcs == {0x1C: 8, 0x30: 8}\n\n\n@cocotb.test()\nasync def cold_taken_branch_at_aperture_boundary(dut):\n    \\\"\\\"\\\"The final word stays on the bus until the cold branch resolves.\\\"\\\"\\\"\n    last_word = 0x000FFFFC\n    program = {0: JAL(0, last_word),\n               last_word: BEQ(0, 0, -4),\n               last_word - 4: EBREAK()}\n    fetches = []\n\n    def ready(addr):\n        fetches.append(addr)\n        assert addr < 0x00100000\n        return True\n\n    rets, _ = await _run(dut, program, imem_ready=ready)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, last_word, last_word - 4]\n    assert [r[\\\"pc_next\\\"] for r in rets[:2]] == [last_word, last_word - 4]\n    assert fetches[:3] == [last_word, last_word, last_word - 4]\n\n\n''' + marker)\npath.write_text(source)\nPY\nscratch_variant=\\\"\"'$TMPDIR/r4s2-predictor/free4-clear\"\ncd \"$scratch_variant\" && MAKEFLAGS=-j4 python3 -m pytest -q cores/bench/test > test-check.log 2>&1\ncheck_status=$?\ntail -50 test-check.log\nexit \"$check_status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
