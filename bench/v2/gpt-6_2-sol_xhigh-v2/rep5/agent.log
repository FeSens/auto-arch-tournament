{"type":"item.started","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\nfrom subprocess import run\nfrom tempfile import NamedTemporaryFile\n\nrtl = Path(\\\"cores/bench/rtl\\\")\nsource = (rtl / \\\"divider.sv\\\").read_text()\nsource = source.replace(\\\"input  logic        clock,\\\", \\\"\\\"\\\"input logic [31:0] divisor_raw,\n  input logic divisor_negative,\n  input logic clock,\\\"\\\"\\\")\nsource = re.sub(r\\\"\"'^'\"\\\\s*b_q\\\\s*<= [\"'^;]+;\", \"\", source, flags=re.M)\nsource = re.sub(r\"''^'\"\\\\s*b_negative_q\\\\s*<= [\"'^;]+;\", \"\", source, flags=re.M)\nproperties = \"\"\"\n  assign b_q = divisor_raw;\n  assign b_negative_q = divisor_negative;\n  wire [31:0] div_mag = divisor_negative ? -divisor_raw : divisor_raw;\n  wire is_narrow = div_mag != 0 && div_mag < 2048;\n  wire [35:0] expected = is_narrow ? {4'\"'b0, div_mag} : {3'b0, div_mag, 1'b0};\n  wire scale_matches = narrow_divisor == is_narrow && scaled_divisor == expected;\n\\\"\\\"\\\"\nsource = source.replace(\\\"endmodule\\\", properties + \\\"\\\\nendmodule\\\")\nwith NamedTemporaryFile(mode=\\\"w\\\", suffix=\\\".sv\\\") as check:\n    check.write(source)\n    check.flush()\n    command = (\n        f\\\"read_verilog -sv {rtl / 'core_pkg.sv'} {check.name}; \\\"\n        \\\"hierarchy -top divider; proc; \\\"\n        \\\"expose divider/w:scale_matches; \\\"\n        \\\"delete -output divider/w:idle divider/w:handoff_ready divider/w:result; \\\"\n        \\\"opt_clean -purge; opt; \\\"\n        \\\"sat -timeout 30 -verify -prove scale_matches 1\\\"\n    )\n    result = run([\\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", command], text=True, capture_output=True)\nprint(\\\"\\\\n\\\".join(result.stdout.splitlines()[-17:]))\nif result.stderr:\n    print(result.stderr)\nraise SystemExit(result.returncode)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
