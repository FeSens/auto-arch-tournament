{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom os import environ\nimport shutil\nfrom tools.eval import gowin\n\nroot = Path(environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold = Path.cwd() / \\\"cores/bench/rtl\\\"\nvariants = {\n    \\\"skid1\\\": (1, gold),\n    \\\"skid2\\\": (2, gold),\n    \\\"skid4\\\": (4, gold),\n    \\\"skid1_recovery\\\": (1, root/\\\"early_redirect/rtl\\\"),\n    \\\"skid2_recovery\\\": (2, root/\\\"early_redirect/rtl\\\"),\n    \\\"skid4_recovery\\\": (4, root/\\\"early_redirect/rtl\\\"),\n}\n\nfor v,(depth,base) in variants.items():\n    rtl = root / v / \\\"rtl\\\"\n    shutil.copytree(base, rtl)\n    p=rtl/\\\"if_stage.sv\\\"; t=p.read_text()\n    start=t.index(\\\"  // EX only redirects\\\")\n    t=t[:start]+\\\"\\\"\\\"\n  if_id_t response;\n  logic empty, full, have_space, can_advance, drain, push, aperture_last;\n\n  // Retain normal fetch at the aperture boundary and disallow enqueueing\n  // across the boundary ahead of decode.\n  assign aperture_last = pc_word == 30'h3ffff && \"'!predicted_taken;\n  assign have_space = !full && (!aperture_last || (empty && !stall));\n  assign can_advance = imem_ready && have_space;\n  assign drain = !empty && !stall;\n  assign push = can_advance && (!empty || stall);\n\n  always_ff @(posedge clock) begin\n    if      (reset)       pc_word <= '\"'0;\n    else if (redirect)    pc_word <= redirect_word;\n    else if (can_advance) pc_word <= predicted_taken ? direct_word : pc_word + 30'd1;\n  end\n\n  assign imem_addr                 = {pc_word, 2'b00};\n  assign response.pc               = imem_addr;\n  assign response.instr            = imem_data;\n  assign response.valid            = imem_ready && (\"'!aperture_last || empty);\n  assign response.direct_target    = {direct_word, direct_bit1, 1'\"'b0};\n  assign response.predicted_taken  = predicted_taken;\n  assign response.prediction_index = prediction_index;\n\\\"\\\"\\\"\n    if depth==1:\n        t+=\\\"\\\"\\\"\n  if_id_t saved_q;\n  logic occupied_q;\n  assign empty = \"'!occupied_q;\n  assign full = occupied_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) occupied_q <= 1'\"'b0;\n    else if (drain || push) occupied_q <= push;\n    if (push) saved_q <= response;\n  end\n  assign out = empty ? response : saved_q;\n\\\"\\\"\\\"\n    else:\n        bits=(depth-1).bit_length()\n        t+=f\\\"\\\"\\\"\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) if_id_t queue_q [0:{depth-1}];\n  logic [{bits}:0] rd_q, wr_q;\n  assign empty = rd_q == wr_q;\n  assign full = rd_q[{bits}] \"'!= wr_q[{bits}] && rd_q[{bits-1}:0] == wr_q[{bits-1}:0];\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      rd_q <= 0;\n      wr_q <= 0;\n    end else begin\n      if (drain) rd_q <= rd_q + {bits+1}'\"'d1;\n      if (push) wr_q <= wr_q + {bits+1}'d1;\n    end\n    if (\"'!full) queue_q[wr_q[{bits-1}:0]] <= response;\n  end\n  assign out = empty ? response : queue_q[rd_q[{bits-1}:0]];\n\"\"\"\n    p.write_text(t+\"'\"\\\\nendmodule\\\\n\\\")\n\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\",\n                n, root / v / f\\\"gowin_p{n}\\\"): (v, n)\n            for n in (0,) for v in variants}\n    for job in as_completed(jobs):\n        v,n = jobs[job]\n        res = job.result()\n        print(v,n,\\\"Fmax\\\",res.get(\\\"fmax_mhz\\\"),\\\"logic\\\",res.get(\\\"logic\\\"),res.get(\\\"reason\\\", \\\"\\\"))\n        for path in res.get(\\\"critical_paths\\\", [])[:2]:\n            print(\\\" \\\",path)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom os import environ\nimport shutil\nfrom tools.eval import gowin\n\nroot = Path(environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold = Path.cwd() / \\\"cores/bench/rtl\\\"\nvariants = [(r,q,e,p) for (r,q,e) in [(1,0,0),(0,1,0),(1,1,0),(1,1,1)] for p in (0,1)]\nfor rec,quo,en,_ in variants[::2]:\n    v = f\\\"split_state_{rec}{quo}{en}\\\"\n    rtl = root / v / \\\"rtl\\\"\n    shutil.copytree(gold, rtl)\n    p=rtl/\\\"divider.sv\\\"; t=p.read_text()\n    if rec:\n        t=t.replace(\\\"  logic [31:0] magnitude;\\\",\\\"  logic [31:0] magnitude;\\\\n  logic [10:0] narrow_remainder_q;\\\")\n        t=t.replace(\\\"radix4_step({remainder_q[10:0]\\\", \\\"radix4_step({narrow_remainder_q\\\")\n        t=t.replace(\\\"      remainder_q       <= '0;\\\", \\\"      remainder_q       <= '0;\\\\n      narrow_remainder_q <= '0;\\\")\n        t=t.replace(\\\"remainder_q <= {28'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\\\",\n                    \\\"narrow_remainder_q <= {7'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\\\")\n        t=t.replace(\\\"remainder_q <= {21'b0, step2[10:0]};\\\", \\\"narrow_remainder_q <= step2[10:0];\\\")\n    if quo:\n        t=t.replace(\\\"  logic [31:0] magnitude;\\\",\\\"  logic [31:0] magnitude;\\\\n  logic [31:0] narrow_quotient_q;\\\")\n        t=t.replace(\\\"quotient_q[31:30]\\\", \\\"narrow_quotient_q[31:30]\\\").replace(\\\"quotient_q[29:28]\\\", \\\"narrow_quotient_q[29:28]\\\")\n        t=t.replace(\\\"      quotient_q        <= '0;\\\",\\\"      quotient_q        <= '0;\\\\n      narrow_quotient_q  <= '0;\\\")\n        t=t.replace(\\\"quotient_q  <= {a_magnitude[27:0]\\\", \\\"narrow_quotient_q  <= {a_magnitude[27:0]\\\")\n        t=t.replace(\\\"quotient_q  <= {quotient_q[27:0]\\\", \\\"narrow_quotient_q  <= {narrow_quotient_q[27:0]\\\")\n    refrec = \\\"(narrow_q ? {21'b0, narrow_remainder_q} : remainder_q)\\\" if rec else \\\"remainder_q\\\"\n    refquo = \\\"(narrow_q ? narrow_quotient_q : quotient_q)\\\" if quo else \\\"quotient_q\\\"\n    if en:\n        t=t.replace(\\\"\\\"\\\"      if (narrow_divisor) begin\n        narrow_remainder_q <= {7'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\n        narrow_quotient_q  <= {a_magnitude[27:0], nibble_divisor ? prefix_quotient : 4'b0};\n      end else begin\n        // For D >= 2048 the leading 11 bits are already reduced.\n        // D=0 seeds ones for the consumed quotient bits.\n        remainder_q <= {21'b0, a_magnitude[31:21]};\n        quotient_q  <= {a_magnitude[20:0], {11{divisor_zero}}};\n      end\n    end else if (counting_down) begin\n      if (narrow_q) begin\n        narrow_remainder_q <= step2[10:0];\n        narrow_quotient_q  <= {narrow_quotient_q[27:0], step1[12:11], step2[12:11]};\n      end else begin\n        remainder_q <= wide_remainder;\n        quotient_q  <= {quotient_q[28:0], wide_digit};\n      end\n\\\"\\\"\\\", \\\"\\\"\\\"      narrow_remainder_q <= {7'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\n      narrow_quotient_q  <= {a_magnitude[27:0], nibble_divisor ? prefix_quotient : 4'b0};\n      remainder_q <= {21'b0, a_magnitude[31:21]};\n      quotient_q  <= {a_magnitude[20:0], {11{divisor_zero}}};\n    end else if (counting_down) begin\n      narrow_remainder_q <= step2[10:0];\n      narrow_quotient_q  <= {narrow_quotient_q[27:0], step1[12:11], step2[12:11]};\n      remainder_q <= wide_remainder;\n      quotient_q  <= {quotient_q[28:0], wide_digit};\n\\\"\\\"\\\")\n    t=t.replace(\\\"assign magnitude = want_remainder_q ? remainder_q : quotient_q;\\\",f\\\"assign magnitude = want_remainder_q ? {refrec} : {refquo};\\\")\n    p.write_text(t)\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\",\n                n, root / v / f\\\"gowin_p{n}\\\"): (v, n)\n            for rec,quo,en,n in sorted(variants,key=lambda t:t[3]) for v in (f\\\"split_state_{rec}{quo}{en}\\\",)}\n    for job in as_completed(jobs):\n        v,n = jobs[job]\n        res = job.result()\n        print(v,n,\\\"Fmax\\\",res.get(\\\"fmax_mhz\\\"),\\\"logic\\\",res.get(\\\"logic\\\"),res.get(\\\"reason\\\", \\\"\\\"))\n        for path in res.get(\\\"critical_paths\\\", [])[:2]:\n            print(\\\" \\\",path)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
