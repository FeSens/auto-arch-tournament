{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom os import environ\nimport shutil\nfrom tools.eval import gowin\n\nroot=Path(environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\nvariants = {\n    \\\"common_sub\\\": (\\\"cmp\\\", False, False, False),\n    \\\"common_sub_redirect\\\": (\\\"cmp\\\", True, False, False),\n    \\\"common_sub_redirect_split\\\": (\\\"cmp\\\", True, True, False),\n    \\\"common_cmp_redirect\\\": (\\\"cmp\\\", True, False, True),\n    \\\"common_cmp_chunk_redirect\\\": (\\\"cmp\\\", True, True, True),\n    \\\"common_cmp_chunk\\\": (\\\"cmp\\\", False, True, True),\n}\nfor v,(_,redirect,chunk,cmp) in variants.items():\n    rtl=root/v/\\\"rtl\\\"\n    shutil.copytree(root/\\\"common_cmp/rtl\\\",rtl)\n    p=rtl/\\\"alu.sv\\\"; t=p.read_text()\n    if not cmp:\n        t=t.replace(\\\"  assign cmp_unsigned_lt = a < b;\\\", \\\"\\\"\\\"  logic [32:0] difference;\n  assign difference = {1'b0,a} - {1'b0,b};\n  assign cmp_unsigned_lt = difference[32];\\\"\\\"\\\").replace(\\\"out = a - b;\\\", \\\"out = difference[31:0];\\\")\n        if chunk:\n            t=t.replace(\\\"  assign difference = {1'b0,a} - {1'b0,b};\\\", \\\"\\\"\\\"  logic [16:0] sub_low, sub_high_b0, sub_high_b1;\n  assign sub_low = {1'b0,a[15:0]} - {1'b0,b[15:0]};\n  assign sub_high_b0 = {1'b0,a[31:16]} - {1'b0,b[31:16]};\n  assign sub_high_b1 = 17'(({1'b0,a[31:16],1'b0} - {1'b0,b[31:16],1'b1}) >> 1);\n  assign difference = {sub_low[16] ? sub_high_b1 : sub_high_b0, sub_low[15:0]};\\\"\\\"\\\")\n    elif chunk:\n        t=t.replace(\\\"  assign cmp_unsigned_lt = a < b;\\\", \\\"\\\"\\\"  logic [3:0] less, equal;\n  for (genvar i = 0; i < 4; i++) begin : gen_compare\n    assign less[i] = a[8*i+:8] < b[8*i+:8];\n    assign equal[i] = a[8*i+:8] == b[8*i+:8];\n  end\n  assign cmp_unsigned_lt = less[3] || (equal[3] && less[2]) || ((&equal[3:2]) && less[1]) || ((&equal[3:1]) && less[0]);\\\"\\\"\\\").replace(\\\"cmp_equal = a == b\\\", \\\"cmp_equal = &equal\\\")\n    p.write_text(t)\n    if redirect:\n        shutil.copyfile(root/\\\"reg_redirect_select/rtl\\\"/\\\"if_stage.sv\\\", rtl/\\\"if_stage.sv\\\")\n        p=rtl/\\\"ex_stage.sv\\\"; t=p.read_text()\n        s=(root/\\\"reg_redirect/rtl/ex_stage.sv\\\").read_text()\n        repl=s[s.index(\\\"  assign redirect_word\\\"):s.index(\\\"  assign train_branch\\\")]\n        t=t.replace(\\\"  assign redirect_word  = pc_next[31:2];\\\\n\\\", repl)\n        p.write_text(t)\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\",\n                n, root / v / f\\\"gowin_p{n}\\\"): (v, n)\n            for n in (1,0) for v in variants}\n    for job in as_completed(jobs):\n        v,n=jobs[job]; res=job.result()\n        print(v,n,\\\"Fmax\\\",res.get(\\\"fmax_mhz\\\"),\\\"logic\\\",res.get(\\\"logic\\\"),res.get(\\\"reason\\\", \\\"\\\"))\n        for path in res.get(\\\"critical_paths\\\", [])[:2]:\n            print(\\\" \\\",path)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
