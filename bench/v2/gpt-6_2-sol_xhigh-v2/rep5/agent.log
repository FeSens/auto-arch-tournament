{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'scratch_variant=\"$TMPDIR/r4s2-predictor/free4-clear\"\npython3 - <<'\"'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path.cwd()\nscratch = Path(os.environ['TMPDIR']) / 'r4s2-predictor'\nvariant = scratch / 'free4-clear'\ncore = variant / 'cores/bench'\ncore.mkdir(parents=True, exist_ok=True)\n(core / 'rtl').symlink_to(variant / 'rtl', target_is_directory=True)\nshutil.copytree(scratch / 'cores/bench/test', core / 'test', dirs_exist_ok=True)\nshutil.copy2(scratch / 'cores/bench/core.yaml', core)\n\nformal = variant / 'formal'\nshutil.copytree(root / 'formal', formal, ignore=shutil.ignore_patterns('riscv-formal'), dirs_exist_ok=True)\nformal_vendor = formal / 'riscv-formal'\nformal_vendor.mkdir(exist_ok=True)\nvendor = root / '../../../../formal/riscv-formal'\nfor name in ('bus', 'checks', 'insns', 'monitor'):\n    (formal_vendor / name).symlink_to((vendor / name).resolve(), target_is_directory=True)\nPY\ncd \\\"\"'$scratch_variant\" && RTL_DIR=cores/bench/rtl CORE_NAME=bench JOBS=4 bash formal/run_all.sh > formal-check.log 2>&1\ncheck_status=$?\ntail -30 formal-check.log\nexit \"$check_status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
