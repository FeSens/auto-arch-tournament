{"type": "item.started", "item": {"id": "item_51", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch=Path(os.environ['TMPDIR'])/'fetch-target-study'\nfor variant in ('compact_imm','compact_imm_exact','compare_8_decode','compare_8_predmask'):\n    dest=scratch/variant\n    source='baseline' if variant.startswith('compact') else 'branch_compare'\n    shutil.copytree(scratch/source/'cores/bench',dest/'cores/bench',ignore=shutil.ignore_patterns('generated','obj_dir'))\n    for name in ('bench','tools','test','Makefile','fpga'):\n        (dest/name).symlink_to(scratch/name,target_is_directory=name\"'!='\"'Makefile')\n    basedir=dest/'cores/bench/rtl'\n    if variant.startswith('compact'):\n        path=basedir/'core_pkg.sv'\n        rtl=path.read_text().replace('    logic [31:0] imm;','    logic [19:0] imm_bits;',1)\n        path.write_text(rtl)\n        path=basedir/'if_stage.sv'\n        rtl=path.read_text()\n        if variant == 'compact_imm':\n            rtl=rtl.replace('  imm_gen u_imm (.instr(imem_data), .imm(response.imm));', '''  logic [31:0] response_imm;\n  imm_gen u_imm (.instr(imem_data), .imm(response_imm));\n  assign response.imm_bits = (imem_data[6:0] == 7'h17 || imem_data[6:0] == 7'h37) ?\n                              response_imm[31:12] : {{8{response_imm[11]}}, response_imm[11:0]};''')\n        else:\n            rtl=rtl.replace('  imm_gen u_imm (.instr(imem_data), .imm(response.imm));', '''  logic [31:0] response_imm;\n  imm_gen u_imm (.instr(imem_data), .imm(response_imm));\n  assign response.imm_bits = (imem_data[6:0] == 7'h17 || imem_data[6:0] == 7'h37) ?\n                              response_imm[31:12] : response_imm[19:0];''')\n        path.write_text(rtl)\n        path=basedir/'id_stage.sv'\n        rtl=path.read_text().replace('reg_q.imm              <= in.imm;', '''reg_q.imm              <= in.ctrl.is_lui || in.ctrl.is_auipc ?\n                                 {in