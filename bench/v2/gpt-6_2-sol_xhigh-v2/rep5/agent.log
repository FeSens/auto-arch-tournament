{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"cat formal/wrapper_si.sv; rg -n 'imem.*(valid|Ready)|ASSUME|cache|FENCE.I' formal/checks_si.cfg cores/bench/test/test_pipeline.py CLAUDE.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"cat formal/wrapper_si.sv; rg -n 'imem.*(valid|Ready)|ASSUME|cache|FENCE.I' formal/checks_si.cfg cores/bench/test/test_pipeline.py CLAUDE.md\"","aggregated_output":"// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n        .io_rvfi_trap_0     (rvfi_trap),\n        .io_rvfi_halt_0     (rvfi_halt),\n        .io_rvfi_intr_0     (rvfi_intr),\n        .io_rvfi_mode_0     (rvfi_mode),\n        .io_rvfi_ixl_0      (rvfi_ixl),\n        .io_rvfi_rs1_addr_0 (rvfi_rs1_addr),\n        .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata),\n        .io_rvfi_rs2_addr_0 (rvfi_rs2_addr),\n        .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata),\n        .io_rvfi_rd_addr_0  (rvfi_rd_addr),\n        .io_rvfi_rd_wdata_0 (rvfi_rd_wdata),\n        .io_rvfi_pc_rdata_0 (rvfi_pc_rdata),\n        .io_rvfi_pc_wdata_0 (rvfi_pc_wdata),\n        .io_rvfi_mem_addr_0 (rvfi_mem_addr),\n        .io_rvfi_mem_rmask_0(rvfi_mem_rmask),\n        .io_rvfi_mem_wmask_0(rvfi_mem_wmask),\n        .io_rvfi_mem_rdata_0(rvfi_mem_rdata),\n        .io_rvfi_mem_wdata_0(rvfi_mem_wdata)\n    );\n\nendmodule\nCLAUDE.md:65:imem/dmem port set (`io_imemAddr`, `io_imemData`, `io_imemReady`,\nCLAUDE.md:75:- Add new modules (branch predictors, caches, reservation stations…).\ncores/bench/test/test_pipeline.py:101:    dut.io_imemReady.value = 1\ncores/bench/test/test_pipeline.py:122:        dut.io_imemReady.value = 1 if imem_ready is None else int(imem_ready(ia))\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_30", "type": "command_execution", "command": "/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\"\nPREDICTOR_VARIANTS=\"$trial_dir\" PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\noriginal = root / 'cores/bench/rtl'\nscratch = Path(os.environ['PREDICTOR_VARIANTS'])\nbase = (original/'if_stage.sv').read_text()\nparallel = (scratch/'parallel/if_stage.sv').read_text()\ntwo_pc = (scratch/'two-pc/if_stage.sv').read_text()\n\ndef template(src, page_width, style):\n    lo = page_width + 1\n    hi = lo + 1\n    ow = 19 - page_width\n    if ow < 1:\n        raise ValueError(page_width)\n    src = src.replace('logic [31:2] direct_word;', f\\\"\\\"\\\"logic [{lo}:2] direct_word;\n  logic target_carry;\\\"\\\"\\\")\n    start = src.index('  assign direct_word =') if '  assign direct_word =' in src else src.index('  logic [11:0] upper_pc')\n    end = src.index('  assign direct_bit1', start)\n    if style == 'simple':\n        low = f\\\"  assign {{target_carry, direct_word}} = {{1'b0, pc_word[{lo}:2]}} + {{1'b0, offset_word[{lo}:2]}};\\\"\n    else:\n        mid = page_width // 2 + 2\n        wl = mid - 2\n        wh = page_width - wl\n        low = f\\\"\\\"\\\"  logic [{wl}:0] sum_low;\n  logic [{wh}:0] sum_high;\n  logic [{wh-1}:0] sum_high_plus_one;\n  assign sum_low = {{1'b0, pc_word[{mid-1}:2]}} + {{1'b0, offset_word[{mid-1}:2]}};\n  assign sum_high = {{1'b0, pc_word[{lo}:{mid}]}} + {{1'b0, offset_word[{lo}:{mid}]}};\n  assign sum_high_plus_one = pc_word[{lo}:{mid}] + offset_word[{lo}:{mid}] + {wh}'d1;\n  assign target_carry = sum_high[{wh}] || ((&sum_high[{wh-1}:0]) && sum_low[{wl}]);\n  assign direct_word = {{(sum_low[{wl}] ? sum_high_plus_one : sum_high[{wh-1}:0]), sum_low[{wl-1}:0]}};\\\"\\\"\\\"\n    src = src[:start] + f\\\"\\\"\\\"{low}\n  logic direct_in_aperture;\n  assign direct_in_aperture = pc_word[31:20] == 12'b0\n                          && offset_word[20:{hi}] == {{{ow}{{offset_word[20]}}}}\n                          && target_carry == offset_word[20];\n\\\"\\\"\\\" + src[end:]\n    src = src.replace('imem_ready && \"'!direct_bit1 && direct_word[31:20] == 12'\"\\\\'b0', '\"'!direct_bit1 && direct_in_aperture'\"')\n    src = src.replace('<= direct_word[19:2];', f\\\"<= {{pc_word[19:{hi}], direct_word}};\\\")\n    src = src.replace('? direct_word : pc_word', f\\\"? {{pc_word[31:{hi}], direct_word}} : pc_word\\\")\n    src = src.replace(\\\"  assign response.direct_target    = {direct_word, direct_bit1, 1'b0};\\\", '''  assign response.direct_word_low  = direct_word;\n  assign response.target_carry    = target_carry;''')\n    return src\n\ndef add_id_target(dst, page_width, alt):\n    lo = page_width + 1\n    hi = lo + 1\n    uw = 30 - page_width\n    ow = 19 - page_width\n    pkg_path = dst/'core_pkg.sv'\n    pkg = pkg_path.read_text().replace('    logic [31:0] direct_target;', f'''    logic [{lo}:2] direct_word_low;\n    logic        target_carry;''', 1)\n    id_path = dst/'id_stage.sv'\n    id_src = id_path.read_text().replace('  // ── ID/EX register', f'''  logic [{uw-1}:0] upper_offset, upper_target;\n  logic [31:0] target_from_packet;\n  logic is_jal, target_bit1;\n  assign is_jal = in.instr[6:0] == 7'b1101111;\n  assign upper_offset = {{{{{uw-ow}{{in.instr[31]}}}}, in.imm[20:{hi}]}};\n  assign upper_target = in.pc[31:{hi}] + upper_offset + {{{uw-1}'b0, in.target_carry}};\n  assign target_bit1 = is_jal ? in.instr[21] : in.instr[8];\n  assign target_from_packet = {{upper_target, in.direct_word_low, target_bit1, 1'b0}};\n\n  // ── ID/EX register''')\n    # Branch/JAL precise high displacement is already sign-extended in packet.imm.\n    id_src = id_src.replace('<= in.direct_target;', '<= target_from_packet;')\n    if alt:\n        anchor = '  typedef struct packed {\\\\n    logic [31:0] pc;\\\\n    logic [31:0] direct_target;'\n        pkg = pkg.replace(anchor, anchor + '\\\\n    logic [31:2] alternate_word;\\\\n    logic [31:0] fallthrough;')\n        id_src = id_src.replace('  // ── ID/EX register', '''  logic [31:0] fallthrough;\n  assign fallthrough = in.pc + 32'd4;\n\n  // ── ID/EX register''')\n        id_src = id_src.replace('      reg_q.direct_target    <= target_from_packet;', '''      reg_q.direct_target    <= target_from_packet;\n      reg_q.alternate_word   <= in.predicted_taken ? fallthrough[31:2] : target_from_packet[31:2];\n      reg_q.fallthrough      <= fallthrough;''')\n        exfile = dst/'ex_stage.sv'\n        extext = exfile.read_text().replace(\\\"assign pc_plus_4      = in.pc + 32'd4;\\\", \\\"assign pc_plus_4      = in.fallthrough;\\\")\n        exfile.write_text(extext.replace('in.predicted_taken ? pc_plus_4[31:2] : target[31:2]', 'in.ctrl.is_jalr ? jalr_sum[31:2] : in.alternate_word'))\n    pkg_path.write_text(pkg)\n    id_path.write_text(id_src)\n\nvariants = {\n    'page12': (base, 12, 'simple', False),\n    'page13': (base, 13, 'simple', False),\n    'page14': (base, 14, 'split', False),\n    'page14-alt': (base, 14, 'split', True),\n    'page12-parallel': (parallel, 12, 'simple', False),\n    'page12-two': (two_pc, 12, 'simple', False),\n    'page14-two': (two_pc, 14, 'split', False),\n    'page16-two': (two_pc, 16, 'split', False),\n}\nfor name, (src, width, style, alt) in variants.items():\n    directory = scratch/name\n    shutil.copytree(original, directory, copy_function=shutil.copyfile)\n    # J and B immediate high bits (at least bit 14) equal the sign for B.\n    (directory/'if_stage.sv').write_text(template(src, width, style))\n    add_id_target(directory, width, alt)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:\n    builds = {pool.submit(build, root, scratch/name, 'fpga/core_bench_si.sv', option, scratch/f'{name}-{option}'): (name, option)\n              for option in (1, 0) for name in variants}\n    for future in concurrent.futures.as_completed(builds):\n        result = future.result()\n        print(builds[future], result.get('fmax_mhz'), result.get('reason'), (result.get('critical_paths') or [None])[0], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"sed -n '300,405p' cores/bench/test/test_pipeline.py; sed -n '430,512p' cores/bench/test/test_pipeline.py; sed -n '585,667p' cores/bench/test/test_pipeline.py; rg -n '(function|define) validate_coremark_uart|def validate_coremark_uart' tools/eval/fpga.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"sed -n '300,405p' cores/bench/test/test_pipeline.py; sed -n '430,512p' cores/bench/test/test_pipeline.py; sed -n '585,667p' cores/bench/test/test_pipeline.py; rg -n '(function|define) validate_coremark_uart|def validate_coremark_uart' tools/eval/fpga.py\"", "aggregated_output": "    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    fetches = []\n\n    def imem_ready(addr):\n        fetches.append(addr)\n        return addr != 20 or fetches.count(20) == 3\n\n    rets, dmem = await _run(dut, program, imem_ready=imem_ready)\n    assert fetches[:7] == [4, 8, 12, 16, 20, 20, 20]\n    [load] = _by_insn(rets, LW(1, 0, 0))\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"cycle\"] - load[\"cycle\"] == 2\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def issue_fifo_bypasses_fills_and_wraps(dut):\n    reserved_store = _s(-124, 4, 1, 3, 0b0100011)\n    program = [\n        ADDI(1, 0, 0x180),\n        ADDI(2, 0, 0x55),\n        SW(2, 1, -128),       # Stall in MEM while four responses queue.\n        ADDI(3, 2, 3),        # Hold in EX while the other stages drain.\n        LUI(4, 0x87654),      # Start filling at PC 16, after four bypasses.\n        ADDI(4, 4, -1919),\n        reserved_store,\n        SB(4, 1, -125),\n        LB(5, 1, -125),       # Accepted after the first pop from full.\n        ADD(6, 3, 5),         # Fetch stalls here while the FIFO drains.\n        EBREAK(),\n    ]\n    requests, fetches = [], []\n\n    def dmem_ready(addr, ren, wen):\n        if ren or wen:\n            requests.append((addr, ren, wen))\n        return len(requests) >= 6\n\n    def imem_ready(addr):\n        fetches.append(addr)\n        return addr != 36 or fetches.count(36) == 6\n\n    rets, dmem = await _run(dut, program, dmem_ready=dmem_ready, imem_ready=imem_ready)\n    assert fetches[:17] == [4, 8, 12, 16, 20, 24, 28, 32, 3\n…[7483 of 10555 chars elided by tools/bench/transcript.py; sha256:505201a1a56cf437]…\narget[\"cycle\"] - branch[\"cycle\"] == 2\n    # A single update from the stalled branch leaves the counter at 10.\n    # The first probe is predicted taken and decrements it back to 01.\n    assert fallthrough[\"cycle\"] - first_probe[\"cycle\"] == 2\n    assert end[\"cycle\"] - second_probe[\"cycle\"] == 2\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"JALR adds to forwarded rs1, clears bit zero, and recovers in EX.\"\"\"\n    program = [\n        ADDI(5, 0, 11),        # PC=0;  x5 := 11\n        JALR(1, 5, 2),         # PC=4;  jump to (11 + 2) & ~1 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    _, jump, target, _ = rets\n    assert (jump[\"pc_next\"], jump[\"rd_wdata\"]) == (12, 8)\n    assert target[\"cycle\"] - jump[\"cycle\"] == 2\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\"\nPREDICTOR_VARIANTS=\"$trial_dir\" PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\noriginal = root / 'cores/bench/rtl'\nscratch = Path(os.environ['PREDICTOR_VARIANTS'])\n\ndef banked(src, partition, mode):\n    old_start = src.index('  logic [1:0]  counters')\n    old_end = src.index('  logic        is_branch', old_start)\n    lw = 6 - partition\n    banks = 1 << partition\n    indexes = 1 << lw\n    lookup = 'prediction_index'\n    idx = 'update_index_q'\n    usel = f'{idx}[5:{lw}]' if mode == 'hi' else f'{idx}[{partition-1}:0]'\n    psel = f'{lookup}[5:{lw}]' if mode == 'hi' else f'{lookup}[{partition-1}:0]'\n    uidx = f'{idx}[{lw-1}:0]' if mode == 'hi' else f'{idx}[5:{partition}]'\n    pidx = f'{lookup}[{lw-1}:0]' if mode == 'hi' else f'{lookup}[5:{partition}]'\n    body = f'''  logic        update_valid_q, update_taken_q;\n  logic [5:0]  update_index_q;\n  logic [1:0]  update_counter, updated_counter;\n  logic [{banks-1}:0] prediction_bank_taken, update_bank_hi, update_bank_lo;\n\n  assign update_counter = {{|update_bank_hi, |update_bank_lo}};\n  assign updated_counter[1] = update_taken_q ? (update_counter[1] || update_counter[0])\n                                             : (update_counter[1] && update_counter[0]);\n  assign updated_counter[0] = update_taken_q ? (update_counter[1] || \"'!update_counter[0])\n                                             : (update_counter[1] && !update_counter[0]);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      history_q      <= 2'\"'b00;\n      update_valid_q <= 1'b0;\n      update_taken_q <= 1'b0;\n      update_index_q <= 6'b0;\n    end else begin\n      update_valid_q <= train_branch;\n      if (train_branch) begin\n        history_q      <= {{history_q[0], train_taken}};\n        update_index_q <= train_index;\n        update_taken_q <= train_taken;\n      end\n    end\n  end\n\n  for (genvar bank = 0; bank < {banks}; bank++) begin : gen_counter_bank\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counters [0:{indexes-1}];\n    logic [{indexes-1}:0] valid_q;\n    logic write_bank;\n    logic [1:0] raw_update;\n    logic update_valid_entry;\n\n    assign write_bank = \"'!reset && update_valid_q && {usel} == {partition}'\"'(bank);\n    assign raw_update = counters[{uidx}];\n    assign update_valid_entry = valid_q[{uidx}];\n    assign update_bank_hi[bank] = ({usel} == {partition}'(bank)) && update_valid_entry && raw_update[1];\n    assign update_bank_lo[bank] = ({usel} == {partition}'(bank)) && (\"'!update_valid_entry || raw_update[0]);\n    assign prediction_bank_taken[bank] = ({psel} == {partition}'\"'(bank))\n                                       && valid_q[{pidx}] && counters[{pidx}][1];\n\n    always_ff @(posedge clock) begin\n      if (write_bank)\n        counters[{uidx}] <= updated_counter;\n      if (reset)\n        valid_q <= '0;\n      else if (write_bank)\n        valid_q[{uidx}] <= 1'b1;\n    end\n  end\n\n'''\n    src = src[:old_start] + body + src[old_end:]\n    return src.replace('counters[prediction_index][1]', '|prediction_bank_taken')\n\nvariants = [\n    ('bank4-hi', original, 2, 'hi'),\n    ('bank4-lo', original, 2, 'lo'),\n    ('bank2-hi', original, 1, 'hi'),\n    ('bank2-lo', original, 1, 'lo'),\n    ('bank4-par', scratch/'parallel', 2, 'hi'),\n    ('bank4-trim', scratch/'parallel-compact', 2, 'hi'),\n    ('bank4-split', scratch/'split-only', 2, 'lo'),\n    ('bank4-two', scratch/'two-pc-compact', 2, 'lo'),\n]\nfor name, src, banks, mode in variants:\n    directory = scratch/name\n    shutil.copytree(src, directory, copy_function=shutil.copyfile)\n    path = directory/'if_stage.sv'\n    path.write_text(banked(path.read_text(), banks, mode))\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:\n    builds = {pool.submit(build, root, scratch/name, 'fpga/core_bench_si.sv', option, scratch/f'{name}-{option}'): (name, option)\n              for option in (1, 0) for name, *_ in variants}\n    for future in concurrent.futures.as_completed(builds):\n        result = future.result()\n        print(builds[future], result.get('fmax_mhz'), result.get('reason'), result.get('logic'), result.get('regs'),\n              (result.get('critical_paths') or [None])[0], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
