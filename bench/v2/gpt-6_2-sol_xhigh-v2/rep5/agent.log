rite_q[1:0]] <= fetch_packet;\n    if (reset || recovering) begin\n      read_q <= '\"'0;\n      write_q <= '0;\n    end else begin\n      if (\"'!empty && !stall) read_q <= read_q + 3'\"'d1;\n      if (accept && (\"'!empty || stall)) write_q <= write_q + 3'\"'d1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_word <= '0;\n      wait_last_q <= 1'b0;\n    end else begin\n      if (accept_normal)\n        pc_word <= predicted_taken ? direct_word : request_word + 30'd1;\n      else if (recovering)\n        pc_word <= request_word;\n      if (accept && \"'!accept_normal)\n        wait_last_q <= 1'\"'b1;\n      else if (recovering)\n        wait_last_q <= 1'b0;\n    end\n  end\n\n  assign imem_addr                   = {request_word, 2'b00};\n  assign fetch_packet.pc             = imem_addr;\n  assign fetch_packet.instr          = imem_data;\n  assign fetch_packet.valid          = imem_ready && (recovering || \"'!wait_last_q)\n                                                   && (!request_is_last || empty);\n  assign fetch_packet.direct_target  = {direct_word, direct_bit1, 1'\"'b0};\n  assign fetch_packet.predicted_taken = predicted_taken;\n  assign fetch_packet.prediction_index = prediction_index;\n  assign out = empty ? fetch_packet : packets[read_q[1:0]];\n\nendmodule\n'''\nsave('if_stage.sv', p)\np = load('core.sv')\np = p.replace('  id_ex_t  id_ex_w;', '''  id_ex_t  id_ex_w, id_ex_raw;\n\n  always_comb begin\n    id_ex_w = id_ex_raw;\n    id_ex_w.valid = id_ex_raw.valid && \"'!recovering;\n  end'\"''')\np = p.replace('  logic        redirect;\\\\n  logic [31:2] redirect_word;', '''  logic [2:0]  recover_select;\n  logic [31:2] recover_fallthrough, recover_direct, recover_indirect;\n  logic        recovering;''')\np = p.replace('    .redirect        (redirect),\\\\n    .redirect_word   (redirect_word),', '''    .recover_select      (recover_select),\n    .recover_fallthrough (recover_fallthrough),\n    .recover_direct      (reco