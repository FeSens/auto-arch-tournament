{"type": "item.started", "item": {"id": "item_76", "type": "command_execution", "command": "/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport os\nimport subprocess\nimport tempfile\n\nsource = \\\"module addi_bypass_check (\\\\n  input logic clock, reset, stall, issue, immediate_add,\\\\n  input logic ex_writes, ex_is_addi, mem_writes, pending1, pending2, predecessor_writes,\\\\n  input logic [4:0] rs1, rs2, ex_rd, mem_rd,\\\\n  input logic [11:0] offset,\\\\n  input logic [31:0] rf1, rf2, ex_value, addr_value, wb_value,\\\\n  output logic okay\\\\n);\\\\n  logic [4:0] tag1, tag2;\\\\n  logic [31:0] rf1_read, rf2_read;\\\\n  issue_packet_t packet;\\\\n  operand_sel_t sel1, sel2;\\\\n  id_ex_t id_entry;\\\\n  ex_mem_t ex_entry;\\\\n  mem_wb_t wb_entry;\\\\n  logic fast_write, fast_addi;\\\\n\\\\n  always_comb begin\\\\n    packet = '0;\\\\n    packet.ctrl.alu_op = ALU_ADD;\\\\n    packet.ctrl.alu_src = immediate_add;\\\\n    packet.ctrl.reg_write = 1'b1;\\\\n    packet.late_eligible = 1'b1;\\\\n    packet.imm = immediate_add ? {{20{offset[11]}}, offset} : 32'b0;\\\\n    packet.instr[19:15] = rs1;\\\\n    packet.instr[24:20] = immediate_add ? offset[4:0] : rs2;\\\\n  end\\\\n  assign rf1_read = tag1 == 5'b0 ? 32'b0 : rf1;\\\\n  assign rf2_read = tag2 == 5'b0 ? 32'b0 : rf2;\\\\n\\\\n  forward_unit fwd (\\\\n    .rs1_addr(tag1), .rs2_addr(tag2), .ex_rd(ex_rd),\\\\n    .ex_fast_write(ex_writes), .ex_fast_addi(ex_writes && ex_is_addi),\\\\n    .mem_rd(mem_rd), .mem_write(mem_writes), .rs1_sel(sel1), .rs2_sel(sel2)\\\\n  );\\\\n  id_stage decode_id (\\\\n    .clock(clock), .reset(reset), .hold(stall), .issue_candidate(issue && \"'!stall),'\"\\\\n    .issue(issue), .in(packet), .rs1_addr(tag1), .rs2_addr(tag2),\\\\n    .rs1_data(rf1_read), .rs2_data(rf2_read), .rs1_sel(sel1), .rs2_sel(sel2),\\\\n    .pending_rs1(pending1), .pending_rs2(pending2), .out(id_entry)\\\\n  );\\\\n  ex_stage execute (\\\\n    .clock(clock), .reset(reset), .stall(stall), .mem_recovery(1'b0),\\\\n    .in(id_entry), .fwd_ex_mem(ex_value), .fwd_ex_address(addr_value), .fwd_mem_wb(wb_value),\\\\n    .mem_next_write(predecessor_writes), .out(ex_entry), .fast_write(fast_write),\\\\n    .fast_addi(fast_addi)\\\\n  );\\\\n  mem_stage memory (\\\\n    .clock(clock), .reset(reset), .hold_wb(stall), .recovery(1'b0), .in(ex_entry),\\\\n    .multiply_result(32'b0), .divide_result(32'b0), .dmem_rdata(32'b0), .out(wb_entry)\\\\n  );\\\\n\\\\n  logic id_valid_e, ex_valid_e, wb_valid_e;\\\\n  logic id_imm_add_e, id_pend1_e, id_pend2_e;\\\\n  logic [1:0] src1_e, src2_e;\\\\n  logic [31:0] rf1_e, rf2_e, id_imm_e, r1_ex, r2_ex;\\\\n  logic [31:0] ex_r1_e, ex_r2_e, ex_imm_e;\\\\n  logic ex_imm_add_e, ex_pend1_e, ex_pend2_e;\\\\n  logic [31:0] wb_r1_e, wb_r2_e, wb_result_e;\\\\n  logic [31:0] r1_mem, r2_mem;\\\\n\\\\n  function automatic logic [1:0] expected_source(input logic [4:0] tag);\\\\n    if (ex_writes && tag \"'!= 0 && tag == ex_rd)'\"\\\\n      expected_source = ex_is_addi ? 2'd3 : 2'd2;\\\\n    else if (mem_writes && tag \"'!= 0 && tag == mem_rd)'\"\\\\n      expected_source = 2'd1;\\\\n    else\\\\n      expected_source = 2'd0;\\\\n  endfunction\\\\n\\\\n  function automatic logic [31:0] expected_operand(input logic [1:0] src,\\\\n                                                    input logic [31:0] saved);\\\\n    case (src)\\\\n      2'd3: expected_operand = addr_value;\\\\n      2'd2: expected_operand = ex_value;\\\\n      2'd1: expected_operand = wb_value;\\\\n      default: expected_operand = saved;\\\\n    endcase\\\\n  endfunction\\\\n\\\\n  assign r1_ex = expected_operand(src1_e, rf1_e);\\\\n  assign r2_ex = expected_operand(src2_e, rf2_e);\\\\n  assign r1_mem = ex_pend1_e ? wb_entry.result : ex_r1_e;\\\\n  assign r2_mem = ex_pend2_e ? wb_entry.result : ex_r2_e;\\\\n\\\\n  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      id_valid_e <= 1'b0;\\\\n      ex_valid_e <= 1'b0;\\\\n      wb_valid_e <= 1'b0;\\\\n    end else begin\\\\n      wb_valid_e <= ex_valid_e && \"'!stall;'\"\\\\n      if (\"'!stall) begin'\"\\\\n        id_valid_e <= issue;\\\\n        ex_valid_e <= id_valid_e;\\\\n        if (issue) begin\\\\n          src1_e <= expected_source(tag1);\\\\n          src2_e <= expected_source(tag2);\\\\n          rf1_e <= rf1_read;\\\\n          rf2_e <= rf2_read;\\\\n          id_imm_add_e <= immediate_add;\\\\n          id_pend1_e <= pending1;\\\\n          id_pend2_e <= pending2;\\\\n          id_imm_e <= packet.imm;\\\\n        end\\\\n        ex_r1_e <= r1_ex;\\\\n        ex_r2_e <= r2_ex;\\\\n        ex_imm_add_e <= id_imm_add_e;\\\\n        ex_imm_e <= id_imm_e;\\\\n        ex_pend1_e <= id_pend1_e && predecessor_writes;\\\\n        ex_pend2_e <= id_pend2_e && predecessor_writes;\\\\n        wb_r1_e <= r1_mem;\\\\n        wb_r2_e <= r2_mem;\\\\n        wb_result_e <= r1_mem + (ex_imm_add_e ? ex_imm_e : r2_mem);\\\\n      end\\\\n    end\\\\n  end\\\\n\\\\n  assign okay = id_entry.valid == id_valid_e\\\\n             && ex_entry.valid == ex_valid_e\\\\n             && wb_entry.valid == wb_valid_e\\\\n             && (\"'!id_valid_e ||'\"\\\\n                 (fast_write == \"'!(id_pend1_e || (id_pend2_e && !id_imm_add_e))'\"\\\\n                  && fast_addi == (fast_write && id_imm_add_e)))\\\\n             && (\"'!ex_valid_e ||'\"\\\\n                 (ex_entry.rs1_val == ex_r1_e && ex_entry.rs2_val == ex_r2_e\\\\n                  && ex_entry.mem_addr == ex_r1_e + ex_imm_e))\\\\n             && (\"'!wb_valid_e ||'\"\\\\n                 (wb_entry.rs1_val == wb_r1_e && wb_entry.rs2_val == wb_r2_e\\\\n                  && wb_entry.result == wb_result_e));\\\\nendmodule\\\"\nscript = \\\"read_verilog -sv -formal -D RISCV_FORMAL_ALTOPS cores/bench/rtl/core_pkg.sv cores/bench/rtl/forward_unit.sv cores/bench/rtl/id_stage.sv cores/bench/rtl/alu.sv cores/bench/rtl/ex_stage.sv cores/bench/rtl/multiplier.sv cores/bench/rtl/divider.sv cores/bench/rtl/mem_stage.sv /dev/stdin; hierarchy -check -top addi_bypass_check; proc; flatten; opt; sat -verify -seq 5 -set-def-inputs -set-at 1 reset 1 -set-at 2 reset 0 -set-at 3 reset 0 -set-at 4 reset 0 -set-at 5 reset 0 -prove-skip 1 -prove okay 1 -show-inputs -show-outputs\\\"\nwith tempfile.NamedTemporaryFile(suffix=\\\".sv\\\", dir=os.environ[\\\"TMPDIR\\\"]) as temporary:\n    temporary.write(source.encode())\n    temporary.flush()\n    result = subprocess.run(\n        [\\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", script.replace(\\\"/dev/stdin\\\", temporary.name)],\n        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,\n    )\nprint(\\\"\\\\n\\\".join(result.stdout.splitlines()[-55:]))\nraise SystemExit(result.returncode)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
