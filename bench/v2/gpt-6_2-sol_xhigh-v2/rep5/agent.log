{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\n\ncases = 0\nfor head, count in product(range(8), range(5)):\n    tail = (head + count) % 8\n    for sources in product(range(2), repeat=count):\n        slots = [(head + k) % 8 for k in range(count)]\n        assert tail not in slots\n        for recovery, stall, ready, live_valid, replay_hit in product((False, True), repeat=5):\n            if live_valid and not ready:\n                continue\n            cases += 1\n            old_fifo = list(zip(slots, sources))\n            space = recovery or count < 4\n            live_accept = space and live_valid\n            replay_accept = space and not recovery and not ready and replay_hit\n            enqueue = live_accept or replay_accept\n            source = int(replay_accept)\n\n            fifo = [] if recovery else old_fifo.copy()\n            if enqueue:\n                fifo.append((tail, source))\n            issue = not stall and bool(fifo) and (bool(old_fifo and not recovery) or live_accept)\n            expected_output = fifo.pop(0) if issue else None\n\n            is_empty = recovery or count == 0\n            head_source = sources[0] if sources else None\n            got_output = ((tail, 0) if is_empty else (head, head_source)) if issue else None\n            assert got_output == expected_output\n            next_head = ((tail if recovery else head) + issue) % 8\n            next_tail = (tail + enqueue) % 8\n            assert (next_tail - next_head) % 8 == len(fifo)\n            source_map = dict(old_fifo)\n            next_head_source = source if enqueue and next_head == tail else source_map.get(next_head)\n            if fifo:\n                assert (next_head, next_head_source) == fifo[0]\n            if enqueue:\n                source_map[tail] = source\n            assert [((next_head + k) % 8, source_map[(next_head + k) % 8]) for k in range(len(fifo))] == fifo\nprint(f'{cases:,} abstract FIFO transitions matched the reference queue.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
