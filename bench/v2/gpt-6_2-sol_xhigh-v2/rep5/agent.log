  b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return\n…[14488 of 17560 chars elided by tools/bench/transcript.py; sha256:dd7f759a1dbd46b6]…\n\n        assert ren == 0\n        return True\n\n    rets, dmem = await _run(dut, program, dmem_ready=ready)\n    assert requests == {0x40: 4, 0x44: 4}\n    assert dmem == {0x40: 7, 0x44: 5}\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    _, _, older, mul, younger, add, _ = rets\n    assert (mul[\"rs1_rdata\"], mul[\"rs2_rdata\"], mul[\"rd_wdata\"]) == (7, 5, 35)\n    assert (add[\"rs1_rdata\"], add[\"rs2_rdata\"], add[\"rd_wdata\"]) == (35, 5, 40)\n    assert mul[\"cycle\"] - older[\"cycle\"] == add[\"cycle\"] - younger[\"cycle\"] == 1\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"multiplier.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_67", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/7c172beb/b8ba2d87/bench-r5s1-ejhir1la/prepare_wb.py' <<'PY'\nfrom pathlib import Path\nimport shutil\nroot = Path(__file__).parent\nsource = Path.cwd()\nfor mode in ('issue_wb', 'issue_wb_bitmap', 'issue_match_agu'):\n    path = root / mode\n    rtl = path / 'cores/bench/rtl'\n    rtl.parent.mkdir(parents=True)\n    (path / 'fpga').symlink_to(source / 'fpga')\n    (path / 'bench').symlink_to(root / 'bench')\n    inputs = root / ('issue_match' if mode == 'issue_match_agu' else 'issue_agu') / 'cores/bench/rtl'\n    shutil.copytree(inputs, rtl)\n    shutil.copy(source / 'cores/bench/core.yaml', rtl.parent)\n\n    def replace(file, old, new):\n        p = rtl / file\n        text = p.read_text()\n        assert text.count(old) == 1, (file, old, text.count(old))\n        p.write_text(text.replace(old, new))\n\n    if mode == 'issue_match_agu':\n        replace('core_pkg.sv', '    logic [31:0] write_data;     // raw rs2', '    logic [31:0] mem_address;\\\\n    logic [31:0] write_data;     // raw rs2')\n        ex_stage = (root / 'issue_agu' / 'cores/bench/rtl/ex_stage.sv').read_text()\n        a = ex_stage.index('  logic [12:0] address_low;')\n        b = ex_stage.index('  // ── EX/MEM register', a)\n        replace('ex_stage.sv', '  // ── EX/MEM register', ex_stage[a:b] + '  // ── EX/MEM register')\n        replace('ex_stage.sv', '      reg_q.alu_result    <= ex_result;', '      reg_q.alu_result    <= ex_result;\\\\n      reg_q.mem_address   <= {address_high, address_low[11:0]};')\n        p = rtl / 'mem_stage.sv'\n        s = p.read_text().replace('in.alu_result', 'in.mem_address')\n        p.write_text(s.replace('& in.mem_address)', '& in.alu_result)'))\n        continue\n\n    for file in ('core_pkg.sv', 'id_stage.sv', 'ex_stage.sv'):\n        p = rtl / file\n        p.write_text(p.read_text().replace('[2:0]  rs1_select', '[3:0]  rs1_select').replace('[2:0] rs1_select', '[3:0] rs1_select').replace('[2:0]  rs2_select', '[3:0]  rs2_select'))\n    replace('ex_stage.sv', '  input  logic [31:0]        fwd_mem_wb,', '  input  logic [31:0]        fwd_issue_wb,\\\\n  input  logic [31:0]        fwd_mem_wb,')\n    replace('ex_stage.sv', '| ({32{rs1_select[2]}} & fwd_mem_wb);', '| ({32{rs1_select[2]}} & fwd_mem_wb)\\\\n             | ({32{rs1_select[3]}} & fwd_issue_wb);')\n    replace('ex_stage.sv', '| ({32{rs2_select[2]}} & fwd_mem_wb);', '| ({32{rs2_select[2]}} & fwd_mem_wb)\\\\n             | ({32{rs2_select[3]}} & fwd_issue_wb);')\n    replace('core.sv', '  logic [2:0] id_rs1_select, id_rs2_select;', '  logic [3:0] id_rs1_select, id_rs2_select;\\\\n  logic [31:0] issue_wb_data_q;\\\\n  logic rf_rs1_set, rf_rs2_set;')\n    replace('core.sv', '  reg_file u_rf (', \\\"  reg_file #(.WRITE_FIRST(1'b0)) u_rf (\\\")\n    replace('core.sv', '    .w_data   (wb_w_data)\\\\n  );', '    .w_data   (wb_w_data),\\\\n    .rs1_set (rf_rs1_set),\\\\n    .rs2_set (rf_rs2_set)\\\\n  );')\n    replace('core.sv', '    .fwd_mem_wb      (wb_w_data),', '    .fwd_issue_wb    (issue_wb_data_q),\\\\n    .fwd_mem_wb      (wb_w_data),')\n    for n in (1,2):\n        replace('core.sv', f'  assign id_rs{n}_select[0] = \"'!(id_rs{n}_select[1] || id_rs{n}_select[2]);'\"',\n                 f'''  assign id_rs{n}_select[3] = wb_w_en && wb_w_addr == rs{n}_addr_w &&\n                            rs{n}_addr_w \"'!= 5'\"'b0 &&\n                            \"'!(id_rs{n}_select[1] || id_rs{n}_select[2]);\n  assign id_rs{n}_select[0] = rf_rs{n}_set && !(|id_rs{n}_select[3:1]);'\"''')\n    replace('core.sv', '  // ── RVFI', '''  always_ff @(posedge clock) begin\n    if (\"'!stall_id) issue_wb_data_q <= wb_w_data;\n  end\n\n  // ── RVFI'\"'''.replace('  // ── RVFI', '  // ── RVFI', 1)) if False else None\n    replace('core.sv', '  // The MEM/WB register is the retirement boundary.', '''  always_ff @(posedge clock) begin\n    if (\"'!stall_id) issue_wb_data_q <= wb_w_data;\n  end\n\n  // The MEM/WB register is the retirement boundary.'\"''')\n    replace('reg_file.sv', 'module reg_file (', \\\"module reg_file #(parameter WRITE_FIRST = 1'b1) (\\\")\n    replace('reg_file.sv', '  input  logic [31:0] w_data', '  input  logic [31:0] w_data,\\\\n  output logic rs1_set, rs2_set')\n    if mode == 'issue_wb_bitmap':\n        replace('reg_file.sv', '''  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n    end else if (w_en && w_addr \"'!= 5'\"'b0) begin\n      regs[w_addr] <= w_data;\n    end\n  end''', '''  logic [31:0] initialized_q;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      initialized_q <= '0;\n    else if (w_en && w_addr \"'!= 5'\"'b0) begin\n      initialized_q[w_addr] <= 1'b1;\n      regs[w_addr] <= w_data;\n    end\n  end''')\n    for n in (1,2):\n        replace('reg_file.sv', f\\\"    if (rs{n}_addr == 5'b0)\\\\n\\\", f\\\"    if (WRITE_FIRST && \"'!rs{n}_set)'\"\\\\n\\\")\n        replace('reg_file.sv', f'else if (w_en && w_addr == rs{n}_addr)', f'else if (WRITE_FIRST && w_en && w_addr == rs{n}_addr)')\n        if mode == 'issue_wb_bitmap':\n            replace('reg_file.sv', f\\\"    if (WRITE_FIRST && \"'!rs{n}_set)\", f\"    if (WRITE_FIRST && rs{n}_addr == 5'\"'b0)\\\")\n            replace('reg_file.sv', f'    else\\\\n      rs{n}_data = regs[rs{n}_addr];', f\\\"    else if (WRITE_FIRST && \"'!rs{n}_set)'\"\\\\n      rs{n}_data = 32'b0;\\\\n    else\\\\n      rs{n}_data = regs[rs{n}_addr];\\\")\n        base = f'initialized_q[rs{n}_addr]' if mode == 'issue_wb_bitmap' else f\\\"rs{n}_addr \"'!= 5'\"'b0\\\"\n        replace('reg_file.sv', f\\\"  output logic rs{n}_set\\\" if n == 1 else f\\\"rs1_set, rs{n}_set\\\", f\\\"  output logic rs{n}_set\\\" if n == 1 else f\\\"rs1_set, rs{n}_set\\\")\n        p = rtl / 'reg_file.sv'\n        t = p.read_text()\n        p.write_text(t.replace('  always_comb begin', f'  assign rs{n}_set = {base};\\\\n\\\\n  always_comb begin'))\nPY\npython '/srv/hwebench/tmp/7c172beb/b8ba2d87/bench-r5s1-ejhir1la/prepare_wb.py'\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
