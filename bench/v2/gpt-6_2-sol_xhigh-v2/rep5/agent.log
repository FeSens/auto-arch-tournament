{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport shutil\n\ns = Path(os.environ['TMPDIR']) / 'r10s0'\ns.mkdir()\nfor name in (\\\"radix16\\\",):\n    target = s / name / \\\"cores/bench\\\"\n    shutil.copytree(\\\"cores/bench/rtl\\\", target / \\\"rtl\\\")\n    shutil.copytree(\\\"cores/bench/test\\\", target / \\\"test\\\")\nf = s / \\\"radix16/cores/bench/rtl/divider.sv\\\"\nsrc = f.read_text()\ni = src.index(\\\"  // With D < 2048\\\")\nj = src.index(\\\"  logic [34:0] multiples\\\",i)\nsrc = src[:i] + \\\"\\\"\\\"  // A reduced narrow remainder followed by four dividend bits is < 16D.\n  logic [14:0] narrow_multiple [1:15];\n  logic [14:0] narrow_multiple_q [5:15];\n  logic [14:0] narrow_trial;\n  logic [16:0] narrow_borrow;\n  logic [15:0] narrow_select;\n  logic [10:0] narrow_difference [0:15];\n  logic [10:0] narrow_remainder;\n  logic [3:0] narrow_digit;\n\n  assign narrow_multiple[1] = {4'b0, divisor_q[10:0]};\n  assign narrow_multiple[3] = three_divisor_q[14:0];\n  assign narrow_trial = {remainder_q[10:0], quotient_q[31:28]};\n  assign narrow_difference[0] = narrow_trial[10:0];\n  assign narrow_borrow[0] = 1'b0;\n  assign narrow_borrow[16] = 1'b1;\n\n  for (genvar k = 2; k <= 15; k++) begin : gen_narrow_multiple\n    if (k % 2 == 0) begin : gen_even\n      assign narrow_multiple[k] = narrow_multiple[k/2] << 1;\n    end else if (k >= 5) begin : gen_odd\n      wire [14:0] narrow_d = {4'b0, b_magnitude[10:0]};\n      always_ff @(posedge clock) begin\n        if (initializing) begin\n          case (k)\n            5:  narrow_multiple_q[k] <= (narrow_d << 2) + narrow_d;\n            7:  narrow_multiple_q[k] <= (narrow_d << 3) - narrow_d;\n            9:  narrow_multiple_q[k] <= (narrow_d << 3) + narrow_d;\n            11: narrow_multiple_q[k] <= ((narrow_d << 3) + (narrow_d << 1)) + narrow_d;\n            13: narrow_multiple_q[k] <= ((narrow_d << 4) - (narrow_d << 1)) - narrow_d;\n            15: narrow_multiple_q[k] <= (narrow_d << 4) - narrow_d;\n          endcase\n        end\n      end\n      assign narrow_multiple[k] = narrow_multiple_q[k];\n    end\n  end\n\n  for (genvar k = 1; k <= 15; k++) begin : gen_narrow_trial\n    /* verilator lint_off UNUSEDSIGNAL */\n    wire [15:0] difference = {1'b0, narrow_trial} - {1'b0, narrow_multiple[k]};\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign narrow_difference[k] = difference[10:0];\n    assign narrow_borrow[k] = difference[15];\n  end\n\n  for (genvar k = 0; k <= 15; k++) begin : gen_narrow_select\n    assign narrow_select[k] = \"'!narrow_borrow[k] && narrow_borrow[k+1];\n  end\n  assign narrow_digit = {|(narrow_select & 16'\"'hff00), |(narrow_select & 16'hf0f0),\n                         |(narrow_select & 16'hcccc), |(narrow_select & 16'haaaa)};\n  for (genvar i = 0; i < 11; i++) begin : gen_narrow_remainder\n    wire [15:0] bit_candidates;\n    for (genvar k = 0; k <= 15; k++) begin : gen_candidate\n      assign bit_candidates[k] = narrow_select[k] && narrow_difference[k][i];\n    end\n    assign narrow_remainder[i] = |bit_candidates;\n  end\n\n\\\"\\\"\\\" + src[j:]\nsrc = src.replace(\\\"step2[10:0]\\\", \\\"narrow_remainder\\\").replace(\\\"step1[12:11], step2[12:11]\\\", \\\"narrow_digit\\\")\nf.write_text(src)\n(s / \\\"timing.py\\\").write_text(\\\"\\\"\\\"import json\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build_all, summarize\n\nroot = Path.cwd()\nscratch = Path(__file__).parent\nname = sys.argv[1]\nrtl = root / 'cores/bench/rtl' if name == 'champion' else scratch / name / 'cores/bench/rtl'\noptions = tuple(map(int, sys.argv[2:])) or (0, 1, 2)\nresults = build_all(root, rtl, 'fpga/core_bench_si.sv', scratch / ('timing-' + name), options=options)\nfor r in results:\n    print(json.dumps({k: v for k, v in r.items() if k \"'!= '\"'critical_paths'}))\n    for p in r.get('critical_paths', [])[:3]:\n        print(js