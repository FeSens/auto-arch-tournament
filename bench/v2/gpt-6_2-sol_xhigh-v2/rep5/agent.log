\\", \\\".out (),\\\\n    .sum_lane (alu_sum),\\\\n    .other_lane (alu_other)\\\")\n    s = s.replace(\\\"logic [31:0] ex_result, late_operand, auipc_result;\\\", \\\"logic [31:0] ex_sum, ex_other, late_operand, auipc_result;\\\")\n    s = s.replace(\\\"\\\"\\\"assign ex_result = alu_result\n                   | ({32{in.ctrl.is_jump}} & pc_plus_4)\n                   | ({32{in.ctrl.is_auipc}} & auipc_result);\\\"\\\"\\\", \\\"\\\"\\\"assign ex_sum = alu_sum | ({32{in.ctrl.is_auipc}} & auipc_result);\n  assign ex_other = alu_other | ({32{in.ctrl.is_jump}} & pc_plus_4);\\\"\\\"\\\")\n    s = s.replace(\\\"reg_q.alu_result    <= ex_result;\\\", \\\"reg_q.alu_sum_lane   <= ex_sum;\\\\n      reg_q.alu_other_lane <= ex_other;\\\")\n    f.write_text(s)\n    f = p / \\\"core.sv\\\"\n    s = f.read_text().replace(\\\".fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\\\", \\\"\\\"\\\".fwd_ex_sum      (ex_mem_q.alu_sum_lane),\n    .fwd_ex_other    (ex_mem_q.alu_other_lane),\\\"\\\"\\\")\n    f.write_text(s)\n    f = p / \\\"mem_stage.sv\\\"\n    s = f.read_text().replace(\\\"& in.alu_result)\\\", \\\"& (in.alu_sum_lane | in.alu_other_lane))\\\")\n    f.write_text(s)\nPY\ncat > \\\"\"'$HYP_SCRATCH_PATH/timing.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"hyp-r13s1.J3do6q\\\"\nvariant = sys.argv[1]\nresults = build_all(Path.cwd(), scratch / (\\\"rtl\\\" + variant), \\\"fpga/core_bench_si.sv\\\", scratch / (\\\"timing\\\" + variant))\nfor report in results:\n    if report[\\\"placement_failed\\\"]:\n        print(report)\n    else:\n        print(report[\\\"place_option\\\"],report[\\\"fmax_mhz\\\"],report[\\\"critical_paths\\\"][:3])\nprint(summarize(results))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
