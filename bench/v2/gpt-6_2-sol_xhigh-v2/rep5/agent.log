{"type": "item.completed", "item": {"id": "item_30", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,250p' tools/eval/cosim.py; head -7 cores/bench/test/test_alu.py; ls \\\"\"'$TMPDIR/bench-predictor.35FE9v\"/*timing*.json; command -v pytest; python3 -c '\"'import cocotb; print(cocotb.__version__)'\"", "aggregated_output": "\"\"\"Runs Verilator cosim for all bench ELFs. Returns structured pass/fail.\n\nCorrectness is gated in two stages:\n  1. Full RVFI trace cosim for selftest and any other small ELF — every\n     retirement is diffed against the Python reference ISS.\n  2. CoreMark CRC validation via the sim's UART capture — full-trace cosim\n     of coremark.elf is skipped because the Python reference is ~10⁴× slower\n     than Verilator (would take 30+ minutes per candidate). Instead we run\n     the sim in --bench mode and verify its UART matches the canonical CRCs\n     with `validate_coremark_uart` (the same check run_fpga_eval uses). This\n     catches any CPU bug that affects CoreMark output without the full trace\n     overhead.\n\"\"\"\nimport os, subprocess, json, sys\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\nBENCH_DIR = Path(\"bench/programs\")\n\n\ndef _build_cosim_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `bash test/cosim/build.sh`.\n\n    Reads cores/<target>/core.yaml's `nret` (defaults to 2) and injects\n    NRET=<n> so build.sh can pass `-DNRET=<n>` to verilator. main.cpp's\n    channel-1 drain is compiled out under `#if NRET < 2`, so a single-\n    issue core (no `_1` ports) builds cleanly.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[5767 of 8839 chars elided by tools/bench/transcript.py; sha256:4adf7893f1323d30]…\nt None:\n        cm_result = run_coremark_crc(coremark, sim_bin, worktree, env)\n        if not cm_result['passed']:\n            return {\n                'passed': False,\n                'failed_elf': cm_result['elf'],\n                'detail': cm_result,\n            }\n\n    tested = len(trace_elfs) + (1 if coremark else 0)\n    return {'passed': True, 'elfs_tested': tested}\n\n\nif __name__ == '__main__':\n    result = run_cosim(\n        sys.argv[1] if len(sys.argv) > 1 else '.',\n        sys.argv[2] if len(sys.argv) > 2 else None,\n    )\n    print(json.dumps(result, indent=2))\n\"\"\"Unit tests for the combinational RV32I and multiply operations.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n/srv/hwebench/tmp/7c172beb/08a09907/bench-predictor.35FE9v/queue1-timing.json\n/srv/hwebench/tmp/7c172beb/08a09907/bench-predictor.35FE9v/queue2-timing.json\n/srv/hwebench/tmp/7c172beb/08a09907/bench-predictor.35FE9v/queue4-timing.json\n/srv/hwebench/venv/bin/pytest\n2.0.1\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-predictor.35FE9v\"\nmkdir -p \"$scratch/elf\"\nfor name in selftest random1 random2 random3; do\n  riscv32-unknown-elf-gcc -march=rv32im -mabi=ilp32 -static -nostartfiles -T bench/programs/link.ld \"bench/programs/$name.S\" -o \"$scratch/elf/$name.elf\" || exit\ndone\nPYTHONDONTWRITEBYTECODE=1 python3 - \"$scratch\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json, sys\nfrom tools.eval.cosim import TRACE_STALL_MODES, run_coremark_crc, run_one\nfrom tools.eval.fpga import validate_coremark_uart\nr = Path(sys.argv[1])\nelf = r.parent/'hyp-20261122-003-r3s2-coremark.elf'\nnames = ('queue2', 'spec2', 'spec4', 'shift2', 'shift-spec2')\nwith ThreadPoolExecutor(max_workers=8) as pool:\n    jobs = {\n        name: [pool.submit(run_one, elf, str(r/name/'cosim_sim'), '.', None, mode)\n               for elf in sorted((r/'elf').glob('*.elf')) for mode in TRACE_STALL_MODES]\n        for name in names\n    }\n    for name in names:\n        results = [job.result() for job in jobs[name]]\n        marker = json.loads((r/f'{name}-results.jsonl').read_text().splitlines()[-1])\n        failures = [item for item in results if not item['passed']]\n        assert not failures, (name, failures)\n        assert marker['ebreak'] and marker['bench_bracketed'] and not marker['oob']\n        assert validate_coremark_uart(marker['uart'], 10) == (True, None)\n        print(f'{name}: 8 trace comparisons and canonical CoreMark validation passed', flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
