:0] + 2'\"'d1;\n\n  for (genvar slot = 0; slot < 4; slot++) begin : gen_pin_check\n    wire [1:0] offset = 2'(slot) - read_ptr_q[1:0];\n    assign pin_match[slot] = \"'!recovering && {1'\"'b0, offset} < occupancy &&\n                             refs[slot].slot == {1'b0, resident_index};\n  end\n\n  assign live_slot = region_match && \"'!(|pin_match) ? {1'\"'b0, resident_index}\n                                                    : {5'b10000, write_ptr_q[1:0]};\n  assign resident_fill = accept_response && \"'!live_slot[6];\n  assign live_payload = {response.pc, response.instr, response.direct_target,\n                         response.imm, response.ctrl, response.late_eligible};\n  assign head_payload = payloads[head_ref_q.slot];\n  assign next_ref = accept_replay ? {{1'\"'b0, resident_index}, prediction_index, replay_taken, 1'b0}\n                                    : {live_slot, prediction_index, predicted_taken, hold_last_word};\n\n  always_comb begin\n    out = response;\n    if (\"'!empty) begin\n      out.pc = head_payload.pc;\n      out.instr = head_payload.instr;\n      out.direct_target = head_payload.direct_target;\n      out.imm = head_payload.imm;\n      out.ctrl = head_payload.ctrl;\n      out.late_eligible = head_payload.late_eligible;\n      out.predicted_taken = head_ref_q.pred_taken;\n      out.prediction_index = head_ref_q.pred_index;\n      out.holds_fetch = head_ref_q.holds_fetch;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (resident_fill || live_queued)\n      payloads[live_slot] <= live_payload;\n    if (accepted)\n      refs[write_ptr_q[1:0]] <= next_ref;\n\n    if (reset) begin\n      read_ptr_q <= '\"'0;\n      write_ptr_q <= '0;\n      head_ref_q <= '0;\n    end else begin\n      if (empty) begin\n        if (accepted && \"'!issue) head_ref_q <= next_ref;\n      end else if (issue) begin\n        head_ref_q <= occupancy == 3'\"'d1 && accepted ? next_ref : refs[next_head_row];\n      end\n\n      if (recovering) read_ptr_q <= write_ptr_q + {2'b0, issue};\n      else if (issue) read_ptr_q <= read_ptr_q + 3'd1;\n      if (accepted) write_ptr_q <= write_ptr_q + 3'd1;\n    end\n  end\n\n  // Resident tags and successor metadata have a separate narrow read path.\n  residency_t fill_meta, replay_meta;\n  logic candidate_hit [0:1];\n  residency_t candidate_meta [0:1];\n  logic look_same_q, look_next_q, replay_hit;\n  logic [31:2] next_word;\n  logic descriptor_valid_q, observed_q, fence_accept, fence_block;\n  logic [31:0] observed_pc_q, observed_target_q;\n  logic [19:2] loop_head_q, loop_tail_q;\n  logic [2:0] fence_count_q, effective_fences;\n  logic [31:0] observed_span;\n\n  assign next_word = pc_word + 30'd1;\n  assign replay_meta = pc_word[2] ? candidate_meta[1] : candidate_meta[0];\n  assign replay_hit = (look_same_q || look_next_q) &&\n                      (pc_word[2] ? candidate_hit[1] : candidate_hit[0]);\n  assign accept_replay = \"'!reset && !imem_ready && !recovering && !full &&\n                         !aperture_wait_q && !fence_block && replay_hit;\n  assign replay_taken = replay_meta.is_jal || (replay_meta.is_branch && counter_taken);\n  assign choose_replay_target = accept_replay && replay_taken;\n  assign fence_accept = accept_response && imem_data[6:0] == 7'\"'h0f && imem_data[14:12] == 3'd1;\n  assign effective_fences = recovering ? 3'd0 : fence_count_q;\n  assign fence_block = |effective_fences;\n  assign observed_span = observed_pc_q - observed_target_q;\n  assign region_match = descriptor_valid_q && \"'!fence_block && pc_word[31:20] == 12'\"'d0 &&\n                        pc_word[19:2] >= loop_head_q && pc_word[19:2] <= loop_tail_q;\n  assign fill_meta = {pc_word[19:8],\n                      pc_word \"'!= LAST_IMEM_WORD &&\n                        !(imem_data[6:0] == 7'\"'h67) &&\n                        (\"'!(is_branch || is_jal) || (!direct_bit1 && direct_in_range)),\n                      is_jal, is_branch, direct_word[19:2]};\n\n  always_ff @(posedge clock) beg