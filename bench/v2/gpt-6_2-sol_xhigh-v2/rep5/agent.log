{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,280p' cores/bench/test/test_divider.py && sed -n '1,260p' cores/bench/test/test_reg_file.py\"", "aggregated_output": "\"\"\"RV32M divider arithmetic, fixed latency, and result handshake.\"\"\"\n\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.launch.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIVU\n    dut.a.value = 0\n    dut.b.value = 0\n    await _edge(dut)\n    assert dut.idle.value == 1\n    assert dut.handoff_ready.value == 0\n    dut.reset.value = 0\n\n\nasync def _launch(dut, op, a, b):\n    assert dut.idle.value == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.launch.value = 1\n    await _edge(dut)\n    dut.launch.value = 0\n    # Model forwarding sources changing before the initialization edge.\n    dut.op.value = ALU_DIV if op in (ALU_REM, ALU_REMU) else ALU_REMU\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n    assert dut.idle.value == 0\n    assert dut.handoff_ready.value == 0\n\n\nasync def _reach_final_work_edge(dut):\n    # After launch, one initialization and six work edges precede handoff.\n    for cycle in range(1, 8):\n        await _edge(dut)\n        assert dut.idle.value == 0\n        assert dut.handoff_ready.value == (cycle == 7), f\"edge {cycle} after launch\"\n\n\nasync def _accept(dut):\n    dut.accept.value = 1\n    await _edge(dut)\n    dut.accept.value = 0\n    assert dut.idle.value == 1\n    assert dut.handoff_ready.value == 0\n\n\nasync def _check(dut, op, a, b, expected):\n    await _launch(dut, op, a, b)\n    await _reach_final_work_edge(dut)\n    # Accept on edge nine, the seventh work edge. The result is then usable in MEM.\n    await _accept(dut)\n    actual = int(dut.result.value)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a={a & MASK32:#010x} b={b & MASK32:#010x} \"\n        f\"expected={expected & MASK32:#010x} got={actual:#010x}\"\n    )\n\n\ndef _expected(op, a\n…[5565 of 8637 chars elided by tools/bench/transcript.py; sha256:8b7f4052f5e9eb6d]…\n 0xCAFEBABE)\n    await Timer(1, \"ns\")\n    rs1, _ = await _read(dut, 0, 0)\n    assert rs1 == 0\n\n\n@cocotb.test()\nasync def write_first_bypass(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    # Combinational read of an addr that is being written this cycle:\n    # bypass returns the new write data.\n    dut.rs1_addr.value = 7\n    dut.w_en.value     = 1\n    dut.w_addr.value   = 7\n    dut.w_data.value   = 0x12345678\n    await Timer(1, \"ns\")\n    assert int(dut.rs1_data.value) == 0x12345678\n    dut.w_en.value = 0\n\n\n@cocotb.test()\nasync def two_read_ports(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n    await _write(dut, 1, 0xAAAAAAAA)\n    await _write(dut, 2, 0xBBBBBBBB)\n    await Timer(1, \"ns\")\n    rs1, rs2 = await _read(dut, 1, 2)\n    assert rs1 == 0xAAAAAAAA\n    assert rs2 == 0xBBBBBBBB\n\n\ndef test_reg_file_runner():\n    run_cocotb(toplevel=\"reg_file\",\n               sources=[\"reg_file.sv\"],\n               test_module=\"test_reg_file\")\n", "exit_code": 0, "status": "completed"}}
