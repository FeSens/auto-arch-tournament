iply_launch = is_multiply && \"'!multiply_ready && !stall;\n  assign multiply_accept = is_multiply && multiply_ready && !stall;\n  assign multiply_wait   = is_multiply && !multiply_ready;\n  assign ex_wait         = multiply_wait || divide_wait;\n\n  multiplier u_multiplier (\n    .clock        (clock),\n    .reset        (reset),\n    .launch       (multiply_launch),\n    .accept       (multiply_accept),\n    .op           (in.ctrl.alu_op),\n    .a            (rs1),\n    .b            (rs2),\n    .result_valid (multiply_ready),\n    .result       (multiply_result)\n  );\n\n  // The forwarding sources can drain while EX holds ID/EX.'\"'''),\n    ('''      divide_rs1_q <= '0;\n      divide_rs2_q <= '0;\n    end else if (divide_launch) begin\n      divide_rs1_q <= rs1;\n      divide_rs2_q <= rs2;''',\n     '''      ext_rs1_q <= '0;\n      ext_rs2_q <= '0;\n    end else if (divide_launch || multiply_launch) begin\n      ext_rs1_q <= rs1;\n      ext_rs2_q <= rs2;'''),\n    ('assign advance        = in.valid && \"'!stall && !divide_wait;'\"', 'assign advance        = in.valid && \"'!stall && !ex_wait;'\"'),\n    ('| ({32{\"'!(in.ctrl.is_jump || is_divide)}} & alu_result);'\"',\n     '''| ({32{is_multiply}} & multiply_result)\n                   | ({32{\"'!(in.ctrl.is_jump || is_divide || is_multiply)}} & alu_result);'\"'''),\n    ('end else if (divide_wait) begin', 'end else if (ex_wait) begin'),\n    ('is_divide ? divide_rs1_q : rs1;', '(is_divide || is_multiply) ? ext_rs1_q : rs1;'),\n    ('is_divide ? divide_rs2_q : rs2;', '(is_divide || is_multiply) ? ext_rs2_q : rs2;'),\n])\n\nfor name in ('core.sv', 'hazard_unit.sv'):\n    path = rtl / name\n    path.write_text(path.read_text().replace('divide_wait', 'ex_wait'))\nPY\ncat > \\\"\"'$BENCH_MUL_SCRATCH/rtl/multiplier.sv\" <<'\"'SV'\nmodule multiplier (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        launch,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31: