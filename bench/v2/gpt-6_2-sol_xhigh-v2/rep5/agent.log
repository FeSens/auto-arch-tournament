{"type": "item.started", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/raw_variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\nfor name in ['raw_add', 'raw_add_both', 'raw_add_free']:\n    p = scratch / name\n    shutil.copytree(base, p)\n    both = name.endswith('both')\n    free = name.endswith('free')\n    s = (p/'core_pkg.sv').read_text().replace('logic alu, load,', 'logic alu, add, sub, load,').replace('    logic ex_mem;', '    logic ex_mem, ex_add, ex_sub;')\n    s = s.replace('    logic [31:0] alu_result;', '    logic [31:0] alu_result, add_result, sub_result;')\n    (p/'core_pkg.sv').write_text(s)\n    s = (p/'core.sv').read_text().replace('    .fwd_ex_mem      (ex_mem_w.alu_result),', '    .fwd_ex_add      (ex_mem_w.add_result),\\\\n    .fwd_ex_sub      (ex_mem_w.sub_result),\\\\n    .fwd_ex_mem      (ex_mem_w.alu_result),')\n    s = s.replace('    .ex_fast_write (ex_fast_write),', \\\"    .ex_fast_write (ex_fast_write),\\\\n    .ex_add        (id_ex_w.alu_select.add),\\\\n    .ex_sub        (\\\" + ('id_ex_w.alu_select.sub' if both else \\\"1'b0\\\") + \\\"),\\\")\n    (p/'core.sv').write_text(s)\n    s = (p/'forward_unit.sv').read_text().replace('  input  logic       ex_fast_write,', '  input  logic       ex_fast_write,\\\\n  input  logic       ex_add, ex_sub,')\n    s = s.replace('    sel.ex_mem   = ex_match;', '    sel.ex_mem   = ex_match && \"'!ex_add && !ex_sub;'\"\\\\n    sel.ex_add   = ex_match && ex_add;\\\\n    sel.ex_sub   = ex_match && ex_sub;')\n    (p/'forward_unit.sv').write_text(s)\n    s = (p/'ex_stage.sv').read_text().replace('  input  logic [31:0]        fwd_ex_mem,', '  input  logic [31:0]        fwd_ex_add, fwd_ex_sub,\\\\n  input  logic [31:0]        fwd_ex_mem,')\n    for r in ('rs1','rs2'):\n        s = s.replace(f'  assign {r} =', f\\\"  assign {r} = ({{32{{in.{r}_