{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$TMPDIR/bench-predictor.35FE9v\"\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot = Path(sys.argv[1])\nharness = Path('test/cosim/main.cpp').read_text()\nharness = harness.replace('#include \\\"Vcore.h\\\"', '#include \\\"Vcore.h\\\"\\\\n#include \\\"Vcore___024root.h\\\"')\nharness = harness.replace('bool hit_ebreak = false;', 'bool hit_ebreak = false;\\\\n    uint64_t redirects = 0, misses = 0, branches = 0, jalrs = 0, loadwait = 0, dwait = 0, iwait = 0;\\\\n    FILE* records = fopen(argv[argc-1], \\\"wb\\\");')\nharness = harness.replace('        top->clock = 1; top->eval();', '''        if (bench_start_set && \"'!bench_stop_set) {\n            auto* root = top->rootp;\n            auto redirect = root->core__DOT__redirect;\n            auto branch = root->core__DOT__train_branch;\n            redirects += redirect;\n            branches += branch;\n            misses += redirect && branch;\n            jalrs += redirect && !branch;\n            dwait += (top->io_dmemWEn || top->io_dmemREn) && !top->io_dmemReady;\n            loadwait += root->core__DOT__stall_id && top->io_dmemReady;\n            iwait += !root->core__DOT__stall_id && !top->io_imemReady;\n        }\n        top->clock = 1; top->eval();\n        if (bench_start_set && !bench_stop_set && top->io_rvfi_valid_0) {\n            const uint32_t rec[] = {top->io_rvfi_pc_rdata_0, top->io_rvfi_insn_0, top->io_rvfi_pc_wdata_0};\n            fwrite(rec, sizeof(rec), 1, records);\n        }'\"''')\nharness = harness.replace('    delete top;', '''    fclose(records);\n    std::cerr << \\\"Redirects \\\" << redirects << \\\" branch-misses \\\" << misses\n              << \\\" conditional-branches \\\" << branches << \\\" other-redirects \\\" << jalrs\n              << \\\" iwait \\\" << iwait << \\\" dwait \\\" << dwait << \\\" loadwait \\\" << loadwait << \\\"\\\\\\\\