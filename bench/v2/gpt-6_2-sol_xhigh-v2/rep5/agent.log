{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_pipeline.py')\ns=p.read_text()\ntests='''@cocotb.test()\nasync def fetch_queue_fills_and_drains_in_order(dut):\n    \\\"\\\"\\\"Fill all four entries behind a held store and drain during imem stalls.\\\"\\\"\\\"\n    program = [SW(0, 0, 0x40)] + [ADDI(1, 1, 1)] * 7\n    program += [SW(1, 0, 0x44)] + [ADDI(1, 1, 1)] * 7 + [SW(1, 0, 0x48), EBREAK()]\n    requests = {0x40: 0, 0x44: 0, 0x48: 0}\n    fetches = []\n    stalled_response_cycles = 0\n\n    def dmem_ready(addr, ren, wen):\n        if not wen:\n            return True\n        requests[addr] += 1\n        return requests[addr] >= (7 if addr in (0x40, 0x44) else 1)\n\n    def imem_ready(addr):\n        nonlocal stalled_response_cycles\n        fetches.append(addr)\n        if addr == 0x18 and requests[0x40] >= 7 and stalled_response_cycles < 3:\n            stalled_response_cycles += 1\n            return False\n        return True\n\n    rets, dmem = await _run(dut, program, dmem_ready=dmem_ready, imem_ready=imem_ready)\n    assert fetches[:8] == [4, 8, 12, 16, 20, 24, 24, 24]\n    assert stalled_response_cycles == 3\n    assert requests == {0x40: 7, 0x44: 7, 0x48: 1}\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert rets[5][\\\"cycle\\\"] - rets[1][\\\"cycle\\\"] == 4\n    assert dmem == {0x40: 0, 0x44: 7, 0x48: 14}\n\n\n@cocotb.test()\nasync def stalled_jalr_recovery_discards_queue_at_aperture(dut):\n    \\\"\\\"\\\"Discard a queued store and divide and recover through the last imem word.\\\"\\\"\\\"\n    program = {\n        0x000: LUI(1, 0x100),\n        0x004: ADDI(1, 1, -4),\n        0x008: SW(1, 0, 0x40),\n        0x00C: JALR(0, 1, 0),\n        0x010: SW(1, 0, 0x44),\n        0x014: DIVU(2, 1, 1),\n        0xFFFFC: BEQ(0, 0, -8),\n        0xFFFF4: EBREAK(),\n    }\n    requests, fetches = [], []\n\n    def dmem_ready(addr, ren, wen):\n        if ren or wen:\n            requests.append((addr, ren, wen))\n        return len(requests) >= 6\n\n    def imem_ready(addr):\n        fetches.append(addr)\n        return addr \"'!= 0xFFFFC or fetches.count(addr) > 1\n\n    rets, dmem = await _run(dut, program, dmem_ready=dmem_ready, imem_ready=imem_ready)\n    assert all(addr < 0x100000 for addr in fetches)\n    assert fetches.count(0xFFFFC) >= 2\n    assert {0x010, 0x014}.issubset(fetches)\n    assert requests == [(0x40, 0, 0xF)] * 6\n    assert dmem == {0x40: 0xFFFFC}\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 0xFFFFC, 0xFFFF4]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert rets[-2][\"cycle\"] - rets[-3][\"cycle\"] == 3\n    assert rets[-1][\"cycle\"] - rets[-2][\"cycle\"] == 2\n\n\n'\"'''\nindex=s.index('def test_pipeline_runner():')\ns=s[:index]+tests+s[index:]\np.write_text(s)\nPY\npytest -q cores/bench/test/test_pipeline.py > scratch-pytest-directed.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
