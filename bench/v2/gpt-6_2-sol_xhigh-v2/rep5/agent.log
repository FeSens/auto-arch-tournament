{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nfrom shutil import copytree\nbase = Path(os.environ['TMPDIR'])\nfor v in ['divider-nibble','divider-two']:\n    dest = base/v\n    copytree('fpga',dest/'fpga',dirs_exist_ok=True)\n    copytree('cores/bench/rtl',dest/'cores/bench/rtl',dirs_exist_ok=True)\n    (dest/'cores/bench/core.yaml').write_bytes(Path('cores/bench/core.yaml').read_bytes())\n\ns0 = (base/'divider-hypothesis/cores/bench/rtl/divider.sv').read_text()\ntable = (base/'divider-table/cores/bench/rtl/divider.sv').read_text()\nfor variant,width in [('divider-nibble',4),('divider-two',2)]:\n    s=s0\n    a=s.index('  logic [31:0] a_q, b_q;')\n    b=s.index('  logic signed_op',a)\n    s=s[:a]+'''  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n  logic initialize;\n  assign initialize = phase_q == 4'd8;\n\n'''+s[b:]\n    a=s.index('  // Take one radix-4 digit.')\n    b=s.index('  logic [3:0] prefix2;')\n    if width==4:\n        table_func=table[table.index('  function automatic [7:0] prefix_nibble'):table.index('  function automatic [7:0] prefix_step6')]\n        # Case decode the nibble table directly. Signed magnitude early\n        # flags are based on raw upper bits, and no wide add lies on the\n        # leading-nibble path.\n        s=s[:b]+table_func+s[b:]\n    end=s.index('  // Take one radix-4 digit.')\n    s=s[:end]+'''  logic sign_a_early, sign_b_early;\n  logic [WIDTH-1:0] dividend_prefix, divisor_prefix;\n  logic divisor_prefix_valid;\n  logic [2*WIDTH-1:0] prefix_launch, prefix_saved;\n  assign sign_a_early = (op == ALU_DIV || op == ALU_REM) && a[31];\n  assign sign_b_early = (op == ALU_DIV || op == ALU_REM) && b[31];\n  assign dividend_prefix = sign_a_early ? ~a[31:LO] + WIDTH'(a[LO-1:0] == '0) : a[31:LO];\n  assign divisor_prefix  = sign_b_early ? -b[WIDTH-1:0] : b[WIDTH-1:0];\n  assign divisor_prefix_valid = sign_b_early ? (&b[31:WIDTH] && |b[WIDTH-1:0]) : \"'!(|b[31:WIDTH]);\n  assign prefix_launch = divisor_prefix_valid ? CALC : {WIDTH'\"'b0, dividend_prefix};\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      a_q          <= '0;\n      b_q          <= '0;\n      op_q         <= '0;\n      prefix_saved <= '0;\n    end else if (starting) begin\n      a_q          <= a;\n      b_q          <= b;\n      op_q         <= op;\n      prefix_saved <= prefix_launch;\n    end\n  end\n\n'''.replace('LO',str(32-width)).replace('WIDTH',str(width)).replace('CALC',\n'prefix_nibble(dividend_prefix, {4\\\\'b0, divisor_prefix})' if width==4 else \\\"prefix_step2(dividend_prefix, {6'b0, divisor_prefix}, {8'b0, divisor_prefix} + {7'b0, divisor_prefix, 1'b0})\\\")+s[end:]\n    # Fold the registered EX prefix into the narrow first-work calculation.\n    if width==4:\n        start=s.index('  logic [3:0] prefix2;')\n        end=s.index('  assign prefix6',start)\n        s=s[:start]+'''  logic [7:0] prefix6;\n  logic [9:0] prefix8;\n'''+s[end:]\n        s=s.replace('prefix4[3:0]', 'prefix_saved[3:0]').replace('prefix2[3:2], prefix4[5:4]', 'prefix_saved[7:4]')\n    else:\n        s=s.replace('  logic [3:0] prefix2;\\\\n','')\n        s=s.replace('  assign prefix2 = prefix_step2(a_mag_hi[7:6], b_mag_byte, three_byte);\\\\n','')\n        s=s.replace('prefix2[1:0]', 'prefix_saved[1:0]').replace('prefix2[3:2]', 'prefix_saved[3:2]')\n    (base/variant/'cores/bench/rtl/divider.sv').write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
