{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,150p' cores/bench/rtl/divider.sv && sed -n '195,280p' cores/bench/rtl/divider.sv && sed -n '1,300p' cores/bench/test/test_divider.py\"", "aggregated_output": "// Shared blocking RV32M divider. Launch captures the operands, then\n// initialization consumes a prefix of the dividend. Seven work edges\n// follow. EX can hand off on the last work edge, which registers the\n// final state used for the MEM result.\nmodule divider (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        launch,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        idle,\n  output logic        handoff_ready,\n  output logic [31:0] result\n);\n\n  // 0 = idle, 9 = initialize, 8..2 = seven work cycles, 1 = result pending.\n  logic [3:0] phase_q;\n  logic starting, initializing, counting_down;\n  logic [31:0] a_q, b_q;\n\n  assign idle          = phase_q == 4'd0;\n  assign handoff_ready = phase_q == 4'd2 || phase_q == 4'd1;\n  assign starting      = idle && launch;\n  assign initializing  = phase_q == 4'd9;\n  assign counting_down = |phase_q[3:1];\n\n  always_ff @(posedge clock) begin\n    if (reset)                       phase_q <= 4'd0;\n    else if (starting)               phase_q <= 4'd9;\n    else if (handoff_ready && accept) phase_q <= 4'd0;\n    else if (counting_down)           phase_q <= phase_q - 4'd1;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      a_q <= '0;\n      b_q <= '0;\n    end else if (starting) begin\n      a_q <= a;\n      b_q <= b;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [4:0] op_q;\n  logic [31:0] alt_mask;\n\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  alt_mask = 32'h7f8529ec;\n      ALU_DIVU: alt_mask = 32'h10e8fd70;\n      ALU_REM:  alt_mask = 32'h8da68fa5;\n      ALU_REMU: alt_mask = 32'h3138d0e1;\n      default:  alt_mask = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      op_q   <= '0;\n      result <= '0;\n    end else if (starting) begin\n      op_q <= op;\n    end else if (initializing) begin\n      result <= (a_q - b_q) ^ alt_mask;\n    end\n  end\n`else\n  logic signed_op, a_negative_q, b_negative_q;\n  logic [31:0] a_magnitude, b_magnit\n…[13856 of 16928 chars elided by tools/bench/transcript.py; sha256:c6a4555f88a00618]…\n == 1\n            assert int(dut.result.value) == expected\n        await _accept(dut)\n        assert int(dut.result.value) == expected\n    await _check(dut, ALU_REMU, 17, 5, 2)\n\n\n@cocotb.test()\nasync def reset_discards_in_flight_and_pending_results(dut):\n    await _reset(dut)\n    # Reset once before initialization and once during the recurrence.\n    for edges_after_launch in (0, 2):\n        await _launch(dut, ALU_REM, -61, 3)\n        for _ in range(edges_after_launch):\n            await _edge(dut)\n        await _reset(dut)\n        for _ in range(9):\n            await _edge(dut)\n            assert dut.idle.value == 1\n            assert dut.handoff_ready.value == 0\n\n    await _launch(dut, ALU_DIVU, 101, 7)\n    await _reach_final_work_edge(dut)\n    await _edge(dut)\n    assert dut.handoff_ready.value == 1\n    await _reset(dut)\n    await _check(dut, ALU_DIV, -19, 2, -9)\n\n\ndef test_divider_runner():\n    run_cocotb(toplevel=\"divider\", sources=[\"core_pkg.sv\", \"divider.sv\"],\n               test_module=\"test_divider\")\n", "exit_code": 0, "status": "completed"}}
