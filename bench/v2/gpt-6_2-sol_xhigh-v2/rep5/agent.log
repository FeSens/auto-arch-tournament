{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c 'du -shL formal/riscv-formal && du -sh formal/riscv-formal/checks formal/riscv-formal/insns && cat formal/checks_si.cfg && ls formal/riscv-formal'","aggregated_output":"522M\tformal/riscv-formal\n996K\tformal/riscv-formal/checks\n4.5M\tformal/riscv-formal/insns\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\nCOPYING\nCodeOfConduct\nREADME.md\nbus\nchecks\ncores\ndocs\ninsns\nmonitor\ntests\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -c 'export PYTHONDONTWRITEBYTECODE=1\nstudy=\"$TMPDIR/fetch-target-study\"\npython - \"$study\" <<'\"'PY'\nfrom pathlib import Path\nimport sys,shutil\nroot=Path(sys.argv[1])\nsource=Path('formal/riscv-formal').resolve()\nformal=root/'proof'\nformal.mkdir()\nfor name in ('checks','insns','bus'):\n (formal/name).symlink_to(source/name,target_is_directory=True)\nstage=formal/'cores'/'branch-compare'\nstage.mkdir(parents=True)\nfor p in (root/'branch_compare'/'cores/bench/rtl').glob('*.sv'):\n shutil.copyfile(p,stage/p.name)\nshutil.copyfile('formal/wrapper_si.sv',stage/'wrapper.sv')\ncfg=Path('formal/checks_si.cfg').read_text().split('[verilog-files]')[0]\nfiles=['core_pkg.sv']+sorted(p.name for p in stage.glob('*.sv') if p.name not in ('core_pkg.sv','wrapper.sv'))+['wrapper.sv']\n(stage/'checks.cfg').write_text(cfg+'[verilog-files]\\\\n'+''.join('@basedir@/cores/@core@/'+file+'\\\\n' for file in files))\nPY\ncd \\\"\"'$study/proof/cores/branch-compare\" && python3 ../../checks/genchecks.py && cd checks && make -f makefile -j 2 liveness_ch0 insn_blt_ch0 > \"$study/branch_compare.formal\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
