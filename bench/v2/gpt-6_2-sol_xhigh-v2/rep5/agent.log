.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\"\n…[2383 of 5455 chars elided by tools/bench/transcript.py; sha256:ae880fbf8c8ee58f]…\nd.]+\\(MHz\\)\\s+([\\d.]+)\\(MHz\\)\\s+(\\d+)\", re.M)\n\ntotal 116\ndrwxrwx---+  8 nobody   nogroup   4096 Nov 22 17:48 .\ndrwxrwx---+  5 nobody   nogroup   4096 Nov 22 17:40 ..\ndr-xr-xr-x   2 hwebench hwebench    40 Nov 22 17:48 .agents\ndr-xr-xr-x   2 hwebench hwebench    40 Nov 22 17:48 .aws\ndr-xr-xr-x   2 hwebench hwebench    40 Nov 22 17:48 .codex\ndr-xr-xr-x   2 hwebench hwebench    40 Nov 22 17:48 .git\nprw-------+  1 hwebench hwebench     0 Nov 22 17:46 GMfifo42\ndrwx------+  4 hwebench hwebench  4096 Nov 22 17:48 bench-replay-baseline.fzq5j7\n-rw-rw----+  1 hwebench hwebench  5018 Nov 22 17:44 bench-replay-cosim.log\n-rw-rw----+  1 hwebench hwebench 65765 Nov 22 17:46 bench-replay-formal.log\n-rw-rw----+  1 hwebench hwebench   109 Nov 22 17:47 bench-replay-tests.log\n-rw-rw----+  1 hwebench hwebench     0 Nov 22 17:45 bench-replay-timing-all-initial.log\n-rw-rw----+  1 hwebench hwebench  1025 Nov 22 17:45 bench-replay-timing.log\ndrwxrwx---+ 12 hwebench hwebench  4096 Nov 22 17:43 codex-bwrap-synthetic-mount-targets-1001\n", "exit_code": 0, "status": "completed"}}
