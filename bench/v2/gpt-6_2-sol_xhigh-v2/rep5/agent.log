{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(os.environ['TMPDIR']) / 'r4s2-predictor'\nbase = scratch / 'cores/bench/rtl'\nvariants = {\n    'free4': (4, False, False),\n    'free2-clear': (2, True, False),\n    'free4-clear': (4, True, False),\n    'free4-nop': (4, False, True),\n}\nfor name, (depth, valid_clear, nop) in variants.items():\n    rtl = scratch / name / 'rtl'\n    shutil.copytree(base, rtl, dirs_exist_ok=True)\n    path = rtl / 'if_stage.sv'\n    source = path.read_text()\n    source = source.replace('localparam int QUEUE_BITS = 2;', f'localparam int QUEUE_BITS = {depth.bit_length() - 1};')\n    source = source.replace('  if_id_t queue [0:(1 << QUEUE_BITS)-1];\\\\n  if_id_t fetch_packet;', '''  if_id_t fetch_packet;\n  logic [\"'$bits(fetch_packet)-1:0] queue [0:(1 << QUEUE_BITS)-1];'\"''')\n    source = source.replace('  assign push = fetch_packet.valid && \"'!last_word && !bypass && (!full || pop);'\"\\\\n  assign accept_response = bypass || push;', '''  assign accept_response = fetch_packet.valid && (last_word ? (empty && \"'!stall) : !full);\n  assign push = accept_response && !bypass;'\"''')\n    source = source.replace('if (push && \"'!redirect && !reset)'\"', 'if (\"'!full)'\"')\n    if nop:\n        source = source.replace('fetch_packet.instr            = imem_data;', \\\"fetch_packet.instr            = imem_ready ? imem_data : 32'h0000_0013;\\\")\n    path.write_text(source)\n    if valid_clear:\n        path = rtl / 'id_stage.sv'\n        source = path.read_text().replace(\n            \\\"    if (reset || flush) begin\\\\n      reg_q <= '0;\\\\n    end else if (\"'!stall) begin\",\n            '\"'''    if (reset || flush)\n      reg_q.valid <= 1'b0;\n    else if (\"'!stall)\n      reg_q.valid <= in.valid;\n\n    if (!stall) begin'\"''')\n        path.write_text(source.replace('      reg_q.valid        