{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"sed -n '475,620p' cores/bench/test/test_pipeline.py; cat /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep5/formal/riscv-formal/checks/rvfi_liveness_check.sv\"", "aggregated_output": "    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\n@cocotb.test()\nasync def divide_waits_for_stalled_store(dut):\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),          # MEM/WB forward must survive the store stall.\n        SW(2, 0, 0x40),\n        DIVU(3, 1, 2),\n        ADDI(4, 3, 1),          # Immediate consumer forwards the quotient.\n        SW(4, 0, 0x44),\n        EBREAK(),\n    ]\n    requests = []\n\n    def ready(addr, ren, wen):\n        if not (ren or wen):\n            return True\n        requests.append((addr, ren, wen, int(dut.io_dmemWData.value)))\n        return len(requests) > 3\n\n    rets, dmem = await _run(dut, program, dmem_ready=ready)\n    assert requests == [(0x40, 0, 0xF, 7)] * 4 + [(0x44, 0, 0xF, 15)]\n    assert dmem == {0x40: 7, 0x44: 15}\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n\n    older, div, consumer, younger = rets[2:6]\n    assert div[\"cycle\"] - older[\"cycle\"] == 8\n    assert consumer[\"cycle\"] - div[\"cycle\"] == 2\n    assert (div[\"rs1_addr\"], div[\"rs1_rdata\"]) == (1, 100)\n    assert (div[\"rs2_addr\"], div[\"rs2_rdata\"]) == (2, 7)\n    assert (div[\"rd\"], div[\"rd_wdata\"], div[\"trap\"]) == (3, 14, 0)\n    assert (div[\"mem_rmask\"], div[\"mem_wmask\"], div[\"pc_next\"]) == (0, 0, 16)\n    assert (consumer[\"rs1_rdata\"], consumer[\"rd_wdata\"]) == (14, 15)\n    assert (older[\"mem_addr\"], older[\"mem_wmask\"], older[\"mem_wdata\"]) == (0x40, 0xF, 7)\n    assert (younger[\"mem_addr\"], younger[\"mem_wmask\"], younger[\"mem_wdata\"]) == (0x44, 0xF, 15)\n\n\n@cocotb.test()\n@cocotb.parametrize(predict_jal=[False, True], wrong_path=[MUL, DIVU])\nasync def divide_after_load_use_and_transfer(dut, predict_jal, wrong_path):\n    program = [\n        ADDI(1, 0, 7),\n        LW(2, 0, 0x40),\n        DIVU(3, 2, 1),\n        REMU(4, 3, 1),\n        ADD(5, 3, 4),\n        JAL(0, 8) if predict_jal else BEQ(0, 0, 8),\n\n…[3843 of 6915 chars elided by tools/bench/transcript.py; sha256:30155d08ade8b53f]…\n OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n// WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN\n// ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\nmodule rvfi_liveness_check (\n\tinput clock, reset, trig, check,\n\t`RVFI_INPUTS\n);\n\t`rvformal_rand_const_reg [63:0] insn_order;\n\treg found_next_insn = 0;\n\n\tinteger channel_idx;\n\talways @(posedge clock) begin\n\t\tif (reset) begin\n\t\t\tfound_next_insn = 0;\n\t\tend else begin\n\t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n", "exit_code": 0, "status": "completed"}}
