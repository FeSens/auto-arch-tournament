{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(os.environ['TMPDIR']) / 'r4s2-predictor'\nfor name, parent in [('compact4','free4'), ('compact4-clear','free4-clear'), ('compact4-nop','free4-nop')]:\n    rtl = scratch / name / 'rtl'\n    shutil.copytree(scratch / parent / 'rtl', rtl, dirs_exist_ok=True)\n    path = rtl / 'if_stage.sv'\n    source = path.read_text()\n    source = source.replace('  logic [\"'$bits(fetch_packet)-1:0] queue [0:(1 << QUEUE_BITS)-1];'\"', '''  typedef struct packed {\n    logic [17:0] pc_word;\n    logic [19:0] target_word;\n    logic        target_bit1;\n    logic [31:0] instr;\n    logic        predicted_taken;\n    logic [1:0]  index_low;\n  } fetch_entry_t;\n\n  fetch_entry_t tail_packet, head_packet;\n  if_id_t queued_packet;\n  logic [\"'$bits(tail_packet)-1:0] queue [0:(1 << QUEUE_BITS)-1];'\"''')\n    source = source.replace('logic last_word, boundary_pending_q;', 'logic last_word, queueable, boundary_pending_q;')\n    source = source.replace('  assign last_word = pc_word == APERTURE_LAST_WORD;', '''  assign last_word = pc_word == APERTURE_LAST_WORD;\n  assign queueable = (pc_word[31:20] == 0) && \"'!last_word;'\"''')\n    source = source.replace('last_word ? (empty && \"'!stall) : !full'\"', 'queueable ? \"'!full : (empty && !stall)'\"')\n    source = source.replace('queue[write_ptr_q[QUEUE_BITS-1:0]] <= fetch_packet;', 'queue[write_ptr_q[QUEUE_BITS-1:0]] <= tail_packet;')\n    source = source.replace('  assign out = empty ? fetch_packet : queue[read_ptr_q[QUEUE_BITS-1:0]];', '''  assign tail_packet.pc_word         = pc_word[19:2];\n  assign tail_packet.target_word     = direct_word[21:2];\n  assign tail_packet.target_bit1     = direct_bit1;\n  assign tail_packet.instr           = imem_data;\n  assign tail_packet.predicted_taken = predicted_taken;\n  assign tail_packet.index_low       = prediction_index[1:0];\n\n  assign head_packet = queue[read_ptr_q[QUEUE_BITS-1:0]];\n  assign queued_packet.pc = {12'b0, head_packet.pc_word, 2'b00};\n  assign queued_packet.direct_target = {{10{head_packet.target_word[19]}},\n                                        head_packet.target_word, head_packet.target_bit1, 1'b0};\n  assign queued_packet.instr = head_packet.instr;\n  assign queued_packet.predicted_taken = head_packet.predicted_taken;\n  assign queued_packet.prediction_index = {head_packet.pc_word[5:2], head_packet.index_low};\n  assign queued_packet.valid = 1'b1;\n  assign out = empty ? fetch_packet : queued_packet;''')\n    path.write_text(source)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
