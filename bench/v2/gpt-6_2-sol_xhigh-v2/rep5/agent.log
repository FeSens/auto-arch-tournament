{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport itertools\nimport random\n\nmask = (1 << 32) - 1\nborrow = 1 << 34\nwide_mask = (1 << 35) - 1\n\ndef run(dividend, divisor, signed):\n    if divisor == 0:\n        return mask, dividend\n\n    a_neg = signed and bool(dividend >> 31)\n    b_neg = signed and bool(divisor >> 31)\n    a = (-dividend & mask) if a_neg else dividend\n    d = (-divisor & mask) if b_neg else divisor\n    multiples = 0, d, 2 * d, 3 * d\n    quotient = remainder = 0\n    for group in range(4):\n        for digit_index in reversed(range(16 - 4 * (group + 1), 16 - 4 * group)):\n            trial = (remainder << 2) | ((a >> (2 * digit_index)) & 3)\n            differences = [(trial - m) & wide_mask for m in multiples]\n            digit = max(i for i, diff in enumerate(differences) if not diff & borrow)\n            remainder = differences[digit]\n            assert remainder < d\n            quotient = (quotient << 2) | digit\n    return ((-quotient if a_neg \"'!= b_neg else quotient) & mask,\n            (-remainder if a_neg else remainder) & mask)\n\ndef reference(a, b, signed):\n    if not b:\n        return mask, a\n    as_int = lambda x: x - (1 << 32) if signed and x >> 31 else x\n    a, b = as_int(a), as_int(b)\n    q = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        q = -q\n    return q & mask, (a - q * b) & mask\n\nedge = (0, 1, 2, 3, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, 0xffffffff)\nrng = random.Random(20261122)\npairs = list(itertools.product(edge, repeat=2))\npairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000))\nfor a, b in pairs:\n    for signed in (False, True):\n        assert run(a, b, signed) == reference(a, b, signed), (a, b, signed)\nprint(f'\"'Radix-4 recurrence matched quotient and remainder for {2 * len(pairs):,} signed and unsigned cases.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
