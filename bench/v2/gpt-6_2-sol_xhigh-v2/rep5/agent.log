{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '76,175p;278,405p' cores/bench/test/test_pipeline.py; head -100 cores/bench/test/conftest.py; git status --short --untracked-files=all\"", "aggregated_output": "async def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready=None, imem_ready=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Optional imem_ready(addr) and dmem_ready(addr, ren, wen) callbacks\n    drive backpressure after the initial fetch request.\n    Stores are applied when the bus is ready so subsequent loads see them.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = program if isinstance(program, dict) else {\n        i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)\n    }\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n        ready     = True if dmem_ready is None else dmem_ready(da, ren, wen)\n        dut.io_dmemReady.value = int(ready)\n        dut.io_imemReady.value = 1 if imem_ready is None else int(imem_ready(ia))\n\n        # Apply dmem write side effects.\n        if wen and ready:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (\n…[6807 of 9879 chars elided by tools/bench/transcript.py; sha256:4dff6b2088140279]…\n   program = [\n        ADDI(5, 0, 11),        # PC=0;  x5 := 11\n        JALR(1, 5, 2),         # PC=4;  jump to (11 + 2) & ~1 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    _, jump, target, _ = rets\n    assert (jump[\"pc_next\"], jump[\"rd_wdata\"]) == (12, 8)\n    assert target[\"cycle\"] - jump[\"cycle\"] == 2\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n", "exit_code": 0, "status": "completed"}}
