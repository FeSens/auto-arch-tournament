return max(candidates, default=(float(\\\"-inf\\\"), ()))\n\n        def period(src):\n            data_delay, chain = route(src)\n            if not chain:\n                return data_delay, chain\n            src_clk = src.rsplit(\\\"/\\\", 1)[0] + \\\"/CLK\\\"\n            dst_clk = dst.rsplit(\\\"/\\\", 1)[0] + \\\"/CLK\\\"\n            clkq = edges[src_clk][src]\n            clock = \\\"clock_ibuf/O\\\"\n            skew = edges[clock][src_clk] - edges[clock][dst_clk]\n            return data_delay + clkq + setup.get(dst, 0) + skew, chain\n\n        return period\n\n    rs1 = \\\"cpu/u_id/reg_q.rs1_val_{}_s0/Q\\\"\n    result = \\\"cpu/u_ex/reg_q.alu_result_{}_s0/D\\\"\n    print(path)\n    for src, dst in ((rs1.format(9), result.format(5)),\n                     (\\\"cpu/u_ex/reg_q.alu_result_3_s0/Q\\\", result.format(24)),\n                     (\\\"cpu/u_mem/reg_q.result_2_s0/Q\\\", \\\"cpu/u_id/reg_q.valid_s0/D\\\")):\n        delay, chain = route_to(dst)(src)\n        print(f\\\"{delay:.3f} ns {src} -> {dst}\\\")\n    data_paths = []\n    fill_paths = []\n    for dst_bit in range(1, 32):\n        lookup = route_to(result.format(dst_bit))\n        for src_bit in range(dst_bit + 1, 32):\n            result_path = lookup(rs1.format(src_bit))\n            data_paths.append(result_path)\n        fill_paths.append(lookup(\\\"cpu/u_id/reg_q.arithmetic_fill_s0/Q\\\"))\n    for label, samples in ((\\\"rs1 from high bit to low bit\\\", data_paths), (\\\"arithmetic fill\\\", fill_paths)):\n        delay, chain = max(samples)\n        if chain:\n            print(f\\\"{label}: {delay:.3f} ns {chain[0]} -> {chain[-1]}\\\")\n' cores/bench/generated/timing-champion-shift/impl/pnr/core_bench.sdf; head -c 550 \\\"\"'$TMPDIR/bench-timing-champion-shift.log\"; tail -n 4 cores/bench/generated/timing-champion-shift/gw.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
