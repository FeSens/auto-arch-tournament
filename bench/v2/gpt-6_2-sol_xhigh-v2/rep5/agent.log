{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"cat > \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/analyze.py\\\" <<'PY'\nfrom collections import Counter, defaultdict\nimport json\nfrom pathlib import Path\nfrom struct import iter_unpack\nimport sys\n\nroot = Path(sys.argv[1])\ninfo = json.loads((root / 'baseline.jsonl').read_text().splitlines()[-1])\nstart, stop = (info[k] for k in ('bench_start_cycle', 'bench_stop_cycle'))\nassert info['ebreak'] and not info['oob']\nbranches = []\npcs = Counter()\nredirects = Counter()\nedge_profiles = defaultdict(Counter)\nfor cyc, pc, insn, npc in iter_unpack('<IIII', (root / 'retire.bin').read_bytes()):\n    opcode = insn & 127\n    window = start <= cyc < stop\n    taken = npc \"'!= pc + 4\n    if window:\n        pcs[pc] += 1\n    if opcode not in (0x63, 0x6f, 0x67):\n        continue\n    offset = ((insn >> 19) & 0x1000) | ((insn << 4) & 0x800) | ((insn >> 20) & 0x7e0) | ((insn >> 7) & 0x1e)\n    if offset >= 4096:\n        offset -= 8192\n    target = pc + offset if opcode == 0x63 else npc\n    branches.append((window, pc, opcode, npc, taken, target))\n    if window:\n        redirects[opcode] += taken\n        edge_profiles[pc][npc] += 1\n\nprint('\"'cycles', stop-start, 'retired', sum(pcs.values()), 'unique PCs', len(pcs),\n      'controls', sum(t[0] for t in branches), 'unique controls', len(edge_profiles),\n      'taken by opcode', {hex(k):v for k,v in redirects.items()})\nprint('oracle cycles reduction', sum(redirects.values()) / (stop-start))\nfor size in (8, 16, 32, 64, 128, 256, 512, 1024):\n    for fold in (False, True):\n        if fold and size > 128:\n            continue\n        for ways in (1, 2):\n            nsets = size // ways\n            shift = nsets.bit_length() - 1\n            table = [{} for _ in range(nsets)]\n            missed = Counter()\n            hits = Counter()\n            for window, pc, opcode, npc, taken, target in branches:\n                word = pc >> 2\n                index = (word \"'^ ((word >> shift) if fold else 0)) & (nsets - 1)\n                entries = table[index]\n                counter, old_target = entries.get(pc, (1 if taken else 2, pc+4))\n                if window:\n                    hits[opcode] += pc in entries\n                    missed[opcode] += (old_target if counter >= 2 else pc + 4) != npc\n                if pc in entries:\n                    del entries[pc]\n                elif len(entries) == ways:\n                    del entries[next(iter(entries))]\n                counter = max(0, min(3, counter + (1 if taken else -1))) if opcode == 0x63 else 3\n                entries[pc] = counter, target\n            gain = (sum(redirects.values())-sum(missed.values()))/(stop-start)\n            print(f'\"'{size:4} {ways} way {str(fold):5} {gain:8.3%}', [missed[op] for op in (0x63, 0x6f, 0x67)])\nPY\npython3 \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/analyze.py\\\" \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
