{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/ex_sweep.py\" <<'\"'PY'\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport shutil\nfrom sweep import run, scratch, source\n\ntext = (source / 'ex_stage.sv').read_text()\nold_prefix = \\\"\\\"\\\"    assign addr_hi[i] = rs1[i+12] \"'^ ((addr_carry && (&rs1[12 +: i])) ||\n                                     (addr_borrow && !(|rs1[12 +: i])));\"\"\"\n\ndef new_prefix(style):\n    assert old_prefix in text\n    value_sources = {'\"'local': 'in.rs1_val', 'ex_mem': 'fwd_ex_mem', 'mem_wb': 'fwd_mem_wb'}\n    select_sources = {'local':'in.rs1_sel.reg_file', 'ex_mem': 'in.rs1_sel.ex_mem', 'mem_wb': 'in.rs1_sel.mem_wb'}\n    lines = []\n    for name, value in value_sources.items():\n        lines.append(f\\\"    wire {name}_all_ones = (&{value}[12 +: i]);\\\")\n        lines.append(f\\\"    wire {name}_any_one = (|{value}[12 +: i]);\\\")\n    plus = ' || '.join(f'({select} && {name}_all_ones)' for name, select in select_sources.items())\n    minus = ' || '.join(f'({select} && {name}_any_one)' for name, select in select_sources.items())\n    if style.startswith('full'):\n        lines.extend([f'    wire propagate_up = {plus};', f'    wire propagate_down = \"'!({minus});'\"'])\n        lines.append('    assign addr_hi[i] = rs1[i+12] \"'^ ((addr_carry && propagate_up) || (addr_borrow && propagate_down));'\"')\n    else:\n        group = int(style[3:])\n        lines = [f'    if (i % {group} == 0) begin : gen_preselect', *['  ' + line for line in lines],\n                 f'      assign prefix_up[i] = {plus};', f'      assign prefix_down[i] = \"'!({minus});'\"',\n                 '    end else begin : gen_refine',\n                 f'      localparam integer L = (i / {group}) * {group};',\n                 '      assign prefix_up[i] = prefix_up[L] && (&rs1[12 + L +: (i - L)]);',\n                 '      