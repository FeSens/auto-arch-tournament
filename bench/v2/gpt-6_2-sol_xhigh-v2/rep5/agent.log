{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/fanout_sweep.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom sweep import run, scratch, source\n\ndef edit(rtl, mode):\n    mem = rtl/'mem_stage.sv'\n    t = mem.read_text()\n    if mode in ('fansplit', 'fandual', 'fanmax'):\n        t = t.replace('  output logic               next_write,', '  output logic [31:0]        fwd_wb_result,\\\\n  output logic               next_write,')\n        if mode == 'fanmax':\n            t = t.replace('  assign out = reg_q;', '  (* syn_maxfan = 6 *) logic [31:0] fast_wb;\\\\n  assign fast_wb = reg_q.result;\\\\n  assign fwd_wb_result = fast_wb;\\\\n  assign out = reg_q;')\n        else:\n            t = t.replace('  assign out = reg_q;', '''  (* syn_preserve = 1, syn_keep = 1 *) logic [31:0] ex_copy_q;\n  always_ff @(posedge clock) begin\n    if (reset) ex_copy_q <= '0;\n    else if (\"'!recovery && !hold_wb) ex_copy_q <= wb_result;\n  end\n  assign fwd_wb_result = ex_copy_q;\n  assign out = reg_q;'\"''')\n        mem.write_text(t)\n        core = rtl/'core.sv'\n        t = core.read_text().replace('  logic [31:0] wb_w_data;', '  logic [31:0] wb_w_data, ex_fwd_wb_data;')\n        t = t.replace('.fwd_mem_wb      (wb_w_data)', '.fwd_mem_wb      (ex_fwd_wb_data)')\n        t = t.replace('    .next_write', '    .fwd_wb_result(ex_fwd_wb_data),\\\\n    .next_write')\n        core.write_text(t)\n    if mode in ('fandual', 'fanbase'):\n        ex = rtl/'ex_stage.sv'\n        x = ex.read_text().replace('  logic [12:0] addr_lo;', '''  (* syn_keep = 1 *) logic [31:0] addr_base;\n  assign addr_base = ({32{in.rs1_sel.ex_mem}} & fwd_ex_mem)\n                   | ({32{in.rs1_sel.mem_wb}} & fwd_mem_wb)\n                   | ({32{in.rs1_sel.reg_file}} & in.rs1_val);\n  logic [12:0] addr_lo;''')\n        a = x.index('  assign addr_lo')\n        b = x.index('  // ── ALU operand selection', a)\n        x = x[:a] + x[a:b].replace('rs1[','addr_base[') + x[b:]\n        ex.write_text(x)\n\nif __name__ == '__main__':\n    variants = ('fansplit','fandual','fanmax','fanbase')\n    for name in variants:\n        rtl = scratch / name / 'rtl'\n        shutil.copytree(source, rtl, dirs_exist_ok=True)\n        edit(rtl, name)\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(run, [(name, 1) for name in variants]))\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR/r11s0.AT6WVG/fanout_sweep.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/share_refine.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom sweep import run, scratch, source\nfrom share_sweep import edit\n\ndef refine(variant, name):\n    t = (variant/'divider.sv').read_text()\n    t = t.replace('narrow_q && quotient_q[28]};', 'work_low_bit_q};')\n    t = t.replace('  assign partial_dividend =', '''  logic work_low_bit_q;\n  always_ff @(posedge clock) begin\n    if (reset)             work_low_bit_q <= 1'b0;\n    else if (initializing) work_low_bit_q <= narrow_divisor && a_magnitude[24];\n    else if (counting_down) work_low_bit_q <= narrow_q && quotient_q[24];\n  end\n\n  assign partial_dividend =''')\n    if 'borrow' in name:\n        t = t.replace('assign narrow_borrow[digit] = borrow[digit];', 'assign narrow_borrow[digit] = gen_trial[digit].lo_difference[15];')\n        t = t.replace('    logic [33:0] difference;\\\\n    assign difference = {1\\\\'b0, partial_dividend} - {1\\\\'b0, multiples[digit][32:0]};',\n'''    logic [33:0] difference;\n    logic [15:0] lo_difference;\n    logic [18:0] hi_difference;\n    assign lo_difference = {1'b0, partial_dividend[14:0]} - {1'b0, multiples[digit][14:0]};\n    assign hi_difference = {1'b0, partial_dividend[32:15]} - {1'b0, multiples[digit][32:15]} - {18'b0, lo_difference[15]};\n    assign difference = {hi_difference, lo_difference[14:0]};''')\n    (variant/'divider.sv').write_text(t)\n\nif __name__ == '__main__':\n    variants = ('share_q','share_q_borrow','share_q_both','share_q_pre')\n    for name in variants:\n        rtl = scratch / name / 'rtl'\n        shutil.copytree(source, rtl, dirs_exist_ok=True)\n        edit(rtl, 'share_both' if name.endswith('both') else 'share_prescale' if name.endswith('pre') else 'share_basic')\n        refine(rtl, name)\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(run, [(name, 1) for name in variants]))\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR/r11s0.AT6WVG/share_refine.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/both_addr.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom sweep import run, scratch, source\nfrom addr_retime_sweep import edit\nfrom retime_sweep import retime\nif __name__ == '__main__':\n    names = ('hibp_split13_mux', 'hibp_split13_add', 'hi_split13_mux', 'hi_split13')\n    for name in names:\n        rtl = scratch / name / 'rtl'\n        shutil.copytree(source, rtl, dirs_exist_ok=True)\n        fetch, address = name.split('_', 1)\n        retime(rtl, fetch)\n        edit(rtl, address)\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(run, [(name, 1) for name in names]))\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR/r11s0.AT6WVG/both_addr.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
