m -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n# Random full-trace programs (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\ntotal 464\ndrwxrwx---+  3 nobody nogroup   4096 Nov 22 04:00 .\ndrwxrwx---+  3 nobody nogroup   4096 Nov 22 04:00 ..\n-rw-rw----+  1 nobody nogroup   2317 Nov 22 04:00 Makefile\ndrwxrwx---+ 14 nobody nogroup   4096 Nov 22 04:00 coremark\n-rw-rw----+  1 nobody nogroup    135 Nov 22 04:00 crt0.S\n-rw-rw----+  1 nobody nogroup   6341 Nov 22 04:00 gen_random_trace.py\n-rw-rw----+  1 nobody nogroup    330 Nov 22 04:00 link.ld\n-rw-rw----+  1 nobody nogroup 140494 Nov 22 04:00 random1.S\n-rw-rw----+  1 nobody nogroup 138125 Nov 22 04:00 random2.S\n-rw-rw----+  1 nobody nogroup 142438 Nov 22 04:00 random3.S\n-rw-rw----+  1 nobody nogroup   3684 Nov 22 04:00 selftest.S\ntotal 32\ndrwxrwx---+  7 nobody   nogroup  4096 Nov 22 04:02 .\ndrwxrwx---+  5 nobody   nogroup  4096 Nov 22 04:00 ..\ndr-xr-xr-x   2 hwebench hwebench   40 Nov 22 04:02 .agents\ndr-xr-xr-x   2 hwebench hwebench   40 Nov 22 04:02 .aws\ndr-xr-xr-x   2 hwebench hwebench   40 Nov 22 04:02 .codex\ndrwxr-x---+  2 hwebench hwebench 4096 Nov 22 04:02 .git\ndrwxrwx---+ 12 hwebench hwebench 4096 Nov 22 04:02 codex-bwrap-synthetic-mount-targets-1001\n8639935 log: hyp-20261122-003-r1s2 regression\n41e2f0a log: hyp-20261122-002-r1s1 improvement\n8b036ea log: hyp-20261122-001-r1s0 regression\n","exit_code":0,"status":"completed"}}
