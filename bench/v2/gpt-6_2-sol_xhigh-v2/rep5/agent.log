{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-predictor.35FE9v\"\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nroot = Path(sys.argv[1])\nfor name in ('explicit2', 'bounded2', 'bounded-shift2', 'qfloat2', 'array2'):\n    old = root/('rtl-shift2' if 'shift' in name else 'rtl-queue2')\n    new = root/f'rtl-{name}'\n    shutil.copytree(old, new)\n    p = new/'if_stage.sv'\n    s = p.read_text()\n    if 'shift' not in name:\n        if name == 'array2':\n            s = s.replace('if_id_t entries [0:DEPTH-1];', 'logic [103:0] entries [0:DEPTH-1];')\n        else:\n            s = s.replace('if_id_t entries [0:DEPTH-1];', 'if_id_t entry0_q, entry1_q;')\n            s = s.replace('entries[head_q]', '(head_q ? entry1_q : entry0_q)')\n            s = s.replace('        entries[tail_q] <= fresh_in;', '''        if (tail_q) entry1_q <= fresh_in;\n        else        entry0_q <= fresh_in;''')\n    if 'bounded' in name or name == 'qfloat2':\n        if 'shift' not in name:\n            s = s.replace('assign fetch = has_space && imem_ready;', '''assign fetch = has_space && imem_ready\n               && (pc_word \"'!= 30'\"'h3ffff || (\"'!buffered && !stall));'\"''')\n        else:\n            s = s.replace('assign fetch = imem_ready && (\"'!youngest_valid_q || pop);'\"', '''assign fetch = imem_ready && (\"'!youngest_valid_q || pop)\n               && (pc_word != 30'\"'h3ffff || (\"'!oldest_valid_q && !stall));'\"''')\n    if name == 'qfloat2':\n        s = s.replace('''        if (tail_q) entry1_q <= fresh_in;\n        else        entry0_q <= fresh_in;\n''', '')\n        s = s.replace('''  always_ff @(posedge clock) begin\n    if (reset || redirect)''', '''  always_ff @(posedge clock) begin\n    if (push && \"'!tail_q) entry0_q <= fresh_in;\n    if (push && tail_q)  entry1_q <= fresh_in;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect)'\"''')\n    p.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python3 - \\\"\"'$scratch\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json\nimport sys\nfrom tools.eval.gowin import build, summarize\nroot = Path(sys.argv[1])\nvariants = ('bounded2', 'explicit2', 'qfloat2', 'bounded-shift2', 'array2')\nwith ThreadPoolExecutor(max_workers=8) as pool:\n    jobs = {\n        (name, option): pool.submit(build, Path.cwd(), root/f'rtl-{name}', 'fpga/core_bench_si.sv',\n            option, root/f'pnr-final-{name}'/f'option-{option}')\n        for option in range(3) for name in variants\n    }\n    for name in variants:\n        results = [jobs[name, option].result() for option in range(3)]\n        print(f'{name}: {json.dumps(summarize(results))}', flush=True)\n        (root/f'{name}-timing-final.json').write_text(json.dumps(results))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
