{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c 'bench_probe_dir=/srv/hwebench/tmp/7c172beb/a589e53d/bench-structural.uNuQOA\nfor bench_variant in fetchsplit fetchcarry radix16; do\n  mkdir -p \"$bench_probe_dir/${bench_variant}_rtl\"\n  cp cores/bench/rtl/*.sv \"$bench_probe_dir/${bench_variant}_rtl/\"\ndone\npython3 - \"$bench_probe_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nd = Path(sys.argv[1])\nfor variant in ('fetchsplit', 'fetchcarry'):\n    f = d / (variant + '_rtl') / 'if_stage.sv'\n    src = f.read_text()\n    calc = \\\"\\\"\\\"  logic [18:0] aperture_sum;\n  logic        stays_in_aperture;\n  logic [11:0] upper_direct;\n  assign aperture_sum = {1'b0, pc_word[19:2]} + {1'b0, offset_word[19:2]};\n  assign stays_in_aperture = pc_word[31:20] == 12'b0 &&\n                             aperture_sum[18] == offset_word[20];\n  assign upper_direct = aperture_sum[18] == offset_word[20] ? pc_word[31:20]\n                        : offset_word[20] ? pc_word[31:20] - 12'd1\n                                          : pc_word[31:20] + 12'd1;\n  assign direct_word = {upper_direct, aperture_sum[17:0]};\\\"\\\"\\\"\n    if variant == 'fetchcarry':\n        calc = calc.replace(\\\"  assign aperture_sum = {1'b0, pc_word[19:2]} + {1'b0, offset_word[19:2]};\\\", \\\"\\\"\\\"  logic [9:0] low_sum, middle_sum;\n  logic [8:0] middle_inc;\n  assign low_sum = {1'b0, pc_word[10:2]} + {1'b0, offset_word[10:2]};\n  assign middle_sum = {1'b0, pc_word[19:11]} + {1'b0, offset_word[19:11]};\n  assign middle_inc = pc_word[19:11] + offset_word[19:11] + 9'd1;\n  assign aperture_sum = {middle_sum[9] || ((&middle_sum[8:0]) && low_sum[9]),\n                         low_sum[9] ? middle_inc : middle_sum[8:0],\n                         low_sum[8:0]};\\\"\\\"\\\")\n    src = src.replace(\\\"  assign direct_word = pc_word + {{11{imem_data[31]}}, offset_word};\\\", calc)\n    src = src.replace(\\\"\"'!direct_bit1 && direct_word[31:20] == 12'\"'b0\\\", \\\"\"'!direct_bit1 && stays_in_aperture\")\n    f.write_text(src)\nf = d / '\"'radix16_rtl' / 'divider.sv'\ns = f.read_text()\nstart = s.index('  // With D < 2048')\nend = s.index('  logic [34:0] multiples', start)\ns = s[:start] + \\\"\\\"\\\"  // The four-bit trial uses an 11-bit reduced remainder and\n  // ten registered odd multiples, with even multiples as shifts.\n  logic [14:0] narrow_odd [0:7];\n  logic [14:0] narrow_trial [0:15];\n  logic [14:0] narrow_partial;\n  logic [16:0] narrow_borrow;\n  logic [15:0] narrow_use;\n  logic [10:0] narrow_rem;\n  logic [3:0] narrow_digit;\n  logic [10:0] narrow_pieces [0:15];\n\n  for (genvar i = 0; i < 8; i++) begin : gen_odd_multiple\n    always_ff @(posedge clock) begin\n      if (initializing)\n        narrow_odd[i] <= 15'(b_magnitude[10:0]) * 15'(2*i+1);\n    end\n  end\n\n  assign narrow_partial = {remainder_q[10:0], quotient_q[31:28]};\n  assign narrow_borrow[0] = 1'b0;\n  assign narrow_borrow[16] = 1'b1;\n  assign narrow_trial[0] = narrow_partial;\n  for (genvar i = 1; i < 16; i++) begin : gen_narrow_trial\n    localparam int shift = (i % 8 == 0) ? 3 : (i % 4 == 0) ? 2 : (i % 2 == 0) ? 1 : 0;\n    localparam int odd_index = ((i >> shift) - 1) / 2;\n    assign {narrow_borrow[i], narrow_trial[i]} =\n        {1'b0, narrow_partial} - {1'b0, (narrow_odd[odd_index] << shift)};\n  end\n  for (genvar i = 0; i < 16; i++) begin : gen_narrow_select\n    assign narrow_use[i] = \"'!narrow_borrow[i] && narrow_borrow[i+1];\n    assign narrow_pieces[i] = narrow_trial[i][10:0] & {11{narrow_use[i]}};\n  end\n  for (genvar i = 0; i < 11; i++) begin : gen_narrow_remainder\n    logic [15:0] bits;\n    for (genvar j = 0; j < 16; j++) begin : gen_narrow_piece\n      assign bits[j] = narrow_pieces[j][i];\n    end\n    assign narrow_rem[i] = |bits;\n  end\n  assign narrow_digit = {|(narrow_use & 16'\"'hff00), |(narrow_use & 16'hf0f0),\n                         |(narrow_use & 16'hcccc), |(narrow_use & 16'haaaa)};\n\n\\\"\\\"\\\" + s[end:]\ns = s.replace(\\\"step2[10:0]\\\", \\\"narrow_rem\\\").replace(\\\"step1[12:11], step2[12:11]\\\", \\\"narrow_digit\\\")\nf.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python3 - \\\"\"'$bench_probe_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom tools.eval import gowin\nprobe = Path(sys.argv[1])\nfor variant in ('fetchsplit','fetchcarry','radix16'):\n    result = gowin.build_all(Path.cwd(), probe / f'{variant}_rtl', 'fpga/core_bench_si.sv', probe / variant)\n    print(variant, gowin.summarize(result), flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
