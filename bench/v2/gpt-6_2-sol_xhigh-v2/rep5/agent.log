bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return\n…[9664 of 12736 chars elided by tools/bench/transcript.py; sha256:34c474a3cb38c67e]…\ntched.\n        0x040: BNE(0, 0, 8),     # Index 19 = 16 XOR 3.\n        0x044: BEQ(0, 0, 0x100), # Index 19 = 17 XOR 2.\n        0x048: BEQ(0, 0, 0),     # Squashed before it can train.\n        0x144: NOP(),            # Let 0x044's queued update complete.\n        0x148: BEQ(0, 0, 0xF4),  # Index 19 = 18 XOR 1. Counter goes 01 -> 10.\n        0x23C: NOP(),\n        0x240: BNE(0, 0, 0x20),  # Index 19 = 16 XOR 3. Counter goes 10 -> 01.\n        0x244: JAL(0, 0x100),\n        0x260: BEQ(0, 0, 0),     # Predicted target of 0x240, stalled by imem.\n        0x344: BEQ(0, 0, 8),     # Index 19 = 17 XOR 2. Predict untaken again.\n        0x34C: EBREAK(),\n    }\n    fetches = []\n\n    def ready(addr):\n        fetches.append(addr)\n        return addr != 0x260\ncores/bench/test/test_pipeline.py:278:async def gshare_alias_and_direction_reversals(dut):\ncores/bench/test/test_pipeline.py:618:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\ncores/bench/test/test_pipeline.py:620:            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
