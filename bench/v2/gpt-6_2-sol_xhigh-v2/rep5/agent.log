{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/test/test_pipeline.py')\ns = p.read_text()\nwhere = s.index('def test_pipeline_runner():')\ns = s[:where] + '''@cocotb.test()\nasync def loop_replay_waits_for_fifo_space(dut):\n    start, backedge = 0x0F0, 0x108\n    program = {\n        0: ADDI(1, 0, 4),\n        4: JAL(0, start - 4),\n        0x0F0: SW(1, 0, 0x40),\n        0x0F4: NOP(),\n        0x0F8: ADDI(2, 2, 1),\n        0x0FC: ADDI(3, 3, 2),\n        0x100: ADDI(4, 4, 3),\n        0x104: ADDI(1, 1, -1),\n        backedge: BNE(1, 0, start - backedge),\n        0x10C: EBREAK(),\n    }\n    entries = 0\n    hold = 0\n    stalled = []\n    branch_requests = []\n\n    def imem_ready(addr):\n        nonlocal entries\n        if addr == start:\n            entries += 1\n        if entries == 3 and addr == backedge:\n            branch_requests.append(addr)\n        if entries == 3 and 0x0F8 <= addr <= 0x104:\n            stalled.append(addr)\n            return False\n        return True\n\n    def dmem_ready(addr, ren, wen):\n        nonlocal hold\n        if entries == 3 and addr == 0x40 and wen:\n            hold += 1\n            return hold >= 9\n        return True\n\n    rets, dmem = await _run(dut, program, dmem_ready=dmem_ready, imem_ready=imem_ready)\n    assert stalled == [0x0F8, 0x0FC, 0x100, 0x104]\n    assert len(branch_requests) >= 4\n    body = list(range(start, backedge + 4, 4))\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4] + body * 4 + [0x10C]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 0x100] == [3, 6, 9, 12]\n    assert dmem == {0x40: 1}\n\n\n@cocotb.test()\nasync def loop_replay_requires_matching_upper_tag(dut):\n    start, backedge = 0x0F0, 0x108\n    program = {\n        0: ADDI(1, 0, 4),\n        4: JAL(0, start - 4),\n        0x0F0: NOP(),\n        0x0F4: NOP(),\n        0x0F8: NOP(),\n        0x0FC: ADDI(2, 2, 1),\n        0x100: NOP(),\n        0x104: ADDI(1, 1, -1),\n        backedge: BNE(1, 0, start - backedge),\n        0x10C: JAL(0, 0x1F8 - 0x10C),\n        0x1F8: NOP(),\n        0x1FC: ADDI(8, 0, 37),\n        0x200: EBREAK(),\n    }\n    armed = False\n    attempts = 0\n\n    def ready(addr):\n        nonlocal armed, attempts\n        if int(dut.io_rvfi_valid_0.value) and int(dut.io_rvfi_pc_rdata_0.value) == 0x10C:\n            armed = True\n        if addr == 0x1FC:\n            if armed:\n                attempts += 1\n            return attempts >= 3\n        return True\n\n    rets, _ = await _run(dut, program, imem_ready=ready)\n    assert attempts == 3\n    assert [r[\\\"pc\\\"] for r in rets[-4:]] == [0x10C, 0x1F8, 0x1FC, 0x200]\n    assert rets[-2][\\\"rd_wdata\\\"] == 37\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n\n\n''' + s[where:]\np.write_text(s)\nPY\nTMPDIR=\\\"\"'$PWD\" pytest -q cores/bench/test/test_pipeline.py > replay-full-checks.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
