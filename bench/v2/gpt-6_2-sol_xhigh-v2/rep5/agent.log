didate = (!empty || (ready_response && response_valid)) && !issue_stall && !reset;\n'\"''' + s[end:]\n    path.write_text(s)\nPY\nfor bench_variant in retainedpacket retainedpacket32; do\n  RTL_DIR=\\\"\"'$bench_probe_dir/${bench_variant}_rtl\" OBJ_DIR=\"$bench_probe_dir/obj_${bench_variant}\" NRET=1 bash test/cosim/build.sh >\"$bench_probe_dir/build_${bench_variant}.log\" 2>&1 &&\n  \"$bench_probe_dir/obj_${bench_variant}/cosim_sim\" \"$bench_probe_dir/coremark.elf\" 6000000 --bench --istall --dstall | tail -1\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
