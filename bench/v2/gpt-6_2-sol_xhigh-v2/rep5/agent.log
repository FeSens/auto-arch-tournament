{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"set -e\nBENCH_MUL_SCRATCH='/srv/hwebench/tmp/7c172beb/008b187e/bench-multiply.yaeNDH'\ncat > \\\"\"'$BENCH_MUL_SCRATCH/check_multiplier.cpp\" <<'\"'CPP'\n#include \\\"Vmultiplier.h\\\"\n#include <array>\n#include <cassert>\n#include <cstdint>\n#include <iostream>\n#include <random>\n\nstatic void tick(Vmultiplier& device) {\n    device.clock = 0;\n    device.eval();\n    device.clock = 1;\n    device.eval();\n}\n\nstatic uint64_t widen(uint32_t value, bool is_signed) {\n    constexpr uint64_t mask32 = 0xffffffff;\n    return (is_signed && (value >> 31)) ? (value | (mask32 << 32)) : value;\n}\n\nint main() {\n    Vmultiplier device;\n    device.reset = 1;\n    device.launch = 0;\n    device.accept = 0;\n    tick(device);\n    assert(\"'!device.result_valid);\n    device.reset = 0;\n\n    const std::array<uint32_t, 9> edges = {\n        0, 1, 0x7fff, 0x8000, 0xffff, 0x10000, 0x7fffffff, 0x80000000, 0xffffffff\n    };\n    std::mt19937 rng(32);\n    size_t checks = 0;\n    auto check = [&](unsigned op, uint32_t a, uint32_t b) {\n        const uint64_t product = widen(a, op == 12 || op == 14) * widen(b, op == 12);\n        const uint32_t expected = op == 11 ? product : product >> 32;\n        device.op = op;\n        device.a = a;\n        device.b = b;\n        device.launch = 1;\n        tick(device);\n        assert(device.result_valid && device.result == expected);\n        device.launch = 0;\n        if (checks % 10 == 0) {\n            device.a = rng();\n            device.b = rng();\n            device.op = (op == 11 ? 12 : 11);\n            tick(device);\n            assert(device.result_valid && device.result == expected);\n        }\n        device.accept = 1;\n        tick(device);\n        assert(!device.result_valid);\n        device.accept = 0;\n        ++checks;\n    };\n\n    for (unsigned op = 11; op <= 14; ++op) {\n        for (auto a : edges)\n            for (auto b : edges)\n                check(op, a, b);\n        for (unsigned i = 0; i < 100000; ++i) {\n            const auto a = rng();\n            const auto b = rng();\n            check(op, a, b);\n        }\n    }\n    std::cout << \"Passed \" << checks << \" real multiply vectors and the response hold checks'\"\\\\n\\\";\n}\nCPP\nverilator --cc --exe --build -j 4 --top-module multiplier --Mdir \\\"\"'$BENCH_MUL_SCRATCH/build/mul_obj\" \"$BENCH_MUL_SCRATCH/rtl/core_pkg.sv\" \"$BENCH_MUL_SCRATCH/rtl/multiplier.sv\" \"$BENCH_MUL_SCRATCH/check_multiplier.cpp\" > \"$BENCH_MUL_SCRATCH/build/mul_unit.log\" 2>&1\n\"$BENCH_MUL_SCRATCH/build/mul_obj/Vmultiplier\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
