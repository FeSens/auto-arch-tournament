{"type": "item.completed", "item": {"id": "item_57", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/_helpers.py && rg -n 'sby|formal|pytest' tools/eval/formal.py | tail -30 && command -v pytest && python -c 'import cocotb; print(cocotb.__version__)'\"", "aggregated_output": "\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n1:\"\"\"Runs the real riscv-formal suite via formal/run_all.sh.\n3:The real suite is generated at runtime by formal/run_all.sh (which invokes\n8:If genchecks.py crashes mid-run and only emits one .sby task that\n25:    Only 1 and 2 are supported. NRET=1 selects the single-issue formal\n38:# Floor on how many .sby tasks must pass for a \"formal: green\" result.\n46:# post-run `*.sby` glob came up empty. Any one of these in the output\n65:def _build_formal_env(worktree: Path, target: str | None,\n67:    \"\"\"Build the subprocess env for invoking formal/run_all.sh.\n73:    formal/wrapper.sv + formal/checks.cfg.\n83:        env[\"WRAPPER\"] = str(worktree_path / \"formal\" / \"wrapper_si.sv\")\n84:        env[\"CHECKS_CFG\"] = str(worktree_path / \"formal\" / \"checks_si.cfg\")\n88:def _cleanup_formal_workdir(worktree_path: Path, core_name: str | None,\n90:    \"\"\"Remove this run's riscv-formal work dir once the tally is parsed.\n92:    run_formal() pins the dir name through FORMAL_WORK_ID, so this removes\n93:    exactly `formal/riscv-formal/cores/<CORE_NAME>-<work_id>` and nothing\n94:    else: never a concurrent agent self-check's dir (formal/run_all.sh\n99:    formal/last_run-<work_id>.log is kept either way.\n103:    shutil.rmtree(worktree_path / \"formal\" / \"riscv-formal\" / \"cores\"\n107:def run_formal(worktree: str, target: str | None = None) -> dict:\n116:                WRAPPER=formal/wrapper_si.sv and CHECKS_CFG=formal/checks_si.cfg\n117:                so the single-issue formal flow runs instead of the\n125:    run_script = worktree_path / \"formal\" / \"run_all.sh\"\n128:                'detail': f'formal/run_all.sh missing in {worktree}'}\n130:    env = _build_formal_env(worktree_path, target)\n141:            with eval_slot(\"formal\"):\n149:            # The formal harness exceeded its wall-clock ceiling. This MUST\n183:                # post-run `for sby_file in *.sby` glob finds zero matches.\n209:        # Script didn't produce a tally: setup error (missing riscv-formal repo,\n217:        _cleanup_formal_workdir(worktree_path, env.get(\"CORE_NAME\"), work_id)\n222:    result = run_formal(sys.argv[1] if len(sys.argv) > 1 else '.', sys.argv[2] if len(sys.argv) > 2 else None)\n/srv/hwebench/venv/bin/pytest\n2.0.1\n", "exit_code": 0, "status": "completed"}}
