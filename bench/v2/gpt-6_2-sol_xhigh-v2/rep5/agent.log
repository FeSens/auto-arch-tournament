{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/share_sweep.py\" <<'\"'PY'\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nimport re\nimport shutil\nfrom sweep import run, scratch, source\n\noriginal = (source / 'divider.sv').read_text()\n\ndef edit(variant, name):\n    t = original\n    t = t.replace('logic [34:0] extended_divisor;', 'logic [34:0] extended_divisor;\\\\n  logic [35:0] mult3, mult5, mult7;')\n    t = t.replace('logic [31:0] divisor_q, remainder_q, quotient_q;', 'logic [32:0] scaled_divisor_q;\\\\n  logic [31:0] remainder_q, quotient_q;')\n    t = t.replace('logic [34:0] three_divisor_q', 'logic [35:0] three_divisor_q')\n    t = t.replace('logic [34:0] multiples [1:7];', 'logic [35:0] multiples [1:7];')\n    t = t.replace('logic [31:0] partial_dividend, wide_remainder;', 'logic [32:0] partial_dividend;\\\\n  logic [31:0] wide_remainder;')\n    t = t.replace('logic [31:0] trial_remainder [0:7];', 'logic [32:0] trial_remainder [0:7];')\n    t = t.replace(\\\"assign multiples[1] = {3'b0, divisor_q};\\\", \\\"assign multiples[1] = {3'b0, scaled_divisor_q};\\\")\n    t = t.replace(\\\"assign multiples[2] = {2'b0, divisor_q, 1'b0};\\\", \\\"assign multiples[2] = multiples[1] << 1;\\\")\n    t = t.replace(\\\"assign multiples[4] = {1'b0, divisor_q, 2'b0};\\\", \\\"assign multiples[4] = multiples[1] << 2;\\\")\n    t = t.replace('assign narrow_dividend = {remainder_q[10:0], quotient_q[31:28]};',\n                  'assign narrow_dividend = partial_dividend[14:0];')\n    t = t.replace('for (genvar digit = 1; digit <= 7; digit++) begin : gen_shared_multiple\\\\n    assign narrow_multiples[digit] = multiples[digit][14:0];\\\\n  end\\\\n  assign narrow_multiples[8]  = narrow_multiples[4] << 1;',\n                  '''for (genvar digit = 1; digit <= 7; digit++) begin : gen_shared_multiple\n    assign narrow_multiples[digit] = multiples[digit][14:0];\n    assign narrow_trials[digit] = trial_remainder[digit][10:0];\n    assign narrow_borrow[digit] = borrow[digit];\n  end\n  assign narrow_multiples[8]  = narrow_multiples[4] << 1;''')\n    t = t.replace('for (genvar digit = 1; digit <= 15; digit++) begin : gen_narrow_trial',\n                  'for (genvar digit = 8; digit <= 15; digit++) begin : gen_narrow_trial')\n    t = t.replace('assign partial_dividend = {remainder_q[28:0], quotient_q[31:29]};',\n                  'assign partial_dividend = {remainder_q[28:0], quotient_q[31:29], narrow_q && quotient_q[28]};')\n    t = t.replace('logic [32:0] difference;', 'logic [33:0] difference;')\n    t = t.replace(\\\"partial_dividend} - {1'b0, multiples[digit][31:0]}\\\", \\\"partial_dividend} - {1'b0, multiples[digit][32:0]}\\\")\n    t = t.replace('trial_remainder[digit] = difference[31:0];', 'trial_remainder[digit] = difference[32:0];')\n    t = t.replace('difference[32] || |multiples[digit][34:32]', 'difference[33] || |multiples[digit][35:33]')\n    t = re.sub(r'( & trial_remainder\\\\[[0-7]\\\\])', r'\\\\1[32:1]', t)\n    t = t.replace(\\\"      divisor_q         <= '0;\\\", \\\"      scaled_divisor_q  <= '0;\\\")\n    t = t.replace('  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      scaled_divisor_q',\n                  '''  assign mult3 = (36'({extended_divisor}) << 1) + 36'({extended_divisor});\n  assign mult5 = (36'({extended_divisor}) << 2) + 36'({extended_divisor});\n  assign mult7 = (36'({extended_divisor}) << 3) - 36'({extended_divisor});\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      scaled_divisor_q''')\n    t = t.replace('      divisor_q         <= b_magnitude;\\\\n      three_divisor_q   <= (extended_divisor << 1) + extended_divisor;\\\\n      five_divisor_q    <= (extended_divisor << 2) + extended_divisor;\\\\n      seven_divisor_q   <= (extended_divisor << 3) - extended_divisor;',\n                  '''      scaled_divisor_q  <= narrow_divisor ? {1'b0, b_magnitude} : {b_magnitude, 1'b0};\n      three_divisor_q   <= narrow_divisor ? mult3 : (mult3 << 1);\n      five_divisor_q    <= narrow_divisor ? mult5 : (mult5 << 1);\n      seven_divisor_q   <= narrow_divisor ? mult7 : (mult7 << 1);''')\n    if name == 'share_prescale':\n        t = t.replace(\\\"assign extended_divisor = {3'b0, b_magnitude};\\\",\n                      \\\"assign extended_divisor = narrow_divisor ? {3'b0, b_magnitude} : {2'b0, b_magnitude, 1'b0};\\\")\n        for n, word in ((3, 'three'), (5, 'five'), (7, 'seven')):\n            t = t.replace(f'{word}_divisor_q   <= narrow_divisor ? mult{n} : (mult{n} << 1);', f'{word}_divisor_q   <= mult{n};')\n            t = t.replace(f'{word}_divisor_q    <= narrow_divisor ? mult{n} : (mult{n} << 1);', f'{word}_divisor_q    <= mult{n};')\n    if name == 'share_both':\n        t = t.replace('assign use_digit[digit] = \"'!borrow[digit] && borrow[digit+1];'\"',\n                      \\\"assign use_digit[digit] = \"'!borrow[digit] && ((digit == 7 && narrow_q) ? narrow_borrow[8] : borrow[digit+1]);\")\n        t = re.sub(r'\"'  assign wide_remainder = .*?;', '''  logic [32:0] shared_remainder;\n  always_comb begin\n    shared_remainder = '0;\n    for (int digit = 0; digit < 8; digit++)\n      shared_remainder |= {33{use_digit[digit]}} & trial_remainder[digit];\n    for (int digit = 8; digit < 16; digit++)\n      shared_remainder |= {22'b0, {11{narrow_q && narrow_use[digit]}} & narrow_trials[digit]};\n  end\n  assign wide_remainder = shared_remainder[32:1];''', t, count=1, flags=re.S)\n        t = re.sub(r\\\"  always_comb begin\\\\n    narrow_remainder = '0;\\\\n.*?\\\\n  end\\\", '  assign narrow_remainder = shared_remainder[10:0];', t, count=1, flags=re.S)\n    (variant/'divider.sv').write_text(t)\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('variants', nargs='+')\n    parser.add_argument('--options', type=int, nargs='+', default=[1])\n    args = parser.parse_args()\n    for name in args.variants:\n        variant = scratch / name / 'rtl'\n        shutil.copytree(source, variant, dirs_exist_ok=True)\n        edit(variant, name)\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(run, [(name, option) for name in args.variants for option in args.options]))\n\nif __name__ == '__main__':\n    main()\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR/r11s0.AT6WVG/share_sweep.py\" share_basic share_both share_prescale'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/if_flag_sweep.py\" <<'\"'PY'\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom sweep import run, scratch, source\nfrom retime_sweep import retime\n\ndef edit(variant, name):\n    f = variant/'if_stage.sv'\n    t = f.read_text()\n    if 'hi' in name:\n        retime(variant, 'hi')\n        t = f.read_text()\n    t = t.replace('  logic [31:2] pc_word', '''  localparam logic [31:2] LAST_IMEM_WORD = 30'h0003ffff;\n  localparam logic [31:2] BEFORE_LAST = LAST_IMEM_WORD - 30'd1;\n  logic [3:0] pc_flags, seq_flags_q, pred_flags_q, retry_flags_q, ex_flags_q, mem_flags_q;\n  logic [31:2] pc_word''')\n    index = t.index('  localparam logic [31:2] LAST_IMEM_WORD', t.index('  assign direct_bit1'))\n    t = t[:index] + t[index:].replace(\\\"  localparam logic [31:2] LAST_IMEM_WORD = 30'h0003ffff;\\\\n\\\", '', 1)\n    t = t.replace('pc_upper == 12\\\\'d0', 'pc_flags[0]').replace('&pc_upper', 'pc_flags[2]').replace('pc_upper == 12\\\\'d1', 'pc_flags[1]')\n    t = t.replace('pc_word == LAST_IMEM_WORD &&', 'pc_flags[3] &&')\n    t = t.replace('pc_word \"'!= LAST_IMEM_WORD &&'\"', '\"'!pc_flags[3] &&'\"')\n    t = t.replace('  always_ff @(posedge clock) begin\\\\n    ex_recovery', '''  function automatic [3:0] address_flags(input logic [31:2] word_addr);\n    address_flags = {word_addr == LAST_IMEM_WORD, &word_addr[31:20],\n                     word_addr[31:20] == 12'd1, word_addr[31:20] == 12'd0};\n  endfunction\n  assign pc_flags = ({4{mem_recovery}} & mem_flags_q)\n                  | ({4{ex_recovery && \"'!mem_recovery}} & ex_flags_q)\n                  | ({4{sequential_select_q && !recovering}} & seq_flags_q)\n                  | ({4{predicted_select_q && !recovering}} & pred_flags_q)\n                  | ({4{retry_select_q && !recovering}} & retry_flags_q);\n\n  always_ff @(posedge clock) begin\n    ex_flags_q <= address_flags(ex_redirect_word);\n    mem_flags_q <= address_flags(mem_redirect_word);\n    seq_flags_q <= address_flags(pc_word + 30'\"'d1);\n    pred_flags_q <= {(&direct_word[19:2]), 3'b001};\n    retry_flags_q <= reset ? 4'b0001 : pc_flags;\n\n    ex_recovery''')\n    if 'pre' in name:\n        t = t.replace('seq_flags_q <= address_flags(pc_word + 30\\\\'d1);', '''seq_flags_q <= (pc_flags[3] || (&pc_word[19:2]))\n                 ? {(pc_word == BEFORE_LAST), pc_upper == 12'hffe, pc_flags[0], pc_flags[2]}\n                 : {(pc_word == BEFORE_LAST), pc_flags[2:0]};''')\n    f.write_text(t)\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('variants', nargs='+')\n    parser.add_argument('--options', type=int, nargs='+', default=[1])\n    args = parser.parse_args()\n    for name in args.variants:\n        variant = scratch / name / 'rtl'\n        shutil.copytree(source, variant, dirs_exist_ok=True)\n        edit(variant, name)\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(run, [(name, option) for name in args.variants for option in args.options]))\n\nif __name__ == '__main__':\n    main()\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR/r11s0.AT6WVG/if_flag_sweep.py\" ifflag ifflag_pre ifflag_hi ifflag_hi_pre'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
