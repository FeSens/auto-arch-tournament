               (overflow_hi && pc_hi == 12'hfff);\n  assign direct_word = {target_hi, target_lo[17:0]};''')\n    s = s.replace(\\\"imem_ready && \"'!direct_bit1 && direct_word[31:20] == 12'\"'b0\\\", \\\"\"'!direct_bit1 && direct_in_range\")\n    s = s.replace('\"'({30{use_direct_q}}   & direct_word_q)', \\\"({30{use_direct_q}}   & {12'b0, direct_word_q})\\\")\n    s = s.replace('direct_word_q <= direct_word;', 'direct_word_q <= target_lo[17:0];')\n    if variant == 'fast':\n        s = s.replace(\\\"  assign target_lo = {1'b0, pc_word[19:2]} + {1'b0, offset_word[19:2]};\\\", '''  logic [9:0] low_part, high_zero, high_one;\n  assign low_part = {1'b0, pc_word[10:2]} + {1'b0, offset_word[10:2]};\n  assign high_zero = {1'b0, pc_word[19:11]} + {1'b0, offset_word[19:11]};\n  assign high_one  = {1'b0, pc_word[19:11]} + {1'b0, offset_word[19:11]} + 10'd1;\n  assign target_lo = {low_part[9] ? high_one : high_zero, low_part[8:0]};''')\n    path.write_text(s)\nPY\nprintf '%s\\\\n' \\\"\"'$top\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
