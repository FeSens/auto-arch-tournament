{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"cat > banked.py <<'PY'\nfrom pathlib import Path\n\ndef make_variant(base, var, separate_history):\n    src = Path(base)\n    dst = Path(var)\n    dst.mkdir()\n    for p in src.glob(\\\"*.sv\\\"):\n        (dst / p.name).write_bytes(p.read_bytes())\n    p = dst / \\\"if_stage.sv\\\"\n    s = p.read_text()\n    s = s.replace(\\\"  logic [1:0]  counters [0:63];\\\", \\\"  logic [3:0]  taken_banks;\\\")\n    start = s.index(\\\"  assign update_counter\\\")\n    stop = s.index(\\\"  logic        is_branch\\\", start)\n    s = s[:start] + \\\"\\\"\\\"  logic [1:0] next_counter;\n  logic [1:0] update_banks [0:3];\n\n  assign update_counter = update_banks[update_index_q[1:0]];\n  assign next_counter = update_taken_q ? (update_counter == 2'b11 ? 2'b11 : update_counter + 2'd1)\n                                      : (update_counter == 2'b00 ? 2'b00 : update_counter - 2'd1);\n\n  for (genvar bank = 0; bank < 4; bank++) begin : gen_counter_bank\n    (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counters [0:15];\n    logic [15:0] initialized_q;\n    logic update_bank;\n\n    assign update_bank = update_valid_q && update_index_q[1:0] == 2'(bank);\n    assign taken_banks[bank] = initialized_q[pc_word[7:4]] && counters[pc_word[7:4]][1];\n    assign update_banks[bank] = initialized_q[update_index_q[5:2]]\n                              ? counters[update_index_q[5:2]] : 2'b01;\n    always_ff @(posedge clock) begin\n      if (update_bank)\n        counters[update_index_q[5:2]] <= next_counter;\n      if (reset)\n        initialized_q <= '0;\n      else if (update_bank)\n        initialized_q[update_index_q[5:2]] <= 1'b1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      history_q      <= 2'b00;\n      update_valid_q <= 1'b0;\n      update_taken_q <= 1'b0;\n      update_index_q <= 6'b0;\n    end else begin\n      update_valid_q <= train_branch;\n      if (train_branch) begin\n        history_q      <= {history_q[0], train_taken};\n        update_index_q <= train_index;\n        update_taken_q <= train_taken;\n      end\n    end\n  end\n\n\\\"\\\"\\\" + s[stop:]\n    s = s.replace(\\\"counters[prediction_index][1]\\\", \\\"taken_banks[prediction_index[1:0]]\\\")\n    if separate_history:\n        s = s.replace(\\\"        history_q      <= {history_q[0], train_taken};\\\\n\\\",\\\"\\\")\n        s = s.replace(\\\"      update_valid_q <= train_branch;\\\",\\\"      update_valid_q <= train_branch;\\\\n      if (update_valid_q) history_q <= {history_q[0], update_taken_q};\\\")\n    p.write_text(s)\n\nmake_variant(\\\"baseline\\\",\\\"prototype_j\\\",False)\nmake_variant(\\\"prototype_g\\\",\\\"prototype_k\\\",False)\nmake_variant(\\\"baseline\\\",\\\"prototype_l\\\",True)\nPY\npython3 banked.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
