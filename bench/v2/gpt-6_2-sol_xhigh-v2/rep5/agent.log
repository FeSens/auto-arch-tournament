{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\norig = (base / 'alu.sv').read_text()\norig_ex = (base / 'ex_stage.sv').read_text()\n\ndef variant(name, chunks, method='xor', sub=True, add=True):\n    trial = scratch / name\n    shutil.copytree(base, trial)\n    decl = ['  logic [31:0] sum, difference;']\n    start = 0\n    for i, w in enumerate(chunks):\n        decl.extend([f'  logic [{w}:0] chunk_add_{i}, chunk_sub_{i};'])\n        for family, active, op, propagate in [\n            ('add', add, '+', '== ~'),\n            ('sub', sub, '-', '== '),\n        ]:\n            if not active:\n                continue\n            v = f'chunk_{family}_{i}'\n            c = f'{family}_carry_{i}'\n            p = f'{family}_prop_{i}'\n            operand_a = f'a[{start} +: {w}]'\n            operand_b = f'b[{start} +: {w}]'\n            result = 'sum' if family == 'add' else 'difference'\n            decl.extend([f'  logic {c}, {p};',\n                         f\\\"  assign {v} = {{1'b0, {operand_a}}} {op} {{1'b0, {operand_b}}};\\\",\n                         f\\\"  assign {p} = {operand_a} {propagate}{operand_b};\\\"])\n            terms = []\n            for j in reversed(range(i)):\n                combo = [f'chunk_{family}_{j}[{chunks[j]}]'] + [f'{family}_prop_{k}' for k in range(j+1, i)]\n                terms.append('(' + ' && '.join(combo) + ')')\n            decl.append(f\\\"  assign {c} = {' || '.join(terms) or chr(49)+chr(39)+'b0'};\\\")\n            if i == 0:\n                decl.append(f\\\"  assign {result}[{start} +: {w}] = {v}[{w-1}:0];\\\")\n            elif method == 'select':\n                decl.append(f\\\"  assign {result}[{start} +: {w}] = {c} ? ({operand_a} {op} {operand_b} {op} {w}'d1) : {v}[{w-1}:0];\\\")\n            elif method == 'cin':\n                if family == 'add':\n                    decl.append(f\\\"  assign {result}[{start} +: {w}] = {operand_a} + {operand_b} + {w}'({c});\\\")\n                else:\n                    decl.append(f\\\"  assign {result}[{start} +: {w}] = {operand_a} - {operand_b} - {w}'({c});\\\")\n            else:\n                decl.append(f\\\"  assign {result}[{start}] = {v}[0] \"'^ {c};\")\n                for k in range(1, w):\n                    decl.append(f\"  assign {result}[{start+k}] = {v}[{k}] ''^ ({c} && a[{start} +: {k}] {propagate}b[{start} +: {k}]);\")\n        start += w\n    if sub:\n        terms = []\n        for j in reversed(range(len(chunks))):\n            combo = [f'\"'chunk_sub_{j}[{chunks[j]}]'] + [f'sub_prop_{k}' for k in range(j+1, len(chunks))]\n            terms.append('(' + ' && '.join(combo) + ')')\n        decl.extend(['  logic borrow, signed_less;', f\\\"  assign borrow = {' || '.join(terms)};\\\",\n                     '  assign signed_less = (a[31] \"'!= b[31]) ? a[31] : borrow;'\"'])\n    rtl = orig.replace('  assign sel =', '\\\\n'.join(decl) + '\\\\n\\\\n  assign sel =')\n    if add:\n        rtl = rtl.replace('(a + b)', 'sum')\n    if sub:\n        rtl = rtl.replace('(a - b)', 'difference')\n        rtl = rtl.replace('(sel.slt && \"'$signed(a) < $signed(b)) || (sel.sltu && a < b)'\"',\n                          '(sel.slt && signed_less) || (sel.sltu && borrow)')\n    (trial / 'alu.sv').write_text(rtl)\n\nvariant('alu_8x4', [8,8,8,8])\nvariant('alu_16x2', [16,16])\nvariant('alu_12_10_10', [12,10,10])\nvariant('alu_8x4_cin', [8,8,8,8], 'cin')\nvariant('alu_8x4_select', [8,8,8,8], 'select')\nvariant('alu_add_8x4', [8,8,8,8], sub=False)\n\nshutil.copytree(base, scratch / 'agu_only')\nagu = (scratch / 'grouped' / 'ex_stage.sv').read_text().replace('  assign jalr_sum = {addr_hi, addr_lo[11:0]};', '  assign jalr_sum = rs1 + in.imm;')\n(scratch / 'agu_only' / 'ex_stage.sv').write_text(agu)\n\