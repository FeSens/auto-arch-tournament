{"type":"item.completed","item":{"id":"item_187","type":"command_execution","command":"/bin/bash -c \"python3 -c '\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nfrom tempfile import TemporaryFile\n\nroot = Path(os.environ[\\\"TMPDIR\\\"])\nwith TemporaryFile(dir=root) as wrapper:\n    wrapper.write(sys.argv[1].encode())\n    wrapper.flush()\n    wrapper.seek(0)\n    paths = []\n    for variant in (root / \\\"bench-baseline/cores/bench/rtl\\\", root / \\\"bench-direct-rtl\\\"):\n        paths.append(\\\" \\\".join(str(variant / (name + \\\".sv\\\")) for name in\n                              (\\\"core_pkg\\\", \\\"alu\\\", \\\"divider\\\", \\\"multiplier\\\", \\\"id_stage\\\", \\\"ex_stage\\\")))\n    cmds = []\n    for label, files in zip((\\\"gold\\\", \\\"gate\\\"), paths):\n        cmds += [f\\\"read_verilog -formal -sv -D RISCV_FORMAL_ALTOPS {files} /proc/self/fd/{wrapper.fileno()}\\\",\n                 \\\"prep -top issue_execute -flatten\\\", f\\\"rename issue_execute {label}\\\", f\\\"design -stash {label}\\\"]\n    cmds += [\\\"design -copy-from gold gold\\\", \\\"design -copy-from gate gate\\\",\n             \\\"miter -equiv -make_assert -flatten gold gate miter\\\", \\\"hierarchy -top miter\\\",\n             \\\"memory_map\\\", \\\"opt -full\\\",\n             \\\"sat -seq 4 -set-at 1 in_reset 1 -set-init-zero -prove-skip 1 -prove-asserts -verify\\\"]\n    subprocess.run([\\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", \\\"; \\\".join(cmds)], pass_fds=(wrapper.fileno(),), check=True)\n' '\nmodule issue_execute (\n  input logic clock, reset, hold, stall, issue_candidate, issue,\n  input issue_packet_t in,\n  input logic [31:0] rs1_data, rs2_data, wb_value, fwd_ex_mem, fwd_mem_wb,\n  input operand_sel_t rs1_sel, rs2_sel,\n  output logic [31:0] result\n);\n  id_ex_t id_ex;\n  ex_mem_t ex_mem;\n  logic [4:0] rs1_addr, rs2_addr;\n  id_stage u_id (.out(id_ex), .*);\n  ex_stage u_ex (.clock(clock), .reset(reset), .stall(stall), .in(id