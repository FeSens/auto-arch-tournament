{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'study=\"$TMPDIR/fetch-target-study\"\npython - \"$study\" <<'\"'PY'\nimport json, re, sys\nfrom pathlib import Path\np=Path(sys.argv[1])\nfor v in ('divider_split','queue_exchange'):\n for file in sorted(p.glob(v+'.*')):\n  s=file.read_text()\n  if file.suffix=='.coremark':\n   d=json.loads(s.splitlines()[-1])\n   print(v, d['bench_stop_cycle']-d['bench_start_cycle'], 'oob', d['oob'], 'CRC validation', 'Correct operation validated.' in d['uart'])\n  if file.suffix=='.cosim':\n   print(v, s.splitlines()[-4:])\n  if file.suffix=='.timing':\n   print(file.name, re.findall(r'score Fmax \\\\(median\\\\): (.*)',s))\nfor v in ('pht_gray','pht_ram','pht_banked','pht_1hot','fetch_imm_bit','queue_exchange'):\n f=p/(v+'.timing')\n if f.exists():\n  print(v,[x for x in f.read_text().splitlines() if 'score Fmax' in x or 'FAILED' in x])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
