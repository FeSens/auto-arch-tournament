{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"git diff --check; sed -n '85,150p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"  logic [$bits(fetch_packet)-1:0] queue [0:3];\n  logic [2:0] head_q, tail_q;\n  logic queue_empty, queue_full;\n  logic bypass_valid, accept_response, enqueue, dequeue;\n  logic last_word, defer_fallthrough, aperture_wait_q, recover;\n\n  assign queue_empty = head_q == tail_q;\n  assign queue_full  = head_q == {~tail_q[2], tail_q[1:0]};\n  assign last_word   = pc_word == 30'h0003ffff;\n\n  // The last RAM word can only enter EX directly. If its prediction is\n  // sequential, wait for EX to supply the resolved successor.\n  assign bypass_valid      = imem_ready && !aperture_wait_q;\n  assign accept_response   = bypass_valid && !queue_full\n                          && (!last_word || (queue_empty && decode_ready));\n  assign defer_fallthrough = last_word && !predicted_taken;\n  assign recover           = redirect || (aperture_wait_q && ex_advance);\n  assign enqueue           = accept_response && !(queue_empty && decode_ready);\n  assign dequeue           = !queue_empty && decode_ready;\n\n  // Write the unused tail every cycle with space. Only the pointers\n  // publish an entry or invalidate it on recovery. This write and the\n  // asynchronous head read infer distributed RAM.\n  always_ff @(posedge clock) begin\n    if (!queue_full) queue[tail_q[1:0]] <= fetch_packet;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || recover) begin\n      head_q <= '0;\n      tail_q <= '0;\n    end else begin\n      if (enqueue) tail_q <= tail_q + 3'd1;\n      if (dequeue) head_q <= head_q + 3'd1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_word <= '0;\n    end else if (recover) begin\n      pc_word <= redirect_word;\n    end else if (accept_response && !defer_fallthrough) begin\n      pc_word <= predicted_taken ? direct_word : pc_word + 30'