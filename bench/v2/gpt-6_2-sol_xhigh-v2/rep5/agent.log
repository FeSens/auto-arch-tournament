{"type": "item.completed", "item": {"id": "item_81", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl; git diff --check'", "aggregated_output": "diff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex bc13c28..47e5f83 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -2,10 +2,8 @@\n //\n // Top-level wiring for the 5-stage in-order RV32IM core.\n //\n-//  IF -> ID -> EX -> MEM -> WB\n-//   |    |     ^\n-//   |    +-----+    ID preselects the source of each EX operand\n-//   +- stall <- hazard_unit (late results, divide, and bus backpressure)\n+//  IF/decode -> issue FIFO -> ID -> EX -> MEM -> WB\n+//                              ID preselects the source of each EX operand.\n //\n // IO port names use the `io_*` Chisel-emit prefix so the existing\n // formal/wrapper_si.sv and test/cosim/main.cpp bindings carry through\n@@ -25,8 +23,8 @@ module core (\n   // imem\n   output logic [31:0] io_imemAddr,\n   input  logic [31:0] io_imemData,\n-  // A stalled imem request invalidates the fetch packet. Fetch keeps its PC\n-  // unless EX redirects to the resolved successor.\n+  // A stalled imem response cannot enter the issue FIFO. Queued packets\n+  // can still issue and EX can redirect the request.\n   input  logic        io_imemReady,\n   // dmem\n   output logic [31:0] io_dmemAddr,\n@@ -35,9 +33,8 @@ module core (\n   output logic [3:0]  io_dmemWEn,\n   output logic        io_dmemREn,\n   // dmem bus backpressure. Drive 1 for zero-wait. Drive 0 to model\n-  // dStall — when there is a memory op in EX/MEM, the entire pipeline\n-  // freezes back to MEM; MEM/WB captures a bubble; the LOAD/STORE waits\n-  // until the bus delivers.\n+  // dStall — when there is a memory op in EX/MEM, issue and execute hold\n+  // and MEM/WB captures a bubble. Fetch can fill the FIFO while waiting.\n   input  logic        io_dmemReady,\n   // RVFI — single-channel retirement port set (NRET=1 contract,\n   // declared via `nret: 1` in core.yaml). Channel 0 is the sole\n@@ -66,13 +63,13 @@ module core (\n );\n \n   // ── Inter-stage wires ──────────────────────────────────────────────────\n-  if_id_t  if_id_w;\n+  issue_packet_t if_id_w;\n   id_ex_t  id_ex_w;\n   ex_mem_t ex_mem_w;\n   mem_w\n…[18275 of 21347 chars elided by tools/bench/transcript.py; sha256:8cfedcf68b717ecb]…\nonse)-1:0] fifo [0:3];\n+  logic [2:0] read_ptr_q, write_ptr_q;\n+  logic empty, full;\n+\n+  assign empty = read_ptr_q == write_ptr_q;\n+  assign full  = read_ptr_q == {~write_ptr_q[2], write_ptr_q[1:0]};\n+  assign response_valid = imem_ready && !aperture_wait_q;\n+  assign accept_response = response_valid && !full && !reset;\n+  assign out = empty ? response : fifo[read_ptr_q[1:0]];\n+  assign issue_candidate = (!empty || response_valid) && !issue_stall && !reset;\n+  assign issue = issue_candidate && !redirect;\n+\n+  always_ff @(posedge clock) begin\n+    // A coincident redirect invalidates the written slot with the rest\n+    // of the FIFO. Recovery only drives the pointers and request PC.\n+    if (accept_response)\n+      fifo[write_ptr_q[1:0]] <= response;\n+\n+    if (reset || redirect) begin\n+      read_ptr_q  <= '0;\n+      write_ptr_q <= '0;\n+    end else begin\n+      if (issue)           read_ptr_q  <= read_ptr_q + 3'd1;\n+      if (accept_response) write_ptr_q <= write_ptr_q + 3'd1;\n+    end\n+  end\n \n endmodule\n", "exit_code": 0, "status": "completed"}}
