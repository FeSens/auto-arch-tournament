{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c 'set -e\nprofile_dir=\"$TMPDIR/bench-r10-profile.Jp85SQ\"\nmkdir -p \"$profile_dir/rtl5\" \"$profile_dir/rtl6\"\ncp \"$profile_dir/rtl4/\"*.sv \"$profile_dir/rtl5/\"\ncp \"$profile_dir/rtl4/\"*.sv \"$profile_dir/rtl6/\"\ncat > \"$profile_dir/addr.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nf=Path(sys.argv[1])/'ex_stage.sv'\ns=f.read_text()\ns=s.replace('  assign addr_lo     = {1\\\\'b0, rs1[11:0]} + {1\\\\'b0, in.imm[11:0]};', '''  logic [6:0] addr_low, addr_mid;\n  assign addr_low = {1'b0, rs1[5:0]} + {1'b0, in.imm[5:0]};\n  assign addr_mid = {1'b0, rs1[11:6]} + {1'b0, in.imm[11:6]} + {6'b0, addr_low[6]};\n  assign addr_lo = {addr_mid, addr_low[5:0]};''')\ns=s.replace('  assign addr_hi     = addr_lo[12] ? (in.imm[11] ? rs1[31:12] : addr_hi_inc)\\\\n                                   : (in.imm[11] ? addr_hi_dec : rs1[31:12]);', '''  assign addr_hi[0] = rs1[12] \"'^ in.imm[11] ''^ addr_lo[12];\n  assign addr_hi[19:1] = addr_lo[12] ? (in.imm[11] ? rs1[31:13] : addr_hi_inc[19:1])\n                                     : (in.imm[11] ? addr_hi_dec[19:1] : rs1[31:13]);'\"''')\nif len(sys.argv)>2:\n    s=s.replace('  logic [31:0] rs2;', '''  logic [31:0] rs2;\n  logic [31:0] late_other;''')\n    s=s.replace('  // ── Load/store effective address', '''  assign late_other = ({32{in.late_known_sel.ex_mem}}   & fwd_ex_mem)\n                     | ({32{in.late_known_sel.mem_wb}}   & fwd_mem_wb)\n                     | ({32{in.late_known_sel.wb}}       & in.wb_value)\n                     | ({32{in.late_known_sel.reg_file}} & in.late_known_raw);\n\n  // ── Load/store effective address''')\n    s=s.replace('reg_q.branch_known  <= in.late_rs1 ? alu_b : rs1;', 'reg_q.branch_known  <= late_other;')\n    p=f.parent/'core_pkg.sv'\n    p.write_text(p.read_text().replace('    alu_lanes_t  alu_lanes;', '    alu_lanes_t  alu_lanes;\\\\n    logic [31:0] late_known_raw;\\\\n    operand_sel_t late_known_sel;'))\n    p=f.parent/'id_stage.sv'\n    p.write_text(p.read_text().replace('      reg_q.rs1_sel          <= rs1_sel;', '''      reg_q.rs1_sel          <= rs1_sel;\n      if (late_rs1 && in.ctrl.alu_src) begin\n        reg_q.late_known_raw <= in.imm;\n        reg_q.late_known_sel <= 4'b0001;\n      end else begin\n        reg_q.late_known_raw <= late_rs1 ? rs2_data : rs1_data;\n        reg_q.late_known_sel <= late_rs1 ? rs2_sel : rs1_sel;\n      end'''))\nf.write_text(s)\nPY\npython3 \\\"\"'$profile_dir/addr.py\" \"$profile_dir/rtl5\"\npython3 \"$profile_dir/addr.py\" \"$profile_dir/rtl6\" isolate\nPYTHONDONTWRITEBYTECODE=1 python3 - \"$profile_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\nscratch=Path(sys.argv[1])\nwith ThreadPoolExecutor() as pool:\n    pending={v:pool.submit(build,Path.cwd(),scratch/f'rtl{v}','fpga/core_bench_si.sv',1,scratch/f'pnr{v}1') for v in (5,6)}\n    for v,p in pending.items():\n        result=p.result()\n        print(v,{key:result[key] for key in ('place_option','fmax_mhz','logic','regs')},result.get('critical_paths',[])[:3],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
