{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport collections,os,struct\nfrom pathlib import Path\np=Path(os.environ['TMPDIR'])/'bench-r13s2.HRFdpy/coremark.elf.pc'; \nlast_edge=-1\nsimple=collections.Counter()\njump=collections.Counter()\nbranches=collections.Counter()\nrepeat=collections.Counter()\nseen = {}\nfor n,(pc,npc,ins) in enumerate(struct.iter_unpack('<III',p.read_bytes())):\n op=ins & 127\n if op == 0x67:\n  jump[pc, npc]+=1\n if op == 0x63:\n  branches[pc,npc]+=1\n  if npc < pc and pc-npc <= 63*4:\n   length = (pc-npc)//4+1\n   simple[pc,npc,length,n-last_edge==length] += 1\n   if pc in seen and n-seen[pc][0] == length:\n    repeat[pc,npc,length] += 1\n   seen[pc] = n,npc\n if npc \"'!= pc+4:\n  last_edge=n\nprint(n+1,idx if False else sum(jump.values()),sum(branches.values()))\nfor (pc,npc,length,linear),ct in sorted(simple.items(),key=lambda x: -x[0][2]*x[1])[:32]:\n print(hex(npc),hex(pc),length,linear,ct,ct*length,repeat[pc,npc,length])\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
