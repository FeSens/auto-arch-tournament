{"type": "item.started", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/bash -c \"set -o pipefail\nyosys -Q -T -p 'read_verilog -sv -formal -D RISCV_FORMAL_ALTOPS cores/bench/rtl/core_pkg.sv cores/bench/rtl/forward_unit.sv cores/bench/rtl/id_stage.sv cores/bench/rtl/alu.sv cores/bench/rtl/ex_stage.sv cores/bench/rtl/multiplier.sv cores/bench/rtl/divider.sv cores/bench/rtl/mem_stage.sv /dev/stdin; hierarchy -check -top addi_bypass_check; proc; flatten; opt; sat -verify -seq 5 -set-def-inputs -set-at 1 reset 1 -set-at 2 reset 0 -set-at 3 reset 0 -set-at 4 reset 0 -set-at 5 reset 0 -prove-skip 1 -prove okay 1 -show-inputs -show-outputs' <<'SV' | tail -55\nmodule addi_bypass_check (\n  input logic clock, reset, stall, issue, immediate_add,\n  input logic ex_writes, ex_is_addi, mem_writes, pending1, pending2, predecessor_writes,\n  input logic [4:0] rs1, rs2, ex_rd, mem_rd,\n  input logic [11:0] offset,\n  input logic [31:0] rf1, rf2, ex_value, addr_value, wb_value,\n  output logic okay\n);\n  logic [4:0] tag1, tag2;\n  logic [31:0] rf1_read, rf2_read;\n  issue_packet_t packet;\n  operand_sel_t sel1, sel2;\n  id_ex_t id_entry;\n  ex_mem_t ex_entry;\n  mem_wb_t wb_entry;\n  logic fast_write, fast_addi;\n\n  always_comb begin\n    packet = '0;\n    packet.ctrl.alu_op = ALU_ADD;\n    packet.ctrl.alu_src = immediate_add;\n    packet.ctrl.reg_write = 1'b1;\n    packet.late_eligible = 1'b1;\n    packet.imm = immediate_add ? {{20{offset[11]}}, offset} : 32'b0;\n    packet.instr[19:15] = rs1;\n    packet.instr[24:20] = immediate_add ? offset[4:0] : rs2;\n  end\n  assign rf1_read = tag1 == 5'b0 ? 32'b0 : rf1;\n  assign rf2_read = tag2 == 5'b0 ? 32'b0 : rf2;\n\n  forward_unit fwd (\n    .rs1_addr(tag1), .rs2_addr(tag2), .ex_rd(ex_rd),\n    .ex_fast_write(ex_writes), .ex_fast_addi(ex_writes && ex_is_addi),\n    .mem_rd(mem_rd), .mem_write(mem_writes), .rs1_sel(sel1), .rs2_sel(sel2)\n  );\n  id_stage decode_id (\n    .clock(clock), .reset(reset), .hold(stall