{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\"\nPREDICTOR_VARIANTS=\"$trial_dir\" PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\noriginal = root/'cores/bench/rtl'\nscratch = Path(os.environ['PREDICTOR_VARIANTS'])\n\ndef synth_adder(widths, prefix):\n    logic = []\n    low = 2\n    def assign(lhs, rhs):\n        logic.append(f'  assign {lhs} = {rhs};')\n    for g, w in enumerate(widths):\n        rng = f'{low+w-1}:{low}'\n        pc = f'pc_word[{rng}]'\n        offset = f'offset_word[{rng}]'\n        if prefix:\n            logic.append(f'  logic [{w-1}:0] group_sum_{g};')\n            assign(f'group_sum_{g}', f'{pc} + {offset}')\n        else:\n            logic.append(f'  logic [{w}:0] group_sum_{g};')\n            assign(f'group_sum_{g}', f\\\"{{1'b0, {pc}}} + {{1'b0, {offset}}}\\\")\n        ge = f'group_generate_{g}'\n        prop = f'group_propagate_{g}'\n        logic.append(f'  logic {ge};')\n        assign(ge, f'{pc} > (~{offset})' if prefix else f'group_sum_{g}[{w}]')\n        if g:\n            logic.append(f'  logic {prop}, carry_{g};')\n            assign(prop, f'{pc} == (~{offset})' if prefix else f'(&group_sum_{g}[{w-1}:0])')\n            terms = [' && '.join([f'group_generate_{j}'] + [f'group_propagate_{k}' for k in range(j+1,g)]) for j in range(g)]\n            assign(f'carry_{g}', ' || '.join(f'({term})' for term in terms))\n            logic.append(f'  logic [{w-1}:0] group_inc_{g};')\n            assign(f'group_inc_{g}', f\\\"{pc} + {offset} + {w}'d1\\\")\n            assign(f'direct_word[{rng}]', f'carry_{g} ? group_inc_{g} : group_sum_{g}[{w-1}:0]')\n        else:\n            assign(f'direct_word[{rng}]', f'group_sum_{g}[{w-1}:0]')\n        low += w\n    terms = [' && '.join([f'group_generate_{j}'] + [f'group_propagate_{k}' for k in range(j+1,len(widths))]) for j in range(len(widths))]\n    assign('carry_to_upper', ' || '.join(f'({term})' for term in terms))\n    return '\\\\n'.join(logic)+'\\\\n'\n\ndef replace_adder(src, widths, prefix):\n    src = src.replace('  logic [9:0] low_sum, middle_sum;\\\\n  logic [8:0] middle_plus_one;\\\\n','')\n    start = src.index('  assign low_sum')\n    end = src.index('  assign upper_pc', start)\n    src = src[:start] + synth_adder(widths, prefix) + '\\\\n' + src[end:]\n    src = '\\\\n'.join(l for l in src.split('\\\\n') if 'low_sum' not in l)\n    return src\n\nvariants = [\n    ('carry6select', 'split-only', [6,6,6], False),\n    ('carry6parallel', 'parallel', [6,6,6], True),\n    ('carry6compact', 'two-pc-compact', [6,6,6], True),\n    ('carry9select', 'split-only', [9,9], True),\n    ('carry9parallel', 'parallel', [9,9], True),\n    ('carry9compact', 'two-pc-compact', [9,9], True),\n    ('carry8select', 'split-only', [8,5,5], True),\n    ('carry4compact', 'parallel-compact', [4,5,5,4], True),\n]\nfor name, source, widths, prefix in variants:\n    directory = scratch/name\n    shutil.copytree(scratch/source, directory, copy_function=shutil.copyfile)\n    path = directory/'if_stage.sv'\n    path.write_text(replace_adder(path.read_text(), widths, prefix))\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:\n    builds = {pool.submit(build, root, scratch/name, 'fpga/core_bench_si.sv', option, scratch/f'{name}-{option}'): (name, option)\n              for option in (1, 0) for name, *_ in variants}\n    for future in concurrent.futures.as_completed(builds):\n        result = future.result()\n        print(builds[future], result.get('fmax_mhz'), result.get('reason'), (result.get('critical_paths') or [None])[0], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
