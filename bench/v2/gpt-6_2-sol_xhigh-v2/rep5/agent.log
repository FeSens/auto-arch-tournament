n`ifdef RISCV_FORMAL_ALTOPS\n  logic [4:0] op_q;\n  logic [31:0] alt_mask;\n\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  alt_mask = 32'h7f8529ec;\n      ALU_DIVU: alt_mask = 32'h10e8fd70;\n      ALU_REM:  alt_mask = 32'h8da68fa5;\n      ALU_REMU: alt_mask = 32'h3138d0e1;\n      default:  alt_mask = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      op_q   <= '0;\n      result <= '0;\n    end else if (starting) begin\n      op_q <= op;\n    end else if (initializing) begin\n      result <= (a_q - b_q) ^ alt_ma\n…[4614 of 7686 chars elided by tools/bench/transcript.py; sha256:88604b7361c2fce1]…\nse if (initializing) begin\n      divisor_q         <= b_magnitude;\n      three_divisor_q   <= {2'b0, b_magnitude} + {1'b0, b_magnitude, 1'b0};\n      remainder_q       <= {28'b0, small_divisor ? prefix_second[3:0] : a_mag_hi};\n      quotient_q        <= {a_mag_lo, small_divisor ? {prefix_first[5:4], prefix_second[5:4]} : 4'b0};\n      // When D=0, the quotient stays all ones and the signed\n      // remainder reconstructs the original dividend.\n      negate_q          <= want_remainder_q ? a_negative_q\n                                            : (a_negative_q ^ b_negative_q) && (b_q != 0);\n    end else if (counting_down) begin\n      remainder_q <= step2[31:0];\n      quotient_q  <= {quotient_q[27:0], step1[33:32], step2[33:32]};\n    end\n  end\n\n  // MEM selects and sign-corrects the registered final state.\n  // Keeping 32 result bits also handles INT_MIN / -1 and INT_MIN % -1.\n  assign magnitude = want_remainder_q ? remainder_q : quotient_q;\n  assign result = negate_q ? -magnitude : magnitude;\n`endif\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
