{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom itertools import product\nfrom random import Random\n\nMASK32 = (1 << 32) - 1\n\ndef check_slice(width, x, y, borrow_in):\n    mask = (1 << width) - 1\n    generate, propagate = x < y, x == y\n    candidate = x + (~y & mask) if borrow_in else x - y\n    diff = x - y - borrow_in\n    assert candidate & mask == diff & mask\n    assert (generate or (propagate and borrow_in)) == (diff < 0)\n\nfor width in (2, 8):\n    for x, y, borrow_in in product(range(1 << width), range(1 << width), [0, 1]):\n        check_slice(width, x, y, borrow_in)\n\ndef borrow_lookahead(generate, propagate, upper):\n    return any(generate[lower] and all(propagate[lower + 1:upper]) for lower in range(upper))\n\ndef trial(x, y):\n    x_slice = [(x >> shift) & mask for shift, mask in zip(range(0, 40, 8), [255]*4+[3])]\n    y_slice = [(y >> shift) & mask for shift, mask in zip(range(0, 40, 8), [255]*4+[3])]\n    gen = [a < b for a, b in zip(x_slice, y_slice)]\n    prop = [a == b for a, b in zip(x_slice, y_slice)]\n    adjusted = [(a + (~b & 255) if borrow_lookahead(gen, prop, i) else a - b) & 255\n                for i, (a, b) in enumerate(zip(x_slice[:4], y_slice[:4]))]\n    return sum(byte << (8 * i) for i, byte in enumerate(adjusted)), borrow_lookahead(gen, prop, 5)\n\nedges = sorted({0, 1, (1 << 34) - 1} | {number for bit in range(8, 34, 8) for number in [(1 << bit) - 1, 1 << bit, (1 << bit) + 1]})\nfor x, y in product(edges, repeat=2):\n    assert trial(x, y) == ((x-y) & MASK32, x < y)\nrng = Random(20261122)\nfor i in range(50_000):\n    x, y = rng.getrandbits(34), rng.getrandbits(34)\n    if i % 2:\n        # Keep the upper 1–4 slices equal to exercise borrow propagation.\n        boundary = rng.choice([8, 16, 24, 32])\n        mask = (1 << boundary) - 1\n        y = (x & ~mask) | (y & mask)\n    assert trial(x, y) == ((x-y) & MASK32, x < y)\nprint('The sliced subtraction model matched full-width subtraction on exhaustive local slices, boundaries, and 50,000 full-width samples.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport json\nfrom pathlib import Path\nfrom jsonschema import Draft7Validator\nimport yaml\n\nbench = Path('cores/bench')\npath = bench / 'experiments/hypotheses/hyp-20261122-001-r6s0.yaml'\nhypothesis = yaml.safe_load(path.read_text())\nschema = json.loads(Path('schemas/hypothesis.schema.json').read_text())\nDraft7Validator(schema).validate(hypothesis)\nassert hypothesis['id'] == path.stem\nassert hypothesis['category'] == 'micro_opt'\nimpact = hypothesis['expected_impact']['fitness_delta_pct']\nassert type(impact) is int and -50 <= impact <= 50\nfor change in hypothesis['changes']:\n    assert (bench / change['file']).is_file(), change['file']\nprint(f'Schema and target paths validated for {path}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
