{"type": "item.started", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport shutil\n\ns = Path(os.environ['TMPDIR'])/'r10s0'\nsrc = (s/'radix16/cores/bench/rtl/divider.sv').read_text()\nchampion = Path('cores/bench/rtl/divider.sv').read_text()\n\ndef variant(name, spec):\n    dest = s/name/'cores/bench'\n    shutil.copytree(Path('cores/bench/rtl'),dest/'rtl')\n    (dest/'rtl/divider.sv').write_text(spec)\n\nfor name, lo, src_div in [('radix4-shortborrow', 11, champion), ('radix4-halfborrow', 7, champion)]:\n    i = src_div.index(\\\"    /* verilator lint_off UNUSEDSIGNAL */\\\\n    logic [13:0] diff1\\\")\n    j = src_div.index(\\\"      use3\\\",i)\n    src_div = src_div[:i]+f\\\"\\\"\\\"    logic [10:0] diff1, diff2, diff3;\n    logic b1, b2, b3;\n    logic use0, use1, use2, use3;\n    logic [10:0] next_remainder;\n    logic [12:0] m1, m2;\n    logic [{lo}:0] low1, low2, low3;\n    begin\n      m1 = {{2'b0, divisor}};\n      m2 = {{1'b0, divisor, 1'b0}};\n      low1 = {{1'b0, partial_dividend[{lo-1}:0]}} - {{1'b0, m1[{lo-1}:0]}};\n      low2 = {{1'b0, partial_dividend[{lo-1}:0]}} - {{1'b0, m2[{lo-1}:0]}};\n      low3 = {{1'b0, partial_dividend[{lo-1}:0]}} - {{1'b0, three_divisor[{lo-1}:0]}};\n      b1 = partial_dividend[12:{lo}] < m1[12:{lo}] ||\n          (partial_dividend[12:{lo}] == m1[12:{lo}] && low1[{lo}]);\n      b2 = partial_dividend[12:{lo}] < m2[12:{lo}] ||\n          (partial_dividend[12:{lo}] == m2[12:{lo}] && low2[{lo}]);\n      b3 = partial_dividend[12:{lo}] < three_divisor[12:{lo}] ||\n          (partial_dividend[12:{lo}] == three_divisor[12:{lo}] && low3[{lo}]);\n\\\"\\\"\\\"+src_div[j:]\n    for k, term in [(1,'m1'),(2,'m2'),(3,'three_divisor')]:\n        i = src_div.index('      use3')\n        if lo == 11:\n            line = f'      diff{k} = low{k}[10:0];\\\\n'\n        else:\n            line = f\\\"      diff{k} = {{partial_dividend[10:{lo}] - {term}[10:{lo}] - {{{10-lo}'b0, low{k}[{lo}]}}, low{k}[{lo-1}:0]}};\\\\n\\\"\n        src_div = src_div[:i]+line+src_div[i:]\n        src_div = src_div.replace(f'diff{k}[13]',f'b{k}').replace(f'diff{k}[10:0]',f'diff{k}')\n    variant(name,src_div)\n\n# Precompute a direct signed comparison operand for each odd multiple.\nneg = src.replace(\\\"  assign narrow_multiple[1] = {4'b0, divisor_q[10:0]};\\\\n\\\"\n                  \\\"  assign narrow_multiple[3] = three_divisor_q[14:0];\\\\n\\\", \\\"\\\")\nneg = neg.replace(\\\"narrow_multiple_q [5:15]\\\", \\\"narrow_multiple_q [1:15]\\\").replace(\\\"k = 2; k <= 15; k++\\\", \\\"k = 1; k <= 15; k++\\\")\nneg = neg.replace(\\\"narrow_multiple[k/2] << 1\\\", \\\"(narrow_multiple[k/2] << 1) | 15'd1\\\")\nneg = neg.replace(\\\"end else if (k >= 5) begin : gen_odd\\\", \\\"end else begin : gen_odd\\\")\ni = neg.index(\\\"          case (k)\\\")\nj = neg.index(\\\"          endcase\\\",i)+len(\\\"          endcase\\\")\nlines = [\\\"          case (k)\\\", \\\"            1: narrow_multiple_q[k] <= ~narrow_d;\\\", \\\"            3: narrow_multiple_q[k] <= ~((narrow_d << 1) + narrow_d);\\\"]\nfor line in neg[i:j].splitlines()[1:-1]:\n    lhs,rhs=line.rstrip(';').split(' <= ')\n    lines.append(f\\\"{lhs} <= ~({rhs});\\\")\nlines.append(\\\"          endcase\\\")\nneg = neg[:i]+\\\"\\\\n\\\".join(lines)+neg[j:]\nneg = neg.replace(\\\"wire [15:0] difference = {1'b0, narrow_trial} - {1'b0, narrow_multiple[k]};\\\",\n                  \\\"wire [16:0] difference = {1'b0, narrow_trial, 1'b1} + {1'b1, narrow_multiple[k], 1'b1};\\\")\nneg = neg.replace(\\\"= difference[10:0];\\\\n    assign narrow_borrow[k] = difference[15];\\\",\n                  \\\"= difference[11:1];\\\\n    assign narrow_borrow[k] = difference[16];\\\")\nvariant('radix16-complement', neg)\n\n# Change only the narrow trial bank. Hold its last result in a registered\n# one-hot bank, then apply the same mux while preparing the next trial.\nret = src.replace(\\\"  logic [10:0] narrow_remainder;\\\", \\\"\\\"\\\"  logic [10:0] narrow_remainder;\n  logic [10:0] narrow_difference_q [0:15];\n  logic [15:0] narrow_select_q;\n  logic [3:0] narrow_prefix_q;\n  logic narrow_from_prefix_q;\\\"\\\"\\\")\nret = ret.replace(\\\"  assign narrow_trial = {remainder_q[10:0], quotient_q[31:28]};\\\",\n                  \\\"  assign narrow_trial = {narrow_remainder, quotient_q[31:28]};\\\")\nret = ret.replace('assign bit_candidates[k] = narrow_select[k] && narrow_difference[k][i];',\n                  'assign bit_candidates[k] = narrow_select_q[k] && narrow_difference_q[k][i];')\nret = ret.replace('assign narrow_remainder[i] = |bit_candidates;',\n                  \\\"assign narrow_remainder[i] = narrow_from_prefix_q ? (i < 4 ? narrow_prefix_q[i%4] : 1'b0) : |bit_candidates;\\\")\ni = ret.index(\\\"  logic [34:0] multiples\\\")\nret = ret[:i]+\\\"\\\"\\\"  always_ff @(posedge clock) begin\n    if (reset) begin\n      narrow_from_prefix_q <= 1'b1;\n      narrow_prefix_q <= '0;\n      narrow_select_q <= '0;\n    end else if (initializing) begin\n      narrow_from_prefix_q <= 1'b1;\n      narrow_prefix_q <= nibble_divisor ? prefix_remainder : a_magnitude[31:28];\n    end else if (counting_down) begin\n      narrow_from_prefix_q <= 1'b0;\n      narrow_select_q <= narrow_select;\n      for (int k = 0; k < 16; k++)\n        narrow_difference_q[k] <= narrow_difference[k];\n    end\n  end\n\n\\\"\\\"\\\"+ret[i:]\nret = ret.replace(\\\"        remainder_q <= {28'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\\\\n\\\",\\\"\\\")\nret = ret.replace(\\\"        remainder_q <= {21'b0, narrow_remainder};\\\\n\\\",\\\"\\\")\nret = ret.replace(\\\"want_remainder_q ? remainder_q : quotient_q\\\",\\\"want_remainder_q ? (narrow_q ? {21'b0, narrow_remainder} : remainder_q) : quotient_q\\\")\nvariant('radix16-retime', ret)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
