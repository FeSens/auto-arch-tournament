{"type": "item.completed", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/merge_variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\norig = (base / 'alu.sv').read_text()\nbegin = orig.index('  assign out =')\nrest_begin = orig.index('({32{sel.and_op}}')\nrest = orig[rest_begin:orig.index(';', rest_begin)]\nfor name, finish in [\n    ('alu_merge_add', 'sel.add ? sum : (other | ({32{sel.sub}} & difference))'),\n    ('alu_merge_as', 'sel.add ? sum : sel.sub ? difference : other'),\n    ('alu_merge_as_par', '({32{sel.add}} & sum) | ({32{sel.sub}} & difference) | other'),\n    ('alu_merge_arith', '(sel.add || sel.sub) ? (sel.sub ? difference : sum) : other'),\n    ('alu_merge_invert', '(sel.add || sel.sub) ? (sum \"'^ {32{sel.sub}}) : other'\"'),\n]:\n    p = scratch / name\n    shutil.copytree(base, p)\n    alu = p/'alu.sv'\n    result = orig[:begin] + f'''\n  logic [31:0] sum, difference;\n  (* syn_keep = 1 *) logic [31:0] other;\n  assign sum = {'(a \"'^ {32{sel.sub}})'\"' if name.endswith('invert') else 'a'} + b;\n  assign difference = a - b;\n  assign other = {rest};\n  assign out = {finish};\nendmodule\n'''\n    alu.write_text(result)\nfor name, copies in [('fwd_duplicate_ex', ['ex']), ('fwd_duplicate_wb', ['wb']), ('fwd_duplicate_both', ['ex','wb'])]:\n    p = scratch / name\n    shutil.copytree(base, p)\n\n    f = p/'ex_stage.sv'\n    s = f.read_text()\n    lines = []\n    for t in copies:\n        data_orig = 'fwd_ex_mem' if t == 'ex' else 'fwd_mem_wb'\n        rx = next(l for l in s.splitlines() if l.strip().startswith('input') and f'{data_orig},' in l)\n        s = s.replace(rx, rx + f'\\\\n  input  logic [31:0]        fwd_{t}_rs2,')\n        left = s.index('  assign rs2 =')\n        right = s.index(';', left)\n        s = s[:left] + s[left:right].replace(data_orig, f'fwd_{t}_rs2') + s[right:]\n    if 'ex' in copies:\n        s = s.replace('  output ex_mem_t  out,', '  output ex_mem_t  out,\\\\n  output logic [31:0] fwd_copy,')\n        s = s.replace('  assign out = reg_q;', \\\"\\\"\\\"  (* syn_preserve = 1, syn_keep = 1 *) logic [31:0] result_copy_q;\n  always_ff @(posedge clock) begin\n    if (reset) result_copy_q <= '0;\n    else if (\"'!stall) result_copy_q <= ex_result;\n  end\n  assign fwd_copy = result_copy_q;\n  assign out = reg_q;\"\"\")\n    f.write_text(s)\n    if '\"'wb' in copies:\n        f = p/'mem_stage.sv'\n        s = f.read_text().replace('  output mem_wb_t  out', '  output mem_wb_t  out,\\\\n  output logic [31:0] fwd_copy')\n        s = s.replace('  assign out = reg_q;', \\\"\\\"\\\"  (* syn_preserve = 1, syn_keep = 1 *) logic [31:0] result_copy_q;\n  always_ff @(posedge clock) begin\n    if (reset) result_copy_q <= '0;\n    else if (\"'!recovery && !hold_wb) result_copy_q <= wb_result;\n  end\n  assign fwd_copy = result_copy_q;\n  assign out = reg_q;\"\"\")\n        f.write_text(s)\n    f = p/'\"'core.sv'\n    s = f.read_text()\n    for t in copies:\n        c = 'fwd_ex_mem' if t == 'ex' else 'fwd_mem_wb'\n        match = next(l for l in s.splitlines() if l.strip().startswith(f'.{c} '))\n        s = s.replace(match, match + f'\\\\n    .fwd_{t}_rs2 (copy_{t}),')\n        pos = s.index('    .out ', s.index(f'  {\\\"ex_stage u_ex\\\" if t==\\\"ex\\\" else \\\"mem_stage u_mem\\\"}'))\n        s = s[:pos] + f'    .fwd_copy (copy_{t}),\\\\n' + s[pos:]\n    s = s.replace('  // ── Inter-stage wires', ''.join(f'  logic [31:0] copy_{t};\\\\n' for t in copies) + '  // ── Inter-stage wires')\n    f.write_text(s)\nPY\npython /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/merge_variants.py\npython -u /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/time_variants.py alu_merge_add:1 alu_merge_as:1 alu_merge_as_par:1 alu_merge_arith:1 alu_merge_invert:1 fwd_duplicate_ex:1 fwd_duplicate_wb:1 fwd_duplicate_both:1\"", "aggregated_output": "alu