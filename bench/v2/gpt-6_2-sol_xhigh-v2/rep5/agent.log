logic [14:0] nine', 'logic [15:0] nine')\n    t = t.replace('logic [14:0] narrow_divisor_value;', 'logic [15:0] narrow_divisor_value;')\n    t = t.replace('logic [34:0] multiples', 'logic [35:0] multiples')\n    t = t.replace(\\\"  assign multiples[1] = {3'b0, divisor_q};\\\\n  assign multiples[2] = {2'b0, divisor_q, 1'b0};\\\",\n                  \\\"\\\"\\\"  logic divisor_zero_q;\n  always_ff @(posedge clock)\n    if (initializing) divisor_zero_q <= divisor_zero;\n\n  assign multiples[1] = {{4{\"'!divisor_zero_q}}, divisor_q};\n  assign multiples[2] = multiples[1] << 1;\"\"\")\n    t = t.replace(\"assign multiples[4] = {1'\"'b0, divisor_q, 2'b0};\\\", \\\"assign multiples[4] = multiples[1] << 2;\\\")\n    t = t.replace(\\\"logic [14:0] narrow_dividend, narrow_multiples [1:15];\\\", \\\"logic [14:0] narrow_dividend;\\\\n  logic [15:0] narrow_multiples [1:15];\\\")\n    t = t.replace(\\\"assign narrow_divisor_value = {4'b0, b_magnitude[10:0]};\\\", \\\"assign narrow_divisor_value = {5'b11111, b_magnitude[10:0]};\\\")\n    t = t.replace(\\\"= multiples[digit][14:0];\\\", \\\"= multiples[digit][15:0];\\\")\n    t = t.replace(\\\"{1'b0, narrow_dividend} - {1'b0, narrow_multiples[digit]}\\\", \\\"{1'b0, narrow_dividend} + narrow_multiples[digit]\\\")\n    t = t.replace(\\\"{1'b0, partial_dividend} - {1'b0, multiples[digit][31:0]}\\\", \\\"{1'b0, partial_dividend} + multiples[digit][32:0]\\\")\n    t = t.replace(\\\"difference[32] || |multiples[digit][34:32]\\\", \\\"difference[32] || (\"'!divisor_zero_q && !(&multiples[digit][35:32]))\")\n    return t.replace('\"'b_magnitude','negative_magnitude')\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('variants', nargs='+')\n    parser.add_argument('--options', type=int, nargs='+', default=[1])\n    args = parser.parse_args()\n    for name in args.variants:\n        variant = scratch / name / 'rtl'\n        shutil.copytree(source, variant, dirs_exist_ok=True)\n        t = text\n        if 'neg'