]\n    last_accepts = 0\n\n    async def count_last_accepts():\n        nonlocal last_accepts\n        while True:\n            await FallingEdge(dut.clock)\n            if int(dut.io_imemAddr.value) == last and int(dut.u_if.accept_response.value):\n                last_accepts += 1\n\n    def dmem_ready(addr, ren, wen):\n        if ren or wen:\n            requests.append((addr, ren, wen))\n        return len(requests) >= 4\n\n    def imem_ready(addr):\n        assert addr <= last\n        fetches.append(addr)\n        return True\n\n    monitor = cocotb.start_soon(count_last_accepts())\n    rets, dmem = await _run(dut, program, dmem_ready=dmem_ready, imem_ready=imem_ready)\n    monitor.cancel()\n    assert last_accepts == 1\n    expected_pcs = [0, store_pc, branch_pc, target]\n    if not older_redirect:\n        expected_pcs.insert(2, last - 4)\n    assert [r[\"pc\"] for r in rets] == expected_pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == expected_pcs[1:]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert requests == [(0x40, 0, 0xF)] * 4\n    assert dmem == {0x40: 0}\n    held_cycles = 4 if older_redirect else 5\n38:        .io_imemReady       (1'b1),\n","exit_code":0,"status":"completed"}}
