{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport shutil\nfrom pathlib import Path\nscratch = Path('/srv/hwebench/tmp/7c172beb/26de4279/radix16.GwU4WK')\nsrc = Path('cores/bench')\nrtl = scratch / 'cores/bench/rtl'\nshutil.copytree(src / 'rtl', rtl)\nshutil.copytree(src / 'test', scratch / 'cores/bench/test')\nshutil.copy2(src / 'core.yaml', scratch / 'cores/bench/core.yaml')\nfor directory in ('fpga', 'bench', 'test'):\n    shutil.copytree(directory, scratch / directory, ignore=shutil.ignore_patterns('*.elf', '__pycache__'))\nshutil.copy2('Makefile', scratch / 'Makefile')\npath = rtl / 'divider.sv'\ns = path.read_text()\ns = s.replace('logic [33:0] three_divisor_q;', 'logic [9:0] prefix_three_q;\\\\n  logic [35:0] odd_multiple_q [0:7];')\nfirst = s.index('  // Take one radix-4 digit.')\nlast = s.index('  always_ff @(posedge clock) begin', first)\ns = s[:first] + '''  function automatic [9:0] prefix8_step (\n    input logic [7:0] x,\n    input logic [7:0] d,\n    input logic [9:0] d3\n  );\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [10:0] diff1, diff2, diff3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic use0, use1, use2, use3;\n    logic [7:0] r;\n    begin\n      diff1 = {3'b0, x} - {3'b0, d};\n      diff2 = {3'b0, x} - {2'b0, d, 1'b0};\n      diff3 = {3'b0, x} - {1'b0, d3};\n      use3 = \"'!diff3[10];\n      use2 = diff3[10] && !diff2[10];\n      use1 = diff2[10] && !diff1[10];\n      use0 = diff1[10];\n      r = ({8{use3}} & diff3[7:0]) | ({8{use2}} & diff2[7:0])\n        | ({8{use1}} & diff1[7:0]) | ({8{use0}} & x);\n      prefix8_step = {use3 || use2, use3 || use1, r};\n    end\n  endfunction\n\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [9:0] prefix8_first;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [9:0] prefix8_second;\n  assign prefix8_first = prefix8_step({2'\"'b0, remainder_q[3:0], quotient_q[31:30]},\n                                      divisor_q[7:0], prefix_three_q);\n  assign prefix8_second = prefix8_step({prefix8_first[5:0], quotient_q[29:28]},\n                                       divisor_q[7:0], prefix_three_q);\n\n  function automatic [35:0] sum_three (\n    input logic [35:0] x,\n    input logic [35:0] y,\n    input logic [35:0] z\n  );\n    sum_three = (x \"'^ y ''^ z) + (((x & y) | (x & z) | (y & z)) << 1);\n  endfunction\n\n  logic [35:0] d;\n  assign d = {4'\"'b0, divisor_q};\n\n  always_ff @(posedge clock) begin\n    if (phase_q == 4'd8) begin\n      odd_multiple_q[0] <= d;\n      odd_multiple_q[1] <= (d << 1) + d;\n      odd_multiple_q[2] <= (d << 2) + d;\n      odd_multiple_q[3] <= (d << 3) - d;\n      odd_multiple_q[4] <= (d << 3) + d;\n      odd_multiple_q[5] <= sum_three(d << 3, d << 1, d);\n      odd_multiple_q[6] <= sum_three(d << 3, d << 2, d);\n      odd_multiple_q[7] <= (d << 4) - d;\n    end\n  end\n\n  logic [35:0] x;\n  logic [14:0] borrow;\n  logic [15:0] use_digit;\n  logic [31:0] trial [0:15];\n  logic [31:0] round_r;\n  logic [3:0] round_q;\n\n  assign x = {remainder_q, quotient_q[31:28]};\n  assign trial[0] = x[31:0];\n  assign use_digit[0] = borrow[0];\n  assign use_digit[15] = \"'!borrow[14];\n\n  for (genvar digit = 1; digit < 16; digit++) begin : gen_trial\n    localparam int SHIFT = digit % 2 ? 0 : digit % 4 ? 1 : digit % 8 ? 2 : 3;\n    localparam int ODD = digit >> SHIFT;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [36:0] diff;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign diff = {1'\"'b0, x} - {1'b0, odd_multiple_q[ODD / 2] << SHIFT};\n    assign borrow[digit-1] = diff[36];\n    assign trial[digit] = diff[31:0];\n    if (digit < 15) begin : gen_select\n      assign use_digit[digit] = \"'!borrow[digit-1] && borrow[digit];\n    end\n  end\n\n  always_comb begin\n    round_r = '\"'0;\n    round_q = '0;\n    for (int i = 0; i < 16; i++) begin\n      round_r = round_r | ({32{use_digit[i]}} & trial[i]);\n      round_q = round_q | ({4{use_digit[i]}} & 4'(i));\n    end\n  end\n\n''' + s[last:]\ns = s.replace(\\\"three_divisor_q   <= '0;\\\", \\\"prefix_three_q    <= '0;\\\")\ns = s.replace(\\\"three_divisor_q   <= {2'b0, b_magnitude} + {1'b0, b_magnitude, 1'b0};\\\",\n              \\\"prefix_three_q    <= {2'b0, b_magnitude[7:0]} + {1'b0, b_magnitude[7:0], 1'b0};\\\")\ns = s.replace('''    end else if (counting_down) begin\n      remainder_q <= step2[31:0];\n      quotient_q  <= {quotient_q[27:0], step1[33:32], step2[33:32]};\n''', '''    end else if (phase_q == 4'd8) begin\n      if (|divisor_q[31:8]) begin\n        remainder_q <= {24'b0, remainder_q[3:0], quotient_q[31:28]};\n        quotient_q  <= {quotient_q[27:0], 4'b0};\n      end else begin\n        remainder_q <= {24'b0, prefix8_second[7:0]};\n        quotient_q  <= {quotient_q[27:0], prefix8_first[9:8], prefix8_second[9:8]};\n      end\n    end else if (counting_down) begin\n      remainder_q <= round_r;\n      quotient_q  <= {quotient_q[27:0], round_q};\n''')\npath.write_text(s)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
