up[3] ? less_group[2] : less_group[3])'\n    else:\n        msb=groups-1\n        unsigned=f'less_group[{msb}]'\n        for ix in reversed(range(msb)):\n            unsigned+=f'\\\\n                   || ((&equal_group[{msb}:{ix+1}]) && less_group[{ix}])'\n    if mode=='xor':\n        replacement+='  logic unsigned_less;\\\\n  assign unsigned_less = '+unsigned+';\\\\n'\n        replacement+='  assign less_than = unsigned_less \"'^ (signed_compare && (rs1[31] ''^ rs2[31]));'\"\\\\n'\n    else:\n        replacement+='  assign less_than = '+unsigned+';\\\\n'\n    replacement+='  assign branch_cond = (in.ctrl.branch_op[2] ? less_than : &equal_group) \"'^ in.ctrl.branch_op[0];'\"\\\\n\\\\n'\n    rtl=rtl[:a]+replacement+rtl[b:]\n    if mode=='miss':\n        rtl=rtl.replace('  assign redirect       = advance && (resolved_taken \"'!= in.predicted_taken);'\"', '''  logic direct_taken_miss, direct_linear_miss, jalr_miss;\n  assign direct_taken_miss = \"'!in.predicted_taken && !in.direct_target[1] &&\n                             (in.ctrl.is_branch || (in.ctrl.is_jump && !in.ctrl.is_jalr));\n  assign direct_linear_miss = in.predicted_taken && in.ctrl.is_branch;\n  assign jalr_miss = in.ctrl.is_jalr && !jalr_sum[1];\n  assign redirect = advance &&\n                    ((direct_taken_miss && (branch_cond || in.ctrl.is_jump)) ||\n                     (direct_linear_miss && !branch_cond) || jalr_miss);'\"''')\n    path.write_text(rtl)\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
