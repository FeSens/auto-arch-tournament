{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c 'profile_dir=\"$TMPDIR/bench-r10-profile.Jp85SQ\"; sed -n '\"'55,118p' \\\"\"'$profile_dir/rtl3/mem_stage.sv\"; date -u'","aggregated_output":"  logic [15:0] hword_val;\n  logic [31:0] load_data;\n\n  // Misaligned mem-access trap. RV32I requires word-aligned LW/SW and\n  // halfword-aligned LH/LHU/SH; byte ops are always aligned.\n  // riscv-formal's RISCV_FORMAL_ALIGNED_MEM contract demands rvfi_trap=1\n  // when the effective byte address is not aligned to the access width.\n  // On trap, the dmem ports are gated off and ctrl propagates is_illegal.\n  logic mem_misalign;\n  logic mem_op;\n  ctrl_t ctrl_with_trap;\n  mem_wb_t reg_q;\n  logic [31:0] late_a, late_b, late_alu_b, late_alu_result;\n  logic late_cond, late_resolved_taken, late_misalign;\n  logic [31:0] late_pc_plus_4, late_pc_next;\n\n  assign late_a = in.late_rs1 ? reg_q.result : in.rs1_val;\n  assign late_b = in.late_rs2 ? reg_q.result : in.rs2_val;\n  assign late_alu_b = in.ctrl.alu_src ? in.imm : late_b;\n  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_ADD: late_alu_result = late_a + late_alu_b;\n      ALU_SUB: late_alu_result = late_a - late_alu_b;\n      ALU_AND: late_alu_result = late_a & late_alu_b;\n      ALU_OR: late_alu_result = late_a | late_alu_b;\n      ALU_XOR: late_alu_result = late_a ^ late_alu_b;\n      default: late_alu_result = '0;\n    endcase\n  end\n\n  logic late_eq, wb_lt, late_lt, same_sign;\n  logic [31:0] wb_operand;\n  assign wb_operand = reg_q.result;\n\n  logic [3:0] cmp_eq, cmp_lt;\n  assign cmp_eq[3] = wb_operand[30:24] == in.branch_known[30:24];\n  assign cmp_lt[3] = wb_operand[30:24] < in.branch_known[30:24];\n  for (genvar n=0; n<3; n++) begin : gen_cmp\n    assign cmp_eq[n] = wb_operand[n*8 +: 8] == in.branch_known[n*8 +: 8];\n    assign cmp_lt[n] = wb_operand[n*8 +: 8] < in.branch_known[n*8 +: 8];\n  end\n  logic unsigned_low_lt;\n  assign unsigned_low_lt = cmp_lt[3]\n                        || (cmp_eq[3] && cmp_lt[2])\n                        || (&cmp_eq[3:2] && cmp_lt[1])\n                        || (&cmp_eq[3:1] && cmp_lt[0]);\n\n  assign same_sign = wb_operand[31] == in.branch_known[31];\n  assign late_eq = same_sign && (&cmp_eq);\n  assign wb_lt = same_sign ? unsigned_low_lt : wb_operand[31] ^ in.ctrl.branch_op[1];\n  assign late_lt = in.late_rs1 ? wb_lt : !(wb_lt || late_eq);\n  always_comb begin\n    case ({in.late_rs1, in.late_rs2})\n      2'b00: late_cond = in.branch_fallback;\n      2'b11: late_cond = !in.ctrl.branch_op[2] ^ in.ctrl.branch_op[0];\n      default: late_cond = (in.ctrl.branch_op[2] ? late_lt : late_eq) ^ in.ctrl.branch_op[0];\n    endcase\n  end\n\n  assign late_train = in.valid && in.deferred && in.ctrl.is_branch;\n  assign late_taken = late_cond;\n  assign late_aperture = late_train && in.holds_fetch;\n  assign late_resolved_taken = late_cond && !in.direct_target[1];\n  assign late_misalign = late_train && late_cond && in.direct_target[1];\nSun Nov 22 11:06:14 UTC 2026\n","exit_code":0,"status":"completed"}}
