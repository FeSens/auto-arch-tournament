{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport os, shutil\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom tools.eval import gowin\n\nroot = Path(os.environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold = Path.cwd() / \\\"cores/bench/rtl\\\"\nvariants = {\n    \\\"branch16\\\": (16, False, False, gold),\n    \\\"branch8\\\": (8, False, False, gold),\n    \\\"early_redirect\\\": (0, True, False, gold),\n    \\\"branch8_redirect\\\": (8, True, False, gold),\n    \\\"branch8_redirect_select\\\": (8, True, False, root / \\\"early_link\\\" / \\\"rtl\\\"),\n    \\\"branch8_redirect_addr\\\": (8, True, True, gold),\n}\nfor v, (width, redirect, addr, base) in variants.items():\n    rtl = root / v / \\\"rtl\\\"\n    shutil.copytree(base, rtl)\n    path = rtl / \\\"ex_stage.sv\\\"; txt = path.read_text()\n    if width:\n        n=32//width\n        cmp = f\\\"\\\"\\\"  logic [{n-1}:0] less, equal;\n  logic unsigned_less, signed_less, ordered_less;\n\n  for (genvar i = 0; i < {n}; i++) begin : gen_compare\n    assign less[i] = rs1[{width}*i +: {width}] < rs2[{width}*i +: {width}];\n    assign equal[i] = rs1[{width}*i +: {width}] == rs2[{width}*i +: {width}];\n  end\n  assign unsigned_less = \\\"\\\"\\\"\n        cmp += \\\" | \\\".join(f\\\"(less[{i}] && (&equal[{n-1}:{i+1}]))\\\" if i < n-1 else f\\\"less[{i}]\\\" for i in range(n-1,-1,-1)) + \\\";\\\\n\\\"\n        cmp += \\\"\\\"\\\"  assign signed_less = (rs1[31] == rs2[31]) ? unsigned_less : rs1[31];\n  assign ordered_less = in.ctrl.branch_op[1] ? unsigned_less : signed_less;\n  assign branch_cond = in.ctrl.branch_op[0] \"'^\n                       (in.ctrl.branch_op[2] ? ordered_less : (&equal));\n\"\"\"\n        start = txt.index(\"  always_comb begin'\"\\\\n    case (in.ctrl.branch_op)\\\")\n        end = txt.index(\\\"  assign jalr_sum\\\", start)\n        txt=txt[:start]+cmp+\\\"\\\\n\\\"+txt[end:]\n    if redirect:\n        pp=rtl/\\\"core_pkg.sv\\\"; t=pp.read_text()\n        index=t.index(\\\"  // ID/EX register payload.\\\")\n        t=t[:index]+t[index:].replace(\\\"    logic [31:0] direct_target;\\\",\\\"    logic [31:0] direct_target;\\\\n    logic [31:2] recovery_word;\\\",1)\n        pp.write_text(t)\n        pp=rtl/\\\"id_stage.sv\\\"; t=pp.read_text()\n        t=t.replace(\\\"      reg_q.direct_target    <= in.direct_target;\\\",\n                    \\\"      reg_q.direct_target    <= in.direct_target;\\\\n      reg_q.recovery_word    <= in.predicted_taken ? in.pc[31:2] + 30'd1 : in.direct_target[31:2];\\\")\n        pp.write_text(t)\n        txt=txt.replace(\\\"assign redirect_word  = pc_next[31:2];\\\",\n                        \\\"assign redirect_word  = in.ctrl.is_jalr ? jalr_sum[31:2] : in.recovery_word;\\\")\n    if addr:\n        txt=txt.replace(\\\"assign jalr_sum = rs1 + in.imm;\\\", \\\"assign jalr_sum = {addr_hi, addr_lo[11:0]};\\\")\n    path.write_text(txt)\n\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\",\n                n, root / v / f\\\"gowin_p{n}\\\"): (v, n)\n            for n in (0,) for v in variants}\n    for job in as_completed(jobs):\n        v,n = jobs[job]\n        res = job.result()\n        print(v,n,\\\"Fmax\\\",res.get(\\\"fmax_mhz\\\"),\\\"logic\\\",res.get(\\\"logic\\\"),res.get(\\\"reason\\\", \\\"\\\"))\n        for path in res.get(\\\"critical_paths\\\", [])[:2]:\n            print(\\\" \\\",path)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport os, shutil\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom tools.eval import gowin\n\nroot = Path(os.environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold = Path.cwd() / \\\"cores/bench/rtl\\\"\nvariants = [\\\"local_forward\\\", \\\"alu_forward\\\", \\\"local_alu_forward\\\"]\nfor variant in variants:\n    rtl = root / variant / \\\"rtl\\\"\n    shutil.copytree(gold, rtl)\n    early_local = variant \"'!= \"alu_forward\"\n    early_alu = variant != \"local_forward\"\n    if early_alu:\n        p=rtl/\"core_pkg.sv\"; t=p.read_text()\n        t=t.replace(\"    logic [31:0] wb_value;\", \"\"\"    logic [31:0] alu_a_local;\n    logic [31:0] alu_b_local;\n    logic alu_a_ex_mem, alu_a_mem_wb, alu_b_ex_mem, alu_b_mem_wb;\n    logic [31:0] wb_value;\"\"\")\n        p.write_text(t)\n    p=rtl/\"id_stage.sv\"; t=p.read_text()\n    for k in (1,2):\n        src=f\"rs{k}_sel\"\n        c = f\"{{32{{{src}.wb}}}} & wb_value\"\n        d = f\"{{32{{{src}.reg_file}}}} & rs{k}_data\"\n        if early_local:\n            t = t.replace(f\"reg_q.rs{k}_val          <= rs{k}_data;\", f\"reg_q.rs{k}_val          <= ({c}) | ({d});\")\n        if early_alu:\n            ctrl = \"dec_is_auipc\" if k==1 else \"dec_alu_src\"\n            override = \"in.pc\" if k==1 else \"imm\"\n            operand = \"a\" if k==1 else \"b\"\n            update = f\"\"\"      reg_q.alu_{operand}_local <= ({{32{{{ctrl}}}}} & {override}) |\n                              ({{32{{!{ctrl} && {src}.wb}}}} & wb_value) |\n                              ({{32{{!{ctrl} && {src}.reg_file}}}} & rs{k}_data);\n      reg_q.alu_{operand}_ex_mem <= !{ctrl} && {src}.ex_mem;\n      reg_q.alu_{operand}_mem_wb <= !{ctrl} && {src}.mem_wb;\n\"\"\"\n            t = t.replace(\"      reg_q.imm\",update+\"      reg_q.imm\")\n    if early_local:\n        t=t.replace(\"      reg_q.wb_value         <= wb_value;'\"\\\\n\\\",\\\"\\\")\n        p2=rtl/\\\"core_pkg.sv\\\"\n        t2=p2.read_text().replace(\\\"    logic [31:0] wb_value;      // shared WB collision data\\\\n\\\",\\\"\\\")\n        p2.write_text(t2)\n    p.write_text(t)\n    p=rtl/\\\"ex_stage.sv\\\"; t=p.read_text()\n    if early_local:\n        for k in (1,2):\n            t=t.replace(f\\\"\\\"\\\"             | ({{32{{in.rs{k}_sel.wb}}}}       & in.wb_value)\n             | ({{32{{in.rs{k}_sel.reg_file}}}} & in.rs{k}_val);\\\"\\\"\\\", f\\\"             | in.rs{k}_val;\\\")\n    if early_alu:\n        t=t.replace(\\\"\\\"\\\"  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\\\"\\\"\\\", \\\"\\\"\\\"  assign alu_a = ({32{in.alu_a_ex_mem}} & fwd_ex_mem)\n               | ({32{in.alu_a_mem_wb}} & fwd_mem_wb)\n               | in.alu_a_local;\n  assign alu_b = ({32{in.alu_b_ex_mem}} & fwd_ex_mem)\n               | ({32{in.alu_b_mem_wb}} & fwd_mem_wb)\n               | in.alu_b_local;\\\"\\\"\\\")\n    p.write_text(t)\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\",\n                n, root / v / f\\\"gowin_p{n}\\\"): (v, n)\n            for n in (0,) for v in variants}\n    for job in as_completed(jobs):\n        v,n = jobs[job]\n        res = job.result()\n        print(v,n,\\\"Fmax\\\",res.get(\\\"fmax_mhz\\\"),\\\"logic\\\",res.get(\\\"logic\\\"),res.get(\\\"reason\\\", \\\"\\\"))\n        for path in res.get(\\\"critical_paths\\\", [])[:2]:\n            print(\\\" \\\",path)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
