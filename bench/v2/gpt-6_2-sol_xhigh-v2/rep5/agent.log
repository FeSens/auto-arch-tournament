{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport os, shutil\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom tools.eval import gowin\n\nroot = Path(os.environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold = Path.cwd() / \\\"cores/bench/rtl\\\"\nvariants = {\n    \\\"radix16\\\": (gold, False),\n    \\\"radix16_group\\\": (gold, True),\n    \\\"radix16_recovery\\\": (root / \\\"early_redirect/rtl\\\", False),\n    \\\"radix16_group_select\\\": (root / \\\"branch8_redirect_select/rtl\\\", True)\n}\nfor v,(base,group) in variants.items():\n    rtl = root / v / \\\"rtl\\\"\n    shutil.copytree(base, rtl)\n    p=rtl/\\\"divider.sv\\\"; code=p.read_text()\n    start=code.index(\\\"  // With D < 2048\\\")\n    end=code.index(\\\"  logic [34:0] multiples\\\",start)\n    new=\\\"\\\"\\\"  logic [14:0] narrow_trial;\n  logic [14:0] narrow_multiple_q [1:15];\n  logic [16:0] narrow_borrow;\n  logic [15:0] narrow_use_digit;\n  logic [10:0] narrow_candidate [0:15];\n  logic [10:0] narrow_remainder;\n  logic [3:0] narrow_digit;\n\n  assign narrow_trial = {remainder_q[10:0], quotient_q[31:28]};\n  assign narrow_candidate[0] = narrow_trial[10:0];\n  assign narrow_borrow[0] = 1'b0;\n  assign narrow_borrow[16] = 1'b1;\n\n  for (genvar digit = 1; digit <= 15; digit++) begin : gen_narrow_trial\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [15:0] difference;\n    /* verilator lint_on UNUSEDSIGNAL */\n    always_ff @(posedge clock) begin\n      if (reset) narrow_multiple_q[digit] <= '0;\n      else if (initializing) narrow_multiple_q[digit] <= 15'(digit) * {4'b0, b_magnitude[10:0]};\n    end\n    assign difference = {1'b0, narrow_trial} - {1'b0, narrow_multiple_q[digit]};\n    assign narrow_borrow[digit] = difference[15];\n    assign narrow_candidate[digit] = difference[10:0]