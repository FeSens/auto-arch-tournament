{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom os import environ\nimport shutil\nfrom tools.eval import gowin\n\nroot = Path(environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold=Path.cwd()/\\\"cores/bench/rtl\\\"\nvariants = {\n    \\\"reg_redirect_select\\\": None,\n    \\\"reg_redirect_mask\\\": None,\n    \\\"reg_redirect_late_squash\\\": (\\\"reg_redirect_select\\\", True, False),\n    \\\"reg_redirect_late_squash_inv\\\": (\\\"reg_redirect_mask\\\", True, True),\n    \\\"reg_redirect_inv\\\": (\\\"reg_redirect_select\\\", False, True),\n    \\\"reg_redirect_select_gate\\\": (\\\"reg_redirect_select\\\", False, False),\n}\nfor v, cfg in variants.items():\n    if cfg is None:\n        continue\n    base, squash, invert=cfg\n    rtl = root / v / \\\"rtl\\\"\n    shutil.copytree(root/base/\\\"rtl\\\", rtl)\n    if squash:\n        p=rtl/\\\"core.sv\\\"; t=p.read_text()\n        t=t.replace(\\\"  id_ex_t  id_ex_w;\\\", \\\"  id_ex_t  id_ex_w, id_ex_unmasked;\\\")\n        t=t.replace(\\\"  logic        redirect;\\\", \\\"\\\"\\\"  logic        redirect, redirect_q;\n  always_ff @(posedge clock) begin\n    if (reset) redirect_q <= 1'b0;\n    else       redirect_q <= redirect;\n  end\n  always_comb begin\n    id_ex_w = id_ex_unmasked;\n    id_ex_w.valid = id_ex_unmasked.valid && \"'!redirect_q;\n  end\"\"\")\n        t=t.replace(\".out      (id_ex_w)\", \".out      (id_ex_unmasked)\")\n        # Wrong-path EX controls are masked by the registered redirect.\n        t=t.replace(\".redirect       (redirect)\", \".redirect       (1'\"'b0)\\\")\n        p.write_text(t)\n    if invert:\n        p=rtl/\\\"core_pkg.sv\\\"; t=p.read_text()\n        idx=t.index(\\\"  // ID/EX register payload.\\\")\n        t=t[:idx]+t[idx:].replace(\\\"    operand_sel_t rs1_sel;\\\", \\\"    logic miss_invert, direct_miss_en;\\\\n    operand_sel_t rs1_sel;\\\",1); p.write_text(t)\n        p=rtl/\\\"id_stage.sv\\\"; t=p.read_text()\n        t=t.replace(\\\"      reg_q.imm\\\", \\\"\\\"\\\"      reg_q.miss_invert      <= in.predicted_taken;\n      reg_q.direct_miss_en   <= dec_is_branch && \"'!in.direct_target[1];\n      reg_q.imm\"\"\")\n        p.write_text(t)\n        p=rtl/\"ex_stage.sv\"; t=p.read_text()\n        t=t.replace(\"  assign redirect       = advance && (resolved_taken != in.predicted_taken);\",\n                    \"\"\"  logic branch_miss, jump_miss;\n  assign branch_miss    = in.direct_miss_en && (branch_cond != in.miss_invert);\n  assign jump_miss      = in.ctrl.is_jump && !target[1] && !in.predicted_taken;\n  assign redirect       = advance && (branch_miss || jump_miss);\"\"\")\n        p.write_text(t)\n    if not (squash or invert):\n        p=rtl/\"if_stage.sv\"; t=p.read_text()\n        t=t.replace(\"    recover_word_q <= redirect_word;\", \"    if (redirect) recover_word_q <= redirect_word;\"); p.write_text(t)\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \"rtl\", \"fpga/core_bench_si.sv\",\n                n, root / v / f\"gowin_p{n}\"): (v, n)\n            for n in (1,0) for v in variants if n != 0 or variants[v] is not None}\n    for job in as_completed(jobs):\n        v,n=jobs[job]; res=job.result()\n        print(v,n,\"Fmax\",res.get(\"fmax_mhz\"),\"logic\",res.get(\"logic\"),res.get(\"reason\", \"\"))\n        for path in res.get(\"critical_paths\", [])[:2]:\n            print(\" \",path)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'set -e\nexport BENCH_ALU_TRIAL_DIR=\"$TMPDIR/bench_alu_b9dODu\"\nPYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom os import environ\nimport shutil\nfrom tools.eval import gowin\n\nroot=Path(environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold=Path.cwd()/\\\"cores/bench/rtl\\\"\nvariants={\n    \\\"pcsplit\\\": (gold, True, False),\n    \\\"pcsplit_skid2\\\": (root/\\\"skid2/rtl\\\", True, False),\n    \\\"pcsplit_skid4\\\": (root/\\\"skid4_recovery/rtl\\\", True, False),\n    \\\"pcsplit_regredirect\\\": (root/\\\"reg_redirect_select/rtl\\\", True, False),\n    \\\"pcsplit_regmask\\\": (root/\\\"reg_redirect_mask/rtl\\\", True, False),\n    \\\"pcsplit_regmask_sel\\\": (root/\\\"reg_redirect_mask/rtl\\\", True, True),\n}\nfor v,(base,split,sel) in variants.items():\n    rtl=root/v/\\\"rtl\\\"\n    shutil.copytree(base,rtl)\n    p=rtl/\\\"if_stage.sv\\\"; t=p.read_text()\n    if split:\n        t=t.replace(\\\"  assign direct_word = pc_word + {{11{imem_data[31]}}, offset_word};\\\", \\\"\\\"\\\"  logic [18:0] target_low_sum;\n  logic [11:0] pc_high, target_upper, upper_inc, upper_dec;\n  logic upper_in_range;\n  assign target_low_sum = {1'b0, pc_word[19:2]} + {1'b0, offset_word[19:2]};\n  assign pc_high = pc_word[31:20];\n  assign upper_inc = pc_high + 12'd1;\n  assign upper_dec = pc_high - 12'd1;\n  assign target_upper = target_low_sum[18] ? (offset_word[20] ? pc_high : upper_inc)\n                                            : (offset_word[20] ? upper_dec : pc_high);\n  assign direct_word = {target_upper, target_low_sum[17:0]};\n  assign upper_in_range = (pc_high == 12'h000 && target_low_sum[18] == offset_word[20])\n                       || (pc_high == 12'hfff && target_low_sum[18] && \"'!offset_word[20])\n                       || (pc_high == 12'\"'h001 && \"'!target_low_sum[18] && offset_word[20]);\"\"\")\n        t=t.replace(\"direct_word[31:20] == 12'\"'b0\\\",\\\"upper_in_range\\\")\n    if sel:\n        t=t.replace(\\\"    else if (\"'!stall)    pc_q <= ({30{predicted_taken}} & direct_word) | ({30{!predicted_taken}} & (pc_word + 30'\"'d1));\\\\n    else if (recover_q) pc_q <= recover_word_q;\\\", \n                    \\\"\\\"\\\"    else if (\"'!stall || recover_q)\n      pc_q <= ({30{!stall && predicted_taken}} & direct_word)\n            | ({30{!stall && !predicted_taken}} & (pc_word + 30'\"'d1))\n            | ({30{stall && recover_q}} & recover_word_q);\\\"\\\"\\\")\n    p.write_text(t)\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\",\n                n, root / v / f\\\"gowin_p{n}\\\"): (v, n)\n            for n in (1,) for v in variants}\n    for job in as_completed(jobs):\n        v,n=jobs[job]; res=job.result()\n        print(v,n,\\\"Fmax\\\",res.get(\\\"fmax_mhz\\\"),\\\"logic\\\",res.get(\\\"logic\\\"),res.get(\\\"reason\\\", \\\"\\\"))\n        for path in res.get(\\\"critical_paths\\\", [])[:2]:\n            print(\\\" \\\",path)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
