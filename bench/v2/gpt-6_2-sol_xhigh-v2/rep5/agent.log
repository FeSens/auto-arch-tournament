{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/hyp-r13s1.J3do6q/profile.py\" <<'\"'PY'\nfrom collections import Counter\nimport json\nimport sys\n\ndef kind(insn):\n    op = insn & 127\n    funct3 = (insn >> 12) & 7\n    if op == 3:\n        return 'load'\n    if op == 35:\n        return 'store'\n    if op == 99:\n        return 'eqbr' if funct3 < 2 else 'cmpbr'\n    if op in (19, 51):\n        f7 = insn >> 25\n        if op == 51 and f7 == 1:\n            return 'mul' if funct3 < 4 else 'div'\n        if funct3 == 0:\n            return 'add' if op == 51 and not f7 else 'addi' if op == 19 else 'sub'\n        return {1:'shift',2:'slt',3:'slt',4:'logic',5:'shift',6:'logic',7:'logic'}[funct3]\n    return {23:'auipc',55:'lui',103:'jalr',111:'jal'}.get(op, 'other')\n\ncounts = Counter()\ndeps = Counter()\nzero_counts = Counter()\nprev, prevkind, have_started = None, None, False\nfor line in sys.stdin:\n    try:\n        row = json.loads(line)\n    except ValueError:\n        continue\n    if not isinstance(row, dict) or 'insn' not in row:\n        continue\n    if row['mem_wmask']:\n        if row['mem_addr'] == 0x10000100:\n            have_started = True\n            continue\n        if row['mem_addr'] == 0x10000104:\n            break\n    if not have_started:\n        continue\n    key = kind(row['insn'])\n    counts[key] += 1\n    if prev and prev['rd_addr']:\n        s1, s2 = (row['rs1_addr'] == prev['rd_addr'],\n                  row['rs2_addr'] == prev['rd_addr'])\n        if s1 or s2:\n            gap = row['cycle'] - prev['cycle'] - 1\n            match = 'both' if s1 and s2 else 'rs1' if s1 else 'rs2'\n            deps[prevkind, key, match, min(max(gap,0),2)] += 1\n            if key in ('load','store') and s1:\n                offset_bits = row['insn'] >> 20 if key == 'load' else ((row['insn'] >> 25) << 5) | ((row['insn'] >> 7) & 31)\n                if offset_bits == 0:\n                    zero_counts[prevkind, key, match] += 1\n    prev, prevkind = row, key\nprint(counts, sum(counts.values()))\nlevel = Counter()\nfor (a,b,c,g), n in deps.items():\n    if a in ('load','mul'):\n        level[a,b,c] += n\nfor k, n in level.most_common():\n    if n >= 100:\n        print(*k, n, [deps[(*k,g)] for g in range(3)], 'offset 0', zero_counts[k])\nPY\nset -o pipefail\nscratch=\\\"\"'$TMPDIR/hyp-r13s1.J3do6q\"\n\"$scratch/champion-sim/cosim_sim\" \"$scratch/coremark.elf\" 20000000 --istall --dstall | python3 \"$scratch/profile.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
