    (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[13876 of 16948 chars elided by tools/bench/transcript.py; sha256:1d5a27c5105a4e17]…\nsynchronous tail write.\\nUse three-bit head and tail pointers with wrap bits. Write the raw packet\\nto the physical tail whenever the pointers show free space so the RAM\\nwrite enable depends on registered occupancy. Move the logical tail only for\\na ready response that enters the FIFO, and move the head only when decode\\naccepts its packet. Bypass directly to decode when empty \nbin\noss-cad-suite\nxpack-riscv-none-elf-gcc-15.2.0-1\npytest is /srv/hwebench/venv/bin/pytest\npytest is /srv/hwebench/venv/bin/pytest\npython3 is /srv/hwebench/venv/bin/python3\npython3 is /srv/hwebench/venv/bin/python3\npython3 is /usr/bin/python3\npython3 is /bin/python3\ntools/eval/gowin.py:22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\ntools/eval/gowin.py:23:GOWIN_VERSION = \"1.9.11.03 Education\"\ntools/eval/gowin.py:35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\ntools/eval/gowin.py:133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n", "exit_code": 0, "status": "completed"}}
