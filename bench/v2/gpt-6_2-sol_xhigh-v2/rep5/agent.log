{"type":"item.started","item":{"id":"item_187","type":"command_execution","command":"/bin/bash -c \"python3 -c '\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nfrom tempfile import TemporaryFile\n\nroot = Path(os.environ[\\\"TMPDIR\\\"])\nwith TemporaryFile(dir=root) as wrapper:\n    wrapper.write(sys.argv[1].encode())\n    wrapper.flush()\n    wrapper.seek(0)\n    paths = []\n    for variant in (root / \\\"bench-baseline/cores/bench/rtl\\\", root / \\\"bench-direct-rtl\\\"):\n        paths.append(\\\" \\\".join(str(variant / (name + \\\".sv\\\")) for name in\n                              (\\\"core_pkg\\\", \\\"alu\\\", \\\"divider\\\", \\\"multiplier\\\", \\\"id_stage\\\", \\\"ex_stage\\\")))\n    cmds = []\n    for label, files in zip((\\\"gold\\\", \\\"gate\\\"), paths):\n        cmds += [f\\\"read_verilog -formal -sv -D RISCV_FORMAL_ALTOPS {files} /proc/self/fd/{wrapper.fileno()}\\\",\n                 \\\"prep -top issue_execute -flatten\\\", f\\\"rename issue_execute {label}\\\", f\\\"design -stash {label}\\\"]\n    cmds += [\\\"design -copy-from gold gold\\\", \\\"design -copy-from gate gate\\\",\n             \\\"miter -equiv -make_assert -flatten gold gate miter\\\", \\\"hierarchy -top miter\\\",\n             \\\"memory_map\\\", \\\"opt -full\\\",\n             \\\"sat -seq 4 -set-at 1 in_reset 1 -set-init-zero -prove-skip 1 -prove-asserts -verify\\\"]\n    subprocess.run([\\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", \\\"; \\\".join(cmds)], pass_fds=(wrapper.fileno(),), check=True)\n' '\nmodule issue_execute (\n  input logic clock, reset, hold, stall, issue_candidate, issue,\n  input issue_packet_t in,\n  input logic [31:0] rs1_data, rs2_data, wb_value, fwd_ex_mem, fwd_mem_wb,\n  input operand_sel_t rs1_sel, rs2_sel,\n  output logic [31:0] result\n);\n  id_ex_t id_ex;\n  ex_mem_t ex_mem;\n  logic [4:0] rs1_addr, rs2_addr;\n  id_stage u_id (.out(id_ex), .*);\n  ex_stage u_ex (.clock(clock), .reset(reset), .stall(stall), .in(id_ex),\n                 .fwd_ex_mem(fwd_ex_mem), .fwd_mem_wb(fwd_mem_wb), .out(ex_mem));\n  assign result = ex_mem.alu_result;\nendmodule\n' > \\\"\"'$TMPDIR/bench-direct-ex-result-proof.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_188","type":"command_execution","command":"/bin/bash -c \"python3 -c '\nfrom collections import defaultdict\nfrom functools import lru_cache\nfrom pathlib import Path\nimport re\nimport sys\n\nclean = lambda name: name.replace(chr(92), \\\"\\\")\nworst = lambda triple: float(triple.split(\\\":\\\")[-1])\nfor arg in sys.argv[1:]:\n    path = Path(arg)\n    if not path.is_file():\n        continue\n    edges = defaultdict(dict)\n    previous = defaultdict(set)\n    setup = {}\n    for line in path.open():\n        if match := re.match(r\\\"\\\\s*\\\\(INSTANCE (\\\\S+)\\\\)\\\", line):\n            cell = clean(match[1])\n        if match := re.match(r\\\"\\\\s*\\\\(INTERCONNECT (\\\\S+) (\\\\S+) \\\\(([\\\\d.:-]+)\\\\)\\\", line):\n            src, dst = clean(match[1]), clean(match[2])\n        elif match := re.match(r\\\"\\\\s*\\\\(IOPATH (\\\\w+) (\\\\w+) \\\\(([\\\\d.:-]+)\\\\)\\\", line):\n            src, dst = cell + \\\"/\\\" + match[1], cell + \\\"/\\\" + match[2]\n        else:\n            if match := re.match(r\\\"\\\\s*\\\\(SETUPHOLD \\\\(posedge (\\\\w+)\\\\) \\\\(posedge CLK\\\\) \\\\(([\\\\d.:-]+)\\\\)\\\", line):\n                setup[cell + \\\"/\\\" + match[1]] = worst(match[2])\n            continue\n        edges[src][dst] = worst(match[3])\n        previous[dst].add(src)\n\n    def route_to(dst):\n        cone = {dst}\n        frontier = [dst]\n        while frontier:\n            for node in previous[frontier.pop()]:\n                if node not in cone:\n                    cone.add(node)\n                    frontier.append(node)\n\n        @lru_cache(None)\n        def route(node):\n            if node == dst:\n                return 0, (dst,)\n            candidates = []\n            for other, delay in edges[node].items():\n                if other in cone:\n                    tail_delay, tail = route(other)\n                    candidates.append((delay + tail_delay, (node,) + tail))\n            return max(candidates, default=(float(\\\"-inf\\\"), ()))\n\n        def period(src):\n            data_delay, chain = route(src)\n            if not chain:\n                return data_delay, chain\n            src_clk = src.rsplit(\\\"/\\\", 1)[0] + \\\"/CLK\\\"\n            dst_clk = dst.rsplit(\\\"/\\\", 1)[0] + \\\"/CLK\\\"\n            clkq = edges[src_clk][src]\n            clock = \\\"clock_ibuf/O\\\"\n            skew = edges[clock][src_clk] - edges[clock][dst_clk]\n            return data_delay + clkq + setup.get(dst, 0) + skew, chain\n\n        return period\n\n    rs1 = \\\"cpu/u_id/reg_q.rs1_val_{}_s0/Q\\\"\n    result = \\\"cpu/u_ex/reg_q.alu_result_{}_s0/D\\\"\n    print(path)\n    for src, dst in ((rs1.format(9), result.format(5)),\n                     (\\\"cpu/u_ex/reg_q.alu_result_3_s0/Q\\\", result.format(24)),\n                     (\\\"cpu/u_mem/reg_q.result_2_s0/Q\\\", \\\"cpu/u_id/reg_q.valid_s0/D\\\")):\n        delay, chain = route_to(dst)(src)\n        print(f\\\"{delay:.3f} ns {src} -> {dst}\\\")\n    data_paths = []\n    fill_paths = []\n    for dst_bit in range(1, 32):\n        lookup = route_to(result.format(dst_bit))\n        for src_bit in range(dst_bit + 1, 32):\n            result_path = lookup(rs1.format(src_bit))\n            data_paths.append(result_path)\n        fill_paths.append(lookup(\\\"cpu/u_id/reg_q.arithmetic_fill_s0/Q\\\"))\n    for label, samples in ((\\\"rs1 from high bit to low bit\\\", data_paths), (\\\"arithmetic fill\\\", fill_paths)):\n        delay, chain = max(samples)\n        if chain:\n            print(f\\\"{label}: {delay:.3f} ns {chain[0]} -> {chain[-1]}\\\")\n' cores/bench/generated/timing-champion-shift/impl/pnr/core_bench.sdf; head -c 600 \\\"\"'$TMPDIR/bench-timing-champion-shift.log\"; tail -n 5 cores/bench/generated/timing-champion-shift/gw.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
