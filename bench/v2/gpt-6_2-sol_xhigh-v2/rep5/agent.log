{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/r15-profile/retry_rtl\"\ncp cores/bench/rtl/*.sv \"$TMPDIR/r15-profile/retry_rtl/\"\ncat > \"$TMPDIR/r15-profile/make_retry.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nrtl = Path(os.environ['TMPDIR']) / 'r15-profile' / 'retry_rtl'\npath = rtl / 'if_stage.sv'\ndata=path.read_text()\n\ndef change(before,after):\n    global data\n    assert data.count(before)==1,before\n    data=data.replace(before,after)\n\nchange('  logic [31:2] pc_word, sequential_q, retry_q, ex_target_q, mem_target_q;',\n       '''  logic [31:2] pc_word, sequential_q, retry_q, ex_target_q, mem_target_q;\n  logic [31:2] normal_word, restart_word, restart_sequential, restart_next;\n  logic        normal_last_word, restart_last_word, restart_advance;''')\nchange('assign pc_upper = pc_word[31:20];','assign pc_upper = normal_word[31:20];')\nchange(\\\"{1'b0, pc_word[19:2]} + {1'b0, offset_word[19:2]}\\\",\n       \\\"{1'b0, normal_word[19:2]} + {1'b0, offset_word[19:2]}\\\")\nchange(\\\"assign prediction_index = pc_word[7:2] \"'^ {4'\"'b0, history_q};\\\",\n       \\\"assign prediction_index = normal_word[7:2] \"'^ {4'\"'b0, history_q};\\\")\nchange('  assign hold_last_word = pc_word == LAST_IMEM_WORD && \"'!predicted_taken;'\"',\n       '''  assign normal_last_word = normal_word == LAST_IMEM_WORD;\n  assign restart_last_word = restart_word == LAST_IMEM_WORD;\n  assign hold_last_word = recovering ? restart_last_word\n                                     : normal_last_word && \"'!predicted_taken;'\"''')\nchange('  assign advance_request = resume_fetch || (accept_response && \"'!hold_last_word);'\"',\n       '''  assign advance_request = resume_fetch ||\n                           (accept_response && \"'!(normal_last_word && !predicted_taken));\n  assign restart_advance = response_valid && !restart_last_word;\n  assign restart_sequential = restart_word + 30'\"'d1;\n  assign