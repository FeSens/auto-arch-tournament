    = {in.sequential_word, 2'b00};\\\")\n    if addr:\n        t=t.replace(\\\"assign jalr_sum = rs1 + in.imm;\\\", \\\"assign jalr_sum = {addr_hi, addr_lo[11:0]};\\\")\n    if fold:\n        t=t.replace(\\\"assign redirect_word  = in.ctrl.is_jalr ? jalr_sum[31:2] : in.recovery_word;\\\",\n           \\\"\\\"\\\"assign redirect_word  = ({30{in.ctrl.is_jalr}} & jalr_sum[31:2])\n                        | ({30{\"'!in.ctrl.is_jalr}} & in.recovery_word);\"\"\")\n    p.write_text(t)\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = {pool.submit(gowin.build, Path.cwd(), root / v / \"rtl\", \"fpga/core_bench_si.sv\",\n                n, root / v / f\"gowin_p{n}\"): (v, n)\n            for n in (1,) for v in variants}\n    for job in as_completed(jobs):\n        v,n=jobs[job]; res=job.result()\n        print(v,n,\"Fmax\",res.get(\"fmax_mhz\"),\"logic\",res.get(\"logic\"),res.get(\"reason\", \"\"))\n        for path in res.get(\"critical_paths\", [])[:2]:\n            print(\" \",path)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
