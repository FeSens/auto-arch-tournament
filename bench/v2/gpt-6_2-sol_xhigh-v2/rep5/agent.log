{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"cat >> cores/bench/test/test_pipeline.py <<'PY'\n\n\n@cocotb.test()\nasync def signed_effective_addresses_through_bypass_and_traps(dut):\n    value_below, value_above = 0x12345678, 0x59\n    store = SW(8, 3, 4)\n    load_next_page = LW(5, 3, 4)\n    jump_trap = JALR(4, 0, 2)\n    load_trap = LW(4, 0, 1)\n    program = [\n        ADDI(8, 0, value_above),\n        0x000011B7,  # LUI x3, 0x1.\n        ADDI(3, 3, -4),\n        store,\n        load_next_page,\n        ADDI(4, 3, 4),\n        jump_trap,\n        LW(6, 4, -4),\n        load_trap,\n        LW(7, 4, -4),\n        EBREAK(),\n    ]\n    requests = []\n\n    def ready(addr, ren, wen):\n        if wen:\n            requests.append((addr, wen, int(dut.io_dmemWData.value)))\n            return len(requests) == 4\n        return True\n\n    rets, dmem = await _run(\n        dut, program, dmem_init={0xFFC: value_below}, dmem_ready=ready\n    )\n    assert requests == [(0x1000, 0xF, value_above)] * 4\n    assert dmem == {0xFFC: value_below, 0x1000: value_above}\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n\n    assert [r[\\\"rs1_rdata\\\"] for r in (rets[3], rets[4])] == [0xFFC, 0xFFC]\n    assert (rets[4][\\\"mem_addr\\\"], rets[4][\\\"rd_wdata\\\"]) == (0x1000, value_above)\n    for index in (6, 8):\n        r = rets[index]\n        assert (r[\\\"trap\\\"], r[\\\"rd\\\"], r[\\\"mem_rmask\\\"], r[\\\"mem_wmask\\\"]) == (1, 0, 0, 0)\n    for index in (7, 9):\n        r = rets[index]\n        assert (r[\\\"rs1_rdata\\\"], r[\\\"mem_addr\\\"], r[\\\"rd_wdata\\\"]) == (\n            0x1000, 0xFFC, value_below\n        )\nPY\nCOCOTB_TEST_FILTER=signed_effective_addresses pytest -q --rootdir=. cores/bench/test/test_pipeline.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
