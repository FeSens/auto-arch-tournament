{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"python - '/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2' <<'PY'\nfrom pathlib import Path\nimport re, shutil, sys\nscratch = Path(sys.argv[1])\nbaseline = Path('cores/bench/rtl')\ndef variant(name, mem_bypass, raw_reads):\n    dst = scratch / name / 'rtl'\n    shutil.copytree(baseline, dst, copy_function=shutil.copyfile)\n    top = dst / 'core.sv'\n    id_stage = dst / 'id_stage.sv'\n    ex_stage = dst / 'ex_stage.sv'\n    mem_stage = dst / 'mem_stage.sv'\n    s = top.read_text()\n    ident = id_stage.read_text()\n    ex = ex_stage.read_text()\n    if mem_bypass:\n        s = s.replace('  logic [31:0] wb_w_data;', '  logic [31:0] wb_w_data, mem_result_next;')\n        s = s.replace('    .rs1_data (rs1_data_w),', '    .mem_result_next (mem_result_next),\\\\n    .rs1_data (rs1_data_w),')\n        s = s.replace('    .next_write (mem_next_write),', '    .result_next (mem_result_next),\\\\n    .next_write (mem_next_write),')\n        ident = ident.replace('  input  logic [31:0]       rs1_data,', '  input  logic [31:0]       mem_result_next,\\\\n  input  logic [31:0]       rs1_data,')\n        m = mem_stage.read_text()\n        m = m.replace('  output logic               next_write,', '  output logic [31:0]        result_next,\\\\n  output logic               next_write,')\n        m = m.replace('  always_ff @(posedge clock) begin', '  assign result_next = wb_result;\\\\n\\\\n  always_ff @(posedge clock) begin')\n        mem_stage.write_text(m)\n        s = re.sub(r'\"'^    '\"\\\\.fwd_mem_wb.*\\\\n', '', s, flags=re.M)\n        ex = re.sub(r'\"'^  input  logic '\"\\\\[31:0\\\\]        fwd_mem_wb.*\\\\n', '', ex, flags=re.M)\n    if raw_reads:\n        s = s.replace('  reg_file u_rf', \\\"  reg_file #(.RAW_READ(1'b1)) u_rf\\\")\n        s = s.replace('    .mem_result_next (mem_result_next),', '    .mem_result_next (mem_result_next),\\\\n    .wb_w_en (wb_w_en), .wb_w_addr (wb_w_addr), .wb_w_data (wb_w_data),')\n        ident = ident.replace('  input  logic [31:0]       mem_result_next,', '  input  logic [31:0]       mem_result_next,\\\\n  input  logic              wb_w_en,\\\\n  input  logic [4:0]        wb_w_addr,\\\\n  input  logic [31:0]       wb_w_data,')\n    for num in (1, 2):\n        operand=f'rs{num}'\n        parts = [f'({{32{{{operand}_sel.reg_file}}}} & {operand}_data)']\n        if raw_reads:\n            idx = ident.index('  // ── ID/EX register')\n            ident = ident[:idx] + f'  wire {operand}_from_wb = wb_w_en && wb_w_addr == {operand}_addr;\\\\n\\\\n' + ident[idx:]\n            parts = [f'({{32{{{operand}_sel.reg_file && \"'!{operand}_from_wb}}}} & {operand}_data)'\"',\n                     f'({{32{{{operand}_sel.reg_file && {operand}_from_wb}}}} & wb_w_data)']\n        if mem_bypass:\n            parts.append(f'({{32{{{operand}_sel.mem_wb}}}} & mem_result_next)')\n        ident = ident.replace(f'<= {operand}_data;', '<= ' + '\\\\n                             | '.join(parts) + ';')\n        parts = [f'({{32{{in.{operand}_sel.ex_mem}}}} & fwd_ex_mem)', f'in.{operand}_val']\n        if not mem_bypass:\n            parts.insert(1, f'({{32{{in.{operand}_sel.mem_wb}}}} & fwd_mem_wb)')\n        ex = re.sub(rf'assign {operand} = [\"'^;]+;'\"', f'assign {operand} = ' + '\\\\n             | '.join(parts) + ';', ex)\n    top.write_text(s)\n    id_stage.write_text(ident)\n    ex_stage.write_text(ex)\nvariant('rfmask',False,False)\nvariant('earlymem',True,False)\nvariant('earlymemraw',True,True)\nPY\nPYTHONDONTWRITEBYTECODE=1 python - '/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2' <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json, sys\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(sys.argv[1])\ndef timing(name):\n    results = build_all(Path.cwd(), scratch / name / 'rtl', 'fpga/core_bench_si.sv', scratch / ('gowin_' + name))\n    (scratch / (name + '.json')).write_text(json.dumps(results, indent=2))\n    print(name, json.dumps(summarize(results)), flush=True)\nwith ThreadPoolExecutor(max_workers=2) as ex:\n    for result in ex.map(timing, ('earlymem','rfmask','earlymemraw')): pass\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
