= target_lo[17:0];', '    branch_word_q <= branch_lo[17:0];\\\\n    jal_word_q <= jal_lo[17:0];')\n    s = s.replace('redirect || take_direct || take_seq', 'redirect || take_branch || take_jal || take_seq')\n    s = s.replace('    use_direct_q   <= \"'!reset && !redirect && take_direct;'\"', '    use_branch_q   <= \"'!reset && !redirect && take_branch;'\"\\\\n    use_jal_q      <= \"'!reset && !redirect && take_jal;'\"')\n    p.write_text(s)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
