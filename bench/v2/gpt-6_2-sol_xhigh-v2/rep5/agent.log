{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\n\nroot = Path.cwd()\nscratch = Path(os.environ['TMPDIR']) / 'r4s2-predictor'\nscratch.mkdir(exist_ok=True)\nshutil.copytree(root / 'cores/bench', scratch / 'cores/bench',\n                ignore=shutil.ignore_patterns('experiments'), dirs_exist_ok=True)\nshutil.copytree(root / 'bench', scratch / 'bench', dirs_exist_ok=True)\n(scratch / 'fpga').symlink_to(root / 'fpga', target_is_directory=True)\nrtl = scratch / 'cores/bench/rtl'\nfetch = rtl / 'if_stage.sv'\nsource = fetch.read_text()\nsource = source.replace('Holds the PC and gshare state. IF/ID is\\\\n// combinational, so ID/EX captures the prediction on the same edge\\\\n// that advances the fetch PC.', 'Holds the request PC and gshare state. A flow-through\\\\n// queue feeds predicted packets to decode.')\nstart = source.index('  // EX only redirects')\nend = source.index('\\\\nendmodule', start)\nsource = source[:start] + \\\"\\\"\\\"  localparam int QUEUE_BITS = 2;\n  localparam logic [31:2] APERTURE_LAST_WORD = 30'h0003ffff;\n  if_id_t queue [0:(1 << QUEUE_BITS)-1];\n  if_id_t fetch_packet;\n  logic [QUEUE_BITS:0] read_ptr_q, write_ptr_q;\n  logic empty, full, pop, push, bypass, accept_response;\n  logic last_word, boundary_pending_q;\n\n  assign empty = read_ptr_q == write_ptr_q;\n  assign full = read_ptr_q[QUEUE_BITS-1:0] == write_ptr_q[QUEUE_BITS-1:0]\n             && read_ptr_q[QUEUE_BITS] \"'!= write_ptr_q[QUEUE_BITS];\n  assign pop = !empty && !stall;\n  assign last_word = pc_word == APERTURE_LAST_WORD;\n  assign bypass = empty && !stall && fetch_packet.valid;\n  assign push = fetch_packet.valid && !last_word && !bypass && (!full || pop);\n  assign accept_response = bypass || push;\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      read_ptr_q  <= '\"'0;\n      write_ptr_q <= '0;\n    end else begin\n      if (pop)  read_ptr_q  <= read_ptr_q + 1'b1;\n      if (push) write_ptr_q <= write_ptr_q + 1'b1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (push && \"'!redirect && !reset)\n      queue[write_ptr_q[QUEUE_BITS-1:0]] <= fetch_packet;\n  end\n\n  // At the aperture edge, delay a speculative fall-through until EX\n  // advances. A redirect there still takes priority over all fetch state.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_word <= '\"'0;\n      boundary_pending_q <= 1'b0;\n    end else if (redirect) begin\n      pc_word <= redirect_word;\n      boundary_pending_q <= 1'b0;\n    end else if (boundary_pending_q && \"'!stall) begin\n      pc_word <= pc_word + 30'\"'d1;\n      boundary_pending_q <= 1'b0;\n    end else if (accept_response) begin\n      if (last_word && \"'!predicted_taken)\n        boundary_pending_q <= 1'\"'b1;\n      else\n        pc_word <= predicted_taken ? direct_word : pc_word + 30'd1;\n    end\n  end\n\n  assign imem_addr                     = {pc_word, 2'b00};\n  assign fetch_packet.pc               = imem_addr;\n  assign fetch_packet.instr            = imem_data;\n  assign fetch_packet.valid            = imem_ready && \"'!boundary_pending_q;\n  assign fetch_packet.direct_target    = {direct_word, direct_bit1, 1'\"'b0};\n  assign fetch_packet.predicted_taken  = predicted_taken;\n  assign fetch_packet.prediction_index = prediction_index;\n  assign out = empty ? fetch_packet : queue[read_ptr_q[QUEUE_BITS-1:0]];\n\\\"\\\"\\\" + source[end:]\nfetch.write_text(source)\npath = rtl / 'hazard_unit.sv'\nsource = path.read_text().replace('imem_ready', 'if_id_valid')\nsource = source.replace('  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\\\\n  // random ~22% stall in vex_main.cpp). When low, the corresponding\\\\n  // memory request is NOT serviced this cycle.\\\\n  input  logic       if_id_valid,', '  input  logic       if_id_valid,     // oldest fetch packet is available')\nsource = source.replace('assign stall_if = stall_id || \"'!if_id_valid;'\"', 'assign stall_if = stall_id;')\npath.write_text(source)\npath = rtl / 'core.sv'\nsource = path.read_text().replace('.imem_ready     (io_imemReady),', '.if_id_valid    (if_id_w.valid),')\npath.write_text(source)\nprint(scratch)\nPY\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
