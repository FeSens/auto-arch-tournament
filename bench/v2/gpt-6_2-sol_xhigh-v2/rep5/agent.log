{"type": "item.started", "item": {"id": "item_58", "type": "command_execution", "command": "/bin/bash -c \"set -e\ntop='/srv/hwebench/tmp/7c172beb/e429b367/bench-steering-study.qBnrjP'\nfor variant in compare compare_split; do\n  mkdir \\\"\"'$top/$variant\"\n  cp -R Makefile cores bench test fpga tools \"$top/$variant/\"\ndone\ncp \"$top/split/cores/bench/rtl/if_stage.sv\" \"$top/compare_split/cores/bench/rtl/\"\npython3 - \"$top\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\ntop = Path(sys.argv[1])\nfor variant in ('compare','compare_split'):\n  rtl = top/variant/'cores/bench/rtl'\n  p = rtl/'core_pkg.sv'\n  s = p.read_text()\n  s = s.replace('    logic        holds_fetch;\\\\n    logic [31:0] rs1_val;', '    logic        holds_fetch;\\\\n    logic        load_rs1, load_rs2;\\\\n    logic [31:0] rs1_val;')\n  p.write_text(s)\n\n  p = rtl/'id_stage.sv'\n  s = p.read_text()\n  s = s.replace('  input  logic              issue,','''  input  logic              issue,\n  input  logic              load_eq_rs1,\n  input  logic              load_eq_rs2,''')\n  s = s.replace('      reg_q.rs1_val', '''      reg_q.load_rs1         <= load_eq_rs1;\n      reg_q.load_rs2         <= load_eq_rs2;\n      reg_q.rs1_val''', 1)\n  p.write_text(s)\n\n  p = rtl/'core.sv'\n  s = p.read_text()\n  s = s.replace('  logic       ex_fast_write, mem_next_write;', '''  logic       ex_fast_write, mem_next_write;\n  logic       load_eq_rs1, load_eq_rs2, issue_eq_load;\n  logic [31:0] load_result;\n  assign issue_eq_load = if_id_w.ctrl.is_branch && if_id_w.ctrl.branch_op[2:1] == 2'b0\n                       && id_ex_w.valid && id_ex_w.ctrl.mem_read && id_ex_w.rd \"'!= 5'\"'b0;\n  assign load_eq_rs1 = issue_eq_load && id_ex_w.rd == rs1_addr_w;\n  assign load_eq_rs2 = issue_eq_load && id_ex_w.rd == rs2_addr_w;''')\n  s = s.replace('    .rs1_addr (rs1_addr_w),','''    .load_eq_rs1 (load_eq_rs1),\n    .load_eq_rs2 (load_eq_rs2),\n    .rs1_addr (rs1_addr_w),''', 1)\n  s = s.replace('    .in              (id_ex_w),','''    .in              (id_ex_w),\n    .mem_load_value  (load_result),\n    .mem_load_raw    (io_dmemRData),\n    .mem_load_ready  (io_dmemREn),\n    .mem_load_lane   (ex_mem_w.mem_addr[1:0]),\n    .mem_load_width  (ex_mem_w.ctrl.mem_width),\n    .mem_load_sext   (ex_mem_w.ctrl.mem_sext),''')\n  s = s.replace('    .dmem_ren   (io_dmemREn),','    .dmem_ren   (io_dmemREn),\\\\n    .load_result (load_result),')\n  s = s.replace('(id_ex_w.ctrl.mem_read ||\\\\n                                         id_ex_w.ctrl.is_mul || id_ex_w.ctrl.is_div)', '((id_ex_w.ctrl.mem_read && \"'!issue_eq_load) ||'\"\\\\n                                         id_ex_w.ctrl.is_mul || id_ex_w.ctrl.is_div)')\n  p.write_text(s)\n\n  p = rtl/'mem_stage.sv'\n  s = p.read_text()\n  s = s.replace('  output logic               dmem_ren,','  output logic               dmem_ren,\\\\n  output logic [31:0]        load_result,')\n  s = s.replace('  logic [31:0] wb_result;', '  assign load_result = load_data;\\\\n\\\\n  logic [31:0] wb_result;')\n  p.write_text(s)\n\n  p = rtl/'ex_stage.sv'\n  s = p.read_text()\n  s = s.replace('  input  id_ex_t   in,','''  input  id_ex_t   in,\n  input  logic [31:0]        mem_load_value,\n  input  logic [31:0]        mem_load_raw,\n  input  logic               mem_load_ready,\n  input  logic [1:0]         mem_load_lane,\n  input  logic [1:0]         mem_load_width,\n  input  logic               mem_load_sext,''')\n  s = s.replace('  logic        branch_cond;', '''  logic        branch_cond;\n  logic        load_eq, cmp_equal, byte_match, half_match, word_match;\n  logic        cmp_byte_sext, cmp_half_sext;\n  logic [31:0] cmp_other;\n  logic [3:0]  byte_lane_match;\n  logic [1:0]  half_lane_match;\n\n  assign cmp_other = in.load_rs1 ? rs2 : rs1;\n  assign cmp_byte_sext = mem_load_sext && cmp_other[7];\n  assign cmp_half_sext = mem_load_sext && cmp_other[15];\n\n  for (genvar i = 0; i < 4; i++) begin : gen_load_byte_eq\n    assign byte_lane_match[i] = (mem_load_raw[i*8 +: 8] == cmp_other[7:0]) && mem_load_lane == 2'(i);\n  end\n  for (genvar i = 0; i < 2; i++) begin : gen_load_half_eq\n    assign half_lane_match[i] = (mem_load_raw[i*16 +: 16] == cmp_other[15:0]) && mem_load_lane[1] == 1'(i);\n  end\n\n  assign byte_match = (|byte_lane_match) && cmp_other[31:8] == {24{cmp_byte_sext}};\n  assign half_match = (|half_lane_match) && cmp_other[31:16] == {16{cmp_half_sext}};\n  assign word_match = mem_load_raw == cmp_other;\n  assign load_eq = (mem_load_width == 2'd0 && byte_match)\n                || (mem_load_width == 2'd1 && half_match)\n                || (mem_load_width == 2'd2 && word_match);\n  assign cmp_equal = mem_load_ready && (in.load_rs1 || in.load_rs2)\n                   ? (in.load_rs1 && in.load_rs2) || load_eq : rs1 == rs2;\n''')\n  s = s.replace('branch_cond = (rs1 == rs2);', 'branch_cond = cmp_equal;')\n  s = s.replace('branch_cond = (rs1 \"'!= rs2);'\"', 'branch_cond = \"'!cmp_equal;'\"')\n  s = s.replace('reg_q.rs1_val       <= is_divide ? divide_rs1_q : rs1;', 'reg_q.rs1_val       <= in.load_rs1 && mem_load_ready ? mem_load_value : (is_divide ? divide_rs1_q : rs1);')\n  s = s.replace('reg_q.rs2_val       <= is_divide ? divide_rs2_q : rs2;', 'reg_q.rs2_val       <= in.load_rs2 && mem_load_ready ? mem_load_value : (is_divide ? divide_rs2_q : rs2);')\n  p.write_text(s)\nPY\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
