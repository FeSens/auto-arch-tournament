{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch=Path(os.environ['TMPDIR'])/'fetch-target-study'\nfor variant in ('compare_shared', 'compare_shared_xor', 'compare_high_sign'):\n    dest=scratch/variant\n    shutil.copytree(scratch/'branch_compare/cores/bench',dest/'cores/bench',ignore=shutil.ignore_patterns('generated','obj_dir'))\n    for name in ('bench','tools','test','Makefile','fpga'):\n        (dest/name).symlink_to(scratch/name,target_is_directory=name\"'!='\"'Makefile')\n    basedir=dest/'cores/bench/rtl'\n    p=basedir/'ex_stage.sv'\n    rtl=p.read_text()\n    if variant=='compare_high_sign':\n        rtl=rtl.replace('''      assign less_group[group_id] =\n          {rs1[31] \"'^ signed_compare, rs1[30:24]} < {rs2[31] ''^ signed_compare, rs2[30:24]};'\"''','''      logic signs_differ;\n      assign signs_differ = rs1[31] \"'^ rs2[31];\n      assign less_group[group_id] = signs_differ ? (rs2[31] ''^ signed_compare)\n                                                 : rs1[30:24] < rs2[30:24];'\"''')\n    else:\n        rtl=rtl.replace('  alu u_alu (', '  logic less_than;\\\\n  alu #(.EXTERNAL_COMPARE(1\\\\'b1)) u_alu (')\n        rtl=rtl.replace('    .b   (alu_b),','    .b   (alu_b),\\\\n    .compare_less (less_than),')\n        rtl=rtl.replace('logic signed_compare, less_than;', 'logic signed_compare;')\n        rtl=rtl.replace(\\\"assign signed_compare = \"'!in.ctrl.branch_op[1];\", \"assign signed_compare = in.ctrl.is_branch ? !in.ctrl.branch_op[1] : in.ctrl.alu_op == ALU_SLT;\")\n        rtl=rtl.replace('\"'rs2[START+:8]', 'alu_b[START+:8]').replace('rs2[31]', 'alu_b[31]').replace('rs2[30:24]', 'alu_b[30:24]')\n        if variant=='compare_shared_xor':\n            rtl=rtl.replace('''    if (group_id == 3) begin : gen_sign\n      assign less_group[group_id] =\n          {rs1[31] \"'^ signed_compare, rs1[30:24]} < {alu_b[31] ''^ signed_compare, alu_b[30:24]};\n    end else begin : gen_unsigned\n      assign less_group[group_id] = rs1[START+:8] < alu_b[START+:8];\n    end'\"''','''    assign less_group[group_id] = rs1[START+:8] < alu_b[START+:8];''')\n            rtl=rtl.replace('  assign less_than = less_group[3]', '  logic unsigned_less;\\\\n  assign unsigned_less = less_group[3]')\n            rtl=rtl.replace('  assign branch_cond =', '  assign less_than = unsigned_less \"'^ (signed_compare && (rs1[31] ''^ alu_b[31]));'\"\\\\n  assign branch_cond =')\n        alu=basedir/'alu.sv'\n        src=alu.read_text().replace('module alu (', \\\"module alu #(parameter bit EXTERNAL_COMPARE = 1'b0) (\\\")\n        src=src.replace('  output logic [31:0] out','  input logic         compare_less,\\\\n  output logic [31:0] out')\n        src=src.replace(\\\"\"'$signed(a) < $signed(b)\", \"EXTERNAL_COMPARE ? compare_less : $signed(a) < $signed(b)\")\n        src=src.replace(\"a < b\", \"EXTERNAL_COMPARE ? compare_less : a < b\")\n        alu.write_text(src)\n    p.write_text(rtl)\nPY\nexport PYTHONDONTWRITEBYTECODE=1\nstudy=\"$TMPDIR/fetch-target-study\"\nfor variant in compare_shared compare_shared_xor compare_high_sign; do\n python -m tools.eval.gowin bench --worktree \"$study/$variant\" --all-options --paths 1 > \"$study/$variant.timing\" 2>&1 &\ndone\nwait\nfor variant in compare_shared compare_shared_xor compare_high_sign; do\n printf '\"'%s\\\\n' \\\"\"'$variant\"\n rg '\"'Fmax|FAILED|  path 1:' \\\"\"'$study/$variant.timing\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c 'study=\"$TMPDIR/fetch-target-study\"\npython - \"$study\" <<'\"'PY'\nfrom pathlib import Path\nimport re,sys,json\np=Path(sys.argv[1])\nscores=[]; missing=[]\nfor f in p.glob('*.timing'):\n text=f.read_text()\n m=re.search(r'score Fmax \\\\(median\\\\): ([\\\\d.]+)',text)\n if m:\n  scores.append((float(m.group(1)),f.stem))\n elif text:\n  print(f.stem, text.splitlines()[-1])\n else:\n  missing.append(f.stem)\nprint(*sorted(scores,reverse=True)[:12],sep='\\\\n')\nprint('Pending',', '.join(sorted(missing)))\nd=json.loads((p/'branch_compare.coremark').read_text().splitlines()[-1])\nn=d['bench_stop_cycle']-d['bench_start_cycle']\nprint('Branch comparator measurement', n, 88.751e6*10/n, (88.751e6*10/n/216.99-1)*100, 'oob',d['oob'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c 'study=\"$TMPDIR/fetch-target-study\"\npython - \"$study\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot=Path(sys.argv[1])\nref=(root/'baseline/cores/bench/rtl/ex_stage.sv').read_text()\nref=ref[ref.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)'):ref.index('  assign jalr_sum')]\nref=ref.replace('in.ctrl.branch_op','op').replace('branch_cond','expected')\nfor name,op in zip(('BR_BEQ','BR_BNE','BR_BLT','BR_BGE','BR_BLTU','BR_BGEU'),(0,1,4,5,6,7)):\n ref=ref.replace(name,f\\\"3'd{op}\\\")\nimpl=(root/'branch_compare/cores/bench/rtl/ex_stage.sv').read_text()\nimpl=impl[impl.index('  logic [3:0] equal_group'):impl.index('  assign jalr_sum')]\nimpl=impl.replace('in.ctrl.branch_op','op')\nsrc='''module branch_predicate_miter(input logic [31:0] rs1, rs2,\n                              input logic [2:0] op, output logic correct);\n  logic expected, branch_cond;\n'''+ref+impl+'''  assign correct = op == 3'd2 || op == 3'd3 || expected == branch_cond;\nendmodule\n'''\n(root/'branch_predicate_miter.sv').write_text(src)\nPY\ncd \\\"\"'$study\" && yosys -Q -T -p '\"'read_verilog -sv branch_predicate_miter.sv; prep -top branch_predicate_miter; sat -verify -prove correct 1' | tail -n 14\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
