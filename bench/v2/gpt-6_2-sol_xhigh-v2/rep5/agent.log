{"type":"item.started","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/r9-loop.LeyVjy\"\ncat >> \"$scratch/stock/cores/bench/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\nasync def learned_loop_replay_and_fence_invalidation(dut):\n    base = 8\n    loop_insn = ADDI(2, 2, 1)\n    patched_insn = ADDI(2, 2, 9)\n    fence = 0x0000100F\n    program = {\n        0: ADDI(1, 0, 9),\n        4: ADDI(2, 0, 0),\n        8: loop_insn,\n        12: ADDI(1, 1, -1),\n        16: BNE(1, 0, -8),\n        20: BEQ(3, 0, 8),\n        24: EBREAK(),\n        28: fence,\n        32: ADDI(3, 0, 1),\n        36: ADDI(1, 0, 2),\n        40: JAL(0, -32),\n    }\n    seen = 0\n    stalled_before_fence = False\n    replayed_before_fence = False\n    fence_retired = False\n    post_fence_stalls = 0\n\n    def ready(addr):\n        nonlocal seen, stalled_before_fence, replayed_before_fence, fence_retired, post_fence_stalls\n        if stalled_before_fence:\n            replayed_before_fence = addr == base + 4\n            stalled_before_fence = False\n        if int(dut.io_rvfi_valid_0.value) and int(dut.io_rvfi_insn_0.value) == fence:\n            fence_retired = True\n            program[base] = patched_insn\n        if addr == base:\n            if fence_retired and post_fence_stalls < 3:\n                post_fence_stalls += 1\n                return False\n            seen += 1\n            if not fence_retired and seen == 7:\n                stalled_before_fence = True\n                return False\n        return True\n\n    retired, _ = await _run(dut, program, max_cycles=200, imem_ready=ready)\n    assert replayed_before_fence\n    assert fence_retired and post_fence_stalls == 3\n    assert [r[\\\"insn\\\"] for r in retired if r[\\\"pc\\\"] == base] == [loop_insn] * 9 + [patched_insn] * 2\n    assert [r[\\\"rd_wdata\\\"] for r in retired if r[\\\"pc\\\"] == base][-2:] == [18, 27]\nPY\ncd \\\"\"'$scratch/stock\"\nCOCOTB_TEST_FILTER='\"'learned_loop_replay_and_fence_invalidation\"'$'\"' PYTHONDONTWRITEBYTECODE=1 pytest -q -p no:cacheprovider cores/bench/test/test_pipeline.py > \\\"\"'$scratch/replay-directed.log\" 2>&1\ntail -50 \"$scratch/replay-directed.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/r9-loop.LeyVjy\"\ncat >> \"$scratch/stock/cores/bench/test/test_pipeline.py\" <<'\"'PY'\n\n\n@cocotb.test()\nasync def learned_loop_replay_and_fence_invalidation(dut):\n    base = 8\n    loop_insn = ADDI(2, 2, 1)\n    patched_insn = ADDI(2, 2, 9)\n    fence = 0x0000100F\n    program = {\n        0: ADDI(1, 0, 9),\n        4: ADDI(2, 0, 0),\n        8: loop_insn,\n        12: ADDI(1, 1, -1),\n        16: BNE(1, 0, -8),\n        20: BEQ(3, 0, 8),\n        24: EBREAK(),\n        28: fence,\n        32: ADDI(3, 0, 1),\n        36: ADDI(1, 0, 2),\n        40: JAL(0, -32),\n    }\n    seen = 0\n    stalled_before_fence = False\n    replayed_before_fence = False\n    fence_retired = False\n    post_fence_stalls = 0\n\n    def ready(addr):\n        nonlocal seen, stalled_before_fence, replayed_before_fence, fence_retired, post_fence_stalls\n        if stalled_before_fence:\n            replayed_before_fence = addr == base + 4\n            stalled_before_fence = False\n        if int(dut.io_rvfi_valid_0.value) and int(dut.io_rvfi_insn_0.value) == fence:\n            fence_retired = True\n            program[base] = patched_insn\n        if addr == base:\n            if fence_retired and post_fence_stalls < 3:\n                post_fence_stalls += 1\n                return False\n            seen += 1\n            if not fence_retired and seen == 7:\n                stalled_before_fence = True\n                return False\n        return True\n\n    retired, _ = await _run(dut, program, max_cycles=200, imem_ready=ready)\n    assert replayed_before_fence\n    assert fence_retired and post_fence_stalls == 3\n    assert [r[\\\"insn\\\"] for r in retired if r[\\\"pc\\\"] == base] == [loop_insn] * 9 + [patched_insn] * 2\n    assert [r[\\\"rd_wdata\\\"] for r in retired if r[\\\"pc\\\"] == base][-2:] == [18, 27]\nPY\ncd \\\"\"'$scratch/stock\"\nCOCOTB_TEST_FILTER='\"'learned_loop_replay_and_fence_invalidation\"'$'\"' PYTHONDONTWRITEBYTECODE=1 pytest -q -p no:cacheprovider cores/bench/test/test_pipeline.py > \\\"\"'$scratch/replay-directed.log\" 2>&1\ntail -50 \"$scratch/replay-directed.log\"'","aggregated_output":".                                                                        [100%]\n1 passed in 1.55s\n","exit_code":0,"status":"completed"}}
