{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c 'set -e\ntrial_dir=$(mktemp -d \"${TMPDIR:-/tmp}/bench-r5-address.XXXXXX\")\ngit archive HEAD | tar -x -C \"$trial_dir\"\npython - \"$trial_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1]) / 'cores/bench/rtl'\n\npkg = rtl / 'core_pkg.sv'\nsrc = pkg.read_text()\nsrc = src.replace('    logic [31:0] alu_result;\\\\n', '    logic [31:0] alu_result;\\\\n    logic [31:0] effective_addr;\\\\n', 1)\npkg.write_text(src)\n\nex = rtl / 'ex_stage.sv'\nsrc = ex.read_text()\nsrc = src.replace('  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\\\\n  /* verilator lint_on UNUSEDSIGNAL */', '''  logic [31:0] address_sum;\n  logic [12:0] address_lo;\n  logic [19:0] address_hi, base_hi, incremented_hi, decremented_hi;\n  logic select_increment, select_decrement, select_base;\n\n  assign address_lo     = {1'b0, rs1[11:0]} + {1'b0, in.imm[11:0]};\n  assign base_hi        = rs1[31:12];\n  assign incremented_hi = base_hi + 20'd1;\n  assign decremented_hi = base_hi - 20'd1;\n  assign select_increment = address_lo[12] && \"'!in.imm[11];\n  assign select_decrement = !address_lo[12] && in.imm[11];\n  assign select_base      = address_lo[12] == in.imm[11];\n  assign address_hi = ({20{select_increment}} & incremented_hi)\n                    | ({20{select_decrement}} & decremented_hi)\n                    | ({20{select_base}} & base_hi);\n  assign address_sum = {address_hi, address_lo[11:0]};'\"''')\nsrc = src.replace('  assign jalr_sum = rs1 + in.imm;\\\\n  assign target = in.ctrl.is_jalr ? {jalr_sum[31:1]', '  assign target = in.ctrl.is_jalr ? {address_sum[31:1]')\nsrc = src.replace('      reg_q.alu_result    <= ex_result;\\\\n', '      reg_q.alu_result    <= ex_result;\\\\n      reg_q.effective_addr <= address_sum;\\\\n')\nassert 'jalr_sum' not in src\nex.write_text(src)\n\nmem = rtl / 'mem_stage.sv'\nsrc = mem.read_text()\nprefix, wb = src.split('  logic [31:0] wb_result;', 1)\nmem.write_text(prefix.replace('in.alu_result', 'in.effective_addr') + '  logic [31:0] wb_result;' + wb)\nPY\nprintf '%s\\\\n' \\\"\"'$trial_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
