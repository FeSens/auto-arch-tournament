or_q\\\")\ns=s.replace(\\\"remainder_q       <= {28'b0, small_divisor ? prefix_second[3:0] : a_mag_hi};\\\",\\\"remainder_q       <= {24'b0, small_divisor ? prefix8[7:0] : a_mag_hi};\\\")\ns=s.replace(\\\"small_divisor ? {prefix_first[5:4], prefix_second[5:4]} : 4'b0\\\", \\\"small_divisor ? {prefix2[3:2], prefix4[5:4], prefix6[7:6], prefix8[9:8]} : 8'b0\\\")\ns=s.replace(\\\"&& (b \"'!= 0)\", \"&& (b_q != 0)\")\np.write_text(s)\nPY\npython3 -m tools.eval.gowin bench --worktree \"$TMPDIR/divider-hypothesis\" --all-options'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
