{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch=Path(os.environ['TMPDIR'])/'fetch-target-study'\nfor variant in ('pht_gray', 'pht_ram', 'pht_banked', 'pht_1hot', 'fetch_imm_bit', 'queue_exchange'):\n    dest=scratch/variant\n    shutil.copytree(scratch/'baseline/cores/bench', dest/'cores/bench', ignore=shutil.ignore_patterns('generated','obj_dir'))\n    for name in ('bench','tools','test','Makefile','fpga'):\n        (dest/name).symlink_to(scratch/name, target_is_directory=(name\"'!='\"'Makefile'))\n    path=dest/'cores/bench/rtl/if_stage.sv'\n    rtl=path.read_text()\n    if variant=='fetch_imm_bit':\n        rtl=rtl.replace('offset_word = {is_jal ?', 'offset_word = {imem_data[2] ?')\n        rtl=rtl.replace('is_jal ? imem_data[24:22]', 'imem_data[2] ? imem_data[24:22]')\n        rtl=rtl.replace('direct_bit1 = is_jal ?', 'direct_bit1 = imem_data[2] ?')\n    elif variant=='queue_exchange':\n        rtl=rtl.replace('response_valid && \"'!full && !reset'\"', 'response_valid && (\"'!full || issue_candidate) && !reset'\"')\n    else:\n        a,b=rtl.index('  logic [1:0]  counters'),rtl.index('  logic        is_branch, is_jal;')\n        gray='''  logic        update_valid_q, update_taken_q;\n  logic [5:0]  update_index_q;\n  logic [1:0]  update_counter, next_counter;\n\n  assign next_counter[1] = update_counter[0] ? update_taken_q : update_counter[1];\n  assign next_counter[0] = update_taken_q \"'^ update_counter[1];\n'\"'''\n        control='''  always_ff @(posedge clock) begin\n    if (reset) begin\n      history_q      <= 2'b00;\n      update_valid_q <= 1'b0;\n      update_taken_q <= 1'b0;\n      update_index_q <= 6'b0;\n    end else begin\n      update_valid_q <= train_branch;\n      if (train_branch) begin\n        history_q      <= {history_q[0], train_taken};\n        update_index_q <= train_index;\n        update_taken_q <= train_taken;\n      end\n    end\n  end\n\n'''\n        if variant=='pht_gray':\n            table='''  logic [1:0] counters [0:63];\n  assign update_counter = counters[update_index_q];\n  always_ff @(posedge clock) begin\n    if (reset)\n      for (int i=0; i<64; i++) counters[i] <= 2'b01;\n    else if (update_valid_q)\n      counters[update_index_q] <= next_counter;\n  end\n\n'''\n            taken='counters[prediction_index][1]'\n        elif variant=='pht_ram':\n            table='''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [1:0] counters [0:63];\n  logic [63:0] written_q;\n  assign update_counter = written_q[update_index_q] ? counters[update_index_q] : 2'b01;\n\n  always_ff @(posedge clock)\n    if (\"'!reset && update_valid_q)\n      counters[update_index_q] <= next_counter;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      written_q <= '\"'0;\n    else if (update_valid_q)\n      written_q[update_index_q] <= 1'b1;\n  end\n\n'''\n            taken='written_q[prediction_index] && counters[prediction_index][1]'\n        else:\n            table='''  logic [3:0] bank_taken;\n  logic [3:0] bank_update_taken, bank_update_strong;\n  assign update_counter = {|bank_update_taken, \"'!(|bank_update_strong)};\n\n  for (genvar bank=0; bank<4; bank++) begin : gen_counter_bank\n    (* syn_ramstyle = \"distributed_ram\" *) logic [1:0] counters [0:15];\n    logic [15:0] written_q;\n    logic update_bank, predict_bank;\n    logic [1:0] current_counter;\n    assign update_bank = update_index_q[5:4] == 2'\"'(bank);\n    assign predict_bank = prediction_index[5:4] == 2'(bank);\n    assign current_counter = counters[update_index_q[3:0]];\n    assign bank_update_taken[bank] = update_bank && written_q[update_index_q[3:0]] && current_counter[1];\n    assign bank_update_strong[bank] = update_bank && written_q[update_index_q[3:0]] && \"'!current_counter[0];\n    assign bank_taken[bank] = predict_bank && written_q[prediction_index[3:0]] &&\n                              counters[prediction_index[3:0]][1];\n    always_ff @(posedge clock) begin\n      if (!reset && update_valid_q && update_bank)\n        counters[update_index_q[3:0]] <= next_counter;\n    end\n    always_ff @(posedge clock) begin\n      if (reset)\n        written_q <= '\"'0;\n      else if (update_valid_q && update_bank)\n        written_q[update_index_q[3:0]] <= 1'b1;\n    end\n  end\n\n'''\n            if variant=='pht_1hot':\n                table=table.replace('logic [15:0] written_q;', 'logic [15:0] written_q;\\\\n    logic [15:0] next_written;')\n                table=table.replace('    always_ff @(posedge clock) begin\\\\n      if (reset)', '''    assign next_written = written_q | (16'b1 << update_index_q[3:0]);\n    always_ff @(posedge clock) begin\n      if (reset)''').replace(\\\"written_q[update_index_q[3:0]] <= 1'b1;\\\", 'written_q <= next_written;')\n            taken='|bank_taken'\n        rtl=rtl[:a]+gray+table+control+rtl[b:]\n        rtl=rtl.replace('counters[prediction_index][1];', taken+';')\n        rtl=rtl.replace('  logic [5:0]  prediction_index;\\\\n','')\n        rtl=rtl.replace('  logic [1:0]  history_q;', '  logic [1:0]  history_q;\\\\n  logic [5:0]  prediction_index;')\n    path.write_text(rtl)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
