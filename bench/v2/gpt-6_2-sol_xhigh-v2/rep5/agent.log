m, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1,\n…[8623 of 11695 chars elided by tools/bench/transcript.py; sha256:afe6ce8f2c3b7685]…\nssert (ren, wen) == (0, 0)\n        return True\n\n    rets, _ = await _run(dut, program, dmem_ready=ready)\n    assert [r[\"insn\"] for r in rets] == program\n    fault, consumer = rets[2:4]\n    assert (fault[\"trap\"], fault[\"rd\"], fault[\"rd_wdata\"]) == (1, 0, 0)\n    assert (fault[\"mem_rmask\"], fault[\"mem_wmask\"]) == (0, 0)\n    assert (consumer[\"rs1_rdata\"], consumer[\"rs2_rdata\"], consumer[\"rd_wdata\"]) == (30, 30, 60)\n    assert consumer[\"cycle\"] - fault[\"cycle\"] == 1\n\n\n@cocotb.test()\ntotal 60\ndrwxrwx---+ 5 nobody nogroup  4096 Nov 22 17:39 .\ndrwxrwx---+ 3 nobody nogroup  4096 Nov 22 17:39 ..\n-rw-rw----+ 1 nobody nogroup     0 Nov 22 17:39 CORE_PHILOSOPHY.md\n-rw-rw----+ 1 nobody nogroup 12591 Nov 22 17:39 LESSONS.md\n-rw-rw----+ 1 nobody nogroup   546 Nov 22 17:39 core.yaml\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 22 17:39 experiments\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 22 17:39 rtl\ndrwxrwx---+ 2 nobody nogroup  4096 Nov 22 17:39 test\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\n", "exit_code": 0, "status": "completed"}}
