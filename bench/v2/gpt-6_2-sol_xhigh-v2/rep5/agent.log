{"type": "item.completed", "item": {"id": "item_40", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/results_split.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\nalu_orig = (base / 'alu.sv').read_text()\nalu_orig = alu_orig.replace('  output logic [31:0] out\\\\n', '''  output logic [31:0] out,\n  output logic [31:0] alu_add,\n  output logic [31:0] alu_sub,\n  output logic [31:0] alu_other\n''')\nalu_orig = alu_orig.replace('''  assign out = ({32{sel.add}} & (a + b))\n             | ({32{sel.sub}} & (a - b))\n             | ({32{sel.and_op}} & (a & b))''', '''  assign alu_add = ({32{sel.add}} & (a + b));\n  assign alu_sub = ({32{sel.sub}} & (a - b));\n  assign out = alu_add | alu_sub | alu_other;\n  assign alu_other = ({32{sel.and_op}} & (a & b))''')\nfor variant in ('split_math', 'split_add', 'split_three', 'split_math_flat', 'compact_alu', 'pre_mask_rf'):\n    path = scratch / variant\n    shutil.copytree(base, path)\n    if variant == 'compact_alu':\n        s = (base / 'alu.sv').read_text()\n        s = s.replace('  logic [31:0] shift_right;', '  logic [31:0] shift_right, bitwise;\\\\n  logic enable_diff, enable_both;')\n        s = s.replace('  assign out =', '''  assign enable_diff = sel.xor_op || sel.or_op;\n  assign enable_both = sel.and_op || sel.or_op;\n  assign bitwise = ({32{enable_diff}} & (a \"'^ b)) | ({32{enable_both}} & (a & b));\n  assign out ='\"''')\n        s = s.replace('''({32{sel.and_op}} & (a & b))\n             | ({32{sel.or_op}} & (a | b))\n             | ({32{sel.xor_op}} & (a \"'^ b))'\"''', 'bitwise')\n        (path / 'alu.sv').write_text(s)\n        continue\n    if variant == 'pre_mask_rf':\n        p = path / 'id_stage.sv'\n        p.write_text(p.read_text().replace('<= rs1_data;', \\\"<= rs1_sel.reg_file ? rs1_data : '0;\\\").replace('<= rs2_data;', \\\"<= rs2_sel.reg_file ? rs2_data : '0;\\\"))\n        p = path / 'ex_stage.sv'\n        p.write_text(p.read_text().replace('({32{in.rs1_sel.reg_file}} & in.rs1_val)', 'in.rs1_val').replace('({32{in.rs2_sel.reg_file}} & in.rs2_val)', 'in.rs2_val'))\n        continue\n\n    (path / 'alu.sv').write_text(alu_orig)\n    p = path / 'core_pkg.sv'\n    s = p.read_text().replace('    logic [31:0] alu_result;', '    logic [31:0] alu_result, alu_math;')\n    if variant == 'split_three':\n        s = s.replace('alu_result, alu_math;', 'alu_result, alu_math, alu_sub;')\n    p.write_text(s)\n    split_two = variant \"'!= '\"'split_three'\n    factor = variant == 'split_math_flat'\n    p = path / 'ex_stage.sv'\n    s = p.read_text().replace('  logic [31:0] alu_result;', '  logic [31:0] alu_result, alu_add, alu_sub, alu_other;')\n    s = s.replace('    .out (alu_result)', '    .out (),\\\\n    .alu_add (alu_add),\\\\n    .alu_sub (alu_sub),\\\\n    .alu_other (alu_other)')\n    s = s.replace('  assign ex_result = alu_result', '  assign ex_result = alu_other' + (' | alu_sub' if variant == 'split_add' else ''))\n    s = s.replace('      reg_q.alu_result    <= ex_result;', '      reg_q.alu_result    <= ex_result;\\\\n      reg_q.alu_math      <= alu_add' + (' | alu_sub;' if variant in ('split_math', 'split_math_flat') else ';'))\n    if not split_two:\n        s = s.replace('      reg_q.alu_math      <= alu_add;', '      reg_q.alu_math      <= alu_add;\\\\n      reg_q.alu_sub       <= alu_sub;')\n    if factor:\n        for r in ('rs1', 'rs2'):\n            s = s.replace(f\\\"({{32{{in.{r}_sel.ex_mem}}}}   & fwd_ex_mem)\\\", f\\\"({{32{{in.{r}_sel.ex_mem}}}}  & fwd_ex_mem)\\\\n             | ({{32{{in.{r}_sel.ex_mem}}}}  & fwd_ex_math)\\\")\n        s = s.replace('  input  logic [31:0]        fwd_ex_mem,', '  input  logic [31:0]        fwd_ex_math,\\\\n  input  logic [31:0]        fwd_ex_mem,')\n    p.write_text(s)\n    p = path / 'core.sv'\n    s = p.read_text()\n    if factor:\n        s = s.replace('.fwd_ex_mem      (ex_mem_w.alu_result),', '.fwd_ex_mem      (ex_mem_w.alu_result),\\\\n    .fwd_ex_math     (ex_mem_w.alu_math),')\n    else:\n        s = s.replace('.fwd_ex_mem      (ex_mem_w.alu_result),', '.fwd_ex_mem      (ex_mem_w.alu_result | ex_mem_w.alu_math' + (' | ex_mem_w.alu_sub' if not split_two else '') + '),')\n    p.write_text(s)\n    p = path / 'mem_stage.sv'\n    s = p.read_text()\n    s = s.replace('& in.alu_result)', '& (in.alu_result | in.alu_math' + (' | in.alu_sub' if not split_two else '') + '))')\n    p.write_text(s)\nPY\npython /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/results_split.py\npython -u /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/time_variants.py split_math:1 split_add:1 split_three:1 split_math_flat:1 compact_alu:1 pre_mask_rf:1\"", "aggregated_output": "split_add 1 84.899 4691 4 cpu/u_if/ex_recovery_s0 cpu/u_id/reg_q.direct_target_29_s0 \nsplit_math 1 87.138 4661 4 cpu/u_mem/reg_q.result_10_s0 cpu/u_if/ex_recovery_s0 \nsplit_three 1 91.223 4743 4 cpu/u_if/mem_recovery_s0 cpu/u_id/reg_q.holds_fetch_s0 \ncompact_alu 1 83.118 4639 4 cpu/u_ex/reg_q.alu_result_1_s0 cpu/u_ex/reg_q.alu_result_31_s0 \nsplit_math_flat 1 88.56 4745 4 cpu/u_mem/reg_q.result_14_s0 cpu/u_if/ex_recovery_s0 \npre_mask_rf 1 86.768 4673 4 cpu/u_ex/u_divider/a_q_3_s0 cpu/u_ex/u_divider/remainder_q_0_s0 \n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/payload_variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\nfor variant, do_id, do_if, do_ex in [\n    ('capture_id', True, False, 0),\n    ('capture_if', False, True, 0),\n    ('capture_ex', False, False, 1),\n    ('capture_ex_more', False, False, 2),\n    ('capture_ifid', True, True, 0),\n    ('capture_idex', True, False, 1),\n    ('capture_all', True, True, 2),\n]:\n    p = scratch / variant\n    shutil.copytree(base, p)\n    if do_id:\n        f = p / 'id_stage.sv'\n        f.write_text(f.read_text().replace('    if (issue_candidate) begin', '    if (\"'!hold) begin'\"'))\n    if do_if:\n        f = p / 'if_stage.sv'\n        f.write_text(f.read_text().replace('    if (accept_response)\\\\n      fifo', '    if (\"'!full && !reset)'\"\\\\n      fifo'))\n    if do_ex:\n        f = p / 'ex_stage.sv'\n        s = f.read_text()\n        fields = ['alu_result']\n        if do_ex == 2:\n            fields += ['late_operand', 'branch_cond', 'predicted_taken', 'prediction_index', 'branch_target', 'pc_plus_4', 'recovery_word']\n        decl, body = [], []\n        for field in fields:\n            capture_line = next(l for l in s.splitlines() if f' reg_q.{field} ' in l and '<=' in l)\n            logic = 'logic [31:0]'\n            logic = {'branch_cond': 'logic', 'predicted_taken': 'logic', 'prediction_index': 'logic [5:0]', 'recovery_word': 'logic [31:2]'}.get(field, logic)\n            expr = capture_line.split('<= ', 1)[1].strip()\n            decl.append(f'  {logic} {field}_q;')\n            body.extend([f\\\"    if (reset) {field}_q <= '0;\\\", f'    else {field}_q <= {expr}'])\n            s = s.replace(capture_line+'\\\\n', '')\n        output_tail = '\\\\n'.join(decl) + '\\\\n  always_ff @(posedge clock) begin\\\\n' + '\\\\n'.join(body) + '\\\\n  end\\\\n\\\\n  always_comb begin\\\\n    out = reg_q;\\\\n' + '\\\\n'.join(f'    out.{f} = {f}_q;' for f in fields) + '\\\\n  end'\n        s = s.replace('  assign out = reg_q;', output_tail)\n        f.write_text(s)\nPY\npython /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/payload_variants.py\npython -u /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/time_variants.py capture_id:1 capture_ex:1 capture_if:1 capture_ifid:1 capture_ex_more:1 capture_idex:1 capture_all:1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
