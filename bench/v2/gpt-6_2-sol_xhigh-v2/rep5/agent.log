gic levels; logic 3409, registers 732, LUT-RAM 8, BSRAM 6, DSP 3\n  path 1: 23.6 ns, 25 cells, cpu/u_rf/regs_regs_0_0_s -> cpu/u_ex/u_divider/remainder_q_2_s1\n          through: clock_ibuf > cpu/u_id > cpu/u_ex > cpu/u_ex/u_divider\n  path 2: 23.572 ns, 25 cells, cpu/u_rf/regs_regs_0_0_s -> cpu/u_ex/u_divider/remainder_q_3_s1\n          through: clock_ibuf > cpu/u_id > cpu/u_ex > cpu/u_ex/u_divider\n  path 3: 23.489 ns, 30 cells, cpu/u_mem/reg_q.rd_1_s0 -> cpu/u_id/id_ex_w.rs1_val_26_s1\n          through: clock_ibuf > cpu/u_fwd > cpu/u_ex > cpu/u_id\n  path 4: 23.42 ns, 18 cells, cpu/u_ex/reg_q.rd_2_s0 -> dmem_2_dmem_2_0_0_s\n          through: clock_ibuf > cpu/u_fwd > cpu/u_ex > cpu/u_ex/u_alu > cpu/u_ex\n  full report: /srv/hwebench/tmp/7c172beb/a7cc6138/m-return-prototype/cores/bench/generated/timing/gowin_p2/impl/pnr/core_bench.tr\nscore Fmax (median): 54.627 MHz\n","exit_code":0,"status":"completed"}}
{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nbase = Path('cores/bench/test')\nalu = base / 'test_alu.py'\ns = alu.read_text()\ni = s.index('@cocotb.test()\\\\nasync def mul(')\nj = s.index('def test_alu_runner')\nexisting_mul = s[i:j].replace('    await _setup(dut)\\\\n', '    await _reset(dut)\\\\n')\nalu.write_text((s[:i]+s[j:]).replace('    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\\\\n', ''))\n(base / 'test_multiplier.py').write_text('''\\\"\\\"\\\"Arithmetic checks for the EX/MEM multiplier.\\\"\\\"\\\"\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \\\"ns\\\")\n    dut.clock.value = 1\n    await Timer(5, \\\"ns\\\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.issue.value = 0\n    await _edge(dut)\n    dut.reset.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.op.value = op\n    dut.issue.value = 1\n    await _edge(dut)\n    assert int(dut.result.value) == expected & MASK32\n    dut.issue.value = 0\n\n\n''' + existing_mul + '''@cocotb.test()\nasync def random_consecutive_and_hold(dut):\n    await _reset(dut)\n    rng = Random(87)\n    corners = [0, 1, -1, -2**31, 2**31 - 1, 0xffff, 0x8000, 0x80008000, 0x80000000, 0xffffffff]\n    pairs = [(a & MASK32, b & MASK32) for a in corners for b in corners]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(256)]\n    for a, b in pairs:\n        sa = a if a < 2**31 else a - 2**32\n        sb = b if b < 2**31 else b - 2**32\n        for op, expected in (\n            (ALU_MUL, a*b), (ALU_MULHU, (a*b) >> 32),\n            (ALU_MULH, (sa*sb) >> 32), (ALU_MULHSU, (sa*b) >> 32),\n        ):\n            await _check(dut, op, a, b, expected)\n    dut.a.value = 0\n    dut.b.value = 0\n    await _edge(dut)\n    assert int(dut.result.value) == expected & MASK32\n\n\ndef test_multiplier_runner():\n    run_cocotb(\\\"multiplier\\\", [\\\"core_pkg.sv\\\", \\\"multiplier.sv\\\"], \\\"test_multiplier\\\")\n''')\n\ndiv = base / 'test_divider.py'\ns = div.read_text().replace('for cycle in range(1, 7):','for cycle in range(1, 8):')\ns = s.replace('        assert dut.result_valid.value == (cycle == 6), f\\\"work cycle {cycle}\\\"',\n    '        assert dut.final_step.value == (cycle == 6), f\\\"work cycle {cycle}\\\"\\\\n'\n    '        assert dut.result_valid.value == (cycle == 7), f\\\"work cycle {cycle}\\\"')\ns = s.replace('    dut.accept.value = 1\\\\n    await _finish(dut)\\\\n    dut.accept.value = 0',\n    '    await _finish(dut)')\ns += '''\n\n@cocotb.test()\nasync def transfer_on_final_work_edge(dut):\n    await _reset(dut)\n    await _launch(dut, ALU_DIVU, 0xfffffffe, 0xf)\n    for _ in range(6):\n        await _edge(dut)\n    assert dut.final_step.value == 1\n    assert dut.result_valid.value == 0\n    dut.accept.value = 1\n    await _edge(dut)\n    assert dut.idle.value == 1\n    assert dut.result_valid.value == 0\n    assert int(dut.result.value) == 0xfffffffe // 0xf\n'''\ndiv.write_text(s)\n\npipe = base / 'test_pipeline.py'\ns = pipe.read_text()\ns = s.replace('\\\"alu.sv\\\", \\\"divider.sv\\\", \\\"decoder.sv\\\"', '\\\"alu.sv\\\", \\\"divider.sv\\\", \\\"multiplier.sv\\\", \\\"decoder.sv\\\"')\ns = s.replace('assert consumer[\\\"cycle\\\"] - div[\\\"cycle\\\"] == 1', 'assert consumer[\\\"cycle\\\"] - div[\\\"cycle\\\"] == 2')\ns = s.replace('assert rem[\\\"cycle\\\"] - div[\\\"cycle\\\"] == 8', 'assert rem[\\\"cycle\\\"] - div[\\\"cycle\\\"] == 9')\ns += '''\n\n@cocotb.test()\nasync def multiply_dependency_pipeline(dut):\n    def mul(rd, rs1, rs2):\n        return _r(1, rs2, rs1, 0, rd, 0b0110011)\n\n    program = [\n        ADDI(1, 0, 7),     # 0\n        ADDI(2, 0, 3),     # 4\n        mul(3, 1, 2),      # 8\n        mul(4, 2, 2),      # 12\n        ADDI(5, 4, 1),     # 16\n        SW(5, 0, 0x40),    # 20\n        mul(6, 3, 4),      # 24, held until the store completes\n        DIVU(7, 6, 2),     # 28, dependent divide\n        BEQ(0, 0, 8),      # 32, cold taken\n        mul(7, 2, 2),      # 36, wrong path\n        SW(7, 0, 0x44),    # 40\n        EBREAK(),          # 44\n    ]\n    requests = []\n\n    def ready(addr, ren, wen):\n        if ren or wen:\n            requests.append(addr)\n        return not (ren or wen) or len(requests) > 3\n\n    rets, dmem = await _run(dut, program, dmem_ready=ready)\n    assert requests == [0x40] * 4 + [0x44]\n    assert dmem == {0x40: 10, 0x44: 63}\n    assert [r[\\\"pc\\\"] for r in rets] == list(range(0, 36, 4)) + [40, 44]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    retires = {r[\\\"pc\\\"]: r for r in rets}\n    assert retires[12][\\\"cycle\\\"] - retires[8][\\\"cycle\\\"] == 1\n    assert retires[16][\\\"cycle\\\"] - retires[12][\\\"cycle\\\"] == 2\n    assert retires[28][\\\"cycle\\\"] - retires[24][\\\"cycle\\\"] == 9\n    assert retires[28][\\\"rs1_rdata\\\"] == 189\n'''\npipe.write_text(s)\nPY\npytest -q cores/bench/test/ > unit-summary.log 2>&1\ntail -20 unit-summary.log\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
