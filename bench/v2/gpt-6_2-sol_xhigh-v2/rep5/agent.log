{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY' > \\\"\"'$TMPDIR/bench-address-proof.log\" 2>&1\n\nimport subprocess\n\nrtl = \"cores/bench/rtl\"\nprivate_displacement = \"in.mem_displacement = offset;\" if \"mem_displacement\" in open(f\"{rtl}/core_pkg.sv\").read() else \"\"\nsource = f\"\"\"\nmodule bench_address_check (\n  input clock, reset, stall, valid, store,\n  input [1:0] source_select, width,\n  input [31:0] rf_base, ex_base, wb_base,\n  input [11:0] offset,\n  output ok\n);\n  id_ex_t in;\n  ex_mem_t ex_in, ex_out;\n  logic [31:0] bus_addr;\n  logic bus_ren;\n  logic [3:0] bus_wen;\n  logic [31:0] base, sum, addr_q;\n  logic aligned, rd_q;\n  logic [3:0] mask, wen_q;\n\n  always_comb begin\n    in = '\"'0;\n    in.valid = valid;\n    in.ctrl.mem_read = \"'!store;\n    in.ctrl.mem_write = store;\n    in.ctrl.mem_width = width;\n    in.rs1_val = rf_base;\n    in.imm = {{{{20{{offset[11]}}}}, offset}};\n    {private_displacement}\n    in.mem_base_sel.reg_file = source_select == 2'\"'d1;\n    in.mem_base_sel.ex_mem = source_select == 2'd2;\n    in.mem_base_sel.mem_wb = source_select == 2'd3;\n    in.mem_base_zero = source_select == 2'd0;\n    in.rs1_sel = in.mem_base_sel;\n  end\n\n  ex_stage ex (.clock(clock), .reset(reset), .stall(stall), .mem_recovery(1'b0),\n               .in(in), .fwd_ex_mem(ex_base), .fwd_mem_wb(wb_base),\n               .mem_next_write(1'b0), .out(ex_out));\n  mem_stage mem (.clock(clock), .reset(reset), .hold_wb(stall), .recovery(1'b0),\n                 .in(ex_out), .multiply_result(32'b0), .divide_result(32'b0),\n                 .dmem_addr(bus_addr), .dmem_rdata(32'b0),\n                 .dmem_wen(bus_wen), .dmem_ren(bus_ren));\n\n  assign base = source_select == 2'd1 ? rf_base :\n                source_select == 2'd2 ? ex_base :\n                source_select == 2'd3 ? wb_base : 32'b0;\n  assign sum = base + {{{{20{{offset[11]}}}}, offset}};\n  assign aligned = (