s)\nprint('early_loads',early_loads, 'sum',sum(early_loads.values()))\nPY\npython3 \\\"\"'$profile_dir/profile.py\" \"$profile_dir/trace.jsonl\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
