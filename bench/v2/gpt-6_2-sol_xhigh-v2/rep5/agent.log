{"type": "item.completed", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'head -100 tools/eval/fpga.py && git check-ignore -v cores/bench/experiments/hypotheses/hyp-20261122-002-r15s1.yaml && ls -d \"$TMPDIR/r15-profile\"'", "aggregated_output": "\"\"\"FPGA fitness: vendor (Gowin EDA) Fmax x CoreMark iterations per cycle.\n\nThe Yosys + nextpnr helpers below (run_seed, _run_perturbations, ...) are\nkept for the research scripts that document the V1 flow; the eval uses\ntools/eval/gowin.py.\n\"\"\"\nimport asyncio, os, re, json, subprocess, statistics\nfrom pathlib import Path\n\nfrom tools.eval import gowin\n\nfrom tools.eval.formal import read_nret\nfrom tools.eval._subprocess import run_pgroup\n\n\ndef _build_synth_env(worktree, target: str | None,\n                     base_env: dict | None = None) -> dict:\n    \"\"\"Build the env for `yosys -c fpga/scripts/synth.tcl`.\n\n    Reads cores/<target>/core.yaml's `nret` field (defaults to 2). When\n    nret=1, injects BENCH=fpga/core_bench_si.sv so synth.tcl reads the\n    single-issue FPGA wrapper (only `_0` RVFI ports) instead of the\n    default dual-channel core_bench.sv. nret=2 leaves BENCH unset and\n    synth.tcl falls back to fpga/core_bench.sv.\n    \"\"\"\n    worktree_path = Path(worktree).resolve()\n    env = dict(base_env) if base_env is not None else os.environ.copy()\n    if target is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"GEN_DIR\"] = f\"cores/{target}/generated\"\n    nret = read_nret(worktree_path / \"cores\" / target / \"core.yaml\")\n    if nret == 1:\n        env[\"BENCH\"] = \"fpga/core_bench_si.sv\"\n    return env\n\nSEEDS = [1, 2, 3]\n# Fmax is scored over (perturbation, seed) pairs. Perturbation k adds an\n# unused k-assign module to synthesis (k=0: the netlist `make` built);\n# neutral changes like this move a design's Fmax by far more than nextpnr\n# seeds do (EXP-2026-09-27-v2-placement-noise), so one netlist is one\n# draw. Set from that calibration; see research/v2/NOTES.md.\n# 9 pairs: one wave on the run host (EXP-2026-09-28-v2-noise-server fixes\n# P=9 and derives the acceptance margin for it).\nPERTURBATIONS = [(0, 1)] + [(7 * i, i + 1) for i in range(1, 9)]\n# The final champion's Fmax for the headline score is measured afresh on\n# perturbations and seeds the loop never used: the loop's number was\n…[1924 of 4996 chars elided by tools/bench/transcript.py; sha256:e7db31c1a91274af]…\nwith the ELF.\"\"\"\n    path = Path(worktree).resolve() / PORTME_H\n    if not path.exists():\n        raise RuntimeError(f\"{path} not found — can't determine CoreMark ITERATIONS\")\n    m = re.search(r'^\\s*#\\s*define\\s+ITERATIONS\\s+(\\d+)', path.read_text(), re.MULTILINE)\n    if not m:\n        raise RuntimeError(f\"ITERATIONS not found in {path}\")\n    return int(m.group(1))\n\nasync def run_seed(seed: int, worktree: str, outdir: str, env: dict | None = None) -> dict:\n    # cwd=worktree: nextpnr_run.sh reads generated/synth.json and fpga/constraints/*\n    # as worktree-relative paths. Without cwd, it would read from the caller's cwd\n    # (e.g., repo root) and we'd score the wrong design.\n    proc = await asyncio.create_subprocess_exec(\n        \"bash\", NEXTPNR_SCRIPT, str(seed), outdir,\n        stdout=asyncio.subprocess.PIPE,\n        stderr=asyncio.subprocess.PIPE,\n.gitignore:88:cores/*/experiments/hypotheses/\tcores/bench/experiments/hypotheses/hyp-20261122-002-r15s1.yaml\n/srv/hwebench/tmp/7c172beb/5e606e76/r15-profile\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c 'cp -a cores/bench/rtl \"$TMPDIR/r15-profile/restart_rtl\"\ncat > \"$TMPDIR/r15-profile/make_restart.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nrtl = Path(os.environ['TMPDIR']) / 'r15-profile' / 'restart_rtl'\n\ndef edit(file, replacements):\n    path = rtl / file\n    data = path.read_text()\n    for before, after in replacements:\n        assert data.count(before) == 1, before\n        data = data.replace(before, after)\n    path.write_text(data)\n\nedit('core_pkg.sv', [\n    ('    logic        holds_fetch;\\\\n    logic        late_eligible;',\n     '    logic        holds_fetch;\\\\n    logic        restart_packet;\\\\n    logic        late_eligible;'),\n    ('    logic        holds_fetch;\\\\n    logic [31:0] rs1_val;',\n     '    logic        holds_fetch;\\\\n    logic        restart_packet;\\\\n    logic [31:0] rs1_val;'),\n])\nedit('id_stage.sv', [\n    ('      reg_q.holds_fetch      <= in.holds_fetch;',\n     '      reg_q.holds_fetch      <= in.holds_fetch;\\\\n      reg_q.restart_packet   <= in.restart_packet;'),\n])\nedit('if_stage.sv', [\n    ('  logic [31:2] pc_word, sequential_q, retry_q, ex_target_q, mem_target_q;',\n     '''  logic [31:2] pc_word, sequential_q, retry_q, ex_target_q, mem_target_q;\n  logic [31:2] normal_word, restart_word, resume_word_q;\n  logic        resume_select_q;\n  logic [9:0]  restart_sum_lo, restart_sum_mid;\n  logic [5:0]  restart_index;'''),\n    ('assign pc_upper = pc_word[31:20];','assign pc_upper = normal_word[31:20];'),\n    (\\\"{1'b0, pc_word[19:2]} + {1'b0, offset_word[19:2]}\\\",\n     \\\"{1'b0, normal_word[19:2]} + {1'b0, offset_word[19:2]}\\\"),\n    ('assign prediction_index = pc_word[7:2] \"'^ {4'\"\\\\'b0, history_q};',\n     '''assign prediction_index = normal_word[7:2] \"'^ {4'\"'b0, history_q};\n  assign restart_index    = restart_word[7:2] \"'^ {4'\"'b0, history_q};\n  assign restart_sum_lo  = {1'b0, restart_word[10:2]} + {1'b0, offset_word[10:2]};\n  assign restart_sum_mid = {1'b0, restart_word[19:11]} + {1'b0, offset_word[19:11]};'''),\n    ('  assign hold_last_word = pc_word == LAST_IMEM_WORD && \"'!predicted_taken;'\"',\n     '''  logic normal_hold_last, restart_hold_last;\n  assign normal_hold_last = normal_word == LAST_IMEM_WORD && \"'!predicted_taken;\n  assign restart_hold_last = restart_word == LAST_IMEM_WORD;\n  assign hold_last_word = recovering ? restart_hold_last : normal_hold_last;'\"'''),\n    ('  assign advance_request = resume_fetch || (accept_response && \"'!hold_last_word);'\"',\n     '  assign advance_request = resume_fetch || (accept_response && \"'!normal_hold_last);'\"'),\n    ('''  assign pc_word = ({30{mem_recovery}} & mem_target_q)\n                 | ({30{ex_recovery && \"'!mem_recovery}} & ex_target_q)\n                 | ({30{sequential_select_q && !recovering}} & sequential_q)\n                 | ({30{predicted_select_q && !recovering}} & {12'\"'b0, prediction_q})\n                 | ({30{retry_select_q && \"'!recovering}} & retry_q);'\"''',\n     '''  assign restart_word = mem_recovery ? mem_target_q : ex_target_q;\n  assign normal_word = ({30{sequential_select_q}} & sequential_q)\n                     | ({30{predicted_select_q}} & {12'b0, prediction_q})\n                     | ({30{retry_select_q}} & retry_q)\n                     | ({30{resume_select_q}} & resume_word_q);\n  assign pc_word = recovering ? restart_word : normal_word;'''),\n    ('''    sequential_q <= pc_word + 30'd1;\n    prediction_q <= direct_word[19:2];\n    retry_q <= reset ? '0 : pc_word;\n    sequential_select_q <= \"'!reset && advance_request && (resume_fetch || !predicted_taken);\n    predicted_select_q <= !reset && advance_request && !resume_fetch && predicted_taken;\n    retry_select_q <= reset || !advance_request;'\"''',\n     '''    sequential_q <= normal_word + 30'd1;\n    prediction_q <= direct_word[19:2];\n    retry_q <= reset ? '0 : normal_word;\n    resume_word_q <= accept_response && \"'!restart_hold_last ? restart_word + 30'\"'d1 : restart_word;\n    resume_select_q <= \"'!reset && recovering;\n    sequential_select_q <= !reset && !recovering && advance_request &&\n                           (resume_fetch || !predicted_taken);\n    predicted_select_q <= !reset && !recovering && advance_request &&\n                          !resume_fetch && predicted_taken;\n    retry_select_q <= reset || (!recovering && !advance_request);'\"'''),\n    ('''  assign response.direct_target    = {direct_word, direct_bit1, 1'b0};\n  assign response.predicted_taken  = predicted_taken;\n  assign response.prediction_index = prediction_index;''',\n     '''  assign response.direct_target    = recovering ?\n    {10'b0, restart_sum_mid, restart_sum_lo, direct_bit1, 1'b0} :\n    {direct_word, direct_bit1, 1'b0};\n  assign response.predicted_taken  = \"'!recovering && predicted_taken;\n  assign response.prediction_index = recovering ? restart_index : prediction_index;\n  assign response.restart_packet   = recovering;'\"'''),\n])\nedit('ex_stage.sv', [\n    ('  assign target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1\\\\'b0} : in.direct_target;',\n     '''  logic [31:0] restart_target;\n  logic [8:0]  restart_mid_raw;\n  logic [11:0] restart_upper_raw;\n  logic        restart_low_carry, restart_carry, restart_inc, restart_dec;\n  assign restart_low_carry = in.direct_target[11];\n  assign restart_mid_raw = in.direct_target[20:12];\n  assign restart_upper_raw = in.pc[31:20];\n  assign restart_carry = in.direct_target[21] || (restart_low_carry && (&restart_mid_raw));\n  assign restart_inc = restart_carry && \"'!in.imm[31];\n  assign restart_dec = !restart_carry && in.imm[31];\n  assign restart_target[10:0] = in.direct_target[10:0];\n  assign restart_target[11] = restart_mid_raw[0] ''^ restart_low_carry;\n  assign restart_target[20] = restart_upper_raw[0] ''^ restart_carry ''^ in.imm[31];\n  for (genvar i = 1; i < 9; ++i) begin : gen_restart_mid\n    assign restart_target[11+i] = restart_mid_raw[i] ''^ (restart_low_carry && (&restart_mid_raw[i-1:0]));\n  end\n  for (genvar i = 1; i < 12; ++i) begin : gen_restart_upper\n    assign restart_target[20+i] = restart_upper_raw[i] ''^\n      ((restart_inc && (&restart_upper_raw[i-1:0])) ||\n       (restart_dec && !(|restart_upper_raw[i-1:0])));\n  end\n\n  assign target = ({32{in.ctrl.is_jalr}} & {jalr_sum[31:1], 1'\"'b0})\n                | ({32{\"'!in.ctrl.is_jalr && !in.restart_packet}} & in.direct_target)\n                | ({32{!in.ctrl.is_jalr && in.restart_packet}} & restart_target);'\"'''),\n])\nPY\npython3 \\\"\"'$TMPDIR/r15-profile/make_restart.py\"\nRTL_DIR=\"$TMPDIR/r15-profile/restart_rtl\" OBJ_DIR=\"$TMPDIR/r15-profile/restart_obj\" NRET=1 bash test/cosim/build.sh > \"$TMPDIR/r15-profile/restart_build.log\" 2>&1\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
