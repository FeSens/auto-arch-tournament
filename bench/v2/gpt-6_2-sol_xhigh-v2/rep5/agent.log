{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport subprocess\nfrom tempfile import TemporaryDirectory\n\nrtl = Path(\\\"cores/bench/rtl\\\")\ninputs = \\\"\\\"\\\"    .clock(clock), .reset(reset), .stall(stall), .in(packet),\n    .fwd_ex_mem(fwd_ex_mem), .fwd_mem_wb(fwd_mem_wb),\\\"\\\"\\\"\noutputs = {\n    \\\"out\\\": \\\"ex_mem_t\\\",\n    \\\"fast_write\\\": \\\"logic\\\",\n    \\\"multiply_result\\\": \\\"logic [31:0]\\\",\n    \\\"divide_result\\\": \\\"logic [31:0]\\\",\n    \\\"divide_wait\\\": \\\"logic\\\",\n    \\\"advance_aperture\\\": \\\"logic\\\",\n    \\\"redirect\\\": \\\"logic\\\",\n    \\\"redirect_word\\\": \\\"logic [31:2]\\\",\n    \\\"train_branch\\\": \\\"logic\\\",\n    \\\"train_index\\\": \\\"logic [5:0]\\\",\n    \\\"train_taken\\\": \\\"logic\\\",\n}\nwith TemporaryDirectory(dir=os.environ[\\\"TMPDIR\\\"]) as scratch:\n    scratch = Path(scratch)\n    baseline = subprocess.check_output([\\\"git\\\", \\\"show\\\", f\\\"HEAD:{rtl}/ex_stage.sv\\\"], text=True)\n    (scratch / \\\"ex_stage_gold.sv\\\").write_text(baseline.replace(\\\"module ex_stage (\\\", \\\"module ex_stage_gold (\\\", 1))\n\n    wrapper = \\\"\\\"\\\"module ex_miter (\n  input logic clock, reset, stall,\n  input id_ex_t raw_packet,\n  input logic [31:0] fwd_ex_mem, fwd_mem_wb,\n  output logic matches\n);\n  id_ex_t packet;\n  always_comb begin\n    packet = raw_packet;\n    if (raw_packet.ctrl.branch_op[2:1] == 2'b01)\n      packet.ctrl.branch_op = 3'b000;\n  end\n\\\"\\\"\\\"\n    for name, typ in outputs.items():\n        wrapper += f\\\"  {typ} gold_{name}, new_{name};\\\\n\\\"\n\n    for module, label in ((\\\"ex_stage_gold\\\", \\\"gold\\\"), (\\\"ex_stage\\\", \\\"new\\\")):\n        ports = \\\",\\\\n\\\".join(f\\\"    .{name}({label}_{name})\\\" for name in outputs)\n        wrapper += f\\\"  {module} {label}_ex (\\\\n{inputs}\\\\n{ports}\\\\n  );\\\\n\\\"\n\n    wrapper += \\\"  assign matches = \\\" + \\\" &&\\\\n                   \\\".join(\n        f\\\"(gold_{name} == new_{name})\\\" for name in outputs\n    ) + \\\";\\\\nendmodule\\\\n\\\"\n    (scratch / \\\"ex_miter.sv\\\").write_text(wrapper)\n    sources = [rtl / f\\\"{name}.sv\\\" for name in (\\\"core_pkg\\\", \\\"alu\\\", \\\"multiplier\\\", \\\"divider\\\", \\\"ex_stage\\\")]\n    sources += [scratch / \\\"ex_stage_gold.sv\\\", scratch / \\\"ex_miter.sv\\\"]\n    command = (\n        \\\"read_verilog -sv -D RISCV_FORMAL_ALTOPS \\\" + \\\" \\\".join(map(str, sources)) + \\\"; \\\"\n        \\\"prep -top ex_miter -flatten; opt -full; \\\"\n        \\\"sat -verify -timeout 40 -tempinduct -seq 1 -maxsteps 4 -set-init-zero -prove matches 1\\\"\n    )\n    result = subprocess.run([\\\"yosys\\\", \\\"-Q\\\", \\\"-T\\\", \\\"-p\\\", command], text=True, stdout=subprocess.PIPE)\n    print(\\\"\\\\n\\\".join(result.stdout.splitlines()[-45:]))\n    raise SystemExit(result.returncode)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
