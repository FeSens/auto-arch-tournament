{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'yosys -Q -T -s /dev/stdin > \"$PWD/alu-equivalence.log\" 2>&1 <<'\"'YOSYS'\nread_verilog -sv -Icores/bench/rtl cores/bench/rtl/core_pkg.sv cores/bench/rtl/alu.sv\nread_verilog -sv <<SV\nmodule alu_miter(\n  input logic [4:0] op,\n  input logic [31:0] a, b,\n  input logic clear_selects,\n  output logic proof\n);\n  alu_select_t selects;\n  logic [31:0] encoded_out, registered_out, reference_out;\n\n  assign selects = clear_selects ? '0 : decode_alu(op);\n\n  alu u_encoded (.op(op), .selects('0), .a(a), .b(b), .out(encoded_out));\n  alu #(.REGISTERED_SELECT(1'b1)) u_registered\n      (.op(5'b0), .selects(selects), .a(a), .b(b), .out(registered_out));\n\n  always_comb begin\n    case (op)\n      ALU_ADD:  reference_out = a + b;\n      ALU_SUB:  reference_out = a - b;\n      ALU_AND:  reference_out = a & b;\n      ALU_OR:   reference_out = a | b;\n      ALU_XOR:  reference_out = a \"'^ b;\n      ALU_SLT:  reference_out = {31'\"'b0, \"'$signed(a) < $signed(b)};\n      ALU_SLTU: reference_out = {31'\"'b0, a < b};\n      ALU_SLL:  reference_out = a << b[4:0];\n      ALU_SRL:  reference_out = a >> b[4:0];\n      ALU_SRA:  reference_out = \"'$signed(a) >>> b[4:0];\n      ALU_LUI:  reference_out = b;\n      default:  reference_out = '\"'0;\n    endcase\n  end\n\n  assign proof = encoded_out == reference_out &&\n                 registered_out == (clear_selects ? 32'b0 : reference_out);\nendmodule\nSV\nprep -top alu_miter -flatten\nsat -verify -prove proof 1 -show-inputs -show-outputs\nYOSYS\nproof_result=\"'$?\ntail -29 \"$PWD/alu-equivalence.log\"\nexit \"$proof_result\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
