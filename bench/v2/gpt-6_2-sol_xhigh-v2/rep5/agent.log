s/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[11769 of 14841 chars elided by tools/bench/transcript.py; sha256:58b2b4e0bb59fee6]…\nREAK(),\n    }\n    requests = []\n\n    def ready(addr, ren, wen):\n        if ren or wen:\n            requests.append((addr, ren, wen))\n        return True\n\n    rets, mem = await _run(dut, program, dmem_init={0x40: 100}, dmem_ready=ready)\n    pcs = [0, 4, 8, 0x20, 0x24]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert requests == [(0x40, 1, 0)]\n    assert mem == {0x40: 100}\n    _, load, branch, div, _ = rets\n    assert (branch[\"rs1_rdata\"], branch[\"rs2_rdata\"], branch[\"trap\"]) == (0, 100, 0)\n    assert branch[\"cycle\"] - load[\"cycle\"] == 2\n    assert div[\"cycle\"] - branch[\"cycle\"] == 10\n    assert (div[\"rs1_rdata\"], div[\"rs2_rdata\"], div[\"rd_wdata\"]) == (100, 7, 14)\n\n\n@cocotb.test()\nasync def taken_prediction_recovers_late_to_a_stalled_request(dut):\n    program = {\n        0x000: BEQ(0, 0, 8),  # Train index 0 and shift history to 01.\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\n20\n", "exit_code": 0, "status": "completed"}}
