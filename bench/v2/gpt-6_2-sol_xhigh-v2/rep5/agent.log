{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,235p' tools/eval/_slots.py; rg -n -e 'def run_fpga_eval' -e 'cycles' tools/eval/fpga.py | tail -25; git diff --check\"", "aggregated_output": "\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n204:    \"\"\"Run CoreMark on Verilator sim, return {iter_per_cycle, completed, cycles, iterations}.\n206:    benchmark hit maxcycles without completing and the cycle count is meaningless.\"\"\"\n212:    # needs ~5M cycles. 50M gives 10x headroom for slower candidates.\n219:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n223:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n226:    # Last line is the ebreak/maxcycles marker; second-to-last is the final retirement.\n231:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n235:        # Benchmark ran out of cycles before finishing. Score 0 — don't credit\n237:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n238:                'reason': 'maxcycles_hit_before_ebreak'}\n246:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n253:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n256:    # Bracketed cycles (start_time..stop_time) are the contract per\n263:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n267:    elapsed_cycles = int(marker['bench_stop_cycle']) - int(marker['bench_start_cycle'])\n268:    if elapsed_cycles <= 0:\n269:        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n271:    ipc = iterations / elapsed_cycles\n272:    return {'completed': True, 'iter_per_cycle': ipc, 'cycles': elapsed_cycles,\n273:            'iterations': iterations, 'bracketed_cycles': True}\n330:def run_fpga_eval(worktree: str, target: str | None = None) -> dict:\n333:    Verilator CoreMark run (with random memory stalls) for cycles.\n343:        'cycles': int, 'iterations': int,\n387:        'cycles':        cm['cycles'],\n", "exit_code": 0, "status": "completed"}}
