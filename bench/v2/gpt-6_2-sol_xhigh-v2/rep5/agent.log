{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/r14/carry_bank\"\ncp -r cores/bench/rtl \"$TMPDIR/r14/carry_bank\"\ncat > \"$TMPDIR/r14/carry_bank/refine.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1])\n\ndef replace(file, before, after):\n    path = rtl / file\n    text = path.read_text()\n    assert text.count(before) == 1, (file, before)\n    path.write_text(text.replace(before, after))\n\nreplace(\\\"core_pkg.sv\\\", \\\"logic alu, load, mul, div, late_add, late_double;\\\", \\\"logic alu, carry_sum, load, mul, div, late_add, late_double;\\\")\nreplace(\\\"core_pkg.sv\\\", \\\"    logic [31:0] alu_result;\\\", \\\"\\\"\\\"    logic [31:0] alu_result;\n    logic [16:0] sum_lo;\n    logic [15:0] sum_hi, sum_hi_plus_one;\\\"\\\"\\\")\nreplace(\\\"alu.sv\\\", \\\"parameter bit REGISTERED_SELECT = 1'b0\\\", \\\"parameter bit REGISTERED_SELECT = 1'b0,\\\\n  parameter bit INCLUDE_ADD_SUB = 1'b1\\\")\nreplace(\\\"alu.sv\\\", \\\"({32{sel.add}} & (a + b))\\\", \\\"({32{INCLUDE_ADD_SUB && sel.add}} & (a + b))\\\")\nreplace(\\\"alu.sv\\\", \\\"({32{sel.sub}} & (a - b))\\\", \\\"({32{INCLUDE_ADD_SUB && sel.sub}} & (a - b))\\\")\nreplace(\\\"ex_stage.sv\\\", \\\"  output logic               fast_write,\\\", \\\"  output logic               carry_sum,\\\\n  output logic               fast_write,\\\")\nreplace(\\\"ex_stage.sv\\\", \\\"  alu #(.REGISTERED_SELECT(1'b1))\\\", \\\"\\\"\\\"\n  logic [31:0] sum_b;\n  logic [16:0] sum_lo;\n  logic [15:0] sum_hi, sum_hi_plus_one;\n  assign sum_b = alu_b \"'^ {32{in.alu_select.sub}};\n  assign sum_lo = {1'\"'b0, rs1[15:0]} + {1'b0, sum_b[15:0]} + {16'b0, in.alu_select.sub};\n  assign sum_hi = rs1[31:16] + sum_b[31:16];\n  assign sum_hi_plus_one = rs1[31:16] + sum_b[31:16] + 16'd1;\n  assign carry_sum = in.ctrl.reg_write && (in.alu_select.add || in.alu_select.sub);\n\n  alu #(.REGISTERED_SELECT(1'b1), .INCLUDE_ADD_SUB(1'b0))\\\"\\\"\\\")\nreplace(\\\"ex_stage.sv\\\", \\\"\"'!(in.ctrl.mem_read || in.ctrl.is_mul || in.ctrl.is_div || in.late_add);\", \"!(in.ctrl.mem_read || in.ctrl.is_mul || in.ctrl.is_div || in.late_add || carry_sum);\")\nreplace(\"ex_stage.sv\", \"      reg_q.alu_result    <= ex_result;\", \"\"\"      reg_q.alu_result    <= ex_result;\n      reg_q.sum_lo        <= sum_lo;\n      reg_q.sum_hi        <= sum_hi;\n      reg_q.sum_hi_plus_one <= sum_hi_plus_one;\"\"\")\nreplace(\"ex_stage.sv\", \"\"\"                                      use_late_add);\"\"\", \"\"\"                                      use_late_add || carry_sum);\n      reg_q.writeback_select.carry_sum <= ctrl_with_trap.reg_write && carry_sum &&\n                                           !in.ctrl.mem_read && !use_late_add;\"\"\")\nreplace(\"mem_stage.sv\", \"  assign wb_result = ({32{in.writeback_select.alu}} & in.alu_result)\", \"\"\"  logic [31:0] carry_sum_result;\n  assign carry_sum_result = {in.sum_lo[16] ? in.sum_hi_plus_one : in.sum_hi, in.sum_lo[15:0]};\n  assign wb_result = ({32{in.writeback_select.alu}} & in.alu_result)\n                   | ({32{in.writeback_select.carry_sum}} & carry_sum_result)\"\"\")\nreplace(\"core.sv\", \"  logic       ex_fast_write, mem_next_write;\", \"  logic       ex_fast_write, ex_carry_sum, mem_next_write;\")\nreplace(\"core.sv\", \"    .fast_write      (ex_fast_write),\", \"    .carry_sum       (ex_carry_sum),'\"\\\\n    .fast_write      (ex_fast_write),\\\")\nreplace(\\\"core.sv\\\", \\\"                                         id_ex_w.late_add)),\\\", \\\"                                         id_ex_w.late_add || ex_carry_sum)),\\\")\nPY\npython \\\"\"'$TMPDIR/r14/carry_bank/refine.py\" \"$TMPDIR/r14/carry_bank/rtl\"\nverilator --lint-only -Wall -Wno-MULTITOP -sv \"+incdir+$TMPDIR/r14/carry_bank/rtl\" \"$TMPDIR/r14/carry_bank/rtl/\"*.sv'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
