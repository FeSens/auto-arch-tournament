{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c 'set -e\nprofile_dir=\"$TMPDIR/bench-r10-profile.Jp85SQ\"\nmkdir -p \"$profile_dir/rtl3\"\ncp \"$profile_dir/rtl2/\"*.sv \"$profile_dir/rtl3/\"\ncat > \"$profile_dir/lanes.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot=Path(sys.argv[1])\n\ndef update(file, old, new):\n    f=root/(file+'.sv')\n    s=f.read_text()\n    assert s.count(old)==1, (file,old,s.count(old))\n    f.write_text(s.replace(old,new))\n\ndef less(a,b):\n    return f'''\n  logic [3:0] cmp_eq, cmp_lt;\n  assign cmp_eq[3] = {a}[30:24] == {b}[30:24];\n  assign cmp_lt[3] = {a}[30:24] < {b}[30:24];\n  for (genvar n=0; n<3; n++) begin : gen_cmp\n    assign cmp_eq[n] = {a}[n*8 +: 8] == {b}[n*8 +: 8];\n    assign cmp_lt[n] = {a}[n*8 +: 8] < {b}[n*8 +: 8];\n  end\n  logic unsigned_low_lt;\n  assign unsigned_low_lt = cmp_lt[3]\n                        || (cmp_eq[3] && cmp_lt[2])\n                        || (&cmp_eq[3:2] && cmp_lt[1])\n                        || (&cmp_eq[3:1] && cmp_lt[0]);\n'''\np=root/'ex_stage.sv'\ns=p.read_text()\nstart=s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nend=s.index('  assign jalr_sum',start)\np.write_text(s[:start] + less('rs1','rs2') + '''\n  logic same_sign, early_lt, early_eq;\n  assign same_sign = rs1[31] == rs2[31];\n  assign early_eq = same_sign && (&cmp_eq);\n  assign early_lt = same_sign ? unsigned_low_lt : rs1[31] \"'^ in.ctrl.branch_op[1];\n  assign branch_cond = (in.ctrl.branch_op[2] ? early_lt : early_eq) ''^ in.ctrl.branch_op[0];\n\n'\"''' + s[end:])\np=root/'mem_stage.sv'\ns=p.read_text()\nstart=s.index('  logic late_eq, late_lo_lt, wb_lt, late_lt;')\nend=s.index('  always_comb begin\\\\n    case ({in.late_rs1',start)\np.write_text(s[:start] + '''\n  logic late_eq, wb_lt, late_lt, same_sign;\n  logic [31:0] wb_operand;\n  assign wb_operand = reg_q.result;\n''' + less('wb_operand','in.branch_known') + '''\n  assign same_sign = wb_operand[31] == in.branch_known[31];\n  assign late_eq = same_sign && (&cmp_eq);\n  assign wb_lt = same_sign ? unsigned_low_lt : wb_operand[31] \"'^ in.ctrl.branch_op[1];\n  assign late_lt = in.late_rs1 ? wb_lt : !(wb_lt || late_eq);\n'\"''' + s[end:])\nif len(sys.argv) > 2:\n    update('core_pkg','  // ID/EX register payload.', '''  typedef struct packed {\n    logic add, sub, bit_and, bit_or, bit_xor, slt, sltu, sll, shr, lui, link;\n  } alu_lanes_t;\n\n  // ID/EX register payload.''')\n    update('core_pkg','    operand_sel_t rs1_sel;', '    alu_lanes_t  alu_lanes;\\\\n    operand_sel_t rs1_sel;')\n    update('core_pkg','    logic        branch_fallback;', '    logic        branch_fallback;\\\\n    logic [4:0]  late_alu_lanes;')\n    update('id_stage','      reg_q.ctrl             <= in.ctrl;', '''      reg_q.ctrl             <= in.ctrl;\n      reg_q.alu_lanes.add     <= \"'!in.ctrl.is_jump && in.ctrl.alu_op == ALU_ADD;\n      reg_q.alu_lanes.sub     <= in.ctrl.alu_op == ALU_SUB;\n      reg_q.alu_lanes.bit_and <= in.ctrl.alu_op == ALU_AND;\n      reg_q.alu_lanes.bit_or  <= in.ctrl.alu_op == ALU_OR;\n      reg_q.alu_lanes.bit_xor <= in.ctrl.alu_op == ALU_XOR;\n      reg_q.alu_lanes.slt     <= in.ctrl.alu_op == ALU_SLT;\n      reg_q.alu_lanes.sltu    <= in.ctrl.alu_op == ALU_SLTU;\n      reg_q.alu_lanes.sll     <= in.ctrl.alu_op == ALU_SLL;\n      reg_q.alu_lanes.shr     <= in.ctrl.alu_op == ALU_SRL || in.ctrl.alu_op == ALU_SRA;\n      reg_q.alu_lanes.lui     <= in.ctrl.alu_op == ALU_LUI;\n      reg_q.alu_lanes.link    <= in.ctrl.is_jump;'\"''')\n    update('ex_stage','''  logic [31:0] alu_result;\n  alu u_alu (\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );''','''  logic [31:0] shift_right, alu_result;\n  assign shift_right = 32'(\"'$signed({alu_a[31] && in.ctrl.alu_op == ALU_SRA, alu_a}) >>> alu_b[4:0]);\n  assign alu_result = ({32{in.alu_lanes.add}} & (alu_a + alu_b))\n                    | ({32{in.alu_lanes.sub}} & (alu_a - alu_b))\n                    | ({32{in.alu_lanes.bit_and}} & (alu_a & alu_b))\n                    | ({32{in.alu_lanes.bit_or}} & (alu_a | alu_b))\n                    | ({32{in.alu_lanes.bit_xor}} & (alu_a ''^ alu_b))\n                    | {31'\"'b0, in.alu_lanes.slt && \"'$signed(alu_a) < $signed(alu_b)}\n                    | {31'\"'b0, in.alu_lanes.sltu && alu_a < alu_b}\n                    | ({32{in.alu_lanes.sll}} & (alu_a << alu_b[4:0]))\n                    | ({32{in.alu_lanes.shr}} & shift_right)\n                    | ({32{in.alu_lanes.lui}} & alu_b);''')\n    update('ex_stage','  assign ex_result = in.ctrl.is_jump ? pc_plus_4 : alu_result;',\n        '  assign ex_result = ({32{in.alu_lanes.link}} & pc_plus_4) | alu_result;')\n    update('ex_stage','      reg_q.branch_fallback <= branch_cond;',\n        '''      reg_q.branch_fallback <= branch_cond;\n      reg_q.late_alu_lanes <= in.deferred && in.ctrl.reg_write\n        ? {in.alu_lanes.add, in.alu_lanes.sub, in.alu_lanes.bit_and,\n           in.alu_lanes.bit_or, in.alu_lanes.bit_xor} : '0;''')\n    update('mem_stage','''  always_comb begin\n    case (in.ctrl.alu_op)\n      ALU_ADD: late_alu_result = late_a + late_alu_b;\n      ALU_SUB: late_alu_result = late_a - late_alu_b;\n      ALU_AND: late_alu_result = late_a & late_alu_b;\n      ALU_OR:  late_alu_result = late_a | late_alu_b;\n      ALU_XOR: late_alu_result = late_a \"'^ late_alu_b;\n      default: late_alu_result = '\"'0;\n    endcase\n  end''',\n     '''  assign late_alu_result = ({32{in.late_alu_lanes[4]}} & (late_a + late_alu_b))\n                         | ({32{in.late_alu_lanes[3]}} & (late_a - late_alu_b))\n                         | ({32{in.late_alu_lanes[2]}} & (late_a & late_alu_b))\n                         | ({32{in.late_alu_lanes[1]}} & (late_a | late_alu_b))\n                         | ({32{in.late_alu_lanes[0]}} & (late_a \"'^ late_alu_b));'\"''')\n    update('mem_stage','({32{in.valid && in.deferred && in.ctrl.reg_write}} & late_alu_result)',\n        '({32{in.valid}} & late_alu_result)')\nPY\npython3 \\\"\"'$profile_dir/lanes.py\" \"$profile_dir/rtl3\" alu\nPYTHONDONTWRITEBYTECODE=1 python3 - \"$profile_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\nscratch=Path(sys.argv[1])\nwith ThreadPoolExecutor() as pool:\n    pending=[pool.submit(build,Path.cwd(),scratch/'rtl3','fpga/core_bench_si.sv',i,scratch/f'pnr3{i}') for i in range(3)]\n    for p in pending:\n        result=p.result()\n        print({key:result[key] for key in ('place_option','fmax_mhz','logic','regs')},result.get('critical_paths',[])[:2],flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
