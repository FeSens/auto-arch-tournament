{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport os\nimport shutil\nfrom pathlib import Path\nscratch = Path(os.environ['TMPDIR']) / 'fetch-target-study'\nbaseline = scratch / 'baseline'\nfor variant in ('profile', 'shift', 'shift_radix4', 'divider_mux', 'divider_split'):\n    dest = scratch / variant\n    shutil.copytree(baseline / 'cores/bench', dest / 'cores/bench', ignore=shutil.ignore_patterns('generated', 'obj_dir'))\n    for name in ('bench', 'tools', 'test', 'Makefile', 'fpga'):\n        (dest / name).symlink_to(scratch / name, target_is_directory=(name \"'!= '\"'Makefile'))\n\npath = scratch / 'profile/cores/bench/rtl/core.sv'\nrtl = path.read_text()\naddition = '''\n  logic profile_active = 1'b0;\n  integer profile_all = 0, profile_fake = 0, profile_store = 0;\n  integer profile_branch = 0, profile_accept = 0, profile_mul = 0;\n  integer fake2, fake1;\n  logic first_match, second_match;\n  assign first_match = rs1_addr_w == id_ex_w.rd;\n  assign second_match = rs2_addr_w == id_ex_w.rd;\n  always_comb begin\n    fake1 = 0;\n    fake2 = 0;\n    case (if_id_w.instr[6:0])\n      7'h33, 7'h23, 7'h63: begin end\n      7'h13, 7'h03, 7'h67: fake2 = 1;\n      default: begin fake1 = 1; fake2 = 1; end\n    endcase\n  end\n  always_ff @(posedge clock) begin\n    if (io_dmemReady && (|io_dmemWEn) && io_dmemAddr == 32'h10000100)\n      profile_active <= 1'b1;\n    if (io_dmemReady && (|io_dmemWEn) && io_dmemAddr == 32'h10000104) begin\n      profile_active <= 1'b0;\n      \"'$display(\"profile counts all %d fake %d store_rs2 %d branch %d accepted_imem %d mul %d\",\n               profile_all, profile_fake, profile_store, profile_branch, profile_accept, profile_mul);\n    end\n    if (profile_active && stall_issue && !hold_id_ex &&\n        (!u_if.empty || u_if.response_valid)) begin\n      profile_all <= profile_all + 1;\n      if ((!first_match || fake1 != 0) && (!second_match || fake2 != 0))\n        profile_fake <= profile_fake + 1;\n      if (if_id_w.ctrl.mem_write && !first_match && second_match)\n        profile_store <= profile_store + 1;\n      if (if_id_w.ctrl.is_branch)\n        profile_branch <= profile_branch + 1;\n      if (u_if.accept_response)\n        profile_accept <= profile_accept + 1;\n      if (id_ex_w.ctrl.is_mul)\n        profile_mul <= profile_mul + 1;\n    end\n  end\n'\"'''\npath.write_text(rtl.replace('\\\\nendmodule', addition + '\\\\nendmodule'))\n\nfor variant in ('shift', 'shift_radix4'):\n    path = scratch / variant / 'cores/bench/rtl/alu.sv'\n    rtl = path.read_text()\n    addition = '''\n  logic left, sign_fill;\n  logic [31:0] reversed_a, shift_input, shifted_right, shifted_result;\n  logic [32:0] shift_extended;\n  assign left = op == ALU_SLL;\n  assign sign_fill = op == ALU_SRA && a[31];\n  for (genvar k = 0; k < 32; k++) begin : gen_reverse\n    assign reversed_a[k] = a[31-k];\n    assign shifted_result[k] = left ? shifted_right[31-k] : shifted_right[k];\n  end\n  assign shift_input = left ? reversed_a : a;\n  assign shift_extended = \"'$unsigned($signed({sign_fill, shift_input}) >>> b[4:0]);\n  assign shifted_right = shift_extended[31:0];\n'\"'''\n    if variant == 'shift_radix4':\n        addition = addition.replace('  logic [32:0] shift_extended;', '''  logic [31:0] shift_1, shift_4;\n  function automatic [31:0] shift_group(input logic [31:0] v,\n                                        input logic [1:0] sel,\n                                        input logic fill,\n                                        input int stride);\n    shift_group = ({32{sel == 2'd0}} & v)\n                | ({32{sel == 2'd1}} & ((v >> stride) | ({32{fill}} << (32-stride))))\n                | ({32{sel == 2'd2}} & ((v >> (2*stride)) | ({32{fill}} << (32-2*stride))))\n                | ({32{sel == 2'd3}} & ((v >> (3*stride)) | ({32{fill}} << (32-3*stride))));\n  endfunction''')\n        addition = addition.replace('  assign shift_extended = \"'$unsigned($signed({sign_fill, shift_input}) >>> b[4:0]);'\"\\\\n  assign shifted_right = shift_extended[31:0];', '''  assign shift_1 = shift_group(shift_input, b[1:0], sign_fill, 1);\n  assign shift_4 = shift_group(shift_1, b[3:2], sign_fill, 4);\n  assign shifted_right = b[4] ? {{16{sign_fill}}, shift_4[31:16]} : shift_4;''')\n    else:\n        addition = addition.replace('  logic [32:0] shift_extended;', '  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [32:0] shift_extended;\\\\n  /* verilator lint_on UNUSEDSIGNAL */')\n    rtl = rtl.replace('  logic        [4:0]  shamt;', addition)\n    rtl = rtl.replace('    shamt = b[4:0];\\\\n\\\\n', '')\n    lo, hi = rtl.index('      ALU_SLL:'), rtl.index('      ALU_LUI:')\n    rtl = rtl[:lo] + '      ALU_SLL, ALU_SRL, ALU_SRA: out = shifted_result;\\\\n' + rtl[hi:]\n    path.write_text(rtl)\n\npath = scratch / 'divider_mux/cores/bench/rtl/divider.sv'\nrtl = path.read_text()\nlo, hi = rtl.index('  assign wide_remainder ='), rtl.index('\\\\n\\\\n  always_ff', rtl.index('  assign wide_remainder ='))\nnew = '''  // Borrow flags are monotonic. The remainder uses a binary mux tree\n  // driven by the threshold in the middle of each subtree.\n  logic [31:0] low_01, low_23, high_45, high_67;\n  assign low_01 = borrow[1] ? trial_remainder[0] : trial_remainder[1];\n  assign low_23 = borrow[3] ? trial_remainder[2] : trial_remainder[3];\n  assign high_45 = borrow[5] ? trial_remainder[4] : trial_remainder[5];\n  assign high_67 = borrow[7] ? trial_remainder[6] : trial_remainder[7];\n  assign wide_remainder = borrow[4] ? (borrow[2] ? low_01 : low_23)\n                                   : (borrow[6] ? high_45 : high_67);'''\nrtl = rtl[:lo] + new + rtl[hi:]\npath.write_text(rtl)\n\npath = scratch / 'divider_split/cores/bench/rtl/divider.sv'\nrtl = path.read_text()\nrtl = rtl.replace('  logic [31:0] divisor_q, remainder_q, quotient_q;', '''  logic [31:0] divisor_q, remainder_q, quotient_q;\n  logic [10:0] narrow_remainder_q;