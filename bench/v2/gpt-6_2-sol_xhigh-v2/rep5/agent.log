{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/divider-hypothesis/cores/bench\"\ncp -a cores/bench/rtl \"$TMPDIR/divider-hypothesis/cores/bench/\"\ncp -a fpga \"$TMPDIR/divider-hypothesis/\"\ncp cores/bench/core.yaml \"$TMPDIR/divider-hypothesis/cores/bench/\"\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport os\np = Path(os.environ['TMPDIR']) / 'divider-hypothesis/cores/bench/rtl/divider.sv'\ns = p.read_text()\ns = s.replace('  logic signed_op, want_remainder, a_negative, b_negative;', '''  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n  logic initialize;\n  assign initialize = phase_q == 4'd8;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      a_q  <= '0;\n      b_q  <= '0;\n      op_q <= '0;\n    end else if (starting) begin\n      a_q  <= a;\n      b_q  <= b;\n      op_q <= op;\n    end\n  end\n\n  logic signed_op, want_remainder, a_negative, b_negative;''')\ns = s.replace('  logic [27:0] a_mag_lo;\\\\n  logic [3:0] a_mag_hi, b_mag_nibble;', '''  logic [23:0] a_mag_lo;\n  logic [7:0] a_mag_hi, b_mag_byte;''')\nstart = s.index('  assign signed_op')\nend = s.index('  // Take one radix-4 digit.', start)\nassigns = '''  assign signed_op      = op_q == ALU_DIV || op_q == ALU_REM;\n  assign want_remainder = op_q == ALU_REM || op_q == ALU_REMU;\n  assign a_negative     = signed_op && a_q[31];\n  assign b_negative     = signed_op && b_q[31];\n  assign a_mag_lo       = a_negative ? -a_q[23:0] : a_q[23:0];\n  assign a_mag_hi       = a_negative ? ~a_q[31:24] + {7'b0, a_q[23:0] == 24'b0} : a_q[31:24];\n  assign b_magnitude    = b_negative ? -b_q : b_q;\n  assign b_mag_byte     = b_magnitude[7:0];\n  assign small_divisor  = b_negative ? (&b_q[31:8] && |b_q[7:0]) : \"'!(|b_q[31:8]);\n\n  logic [9:0] three_byte;\n  assign three_byte = {2'\"'b0, b_mag_byte} + {1'b0, b_mag_byte, 1'b0};\n\n'''\nfor width in (2,4,6,8):\n    name=f'prefix_step{width}'\n    # Check the magnitude of each