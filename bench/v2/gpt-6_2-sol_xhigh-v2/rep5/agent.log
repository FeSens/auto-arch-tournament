{"type": "item.started", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch=Path(os.environ['TMPDIR'])/'fetch-target-study'\nsources={\n    'divide_banks_clock': 'divider_split',\n    'divide_banks_full': 'divider_split',\n    'divide_banks_tree': 'divider_split',\n    'redirect_valid': 'baseline',\n    'redirect_epoch': 'baseline',\n    'branch_compare': 'baseline',\n}\nfor variant, source in sources.items():\n    dest=scratch/variant\n    shutil.copytree(scratch/source/'cores/bench', dest/'cores/bench', ignore=shutil.ignore_patterns('generated','obj_dir'))\n    for name in ('bench','tools','test','Makefile','fpga'):\n        (dest/name).symlink_to(scratch/name, target_is_directory=(name \"'!= '\"'Makefile'))\nfor variant in ('divide_banks_clock', 'divide_banks_full', 'divide_banks_tree'):\n    path=scratch/variant/'cores/bench/rtl/divider.sv'\n    rtl=path.read_text()\n    if variant=='divide_banks_tree':\n        other=(scratch/'divider_mux/cores/bench/rtl/divider.sv').read_text()\n        start='  // Borrow flags are monotonic. The remainder uses a binary mux tree'\n        rtl=rtl[:rtl.index('  assign wide_remainder =')]+other[other.index(start):other.index('\\\\n\\\\n  always_ff @(posedge clock) begin',other.index(start))]+rtl[rtl.index('\\\\n\\\\n  always_ff @(posedge clock) begin',rtl.index('  assign wide_remainder =')):]\n    else:\n        if variant=='divide_banks_full':\n            rtl=rtl.replace('logic [10:0] narrow_remainder_q;', 'logic [10:0] narrow_remainder_q;\\\\n  logic [31:0] narrow_quotient_q;')\n            rtl=rtl.replace('quotient_q[31:30]', 'narrow_quotient_q[31:30]').replace('quotient_q[29:28]', 'narrow_quotient_q[29:28]')\n            rtl=rtl.replace(\\\"      quotient_q        <= '0;\\\", \\\"      quotient_q        <= '0;\\\\n      narrow_quotient_q <= '0;\\\")\n        a=rtl.index('      if (narrow_divisor) begin')\n        b=rtl.index('\\\\n    end\\\\n  end', a)\n        if variant=='divide_banks_clock':\n            rtl=rtl[:a]+'''      narrow_remainder_q <= {7'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\n      remainder_q <= {21'b0, a_magnitude[31:21]};\n      quotient_q <= narrow_divisor ?\n                    {a_magnitude[27:0], nibble_divisor ? prefix_quotient : 4'b0} :\n                    {a_magnitude[20:0], {11{divisor_zero}}};\n    end else if (counting_down) begin\n      narrow_remainder_q <= step2[10:0];\n      remainder_q <= wide_remainder;\n      quotient_q <= narrow_q ?\n                    {quotient_q[27:0], step1[12:11], step2[12:11]} :\n                    {quotient_q[28:0], wide_digit};'''+rtl[b:]\n        else:\n            rtl=rtl[:a]+'''      narrow_remainder_q <= {7'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\n      narrow_quotient_q  <= {a_magnitude[27:0], nibble_divisor ? prefix_quotient : 4'b0};\n      remainder_q <= {21'b0, a_magnitude[31:21]};\n      quotient_q  <= {a_magnitude[20:0], {11{divisor_zero}}};\n    end else if (counting_down) begin\n      narrow_remainder_q <= step2[10:0];\n      narrow_quotient_q  <= {narrow_quotient_q[27:0], step1[12:11], step2[12:11]};\n      remainder_q <= wide_remainder;\n      quotient_q  <= {quotient_q[28:0], wide_digit};'''+rtl[b:]\n            rtl=rtl.replace('                     quotient_q;', '                     (narrow_q ? narrow_quotient_q : quotient_q);')\n    path.write_text(rtl)\nfor variant in ('redirect_valid','redirect_epoch'):\n    basedir=scratch/variant/'cores/bench/rtl'\n    for filename in ('core.sv','if_stage.sv','id_stage.sv'):\n        path=basedir/filename\n        rtl=path.read_text()\n        if filename=='core.sv':\n            rtl=rtl.replace('logic        redirect, advance_aperture;', 'logic        redirect, redirect_pending, advance_aperture;')\n            rtl=rtl.replace('.redirect        (redirect),', '.redirect        (redirect),\\\\n    .redirect_pending (redirect_pending),',1)\n            rtl=rtl.replace('.hold     (hold_id_ex),', '.hold     (hold_id_ex),\\\\n    .kill     (redirect_pending),')\n            rtl=rtl.replace('.issue    (issue),', '.issue    (issue_candidate),')\n        elif filename=='id_stage.sv':\n            rtl=rtl.replace('  input  logic              hold,', '  input  logic              hold,\\\\n  input  logic              kill,')\n            rtl=rtl.replace('    else if (\"'!hold)'\"', \\\"    else if (kill && hold)\\\\n      reg_q.valid <= 1'b0;\\\\n    else if (\"'!hold)\")\n            rtl=rtl.replace('\"'  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    out.valid = reg_q.valid && \"'!kill;\n  end'\"''')\n        else:\n            rtl=rtl.replace('  output logic              issue,', '  output logic              issue,\\\\n  output logic              redirect_pending,')\n            rtl=rtl.replace('  logic redirect_pending_q;', '  logic redirect_pending_q;\\\\n  assign redirect_pending = redirect_pending_q;')\n            if variant=='redirect_epoch':\n                a=rtl.index('  logic [2:0] read_ptr_q')\n                rtl=rtl[:a]+'''  logic [2:0] read_ptr_q, write_ptr_q;\n  logic [2:0] read_ptr, write_ptr;\n  logic empty, full;\n\n  assign read_ptr = redirect_pending_q ? 3'd0 : read_ptr_q;\n  assign write_ptr = redirect_pending_q ? 3'd0 : write_ptr_q;\n  assign empty = read_ptr == write_ptr;\n  assign full = read_ptr == {~write_ptr[2], write_ptr[1:0]};\n  assign response_valid = imem_ready && \"'!aperture_wait_q;\n  assign accept_response = response_valid && !full && !reset;\n  assign out = empty ? response : fifo[read_ptr[1:0]];\n  assign issue_candidate = (!empty || response_valid) && !issue_stall && !reset;\n  assign issue = issue_candidate;\n\n  always_ff @(posedge clock) begin\n    if (accept_response)\n      fifo[write_ptr[1:0]] <= response;\n\n    if (reset) begin\n      read_ptr_q <= '\"'0;\n      write_ptr_q <= '0;\n    end else begin\n      read_ptr_q <= read_ptr + {2'b0, issue};\n      write_ptr_q <= write_ptr + {2'b0, accept_response};\n    end\n  end\n\nendmodule\n'''\n        path.write_text(rtl)\npath=scratch/'branch_compare/cores/bench/rtl/ex_stage.sv'\nrtl=path.read_text()\na=rtl.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nb=rtl.index('  assign jalr_sum',a)\nrtl=rtl[:a]+'''  logic [3:0] equal_group, less_group;\n  logic signed_compare, less_than;\n  assign signed_compare = \"'!in.ctrl.branch_op[1];\n  for (genvar group_id = 0; group_id < 4; group_id++) begin : gen_branch_compare\n    localparam int START = group_id * 8;\n    assign equal_group[group_id] = rs1[START+:8] == rs2[START+:8];\n    if (group_id == 3) begin : gen_sign\n      assign less_group[group_id] =\n          {rs1[31] ''^ signed_compare, rs1[30:24]} < {rs2[31] ''^ signed_compare, rs2[30:24]};\n    end else begin : gen_unsigned\n      assign less_group[group_id] = rs1[START+:8] < rs2[START+:8];\n    end\n  end\n  assign less_than = less_group[3]\n                  || (equal_group[3] && less_group[2])\n                  || ((&equal_group[3:2]) && less_group[1])\n                  || ((&equal_group[3:1]) && less_group[0]);\n  assign branch_cond = (in.ctrl.branch_op[2] ? less_than : &equal_group) ''^ in.ctrl.branch_op[0];\n\n'\"'''+rtl[b:]\npath.write_text(rtl)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
