{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c 'set -e\nalu_dir=$(mktemp -d \"${TMPDIR:-/tmp}/bench-r5-alu-mask.XXXXXX\")\nalu_flat_dir=$(mktemp -d \"${TMPDIR:-/tmp}/bench-r5-alu-flat.XXXXXX\")\ngit archive HEAD | tar -x -C \"$alu_dir\"\ngit archive HEAD | tar -x -C \"$alu_flat_dir\"\ncp \"/srv/hwebench/tmp/7c172beb/0a012b02/bench-r5-fwd-flat.wlNTzc\"/cores/bench/rtl/*.sv \"$alu_flat_dir/cores/bench/rtl/\"\npython - \"$alu_dir\" \"$alu_flat_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nfor root in map(Path, sys.argv[1:]):\n    rtl = root / 'cores/bench/rtl'\n    pkg = rtl / 'core_pkg.sv'\n    src = pkg.read_text()\n    src = src.replace('    logic [31:0] imm;\\\\n', '    logic [11:0] result_select;\\\\n    logic [31:0] imm;\\\\n', 1)\n    pkg.write_text(src)\n\n    id_s = rtl / 'id_stage.sv'\n    src = id_s.read_text()\n    src = src.replace('      reg_q.imm              <= imm;', '''      reg_q.imm              <= imm;\n      reg_q.result_select    <= dec_is_jump ? 12'h800\n                              : {1'b0, (11'b1 << dec_alu_op)};''')\n    id_s.write_text(src)\n\n    ex = rtl / 'ex_stage.sv'\n    src = ex.read_text()\n    src = src.replace('  logic [31:0] alu_result;', '  logic [31:0] ex_result;\\\\n  logic [31:0] pc_plus_4;')\n    src = src.replace('    .op  (in.ctrl.alu_op),', '    .select (in.result_select),\\\\n    .link (pc_plus_4),')\n    src = src.replace('    .out (alu_result)', '    .out (ex_result)')\n    src = src.replace('  logic [31:0] target, pc_plus_4, pc_next;', '  logic [31:0] target, pc_next;')\n    src = src.replace(\\\"  logic [31:0] ex_result;\\\\n  assign ex_result = in.ctrl.is_jump ? pc_plus_4 : alu_result;\\\\n\\\\n\\\", \\\"\\\")\n    ex.write_text(src)\n\n    (rtl / 'alu.sv').write_text('''// Combinational RV32I result lanes with registered operation selection.\n\"'`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n\nmodule alu (\n  input  logic [11:0] select,\n  input  logic [31:0] link,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic [4:0] shamt;\n  logic [31:0] add_sub_group, shift_group, logic_group, other_group;\n\n  assign shamt = b[4:0];\n  assign add_sub_group = ({32{select[ALU_ADD]}} & (a + b))\n                       | ({32{select[ALU_SUB]}} & (a - b))\n                       | ({32{select[11]}} & link);\n  assign shift_group = ({32{select[ALU_SLL]}} & (a << shamt))\n                     | ({32{select[ALU_SRL]}} & (a >> shamt))\n                     | ({32{select[ALU_SRA]}} & $unsigned($signed(a) >>> shamt));\n  assign logic_group = ({32{select[ALU_AND]}} & (a & b))\n                     | ({32{select[ALU_OR]}} & (a | b))\n                     | ({32{select[ALU_XOR]}} & (a ''^ b));\n  assign other_group = ({32{select[ALU_LUI]}} & b)\n                     | {31'\"'b0, select[ALU_SLT] && (\"'$signed(a) < $signed(b))}\n                     | {31'\"'b0, select[ALU_SLTU] && (a < b)};\n  assign out = add_sub_group | shift_group | logic_group | other_group;\nendmodule\n''')\nPY\nprintf '%s\\\\n%s\\\\n' \\\"\"'$alu_dir\" \"$alu_flat_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
