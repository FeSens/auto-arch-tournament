{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\n\nsrc = Path('cores/bench/rtl')\nbase = Path('/srv/hwebench/tmp/7c172beb/4529f314/hyp-r2s1-prototype')\nbase.mkdir(exist_ok=True)\nrtl = base / 'rtl'\nshutil.copytree(src, rtl, dirs_exist_ok=True)\n\ndef change(file, *pairs):\n    p = rtl / file\n    s = p.read_text()\n    for old,new in pairs:\n        assert old in s, (file, old)\n        s = s.replace(old,new,1)\n    p.write_text(s)\n\nchange('core_pkg.sv', \n    ('    logic [31:0] imm;', '    logic [31:0] imm;\\\\n    logic [1:0]  rs1_match;\\\\n    logic [1:0]  rs2_match;'),\n    ('    logic [3:0]  mem_rmask;\\\\n    ctrl_t', '    logic [3:0]  mem_rmask;\\\\n    logic        fwd_valid;\\\\n    ctrl_t'))\n\nchange('core.sv',\n    ('logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', 'logic [2:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n  logic [1:0] rs1_match, rs2_match;'),\n    ('.rs2_data (rs2_data_w),\\\\n    .out', '.rs2_data (rs2_data_w),\\\\n    .rs1_match (rs1_match),\\\\n    .rs2_match (rs2_match),\\\\n    .out'),\n    ('(id_ex_w.ctrl.mem_read),', '(id_ex_w.valid && id_ex_w.ctrl.mem_read),'),\n    ('.redirect       (redirect),\\\\n    .divide_wait', '.if_id_valid    (if_id_w.valid),\\\\n    .redirect       (redirect),\\\\n    .divide_wait'),\n    ('(ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write)', '(ex_mem_w.valid && (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write))'),\n    ('''    .id_ex_rs1   (id_ex_w.rs1_addr),\n    .id_ex_rs2   (id_ex_w.rs2_addr),\n    .ex_mem_rd   (ex_mem_w.rd),\n    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\n    .mem_wb_rd   (mem_wb_w.rd),\n    .mem_wb_w_en (mem_wb_w.ctrl.reg_write),''','''    .id_rs1      (rs1_addr_w),\n    .id_rs2      (rs2_addr_w),\n    .id_ex_rd    (id_ex_w.rd),\n    .ex_mem_rd   (ex_mem_w.rd),\n    .rs1_match   (rs1_match),\n    .rs2_match   (rs2_match),\n    .ex_rs1_match (id_ex_w.rs1_match),\n    .ex_rs2_match (id_ex_w.rs2_match),\n    .ex_mem_w_en (ex_mem_w.valid && ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.ctrl.mem_read),\n    .mem_wb_w_en (mem_wb_w.fwd_valid),'\"'''))\n\n(rtl/'forward_unit.sv').write_text('''module forward_unit (\n  input  logic [4:0] id_rs1, id_rs2, id_ex_rd, ex_mem_rd,\n  output logic [1:0] rs1_match, rs2_match,\n  input  logic [1:0] ex_rs1_match, ex_rs2_match,\n  input  logic       ex_mem_w_en, mem_wb_w_en,\n  output logic [2:0] fwd_rs1, fwd_rs2\n);\n  assign rs1_match = {id_rs1 == ex_mem_rd && id_rs1 \"'!= 5'\"'d0,\n                     id_rs1 == id_ex_rd && id_rs1 \"'!= 5'\"'d0};\n  assign rs2_match = {id_rs2 == ex_mem_rd && id_rs2 \"'!= 5'\"'d0,\n                     id_rs2 == id_ex_rd && id_rs2 \"'!= 5'\"'d0};\n\n  assign fwd_rs1[0] = ex_rs1_match[0] && ex_mem_w_en;\n  assign fwd_rs1[1] = ex_rs1_match[1] && mem_wb_w_en && \"'!fwd_rs1[0];\n  assign fwd_rs1[2] = !fwd_rs1[0] && !fwd_rs1[1];\n\n  assign fwd_rs2[0] = ex_rs2_match[0] && ex_mem_w_en;\n  assign fwd_rs2[1] = ex_rs2_match[1] && mem_wb_w_en && !fwd_rs2[0];\n  assign fwd_rs2[2] = !fwd_rs2[0] && !fwd_rs2[1];\nendmodule\n'\"''')\n\nchange('id_stage.sv',\n    ('  // ID/EX register output', '  input  logic [1:0]        rs1_match, rs2_match,\\\\n  // ID/EX register output'),\n    ('''    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (\"'!stall) begin'\"''','''    if (reset) reg_q.valid <= 1'b0;\n    else if (\"'!stall) reg_q.valid <= in.valid && !flush;\n\n    if (!stall) begin'\"'''),\n    ('''      reg_q.valid    <= in.valid;''','''      reg_q.rs1_match <= rs1_match;\n      reg_q.rs2_match <= rs2_match;'''))\n\nchange('if_stage.sv',\n    (\\\"out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\\\", \\\"out.instr = imem_data;\\\"),\n    ('out.valid = \"'!(flush || redirect);'\"','out.valid = \"'!flush;'\"'))\n\nchange('hazard_unit.sv',\n    ('  input  logic       redirect,', '  input  logic       if_id_valid,\\\\n  input  logic       redirect,'),\n    ('load_use_hazard = id_ex_mem_read', 'load_use_hazard = if_id_valid && id_ex_mem_read'),\n    ('flush_if      = redirect || imem_stall;', 'flush_if      = imem_stall;'),\n    ('stall_id      = dmem_stall || load_use_hazard || divide_wait;', 'stall_id      = dmem_stall || divide_wait;'))\n\nchange('ex_stage.sv',\n    ('logic [1:0]         fwd_rs1_sel', 'logic [2:0]         fwd_rs1_sel'),\n    ('logic [1:0]         fwd_rs2_sel', 'logic [2:0]         fwd_rs2_sel'),\n    ('''  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end''','''  assign rs1 = ({32{fwd_rs1_sel[0]}} & fwd_ex_mem)\n             | ({32{fwd_rs1_sel[1]}} & fwd_mem_wb)\n             | ({32{fwd_rs1_sel[2]}} & in.rs1_val);\n  assign rs2 = ({32{fwd_rs2_sel[0]}} & fwd_ex_mem)\n             | ({32{fwd_rs2_sel[1]}} & fwd_mem_wb)\n             | ({32{fwd_rs2_sel[2]}} & in.rs2_val);'''),\n    ('assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;'\"',\n     'assign redirect        = in.valid && \"'!stall && (branch_taken || in.ctrl.is_jump) && !misalign_fault;'\"'))\n\nchange('mem_stage.sv',\n    ('mem_op       = in.ctrl.mem_read || in.ctrl.mem_write;', 'mem_op       = in.valid && (in.ctrl.mem_read || in.ctrl.mem_write);'),\n    ('(in.ctrl.mem_write && \"'!mem_misalign) ? byte_mask'\"', '(in.valid && in.ctrl.mem_write && \"'!mem_misalign) ? byte_mask'\"'),\n    ('in.ctrl.mem_read  && \"'!mem_misalign;'\"', 'in.valid && in.ctrl.mem_read && \"'!mem_misalign;'\"'),\n    ('      reg_q.valid      <= in.valid;', '      reg_q.valid      <= in.valid;\\\\n      reg_q.fwd_valid  <= in.valid && ctrl_with_trap.reg_write;'))\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval import gowin\n\nwt = Path.cwd()\nbase = Path('/srv/hwebench/tmp/7c172beb/4529f314/hyp-r2s1-prototype')\nfor r in gowin.build_all(wt, base / 'rtl', 'fpga/core_bench_si.sv', base / 'timing'):\n    print({**r, 'critical_paths': r.get('critical_paths', [])[:2]})\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
