{"type": "item.started", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/ceec273b/r12s1-exlanes.py <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path(\\\"/srv/hwebench/tmp/7c172beb/ceec273b\\\")\nvariant = sys.argv[1]\nrtl = root / (\\\"r12s1-\\\" + variant) / \\\"rtl\\\"\nshutil.copytree(\\\"cores/bench/rtl\\\", rtl, dirs_exist_ok=True)\n\ndef rub(name, old, new):\n    file = rtl / (name + \\\".sv\\\")\n    orig = file.read_text()\n    assert orig.count(old) == 1, (name, old)\n    file.write_text(orig.replace(old, new))\n\nrub(\\\"core_pkg\\\", \\\"logic alu, load, mul, div, late_add, late_double;\\\", \\\"logic alu, lane, load, mul, div, late_add, late_double;\\\")\nrub(\\\"core_pkg\\\", \\\"    logic ex_mem;\\\\n\\\", \\\"    logic ex_mem;\\\\n    logic ex_lane;\\\\n\\\")\nrub(\\\"core_pkg\\\", \\\"    logic [31:0] alu_result;\\\", \\\"    logic [31:0] alu_result;\\\\n    logic [31:0] lane_result;\\\")\nrub(\\\"alu\\\", \\\"parameter bit REGISTERED_SELECT = 1'b0\\\", \\\"parameter bit REGISTERED_SELECT = 1'b0,\\\\n  parameter bit SPLIT_RESULT = 1'b0\\\")\nrub(\\\"alu\\\", \\\"  output logic [31:0] out\\\\n\\\", \\\"  output logic [31:0] out,\\\\n  output logic [31:0] lane\\\\n\\\")\nif variant == \\\"shiftlane\\\":\n    rub(\\\"alu\\\", \\\"\\\"\\\"             | ({32{sel.sll}} & (a << b[4:0]))\n             | ({32{sel.srl || sel.sra}} & shift_right)\n             | ({32{sel.lui}} & b);\\\"\\\"\\\",\n        \\\"\\\"\\\"             | ({32{\"'!SPLIT_RESULT}} & lane)\n             | ({32{sel.lui}} & b);\n  assign lane = ({32{sel.sll}} & (a << b[4:0]))\n              | ({32{sel.srl || sel.sra}} & shift_right);\"\"\")\n    selector = \"in.alu_select.sll || in.alu_select.srl || in.alu_select.sra\"\nelif variant == \"addlane\":\n    rub(\"alu\", \"\"\"  assign out = ({32{sel.add}} & (a + b))\n             | ({32{sel.sub}} & (a - b))\n             | ({32{sel.and_op}} & (a & b))\"\"\",\n        \"\"\"  assign lane = a + b;\n  assign out = ({32{sel.add && !SPLIT_RESULT}} & lane)\n             | ({32{sel.sub}} & (a - b))\n             | ({32{sel.and_op}} & (a & b))\"\"\")\n    selector = \"in.alu_select.add\"\nelse:\n    raise ValueError(variant)\n\nrub(\"ex_stage\", \"  input  logic [31:0]        fwd_mem_wb,\", \"  input  logic [31:0]        fwd_lane,'\"\\\\n  input  logic [31:0]        fwd_mem_wb,\\\")\nrub(\\\"ex_stage\\\", \\\"  output logic               fast_write,\\\", \\\"  output logic               use_lane,\\\\n  output logic               fast_write,\\\")\nrub(\\\"ex_stage\\\", \\\"             | ({32{in.rs1_sel.mem_wb}}   & fwd_mem_wb)\\\", \\\"             | ({32{in.rs1_sel.ex_lane}}   & fwd_lane)\\\\n             | ({32{in.rs1_sel.mem_wb}}   & fwd_mem_wb)\\\")\nrub(\\\"ex_stage\\\", \\\"             | ({32{in.rs2_sel.mem_wb}}   & fwd_mem_wb)\\\", \\\"             | ({32{in.rs2_sel.ex_lane}}   & fwd_lane)\\\\n             | ({32{in.rs2_sel.mem_wb}}   & fwd_mem_wb)\\\")\nrub(\\\"ex_stage\\\", \\\"\\\"\\\"  logic [31:0] alu_result;\n  alu #(.REGISTERED_SELECT(1'b1)) u_alu (\\\"\\\"\\\", \\\"\\\"\\\"  logic [31:0] alu_result, lane_result;\n  assign use_lane = \\\"\\\"\\\" + selector + \\\"\\\"\\\";\n  alu #(.REGISTERED_SELECT(1'b1), .SPLIT_RESULT(1'b1)) u_alu (\\\"\\\"\\\")\nrub(\\\"ex_stage\\\", \\\"    .out (alu_result)\\\\n\\\", \\\"    .out (alu_result),\\\\n    .lane(lane_result)\\\\n\\\")\nrub(\\\"ex_stage\\\", \\\"    reg_q.alu_result    <= ex_result;\\\\n\\\", \\\"    reg_q.alu_result    <= ex_result;\\\\n      reg_q.lane_result   <= lane_result;\\\\n\\\")\nrub(\\\"ex_stage\\\", \\\"\\\"\\\"      reg_q.writeback_select.alu <= ctrl_with_trap.reg_write &&\n                                    \"'!(in.ctrl.mem_read || in.ctrl.is_mul || in.ctrl.is_div ||\n                                      use_late_add);\"\"\",\n    \"\"\"      reg_q.writeback_select.alu <= ctrl_with_trap.reg_write && !use_lane &&\n                                    !(in.ctrl.mem_read || in.ctrl.is_mul || in.ctrl.is_div ||\n                                      use_late_add);\n      reg_q.writeback_select.lane <= ctrl_with_trap.reg_write && use_lane &&\n                                     !(in.ctrl.mem_read || in.ctrl.is_mul || in.ctrl.is_div ||\n                                       use_late_add);\"\"\")\nrub(\"forward_unit\", \"  input  logic       ex_fast_write,\", \"  input  logic       ex_fast_write,'\"\\\\n  input  logic       ex_use_lane,\\\")\nrub(\\\"forward_unit\\\", \\\"    sel.ex_mem   = ex_match;\\\", \\\"    sel.ex_mem   = ex_match && \"'!ex_use_lane;'\"\\\\n    sel.ex_lane  = ex_match && ex_use_lane;\\\")\nrub(\\\"mem_stage\\\", \\\"                   | ({32{in.writeback_select.load}} & load_data)\\\", \\\"                   | ({32{in.writeback_select.lane}} & in.lane_result)\\\\n                   | ({32{in.writeback_select.load}} & load_data)\\\")\nrub(\\\"core\\\", \\\"logic       ex_fast_write, mem_next_write;\\\", \\\"logic       ex_fast_write, mem_next_write, ex_use_lane;\\\")\nrub(\\\"core\\\", \\\"    .fwd_mem_wb      (wb_w_data),\\\", \\\"    .fwd_lane        (ex_mem_w.lane_result),\\\\n    .fwd_mem_wb      (wb_w_data),\\\")\nrub(\\\"core\\\", \\\"    .fast_write      (ex_fast_write),\\\", \\\"    .fast_write      (ex_fast_write),\\\\n    .use_lane        (ex_use_lane),\\\")\nrub(\\\"core\\\", \\\"    .ex_fast_write (ex_fast_write),\\\", \\\"    .ex_fast_write (ex_fast_write),\\\\n    .ex_use_lane   (ex_use_lane),\\\")\nPY\nfor v in addlane shiftlane; do python /srv/hwebench/tmp/7c172beb/ceec273b/r12s1-exlanes.py \\\"\"'$v\" || exit; done'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
