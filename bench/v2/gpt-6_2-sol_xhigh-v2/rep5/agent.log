rets, _ = await _run(dut, program, dmem_init={0x40: 12}, imem_ready=ready)\n    pcs = [0, last - 4, last, target, target + 4]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets[:-1]] == pcs[1:]\n    assert fetches[:5] == [last - 4, last, last, last, target]\n    _, load, branch, div, _ = rets\n    assert branch[\"cycle\"] - load[\"cycle\"] == 2\n    assert div[\"cycle\"] - branch[\"cycle\"] == 10\n    assert div[\"rd_wdata\"] == 0xFFFFFFFF\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"multiplier.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n        XOR (2, 1, 4),         # x2 = x1 ^ x4 = 0x023\n-rw-rw----+ 1 hwebench hwebench 64384 Nov 22 12:19 formal/last_run-w9FzJDF2G.log\n","exit_code":0,"status":"completed"}}
