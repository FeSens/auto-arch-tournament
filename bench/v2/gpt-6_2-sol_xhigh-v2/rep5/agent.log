{"type": "item.completed", "item": {"id": "item_104", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,160p' cores/bench/test/test_divider.py && cat cores/bench/test/conftest.py\"", "aggregated_output": "\"\"\"RV32M divider arithmetic, fixed latency, and result handshake.\"\"\"\n\nfrom random import Random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _edge(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.launch.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_DIVU\n    dut.a.value = 0\n    dut.b.value = 0\n    await _edge(dut)\n    assert dut.idle.value == 1\n    assert dut.handoff_ready.value == 0\n    dut.reset.value = 0\n\n\nasync def _launch(dut, op, a, b):\n    assert dut.idle.value == 1\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.launch.value = 1\n    await _edge(dut)\n    dut.launch.value = 0\n    # Model forwarding sources changing before the initialization edge.\n    dut.op.value = ALU_DIV if op in (ALU_REM, ALU_REMU) else ALU_REMU\n    dut.a.value = ~a & MASK32\n    dut.b.value = ~b & MASK32\n    assert dut.idle.value == 0\n    assert dut.handoff_ready.value == 0\n\n\nasync def _reach_final_work_edge(dut):\n    # After launch, one initialization and six work edges precede handoff.\n    for cycle in range(1, 8):\n        await _edge(dut)\n        assert dut.idle.value == 0\n        assert dut.handoff_ready.value == (cycle == 7), f\"edge {cycle} after launch\"\n\n\nasync def _accept(dut):\n    dut.accept.value = 1\n    await _edge(dut)\n    dut.accept.value = 0\n    assert dut.idle.value == 1\n    assert dut.handoff_ready.value == 0\n\n\nasync def _check(dut, op, a, b, expected):\n    await _launch(dut, op, a, b)\n    await _reach_final_work_edge(dut)\n    # Accept on edge nine, the seventh work edge. The result is then usable in MEM.\n    await _accept(dut)\n    actual = int(dut.result.value)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a={a & MASK32:#010x} b={b & MASK32:#010x} \"\n        f\"expected={expected & MASK32:#010x} got={actual:#010x}\"\n    )\n\n\ndef _expected(op, a\n…[2235 of 5307 chars elided by tools/bench/transcript.py; sha256:9ef361deb0904e92]…\n and a >> 31:\n                    a -= 1 << 32\n                for b in range(-16 if signed else 0, 17):\n                    await _check(dut, op, a, b, _expected(op, a, b))\n\n\n@cocotb.test()\nasync def divisor_mode_boundaries(dut):\n    await _reset(dut)\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        signed = op in (ALU_DIV, ALU_REM)\n        divisors = [0, 2047, 2048, 2049, 65535, 65536, 65537, 1 << 24]\n        if signed:\n            divisors += [-b for b in divisors if b]\n            divisors.append(-(1 << 31))\n            large_dividends = (0x7FFFFFFF, -0x71234567, -(1 << 31))\n            min_dividend, max_dividend = -(1 << 31), 0x7FFFFFFF\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n", "exit_code": 0, "status": "completed"}}
