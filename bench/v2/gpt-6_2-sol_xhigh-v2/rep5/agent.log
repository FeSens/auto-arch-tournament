{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'set -e\nflop_dir=$(mktemp -d \"${TMPDIR:-/tmp}/bench-r5-rf-flop.XXXXXX\")\nlutram_dir=$(mktemp -d \"${TMPDIR:-/tmp}/bench-r5-rf-lutram.XXXXXX\")\ngit archive HEAD | tar -x -C \"$flop_dir\"\ngit archive HEAD | tar -x -C \"$lutram_dir\"\npython - \"$flop_dir\" \"$lutram_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\npaths = [Path(p) / 'cores/bench/rtl/reg_file.sv' for p in sys.argv[1:]]\nhead = paths[0].read_text().split('  logic [31:0] regs [0:31];', 1)[0]\npaths[0].write_text(head + '''  logic [31:0] words [0:31];\n  logic [31:0] rs1_lanes [0:31], rs2_lanes [0:31];\n  logic [31:0] rs1_banks [0:7], rs2_banks [0:7];\n  logic rs1_bypass, rs2_bypass;\n\n  assign words[0] = '0;\n  for (genvar i = 1; i < 32; i++) begin : g_word\n    always_ff @(posedge clock) begin\n      if (reset)\n        words[i] <= '0;\n      else if (w_en && w_addr == 5'(i))\n        words[i] <= w_data;\n    end\n  end\n\n  for (genvar i = 0; i < 32; i++) begin : g_lane\n    assign rs1_lanes[i] = {32{rs1_addr == 5'(i)}} & words[i];\n    assign rs2_lanes[i] = {32{rs2_addr == 5'(i)}} & words[i];\n  end\n\n  for (genvar i = 0; i < 8; i++) begin : g_bank\n    assign rs1_banks[i] = rs1_lanes[4*i] | rs1_lanes[4*i+1]\n                       | rs1_lanes[4*i+2] | rs1_lanes[4*i+3];\n    assign rs2_banks[i] = rs2_lanes[4*i] | rs2_lanes[4*i+1]\n                       | rs2_lanes[4*i+2] | rs2_lanes[4*i+3];\n  end\n\n  assign rs1_bypass = w_en && w_addr \"'!= 5'\"'b0 && rs1_addr == w_addr;\n  assign rs2_bypass = w_en && w_addr \"'!= 5'\"'b0 && rs2_addr == w_addr;\n  assign rs1_data = rs1_bypass ? w_data :\n                    rs1_banks[0] | rs1_banks[1] | rs1_banks[2] | rs1_banks[3]\n                  | rs1_banks[4] | rs1_banks[5] | rs1_banks[6] | rs1_banks[7];\n  assign rs2_data = rs2_bypass ? w_data :\n                    rs2_banks[0] | rs2_banks[1] | rs2_banks[2] | rs2_banks[3]\n                  | rs2_banks[4] | rs2_banks[5] | rs2_banks[6] | rs2_banks[7];\nendmodule\n''')\npaths[1].write_text(head + '''  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] bank_lo [0:15];\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [31:0] bank_hi [0:15];\n  logic [31:0] written;\n  logic write_word;\n  logic [31:0] rs1_raw, rs2_raw;\n\n  assign write_word = w_en && w_addr \"'!= 5'\"'b0;\n\n  always_ff @(posedge clock) begin\n    if (write_word && \"'!w_addr[4])\n      bank_lo[w_addr[3:0]] <= w_data;\n    if (write_word && w_addr[4])\n      bank_hi[w_addr[3:0]] <= w_data;\n    if (reset)\n      written <= '\"'0;\n    else if (write_word)\n      written[w_addr] <= 1'b1;\n  end\n\n  assign rs1_raw = rs1_addr[4] ? bank_hi[rs1_addr[3:0]] : bank_lo[rs1_addr[3:0]];\n  assign rs2_raw = rs2_addr[4] ? bank_hi[rs2_addr[3:0]] : bank_lo[rs2_addr[3:0]];\n  assign rs1_data = (write_word && rs1_addr == w_addr) ? w_data :\n                    written[rs1_addr] ? rs1_raw : '0;\n  assign rs2_data = (write_word && rs2_addr == w_addr) ? w_data :\n                    written[rs2_addr] ? rs2_raw : '0;\nendmodule\n''')\nPY\nprintf '%s\\\\n%s\\\\n' \\\"\"'$flop_dir\" \"$lutram_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
