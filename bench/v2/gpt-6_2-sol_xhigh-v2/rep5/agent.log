{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c 'PREDICTOR_VARIANTS=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\" python3 - <<'\"'PY'\nimport collections, os\nfrom pathlib import Path\ndata = []\nctrl = collections.Counter()\nfor ln in (Path(os.environ['PREDICTOR_VARIANTS'])/'control-trace.txt').read_text().splitlines():\n    if ln.startswith('{'):\n        continue\n    i, p, n = map(lambda x: int(x,16), ln.split()[:3])\n    ctrl[i & 127] += 1\n    if i & 127 == 0x63:\n        data.append((p>>2, int(n\"'!=p+4), i>>31))\nprint('\"'Conditional, JAL, JALR:', {hex(k): v for k,v in ctrl.items()})\nps = collections.defaultdict(collections.Counter)\nfor p,t,_ in data:\n    ps[p][t] += 1\nprint('Direction records',len(data),'distinct branches',len(ps),'perfect static misses',sum(min(x[0],x[1]) for x in ps.values()))\nprint('Top flip-prone:',[(hex(p*4), s[0], s[1]) for p,s in sorted(ps.items(), key=lambda x:-min(x[1][0],x[1][1]))[:18]])\ndef sim(entries, hbits, folding, hshift=0, local=False, static=False, init=1):\n    table = [init]*entries\n    valid = [False]*entries\n    hist = 0\n    local_hist = [0]*entries\n    miss = 0\n    hmask = (1 << hbits) - 1\n    for p,t,back in data:\n        if folding:\n            p \"'^= p >> (entries.bit_length()-1)\n        idx = (p ''^ ((local_hist[p % entries] if local else hist)<<hshift)) % entries\n        miss += (table[idx]>>1 if valid[idx] or not static else back) != t\n        valid[idx] = True\n        table[idx] = min(3, table[idx]+1) if t else max(0, table[idx]-1)\n        hist = ((hist<<1)|t) & hmask\n        local_hist[p % entries] = ((local_hist[p % entries]<<1)|t) & hmask\n    return miss\nfor nn in (64, 128, 256):\n    options = sorted((sim(nn, h, f, 0, lo),h,f,lo) for h in (0, 2, 3, 4, 5, 6) for f in (0,1) for lo in (0,1))\n    print(nn, options[:5], '\"'gshare2',sim(nn,2,0),'bimodal',sim(nn,0,0))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
