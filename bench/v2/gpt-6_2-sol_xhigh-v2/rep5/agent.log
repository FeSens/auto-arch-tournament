{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\"\ncat > \"$trial_dir/trace_predictor.cpp\" <<'\"'EOF'\n#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <string>\n#include <tuple>\n#include <vector>\n\nstruct Branch {\n    unsigned word;\n    bool taken;\n};\n\nint main() {\n    std::vector<Branch> branches;\n    std::string insn;\n    unsigned pc, next, cycle;\n    while (std::cin >> insn >> std::hex >> pc >> next >> std::dec >> cycle) {\n        if ((std::stoul(insn, nullptr, 16) & 0x7f) == 0x63)\n            branches.push_back({pc >> 2, next \"'!= pc + 4});\n    }\n\n    for (unsigned bits = 5; bits <= 8; ++bits) {\n        std::vector<std::tuple<int,unsigned,unsigned,unsigned,unsigned>> stats;\n        for (unsigned fold = 0; fold <= 10; ++fold) {\n            for (unsigned taps = 0; taps <= 2; ++taps) {\n                for (unsigned hist = 0; hist <= bits; ++hist) {\n                    for (unsigned shift = 0; shift <= bits - hist; ++shift) {\n                        unsigned history = 0;\n                        const unsigned idx_mask = (1u << bits) - 1;\n                        const unsigned hist_mask = (1u << hist) - 1;\n                        unsigned pht[256];\n                        std::fill_n(pht, 256, 1u);\n                        int misses = 0;\n                        for (auto [word, taken] : branches) {\n                            unsigned pc_part = word;\n                            if (fold) {\n                                pc_part ''^= word >> fold;\n                                if (taps > 0)\n                                    pc_part ''^= word >> (fold + bits);\n                                if (taps > 1)\n                                    pc_part ''^= word >> (fold + bits * 2);\n                            }\n                            unsigned &cnt = pht[(pc_part ''^ (history << shift)) & idx_mask];\n                            misses += (cnt >= 2) != taken;\n                            cnt = taken ? std::min(3u, cnt + 1) : cnt ? cnt - 1 : 0;\n                            history = ((history << 1) | taken) & hist_mask;\n                        }\n                        stats.emplace_back(misses, fold, taps, hist, shift);\n                    }\n                }\n            }\n        }\n        std::sort(stats.begin(), stats.end());\n        for (size_t i = 0; i < 8; ++i) {\n            auto [misses, fold, taps, hist, shift] = stats[i];\n            std::cout << bits << '\"' ' << misses << ' ' << fold << ' ' << taps << ' ' << hist << ' ' << shift << '\\\\n';\n        }\n    }\n}\nEOF\nc++ -std=c++17 -O3 \\\"\"'$trial_dir/trace_predictor.cpp\" -o \"$trial_dir/trace_predictor\"\n\"$trial_dir/trace_predictor\" < \"$trial_dir/control-trace.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
