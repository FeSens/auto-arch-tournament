{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport shutil\n\ns = Path(os.environ['TMPDIR'])/'r10s0'\nref = s/'radix16/cores/bench/rtl'\nsrc = (ref/'divider.sv').read_text()\n\ndef variant(name, spec):\n    dest = s/name/'cores/bench'\n    shutil.copytree(ref,dest/'rtl')\n    (dest/'rtl/divider.sv').write_text(spec)\n\ni = src.index('  assign narrow_digit =')\nj = src.index('  logic [34:0] multiples', i)\nexplicit = src[:i] + \\\"\\\"\\\"  assign narrow_digit[3] = \"'!narrow_borrow[8];\n  assign narrow_digit[2] = (!narrow_borrow[4] && narrow_borrow[8]) || !narrow_borrow[12];\n  assign narrow_digit[1] = (!narrow_borrow[2] && narrow_borrow[4])\n                        || (!narrow_borrow[6] && narrow_borrow[8])\n                        || (!narrow_borrow[10] && narrow_borrow[12])\n                        || !narrow_borrow[14];\n  assign narrow_digit[0] = |(narrow_select & 16'\"'haaaa);\n  assign narrow_remainder[0] = narrow_trial[0] \"'^ (narrow_digit[0] && divisor_q[0]);\n\n  for (genvar i = 1; i < 11; i++) begin : gen_narrow_remainder\n    wire [15:0] bit_candidates;\n    for (genvar k = 0; k <= 15; k++) begin : gen_candidate\n      assign bit_candidates[k] = narrow_select[k] && narrow_difference[k][i];\n    end\n    assign narrow_remainder[i] = |bit_candidates;\n  end\n\n\"\"\" + src[j:]\nvariant(\"radix16-bitselect\", explicit)\n\nreduced = explicit[:explicit.index(\"  for (genvar i = 1; i < 11; i++)\")] + \"\"\"  for (genvar i = 1; i < 11; i++) begin : gen_narrow_remainder\n    localparam integer DISTINCT = 1 << (i < 3 ? i+1 : 4);\n    wire [DISTINCT-1:0] bit_candidates;\n    for (genvar k = 0; k < DISTINCT; k++) begin : gen_candidate\n      wire [15:0] digit_subset;\n      for (genvar d = 0; d < 16; d++)\n        assign digit_subset[d] = d % DISTINCT == k && narrow_select[d];\n      assign bit_candidates[k] = (|digit_subset) && narrow_difference[k][i];\n  