{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Selects operands, runs the ALU and address adder, and\n// resolves branches. Owns the EX/MEM pipeline register.\n//\n// Latency:        1 cycle, or launch + initialization + seven work cycles for DIV/REM.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               mem_recovery,  // cancel speculative divide work\n  input  id_ex_t   in,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,    // MEM/WB registered result\n  input  logic               mem_next_write,\n  output ex_mem_t  out,\n  output logic               fast_write,   // eligible fast result for incoming ID\n  output logic [31:0]        multiply_result,\n  output logic [31:0]        divide_result,\n  output logic               divide_wait,  // hold issue and ID/EX until result is ready\n  output logic               advance_aperture,\n  output logic               redirect,\n  output logic [31:2]        redirect_word,\n  output logic               train_branch,\n  output logic [5:0]         train_index,\n  output logic               train_taken\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = ({32{in.rs1_sel.ex_mem}}   & fwd_ex_mem)\n             | ({32{in.rs1_sel.mem_wb}}   & fwd_mem_wb)\n             | ({32{in.rs1_sel.reg_file}} & in.rs1_val);\n  assign rs2 = ({32{in.rs2_sel.ex_mem}}   & fwd_ex_mem)\n             | ({32{in.rs2_sel.mem_wb}}   & fwd_mem_wb)\n             | ({32{in.rs2_sel.reg_file}} & in.rs2_val);\n\n  // ── Load/store effective address ─────────────────────────────────────\n  // The offset contributes 0 or -1 to the upper word before carry.\n  // Compute the upper increment and decrement prefixe\n…[7427 of 10499 chars elided by tools/bench/transcript.py; sha256:e7ac82e9c13e04a4]…\ntrl.is_mul || in.ctrl.is_div ||\n                                      use_late_add);\n      reg_q.writeback_select.load <= ctrl_with_trap.mem_read;\n      reg_q.writeback_select.mul <= in.ctrl.is_mul;\n      reg_q.writeback_select.div <= in.ctrl.is_div;\n      reg_q.writeback_select.late_add <= use_late_add && !double_operand;\n      reg_q.writeback_select.late_double <= use_late_add && double_operand;\n      reg_q.pending_rs1   <= in.pending_rs1 && mem_next_write;\n      reg_q.pending_rs2   <= in.pending_rs2 && mem_next_write;\n      reg_q.late_operand  <= late_operand;\n      reg_q.late_branch   <= in.late_branch;\n      reg_q.branch_cond   <= branch_cond;\n      reg_q.predicted_taken <= in.predicted_taken;\n      reg_q.prediction_index <= in.prediction_index;\n      reg_q.branch_target <= target;\n      reg_q.pc_plus_4     <= pc_plus_4;\n      reg_q.recovery_word <= redirect_word;\n      reg_q.instr         <= in.instr;\n      reg_q.valid         <= in.valid && !divide_wait;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// rtl/if_stage.sv\n//\n// Fetch, predict and decode into a four-entry flow-through issue FIFO.\n// An empty FIFO lets a ready response issue on the acceptance edge.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              issue_stall,\n  input  logic              imem_ready,\n  input  logic              ex_redirect,\n  input  logic [31:2]       ex_redirect_word,\n  input  logic              mem_redirect,\n  input  logic [31:2]       mem_redirect_word,\n  output logic              ex_recovery,\n  output logic              mem_recovery,\n  input  logic              advance_aperture,\n  input  logic              train_branch,\n  input  logic [5:0]        train_index,\n  input  logic              train_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output logic              issue_candidate,\n  output logic              issue,\n  output issue_packet_t     out\n);\n\n  logic [31:2] pc_word, sequential_q, retry_q, ex_target_q, mem_target_q;\n  logic [19:2] prediction_q;\n  logic sequential_select_q, predicted_select_q, retry_select_q, recovering;\n  logic [1:0]  history_q;\n  logic [1:0]  counters [0:63];\n\n  logic        update_valid_q, update_taken_q;\n  logic [5:0]  update_index_q;\n  logic [1:0]  update_counter;\n\n  assign update_counter = counters[update_index_q];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      history_q      <= 2'b00;\n      update_valid_q <= 1'b0;\n      update_taken_q <= 1'b0;\n      update_index_q <= 6'b0;\n      for (int i = 0; i < 64; i++)\n        counters[i] <= 2'b01;\n    end else begin\n      update_valid_q <= train_branch;\n      if (train_branch) begin\n        history_q      <= {history_q[0], train_taken};\n        update_index_q <= train_index;\n        update_taken_q <= train_taken;\n      end\n\n      // Read the counter when \n…[6240 of 9312 chars elided by tools/bench/transcript.py; sha256:3eac68aaed7be1a4]…\nic empty, full;\n\n  assign empty = recovering || read_ptr_q == write_ptr_q;\n  assign full  = !recovering && read_ptr_q == {~write_ptr_q[2], write_ptr_q[1:0]};\n  assign response_valid = imem_ready && (!aperture_wait_q || recovering);\n  assign accept_response = response_valid && !full && !reset;\n  assign out = empty ? response : fifo[read_ptr_q[1:0]];\n  assign issue_candidate = (!empty || response_valid) && !issue_stall && !reset;\n  assign issue = issue_candidate;\n\n  always_ff @(posedge clock) begin\n    if (accept_response)\n      fifo[write_ptr_q[1:0]] <= response;\n\n    if (reset) begin\n      read_ptr_q  <= '0;\n      write_ptr_q <= '0;\n    end else begin\n      // During recovery, the corrected request bypasses the stale FIFO.\n      // Rebase at the write pointer while accounting for that response.\n      if (recovering)     read_ptr_q  <= write_ptr_q + {2'b0, issue};\n      else if (issue)      read_ptr_q  <= read_ptr_q + 3'd1;\n      if (accept_response) write_ptr_q <= write_ptr_q + 3'd1;\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
