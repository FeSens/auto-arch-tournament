{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport shutil\nfrom pathlib import Path\nroot = Path('/srv/hwebench/tmp/7c172beb/26de4279/radix16.GwU4WK')\nvariants = [\n    ('rtl_width11_lutrf_zero_share', True, False),\n    ('rtl_width11_lutrf_zero_chunk', False, True),\n    ('rtl_width11_lutrf_zero_share_chunk', True, True),\n]\nfor variant, share, chunk in variants:\n    dest = root / variant\n    shutil.copytree(root / 'rtl_width11_lutrf_zero', dest)\n    p = dest / 'divider.sv'\n    s = p.read_text()\n    if share:\n        s = s.replace('  logic [12:0] small_three_q;', '  wire [12:0] small_three_q = large_odd_q[1][12:0];')\n        s = ''.join(line for line in s.splitlines(keepends=True) if 'small_three_q     <=' not in line)\n    if chunk:\n        i = s.index('  assign a_mag_lo')\n        j = s.index('  assign a_mag_hi', i)\n        s = s[:i] + \\\"\\\"\\\"  assign a_mag_lo[20:0]  = a_negative_q ? -a_q[20:0] : a_q[20:0];\n  assign a_mag_lo[27:21] = a_negative_q ? ~a_q[27:21] + {6'b0, a_q[20:0] == 21'b0}\n                                          : a_q[27:21];\n\\\"\\\"\\\" + s[j:]\n    p.write_text(s)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python '\"'/srv/hwebench/tmp/7c172beb/26de4279/radix16.GwU4WK/timing.py' rtl_width11_lutrf_zero_share\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
