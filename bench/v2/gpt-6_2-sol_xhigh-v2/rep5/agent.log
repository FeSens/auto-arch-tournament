{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c \"cp -r cores/bench/rtl prototype_a && cat > optimize.py <<'PY'\nfrom pathlib import Path\n\npath = Path(\\\"cores/bench/rtl/if_stage.sv\\\")\nsource = Path(\\\"prototype_a/if_stage.sv\\\").read_text()\n\ndef replace(old, new):\n    global source\n    assert source.count(old) == 1, old\n    source = source.replace(old, new)\n\nreplace(\\\"\\\"\\\"    logic [31:0] target;\n    logic        eligible;\n    logic        branch;\n    logic        jump;\n    logic        late_eligible;\\\"\\\"\\\", \\\"\\\"\\\"    logic [19:2] target;\n    logic        branch;\n    logic        jump;\\\"\\\"\\\")\nreplace(\\\"logic fence_accept, fence_pending, fill_write;\\\", \\\"logic fence_accept, fence_clear_q, fence_pending, fill_write;\\\")\nreplace(\\\"assign fill_write = \"'!reset && !fence_accept && !fence_pending && fill_pending_q &&\",\n        \"assign fill_write = fill_pending_q &&\")\nreplace(\"\"\"    if (reset) begin\n      fence_count_q <= '\"'0;\\\"\\\"\\\", \\\"\\\"\\\"    fence_clear_q <= \"'!reset && fence_accept;\n    if (reset) begin\n      fence_count_q <= '\"'0;\\\"\\\"\\\")\nreplace(\\\"\\\"\\\"                        pc_word \"'!= LAST_IMEM_WORD && !response.ctrl.is_jalr;\"\"\",\n        \"\"\"                        pc_word != LAST_IMEM_WORD && !response.ctrl.is_jalr &&\n                        (!(is_branch || is_jal) || (direct_in_range && !direct_bit1));\"\"\")\nreplace(\"\"\"    fill_q.target <= response.direct_target;\n    fill_q.eligible <= direct_in_range && !direct_bit1;\"\"\", \"\"\"    fill_q.target <= direct_word[19:2];\"\"\")\nreplace(\"    fill_q.late_eligible <= response.late_eligible;'\"\\\\n\\\", \\\"\\\")\nreplace(\\\"\\\"\\\"  logic [31:3] even_word;\n  logic [4:0] even_index, odd_index;\\\"\\\"\\\", \\\"\\\"\\\"  logic [19:2] lookup_word;\n  logic [11:0] even_tag;\n  logic [4:0] even_index, odd_index;\n  logic lookup_enable, lookup_in_range