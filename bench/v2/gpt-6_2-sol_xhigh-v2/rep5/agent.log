ite_text(s)\n    mem = dst / 'mem_stage.sv'\n    s = mem.read_text()\n    idx = s.index('  // EX has qualified')\n    s = s[:idx] + \\\"\\\"\\\"  logic [31:13] address_upper;\n\n  assign address_upper[13] = in.mem_addr[13] \"'^ (in.addr_inc || in.addr_dec);\n  for (genvar i = 1; i < 19; i++) begin : gen_address_upper\n    assign address_upper[i+13] = in.mem_addr[i+13] ''^\n        ((in.addr_inc && (&in.mem_addr[13 +: i])) ||\n         (in.addr_dec && !(|in.mem_addr[13 +: i])));\n  end\n\n\"\"\" + s[idx:]\n    s = s.replace('\"'dmem_addr  = in.mem_addr;', 'dmem_addr  = {address_upper, in.mem_addr[12:0]};')\n    s = s.replace('{in.mem_addr[31:2], 2\\\\'b00}', '{dmem_addr[31:2], 2\\\\'b00}')\n    mem.write_text(s)\nretime_source(baseline, scratch / 'retime' / 'rtl')\nretime_source(variant, scratch / 'retime_cla' / 'rtl')\nPY\nPYTHONDONTWRITEBYTECODE=1 python - '/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2' <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json, sys\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(sys.argv[1])\ndef timing(name, rtl):\n    results = build_all(Path.cwd(), rtl, 'fpga/core_bench_si.sv', scratch / ('gowin_' + name))\n    (scratch / (name + '.json')).write_text(json.dumps(results, indent=2))\n    print(name, json.dumps(summarize(results)), flush=True)\nwith ThreadPoolExecutor(max_workers=2) as ex:\n    future = [ex.submit(timing, n, p) for n, p in [\n        ('baseline', Path('cores/bench/rtl')), ('retime', scratch / 'retime' / 'rtl'),\n        ('noshare', scratch / 'noshare' / 'rtl'), ('retime_cla', scratch / 'retime_cla' / 'rtl')]]\n    for f in future:\n        f.result()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python - '/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2' <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport sys\nfrom tools.eval.cosim import run_one, run_coremark_crc\nfrom tools.eval.fpga import COREMARK_SIM_FLAGS, validate_coremark_uart\nimport json, subprocess\nscratch = Path(sys.argv[1])\nroot = Path.cwd()\nprograms = scratch / 'bench/programs'\nsim_bin = scratch / 'obj/cosim_sim'\ndef trace(elf, flags):\n    result = run_one(elf, str(sim_bin), str(root), sim_flags=flags)\n    print(result, flush=True)\n    return result['passed']\ndef coremark():\n    result = subprocess.run([str(sim_bin), str(programs / 'coremark.elf'), '50000000', *COREMARK_SIM_FLAGS], capture_output=True, text=True, check=True)\n    marker = json.loads(result.stdout.splitlines()[-1])\n    valid, reason = validate_coremark_uart(marker['uart'], 10)\n    assert valid, reason\n    assert marker['ebreak'] and marker['bench_bracketed'] and not marker['oob']\n    print('CoreMark CRCs passed, cycles', marker['bench_stop_cycle'] - marker['bench_start_cycle'], flush=True)\n    return True\nwith ThreadPoolExecutor(max_workers=4) as workers:\n    all_checks = [workers.submit(coremark)]\n    all_checks.extend(workers.submit(trace, p, f) for p in sorted(programs.glob('*.elf')) if p.stem \"'!= '\"'coremark' for f in [(), ('--istall','--dstall')])\n    assert all(f.result() for f in all_checks)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
