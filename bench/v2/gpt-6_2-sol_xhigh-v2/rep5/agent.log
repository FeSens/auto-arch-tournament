{"type":"item.started","item":{"id":"item_98","type":"command_execution","command":"/bin/bash -c \"set -e\npython - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/test/test_pipeline.py')\ns = p.read_text()\ns = s.replace('def test_pipeline_runner():', '''@cocotb.test()\nasync def bypass_priority_with_trap_and_retained_writeback(dut):\n    stalled_samples = 0\n\n    def ready(addr, ren, wen):\n        nonlocal stalled_samples\n        if addr == 64 and wen and stalled_samples < 3:\n            stalled_samples += 1\n            return False\n        return True\n\n    program = [\n        ADDI(1, 0, 2), ADDI(5, 0, 29),\n        JALR(5, 1, 0), ADD(6, 5, 5),\n        ADDI(5, 0, 10), ADDI(5, 0, 11), ADD(7, 5, 5),\n        ADDI(1, 0, 64), ADDI(5, 0, 23),\n        SW(0, 1, 0), ADD(8, 5, 5), EBREAK(),\n    ]\n    retired, mem = await _run(dut, program, dmem_ready=ready)\n    trap = _by_insn(retired, JALR(5, 1, 0))[0]\n    assert trap[\\\"trap\\\"] == 1 and trap[\\\"rd\\\"] == 0\n    for target, value in [(6, 29), (7, 11), (8, 23)]:\n        r = _by_insn(retired, ADD(target, 5, 5))[0]\n        assert (r[\\\"rs1_rdata\\\"], r[\\\"rs2_rdata\\\"], r[\\\"rd_wdata\\\"]) == (value, value, 2 * value)\n    assert stalled_samples == 3 and mem[64] == 0\n    assert [r[\\\"order\\\"] for r in retired] == list(range(len(program)))\n\n\ndef test_pipeline_runner():''')\np.write_text(s)\nPY\npytest -q cores/bench/test/test_pipeline.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
