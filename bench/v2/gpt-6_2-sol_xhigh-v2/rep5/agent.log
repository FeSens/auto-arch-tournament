{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-predictor.35FE9v\"\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nscratch = Path(sys.argv[1])\nfor name in ('bounded2','qfloat2','bounded-shift2'):\n    root = scratch / f'{name}-unit'\n    root.mkdir()\n    (root/'rtl').symlink_to(scratch/f'rtl-{name}')\n    shutil.copytree(scratch/'queue2-formal'/'cores'/'bench'/'test', root/'test',\n                    ignore=shutil.ignore_patterns('__pycache__', '*.xml'))\n    p = root/'test'/'test_pipeline.py'\n    s = p.read_text().replace('def test_pipeline_runner():', '''@cocotb.test()\nasync def held_branch_does_not_run_past_imem_aperture(dut):\n    base = 0xFFFF0\n    program = {\n        0: ADDI(1, 0, 1),\n        4: JAL(0, base - 4),\n        base: SW(1, 0, 0x40),\n        base + 4: BEQ(1, 1, -20),\n        base + 8: SW(1, 0, 0x44),\n        base + 12: SW(1, 0, 0x48),\n        base - 16: EBREAK(),\n    }\n    stores = []\n\n    def data_ready(addr, ren, wen):\n        if ren or wen:\n            stores.append(addr)\n        return len(stores) >= 4\n\n    def instruction_ready(addr):\n        assert 0 <= addr < 0x100000\n        return True\n\n    rets, dmem = await _run(\n        dut, program, imem_ready=instruction_ready, dmem_ready=data_ready\n    )\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, base, base + 4, base - 16]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert dmem == {0x40: 1}\n\n\ndef test_pipeline_runner():''')\n    p.write_text(s)\nPY\nfor name in bounded2 qfloat2 bounded-shift2; do\n  (cd \\\"\"'$scratch/$name-unit\" && pytest -q test > \"$scratch/$name-tests.log\" 2>&1) &\ndone\nwait\nfor name in bounded2 qfloat2 bounded-shift2; do\n  tail -10 \"$scratch/$name-tests.log\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
