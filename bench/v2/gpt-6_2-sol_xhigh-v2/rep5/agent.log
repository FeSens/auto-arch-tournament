{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/retime_sweep.py\" <<'\"'PY'\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nimport re\nimport shutil\nfrom sweep import run, scratch, source, target_adder, sum_line\n\ndef steers(t):\n    for flag in ('ex', 'mem'):\n        t = t.replace(f'logic [31:2] pc_word', 'logic [31:2] pc_word', 1)\n    start = t.index('  assign pc_word =')\n    stop = t.index('  always_ff', start)\n    t = t[:start] + \\\"\\\"\\\"  logic ex_select_q;\n  assign pc_word = ({30{mem_recovery}} & mem_target_q)\n                 | ({30{ex_select_q}} & ex_target_q)\n                 | ({30{sequential_select_q}} & sequential_q)\n                 | ({30{predicted_select_q}} & {12'b0, prediction_q})\n                 | ({30{retry_select_q}} & retry_q);\n\n\\\"\\\"\\\" + t[stop:]\n    t = t.replace('    ex_recovery <= \"'!reset && ex_redirect;'\"', '''    ex_recovery <= \"'!reset && ex_redirect;\n    ex_select_q <= !reset && ex_redirect && !mem_redirect;'\"''')\n    t = t.replace('sequential_select_q <= \"'!reset &&'\"', 'sequential_select_q <= \"'!reset && !ex_redirect && !mem_redirect &&'\"')\n    t = t.replace('predicted_select_q <= \"'!reset &&'\"', 'predicted_select_q <= \"'!reset && !ex_redirect && !mem_redirect &&'\"')\n    t = t.replace('retry_select_q <= reset || \"'!advance_request;'\"', 'retry_select_q <= reset || (\"'!ex_redirect && !mem_redirect && !advance_request);'\"')\n    return t\n\ndef retime(variant, variant_type):\n    file = variant / 'if_stage.sv'\n    fetch = file.read_text()\n    if variant_type in ('hi', 'hibp', 'hisplit', 'histeer'):\n        fetch = re.sub(r'  assign target_carry =.*?\"'^  end'\"\\\\n', '', fetch, flags=re.S|re.M)\n        fetch = fetch.replace('  logic [31:2] direct_word;', '  logic [19:2] direct_word;')\n        fetch = fetch.replace('logic        direct_in_range, target_carry, target_borrow;', 'logic        direct_in_range;')\n        fetch = fetch.replace('    = {direct_word, direct_bit1, 1\\\\'b0};', '    = {direct_word, direct_bit1, 1\\\\'b0};')\n        fetch = fetch.replace('  assign response.predicted_taken', '''  assign response.direct_carry    = direct_low_sum[18];\n  assign response.direct_negative = offset_word[20];\n  assign response.predicted_taken''')\n        pkg = variant / 'core_pkg.sv'\n        pkg.write_text(pkg.read_text().replace('logic [31:0] direct_target;', 'logic [19:0] direct_target;\\\\n    logic        direct_carry;\\\\n    logic        direct_negative;'))\n        decode = variant / 'id_stage.sv'\n        decode.write_text(decode.read_text().replace('      reg_q.predicted_taken', '''      reg_q.direct_carry     <= in.direct_carry;\n      reg_q.direct_negative  <= in.direct_negative;\n      reg_q.predicted_taken'''))\n        ex = variant / 'ex_stage.sv'\n        xt = ex.read_text()\n        xt = xt.replace(\\\" : in.direct_target;\\\", \\\" : {direct_hi, in.direct_target};\\\")\n        if variant_type == 'hibp':\n            maker = \\\"\\\"\\\"  wire [11:0] pc_high = in.pc[31:20];\n  wire [11:0] direct_hi = (in.direct_carry == in.direct_negative) ? pc_high :\n                         (in.direct_carry ? pc_high + 12'd1 : pc_high - 12'd1);\n\n\\\"\\\"\\\"\n        else:\n            maker = \\\"\\\"\\\"  wire [11:0] pc_high = in.pc[31:20];\n  wire direct_carry_up = in.direct_carry && \"'!in.direct_negative;\n  wire direct_borrow = !in.direct_carry && in.direct_negative;\n  wire [11:0] direct_hi;\n  assign direct_hi[0] = pc_high[0] ''^ in.direct_carry ''^ in.direct_negative;\n  for (genvar i = 1; i < 12; i++) begin : gen_direct_hi\n    assign direct_hi[i] = pc_high[i] ''^ ((direct_carry_up && (&pc_high[i-1:0])) ||\n                                       (direct_borrow && !(|pc_high[i-1:0])));\n  end\n\n\"\"\"\n        ex.write_text(xt.replace('\"'  assign jalr_sum', maker + '  assign jalr_sum', 1))\n        if variant_type == 'hisplit'