{"type": "item.completed", "item": {"id": "item_69", "type": "command_execution", "command": "/bin/bash -c \"git status --short --untracked-files=all; git diff --check; sed -n '1,210p' cores/bench/rtl/if_stage.sv\"", "aggregated_output": " M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/forward_unit.sv\n M cores/bench/rtl/hazard_unit.sv\n M cores/bench/rtl/id_stage.sv\n M cores/bench/rtl/if_stage.sv\n M cores/bench/test/test_pipeline.py\n// rtl/if_stage.sv\n//\n// Instruction fetch with gshare prediction and a four-entry flow-through\n// queue. Recovery selects a request from registers and bypasses the queue.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage resolution).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              decode_stall,\n  input  logic              imem_ready,\n  input  logic [31:2]       alternate_word,\n  input  logic              direction_miss,\n  input  logic              aperture_resume,\n  output logic              recovering,\n  input  logic              train_branch,\n  input  logic [5:0]        train_index,\n  input  logic              train_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [31:2] pc_word_q, request_word, alternate_word_q;\n  logic        direction_miss_q, aperture_resume_q;\n\n  always_ff @(posedge clock) begin\n    alternate_word_q  <= alternate_word;\n    direction_miss_q  <= !reset && direction_miss;\n    aperture_resume_q <= !reset && aperture_resume;\n  end\n\n  assign recovering   = direction_miss_q || aperture_resume_q;\n  assign request_word = ({30{!recovering}} & pc_word_q)\n                      | ({30{direction_miss_q && !aperture_resume_q}} & alternate_word_q)\n                      | ({30{aperture_resume_q}} & FETCH_RESUME_WORD);\n  assign imem_addr    = {request_word, 2'b00};\n\n  logic [1:0]  history_q;\n  logic [1:0]  counters [0:63];\n\n  logic        update_valid_q, update_taken_q;\n  logic [5:0]  update_index_q;\n  logic [1:0]  update_counter;\n\n  assign update_counter = counters[update_index_q];\n\n  always_ff \n…[3438 of 6510 chars elided by tools/bench/transcript.py; sha256:18f0637c9e7db64c]…\n: fifo[head_q[1:0]];\n  assign out.valid  = !queue_empty || fetch_valid;\n\n  // Asynchronous read, synchronous write. Physical writes depend only on\n  // the registered pointers. Tail advances only for a logical enqueue.\n  always_ff @(posedge clock) begin\n    if (!fifo_full) fifo[tail_q[1:0]] <= raw_packet;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || recovering) begin\n      head_q <= '0;\n      tail_q <= '0;\n    end else begin\n      if (pop)  head_q <= head_q + 3'd1;\n      if (push) tail_q <= tail_q + 3'd1;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_word_q          <= '0;\n      boundary_pending_q <= 1'b0;\n    end else begin\n      if (fetch_accept && (!at_last_word || predicted_taken))\n        pc_word_q <= predicted_taken ? direct_word : request_word + 30'd1;\n      else if (recovering)\n        pc_word_q <= request_word;\n\n      if (fetch_accept || recovering)\n        boundary_pending_q <= fetch_accept && at_last_word && !predicted_taken;\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
