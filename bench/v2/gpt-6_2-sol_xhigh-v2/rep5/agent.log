{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"NRET=1 RTL_DIR='/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2/direct_load_small/rtl' OBJ_DIR='/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2/direct_load_small/obj' bash test/cosim/build.sh > '/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2/direct_load_small/cosim-build.log' 2>&1 && PYTHONDONTWRITEBYTECODE=1 python - '/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2' <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport sys\nfrom tools.eval.cosim import run_one\nfrom tools.eval.fpga import COREMARK_SIM_FLAGS, validate_coremark_uart\nimport json, subprocess\nscratch = Path(sys.argv[1])\nroot = Path.cwd()\nprograms = scratch / 'bench/programs'\nsim_bin = scratch / 'direct_load_small/obj/cosim_sim'\ndef trace(elf, flags):\n    result = run_one(elf, str(sim_bin), str(root), sim_flags=flags)\n    print(result, flush=True)\n    return result['passed']\ndef coremark():\n    result = subprocess.run([str(sim_bin), str(programs / 'coremark.elf'), '50000000', *COREMARK_SIM_FLAGS], capture_output=True, text=True, check=True)\n    marker = json.loads(result.stdout.splitlines()[-1])\n    valid, reason = validate_coremark_uart(marker['uart'], 10)\n    assert valid, reason\n    assert marker['ebreak'] and marker['bench_bracketed'] and not marker['oob']\n    print('CoreMark CRCs passed, cycles', marker['bench_stop_cycle'] - marker['bench_start_cycle'], flush=True)\n    return True\nwith ThreadPoolExecutor(max_workers=4) as workers:\n    all_checks = [workers.submit(coremark)]\n    all_checks.extend(workers.submit(trace, p, f) for p in sorted(programs.glob('*.elf')) if p.stem \"'!= '\"'coremark' for f in [(), ('--istall','--dstall')])\n    assert all(f.result() for f in all_checks)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
