{"type": "item.started", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/bash -c \"cat > deferred_target.py <<'PY'\nfrom pathlib import Path\n\ndef make_variant(base, var, replay):\n    base = Path(base)\n    dest = Path(var)\n    dest.mkdir()\n    for p in base.glob(\\\"*.sv\\\"):\n        (dest / p.name).write_bytes(p.read_bytes())\n    def edit(file, changes):\n        p = dest / file\n        text = p.read_text()\n        for old, new in changes:\n            assert old in text, (file,old)\n            text = text.replace(old, new)\n        p.write_text(text)\n    edit(\\\"core_pkg.sv\\\", [\n        (\\\"logic [31:0] direct_target;\\\", \\\"\\\"\\\"logic [19:1] direct_target_low;\n    logic        direct_carry;\n    logic        direct_negative;\\\"\\\"\\\"),\n    ])\n    edit(\\\"id_stage.sv\\\", [\n        (\\\"      reg_q.direct_target    <= in.direct_target;\\\", \\\"\\\"\\\"      reg_q.direct_target_low <= in.direct_target_low;\n      reg_q.direct_carry      <= in.direct_carry;\n      reg_q.direct_negative   <= in.direct_negative;\\\"\\\"\\\"),\n    ])\n    ifstage = (base / \\\"if_stage.sv\\\").read_text()\n    start = ifstage.index(\\\"  assign target_carry\\\")\n    end = ifstage.index(\\\"  assign direct_in_range\\\",start)\n    edit(\\\"if_stage.sv\\\", [\n        (\\\"logic [31:2] direct_word;\\\", \\\"logic [19:2] direct_word;\\\"),\n        (\\\"logic        direct_in_range, target_carry, target_borrow;\\\", \\\"logic        direct_in_range;\\\"),\n        (ifstage[start:end], \\\"\\\"),\n        (\\\"assign direct_word[19:2]\\\", \\\"assign direct_word\\\"),\n        (\\\"assign response.direct_target    = {direct_word, direct_bit1, 1'b0};\\\", \\\"\\\"\\\"assign response.direct_target_low = {direct_word, direct_bit1};\n  assign response.direct_carry      = direct_low_sum[18];\n  assign response.direct_negative   = offset_word[20];\\\"\\\"\\\"),\n    ])\n    edit(\\\"ex_stage.sv\\\", [\n        (\\\"logic [31:0] target, pc_