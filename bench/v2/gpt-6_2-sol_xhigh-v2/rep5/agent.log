{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\n\nf = Path(os.environ['TMPDIR'])/'r10s0/radix16/cores/bench/test/test_divider.py'\nsrc = f.read_text()\ni = src.index(\\\"@cocotb.test()\\\\nasync def holds_result\\\")\nf.write_text(src[:i]+\\\"\\\"\\\"@cocotb.test()\nasync def radix16_digit_boundaries(dut):\n    await _reset(dut)\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        signed = op in (ALU_DIV, ALU_REM)\n        limit = (1 << (31 if signed else 32)) - 1\n        for d in (1, 3, 15, 16, 127, 128, 255, 256, 1023, 1024, 2047, 2048):\n            high_q = ((limit - 16 * d) // d) & ~15\n            for upper in (0, high_q):\n                for digit in range(1, 16):\n                    for delta in (-1, 0, 1):\n                        a = (upper + digit) * d + delta\n                        await _check(dut, op, a, d, _expected(op, a, d))\n                        if signed:\n                            await _check(dut, op, -a, -d, _expected(op, -a, -d))\n\n\n\\\"\\\"\\\"+src[i:])\nPY\ncd \\\"\"'$TMPDIR/r10s0/radix16/cores/bench\" && pytest -q --rootdir=. test'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
