{"type": "item.completed", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c \"sed -n '82,115p' tools/orchestrator.py && sed -n '530,556p' tools/orchestrator.py && sed -n '1,130p' formal/checks_si.cfg\"", "aggregated_output": "# the agent touches is rejected before the eval gates run. Without this an\n# agent could silently soften checks.cfg, the cosim main.cpp, or the\n# fpga.py CRC table and inflate its own fitness score.\n#\n# Permitted modifications per CLAUDE.md \"What hypotheses MAY change\":\n#   - cores/<target>/rtl/ (any file)\n#   - cores/<target>/test/test_*.py (cocotb suites for new modules)\n#   - cores/<target>/implementation_notes.md (the agent's own writeup)\n#   - cores/<target>/core.yaml\n#\n# Everything else is off-limits.\ndef allowed_patterns_for(target: str) -> tuple:\n    base = re.escape(f\"cores/{target}\")\n    return (\n        re.compile(rf\"^{base}/rtl/.+\"),\n        re.compile(rf\"^{base}/test/test_[^/]+\\.py$\"),\n        re.compile(rf\"^{base}/implementation_notes\\.md$\"),\n        # Per-iteration worktrees are checked out at cores/<target>/worktrees/<id>/,\n        # but the agent's cwd is the worktree root and the prompt says\n        # \"current directory\" — so models commonly write\n        # implementation_notes.md at the worktree root instead. Both\n        # locations are equally innocuous; allowing both removes a\n        # routine sandbox-violation failure mode that would otherwise\n        # mark every iteration broken.\n        re.compile(r\"^implementation_notes\\.md$\"),\n        re.compile(rf\"^{base}/core\\.yaml$\"),\n    )\n\n\ndef path_is_allowed(path: str, patterns: tuple) -> bool:\n    return any(p.match(path) for p in patterns)\n\n\ndef offlimits_changes(worktree: str, patterns: tuple,\n    build = subprocess.run(\n        [\"bash\", \"test/cosim/build.sh\"],\n        cwd=worktree, capture_output=True,\n        env=build_env,\n    )\n    if build.returncode != 0:\n        return _fail(\"cosim build\", build)\n    return (True, \"\")\n\ndef _read_notes(worktree: str) -> str:\n    p = Path(worktree) / \"implementation_notes.md\"\n    return p.read_text() if p.exists() else \"\"\n\ndef run_report():\n    log = read_log()\n    if not log:\n        print(\"No experiments yet.\")\n        return\n    improvements = [e for e in log if e.get('outcome') == 'improvement']\n    broken       = [e for e in log if e.get('outcome') == 'broken']\n    regressions  = [e for e in log if e.get('outcome') == 'regression']\n    print(f\"\\nExperiment Report\")\n    print(f\"  Total iterations : {len(log)}\")\n    print(f\"  Improvements     : {len(improvements)}\")\n    print(f\"  Regressions      : {len(regressions)}\")\n    print(f\"  Broken           : {len(broken)}\")\n    if improvements:\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
