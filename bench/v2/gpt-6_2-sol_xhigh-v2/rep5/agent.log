{"type": "item.completed", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c \"cat fpga/core_bench_si.sv; sed -n '1,120p' formal/wrapper_si.sv; sed -n '1,110p' formal/checks_si.cfg\"", "aggregated_output": "// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[5181 of 8253 chars elided by tools/bench/transcript.py; sha256:9bd68fcb45d72343]…\nr    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c 'prototype=/srv/hwebench/tmp/7c172beb/9e717abd/bench-r7s1.8t1sArxj\ncat > \"$prototype/queue.py\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\n\nroot = Path(sys.argv[1])\ndepth = int(sys.argv[2])\nstrategy = sys.argv[3]\n\ndef edit(filename, *replacements):\n    p = root / filename\n    data = p.read_text()\n    for old, new in replacements:\n        assert data.count(old) == 1, (filename, old)\n        data = data.replace(old, new)\n    p.write_text(data)\n\nshared = \\\"\\\"\\\"  if_id_t fetch_packet, stored_packet;\n  logic push, pop, occupied, room, boundary_wait_q;\n  logic resume_boundary;\n  localparam logic [31:2] LAST_IMEM_WORD = 30'h003ffff;\n\n  assign resume_boundary = boundary_wait_q && ex_advance && ex_pc_word == LAST_IMEM_WORD;\n  assign push = \"'!reset && imem_ready && room && !boundary_wait_q;\n  assign pop = out.valid && !stall;\n  assign fetch_packet.pc = imem_addr;\n  assign fetch_packet.instr = imem_data;\n  assign fetch_packet.direct_target = {direct_word, direct_bit1, 1'\"'b0};\n  assign fetch_packet.predicted_taken = predicted_taken;\n  assign fetch_packet.prediction_index = prediction_index;\n  assign fetch_packet.valid = imem_ready && \"'!boundary_wait_q;\n  assign out = occupied ? stored_packet : fetch_packet;\n  assign imem_addr = {pc_word, 2'\"'b00};\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_word <= '0;\n      boundary_wait_q <= 1'b0;\n    end else if (redirect || resume_boundary) begin\n      pc_word <= redirect_word;\n      boundary_wait_q <= 1'b0;\n    end else if (push) begin\n      if (\"'!predicted_taken && pc_word == LAST_IMEM_WORD)\n        boundary_wait_q <= 1'\"'b1;\n      else\n        pc_word <= predicted_taken ? direct_word : pc_word + 30'd1;\n    end\n  end\n\\\"\\\"\\\"\n\nif depth == 1:\n    fifo = \\\"\\\"\\\"  if_id_t buffer_q;\n  logic full_q;\n\n  assign occupied = full_q;\n  assign room = \"'!full_q;\n  assign stored_packet = buffer_q;\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) full_q <= 1'\"'b0;\n    else if (push \"'!= pop) full_q <= push;\n    if (push) buffer_q <= fetch_packet;\n  end\n\"\"\"\n    if strategy == \"refill\":\n        fifo = fifo.replace(\"assign room = !full_q;\", \"assign room = !full_q || pop;\")\nelse:\n    n = (depth - 1).bit_length()\n    fifo = f\"\"\"  localparam int PACKET_BITS = 32 + 32 + 32 + 1 + 6 + 1;\n  logic [PACKET_BITS-1:0] buffer_q [0:{depth-1}];\n  logic [{n}:0] read_q, write_q;\n\n  assign occupied = read_q != write_q;\n  assign room = !(read_q[{n-1}:0] == write_q[{n-1}:0] && read_q[{n}] != write_q[{n}]);\n  assign stored_packet = buffer_q[read_q[{n-1}:0]];\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      read_q <= '\"'0;\n      write_q <= '0;\n    end else begin\n      if (push) write_q <= write_q + 1'b1;\n      if (pop) read_q <= read_q + 1'b1;\n    end\n    if (push) buffer_q[write_q[{n-1}:0]] <= fetch_packet;\n  end\n\\\"\\\"\\\"\n    if strategy == \\\"refill\\\":\n        fifo = fifo.replace(f\\\"&& read_q[{n}] \"'!= write_q[{n}]);\", f\"&& read_q[{n}] != write_q[{n}]) || pop;\")\np = root / \"if_stage.sv\"\ndata = p.read_text()\ndata = data.replace(\"  input  logic        train_branch,\", \"\"\"  input  logic        ex_advance,\n  input  logic [31:2] ex_pc_word,\n  input  logic        train_branch,\"\"\")\ndata = data[:data.index(\"  // EX only redirects\")]\np.write_text(data + shared + \"'\"\\\\n\\\" + fifo + \\\"\\\\nendmodule\\\\n\\\")\nedit(\\\"core.sv\\\",\n    (\\\"  logic        redirect;\\\", \\\"  logic        redirect, ex_advance;\\\"),\n    (\\\"    .redirect_word   (redirect_word),\\\\n    .train_branch\\\", \\\"    .redirect_word   (redirect_word),\\\\n    .ex_advance      (ex_advance),\\\\n    .ex_pc_word      (id_ex_w.pc[31:2]),\\\\n    .train_branch\\\"),\n    (\\\"    .redirect_word   (redirect_word),\\\\n    .train_branch     \\\"[:0] + \\\"\\\"\\\"    .divide_wait     (divide_wait),\n    .redirect\\\"\\\"\\\", \\\"\\\"\\\"    .divide_wait     (divide_wait),\n    .ex_advance      (ex_advance),\n    .redirect\\\"\\\"\\\"))\nedit(\\\"ex_stage.sv\\\",\n    (\\\"  output logic               redirect,\\\", \\\"  output logic               ex_advance,\\\\n  output logic               redirect,\\\"),\n    (\\\"  assign redirect       = advance\\\", \\\"  assign ex_advance     = advance;\\\\n  assign redirect       = advance\\\"))\nPY\nfor depth in 1 2 4; do\n mkdir -p \\\"\"'$prototype/q$depth\"\n cp -R cores/bench/rtl \"$prototype/q$depth/\"\n python3 \"$prototype/queue.py\" \"$prototype/q$depth/rtl\" \"$depth\" no-refill\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
