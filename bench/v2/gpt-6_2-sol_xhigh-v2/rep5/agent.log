{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/7c172beb/fd057cb8/r15-alu.ULFhl6/hist.py' <<'PY'\nimport collections\nimport re\nimport sys\n\nfield = re.compile(rb'\\\"cycle\\\":(\\\\d+),\\\"insn\\\":(\\\\d+),\\\"pc_rdata\\\":\\\\d+,\\\"pc_wdata\\\":\\\\d+,\\\"rd_addr\\\":(\\\\d+),\\\"rd_wdata\\\":\\\\d+,\\\"rs1_addr\\\":(\\\\d+),\\\"rs1_rdata\\\":\\\\d+,\\\"rs2_addr\\\":(\\\\d+),\\\"rs2_rdata\\\":\\\\d+,\\\"mem_addr\\\":(\\\\d+),\\\"mem_rmask\\\":\\\\d+,\\\"mem_rdata\\\":\\\\d+,\\\"mem_wmask\\\":(\\\\d+)')\nnames = {\n    0x03: \\\"load\\\", 0x23: \\\"store\\\", 0x33: \\\"op\\\", 0x13: \\\"imm\\\", 0x63: \\\"branch\\\",\n    0x67: \\\"jalr\\\", 0x6f: \\\"jal\\\", 0x17: \\\"auipc\\\", 0x37: \\\"lui\\\", 0x73: \\\"system\\\",\n}\n\nactive = False\nprev = None\ncategories = collections.Counter()\ngapped = collections.Counter()\ninstructions = collections.Counter()\ntotal_gap = 0\nfor line in sys.stdin.buffer:\n    parsed = field.search(line)\n    if parsed is None:\n        continue\n    cyc, insn, rd, r1, r2, address, wen = map(int, parsed.groups())\n    if wen and address == 0x10000100:\n        active = True\n    elif wen and address == 0x10000104:\n        active = False\n    if not active:\n        continue\n    op = insn & 0x7f\n    funct3 = (insn >> 12) & 7\n    funct7 = insn >> 25\n    suffix = f\\\":{funct3}\\\" if op in (0x33, 0x13, 0x63) else \\\"\\\"\n    name = names.get(op, str(op)) + suffix\n    if op == 0x33 and funct7 \"'!= 0:\n        name += f\".{funct7}\"\n    instructions[name] += 1\n    if prev is not None:\n        prev_cyc, prev_name, prev_rd = prev\n        gap = cyc - prev_cyc - 1\n        total_gap += gap\n        p1 = prev_rd != 0 and r1 == prev_rd\n        p2 = prev_rd != 0 and r2 == prev_rd\n        if p1 or p2:\n            use1 = op in (0x03, 0x23, 0x33, 0x13, 0x63, 0x67)\n            use2 = op in (0x23, 0x33, 0x63)\n            prefix = (\"rs1\" if p1 and use1 else \"\") + (\"rs2\" if p2 and use2 else \"\")\n            category = (prev_name, name, prefix or \"encoded-only\")\n            categories[category] += 1\n            gapped[category] += min(gap, 1)\n    prev = (cyc, name, rd)\nprint(\"retirements\", sum(instructions.values()), \"bubbles\", total_gap)\nprint(instructions.most_common(20))\nfor key, count in categories.most_common(85):\n    print(key, count, \"gapped\", gapped[key])\nPY\nset -o pipefail && '\"'/srv/hwebench/tmp/7c172beb/fd057cb8/r15-alu.ULFhl6/obj_b/cosim_sim' '/srv/hwebench/tmp/7c172beb/fd057cb8/r15-alu.ULFhl6/bench/programs/coremark.elf' 50000000 --istall --dstall | python '/srv/hwebench/tmp/7c172beb/fd057cb8/r15-alu.ULFhl6/hist.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
