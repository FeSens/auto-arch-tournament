{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'set -euo pipefail\nprofile_dir=$(mktemp -d \"$TMPDIR/bench-divider-profile.XXXXXX\")\nprintf '\"'%s\\\\n' \\\"\"'$profile_dir\"\nriscv32-unknown-elf-gcc -march=rv32im -mabi=ilp32 -O3 -static -nostartfiles -specs=nano.specs -specs=nosys.specs -T bench/programs/link.ld -Ibench/programs/coremark -Ibench/programs/coremark/baremetal -DTOTAL_DATA_SIZE=2000 bench/programs/coremark/core_list_join.c bench/programs/coremark/core_main.c bench/programs/coremark/core_matrix.c bench/programs/coremark/core_state.c bench/programs/coremark/core_util.c bench/programs/coremark/baremetal/core_portme.c bench/programs/crt0.S -o \"$profile_dir/coremark.elf\"\nRTL_DIR=\"$PWD/cores/bench/rtl\" OBJ_DIR=\"$profile_dir/obj\" NRET=1 bash test/cosim/build.sh >\"$profile_dir/build.log\" 2>&1 || { cat \"$profile_dir/build.log\"; exit 1; }\n\"$profile_dir/obj/cosim_sim\" \"$profile_dir/coremark.elf\" 50000000 --bench --istall --dstall > \"$profile_dir/summary.jsonl\"\n\"$profile_dir/obj/cosim_sim\" \"$profile_dir/coremark.elf\" 50000000 --istall --dstall | python3 -c '\"'\nimport collections\nimport json\nimport re\nimport sys\n\nwith open(sys.argv[1]) as summary:\n    _, final = map(json.loads, summary)\nlo, hi = (final[key] for key in (\\\"bench_start_cycle\\\", \\\"bench_stop_cycle\\\"))\nassert final[\\\"ebreak\\\"] and final[\\\"bench_bracketed\\\"] and not final[\\\"oob\\\"]\nassert \\\"Correct operation validated.\\\" in final[\\\"uart\\\"]\nfor key, val in zip((\\\"seedcrc\\\", \\\"crclist\\\", \\\"crcmatrix\\\", \\\"crcstate\\\", \\\"crcfinal\\\"),\n                    (\\\"0xe9f5\\\", \\\"0xe714\\\", \\\"0x1fd7\\\", \\\"0x8e3a\\\", \\\"0xfcaf\\\")):\n    assert re.search(key + r\\\".*\\\" + val, final[\\\"uart\\\"]), key\nprefix = re.compile(rb\\\"\"'^'\"\\\\{\\\\\\\"order\\\\\\\":\\\\d+,\\\\\\\"cycle\\\\\\\":(\\\\d+),\\\\\\\"insn\\\\\\\":(\\\\d+),\\\")\ncounts, timed = collections.Counter(), collections.Counter()\nretired = 0\nfor line in sys.stdin.buffer:\n    match = prefix.match(line)\n    assert match, line[:100]\n    cycle, insn = map(int, match.groups())\n    in_window = lo <= cycle < hi\n    retired += in_window\n    if insn & 0xfe00407f == 0x02004033:\n        kind = (\\\"DIV\\\", \\\"DIVU\\\", \\\"REM\\\", \\\"REMU\\\")[(insn >> 12) & 3]\n        counts[kind] += 1\n        timed[kind] += in_window\nprint(f\\\"CoreMark markers {lo}..{hi} ({hi-lo} cycles), {retired} bracketed retirements\\\")\nprint(f\\\"DIV/REM in full run {dict(counts)} and in timed window {dict(timed)}\\\")\n' \\\"\"'$profile_dir/summary.jsonl\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
