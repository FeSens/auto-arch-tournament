{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nr = Path('cores/bench/rtl')\n\ndef change(name, pairs):\n    p = r/name\n    s = p.read_text()\n    for old, new in pairs:\n        assert s.count(old)==1, (name,old,s.count(old))\n        s = s.replace(old, new)\n    p.write_text(s)\n\nchange('divider.sv', [\n    ('  output logic        result_valid,','  output logic        final_step,\\\\n  output logic        result_valid,'),\n    ('''  // 0 = idle, 7..2 = six work cycles, 1 = result pending.\n  logic [2:0] phase_q;''','''  // 0 = idle, 8..2 = seven work cycles, 1 = result pending.\n  logic [3:0] phase_q;'''),\n    ('''  assign idle         = phase_q == 3'd0;\n  assign result_valid = phase_q == 3'd1;\n  assign starting     = idle && launch;\n  assign stepping     = |phase_q[2:1];\n\n  always_ff @(posedge clock) begin\n    if (reset)                       phase_q <= 3'd0;\n    else if (starting)               phase_q <= 3'd7;\n    else if (stepping)               phase_q <= phase_q - 3'd1;\n    else if (result_valid && accept) phase_q <= 3'd0;\n  end''','''  assign idle         = phase_q == 4'd0;\n  assign final_step   = phase_q == 4'd2;\n  assign result_valid = phase_q == 4'd1;\n  assign starting     = idle && launch;\n  assign stepping     = |phase_q[3:1];\n\n  always_ff @(posedge clock) begin\n    if (reset)                                           phase_q <= 4'd0;\n    else if (starting)                                   phase_q <= 4'd8;\n    else if ((final_step || result_valid) && accept)     phase_q <= 4'd0;\n    else if (stepping)                                   phase_q <= phase_q - 4'd1;\n  end'''),\n    ('logic [35:0] quotient_q;', 'logic [31:0] quotient_q;'),\n    ('  logic [33:0] step1, step2, step3;', '''  // Resolve the leading nibble at launch. Only a divisor below 16\n  // can produce nonzero quotient digits in this prefix.\n  logic [3:0] head_a, head_d;\n  logic [5:0] triple_head_d;\n  logic small_divisor;\n  logic [5:0] head1, head2;\n\n  assign head_a = a_negative ? (~a[31:28] + {3'b0, a[27:0] == 0}) : a[31:28];\n  assign small_divisor = b_negative ? ((&b[31:4]) && (|b[3:0])) : \"'!(|b[31:4]);\n  assign head_d = b_negative ? -b[3:0] : b[3:0];\n  assign triple_head_d = {2'\"'b0, head_d} + {1'b0, head_d, 1'b0};\n\n  function automatic [5:0] prefix_step (\n    input logic [5:0] partial_dividend,\n    input logic [3:0] divisor,\n    input logic [5:0] three_divisor\n  );\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [6:0] diff1, diff2, diff3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    begin\n      diff1 = {1'b0, partial_dividend} - {3'b0, divisor};\n      diff2 = {1'b0, partial_dividend} - {2'b0, divisor, 1'b0};\n      diff3 = {1'b0, partial_dividend} - {1'b0, three_divisor};\n      if (\"'!diff3[6])      prefix_step = {2'\"'d3, diff3[3:0]};\n      else if (\"'!diff2[6]) prefix_step = {2'\"'d2, diff2[3:0]};\n      else if (\"'!diff1[6]) prefix_step = {2'\"'d1, diff1[3:0]};\n      else                prefix_step = {2'd0, partial_dividend[3:0]};\n    end\n  endfunction\n\n  assign head1 = prefix_step({4'b0, head_a[3:2]}, head_d, triple_head_d);\n  assign head2 = prefix_step({head1[3:0], head_a[1:0]}, head_d, triple_head_d);\n\n  logic [33:0] step1, step2;'''),\n    ('''  assign step1 = radix4_step({remainder_q, quotient_q[35:34]}, divisor_q, three_divisor_q);\n  assign step2 = radix4_step({step1[31:0], quotient_q[33:32]}, divisor_q, three_divisor_q);\n  assign step3 = radix4_step({step2[31:0], quotient_q[31:30]}, divisor_q, three_divisor_q);''','''  assign step1 = radix4_step({remainder_q, quotient_q[31:30]}, divisor_q, three_divisor_q);\n  assign step2 = radix4_step({step1[31:0], quotient_q[29:28]}, divisor_q, three_divisor_q);'''),\n    ('''      remainder_q       <= '0;\n      // The upper bits feed the dividend into the subtractors. Each\n      // step replaces two consumed bits with a digit at the bottom.\n      quotient_q        <= {4'b0, a_magnitude};''','''      remainder_q       <= {28'b0, small_divisor ? head2[3:0] : head_a};\n      // Each radix-4 step replaces two consumed bits with a quotient digit.\n      quotient_q        <= {a_magnitude[27:0], small_divisor ? {head1[5:4], head2[5:4]} : 4'b0};'''),\n    ('''      remainder_q <= step3[31:0];\n      quotient_q  <= {quotient_q[29:0], step1[33:32], step2[33:32], step3[33:32]};''','''      remainder_q <= step2[31:0];\n      quotient_q  <= {quotient_q[27:0], step1[33:32], step2[33:32]};'''),\n    ('  logic [31:0] a_magnitude, b_magnitude;','  logic [27:0] a_magnitude;\\\\n  logic [31:0] b_magnitude;'),\n    ('a_negative ? -a : a;', 'a_negative ? -a[27:0] : a[27:0];'),\n])\nchange('core_pkg.sv', [('logic        is_multiply;', 'logic        is_multiply;\\\\n    logic        is_divide;')])\nchange('ex_stage.sv', [\n    ('  output logic               is_multiply,','  output logic               is_multiply,\\\\n  output logic               is_divide,\\\\n  output logic [31:0]        divide_result,'),\n    ('''  logic is_divide, divide_idle, divide_launch, divide_ready, divide_accept;\n  logic [31:0] divide_result;''','''  logic divide_idle, divide_launch, divide_ready, divide_accept;\n  logic divide_final_step, divide_result_valid;'''),\n    ('  assign divide_launch =', '  assign divide_ready  = divide_final_step || divide_result_valid;\\\\n  assign divide_launch ='),\n    ('    .result_valid (divide_ready),','    .final_step   (divide_final_step),\\\\n    .result_valid (divide_result_valid),'),\n    ('''  assign ex_result = ({32{in.ctrl.is_jump}} & pc_plus_4)\n                   | ({32{is_divide}} & divide_result)\n                   | ({32{\"'!(in.ctrl.is_jump || is_divide)}} & alu_result);'\"''',\n     '''  assign ex_result = in.ctrl.is_jump ? pc_plus_4 : alu_result;'''),\n    ('      reg_q.is_multiply   <= is_multiply;', '      reg_q.is_multiply   <= is_multiply;\\\\n      reg_q.is_divide     <= is_divide;'),\n])\nchange('mem_stage.sv', [\n    ('  input  logic [31:0]        multiply_result,','  input  logic [31:0]        multiply_result,\\\\n  input  logic [31:0]        divide_result,'),\n    ('                    | ({32{in.ctrl.mem_to_reg}} & load_data)\\\\n                    | ({32{\"'!(in.is_multiply || in.ctrl.mem_to_reg)}} & in.alu_result);'\"',\n     '''                    | ({32{in.is_divide}} & divide_result)\n                    | ({32{in.ctrl.mem_to_reg}} & load_data)\n                    | ({32{\"'!(in.is_multiply || in.is_divide || in.ctrl.mem_to_reg)}} & in.alu_result);'\"'''),\n])\nchange('core.sv', [\n    ('logic       divide_wait, is_multiply;', 'logic       divide_wait, is_multiply, is_divide;'),\n    ('logic [31:0] multiply_result;', 'logic [31:0] multiply_result, divide_result;'),\n    ('    .is_multiply     (is_multiply),','    .is_multiply     (is_multiply),\\\\n    .is_divide       (is_divide),\\\\n    .divide_result   (divide_result),'),\n    ('    .multiply_result(multiply_result),','    .multiply_result(multiply_result),\\\\n    .divide_result  (divide_result),'),\n    ('    .id_ex_mem_read (id_ex_w.ctrl.mem_read || is_multiply),','    .id_ex_mem_read (id_ex_w.ctrl.mem_read || is_multiply || is_divide),'),\n    ('ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.is_multiply'\"','ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.is_multiply && !ex_mem_w.is_divide'\"'),\n])\nchange('hazard_unit.sv', [\n    ('(load_use_hazard && \"'!stall_ex_mem);'\"','(load_use_hazard && \"'!stall_ex_mem && !divide_wait);'\"')\n])\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
