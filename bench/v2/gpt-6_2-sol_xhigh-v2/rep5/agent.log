{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/test/test_pipeline.py')\ns = p.read_text()\nwhere = s.index('def test_pipeline_runner():')\ns = s[:where] + '''@cocotb.test()\nasync def loop_replay_across_bank_row_wrap(dut):\n    start, backedge = 0x0F0, 0x108\n    program = {\n        0: ADDI(1, 0, 4),\n        4: JAL(0, start - 4),\n        0x0F0: NOP(),\n        0x0F4: NOP(),\n        0x0F8: NOP(),\n        0x0FC: ADDI(2, 2, 1),\n        0x100: ADDI(3, 3, 2),\n        0x104: ADDI(1, 1, -1),\n        backedge: BNE(1, 0, start - backedge),\n        0x10C: EBREAK(),\n    }\n    entries = 0\n    stalled = []\n\n    def ready(addr):\n        nonlocal entries\n        if addr == start:\n            entries += 1\n        if entries == 3 and addr in (0x0FC, 0x100):\n            stalled.append(addr)\n            return False\n        return True\n\n    rets, _ = await _run(dut, program, imem_ready=ready)\n    assert stalled == [0x0FC, 0x100]\n    body = list(range(start, backedge + 4, 4))\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4] + body * 4 + [0x10C]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 0x100] == [2, 4, 6, 8]\n\n\n@cocotb.test()\nasync def loop_replay_invalidates_behind_fence_i(dut):\n    start, backedge = 0x0F0, 0x108\n    program = {\n        0: ADDI(1, 0, 4),\n        4: JAL(0, start - 4),\n        0x0F0: NOP(),\n        0x0F4: NOP(),\n        0x0F8: NOP(),\n        0x0FC: NOP(),\n        0x100: ADDI(3, 3, 2),\n        0x104: ADDI(1, 1, -1),\n        backedge: BNE(1, 0, start - backedge),\n        0x10C: BNE(7, 0, 0x30),\n        0x110: 0x0000100F,\n        0x114: ADDI(7, 0, 1),\n        0x118: ADDI(1, 0, 1),\n        0x11C: JAL(0, start - 0x11C),\n        0x13C: EBREAK(),\n    }\n    entries = 0\n    attempts = 0\n\n    def ready(addr):\n        nonlocal entries, attempts\n        if addr == start:\n            entries += 1\n        if addr == 0x114:\n            program[0x100] = ADDI(3, 3, 7)\n        if entries == 5 and addr == 0x100:\n            attempts += 1\n            return attempts >= 3\n        return True\n\n    rets, _ = await _run(dut, program, imem_ready=ready)\n    assert attempts == 3\n    assert [r[\\\"rd_wdata\\\"] for r in rets if r[\\\"pc\\\"] == 0x100] == [2, 4, 6, 8, 15]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n\n\n''' + s[where:]\np.write_text(s)\nPY\ncp -R cores/bench/test variant2/cores/bench/\ncp -R cores/bench/test variant3/cores/bench/\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
