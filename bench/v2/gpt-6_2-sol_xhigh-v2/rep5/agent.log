{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"set -e\nexport BENCH_MUL_SCRATCH='/srv/hwebench/tmp/7c172beb/008b187e/bench-multiply.yaeNDH'\ncp -r cores/bench/test \\\"\"'$BENCH_MUL_SCRATCH/test\"\npython3 - <<'\"'PY'\nfrom pathlib import Path\nimport os\np = Path(os.environ['BENCH_MUL_SCRATCH']) / 'test/test_pipeline.py'\nsource = p.read_text()\nsource = source.replace('\\\"alu.sv\\\", \\\"divider.sv\\\",', '\\\"alu.sv\\\", \\\"divider.sv\\\", \\\"multiplier.sv\\\",')\ntest = '''\n\n@cocotb.test()\nasync def multiply_bypasses_after_older_stalled_store(dut):\n    mul = _r(1, 2, 1, 0, 3, 0b0110011)\n    next_mul = _r(1, 2, 3, 0, 4, 0b0110011)\n    stalled_store = SW(2, 0, 0x40)\n    dependent_store = SW(3, 4, 0)\n    program = [ADDI(1, 0, 4), ADDI(2, 0, 5), stalled_store,\n               mul, next_mul, dependent_store, EBREAK()]\n    requests = []\n\n    def ready(addr, ren, wen):\n        if not wen:\n            return True\n        requests.append((addr, int(dut.io_dmemWData.value)))\n        return len(requests) > 3\n\n    rets, dmem = await _run(dut, program, dmem_ready=ready)\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(program)))\n    assert requests == [(0x40, 5)] * 4 + [(100, 20)]\n    assert dmem == {0x40: 5, 100: 20}\n\n    older, first, second, store = rets[2:6]\n    assert (first[\\\"rs1_rdata\\\"], first[\\\"rs2_rdata\\\"], first[\\\"rd_wdata\\\"]) == (4, 5, 20)\n    assert (second[\\\"rs1_rdata\\\"], second[\\\"rs2_rdata\\\"], second[\\\"rd_wdata\\\"]) == (20, 5, 100)\n    assert first[\\\"cycle\\\"] - older[\\\"cycle\\\"] == 2\n    assert second[\\\"cycle\\\"] - first[\\\"cycle\\\"] == 2\n    assert store[\\\"cycle\\\"] - second[\\\"cycle\\\"] == 1\n'''\np.write_text(source.replace('\\\\n\\\\ndef test_pipeline_runner():',test+'\\\\n\\\\ndef test_pipeline_runner():'))\nPY\ncd \\\"\"'$BENCH_MUL_SCRATCH\"\npytest -q test/test_pipeline.py test/test_divider.py test/test_decoder.py test/test_imm_gen.py test/test_reg_file.py > build/cocotb.log 2>&1\ntail -n 4 build/cocotb.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
