{"type": "item.started", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c \"python - '/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-address.Qq49Vba2' <<'PY'\nfrom pathlib import Path\nimport shutil, sys\nscratch = Path(sys.argv[1])\nbaseline = Path('cores/bench/rtl')\ndef rtl_for(name):\n    rtl = scratch / name / 'rtl'\n    shutil.copytree(baseline, rtl, copy_function=shutil.copyfile)\n    return rtl\nrtl = rtl_for('headtags')\nf = rtl / 'if_stage.sv'\ns = f.read_text().replace('  assign out = empty ? response : fifo[read_ptr_q[1:0]];', '''  logic [2:0] next_read_ptr;\n  logic [9:0] tags_q;\n  issue_packet_t next_packet;\n  assign next_read_ptr = read_ptr_q + 3'd1;\n  assign next_packet = fifo[next_read_ptr[1:0]];\n\n  always_comb begin\n    out = empty ? response : fifo[read_ptr_q[1:0]];\n    if (\"'!empty) out.instr[24:15] = tags_q;\n  end\n\n  always_ff @(posedge clock) begin\n    if ((empty && accept_response && !issue) ||\n        (!empty && issue && next_read_ptr == write_ptr_q && accept_response))\n      tags_q <= response.instr[24:15];\n    else if (!empty && issue && next_read_ptr != write_ptr_q)\n      tags_q <= next_packet.instr[24:15];\n  end'\"''')\nf.write_text(s)\nrtl = rtl_for('fullpop')\nf = rtl / 'if_stage.sv'\ns = f.read_text().replace('response_valid && \"'!full && !reset'\"', 'response_valid && (\"'!full || issue) && !reset'\"')\nf.write_text(s)\nrtl = rtl_for('rfonehot')\nf = rtl / 'reg_file.sv'\ns = f.read_text()\nix = s.index('    assign rs1_data = rs1_nonzero')\ns = s[:ix] + \\\"\\\"\\\"    wire rs1_from_wb = rs1_nonzero && w_en && w_addr == rs1_addr;\n    wire rs2_from_wb = rs2_nonzero && w_en && w_addr == rs2_addr;\n    assign rs1_data = ({32{rs1_lo && \"'!rs1_from_wb}} & regs_lo[rs1_addr[3:0]])\n                    | ({32{rs1_hi && !rs1_from_wb}} & regs_hi[rs1_addr[3:0]])\n                    | ({32{rs1_from_wb}} & w_data);\n    assign rs2_data = ({32{rs2_lo && !rs2_from_wb}} & regs_lo[rs2_addr[3:0]])\n                    | ({32{rs2_hi && !rs2_from_wb}} & regs_hi[rs2_addr[3:0]])\n                    | ({32{rs2_from_wb}} & w_data);\n  end\nendmodule\n\"\"\"\nf.write_text(s)\nfor name, style in [('\"'linearaddr',0), ('narrowaddr',1), ('uppergroups',2)]:\n    rtl = rtl_for(name)\n    f = rtl / 'ex_stage.sv'\n    s = f.read_text()\n    start = s.index('  logic [12:0] addr_lo;')\n    end = s.index('  // ── ALU operand selection', start)\n    if style == 0:\n        a = \\\"  logic [31:0] effective_address;\\\\n  assign effective_address = rs1 + {{20{in.imm[11]}}, in.imm[11:0]};\\\\n\\\\n\\\"\n        s = s[:start]+a+s[end:]\n        s = s.replace('{addr_hi, addr_lo[11:0]}', 'effective_address').replace('addr_lo[1:0]', 'effective_address[1:0]').replace('addr_lo[0]', 'effective_address[0]')\n    elif style == 1:\n        a = \\\"\\\"\\\"  logic [12:0] addr_lo;\n  logic [19:0] addr_hi;\n  logic [19:0] signed_upper;\n\n  assign addr_lo = {1'b0, rs1[11:0]} + {1'b0, in.imm[11:0]};\n  assign signed_upper = rs1[31:12] \"'^ {20{in.imm[11]}};\n  assign addr_hi = (signed_upper + {19'\"'b0, addr_lo[12] \"'^ in.imm[11]}) ''^ {20{in.imm[11]}};\n\n\"\"\"\n        s = s[:start]+a+s[end:]\n    else:\n        a = \"\"\"  logic [12:0] addr_lo;\n  logic [19:0] addr_hi;\n  logic [19:0] signed_upper;\n  logic adjust_upper;\n\n  assign addr_lo = {1'\"'b0, rs1[11:0]} + {1'b0, in.imm[11:0]};\n  assign signed_upper = rs1[31:12] \"'^ {20{in.imm[11]}};\n  assign adjust_upper = addr_lo[12] ''^ in.imm[11];\n  for (genvar i = 0; i < 5; i++) begin : gen_upper\n    wire carry_in;\n    if (i == 0) begin : gen_base\n      assign carry_in = adjust_upper;\n    end else begin : gen_carry\n      assign carry_in = adjust_upper && (&signed_upper[4*i-1:0]);\n    end\n    assign addr_hi[4*i +: 4] = (signed_upper[4*i +: 4] + {3'\"'b0, carry_in}) \"'^ {4{in.imm[11]}};\n  end\n\n\"\"\"\n        s = s[:start]+a+s[end:]\n    f.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python - '\"'/srv/hwebench/tmp/7c172beb/94c7a7bd/r13-ad