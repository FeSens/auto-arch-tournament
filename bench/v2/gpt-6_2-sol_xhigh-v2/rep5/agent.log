{"type": "item.started", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\"\nPREDICTOR_VARIANTS=\"$trial_dir\" PYTHONDONTWRITEBYTECODE=1 python3 - <<'\"'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch=Path(os.environ['PREDICTOR_VARIANTS'])\ndst=scratch/'loop-stream'\nshutil.copytree(Path('cores/bench/rtl'), dst, copy_function=shutil.copyfile)\ncore=dst/'core.sv'\ns=core.read_text()\nkey='    .train_taken     (train_taken),'\nassert s.count(key) == 1\ns=s.replace(key, key+'''\n    .train_pc_word   (id_ex_w.pc[31:2]),\n    .train_target    (id_ex_w.direct_target),''')\ncore.write_text(s)\nf=dst/'if_stage.sv'\ns=f.read_text()\nkey='  input  logic              train_taken,'\ns=s.replace(key,key+'''\n  input  logic [31:2]       train_pc_word,\n  input  logic [31:0]       train_target,''')\nkey='  logic aperture_wait_q, hold_last_word, resume_fetch;'\ns=s.replace(key,key+'''\n  logic response_taken;\n  logic [31:2] response_target;\n  logic loop_probe_valid_q, loop_active_q;\n  logic [31:2] loop_probe_start_q, loop_probe_end_q;\n  logic [31:2] loop_start_q, loop_end_q;\n  logic [15:0] loop_valid_q;\n  logic loop_in_range, loop_replace, loop_capture, replay, replay_taken;\n  logic [31:2] loop_probe_span;\n  logic [5:0] replay_index;\n  logic replay_conditional, replay_jump;\n\n  assign loop_probe_span = loop_probe_end_q - loop_probe_start_q;\n  assign loop_replace = loop_probe_valid_q && loop_probe_start_q < loop_probe_end_q\n                     && loop_probe_end_q[31:20] == 12'b0 && loop_probe_span < 30'd16\n                     && (\"'!loop_active_q || loop_probe_start_q != loop_start_q\n                                        || loop_probe_end_q != loop_end_q);\n  assign loop_in_range = loop_active_q && pc_word >= loop_start_q && pc_word <= loop_end_q;\n  assign replay = loop_in_range && loop_valid_q[pc_word[5:2]] && !imem_ready;\n  assign loop_capture = accept_response && imem_ready && loop_in_range;\n\n  always_ff @(posedge clock) begin\n    loop_probe_valid_q <= !reset && train_branch && train_taken && !train_target[1];\n    loop_probe_start_q <= train_target[31:2];\n    loop_probe_end_q   <= train_pc_word;\n    if (reset) begin\n      loop_active_q <= 1'\"'b0;\n      loop_valid_q  <= '0;\n    end else if (loop_replace) begin\n      loop_active_q <= 1'b1;\n      loop_start_q  <= loop_probe_start_q;\n      loop_end_q    <= loop_probe_end_q;\n      loop_valid_q  <= '0;\n    end else if (loop_capture) begin\n      loop_valid_q[pc_word[5:2]] <= 1'b1;\n    end\n  end''')\ns=s.replace('pc_word == LAST_IMEM_WORD && \"'!predicted_taken'\"','pc_word == LAST_IMEM_WORD && \"'!response_taken'\"')\ns=s.replace('predicted_taken && \"'!aperture_wait_q ? direct_word : pc_word'\"', 'response_taken && \"'!aperture_wait_q ? response_target : pc_word'\"')\ns=s.replace('  issue_packet_t response;', '''  issue_packet_t response, bus_response, loop_response;\n  logic [\"'$bits(bus_response)-1:0] loop_ram [0:15];\n\n  always_ff @(posedge clock) begin\n    if (loop_capture)\n      loop_ram[pc_word[5:2]] <= bus_response;\n  end\n\n  assign loop_response = loop_ram[pc_word[5:2]];\n  assign replay_conditional = loop_response.ctrl.is_branch;\n  assign replay_jump = loop_response.ctrl.is_jump && !loop_response.ctrl.is_jalr;\n  assign replay_taken = !loop_response.direct_target[1] && loop_response.direct_target[31:20] == 12'\"'b0\n                     && (replay_jump || (replay_conditional && counter_taken));\n  assign response_taken = imem_ready ? predicted_taken : replay_taken;\n  assign response_target = imem_ready ? direct_word : loop_response.direct_target[31:2];\n\n  always_comb begin\n    response = imem_ready ? bus_response : loop_response;\n    response.predicted_taken = response_taken;\n    response.prediction_index = prediction_index;\n    response.holds_fetch = hold_last_word;\n  end''')\nstart=s.index('  assign imem_addr')\nend=s.index('  // The low bits address',start)\nbus=s[start:end].replace('response.', 'bus_response.')\ns=s[:start]+bus+s[end:]\ns=s.replace('assign response_valid = imem_ready &&', 'assign response_valid = (imem_ready || replay) &&')\ns=s.replace('  logic [5:0] replay_index;\\\\n','')\nf.write_text(s)\nPY\nNRET=1 RTL_DIR=\\\"\"'$trial_dir/loop-stream\" OBJ_DIR=\"$trial_dir/cosim-loop\" bash test/cosim/build.sh > \"$trial_dir/cosim-loop.log\" 2>&1\n\"$trial_dir/cosim-loop/cosim_sim\" \"$trial_dir/benchmark/bench/programs/coremark.elf\" 50000000 --bench --istall --dstall'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
