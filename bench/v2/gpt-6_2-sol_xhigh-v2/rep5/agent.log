{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-predictor.35FE9v\"\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nroot = Path(sys.argv[1])\nfor name in ('qfloat-spec2', 'valid2', 'valid-spec2', 'onehot2', 'onehot-spec2'):\n    old = root/'rtl-qfloat2'\n    new = root/f'rtl-{name}'\n    shutil.copytree(old, new)\n    p = new/'if_stage.sv'\n    s = p.read_text()\n    if name.startswith(('valid', 'onehot')):\n        lo = s.index('  localparam integer DEPTH')\n        hi = s.index(\\\"    if (reset) pc_word\\\",lo)\n        s = s[:lo] + \\\"\\\"\\\"  if_id_t entry0_q, entry1_q;\n  if_id_t fresh_in;\n  logic buffered_q, full_q, head_q;\n  logic has_space, pop, fetch, push, tail;\n\n  assign pop = buffered_q && \"'!stall;\n  assign has_space = !full_q || pop;\n  assign fetch = has_space && imem_ready\n               && (pc_word != 30'\"'h3ffff || (\"'!buffered_q && !stall));\n  assign push = fetch && (buffered_q || stall);\n  assign tail = head_q ''^ (buffered_q && !full_q);\n  assign out = buffered_q ? (head_q ? entry1_q : entry0_q) : fresh_in;\n\n  always_ff @(posedge clock) begin\n    if (push && !tail) entry0_q <= fresh_in;\n    if (push && tail)  entry1_q <= fresh_in;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      buffered_q <= 1'\"'b0;\n      full_q <= 1'b0;\n      head_q <= 1'b0;\n    end else begin\n      buffered_q <= (buffered_q && \"'!pop) || full_q || push;\n      full_q <= (full_q && !pop) || (push && buffered_q && (!pop || full_q));\n      if (pop) head_q <= !head_q;\n    end\n\n\"\"\" + s[hi:]\n    if name.startswith('\"'onehot'):\n        s = s.replace('  assign out = buffered_q ? (head_q ? entry1_q : entry0_q) : fresh_in;', '''  localparam int PACKET_WIDTH = \"'$bits(fresh_in);\n  assign out = ({PACKET_WIDTH{!buffered_q}} & fresh_in)\n             | ({PACKET_WIDTH{buffered_q && !head_q}} & entry0_q)\n             | ({PACKET_WIDTH{buffered_q && head_q}} & entry1_q);'\"''')\n    if 'spec' in name:\n        s = s.replace('logic [1:0]  history_q;', 'logic [1:0]  history_q, speculative_history_q;')\n        s = s.replace('\"'^ {4'\"\\\\'b0, history_q};', \\\"\"'^ {4'\"'b0, speculative_history_q};\\\")\n        s = s.replace(\\\"    if (reset) pc_word <= '0;\\\", \\\"\\\"\\\"    if (reset) speculative_history_q <= '0;\n    else if (redirect) speculative_history_q <= train_branch\n                                                 ? {history_q[0], train_taken}\n                                                 : history_q;\n    else if (fetch && is_branch) speculative_history_q <= {speculative_history_q[0], predicted_taken};\n\n    if (reset) pc_word <= '0;\\\"\\\"\\\")\n        ex = new/'ex_stage.sv'\n        ex.write_text(ex.read_text().replace('assign train_taken    = branch_cond;', 'assign train_taken    = resolved_taken;'))\n    p.write_text(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python3 - \\\"\"'$scratch\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json, sys\nfrom tools.eval.gowin import build, summarize\nroot=Path(sys.argv[1])\nvariants=('valid2', 'valid-spec2', 'qfloat-spec2', 'onehot2', 'onehot-spec2')\nwith ThreadPoolExecutor(max_workers=8) as pool:\n    jobs = {(name,opt):pool.submit(build, Path.cwd(), root/f'rtl-{name}', 'fpga/core_bench_si.sv',\n            opt, root/f'pnr-final-{name}'/f'option-{opt}') for opt in range(3) for name in variants}\n    for name in variants:\n        results=[jobs[name,opt].result() for opt in range(3)]\n        print(name,json.dumps(summarize(results)),flush=True)\n        (root/f'{name}-timing-final.json').write_text(json.dumps(results))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
