{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport os, shutil\nfrom pathlib import Path\nscratch=Path(os.environ['TMPDIR'])/'fetch-target-study'\nvariants={\n  'compare_4': (4, 'parallel', 'xor'),\n  'compare_8_pair': (8,'tree','xor'),\n  'compare_8_sign': (8,'parallel','xor'),\n  'compare_11': (11,'parallel','flip'),\n  'compare_16': (16,'parallel','flip'),\n  'compare_full': (32,'parallel','xor'),\n  'compare_8_miss': (8,'parallel','miss'),\n}\nfor variant, (width, style, mode) in variants.items():\n    dest=scratch/variant\n    shutil.copytree(scratch/'baseline/cores/bench', dest/'cores/bench', ignore=shutil.ignore_patterns('generated','obj_dir'))\n    for name in ('bench','tools','test','Makefile','fpga'):\n        (dest/name).symlink_to(scratch/name,target_is_directory=name\"'!='\"'Makefile')\n    path=dest/'cores/bench/rtl/ex_stage.sv'\n    rtl=path.read_text()\n    a=rtl.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n    b=rtl.index('  assign jalr_sum',a)\n    spans=[(lsb,min(lsb+width-1,31)) for lsb in range(0,32,width)]\n    groups=len(spans)\n    replacement=f'  logic [{groups-1}:0] equal_group, less_group;\\\\n  logic less_than, signed_compare;\\\\n'\n    replacement+='  assign signed_compare = \"'!in.ctrl.branch_op[1];'\"\\\\n'\n    for index, (lo,hi) in enumerate(spans):\n        for kind, symbol in (('equal_group','=='), ('less_group','<')):\n            lhs,rhs=f'rs1[{hi}:{lo}]',f'rs2[{hi}:{lo}]'\n            if mode in ('flip','miss') and hi==31 and symbol=='<':\n                lhs='{rs1[31] \"'^ signed_compare, rs1[30:'\"'+str(lo)+']}'\n                rhs='{rs2[31] \"'^ signed_compare, rs2[30:'\"'+str(lo)+']}'\n            replacement+=f'  assign {kind}[{index}] = {lhs} {symbol} {rhs};\\\\n'\n    if style=='tree':\n        unsigned='(&equal_group[3:2]) ? (equal_group[1] ? less_group[0] : less_group[1])\\\\n                                         : (equal_group[3] ? less_group[2] : less_group[3])'\n    else:\n        msb=groups-1\n        unsigned=f'less_group[{msb}]'\n        for ix in reversed(range(msb)):\n            unsigned+=f'\\\\n                   || ((&equal_group[{msb}:{ix+1}]) && less_group[{ix}])'\n    if mode=='xor':\n        replacement+='  logic unsigned_less;\\\\n  assign unsigned_less = '+unsigned+';\\\\n'\n        replacement+='  assign less_than = unsigned_less \"'^ (signed_compare && (rs1[31] ''^ rs2[31]));'\"\\\\n'\n    else:\n        replacement+='  assign less_than = '+unsigned+';\\\\n'\n    replacement+='  assign branch_cond = (in.ctrl.branch_op[2] ? less_than : &equal_group) \"'^ in.ctrl.branch_op[0];'\"\\\\n\\\\n'\n    rtl=rtl[:a]+replacement+rtl[b:]\n    if mode=='miss':\n        rtl=rtl.replace('  assign redirect       = advance && (resolved_taken \"'!= in.predicted_taken);'\"', '''  logic direct_taken_miss, direct_linear_miss, jalr_miss;\n  assign direct_taken_miss = \"'!in.predicted_taken && !in.direct_target[1] &&\n                             (in.ctrl.is_branch || (in.ctrl.is_jump && !in.ctrl.is_jalr));\n  assign direct_linear_miss = in.predicted_taken && in.ctrl.is_branch;\n  assign jalr_miss = in.ctrl.is_jalr && !jalr_sum[1];\n  assign redirect = advance &&\n                    ((direct_taken_miss && (branch_cond || in.ctrl.is_jump)) ||\n                     (direct_linear_miss && !branch_cond) || jalr_miss);'\"''')\n    path.write_text(rtl)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
