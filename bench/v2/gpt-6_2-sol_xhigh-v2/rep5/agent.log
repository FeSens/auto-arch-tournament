from the other ALU results for the fused issue selection while retaining the standalone ALU interface behavior.\\\"\n  - file: rtl/ex_stage.sv\n    description: \\\"Export fast result lanes and consume the captured operands with only the registered MEM/WB bypass. Preserve writeback and late completion routing.\\\"\n  - file: rtl/core.sv\n    description: \\\"Feed fast values back to the issue snapshots and preserve stage hold, producer qualification, recovery and RVFI wiring.\\\"\nYAML\nsed -i 's/\"'^+$//'\"' cores/bench/experiments/hypotheses/hyp-20261122-002-r14s1.yaml\nPYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport json\nfrom pathlib import Path\nimport jsonschema\nimport yaml\np=Path('cores/bench/experiments/hypotheses/hyp-20261122-002-r14s1.yaml')\ndata=yaml.safe_load(p.read_text())\njsonschema.Draft7Validator(json.loads(Path('schemas/hypothesis.schema.json').read_text())).validate(data)\nassert data['id']==p.stem and data['category']=='structural'\nassert type(data['expected_impact']['fitness_delta_pct']) is int\nassert all((Path('cores/bench') / c['file']).is_file() for c in data['changes'])\nprint(f'Validated {p}')\nPY\"", "aggregated_output": "sed: preserving permissions for ‘cores/bench/experiments/hypotheses/sedIQoNqI’: Invalid argument\nValidated cores/bench/experiments/hypotheses/hyp-20261122-002-r14s1.yaml\n", "exit_code": 0, "status": "completed"}}
