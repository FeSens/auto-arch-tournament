{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r15-profile/make_predecode.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, sys\nrtl=Path(os.environ['TMPDIR'])/'r15-profile'/(sys.argv[1]+'_rtl')\ndef edit(file,changes):\n    p=rtl/file\n    data=p.read_text()\n    for old,new in changes:\n        assert data.count(old)==1,old\n        data=data.replace(old,new)\n    p.write_text(data)\nedit('core_pkg.sv',[\n    ('    logic        late_eligible;\\\\n  } issue_packet_t;',\n     '    logic        late_eligible;\\\\n    alu_select_t alu_select;\\\\n  } issue_packet_t;'),\n])\nedit('if_stage.sv',[\n    ('  imm_gen u_imm (.instr(imem_data), .imm(response.imm));',\n     '''  assign response.alu_select = (response.ctrl.is_auipc || response.ctrl.is_jump)\n      ? '0 : decode_alu(response.ctrl.alu_op);\n  imm_gen u_imm (.instr(imem_data), .imm(response.imm));'''),\n])\nedit('id_stage.sv',[\n    ('''      reg_q.alu_select       <= (in.ctrl.is_auipc || in.ctrl.is_jump) ? '0\n                                                                     : decode_alu(in.ctrl.alu_op);''',\n     '      reg_q.alu_select       <= in.alu_select;'),\n])\nPY\nfor r15_variant in predecode head_predecode; do\n  mkdir -p \\\"\"'$TMPDIR/r15-profile/${r15_variant}_rtl\"\n  cp cores/bench/rtl/*.sv \"$TMPDIR/r15-profile/${r15_variant}_rtl/\"\n  if [ \"$r15_variant\" = head_predecode ]; then\n    cp \"$TMPDIR/r15-profile/head_rtl/if_stage.sv\" \"$TMPDIR/r15-profile/${r15_variant}_rtl/\"\n  fi\n  python3 \"$TMPDIR/r15-profile/make_predecode.py\" \"$r15_variant\" || exit\ndone\npython3 - \"$TMPDIR/r15-profile\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nimport sys\nroot=Path(sys.argv[1])\ndef run(variant):\n    r=build_all(Path.cwd(),root/f'{variant}_rtl','fpga/core_bench_si.sv',root/f'{variant}_timing')\n    print(variant, summarize(r), flush