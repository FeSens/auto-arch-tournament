{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/alu_sweep.py\" <<'\"'PY'\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nimport shutil\nfrom sweep import run, scratch, source\n\ntext = (source / 'alu.sv').read_text()\n\ndef insert(widths, style, sub):\n    lines = []\n    for op, operator, propagate in [('add', '+', '\"'^'\"'), ('sub', '-', '~\"'^'\"')][:1+sub]:\n        lines.append(f'  logic [31:0] {op}_result;')\n        start = 0\n        for i, width in enumerate(widths):\n            end = start + width - 1\n            a = f'a[{end}:{start}]'\n            b = f'b[{end}:{start}]'\n            lines.append(f'  logic [{width}:0] {op}_part_{i};')\n            lines.append(f\\\"  assign {op}_part_{i} = {{1'b0, {a}}} {operator} {{1'b0, {b}}};\\\")\n            if i < len(widths) - 1:\n                lines.append(f'  logic {op}_gen_{i};')\n                lines.append(f'  assign {op}_gen_{i} = {op}_part_{i}[{width}];')\n            if i:\n                if i < len(widths) - 1:\n                    part_prop = f'&({a} {propagate} {b})'\n                    lines.append(f'  logic {op}_prop_{i};')\n                    lines.append(f'  assign {op}_prop_{i} = {part_prop};')\n                terms = ['(' + ' && '.join([f'{op}_gen_{j}', *[f'{op}_prop_{k}' for k in range(j + 1, i)]]) + ')'\n                         for j in range(i - 1, -1, -1)]\n                lines.append(f'  logic {op}_carry_{i};')\n                lines.append(f\\\"  assign {op}_carry_{i} = {' || '.join(terms)};\\\")\n            if i and style == 'mux':\n                lines.append(f'  logic [{width - 1}:0] {op}_adj_{i};')\n                lines.append(f\\\"  assign {op}_adj_{i} = {a} {operator} {b} {operator} {width}'d1;\\\")\n                lines.append(f'  assign {op}_result[{end}:{start}] = {op}_carry_{i} ? {op}_adj_{i} : {op}_part_{i}[{width - 1}:0];')\n            elif i:\n                for bit in range(width):\n                    cin = f'{op}_carry_{i}'\n                    if bit:\n                        prefix = f'&(a[{start + bit - 1}:{start}] {propagate} b[{start + bit - 1}:{start}])'\n                        cin = f'({cin} && {prefix})'\n                    lines.append(f'  assign {op}_result[{start + bit}] = {op}_part_{i}[{bit}] \"'^ {cin};'\"')\n            else:\n                lines.append(f'  assign {op}_result[{end}:{start}] = {op}_part_{i}[{width - 1}:0];')\n            start += width\n    patched = text.replace('  assign out =', '\\\\n'.join(lines) + '\\\\n\\\\n  assign out =')\n    patched = patched.replace('(a + b)', 'add_result')\n    if sub:\n        patched = patched.replace('(a - b)', 'sub_result')\n    return patched\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('variants', nargs='+')\n    parser.add_argument('--options', type=int, nargs='+', default=[1])\n    args = parser.parse_args()\n    for name in args.variants:\n        widths, style, sub = name.split('_')\n        widths = tuple(map(int, widths.split('-')))\n        variant = scratch / name / 'rtl'\n        shutil.copytree(source, variant, dirs_exist_ok=True)\n        (variant / 'alu.sv').write_text(insert(widths, style, sub == 'both'))\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(run, [(name, option) for name in args.variants for option in args.options]))\n\nif __name__ == '__main__':\n    main()\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR/r11s0.AT6WVG/alu_sweep.py\" 8-8-8-8_mux_add 8-8-8-8_mux_both 8-8-8-8_prefix_add 12-10-10_mux_add'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
