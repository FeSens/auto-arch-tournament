{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"cat formal/wrapper_si.sv; sed -n '1,140p' formal/checks_si.cfg; rg -n '\"'^def |''^async def '\"' cores/bench/test/test_pipeline.py\"", "aggregated_output": "// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[4483 of 7555 chars elided by tools/bench/transcript.py; sha256:95fced736f8928a0]…\n03:async def branch_taken_skips(dut):\n429:async def jal_writes_pc_plus_4(dut):\n448:async def jal_at_fetch_aperture_boundary(dut):\n462:async def last_sequential_prediction_holds_request(dut, older_redirect):\n512:async def gshare_alias_and_direction_reversals(dut):\n554:async def buffered_branch_trains_at_fetch_index(dut):\n585:async def misaligned_direct_targets_and_reserved_branches(dut):\n610:async def branch_recovery_waits_for_dmem(dut):\n653:async def jalr_target(dut):\n673:async def sw_lw_roundtrip(dut):\n696:async def signed_load_store_address_and_byte_lane(dut, address_case):\n729:async def illegal_traps(dut):\n752:async def ecall_traps(dut):\n764:async def ebreak_does_not_trap(dut):\n773:async def rvfi_order_strictly_monotonic(dut):\n788:async def divide_waits_for_stalled_store(dut):\n827:async def divide_after_load_use_and_transfer(dut, predict_jal, wrong_path):\n857:async def multiply_throughput_and_encoded_dependencies(dut):\n891:async def multiply_before_and_after_dmem_hold(dut):\n921:def test_pipeline_runner():\n", "exit_code": 0, "status": "completed"}}
