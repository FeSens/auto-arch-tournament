{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,250p' tools/eval/gowin.py && sed -n '1,165p' fpga/core_bench_si.sv\"", "aggregated_output": "\"\"\"Vendor place-and-route and timing for the FPGA fitness (HWE Bench V2).\n\nV2 times designs with Gowin EDA (the FPGA vendor's own synthesis, place and\nroute and static timing analysis) instead of Yosys + nextpnr, whose timing\nmodel for this part misses whole classes of paths. The vendor flow is also\ndeterministic and insensitive to circuit-neutral netlist changes.\n\nFmax is the median over Gowin's placement algorithms (PLACE_OPTIONS), each\na full build of the same RTL; results are deterministic for a given input.\n\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nimport re\nimport shutil\nimport statistics\nfrom pathlib import Path\n\nfrom tools.eval._subprocess import remove_path\n\nGOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\nGOWIN_VERSION = \"1.9.11.03 Education\"\nPART = \"GW2AR-LV18QN88C8/I7\"      # Tang Nano 20K\nDEVICE_VERSION = \"C\"\nPLACE_OPTIONS = (0, 1, 2)\nCST = \"fpga/constraints/Tang_Nano_20K.cst\"\nSDC = \"fpga/constraints/clock.sdc\"\nSTALL_GEN = \"fpga/bench_stall_gen.sv\"\nBUILD_TIMEOUT_SEC = 2700\n\n\ndef gowin_env(base: dict | None, workdir: Path) -> dict:\n    env = dict(os.environ if base is None else base)\n    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n    env[\"LD_LIBRARY_PATH\"] = \":\".join(map(str, libs))\n    env[\"QT_QPA_PLATFORM\"] = \"offscreen\"\n    xdg = workdir / \".xdg\"\n    xdg.mkdir(parents=True, exist_ok=True)\n    os.chmod(xdg, 0o700)\n    env[\"XDG_RUNTIME_DIR\"] = str(xdg)\n    return env\n\n\ndef rtl_sources(rtl_dir: Path) -> list[Path]:\n    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[11230 of 14302 chars elided by tools/bench/transcript.py; sha256:9ef9f7ad5d50191a]…\nde_0     (rvfi_mode_0),\n    .io_rvfi_ixl_0      (rvfi_ixl_0),\n    .io_rvfi_rs1_addr_0 (rvfi_rs1_addr_0),\n    .io_rvfi_rs1_rdata_0(rvfi_rs1_rdata_0),\n    .io_rvfi_rs2_addr_0 (rvfi_rs2_addr_0),\n    .io_rvfi_rs2_rdata_0(rvfi_rs2_rdata_0),\n    .io_rvfi_rd_addr_0  (rvfi_rd_addr_0),\n    .io_rvfi_rd_wdata_0 (rvfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // V2: observe only the memory-side outputs. Everything the core computes\n  // reaches the fetch address or a store, so the datapath stays in the\n  // netlist; logic that only drives RVFI (a verification port a deployed\n  // core would not have) is pruned and does not count toward Fmax or area.\n  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"cat > \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/analyze.py\\\" <<'PY'\nfrom collections import Counter, defaultdict\nimport json\nfrom pathlib import Path\nfrom struct import iter_unpack\nimport sys\n\nroot = Path(sys.argv[1])\ninfo = json.loads((root / 'baseline.jsonl').read_text().splitlines()[-1])\nstart, stop = (info[k] for k in ('bench_start_cycle', 'bench_stop_cycle'))\nassert info['ebreak'] and not info['oob']\nbranches = []\npcs = Counter()\nredirects = Counter()\nedge_profiles = defaultdict(Counter)\nfor cyc, pc, insn, npc in iter_unpack('<IIII', (root / 'retire.bin').read_bytes()):\n    opcode = insn & 127\n    window = start <= cyc < stop\n    taken = npc \"'!= pc + 4\n    if window:\n        pcs[pc] += 1\n    if opcode not in (0x63, 0x6f, 0x67):\n        continue\n    offset = ((insn >> 19) & 0x1000) | ((insn << 4) & 0x800) | ((insn >> 20) & 0x7e0) | ((insn >> 7) & 0x1e)\n    if offset >= 4096:\n        offset -= 8192\n    target = pc + offset if opcode == 0x63 else npc\n    branches.append((window, pc, opcode, npc, taken, target))\n    if window:\n        redirects[opcode] += taken\n        edge_profiles[pc][npc] += 1\n\nprint('\"'cycles', stop-start, 'retired', sum(pcs.values()), 'unique PCs', len(pcs),\n      'controls', sum(t[0] for t in branches), 'unique controls', len(edge_profiles),\n      'taken by opcode', {hex(k):v for k,v in redirects.items()})\nprint('oracle cycles reduction', sum(redirects.values()) / (stop-start))\nfor size in (8, 16, 32, 64, 128, 256, 512, 1024):\n    for fold in (False, True):\n        if fold and size > 128:\n            continue\n        for ways in (1, 2):\n            nsets = size // ways\n            shift = nsets.bit_length() - 1\n            table = [{} for _ in range(nsets)]\n            missed = Counter()\n            hits = Counter()\n            for window, pc, opcode, npc, taken, target in branches:\n                word = pc >> 2\n                index = (word \"'^ ((word >> shift) if fold else 0)) & (nsets - 1)\n                entries = table[index]\n                counter, old_target = entries.get(pc, (1 if taken else 2, pc+4))\n                if window:\n                    hits[opcode] += pc in entries\n                    missed[opcode] += (old_target if counter >= 2 else pc + 4) != npc\n                if pc in entries:\n                    del entries[pc]\n                elif len(entries) == ways:\n                    del entries[next(iter(entries))]\n                counter = max(0, min(3, counter + (1 if taken else -1))) if opcode == 0x63 else 3\n                entries[pc] = counter, target\n            gain = (sum(redirects.values())-sum(missed.values()))/(stop-start)\n            print(f'\"'{size:4} {ways} way {str(fold):5} {gain:8.3%}', [missed[op] for op in (0x63, 0x6f, 0x67)])\nPY\npython3 \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/analyze.py\\\" \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne\\\"\"", "aggregated_output": "cycles 4491485 retired 2922016 unique PCs 1670 controls 592690 unique controls 237 taken by opcode {'0x67': 13735, '0x6f': 49367, '0x63': 294425}\noracle cycles reduction 0.0796010673530024\n   8 1 way False   5.115% [81938, 33467, 12391]\n   8 2 way False   5.022% [84917, 35879, 11152]\n   8 1 way True    5.067% [93739, 25881, 10334]\n   8 2 way True    5.149% [82435, 31179, 12655]\n  16 1 way False   5.743% [65719, 21974, 11892]\n  16 2 way False   5.642% [71981, 24572, 7574]\n  16 1 way True    5.457% [78647, 28560, 5231]\n  16 2 way True    6.018% [63753, 16866, 6591]\n  32 1 way False   6.321% [55992, 15638, 1989]\n  32 2 way False   6.266% [57240, 12388, 6467]\n  32 1 way True    6.174% [57447, 15424, 7365]\n  32 2 way True    6.378% [58596, 9146, 3327]\n  64 1 way False   6.567% [52439, 8363, 1749]\n  64 2 way False   6.778% [42678, 8565, 1847]\n  64 1 way True    6.656% [46963, 7707, 3914]\n  64 2 way True    6.743% [44250, 7916, 2486]\n 128 1 way False   6.665% [51525, 4974, 1668]\n 128 2 way False   6.905% [40847, 4872, 1677]\n 128 1 way True    6.912% [44508, 958, 1612]\n 128 2 way True    7.001% [40643, 833, 1593]\n 256 1 way False   6.901% [45430, 515, 1624]\n 256 2 way False   7.021% [40240, 340, 1584]\n 512 1 way False   7.036% [39721, 168, 1605]\n 512 2 way False   7.040% [39649, 110, 1575]\n1024 1 way False   7.039% [39640, 142, 1605]\n1024 2 way False   7.043% [39533, 65, 1575]\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"cat > \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/directions.py\\\" <<'PY'\nexec(open(sys.argv[1] + '/analyze.py').read().split('print(\\\\'cycles\\\\'')[0] if False else open(sys.argv[1] + '/analyze.py').read().split('print(\\\\'cycles\\\\'')[0])\nbase_redirects = sum(redirects.values())\nfor mode in ('always taken', 'backwards taken', 'always not taken'):\n    wrong = 0\n    for window, pc, op, npc, taken, target in branches:\n        if window:\n            if op == 0x63:\n                guess = mode == 'always taken' or (mode == 'backwards taken' and target < pc)\n                wrong += (target if guess else pc+4) \"'!= npc\n            elif op == 0x67:\n                wrong += taken\n    print(mode, wrong, (base_redirects-wrong)/(stop-start))\nfor size in (16,32,64,128,256,512,1024):\n    for history_bits in (0,2,3,4,5,6,7):\n        if 2**history_bits > size:\n            continue\n        wrong = 0\n        table = [1] * size\n        history = 0\n        for window, pc, op, npc, taken, target in branches:\n            if op == 0x63:\n                idx = ((pc>>2) ''^ history) & (size-1)\n                guess = table[idx] >= 2\n                table[idx] = max(0, min(3, table[idx] + (1 if taken else -1)))\n                history = ((history<<1) + taken) & ((1<<history_bits)-1)\n                wrong += window and (target if guess else pc+4) != npc\n            elif op == 0x67:\n                wrong += window and taken\n        print(size, history_bits, wrong, (base_redirects-wrong)/(stop-start))\nPY\npython3 -c '\"'import sys; exec(open(sys.argv[1]+\\\"/directions.py\\\").read())' \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
