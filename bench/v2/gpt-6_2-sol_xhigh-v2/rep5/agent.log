{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - '/srv/hwebench/tmp/7c172beb/f09e6679/hyp-20261122-001-r1s0-profile.bfbncU' <<'PY'\nimport collections\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\n\nscratch = Path(sys.argv[1])\nargv = [str(scratch / 'obj_dir' / 'sim'), str(scratch / 'coremark.elf'),\n        '30000000', '--istall', '--dstall']\nstart_address = b'\\\"mem_addr\\\":268435712,'\nstop_address = b'\\\"mem_addr\\\":268435716,'\ninsn_re = re.compile(rb'\\\"insn\\\":(\\\\d+),')\ndivide_ops = dict(enumerate(('DIV', 'DIVU', 'REM', 'REMU'), 4))\ncounts = collections.Counter({name: 0 for name in divide_ops.values()})\nstart = stop = None\nretired = 0\nlast = None\nwith subprocess.Popen(argv, stdout=subprocess.PIPE) as sim:\n    for line in sim.stdout:\n        if start_address in line and b'\\\"mem_wmask\\\":0,' not in line:\n            start = json.loads(line)['cycle']\n        elif stop_address in line and b'\\\"mem_wmask\\\":0,' not in line:\n            stop = json.loads(line)['cycle']\n        elif start is not None and stop is None:\n            insn = int(insn_re.search(line).group(1))\n            retired += 1\n            if insn & 0xfe00007f == 0x02000033:\n                funct3 = (insn >> 12) & 7\n                if funct3 in divide_ops:\n                    counts[divide_ops[funct3]] += 1\n        last = line\n    assert sim.wait() == 0\nassert start is not None and stop is not None and stop > start\nassert json.loads(last)['insn'] == 0x00100073\nprint(json.dumps(dict(start=start, stop=stop, cycles=stop-start, retired=retired,\n                      divrem_counts=counts)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
