{"type": "item.started", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/div_variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\noriginal = (base / 'divider.sv').read_text()\n\nfor variant, split_quotient, gate_work in [\n    ('div_split', True, False),\n    ('div_split_gate', True, True),\n]:\n    p = scratch / variant\n    shutil.copytree(base, p)\n    s = original.replace('  logic [31:0] divisor_q, remainder_q, quotient_q;', '''  logic [31:0] divisor_q;\n  logic [31:0] wide_remainder_q, wide_quotient_q, narrow_quotient_q;\n  logic [10:0] narrow_remainder_q;''')\n    s = s.replace('{remainder_q[10:0], quotient_q[31:28]}', '{narrow_remainder_q, narrow_quotient_q[31:28]}')\n    s = s.replace('{remainder_q[28:0], quotient_q[31:29]}', '{wide_remainder_q[28:0], wide_quotient_q[31:29]}')\n    s = s.replace(\\\"      remainder_q       <= '0;\\\\n      quotient_q        <= '0;\\\", \\\"\\\"\\\"      narrow_remainder_q <= '0;\n      narrow_quotient_q  <= '0;\n      wide_remainder_q   <= '0;\n      wide_quotient_q    <= '0;\\\"\\\"\\\")\n    left = s.index('      if (narrow_divisor) begin\\\\n        remainder_q')\n    right = s.index('  end\\\\n\\\\n  // MEM selects', left)\n    update = \\\"\\\"\\\"      narrow_remainder_q <= {7'b0, nibble_divisor ? prefix_remainder : a_magnitude[31:28]};\n      narrow_quotient_q  <= {a_magnitude[27:0], nibble_divisor ? prefix_quotient : 4'b0};\n      wide_remainder_q   <= {21'b0, a_magnitude[31:21]};\n      wide_quotient_q    <= {a_magnitude[20:0], {11{divisor_zero}}};\n    end else if (counting_down) begin\n\\\"\\\"\\\"\n    cap_narrow = \\\"\\\"\\\"      narrow_remainder_q <= narrow_remainder;\n      narrow_quotient_q  <= {narrow_quotient_q[27:0], narrow_digit};\n\\\"\\\"\\\"\n    cap_wide = \\\"\\\"\\\"      wide_remainder_q  <= wide_remainder;\n      wide_quotient_q   <= {wide_quotient_q[28:0], wide_digit};\n\\\"\\\"\\\"\n    if gate_work:\n        update += '      if (narrow_q) begin\\\\n' + cap_narrow + '      end else begin\\\\n' + cap_wide + '      end\\\\n'\n    else:\n        update += cap_narrow + cap_wide\n    update += '    end\\\\n'\n    s = s[:left] + update + s[right:]\n    s = s.replace('  assign magnitude = want_remainder_q ? remainder_q : quotient_q;',\n                  \\\"\\\"\\\"  assign magnitude = ({32{want_remainder_q && narrow_q}} & {21'b0, narrow_remainder_q})\n                   | ({32{want_remainder_q && \"'!narrow_q}} & wide_remainder_q)\n                   | ({32{!want_remainder_q && narrow_q}} & narrow_quotient_q)\n                   | ({32{!want_remainder_q && !narrow_q}} & wide_quotient_q);\"\"\")\n    (p/'\"'divider.sv').write_text(s)\n\nfor variant, prefix_type in [('div_wide_cmp', 'split'), ('div_narrow_cmp', 'narrow')]:\n    p = scratch / variant\n    shutil.copytree(base, p)\n    s = original\n    if prefix_type == 'split':\n        s = s.replace('    assign borrow[digit] = difference[32] || |multiples[digit][34:32];', '''    logic [31:0] multiple;\n    assign multiple = multiples[digit][31:0];\n    assign borrow[digit] = (partial_dividend[31:16] < multiple[31:16])\n                         || (partial_dividend[31:16] == multiple[31:16] &&\n                             partial_dividend[15:0] < multiple[15:0])\n                         || |multiples[digit][34:32];''')\n    else:\n        s = s.replace('    assign narrow_borrow[digit] = difference[15];', '''    logic [14:0] multiple;\n    assign multiple = narrow_multiples[digit];\n    assign narrow_borrow[digit] = (narrow_dividend[14:8] < multiple[14:8])\n                                || (narrow_dividend[14:8] == multiple[14:8] &&\n                                    narrow_dividend[7:0] < multiple[7:0]);''')\n    (p/'divider.sv').write_text(s)\nPY\npython /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/div_variants.py\npython -u /srv/hw