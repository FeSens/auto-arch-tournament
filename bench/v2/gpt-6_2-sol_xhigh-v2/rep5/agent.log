{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\"\nPREDICTOR_VARIANTS=\"$trial_dir\" PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\noriginal = root/'cores/bench/rtl'\nscratch = Path(os.environ['PREDICTOR_VARIANTS'])\nvariants = {\n    'folded-original': original,\n    'folded-parallel': scratch/'parallel',\n    'folded-compact': scratch/'two-pc-compact',\n    'folded-compare': scratch/'carry9select',\n}\nfor name, source in variants.items():\n    directory = scratch/name\n    shutil.copytree(source, directory, copy_function=shutil.copyfile)\n    path = directory/'if_stage.sv'\n    src = path.read_text().replace('pc_word[7:2] \"'^ {4'\"\\\\'b0, history_q}', 'pc_word[7:2] \"'^ pc_word[13:8]'\"')\n    src = '\\\\n'.join(line for line in src.split('\\\\n') if 'history_q' not in line)\n    path.write_text(src)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:\n    builds = {pool.submit(build, root, scratch/name, 'fpga/core_bench_si.sv', 1, scratch/f'{name}-1'): name for name in variants}\n    for future in concurrent.futures.as_completed(builds):\n        result = future.result()\n        print(builds[future], result.get('fmax_mhz'), result.get('reason'), (result.get('critical_paths') or [None])[0], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
