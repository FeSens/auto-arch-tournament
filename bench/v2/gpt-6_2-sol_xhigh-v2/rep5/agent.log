{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/address_variants.py <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nbase = Path('cores/bench/rtl')\norig_if = (base / 'if_stage.sv').read_text()\norig_ex = (base / 'ex_stage.sv').read_text()\nif_lo = orig_if.index('  assign target_carry =')\nif_hi = orig_if.index('  assign direct_in_range', if_lo)\nex_lo = orig_ex.index('  assign addr_carry  =')\nex_hi = orig_ex.index('  // ── ALU operand selection', ex_lo)\ndef transform(text, lo, hi, result, upper, carry, sign, old_c, old_b, method, base_ix, bits):\n    s = '\\\\n'\n    if method == 'prefix':\n        s = f'''  assign {old_c} = {carry} \"'^ {sign};\n  assign {result}[{base_ix}] = {upper}[0] ''^ {old_c};\n  for (genvar i = 1; i < {bits}; i++) begin : gen_upper_skip\n    logic propagate;\n    assign propagate = {sign} ? !(|{upper}[i-1:0]) : (&{upper}[i-1:0]);\n    assign {result}[i+{base_ix}] = {upper}[i] ''^ ({old_c} && propagate);\n  end\n'\"'''\n        text = text.replace(f', {old_b};', ';').replace(f', {old_b}', '')\n    if method == 'mux':\n        mask_type = f'[{bits-1}:0]'\n        s = f'''  logic {mask_type} plus_one, minus_one, adjusted;\n  assign {old_c} = {carry} \"'^ {sign};\n  assign plus_one = {upper} + {bits}'\"'d1;\n  assign minus_one = {upper} - {bits}'d1;\n  assign adjusted = {sign} ? minus_one : plus_one;\n  assign {result}[{base_ix+bits-1}:{base_ix}] = {old_c} ? adjusted : {upper};\n'''\n        text = text.replace(f', {old_b};', ';').replace(f', {old_b}', '')\n    if method == 'carry':\n        s = f'''  assign {result}[{base_ix+bits-1}:{base_ix}] = {upper} + {{{bits}{{{sign}}}}} + {bits}'({carry});\n'''\n        text = text.replace(f', {old_c}, {old_b};', ';').replace(f'  logic {old_c}, {old_b};\\\\n', '')\n    return text[:text.index(lo)] + s + text[text.index(hi):]\n\nfor name, mode_if, mode_ex in (\n    ('addr_prefix', 'prefix', 'prefix'),\n    ('addr_mux', 'mux', 'mux'),\n    ('addr_carry', 'carry', 'carry'),\n    ('fetch_prefix', 'prefix', None),\n    ('fetch_mux', 'mux', None),\n    ('fetch_carry', 'carry', None),\n    ('ex_prefix', None, 'prefix'),\n    ('ex_mux', None, 'mux'),\n):\n    p = scratch / name\n    shutil.copytree(base, p)\n    if mode_if:\n        (p/'if_stage.sv').write_text(transform(orig_if, orig_if[if_lo:if_lo+22], orig_if[if_hi:if_hi+24], 'direct_word', 'pc_upper', 'direct_low_sum[18]', 'offset_word[20]', 'target_carry', 'target_borrow', mode_if, 20, 12))\n    if mode_ex:\n        ex = orig_ex.replace('  logic [19:0] addr_hi;', '  logic [19:0] addr_hi;\\\\n  logic [19:0] base_upper;\\\\n  assign base_upper = rs1[31:12];')\n        (p/'ex_stage.sv').write_text(transform(ex, orig_ex[ex_lo:ex_lo+22], orig_ex[ex_hi:ex_hi+24], 'addr_hi', 'base_upper', 'addr_lo[12]', 'in.imm[11]', 'addr_carry', 'addr_borrow', mode_ex, 0, 20))\n\np = scratch / 'fetch_fullword'\nshutil.copytree(base, p)\ns = orig_if[:if_lo] + '  assign direct_word[31:20] = direct_full_sum[29:18];\\\\n' + orig_if[if_hi:]\ns = s.replace('  logic [11:0] pc_upper;', '''  logic [11:0] pc_upper;\n  logic [29:0] direct_full_sum;\n  assign direct_full_sum = pc_word + {{11{offset_word[20]}}, offset_word};''')\ns = s.replace(', target_carry, target_borrow', '')\n(p/'if_stage.sv').write_text(s)\n\np = scratch / 'fifo_full_pop'\nshutil.copytree(base, p)\n(p/'if_stage.sv').write_text(orig_if.replace('assign accept_response = response_valid && \"'!full && !reset;'\"', 'assign accept_response = response_valid && (\"'!full || issue) && !reset;'\"'))\nPY\npython /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/address_variants.py\npython -u /srv/hwebench/tmp/7c172beb/53cb8242/hyp-r14s0.VcAbpq/time_variants.py addr_prefix:1 fetch_prefix:1 addr_mux:1 fetch_fullword:1 ex_prefix:1 ex_mux:1 fetch_mux:1 addr_carry:1 fetch_carry:1 fifo_full_pop:1\"","aggregated_output":"","exit_code":null,"status":"