{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c 'set -e\nprofile_dir=\"$TMPDIR/bench-r10-profile.Jp85SQ\"\nmkdir -p \"$profile_dir/rtl2\"\ncp \"$profile_dir/rtl/\"*.sv \"$profile_dir/rtl2/\"\ncat > \"$profile_dir/retime.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot=Path(sys.argv[1])\n\ndef fix(file, before, after):\n    f=root/(file+'.sv')\n    s=f.read_text()\n    assert s.count(before)==1, (file,before,s.count(before))\n    f.write_text(s.replace(before,after))\n\nfix('core_pkg','    logic [31:0] direct_target;\\\\n    logic [31:0] imm;\\\\n    logic        forward_write;',\n    '    logic [31:0] direct_target;\\\\n    logic [31:2] alternate_word;\\\\n    logic [31:0] branch_known;\\\\n    logic        branch_fallback;\\\\n    logic [31:0] imm;\\\\n    logic        forward_write;')\nfix('core','  id_ex_t  id_ex_w;\\\\n  ex_mem_t ex_mem_w;', '  id_ex_t  id_ex_w, id_ex_raw;\\\\n  ex_mem_t ex_mem_w, ex_mem_raw;')\nfix('core','  logic        redirect, advance_aperture;\\\\n  logic [31:2] redirect_word;',\n    '  logic        advance_aperture, recovering, late_kill_q;')\nfix('core','  assign redirect = late_redirect || ex_redirect;\\\\n  assign redirect_word = late_redirect ? late_redirect_word : ex_redirect_word;',\n    '''  always_ff @(posedge clock)\n    late_kill_q <= \"'!reset && late_redirect;\n\n  always_comb begin\n    id_ex_w = id_ex_raw;\n    id_ex_w.valid = id_ex_raw.valid && !recovering;\n    ex_mem_w = ex_mem_raw;\n    ex_mem_w.valid = ex_mem_raw.valid && !late_kill_q;\n  end'\"''')\nfix('core','    .redirect        (redirect),\\\\n    .redirect_word   (redirect_word),',\n    '''    .redirect        (ex_redirect),\n    .redirect_word   (ex_redirect_word),\n    .late_redirect   (late_redirect),\n    .late_word       (late_redirect_word),\n    .recovering      (recovering),''')\nfix('core','    .kill     (late_redirect),\\\\n','')\nfix('core','    .out      (id_ex_w)','    .out      (id_ex