{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/bash -c \"cat > prepare.py <<'PY'\nfrom pathlib import Path\n\ndef edit(file, changes):\n    path = Path(\\\"cores/bench/rtl\\\", file)\n    source = Path(\\\"baseline\\\", file).read_text()\n    for old, new in changes:\n        assert source.count(old) == 1, old\n        source = source.replace(old, new)\n    path.write_text(source)\n\nedit(\\\"core.sv\\\", [\n    (\\\"  logic [5:0]  ex_index, mem_index;\\\", \\\"  logic [5:0]  ex_index, mem_index;\\\\n  logic ex_fence_advance;\\\"),\n    (\\\"    .train_taken     (mem_train ? mem_taken : ex_taken),\\\", \\\"\\\"\\\"    .train_taken     (mem_train ? mem_taken : ex_taken),\n    .train_pc        (mem_train ? ex_mem_w.pc : id_ex_w.pc),\n    .train_target    (mem_train ? ex_mem_w.branch_target : id_ex_w.direct_target),\n    .fence_advance   (ex_fence_advance),\\\"\\\"\\\"),\n    (\\\"    .redirect        (ex_redirect),\\\", \\\"\\\"\\\"    .fence_advance   (ex_fence_advance),\n    .redirect        (ex_redirect),\\\"\\\"\\\"),\n])\nedit(\\\"ex_stage.sv\\\", [\n    (\\\"  output logic               advance_aperture,\\\", \\\"\\\"\\\"  output logic               advance_aperture,\n  output logic               fence_advance,\\\"\\\"\\\"),\n    (\\\"  assign advance_aperture = advance && in.holds_fetch;\\\", \\\"\\\"\\\"  assign advance_aperture = advance && in.holds_fetch;\n  assign fence_advance = advance && in.instr[6:0] == 7'b0001111 && in.instr[14:12] == 3'b001;\\\"\\\"\\\"),\n])\nedit(\\\"if_stage.sv\\\", [\n    (\\\"  input  logic              train_taken,\\\", \\\"\\\"\\\"  input  logic              train_taken,\n  input  logic [31:0]       train_pc,\n  input  logic [31:0]       train_target,\n  input  logic              fence_advance,\\\"\\\"\\\"),\n    (\\\"  logic [19:2] prediction_q;\\\", \\\"\\\"\\\"  logic [19:2] prediction_q, replay_target_q;\n  logic replay_select_q;\\\"\\\"\\\"),\n    (\\\"  logic response_vali