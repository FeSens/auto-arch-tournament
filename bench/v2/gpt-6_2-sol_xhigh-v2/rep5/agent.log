en      ? branch_target\n                                                : (in.pc + 32'd4);\\\"\\\"\\\", \\\"      reg_q.pc_next       <= redirect_target;\\\"),\n])\n\nreplace(\\\"core.sv\\\", [\n    (\\\"  logic [31:0] redirect_target;\\\", \\\"\\\"\\\"  logic [31:0] redirect_target;\n  logic        train_valid, train_jump, train_taken;\n  logic [31:0] train_target;\\\"\\\"\\\"),\n    (\\\"    .imem_addr       (io_imemAddr),\\\", \\\"\\\"\\\"    .train_valid     (train_valid),\n    .train_pc        (id_ex_w.pc),\n    .train_jump      (train_jump),\n    .train_taken     (train_taken),\n    .train_target    (train_target),\n    .imem_addr       (io_imemAddr),\\\"\\\"\\\"),\n    (\\\"\\\"\\\"    .out             (ex_mem_w),\n    .redirect        (redirect),\n    .redirect_target (redirect_target)\\\"\\\"\\\", \\\"\\\"\\\"    .fetch_pc        (io_imemAddr),\n    .out             (ex_mem_w),\n    .redirect        (redirect),\n    .redirect_target (redirect_target),\n    .train_valid     (train_valid),\n    .train_jump      (train_jump),\n    .train_taken     (train_taken),\n    .train_target    (train_target)\\\"\\\"\\\"),\n])\n\nreplace(\\\"if_stage.sv\\\", [\n    (\\\"  output logic [31:0]       imem_addr,\\\", \\\"\\\"\\\"  input  logic              train_valid,\n  input  logic [31:0]       train_pc,\n  input  logic              train_jump,\n  input  logic              train_taken,\n  input  logic [31:0]       train_target,\n  output logic [31:0]       imem_addr,\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  logic [31:0] next_pc;\n\n  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end\\\"\\\"\\\", \\\"\\\"\\\"  logic [31:0] next_pc;\n\n  localparam int INDEX_WIDTH = 5;\n  localparam int ENTRY_COUNT = 1 << INDEX_WIDTH;\n  logic [ENTRY_COUNT-1:0] valid;\n  logic [17:0] targets [0:ENTRY_COUNT-1];\n  logic [17-INDEX_WIDTH:0] tags [0:ENTRY_COUNT-1];\n  logic [1:0] counters [0:ENTRY_COUNT-1];\n  logic [INDEX_WIDTH-1:0] read_index, write_index;\n  logic wr