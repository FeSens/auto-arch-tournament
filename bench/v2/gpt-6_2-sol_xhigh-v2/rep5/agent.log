{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nfrom shutil import copytree\nbase = Path(os.environ['TMPDIR'])\nvariants = ['divider-table', 'divider-staged']\nfor v in variants:\n    dest = base/v\n    copytree('fpga',dest/'fpga',dirs_exist_ok=True)\n    copytree('cores/bench/rtl',dest/'cores/bench/rtl',dirs_exist_ok=True)\n    (dest/'cores/bench/core.yaml').write_bytes(Path('cores/bench/core.yaml').read_bytes())\n\n# Keep the eight-edge schedule. Map the top nibble as truth tables, then\n# use two radix-4 digits for the remainder of the leading byte.\np = base/'divider-table/cores/bench/rtl/divider.sv'\ns = (base/'divider-hypothesis/cores/bench/rtl/divider.sv').read_text()\nstart = s.index('  function automatic [3:0] prefix_step2')\nend = s.index('  function automatic [7:0] prefix_step6',start)\nbody = '''  function automatic [7:0] prefix_nibble (\n    input logic [3:0] dividend,\n    input logic [7:0] divisor\n  );\n    logic [11:0] decoded;\n    logic [7:0] qrem [0:15];\n    begin\n'''\nfor d in range(16):\n    body += f\\\"      qrem[{d}] = 8'b0;\\\\n\\\"\n    for bit in range(8):\n        table=0\n        for a in range(16):\n            quotient, rem = divmod(a,d) if d else (15,a)\n            table |= ((((quotient << 4) | rem) >> bit) & 1) << a\n        body += f\\\"      qrem[{d}][{bit}] = 1'((16'h{table:04x} >> dividend));\\\\n\\\"\nbody=body.replace('    logic [11:0] decoded;\\\\n','')\nbody += '''      if (|divisor[7:4])\n        prefix_nibble = {4'b0, dividend};\n      else\n        prefix_nibble = qrem[divisor[3:0]];\n    end\n  endfunction\n\n'''\ns=s[:start]+body+s[end:]\ns=s.replace('  logic [3:0] prefix2;\\\\n  logic [5:0] prefix4;', '  logic [7:0] prefix4;')\na=s.index('  assign prefix2 =')\nb=s.index('  assign prefix6 =',a)\ns=s[:a]+'  assign prefix4 = prefix_nibble(a_mag_hi[7:4], b_mag_byte);\\\\n'+s[b:]\ns=s.replace('prefix2[3:2], prefix4[5:4],','prefix4[7:4],')\np.write_text(s)\n\n# Separate operand capture and the existing four-bit setup with one extra\n# edge. This isolates the timed launch path and retains the original trials.\np = base/'divider-staged/cores/bench/rtl/divider.sv'\ns=p.read_text().replace(\\\"phase_q <= 4'd8\\\",\\\"phase_q <= 4'd9\\\")\ns=s.replace('  logic signed_op, want_remainder, a_negative, b_negative;', '''  logic [31:0] a_q, b_q;\n  logic a_negative, b_negative, want_remainder;\n  logic initialize;\n  assign initialize = phase_q == 4'd9;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      a_q  <= '0;\n      b_q  <= '0;\n      a_negative <= 1'b0;\n      b_negative <= 1'b0;\n      want_remainder <= 1'b0;\n    end else if (starting) begin\n      a_q  <= a;\n      b_q  <= b;\n      a_negative <= (op == ALU_DIV || op == ALU_REM) && a[31];\n      b_negative <= (op == ALU_DIV || op == ALU_REM) && b[31];\n      want_remainder <= op == ALU_REM || op == ALU_REMU;\n    end\n  end''')\nstart=s.index('  assign signed_op')\nend=s.index('  // The launch trials',start)\nsetup=s[start:end]\nsetup=setup[setup.index('  assign a_mag_lo'):]\nimport re\nsetup=re.sub(r'\\\\ba\\\\b','a_q',setup)\nsetup=re.sub(r'\\\\bb\\\\b','b_q',setup)\ns=s[:start]+setup+s[end:]\ns=s.replace(\\\"end else if (starting) begin\\\\n      divisor_q\\\", \\\"end else if (initialize) begin\\\\n      divisor_q\\\").replace(\\\"&& (b \"'!= 0)\", \"&& (b_q != 0)\")\np.write_text(s)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
