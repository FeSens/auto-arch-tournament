{"type": "item.completed", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c \"sed -n '55,245p' cores/bench/test/test_pipeline.py; sed -n '385,540p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef DIVU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b101, rd, 0b0110011)\ndef REMU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b111, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef BNE (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b001, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, dmem_ready=None, imem_ready=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Optional imem_ready(addr) and dmem_ready(addr, ren, wen) callbacks\n    drive backpressure after the initial fetch request.\n    Stores are applied when the bus is ready so subsequent loads see them.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = program if isinstance(program, dict) else {\n        i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)\n    }\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut\n…[10645 of 13717 chars elided by tools/bench/transcript.py; sha256:2ade4c1b90ff4888]…\nfter_load_use_and_transfer(dut, predict_jal):\n    program = [\n        ADDI(1, 0, 7),\n        LW(2, 0, 0x40),\n        DIVU(3, 2, 1),\n        REMU(4, 3, 1),\n        ADD(5, 3, 4),\n        JAL(0, 8) if predict_jal else BEQ(0, 0, 8),\n        DIVU(6, 0, 0),          # Wrong path.\n        REMU(6, 5, 1),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, dmem_init={0x40: 110})\n    assert [r[\"insn\"] for r in rets] == program[:6] + program[7:]\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 20, 28, 32]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    _, load, div, rem, consumer, jump, target, _ = rets\n    assert (div[\"rs1_rdata\"], div[\"rd_wdata\"]) == (110, 15)\n    assert (rem[\"rs1_rdata\"], rem[\"rd_wdata\"]) == (15, 1)\n    assert consumer[\"rd_wdata\"] == 16\n    assert target[\"rd_wdata\"] == 2\n    assert div[\"cycle\"] - load[\"cycle\"] == 9\n    assert rem[\"cycle\"] - div[\"cycle\"] == 8\n    assert jump[\"pc_next\"] == 28\n    assert target[\"cycle\"] - jump[\"cycle\"] == (8 if predict_jal else 9)\n\n", "exit_code": 0, "status": "completed"}}
