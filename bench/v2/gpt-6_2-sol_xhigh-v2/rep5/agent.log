{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r11s0.AT6WVG/sweep.py\" <<'\"'PY'\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport shutil\nimport sys\n\nfrom tools.eval.gowin import build\n\nscratch = Path(__file__).parent\nworktree = Path.cwd()\nsource = worktree / 'cores' / 'bench' / 'rtl'\nif_stage = (source / 'if_stage.sv').read_text()\nsum_line = \\\"  assign direct_low_sum = {1'b0, pc_word[19:2]} + {1'b0, offset_word[19:2]};\\\"\nassert sum_line in if_stage\n\ndef target_adder(widths, propagate_style, hi_style):\n    assert sum(widths) == 18\n    lines = []\n    start = 2\n    for index, width in enumerate(widths):\n        end = start + width - 1\n        a = f'pc_word[{end}:{start}]'\n        b = f'offset_word[{end}:{start}]'\n        lines.append(f'  logic [{width}:0] target_sum_{index};')\n        lines.append(f'  logic target_generate_{index};')\n        lines.append(f\\\"  assign target_sum_{index} = {{1'b0, {a}}} + {{1'b0, {b}}};\\\")\n        lines.append(f'  assign target_generate_{index} = target_sum_{index}[{width}];')\n        if index:\n            op = '\"'^'\"' if propagate_style == 'xor' else '|'\n            lines.append(f'  logic target_propagate_{index};')\n            lines.append(f'  assign target_propagate_{index} = &({a} {op} {b});')\n            lines.append(f'  logic target_carry_in_{index};')\n            terms = carry_terms(index)\n            lines.append(f\\\"  assign target_carry_in_{index} = {' || '.join(terms)};\\\")\n        sum_out = f'direct_low_sum[{end - 2}:{start - 2}]'\n        sum0 = f'target_sum_{index}[{width - 1}:0]'\n        if index and hi_style == 'mux':\n            lines.append(f'  logic [{width - 1}:0] target_sum_plus_one_{index};')\n            lines.append(f\\\"  assign target_sum_plus_one_{index} = {a} + {b} + {width}'d1;\\\")\n            lines.append(f'  assign {sum_out} = target_carry_in_{index} ? target_sum_plus_one_{index} : {sum0};')\n        elif index and hi_style == 'local_prefix':\n            for bit in range(width):\n                if bit:\n                    prefix = f\\\"&(pc_word[{start + bit - 1}:{start}] \"'^ offset_word[{start + bit - 1}:{start}])\"\n                    cin = f'\"'(target_carry_in_{index} && {prefix})'\n                else:\n                    cin = f'target_carry_in_{index}'\n                lines.append(f'  assign direct_low_sum[{start - 2 + bit}] = target_sum_{index}[{bit}] \"'^ {cin};'\"')\n        else:\n            lines.append(f'  assign {sum_out} = {sum0};')\n        start += width\n    lines.append(f\\\"  assign direct_low_sum[18] = {' || '.join(carry_terms(len(widths)))};\\\")\n    return '\\\\n'.join(lines)\n\ndef carry_terms(group):\n    terms = []\n    for gen in reversed(range(group)):\n        prop = [f'target_propagate_{p}' for p in range(gen + 1, group)]\n        term = ' && '.join([f'target_generate_{gen}', *prop])\n        terms.append(f'({term})' if prop else term)\n    return terms\n\ndef run(name_and_options):\n    name, option = name_and_options\n    variant = scratch / name\n    result = build(worktree, variant / 'rtl', 'fpga/core_bench_si.sv', option, variant / f'p{option}')\n    print(name, option, result.get('fmax_mhz'), result.get('logic'), result.get('regs'),\n          [(p['from'], p['to'], p['slack_ns']) for p in result.get('critical_paths', [])[:3]], result.get('reason', ''), flush=True)\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('variants', nargs='+')\n    parser.add_argument('--options', type=int, nargs='+', default=[1])\n    args = parser.parse_args()\n    for name in args.variants:\n        variant = scratch / name / 'rtl'\n        shutil.copytree(source, variant, dirs_exist_ok=True)\n        if name \"'!= '\"'baseline':\n            width_string, prop, hi = name.split('_')\n            widths = tuple(map(int, width_string.split('-')))\n            (variant / 'if_stage.sv').write_text(if_stage.replace(sum_line, target_adder(widths, prop, hi)))\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(run, [(name, option) for name in args.variants for option in args.options]))\n\nif __name__ == '__main__':\n    main()\nPY\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. python \\\"\"'$TMPDIR/r11s0.AT6WVG/sweep.py\" baseline 6-6-6_xor_mux 9-9_or_mux 6-6-6_or_local_prefix'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
