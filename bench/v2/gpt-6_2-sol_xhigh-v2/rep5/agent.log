{"type":"item.completed","item":{"id":"item_114","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/alu.sv'","aggregated_output":"// rtl/alu.sv\n//\n// Combinational ALU for RV32I.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata through EX/MEM and MEM/WB.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n\nmodule alu #(\n  parameter bit REGISTERED_SELECT = 1'b0\n) (\n  input  logic [4:0]  op,\n  input  alu_select_t selects,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  alu_select_t sel;\n  logic [31:0] shift_right;\n  logic [31:0] logic_result, shift_result, arithmetic_result;\n\n  assign sel = REGISTERED_SELECT ? selects : decode_alu(op);\n  assign shift_right = 32'($signed({sel.sra && a[31], a}) >>> b[4:0]);\n  assign logic_result = ({32{sel.and_op}} & (a & b))\n                      | ({32{sel.or_op}} & (a | b))\n                      | ({32{sel.xor_op}} & (a ^ b))\n                      | {31'b0, (sel.slt && $signed(a) < $signed(b)) || (sel.sltu && a < b)};\n  assign shift_result = ({32{sel.sll}} & (a << b[4:0]))\n                      | ({32{sel.srl || sel.sra}} & shift_right)\n                      | ({32{sel.lui}} & b);\n  // Combine the slow carry-chain results at the last level of the mux.\n  assign arithmetic_result = ({32{sel.add}} & (a + b)) | ({32{sel.sub}} & (a - b));\n  assign out = (logic_result | shift_result) | arithmetic_result;\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type": "item.completed", "item": {"id": "item_115", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/divider.sv'", "aggregated_output": "// Blocking, nine-edge RV32M divider. EX can hand off on the edge that\n// registers the trial residual, and MEM applies the exact correction.\nmodule divider (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        launch,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        idle,\n  output logic        handoff_ready,\n  output logic [31:0] result\n);\n\n  // 0 = idle, 9..2 = arithmetic stages after launch, 1 = result pending.\n  logic [3:0] phase_q;\n  logic starting, finishing;\n  logic [31:0] a_q, b_q;\n\n  assign idle          = phase_q == 4'd0;\n  assign finishing     = phase_q == 4'd2;\n  assign handoff_ready = finishing || phase_q == 4'd1;\n  assign starting      = idle && launch;\n\n  always_ff @(posedge clock) begin\n    if (reset)                       phase_q <= 4'd0;\n    else if (starting)               phase_q <= 4'd9;\n    else if (handoff_ready && accept) phase_q <= 4'd0;\n    else if (|phase_q[3:1])           phase_q <= phase_q - 4'd1;\n  end\n\n  always_ff @(posedge clock) begin\n    if (starting) begin\n      a_q <= a;\n      b_q <= b;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [4:0] op_q;\n  logic [31:0] alt_mask, alt_result_q;\n\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  alt_mask = 32'h7f8529ec;\n      ALU_DIVU: alt_mask = 32'h10e8fd70;\n      ALU_REM:  alt_mask = 32'h8da68fa5;\n      ALU_REMU: alt_mask = 32'h3138d0e1;\n      default:  alt_mask = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (starting) op_q <= op;\n    if (phase_q == 4'd9) alt_result_q <= (a_q - b_q) ^ alt_mask;\n    if (reset) result <= '0;\n    else if (finishing) result <= alt_result_q;\n  end\n`else\n  logic signed_op, a_negative_q, b_negative_q, want_remainder_q;\n  logic [31:0] a_magnitude, b_magnitude, dividend_q, divisor_q;\n  logic divisor_zero_q, negate_q;\n  logic [4:0] leading_zeros_q, quotient_shift;\n  logic [31:0] mask_q, normalized_q;\n  logic [30:0] normalized_low;\n  logic [21:0] fraction_q;\n\n  // Zero is handled separ\n…[5936 of 9008 chars elided by tools/bench/transcript.py; sha256:6cf4d73632284a09]…\n  end\n\n  // The conservative reciprocal makes the trial quotient exact or one low.\n  // The extra bit of the MEM subtraction detects a borrow for any divisor.\n  logic [32:0] corrected_residue;\n  logic [31:0] corrected_negative_residue;\n  logic take_correction;\n  assign corrected_residue = {1'b0, residue_q} - {1'b0, divisor_q};\n  assign corrected_negative_residue = divisor_q - residue_q;\n  assign take_correction = !divisor_zero_q && !corrected_residue[32];\n  // The 32-bit candidates also give the specified INT_MIN / -1 result.\n  assign result = ({32{result_valid_q && !take_correction}} & base_result_q)\n                | ({32{result_valid_q && take_correction && !want_remainder_q}} &\n                   next_quotient_q)\n                | ({32{result_valid_q && take_correction && want_remainder_q && !negate_q}} &\n                   corrected_residue[31:0])\n                | ({32{result_valid_q && take_correction && want_remainder_q && negate_q}} &\n                   corrected_negative_residue);\n`endif\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
