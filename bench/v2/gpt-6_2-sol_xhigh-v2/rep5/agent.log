{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2-predictor/variants.bSVQ0x\"\nPREDICTOR_VARIANTS=\"$trial_dir\" PYTHONDONTWRITEBYTECODE=1 python3 -u - <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nimport shutil\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\noriginal = root / 'cores/bench/rtl'\nscratch = Path(os.environ['PREDICTOR_VARIANTS'])\nsplit = (scratch/'split-only/if_stage.sv').read_text()\nparallel = (scratch/'parallel/if_stage.sv').read_text()\nplain = (original/'if_stage.sv').read_text()\n\ndef defer_flush(s):\n    s = s.replace('  logic empty, full;', '''  logic [2:0] read_ptr, write_ptr;\n  logic empty, full;\n\n  assign read_ptr = redirect_pending_q ? 3'b000 : read_ptr_q;\n  assign write_ptr = redirect_pending_q ? 3'b000 : write_ptr_q;''')\n    i = s.index('  assign empty')\n    s = s[:i] + s[i:].replace('read_ptr_q', 'read_ptr').replace('write_ptr_q', 'write_ptr')\n    s = s.replace(\\\"\\\"\\\"    if (reset || redirect) begin\n      read_ptr  <= '0;\n      write_ptr <= '0;\n    end else begin\n      if (issue)           read_ptr  <= read_ptr + 3'd1;\n      if (accept_response) write_ptr <= write_ptr + 3'd1;\n    end\\\"\\\"\\\",\\\"\\\"\\\"    if (reset) begin\n      read_ptr_q  <= '0;\n      write_ptr_q <= '0;\n    end else begin\n      if (issue_candidate || redirect_pending_q) read_ptr_q  <= read_ptr + {2'b0, issue_candidate};\n      if (accept_response || redirect_pending_q) write_ptr_q <= write_ptr + {2'b0, accept_response};\n    end\\\"\\\"\\\")\n    return s\n\ndef trim_target(s, dst):\n    pkg_path = dst/'core_pkg.sv'\n    pkg = pkg_path.read_text().replace('    logic [31:0] direct_target;', '''    logic [19:2] direct_word_low;\n    logic        target_carry;''', 1)\n    pkg_path.write_text(pkg)\n    id_path = dst/'id_stage.sv'\n    id_text = id_path.read_text()\n    id_text = id_text.replace('  // ── ID/EX register', '''  logic [11:0] upper_pc, upper_inc, upper_dec, upper_target;\n  logic target_negative, target_bit1;\n  assign target_negative = in.instr[31];\n  assign upper_pc = in.pc[31:20];\n  assign upper_inc = upper_pc + 12'd1;\n  assign upper_dec = upper_pc - 12'd1;\n  assign upper_target = target_negative ? (in.target_carry ? upper_pc : upper_dec)\n                                        : (in.target_carry ? upper_inc : upper_pc);\n  assign target_bit1 = (in.instr[6:0] == 7'b1101111) ? in.instr[21] : in.instr[8];\n\n  // ── ID/EX register''')\n    id_path.write_text(id_text.replace('<= in.direct_target;', \\\"<= {upper_target, in.direct_word_low, target_bit1, 1'b0};\\\"))\n    s = s.replace('logic [31:2] direct_word;', 'logic [19:2] direct_word;').replace('upper_pc, upper_inc, upper_dec;', 'upper_pc;')\n    start = s.index('  assign upper_inc')\n    end = s.index('  assign direct_in_aperture', start)\n    s = s[:start] + \\\"\\\"\\\"  assign direct_word[10:2] = low_sum[8:0];\n  assign direct_word[19:11] = low_sum[9] ? middle_plus_one : middle_sum[8:0];\n\\\"\\\"\\\" + s[end:]\n    return s.replace(\\\"  assign response.direct_target    = {direct_word, direct_bit1, 1'b0};\\\", '''  assign response.direct_word_low  = direct_word;\n  assign response.target_carry     = carry_to_upper;''')\n\ndef two_pc(s):\n    s = s.replace('  logic redirect_pending_q;', '''  logic redirect_pending_q, taken_pending_q, use_normal_q;\n  logic [19:2] taken_word_q;''')\n    start = s.index('  // Register the recovery decision')\n    end = s.index('    if (reset || redirect || resume_fetch)', start)\n    s = s[:start] + \\\"\\\"\\\"  logic step_sequential, select_taken;\n\n  assign step_sequential = resume_fetch || (accept_response && pc_word \"'!= LAST_IMEM_WORD);\n  assign select_taken = accept_response && predicted_taken;\n  assign pc_word = ({30{use_normal_q}} & request_word_q)\n                 | {12'\"'b0, ({18{taken_pending_q}} & taken_word_q)}\n                 | ({30{redirect_pending_q}} & redirect_target_q);\n\n  always_ff @(posedge clock) begin\n    redirect_pending_q <= \"'!reset && redirect;\n    taken_pending_q <= !reset && !redirect && select_taken;\n    use_normal_q <= reset || (!redirect && !select_taken);\n    redirect_target_q <= redirect_word;\n    taken_word_q <= direct_word[19:2];\n\n    if (reset) request_word_q <= '\"'0;\n    else request_word_q <= step_sequential ? pc_word + 30'd1 : pc_word;\n\n\\\"\\\"\\\" + s[end:]\n    return s.replace('predicted_taken  = imem_ready && ', 'predicted_taken  = ')\n\nvariants = {\n    'recovery-only': (defer_flush(plain), False),\n    'parallel-recovery': (defer_flush(parallel.replace('select_redirect_q', 'redirect_pending_q')), False),\n    'two-pc': (two_pc(split), False),\n    'two-pc-compact': (two_pc(split), True),\n    'two-pc-compact-recovery': (defer_flush(two_pc(split)), True),\n    'parallel-compact': (parallel, True),\n}\nfor name, (src, compact) in variants.items():\n    directory = scratch/name\n    shutil.copytree(original, directory, copy_function=shutil.copyfile)\n    (directory/'if_stage.sv').write_text(trim_target(src, directory) if compact else src)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:\n    builds = {pool.submit(build, root, scratch/name, 'fpga/core_bench_si.sv', option, scratch/f'{name}-{option}'): (name, option)\n              for option in (1, 0) for name in variants}\n    for future in concurrent.futures.as_completed(builds):\n        result = future.result()\n        print(builds[future], result.get('fmax_mhz'), result.get('reason'), (result.get('critical_paths') or [None])[0], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
