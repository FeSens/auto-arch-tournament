{"type": "item.started", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport shutil\n\ns = Path(os.environ['TMPDIR']) / 'r10s0'\nsrc = (s / 'radix16/cores/bench/rtl/divider.sv').read_text()\n\ndef variant(name, new):\n    rtl = s / name / 'cores/bench/rtl'\n    shutil.copytree(s / 'radix16/cores/bench/rtl', rtl)\n    (rtl / 'divider.sv').write_text(new)\n\ni = src.index(\\\"  for (genvar k = 0; k <= 15; k++) begin : gen_narrow_select\\\")\nj = src.index(\\\"  logic [34:0] multiples\\\", i)\n\ngrouped = \\\"\\\"\\\"  // The comparisons at 4D, 8D and 12D select the group.\n  // Within each group the other three comparisons select the candidate.\n  logic [3:0] narrow_group_select;\n  wire [4:0] narrow_group_borrow = {narrow_borrow[16], narrow_borrow[12],\n                                   narrow_borrow[8], narrow_borrow[4], narrow_borrow[0]};\n  logic [10:0] narrow_group_remainder [0:3];\n  logic [1:0] narrow_group_digit [0:3];\n\n  for (genvar g = 0; g < 4; g++) begin : gen_narrow_group\n    wire b1 = narrow_borrow[g*4+1];\n    wire b2 = narrow_borrow[g*4+2];\n    wire b3 = narrow_borrow[g*4+3];\n    wire [3:0] choice = {\"'!b3, b3 && !b2, b2 && !b1, b1};\n    assign narrow_group_select[g] = !narrow_group_borrow[g] && narrow_group_borrow[g+1];\n    assign narrow_group_remainder[g] = ({11{choice[0]}} & narrow_difference[g*4])\n                                     | ({11{choice[1]}} & narrow_difference[g*4+1])\n                                     | ({11{choice[2]}} & narrow_difference[g*4+2])\n                                     | ({11{choice[3]}} & narrow_difference[g*4+3]);\n    assign narrow_group_digit[g] = {!b2, choice[1] || choice[3]};\n  end\n\n  assign narrow_remainder = ({11{narrow_group_select[0]}} & narrow_group_remainder[0])\n                          | ({11{narrow_group_select[1]}} & narrow_group_remainder[1])\n                          | ({11{narrow_group_select[2]}} & narrow_group_remainder[2])\n                          | ({11{narrow_group_select[3]}} & narrow_group_remainder[3]);\n  assign narrow_digit = {!narrow_borrow[8], narrow_group_select[1] || narrow_group_select[3],\n                          ({2{narrow_group_select[0]}} & narrow_group_digit[0])\n                        | ({2{narrow_group_select[1]}} & narrow_group_digit[1])\n                        | ({2{narrow_group_select[2]}} & narrow_group_digit[2])\n                        | ({2{narrow_group_select[3]}} & narrow_group_digit[3])};\n\n\"\"\"\nhier = (src[:i] + grouped + src[j:]).replace('\"'  logic [15:0] narrow_select;\\\\n', '')\nvariant(\\\"radix16-group\\\", hier)\nfor width, label, spec in [(8, \\\"radix16-split\\\", src), (10, \\\"radix16-group-split\\\", hier)]:\n    k = spec.index(\\\"    /* verilator lint_off UNUSEDSIGNAL */\\\\n    wire [15:0] difference\\\")\n    l = spec.index(\\\"\\\\n  end\\\", k)\n    spec = spec[:k] + f\\\"\\\"\\\"    wire [{width-1}:0] trial_lo = narrow_trial[{width-1}:0];\n    wire [{width-1}:0] multiple_lo = narrow_multiple[k][{width-1}:0];\n    wire [{14-width}:0] trial_hi = narrow_trial[14:{width}];\n    wire [{14-width}:0] multiple_hi = narrow_multiple[k][14:{width}];\n    wire lo_borrow = trial_lo < multiple_lo;\n    assign narrow_borrow[k] = (trial_hi < multiple_hi) || ((trial_hi == multiple_hi) && lo_borrow);\n    assign narrow_difference[k] = narrow_trial[10:0] - narrow_multiple[k][10:0];\\\"\\\"\\\" + spec[l:]\n    variant(label, spec)\n\n# Reuse the narrow part of the registered wide-path multiples for 5D and 7D.\nspec = src.replace('logic [14:0] narrow_multiple_q [5:15];', 'logic [14:0] narrow_multiple_q [9:15];')\nspec = spec.replace('  assign narrow_multiple[3] = three_divisor_q[14:0];',\n                    '  assign narrow_multiple[3] = three_divisor_q[14:0];\\\\n'\n                    '  assign narrow_multiple[5] = five_divisor_q[14:0];\\\\n'\n                    '  assign narrow_multiple[7] = seven_divisor_q[14:0];')\nspec = spec.replace('end else if (k >= 5)', 'end else if (k >= 9)')\nspec = '\\\\n'.join(line for line in spec.split('\\\\n') if not ('5:  narrow_multiple_q' in line or '7:  narrow_multiple_q' in line))\nvariant(\\\"radix16-share\\\", spec)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
