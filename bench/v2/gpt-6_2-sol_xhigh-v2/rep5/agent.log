ll_q)-1:0] even_entries [0:31];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [$bits(fill_q)-1:0] odd_entries [0:31];\n  logic [31:0] even_valid_q, odd_valid_q;\n  logic [31:3] even_word;\n  logic [4:0] even_index, odd_index;\n  replay_entry_t even_entry, odd_entry, even_entry_q, odd_entry_q, replay_entry;\n  logic even_hit_q, odd_hit_q, replay_staged_q, replay_hit;\n\n  assign even_word = pc_word[2] ? sequential_word[31:3] : pc_word[31:3];\n  assign even_index = even_word[7:3];\n  assign odd_index = pc_word[7:3];\n  assign even_entry = even_entries[even_index];\n  assign odd_entry = odd_entries[odd_index];\n\n  always_ff @(posedge clock) begin\n    if (fill_write && !fill_pc_q[0]) even_entries[fill_pc_q[5:1]] <= fill_q;\n    if (fill_write && fill_pc_q[0]) odd_entries[fill_pc_q[5:1]] <= fill_q;\n    if (reset || fence_accept) begin\n      even_valid_q <= '\"'0;\n      odd_valid_q <= '0;\n      even_hit_q <= 1'b0;\n      odd_hit_q <= 1'b0;\n      replay_staged_q <= 1'b0;\n    end else begin\n      if (fill_write && \"'!fill_pc_q[0]) even_valid_q[fill_pc_q[5:1]] <= 1'\"'b1;\n      if (fill_write && fill_pc_q[0]) odd_valid_q[fill_pc_q[5:1]] <= 1'b1;\n      even_hit_q <= even_valid_q[even_index] && even_word[31:20] == 0 &&\n                    even_entry.tag == even_word[19:8];\n      odd_hit_q <= odd_valid_q[odd_index] && pc_word[31:20] == 0 &&\n                   odd_entry.tag == pc_word[19:8];\n      replay_staged_q <= \"'!(accept_response && predicted_taken) && !(replay_accept && replay_taken);\n    end\n    even_entry_q <= even_entry;\n    odd_entry_q <= odd_entry;\n  end\n\n  assign replay_entry = pc_word[2] ? odd_entry_q : even_entry_q;\n  assign replay_hit = replay_staged_q && (pc_word[2] ? odd_hit_q : even_hit_q);\n  assign replay_accept = !imem_ready && replay_hit && !fence_pending && !reset &&\n                         !full && !recovering && !aperture_wait_q && pc_word != LAST_IMEM_WORD;\n  assign replay_taken = replay_entry.eligible &&\n               