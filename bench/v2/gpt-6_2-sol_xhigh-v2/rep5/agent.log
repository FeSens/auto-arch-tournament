{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r13s2.HRFdpy/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\n\nrtl = Path(__file__).parent / 'rtl'\ncore = rtl / 'core.sv'\ns = core.read_text()\ns = s.replace('  if_stage u_if (','''  logic fence_advance;\n  assign fence_advance = ex_advance && id_ex_w.instr[6:0] == 7'h0f &&\n                         id_ex_w.instr[14:12] == 3'd1;\n\n  if_stage u_if (''')\ns = s.replace('  logic        ex_train,', '  logic        ex_advance;\\\\n  logic        ex_train,')\ns = s.replace('    .train_taken     (mem_train ? mem_taken : ex_taken),','''    .train_taken     (mem_train ? mem_taken : ex_taken),\n    .train_pc        (mem_train ? ex_mem_w.pc : id_ex_w.pc),\n    .train_target    (mem_train ? ex_mem_w.branch_target : id_ex_w.direct_target),\n    .fence_advance   (fence_advance),''')\ns = s.replace('    .advance_aperture (advance_aperture),\\\\n    .redirect', '    .advance_aperture (advance_aperture),\\\\n    .advance         (ex_advance),\\\\n    .redirect')\ncore.write_text(s)\nex = rtl / 'ex_stage.sv'\ns = ex.read_text()\ns = s.replace('  output logic               advance_aperture,','  output logic               advance_aperture,\\\\n  output logic               advance,')\ns = s.replace('  logic advance;\\\\n', '')\nex.write_text(s)\nif_file = rtl / 'if_stage.sv'\ns = if_file.read_text()\ns = s.replace('  input  logic              train_taken,', '''  input  logic              train_taken,\n  input  logic [31:0]       train_pc,\n  input  logic [31:0]       train_target,\n  input  logic              fence_advance,''')\ns = s.replace('  logic sequential_select_q,', '''  logic [19:2] replay_prediction_q;\n  logic replay_select_q;\n  logic sequential_select_q,''')\ns = s.replace('  logic [5:0]  prediction_index;', '''  logic [5:0]  prediction_index;\n  logic accept_replay, replay_taken;\n  logic [17:0] replay_target;''')\ns = s.replace('assign advance_request = resume_fetch || (accept_response && \"'!hold_last_word);'\"',\n              'assign advance_request = resume_fetch || (accept_response && \"'!hold_last_word) || accept_replay;'\"')\ns = s.replace('                 | ({30{retry_select_q && \"'!recovering}} & retry_q);'\"','''                 | ({30{replay_select_q && \"'!recovering}} & {12'\"'b0, replay_prediction_q})\n                 | ({30{retry_select_q && \"'!recovering}} & retry_q);'\"''')\ns = s.replace('    sequential_select_q <= \"'!reset && advance_request && (resume_fetch || !predicted_taken);'\"\\\\n    predicted_select_q <= \"'!reset && advance_request && !resume_fetch && predicted_taken;'\"', '''    replay_prediction_q <= replay_target;\n    replay_select_q <= \"'!reset && accept_replay && replay_taken;\n    sequential_select_q <= !reset && advance_request &&\n                           (resume_fetch || !(predicted_taken || (accept_replay && replay_taken)));\n    predicted_select_q <= !reset && accept_response && !hold_last_word && predicted_taken;'\"''')\ns = s[:s.index('  // The low bits address storage.')] + '''  typedef struct packed {\n    logic [6:0] address;\n    logic taken;\n    logic [5:0] index;\n  } packet_ref_t;\n\n  packet_ref_t refs [0:7];\n  packet_ref_t head_q, published_ref;\n  logic [3:0] read_ptr_q, write_ptr_q, next_read_ptr;\n  logic empty, full, push, publish;\n  logic [7:0] resident_refs_q, resident_refs_next;\n  logic [6:0] write_address;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [\"'$bits(response)-1:0] payload [0:71];\n  issue_packet_t resident_payload, write_payload;\n\n  logic [2:0] pending_fences_q;\n  logic accepted_fence;\n  logic train_candidate_q, loop_valid_q;\n  logic [17:0] train_end_q, train_start_q, loop_start_q, loop_end_q;\n  logic fill;\n  logic [5:0] fill_slot;\n  assign fill_slot = pc_word[7:2];\n  assign accepted_fence = accept_response && imem_data[6:0] == 7'\"'h0f &&\n                          imem_data[14:12] == 3'd1;\n\n  always_ff @(posedge clock) begin\n    if (reset) pending_fences_q <= '0;\n    else if (recovering) pending_fences_q <= {2'b0, accepted_fence};\n    else pending_fences_q <= pending_fences_q + {2'b0, accepted_fence} - {2'b0, fence_advance};\n\n    if (reset || accepted_fence) begin\n      train_candidate_q <= 1'b0;\n      loop_valid_q <= 1'b0;\n    end else begin\n      train_candidate_q <= train_branch && train_taken &&\n                           train_pc[31:20] == 12'b0 && train_target[31:20] == 12'b0 &&\n                           train_target[1:0] == 2'b00 && pending_fences_q == '0;\n      if (train_candidate_q && train_start_q < train_end_q &&\n          train_end_q - train_start_q <= 18'd63 && pending_fences_q == '0) begin\n        loop_valid_q <= 1'b1;\n        loop_start_q <= train_start_q;\n        loop_end_q <= train_end_q;\n      end\n    end\n    train_end_q <= train_pc[19:2];\n    train_start_q <= train_target[19:2];\n  end\n\n  assign fill = accept_response && \"'!recovering && pending_fences_q == '\"'0 &&\n                resident_refs_q == '0 && loop_valid_q && pc_word[31:20] == 12'b0 &&\n                pc_word[19:2] >= loop_start_q && pc_word[19:2] <= loop_end_q &&\n                pc_word \"'!= LAST_IMEM_WORD && !accepted_fence && !response.ctrl.is_jalr &&\n                (!(is_jal || is_branch) || (!direct_bit1 && direct_in_range));\n\n  typedef struct packed {\n    logic [11:0] tag;\n    logic [17:0] target;\n    logic branch;\n    logic jal;\n  } lookup_t;\n\n  lookup_t fill_entry;\n  logic [31:0] valid_even_q, valid_odd_q;\n  (* syn_ramstyle = \"distributed_ram\" *) logic [$bits(fill_entry)-1:0] lookup_even [0:31], lookup_odd [0:31];\n  logic [4:0] even_row, odd_row;\n  logic [23:0] even_tag;\n  lookup_t even_entry, odd_entry, even_q, odd_q, replay_entry;\n  logic even_hit_q, odd_hit_q;\n  logic staged_usable_q;\n  logic [23:0] upper_tag;\n  assign upper_tag = pc_word[31:8];\n  assign even_row = pc_word[7:3] + {4'\"'b0, pc_word[2]};\n  assign odd_row = pc_word[7:3];\n  assign even_tag = upper_tag + {23'b0, (&pc_word[7:2])};\n  assign even_entry = lookup_even[even_row];\n  assign odd_entry = lookup_odd[odd_row];\n  assign fill_entry.tag = pc_word[19:8];\n  assign fill_entry.target = direct_word[19:2];\n  assign fill_entry.branch = is_branch;\n  assign fill_entry.jal = is_jal;\n\n  always_ff @(posedge clock) begin\n    if (fill && \"'!fill_slot[0]) lookup_even[fill_slot[5:1]] <= fill_entry;\n    if (fill &&  fill_slot[0]) lookup_odd [fill_slot[5:1]] <= fill_entry;\n    if (reset || accepted_fence) begin\n      valid_even_q <= '\"'0;\n      valid_odd_q <= '0;\n    end else begin\n      if (fill && \"'!fill_slot[0]) valid_even_q[fill_slot[5:1]] <= 1'\"'b1;\n      if (fill &&  fill_slot[0]) valid_odd_q [fill_slot[5:1]] <= 1'b1;\n    end\n\n    even_hit_q <= valid_even_q[even_row] && even_tag == {12'b0, even_entry.tag} &&\n                  \"'!(fill && fill_slot == {even_row, 1'\"'b0});\n    odd_hit_q <= valid_odd_q[odd_row] && upper_tag == {12'b0, odd_entry.tag} &&\n                 \"'!(fill && fill_slot == {odd_row, 1'\"'b1});\n    even_q <= even_entry;\n    odd_q <= odd_entry;\n    staged_usable_q <= \"'!(reset || accepted_fence ||\n                       (accept_response && predicted_taken) || (accept_replay && replay_taken));\n  end\n\n  assign replay_entry = pc_word[2] ? odd_q : even_q;\n  assign replay_target = replay_entry.target;\n  assign replay_taken = replay_entry.jal || (replay_entry.branch && counter_taken);\n  assign accept_replay = !imem_ready && !reset && !recovering && !full &&\n                         !aperture_wait_q && pending_fences_q == '\"'0 &&\n                         staged_usable_q && pc_word \"'!= LAST_IMEM_WORD &&\n                         (pc_word[2] ? odd_hit_q : even_hit_q);\n\n  assign empty = recovering || read_ptr_q == write_ptr_q;\n  assign full = !recovering && write_ptr_q == (read_ptr_q + 4'\"'d4);\n  assign response_valid = imem_ready && (\"'!aperture_wait_q || recovering);\n  assign accept_response = response_valid && !full && !reset;\n  assign issue_candidate = (!empty || response_valid) && !issue_stall && !reset;\n  assign issue = issue_candidate;\n  assign push = accept_response || accept_replay;\n  assign publish = push && !(empty && issue);\n  assign next_read_ptr = (recovering ? write_ptr_q : read_ptr_q) + {3'\"'b0, issue};\n  assign write_address = fill ? {1'b0, fill_slot} : {4'b1000, write_ptr_q[2:0]};\n  assign published_ref.address = accept_replay ? {1'b0, fill_slot} : write_address;\n  assign published_ref.taken = accept_replay ? replay_taken : predicted_taken;\n  assign published_ref.index = prediction_index;\n  assign resident_payload = payload[head_q.address];\n\n  always_comb begin\n    write_payload = response;\n    write_payload.predicted_taken = 1'b0;\n    write_payload.prediction_index = '0;\n    out = empty ? response : resident_payload;\n    if (\"'!empty) begin\n      out.predicted_taken = head_q.taken;\n      out.prediction_index = head_q.index;\n    end\n\n    resident_refs_next = recovering ? '\"'0 : resident_refs_q;\n    if (\"'!empty && issue)\n      resident_refs_next[read_ptr_q[2:0]] = 1'\"'b0;\n    if (publish)\n      resident_refs_next[write_ptr_q[2:0]] = \"'!published_ref.address[6];\n  end\n\n  always_ff @(posedge clock) begin\n    // A transient tail slot is physically free, even at logical capacity.\n    payload[write_address] <= write_payload;\n    if (publish) refs[write_ptr_q[2:0]] <= published_ref;\n    if (publish && next_read_ptr == write_ptr_q)\n      head_q <= published_ref;\n    else if (issue && !empty)\n      head_q <= refs[next_read_ptr[2:0]];\n\n    if (reset) begin\n      read_ptr_q <= '\"'0;\n      write_ptr_q <= '0;\n      resident_refs_q <= '0;\n    end else begin\n      read_ptr_q <= next_read_ptr;\n      if (push) write_ptr_q <= write_ptr_q + 4'd1;\n      resident_refs_q <= resident_refs_next;\n    end\n  end\nendmodule\n'''\n# The current even/odd pair must also be discarded when a hold at the aperture\n# is released. Nothing ever fills the last word or any PC above the aperture.\nif_file.write_text(s)\nPY\npython \\\"\"'$TMPDIR/bench-r13s2.HRFdpy/prototype.py\"\nNRET=1 RTL_DIR=\"$TMPDIR/bench-r13s2.HRFdpy/rtl\" OBJ_DIR=\"$TMPDIR/bench-r13s2.HRFdpy/obj\" bash test/cosim/build.sh > \"$TMPDIR/bench-r13s2.HRFdpy/build.log\" 2>&1\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
