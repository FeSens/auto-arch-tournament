{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/direction/cores/bench\\\"\ncp -r cores/bench/rtl \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/direction/cores/bench/\\\"\ncp cores/bench/core.yaml \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/direction/cores/bench/\\\"\ncp -r fpga \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/direction/\\\"\ncat > \\\"/srv/hwebench/tmp/7c172beb/fd187293/bench-predictor-aCABne/direction.py\\\" <<'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\ndef patch(name, *pairs):\n    path = rtl / name\n    source = path.read_text()\n    for old,new in pairs:\n        assert old in source, (name,old)\n        source = source.replace(old,new,1)\n    path.write_text(source)\n\npatch('core_pkg.sv',('    logic [31:0] pc;','    logic        predicted_taken;\\\\n    logic [5:0]  branch_index;\\\\n    logic [31:0] direct_target;\\\\n    logic [31:0] pc;'),\n      ('  // ID/EX register payload.\\\\n  typedef struct packed {','  // ID/EX register payload.\\\\n  typedef struct packed {\\\\n    logic        predicted_taken;\\\\n    logic [5:0]  branch_index;\\\\n    logic [31:0] direct_target;'))\npatch('if_stage.sv',\n      ('  output logic [31:0]       imem_addr,','''  input  logic              train_branch,\n  input  logic [5:0]        train_index,\n  input  logic              train_taken,\n  output logic [31:0]       imem_addr,'''),\n      ('''  always_comb begin\n    next_pc = redirect ? redirect_target : pc + 32'd4;\n  end''','''  logic [1:0] counters [0:63];\n  logic [1:0] history_q;\n  logic       train_valid_q, train_taken_q;\n  logic [5:0] train_index_q;\n  logic [1:0] old_counter;\n  logic [5:0] branch_index;\n  logic       conditional, direct_jump, take_prediction;\n  logic [29:0] offset_words, target_words;\n  logic        offset_halfword;\n  logic [31:0] direct_target;\n\n  assign conditional = imem_data[6:0] == 7'b1100011 &&\n                       imem_data[14:13] \"'!= 2'\"'b01;\n  assign direct_jump = imem_data[6:0] == 7'b1101111;\n  assign offset_words = direct_jump\n      ? {{12{imem_data[31]}}, imem_data[19:12], imem_data[20], imem_data[30:22]}\n      : {{20{imem_data[31]}}, imem_data[7], imem_data[30:25], imem_data[11:9]};\n  assign offset_halfword = direct_jump ? imem_data[21] : imem_data[8];\n  assign target_words = pc[31:2] + offset_words;\n  assign direct_target = {target_words, offset_halfword, 1'b0};\n\n  assign branch_index = pc[7:2] \"'^ {4'\"'b0, history_q};\n  assign take_prediction = (direct_jump || (conditional && counters[branch_index][1]))\n                           && \"'!offset_halfword && target_words[29:18] == 12'\"'b0;\n  assign next_pc = take_prediction ? direct_target : (pc + 32'd4);\n  assign old_counter = counters[train_index_q];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      history_q <= '0;\n      train_valid_q <= 1'b0;\n      train_taken_q <= 1'b0;\n      train_index_q <= '0;\n      for (int i = 0; i < 64; i++) counters[i] <= 2'b01;\n    end else begin\n      train_valid_q <= train_branch;\n      if (train_branch) begin\n        history_q <= {history_q[0], train_taken};\n        train_index_q <= train_index;\n        train_taken_q <= train_taken;\n      end\n      if (train_valid_q) begin\n        if (train_taken_q)\n          counters[train_index_q] <= old_counter == 2'b11 ? old_counter : old_counter + 2'b01;\n        else\n          counters[train_index_q] <= old_counter == 2'b00 ? old_counter : old_counter - 2'b01;\n      end\n    end\n  end'''),\n      ('    out.pc    = pc;','    out.predicted_taken = take_prediction;\\\\n    out.branch_index    = branch_index;\\\\n    out.direct_target   = direct_target;\\\\n    out.pc    = pc;'))\npatch('id_stage.sv', ('      reg_q.pc       <= in.pc;',\n      '      reg_q.predicted_taken <= in.predicted_taken;\\\