efix_result[7:4]')\npath.write_text(s)\nPY\ncat > '/srv/hwebench/tmp/7c172beb/26de4279/radix16.GwU4WK/timing.py' <<'PY'\nimport sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path(__file__).parent\nvariant = sys.argv[1]\nresults = build_all(root, root / variant, \\\"fpga/core_bench_si.sv\\\", root / (variant + \\\"-timing\\\"))\nprint(summarize(results))\nfor result in results:\n    print(result.get(\\\"place_option\\\"), result.get(\\\"fmax_mhz\\\"), result.get(\\\"reason\\\"))\n    for path in (result.get(\\\"critical_paths\\\") or [])[:4]:\n        print(path)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python '\"'/srv/hwebench/tmp/7c172beb/26de4279/radix16.GwU4WK/timing.py' rtl_prefix_lut\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
