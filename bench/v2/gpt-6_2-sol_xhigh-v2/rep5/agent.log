(Vcore* top, bool in_window) {\n        auto const& s = *top->rootp;\n        const unsigned pc = top->io_imemAddr;\n        const unsigned instr = top->io_imemData;\n        const unsigned opcode = instr & 127;\n        const bool ready = top->io_imemReady;\n        const bool recovery = s.core__DOT__probe_recovering;\n        const bool full = s.core__DOT__probe_queue_full;\n        const bool accept = s.core__DOT__probe_accept_live;\n        const bool issue = s.core__DOT__probe_issue_live;\n\n        if (recovery) queue.clear();\n        assert(queue.empty() == bool(s.core__DOT__probe_queue_empty));\n        assert((queue.size() == 4) == full);\n        if (in_window && \"'!ready && !full && !recovery && !s.core__DOT__probe_aperture_wait) {\n            ++opportunities;\n            for (const Lookup& candidate : staged) {\n                if (!last_taken && candidate.pc == pc) {\n                    pinned_hits += candidate.pinned_hit;\n                    unpinned_hits += candidate.unpinned_hit;\n                }\n            }\n        }\n        const bool control = opcode == 0x63 || opcode == 0x6f;\n        const bool fence = opcode == 0x0f && ((instr >> 12) & 7) == 1;\n        const bool eligible = accept && pc >= begin && pc <= end && pc != 0xffffc &&\n                              opcode != 0x67 && !fence &&\n                              (!control || s.core__DOT__probe_target_ok);\n        const int index = (pc >> 2) & 63;\n        const bool pinned = std::find(queue.begin(), queue.end(), index) != queue.end();\n        const bool fill = eligible && !pinned;\n        if (in_window && eligible) {\n            ++eligible_fills;\n            if (pinned) {\n                assert(pinned_tags[index] != UINT32_MAX);\n                if (pinned_tags[index] == pc) ++redundant_fills;\n                else ++alias_conflicts;\n            }\n        }\n        for (unsigned i = 0; i < staged.size(); ++i) {\n            const unsigned lookup_pc = pc + 4*i;\n      