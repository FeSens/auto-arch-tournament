{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c 'set -e\naddr_dir=$(mktemp -d \"${TMPDIR:-/tmp}/bench-r5-address-redirect.XXXXXX\")\ngit archive HEAD | tar -x -C \"$addr_dir\"\ncp \"/srv/hwebench/tmp/7c172beb/0a012b02/bench-r5-address.ouAuKR\"/cores/bench/rtl/*.sv \"$addr_dir/cores/bench/rtl/\"\npython - \"$addr_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1]) / 'cores/bench/rtl'\n\nex = rtl / 'ex_stage.sv'\nsrc = ex.read_text()\nsrc = src.replace(\\\"\\\"\\\"  assign redirect       = advance && (resolved_taken \"'!= in.predicted_taken);\n  assign redirect_word  = pc_next[31:2];\n  assign train_branch   = advance && in.ctrl.is_branch;\"\"\", \"\"\"  assign redirect       = in.valid && !stall && (resolved_taken != in.predicted_taken);\n  // A mismatch implies that the correct direction is the inverse of the\n  // prediction. Select the recovery address without waiting for the compare.\n  assign redirect_word  = ({30{in.predicted_taken}} & pc_plus_4[31:2])\n                        | ({30{!in.predicted_taken && in.ctrl.is_jalr}} & address_sum[31:2])\n                        | ({30{!in.predicted_taken && !in.ctrl.is_jalr}} & in.direct_target[31:2]);\n  assign train_branch   = in.valid && !stall && in.ctrl.is_branch;\"\"\")\nex.write_text(src)\n\nid_s = rtl / '\"'id_stage.sv'\nsrc = id_s.read_text()\nsrc = src.replace(\\\"\\\"\\\"    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (\"'!stall) begin\"\"\", \"\"\"    if (reset || flush)\n      reg_q.valid <= 1'\"'b0;\n    else if (\"'!stall)\n      reg_q.valid <= in.valid;\n\n    if (!stall) begin\"\"\")\nsrc = src.replace(\"      reg_q.valid            <= in.valid;'\"\\\\n\\\", \\\"\\\")\nid_s.write_text(src)\nPY\nprintf '%s\\\\n' \\\"\"'$addr_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
