{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport shutil\nimport subprocess\n\nfrom tools.eval import gowin\nfrom tools.eval.fpga import _bench_sv\n\nworktree = Path.cwd()\nrtl = worktree / \\\"cores/bench/rtl\\\"\nsource = (rtl / \\\"divider.sv\\\").read_text()\nrepo = \\\"/srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep5/cores/bench/worktrees/hyp-20261122-001-r6s0\\\"\noriginal = subprocess.check_output(\n    [\\\"git\\\", \\\"-C\\\", repo, \\\"show\\\", \\\"HEAD:cores/bench/rtl/divider.sv\\\"], text=True\n)\nshared_borrow = source.replace(\n    \\\"    logic [31:0] difference;\\\",\n    \\\"    logic [31:0] difference;\\\\n    logic [8:0] low_byte;\\\",\n).replace(\n    \\\"      borrow_generate[0] = x[7:0] < y[7:0];\\\\n\\\"\n    \\\"      difference[7:0]    = x[7:0] - y[7:0];\\\",\n    \\\"      low_byte = {1'b0, x[7:0]} - {1'b0, y[7:0]};\\\\n\\\"\n    \\\"      {borrow_generate[0], difference[7:0]} = low_byte;\\\",\n).replace(\n    \\\"        borrow_generate[i]  = x[8*i +: 8] < y[8*i +: 8];\\\",\n    \\\"        {borrow_generate[i], diff_no_borrow[8*i +: 8]} =\\\\n\\\"\n    \\\"          {1'b0, x[8*i +: 8]} - {1'b0, y[8*i +: 8]};\\\",\n).replace(\n    \\\"        diff_no_borrow[8*i +: 8]   = x[8*i +: 8] - y[8*i +: 8];\\\\n\\\",\n    \\\"\\\",\n)\nnibble_compare = source.replace(\n    \\\"  // Return the terminal borrow\\\",\n    \\\"\\\"\\\"  function automatic logic byte_borrow (\n    input logic [7:0] x, y\n  );\n    byte_borrow = (x[7:4] < y[7:4]) |\n                  ((x[7:4] == y[7:4]) & (x[3:0] < y[3:0]));\n  endfunction\n\n  // Return the terminal borrow\\\"\\\"\\\",\n).replace(\\\"x[7:0] < y[7:0]\\\", \\\"byte_borrow(x[7:0], y[7:0])\\\").replace(\n    \\\"x[8*i +: 8] < y[8*i +: 8]\\\", \\\"byte_borrow(x[8*i +: 8], y[8*i +: 8])\\\"\n)\nbegin = source.index(\\\"      borrow_in[1] = borrow_generate[0];\\\")\nend = source.index(\\\"\\\\n\\\\n      for\\\", begin)\nshort_carry = (\n    source[:begin] + \\\"\\\"\\\"      // Each slice occupies one bit of the group carry path.\n      group_propagate = {borrow_propagate, 1'b0};\n      group_sum = {1'b0, borrow_generate}\n                + {1'b0, borrow_generate | group_propagate};\n      borrow_in = group_sum[3:1] \"'^ group_propagate[3:1];\n      borrow_out = group_sum[5];\"\"\" + source[end:]\n).replace(\n    \"    logic [31:0] difference;\",\n    \"    logic [31:0] difference;'\"\\\\n\\\"\n    \\\"    logic [4:0] group_propagate;\\\\n\\\"\n    \\\"    logic [5:0] group_sum;\\\",\n)\npair_compare = source[:begin] + source[begin:end].split(\\\"      borrow_out\\\")[0] + \\\"\\\"\\\"\n      borrow_out = (borrow_generate[4] | (borrow_propagate[4] & borrow_generate[3]))\n                 | ((&borrow_propagate[4:3]) & borrow_in[3]);\\\"\\\"\\\" + source[end:]\n\ndef build_variant(name, design):\n    paths = worktree / \\\"cores/bench/generated/variants\\\" / name\n    shutil.copytree(rtl, paths / \\\"rtl\\\", dirs_exist_ok=True)\n    (paths / \\\"rtl/divider.sv\\\").write_text(design)\n    result = gowin.build(worktree, paths / \\\"rtl\\\", _bench_sv(str(worktree), \\\"bench\\\"),\n                         0, paths / \\\"gowin_p0\\\")\n    return name, {k: v for k, v in result.items() if k \"'!= \"critical_paths\"}, (\n        result.get(\"critical_paths\") or [None]\n    )[0]\n\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    futures = [pool.submit(build_variant, name, design) for name, design in {\n        \"original\": original, \"shared_borrow\": shared_borrow,\n        \"nibble_compare\": nibble_compare, \"short_carry\": short_carry,\n        \"pair_compare\": pair_compare,\n    }.items()]\n    for future in as_completed(futures):\n        print(*future.result(), flush=True)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
