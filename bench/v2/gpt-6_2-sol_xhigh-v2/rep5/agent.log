assert imem_attempts[:7] == [4, 8, 12, 24, 28, 28, 28]\n    assert [r[\"pc\"] for r in rets] == list(program)\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    _, _, older, jump, target, _ = rets\n    assert (jump[\"pc_next\"], jump[\"rd_wdata\"]) == (24, 16)\n    assert target[\"rd_wdata\"] == 7\n    assert jump[\"cycle\"] - older[\"cycle\"] == target[\"cycle\"] - jump[\"cycle\"] == 1\n\n\ndef test_pipeline_runner():'\"''')\np.write_text(s)\nPY\ncd \\\"\"'$scratch/queue2-formal\"\npytest -q cores/bench/test > \"$scratch/queue2-tests.log\" 2>&1\ntail -70 \"$scratch/queue2-tests.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
