{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/r15-profile/head_rtl\"\ncp cores/bench/rtl/*.sv \"$TMPDIR/r15-profile/head_rtl/\"\npython3 - \"$TMPDIR/r15-profile/head_rtl/if_stage.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\npath=Path(sys.argv[1])\ndata=path.read_text()\ni=data.index('  // The low bits address storage')\ndata=data[:i]+'''  // The logical head is physically fixed. Each cell has its own valid\n  // bit and shifts toward the head only when an occupied entry issues.\n  issue_packet_t fifo_q [0:3];\n  logic [3:0] occupied_q, remaining, insertion;\n  logic empty, full, pop_head, store_response;\n\n  assign empty = recovering || \"'!occupied_q[0];\n  assign full  = !recovering && occupied_q[3];\n  assign response_valid = imem_ready && (!aperture_wait_q || recovering);\n  assign accept_response = response_valid && !full && !reset;\n  assign out = empty ? response : fifo_q[0];\n  assign issue_candidate = (!empty || response_valid) && !issue_stall && !reset;\n  assign issue = issue_candidate;\n\n  assign pop_head = issue && !empty;\n  assign store_response = accept_response && (!issue || !empty);\n  assign remaining = recovering ? 4'\"'b0 : pop_head ? occupied_q >> 1 : occupied_q;\n  assign insertion = {remaining[2:0], 1'b1} & ~remaining;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      occupied_q <= 4'b0;\n    else\n      occupied_q <= remaining | (store_response ? insertion : 4'b0);\n  end\n\n  for (genvar i = 0; i < 4; ++i) begin : gen_fifo\n    if (i < 3) begin : gen_shift\n      always_ff @(posedge clock) begin\n        if (store_response && insertion[i])\n          fifo_q[i] <= response;\n        else if (pop_head && occupied_q[i+1])\n          fifo_q[i] <= fifo_q[i+1];\n      end\n    end else begin : gen_tail\n      always_ff @(posedge clock) begin\n        if (store_response && insertion[i])\n          fifo_q[i] <= response;\n      end\n    end\n  end\n\nendmodule\n'''\npath.write_text(data)\nPY\npython3 - \\\"\"'$TMPDIR/r15-profile/head_rtl\" \"$TMPDIR/r15-profile/head_timing\" <<'\"'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nimport sys\nr=build_all(Path.cwd(),sys.argv[1],'fpga/core_bench_si.sv',sys.argv[2])\nfor v in r:\n  print(v.get('fmax_mhz'), v.get('reason'), v.get('critical_paths',[])[:3])\nprint(summarize(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
