{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"ls -lh cores/bench/generated/timing/gowin_p1/impl/gwsynthesis/core_bench.vg\nsed -n '1,120p' cores/bench/rtl/alu.sv\nsed -n '15,45p' cores/bench/rtl/forward_unit.sv\"","aggregated_output":"-rw-rw----+ 1 hwebench hwebench 1.6M Nov 22 19:42 cores/bench/generated/timing/gowin_p1/impl/gwsynthesis/core_bench.vg\n// rtl/alu.sv\n//\n// Combinational ALU for RV32I.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata through EX/MEM and MEM/WB.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n\nmodule alu #(\n  parameter bit REGISTERED_SELECT = 1'b0,\n  parameter bit SEPARATE_ADD_OPERAND = 1'b0\n) (\n  input  logic [4:0]  op,\n  input  alu_select_t selects,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  input  logic [31:0] add_b,\n  output logic [31:0] out\n);\n\n  alu_select_t sel;\n  logic [31:0] shift_right, sum;\n  logic [31:0] arithmetic, bitwise, shift, other;\n\n  assign sel = REGISTERED_SELECT ? selects : decode_alu(op);\n  assign sum = a + (SEPARATE_ADD_OPERAND ? add_b : b);\n  assign shift_right = 32'($signed({sel.sra && a[31], a}) >>> b[4:0]);\n  // Join the carry-chain results at the final merge.\n  assign arithmetic = ({32{sel.add}} & sum) | ({32{sel.sub}} & (a - b));\n  assign bitwise = ({32{sel.and_op}} & (a & b))\n                 | ({32{sel.or_op}} & (a | b))\n                 | ({32{sel.xor_op}} & (a ^ b));\n  assign shift = ({32{sel.sll}} & (a << b[4:0]))\n               | ({32{sel.srl || sel.sra}} & shift_right);\n  assign other = ({32{sel.lui}} & b)\n               | {31'b0, (sel.slt && $signed(a) < $signed(b)) || (sel.sltu && a < b)};\n  assign out = ((bitwise | shift) | other) | arithmetic;\n\nendmodule\n  output operand_sel_t rs2_sel\n);\n\n  logic ex_writes_rd, mem_writes_rd;\n\n  assign ex_writes_rd  = ex_fast_write && ex_rd != 5'b0;\n  assign mem_writes_rd = mem_write && mem_rd != 5'b0;\n\n  function automatic operand_sel_t select_operand (\n    input logic [4:0] addr\n  );\n    operand_sel_t sel;\n\n    // The EX pair takes priority. For x0 neither producer matches, so\n    // the operand comes from the register file's hardwired zero.\n    sel.ex_pair = ex_writes_rd && ex_rd == addr;\n    sel.pair_member = sel.ex_pair ? ex_fast_addi : (mem_writes_rd && mem_rd == addr);\n    select_operand = sel;\n  endfunction\n\n  always_comb begin\n    rs1_sel = select_operand(rs1_addr);\n    rs2_sel = select_operand(rs2_addr);\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
