{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -c \"git diff --check && git diff --numstat && git ls-files --others --exclude-standard && sed -n '1,115p' cores/bench/rtl/multiplier.sv\"","aggregated_output":"2\t39\tcores/bench/rtl/alu.sv\n5\t5\tcores/bench/rtl/core.sv\n46\t18\tcores/bench/rtl/ex_stage.sv\n4\t4\tcores/bench/rtl/hazard_unit.sv\n1\t35\tcores/bench/test/test_alu.py\n43\t2\tcores/bench/test/test_pipeline.py\ncores/bench/rtl/multiplier.sv\ncores/bench/test/test_multiplier.py\n// Shared two-cycle RV32M multiplier. Launch registers the limb products.\n// The accumulated result is valid the following cycle and holds until accepted.\nmodule multiplier (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        launch,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        result_valid,\n  output logic [31:0] result\n);\n\n  logic starting;\n  assign starting = launch && !result_valid;\n\n  always_ff @(posedge clock) begin\n    if (reset)         result_valid <= 1'b0;\n    else if (starting) result_valid <= 1'b1;\n    else if (accept)   result_valid <= 1'b0;\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  // Match the riscv-formal instruction models with the same handshake.\n  logic [31:0] alt_result;\n\n  always_comb begin\n    case (op)\n      ALU_MUL:    alt_result = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   alt_result = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  alt_result = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: alt_result = (a - b) ^ 32'hecfbe137;\n      default:    alt_result = '0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (starting) result <= alt_result;\n  end\n`else\n  logic signed [16:0] a_low, a_high, b_low, b_high;\n  logic        [31:0] low_low_q, high_high_q;\n  logic signed [32:0] low_high_q, high_low_q;\n  logic               select_high_q;\n\n  assign a_low  = $signed({1'b0, a[15:0]});\n  assign b_low  = $signed({1'b0, b[15:0]});\n  assign a_high = $signed({(op == ALU_MULH || op == ALU_MULHSU) && a[31], a[31:16]});\n  assign b_high = $signed({(op == ALU_MULH) && b[31], b[31:16]});\n\n  // Reset only the handshake. The datapath is overwritten at each launch.\n  always_ff @(posedge clock) begin\n    if (starting) begin\n      low_low_q     <= a_low  * b_low;\n      low_high_q    <= a_low  * b_high;\n      high_low_q    <= a_high * b_low;\n      high_high_q   <= a_high * b_high;\n      select_high_q <= op != ALU_MUL;\n    end\n  end\n\n  logic [47:0] low_low_upper, low_high, high_low, high_high;\n  logic [47:0] sum1, carry1, sum2, carry2, product_upper;\n\n  // Work in units of 2^16. The unshifted bottom 16 bits come from low_low_q.\n  assign low_low_upper = {32'b0, low_low_q[31:16]};\n  assign low_high      = {{15{low_high_q[32]}}, low_high_q};\n  assign high_low      = {{15{high_low_q[32]}}, high_low_q};\n  assign high_high     = {high_high_q, 16'b0};\n\n  assign sum1  = low_low_upper ^ low_high ^ high_low;\n  assign carry1 = ((low_low_upper & low_high) | (low_low_upper & high_low)\n                 | (low_high & high_low)) << 1;\n  assign sum2  = sum1 ^ carry1 ^ high_high;\n  assign carry2 = ((sum1 & carry1) | (sum1 & high_high) | (carry1 & high_high)) << 1;\n  assign product_upper = sum2 + carry2;\n\n  assign result = select_high_q ? product_upper[47:16]\n                                : {product_upper[15:0], low_low_q[15:0]};\n`endif\n\nendmodule\n","exit_code":0,"status":"completed"}}
