{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/7c172beb/b8ba2d87/bench-r5s1-ejhir1la/prepare_issue.py' <<'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch = Path(__file__).parent\nsource = Path.cwd()\nfor variant in ('issue', 'issue_match', 'issue_agu', 'baseline'):\n    trial = scratch / variant\n    rtl = trial / 'cores/bench/rtl'\n    rtl.parent.mkdir(parents=True)\n    base_rtl = scratch / 'cores/bench/rtl' if variant == 'issue_agu' else source / 'cores/bench/rtl'\n    shutil.copytree(base_rtl, rtl)\n    shutil.copy(source / 'cores/bench/core.yaml', rtl.parent)\n    (trial / 'fpga').symlink_to(source / 'fpga')\n    (trial / 'bench').symlink_to(scratch / 'bench')\n    if variant == 'baseline':\n        continue\n    matches_only = variant == 'issue_match'\n\n    def replace(filename, old, new):\n        path = rtl / filename\n        text = path.read_text()\n        assert text.count(old) == 1, (filename, old, text.count(old))\n        path.write_text(text.replace(old, new))\n\n    mask = '[1:0]' if matches_only else '[2:0]'\n    replace('core_pkg.sv', '    logic [31:0] rs1_val;', f'    logic {mask}  rs1_select;\\\\n    logic {mask}  rs2_select;\\\\n    logic [31:0] rs1_val;')\n    replace('if_stage.sv', \\\"imem_ready ? imem_data : 32'h0000_0013\\\", 'imem_data')\n    replace('id_stage.sv', '  // ID/EX register output', f'  input logic {mask} rs1_select, rs2_select,\\\\n  // ID/EX register output')\n    replace('id_stage.sv', \\\"\\\"\\\"    if (reset || flush) begin\n      reg_q <= '0;\n    end else if (\"'!stall) begin\"\"\", \"\"\"    if (reset || flush)\n      reg_q.valid <= 1'\"'b0;\n    else if (\"'!stall)\n      reg_q.valid <= in.valid;\n\n    if (!stall) begin\"\"\")\n    replace('\"'id_stage.sv', '      reg_q.valid            <= in.valid;', '      reg_q.rs1_select       <= rs1_select;\\\\n      reg_q.rs2_select       <= rs2_select;')\n    result = '''  // Operand tags are compared in ID. The selection advances with the consumer.\n  logic [31:0] rs1, rs2;\n  logic [2:0] rs1_select, rs2_select;\n'''\n    if matches_only:\n        result += '''\n  assign rs1_select[1] = in.rs1_select[0] && ex_fast_write;\n  assign rs1_select[2] = in.rs1_select[1] && mem_wb_forward_write && \"'!rs1_select[1];\n  assign rs1_select[0] = !(rs1_select[1] || rs1_select[2]);\n  assign rs2_select[1] = in.rs2_select[0] && ex_fast_write;\n  assign rs2_select[2] = in.rs2_select[1] && mem_wb_forward_write && !rs2_select[1];\n  assign rs2_select[0] = !(rs2_select[1] || rs2_select[2]);\n'\"'''\n    else:\n        result += '''\n  assign rs1_select = in.rs1_select;\n  assign rs2_select = in.rs2_select;\n'''\n    result += '''\n  assign rs1 = ({32{rs1_select[0]}} & in.rs1_val)\n             | ({32{rs1_select[1]}} & fwd_ex_mem)\n             | ({32{rs1_select[2]}} & fwd_mem_wb);\n  assign rs2 = ({32{rs2_select[0]}} & in.rs2_val)\n             | ({32{rs2_select[1]}} & fwd_ex_mem)\n             | ({32{rs2_select[2]}} & fwd_mem_wb);\n\n'''\n    p = rtl / 'ex_stage.sv'\n    text = p.read_text()\n    a = text.index('  // ── Operand forwarding muxes')\n    b = text.index('  // ── ALU operand selection', a)\n    p.write_text(text[:a] + result + text[b:])\n\n    if matches_only:\n        replace('ex_stage.sv', '  input  logic [1:0]         fwd_rs1_sel,\\\\n  input  logic [1:0]         fwd_rs2_sel,', '  input  logic               ex_fast_write,\\\\n  input  logic               mem_wb_forward_write,')\n        replace('core.sv', '  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', '  logic [1:0] id_rs1_select, id_rs2_select;')\n        replace('core.sv', '    .fwd_rs1_sel     (fwd_rs1_sel),\\\\n    .fwd_rs2_sel     (fwd_rs2_sel),', '    .ex_fast_write   (ex_mem_w.forward_write),\\\\n    .mem_wb_forward_write (mem_wb_w.ctrl.reg_write),')\n    else:\n        replace('ex_stage.sv', '  input  logic [1:0]         fwd_rs1_sel,\\\\n  input  logic [1:0]         fwd_rs2_sel,', '  output logic               ex_fast_write,')\n        replace('ex_stage.sv', \\\"  logic [31:0] ex_result;\\\", \\\"\\\"\\\"  assign ex_fast_write = in.valid && in.ctrl.reg_write &&\n                         \"'!(transfer_taken && target[1]) &&\n                         !(in.ctrl.mem_read || in.ctrl.is_mul || in.ctrl.is_div);\n\n  logic [31:0] ex_result;\"\"\")\n        replace('\"'ex_stage.sv', '''      reg_q.forward_write <= in.valid && ctrl_with_trap.reg_write &&\n                             \"'!(in.ctrl.mem_read || in.ctrl.is_mul || in.ctrl.is_div);'\"''', '      reg_q.forward_write <= ex_fast_write;')\n        replace('mem_stage.sv', '  // MEM/WB register output', '  output logic               mem_next_write,\\\\n  // MEM/WB register output')\n        replace('mem_stage.sv', '  logic [31:0] wb_result;', '  assign mem_next_write = ctrl_with_trap.reg_write;\\\\n\\\\n  logic [31:0] wb_result;')\n        replace('core.sv', '  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', '  logic [2:0] id_rs1_select, id_rs2_select;\\\\n  logic ex_fast_write, mem_next_write;')\n        replace('core.sv', '    .fwd_rs1_sel     (fwd_rs1_sel),\\\\n    .fwd_rs2_sel     (fwd_rs2_sel),', '    .ex_fast_write   (ex_fast_write),')\n        replace('core.sv', '    .hold_wb    (hold_mem_wb),', '    .hold_wb    (hold_mem_wb),\\\\n    .mem_next_write (mem_next_write),')\n    replace('core.sv', '    .rs2_data (rs2_data_w),\\\\n    .out      (id_ex_w)', '    .rs2_data (rs2_data_w),\\\\n    .rs1_select (id_rs1_select),\\\\n    .rs2_select (id_rs2_select),\\\\n    .out      (id_ex_w)')\n    p = rtl / 'core.sv'\n    text = p.read_text()\n    a = text.index('  forward_unit u_fwd')\n    b = text.index('  // ── RVFI', a)\n    text = text[:a] + '''  logic ex_rs1, ex_rs2, mem_rs1, mem_rs2;\n\n  assign ex_rs1 = rs1_addr_w \"'!= 5'\"'b0 && id_ex_w.rd == rs1_addr_w;\n  assign ex_rs2 = rs2_addr_w \"'!= 5'\"'b0 && id_ex_w.rd == rs2_addr_w;\n  assign mem_rs1 = rs1_addr_w \"'!= 5'\"'b0 && ex_mem_w.rd == rs1_addr_w;\n  assign mem_rs2 = rs2_addr_w \"'!= 5'\"'b0 && ex_mem_w.rd == rs2_addr_w;\n\n''' + text[b:]\n    if matches_only:\n        text = text[:a] + text[a:].replace('  // ── RVFI', '''  assign id_rs1_select = {mem_rs1, ex_rs1};\n  assign id_rs2_select = {mem_rs2, ex_rs2};\n\n  // ── RVFI''', 1)\n    else:\n        text = text[:a] + text[a:].replace('  // ── RVFI', '''  assign id_rs1_select[1] = ex_rs1 && ex_fast_write;\n  assign id_rs1_select[2] = mem_rs1 && mem_next_write && \"'!id_rs1_select[1];\n  assign id_rs1_select[0] = !(id_rs1_select[1] || id_rs1_select[2]);\n  assign id_rs2_select[1] = ex_rs2 && ex_fast_write;\n  assign id_rs2_select[2] = mem_rs2 && mem_next_write && !id_rs2_select[1];\n  assign id_rs2_select[0] = !(id_rs2_select[1] || id_rs2_select[2]);\n\n  // ── RVFI'\"''', 1)\n    p.write_text(text)\nPY\npython '/srv/hwebench/tmp/7c172beb/b8ba2d87/bench-r5s1-ejhir1la/prepare_issue.py'\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
