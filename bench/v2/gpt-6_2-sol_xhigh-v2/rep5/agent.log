{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'bench_probe_dir=/srv/hwebench/tmp/7c172beb/a589e53d/bench-structural.uNuQOA\nmkdir -p \"$bench_probe_dir/banks_rtl\"\ncp cores/bench/rtl/*.sv \"$bench_probe_dir/banks_rtl/\"\npython3 - \"$bench_probe_dir/banks_rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\ndef edit(name, *pairs):\n    f = rtl / f'{name}.sv'\n    s = f.read_text()\n    for old, new in pairs:\n        assert old in s, (name, old)\n        s = s.replace(old, new)\n    f.write_text(s)\nedit('core_pkg', ('    logic [31:0] alu_result;', '''    logic [31:0] sum_result;\n    logic [31:0] sub_result;\n    logic [31:0] misc_result;\n    logic [31:0] link_result;\n    logic [3:0] result_lanes;'''))\nedit('alu', ('module alu (', \\\"module alu #(parameter bit MISC_ONLY = 1'b0) (\\\"), ('out = a + b;', \\\"out = MISC_ONLY ? '0 : a + b;\\\"), ('out = a - b;', \\\"out = MISC_ONLY ? '0 : a - b;\\\"))\nedit('ex_stage', ('alu u_alu', \\\"alu #(.MISC_ONLY(1'b1)) u_alu\\\"),\n     ('  logic [31:0] ex_result;\\\\n  assign ex_result = in.ctrl.is_jump ? pc_plus_4 : alu_result;', '''  logic [3:0] result_lanes;\n  assign result_lanes[0] = in.ctrl.is_jump;\n  assign result_lanes[1] = \"'!in.ctrl.is_jump && in.ctrl.alu_op == ALU_ADD;\n  assign result_lanes[2] = !in.ctrl.is_jump && in.ctrl.alu_op == ALU_SUB;\n  assign result_lanes[3] = !in.ctrl.is_jump && in.ctrl.alu_op != ALU_ADD && in.ctrl.alu_op != ALU_SUB;'\"'''),\n     ('      reg_q.alu_result    <= ex_result;', '''      reg_q.sum_result    <= alu_a + alu_b;\n      reg_q.sub_result    <= alu_a - alu_b;\n      reg_q.misc_result   <= alu_result;\n      reg_q.link_result   <= pc_plus_4;\n      reg_q.result_lanes  <= result_lanes;'''))\nedit('core', ('  // ── EX ─', '''  logic [31:0] fast_ex_mem_result;\n  assign fast_ex_mem_result = ({32{ex_mem_w.result_lanes[0]}} & ex_mem_w.link_result)\n                            | ({32{ex_mem_w.result_lanes[1