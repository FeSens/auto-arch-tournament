redirect_target_q);\n\n  always_ff @(posedge clock) begin\n    redirect_pending_q <= \"'!reset && redirect;\n    taken_pending_q <= !reset && !redirect && select_taken;\n    use_normal_q <= reset || (!redirect && !select_taken);\n    redirect_target_q <= redirect_word;\n    taken_word_q <= direct_word[19:2];\n\n    if (reset) request_word_q <= '\"'0;\n    else request_word_q <= step_sequential ? pc_word + 30'd1 : pc_word;\n\n\\\"\\\"\\\" + s[end:]\n    return s.replace('predicted_taken  = imem_ready && ', 'predicted_taken  = ')\n\nvariants = {\n    'recovery-only': (defer_flush(plain), False),\n    'parallel-recovery': (defer_flush(parallel.replace('select_redirect_q', 'redirect_pending_q')), False),\n    'two-pc': (two_pc(split), False),\n    'two-pc-compact': (two_pc(split), True),\n    'two-pc-compact-recovery': (defer_flush(two_pc(split)), True),\n    'parallel-compact': (parallel, True),\n}\nfor name, (src, compact) in variants.items():\n    directory = scratch/name\n    shutil.copytree(original, directory, copy_function=shutil.copyfile)\n    (directory/'if_stage.sv').write_text(trim_target(src, directory) if compact else src)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:\n    builds = {pool.submit(build, root, scratch/name, 'fpga/core_bench_si.sv', option, scratch/f'{name}-{option}'): (name, option)\n              for option in (1, 0) for name in variants}\n    for future in concurrent.futures.as_completed(builds):\n        result = future.result()\n        print(builds[future], result.get('fmax_mhz'), result.get('reason'), (result.get('critical_paths') or [None])[0], flush=True)\nPY\"", "aggregated_output": "('recovery-only', 1) 75.687 None {'from': 'cpu/u_ex/u_divider/quotient_q_31_s0', 'to': 'cpu/u_ex/u_divider/remainder_q_0_s0', 'slack_ns': -8.212, 'arrival_ns': 18.507, 'logic_cells': 30, 'modules': ['clock_ibuf', 'cpu/u_ex/u_divider']}\n('two-pc-compact-recovery', 1) 84.321 None {'from': 'cpu/u_ex/u_divider/quotient_q_31_s0', 'to': '