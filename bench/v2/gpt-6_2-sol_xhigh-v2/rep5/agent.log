{"type": "item.started", "item": {"id": "item_60", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p ready_equiv && python3 - <<'PY'\nfrom pathlib import Path\ndst = Path('ready_equiv')\nbase = Path('/srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep5/cores/bench/worktrees/hyp-20261122-003-r10s2-hypgen/cores/bench/rtl')\ncandidate = Path('variant2/cores/bench/rtl')\nfor name, directory in [('gold', base), ('gate', candidate)]:\n    rtl = (directory / 'if_stage.sv').read_text()\n    rtl = rtl.replace('module if_stage (', f'module {name} (')\n    rtl = rtl.replace('    out\\\\n', '''    out,\n  output logic [77:0] match_regs,\n  output logic [127:0] match_counters,\n  output logic [4*\"'$bits(out)-1:0] match_fifo,\n  output logic [2:0] occupancy\n'\"''')\n    assert 'output logic [77:0]' in rtl\n    wait = 'aperture_wait_q' if name == 'gold' else 'aperture_wait'\n    extra = '''\n  assign occupancy = write_ptr_q - read_ptr_q;\n  assign match_regs = {request_word_q, redirect_target_q, redirect_pending_q,\n                       @WAIT@, read_ptr_q, write_ptr_q, history_q,\n                       update_valid_q, update_taken_q, update_index_q};\n\n  for (genvar i = 0; i < 64; i++) begin : expose_counter\n    assign match_counters[2*i+:2] = counters[i];\n  end\n  for (genvar i = 0; i < 4; i++) begin : expose_queue_entry\n    logic [1:0] distance;\n    assign distance = 2'(i) - read_ptr_q[1:0];\n    assign match_fifo[\"'$bits(out)*i+:$bits(out)] =\n        {1'\"'b0, distance} < occupancy ? fifo[i] : '0;\n  end\n\n'''.replace('@WAIT@', wait)\n    (dst / f'{name}.sv').write_text(rtl.replace('endmodule', extra + 'endmodule'))\nPY\ncat > ready_equiv/miter.sv <<'SV'\nmodule ready_equiv (\n  input logic clock, reset, issue_stall, redirect, advance_aperture,\n  input logic train_branch, train_taken,\n  input logic [31:2] redirect_word,\n  input logic [5:0] train_index,\n  input logic [31:0] imem_data,\n  output logic match_state, match_outputs\n);\n  logic [31:0] gold_a