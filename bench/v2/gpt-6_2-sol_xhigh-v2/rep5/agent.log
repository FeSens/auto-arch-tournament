{"type":"item.started","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nfrom tools.eval.gowin import critical_paths\nfor root in [Path('cores/bench/generated/timing'), *(Path(os.environ['TMPDIR'])/tag/'cores/bench/generated/timing' for tag in ('issue-capture.rplEV3', 'issue-fifo.t4MoBI'))]:\n    print(root)\n    for t in sorted(root.glob('gowin_p*/impl/pnr/core_bench.tr')):\n        paths=critical_paths(t.read_text(),25)\n        print(t.parts[-4])\n        for name, predicate in {\n            'recurrence': lambda a,b: 'u_id/reg_q.' in b and any(x in a for x in ('u_mem/reg_q.result','u_id/reg_q.')),\n            'address': lambda a,b: 'mem_addr' in b or 'dmem' in b,\n            'recovery': lambda a,b: any(x in a or x in b for x in ('recovery','redirect','target_q')),\n            'divider': lambda a,b: 'u_divider' in a or 'u_divider' in b,\n        }.items():\n            path=next(((i,p['from'],p['to'],round(5-p['slack_ns'],3)) for i,p in enumerate(paths,1) if predicate(p['from'],p['to'])),None)\n            print(name,path)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, os\nfrom pathlib import Path\nscratch=Path(os.environ['TMPDIR']); root=scratch/'issue-cosim.8yxfab'; base=scratch/'issue-baseline.a02ISG'\nfor mode in ('ready','stalled'):\n    counts=[]\n    for path in (base/f'coremark-{mode}.json',root/f'coremark-fifo-{mode}.json'):\n        d=json.loads(path.read_text()); assert d['bench_bracketed'] and d['ebreak'] and not d['oob']\n        counts.append(d['bench_stop_cycle']-d['bench_start_cycle'])\n    assert counts[0] == counts[1], (mode, counts)\n    print(mode, counts[0])\n    for elf in ('selftest', 'random1', 'random2', 'random3'):\n        traces=[]\n        for name in ('baseline','fifo'):\n            rows=list(map(json.loads,(root/f'{elf}-{name}-{mode}.jsonl').read_text().splitlines()))\n            for row in rows:\n                for lane in ('r','w'):\n                    if row.get(f'mem_{lane}mask') == 0:\n                        row.pop(f'mem_{lane}data',None)\n            traces.append(rows)\n        assert traces[0] == traces[1], (mode,elf)\n        print(f'  {elf} {len(traces[0])-1} matching retirement cycles')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
