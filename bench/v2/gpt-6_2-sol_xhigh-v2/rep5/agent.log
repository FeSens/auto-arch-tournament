{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c 'bench_trial_dir=\"$(mktemp -d \"$TMPDIR/bench_alu_XXXXXX\")\"\nexport BENCH_ALU_TRIAL_DIR=\"$bench_trial_dir\"\nprintf '\"'%s\\\\n' \\\"\"'$bench_trial_dir\"\npython3 - <<'\"'PY'\nimport os, shutil\nfrom pathlib import Path\n\nroot = Path(os.environ[\\\"BENCH_ALU_TRIAL_DIR\\\"])\ngold_dir = Path(\\\"cores/bench/rtl\\\")\nrtl = root / \\\"split16\\\" / \\\"rtl\\\"\nshutil.copytree(gold_dir, rtl)\npath = rtl / \\\"alu.sv\\\"\ncode = path.read_text()\ncode = code.replace(\\\"  always_comb begin\\\", \\\"\\\"\\\"  logic [16:0] add_low, sub_low;\n  logic [15:0] add_upper_c0, add_upper_c1, sub_upper_b0, sub_upper_b1;\n  logic [31:0] add_result, sub_result;\n\n  assign add_low = {1'b0, a[15:0]} + {1'b0, b[15:0]};\n  assign sub_low = {1'b0, a[15:0]} - {1'b0, b[15:0]};\n  assign add_upper_c0 = a[31:16] + b[31:16];\n  assign add_upper_c1 = 16'(({a[31:16], 1'b1} + {b[31:16], 1'b1}) >> 1);\n  assign sub_upper_b0 = a[31:16] - b[31:16];\n  assign sub_upper_b1 = 16'(({a[31:16], 1'b0} - {b[31:16], 1'b1}) >> 1);\n  assign add_result = {add_low[16] ? add_upper_c1 : add_upper_c0, add_low[15:0]};\n  assign sub_result = {sub_low[16] ? sub_upper_b1 : sub_upper_b0, sub_low[15:0]};\n\n  always_comb begin\\\"\\\"\\\")\ncode = code.replace(\\\"out = a + b;\\\", \\\"out = add_result;\\\").replace(\\\"out = a - b;\\\", \\\"out = sub_result;\\\")\npath.write_text(code)\n(root / 'alu_gold.sv').write_text((gold_dir / 'alu.sv').read_text().replace(\\\"module alu (\\\", \\\"module alu_gold (\\\"))\nPY\nverilator --lint-only -I\\\"\"'$bench_trial_dir/split16/rtl\" \"$bench_trial_dir/split16/rtl/alu.sv\" --top-module alu\nyosys -Q -p \"read_verilog -sv -I$bench_trial_dir/split16/rtl $bench_trial_dir/alu_gold.sv $bench_trial_dir/split16/rtl/alu.sv; proc; opt; equiv_make alu_gold alu alu_equiv; hierarchy -top alu_equiv; equiv_simple; equiv_status -assert\" > \"$bench_trial_dir/equiv.log\" 2>&1\ntail -14 \"