{"type": "item.started", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r15-profile/make_steer.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nimport sys\nvariant=sys.argv[1]\nrtl = Path(os.environ['TMPDIR']) / 'r15-profile' / (variant+'_rtl')\npath=rtl/'if_stage.sv'\ndata=path.read_text()\ndef edit(old,new):\n    global data\n    assert data.count(old)==1,old\n    data=data.replace(old,new)\n\nedit('  logic [31:2] pc_word, sequential_q, retry_q, ex_target_q, mem_target_q;',\n     '''  logic [31:2] pc_word, sequential_q, retry_q, ex_target_q, mem_target_q;\n  logic [31:2] normal_word, restart_word;\n  logic [31:2] normal_direct, ex_direct, mem_direct;\n  logic normal_range, ex_range, mem_range;''')\nedit('''  logic [18:0] direct_low_sum;\n  logic [11:0] pc_upper;\n  logic        direct_in_range, target_carry, target_borrow;''',\n     '''  logic        direct_in_range;''')\nstart=data.index('  assign pc_upper = pc_word[31:20];')\nend=data.index('  assign direct_bit1 =',start)\nrows='''  function automatic [30:0] direct_from_word (\n    input logic [31:2] pc,\n    input logic [20:2] offset\n  );\n    logic [31:2] target;\n    logic [18:0] low_sum;\n    logic [11:0] upper;\n    logic carry_word, borrow_word, in_range;\n    upper = pc[31:20];\n    low_sum = {1'b0, pc[19:2]} + {1'b0, offset[19:2]};\n    target[19:2] = low_sum[17:0];\n    carry_word = low_sum[18] && \"'!offset[20];\n    borrow_word = !low_sum[18] && offset[20];\n    target[20] = upper[0] ''^ low_sum[18] ''^ offset[20];\n    for (int i = 1; i < 12; i++)\n      target[20+i] = upper[i] ''^ ((carry_word && (&(upper & ((12'\"'d1 << i) - 1) |\n                                                                  (12'hfff << i)))) ||\n                            (borrow_word && \"'!(|(upper & ((12'\"'d1 << i) - 1)))));\n    in_range = low_sum[18]\n             ? (offset[20] ? upper == 12'd0 : &upper)\n             : (offset[20] ? upper == 12'd1 : upper == 12'd0);\n    direct_from_word = {in_range, target};\n  endfunction\n  assign {normal_range, normal_direct} = direct_from_word(normal_word, offset_word);\n'''\nif variant.startswith('triple'):\n    rows+='''  assign {ex_range, ex_direct} = direct_from_word(ex_target_q, offset_word);\n  assign {mem_range, mem_direct} = direct_from_word(mem_target_q, offset_word);\n  assign direct_word = ({30{\"'!recovering}} & normal_direct)\n                     | ({30{ex_recovery && !mem_recovery}} & ex_direct)\n                     | ({30{mem_recovery}} & mem_direct);\n  assign direct_in_range = (!recovering && normal_range) ||\n                          (ex_recovery && !mem_recovery && ex_range) ||\n                          (mem_recovery && mem_range);\n'\"'''\nelse:\n    rows+='''  assign {ex_range, ex_direct} = direct_from_word(restart_word, offset_word);\n  assign direct_word = recovering ? ex_direct : normal_direct;\n  assign direct_in_range = recovering ? ex_range : normal_range;\n'''\ndata=data[:start]+rows+data[end:]\nedit('''  assign pc_word = ({30{mem_recovery}} & mem_target_q)\n                 | ({30{ex_recovery && \"'!mem_recovery}} & ex_target_q)\n                 | ({30{sequential_select_q && !recovering}} & sequential_q)\n                 | ({30{predicted_select_q && !recovering}} & {12'\"'b0, prediction_q})\n                 | ({30{retry_select_q && \"'!recovering}} & retry_q);'\"''',\n     '''  assign restart_word = mem_recovery ? mem_target_q : ex_target_q;\n  assign normal_word = ({30{sequential_select_q}} & sequential_q)\n                     | ({30{predicted_select_q}} & {12'b0, prediction_q})\n                     | ({30{retry_select_q}} & retry_q);\n  assign pc_word = recovering ? restart_word : normal_word;''')\nif variant.endswith('low'):\n    edit(\\\"  assign response.direct_target    = {direct_word, direct_bit1, 1'b0};\\\",\n         '''  assign response.direct_target    = {direct_word, direct_bit1, 1'b0};''')\npath.write_text(data)\nPY\nfor r15_variant in double triple; do\n  mkdir -p \\\"\"'$TMPDIR/r15-profile/${r15_variant}_rtl\"\n  cp cores/bench/rtl/*.sv \"$TMPDIR/r15-profile/${r15_variant}_rtl/\"\n  python3 \"$TMPDIR/r15-profile/make_steer.py\" \"$r15_variant\"\ndone\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
