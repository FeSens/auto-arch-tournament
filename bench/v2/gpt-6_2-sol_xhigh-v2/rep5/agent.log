\\n  input  logic               delay_late_retire,')\nupdate('mem_stage','logic [31:0] late_a, late_b, late_alu_b, late_alu_result;',\n    'logic [31:0] late_a, late_b, late_add_result;')\np=r/'mem_stage.sv'\ns=p.read_text()\ni=s.index('  assign late_alu_b')\nj=s.index('  logic late_eq',i)\np.write_text(s[:i] + '''  assign late_add_result =\n      ({32{in.late_add_one}} & (in.branch_known + reg_q.result))\n    | ({32{in.late_add_both}} & {reg_q.result[30:0], 1'b0})\n    | ({32{in.late_add_fallback}} & in.alu_result);\n\n''' + s[j:])\nupdate('mem_stage','({32{in.valid && in.deferred && in.ctrl.reg_write}} & late_alu_result)',\n    '({32{in.valid}} & late_add_result)')\nupdate('mem_stage','''    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.result     <= wb_result;\n      reg_q.rd         <= in.rd;''',\n    '''    end else begin\n      reg_q.result     <= wb_result;\n      reg_q.rd         <= in.rd;\n      if (\"'!delay_late_retire) begin\n      reg_q.pc         <= in.pc;'\"''')\nupdate('mem_stage','''      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;''',\n    '''      reg_q.valid      <= in.valid;\n      end\n    end\n  end\n\n  always_comb begin\n    out = reg_q;\n    out.valid = reg_q.valid && \"'!delay_late_retire;\n  end'\"''')\nPY\npython3 \\\"\"'$profile_dir/narrow.py\" \"$profile_dir/rtl4\"\ncp \"$profile_dir/rtl3/\"*.sv \"$profile_dir/rtl3/\" 2>/dev/null || true\nNRET=1 RTL_DIR=\"$profile_dir/rtl4\" OBJ_DIR=\"$profile_dir/protoobj4\" MAKEFLAGS=-j4 bash test/cosim/build.sh > \"$profile_dir/protobuild4.log\" 2>&1\n\"$profile_dir/protoobj4/cosim_sim\" \"$profile_dir/coremark.elf\" 50000000 --bench --istall --dstall | tail -2'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
