ated git worktree\n#              at .worktrees/<TARGET>/ on branch core-<TARGET> and re-execs\n#              itself there. Lets two `make loop` invocations for different\n#              TARGETs run in parallel without git index/merge collisions.\n#              To opt out (run directly on the current branch + cwd) pass\n#              an explicit empty value: \n…[9237 of 12309 chars elided by tools/bench/transcript.py; sha256:56792fb0f915862b]…\netirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    _, load, branch, div, _ = rets\n    assert branch[\"cycle\"] - load[\"cycle\"] == 2\n    assert div[\"cycle\"] - branch[\"cycle\"] == 10\n    assert div[\"rd_wdata\"] == 0xFFFFFFFF\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"multiplier.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
