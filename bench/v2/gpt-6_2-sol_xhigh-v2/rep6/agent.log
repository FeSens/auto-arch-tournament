{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'mkdir -p \"$TMPDIR/r13_micro\"\ncat > \"$TMPDIR/r13_micro/run_timing.py\" <<'\"'PY'\nimport argparse\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all\n\np = argparse.ArgumentParser()\np.add_argument('variant')\np.add_argument('placements', nargs='*', type=int, default=[1, 2, 0])\na = p.parse_args()\nwork = Path(__file__).parent / a.variant\nfor result in build_all(Path.cwd(), work / 'rtl', 'fpga/core_bench_si.sv', work / 'timing', options=tuple(a.placements)):\n    print(result['place_option'], result['fmax_mhz'], result.get('logic'), result.get('reason'))\n    for path in result.get('critical_paths', [])[:5]:\n        print(path['arrival_ns'], path['from'], path['to'])\nPY\ncat > \\\"\"'$TMPDIR/r13_micro/setup.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nwork = Path(__file__).parent\ndef make_variant(name):\n    rtl = work / name / 'rtl'\n    rtl.mkdir(parents=True, exist_ok=True)\n    for path in Path(\\\"cores/bench/rtl\\\").glob(\\\"*.sv\\\"):\n        shutil.copy2(path, rtl / path.name)\n    return rtl\ndef replace(rtl, name, old, new):\n    path = rtl / f'{name}.sv'\n    source = path.read_text()\n    assert old in source, (name,old)\n    path.write_text(source.replace(old,new))\nrtl = make_variant('group_carry')\nreplace(rtl, 'if_stage', 'logic [10:0] predicted_sum;', '''logic [9:0] predicted_sum;\n  logic [5:0] lower_sum, upper_sum;\n  logic upper_propagates, target_carry;''')\nreplace(rtl,'if_stage', \\\"assign predicted_sum = {1'b0, pc_word_q} + {1'b0, displacement_word};\\\", '''assign predicted_sum = pc_word_q + displacement_word;\n  assign lower_sum = {1'b0, pc_word_q[4:0]} + {1'b0, displacement_word[4:0]};\n  assign upper_sum = {1'b0, pc_word_q[9:5]} + {1'b0, displacement_word[9:5]};\n  assign upper_propagates = &(pc_word_q[9:5] | displacement_word[9:5]);\n  assign target_carry = upper_sum[5] || (upper_propagates && lower_sum[5]);''')\nreplace(rtl,'if_stage','predicted_sum[10] == imem_data[31]', 'target_carry == imem_data[31]')\n\nrtl = make_variant('recovery_tags')\nreplace(rtl, 'id_stage', 'in.predicted_taken \"'^ dec_branch_op[0]'\"', 'dec_branch_op[0]')\nreplace(rtl, 'id_stage', 'in.predicted_taken || fence_i', 'fence_i')\nreplace(rtl, 'id_stage', '\"'!in.predicted_taken && !dec_is_jalr && !fence_i'\"', '\"'!dec_is_jalr && !fence_i'\"')\nreplace(rtl, 'id_stage', '\"'!in.predicted_taken && dec_is_jalr'\"', 'dec_is_jalr')\nreplace(rtl, 'ex_stage', 'in.recover_fallthrough}}', '(in.predicted_taken || in.recover_fallthrough)}}')\nreplace(rtl, 'ex_stage', 'in.recover_direct}}', '(\"'!in.predicted_taken && in.recover_direct)}}'\"')\nreplace(rtl, 'ex_stage', 'in.recover_indirect}}', '(\"'!in.predicted_taken && in.recover_indirect)}}'\"')\nreplace(rtl, 'ex_stage', 'logic branch_miss, jump_miss;', 'logic branch_miss, jump_miss, branch_invert;\\\\n  assign branch_invert = in.branch_recover_invert \"'^ in.predicted_taken;'\"')\nreplace(rtl, 'ex_stage', '\"'^ in.branch_recover_invert)'\"', '\"'^ branch_invert)'\"')\n\nrtl = make_variant('div_negation')\nreplace(rtl, 'div_unit', '  assign dividend       = a_negative ? -a : a;\\\\n  assign divisor        = b_negative ? -b : b;', '''  function automatic [31:0] magnitude(input logic [31:0] value, input logic negate);\n    logic [31:0] inverted;\n    begin\n      inverted = value \"'^ {32{negate}};\n      magnitude[7:0] = inverted[7:0] + {7'\"'b0, negate};\n      magnitude[15:8] = inverted[15:8] + {7'b0, negate && \"'!(|value[7:0])};\n      magnitude[23:16] = inverted[23:16] + {7'\"'b0, negate && \"'!(|value[15:0])};\n      magnitude[31:24] = inverted[31:24] + {7'\"'b0, negate && \"'!(|value[23:0])};\n    end\n  endfunction\n\n  assign dividend = magnitude(a, a_negative);\n  assign divisor  = magnitude(b, b_negative);'\"''')\nPY\npython3 \\\"\"'$TMPDIR/r13_micro/setup.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
