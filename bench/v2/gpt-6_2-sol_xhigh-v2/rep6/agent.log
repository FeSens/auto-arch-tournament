{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"cp -r ../test .\npython3 - <<'PY'\nfrom pathlib import Path\npath = Path('test/test_div_unit.py')\ntext = path.read_text()\ninsert = '''@cocotb.test()\nasync def radix16_boundaries(dut):\n    await _setup(dut)\n    dividends = [high << 28 | low\n                 for high in range(16)\n                 for low in (0, 1, 0xFFFFFFE, 0xFFFFFFF)]\n    pairs = [(a, b) for a in dividends for b in (0, 1, 2, 7, 14, 15, 16, 17)]\n    for b in (3, 15, 16, 17, 0x11111111, 0x11111112, 0x80000001):\n        pairs.extend((a, b) for k in range(1, 16)\n                     for a in (k*b - 1, k*b, k*b + 1) if a <= MASK32)\n    for a, b in pairs:\n        for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n            await _start(dut, op, a, b)\n            await _finish(dut, op, a, b)\n            await _tick(dut)\n\n\n'''\npath.write_text(text.replace('def test_div_unit_runner():', insert+'def test_div_unit_runner():'))\nPY\npytest -q -p no:cacheprovider --confcutdir=. --rootdir=. test > cocotb.log 2>&1\ntail -25 cocotb.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
