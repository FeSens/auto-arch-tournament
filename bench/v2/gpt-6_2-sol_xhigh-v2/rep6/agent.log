n  assign fetch_word = ({10{select_normal_q}}      & pc_word_q)\n                    | ({10{select_target_q}}      & target_q[11:2])\n                    | ({10{select_fallthrough_q}} & fallthrough_q[11:2]);\n\n  // Increment each candidate page ahead of the fe\n…[2667 of 5739 chars elided by tools/bench/transcript.py; sha256:a19592d510570a6d]…\nimem_data[30:25], imem_data[11:9]};\n  assign predicted_sum = {1'b0, fetch_word} + {1'b0, displacement_word};\n  assign predicted_taken = (branch_prediction || jal_prediction)\n                        && (predicted_sum[10] == imem_data[31]);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_page_q <= '0;\n      pc_word_q <= '0;\n    end else begin\n      pc_page_q <= (!stall && !predicted_taken && sequential_sum[10])\n                 ? incremented_page : fetch_page;\n      // On a stall, copy the current fetch address to the normal PC. This\n      // keeps a blocked correction available after its select pulse expires.\n      pc_word_q <= stall ? fetch_word\n                         : predicted_taken ? predicted_sum[9:0] : sequential_sum[9:0];\n    end\n  end\n\n  assign imem_addr           = {fetch_page, fetch_word, 2'b00};\n  assign out.pc              = imem_addr;\n  assign out.instr           = imem_data;\n  assign out.predicted_taken = predicted_taken;\n  assign out.valid           = imem_ready;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
