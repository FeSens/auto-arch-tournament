{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"cat > prototype.py <<'PY'\nfrom pathlib import Path\nrtl = Path('cores/bench/rtl')\n\ndef update(filename, edits):\n    path = rtl / filename\n    source = path.read_text()\n    for old, new in edits:\n        assert old in source, old\n        source = source.replace(old, new, 1)\n    path.write_text(source)\n\nupdate(\\\"core_pkg.sv\\\", [('  // ── Pipeline-bundle typedefs', '''  typedef struct packed {\n\"'`ifdef RISCV_FORMAL_ALTOPS\n    logic [31:0] alternate;\n`else\n    logic [31:0] quotient;\n    logic [31:0] remainder;\n    logic want_remainder;\n    logic negate;\n`endif\n  } div_result_t;\n\n  // ── Pipeline-bundle typedefs'\"'''), (\n    '    logic [31:0] div_magnitude;\\\\n    logic        div_negate;', '    div_result_t div_result;')])\nupdate('ex_stage.sv', [\n    ('  logic        div_negate;\\\\n  logic [31:0] div_magnitude, div_rs1, div_rs2;',\n     '  div_result_t div_result;\\\\n  logic [31:0] div_rs1, div_rs2;'),\n    ('    .result_magnitude (div_magnitude),\\\\n    .result_negate    (div_negate),', '    .result           (div_result),'),\n    ('      reg_q.div_magnitude <= div_magnitude;\\\\n      reg_q.div_negate    <= div_negate;', '      reg_q.div_result    <= div_result;'),\n])\nupdate('mem_stage.sv', [('  assign div_result = in.div_negate ? -in.div_magnitude : in.div_magnitude;', '''\"'`ifdef RISCV_FORMAL_ALTOPS\n  assign div_result = in.div_result.alternate;\n`else\n  logic [31:0] div_magnitude;\n  assign div_magnitude = in.div_result.want_remainder ? in.div_result.remainder : in.div_result.quotient;\n  assign div_result = in.div_result.negate ? -div_magnitude : div_magnitude;\n`endif'\"''')])\nupdate('div_unit.sv', [\n    ('  output logic [31:0] result_magnitude,\\\\n  output logic        result_negate,', '  output div_result_t result,'),\n    (\\\"  assign result_negate = 1'b0;\\\\n\\\", ''),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('  assign dividend       = a_negative ? -a : a;\\\\n  assign divisor        = b_negative ? -b : b;', '''  assign dividend[0] = a[0];\n  assign divisor[0] = b[0];\n  for (genvar bit_index = 1; bit_index < 32; bit_index++) begin : g_magnitude\n    assign dividend[bit_index] = a[bit_index] \"'^ (a_negative && (|a[bit_index-1:0]));\n    assign divisor[bit_index] = b[bit_index] ''^ (b_negative && (|b[bit_index-1:0]));\n  end'\"'''),\n    ('  assign result_magnitude = want_remainder_q ? residual : quotient_next;\\\\n  assign result_negate    = negate_result_q;', '''  assign result.quotient = quotient_next;\n  assign result.remainder = residual;\n  assign result.want_remainder = want_remainder_q;\n  assign result.negate = negate_result_q;'''),\n])\ntest = Path('cores/bench/test/test_div_unit.py')\ns = test.read_text().replace('    negate = bool(dut.result_negate.value)', '''    packet = int(dut.result.value)\n    negate = bool(packet & 1)\n    want_remainder = bool(packet & 2)\n    assert want_remainder == (op in (ALU_REM, ALU_REMU))\n    residual = (packet >> 2) & MASK32\n    quotient = packet >> 34''').replace('    magnitude = int(dut.result_magnitude.value)', '    magnitude = residual if want_remainder else quotient')\ntest.write_text(s)\nPY\npython3 prototype.py\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
