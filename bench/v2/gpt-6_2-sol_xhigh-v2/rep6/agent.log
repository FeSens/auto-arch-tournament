{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-equality.K89Qaf\"\ncat > \"$scratch/independent.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch=Path(__file__).resolve().parent\nroot=Path.cwd()\nfor name in ('negative','shifter'):\n    dest=scratch/name/'rtl'\n    shutil.copytree(root/'cores/bench/rtl',dest,dirs_exist_ok=True)\n    def change(file,*pairs):\n        p=dest/f'{file}.sv'\n        s=p.read_text()\n        for before,after in pairs:\n            assert before in s, before\n            s=s.replace(before,after)\n        p.write_text(s)\n    if name == 'negative':\n        change('div_unit',\n            ('  logic [31:0] divisor_q;', '  logic [31:0] divisor_q, neg_divisor_q;\\\\n  logic divisor_zero_q;'),\n            (\\\"  assign divisor_once  = {4'b0, divisor_q};\\\",\n             \\\"  assign divisor_once  = {{4{\"'!divisor_zero_q}}, neg_divisor_q};\"),\n            ('\"'''    assign difference = {1'b0, trial} - {1'b0, multiple[31:0]};\n    assign fits[k] = \"'!difference[32] && !(|multiple[35:32]);'\"''',\n             '''    assign difference = {1'b0, trial} + {1'b0, multiple[31:0]};\n    assign fits[k] = (difference[32] && (&multiple[35:32])) || divisor_zero_q;'''),\n            ('      divisor_q        <= divisor;',\n             '''      divisor_q        <= divisor;\n      neg_divisor_q    <= b_negative ? b : -b;\n      divisor_zero_q   <= b == 32'b0;'''))\n    else:\n        change('alu',\n            ('  logic        [4:0]  shamt;',\n             '''  logic [4:0] shamt;\n  logic shift_left;\n  logic [31:0] reverse_a, shift_in, shift_out, reverse_out;\n  logic signed [32:0] shifted;\n\n  assign shift_left = op == ALU_SLL;\n  assign shift_in = shift_left ? reverse_a : a;\n  assign shifted = \"'$signed({a[31] && op == ALU_SRA, shift_in}) >>> shamt;\n  assign shift_out = shifted[31:0];\n  for (genvar bit_index = 0; bit_index < 32; bit_index++) begin : g_reve