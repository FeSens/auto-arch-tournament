{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'scratch_dir=\"$TMPDIR/bench-predictor.yrU2Bs\"\ncat >\"$scratch_dir/bank.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport sys\nwork=Path(sys.argv[1])\nfor n,late in [(6,False),(7,False),(6,True)]:\n    rows=2**n\n    name=f\\\"loop_bank_{rows}\\\" + (\\\"_late\\\" if late else \\\"\\\")\n    rtl=work/name\n    copytree(work/f'loop_predict_{rows}',rtl,dirs_exist_ok=True)\n    p=rtl/'if_stage.sv'; c=p.read_text()\n    c=c.replace('  assign invert_prediction = override_next_q[lookup_index_q];', '''\n  localparam int BANKS = ROWS / 16;\n  logic [BANKS-1:0] bank_mask_q;\n  (* syn_keep = 1 *) logic [BANKS-1:0] predicted_by_bank;\n  for (genvar bank = 0; bank < BANKS; bank++) begin : g_lookup\n    logic [15:0] bank_rows;\n    assign bank_rows = override_next_q[bank*16 +: 16];\n    assign predicted_by_bank[bank] = bank_mask_q[bank] && bank_rows[lookup_index_q[3:0]];\n    always_ff @(posedge clock) begin\n      if (reset)\n        bank_mask_q[bank] <= bank == 0;\n      else if (word_write)\n        bank_mask_q[bank] <= next_index[ROW_BITS-1:4] == (ROW_BITS-4)'(bank);\n    end\n  end\n  assign invert_prediction = |predicted_by_bank;\n''')\n    if late:\n        template=(work/'late_mux'/'if_stage.sv').read_text()\n        c=c.replace('  logic        bus_target_selected, replay_target_selected;\\\\n','')\n        c=c.replace('  logic branch_direction, replay_direction;\\\\n','')\n        c=c.replace('  assign branch_direction = invert_prediction \"'^ imem_data[31];'\"\\\\n','')\n        c=c.replace('  assign replay_direction = invert_prediction \"'^ replay_steering.cold_taken;'\"\\\\n','')\n        c=c.replace('                          && \"'!imem_data[8] && branch_direction;'\"','                          && \"'!imem_data[8];'\"')\n        s=c.index('  assign predicted_taken = (branch_prediction')\n        e=c.index('  // A correction',s)\n        ts=template.index('  logic bus_branch,')\n        te=template.index('  // A correction',ts)\n        c=c[:s]+template[ts:te]+c[e:]\n        s=c.index('  assign normal_next_index = ')\n        e=c.index('  assign recovery_next_index = ',s)\n        ts=template.index('  assign seq_successor = ')\n        te=template.index('  assign recovery_next_index = ',ts)\n        c=c[:s]+template[ts:te]+c[e:]\n    p.write_text(c)\nPY\npython3 \\\"\"'$scratch_dir/bank.py\" \"$scratch_dir\"\nfor variant in loop_bank_64 loop_bank_128 loop_bank_64_late; do\n  RTL_DIR=\"$scratch_dir/$variant\" OBJ_DIR=\"$scratch_dir/$variant-obj\" NRET=1 bash test/cosim/build.sh >\"$scratch_dir/$variant-verilator.log\" 2>&1 && \"$scratch_dir/$variant-obj/cosim_sim\" \"$scratch_dir/coremark.elf\" 5000000 --bench --istall --dstall >\"$scratch_dir/$variant-result.txt\" &\n  PYTHONPATH=\"$PWD\" python3 \"$scratch_dir/timing.py\" \"$scratch_dir/$variant\" >\"$scratch_dir/${variant}_timing.txt\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
