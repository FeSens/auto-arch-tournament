{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"cp -R cores/bench/rtl '/srv/hwebench/tmp/86dd60e1/bdc56976/r14s1.tYeMSa/rtl' && python3 - '/srv/hwebench/tmp/86dd60e1/bdc56976/r14s1.tYeMSa/rtl' <<'PY'\nfrom pathlib import Path\nimport sys\n\nroot = Path(sys.argv[1])\ndef edit(name, replacements):\n    path = root / name\n    source = path.read_text()\n    for before, after in replacements:\n        assert source.count(before) >= 1, (name, before)\n        source = source.replace(before, after)\n    path.write_text(source)\n\nedit('core_pkg.sv', [\n    ('  typedef struct packed {\\\\n    logic local_value;', '''  typedef struct packed {\n    logic arithmetic;\n    logic shift;\n    logic bitwise;\n  } fast_class_t;\n\n  function automatic fast_class_t fast_class(input logic [4:0] op);\n    case (op)\n      ALU_SLL, ALU_SRL, ALU_SRA: fast_class = 3'b010;\n      ALU_AND, ALU_OR, ALU_XOR, ALU_LUI: fast_class = 3'b001;\n      default: fast_class = 3'b100;\n    endcase\n  endfunction\n\n  typedef struct packed {\n    logic [31:0] arithmetic;\n    logic [31:0] shift;\n    logic [31:0] bitwise;\n  } fast_lanes_t;\n\n  typedef struct packed {\n    logic local_value;'''),\n    ('    logic ex_mem;\\\\n', '    fast_class_t ex_mem;\\\\n'),\n    ('    operand_sel_t alu_b_sel;\\\\n', '    operand_sel_t alu_b_sel;\\\\n    fast_class_t fast_class;\\\\n'),\n    ('    logic [31:0] alu_result;\\\\n', '    fast_lanes_t fast_lanes;\\\\n    fast_class_t fast_class;\\\\n'),\n])\n\n(root / 'alu.sv').write_text('''module alu_lanes (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output fast_lanes_t lanes\n);\n  logic [4:0] shamt;\n  assign shamt = b[4:0];\n\n  always_comb begin\n    case (op)\n      ALU_ADD:  lanes.arithmetic = a + b;\n      ALU_SUB:  lanes.arithmetic = a - b;\n      ALU_SLT:  lanes.arithmetic = {31'b0, \"'$signed(a) < $signed(b)};\n      ALU_SLTU: lanes.arithmetic = {31'\"'b0, a < b};\n      default:  lanes.arithmetic = 32'b0;\n    endcase\n    case (op)\n      ALU_SLL:  lanes.shift = a << shamt;\n      ALU_SRL:  lanes.shift = a >> shamt;\n      ALU_SRA:  lanes.shift = \"'$unsigned($signed(a) >>> shamt);\n      default:  lanes.shift = 32'\"'b0;\n    endcase\n    case (op)\n      ALU_AND:  lanes.bitwise = a & b;\n      ALU_OR:   lanes.bitwise = a | b;\n      ALU_XOR:  lanes.bitwise = a \"'^ b;\n      ALU_LUI:  lanes.bitwise = b;\n      default:  lanes.bitwise = 32'\"'b0;\n    endcase\n  end\nendmodule\n\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n  fast_lanes_t lanes;\n  alu_lanes u_lanes (.op(op), .a(a), .b(b), .lanes(lanes));\n  assign out = lanes.arithmetic | lanes.shift | lanes.bitwise;\nendmodule\n''')\n\nedit('id_stage.sv', [\n    (\\\"localparam operand_sel_t SELECT_LOCAL = 3'b100;\\\", \\\"localparam operand_sel_t SELECT_LOCAL = 5'b10000;\\\"),\n    ('      reg_q.ctrl        <= ctrl_decoded;', '      reg_q.ctrl        <= ctrl_decoded;\\\\n      reg_q.fast_class  <= fast_class(dec_alu_op);')\n])\nedit('forward_unit.sv', [\n    ('  input  logic        ex_write,', '  input  logic        ex_write,\\\\n  input  fast_class_t ex_class,'),\n    ('    sel.ex_mem      = ex_match;', '    sel.ex_mem      = {3{ex_match}} & ex_class;')\n])\nedit('ex_stage.sv', [\n    ('  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)', '  input  fast_lanes_t        fwd_ex_mem,'),\n    *[\n        (f'({{32{{in.{s}_sel.ex_mem}}}} & fwd_ex_mem)',\n         f'({{32{{in.{s}_sel.ex_mem.arithmetic}}}} & fwd_ex_mem.arithmetic)\\\\n'\n         f'             | ({{32{{in.{s}_sel.ex_mem.shift}}}} & fwd_ex_mem.shift)\\\\n'\n         f'             | ({{32{{in.{s}_sel.ex_mem.bitwise}}}} & fwd_ex_mem.bitwise)')\n        for s in ['rs1', 'rs2', 'alu_a', 'alu_b']\n    ],\n    ('  logic [31:0] alu_result;\\\\n  alu u_alu (', '  fast_lanes_t fast_lanes;\\\\n  alu_lanes u_alu ('),\n    ('    .out (alu_result)', '    .lanes (fast_lanes)'),\n    ('      reg_q.alu_result    <= alu_result;', '      reg_q.fast_lanes     <= fast_lanes;\\\\n      reg_q.fast_class     <= in.fast_class;')\n])\nedit('mem_stage.sv', [\n    ('      default:     wb_result = in.alu_result;', '''      default:     wb_result = ({32{in.fast_class.arithmetic}} & in.fast_lanes.arithmetic)\n                               | ({32{in.fast_class.shift}} & in.fast_lanes.shift)\n                               | ({32{in.fast_class.bitwise}} & in.fast_lanes.bitwise);''')\n])\nedit('core.sv', [\n    ('.fwd_ex_mem           (ex_mem_w.alu_result),  // EX/MEM-registered ALU result', '.fwd_ex_mem           (ex_mem_w.fast_lanes),'),\n    ('    .ex_write  (ex_fast_write),','    .ex_write  (ex_fast_write),\\\\n    .ex_class  (id_ex_w.fast_class),')\n])\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
