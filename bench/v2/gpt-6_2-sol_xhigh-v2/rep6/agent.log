d, rs1, rs2): return _r(1, rs2, rs1, 0b101, rd, 0b0110011)\ncores/bench/test/test_pipeline.py:69:def REM (rd, rs1, rs2): return _r(1, rs2, rs1, 0b110, rd, 0b0110011)\ncores/bench/test/test_pipeline.py:70:def REMU(rd, rs1, rs2): return _r(1, rs2, rs1, 0b111, rd, 0b0110011)\ncores/bench/test/test_pipeline.py:525:        DIV(3, 1, 2),\ncores/bench/test/test_pipeline.py:526:        REM(4, 3, 2),\ncores/bench/test/test_pipeline.py:529:        DIVU(7, 6, 2),\ncores/bench/test/test_pipeline.py:530:        REMU(8, 6, 7),\ncores/bench/test/test_pipeline.py:532:        DIVU(12, 0, 0),  # Wrong-path divide must not issue.\ncores/bench/test/test_pipeline.py:533:        REMU(10, 6, 2),\ncores/bench/test/test_pipeline.py:546:    # JAL encoding's raw rs2 field matches the preceding REMU's x8.\ncores/bench/test/test_pipeline.py:610:        DIV(4, 3, 2),   # Dependent multiply-to-divide fits the ten-cycle bound.\ncores/bench/test/test_pipeline.py:611:        MUL(5, 1, 2),   # Independent of DIV.\ncores/bench/test/test_pipeline.py:639:        DIV(4, 3, 2),  # The older stalled store holds the MUL result in WB.\ncores/bench/test/test_pipeline.py:642:        REM(7, 6, 5),\ncores/bench/test/test_pipeline.py:673:        DIVU(1, 0, 0),\nformal/checks_si.cfg:18:# liveness — CPU makes forward progress under any symbolic stream\nformal/checks_si.cfg:22:liveness   1 10 20\ntotal 132\ndrwxrwx---+ 12 nobody    nogroup    4096 Nov 23 00:14 .\ndrwxrwx---+  5 nobody    nogroup    4096 Nov 23 00:14 ..\ndr-xr-xr-x   2 hwebench2 hwebench2    40 Nov 23 00:14 .agents\ndr-xr-xr-x   2 hwebench2 hwebench2    40 Nov 23 00:14 .aws\ndr-xr-xr-x   2 hwebench2 hwebench2    40 Nov 23 00:14 .codex\n-rw-rw----+  1 nobody    nogroup      99 Nov 23 00:14 .git\n-rw-rw----+  1 nobody    nogroup    5999 Nov 23 00:14 .gitignore\n-rw-rw----+  1 nobody    nogroup    2041 Nov 23 00:14 ARCHITECTURE.md\n-rw-rw----+  1 nobody    nogroup   10455 Nov 23 00:14 CLAUDE.md\n-rw-rw----+  1 nobody    nogroup   11358 Nov 23 00:14 LICE