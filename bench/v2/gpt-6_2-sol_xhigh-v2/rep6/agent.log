idate[k] = difference[{width-1}:0];\n  end\n  assign {prefix}_selected = {prefix}_fits[{count-1}:0] & ~{prefix}_fits[{count}:1];\n  always_comb begin\n    {prefix}_residual = '0;\n    {prefix}_digit = '0;\n    for (int k = 0; k < {count}; k++) begin\n      {prefix}_residual |= {{{width}{{{prefix}_selected[k]}}}} & {prefix}_candidate[k];\n      {prefix}_digit |= {{{bits}{{{prefix}_selected[k]}}}} & {bits}'(k);\n    end\n  end\n'''\n\nstate=original[original.index('  logic signed_op'):original.index('  // Each candidate sees')]\na=state.index('  // The shift register')\nb=state.index('  assign signed_op',a)\nstate = state[:a]+f'''  logic [31:0] narrow_quotient_q, wide_quotient_q;\n  logic [{threshold-1}:0] narrow_remainder_q;\n  logic [31:0] wide_remainder_q;\n  logic [3:0] leading_digit, leading_remainder;\n  logic [35:0] divisor_once, divisor_twice, divisor_four, divisor_eight;\n  logic [35:0] sum_three, carry_three;\n  logic [35:0] odd_multiple_q [1:7];\n  logic wide_q, zero_q;\n\n'''+state[b:]\nstate=state.replace('quotient_q[31:28]','narrow_quotient_q[31:28]')\n\nout=head+state+trials('narrow',4,narrow_width,small_chunk,False)+trials('wide',wide_bits,32,wide_chunk,True)+f'''\n  logic [31:0] narrow_quotient_next;\n  assign narrow_quotient_next = {{narrow_quotient_q[27:0], narrow_digit}};\n  always_comb begin\n    if (zero_q) result_magnitude = want_remainder_q ? narrow_quotient_q : 32'hffffffff;\n    else if (wide_q) result_magnitude = want_remainder_q ? wide_remainder_q : wide_quotient_q;\n    else result_magnitude = want_remainder_q ? {{ {32-threshold}'b0, narrow_residual[{threshold-1}:0] }}\n                                             : narrow_quotient_next;\n  end\n  assign result_negate = negate_result_q;\n\n  always_ff @(posedge clock) begin\n    if (issue) begin\n      divisor_q        <= divisor;\n      wide_q           <= |divisor[31:{threshold}];\n      zero_q           <= (b == 32'b0);\n      want_remainder_q <= want_remainder;\n      negate_result_q  