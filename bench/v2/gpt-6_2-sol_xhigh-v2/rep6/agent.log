{"type": "item.completed", "item": {"id": "item_87", "type": "command_execution", "command": "/bin/bash -c \"sed -n '675,855p' cores/bench/test/test_pipeline.py\n sed -n '1,93p' cores/bench/test/_helpers.py\"", "aggregated_output": "\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 1, 12, 9, 2, 3, 10, 2, 1], gaps\n\n\n@cocotb.test()\nasync def redirect_and_fetch_stall_squash_side_effects(dut):\n    program = [\n        BEQ(0, 0, 8),   # Cold forward branch resolves taken.\n        SW(0, 0, 0x80),  # Wrong-path store on the stalled sequential fetch.\n        DIVU(1, 0, 0),\n        SW(1, 0, 0x84),\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, imem_stalls={4: 3, 8: 2, 12: 11},\n                         dmem_trace=requests)\n    assert [r[\"pc\"] for r in rets] == [0, 8, 12, 16]\n    assert [r[\"order\"] for r in rets] == list(range(4))\n    assert requests == [(0x84, 0, 0xF, 0xFFFFFFFF, True)]\n\n\ndef _assert_retirement_path(rets, pcs):\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets] == pcs[1:] + [(pcs[-1] + 4) & 0xFFFFFFFF]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n\n\n@cocotb.test()\nasync def direct_prediction_and_page_wraps(dut):\n    program = {\n        0x00000000: BEQ(10, 0, 8),        # Taken at boot, fall-through after wrap.\n        0x00000004: EBREAK(),\n        0x00000008: LUI(1, 0x80001),\n        0x0000000C: JALR(2, 1, -7),      # Clear bit 0 of 0x80000ff9.\n        0x80000FF8: BNE(0, 0, -8),       # Fall-through recovery to the page's last word.\n        0x80000FFC: NOP(),\n        0x80001000: JAL(6, 0x804),       # Positive page-local displacement with bit 11 set.\n        0x80001804: JAL(7, -0x800),      # Negative page-local displacement.\n        0x80001004: BEQ(0, 0, 0x18),     # Cold forward miss.\n        0x8000101C: BEQ(0, 0, -0xC),     # Cold backward hit.\n        0x80001010: JAL(0, 0x1000),      # JAL's upper bits exclude this positive offset.\n        0x80002010: BEQ(0, 0, -0x14),    # Target recovery to the previous page's last word.\n        0x80001FFC: NOP(),\n        0x80002000: JAL(8, 0xFFC),       # Last word of the same page.\n        0x80002FFC: JAL(9, 8),           # Positive displacement that crosses a page.\n     \n…[6815 of 9887 chars elided by tools/bench/transcript.py; sha256:a8609f0001e201a3]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
