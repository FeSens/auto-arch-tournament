{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c 'scratch_dir=\"$TMPDIR/bench-predictor.yrU2Bs\"\ncat >\"$scratch_dir/create.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport sys\n\nwork = Path(sys.argv[1])\nsrc = Path('cores/bench/rtl')\n\ndef alter(name, change):\n    root=work/name\n    copytree(src,root,dirs_exist_ok=True)\n    p=root/'if_stage.sv'\n    p.write_text(change(p.read_text()))\n\ndef no_feedback(code):\n    code=code.replace('logic [5:0] lookup_index_q, next_index;', 'logic [5:0] lookup_index_q;')\n    cut=code.index('  logic [1:0] sequential_page_low;')\n    cut_end=code.index('  always_ff @(posedge clock) begin',cut)\n    code=code[:cut]+'  assign lookup_index_q = direction_index(pc_page_q[1:0], pc_word_q);\\\\n\\\\n'+code[cut_end:]\n    code=code.replace(\\\"      lookup_index_q <= '0;\\\\n\\\",'')\n    return code.replace(\\\"        lookup_index_q <= next_index;\\\\n\\\",'')\n\ndef relative(code, comb_index):\n    if comb_index:\n        code=no_feedback(code)\n    start=code.index('  logic [63:0] trained_q;')\n    end=code.index('  logic branch_prediction',start)\n    code=code[:start]+'''\n  logic [63:0] override_q, strong_q;\n  logic [5:0] lookup_index_q''' + ('' if comb_index else ', next_index')+''';\n  logic branch_direction, replay_direction;\n  logic invert_prediction, disagreement;\n  logic [5:0] update_index;\n  logic old_override, old_strong;\n  assign update_index = predictor_update.index;\n  assign invert_prediction = override_q[lookup_index_q];\n  assign branch_direction = invert_prediction \"'^ imem_data[31];\n  assign replay_direction = invert_prediction ''^ replay_steering.cold_taken;\n  assign old_override = override_q[update_index];\n  assign old_strong = strong_q[update_index];\n  assign disagreement = predictor_update.taken ''^ predictor_update.cold_taken;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      override_q <= '\"'0;\n      strong_q <= '0;\n    end else if (predictor_update.valid) begin\n      override_q[update_index] <= old_strong ? old_override : disagreement;\n      strong_q[update_index] <= old_override == disagreement;\n    end\n  end\n\n'''+code[end:]\n    return code\n\nfor name, change in [\n    ('comb_index',no_feedback),\n    ('registered_relative',lambda c:relative(c,False)),\n    ('comb_relative',lambda c:relative(c,True)),\n]:\n    alter(name,change)\n    if 'relative' in name:\n        p=work/name/'core_pkg.sv'\n        c=p.read_text().replace('logic       taken;','logic       taken;\\\\n    logic       cold_taken;')\n        p.write_text(c)\n        p=work/name/'mem_stage.sv'\n        c=p.read_text().replace('  assign predictor_update.taken = branch_taken;', '  assign predictor_update.taken = branch_taken;\\\\n  assign predictor_update.cold_taken = in.instr[31];')\n        p.write_text(c)\nPY\ncat >\\\"\"'$scratch_dir/timing.py\" <<'\"'PY'\nfrom pathlib import Path\nimport json,sys\nfrom tools.eval.gowin import build_all,summarize\np=Path(sys.argv[1])\nr=build_all(Path.cwd(),p,'fpga/core_bench_si.sv',p.parent/(p.name+'_timing'))\nprint(json.dumps(summarize(r)),flush=True)\nfor x in r: print(json.dumps({k:x.get(k) for k in ['place_option','fmax_mhz','critical_paths','reason']}),flush=True)\nPY\npython3 \\\"\"'$scratch_dir/create.py\" \"$scratch_dir\" && PYTHONPATH=\"$PWD\" python3 \"$scratch_dir/timing.py\" \"$scratch_dir/comb_relative\" >\"$scratch_dir/comb_relative_timing.txt\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
