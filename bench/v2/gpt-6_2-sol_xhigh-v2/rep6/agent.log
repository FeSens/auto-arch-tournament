{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'jal|branch|redirect|latency|\"'^def test'\"' cores/bench/test/test_pipeline.py && sed -n '280,700p' cores/bench/test/test_pipeline.py && sed -n '1,200p' cores/bench/test/_helpers.py\"", "aggregated_output": "5:acceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\n383:async def branch_taken_skips(dut):\n391:        ADDI(2, 0, 42),        # PC=8;  branch target\n409:async def jal_writes_pc_plus_4(dut):\n428:async def jalr_target(dut):\n521:async def divide_forwarding_and_ready_bus_latency(dut):\n605:async def multiply_interlock_and_ready_bus_latency(dut):\n669:async def redirect_and_fetch_stall_squash_side_effects(dut):\n685:def test_pipeline_runner():\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def effective_addresses_with_forwarding_and_stalls(dut):\n    program = [\n        ADDI(3, 0, -1663),      # x3 = 0xfffff981\n        LUI(1, 1),\n        ADDI(1, 1, -2044),     # x1 = 0x804, newer than the LUI in MEM/WB\n        SB(3, 1, 2047),        # EX/MEM base, 0x804 -> 0x1003 (stalled)\n        LB(4, 1, 2047),        # MEM/WB base held during the store stall\n        LUI(2, 1),\n        ADDI(2, 2, 2),        # x2 = 0x1002\n        NOP(),\n        SH(3, 2, -2048),       # MEM/WB base, 0x1002 -> 0x802\n        LUI(6, 1),\n        LH(5, 6, -2048),       # EX/MEM base, 0x1000 -> 0x800 (stalled)\n        LHU(7, 2, -2048),      # upper halfword written by SH\n        ADDI(9, 0, -4),\n        SW(3, 9, 8),          # 0xfffffffc + 8 wraps to 4\n        LW(10, 9, 8),\n   \n…[15275 of 18347 chars elided by tools/bench/transcript.py; sha256:34febe4d7b9fee4e]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
