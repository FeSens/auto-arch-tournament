{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python -u - /srv/hwebench/tmp/86dd60e1/ba14e686/r13s1-profile.EZDr1l <<'PY'\nimport sys, subprocess, json\nfrom collections import Counter\nfrom pathlib import Path\np = Path(sys.argv[1])\nsim = subprocess.Popen([str(p / 'obj/cosim_sim'), str(p / 'coremark.elf'), '50000000', '--istall', '--dstall'], stdout=subprocess.PIPE)\nuses1 = {0x03,0x13,0x23,0x33,0x63,0x67}\nuses2 = {0x23,0x33,0x63}\ninside = False\nlast = None\ncounts, modes = Counter(), Counter()\nfor line in sim.stdout:\n    if not line.startswith(b'{\\\"order\\\":'): continue\n    r = json.loads(line)\n    addr, wmask = r['mem_addr'], r['mem_wmask']\n    if wmask and addr == 0x10000100:\n        inside = True\n    elif wmask and addr == 0x10000104:\n        break\n    if not inside:\n        continue\n    if last:\n        insn = r['insn']; code = insn & 0x7f\n        prev = last['insn']; rd = last['rd_addr']\n        mask1 = rd == (insn >> 15) & 31\n        mask2 = rd == (insn >> 20) & 31\n        late = ((prev & 0x7f) == 0x03 or (prev & 0xfe00007f) == 0x02000033)\n        if rd and late and (mask1 or mask2):\n            a = mask1 and code in uses1\n            b = mask2 and code in uses2\n            kind = {0x63: 'branch', 0x03: 'load', 0x23: 'store', 0x13: 'imm', 0x33: 'reg', 0x67: 'jalr'}.get(code, hex(code))\n            if not (a or b):\n                kind = 'raw_only'\n            elif kind == 'store':\n                kind += '_addr' if a else '_data'\n            counts[kind] += 1\n            if r['cycle'] - last['cycle'] >= 2:\n                modes[kind] += 1\n    last = r\nprint('Adjacent late-result raw source matches', counts)\nprint('Adjacent late-result raw source matches with gap >=2', modes)\nsim.stdout.close()\nsim.wait()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
