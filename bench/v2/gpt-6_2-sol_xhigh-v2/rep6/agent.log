{"type": "item.completed", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,230p' tools/eval/formal.py; sed -n '1,165p' formal/run_all.sh; rg -n 'hypotheses/|hypothesis_out' tools/tournament.py tools/agents\"", "aggregated_output": "\"\"\"Runs the real riscv-formal suite via formal/run_all.sh.\n\nThe real suite is generated at runtime by formal/run_all.sh (which invokes\ngenchecks.py against our rtl/*.sv + wrapper.sv + checks.cfg) and runs the\n~45 I-base / M-ext insn checks plus reg / pc_fwd / pc_bwd / causal /\nunique / cover / ill / liveness — 53 total against the V0 baseline.\n\nIf genchecks.py crashes mid-run and only emits one .sby task that\nvacuously passes, the old `passed > 0 and failed == 0` rule would\nreturn success. EXPECTED_MIN_CHECKS prevents that.\n\"\"\"\nimport os, shutil, subprocess, json, re, uuid\nfrom pathlib import Path\n\nimport yaml\n\nfrom tools.eval._subprocess import run_pgroup\n\n\ndef read_nret(core_yaml_path: Path) -> int:\n    \"\"\"Read the `nret` field from a core.yaml. Defaults to 2 when the file\n    or field is missing — preserves backward compat with cores authored\n    before the nret-aware fixture (every existing core today).\n\n    Only 1 and 2 are supported. NRET=1 selects the single-issue formal\n    wrapper (wrapper_si.sv + checks_si.cfg); NRET=2 uses the dual-channel\n    default (wrapper.sv + checks.cfg).\n    \"\"\"\n    p = Path(core_yaml_path)\n    if not p.exists():\n        return 2\n    y = yaml.safe_load(p.read_text()) or {}\n    n = y.get(\"nret\", 2)\n    if n not in (1, 2):\n        raise ValueError(f\"core.yaml nret must be 1 or 2, got {n!r}\")\n    return n\n\n# Floor on how many .sby tasks must pass for a \"formal: green\" result.\n# V0 baseline produces 53. Allow some slack (≥50) so a future checks.cfg\n# tweak that legitimately drops 1-2 checks doesn't trigger a false alarm,\n# but reject a partial genchecks run that emits 1-2 tasks.\nEXPECTED_MIN_CHECKS = int(os.environ.get(\"FORMAL_MIN_CHECKS\", \"50\"))\n\n\n# Patterns that prove SBY actually executed at least one check before the\n# post-run `*.sby` glob came up empty. Any one of these in the output\n# means `no_checks_generated` is the wrong label — checks DID generate,\n# they just got wiped or interrupted between SBY's output and the tally.\n_SBY_RAN_PATTERNS = (\n    re.compile(r'^SBY \\d+:\\d+\n…[16117 of 19189 chars elided by tools/bench/transcript.py; sha256:36fb930df445d4cb]…\npy:3:experiments/hypotheses/hyp-{id}.yaml.\ntools/agents/hypothesis.py:8:experiments/hypotheses/ is reverted and the run is rejected. Without that,\ntools/agents/hypothesis.py:47:        rf\"^cores/{re.escape(target)}/experiments/hypotheses/[^/]+\\.(yaml|yml)$\"\ntools/agents/hypothesis.py:54:    Concurrent hypothesis agents share `cores/<target>/experiments/hypotheses/`\ntools/agents/hypothesis.py:64:        rf\"^cores/{re.escape(target)}/experiments/hypotheses/({alt})\\.(yaml|yml)$\"\ntools/agents/hypothesis.py:334:     cores/{target}/experiments/hypotheses/<id>.yaml\ntools/agents/hypothesis.py:457:    (default: any YAML in experiments/hypotheses/), revert those changes\ntools/agents/hypothesis.py:475:                         YAMLs to cores/<target>/experiments/hypotheses/.\ntools/agents/hypothesis.py:487:    # Stream agent output to cores/<target>/experiments/hypotheses/.agent.{hyp_id}.log\ntools/agents/hypothesis.py:557:                                  lambda p: p.startswith(f\"cores/{target}/experiments/hypotheses/\"))\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/rtl/div_unit.sv')\ns = p.read_text()\ns = s.replace('    always_ff @(posedge clock) begin\\\\n      if (first_round) multiple_fits_q[d] <= divisor_q <= MAX_DIVISOR;',\n              '    always_ff @(posedge clock) begin\\\\n'\n              '      /* verilator lint_off CMPCONST */\\\\n'\n              '      if (first_round) multiple_fits_q[d] <= divisor_q <= MAX_DIVISOR;\\\\n'\n              '      /* verilator lint_on CMPCONST */')\np.write_text(s)\nPY\nmake lint TARGET=bench && python -m pytest -q cores/bench/test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json, jsonschema, yaml\npath = Path('cores/bench/experiments/hypotheses/hyp-20261123-001-r5s0.yaml')\nhypothesis = yaml.safe_load(path.read_text())\njsonschema.validate(hypothesis, json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nassert hypothesis['id'] == path.stem\nassert hypothesis['category'] == 'micro_opt'\nimpact = hypothesis['expected_impact']['fitness_delta_pct']\nassert type(impact) is int and -50 <= impact <= 50\nassert all((path.parents[2] / entry['file']).is_file() for entry in hypothesis['changes'])\nprint('YAML schema, expected impact, ID and target paths validated.')\ncycles = 4527760\nscore = 88252000 * 10 / cycles\nprint(f'{score:.4f} iterations/s at {cycles:,} cycles, {(score/169.95 - 1)*100:.4f}% above the champion.')\nPY\ngit status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
