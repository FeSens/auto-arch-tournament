{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'set -e\nfor variant in compact-ring shift-head; do\n  mkdir -p \"variants/$variant\"\n  cp -r cores/bench/rtl \"variants/$variant/\"\ndone\npython3 - <<'\"'PY'\nfrom pathlib import Path\n\nring = Path(\\\"variants/compact-ring/rtl/if_stage.sv\\\")\nsource = ring.read_text()\nsource = source.replace(\\\"fetch_packet_t live_packet, queued_packet, decode_packet;\\\", \\\"fetch_packet_t live_packet, decode_packet;\\\")\nsource = source.replace(\\\"  logic [3:0] head_q, write_slot_q;\\\", \\\"  logic [3:0] head_q, write_slot_q, read_slot;\\\")\nsource = source.replace(\\\"      if (recovery_active || (empty && push))\\\\n        head_q <= write_slot_q;\\\\n      else if (pop && (push || \"'!occupancy_q[1]))\", \"      if (recovery_active)'\"\\\\n        head_q <= write_slot_q;\\\\n      else if (pop)\\\")\nsource = source.replace(\\\"    queued_packet = '0;\\\", \\\"    decode_packet = {PACKET_WIDTH{empty}} & live_packet;\\\")\nsource = source.replace(\\\"      queued_packet |= packets_q[slot] & {PACKET_WIDTH{head_q[slot]}};\\\", \\\"      decode_packet |= packets_q[slot] & {PACKET_WIDTH{read_slot[slot]}};\\\")\nsource = source.replace(\\\"  assign decode_packet        = empty ? live_packet : queued_packet;\\\", \\\"  assign read_slot = head_q & {4{\"'!empty}};\")\nring.write_text(source)\n\nshift = Path(\"variants/shift-head/rtl/if_stage.sv\")\nsource = shift.read_text()\nsource = source[:source.index(\"  fetch_packet_t live_packet, queued_packet, decode_packet;\")] + \"\"\"  fetch_packet_t live_packet, decode_packet;\n  fetch_packet_t packets_q [0:3];\n  logic [4:0] occupancy_q, occupancy_after_pop;\n  logic empty, space_available, push, pop;\n\n  assign recovery_active = !select_normal_q;\n  assign empty = recovery_active || occupancy_q[0];\n  assign space_available = recovery_active || !occupancy_q[4];\n  assign fetch_advance = imem_ready && space_available;\n  assign push = fetch_advance && (!empty || !decode_accept);\n  assign pop = !empty && decode_accept;\n  assign occupancy_after_pop = recovery_active ? 5'\"'b00001\n                             : pop ? occupancy_q >> 1 : occupancy_q;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      occupancy_q <= 5'b00001;\n    else\n      occupancy_q <= push ? occupancy_after_pop << 1 : occupancy_after_pop;\n  end\n\n  assign imem_addr = {fetch_page, fetch_word, 2'b00};\n  assign live_packet = {imem_addr, imem_data, predicted_taken};\n\n  for (genvar slot = 0; slot < 4; slot++) begin : g_packet\n    if (slot < 3) begin : g_shift\n      logic has_successor;\n      assign has_successor = |occupancy_q[4:slot+2];\n      always_ff @(posedge clock) begin\n        if (pop && has_successor)\n          packets_q[slot] <= packets_q[slot+1];\n        else if (space_available && occupancy_after_pop[slot])\n          packets_q[slot] <= live_packet;\n      end\n    end else begin : g_last\n      always_ff @(posedge clock) begin\n        if (space_available && occupancy_after_pop[slot])\n          packets_q[slot] <= live_packet;\n      end\n    end\n  end\n\n  assign decode_packet       = empty ? live_packet : packets_q[0];\n  assign out.pc              = decode_packet.pc;\n  assign out.instr           = decode_packet.instr;\n  assign out.predicted_taken = decode_packet.predicted_taken;\n  assign out.valid           = \"'!empty || imem_ready;\nendmodule\n\"\"\"\nshift.write_text(source)\nPY\ncat > variants/run-timing.py <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom tools.eval import gowin\n\nvariant = Path(\\\"variants\\\") / sys.argv[1]\nruns = gowin.build_all(\\\".\\\", variant / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", variant / \\\"timing\\\")\nprint(gowin.summarize(runs))\nfor run in runs:\n    print(run[\\\"place_option\\\"], run[\\\"fmax_mhz\\\"])\n    for p in run.get(\\\"critical_paths\\\", [])[:5]:\n        print(p[\\\"arrival_ns\\\"], p[\\\"from\\\"], p[\\\"to\\\"], p[\\\"modules\\\"])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
