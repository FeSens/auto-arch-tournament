{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/86dd60e1/4bbf00b2/bench-predictor.njmLuHJM/replay.cpp' <<'CPP'\n#include <algorithm>\n#include <array>\n#include <cassert>\n#include <cstdint>\n#include <cstdio>\n#include <vector>\n\nstruct Instruction {\n    uint32_t insn, pc, successor, baseline_cycle, rd, trap, rmask, wmask;\n    uint32_t opcode() const { return insn & 127; }\n    bool branch() const { return opcode() == 0x63 && ((insn >> 12) & 6) \"'!= 2; }\n    bool jal() const { return opcode() == 0x6f; }\n    bool jalr() const { return opcode() == 0x67 && (insn & 0x7000) == 0; }\n    bool memory() const { return rmask || wmask; }\n    bool conditional_taken() const {\n        assert(!branch() || direct_target() != pc + 4);\n        return successor != pc + 4;\n    }\n    uint32_t direct_target() const {\n        uint32_t sign = insn >> 31 ? -1u : 0;\n        if (branch()) return pc + ((sign << 12) | ((insn & 128) << 4) |\n                                    ((insn >> 20) & 0x7e0) | ((insn >> 7) & 30));\n        return pc + ((sign << 20) | (insn & 0xff000) |\n                     ((insn >> 9) & 0x800) | ((insn >> 20) & 0x7fe));\n    }\n    bool backward() const { return (insn >> 31) != 0; }\n    bool uses_raw(uint32_t reg) const {\n        return reg == ((insn >> 15) & 31) || reg == ((insn >> 20) & 31);\n    }\n};\n\nstruct Policy {\n    unsigned entries;\n    unsigned history_width;\n    bool fold_pc;\n    bool agree;\n};\n\nstatic bool ready(uint32_t& rng) {\n    rng ''^= rng << 13;\n    rng ''^= rng >> 17;\n    rng ''^= rng << 5;\n    return (rng & 127u) < 100;\n}\n\nstatic void replay(const std::vector<Instruction>& trace, uint32_t start_marker, uint32_t stop_marker,\n                   Policy policy) {\n    std::array<int, 1024> counters;\n    counters.fill(-1);\n    bool baseline = policy.entries == 0;\n    bool dynamic = policy.entries > 1;\n    unsigned mask = policy.entr