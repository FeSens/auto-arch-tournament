{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$TMPDIR/bench-equality.K89Qaf\"\ncat > \"$scratch/refine.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch=Path(__file__).resolve().parent\nfor name in ('nibbles','halfwords','wb_compare','group_pair','lane_decode'):\n    dest=scratch/name/'rtl'\n    shutil.copytree(scratch/'compact_mask'/'rtl',dest,dirs_exist_ok=True)\n    def change(file,*pairs):\n        p=dest/f'{file}.sv'\n        s=p.read_text()\n        for before,after in pairs:\n            assert before in s, before\n            s=s.replace(before,after)\n        p.write_text(s)\n\n    if name == 'wb_compare':\n        # Reuse the captured load writeback and move the whole equality into MEM.\n        change('core_pkg',\n            ('    logic [3:0]  byte_equal;\\\\n    logic [3:0]  lanes;',\n             '    logic [31:0] other_operand;'))\n        change('core',\n            ('''    .load_raw             (io_dmemRData),\n    .load_lane            (ex_mem_w.effective_addr[1:0]),\n    .load_width           (ex_mem_w.ctrl.mem_width),\n    .load_signed          (ex_mem_w.ctrl.mem_sext),\n''', ''))\n        p=dest/'ex_stage.sv'\n        s=p.read_text()\n        a=s.index('  logic word_load')\n        b=s.index('  assign late_compare.equality_misses', a)\n        s=s[:a] + '''  logic single_match;\n  assign single_match = in.load_match.rs1 \"'^ in.load_match.rs2;\n  assign late_compare.other_operand = other_operand;\n  assign late_compare.check_lanes = load_writes && single_match;\n  assign late_compare.can_equal = load_writes || branch_equal;\n'\"''' + s[b:]\n        a=s.index('  input  logic [31:0]        load_raw')\n        b=s.index('  input  logic               load_writes', a)\n        p.write_text(s[:a] + s[b:])\n        change('mem_stage', ('(&late_branch.byte_equal)', '(late_branch.other_operand == reg_q.result)'))\n    elif name == 'lane_decode':\n        change('core_p