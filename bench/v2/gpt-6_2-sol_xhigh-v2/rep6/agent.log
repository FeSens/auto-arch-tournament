{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r11s2-profile/model.cc\" <<'\"'EOF'\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <fstream>\n#include <unordered_map>\n#include <vector>\n#include <algorithm>\n#include <cassert>\n\n#pragma pack(push, 1)\nstruct Retire {\n    uint32_t pc, npc, insn, cycle;\n    uint8_t trap;\n};\n#pragma pack(pop)\n\nstatic uint32_t opcode(const Retire &r) { return r.insn & 127; }\n\nstatic bool traceable(const Retire &r) {\n    const auto op = opcode(r);\n    return \"'!r.trap && op != 0x67 && op != 0x73 && op != 0x0f &&\n           ((r.pc ''^ r.npc) < 4096) && !(r.npc & 3);\n}\n\nstruct Closure {\n    uint32_t head{}, tail{};\n    int len{};\n    uint64_t signature{};\n    bool operator==(const Closure &other) const {\n        return head == other.head && tail == other.tail && len == other.len &&\n               signature == other.signature;\n    }\n};\n\nstruct Trace {\n    Closure shape{};\n    std::vector<Retire> path{};\n    int install{-1};\n    int last{-1};\n};\n\nint main(int argc, char **argv) {\n    FILE *f = fopen(argv[1], \"rb\");\n    std::vector<Retire> ops(3000000);\n    ops.resize(fread(ops.data(), sizeof(Retire), ops.size(), f));\n    fclose(f);\n    const bool useSignature = argc > 2 && atoi(argv[2]);\n    const bool blockExitUntilHeadConfirmed = argc > 3 && atoi(argv[3]);\n\n    for (int cap : {16, 24, 32, 48, 64}) {\n      for (int ways : {1, 2, 3, 4}) {\n        std::array<Closure, 32> lastClosure{};\n        std::unordered_map<uint32_t, int> heads, retiredAtHeads;\n        std::vector<Trace> banks(ways);\n        const int startCycle = 14189, stopCycle = 3872946;\n        int active = -1, slot = 0, segmentStart = 0, cover = 0, misses = 0;\n        int admits = 0, installed = 0, captureFree = 0;\n        for (int i = 0; i < static_cast<int>(ops.size()); ++i) {\n            const Retire &r = ops[i];\n            const bool timed = r.cycle >= startCycle && r.cycle < stopCycle;\n            if (r.trap || opcode(r) == 0x0f) {\n                active = -1;\n                if (opcode(r) == 0x0f && ((r.insn >> 12) & 7) == 1) {\n                    for (auto &bank : banks) bank = {};\n                    lastClosure = {};\n                }\n            }\n            if (active < 0) {\n                for (int way = 0; way < ways; ++way) {\n                    if (banks[way].install >= 0 && banks[way].install <= i &&\n                        banks[way].shape.head == r.pc) {\n                        active = way;\n                        slot = 0;\n                        banks[way].last = i;\n                        if (timed) {\n                            ++admits;\n                            ++heads[r.pc];\n                        }\n                        break;\n                    }\n                }\n            }\n            if (active >= 0) {\n                Trace &b = banks[active];\n                const Retire &predicted = b.path[slot];\n                assert(predicted.pc == r.pc && predicted.insn == r.insn);\n                if (timed) {\n                    ++cover;\n                    ++retiredAtHeads[b.shape.head];\n                }\n                if (predicted.npc != r.npc) {\n                    if (timed) ++misses;\n                    if (blockExitUntilHeadConfirmed && predicted.pc != b.shape.tail)\n                        b.install = -1;\n                    active = -1;\n                } else if (++slot == b.shape.len) {\n                    slot = 0;\n                }\n            }\n\n            if (!traceable(r)) {\n                segmentStart = i+1;\n                continue;\n            }\n            if (opcode(r) != 0x63 || r.npc > r.pc || i < captureFree) continue;\n            int head = i - 1;\n            const int limit = std::max(segmentStart, i-cap+1);\n            for (; head >= limit && ops[head].pc != r.npc; --head) {}\n            if (head < limit) continue;\n            Closure c{};\n            c.head = r.npc;\n            c.tail = r.pc;\n            c.len = i-head+1;\n            if (useSignature) {\n                c.signature = 0x9e3779b97f4a7c15UL;\n                for (int j=head; j <= i; ++j) {\n                    c.signature ''^= (static_cast<uint64_t>(ops[j].pc)<<32) | ops[j].npc;\n                    c.signature *= 0xff51afd7ed558ccdUL;\n                }\n            }\n            auto &prev = lastClosure[((c.head >> 2) ''^ (c.head >> 7)) & 31];\n            const bool repeated = prev == c;\n            prev = c;\n            if (!repeated) continue;\n\n            bool resident = false;\n            int victim = -1;\n            for (int way = 0; way < ways; ++way) {\n                if (banks[way].install >= 0 && banks[way].shape == c) {\n                    resident = true;\n                    break;\n                }\n                if (active == way) continue;\n                if (banks[way].install >= 0 && banks[way].shape.head == c.head) {\n                    victim = way;\n                    break;\n                }\n                if (victim < 0 || banks[way].install < 0 ||\n                    banks[way].last < banks[victim].last) victim = way;\n            }\n            if (resident || victim < 0 || (active >= 0 && banks[active].shape.head == c.head)) continue;\n            banks[victim].shape = c;\n            banks[victim].path.assign(ops.begin()+head, ops.begin()+i+1);\n            banks[victim].install = i+4+c.len;\n            banks[victim].last = i;\n            captureFree = banks[victim].install;\n            if (timed) ++installed;\n        }\n        printf(\"%d words %d ways: covers %d, side exits %d, admits %d, installs %d, heads %zu'\"\\\\n\\\",\n               cap,ways,cover,misses,admits,installed,heads.size());\n      }\n    }\n}\nEOF\nc++ -std=c++17 -O3 \\\"\"'$TMPDIR/r11s2-profile/model.cc\" -o \"$TMPDIR/r11s2-profile/model\" &&\n\"$TMPDIR/r11s2-profile/model\" \"$TMPDIR/r11s2-profile/rvfi.bin\" 1 0 &&\n\"$TMPDIR/r11s2-profile/model\" \"$TMPDIR/r11s2-profile/rvfi.bin\" 0 0'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r11s2-profile/model.cc\" <<'\"'EOF'\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <cstdlib>\n#include <fstream>\n#include <unordered_map>\n#include <vector>\n#include <algorithm>\n#include <cassert>\n\n#pragma pack(push, 1)\nstruct Retire {\n    uint32_t pc, npc, insn, cycle;\n    uint8_t trap;\n};\n#pragma pack(pop)\n\nstatic uint32_t opcode(const Retire &r) { return r.insn & 127; }\n\nstatic bool traceable(const Retire &r) {\n    const auto op = opcode(r);\n    return \"'!r.trap && op != 0x67 && op != 0x73 && op != 0x0f &&\n           ((r.pc ''^ r.npc) < 4096) && !(r.npc & 3);\n}\n\nstruct Closure {\n    uint32_t head{}, tail{};\n    int len{};\n    uint64_t signature{};\n    bool operator==(const Closure &other) const {\n        return head == other.head && tail == other.tail && len == other.len &&\n               signature == other.signature;\n    }\n};\n\nstruct Trace {\n    Closure shape{};\n    std::vector<Retire> path{};\n    int install{-1};\n    int last{-1};\n};\n\nint main(int argc, char **argv) {\n    FILE *f = fopen(argv[1], \"rb\");\n    std::vector<Retire> ops(3000000);\n    ops.resize(fread(ops.data(), sizeof(Retire), ops.size(), f));\n    fclose(f);\n    const bool useSignature = argc > 2 && atoi(argv[2]);\n    const bool blockExitUntilHeadConfirmed = argc > 3 && atoi(argv[3]);\n\n    for (int cap : {16, 24, 32, 48, 64}) {\n      for (int ways : {1, 2, 3, 4}) {\n        std::array<Closure, 32> lastClosure{};\n        std::unordered_map<uint32_t, int> heads, retiredAtHeads;\n        std::vector<Trace> banks(ways);\n        const int startCycle = 14189, stopCycle = 3872946;\n        int active = -1, slot = 0, segmentStart = 0, cover = 0, misses = 0;\n        int admits = 0, installed = 0, captureFree = 0;\n        for (int i = 0; i < static_cast<int>(ops.size()); ++i) {\n            const Retire &r = ops[i];\n            const bool timed = r.cycle >= startCycle && r.cycle < stopCycle;\n            if (r.trap || opcode(r) == 0x0f) {\n                active = -1;\n                if (opcode(r) == 0x0f && ((r.insn >> 12) & 7) == 1) {\n                    for (auto &bank : banks) bank = {};\n                    lastClosure = {};\n                }\n            }\n            if (active < 0) {\n                for (int way = 0; way < ways; ++way) {\n                    if (banks[way].install >= 0 && banks[way].install <= i &&\n                        banks[way].shape.head == r.pc) {\n                        active = way;\n                        slot = 0;\n                        banks[way].last = i;\n                        if (timed) {\n                            ++admits;\n                            ++heads[r.pc];\n                        }\n                        break;\n                    }\n                }\n            }\n            if (active >= 0) {\n                Trace &b = banks[active];\n                const Retire &predicted = b.path[slot];\n                assert(predicted.pc == r.pc && predicted.insn == r.insn);\n                if (timed) {\n                    ++cover;\n                    ++retiredAtHeads[b.shape.head];\n                }\n                if (predicted.npc != r.npc) {\n                    if (timed) ++misses;\n                    if (blockExitUntilHeadConfirmed && predicted.pc != b.shape.tail)\n                        b.install = -1;\n                    active = -1;\n                } else if (++slot == b.shape.len) {\n                    slot = 0;\n                }\n            }\n\n            if (!traceable(r)) {\n                segmentStart = i+1;\n                continue;\n            }\n            if (opcode(r) != 0x63 || r.npc > r.pc || i < captureFree) continue;\n            int head = i - 1;\n            const int limit = std::max(segmentStart, i-cap+1);\n            for (; head >= limit && ops[head].pc != r.npc; --head) {}\n            if (head < limit) continue;\n            Closure c{};\n            c.head = r.npc;\n            c.tail = r.pc;\n            c.len = i-head+1;\n            if (useSignature) {\n                c.signature = 0x9e3779b97f4a7c15UL;\n                for (int j=head; j <= i; ++j) {\n                    c.signature ''^= (static_cast<uint64_t>(ops[j].pc)<<32) | ops[j].npc;\n                    c.signature *= 0xff51afd7ed558ccdUL;\n                }\n            }\n            auto &prev = lastClosure[((c.head >> 2) ''^ (c.head >> 7)) & 31];\n            const bool repeated = prev == c;\n            prev = c;\n            if (!repeated) continue;\n\n            bool resident = false;\n            int victim = -1;\n            for (int way = 0; way < ways; ++way) {\n                if (banks[way].install >= 0 && banks[way].shape == c) {\n                    resident = true;\n                    break;\n                }\n                if (active == way) continue;\n                if (banks[way].install >= 0 && banks[way].shape.head == c.head) {\n                    victim = way;\n                    break;\n                }\n                if (victim < 0 || banks[way].install < 0 ||\n                    banks[way].last < banks[victim].last) victim = way;\n            }\n            if (resident || victim < 0 || (active >= 0 && banks[active].shape.head == c.head)) continue;\n            banks[victim].shape = c;\n            banks[victim].path.assign(ops.begin()+head, ops.begin()+i+1);\n            banks[victim].install = i+4+c.len;\n            banks[victim].last = i;\n            captureFree = banks[victim].install;\n            if (timed) ++installed;\n        }\n        printf(\"%d words %d ways: covers %d, side exits %d, admits %d, installs %d, heads %zu'\"\\\\n\\\",\n               cap,ways,cover,misses,admits,installed,heads.size());\n      }\n    }\n}\nEOF\nc++ -std=c++17 -O3 \\\"\"'$TMPDIR/r11s2-profile/model.cc\" -o \"$TMPDIR/r11s2-profile/model\" &&\n\"$TMPDIR/r11s2-profile/model\" \"$TMPDIR/r11s2-profile/rvfi.bin\" 1 0 &&\n\"$TMPDIR/r11s2-profile/model\" \"$TMPDIR/r11s2-profile/rvfi.bin\" 0 0'", "aggregated_output": "16 words 1 ways: covers 1475213, side exits 17243, admits 17243, installs 5650, heads 22\n16 words 2 ways: covers 1557668, side exits 19359, admits 19359, installs 800, heads 24\n16 words 3 ways: covers 1562928, side exits 20671, admits 20671, installs 691, heads 24\n16 words 4 ways: covers 1563868, side exits 20731, admits 20731, installs 661, heads 24\n24 words 1 ways: covers 1489745, side exits 18081, admits 18081, installs 5754, heads 23\n24 words 2 ways: covers 1574425, side exits 20313, admits 20313, installs 945, heads 25\n24 words 3 ways: covers 1592037, side exits 21602, admits 21602, installs 757, heads 25\n24 words 4 ways: covers 1594626, side exits 22388, admits 22388, installs 681, heads 25\n32 words 1 ways: covers 1490521, side exits 17568, admits 17568, installs 6211, heads 24\n32 words 2 ways: covers 1586591, side exits 19938, admits 19938, installs 1461, heads 26\n32 words 3 ways: covers 1600945, side exits 20838, admits 20838, installs 1126, heads 26\n32 words 4 ways: covers 1605443, side exits 20988, admits 20988, installs 961, heads 26\n48 words 1 ways: covers 1490316, side exits 17553, admits 17553, installs 6222, heads 24\n48 words 2 ways: covers 1586227, side exits 19906, admits 19906, installs 1486, heads 26\n48 words 3 ways: covers 1601267, side exits 20817, admits 20817, installs 1133, heads 26\n48 words 4 ways: covers 1605848, side exits 21011, admits 21011, installs 974, heads 26\n64 words 1 ways: covers 1478527, side exits 17290, admits 17290, installs 6614, heads 25\n64 words 2 ways: covers 1588151, side exits 19547, admits 19547, installs 1622, heads 28\n64 words 3 ways: covers 1602816, side exits 20468, admits 20468, installs 1348, heads 28\n64 words 4 ways: covers 1610102, side exits 20710, admits 20710, installs 1056, heads 28\n16 words 1 ways: covers 1475