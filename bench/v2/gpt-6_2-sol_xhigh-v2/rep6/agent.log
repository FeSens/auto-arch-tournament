{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c \"cat >> '/srv/hwebench/tmp/86dd60e1/f56da8f4/bench-profile.o5QOsB/late_suite/test/test_pipeline.py' <<'PY'\n\n@cocotb.test()\n@cocotb.parametrize(stalls=[0, 4], swap=[False, True])\nasync def paired_load_branch_retires_without_a_gap(dut, stalls, swap):\n    # The signed byte in lane 2 compares equal to the older ALU result.\n    a, b = (2, 1) if swap else (1, 2)\n    program = [ADDI(2, 0, -128), LB(1, 0, 0x82), BNE(a, b, 12),\n               ADDI(3, 0, 1), EBREAK(), EBREAK()]\n    requests = []\n    rets, _ = await _run(dut, program, dmem_init={0x80: 0x00800000},\n                         dmem_stalls={0x82: stalls}, dmem_trace=requests)\n    _assert_retirement_path(rets, [0, 4, 8, 12, 16])\n    assert rets[2]['cycle'] - rets[1]['cycle'] == 1\n    assert rets[2]['rs1_rdata'] == rets[2]['rs2_rdata'] == 0xFFFFFF80\n    assert requests == [(0x82, 1, 0, 0, False)] * stalls + [(0x82, 1, 0, 0, True)]\n\n@cocotb.test()\n@cocotb.parametrize(fault=[False, True], wrong_divide=[False, True])\nasync def paired_load_branch_redirect_suppresses_side_effects(dut, fault, wrong_divide):\n    load = LH(1, 0, 0x81) if fault else LW(1, 0, 0x80)\n    wrong = DIV(3, 2, 1) if wrong_divide else SW(2, 0, 0x84)\n    program = [ADDI(1, 0, 4), ADDI(2, 0, 4), load, BEQ(1, 2, 12),\n               wrong, EBREAK(), DIV(3, 2, 1), EBREAK()]\n    requests = []\n    rets, _ = await _run(dut, program, dmem_init={0x80: 4}, dmem_trace=requests)\n    _assert_retirement_path(rets, [0, 4, 8, 12, 24, 28])\n    assert rets[2]['trap'] == fault\n    assert rets[3]['rs1_rdata'] == rets[3]['rs2_rdata'] == 4\n    assert rets[4]['rd_wdata'] == 1\n    assert rets[4]['cycle'] - rets[3]['cycle'] == 10\n    assert requests == ([] if fault else [(0x80, 1, 0, 0, True)])\nPY\ncd '/srv/hwebench/tmp/86dd60e1/f56da8f4/bench-profile.o5QOsB/late_suite'\npython -m pytest --rootdir=. -q -p no:cacheprovider test/test_pipeline.py > ../late_cocotb_directed.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
