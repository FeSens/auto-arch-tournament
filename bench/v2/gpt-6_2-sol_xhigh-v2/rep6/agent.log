{"type":"item.completed","item":{"id":"item_139","type":"command_execution","command":"/bin/bash -c 'git show HEAD:cores/bench/rtl/replay_table.sv'","aggregated_output":"// Two synchronous banks read the normal fetch PC and its sequential\n// successor. Either address can be the normal PC at the next edge.\nmodule replay_table (\n  input  logic           clock,\n  input  logic           reset,\n  input  logic           invalidate,\n  input  replay_update_t update,\n  input  logic [31:2]    normal_pc,\n  output logic           hit,\n  output replay_packet_t packet\n);\n\n  replay_row_t even_read_q, odd_read_q;\n  localparam integer ROW_WIDTH = $bits(even_read_q);\n  (* syn_ramstyle = \"block_ram\" *) logic [ROW_WIDTH-1:0] even_rows [0:255];\n  (* syn_ramstyle = \"block_ram\" *) logic [ROW_WIDTH-1:0] odd_rows [0:255];\n  logic [255:0] even_valid_q, odd_valid_q;\n  logic even_available_q, odd_available_q;\n  logic [7:0] even_index, odd_index, write_index;\n  logic clear, write_even, write_odd, even_hit, odd_hit;\n\n  // The odd word is in the current pair. The even word is in the next\n  // pair only when the current PC is odd. These inputs use only flops.\n  assign odd_index  = normal_pc[10:3];\n  assign even_index = normal_pc[10:3] + {7'b0, normal_pc[2]};\n  assign write_index = update.row.pc[10:3];\n  assign clear = reset || invalidate;\n  assign write_even = update.valid && !update.row.pc[2] && !clear;\n  assign write_odd  = update.valid &&  update.row.pc[2] && !clear;\n\n  always_ff @(posedge clock) begin\n    if (write_even)\n      even_rows[write_index] <= update.row;\n    if (write_odd)\n      odd_rows[write_index] <= update.row;\n    even_read_q <= even_rows[even_index];\n    odd_read_q  <= odd_rows[odd_index];\n  end\n\n  // Mask same-edge reads and writes to the same bank row. The packet RAMs\n  // need no reset or read-during-write behavior of their own.\n  always_ff @(posedge clock) begin\n    if (clear) begin\n      even_valid_q      <= '0;\n      odd_val