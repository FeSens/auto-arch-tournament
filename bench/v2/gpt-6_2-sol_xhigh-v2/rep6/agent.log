{"type": "item.started", "item": {"id": "item_85", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom collections import Counter\nfrom concurrent.futures import ThreadPoolExecutor\nfrom itertools import zip_longest\nimport os\nfrom pathlib import Path\nfrom tempfile import mkdtemp\nimport sys\nfrom xml.etree import ElementTree\n\nfrom cocotb_tools.runner import get_runner\n\nroot = Path.cwd()\ncurrent_rtl = root / 'cores/bench/rtl'\nbaseline_rtl = Path(os.environ['TMPDIR']) / 'fetch-diff-mm5qq85d/baseline'\nscratch = Path(mkdtemp(prefix='fetch-final-'))\nsys.path.insert(0, str(root / 'cores/bench/test'))\n\ndef record_trace(run):\n    name, rtl = run\n    folder = scratch / name\n    folder.mkdir()\n    sources = sorted(rtl.glob('*.sv'), key=lambda path: (path.name \"'!= '\"'core_pkg.sv', path.name))\n    runner = get_runner('verilator')\n    runner.build(sources=sources, hdl_toplevel='core', build_dir=folder, always=True,\n                 waves=True, build_args=['--trace-depth', '3', '--trace-structs', '--trace-max-array', '8'],\n                 log_file=folder / 'build.log')\n    results = runner.test(hdl_toplevel='core', test_module='test_pipeline', test_dir=folder,\n                          build_dir=folder, waves=True, log_file=folder / 'sim.log')\n    tests = ElementTree.parse(results).findall('.//testcase')\n    assert len(tests) == 56 and not any(test.find('failure') is not None for test in tests), results\n    return folder / 'dump.vcd'\n\nfixed = ('io_imemAddr io_imemReady io_dmemReady io_dmemREn io_dmemWEn '\n         'decode_accept correction_q correction_mem_q invalidate_replay_q ex_redirect mem_redirect fence_refetch '\n         'u_if.pc_page_q u_if.pc_word_q u_if.lookup_index_q u_if.trained_q '\n         'u_if.occupancy_q u_if.fetch_advance u_if.replay_hit u_if.replay_select u_if.push u_if.word_write').split()\n\ndef cycles(path):\n    with path.open() as trace:\n        scope, identifiers = [], {}\n        for line in trace:\n            words = line.split()\n            if not words:\n                continue\n            if words[0] == '\"'$scope'\"':\n                scope.append(words[2])\n            elif words[0] == '\"'$upscope'\"':\n                scope.pop()\n            elif words[0] == '\"'$var'\"' and scope[0] == 'core':\n                identifiers['.'.join(scope[1:] + [words[4]])] = words[3]\n            elif words[0] == '\"'$enddefinitions'\"':\n                break\n        values = {}\n        def value(name):\n            return values[identifiers[name]]\n        def fields(base, *names):\n            return tuple(value(base + name) for name in names)\n\n        rvfi = tuple(sorted(name for name in identifiers if name.startswith('io_rvfi_')))\n        watched = set(identifiers.values())\n        clock_id = identifiers['clock']\n        previous_clock, timestamp = 0, 0\n        for line in trace:\n            if line[0] == '#':\n                clock = values.get(clock_id, 0)\n                if previous_clock and not clock and not value('reset'):\n                    recorded = dict(zip(fixed, map(value, fixed)))\n                    ready, correction, advance, hit = map(value, ('io_imemReady', 'correction_q', 'u_if.fetch_advance', 'u_if.replay_hit'))\n                    pc = (value('u_if.pc_page_q') << 12) | (value('u_if.pc_word_q') << 2)\n                    assert value('u_if.lookup_index_q') == ((pc >> 2) \"'^ (pc >> 8)) & 63, (timestamp, pc)\n                    if correction or advance:\n                        recorded['\"'next_fetch'] = fields('u_if.', 'next_word', 'next_index', 'page_write')\n                    if not correction and (ready or hit):\n                        recorded['prediction'] = fields('u_if.', 'normal_taken', 'direction_trained')\n                    if value('if_id_w.valid'):\n                        recorded['decode_packet'] = fields('if_id_w.', 'pc', 'instr', 'predicted_taken')\n                    if value('ex_in.valid'):\n                        recorded['execute_packet'] = fields('ex_in.', 'pc', 'instr', 'predicted_taken')\n                    if value('u_if.push'):\n                        recorded['push_packet'] = fields('u_if.enqueue_packet.', 'pc', 'instr', 'predicted_taken')\n                    if value('predictor_update.valid'):\n                        recorded['direction_update'] = fields('predictor_update.', 'index', 'taken') + (value('mem_in.pc'),)\n                    if value('io_rvfi_valid_0'):\n                        recorded['rvfi'] = tuple(map(value, rvfi))\n                    if value('io_dmemWEn') or value('io_dmemREn'):\n                        recorded['data_req'] = fields('', 'io_dmemAddr', 'io_dmemWData')\n                    yield timestamp, recorded\n                previous_clock, timestamp = clock, int(line[1:])\n            elif line[0] == 'b':\n                bits, identifier = line[1:].split()\n                if identifier in watched:\n                    values[identifier] = int(bits, 2)\n            elif line[0] in '01':\n                identifier = line[1:].strip()\n                if identifier in watched:\n                    values[identifier] = int(line[0])\n\nprint(f'Directed cycle traces in {scratch}', flush=True)\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    baseline, candidate = pool.map(record_trace, (('baseline', baseline_rtl), ('candidate', current_rtl)))\n\ncoverage = Counter()\nseen_trainers = {}\nlast_time = 0\nfor pair in zip_longest(cycles(baseline), cycles(candidate)):\n    assert None not in pair\n    (old_time, old), (new_time, new) = pair\n    assert old_time == new_time, pair\n    differences = {field: (old.get(field), new.get(field)) for field in old.keys() | new.keys() if old.get(field) \"'!= new.get(field)}\n    assert not differences, (old_time, differences)\n    if new_time - last_time > 10000:\n        seen_trainers.clear()\n    last_time = new_time\n    if '\"'direction_update' in new:\n        index, _, pc = new['direction_update']\n        coverage['alias training updates'] += index in seen_trainers and seen_trainers[index] \"'!= pc\n        seen_trainers[index] = pc\n    coverage['\"'compared cycles'] += 1\n    coverage['live advances'] += bool(new['io_imemReady'] and new['u_if.fetch_advance'])\n    coverage['replay advances'] += bool(new['u_if.replay_select'] and new['u_if.fetch_advance'])\n    coverage['replay misses'] += not (new['io_imemReady'] or new['correction_q'] or new['u_if.replay_hit'])\n    coverage['full queue holds'] += new['u_if.occupancy_q'] == 15 and not new['u_if.word_write']\n    coverage['sequential page wraps'] += new['io_imemAddr'] & 0xfff == 0xffc and bool(new.get('next_fetch')) and new['next_fetch'][0] == 0\n    coverage['simultaneous EX and MEM redirects'] += bool(new['ex_redirect'] and new['mem_redirect'])\n    coverage['retirements'] += 'rvfi' in new\nassert all(coverage.values()), coverage\nfor name, count in coverage.items():\n    print(f'{name}: {count}')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
