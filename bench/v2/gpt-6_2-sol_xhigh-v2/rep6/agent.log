 logic [8:0] small_difference [1:15];\n  logic [3:0] digit, small_digit, next_digit, small_remainder;\n  logic [31:0] full_remainder;\n  wire [35:0] trial = {remainder_q, quotient_q[31:28]};\n  wire [3:0] head = quotient_q[31:28];\n  wire small_divisor = divisor_q[31:4] == 28'b0;\n\n  assign multiple[1] = {4'b0, divisor_q};\n  assign residual[0] = trial[31:0];\n  assign small_residual[0] = head;\n  assign fits[0] = 1'b1;\n  assign small_fits[0] = 1'b1;\n\n  for (genvar i = 1; i < 16; i++) begin : gen_trial\n    localparam logic [7:0] K = 8'(i);\n    wire [7:0] small_multiple = K * {4'b0, divisor_q[3:0]};\n    if (i % 2 == 0) begin : gen_even\n      assign multiple[i] = multiple[i/2] << 1;\n    end else if (i \"'!= 1) begin : gen_odd_input\n      assign multiple[i] = odd_multiple_q[(i-1)/2];\n    end\n    assign difference[i] = {1'\"'b0, trial} - {1'b0, multiple[i]};\n    assign fits[i] = \"'!difference[i][36];\n    assign residual[i] = difference[i][31:0];\n    assign small_difference[i] = {5'\"'b0, head} - {1'b0, small_multiple};\n    assign small_fits[i] = small_divisor && \"'!small_difference[i][8];\n    assign small_residual[i] = small_difference[i][3:0];\n  end\n\n  assign chosen = fits & ~{1'\"'b0, fits[15:1]};\n  assign small_chosen = small_fits & ~{1'b0, small_fits[15:1]};\n  for (genvar i = 0; i < 4; i++) begin : gen_digit\n    wire [15:0] digit_bits, small_digit_bits, small_remainder_bits;\n    for (genvar k = 0; k < 16; k++) begin : gen_select\n      assign digit_bits[k] = chosen[k] && ((k & (1 << i)) \"'!= 0);\n      assign small_digit_bits[k] = small_chosen[k] && ((k & (1 << i)) != 0);\n      assign small_remainder_bits[k] = small_chosen[k] && small_residual[k][i];\n    end\n    assign digit[i] = |digit_bits;\n    assign small_digit[i] = |small_digit_bits;\n    assign small_remainder[i] = |small_remainder_bits;\n  end\n  for (genvar i = 0; i < 32; i++) begin : gen_remainder\n    wire [15:0] remainder_bits;\n    for (genvar k = 0; k < 16; k++) begin : gen_select\n      assign remainder_bits[k] = chosen[k] && residual[k][i];\n    end\n    assign full_remainder[i] = |remainder_bits;\n  end\n\n  assign next_digit = rounds_left == 4'\"'d8 ? small_digit : digit;\n  assign quotient_next = {quotient_q[27:0], next_digit};\n  assign remainder_next = rounds_left == 4'd8 ? {28'b0, small_remainder} : full_remainder;\n  // The output is sampled only on the full-width final update.\n  assign result_magnitude = want_remainder_q ? full_remainder : {quotient_q[27:0], digit};\n  assign result_negate = negate_result_q;\n\n  always_ff @(posedge clock) begin\n    if (issue) begin\n      quotient_q       <= dividend;\n      divisor_q        <= divisor;\n      want_remainder_q <= want_remainder;\n      negate_result_q  <= want_remainder ? a_negative\n                                        : (a_negative \"'^ b_negative) && (b != 32'\"'b0);\n    end else if (\"'!request_ready && !result_valid) begin\n      quotient_q       <= quotient_next;\n      remainder_q      <= remainder_next;\n    end\n  end\n'\"''' + src[end:])\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nscratch = Path('/srv/hwebench/tmp/86dd60e1/2ffb5f91/r5s1-prototype.evMKARZm')\nresult = build(Path.cwd(), scratch / 'rtl', 'fpga/core_bench_si.sv', 0, scratch / 'timing' / 'p0')\nprint({k: v for k, v in result.items() if k \"'!= '\"'critical_paths'})\nfor timing_path in result.get(\\\"critical_paths\\\", [])[:3]:\n    print(timing_path)\nPY\"", "aggregated_output": "{'place_option': 0, 'placement_failed': False, 'fmax_mhz': 78.54, 'levels': 13, 'logic': 4407, 'regs': 904, 'lutram': 40, 'bsram': 4, 'dsp': 7}\n{'from': 'cpu/u_mem/reg_q.result_6_s0', 'to': 'cpu/u_id/reg_q.alu_a_sel.local_value_s0', 'slack_ns': -7.732, 'arrival_ns': 18.027, 'logic_cells': 35, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_fwd']}\n{'from': 'cpu/u_id/reg_q.alu_b_sel.local_value_s0', 'to': 'cpu/u_ex/reg_q.alu_result_23_s0', 'slack_ns': -7.708, 'arrival_ns': 18.002, 