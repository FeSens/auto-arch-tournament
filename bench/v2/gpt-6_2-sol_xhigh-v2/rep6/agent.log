{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c 'variant_base=$(mktemp -d \"$TMPDIR/bench-r7s2-compare.XXXXXX\")\nprintf '\"'%s\\\\n' \\\"\"'$variant_base\"\ncat > \"$variant_base/compare.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nmode, root = sys.argv[1:]\nrtl = Path(root) / 'cores/bench/rtl'\nex = rtl / 'ex_stage.sv'\nsource = ex.read_text()\nstart = source.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\nend = source.index('  assign branch_taken =', start)\n\nif mode == 'byte':\n    section = '''  logic [3:0] equal_byte, less_byte;\n  logic ordered_less, full_equal;\n  logic signed_order, sign_diff;\n\n  assign signed_order = \"'!in.ctrl.branch_op[1];\n  assign sign_diff = rs1[31] ''^ rs2[31];\n\n  for (genvar b = 0; b < 4; b++) begin : g_cmp\n    assign equal_byte[b] = rs1[b*8 +: 8] == rs2[b*8 +: 8];\n    assign less_byte[b] = rs1[b*8 +: 8] < rs2[b*8 +: 8];\n  end\n  assign full_equal = &equal_byte;\n  assign ordered_less = (signed_order && sign_diff) ? rs1[31] :\n                        less_byte[3] || (equal_byte[3] && less_byte[2])\n                                     || ( (&equal_byte[3:2]) && less_byte[1])\n                                     || ( (&equal_byte[3:1]) && less_byte[0]);\n  assign branch_cond = (in.ctrl.branch_op[2] ? ordered_less : full_equal)\n                     ''^ in.ctrl.branch_op[0];\n\n'\"'''\nelse:\n    chunk_values = {'prebyte': (8, 4), 'prenibble': (4, 8), 'prepair': (2, 16)}\n    width, groups = chunk_values[mode]\n    section = f'''  localparam integer GROUPS = {groups};\n  localparam integer GROUP_WIDTH = {width};\n  logic [GROUP_WIDTH-1:0] group_a [0:GROUPS-1];\n  logic [GROUP_WIDTH-1:0] group_b [0:GROUPS-1];\n  logic [GROUPS-1:0] same, upper_same, less;\n  logic order_less, full_equal;\n\n  for (genvar g = 0; g < GROUPS; g++) begin : g_compare\n    if (g == GROUPS-1) begin : g_top\n      assign group_a[g] = rs1[g*GROUP_WIDTH +: GROUP_WIDTH]\n   