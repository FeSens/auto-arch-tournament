{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r8s1-width/make_bank_div.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nsrc, dst = map(Path, sys.argv[1:3])\ngroups = int(sys.argv[3])\nassert groups in (1, 2, 4, 8, 16)\nchunk= int(sys.argv[4]) if len(sys.argv)>4 else 0\nprep= int(sys.argv[5]) if len(sys.argv)>5 else 0\nfor p in src.glob('*.sv'):\n    (dst / p.name).write_text(p.read_text())\n\ndef patch(filename, edits):\n    path=dst / filename\n    text=path.read_text()\n    for old,new in edits:\n        assert old in text, old\n        text=text.replace(old,new,1)\n    path.write_text(text)\n\npatch('core_pkg.sv', [\n    ('  // ── Pipeline-bundle typedefs',f'''  localparam integer DIV_GROUPS = {groups};\n  typedef logic [DIV_GROUPS*32-1:0] div_terms_t;\n\n  // ── Pipeline-bundle typedefs'''),\n    ('    logic [31:0] div_magnitude;', '''    div_terms_t  div_remainder_terms;\n    logic [31:0] div_quotient;\n    logic        div_want_remainder;'''),\n])\npatch('ex_stage.sv', [\n    ('  logic [31:0] div_magnitude, div_rs1, div_rs2;', '''  logic [31:0] div_quotient, div_rs1, div_rs2;\n  div_terms_t  div_remainder_terms;\n  logic        div_want_remainder;'''),\n    ('    .result_magnitude (div_magnitude),', '''    .result_quotient  (div_quotient),\n    .result_terms     (div_remainder_terms),\n    .want_remainder   (div_want_remainder),'''),\n    ('      reg_q.div_magnitude <= div_magnitude;', '''      reg_q.div_quotient  <= div_quotient;\n      reg_q.div_remainder_terms <= div_remainder_terms;\n      reg_q.div_want_remainder  <= div_want_remainder;'''),\n])\npatch('mem_stage.sv', [\n    ('  assign div_result = in.div_negate ? -in.div_magnitude : in.div_magnitude;', '''  logic [31:0] div_remainder, div_magnitude;\n  always_comb begin\n    div_remainder = '0;\n    for (int bank = 0; bank < DIV_GROUPS; bank++)\n      div_remainder |= in.div_remainder_terms[bank*32 +: 32];\n  end\n  assign div_magnitude = in.div_want_remainder ? div_remainder : in.div_quotient;\n  assign div_result = in.div_negate ? -div_magnitude : div_magnitude;''')\n])\npath=dst/'div_unit.sv'\ns=path.read_text()\ns=s.replace('  output logic [31:0] result_magnitude,','''  output logic [31:0] result_quotient,\n  output div_terms_t  result_terms,\n  output logic        want_remainder,''')\ns=s.replace('  assign result_negate = 1\\\\'b0;', \\\"  assign result_negate = 1'b0;\\\\n  assign want_remainder = 1'b0;\\\\n  assign result_terms = '0;\\\")\ns=s.replace('result_magnitude =', 'result_quotient =').replace('logic signed_op, want_remainder;','logic signed_op, want_remainder_input;').replace('assign want_remainder = (op', 'assign want_remainder_input = (op').replace('<= want_remainder;', '<= want_remainder_input;').replace('<= want_remainder ?', '<= want_remainder_input ?')\na=s.index('  // Adjacent fit tests')\nb=s.index('  assign result_negate    =',a)\ns=s[:a]+'''  // Keep completion bank reductions separate until MEM. The loop still\n  // combines the banks locally to obtain the input to the next iteration.\n  for (genvar bank = 0; bank < DIV_GROUPS; bank++) begin : g_term\n    logic [31:0] term;\n    always_comb begin\n      term = '0;\n      for (int k = bank*(16/DIV_GROUPS); k < (bank+1)*(16/DIV_GROUPS); k++)\n        term |= {32{selected[k]}} & candidate_residual[k];\n    end\n    assign result_terms[32*bank +: 32] = term;\n  end\n\n  always_comb begin\n    residual = '0;\n    digit = '0;\n    for (int bank = 0; bank < DIV_GROUPS; bank++)\n      residual |= result_terms[32*bank +: 32];\n    for (int k = 0; k < 16; k++)\n      digit |= {4{selected[k]}} & 4'(k);\n  end\n\n  assign quotient_next    = {quotient_q[27:0], digit};\n  assign result_quotient  = quotient_next;\n  assign want_remainder   = want_remainder_q;\n'''+s[b:]\nif chunk:\n    assert 32 % chunk == 0\n    count=32//chunk\n    s=s.replace('    assign difference = {1\\\\'b0, trial} - {1\\\\'b0, multiple[31:0]};',f'''\n    logic [{count-1}:0] generate_borrow, equal_part;\n    logic [{count}:0] borrow_in;\n    assign borrow_in[0] = 1'b0;\n    assign difference[32] = borrow_in[{count}];\n    for (genvar part = 0; part < {count}; part++) begin : g_part\n      logic [{chunk-1}:0] x, y;\n      logic [{chunk}:0] diff;\n      logic [{chunk-1}:0] diff_with_borrow;\n      logic [part:0] terms;\n      assign x = trial[{chunk}*part +: {chunk}];\n      assign y = multiple[{chunk}*part +: {chunk}];\n      assign diff = {{1'b0, x}} - {{1'b0, y}};\n      assign diff_with_borrow = x + ~y;\n      assign generate_borrow[part] = diff[{chunk}];\n      assign equal_part[part] = x == y;\n      for (genvar from_part = 0; from_part <= part; from_part++) begin : g_borrow\n        if (from_part == part) begin\n          assign terms[from_part] = generate_borrow[from_part];\n        end else begin\n          assign terms[from_part] = generate_borrow[from_part] && (&equal_part[part:from_part+1]);\n        end\n      end\n      assign borrow_in[part+1] = |terms;\n      assign difference[{chunk}*part +: {chunk}] = borrow_in[part] ? diff_with_borrow : diff[{chunk-1}:0];\n    end''')\nif prep:\n    assert 32 % prep == 0\n    s=s.replace('  assign dividend       = a_negative ? -a : a;\\\\n  assign divisor        = b_negative ? -b : b;',f'''\n  for (genvar part = 0; part < {32//prep}; part++) begin : g_magnitude\n    logic carry_a, carry_b;\n    if (part == 0) begin : g_low\n      assign carry_a = 1'b1;\n      assign carry_b = 1'b1;\n    end else begin : g_high\n      assign carry_a = \"'!(|a[{prep}*part-1:0]);\n      assign carry_b = !(|b[{prep}*part-1:0]);\n    end\n    assign dividend[{prep}*part +: {prep}] = a_negative ? ~a[{prep}*part +: {prep}] + {prep}'\"'(carry_a)\n                                                            : a[{prep}*part +: {prep}];\n    assign divisor[{prep}*part +: {prep}] = b_negative ? ~b[{prep}*part +: {prep}] + {prep}'(carry_b)\n                                                           : b[{prep}*part +: {prep}];\n  end''')\npath.write_text(s)\nPY\nfor name in bank1 bank4 bank4split bank4prep; do\n  mkdir -p \\\"\"'$TMPDIR/bench-r8s1-$name/cores/bench/rtl\"\n  cp cores/bench/core.yaml \"$TMPDIR/bench-r8s1-$name/cores/bench/\"\n  cp -r fpga \"$TMPDIR/bench-r8s1-$name/\"\ndone\npython3 \"$TMPDIR/bench-r8s1-width/make_bank_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-bank1/cores/bench/rtl\" 1\npython3 \"$TMPDIR/bench-r8s1-width/make_bank_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-bank4/cores/bench/rtl\" 4\npython3 \"$TMPDIR/bench-r8s1-width/make_bank_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-bank4split/cores/bench/rtl\" 4 8\npython3 \"$TMPDIR/bench-r8s1-width/make_bank_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-bank4prep/cores/bench/rtl\" 4 0 8'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
