{"type":"item.started","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r13_micro/setup_finish.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path(__file__).parent\nfor name in ('neg_shift_sub', 'neg_shift_sub15', 'neg_shift_sub7', 'neg_group5_b','neg_group4_b','neg_native_chunks','neg_mask_chunks'):\n    src = root / 'neg_mult_chunks' / 'rtl'\n    rtl = root / name / 'rtl'\n    shutil.copytree(src, rtl, dirs_exist_ok=True)\n    p = rtl / 'div_unit.sv'\n    s = p.read_text()\n    if name in ('neg_shift_sub','neg_shift_sub15'):\n        s = s.replace(\\\"  logic [36:0] sum_three, carry_three;\\\\n\\\", \\\"\\\")\n        start=s.index(\\\"  assign sum_three =\\\")\n        end=s.index(\\\"  always_ff\\\",start)\n        s=s[:start]+s[end:]\n        s=s.replace(\\\"sum_terms(divisor_once, sum_three, carry_three)\\\", \\\"(divisor_once << 4) - divisor_once\\\")\n    if name in ('neg_shift_sub','neg_shift_sub7'):\n        s=s.replace(\\\"sum_terms(divisor_once, divisor_twice, divisor_four)\\\", \\\"divisor_eight - divisor_once\\\")\n    if name in ('neg_group5_b','neg_group4_b','neg_native_chunks','neg_mask_chunks'):\n        base = 'maybe_negate'\n        if name in ('neg_group5_b','neg_group4_b'):\n            new_f='maybe_negate_divisor'\n            offset={'neg_group5_b':5, 'neg_group4_b':4}[name]\n        else:\n            new_f=base\n            offset=8\n        old_start=s.index(\\\"  function automatic [31:0] maybe_negate\\\")\n        old_end=s.index(\\\"  endfunction\\\",old_start)+len(\\\"  endfunction\\\")\n        new=f'''  function automatic [31:0] {new_f}(input logic [31:0] value, input logic negate);\n'''\n        if name in ('neg_group5_b','neg_group4_b'):\n            new+=\\\"    logic [31:0] inverted;\\\\n    begin\\\\n      inverted = value \"'^ {32{negate}};'\"\\\\n\\\"\n        else:\n            new+=\\\"    begin\\\\n\\\"\n        for i in range(0,32,offset):\n            hi=min(i+