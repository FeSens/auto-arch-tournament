{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -c 'python - \"$TMPDIR\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom statistics import median\nfrom tools.eval.gowin import parse_reports\nroot = Path(sys.argv[1])\nareas = ['capacity.RjnbKb', 'squash.n2fudQ']\ncycles = {'1': 4019685, '2-original': 3978219, '2-limited': 4004524, '3-limited': 3975852}\nschedule = {'1':['one'], '2-original':['two', '2refill', 'two_alt'], '2-limited':['shift', '2ring', 'shift_alt'], '3-limited':['3ring']}\nfor family in areas:\n    for d in sorted((root / f'bench-r7s2-{family}').glob('*')):\n        key = next((k for k,modes in schedule.items() if d.name in modes),None)\n        if not key:\n            continue\n        results = [parse_reports(d / f'cores/bench/generated/timing/gowin_p{i}') for i in range(3)]\n        fs = [r['fmax_mhz'] for r in results]\n        score = 1e7 * median(fs) / cycles[key] if all(fs) else None\n        print(f'{family:<20} {d.name:<9} {str(fs):<27} {score and round(score,3)}')\nPY\ntail -3 \\\"\"'$TMPDIR/bench-r7s2-skid.5a9ieu/formal.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
