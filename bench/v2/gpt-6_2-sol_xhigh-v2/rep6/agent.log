048),       # MEM/WB base, 0x1002 -> 0x802\n        LUI(6, 1),\n        LH(5, 6, -2048),       # EX/MEM base, 0x1000 -> 0x800 (stalled)\n        LHU(7, 2, -2048),      # upper halfword written by SH\n        ADDI(9, 0, -4),\n        SW(3, 9, 8),          # 0xfffffffc + 8 wraps to 4\n        LW(10, 9, 8),\n   \n…[11511 of 14583 chars elided by tools/bench/transcript.py; sha256:e57c57421faaca62]…\n\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 1, 10, 1, 2, 1, 2, 1, 1, 1], gaps\n    assert (rets[3][\"rs1_rdata\"], rets[3][\"rd_wdata\"]) == (0xFFFFFFBB, 0xFFFFFFE9)\n    assert (rets[5][\"rs2_addr\"], rets[5][\"rs2_rdata\"], rets[5][\"rd_wdata\"]) == (5, 0xFFFFFFBB, 5)\n    assert (rets[7][\"rs1_rdata\"], rets[7][\"rs2_rdata\"], rets[7][\"rd_wdata\"]) == (\n        0xFFFFFFBB, 0xFFFFFFBB, 0xFFFFFF76)\n    assert (rets[8][\"rd\"], rets[8][\"rd_wdata\"], rets[9][\"rd_wdata\"]) == (0, 0, 0)\n\n\n@cocotb.test()\nasync def divide_waits_for_older_memory(dut):\n    program = [\n        ADDI(1, 0, -23),\n        ADDI(2, 0, 3),\n        MUL(3, 1, 2),\n        SW(2, 0, 0x80),\n        DIV(4, 3, 2),  # The older stalled store holds the MUL result in WB.\n        ADD(5, 4, 2),\n        LW(6, 0, 0x84),\n        REM(7, 6, 5),\n        ADDI(8, 7, 2),\n        EBREAK(),\n    ]\n    requests = []\n    rets, dmem = await _run(dut, program, dmem_init={0x84: 26},\n                            dmem_stalls={0x80: 11, 0x84: 2}, dmem_trace=requests)\n", "exit_code": 0, "status": "completed"}}
