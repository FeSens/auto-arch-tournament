{"type": "item.completed", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/bash -c \"sed -n '925,1002p' cores/bench/test/test_pipeline.py\npython3 - <<'PY'\nfor cyc in (3351771,3353622,3358499):\n print(cyc, (312.39*1.046)*cyc/10e6,105.563*(3379213/cyc)-105.563)\nPY\ndate -u\"", "aggregated_output": "    assert fetches[:len(pcs)] == [(pc, True) for pc in pcs]\n    trapped = [r for r in rets if r[\"trap\"]]\n    assert [r[\"pc\"] for r in trapped] == [4, 12, 20, 28, 32, 36]\n    assert all((r[\"rd\"], r[\"rd_wdata\"]) == (0, 0) for r in trapped)\n    assert (rets[2][\"rs1_rdata\"], rets[2][\"rd_wdata\"]) == (42, 43)\n    assert (rets[4][\"rs1_rdata\"], rets[4][\"rd_wdata\"]) == (42, 44)\n\n\n@cocotb.test()\nasync def folded_direction_training_and_read_before_write(dut):\n    # All branches fold to index zero. The comments give the counter\n    # following each branch's queued update.\n    program = {\n        0x000: BEQ(0, 0, 2),         # Trap, entry stays cold.\n        0x004: JAL(0, 0x100),\n        0x104: BEQ(0, 0, -8),        # Cold backward hit, initialize to 10.\n        0x0FC: JAL(0, 0x10C),\n        0x208: BEQ(0, 0, 0x100),     # Same-edge lookup sees cold, then train to 11.\n        0x308: NOP(),               # Recovery response; next lookup is normal.\n        0x30C: BEQ(0, 0, 0x10),      # Taken hit, saturate at 11.\n        0x31C: JAL(0, 0xF0),\n        0x40C: SW(0, 0, 0x80),       # Hold the branch in EX for three cycles.\n        0x410: BNE(0, 0, 8),         # Fall-through miss, train to 10 during iStall.\n        0x414: JAL(0, 0x100),\n        0x514: BNE(0, 0, 12),        # Fall-through miss, train to 01.\n        0x518: NOP(),\n        0x51C: JAL(0, 0xFC),\n        0x618: BNE(0, 0, -8),        # Backward not-taken hit, train to 00.\n        0x61C: JAL(0, 0x100),\n        0x71C: BNE(0, 0, -8),        # Backward not-taken hit, saturate at 00.\n        0x720: JAL(0, 0x100),\n        0x820: BEQ(0, 0, 8),         # Taken miss, train to 01.\n        0x828: NOP(),\n        0x82C: JAL(0, 0xF8),\n        0x924: BEQ(0, 0, 8),         # Taken miss, train to 10.\n        0x92C: NOP(),\n        0x930: JAL(0, 0xF8),\n        0xA28: BEQ(0, 0, 8),         # Taken hit.\n        0xA30: EBREAK(),\n    }\n    pcs = list(program)\n    for pc in (0x108, 0x20C, 0x310, 0x418, 0x520, 0x610, 0x714, 0x824, 0x928, 0xA2C):\n        program[pc] = SW(0, 0, 0x90)\n    same_edge = []\n\n    def probe(cycle, addr, ready):\n        if addr == 0x208 and ready:\n            same_edge.append(cycle)\n            assert not int(dut.correction_q.value)\n            assert int(dut.u_if.predictor_update.value) == 0b10000001\n            assert not int(dut.u_if.branch_direction.value)\n\n    requests = []\n    rets, _ = await _run(dut, program, dmem_stalls={0x80: 3}, imem_stalls={0x414: 2},\n                         dmem_trace=requests, cycle_probe=probe)\n    assert len(same_edge) == 1\n    _assert_retirement_path(rets, pcs)\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [0]\n    assert requests == [(0x80, 0, 0xF, 0, False)] * 3 + [(0x80, 0, 0xF, 0, True)]\n    gaps = {a[\"pc\"]: b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])}\n    expected_gaps = dict.fromkeys(pcs[:-1], 1)\n    expected_gaps.update({0x208: 2, 0x31C: 4, 0x410: 4,\n                          0x514: 2, 0x820: 2, 0x924: 2})\n    for pc, expected in expected_gaps.items():\n        assert gaps[pc] == expected, f\"gap after PC {pc:#x}: {gaps[pc]}, expected {expected}\"\n\n\n@cocotb.test()\n@cocotb.parametrize(case=[\n    # funct3, load, raw word, formatted value, other value, match, taken\n    (0, LW(1, 0, 0x80), 0x12345678, 0x12345678, 0x12345678, \"rs1\", True),\n    (1, LW(1, 0, 0x80), 0x12345678, 0x12345678, 0, \"both\", False),\n    (4, LB(1, 0, 0x83), 0x80000000, 0xFFFFFF80, 1, \"rs1\", True),\n    (5, LH(1, 0, 0x82), 0x80000000, 0xFFFF8000, 1, \"rs2\", True),\n    (6, LW(1, 0, 0x80), 0x12FFFFFF, 0x12FFFFFF, 0x13000000, \"rs1\", True),\n    