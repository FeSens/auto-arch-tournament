{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c 'variant_base=$(mktemp -d \"$TMPDIR/bench-r7s2-alternate.XXXXXX\")\nprintf '\"'%s\\\\n' \\\"\"'$variant_base\"\ncat > \"$variant_base/alternate.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nroot = Path(sys.argv[1]) / 'cores/bench/rtl'\n\ndef change(file, old, new):\n    path = root / file\n    source = path.read_text()\n    assert source.count(old) == 1, (file, old, source.count(old))\n    path.write_text(source.replace(old, new))\n\nchange('ex_stage.sv', '''  output logic               recover_taken,\n  output logic               recover_fallthrough,\n  output logic [31:2]        recovery_target,\n  output logic [31:2]        recovery_fallthrough,''', '''  output logic               recover,\n  output logic [31:2]        recovery_pc,''')\nchange('ex_stage.sv', '''  assign recovery_target      = jump_target[31:2];\n  assign recovery_fallthrough = fallthrough[31:2];''', '''  logic [31:2] alternate_direct_pc;\n  assign alternate_direct_pc = in.predicted_taken ? fallthrough[31:2] : branch_target[31:2];\n  assign recovery_pc = in.ctrl.is_jalr ? effective_addr[31:2] : alternate_direct_pc;''')\npath = root / 'ex_stage.sv'\nsource = path.read_text()\nstart = source.index('  assign recover_taken ')\nend = source.index('\\\\n\\\\n', start)\nchange('ex_stage.sv', source[start:end], '''  assign recover = advance && (\n    (in.ctrl.is_branch && ((branch_cond && \"'!in.imm[1]) ''^ in.predicted_taken))\n    || (in.ctrl.is_jump && (!misalign_jump ''^ in.predicted_taken)));'\"''')\n\nchange('core.sv', '''  logic        recover_taken, recover_fallthrough;\n  logic [31:2] recovery_target, recovery_fallthrough;''', '''  logic        recover;\n  logic [31:2] recovery_pc;''')\npath = root / 'core.sv'\nsource = path.read_text()\nsource = source.replace('''    .recover_taken        (recover_taken),\n    .recover_fallthrough  (recover_fallthrough),\n    .recovery_target      (recovery_target),\n    .recovery_fallthrough (recovery_fallthrough),''', '''    .recover              (recover),\n    .recovery_pc          (recovery_pc),''')\nsource = source.replace('(recover_taken || recover_fallthrough)', '(recover)')\npath.write_text(source)\n\nchange('if_stage.sv', '''  input  logic              recover_taken,\n  input  logic              recover_fallthrough,\n  input  logic [31:2]       recovery_target,\n  input  logic [31:2]       recovery_fallthrough,''', '''  input  logic              recover,\n  input  logic [31:2]       recovery_pc,''')\npath = root / 'if_stage.sv'\nsource = path.read_text()\nstart = source.index('  logic [31:2] target_q')\nend = source.index('  assign sequential_sum', start)\nchange('if_stage.sv', source[start:end], '''  logic [31:2] correction_q;\n  logic        select_normal_q, select_correction_q;\n  logic [19:0] normal_page_plus_one, correction_page_plus_one;\n  logic [10:0] sequential_sum;\n\n  always_ff @(posedge clock) begin\n    correction_q <= recovery_pc;\n    select_normal_q <= reset || \"'!recover;\n    select_correction_q <= !reset && recover;\n  end\n\n  assign fetch_page = ({20{select_normal_q}}     & pc_page_q)\n                    | ({20{select_correction_q}} & correction_q[31:12]);\n  assign fetch_word = ({10{select_normal_q}}     & pc_word_q)\n                    | ({10{select_correction_q}} & correction_q[11:2]);\n\n  assign normal_page_plus_one      = pc_page_q            + 20'\"'d1;\n  assign correction_page_plus_one  = correction_q[31:12]  + 20'd1;\n  assign incremented_page = ({20{select_normal_q}}     & normal_page_plus_one)\n                          | ({20{select_correction_q}} & correction_page_plus_one);\n''')\nPY\nfor mode in original byte prebyte prenibble prepair; do\n  root=\\\"\"'$variant_base/$mode\"\n  mkdir -p \"$root/cores/bench\"\n  cp -r cores/bench/rtl cores/bench/core.yaml \"$root/cores/bench/\"\n  cp -r fpga \"$root/\"\n  if test \"$mode\" != original; then python \"$TMPDIR/bench