{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nsrc = Path('cores/bench/rtl/div_unit.sv').read_text()\nmux_tree = src[src.index('  logic [31:0] residual_2'):src.index('  assign selected =')]\nheader = \\\"\\\"\\\"module miter(input [16:0] fits,\n                   input [511:0] residuals,\n                   output equivalent);\n  wire [31:0] candidate_residual [0:15];\n  wire [31:0] residual;\n  for (genvar i = 0; i < 16; i++)\n    assign candidate_residual[i] = residuals[32*i +: 32];\n\\\"\\\"\\\"\ntail = \\\"\\\"\\\"\n  reg [31:0] old_residual;\n  always_comb begin\n    old_residual = 32'b0;\n    for (int i = 0; i < 16; i++)\n      old_residual |= (fits[i] && \"'!fits[i+1]) ? candidate_residual[i] : 32'\"'b0;\n  end\n  wire monotone = fits[0] && \"'!fits[16] && ((fits[16:1] & ~fits[15:0]) == 16'\"'b0);\n  assign equivalent = \"'!monotone || residual == old_residual;\nendmodule\n\"\"\"\nPath('\"'residual_miter.sv').write_text(header + mux_tree + tail)\nPY\nset -o pipefail\nyosys -Q -p 'read_verilog -sv residual_miter.sv; prep -top miter; sat -verify -prove equivalent 1' | rg 'SAT proof|ERROR'\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
