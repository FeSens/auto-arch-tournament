{"type": "item.completed", "item": {"id": "item_95", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/ex_stage.sv'", "aggregated_output": "// rtl/ex_stage.sv\n//\n// Execute stage. Applies the operand selects registered by decode, runs\n// the ALU, forms the data address, and resolves control transfers. Owns\n// the EX/MEM pipeline register.\n//\n// Latency:        1 cycle for the ALU and 9 cycles for division.\n// RVFI fields:    feeds pc_wdata (= pc_next), the rd_wdata path for\n//                 ALU and JAL/JALR (PC+4), and the branch resolve.\nmodule ex_stage (\n  input  logic               clock,\n  input  logic               reset,\n  input  logic               stall,         // freeze EX/MEM register (dmem stall)\n  input  logic               squash,        // older branch recovered in MEM\n  input  id_ex_t   in,\n  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\n  input  logic [31:0]        fwd_mem_wb,\n  input  logic [31:0]        load_word,\n  input  logic [1:0]         load_byte_addr,\n  input  logic [1:0]         load_width,\n  input  logic               load_sext,\n  input  logic               load_writes,\n  output ex_mem_t  out,\n  output logic               fast_write,\n  output logic               div_wait,\n  output logic               redirect,\n  output logic [31:2]        recovery_pc\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  assign rs1 = ({32{in.rs1_sel.local_value}} & in.rs1_val)\n             | ({32{in.rs1_sel.ex_mem}} & fwd_ex_mem)\n             | ({32{in.rs1_sel.mem_wb}} & fwd_mem_wb);\n  assign rs2 = ({32{in.rs2_sel.local_value}} & in.rs2_val)\n             | ({32{in.rs2_sel.ex_mem}} & fwd_ex_mem)\n             | ({32{in.rs2_sel.mem_wb}} & fwd_mem_wb);\n\n  // The LSU and JALR both use the forwarded base plus the decoded immediate.\n  logic [31:0] effective_addr;\n  assign effective_addr = rs1 + in.imm;\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  assign alu_a = ({32{in.alu_a_sel.local_value}} & in.alu_a_local)\n               | ({32{in.alu_a_sel.ex_mem}} & fwd_ex_mem)\n   \n…[9270 of 12342 chars elided by tools/bench/transcript.py; sha256:d2b9871ffd70c87d]…\nective_addr;\n\n      reg_q.pc            <= in.pc;\n      reg_q.alu_result    <= alu_result;\n      reg_q.result_kind   <= in.result_kind;\n      reg_q.mul_products  <= mul_products;\n      reg_q.div_magnitude <= div_magnitude;\n      reg_q.div_negate    <= div_negate;\n      reg_q.write_data    <= rs2;\n      reg_q.rd            <= in.rd;\n      reg_q.rs1_addr      <= in.rs1_addr;\n      reg_q.rs2_addr      <= in.rs2_addr;\n      reg_q.rs1_val       <= div_valid ? div_rs1 : rs1;\n      reg_q.rs2_val       <= div_valid ? div_rs2 : rs2;\n      // Misaligned transfers trap and continue at the fall-through PC.\n      reg_q.pc_next       <= resolved_taken ? jump_target : fallthrough;\n      reg_q.late_branch   <= late_compare;\n      reg_q.branch_index  <= in.pc[7:2] ^ in.pc[13:8];\n      reg_q.ctrl          <= ctrl_with_trap;\n      reg_q.instr         <= in.instr;\n    end\n\n    if (reset)\n      reg_q.valid <= 1'b0;\n    else if (!stall)\n      reg_q.valid <= in.valid && !squash && !div_wait;\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_94", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// Instruction fetch, page-local prediction, and a four-entry fall-through queue.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              decode_accept,\n  input  logic              redirect,\n  input  logic [31:2]       ex_recovery_pc,\n  input  logic              mem_redirect,\n  input  predictor_update_t predictor_update,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t            out\n);\n\n  logic [19:0] pc_page_q, fetch_page, incremented_page;\n  logic [9:0]  pc_word_q, fetch_word;\n  logic [31:2] recovery_pc_q;\n  logic        select_normal_q;\n  logic [19:0] normal_page_plus_one, recovery_page_plus_one;\n  logic [10:0] sequential_sum;\n  logic        fetch_advance;\n\n  // A deferred branch's candidate was captured during its EX cycle. A MEM\n  // miss keeps that older candidate while any EX miss uses the new one.\n  always_ff @(posedge clock) begin\n    if (!mem_redirect)\n      recovery_pc_q <= ex_recovery_pc;\n    select_normal_q <= reset || !redirect;\n  end\n\n  assign fetch_page = select_normal_q ? pc_page_q : recovery_pc_q[31:12];\n  assign fetch_word = select_normal_q ? pc_word_q : recovery_pc_q[11:2];\n\n  // Increment each candidate page ahead of the fetch mux. A sequential wrap\n  // selects the incremented page even when the fetch is a recovery address.\n  assign normal_page_plus_one   = pc_page_q            + 20'd1;\n  assign recovery_page_plus_one = recovery_pc_q[31:12] + 20'd1;\n  assign incremented_page = select_normal_q ? normal_page_plus_one : recovery_page_plus_one;\n  assign sequential_sum = {1'b0, fetch_word} + 11'd1;\n\n  logic [63:0] trained_q;\n  logic [1:0] direction_counters [0:63];\n  logic [5:0] lookup_index;\n  logic [1:0] old_counter, next_counter;\n  logic update_trained;\n  logic branch_direction;\n\n  assign lookup_index = imem_addr[7:2] ^ imem_addr[13:8];\n  assign branch_direction = trained_q[lookup_index] ? direction_counters[lookup_index][1]\n                        \n…[4042 of 7114 chars elided by tools/bench/transcript.py; sha256:21b7752937a64a77]…\n     if (empty && push)\n        head_q <= write_slot_q;\n      else if (pop && (push || !nonempty_count_q[0]))\n        head_q <= {head_q[2:0], head_q[3]};\n    end\n  end\n\n  assign imem_addr = {fetch_page, fetch_word, 2'b00};\n  assign live_packet = {imem_addr, imem_data, predicted_taken};\n\n  for (genvar slot = 0; slot < 4; slot++) begin : g_packet\n    // The free slot can sample eagerly. Only a push publishes its contents.\n    always_ff @(posedge clock) begin\n      if (space_available && write_slot_q[slot])\n        packets_q[slot] <= live_packet;\n    end\n  end\n\n  always_comb begin\n    queued_packet = '0;\n    for (int slot = 0; slot < 4; slot++)\n      queued_packet |= packets_q[slot] & {PACKET_WIDTH{head_q[slot]}};\n  end\n\n  assign decode_packet        = empty ? live_packet : queued_packet;\n  assign out.pc              = decode_packet.pc;\n  assign out.instr           = decode_packet.instr;\n  assign out.predicted_taken = decode_packet.predicted_taken;\n  assign out.valid           = !empty || imem_ready;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
