{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"cat > prototype.py <<'PY'\nfrom pathlib import Path\nrtl = Path('cores/bench/rtl')\n\ndef update(filename, edits):\n    path = rtl / filename\n    source = path.read_text()\n    for old, new in edits:\n        assert old in source, old\n        source = source.replace(old, new, 1)\n    path.write_text(source)\n\nupdate(\\\"core_pkg.sv\\\", [('  // ── Pipeline-bundle typedefs', '''  typedef struct packed {\n\"'`ifdef RISCV_FORMAL_ALTOPS\n    logic [31:0] alternate;\n`else\n    logic [31:0] quotient;\n    logic [127:0] residual_groups;\n    logic want_remainder;\n    logic negate;\n`endif\n  } div_result_t;\n\n  // ── Pipeline-bundle typedefs'\"'''), (\n    '    logic [31:0] div_magnitude;\\\\n    logic        div_negate;', '    div_result_t div_result;')])\nupdate('ex_stage.sv', [\n    ('  logic        div_negate;\\\\n  logic [31:0] div_magnitude, div_rs1, div_rs2;',\n     '  div_result_t div_result;\\\\n  logic [31:0] div_rs1, div_rs2;'),\n    ('    .result_magnitude (div_magnitude),\\\\n    .result_negate    (div_negate),', '    .result           (div_result),'),\n    ('      reg_q.div_magnitude <= div_magnitude;\\\\n      reg_q.div_negate    <= div_negate;', '      reg_q.div_result    <= div_result;'),\n])\nupdate('mem_stage.sv', [('  assign div_result = in.div_negate ? -in.div_magnitude : in.div_magnitude;', '''\"'`ifdef RISCV_FORMAL_ALTOPS\n  assign div_result = in.div_result.alternate;\n`else\n  logic [31:0] div_remainder, div_magnitude;\n  assign div_remainder = in.div_result.residual_groups[31:0]\n                       | in.div_result.residual_groups[63:32]\n                       | in.div_result.residual_groups[95:64]\n                       | in.div_result.residual_groups[127:96];\n  assign div_magnitude = in.div_result.want_remainder ? div_remainder : in.div_result.quotient;\n  assign div_result = in.div_result.negate ? -div_magnitude : div_magnitude;\n`endif'\"''')])\nupdate('div_unit.sv', [\n    ('  output logic [31:0] result_magnitude,\\\\n  output logic        result_negate,', '  output div_result_t result,'),\n    ('\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n  logic [4:0] op_q;\\\\n  logic [31:0] difference;',\n     '  logic [4:0] op_q;'),\n    ('  assign difference = saved_a - saved_b;\\\\n  assign result_negate = 1\\\\'b0;',\n     '\"'`ifdef RISCV_FORMAL_ALTOPS'\"\\\\n  logic [31:0] difference;\\\\n  assign difference = saved_a - saved_b;'),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('result_magnitude', 'result.alternate'),\n    ('  logic [31:0] dividend, divisor;', '''  logic [31:0] dividend_complement, divisor_complement;\n  logic [27:0] dividend_low;\n  logic [3:0] dividend_top;\n  logic [4:0] divisor_low;\n  logic large_divisor;'''),\n    ('  logic [35:0] divisor_once, divisor_twice, divisor_four, divisor_eight;\\\\n  logic [35:0] sum_three, carry_three;',\n     '  logic [35:0] divisor_once;\\\\n  logic [127:0] residual_groups;'),\n    ('''  assign signed_op      = (op == ALU_DIV || op == ALU_REM);\n  assign want_remainder = (op == ALU_REM || op == ALU_REMU);\n  assign a_negative     = signed_op && a[31];\n  assign b_negative     = signed_op && b[31];\n  assign dividend       = a_negative ? -a : a;\n  assign divisor        = b_negative ? -b : b;\n''', '''  assign signed_op           = (op_q == ALU_DIV || op_q == ALU_REM);\n  assign want_remainder      = (op_q == ALU_REM || op_q == ALU_REMU);\n  assign a_negative          = signed_op && saved_a[31];\n  assign b_negative          = signed_op && saved_b[31];\n  assign dividend_complement = saved_a \"'^ {32{a_negative}};\n  assign divisor_complement  = saved_b ''^ {32{b_negative}};\n  assign dividend_low        = dividend_complement[27:0] + {27'\"'b0, a_negative};\n  assign dividend_top        = dividend_complem