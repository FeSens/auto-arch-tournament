ault:    products.ll[31:0] = 32'b0;\n    endcase\n  end\n\"'`else\n  logic signed [16:0] al, ah, bl, bh;\n  assign al = $signed({1'\"'b0, a[15:0]});\n  assign bl = \"'$signed({1'\"'b0, b[15:0]});\n  assign ah = \"'$signed({a[31] && (op == ALU_MULH || op == ALU_MULHSU), a[31:16]});\n  assign bh = $signed({b[31] && op == ALU_MULH, b[31:16]});\n  assign products.ll = al * bl;\n  assign products.lh = al * bh;\n  assign products.hl = ah * bl;\n  assign products.hh = ah * bh;\n`endif\nendmodule\n\nmodule mul_reduce (\n  input  mul_products_t products,\n  input  logic low_half,\n  output logic [31:0] result\n);\n`ifdef RISCV_FORMAL_ALTOPS\n  assign result = products.ll[31:0];\n`else\n  logic [47:0] outer_terms, cross_lh, cross_hl;\n  logic [47:0] sum, carry, upper;\n  assign outer_terms = {products.hh[31:0], products.ll[31:16]};\n  assign cross_lh = {{14{products.lh[33]}}, products.lh};\n  assign cross_hl = {{14{products.hl[33]}}, products.hl};\n  assign sum = outer_terms ''^ cross_lh ''^ cross_hl;\n  assign carry = ((outer_terms & cross_lh) | ((outer_terms | cross_lh) & cross_hl)) << 1;\n  assign upper = sum + carry;\n  assign result = low_half ? {upper[15:0], products.ll[15:0]} : upper[47:16];\n`endif\nendmodule\n'\"''')\n\nrewrite('div_unit.sv', [\n    ('  output logic [31:0] result,', '  output logic [31:0] result,\\\\n  output logic        result_negate,'),\n    ('  assign difference = saved_a - saved_b;', \\\"  assign difference = saved_a - saved_b;\\\\n  assign result_negate = 1'b0;\\\"),\n    ('  assign result        = negate_result_q ? -magnitude : magnitude;',\n     '  assign result        = magnitude;\\\\n  assign result_negate = negate_result_q;'),\n])\n\nrewrite('ex_stage.sv', [\n    ('  logic        is_div, div_ready, div_valid;',\n     '''  mul_products_t products;\n  logic        is_mul;\n  assign is_mul = (in.ctrl.alu_op >= ALU_MUL && in.ctrl.alu_op <= ALU_MULHSU);\n  mul_unit u_mul (.op(in.ctrl.alu_op), .a(rs1), .b(rs2), .products(products));\n\n  logic  