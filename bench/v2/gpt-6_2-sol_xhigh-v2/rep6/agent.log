eady and not int(dut.correction_q.value)\n            if int(fetch.space_available.value):\n                assert int(fetch.push.value) and int(fetch.fetch_advance.value)\n                predictions.append((addr, bool(fetch.replay_taken.value)))\n            else:\n                assert not int(fetch.push.value) and not int(fetch.fetch_advan\n…[10926 of 13998 chars elided by tools/bench/transcript.py; sha256:86782b93ce971e3b]…\ns, replacement_jal))\n    await check(even_alias)\n    await edge(even_alias)\n    await check(even_alias, replacement_jal)\n\n    await edge(odd, _update(odd, backward_branch), invalidate=True)\n    await check(odd_alias)\n    await check(even_alias)\n    await edge(odd)\n    await check(odd)\n    await check(odd_alias)\n    await check(even_alias)\n    await edge(even)\n    await check(even + 4)\n\n    # Training a different row in either group must leave stale rows invalid.\n    await edge(even_alias + 8, _update(even_alias + 8, addi))\n    await edge(even_alias)\n    await check(even_alias)\n    await edge(odd - 8, _update(odd - 8, addi))\n    await edge(odd)\n    await check(odd_alias)\n\n    await edge(odd, _update(odd, backward_branch))\n    await edge(odd)\n    await check(odd, backward_branch)\n    await check(even_alias)\n\n\ndef test_replay_table_runner():\n    run_cocotb(\n        toplevel=\"replay_table\",\n        sources=[\"core_pkg.sv\", \"replay_payload_ram.sv\", \"replay_table.sv\"],\n        test_module=\"test_replay_table\",\n    )\n", "exit_code": 0, "status": "completed"}}
