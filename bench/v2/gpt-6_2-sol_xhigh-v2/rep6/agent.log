x];', 'even_target_q <= even_target[even_index];')\n    c=c.replace('odd_address_q   <= odd_address[odd_index];', 'odd_target_q <= odd_target[odd_index];')\n    c=c.replace('    even_index_q    <= even_index;\\\\n    odd_index_q     <= odd_index;\\\\n','')\n    c=c.replace('even_valid_q[even_index] && \"'!(write_even && write_index == even_index);'\"',\n                'even_valid_q[even_index] && even_tag[even_index] == even_expected_tag\\\\n                        && \"'!(write_even && write_index == even_index);'\"')\n    c=c.replace('odd_valid_q[odd_index] && \"'!(write_odd && write_index == odd_index);'\"',\n                'odd_valid_q[odd_index] && odd_tag[odd_index] == normal_pc[31:11]\\\\n                        && \"'!(write_odd && write_index == odd_index);'\"')\n    start=c.index('  // Compare the sampled row')\n    c=c[:start]+'''  assign hit = address_sample_matches && (normal_pc[2] ? odd_available_q : even_available_q);\n  assign instr = normal_pc[2] ? odd_instr_q : even_instr_q;\n  assign steering = normal_pc[2] ? {odd_target_q, odd_flags_q}\n                                : {even_target_q, even_flags_q};\n\nendmodule\n'''\n    p.write_text(c)\n    p=rtl/'if_stage.sv'; c=p.read_text()\n    c=c.replace('  replay_table u_replay (','''\n  logic address_sample_matches_q;\n  always_ff @(posedge clock)\n    address_sample_matches_q <= \"'!reset && !correction && !(fetch_advance && normal_taken);\n  \n  replay_table u_replay ('\"''')\n    c=c.replace('    .hit        (replay_hit),','    .address_sample_matches (address_sample_matches_q),\\\\n    .hit        (replay_hit),')\n    p.write_text(c)\nPY\npython3 \\\"\"'$scratch_dir/qualified_replay.py\" \"$scratch_dir\"\nfor variant in qualified_replay qualified_replay_bypass; do\n  RTL_DIR=\"$scratch_dir/$variant\" OBJ_DIR=\"$scratch_dir/$variant-obj\" NRET=1 bash test/cosim/build.sh >\"$scratch_dir/$variant-verilator.log\" 2>&1 && \"$scratch_dir/$variant-obj/cosim_sim\" \"$scratch_dir/coremark.elf\" 5000000 --