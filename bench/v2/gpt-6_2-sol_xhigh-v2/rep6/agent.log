{"type": "item.completed", "item": {"id": "item_89", "type": "command_execution", "command": "/bin/bash -c \"sed -n '115,230p' cores/bench/test/test_pipeline.py && tail -15 formal-prototype.log\"", "aggregated_output": "    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n    dut.io_imemReady.value = int(not imem_stalls.get(0, 0))\n    if imem_stalls.get(0, 0):\n        imem_stalls[0] -= 1\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n        ready     = not ((wen or ren) and dmem_stalls.get(da, 0))\n        if not ready:\n            dmem_stalls[da] -= 1\n        dut.io_dmemReady.value = int(ready)\n        wdata = int(dut.io_dmemWData.value) if wen else 0\n        if dmem_trace is not None and (wen or ren or dmem_trace_idle):\n            dmem_trace.append((da, ren, wen, wdata, ready))\n\n        # Apply dmem write side effects.\n        if wen and ready:\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n               \n…[2507 of 5579 chars elided by tools/bench/transcript.py; sha256:572ee31ba988ad33]…\n  ADDI(5, 0, 42),\n        ADD(6, 5, 5),          # Both sources prefer the newer EX writer.\nSBY  0:55:23 [insn_sub_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:00:05 (5)\nSBY  0:55:23 [insn_sub_ch0] summary: Elapsed process time [H:MM:SS (secs)]: 0:00:05 (5)\nSBY  0:55:23 [insn_sub_ch0] summary: engine_0 (smtbmc bitwuzla) returned pass\nSBY  0:55:23 [insn_sub_ch0] summary: engine_0 did not produce any traces\nSBY  0:55:23 [insn_sub_ch0] DONE (PASS, rc=0)\nSBY  0:55:50 [reg_ch0] engine_0: ##   0:00:49  Status: passed\nSBY  0:55:50 [reg_ch0] engine_0: finished (returncode=0)\nSBY  0:55:50 [reg_ch0] engine_0: Status returned by engine: pass\nSBY  0:55:50 [reg_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:00:50 (50)\nSBY  0:55:50 [reg_ch0] summary: Elapsed process time [H:MM:SS (secs)]: 0:00:50 (50)\nSBY  0:55:50 [reg_ch0] summary: engine_0 (smtbmc bitwuzla) returned pass\nSBY  0:55:50 [reg_ch0] summary: engine_0 did not produce any traces\nSBY  0:55:50 [reg_ch0] DONE (PASS, rc=0)\n\nFormal: 53 passed, 0 failed\n", "exit_code": 0, "status": "completed"}}
