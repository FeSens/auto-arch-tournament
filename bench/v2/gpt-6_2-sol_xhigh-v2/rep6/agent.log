ermine CoreMark ITERATIONS\")\n--\n204-    \"\"\"Run CoreMark on Verilator sim, return {iter_per_cycle, completed, cycles, iterations}.\n205-    Completion is only trusted when the simulation retired an ebreak — otherwise the\n206-    benchmark hit maxcycles without completing and the cycle count is meaningless.\"\"\"\n207-    worktree_path = Path(worktree).resolve()\n208-    if sim_bin is None:\n209-        sim_bin = str(worktree_path / \"test/cosim/obj_dir/cosim_sim\")\n210:    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\n211-    # 50M cycle ceiling: 2K CoreMark with ITERATIONS=10 + iStall+dStall\n212-    # needs ~5M cycles. 50M gives 10x headroom for slower candidates.\n213-    try:\n214-        result = run_pgroup(\n215-            [sim_bin, elf, \"50000000\"] + COREMARK_SIM_FLAGS,\n216-            capture_output=True, text=True, timeout=600, env=env\n217-        )\n218-    except (subprocess.TimeoutExpired, OSError) as e:\n219-        return {'completed': False, 'iter_per_cycle': 0.0, 'cycles': 0, 'iterations': 0,\n220-                'reason': f'coremark_harness_error: {e}'}\n61:int main(int argc, char** argv) {\n62:    if(argc < 2) {\n66:    uint64_t maxcycles = argc > 2 ? atoll(argv[2]) : 50000000ULL;\n76:    for (int i = 1; i < argc; i++) {\n80:        else if (std::strcmp(argv[i], \"--seed\")   == 0 && i + 1 < argc)\n97:    Verilated::commandArgs(argc, argv);\n","exit_code":0,"status":"completed"}}
