update,')\n    c=c.replace('  logic branch_prediction, jal_prediction, predicted_taken;',f'''\n  localparam int RETURN_DEPTH = {depth};\n  logic [31:2] return_words [0:RETURN_DEPTH-1];\n  logic [\"'$clog2(RETURN_DEPTH):0] depth_q;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      depth_q <= '\"'0;\n    end else if (return_update.push_link) begin\n      return_words[0] <= return_update.link;\n      for (int i = 1; i < RETURN_DEPTH; i++)\n        return_words[i] <= return_words[i-1];\n      if (depth_q \"'!= RETURN_DEPTH)\n        depth_q <= depth_q + 1'\"'b1;\n    end else if (return_update.pop_link && depth_q \"'!= 0) begin\n      for (int i = 0; i < RETURN_DEPTH-1; i++)\n        return_words[i] <= return_words[i+1];\n      depth_q <= depth_q - 1'\"'b1;\n    end\n  end\n\n  logic branch_prediction, jal_prediction, predicted_taken, return_prediction, return_selected, bus_taken;''')\n    c=c.replace('  assign replay_taken =', '''\n  assign return_prediction = depth_q \"'!= 0 && imem_data == 32'\"'h00008067\n                          && return_words[0][31:12] == pc_page_q;\n  assign return_selected = imem_ready && return_prediction;\n  assign replay_taken =''')\n    c=c.replace('assign normal_taken = bus_target_selected || replay_target_selected;', 'assign normal_taken = bus_target_selected || replay_target_selected || return_selected;')\n    c=c.replace('                          | ({10{replay_target_selected}} & replay_steering.target_word);', '                          | ({10{replay_target_selected}} & replay_steering.target_word)\\\\n                          | ({10{return_selected}} & return_words[0][11:2]);')\n    c=c.replace('                           | ({6{replay_target_selected}} & direction_index(pc_page_q[1:0], replay_steering.target_word));', '                           | ({6{replay_target_selected}} & direction_index(pc_page_q[1:0], replay_steering.target_word))\\\\n                           | ({6{return_selected}} & direction_index(pc_pag