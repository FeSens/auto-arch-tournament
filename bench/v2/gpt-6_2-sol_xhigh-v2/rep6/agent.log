{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '858,1193p' cores/bench/test/test_pipeline.py; sed -n '1340,1365p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "@cocotb.test()\n@cocotb.parametrize(stall_fetch=[False, True], stall_data=[False, True])\nasync def direction_misses_retry_under_backpressure(dut, stall_fetch, stall_data):\n    program = [\n        ADDI(1, 0, 1),\n        SW(1, 0, 0x80),\n        BEQ(0, 0, 8),    # Predict PC=12, recover to PC=16.\n        SW(1, 0, 0x90),  # Wrong path for both branches.\n        LW(2, 0, 0x84),\n        BEQ(1, 0, -8),   # Predict PC=12, recover to PC=24.\n        SW(1, 0, 0x88),\n        EBREAK(),\n    ]\n    store_stalls, load_stalls = (3, 4) if stall_data else (0, 0)\n    target_stalls, fallthrough_stalls = (2, 3) if stall_fetch else (0, 0)\n    fetches, requests = [], []\n    rets, dmem = await _run(\n        dut, program, dmem_init={0x84: 42}, imem_trace=fetches, dmem_trace=requests,\n        dmem_stalls={0x80: store_stalls, 0x84: load_stalls},\n        imem_stalls={12: store_stalls + 1 if stall_fetch else 0,\n                     16: target_stalls, 24: fallthrough_stalls},\n    )\n    _assert_retirement_path(rets, [0, 4, 8, 16, 20, 24, 28])\n    assert all(r[\"trap\"] == 0 for r in rets)\n    assert rets[3][\"rd_wdata\"] == 42\n    assert dmem == {0x80: 1, 0x84: 42, 0x88: 1}\n    assert requests == (\n        [(0x80, 0, 0xF, 1, False)] * store_stalls + [(0x80, 0, 0xF, 1, True)] +\n        [(0x84, 1, 0, 0, False)] * load_stalls + [(0x84, 1, 0, 0, True)] +\n        [(0x88, 0, 0xF, 1, True)]\n    )\n    # While the branches are held, fetch follows their speculative paths\n    # until the bus stalls, the queue fills, or EX can resolve the branch.\n    if stall_fetch:\n        store_hold_fetches = [(12, False)] * (store_stalls + 1)\n    else:\n        store_hold_fetches = [(pc, True) for pc in ([12, 16, 20, 12] if stall_data else [12])]\n    load_hold_fetches = [(pc, True) for pc in ([12, 16, 20, 12, 16] if stall_data else [12])]\n    expected_fetches = (\n        [(0, True), (4, True), (8, True)] +\n        store_hold_fetches +\n        [(16, False)] * target_stalls + [(16, True), (20, True)] +\n        load_hold_fetches +\n        [(24, False)] * fallthrough_stalls + [(24\n…[12693 of 15765 chars elided by tools/bench/transcript.py; sha256:4279dfcf4e88de46]…\nm)\n    _assert_retirement_path(rets, list(range(0, 4 * len(program), 4)))\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [4, 20]\n    assert [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])] == [\n        2, 1, 2, 1, 2, 1, 2, 1, 2, 9, 2, 1, 1, 1,\n    ]\n    assert mem == {0x84: 0}\n\n\n@cocotb.test()\n@cocotb.parametrize(stall_head=[False, True])\n    rets, _ = await _run(dut, program, cycle_probe=probe)\n    _assert_retirement_path(rets, [0, 4] + body + body[:2] + list(range(fence, stop + 4, 4)))\n    assert len(fence_cycles) == 1\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"mul_reduce.sv\", \"div_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"loop_replay.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
