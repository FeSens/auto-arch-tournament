| (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, \n…[8272 of 11344 chars elided by tools/bench/transcript.py; sha256:03b2bc9e636520c7]…\nADDI(0, 0, 73),\n        ADDI(0, 0, 94),\n        ADD(17, 0, 0),         # Neither write to x0 is a forwarding candidate.\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, dmem_init={0x80: 0xC0FFEE},\n                         dmem_stalls={0x80: load_stalls}, dmem_trace=requests)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n    assert all(r[\"pc_next\"] == r[\"pc\"] + 4 for r in rets)\n    assert [r[\"order\"] for r in rets if r[\"trap\"]] == [4, 7]\n    for index in (4, 7, 15, 16):\n        assert (rets[index][\"rd\"], rets[index][\"rd_wdata\"]) == (0, 0)\n    assert (rets[7][\"mem_addr\"], rets[7][\"mem_rmask\"], rets[7][\"mem_wmask\"]) == (0, 0, 0)\n    assert rets[10][\"rd_wdata\"] == 0xC0FFEE\n    assert requests == [(0x80, 1, 0, 0, False)] * load_stalls + [(0x80, 1, 0, 0, True)]\n4221702 6.7595897309044695 15.362381277375793 75.04822546253999 196.05836698090013\n", "exit_code": 0, "status": "completed"}}
