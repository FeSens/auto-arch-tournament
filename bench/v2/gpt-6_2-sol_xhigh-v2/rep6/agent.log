ogram)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0\n…[6637 of 9709 chars elided by tools/bench/transcript.py; sha256:d82a316e54ae3cca]…\n  except json.JSONDecodeError as e:\n        return {'passed': False, 'elf': coremark_elf.name, 'field': 'malformed_marker',\n                'detail': f'{e}: {lines[-1][:500]}'}\n    if not marker.get('ebreak', False):\n        return {'passed': False, 'elf': coremark_elf.name, 'field': 'no_ebreak',\n                'detail': 'maxcycles hit before ebreak'}\n    if marker.get('oob', False):\n        return {'passed': False, 'elf': coremark_elf.name, 'field': 'oob_access',\ntotal 120\ndrwxrwx---+ 14 nobody    nogroup    4096 Nov 22 23:01 .\ndrwxrwx---+  3 nobody    nogroup    4096 Nov 22 22:46 ..\ndr-xr-xr-x   2 hwebench2 hwebench2    40 Nov 22 23:35 .agents\ndr-xr-xr-x   2 hwebench2 hwebench2    40 Nov 22 23:35 .aws\ndr-xr-xr-x   2 hwebench2 hwebench2    40 Nov 22 23:35 .codex\ndrwxrwx---+  7 nobody    nogroup    4096 Nov 22 23:30 .git\ndrwxrwx---+  3 nobody    nogroup    4096 Nov 22 22:45 .github\n-rw-rw----+  1 nobody    nogroup      18 Nov 22 22:45 .gitignore\n-rw-rw----+  1 nobody    nogroup     189 Nov 22 22:45 .mailmap\n", "exit_code": 0, "status": "completed"}}
