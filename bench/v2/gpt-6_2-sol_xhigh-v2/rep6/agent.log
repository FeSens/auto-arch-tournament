{"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -c \"sed -n '733,807p' cores/bench/test/test_pipeline.py\"","aggregated_output":"    pcs = [0, 8, 0xC, 0x80000FF8, 0x80000FFC, 0x80001000, 0x80001804,\n           0x80001004, 0x8000101C, 0x80001010, 0x80002010, 0x80001FFC,\n           0x80002000, 0x80002FFC, 0x80003004, 0x80003804, 0x80002004,\n           0x80002008, 0xFFFFFFF8, 0xFFFFFFFC, 0, 4]\n    misses = {0, 0xC, 0x80000FF8, 0x80001004, 0x80001010, 0x80002010,\n              0x80002FFC, 0x80003804, 0x80002008}\n    requests = []\n    rets, _ = await _run(dut, program, dmem_trace=requests)\n    _assert_retirement_path(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == [program[pc] for pc in pcs]\n    assert all(r[\"trap\"] == 0 for r in rets)\n    assert requests == []\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [2 if pc in misses else 1 for pc in pcs[:-1]], gaps\n    links = {0xC: 2, 0x80001000: 6, 0x80001804: 7, 0x80002000: 8, 0x80002FFC: 9}\n    for r in rets:\n        if r[\"pc\"] in links:\n            assert (r[\"rd\"], r[\"rd_wdata\"]) == (links[r[\"pc\"]], r[\"pc\"] + 4)\n\n\n@cocotb.test()\n@cocotb.parametrize(stall_fetch=[False, True], stall_data=[False, True])\nasync def direction_misses_retry_under_backpressure(dut, stall_fetch, stall_data):\n    program = [\n        ADDI(1, 0, 1),\n        SW(1, 0, 0x80),\n        BEQ(0, 0, 8),    # Predict PC=12, recover to PC=16.\n        SW(1, 0, 0x90),  # Wrong path for both branches.\n        LW(2, 0, 0x84),\n        BEQ(1, 0, -8),   # Predict PC=12, recover to PC=24.\n        SW(1, 0, 0x88),\n        EBREAK(),\n    ]\n    store_stalls, load_stalls = (3, 4) if stall_data else (0, 0)\n    target_stalls, fallthrough_stalls = (2, 3) if stall_fetch else (0, 0)\n    fetches, requests = [], []\n    rets, dmem = await _run(\n        dut, program, dmem_init={0x84: 42}, imem_trace=fetches, dmem_trace=requests,\n        dmem_stalls={0x80: store_stalls, 0x84: load_stalls},\n        imem_stalls={12: store_stalls + 1 if stall_fetch else 0,\n                     16: target_stalls, 24: fallthrough_stalls},\n    )\n    _assert_retirement_path(rets, [0, 4, 8, 16, 20, 24, 28])\n    assert all(r[\"trap\"] == 0 for r in rets)\n    assert rets[3][\"rd_wdata\"] == 42\n    assert dmem == {0x80: 1, 0x84: 42, 0x88: 1}\n    assert requests == (\n        [(0x80, 0, 0xF, 1, False)] * store_stalls + [(0x80, 0, 0xF, 1, True)] +\n        [(0x84, 1, 0, 0, False)] * load_stalls + [(0x84, 1, 0, 0, True)] +\n        [(0x88, 0, 0xF, 1, True)]\n    )\n    expected_fetches = (\n        [(0, True), (4, True), (8, True)] +\n        [(12, not stall_fetch)] * (store_stalls + 1) +\n        [(16, False)] * target_stalls + [(16, True), (20, True)] +\n        [(12, True)] * (load_stalls + 1) +\n        [(24, False)] * fallthrough_stalls + [(24, True), (28, True)]\n    )\n    assert fetches[:len(expected_fetches)] == expected_fetches\n\n\n@cocotb.test()\nasync def reserved_and_misaligned_transfers_fetch_sequentially(dut):\n    program = [\n        ADDI(5, 0, 42),\n        JAL(5, 14),\n        ADDI(6, 5, 1),\n        JALR(5, 0, 0x3B),\n        ADDI(7, 5, 2),\n        BEQ(0, 0, -6),  # Taken misaligned branch traps.\n        BNE(0, 0, -6),  # Untaken misaligned branch is legal.\n        _b(-16, 0, 0, 2, 0b1100011),\n        _b(-16, 0, 0, 3, 0b1100011),\n        _i(0x40, 0, 1, 5, 0b1100111),\n        EBREAK(),\n","exit_code":0,"status":"completed"}}
