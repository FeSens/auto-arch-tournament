{"type": "item.started", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/bash -c 'base=\"$TMPDIR/r11s2-profile\"\nmkdir -p \"$base/trial6/cores/bench\"\ncp -r \"$base/trial5/cores/bench/rtl\" \"$base/trial6/cores/bench/\"\ncp \"$base/trial5/cores/bench/core.yaml\" \"$base/trial6/cores/bench/\"\nln -s \"$PWD/fpga\" \"$base/trial6/fpga\"\npython3 - \"$base/trial6/cores/bench/rtl\" <<'\"'PY'\nimport sys\nfrom pathlib import Path\nrtl=Path(sys.argv[1])\np=rtl/'loop_trace.sv'\ns=p.read_text()\ns=s.replace('space, admit_allowed','space, bus_ready, bus_sequential')\ns=s.replace('  logic chosen;','  logic chosen, taking;')\ns=s.replace('  assign replay = allow_replay && (active || (admit_allowed && (|admit)));',\n'''  assign taking = allow_replay && (active || ((|admit) && (\"'!bus_ready || bus_sequential)));\n  assign replay = taking && (active || !bus_ready);'\"''')\ns=s.replace('replay && space','taking && space')\ns=s.replace('victim = replay ?', 'victim = taking ?')\ns=s.replace('conflict = replay &&', 'conflict = taking &&')\ns=s[:s.index('  // 16 usable words')]\np.write_text(s)\np=rtl/'if_stage.sv'\ns=p.read_text()\ns=s.replace('.space(space_available), .admit_allowed(\"'!empty || !imem_ready),'\"',\n''' .space(space_available), .bus_ready(imem_ready),\n    .bus_sequential(imem_data[6:0] \"'!= 7'\"'h63 && imem_data[6:0] \"'!= 7'\"'h6f),''')\ns=s.replace('logic [3:0] head, write_slot;', 'logic [3:0] write_slot;')\ns=s.replace(\\\"  assign head = select_normal_q ? head_q : 4'b0001;\\\\n\\\",'')\ns=s.replace(\\\"      head_q       <= 4'b0001;\\\", \\\"      head_q       <= 4'b0000;\\\")\ni=s.index('      if (empty && push)')\nj=s.index('    end\\\\n  end',i)\ns=s[:i]+'''      if (empty)\n        head_q <= push ? write_slot : 4'b0000;\n      else if (pop)\n        head_q <= (push || \"'!occupancy[1]) ? {head_q[2:0], head_q[3]} : 4'\"'b0000;\n'''+s[j:]\ns=s.replace('live_packet, input_packet, queued_packet, decode_packet;', 'live_packet, input_packet, decode_packet;')\ni=s.index('  always_comb begin\\\\n    queued_packet')\nj=s.index('  assign out.pc',i)\ns=s[:i]+'''  always_comb begin\n    decode_packet = live_packet & {PACKET_WIDTH{empty}};\n    for (int slot = 0; slot < 4; slot++)\n      decode_packet |= packets_q[slot] & {PACKET_WIDTH{head_q[slot] && select_normal_q}};\n  end\n\n'''+s[j:]\np.write_text(s)\nPY\ncat >> \\\"\"'$base/trial6/cores/bench/rtl/loop_trace.sv\" <<'\"'EOF'\n  // Dynamically observed contiguous words. A registered closure stages the\n  // allocation so the RAM write enable never depends on head admission.\n  logic [42:0] history [0:31];\n  logic [31:2] prior_pc;\n  logic [4:0] live_len, write_ptr;\n  logic segment_valid, consecutive, capture;\n  logic [10:0] sum;\n  logic [4:0] back_words;\n  logic close_valid, close_valid_q;\n  logic [31:2] head_q;\n  logic [9:0] tail_q;\n  logic [3:0] last_q;\n  logic [4:0] start_q;\n  logic request_q;\n  assign capture = train.valid && train.eligible && \"'!request_q && !read_copy && !write_copy;\n  assign consecutive = segment_valid && prior_pc[31:12] == train.pc[31:12]\n                    && prior_pc[11:2] + 10'\"'d1 == train.pc[11:2];\n  assign sum = {1'b0, train.pc[11:2]}\n             + {1'b0, train.packet.instr[7], train.packet.instr[30:25], train.packet.instr[11:9]};\n  assign back_words = 5'd0 - train.packet.instr[13:9];\n  // Negative word offset in [-15,-1]. The low bit of the byte address is\n  // implicit and instruction bit 8 is the other alignment bit.\n  assign close_valid = capture && consecutive && train.closes && sum[10]\n                    && \"'!train.packet.instr[8] && (&{train.packet.instr[7], train.packet.instr[30:26]})\n                    && back_words != 0 && back_words <= 15 && back_words <= live_len;\n\n  always_ff @(posedge clock) begin\n    if (capture) begin\n      history[write_ptr] <= train.packet;\n      prior_pc <= train.pc;\n    end\n    if (read_copy) word_q <= history[read_ptr];\n    if (reset) begin\n      segment_valid <= 0;\n      live_len <= 0;\n      write_ptr <= 0;\n    end else begin\n      if (invalidate || request_q || (train.valid && !train.eligible))\n        segment_valid <= 0;\n      else if (capture) segment_valid <= 1;\n      if (capture) begin\n        write_ptr <= write_ptr + 5'\"'d1;\n        live_len <= \"'!consecutive ? 5'\"'d1 : live_len == 15 ? 5'd15 : live_len + 5'd1;\n      end\n    end\n    close_valid_q <= \"'!reset && !invalidate && close_valid;\n    head_q <= {train.pc[31:12], sum[9:0]};\n    tail_q <= train.pc[11:2];\n    last_q <= back_words[3:0];\n    start_q <= write_ptr - back_words;\n  end\n\n  logic [31:2] candidate_head_q;\n  logic [9:0] candidate_tail_q;\n  logic [3:0] candidate_last_q;\n  logic [4:0] candidate_start_q;\n  logic known, same0, same1, victim, conflict;\n  assign known = (bank_ready[0] && bank_head[0] == head_q)\n              || (bank_ready[1] && bank_head[1] == head_q);\n  assign same0 = bank_ready[0] && bank_head[0] == candidate_head_q;\n  assign same1 = bank_ready[1] && bank_head[1] == candidate_head_q;\n  assign victim = taking ? !chosen : !bank_ready[0] ? 0 : !bank_ready[1] ? 1 : !last_bank;\n  assign conflict = same0 || same1;\n\n  always_ff @(posedge clock) begin\n    if (reset || invalidate) begin\n      request_q <= 0;\n      bank_ready <= 0;\n      read_copy <= 0;\n      write_copy <= 0;\n    end else begin\n      request_q <= close_valid_q && !known && !request_q && !read_copy && !write_copy;\n      candidate_head_q <= head_q;\n      candidate_tail_q <= tail_q;\n      candidate_last_q <= last_q;\n      candidate_start_q <= start_q;\n\n      if (request_q && !conflict) begin\n        bank_ready[victim] <= 0;\n        bank_head[victim] <= candidate_head_q;\n        bank_tail[victim] <= candidate_tail_q;\n        bank_end[victim] <= candidate_last_q;\n        copy_bank <= victim;\n        read_copy <= 1;\n        read_ptr <= candidate_start_q;\n        read_slot <= 0;\n      end\n\n      write_copy <= read_copy;\n      if (read_copy) begin\n        write_slot <= read_slot;\n        read_slot <= read_slot + 4'\"'d1;\n        read_ptr <= read_ptr + 5'd1;\n        if (read_slot == bank_end[copy_bank]) read_copy <= 0;\n      end\n      if (write_copy) begin\n        if (write_slot == 0) heads[copy_bank] <= word_q;\n        if (write_slot == bank_end[copy_bank]) bank_ready[copy_bank] <= 1;\n      end\n    end\n  end\nendmodule\nEOF\npython3 - \\\"\"'$base/trial6/cores/bench/rtl/loop_trace.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1])\ns=p.read_text().replace('train.packet.instr[13:9]', '{train.packet.instr[26:25], train.packet.instr[11:9]}').replace('train.packet.instr[30:26]', 'train.packet.instr[30:27]')\np.write_text(s)\nPY\npython3 -m tools.eval.gowin bench --worktree \\\"\"'$base/trial6\" --all-options --paths 4 > \"$base/trial6/timing.log\" 2>&1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
