{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\n\nrng = Random(3220)\nmask = 0xffffffff\nedge = (0, 1, 2, 3, 7, 15, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, mask)\npairs = [(a,b) for a in edge for b in edge] + [(rng.getrandbits(32), rng.getrandbits(32) >> rng.randrange(32)) for _ in range(12000)]\nfor a, b in pairs:\n    for signed in (False, True):\n        x = a - (1 << 32) if signed and a >> 31 else a\n        y = b - (1 << 32) if signed and b >> 31 else b\n        n, d = abs(x), abs(y)\n        if d == 0:\n            q, r = mask, a\n        else:\n            q = r = 0\n            for shift in range(30, -1, -2):\n                shifted = (r << 2) | ((n >> shift) & 3)\n                digit = next(k for k in (3, 2, 1, 0) if shifted >= k*d)\n                q = (q << 2) | digit\n                r = shifted - digit*d\n                assert 0 <= r < d\n            q = -q if (x < 0) \"'!= (y < 0) else q\n            r = -r if x < 0 else r\n        refq = (-1 if y == 0 else ((abs(x) // abs(y)) * (-1 if (x < 0) != (y < 0) else 1)))\n        refr = a if y == 0 else x - refq * y\n        assert q & mask == refq & mask and r & mask == refr & mask\nprint(f'\"'Proposed radix-4 recurrence matched signed and unsigned reference on {2 * len(pairs):,} operand cases.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
