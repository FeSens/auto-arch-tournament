{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c 'variant_base=$(mktemp -d \"$TMPDIR/bench-r7s2-squash.XXXXXX\")\nprintf '\"'%s\\\\n' \\\"\"'$variant_base\"\ncat > \"$variant_base/squash.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nmode, root = sys.argv[1:]\np = Path(root) / 'cores/bench/rtl/if_stage.sv'\ns = p.read_text()\nstart = s.index('  if_id_t ')\nend = s.index('  logic [19:0] pc_page_q', start)\ncontrol = s[start:end]\nout_region = s[s.index('  assign live.pc'):]\nif mode == 'one':\n    control = control.replace('logic accept_fetch, redirect;', 'logic accept_fetch, head_valid;')\n    control = control.replace('  assign redirect = recover_taken || recover_fallthrough;', '  assign head_valid = buffered.valid && select_normal_q;')\n    control = control.replace('\"'!buffered.valid'\"', '\"'!head_valid'\"')\n    control = control.replace('\"'!reset && !redirect'\"\\\\n                   && ((buffered.valid && stall) || (imem_ready && (buffered.valid || stall)))',\n                         '\"'!reset && ((head_valid && stall) || (imem_ready && (head_valid || stall)))'\"')\n    out_region = out_region.replace('buffered.valid', 'head_valid')\nelse:\n    control = control.replace('logic accept_fetch, redirect, push_head, push_tail;', 'logic accept_fetch, head_valid, tail_valid, push_head, push_tail;')\n    control = control.replace('  assign redirect = recover_taken || recover_fallthrough;', '''  assign head_valid = head_q.valid && select_normal_q;\n  assign tail_valid = tail_q.valid && select_normal_q;''')\n    for prev, nxt in [('head_q.valid', 'head_valid'), ('tail_q.valid', 'tail_valid')]:\n        ss = []\n        for line in control.splitlines():\n            if 'assign ' + nxt + ' =' not in line:\n                rhs = line.split('<=')[-1] if '<=' in line else line\n                line = line[:-len(rhs)] + rhs.replace(prev,nxt)\n            ss.append(line)\n        control = '\\\\n'.join(ss) + '\\\\n'\n    control = control.replace('if (reset || redirect)', 'if (reset)')\n    control = control.replace('if (push_tail) tail_q.valid <= accept_fetch;', 'tail_q.valid <= push_tail ? accept_fetch : tail_valid;')\n    control = control.replace('if (push_tail) tail_q.valid <= imem_ready;', 'tail_q.valid <= push_tail ? imem_ready : tail_valid;')\n    out_region = out_region.replace('head_q.valid ?', 'head_valid ?')\n    out_region = out_region.replace('  assign out = head_valid ? head_q : live;', '''  assign out.pc = head_valid ? head_q.pc : live.pc;\n  assign out.instr = head_valid ? head_q.instr : live.instr;\n  assign out.predicted_taken = head_valid ? head_q.predicted_taken : live.predicted_taken;\n  assign out.valid = head_valid || imem_ready;''')\np.write_text(s[:start] + control + s[end:s.index('  assign live.pc')] + out_region)\nPY\nfor variant in one two shift two_alt shift_alt; do\n  root=\\\"\"'$variant_base/$variant\"\n  mkdir -p \"$root/cores/bench\"\n  mode=\"${variant%%_alt}\"\n  if test \"$mode\" = shift; then\n    reference=\"$TMPDIR/bench-r7s2-capacity.RjnbKb/$mode\"\n  else\n    reference=\"$TMPDIR/bench-r7s2-lookahead.cMvXgq/$mode\"\n  fi\n  cp -r \"$reference\"/cores/bench/rtl \"$reference\"/cores/bench/core.yaml \"$root/cores/bench/\"\n  cp -r fpga \"$root/\"\n  ln -s \"$TMPDIR/bench-r7s2-skid.5a9ieu/bench\" \"$root/bench\"\n  python \"$variant_base/squash.py\" \"$mode\" \"$root\"\n  if test \"$mode\" != \"$variant\"; then\n    python \"$TMPDIR/bench-r7s2-compare.9uwqLj/compare.py\" prenibble \"$root\"\n    python \"$TMPDIR/bench-r7s2-alternate.tz1YPV/alternate.py\" \"$root\"\n  fi\n  sed -n '\"'18,54p' \\\"\"'$root/cores/bench/rtl/if_stage.sv\" | head -31\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
