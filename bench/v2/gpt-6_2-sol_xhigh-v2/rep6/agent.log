{"type": "item.completed", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/if_stage.sv'", "aggregated_output": "// Instruction fetch, page-local prediction, and a four-entry fall-through queue.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              decode_accept,\n  input  logic              redirect,\n  input  logic [31:2]       ex_recovery_pc,\n  input  logic              mem_redirect,\n  input  predictor_update_t predictor_update,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t            out\n);\n\n  logic [19:0] pc_page_q, fetch_page, incremented_page;\n  logic [9:0]  pc_word_q, fetch_word;\n  logic [31:2] recovery_pc_q;\n  logic        select_normal_q;\n  logic [19:0] normal_page_plus_one, recovery_page_plus_one;\n  logic [10:0] sequential_sum;\n  logic        fetch_advance;\n\n  // A deferred branch's candidate was captured during its EX cycle. A MEM\n  // miss keeps that older candidate while any EX miss uses the new one.\n  always_ff @(posedge clock) begin\n    if (!mem_redirect)\n      recovery_pc_q <= ex_recovery_pc;\n    select_normal_q <= reset || !redirect;\n  end\n\n  assign fetch_page = select_normal_q ? pc_page_q : recovery_pc_q[31:12];\n  assign fetch_word = select_normal_q ? pc_word_q : recovery_pc_q[11:2];\n\n  // Increment each candidate page ahead of the fetch mux. A sequential wrap\n  // selects the incremented page even when the fetch is a recovery address.\n  assign normal_page_plus_one   = pc_page_q            + 20'd1;\n  assign recovery_page_plus_one = recovery_pc_q[31:12] + 20'd1;\n  assign incremented_page = select_normal_q ? normal_page_plus_one : recovery_page_plus_one;\n  assign sequential_sum = {1'b0, fetch_word} + 11'd1;\n\n  logic [63:0] trained_q;\n  logic [1:0] direction_counters [0:63];\n  logic [5:0] lookup_index;\n  logic [1:0] old_counter, next_counter;\n  logic branch_direction;\n\n  assign lookup_index = imem_addr[7:2] ^ imem_addr[13:8];\n  assign branch_direction = trained_q[lookup_index] ? direction_counters[lookup_index][1]\n                                                \n…[3453 of 6525 chars elided by tools/bench/transcript.py; sha256:6514e128888d7fa8]…\n};\n\n      if (empty && push)\n        head_q <= write_slot_q;\n      else if (pop && (push || !occupancy_q[1]))\n        head_q <= {head_q[2:0], head_q[3]};\n    end\n  end\n\n  assign imem_addr = {fetch_page, fetch_word, 2'b00};\n  assign live_packet = {imem_addr, imem_data, predicted_taken};\n\n  for (genvar slot = 0; slot < 4; slot++) begin : g_packet\n    // The free slot can sample eagerly. Only a push publishes its contents.\n    always_ff @(posedge clock) begin\n      if (space_available && write_slot_q[slot])\n        packets_q[slot] <= live_packet;\n    end\n  end\n\n  always_comb begin\n    queued_packet = '0;\n    for (int slot = 0; slot < 4; slot++)\n      queued_packet |= packets_q[slot] & {PACKET_WIDTH{head_q[slot]}};\n  end\n\n  assign decode_packet        = empty ? live_packet : queued_packet;\n  assign out.pc              = decode_packet.pc;\n  assign out.instr           = decode_packet.instr;\n  assign out.predicted_taken = decode_packet.predicted_taken;\n  assign out.valid           = !empty || imem_ready;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/div_unit.sv'", "aggregated_output": "// A blocking RV32M divider. Issue captures the operands, then each of eight\n// cycles consumes four dividend bits. The last cycle can transfer directly.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        request_valid,\n  output logic        request_ready,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        result_valid,\n  input  logic        result_ready,\n  output logic [31:0] result_magnitude,\n  output logic        result_negate,\n  output logic [31:0] saved_a,\n  output logic [31:0] saved_b\n);\n\n  logic [3:0] rounds_left;\n  logic issue;\n\n  assign request_ready = (rounds_left == 4'd0);\n  assign result_valid  = (rounds_left == 4'd1);\n  assign issue         = request_valid && request_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      rounds_left <= 4'd0;\n    else if (issue)\n      rounds_left <= 4'd8;\n    else if (!request_ready && (!result_valid || result_ready))\n      rounds_left <= rounds_left - 4'd1;\n  end\n\n  always_ff @(posedge clock) begin\n    if (issue) begin\n      saved_a <= a;\n      saved_b <= b;\n    end\n  end\n\n`ifdef RISCV_FORMAL_ALTOPS\n  logic [4:0] op_q;\n  logic [31:0] difference;\n\n  always_ff @(posedge clock) begin\n    if (issue) op_q <= op;\n  end\n\n  assign difference = saved_a - saved_b;\n  assign result_negate = 1'b0;\n  always_comb begin\n    case (op_q)\n      ALU_DIV:  result_magnitude = difference ^ 32'h7f8529ec;\n      ALU_DIVU: result_magnitude = difference ^ 32'h10e8fd70;\n      ALU_REM:  result_magnitude = difference ^ 32'h8da68fa5;\n      ALU_REMU: result_magnitude = difference ^ 32'h3138d0e1;\n      default:  result_magnitude = 32'b0;\n    endcase\n  end\n`else\n  logic signed_op, want_remainder;\n  logic a_negative, b_negative;\n  logic [31:0] dividend, divisor;\n  logic [31:0] divisor_q;\n  logic setup;\n  logic want_remainder_q, negate_result_q;\n\n  // The shift register starts with the dividend and fills with quotient\n  // digits from the low end as dividend digits leave from the high end.\n  logic [31:\n…[5429 of 8501 chars elided by tools/bench/transcript.py; sha256:cae8050fa79a8b24]…\ngn result_magnitude = want_remainder_q ? residual : quotient_next;\n  assign result_negate    = negate_result_q;\n\n  always_ff @(posedge clock) begin\n    if (issue) begin\n      quotient_q       <= dividend;\n      divisor_q        <= divisor;\n      want_remainder_q <= want_remainder;\n      // Zero divisor fits every trial: quotient digits are all ones and\n      // the remainder is the dividend magnitude. Preserve that quotient\n      // and restore the dividend sign for REM. INT_MIN/-1 wraps naturally.\n      negate_result_q  <= want_remainder ? a_negative\n                                        : (a_negative ^ b_negative) && (b != 32'b0);\n    end else if (!request_ready && !result_valid) begin\n      quotient_q  <= {quotient_q[27:0], setup ? leading_digit : digit};\n      remainder_q <= setup ? {24'b0, leading_remainder} : residual[27:0];\n    end\n    // Hold the final step's inputs while the consumer waits. The result\n    // and the saved operands stay stable until result_ready is asserted.\n  end\n`endif\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/id_stage.sv'", "aggregated_output": "// rtl/id_stage.sv\n//\n// Decode stage. Combinationally drives the regfile read ports and the\n// ID/EX register's next-state from the IF/ID combinational bundle plus\n// the regfile read data. The ID/EX register is owned by this module so\n// the decoded view of instruction n is latched by end of cycle n+1.\n//\n// Latency:        1 cycle (ID/EX register clocked here).\n// RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata, insn,\n//                 trap (via ctrl.is_illegal).\nmodule id_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,\n  input  logic              flush,\n  input  if_id_t  in,\n  // regfile read interface\n  output logic [4:0]        rs1_addr,\n  output logic [4:0]        rs2_addr,\n  input  logic [31:0]       rs1_data,\n  input  logic [31:0]       rs2_data,\n  input  operand_sel_t      rs1_sel,\n  input  operand_sel_t      rs2_sel,\n  input  load_match_t       load_match,\n  output logic              aligned_branch,\n  // ID/EX register output\n  output id_ex_t  out\n);\n\n  // ── Combinational decode ────────────────────────────────────────────────\n  logic [4:0]  dec_alu_op;\n  logic        dec_alu_src;\n  logic [2:0]  dec_branch_op;\n  logic        dec_is_branch;\n  logic        dec_is_jump;\n  logic        dec_is_jalr;\n  logic        dec_is_lui;\n  logic        dec_is_auipc;\n  logic        dec_mem_read;\n  logic        dec_mem_write;\n  logic [1:0]  dec_mem_width;\n  logic        dec_mem_sext;\n  logic        dec_reg_write;\n  logic        dec_mem_to_reg;\n  logic        dec_is_illegal;\n\n  decoder u_decoder (\n    .instr      (in.instr),\n    .alu_op     (dec_alu_op),\n    .alu_src    (dec_alu_src),\n    .branch_op  (dec_branch_op),\n    .is_branch  (dec_is_branch),\n    .is_jump    (dec_is_jump),\n    .is_jalr    (dec_is_jalr),\n    .is_lui     (dec_is_lui),\n    .is_auipc   (dec_is_auipc),\n    .mem_read   (dec_mem_read),\n    .mem_write  (dec_mem_write),\n    .mem_width  (dec_mem_width),\n    .mem_sext   (dec_mem_sext),\n    .reg_write  (dec_reg_write),\n    .mem_t\n…[2737 of 5809 chars elided by tools/bench/transcript.py; sha256:aa16e5b60544b966]…\nnd;\n      reg_q.instr       <= in.instr;\n      reg_q.predicted_taken <= in.predicted_taken;\n      reg_q.branch_recover_eq     <= branch_recovers_in_ex && !dec_branch_op[2];\n      reg_q.branch_recover_order  <= branch_recovers_in_ex && dec_branch_op[2];\n      reg_q.branch_recover_invert <= in.predicted_taken ^ dec_branch_op[0];\n      reg_q.recover_direct   <= !in.predicted_taken && !dec_is_jalr;\n      reg_q.recover_indirect <= !in.predicted_taken && dec_is_jalr;\n      reg_q.load_match  <= load_match;\n      // The producer in EX is a load. The other branch source can come\n      // from a regfile read or from the preceding instruction in MEM/WB.\n      reg_q.load_other_rs1 <= !load_match.rs1 && rs1_sel.local_value;\n      reg_q.load_other_rs2 <=  load_match.rs1 && rs2_sel.local_value;\n      reg_q.load_other_wb  <= load_match.rs1 ? rs2_sel.mem_wb : rs1_sel.mem_wb;\n    end\n\n    if (reset)\n      reg_q.valid <= 1'b0;\n    else if (!stall)\n      reg_q.valid <= in.valid && !flush;\n  end\n\n  assign out = reg_q;\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/core.sv'", "aggregated_output": "// rtl/core.sv\n//\n// Top-level wiring for the 5-stage in-order RV32IM core.\n//\n// IF -> ID -> EX -> MEM -> WB. Decode registers the forwarding selects\n// for EX. The hazard unit handles late-result dependencies, division,\n// and bus stalls.\n//\n// IO port names use the `io_*` Chisel-emit prefix so the existing\n// formal/wrapper_si.sv and test/cosim/main.cpp bindings carry through\n// byte-for-byte. RVFI port set is the single-channel set described in\n// CLAUDE.md invariant 1 under `nret: 1` (declared in core.yaml). The\n// orchestrator routes formal to wrapper_si.sv + checks_si.cfg and FPGA\n// synth to fpga/core_bench_si.sv for this core. There is no channel 1.\n//\n// Latency:        full pipeline; instruction n retires at MEM/WB on\n//                 cycle n+4 (no hazards) or later (dependency stall,\n//                 redirect).\n// RVFI fields:    all of them — driven from the MEM/WB register.\n`ifndef CORE_PKG_DEFINED\n`include \"core_pkg.sv\"\n`endif\n\nmodule core (\n  input  logic        clock,\n  input  logic        reset,\n  // imem\n  output logic [31:0] io_imemAddr,\n  input  logic [31:0] io_imemData,\n  // Fetch holds its request while the bus is stalled or the queue is full.\n  input  logic        io_imemReady,\n  // dmem\n  output logic [31:0] io_dmemAddr,\n  input  logic [31:0] io_dmemRData,\n  output logic [31:0] io_dmemWData,\n  output logic [3:0]  io_dmemWEn,\n  output logic        io_dmemREn,\n  // dmem bus backpressure. Drive 1 for zero-wait. Drive 0 to model\n  // dStall holds a memory op in EX/MEM and stalls decode. MEM/WB clears\n  // its retirement valid bit while fetch can still fill the queue.\n  input  logic        io_dmemReady,\n  // RVFI — single-channel retirement port set (NRET=1 contract,\n  // declared via `nret: 1` in core.yaml). Channel 0 is the sole\n  // retirement channel. See CLAUDE.md invariant 1 for the full contract.\n  output logic        io_rvfi_valid_0,\n  output logic [63:0] io_rvfi_order_0,\n  output logic [31:0] io_rvfi_insn_0,\n  output logic        io_rvfi_trap_0,\n  output logic        io_rvfi_halt_\n…[6094 of 9166 chars elided by tools/bench/transcript.py; sha256:f5f90eafbf3c7513]…\n\n    // Channel 0: the only retirement channel for the single-issue baseline.\n    io_rvfi_valid_0     = mem_wb_w.valid;\n    io_rvfi_order_0     = rvfi_order_q;\n    io_rvfi_insn_0      = mem_wb_w.instr;\n    io_rvfi_trap_0      = mem_wb_w.trap;\n    io_rvfi_halt_0      = 1'b0;\n    io_rvfi_intr_0      = 1'b0;\n    io_rvfi_mode_0      = 2'd3;     // M-mode only\n    io_rvfi_ixl_0       = 2'd1;     // 32-bit ISA\n    io_rvfi_rs1_addr_0  = mem_wb_w.rs1_addr;\n    io_rvfi_rs1_rdata_0 = mem_wb_w.rs1_val;\n    io_rvfi_rs2_addr_0  = mem_wb_w.rs2_addr;\n    io_rvfi_rs2_rdata_0 = mem_wb_w.rs2_val;\n    io_rvfi_rd_addr_0   = wb_w_en ? wb_w_addr : 5'b0;\n    io_rvfi_rd_wdata_0  = wb_w_en ? wb_w_data : 32'b0;\n    io_rvfi_pc_rdata_0  = mem_wb_w.pc;\n    io_rvfi_pc_wdata_0  = mem_wb_w.pc_next;\n    io_rvfi_mem_addr_0  = mem_wb_w.mem_addr;\n    io_rvfi_mem_rmask_0 = mem_wb_w.mem_rmask;\n    io_rvfi_mem_wmask_0 = mem_wb_w.mem_wmask;\n    io_rvfi_mem_rdata_0 = mem_wb_w.mem_rdata;\n    io_rvfi_mem_wdata_0 = mem_wb_w.mem_wdata;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
