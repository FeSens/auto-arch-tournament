{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport collections, sys\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\ncpu = RV32IM()\ncpu.load_elf('/srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep6/bench/programs/coremark.elf')\nprevious_producer = None\nin_window = False\nprofile = collections.Counter()\nwhile True:\n    event = cpu.step()\n    if event['mem_wmask'] and event['mem_addr'] == 0x10000104:\n        break\n    if in_window:\n        profile['retired'] += 1\n        if previous_producer and previous_producer[0] in (event['rs1'], event['rs2']):\n            profile['after_' + previous_producer[1] + '_raw_match'] += 1\n        insn = event['insn']\n        previous_producer = None\n        if insn & 0xfe00007f == 0x02000033:\n            kind = 'multiply' if ((insn >> 12) & 7) < 4 else 'divide_or_remainder'\n            profile[kind] += 1\n            if event['rd']:\n                previous_producer = (event['rd'], kind)\n    if event['mem_wmask'] and event['mem_addr'] == 0x10000100:\n        in_window = True\n    if event['insn'] == 0x00100073:\n        raise SystemExit('Missing stop marker')\nassert not cpu.oob_access\nprint(dict(profile))\nprint('Raw multiply match overhead relative to champion cycles:',\n      100 * profile['after_multiply_raw_match'] / 4491485)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
