g.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[7849 of 10921 chars elided by tools/bench/transcript.py; sha256:2978e751a5cb1acb]…\nath {i}: {p['arrival_ns']} ns, {p['logic_cells']} cells, {p['from']} -> {p['to']}\")\n            print(f\"          through: {' > '.join(p['modules'])}\")\n        print(f\"  full report: {tr}\")\n    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n121:formal:\n129:formal-deep:\n137:fpga: cosim-build bench/programs/coremark.elf\n140:timing:\ntotal 24\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 05:13 .\ndrwxr-xr-x  5 nobody nogroup 4096 Sep 28 05:13 ..\ndrwxr-xr-x 10 nobody nogroup 4096 Jul 10  2025 IDE\ndrwxr-xr-x  5 nobody nogroup 4096 Jul  5  2025 Programmer\ndrwxr-xr-x  4 nobody nogroup 4096 Sep 28 04:16 deps\n-rw-r--r--  1 nobody nogroup   76 Sep 28 04:15 gowin.tgz.sha256\n", "exit_code": 0, "status": "completed"}}
