{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r13_micro/profile.py\" <<'\"'PY'\nfrom collections import Counter\nimport json\nimport sys\n\ncycles = json.loads(sys.argv[1])\ncounts = Counter()\nbefore = None\nfor line in sys.stdin:\n    r = json.loads(line)\n    if r['cycle'] >= cycles['bench_stop_cycle']:\n        break\n    if before and r['cycle'] >= cycles['bench_start_cycle']:\n        w = before['insn']\n        rd = before['rd_addr']\n        op = w & 0x7f\n        if rd and (op == 3 or (op == 0x33 and w >> 25 == 1)):\n            op2 = r['insn'] & 0x7f\n            a = r['rs1_addr'] == rd\n            b = r['rs2_addr'] == rd\n            use_a = op2 in (3, 0x13, 0x23, 0x33, 0x63, 0x67)\n            use_b = op2 in (0x23, 0x33, 0x63)\n            if a or b:\n                counts[op, op2, 'used' if a and use_a or b and use_b else 'unused'] += 1\n    before = r\nfor k,val in counts.most_common():\n    print(k,val)\nPY\nmarker=\"'$(cores/bench/obj_dir/cosim_sim bench/programs/coremark.elf 50000000 --bench --istall --dstall | tail -1)\ncores/bench/obj_dir/cosim_sim bench/programs/coremark.elf 50000000 --istall --dstall | python3 \"$TMPDIR/r13_micro/profile.py\" \"$marker\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
