{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nimport subprocess\nimport sys\nfrom tempfile import mkdtemp\nfrom xml.etree import ElementTree\nfrom cocotb_tools.runner import get_runner\n\nrepo = Path.cwd()\nrtl = repo / 'cores/bench/rtl'\nscratch = Path(mkdtemp(prefix='fetch-diff-'))\nprint(f'Trace work directory: {scratch}', flush=True)\nsys.path.insert(0, str(repo / 'cores/bench/test'))\n\ndef trace(name):\n    folder = scratch / name\n    folder.mkdir()\n    original = name == 'baseline'\n    sources = []\n    for current in sorted(rtl.glob('*.sv'), key=lambda path: (path.name \"'!= '\"'core_pkg.sv', path.name)):\n        if original:\n            source = folder / current.name\n            source.write_bytes(subprocess.check_output(['git', 'show', 'HEAD:' + str(current.relative_to(repo))]))\n        else:\n            source = current\n        sources.append(source)\n    runner = get_runner('verilator')\n    runner.build(sources=sources, hdl_toplevel='core', build_dir=folder, always=True,\n                 waves=True, build_args=['--trace-depth', '3', '--trace-structs', '--trace-max-array', '8'],\n                 log_file=folder / 'build.log')\n    results = runner.test(hdl_toplevel='core', test_module='test_pipeline', test_dir=folder,\n                          build_dir=folder, waves=True, log_file=folder / 'sim.log')\n    tests = ElementTree.parse(results).findall('.//testcase')\n    assert tests and not any(test.find('failure') is not None for test in tests), results\n    print(f'{name}: {len(tests)} directed pipeline tests traced', flush=True)\n\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    list(pool.map(trace, ('baseline', 'candidate')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom tools.eval.gowin import build_all, summarize, parse_reports\nfrom tools.eval.fpga import _bench_sv\nfrom pathlib import Path\nroot = Path.cwd()\nout = root / 'cores/bench/generated/timing'\nresults = build_all(root, root / 'cores/bench/rtl', _bench_sv(str(root), 'bench'), out, options=(1, 2))\nfor result in results:\n    print(result)\np0 = parse_reports(out / 'gowin_p0')\nif not p0['placement_failed']:\n    print(summarize([{'place_option': 0, **p0}, *results]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
