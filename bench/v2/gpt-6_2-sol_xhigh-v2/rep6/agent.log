}, divisor_neg_q};\\\")\n    src_text=src_text.replace(\\\"assign difference = {1'b0, trial} - {1'b0, multiple[31:0]};\\\", \\\"assign difference = {1'b0, trial} + multiple[32:0];\\\")\n    src_text=src_text.replace(\\\"assign fits[k] = \"'!difference[32] && !(|multiple[35:32]);\", \"\"\"assign fits[k] = !difference[32] && ((&multiple[36:32]) || !(|multiple[36:32]));\"\"\")\n    src_text=src_text.replace(\"      divisor_q        <= divisor;\", \"\"\"      divisor_neg_q    <= divisor_neg;\n      divisor_low_q    <= b_negative ? -b[3:0] : b[3:0];\n      large_divisor_q  <= b_negative ? !((&b[31:4]) && (|b[3:0])) : (|b[31:4]);\"\"\")\n    if variant == '\"'neg_mult_chunks':\n        src_text=src_text.replace(\\\"  assign dividend       = a_negative ? -a : a;\\\\n  assign divisor_neg = b_negative ? {1'b1, b} : -{1'b0, b};\\\", \\\"\\\"\\\"  function automatic [31:0] maybe_negate(input logic [31:0] value, input logic negate);\n    logic [31:0] inverted;\n    begin\n      inverted = value \"'^ {32{negate}};\n      maybe_negate[7:0] = inverted[7:0] + {7'\"'b0, negate};\n      maybe_negate[15:8] = inverted[15:8] + {7'b0, negate && \"'!(|value[7:0])};\n      maybe_negate[23:16] = inverted[23:16] + {7'\"'b0, negate && \"'!(|value[15:0])};\n      maybe_negate[31:24] = inverted[31:24] + {7'\"'b0, negate && \"'!(|value[23:0])};\n    end\n  endfunction\n  assign dividend = maybe_negate(a, a_negative);\n  assign divisor_neg = {|b, maybe_negate(b, !b_negative)};\"\"\")\n    p.write_text(src_text)\nPY\npython3 \"$TMPDIR/r13_micro/setup_div.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
