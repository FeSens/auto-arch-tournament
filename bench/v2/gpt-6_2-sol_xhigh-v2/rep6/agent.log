{"type": "item.started", "item": {"id": "item_92", "type": "command_execution", "command": "/bin/bash -c 'set -e\nfor variant in mem-req-state mem-req-pregate mem-req-load-lanes; do\n  mkdir -p \"variants/$variant\"\n  cp -r variants/early-mem-controls/rtl \"variants/$variant/rtl\"\ndone\npython3 - <<'\"'PY'\nfrom pathlib import Path\nfor variant in (\\\"mem-req-state\\\", \\\"mem-req-pregate\\\", \\\"mem-req-load-lanes\\\"):\n    rtl = Path(\\\"variants\\\") / variant / \\\"rtl\\\"\n    pregate = \\\"state\\\" not in variant\n    load_lanes = \\\"load-lanes\\\" in variant\n    path = rtl / \\\"core_pkg.sv\\\"\n    s = path.read_text()\n    s = s.replace(\\\"    logic        mem_read, mem_write;\\\", \\\"    logic        mem_read, mem_write;\\\\n    logic [3:0]  write_mask;\\\" if pregate else \\\"    logic        mem_read, mem_write;\\\")\n    if load_lanes:\n        s = s.replace(\\\"    logic [3:0]  byte_mask;\\\", \\\"\\\"\\\"    logic [3:0]  byte_mask;\n    logic [3:0]  load_byte, load_byte_sext;\n    logic [1:0]  load_half, load_half_sext;\n    logic        load_word;\\\"\\\"\\\")\n    path.write_text(s)\n\n    path = rtl / \\\"ex_stage.sv\\\"\n    s = path.read_text()\n    start = s.index(\\\"      reg_q.mem_pending\\\")\n    end = s.index(\\\"      case\\\", start)\n    s = s[:start] + s[end:]\n    s = s.replace(\\\"  // ── EX/MEM register\\\", \\\"\\\"\\\"  logic [3:0] lane_mask;\n  always_comb begin\n    case (in.ctrl.mem_width)\n      2'd0: lane_mask = 4'b0001 << addr_low;\n      2'd1: lane_mask = 4'b0011 << addr_low;\n      default: lane_mask = 4'b1111;\n    endcase\n  end\n\n  // ── EX/MEM register\\\"\\\"\\\")\n    start = s.index(\\\"      case\\\", s.index(\\\"  ex_mem_t reg_q;\\\"))\n    end = s.index(\\\"\\\\n\\\\n\\\", start)\n    s = s[:start] + \\\"      reg_q.byte_mask <= lane_mask;\\\" + s[end:]\n    s = s.replace(\\\"\\\"\\\"    if (reset)\n      reg_q.valid <= 1'b0;\n    else if (\"'!stall)\n      reg_q.valid <= in.valid && !div_wait;\"\"\", \"\"\"    if (reset) begin\n      reg_q.valid <= 1'\"'b0;\n      reg_q.mem_pending <= 1'b0;\n      reg_q.mem_read <= 1'b0;\n      reg_q.mem_write <= 1'b0;\\\"\\\"\\\" + (\\\"\\\\n      reg_q.write_mask <= '0;\\\" if pregate else \\\"\\\") + \\\"\\\"\\\"\n    end else if (\"'!stall) begin\n      reg_q.valid <= in.valid && !div_wait;\n      reg_q.mem_pending <= is_mem && !mem_bad_alignment;\n      reg_q.mem_read <= in.valid && in.ctrl.mem_read && !mem_bad_alignment;\n      reg_q.mem_write <= in.valid && in.ctrl.mem_write && !mem_bad_alignment;\"\"\" + (\n        \"'\"\\\\n      reg_q.write_mask <= (in.valid && in.ctrl.mem_write && \"'!mem_bad_alignment) ? lane_mask : 4'\"'b0;\\\" if pregate else \\\"\\\") + \\\"\\\"\\\"\n    end\\\"\\\"\\\")\n    if load_lanes:\n        s = s.replace(\\\"      reg_q.byte_mask <= lane_mask;\\\", \\\"\\\"\\\"      reg_q.byte_mask <= lane_mask;\n      reg_q.load_byte <= in.ctrl.mem_width == 2'd0 ? lane_mask : '0;\n      reg_q.load_byte_sext <= in.ctrl.mem_width == 2'd0 && in.ctrl.mem_sext ? lane_mask : '0;\n      reg_q.load_half <= in.ctrl.mem_width == 2'd1 ? {addr_low[1], \"'!addr_low[1]} : '\"'0;\n      reg_q.load_half_sext <= in.ctrl.mem_width == 2'd1 && in.ctrl.mem_sext ? {addr_low[1], \"'!addr_low[1]} : '\"'0;\n      reg_q.load_word <= in.ctrl.mem_width == 2'd2;\\\"\\\"\\\")\n    path.write_text(s)\n\n    path = rtl / \\\"mem_stage.sv\\\"\n    s = path.read_text()\n    s = s.replace(\\\"assign dmem_pending = in.valid && in.mem_pending;\\\", \\\"assign dmem_pending = in.mem_pending;\\\")\n    s = s.replace(\\\"assign dmem_wen     = (in.valid && in.mem_write) ? byte_mask : 4'b0000;\\\",\n        \\\"assign dmem_wen     = in.write_mask;\\\" if pregate else \\\"assign dmem_wen     = in.mem_write ? byte_mask : 4'b0;\\\")\n    s = s.replace(\\\"assign dmem_ren     = in.valid && in.mem_read;\\\", \\\"assign dmem_ren     = in.mem_read;\\\")\n    if load_lanes:\n        start = s.index(\\\"  // shifted[31:16]\\\")\n        end = s.index(\\\"  logic [31:0] load_data;\\\", start)\n        s = s[:start] + s[end:]\n        start = s.index(\\\"    // Load extraction\\\")\n        end = s.index(\\\"    // RVFI ALIGNED_MEM\\\", start)\n        s = s[:start] + \\\"\\\"\\\"    load_data = {32{in.load_word}} & dmem_rdata;\n    for (int byte_index = 0; byte_index < 4; byte_index++) begin\n      load_data[7:0] |= {8{in.load_byte[byte_index]}} & dmem_rdata[byte_index*8 +: 8];\n      load_data[31:8] |= {24{in.load_byte_sext[byte_index] && dmem_rdata[byte_index*8+7]}};\n    end\n    for (int half_index = 0; half_index < 2; half_index++) begin\n      load_data[15:0] |= {16{in.load_half[half_index]}} & dmem_rdata[half_index*16 +: 16];\n      load_data[31:16] |= {16{in.load_half_sext[half_index] && dmem_rdata[half_index*16+15]}};\n    end\n\n\\\"\\\"\\\" + s[end:]\n    path.write_text(s)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
