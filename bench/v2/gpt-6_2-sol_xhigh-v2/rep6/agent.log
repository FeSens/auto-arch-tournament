{"type": "item.started", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nimport tempfile\n\nrepo = Path.cwd()\nbase = repo / 'cores/bench/rtl/div_unit.sv'\nscratch = Path(tempfile.mkdtemp(prefix='bench-r8s0-width-radix-'))\ncore = scratch / 'cores/bench'\nshutil.copytree(base.parent, core / 'rtl')\nshutil.copy2(repo / 'cores/bench/core.yaml', core / 'core.yaml')\nshutil.copytree(repo / 'fpga', scratch / 'fpga')\nsrc = base.read_text()\nfirst = src.index('  logic signed_op, want_remainder;')\nmiddle = src.index('  // The leading nibble')\nlast = src.index('  // Register the odd multiples')\nend = src.rindex('\"'`endif'\"')\ndeclarations = \\\"\\\"\\\"  logic signed_op, want_remainder;\n  logic a_negative, b_negative;\n  logic [31:0] dividend, divisor, divisor_q;\n  logic setup, want_remainder_q, negate_result_q, wide_q, zero_q;\n\n  logic [31:0] quotient_q, quotient_next;\n  logic [17:0] remainder_q;\n  logic [3:0] leading_digit, leading_remainder, digit;\n  logic [21:0] trial, residual;\n  logic [21:0] divisor_once, divisor_twice, divisor_four, divisor_eight;\n  logic [21:0] sum_three, carry_three;\n  logic [21:0] odd_multiple_q [1:7];\n  logic [21:0] candidate_residual [0:15];\n  logic [16:0] fits;\n  logic [15:0] selected;\n\n  logic [13:0] wide_quotient_q, wide_quotient_next;\n  logic [29:0] wide_remainder_q;\n  logic [33:0] triple_q;\n  logic [31:0] wide_trial, wide_residual;\n  logic [31:0] wide_candidate [0:3];\n  logic [4:0] wide_fits;\n  logic [3:0] wide_selected;\n  logic [1:0] wide_digit;\n\n  assign signed_op      = (op == ALU_DIV || op == ALU_REM);\n  assign want_remainder = (op == ALU_REM || op == ALU_REMU);\n  assign a_negative     = signed_op && a[31];\n  assign b_negative     = signed_op && b[31];\n  assign dividend       = a_negative ? -a : a;\n  assign divisor        = b_negative ? -b : b;\n  assign setup          = (rounds_left == 4'd8);\n\n\\\"\\\"\\\"\ntail = \\\"\\\"\\\"  function automatic [21:0] sum_terms (\n    input logic [21:0] x, y, z\n  );\n    logic [21:0] sum, carry;\n    begin\n      sum = x \"'^ y ''^ z;\n      carry = ((x & y) | ((x | y) & z)) << 1;\n      sum_terms = sum + carry;\n    end\n  endfunction\n\n  assign divisor_once  = {4'\"'b0, divisor_q[17:0]};\n  assign divisor_twice = divisor_once << 1;\n  assign divisor_four  = divisor_once << 2;\n  assign divisor_eight = divisor_once << 3;\n  assign sum_three = divisor_twice \"'^ divisor_four ''^ divisor_eight;\n  assign carry_three = ((divisor_twice & divisor_four)\n                     | ((divisor_twice | divisor_four) & divisor_eight)) << 1;\n\n  always_ff @(posedge clock) begin\n    if (setup) begin\n      odd_multiple_q[1] <= divisor_once + divisor_twice;\n      odd_multiple_q[2] <= divisor_once + divisor_four;\n      odd_multiple_q[3] <= sum_terms(divisor_once, divisor_twice, divisor_four);\n      odd_multiple_q[4] <= divisor_once + divisor_eight;\n      odd_multiple_q[5] <= sum_terms(divisor_once, divisor_twice, divisor_eight);\n      odd_multiple_q[6] <= sum_terms(divisor_once, divisor_four, divisor_eight);\n      odd_multiple_q[7] <= sum_terms(divisor_once, sum_three, carry_three);\n      triple_q          <= {2'\"'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\n    end\n  end\n\n  assign trial = {remainder_q, quotient_q[31:28]};\n  assign candidate_residual[0] = trial;\n  assign fits[0]  = 1'b1;\n  assign fits[16] = 1'b0;\n  for (genvar k = 1; k < 16; k++) begin : g_subtract\n    localparam integer SHIFT = (k % 2 \"'!= 0) ? 0 : (k % 4 != 0) ? 1\n                             : (k % 8 != 0) ? 2 : 3;\n    localparam integer ODD_INDEX = (k >> SHIFT) / 2;\n    logic [21:0] multiple;\n    logic [22:0] difference;\n    if (ODD_INDEX == 0)\n      assign multiple = divisor_once << SHIFT;\n    else\n      assign multiple = odd_multiple_q[ODD_INDEX] << SHIFT;\n    assign difference = {1'\"'b0, trial} - {1'b0, multiple};\n    assign fits[k] = \"'!difference[22];\n    assign candidate_residual[k] = difference[21:0];\n  end\n  assign selected = fits[15:0] & ~fits[16:1];\n\n  always_comb begin\n    residual = '\"'0;\n    digit = '0;\n    for (int k = 0; k < 16; k++) begin\n      residual |= {22{selected[k]}} & candidate_residual[k];\n      digit |= {4{selected[k]}} & 4'(k);\n    end\n  end\n\n  // A divisor at least 2\"'^18 cannot fit in the first 18 dividend bits.\n  assign wide_trial = {wide_remainder_q, wide_quotient_q[13:12]};\n  assign wide_candidate[0] = wide_trial;\n  assign wide_fits[0] = 1'\"'b1;\n  assign wide_fits[4] = 1'b0;\n  for (genvar k = 1; k < 4; k++) begin : g_wide_subtract\n    logic [33:0] multiple;\n    logic [32:0] difference;\n    if (k == 1)\n      assign multiple = {2'b0, divisor_q};\n    else if (k == 2)\n      assign multiple = {1'b0, divisor_q, 1'b0};\n    else\n      assign multiple = triple_q;\n    assign difference = {1'b0, wide_trial} - {1'b0, multiple[31:0]};\n    assign wide_fits[k] = \"'!difference[32] && !(|multiple[33:32]);\n    assign wide_candidate[k] = difference[31:0];\n  end\n  assign wide_selected = wide_fits[3:0] & ~wide_fits[4:1];\n\n  always_comb begin\n    wide_residual = '\"'0;\n    wide_digit = '0;\n    for (int k = 0; k < 4; k++) begin\n      wide_residual |= {32{wide_selected[k]}} & wide_candidate[k];\n      wide_digit |= {2{wide_selected[k]}} & 2'(k);\n    end\n  end\n\n  assign quotient_next      = {quotient_q[27:0], digit};\n  assign wide_quotient_next = {wide_quotient_q[11:0], wide_digit};\n  always_comb begin\n    if (zero_q)\n      result_magnitude = want_remainder_q ? saved_a : 32'hffffffff;\n    else if (wide_q)\n      result_magnitude = want_remainder_q ? wide_residual : {18'b0, wide_quotient_next};\n    else\n      result_magnitude = want_remainder_q ? {14'b0, residual[17:0]} : quotient_next;\n  end\n  assign result_negate = negate_result_q && \"'!zero_q;\n\n  always_ff @(posedge clock) begin\n    if (issue) begin\n      quotient_q       <= dividend;\n      di