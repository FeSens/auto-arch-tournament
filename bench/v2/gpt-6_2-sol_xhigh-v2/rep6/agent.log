{"type": "item.completed", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c \"sed -n '98,150p' test/cosim/run_cosim.py; sed -n '1,130p' cores/bench/test/test_replay_table.py; cat cores/bench/core.yaml\"", "aggregated_output": "                'field': 'retirement_count',\n                'expected': len(ref_trace), 'got': len(sim_trace)}\n    return {'passed': True, 'retired': len(ref_trace)}\n\nif __name__ == '__main__':\n    # Extra args after the ELF are passed to the simulator (e.g. --istall\n    # --dstall to run the trace comparison under bus backpressure).\n    sim_bin, elf, sim_flags = sys.argv[1], sys.argv[2], sys.argv[3:]\n    try:\n        ref, ref_completed, ref_reason = run_reference(elf)\n        sim, sim_completed, sim_returncode, sim_stderr = run_verilator(sim_bin, elf, sim_flags=sim_flags)\n        result = compare(ref, sim, ref_completed, sim_completed,\n                         ref_reason, sim_returncode, sim_stderr)\n    except (json.JSONDecodeError, subprocess.TimeoutExpired, OSError) as e:\n        result = {'passed': False, 'field': 'harness_error', 'detail': str(e)}\n    print(json.dumps(result))\n    sys.exit(0 if result['passed'] else 1)\n\"\"\"Synchronous replay bank checks at the read/write edge.\"\"\"\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _update(pc, instr):\n    # valid, word-PC tag, instruction [31:2], then 12 successor bits.\n    return (1 << 72) | ((pc >> 2) << 42) | ((instr >> 2) << 12)\n\n\n@cocotb.test()\nasync def masks_row_collisions_and_preserves_other_bank(dut):\n    odd, even = 0x0FFC, 0x1000\n    odd_alias, even_alias = odd + 0x1000, even + 0x1000\n    odd_instr, even_instr, replacement = 0x00100093, 0x00200113, 0x00300193\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    async def edge(pc, update=0, reset=False, invalidate=False):\n        dut.normal_pc.value = pc >> 2\n        dut.update.value = update\n        dut.reset.value = reset\n        dut.invalidate.value = invalidate\n        await Timer(1, \"ns\")\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n    async def check(pc, instr=None):\n        dut.normal_pc.value = pc >> 2\n        await Timer(1, \"ns\")\n        assert bool(dut.hit.value) == (instr is not None)\n        if instr is not None:\n            assert int(dut.packet.value) >> 12 == instr >> 2\n\n    await edge(odd, _update(odd, odd_instr), reset=True)\n    await edge(odd)\n    await check(odd)\n\n    await edge(odd, _update(odd, odd_instr))\n    await edge(odd, _update(even, even_instr))\n    await edge(odd)\n    # The addresses span a page boundary and wrap the even bank's index.\n    await check(odd, odd_instr)\n    await check(even, even_instr)\n\n    await edge(odd, _update(even_alias, replacement))\n    await check(odd, odd_instr)\n    await check(even)\n    await check(even_alias)\n    await edge(odd)\n    await check(even)\n    await check(even_alias, replacement)\n\n    await edge(odd, _update(odd_alias, replacement))\n    await check(odd)\n    await check(odd_alias)\n    await check(even_alias, replacement)\n    await edge(odd)\n    await check(odd)\n    await check(odd_alias, replacement)\n\n    await edge(odd, _update(odd, odd_instr), invalidate=True)\n    await check(odd_alias)\n    await check(even_alias)\n    await edge(odd)\n    await check(odd)\n    await check(odd_alias)\n    await check(even_alias)\n\n\ndef test_replay_table_runner():\n    run_cocotb(\n        toplevel=\"replay_table\",\n        sources=[\"core_pkg.sv\", \"replay_table.sv\"],\n        test_module=\"test_replay_table\",\n    )\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\nt