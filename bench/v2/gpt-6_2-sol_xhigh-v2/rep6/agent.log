{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '228,397p' cores/bench/test/test_pipeline.py && cat formal/checks_si.cfg\"", "aggregated_output": "async def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def forwarding_priority_traps_and_hold(dut):\n    auipc_upper = (14 << 8) | (15 << 3)  # Raw rs1=x15 and rs2=x14.\n    load_stalls = 4\n    program = [\n        ADDI(5, 0, 17),\n        ADDI(5, 0, 42),\n        ADD(6, 5, 5),          # Both sources prefer the newer EX writer.\n        ADDI(7, 0, 64),\n        JALR(7, 0, 2),         # The younger writer traps, leaving the MEM writer.\n        ADD(8, 7, 7),\n        ADDI(9, 0, 91),\n        LW(9, 0, 2),           # The misaligned load still interlocks its consumer.\n        ADD(10, 9, 0),         # Use the regfile's write-first value, skipping the load.\n        ADDI(11, 0, 171),\n        LW(12, 0, 0x80),       # Stalls with x11 in WB and its consumer in EX.\n        ADD(13, 11, 11),\n        ADDI(14, 13, 13),      # Forward both raw fields, but add immediate 13.\n        ADDI(15, 0, 77),\n        AUIPC(16, auipc_upper), # Forward both raw fields while adding PC + imm.\n        ADDI(0, 0, 73),\n        ADDI(0, 0, 94),\n        ADD(17, 0, 0),         # Neither write to x0 is a forwarding candidate.\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, dmem_init={0x80: 0xC0FFEE},\n                         dmem_stalls={0x80: load_stalls}, dmem_trace=requests)\n    assert [r[\"insn\"] for r in rets] == program\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    assert [r[\"pc\"] for r in rets] == list(range(0, 4 * len(program), 4))\n  