{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c 'scratch=$(mktemp -d \"$TMPDIR/bench-r5s0-grouped.XXXXXX\") &&\nmkdir -p \"$scratch/cores/bench\" &&\ncp -a cores/bench/{rtl,test,core.yaml} \"$scratch/cores/bench/\" &&\ncp -a Makefile fpga bench test \"$scratch/\" &&\npython - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np = Path(sys.argv[1])/'cores/bench/rtl/div_unit.sv'\ns = p.read_text()\nstart = s.index('  // Append two bits')\ns = s[:start] + '''  function automatic [32:0] trial_subtract (\n    input logic [31:0] trial,\n    input logic [33:0] multiple\n  );\n    logic [3:0] generate_borrow;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [3:0] propagate_borrow;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic [4:0] borrow;\n    logic [31:0] residual;\n    begin\n      borrow[0] = 1'b0;\n      for (int i = 0; i < 4; i++) begin\n        logic [7:0] a_group, b_group;\n        logic [8:0] difference;\n        logic [7:0] difference_with_borrow;\n        a_group = trial[8*i +: 8];\n        b_group = multiple[8*i +: 8];\n        difference = {1'b0, a_group} - {1'b0, b_group};\n        difference_with_borrow = a_group + ~b_group;\n        generate_borrow[i] = difference[8];\n        propagate_borrow[i] = a_group == b_group;\n        residual[8*i +: 8] = borrow[i] ? difference_with_borrow : difference[7:0];\n      end\n      borrow[1] = generate_borrow[0];\n      borrow[2] = generate_borrow[1]\n                | (propagate_borrow[1] & generate_borrow[0]);\n      borrow[3] = generate_borrow[2]\n                | (propagate_borrow[2] & generate_borrow[1])\n                | (propagate_borrow[2] & propagate_borrow[1] & generate_borrow[0]);\n      borrow[4] = generate_borrow[3]\n                | (propagate_borrow[3] & generate_borrow[2])\n                | (propagate_borrow[3] & propagate_borrow[2] & generate_borrow[1])\n                | (propagate_borrow[3] & propagate_borrow[2] & propagate_borrow[1] & generate_borrow[0]);\n      trial_subtract = {(borrow[4] || |multiple[33:32]), residual};\n    end\n  endfunction\n\n''' + s[start:]\ns=s.replace('input logic [31:0] partial,','input logic [29:0] partial,').replace('logic [34:0] trial;','logic [31:0] trial;')\ns=s.replace('logic [34:0] minus_one, minus_two, minus_three;', 'logic [32:0] minus_one, minus_two, minus_three;')\ns=s.replace(\\\"trial       = {1'b0, partial, bits};\\\", \\\"trial       = {partial, bits};\\\")\ns=s.replace(\\\"minus_one   = trial - {3'b0, divisor_once};\\\",\\\"minus_one   = trial_subtract(trial, {2'b0, divisor_once});\\\")\ns=s.replace(\\\"minus_two   = trial - {2'b0, divisor_once, 1'b0};\\\",\\\"minus_two   = trial_subtract(trial, {1'b0, divisor_once, 1'b0});\\\")\ns=s.replace(\\\"minus_three = trial - {1'b0, divisor_thrice};\\\",\\\"minus_three = trial_subtract(trial, divisor_thrice);\\\")\ns=s.replace('[34];','[32];').replace('radix4_step(remainder_q,','radix4_step(remainder_q[29:0],').replace('radix4_step(remainder_hi,','radix4_step(remainder_hi[29:0],')\ns=s.replace('logic [31:0] quotient_q, remainder_q;', 'logic [31:0] quotient_q;\\\\n  logic [27:0] remainder_q;')\ns=s.replace('radix4_step(remainder_q[29:0],', \\\"radix4_step({2'b0, remainder_q},\\\")\ns=s.replace(\\\"remainder_q      <= 32'b0;\\\", \\\"remainder_q      <= 28'b0;\\\").replace(\\\"remainder_q <= remainder_next;\\\", \\\"remainder_q <= remainder_next[27:0];\\\")\ns=s.replace('  logic [31:0] remainder_hi;', '  logic [31:0] remainder_hi;  // verilator lint_off UNUSEDSIGNAL')\ns=s.replace('logic [31:0] remainder_hi;  // verilator lint_off UNUSEDSIGNAL','/* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [31:0] remainder_hi;\\\\n  /* verilator lint_on UNUSEDSIGNAL */')\np.write_text(s)\nPY\nprintf '%s\\\\n' \\\"\"'$scratch\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
