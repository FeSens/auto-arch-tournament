{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'set -e\nbaseline_rtl=/srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep6/cores/bench/worktrees/hyp-20261123-001-r9s0-hypgen/cores/bench/rtl\nfor variant in compare-nibble compare-lex compare-six; do\n  mkdir -p \"variants/$variant\"\n  cp -r \"$baseline_rtl\" \"variants/$variant/rtl\"\ndone\npython3 - <<'\"'PY'\nfrom pathlib import Path\nfor variant in (\\\"compare-nibble\\\", \\\"compare-lex\\\", \\\"compare-six\\\"):\n    path = Path(\\\"variants\\\") / variant / \\\"rtl/ex_stage.sv\\\"\n    source = path.read_text()\n    start = source.index(\\\"  logic [3:0]  byte_equal\\\")\n    end = source.index(\\\"  assign branch_taken\\\", start)\n    if variant == \\\"compare-lex\\\":\n        logic = \\\"\\\"\\\"  // Fold comparisons of adjacent two-bit groups into a balanced tree.\n  logic [15:0] equal2, less2;\n  logic [7:0] equal4, less4;\n  logic [3:0] equal8, less8;\n  logic [1:0] equal16, less16;\n  logic equal_word, unsigned_less, signed_less;\n  for (genvar i = 0; i < 16; i++) begin : g_compare2\n    wire [1:0] a = rs1[2*i +: 2];\n    wire [1:0] b = rs2[2*i +: 2];\n    assign equal2[i] = a == b;\n    assign less2[i] = (\"'!a[1] && b[1]) || ((a[1] == b[1]) && !a[0] && b[0]);\n  end\n\n  for (genvar i = 0; i < 8; i++) begin : g_compare4\n    assign equal4[i] = equal2[2*i+1] && equal2[2*i];\n    assign less4[i] = less2[2*i+1] || (equal2[2*i+1] && less2[2*i]);\n  end\n  for (genvar i = 0; i < 4; i++) begin : g_compare8\n    assign equal8[i] = equal4[2*i+1] && equal4[2*i];\n    assign less8[i] = less4[2*i+1] || (equal4[2*i+1] && less4[2*i]);\n  end\n  for (genvar i = 0; i < 2; i++) begin : g_compare16\n    assign equal16[i] = equal8[2*i+1] && equal8[2*i];\n    assign less16[i] = less8[2*i+1] || (equal8[2*i+1] && less8[2*i]);\n  end\n  assign equal_word = &equal16;\n  assign unsigned_less = less16[1] || (equal16[1] && less16[0]);\n  assign signed_less = (rs1[31] != rs2[31]) ? rs1[31] : unsigned_less;\n  assign branch_cond = (in.ctrl.branch_op[2]\n     ? (in.ctrl.branch_op[1] ? unsigned_less : signed_less) : equal_word)\n     ''^ in.ctrl.branch_op[0];\n\n\"\"\"\n    else:\n        num_groups, size = (8, 4) if variant == \"compare-nibble\" else (6, 6)\n        logic = f\"\"\"  logic [{num_groups-1}:0] group_equal, group_less;\n  logic unsigned_less, branch_less, signs_differ;\n\n  for (genvar i = 0; i < {num_groups}; i++) begin : g_branch_compare\n    localparam integer SIZE = (i == {num_groups-1}) ? {32-size*(num_groups-1)} : {size};\n    assign group_equal[i] = rs1[i*{size} +: SIZE] == rs2[i*{size} +: SIZE];\n    assign group_less[i]  = rs1[i*{size} +: SIZE] <  rs2[i*{size} +: SIZE];\n  end\n\n\"\"\"\n        for i in range(num_groups // 2):\n            top = i*2+1\n            lo = i*2\n            logic += f\"  wire pair_less{i} = group_less[{top}] || (group_equal[{top}] && group_less[{lo}]);'\"\\\\n\\\"\n        terms = [f\\\"pair_less{num_groups // 2 - 1}\\\"]\n        for i in range(num_groups // 2 - 2, -1, -1):\n            terms.append(f\\\"((&group_equal[{num_groups-1}:{(i+1)*2}]) && pair_less{i})\\\")\n        logic += \\\"  assign unsigned_less = \\\" + \\\" || \\\".join(terms) + \\\";\\\\n\\\"\n        logic += \\\"\\\"\\\"  assign signs_differ = rs1[31] \"'^ rs2[31];\n  assign branch_less = (!in.ctrl.branch_op[1] && signs_differ) ? rs1[31] : unsigned_less;\n  assign branch_cond = (in.ctrl.branch_op[2] ? branch_less : (&group_equal))\n                     ''^ in.ctrl.branch_op[0];\n\n\"\"\"\n    path.write_text(source[:start] + logic + source[end:])\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
