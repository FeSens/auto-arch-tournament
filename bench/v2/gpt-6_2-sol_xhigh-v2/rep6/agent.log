— see the matching\n148:        // cycle dmem_ready transitions 0 -> 1.\n149:        if(top->io_dmemWEn && top->io_dmemReady) {\n150:            // MMIO UART at 0x10000000: capture to uart_buf, don't route to dmem\n151:            // (a non-gated ww() would wrap 0x10000000 to dmem[0] and corrupt it).\n155:            uint32_t addr = top->io_dmemAddr;\n164:                    if ((top->io_dmemWEn >> i) & 1) {\n165:                        char c = (top->io_dmemWData >> (i * 8)) & 0xFF;\n170:                ww(dmem, addr, top->io_dmemWData, top->io_dmemWEn);\n172:                // OOB write (neither dmem nor UART). Flag so testbench reports it.\n255:        // benchmark hit maxcycles without completing and the reading is invalid.\n280:    // access occurred. OOB historically silently aliased to dmem[0] which\n22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\n23:GOWIN_VERSION = \"1.9.11.03 Education\"\n35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n158:    timed_out = _run_gw_sh(outdir, log, gowin_env(env, outdir))\n","exit_code":0,"status":"completed"}}
