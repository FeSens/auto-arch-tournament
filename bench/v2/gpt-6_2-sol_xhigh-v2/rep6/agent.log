{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$(mktemp -d \"$TMPDIR/hyp-r15s0.XXXXXX\")\"\nmkdir \"$scratch/rtl\"\ncp cores/bench/rtl/*.sv \"$scratch/rtl/\"\nprintf '\"'%s\\\\n' \\\"\"'$scratch\" > \"$TMPDIR/hyp-r15s0-scratch\"\ncat > \"$scratch/predecode.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np = Path(sys.argv[1])\ns = p.read_text()\ns = s.replace('  logic [5:0] lookup_index_q, next_index;', '''  typedef struct packed {\n    logic [7:0] bank;\n    logic [7:0] row;\n  } direction_select_t;\n  direction_select_t lookup_q, next_lookup;\n  logic [63:0] forward_taken_q, backward_taken_q;\n  logic [7:0] forward_banks, backward_banks;\n  logic forward_taken, backward_taken;''')\ns = s.replace('  logic direction_trained, direction_taken, branch_direction, replay_direction;', '  logic branch_direction, replay_direction;')\nstart = s.index('  assign direction_trained')\nend = s.index('  assign old_counter', start)\ns = s[:start] + '''  for (genvar bank = 0; bank < 8; bank++) begin : g_direction_bank\n    assign forward_banks[bank] = |(forward_taken_q[bank*8 +: 8] & lookup_q.row);\n    assign backward_banks[bank] = |(backward_taken_q[bank*8 +: 8] & lookup_q.row);\n  end\n  assign forward_taken = |(forward_banks & lookup_q.bank);\n  assign backward_taken = |(backward_banks & lookup_q.bank);\n  assign branch_direction = imem_data[31] ? backward_taken : forward_taken;\n  assign replay_direction = replay_steering.cold_taken ? backward_taken : forward_taken;\n''' + s[end:]\ns = s.replace('''  // Only the trained bits need reset. Decode samples the pre-write state at\n  // the edge, and the queued update proceeds independently of fetch stalls.''','''  // Both prediction planes follow the same update as the counter state.\n  // Their reset values are the forward and backward cold predictions.''')\ns = s.replace(\\\"\\\"\\\"    if (reset)\n      trained_q <= '0;\n    else if (predictor_update.valid) begin\n      trained_q[predictor_update.index] <= 1'b1;\n      direction_counters[predictor_update.index] <= next_counter;\n    end\\\"\\\"\\\",\\\"\\\"\\\"    if (reset) begin\n      trained_q <= '0;\n      forward_taken_q <= '0;\n      backward_taken_q <= '1;\n    end else if (predictor_update.valid) begin\n      trained_q[predictor_update.index] <= 1'b1;\n      direction_counters[predictor_update.index] <= next_counter;\n      forward_taken_q[predictor_update.index] <= next_counter[1];\n      backward_taken_q[predictor_update.index] <= next_counter[1];\n    end\\\"\\\"\\\")\nstart = s.index('  logic [1:0] sequential_page_low;')\nend = s.index('  always_ff @(posedge clock)', start)\ns = s[:start] + '''  function automatic direction_select_t predecode_direction(input logic [5:0] index);\n    direction_select_t sel;\n    for (int i = 0; i < 8; i++) begin\n      sel.bank[i] = index[5:3] == 3'(i);\n      sel.row[i] = index[2:0] == 3'(i);\n    end\n    return sel;\n  endfunction\n\n  logic [1:0] sequential_page_low;\n  direction_select_t sequential_lookup, bus_target_lookup, replay_target_lookup;\n  direction_select_t recovery_lookup, recovery_advance_lookup;\n  assign sequential_page_low = normal_wrap ? normal_page_plus_one[1:0] : pc_page_q[1:0];\n  assign sequential_lookup = predecode_direction(direction_index(sequential_page_low, normal_sequential));\n  assign bus_target_lookup = predecode_direction(direction_index(pc_page_q[1:0], predicted_sum[9:0]));\n  assign replay_target_lookup = predecode_direction(direction_index(pc_page_q[1:0], replay_steering.target_word));\n  assign recovery_lookup = predecode_direction(direction_index(recovery_pc[13:12], recovery_pc[11:2]));\n  assign recovery_advance_lookup =\n    predecode_direction(direction_index(next_page[1:0], recovery_sequential));\n\n  assign next_lookup = ({16{\"'!correction && !normal_taken}} & sequential_lookup)\n                     | ({16{!correction && bus_target_selected}} & bus_target_lookup)\n                     | ({16{!correction && replay_target_selected}} & replay_target_lookup)\n                     | ({16{correction && !imem_ready}} & recovery_lookup)\n                     | ({16{correction && imem_ready}} & recovery_advance_lookup);\n\n'\"''' + s[end:]\ns = s.replace(\\\"lookup_index_q <= '0;\\\", \\\"lookup_q <= predecode_direction(6'b0);\\\")\ns = s.replace('lookup_index_q <= next_index;', 'lookup_q <= next_lookup;')\np.write_text(s)\nPY\npython3 \\\"\"'$scratch/predecode.py\" \"$scratch/rtl/if_stage.sv\"\nPYTHONDONTWRITEBYTECODE=1 python3 - \"$scratch\" <<'\"'PY'\nimport json, sys\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nres = build_all(root, scratch / 'rtl', 'fpga/core_bench_si.sv', scratch / 'timing')\nprint(json.dumps(res, indent=2))\nprint(json.dumps(summarize(res), indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
