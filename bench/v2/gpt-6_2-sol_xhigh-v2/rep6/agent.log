it edge(odd, _update(even, even_instr))\n    await edge(odd)\n    # The addresses span a page boundary and wrap the even bank's index.\n    await check(odd, odd_instr)\n    await check(even, even_instr)\n\n    await edge(odd, _update(even_alias, replacement))\n    await check(odd, odd_instr)\n    await check(even)\n    await check(even_alias)\n    await edge(odd)\n    await check(even)\n    await check(even_alias, replacement)\n\n    await edge(odd, _update(odd_alias, replacement))\n    await check(odd)\n    await check(odd_alias)\n    await check(even_alias, replacement)\n    await edge(odd)\n    await check(odd)\n    a\n…[9839 of 12911 chars elided by tools/bench/transcript.py; sha256:60900081b0f725ab]…\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    assert [r[\"cycle\"] for r in rets] == [2, 3, 4]  # Empty-queue fall-through.\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n", "exit_code": 0, "status": "completed"}}
