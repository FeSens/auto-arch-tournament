{"type": "item.completed", "item": {"id": "item_168", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,205p' cores/bench/test/test_div_unit.py; date\"", "aggregated_output": "\"\"\"Arithmetic and handshake tests for the clocked RV32M divider.\"\"\"\n\nimport random\nfrom itertools import product\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\ndef _expected(op, a, b):\n    remainder = op in (ALU_REM, ALU_REMU)\n    if b == 0:\n        return a if remainder else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        if a & (1 << 31):\n            a -= 1 << 32\n        if b & (1 << 31):\n            b -= 1 << 32\n    quotient = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        quotient = -quotient\n    return (a - quotient * b if remainder else quotient) & MASK32\n\n\nasync def _tick(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.reset.value = 1\n    dut.request_valid.value = 0\n    dut.result_ready.value = 1\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.request_ready.value and not dut.result_valid.value\n    dut.op.value = op\n    dut.a.value = a\n    dut.b.value = b\n    dut.request_valid.value = 1\n    await _tick(dut)\n    dut.request_valid.value = 0\n    # Change the input bus immediately after acceptance.\n    dut.op.value = ALU_REMU if op != ALU_REMU else ALU_DIV\n    dut.a.value = a ^ MASK32\n    dut.b.value = b ^ MASK32\n\n\nasync def _finish(dut, op, a, b):\n    for _ in range(7):\n        assert not dut.request_ready.value and not dut.result_valid.value\n        await _tick(dut)\n    # The eighth update is available for transfer on the next edge.\n    _check_result(dut, op, a, b)\n\n\ndef _check_result(dut, op, a, b):\n    assert dut.result_valid.value and not dut.request_ready.value\n    assert (int(dut.saved_a.value), int(dut.saved_b.value)) == (a, b)\n\n    a_negative = bool(a & (1 << 31))\n    b_negative = bool(b & (1 << 31))\n    negate = bool(dut.result_negate.value)\n    assert negate == (a_negative if op == ALU_REM else\n              \n…[2383 of 5455 chars elided by tools/bench/transcript.py; sha256:f4ba6efbb0eb040c]…\n\n    op, a, b = ALU_REM, 0x80000001, 13\n    await _start(dut, op, a, b)\n    await _finish(dut, op, a, b)\n    dut.request_valid.value = 1  # The changed inputs cannot be accepted yet.\n    for _ in range(4):\n        await _tick(dut)\n        _check_result(dut, op, a, b)\n    dut.result_ready.value = 1\n    await _tick(dut)\n    assert dut.request_ready.value and not dut.result_valid.value\n    await _start(dut, ALU_DIVU, 100, 7)\n    await _finish(dut, ALU_DIVU, 100, 7)\n\n\n@cocotb.test()\nasync def reset_discards_in_flight_operation(dut):\n    await _setup(dut)\n    await _start(dut, ALU_DIVU, 100, 7)\n    await _tick(dut)\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert dut.request_ready.value and not dut.result_valid.value\n    await _start(dut, ALU_REM, 17, 5)\n    await _finish(dut, ALU_REM, 17, 5)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\nMon Nov 23 06:29:02 CET 2026\n", "exit_code": 0, "status": "completed"}}
