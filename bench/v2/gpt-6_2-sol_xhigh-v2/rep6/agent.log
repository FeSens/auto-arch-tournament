  # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, \n…[9238 of 12310 chars elided by tools/bench/transcript.py; sha256:965d5de817e0b290]…\n0xF)\n    assert rets[6][\"rd_wdata\"] == 26\n    assert (rets[4][\"rs1_rdata\"], rets[4][\"rs2_rdata\"], rets[4][\"rd_wdata\"]) == (\n        0xFFFFFFBB, 3, 0xFFFFFFE9)\n    assert (rets[7][\"rs1_rdata\"], rets[7][\"rs2_rdata\"], rets[7][\"rd_wdata\"]) == (\n        26, 0xFFFFFFEC, 6)\n    assert rets[8][\"rd_wdata\"] == 8\n\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 1, 12, 9, 2, 3, 10, 2, 1], gaps\n\n\n@cocotb.test()\nasync def redirect_and_fetch_stall_squash_side_effects(dut):\n    program = [\n        JAL(0, 8),\n        SW(0, 0, 0x80),  # Wrong-path store on the stalled sequential fetch.\n        DIVU(1, 0, 0),\n        SW(1, 0, 0x84),\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, imem_stalls={4: 3, 8: 2, 12: 11},\n                         dmem_trace=requests)\n    assert [r[\"pc\"] for r in rets] == [0, 8, 12, 16]\n    assert [r[\"order\"] for r in rets] == list(range(4))\n    assert requests == [(0x84, 0, 0xF, 0xFFFFFFFF, True)]\n\n\ndef test_pipeline_runner():\n", "exit_code": 0, "status": "completed"}}
