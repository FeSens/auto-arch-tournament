n[ -f \"$RTL_DIR/core_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[1578 of 4650 chars elided by tools/bench/transcript.py; sha256:b1cc5f208aabc819]…\nc(worktree, sim_bin, env=env)\ntools/eval/fpga.py:385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\ntest/cosim/main.cpp:63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\ntest/cosim/main.cpp:68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\ntest/cosim/main.cpp:69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\ntest/cosim/main.cpp:70:    //           (tools/eval/fpga.py:run_coremark_ipc) passes BOTH so the\ntest/cosim/main.cpp:74:    bool istall = false;\ntest/cosim/main.cpp:75:    bool dstall = false;\ntest/cosim/main.cpp:78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\ntest/cosim/main.cpp:79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\ntest/cosim/main.cpp:119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\ntest/cosim/main.cpp:120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n", "exit_code": 0, "status": "completed"}}
