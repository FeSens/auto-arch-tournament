_pkg.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[2280 of 5352 chars elided by tools/bench/transcript.py; sha256:f23665e0f845b0b3]…\nms (V2). The .S files are generated once by\n# gen_random_trace.py <seed> and committed, so every candidate runs the\n# same programs.\nRANDOM_ELFS := bench/programs/random1.elf bench/programs/random2.elf bench/programs/random3.elf\n\nbench/programs/random%.elf: bench/programs/random%.S\n\t$(CC) -march=rv32im -mabi=ilp32 -static -nostartfiles \\\n\t  -T bench/programs/link.ld $< -o $@\n\n.PHONY: all clean\nall: bench/programs/coremark.elf bench/programs/selftest.elf $(RANDOM_ELFS)\nclean:\n\trm -f bench/programs/*.elf\n62:  RTL_DIR    := cores/$(TARGET)/rtl\n73:export RTL_DIR CORE_NAME OBJ_DIR GEN_DIR\n94:# verilator lint over $(RTL_DIR)/.\n98:\t@if ls $(RTL_DIR)/*.sv >/dev/null 2>&1; then \\\n99:\t  verilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+$(RTL_DIR) \\\n100:\t    $(if $(wildcard $(RTL_DIR)/core_pkg.sv),$(RTL_DIR)/core_pkg.sv) \\\n101:\t    $(filter-out $(RTL_DIR)/core_pkg.sv,$(wildcard $(RTL_DIR)/*.sv)); \\\n103:\t  echo \"lint: no source files in $(RTL_DIR)/\"; \\\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n", "exit_code": 0, "status": "completed"}}
