{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,230p' cores/bench/test/test_div_unit.py\nsed -n '203,275p' tools/eval/fpga.py\nrg -n 'case|TOP|WORK|CORES|FORMAL' formal/run_all.sh | head -45\"", "aggregated_output": "\"\"\"Arithmetic and handshake tests for the clocked RV32M divider.\"\"\"\n\nimport random\nfrom itertools import product\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\ndef _expected(op, a, b):\n    remainder = op in (ALU_REM, ALU_REMU)\n    if b == 0:\n        return a if remainder else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        if a & (1 << 31):\n            a -= 1 << 32\n        if b & (1 << 31):\n            b -= 1 << 32\n    quotient = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        quotient = -quotient\n    return (a - quotient * b if remainder else quotient) & MASK32\n\n\nasync def _tick(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.reset.value = 1\n    dut.request_valid.value = 0\n    dut.result_ready.value = 1\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.request_ready.value and not dut.result_valid.value\n    dut.op.value = op\n    dut.a.value = a\n    dut.b.value = b\n    dut.request_valid.value = 1\n    await _tick(dut)\n    dut.request_valid.value = 0\n    # Change the input bus immediately after acceptance.\n    dut.op.value = ALU_REMU if op != ALU_REMU else ALU_DIV\n    dut.a.value = a ^ MASK32\n    dut.b.value = b ^ MASK32\n\n\nasync def _finish(dut, op, a, b):\n    for _ in range(7):\n        assert not dut.request_ready.value and not dut.result_valid.value\n        await _tick(dut)\n    # The eighth update is available for transfer on the next edge.\n    _check_result(dut, op, a, b)\n\n\ndef _check_result(dut, op, a, b):\n    assert dut.result_valid.value and not dut.request_ready.value\n    assert (int(dut.saved_a.value), int(dut.saved_b.value)) == (a, b)\n\n    a_negative = bool(a & (1 << 31))\n    b_negative = bool(b & (1 << 31))\n    negate = bool(dut.result_negate.value)\n    assert negate == (a_negative if op == ALU_REM else\n              \n…[6361 of 9433 chars elided by tools/bench/transcript.py; sha256:17cf259345d972e7]…\nuart_int(uart: str, pattern: str, base: int = 10):\n11:#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n12:#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n32:RISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n39:# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n42:mkdir -p \"$RISCV_FORMAL/cores\"\n43:if [ -n \"${FORMAL_WORK_ID:-}\" ]; then\n44:    if [[ ! \"$FORMAL_WORK_ID\" =~ ^[A-Za-z][A-Za-z0-9]*$ ]]; then\n45:        echo \"ERROR: FORMAL_WORK_ID must be a letter followed by letters/digits\" >&2\n48:    CORE_DIR=\"$RISCV_FORMAL/cores/$CORE_NAME-$FORMAL_WORK_ID\"\n56:        try=\"$(mktemp -u \"$RISCV_FORMAL/cores/$CORE_NAME-wXXXXXXXX\")\"\n60:        echo \"ERROR: could not create a work dir under $RISCV_FORMAL/cores\" >&2\n64:WORK_ID=\"${CORE_DIR##*-}\"\n65:LOG=\"$SCRIPT_DIR/last_run-$WORK_ID.log\"\n114:if [ ! -d \"$RISCV_FORMAL\" ]; then\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n", "exit_code": 0, "status": "completed"}}
