{"type": "item.started", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r4-predictor-study/profile.cpp\" <<'\"'CPP'\n#include <array>\n#include <cstdio>\n#include <cstdint>\n#include <cstddef>\n#include <algorithm>\n#include <vector>\nstruct Record { uint32_t pc, next, insn, cycle, trap; };\nstruct Slot { uint32_t pc = ~0u, target = 0; int state = 0; };\nint main(int argc, char** argv) {\n    FILE* fp = fopen(argv[1], \\\"rb\\\");\n    std::vector<Record> records;\n    Record r{};\n    while (fread(&r, sizeof(r), 1, fp) == 1) if (\"'!r.trap && ((r.insn & 127) != 0x63 || (r.insn >> 12 & 7) != 2)) records.push_back(r);\n    fclose(fp);\n    int taken[3] = {}, counts[3] = {}, same[3][6] = {};\n    for (auto r : records) if (15802 <= r.cycle && r.cycle < 4543562) {\n        const int op = (r.insn & 127) == 0x63 ? 0 : (r.insn & 127) == 0x6f ? 1 : 2;\n        counts[op]++;\n        if (r.pc + 4 != r.next) {\n            taken[op]++;\n            for (int bits = 10; bits <= 15; ++bits) if ((r.pc >> bits) == (r.next >> bits)) same[op][bits-10]++;\n        }\n    }\n    for (int i = 0; i < 3; ++i) {\n        printf(\"op %d total %d taken %d same-page 1/2/4/8/16/32K=\", i, counts[i], taken[i]);\n        for (int v : same[i]) printf(\" %d\", v);\n        puts(\"\");\n    }\n    struct Result { int gains, bits, isize, shift, tag, mode, pred[3]; };\n    std::vector<Result> res;\n    for (int bits : {11,12,13,14,15,20}) for (int isize : {4,5,6,7}) for (int tag: {0,20}) for (int shift: {0,6,7,8,9,10,11,12}) for (int mode: {0,1,2,3,4,5,6}) {\n        std::array<Slot, 128> table{};\n        Result rr{0,bits,isize,shift,tag,mode,{}};\n        for (auto r : records) {\n            const unsigned op = r.insn & 127;\n            if ((op == 0x63 && (r.insn >> 12 & 7) == 3) || (op == 0x67 && (r.insn >> 12 & 7))) continue;\n            const unsigned linear = r.pc + 4;\n            const bool can_take = r.next != linear && (r.pc >> bits) == (r.next >> bits);\n            const int index = ((r.pc >> 2) ''^ (shift ? (r.pc >> shift) : 0)) & ((1 << isize) - 1);\n            const unsigned t = r.pc & ((1 << tag) - 1);\n            auto &s = table[index];\n            const bool hit = s.pc == t;\n            const uint32_t predicted = hit && s.state >= 2 ? ((r.pc >> bits << bits) | s.target) : linear;\n            if (15802 <= r.cycle && r.cycle < 4543562) {\n                const int diff = (linear != r.next) - (predicted != r.next);\n                rr.gains += diff;\n                rr.pred[op == 0x63 ? 0 : op == 0x6f ? 1 : 2] += diff;\n            }\n            if (can_take) {\n                s.pc = t;\n                s.target = r.next & ((1 << bits) - 1);\n                if (mode >= 4) s.state = hit ? std::min(3, s.state + 1) : (mode == 4 ? 2 : 3);\n                else s.state = 2;\n            } else if (mode == 0 || (mode == 1 && hit) || (mode == 3 && (r.insn >> 31) == 0)) {\n                s.pc = ~0u;\n                s.state = 0;\n            } else if (mode >= 4 && hit) {\n                if (mode == 6 && (r.insn >> 31) != 0 && op == 0x63) s.state = 3;\n                else s.state = std::max(0, s.state - 1);\n            }\n        }\n        res.push_back(rr);\n        if (bits == 12 && isize == 5 && shift == 7 && tag == 20)\n            printf(\"proposed variant mode %d gains %d branch %d JAL %d JALR %d'\"\\\\n\\\", mode, rr.gains, rr.pred[0], rr.pred[1], rr.pred[2]);\n    }\n    std::sort(res.begin(), res.end(), [](auto a, auto b){return a.gains > b.gains;});\n    for (auto r : res) if (r.isize == 5 && r.bits <= 14 && r.tag && r.mode <= 3)\n        printf(\\\"gains %d page bits %d table bits %d shift %d tag %d mode %d breakdown %d %d %d\\\\n\\\", r.gains,r.bits,r.isize,r.shift,r.tag,r.mode,r.pred[0],r.pred[1],r.pred[2]);\n}\nCPP\nc++ -O3 -o \\\"\"'$TMPDIR/r4-predictor-study/profile\" \"$TMPDIR/r4-predictor-study/profile.cpp\" && \"$TMPDIR/r4-predictor-study/profile\" \"$TMPDIR/r4-predictor-study/branch.bin\" > \"$TMPDIR/r4-predictor-study/profile.txt\" && head -40 \"$TMPDIR/r4-predictor-study/profile.txt\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
