{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"sed -n '510,685p' cores/bench/test/test_pipeline.py && sed -n '1,200p' formal/run_all.sh && cat formal/checks-deep.cfg\"", "aggregated_output": "        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\n@cocotb.test()\nasync def divide_forwarding_and_ready_bus_latency(dut):\n    program = [\n        ADDI(2, 0, 3),\n        ADDI(1, 0, -23),\n        DIV(3, 1, 2),\n        REM(4, 3, 2),\n        ADD(5, 3, 4),\n        LW(6, 0, 16),\n        DIVU(7, 6, 2),\n        REMU(8, 6, 7),\n        JAL(0, 8),\n        DIVU(12, 0, 0),  # Wrong-path divide must not issue.\n        REMU(10, 6, 2),\n        ADDI(11, 10, 1),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, dmem_init={16: 0xFFFFFFF1})\n    pcs = list(range(0, 36, 4)) + [40, 44, 48]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n    # A normal retirement gap is one cycle. Each divide adds eight,\n    # and a late-result dependency or taken jump can add one more. The\n    # JAL encoding's raw rs2 field matches the preceding REMU's x8.\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 9, 10, 2, 1, 10, 10, 2, 10, 2, 1], gaps\n    expected = {\n        2: (1, 0xFFFFFFE9, 2, 3, 3, 0xFFFFFFF9),\n        3: (3, 0xFFFFFFF9, 2, 3, 4, 0xFFFFFFFF),\n        6: (6, 0xFFFFFFF1, 2, 3, 7, 0x55555550),\n        7: (6, 0xFFFFFFF1, 7, 0x55555550, 8, 1),\n        9: (6, 0xFFFFFFF1, 2, 3, 10, 1),\n    }\n    for index, operands in expected.items():\n        r = rets[index]\n        assert (r[\"rs1_addr\"], r[\"rs1_rdata\"], r[\"rs2_addr\"], r[\"rs2_rdata\"],\n                r[\"rd\"], r[\"rd_wdata\"]) == operands\n    assert rets[4][\"rd_wdata\"] == 0xFFFFFFF8\n    assert rets[10][\"rd_wdata\"] == 2\n\n\n@cocotb.test()\nasync def multiply_arithmetic(dut):\n    boundary = [0, 1, 2, 3, 4, 0x7FFF, 0x8000, 0xFFFF, 0x10000,\n                0x7FFFFFFF, 0x8000\n…[15073 of 18145 chars elided by tools/bench/transcript.py; sha256:51a71f809c81688d]…\nference.py — every retired MUL/DIV/REM\n#      diff'd field-by-field.\n#   3. `make formal-deep` — same checks without ALTOPS. SLOW (~hours per\n#      M-ext check) but proves real arithmetic. Run periodically, not in\n#      the per-iteration orchestrator loop.\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\n# A vacuous suite (nothing ever retires) would fail this — no symbolic\n# trace can make rvfi_valid && !rvfi_trap go true.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n@basedir@/cores/@core@/core_pkg.sv\n@basedir@/cores/@core@/alu.sv\n@basedir@/cores/@core@/decoder.sv\n@basedir@/cores/@core@/imm_gen.sv\n@basedir@/cores/@core@/reg_file.sv\n@basedir@/cores/@core@/if_stage.sv\n@basedir@/cores/@core@/id_stage.sv\n@basedir@/cores/@core@/ex_stage.sv\n@basedir@/cores/@core@/mem_stage.sv\n@basedir@/cores/@core@/wb_stage.sv\n@basedir@/cores/@core@/hazard_unit.sv\n@basedir@/cores/@core@/forward_unit.sv\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n", "exit_code": 0, "status": "completed"}}
