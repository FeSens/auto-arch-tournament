{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c 'scratch=/srv/hwebench/tmp/86dd60e1/841f1512/bench-r9s2\ncat > \"$scratch/directions.cpp\" <<'\"'CPP'\n#include <algorithm>\n#include <array>\n#include <cstdint>\n#include <cstdio>\n#include <vector>\n\nstruct Branch { uint32_t pc; bool back, taken, local; };\n\nint main(int argc, char** argv) {\n    FILE* trace = fopen(argv[1], \\\"rb\\\");\n    std::vector<Branch> branches;\n    std::array<uint32_t,4> raw;\n    while (fread(raw.data(), sizeof(raw), 1, trace)) {\n        auto [cycle, pc, next_pc, insn] = raw;\n        if ((insn & 127) \"'!= 99) continue;\n        int32_t offset = int32_t(insn) >> 31 << 12;\n        offset |= ((insn >> 7) & 1) << 11;\n        offset |= ((insn >> 25) & 63) << 5;\n        offset |= (insn >> 7) & 30;\n        branches.push_back({pc, offset < 0, next_pc != pc + 4, (pc>>12)==((pc+offset)>>12)});\n    }\n\n    for (int bits = 5; bits <= 9; bits++) {\n        for (int hist = 0; hist <= 8; hist++) {\n            unsigned mask = (1U << bits) - 1;\n            unsigned mask_hist = (1U << hist) - 1;\n            unsigned history = 0;\n            unsigned misses = 0;\n            int counters[512] = {};\n            std::fill_n(counters, 512, -1);\n            for (auto [pc, back, taken, local]: branches) {\n                unsigned ix = ((pc >> 2) ''^ (pc >> (2+bits)) ''^ history) & mask;\n                int& c = counters[ix];\n                bool predict = local && (c < 0 ? back : c >= 2);\n                misses += predict != taken;\n                if (c < 0) c = taken ? 2 : 1;\n                else c = taken ? std::min(c+1, 3) : std::max(c-1, 0);\n                history = ((history << 1) | taken) & mask_hist;\n            }\n            printf(\"%d %d %u'\"\\\\n\\\", 1 << bits, hist, misses);\n        }\n    }\n}\nCPP\ng++ -O3 -std=c++17 \\\"\"'$scratch/directions.cpp\" -o \"$scratch/directions\" && \"$scratch/directions\" \"$scratch/trace.