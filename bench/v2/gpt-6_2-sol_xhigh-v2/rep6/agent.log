hth update is available for transfer on the next edge.\n    _check_result(dut, op, a, b)\n\n\ndef _check_result(dut, op, a, b):\n    assert dut.result_valid.value and not dut.request_ready.value\n    assert (int(dut.saved_a.value), int(dut.saved_b.value)) == (a, b)\n\n    a_negative = bool(a & (1 << 31))\n    b_negative = bool(b & (1 << 31))\n    negate = bool(dut.result_negate.value)\n    assert negate == (a_negative if op == ALU_REM else\n              \n…[3862 of 6934 chars elided by tools/bench/transcript.py; sha256:8a94b25733eafffd]…\n 08:24 checks.cfg\n-rw-rw----+  1 nobody nogroup  1455 Nov 23 08:24 checks_si.cfg\nlrwxrwxrwx+  1 nobody nogroup    66 Nov 23 08:24 riscv-formal -> /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep6/formal/riscv-formal\n-rwxrwx---+  1 nobody nogroup 10597 Nov 23 08:24 run_all.sh\n-rw-rw----+  1 nobody nogroup  4615 Nov 23 08:24 wrapper.sv\n-rw-rw----+  1 nobody nogroup  2863 Nov 23 08:24 wrapper_si.sv\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 99.444\n  lut4: 5340\n  ff: 1822\n  coremark_iter_s: 3.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261123-003-r12s2\n  updated: '2026-11-23T07:05:48.127737Z'\n.gitignore:87:cores/*/implementation_notes.md\tcores/bench/implementation_notes.md\n", "exit_code": 0, "status": "completed"}}
