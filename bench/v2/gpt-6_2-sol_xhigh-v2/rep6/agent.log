n+    divisor = 0x1_2345\n+    for digit, delta in product(range(1, 16), (-1, 0, 1)):\n+        dividend = (0x123 * 16 + digit) * divisor + delta\n+        for a_sign, b_sign in product((-1, 1), repeat=2):\n+            pairs.add(((a_sign * dividend) & MASK32, (b_sign * divisor) & MASK32))\n+\n+    # Probe each divisor limit and both neighbors. Just above the limit,\n+    # the truncated multiple is small enough to look like a false fit.\n+    for digit, offset in product(range(1, 16), (-1, 0, 1)):\n+        divisor = MASK32 // digit + offset\n+        if divisor > MASK32:\n+            continue\n+        pairs.add((MASK32, divisor))\n+        for delta in (-1, 0, 1):\n+            dividend = digit * divisor + delta\n+            if dividend <= MASK32:\n+                pairs.add((dividend, divisor))\n+\n+    for a, b in sorted(pairs):\n+        for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n+            await _start(dut, op, a, b)\n+            await _finish(dut, op, a, b)\n+            await _tick(dut)\n+    assert dut.request_ready.value and not dut.result_valid.value\n+\n+\n @cocotb.test()\n async def completion_holds_until_accepted(dut):\n     await _setup(dut)\n","exit_code":1,"status":"failed"}}
