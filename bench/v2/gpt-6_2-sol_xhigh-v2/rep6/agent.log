{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"mkdir -p '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/kill' '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/page'\ncp -R cores/bench/rtl '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/kill/'\ncp '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/head/rtl/core.sv' '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/head/rtl/hazard_unit.sv' '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/kill/rtl/'\ncp -R '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/head/rtl' '/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6/page/'\npython - <<'PY'\nfrom pathlib import Path\ns=Path('/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6')\np=s/'kill'/'rtl'/'if_stage.sv'\nx=p.read_text()\nx=x.replace(\\\"assign empty = occupancy_q[0];\\\", \\\"assign empty = \"'!select_normal_q || occupancy_q[0];\")\nx=x.replace(\"assign space_available = !occupancy_q[4];\", \"assign space_available = !select_normal_q || !occupancy_q[4];\")\nx=x.replace(\"if (reset || redirect) begin\", \"if (reset) begin\")\nx=x.replace(\"      case ({push, pop})'\"\\\\n        2'b10: occupancy_q <= occupancy_q << 1;\\\\n        2'b01: occupancy_q <= occupancy_q >> 1;\\\\n        default: ;\\\\n      endcase\\\",\n\\\"\\\"\\\"      if (\"'!select_normal_q)\n        occupancy_q <= push ? 5'\"'b00010 : 5'b00001;\n      else begin\n        case ({push, pop})\n          2'b10: occupancy_q <= occupancy_q << 1;\n          2'b01: occupancy_q <= occupancy_q >> 1;\n          default: ;\n        endcase\n      end\\\"\\\"\\\")\np.write_text(x)\np=s/'page'/'rtl'/'if_stage.sv'\nx=p.read_text()\nx=x.replace('logic [19:0] pc_page_q, fetch_page, incremented_page;',\n'''logic [19:0] pc_page_q, pc_page_next_q, fetch_page, incremented_page;\n  logic use_next_page_q;''')\nx=x.replace('logic [19:0] normal_page_plus_one, target_page_plus_one, fallthrough_page_plus_one;',\n'''logic [19:0] normal_page, normal_page_plus_one, target_page_plus_one, fallthrough_page_plus_one;''')\nx=x.replace('({20{select_normal_q}}      & pc_page_q)', '({20{select_normal_q}}      & normal_page)')\nx=x.replace('assign normal_page_plus_one      = pc_page_q           + 20\\\\'d1;',\n'''assign normal_page               = use_next_page_q ? pc_page_next_q : pc_page_q;\n  assign normal_page_plus_one      = use_next_page_q ? (pc_page_next_q + 20'd1) : pc_page_next_q;''')\nx=x.replace(\\\"assign sequential_sum = {1'b0, fetch_word} + 11'd1;\\\", \\\"assign sequential_sum = {&fetch_word, (fetch_word + 10'd1)};\\\")\nx=x.replace(\\\"pc_page_q <= '0;\\\\n      pc_word_q <= '0;\\\",\n\\\"\\\"\\\"pc_page_q <= '0;\n      pc_page_next_q <= 20'd1;\n      use_next_page_q <= 1'b0;\n      pc_word_q <= '0;\\\"\\\"\\\")\nx=x.replace(\\\"\\\"\\\"pc_page_q <= (fetch_advance && \"'!predicted_taken && sequential_sum[10])\n                 ? incremented_page : fetch_page;\"\"\",\n\"\"\"pc_page_q <= fetch_page;\n      pc_page_next_q <= incremented_page;\n      use_next_page_q <= fetch_advance && !predicted_taken && sequential_sum[10];\"\"\")\np.write_text(x)\nPY\npython -u - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nbase = Path('/srv/hwebench/tmp/86dd60e1/f430f70e/bench-recovery.yWjkS6')\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = [pool.submit(build, '.', base / d / 'rtl', 'fpga/core_bench_si.sv', opt, base / d / f'gowin{opt}') for d in ('kill','page') for opt in (0,1)]\n    for job in jobs:\n        r=job.result()\n        print(r.get('place_option'), r.get('fmax_mhz'), r.get('reason'), r.get('critical_paths',[])[:2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
