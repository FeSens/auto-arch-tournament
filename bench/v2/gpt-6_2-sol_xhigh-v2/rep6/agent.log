or (int k = 0; k < 16; k++)\n      wide_residual |= {32{wide_fits_q[k] && \"'!wide_fits_q[k+1]}} & wide_candidate[k];\n  end\n  assign residual = wide_reduce ? wide_residual : {12'\"'b0, short_residual};\n\n\\\"\\\"\\\" + source[b:]\nsource = source.replace(\\\"    if (issue) begin\\\\n      quotient_q       <= dividend;\\\", \\\"    if (issue) begin\\\\n      wide_q           <= |divisor[31:16];\\\\n      quotient_q       <= dividend;\\\")\na = source.index(\\\"    end else if (\"'!request_ready && !result_valid) begin\")\nb = source.index(\"    // Hold the final\", a)\nsource = source[:a] + \"\"\"    end else if (setup) begin\n      quotient_q <= wide_q ? {quotient_q[15:0], 16'\"'b0} : {quotient_q[27:0], leading_digit};\n      remainder_q <= wide_q ? {12'b0, quotient_q[31:16]} : {24'b0, leading_remainder};\n    end else if (\"'!request_ready && !result_valid && !wide_trials) begin\n      quotient_q <= quotient_next;\n      remainder_q <= residual[27:0];\n    end\n\"\"\" + source[b:]\npath.write_text(source)\nPY\nprintf '\"'%s\\\\n' \\\"\"'$scratch\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
