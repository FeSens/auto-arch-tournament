{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,230p' bench/programs/gen_random_trace.py\nsed -n '44,115p' test/cosim/main.cpp\nrg -n 'seed|usage' test/cosim/run_cosim.py tools/eval/fpga.py\nfind \\\"\"'$TMPDIR/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores\" -name logfile.txt -exec grep -L '\"'DONE (' {} + | head -n 12\"", "aggregated_output": "#!/usr/bin/env python3\n\"\"\"Generate deterministic random RV32IM programs for the full-trace cosim.\n\nHWE Bench V2. selftest.elf retires only 115 instructions, too few to catch\nbugs in forwarding, M-extension edge cases, store/load aliasing, or branch\nmisprediction recovery. Each program here retires a few thousand\ninstructions that tools/eval/cosim.py diffs, one by one, against the Python\nISS, with and without memory stalls.\n\nEvery program starts with an exhaustive M-extension edge matrix (each\nMUL/DIV/REM variant on every pair of edge operands), then random blocks.\n\nPrograms always terminate: branches and jumps only go forward, except the\nback edge of short counted loops whose counter register (x30) the loop body\nnever writes. Memory accesses stay inside a 64-byte .bss window addressed\nfrom x31 and are naturally aligned, so no instruction traps.\n\nUsage: gen_random_trace.py <seed> <out.S> [n_blocks]\n\"\"\"\nimport random\nimport sys\n\nEDGE = [0, 1, -1, 2, -2, 0x7FFFFFFF, -0x80000000, 0x80000001 - (1 << 32), 3, 0x55555555]\nGP = list(range(1, 29))          # x1..x28 free for random use\nBASE, LOOPC, JTMP = 31, 30, 29   # reserved: buffer base, loop counter, jalr target\n\nR_OPS = [\"add\", \"sub\", \"sll\", \"slt\", \"sltu\", \"xor\", \"srl\", \"sra\", \"or\", \"and\"]\nM_OPS = [\"mul\", \"mulh\", \"mulhsu\", \"mulhu\", \"div\", \"divu\", \"rem\", \"remu\"]\nI_OPS = [\"addi\", \"slti\", \"sltiu\", \"xori\", \"ori\", \"andi\"]\nSH_OPS = [\"slli\", \"srli\", \"srai\"]\nBR_OPS = [\"beq\", \"bne\", \"blt\", \"bge\", \"bltu\", \"bgeu\"]\nLOADS = [(\"lb\", 1), (\"lbu\", 1), (\"lh\", 2), (\"lhu\", 2), (\"lw\", 4)]\nSTORES = [(\"sb\", 1), (\"sh\", 2), (\"sw\", 4)]\nWINDOW = 64\n\n\nclass Gen:\n    def __init__(self, seed: int):\n        self.r = random.Random(seed)\n        self.lines: list[str] = []\n        self.label_n = 0\n\n    def reg(self, dest: bool = False) -> str:\n        # x0 is a legal destination (the write is discarded) and source.\n        if self.r.random() < 0.04:\n            return \"x0\"\n        return f\"x{self.r.choice(GP)}\"\n\n    def label(self) -> str:\n        self.label_n += 1\n        return f\"L{self.label_n}\"\n\n…[10613 of 13685 chars elided by tools/bench/transcript.py; sha256:f4ff87ce337473ef]…\n\n/srv/hwebench/tmp/86dd60e1/923bd390/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores/bench-w9jnFLFd0/checks/insn_or_ch0/engine_0/logfile.txt\n/srv/hwebench/tmp/86dd60e1/923bd390/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores/bench-w9jnFLFd0/checks/pc_bwd_ch0/engine_0/logfile.txt\n/srv/hwebench/tmp/86dd60e1/923bd390/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores/bench-w9jnFLFd0/checks/insn_sw_ch0/engine_0/logfile.txt\n/srv/hwebench/tmp/86dd60e1/923bd390/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores/bench-w9jnFLFd0/checks/insn_slt_ch0/engine_0/logfile.txt\n/srv/hwebench/tmp/86dd60e1/923bd390/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores/bench-w9jnFLFd0/checks/unique_ch0/engine_0/logfile.txt\n/srv/hwebench/tmp/86dd60e1/923bd390/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores/bench-w9jnFLFd0/checks/insn_mul_ch0/engine_0/logfile.txt\n/srv/hwebench/tmp/86dd60e1/923bd390/bench-fetch-formal.6nhECRts/formal/riscv-formal/cores/bench-w9jnFLFd0/checks/insn_ori_ch0/engine_0/logfile.txt\n", "exit_code": 0, "status": "completed"}}
