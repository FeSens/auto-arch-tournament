{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"cat schemas/hypothesis.schema.json\ncat formal/checks_si.cfg\nsed -n '1,240p' cores/bench/test/test_alu.py\"", "aggregated_output": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"required\": [\"id\",\"title\",\"category\",\"motivation\",\"hypothesis\",\"expected_impact\",\"changes\"],\n  \"properties\": {\n    \"id\":       {\"type\": \"string\", \"pattern\": \"^hyp-[0-9]{8}-[0-9]{3}(-r[0-9]+s[0-9]+)?$\"},\n    \"title\":    {\"type\": \"string\", \"minLength\": 5},\n    \"category\": {\"type\": \"string\", \"enum\": [\"micro_opt\",\"structural\",\"extension\",\"predictor\",\"memory\"]},\n    \"motivation\":  {\"type\": \"string\", \"minLength\": 20},\n    \"hypothesis\":  {\"type\": \"string\", \"minLength\": 20},\n    \"expected_impact\": {\n      \"type\": \"object\",\n      \"required\": [\"fitness_delta_pct\",\"confidence\"],\n      \"properties\": {\n        \"fitness_delta_pct\": {\"type\": \"integer\"},\n        \"confidence\": {\"type\": \"string\", \"enum\": [\"low\",\"medium\",\"high\"]}\n      }\n    },\n    \"changes\": {\n      \"type\": \"array\", \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"file\",\"description\"],\n        \"properties\": {\n          \"file\":        {\n            \"type\": \"string\",\n            \"description\": \"Must be under rtl/ (any extension) or be a test/test_*.py cocotb suite. Anything else is rejected by the runtime sandbox check.\",\n            \"pattern\": \"^(rtl/[^.].*|test/test_[^/]+\\\\.py)$\"\n          },\n          \"description\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 1\n…[6593 of 9665 chars elided by tools/bench/transcript.py; sha256:db80c025e82cab2e]…\n\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Real divides only (avoid edge-case short-circuit) so each pass\n    # exercises the full 33-cycle FSM.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
