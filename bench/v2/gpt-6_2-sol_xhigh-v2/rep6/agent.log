{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nimport tempfile\n\nrepo = Path.cwd()\nbase = repo / 'cores/bench/rtl/div_unit.sv'\nbodies = {\n'decoupled': \\\"\\\"\\\"    logic [3:0] byte_less;\n    logic [3:1] byte_equal;\n    logic candidate_less;\n    for (genvar byte_id = 0; byte_id < 4; byte_id++) begin : g_byte\n      assign byte_less[byte_id] = trial[8*byte_id +: 8] < multiple[8*byte_id +: 8];\n      if (byte_id \"'!= 0)\n        assign byte_equal[byte_id] = trial[8*byte_id +: 8] == multiple[8*byte_id +: 8];\n    end\n    assign candidate_less = byte_less[3]\n                          | (byte_equal[3] & byte_less[2])\n                          | ((&byte_equal[3:2]) & byte_less[1])\n                          | ((&byte_equal[3:1]) & byte_less[0]);\n    assign difference = trial - multiple[31:0];\n    assign fits[k] = !candidate_less && !(|multiple[35:32]);\"\"\",\n'\"'half-select': \\\"\\\"\\\"    logic [16:0] lower_difference;\n    logic [16:0] upper_difference;\n    logic [15:0] upper_minus_one;\n    logic upper_equal;\n    assign lower_difference = {1'b0, trial[15:0]} - {1'b0, multiple[15:0]};\n    assign upper_difference = {1'b0, trial[31:16]} - {1'b0, multiple[31:16]};\n    assign upper_minus_one = trial[31:16] + ~multiple[31:16];\n    assign upper_equal = trial[31:16] == multiple[31:16];\n    assign difference[15:0] = lower_difference[15:0];\n    assign difference[31:16] = lower_difference[16] ? upper_minus_one : upper_difference[15:0];\n    assign difference[32] = upper_difference[16] | (upper_equal & lower_difference[16]);\n    assign fits[k] = \"'!difference[32] && !(|multiple[35:32]);\"\"\",\n}\nold = \"\"\"    assign difference = {1'\"'b0, trial} - {1'b0, multiple[31:0]};\n    assign fits[k] = \"'!difference[32] && !(|multiple[35:32]);\"\"\"\nfor name, body in bodies.items():\n    scratch = Path(tempfile.mkdtemp(prefix=f'\"'bench-r8s0-{name}