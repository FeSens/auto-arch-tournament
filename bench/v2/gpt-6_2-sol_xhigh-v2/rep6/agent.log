e_mask : 4'b0000;\\\")\n        source = source.replace(\\\"assign dmem_ren     = in.ctrl.mem_read && dmem_pending;\\\", \\\"assign dmem_ren     = in.valid && in.mem_read;\\\")\n    path.write_text(source)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
