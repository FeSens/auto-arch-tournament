ut, program, imem_stalls={0x1008: 3, 0xff4: 2}, dmem_trace=requests)\n    pcs = [0, 0xff8, 0x1008, 0xff4, 0x1010, 0x1014, 0x1018, 0x101c]\n    assert [r['pc'] for r in rets] == pcs\n    assert [r['pc_next'] for r in rets[:-1]] == pcs[1:]\n    assert [r['rd_wdata'] for r in rets[:4]] == [pc + 4 for pc in pcs[:4]]\n    assert [r['trap'] for r in rets] == [0, 0, 0, 0, 1, 1, 0, 0]\n    assert not requests\n\n\n'''\nsrc=src.replace('def test_pipeline_runner():\\\\n',extra+'def test_pipeline_runner():\\\\n')\npath.write_text(src)\nPY\nPYTHONDONTWRITEBYTECODE=1 pytest -q -p no:cacheprovider \\\"\"'$candidate/project/cores/bench/test\" > \"$candidate/cocotb.log\" 2>&1\nresult=$?\ntail -65 \"$candidate/cocotb.log\"\nexit \"$result\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
