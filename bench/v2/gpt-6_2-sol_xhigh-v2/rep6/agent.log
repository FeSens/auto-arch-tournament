{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c 'workspace_path=\"$PWD\"\ncd \"$TMPDIR/predictor-r6s2.QecCvZ56\"\nmkdir -p unit_direct_reg\ncp -r \"$workspace_path/cores/bench/test\" unit_direct_reg/\nln -s ../rtl_direct_reg unit_direct_reg/rtl\npython3 - <<'\"'PY'\nfrom pathlib import Path\npath = Path(\\\"unit_direct_reg/test/test_pipeline.py\\\")\nsrc=path.read_text()\nsrc = src.replace(\\\"assert gaps == [1, 9, 10, 2, 1, 10, 10, 2, 10, 2, 1]\\\", \\\"assert gaps == [1, 9, 10, 2, 1, 10, 10, 2, 9, 2, 1]\\\")\ntests=\\\"\\\"\\\"\n@cocotb.test()\nasync def direct_prediction_and_page_wrap(dut):\n    program = [NOP()] * 1030\n    for pc, insn in {\n        0: JAL(0, 4088),\n        4: SW(0, 0, 0x80),\n        4096: JAL(0, 12),\n        4104: EBREAK(),\n        4108: JAL(0, -8),\n        4112: SW(0, 0, 0x84),\n    }.items():\n        program[pc // 4] = insn\n    requests = []\n    rets, _ = await _run(dut, program, imem_stalls={4096: 3, 4100: 4}, dmem_trace=requests)\n    pcs = [0, 4088, 4092, 4096, 4108, 4100, 4104]\n    assert [r[\\\"pc\\\"] for r in rets] == pcs\n    assert [r[\\\"pc_next\\\"] for r in rets[:-1]] == pcs[1:]\n    assert [r[\\\"cycle\\\"] - rets[i][\\\"cycle\\\"] for i, r in enumerate(rets[1:])] == [1, 1, 4, 1, 5, 1]\n    assert requests == []\n\n\n@cocotb.test()\nasync def recover_both_directions_under_bus_stalls(dut):\n    program = [\n        ADDI(1, 0, 1),\n        LW(2, 0, 0x80),\n        BEQ(0, 1, -4),  # Cold backward prediction misses to fall-through.\n        BEQ(0, 0, 8),   # Cold forward prediction misses to target.\n        SW(0, 0, 0x84),\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, dmem_stalls={0x80: 9},\n                         imem_stalls={12: 4, 20: 5}, dmem_trace=requests)\n    pcs = [0, 4, 8, 12, 20]\n    assert [r[\\\"pc\\\"] for r in rets] == pcs\n    assert [r[\\\"pc_next\\\"] for r in rets[:-1]] == pcs[1:]\n    assert requests == [(0x80, 1, 0, 0, False)] * 9 + [(0x80, 1, 0, 0, True)]\n\n\n@cocotb.test()\nasync def retry_cross_page_correction(dut):\n    program = [NOP()] * 1027\n    program[0] = JAL(1, 4104)\n    program[1] = SW(0, 0, 0x80)\n    program[1026] = EBREAK()\n    requests = []\n    rets, _ = await _run(dut, program, imem_stalls={4104: 5}, dmem_trace=requests)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4104]\n    assert rets[0][\\\"pc_next\\\"] == 4104\n    assert rets[0][\\\"rd_wdata\\\"] == 4\n    assert requests == []\n\n\n\\\"\\\"\\\"\nsrc = src.replace(\\\"def test_pipeline_runner():\\\", tests + \\\"def test_pipeline_runner():\\\")\npath.write_text(src)\nPY\ncd unit_direct_reg\npytest -q test > ../direct-reg-cocotb.log 2>&1\nresult=\"'$?\ntail -n 60 ../direct-reg-cocotb.log\nexit \"$result\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
