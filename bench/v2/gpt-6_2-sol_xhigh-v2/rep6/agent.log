tput=True, text=True, timeout=120, cwd=worktree_path, env=env\n        )\n        label = elf.name + (' [' + ' '.join(sim_flags) + ']' if sim_flags else '')\n        if result.returncode == 0:\n            return {'passed': True, 'elf': label}\n        else:\n            detail = (result.stdout + result.stderr)[-2000:]\n            return {'passed': False, 'elf': label, 'field': 'divergence', 'detail': detail}\n    except subprocess.TimeoutExpired:\n      \n…[6236 of 9308 chars elided by tools/bench/transcript.py; sha256:4bb45871bfa40f28]…\n7FFFFFFF, 0x80000000,\n                0x80000001, 0xFFFFFFF6, 0xFFFFFFFD, MASK32]\n    pairs = list(product(operands, repeat=2))\n    rng = random.Random(0xD1)\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(width))\n                 for width in range(1, 33) for _ in range(4))\n    for a, b in pairs:\n        for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n            await _start(dut, op, a, b)\n            await _finish(dut, op, a, b)\n            await _tick(dut)\n    assert dut.request_ready.value and not dut.result_valid.value\n\n\n@cocotb.test()\nasync def every_leading_nibble(dut):\n    await _setup(dut)\n    # Cover the narrow restoring steps and the bypass at divisors 16 and 17.\n    for nibble, b in product(range(16), range(18)):\n        a = (nibble << 28) | 0x0ABCDEF0\n        for op in (ALU_DIVU, ALU_REMU):\n            await _start(dut, op, a, b)\n            await _finish(dut, op, a, b)\n            await _tick(dut)\n\n\n@cocotb.test()\nasync def radix16_digit_boundaries(dut):\n    await _setup(dut)\n06:44:40\n", "exit_code": 0, "status": "completed"}}
