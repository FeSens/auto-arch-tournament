{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"cd /srv/hwebench/tmp/86dd60e1/07d06e73/predictor.EI0DwW\npython - <<'PY'\nfrom collections import Counter\nrows=[]\ntimed=False\nf=open('ctrl.txt')\nfor line in f:\n a=line.split()\n if a[0]=='M': timed=a[2]=='10000100'\n if a[0]\"'!='\"'B': continue\n pc,i,target=(int(s,16) for s in a[2:5]); out,trap,late=map(int,a[5:])\n if i&127 == 0x63 and not trap and not i&256:\n  rows.append((pc,i,out,late,timed))\nprint('conditional branch PCs in bracket:',len(set(row[0] for row in rows if row[-1])))\nfor size in (64, 128, 256, 512):\n for h in range(5):\n  ctrs={}; local={}; misses=Counter(); bits=size.bit_length()-1\n  for pc,i,o,l,t in rows:\n   index=((pc>>2) \"'^ (pc>>(2+bits))) & (size-1)\n   history=local.get(index,0)\n   key=index,history\n   old=ctrs.get(key)\n   prediction=(i>>31) if old is None else int(old>=2)\n   if t and prediction!=o: misses[l]+=1\n   ctrs[key]=1+o if old is None else min(3,max(0,old+2*o-1))\n   local[index]=(2*history+o)&((1<<h)-1)\n  print(size,h,misses[0],misses[1],sum(misses.values()))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
