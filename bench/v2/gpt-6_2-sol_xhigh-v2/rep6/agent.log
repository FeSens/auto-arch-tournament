{"type": "item.started", "item": {"id": "item_61", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r8s1-width/make_shared.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nsrc,dst=map(Path,sys.argv[1:3])\nmode=int(sys.argv[3])\ns=src.read_text()\na=s.index('  logic [31:0] narrow_quotient_q, wide_quotient_q;')\nb=s.index('  logic [3:0] leading_digit',a)\ns=s[:a]+'''  logic [31:0] quotient_q;\n  logic [27:0] remainder_q;\n  logic [3:0] final_high_q;\n'''+s[b:]\ns=s.replace('narrow_quotient_q[31:28]', 'quotient_q[31:28]')\na=s.index('  logic [23:0] narrow_residual;')\ns=s[:a]+'''  logic wide_trial_step, wide_reduce_step;\n  logic [31:0] trial, wide_residual;\n  logic [23:0] narrow_residual;\n  logic [3:0] narrow_digit, wide_digit;\n  logic [23:0] narrow_candidate [0:15];\n  logic [31:0] wide_candidate_q [0:15];\n  logic [16:0] wide_fits_q, narrow_fits;\n  logic [15:0] wide_selected, narrow_selected;\n\n  assign wide_trial_step = wide_q && (rounds_left == 4'd7 || rounds_left == 4'd5 || rounds_left == 4'd3);\n  assign wide_reduce_step = wide_q && (rounds_left == 4'd6 || rounds_left == 4'd4 || rounds_left == 4'd2);\n  assign trial = {remainder_q, quotient_q[31:28]};\n  assign narrow_fits[0] = 1'b1;\n  assign narrow_fits[16] = 1'b0;\n  assign wide_fits_q[0] = 1'b1;\n  assign wide_fits_q[16] = 1'b0;\n  assign narrow_candidate[0] = trial[23:0];\n  always_ff @(posedge clock) begin\n    if (wide_trial_step)\n      wide_candidate_q[0] <= trial;\n  end\n\n  for (genvar k = 1; k < 16; k++) begin : g_subtract\n    localparam integer SHIFT = (k % 2 \"'!= 0) ? 0 : (k % 4 != 0) ? 1\n                             : (k % 8 != 0) ? 2 : 3;\n    localparam integer ODD_INDEX = (k >> SHIFT) / 2;\n    logic [35:0] multiple;\n    logic [24:0] low_difference;\n    logic [8:0] high_difference;\n    if (ODD_INDEX == 0) begin : g_divisor\n      assign multiple = divisor_once << SHIFT;\n    end else begin : g_multiple\n      assign multiple = odd_multiple_q[ODD_INDEX] << SHIFT;\n    end\n    assign low_difference = {1'\"'b0, trial[23:0]} - {1'b0, multiple[23:0]};\n    assign high_difference = {1'b0, trial[31:24]} - {1'b0, multiple[31:24]} - 9'(low_difference[24]);\n    assign narrow_fits[k] = \"'!low_difference[24];\n    assign narrow_candidate[k] = low_difference[23:0];\n    always_ff @(posedge clock) begin\n      if (wide_trial_step) begin\n        wide_fits_q[k] <= !high_difference[8] && !(|multiple[35:32]);\n        wide_candidate_q[k] <= {high_difference[7:0], low_difference[23:0]};\n      end\n    end\n  end\n\n  assign narrow_selected = narrow_fits[15:0] & ~narrow_fits[16:1];\n  assign wide_selected = wide_fits_q[15:0] & ~wide_fits_q[16:1];\n\n  always_comb begin\n    narrow_residual = '\"'0;\n    wide_residual = '0;\n    narrow_digit = '0;\n    wide_digit = '0;\n    for (int k = 0; k < 16; k++) begin\n      narrow_residual |= {24{narrow_selected[k]}} & narrow_candidate[k];\n      wide_residual |= {32{wide_selected[k]}} & wide_candidate_q[k];\n      narrow_digit |= {4{narrow_selected[k]}} & 4'(k);\n      wide_digit |= {4{wide_selected[k]}} & 4'(k);\n    end\n  end\n\n  logic [31:0] narrow_quotient_next;\n  assign narrow_quotient_next = {quotient_q[27:0], narrow_digit};\n  always_comb begin\n    if (zero_q) result_magnitude = want_remainder_q ? quotient_q : 32'hffffffff;\n    else if (wide_q) result_magnitude = want_remainder_q ? {final_high_q, remainder_q} : quotient_q;\n    else result_magnitude = want_remainder_q ? {12'b0, narrow_residual[19:0]}\n                                             : narrow_quotient_next;\n  end\n  assign result_negate = negate_result_q;\n\n  always_ff @(posedge clock) begin\n    if (issue) begin\n      divisor_q        <= divisor;\n      wide_q           <= b_negative ? \"'!(&b[31:20]) || !(|b[19:0]) : (|b[31:20]);\n      zero_q           <= (b == 32'\"'b0);\n      want_remainder_q <= want_remainder;\n      negate_result_q  <= want_remainder ? a_negative\n                                        : (a_negative \"'^ b_negative) && (b != 32'\"'b0);\n      quotient_q       <= dividend;\n    end else if (setup && \"'!zero_q) begin\n      if (wide_q) begin\n        quotient_q  <= quotient_q << 20;\n        remainder_q <= {8'\"'b0, quotient_q[31:12]};\n      end else begin\n        quotient_q  <= {quotient_q[27:0], leading_digit};\n        remainder_q <= {24'b0, leading_remainder};\n      end\n    end else if (\"'!zero_q && !wide_q && !request_ready && !result_valid) begin\n      quotient_q  <= narrow_quotient_next;\n      remainder_q <= {8'\"'b0, narrow_residual[19:0]};\n    end else if (wide_reduce_step) begin\n      quotient_q  <= {quotient_q[27:0], wide_digit};\n      remainder_q <= wide_residual[27:0];\n      final_high_q <= wide_residual[31:28];\n    end\n  end\n\"'`endif\n\nendmodule\n'\"'''\nif mode==1:\n    s=s.replace(\\\"assign high_difference = {1'b0, trial[31:24]} - {1'b0, multiple[31:24]} - 9'(low_difference[24]);\\\", '''logic [8:0] high_no_borrow, high_with_borrow;\n    assign high_no_borrow   = {1'b0, trial[31:24]} - {1'b0, multiple[31:24]};\n    assign high_with_borrow = {1'b0, trial[31:24]} + {1'b1, ~multiple[31:24]};\n    assign high_difference  = low_difference[24] ? high_with_borrow : high_no_borrow;''')\nelif mode==2:\n    s=s.replace(\\\"assign high_difference = {1'b0, trial[31:24]} - {1'b0, multiple[31:24]} - 9'(low_difference[24]);\\\", '''logic [8:0] high_no_borrow, high_with_borrow;\n    assign high_no_borrow   = {1'b0, trial[31:24]} - {1'b0, multiple[31:24]};\n    assign high_with_borrow = high_no_borrow - 9'b1;\n    assign high_difference  = low_difference[24] ? high_with_borrow : high_no_borrow;''')\n# Narrow result is bounded by divisor, so the top four residual bits are discarded.\ns=s.replace('logic [23:0] narrow_residual;', 'logic [19:0] narrow_residual;').replace('logic [23:0] narrow_candidate', 'logic [19:0] narrow_candidate').replace('narrow_candidate[0] = trial[23:0]', 'narrow_candidate[0] = trial[19:0]').replace('narrow_