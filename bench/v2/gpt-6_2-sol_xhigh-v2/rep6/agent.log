ncluding the pipeline latency and older-memory hold checks.\n- Single-retire ALTOPS formal passed all 53 checks, including liveness. There were no counterexamples or formal fixes. The local formal run used the fast gate. Cocotb and ISS co-simulation exercised the hardware arithmetic.\n- Co-simulation matched the ISS for selftest and all three random programs with ready and stalled buses. Stalled CoreMark passed the canonical CRC, marker, validation-message, and address\n…[5305 of 8377 chars elided by tools/bench/transcript.py; sha256:fb2e1661a5e34e50]…\n   dut.result_ready.value = 0\n    op, a, b = ALU_REM, 0x80000001, 13\n    await _start(dut, op, a, b)\n    await _finish(dut, op, a, b)\n    dut.request_valid.value = 1  # The changed inputs cannot be accepted yet.\n    for _ in range(4):\n        await _tick(dut)\n        _check_result(dut, op, a, b)\n    dut.result_ready.value = 1\n    await _tick(dut)\n    assert dut.request_ready.value and not dut.result_valid.value\n    await _start(dut, ALU_DIVU, 100, 7)\n    await _finish(dut, ALU_DIVU, 100, 7)\n\n\n@cocotb.test()\nasync def reset_discards_in_flight_operation(dut):\n    await _setup(dut)\n    await _start(dut, ALU_DIVU, 100, 7)\n    await _tick(dut)\n    dut.reset.value = 1\n    await _tick(dut)\n    dut.reset.value = 0\n    assert dut.request_ready.value and not dut.result_valid.value\n    await _start(dut, ALU_REM, 17, 5)\n    await _finish(dut, ALU_REM, 17, 5)\n\n\ndef test_div_unit_runner():\n    run_cocotb(toplevel=\"div_unit\",\n               sources=[\"core_pkg.sv\", \"div_unit.sv\"],\n               test_module=\"test_div_unit\")\n", "exit_code": 0, "status": "completed"}}
