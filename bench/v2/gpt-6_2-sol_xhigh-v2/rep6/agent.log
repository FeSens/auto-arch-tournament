{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c 'variant_base=$(mktemp -d \"$TMPDIR/bench-r7s2-capacity.XXXXXX\")\nprintf '\"'%s\\\\n' \\\"\"'$variant_base\"\ncat > \"$variant_base/capacity.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nmode, root = sys.argv[1:]\np = Path(root) / 'cores/bench/rtl/if_stage.sv'\ns = p.read_text()\nstart = s.index('  if_id_t head_q, tail_q, live;')\nend = s.index('  logic [19:0] pc_page_q', start)\nif mode == 'shift':\n    block = s[start:end].replace('imem_ready && (\"'!tail_q.valid || !stall)'\"', 'imem_ready && \"'!tail_q.valid'\"')\n    block = block.replace('if (push_tail) tail_q.valid <= imem_ready;', 'if (push_tail) tail_q.valid <= accept_fetch;')\nelse:\n    depth = 2 if mode.startswith('2') else 3\n    index_bits = (depth - 1).bit_length()\n    accept_expr = '\"'!full_q || dequeue'\"' if mode.endswith('refill') else '\"'!full_q'\"'\n    block = f'''  localparam integer QUEUE_DEPTH = {depth};\n  localparam integer PTR_BITS = {index_bits};\n  if_id_t live;\n  logic [31:0] instr_q [0:QUEUE_DEPTH-1];\n  logic [31:2] pc_q [0:QUEUE_DEPTH-1];\n  logic taken_q [0:QUEUE_DEPTH-1];\n  logic [PTR_BITS-1:0] read_q, write_q;\n  logic [QUEUE_DEPTH:0] occupancy_q;\n  logic empty_q, full_q, dequeue, enqueue, accept_fetch, redirect;\n\n  assign empty_q      = occupancy_q[0];\n  assign full_q       = occupancy_q[QUEUE_DEPTH];\n  assign dequeue      = \"'!stall && !empty_q;\n  assign accept_fetch = imem_ready && ({accept_expr});\n  assign enqueue      = accept_fetch && (stall || !empty_q);\n  assign redirect     = recover_taken || recover_fallthrough;\n\n  function automatic logic [PTR_BITS-1:0] next_slot(input logic [PTR_BITS-1:0] slot);\n    return slot == PTR_BITS'\"'(QUEUE_DEPTH - 1) ? '0 : slot + 1'b1;\n  endfunction\n\n  for (genvar slot = 0; slot < QUEUE_DEPTH; slot++) begin : g_queue\n    always_ff @(posedge clock) begin\n      if (enqueue && write_q == PTR_BITS'(slot)) begin\n        instr_q[slot] <= live.instr;\n        pc_q[slot]    <= live.pc[31:2];\n        taken_q[slot] <= live.predicted_taken;\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      occupancy_q <= 1;\n      read_q <= '0;\n      write_q <= '0;\n    end else begin\n      if (dequeue) read_q <= next_slot(read_q);\n      if (enqueue) write_q <= next_slot(write_q);\n      if (dequeue \"'!= enqueue) occupancy_q <= enqueue ? occupancy_q << 1 : occupancy_q >> 1;\n    end\n  end\n\n'\"'''\n    s = s.replace('  assign out = head_q.valid ? head_q : live;', '''  assign out.pc = empty_q ? live.pc : {pc_q[read_q], 2'b00};\n  assign out.instr = empty_q ? live.instr : instr_q[read_q];\n  assign out.predicted_taken = empty_q ? live.predicted_taken : taken_q[read_q];\n  assign out.valid = \"'!empty_q || imem_ready;'\"''')\ns = s[:start] + block + s[end:]\np.write_text(s)\nPY\nfor mode in shift 2ring 2refill 3ring; do\n  root=\\\"\"'$variant_base/$mode\"\n  mkdir -p \"$root/cores/bench\"\n  cp -r \"$TMPDIR/bench-r7s2-lookahead.cMvXgq/two\"/cores/bench/rtl \"$TMPDIR/bench-r7s2-lookahead.cMvXgq/two\"/cores/bench/core.yaml \"$root/cores/bench/\"\n  cp -r fpga \"$root/\"\n  ln -s \"$TMPDIR/bench-r7s2-skid.5a9ieu/bench\" \"$root/bench\"\n  python \"$variant_base/capacity.py\" \"$mode\" \"$root\"\ndone'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
