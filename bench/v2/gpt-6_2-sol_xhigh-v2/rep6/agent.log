{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/r13_micro/setup_digit.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path(__file__).parent\nfor name in ('digit_tree','neg_digit','neg_early_digit','neg_digit_lut','neg_seed'):\n    src = Path(\\\"cores/bench/rtl\\\") if name == 'digit_tree' else root / 'neg_mult_chunks' / 'rtl'\n    rtl = root / name / 'rtl'\n    shutil.copytree(src, rtl, dirs_exist_ok=True)\n    p = rtl / 'div_unit.sv'\n    s = p.read_text()\n    s = s.replace('  logic [16:0] fits;\\\\n  logic [15:0] selected;', '  logic [15:1] fits;')\n    s = s.replace(\\\"  assign fits[0] = 1'b1;\\\\n  assign fits[16] = 1'b0;\\\\n\\\", \\\"\\\")\n    pos = s.index(\\\"  // Adjacent fit tests encode the quotient digit separately.\\\")\n    stop = s.index(\\\"  // Deliver the eighth digit\\\",pos)\n    if name in ('digit_tree','neg_digit','neg_seed'):\n        new_text = '''  logic [1:0] digit_four [0:3];\n  logic [2:0] digit_eight [0:1];\n  for (genvar k = 0; k < 4; k++) begin : g_digit_four\n    assign digit_four[k] = {fits[4*k+2], fits[4*k+2] ? fits[4*k+3] : fits[4*k+1]};\n  end\n  for (genvar k = 0; k < 2; k++) begin : g_digit_eight\n    assign digit_eight[k] = {fits[8*k+4], fits[8*k+4] ? digit_four[2*k+1] : digit_four[2*k]};\n  end\n  assign digit = {fits[8], fits[8] ? digit_eight[1] : digit_eight[0]};\n\n'''\n    else:\n        new_text = '''  assign digit[3] = fits[8];\n  assign digit[2] = (fits[4] && \"'!fits[8]) || fits[12];\n  assign digit[1] = (fits[2] && !fits[4]) || (fits[6] && !fits[8])\n                  || (fits[10] && !fits[12]) || fits[14];\n  assign digit[0] = (fits[1] && !fits[2]) || (fits[3] && !fits[4])\n                  || (fits[5] && !fits[6]) || (fits[7] && !fits[8])\n                  || (fits[9] && !fits[10]) || (fits[11] && !fits[12])\n                  || (fits[13] && !fits[14]) || fits[15];\n\n'\"'''\n        if name == 'neg_digit_lut':\n            new_text = '''  assign digit[3] = fits[8];\n  assign digit[2] = fits[12] \"'^ fits[8] ''^ fits[4];\n  assign digit[1] = fits[14] ''^ fits[12] ''^ fits[10] ''^ fits[8] ''^ fits[6] ''^ fits[4] ''^ fits[2];\n  assign digit[0] = ''^ fits;\n\n'\"'''\n    s=s[:pos]+new_text+s[stop:]\n    if name == 'neg_seed':\n        s=s.replace(\\\"\\\"\\\"  logic [31:0] dividend;\n  logic signed [32:0] divisor_neg, divisor_neg_q;\\\"\\\"\\\",\\\"\\\"\\\"  logic [31:0] dividend;\n  logic signed [32:0] divisor_neg, divisor_neg_q;\\\"\\\"\\\")\n        # Decrease the leading quotient setup path by calculating the divisor's\n        # narrow digit for both signed representations before issue.\n        s=s.replace(\\\"logic [3:0] divisor_low_q;\\\", \\\"logic [3:0] divisor_low_q;\\\\n  logic [31:0] saved_dividend_magnitude;\\\")\n        s=s.replace(\\\"  assign dividend = maybe_negate(a, a_negative);\\\", \\\"  assign dividend = maybe_negate(saved_a, negate_result_q);\\\\n  assign saved_dividend_magnitude = maybe_negate(saved_a, a_negative_saved);\\\\n  logic a_negative_saved;\\\")\n        s=s.replace(\\\"    if (issue) begin\\\\n      quotient_q       <= dividend;\\\", \\\"    if (issue) begin\\\\n      a_negative_saved <= a_negative;\\\")\n        s=s.replace(\\\"quotient_q[31:28]} : divide_nibble(quotient_q[31:28],\\\", \\\"saved_dividend_magnitude[31:28]} : divide_nibble(saved_dividend_magnitude[31:28],\\\")\n        s=s.replace(\\\"quotient_q  <= {quotient_q[27:0], setup ? leading_digit : digit};\\\", \\\"quotient_q  <= setup ? {saved_dividend_magnitude[27:0], leading_digit} : {quotient_q[27:0], digit};\\\")\n        s=s.replace(\\\"  logic [31:0] dividend;\\\\n\\\",\\\"\\\")\n        s=s.replace(\\\"  assign dividend = maybe_negate(saved_a, negate_result_q);\\\\n\\\",\\\"\\\")\n    p.write_text(s)\nPY\npython3 \\\"\"'$TMPDIR/r13_micro/setup_digit.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
