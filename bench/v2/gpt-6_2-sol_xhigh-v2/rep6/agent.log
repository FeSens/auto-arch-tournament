{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r8s1-prefix/profile_loads.py\" <<'\"'PY'\nimport collections, json, sys\ncounts=collections.Counter()\nprev = None\nscoped = False\nfor line in sys.stdin:\n    r = json.loads(line)\n    if r['mem_wmask'] and r['mem_addr'] == 0x10000100:\n        scoped = True\n    elif scoped and r['mem_wmask'] and r['mem_addr'] == 0x10000104:\n        break\n    elif scoped:\n        op = r['insn'] & 127\n        prevop = prev['insn'] & 127\n        prev_mul = prevop == 0x33 and prev['insn'] >> 25 == 1\n        counts['insns'] += 1\n        counts['loads'] += op == 3\n        counts['stores'] += op == 0x23\n        if prevop == 3 or prev_mul:\n            match_a = bool(prev['rd_addr'] and r['rs1_addr'] == prev['rd_addr'])\n            match_b = bool(prev['rd_addr'] and r['rs2_addr'] == prev['rd_addr'])\n            uses_a = op in (0x3, 0x13, 0x23, 0x33, 0x63, 0x67)\n            uses_b = op in (0x23, 0x33, 0x63)\n            if match_a or match_b:\n                tag = 'load' if prevop == 3 else 'm'\n                counts[tag+'_deps'] += 1\n                counts[tag+'_false_dep'] += not ((match_a and uses_a) or (match_b and uses_b))\n                counts[tag+'_store_data_only'] += op == 0x23 and match_b and not match_a\n                counts[tag+f'_used_by_{op:02x}'] += (match_a and uses_a) or (match_b and uses_b)\n    prev = r\nprint(counts)\nfor line in sys.stdin:\n    pass\nPY\ncd \\\"\"'$TMPDIR/bench-r8s1-prefix\" && ./cores/bench/obj_dir/cosim_sim bench/programs/coremark.elf 50000000 --istall --dstall | python3 profile_loads.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
