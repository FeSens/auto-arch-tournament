{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c 'scratch_dir=\"$TMPDIR/bench-predictor.yrU2Bs\"\ncat >\"$scratch_dir/loop.py\" <<'\"'PY'\nfrom pathlib import Path\nfrom shutil import copytree\nimport sys\nwork=Path(sys.argv[1])\nfor n in (6,7,8):\n    w=2**n\n    name=f\\\"loop_predict_{w}\\\"\n    rtl=work/name\n    copytree(work/'registered_relative',rtl,dirs_exist_ok=True)\n    p=rtl/'if_stage.sv'\n    c=p.read_text()\n    c=c.replace(\\\"  logic [63:0] override_q, strong_q;\\\",f\\\"\\\"\\\"\n  localparam int ROW_BITS = {n};\n  localparam int ROWS = 1 << ROW_BITS;\n  logic [ROWS-1:0] override_q, strong_q, override_next_q, valid_q;\n  (* syn_ramstyle = \\\"distributed_ram\\\" *) logic [12:0] loop_meta [0:ROWS-1];\n  logic [5:0] run, trip, new_run, new_trip;\n  logic repeat_trip, new_repeat_trip, matched, guess, new_override;\n  assign {{run, trip, repeat_trip}} = valid_q[update_index] ? loop_meta[update_index] : '0;\n  assign matched = run == trip && trip >= 6'd3 && trip \"'!= 6'\"'d63;\n  assign new_run = \"'!predictor_update.taken ? 6'\"'d0 : (&run) ? run : run + 6'd1;\n  assign new_trip = predictor_update.taken ? trip : run;\n  assign new_repeat_trip = predictor_update.taken ? repeat_trip && new_run <= trip : matched;\n  assign guess = new_run \"'!= new_trip;\n  assign new_override = new_repeat_trip ?\n                        (guess ''^ predictor_update.cold_taken) : old_strong ? old_override : disagreement;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      valid_q <= '\"'0;\n      override_next_q <= '0;\n    end else if (predictor_update.valid) begin\n      valid_q[update_index] <= 1'b1;\n      loop_meta[update_index] <= {{new_run, new_trip, new_repeat_trip}};\n      override_next_q[update_index] <= new_override;\n    end\n  end\\\"\\\"\\\")\n    c=c.replace(\\\"  assign invert_prediction = override_q[lookup_index_q];\\\",\\\"  assign invert_prediction = override_next_q[lookup_index_q];\\\")\n    if n>6:\n        c=c.replace(\\\"logic [5:0] lookup_index_q, next_index;\\\", \\\"logic [ROW_BITS-1:0] lookup_index_q, next_index;\\\")\n        c=c.replace(\\\"logic [5:0] update_index;\\\", \\\"logic [ROW_BITS-1:0] update_index;\\\")\n        c=c.replace(\\\"automatic logic [5:0] direction_index\\\",\\\"automatic logic [ROW_BITS-1:0] direction_index\\\")\n        c=c.replace(\\\"direction_index = word[5:0] \"'^ {page, word[9:6]};\", f\"direction_index = word[{n-1}:0] ''^ {n}'\"'({{page,word[9:{n}]}});\\\")\n        c=c.replace(\\\"logic [5:0] normal_next_index, recovery_next_index;\\\", \\\"logic [ROW_BITS-1:0] normal_next_index, recovery_next_index;\\\")\n        c=c.replace(\\\"{6{\"'!normal_taken}}\",\"{ROW_BITS{!normal_taken}}\").replace(\"{6{bus_target_selected}}\",\"{ROW_BITS{bus_target_selected}}\").replace(\"{6{replay_target_selected}}\",\"{ROW_BITS{replay_target_selected}}\")\n        p2=rtl/'\"'core_pkg.sv';p2.write_text(p2.read_text().replace(\\\"logic [5:0] index;\\\",f\\\"logic [{n-1}:0] index;\\\").replace(\\\"logic [5:0]  branch_index;\\\",f\\\"logic [{n-1}:0]  branch_index;\\\"))\n        p2=rtl/'ex_stage.sv';p2.write_text(p2.read_text().replace(\\\"in.pc[7:2] \"'^ in.pc[13:8]\",f\"in.pc[{n+1}:2] ''^ {n}'\"'(in.pc[13:{n+2}])\\\"))\n    p.write_text(c)\nPY\npython3 \\\"\"'$scratch_dir/loop.py\" \"$scratch_dir\"\nfor variant in loop_predict_64 loop_predict_128 loop_predict_256; do\n  RTL_DIR=\"$scratch_dir/$variant\" OBJ_DIR=\"$scratch_dir/$variant-obj\" NRET=1 bash test/cosim/build.sh >\"$scratch_dir/$variant-verilator.log\" 2>&1 && \"$scratch_dir/$variant-obj/cosim_sim\" \"$scratch_dir/coremark.elf\" 5000000 --bench --istall --dstall >\"$scratch_dir/$variant-result.txt\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
