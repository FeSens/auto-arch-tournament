{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$TMPDIR/bench-equality.K89Qaf\"\ncat > \"$scratch/compact.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nscratch=Path(__file__).resolve().parent\nfor name in ('compact','compact_mask'):\n    dest=scratch/name/'rtl'\n    shutil.copytree(scratch/'raw'/'rtl',dest,dirs_exist_ok=True)\n    def change(file,*pairs):\n        path=dest/f'{file}.sv'\n        s=path.read_text()\n        for before,after in pairs:\n            assert before in s, before\n            s=s.replace(before,after)\n        path.write_text(s)\n\n    change('core_pkg',\n        ('logic        extension_equal;', '''logic [3:0]  lanes;\n    logic        check_lanes;\n    logic        can_equal;\n    logic        equality_misses;'''))\n    change('ex_stage',\n        ('''  for (genvar i = 0; i < 4; i++) begin : g_load_compare\n    logic half_active, byte_active;\n    logic [7:0] expected;\n    assign half_active = half_load && load_lane[1] == 1'(i / 2);\n    assign byte_active = byte_load && load_lane == 2'(i);\n    assign expected = ({8{word_load}} & other_operand[i*8 +: 8])\n                    | ({8{half_active}} & other_operand[(i%2)*8 +: 8])\n                    | ({8{byte_active}} & other_operand[7:0]);\n    assign late_compare.byte_equal[i] = \"'!(word_load || half_active || byte_active)\n                                      || load_raw[i*8 +: 8] == expected;\n  end'\"''',\n         '''  logic [31:0] expected;\n  assign expected[7:0] = other_operand[7:0];\n  assign expected[15:8] = byte_load ? other_operand[7:0] : other_operand[15:8];\n  assign expected[23:16] = word_load ? other_operand[23:16] : other_operand[7:0];\n  assign expected[31:24] = byte_load ? other_operand[7:0]\n                         : half_load ? other_operand[15:8] : other_operand[31:24];\n\n  for (genvar i = 0; i < 4; i++) begin : g_load_compare\n    assign late_compare.lanes[i] = word_load || (half_load && load_lane[1] == 1'(i / 2))\n                                || (byte_load && load_lane == 2'(i));\n    assign late_compare.byte_equal[i] = load_raw[i*8 +: 8] == expected[i*8 +: 8];\n  end'''),\n        ('''  assign late_compare.extension_equal =\n      (\"'!byte_load || other_operand[31:8] == {24{load_signed && other_operand[7]}})\n      && (!half_load || other_operand[31:16] == {16{load_signed && other_operand[15]}});'\"''',\n         '''  logic extension_equal, single_match;\n  assign extension_equal =\n      (\"'!byte_load || other_operand[31:8] == {24{load_signed && other_operand[7]}})\n      && (!half_load || other_operand[31:16] == {16{load_signed && other_operand[15]}});\n  assign single_match = in.load_match.rs1 ''^ in.load_match.rs2;\n  assign late_compare.check_lanes = load_writes && single_match;\n  assign late_compare.can_equal = load_writes ? !single_match || extension_equal : branch_equal;\n  assign late_compare.equality_misses = !in.branch_recover_invert;'\"'''))\n    change('mem_stage',\n        ('''  assign late_equal = (late_branch.match.rs1 && late_branch.match.rs2)\n                   || ((&late_branch.byte_equal) && late_branch.extension_equal);''',\n         '''  assign late_equal = late_branch.can_equal\n                   && (\"'!late_branch.check_lanes || (&(late_branch.byte_equal | ~late_branch.lanes)));'\"'''),\n        ('''  assign branch_taken = deferred_branch && late_branch.load_writes ? late_taken : in.branch_taken;\n  assign redirect = in.valid && deferred_branch && (branch_taken \"'^ late_branch.predicted_taken);'\"''',\n         '''  assign branch_taken = deferred_branch ? late_taken : in.branch_taken;\n  assign redirect = in.valid && deferred_branch && (late_equal == late_branch.equality_misses);'''))\n    # equality_misses means an equal outcome mispredicts.\n    if name == 'compact_mask':\n        change('ex_stage',\n            ('''    assign late_compare.byte_equal[i] = load_raw[i*8 +: 8] == expected[i*8 +: 8];''',\n    