{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c 'scratch_dir=\"$TMPDIR/bench-predictor.yrU2Bs\"\ncat >\"$scratch_dir/model.cpp\" <<'\"'CPP'\n#include <algorithm>\n#include <array>\n#include <cstdio>\n#include <vector>\n\nstruct Event { unsigned pc, taken, back, cycle; };\nstd::vector<Event> events;\nenum Hash { fold, direct, xor7, xor8, mix8 };\nunsigned idx(unsigned w, unsigned n, Hash h) {\n    switch (h) {\n    case direct: return w&(n-1);\n    case xor7: return (w\"'^(w>>7))&(n-1);\n    case xor8: return (w''^(w>>8))&(n-1);\n    case mix8: return (w''^(w>>3)''^(w>>8))&(n-1);\n    default:\n        unsigned shift=__builtin_ctz(n);\n        return (w''^(w>>shift))&(n-1);\n    }\n}\nint main(int argc,char** argv){\n  FILE* f=fopen(argv[1],\"r\"); Event e;\n  while(fscanf(f,\"%u %u %u %u\",&e.pc,&e.taken,&e.back,&e.cycle)==4) events.push_back(e);\n  for(unsigned n: {64,128,256,512,1024,4096})\n  for(Hash h: {fold,direct})\n  for(unsigned b: {0,1,2,3,4,5,6})\n  for(unsigned g: {0,4,6,8}) {\n   if ((b>0 && g>0) || (h==direct && g>0)) continue;\n   std::vector<int> cnt((n<<b)<<g,-1);\n   std::vector<unsigned> hist(n);\n   unsigned global=0;\n   unsigned miss=0;\n   for(auto e:events) {\n      const unsigned row=idx(e.pc>>2,n,h);\n      const unsigned address=((row << b) | hist[row]) << g | global;\n      int &c=cnt[address];\n      const unsigned prediction=c<0 ? e.back : c>=2;\n      miss+=prediction!=e.taken;\n      c=c<0 ? (e.taken ? 2 : 1) : e.taken ? std::min(3,c+1) : std::max(0,c-1);\n      hist[row]=((hist[row]<<1)|e.taken)&((1u<<b)-1);\n      global=((global<<1)|e.taken)&((1u<<g)-1);\n   }\n   printf(\"%u %u h%u g%u %u'\"\\\\n\\\",n,h,b,g,miss);\n  }\n}\nCPP\ng++ -O3 \\\"\"'$scratch_dir/model.cpp\" -o \"$scratch_dir/model\" && \"$scratch_dir/model\" \"$scratch_dir/branches.txt\" >\"$scratch_dir/model.txt\" && sort -nk5 \"$scratch_dir/model.txt\" | head -35 && rg '\"'\"'^64 0 h0 g0 |''^128 0 h2 g0 | h0 g0 '\"' \\\