{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"cat > prototype.py <<'PY'\nfrom pathlib import Path\nrtl = Path('cores/bench/rtl')\n\ndef update(filename, edits):\n    path = rtl / filename\n    source = path.read_text()\n    for old, new in edits:\n        assert old in source, old\n        source = source.replace(old, new, 1)\n    path.write_text(source)\n\nupdate('core_pkg.sv', [\n    ('    logic [31:0] pc;\\\\n    logic [31:0] instr;', '    logic [31:0] pc;\\\\n    logic [31:0] pc_plus4;\\\\n    logic [31:0] instr;'),\n    ('    logic [31:0] pc;\\\\n    logic [31:0] rs1_val;', '    logic [31:0] pc;\\\\n    logic [31:0] pc_plus4;\\\\n    logic [31:0] rs1_val;'),\n    ('    logic [31:0] imm;', '    logic [31:0] imm;\\\\n    logic [31:0] imm_plus4;'),\n])\nupdate('if_stage.sv', [\n    ('  input  logic [31:0]       redirect_target,', '  input  logic [31:0]       redirect_target,\\\\n  input  logic [31:0]       redirect_target_plus4,'),\n    ('''  logic [31:0] pc;\n  // A redirect from advancing EX overrides a stalled sequential fetch.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (\"'!stall)   pc <= pc + 32'\"'d4;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_data;\n    out.valid = imem_ready;\n  end''', '''  logic [31:0] pc;\n  logic [31:0] pc_plus4;\n  assign pc_plus4 = pc + 32'd4;\n\n  // The returned instruction is tagged with the address launched this cycle.\n  assign imem_addr = redirect ? redirect_target : pc;\n  assign out.pc = imem_addr;\n  assign out.pc_plus4 = redirect ? redirect_target_plus4 : pc_plus4;\n  assign out.instr = imem_data;\n  assign out.valid = imem_ready;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      pc <= RESET_PC;\n    else if (\"'!stall)\n      pc <= out.pc_plus4;\n    else if (redirect)\n      pc <= redirect_target;\n  end'\"'''),\n])\nupdate('id_stage.sv', [\n    ('      reg_q.pc          <= in.pc;', '      reg_q.pc          <= in.pc;\\\\n      reg_q.pc_plus4    <= in.pc_plus4;'),\n    ('      reg_q.imm         <= imm;', '      reg_q.imm         <= imm;\\\\n      reg_q.imm_plus4   <= imm + 32\\\\'d4;'),\n])\nupdate('ex_stage.sv', [\n    ('  output logic [31:0]        redirect_target', '  output logic [31:0]        redirect_target,\\\\n  output logic [31:0]        redirect_target_plus4'),\n    ('  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;', '''  assign redirect_target = in.ctrl.is_jalr ? {effective_addr[31:1], 1'b0} : branch_target;\n\n  logic [31:0] indirect_target_plus4, direct_target_plus4;\n  assign indirect_target_plus4 = rs1 + in.imm_plus4;\n  assign direct_target_plus4 = in.pc_plus4 + in.imm;\n  assign redirect_target_plus4 = in.ctrl.is_jalr ? {indirect_target_plus4[31:1], 1'b0} : direct_target_plus4;'''),\n    (\\\"(in.pc + 32'd4)\\\",'in.pc_plus4'),\n    (\\\"(in.pc + 32'd4)\\\",'in.pc_plus4'),\n    (\\\"(in.pc + 32'd4)\\\",'in.pc_plus4'),\n])\nupdate('core.sv', [\n    ('  logic [31:0] redirect_target;', '  logic [31:0] redirect_target, redirect_target_plus4;'),\n    ('    .redirect_target (redirect_target),', '    .redirect_target (redirect_target),\\\\n    .redirect_target_plus4 (redirect_target_plus4),'),\n    ('    .redirect_target (redirect_target)\\\\n', '    .redirect_target (redirect_target),\\\\n    .redirect_target_plus4 (redirect_target_plus4)\\\\n'),\n    ('    .redirect       (redirect),\\\\n    .div_wait', '    .div_wait'),\n])\nupdate('hazard_unit.sv', [\n    ('  input  logic       redirect,\\\\n',''),\n    ('  assign flush_id     = late_dependency || redirect;', '  assign flush_id     = late_dependency;'),\n])\nPY\npython3 prototype.py\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
