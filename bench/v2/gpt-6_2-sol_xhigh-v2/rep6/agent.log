icit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, \n…[19571 of 22643 chars elided by tools/bench/transcript.py; sha256:76dcafcb5e9286a3]…\n program = [\n        ADDI(2, 0, 3),\n        ADDI(1, 0, -23),\n        DIV(3, 1, 2),\n        REM(4, 3, 2),\n        ADD(5, 3, 4),\n        LW(6, 0, 16),\n        DIVU(7, 6, 2),\n        REMU(8, 6, 7),\n        JAL(0, 8),\n        DIVU(12, 0, 0),  # Wrong-path divide must not issue.\n        REMU(10, 6, 2),\n        ADDI(11, 10, 1),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, dmem_init={16: 0xFFFFFFF1})\n    pcs = list(range(0, 36, 4)) + [40, 44, 48]\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"insn\"] for r in rets] == [program[pc // 4] for pc in pcs]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n    # Each divide adds eight cycles to the normal one-cycle gap. The JAL's\n    # raw rs2 field matches the preceding REMU's x8, and its prediction\n    # lets the target REMU issue without a redirect bubble.\n    gaps = [b[\"cycle\"] - a[\"cycle\"] for a, b in zip(rets, rets[1:])]\n    assert gaps == [1, 9, 10, 2, 1, 10, 10, 2, 9, 2, 1], gaps\n", "exit_code": 0, "status": "completed"}}
