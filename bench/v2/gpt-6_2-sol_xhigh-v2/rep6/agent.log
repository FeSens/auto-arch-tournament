{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' fpga/core_bench_si.sv; sed -n '280,380p' tools/eval/fpga.py\"", "aggregated_output": "// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[5755 of 8827 chars elided by tools/bench/transcript.py; sha256:46929bf04ae198f9]…\ngenerated\"\n    )\n    sim_bin = (\n        str(Path(worktree) / \"cores\" / target / \"obj_dir\" / \"cosim_sim\")\n        if target is not None\n        else None\n    )\n\n    results = gowin.build_all(worktree, rtl_dir, _bench_sv(worktree, target),\n                              generated_dir, env=env)\n    fp = gowin.summarize(results)\n    if fp['placement_failed']:\n        return fp\n    if fp['lut4'] is None or fp['ff'] is None:\n        # Never substitute 0: 0 logic is the best possible area score.\n        return {'bench_failed': True, 'placement_failed': False,\n                'reason': 'fpga_report_unparsed: no Logic/Register count in Gowin report',\n                'fmax_mhz': fp['fmax_mhz'], 'seeds': fp['seeds']}\n\n    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n    if not cm['completed']:\n        return {\n            'bench_failed': True,\n            'reason': cm.get('reason', 'unknown'),\n            'fmax_mhz': fp['fmax_mhz'],\n            'seeds': fp['seeds'],\n            'placement_failed': False,\n        }\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c \"sed -n '680,840p' cores/bench/test/test_pipeline.py; sed -n '840,925p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n@cocotb.test()\nasync def redirect_and_fetch_stall_squash_side_effects(dut):\n    program = [\n        BEQ(0, 0, 8),   # Cold forward branch resolves taken.\n        SW(0, 0, 0x80),  # Wrong-path store on the stalled sequential fetch.\n        DIVU(1, 0, 0),\n        SW(1, 0, 0x84),\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, imem_stalls={4: 3, 8: 2, 12: 11},\n                         dmem_trace=requests)\n    assert [r[\"pc\"] for r in rets] == [0, 8, 12, 16]\n    assert [r[\"order\"] for r in rets] == list(range(4))\n    assert requests == [(0x84, 0, 0xF, 0xFFFFFFFF, True)]\n\n\ndef _assert_retirement_path(rets, pcs):\n    assert [r[\"pc\"] for r in rets] == pcs\n    assert [r[\"pc_next\"] for r in rets] == pcs[1:] + [(pcs[-1] + 4) & 0xFFFFFFFF]\n    assert [r[\"order\"] for r in rets] == list(range(len(pcs)))\n\n\n@cocotb.test()\nasync def fetch_queue_fills_and_drains(dut):\n    program = [\n        LW(1, 0, 0x80),\n        ADDI(2, 0, 2),\n        ADDI(3, 2, 1),\n        ADDI(4, 3, 1),\n        ADDI(5, 4, 1),\n        ADDI(6, 5, 1),\n        SW(6, 0, 0x88),\n        ADDI(7, 6, 1),\n        EBREAK(),\n    ]\n    fetches, requests = [], []\n    rets, dmem = await _run(\n        dut, program, dmem_init={0x80: 42}, dmem_stalls={0x80: 6},\n        imem_stalls={28: 5}, imem_trace=fetches, dmem_trace=requests,\n    )\n    pcs = list(range(0, 4 * len(program), 4))\n    _assert_retirement_path(rets, pcs)\n    assert [r[\"insn\"] for r in rets] == program\n    assert all(r[\"trap\"] == 0 for r in rets)\n\n    # PCs 8 through 20 fill the queue. The bus holds at 24 through the\n    # first pop. The next edge pushes 24 into the vacated slot and pops 12.\n    # Then decode drains through 24 while the bus is stalled at 28.\n    expected_fetches = ([(pc, True) for pc in pcs[:6]] + [(24, True)] * 4 +\n                        [(28, False)] * 5 + [(28, True), (32, True)])\n    assert fetches[:len(expected_fetches)] == expected_fetches\n    assert [r[\"cycle\"] for r in rets] == [8, 9, 10, 11, 12, 13, 14, 17, 18]\n    assert [r[\"rd_wdata\"] for r in rets] =\n…[7623 of 10695 chars elided by tools/bench/transcript.py; sha256:2fdefd90b51c37f5]…\nut, program, imem_trace=fetches)\n    pcs = list(range(0, 4 * len(program), 4))\n    _assert_retirement_path(rets, pcs)\n    assert fetches[:len(pcs)] == [(pc, True) for pc in pcs]\n    trapped = [r for r in rets if r[\"trap\"]]\n    assert [r[\"pc\"] for r in trapped] == [4, 12, 20, 28, 32, 36]\n    assert all((r[\"rd\"], r[\"rd_wdata\"]) == (0, 0) for r in trapped)\n    assert (rets[2][\"rs1_rdata\"], rets[2][\"rd_wdata\"]) == (42, 43)\n    assert (rets[4][\"rs1_rdata\"], rets[4][\"rd_wdata\"]) == (42, 44)\n\n\n@cocotb.test()\nasync def folded_direction_training_and_read_before_write(dut):\n    # All branches fold to index zero. The comments give the counter\n    # following each branch's queued update.\n    program = {\n        0x000: BEQ(0, 0, 2),         # Trap, entry stays cold.\n        0x004: JAL(0, 0x100),\n        0x104: BEQ(0, 0, 0x104),     # Cold forward miss, initialize to 10.\n        0x208: BEQ(0, 0, 0x104),     # Simultaneous lookup sees cold, then train to 11.\n        0x30C: BEQ(0, 0, 0x10),      # Taken hit, saturate at 11.\n", "exit_code": 0, "status": "completed"}}
