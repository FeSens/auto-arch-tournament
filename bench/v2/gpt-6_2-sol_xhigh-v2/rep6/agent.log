{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-equality.K89Qaf\"\ncat > \"$scratch/prefix.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nscratch=Path(__file__).resolve().parent\n\nfor name in ('prefix','prefix_split','prefix_width'):\n dest=scratch/name/'rtl'\n shutil.copytree(scratch/'compact_mask'/'rtl',dest,dirs_exist_ok=True)\n p=dest/'ex_stage.sv'\n s=p.read_text()\n old='''  assign extension_equal =\n      (\"'!byte_load || other_operand[31:8] == {24{load_signed && other_operand[7]}})\n      && (!half_load || other_operand[31:16] == {16{load_signed && other_operand[15]}});'\"'''\n if name in ('prefix','prefix_width'):\n    new='''  logic byte_prefix, half_prefix;\n  assign byte_prefix = load_signed && other_operand[7]\n                     ? (&other_operand[31:8]) : \"'!(|other_operand[31:8]);\n  assign half_prefix = load_signed && other_operand[15]\n                     ? (&other_operand[31:16]) : !(|other_operand[31:16]);\n  assign extension_equal = word_load || (byte_load && byte_prefix) || (half_load && half_prefix);'\"'''\n else:\n    new='''  logic expected_sign;\n  logic top_zeros, top_ones, mid_zeros, mid_ones;\n  assign expected_sign = load_signed && (byte_load ? other_operand[7] : other_operand[15]);\n  assign top_zeros = \"'!(|other_operand[31:16]);\n  assign top_ones = (&other_operand[31:16]);\n  assign mid_zeros = !(|other_operand[15:8]);\n  assign mid_ones = (&other_operand[15:8]);\n  assign extension_equal = word_load\n      || (expected_sign ? (top_ones && (!byte_load || mid_ones))\n                        : (top_zeros && (!byte_load || mid_zeros)));'\"'''\n assert old in s\n s=s.replace(old,new)\n if name=='prefix_width':\n    s=s.replace(\\\"word_load = load_width == 2'd2\\\", \\\"word_load = load_width[1]\\\").replace(\\\"half_load = load_width == 2'd1\\\", \\\"half_load = load_width[0]\\\")\n p.write_text(s)\n\nfor name,src in [('queue_sources','champion'),('queue_source_decode','champion')]:\n dest=scratch/name/'rtl'\n shutil.copytree(Path.cwd()/'cores/bench/rtl',dest,dirs_exist_ok=True)\n p=dest/'if_stage.sv'\n s=p.read_text()\n old='  assign out.instr           = decode_packet.instr;'\n new='''  logic [9:0] next_queue_sources, head_sources_q;\n  logic [3:0] next_head_slot;\n  assign next_head_slot = {head_q[2:0], head_q[3]};\n\n  always_comb begin\n    next_queue_sources = '0;\n    for (int slot = 0; slot < 4; slot++)\n      next_queue_sources |= packets_q[slot][25:16] & {10{next_head_slot[slot]}};\n  end\n\n  always_ff @(posedge clock) begin\n    if (pop && \"'!occupancy_q[1])\n      head_sources_q <= next_queue_sources;\n    else if (push && (empty || (pop && occupancy_q[1])))\n      head_sources_q <= imem_data[24:15];\n  end\n\n  assign out.instr = {decode_packet.instr[31:25],\n                      empty ? imem_data[24:15] : head_sources_q,\n                      decode_packet.instr[14:0]};'\"'''\n assert old in s\n if name=='queue_sources':\n    p.write_text(s.replace(old,new))\n else:\n    p.write_text(s.replace(old,new[:new.rindex('  assign out.instr')] + '''  assign out.instr = decode_packet.instr;\n  assign out.rs_addrs = empty ? imem_data[24:15] : head_sources_q;'''))\n    p=dest/'core_pkg.sv'\n    s=p.read_text()\n    needle='    logic [31:0] instr;\\\\n    logic        predicted_taken;\\\\n    logic        valid;\\\\n  } if_id_t;'\n    assert needle in s\n    p.write_text(s.replace(needle,needle.replace('    logic [31:0] instr;','    logic [31:0] instr;\\\\n    logic [9:0] rs_addrs;')))\n    p=dest/'id_stage.sv'\n    s=p.read_text()\n    p.write_text(s.replace('assign rs1_addr = in.instr[19:15];','assign rs1_addr = in.rs_addrs[4:0];').replace('assign rs2_addr = in.instr[24:20];','assign rs2_addr = in.rs_addrs[9:5];'))\nPY\npython \\\"\"'$scratch/prefix.py\"\nPYTHONPATH=. python \"$scratch/timing_batch.py\" prefix prefix_split prefix_width queue_sources queue_source_decode'","aggregated_output":"","exit_