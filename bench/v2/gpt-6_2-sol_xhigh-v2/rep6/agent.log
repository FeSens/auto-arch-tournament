{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nrtl = Path(\\\"cores/bench/rtl\\\")\ndef edit(name, replacements):\n    path = rtl / name\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (name, old)\n        text = text.replace(old, new)\n    path.write_text(text)\nedit(\\\"if_stage.sv\\\", [\n    (\\\"  output logic [31:0]       imem_addr,\\\", \\\"\\\"\\\"  input  btb_update_t btb_update,\n  output logic [31:0]       imem_addr,\\\"\\\"\\\"),\n    (\\\"  // A redirect from advancing EX overrides a stalled sequential fetch.\\\", \\\"\\\"\\\"  logic [63:0] valid_q;\n  logic [11:0] tags [0:63];\n  logic [17:0] targets [0:63];\n  logic [1:0] counters [0:63];\n\n  wire [5:0] lookup_index = pc[7:2] \"'^ pc[13:8];\n  wire [5:0] update_index = btb_update.source_word[5:0]\n                          ''^ btb_update.source_word[11:6];\n  wire update_hit = valid_q[update_index]\n                    && tags[update_index] == btb_update.source_word[17:6];\n  wire lookup_hit = pc[31:20] == 12'\"'b0 && valid_q[lookup_index]\n                    && tags[lookup_index] == pc[19:8];\n  wire legal_control = (imem_data[6:0] == 7'h63 && imem_data[14:13] \"'!= 2'\"'b01)\n                       || imem_data[6:0] == 7'h6f\n                       || (imem_data[6:0] == 7'h67 && imem_data[14:12] == 3'b0);\n  wire predict_taken = lookup_hit && legal_control && counters[lookup_index][1];\n\n  logic [1:0] next_counter;\n  always_comb begin\n    next_counter = counters[update_index];\n    if (\"'!btb_update.conditional)\n      next_counter = 2'\"'b11;\n    else if (\"'!update_hit)\n      next_counter = 2'\"'b10;\n    else if (btb_update.taken && next_counter \"'!= 2'\"'b11)\n      next_counter = next_counter + 2'b01;\n    else if (\"'!btb_update.taken && next_counter != 2'\"'b00)\n      next_counter = next_counter - 2'b01;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      valid_q <= '0;\n    else if (btb_update.valid && btb_update.taken)\n      valid_q[update_index] <= 1'b1;\n\n    if (btb_update.valid && btb_update.taken) begin\n      tags[update_index]    <= btb_update.source_word[17:6];\n      targets[update_index] <= btb_update.target_word;\n    end\n    if (btb_update.valid && (btb_update.taken || update_hit))\n      counters[update_index] <= next_counter;\n  end\n\n  // A redirect from advancing EX overrides a stalled sequential fetch.\\\"\\\"\\\"),\n    (\\\"    else if (\"'!stall)   pc <= pc + 32'\"'d4;\\\", \\\"\\\"\\\"    else if (\"'!stall)   pc <= predict_taken ? {12'\"'b0, targets[lookup_index], 2'b0}\n                                          : pc + 32'd4;\\\"\\\"\\\")\n])\nedit(\\\"ex_stage.sv\\\", [\n    (\\\"  output logic               fast_write,\\\", \\\"\\\"\\\"  input  logic [31:0]        fetch_pc,\n  output btb_update_t        btb_update,\n  output logic               fast_write,\\\"\\\"\\\"),\n    (\\\"\\\"\\\"  assign redirect        = in.valid && \"'!stall && (branch_taken || in.ctrl.is_jump)\n                          && !misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\"\"\", \"\"\"  wire [31:0] transfer_target = in.ctrl.is_jalr ? jump_target : branch_target;\n  wire [31:0] fallthrough = in.pc + 32'\"'d4;\n  wire taken = \"'!misalign_fault && (branch_taken || in.ctrl.is_jump);\n  wire control_transfer = in.ctrl.is_branch || in.ctrl.is_jump;\n  wire advance_control = in.valid && !stall && control_transfer;\n  wire target_mismatch = fetch_pc != transfer_target;\n  wire fallthrough_mismatch = fetch_pc != fallthrough;\n\n  assign redirect = advance_control && (taken ? target_mismatch : fallthrough_mismatch);\n  assign redirect_target = taken ? transfer_target : fallthrough;\n\n  assign btb_update.valid = advance_control && !ctrl_with_trap.is_illegal\n                            && in.pc[31:20] == 12'\"'b0\n                  