eset) begin\n      train_q.valid <= 1'b0;\n      execute_q.valid <= 1'b0;\n      publish_q.valid <= 1'b0;\n    end\n\n    previous_q <= (trained_q[train_q.index]\n             && \"'!(execute_q.valid && execute_q.index == train_q.index)\n             && !(publish_q.valid && publish_q.index == train_q.index)) ? history[train_q.index] : '\"'0;\n\n    result_q <= updated;\n    store_prediction_q <= updated.trusted ?\n                          ((updated.run_length \"'!= updated.trip_length) ''^ execute_q.cold_taken) :\n                          updated.bimodal_override;\n\n    if (reset) begin\n      trained_q <= '\"'0;\n      override_next_q <= '0;\n    end else if (publish_q.valid) begin\n      trained_q[publish_q.index] <= 1'b1;\n      override_next_q[publish_q.index] <= store_prediction_q;\n      history[publish_q.index] <= result_q;\n    end\n  end\n\n  assign direction_disagrees = execute_q.taken \"'^ execute_q.cold_taken;\n  assign count_match = (previous_q.run_length == previous_q.trip_length)\n                    && previous_q.trip_length >= 6'\"'d3 && previous_q.trip_length \"'!= 6'\"'d63;\n\n  always_comb begin\n    updated.run_length = \"'!execute_q.taken ? 6'\"'d0 : (&previous_q.run_length) ?\n                         previous_q.run_length : previous_q.run_length + 6'd1;\n    updated.trip_length = execute_q.taken ? previous_q.trip_length : previous_q.run_length;\n    updated.trusted = execute_q.taken ?\n                      previous_q.trusted && previous_q.run_length < previous_q.trip_length :\n                      count_match;\n    updated.bimodal_override = previous_q.strong ? previous_q.bimodal_override : direction_disagrees;\n    updated.strong = previous_q.bimodal_override == direction_disagrees;\n  end\n\n'''+c[end:]\n    p.write_text(c)\nPY\npython3 \\\"\"'$scratch_dir/full_pipe.py\" \"$scratch_dir\"\nfor variant in loop_predict_64_full loop_predict_256_full loop_bank_64_late_full loop_bank_128_full; do\n  RTL_DIR=\"$scratch_dir/$variant\" OBJ_DIR=