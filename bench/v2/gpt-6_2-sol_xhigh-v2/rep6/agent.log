_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[5940 of 9012 chars elided by tools/bench/transcript.py; sha256:9ac074ef0aba6c34]…\ng.sv\n    63\t    description: \"Define the resolved packet and trace replay payload.\"\n    64\t  - file: rtl/mem_stage.sv\n    65\t    description: \"Register one training packet per completed MEM instruction with the actual successor and deferred branch direction.\"\n    66\t  - file: rtl/ex_stage.sv\n    67\t    description: \"Request fall-through refetch for an advancing FENCE.I while retaining ordinary EX and older MEM recovery priority.\"\n    68\t  - file: rtl/core.sv\n    69\t    description: \"Connect the registered training stream and fence invalidation to fetch.\"\n    70\t  - file: rtl/if_stage.sv\n    71\t    description: \"Admit and enqueue resident traces with staged prediction bits, and restart the queue from registered correction selection.\"\n    72\t  - file: test/test_pipeline.py\n    73\t    description: \"Verify trace admission and bank replacement, deferred-branch side exits, simultaneous EX and MEM corrections, correction retry, and FENCE.I refetch. Check exact memory transactions and continuous RVFI order and PCs.\"\n", "exit_code": 0, "status": "completed"}}
