{"type":"item.started","item":{"id":"item_116","type":"command_execution","command":"/bin/bash -c 'root=\"$TMPDIR/bench-r7s2-squash.n2fudQ/two\"\npython - \"$root\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\npath = Path(sys.argv[1]) / 'cores/bench/test/test_pipeline.py'\ns = path.read_text()\nstart = s.index('    expected_fetches = (', s.index('async def direction_misses_retry_under_backpressure'))\nend = s.index('@cocotb.test()\\\\nasync def reserved_and_misaligned', start)\ns = s[:start] + '''    if stall_data and not stall_fetch:\n        before_target = [(12, True), (16, True), (20, True), (20, True)]\n    else:\n        before_target = [(12, not stall_fetch)] * (store_stalls + 1)\n    if stall_data:\n        before_fallthrough = [(12, True), (16, True)] + [(20, True)] * (load_stalls - 1)\n    else:\n        before_fallthrough = [(12, True)]\n    expected_fetches = (\n        [(0, True), (4, True), (8, True)] + before_target +\n        [(16, False)] * target_stalls + [(16, True), (20, True)] + before_fallthrough +\n        [(24, False)] * fallthrough_stalls + [(24, True), (28, True)]\n    )\n    assert fetches[:len(expected_fetches)] == expected_fetches\n\n\n@cocotb.test()\nasync def predictor_runs_ahead_and_queued_path_drains_during_imem_stall(dut):\n    program = [\n        SW(0, 0, 0x80),\n        JAL(5, 8),\n        SW(0, 0, 0x90),\n        ADDI(6, 5, 1),\n        ADDI(7, 6, 1),\n        EBREAK(),\n    ]\n    fetches, requests = [], []\n    rets, dmem = await _run(\n        dut, program, dmem_stalls={0x80: 5}, imem_stalls={20: 8},\n        imem_trace=fetches, dmem_trace=requests,\n    )\n    _assert_retirement_path(rets, [0, 4, 12, 16, 20])\n    assert (rets[1][\\\"rd_wdata\\\"], rets[2][\\\"rd_wdata\\\"], rets[3][\\\"rd_wdata\\\"]) == (8, 9, 10)\n    assert rets[2][\\\"cycle\\\"] == rets[1][\\\"cycle\\\"] + 1\n    assert rets[3][\\\"cycle\\\"] == rets[2][\\\"cycle\\\"] + 1\n    assert fetches[:12] == [(0, True), (4, True), (12, True), (16, True)] + [(20, False)] * 8\n    assert requests == [(0x80, 0, 0xF, 0, False)] * 5 + [(0x80, 0, 0xF, 0, True)]\n    assert dmem == {0x80: 0}\n\n\n''' + s[end:]\npath.write_text(s)\nPY\ncd \\\"\"'$root/cores/bench\"\npytest -q -s test/ --disable-warnings > \"$root/cocotb.log\" 2>&1\nstatus=\"$?\"\nrg -n '\"'TESTS=|AssertionError|passed in|failed in|FAILED ' \\\"\"'$root/cocotb.log\" | tail -26\nexit \"$status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
