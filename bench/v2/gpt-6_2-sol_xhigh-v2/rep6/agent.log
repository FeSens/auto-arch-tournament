{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"cat > '/srv/hwebench/tmp/86dd60e1/f56da8f4/bench-profile.o5QOsB/profile.py' <<'PY'\nimport collections, gzip, json, sys\nstats = collections.Counter()\ndep = collections.Counter()\ndelta = collections.Counter()\nprev = None\ninside = False\nfor line in gzip.open(sys.argv[1], 'rt'):\n    r = json.loads(line)\n    if r['mem_addr'] == 0x10000100 and r['mem_wmask']:\n        inside = True\n        continue\n    if r['mem_addr'] == 0x10000104 and r['mem_wmask']:\n        break\n    if not inside:\n        continue\n    i = r['insn']\n    op, f3, f7 = i & 127, i >> 12 & 7, i >> 25\n    stats['retired'] += 1\n    stats[f'op {op:x}'] += 1\n    stats[f'memory {(bool(r[\\\"mem_rmask\\\"]), bool(r[\\\"mem_wmask\\\"]))}'] += 1\n    if prev:\n        distance = r['cycle'] - prev['cycle']\n        delta[(prev['insn'] & 127, op)] += distance - 1\n    if prev and prev['rd_addr'] and prev['insn'] & 127 in (3,51) and (prev['insn'] & 127 == 3 or prev['insn'] >> 25 == 1):\n        producer = 'load' if prev['insn'] & 127 == 3 else 'M'\n        d1 = prev['rd_addr'] == r['rs1_addr']\n        d2 = prev['rd_addr'] == r['rs2_addr']\n        if d1 or d2:\n            real1 = d1 and op in (3,19,35,51,99,103)\n            real2 = d2 and op in (35,51,99)\n            dep[(producer, 'true' if real1 or real2 else 'false', op, f3, f7 if op==51 else '', real1, real2)] += 1\n    prev = r\nprint(stats)\nprint('Excess cycles', delta.most_common(30))\nprint('Total deps',sum(dep.values()))\nfor k,v in dep.most_common():\n    if v > 100:\n        print(k,v)\nPY\npython '/srv/hwebench/tmp/86dd60e1/f56da8f4/bench-profile.o5QOsB/profile.py' '/srv/hwebench/tmp/86dd60e1/f56da8f4/bench-profile.o5QOsB/trace.jsonl.gz'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
