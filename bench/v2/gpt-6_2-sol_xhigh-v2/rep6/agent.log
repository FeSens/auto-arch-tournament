{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,250p' cores/bench/test/test_div_unit.py && sed -n '1,230p' Makefile\"", "aggregated_output": "\"\"\"Arithmetic and handshake tests for the clocked RV32M divider.\"\"\"\n\nimport random\nfrom itertools import product\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\ndef _expected(op, a, b):\n    remainder = op in (ALU_REM, ALU_REMU)\n    if b == 0:\n        return a if remainder else MASK32\n    if op in (ALU_DIV, ALU_REM):\n        if a & (1 << 31):\n            a -= 1 << 32\n        if b & (1 << 31):\n            b -= 1 << 32\n    quotient = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        quotient = -quotient\n    return (a - quotient * b if remainder else quotient) & MASK32\n\n\nasync def _tick(dut):\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _setup(dut):\n    dut.reset.value = 1\n    dut.request_valid.value = 0\n    dut.result_ready.value = 1\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _tick(dut)\n    dut.reset.value = 0\n\n\nasync def _start(dut, op, a, b):\n    assert dut.request_ready.value and not dut.result_valid.value\n    dut.op.value = op\n    dut.a.value = a\n    dut.b.value = b\n    dut.request_valid.value = 1\n    await _tick(dut)\n    dut.request_valid.value = 0\n    # Change the input bus immediately after acceptance.\n    dut.op.value = ALU_REMU if op != ALU_REMU else ALU_DIV\n    dut.a.value = a ^ MASK32\n    dut.b.value = b ^ MASK32\n\n\nasync def _finish(dut, op, a, b):\n    for _ in range(7):\n        assert not dut.request_ready.value and not dut.result_valid.value\n        await _tick(dut)\n    # The eighth update is available for transfer on the next edge.\n    _check_result(dut, op, a, b)\n\n\ndef _check_result(dut,