ax_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        ren       = int(dut.io_dmemREn.value)\n \n…[2904 of 5976 chars elided by tools/bench/transcript.py; sha256:8137ea3581096180]…\ntb.test()\nasync def redirect_and_fetch_stall_squash_side_effects(dut):\n    program = [\n        JAL(0, 8),\n        SW(0, 0, 0x80),  # Wrong-path store on the stalled sequential fetch.\n        DIVU(1, 0, 0),\n        SW(1, 0, 0x84),\n        EBREAK(),\n    ]\n    requests = []\n    rets, _ = await _run(dut, program, imem_stalls={4: 3, 8: 2, 12: 11},\n                         dmem_trace=requests)\n    assert [r[\"pc\"] for r in rets] == [0, 8, 12, 16]\n    assert [r[\"order\"] for r in rets] == list(range(4))\n    assert requests == [(0x84, 0, 0xF, 0xFFFFFFFF, True)]\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"mul_reduce.sv\", \"div_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
