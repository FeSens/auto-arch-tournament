{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c \"sed -n '1,215p' cores/bench/test/test_replay_table.py; rg -n 'replay_hit|replay_packet|even_rows|odd_rows|u_replay|pc_word_q|lookup_index_q' cores/bench/test/test_pipeline.py | head -40\"","aggregated_output":"\"\"\"Synchronous replay bank checks at the read/write edge.\"\"\"\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _update(pc, instr):\n    # valid, word-PC tag, instruction [31:2], then 12 successor bits.\n    return (1 << 72) | ((pc >> 2) << 42) | ((instr >> 2) << 12)\n\n\n@cocotb.test()\nasync def masks_row_collisions_and_preserves_other_bank(dut):\n    odd, even = 0x0FFC, 0x1000\n    odd_alias, even_alias = odd + 0x1000, even + 0x1000\n    odd_instr, even_instr, replacement = 0x00100093, 0x00200113, 0x00300193\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    async def edge(pc, update=0, reset=False, invalidate=False):\n        dut.normal_pc.value = pc >> 2\n        dut.update.value = update\n        dut.reset.value = reset\n        dut.invalidate.value = invalidate\n        await Timer(1, \"ns\")\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n    async def check(pc, instr=None):\n        dut.normal_pc.value = pc >> 2\n        await Timer(1, \"ns\")\n        assert bool(dut.hit.value) == (instr is not None)\n        if instr is not None:\n            assert int(dut.packet.value) >> 12 == instr >> 2\n\n    await edge(odd, _update(odd, odd_instr), reset=True)\n    await edge(odd)\n    await check(odd)\n\n    await edge(odd, _update(odd, odd_instr))\n    await edge(odd, _update(even, even_instr))\n    await edge(odd)\n    # The addresses span a page boundary and wrap the even bank's index.\n    await check(odd, odd_instr)\n    await check(even, even_instr)\n\n    await edge(odd, _update(even_alias, replacement))\n    await check(odd, odd_instr)\n    await check(even)\n    await check(even_alias)\n    await edge(odd)\n    await check(even)\n    await check(even_alias, replacement)\n\n    await edge(odd, _update(odd_alias, replacement))\n    await check(odd)\n    await check(odd_alias)\n    await check(even_alias, replacement)\n    await edge(odd)\n    await check(odd)\n    await check(odd_alias, replacement)\n\n    await edge(odd, _update(odd, odd_instr), invalidate=True)\n    await check(odd_alias)\n    await check(even_alias)\n    await edge(odd)\n    await check(odd)\n    await check(odd_alias)\n    await check(even_alias)\n\n\ndef test_replay_table_runner():\n    run_cocotb(\n        toplevel=\"replay_table\",\n        sources=[\"core_pkg.sv\", \"replay_table.sv\"],\n        test_module=\"test_replay_table\",\n    )\n1228:        if not int(dut.correction_q.value) and int(fetch.replay_hit.value):\n1233:        if ready and int(fetch.replay_hit.value) and not int(dut.correction_q.value):\n1290:    replay = dut.u_if.u_replay\n1338:        update = int(dut.u_if.u_replay.update.value)\n1348:    assert int(dut.u_if.u_replay.update.value) >> 72 == 0  # EBREAK completes in MEM.\n1374:    replay = dut.u_if.u_replay\n","exit_code":0,"status":"completed"}}
