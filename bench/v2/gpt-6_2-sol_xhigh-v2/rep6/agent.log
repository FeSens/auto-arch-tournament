m build\", build)\n    return (True, \"\")\n\ndef _read_notes(worktree: str) -> str:\n    p = Path(worktree) / \"implementation_notes.md\"\n    return p.read_text() if p.exists() else \"\"\n\ndef run_report():\n    log = read_log()\n    if not log:\n        print(\"No experiments yet.\")\n        return\n    improvements = [e for e in log if e.get('outcome') == 'improvement']\n    broken       = [e for e in log if e.get('outcome'\n…[7425 of 10497 chars elided by tools/bench/transcript.py; sha256:35bd916172d5e0cb]…\npu/u_ex/u_div/g_subtract[11].difference_26_s/CIN   \n  8.280    0.035   tINS   FF   1        R24C39[1][A]   cpu/u_ex/u_div/g_subtract[11].difference_26_s/COUT  \n  8.280    0.000   tNET   FF   2        R24C39[1][B]   cpu/u_ex/u_div/g_subtract[11].difference_27_s/CIN   \n  8.315    0.035   tINS   FF   1        R24C39[1][B]   cpu/u_ex/u_div/g_subtract[11].difference_27_s/COUT  \n  8.315    0.000   tNET   FF   2        R24C39[2][A]   cpu/u_ex/u_div/g_subtract[11].difference_28_s/CIN   \n  8.350    0.035   tINS   FF   1        R24C39[2][A]   cpu/u_ex/u_div/g_subtract[11].difference_28_s/COUT  \n  8.350    0.000   tNET   FF   2        R24C39[2][B]   cpu/u_ex/u_div/g_subtract[11].difference_29_s/CIN   \n  8.385    0.035   tINS   FF   1        R24C39[2][B]   cpu/u_ex/u_div/g_subtract[11].difference_29_s/COUT  \n  8.385    0.000   tNET   FF   2        R24C40[0][A]   cpu/u_ex/u_div/g_subtract[11].difference_30_s/CIN   \n  8.420    0.035   tINS   FF   1        R24C40[0][A]   cpu/u_ex/u_div/g_subtract[11].difference_30_s/COUT  \n", "exit_code": 0, "status": "completed"}}
