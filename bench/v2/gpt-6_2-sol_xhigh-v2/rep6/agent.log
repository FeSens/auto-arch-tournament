{"type": "item.completed", "item": {"id": "item_138", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/rtl/replay_table.sv'", "aggregated_output": "// Prime synchronous instruction reads for hold, fall-through, and a\n// predicted target. Successor metadata is read in parallel with the rows.\nmodule replay_table (\n  input  logic           clock,\n  input  logic           reset,\n  input  logic           invalidate,\n  input  replay_update_t update,\n  input  logic [31:2]    normal_pc,\n  input  logic           prefer_target,\n  output logic           hit,\n  output logic [31:2]    instr,\n  output replay_successor_t successor\n);\n\n  replay_row_t even_read_q, odd_read_q, target_read_q;\n  localparam integer ROW_WIDTH = $bits(even_read_q);\n  localparam integer SUCCESSOR_WIDTH = $bits(successor);\n  (* syn_ramstyle = \"block_ram\" *)       logic [ROW_WIDTH-1:0] even_rows [0:255];\n  (* syn_ramstyle = \"block_ram\" *)       logic [ROW_WIDTH-1:0] odd_rows [0:255];\n  (* syn_ramstyle = \"block_ram\" *)       logic [ROW_WIDTH-1:0] target_rows [0:511];\n  (* syn_ramstyle = \"distributed_ram\" *) logic [SUCCESSOR_WIDTH-1:0] successors [0:511];\n  logic [255:0] even_valid_q, odd_valid_q;\n  logic even_available_q, odd_available_q, target_collision_q;\n  logic [10:2] target_slot, write_slot;\n  logic [10:2] target_slot_q;\n  logic [7:0] even_index, odd_index, write_index;\n  logic clear, write_slot_en, write_even, write_odd;\n  logic even_row_valid, odd_row_valid, slot_valid;\n  logic select_even, select_odd;\n  logic static_taken;\n\n  // The odd word is in the current pair. The even word is in the next\n  // pair only when the current PC is odd. These inputs use only flops.\n  assign odd_index  = normal_pc[10:3];\n  assign even_index = normal_pc[10:3] + {7'b0, normal_pc[2]};\n  assign successor = successors[normal_pc[10:2]];\n  // This read can be speculative even when the source slot is invalid.\n  // Its returned tag is checked against the PC that