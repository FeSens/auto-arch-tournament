rue,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL\n…[7631 of 10703 chars elided by tools/bench/transcript.py; sha256:3c9d46db94a83708]…\n in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n            await _start(dut, op, a, b)\n            await _finish(dut, op, a, b)\n            await _tick(dut)\n    assert dut.request_ready.value and not dut.result_valid.value\n\n\n@cocotb.test()\nasync def every_leading_nibble(dut):\n    await _setup(dut)\n    # Cover the narrow restoring steps and the bypass at divisors 16 and 17.\n    for nibble, b in product(range(16), range(18)):\n        a = (nibble << 28) | 0x0ABCDEF0\n        for op in (ALU_DIVU, ALU_REMU):\n            await _start(dut, op, a, b)\n            await _finish(dut, op, a, b)\n            await _tick(dut)\n\n\n@cocotb.test()\nasync def radix16_digit_boundaries(dut):\n    await _setup(dut)\n    divisors = [17, 0x12345, 0x11111111, 0x11111112, 0x3FFFFFFF,\n                0x40000000, 0x55555556, 0x80000000, 0x80000001, MASK32]\n    for b, k in product(divisors, range(1, 17)):\n        # For widened multiples, probe the wrapped low word. A candidate\n        # with upper bits set must fail even when those low bits fit.\n", "exit_code": 0, "status": "completed"}}
