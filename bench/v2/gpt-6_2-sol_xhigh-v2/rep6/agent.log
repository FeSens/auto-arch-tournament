{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r8s1-width/make_neg_div.py\" <<'\"'PY'\nfrom pathlib import Path\nimport subprocess,sys\nsrc,dst = map(Path,sys.argv[1:3])\ngroups=int(sys.argv[3])\nmethod=int(sys.argv[4]) if len(sys.argv)>4 else 0\nsubprocess.run([sys.executable,str(Path(__file__).with_name('make_bank_div.py')),str(src),str(dst),str(groups)],check=True)\np=dst/'div_unit.sv'\ns=p.read_text()\ns=s.replace('  logic [31:0] divisor_q;','''  logic [35:0] negative_divisor_q;\n  logic [3:0] divisor_nibble_q;\n  logic divisor_fits_nibble_q, divisor_zero_q;''')\ns=s.replace('  logic [31:0] dividend, divisor;', '  logic [31:0] dividend;\\\\n  logic [35:0] negative_divisor;')\ns=s.replace('  assign divisor        = b_negative ? -b : b;', '''  assign negative_divisor = b_negative ? {{4{1'b1}}, b} : -{4'b0, b};''')\ns=s.replace(\\\"  assign {leading_digit, leading_remainder} = (|divisor_q[31:4])\\\\n      ? {4'b0, quotient_q[31:28]} : divide_nibble(quotient_q[31:28], divisor_q[3:0]);\\\", \\\"\\\"\\\"  assign {leading_digit, leading_remainder} = \"'!divisor_fits_nibble_q\n      ? {4'\"'b0, quotient_q[31:28]} : divide_nibble(quotient_q[31:28], divisor_nibble_q);\\\"\\\"\\\")\ns=s.replace(\\\"assign divisor_once  = {4'b0, divisor_q};\\\", 'assign divisor_once  = negative_divisor_q;')\ns=s.replace('assign difference = {1\\\\'b0, trial} - {1\\\\'b0, multiple[31:0]};\\\\n    assign fits[k] = \"'!difference[32] && !(|multiple[35:32]);'\"',\\\"assign difference = {1'b0, trial} + {1'b0, multiple[31:0]};\\\\n    assign fits[k] = (difference[32] && (&multiple[35:32])) || divisor_zero_q;\\\")\ns=s.replace('      divisor_q        <= divisor;', '''      negative_divisor_q <= negative_divisor;\n      divisor_nibble_q <= b_negative ? -b[3:0] : b[3:0];\n      divisor_fits_nibble_q <= b_negative ? (&b[31:4]) && (|b[3:0]) : \"'!(|b[31:4]);\n      divisor_zero_q   <= (b == 32'\"'b0);''')\ns=s.replace('  