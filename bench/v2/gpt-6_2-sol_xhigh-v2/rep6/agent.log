{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\n\nmask = (1 << 32) - 1\nedges = [0, 1, 2, 3, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, 0xffffffff]\nrng = random.Random(20261122)\npairs = [(a, b) for a in edges for b in edges]\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\npairs += [(rng.getrandbits(32), rng.randrange(1024)) for _ in range(10000)]\n\ndef i32(x):\n    return x if x < (1 << 31) else x - (1 << 32)\n\nfor signed in (False, True):\n    for original_a, original_b in pairs:\n        a, b = (i32(original_a), i32(original_b)) if signed else (original_a, original_b)\n        dividend, divisor = abs(a), abs(b)\n        r = q = 0\n        for group in reversed(range(6)):\n            for step in reversed(range(6)):\n                r = (r << 1) | ((dividend >> (group * 6 + step)) & 1)\n                take = r >= divisor\n                r -= divisor * take\n                q = (q << 1) | take\n                if divisor:\n                    assert 0 <= r < divisor\n        if not divisor:\n            quotient, remainder = mask, original_a\n            expected_q, expected_r = mask, original_a\n        else:\n            quotient = -q if (a < 0) \"'!= (b < 0) else q\n            remainder = -r if a < 0 else r\n            # Use Python floor division followed by a correction to truncate\n            # toward zero for a nonintegral negative quotient.\n            expected_q, floor_rem = divmod(a, b)\n            expected_q += (a < 0) != (b < 0) and floor_rem != 0\n            expected_r = a - b * expected_q\n        assert ((quotient & mask), (remainder & mask)) == (\n            (expected_q & mask), (expected_r & mask)\n        ), (original_a, original_b, signed)\nprint(f'\"'{len(pairs) * 2:,} signed/unsigned operand pairs passed quotient and remainder reference checks')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
