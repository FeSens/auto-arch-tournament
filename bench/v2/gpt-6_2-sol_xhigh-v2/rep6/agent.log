{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'trial=\"$TMPDIR/r11s2-profile/trial\"\nmkdir -p \"$trial/cores/bench/rtl\"\ncp cores/bench/rtl/*.sv \"$trial/cores/bench/rtl/\"\ncp cores/bench/core.yaml \"$trial/cores/bench/\"\nln -s \"$PWD/fpga\" \"$trial/fpga\"\ncat > \"$trial/cores/bench/rtl/loop_trace.sv\" <<'\"'EOF'\nmodule loop_trace (\n  input logic clock, reset, invalidate,\n  input trace_train_t train,\n  input logic [31:2] fetch_pc,\n  input logic allow_replay,\n  input logic space,\n  output logic replay,\n  output trace_packet_t packet\n);\n\n  // Each resident bank has a separately registered head.\n  logic [31:2] bank_head [0:1];\n  logic [9:0] bank_tail [0:1];\n  logic [3:0] bank_end [0:1];\n  logic [1:0] bank_ready;\n  logic last_bank, active, active_bank;\n  logic [3:0] cursor;\n  logic [1:0] admit;\n  logic chosen;\n  trace_packet_t heads [0:1];\n  trace_packet_t ahead [0:1];\n  trace_packet_t bank [0:1][0:15];\n\n  assign admit[0] = bank_ready[0] && fetch_pc == bank_head[0];\n  assign admit[1] = bank_ready[1] && fetch_pc == bank_head[1];\n  assign chosen = active ? active_bank : \"'!admit[0];\n  assign replay = allow_replay && (active || (|admit));\n  assign packet = active ? ahead[active_bank] : heads[chosen];\n\n  always_ff @(posedge clock) begin\n    if (reset || invalidate || !allow_replay) begin\n      active <= 0;\n      cursor <= 1;\n    end else if (replay && space) begin\n      active <= 1;\n      active_bank <= chosen;\n      cursor <= !active ? 1 : cursor == bank_end[active_bank] ? 4'\"'d0 : cursor + 4'd1;\n    end\n    if (reset) last_bank <= 0;\n    else if (replay && space) last_bank <= chosen;\n  end\n\n  // The idle bank constantly preloads its second packet.\n  for (genvar w = 0; w < 2; w++) begin : g_ahead\n    logic selected;\n    logic [3:0] address;\n    assign selected = active && active_bank == 1'(w);\n    assign address = \"'!selected ? 4'\"'d1 : cursor == bank_end[w] ? 4'd0 : cursor + 4'd1;\n    always_ff @(posedge clock) begin\n      if (\"'!selected || space) ahead[w] <= bank[w][address];\n    end\n  end\n\n  trace_packet_t history [0:15];\n  logic [9:0] history_word [0:15];\n  logic [15:0] occupied;\n  logic [19:0] page_q;\n  logic [31:2] expected_pc;\n  logic [3:0] write_ptr;\n  logic same_segment, closing;\n  logic [15:0] found, match_q;\n  logic pending;\n  logic [3:0] tail_slot_q;\n  logic [9:0] target_q, tail_word_q;\n  logic [19:0] closing_page_q;\n\n  assign same_segment = train.pc == expected_pc && train.pc[31:12] == page_q;\n  assign closing = train.valid && train.eligible && train.closes\n                && same_segment && train.npc[31:12] == train.pc[31:12];\n  for (genvar j = 0; j < 16; j++) begin : g_match\n    assign found[j] = occupied[j] && write_ptr != 4'\"'(j)\n                   && history_word[j] == train.npc[11:2];\n  end\n  logic [3:0] match_slot;\n  logic [3:0] matched_above, matched_below;\n  logic has_below;\n  always_comb begin\n    matched_above = 0;\n    matched_below = 0;\n    has_below = 0;\n    for (int j = 0; j < 16; j++) begin\n      if (match_q[j]) begin\n        matched_above = 4'(j);\n        if (4'(j) < tail_slot_q) begin\n          matched_below = 4'(j);\n          has_below = 1;\n        end\n      end\n    end\n  end\n  assign match_slot = has_below ? matched_below : matched_above;\n\n  logic [19:0] prior_page [0:15];\n  logic [9:0] prior_head [0:15], prior_tail [0:15];\n  logic [3:0] prior_end [0:15];\n  logic [15:0] prior_valid;\n  logic [3:0] hash, distance;\n  logic [31:2] candidate;\n  logic repeated, resident, victim, same_head0, same_head1, begin_copy;\n  assign candidate = {closing_page_q, target_q};\n  assign distance = tail_slot_q - match_slot;\n  assign hash = target_q[3:0] \"'^ target_q[7:4];\n  assign repeated = prior_valid[hash] && prior_page[hash] == closing_page_q\n                  && prior_head[hash] == target_q && prior_tail[hash] == tail_word_q\n                  && prior_end[hash] == distance;\n  assign same_head0 = bank_ready[0] && bank_head[0] == candidate;\n  assign same_head1 = bank_ready[1] && bank_head[1] == candidate;\n  assign resident = (same_head0 && bank_tail[0] == tail_word_q && bank_end[0] == distance)\n                 || (same_head1 && bank_tail[1] == tail_word_q && bank_end[1] == distance);\n  assign victim = replay ? !chosen : same_head0 ? 0 : same_head1 ? 1\n                : !bank_ready[0] ? 0 : !bank_ready[1] ? 1 : !last_bank;\n\n  logic copy_read, copy_write, copy_bank;\n  logic [3:0] src_q, dst_read_q, dst_write_q;\n  trace_packet_t transfer_q;\n  assign begin_copy = pending && (|match_q) && repeated && !resident && !copy_read && !copy_write\n                  && !(replay && bank_head[chosen] == candidate && bank_ready[chosen]);\n\n  always_ff @(posedge clock) begin\n    if (reset || invalidate) begin\n      occupied <= 0;\n      write_ptr <= 0;\n      pending <= 0;\n      prior_valid <= 0;\n      bank_ready <= 0;\n      copy_read <= 0;\n      copy_write <= 0;\n    end else begin\n      pending <= closing && !begin_copy && !copy_read && !copy_write;\n      if (closing) begin\n        match_q <= found;\n        target_q <= train.npc[11:2];\n        tail_word_q <= train.pc[11:2];\n        tail_slot_q <= write_ptr;\n        closing_page_q <= train.pc[31:12];\n      end\n      if (pending && (|match_q)) begin\n        prior_valid[hash] <= 1;\n        prior_page[hash] <= closing_page_q;\n        prior_head[hash] <= target_q;\n        prior_tail[hash] <= tail_word_q;\n        prior_end[hash] <= distance;\n      end\n\n      if (begin_copy) begin\n        bank_ready[victim] <= 0;\n        bank_head[victim] <= candidate;\n        bank_tail[victim] <= tail_word_q;\n        bank_end[victim] <= distance;\n        copy_bank <= victim;\n        copy_read <= 1;\n        src_q <= match_slot;\n        dst_read_q <= 0;\n        occupied <= 0;\n        write_ptr <= 0;\n      end else if (!copy_read && !copy_write && train.valid) begin\n        if (train.eligible) begin\n          page_q <= train.pc[31:12];\n          expected_pc <= train.npc;\n          occupied <= same_segment ? occupied | (16'\"'b1 << write_ptr) : 16'b1 << write_ptr;\n          history[write_ptr] <= train.packet;\n          history_word[write_ptr] <= train.pc[11:2];\n          write_ptr <= write_ptr + 4'd1;\n        end else begin\n          occupied <= 0;\n          write_ptr <= 0;\n        end\n      end\n\n      copy_write <= copy_read;\n      if (copy_read) begin\n        transfer_q <= history[src_q];\n        dst_write_q <= dst_read_q;\n        dst_read_q <= dst_read_q + 4'd1;\n        src_q <= src_q + 4'd1;\n        if (dst_read_q == bank_end[copy_bank]) copy_read <= 0;\n      end\n      if (copy_write) begin\n        if (dst_write_q == 0) heads[copy_bank] <= transfer_q;\n        if (dst_write_q == bank_end[copy_bank]) bank_ready[copy_bank] <= 1;\n      end\n    end\n  end\n\n  for (genvar w = 0; w < 2; w++) begin : g_bank_write\n    always_ff @(posedge clock) begin\n      if (copy_write && copy_bank == 1'(w)) bank[w][dst_write_q] <= transfer_q;\n    end\n  end\nendmodule\nEOF\npython3 - \\\"\"'$trial/cores/bench/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\ndef edit(name, changes):\n    p = rtl/name\n    s=p.read_text()\n    for old,new in changes:\n        assert s.count(old)==1,(name,old,s.count(old))\n        s=s.replace(old,new)\n    p.write_text(s)\nedit('core_pkg.sv', [('  typedef struct packed {\\\\n    logic       valid;\\\\n    logic [5:0] index;', '''  typedef struct packed {\n    logic [9:0] word_pc;\n    logic [31:0] instr;\n    logic taken;\n  } trace_packet_t;\n\n  typedef struct packed {\n    logic valid;\n    logic eligible;\n    logic closes;\n    logic [31:2] pc;\n    logic [31:2] npc;\n    trace_packet_t packet;\n  } trace_train_t;\n\n  typedef struct packed {\n    logic       valid;\n    logic [5:0] index;''')])\nedit('core.sv', [\n    ('  predictor_update_t predictor_update;', '  predictor_update_t predictor_update;\\\\n  trace_train_t trace_train;\\\\n  logic fence_restart;'),\n    ('    .predictor_update     (predictor_update),', '    .predictor_update     (predictor_update),\\\\n    .trace_train          (trace_train),\\\\n    .fence_restart        (fence_restart),'),\n    ('    .recovery_pc          (ex_recovery_pc)', '    .fence_restart       (fence_restart),\\\\n    .recovery_pc          (ex_recovery_pc)'),\n    ('    .predictor_update (predictor_update),', '    .predictor_update (predictor_update),\\\\n    .trace_train  (trace_train),')])\nedit('ex_stage.sv', [\n    ('  output logic               redirect,','  output logic               redirect,\\\\n  output logic               fence_restart,'),\n    ('assign recovery_pc = ({30{in.predicted_taken}}', 'assign recovery_pc = ({30{in.predicted_taken || fence_restart}}'),\n    ('{30{in.recover_direct}}','{30{in.recover_direct && \"'!fence_restart}}'\"'),\n    ('  assign redirect = in.valid && \"'!stall && (branch_miss || jump_miss);'\"', '''  assign fence_restart = in.valid && \"'!stall && !squash\n                      && in.instr[6:0] == 7'\"'h0f && in.instr[14:12] == 3'b001;\n  assign redirect = (in.valid && \"'!stall && (branch_miss || jump_miss)) || fence_restart;'\"''')])\nedit('mem_stage.sv', [\n    ('  output predictor_update_t predictor_update,','  output predictor_update_t predictor_update,\\\\n  output trace_train_t trace_train,'),\n    ('  // ── MEM/WB register', '''  logic [31:2] trace_next;\n  assign trace_next = deferred_branch ? (branch_taken ? late_branch.target : late_branch.fallthrough)\n                                      : in.pc_next[31:2];\n  always_ff @(posedge clock) begin\n    if (reset) trace_train.valid <= 0;\n    else trace_train.valid <= in.valid && \"'!hold_wb;\n    trace_train.eligible <= !in.ctrl.is_illegal && !mem_misalign && !in.ctrl.is_jalr\n                         && in.instr[6:0] != 7'\"'h73 && in.instr[6:0] \"'!= 7'\"'h0f\n                         && in.pc[31:12] == trace_next[31:12];\n    trace_train.closes <= in.ctrl.is_branch && branch_taken && in.instr[31];\n    trace_train.pc <= in.pc[31:2];\n    trace_train.npc <= trace_next;\n    trace_train.packet <= {in.pc[11:2], in.instr, (in.ctrl.is_branch && branch_taken) || (in.ctrl.is_jump && \"'!in.ctrl.is_jalr)};\n  end\n\n  // ── MEM/WB register'\"''')])\nedit('if_stage.sv', [\n    ('  input  predictor_update_t predictor_update,','  input  predictor_update_t predictor_update,\\\\n  input  trace_train_t      trace_train,\\\\n  input  logic              fence_restart,'),\n    ('  typedef struct packed {\\\\n    logic [31:0] pc;', '''  logic replay, retry_q, invalidate_q;\n  trace_packet_t trace_packet;\n  logic [19:0] replay_page;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      retry_q <= 0;\n      invalidate_q <= 0;\n    end else begin\n      retry_q <= (\"'!select_normal_q || retry_q) && !fetch_advance;\n      invalidate_q <= fence_restart;\n    end\n  end\n  always_ff @(posedge clock) begin\n    if (select_normal_q && replay && space_available) replay_page <= fetch_page;\n  end\n\n  loop_trace u_trace (\n    .clock(clock), .reset(reset), .invalidate(invalidate_q), .train(trace_train),\n    .fetch_pc(imem_addr[31:2]), .allow_replay(select_normal_q && !retry_q),\n    .space(space_available), .replay(replay), .packet(trace_packet)\n  );\n\n  typedef struct packed {\n    logic [31:0] pc;'\"'''),\n    ('    logic        predicted_taken;\\\\n  } fetch_packet_t;', '  } fetch_packet_t;'),\n    ('  fetch_packet_t live_packet, queued_packet, decode_packet;', '  fetch_packet_t live_packet, input_packet, queued_packet, decode_packet;'),\n    ('  assign empty = occupancy_q[0];\\\\n  assign space_available = \"'!occupancy_q[4];'\"\\\\n  assign fetch_advance = imem_ready && space_available;\\\\n  assign push = fetch_advance && (\"'!empty || !decode_accept);'\"', '''  logic [4:0] occupancy;\n  logic [3:0] head, write_slot;\n  assign occupancy = select_normal_q ? occupancy_q : 5'b00001;\n  assign head = select_normal_q ? head_q : 4'b0001;\n  assign write_slot = select_normal_q ? write_slot_q : 4'b0001;\n  assign empty = occupancy[0];\n  assign space_available = \"'!occupancy[4];\n  assign fetch_advance = imem_ready && space_available && !replay;\n  assign push = space_available && (replay || (imem_ready && (!empty || !decode_accept)));'\"'''),\n    ('if (reset || redirect) begin', 'if (reset) begin'),\n    ('''        2'b10: occupancy_q <= occupancy_q << 1;\n        2'b01: occupancy_q <= occupancy_q >> 1;\n        default: ;''', '''        2'b10: occupancy_q <= occupancy << 1;\n        2'b01: occupancy_q <= occupancy >> 1;\n        default: occupancy_q <= occupancy;'''),\n    ('''        write_slot_q <= {write_slot_q[2:0], write_slot_q[3]};\n\n      if (empty && push)\n        head_q <= write_slot_q;\n      else if (pop && (push || \"'!occupancy_q[1]))\n        head_q <= {head_q[2:0], head_q[3]};'\"''', '''        write_slot_q <= {write_slot[2:0], write_slot[3]};\n      else\n        write_slot_q <= write_slot;\n\n      if (empty && push)\n        head_q <= write_slot;\n      else if (pop && (push || \"'!occupancy[1]))\n        head_q <= {head[2:0], head[3]};\n      else\n        head_q <= head;'\"'''),\n    ('  assign live_packet = {imem_addr, imem_data, predicted_taken};', '''  // Replay leaves the request parked at the trace head.\n  assign live_packet = {imem_addr, imem_data};\n  assign input_packet = replay ? {fetch_page, trace_packet.word_pc, 2'b00, trace_packet.instr}\n                               : live_packet;\n\n  logic stage_bus_taken, stage_trace_taken, stage_replay;\n  logic [3:0] stage_slot, queue_taken;\n  logic queued_taken;\n  always_ff @(posedge clock) begin\n    stage_slot <= (push && \"'!reset) ? write_slot : 4'\"'b0;\n    stage_bus_taken <= predicted_taken;\n    stage_trace_taken <= trace_packet.taken;\n    stage_replay <= replay;\n  end\n  assign queued_taken = (|(stage_slot & head)) ? (stage_replay ? stage_trace_taken : stage_bus_taken)\n                                               : |(queue_taken & head);'''),\n    ('if (space_available && write_slot_q[slot])\\\\n        packets_q[slot] <= live_packet;', '''if (space_available && write_slot[slot])\n        packets_q[slot] <= input_packet;\n      if (stage_slot[slot])\n        queue_taken[slot] <= stage_replay ? stage_trace_taken : stage_bus_taken;'''),\n    ('{PACKET_WIDTH{head_q[slot]}}','{PACKET_WIDTH{head[slot]}}'),\n    ('out.predicted_taken = decode_packet.predicted_taken;', 'out.predicted_taken = empty ? predicted_taken : queued_taken;'),\n    ('out.valid           = \"'!empty || imem_ready;'\"', 'out.valid           = \"'!empty || (imem_ready && !replay);'\"')])\nPY\nNRET=1 RTL_DIR=\\\"\"'$trial/cores/bench/rtl\" OBJ_DIR=\"$trial/sim\" bash test/cosim/build.sh > \"$trial/build.log\" 2>&1 &&\n\"$trial/sim/cosim_sim\" \"$TMPDIR/r11s2-profile/coremark.elf\" 5000000 --bench --istall --dstall'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'trial=\"$TMPDIR/r11s2-profile/trial\"\nmkdir -p \"$trial/cores/bench/rtl\"\ncp cores/bench/rtl/*.sv \"$trial/cores/bench/rtl/\"\ncp cores/bench/core.yaml \"$trial/cores/bench/\"\nln -s \"$PWD/fpga\" \"$trial/fpga\"\ncat > \"$trial/cores/bench/rtl/loop_trace.sv\" <<'\"'EOF'\nmodule loop_trace (\n  input logic clock, reset, invalidate,\n  input trace_train_t train,\n  input logic [31:2] fetch_pc,\n  input logic allow_replay,\n  input logic space,\n  output logic replay,\n  output trace_packet_t packet\n);\n\n  // Each resident bank has a separately registered head.\n  logic [31:2] bank_head [0:1];\n  logic [9:0] bank_tail [0:1];\n  logic [3:0] bank_end [0:1];\n  logic [1:0] bank_ready;\n  logic last_bank, active, active_bank;\n  logic [3:0] cursor;\n  logic [1:0] admit;\n  logic chosen;\n  trace_packet_t heads [0:1];\n  trace_packet_t ahead [0:1];\n  trace_packet_t bank [0:1][0:15];\n\n  assign admit[0] = bank_ready[0] && fetch_pc == bank_head[0];\n  assign admit[1] = bank_ready[1] && fetch_pc == bank_head[1];\n  assign chosen = active ? active_bank : \"'!admit[0];\n  assign replay = allow_replay && (active || (|admit));\n  assign packet = active ? ahead[active_bank] : heads[chosen];\n\n  always_ff @(posedge clock) begin\n    if (reset || invalidate || !allow_replay) begin\n      active <= 0;\n      cursor <= 1;\n    end else if (replay && space) begin\n      active <= 1;\n      active_bank <= chosen;\n      cursor <= !active ? 1 : cursor == bank_end[active_bank] ? 4'\"'d0 : cursor + 4'd1;\n    end\n    if (reset) last_bank <= 0;\n    else if (replay && space) last_bank <= chosen;\n  end\n\n  // The idle bank constantly preloads its second packet.\n  for (genvar w = 0; w < 2; w++) begin : g_ahead\n    logic selected;\n    logic [3:0] address;\n    assign selected = active && active_bank == 1'(w);\n    assign address = \"'!selected ? 4'\"'d1 : cursor == bank_end[w] ? 4'd0 : cursor + 4'd1;\n    always_ff @(posedge clock) begin\n      if (\"'!selected || space) ahead[w] <= bank[w][address];\n    end\n  end\n\n  trace_packet_t history [0:15];\n  logic [9:0] history_word [0:15];\n  logic [15:0] occupied;\n  logic [19:0] page_q;\n  logic [31:2] expected_pc;\n  logic [3:0] write_ptr;\n  logic same_segment, closing;\n  logic [15:0] found, match_q;\n  logic pending;\n  logic [3:0] tail_slot_q;\n  logic [9:0] target_q, tail_word_q;\n  logic [19:0] closing_page_q;\n\n  assign same_segment = train.pc == expected_pc && train.pc[31:12] == page_q;\n  assign closing = train.valid && train.eligible && train.closes\n                && same_segment && train.npc[31:12] == train.pc[31:12];\n  for (genvar j = 0; j < 16; j++) begin : g_match\n    assign found[j] = occupied[j] && write_ptr != 4'\"'(j)\n                   && history_word[j] == train.npc[11:2];\n  end\n  logic [3:0] match_slot;\n  logic [3:0] matched_above, matched_below;\n  logic has_below;\n  always_comb begin\n    matched_above = 0;\n    matched_below = 0;\n    has_below = 0;\n    for (int j = 0; j < 16; j++) begin\n      if (match_q[j]) begin\n        matched_above = 4'(j);\n        if (4'(j) < tail_slot_q) begin\n          matched_below = 4'(j);\n          has_below = 1;\n        end\n      end\n    end\n  end\n  assign match_slot = has_below ? matched_below : matched_above;\n\n  logic [19:0] prior_page [0:15];\n  logic [9:0] prior_head [0:15], prior_tail [0:15];\n  logic [3:0] prior_end [0:15];\n  logic [15:0] prior_valid;\n  logic [3:0] hash, distance;\n  logic [31:2] candidate;\n  logic repeated, resident, victim, same_head0, same_head1, begin_copy;\n  assign candidate = {closing_page_q, target_q};\n  assign distance = tail_slot_q - match_slot;\n  assign hash = target_q[3:0] \"'^ target_q[7:4];\n  assign repeated = prior_valid[hash] && prior_page[hash] == closing_page_q\n                  && prior_head[hash] == target_q && prior_tail[hash] == tail_word_q\n                  && prior_end[hash] == distance;\n  assign same_head0 = bank_ready[0] && bank_head[0] == candidate;\n  assign same_head1 = bank_ready[1] && bank_head[1] == candidate;\n  assign resident = (same_head0 && bank_tail[0] == tail_word_q && bank_end[0] == distance)\n                 || (same_head1 && bank_tail[1] == tail_word_q && bank_end[1] == distance);\n  assign victim = replay ? !chosen : same_head0 ? 0 : same_head1 ? 1\n                : !bank_ready[0] ? 0 : !bank_ready[1] ? 1 : !last_bank;\n\n  logic copy_read, copy_write, copy_bank;\n  logic [3:0] src_q, dst_read_q, dst_write_q;\n  trace_packet_t transfer_q;\n  assign begin_copy = pending && (|match_q) && repeated && !resident && !copy_read && !copy_write\n                  && !(replay && bank_head[chosen] == candidate && bank_ready[chosen]);\n\n  always_ff @(posedge clock) begin\n    if (reset || invalidate) begin\n      occupied <= 0;\n      write_ptr <= 0;\n      pending <= 0;\n      prior_valid <= 0;\n      bank_ready <= 0;\n      copy_read <= 0;\n      copy_write <= 0;\n    end else begin\n      pending <= closing && !begin_copy && !copy_read && !copy_write;\n      if (closing) begin\n        match_q <= found;\n        target_q <= train.npc[11:2];\n        tail_word_q <= train.pc[11:2];\n        tail_slot_q <= write_ptr;\n        closing_page_q <= train.pc[31:12];\n      end\n      if (pending && (|match_q)) begin\n        prior_valid[hash] <= 1;\n        prior_page[hash] <= closing_page_q;\n        prior_head[hash] <= target_q;\n        prior_tail[hash] <= tail_word_q;\n        prior_end[hash] <= distance;\n      end\n\n      if (begin_copy) begin\n        bank_ready[victim] <= 0;\n        bank_head[victim] <= candidate;\n        bank_tail[victim] <= tail_word_q;\n        bank_end[victim] <= distance;\n        copy_bank <= victim;\n        copy_read <= 1;\n        src_q <= match_slot;\n        dst_read_q <= 0;\n        occupied <= 0;\n        write_ptr <= 0;\n      end else if (!copy_read && !copy_write && train.valid) begin\n        if (train.eligible) begin\n          page_q <= train.pc[31:12];\n          expected_pc <= train.npc;\n          occupied <= same_segment ? occupied | (16'\"'b1 << write_ptr) : 16'b1 << write_ptr;\n          history[write_ptr] <= train.packet;\n          history_word[write_ptr] <= train.pc[11:2];\n          write_ptr <= write_ptr + 4'd1;\n        end else begin\n          occupied <= 0;\n          write_ptr <= 0;\n        end\n      end\n\n      copy_write <= copy_read;\n      if (copy_read) begin\n        transfer_q <= history[src_q];\n        dst_write_q <= dst_read_q;\n        dst_read_q <= dst_read_q + 4'd1;\n        src_q <= src_q + 4'd1;\n        if (dst_read_q == bank_end[copy_bank]) copy_read <= 0;\n      end\n      if (copy_write) begin\n        if (dst_write_q == 0) heads[copy_bank] <= transfer_q;\n        if (dst_write_q == bank_end[copy_bank]) bank_ready[copy_bank] <= 1;\n      end\n    end\n  end\n\n  for (genvar w = 0; w < 2; w++) begin : g_bank_write\n    always_ff @(posedge clock) begin\n      if (copy_write && copy_bank == 1'(w)) bank[w][dst_write_q] <= transfer_q;\n    end\n  end\nendmodule\nEOF\npython3 - \\\"\"'$trial/cores/bench/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\ndef edit(name, changes):\n    p = rtl/name\n    s=p.read_text()\n    for old,new in changes:\n        assert s.count(old)==1,(name,old,s.count(old))\n        s=s.replace(old,new)\n    p.write_text(s)\nedit('core_pkg.sv', [('  typedef struct packed {\\\\n    logic       valid;\\\\n    logic [5:0] index;', '''  typedef struct packed {\n    logic [9:0] word_pc;\n    logic [31:0] instr;\n    logic taken;\n  } trace_packet_t;\n\n  typedef struct packed {\n    logic valid;\n    logic eligible;\n    logic closes;\n    logic [31:2] pc;\n    logic [31:2] npc;\n    trace_packet_t packet;\n  } trace_train_t;\n\n  typedef struct packed {\n    logic       valid;\n    logic [5:0] index;''')])\nedit('core.sv', [\n    ('  predictor_up