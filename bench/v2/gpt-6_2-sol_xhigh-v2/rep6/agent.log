{"type":"item.completed","item":{"id":"item_118","type":"command_execution","command":"/bin/bash -c 'cat \"$TMPDIR/bench-timing-v5.tlp1FmP7/cores/bench/rtl/replay_row_valid.sv\"'","aggregated_output":"// One parity bank's resettable row validity and synchronous collision mask.\nmodule replay_row_valid (\n  input  logic       clock,\n  input  logic       clear,\n  input  logic       write_en,\n  input  logic [7:0] write_row,\n  input  logic [7:0] read_row,\n  output logic       available_q\n);\n\n  // Clearing the group bits immediately hides every row. The first write\n  // to each group replaces its row bits before setting its group bit.\n  (* syn_ramstyle = \"distributed_ram\" *) logic [15:0] row_valid [0:15];\n  logic [15:0] group_valid_q;\n  logic [15:0] write_bit, write_valid, read_valid;\n\n  assign write_bit = 16'b1 << write_row[3:0];\n  assign write_valid = write_bit | (group_valid_q[write_row[7:4]] ? row_valid[write_row[7:4]] : 16'b0);\n  assign read_valid = row_valid[read_row[7:4]];\n\n  always_ff @(posedge clock) begin\n    if (clear) begin\n      group_valid_q <= '0;\n      available_q <= 1'b0;\n    end else begin\n      if (write_en) begin\n        group_valid_q[write_row[7:4]] <= 1'b1;\n        row_valid[write_row[7:4]] <= write_valid;\n      end\n      available_q <= group_valid_q[read_row[7:4]] && read_valid[read_row[3:0]]\n                  && !(write_en && write_row == read_row);\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
