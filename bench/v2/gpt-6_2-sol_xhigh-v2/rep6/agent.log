7:\"cycles\": 4190281\n7:\"from\": \"cpu/u_mem/reg_q.rd_1_s0\"\n7:\"to\": \"dmem_1_dmem_1_0_0_s\"\ncores/bench/rtl/ex_stage.sv:22:  input  logic [31:0]        fwd_ex_mem,    // EX/MEM.alu_result (registered)\ncores/bench/rtl/ex_stage.sv:157:      reg_q.alu_result    <= in.ctrl.is_jump ? (in.pc + 32'd4) : alu_result;\ncores/bench/rtl/mem_stage.sv:4:// from the fast EX/MEM lane. Completes loads and RV32M results, then\ncores/bench/rtl/mem_stage.sv:68:      2'd0:    byte_mask = (4'b0001 << in.alu_result[1:0]);\ncores/bench/rtl/mem_stage.sv:69:      2'd1:    byte_mask = (4'b0011 << in.alu_result[1:0]);\ncores/bench/rtl/mem_stage.sv:75:                     (in.ctrl.mem_width == 2'd2 && in.alu_result[1:0] != 2'b00) ||\ncores/bench/rtl/mem_stage.sv:76:                     (in.ctrl.mem_width == 2'd1 && in.alu_result[0]   != 1'b0)\ncores/bench/rtl/mem_stage.sv:81:    shifted   = dmem_rdata >> (in.alu_result[1:0] * 8);\ncores/bench/rtl/mem_stage.sv:96:                 ? {in.alu_result[31:2], 2'b00}\ncores/bench/rtl/mem_stage.sv:101:  assign dmem_addr    = in.alu_result;\ncores/bench/rtl/mem_stage.sv:115:      default:     wb_result = in.alu_result;\ncores/bench/rtl/core.sv:78:  logic       stall_ex_mem, dmem_pending, div_wait;\ncores/bench/rtl/core.sv:137:    .stall           (stall_ex_mem),\ncores/bench/rtl/core.sv:141:    .fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\ncores/bench/rtl/core.sv:153:    .hold_wb      (stall_ex_mem),\ncores/bench/rtl/core.sv:187:    .stall_ex_mem   (stall_ex_mem)\n","exit_code":0,"status":"completed"}}
