{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'set -eu\ncosim_stage=\"$TMPDIR/bench-fetch-cosim.nr4t9jyQ\"\nmkdir -p \"$cosim_stage/baseline\"\ngit archive HEAD cores/bench/rtl | tar -x -C \"$cosim_stage/baseline\"\ncd \"$cosim_stage\"\nexport PYTHONDONTWRITEBYTECODE=1\nexport RTL_DIR=baseline/cores/bench/rtl OBJ_DIR=baseline/obj_dir NRET=1\nbash test/cosim/build.sh\npython3 - <<'\"'PY'\nimport json\nimport subprocess\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tools.eval.fpga import validate_coremark_uart\n\ndef run(item):\n    label, path, seed = item\n    command = [path, \\\"bench/programs/coremark.elf\\\", \\\"50000000\\\", \\\"--bench\\\", \\\"--istall\\\", \\\"--dstall\\\"]\n    if seed:\n        command.extend((\\\"--seed\\\", str(seed)))\n    result = subprocess.run(command, check=True, capture_output=True, text=True)\n    marker = json.loads(result.stdout.splitlines()[-1])\n    assert marker[\\\"ebreak\\\"] and marker[\\\"bench_bracketed\\\"] and not marker[\\\"oob\\\"], marker\n    ok, reason = validate_coremark_uart(marker[\\\"uart\\\"], 10)\n    assert ok, reason\n    return (seed, label), marker[\\\"bench_stop_cycle\\\"] - marker[\\\"bench_start_cycle\\\"]\n\nseeds = (0, 1, 2, 3, 4)\nbinaries = {\\\"baseline\\\": \\\"baseline/obj_dir/cosim_sim\\\", \\\"buffered\\\": \\\"cores/bench/obj_dir/cosim_sim\\\"}\nwith ThreadPoolExecutor(max_workers=5) as executor:\n    cycles = dict(executor.map(run, [(label, path, seed) for seed in seeds for label, path in binaries.items()]))\nfor seed in seeds:\n    old, new = (cycles[seed, label] for label in binaries)\n    print(f\\\"seed {seed or 'default'}: {old:,} -> {new:,} marker cycles ({(1-new/old)*100:.3f}% reduction)\\\")\nprint(f\\\"fitness at 89.879 MHz: {89.879e6*10/cycles[0, 'buffered']:.3f} iterations/s\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
