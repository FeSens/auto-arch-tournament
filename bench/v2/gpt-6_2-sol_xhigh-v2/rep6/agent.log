ng_remainder} : 28'b0;\n        else\n          remainder_banks_q[28*bank +: 28] <= result_terms[32*bank +: 28];\n      end''')\np.write_text(s)\nPY\nfor name in neg1 neg4 neg4prep neg2rec neg4rec; do\n  mkdir -p \\\"\"'$TMPDIR/bench-r8s1-$name/cores/bench/rtl\"\n  cp cores/bench/core.yaml \"$TMPDIR/bench-r8s1-$name/cores/bench/\"\n  cp -r fpga \"$TMPDIR/bench-r8s1-$name/\"\ndone\npython3 \"$TMPDIR/bench-r8s1-width/make_neg_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-neg1/cores/bench/rtl\" 1\npython3 \"$TMPDIR/bench-r8s1-width/make_neg_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-neg4/cores/bench/rtl\" 4\npython3 \"$TMPDIR/bench-r8s1-width/make_neg_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-neg4prep/cores/bench/rtl\" 4 1\npython3 \"$TMPDIR/bench-r8s1-width/make_neg_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-neg2rec/cores/bench/rtl\" 2 2\npython3 \"$TMPDIR/bench-r8s1-width/make_neg_div.py\" cores/bench/rtl \"$TMPDIR/bench-r8s1-neg4rec/cores/bench/rtl\" 4 2'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
