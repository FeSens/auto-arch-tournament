{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c 'set -e\nscratch=\"$(cat \"$TMPDIR/hyp-r15s0-scratch\")\"\n\"$scratch/obj/cosim_sim\" \"$scratch/bench/programs/coremark.elf\" 50000000 --istall --dstall | python3 -c '\"'\nimport json,sys,collections\ncounts=collections.Counter()\npairs=collections.Counter()\nprevious=None\nfor line in sys.stdin:\n    d=json.loads(line)\n    if \\\"order\\\" not in d:\n        print(\\\"markers\\\",d.get(\\\"bench_start_cycle\\\"),d.get(\\\"bench_stop_cycle\\\"))\n        break\n    # Bracket with marker store entries since this trace is single retire.\n    if d[\\\"mem_addr\\\"]==0x10000100 and d[\\\"mem_wmask\\\"]: previous=d; continue\n    if d[\\\"mem_addr\\\"]==0x10000104 and d[\\\"mem_wmask\\\"]: break\n    if previous is None: continue\n    insn=d[\\\"insn\\\"]\n    opcode=insn&127\n    src1=(insn>>15)&31\n    src2=(insn>>20)&31\n    counts[opcode]+=1\n    if previous[\\\"insn\\\"]&127==3 and previous[\\\"rd_addr\\\"]\"'!=0 and previous[\"rd_addr\"] in (src1,src2):\n        match=(int(src1==previous[\"rd_addr\"]),int(src2==previous[\"rd_addr\"]))\n        pairs[(hex(opcode),match)]+=1\n    previous=d\nprint(counts)\nprint(pairs.most_common())'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
