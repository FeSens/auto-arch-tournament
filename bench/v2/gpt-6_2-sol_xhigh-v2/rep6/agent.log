{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_pipeline.py')\ns=p.read_text().replace('assert gaps == [1, 9, 10, 2, 1, 10, 10, 2, 10, 2, 1]', 'assert gaps == [1, 9, 10, 2, 1, 10, 10, 2, 9, 2, 1]')\ni=s.index('def test_pipeline_runner')\ns=s[:i]+'''@cocotb.test()\nasync def direct_transfer_retry_with_older_store(dut):\n    program = [\n        ADDI(1, 0, 7),\n        SW(1, 0, 0x80),\n        BEQ(1, 1, 8),\n        SW(0, 0, 0x90),\n        JAL(5, 8),\n        SW(0, 0, 0x90),\n        ADDI(6, 5, 1),\n        EBREAK(),\n    ]\n    requests = []\n    rets, dmem = await _run(dut, program, imem_stalls={16: 5},\n                            dmem_stalls={0x80: 3}, dmem_trace=requests)\n    assert [r[\\\"pc\\\"] for r in rets] == [0, 4, 8, 16, 24, 28]\n    assert [r[\\\"pc_next\\\"] for r in rets[:-1]] == [r[\\\"pc\\\"] for r in rets[1:]]\n    assert [r[\\\"order\\\"] for r in rets] == list(range(len(rets)))\n    assert requests == [(0x80, 0, 0xF, 7, False)] * 3 + [(0x80, 0, 0xF, 7, True)]\n    assert dmem == {0x80: 7}\n    assert rets[-2][\\\"rd_wdata\\\"] == 21\n    assert rets[-2][\\\"cycle\\\"] - rets[-3][\\\"cycle\\\"] == 1\n\n\n'''+s[i:]\np.write_text(s)\nPY\npytest -q cores/bench/test/\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
