{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport shutil\nfrom pathlib import Path\nroot=Path('/srv/hwebench/tmp/86dd60e1/e5d8161d/bench-r7s0-9mqm8hn6')\ntree=root/'fixed2'\nshutil.copytree('cores/bench/test',tree/'cores/bench/test')\n(tree/'formal/riscv-formal/cores').mkdir(parents=True)\nfor file in ('run_all.sh','wrapper_si.sv','checks_si.cfg'):\n    shutil.copy2(Path('formal')/file,tree/'formal'/file)\nfor folder in ('checks','insns','bus','monitor'):\n    shutil.copytree(Path('formal/riscv-formal')/folder,tree/'formal/riscv-formal'/folder)\npath=tree/'cores/bench/test/test_pipeline.py'\ns=path.read_text()\ns=s.replace('''    expected_fetches = (\n        [(0, True), (4, True), (8, True)] +\n        [(12, not stall_fetch)] * (store_stalls + 1) +\n        [(16, False)] * target_stalls + [(16, True), (20, True)] +\n        [(12, True)] * (load_stalls + 1) +\n        [(24, False)] * fallthrough_stalls + [(24, True), (28, True)]\n    )''','''    def wrong_path_fetches(hold_cycles):\n        if hold_cycles == 0:\n            return [(12, True)]\n        return [(12, True), (16, True)] + [(20, True)] * (hold_cycles - 1)\n\n    before_taken = ([(12, False)] * (store_stalls + 1)\n                    if stall_fetch else wrong_path_fetches(store_stalls))\n    expected_fetches = (\n        [(0, True), (4, True), (8, True)] + before_taken +\n        [(16, False)] * target_stalls + [(16, True), (20, True)] +\n        wrong_path_fetches(load_stalls) +\n        [(24, False)] * fallthrough_stalls + [(24, True), (28, True)]\n    )''')\ns=s.replace('@cocotb.test()\\\\nasync def reserved_and_misaligned_transfers_fetch_sequentially', '''@cocotb.test()\n@cocotb.parametrize(stalled_pc=[16, 20])\nasync def buffered_fetches_retire_during_an_instruction_bus_hold(dut, stalled_pc):\n    program = [LW(5, 0, 0x80), ADDI(1, 0, 7), ADD(2, 1, 5),\n               SW(2, 0, 0x84), ADDI(3, 0, 11), EBREAK()]\n    fetches, requests = [], []\n    rets, dmem = await _run(dut, program, dmem_init={0x80: 35},\n                            dmem_stalls={0x80: 4}, imem_stalls={stalled_pc: 8},\n                            imem_trace=fetches, dmem_trace=requests)\n    _assert_retirement_path(rets, list(range(0, 24, 4)))\n    assert [r[\\\"insn\\\"] for r in rets] == program\n    assert all(r[\\\"trap\\\"] == 0 for r in rets)\n    assert fetches[:4] == [(pc, True) for pc in range(0, 16, 4)]\n    assert fetches.count((stalled_pc, False)) == 8\n    assert requests == ([(0x80, 1, 0, 0, False)] * 4 +\n                        [(0x80, 1, 0, 0, True), (0x84, 0, 0xF, 42, True)])\n    assert dmem[0x84] == 42\n    unbroken = (stalled_pc // 4)\n    assert [r[\\\"cycle\\\"] - rets[0][\\\"cycle\\\"] for r in rets[:unbroken]] == list(range(unbroken))\n\n\n@cocotb.test()\nasync def reserved_and_misaligned_transfers_fetch_sequentially''')\npath.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
