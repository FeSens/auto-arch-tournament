{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nrtl = Path(\\\"cores/bench/rtl\\\")\n\ndef edit(name, replacements):\n    path = rtl / name\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (name, old)\n        text = text.replace(old, new)\n    path.write_text(text)\n\nedit(\\\"core_pkg.sv\\\", [\n    (\\\"  // IF -> ID combinational bundle\\\", \\\"\\\"\\\"  typedef struct packed {\n    logic        valid;\n    logic        conditional;\n    logic        taken;\n    logic [17:0] source_word;\n    logic [17:0] target_word;\n  } btb_update_t;\n\n  // IF -> ID combinational bundle\\\"\\\"\\\")\n])\n\nedit(\\\"core.sv\\\", [\n    (\\\"  // regfile interface\\\", \\\"\\\"\\\"  btb_update_t btb_update, btb_update_q;\n  always_ff @(posedge clock) begin\n    btb_update_q <= btb_update;\n    if (reset) btb_update_q.valid <= 1'b0;\n  end\n\n  // regfile interface\\\"\\\"\\\"),\n    (\\\"    .imem_addr       (io_imemAddr),\\\", \\\"\\\"\\\"    .btb_update      (btb_update_q),\n    .imem_addr       (io_imemAddr),\\\"\\\"\\\"),\n    (\\\"    .fast_write      (ex_fast_write),\\\", \\\"\\\"\\\"    .fetch_pc        (if_id_w.pc),\n    .btb_update      (btb_update),\n    .fast_write      (ex_fast_write),\\\"\\\"\\\")\n])\n\nedit(\\\"if_stage.sv\\\", [\n    (\\\"  output logic [31:0] imem_addr,\\\", \\\"\\\"\\\"  input  btb_update_t btb_update,\n  output logic [31:0] imem_addr,\\\"\\\"\\\"),\n    (\\\"  // A redirect from advancing EX overrides a stalled sequential fetch.\\\", \\\"\\\"\\\"  logic [63:0] valid_q;\n  logic [11:0] tags [0:63];\n  logic [17:0] targets [0:63];\n  logic [1:0] counters [0:63];\n\n  wire [5:0] lookup_index = pc[7:2] \"'^ pc[13:8];\n  wire [5:0] update_index = btb_update.source_word[5:0]\n                          ''^ btb_update.source_word[11:6];\n  wire update_hit = valid_q[update_index]\n               