{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport shutil\nfrom pathlib import Path\nroot = Path('/srv/hwebench/tmp/86dd60e1/e5d8161d/bench-r7s0-9mqm8hn6')\nfor depth in (1,2):\n    tree = root/f'skid{depth}'\n    shutil.copytree(root/'base/cores', tree/'cores', ignore=shutil.ignore_patterns('generated'))\n    (tree/'fpga').symlink_to(Path('fpga').resolve(), target_is_directory=True)\n    (tree/'bench').symlink_to(root/'candidate/bench', target_is_directory=True)\n    path = tree/'cores/bench/rtl/core.sv'\n    s = path.read_text().replace('  logic       stall_if, stall_id, flush_id;', '  logic       stall_id, flush_id;')\n    s = s.replace('.stall                (stall_if),', '.id_accept            (\"'!stall_id && !flush_id),'\"')\n    s = s.replace('.imem_ready     (io_imemReady),', '.if_id_valid    (if_id_w.valid),')\n    s = s.replace('    .stall_if       (stall_if),\\\\n','')\n    path.write_text(s)\n\n    path = tree/'cores/bench/rtl/hazard_unit.sv'\n    s = path.read_text().replace('imem_ready','if_id_valid')\n    s = s.replace('  output logic       stall_if,\\\\n','')\n    s = s.replace('  assign stall_if     = stall_id || late_dependency || \"'!if_id_valid;'\"\\\\n', '')\n    path.write_text(s)\n\n    path = tree/'cores/bench/rtl/if_stage.sv'\n    s = path.read_text().replace('input  logic              stall,','input  logic              id_accept,')\n    anchor = '  always_ff @(posedge clock) begin\\\\n    if (reset) begin\\\\n      pc_page_q'\n    if depth == 1:\n        insert = '''  if_id_t fetch, head_q;\n  logic fetch_advance, skid_valid, capture_head;\n\n  assign fetch_advance = imem_ready && (\"'!skid_valid || id_accept);\n  assign capture_head = fetch_advance && (skid_valid || !id_accept);\n  always_ff @(posedge clock) begin\n    if (capture_head)\n      head_q <= fetch;\n    if (reset || recover_taken || recover_fallthrough)\n      skid_valid <= 1'\"'b0;\n    else\n      skid_valid <= capture_head || (skid_valid && \"'!id_accept);\n  end\n\n'\"'''\n    else:\n        insert = '''  if_id_t fetch, head_q, tail_q;\n  logic fetch_advance, skid_valid, skid_full, pop, push;\n  logic next_head_from_tail, next_head_from_fetch, capture_tail;\n  assign pop = skid_valid && id_accept;\n  assign fetch_advance = imem_ready && (\"'!skid_full || id_accept);\n  assign push = fetch_advance && (skid_valid || !id_accept);\n  assign next_head_from_tail = pop && skid_full;\n  assign next_head_from_fetch = push && (!skid_valid || (pop && !skid_full));\n  assign capture_tail = push && (skid_full || (skid_valid && !pop));\n\n  always_ff @(posedge clock) begin\n    if (next_head_from_tail)\n      head_q <= tail_q;\n    else if (next_head_from_fetch)\n      head_q <= fetch;\n    if (capture_tail)\n      tail_q <= fetch;\n\n    if (reset || recover_taken || recover_fallthrough) begin\n      skid_valid <= 1'\"'b0;\n      skid_full <= 1'b0;\n    end else begin\n      skid_valid <= push || (skid_valid && \"'!pop) || skid_full;\n      skid_full <= capture_tail || (skid_full && !pop);\n    end\n  end\n\n'\"'''\n    s = s.replace(anchor, insert+anchor)\n    s = s.replace('\"'!stall && !predicted_taken'\"', 'fetch_advance && \"'!predicted_taken'\"')\n    s = s.replace('pc_word_q <= stall ?', 'pc_word_q <= \"'!fetch_advance ?'\"')\n    s = s.replace('  assign out.pc              = imem_addr;\\\\n  assign out.instr           = imem_data;\\\\n  assign out.predicted_taken = predicted_taken;\\\\n  assign out.valid           = imem_ready;', '''  assign fetch.pc = imem_addr;\n  assign fetch.instr = imem_data;\n  assign fetch.predicted_taken = predicted_taken;\n  assign fetch.valid = imem_ready;\n\n  always_comb begin\n    out = skid_valid ? head_q : fetch;\n    out.valid = skid_valid || imem_ready;\n  end''')\n    path.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
