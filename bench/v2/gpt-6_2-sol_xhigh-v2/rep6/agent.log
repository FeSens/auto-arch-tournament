 m[a+i]=(v>>(i*8))&0xFF;\n}\n\n// VexRiscv-style random bus backpressure model (regression/main.cpp:2079).\n// xorshift7 LFSR; accept request when (state & 0x7F) < 100 (~78% accept,\n// ~22% stall). Replicating exactly so CoreMark/MHz numbers from this\n// cosim are directly comparable to VexRiscv's published \"full no cache,\n// 2.30\" — which is measured under iStall+dSt\n…[11428 of 14500 chars elided by tools/bench/transcript.py; sha256:8be88c156d984be1]…\n str, sim_bin: str | None = None, env: dict | None = None) -> dict:\n210:    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\n220:                'reason': f'coremark_harness_error: {e}'}\n251:    valid, reason = validate_coremark_uart(uart, iterations)\n257:    # bench/programs/coremark/baremetal/core_portme.c's start/stop_time.\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n284:            return False, f'coremark_unvalidated_seed_or_size: {uart[-500:]}'\n286:            return False, f'coremark_reported_error: {uart[-500:]}'\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n299:            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n341:        'ipc_coremark': float,           — iter/cycle\n372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n", "exit_code": 0, "status": "completed"}}
