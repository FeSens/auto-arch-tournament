{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c \"cat formal/wrapper_si.sv && sed -n '1,100p' formal/checks_si.cfg && sed -n '25,80p;174,235p' tools/eval/gowin.py\"", "aggregated_output": "// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[6406 of 9478 chars elided by tools/bench/transcript.py; sha256:12c208ce1c03ab83]…\n:\n            print(f\"place_option {r['place_option']}: FAILED ({r.get('reason')})\")\n            continue\n        print(f\"place_option {r['place_option']}: Fmax {r['fmax_mhz']} MHz, {r['levels']} logic levels; \"\n              f\"logic {r['logic']}, registers {r['regs']}, LUT-RAM {r['lutram']}, BSRAM {r['bsram']}, DSP {r['dsp']}\")\n        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\n        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\n            print(f\"  path {i}: {p['arrival_ns']} ns, {p['logic_cells']} cells, {p['from']} -> {p['to']}\")\n            print(f\"          through: {' > '.join(p['modules'])}\")\n        print(f\"  full report: {tr}\")\n    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\n        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\n    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p /srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/candidate/cores/bench && cp -r cores/bench/rtl /srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/candidate/cores/bench/ && cp cores/bench/core.yaml /srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/candidate/cores/bench/ && cp -r fpga /srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/candidate/ && cat >/srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/prototype.py <<'PY'\nfrom pathlib import Path\nrtl = Path(__file__).parent / 'candidate' / 'cores' / 'bench' / 'rtl'\n\ndef edit(file, old, new):\n    p = rtl / file\n    s = p.read_text()\n    assert old in s, (file, old)\n    p.write_text(s.replace(old, new))\n\nedit('core_pkg.sv', '''    logic        taken;\n    logic        branch;\n    logic        barrier;\n  } replay_observation_t;\n\n  typedef struct packed {\n    logic [31:2] instr;\n    logic        taken;\n  } replay_word_t;''', '''    logic [11:2] target;\n    logic        branch;\n    logic        jal;\n  } replay_observation_t;\n\n  typedef struct packed {\n    logic [31:11] tag;\n    logic [31:2] instr;\n    logic [11:2] target;\n    logic        branch;\n    logic        jal;\n  } replay_word_t;''')\n\nedit('mem_stage.sv', '''    replay_observation.valid <= \"'!reset && in.valid && !hold_wb;\n    replay_observation.pc <= in.pc[31:2];\n    replay_observation.instr <= in.instr[31:2];\n    replay_observation.taken <= branch_taken || in.ctrl.is_jump;\n    replay_observation.branch <= in.ctrl.is_branch;\n    replay_observation.barrier <= in.ctrl.is_illegal || mem_misalign || in.ctrl.is_jalr\n                               || in.instr[6:0] == 7'\"'b1110011\n                               || in.instr[6:0] == 7'b0001111;''','''    replay_observation.valid <= \"'!reset && in.valid && !hold_wb\n                               && !in.ctrl.is_illegal && !mem_misalign && !in.ctrl.is_jalr\n                               && in.instr[6:0] != 7'\"'b1110011\n                               && in.instr[6:0] \"'!= 7'\"'b0001111;\n    replay_observation.pc <= in.pc[31:2];\n    replay_observation.instr <= in.instr[31:2];\n    replay_observation.target <= late_branch.target[11:2];\n    replay_observation.branch <= in.ctrl.is_branch && \"'!in.instr[8]\n                                && late_branch.target[31:12] == in.pc[31:12];\n    replay_observation.jal <= in.ctrl.is_jump && !in.ctrl.is_jalr\n                             && late_branch.target[31:12] == in.pc[31:12];'\"''')\nedit('if_stage.sv', '''  logic        replay_active, replay_select, replay_enqueue;\n  logic [31:2] replay_pc;\n  replay_word_t replay_word;''','''  logic        replay_select, replay_enqueue, replay_taken, replay_direction;\n  logic        any_advance;\n  logic [19:0] normal_page_next, recovery_page_next;\n  logic [9:0]  normal_word_next, recovery_word_next;\n  logic [10:2] replay_address;\n  replay_word_t replay_word;''')\nedit('if_stage.sv', '''  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_page_q <= '0;\n      pc_word_q <= '0;\n    end else if (correction) begin\n      // Accept the first response sequentially, or retry it on the normal lane.\n      pc_page_q <= (fetch_advance && recovery_sequential[10])\n                 ? recovery_page_plus_one : recovery_pc[31:12];\n      pc_word_q <= fetch_advance ? recovery_sequential[9:0] : recovery_pc[11:2];\n    end else if (fetch_advance) begin\n      if (\"'!predicted_taken && normal_sequential[10])\n        pc_page_q <= normal_page_plus_one;\n      pc_word_q <= predicted_taken ? predicted_sum[9:0] : normal_sequential[9:0];\n    end\n  end'\"''','''  assign replay_direction = trained_q[lookup_index] ? direction_counters[lookup_index][1]\n                                                    : replay_word.instr[31];\n  assign replay_taken = replay_word.jal || (replay_word.branch && replay_direction);\n  assign any_advance = fetch_advance || replay_enqueue;\n  assign normal_page_next = normal_sequential[10] &&\n                            (fetch_advance && \"'!predicted_taken || replay_enqueue && !replay_taken)\n                          ? normal_page_plus_one : pc_page_q;\n  assign normal_word_next = ({10{fetch_advance && predicted_taken}} & predicted_sum[9:0])\n                          | ({10{replay_enqueue && replay_taken}} & replay_word.target)\n                          | ({10{fetch_advance && !predicted_taken || replay_enqueue && !replay_taken}}\n                             & normal_sequential[9:0])\n                          | ({10{!any_advance}} & pc_word_q);\n  assign recovery_page_next = (fetch_advance && recovery_sequential[10])\n                            ? recovery_page_plus_one : recovery_pc[31:12];\n  assign recovery_word_next = fetch_advance ? recovery_sequential[9:0] : recovery_pc[11:2];\n  assign replay_address = reset ? '\"'0 :\n                          correction ? recovery_word_next[8:0] : normal_word_next[8:0];\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc_page_q <= '0;\n      pc_word_q <= '0;\n    end else begin\n      pc_page_q <= correction ? recovery_page_next : normal_page_next;\n      pc_word_q <= correction ? recovery_word_next : normal_word_next;\n    end\n  end''')\nedit('if_stage.sv','''  assign live_valid = imem_ready && (\"'!replay_active || correction);\n  assign fetch_advance = live_valid && space_available;'\"''','''  assign live_valid = imem_ready;\n  assign fetch_advance = live_valid && space_available;\n  assign replay_enqueue = replay_select && space_available;''')\nedit('if_stage.sv','''  // A stalled replay head already has the normal fetch address.\n  assign enqueue_packet.pc = (replay_active && \"'!correction) ? replay_pc : live_packet.pc;\n  assign enqueue_packet.instr = replay_select ? {replay_word.instr, 2'\"'b11} : live_packet.instr;\n  assign enqueue_packet.predicted_taken = replay_select ? replay_word.taken : live_packet.predicted_taken;''','''  assign enqueue_packet.pc = live_packet.pc;\n  assign enqueue_packet.instr = replay_select ? {replay_word.instr, 2'b11} : live_packet.instr;\n  assign enqueue_packet.predicted_taken = replay_select ? replay_taken : live_packet.predicted_taken;''')\nedit('if_stage.sv','''    .correction      (correction),\n    .invalidate      (invalidate_replay),\n    .observation     (replay_observation),\n    .normal_pc       ({pc_page_q, pc_word_q}),\n    .live_sequential (\"'!predicted_taken),\n    .imem_ready      (imem_ready),\n    .queue_space     (space_available),\n    .active          (replay_active),\n    .select_packet   (replay_select),\n    .enqueue         (replay_enqueue),\n    .packet_pc       (replay_pc),\n    .packet_word     (replay_word)'\"''','''    .invalidate      (invalidate_replay),\n    .observation     (replay_observation),\n    .read_index      (replay_address),\n    .current_tag     ({pc_page_q, pc_word_q[9]}),\n    .hit             (replay_hit),\n    .packet_word     (replay_word)''')\nedit('if_stage.sv','''  loop_replay u_replay (''','''  logic replay_hit;\n  assign replay_select = \"'!correction && !imem_ready && replay_hit;\n\n  loop_replay u_replay ('\"''')\n\n(rtl / 'loop_replay.sv').write_text('''// Completed instruction packets and local direct successors for stall replay.\nmodule loop_replay (\n  input logic clock,\n  input logic reset,\n  input logic invalidate,\n  input replay_observation_t observation,\n  input logic [10:2] read_index,\n  input logic [31:11] current_tag,\n  output logic hit,\n  output replay_word_t packet_word\n);\n  localparam integer PACKET_WIDTH = \"'$bits(packet_word);\n  (* syn_ramstyle = \"block_ram\" *) logic [PACKET_WIDTH-1:0] packets [0:511];\n  logic [PACKET_WIDTH-1:0] packet_q;\n  logic [511:0] valid_q;\n  logic accessible_q;\n  logic [10:2] write_index;\n  logic write_valid;\n\n  assign write_index = observation.pc[10:2];\n  assign write_valid = !reset && !invalidate && observation.valid;\n  assign packet_word = packet_q;\n  assign hit = accessible_q && packet_word.tag == current_tag;\n\n  always_ff @(posedge clock) begin\n    if (write_valid)\n      packets[write_index] <= {observation.pc[31:11], observation.instr,\n                               observation.target, observation.branch, observation.jal};\n    packet_q <= packets[read_index];\n\n    if (reset || invalidate)\n      valid_q <= '\"'0;\n    else if (write_valid)\n      valid_q[write_index] <= 1'b1;\n\n    accessible_q <= \"'!reset && !invalidate && valid_q[read_index]\n                   && !(write_valid && write_index == read_index);\n  end\nendmodule\n'\"''')\nPY\npython3 /srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/prototype.py\nNRET=1 RTL_DIR=/srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/candidate/cores/bench/rtl OBJ_DIR=/srv/hwebench/tmp/86dd60e1/4f760fe4/trace-study.vbsQwA/candidate/obj bash test/cosim/build.sh\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
