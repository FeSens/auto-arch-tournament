{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport subprocess\n\n\ndef extract(value, high, low):\n    return f'((_ extract {high} {low}) {value})'\n\n\ndef constant(value, width):\n    return f'(_ bv{value} {width})'\n\n\ndef equal(left, right):\n    return f'(= {left} {right})'\n\n\ndef unsigned_less(left, right):\n    return f'(bvult {left} {right})'\n\n\ndef append_comparison(high, low):\n    high_equal, high_less = high\n    low_equal, low_less = low\n    return f'(and {high_equal} {low_equal})', f'(or {high_less} (and {high_equal} {low_less}))'\n\n\nraw, other = 'raw', 'other'\ncommands = ['(set-logic QF_BV)', '(declare-const raw (_ BitVec 32))', '(declare-const other (_ BitVec 32))']\ncount = 0\nfor width in (8, 16, 32):\n    for offset in range(0, 32, width):\n        for sext in ((False, True) if width < 32 else (False,)):\n            raw_byte = extract(raw, offset + 7, offset)\n            other_byte = extract(other, 7, 0)\n            flags = equal(raw_byte, other_byte), unsigned_less(raw_byte, other_byte)\n            for payload_low in range(8, width, 8):\n                raw_byte = extract(raw, offset + payload_low + 7, offset + payload_low)\n                other_byte = extract(other, payload_low + 7, payload_low)\n                flags = append_comparison((equal(raw_byte, other_byte), unsigned_less(raw_byte, other_byte)), flags)\n            raw_sign = equal(extract(raw, offset + width - 1, offset + width - 1), constant(1, 1))\n            fill = raw_sign if sext else 'false'\n            if width < 32:\n                upper = extract(other, 31, width)\n                all_zero = equal(upper, constant(0, 32 - width))\n                all_one = equal(upper, constant((1 << (32 - width)) - 1, 32 - width))\n                upper_flags = f'(ite {fill} {all_one} {all_zero})', f'(and (not {fill}) (not {all_zero}))'\n                flags = append_comparison(upper_flags, flags)\n            branch_equal, branch_less = flags\n            load_sign = raw_sign if width == 32 else fill\n            other_sign = equal(extract(other, 31, 31), constant(1, 1))\n            signed_less = f'(ite (xor {load_sign} {other_sign}) {load_sign} {branch_less})'\n            shifted = f'(bvlshr raw {constant(offset, 32)})'\n            payload = extract(shifted, width - 1, 0)\n            extension = 'sign_extend' if sext else 'zero_extend'\n            expected = f'((_ {extension} {32 - width}) {payload})' if width < 32 else payload\n            for reverse in (False, True):\n                compare_a, compare_b = (other, expected) if reverse else (expected, other)\n                model_u, model_s = branch_less, signed_less\n                if reverse:\n                    model_u = f'(and (not {branch_equal}) (not {model_u}))'\n                    model_s = f'(and (not {branch_equal}) (not {model_s}))'\n                match = f'(and (= {branch_equal} (= {compare_a} {compare_b})) (= {model_u} (bvult {compare_a} {compare_b})) (= {model_s} (bvslt {compare_a} {compare_b})))'\n                commands.extend(['(push)', f'(assert (not {match}))', '(check-sat)', '(pop)'])\n                count += 1\nresult = subprocess.run(['z3', '-in'], input='\\\\n'.join(commands), text=True, capture_output=True, check=True)\nassert result.stdout.splitlines() == ['unsat'] * count, result.stdout\nprint(f'Proved comparison equivalence for {count} load form and branch operand order combinations, for all raw words and comparison operands.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
