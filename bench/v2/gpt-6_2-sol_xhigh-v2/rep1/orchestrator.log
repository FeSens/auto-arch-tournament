  [codex] input  logic              reset,
  [codex] input  logic              advance_fetch,
  [codex] input  logic              redirect,
  [codex] input  logic [31:0]       redirect_target,
  [codex] input  btb_update_t       btb_update,
  [codex] output logic [31:0]       imem_addr,
  [codex] input  logic [31:0]       imem_data,
  [codex] output if_id_t  out
  [codex] );
  [codex] logic [31:0] pc;
  [codex] logic [31:0] pc_plus4, predicted_pc;
  [codex] logic [4:0]  fetch_index, write_index;
  [codex] logic [12:0] write_tag;
  [codex] logic        fetch_in_range, hit, same_index_write;
  [codex] logic [1:0]  counter;
  [codex] logic [31:0] btb_valid;
  [codex] logic [30:0] btb_entry [0:31]; // {tag, word target}
  [codex] logic [1:0]  btb_counter [0:31];
  [codex] logic [12:0] fetch_tag;
  [codex] logic [17:0] fetch_target;
  [codex] assign fetch_index = pc[6:2];
  [codex] assign {fetch_tag, fetch_target} = btb_entry[fetch_index];
  [codex] assign counter = btb_counter[fetch_index];
  [codex] assign fetch_in_range = pc[31:20] == 12'b0 && pc[1:0] == 2'b00;
  [codex] assign hit = fetch_in_range && btb_valid[fetch_index] && fetch_tag == pc[19:7];
  [codex] assign pc_plus4 = pc + 32'd4;
  [codex] assign predicted_pc = (hit && counter[1]) ? {12'b0, fetch_target, 2'b00} : pc_plus4;
  [codex] assign {write_tag, write_index} = btb_update.pc_word;
  [codex] assign same_index_write = btb_update.write_counter && write_index == fetch_index;
  [codex] // A resolving instruction can redirect even when imem is unready.
  [codex] // EX qualifies redirect and training with its own advance.
  [codex] always_ff @(posedge clock) begin
  [codex] if (reset)              pc <= '0;
