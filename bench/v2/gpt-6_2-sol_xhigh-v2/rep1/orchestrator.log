  [codex] if (!reset && btb_update.write_counter)
  [codex] btb_counter[write_index] <= btb_update.counter;
  [codex] end
  [codex] assign imem_addr = pc;
  [codex] always_comb begin
  [codex] out.pc       = pc;
  [codex] out.pc_plus4 = pc_plus4;
  [codex] out.instr    = imem_data;
  [codex] // The prediction uses the old table value. The instruction accepted
  [codex] // on this edge trains against the entry that survives the EX write.
  [codex] out.btb_hit = same_index_write ? fetch_in_range && write_tag == pc[19:7] : hit;
  [codex] out.btb_counter = same_index_write ? btb_update.counter : counter;
  [codex] end
  [codex] endmodule
