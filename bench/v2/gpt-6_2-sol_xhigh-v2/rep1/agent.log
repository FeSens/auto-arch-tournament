{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN' <<'PY'\nfrom pathlib import Path\nimport sys, shutil\nroot=Path(sys.argv[1])\nsrc=(root/'base/cores/bench/rtl/ex_stage.sv').read_text()\nfor n in (1, 2, 4):\n    name = f'match_lanes_{n}'\n    width = 32//n\n    dst=root/name\n    (dst/'cores/bench').mkdir(parents=True)\n    shutil.copytree(root/'base/fpga',dst/'fpga')\n    shutil.copytree(root/'base/cores/bench/rtl',dst/'cores/bench/rtl')\n    shutil.copy(root/'base/cores/bench/core.yaml',dst/'cores/bench/core.yaml')\n    patched=src.replace('  logic [3:0]  live_byte_eq, live_byte_eq_q;', f'''  logic [3:0]  live_byte_eq, live_byte_eq_q;\n  logic [{n-1}:0] jalr_match_q;\n  logic          jalr_guard_q;\n  for (genvar lane = 0; lane < {n}; lane++) begin : jalr_match\n    always_ff @(posedge clock) begin\n      if (\"'!stall) begin\n        jalr_match_q[lane] <= fetch_pc[lane*{width} +: {width}]\n                           == ((jalr_sum & 32'\"'hffff_fffe) >> (lane*{width}))[{width-1}:0];\n      end\n    end\n  end'''.replace(\\\"((jalr_sum & 32'hffff_fffe) >> (lane*\\\"+str(width)+\\\"))[\\\"+str(width-1)+\\\":0]\\\", \\\"jalr_masked[lane*\\\"+str(width)+\\\" +: \\\"+str(width)+\\\"]\\\")\n        .replace('  logic          jalr_guard_q;', \\\"  logic          jalr_guard_q;\\\\n  wire [31:0]    jalr_masked = jalr_sum & 32'hffff_fffe;\\\"))\n    patched=patched.replace('  assign fetch_resolution.match_target = match_target_q;', '''  assign fetch_resolution.match_target = match_target_q || (jalr_guard_q && (&jalr_match_q));''')\n    patched=patched.replace('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"', '''      match_target_q      <= \"'!fetch_parked && !in.ctrl.is_jalr && fetch_pc == in.direct_target;\n      jalr_guard_q        <= !fetch_parked && in.ctrl.is_jalr;'\"''')\n    (dst/'cores/bench/rtl/ex_stage.sv').write_text(patched)\nPY\nfor design in match_lanes_1 match_lanes_2 match_lanes_4; do python -m tools.eval.gowin bench --all-options --paths 3 --worktree '/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN'/\\\"\"'$design\" > '\"'/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN'/\\\"\"'$design\".timing; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN' <<'PY'\nfrom pathlib import Path\nimport sys, shutil\nroot=Path(sys.argv[1])\nsrc=(root/'base/cores/bench/rtl/ex_stage.sv').read_text()\nfor name, memo in [('zero_direct', False), ('guard_memo', True)]:\n    dst=root/name\n    (dst/'cores/bench').mkdir(parents=True)\n    shutil.copytree(root/'base/fpga',dst/'fpga')\n    shutil.copytree(root/'base/cores/bench/rtl',dst/'cores/bench/rtl')\n    shutil.copy(root/'base/cores/bench/core.yaml',dst/'cores/bench/core.yaml')\n    add = '''\n  logic jalr_zero_match_q;\n  logic jalr_exact_match;\n  assign jalr_exact_match = in.imm[11:0] == 12'b0 && fetch_pc == {rs1[31:1], 1'b0};\n'''\n    if memo:\n        add += '''\n  logic [31:0] jalr_base_q;\n  logic [11:0] jalr_imm_q;\n  logic [17:0] jalr_target_word_q;\n  logic        jalr_verified_q, jalr_memo_match_q;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      jalr_verified_q <= 1'b0;\n    else if (advance && in.ctrl.is_jalr && target_aligned && target[31:20] == 12'b0) begin\n      jalr_base_q <= rs1;\n      jalr_imm_q <= in.imm[11:0];\n      jalr_target_word_q <= target[19:2];\n      jalr_verified_q <= 1'b1;\n    end\n    if (\"'!stall) begin\n      jalr_memo_match_q <= in.ctrl.is_jalr && !fetch_parked && jalr_verified_q\n                        && in.imm[11:0] == jalr_imm_q\n                        && rs1 == jalr_base_q\n                        && fetch_pc == {12'\"'b0, jalr_target_word_q, 2'b0};\n    end\n  end\n'''\n    patched=src.replace('  logic [3:0]  live_byte_eq, live_byte_eq_q;', '  logic [3:0]  live_byte_eq, live_byte_eq_q;' + add)\n    read = '  assign fetch_resolution.match_target = match_target_q || jalr_zero_match_q' + (' || jalr_memo_match_q;' if memo else ';')\n    patched=patched.replace('  assign fetch_resolution.match_target = match_target_q;', read)\n    patched=patched.replace('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"', '''      match_target_q      <= \"'!fetch_parked && !in.ctrl.is_jalr && fetch_pc == in.direct_target;\n      jalr_zero_match_q   <= !fetch_parked && in.ctrl.is_jalr && jalr_exact_match;'\"''')\n    (dst/'cores/bench/rtl/ex_stage.sv').write_text(patched)\nPY\nfor design in zero_direct guard_memo; do python -m tools.eval.gowin bench --all-options --paths 3 --worktree '/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN'/\\\"\"'$design\" > '\"'/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN'/\\\"\"'$design\".timing; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
