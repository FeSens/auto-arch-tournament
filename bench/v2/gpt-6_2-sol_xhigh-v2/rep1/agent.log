c [2:0] branch_op_q;', '  logic eq_only_q, lt_only_q, invert_branch_q;')\n        s = s.replace('  logic branch_q, jump_q, signs_differ_q, left_negative_q, target_aligned_q;','  logic jump_q, target_aligned_q;')\n        s = s.replace('  logic late_eq, late_lt, late_signed_lt, late_branch_cond;', '  logic late_eq, late_lt, late_branch_cond, compare_sign;')\n        s = s.replace('  assign late_eq = &branch_byte_eq_q;', '''  assign compare_sign = in.ctrl.branch_op == BR_BLT || in.ctrl.branch_op == BR_BGE;\n  assign late_eq = &branch_byte_eq_q;''')\n        a,b = s.index('  assign late_signed_lt'),s.index('  assign fetch_resolution.take_target')\n        s = s[:a]+'''  assign late_branch_cond = (eq_only_q && (late_eq \"'^ invert_branch_q))\n                         || (lt_only_q && (late_lt ''^ invert_branch_q));\n  assign train_taken_q = jump_q || late_branch_cond;\n'\"'''+s[b:]\n        a,b = s.index('    branch_byte_lt_q '),s.index('    jump_q')\n        s = s[:a]+'''    branch_byte_lt_q[2:0]             <= branch_byte_lt[2:0];\n    branch_byte_lt_q[3]               <= compare_sign && (fast_rs1[31] \"'!= fast_rs2[31])\n                                       ? fast_rs1[31] : branch_byte_lt[3];\n    eq_only_q                         <= in.ctrl.is_branch && !in.ctrl.branch_op[2];\n    lt_only_q                         <= in.ctrl.is_branch && in.ctrl.branch_op[2];\n    invert_branch_q                   <= in.ctrl.branch_op[0];\n'\"'''+s[b:]\n    if s \"'!= branch_rtl:\n        p.write_text(s)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
