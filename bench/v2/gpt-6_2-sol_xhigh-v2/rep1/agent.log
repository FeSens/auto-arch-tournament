{"type": "item.completed", "item": {"id": "item_11", "type": "command_execution", "command": "/bin/bash -c \"sed -n '490,635p' cores/bench/test/test_pipeline.py; sed -n '1,100p' cores/bench/test/_helpers.py\"", "aggregated_output": "    # Cold taken miss, correctly predicted taken hit, then taken prediction\n    # on the first not-taken outcome. A squash adds one retirement cycle.\n    assert [rets[i + 1][\"cycle\"] - rets[i][\"cycle\"] for i in (2, 4, 6)] == [2, 1, 2]\n\n\n@cocotb.test()\nasync def same_pc_update_bypasses_new_counter(dut):\n    # Two taken iterations of a self-loop put its counter at 11. The\n    # next instance enters EX as the second taken branch writes the 11.\n    taken, untaken = BEQ(0, 0, 0), BNE(0, 0, 0)\n    loop_fetches = 0\n    imem = {\n        0: ADDI(2, 0, 3),\n        8: ADDI(1, 1, 1),\n        12: BEQ(1, 2, 8),\n        16: JAL(0, -12),\n        20: EBREAK(),\n    }\n\n    def read_instruction(pc, _dmem):\n        nonlocal loop_fetches\n        if pc == 4:\n            loop_fetches += 1\n            return taken if loop_fetches <= 2 else untaken\n        return imem.get(pc, EBREAK())\n\n    rets, _ = await _run(dut, read_instruction)\n    _check_retirements(rets, [0, 4, 4, 4, 8, 12, 16, 4, 8, 12, 16, 4, 8, 12, 20])\n    assert not any(r[\"trap\"] for r in rets)\n    branches = [i for i, r in enumerate(rets) if r[\"pc\"] == 4]\n    assert [rets[i][\"insn\"] for i in branches] == [taken, taken, untaken, untaken, untaken]\n    # The first two untaken outcomes still predict taken (11 -> 10 -> 01).\n    assert [rets[i + 1][\"cycle\"] - rets[i][\"cycle\"] for i in branches] == [2, 1, 2, 2, 1]\n\n\n@cocotb.test()\nasync def same_index_update_checks_tag(dut):\n    # A and B share PC[6:2]. When the hot JAL at A predicts B, its EX\n    # update must count as a miss in B's latched metadata. B then trains\n    # from weakly taken, so one untaken outcome clears the taken prediction.\n    a, b = 0x10, 0x90\n    program = {\n        0x00: ADDI(1, 0, 3),\n        0x04: ADDI(2, 0, 2),\n        0x08: ADDI(3, 0, -1),\n        0x0C: NOP(),\n        a: JAL(0, b - a),\n        b: BEQ(1, 2, 0x20),\n        b + 0x04: ADDI(1, 1, -1),\n        b + 0x08: BEQ(1, 3, 0x20),\n        b + 0x0C: BEQ(1, 2, a - (b + 0x0C)),\n        b + 0x10: JAL(0, -0x10),\n        b + 0x20: ADDI(1, 1, -1),\n        b + 0x24\n…[4294 of 7366 chars elided by tools/bench/transcript.py; sha256:68a5583612808681]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
