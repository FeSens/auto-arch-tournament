ons, fetches=fetches)\n    assert all(0 <= pc < 0x100000 for pc, _, _ in fetches)\n    assert [r['pc'] for r in retirements] == list(instructions)\n    assert [r['pc_next'] for r in retirements if r['pc'] == 0xFFFFC] == [0x20]\nPY\nOPENBLAS_NUM_THREADS=1 python3 -m pytest -q /srv/hwebench/tmp/7cb5c576/6c0d47ec/predictor-r7s2.fyqrwQ/cocotb_retimed32/test > /srv/hwebench/tmp/7cb5c576/6c0d47ec/predictor-r7s2.fyqrwQ/cocotb-retimed32.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
