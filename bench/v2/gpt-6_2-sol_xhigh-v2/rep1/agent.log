egin : largest\n      assign prefix_mask[digit] = \"'!prefix_trials[digit][10];\n    end else begin : smaller\n      assign prefix_mask[digit] = !prefix_trials[digit][10] && prefix_trials[digit+1][10];\n    end\n    assign prefix_remainders[digit] = {6{prefix_mask[digit]}} & prefix_trials[digit][5:0];\n    assign prefix_digits[digit] = {3{prefix_mask[digit]}} & 3'\"'(digit);\n  end\n\n  always_comb begin\n    case (prefix_divisor[2:0])\n      3'd0: prefix_small = {prefix_dividend, 6'd63};\n      3'd1: prefix_small = {6'd0, prefix_dividend};\n      3'd2: prefix_small = {5'b0, prefix_dividend[0], 1'b0, prefix_dividend[5:1]};\n      3'd3: prefix_small = {6'(prefix_dividend % 6'd3), 6'(prefix_dividend / 6'd3)};\n      3'd4: prefix_small = {4'b0, prefix_dividend[1:0], 2'b0, prefix_dividend[5:2]};\n      3'd5: prefix_small = {6'(prefix_dividend % 6'd5), 6'(prefix_dividend / 6'd5)};\n      3'd6: prefix_small = {6'(prefix_dividend % 6'd6), 6'(prefix_dividend / 6'd6)};\n      default: prefix_small = {6'(prefix_dividend % 6'd7), 6'(prefix_dividend / 6'd7)};\n    endcase\n  end\n\n  assign prefix_rem = prefix_remainders[0] | prefix_remainders[1] | prefix_remainders[2]\n                    | prefix_remainders[3] | prefix_remainders[4] | prefix_remainders[5]\n                    | prefix_remainders[6] | prefix_remainders[7];\n  assign prefix_quot = {3'b0, prefix_digits[1] | prefix_digits[2] | prefix_digits[3]\n                    | prefix_digits[4] | prefix_digits[5] | prefix_digits[6] | prefix_digits[7]};\n  assign after_prefix = (|divisor_q[31:6])\n                      ? {26'b0, prefix_dividend, partial_q[25:0], 6'b0}\n                      : (|prefix_divisor[5:3])\n                        ? {26'b0, prefix_rem, partial_q[25:0], prefix_quot}\n                        : {26'b0, prefix_small[11:6], partial_q[25:0], prefix_small[5:0]};\n'''+s[b:]\np.write_text(s)\nprint(sys.argv[1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
