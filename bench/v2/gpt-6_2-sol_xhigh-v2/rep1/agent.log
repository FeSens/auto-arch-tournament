{"type":"item.completed","item":{"id":"item_46","type":"agent_message","text":"The carry-free matcher reached 83.413 MHz in the median placements, below the champion’s 86.757 MHz. The CoreMark trace counted 13,735 JALRs, so I’ll test a registered operand stage for indirect jumps. Its estimated instruction-level cost is about 0.43% of the timed cycles."}}
{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/indirect_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nbase_rtl = (root / 'cores/bench/rtl/ex_stage.sv').read_text()\nfor name in ('indirect-stage', 'indirect-stage-split', 'indirect-stage-range'):\n    src = scratch / name / 'rtl'\n    shutil.copytree(root / 'cores/bench/rtl', src)\n\n    rtl = base_rtl.replace('  logic        is_div, div_start, div_busy, div_valid, div_consume;',\n                           '  logic        is_div, div_start, div_busy, div_valid, div_consume;\\\\n'\n                           '  logic        jalr_wait, jalr_launch, jalr_pending_q;\\\\n'\n                           '  logic [31:0] jalr_rs1_q, jalr_rs2_q;')\n    rtl = rtl.replace('  assign div_wait = is_div && \"'!div_valid;'\"',\n                      '''  assign jalr_wait = in.valid && in.ctrl.is_jalr && \"'!jalr_pending_q;\n  assign jalr_launch = jalr_wait && !stall && !squash_candidate && !load_replay;\n  assign div_wait = (is_div && !div_valid) || jalr_wait;\n\n  always_ff @(posedge clock) begin\n    if (reset || squash_candidate)\n      jalr_pending_q <= 1'\"'b0;\n    else if (jalr_launch)\n      jalr_pending_q <= 1'b1;\n    else if (\"'!stall && !load_replay)\n      jalr_pending_q <= 1'\"'b0;\n\n    if (jalr_launch) begin\n      jalr_rs1_q <= live_rs1;\n      jalr_rs2_q <= live_rs2;\n    end\n  end''')\n    rtl = rtl.replace('  assign jalr_sum = rs1 + in.imm;',\n                      '  assign jalr_sum = jalr_rs1_q + in.imm;')\n    # The actual JALR base is already available on the register-backed\n    # lane above. A load dependency must have replayed before launch.\n    rtl = rtl.replace('      jalr_rs1_q <= live_rs1;', '      jalr_rs1_q <= rs1;')\n    rtl = rtl.replace('div_consume ? div_rs1_q : live_rs1;',\n                      'div_consume ? div_rs1_q : in.ctrl.is_jalr ? jalr_rs1_q : live_rs1;')\n    rtl = rtl.replace('div_consume ? div_rs2_q : live_rs2;',\n                      'div_consume ? div_rs2_q : in.ctrl.is_jalr ? jalr_rs2_q : live_rs2;')\n    if name \"'!= '\"'indirect-stage':\n        rtl = rtl.replace('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"',\n                          \\\"      match_target_q      <= \"'!fetch_parked && (in.ctrl.is_jalr'\"\\\\n\\\"\n                          \\\"                            ? fetch_pc == (jalr_sum & 32'hffff_fffe) : fetch_pc == in.direct_target);\\\")\n    if name == 'indirect-stage-range':\n        rtl = rtl.replace('  assign target_aligned = target[1:0] == 2\\\\'b00;',\n                          '''  logic target_in_range;\n  assign target_aligned = in.ctrl.is_jalr ? \"'!jalr_sum[1] : in.direct_target[1:0] == 2'\"'b00;\n  assign target_in_range = in.ctrl.is_jalr ? jalr_sum[31:20] == 12'b0 : in.direct_target[31:20] == 12'b0;''')\n        rtl = rtl.replace(\\\"target[31:20] == 12'b0\\\", 'target_in_range')\n        rtl = rtl.replace('in.direct_target_in_range', \\\"in.direct_target[31:20] == 12'b0\\\")\n    (src / 'ex_stage.sv').write_text(rtl)\nPY\npython3 \\\"\"'$scratch_probe_dir/indirect_probe.py\" \"$scratch_probe_dir\" &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for option in (1, 2, 0)\n        for design in ('indirect-stage', 'indirect-stage-split', 'indirect-stage-range')\n    }\n    for future in as_completed(futures):\n        result = future.result()\n        print(*futures[future], result.get('fmax_mhz'), result.get('logic'), result.get('reason'),\n              (result.get('critical_paths') or [])[:2], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
