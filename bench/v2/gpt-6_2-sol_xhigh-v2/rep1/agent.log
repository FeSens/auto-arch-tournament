{"type": "item.completed", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c \"rg -n 'bench|reg_q.alu_result|prediction|pc=' cores/bench/LESSONS.md; cat cores/bench/rtl/if_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// The registered request PC drives the direct-mapped BTB. A redirect\n// can issue on imem immediately and bypasses prediction for that response.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              advance_fetch,\n  input  logic              redirect,\n  input  logic [31:0]       redirect_target,\n  input  logic              train,\n  input  logic [17:0]       train_pc,\n  input  logic              train_taken,\n  input  logic              train_jump,\n  output logic [31:0]       request_pc,\n  output logic              request_parked,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [31:0] pc, pc_plus4, redirect_plus4, predicted_pc;\n  logic        parked, park_prediction, park_redirect;\n  logic [4:0]  fetch_index, write_index;\n  logic [12:0] write_tag;\n  logic        fetch_in_range, hit, predict_taken;\n  logic        train_hit, write_target, write_counter;\n  logic [1:0]  train_counter, next_counter;\n\n  logic [31:0] btb_valid;\n  logic [12:0] btb_tag [0:31];\n  logic [17:0] btb_target [0:31];\n  logic [1:0]  btb_counter [0:31];\n\n  assign fetch_index = pc[6:2];\n  assign fetch_in_range = pc[31:20] == 12'b0 && pc[1:0] == 2'b00;\n  assign hit = fetch_in_range && btb_valid[fetch_index] && btb_tag[fetch_index] == pc[19:7];\n  assign predict_taken = hit && btb_counter[fetch_index][1];\n  assign pc_plus4 = pc + 32'd4;\n  assign redirect_plus4 = redirect_target + 32'd4;\n  assign predicted_pc = predict_taken ? {12'b0, btb_target[fetch_index], 2'b00} : pc_plus4;\n  assign park_prediction = !predict_taken && pc == LAST_RAM_WORD;\n  assign park_redirect = redirect_target == LAST_RAM_WORD;\n\n  // Training reads the current metadata at the resolving PC. The request\n  // port still predicts from the table contents before this edge's write.\n  assign {write_tag, write_index} = train_pc;\n  assign train_hit = btb_valid[write_index] && btb_tag[write_index] == write_tag;\n  assign train_counter = btb_counter[write_index];\n  assign write_target = train && train_taken && redirect_target[31:20] == 12'b0;\n  assign write_counter = write_target || (train && !train_jump && train_hit);\n\n  always_comb begin\n    if (train_jump)\n      next_counter = 2'b11;\n    else if (!train_hit)\n      next_counter = 2'b10;\n    else if (train_taken)\n      next_counter = train_counter == 2'b11 ? 2'b11 : train_counter + 2'd1;\n    else\n      next_counter = train_counter == 2'b00 ? 2'b00 : train_counter - 2'd1;\n  end\n\n  // A blocked redirect saves the full address for a normal lookup on\n  // retry. While parked, only validation can restart instruction issue.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= '0;\n      parked <= 1'b0;\n    end else if (redirect) begin\n      pc <= advance_fetch && !park_redirect ? redirect_plus4 : redirect_target;\n      parked <= advance_fetch && park_redirect;\n    end else if (advance_fetch && !parked) begin\n      if (!park_prediction)\n        pc <= predicted_pc;\n      parked <= park_prediction;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      btb_valid <= '0;\n    else if (write_target)\n      btb_valid[write_index] <= 1'b1;\n\n    if (!reset && write_target) begin\n      btb_tag[write_index] <= write_tag;\n      btb_target[write_index] <= redirect_target[19:2];\n    end\n    if (!reset && write_counter)\n      btb_counter[write_index] <= next_counter;\n  end\n\n  assign request_pc = pc;\n  assign request_parked = parked;\n  assign imem_addr = redirect ? redirect_target : pc;\n\n  always_comb begin\n    out.pc       = imem_addr;\n    out.pc_plus4 = redirect ? redirect_plus4 : pc_plus4;\n    out.instr    = imem_data;\n    out.valid    = advance_fetch && (redirect || !parked);\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
