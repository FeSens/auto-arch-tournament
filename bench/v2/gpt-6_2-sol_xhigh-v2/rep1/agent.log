{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-lane-probe/arithmetic.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\ntarget = Path('cores/bench/rtl')\nroot = Path(sys.argv[1])\ndef new(name, base=target):\n    path = root / name\n    shutil.copytree(base, path)\n    return path\n\ndef segment_fn(name, width, count, subtract=False, aug=False):\n    pre = f'  function automatic logic [{width-1}:0] {name}(input logic [{width-1}:0] a, b);\\\\n'\n    body = []\n    declaration = []\n    shift = 0\n    groups = []\n    while shift < width:\n        bits = min(count, width - shift)\n        groups.append((shift, bits))\n        shift += bits\n    for i, (lo, bits) in enumerate(groups):\n        idx = f'[{lo} +: {bits}]'\n        lhs, rhs = f'a{idx}', f'b{idx}'\n        if i \"'!= len(groups)-1:\n            declaration.extend([f'\"'logic g{i};', f'logic p{i};'] if i else [f'logic g{i};'])\n            if subtract:\n                body.append(f'g{i} = {lhs} < {rhs};')\n                if i: body.append(f'p{i} = {lhs} == {rhs};')\n            else:\n                body.append(f'g{i} = {lhs} > ~{rhs};')\n                if i: body.append(f'p{i} = {lhs} == ~{rhs};')\n        if i:\n            declaration.append(f'logic c{i};')\n            cond = ' | '.join(\n                ('(' if j < i-1 else '') + ' & '.join([f'g{j}']+[f'p{k}' for k in range(j+1,i)])\n                + (')' if j < i-1 else '') for j in range(i))\n            body.append(f'c{i} = {cond};')\n        op = '-' if subtract else '+'\n        if i and aug:\n            # Force the carry-in to enter at the bottom of the carry chain.\n            body.append(f'{{{name}{idx}, unused{ i }}} = {{{lhs}, c{i}}} {op} {{{rhs}, 1\\\\'b0}};')\n            if subtract:\n                body[-1] = f'{{{name}{idx}, unused{i}}} = {{{lhs}, 1\\\\'b0}} - {{{rhs}, c{i}}};'\n            else:\n                body[-1] = f'{{{name}{idx}, unused{i}}} = {{{lhs}, c{i}}} + {{{rhs}, 1\\\\'b1}};'\n            declaration.append(f'logic unused{i};')\n        else:\n            body.append(f'{name}{idx} = {lhs} {op} {rhs}' + (f\\\" {op} {bits}'(c{i})\\\" if i else '') + ';')\n    return pre + ''.join(f'    {line}\\\\n' for line in (declaration+body)) + '  endfunction\\\\n\\\\n'\n\ndef segmented(name, width, jwidth=None, aug=False):\n    path = new(name)\n    alu = path / 'alu.sv'\n    source = alu.read_text()\n    split = source.index('  function automatic [63:0] radix4_step(')\n    head, tail = source[:split], source[split:]\n    tail = tail.replace('shifted - {3\\\\'b0, divisor}', 'trial_sub(shifted, {3\\\\'b0, divisor})').replace(\n        'shifted - {2\\\\'b0, divisor, 1\\\\'b0}', 'trial_sub(shifted, {2\\\\'b0, divisor, 1\\\\'b0})').replace(\n        'shifted - {1\\\\'b0, triple_divisor}', 'trial_sub(shifted, {1\\\\'b0, triple_divisor})')\n    alu.write_text(head + segment_fn('trial_sub', 35, width, True, aug) + tail)\n    if jwidth:\n        ex = path / 'ex_stage.sv'\n        ex.write_text(ex.read_text().replace('  assign jalr_sum = rs1 + in.imm;',\n          segment_fn('target_add', 32, jwidth, False, aug) + '  assign jalr_sum = target_add(rs1, in.imm);'))\n\nsegmented('borrow7', 7)\nsegmented('borrow8-target8', 8, 8, aug=True)\n\ndef radix16():\n    path = new('radix16')\n    alu = path / 'alu.sv'\n    source = alu.read_text()\n    start = source.index('  function automatic [63:0] radix4_step(')\n    end = source.index('  assign signed_div', start)\n    extra = '''\n  logic [35:0] odd_multiple_q [1:7];\n  wire [35:0] full_d = {4'b0, divisor_q};\n  logic [36:0] shifted_radix16;\n  logic [36:0] trial16 [0:15];\n  logic [31:0] next_remainder;\n  logic [15:0] accepts;\n  logic [15:0] digit_pick;\n  logic [3:0] next_digit;\n\n  assign shifted_radix16 = {1'b0, partial_q[63:28]};\n  assign trial16[0] = shifted_radix16;\n  assign accepts[0] = 1'b1;\n  for (genvar digit = 1; digit < 16; digit++) begin : radix16_trials\n    localparam int SHIFT = digit % 2 ? 0 : digit % 4 ? 1 : digit % 8 ? 2 : 3;\n    localparam int HALF_ODD = digit >> (SHIFT + 1);\n    wire [35:0] multiple = HALF_ODD == 0 ? (full_d << SHIFT) : (odd_multiple_q[HALF_ODD] << SHIFT);\n    assign trial16[digit] = shifted_radix16 - {1'b0, multiple};\n    assign accepts[digit] = \"'!trial16[digit][36];\n  end\n  assign digit_pick = accepts & {1'\"'b1, ~accepts[15:1]};\n  for (genvar bit_index = 0; bit_index < 32; bit_index++) begin : pick_remainder\n    wire [15:0] terms;\n    for (genvar digit = 0; digit < 16; digit++) begin : digit_terms\n      assign terms[digit] = digit_pick[digit] & trial16[digit][bit_index];\n    end\n    assign next_remainder[bit_index] = |terms;\n  end\n  assign next_digit = {|(digit_pick & 16'hff00), |(digit_pick & 16'hf0f0),\n                       |(digit_pick & 16'hcccc), |(digit_pick & 16'haaaa)};\n\n  function automatic logic [35:0] add3(input logic [35:0] a, b, c);\n    add3 = (a \"'^ b ''^ c) + (((a & b) | (a & c) | (b & c)) << 1);\n  endfunction\n\n  always_ff @(posedge clock) begin\n    if (div_phase_q == 4'\"'d8) begin\n      odd_multiple_q[1] <= (full_d << 1) + full_d;\n      odd_multiple_q[2] <= (full_d << 2) + full_d;\n      odd_multiple_q[3] <= (full_d << 3) - full_d;\n      odd_multiple_q[4] <= (full_d << 3) + full_d;\n      odd_multiple_q[5] <= add3(full_d << 3, full_d << 1, full_d);\n      odd_multiple_q[6] <= add3(full_d << 3, full_d << 2, full_d);\n      odd_multiple_q[7] <= (full_d << 4) - full_d;\n    end\n  end\n'''\n    source = source[:end] + extra + source[end:]\n    source = source.replace('after_radix4_b = radix4_step(after_radix4_a, divisor_q, triple_divisor_q);',\n                            'after_radix4_b = {next_remainder, partial_q[27:0], next_digit};')\n    alu.write_text(source)\n\nradix16()\nPY\npython3 \\\"\"'$TMPDIR/bench-lane-probe/arithmetic.py\" \"$TMPDIR/bench-lane-probe\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
