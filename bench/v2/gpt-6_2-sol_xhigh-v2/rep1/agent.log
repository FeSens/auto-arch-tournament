d pc==prev_target:\n                pred=seq\n            prev_need=pred!=tgt\n            prev_target=tgt\n            if prev_need: counts[opcode]+=1\n        print(bits,mode,sum(counts.values()),dict(counts))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
