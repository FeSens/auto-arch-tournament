EAK()\\\", \\\"0x10: EBREAK()\\\").replace(\\\"0x14: SW\\\", \\\"0x34: SW\\\").replace(\\\"0x18: JAL(0, -0x18)\\\", \\\"0x38: JAL(0, -0x38)\\\")\nchanged = changed.replace(\\\"if pc == 0x10:\\\", \\\"if pc == 0x30:\\\").replace(\\\"JAL(0, 0x0C)\\\", \\\"JAL(0, 0x2C)\\\")\nchanged = changed.replace(\\\"[0, 0x10, 0x14, 0x18, 0, 4, 8, 12]\\\", \\\"[0, 4, 0x30, 0x34, 0x38, 0, 4, 8, 12, 16]\\\").replace(\\\"rets[4:6]\\\", \\\"rets[6:8]\\\").replace(\\\"(4, False, False)\\\", \\\"(8, False, False)\\\")\nadd = add[:start] + changed + add[end:]\ns = s.replace(\\\"\\\\ndef test_pipeline_runner():\\\", \\\"\\\\n\\\" + add + \\\"\\\\ndef test_pipeline_runner():\\\")\np.write_text(s)\nPY\ncd \\\"\"'$TMPDIR/bench-r5s2-compact/cores/bench\"\npython3 -m pytest -q test/ > \"$TMPDIR/bench-r5s2-compact/pytest.log\" 2>&1'", "aggregated_output": "", "exit_code": 0, "status": "completed"}}
