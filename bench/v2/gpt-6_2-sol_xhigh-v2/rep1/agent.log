{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nroot=Path(sys.argv[1])\nfor name, source in [('predicted_replay_en', 'base'),('page_predicted_replay_en','split_shared')]:\n    dst=root/name\n    (dst/'cores/bench').mkdir(parents=True)\n    shutil.copytree(root/'base/fpga',dst/'fpga')\n    shutil.copytree(root/source/'cores/bench/rtl',dst/'cores/bench/rtl')\n    shutil.copy(root/'base/cores/bench/core.yaml',dst/'cores/bench/core.yaml')\n    path=dst/'cores/bench/rtl/if_stage.sv'\n    txt=path.read_text()\n    txt=txt.replace('  logic [9:0]    replay_write_index_q;', '''  logic [9:0]    replay_write_index_q;\n  logic [9:0]    replay_next_index;\n  logic          replay_advance, replay_retry;''')\n    txt=txt.replace('  always_ff @(posedge clock) begin\\\\n    {replay_tag, replay_word} <= replay_entry[normal_pc_d[11:2]];', '''  assign replay_advance = reset || squash_candidate ||\n                          (ordinary_accept && (\"'!ordinary_last || predict_taken));\n  assign replay_retry = !replay_advance && replay_collision;\n  for (genvar i = 0; i < 10; i++) begin : select_replay_index\n    assign replay_next_index[i] = |{\n        (ordinary_active && !predict_taken)       & ordinary_plus4[i + 2],\n        (ordinary_active && predict_on_table)     & table_target[i + 2],\n        (ordinary_active && predict_on_bypass)    & bypass_target[i + 2],\n        select_target                            & fetch_resolution.target[i + 2],\n        select_target_plus4                      & target_plus4[i + 2],\n        select_fallthrough                       & fetch_resolution.fallthrough[i + 2],\n        select_fallthrough_plus4                 & fallthrough_plus4[i + 2]};\n  end\n\n  always_ff @(posedge clock) begin\n    if (replay_advance || replay_retry)\n      {replay_tag, replay_word} <=