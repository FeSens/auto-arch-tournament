{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r10-fetch-narrow.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\n\nscratch = Path(os.environ['TMPDIR'])\ncode = (scratch / 'bench-r10-fetch-trials.py').read_text()\nexec(code[:code.index('cases = {')])\n\ndef bank_width(s, slot_bits):\n    bank_bits = 10 - slot_bits\n    split = 2 + slot_bits\n    banks = 1 << bank_bits\n    rows = 1 << slot_bits\n    s = s.replace('[31:0]   replay_bank_valid_q', f'[{banks-1}:0]   replay_bank_valid_q')\n    start = s.index('  logic [31:0]   replay_valid_slots')\n    end = s.index('  logic          replay_bitmap_write', start)\n    s = s[:start] + f'''  logic [{rows-1}:0]   replay_valid_slots [0:{banks-1}];\n  logic [{rows-1}:0]   replay_read_slots_q, replay_update_slots_q, replay_last_slots_q;\n  logic [{rows-1}:0]   replay_slots_read, replay_slots_update, replay_slots_write;\n  logic [{bank_bits-1}:0]    replay_read_bank, replay_write_bank, replay_last_bank_q;\n''' + s[end:]\n    start = s.index('  assign replay_read_bank')\n    end = s.index('  always_ff @(posedge clock) begin\\\\n    if (reset || fetch_resolution.refetch)\\\\n      replay_armed_q', start)\n    section = s[start:end]\n    for old, new in {\n        '[11:7]': f'[11:{split}]', '[9:5]': f'[9:{slot_bits}]',\n        '[4:0]': f'[{slot_bits-1}:0]', '[6:2]': f'[{split-1}:2]',\n        \\\"32'b0\\\": f\\\"{rows}'b0\\\", \\\"32'b1\\\": f\\\"{rows}'b1\\\", '[31:0]   replay_slots_read': f'[{rows-1}:0]   replay_slots_read',\n    }.items():\n        section = section.replace(old, new)\n    return s[:start] + section + s[end:]\n\ndef scalar_narrow(s, slot_bits):\n    s = scalar_bitmap(s)\n    old = '  logic [31:0]   replay_slots_update, replay_slots_write;\\\\n  logic          replay_slot_valid;'\n    s = s.replace(old, '  logic [31:0]   replay_slots_read, replay_slots_update, replay_slots_write;\\\\n  logic          replay_slot_valid;')\n    s = bank_width(s, slot_bits)\n    return s.replace('replay_slots_read, replay_slots_update, replay_slots_write;', 'replay_slots_update, replay_slots_write;').replace('  logic          replay_bitmap_write,', '  logic          replay_slot_valid;\\\\n  logic          replay_bitmap_write,')\n\ndef two_level(s):\n    s = offset_pc(s)\n    prior = '  logic ordinary_move, ordinary_hold;'\n    s = s.replace(prior, prior + '\\\\n  logic [31:0] recovered_pc;')\n    a = s.index('  assign normal_pc_d')\n    b = s.index('  always_ff', a)\n    return s[:a] + '''  assign recovered_pc = ({32{recover_target}} & target_pc_d)\n                      | ({32{recover_fallthrough}} & fallthrough_pc_d);\n  assign normal_pc_d = ({32{ordinary_move}} & ordinary_predicted_pc)\n                     | ({32{ordinary_hold}} & normal_pc_q)\n                     | ({32{\"'!reset}} & recovered_pc);\n'\"''' + s[b:]\n\ndef pcs_lookahead(s):\n    s = two_level(s)\n    s = s.replace('  logic [31:0] recovered_pc;', '  logic [31:0] recovered_pc;\\\\n  logic [15:0] ordinary_pc_hi_plus1;')\n    s = s.replace('  assign ordinary_plus4 = normal_pc_q + 32\\\\'d4;', '''  assign ordinary_pc_hi_plus1 = normal_pc_q[31:16] + 16'd1;\n  assign ordinary_plus4 = {(&normal_pc_q[15:2]) ? ordinary_pc_hi_plus1 : normal_pc_q[31:16],\n                           normal_pc_q[15:2] + 14'd1, normal_pc_q[1:0]};''')\n    return s\n\ncases = {\n    '8slots': lambda s: flat_pc(scalar_narrow(s, 3)),\n    '16slots': lambda s: flat_pc(scalar_narrow(s, 4)),\n    '64slots': lambda s: flat_pc(scalar_narrow(s, 6)),\n    'two-level': lambda s: two_level(scalar_bitmap(s)),\n    'lookahead': lambda s: pcs_lookahead(scalar_bitmap(s)),\n}\nexec(code[code.index('for name, transform in cases.items():'):])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-fetch-narrow.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
