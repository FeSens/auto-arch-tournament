{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"command -v riscv32-unknown-elf-gcc; python3 -c 'import cocotb, pytest, yaml; print(cocotb.__version__)'; sed -n '875,1135p' cores/bench/test/test_pipeline.py; sed -n '1,200p' tools/eval/cosim.py; du -sh formal/riscv-formal/\"", "aggregated_output": "/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\n2.0.1\n        [(0x20, True, True)] + corrected + [(12, True, True)]\n    )\n\n\n@cocotb.test()\nasync def recovery_waits_for_older_store_then_overrides_imem_stall(dut):\n    program = [ADDI(1, 0, 1), SW(1, 0, 0x40), BNE(1, 0, 8),\n               SW(1, 0, 0x44), SW(1, 0, 0x48), EBREAK()]\n    writes, fetches = [], []\n    stall_cycles = 4\n    rets, dmem = await _run(\n        dut, program, store_stall_cycles=stall_cycles, stall_imem_with_mem=True,\n        writes=writes, fetches=fetches,\n    )\n    _check_retirements(rets, [0, 4, 8, 16, 20])\n    assert not any(r[\"trap\"] for r in rets)\n    assert rets[2][\"rs1_rdata\"] == 1  # held MEM/WB forwarding value\n    assert writes == [(0x40, 0xF, 1), (0x48, 0xF, 1)]\n    assert dmem == {0x40: 1, 0x48: 1}\n    start = fetches.index((12, False, False))\n    assert fetches[start:start + stall_cycles + 2] == (\n        [(12, False, False)] * stall_cycles + [(12, False, True), (16, True, True)]\n    )\n\n\n@cocotb.test()\nasync def target_replay_persists_and_refreshes_ready_words(dut):\n    target = 0x40\n    stream = list(range(target, target + 40 * 4, 4))\n    refresh_pc = stream[16]\n    count_pc = stream[-1] + 4\n    branch = count_pc + 4\n    program = {pc: ADDI(5, 5, 1) for pc in stream}\n    program.update({\n        0: ADDI(2, 0, 3),\n        4: JAL(0, target - 4),\n        count_pc: ADDI(1, 1, 1),\n        branch: BNE(1, 2, target - branch),\n        branch + 4: EBREAK(),\n    })\n    passes = 0\n\n    def read_instruction(pc, _dmem):\n        if passes == 1 and pc == refresh_pc:\n            return ADDI(5, 5,