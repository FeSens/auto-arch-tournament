{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-lane-probe/lookahead.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path(sys.argv[1])\nrtl = Path('cores/bench/rtl')\nfor name in ('lookahead', 'lookahead-epoch'):\n    out = root / name\n    shutil.copytree(rtl, out)\n    path = out / 'if_stage.sv'\n    src = path.read_text()\n    src = src.replace('  logic          replay_write_q;', '''  logic          replay_write_q;\n  logic          replay_retry, replay_ordinary, replay_hold_response_q;\n  logic [9:0]    replay_lookup_index;\n  logic [7:0]    held_replay_tag_q;\n  logic [31:0]   held_replay_word_q;\n  logic          held_replay_slot_q, replay_slot_live;\n  logic [7:0]    lookup_tag;\n  logic [31:0]   lookup_word;''')\n    key = '  assign replay_collision ='\n    at = src.index(key)\n    src = src[:at] + '''  // The synchronous read speculates that this beat advances. If ID or\n  // imem stalls, retain the current response separately from the RAM.\n  assign replay_retry = \"'!squash_candidate && (replay_collision &&\n                        (!imem_ready || !ordinary_can_accept));\n  assign replay_ordinary = !reset && !squash_candidate && !replay_retry;\n  for (genvar i = 0; i < 10; i++) begin : select_replay_index\n    assign replay_lookup_index[i] = |{\n      (replay_ordinary && !predict_taken && !ordinary_last) & ordinary_plus4[i+2],\n      (replay_ordinary && predict_on_table) & table_target[i+2],\n      (replay_ordinary && predict_on_bypass) & bypass_target[i+2],\n      (!reset && (replay_retry || (replay_ordinary && !predict_taken && ordinary_last))) & normal_pc_q[i+2],\n      select_target & fetch_resolution.target[i+2],\n      select_target_plus4 & target_plus4[i+2],\n      select_fallthrough & fetch_resolution.fallthrough[i+2],\n      select_fallthrough_plus4 & fallthrough_plus4[i+2]};\n  end\n\n  always_ff @(posedge clock) begin\n    replay_hold_response_q <= !reset && !squash_candidate && !ordinary_accept && !replay_retry;\n    if (!replay_hold_response_q && !ordinary_accept && !replay_retry) begin\n      held_replay_tag_q <= lookup_tag;\n      held_replay_word_q <= lookup_word;\n      held_replay_slot_q <= replay_slot_live;\n    end\n  end\n  assign replay_tag = replay_hold_response_q ? held_replay_tag_q : lookup_tag;\n  assign replay_word = replay_hold_response_q ? held_replay_word_q : lookup_word;\n  assign replay_slot_valid = replay_hold_response_q ? held_replay_slot_q : replay_slot_live;\n\n'\"''' + src[at:]\n    src = src.replace('  assign replay_slot_valid = replay_bitmap_write_q', '  assign replay_slot_live = replay_bitmap_write_q')\n    src = src.replace('{replay_tag, replay_word} <= replay_entry[normal_pc_d[11:2]];', '{lookup_tag, lookup_word} <= replay_entry[replay_lookup_index];')\n    src = src.replace('replay_valid_slots[normal_pc_d[11:7]];','replay_valid_slots[replay_lookup_index[9:5]];')\n    if name == 'lookahead-epoch':\n        src = src.replace('  logic [31:0]   replay_bank_valid_q;', '''  logic [3:0]  replay_epoch_q, lookup_epoch, held_replay_epoch_q, observed_epoch;\n  logic        scrub_q;\n  logic [9:0]  scrub_index_q;\n  logic        ram_write;\n  logic [9:0]  ram_write_index;\n  logic [43:0] ram_write_data;''')\n        for line in ('replay_valid_slots','replay_read_slots_q','replay_slots_update','replay_read_bank',\n                     'replay_last_bank_q','replay_bitmap_write','held_replay_slot_q'):\n            src = '\\\\n'.join(x for x in src.split('\\\\n') if not (x.startswith('  logic ') and line in x))\n        src = src.replace('[39:0]   replay_entry', '[43:0]   replay_entry').replace('replay_collision, replay_slot_valid, replay_eligible','replay_collision')\n        src = src.replace('held_replay_slot_q <= replay_slot_live;', 'held_replay_epoch_q <= lookup_epoch;')\n        src = src[:src.index('  assign replay_slot_valid')] + src[src.index('  assign replay_collision'):]\n        start = src.index('  assign replay_read_bank')\n        stop = src.index('  // Refresh', start)\n        src = src[:start] + '''  assign observed_epoch = replay_hold_response_q ? held_replay_epoch_q : lookup_epoch;\n  assign replay_hit = \"'!scrub_q && replay_armed_q && ordinary_in_range\n                    && {observed_epoch, replay_tag} == {replay_epoch_q, normal_pc_q[19:12]}\n                    && !replay_collision;\n  assign ram_write = (scrub_q && !reset) || replay_fill;\n  assign ram_write_index = scrub_q ? scrub_index_q : pc[11:2];\n  assign ram_write_data = scrub_q ? 44'\"'b0 : {replay_epoch_q, pc[19:12], imem_data};\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      replay_epoch_q <= 4'd1;\n      scrub_q <= 1'b1;\n      scrub_index_q <= 10'd0;\n    end else if (fetch_resolution.refetch && replay_epoch_q == 4'd15) begin\n      replay_epoch_q <= 4'd1;\n      scrub_q <= 1'b1;\n      scrub_index_q <= 10'd0;\n    end else begin\n      if (fetch_resolution.refetch)\n        replay_epoch_q <= replay_epoch_q + 4'd1;\n      if (scrub_q) begin\n        scrub_index_q <= scrub_index_q + 10'd1;\n        scrub_q <= \"'!(&scrub_index_q);\n      end\n    end\n  end\n'\"''' + src[stop:]\n        src = src.replace('assign replay_fill = \"'!reset'\"', 'assign replay_fill = \"'!scrub_q && !reset'\"')\n        start = src.index('    {lookup_tag, lookup_word}')\n        stop = src.index('\\\\n  always_ff @(posedge clock) begin\\\\n    if (reset || fetch_resolution.refetch)', start)\n        src = src[:start] + '''    {lookup_epoch, lookup_tag, lookup_word} <= replay_entry[replay_lookup_index];\n    if (ram_write)\n      replay_entry[ram_write_index] <= ram_write_data;\n    replay_write_q <= ram_write;\n    replay_write_index_q <= ram_write_index;\n  end\n''' + src[stop:]\n    if name == 'lookahead-epoch':\n        # A response sampled before its slot was scrubbed might survive a\n        # long held request. Mark that snapshot invalid until the beat moves.\n        src = src.replace('held_replay_epoch_q <= lookup_epoch;', \\\"held_replay_epoch_q <= scrub_q ? 4'd0 : lookup_epoch;\\\")\n    path.write_text(src)\nPY\npython3 \\\"\"'$TMPDIR/bench-lane-probe/lookahead.py\" \"$TMPDIR/bench-lane-probe\"\npython3 \"$TMPDIR/bench-lane-probe/time.py\" lookahead,1 lookahead-epoch,1 reset-mem,0 reset-mem,2'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-lane-probe/check.py\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nsys.path.insert(0, os.getcwd())\nfrom tools.eval.cosim import run_one, TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart\n\nroot = Path(os.environ['TMPDIR']) / 'bench-lane-probe'\nprograms = root / 'programs-root/bench/programs'\ndef run(name):\n    out = root / f'{name}-cosim'\n    sim = str(out / 'cosim_sim')\n    if not Path(sim).is_file():\n        with (root / f'{name}-cosim.log').open('w') as log:\n            subprocess.run(['bash', 'test/cosim/build.sh'],\n                env={**os.environ, 'NRET':'1', 'RTL_DIR':str(root/name), 'OBJ_DIR':str(out)},\n                stdout=log, stderr=subprocess.STDOUT, check=True)\n    elf = programs / 'coremark.elf'\n    result = subprocess.run([sim, str(elf), '50000000', '--bench', '--istall', '--dstall'], capture_output=True, check=True, text=True)\n    marker = json.loads(result.stdout.strip().splitlines()[-1])\n    assert marker['ebreak'] and not marker['oob'] and marker['bench_bracketed'], marker\n    valid, reason = validate_coremark_uart(marker['uart'], 10)\n    assert valid, reason\n    cycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\n    print(name, f'{cycles} cycles, canonical CRCs', flush=True)\n    for test in sorted(programs.glob('*.elf')):\n        if test \"'!= elf:\n            for mode in TRACE_STALL_MODES:\n                check = run_one(test, sim, '\"'.', sim_flags=mode)\n                assert check['passed'], (name, check)\n    print(name, 'all eight short RVFI cosim cases passed', flush=True)\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    list(executor.map(run, sys.argv[1:]))\nPY\npython3 \\\"\"'$TMPDIR/bench-lane-probe/check.py\" lookahead lookahead-epoch reset-mem imm12-data'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
