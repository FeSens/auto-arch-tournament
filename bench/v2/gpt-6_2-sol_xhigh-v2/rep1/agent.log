{"type": "item.completed", "item": {"id": "item_83", "type": "command_execution", "command": "/bin/bash -c \"sed -n '895,1010p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    assert fetches[start:start + stall_cycles + 2] == (\n        [(12, False, False)] * stall_cycles + [(12, False, True), (16, True, True)]\n    )\n\n\n@cocotb.test()\nasync def target_replay_persists_and_refreshes_ready_words(dut):\n    target = 0x40\n    stream = list(range(target, target + 40 * 4, 4))\n    refresh_pc = stream[16]\n    count_pc = stream[-1] + 4\n    branch = count_pc + 4\n    program = {pc: ADDI(5, 5, 1) for pc in stream}\n    program.update({\n        0: ADDI(2, 0, 3),\n        4: JAL(0, target - 4),\n        count_pc: ADDI(1, 1, 1),\n        branch: BNE(1, 2, target - branch),\n        branch + 4: EBREAK(),\n    })\n    passes = 0\n\n    def read_instruction(pc, _dmem):\n        if passes == 1 and pc == refresh_pc:\n            return ADDI(5, 5, 2)\n        return program.get(pc, NOP())\n\n    def imem_wait(pc, _dmem):\n        nonlocal passes\n        if pc == branch:\n            passes += 1\n        return passes > 0 and pc in stream and (passes != 1 or pc != refresh_pc)\n\n    fetches = []\n    rets, _ = await _run(dut, read_instruction, imem_wait=imem_wait, fetches=fetches)\n    body = stream + [count_pc, branch]\n    _check_retirements(rets, [0, 4] + body * 3 + [branch + 4])\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == stream[-1]] == [40, 81, 122]\n\n    # The first redirect waits for imem on the recovery cycle. Replay then\n    # supplies the long stream and picks up the ready word for the next lap.\n    start = fetches.index((target, False, True))\n    expected = [(target, False, True)] + [(pc, pc == refresh_pc, True) for pc in stream]\n    expected += [(count_pc, True, True), (branch, True, True)]\n    expected += [(pc, False, True) for pc in stream]\n    assert fetches[start:start + len(expected)] == expected\n\n\n@cocotb.test()\n@cocotb.parametrize(tag_bit=range(12, 20))\nasync def target_replay_checks_full_tag(dut, tag_bit):\n    a = 0xE40\n    b = a + (1 << tag_bit)  # Same replay index, different tags.\n    program = {\n        0: JAL(0, a),\n        a: ADDI(1, 0, 7),\n        a + 4: JAL(0, (b - 4) - (a + 4)),\n        b - 4: NOP(),\n        b: ADDI(1, 0, 19),\n        b + 4: EBREAK(),\n    }\n\n    fetches = []\n    rets, _ = await _run(dut, program, imem_stalls={b: 2}, fetches=fetches)\n    _check_retirements(rets, [0, a, a + 4, b - 4, b, b + 4])\n    assert rets[-2][\"rd_wdata\"] == 19\n    assert [f for f in fetches if f[0] == b] == [(b, False, True)] * 2 + [(b, True, True)]\n\n\n@cocotb.test()\n@cocotb.parametrize(spacing=[512, 1024, 2048, 4096])\nasync def target_replay_read_while_filling(dut, spacing):\n    a = 0xA40\n    b = a ^ spacing\n    same_index = spacing == 4096\n    program = {\n        0: JAL(0, a - 4),\n        a - 4: NOP(),\n        a: JAL(0, b - a),\n        b: ADDI(1, 1, 1),\n        b + 4: ADDI(2, 0, 2),\n        b + 8: BEQ(1, 2, 8),\n        b + 12: JAL(0, (a - 4) - (b + 12)),\n        b + 16: EBREAK(),\n    }\n    b_requests = 0\n\n    def imem_wait(pc, _dmem):\n        nonlocal b_requests\n        if pc != b:\n            return False\n        b_requests += 1\n        return b_requests in (2, 3) if same_index else b_requests > 1\n\n    fetches = []\n    rets, _ = await _run(dut, program, imem_wait=imem_wait, fetches=fetches)\n    _check_retirements(rets, [0, a - 4, a, b, b + 4, b + 8, b + 12,\n                              a - 4, a, b, b + 4, b + 8, b + 16])\n    # The second visit fills A and reads B on the same edge. A read at the\n    # same index must wait for the bus even if RAM returns the old B word.\n    start = fetches.index((b, False, True)) - 1\n    expected = [(a, True, True), (b, False, True)]\n    if same_index:\n        expected += [(b, False, True), (b, True, True)]\n    expected.append((b + 4, True, True))\n    assert fetches[start:start + len(expected)] == expected\n\n\n@cocotb.test()\nasync def fence_i_invalidates_replay_and_refetches_younger_word(dut):\n    fence, patched = 0x40, 0x44\n    old_word, new_word = ADDI(5, 0, 7), ADDI(5, 0, 19)\n    program = {\n        0: JAL(0, fence),\n        0x48: BNE(1, 0, 0x60 - 0x48),\n        0x4C: ADDI(1, 0, 1),\n", "exit_code": 0, "status": "completed"}}
