,\n    'id_stage.sv':['      reg_q.load_eq_branch <= dec_is_branch && \"'!dec_branch_op[2];'\"\\\\n'],\n}.items():\n    p=rtl/filename\n    src=p.read_text()\n    for needle in needles:\n        src=src.replace(needle, needle.replace(', mem_word_load','').replace(', fwd_load_word_rs1','') if needle.startswith('  logic ') else '')\n    p.write_text(src)\np=rtl/'mem_stage.sv'\np.write_text(Path('cores/bench/rtl/mem_stage.sv').read_text())\nPY\npython3 \\\"\"'$scratch/arithmetic-replay.py\" \"$scratch/arithmetic-replay\"\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
