{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/shift-study\"\ncat > \"$TMPDIR/shift-study/probe.py\" <<'\"'PY'\nimport os\nfrom pathlib import Path\nimport shutil\nimport sys\n\nbench = Path(\\\"cores/bench/rtl\\\")\nroot = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"shift-study\\\"\nname, split = sys.argv[1], int(sys.argv[2])\ndst = root / name / \\\"rtl\\\"\nshutil.copytree(bench, dst, dirs_exist_ok=True)\n\ndef edit(filename, old, new):\n    p = dst / filename\n    src = p.read_text()\n    assert src.count(old) == 1, (filename, old, src.count(old))\n    p.write_text(src.replace(old, new))\n\ndef levels(begin, end, namespace, data, amount, fill):\n    code = []\n    for i in range(begin, end):\n        bits = 2**i\n        step = f\\\"{namespace}_{i}\\\"\n        code.append(f\\\"  assign {step} = {amount}[{i-begin}] ? {{{{{bits}{{{fill}}}}}, {data}[31:{bits}]}} : {data};\\\")\n        data = step\n    return code, data\n\nedit(\\\"core_pkg.sv\\\", \\\"  // EX/MEM register payload.\\\", f\\\"\\\"\\\"  typedef struct packed {{\n    logic [31:0] data;\n    logic [{4-split}:0] amount;\n    logic fill;\n    logic left;\n  }} shift_state_t;\n\n  function automatic logic [31:0] finish_shift(input shift_state_t state);\n    logic [31:0] data;\n    begin\n      data = state.data;\n\\\"\\\"\\\" + \\\"\\\\n\\\".join(\n        f\\\"      if (state.amount[{i-split}]) data = {{{{{2**i}{{state.fill}}}}, data[31:{2**i}]}};\\\"\n        for i in range(split, 5)) + \\\"\\\"\\\"\n      for (integer i = 0; i < 32; i = i + 1)\n        finish_shift[i] = state.left ? data[31-i] : data[i];\n    end\n  endfunction\n\n  // EX/MEM register payload.\\\"\\\"\\\")\nedit(\\\"core_pkg.sv\\\", \\\"logic [31:0] shift_result;\\\", \\\"shift_state_t shift_state;\\\")\nedit(\\\"alu.sv\\\", \\\"  output logic [31:0] shift_result,\\\", \\\"  output shift_state_t shift_state,\\\")\norig_shifter = \\\"\\\"\\\"  always_comb begin\n    case (op)\n      ALU_SLL:    shift_result = a << shamt;\n      ALU_SRA:    shift_result = \"'$unsigned($signed(a) >>> shamt);\n      default:    shift_result = a >> shamt;\n    endcase\n  end\"\"\"\nstage, data = levels(0, split, \"fine\", \"right_in\", \"shamt\", \"shift_fill\")\nedit(\"alu.sv\", orig_shifter, \"\"\"  logic shift_left, shift_fill;\n  logic [31:0] right_in;\n\"\"\" + \"'\"\\\\n\\\".join(f\\\"  logic [31:0] fine_{i};\\\" for i in range(split)) + \\\"\\\"\\\"\n  assign shift_left = op == ALU_SLL;\n  assign shift_fill = op == ALU_SRA && a[31];\n  for (genvar i = 0; i < 32; i++) begin : reverse_shift\n    assign right_in[i] = shift_left ? a[31-i] : a[i];\n  end\n\\\"\\\"\\\" + \\\"\\\\n\\\".join(stage) + f\\\"\\\"\\\"\n  assign shift_state = {{ {data}, shamt[4:{split}], shift_fill, shift_left }};\n\\\"\\\"\\\")\nedit(\\\"alu.sv\\\", \\\"ALU_SLL, ALU_SRL, ALU_SRA: out = shift_result;\\\", \\\"ALU_SLL, ALU_SRL, ALU_SRA: out = finish_shift(shift_state);\\\")\nedit(\\\"ex_stage.sv\\\", \\\"logic [31:0] other_result, add_result, shift_result, div_result, mul_result;\\\",\n    \\\"logic [31:0] other_result, add_result, div_result, mul_result;\\\\n  shift_state_t shift_state;\\\")\nedit(\\\"ex_stage.sv\\\", \\\".shift_result (shift_result),\\\", \\\".shift_state  (shift_state),\\\")\nedit(\\\"ex_stage.sv\\\", \\\"reg_q.shift_result   <= shift_result;\\\", \\\"reg_q.shift_state    <= shift_state;\\\")\nedit(\\\"core.sv\\\", \\\"  // ── EX ──\\\", \\\"  logic [31:0] completed_shift;\\\\n  assign completed_shift = finish_shift(ex_mem_w.shift_state);\\\\n\\\\n  // ── EX ──\\\")\nedit(\\\"core.sv\\\", \\\"    .fwd_shift        (ex_mem_w.shift_result),\\\", \\\"    .fwd_shift        (completed_shift),\\\")\nedit(\\\"core.sv\\\", \\\"    .in            (ex_mem_w),\\\", \\\"    .in            (ex_mem_w),\\\\n    .shift_result  (completed_shift),\\\")\nedit(\\\"mem_stage.sv\\\", \\\"  ex_mem_t  in,\\\", \\\"  ex_mem_t  in,\\\\n  input logic [31:0] shift_result,\\\")\nedit(\\\"mem_stage.sv\\\", \\\"& in.shift_result)\\\", \\\"& shift_result)\\\")\nPY\npython3 \\\"\"'$TMPDIR/shift-study/probe.py\" split3 3\npython3 \"$TMPDIR/shift-study/probe.py\" split2 2\npython3 \"$TMPDIR/shift-study/probe.py\" split0 0\ncat > \"$TMPDIR/shift-study/timing.py\" <<'\"'PY'\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build, build_all\n\nroot = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"shift-study\\\"\nname, option = sys.argv[1:3]\ntarget = root / name\nif option == \\\"all\\\":\n    results = build_all(\\\".\\\", target / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", target)\nelse:\n    results = [build(\\\".\\\", target / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", int(option), target / f\\\"gowin_p{option}\\\")]\nfor result in results:\n    if result.get(\\\"critical_paths\\\"):\n        result[\\\"critical_paths\\\"] = result[\\\"critical_paths\\\"][:3]\n    print(json.dumps(result), flush=True)\nPY\nverilator --lint-only -Wall --top-module core -I\\\"\"'$TMPDIR/shift-study/split3/rtl\" \"$TMPDIR/shift-study/split3/rtl/core_pkg.sv\" \"$TMPDIR/shift-study/split3/rtl/\"*.sv\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
