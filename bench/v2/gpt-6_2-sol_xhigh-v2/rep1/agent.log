{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor-profile/split_jalr.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nwork = Path(os.environ['TMPDIR']) / 'predictor-profile'\nsrc = Path('cores/bench/rtl')\ndef build(name, width, grouped, range_only=False):\n    rtl = work / f'{name}-rtl'\n    shutil.copytree(src, rtl, dirs_exist_ok=True)\n    path = rtl / 'ex_stage.sv'\n    s = path.read_text()\n    def sub(old, new):\n        nonlocal s\n        assert s.count(old) == 1, old\n        s = s.replace(old,new)\n    sub('target, jalr_sum, effective_addr;', 'target, effective_addr;')\n    h = 32-width\n    sub('  assign jalr_sum = rs1 + in.imm;', f'''  logic [{width}:0] jalr_lo;\n  logic [{h-1}:0] base_hi, candidate_hi, jalr_hi;\n  logic jalr_inc, jalr_dec, jalr_same, jalr_match_lo, jalr_match_hi, jalr_match_addr, direct_match;\n  assign jalr_lo = {{1'b0, rs1[{width-1}:0]}} + {{1'b0, in.imm[{width-1}:0]}};\n  assign base_hi = rs1[31:{width}];\n  assign candidate_hi = fetch_pc[31:{width}];\n  assign jalr_inc = jalr_lo[{width}] && \"'!in.imm[31];\n  assign jalr_dec = !jalr_lo[{width}] && in.imm[31];\n  assign jalr_same = jalr_lo[{width}] == in.imm[31];\n  assign jalr_hi = ({{{h}{{jalr_inc}}}} & (base_hi + {h}'\"'d1))\n                 | ({{{h}{{jalr_dec}}}} & (base_hi - {h}'d1))\n                 | ({{{h}{{jalr_same}}}} & base_hi);\n  assign jalr_match_lo = fetch_pc[{width-1}:0] == {{jalr_lo[{width-1}:1], 1'b0}};\n  assign jalr_match_hi = (jalr_inc && (base_hi == candidate_hi - {h}'d1))\n                      || (jalr_dec && (base_hi == candidate_hi + {h}'d1))\n                      || (jalr_same && (base_hi == candidate_hi));\n  assign direct_match = fetch_pc == in.direct_target;''')\n    if range_only:\n        sub(f'''  assign jalr_match_hi = (jalr_inc && (base_hi == candidate_hi - {h}'d1))\n                      || (jalr_dec && (base_hi == candidate_hi + {h}'d1))\n                      || (jalr_same && (base_hi == candidate_hi));''',\n            f'''  assign jalr_match_hi = candidate_hi == '0\n                      && ((jalr_inc && (base_hi == {{{h}{{1'b1}}}}))\n                       || (jalr_dec && (base_hi == {h}'d1))\n                       || (jalr_same && (base_hi == '0)));''')\n    sub(\\\"(jalr_sum & 32'hffff_fffe)\\\", f\\\"{{jalr_hi, jalr_lo[{width-1}:1], 1'b0}}\\\")\n    if grouped:\n        sub('  assign fetch_resolution.match_target = match_target_q;', '''  logic jalr_check_lo_q, jalr_check_hi_q;\n  assign fetch_resolution.match_target = match_target_q || (jalr_check_lo_q && jalr_check_hi_q);''')\n        sub('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"', '''      match_target_q      <= \"'!fetch_parked && !in.ctrl.is_jalr && direct_match;\n      jalr_check_lo_q     <= !fetch_parked && in.ctrl.is_jalr && jalr_match_lo;\n      jalr_check_hi_q     <= jalr_match_hi;'\"''')\n    else:\n        sub('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"', '''      match_target_q      <= \"'!fetch_parked && (in.ctrl.is_jalr\n                                            ? (jalr_match_lo && jalr_match_hi) : direct_match);'\"''')\n    s = s.replace(', jalr_match_addr,', ',')\n    path.write_text(s)\nbuild('split12',12,False)\nbuild('split12-groups',12,True)\nbuild('split20-low',20,False,True)\nbuild('split20-groups',20,True,True)\nPY\npython3 \\\"\"'$TMPDIR/predictor-profile/split_jalr.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
