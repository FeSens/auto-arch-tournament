{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"set -o pipefail\npython3 - <<'PY' | tail -n 24\nfrom pathlib import Path\nimport subprocess\n\nrtl = Path(\\\"cores/bench/rtl/ex_stage.sv\\\").read_text()\nchecks = rtl.split(\\\"  logic [31:1] required_carry;\\\", 1)[1].split(\\\"  logic train_valid\\\", 1)[0]\nchecks = \\\"  logic [31:1] required_carry;\\\" + checks\nchecks = checks.replace(\\\"in.imm\\\", \\\"imm\\\").replace(\\\"in.direct_target\\\", \\\"direct_target\\\")\nselector = rtl.split(\\\"  assign fetch_resolution.match_target = \\\", 1)[1].split(\\\";\\\", 1)[0]\nselector = selector.replace(\\\"jalr_match_q\\\", \\\"jalr_match\\\").replace(\\\"direct_match_q\\\", \\\"direct_match\\\")\ncontrols = [\n    line.strip().replace(\\\"<=\\\", \\\"=\\\").replace(\\\"in.ctrl.is_jalr\\\", \\\"is_jalr\\\")\n    for line in rtl.splitlines()\n    if line.strip().startswith((\\\"check_jalr_q \\\", \\\"check_direct_q \\\")) and \\\"<=\\\" in line\n]\nassert len(controls) == 2\nsource = \\\"\\\"\\\"\nmodule jalr_match_proof (\n  input [31:0] rs1, imm, fetch_pc, direct_target,\n  input fetch_parked, is_jalr,\n  output equivalent\n);\n  logic check_jalr_q, check_direct_q;\n\\\"\\\"\\\" + checks + \\\"\\\\n\\\".join(f\\\"  assign {line}\\\" for line in controls) + f\\\"\\\"\\\"\n  wire match_target = {selector};\n  wire [31:0] sum = rs1 + imm;\n  wire [31:0] target = is_jalr ? {{sum[31:1], 1'b0}} : direct_target;\n  assign equivalent = match_target == (\"'!fetch_parked && fetch_pc == target);\nendmodule\n\"\"\"\nresult = subprocess.run(\n    [\"yosys\", \"-Q\", \"-p\", \"read_verilog -sv /dev/stdin; prep -top jalr_match_proof; sat -verify -prove equivalent 1 -show-inputs\"],\n    input=source, text=True,\n)\nraise SystemExit(result.returncode)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
