{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'set -eu\nprofile_dir=/srv/hwebench/tmp/7cb5c576/9e820270/fetch-profile.aoWAwx\nmkdir -p \"$profile_dir/lookahead-rtl\"\ncp \"$profile_dir/retimed-rtl/\"*.sv \"$profile_dir/lookahead-rtl/\"\npython3 - \"$profile_dir/lookahead-rtl/if_stage.sv\" \"$profile_dir/lookahead-rtl/id_stage.sv\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np = Path(sys.argv[1])\nsource = p.read_text()\nports = source[:source.index('  logic [31:0] pc,')]\nreplay_regs = source[source.index('  logic          replay_armed_q;'):source.index('  assign recover_target')]\nreplay_regs = replay_regs.replace('  logic          replay_write_q;',\n                                 '  logic [31:0]   replay_fill_word_q;\\\\n  logic          replay_write_q;')\nreplay = source[source.index('  assign replay_collision'):source.index('  assign imem_addr = pc;')]\nreplay = replay.replace('replay_write_index_q == normal_pc_q[11:2]', 'replay_write_index_q == normal_pc_q[11:2]')\nreplay = replay.replace('&& \"'!replay_collision;'\"', ';')\nreplay = replay.replace('assign replay_hit = replay_eligible && replay_slot_valid;', '''assign replay_hit = replay_eligible && replay_slot_valid && \"'!replay_collision;\n  assign fill_forward = replay_armed_q && replay_collision && replay_fill_pc_q == normal_pc_q;'\"''')\nstart = replay.index('  assign replay_fill =')\nend = replay.index('\\\\n  always_ff', start)\nreplay = replay[:start] + '''  assign replay_fill = \"'!reset && !fetch_resolution.refetch && imem_ready\n                    && (squash_candidate ? corrected_accept : response_accept) && address_in_range\n                    && (replay_armed_q || recover_target);\n'\"''' + replay[end:]\nreplay = replay.replace('    replay_write_q <= replay_fill;',\n                        '    replay_write_q <= replay_fill;\\\\n    replay_fill_pc_q <= pc;\\\\n    replay_fill_word_q <= imem_data;')\nreplay = replay.replace('(\"'!squash_candidate && ordinary_accept && predict_taken)'\"', '(\"'!squash_candidate && launch_next && predict_taken)'\"')\nlogic = \\\"\\\"\\\"\n  logic [31:0] pc, normal_pc_q, normal_pc_d;\n  logic [31:0] ordinary_plus4, corrected_plus4;\n  logic [31:0] target_plus4, fallthrough_plus4;\n  logic [31:0] table_target, response_pc, retry_pc_q, response_word, replay_fill_pc_q;\n  logic        response_accept, response_available, response_credit, launch_next, fill_forward;\n  logic        normal_parked_q, retry_q, ordinary_last, ordinary_in_range, predict_taken;\n  logic        corrected_accept, recover_target, recover_fallthrough, corrected_last;\n  logic        address_in_range, ordinary_step, queue_pop, queue_push, bypass_accept;\n  logic [4:0]  ordinary_index, candidate_index, write_index;\n  logic [12:0] write_tag;\n  btb_action_t selected_action;\n  if_id_t      response, queue_head_q, queue_tail_q;\n  logic [1:0]  queue_count_q;\n\n  logic [31:0] btb_valid;\n  logic [30:0] btb_entry [0:31]; // {tag, word target}\n  logic [1:0]  btb_counter [0:31];\n  logic [12:0] ordinary_tag, candidate_tag;\n  logic [17:0] ordinary_table_target;\n\n\\\"\\\"\\\"\nimpl = \\\"\\\"\\\"\n  // This build keeps a two-entry fall-through queue and a registered retry\n  // independently of the ahead-of-response replay lookup.\n  assign recover_target = fetch_resolution.valid && fetch_resolution.take_target\n                       && \"'!fetch_resolution.match_target;\n  assign recover_fallthrough = fetch_resolution.valid && !fetch_resolution.take_target\n                            && (!fetch_resolution.match_fallthrough || fetch_resolution.refetch);\n  assign squash_candidate = recover_target || recover_fallthrough;\n  assign corrected_accept = imem_ready && !hold_mem;\n  assign target_plus4 = fetch_resolution.target + 32'\"'d4;\n  assign fallthrough_plus4 = fetch_resolution.fallthrough + 32'd4;\n  assign corrected_plus4 = recover_target ? target_plus4 : fallthrough_plus4;\n  assign corrected_last = (recover_target && fetch_resolution.target == 32'h000f_fffc)\n                       || (recover_fallthrough && fetch_resolution.fallthrough == 32'h000f_fffc);\n\n  assign selected_action = training_taken ? btb_training.taken : btb_training.not_taken;\n  assign btb_update.pc_word = btb_training.pc_word;\n  assign btb_update.target_word = btb_training.target_word;\n  assign btb_update.write_target = selected_action.write_target;\n  assign btb_update.write_counter = selected_action.write_counter;\n  assign btb_update.counter = selected_action.counter;\n  assign {write_tag, write_index} = btb_update.pc_word;\n  assign ordinary_index = normal_pc_q[6:2];\n  assign ordinary_in_range = normal_pc_q[31:20] == 12'b0 && normal_pc_q[1:0] == 2'b00;\n  assign {ordinary_tag, ordinary_table_target} = btb_entry[ordinary_index];\n  assign predict_taken = ordinary_in_range && btb_valid[ordinary_index] && btb_counter[ordinary_index][1]\n                       && ordinary_tag == normal_pc_q[19:7];\n  assign table_target = {12'b0, ordinary_table_target, 2'b00};\n  assign ordinary_plus4 = normal_pc_q + 32'd4;\n  assign ordinary_last = normal_pc_q == 32'h000f_fffc;\n\n  assign candidate_index = candidate_pc[6:2];\n  assign candidate_tag = btb_entry[candidate_index][30:18];\n  assign candidate_btb_hit = candidate_pc[31:20] == 12'b0 && candidate_pc[1:0] == 2'b00\n                          && btb_valid[candidate_index] && candidate_tag == candidate_pc[19:7];\n  assign candidate_btb_counter = btb_counter[candidate_index];\n\n  assign response_pc = retry_q ? retry_pc_q : normal_pc_q;\n  assign address_in_range = pc[31:20] == 12'b0 && pc[1:0] == 2'b00;\n  assign pc = ({32{\"'!squash_candidate}} & response_pc)\n            | ({32{recover_target}} & fetch_resolution.target)\n            | ({32{recover_fallthrough}} & fetch_resolution.fallthrough);\n  assign imem_addr = pc;\n\n  assign response_credit = queue_count_q != 2 && (retry_q || !normal_parked_q);\n  assign response_available = ime