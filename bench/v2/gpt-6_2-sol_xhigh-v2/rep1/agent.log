{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c 'scratch_dir=/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U\ncandidate=\"$scratch_dir/validonly4096\"\nmkdir -p \"$candidate/test\"\ncp cores/bench/test/{_helpers.py,test_pipeline.py} \"$candidate/test/\"\ncat > \"$candidate/test/test_scrub.py\" <<'\"'PY'\nimport cocotb\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADDI, BNE, EBREAK, FENCE_I, JAL, NOP, SW, _run\n\n@cocotb.test()\nasync def fence_restart_suppresses_cached_old_word_with_bus_unready(dut):\n    old_word, new_word = ADDI(5, 0, 7), ADDI(5, 0, 19)\n    marker = 0x400\n    program = {\n        0: ADDI(1, 0, 1500),\n        4: ADDI(2, 2, 1),\n        8: NOP(),\n        12: BNE(2, 1, -8),\n        16: JAL(0, 0x80 - 16),\n        0x84: BNE(3, 0, 0x140 - 0x84),\n        0x88: ADDI(3, 0, 1),\n        0x8c: SW(3, 0, marker),\n        0x90: JAL(0, 0x100 - 0x90),\n        0x100: FENCE_I(),\n        0x104: FENCE_I(),\n        0x108: JAL(0, 0x80 - 0x108),\n        0x140: EBREAK(),\n    }\n    requests = 0\n\n    def word(pc, dmem):\n        if pc == 0x80:\n            return new_word if marker in dmem else old_word\n        return program.get(pc, NOP())\n\n    def unready(pc, dmem):\n        nonlocal requests\n        if pc == 0x80 and marker in dmem:\n            requests += 1\n            return requests <= 3\n        return False\n\n    fetches = []\n    retired, _ = await _run(dut, word, max_cycles=5200, imem_wait=unready, fetches=fetches)\n    assert [r[\\\"insn\\\"] for r in retired if r[\\\"pc\\\"] == 0x80] == [old_word, new_word]\n    assert [r[\\\"pc\\\"] for r in retired[-7:]] == [0x90, 0x100, 0x104, 0x108, 0x80, 0x84, 0x140]\n    start = fetches.index((0x80, False, True))\n    assert fetches[start:start+4] == [(0x80, False, True)] * 3 + [(0x80, True, True)]\n\n@cocotb.test()\nasync def scrub_completes_and_arms_replay(dut):\n    target = 0x80\n    program = {\n        0: ADDI(1, 0, 1500),\n        4: ADDI(2, 2, 1),\n        8: NOP(),\n        12: BNE(2, 1, -8),\n        16: ADDI(4, 0, 3),\n        20: JAL(0, target - 20),\n        target: ADDI(3, 3, 1),\n        target + 4: BNE(3, 4, -4),\n        target + 8: EBREAK(),\n    }\n    visits = 0\n\n    def unready(pc, _dmem):\n        nonlocal visits\n        if pc == target:\n            visits += 1\n            return visits in (2, 3, 4)\n        return False\n\n    fetches = []\n    retired, _ = await _run(dut, program, max_cycles=5200, imem_wait=unready, fetches=fetches)\n    assert [r[\\\"rd_wdata\\\"] for r in retired if r[\\\"pc\\\"] == target] == [1, 2, 3]\n    assert any(not ready for pc, ready, _ in fetches if pc == target)\n\ndef test_scrub_runner():\n    from pathlib import Path\n    ordered = [\\\"core_pkg.sv\\\"] + sorted(p.name for p in (Path(__file__).resolve().parents[1]/\\\"rtl\\\").glob(\\\"*.sv\\\") if p.name \"'!= \"core_pkg.sv\")\n    run_cocotb(\"core\", ordered, \"test_scrub\")\nPY\nPYTHONDONTWRITEBYTECODE=1 MAKEFLAGS=-j2 pytest -q \"$candidate/test/test_scrub.py\" > \"$candidate/scrub-tests.log\" 2>&1\ntail -18 \"$candidate/scrub-tests.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
