   assign trials[n] = {1'b0, shifted4} - {1'b0, divisor_multiple_q[n]};\n    assign accepted[n] = \"'!trials[n][36];\n    if (n == 15)\n      assign selected[n] = accepted[n];\n    else\n      assign selected[n] = accepted[n] && !accepted[n+1];\n    assign selected_remainder[n] = {32{selected[n]}} & trials[n][31:0];\n  end\n\n  for (genvar group = 0; group < 4; group++) begin : remainder_group\n    assign grouped_remainder[group] = selected_remainder[group*4]\n                                    | selected_remainder[group*4+1]\n                                    | selected_remainder[group*4+2]\n                                    | selected_remainder[group*4+3];\n  end\n  for (genvar bit_index = 0; bit_index < 4; bit_index++) begin : digit_bit\n    logic [15:0] bit_sel;\n    for (genvar n = 0; n <= 15; n++)\n      assign bit_sel[n] = ((n >> bit_index) & 1) == 1 && selected[n];\n    assign digit[bit_index] = |bit_sel;\n  end\n  assign after_radix16 = {grouped_remainder[0] | grouped_remainder[1]\n                          | grouped_remainder[2] | grouped_remainder[3],\n                          partial_q[27:0], digit};\"\"\")\ns=s.replace(\"      triple_divisor_q <= {2'\"'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\\\\n\\\",\\\"\\\")\ns=s.replace(\\\"      partial_q <= after_radix4_b;\\\",\\\"      partial_q <= after_radix16;\\\")\n# Gowin accepts generate case conditionals and zero-width branches are avoided.\np.write_text(s)\nPY\npython3 \\\"\"'$bench_scratch/alternatives.py\" \"$bench_scratch\"\ncat > \"$bench_scratch/timing.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build_all, summarize\nfor variant in sys.argv[1:]:\n    work = Path(variant).resolve()\n    builds = build_all(Path.cwd(), work/\\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", work/\\\"timing\\\")\n    for r in builds:\n        path = (r.get('critical_paths') or [{}])[0]\n        print(r['place_option'],r['fmax_mhz'],r.get('logic'),path.get('from'),path.get('to'),r.ge