target_aligned && target[31:20] == 12'b0\\\", \\\"target_aligned && target_in_range\\\")\n        ex = ex.replace(\\\"(target[31:20] == 12'b0 ||\\\", \\\"(target_in_range ||\\\")\n        ex = ex.replace(\\\"\"'!fetch_parked && fetch_pc == target\",\n                        \"!fetch_parked && (in.ctrl.is_jalr ? fetch_pc == {jalr_sum[31:1], 1'\"'b0} : fetch_pc == in.direct_target)\\\")\n    (dest / \\\"ex_stage.sv\\\").write_text(ex)\nPY\npython3 -u - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nplans = [(variant, 1) for variant in (\\\"rtl_match_basic\\\", \\\"rtl_match_parallel\\\", \\\"rtl_match_groups\\\", \\\"rtl_match_word\\\")]\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    futures = {pool.submit(build, root, root / variant, \\\"fpga/core_bench_si.sv\\\", option,\n                           root / \\\"measurements\\\" / variant / f\\\"opt{option}\\\"): (variant, option)\n               for variant, option in plans}\n    for future in as_completed(futures):\n        result = future.result()\n        print(futures[future], result.get(\\\"fmax_mhz\\\"), result.get(\\\"logic\\\"), result.get(\\\"critical_paths\\\", [])[:3], result.get(\\\"reason\\\"))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
