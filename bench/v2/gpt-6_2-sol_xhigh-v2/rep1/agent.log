es/bench/rtl/hazard_unit.sv    |  26 ++--\n cores/bench/rtl/id_stage.sv       |  79 +++++++---\n cores/bench/rtl/mem_stage.sv      | 295 +++++++++++++++++++++-----------------\n cores/bench/test/test_pipeline.py | 117 +++++++++++++--\n 8 files changed, 612 insertions(+), 455 deletions(-)\n// Three in-order completion slots and an independently \n…[5538 of 8610 chars elided by tools/bench/transcript.py; sha256:2d1d63fd867681ac]…\n;\n          packet_q.rs2_pending <= '0;\n        end\n      end\n    end\n  end\n\n  assign head_ingress = |(head_q & ingress_q);\n  assign head_response = |(head_q & accepted_load);\n  assign retire_result = ({32{head_response}} & response_data)\n                       | select_ex_result(ingress_results, head_ingress && !head_response ? ingress_select_q : '0)\n                       | ({32{head_q[0] && !head_ingress && !head_response}} & slot_values[0 +: 32])\n                       | ({32{head_q[1] && !head_ingress && !head_response}} & slot_values[32 +: 32])\n                       | ({32{head_q[2] && !head_ingress && !head_response}} & slot_values[64 +: 32]);\n\n  always_comb begin\n    retire_packet = retire_lanes[0] | retire_lanes[1] | retire_lanes[2];\n    retire_packet.valid = pop;\n    retire_packet.result = retire_result;\n    if (head_response)\n      retire_packet.mem_rdata = dmem_rdata;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      wb_q <= '0;\n    else\n      wb_q <= retire_packet;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
