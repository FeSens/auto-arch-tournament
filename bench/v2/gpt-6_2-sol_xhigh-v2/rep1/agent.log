{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2.xOg3NS\"\npython - \"$trial_dir\" <<'\"'PY'\nimport shutil\nimport sys\nfrom pathlib import Path\n\nroot = Path(sys.argv[1])\nfor source in ('sticky512', 'sticky1024', 'recovsticky512', 'recovsticky1024'):\n    for mode in ('bank', 'sync'):\n        name = mode + source\n        rtl = root / name / 'rtl'\n        shutil.copytree(root / source / 'rtl', rtl)\n        path = rtl / 'if_stage.sv'\n        s = path.read_text()\n        n = 10 if source.endswith('512') else 11\n        slots = 2**(n-1)\n        banks = slots // 16\n        if mode == 'bank':\n            s = s.replace(f'  logic [{slots-1}:0] replay_valid_q;',\n                f'''  logic [{banks-1}:0] replay_bank_valid_q;\n  logic [{banks-1}:0] replay_valid_bank;\n  logic        replay_valid_word;\n  logic [15:0] replay_fill_bit_one_hot;\n  assign replay_fill_bit_one_hot = 16'b1 << pc[5:2];''')\n            s = s.replace(f'replay_valid_q[normal_pc_q[{n}:2]]', 'replay_valid_word')\n            i = s.index('    if (reset || fetch_resolution.refetch)\\\\n      replay_valid_q')\n            j = s.index('\\\\n  end', i)\n            s = s[:i] + s[j:]\n            i = s.index('  always_ff @(posedge clock) begin\\\\n    if (reset || fetch_resolution.refetch)\\\\n      replay_active')\n            s = s[:i] + f'''  assign replay_valid_word = |replay_valid_bank;\n\n  for (genvar group = 0; group < {banks}; group++) begin : replay_valid_group\n    logic [15:0] word_valid_q;\n    logic select_read, select_fill;\n\n    assign select_read = normal_pc_q[{n}:6] == {n-5}'(group);\n    assign select_fill = replay_fill && pc[{n}:6] == {n-5}'(group);\n    assign replay_valid_bank[group] = select_read && replay_bank_valid_q[group]\n                                   && word_valid_q[normal_pc_q[5:2]];\n\n    always_ff @(posedge clock) begin\n      if (reset || fetch_resolution.refetch)\n        replay_bank_valid_q[group] <= 1'b0;\n      else if (select_fill)\n        replay_bank_valid_q[group] <= 1'b1;\n\n      if (select_fill)\n        word_valid_q <= (replay_bank_valid_q[group] ? word_valid_q : 16'b0)\n                    | replay_fill_bit_one_hot;\n    end\n  end\n\n''' + s[i:]\n        else:\n            s = s.replace('  logic [42:0]', '  logic [42:0]')\n            s = s.replace(f'  logic [{slots-1}:0] replay_valid_q;',\n                f'  logic [{slots-1}:0] replay_valid_q;\\\\n  logic replay_valid_read_q;')\n            s = s.replace(f'replay_valid_q[normal_pc_q[{n}:2]]', 'replay_valid_read_q')\n            s = s.replace(f'    {{replay_tag, replay_word}} <= replay_entry[normal_pc_d[{n}:2]];',\n                f'''    {{replay_tag, replay_word}} <= replay_entry[normal_pc_d[{n}:2]];\n    replay_valid_read_q <= \"'!reset && !fetch_resolution.refetch && replay_valid_q[normal_pc_d[{n}:2]];'\"''')\n        path.write_text(s)\nPY\nfor name in banksticky512 banksticky1024 syncrecovsticky512; do\n  bash \\\"\"'$trial_dir/sim.sh\" \"$trial_dir\" \"$name\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
