{"type":"item.started","item":{"id":"item_119","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\ncount = 0\nfor reset, accept, train_taken, bypass, predict_t, predict_n, ready, last_t, last_n in product((False, True), repeat=9):\n    for recovery in ('none', 'taken', 'fallthrough'):\n        advance = not reset and recovery == 'none' and accept\n        t, f = recovery == 'taken' and not reset, recovery == 'fallthrough' and not reset\n        predicts = predict_t if train_taken else predict_n\n        enables = {\n            'sequential': advance and not predicts,\n            'hold': not reset and recovery == 'none' and not accept,\n            'table': advance and (predict_t and not bypass if train_taken else predict_n),\n            'pending': advance and train_taken and predict_t and bypass,\n            'target+4': t and ready and not last_t,\n            'target': t and (not ready or last_t),\n            'fallthrough+4': f and ready and not last_n,\n            'fallthrough': f and (not ready or last_n),\n        }\n        if reset:\n            expected = []\n        elif recovery == 'taken':\n            expected = ['target+4' if ready and not last_t else 'target']\n        elif recovery == 'fallthrough':\n            expected = ['fallthrough+4' if ready and not last_n else 'fallthrough']\n        elif not accept:\n            expected = ['hold']\n        elif predicts:\n            expected = ['pending' if train_taken and bypass else 'table']\n        else:\n            expected = ['sequential']\n        assert [sel for sel, enabled in enables.items() if enabled] == expected\n        count += 1\nprint(f'{count} selector combinations agree with the original mux')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
