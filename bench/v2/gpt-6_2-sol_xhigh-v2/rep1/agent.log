lid && train_pc[31:20] == 12'b0 && train_pc[1:0] == 2'b0) begin\n      if (train_taken && target_in_range) begin\n        entry_valid[train_index] <= 1'b1;\n        tags[train_index] <= train_pc[19:7];\n        targets[train_index] <= train_target[19:2];\n        if (train_jump)\n          counters[train_index] <= 2'd3;\n        else if (\"'!train_hit)\n          counters[train_index] <= 2'\"'d2;\n        else if (train_counter \"'!= 2'\"'d3)\n          counters[train_index] <= train_counter + 2'd1;\n      end else if (\"'!train_taken && train_hit && train_counter != 2'\"'d0) begin\n        counters[train_index] <= train_counter - 2'd1;\n      end\n    end\n  end'''),\n])\n\nchange('ex_stage.sv', [\n    ('  output logic               redirect,\\\\n  output logic [31:0]        redirect_target','''  input  logic [31:0]        fetch_pc,\n  output logic               redirect,\n  output logic [31:0]        redirect_target,\n  output logic               train_valid,\n  output logic               train_taken,\n  output logic               train_jump,\n  output logic [31:0]        train_pc,\n  output logic [31:0]        train_target'''),\n    ('''  assign redirect        = (branch_taken || in.ctrl.is_jump) && \"'!misalign_fault;\n  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;'\"''','''  logic [31:0] resolved_pc;\n  assign resolved_pc = misalign_fault ? (in.pc + 32'd4)\n                     : in.ctrl.is_jump ? jump_target\n                     : branch_taken    ? branch_target\n                                       : (in.pc + 32'd4);\n  assign redirect        = in.valid && \"'!stall && (resolved_pc != fetch_pc);\n  assign redirect_target = resolved_pc;\n  assign train_jump      = in.ctrl.is_jump && !in.ctrl.is_jalr;\n  assign train_valid     = in.valid && !stall && !misalign_fault\n                           && (in.ctrl.is_branch || train_jump);\n  assign train_taken     = branch_taken || train_jump;\n  assign train_pc        = in.pc;\n  assign t