u_b = in.ctrl.alu_src  ? in.imm : alu_rs2;'),\n        ('  assign div_wait = is_div && \"'!div_valid;'\"\\\\n  assign div_start = is_div && \"'!stall && !div_busy;'\"',\n         prediction + \\\"\\\"\\\"\n  assign alu_rs1 = rs1_reg | ({32{fwd_rs1_sel.result.load}} & prediction);\n  assign alu_rs2 = rs2_reg | ({32{fwd_rs2_sel.result.load}} & prediction);\n  assign speculative_consumer = in.ctrl.reg_write && \"'!in.ctrl.is_jump\n                             && !in.ctrl.mem_to_reg && !in.ctrl.is_lui\n                             && !in.ctrl.is_auipc && !in.ctrl.is_illegal;\n  assign load_dep = fwd_rs1_sel.result.load || (!in.ctrl.alu_src && fwd_rs2_sel.result.load);\n  assign retry_div = select_div && load_dep;\n  assign retry_consumer = speculative_consumer && load_dep\n                        && (select_div || load_value != prediction);\n  assign div_wait = is_div && !retry_div && !div_valid;\n  assign div_start = is_div && !retry_div && !stall && !div_busy;\"\"\"),\n        ('\"'    .mul_a        (rs1),\\\\n    .mul_b        (rs2),', '    .mul_a        (alu_rs1),\\\\n    .mul_b        (alu_rs2),'),\n        ('    fetch_resolution.target            <= target;', '    fetch_resolution.retry              <= \"'!reset && advance && retry_consumer;'\"\\\\n    fetch_resolution.retry_pc           <= in.pc;\\\\n    fetch_resolution.target            <= target;'),\n        ('  // ── EX/MEM register ───────────────────────────────────────────────────\\\\n  ex_mem_t reg_q;', '  // ── EX/MEM register ───────────────────────────────────────────────────'),\n        ('  assign out = reg_q;', \\\"\\\"\\\"  always_comb begin\n    out = reg_q;\n    if (fetch_resolution.retry) begin\n      out.ctrl = '0;\n      out.result_sel = '0;\n      out.valid = 1'b0;\n    end\n  end\\\"\\\"\\\"))\nPY\nfor model_name in zero last; do\n  (\n    NRET=1 RTL_DIR=\\\"\"'$scratch_dir/value-$model_name/rtl\" OBJ_DIR=\"$scratch_dir/value-$model_name/sim\" MAKEFLAGS=-j2 bash test/cosim/build.sh > \"$scratch_dir/value-$model_name/sim.log\" 2>&1 &&\n    \"$scratch_dir/value-$model_name/sim/cosim_sim\" \"$scratch_dir/coremark.elf\" 50000000 --bench --istall --dstall > \"$scratch_dir/value-$model_name/coremark.log\"\n  ) &\ndone\nPYTHONDONTWRITEBYTECODE=1 python -u - <<'\"'PY' > \\\"\"'$scratch_dir/timing-value.log\" 2>&1 &\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nroot = Path('\"'/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U')\njobs = [(name, opt) for name in ('zero', 'last') for opt in (0, 1, 2)]\ndef measure(job):\n    model, option = job\n    candidate = root / f'value-{model}'\n    result = build(Path.cwd(), candidate/'rtl', 'fpga/core_bench_si.sv', option, candidate/f'gowin_p{option}')\n    print(model, option, {key:result.get(key) for key in ('fmax_mhz','logic','bsram','reason')}, flush=True)\n    return model, result\nresults = {}\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    for model, result in executor.map(measure, jobs):\n        results.setdefault(model, []).append(result)\nfor model, placements in results.items():\n    print(model, summarize(placements), flush=True)\nPY\nwait\"", "aggregated_output": "", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c 'scratch_dir=/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U\npython - \"$scratch_dir\" <<'\"'PY'\nimport shutil\nimport sys\nfrom pathlib import Path\nroot=Path(sys.argv[1])\nfor name in (\\\"fast\\\", \\\"late\\\", \\\"plain\\\"):\n    dest = root/f'zero-{name}'/'rtl'\n    shutil.copytree(root/'zero-jalr'/'rtl', dest)\n    p=dest/'alu.sv'\n    data=p.read_text().replace(\\\"neg_a ? -div_lhs : a}\\\", \\\"neg_a ? -div_lhs : div_lhs}\\\")\n    p.write_text(data)\n    p=dest/'ex_stage.sv'\n    data=p.read_text().replace(\\\"\\\"\\\"    if (fetch_resolution.retry) begin\n      out.ctrl = '0;\n      out.result_sel = '0;\n      out.valid = 1'b0;\n    end\\\"\\\"\\\",\\\"\\\"\\\"    out.valid = reg_q.valid && \"'!fetch_resolution.retry;\"\"\")\n    data=data.replace(\"\"\"      ctrl_with_trap.reg_write  = 1'\"'b0;\n    end\\\"\\\"\\\", \\\"\\\"\\\"    end\n    ctrl_with_trap.reg_write = in.ctrl.reg_write && (\"'!in.ctrl.is_jump || target_aligned);\"\"\")\n    if name != '\"'plain':\n        data=data.replace(\\\"  logic train_target_aligned, write_btb_target;\\\", \\\"\\\"\\\"  logic train_target_aligned, write_btb_target;\n  logic branch_taken, branch_eq_active_q, branch_ne_q, take_target_q;\n  logic [3:0] branch_byte_eq_q;\n  logic [1:0] saturated_taken, saturated_not_taken;\n  logic [1:0] saturated_taken_q, saturated_not_taken_q;\n  logic trained_control_taken;\n\n  assign branch_taken = (&branch_byte_eq_q) \"'^ branch_ne_q;\n  assign fetch_resolution.take_target = branch_eq_active_q\n                                       ? branch_taken && train_target_aligned : take_target_q;\n  assign trained_control_taken = branch_eq_active_q ? branch_taken : train_taken_q;\"\"\")\n        data=data.replace(\"  logic [1:0] train_counter, train_counter_q;\", \"\")\n        data=data.replace(\"train_valid_q && train_taken_q\", \"train_valid_q && trained_control_taken\").replace(\"(!train_taken_q || train_target_aligned)\", \"(!trained_control_taken || train_target_aligned)\")\n        data=data.replace(\"assign btb_update.counter = train_counter_q;\", \"assign btb_update.counter = trained_control_taken ? saturated_taken_q : saturated_not_taken_q;\")\n        begin = data.index(\"  always_comb begin'\"\\\\n    if (in.ctrl.is_jump)\\\\n      train_counter\\\")\n        end = data.index(\\\"  // Resolve the two matches\\\", begin)\n        data = data[:begin] + \\\"\\\"\\\"  assign saturated_taken = in.ctrl.is_jump ? 2'b11\n                         : \"'!in.btb_hit ? 2'\"'b10\n                         : in.btb_counter == 2'b11 ? 2'b11 : in.btb_counter + 2'd1;\n  assign saturated_not_taken = \"'!in.btb_hit ? 2'\"'b10\n                             : in.btb_counter == 2'b00 ? 2'b00 : in.btb_counter - 2'd1;\n\n\\\"\\\"\\\" + data[end:]\n        data=data.replace(\\\"    fetch_resolution.take_target       <= take_target;\\\", \\\"\\\"\\\"    take_target_q                       <= take_target;\n    branch_eq_active_q                  <= in.ctrl.is_branch && \"'!in.ctrl.branch_op[2];\n    branch_ne_q                         <= in.ctrl.branch_op[0];\n    branch_byte_eq_q                    <= branch_byte_eq;\"\"\")\n        data=data.replace(\"    train_counter_q     <= train_counter;\", \"    saturated_taken_q     <= saturated_taken;'\"\\\\n    saturated_not_taken_q <= saturated_not_taken;\\\")\n        # Give ordered compares a separate register lane so the actual dmem\n        # load is only reduced late when the equality path will consume it.\n        data=data.replace(\\\"  logic        branch_cond;\\\", \\\"  logic        branch_cond, non_eq_taken;\\\")\n        data=data.replace(\\\"  assign control_taken =\\\", \\\"  assign non_eq_taken = in.ctrl.is_jump || (in.ctrl.is_branch && in.ctrl.branch_op[2] && branch_cond);\\\\n  assign control_taken =\\\")\n        data=data.replace(\\\"take_target_q                       <= take_target;\\\", \\\"take_target_q                       <= non_eq_taken && target_aligned;\\\")\n        data=data.replace(\\\"train_taken_q      <= control_taken;\\\", \\\"train_taken_q      <= non_eq_taken;\\\")\n    p.write_text(data)\n    p=dest/'mem_stage.sv'\n    data=p.read_text().replace(\\\"reg_q.reg_write  <= write_en;\\\", \\\"reg_q.reg_write  <= write_en && in.valid;\\\")\n    p.write_text(data)\n    if name == \\\"fast\\\":\n        p=dest/'if_stage.sv'\n        data=p.read_text()\n        a=data.index(\\\"  assign fetch_index\\\")\n        b=data.index(\\\"  assign bus_fetch_ready\\\")\n        section = data[a:b].replace(\\\"pc[\\\",\\\"normal_pc_q[\\\")\n        section = section.replace(\\\"  assign fetch_in_range = normal_pc_q\\\", \\\"  assign fetch_in_range = pc\\\").replace(\\\"&& normal_pc_q[1:0] == 2'b00;\\\\n  assign table_hit\\\", \\\"&& pc[1:0] == 2'b00;\\\\n  assign table_hit\\\")\n        section = section.replace(\\\"assign hit = fetch_in_range\\\", \\\"assign hit = normal_pc_q[31:20] == 12'b0 && normal_pc_q[1:0] == 2'b00\\\")\n        section = section.replace(\\\"assign pc_plus4 = pc + 32'd4;\\\", \\\"assign pc_plus4 = pc + 32'd4;\\\")\n        section = section.replace(\\\"assign predict_taken = hit\\\", \\\"assign predict_taken = \"'!squash_candidate && hit\")\n        section = section.replace(\"  assign predicted_pc = predict_taken ? {12'\"'b0, predicted_target, 2'b00}\\\\n                                      : park_fallthrough ? pc : pc_plus4;\\\", \\\"\\\"\\\"  assign predicted_pc = predict_taken ? {12'b0, predicted_target, 2'b00}\n                                      : park_fallthrough ? pc : pc_plus4;\\\"\\\"\\\")\n        data = data[:a] + section + data[b:]\n        data = data.replace(\\\"out.btb_hit     = hit;\\\", \\\"out.btb_hit     = \"'!squash_candidate && hit;\")\n        p.write_text(data)\nPY\nfor model_name in fast late plain; do\n  (\n    NRET=1 RTL_DIR=\"$scratch_dir/zero-$model_name/rtl\" OBJ_DIR=\"$scratch_dir/zero-$model_name/sim\" MAKEFLAGS=-j2 bash test/cosim/build.sh > \"$scratch_dir/zero-$model_name/sim.log\" 2>&1 &&\n    \"$scratch_dir/zero-$model_name/sim/cosim_sim\" \"$scratch_dir/coremark.elf\" 50000000 --bench --istall --dstall > \"$scratch_dir/zero-$model_name/coremark.log\"\n  ) &\ndone\nPYTHONDONTWRITEBYTECODE=1 python -u - <<'\"'PY' > \\\"\"'$scratch_dir/timing-late.log\" 2>&1 &\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nroot = Path('\"'/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U')\njobs = [(name, opt) for name in ('fast', 'late', 'plain') for opt in (0, 1, 2)]\ndef measure(job):\n    model, option = job\n    candidate = root / f'zero-{model}'\n    result = build(Path.cwd(), candidate/'rtl', 'fpga/core_bench_si.sv', option, candidate/f'gowin_p{option}')\n    print(model, option, {key:result.get(key) for key in ('fmax_mhz','logic','bsram','reason')}, flush=True)\n    return model, result\nresults = {}\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    for model, result in executor.map(measure, jobs):\n        results.setdefault(model, []).append(result)\nfor model, placements in results.items():\n    print(model, summarize(placements), flush=True)\nPY\nwait\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
