{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'cd \"$TMPDIR/predictor.ycL9kF\"\ncat > value-model.cpp <<'\"'EOF'\n#include <array>\n#include <algorithm>\n#include <map>\n#include <vector>\n#include <cstdint>\n#include <cstdio>\nstruct Event { uint32_t cycle, pc, insn, value, rs1,rs2,rd,addr; };\nstruct Entry { uint32_t pc=-1, value=0, delta=0, addr=0; int conf=0, stride_conf=0; };\nbool s1(int op) {return op==0x03 || op==0x23 || op==0x13 || op==0x33 || op==0x63 || op==0x67;}\nbool s2(int op) {return op==0x23 || op==0x33 || op==0x63;}\nint main() {\n  FILE* f=fopen(\\\"loads.bin\\\",\\\"rb\\\");\n  std::vector<Event> trace;\n  Event e;\n  while(fread(&e,sizeof(e),1,f)) if(e.cycle<4206526)trace.push_back(e);\n  for(int n:{16,32,64,128,256,512,1024,4096})\n  for(int kind:{0,1,2})\n  for(int threshold:{0,1,2,3}) {\n    std::vector<Entry> t(n);\n    int total=0,eligible=0,good=0,bad=0,align = 0, false_dependencies=0;\n    for(size_t i=0;i+1<trace.size();i++) {\n      const auto &x=trace[i];const auto &y=trace[i+1];\n      int op=y.insn&127;\n      if((x.insn&127)\"'!=3 || !x.rd)continue;\n      const bool in=x.cycle>=15185;\n      if(in)total++;\n      bool dependency=(s1(op)&&x.rd==y.rs1)||(s2(op)&&x.rd==y.rs2);\n      if(in && !dependency && (x.rd==((y.insn>>15)&31) || x.rd==((y.insn>>20)&31)))++false_dependencies;\n      auto &p=t[((x.pc>>2)''^((x.pc>>2)/n))&(n-1)];\n      bool hit = p.pc==x.pc;\n      if(in&&dependency){\n        eligible++;\n        if(hit) {\n          int stride=(kind==1 || (kind==2 && p.stride_conf>p.conf));\n          int conf=stride?p.stride_conf:p.conf;\n          uint32_t prediction = p.value + (stride ? p.delta : 0);\n          if(conf>=threshold) {\n            if(prediction==x.value)++good;else++bad;\n          }\n        }\n        if(((x.insn>>12)&7)==2)align++;\n      }\n      uint32_t delta=x.value-p.value;\n      if(hit) {\n        p.conf=delta==0?std::min(p.conf+1,3):std::max(p.conf-1,0);\n        p.stride_conf=delta==p.delta?std::min(p.stride_conf+1,3):std::max(p.stride_conf-1,0);\n      }else{\n        p.conf=0;\n        p.stride_conf=0;\n      }\n      p.pc=x.pc;p.value=x.value;p.delta=delta;p.addr=x.addr;\n    }\n    printf(\"%4d kind=%d c%d loads=%d use=%d good=%d bad=%d word=%d false=%d'\"\\\\n\\\",n,kind,threshold,total,eligible,good,bad,align,false_dependencies);\n  }\n}\nEOF\ntest -f loads.bin && g++ -O3 value-model.cpp -o value-model && ./value-model > value.txt && head -40 value.txt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
