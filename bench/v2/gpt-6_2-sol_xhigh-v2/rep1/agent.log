{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport shutil\n\nroot = Path(os.environ['TMPDIR']) / 'bench-lane-probe'\nfor base in ('lookahead', 'lookahead-epoch'):\n    out = root / (base + '-ce')\n    shutil.copytree(root / base, out)\n    path = out / 'if_stage.sv'\n    source = path.read_text()\n    source = source.replace('  logic        select_held, select_sequential,', '  logic        select_sequential,')\n    source = source.replace('  logic        ordinary_active, ordinary_can_advance,', '  logic        ordinary_active,')\n    start = source.index('  assign ordinary_can_advance')\n    stop = source.index('  assign target_advance', start)\n    source = source[:start] + '''  assign select_sequential = ordinary_active && \"'!ordinary_last && !predict_taken;\n  assign select_table_target = ordinary_active && predict_on_table;\n  assign select_bypass_target = ordinary_active && predict_on_bypass;\n\n'\"''' + source[stop:]\n    source = source.replace('{select_held & normal_pc_q[i],\\\\n                              select_sequential', '{select_sequential')\n    source = source.replace('    normal_pc_q <= normal_pc_d;',\n        '    if (reset || squash_candidate || (ordinary_accept && (\"'!ordinary_last || predict_taken)))'\"\\\\n'\n        '      normal_pc_q <= normal_pc_d;')\n    path.write_text(source)\nPY\npython3 \\\"\"'$TMPDIR/bench-lane-probe/time.py\" lookahead-ce,1 lookahead-epoch-ce,1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
