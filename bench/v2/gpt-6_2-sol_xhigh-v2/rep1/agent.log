{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'scratch=/srv/hwebench/tmp/7cb5c576/335030a4/predictor.awlJ62Gn\npython3 - \"$scratch\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport json\nimport sys\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(sys.argv[1])\ndef run(variant):\n    results = build_all(Path.cwd(), scratch / variant, 'fpga/core_bench_si.sv',\n                        scratch / f'timing_{variant}')\n    print(variant, json.dumps(summarize(results)), flush=True)\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    list(pool.map(run, ['rtl_btic4', 'rtl_btic6', 'rtl_btic7']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
