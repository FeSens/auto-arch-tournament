ogic [31:0] seq_pc;\n  logic [ENTRIES-1:0] valid;\n  logic [TAG_BITS-1:0] tags [0:ENTRIES-1];\n  logic [17:0] targets [0:ENTRIES-1];\n  logic [1:0] counters [0:ENTRIES-1];\n  logic [INDEX_BITS-1:0] fetch_index, update_index;\n  logic [TAG_BITS-1:0] fetch_tag, update_tag;\n  logic source_ok, hit, bypass;\n  logic [31:0] prediction;\n\n  assign seq_pc = pc + 32'd4;\n  assign {fetch_tag, fetch_index} = pc[19:2];\n  assign {update_tag, update_index} = training.source;\n  assign source_ok = pc[31:20] == 0 && pc[1:0] == 0;\n  assign hit = source_ok && valid[fetch_index] && tags[fetch_index] == fetch_tag;\n  assign prediction = hit && counters[fetch_index][1]\n                    ? {12'b0, targets[fetch_index], 2'b00}\n                    : seq_pc;\n  assign bypass = training.valid && fetch_index == update_index;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      pc <= '0;\n    else if (redirect)\n      pc <= redirect_target;\n    else if (\"'!stall)\n      pc <= prediction;\n\n    if (reset)\n      valid <= '\"'0;\n    else if (training.valid && training.taken)\n      valid[update_index] <= 1'b1;\n\n    if (\"'!reset && training.valid) begin\n      counters[update_index] <= training.counter;\n      if (training.taken) begin\n        tags[update_index] <= update_tag;\n        targets[update_index] <= training.target;\n      end\n    end\n  end\n\n  assign imem_addr = pc;\n  assign out.pc = pc;\n  assign out.instr = imem_data;\n  assign out.seq_pc = seq_pc;\n  assign out.btb_hit = bypass ? (source_ok && fetch_tag == update_tag) : hit;\n  assign out.btb_counter = bypass ? training.counter : counters[fetch_index];\n  assign out.valid = ready;\nendmodule\n\"\"\")\n\nupdate(\"id_stage.sv\", [\n    (\"  id_ex_t reg_q;\", \"\"\"  id_ex_t reg_q;\n  logic [31:0] direct_imm;\n  assign direct_imm = in.instr[3]\n       ? {{11{in.instr[31]}}, in.instr[31], in.instr[19:12], in.instr[20], in.instr[30:21], 1'\"'b0}\n       : {{19{in.instr[31]}}, in.instr[31], in.instr[7], in.ins