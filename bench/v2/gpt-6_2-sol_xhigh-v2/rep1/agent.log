\\\"-T\\\", \\\"-p\\\",\n     \\\"read_verilog -sv /dev/stdin; hierarchy -top proof; proc; flatten; opt; sat -verify -prove valid 1 -show-inputs\\\"],\n    input=source, text=True, check=True,\n)\nPY\"", "aggregated_output": "Traceback (most recent call last):\n  File \"<stdin>\", line 59, in <module>\n  File \"<stdin>\", line 53, in module\nKeyError: 'squash_candidate'\n", "exit_code": 1, "status": "failed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"set -o pipefail\npython3 - <<'PY' | yosys -Q -T -p 'read_verilog -sv /dev/stdin; hierarchy -top proof; proc; flatten; opt; sat -verify -prove valid 1 -show-inputs' | tail -25\nimport pathlib\nimport re\nimport subprocess\n\nrtl = \\\"cores/bench/rtl/if_stage.sv\\\"\nbaseline = subprocess.check_output([\\\"git\\\", \\\"show\\\", f\\\"HEAD:{rtl}\\\"], text=True)\ncandidate = pathlib.Path(rtl).read_text()\ninputs = \\\"\\\"\\\"\ninput logic reset, training_taken, taken_target_bypass, predict_on_taken, predict_on_not_taken,\ninput logic hold_id, hold_mem, fetch_parked, imem_ready,\ninput fetch_resolution_t fetch_resolution,\ninput btb_training_t btb_training,\ninput logic [31:0] normal_pc_q,\ninput logic [17:0] ordinary_table_target,\ninput logic replay_armed_q, replay_bitmap_write_q, replay_write_q,\ninput logic [9:0] replay_write_index_q,\ninput logic [4:0] replay_last_bank_q,\ninput logic [7:0] replay_tag,\ninput logic [31:0] replay_read_slots_q, replay_last_slots_q, replay_bank_valid_q,\n\\\"\\\"\\\"\nports = \\\", \\\".join(re.sub(r\\\"input \\\\w+ (?:\\\\[\\\\d+:\\\\d+\\\\] )?\\\", \\\"\\\", inputs).strip().strip(\\\",\\\").split())\n# Restore whitespace without inserting an extra comma after existing separators.\nports = re.sub(r\\\",\\\\s*,\\\", \\\",\\\", ports)\ncommon = \\\"\\\"\\\"\nrecover_target recover_fallthrough squash_candidate ordinary_index ordinary_in_range\nordinary_plus4 ordinary_last ordinary_accept predict_taken corrected_accept\ntarget_plus4 fallthrough_plus4 target_last fallthrough_last target_pc_d fallthrough_pc_d\nreplay_collision replay_read_bank replay_hit normal_pc_d\n\\\"\\\"\\\".split()\nold_only = \\\"\\\"\\\"\nordinary_taken_target ordinary_sequential ordinary_base_pc ordinary_taken_pc\nordinary_not_taken_pc use_taken_pc use_not_taken_pc replay_slots_read\n\\\"\\\"\\\".split()\nenables = \\\"\\\"\\\"\nselect_hold select_plus4 select_table_target select_pending_target\nselect_corrected_target select_corrected_fallthrough\n\\\"\\\"\\\".split()\nnew_only = [\n    \\\"replay_read_slot_valid\\\", \\\"replay_last_slot_valid\\\", \\\"replay_slot_valid\\\",\n    \\\"select_ordinary\\\", *enables,\n]\n\nprint(pathlib.Path(\\\"cores/bench/rtl/core_pkg.sv\\\").read_text())\nfor name, source, internals in [(\\\"old\\\", baseline, old_only), (\\\"new\\\", candidate, new_only)]:\n    widths = {}\n    for width, names in re.findall(r\\\"\"'^  logic'\"\\\\s+(\\\\[\\\\d+:\\\\d+\\\\])?\\\\s*([\\\\w, ]+);\\\", source, re.M):\n        widths.update({part.strip(): width for part in names.split(\\\",\\\")})\n    assignments = dict(re.findall(r\\\"\"'^  assign ('\"\\\\w+) = (.*?);\\\", source, re.M | re.S))\n    print(f\\\"module {name}_if({inputs} output [31:0] normal_pc_d, output ordinary_accept, replay_hit, one_hot);\\\")\n    for signal in [*common, *internals]:\n        if signal not in (\\\"normal_pc_d\\\", \\\"ordinary_accept\\\", \\\"replay_hit\\\"):\n            print(f\\\"wire {widths[signal] if signal \"'!= '\"'squash_candidate' else ''} {signal};\\\")\n        print(f\\\"assign {signal} = {assignments[signal]};\\\")\n    value = f\\\"\"'$onehot({{{'\"', '.join(enables)}, reset}})\\\" if name == \\\"new\\\" else \\\"1'b1\\\"\n    print(f\\\"assign one_hot = {value};\\\\nendmodule\\\")\n\nprint(f\\\"module proof({inputs} output valid);\\\")\nfor name in [\\\"old\\\", \\\"new\\\"]:\n    print(f\\\"wire [31:0] {name}_pc; wire {name}_accept, {name}_hit, {name}_one_hot;\\\")\n    print(f\\\"{name}_if i_{name}({ports}, {name}_pc, {name}_accept, {name}_hit, {name}_one_hot);\\\")\nprint(\\\"assign valid = old_pc == new_pc && old_accept == new_accept && old_hit == new_hit && old_one_hot && new_one_hot;\\\\nendmodule\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
