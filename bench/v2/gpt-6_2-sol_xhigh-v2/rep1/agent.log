{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/test/test_pipeline.py')\ns = p.read_text()\ns = s.replace('ready_load_forwards_to_add', 'ready_load_replays_for_add')\ns = s.replace('x1 = mem[0]; forwarded on the ready edge', 'x1 = mem[0]; replay the dependent add')\ns = s.replace('assert add[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1', 'assert add[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 2')\ns = s.replace('assert [r[\\\"cycle\\\"] for r in rets[1:]] == list(range(load[\\\"cycle\\\"], load[\\\"cycle\\\"] + 7))',\n              'assert shift[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 2\\\\n    assert [r[\\\"cycle\\\"] for r in rets[2:]] == list(range(shift[\\\"cycle\\\"], shift[\\\"cycle\\\"] + 6))')\ns = s.replace('assert [r[\\\"cycle\\\"] for r in rets[1:5]] == list(range(load[\\\"cycle\\\"], load[\\\"cycle\\\"] + 4))',\n              'assert mul_first[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 2\\\\n    assert [r[\\\"cycle\\\"] for r in rets[2:5]] == list(range(mul_first[\\\"cycle\\\"], mul_first[\\\"cycle\\\"] + 3))')\ns = s.replace('assert jalr[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1', 'assert jalr[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 2')\ns = s.replace('assert fetches[start:start + 9] == (\\\\n        [(8, False, False)] * 4 + [(8, False, True)]',\n              'assert fetches[start:start + 10] == (\\\\n        [(8, False, False)] * 4 + [(8, False, True), (8, True, True)]')\ns = s.replace('# The ready load response feeds divider launch on the same edge.\\\\n    assert div[\\\"cycle\\\"] - load[\\\"cycle\\\"] == 9',\n              '# The divider launches after one load replay cycle.\\\\n    assert div[\\\"cycle\\\"] - load[\\\"cycle\\\"] == 10')\na = s.index('@cocotb.test()\\\\nasync def stalled_load_releases_branch_recovery')\ns = s[:a] + '''@cocotb.test()\n@cocotb.parametrize(stall_cycles=[0, 5])\nasync def load_replay_preserves_an_older_writeback_operand(dut, stall_cycles):\n    program = [ADDI(2, 0, 0x100), LW(1, 0, 0x40), SUB(3, 2, 1), EBREAK()]\n    reads = []\n    rets, _ = await _run(dut, program, {0x40: 7}, load_stall_cycles=stall_cycles, reads=reads)\n    _check_retirements(rets, [0, 4, 8, 12])\n    producer, load, subtract, _ = rets\n    assert load[\\\"cycle\\\"] == producer[\\\"cycle\\\"] + stall_cycles + 1\n    assert subtract[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 2\n    assert (subtract[\\\"rs1_rdata\\\"], subtract[\\\"rs2_rdata\\\"], subtract[\\\"rd_wdata\\\"]) == (0x100, 7, 0xF9)\n    assert reads == [0x40]\n\n\n@cocotb.test()\n@cocotb.parametrize(stall_cycles=[0, 4])\nasync def pointer_load_and_signed_branch_keep_the_direct_bypass(dut, stall_cycles):\n    blt = _b(8, 0, 2, 0b100, 0b1100011)\n    program = [LW(1, 0, 0x40), LW(2, 1, 4), blt, SW(2, 0, 0x44), EBREAK()]\n    reads, writes = [], []\n    rets, _ = await _run(dut, program, {0x40: 0x50, 0x54: 0x80000000},\n                         load_stall_cycles=stall_cycles, reads=reads, writes=writes)\n    _check_retirements(rets, [0, 4, 8, 16])\n    pointer, value, branch, _ = rets\n    assert value[\\\"cycle\\\"] == pointer[\\\"cycle\\\"] + 1\n    assert (value[\\\"rs1_rdata\\\"], value[\\\"rd_wdata\\\"]) == (0x50, 0x80000000)\n    assert branch[\\\"cycle\\\"] == value[\\\"cycle\\\"] + 1\n    assert (branch[\\\"rs1_rdata\\\"], branch[\\\"pc_next\\\"]) == (0x80000000, 16)\n    assert reads == [0x40, 0x54]\n    assert writes == []\n\n\n''' + s[a:]\np.write_text(s)\nPY\npython3 -m pytest -q cores/bench/test > cocotb.stdout 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
