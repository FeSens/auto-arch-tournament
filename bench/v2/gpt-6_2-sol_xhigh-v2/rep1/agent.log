{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"sed -n '140,205p' cores/bench/test/test_alu.py; tail -n 10 formal-final.log; rg -c 'DONE \\\\(PASS' formal-final.log; date -Is\"","aggregated_output":"    await _check(dut, ALU_SRL, 0xFFFFFFFF, 0x25, 0x07FFFFFF)   # shamt masked\n\n\n@cocotb.test()\nasync def sra(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRA, 0x80000000, 1, 0xC0000000)\n    await _check(dut, ALU_SRA, 0x80000000, 31, 0xFFFFFFFF)\n    await _check(dut, ALU_SRA, 0x7FFFFFFF, 1, 0x3FFFFFFF)\n\n\n@cocotb.test()\nasync def lui(dut):\n    await _setup(dut)\n    await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n\n\n@cocotb.test()\nasync def mul(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MUL, 3, 4, 12)\n    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\n\n\n@cocotb.test()\nasync def mulh(dut):\n    await _setup(dut)\n    # INT_MIN * 2 = -2^32; high half = -1\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    # INT_MIN * INT_MIN = 2^62; high half = 0x40000000\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 1, 1, 0)\n\n\n@cocotb.test()\nasync def mulhu(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n\n\n@cocotb.test()\nasync def mulhsu(dut):\n    await _setup(dut)\n    # signed -2^31 * unsigned (2^32-1) = -2^63 + 2^31 = 0x8000_0000_8000_0000\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    # (-1) * unsigned -> high half is sign extension\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 10, 3, 3)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)      # -4/2 = -2\n    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)      # 7/-2 = -3 (trunc to 0)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0, 0xFFFFFFFF)\n\n\nSBY 16:44:33 [insn_xor_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:00:03 (3)\nSBY 16:44:33 [insn_xor_ch0] summary: Elapsed process time [H:MM:SS (secs)]: 0:00:02 (2)\nSBY 16:44:33 [insn_xor_ch0] summary: engine_0 (smtbmc bitwuzla) returned pass\nSBY 16:44:33 [insn_xor_ch0] summary: engine_0 did not produce any traces\nSBY 16:44:33 [insn_xor_ch0] DONE (PASS, rc=0)\nSBY 16:44:33 [insn_xori_ch0] engine_0: ##   0:00:01  Status: passed\nSBY 16:44:33 [insn_xori_ch0] engine_0: finished (returncode=0)\nSBY 16:44:33 [insn_xori_ch0] engine_0: Status returned by engine: pass\nSBY 16:44:33 [insn_xori_ch0] summary: Elapsed clock time [H:MM:SS (secs)]: 0:00:02 (2)\nSBY 16:44:33 [insn_xori_ch0] summary: Elapsed proce47\n2026-11-19T16:45:15+01:00\n","exit_code":0,"status":"completed"}}
