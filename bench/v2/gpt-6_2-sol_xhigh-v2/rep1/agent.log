{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r6s0_shifts.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil, os, sys\nbase = Path(os.environ[\\\"TMPDIR\\\"])\nname = sys.argv[1]\nr = base / f\\\"r6s0-{name}\\\"\nshutil.copytree(base / \\\"r6s0-btbsplit/rtl\\\", r / \\\"rtl\\\", dirs_exist_ok=True)\ndef edit(name, fn):\n    p = r / \\\"rtl\\\" / f\\\"{name}.sv\\\"\n    p.write_text(fn(p.read_text()))\n\nif name == \\\"barrel\\\":\n    def alu(s):\n        old=s[s.index(\\\"  always_comb begin\\\\n    case (op)\\\\n      ALU_SLL: shift_result\\\"):s.index(\\\"  always_comb begin\\\\n\\\\n    case (op)\\\\n      ALU_ADD\\\")]\n        return s.replace(old, \\\"\\\"\\\"  logic shift_left;\n  logic [31:0] shift_input, right_shift;\n  logic signed [32:0] shift_signed;\n  assign shift_left = op == ALU_SLL;\n  assign shift_signed = \"'$signed({(op == ALU_SRA) && a[31], shift_input});\n  assign right_shift = 32'\"'(shift_signed >>> shamt);\n  for (genvar i = 0; i < 32; i++) begin : shift_bits\n    assign shift_input[i] = shift_left ? a[31-i] : a[i];\n    assign shift_result[i] = shift_left ? right_shift[31-i] : right_shift[i];\n  end\n\n\\\"\\\"\\\")\n    edit(\\\"alu\\\",alu)\n\nif name.startswith(\\\"chunk\\\"):\n    split = int(name.removeprefix(\\\"chunk\\\"))\n    def pkg(s):\n        n = 5 - split\n        stage = \\\"    data = src;\\\\n\\\"\n        for k in range(n):\n            shift = 2 ** (split + k)\n            stage += f\\\"\\\"\\\"    if (coarse[{k}])\n      data = left ? data << {shift} : arithmetic ? \"'$unsigned($signed(data) >>> {shift}) : data >> {shift};\n\"\"\"\n        return s.replace(\"  // EX/MEM register payload.\", f\"\"\"  function automatic [31:0] finish_shift(\n    input logic [31:0] src,\n    input logic [{n-1}:0] coarse,\n    input logic left,\n    input logic arithmetic\n  );\n    logic [31:0] data;\n{stage}    finish_shift = data;\n  endfunction\n\n  // EX/MEM register payload.\"\"\").replace(\"    logic        shift_select;\",f\"\"\"    logic        shift_select;\n    logic [{n-1}:0]  shift_coarse;\n    logic        shift_left;\n    logic        shift_arith;\"\"\")\n    edit(\"core_pkg\",pkg)\n    def alu(s):\n        s = s.replace(\"a << shamt;\",f\"a << shamt[{split-1}:0];\").replace(\"a >> shamt;\",f\"a >> shamt[{split-1}:0];\").replace(\">>> shamt);\",f\">>> shamt[{split-1}:0]);\")\n        return s.replace(\"32'\"'b0 : shift_result;\\\",f\\\"32'b0 : finish_shift(shift_result, shamt[4:{split}], op == ALU_SLL, op == ALU_SRA);\\\")\n    edit(\\\"alu\\\",alu)\n    def ex(s):\n        return s.replace(\\\"      reg_q.shift_select  <= shift_select;\\\",f\\\"\\\"\\\"      reg_q.shift_select  <= shift_select;\n      reg_q.shift_coarse  <= alu_b[4:{split}];\n      reg_q.shift_left    <= in.ctrl.alu_op == ALU_SLL;\n      reg_q.shift_arith   <= in.ctrl.alu_op == ALU_SRA;\\\"\\\"\\\")\n    edit(\\\"ex_stage\\\",ex)\n    def core(s):\n        s=s.replace(\\\"  logic [31:0] fwd_alu_result;\\\", \\\"\\\"\\\"  logic [31:0] fwd_alu_result, finished_shift;\n  assign finished_shift = finish_shift(ex_mem_w.shift_result, ex_mem_w.shift_coarse,\n                                       ex_mem_w.shift_left, ex_mem_w.shift_arith);\\\"\\\"\\\").replace(\\\"? ex_mem_w.shift_result :\\\", \\\"? finished_shift :\\\")\n        return s.replace(\\\"    .in          (ex_mem_w),\\\",\\\"    .in          (ex_mem_w),\\\\n    .finished_shift(finished_shift),\\\")\n    edit(\\\"core\\\",core)\n    def mem(s):\n        return s.replace(\\\"  input  ex_mem_t  in,\\\", \\\"  input  ex_mem_t  in,\\\\n  input  logic [31:0] finished_shift,\\\").replace(\\\"& in.shift_result\\\", \\\"& finished_shift\\\")\n    edit(\\\"mem_stage\\\",mem)\nPY\nfor variant in barrel chunk3 chunk4; do\n  python3 \\\"\"'$TMPDIR/r6s0_shifts.py\" \"$variant\"\ndone\npython3 -u - <<'\"'PY'\nimport os\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\ndef run(v):\n scratch = Path(os.environ[\\\"TMPDIR\\\"]) / (\\\"r6s0-\\\" + v)\n res = build_all(Path.cwd(), scratch / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", scratch / \\\"gowin\\\")\n print(v, summarize(res), flush=True)\n for r in res[:2]:\n  print(v, r[\\\"place_option\\\"], r.get(\\\"critical_paths\\\", [])[:2], flush=True)\nwith ThreadPoolExecutor(3) as ex:\n list(ex.map(run, (\\\"barrel\\\", \\\"chunk3\\\", \\\"chunk4\\\")))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
