t;\n  assign park_next = pc == 32'\"'h000ffffc && (squash_candidate || \"'!predict_taken);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      request_q <= '\"'0;\n      parked_q <= 1'b0;\n    end else if (accepted || squash_candidate) begin\n      parked_q <= accepted && park_next;\n      if (\"'!accepted || park_next)\n        request_q <= pc;\n      else if (squash_candidate)\n        request_q <= corrected_plus4;\n      else\n        request_q <= predicted_pc;\n    end\n  end\n\n  always_comb begin\n    out.pc       = use_head ? {12'\"'b0, head_word, 2'b00} : pc;\n    out.pc_plus4 = use_head ? ({12'b0, head_word, 2'b00} + 32'd4)\n                            : (squash_candidate ? corrected_plus4 : request_plus4);\n    out.instr    = use_head ? packet_q[0][31:0] : imem_data;\n  end\nendmodule\nSV\nRTL_DIR=\\\"\"'$scratch/rtl\" OBJ_DIR=\"$scratch/obj_fifo\" NRET=1 bash test/cosim/build.sh > \"$scratch/build_fifo.log\" 2>&1 &&\n\"$scratch/obj_fifo/cosim_sim\" \"$scratch/coremark.elf\" 10000000 --bench --istall --dstall'", "aggregated_output": "{\"order\":2937036,\"cycle\":3839120,\"insn\":1048691,\"pc_rdata\":20,\"pc_wdata\":24,\"rd_addr\":0,\"rd_wdata\":0,\"rs1_addr\":0,\"rs1_rdata\":0,\"rs2_addr\":1,\"rs2_rdata\":20,\"mem_addr\":0,\"mem_rmask\":0,\"mem_rdata\":196887,\"mem_wmask\":0,\"mem_wdata\":20,\"trap\":0,\"halt\":0,\"intr\":0,\"mode\":3,\"ixl\":1}\n{\"ebreak\":true,\"maxcycles_hit\":false,\"oob\":false,\"bench_start_cycle\":14277,\"bench_stop_cycle\":3833164,\"bench_bracketed\":true,\"uart\":\"2K performance run parameters for coremark.\\nCoreMark Size    : 666\\nTotal ticks      : 0\\nTotal time (secs): 10\\nIterations/Sec   : 1\\nIterations       : 10\\nCompiler version : riscv32-elf-gcc\\nCompiler flags   : -O2 -march=rv32im\\nMemory location  : STACK\\nseedcrc          : 0xe9f5\\n[0]crclist       : 0xe714\\n[0]crcmatrix     : 0x1fd7\\n[0]crcstate      : 0x8e3a\\n[0]crcfinal      : 0xfcaf\\nCorrect operation validated. See README.md for run