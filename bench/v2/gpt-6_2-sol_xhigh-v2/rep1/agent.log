{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport os\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nroot = Path(os.environ['TMPDIR']) / 'bench-lane-probe'\njobs = [(name, option) for name in ('tags', 'selects') for option in (1, 0, 2)]\ndef run(job):\n    name, option = job\n    out = root / f'{name}-gowin-{option}'\n    result = build('.', root / name, 'fpga/core_bench_si.sv', option, out)\n    print(name, option, result.get('fmax_mhz'), result.get('logic'), (result.get('critical_paths') or [result.get('reason')])[:2], flush=True)\n    return result\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    results = list(executor.map(run, jobs))\nfor default, name in enumerate(('tags', 'selects')):\n    print(name, summarize(results[3*default:3*(default+1)]), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
