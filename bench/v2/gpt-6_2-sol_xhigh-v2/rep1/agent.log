{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$TMPDIR/bench-r4.0dDtU0\"\ncat > \"$scratch/patch.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1])\ndef update(name, replacements):\n    p = rtl / name\n    src = p.read_text()\n    for old,new in replacements:\n        assert src.count(old) == 1, (name, old[:60], src.count(old))\n        src = src.replace(old,new)\n    p.write_text(src)\n\nalu = (rtl / 'alu.sv').read_text()\nmul_start = alu.index('\"'`ifndef RISCV_FORMAL_ALTOPS'\"')\nmul_end = alu.index('  // Phase 0', mul_start)\nalu = alu[:mul_start] + alu[mul_end:]\nalu = alu.replace('logic [63:0] partial_q, after_first, after_radix4_a, after_radix4_b, after_five;',\n'''logic [63:0] partial_q, after_first, after_radix4_a, after_radix4_b;\n  logic [63:0] first_two, first_four, first_six;\n  logic [8:0] small_d;\n  logic [9:0] small_3d;''')\nlo = alu.index('  function automatic [63:0] restoring_step(')\nhi = alu.index('  assign signed_div', lo)\nalu = alu[:lo] + '''  function automatic [63:0] leading_step(\n    input logic [63:0] partial,\n    input logic [8:0] divisor,\n    input logic [9:0] triple_divisor\n  );\n    logic [7:0] shifted, remainder;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [10:0] t1, t2, t3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic d0, d1, d2, d3;\n    begin\n      shifted = partial[37:30];\n      t1 = {3'b0, shifted} - {2'b0, divisor};\n      t2 = {3'b0, shifted} - {1'b0, divisor, 1'b0};\n      t3 = {3'b0, shifted} - {1'b0, triple_divisor};\n      d0 = t1[10];\n      d1 = \"'!t1[10] && t2[10];\n      d2 = !t2[10] && t3[10];\n      d3 = !t3[10];\n      remainder = ({8{d0}} & shifted) | ({8{d1}} & t1[7:0])\n                | ({8{d2}} & t2[7:0]) | ({8{d3}} & t3[7:0]);\n      leading_step = {24'\"'b0, remainder, partial[29:0], d2 | d3, d1 | d3};\n    end\n  endfunction\n\n''' + alu[hi:]\nalu = alu.replace('  assign after_first = first_step(partial_q[31:0], divisor_q);',\n'''  assign small_d = |divisor_q[31:8] ? 9'd256 : {1'b0, divisor_q[7:0]};\n  assign small_3d = {1'b0, small_d} + {small_d, 1'b0};\n  assign first_two = first_step(partial_q[31:0], divisor_q);\n  assign first_four = leading_step(first_two, small_d, small_3d);\n  assign first_six = leading_step(first_four, small_d, small_3d);\n  assign after_first = leading_step(first_six, small_d, small_3d);''')\nalu = alu.replace('  assign after_five = restoring_step(after_radix4_b, divisor_q);\\\\n','').replace('partial_q <= after_five;', 'partial_q <= after_radix4_b;')\nlo=alu.index('\"'`ifndef RISCV_FORMAL_ALTOPS'\"',alu.index('always_comb'))\nhi=alu.index('    case (op)',lo)\nalu = alu[:lo] + alu[hi:]\nlo=alu.index('\"'`else'\"\\\\n      ALU_MUL:')\nhi=alu.index('\"'`endif'\"',lo)\nalu = alu[:lo] + alu[hi:]\n(rtl / 'alu.sv').write_text(alu)\n\nupdate('core_pkg.sv', [('    logic [31:0] effective_addr;',\n'''    logic        mul_late;\n    logic        mul_high;\n    logic [31:0] mul_ll;\n    logic [32:0] mul_lh;\n    logic [32:0] mul_hl;\n    logic [31:0] mul_hh;\n    logic [31:0] effective_addr;''')])\nupdate('ex_stage.sv', [('  // ── Branch resolve',\n'''  logic is_mul;\n  assign is_mul = in.ctrl.alu_op >= ALU_MUL && in.ctrl.alu_op <= ALU_MULHSU;\n\n\"'`ifndef RISCV_FORMAL_ALTOPS\n  logic signed [16:0] a_lo, b_lo, a_hi, b_hi;\n  logic [31:0] mul_ll, mul_hh;\n  logic [32:0] mul_lh, mul_hl;\n  assign a_lo = $signed({1'\"'b0, rs1[15:0]});\n  assign b_lo = \"'$signed({1'\"'b0, rs2[15:0]});\n  assign a_hi = \"'$signed({rs1[31] && (in.ctrl.alu_op == ALU_MULH\n                                   || in.ctrl.alu_op == ALU_MULHSU), rs1[31:16]});\n  assign b_hi = $signed({rs2[31] && in.ctrl.alu_op == ALU_MULH, rs2[31:16]});\n  assign mul_ll = 32'\"'(a_lo * b_lo);\n  assign mul_lh = 33'(a_lo * b_hi);\n  assign mul_hl = 33'(a_hi * b_lo);\n  assign mul_hh = 32'(a_hi * b_hi);\n\"'`else\n  wire [31:0] mul_ll = '\"'0, mul_hh = '0;\n  wire [32:0] mul_lh = '0, mul_hl = '0;\n\"'`endif\n\n  // ── Branch resolve'\"'''),\n('      reg_q.effective_addr <= base_plus_imm;',\n'''      reg_q.mul_late      <= ex_ready && is_mul;\n      reg_q.mul_high      <= in.ctrl.alu_op \"'!= ALU_MUL;\n      reg_q.mul_ll        <= mul_ll;\n      reg_q.mul_lh        <= mul_lh;\n      reg_q.mul_hl        <= mul_hl;\n      reg_q.mul_hh        <= mul_hh;\n      reg_q.effective_addr <= base_plus_imm;'\"''')])\nupdate('mem_stage.sv', [('  // ── MEM/WB register',\n'''  logic [31:0] writeback_result;\n\"'`ifndef RISCV_FORMAL_ALTOPS\n  logic [47:0] row_hh_ll, row_lh, row_hl, mul_sum, mul_carry, mul_upper;\n  assign row_hh_ll = {in.mul_hh, in.mul_ll[31:16]};\n  assign row_lh = {{15{in.mul_lh[32]}}, in.mul_lh};\n  assign row_hl = {{15{in.mul_hl[32]}}, in.mul_hl};\n  assign mul_sum = row_hh_ll ''^ row_lh ''^ row_hl;\n  assign mul_carry = ((row_hh_ll & row_lh) | (row_hh_ll & row_hl) | (row_lh & row_hl)) << 1;\n  assign mul_upper = mul_sum + mul_carry;\n  assign writeback_result = in.mul_late\n                          ? (in.mul_high ? mul_upper[47:16] : {mul_upper[15:0], in.mul_ll[15:0]})\n                          : in.alu_result;\n`else\n  assign writeback_result = in.alu_result;\n`endif\n\n  // ── MEM/WB register'\"'''),\n('reg_q.alu_result <= in.alu_result;', 'reg_q.alu_result <= writeback_result;')])\nupdate('core.sv', [('  hazard_unit u_hazard', '''  logic id_ex_late_result;\n  assign id_ex_late_result = id_ex_w.valid && (id_ex_w.ctrl.mem_read\n                          || (id_ex_w.ctrl.alu_op >= ALU_MUL && id_ex_w.ctrl.alu_op <= ALU_MULHSU));\n  hazard_unit u_hazard'''),\n('    .id_ex_load     (id_ex_w.valid && id_ex_w.ctrl.mem_read),','    .id_ex_load     (id_ex_late_result),'),\n('    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),','    .ex_mem_w_en (ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.mul_late),'\"')])\nPY\npython \\\"\"'$scratch/patch.py\" \"$scratch/cores/bench/rtl\"\npython -m tools.eval.gowin bench --worktree \"$scratch\" --all-options --paths 