 `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n2:# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n3:# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n6:# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n32:RISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n34:# riscv-formal checkout (the K concurrent agents of a run share it through\n115:    echo \"ERROR: formal/riscv-formal not found. Clone it:\"\n116:    echo \"  git clone https://github.com/YosysHQ/riscv-formal $SCRIPT_DIR/riscv-formal\"\n195:JOBS=\"${JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)}\"\n196:echo \"=== make -j$JOBS -k ===\" | tee -a \"$LOG\"\n202:make -j\"$JOBS\" -k -f makefile 2>&1 \\\nFilesystem      Size  Used Avail Use% Mounted on\n/dev/md2        905G  747G  113G  87% /srv/hwebench/tmp/7cb5c576/c762fcba\n","exit_code":0,"status":"completed"}}
