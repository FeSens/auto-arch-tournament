{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c 'scratch_dir=\"$TMPDIR/predictor.ycL9kF\"\nRTL_DIR=\"$scratch_dir/final4\" OBJ_DIR=\"$scratch_dir/obj-final4\" NRET=1 bash test/cosim/build.sh > \"$scratch_dir/obj-final4.log\" 2>&1 &&\nPYTHONDONTWRITEBYTECODE=1 python - \"$scratch_dir\" <<'\"'PY'\nimport json, subprocess, sys\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval import cosim, fpga\nscratch=Path(sys.argv[1])\nsim=str(scratch/'obj-final4'/'cosim_sim')\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    jobs = [pool.submit(cosim.run_one, scratch/(name+'.elf'), sim, str(Path.cwd()), None, flags)\n        for name in ('selftest','random1','random2','random3') for flags in cosim.TRACE_STALL_MODES]\n    tests = [j.result() for j in jobs]\nfor result in tests: print(result)\nassert all(t['passed'] for t in tests)\nrun=subprocess.run([sim, str(scratch/'coremark.elf'), '50000000', *fpga.COREMARK_SIM_FLAGS],\n                   check=True, capture_output=True, text=True)\nmarker=json.loads(run.stdout.splitlines()[-1])\nvalid, reason = fpga.validate_coremark_uart(marker['uart'], 10)\nassert valid, reason\nprint(marker['bench_stop_cycle']-marker['bench_start_cycle'], 'bracketed cycles')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
