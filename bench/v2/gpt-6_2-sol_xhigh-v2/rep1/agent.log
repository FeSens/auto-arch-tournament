{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\n\nroot = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"divider-deep/formal/riscv-formal/cores/bench-SignedDeep/checks\\\"\nfor name in (\\\"div\\\", \\\"rem\\\"):\n    vcd = root/f\\\"insn_{name}_ch0/engine_0/trace.vcd\\\"\n    ids, events, scopes = {}, {}, []\n    wanted = (\\\"rs1_rdata\\\", \\\"rs2_rdata\\\", \\\"rd_wdata\\\", \\\"spec_rd_wdata\\\", \\\"rvfi_insn\\\", \\\"rvfi_valid\\\")\n\n    def display(time):\n        if time \"'!= 200:\n            return\n        for key in wanted:\n            print(key, f\"0x{events[ids[key]]:08x}\")\n\n    for line in vcd.open():\n        fields = line.split()\n        if not fields:\n            continue\n        if fields[0] == \"$scope\":\n            scopes.append(fields[2])\n        elif fields[0] == \"$upscope\":\n            scopes.pop()\n        elif fields[0] == \"$var\" and scopes == [\"rvfi_testbench\", \"checker_inst\"] and fields[4] in wanted:\n            ids[fields[4]] = fields[3]\n        elif fields[0].startswith(\"#\"):\n            if \"time\" in locals():\n                display(time)\n            time = int(fields[0][1:])\n        elif line.startswith(\"b\") and len(fields) == 2 and fields[1] in ids.values():\n            events[fields[1]] = int(fields[0][1:], 2)\n    print(name)\n    a, b = (events[ids[k]] for k in (\"rs1_rdata\", \"rs2_rdata\"))\n    sa, sb = (x - (1 << 32) if x & (1 << 31) else x for x in (a,b))\n    q = abs(sa)//abs(sb) * (-1 if (sa < 0) != (sb < 0) else 1)\n    print(f\"Signed quotient 0x{q & 0xffffffff:08x}, signed remainder 0x{(sa - sb*q) & 0xffffffff:08x}\")\n    print(f\"Unsigned quotient 0x{a//b:08x}, unsigned remainder 0x{a%b:08x}\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
