t (shift[\"rs1_rdata\"], shift[\"rd_wdata\"]) == (0xFFFFFF81, 0xFFFFFFF0)\n    assert (add[\"rs1_rdata\"], add[\"rs2_rdata\"], add[\"rd_wdata\"]) == (\n        0xFFFFFFF0, 0xFFFFFFF0, 0xFFFFFFE0,\n    )\n    assert (sub[\"rs1_rdata\"], sub[\"rs2_rdata\"], sub[\"rd_wdata\"]) == (\n        0xFFFFFFE0, 0xFFFFFFF0, 0xFFFFFFF0,\n    )\n    assert auipc[\"rd_wdata\"] == 0x1014\n    assert (add_pc[\"rs1_rdata\"], add_pc[\"rs2_rdata\"], add_pc[\"rd_wdata\"]) == (\n        0x10\n…[4319 of 7391 chars elided by tools/bench/transcript.py; sha256:f6ee56f02661d596]…\nn (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        signed = op in (ALU_DIV, ALU_REM)\n        for _ in range(64):\n            a = rng.getrandbits(32)\n            b = rng.getrandbits(rng.randrange(33))\n            if signed:\n                if a >= (1 << 31):\n                    a -= 1 << 32\n                b = (b & 0x7FFFFFFF) * rng.choice((-1, 1))\n            if b == 0:\n                quotient, remainder = MASK32, a\n            else:\n                quotient, remainder = divmod(abs(a), abs(b))\n                if (a < 0) != (b < 0):\n                    quotient = -quotient\n                if a < 0:\n                    remainder = -remainder\n            expected = remainder if op in (ALU_REM, ALU_REMU) else quotient\n            await _check_div(dut, op, a, b, expected)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n20:\"hyp-20261119-001-r7s0\"\n", "exit_code": 0, "status": "completed"}}
