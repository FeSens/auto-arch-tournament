{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\n\nchecked = 0\nfor reset, ready, dmem_stall, div_wait, ex_valid, ex_load, redirect, rd_match in product((False, True), repeat=8):\n    if (ex_load or redirect or div_wait) and not ex_valid:\n        continue\n    if sum((ex_load, redirect, div_wait)) > 1:\n        continue\n    front_hold = dmem_stall or div_wait\n    old_load_use = ex_load and ready and not redirect and rd_match\n    old_stall_if = old_load_use or not ready or front_hold\n    old_stall_id = front_hold or old_load_use\n    old_flush_id = (old_load_use or redirect) and not front_hold\n    if reset or old_flush_id:\n        old_id_valid = False\n    elif old_stall_id:\n        old_id_valid = ex_valid\n    else:\n        old_id_valid = ready and not redirect\n\n    new_load_use = ex_valid and ex_load and ready and rd_match\n    new_stall_if = new_load_use or not ready or front_hold\n    new_id_valid = not reset and (ex_valid if front_hold else ready and not new_load_use and not redirect)\n\n    assert old_id_valid == new_id_valid\n    assert old_stall_if == new_stall_if\n    checked += 1\nprint(f'Equivalent PC hold and ID/EX validity over {checked} legal control combinations')\nPY\npython3 - <<'PY'\nfmax_mhz = 46.963\ncycles = 4_491_485\nprint(f'Baseline implied fitness {10 * fmax_mhz * 1e6 / cycles:.2f} iter/s')\nprint(f'4.6% threshold {fmax_mhz * 1.046:.5f} MHz, 12% target {fmax_mhz * 1.12:.5f} MHz')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
