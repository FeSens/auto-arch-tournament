{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c 'set -eu\nprofile_dir=/srv/hwebench/tmp/7cb5c576/9e820270/fetch-profile.aoWAwx\nfor variant in last-commit last-bypass sticky-commit; do\n  mkdir -p \"$profile_dir/$variant-rtl\"\n  cp cores/bench/rtl/*.sv \"$profile_dir/$variant-rtl/\"\ndone\npython3 - \"$profile_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nbase = Path(sys.argv[1])\nfor variant in ('last-commit', 'last-bypass', 'sticky-commit'):\n    p = base/f'{variant}-rtl/ex_stage.sv'\n    s = p.read_text()\n    start = s.index('  logic train_valid,')\n    end = s.index('  assign training_taken',start)\n    s = s[:start] + '''  logic train_valid, train_target_q;\n  logic [17:0] train_pc_word_q;\n  \n''' + s[end:]\n    start = s.index('  assign train_valid')\n    end = s.index('  // Keep the comparison',start)\n    not_taken_write = 'resolve_valid_q && train_target_q' if variant.startswith('last') else \\\"1'b0\\\"\n    s = s[:start] + f'''  assign train_valid = \"'!in.ctrl.is_illegal && in.pc[31:20] == 12'\"'b0 && in.pc[1:0] == 2'b00\n                    && (in.ctrl.is_branch || in.ctrl.is_jump);\n  assign btb_training.pc_word = train_pc_word_q;\n  assign btb_training.target_word = target_q[19:2];\n  assign btb_training.taken = {{resolve_valid_q && train_target_q, resolve_valid_q && train_target_q, 2'b11}};\n  assign btb_training.not_taken = {{{not_taken_write}, {not_taken_write}, 2'b00}};\n\n''' + s[end:]\n    start = s.index('    train_taken_counter_q')\n    end = s.index('\\\\n  end', start)\n    s = s[:start] + s[end:]\n    p.write_text(s)\n    p = base/f'{variant}-rtl/if_stage.sv'\n    s = p.read_text()\n    start = s.index('  logic        ordinary_same_index,')\n    end = s.index('  logic          replay_armed_q;',start)\n    s = s[:start] + '''  logic        ordinary_same_index, ordinary_table_hit, ordinary_bypass_hit, table_taken;\n  logic        predict_on_table, predict_on_bypass;\n  btb_a