{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c 'bench_scratch=$(mktemp -d \"$TMPDIR/bench-r12s0.XXXXXXXX\")\nmkdir -p \"$bench_scratch/grouped\"\ncp -r cores/bench/rtl \"$bench_scratch/grouped/\"\ncat > \"$bench_scratch/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1])\nalu = rtl / \\\"alu.sv\\\"\nold = alu.read_text()\n\nhelper = \\\"\\\"\\\"  function automatic [32:0] grouped_trial(\n    input logic [34:0] lhs,\n    input logic [34:0] rhs\n  );\n    logic [3:0] gen_borrow, propagate_borrow;\n    logic [3:1] borrow;\n    logic [31:0] sum_zero, sum_one, result_bits;\n    begin\n      for (int i = 0; i < 4; i++) begin\n        gen_borrow[i] = lhs[i*8 +: 8] < rhs[i*8 +: 8];\n        propagate_borrow[i] = lhs[i*8 +: 8] == rhs[i*8 +: 8];\n        sum_zero[i*8 +: 8] = lhs[i*8 +: 8] - rhs[i*8 +: 8];\n        sum_one[i*8 +: 8] = lhs[i*8 +: 8] - rhs[i*8 +: 8] - 8'd1;\n      end\n      borrow[1] = gen_borrow[0];\n      borrow[2] = gen_borrow[1]\n                | (propagate_borrow[1] & gen_borrow[0]);\n      borrow[3] = gen_borrow[2]\n                | (propagate_borrow[2] & gen_borrow[1])\n                | ((&propagate_borrow[2:1]) & gen_borrow[0]);\n      result_bits[7:0] = sum_zero[7:0];\n      for (int i = 1; i < 4; i++)\n        result_bits[i*8 +: 8] = borrow[i] ? sum_one[i*8 +: 8] : sum_zero[i*8 +: 8];\n      grouped_trial = {\n        (lhs[34:32] < rhs[34:32])\n          | ((lhs[34:32] == rhs[34:32])\n            & (gen_borrow[3]\n              | (propagate_borrow[3] & gen_borrow[2])\n              | ((&propagate_borrow[3:2]) & gen_borrow[1])\n              | ((&propagate_borrow[3:1]) & gen_borrow[0]))),\n        result_bits\n      };\n    end\n  endfunction\n\n\\\"\\\"\\\"\nout = old.replace(\\\"  function automatic [63:0] radix4_step(\\\", helper + \\\"  function automatic [63:0] radix4_step(\\\")\nout = out.replace(\\\"logic [34:0] trial_one, trial_two, trial_three;\\\", \\\"