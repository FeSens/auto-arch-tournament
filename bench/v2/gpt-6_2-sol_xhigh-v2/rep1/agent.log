{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nbase=Path('cores/bench/rtl')\n\ndef edit(filename, replacements):\n    path=base/filename\n    source=path.read_text()\n    for before, after in replacements:\n        assert source.count(before)==1, (filename,before)\n        source=source.replace(before,after)\n    path.write_text(source)\n\npath=base/'forward_unit.sv'\npath.write_text(\\\"\\\"\\\"// Youngest eligible producer wins. The two youngest data lanes share a comparison.\nmodule forward_unit (\n  input  logic [4:0] id_ex_rs1,\n  input  logic [4:0] id_ex_rs2,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_alu_w_en,\n  input  logic       ex_mem_load_w_en,\n  input  logic [4:0] mem_wb_rd,\n  input  logic       mem_wb_w_en,\n  output logic [3:0] fwd_rs1,\n  output logic [3:0] fwd_rs2\n);\n  function automatic [3:0] select_operand(input logic [4:0] rs);\n    logic match_mem, from_alu, from_load, from_wb;\n    begin\n      match_mem = rs \"'!= 5'\"'b0 && rs == ex_mem_rd;\n      from_alu = match_mem && ex_mem_alu_w_en;\n      from_load = match_mem && ex_mem_load_w_en;\n      from_wb = \"'!(from_alu || from_load) && rs != 5'\"'b0 && rs == mem_wb_rd && mem_wb_w_en;\n      select_operand = {from_load, from_wb, from_alu, \"'!(from_alu || from_load || from_wb)};\n    end\n  endfunction\n\n  assign fwd_rs1 = select_operand(id_ex_rs1);\n  assign fwd_rs2 = select_operand(id_ex_rs2);\nendmodule\n\"\"\")\n\nedit('\"'ex_stage.sv', [\n(\\\"logic [1:0]         fwd_rs1_sel\\\",\\\"logic [3:0]         fwd_rs1_sel\\\"),\n(\\\"logic [1:0]         fwd_rs2_sel\\\",\\\"logic [3:0]         fwd_rs2_sel\\\"),\n(\\\"  input  logic [31:0]        fwd_mem_wb,\\\", \\\"  input  logic [31:0]        fwd_load,\\\\n  input  logic [31:0]        fwd_mem_wb,\\\"),\n(\\\"\\\"\\\"  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\\\"\\\"\\\",\n\\\"\\\"\\\"  assign rs1 = ({32{fwd_rs1_sel[0]}} & in.rs1_val)\n             | ({32{fwd_rs1_sel[1]}} & fwd_ex_mem)\n             | ({32{fwd_rs1_sel[2]}} & fwd_mem_wb)\n             | ({32{fwd_rs1_sel[3]}} & fwd_load);\n  assign rs2 = ({32{fwd_rs2_sel[0]}} & in.rs2_val)\n             | ({32{fwd_rs2_sel[1]}} & fwd_ex_mem)\n             | ({32{fwd_rs2_sel[2]}} & fwd_mem_wb)\n             | ({32{fwd_rs2_sel[3]}} & fwd_load);\\\"\\\"\\\")])\n\nedit('core_pkg.sv', [\n(\\\"\\\"\\\"    logic [31:0] alu_result;\n    logic [31:0] read_data;      // sign/zero-extended load (for regfile write)\\\"\\\"\\\",\n\\\"\\\"\\\"    logic [31:0] writeback_data;\\\"\\\"\\\")])\n\nedit('mem_stage.sv', [\n(\\\"  output logic               dmem_ren,\\\",\\\"  output logic               dmem_ren,\\\\n  output logic [31:0]        load_data,\\\\n  output logic               load_w_en,\\\"),\n(\\\"  logic [31:0] load_data;\\\\n\\\",\\\"\\\"),\n(\\\"  // ── MEM/WB register\\\", \\\"  assign load_w_en = in.valid && in.ctrl.mem_read && ctrl_with_trap.reg_write;\\\\n\\\\n  // ── MEM/WB register\\\"),\n(\\\"\\\"\\\"      reg_q.alu_result <= in.alu_result;\n      reg_q.read_data  <= load_data;\\\"\\\"\\\",\n\\\"\\\"\\\"      reg_q.writeback_data <= in.ctrl.mem_to_reg ? load_data : in.alu_result;\\\"\\\"\\\")])\n\nedit('wb_stage.sv', [\n(\\\"in.ctrl.mem_to_reg ? in.read_data : in.alu_result\\\",\\\"in.writeback_data\\\")])\n\nedit('core.sv', [\n(\\\"  logic [1:0] fwd_rs1_sel, fwd_rs2_sel;\\\", \\\"  logic [3:0] fwd_rs1_sel, fwd_rs2_sel;\\\\n  logic [31:0] fwd_load;\\\\n  logic load_w_en;\\\"),\n(\\\"    .fwd_mem_wb      (wb_w_data),\\\",\\\"    .fwd_load        (fwd_load),\\\\n    .fwd_mem_wb      (wb_w_data),\\\"),\n(\\\"    .dmem_ren   (io_dmemREn),\\\",\\\"    .dmem_ren   (io_dmemREn),\\\\n    .load_data  (fwd_load),\\\\n    .load_w_en  (load_w_en),\\\"),\n(\\\"\\\"\\\"    .id_ex_load     (id_ex_w.valid && id_ex_w.ctrl.mem_read),\n    .id_ex_rd       (id_ex_w.rd),\n    .if_id_rs1      (if_id_w.instr[19:15]),\n    .if_id_rs2      (if_id_w.instr[24:20]),\n\\\"\\\"\\\",\\\"\\\"),\n(\\\"    .ex_mem_w_en (ex_mem_w.ctrl.reg_write),\\\",\n \\\"\\\"\\\"    .ex_mem_alu_w_en (ex_mem_w.ctrl.reg_write && \"'!ex_mem_w.ctrl.mem_read),\n    .ex_mem_load_w_en (load_w_en),\"\"\")])\n\nedit('\"'hazard_unit.sv', [\n(\\\"\\\"\\\"  input  logic       id_ex_load,        // valid load in EX\n  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n\\\"\\\"\\\",\\\"\\\"),\n(\\\"  logic load_use_hazard;\\\\n\\\",\\\"\\\"),\n(\\\"\\\"\\\"  assign load_use_hazard = imem_ready && id_ex_load && id_ex_rd \"'!= 5'\"'b0\n                        && (id_ex_rd == if_id_rs1 || id_ex_rd == if_id_rs2);\n  assign fetch_ready = imem_ready && \"'!load_use_hazard;\"\"\",\"  assign fetch_ready = imem_ready;\")])\nPY\nmake lint TARGET=bench'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
