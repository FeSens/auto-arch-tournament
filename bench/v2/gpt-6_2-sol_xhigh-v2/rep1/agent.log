{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_pipeline.py')\ns=p.read_text()\ns=s.replace('load-use stall, blocking divides','load forwarding, blocking divides')\ns=s.replace('async def load_use_stalls(dut):','async def load_use_forwards(dut):')\ns=s.replace('load-use must stall once.', 'load-use must forward without a bubble.')\ns=s.replace('uses x1 next cycle -> stall','uses x1 next cycle')\ns=s.replace('    [r2] = _by_insn(rets, ADD(2, 1, 4))', '    [r2] = _by_insn(rets, ADD(2, 1, 4))\\\\n    [load] = _by_insn(rets, LW(1, 0, 0))\\\\n    assert r2[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1')\ns=s.replace('Eight extra EX cycles, one load-use bubble and the normal issue gap.', 'Eight extra EX cycles and the normal issue gap.')\ns=s.replace('div[\\\"cycle\\\"] - load[\\\"cycle\\\"] == 10', 'div[\\\"cycle\\\"] - load[\\\"cycle\\\"] == 9')\ns=s.replace('store[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 2','store[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1')\ns=s.replace('dut, program, dmem_init=None, max_cycles=200, *, store_stall_cycles=0,','dut, program, dmem_init=None, max_cycles=200, *, store_stall_cycles=0, load_stall_cycles=0,')\ns=s.replace('    held_store = None\\\\n\\\\n    cocotb','    held_store = None\\\\n    held_load_addr = None\\\\n\\\\n    cocotb')\ns=s.replace('        dut.io_dmemReady.value = int(not stall_store)', '''        load_request = bool(dut.io_dmemREn.value)\n        stall_load = load_request and load_stall_cycles > 0\n        if held_load_addr is not None:\n            assert load_request and da == held_load_addr\n        held_load_addr = da if stall_load else None\n        if stall_load:\n            load_stall_cycles -= 1\n        dut.io_dmemReady.value = int(not (stall_store or stall_load))''')\ns=s.replace('        dut.io_dmemRData.value = dmem.get(da & ~3, 0)','        dut.io_dmemRData.value = 0xDEADBEEF if stall_load else dmem.get(da & ~3, 0)')\ns += '''\n\n@cocotb.test()\nasync def stalled_load_forwards_on_ready_edge_to_both_operands(dut):\n    program = [ADDI(1, 0, 12), LW(1, 0, 0x40), SW(1, 1, 0), EBREAK()]\n    writes = []\n    rets, _ = await _run(dut, program, {0x40: 0x80}, load_stall_cycles=5, writes=writes)\n    _check_retirements(rets, [0, 4, 8, 12])\n    before, load, store, _ = rets\n    assert load[\\\"cycle\\\"] == before[\\\"cycle\\\"] + 6\n    assert store[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1\n    assert store[\\\"rs1_rdata\\\"] == store[\\\"rs2_rdata\\\"] == 0x80\n    assert writes == [(0x80, 0xF, 0x80)]\n\n\n@cocotb.test()\nasync def trapped_load_allows_older_writer_to_forward(dut):\n    program = [ADDI(1, 0, 23), LW(1, 0, 0x42), ADD(2, 1, 1), EBREAK()]\n    rets, _ = await _run(dut, program)\n    _check_retirements(rets, [0, 4, 8, 12])\n    _, load, add, _ = rets\n    assert load[\\\"trap\\\"] and load[\\\"rd\\\"] == 0 and load[\\\"mem_rmask\\\"] == 0\n    assert add[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1\n    assert add[\\\"rd_wdata\\\"] == 46\n'''\np.write_text(s)\nPY\npytest -q cores/bench/test > cocotb-v2.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
