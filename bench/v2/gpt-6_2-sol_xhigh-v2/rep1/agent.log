       | fwd_load_rs2;''', ''' & in.rs2_val);'''),\n    ('is_div && \"'!stall && !div_busy'\"', 'is_div && \"'!stall && !load_wait && !div_busy'\"'),\n    ('is_div && \"'!stall && div_valid'\"', 'is_div && \"'!stall && !load_wait && div_valid'\"'),\n    ('''  logic        branch_cond;\n  logic        control_taken, take_target, target_aligned, misalign_fault;''', '''  logic        branch_cond;\n  logic        jump_aligned, misalign_fault;\n  logic        train_branch_q, train_jump_q, control_taken;\n  logic [2:0]  branch_op_q;'''),\n    ('''  logic [3:0] branch_byte_eq, branch_byte_lt;''', '''  logic [3:0] branch_byte_eq_q, branch_byte_lt_q;\n  logic branch_sign_same_q, branch_lhs_sign_q;'''),\n    ('''    assign branch_byte_eq[i] = rs1[i*8 +: 8] == rs2[i*8 +: 8];\n    assign branch_byte_lt[i] = rs1[i*8 +: 8] < rs2[i*8 +: 8];''', '''    always_ff @(posedge clock) begin\n      branch_byte_eq_q[i] <= branch_rs1[i*8 +: 8] == branch_rs2[i*8 +: 8];\n      branch_byte_lt_q[i] <= branch_rs1[i*8 +: 8] < branch_rs2[i*8 +: 8];\n    end'''),\n    ('''  assign branch_eq = &branch_byte_eq;\n  assign branch_lt = branch_byte_lt[3]\n                  || (branch_byte_eq[3] && branch_byte_lt[2])\n                  || ((&branch_byte_eq[3:2]) && branch_byte_lt[1])\n                  || ((&branch_byte_eq[3:1]) && branch_byte_lt[0]);\n  assign branch_signed_lt = (rs1[31] == rs2[31]) ? branch_lt : rs1[31];''', '''  assign branch_eq = &branch_byte_eq_q;\n  assign branch_lt = branch_byte_lt_q[3]\n                  || (branch_byte_eq_q[3] && branch_byte_lt_q[2])\n                  || ((&branch_byte_eq_q[3:2]) && branch_byte_lt_q[1])\n                  || ((&branch_byte_eq_q[3:1]) && branch_byte_lt_q[0]);\n  assign branch_signed_lt = branch_sign_same_q ? branch_lt : branch_lhs_sign_q;'''),\n    ('case (in.ctrl.branch_op)', 'case (branch_op_q)'),\n    ('''  assign target_aligned = target[1:0] == 2'b00;\n  assign control_taken = in.ctrl.is_jump || (in.ctrl.is_branch && branch_cond);\n  assign m