   partial_q\\\")\n    append = \\\"\\\\n\\\".join(f\\\"      odd_multiple_q[{d//2}] <= {expr};\\\" for d, expr in arith.items())\n    anchor = \\\"      triple_divisor_q <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\\\"\n    alu = alu.replace(anchor, anchor + \\\"\\\\n\\\" + append)\nelif sys.argv[1].startswith(\\\"div-seg\\\"):\n    length = int(sys.argv[1].rsplit(\\\"-\\\", 1)[-1])\n    chunks = [(min(length, 35-low),low) for low in range(0,35,length)]\n    size = len(chunks)\n    impl = f\\\"\\\"\\\"\n  function automatic [34:0] segmented_subtract(\n    input logic [34:0] aa,\n    input logic [34:0] bb\n  );\n    logic [{size-2}:0] generate_borrow, propagate;\n    logic [{size-1}:0] borrow;\n\\\"\\\"\\\"\n    for idx,(width,offset) in enumerate(chunks):\n        impl += f\\\"    logic [{width}:0] diff_{idx};\\\\n\\\"\n    impl += \\\"    begin\\\\n      borrow[0] = 1'b0;\\\\n\\\"\n    for idx,(width,offset) in enumerate(chunks[:-1]):\n        impl += f\\\"      generate_borrow[{idx}] = aa[{offset} +: {width}] < bb[{offset} +: {width}];\\\\n\\\"\n        impl += f\\\"      propagate[{idx}] = aa[{offset} +: {width}] == bb[{offset} +: {width}];\\\\n\\\"\n        terms = []\n        for n in range(idx,-1,-1):\n            terms.append(\\\"(\\\"+\\\" && \\\".join([f\\\"generate_borrow[{n}]\\\",*(f\\\"propagate[{i}]\\\" for i in range(n+1,idx+1))])+\\\")\\\")\n        impl += f\\\"      borrow[{idx+1}] = \\\"+\\\" || \\\".join(terms)+\\\";\\\\n\\\"\n    for idx,(width,offset) in enumerate(chunks):\n        impl += f\\\"      diff_{idx} = {{aa[{offset} +: {width}], 1'b0}} - {{bb[{offset} +: {width}], borrow[{idx}]}};\\\\n\\\"\n        impl += f\\\"      segmented_subtract[{offset} +: {width}] = diff_{idx}[{width}:1];\\\\n\\\"\n    impl += \\\"    end\\\\n  endfunction\\\\n\\\"\n    alu = alu.replace(\\\"  function automatic [63:0] radix4_step(\\\", impl + \\\"\\\\n  function automatic [63:0] radix4_step(\\\")\n    for n,term in [(\\\"one\\\",\\\"{3'b0, divisor}\\\"),