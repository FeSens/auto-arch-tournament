{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'root=\"$TMPDIR\"\nref=\"$root/bench-r9s0.0vwvuFVy\"\nfor variant in bench-r9-keep bench-r9-or; do\n  mkdir -p \"$root/$variant/cores/bench\"\n  cp -r \"$ref/Makefile\" \"$ref/bench\" \"$ref/test\" \"$ref/fpga\" \"$root/$variant/\"\n  cp -r \"$ref/cores/bench/core.yaml\" \"$ref/cores/bench/test\" \"$ref/cores/bench/rtl\" \"$root/$variant/cores/bench/\"\ndone\npython - <<'\"'PY'\nimport os\nfrom pathlib import Path\nroot = Path(os.environ['TMPDIR'])\nfor probe, or_gate in [('bench-r9-keep', False), ('bench-r9-or', True)]:\n    path = root / probe / 'cores/bench/rtl/ex_stage.sv'\n    s = path.read_text().replace('  logic [31:0] rs1_fallback, rs2_fallback;', '  (* syn_keep = 1 *) logic [31:0] rs1_fallback, rs2_fallback;').replace('  logic [31:0] alu_a_fallback, alu_b_fallback;', '  (* syn_keep = 1 *) logic [31:0] alu_a_fallback, alu_b_fallback;')\n    if or_gate:\n        s = s.replace('fwd_rs1_sel.result.load ? fwd_load : rs1_fallback', \\\"rs1_fallback | (fwd_rs1_sel.result.load ? fwd_load : 32'b0)\\\")\n        s = s.replace('fwd_rs2_sel.result.load ? fwd_load : rs2_fallback', \\\"rs2_fallback | (fwd_rs2_sel.result.load ? fwd_load : 32'b0)\\\")\n        s = s.replace('alu_a_load ? fwd_load : alu_a_fallback', \\\"alu_a_fallback | (alu_a_load ? fwd_load : 32'b0)\\\")\n        s = s.replace('alu_b_load ? fwd_load : alu_b_fallback', \\\"alu_b_fallback | (alu_b_load ? fwd_load : 32'b0)\\\")\n    path.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
