{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/retime_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nbase_rtl = (root / 'cores/bench/rtl/ex_stage.sv').read_text()\nlocal_rtl = (scratch / 'local/rtl/ex_stage.sv').read_text()\n\nfor name in ('retime-compare', 'retime-lanes', 'retime-carry', 'retime-carry-4'):\n    src = scratch / name / 'rtl'\n    shutil.copytree(root / 'cores/bench/rtl', src)\n    if name == 'retime-compare':\n        rtl = base_rtl.replace('  logic        target_aligned_q, match_target_q, match_fallthrough_q;',\n                               '  logic        target_aligned_q, match_fallthrough_q;\\\\n'\n                               '  logic [3:0]  match_target_parts_q;')\n        rtl = rtl.replace('fetch_resolution.match_target = match_target_q;',\n                          'fetch_resolution.match_target = (&match_target_parts_q);')\n        rtl = rtl.replace('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"',\n                          '''      for (int part = 0; part < 4; part++)\n        match_target_parts_q[part] <= \"'!fetch_parked && fetch_pc[8*part +: 8] == target[8*part +: 8];'\"''')\n    else:\n        rtl = local_rtl if name.startswith('retime-carry') else base_rtl\n        width = 4 if name.endswith('-4') else 8\n        chunks = 32 // width\n        bits_count = chunks - 1\n        rtl = rtl.replace('  logic        target_aligned_q, match_target_q, match_fallthrough_q;',\n                          '  logic        target_aligned_q, match_fallthrough_q;\\\\n'\n                          '  logic        direct_match_q, indirect_candidate_q;\\\\n'\n                          f'  logic [{bits_count}:0] indirect_match_parts_q;')\n        rtl = rtl.replace('fetch_resolution.match_target = match_target_q;',\n                          'fetch_resolution.match_target = direct_match_q || (indirect_candidate_q && (&indirect_match_parts_q));')\n        match_expr = ('(\"'!fetch_parked && (in.ctrl.is_jalr ? jalr_match : fetch_pc == in.direct_target));'\"'\n                      if name.startswith('retime-carry')\n                      else '\"'!fetch_parked && fetch_pc == target;'\"')\n        rtl = rtl.replace(f'      match_target_q      <= {match_expr}', '')\n        rtl = rtl.replace(f'      match_target_q      <= \"'!fetch_parked && (in.ctrl.is_jalr ? jalr_match : fetch_pc == in.direct_target);'\"', '')\n        rtl = rtl.replace('      match_fallthrough_q <=',\n                          '      direct_match_q      <= \"'!in.ctrl.is_jalr && !fetch_parked && fetch_pc == in.direct_target;'\"\\\\n'\n                          '      indirect_candidate_q <= in.ctrl.is_jalr && \"'!fetch_parked && !fetch_pc[0];'\"\\\\n'\n                          '      match_fallthrough_q <=')\n        if name == 'retime-lanes':\n            predicate = f\\\"fetch_pc[{width}*part +: {width}] == (jalr_sum[{width}*part +: {width}] & (part == 0 ? {width}'hfe : {width}'hff))\\\"\n        else:\n            rtl = rtl.replace('take_target, jalr_match;', 'take_target;')\n            rtl = rtl.replace('  assign jalr_match = \"'!fetch_pc[0] && (required_carry == produced_carry);'\"\\\\n', '')\n            rtl = rtl.replace('  logic [31:1] required_carry, produced_carry;',\n                              '  logic [31:0] required_carry, produced_carry;\\\\n'\n                              \\\"  assign required_carry[0] = 1'b0;\\\\n  assign produced_carry[0] = 1'b0;\\\")\n            predicate = f'required_carry[{width}*part +: {width}] == produced_carry[{width}*part +: {width}]'\n        marker = '  ctrl_t mem_ctrl;'\n        rtl = rtl.replace(marker, f'''  for (genvar part = 0; part < {chunks}; part++) begin : stage_prediction_check\n    always_ff @(posedge clock) begin\n      if (\"'!stall)\n        indirect_match_parts_q[part] <= {predicate};\n    end\n  end\n\n{marker}'\"''')\n    (src / 'ex_stage.sv').write_text(rtl)\nPY\npython3 \\\"\"'$scratch_probe_dir/retime_probe.py\" \"$scratch_probe_dir\" &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for option in (1, 2, 0)\n        for design in ('retime-compare', 'retime-lanes', 'retime-carry', 'retime-carry-4')\n    }\n    for future in as_completed(futures):\n        result = future.result()\n        print(*futures[future], result.get('fmax_mhz'), result.get('reason'),\n              (result.get('critical_paths') or [])[:2], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.completed", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/local_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nbase_rtl = (root / 'cores/bench/rtl/ex_stage.sv').read_text()\n\nlocal_logic = '''\n  // A matching target determines each carry into bits 1 to 31.\n  logic [31:1] required_carry, produced_carry;\n  assign required_carry = rs1[31:1] \"'^ in.imm[31:1] ''^ fetch_pc[31:1];\n  assign produced_carry[1] = rs1[0] & in.imm[0];\n  assign produced_carry[31:2] = (rs1[30:1] & in.imm[30:1])\n                              | ((rs1[30:1] | in.imm[30:1]) & ~fetch_pc[30:1]);\n  assign jalr_match = !fetch_pc[0] && (required_carry == produced_carry);\n'\"'''\nshort_local_logic = '''\n  // The low 12 bits determine whether the upper base needs adjustment.\n  logic [11:1] required_carry, produced_carry;\n  logic [19:0] fetch_high_adjusted;\n  logic upper_carry, high_match_same, high_match_adjusted;\n  assign required_carry = rs1[11:1] \"'^ in.imm[11:1] ''^ fetch_pc[11:1];\n  assign produced_carry[1] = rs1[0] & in.imm[0];\n  assign produced_carry[11:2] = (rs1[10:1] & in.imm[10:1])\n                              | ((rs1[10:1] | in.imm[10:1]) & ~fetch_pc[10:1]);\n  assign upper_carry = (rs1[11] & in.imm[11]) | ((rs1[11] | in.imm[11]) & ~fetch_pc[11]);\n  assign fetch_high_adjusted = fetch_pc[31:12] + (in.imm[11] ? 20'\"'d1 : 20'hf_ffff);\n  assign high_match_same = rs1[31:12] == fetch_pc[31:12];\n  assign high_match_adjusted = rs1[31:12] == fetch_high_adjusted;\n  assign jalr_match = \"'!fetch_pc[0] && (required_carry == produced_carry)\n                    && ((upper_carry == in.imm[11]) ? high_match_same : high_match_adjusted);\n'\"'''\ncommon_match = 'match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"'\nfresh_match = 'match_target_q      <= \"'!fetch_parked && (in.ctrl.is_jalr ? jalr_match : fetch_pc == in.direct_target);'\"'\nfor name in ('local', 'local-preselect', 'local-range', 'short-local'):\n    src = scratch / name / 'rtl'\n    shutil.copytree(root / 'cores/bench/rtl', src)\n    if name in ('local-range', 'short-local'):\n        rtl = (scratch / 'signed-range' / 'rtl/ex_stage.sv').read_text()\n        i = rtl.index('  // A legal JALR immediate')\n        j = rtl.index('  assign effective_addr', i)\n        rtl = rtl[:i] + (short_local_logic if name == 'short-local' else local_logic) + rtl[j:]\n    else:\n        rtl = base_rtl.replace(\n            '  logic        target_aligned, take_target;',\n            '  logic        target_aligned, take_target, jalr_match;',\n        )\n        needle = '  assign jalr_sum = rs1 + in.imm;\\\\n'\n        rtl = rtl.replace(needle, needle + local_logic)\n        if name == 'local-preselect':\n            rtl = rtl.replace(\n                common_match,\n                'match_target_q      <= (\"'!fetch_parked && in.ctrl.is_jalr && jalr_match)'\"\\\\n'\n                '                             || (\"'!fetch_parked && !in.ctrl.is_jalr && fetch_pc == in.direct_target);'\"',\n            )\n        else:\n            rtl = rtl.replace(common_match, fresh_match)\n    (src / 'ex_stage.sv').write_text(rtl)\nPY\npython3 \\\"\"'$scratch_probe_dir/local_probe.py\" \"$scratch_probe_dir\" &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for option in (1, 2, 0)\n        for design in ('local', 'local-preselect', 'local-range', 'shor