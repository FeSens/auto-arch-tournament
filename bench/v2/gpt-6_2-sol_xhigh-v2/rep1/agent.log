{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c 'scratch=/srv/hwebench/tmp/7cb5c576/335030a4/predictor.awlJ62Gn\ncp -r cores/bench/rtl \"$scratch/rtl\"\ncat > \"$scratch/edit.py\" <<'\"'PY'\nfrom pathlib import Path\n\nrtl = Path(__file__).parent / 'rtl'\ndef replace(name, pairs):\n    p = rtl / name\n    text = p.read_text()\n    for old, new in pairs:\n        assert old in text, (name, old)\n        text = text.replace(old, new)\n    p.write_text(text)\n\nreplace('core_pkg.sv', [\n    ('    logic       is_auipc;','    logic       is_auipc;\\\\n    logic       is_fence_i;'),\n    ('    logic        btb_hit;\\\\n    logic [1:0]  btb_counter;\\\\n', ''),\n    ('    logic        write_counter;\\\\n    logic        write_target;', '    logic        valid;\\\\n    logic        write_target;\\\\n    logic        branch;\\\\n    logic        taken;'),\n    ('    logic [1:0]  counter;\\\\n  } btb_update_t;', '  } btb_update_t;'),\n])\nreplace('core.sv', [\n    ('  btb_update_t       btb_update;', '  btb_update_t       btb_update;\\\\n  logic              candidate_valid, successor_valid;\\\\n  logic [31:0]       successor_pc;'),\n    ('    .advance_fetch    (fetch_ready && \"'!hold_id),'\"', '    .fetch_ready      (fetch_ready),\\\\n    .issue_ready      (\"'!hold_id),'\"\\\\n    .candidate_valid  (candidate_valid),\\\\n    .successor_pc     (successor_pc),\\\\n    .successor_valid  (successor_valid),'),\n    ('    .fetch_ready      (fetch_ready),\\\\n    .squash_candidate (squash_candidate),\\\\n    .btb_update       (btb_update),\\\\n    .in', '    .fetch_ready      (candidate_valid),\\\\n    .squash_candidate (squash_candidate),\\\\n    .in'),\n    ('    .fetch_pc         (io_imemAddr),', '    .fetch_pc         (successor_pc),\\\\n    .successor_valid  (successor_valid),'),\n])\nreplace('id_stage.sv', [\n    (\\\"  // ID uses the update's write enables, PC and counter.\\\\n  /* verilator lint_off UNUSEDSIGNAL */\