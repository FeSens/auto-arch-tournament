{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r6s0_fused.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport os\n\nr = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"r6s0-fused\\\"\nshutil.copytree(\\\"cores/bench/rtl\\\", r / \\\"rtl\\\", dirs_exist_ok=True)\ndef edit(name, fn):\n    path = r / \\\"rtl\\\" / (name + \\\".sv\\\")\n    path.write_text(fn(path.read_text()))\n\nmasks = \\\"\\\"\\\"\n  typedef struct packed {\n    logic [3:0] low;\n    logic [1:0] mid;\n    logic       word_lane;\n    logic [3:0] sign_byte;\n    logic [1:0] sign_half;\n  } load_format_t;\n\n  function automatic [31:0] format_load(input logic [31:0] data, input load_format_t fmt);\n    logic sign_byte, sign_half;\n    begin\n      sign_byte = |(fmt.sign_byte & {data[31], data[23], data[15], data[7]});\n      sign_half = |(fmt.sign_half & {data[31], data[15]});\n      format_load[7:0] = ({8{fmt.low[0]}} & data[7:0])\n                       | ({8{fmt.low[1]}} & data[15:8])\n                       | ({8{fmt.low[2]}} & data[23:16])\n                       | ({8{fmt.low[3]}} & data[31:24]);\n      format_load[15:8] = ({8{fmt.mid[0]}} & data[15:8])\n                        | ({8{fmt.mid[1]}} & data[31:24])\n                        | {8{sign_byte}};\n      format_load[31:16] = ({16{fmt.word_lane}} & data[31:16])\n                         | {16{sign_byte || sign_half}};\n    end\n  endfunction\n\n\\\"\\\"\\\"\n\ndef pkg(s):\n    return s.replace(\\\"  // EX/MEM register payload.\\\", masks + \\\"  // EX/MEM register payload.\\\").replace(\n            \\\"    logic [31:0] effective_addr;\\\", \\\"    logic [31:0] effective_addr;\\\\n    load_format_t load_format;\\\")\nedit(\\\"core_pkg\\\", pkg)\n\ndef ex_stage(s):\n    s = s.replace(\\\"  input  logic [31:0]        fwd_load,\\\", \\\"  input  logic [31:0]        fwd_load_raw,\\\\n  input  load_format_t       fwd_load_format,\\\")\n    s = s.replace(\\\"  assign rs1 = \\\", \\\"\\\"\\\"  logic [31:0] load_rs1, load_rs2;\n  assign load_rs1 = format_load(fwd_load_raw, fwd_load_format & {\"'$bits(load_format_t){fwd_rs1_sel.load}});\n  assign load_rs2 = format_load(fwd_load_raw, fwd_load_format & {$bits(load_format_t){fwd_rs2_sel.load}});\n\n  assign rs1 = \"\"\")\n    s = s.replace(\"({32{fwd_rs1_sel.load}}    & fwd_load)\", \"load_rs1\")\n    s = s.replace(\"({32{fwd_rs2_sel.load}}    & fwd_load)\", \"load_rs2\")\n    s = s.replace(\"  // ── EX/MEM register\", \"\"\"  load_format_t load_format;\n  logic half_lo, half_hi;\n  logic [3:0] byte_sel;\n  assign byte_sel[0] = in.ctrl.mem_width == 2'\"'d0 && base_plus_imm[1:0] == 2'd0;\n  assign byte_sel[1] = in.ctrl.mem_width == 2'd0 && base_plus_imm[1:0] == 2'd1;\n  assign byte_sel[2] = in.ctrl.mem_width == 2'd0 && base_plus_imm[1:0] == 2'd2;\n  assign byte_sel[3] = in.ctrl.mem_width == 2'd0 && base_plus_imm[1:0] == 2'd3;\n  assign half_lo = in.ctrl.mem_width == 2'd1 && \"'!base_plus_imm[1];\n  assign half_hi = in.ctrl.mem_width == 2'\"'d1 &&  base_plus_imm[1];\n  assign load_format.word_lane = in.ctrl.mem_width[1];\n  assign load_format.low = byte_sel | {1'b0, half_hi, 1'b0, half_lo || load_format.word_lane};\n  assign load_format.mid = {half_hi, half_lo || load_format.word_lane};\n  assign load_format.sign_byte = byte_sel & {4{in.ctrl.mem_sext}};\n  assign load_format.sign_half = {half_hi, half_lo} & {2{in.ctrl.mem_sext}};\n\n  // ── EX/MEM register\\\"\\\"\\\")\n    return s.replace(\\\"      reg_q.effective_addr <= base_plus_imm;\\\", \\\"      reg_q.effective_addr <= base_plus_imm;\\\\n      reg_q.load_format   <= load_format;\\\")\nedit(\\\"ex_stage\\\", ex_stage)\n\ndef mem_stage(s):\n    s = s.replace(\\\"  output logic [31:0]        load_data,\\\\n\\\", \\\"\\\")\n    s = s[:s.index(\\\"  logic        load_word\\\")] + \\\"  logic [31:0] load_data;\\\\n\\\" + s[s.index(\\\"  logic        select_load\\\"):]\n    s = s[:s.index(\\\"  assign load_word\\\")] + \\\"  assign load_data = format_load(dmem_rdata, in.load_format);\\\\n\\\\n\\\" + s[s.index(\\\"  assign select_load\\\"):]\n    return s\nedit(\\\"mem_stage\\\", mem_stage)\ndef core(s):\n    return s.replace(\\\"  logic [31:0] mem_load_data;\\\\n\\\", \\\"\\\").replace(\n        \\\"    .fwd_load         (mem_load_data),\\\", \\\"    .fwd_load_raw     (io_dmemRData),\\\\n    .fwd_load_format  (ex_mem_w.load_format),\\\").replace(\n        \\\"    .load_data   (mem_load_data),\\\\n\\\", \\\"\\\")\nedit(\\\"core\\\", core)\nPY\npython3 \\\"\"'$TMPDIR/r6s0_fused.py\"\npython3 -u - <<'\"'PY'\nimport os\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nscratch = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"r6s0-fused\\\"\nres = build_all(Path.cwd(), scratch / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", scratch / \\\"gowin\\\")\nprint(summarize(res))\nfor r in res:\n print(r)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
