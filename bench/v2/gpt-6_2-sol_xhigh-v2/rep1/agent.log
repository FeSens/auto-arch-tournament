{"type": "item.started", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/shift-study/fold.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os\nimport shutil\nimport sys\n\nstudy = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"shift-study\\\"\nbench = Path(\\\"cores/bench/rtl\\\")\ntemplate = str(sys.argv[1])\nfolder = study / template / \\\"rtl\\\"\nshutil.copytree(bench, folder, dirs_exist_ok=True)\ndef edit(fn, old, new):\n    p = folder / fn\n    s = p.read_text()\n    assert s.count(old) == 1, (fn, old, s.count(old))\n    p.write_text(s.replace(old,new))\n\na = \\\"A\\\" in template\nb = \\\"B\\\" in template\nregbase = \\\"id\\\" in template\n\nfor i, enabled in enumerate((a, b), start=1):\n    if not enabled:\n        continue\n    tag = [\\\"is_auipc\\\",\\\"alu_src\\\"][i-1]\n    src = [\\\"pc\\\",\\\"imm\\\"][i-1]\n    edit(\\\"ex_stage.sv\\\", f\\\"  input  fwd_sel_t           fwd_rs{i}_sel,\\\",\n         f\\\"  input  fwd_sel_t           fwd_rs{i}_sel,\\\\n  input  fwd_sel_t           raw_rs{i}_sel,\\\\n  input  logic [31:0]        raw_load_rs{i},\\\")\n    edit(\\\"core.sv\\\",f\\\"    .fwd_rs{i}_sel      (fwd_rs{i}_sel),\\\",\n         f\\\"    .fwd_rs{i}_sel      (fwd_rs{i}_sel),\\\\n    .raw_rs{i}_sel      (raw_rs{i}_sel),\\\\n    .raw_load_rs{i}     (raw_load_rs{i}),\\\")\n    edit(\\\"core.sv\\\",f\\\"    .load_rs{i}      (fwd_rs{i}_sel.result.load),\\\",\n         f\\\"    .load_rs{i}      (fwd_rs{i}_sel.result.load),\\\\n    .raw_load_rs{i}  (raw_rs{i}_sel.result.load),\\\\n    .raw_data_rs{i}  (raw_load_rs{i}),\\\")\n    edit(\\\"mem_stage.sv\\\",f\\\"  input  logic               load_rs{i},\\\",\n         f\\\"  input  logic               load_rs{i},\\\\n  input  logic               raw_load_rs{i},\\\\n  output logic [31:0]        raw_data_rs{i},\\\")\n    edit(\\\"mem_stage.sv\\\",f\\\"  assign load_data_rs{i} = format_load(dmem_rdata, in.load_format, load_rs{i});\\\",\n         f\\\"  assign load_data_rs{i} = format_load(dmem_rdata, in.load_format, load_rs{i});\\\\n  assign raw_data_rs{i} = format_load(dmem_rdata, in.load_format, raw_load_rs{i});\\\")\n    s = (folder / \\\"ex_stage.sv\\\").read_text()\n    orig = \\\"  assign rs\\\"+str(i) + \\\" =\\\" + s.split(\\\"  assign rs\\\"+str(i)+\\\" =\\\")[1].split(\\\";\\\")[0] + \\\";\\\"\n    raw = orig.replace(f\\\"assign rs{i} =\\\",f\\\"assign raw_rs{i} =\\\").replace(f\\\"fwd_rs{i}_sel\\\",f\\\"raw_rs{i}_sel\\\").replace(f\\\"fwd_load_rs{i}\\\",f\\\"raw_load_rs{i}\\\")\n    orig_value = f\\\"in.rs{i}_val\\\"\n    if regbase:\n        repl = f\\\"in.exec_rs{i}_val\\\"\n        edit(\\\"core_pkg.sv\\\",f\\\"    logic [31:0] rs{i}_val;\\\\n\\\",f\\\"    logic [31:0] rs{i}_val;\\\\n    logic [31:0] exec_rs{i}_val;\\\\n\\\")\n        repl_id = [\\\"dec_is_auipc ? in.pc : rs1_data\\\",\\\"dec_alu_src ? imm : rs2_data\\\"][i-1]\n        edit(\\\"id_stage.sv\\\",f\\\"      reg_q.rs{i}_val       <= rs{i}_data;\\\",f\\\"      reg_q.rs{i}_val       <= rs{i}_data;\\\\n      reg_q.exec_rs{i}_val  <= {repl_id};\\\")\n    else:\n        repl = f\\\"(in.ctrl.{tag} ? in.{src} : {orig_value})\\\"\n    edit(\\\"ex_stage.sv\\\",orig, f\\\"  logic [31:0] raw_rs{i};\\\\n\\\"+orig.replace(orig_value,repl)+\\\"\\\\n\\\"+raw)\n    alu_operand = [\\\"alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\\\",\\\"alu_b = in.ctrl.alu_src  ? in.imm : rs2;\\\"][i-1]\n    edit(\\\"ex_stage.sv\\\",alu_operand,f\\\"alu_{'ab'[i-1]} = rs{i};\\\")\n    edit(\\\"ex_stage.sv\\\",f\\\"div_consume ? div_rs{i}_q : rs{i};\\\",f\\\"div_consume ? div_rs{i}_q : raw_rs{i};\\\")\n    edit(\\\"core.sv\\\",f\\\"  logic [31:0] rs{i}_data_w;\\\",f\\\"  logic [31:0] rs{i}_data_w;\\\\n  fwd_sel_t raw_rs{i}_sel;\\\\n  logic [31:0] raw_load_rs{i};\\\")\n    edit(\\\"core.sv\\\",f\\\"    .fwd_rs{i}     (fwd_rs{i}_sel)\\\",f\\\"    .fwd_rs{i}     (raw_rs{i}_sel)\\\")\n    insert = f\\\"\\\"\\\"\n  always_comb begin\n    fwd_rs{i}_sel = raw_rs{i}_sel;\n    if (id_ex_w.ctrl.{tag}) begin\n      fwd_rs{i}_sel = '0;\n      fwd_rs{i}_sel.regfile = 1'b1;\n    end\n  end\n\\\"\\\"\\\"\n    edit(\\\"core.sv\\\",\\\"  // ── RVFI ──\\\",insert+\\\"\\\\n  // ── RVFI ──\\\")\nPY\npython3 \\\"\"'$TMPDIR/shift-study/fold.py\" foldABex\npython3 \"$TMPDIR/shift-study/fold.py\" foldABid\npython3 \"$TMPDIR/shift-study/fold.py\" foldBex\ncp -r cores/bench/rtl \"$TMPDIR/shift-study/base\"\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
