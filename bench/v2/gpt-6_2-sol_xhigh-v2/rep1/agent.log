{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\n\nfrom tools.eval.cosim import run_one, TRACE_STALL_MODES\nfrom tools.eval.fpga import validate_coremark_uart\n\nroot = Path(os.environ['TMPDIR']) / 'bench-lane-probe'\nprograms = root / 'programs-root/bench/programs'\ndef run(name):\n    sim = str(root / f'{name}-cosim/cosim_sim')\n    elf = programs / 'coremark.elf'\n    result = subprocess.run([sim, str(elf), '50000000', '--bench', '--istall', '--dstall'], capture_output=True, check=True, text=True)\n    marker = json.loads(result.stdout.strip().splitlines()[-1])\n    assert marker['ebreak'] and not marker['oob'] and marker['bench_bracketed'], marker\n    valid, reason = validate_coremark_uart(marker['uart'], 10)\n    assert valid, reason\n    cycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\n    print(name, f'{cycles} cycles, canonical CRCs', flush=True)\n    for test in sorted(programs.glob('*.elf')):\n        if test \"'!= elf:\n            for mode in TRACE_STALL_MODES:\n                check = run_one(test, sim, '\"'.', sim_flags=mode)\n                assert check['passed'], (name, check)\n    print(name, 'all eight short RVFI cosim cases passed', flush=True)\nwith ThreadPoolExecutor(max_workers=2) as executor:\n    list(executor.map(run, ('tags', 'selects')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
