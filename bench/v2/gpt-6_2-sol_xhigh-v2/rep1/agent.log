{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/bash -c 'proposal_scratch=/srv/hwebench/tmp/7cb5c576/5597d018/bench-r5s0.ZvzYHh\nfor variant in pc-early pc-onehot interlock interlock-all; do\n mkdir -p \"$proposal_scratch/$variant/rtl\"\n cp cores/bench/rtl/*.sv \"$proposal_scratch/$variant/rtl/\"\ndone\npython - <<'\"'PY'\nfrom pathlib import Path\np = Path('/srv/hwebench/tmp/7cb5c576/5597d018/bench-r5s0.ZvzYHh')\n\ndef edit(rtl, name, replacements):\n    path = rtl / name\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (name, old, text.count(old))\n        text = text.replace(old, new)\n    path.write_text(text)\n\nfor onehot in (False, True):\n    rtl = p/('pc-onehot' if onehot else 'pc-early')/'rtl'\n    edit(rtl,'ex_stage.sv',[\n        ('  output logic               redirect,', '  output logic               redirect,\\\\n  output logic               resolve_en,'),\n        ('  assign redirect = ex_ready && \"'!stall &&'\"', '  assign resolve_en = ex_ready && \"'!stall;'\"\\\\n  assign redirect = resolve_en &&'),\n    ])\n    if onehot:\n        edit(rtl,'ex_stage.sv',[\n            ('  output logic [31:0]        redirect_target,', '''  output logic [31:0]        taken_pc,\n  output logic [31:0]        fallthrough_pc,\n  output logic               take_target,\n  output logic               match_fallthrough,\n  output logic               match_target,'''),\n            ('  logic        control_taken, take_target, target_aligned, misalign_fault;', '  logic        control_taken, target_aligned, misalign_fault;'),\n            ('  logic        match_fallthrough, match_target, ex_ready;', '  logic        ex_ready;'),\n            ('  assign redirect_target = resolved_pc;', '  assign taken_pc = target;\\\\n  assign fallthrough_pc = in.pc_plus4;'),\n        ])\n    edit(rtl,'if_stage.sv',[\n        ('  input  logic              redirect,', '  input  logic              resolve_en,' if onehot else '  input  logic              redirect,\\\\n  input  logic              resolve_en,'),\n        ('''    if (reset)              pc <= '0;\n    else if (redirect)      pc <= redirect_target;\n    else if (advance_fetch) pc <= predicted_pc;''', '''    if (reset) pc <= '0;\n    else if (resolve_en || advance_fetch) pc <= next_pc;''' if onehot else '''    if (reset) pc <= '0;\n    else if (resolve_en || advance_fetch)\n      pc <= (advance_fetch && \"'!redirect) ? predicted_pc : redirect_target;'\"'''),\n    ])\n    if onehot:\n        edit(rtl,'if_stage.sv',[\n            ('  input  logic [31:0]       redirect_target,', '''  input  logic [31:0]       taken_pc,\n  input  logic [31:0]       fallthrough_pc,\n  input  logic              take_target,\n  input  logic              match_fallthrough,\n  input  logic              match_target,'''),\n            ('  logic [31:0] pc;', '''  logic [31:0] pc, next_pc;\n  logic select_taken, select_fallthrough, select_prediction;\n  assign select_taken = resolve_en && take_target && \"'!(advance_fetch && match_target);\n  assign select_fallthrough = resolve_en && !take_target && !(advance_fetch && match_fallthrough);\n  assign select_prediction = advance_fetch &&\n      (!resolve_en || ((take_target && match_target) || (!take_target && match_fallthrough)));\n  assign next_pc = ({32{select_taken}} & taken_pc)\n                 | ({32{select_fallthrough}} & fallthrough_pc)\n                 | ({32{select_prediction}} & predicted_pc);'\"'''),\n        ])\n    edit(rtl,'core.sv',[\n        ('  logic        redirect;', '  logic        redirect, resolve_en;'),\n        ('    .redirect        (redirect),\\\\n    .redirect_target (redirect_target),\\\\n    .btb_update', '''    .resolve_en      (resolve_en),\n    .taken_pc        (taken_pc),\n    .fallthrough_pc  (fallthrough_pc),\n    .take_target     (take_target),\n    .match_fallthrough (match_fallthrough),\n    .match_target    (match_target),\n    .btb_upd