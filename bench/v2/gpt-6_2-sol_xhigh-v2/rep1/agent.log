start)\n    range_cond = \\\" && fetch_pc[31:20] == 12'b0\\\" if source == 'compact' else \\\"\\\"\n    txt=txt[:start]+f'''      jalr_validate_q    <= in.ctrl.is_jalr && \"'!fetch_parked && !fetch_pc[0]{range_cond};\n      jalr_low_match_nocarry_q <= rs1[11:1] == offset_nocarry[10:0];\n      jalr_low_match_carry_q <= rs1[11:1] == offset_carry[10:0];\n      jalr_carry_q        <= rs1[0] && in.imm[0];\n      jalr_page_no_carry_q <= offset_nocarry[11] ? match_borrow : match_no_borrow;\n      jalr_page_carry_q   <= offset_carry[11] ? match_borrow : match_no_borrow;\n'\"'''+txt[end:]\n    path.write_text(txt)\nPY\nfor design in inverse_page inverse_page_compact; do python -m tools.eval.gowin bench --all-options --paths 3 --worktree '/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN'/\\\"\"'$design\" > '\"'/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN'/\\\"\"'$design\".timing; done'","aggregated_output":"","exit_code":0,"status":"completed"}}
