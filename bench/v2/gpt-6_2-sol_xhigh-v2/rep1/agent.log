{"type": "item.started", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c 'scratch_dir=/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U\npython - \"$scratch_dir\" <<'\"'PY'\nimport shutil\nimport sys\nfrom pathlib import Path\nroot = Path(sys.argv[1])\nfor model in ('alu', 'jalr', 'reused'):\n    out = root / f'zero-{model}' / 'rtl'\n    shutil.copytree(root/'value-zero'/'rtl', out)\n    p = out/'alu.sv'\n    data = p.read_text()\n    data = data.replace(\\\"parameter bit SPLIT_MULTIPLY = 1'b0\\\", \\\"parameter bit SPLIT_MULTIPLY = 1'b0,\\\\n  parameter bit SPLIT_DIVIDE = 1'b0\\\")\n    data = data.replace(\\\"  input  logic        div_start,\\\", \\\"  input  logic [31:0] div_a,\\\\n  input  logic [31:0] div_b,\\\\n  input  logic        div_start,\\\")\n    import re\n    before, rest = data.split(\\\"  // Phase 0\\\", 1)\n    divider, after = rest.split(\\\"  assign add_result\\\", 1)\n    divider = re.sub(r\\\"\\\\ba\\\\b(?= *[-;\\\\[):])\\\", \\\"div_lhs\\\", divider)\n    divider = re.sub(r\\\"\\\\bb\\\\b(?= *[-\"'!;'\"\\\\[):])\\\", \\\"div_rhs\\\", divider)\n    before += \\\"  logic [31:0] div_lhs, div_rhs;\\\\n  assign div_lhs = SPLIT_DIVIDE ? div_a : a;\\\\n  assign div_rhs = SPLIT_DIVIDE ? div_b : b;\\\\n\\\\n\\\"\n    p.write_text(before + \\\"  // Phase 0\\\" + divider + \\\"  assign add_result\\\" + after)\n    p = out/'ex_stage.sv'\n    data = p.read_text().replace(\\\"load_dep, retry_div, retry_consumer\\\", \\\"load_dep, retry_consumer\\\")\n    data = data.replace(\\\"&& \"'!in.ctrl.is_auipc && !in.ctrl.is_illegal;\", \"&& !in.ctrl.is_auipc && !in.ctrl.is_illegal && !select_div;\")\n    data = data.replace(\"  assign retry_div = select_div && load_dep;'\"\\\\n\\\", \\\"\\\")\n    data = data.replace(\\\"&& (select_div || load_value \"'!= prediction);\", \"&& load_value != prediction;\").replace(\" && !retry_div\", \"\")\n    data = data.replace(\"alu #(.SPLIT_MULTIPLY(1'\"'b1))\\\", \\\"alu #(.SPLIT_MULTIPLY(1'b1), .SPLIT_DIVIDE(1'b1))\\\")\n    data = data.replace(\\\"    .div_start    (div_start),\\\", \\\"    .div_a        (rs1),\\\\n    .div_b        (rs2),\\\\n    .div_start    (div_start),\\\")\n    if model == \\\"jalr\\\":\n        data = data.replace(\\\"  logic [31:0] base_plus_imm;\\\", \\\"  logic [31:0] base_plus_imm, jalr_sum;\\\")\n        data = data.replace(\\\"assign target = in.ctrl.is_jalr ? {base_plus_imm[31:1], 1'b0}\\\", \\\"assign jalr_sum = alu_rs1 + in.imm;\\\\n  assign target = in.ctrl.is_jalr ? {jalr_sum[31:1], 1'b0}\\\")\n        data = data.replace(\\\"retry_consumer = speculative_consumer && load_dep\\\", \\\"retry_consumer = (in.ctrl.is_jalr || speculative_consumer) && load_dep\\\")\n        data = data.replace(\\\"\"'!reset && advance && !in.ctrl.is_illegal\", \"!reset && advance && !retry_consumer && !in.ctrl.is_illegal\")\n    if model == \"reused\":\n        data = data.replace(\"    fetch_resolution.retry_pc           <= in.pc;'\"\\\\n\\\", \\\"\\\")\n        data = data.replace(\\\"    fetch_resolution.target            <= target;\\\", \\\"    fetch_resolution.target            <= in.ctrl.is_jump || in.ctrl.is_branch ? target : in.pc;\\\")\n        p2 = out/'core_pkg.sv'\n        p2.write_text(p2.read_text().replace(\\\"    logic [31:0] retry_pc;\\\\n\\\", \\\"\\\"))\n        p2 = out/'if_stage.sv'\n        d2 = p2.read_text().replace(\\\"= \"'!fetch_resolution.retry && fetch_resolution.valid && fetch_resolution.take_target\", \"= fetch_resolution.valid && fetch_resolution.take_target\")\n        d2 = d2.replace(\"({32{recover_target}} & fetch_resolution.target)\", \"({32{recover_target || fetch_resolution.retry}} & fetch_resolution.target)\")\n        d2 = d2.replace(\" & fetch_resolution.fallthrough)'\"\\\\n            | ({32{fetch_resolution.retry}} & fetch_resolution.retry_pc);\\\", \\\" & fetch_resolution.fallthrough);\\\")\n        p2.write_text(d2)\n    p.write_text(data)\nPY\nfor model_name in alu jalr reused; do\n  (\n    NRET=1 RTL_DIR=\\\"\"'$scratch_dir/zero-$model_name/rtl\" OBJ_DIR=\"$scratch_dir/zero-$model_name/sim\" MAKEFLAGS=-j2 bash test/cosim/build.sh > \"$scratch_dir/zero-$model_name/sim.log\" 2>&1 &&\n    \"$scratch_dir/zero-$model_name/sim/cosim_sim\" \"$scratch_dir/coremark.elf\" 50000000 --bench --istall --dstall > \"$scratch_dir/zero-$model_name/coremark.log\"\n  ) &\ndone\nPYTHONDONTWRITEBYTECODE=1 python -u - <<'\"'PY' > \\\"\"'$scratch_dir/timing-zero.log\" 2>&1 &\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nroot = Path('\"'/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U')\njobs = [(name, opt) for name in ('alu', 'jalr', 'reused') for opt in (0, 1, 2)]\ndef measure(job):\n    model, option = job\n    candidate = root / f'zero-{model}'\n    result = build(Path.cwd(), candidate/'rtl', 'fpga/core_bench_si.sv', option, candidate/f'gowin_p{option}')\n    print(model, option, {key:result.get(key) for key in ('fmax_mhz','logic','bsram','reason')}, flush=True)\n    return model, result\nresults = {}\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    for model, result in executor.map(measure, jobs):\n        results.setdefault(model, []).append(result)\nfor model, placements in results.items():\n    print(model, summarize(placements), flush=True)\nPY\nwait\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
