 == ex_rd) ? next_ex_sel : '0;\\\\n\\\"\n                              \\\"      reg_q.ex_rs2_sel    <= (rs2_addr \"'!= 5'\"'d0 && rs2_addr == ex_rd) ? next_ex_sel : '0;\\\\n\\\"\n                              '      reg_q.ex_match      <=')\n            rtl = rtl.replace(\\\"        reg_q.ex_match  <= '0;\\\",\n                              \\\"        reg_q.ex_rs1_sel <= '0;\\\\n\\\"\n                              \\\"        reg_q.ex_rs2_sel <= '0;\\\\n\\\"\n                              \\\"        reg_q.ex_match  <= '0;\\\")\n            if name == 'preselect-all':\n                rtl = rtl.replace(\\\"rs2_addr \"'!= 5'\"'b0 && rs2_addr == mem_rd,\\\",\n                                  \\\"mem_write_en && rs2_addr \"'!= 5'\"'b0 && rs2_addr == mem_rd,\\\")\n                rtl = rtl.replace(\\\"rs1_addr \"'!= 5'\"'b0 && rs1_addr == mem_rd};\\\",\n                                  \\\"mem_write_en && rs1_addr \"'!= 5'\"'b0 && rs1_addr == mem_rd};\\\")\n        elif filename == 'core.sv':\n            rtl = rtl.replace('  fwd_sel_t    fwd_rs1_sel, fwd_rs2_sel;',\n                              '  fwd_sel_t    fwd_rs1_sel, fwd_rs2_sel;\\\\n  result_sel_t next_ex_sel;')\n            rtl = rtl.replace('    .ex_rd            (id_ex_w.rd),',\n                              '    .next_ex_sel      (next_ex_sel),\\\\n'\n                              '    .mem_write_en     (mem_write_en),\\\\n'\n                              '    .ex_rd            (id_ex_w.rd),')\n            rtl = rtl.replace('    .fwd_mem_wb       (wb_w_data),',\n                              '    .fwd_mem_wb       (wb_w_data),\\\\n'\n                              '    .next_ex_sel      (next_ex_sel),')\n            rtl = rtl.replace('    .ex_mem_sel  (ex_mem_w.result_sel),',\n                              '    .ex_rs1_sel  (id_ex_w.ex_rs1_sel),\\\\n'\n                              '    .ex_rs2_sel  (id_ex_w.ex_rs2_sel),')\n        else:\n            rtl = rtl.replace('  input  result_sel_t ex_mem_sel,',\n                              '  input  result_sel_t ex_rs1_sel,\\\\n  input  result_sel_t ex_rs2_sel,')\n            if name == 'preselect':\n                rtl = rtl.replace(\\\"younger[0] ? ex_mem_sel : '0\\\", \\\"ex_mem_w_en ? ex_rs1_sel : '0\\\")\n                rtl = rtl.replace(\\\"younger[1] ? ex_mem_sel : '0\\\", \\\"ex_mem_w_en ? ex_rs2_sel : '0\\\")\n            else:\n                rtl = rtl.replace(\\\"  assign younger = ex_match & {2{ex_mem_w_en}};\\\",\n                                  \\\"  assign younger = {(|ex_rs2_sel), (|ex_rs1_sel)} & {2{ex_mem_w_en}};\\\")\n                rtl = rtl.replace(\\\"younger[0] ? ex_mem_sel : '0\\\", \\\"ex_mem_w_en ? ex_rs1_sel : '0\\\")\n                rtl = rtl.replace(\\\"younger[1] ? ex_mem_sel : '0\\\", \\\"ex_mem_w_en ? ex_rs2_sel : '0\\\")\n            if name == 'preselect-all':\n                rtl = rtl.replace(\\\"  assign older = mem_match & {2{mem_wb_w_en}};\\\",\n                                  \\\"  assign older = mem_match;\\\")\n        (src / filename).write_text(rtl)\nPY\npython3 \\\"\"'$scratch_probe_dir/forward_probe.py\" \"$scratch_probe_dir\" &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for design in ('preselect', 'preselect-writer', 'preselect-all')\n        for option in (1, 2, 0)\n    }\n    for future in as_completed(futures):\n        result = future.result()\n        print(*futures[future], result.get('fmax_mhz'), result.get('reason'),\n              (result.get('critical_paths') or [])[:2], flush=True)\nPY\"", "aggrega