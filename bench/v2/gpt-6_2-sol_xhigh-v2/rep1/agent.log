e_low, see_mid, see_high, sign_mid, sign_high;\n    begin\n      first_byte = data[{format.lane, 3'b0} +: 8];\n      second_byte = format.lane[1] ? data[31:24] : data[15:8];\n      fill = format.half_load ? second_byte[7] : first_byte[7];\n      see_low = select_load;\n      see_mid = select_load && (format.half_load || format.word_load);\n      see_high = select_load && format.word_load;\n      sign_mid = select_load && format.extend_sign && \"'!format.half_load;\n      sign_high = select_load && format.extend_sign;\n      format_load[7:0] = {8{see_low}} & first_byte;\n      format_load[15:8] = ({8{see_mid}} & second_byte) | {8{sign_mid && first_byte[7]}};\n      format_load[31:16] = ({16{see_high}} & data[31:16]) | {16{sign_high && fill}};\n    end\n\"\"\"\n if name == \"fsextindex\":\n    body=body.replace(\"logic fill, see_low\",\"logic [1:0] sext_lane;'\"\\\\n    logic fill, see_low\\\").replace(\n        \\\"fill = format.half_load ? second_byte[7] : first_byte[7];\\\",\n        \\\"sext_lane = {format.lane[1], format.lane[0] || format.half_load};\\\\n      fill = data[{sext_lane, 3'b111}];\\\")\n if name == \\\"fdatagroup\\\":\n    body=body.replace(\\\"first_byte = data[{format.lane, 3'b0} +: 8];\\\",\n        \\\"\\\"\\\"first_byte = format.lane[1]\n                 ? (format.lane[0] ? data[31:24] : data[23:16])\n                 : (format.lane[0] ? data[15:8] : data[7:0]);\\\"\\\"\\\")\ns=s[:m]+body+s[n:]\np.write_text(s)\nPY\nfor variant in frshift fsextindex fdatagroup fsign; do python3 \\\"\"'$TMPDIR/shift-study/fullformat.py\" \"$variant\"; done\ndate -u\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
