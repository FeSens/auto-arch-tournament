ction(current, \\\"  assign final_digit\\\", \\\"\"'`endif\"))\n    emit(section(previous, \"  assign magnitude\", \"`endif\").replace(\"div_result\", \"original_result\").replace(\"after_radix4_a\", \"old_after_radix4_a\"))\n    emit(\"endmodule\")\nPY\nyosys -Q -T -p \"read_verilog -sv $TMPDIR/divider-completion-equivalence.sv; prep -top final_result_equiv; sat -timeout 180 -verify -prove same_step 1 -prove same_result 1 -show-inputs\" > \"$TMPDIR/divider-completion-equivalence.log\" 2>&1\nproof_status=$?\ntail -24 \"$TMPDIR/divider-completion-equivalence.log\"\nexit \"$proof_status\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
