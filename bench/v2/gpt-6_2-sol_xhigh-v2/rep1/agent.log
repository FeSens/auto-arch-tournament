{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python - '/srv/hwebench/tmp/7cb5c576/8437e684/bench-predictor-r15s2.OsPptwTN' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\nroot=Path(sys.argv[1])\nfor name, source in [('inverse_page', 'page'),('inverse_page_compact','compact')]:\n    dst=root/name\n    (dst/'cores/bench').mkdir(parents=True)\n    shutil.copytree(root/'base/fpga',dst/'fpga')\n    shutil.copytree(root/source/'cores/bench/rtl',dst/'cores/bench/rtl')\n    shutil.copy(root/'base/cores/bench/core.yaml',dst/'cores/bench/core.yaml')\n    path=dst/'cores/bench/rtl/ex_stage.sv'\n    txt=path.read_text()\n    txt=txt.replace('  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [12:0] jalr_low_sum;\\\\n  /* verilator lint_on UNUSEDSIGNAL */',\n                    '  logic [11:0] offset_nocarry, offset_carry;')\n    txt=txt.replace('  logic        jalr_low_match_q, jalr_carry_q;\\\\n  logic        jalr_page_no_carry_q, jalr_page_carry_q;',\n'''  logic        jalr_low_match_nocarry_q, jalr_low_match_carry_q, jalr_carry_q;\n  logic        jalr_page_no_carry_q, jalr_page_carry_q;\n  logic        match_borrow, match_no_borrow, jalr_validate_q;''')\n    txt=txt.replace('  assign jalr_low_sum = {1\\\\'b0, rs1[11:0]} + {1\\\\'b0, in.imm[11:0]};',\n'''  assign offset_nocarry = {1'b0, fetch_pc[11:1]} - {1'b0, in.imm[11:1]};\n  assign offset_carry = {1'b0, fetch_pc[11:1]} + {1'b1, ~in.imm[11:1]};\n  assign match_no_borrow = in.imm[11] ? next_page : same_page;\n  assign match_borrow = in.imm[11] ? same_page : prev_page;''')\n    txt=txt.replace('''      || (jalr_low_match_q && (jalr_carry_q ? jalr_page_carry_q : jalr_page_no_carry_q));''',\n'''      || (jalr_validate_q && (jalr_carry_q\n            ? jalr_low_match_carry_q && jalr_page_carry_q\n            : jalr_low_match_nocarry_q && jalr_page_no_carry_q));''')\n    start=txt.index('      jalr_low_match_q')\n    end=txt.index('      match_fallthrough_q', st