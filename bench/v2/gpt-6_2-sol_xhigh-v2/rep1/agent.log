{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom itertools import product\nimport random\n\nword_mask = (1 << 32) - 1\nwork_mask = (1 << 36) - 1\nrng = random.Random(32)\n\ndef divider(dividend, divisor):\n    work = dividend\n    remainder = 0\n    for _ in range(6):\n        for _ in range(6):\n            trial = (remainder << 1) | (work >> 35)\n            difference = trial - divisor\n            quotient_bit = int(difference >= 0)\n            remainder = difference if quotient_bit else trial\n            work = ((work << 1) | quotient_bit) & work_mask\n    return work & word_mask, remainder\n\ndef signed(value):\n    return value - (1 << 32) if value >> 31 else value\n\nedges = [0, 1, 2, 3, 0x7fffffff, 0x80000000, 0x80000001, 0xfffffffe, 0xffffffff]\npairs = list(product(edges, repeat=2)) + [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(20000)]\nfor dividend, divisor in pairs:\n    if not divisor:\n        continue\n    assert divider(dividend, divisor) == divmod(dividend, divisor)\n    a, b = signed(dividend), signed(divisor)\n    quotient, remainder = divider(abs(a), abs(b))\n    quotient = -quotient if (a < 0) \"'!= (b < 0) else quotient\n    remainder = -remainder if a < 0 else remainder\n    assert a == b * quotient + remainder and abs(remainder) < abs(b)\n    assert not remainder or (remainder < 0) == (a < 0)\nprint(f'\"'Checked the six-round unsigned recurrence and signed correction on {len(pairs) - len(edges):,} nonzero-divisor operand pairs')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
