{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c \"sed -n '255,480p' cores/bench/test/test_alu.py; cat cores/bench/test/_helpers.py\"", "aggregated_output": "\n\n@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    \"\"\"Launch each operation on the first edge after consuming the previous one.\"\"\"\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def div_holds_result_until_consumed(dut):\n    await _setup(dut)\n    await _start_div(dut, ALU_DIV, -100, 7)\n    dut.a.value = 1\n    dut.b.value = 0\n    await _await_div_result(dut)\n    for _ in range(4):\n        assert int(dut.div_busy.value)\n        assert int(dut.div_valid.value)\n        assert int(dut.out.value) == (-14 & MASK32)\n        await _tick(dut)\n    await _consume_div(dut)\n\n\n@cocotb.test()\nasync def reset_cancels_divide(dut):\n    await _setup(dut)\n    await _start_div(dut, ALU_REMU, 100, 7)\n    for _ in range(3):\n        await _tick(dut)\n        assert int(dut.div_busy.value)\n        assert not int(dut.div_valid.value)\n    await _setup(dut)\n    for _ in range(DIV_UPDATES + 1):\n        assert not int(dut.div_busy.value)\n        assert not int(dut.div_valid.value)\n        await _tick(dut)\n    await _check_div(dut, ALU_DIVU, 57, 8, 7)\n\n\n@cocotb.test()\nasync def div_rem_radix4_boundaries(dut):\n    await _setup(dut)\n    # Cover every leading pair with each special-case divisor and with four.\n    cases = [(prefix << 30 | 0x3A5C19E7, divisor)\n             for prefix in range(4) for divisor in range(5)]\n    # Ex