{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r10-branch.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tempfile import mkdtemp\n\nfrom tools.eval.gowin import build\nfrom tools.eval.fpga import _bench_sv\n\nworktree = Path.cwd()\nbase = Path(mkdtemp(prefix='bench-r10s0-branch-', dir=os.environ['TMPDIR']))\nprint(base, flush=True)\nscratch = Path(os.environ['TMPDIR'])\nrtl = worktree / 'cores/bench/rtl'\nflat_rtl = scratch / 'bench-r10s0-fetch-hxtlf97e/scalar-flat/rtl'\nbenches = _bench_sv(str(worktree), 'bench')\n\ndef lexicographic(s, size, staggered=False):\n    a = s.index('  // Compare the forwarded operands')\n    b = s.index('  assign branch_signed_lt', a)\n    widths = list(range(0, 32, size)) + [32]\n    chunks = len(widths) - 1\n    out = f'''  logic [{chunks-1}:0] branch_chunk_lt, branch_chunk_eq;\n  logic branch_lt, branch_signed_lt;\n  logic [{chunks-1}:0] branch_terms;\n\n  for (genvar i = 0; i < 4; i++) begin : live_compare\n    assign live_byte_eq[i] = live_rs1[i*8 +: 8] == live_rs2[i*8 +: 8];\n  end\n'''\n    for i in range(chunks):\n        idx = f'[{widths[i+1]-1}:{widths[i]}]'\n        out += f'  assign branch_chunk_lt[{i}] = rs1{idx} < rs2{idx};\\\\n'\n        if i:\n            out += f'  assign branch_chunk_eq[{i}] = rs1{idx} == rs2{idx};\\\\n'\n        else:\n            out += \\\"  assign branch_chunk_eq[0] = 1'b0;\\\\n\\\"\n        eq = f' && (&branch_chunk_eq[{chunks-1}:{i+1}])' if i < chunks-1 else ''\n        out += f'  assign branch_terms[{i}] = branch_chunk_lt[{i}]{eq};\\\\n'\n    out += '  assign branch_lt = |branch_terms;\\\\n'\n    return s[:a] + out + s[b:]\n\ndef late_select(s):\n    s = s.replace('  logic        ordered_branch_cond;', '  logic        ordered_branch_cond, ordered_less_than;')\n    a = s.index('  always_comb begin\\\\n    case (in.ctrl.branch_op)')\n    b = s.index('  assign jalr_sum', a)\n    return s[:a] + '''  assign ordered_less_than = in.ctrl.branch_op[1] ? branch_lt : branch_signed_lt;\n  assign ordered_branch_cond = in.ctrl.branch_op[2] && (ordered_less_than \"'^ in.ctrl.branch_op[0]);\n\n'\"''' + s[b:]\n\ncases = {'group4': (rtl, lambda s: late_select(lexicographic(s,4))),\n         'simple-select': (rtl, late_select),\n         'flat-simple': (flat_rtl, late_select),\n         'flat-group4': (flat_rtl, lambda s: late_select(lexicographic(s,4)))}\nfor name, (input_rtl, transform) in cases.items():\n    copytree(input_rtl, base / name / 'rtl')\n    variant = base / name / 'rtl/ex_stage.sv'\n    variant.write_text(transform(variant.read_text()))\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, worktree, base / name / 'rtl', benches, p, base / name / f'gowin_p{p}'): (name, p)\n        for name in cases for p in (0, 1, 2)\n    }\n    for f in concurrent.futures.as_completed(futures):\n        r = f.result()\n        print(*futures[f], r.get('fmax_mhz'), r.get('regs'), r.get('logic'), r.get('reason'),\n              [(p['from'], p['to'], p['logic_cells']) for p in r.get('critical_paths', [])[:3]], flush=True)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-branch.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
