{"type": "item.started", "item": {"id": "item_76", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predictor-profile/miss_cache.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, re, shutil\nwork = Path(os.environ['TMPDIR']) / 'predictor-profile'\nsrc=Path('cores/bench/rtl')\ndef build(n, hysteresis):\n    rtl = work / (f'miss{n}' + ('h' if hysteresis else '') + '-rtl')\n    shutil.copytree(src, rtl, dirs_exist_ok=True)\n    w=(n-1).bit_length()\n    def edit(name, fn):\n        p=rtl/name\n        p.write_text(fn(p.read_text()))\n    edit('core_pkg.sv', lambda s: re.sub(r'  typedef struct packed \\\\{\\\\n    logic        write_counter;.*?\\\\} btb_update_t;', '''\n  typedef struct packed {\n    logic [17:0] pc_word;\n    logic [17:0] target_word;\n    logic        cacheable;\n    logic        predicted_taken;\n  } btb_training_t;''', s, flags=re.S).replace('logic        btb_hit;\\\\n    logic [1:0]  btb_counter;', 'logic        predicted_taken;'))\n    edit('core.sv', lambda s: '\\\\n'.join(l for l in s.split('\\\\n') if not any(k in l for k in ('candidate_pc','candidate_btb','btb_update','training_taken'))))\n    edit('id_stage.sv', lambda s: (\n        re.sub(r'  output logic \\\\[31:0\\\\]       candidate_pc,.*?  input  if_id_t','  input  if_id_t',s,flags=re.S)\n        .replace('  logic corrected_q;\\\\n','')\n        .replace(s[s.index('  logic same_index_update,'):s.index('  always_ff @(posedge clock)')],'')\n        .replace('      reg_q.btb_hit       <= in.btb_hit;\\\\n      reg_q.btb_counter   <= in.btb_counter;\\\\n      corrected_q        <= squash_candidate;','      reg_q.predicted_taken <= in.predicted_taken;')\n        .replace('      if (same_index_update) begin\\\\n        reg_q.btb_hit     <= btb_hit;\\\\n        reg_q.btb_counter <= btb_counter;\\\\n      end\\\\n','')\n        .replace('  always_comb begin\\\\n    out = reg_q;\\\\n    out.btb_hit = btb_hit;\\\\n    out.btb_counter = btb_counter;\\\\n  end','  assign out = reg_q;')))\n    def edit_ex(s):\n        s = s.replace('  output logic               training_taken,\\\\n','')\n        old=s[s.index('  logic train_valid,'):s.index('  assign training_taken')]\n        s=s.replace(old,'''  logic training_taken, train_cacheable_q, train_predicted_q;\n  logic [17:0] train_pc_word_q;\n\n''')\n        old=s[s.index('  assign train_valid ='):s.index('  // Keep the comparison')]\n        s=s.replace(old,'''  assign btb_training.pc_word = train_pc_word_q;\n  assign btb_training.target_word = target_q[19:2];\n  assign btb_training.cacheable = train_cacheable_q;\n  assign btb_training.predicted_taken = train_predicted_q;\n\n''')\n        old=s[s.index('    train_pc_word_q'):s.index('  ctrl_t mem_ctrl;')]\n        s=s.replace(old,'''    train_pc_word_q    <= in.pc[19:2];\n    train_cacheable_q  <= \"'!in.ctrl.is_illegal && in.pc[31:20] == 12'\"'b0 && in.pc[1:0] == 2'b00\n                       && target_aligned && target[31:20] == 12'b0;\n    train_predicted_q  <= in.predicted_taken;\n  end\n\n''')\n        return s\n    edit('ex_stage.sv', edit_ex)\n    def edit_if(s):\n        s='\\\\n'.join(l for l in s.split('\\\\n') if not any(k in l for k in ('training_taken','candidate_pc,','candidate_btb_hit,','candidate_btb_counter,','btb_update_t')))\n        s=s.replace('table_target, bypass_target;', 'table_target;').replace('select_table_target, select_bypass_target;', 'select_table_target;')\n        old=s[s.index('  logic [4:0]  ordinary_index, candidate_index'):s.index('  logic          replay_armed_q;')]\n        s=s.replace(old,f'''  logic [{w-1}:0] ordinary_index, write_index;\n  logic [{17-w}:0] write_tag, ordinary_tag;\n  logic [{n-1}:0] btb_valid;\n  logic [{35-w}:0] btb_entry [0:{n-1}];\n  logic [17:0] ordinary_table_target;\n  logic allocate_target, clear_target;\n''' + (f'''  logic [{n-1}:0] btb_missed;\n''' if hysteresis else '') + '\\\\n')\n        old=s[s.index('  assign btb_update.pc_word'):s.index('  assign ordinary_plus4')]\n        s=s.replace(old, f'''  assign {{write_tag, write_index}} = btb_training.pc_word;\n  assign ordinary_index = normal_pc_q[{w+1}:2];\n  assign ordinary_in_range = normal_pc_q[31:20] == 12'b0 && normal_pc_q[1:0] == 2'b00;\n  assign {{ordinary_tag, ordinary_table_target}} = btb_entry[ordinary_index];\n  assign predict_taken = ordinary_in_range && btb_valid[ordinary_index]\n                       && ordinary_tag == normal_pc_q[19:{w+2}];\n  assign allocate_target = recover_target && btb_training.cacheable;\n  assign clear_target = recover_fallthrough && btb_training.predicted_taken;\n\n''')\n        s=s.replace('  assign predict_taken = predict_on_table || predict_on_bypass;\\\\n','')\n        old=s[s.index('  // Corrected fetches proceed sequentially.'):s.index('  // Resolve the one-hot enables')]\n        s=s.replace(old,'')\n        s=s.replace('ordinary_can_advance && predict_on_table','ordinary_can_advance && predict_taken')\n        s='\\\\n'.join(l for l in s.split('\\\\n') if not any(k in l for k in ('select_bypass_target','  assign bypass_target', 'out.btb_')))\n        s=s.replace('replay_last_slots_q[ordinary_index] : replay_read_slots_q[ordinary_index]',\n                    'replay_last_slots_q[normal_pc_q[6:2]] : replay_read_slots_q[normal_pc_q[6:2]]')\n        old=s[s.index('  always_ff @(posedge clock) begin\\\\n    if (reset)\\\\n      btb_valid'):s.index('  assign imem_addr')]\n        if hysteresis:\n            new='''  always_ff @(posedge clock) begin\n    if (reset || fetch_resolution.refetch) begin\n      btb_valid <= '0;\n      btb_missed <= '0;\n    end else if (allocate_target) begin\n      btb_valid[write_index] <= 1'b1;\n      btb_missed[write_index] <= 1'b0;\n    end else if (clear_target) begin\n      btb_valid[write_index] <= btb_valid[write_index] && \"'!btb_missed[write_index];\n      btb_missed[write_index] <= 1'\"'b1;\n    end else if (fetch_resolution.valid && fetch_resolution.take_target\n              && fetch_resolution.match_target && btb_training.predicted_taken) begin\n      btb_missed[write_index] <= 1'b0;\n    end\n\n    if (\"'!reset && allocate_target)\n      btb_entry[write_index] <= {write_tag, btb_training.target_word};\n  end\n\n'\"'''\n        else:\n            new='''  always_ff @(posedge clock) begin\n    if (reset || fetch_resolution.refetch)\n      btb_valid <= '0;\n    else if (allocate_target || clear_target)\n      btb_valid[write_index] <= allocate_target;\n\n    if (\"'!reset && allocate_target)\n      btb_entry[write_index] <= {write_tag, btb_training.target_word};\n  end\n\n'\"'''\n        s=s.replace(old,new).replace('    out.instr       = imem_ready ? imem_data : replay_word;', '''    out.instr       = imem_ready ? imem_data : replay_word;\n    out.predicted_taken = \"'!squash_candidate && ordinary_accept && predict_taken;'\"''')\n        return s\n    edit('if_stage.sv',edit_if)\nfor n,h in [(32,False),(32,True),(64,True)]:\n    build(n,h)\nPY\npython3 \\\"\"'$TMPDIR/predictor-profile/miss_cache.py\"\nfor name in miss32 miss32h miss64h; do\n  vp=\"$TMPDIR/predictor-profile/$name-rtl\"\n  verilator --lint-only --top-module core -Wall -Wno-fatal -Wno-style \"+incdir+$vp\" \"$vp/core_pkg.sv\" $(rg --files \"$vp\" -g '\"'*.sv' | sort | rg -v '/core_pkg.sv\"'$'\"') || exit\ndone\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
