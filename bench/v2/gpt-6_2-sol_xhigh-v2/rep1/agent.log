{"type": "item.completed", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"cat formal/checks_si.cfg && rg -n 'div|32' cores/bench/test/test_alu.py | tail -n 40 && rg -n 'div|DIV' cores/bench/test/test_pipeline.py | tail -n 45\"", "aggregated_output": "[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n264:async def back_to_back_divides(dut):\n267:    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n268:    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n269:    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n270:    await _check_div(dut, ALU_REM, 10, 3, 1)\n271:    await _check_div(dut, ALU_REMU, 7, 3, 1)\n275:async def div_holds_result_until_consumed(dut):\n277:    await _start_div(dut, ALU_DIV, -100, 7)\n280:    await _await_div_result(dut)\n282:        assert int(dut.div_busy.value)\n283:        assert int(dut.div_valid.value)\n284:        assert int(dut.out.value) == (\n…[1839 of 4911 chars elided by tools/bench/transcript.py; sha256:dc6b2f25f259a03a]…\nvide_waits_for_stalled_store_and_forwards(dut):\n527:        DIV(3, 1, 2),\n542:    _, producer, store, div, add, _, _ = rets\n544:    assert div[\"cycle\"] - store[\"cycle\"] == 9\n545:    assert (div[\"rs1_addr\"], div[\"rs1_rdata\"]) == (1, 0xFFFFFF9C)\n546:    assert (div[\"rs2_addr\"], div[\"rs2_rdata\"]) == (2, 0xFFFFFFF9)\n547:    assert (div[\"rd\"], div[\"rd_wdata\"]) == (3, 14)\n548:    assert add[\"cycle\"] == div[\"cycle\"] + 1\n554:async def load_to_divide_retirement_gap(dut, stall_cycles):\n555:    program = [ADDI(2, 0, 6), LW(1, 0, 0x40), DIVU(3, 1, 2), REMU(4, 3, 2),\n560:    producer, load, div, rem, add, _ = rets\n563:    assert div[\"cycle\"] - load[\"cycle\"] == 10\n564:    assert (div[\"rs1_rdata\"], div[\"rs2_rdata\"], div[\"rd_wdata\"]) == (100, 6, 16)\n565:    assert rem[\"cycle\"] - div[\"cycle\"] == 9\n651:        0x08: DIVU(6, 2, 2),\n659:        0x68: DIVU(6, 1, 1),\n668:    # wrong-path divide's hold. Its not-taken outcome must lower the\n835:@cocotb.parametrize(wrong_path=[DIVU(6, 3, 3), SW(3, 0, 0x48)], corrected_stalls=[0, 6])\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"agent_message","text":"The first timing probes confirmed that the JALR match path can be removed from the critical path. Replay and BTB training then limited the clock. I’ll test whether exploiting JALR’s 12-bit immediate gives the split a smaller hardware footprint."}}
{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/signed_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nbase_rtl = (root / 'cores/bench/rtl/ex_stage.sv').read_text()\n\ninverse_logic = '''\n  // A legal JALR immediate is a sign-extended 12-bit value.\n  logic [10:0] inverse_low_zero, inverse_low_one;\n  logic [19:0] inverse_high_adjusted;\n  logic bit0_carry, low_matches, carry_at_bit12, high_match_same, high_match_adjusted;\n  assign bit0_carry = rs1[0] && in.imm[0];\n  assign inverse_low_zero = fetch_pc[11:1] + ~in.imm[11:1] + 11'd1;\n  assign inverse_low_one = fetch_pc[11:1] + ~in.imm[11:1];\n  assign low_matches = bit0_carry ? (rs1[11:1] == inverse_low_one)\n                                 : (rs1[11:1] == inverse_low_zero);\n  assign carry_at_bit12 = (fetch_pc[11:1] < in.imm[11:1])\n                        || ((fetch_pc[11:1] == in.imm[11:1]) && bit0_carry);\n  assign inverse_high_adjusted = fetch_pc[31:12] + (in.imm[11] ? 20'd1 : 20'hf_ffff);\n  assign high_match_same = rs1[31:12] == fetch_pc[31:12];\n  assign high_match_adjusted = rs1[31:12] == inverse_high_adjusted;\n  assign jalr_match = \"'!fetch_pc[0] && low_matches\n                    && ((carry_at_bit12 == in.imm[11]) ? high_match_same : high_match_adjusted);\n'\"'''\nsplit_target_logic = '''\n  logic [12:0] jalr_low_sum;\n  logic [19:0] adjusted_base_high;\n  assign jalr_low_sum = {1'b0, rs1[11:0]} + {1'b0, in.imm[11:0]};\n  assign adjusted_base_high = rs1[31:12] + (in.imm[11] ? 20'hf_ffff : 20'd1);\n  assign jalr_sum = {jalr_low_sum[12] == in.imm[11] ? rs1[31:12] : adjusted_base_high,\n                     jalr_low_sum[11:0]};\n'''\nrange_logic = '''\n  logic upper_carry_in_range, upper_same_in_range, upper_adjusted;\n  logic jalr_in_range, target_in_range;\n  assign upper_carry_in_range = in.imm[11] ? (|rs1[19:12] || jalr_low_sum[12])\n                                            : (&rs1[19:12] && jalr_low_sum[12]);\n  assign upper_same_in_range = rs1[31:20] == 12'b0;\n  assign upper_adjusted = in.imm[11] ? rs1[31:20] == 12'd1 : (&rs1[31:20]);\n  assign jalr_in_range = (upper_carry_in_range == in.imm[11]) ? upper_same_in_range : upper_adjusted;\n  assign target_in_range = in.ctrl.is_jalr ? jalr_in_range : in.direct_target[31:20] == 12'b0;\n'''\nfor name in ('signed-inverse', 'signed-split', 'signed-range', 'signed-forward'):\n    src = scratch / name / 'rtl'\n    shutil.copytree(root / 'cores/bench/rtl', src)\n    rtl = base_rtl.replace(\n        '  logic        target_aligned, take_target;',\n        '  logic        target_aligned, take_target, jalr_match;',\n    )\n    if name == 'signed-forward':\n        match = '''\n  logic [19:0] fetch_high_adjusted;\n  logic high_match_same, high_match_adjusted;\n  assign fetch_high_adjusted = fetch_pc[31:12] + (in.imm[11] ? 20'd1 : 20'hf_ffff);\n  assign high_match_same = rs1[31:12] == fetch_pc[31:12];\n  assign high_match_adjusted = rs1[31:12] == fetch_high_adjusted;\n  assign jalr_match = \"'!fetch_pc[0] && (jalr_low_sum[11:1] == fetch_pc[11:1])\n                    && ((jalr_low_sum[12] == in.imm[11]) ? high_match_same : high_match_adjusted);\n'\"'''\n    else:\n        match = inverse_logic\n    if name == 'signed-inverse':\n        target = '  assign jalr_sum = rs1 + in.imm;\\\\n'\n    else:\n        target = split_target_logic\n    if name == 'signed-range':\n        target += range_logic\n        rtl = rtl.replace(\\\"target[31:20] == 12'b0\\\", \\\"target_in_range\\\")\n    rtl = rtl.replace('  assign jalr_sum = rs1 + in.imm;\\\\n', target + match)\n    rtl = rtl.replace(\n        \\\"  assign target_aligned = target[1:0] == 2'b00;\\\",\n        \\\"  assign target_aligned = in.ctrl.is_jalr ? \"'!jalr_sum[1] : in.direct_target[1:0] == 2'\"'b00;\\\",\n    )\n    rtl = rtl.replace(\n        'match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"',\n        'match_target_q      <= \"'!fetch_parked && (in.ctrl.is_jalr ? jalr_match : fetch_pc == in.direct_target);'\"',\n    )\n    (src / 'ex_stage.sv').write_text(rtl)\nPY\npython3 \\\"\"'$scratch_probe_dir/signed_probe.py\" \"$scratch_probe_dir\" &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for option in (1, 2, 0)\n        for design in ('signed-inverse', 'signed-split', 'signed-range', 'signed-forward')\n    }\n    for future in as_completed(futures):\n        result = future.result()\n        print(*futures[future], result.get('fmax_mhz'), result.get('reason'),\n              (result.get('critical_paths') or [])[:2], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.started", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/local_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nbase_rtl = (root / 'cores/bench/rtl/ex_stage.sv').read_text()\n\nlocal_logic = '''\n  // A matching target determines each carry into bits 1 to 31.\n  logic [31:1] required_carry, produced_carry;\n  assign required_carry = rs1[31:1] \"'^ in.imm[31:1] ''^ fetch_pc[31:1];\n  assign produced_carry[1] = rs1[0] & in.imm[0];\n  assign produced_carry[31:2] = (rs1[30:1] & in.imm[30:1])\n                              | ((rs1[30:1] | in.imm[30:1]) & ~fetch_pc[30:1]);\n  assign jalr_match = !fetch_pc[0] && (required_carry == produced_carry);\n'\"'''\nshort_local_logic = '''\n  // The low 12 bits determine whether the upper base needs adjustment.\n  logic [11:1] required_carry, produced_carry;\n  logic [19:0] fetch_high_adjusted;\n  logic upper_carry, high_match_same, high_match_adjusted;\n  assign required_carry = rs1[11:1] \"'^ in.imm[11:1] ''^ fetch_pc[11:1];\n  assign produced_carry[1] = rs1[0] & in.imm[0];\n  assign produced_carry[11:2] = (rs1[10:1] & in.imm[10:1])\n                              | ((rs1[10:1] | in.imm[10:1]) & ~fetch_pc[10:1]);\n  assign upper_carry = (rs1[11] & in.imm[11]) | ((rs1[11] | in.imm[11]) & ~fetch_pc[11]);\n  assign fetch_high_adjusted = fetch_pc[31:12] + (in.imm[11] ? 20'\"'d1 : 20'hf_ffff);\n  assign high_match_same = rs1[31:12] == fetch_pc[31:12];\n  assign high_match_adjusted = rs1[31:12] == fetch_high_adjusted;\n  assign jalr_match = \"'!fetch_pc[0] && (required_carry == produced_carry)\n                    && ((upper_carry == in.imm[11]) ? high_match_same : high_match_adjusted);\n'\"'''\ncommon_match = 'match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"'\nfresh_match = 'match_target_q      <= \"'!fetch_parked && (in.ctrl.is_jalr ? jalr_match : fetch_pc == in.direct_target);'\"'\nfor name in ('local', 'local-preselect', 'local-range', 'short-local'):\n    src = scratch / name / 'rtl'\n    shutil.copytree(root / 'cores/bench/rtl', src)\n    if name in ('local-range', 'short-local'):\n        rtl = (scratch / 'signed-range' / 'rtl/ex_stage.sv').read_text()\n        i = rtl.index('  // A legal JALR immediate')\n        j = rtl.index('  assign effective_addr', i)\n        rtl = rtl[:i] + (short_local_logic if name == 'short-local' else local_logic) + rtl[j:]\n    else:\n        rtl = base_rtl.replace(\n            '  logic        target_aligned, take_target;',\n            '  logic        target_aligned, take_target, jalr_match;',\n        )\n        needle = '  assign jalr_sum = rs1 + in.imm;\\\\n'\n        rtl = rtl.replace(needle, needle + local_logic)\n        if name == 'local-preselect':\n            rtl = rtl.replace(\n                common_match,\n                'match_target_q      <= (\"'!fetch_parked && in.ctrl.is_jalr && jalr_match)'\"\\\\n'\n                '                             || (\"'!fetch_parked && !in.ctrl.is_jalr && fetch_pc == in.direct_target);'\"',\n            )\n        else:\n            rtl = rtl.replace(common_match, fresh_match)\n    (src / 'ex_stage.sv').write_text(rtl)\nPY\npython3 \\\"\"'$scratch_probe_dir/local_probe.py\" \"$scratch_probe_dir\" &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for option in (1, 2, 0)\n        for design in ('local', 'local-preselect', 'local-range', 'short-local')\n    }\n    for future in as_completed(futures):\n        result = future.result()\n        print(*futures[future], result.get('fmax_mhz'), result.get('reason'),\n              (result.get('critical_paths') or [])[:2], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\nRTL_DIR=\"$PWD/cores/bench/rtl\" OBJ_DIR=\"$scratch_probe_dir/champion/obj_dir\" NRET=1 bash test/cosim/build.sh > \"$scratch_probe_dir/champion/cosim-build.log\" 2>&1 &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\nfrom tools.eval.fpga import validate_coremark_uart\n\nexe = Path(sys.argv[1]) / 'champion/obj_dir/cosim_sim'\nelf = Path.cwd().parents[3] / 'bench/programs/coremark.elf'\ndef run(flags):\n    process = subprocess.run([str(exe), str(elf), '50000000', '--bench', *flags],\n                             text=True, capture_output=True, check=True, timeout=45)\n    last, summary = map(json.loads, process.stdout.splitlines()[-2:])\n    valid, reason = validate_coremark_uart(summary['uart'], 10)\n    assert valid and summary['bench_bracketed'] and summary['ebreak'] and not summary['oob'], (reason, summary)\n    return summary['bench_stop_cycle'] - summary['bench_start_cycle'], last['order'] + 1\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    results = {pool.submit(run, flags): flags for flags in (\n        ('--istall', '--dstall'), ('--istall',), ('--dstall',), ())}\n    for future in as_completed(results):\n        print(results[future], future.result(), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
