n            *(str(p.relative_to(worktree)) for p in rtl_sources),\n        ],\n        cwd=worktree, capture_output=True,\n    )\n    if lint.returncode != 0:\n        return _fail(\"lint\", lint)\n\n    # 2. (V2) No Yosys synthesis: FPGA timing and area come from the vendor\n    # flow at the FPGA gate (tools/eval/gowin.py), and formal already\n    # elaborates the RTL.\n\n    # 3. Build bench ELFs (selftest + cor\n…[15058 of 18130 chars elided by tools/bench/transcript.py; sha256:c02013a6b061cdbb]…\nember taken predictions and redirects during the sweep. The\n+        // sampled read stays unusable until a later advance outside it.\n+        replay_armed_q       <= replay_arm_next;\n+        replay_read_usable_q <= replay_arm_next && !replay_scrubbing;\n+      end\n     end\n   end\n \n-  always_ff @(posedge clock) begin\n-    if (reset || fetch_resolution.refetch)\n-      replay_armed_q <= 1'b0;\n-    else if ((!squash_candidate && ordinary_accept && predict_taken) || recover_target)\n-      replay_armed_q <= 1'b1;\n-  end\n-\n   always_ff @(posedge clock) begin\n     if (reset)\n       btb_valid <= '0;\n@@ -222,7 +209,7 @@ module if_stage (\n   always_comb begin\n     out.pc          = pc;\n     out.pc_plus4    = squash_candidate ? corrected_plus4 : ordinary_plus4;\n-    out.instr       = imem_ready ? imem_data : replay_word;\n+    out.instr       = imem_ready ? imem_data : replay_record.word;\n     out.btb_hit     = training_taken ? ordinary_taken_hit : ordinary_not_taken_hit;\n     out.btb_counter = ordinary_counter;\n   end\n", "exit_code": 0, "status": "completed"}}
