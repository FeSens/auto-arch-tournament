 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n_helpers.py\nconftest.py\ntest_alu.py\ntest_decoder.py\ntest_imm_gen.py\ntest_pipeline.py\ntest_reg_file.py\ncores/bench/test/test_imm_gen.py:85:               sources=[\"imm_gen.sv\"],\ncores/bench/test/test_pipeline.py:615:        sources=[\ncores/bench/test/_helpers.py:44:REPO_ROOT = Path(__file__).resolve().parent.parent\ncores/bench/test/_helpers.py:45:RTL       = REPO_ROOT / \"rtl\"\ncores/bench/test/_helpers.py:46:TEST_DIR  = REPO_ROOT / \"test\"\ncores/bench/test/_helpers.py:47:SIM_BUILD = REPO_ROOT / \"sim_build\"\ncores/bench/test/_helpers.py:50:def run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\ncores/bench/test/_helpers.py:53:    `sources` is a list of bare filenames under rtl/. Order matters —\ncores/bench/test/_helpers.py:58:    build_dir = SIM_BUILD / toplevel\ncores/bench/test/_helpers.py:61:        sources=[str(RTL / s) for s in sources],\ncores/bench/test/_helpers.py:63:        build_dir=str(build_dir),\ncores/bench/test/_helpers.py:71:        build_dir=str(build_dir),\ncores/bench/test/test_decoder.py:334:               sources=[\"core_pkg.sv\", \"decoder.sv\"],\ncores/bench/test/test_alu.py:349:               sources=[\"core_pkg.sv\", \"alu.sv\"],\ncores/bench/test/test_reg_file.py:98:               sources=[\