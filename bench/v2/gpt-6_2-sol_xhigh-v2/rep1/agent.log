{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c \"python3 - '/srv/hwebench/tmp/7cb5c576/88ed2fdd/bench-predictor.BD2rJD' <<'PY'\nfrom pathlib import Path\nimport sys\n\nscratch = Path(sys.argv[1])\nharness = Path('test/cosim/main.cpp').read_text()\nharness = harness.replace('#include <iostream>', '#include <iostream>\\\\n#include <array>')\nharness = harness.replace('int main(int argc, char** argv) {', '''struct Entry {\n    uint32_t pc = 0;\n    uint32_t target = 0;\n    int strength = 0;\n    bool valid = false;\n};\n\ntemplate <unsigned Size, bool IncludeIndirect = false>\nstruct Predictor {\n    std::array<Entry, Size> entries;\n    uint64_t hit_taken = 0, false_taken = 0, wrong_target = 0, missed_taken = 0;\n    void observe(uint32_t pc, uint32_t actual, unsigned opcode, bool trap, bool count) {\n        Entry &entry = entries[(pc >> 2) % Size];\n        bool hit = entry.valid && entry.pc == pc;\n        bool predict_taken = hit && entry.strength >= 2;\n        uint32_t sequential = pc + 4;\n        if (count) {\n            if (actual \"'!= sequential) {\n                if (!predict_taken) ++missed_taken;\n                else if (entry.target == actual) ++hit_taken;\n                else ++wrong_target;\n            } else if (predict_taken && entry.target != actual) {\n                ++false_taken;\n            }\n        }\n        bool branch = opcode == 0x63;\n        if (trap || !(branch || opcode == 0x6f || (IncludeIndirect && opcode == 0x67)))\n            return;\n        if (actual != sequential && pc < MEM_SIZE && actual < MEM_SIZE && !(pc & 3) && !(actual & 3)) {\n            int strength = branch ? (hit ? (entry.strength < 3 ? entry.strength + 1 : 3) : 2) : 3;\n            entry = {pc, actual, strength, true};\n        } else if (branch && actual == sequential && hit && entry.strength > 0) {\n            --entry.strength;\n        }\n    }\n    void print() const {\n        std::cerr << \"BTB \" << Size << \" incl_indirect \" << IncludeIndirect\n                  << \" hit_taken \" << hit_taken << \" false_taken \" << false_taken\n                  << \" wrong_target \" << wrong_target << \" missed_taken \" << missed_taken << '\"'\\\\\\\\n';\n    }\n};\n\nint main(int argc, char** argv) {''')\nharness = harness.replace('    for(uint64_t cycle=0;', '''    Predictor<16> btb16;\n    Predictor<32> btb32;\n    Predictor<64> btb64;\n    Predictor<128> btb128;\n    Predictor<64, true> btb64_indirect;\n    uint64_t retired = 0, branches = 0, taken_branches = 0, direct = 0, indirect = 0;\n    for(uint64_t cycle=0;''')\nharness = harness.replace('            if (\"'!v) return false;'\"', '''            if (\"'!v) return false;\n            bool count = bench_start_set && !bench_stop_set;\n            unsigned opcode = insn & 127;\n            btb16.observe(pc_rdata, pc_wdata, opcode, trap, count);\n            btb32.observe(pc_rdata, pc_wdata, opcode, trap, count);\n            btb64.observe(pc_rdata, pc_wdata, opcode, trap, count);\n            btb128.observe(pc_rdata, pc_wdata, opcode, trap, count);\n            btb64_indirect.observe(pc_rdata, pc_wdata, opcode, trap, count);\n            if (count) {\n                ++retired;\n                if (opcode == 0x63) {\n                    ++branches;\n                    taken_branches += pc_wdata != pc_rdata + 4;\n                } else if (opcode == 0x6f) {\n                    ++direct;\n                } else if (opcode == 0x67) {\n                    ++indirect;\n                }\n            }'\"''')\nharness = harness.replace('    delete top;', '''    std::cerr << \\\"cycles \\\" << (bench_stop_cycle - bench_start_cycle) << \\\" retired \\\" << retired\n              << \\\" branches \\\" << branches << \\\" taken_branches \\\" << taken_branches\n              << \\\" direct_jumps \\\" << direct << \\\" indirect_jumps \\\" << indirect << '\\\\\\\\n';\n    btb16.print();\n    btb32.print();\n    btb64.print();\n    btb128.print();\n    btb64_indirect.print();\n    delete top;''')\n(scratch / 'profile.cpp').write_text(harness)\nPY\nverilator --cc --exe --build -j 4 -Mdir '/srv/hwebench/tmp/7cb5c576/88ed2fdd/bench-predictor.BD2rJD/obj_dir' --top-module core -Wall -Wno-fatal -Wno-style -CFLAGS \\\"-DNRET=1\\\" cores/bench/rtl/core_pkg.sv \"'$(rg --files cores/bench/rtl -g '\"'*.sv' -g '\"'!core_pkg.sv'\"' | sort) '/srv/hwebench/tmp/7cb5c576/88ed2fdd/bench-predictor.BD2rJD/profile.cpp' -o cosim_profile >'/srv/hwebench/tmp/7cb5c576/88ed2fdd/bench-predictor.BD2rJD/build.log' 2>&1\nprofile_build_rc=\"'$?\nif [ \"$profile_build_rc\" -ne 0 ]; then tail -40 '\"'/srv/hwebench/tmp/7cb5c576/88ed2fdd/bench-predictor.BD2rJD/build.log'; fi\nexit \\\"\"'$profile_build_rc\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
