cept || !ordinary_available'\"\\\\n                                          || (ordinary_last && \"'!predict_taken));\"),\n(\"  assign fallthrough_advance = corrected_accept && !fallthrough_last;'\"\\\\n  assign select_target = \"'!reset && recover_target && !target_advance;'\"\\\\n  assign select_target_plus4 = \"'!reset && recover_target && target_advance;'\"\\\\n  assign select_fallthrough = \"'!reset && recover_fallthrough && !fallthrough_advance;'\"\\\\n  assign select_fallthrough_plus4 = \"'!reset && recover_fallthrough && fallthrough_advance;\",\n \"  assign select_target = !reset && redirect_q && !target_advance;'\"\\\\n  assign select_target_plus4 = \"'!reset && redirect_q && target_advance;\"),\n(\"\"\"                              select_target & fetch_resolution.target[i],\n                              select_target_plus4 & target_plus4[i],\n                              select_fallthrough & fetch_resolution.fallthrough[i],\n                              select_fallthrough_plus4 & fallthrough_plus4[i]\"\"\",\n \"\"\"                              select_target & redirect_pc_q[i],\n                              select_target_plus4 & redirect_plus4_q[i]\"\"\"),\n(\"    fetch_parked <= !reset && ((!squash_candidate && ordinary_park)'\"\\\\n                             || (corrected_accept && ((recover_target && target_last)\\\\n                                                       || (recover_fallthrough && fallthrough_last))));\\\",\n \\\"    if (reset)\\\\n      fetch_parked <= 1'b0;\\\\n    else if (redirect_q)\\\\n      fetch_parked <= corrected_accept && target_last;\\\\n    else if (\"'!squash_candidate)'\"\\\\n      fetch_parked <= ordinary_park;\\\"),\n(\\\"\\\"\\\"                    && ((\"'!squash_candidate && ordinary_in_range) || (recover_target && target_in_range)\n                        || (recover_fallthrough && fallthrough_in_range))\"\"\",\n \"\"\"                    && (redirect_q ? target_in_range : ordinary_in_range)\"\"\"),\n(\"    