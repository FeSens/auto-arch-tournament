nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        // channel, so the core's `_0` ports connect directly without\n        // slicing. No `_1` ports exist on the core's IO under nret=1.\n        .io_rvfi_valid_0    (rvfi_valid),\n        .io_rvfi_order_0    (rvfi_order),\n        .io_rvfi_insn_0     (rvfi_insn),\n\n…[3187 of 6259 chars elided by tools/bench/transcript.py; sha256:593c83f45583ad8a]…\nssign fetch_resolution.fallthrough = fallthrough_q;\n-  assign fetch_resolution.match_target = match_target_q;\n+  assign fetch_resolution.match_target = match_direct_q || (check_jalr_q && (&jalr_match_q));\n   assign fetch_resolution.match_fallthrough = match_fallthrough_q;\n   assign fetch_resolution.take_target = take_target;\n   assign fetch_resolution.valid = resolve_valid_q;\n@@ -225,7 +243,9 @@ module ex_stage (\n       target_q            <= target;\n       fallthrough_q       <= in.pc_plus4;\n       target_aligned_q    <= target_aligned;\n-      match_target_q      <= !fetch_parked && fetch_pc == target;\n+      jalr_match_q        <= jalr_match;\n+      match_direct_q      <= !fetch_parked && !in.ctrl.is_jalr && fetch_pc == in.direct_target;\n+      check_jalr_q        <= !fetch_parked && in.ctrl.is_jalr;\n       match_fallthrough_q <= !fetch_parked && fetch_pc == in.pc_plus4;\n       equality_q          <= in.ctrl.branch_equality;\n       branch_invert_q     <= in.ctrl.branch_op[0];\n M cores/bench/rtl/ex_stage.sv\n", "exit_code": 0, "status": "completed"}}
