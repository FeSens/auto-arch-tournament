{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c \"python - '/srv/hwebench/tmp/7cb5c576/ea825215/bench-r13-recovery.uIEWaquZ' <<'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])/'cores/bench/rtl'\n\ndef edit(name, changes):\n    path = rtl/name\n    code = path.read_text()\n    for old, new in changes:\n        assert code.count(old) == 1, repr(old)\n        code = code.replace(old, new)\n    path.write_text(code)\n\nedit(\\\"ex_stage.sv\\\", [\n(\\\"logic        target_aligned_q, match_target_q, match_fallthrough_q;\\\",\n \\\"logic        target_aligned_q, parked_q;\\\\n  logic [31:0] candidate_q;\\\"),\n(\\\"fetch_resolution.match_target = match_target_q;\\\",\n \\\"fetch_resolution.match_target = \"'!parked_q && candidate_q == target_q;\"),\n(\"fetch_resolution.match_fallthrough = match_fallthrough_q;\",\n \"fetch_resolution.match_fallthrough = !parked_q && candidate_q == fallthrough_q;\"),\n(\"      match_target_q      <= !fetch_parked && fetch_pc == target;'\"\\\\n      match_fallthrough_q <= \"'!fetch_parked && fetch_pc == in.pc_plus4;\",\n \"      candidate_q         <= fetch_pc;'\"\\\\n      parked_q            <= fetch_parked;\\\")\n])\n\nedit(\\\"core.sv\\\", [\n(\\\"logic        stall_ex_mem, hold_mem_wb;\\\",\n \\\"logic        stall_ex_mem, hold_mem_wb;\\\\n  logic        hold_recovery;\\\\n  assign hold_recovery = squash_candidate;\\\"),\n(\\\"    .stall            (stall_ex_mem),\\\",\n \\\"    .stall            (stall_ex_mem || hold_recovery),\\\"),\n(\\\"    .hold_wb       (hold_mem_wb),\\\",\n \\\"    .hold_wb       (hold_mem_wb || hold_recovery),\\\")\n])\n\nedit(\\\"if_stage.sv\\\", [\n(\\\"  logic        recover_target, recover_fallthrough;\\\",\n \\\"  logic        recover_target, recover_fallthrough;\\\\n  logic        redirect_q;\\\\n  logic [31:0] redirect_pc_q, redirect_plus4_q;\\\"),\n(\\\"  assign corrected_plus4 = recover_target ? target_plus4 : fallthrough_plus4;