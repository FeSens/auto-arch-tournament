0] index;\n    logic [12:0] tag;\n    logic [17:0] table_target, predicted_target;\n    logic same_index, bypass_target, bypass_counter;\n    logic in_range, table_hit;\n    logic advance;\n\n    assign index = candidate_pc[c][6:2];\n    assign same_index = write_index == index;\n    assign bypass_target = same_index && btb_update.write_target;\n    assign bypass_counter = same_index && btb_update.write_counter;\n    assign {tag, table_target} = entry[index];\n    assign predicted_target = bypass_target ? btb_update.target_word : table_target;\n    assign candidate_counter[c] = bypass_counter ? btb_update.counter : counters[index];\n    assign in_range = candidate_pc[c][31:20] == 12'\"'b0 && candidate_pc[c][1:0] == 2'b00;\n    assign table_hit = btb_valid[index] && tag == candidate_pc[c][19:7];\n    assign candidate_hit[c] = in_range && (bypass_target ? write_tag == candidate_pc[c][19:7] : table_hit);\n\n    assign candidate_plus4[c] = candidate_pc[c] + 32'd4;\n    assign advance = fetch_advances && (c \"'!= NORMAL || !div_wait);\n    assign candidate_next[c] = advance\n                 ? (candidate_hit[c] && candidate_counter[c][1]\n                    ? {12'\"'b0, predicted_target, 2'b00} : candidate_plus4[c])\n                 : candidate_pc[c];\n\n    always_ff @(posedge clock) begin\n      if (\"'!reset && btb_update.write_target)\n        entry[write_index] <= {write_tag, btb_update.target_word};\n      if (!reset && btb_update.write_counter)\n        counters[write_index] <= btb_update.counter;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      normal_pc_q <= '\"'0;\n    else\n      normal_pc_q <= ({32{select_pc[NORMAL]}} & candidate_next[NORMAL])\n                   | ({32{select_pc[TARGET]}} & candidate_next[TARGET])\n                   | ({32{select_pc[FALLTHROUGH]}} & candidate_next[FALLTHROUGH]);\n\n    if (reset)\n      btb_valid <= '0;\n    else if (btb_update.write_target)\n      btb_valid[write_index] <= 1'b1;\n  end\n\n  assign imem_addr = ({32{select_pc[NORMAL]}} & candidate_pc[NORMAL])\n                   | ({32{select_pc[TARGET]}} & candidate_pc[TARGET])\n                   | ({32{select_pc[FALLTHROUGH]}} & candidate_pc[FALLTHROUGH]);\n\n  always_comb begin\n    out.pc = imem_addr;\n    out.pc_plus4 = ({32{select_pc[NORMAL]}} & candidate_plus4[NORMAL])\n                 | ({32{select_pc[TARGET]}} & candidate_plus4[TARGET])\n                 | ({32{select_pc[FALLTHROUGH]}} & candidate_plus4[FALLTHROUGH]);\n    out.instr = imem_data;\n    out.btb_hit = |(select_pc & candidate_hit);\n    out.btb_counter = ({2{select_pc[NORMAL]}} & candidate_counter[NORMAL])\n                    | ({2{select_pc[TARGET]}} & candidate_counter[TARGET])\n                    | ({2{select_pc[FALLTHROUGH]}} & candidate_counter[FALLTHROUGH]);\n  end\nendmodule\n\\\"\\\"\\\")\n\npath = rtl / \\\"core.sv\\\"\ns = path.read_text()\ns = s.replace(\\\"    .advance_fetch    (fetch_ready && \"'!hold_id),\", \"\"\"    .fetch_ready      (fetch_ready),\n    .mem_hold         (stall_ex_mem),\n    .div_wait         (div_wait),\"\"\")\npath.write_text(s)\n\npath = rtl / \"ex_stage.sv\"\ns = path.read_text()\ns = s.replace(\"  logic [1:0] train_counter, train_counter_q;\", \"\"\"  logic [1:0] train_counter_taken, train_counter_untaken;\n  logic [1:0] train_counter_taken_q, train_counter_untaken_q;\"\"\")\ns = s.replace(\"assign btb_update.counter = train_counter_q;\", \"\"\"assign btb_update.counter = train_taken_q ? train_counter_taken_q : train_counter_untaken_q;\"\"\")\npos = s.index(\"  always_comb begin'\"\\\\n    if (in.ctrl.is_jump)\\\")\nend = s.index(\\\"  // Resolve the two matches\\\", pos)\ns = s[:pos] + \\\"\\\"\\\"  assign train_counter_taken = in.ctrl.is_jump ? 2'b11\n                             : \"'!in.btb_hit ? 2'\"'b10\n                             : {in.btb_counter[1] | in.btb_counter[0],\n                                in.btb_counter[1] | \"'!in.btb_counter[0]};\n  assign train_counter_untaken = in.ct