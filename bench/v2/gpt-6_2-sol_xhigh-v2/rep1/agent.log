{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -c \"cat > model.py <<'PY'\nimport json\nimport sys\n\nclass Model:\n    def __init__(self, depth):\n        self.depth = depth\n        self.total = 0\n        self.issue = -1\n        self.bus = -1\n        self.retire = [0] * depth\n        self.load = [(-1, False)] * 32\n        self.lfsr = 0xDEADBEEF\n        self.ready = []\n        self.mem = 0\n\n    def bus_ready(self, at):\n        while len(self.ready) <= at:\n            for _ in range(2):\n                self.lfsr \"'^= (self.lfsr << 13) & 0xFFFFFFFF\n                self.lfsr ''^= self.lfsr >> 17\n                self.lfsr ''^= (self.lfsr << 5) & 0xFFFFFFFF\n            self.ready.append((self.lfsr & 0x7F) < 100)\n        return self.ready[at]\n\n    def step(self, word, rd, rs1, rs2, mem):\n        op = word & 127\n        funct3 = (word >> 12) & 7\n        leaf = self.total % self.depth\n        first = self.load[rs1]\n        second = self.load[rs2]\n        early = op == 0x63 and funct3 < 2\n        due1 = first[0] + int(0x03 != op or not first[1]) if not early else first[0]\n        due2 = second[0] if early else second[0] + 1\n        # Raw sources conservatively wait for completion even when the\n        # architectural operation doesn'\"'t use that field.\n        if op not in (0x03, 0x13, 0x23, 0x33, 0x63, 0x67):\n            due1 = first[0]\n        if op not in (0x23, 0x33, 0x63):\n            due2 = second[0]\n        self.issue = max(self.issue + 1, self.retire[leaf], due1, due2)\n        done = self.issue + 1\n        if mem:\n            self.mem += 1\n            self.bus = max(done, self.bus + 1)\n            while not self.bus_ready(self.bus):\n                self.bus += 1\n            done = self.bus\n        if rd:\n            self.load[rd] = (done, funct3 == 2) if op == 0x03 and mem else (-1, False)\n        if self.total:\n            done = max(done, self.retire[(leaf - 1) % self.depth] + 1)\n        self.retire[leaf] = done\n        self.total += 1\n\nmodels = [Model(n) for n in (1, 2, 3)]\nfor line in sys.stdin:\n    item = json.loads(line)\n    if not 12468 <= item.get('cycle', -1) < 3215207:\n        continue\n    for model in models:\n        model.step(item['insn'], item['rd_addr'], item['rs1_addr'], item['rs2_addr'],\n                   bool(item['mem_rmask'] or item['mem_wmask']))\nfor model in models:\n    print('depth', model.depth, 'instructions', model.total, 'requests', model.mem,\n          'model cycles', max(model.retire))\nPY\nset -o pipefail\ncores/bench/obj_dir/cosim_sim bench/programs/coremark.elf 50000000 --istall --dstall | python3 model.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
