d, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef SUB (rd, rs1, r\n…[8551 of 11623 chars elided by tools/bench/transcript.py; sha256:76617aa6d09c94e2]…\nence] == [NOP(), FENCE_I()]\n    assert [r[\"insn\"] for r in rets if r[\"pc\"] == patched] == [old_word] + [new_word] * 3\n    start = fetches.index((patched, False, True))\n    # The first stall lets the stale candidate reach ID/EX. FENCE.I\n    # replaces it. The first taken jump must refill the invalidated word,\n    # and the second jump replays the replacement with imem still stalled.\n    assert fetches[start:start + 4] == [(patched, False, True)] * 3 + [(patched, True, True)]\n    assert [f[1] for f in fetches if f[0] == patched] == [True, False, False, False, True, False, False, True, False]\n\n\n@cocotb.test()\nasync def fence_i_clear_takes_priority_over_taken_prediction(dut):\n    fence, successor, fallthrough = 0x40, 0x44, 0x48\n    side, marker = 0x60, 0x400\n    program = {\n        0: ADDI(1, 0, 2),\n        4: JAL(0, fence - 4),\n        fallthrough: ADDI(2, 2, 1),\n        0x4C: BNE(2, 1, successor - 0x4C),\n        0x50: EBREAK(),\n        side: SW(1, 0, marker),\n        side + 4: JAL(0, fence - (side + 4)),\n    }\n", "exit_code": 0, "status": "completed"}}
