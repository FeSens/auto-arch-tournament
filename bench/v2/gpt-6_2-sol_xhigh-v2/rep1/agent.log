{"type": "item.completed", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' fpga/bench_stall_gen.sv && rg -n 'bench_start|rvfi|imemReady|dmemReady' test/cosim/main.cpp | head -70 && rg -n 'mem_stall|if_id|div_wait|regs' /srv/hwebench/tmp/7cb5c576/3836c0d8/radix4.UTq5fw/cores/bench/obj_dir/Vcore___024root.h | head -50\"", "aggregated_output": "// fpga/bench_stall_gen.sv\n//\n// Memory-ready generator for the timed FPGA wrapper (HWE Bench V2).\n//\n// It reproduces, cycle for cycle, the bus backpressure that\n// test/cosim/main.cpp applies when CoreMark is run for fitness\n// (--istall --dstall): an xorshift32 seeded with 0xDEADBEEF, advanced\n// twice per cycle (first draw -> imem ready, second draw -> dmem ready),\n// accepting when (state & 0x7F) < 100.\n//\n// Why it exists: in V1 the wrapper tied both ready signals to 1, so\n// synthesis deleted any core logic that only acts while a ready is low.\n// That logic then saved simulated cycles at no area or timing cost. With\n// the ready signals driven by this generator, the timed netlist is the\n// circuit whose cycles are counted.\n//\n// Both ready outputs come straight from flip-flops, so the generator adds\n// no combinational depth to paths inside the core. The reset values hold\n// the first cycle's draws; each clock precomputes the next cycle's pair.\nmodule bench_stall_gen (\n  input  logic clock,\n  input  logic reset,\n  output logic imem_ready,\n  output logic dmem_ready\n);\n\n  function automatic [31:0] xs32(input [31:0] s);\n    reg [31:0] t;\n    begin\n      t = s ^ (s << 13);\n      t = t ^ (t >> 17);\n      xs32 = t ^ (t << 5);\n    end\n  endfunction\n\n  function automatic accept(input [31:0] s);\n    accept = (s[6:0] < 7'd100);\n  endfunction\n\n  // State after the two draws of the current cycle.\n  logic [31:0] state;\n  logic [31:0] next_i, next_d;\n  assign next_i = xs32(state);\n  assign next_d = xs32(next_i);\n\n  // Reset values: state after the two draws of cycle 0, and the accept\n  // bits of those two draws (seed 0xDEADBEEF; see test_bench_stall_gen.py).\n  always_ff @(posedge clock or posedge reset) begin\n    if (reset) begin\n      state      <= 32'h8E1D9142;\n      imem_ready <= 1'b1;\n      dmem_ready <= 1'b1;\n    end else begin\n      state      <= next_d;\n      imem_ready <= accept(next_i);\n      dmem_ready <= accept(next_d);\n    end\n  end\n\nendmodule\n100:    top->io_imemReady = 1;\n101:    top->io_dmemReady = 1;\n11\n…[1191 of 4263 chars elided by tools/bench/transcript.py; sha256:6888a832a1ab1e75]…\nop->io_rvfi_insn_1,\n241:                 top->io_rvfi_pc_rdata_1, top->io_rvfi_pc_wdata_1,\n242:                 top->io_rvfi_rd_addr_1, top->io_rvfi_rd_wdata_1,\n243:                 top->io_rvfi_rs1_addr_1, top->io_rvfi_rs1_rdata_1,\n244:                 top->io_rvfi_rs2_addr_1, top->io_rvfi_rs2_rdata_1,\n245:                 top->io_rvfi_mem_addr_1,\n246:                 top->io_rvfi_mem_rmask_1, top->io_rvfi_mem_rdata_1,\n247:                 top->io_rvfi_mem_wmask_1, top->io_rvfi_mem_wdata_1,\n248:                 top->io_rvfi_trap_1, top->io_rvfi_halt_1, top->io_rvfi_intr_1,\n249:                 top->io_rvfi_mode_1, top->io_rvfi_ixl_1)) break;\n268:               \"\\\"bench_start_cycle\\\":%llu,\\\"bench_stop_cycle\\\":%llu,\"\n273:               (unsigned long long)bench_start_cycle,\n275:               (bench_start_set && bench_stop_set) ? \"true\" : \"false\",\n39:        CData/*0:0*/ core__DOT__div_wait;\n132:        VlWide<4>/*98:0*/ core__DOT__if_id_w;\n151:        VlUnpacked<IData/*31:0*/, 32> core__DOT__u_rf__DOT__regs;\n", "exit_code": 0, "status": "completed"}}
