{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\n\npath = Path('cores/bench/rtl/alu.sv')\nsrc = path.read_text()\nsrc = src.replace('phases 8 through 2 perform the seven updates, and','phases 8 through 2 perform seven updates, and')\nstart = src.index('  logic        signed_div, select_rem, neg_a, neg_b;')\nend = src.index('  // The unsigned magnitude', start)\nsrc = src[:start] + \\\"\\\"\\\"  logic        signed_div, select_rem, neg_a, neg_b;\n  logic        select_rem_q, negate_q;\n  logic [31:0] divisor_q, magnitude;\n  logic [33:0] triple_q;\n  logic [31:0] abs_a, abs_b;\n  logic [5:0]  prefix_triple;\n  logic [7:0]  first_digit, prefix;\n  logic [63:0] partial_q, after_two, after_four;\n\n  function automatic [7:0] prefix_step(\n    input logic [3:0] shifted,\n    input logic [3:0] divisor,\n    input logic [5:0] triple\n  );\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [6:0] trial1, trial2, trial3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic take0, take1, take2, take3;\n    logic [3:0] remainder;\n    begin\n      trial1 = {3'b0, shifted} - {3'b0, divisor};\n      trial2 = {3'b0, shifted} - {2'b0, divisor, 1'b0};\n      trial3 = {3'b0, shifted} - {1'b0, triple};\n      take0 = trial1[6];\n      take1 = \"'!trial1[6] && trial2[6];\n      take2 = !trial2[6] && trial3[6];\n      take3 = !trial3[6];\n      remainder = ({4{take0}} & shifted) |\n                  ({4{take1}} & trial1[3:0]) |\n                  ({4{take2}} & trial2[3:0]) |\n                  ({4{take3}} & trial3[3:0]);\n      prefix_step = {remainder, 2'\"'b0, take2 | take3, take1 | take3};\n    end\n  endfunction\n\n  function automatic [63:0] radix4_step(\n    input logic [63:0] partial,\n    input logic [31:0] divisor,\n    input logic [33:0] triple\n  );\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [34:0] trial1, trial2, trial3;\n    /* verilator lint_on UNUSEDSIGNAL */\n    logic take0, take1, take2, take3;\n    logic [31:0] remainder;\n    begin\n      trial1 = {1'b0, partial[63:30]} - {3'b0, divisor};\n      trial2 = {1'b0, partial[63:30]} - {2'b0, divisor, 1'b0};\n      trial3 = {1'b0, partial[63:30]} - {1'b0, triple};\n      take0 = trial1[34];\n      take1 = \"'!trial1[34] && trial2[34];\n      take2 = !trial2[34] && trial3[34];\n      take3 = !trial3[34];\n      remainder = ({32{take0}} & partial[61:30]) |\n                  ({32{take1}} & trial1[31:0]) |\n                  ({32{take2}} & trial2[31:0]) |\n                  ({32{take3}} & trial3[31:0]);\n      radix4_step = {remainder, partial[29:0], take2 | take3, take1 | take3};\n    end\n  endfunction\n\n  assign signed_div = op == ALU_DIV || op == ALU_REM;\n  assign select_rem = op == ALU_REM || op == ALU_REMU;\n  assign neg_a = signed_div && a[31];\n  assign neg_b = signed_div && b[31];\n  assign abs_a = neg_a ? -a : a;\n  assign abs_b = neg_b ? -b : b;\n  assign prefix_triple = {2'\"'b0, abs_b[3:0]} + {1'b0, abs_b[3:0], 1'b0};\n  assign first_digit = prefix_step({2'b0, abs_a[31:30]}, abs_b[3:0], prefix_triple);\n  assign prefix = prefix_step({first_digit[5:4], abs_a[29:28]}, abs_b[3:0], prefix_triple);\n  assign after_two = radix4_step(partial_q, divisor_q, triple_q);\n  assign after_four = radix4_step(after_two, divisor_q, triple_q);\n\n  always_ff @(posedge clock) begin\n    if (div_launch) begin\n      partial_q <= |abs_b[31:4]\n                 ? {28'b0, abs_a, 4'b0}\n                 : {28'b0, prefix[7:4], abs_a[27:0], first_digit[1:0], prefix[1:0]};\n      divisor_q    <= abs_b;\n      triple_q     <= {2'b0, abs_b} + {1'b0, abs_b, 1'b0};\n      select_rem_q <= select_rem;\n      negate_q     <= select_rem ? neg_a : ((neg_a \"'^ neg_b) && b != 32'\"'b0);\n    end else if (div_busy && \"'!div_valid) begin\n      partial_q <= after_four;\n    end\n  end\n\n\"\"\" + src[end:]\nsrc = src.replace('\"'  logic [7:0]  first_digit, prefix;', '  /* verilator lint_off UNUSEDSIGNAL */\\\\n  logic [7:0]  first_digit, prefix;\\\\n  /* verilator lint_on UNUSEDSIGNAL */')\npath.write_text(src)\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
