hree || (accept_one && !accept_two)};\n      restoring_pair = {remainder, partial[29:0], digit};\n    end\n  endfunction\n\n\"\"\" + source[pos:]\nstart = source.index(\"    after_two = partial_q;\")\nstop = source.index(\"'\"\\\\n  end\\\", start)\nsource = source[:start] + \\\"\\\"\\\"    leading_bits = partial_q[31:30];\n    leading_digit = 2'd0;\n    leading_remainder = leading_bits;\n    case (divisor_q)\n      32'd0: leading_digit = 2'd3;\n      32'd1: begin\n        leading_digit = leading_bits;\n        leading_remainder = 2'd0;\n      end\n      32'd2: begin\n        leading_digit = {1'b0, leading_bits[1]};\n        leading_remainder = {1'b0, leading_bits[0]};\n      end\n      32'd3: begin\n        leading_digit = {1'b0, &leading_bits};\n        if (&leading_bits)\n          leading_remainder = 2'd0;\n      end\n      default: ;\n    endcase\n    after_two = {30'd0, leading_remainder, partial_q[29:0], leading_digit};\n    after_five = restoring_pair(partial_q, divisor_q, triple_divisor_q);\n    after_five = restoring_pair(after_five, divisor_q, triple_divisor_q);\n    after_five = restoring_step(after_five, divisor_q);\\\"\\\"\\\" + source[stop:]\nsource = source.replace(\n    \\\"      partial_q <= div_phase_q == 4'd8 ? after_two : after_five;\\\",\n    \\\"      partial_q <= div_phase_q == 4'd8 ? after_two : after_five;\\\\n\\\"\n    \\\"      if (div_phase_q == 4'd8)\\\\n\\\"\n    \\\"        triple_divisor_q <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\\\",\n)\npath.write_text(source)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
