{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r10-address.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tempfile import mkdtemp\n\nfrom tools.eval.gowin import build\nfrom tools.eval.fpga import _bench_sv\n\nworktree = Path.cwd()\nbase = Path(mkdtemp(prefix='bench-r10s0-address-', dir=os.environ['TMPDIR']))\nprint(base, flush=True)\nscratch = Path(os.environ['TMPDIR'])\nrtl = worktree / 'cores/bench/rtl'\nflat_rtl = scratch / 'bench-r10s0-fetch-hxtlf97e/scalar-flat/rtl'\nbenches = _bench_sv(str(worktree), 'bench')\n\ndef modify(target):\n    p = target / 'ex_stage.sv'\n    s = p.read_text()\n    s = s.replace('  input  logic [31:0]        load_address_data,', '  input  logic [31:0]        load_address_data,\\\\n  input  logic               load_address_rs1,')\n    s = s.replace('  logic [31:0] target, jalr_sum, effective_addr;', '  logic [31:0] target, jalr_sum, effective_addr, live_load_sum;')\n    s = s.replace('  assign effective_addr = (rs1 | load_address_data) + in.imm;', '''  assign live_load_sum = load_address_data + in.imm;\n  assign effective_addr = load_address_rs1 && mem_load_word ? live_load_sum : jalr_sum;''')\n    p.write_text(s)\n    p = target / 'core.sv'\n    s = p.read_text()\n    s = s.replace('    .load_address_data(load_address_data),\\\\n    .mem_load_word', '    .load_address_data(load_address_data),\\\\n    .load_address_rs1 (load_address_rs1),\\\\n    .mem_load_word', 1)\n    p.write_text(s)\n    p = target / 'mem_stage.sv'\n    s = p.read_text()\n    s = s.replace('  input  logic               load_address_rs1,\\\\n', '')\n    s = s.replace('  input  logic               dmem_ready,\\\\n', '')\n    s = s.replace('  // load_address_rs1 already includes the qualified youngest writer match.\\\\n', '')\n    s = s.replace('{32{load_address_rs1 && load_word && dmem_ready}} & dmem_rdata', 'dmem_rdata')\n    p.write_text(s)\n    p = target / 'core.sv'\n    s = p.read_text()\n    s = s.replace('    .load_address_rs1(load_address_rs1),\\\\n', '')\n    s = s.replace('    .dmem_ready    (io_dmemReady),\\\\n', '')\n    p.write_text(s)\n\ncases = {'parallel-address': rtl, 'flat-parallel-address': flat_rtl}\nfor name, input_rtl in cases.items():\n    copytree(input_rtl, base / name / 'rtl')\n    modify(base / name / 'rtl')\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, worktree, base / name / 'rtl', benches, p, base / name / f'gowin_p{p}'): (name, p)\n        for name in cases for p in (0, 1, 2)\n    }\n    for f in concurrent.futures.as_completed(futures):\n        r = f.result()\n        print(*futures[f], r.get('fmax_mhz'), r.get('regs'), r.get('logic'), r.get('reason'),\n              [(p['from'], p['to'], p['logic_cells']) for p in r.get('critical_paths', [])[:3]], flush=True)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-address.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
