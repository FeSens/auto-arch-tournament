{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path.cwd()\nreference = root / \\\"rtl_ref\\\"\nbaseline = (reference / \\\"ex_stage.sv\\\").read_text()\n\ndef make(name, declaration, match):\n    dest = root / name\n    shutil.copytree(reference, dest, dirs_exist_ok=True)\n    design = baseline.replace(\\\"  assign jalr_sum = rs1 + in.imm;\\\", declaration + \\\"\\\\n  assign jalr_sum = rs1 + in.imm;\\\")\n    design = design.replace(\\\"match_target_q      <= \"'!fetch_parked && fetch_pc == target;\", match)\n    (dest / \"ex_stage.sv\").write_text(design)\n\nmake(\"rtl_zero\", \"\"\"\n  logic direct_target_match, jalr_target_match;\n  assign direct_target_match = fetch_pc == in.direct_target;\n  assign jalr_target_match = in.imm[11:0] == 12'\"'b0 &&\n                            fetch_pc == {rs1[31:1], 1'b0};\n\\\"\\\"\\\", \\\"match_target_q      <= \"'!fetch_parked && (in.ctrl.is_jalr ? jalr_target_match : direct_target_match);\")\n\nmake(\"rtl_imm12\", \"\"\"\n  logic direct_target_match, jalr_target_match, same_high, lower_high, higher_high;\n  logic [12:0] jalr_low_sum;\n  assign direct_target_match = fetch_pc == in.direct_target;\n  assign jalr_low_sum = {1'\"'b0, rs1[11:0]} + {1'b0, in.imm[11:0]};\n  assign same_high = rs1[31:12] == fetch_pc[31:12];\n  assign lower_high = rs1[31:12] == (fetch_pc[31:12] - 20'd1);\n  assign higher_high = rs1[31:12] == (fetch_pc[31:12] + 20'd1);\n  assign jalr_target_match = fetch_pc[11:0] == {jalr_low_sum[11:1], 1'b0}\n                           && ((same_high && jalr_low_sum[12] == in.imm[11])\n                               || (lower_high && jalr_low_sum[12] && \"'!in.imm[11])\n                               || (higher_high && !jalr_low_sum[12] && in.imm[11]));\n\"\"\", \"match_target_q      <= !fetch_parked && (in.ctrl.is_jalr ? jalr_target_match : direct_target_match);\")\nPY\npython3 -u - <<'\"'PY'\nfrom