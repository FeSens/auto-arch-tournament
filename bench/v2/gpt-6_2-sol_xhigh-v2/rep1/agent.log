{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c 'set -euo pipefail\nscratch_dir=$(mktemp -d \"$TMPDIR/predictor-r11s2.XXXXXX\")\nmkdir -p \"$scratch_dir/cores/bench\"\ncp -a cores/bench/rtl cores/bench/core.yaml \"$scratch_dir/cores/bench/\"\ncp -a Makefile bench fpga test tools \"$scratch_dir/\"\nif [ -d /srv/hwebench/toolchain ]; then\n  ln -s /srv/hwebench/toolchain \"$scratch_dir/.toolchain\"\nfi\npython3 - \"$scratch_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nroot = Path(sys.argv[1])\npath = root / \\\"cores/bench/rtl/ex_stage.sv\\\"\nrtl = path.read_text()\ncomparator = \\\"\\\"\\\"\n  logic direct_target_match, jalr_target_match;\n  logic [31:1] jalr_carry_matches;\n  logic [31:1] jalr_expected_carry;\n\n  assign direct_target_match = fetch_pc == in.direct_target;\n  assign jalr_expected_carry = rs1[31:1] \"'^ in.imm[31:1] ''^ fetch_pc[31:1];\n  assign jalr_carry_matches[1] = jalr_expected_carry[1] == (rs1[0] & in.imm[0]);\n  for (genvar bit_index = 2; bit_index < 32; bit_index++) begin : jalr_match_bit\n    logic previous_carry_out;\n    assign previous_carry_out = rs1[bit_index-1] == in.imm[bit_index-1]\n                              ? rs1[bit_index-1] : !fetch_pc[bit_index-1];\n    assign jalr_carry_matches[bit_index] = jalr_expected_carry[bit_index] == previous_carry_out;\n  end\n  assign jalr_target_match = !fetch_pc[0] && (&jalr_carry_matches);\n\"\"\"\nrtl = rtl.replace(\"  assign jalr_sum = rs1 + in.imm;\", comparator + \"'\"\\\\n  assign jalr_sum = rs1 + in.imm;\\\")\nrtl = rtl.replace(\n    \\\"match_target_q      <= \"'!fetch_parked && fetch_pc == target;\",\n    \"match_target_q      <= !fetch_parked && (in.ctrl.is_jalr ? jalr_target_match : direct_target_match);\",\n)\npath.write_text(rtl)\n\nbench = \"\"\"\nmodule check(\n  input [31:0] rs1, imm, fetch_pc, direct_target,\n  input is_jalr, fetch_parked,\n  output result\n);\n\"\"\"\nbench += comparator.replace(\"in.imm\", \"imm\").replace(\"in.direct_target\", \"direct_target\")\nbench += \"\"\"\n  wire [31:0] target = is_jalr ? ((rs1 + imm) & 32'\"'hffff_fffe) : direct_target;\n  wire old_match = \"'!fetch_parked && fetch_pc == target;\n  wire new_match = !fetch_parked && (is_jalr ? jalr_target_match : direct_target_match);\n  assign result = old_match == new_match;\nendmodule\n\"\"\"\n(root / \"match_equivalence.sv\").write_text(bench)\nPY\nprintf '\"'%s\\\\n' \\\"\"'$scratch_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
