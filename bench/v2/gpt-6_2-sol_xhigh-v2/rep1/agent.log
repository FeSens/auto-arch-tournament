0] replay_valid_q;\n  logic [31:0] replay_word [0:{depth-1}];\n  logic [{17-bits}:0] replay_tag [0:{depth-1}];\n  logic replay_active, replay_hit, replay_fill;\n\n  assign refetch = fetch_resolution.valid && fetch_resolution.refetch;\n  assign replay_remaining = squash_candidate\n                           ? (recover_target ? {window_bits}'d{window} : {window_bits}'d0)\n                           : replay_remaining_q;\n  assign replay_active = (replay_remaining \"'!= 0) && fetch_in_range;\n  assign replay_index = pc[{bits+1}:2];\n  assign replay_hit = replay_active && replay_valid_q[replay_index]\n                   && replay_tag[replay_index] == pc[19:{bits+2}];\n  assign replay_fill = !reset && !refetch && advance_fetch && imem_ready\n                    && replay_active && !replay_hit;\n  assign fetch_word_ready = (!parked_q || squash_candidate) && (imem_ready || replay_hit);\n  assign predicted_taken = hit && counter[1];\n  assign park_next = !predicted_taken && pc == 32'\"'h000f_fffc;\n\n  always_ff @(posedge clock) begin\n    if (reset || refetch)\n      replay_valid_q <= '0;\n    else if (replay_fill)\n      replay_valid_q[replay_index] <= 1'b1;\n\n    if (replay_fill) begin\n      replay_word[replay_index] <= imem_data;\n      replay_tag[replay_index] <= pc[19:{bits+2}];\n    end\n\n    if (reset)\n      replay_remaining_q <= '0;\n    else if (advance_fetch) begin\n      if (predicted_taken)\n        replay_remaining_q <= {window_bits}'d{window};\n      else if (replay_remaining \"'!= 0)\n        replay_remaining_q <= replay_remaining - {window_bits}'\"'d1;\n      else\n        replay_remaining_q <= '0;\n    end else if (squash_candidate)\n      replay_remaining_q <= replay_remaining;\n\n    if (reset)\n      parked_q <= 1'b0;\n    else if (advance_fetch)\n      parked_q <= park_next;\n    else if (squash_candidate)\n      parked_q <= 1'b0;\n  end\n\n  assign recover_target\\\"\\\"\\\")\ns = s.replace('&& \"'!fetch_resolution.match_target;'\"', '&& (\"'!fetc