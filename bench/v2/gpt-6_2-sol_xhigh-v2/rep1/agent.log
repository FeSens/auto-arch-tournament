{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/div_probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nbase_rtl = (root / 'cores/bench/rtl/alu.sv').read_text()\nbase_ex = (root / 'cores/bench/rtl/ex_stage.sv').read_text()\nlocal_ex = (scratch / 'local/rtl/ex_stage.sv').read_text()\n\ndeclarations = '''\n  logic [35:0] divisor_ext;\n  logic [35:0] odd_3_q, odd_5_q, odd_7_q, odd_9_q, odd_11_q, odd_13_q, odd_15_q;\n  logic [35:0] multiples [1:15];\n  logic [36:0] radix16_shift, trial [1:15];\n  logic [15:0] radix16_select;\n  logic [31:0] radix16_remainder;\n  logic [3:0] radix16_digit;\n  logic [63:0] after_radix16;\n\n  function automatic [35:0] add_three(\n    input logic [35:0] x, y, z\n  );\n    add_three = (x \"'^ y ''^ z) + (((x & y) | (x & z) | (y & z)) << 1);\n  endfunction\n\n  assign divisor_ext = {4'\"'b0, divisor_q};\n  assign triple_divisor_q = odd_3_q[33:0];\n\n  assign multiples[1] = divisor_ext;\n  assign multiples[2] = divisor_ext << 1;\n  assign multiples[3] = odd_3_q;\n  assign multiples[4] = divisor_ext << 2;\n  assign multiples[5] = odd_5_q;\n  assign multiples[6] = odd_3_q << 1;\n  assign multiples[7] = odd_7_q;\n  assign multiples[8] = divisor_ext << 3;\n  assign multiples[9] = odd_9_q;\n  assign multiples[10] = odd_5_q << 1;\n  assign multiples[11] = odd_11_q;\n  assign multiples[12] = odd_3_q << 2;\n  assign multiples[13] = odd_13_q;\n  assign multiples[14] = odd_7_q << 1;\n  assign multiples[15] = odd_15_q;\n  assign radix16_shift = {1'b0, partial_q[63:28]};\n  assign radix16_select[0] = trial[1][36];\n  assign radix16_select[15] = \"'!trial[15][36];\n  for (genvar digit = 1; digit <= 15; digit++) begin : radix_digit\n    assign trial[digit] = radix16_shift - {1'\"'b0, multiples[digit]};\n    if (digit < 15) begin : next_trial\n      assign radix16_select[digit] = \"'!trial[digit][36] && trial[digit+1][36];\n    end\n  end\n\n  for (genvar bit_index = 0; bit_index < 32; bit_index++) begin : rem_bits\n    logic [15:0] candidates;\n    assign candidates[0] = radix16_select[0] & radix16_shift[bit_index];\n    for (genvar digit = 1; digit <= 15; digit++) begin : rem_trial\n      assign candidates[digit] = radix16_select[digit] & trial[digit][bit_index];\n    end\n    assign radix16_remainder[bit_index] = |candidates;\n  end\n  assign radix16_digit[0] = |(radix16_select & 16'\"'haaaa);\n  assign radix16_digit[1] = |(radix16_select & 16'hcccc);\n  assign radix16_digit[2] = |(radix16_select & 16'hf0f0);\n  assign radix16_digit[3] = |(radix16_select & 16'hff00);\n  assign after_radix16 = {radix16_remainder, partial_q[27:0], radix16_digit};\n'''\nfor name in ('radix16', 'radix16-local'):\n    src = scratch / name / 'rtl'\n    shutil.copytree(root / 'cores/bench/rtl', src)\n    rtl = base_rtl.replace('  assign after_radix4_b = radix4_step(after_radix4_a, divisor_q, triple_divisor_q);',\n                           declarations)\n    rtl = rtl.replace(\n        \\\"      triple_divisor_q <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\\\",\n        \\\"\\\"\\\"      odd_3_q  <= (divisor_ext << 1) + divisor_ext;\n      odd_5_q  <= (divisor_ext << 2) + divisor_ext;\n      odd_7_q  <= (divisor_ext << 3) - divisor_ext;\n      odd_9_q  <= (divisor_ext << 3) + divisor_ext;\n      odd_11_q <= add_three(divisor_ext << 3, divisor_ext << 1, divisor_ext);\n      odd_13_q <= add_three(divisor_ext << 3, divisor_ext << 2, divisor_ext);\n      odd_15_q <= (divisor_ext << 4) - divisor_ext;\\\"\\\"\\\")\n    rtl = rtl.replace('      partial_q <= after_radix4_b;', '      partial_q <= after_radix16;')\n    rtl = rtl.replace('after_radix4_a, after_radix4_b;', 'after_radix4_a;')\n    (src / 'alu.sv').write_text(rtl)\n    (src / 'ex_stage.sv').write_text(local_ex if name.endswith('-local') else base_ex)\nPY\npython3 \\\"\"'$scratch_probe_dir/div_probe.py\" \"$scratch_probe_dir\" &&\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \"$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for option in (1, 2, 0)\n        for design in ('radix16', 'radix16-local')\n    }\n    for future in as_completed(futures):\n        result = future.result()\n        print(*futures[future], result.get('fmax_mhz'), result.get('logic'), result.get('reason'),\n              (result.get('critical_paths') or [])[:2], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
