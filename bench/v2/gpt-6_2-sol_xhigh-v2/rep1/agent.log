oup    4096 Nov 19 16:38 docs\ndrwxrwx---+  2 nobody    nogroup   12288 Nov 19 16:38 insns\ndrwxrwx---+  2 nobody    nogroup    4096 Nov 19 16:38 monitor\ndrwxrwx---+  5 nobody    nogroup    4096 Nov 19 15:04 tests\n#!/usr/bin/env bash\n# Build the Verilator-based cosim binary that drives `core` against an ELF\n# program. Produces $OBJ_DIR/cosim_sim (default: test/cosim/obj_dir/cosim_sim).\n#\n# RTL_DIR (defau\n…[1962 of 5034 chars elided by tools/bench/transcript.py; sha256:8e3fc932529e25b6]…\nm\"\n22:GOWIN_HOME = Path(os.environ.get(\"GOWIN_HOME\", \"/opt/gowin\"))\n23:GOWIN_VERSION = \"1.9.11.03 Education\"\n33:def gowin_env(base: dict | None, workdir: Path) -> dict:\n35:    libs = [GOWIN_HOME / \"deps/root/usr/lib/x86_64-linux-gnu\", GOWIN_HOME / \"IDE/lib\"]\n45:def rtl_sources(rtl_dir: Path) -> list[Path]:\n51:def project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n70:def _cells(rpt: str, name: str) -> int | None:\n75:def critical_paths(tr_text: str, n: int = 5) -> list[dict]:\n87:        def field(name):\n104:def parse_reports(outdir: Path) -> dict:\n128:def _run_gw_sh(outdir: Path, log: Path, env: dict) -> bool:\n133:        proc = subprocess.Popen([str(GOWIN_HOME / \"IDE/bin/gw_sh\"), \"build.tcl\"], cwd=outdir,\n148:def build(worktree: str | Path, rtl_dir: str | Path, bench_sv: str,\n170:def build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\n179:def summarize(results: list[dict]) -> dict:\n199:def main(argv=None) -> int:\n20\ncat: /sys/fs/cgroup/cpu.max: No such file or directory\n", "exit_code": 1, "status": "failed"}}
