{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c 'scratch=/srv/hwebench/tmp/7cb5c576/335030a4/predictor.awlJ62Gn\nfor program in selftest random1 random2 random3; do\n  make -n -f bench/programs/Makefile \"bench/programs/$program.elf\" | sed \"s@-o bench/programs/$program.elf@-o $scratch/$program.elf@\" | bash || exit\ndone\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nfrom test.cosim.run_cosim import run_verilator, run_reference, compare\n\nscratch = Path(sys.argv[1])\nfor variant in ('exact16', 'exact32'):\n    sim = scratch / f'obj_{variant}' / 'cosim_sim'\n    for program in ('selftest', 'random1', 'random2', 'random3'):\n        elf = scratch / f'{program}.elf'\n        ref, ref_completed, ref_error = run_reference(str(elf))\n        assert ref_completed, ref_error\n        for flags in ((), ('--istall', '--dstall')):\n            trace, completed, return_code, stderr = run_verilator(str(sim), str(elf), sim_flags=flags)\n            comparison = compare(ref, trace, ref_completed, completed)\n            assert comparison['passed'] and return_code == 0, (variant, program, flags, stderr, comparison)\n        print(variant, program, len(ref), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
