{"type":"item.started","item":{"id":"item_140","type":"command_execution","command":"/bin/bash -c \"PYTHONPATH=. python3 - <<'PY'\nimport json\nimport os\nfrom pathlib import Path\nimport jsonschema\nimport yaml\nfrom tools.eval.gowin import parse_reports, summarize\nfrom tools.eval.fpga import validate_coremark_uart\n\npath = Path(\\\"cores/bench/experiments/hypotheses/hyp-20261119-001-r8s0.yaml\\\")\nh = yaml.safe_load(path.read_text())\nschema = json.loads(Path(\\\"schemas/hypothesis.schema.json\\\").read_text())\njsonschema.Draft7Validator(schema).validate(h)\nassert h[\\\"id\\\"] == path.stem and h[\\\"category\\\"] == \\\"micro_opt\\\"\nassert all((Path(\\\"cores/bench\\\") / c[\\\"file\\\"]).is_file() for c in h[\\\"changes\\\"])\n\nroot = Path(os.environ[\\\"TMPDIR\\\"]) / \\\"shift-study/fcleanidx\\\"\nreports = [{\\\"place_option\\\": i, **parse_reports(root / f\\\"gowin_p{i}\\\")} for i in range(3)]\ntiming = summarize(reports)\nassert not timing[\\\"placement_failed\\\"]\nmark = json.loads((root/\\\"coremark.json\\\").read_text().splitlines()[-1])\nassert mark[\\\"ebreak\\\"] and not mark[\\\"oob\\\"] and mark[\\\"bench_bracketed\\\"]\nassert validate_coremark_uart(mark[\\\"uart\\\"], 10)[0]\ncycles = mark[\\\"bench_stop_cycle\\\"] - mark[\\\"bench_start_cycle\\\"]\nscore = timing[\\\"fmax_mhz\\\"]*1e6*10/cycles\ndelta = 100 * (score / 212.81 - 1)\nassert delta > 4.6\nprint(f\\\"Schema valid. Gowin placements {timing['seeds']} MHz. Cycles {cycles:,}. Fitness {score:.2f} iter/s, +{delta:.2f}%.\\\")\nPY\ngit status --short --untracked-files=all\ngit check-ignore cores/bench/experiments/hypotheses/hyp-20261119-001-r8s0.yaml\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
