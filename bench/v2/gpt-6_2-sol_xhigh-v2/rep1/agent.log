_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[7211 of 10283 chars elided by tools/bench/transcript.py; sha256:604b1d3042805eaf]…\nm.Random(0xD1)\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        signed = op in (ALU_DIV, ALU_REM)\n        for _ in range(64):\n            a = rng.getrandbits(32)\n            b = rng.getrandbits(rng.randrange(33))\n            if signed:\n                if a >= (1 << 31):\n                    a -= 1 << 32\n                b = (b & 0x7FFFFFFF) * rng.choice((-1, 1))\n            if b == 0:\n                quotient, remainder = MASK32, a\n            else:\n                quotient, remainder = divmod(abs(a), abs(b))\n                if (a < 0) != (b < 0):\n                    quotient = -quotient\n                if a < 0:\n                    remainder = -remainder\n            expected = remainder if op in (ALU_REM, ALU_REMU) else quotient\n            await _check_div(dut, op, a, b, expected)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 1, "status": "failed"}}
