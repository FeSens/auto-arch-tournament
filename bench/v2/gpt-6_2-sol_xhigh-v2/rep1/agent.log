{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"rg -n 'coremark|timing|oob' tools/eval/fpga.py && sed -n '180,235p' cores/bench/test/test_pipeline.py\"","aggregated_output":"57:PORTME_H = \"bench/programs/coremark/baremetal/core_portme.h\"\n61:# coremark_rv32im.bin — same seedcrc/crclist/crcmatrix/crcstate, same\n203:def run_coremark_ipc(worktree: str, sim_bin: str | None = None, env: dict | None = None) -> dict:\n210:    elf     = str(worktree_path / \"bench/programs/coremark.elf\")\n220:                'reason': f'coremark_harness_error: {e}'}\n245:    if marker.get('oob', False):\n247:                'reason': 'oob_memory_access'}\n251:    valid, reason = validate_coremark_uart(uart, iterations)\n257:    # bench/programs/coremark/baremetal/core_portme.c's start/stop_time.\n279:def validate_coremark_uart(uart: str, iterations: int) -> tuple:\n284:            return False, f'coremark_unvalidated_seed_or_size: {uart[-500:]}'\n286:            return False, f'coremark_reported_error: {uart[-500:]}'\n287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\n299:            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\n303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\n341:        'ipc_coremark': float,           — iter/cycle\n372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\n385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = read_instruction(ia & ~3, dmem) & 0xFFFFFFFF\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0) if dmem_ready else 0xDEADBEEF\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _check_retirements(retirements, pcs):\n    assert [r[\"order\"] for r in retirements] == list(range(len(pcs)))\n    assert [r[\"pc\"] for r in retirements] == pcs\n    assert [r[\"pc_next\"] for r in retirements[:-1]] == pcs[1:]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def ready_load_forwards_to_add(dut):\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; forwarded on the ready edge\n","exit_code":0,"status":"completed"}}
