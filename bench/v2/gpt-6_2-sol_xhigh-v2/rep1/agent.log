{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"date -u; git status --short; ls -l cores/bench/test/_helpers.py; sed -n '1,125p' cores/bench/test/_helpers.py\"","aggregated_output":"Thu Nov 19 23:41:21 UTC 2026\n-rw-rw----+ 1 nobody nogroup 2143 Nov 20 00:35 cores/bench/test/_helpers.py\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"agent_message","text":"The staged JALR prototype preserved the canonical CRCs and cycle count, but its median fell to 77.886 MHz. The divider became the limiting path in both median placements. I’ll test whether moving validation across the register boundary gives a better timing tradeoff."}}
{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predictor-profile/late_jalr.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nwork = Path(os.environ['TMPDIR']) / 'predictor-profile'\ndef build(name, delay, shared):\n    src = Path('cores/bench/rtl')\n    rtl = work / f'{name}-rtl'\n    shutil.copytree(src, rtl, dirs_exist_ok=True)\n    path = rtl / 'ex_stage.sv'\n    s = path.read_text()\n    def sub(old, new):\n        nonlocal s\n        assert s.count(old) == 1, old\n        s = s.replace(old, new)\n    if shared:\n        sub('target, jalr_sum, effective_addr;', 'target, effective_addr;')\n        sub('  assign jalr_sum = rs1 + in.imm;\\\\n','')\n        sub('(jalr_sum &', '(add_result &')\n    sub('  logic [31:0] target_q, fallthrough_q;', '''  logic [31:0] target_q, fallthrough_q, jalr_candidate_q;\n  logic jalr_q, jalr_match;\n  assign jalr_match = \"'!jalr_parked_q && jalr_candidate_q == target_q;\n  logic jalr_parked_q;'\"''')\n    sub('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"', '''      match_target_q      <= \"'!fetch_parked && fetch_pc == in.direct_target;\n      jalr_q              <= in.ctrl.is_jalr;\n      jalr_candidate_q    <= fetch_pc;\n      jalr_parked_q       <= fetch_parked;'\"''')\n    sub('  assign train_valid =', '''  // Unconditional data matches for the original direct path.\n  assign train_valid =''')\n    sub('train_valid && target_aligned && target[31:20] == 12\\\\'b0;', 'train_valid && (in.ctrl.is_jalr || (target_aligned && in.direct_target[31:20] == 12\\\\'b0));')\n    sub('train_valid && target_aligned\\\\n                                && (target[31:20] == 12\\\\'b0 || (in.ctrl.is_branch && in.btb_hit));',\n        \\\"train_valid && (in.ctrl.is_jalr || (target_aligned &&\\\\n                                (in.direct_target[31:20] == 12'b0 || (in.ctrl.is_branch && in.btb_hit))));\\\")\n    sub('resolve_valid_q && train_target_q;', \\\"resolve_valid_q && train_target_q\\\\n      && (\"'!jalr_q || (target_aligned_q && target_q[31:20] == 12'\"'b0));\\\")\n    sub('resolve_valid_q && train_taken_counter_q;', \\\"resolve_valid_q && train_taken_counter_q\\\\n      && (\"'!jalr_q || (target_aligned_q && target_q[31:20] == 12'\"'b0));\\\")\n    if delay:\n        s = s.replace('\"'!squash_candidate'\"', '\"'!kill_candidate'\"')\n        sub('  assign fetch_resolution.target = target_q;', '''  logic late_miss, kill_candidate;\n  logic late_valid_q, late_taken_q;\n  logic [31:0] late_target_q, late_fallthrough_q;\n  logic use_direct_resolution;\n  assign late_miss = resolve_valid_q && jalr_q\n                  && (target_aligned_q ? \"'!jalr_match : !match_fallthrough_q);\n  assign kill_candidate = squash_candidate || late_miss;\n  assign use_direct_resolution = resolve_valid_q && !jalr_q;\n  always_ff @(posedge clock) begin\n    late_valid_q <= !reset && late_miss;\n    if (late_miss) begin\n      late_taken_q <= target_aligned_q;\n      late_target_q <= target_q;\n      late_fallthrough_q <= fallthrough_q;\n    end\n  end\n  assign fetch_resolution.target = late_valid_q ? late_target_q : target_q;'\"''')\n        sub('  assign fetch_resolution.fallthrough = fallthrough_q;', '  assign fetch_resolution.fallthrough = late_valid_q ? late_fallthrough_q : fallthrough_q;')\n        sub('  assign fetch_resolution.take_target = take_target;', '  assign fetch_resolution.take_target = late_valid_q ? late_taken_q : take_target;')\n        sub('  assign fetch_resolution.match_target = match_target_q;', '  assign fetch_resolution.match_target = \"'!late_valid_q && match_target_q;'\"')\n        sub('  assign fetch_resolution.match_fallthrough = match_fallthrough_q;', '  assign fetch_resolution.match_fallthrough = \"'!late_valid_q && match_fallthrough_q;'\"')\n        sub('  assign fetch_resolution.valid = resolve_valid_q;', '  assign fetch_resolution.valid = late_valid_q || use_direct_resolution;')\n    else:\n        sub('  assign fetch_resolution.match_target = match_target_q;', '  assign fetch_resolution.match_target = jalr_q ? jalr_match : match_target_q;')\n    path.write_text(s)\n\nbuild('compare-q', False, False)\nbuild('delayed-correction', True, False)\nbuild('compare-q-add', False, True)\nPY\npython3 \\\"\"'$TMPDIR/predictor-profile/late_jalr.py\"\ncat > \"$TMPDIR/predictor-profile/timing.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os,json,sys\nfrom tools.eval.gowin import build_all, summarize\np = Path(os.environ['TMPDIR']) / 'predictor-profile'\nname = sys.argv[1]\nopts = tuple(map(int, sys.argv[2:])) or (0,1,2)\nr = build_all(Path.cwd(), p / f'{name}-rtl', 'fpga/core_bench_si.sv', p / f'{name}-gowin', options=opts)\nif len(r) == 3:\n print(json.dumps(summarize(r),indent=2))\nfor x in r:\n print(x.get('place_option'), x.get('fmax_mhz'), x.get('reason'), x.get('logic'), x.get('critical_paths',[])[:3], flush=True)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
