{"type": "item.started", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r10-divider.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tempfile import mkdtemp\n\nfrom tools.eval.gowin import build\nfrom tools.eval.fpga import _bench_sv\n\nworktree = Path.cwd()\nbase = Path(mkdtemp(prefix='bench-r10s0-divider-', dir=os.environ['TMPDIR']))\nprint(base, flush=True)\nrtl = worktree / 'cores/bench/rtl'\nbenches = _bench_sv(str(worktree), 'bench')\n\ndef radix16(s, subtract_at_start=False):\n    s = s.replace('  logic [63:0] partial_q, after_prefix, after_radix4_a, after_radix4_b;', '''  logic [63:0] partial_q, after_prefix, after_radix4_a, after_radix16;\n  logic [36:0] divisor_extended;\n  logic [36:0] divisor_x2, divisor_x4, divisor_x8, divisor_x16;\n  logic [36:0] divisor_multiple [1:15];\n  logic [36:0] divisor_multiple_q [1:15];\n  logic [36:0] partial_shifted;\n  logic [36:0] trial [0:15];\n  logic [15:0] digit_select;\n  logic [31:0] digit_remainder [0:15];\n  logic [3:0] digit_quotient [0:15];\n  logic [31:0] radix16_remainder;\n  logic [3:0] radix16_digit;''')\n    s = s.replace('  assign after_radix4_b = radix4_step(after_radix4_a, divisor_q, triple_divisor_q);', '''  assign divisor_extended = {5'b0, divisor_q};\n  assign {divisor_x2, divisor_x4, divisor_x8, divisor_x16} = {\n    divisor_extended << 1, divisor_extended << 2,\n    divisor_extended << 3, divisor_extended << 4\n  };\n  assign divisor_multiple[1] = divisor_extended;\n  assign divisor_multiple[2] = divisor_x2;\n  assign divisor_multiple[3] = divisor_x2 + divisor_extended;\n  assign divisor_multiple[4] = divisor_x4;\n  assign divisor_multiple[5] = divisor_x4 + divisor_extended;\n  assign divisor_multiple[6] = divisor_x4 + divisor_x2;\n  assign divisor_multiple[7] = divisor_x8 - divisor_extended;\n  assign divisor_multiple[8] = divisor_x8;\n  assign divisor_multiple[9] = divisor_x8 + divisor_extended;\n  assign divisor_multiple[10] = divisor_x8 + divisor_x2;\n  assign divisor_multiple[11] = (divisor_x8 \"'^ divisor_x2 ''^ divisor_extended)\n                              + (((divisor_x8 & divisor_x2) | (divisor_x8 & divisor_extended)\n                                 | (divisor_x2 & divisor_extended)) << 1);\n  assign divisor_multiple[12] = divisor_x8 + divisor_x4;\n  assign divisor_multiple[13] = (divisor_x8 ''^ divisor_x4 ''^ divisor_extended)\n                              + (((divisor_x8 & divisor_x4) | (divisor_x8 & divisor_extended)\n                                 | (divisor_x4 & divisor_extended)) << 1);\n  assign divisor_multiple[14] = divisor_x16 - divisor_x2;\n  assign divisor_multiple[15] = divisor_x16 - divisor_extended;\n  assign partial_shifted = {1'\"'b0, partial_q[63:28]};\n  assign trial[0] = partial_shifted;\n  for (genvar d = 1; d < 16; d++) begin : trials\n    always_ff @(posedge clock) begin\n      if (div_phase_q == 4'd8)\n        divisor_multiple_q[d] <= divisor_multiple[d];\n    end\n    assign trial[d] = partial_shifted - divisor_multiple_q[d];\n  end\n  for (genvar d = 0; d < 16; d++) begin : masks\n    if (d == 15) begin : last_digit\n      assign digit_select[d] = \"'!trial[d][36];\n    end else begin : earlier_digits\n      assign digit_select[d] = !trial[d][36] && trial[d+1][36];\n    end\n    assign digit_remainder[d] = {32{digit_select[d]}} & trial[d][31:0];\n    assign digit_quotient[d] = {4{digit_select[d]}} & 4'\"'(d);\n  end\n  for (genvar b = 0; b < 32; b++) begin : remainder_bits\n    logic [15:0] choices;\n    for (genvar d = 0; d < 16; d++) begin : digit_bit\n      assign choices[d] = digit_remainder[d][b];\n    end\n    assign radix16_remainder[b] = |choices;\n  end\n  for (genvar b = 0; b < 4; b++) begin : quotient_bits\n    logic [15:0] choices;\n    for (genvar d = 0; d < 16; d++) begin : digit_bit\n      assign choices[d] = digit_quotient[d][b];\n    end\n    assign radix16_digit[b] = |choices;\n  end\n  assign after_radix16 = {radix16_remainder, partial_q[27:0], radix16_digit};''')\n    return s.replace('partial_q <= after_radix4_b', 'partial_q <= after_radix16')\n\ndef grouped_subtract(s, bits):\n    a = s.index('  function automatic [63:0] radix4_step(')\n    stops = sorted(set(range(0, 35, bits)) | {35})\n    fields = list(zip(stops[:-1], stops[1:]))\n    definition = '''  function automatic logic [34:0] restoring_trial(\n    input logic [34:0] minuend,\n    input logic [34:0] subtrahend\n  );\n'''\n    for i, (start, end) in enumerate(fields):\n        width = end - start\n        definition += f'    logic [{width}:0] chunk_{i};\\\\n'\n    definition += f'    logic [{len(fields)-1}:1] borrow;\\\\n    begin\\\\n'\n    for i, (start, end) in enumerate(fields):\n        definition += f\\\"      chunk_{i} = {{1'b0, minuend[{end-1}:{start}]}} - {{1'b0, subtrahend[{end-1}:{start}]}};\\\\n\\\"\n    for i, (start, end) in enumerate(fields):\n        width = end - start\n        if i < len(fields)-1:\n            definition += f'      borrow[{i+1}] = chunk_{i}[{width}]'\n            if i:\n                definition += f' || ((minuend[{end-1}:{start}] == subtrahend[{end-1}:{start}]) && borrow[{i}])'\n            definition += ';\\\\n'\n        definition += f'      restoring_trial[{end-1}:{start}] = chunk_{i}[{width-1}:0]'\n        if i:\n            definition += f\\\" - {width}'(borrow[{i}])\\\"\n        definition += ';\\\\n'\n    definition += '    end\\\\n  endfunction\\\\n\\\\n'\n    s = s[:a] + definition + s[a:]\n    return s.replace('shifted - {3\\\\'b0, divisor}', 'restoring_trial(shifted, {3\\\\'b0, divisor})') \\\\\n        .replace('shifted - {2\\\\'b0, divisor, 1\\\\'b0}', 'restoring_trial(shifted, {2\\\\'b0, divisor, 1\\\\'b0})') \\\\\n        .replace('shifted - {1\\\\'b0, triple_divisor}', 'restoring_trial(shifted, {1\\\\'b0, triple_divisor})')\n\ncases = {'radix16': radix16, 'grouped8': lambda s: grouped_subtract(s, 8), 'grouped12': lambda s: grouped_subtract(s, 12)}\nfor name, transform in cases.items():\n    copytree(rtl, base / name / 'rtl')\n    variant = base / name / 'rtl/alu.sv'\n    variant.write_text(transform(variant.read_text()))\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, worktree, base / name / 'rtl', benches, p, base / name / f'gowin_p{p}'): (name, p)\n        for name in cases for p in (0, 1, 2)\n    }\n    for f in concurrent.futures.as_completed(futures):\n        r = f.result()\n        print(*futures[f], r.get('fmax_mhz'), r.get('regs'), r.get('logic'), r.get('reason'),\n              [(p['from'], p['to'], p['logic_cells']) for p in r.get('critical_paths', [])[:3]], flush=True)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-divider.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.started", "item": {"id": "item_33", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r10-advance.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tempfile import mkdtemp\n\nfrom tools.eval.gowin import build\nfrom tools.eval.fpga import _bench_sv\n\nworktree = Path.cwd()\nbase = Path(mkdtemp(prefix='bench-r10s0-advance-', dir=os.environ['TMPDIR']))\nprint(base, flush=True)\nrtl = worktree / 'cores/bench/rtl'\nbenches = _bench_sv(str(worktree), 'bench')\n\ndef prqualify_mem(p, clear_mem, direct_store=False):\n    def rewrite(name, transform):\n        path = p / f'{name}.sv'\n        path.write_text(transform(path.read_text()))\n    def ex(s):\n        s = s.replace('mem_ctrl.reg_write = in.ctrl.reg_write && \"'!(in.ctrl.is_jump && !target_aligned);'\"',\n                      'mem_ctrl.reg_write = in.ctrl.reg_write && \"'!mem_misalign'\"\\\\n                       && \"'!(in.ctrl.is_jump && !target_aligned);'\"')\n        if clear_mem:\n            s = s.replace('    mem_ctrl = in.ctrl;', '''    mem_ctrl = in.ctrl;\n    mem_ctrl.mem_read  = in.ctrl.mem_read  && \"'!mem_misalign;\n    mem_ctrl.mem_write = in.ctrl.mem_write && !mem_misalign;'\"''')\n        if direct_store:\n            s = s.replace('reg_q.write_data     <= rs2;', '''reg_q.write_data     <= (in.ctrl.mem_width \"'!= 2'\"'d0 && in.ctrl.mem_width \"'!= 2'\"'d1) ? rs2\n                            : (in.ctrl.mem_width == 2'd0) ? {4{rs2[7:0]}} : {2{rs2[15:0]}};''')\n        return s\n    def mem(s):\n        s = s.replace('in.ctrl.reg_write && \"'!in.mem_misalign;'\"', 'in.ctrl.reg_write;')\n        if clear_mem:\n            s = s.replace('(in.ctrl.mem_read || in.ctrl.mem_write) && \"'!in.mem_misalign'\"', '(in.ctrl.mem_read || in.ctrl.mem_write)')\n            s = s.replace('in.ctrl.mem_write && \"'!in.mem_misalign'\"', 'in.ctrl.mem_write')\n            s = s.replace('in.ctrl.mem_read && \"'!in.mem_misalign'\"', 'in.ctrl.mem_read')\n        if direct_store:\n            a = s.index('    // Byte/halfword replication for stores.')\n            b = s.index('    // Byte-lane mask', a)\n            s = s[:a] + '    wdata_rep = in.write_data;\\\\n\\\\n' + s[b:]\n        return s\n    rewrite('ex_stage', ex)\n    rewrite('mem_stage', mem)\n\ndef shifter(p, reverse):\n    path = p / 'alu.sv'\n    s = path.read_text()\n    a = s.index('  always_comb begin\\\\n    case (op)\\\\n      ALU_SLL:')\n    b = s.index('  always_comb begin', a+1)\n    shift_logic = '''  logic [31:0] shift_input, shifted, reversed_input, reversed_output;\n  logic shift_left, shift_sign;\n  assign shift_left = op == ALU_SLL;\n  assign shift_sign = op == ALU_SRA && a[31];\n  for (genvar i = 0; i < 32; i++) begin : reverse_shift\n    assign reversed_input[i] = a[31-i];\n    assign reversed_output[i] = shifted[31-i];\n  end\n  assign shift_input = shift_left ? reversed_input : a;\n  assign shifted = 32'(\"'$signed({shift_sign, shift_input}) >>> shamt);\n  assign shift_result = shift_left ? reversed_output : shifted;\n\n'\"'''\n    if not reverse:\n        shift_logic = '''  logic [31:0] signed_right, left;\n  logic sign_fill;\n  assign sign_fill = op == ALU_SRA && a[31];\n  assign signed_right = 32'(\"'$signed({sign_fill, a}) >>> shamt);\n  assign left = a << shamt;\n  assign shift_result = op == ALU_SLL ? left : signed_right;\n\n'\"'''\n    path.write_text(s[:a] + shift_logic + s[b:])\n\ncases = {\n    'write': lambda p: prqualify_mem(p, False),\n    'mem': lambda p: prqualify_mem(p, True),\n    'unified-shift': lambda p: shifter(p, False),\n    'reverse-shift': lambda p: shifter(p, True),\n}\nfor name, transform in cases.items():\n    copytree(rtl, base / name / 'rtl')\n    transform(base / name / 'rtl')\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:\n    futures = {\n        pool.submit(build, worktree, base / name / 'rtl', benches, p, base / name / f'gowin_p{p}'): (name, p)\n        for name in cases for p in (0, 1, 2)\n    }\n    for f in concurrent.futures.as_completed(futures):\n        r = f.result()\n        print(*futures[f], r.get('fmax_mhz'), r.get('regs'), r.get('logic'), r.get('reason'),\n              [(p['from'], p['to'], p['logic_cells']) for p in r.get('critical_paths', [])[:3]], flush=True)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-advance.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
