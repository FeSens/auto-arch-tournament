{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"sed -n '1,\"'$p'\"' cores/bench/rtl/forward_unit.sv\"","aggregated_output":"// ID captures the youngest slot match and a separate ingress match.\n// EX qualifies the ingress writer and selects the ready value.\nmodule forward_unit (\n  input  logic          ex_match,\n  input  slot_tag_t     matches_in,\n  input  logic          wb_match,\n  input  logic [31:0]   base_value,\n  input  slot_tag_t     pending,\n  input  logic [95:0]   slot_values,\n  input  slot_tag_t     ingress,\n  input  logic          ingress_writer,\n  input  logic          ingress_pending,\n  input  ex_result_t    ingress_results,\n  input  logic          wb_writer,\n  input  logic [31:0]   wb_value,\n  output logic [31:0]   value,\n  output slot_tag_t     waiting_for\n);\n\n  slot_tag_t selected;\n  logic use_ingress, use_wb, use_base;\n\n  assign use_ingress = ex_match && ingress_writer;\n  assign selected = matches_in & {3{!use_ingress}};\n  assign use_wb = !use_ingress && !(|matches_in) && wb_match && wb_writer;\n  assign use_base = !use_ingress && !(|matches_in) && !(wb_match && wb_writer);\n\n  assign waiting_for = (selected & pending) | (ingress & {3{use_ingress && ingress_pending}});\n  assign value = select_ex_result(ingress_results, use_ingress && !ingress_pending)\n               | ({32{selected[0] && !pending[0]}} & slot_values[0 +: 32])\n               | ({32{selected[1] && !pending[1]}} & slot_values[32 +: 32])\n               | ({32{selected[2] && !pending[2]}} & slot_values[64 +: 32])\n               | ({32{use_wb}} & wb_value)\n               | ({32{use_base}} & base_value);\n\nendmodule\n","exit_code":0,"status":"completed"}}
