{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/bench-r9s1-study\"\ncat > \"$scratch/trace-profile.py\" <<'\"'PY'\nfrom collections import Counter\nfrom pathlib import Path\nimport json, sys\n\ndef classify(insn):\n    opc = insn & 127\n    funct3 = (insn >> 12) & 7\n    if opc == 0x33 and insn >> 25 == 1:\n        return 'mul' if funct3 < 4 else 'div'\n    if opc in (0x13, 0x33) and funct3 in (1,5):\n        return 'shift'\n    if opc in (0x13,0x33,0x37,0x17):\n        return 'ALU'\n    if opc == 0x03:\n        return 'load'\n    if opc == 0x23:\n        return 'store'\n    if opc == 0x63:\n        return 'eq' if funct3 < 2 else 'ordered'\n    if opc in (0x67,0x6f):\n        return 'jalr' if opc == 0x67 else 'jal'\n    return 'other'\n\ncounts = Counter()\ngaps = Counter()\nactual = Counter()\nprofile = Counter()\nprev_rd = 0\nactive = False\nwith Path(sys.argv[1]).open() as file:\n    for line in file:\n        if not line.startswith('{\\\"order\\\":'):\n            continue\n        a = json.loads(line)\n        if a['mem_addr'] == 0x10000100 and a['mem_wmask']:\n            active = True\n            continue\n        if a['mem_addr'] == 0x10000104 and a['mem_wmask']:\n            break\n        if not active:\n            continue\n        insn = a['insn']\n        opc = insn & 127\n        cls = classify(insn)\n        profile[cls] += 1\n        if prev_rd and prev_rd in (a['rs1_addr'],a['rs2_addr']):\n            counts[prev_cls,cls] += 1\n            if (prev_rd == a['rs1_addr'] and opc in (0x03,0x13,0x23,0x33,0x63,0x67)) or (\n                prev_rd == a['rs2_addr'] and opc in (0x23,0x33,0x63)):\n                actual[prev_cls,cls] += 1\n                gaps[prev_cls, a['cycle']-prev_cycle] += 1\n        prev_rd = a['rd_addr']\n        prev_cls = cls\n        prev_cycle = a['cycle']\nprint(profile)\nfor producer in ('load','mul','shift'):\n    data = [((p,c),t,actual[p,c]) for (p,c),t in counts.most_common() if p == producer]\n    print(producer, data)\n    print('totals',sum(x[1] for x in data),sum(x[2] for x in data))\n    print('actual gaps',sorted((g,t) for (p,g),t in gaps.items() if p == producer))\nPY\npython3 \\\"\"'$scratch/trace-profile.py\" \"$scratch/base-trace.jsonl\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
