{"type":"item.started","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/rtl/alu.sv')\ns = p.read_text()\ni = s.index('  logic [7:0] prefix_triple;')\nj = s.index('  // Upper half',i)\ns = s[:i] + \\\"\\\"\\\"  logic [7:0] prefix_triple, large_prefix;\n  logic [5:0] leading_bits;\n  logic [11:0] prefix_result;\n  logic [11:0] small_prefix [0:15];\n\\\"\\\"\\\" + s[j:]\ni = s.index('  function automatic [3:0] first_step')\nj = s.index('  // During the first update',i)\ns = s[:i]+s[j:]\ni = s.index('  assign prefix_triple =')\nj = s.index('  assign after_radix4_a =',i)\ns = s[:i]+\\\"\\\"\\\"  assign leading_bits = partial_q[31:26];\n  assign prefix_triple = {2'b0, divisor_q[5:0]} + {1'b0, divisor_q[5:0], 1'b0};\n  assign large_prefix = prefix_step(leading_bits, divisor_q[5:0], prefix_triple);\n  assign small_prefix[0] = {12{1'b0}};\n  for (genvar d = 1; d < 16; d++) begin : const_divisor\n    localparam logic [5:0] DIVISOR = 6'(d);\n    logic [5:0] quotient, remainder;\n    assign quotient = leading_bits / DIVISOR;\n    assign remainder = leading_bits % DIVISOR;\n    assign small_prefix[d] = {12{divisor_q[5:0] == DIVISOR}} & {remainder, quotient};\n  end\n  for (genvar i = 0; i < 12; i++) begin : mux_prefix\n    logic [15:0] by_divisor;\n    for (genvar d = 0; d < 16; d++) begin : select_bits\n      assign by_divisor[d] = small_prefix[d][i];\n    end\n    assign prefix_result[i] = |by_divisor;\n  end\n  always_comb begin\n    if (|divisor_q[31:6]) after_prefix = {26'b0, leading_bits, partial_q[25:0], 6'b0};\n    else if (divisor_q[5:0] == 6'd0) after_prefix = {26'b0, leading_bits, partial_q[25:0], 6'h3f};\n    else if (|divisor_q[5:4]) after_prefix = {26'b0, large_prefix[7:2], partial_q[25:0], 4'b0, large_prefix[1:0]};\n    else after_prefix = {26'b0, prefix_result[11:6], partial_q[25:0], prefix_result[5:0]};\n  end\n\\\"\\\"\\\" + s[j:]\np.write_text(s)\nPY\nmake lint TARGET