or i in branches] == [2, 2, 1, 2, 1, 1]\\\"\\\"\\\")\n    return t\n\ndef same_index(t):\n    t = t.replace(\\\"\\\"\\\"    # A and B share PC[6:2]. When the hot JAL at A predicts B, its EX\n    # update must count as a miss in B's latched metadata. B then trains\n    # from weakly taken, so one untaken outcome clears the taken prediction.\\\"\\\"\\\", \\\"\\\"\\\"    # The hot JAL at A predicts B. B shares A's index and must train as\n    # a miss on its taken outcome. One untaken then clears its prediction.\n    # Reentry via each preamble uses the ordinary BTB lookup at A and B.\\\"\\\"\\\")\n    t = t.replace(\\\"        b: BEQ\\\", \\\"        b - 0x04: NOP(),\\\\n        b: BEQ\\\")\n    t = t.replace(\\\"BEQ(1, 2, a - (b + 0x0C))\\\", \\\"BEQ(1, 2, (a - 4) - (b + 0x0C))\\\")\n    t = t.replace(\\\"JAL(0, -0x10)\\\", \\\"JAL(0, -0x14)\\\").replace(\\\"JAL(0, -0x24)\\\", \\\"JAL(0, -0x28)\\\")\n    t = t.replace(\\\"0x98, 0x9C, a, b, 0xB0, 0xB4,\\\\n        b, 0x94, 0x98, 0x9C, 0xA0, b,\\\", \\\"0x98, 0x9C, 0x0C, a, b, 0xB0, 0xB4,\\\\n        0x8C, b, 0x94, 0x98, 0x9C, 0xA0, 0x8C, b,\\\")\n    return t\n\ndef jalr(t):\n    t = t.replace(\\\"\\\"\\\"        0x04: JALR(6, 5, -0x111),\n        0x08: BEQ(0, 0, 2),\n        0x0C: BEQ(0, 5, 2),\n        0x10: JAL(7, 2),\n        0x14: EBREAK(),\\\"\\\"\\\", \\\"\\\"\\\"        0x04: NOP(),\n        0x08: JALR(6, 5, -0x111),\n        0x0C: BEQ(0, 0, 2),\n        0x10: BEQ(0, 5, 2),\n        0x14: JAL(7, 2),\n        0x18: EBREAK(),\\\"\\\"\\\")\n    t = t.replace(\\\"[0, 4, 0x40, 0x44, 4, 0x50, 0x54, 4, 8, 12, 16, 20]\\\",\n                  \\\"[0, 4, 8, 0x40, 0x44, 4, 8, 0x50, 0x54, 4, 8, 12, 16, 20, 24]\\\")\n    t = t.replace(\\\"== [4, 8, 16]\\\", \\\"== [8, 12, 20]\\\")\n    t = t.replace('r[\\\"pc\\\"] == 4] == [(6, 8), (6, 8), (0, 0)]', 'r[\\\"pc\\\"] == 8] == [(6, 12), (6, 12), (0, 0)]')\n    t = t.replace(\\\"if pc == 4] == [8, 0x40, 0x50]\\\", \\\"if pc == 8] == [12, 0x40, 0x50]\\\")\n    return t\n\ndef st