valid_q[replay_read_bank]\n                         && replay_slots_read[replay_probe_index_q[4:0]]\n                         && replay_tag == normal_pc_q[19:12] && \"'!replay_collision;\n  assign replay_hit = replay_probe_hit || replay_held_valid_q;\n\n  always_ff @(posedge clock) begin\n    replay_retry_q <= !reset && !replay_retry_q && (squash_candidate || !ordinary_accept);\n    if (reset || fetch_resolution.refetch || squash_candidate || ordinary_accept) begin\n      replay_held_valid_q <= 1'\"'b0;\n    end else if (replay_probe_hit) begin\n      replay_held_valid_q <= 1'b1;\n      replay_held_word_q <= replay_word;\n    end\n  end''')\ns = s.replace('''    {replay_tag, replay_word} <= replay_entry[normal_pc_d[11:2]];''', '''    {replay_tag, replay_word} <= replay_entry[replay_probe_index];\n    replay_probe_index_q <= replay_probe_index;''')\ns = s.replace('replay_read_slots_q <= replay_valid_slots[normal_pc_d[11:7]];',\n              'replay_read_slots_q <= replay_valid_slots[replay_probe_index[9:5]];')\ns = s.replace('    out.instr       = imem_ready ? imem_data : replay_word;',\n              '    out.instr       = imem_ready ? imem_data : replay_held_valid_q ? replay_held_word_q : replay_word;')\nrtl.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
