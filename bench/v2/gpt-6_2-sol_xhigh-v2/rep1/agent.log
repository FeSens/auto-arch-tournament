if (advance_fetch) pc <= predicted_pc;','else if (refill)        pc <= predicted_pc;',1),\n ('    if (\"'!reset && btb_update.write_target)'\"\\\\n      btb_entry[write_index] <= {write_tag, btb_update.target_word};','    if (\"'!reset && btb_update.write_target) begin'\"\\\\n      btb_tag[write_index] <= write_tag;\\\\n      btb_target[write_index] <= btb_update.target_word;\\\\n    end',1),\n ('    out.pc       = pc;\\\\n    out.pc_plus4 = pc_plus4;\\\\n    out.instr    = imem_data;', '''    out.pc           = head.pc;\n    out.pc_plus4     = head.pc + 32'd4;\n    out.instr        = head.instr;\n    out.predicted_pc = head.predicted_pc;''',1),\n ('    out.btb_hit = same_index_write ? fetch_in_range && write_tag == pc[19:7] : hit;\\\\n    out.btb_counter = same_index_write ? btb_update.counter : counter;', '''    out.btb_hit = issue_in_range && (same_index_write\n                ? write_tag == head.pc[19:7]\n                : btb_valid[issue_index] && btb_tag[issue_index] == head.pc[19:7]);\n    out.btb_counter = same_index_write ? btb_update.counter : btb_counter[issue_index];''',1),\n])\nPY\ncat > run-depth.sh <<'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\ndepth=$1\nverilator -DQUEUE_DEPTH=\"$depth\" --cc --exe --build -j 3 -Mdir \"$PWD/obj-$depth\" \"+incdir+$PWD/runahead\" --top-module core -Wno-fatal -CFLAGS \"-DNRET=1\" \"$PWD/runahead/core_pkg.sv\" \"$PWD/runahead/\"*.sv \"$2\" -o cosim_sim > \"build-$depth.log\" 2>&1\n\"$PWD/obj-$depth/cosim_sim\" \"$PWD/coremark.elf\" 50000000 --bench --istall --dstall > \"result-$depth.jsonl\"\nEOF\nfor depth in 1 2 4 8; do\n  bash run-depth.sh \"$depth\" \"$OLDPWD/test/cosim/main.cpp\" &\ndone\nwait\npython - <<'\"'PY'\nimport glob,json\nfor f in sorted(glob.glob('result-*.jsonl')):\n r = json.loads(open(f).read().splitlines()[-1])\n print(f,r['bench_stop_cycle']-r['bench_start_cycle'],r['ebreak'],r['oob'], '0xfcaf' in r['uart'] and 'Correct operation validated.' in r['uart'])\nPY\n\"", "aggregated_output": "result-