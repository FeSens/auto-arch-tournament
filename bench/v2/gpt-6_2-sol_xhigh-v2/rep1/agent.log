{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/7cb5c576/6b2b6527/jalr_experiment.py <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nfor variant in sys.argv[1:]:\n    root = Path(__file__).parent / variant\n    rtl = root / \\\"cores/bench/rtl\\\"\n    rtl.parent.mkdir(parents=True, exist_ok=True)\n    shutil.copytree(\\\"cores/bench/rtl\\\", rtl)\n    shutil.copy2(\\\"cores/bench/core.yaml\\\", rtl.parent)\n    shutil.copytree(\\\"fpga\\\", root / \\\"fpga\\\")\n    ex_path = rtl / \\\"ex_stage.sv\\\"\n    ex = ex_path.read_text()\n    anchor = \\\"  assign jalr_sum = rs1 + in.imm;\\\"\n    logic = \\\"\\\"\\\"\n  logic [12:0] jalr_low;\n  logic jalr_add_high, jalr_sub_high;\n  assign jalr_low = {1'b0, rs1[11:0]} + {1'b0, in.imm[11:0]};\n  assign jalr_sum[11:0] = jalr_low[11:0];\n  assign jalr_add_high = \"'!in.imm[11] && jalr_low[12];\n  assign jalr_sub_high = in.imm[11] && !jalr_low[12];\n\"\"\"\n    if \"mux\" in variant:\n        logic += \"\"\"\n  logic [19:0] jalr_hi_inc, jalr_hi_dec;\n  assign jalr_hi_inc = rs1[31:12] + 20'\"'d1;\n  assign jalr_hi_dec = rs1[31:12] - 20'd1;\n  assign jalr_sum[31:12] = ({20{jalr_add_high}} & jalr_hi_inc)\n                         | ({20{jalr_sub_high}} & jalr_hi_dec)\n                         | ({20{\"'!jalr_add_high && !jalr_sub_high}} & rs1[31:12]);\n\"\"\"\n    else:\n        logic += \"\"\"\n  assign jalr_sum[12] = rs1[12] ''^ (jalr_low[12] ''^ in.imm[11]);\n  for (genvar i = 13; i < 32; ++i) begin : jalr_high\n    assign jalr_sum[i] = rs1[i] ''^ (((&rs1[i-1:12]) && jalr_add_high)\n                                  || ((~|rs1[i-1:12]) && jalr_sub_high));\n  end\n\"\"\"\n    assert ex.count(anchor) == 1\n    ex = ex.replace(anchor, logic)\n    if \"split\" in variant:\n        ex = ex.replace(\"!fetch_parked && fetch_pc == target\",\n                        \"!fetch_parked && (in.ctrl.is_jalr ? fetch_pc == (jalr_sum & 32'\"'hffff_fffe)