{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nroot = Path('cores/bench/rtl')\n\ndef update(file, replacements):\n    path = root / file\n    source = path.read_text()\n    for old, new in replacements:\n        assert source.count(old) == 1, (file, old, source.count(old))\n        source = source.replace(old, new)\n    path.write_text(source)\n\nupdate('core_pkg.sv', [(\n    '    logic [1:0]  ex_match;      // {rs2, rs1}, producer advances to EX/MEM\\\\n'\n    '    logic [1:0]  mem_match;     // {rs2, rs1}, producer advances to MEM/WB',\n    '    fwd_sel_t    fwd_rs1;\\\\n'\n    '    fwd_sel_t    fwd_rs2;'\n)])\nupdate('forward_unit.sv', [\n    ('// Qualify the matches captured by ID with the producers\\\\' writer controls.',\n     '// Resolve the bypass selects for the instruction about to be captured by ID.'),\n    ('  input  logic [1:0] ex_match,\\\\n  input  logic [1:0] mem_match,',\n     '  input  logic [4:0] rs1,\\\\n  input  logic [4:0] rs2,\\\\n  input  logic [4:0] ex_rd,\\\\n  input  logic [4:0] mem_rd,'),\n    ('  assign younger = ex_match & {2{ex_mem_w_en}};\\\\n  assign older = mem_match & {2{mem_wb_w_en}};',\n     '  assign younger = {rs2 \"'!= 0 && rs2 == ex_rd, rs1 != 0 && rs1 == ex_rd} & {2{ex_mem_w_en}};'\"\\\\n'\n     '  assign older = {rs2 \"'!= 0 && rs2 == mem_rd, rs1 != 0 && rs1 == mem_rd} & {2{mem_wb_w_en}};'\"')\n])\nupdate('id_stage.sv', [\n    ('  input  logic [4:0]        ex_rd,\\\\n  input  logic [4:0]        mem_rd,',\n     '  input  fwd_sel_t          next_fwd_rs1,\\\\n  input  fwd_sel_t          next_fwd_rs2,'),\n    ('      reg_q.ex_match      <= {rs2_addr \"'!= 5'\"\\\\'b0 && rs2_addr == ex_rd,\\\\n'\n     '                              rs1_addr \"'!= 5'\"\\\\'b0 && rs1_addr == ex_rd};\\\\n'\n     '      reg_q.mem_match     <= {rs2_addr \"'!= 5'\"\\\\'b0 && rs2_addr == mem_rd,\\\\n'\n     '                              rs1_addr \"'!= 5'\"\\\\'b0 && rs1_addr == mem_rd};',\n     '      reg_q.fwd_rs1       <= next_fwd_rs1;\\\\n'\n     '      reg_q.fwd_rs2       <= next_fwd_rs2;'),\n    ('        reg_q.ex_match  <= \\\\'0;\\\\n        reg_q.mem_match <= replay_load_match;',\n     '        reg_q.fwd_rs1   <= \\\\'{result: \\\\'0, wb: replay_load_match[0], regfile: \"'!replay_load_match[0]};'\"\\\\n'\n     '        reg_q.fwd_rs2   <= \\\\'{result: \\\\'0, wb: replay_load_match[1], regfile: \"'!replay_load_match[1]};'\"')\n])\nupdate('ex_stage.sv', [\n    ('  // Dependency matches are consumed by forward_unit.\\\\n', ''),\n    ('  input  fwd_sel_t           fwd_rs1_sel,\\\\n  input  fwd_sel_t           fwd_rs2_sel,\\\\n', ''),\n    ('  output ex_mem_t             out,', '  output ex_mem_t             out,\\\\n'\n     '  output result_sel_t         next_result_sel,\\\\n'\n     '  output logic                next_writer,'),\n    ('  logic [1:0]  live_load;', '  logic [1:0]  live_load;\\\\n'\n     '  fwd_sel_t fwd_rs1_sel, fwd_rs2_sel;\\\\n\\\\n'\n     '  assign fwd_rs1_sel = in.fwd_rs1;\\\\n'\n     '  assign fwd_rs2_sel = in.fwd_rs2;'),\n    ('  // ── EX/MEM register', \n     '  assign next_result_sel = result_sel;\\\\n'\n     '  assign next_writer = in.valid && \"'!squash_candidate && mem_ctrl.reg_write && !mem_misalign;'\"\\\\n\\\\n'\n     '  // ── EX/MEM register')\n])\nupdate('core.sv', [\n    ('  fwd_sel_t    fwd_rs1_sel, fwd_rs2_sel;', '  fwd_sel_t    fwd_rs1_sel, fwd_rs2_sel, next_fwd_rs1, next_fwd_rs2;\\\\n'\n     '  result_sel_t next_result_sel;\\\\n'\n     '  logic        next_writer;'),\n    ('    .ex_rd            (id_ex_w.rd),\\\\n    .mem_rd           (ex_mem_w.rd),',\n     '    .next_fwd_rs1     (next_fwd_rs1),\\\\n    .next_fwd_rs2     (next_fwd_rs2),'),\n    ('    .fwd_rs1_sel      (fwd_rs1_sel),\\\\n    .fwd_rs2_sel      (fwd_rs2_sel),\\\\n', ''),\n    ('    .out              (ex_mem_w),\\\\n', '    .out              (ex_mem_w),\\\\n'\n     '    .next_result_sel  (next_result_sel),\\