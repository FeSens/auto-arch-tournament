{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/trace_profile.py\" <<'\"'PY'\nfrom collections import Counter\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nroot = Path.cwd()\nexe = Path(sys.argv[1]) / 'champion/obj_dir/cosim_sim'\nelf = root.parents[3] / 'bench/programs/coremark.elf'\nprocess = subprocess.Popen([str(exe), str(elf), '50000000', '--istall', '--dstall'],\n                           stdout=subprocess.PIPE)\nparts = [b'\\\"cycle\\\":', b'\\\"insn\\\":', b'\\\"mem_addr\\\":', b'\\\"rd_addr\\\":', b'\\\"rs1_addr\\\":', b'\\\"rs2_addr\\\":']\ndef extract(row, part):\n    return int(row.split(part, 1)[1].split(b',', 1)[0])\ncounts = Counter()\ninside = False\nprevious_op = previous_dest = None\nfor row in process.stdout:\n    if not row.startswith(b'{\\\"order\\\":'):\n        continue\n    insn = extract(row, parts[1])\n    op = insn & 127\n    if op == 0x23:\n        addr = extract(row, parts[2])\n        if addr == 0x10000100:\n            inside = True\n            continue\n        if addr == 0x10000104:\n            break\n    if not inside:\n        continue\n    counts[op] += 1\n    if previous_op in (3, 0x23):\n        if op in (3, 0x23):\n            counts[('adjacent memory', previous_op, op)] += 1\n        if previous_op == 3 and previous_dest:\n            rs1 = extract(row, parts[4])\n            rs2 = extract(row, parts[5])\n            uses_rs1 = op in (3, 0x13, 0x23, 0x33, 0x63, 0x67)\n            uses_rs2 = op in (0x23, 0x33, 0x63)\n            if (uses_rs1 and rs1 == previous_dest) or (uses_rs2 and rs2 == previous_dest):\n                counts[('load consumer', op)] += 1\n    previous_op = op\n    previous_dest = extract(row, parts[3]) if op == 3 else None\nprocess.stdout.close()\nprocess.wait(timeout=5)\nfor k, v in counts.most_common():\n    print(k, v)\nPY\npython3 -u \\\"\"'$scratch_probe_dir/trace_profile.py\" \"$scratch_probe_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\ncat > \"$scratch_probe_dir/trace_profile.py\" <<'\"'PY'\nfrom collections import Counter\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nroot = Path.cwd()\nexe = Path(sys.argv[1]) / 'champion/obj_dir/cosim_sim'\nelf = root.parents[3] / 'bench/programs/coremark.elf'\nprocess = subprocess.Popen([str(exe), str(elf), '50000000', '--istall', '--dstall'],\n                           stdout=subprocess.PIPE)\nparts = [b'\\\"cycle\\\":', b'\\\"insn\\\":', b'\\\"mem_addr\\\":', b'\\\"rd_addr\\\":', b'\\\"rs1_addr\\\":', b'\\\"rs2_addr\\\":']\ndef extract(row, part):\n    return int(row.split(part, 1)[1].split(b',', 1)[0])\ncounts = Counter()\ninside = False\nprevious_op = previous_dest = None\nfor row in process.stdout:\n    if not row.startswith(b'{\\\"order\\\":'):\n        continue\n    insn = extract(row, parts[1])\n    op = insn & 127\n    if op == 0x23:\n        addr = extract(row, parts[2])\n        if addr == 0x10000100:\n            inside = True\n            continue\n        if addr == 0x10000104:\n            break\n    if not inside:\n        continue\n    counts[op] += 1\n    if previous_op in (3, 0x23):\n        if op in (3, 0x23):\n            counts[('adjacent memory', previous_op, op)] += 1\n        if previous_op == 3 and previous_dest:\n            rs1 = extract(row, parts[4])\n            rs2 = extract(row, parts[5])\n            uses_rs1 = op in (3, 0x13, 0x23, 0x33, 0x63, 0x67)\n            uses_rs2 = op in (0x23, 0x33, 0x63)\n            if (uses_rs1 and rs1 == previous_dest) or (uses_rs2 and rs2 == previous_dest):\n                counts[('load consumer', op)] += 1\n    previous_op = op\n    previous_dest = extract(row, parts[3]) if op == 3 else None\nprocess.stdout.close()\nprocess.wait(timeout=5)\nfor k, v in counts.most_common():\n    print(k, v)\nPY\npython3 -u \\\"\"'$scratch_probe_dir/trace_profile.py\" \"$scratch_probe_dir\"'","aggregated_output":"19 1182148\n3 544852\n99 529588\n51 445683\n('adjacent memory', 3, 3) 154483\n35 139630\n('load consumer', 99) 135320\n('adjacent memory', 3, 35) 61722\n('load consumer', 3) 59270\n111 49367\n('adjacent memory', 35, 3) 18868\n55 17012\n103 13735\n('load consumer', 19) 7949\n('adjacent memory', 35, 35) 5456\n('load consumer', 51) 1000\n('load consumer', 35) 420\n","exit_code":0,"status":"completed"}}
