{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/predictor-profile/redirect_btb.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nwork = Path(os.environ['TMPDIR']) / 'predictor-profile'\nsrc = Path('cores/bench/rtl')\ndef build(name, write_on_redirect, if_metadata):\n    rtl = work / f'{name}-rtl'\n    shutil.copytree(src, rtl, dirs_exist_ok=True)\n    def edit(file, *changes):\n        p = rtl / file\n        s = p.read_text()\n        for old, new in changes:\n            assert s.count(old) == 1, (file, old, s.count(old))\n            s = s.replace(old, new)\n        p.write_text(s)\n    if write_on_redirect:\n        edit('core_pkg.sv', ('''    logic [17:0] target_word;\n    btb_action_t taken;''','''    logic [17:0] target_word;\n    logic        hit;\n    btb_action_t taken;'''))\n        edit('ex_stage.sv', ('''  logic train_valid, train_target_q, train_taken_counter_q, train_not_taken_counter_q;''','''  logic train_valid, train_target_q, train_taken_counter_q, train_not_taken_counter_q, train_hit_q;\n  assign btb_training.hit = train_hit_q;'''),\n             ('''    train_pc_word_q           <= in.pc[19:2];''','''    train_pc_word_q           <= in.pc[19:2];\n    train_hit_q               <= in.btb_hit;'''))\n    edit('if_stage.sv',\n         ('logic [31:0] table_target, bypass_target;', 'logic [31:0] table_target;'),\n         ('select_held, select_sequential, select_table_target, select_bypass_target;', 'select_held, select_sequential, select_table_target;'),\n         ('ordinary_taken_hit, ordinary_bypass_hit, predict_on_table, predict_on_bypass;', 'ordinary_taken_hit, ordinary_bypass_hit, predict_on_table;'),\n         ('  assign taken_target_bypass = ordinary_same_index && btb_training.taken.write_target;', '  assign taken_target_bypass = ordinary_same_index && btb_update.write_target;'),\n         ('''  assign predict_on_table = ordinary_table_hit\n                         && (training_taken ? \"'!taken_target_bypass && taken_counter[1] : not_taken_counter[1]);\n  assign predict_on_bypass = ordinary_bypass_hit && training_taken && taken_target_bypass && taken_counter[1];'\"''',\n          '''  assign predict_on_table = ordinary_table_hit && btb_counter[ordinary_index][1];'''),\n         ('  assign predict_taken = predict_on_table || predict_on_bypass;', '  assign predict_taken = predict_on_table;'),\n         ('  assign select_bypass_target = ordinary_available && (ordinary_can_advance && predict_on_bypass);\\\\n', ''),\n         (\\\"  assign bypass_target = {12'b0, btb_training.target_word, 2'b00};\\\\n\\\", ''),\n         ('                              select_bypass_target & bypass_target[i],\\\\n', ''))\n    if write_on_redirect:\n        edit('if_stage.sv',\n             ('  assign btb_update.write_target = selected_action.write_target;', '  assign btb_update.write_target = recover_target && selected_action.write_target;'),\n             ('  assign btb_update.write_counter = selected_action.write_counter;', '''  assign btb_update.write_counter = selected_action.write_counter\n                                  && (btb_training.hit || btb_update.write_target);'''),\n             ('btb_training.taken.write_counter\\\\n                       ?', 'btb_update.write_counter\\\\n                       ?'))\n    if not if_metadata:\n        # Always repair training from the committed entry seen by ID/EX.\n        edit('id_stage.sv',\n             ('                                 : corrected_q ? candidate_btb_hit : reg_q.btb_hit;', '                                 : candidate_btb_hit;'),\n             ('                                         : corrected_q ? candidate_btb_counter : reg_q.btb_counter;', '                                         : candidate_btb_counter;'))\nbuild('redirect-btb', True, True)\nbuild('committed-btb', False, True)\nbuild('redirect-btb-live', True, False)\nPY\npython3 \\\"\"'$TMPDIR/predictor-profile/redirect_btb.py\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
