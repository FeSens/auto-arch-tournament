tal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n@cocotb.test()\nasync def target_replay_checks_full_tag(dut):\n    a, b = 0x40, 0x240  # Same replay index, different tags.\n    program = {\n        0: JAL(0, a),\n        a: ADDI(1, 0, 7),\n        a + 4: JAL(0, (b - 4) - (a + 4)),\n        b - 4: NOP(),\n        b: ADDI(1, 0, 19),\n        b + 4: EBREAK(),\n    }\n\n    fetches = []\n    rets, _ = await _run(dut, program, imem_stalls={b: 2}, fetches=fetches)\n    _check_retirements(rets, [0, a, a + 4, b - 4, b, b + 4])\n    assert rets[-2][\"rd_wdata\"] == 19\n    assert [f for f in fetches if f[0] == b] == [(b, False, True)] * 2 + [(b, True, True)]\n\n\n@cocotb.test()\nasync def target_replay_masks_same_index_read_and_fill(dut):\n    a, b = 0x40, 0x240\n    program = {\n        0: JAL(0, a),\n        a: JAL(0, b - a),\n        b: ADDI(1, 1, 1),\n        b + 4: ADDI(2, 0, 2),\n        b + 8: BEQ(1, 2, 8),\n        b + 12: JAL(0, a - (b + 12)),\n        b + 16: EBREAK(),\n    }\n    b_requests = 0\n\n    def imem_wait(pc, _dmem):\n        nonlocal b_requests\n        if pc == b:\n            b_requests += 1\n        return pc == b and b_requests in (2, 3)\n\n    fetches = []\n    rets, _ = await _run(dut, program, imem_wait=imem_wait, fetches=fetches)\n    _check_retirements(rets, [0, a, b, b + 4, b + 8, b + 12, a, b, b + 4, b + 8, b + 16])\n    # On the second visit to A, recovery fills A while its trained BTB\n    # entry predicts B. The RAM can return the old B word on collision.\n    start = fetches.index((b, False, True))\n    assert fetches[start - 1:start + 3] == [(a, True, True)] + [(b, False, True)] * 2 + [(b, True, True)]\n\n\n@cocotb.test()\nasync def fence_i_invalidates_replay_and_refetches_younger_word(dut):\n    fence, patched = 0x40, 0x44\n    old_word, new_word = ADDI(5, 0, 7), ADDI(5, 0, 19)\n    program = {\n