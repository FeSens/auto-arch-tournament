{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"cat tools/eval/_slots.py && sed -n '1,125p' cores/bench/test/test_pipeline.py && git status --short --untracked-files=all\"", "aggregated_output": "\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 20-core run host (load 20); formal checks then\nhit their wall-clock ceiling because of what other runs were doing, not\nbecause of the design (V2.1 campaign, first batch). With HARNESS_EVAL_SLOTS\nset, each eval holds one of that many flock'ed slots (in HARNESS_EVAL_LOCK_DIR,\noperator-only) for its duration, and its timeout starts once it holds one.\nUnset (agents' own `make timing`, tests): no limit. The variables use a prefix\nthe agent environment does not inherit (tools/agents/_runtime.py).\"\"\"\nfrom __future__ import annotations\n\nimport contextlib\nimport fcntl\nimport os\nimport time\nfrom pathlib import Path\n\n\n@contextlib.contextmanager\ndef eval_slot(what: str = \"eval\"):\n    n = int(os.environ.get(\"HARNESS_EVAL_SLOTS\", \"0\") or 0)\n    lock_dir = os.environ.get(\"HARNESS_EVAL_LOCK_DIR\", \"\")\n    if n <= 0 or not lock_dir:\n        yield\n        return\n    d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\"\n…[4177 of 7249 chars elided by tools/bench/transcript.py; sha256:2125dc50a07949af]…\ncts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    if callable(program):\n        read_instruction = program\n    else:\n        imem = program if isinstance(program, dict) else {\n            index * 4: instr for index, instr in enumerate(program)\n        }\n\n        def read_instruction(pc, _dmem):\n            return imem.get(pc, EBREAK())\n    dmem = dict(dmem_init or {})\n    imem_stalls = dict(imem_stalls or {})\n    retirements: list[dict] = []\n    held_request = None\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Start with both buses ready. A stall begins when its request appears.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = read_instruction(0, dmem) & 0xFFFFFFFF\n\n    for cycle in range(max_cycles):\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r10-fetch-trials.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tempfile import mkdtemp\n\nfrom tools.eval.gowin import build\nfrom tools.eval.fpga import _bench_sv\n\nworktree = Path.cwd()\nbase = Path(mkdtemp(prefix='bench-r10s0-fetch-', dir=os.environ['TMPDIR']))\nprint(base, flush=True)\nrtl = worktree / 'cores/bench/rtl'\nbenches = _bench_sv(str(worktree), 'bench')\n\ndef scalar_bitmap(s):\n    s = s.replace('  logic [31:0]   replay_slots_read, replay_slots_update, replay_slots_write;',\n                  '  logic [31:0]   replay_slots_update, replay_slots_write;\\\\n  logic          replay_slot_valid;')\n    s = s.replace('  assign replay_slots_read = replay_bitmap_write_q && replay_last_bank_q == replay_read_bank\\\\n                             ? replay_last_slots_q : replay_read_slots_q;', '''  assign replay_slot_valid = replay_bitmap_write_q && replay_last_bank_q == replay_read_bank\n                           ? replay_last_slots_q[normal_pc_q[6:2]]\n                           : replay_read_slots_q[normal_pc_q[6:2]];''')\n    return s.replace('replay_slots_read[normal_pc_q[6:2]]', 'replay_slot_valid')\n\ndef flat_pc(s):\n    s = s.replace('  logic [31:0] ordinary_plus4, ordinary_sequential;\\\\n  logic [31:0] ordinary_base_pc, ordinary_taken_pc, ordinary_not_taken_pc;',\n                  '  logic [31:0] ordinary_plus4;\\\\n  logic ordinary_advance, ordinary_prediction, ordinary_pending, ordinary_keep, ordinary_step;')\n    s = s.replace('  logic        recover_target, recover_fallthrough, use_taken_pc, use_not_taken_pc;', '  logic        recover_target, recover_fallthrough;')\n    s = s.replace('  logic [17:0] ordinary_table_target, ordinary_taken_target;', '  logic [17:0] ordinary_table_target;')\n    s = s.replace('  assign use_taken_pc = \"'!squash_candidate && training_taken;'\"\\\\n  assign use_not_taken_pc = \"'!squash_candidate && !training_taken;'\"\\\\n', '')\n    s = s.replace('  assign ordinary_taken_target = taken_target_bypass ? btb_training.target_word : ordinary_table_target;\\\\n', '')\n    s = s.replace('  assign ordinary_sequential = ordinary_last ? normal_pc_q : ordinary_plus4;\\\\n', '')\n    a = s.index('  assign ordinary_base_pc')\n    b = s.index('  assign ordinary_park', a)\n    s = s[:a] + '''  assign predict_taken = training_taken ? predict_on_taken : predict_on_not_taken;\n  assign ordinary_advance = \"'!reset && !squash_candidate && ordinary_accept;\n  assign ordinary_pending = ordinary_advance && training_taken && predict_on_taken && taken_target_bypass;\n  assign ordinary_prediction = ordinary_advance && ((training_taken && predict_on_taken && !taken_target_bypass)\n                                                    || (!training_taken && predict_on_not_taken));\n  assign ordinary_step = ordinary_advance && !predict_taken && !ordinary_last;\n  assign ordinary_keep = !reset && !squash_candidate && (!ordinary_accept || (ordinary_last && !predict_taken));\n'\"''' + s[b:]\n    a = s.index('  assign normal_pc_d =')\n    b = s.index('  always_ff', a)\n    return s[:a] + '''  assign normal_pc_d = ({32{ordinary_keep}} & normal_pc_q)\n                     | ({32{ordinary_step}} & ordinary_plus4)\n                     | ({32{ordinary_prediction}} & {12'b0, ordinary_table_target, 2'b00})\n                     | ({32{ordinary_pending}} & {12'b0, btb_training.target_word, 2'b00})\n                     | ({32{\"'!reset && recover_target}} & target_pc_d)\n                     | ({32{!reset && recover_fallthrough}} & fallthrough_pc_d);\n'\"''' + s[b:]\n\ndef offset_pc(s):\n    s = s.replace('  logic [31:0] ordinary_base_pc, ordinary_taken_pc, ordinary_not_taken_pc;',\n                  '  logic [31:0] ordinary_taken_pc, ordinary_not_taken_pc;\\\\n  logic [31:0] ordinary_predicted_pc;\\\\n  logic ordinary_move, ordinary_hold;')\n    s = s.replace('  logic        recover_target, recover_fallthrough, use_taken_pc, use_not_taken_pc;', '  logic        recover_target, recover_fallthrough;')\n    s = s.replace('  assign use_taken_pc = \"'!squash_candidate && training_taken;'\"\\\\n  assign use_not_taken_pc = \"'!squash_candidate && !training_taken;'\"\\\\n', '')\n    a = s.index('  assign ordinary_base_pc')\n    b = s.index('  assign predict_taken', a)\n    s = s[:a] + '''  assign ordinary_taken_pc = predict_on_taken\n                           ? {12'b0, ordinary_taken_target, 2'b00} : ordinary_sequential;\n  assign ordinary_not_taken_pc = predict_on_not_taken\n                               ? {12'b0, ordinary_table_target, 2'b00} : ordinary_sequential;\n  assign ordinary_predicted_pc = training_taken ? ordinary_taken_pc : ordinary_not_taken_pc;\n  assign ordinary_move = \"'!reset && !squash_candidate && ordinary_accept;\n  assign ordinary_hold = !reset && !squash_candidate && !ordinary_accept;\n'\"''' + s[b:]\n    s = s.replace('({32{\"'!reset && use_taken_pc}} & ordinary_taken_pc)'\"\\\\n                     | ({32{\"'!reset && use_not_taken_pc}} & ordinary_not_taken_pc)'\"',\n                  '({32{ordinary_move}} & ordinary_predicted_pc)\\\\n                     | ({32{ordinary_hold}} & normal_pc_q)')\n    return s\n\ndef asynchronous_bits(s):\n    a = s.index('  logic [31:0]   replay_bank_valid_q;')\n    b = s.index('  logic [39:0]   replay_entry', a)\n    s = s[:a] + '''  logic [31:0]   replay_valid_bits [0:31];\n  logic [31:0]   replay_read_banks;\n  logic          replay_valid_bit;\n''' + s[b:]\n    a = s.index('  assign replay_read_bank')\n    b = s.index('  // Refresh', a)\n    s = s[:a] + '''  for (genvar bank = 0; bank < 32; bank++) begin : valid_banks\n    for (genvar row = 0; row < 32; row++) begin : valid_rows\n      always_ff @(posedge clock) begin\n        if (reset || fetch_resolution.refetch)\n          replay_valid_bits[bank][row] <= 1'b0;\n        else if (replay_fill && pc[11:2] == 10'(bank * 32 + row))\n          replay_valid_bits[bank][row] <= 1'b1;\n      end\n    end\n    assign replay_read_banks[bank] = normal_pc_q[11:7] == 5'(bank)\n                                  && replay_valid_bits[bank][normal_pc_q[6:2]];\n  end\n  assign replay_valid_bit = |replay_read_banks;\n  assign replay_hit = replay_armed_q && ordinary_in_range && replay_valid_bit\n                   && replay_tag == normal_pc_q[19:12] && \"'!replay_collision;\n'\"''' + s[b:]\n    a = s.index('    // The bitmap reads')\n    b = s.index('  always_ff @(posedge clock) begin\\\\n    if (reset || fetch_resolution.refetch)\\\\n      replay_armed_q', a)\n    return s[:a] + '  end\\\\n\\\\n' + s[b:]\n\ncases = {\n    'scalar': scalar_bitmap,\n    'flat': flat_pc,\n    'scalar-flat': lambda s: flat_pc(scalar_bitmap(s)),\n    'late-accept': lambda s: offset_pc(scalar_bitmap(s)),\n    'async-bits': asynchronous_bits,\n}\nfor name, transform in cases.items():\n    copytree(rtl, base / name / 'rtl')\n    variant = base / name / 'rtl/if_stage.sv'\n    variant.write_text(transform(variant.read_text()))\n\nwith concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:\n    futures = {\n        pool.submit(build, worktree, base / name / 'rtl', benches, p, base / name / f'gowin_p{p}'): (name, p)\n        for name in cases for p in (0, 1, 2)\n    }\n    for f in concurrent.futures.as_completed(futures):\n        r = f.result()\n        print(*futures[f], r.get('fmax_mhz'), r.get('regs'), r.get('logic'), r.get('reason'),\n              [(p['from'], p['to'], p['logic_cells']) for p in r.get('critical_paths', [])[:3]], flush=True)\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-fetch-trials.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
