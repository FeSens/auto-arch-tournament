{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c 'cat > \"$TMPDIR/bench-r5s2-directed.py\" <<'\"'PY'\n\n@cocotb.test()\nasync def missed_jump_immediately_followed_by_divide(dut):\n    program = [JAL(1, 8), DIVU(5, 0, 0), DIVU(2, 1, 1), EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=40)\n    _check_retirements(rets, [0, 8, 12])\n    jump, divide, _ = rets\n    assert divide[\\\"cycle\\\"] - jump[\\\"cycle\\\"] == 10\n    assert (divide[\\\"rs1_rdata\\\"], divide[\\\"rs2_rdata\\\"], divide[\\\"rd_wdata\\\"]) == (4, 4, 1)\n\n\n@cocotb.test()\nasync def stale_taken_load_redirects_during_its_own_stall(dut):\n    program = {\n        4: DIVU(4, 3, 3),\n        8: SW(4, 0, 0x44),\n        12: EBREAK(),\n        0x14: SW(3, 0, 0x40),\n        0x18: JAL(0, -0x18),\n    }\n\n    def read_instruction(pc, dmem):\n        if pc == 0:\n            return LW(3, 0, 0x40) if 0x40 in dmem else JAL(0, 0x10)\n        if pc == 0x10:\n            return DIVU(9, 0, 3) if 0x40 in dmem else ADDI(3, 0, 7)\n        return program.get(pc, EBREAK())\n\n    reads, writes, fetches = [], [], []\n    rets, _ = await _run(dut, read_instruction, load_stall_cycles=5,\n                         stall_imem_with_mem=True, reads=reads, writes=writes, fetches=fetches)\n    _check_retirements(rets, [0, 0x10, 0x14, 0x18, 0, 4, 8, 12])\n    assert [(r[\\\"rd\\\"], r[\\\"rd_wdata\\\"]) for r in rets[4:6]] == [(3, 7), (4, 1)]\n    assert reads == [0x40]\n    assert writes == [(0x40, 0xF, 7), (0x44, 0xF, 1)]\n    assert fetches.count((4, False, False)) == 5\n\n\n@cocotb.test()\nasync def recovery_from_last_ram_word(dut):\n    last_word = 0x000FFFFC\n    program = {0: JAL(0, last_word), 4: EBREAK(), last_word: JAL(0, 4 - last_word)}\n    fetches = []\n    rets, _ = await _run(dut, program, fetches=fetches)\n    _check_retirements(rets, [0, last_word, 4])\n    assert all(0 <= pc <= last_word for pc, _, _ in fetches)\nPY\ndate '+%T %z'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
