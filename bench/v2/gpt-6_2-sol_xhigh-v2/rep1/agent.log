{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c 'pair_dir=$(mktemp -d \"$TMPDIR/bench-r15s0-pairs.XXXXXX\")\nmkdir -p \"$pair_dir/cores/bench\"\ncp -r Makefile bench fpga test tools \"$pair_dir\"\ncp -r cores/bench/rtl cores/bench/core.yaml cores/bench/test \"$pair_dir/cores/bench\"\npython3 - \"$pair_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1]) / 'cores/bench/rtl'\nfor name in ['core_pkg.sv', 'core.sv', 'ex_stage.sv']:\n    path = rtl / name\n    text = path.read_text()\n    if name == 'core_pkg.sv':\n        for signal in ['other_result', 'div_result']:\n            text = text.replace(f'    logic [31:0] {signal};\\\\n', '')\n        text = text.replace('logic [31:0] mul_result;', 'logic [31:0] mul_other_result;')\n        text = text.replace('logic [31:0] shift_result;', 'logic [31:0] shift_div_result;')\n    elif name == 'core.sv':\n        text = text.replace('''ex_mem_w.other_result | ex_mem_w.add_result | ex_mem_w.shift_result\n                       | ex_mem_w.div_result | ex_mem_w.mul_result''',\n                            '''ex_mem_w.add_result | ex_mem_w.shift_div_result\n                       | ex_mem_w.mul_other_result''')\n    else:\n        lines = text.splitlines(keepends=True)\n        text = ''.join(line for line in lines if\n                       'reg_q.other_result' not in line and 'reg_q.div_result' not in line)\n        text = text.replace('reg_q.shift_result   <= {32{result_sel.shift}} & shift_result;',\n                            '''reg_q.shift_div_result <= ({32{result_sel.shift}} & shift_result)\n                              | ({32{result_sel.div}} & div_result);''')\n        text = text.replace('reg_q.mul_result     <= {32{result_sel.mul}} & mul_result;',\n                            '''reg_q.mul_other_result <= ({32{result_sel.mul}} & mul_result)\n                              | ({32{result_sel.other}} & (in.ctrl.is_jump ? in.pc_plus4 : other_result));''')\n    path.write_text(text)\nPY\nprintf '%s\\\\n' \\\"\"'$pair_dir\"\ncd \"$pair_dir\" && make lint TARGET=bench'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
