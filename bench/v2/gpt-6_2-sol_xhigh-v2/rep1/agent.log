ay_word <= replay_entry[normal_pc_d[{n}:2]];')\n        s = s.replace(f\\\"\\\"\\\"    if (replay_fill)\n      replay_entry[pc[{n}:2]] <= {{pc[19:{n+1}], imem_data}};\\\"\\\"\\\",\n                      f\\\"\\\"\\\"    if (replay_fill) begin\n      replay_entry[pc[{n}:2]] <= imem_data;\n      sector_tag[fetch_sector] <= pc[19:{n+1}];\n      sector_slots[fetch_sector] <= old_slots | new_slot;\n    end\\\"\\\"\\\")\n        s = s.replace('replay_valid_q <=', 'sector_allocated_q <=')\n        s = s.replace(f'replay_valid_q[pc[{n}:2]]', 'sector_allocated_q[fetch_sector]')\n        path.write_text(s)\nPY\nfor name in sector4sticky512 sector4sticky1024 sector4recovsticky512 sector8sticky512; do\n  bash \\\"\"'$trial_dir/sim.sh\" \"$trial_dir\" \"$name\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
