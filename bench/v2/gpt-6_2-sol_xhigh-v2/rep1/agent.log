{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r6s0_retime.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport os\nimport sys\n\nvariant = sys.argv[1]\nr = Path(os.environ[\\\"TMPDIR\\\"]) / (\\\"r6s0-\\\" + variant)\nshutil.copytree(\\\"cores/bench/rtl\\\", r / \\\"rtl\\\", dirs_exist_ok=True)\ndef edit(name, fn):\n    path = r / \\\"rtl\\\" / (name + \\\".sv\\\")\n    path.write_text(fn(path.read_text()))\n\nif \\\"btb\\\" in variant:\n    def ex_stage(s):\n        old=s[s.index(\\\"  logic train;\\\"):s.index(\\\"  // Resolve the two matches\\\")]\n        s=s.replace(old, \\\"\\\"\\\"  logic train, target_in_range;\n  logic train_q, target_range_q, misalign_fault_q, branch_hit_q;\n  logic [1:0] counter_up, counter_down;\n  logic [1:0] counter_up_q, counter_down_q;\n  logic branch_cond_q;\n  logic [17:0] train_pc_q;\n\n  assign train = \"'!reset && advance && !in.ctrl.is_illegal\n                 && in.pc[31:20] == 12'\"'b0 && in.pc[1:0] == 2'b00;\n  assign target_in_range = target[31:20] == 12'b0;\n  assign counter_up = in.ctrl.is_jump ? 2'b11\n                    : \"'!in.btb_hit ? 2'\"'b10\n                    : in.btb_counter == 2'b11 ? 2'b11 : in.btb_counter + 2'd1;\n  assign counter_down = \"'!in.btb_hit ? 2'\"'b10\n                      : in.btb_counter == 2'b00 ? 2'b00 : in.btb_counter - 2'd1;\n  always_ff @(posedge clock) begin\n    train_q          <= train;\n    target_range_q   <= target_in_range;\n    misalign_fault_q <= misalign_fault;\n    branch_hit_q     <= in.ctrl.is_branch && in.btb_hit;\n    train_pc_q       <= in.pc[19:2];\n    counter_up_q     <= counter_up;\n    counter_down_q   <= counter_down;\n    branch_cond_q    <= in.ctrl.is_jump || branch_cond;\n  end\n  assign btb_update.pc_word = train_pc_q;\n  assign btb_update.target_word = fetch_resolution.target[19:2];\n  assign btb_update.write_target = train_q && fetch_resolution.take_target && target_range_q;\n  assign btb_update.write_counter = btb_update.write_target\n                                  || (train_q && branch_hit_q && \"'!misalign_fault_q);\n  assign btb_update.counter = branch_cond_q ? counter_up_q : counter_down_q;\n\n\"\"\")\n        return s.replace(\"'\"\\\\n    if (reset) btb_update <= '0;\\\\n    else       btb_update <= next_btb_update;\\\",\\\"\\\")\n    edit(\\\"ex_stage\\\",ex_stage)\n\nif \\\"split\\\" in variant:\n    def pkg(s):\n        return s.replace(\\\"    logic [31:0] alu_result;\\\", \\\"\\\"\\\"    logic [31:0] alu_result;\n    logic [31:0] shift_result;\n    logic        shift_select;\\\"\\\"\\\")\n    edit(\\\"core_pkg\\\",pkg)\n    def alu(s):\n        s=s.replace(\\\"  parameter bit SPLIT_MULTIPLY = 1'b0\\\", \\\"  parameter bit SPLIT_MULTIPLY = 1'b0,\\\\n  parameter bit SPLIT_SHIFT = 1'b0\\\")\n        s=s.replace(\\\"  output logic        mul_select\\\", \\\"\\\"\\\"  output logic        mul_select,\n  output logic [31:0] shift_result,\n  output logic        shift_select\\\"\\\"\\\")\n        s=s.replace(\\\"  always_comb begin\\\\n    shamt = b[4:0];\\\", \\\"\\\"\\\"  assign shamt = b[4:0];\n  assign shift_select = op == ALU_SLL || op == ALU_SRL || op == ALU_SRA;\n\n  always_comb begin\n    case (op)\n      ALU_SLL: shift_result = a << shamt;\n      ALU_SRL: shift_result = a >> shamt;\n      ALU_SRA: shift_result = \"'$unsigned($signed(a) >>> shamt);\n      default: shift_result = '\"'0;\n    endcase\n  end\n\n  always_comb begin\\\"\\\"\\\")\n        s=s.replace(\\\"\\\"\\\"      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = \"'$unsigned($signed(a) >>> shamt);\"\"\", \"\"\"      ALU_SLL, ALU_SRL, ALU_SRA: out = SPLIT_SHIFT ? 32'\"'b0 : shift_result;\\\"\\\"\\\")\n        return s\n    edit(\\\"alu\\\",alu)\n    def ex(s):\n        s=s.replace(\\\"logic [31:0] alu_result, mul_result;\\\", \\\"logic [31:0] alu_result, mul_result, shift_result;\\\\n  logic shift_select;\\\")\n        s=s.replace(\\\"alu #(.SPLIT_MULTIPLY(1'b1))\\\", \\\"alu #(.SPLIT_MULTIPLY(1'b1), .SPLIT_SHIFT(1'b1))\\\")\n        s=s.replace(\\\".mul_select  (mul_select)\\\", \\\".mul_select  (mul_select),\\\\n    .shift_result(shift_result),\\\\n    .shift_select(shift_select)\\\")\n        s=s.replace(\\\"      reg_q.alu_result    <=\\\", \\\"\\\"\\\"      reg_q.shift_result  <= shift_result;\n      reg_q.shift_select  <= shift_select;\n      reg_q.alu_result    <=\\\"\\\"\\\")\n        return s\n    edit(\\\"ex_stage\\\",ex)\n    def mem(s):\n        return s.replace(\\\"\"'!select_load && !in.mul_select\", \"!select_load && !in.mul_select && !in.shift_select\").replace(\n            \"| ({32{in.mul_select}} & in.mul_result)\", \"| ({32{in.mul_select}} & in.mul_result)'\"\\\\n                        | ({32{in.shift_select}} & in.shift_result)\\\")\n    edit(\\\"mem_stage\\\",mem)\n    def core(s):\n        return s.replace(\\\"  ex_stage u_ex (\\\", \\\"\\\"\\\"  logic [31:0] fwd_alu_result;\n  assign fwd_alu_result = ex_mem_w.shift_select ? ex_mem_w.shift_result : ex_mem_w.alu_result;\n\n  ex_stage u_ex (\\\"\\\"\\\").replace(\\\"(ex_mem_w.alu_result)\\\", \\\"(fwd_alu_result)\\\")\n    edit(\\\"core\\\",core)\nPY\nfor variant in btb btbsplit; do\n  python3 \\\"\"'$TMPDIR/r6s0_retime.py\" \"$variant\"\ndone\npython3 -u - <<'\"'PY'\nimport os\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\ndef run(v):\n scratch = Path(os.environ[\\\"TMPDIR\\\"]) / (\\\"r6s0-\\\" + v)\n res = build_all(Path.cwd(), scratch / \\\"rtl\\\", \\\"fpga/core_bench_si.sv\\\", scratch / \\\"gowin\\\")\n print(v, summarize(res), flush=True)\n for r in res[:2]:\n  print(v, r[\\\"place_option\\\"], r.get(\\\"critical_paths\\\"), flush=True)\nwith ThreadPoolExecutor(2) as ex:\n list(ex.map(run, (\\\"btb\\\", \\\"btbsplit\\\")))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
