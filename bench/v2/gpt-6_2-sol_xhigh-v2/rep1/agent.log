 & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (i\n…[1709 of 4781 chars elided by tools/bench/transcript.py; sha256:91dbb3ae6cda5f21]…\nt=None, reads=None, writes=None, fetches=None,\n):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    A callable program can supply mutable instruction memory as (pc, dmem).\n    Optional backpressure stalls the first load or store. With\n    stall_imem_with_mem, imem stays unready through the request's release\n    cycle. imem_stalls supplies additional unready cycles by fetch PC.\n    imem_wait can request a stall based on the fetch PC and dmem contents.\n    fetches records (PC, imem ready, dmem ready). Accepted reads append\n    their address and accepted writes append (address, mask, data).\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    if callable(program):\n        read_instruction = program\n    else:\n        imem = program if isinstance(program, dict) else {\n            index * 4: instr for index, instr in enumerate(program)\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nfrom pathlib import Path\nimport shutil\n\nroot = Path(os.environ['TMPDIR']) / 'bench-lane-probe'\nfor name in ('lookahead-shared', 'lookahead-shared-lite'):\n    out = root / name\n    shutil.copytree(root / 'lookahead-ce', out)\n    path = out / 'if_stage.sv'\n    source = path.read_text()\n    source = source.replace('replay_retry, replay_ordinary, replay_hold_response_q', 'replay_retry, replay_hold_response_q')\n    start = source.index('  assign replay_ordinary')\n    stop = source.index('  always_ff @(posedge clock)', start)\n    index_select = '  assign replay_lookup_index = replay_retry ? normal_pc_q[11:2] : normal_pc_d[11:2];\\\\n\\\\n'\n    if name.endswith('-lite'):\n        # Retry a colliding RAM read whenever the current imem response\n        # cannot be used. The retry stays separate from availability.\n        index_select = index_select.replace('replay_retry ?', 'replay_retry ?')\n        source = source.replace('(\"'!imem_ready || !ordinary_can_accept)'\"', '(\"'!imem_ready || hold_id)'\"')\n        start = source.index('  assign replay_ordinary')\n        stop = source.index('  always_ff @(posedge clock)', start)\n    source = source[:start] + index_select + source[stop:]\n    path.write_text(source)\nPY\npython3 \\\"\"'$TMPDIR/bench-lane-probe/time.py\" lookahead-shared,1 lookahead-shared-lite,1 lookahead-ce,0 lookahead-ce,2'","aggregated_output":"lookahead-ce 0 74.415 4236 [{'from': 'cpu/u_ex/u_alu/partial_q_30_s1', 'to': 'cpu/u_ex/reg_q.div_result_27_s0', 'slack_ns': -8.438, 'arrival_ns': 18.732, 'logic_cells': 45, 'modules': ['clock_ibuf', 'cpu/u_ex/u_alu']}, {'from': 'cpu/u_ex/u_alu/partial_q_30_s1', 'to': 'cpu/u_ex/reg_q.div_result_28_s0', 'slack_ns': -8.438, 'arrival_ns': 18.732, 'logic_cells': 45, 'modules': ['clock_ibuf', 'cpu/u_ex/u_alu']}]\nlookahead-shared 1 78.567 4302 [{'from': 'cpu/u_ex/u_alu/partial_q_3