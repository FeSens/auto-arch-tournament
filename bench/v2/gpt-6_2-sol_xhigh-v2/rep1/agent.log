{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c 'trial_dir=\"$TMPDIR/r8s2.xOg3NS\"\npython - \"$trial_dir\" <<'\"'PY'\nimport shutil\nimport sys\nfrom pathlib import Path\n\nroot = Path(sys.argv[1])\nfor source in ('128', 'sticky512', 'sticky1024', 'page512'):\n    name = 'recov' + source\n    rtl = root / name / 'rtl'\n    shutil.copytree(root / source / 'rtl', rtl)\n    path = rtl / 'if_stage.sv'\n    s = path.read_text()\n    s = s.replace('  logic [31:0] pc_plus4, predicted_pc;', '  logic [31:0] pc_plus4, predicted_pc, normal_plus4, corrected_next_pc;')\n    s = s.replace('  logic        table_hit;', '  logic        table_hit, normal_in_range, normal_predict_taken, normal_park;')\n    s = s.replace('  assign fetch_index = pc[6:2];', '  assign fetch_index = normal_pc_q[6:2];')\n    s = s.replace('fetch_tag == pc[19:7]', 'fetch_tag == normal_pc_q[19:7]')\n    s = s.replace('  assign hit = fetch_in_range && (bypass_target ? write_tag == pc[19:7] : table_hit);',\n        \\\"\\\"\\\"  assign normal_in_range = normal_pc_q[31:20] == 12'b0 && normal_pc_q[1:0] == 2'b00;\n  assign hit = normal_in_range && (bypass_target ? write_tag == normal_pc_q[19:7] : table_hit);\\\"\\\"\\\")\n    i = s.index('  assign pc_plus4')\n    j = s.index('\\\\n  assign fetch_ready', i)\n    s = s[:i] + \\\"\\\"\\\"  assign pc_plus4 = pc + 32'd4;\n  assign normal_plus4 = normal_pc_q + 32'd4;\n  assign normal_predict_taken = hit && counter[1];\n  assign predict_taken = \"'!squash_candidate && normal_predict_taken;\n  assign normal_park = !normal_predict_taken && normal_pc_q == 32'\"'h000f_fffc;\n  assign park_fallthrough = squash_candidate ? pc == 32'h000f_fffc : normal_park;\n  assign corrected_next_pc = pc == 32'h000f_fffc ? pc : pc_plus4;\n  assign predicted_pc = normal_predict_taken ? {12'b0, predicted_target, 2'b00}\n                                             : normal_park ? normal_pc_q : normal_plus4;\n\\\"\\\"\\\" + s[j:]\n    s = s.replace(\\\"  assign normal_pc_d = reset ? '0 : advance_fetch ? predicted_pc : pc;\\\", \\\"\\\"\\\"  assign normal_pc_d = reset ? '0\n                     : squash_candidate ? (advance_fetch ? corrected_next_pc : pc)\n                     : advance_fetch ? predicted_pc : normal_pc_q;\\\"\\\"\\\")\n    s = s.replace('out.btb_hit     = hit;', 'out.btb_hit     = \"'!squash_candidate && hit;'\"')\n    path.write_text(s)\nPY\nfor name in recov128 recovsticky512 recovsticky1024 recovpage512; do\n  bash \\\"\"'$trial_dir/sim.sh\" \"$trial_dir\" \"$name\" &\ndone\nwait'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
