{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/predictor-profile/stage_jalr.py\" <<'\"'PY'\nfrom pathlib import Path\nimport os, shutil\nwork = Path(os.environ['TMPDIR']) / 'predictor-profile'\nsrc = Path('cores/bench/rtl')\nrtl = work / 'staged-rtl'\nshutil.copytree(src, rtl, dirs_exist_ok=True)\ndef edit(file, *changes):\n    p = rtl / file\n    s = p.read_text()\n    for old, new in changes:\n        assert s.count(old) == 1, (file, old, s.count(old))\n        s = s.replace(old, new)\n    p.write_text(s)\n\nedit('core_pkg.sv', ('    logic       is_jalr;', '    logic       is_jalr;\\\\n    logic       jalr_zero_imm;'))\nedit('id_stage.sv', ('    ctrl_decoded.is_jalr    = dec_is_jalr;', '''    ctrl_decoded.is_jalr    = dec_is_jalr;\n    ctrl_decoded.jalr_zero_imm = in.instr[31:20] == 12'b0;'''))\nedit('core.sv', ('  logic        div_wait, load_replay, replay_consumer;', '  logic        div_wait, jalr_wait, load_replay, replay_consumer;'),\n     ('    .div_wait         (div_wait),', '    .div_wait         (div_wait),\\\\n    .jalr_wait        (jalr_wait),'),\n     ('    .div_wait       (div_wait),','    .div_wait       (div_wait || jalr_wait),'))\nedit('ex_stage.sv',\n     ('  output logic               div_wait,','  output logic               div_wait,\\\\n  output logic               jalr_wait,'),\n     ('  logic [31:0] target, jalr_sum, effective_addr;', '''  logic [31:0] target, effective_addr;\n  logic jalr_staged_q, jalr_launch, match_target;\n  ex_mem_t reg_q;'''),\n     ('''  assign jalr_sum = rs1 + in.imm;\n  assign effective_addr = (rs1 | load_address_data) + in.imm;\n  assign target = in.ctrl.is_jalr ? (jalr_sum & 32'hffff_fffe) : in.direct_target;\n  assign target_aligned = target[1:0] == 2'b00;\n  assign ex_ready = in.valid && \"'!squash_candidate && !load_replay && !div_wait;\n  assign advance = ex_ready && !stall;'\"''',\n     '''  assign jalr_wait = in.valid && in.ctrl.is_jalr && \"'!in.ctrl.jalr_zero_imm && !jalr_staged_q;\n  assign jalr_launch = jalr_wait && !stall && !squash_candidate && !load_replay;\n  always_ff @(posedge clock) begin\n    if (reset)\n      jalr_staged_q <= 1'\"'b0;\n    else if (\"'!stall)\n      jalr_staged_q <= jalr_launch;\n  end\n\n  assign effective_addr = (rs1 | load_address_data) + in.imm;\n  wire fast_jalr = in.ctrl.is_jalr && in.ctrl.jalr_zero_imm;\n  wire staged_jalr = in.ctrl.is_jalr && !in.ctrl.jalr_zero_imm;\n  wire [31:0] fast_target = {rs1[31:1], 1'\"'b0};\n  wire [31:0] staged_target = {reg_q.add_result[31:1], 1'b0};\n  assign target = ({32{\"'!in.ctrl.is_jalr}} & in.direct_target)\n                | ({32{fast_jalr}} & fast_target)\n                | ({32{staged_jalr}} & staged_target);\n  assign match_target = !fetch_parked && ((!in.ctrl.is_jalr && (fetch_pc == in.direct_target))\n                    || (fast_jalr && (fetch_pc == fast_target))\n                    || (staged_jalr && (fetch_pc == staged_target)));\n  assign target_aligned = target[1:0] == 2'\"'b00;\n  assign ex_ready = in.valid && \"'!squash_candidate && !load_replay && !div_wait && !jalr_wait;\n  assign advance = ex_ready && !stall;'\"'''),\n     ('      match_target_q      <= \"'!fetch_parked && fetch_pc == target;'\"',\n      '      match_target_q      <= match_target;'),\n     ('  // ── EX/MEM register ───────────────────────────────────────────────────\\\\n  ex_mem_t reg_q;',\n      '  // ── EX/MEM register ───────────────────────────────────────────────────'),\n     ('      reg_q.rs1_val        <= div_consume ? div_rs1_q : live_rs1;',\n      '      reg_q.rs1_val        <= div_consume ? div_rs1_q : jalr_staged_q ? reg_q.rs1_val : live_rs1;'),\n     ('      reg_q.rs2_val        <= div_consume ? div_rs2_q : live_rs2;',\n      '      reg_q.rs2_val        <= div_consume ? div_rs2_q : jalr_staged_q ? reg_q.rs2_val : live_rs2;'))\nPY\npython3 \\\"\"'$TMPDIR/predictor-profile/stage_jalr.py\" && verilator --lint-only --top-module core -Wall -Wno-fatal -Wno-style   \"+incdir+$TMPDIR/predictor-profile/staged-rtl\" \"$TMPDIR/predictor-profile/staged-rtl/core_pkg.sv\"   $(rg --files \"$TMPDIR/predictor-profile/staged-rtl\" -g '\"'*.sv' | sort | rg -v '/core_pkg.sv\"'$'\"')\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
