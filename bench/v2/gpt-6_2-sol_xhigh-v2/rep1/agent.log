{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c 'trial_dir=\"$TMPDIR/bench-structural.ZB8tfqmA\"\ncd \"$trial_dir\"\ncat > scratch-sliced.py <<'\"'PY'\nfrom pathlib import Path\nimport shutil\n\nfor source,name,width in [\n    (\\\"rtl\\\", \\\"rtl-div-sliced8\\\", 8),\n    (\\\"rtl\\\", \\\"rtl-div-sliced6\\\", 6),\n    (\\\"rtl-packed\\\", \\\"rtl-packed-div-sliced8\\\", 8),\n    (\\\"rtl-forced-agu\\\", \\\"rtl-agu-div-sliced8\\\", 8),\n]:\n    shutil.copytree(source,name)\n    alu = Path(name) / \\\"alu.sv\\\"\n    s = alu.read_text()\n    parts = [(i, min(width, 34-i)) for i in range(0, 34, width)]\n    body = [\\\"  function automatic [32:0] trial_sub(input logic [33:0] x, y);\\\"]\n    for i, (offset,width) in enumerate(parts):\n        for j in ([0] if i == len(parts) - 1 else [0,1]):\n            body.append(f\\\"    logic [{width}:0] diff_{i}_{j};\\\")\n        if i < len(parts) - 1:\n            body.append(f\\\"    logic propagate_{i};\\\")\n    body.append(f\\\"    logic [{len(parts)-1}:1] borrow;\\\")\n    body.append(\\\"    begin\\\")\n    for i, (offset,width) in enumerate(parts):\n        x,y = f\\\"x[{offset} +: {width}]\\\", f\\\"y[{offset} +: {width}]\\\"\n        body.append(f\\\"      diff_{i}_0 = {{1'b0, {x}}} - {{1'b0, {y}}};\\\")\n        if i < len(parts) - 1:\n            body.append(f\\\"      diff_{i}_1 = {{1'b0, {x}}} - {{1'b0, {y}}} - {width+1}'d1;\\\")\n            if i:\n                body.append(f\\\"      propagate_{i} = {x} == {y};\\\")\n    for k in range(1,len(parts)):\n        expr = \\\" | \\\".join(\\\"(\\\" + \\\" & \\\".join([f\\\"diff_{j}_0[{parts[j][1]}]\\\"]+[f\\\"propagate_{i}\\\" for i in range(j+1,k)]) + \\\")\\\" for j in range(k))\n        body.append(f\\\"      borrow[{k}] = {expr};\\\")\n    i = len(parts)-1\n    offset,width = parts[i]\n    body.append(f\\\"      trial_sub[32] = diff_{i}_0[{width}] || (borrow[{i}] && x[33:{offset}] == y[33:{offset}]);\\\")\n    for i, (offset,width) in enumerate(parts):\n        width = min(width, 32-offset)\n        if width > 0:\n            if i == len(parts)-1:\n                result = f\\\"diff_{i}_0[{width-1}:0] - {width}'(borrow[{i}])\\\"\n            elif i == 0:\n                result = f\\\"diff_{i}_0[{width-1}:0]\\\"\n            else:\n                result = f\\\"borrow[{i}] ? diff_{i}_1[{width-1}:0] : diff_{i}_0[{width-1}:0]\\\"\n            body.append(f\\\"      trial_sub[{offset} +: {width}] = {result};\\\")\n    body.extend([\\\"    end\\\", \\\"  endfunction\\\", \\\"\\\"])\n    a = s.index(\\\"  function automatic [63:0] radix4_step\\\")\n    b = s.index(\\\"  endfunction\\\", a) + len(\\\"  endfunction\\\")\n    func = s[a:b]\n    func = func.replace(\\\"logic [34:0] shifted\\\", \\\"logic [33:0] shifted\\\").replace(\\\"logic [34:0] trial_one\\\", \\\"logic [32:0] trial_one\\\")\n    func = func.replace(\\\"{1'b0, partial[63:30]}\\\", \\\"partial[63:30]\\\")\n    func = func.replace(\\\"shifted - {3'b0, divisor}\\\", \\\"trial_sub(shifted, {2'b0, divisor})\\\").replace(\\\"shifted - {2'b0, divisor, 1'b0}\\\", \\\"trial_sub(shifted, {1'b0, divisor, 1'b0})\\\").replace(\\\"shifted - {1'b0, triple_divisor}\\\", \\\"trial_sub(shifted, triple_divisor)\\\")\n    func = func.replace(\\\"[34]\\\", \\\"[32]\\\")\n    s = s[:a] + \\\"\\\\n\\\".join(body) + \\\"\\\\n\\\" + func + s[b:]\n    alu.write_text(s)\nPY\npython3 scratch-sliced.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
