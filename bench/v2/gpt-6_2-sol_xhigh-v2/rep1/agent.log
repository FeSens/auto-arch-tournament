{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c 'scratch=/srv/hwebench/tmp/7cb5c576/335030a4/predictor.awlJ62Gn\npython3 - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nimport shutil\n\nscratch = Path(sys.argv[1])\noriginal = Path('cores/bench/rtl')\nfor variant, template in (('keptbtb32','baseclean'), ('keptbtb64','candidate64'),\n                          ('keptdirect64','direct64')):\n    dest = scratch / variant\n    shutil.copytree(original, dest)\n    p = dest / 'core_pkg.sv'\n    s = p.read_text().replace('    logic        take_target;\\\\n', '    logic        take_target;\\\\n    logic        fence_i;\\\\n')\n    s = s.replace('    logic       is_auipc;', '    logic       is_auipc;\\\\n    logic       is_fence_i;')\n    p.write_text(s)\n\n    p = dest / 'ex_stage.sv'\n    s = p.read_text()\n    s = s.replace('  input  logic [31:0]        fetch_pc,','  input  logic [31:0]        fetch_pc,\\\\n  input  logic               successor_valid,')\n    s = s.replace('<= fetch_pc == target;', '<= successor_valid && fetch_pc == target;')\n    s = s.replace('<= fetch_pc == in.pc_plus4;', '<= successor_valid && \"'!in.ctrl.is_fence_i && fetch_pc == in.pc_plus4;'\"')\n    s = s.replace('    fetch_resolution.valid             <= \"'!reset && advance;'\"', '    fetch_resolution.valid             <= \"'!reset && advance;'\"\\\\n    fetch_resolution.fence_i           <= \"'!reset && advance && in.ctrl.is_fence_i;'\"')\n    p.write_text(s)\n\n    p = dest / 'id_stage.sv'\n    s = p.read_text().replace('    ctrl_decoded.is_auipc   = dec_is_auipc;',\n         \\\"    ctrl_decoded.is_auipc   = dec_is_auipc;\\\\n    ctrl_decoded.is_fence_i = in.instr[6:0] == 7'b0001111 && in.instr[14:12] == 3'b001;\\\")\n    p.write_text(s)\n\n    p = dest / 'core.sv'\n    s = (scratch / template / 'core.sv').read_text()\n    s = s.replace('    .squash_candidate (squash_candidate),\\\\n    .in', '    .squash_candidate (squash