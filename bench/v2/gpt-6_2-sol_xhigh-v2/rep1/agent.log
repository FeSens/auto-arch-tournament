rt not any(r[\"trap\"] for r in rets)\n    assert rets[2][\"rs1_rdata\"] == 1  # held MEM/WB forwarding value\n    assert writes == [(0x40, 0xF, 1), (0x48, 0xF, 1)]\n    assert dmem == {0x40: 1, 0x48: 1}\n    start = fetches.index((12, False, False))\n    assert fetches[start:start + stall_cycles + 2] == (\n        [(12, False, False)] * stall_cycles + [(12, False, True), (16, True, True)]\n    )\n\n\n@cocotb.test()\nasync def \n…[13701 of 16773 chars elided by tools/bench/transcript.py; sha256:ca965e090835064e]…\nseline filenames; CLAUDE.md grants hypotheses the\n# right to add new modules, split a stage into multiple files, or rename\n# files in rtl/. Hardcoding silently fails on those restructurings (or\n# elaborates a stale ghost). Strip the original [verilog-files] section\n# and rebuild from the glob, with core_pkg.sv first and wrapper.sv last.\nSTAGED_CFG=\"$CORE_DIR/checks.cfg\"\nawk '/^\\[verilog-files\\]/{exit} {print}' \"$CHECKS_CFG\" > \"$STAGED_CFG\"\n{\n    echo \"[verilog-files]\"\n    [ -f \"$CORE_DIR/core_pkg.sv\" ] && \\\n        echo \"@basedir@/cores/@core@/core_pkg.sv\"\n    for f in \"$CORE_DIR\"/*.sv; do\n        name=\"$(basename \"$f\")\"\n        [ \"$name\" = \"core_pkg.sv\" ] && continue\n        [ \"$name\" = \"wrapper.sv\" ] && continue\n        echo \"@basedir@/cores/@core@/$name\"\n48:def run_one(elf: Path, sim_bin: str, worktree: str, env: dict | None = None,\n70:def run_coremark_crc(coremark_elf: Path, sim_bin: str, worktree: str, env: dict | None = None) -> dict:\n125:def run_cosim(worktree: str, target: str | None = None) -> dict:\n", "exit_code": 0, "status": "completed"}}
