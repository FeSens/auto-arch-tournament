{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -c 'scratch=/srv/hwebench/tmp/7cb5c576/335030a4/predictor.awlJ62Gn\nmkdir -p \"$scratch/directed\"\nln -s \"$scratch/two16\" \"$scratch/directed/rtl\"\ncp -r cores/bench/test \"$scratch/directed/test\"\npython3 - \"$scratch/directed/test/test_pipeline.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\np = Path(sys.argv[1])\ns = p.read_text().replace('    reads=None, writes=None, fetches=None,', '    reads=None, writes=None, fetches=None, imem_policy=None,')\ns = s.replace('        dut.io_imemReady.value = int(imem_ready)',\n              '        if imem_policy is not None and imem_ready:\\\\n'\n              '            imem_ready = imem_policy(cycle, ia)\\\\n'\n              '        dut.io_imemReady.value = int(imem_ready)')\ns += '''\n\n@cocotb.test()\nasync def two_word_replay_across_two_unready_cycles(dut):\n    program = {\n        0x00: ADDI(1, 0, 4),\n        0x04: JAL(0, 0x40 - 0x04),\n        0x40: ADDI(2, 2, 7),\n        0x44: ADDI(3, 3, 11),\n        0x48: ADDI(1, 1, -1),\n        0x4c: BNE(1, 0, -12),\n        0x50: EBREAK(),\n    }\n    saw_branch = 0\n    stalls = 0\n    def imem_policy(cycle, address):\n        nonlocal saw_branch, stalls\n        if address == 0x4c:\n            saw_branch += 1\n        if saw_branch == 3 and address == 0x48 and stalls < 2:\n            stalls += 1\n            return False\n        return True\n\n    trace, _ = await _run(dut, program, imem_policy=imem_policy)\n    _check_retirements(trace, [0, 4] + [0x40, 0x44, 0x48, 0x4c] * 4 + [0x50])\n    assert stalls == 2\n    assert trace[-4][\\\"cycle\\\"] == trace[-5][\\\"cycle\\\"] + 1\n    assert trace[-5][\\\"cycle\\\"] == trace[-6][\\\"cycle\\\"] + 1\n    assert trace[-4][\\\"rd_wdata\\\"] == 44\n\n\n@cocotb.test()\nasync def fence_i_refetches_both_cached_words(dut):\n    program = {\n        0x00: ADDI(1, 0, 4),\n        0x04: JAL(0, 0x40 - 0x04),\n        0x48: ADDI(1, 1, -1),\n        0x4c: BNE(1, 0, -12),\n        0x50: BNE(4, 0, 0x18),\n        0x54: ADDI(4, 0, 1),\n        0x58: SW(2, 0, 0x80),\n        0x5c: 0x0000100f,\n        0x60: ADDI(1, 0, 1),\n        0x64: JAL(0, 0x04 - 0x64),\n        0x68: EBREAK(),\n    }\n    def read_instruction(pc, dmem):\n        if pc == 0x40:\n            return ADDI(2, 2, 37 if 0x80 in dmem else 7)\n        if pc == 0x44:\n            return ADDI(3, 3, 23 if 0x80 in dmem else 11)\n        return program.get(pc, EBREAK())\n\n    trace, _ = await _run(dut, read_instruction, store_stall_cycles=3,\n                          stall_imem_with_mem=True)\n    _check_retirements(trace, [0, 4] + [0x40, 0x44, 0x48, 0x4c] * 4\n                       + [0x50, 0x54, 0x58, 0x5c, 0x60, 0x64, 4,\n                          0x40, 0x44, 0x48, 0x4c, 0x50, 0x68])\n    assert [r[\\\"rd_wdata\\\"] for r in trace if r[\\\"pc\\\"] == 0x40] == [7, 14, 21, 28, 65]\n    assert [r[\\\"rd_wdata\\\"] for r in trace if r[\\\"pc\\\"] == 0x44] == [11, 22, 33, 44, 67]\n'''\np.write_text(s)\nPY\npytest -q \\\"\"'$scratch/directed/test\" > \"$scratch/cocotb.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
