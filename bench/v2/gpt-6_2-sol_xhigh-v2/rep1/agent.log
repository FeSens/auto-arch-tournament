{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r10-fetch-select.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\n\nscratch = Path(os.environ['TMPDIR'])\ncode = (scratch / 'bench-r10-fetch-trials.py').read_text()\nexec(code[:code.index('cases = {')])\n\ndef shared_target(s):\n    s = flat_pc(scalar_bitmap(s))\n    s = s.replace('ordinary_prediction, ordinary_pending, ordinary_keep, ordinary_step;', 'ordinary_prediction, ordinary_keep, ordinary_step;\\\\n  logic [17:0] ordinary_prediction_target;')\n    a = s.index('  assign ordinary_pending')\n    b = s.index('  assign ordinary_step', a)\n    s = s[:a] + '''  assign ordinary_prediction = ordinary_advance && predict_taken;\n  assign ordinary_prediction_target = training_taken && taken_target_bypass\n                                    ? btb_training.target_word : ordinary_table_target;\n''' + s[b:]\n    return s.replace('({32{ordinary_prediction}} & {12\\\\'b0, ordinary_table_target, 2\\\\'b00})\\\\n                     | ({32{ordinary_pending}} & {12\\\\'b0, btb_training.target_word, 2\\\\'b00})',\n                     '({32{ordinary_prediction}} & {12\\\\'b0, ordinary_prediction_target, 2\\\\'b00})')\n\ndef flat_redirect(s):\n    s = flat_pc(scalar_bitmap(s))\n    s = s.replace('corrected_plus4, target_pc_d, fallthrough_pc_d;', '''corrected_plus4;\n  logic target_keep, target_step, fallthrough_keep, fallthrough_step;''')\n    s = s.replace('  assign target_pc_d = corrected_accept && \"'!target_last ? target_plus4 : fetch_resolution.target;'\"\\\\n'\n                  '  assign fallthrough_pc_d = corrected_accept && \"'!fallthrough_last'\"\\\\n'\n                  '                          ? fallthrough_plus4 : fetch_resolution.fallthrough;', '''  assign target_keep = \"'!reset && recover_target && (!corrected_accept || target_last);\n  assign target_step = !reset && recover_target && corrected_accept && !target_last;\n  assign fallthrough_keep = !reset && recover_fallthrough && (!corrected_accept || fallthrough_last);\n  assign fallthrough_step = !reset && recover_fallthrough && corrected_accept && !fallthrough_last;'\"''')\n    a = s.index('  assign normal_pc_d')\n    b = s.index('  always_ff', a)\n    s = s[:a] + s[a:b].replace('({32{\"'!reset && recover_target}} & target_pc_d)'\"\\\\n'\n                              '                     | ({32{\"'!reset && recover_fallthrough}} & fallthrough_pc_d);'\"',\n                              '''({32{target_keep}} & fetch_resolution.target)\n                     | ({32{target_step}} & target_plus4)\n                     | ({32{fallthrough_keep}} & fetch_resolution.fallthrough)\n                     | ({32{fallthrough_step}} & fallthrough_plus4);''') + s[b:]\n    return s\n\ndef merged_control(s):\n    s = flat_pc(scalar_bitmap(s))\n    s = s.replace('  logic ordinary_advance, ordinary_prediction, ordinary_pending, ordinary_keep, ordinary_step;', '''  logic ordinary_allowed, ordinary_advance, ordinary_prediction, ordinary_pending, ordinary_keep, ordinary_step;\n  logic pending_predicted, table_predicted, sequential_pc;''')\n    a = s.index('  assign ordinary_advance')\n    b = s.index('  assign ordinary_park', a)\n    return s[:a] + '''  assign ordinary_allowed = \"'!reset && !squash_candidate;\n  assign pending_predicted = training_taken && predict_on_taken && taken_target_bypass;\n  assign table_predicted = training_taken ? predict_on_taken && !taken_target_bypass : predict_on_not_taken;\n  assign sequential_pc = !pending_predicted && !table_predicted;\n  assign ordinary_advance = ordinary_allowed && ordinary_accept;\n  assign ordinary_pending = ordinary_advance && pending_predicted;\n  assign ordinary_prediction = ordinary_advance && table_predicted;\n  assign ordinary_step = ordinary_advance && sequential_pc && !ordinary_last;\n  assign ordinary_keep = ordinary_allowed && (!ordinary_accept || (ordinary_last && sequential_pc));\n'\"''' + s[b:]\n\ncases = {'shared-target': shared_target, 'flat-redirect': flat_redirect, 'merged-control': merged_control}\nexec(code[code.index('for name, transform in cases.items():'):])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-fetch-select.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
