{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path(\\\"cores/bench/test/test_pipeline.py\\\")\ns = p.read_text()\ns = s.replace('    stall_imem_with_store=False, writes=None, fetches=None,','    stall_imem_with_store=False, writes=None, fetches=None, load_stalls=None,', 1)\ns = s.replace('    held_store = None\\\\n\\\\n    cocotb.start_soon', '    held_store = None\\\\n    held_load = None\\\\n    load_stalls = dict(load_stalls or {})\\\\n\\\\n    cocotb.start_soon', 1)\ns = s.replace('        dut.io_dmemReady.value = int(not stall_store)\\\\n', '''        load_addr = da if int(dut.io_dmemREn.value) else None\n        if held_load is not None:\n            assert load_addr == held_load\n        stall_load = load_stalls.get(load_addr, 0) > 0\n        if stall_load:\n            held_load = load_addr\n            load_stalls[load_addr] -= 1\n        else:\n            held_load = None\n        dut.io_dmemReady.value = int(not (stall_store or stall_load))\n''', 1)\ns = s.replace('        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\\\\n', '        dut.io_dmemRData.value = 0xBAD0BAD0 if stall_load else dmem.get(da & ~3, 0)\\\\n', 1)\nat = s.index('@cocotb.test()\\\\nasync def divide_waits_for_stalled_store')\ns = s[:at] + '''@cocotb.test()\nasync def ready_byte_load_forwards_both_operands(dut):\n    byte_load = _i(0x21, 0, 0b000, 1, 0b0000011)\n    program = [byte_load, ADD(2, 1, 1), EBREAK()]\n    rets, _ = await _run(dut, program, {0x20: 0x00008000})\n    _check_retirements(rets, [0, 4, 8])\n    load, add, _ = rets\n    assert load[\\\"rd_wdata\\\"] == 0xFFFFFF80\n    assert add[\\\"cycle\\\"] == load[\\\"cycle\\\"] + 1\n    assert add[\\\"rs1_rdata\\\"] == add[\\\"rs2_rdata\\\"] == 0xFFFFFF80\n    assert add[\\\"rd_wdata\\\"] == 0xFFFFFF00\n\n\n@cocotb.test()\nasync def stalled_loads_forward_to_address_and_branch(dut):\n    program = [\n        ADDI(3, 0, 0x55),\n        LW(1, 0, 0x20),\n        LW(2, 1, 0),\n        BEQ(2, 0, 8),\n        SW(3, 0, 0x44),\n        SW(3, 0, 0x48),\n        EBREAK(),\n    ]\n    writes = []\n    rets, dmem = await _run(\n        dut, program, {0x20: 0x40, 0x40: 0},\n        load_stalls={0x20: 3, 0x40: 2}, writes=writes,\n    )\n    _check_retirements(rets, [0, 4, 8, 12, 20, 24])\n    assert rets[2][\\\"rs1_rdata\\\"] == rets[2][\\\"mem_addr\\\"] == 0x40\n    assert rets[3][\\\"rs1_rdata\\\"] == 0\n    assert rets[3][\\\"cycle\\\"] == rets[2][\\\"cycle\\\"] + 1\n    assert writes == [(0x48, 0xF, 0x55)]\n    assert 0x44 not in dmem\n\n\n@cocotb.test()\nasync def trapping_load_leaves_the_older_result_forwardable(dut):\n    program = [ADDI(1, 0, 5), LW(1, 0, 2), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program, {0: 0x55})\n    _check_retirements(rets, [0, 4, 8, 12])\n    assert rets[1][\\\"trap\\\"] == 1 and rets[1][\\\"mem_rmask\\\"] == 0\n    assert rets[2][\\\"rs1_rdata\\\"] == 5 and rets[2][\\\"rd_wdata\\\"] == 8\n\n\n''' + s[at:]\np.write_text(s)\nPY\nmake test TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
