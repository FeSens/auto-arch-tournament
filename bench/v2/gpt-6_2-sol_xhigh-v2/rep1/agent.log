{"type": "item.started", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/bash -c 'set -e\nfor variant in early-train compact-early; do\n  mkdir -p \"$TMPDIR/bench-r5s2-$variant/cores/bench\"\n  if test \"$variant\" = early-train; then source_variant=corrected-btb; else source_variant=compact; fi\n  cp -r \"$TMPDIR/bench-r5s2-$source_variant/cores/bench/rtl\" \"$TMPDIR/bench-r5s2-$variant/cores/bench/\"\n  cp cores/bench/core.yaml \"$TMPDIR/bench-r5s2-$variant/cores/bench/\"\n  cp -r fpga \"$TMPDIR/bench-r5s2-$variant/\"\n  ln -s \"$TMPDIR/bench-r5s2/bench\" \"$TMPDIR/bench-r5s2-$variant/bench\"\ndone\npython3 - \"$TMPDIR\" \"$PWD/cores/bench/rtl\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nbase, original = (Path(p) for p in sys.argv[1:])\n\nfor variant in [\\\"early-train\\\", \\\"compact-early\\\"]:\n    rtl = base / f\\\"bench-r5s2-{variant}\\\" / \\\"cores/bench/rtl\\\"\n    p = rtl / \\\"core_pkg.sv\\\"\n    s = p.read_text()\n    s = s.replace(\\\"    logic [31:0] instr;\\\\n  } if_id_t;\\\", \\\"\\\"\\\"    logic [31:0] instr;\n    logic        btb_hit;\n    logic [1:0]  btb_counter;\n  } if_id_t;\\\"\\\"\\\")\n    s = s.replace(\\\"    logic        valid;\\\\n  } id_ex_t;\\\", \\\"\\\"\\\"    logic        btb_hit;\n    logic [1:0]  btb_counter;\n    logic        valid;\n  } id_ex_t;\\\"\\\"\\\")\n    for item in [\\\"is_jump\\\", \\\"is_branch\\\", \\\"train\\\"]:\n        s = s.replace(f\\\"    logic        {item};\\\\n\\\", \\\"\\\")\n    s = s.replace(\\\"    logic [17:0] pc_word;\\\\n    logic [31:0]\\\", \\\"    logic [31:0]\\\")\n    if variant == \\\"compact-early\\\":\n        s = s.replace(\\\"    logic        take_target;\\\\n\\\", \\\"\\\")\n    p.write_text(s)\n    p = rtl / \\\"id_stage.sv\\\"\n    s = p.read_text().replace(\\\"      reg_q.instr         <= in.instr;\\\", \\\"\\\"\\\"      reg_q.instr         <= in.instr;\n      reg_q.btb_hit       <= in.btb_hit;\n      reg_q.btb_counter   <= in.btb_counter;\\\"\\\"\\\")\n    p.write_text(s)\n    p = rtl / \\\"ex_stage.sv\\\"\n    s = p.read_text().replace(\\\"  output predict_check_t     check_record\\\\n\\\", \\\"\\\"\\\"  output predict_check_t     check_record,\n  output btb_update_t        btb_update\n\\\"\\\"\\\")\n    for field in [\\\"is_jump\\\", \\\"is_branch\\\", \\\"pc_word\\\"] + ([\\\"take_target\\\"] if variant == \\\"compact-early\\\" else []):\n        s = \\\"\\\".join(l for l in s.splitlines(keepends=True) if f\\\"check_record.{field} <=\\\" not in l)\n    s = s.replace(\\\"\\\"\\\"    check_record.train <= \"'!in.ctrl.is_illegal && !misalign_fault &&\n                          in.pc[31:20] == 12'\"'b0 && in.pc[1:0] == 2'b00;\n\\\"\\\"\\\", \\\"\\\")\n    original_ex = (original / p.name).read_text()\n    train_block = original_ex[original_ex.index(\\\"  logic train;\\\"):original_ex.index(\\\"  ctrl_t ctrl_with_trap;\\\")]\n    s = s.replace(\\\"  ctrl_t ctrl_with_trap;\\\", train_block + \\\"  ctrl_t ctrl_with_trap;\\\")\n    p.write_text(s)\n    p = rtl / \\\"core.sv\\\"\n    s = p.read_text().replace(\\\"  logic        train_hit;\\\\n  logic [1:0]  train_counter;\\\\n\\\", \\\"\\\")\n    s = s[:s.index(\\\"  logic train;\\\")] + s[s.index(\\\"  // regfile interface\\\"):]\n    s = s.replace(\\\"\\\"\\\"    .out             (if_id_w),\n    .train_hit       (train_hit),\n    .train_counter   (train_counter)\\\"\\\"\\\", \\\"    .out             (if_id_w)\\\")\n    s = s.replace(\\\"    .check_record    (check_record)\\\\n\\\", \\\"\\\"\\\"    .check_record    (check_record),\n    .btb_update      (btb_update)\n\\\"\\\"\\\")\n    p.write_text(s)\n    p = rtl / \\\"if_stage.sv\\\"\n    s = p.read_text()\n    s = s.replace(\\\"\\\"\\\"  output if_id_t            out,\n  output logic              train_hit,\n  output logic [1:0]        train_counter\n\\\"\\\"\\\", \\\"  output if_id_t            out\\\\n\\\")\n    s = s.replace(\\\"  logic        predict_taken;\\\", \\\"  logic [1:0]  counter;\\\\n  logic        same_index_write;\\\")\n    s = s.replace(\\\"  logic [12:0] btb_tag [0:31];\\\\n  logic [17:0] btb_target [0:31];\\\", \\\"  logic [30:0] btb_entry [0:31];\\\")\n    s = s.replace(\\\"\\\"\\\"  assign fetch_tag = btb_tag[fetch_index];\n  assign fetch_target = btb_target[fetch_index];\n  assign predict_taken = btb_counter[fetch_index][1];\\\"\\\"\\\", \\\"\\\"\\\"  assign {fetch_tag, fetch_target} = btb_entry[fetch_index];\n  assign counter = btb_counter[fetch_index];\\\"\\\"\\\")\n    s = s.replace(\\\"hit && predict_taken\\\", \\\"hit && counter[1]\\\")\n    s = s.replace(\\\"\\\"\\\"  assign train_hit = btb_valid[write_index] && btb_tag[write_index] == write_tag;\n  assign train_counter = btb_counter[write_index];\\\"\\\"\\\", \\\"\\\"\\\"  assign same_index_write = btb_update.write_counter && write_index == fetch_index;\\\"\\\"\\\")\n    s = s.replace(\\\"\\\"\\\"    if (\"'!reset && btb_update.write_target) begin\n      btb_tag[write_index] <= write_tag;\n      btb_target[write_index] <= btb_update.target_word;\n    end\"\"\", \"\"\"    if (!reset && btb_update.write_target)\n      btb_entry[write_index] <= {write_tag, btb_update.target_word};\"\"\")\n    compare_addr = \"imem_addr\" if variant == \"early-train\" else \"pc\"\n    s = s.replace(\"    out.instr    = imem_data;'\"\\\\n\\\", f\\\"\\\"\\\"    out.instr    = imem_data;\n    out.btb_hit = same_index_write ? fetch_in_range && write_tag == {compare_addr}[19:7] : hit;\n    out.btb_counter = same_index_write ? btb_update.counter : counter;\n\\\"\\\"\\\")\n    if variant == \\\"compact-early\\\":\n        # Recovery ignores the BTB for the selected successor but still needs metadata\n        # at its accepted address so that a recovered branch trains against its entry.\n        s = s.replace(\\\"fetch_index = pc[6:2]\\\", \\\"fetch_index = imem_addr[6:2]\\\")\n        s = s.replace(\\\"pc[31:20] == 12'b0 && pc[1:0] == 2'b00\\\", \\\"imem_addr[31:20] == 12'b0 && imem_addr[1:0] == 2'b00\\\")\n        s = s.replace(\\\"== pc[19:7]\\\", \\\"== imem_addr[19:7]\\\")\n    p.write_text(s)\nPY\nfor variant in early-train compact-early; do\n  bench_rtl=\\\"\"'$TMPDIR/bench-r5s2-$variant/cores/bench/rtl\"\n  verilator --lint-only -Wall -sv --top-module core \"$bench_rtl/core_pkg.sv\" \"$bench_rtl/\"*.sv\ndone'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
