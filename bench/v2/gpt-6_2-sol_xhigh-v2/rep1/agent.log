{"type": "item.started", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom contextlib import contextmanager\n\n@contextmanager\ndef source(name):\n    path = Path('cores/bench/rtl') / (name + '.sv')\n    contents = [path.read_text()]\n    def replace(old, new):\n        assert contents[0].count(old) == 1, (name, old)\n        contents[0] = contents[0].replace(old, new)\n    yield replace\n    path.write_text(contents[0])\n\nwith source('core_pkg') as replace:\n    replace('  // EX -> IF update,', '''  typedef struct packed {\n    logic [31:0] target;\n    logic [31:0] fallthrough;\n    logic        match_target;\n    logic        match_fallthrough;\n    logic        take_target;\n    logic        valid;\n  } recovery_t;\n\n  // EX -> IF update,''')\n\nwith source('core') as replace:\n    replace('  logic [31:0] redirect_target;', '  recovery_t recovery;')\n    replace('    .redirect        (redirect),\\\\n    .redirect_target (redirect_target),', '    .redirect        (redirect),\\\\n    .recovery        (recovery),')\n    replace('    .squash   (redirect || \"'!fetch_ready),'\"', '''    .fetch_ready (fetch_ready),\n    .redirect (redirect),\n    .btb_update (btb_update),''')\n    replace('    .redirect        (redirect),\\\\n    .redirect_target (redirect_target),\\\\n    .btb_update      (btb_update)\\\\n', '    .recovery        (recovery),\\\\n    .btb_update      (btb_update)\\\\n')\n\nwith source('ex_stage') as replace:\n    replace('  output logic               redirect,\\\\n  output logic [31:0]        redirect_target,', '  output recovery_t          recovery,')\n    replace('  assign redirect = ex_ready && \"'!stall && !(take_target ? match_target : match_fallthrough);'\"\\\\n  assign redirect_target = resolved_pc;', '''\n  always_ff @(posedge clock) begin\n    recovery.valid <= \"'!reset && ex_ready && !stall;\n    recovery.take_target <= take_target;\n    recovery.match_fallthrough <= match_fallthrough;\n    recovery.match_target <= match_target;\n    recovery.fallthrough <= in.pc_plus4;\n    recovery.target <= target;\n  end'\"''')\n    replace('  always_comb begin\\\\n    btb_update.pc_word', '  btb_update_t update_d;\\\\n  always_comb begin\\\\n    update_d.pc_word')\n    replace('    btb_update.target_word', '    update_d.target_word')\n    replace('    btb_update.write_target', '    update_d.write_target')\n    replace('    btb_update.write_counter = btb_update.write_target', '    update_d.write_counter = update_d.write_target')\n    replace('      btb_update.counter = 2\\\\'b11;', '      update_d.counter = 2\\\\'b11;')\n    replace('      btb_update.counter = 2\\\\'b10;', '      update_d.counter = 2\\\\'b10;')\n    replace('      btb_update.counter = in.btb_counter == 2\\\\'b11', '      update_d.counter = in.btb_counter == 2\\\\'b11')\n    replace('      btb_update.counter = in.btb_counter == 2\\\\'b00', '      update_d.counter = in.btb_counter == 2\\\\'b00')\n    replace('  ctrl_t ctrl_with_trap;', '''\n  always_ff @(posedge clock) begin\n    btb_update <= reset ? '0 : update_d;\n  end\n\n  ctrl_t ctrl_with_trap;''')\n\nwith source('id_stage') as replace:\n    replace('  input  logic              squash,', '''  input  logic              fetch_ready,\n  input  logic              redirect,\n  input  btb_update_t       btb_update,''')\n    replace('  id_ex_t reg_q;', '''  id_ex_t reg_q;\n  logic same_index_update, effective_hit;\n  logic [1:0] effective_counter;\n\n  assign same_index_update = btb_update.write_counter\n                          && btb_update.pc_word[4:0] == reg_q.pc[6:2];\n  assign effective_hit = same_index_update\n                       ? (reg_q.pc[31:20] == 12'b0 && reg_q.pc[1:0] == 2'b00\n                          && btb_update.pc_word[17:5] == reg_q.pc[19:7])\n                       : reg_q.btb_hit;\n  assign effective_counter = same_index_update ? btb_update.counter : reg_q.btb_counter;''')\n    replace('      reg_q.valid <= \"'!squash;'\"', '''      reg_q.valid <= fetch_ready;\n    else if (redirect)\n      reg_q.valid <= 1'b0;''')\n    replace('      reg_q.btb_counter   <= in.btb_counter;\\\\n    end', '''      reg_q.btb_counter   <= in.btb_counter;\n    end else if (same_index_update) begin\n      reg_q.btb_hit       <= effective_hit;\n      reg_q.btb_counter   <= effective_counter;\n    end''')\n    replace('  assign out = reg_q;', '''  always_comb begin\n    out = reg_q;\n    out.valid = reg_q.valid && \"'!redirect;\n    out.btb_hit = effective_hit;\n    out.btb_counter = effective_counter;\n  end'\"''')\n\nwith source('if_stage') as replace:\n    replace('  input  logic              redirect,\\\\n  input  logic [31:0]       redirect_target,', '  output logic              redirect,\\\\n  input  recovery_t         recovery,')\n    replace('  logic [31:0] pc;', '  logic [31:0] pc, normal_pc;')\n    replace('  logic        fetch_in_range, hit, same_index_write;', '  logic        fetch_in_range, hit, same_index_target, same_index_write;')\n    replace('  assign {fetch_tag, fetch_target} = btb_entry[fetch_index];', '''  assign {fetch_tag, fetch_target} = same_index_target\n                                   ? {write_tag, btb_update.target_word}\n                                   : btb_entry[fetch_index];''')\n    replace('  assign counter = btb_counter[fetch_index];', '  assign counter = same_index_write ? btb_update.counter : btb_counter[fetch_index];')\n    replace('  assign hit = fetch_in_range && btb_valid[fetch_index] && fetch_tag == pc[19:7];', '  assign hit = fetch_in_range && (same_index_target || btb_valid[fetch_index]) && fetch_tag == pc[19:7];')\n    replace('  // A resolving instruction can redirect even when imem is unready.\\\\n  // EX qualifies redirect and training with its own advance.\\\\n  always_ff @(posedge clock) begin\\\\n    if (reset)              pc <= \\\\'0;\\\\n    else if (redirect)      pc <= redirect_target;\\\\n    else if (advance_fetch) pc <= predicted_pc;\\\\n  end', '''\n  assign same_index_target = btb_update.write_target && write_index == fetch_index;\n\n  logic redirect_target, redirect_fallthrough;\n  assign redirect_target = recovery.valid && recovery.take_target && \"'!recovery.match_target;\n  assign redirect_fallthrough = recovery.valid && !recovery.take_target && !recovery.match_fallthrough;\n  assign redirect = redirect_target || redirect_fallthrough;\n  assign pc = (normal_pc & {32{!redirect}})\n            | (recovery.target & {32{redirect_target}})\n            | (recovery.fallthrough & {32{redirect_fallthrough}});\n\n  always_ff @(posedge clock) begin\n    if (reset) normal_pc <= '\"'0;\n    else       normal_pc <= advance_fetch ? predicted_pc : pc;\n  end''')\n    replace('    // The prediction uses the old table value. The instruction accepted\\\\n    // on this edge trains against the entry that survives the EX write.\\\\n    out.btb_hit = same_index_write ? fetch_in_range && write_tag == pc[19:7] : hit;\\\\n    out.btb_counter = same_index_write ? btb_update.counter : counter;', '''    out.btb_hit = hit;\n    out.btb_counter = counter;''')\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
