, (8, 2, 9), (12, 3, 0)]\n\n\n@cocotb.test()\nasync def stalled_branch_discards_buffered_store(dut):\n    program = {\n        0: SW(0, 0, 64), 4: BEQ(0, 0, 12), 8: SW(0, 0, 68),\n        12: SW(0, 0, 72), 16: ADDI(1, 0, 21), 20: EBREAK(),\n    }\n    readiness = [(1, 1)] * 2 + [(1, 0)] * 2 + [(1, 1), (0, 1)] + [(1, 1)] * 8\n    addresses, writes, retirements = await _script_fetch(dut, program, readiness)\n    assert addresses[:7] == [0, 4, 8, 12, 12, 16, 16]\n    assert writes == [64]\n    assert retirements == [(0, 0, 0), (4, 1, 0), (16, 2, 21), (20, 3, 0)]\nPY\ncd \\\"\"'$probe_dir\" && PYTHONDONTWRITEBYTECODE=1 pytest -q -o cache_dir=\"$probe_dir/.pytest_cache\" cores/bench/test/test_pipeline.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
