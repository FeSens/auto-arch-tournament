2026-11-19T15:16:34.633064Z ERROR codex_core::tools::router: error=apply_patch verification failed: Failed to find expected lines in /srv/hwebench/clones/gpt-6_2-sol_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261119-003-r3s2/cores/bench/rtl/if_stage.sv:
// The registered fetch PC drives both imem and the direct-mapped BTB.
// ID sees raw instruction data and latches it with the training metadata.
module if_stage (
  input  logic              clock,
  input  logic              reset,
  input  logic              advance_fetch,
  input  logic              redirect,
  input  logic [31:0]       redirect_target,
  input  btb_update_t       btb_update,
  output logic [31:0]       imem_addr,
  input  logic [31:0]       imem_data,
  output if_id_t  out
);

  logic [31:0] pc;
  logic [31:0] pc_plus4, predicted_pc;
  logic [4:0]  fetch_index, write_index;
  logic [12:0] write_tag;
  logic        fetch_in_range, hit, same_index_write;
  logic [1:0]  counter;

  logic [31:0] btb_valid;
  logic [30:0] btb_entry [0:31]; // {tag, word target}
  logic [1:0]  btb_counter [0:31];
  logic [12:0] fetch_tag;
  logic [17:0] fetch_target;

  assign fetch_index = pc[6:2];
  assign {fetch_tag, fetch_target} = btb_entry[fetch_index];
  assign counter = btb_counter[fetch_index];
  assign fetch_in_range = pc[31:20] == 12'b0 && pc[1:0] == 2'b00;
  assign hit = fetch_in_range && btb_valid[fetch_index] && fetch_tag == pc[19:7];
  assign pc_plus4 = pc + 32'd4;
  assign predicted_pc = (hit && counter[1]) ? {12'b0, fetch_target, 2'b00} : pc_plus4;

  assign {write_tag, write_index} = btb_update.pc_word;
  assign same_index_write = btb_update.write_counter && write_index == fetch_index;

  // A resolving instruction can redirect even when imem is unready.
  // EX qualifies redirect and training with its own advance.
  always_ff @(posedge clock) begin
    if (reset)              pc <= '0;
    else if (redirect)      pc <= redirect_target;
    else if (advance_fetch) pc <= predicted_pc;
  end

  always_ff @(posedge clock) begin
    if (reset)
      btb_valid <= '0;
    else if (btb_update.write_target)
      btb_valid[write_index] <= 1'b1;

    if (!reset && btb_update.write_target)
      btb_entry[write_index] <= {write_tag, btb_update.target_word};
    if (!reset && btb_update.write_counter)
      btb_counter[write_index] <= btb_update.counter;
  end

  assign imem_addr = pc;

  always_comb begin
    out.pc       = pc;
    out.pc_plus4 = pc_plus4;
    out.instr    = imem_data;
    // The prediction uses the old table value. The instruction accepted
    // on this edge trains against the entry that survives the EX write.
    out.btb_hit = same_index_write ? fetch_in_range && write_tag == pc[19:7] : hit;
    out.btb_counter = same_index_write ? btb_update.counter : counter;
  end
endmodule
