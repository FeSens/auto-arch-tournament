{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\npython3 - \"$scratch_probe_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\nscratch = Path(sys.argv[1])\nfor name, basis in (('zero-stage', 'indirect-stage'), ('zero-stage-split', 'indirect-stage-split')):\n    rtl_dir = scratch / name / 'rtl'\n    shutil.copytree(scratch / basis / 'rtl', rtl_dir)\n    ex_stage = rtl_dir / 'ex_stage.sv'\n    rtl = ex_stage.read_text()\n    rtl = rtl.replace('  logic        jalr_wait, jalr_launch, jalr_pending_q;',\n                      '  logic        jalr_wait, jalr_launch, jalr_pending_q, jalr_has_offset;')\n    rtl = rtl.replace('  assign jalr_wait = in.valid && in.ctrl.is_jalr && \"'!jalr_pending_q;'\"',\n                      '  assign jalr_has_offset = |in.imm[11:0];\\\\n'\n                      '  assign jalr_wait = in.valid && in.ctrl.is_jalr && jalr_has_offset && \"'!jalr_pending_q;'\"')\n    rtl = rtl.replace('  assign jalr_sum = jalr_rs1_q + in.imm;',\n                      '  assign jalr_sum = jalr_has_offset ? (jalr_rs1_q + in.imm) : rs1;')\n    rtl = rtl.replace(': in.ctrl.is_jalr ? jalr_rs1_q', ': jalr_pending_q ? jalr_rs1_q')\n    rtl = rtl.replace(': in.ctrl.is_jalr ? jalr_rs2_q', ': jalr_pending_q ? jalr_rs2_q')\n    ex_stage.write_text(rtl)\nPY\nPYTHONDONTWRITEBYTECODE=1 python3 -u - \\\"\"'$scratch_probe_dir\" <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nimport sys\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nscratch = Path(sys.argv[1])\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    futures = {\n        pool.submit(build, root, scratch / design / 'rtl', 'fpga/core_bench_si.sv',\n                    option, scratch / design / f'gowin_p{option}'): (design, option)\n        for option in (1, 2, 0)\n        for design in ('zero-stage', 'zero-stage-split')\n    }\n    for future in as_completed(futures):\n        result = future.result()\n        print(*futures[future], result.get('fmax_mhz'), result.get('logic'), result.get('reason'),\n              (result.get('critical_paths') or [])[:2], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
