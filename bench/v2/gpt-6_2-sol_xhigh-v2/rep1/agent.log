{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'probe_dir=\"$TMPDIR/bench-predictor.YqPaFu\"\npython3 - \"$probe_dir/profile.out\" <<'\"'PY'\nfrom collections import Counter,defaultdict\nfrom pathlib import Path\nimport sys\ncounts=Counter(); miss=defaultdict(Counter); targets=defaultdict(Counter)\nfor line in Path(sys.argv[1]).open():\n    if not line.startswith('CF '): continue\n    pc, insn, target, squash, stall, taken, train = [int(x,16) for x in line.split()[1:]]\n    kind={0x63:'branch',0x6f:'jal',0x67:'jalr'}[insn & 127]\n    if kind=='jalr':\n        if insn>>20==0 and (insn>>15)&31 in (1,5) and (insn>>7)&31 not in (1,5): kind='return'\n        else: kind='indirect call'\n    counts[kind,'all']+=1\n    if squash:\n        counts[kind,'miss']+=1\n        counts[kind,'miss stall']+=stall\n        miss[kind][(pc,insn)]+=1\n    targets[kind,pc][target]+=1\nfor k,v in sorted(counts.items()):print(k,v)\nfor kind,items in miss.items():\n    print(kind)\n    for (pc,insn),ct in items.most_common(11):print(hex(pc), hex(insn), ct, [(hex(t),c) for t,c in targets[kind,pc].most_common(10)])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
