{"type": "item.started", "item": {"id": "item_67", "type": "command_execution", "command": "/bin/bash -c 'set -e\ncp -r cores/bench/test \"$TMPDIR/bench-r5s2-compact/cores/bench/\"\npython3 - \"$TMPDIR/bench-r5s2-compact/cores/bench/test/test_pipeline.py\" \"$TMPDIR/bench-r5s2-directed.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np, directed = (Path(arg) for arg in sys.argv[1:])\ns = p.read_text()\ndef replace_case(old, following, fn):\n    global s\n    begin = s.index(f\\\"async def {old}(\\\")\n    end = s.index(f\\\"async def {following}(\\\", begin)\n    s = s[:begin] + fn(s[begin:end]) + s[end:]\n\ndef same_pc(t):\n    t = t.replace('same_pc_update_bypasses_new_counter', 'same_pc_updates_train_to_saturation')\n    t = t.replace(\\\"\\\"\\\"    # Two taken iterations of a self-loop put its counter at 11. The\n    # next instance enters EX as the second taken branch writes the 11.\\\"\\\"\\\", \\\"\\\"\\\"    # Two self-loop outcomes saturate the counter. Reenter through PC 0\n    # so the loop branch uses its BTB entry after recovery to the preamble.\\\"\\\"\\\")\n    t = t.replace(\\\"0: ADDI(2, 0, 3)\\\", \\\"0: ADDI(2, 0, 4)\\\").replace(\\\"16: JAL(0, -12)\\\", \\\"16: JAL(0, -16)\\\")\n    t = t.replace(\\\"[0, 4, 4, 4, 8, 12, 16, 4, 8, 12, 16, 4, 8, 12, 20]\\\",\n                  \\\"[0, 4, 4, 4, 8, 12, 16, 0, 4, 8, 12, 16, 0, 4, 8, 12, 16, 0, 4, 8, 12, 20]\\\")\n    t = t.replace(\\\"[taken, taken, untaken, untaken, untaken]\\\", \\\"[taken, taken, untaken, untaken, untaken, untaken]\\\")\n    t = t.replace(\\\"\\\"\\\"    # The first two untaken outcomes still predict taken (11 -> 10 -> 01).\n    assert [rets[i + 1][\\\"cycle\\\"] - rets[i][\\\"cycle\\\"] for i in branches] == [2, 1, 2, 2, 1]\\\"\\\"\\\",\n                  \\\"\\\"\\\"    # The first untaken has sequential recovery prediction but still trains\n    # 11 to 10. The next predicts taken before training 10 to 01.\n    assert [rets[i + 1][\\\"cycle\\\"] - rets[i][\\\"cycle\\\"] for i in branches] == [2, 2, 1, 2, 1, 1]\\\"\\\"\\\")\n    return t\n\ndef same_index(t):\n    t = t.replace(\\\"\\\"\\\"    # A and B share PC[6:2]. When the hot JAL at A predicts B, its EX\n    # update must count as a miss in B's latched metadata. B then trains\n    # from weakly taken, so one untaken outcome clears the taken prediction.\\\"\\\"\\\", \\\"\\\"\\\"    # The hot JAL at A predicts B. B shares A's index and must train as\n    # a miss on its taken outcome. One untaken then clears its prediction.\n    # Reentry via each preamble uses the ordinary BTB lookup at A and B.\\\"\\\"\\\")\n    t = t.replace(\\\"        b: BEQ\\\", \\\"        b - 0x04: NOP(),\\\\n        b: BEQ\\\")\n    t = t.replace(\\\"BEQ(1, 2, a - (b + 0x0C))\\\", \\\"BEQ(1, 2, (a - 4) - (b + 0x0C))\\\")\n    t = t.replace(\\\"JAL(0, -0x10)\\\", \\\"JAL(0, -0x14)\\\").replace(\\\"JAL(0, -0x24)\\\", \\\"JAL(0, -0x28)\\\")\n    t = t.replace(\\\"0x98, 0x9C, a, b, 0xB0, 0xB4,\\\\n        b, 0x94, 0x98, 0x9C, 0xA0, b,\\\", \\\"0x98, 0x9C, 0x0C, a, b, 0xB0, 0xB4,\\\\n        0x8C, b, 0x94, 0x98, 0x9C, 0xA0, 0x8C, b,\\\")\n    return t\n\ndef jalr(t):\n    t = t.replace(\\\"\\\"\\\"        0x04: JALR(6, 5, -0x111),\n        0x08: BEQ(0, 0, 2),\n        0x0C: BEQ(0, 5, 2),\n        0x10: JAL(7, 2),\n        0x14: EBREAK(),\\\"\\\"\\\", \\\"\\\"\\\"        0x04: NOP(),\n        0x08: JALR(6, 5, -0x111),\n        0x0C: BEQ(0, 0, 2),\n        0x10: BEQ(0, 5, 2),\n        0x14: JAL(7, 2),\n        0x18: EBREAK(),\\\"\\\"\\\")\n    t = t.replace(\\\"[0, 4, 0x40, 0x44, 4, 0x50, 0x54, 4, 8, 12, 16, 20]\\\",\n                  \\\"[0, 4, 8, 0x40, 0x44, 4, 8, 0x50, 0x54, 4, 8, 12, 16, 20, 24]\\\")\n    t = t.replace(\\\"== [4, 8, 16]\\\", \\\"== [8, 12, 20]\\\")\n    t = t.replace('r[\\\"pc\\\"] == 4] == [(6, 8), (6, 8), (0, 0)]', 'r[\\\"pc\\\"] == 8] == [(6, 12), (6, 12), (0, 0)]')\n    t = t.replace(\\\"if pc == 4] == [8, 0x40, 0x50]\\\", \\\"if pc == 8] == [12, 0x40, 0x50]\\\")\n    return t\n\ndef stale(t):\n    t = t.replace(\\\"at PC 0 after its JAL has trained.\\\", \\\"at PC 4 after its JAL has trained.\\\")\n    t = t.replace(\\\"        4: SW(3, 0, 0x44),\\\\n        8: EBREAK(),\\\", \\\"        0: NOP(),\\\\n        8: SW(3, 0, 0x44),\\\\n        12: EBREAK(),\\\")\n    t = t.replace(\\\"if pc == 0:\\\\n            return LW(3, 0, 0x40) if 0x40 in dmem else JAL(0, 0x10)\\\", \\\"if pc == 4:\\\\n            return LW(3, 0, 0x40) if 0x40 in dmem else JAL(0, 0x0C)\\\")\n    t = t.replace(\\\"[0, 0x10, 0x14, 0x18, 0, 4, 8]\\\", \\\"[0, 4, 0x10, 0x14, 0x18, 0, 4, 8, 12]\\\").replace(\\\"rets[4:6]\\\", \\\"rets[6:8]\\\")\n    return t\n\nreplace_case(\\\"same_pc_update_bypasses_new_counter\\\", \\\"same_index_update_checks_tag\\\", same_pc)\nreplace_case(\\\"same_index_update_checks_tag\\\", \\\"predicted_jalr_retargets_and_traps\\\", same_index)\nreplace_case(\\\"predicted_jalr_retargets_and_traps\\\", \\\"stale_taken_prediction_on_load\\\", jalr)\nreplace_case(\\\"stale_taken_prediction_on_load\\\", \\\"recovery_waits_for_older_store_then_overrides_imem_stall\\\", stale)\nadd = directed.read_text()\nstart = add.index(\\\"async def stale_taken_load_redirects_during_its_own_stall\\\")\nend = add.index(\\\"@cocotb.test()\\\", start)\nchanged = add[start:end].replace(\\\"        4: DIVU(4, 3, 3),\\\\n        8: SW(4, 0, 0x44),\\\\n        12: EBREAK(),\\\", \\\"\\\"\\\"        0: NOP(),\n        8: DIVU(4, 3, 3),\n        12: SW(4, 0, 0x44),\n        16 + 12: EBREAK(),\\\"\\\"\\\")\n# The final EBREAK is placed before the setup block.\nchanged = changed.replace(\\\"16 + 12: EBREAK()\\\", \\\"0x1C: EBREAK()\\\").replace(\\\"12: SW(4, 0, 0x44),\\\", \\\"12: SW(4, 0, 0x44),\\\").replace(\\\"        0x10:\\\", \\\"        0x10:\\\")\nchanged = changed.replace(\\\"if pc == 0:\\\", \\\"if pc == 4:\\\").replace(\\\"JAL(0, 0x10)\\\", \\\"JAL(0, 0x0C)\\\")\n# Keep the setup at 0x30 so the rewritten path retires an EBREAK at 0x10.\nchanged = changed.replace(\\\"0x1C: EBREAK()\\\", \\\"0x10: EBREAK()\\\").replace(\\\"0x14: SW\\\", \\\"0x34: SW\\\").replace(\\\"0x18: JAL(0, -0x18)\\\", \\\"0x38: JAL(0, -0x38)\\\")\nchanged = changed.replace(\\\"if pc == 0x10:\\\", \\\"if pc == 0x30:\\\").replace(\\\"JAL(0, 0x0C)\\\", \\\"JAL(0, 0x2C)\\\")\nchanged = changed.replace(\\\"[0, 0x10, 0x14, 0x18, 0, 4, 8, 12]\\\", \\\"[0, 4, 0x30, 0x34, 0x38, 0, 4, 8, 12, 16]\\\").replace(\\\"rets[4:6]\\\", \\\"rets[6:8]\\\").replace(\\\"(4, False, False)\\\", \\\"(8, False, False)\\\")\nadd = add[:start] + changed + add[end:]\ns = s.replace(\\\"\\\\ndef test_pipeline_runner():\\\", \\\"\\\\n\\\" + add + \\\"\\\\ndef test_pipeline_runner():\\\")\np.write_text(s)\nPY\ncd \\\"\"'$TMPDIR/bench-r5s2-compact/cores/bench\"\npython3 -m pytest -q test/ > \"$TMPDIR/bench-r5s2-compact/pytest.log\" 2>&1'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
