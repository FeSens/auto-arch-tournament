{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/bash -c 'scratch_dir=/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U\npython - \"$scratch_dir\" <<'\"'PY'\nimport shutil\nimport sys\nfrom pathlib import Path\nroot = Path(sys.argv[1])\nfor model in ('zero', 'last'):\n    out = root / f'value-{model}' / 'rtl'\n    shutil.copytree('cores/bench/rtl', out)\n    def replace(filename, *changes):\n        p = out / f'{filename}.sv'\n        contents = p.read_text()\n        for old, new in changes:\n            assert contents.count(old) == 1, (filename, old, contents.count(old))\n            contents = contents.replace(old, new)\n        p.write_text(contents)\n    replace('core_pkg', ('    logic        refetch;','    logic [31:0] retry_pc;\\\\n    logic        retry;\\\\n    logic        refetch;'))\n    replace('if_stage',\n        ('  assign recover_target = fetch_resolution.valid', '  assign recover_target = \"'!fetch_resolution.retry && fetch_resolution.valid'\"'),\n        ('  assign recover_fallthrough = fetch_resolution.valid', '  assign recover_fallthrough = \"'!fetch_resolution.retry && fetch_resolution.valid'\"'),\n        ('  assign squash_candidate = recover_target || recover_fallthrough;', '  assign squash_candidate = fetch_resolution.retry || recover_target || recover_fallthrough;'),\n        ('            | ({32{recover_fallthrough}} & fetch_resolution.fallthrough);', '            | ({32{recover_fallthrough}} & fetch_resolution.fallthrough)\\\\n            | ({32{fetch_resolution.retry}} & fetch_resolution.retry_pc);'))\n    replace('mem_stage',\n        ('  output logic [31:0]        load_data_rs2,','  output logic [31:0]        load_data_rs2,\\\\n  output logic [31:0]        load_value,'),\n        ('  logic [31:0] load_data;\\\\n',''),\n        ('  assign load_data = format_load', '  assign load_value = format_load'),\n        ('                        | load_data;', '                        | load_value;'))\n    replace('core',\n        ('  logic [31:0] fwd_load_rs1, fwd_load_rs2;', '  logic [31:0] fwd_load_rs1, fwd_load_rs2, load_value;'),\n        ('    .fwd_load_rs2     (fwd_load_rs2),', '    .fwd_load_rs2     (fwd_load_rs2),\\\\n    .load_value       (load_value),'),\n        ('    .load_data_rs2 (fwd_load_rs2),', '    .load_data_rs2 (fwd_load_rs2),\\\\n    .load_value    (load_value),'))\n    prediction = (\\\"  assign prediction = '0;\\\" if model == 'zero' else \\\"\\\"\\\"  always_ff @(posedge clock) begin\n    if (reset)\n      prediction <= '0;\n    else if (\"'!stall && reg_q.valid && reg_q.ctrl.mem_read && !reg_q.mem_misalign)\n      prediction <= load_value;\n  end\"\"\")\n    replace('\"'ex_stage',\n        ('  input  logic [31:0]        fwd_load_rs2,', '  input  logic [31:0]        fwd_load_rs2,\\\\n  input  logic [31:0]        load_value,'),\n        ('  logic [31:0] rs2;', '  logic [31:0] rs2;\\\\n  logic [31:0] rs1_reg, rs2_reg;'),\n        ('  assign rs1 = ({32{fwd_rs1_sel.result.other}}', '  assign rs1_reg = ({32{fwd_rs1_sel.result.other}}'),\n        ('  assign rs2 = ({32{fwd_rs2_sel.result.other}}', '  assign rs2_reg = ({32{fwd_rs2_sel.result.other}}'),\n        ('             | ({32{fwd_rs1_sel.regfile}}      & in.rs1_val)\\\\n             | fwd_load_rs1;', '             | ({32{fwd_rs1_sel.regfile}}      & in.rs1_val);'),\n        ('             | ({32{fwd_rs2_sel.regfile}}      & in.rs2_val)\\\\n             | fwd_load_rs2;', '             | ({32{fwd_rs2_sel.regfile}}      & in.rs2_val);\\\\n  assign rs1 = rs1_reg | fwd_load_rs1;\\\\n  assign rs2 = rs2_reg | fwd_load_rs2;'),\n        ('  logic [31:0] alu_a;', '  logic [31:0] alu_rs1, alu_rs2, prediction;\\\\n  logic speculative_consumer, load_dep, retry_div, retry_consumer;\\\\n  ex_mem_t reg_q;\\\\n  logic [31:0] alu_a;'),\n        ('    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\\\\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;', '    alu_a = in.ctrl.is_auipc ? in.pc  : alu_rs1;\\\\n    alu_b = in.ctrl.alu_src  ? in.imm : alu_rs2;'),\n        ('  assign div_wait = is_div && \"'!div_valid;'\"\\\\n  assign div_start = is_div && \"'!stall && !div_busy;'\"',\n         prediction + \\\"\\\"\\\"\n  assign alu_rs1 = rs1_reg | ({32{fwd_rs1_sel.result.load}} & prediction);\n  assign alu_rs2 = rs2_reg | ({32{fwd_rs2_sel.result.load}} & prediction);\n  assign speculative_consumer = in.ctrl.reg_write && \"'!in.ctrl.is_jump\n                             && !in.ctrl.mem_to_reg && !in.ctrl.is_lui\n                             && !in.ctrl.is_auipc && !in.ctrl.is_illegal;\n  assign load_dep = fwd_rs1_sel.result.load || (!in.ctrl.alu_src && fwd_rs2_sel.result.load);\n  assign retry_div = select_div && load_dep;\n  assign retry_consumer = speculative_consumer && load_dep\n                        && (select_div || load_value != prediction);\n  assign div_wait = is_div && !retry_div && !div_valid;\n  assign div_start = is_div && !retry_div && !stall && !div_busy;\"\"\"),\n        ('\"'    .mul_a        (rs1),\\\\n    .mul_b        (rs2),', '    .mul_a        (alu_rs1),\\\\n    .mul_b        (alu_rs2),'),\n        ('    fetch_resolution.target            <= target;', '    fetch_resolution.retry              <= \"'!reset && advance && retry_consumer;'\"\\\\n    fetch_resolution.retry_pc           <= in.pc;\\\\n    fetch_resolution.target            <= target;'),\n        ('  // ── EX/MEM register ───────────────────────────────────────────────────\\\\n  ex_mem_t reg_q;', '  // ── EX/MEM register ───────────────────────────────────────────────────'),\n        ('  assign out = reg_q;', \\\"\\\"\\\"  always_comb begin\n    out = reg_q;\n    if (fetch_resolution.retry) begin\n      out.ctrl = '0;\n      out.result_sel = '0;\n      out.valid = 1'b0;\n    end\n  end\\\"\\\"\\\"))\nPY\nfor model_name in zero last; do\n  (\n    NRET=1 RTL_DIR=\\\"\"'$scratch_dir/value-$model_name/rtl\" OBJ_DIR=\"$scratch_dir/value-$model_name/sim\" MAKEFLAGS=-j2 bash test/cosim/build.sh > \"$scratch_dir/value-$model_name/sim.log\" 2>&1 &&\n    \"$scratch_dir/value-$model_name/sim/cosim_sim\" \"$scratch_dir/coremark.elf\" 50000000 --bench --istall --dstall > \"$scratch_dir/value-$model_name/coremark.log\"\n  ) &\ndone\nPYTHONDONTWRITEBYTECODE=1 python -u - <<'\"'PY' > \\\"\"'$scratch_dir/timing-value.log\" 2>&1 &\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nroot = Path('\"'/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U')\njobs = [(name, opt) for name in ('zero', 'last') for opt in (0, 1, 2)]\ndef measure(job):\n    model, option = job\n    candidate = root / f'value-{model}'\n    result = build(Path.cwd(), candidate/'rtl', 'fpga/core_bench_si.sv', option, candidate/f'gowin_p{option}')\n    print(model, option, {key:result.get(key) for key in ('fmax_mhz','logic','bsram','reason')}, flush=True)\n    return model, result\nresults = {}\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    for model, result in executor.map(measure, jobs):\n        results.setdefault(model, []).append(result)\nfor model, placements in results.items():\n    print(model, summarize(placements), flush=True)\nPY\nwait\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
