{"type":"item.completed","item":{"id":"item_27","type":"agent_message","text":"The first prototype passed stalled CoreMark, but it added about 161,000 timed cycles and exposed a slower branch path. The trace shows that immediate load dependencies are dominated by equality branches and pointer loads. I’m testing a split that preserves those two same-cycle paths."}}
{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$TMPDIR/bench-r9s1-study\"\nmkdir -p \"$scratch/split-load\"\ncp cores/bench/rtl/*.sv \"$scratch/split-load/\"\ncat > \"$scratch/split-load.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\nrtl = Path(sys.argv[1])\ndef change(name, replacements):\n    path = rtl / (name + '.sv')\n    src = path.read_text()\n    for old, new in replacements:\n        assert old in src, (name, old)\n        src = src.replace(old, new, 1)\n    path.write_text(src)\n\nchange('core_pkg', [\n    ('    logic [1:0]  ex_match;', '    logic [1:0]  used_sources;\\\\n    logic        load_eq_branch;\\\\n    logic [1:0]  ex_match;'),\n])\nchange('ex_stage', [\n    ('  input  logic [31:0]        fwd_load_rs2,', '''  input  logic [31:0]        fwd_load_rs2,\n  input  logic [31:0]        fwd_load_word_rs1,\n  input  logic               mem_word_load,'''),\n    ('  output ex_mem_t             out,', '''  output logic [31:0]        replay_rs1, replay_rs2,\n  output logic               load_wait,\n  output ex_mem_t             out,'''),\n    ('  assign rs1 =', '  logic [31:0] fast_rs1, fast_rs2;\\\\n\\\\n  assign fast_rs1 ='),\n    (' & in.rs1_val)\\\\n             | fwd_load_rs1;', ' & in.rs1_val);'),\n    ('  assign rs2 =', '  assign fast_rs2 ='),\n    (' & in.rs2_val)\\\\n             | fwd_load_rs2;', ''' & in.rs2_val);\n\n  assign rs1 = fast_rs1 | fwd_load_rs1;\n  assign rs2 = fast_rs2 | fwd_load_rs2;\n  assign replay_rs1 = fast_rs1;\n  assign replay_rs2 = fast_rs2;\n  assign load_wait = in.valid && \"'!in.load_eq_branch\n                  && ((in.used_sources[0] && fwd_rs1_sel.result.load && !(in.ctrl.mem_read && mem_word_load))\n                      || (in.used_sources[1] && fwd_rs2_sel.result.load));'\"'''),\n    ('in.pc  : rs1;', 'in.pc  : fast_rs1;'),\n    ('in.imm : rs2;', 'in.imm : fast_rs2;'),\n    ('is_div && \"'!stall && !div_busy'\"', 'is_div && \"'!stall && !load_wait && !div_busy'\"'),\n    ('is_div && \"'!stall && div_valid'\"', 'is_div && \"'!stall && !load_wait && div_valid'\"'),\n    ('    .mul_a        (rs1),', '    .mul_a        (fast_rs1),'),\n    ('    .mul_b        (rs2),', '    .mul_b        (fast_rs2),'),\n    ('  logic [31:0] base_plus_imm;', '  logic [31:0] base_plus_imm, jalr_sum;\\\\n  logic [31:0] addr_base;'),\n    ('= rs1[i*8 +: 8] < rs2[i*8 +: 8];', '= fast_rs1[i*8 +: 8] < fast_rs2[i*8 +: 8];'),\n    ('''  logic [3:0] branch_byte_eq, branch_byte_lt;\n  logic branch_eq, branch_lt, branch_signed_lt;''', '''  logic [3:0] branch_byte_eq, branch_byte_lt, fast_byte_eq;\n  logic branch_eq, branch_lt, branch_signed_lt, ordered_taken;'''),\n    ('''    assign branch_byte_lt[i]''', '''    assign fast_byte_eq[i] = fast_rs1[i*8 +: 8] == fast_rs2[i*8 +: 8];\n    assign branch_byte_lt[i]'''),\n    ('branch_byte_eq[3] && branch_byte_lt[2]', 'fast_byte_eq[3] && branch_byte_lt[2]'),\n    ('&branch_byte_eq[3:2]', '&fast_byte_eq[3:2]'),\n    ('&branch_byte_eq[3:1]', '&fast_byte_eq[3:1]'),\n    ('(rs1[31] == rs2[31]) ? branch_lt : rs1[31]', '(fast_rs1[31] == fast_rs2[31]) ? branch_lt : fast_rs1[31]'),\n    ('''      BR_BEQ:  branch_cond = branch_eq;\n      BR_BNE:  branch_cond = \"'!branch_eq;\n      BR_BLT:  branch_cond = branch_signed_lt;\n      BR_BGE:  branch_cond = !branch_signed_lt;\n      BR_BLTU: branch_cond = branch_lt;\n      BR_BGEU: branch_cond = !branch_lt;\n      default: branch_cond = 1'\"'b0;''', '''      BR_BLT:  ordered_taken = branch_signed_lt;\n      BR_BGE:  ordered_taken = \"'!branch_signed_lt;\n      BR_BLTU: ordered_taken = branch_lt;\n      BR_BGEU: ordered_taken = !branch_lt;\n      default: ordered_taken = 1'\"'b0;'''),\n    ('''  assign base_plus_imm = rs1 + in.imm;\n  assign target = in.ctrl.is_jalr ? {base_plus_imm[31:1], 1'b0} : in.direct_target;''', '''  assign branch_cond = in.load_eq_branch ? branch_eq \"'^ in.ctrl.branch_op[0] : ordered_taken;\n  assign addr_base = fast_rs1 | fwd_load_word_rs