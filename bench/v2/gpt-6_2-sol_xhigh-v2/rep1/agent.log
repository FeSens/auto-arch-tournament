{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' fpga/core_bench_si.sv && git check-ignore -v cores/bench/experiments/hypotheses/hyp-20261119-003-r3s2.yaml && ls -la cores/bench/experiments/hypotheses\"", "aggregated_output": "// fpga/core_bench_si.sv\n//\n// FPGA Fmax wrapper for single-issue (`nret 1`) cores. Same shape as\n// core_bench.sv but instantiates `core` with only the channel-0 RVFI port\n// set — no `_1` ports. Selected by the orchestrator (via BENCH env var in\n// synth.tcl) when cores/<target>/core.yaml declares nret: 1.\n//\n// See core_bench.sv for the rationale on LFSR-driven imem, the dmem\n// model, the V2 stall generator, and why the LED observes only the\n// memory-side outputs (RVFI-only logic is pruned).\nmodule core_bench (\n  input  logic clock,\n  input  logic reset,\n  output logic led\n);\n\n  logic [31:0] lfsr;\n  always_ff @(posedge clock or posedge reset)\n    if (reset) lfsr <= 32'h1;\n    else       lfsr <= {lfsr[30:0], lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]};\n\n  logic [31:0] dmem [0:2047];\n  logic [31:0] dmem_rdata;\n  logic [31:0] dmem_addr;\n  logic [31:0] dmem_wdata;\n  logic [3:0]  dmem_wen;\n  logic        dmem_ren;\n\n  always_ff @(posedge clock) begin\n    if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n    if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n    if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n    if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n  end\n  assign dmem_rdata = dmem[dmem_addr[12:2]];\n\n  logic [31:0] imem_addr;\n  // Single-channel RVFI port set (NRET=1 contract). Connected for\n  // elaboration only; nothing observes it, so synthesis prunes it.\n  logic        rvfi_valid_0;\n  logic [63:0] rvfi_order_0;\n  logic [31:0] rvfi_insn_0, rvfi_pc_rdata_0, rvfi_pc_wdata_0;\n  logic [31:0] rvfi_rd_wdata_0, rvfi_rs1_rdata_0, rvfi_rs2_rdata_0;\n  logic [31:0] rvfi_mem_addr_0, rvfi_mem_rdata_0, rvfi_mem_wdata_0;\n  logic [4:0]  rvfi_rs1_addr_0, rvfi_rs2_addr_0, rvfi_rd_addr_0;\n  logic [3:0]  rvfi_mem_rmask_0, rvfi_mem_wmask_0;\n  logic [1:0]  rvfi_mode_0, rvfi_ixl_0;\n  logic        rvfi_trap_0, rvfi_halt_0, rvfi_intr_0;\n\n  // V2: memory-ready signals come from the same stall sequence the\n  // CoreMark simulation uses, so stall-handling logic\n…[1182 of 4254 chars elided by tools/bench/transcript.py; sha256:05652718256ae5bf]…\nfi_rd_wdata_0),\n    .io_rvfi_pc_rdata_0 (rvfi_pc_rdata_0),\n    .io_rvfi_pc_wdata_0 (rvfi_pc_wdata_0),\n    .io_rvfi_mem_addr_0 (rvfi_mem_addr_0),\n    .io_rvfi_mem_rmask_0(rvfi_mem_rmask_0),\n    .io_rvfi_mem_wmask_0(rvfi_mem_wmask_0),\n    .io_rvfi_mem_rdata_0(rvfi_mem_rdata_0),\n    .io_rvfi_mem_wdata_0(rvfi_mem_wdata_0)\n  );\n\n  // V2: observe only the memory-side outputs. Everything the core computes\n  // reaches the fetch address or a store, so the datapath stays in the\n  // netlist; logic that only drives RVFI (a verification port a deployed\n  // core would not have) is pruned and does not count toward Fmax or area.\n  assign led = ^{imem_addr, dmem_addr, dmem_wdata, dmem_wen, dmem_ren, dmem_rdata};\n\nendmodule\n.gitignore:88:cores/*/experiments/hypotheses/\tcores/bench/experiments/hypotheses/hyp-20261119-003-r3s2.yaml\ntotal 20\ndrwxrwx---+ 2 nobody    nogroup   4096 Nov 19 16:00 .\ndrwxrwx---+ 3 nobody    nogroup   4096 Nov 19 15:56 ..\n-rw-rw----+ 1 hwebench2 hwebench2 4079 Nov 19 16:00 hyp-20261119-003-r3s2.yaml\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/bash -c 'cd \"$TMPDIR/predictor.ycL9kF\"\ncp -r rtl runahead\npython - <<'\"'PY'\nfrom pathlib import Path\nr=Path('runahead')\ndef change(filename, edits):\n p=r/filename\n s=p.read_text()\n for old,new,count in edits:\n  assert old in s, old\n  s=s.replace(old,new,count)\n p.write_text(s)\nchange('core_pkg.sv',[\n ('  // IF -> ID combinational bundle (no register; PC reg sits in if_stage).','  // Selected fetch queue head or live response.',1),\n ('    logic [31:0] pc_plus4;','    logic [31:0] pc_plus4;\\\\n    logic [31:0] predicted_pc;',2),\n])\nchange('core.sv',[\n ('logic       fetch_ready, hold_id;', 'logic       fetch_ready, fetch_head_valid, hold_id;',1),\n ('.advance_fetch   (fetch_ready && \"'!hold_id),'\"','.consume_head    (fetch_ready && \"'!hold_id),'\"\\\\n    .imem_ready      (io_imemReady),\\\\n    .head_valid      (fetch_head_valid),',1),\n ('    .fetch_pc        (io_imemAddr),\\\\n','',1),\n ('.imem_ready     (io_imemReady),','.head_valid     (fetch_head_valid),',1),\n])\nchange('hazard_unit.sv', [('imem_ready','head_valid',-1)])\nchange('id_stage.sv',[\n ('      reg_q.pc_plus4      <= in.pc_plus4;','      reg_q.pc_plus4      <= in.pc_plus4;\\\\n      reg_q.predicted_pc  <= in.predicted_pc;',1),\n])\nchange('ex_stage.sv',[\n ('  input  logic [31:0]        fetch_pc,\\\\n','',1),\n ('fetch_pc ==','in.predicted_pc ==',2),\n])\nchange('if_stage.sv',[\n ('  input  logic              advance_fetch,','  input  logic              consume_head,\\\\n  input  logic              imem_ready,\\\\n  output logic              head_valid,',1),\n ('  logic [31:0] pc;', '''  localparam int DEPTH = \"'`QUEUE_DEPTH;\n  localparam int COUNT_WIDTH = $clog2(DEPTH+1);\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic [31:0] predicted_pc;\n  } packet_t;\n\n  logic [COUNT_WIDTH-1:0] count;\n  logic empty, pop, push, refill;\n  logic [COUNT_WIDTH-1:0] append_index;\n  packet_t fifo [DEPTH];\n  packet_t incoming, head;\n\n  logic [31:0] pc;'\"''',1),\n ('  logic [30:0] btb_entry [0:31]; // {tag, word target}','  logic [12:0] btb_tag [0:31];\\\\n  logic [17:0] btb_target [0:31];',1),\n ('  logic [12:0] fetch_tag;','  logic [4:0] issue_index;\\\\n  logic issue_in_range;',1),\n ('  assign {fetch_tag, fetch_target} = btb_entry[fetch_index];','  assign fetch_target = btb_target[fetch_index];',1),\n ('fetch_tag == pc[19:7]','btb_tag[fetch_index] == pc[19:7]',1),\n ('  assign same_index_write = btb_update.write_counter && write_index == fetch_index;', '''  assign issue_index = head.pc[6:2];\n  assign issue_in_range = head.pc[31:20] == 12'b0 && head.pc[1:0] == 2'b00;\n  assign same_index_write = btb_update.write_counter && write_index == issue_index;\n\n  assign empty = count == 0;\n  assign head_valid = \"'!empty || imem_ready;\n  assign refill = imem_ready && (count < COUNT_WIDTH'\"'(DEPTH) || consume_head);\n  assign pop = \"'!empty && consume_head;\n  assign push = refill && (!empty || !consume_head);\n  assign append_index = pop ? count - 1'\"'b1 : count;\n  assign incoming = {pc, imem_data, predicted_pc};\n  assign head = empty ? incoming : fifo[0];\n\n  always_ff @(posedge clock) begin\n    if (reset || redirect) begin\n      count <= '0;\n    end else begin\n      case ({push, pop})\n        2'b01: count <= count - 1'b1;\n        2'b10: count <= count + 1'b1;\n        default: ;\n      endcase\n    end\n  end\n\n  for (genvar idx = 0; idx < DEPTH; idx++) begin : g_fifo\n    if (idx+1 < DEPTH) begin : g_shift\n      always_ff @(posedge clock) begin\n        if (push && append_index == COUNT_WIDTH'(idx))\n          fifo[idx] <= incoming;\n        else if (pop)\n          fifo[idx] <= fifo[idx+1];\n      end\n    end else begin : g_last\n      always_ff @(posedge clock) begin\n        if (push && append_index == COUNT_WIDTH'(idx))\n          fifo[idx] <= incoming;\n      end\n    end\n  end''',1),\n ('else if (advance_fetch) pc <= predicted_pc;','else if (refill)        pc <= predicted_pc;',1),\n ('    if (\"'!reset && btb_update.write_target)'\"\\\\n      btb_entry[write_index] <= {write_tag, btb_update.target_word};','    if (\"'!reset && btb_update.write_target) begin'\"\\\\n      btb_tag[write_index] <= write_tag;\\\\n      btb_target[write_index] <= btb_update.target_word;\\\\n    end',1),\n ('    out.pc       = pc;\\\\n    out.pc_plus4 = pc_plus4;\\\\n    out.instr    = imem_data;', '''    out.pc           = head.pc;\n    out.pc_plus4     = head.pc + 32'd4;\n    out.instr        = head.instr;\n    out.predicted_pc = head.predicted_pc;''',1),\n ('    out.btb_hit = same_index_write ? fetch_in_range && write_tag == pc[19:7] : hit;\\\\n    out.btb_counter = same_index_write ? btb_update.counter : counter;', '''    out.btb_hit = issue_in_range && (same_index_write\n                ? write_tag == head.pc[19:7]\n                : btb_valid[issue_index] && btb_tag[issue_index] == head.pc[19:7]);\n    out.btb_counter = same_index_write ? btb_update.counter : btb_counter[issue_index];''',1),\n])\nPY\ncat > run-depth.sh <<'EOF'\n#\"'!/usr/bin/env bash\nset -euo pipefail\ndepth=$1\nverilator -DQUEUE_DEPTH=\"$depth\" --cc --exe --build -j 3 -Mdir \"$PWD/obj-$depth\" \"+incdir+$PWD/runahead\" --top-module core -Wno-fatal -CFLAGS \"-DNRET=1\" \"$PWD/runahead/core_pkg.sv\" \"$PWD/runahead/\"*.sv \"$2\" -o cosim_sim > \"build-$depth.log\" 2>&1\n\"$PWD/obj-$depth/cosim_sim\" \"$PWD/coremark.elf\" 50000000 --bench --istall --dstall > \"result-$depth.jsonl\"\nEOF\nfor depth in 1 2 4 8; do\n  bash run-depth.sh \"$depth\" \"$OLDPWD/test/cosim/main.cpp\" &\ndone\nwait\npython - <<'\"'PY'\nimport glob,json\nfor f in sorted(glob.glob('result-*.jsonl')):\n r = json.loads(open(f).read().splitlines()[-1])\n print(f,r['bench_stop_cycle']-r['bench_start_cycle'],r['ebreak'],r['oob'], '0xfcaf' in r['uart'] and 'Correct operation validated.' in r['uart'])\nPY\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
