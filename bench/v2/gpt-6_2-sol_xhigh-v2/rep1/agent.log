{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c 'set -e\nradix_dir=$(mktemp -d \"$TMPDIR/bench-r15s0-radix.XXXXXX\")\nmkdir -p \"$radix_dir/cores/bench\"\ncp -r Makefile bench fpga test tools \"$radix_dir\"\ncp -r cores/bench/rtl cores/bench/core.yaml cores/bench/test \"$radix_dir/cores/bench\"\npython3 - \"$radix_dir\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\npath = Path(sys.argv[1]) / 'cores/bench/rtl/alu.sv'\ntext = path.read_text()\ntext = text.replace('  logic [33:0] triple_divisor_q;', '''  logic [33:0] triple_divisor_q;\n  logic [35:0] five_divisor_q, seven_divisor_q, nine_divisor_q;\n  logic [35:0] eleven_divisor_q, thirteen_divisor_q, fifteen_divisor_q;''')\ntext = text.replace('after_radix4_b;', 'after_radix16;', 1)\nmarker = '  assign signed_div = op == ALU_DIV || op == ALU_REM;'\nradix = '''  logic [35:0] d1, d2, d4, d8, d16;\n  logic [35:0] multiple [1:15];\n  logic [36:0] trial [1:15];\n  logic [15:0] choose_digit;\n  logic [31:0] radix16_remainder;\n  logic [3:0] radix16_digit;\n\n  function automatic [35:0] add_three(input logic [35:0] x, y, z);\n    add_three = (x \"'^ y ''^ z) + (((x & y) | (x & z) | (y & z)) << 1);\n  endfunction\n\n  assign d1 = {4'\"'b0, divisor_q};\n  assign d2 = d1 << 1;\n  assign d4 = d1 << 2;\n  assign d8 = d1 << 3;\n  assign d16 = d1 << 4;\n\n  assign multiple[1] = d1;\n  assign multiple[2] = d2;\n  assign multiple[3] = {2'b0, triple_divisor_q};\n  assign multiple[4] = d4;\n  assign multiple[5] = five_divisor_q;\n  assign multiple[6] = multiple[3] << 1;\n  assign multiple[7] = seven_divisor_q;\n  assign multiple[8] = d8;\n  assign multiple[9] = nine_divisor_q;\n  assign multiple[10] = multiple[5] << 1;\n  assign multiple[11] = eleven_divisor_q;\n  assign multiple[12] = multiple[3] << 2;\n  assign multiple[13] = thirteen_divisor_q;\n  assign multiple[14] = multiple[7] << 1;\n  assign multiple[15] = fifteen_divisor_q;\n\n  for (genvar k = 1; k <= 15; k++) begin : radix16_trial\n    assign trial[k] = {1'b0, partial_q[63:28]} - {1'b0, multiple[k]};\n  end\n\n  assign choose_digit[0] = trial[1][36];\n  assign choose_digit[15] = \"'!trial[15][36];\n  for (genvar k = 1; k < 15; k++) begin : digit_choice\n    assign choose_digit[k] = !trial[k][36] && trial[k+1][36];\n  end\n\n  for (genvar i = 0; i < 32; i++) begin : remainder_bit\n    logic [15:0] terms;\n    assign terms[0] = choose_digit[0] && partial_q[28+i];\n    for (genvar k = 1; k <= 15; k++) begin : digit_term\n      assign terms[k] = choose_digit[k] && trial[k][i];\n    end\n    assign radix16_remainder[i] = |terms;\n  end\n\n  for (genvar i = 0; i < 4; i++) begin : digit_bit\n    logic [15:0] terms;\n    for (genvar k = 0; k <= 15; k++) begin : digit_term\n      if ((k & (1 << i)) != 0)\n        assign terms[k] = choose_digit[k];\n      else\n        assign terms[k] = 1'\"'b0;\n    end\n    assign radix16_digit[i] = |terms;\n  end\n\n'''\ntext = text.replace(marker, radix + marker)\ntext = text.replace('  assign after_radix4_b = radix4_step(after_radix4_a, divisor_q, triple_divisor_q);',\n                    '  assign after_radix16 = {radix16_remainder, partial_q[27:0], radix16_digit};')\nmarker = \\\"      triple_divisor_q <= {2'b0, divisor_q} + {1'b0, divisor_q, 1'b0};\\\"\ntext = text.replace(marker, marker + '''\n      five_divisor_q     <= d4 + d1;\n      seven_divisor_q    <= d8 - d1;\n      nine_divisor_q     <= d8 + d1;\n      eleven_divisor_q   <= add_three(d8, d2, d1);\n      thirteen_divisor_q <= add_three(d8, d4, d1);\n      fifteen_divisor_q  <= d16 - d1;''')\ntext = text.replace('partial_q <= after_radix4_b;', 'partial_q <= after_radix16;')\npath.write_text(text)\nPY\nprintf '%s\\\\n' \\\"\"'$radix_dir\"\ncd \"$radix_dir\" && make lint TARGET=bench'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
