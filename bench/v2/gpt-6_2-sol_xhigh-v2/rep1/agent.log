\n            elif bits == 0xffffffffffffffff:\n                logic += f\\\"  assign by_small_divisor[{divisor}][{bit}] = 1'b1;\\\\n\\\"\n            else:\n                logic += f\\\"  localparam logic [63:0] SMALL_D{divisor}_BIT{bit} = 64'h{bits:016x};\\\\n\\\"\n                logic += f\\\"  assign by_small_divisor[{divisor}][{bit}] = SMALL_D{divisor}_BIT{bit}[numerator];\\\\n\\\"\n    logic += \\\"\\\"\\\"\n  for (genvar b = 0; b < 12; b++) begin : select_small_prefix\n    logic [7:0] bits_to_select;\n    for (genvar d = 0; d < 8; d++) begin : small_candidate\n      assign bits_to_select[d] = (divisor_low[2:0] == 3'(d)) && by_small_divisor[d][b];\n    end\n    assign small_result[b] = |bits_to_select;\n  end\n  assign medium_valid[0] = 1'b1;\n  assign medium_trial_low[0] = numerator;\n  for (genvar d = 1; d < 8; d++) begin : medium_trial\n    logic [9:0] multiple;\n    /* verilator lint_off UNUSEDSIGNAL */\n    logic [9:0] difference;\n    /* verilator lint_on UNUSEDSIGNAL */\n    assign multiple = 10'(d) * {4'b0, divisor_low};\n    assign difference = {4'b0, numerator} - multiple;\n    assign medium_valid[d] = \"'!difference[9];\n    assign medium_trial_low[d] = difference[5:0];\n  end\n  assign medium_select = medium_valid & ~{1'\"'b0, medium_valid[7:1]};\n  for (genvar b = 0; b < 6; b++) begin : select_medium_remainder\n    logic [7:0] bits_to_select;\n    for (genvar d = 0; d < 8; d++) begin : medium_candidate\n      assign bits_to_select[d] = medium_select[d] && medium_trial_low[d][b];\n    end\n    assign medium_remainder[b] = |bits_to_select;\n  end\n  assign medium_quotient = {|(medium_select & 8'hf0),\n                            |(medium_select & 8'hcc),\n                            |(medium_select & 8'haa)};\n  assign medium_result = {medium_remainder, 3'b0, medium_quotient};\n  assign prefix_result = (|divisor_q[31:6]) ? {numerator, 6'b0}\n                       : (|divisor_low[5:3]) ? medium_result\n                       : small_result;\n  as