{"type": "item.started", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\n\nrtl = Path('cores/bench/rtl')\ndef edit(file, pairs):\n    path = rtl / file\n    s = path.read_text()\n    for old, new in pairs:\n        assert s.count(old) == 1, (file, old, s.count(old))\n        s = s.replace(old, new, 1)\n    path.write_text(s)\n\nedit('core_pkg.sv', [\n    ('  } if_id_t;', '''    logic [31:0] predicted_pc;\n    logic        predicted_pc_valid;\n    logic        valid;\n  } if_id_t;'''),\n    ('    logic        valid;\\\\n  } id_ex_t;', '''    logic [31:0] predicted_pc;\n    logic        predicted_pc_valid;\n    logic        fence_i;\n    logic        valid;\n  } id_ex_t;'''),\n])\nedit('id_stage.sv', [\n    ('      reg_q.btb_hit', '''      reg_q.predicted_pc <= in.predicted_pc;\n      reg_q.predicted_pc_valid <= in.predicted_pc_valid;\n      reg_q.fence_i       <= in.instr[6:0] == 7'b0001111 && in.instr[14:12] == 3'd1;\n      reg_q.btb_hit'''),\n])\nedit('core.sv', [\n    ('    .advance_fetch   (fetch_ready && \"'!hold_id),'\"', '''    .issue           (fetch_ready && \"'!hold_id),\n    .imem_ready      (io_imemReady),'\"'''),\n    ('    .fetch_pc        (io_imemAddr),\\\\n',''),\n    ('    .imem_ready     (io_imemReady),','    .imem_ready     (if_id_w.valid),'),\n])\nedit('ex_stage.sv', [\n    ('  input  logic [31:0]        fetch_pc,\\\\n',''),\n    ('  assign match_fallthrough = fetch_pc == in.pc_plus4;\\\\n  assign match_target = fetch_pc == target;', '''  assign match_fallthrough = in.predicted_pc == in.pc_plus4;\n  assign match_target = in.predicted_pc == target;'''),\n    ('  assign redirect = ex_ready && \"'!stall && !(take_target ? match_target : match_fallthrough);'\"', '''  assign redirect = ex_ready && \"'!stall &&\n                    (in.fence_i || !in.predicted_pc_valid ||\n                     !(take_target ? match_target : match_fallthrough));'\"'''),\n])\n\n(rtl / 'if_stage.sv').write_text('''// IF walks the BTB path while ID consumes an independent response queue.\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              issue,\n  input  logic              imem_ready,\n  input  logic              redirect,\n  input  logic [31:0]       redirect_target,\n  input  btb_update_t       btb_update,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  logic [31:0] pc, pc_plus4, predicted_pc;\n  logic [4:0] fetch_index, issue_index, write_index;\n  logic [12:0] write_tag, issue_tag;\n  logic fetch_in_range, issue_in_range, predict_taken, same_index_write;\n\n  logic [31:0] btb_valid;\n  logic [12:0] btb_tag [0:31];\n  logic [17:0] btb_target [0:31];\n  logic [1:0] btb_counter [0:31];\n\n  assign fetch_index = pc[6:2];\n  assign fetch_in_range = pc[31:20] == 12'b0 && pc[1:0] == 2'b00;\n  assign predict_taken = fetch_in_range && btb_valid[fetch_index] &&\n                         btb_tag[fetch_index] == pc[19:7] && btb_counter[fetch_index][1];\n  assign pc_plus4 = pc + 32'd4;\n  assign predicted_pc = predict_taken ? {12'b0, btb_target[fetch_index], 2'b00} : pc_plus4;\n\n  assign {write_tag, write_index} = btb_update.pc_word;\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      btb_valid <= '0;\n    else if (btb_update.write_target)\n      btb_valid[write_index] <= 1'b1;\n\n    if (\"'!reset && btb_update.write_target) begin\n      btb_tag[write_index] <= write_tag;\n      btb_target[write_index] <= btb_update.target_word;\n    end\n    if (!reset && btb_update.write_counter)\n      btb_counter[write_index] <= btb_update.counter;\n  end\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n  } packet_t;\n  packet_t queue_q [0:3];\n  logic [2:0] count_q, tail_index;\n  logic queued, has_second, receive, enqueue, dequeue;\n  logic park, parked_q;\n  logic [31:0] issue_pc, issue_instr, issue_prediction;\n\n  assign queued = count_q != 3'\"'d0;\n  assign has_second = count_q > 3'd1;\n  assign dequeue = queued && issue;\n  assign receive = imem_ready && \"'!parked_q && (count_q != 3'\"'d4 || dequeue);\n  assign enqueue = receive && (queued || \"'!issue);\n  assign tail_index = count_q - {2'\"'b0, dequeue};\n  assign park = pc == 32'h000f_fffc && \"'!predict_taken;\n\n  assign issue_pc = queued ? queue_q[0].pc : pc;\n  assign issue_instr = queued ? queue_q[0].instr : imem_data;\n  assign issue_prediction = has_second ? queue_q[1].pc : (queued ? pc : predicted_pc);\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= '\"'0;\n      parked_q <= 1'b0;\n      count_q <= '0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      parked_q <= 1'b0;\n      count_q <= '0;\n    end else begin\n      if (receive) begin\n        if (park)\n          parked_q <= 1'b1;\n        else\n          pc <= predicted_pc;\n      end\n      case ({enqueue, dequeue})\n        2'b10: count_q <= count_q + 3'd1;\n        2'b01: count_q <= count_q - 3'd1;\n        default: ;\n      endcase\n    end\n  end\n\n  for (genvar i = 0; i < 4; i++) begin : g_queue\n    always_ff @(posedge clock) begin\n      if (enqueue && tail_index == 3'(i))\n        queue_q[i] <= {pc, imem_data};\n      else if (i < 3 && dequeue) begin\n        if (i < 3)\n          queue_q[i] <= queue_q[i+1];\n      end\n    end\n  end\n\n  assign issue_index = issue_pc[6:2];\n  assign issue_tag = issue_pc[19:7];\n  assign issue_in_range = issue_pc[31:20] == 12'b0 && issue_pc[1:0] == 2'b00;\n  assign same_index_write = btb_update.write_counter && write_index == issue_index;\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc       = issue_pc;\n    out.pc_plus4 = issue_pc + 32'd4;\n    out.instr    = issue_instr;\n    out.valid    = queued || (imem_ready && \"'!parked_q);\n    out.predicted_pc = issue_prediction;\n    out.predicted_pc_valid = has_second || (queued ? !parked_q : !park);\n    out.btb_hit = issue_in_range && (same_index_write ? write_tag == issue_tag\n                                : (btb_valid[issue_index] && btb_tag[issue_index] == issue_tag));\n    out.btb_counter = same_index_write ? btb_update.counter : btb_counter[issue_index];\n  end\nendmodule\n'\"''')\nPY\nmake lint TARGET=bench\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
