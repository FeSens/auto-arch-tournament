valid_q, have_word, accepted, fill_target, learn_target_q;\n  logic [31:0] prefetched_word_q, candidate_insn;\n\n  assign recover_target = fetch_resolution.valid && fetch_resolution.take_target\n                       && \"'!fetch_resolution.match_target;\n  assign recover_fallthrough = fetch_resolution.valid && !fetch_resolution.take_target\n                            && !fetch_resolution.match_fallthrough;\n  assign squash_candidate = recover_target || recover_fallthrough;\n\n  assign pc = ({32{recover_target}} & fetch_resolution.target)\n            | ({32{recover_fallthrough}} & fetch_resolution.fallthrough)\n            | ({32{!squash_candidate}} & request_q);\n  assign successor_pc = request_q;\n  assign successor_valid = !parked_q;\n\n  assign target_index = request_q[BTIC_BITS+1:2];\n  assign replay_target = !squash_candidate && !parked_q && target_predicted_q\n                      && target_valid_q[target_index]\n                      && target_tag[target_index] == request_q[19:BTIC_BITS+2];\n  assign use_prefetch = !squash_candidate && !parked_q && prefetched_valid_q;\n  assign have_word = replay_target || use_prefetch;\n  assign can_look_ahead = have_word && pc != 32'\"'h000ffffc;\n  assign imem_addr = can_look_ahead ? request_plus4 : pc;\n\n  assign candidate_insn = use_prefetch ? prefetched_word_q\n                        : replay_target ? target_insn[target_index] : imem_data;\n  assign candidate_valid = have_word || (fetch_ready && (\"'!parked_q || squash_candidate));\n  assign accepted = candidate_valid && issue_ready;\n\n  assign park_next = pc == 32'\"'h000ffffc && \"'!predict_taken;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      request_q <= '\"'0;\n      parked_q <= 1'b0;\n      target_predicted_q <= 1'b0;\n      prefetched_valid_q <= 1'b0;\n    end else if (accepted) begin\n      request_q <= park_next ? pc : predicted_pc;\n      parked_q <= park_next;\n      target_predicted_q <= predict_taken;\n      prefetched_valid_q <= can_look_ahead && fetch_ready && \"'!predict_taken;\n    end else if (squash_candidate) begin\n      request_q <= pc;\n      parked_q <= 1'\"'b0;\n      target_predicted_q <= 1'b0;\n      prefetched_valid_q <= 1'b0;\n    end\n\n    if (accepted && can_look_ahead && fetch_ready && \"'!predict_taken)\n      prefetched_word_q <= imem_data;\n  end\n\n  // A resolved taken instruction identifies the architectural target even\n  // if recovery selected it. Remember that target through a bus hold.\n  always_ff @(posedge clock) begin\n    if (reset || accepted)\n      learn_target_q <= 1'\"'b0;\n    else if (fetch_resolution.valid)\n      learn_target_q <= fetch_resolution.take_target;\n  end\n  logic [BTIC_BITS-1:0] fill_index;\n  assign fill_index = pc[BTIC_BITS+1:2];\n  assign fill_target = accepted && in_range && \"'!replay_target\n                    && (fetch_resolution.valid ? fetch_resolution.take_target : learn_target_q);\n  always_ff @(posedge clock) begin\n    if (reset || fetch_resolution.fence_i)\n      target_valid_q <= '\"'0;\n    else if (fill_target)\n      target_valid_q[fill_index] <= 1'b1;\n    if (\"'!reset && fill_target) begin\n      target_tag[fill_index] <= pc[19:BTIC_BITS+2];\n      target_insn[fill_index] <= candidate_insn;\n    end\n  end\n\n  always_comb begin\n    out.pc       = pc;\n    out.pc_plus4 = request_plus4;\n    out.instr    = candidate_insn;\n  end\n\n  logic [4:0] fetch_index, write_index;'\"''' + preserved_btb + 'endmodule\\\\n'\nif_file.write_text(new_text)\n\np = rtl / 'core_pkg.sv'\ns = p.read_text()\ns = s.replace('    logic        take_target;\\\\n', '    logic        take_target;\\\\n    logic        fence_i;\\\\n')\np.write_text(s)\np = rtl / 'ex_stage.sv'\ns = p.read_text()\ns = s.replace('    fetch_resolution.valid             <= \"'!reset && advance;'\"', '    fetch_resolution.valid             <= \"'!reset && advance;'\"\\\\n    fetch_resolution.fence_i           <= \"'!reset && advance && in.ctrl.is_fence_i;'\"')\np.wr