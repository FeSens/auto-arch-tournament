-$FORMAL_WORK_ID\"\n56:        try=\"$(mktemp -u \"$RISCV_FORMAL/cores/$CORE_NAME-wXXXXXXXX\")\"\n60:        echo \"ERROR: could not create a work dir under $RISCV_FORMAL/cores\" >&2\n79:# are both unset and $1 (checks-cfg-path) wasn't given either. Explicit\n98:        CHECKS_CFG=\"$SCRIPT_DIR/checks_si.cfg\"\n99:        echo \"[run_all.sh] auto-detected nret=1 from $CORE_YAML; using wrapper_si.sv + checks_si.cfg\"\n103:CHECKS_CFG=\"${CHECKS_CFG:-${1:-$SCRIPT_DIR/checks.cfg}}\"\n106:    echo \"ERROR: checks.cfg not found at $CHECKS_CFG\"\n114:if [ ! -d \"$RISCV_FORMAL\" ]; then\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n147:# Truncate the run log; genchecks + make are tee'd here in full.\n150:# Stage rtl + wrapper + the chosen checks config under the framework's\n151:# expected layout. genchecks.py looks for \"checks.cfg\" by name, so the\n156:# previous run, and genchecks/yosys silently picks up the old file\n163:# Stage checks.cfg with [verilog-files] auto-derived from actual rtl/\n164:# contents instead of the cfg's hardcoded list. The shipped checks.cfg\n170:STAGED_CFG=\"$CORE_DIR/checks.cfg\"\n185:# genchecks.py derives @core@ from the cwd's basename (genchecks.py:39),\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n190:rm -rf checks/\n191:echo \"=== genchecks ===\" | tee -a \"$LOG\"\n192:python3 ../../checks/genchecks.py >> \"$LOG\" 2>&1\n193:cd checks\n198:# going past per-check errors so the .sby tally below sees every result\n199:# (NRET=2 means a few `_ch1` checks may PREUNSAT-error on single-issue\n200:# cores; without -k make stops on first error and 95+ checks never run,\n214:        # Vacuous pass on channel-1 checks. NRET=2 contract: when a\n229:    FAILED+=(\"no_checks_generated\")\n236:    # Surface the FIRST failing check's logfile tail. tools/eval/formal.py\n248:    echo \"Per-check logs in: $CORE_DIR/checks/<check>/logfile.txt\"\n.gitignore:88:cores/*/experiments/hypotheses/\tcores/bench/experiments/hypotheses/hyp-20261119-002-r13s1.yaml\n","exit_code":0,"status":"completed"}}
