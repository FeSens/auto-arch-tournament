{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"set -o pipefail\npython3 -c '\nfrom pathlib import Path\nimport re\nimport subprocess\nimport tempfile\n\npath = \\\"cores/bench/rtl/alu.sv\\\"\noriginal = subprocess.check_output([\\\"git\\\", \\\"show\\\", \\\"HEAD:\\\" + path], text=True)\nupdated = Path(path).read_text()\n\ndef function(source, name):\n    return re.search(r\\\"(?m)\"'^  function automatic [''^'\"\\\\n]*\\\\b\\\" + name + r\\\"\\\\(.*?\"'^  endfunction\", source, re.S | re.M)[0]\n\nwith tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".sv\", prefix=\"divider-lookahead-proof-\") as miter:\n    print(\"module divider_step_miter(input [63:0] partial, input [31:0] divisor_q, input [33:0] triple_divisor_q, output ordered, output step_match, output next_select_match);\", file=miter)\n    print(\"wire [63:0] partial_q = ~partial;\", file=miter)\n    print(re.search(r\"  typedef logic .*? radix4_trials_t;\", updated)[0], file=miter)\n    print(\"radix4_trials_t trials_a_bar, trials_b_bar;\", file=miter)\n    print(\"wire [63:0] after_radix4_a_bar, after_radix4_b_bar; wire [3:0] select_a, select_b, select_b_by_trial [0:3];\", file=miter)\n    print(function(original, \"radix4_step\").replace(\"radix4_step\", \"original_step\"), file=miter)\n    for name in (\"trial_eligible\", \"radix4_select\", \"radix4_trials\", \"radix4_step\"):\n        print(function(updated, name), file=miter)\n    print(re.search(r\"(?s)  assign trials_a_bar = .*?assign after_radix4_b_bar = .*?;\", updated)[0], file=miter)\n    print(\"assign ordered = triple_divisor_q == ({2'\"\\\\x27b0, divisor_q} + {1\\\\x27b0, divisor_q, 1\\\\x27b0});\\\", file=miter)\n    print(\\\"wire [63:0] expected = ~original_step(partial, divisor_q, triple_divisor_q);\\\", file=miter)\n    print(\\\"assign step_match = expected == after_radix4_a_bar;\\\", file=miter)\n    print(\\\"assign next_select_match = select_b == radix4_select(after_radix4_a_bar[63: