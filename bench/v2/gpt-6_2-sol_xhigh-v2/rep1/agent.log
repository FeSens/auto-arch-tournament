{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c 'scratch_probe_dir=\"$TMPDIR/bench-jalr.XMasdj\"\npython3 - \"$scratch_probe_dir\" <<'\"'PY'\nfrom collections import Counter\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nroot = Path.cwd()\nexe = Path(sys.argv[1]) / 'champion/obj_dir/cosim_sim'\nelf = root.parents[3] / 'bench/programs/coremark.elf'\nprocess = subprocess.Popen([str(exe), str(elf), '50000000', '--istall', '--dstall'],\n                           stdout=subprocess.PIPE)\ncounts = Counter()\ninside = False\nfor row in process.stdout:\n    if not row.startswith(b'{\\\"order\\\":'):\n        continue\n    insn = int(row.split(b'\\\"insn\\\":', 1)[1].split(b',', 1)[0])\n    opcode = insn & 127\n    if opcode == 0x23:\n        addr = int(row.split(b'\\\"mem_addr\\\":', 1)[1].split(b',', 1)[0])\n        if addr == 0x10000100:\n            inside = True\n        elif addr == 0x10000104:\n            break\n    elif inside and opcode == 0x67:\n        counts[insn >> 20] += 1\nprocess.stdout.close()\nprocess.wait(timeout=5)\nprint(counts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
