{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path.cwd()\nreference = root / \\\"rtl_ref\\\"\noriginal = (reference / \\\"if_stage.sv\\\").read_text()\ndest = root / \\\"rtl_spec_replay\\\"\nshutil.copytree(reference, dest, dirs_exist_ok=True)\nrtl = original.replace(\n    \\\"  logic [31:0] pc, normal_pc_q, normal_pc_d;\\\",\n    \\\"\\\"\\\"  logic [31:0] pc, normal_pc_q, normal_pc_d;\n  logic [11:2] replay_pc_d;\n  logic        speculate_read, replay_read_aligned_q;\\\"\\\"\\\",\n)\nspot = rtl.index(\\\"  always_ff @(posedge clock) begin\\\\n    normal_pc_q <= normal_pc_d;\\\")\nrtl = rtl[:spot] + \\\"\\\"\\\"  // Read the predicted successor before knowing whether the current\n  // replay word is available. A held miss marks an unaligned read.\n  assign speculate_read = ordinary_can_advance && \"'!(replay_collision && !imem_ready)\n                         && !(ordinary_last && !predict_taken);\n  for (genvar bit_index = 2; bit_index < 12; bit_index++) begin : replay_pc_bit\n    assign replay_pc_d[bit_index] = |{\n      (ordinary_active && !speculate_read) & normal_pc_q[bit_index],\n      (speculate_read && !predict_taken) & ordinary_plus4[bit_index],\n      (speculate_read && predict_on_table) & table_target[bit_index],\n      (speculate_read && predict_on_bypass) & bypass_target[bit_index],\n      select_target & fetch_resolution.target[bit_index],\n      select_target_plus4 & target_plus4[bit_index],\n      select_fallthrough & fetch_resolution.fallthrough[bit_index],\n      select_fallthrough_plus4 & fallthrough_plus4[bit_index]\n    };\n  end\n  always_ff @(posedge clock)\n    replay_read_aligned_q <= !speculate_read || ordinary_available;\n\n\"\"\" + rtl[spot:]\nrtl = rtl.replace(\"assign replay_hit = replay_eligible && replay_slot_valid;\", \"assign replay_hit = replay_read_aligned_q && replay_eligible && replay_slot_valid;\")\nrtl = rtl.replace(\"replay_entry[normal_pc_d[11:2]]\", \"replay_entry[replay_pc_d]\")\nrtl = rtl.replace(\"replay_valid_slots[normal_pc_d[11:7]]\", \"replay_valid_slots[replay_pc_d[11:7]]\")\n(dest / \"if_stage.sv\").write_text(rtl)\n\ndest2 = root / \"rtl_spec_replay_group\"\nshutil.copytree(dest, dest2, dirs_exist_ok=True)\n(dest2 / \"ex_stage.sv\").write_text((root / \"cores/bench/rtl/ex_stage.sv\").read_text())\nPY\npython3 -u - <<'\"'PY'\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom tools.eval.gowin import build\n\nroot = Path.cwd()\nplans = [(variant, option) for variant in (\\\"rtl_spec_replay\\\", \\\"rtl_spec_replay_group\\\") for option in (0,1)]\nwith ThreadPoolExecutor(max_workers=4) as pool:\n    futures = {pool.submit(build, root, root / variant, \\\"fpga/core_bench_si.sv\\\", option,\n                           root / \\\"measurements\\\" / variant / f\\\"opt{option}\\\"): (variant, option)\n               for variant, option in plans}\n    for future in as_completed(futures):\n        result = future.result()\n        print(futures[future], result.get(\\\"fmax_mhz\\\"), result.get(\\\"logic\\\"), result.get(\\\"critical_paths\\\", [])[:2], result.get(\\\"reason\\\"))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
