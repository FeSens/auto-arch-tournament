{"type": "item.started", "item": {"id": "item_45", "type": "command_execution", "command": "/bin/bash -c 'scratch_dir=/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U\npython - \"$scratch_dir\" <<'\"'PY'\nimport shutil\nimport sys\nfrom pathlib import Path\nroot=Path(sys.argv[1])\nfor name, src in ((\\\"classic\\\", Path('cores/bench/rtl')), (\\\"packed\\\", root/'validonly4096'/'rtl'), (\\\"joined\\\", root/'zero-late'/'rtl')):\n    dest=root/f'isolated-{name}'/'rtl'\n    shutil.copytree(src,dest)\n    def edit(name, fn):\n        p=dest/f'{name}.sv'\n        p.write_text(fn(p.read_text()))\n    edit('core', lambda d:d.replace(\\\"logic        fetch_ready, hold_id;\\\", \\\"logic        fetch_ready, hold_id, hold_ordinary, raw_id_valid;\\\")\n      .replace(\\\"  // ── IF\\\", \\\"  assign hold_id = squash_candidate ? stall_ex_mem : hold_ordinary;\\\\n\\\\n  // ── IF\\\", 1)\n      .replace(\\\"    .hold_id          (hold_id),\\\", \\\"    .hold_ordinary    (hold_ordinary),\\\\n    .hold_recovery    (stall_ex_mem),\\\")\n      .replace(\\\"    .fetch_ready      (fetch_ready),\\\\n    .squash_candidate (squash_candidate),\\\\n    .btb_update\\\", \\\"    .fetch_ready      (fetch_ready),\\\\n    .raw_valid        (raw_id_valid),\\\\n    .squash_candidate (squash_candidate),\\\\n    .btb_update\\\")\n      .replace(\\\"    .in               (id_ex_w),\\\", \\\"    .in               (id_ex_w),\\\\n    .raw_valid        (raw_id_valid),\\\")\n      .replace(\\\"    .hold_id        (hold_id),\\\", \\\"    .hold_id        (hold_ordinary),\\\"))\n    edit('id_stage', lambda d:d.replace(\\\"  output id_ex_t  out\\\", \\\"  output logic    raw_valid,\\\\n  output id_ex_t  out\\\")\n                                     .replace(\\\"  always_comb begin\\\\n    out = reg_q;\\\", \\\"  assign raw_valid = reg_q.valid;\\\\n\\\\n  always_comb begin\\\\n    out = reg_q;\\\"))\n    edit('ex_stage', lambda d:d.replace(\\\"  input  logic [31:0]        fetch_pc,\\\", \\\"  input  logic               raw_valid,\\\\n  input  logic [31:0]        fetch_pc,\\\")\n                                    .replace(\\\"assign div_wait = is_div && \"'!div_valid;\", \"assign div_wait = raw_valid && select_div && !div_valid;\"))\n    def rewrite_if(d):\n        d=d.replace(\"  input  logic              hold_id,\", \"  input  logic              hold_ordinary,'\"\\\\n  input  logic              hold_recovery,\\\")\n        d=d.replace(\\\"logic        advance_fetch, bus_fetch_ready, predict_taken, park_fallthrough;\\\", \\\"logic        advance_ordinary, advance_recovery, predict_taken, park_fallthrough;\\\\n  logic        replay_read_valid_q;\\\\n  logic [31:0] ordinary_next_pc, recovery_next_pc;\\\\n  logic        ordinary_ready, recovery_park;\\\")\n        d=d.replace(\\\"  assign fetch_index = pc[6:2];\\\", \\\"  assign fetch_index = normal_pc_q[6:2];\\\")\n        d=d.replace(\\\"assign fetch_in_range = pc[31:20] == 12'b0 && pc[1:0] == 2'b00;\\\", \\\"assign fetch_in_range = normal_pc_q[31:20] == 12'b0 && normal_pc_q[1:0] == 2'b00;\\\")\n        d=d.replace(\\\"pc[19:7]\\\", \\\"normal_pc_q[19:7]\\\")\n        a=d.index(\\\"  assign pc_plus4\\\")\n        b=d.index(\\\"  assign replay_collision\\\")\n        d=d[:a]+\\\"\\\"\\\"  assign pc_plus4 = pc + 32'd4;\n  assign predict_taken = hit && counter[1];\n  assign park_fallthrough = \"'!predict_taken && normal_pc_q == 32'\"'h000f_fffc;\n  assign predicted_pc = predict_taken ? {12'b0, predicted_target, 2'b00}\n                    : park_fallthrough ? normal_pc_q : normal_pc_q + 32'd4;\n  assign ordinary_ready = \"'!fetch_parked && (imem_ready || replay_hit);\n  assign fetch_ready = squash_candidate ? imem_ready : ordinary_ready;\n  assign advance_ordinary = ordinary_ready && !hold_ordinary;\n  assign advance_recovery = imem_ready && !hold_recovery;\n  assign recovery_park = pc == 32'\"'h000f_fffc;\n  assign recovery_next_pc = advance_recovery && \"'!recovery_park ? pc_plus4 : pc;\n  assign ordinary_next_pc = advance_ordinary ? predicted_pc : normal_pc_q;\n  assign normal_pc_d = reset ? '\"'0 : squash_candidate ? recovery_next_pc : ordinary_next_pc;\n  always_ff @(posedge clock) begin\n    normal_pc_q <= normal_pc_d;\n    replay_read_valid_q <= \"'!reset && !squash_candidate;\n    if (reset)\n      fetch_parked <= 1'\"'b0;\n    else if (squash_candidate)\n      fetch_parked <= advance_recovery && recovery_park;\n    else if (advance_ordinary)\n      fetch_parked <= park_fallthrough;\n  end\n\n\\\"\\\"\\\"+d[b:]\n        d=d.replace(\\\"replay_hit = replay_armed_q && \"'!squash_candidate && !fetch_parked\", \"replay_hit = replay_armed_q && replay_read_valid_q && !fetch_parked\")\n        d=d.replace(\"imem_ready && !hold_id'\"\\\\n                    && bus_fetch_ready && fetch_in_range && (replay_armed_q || recover_target);\\\", \\\"imem_ready && \"'!hold_ordinary'\"\\\\n                    && \"'!squash_candidate && !fetch_parked && fetch_in_range && replay_armed_q;\")\n        d=d.replace(\"replay_entry[normal_pc_d[\", \"replay_entry[ordinary_next_pc[\")\n        for sub in ('\"'11:2','19:12','13:2','19:14'):\n            d=d.replace(f\\\" pc[{sub}]\\\",f\\\" normal_pc_q[{sub}]\\\").replace(f\\\"{{pc[{sub}]\\\",f\\\"{{normal_pc_q[{sub}]\\\").replace(f\\\"[pc[{sub}]\\\",f\\\"[normal_pc_q[{sub}]\\\").replace(f\\\", pc[{sub}]\\\",f\\\", normal_pc_q[{sub}]\\\")\n        d=d.replace(\\\"(advance_fetch && predict_taken)\\\", \\\"(\"'!squash_candidate && advance_ordinary && predict_taken)\")\n        d=d.replace(\"out.btb_hit     = hit;\", \"out.btb_hit     = !squash_candidate && hit;\")\n        return d\n    edit('\"'if_stage', rewrite_if)\nPY\nfor model_name in classic packed joined; do\n  (\n    NRET=1 RTL_DIR=\\\"\"'$scratch_dir/isolated-$model_name/rtl\" OBJ_DIR=\"$scratch_dir/isolated-$model_name/sim\" MAKEFLAGS=-j2 bash test/cosim/build.sh > \"$scratch_dir/isolated-$model_name/sim.log\" 2>&1 &&\n    \"$scratch_dir/isolated-$model_name/sim/cosim_sim\" \"$scratch_dir/coremark.elf\" 50000000 --bench --istall --dstall > \"$scratch_dir/isolated-$model_name/coremark.log\"\n  ) &\ndone\nPYTHONDONTWRITEBYTECODE=1 python -u - <<'\"'PY' > \\\"\"'$scratch_dir/timing-isolated.log\" 2>&1 &\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.gowin import build, summarize\nroot = Path('\"'/srv/hwebench/tmp/7cb5c576/01e51730/tmp.HFinGAef6U')\njobs = [(name, opt) for name in ('classic','packed','joined') for opt in (0, 1, 2)]\ndef measure(job):\n    model, option = job\n    candidate = root / f'isolated-{model}'\n    result = build(Path.cwd(), candidate/'rtl', 'fpga/core_bench_si.sv', option, candidate/f'gowin_p{option}')\n    print(model, option, {key:result.get(key) for key in ('fmax_mhz','logic','bsram','reason')}, flush=True)\n    return model, result\nresults = {}\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    for model, result in executor.map(measure, jobs):\n        results.setdefault(model, []).append(result)\nfor model, placements in results.items():\n    print(model, summarize(placements), flush=True)\nPY\nwait\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
