{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c 'scratch=\"$TMPDIR/bench-r9s1-study\"\ncat > \"$scratch/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\nrtl = Path(sys.argv[1])\ndef change(name, replacements):\n    path = rtl / (name + '.sv')\n    src = path.read_text()\n    for old, new in replacements:\n        assert old in src, (name, old)\n        src = src.replace(old, new, 1)\n    path.write_text(src)\n\nchange('core_pkg', [\n    ('    logic [31:0] shift_result;\\\\n    logic [31:0] div_result;\\\\n    logic [31:0] mul_result;', '    logic [31:0] div_result;\\\\n    logic [31:0] late_a, late_b;\\\\n    logic [4:0] late_op;'),\n])\nchange('ex_stage', [\n    ('  input  logic [31:0]        fwd_shift,\\\\n', ''),\n    ('  input  logic [31:0]        fwd_mul,\\\\n', ''),\n    ('  output ex_mem_t             out,', '  output logic [31:0]        resolved_rs1, resolved_rs2,\\\\n  output logic               late_wait,\\\\n  output ex_mem_t             out,'),\n    ('             | ({32{fwd_rs1_sel.result.shift}} & fwd_shift)\\\\n', ''),\n    ('             | ({32{fwd_rs2_sel.result.shift}} & fwd_shift)\\\\n', ''),\n    ('             | ({32{fwd_rs1_sel.result.mul}}   & fwd_mul)\\\\n', ''),\n    ('             | ({32{fwd_rs2_sel.result.mul}}   & fwd_mul)\\\\n', ''),\n    ('  // ── ALU operand', '''  assign resolved_rs1 = rs1;\n  assign resolved_rs2 = rs2;\n  assign late_wait = in.valid && (fwd_rs1_sel.result.shift || fwd_rs1_sel.result.mul\n                               || fwd_rs2_sel.result.shift || fwd_rs2_sel.result.mul);\n\n  // ── ALU operand'''),\n    ('logic [31:0] other_result, add_result, shift_result, div_result, mul_result;',\n     'logic [31:0] other_result, add_result, div_result;'),\n    ('is_div && \"'!stall && !div_busy'\"', 'is_div && \"'!stall && !late_wait && !div_busy'\"'),\n    ('is_div && \"'!stall && div_valid'\"', 'is_div && \"'!stall && !late_wait && div_valid'\"'),\n    ('    .mul_result   (mul_result),', '    .mul_result   (),'),\n    ('    .shift_result (shift_result),', '    .shift_result (),'),\n    ('in.valid && \"'!div_wait;'\"', 'in.valid && \"'!div_wait && !late_wait;'\"'),\n    ('      reg_q.shift_result   <= shift_result;\\\\n      reg_q.div_result     <= div_result;\\\\n      reg_q.mul_result     <= mul_result;',\n     '      reg_q.div_result     <= div_result;\\\\n      reg_q.late_a         <= rs1;\\\\n      reg_q.late_b         <= alu_b;\\\\n      reg_q.late_op        <= in.ctrl.alu_op;'),\n])\nchange('mem_stage', [\n    ('  // ── MEM/WB register', '''  logic [31:0] late_mul, late_shift;\n  alu late_alu (\n    .clock(clock), .reset(reset),\n    .op(in.late_op), .a(in.late_a), .b(in.late_b),\n    .mul_a(32'b0), .mul_b(32'b0),\n    .div_start(1'b0), .div_consume(1'b0),\n    .div_busy(), .div_valid(), .out(),\n    .mul_result(late_mul), .mul_select(), .add_result(),\n    .shift_result(late_shift), .div_result(), .other_result()\n  );\n\n  // ── MEM/WB register'''),\n    ('& in.shift_result)', '& late_shift)'),\n    ('& in.mul_result)', '& late_mul)'),\n])\nchange('id_stage', [\n    ('  input  logic              fetch_ready,', '''  input  logic              late_replay,\n  input  logic [31:0]       replay_rs1, replay_rs2,\n  input  logic [1:0]        replay_matches,\n  input  logic              fetch_ready,'''),\n    ('    end else if (same_index_update) begin\\\\n      // Keep the repaired metadata for a candidate held past the write.\\\\n      reg_q.btb_hit       <= btb_hit;\\\\n      reg_q.btb_counter   <= btb_counter;',\n     '''    end else begin\n      if (same_index_update) begin\n        reg_q.btb_hit       <= btb_hit;\n        reg_q.btb_counter   <= btb_counter;\n      end\n      if (late_replay) begin\n        reg_q.rs1_val <= replay_rs1;\n        reg_q.rs2_val <= replay_rs2;\n        reg_q.ex_match <= '0;\n        reg_q.mem_match <= replay_matches;\n      end'''),\n])\nchange('hazard_unit', [\n    ('  input  logic       dmem_ready,', '  input  logic       late_wait,\\\\n  input  logic       dmem_ready,'),\n    ('dmem_stall || div_wait;', 'dmem_stall || div_wait || late_wait;'),\n])\nchange('core', [\n    ('  logic        div_wait;', '''  logic        div_wait, late_wait, late_replay;\n  logic [31:0] replay_rs1, replay_rs2;\n  logic [1:0] replay_matches;\n  assign late_replay = late_wait && \"'!stall_ex_mem;\n  assign replay_matches = {fwd_rs2_sel.result.mul || fwd_rs2_sel.result.shift,\n                           fwd_rs1_sel.result.mul || fwd_rs1_sel.result.shift};'\"'''),\n    ('    .hold             (hold_id),', '''    .hold             (hold_id),\n    .late_replay      (late_replay),\n    .replay_rs1       (replay_rs1),\n    .replay_rs2       (replay_rs2),\n    .replay_matches   (replay_matches),'''),\n    ('    .fwd_shift        (ex_mem_w.shift_result),\\\\n', ''),\n    ('    .fwd_mul          (ex_mem_w.mul_result),\\\\n', ''),\n    ('    .out              (ex_mem_w),', '''    .out              (ex_mem_w),\n    .late_wait        (late_wait),\n    .resolved_rs1     (replay_rs1),\n    .resolved_rs2     (replay_rs2),'''),\n    ('    .div_wait       (div_wait),', '    .div_wait       (div_wait),\\\\n    .late_wait      (late_wait),'),\n])\nPY\npython3 \\\"\"'$scratch/prototype.py\" \"$scratch/two-lane\"\n'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
