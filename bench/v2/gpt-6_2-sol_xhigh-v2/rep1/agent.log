{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('cores/bench/rtl/ex_stage.sv')\ns = p.read_text()\ni = s.index('  assign jalr_sum =')\nj = s.index('  assign target =', i)\ns = s[:i] + \\\"\\\"\\\"  // Address-generating I/S immediates are signed twelve-bit offsets.\n  function automatic [31:0] short_offset_sum(\n    input logic [31:0] base,\n    input logic [11:0] offset\n  );\n    logic [12:0] low;\n    logic inc_high, dec_high;\n    logic [19:0] increment_mask, decrement_mask;\n    begin\n      low = {1'b0, base[11:0]} + {1'b0, offset};\n      inc_high = low[12] && \"'!offset[11];\n      dec_high = !low[12] && offset[11];\n      increment_mask[0] = 1'\"'b1;\n      decrement_mask[0] = 1'b1;\n      for (int bit_index = 1; bit_index < 20; bit_index++) begin\n        increment_mask[bit_index] = &((base[31:12]) | (20'hfffff << bit_index));\n        decrement_mask[bit_index] = \"'!(|(base[31:12] & ((20'\"'h1 << bit_index) - 1)));\n      end\n      short_offset_sum = {base[31:12] \"'^ (({20{inc_high}} & increment_mask)\n                                      | ({20{dec_high}} & decrement_mask)), low[11:0]};\n    end\n  endfunction\n\n  assign jalr_sum = short_offset_sum(rs1, in.imm[11:0]);\n  assign effective_addr = short_offset_sum(rs1 | load_address_data, in.imm[11:0]);\n\"\"\" + s[j:]\np.write_text(s)\nPY\nmake lint TARGET=bench && python3 -m tools.eval.gowin bench --all-options --paths 4 > timing.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
