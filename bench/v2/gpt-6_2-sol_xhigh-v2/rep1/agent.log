{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'set -eu\nscratch=\"$TMPDIR/folded-leading-nibble\"\nmkdir -p \"$scratch/cores/bench\"\ncp -R cores/bench/rtl cores/bench/test cores/bench/core.yaml \"$scratch/cores/bench/\"\ncp -R fpga \"$scratch/\"\npython - \"$scratch\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\n\npath = Path(sys.argv[1]) / \\\"cores/bench/rtl/alu.sv\\\"\nsource = path.read_text()\nsource = source.replace(\n    \\\"logic [63:0] partial_q, after_two, after_five;\\\",\n    \\\"\\\"\\\"logic [63:0] partial_q, after_four;\n  logic [31:0] magnitude_a;\n  logic [3:0] leading_bits, small_divisor, leading_digit, leading_remainder;\n  logic divisor_is_small;\\\"\\\"\\\",\n)\nstart = source.index(\\\"  always_comb begin\\\\n    after_two\\\")\nend = source.index(\\\"  always_ff @(posedge clock)\\\", start)\nsource = source[:start] + \\\"\\\"\\\"  assign magnitude_a = neg_a ? -a : a;\n  assign leading_bits = neg_a ? (~a[31:28] + {3'b0, a[27:0] == 28'd0}) : a[31:28];\n  assign small_divisor = neg_b ? -b[3:0] : b[3:0];\n  assign divisor_is_small = neg_b ? (&b[31:4] && b[3:0] \"'!= 4'\"'d0) : b[31:4] == 28'd0;\n\n  always_comb begin\n    logic [7:0] partial_nibble;\n    logic [4:0] trial;\n    partial_nibble = {4'b0, leading_bits};\n    for (int i = 0; i < 4; i++) begin\n      trial = partial_nibble[7:3] - {1'b0, small_divisor};\n      partial_nibble = {trial[4] ? partial_nibble[6:3] : trial[3:0],\n                        partial_nibble[2:0], \"'!trial[4]};\n    end\n    leading_digit = divisor_is_small ? partial_nibble[3:0] : 4'\"'d0;\n    leading_remainder = divisor_is_small ? partial_nibble[7:4] : leading_bits;\n\n    after_four = partial_q;\n    for (int i = 0; i < 4; i++)\n      after_four = restoring_step(after_four, divisor_q);\n  end\n\n\\\"\\\"\\\" + source[end:]\nsource = source.replace(\\\"partial_q    <= {32'b0, neg_a ? -a : a};\\\",\n                        \\\"partial_q    <= {28'b0, leading_remainder, magnitude_a[27:0], leading_digit};\\\")\nsource = source.replace(\\\"logic [31:0] magnitude_a;\\\", \\\"logic [27:0] magnitude_a;\\\")\nsource = source.replace(\\\"magnitude_a = neg_a ? -a : a;\\\", \\\"magnitude_a = neg_a ? -a[27:0] : a[27:0];\\\")\nsource = source.replace(\\\"partial_q <= div_phase_q == 4'd8 ? after_two : after_five;\\\", \\\"partial_q <= after_four;\\\")\npath.write_text(source)\nPY\npython -m tools.eval.gowin bench --worktree \\\"\"'$scratch\" --all-options --paths 1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
