{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c 'scratch=\"$TMPDIR/r6s0-btbsplit\"\nmkdir -p \"$TMPDIR/r6s0-directed\"\ncp -r \"$scratch/test\" \"$TMPDIR/r6s0-directed/test\"\nln -s \"$scratch/rtl\" \"$TMPDIR/r6s0-directed/rtl\"\npython3 - \"$TMPDIR/r6s0-directed/test/test_pipeline.py\" <<'\"'PY'\nfrom pathlib import Path\nimport sys\np=Path(sys.argv[1])\ns=p.read_text()\ntest = '''\n\n@cocotb.test()\n@cocotb.parametrize(load_hold=[0, 4])\nasync def shift_bypass_across_load_hold(dut, load_hold):\n    program = [\n        ADDI(2, 0, 63),\n        LW(1, 0, 0x40),\n        _r(0x20, 2, 1, 5, 3, 0b0110011),\n        _i(17, 3, 1, 4, 0b0010011),\n        _i(17, 4, 5, 5, 0b0010011),\n        SW(5, 0, 0x44),\n        EBREAK(),\n    ]\n    reads, writes = [], []\n    rets, _ = await _run(\n        dut, program, {0x40: 0x80000000}, load_stall_cycles=load_hold,\n        reads=reads, writes=writes,\n    )\n    _check_retirements(rets, list(range(0, 4 * len(program), 4)))\n    producer, load, sra, slli, srli, store, _ = rets\n    assert load[\\\"cycle\\\"] == producer[\\\"cycle\\\"] + load_hold + 1\n    assert [r[\\\"cycle\\\"] for r in rets[1:6]] == list(range(load[\\\"cycle\\\"], load[\\\"cycle\\\"] + 5))\n    assert (sra[\\\"rs1_rdata\\\"], sra[\\\"rs2_rdata\\\"], sra[\\\"rd_wdata\\\"]) == (0x80000000, 63, 0xFFFFFFFF)\n    assert (slli[\\\"rs1_rdata\\\"], slli[\\\"rd_wdata\\\"]) == (0xFFFFFFFF, 0xFFFE0000)\n    assert (srli[\\\"rs1_rdata\\\"], srli[\\\"rd_wdata\\\"]) == (0xFFFE0000, 0x7FFF)\n    assert store[\\\"rs2_rdata\\\"] == 0x7FFF\n    assert reads == [0x40]\n    assert writes == [(0x44, 0xF, 0x7FFF)]\n\n'''\np.write_text(s.replace(\\\"\\\\ndef test_pipeline_runner():\\\", test + \\\"\\\\ndef test_pipeline_runner():\\\"))\nPY\n(cd \\\"\"'$TMPDIR/r6s0-directed\" && pytest -q test/test_pipeline.py) >\"$TMPDIR/r6s0-directed/cocotb.log\" 2>&1\ntail -20 \"$TMPDIR/r6s0-directed/cocotb.log\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
