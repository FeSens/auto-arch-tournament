{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c 'proposal_scratch=/srv/hwebench/tmp/7cb5c576/5597d018/bench-r5s0.ZvzYHh\nfor variant in fwd-fallback fwd-early fwd-early-fallback alu-inputs; do\n mkdir -p \"$proposal_scratch/$variant/rtl\"\n cp cores/bench/rtl/*.sv \"$proposal_scratch/$variant/rtl/\"\ndone\ncat > \"$proposal_scratch/forward.py\" <<'\"'PY'\nfrom pathlib import Path\np=Path(__file__).parent\n\ndef update(rtl, name, replacements):\n    path = rtl / name\n    text = path.read_text()\n    for old, new in replacements:\n        assert text.count(old) == 1, (name, old, text.count(old))\n        text = text.replace(old, new)\n    path.write_text(text)\n\nfor name in ('fwd-fallback','fwd-early','fwd-early-fallback'):\n    rtl=p/name/'rtl'\n    early='early' in name\n    fallback='fallback' in name\n    if fallback:\n        update(rtl,'mem_stage.sv',[\n            ('  output logic [31:0]        load_data,','  output logic [31:0]        load_data, result_next,'),\n            ('  // ── MEM/WB register', '''  assign result_next = ({32{select_alu}} & in.alu_result)\n                     | ({32{in.mul_select}} & in.mul_result)\n                     | ({32{select_load}} & load_data);\n\n  // ── MEM/WB register'''),\n            ('''      reg_q.result     <= ({32{select_alu}}    & in.alu_result)\n                        | ({32{in.mul_select}} & in.mul_result)\n                        | ({32{select_load}}   & load_data);''','      reg_q.result     <= result_next;'),\n        ])\n        update(rtl,'id_stage.sv',[\n            ('  input  logic [4:0]        mem_rd,', '''  input  logic [4:0]        mem_rd,\n  input  logic              mem_write_en,\n  input  logic [31:0]       mem_value,'''),\n            ('      reg_q.rs1_val       <= rs1_data;','      reg_q.rs1_val       <= mem_write_en && rs1_addr \"'!= 5'\"\\\\'d0 && rs1_addr == mem_rd ? mem_value : rs1_data;'),\n            ('      reg_q.rs2_val       <= rs2_data;','      reg_q.rs2_val       <= mem_write_en && rs2_addr \"'!= 5'\"\\\\'d0 && rs2_addr == mem_rd ? mem_value : rs2_data;'),\n        ])\n        update(rtl,'core.sv',[\n            ('  logic [31:0] mem_load_data;', '  logic [31:0] mem_load_data, mem_value;'),\n            ('    .mem_rd   (ex_mem_w.rd),', '    .mem_rd   (ex_mem_w.rd),\\\\n    .mem_write_en (mem_write_en),\\\\n    .mem_value (mem_value),'),\n            ('    .load_data   (mem_load_data),', '    .load_data   (mem_load_data),\\\\n    .result_next (mem_value),'),\n            ('    .mem_match   (id_ex_w.mem_match),', \\\"    .mem_match   (2'b0),\\\"),\n            ('    .mem_wb_w_en (mem_wb_w.reg_write),', \\\"    .mem_wb_w_en (1'b0),\\\"),\n        ])\n    if early:\n        update(rtl,'core_pkg.sv',[\n            ('    logic [1:0]  ex_match;', '    fwd_sel_t rs1_sel, rs2_sel;\\\\n    logic [1:0]  ex_match;'),\n        ])\n        update(rtl,'ex_stage.sv',[\n            ('  output logic               div_wait,','  output logic               div_wait, next_write_en, next_mul,'),\n            ('  assign out = reg_q;', '''  logic mem_align;\n  assign mem_align = (in.ctrl.mem_width \"'!= 2'\"'d2 || base_plus_imm[1:0] == 2'b00)\n                  && (in.ctrl.mem_width \"'!= 2'\"'d1 || \"'!base_plus_imm[0]);\n  assign next_write_en = ex_ready && ctrl_with_trap.reg_write\n                     && (!(in.ctrl.mem_read || in.ctrl.mem_write) || mem_align);\n  assign next_mul = mul_select;\n  assign out = reg_q;'\"'''),\n        ])\n        update(rtl,'id_stage.sv',[\n            ('  input  logic [4:0]        ex_rd,','''  input  logic [4:0]        ex_rd,\n  input  logic              ex_write_en, ex_mul, ex_load,'''),\n            ('  input  logic [4:0]        mem_rd,', '  input  logic [4:0]        mem_rd,' if fallback else '  input  logic [4:0]        mem_rd,\\\\n  input  logic              mem_write_en,'),\n            ('  id_ex_t reg_q;', '''  id_ex_t reg_q;\n  logic [1:0] ex_match, mem_match;\n  fwd_sel_t rs1_sel, rs2_sel;\n  assign ex_match = {rs2_addr \"'!= 5'\"'b0 && rs2_addr == ex_rd,\n                     rs1_addr \"'!= 5'\"'b0 && rs1_addr == ex_rd};\n  assign mem_match = ''' + (\\\"2'b0;\\\" if fallback else '''{rs2_addr \"'!= 5'\"'b0 && rs2_addr == mem_rd,\n                      rs1_addr \"'!= 5'\"'b0 && rs1_addr == mem_rd};''') + '''\n  forward_unit select_next (\n    .ex_match(ex_match), .mem_match(mem_match),\n    .ex_mem_w_en(ex_write_en), .ex_mem_mul(ex_mul), .ex_mem_load(ex_load),\n    .mem_wb_w_en(''' + (\\\"1'b0\\\" if fallback else 'mem_write_en') + '''),\n    .fwd_rs1(rs1_sel), .fwd_rs2(rs2_sel)\n  );'''),\n            ('      reg_q.pc            <= in.pc;', '''      reg_q.pc            <= in.pc;\n      reg_q.rs1_sel       <= rs1_sel;\n      reg_q.rs2_sel       <= rs2_sel;'''),\n        ])\n        update(rtl,'core.sv',[\n            ('  fwd_sel_t    fwd_rs1_sel, fwd_rs2_sel;', '  logic        ex_write_en, ex_mul;'),\n            ('    .ex_rd    (id_ex_w.rd),','''    .ex_rd    (id_ex_w.rd),\n    .ex_write_en (ex_write_en),\n    .ex_mul (ex_mul),\n    .ex_load (id_ex_w.ctrl.mem_to_reg),'''),\n            ('    .mem_rd   (ex_mem_w.rd),','    .mem_rd   (ex_mem_w.rd),' if fallback else '    .mem_rd   (ex_mem_w.rd),\\\\n    .mem_write_en (mem_write_en),'),\n            ('    .fwd_rs1_sel     (fwd_rs1_sel),', '    .fwd_rs1_sel     (id_ex_w.rs1_sel),'),\n            ('    .fwd_rs2_sel     (fwd_rs2_sel),', '    .fwd_rs2_sel     (id_ex_w.rs2_sel),'),\n            ('    .div_wait        (div_wait),','    .div_wait        (div_wait),\\\\n    .next_write_en   (ex_write_en),\\\\n    .next_mul        (ex_mul),'),\n        ])\n        f=rtl/'core.sv'\n        s=f.read_text()\n        a=s.index('  forward_unit u_fwd')\n        b=s.index('  // ── RVFI',a)\n        f.write_text(s[:a]+s[b:])\n\nrtl=p/'alu-inputs'/'rtl'\nupdate(rtl,'ex_stage.sv',[\n    ('''  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end''','''  assign alu_a = ({32{fwd_rs1_sel.alu && \"'!in.ctrl.is_auipc}}     & fwd_alu)\n               | ({32{fwd_rs1_sel.mul && !in.ctrl.is_auipc}}     & fwd_mul)\n               | ({32{fwd_rs1_sel.load && !in.ctrl.is_auipc}}    & fwd_load)\n               | ({32{fwd_rs1_sel.wb && !in.ctrl.is_auipc}}      & fwd_mem_wb)\n               | ({32{fwd_rs1_sel.regfile && !in.ctrl.is_auipc}} & in.rs1_val)\n               | ({32{in.ctrl.is_auipc}} & in.pc);\n  assign alu_b = ({32{fwd_rs2_sel.alu && !in.ctrl.alu_src}}     & fwd_alu)\n               | ({32{fwd_rs2_sel.mul && !in.ctrl.alu_src}}     & fwd_mul)\n               | ({32{fwd_rs2_sel.load && !in.ctrl.alu_src}}    & fwd_load)\n               | ({32{fwd_rs2_sel.wb && !in.ctrl.alu_src}}      & fwd_mem_wb)\n               | ({32{fwd_rs2_sel.regfile && !in.ctrl.alu_src}} & in.rs2_val)\n               | ({32{in.ctrl.alu_src}} & in.imm);'\"''')\n])\nPY\npython \\\"\"'$proposal_scratch/forward.py\" && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=\"$PWD\" python \"$proposal_scratch/timing.py\" fwd-fallback fwd-early fwd-early-fallback alu-inputs'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
