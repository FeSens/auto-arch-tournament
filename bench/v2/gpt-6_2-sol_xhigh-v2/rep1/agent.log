{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c 'root=\"$TMPDIR\"\nref=\"$root/bench-r9s0.0vwvuFVy\"\nfor variant in bench-r9-valid32 bench-r9-valid16; do\n  mkdir -p \"$root/$variant/cores/bench\"\n  cp -r \"$ref/Makefile\" \"$ref/bench\" \"$ref/test\" \"$ref/fpga\" \"$root/$variant/\"\n  cp -r \"$ref/cores/bench/core.yaml\" \"$ref/cores/bench/test\" \"$root/$variant/cores/bench/\"\n  cp -r cores/bench/rtl \"$root/$variant/cores/bench/\"\ndone\npython - <<'\"'PY'\nimport os\nfrom pathlib import Path\nroot = Path(os.environ['TMPDIR'])\nfor lines, bp in [(32,5),(16,4)]:\n    banks = 1024 // lines\n    path = root / f'bench-r9-valid{lines}/cores/bench/rtl/if_stage.sv'\n    s = path.read_text()\n    s = s.replace('  logic [1023:0] replay_valid_q;',f'''  logic [{banks-1}:0] replay_bank_live_q;\n  logic [{lines-1}:0] replay_valid_bits [0:{banks-1}];\n  logic [{lines-1}:0] replay_fill_bits, replay_read_bits;\n  logic [{9-bp}:0] replay_fill_bank, replay_read_bank;\n  logic [{bp-1}:0] replay_fill_offset, replay_read_offset;''')\n    s = s.replace('  assign replay_collision', f'''  assign {{replay_fill_bank, replay_fill_offset}} = pc[11:2];\n  assign {{replay_read_bank, replay_read_offset}} = normal_pc_q[11:2];\n  assign replay_read_bits = replay_valid_bits[replay_read_bank];\n  assign replay_fill_bits = (replay_bank_live_q[replay_fill_bank] ? replay_valid_bits[replay_fill_bank] : '0)\n                          | ({lines}'b1 << replay_fill_offset);\n\n  assign replay_collision''')\n    s = s.replace('                   && replay_valid_q[normal_pc_q[11:2]]',\n                  '                   && replay_bank_live_q[replay_read_bank] && replay_read_bits[replay_read_offset]')\n    s = s.replace(\\\"      replay_valid_q <= '0;\\\", \\\"      replay_bank_live_q <= '0;\\\")\n    s = s.replace(\\\"      replay_valid_q[pc[11:2]] <= 1'b1;\\\", \\\"      replay_bank_live_q[replay_fill_bank] <= 1'b1;\\\")\n    s = s.replace('  always_