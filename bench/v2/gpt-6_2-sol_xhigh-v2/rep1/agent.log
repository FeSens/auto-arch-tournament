dict_taken;\n  assign recorded_pc = {predicted_pc[31:1], predicted_pc[0] | at_boundary};\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic [31:0] predicted_next_pc;\n  } fetch_packet_t;\n\n  fetch_packet_t response, fifo_head\n…[2307 of 5379 chars elided by tools/bench/transcript.py; sha256:7ccaef42b1623982]…\nwrite is bypassed independently\n  // of the prediction that steered the request port.\n  assign issue_index = issue_pc[6:2];\n  assign issue_in_range = issue_pc[31:20] == 12'b0 && issue_pc[1:0] == 2'b00;\n  assign issue_hit = btb_valid[issue_index] && btb_tag[issue_index] == issue_pc[19:7];\n  assign {write_tag, write_index} = btb_update.pc_word;\n  assign same_index_write = btb_update.write_counter && write_index == issue_index;\n  assign out.btb_hit = issue_in_range && (same_index_write ? write_tag == issue_pc[19:7] : issue_hit);\n  assign out.btb_counter = same_index_write ? btb_update.counter : btb_counter[issue_index];\n\n  always_ff @(posedge clock) begin\n    if (reset)\n      btb_valid <= '0;\n    else begin\n      if (btb_update.write_target) begin\n        btb_valid[write_index] <= 1'b1;\n        btb_tag[write_index] <= write_tag;\n        btb_target[write_index] <= btb_update.target_word;\n      end\n      if (btb_update.write_counter)\n        btb_counter[write_index] <= btb_update.counter;\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
