e clock) begin\n    {replay_valid, replay_tag, replay_word} <= replay_entry[normal_pc_d[11:2]];\n    if (scrub_q || replay_fill)\n      replay_entry[replay_write_index] <= {!scrub_q, pc[19:12], imem_data};\n    replay_write_q <= scrub_q || replay_fill;\n    replay_write_index_q <= replay_write_index;\n\n    if (reset || fetch_resolution.refetch) begin\n      scrub_q <= 1'\"'b1;\n      scrub_index_q <= '0;\n    end else if (scrub_q) begin\n      scrub_q <= \"'!(&scrub_index_q);\n      scrub_index_q <= scrub_index_q + 10'\"'d1;\n    end\n  end\n\n\\\"\\\"\\\" + packed[end:]\nsave(\\\"rtl_packed\\\", packed)\n\nsingle = source.replace(\n    \\\"ordinary_taken_hit, ordinary_bypass_hit, predict_on_table, predict_on_bypass\\\",\n    \\\"ordinary_bypass_hit, predict_on_table, predict_on_bypass\\\",\n).replace(\\\"  logic [1:0]  taken_counter, not_taken_counter, ordinary_counter;\\\", \\\"\\\").replace(\n    \\\"  btb_action_t selected_action;\\\", \\\"\\\",\n).replace(\n    \\\"logic [1:0]  btb_counter [0:31];\\\",\n    \\\"logic [31:0] btb_direction;\\\",\n)\nstart = single.index(\\\"  assign selected_action\\\")\nend = single.index(\\\"  assign {write_tag\\\", start)\nsingle = single[:start] + \\\"\\\"\\\"  assign btb_update.pc_word = btb_training.pc_word;\n  assign btb_update.target_word = btb_training.target_word;\n  assign btb_update.write_target = btb_training.taken.write_target;\n  assign btb_update.write_counter = btb_training.taken.write_target;\n  assign btb_update.counter = {training_taken, 1'b0};\n\\\"\\\"\\\" + single[end:]\nstart = single.index(\\\"  assign taken_target_bypass\\\")\nend = single.index(\\\"  assign ordinary_plus4\\\", start)\nsingle = single[:start] + \\\"\\\"\\\"  assign taken_target_bypass = ordinary_same_index && btb_training.taken.write_target;\n  assign predict_on_table = ordinary_table_hit && \"'!taken_target_bypass && btb_direction[ordinary_index];\n  assign predict_on_bypass = ordinary_bypass_hit && training_taken && taken_target_bypas