{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\n\nroot = Path(\\\"/srv/hwebench/tmp/7cb5c576/6b2b6527/jalr-match\\\")\nrtl = root / \\\"cores/bench/rtl\\\"\nrtl.parent.mkdir(parents=True, exist_ok=True)\nshutil.copytree(\\\"cores/bench/rtl\\\", rtl)\nshutil.copy2(\\\"cores/bench/core.yaml\\\", rtl.parent)\nshutil.copytree(\\\"fpga\\\", root / \\\"fpga\\\")\nex_path = rtl / \\\"ex_stage.sv\\\"\nex = ex_path.read_text()\nanchor = \\\"  assign target_aligned = target[1:0] == 2'b00;\\\"\nlogic = \\\"\\\"\\\"\n  logic [31:1] jalr_match_bit;\n  logic [31:1] jalr_match_carry;\n  logic jalr_match, direct_match;\n\n  // A proposed sum bit implies the carry-in to its own position and,\n  // together with both operands, implies the carry-out to the next bit.\n  // The adjacent checks compose to verify the sum without propagating carry.\n  assign jalr_match_carry[1] = rs1[0] && in.imm[0];\n  for (genvar i = 1; i < 32; i++) begin : jalr_target_compare\n    assign jalr_match_bit[i] = (rs1[i] \"'^ in.imm[i] ''^ fetch_pc[i]) == jalr_match_carry[i];\n    if (i < 31) begin : upper_carry\n      assign jalr_match_carry[i+1] = (rs1[i] && in.imm[i])\n                                 || ((rs1[i] || in.imm[i]) && !fetch_pc[i]);\n    end\n  end\n  assign jalr_match = !fetch_pc[0] && (&jalr_match_bit);\n  assign direct_match = fetch_pc == in.direct_target;\n\"\"\"\nassert ex.count(anchor) == 1\nold_match = \"!fetch_parked && fetch_pc == target\"\nassert ex.count(old_match) == 1\nex_path.write_text(ex.replace(anchor, anchor + \"'\"\\\\n\\\" + logic).replace(old_match, \\\"\"'!fetch_parked && (in.ctrl.is_jalr ? jalr_match : direct_match)\"))\nPY\npython -m tools.eval.gowin bench --worktree /srv/hwebench/tmp/7cb5c576/6b2b6527/jalr-match --all-options --paths 5'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
