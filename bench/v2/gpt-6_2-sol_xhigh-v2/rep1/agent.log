{"type":"item.completed","item":{"id":"item_35","type":"agent_message","text":"The best fetch-only prototype so far reached 81.474 MHz and retained the champion’s exact 3,202,739 CoreMark cycles. That is below the promotion floor. The divider now limits this prototype, so I’m checking whether a local arithmetic change can deliver a larger gain."}}
{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r10-fetch-retime.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\n\nscratch = Path(os.environ['TMPDIR'])\ncode = (scratch / 'bench-r10-fetch-trials.py').read_text()\nexec(code[:code.index('cases = {')])\n\ndef lookahead(s):\n    s = flat_pc(scalar_bitmap(s))\n    s = s.replace('  logic [31:0] ordinary_plus4;', '''  logic [31:0] ordinary_plus4, next_plus4;\n  logic [31:0] step_plus4, table_plus4, pending_plus4;\n  logic [31:0] next_target_plus4, next_fallthrough_plus4;''')\n    s = s.replace(\\\"  assign ordinary_plus4 = normal_pc_q + 32'd4;\\\\n\\\", '')\n    a = s.index('  always_ff @(posedge clock) begin\\\\n    normal_pc_q')\n    s = s[:a] + '''  assign step_plus4 = normal_pc_q + 32'd8;\n  assign table_plus4 = {12'b0, ordinary_table_target, 2'b00} + 32'd4;\n  assign pending_plus4 = {12'b0, btb_training.target_word, 2'b00} + 32'd4;\n  assign next_target_plus4 = corrected_accept && \"'!target_last ? fetch_resolution.target + 32'\"'d8 : target_plus4;\n  assign next_fallthrough_plus4 = corrected_accept && \"'!fallthrough_last ? fetch_resolution.fallthrough + 32'\"'d8 : fallthrough_plus4;\n  assign next_plus4 = ({32{ordinary_keep}} & ordinary_plus4)\n                    | ({32{ordinary_step}} & step_plus4)\n                    | ({32{ordinary_prediction}} & table_plus4)\n                    | ({32{ordinary_pending}} & pending_plus4)\n                    | ({32{\"'!reset && recover_target}} & next_target_plus4)\n                    | ({32{!reset && recover_fallthrough}} & next_fallthrough_plus4)\n                    | (reset ? 32'\"'d4 : 32'd0);\n''' + s[a:]\n    return s.replace('    normal_pc_q <= normal_pc_d;', '    normal_pc_q <= normal_pc_d;\\\\n    ordinary_plus4 <= next_plus4;')\n\ndef xor_step(s):\n    s = flat_pc(scalar_bitmap(s))\n    s = s.replace('ordinary_pending, ordinary_keep, ordinary_step;', 'ordinary_pending, ordinary_base, ordinary_step;\\\\n  logic [31:0] ordinary_linear_step, linear_toggles;')\n    s = s.replace('  assign ordinary_keep = \"'!reset && !squash_candidate && (!ordinary_accept || (ordinary_last && !predict_taken));'\"', '''  assign ordinary_base = \"'!reset && !squash_candidate && !(ordinary_accept && predict_taken);\n  assign linear_toggles[2:0] = 3'\"'b100;\n  for (genvar i = 3; i < 32; i++) begin : carry_step\n    assign linear_toggles[i] = &normal_pc_q[i-1:2];\n  end\n  assign ordinary_linear_step = normal_pc_q \"'^ ({32{ordinary_step}} & linear_toggles);'\"''')\n    return s.replace('({32{ordinary_keep}} & normal_pc_q)\\\\n                     | ({32{ordinary_step}} & ordinary_plus4)',\n                     '({32{ordinary_base}} & ordinary_linear_step)')\n\ndef speculative_read(s, flatten=True):\n    s = flat_pc(scalar_bitmap(s)) if flatten else s\n    s = s.replace('  logic [39:0]   replay_entry', '''  logic [9:0]    replay_read_index;\n  logic          replay_read_enable, replay_retry, replay_speculate;\n  logic [39:0]   replay_entry''')\n    a = s.index('  always_ff @(posedge clock) begin\\\\n    {replay_tag, replay_word}')\n    s = s[:a] + '''  assign replay_retry = replay_collision && \"'!(imem_ready && !hold_id && !fetch_parked);\n  assign replay_speculate = !reset && !squash_candidate && !replay_retry;\n  assign replay_read_enable = reset || squash_candidate || ordinary_accept || replay_collision;\n  assign replay_read_index = ({10{!reset && !squash_candidate && replay_retry}} & normal_pc_q[11:2])\n                           | ({10{replay_speculate && !predict_taken && !ordinary_last}} & ordinary_plus4[11:2])\n                           | ({10{replay_speculate && !predict_taken && ordinary_last}} & normal_pc_q[11:2])\n                           | ({10{replay_speculate && predict_taken && training_taken && taken_target_bypass}}\n                              & btb_training.target_word[9:0])\n                           | ({10{replay_speculate && predict_taken && !(training_taken && taken_target_bypass)}}\n                              & ordinary_table_target[9:0])\n                           | ({10{!reset && recover_target}} & target_pc_d[11:2])\n                           | ({10{!reset && recover_fallthrough}} & fallthrough_pc_d[11:2]);\n\n'\"''' + s[a:]\n    return s.replace('    {replay_tag, replay_word} <= replay_entry[normal_pc_d[11:2]];',\n                     '    if (replay_read_enable)\\\\n      {replay_tag, replay_word} <= replay_entry[replay_read_index];')\n\ncases = {'lookahead-PC': lookahead, 'xor-step': xor_step, 'read-enable': speculative_read,\n         'plain-read-enable': lambda s: speculative_read(s, False)}\nexec(code[code.index('for name, transform in cases.items():'):])\nPY\nPYTHONPATH=\\\"\"'$PWD\" python \"$TMPDIR/bench-r10-fetch-retime.py\"'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
{"type": "item.completed", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/bench-r10-divider.py\" <<'\"'PY'\nimport concurrent.futures\nimport os\nfrom pathlib import Path\nfrom shutil import copytree\nfrom tempfile import mkdtemp\n\nfrom tools.eval.gowin import build\nfrom tools.eval.fpga import _bench_sv\n\nworktree = Path.cwd()\nbase = Path(mkdtemp(prefix='bench-r10s0-divider-', dir=os.environ['TMPDIR']))\nprint(base, flush=True)\nrtl = worktree / 'cores/bench/rtl'\nbenches = _bench_sv(str(worktree), 'bench')\n\ndef radix16(s, subtract_at_start=False):\n    s = s.replace('  logic [63:0] partial_q, after_prefix, after_radix4_a, after_radix4_b;', '''  logic [63:0] partial_q, after_prefix, after_radix4_a, after_radix16;\n  logic [36:0] divisor_extended;\n  logic [36:0] divisor_x2, divisor_x4, divisor_x8, divisor_x16;\n  logic [36:0] divisor_multiple [1:15];\n  logic [36:0] divisor_multiple_q [1:15];\n  logic [36:0] partial_shifted;\n  logic [36:0] trial [0:15];\n  logic [15:0] digit_select;\n  logic [31:0] digit_remainder [0:15];\n  logic [3:0] digit_quotient [0:15];\n  logic [31:0] radix16_remainder;\n  logic [3:0] radix16_digit;''')\n    s = s.replace('  assign after_radix4_b = radix4_step(after_radix4_a, divisor_q, triple_divisor_q);', '''  assign divisor_extended = {5'b0, divisor_q};\n  assign {divisor_x2, divisor_x4, divisor_x8, divisor_x16} = {\n    divisor_extended << 1, divisor_extended << 2,\n    divisor_extended << 3, divisor_extended << 4\n  };\n  assign divisor_multiple[1] = divisor_extended;\n  assign divisor_multiple[2] = divisor_x2;\n  assign divisor_multiple[3] = divisor_x2 + divisor_extended;\n  assign divisor_multiple[4] = divisor_x4;\n  assign divisor_multiple[5] = divisor_x4 + divisor_extended;\n  assign divisor_multiple[6] = divisor_x4 + divisor_x2;\n  assign divisor_multiple[7] = divisor_x8 - divisor_extended;\n  assign divisor_multiple[8] = divisor_x8;\n  assign divisor_multiple[9] = divisor_x8 + divisor_extended;\n  assign divisor_multiple[10] = divisor_x8 + divisor_x2;\n  assign divisor_multiple[11] = (divisor_x8 \"'^ divisor_x2 ''^ divisor_extended)\n                              + (((divisor_x8 & divisor_x2) | (divisor_x8 & divisor_extended)\n                                 | (divisor_x2 & divisor_extended)) << 1);\n  assign divisor_multiple[12] = divisor_x8 + divisor_x4;\n  assign divisor_multiple[13] = (divisor_x8 ''^ divisor_x4 ''^ divisor_extended)\n                              + (((divisor_x8 & divisor_x4) | (divisor_x8 & divisor_extended)\n                                 | (divisor_x4 & divisor_extended)) << 1);\n  assign divisor_multiple[14] = divisor_x16 - divisor_x2;\n  assign divisor_multiple[15] = divisor_x16 - divisor_extended;\n  assign partial_shifted = {1'\"'b0, partial_q[63:28]};\n  assign trial[0] = partial_shifted;\n  for (genvar d = 1; d < 16; d++) begin : trials\n    always_ff @(posedge clock) begin\n      if (div_phase_q == 4'd8)\n        divisor_multiple_q[d] <= divisor_multiple[d];\n    end\n    assign trial[d] = partial_shifted - divisor_multiple_q[d];\n  end\n  for (genvar d = 0; d < 16; d++) begin : masks\n    if (d == 15) begin : last_digit\n      assign digit_select[d] = \"'!trial[d][36];\n    end else begin : earlier_digits\n      assign digit_select[d] = !trial[d][36] && trial[d+1][36];\n    end\n    assign digit_remainder[d] = {32{digit_select[d]}} & trial[d][31:0];\n    assign digit_quotient[d] = {4{digit_select[d]}} & 4'\"'(d);\n  end\n  for (genvar b = 0; b < 32; b++) begin : remainder_bits\n    logic [15:0] choices;\n    for (genvar d = 0; d < 16; d++) begin : digit_bit\n      assign choices[d] = digit_remainder[d][b];\n    end\n    assign radix16_remainder[b] = |choices;\n  end\n  for (genvar b = 0; b < 4; b++) begin : quotient_bits\n    logic [15:0] choices;\n    for (genvar d = 0; d < 16; d++) begin : digit_bit\n      assign choices[d] = digit_quotient[d][b];\n    end\n    assign radix16_digit[b] = |choices;\n  end\n  assign after_radix16 = {radix16_remainder, partial_q[27:0], radix16_digit};''')\n    return s.replace('partial_q <= after_radix4_b', 'partial_q <= after_radix16')\n\ndef grouped_subtract(s, bits):\n    a = s.index('  function automatic [63:0] radix4_step(')\n    stops = sorted(set(range(0, 35, bits)) | {35})\n    fields = list(zip(stops[:-1], stops[1:]))\n    definition = '''  function automatic logic [34:0] restoring_trial(\n    input logic [34:0] minuend,\n    input logic [34:0] subtrahend\n  );\n'''\n    for i, (start, end) in enumerate(fields):\n        width = end - start\n        definition += f'    logic [{width}:0] chunk_{i};\\\\n'\n    definition += f'    logic [{len(fields)-1}:1] borrow;\\\\n    begin\\\\n'\n    for i, (start, end) in enumerate(fields):\n        definition += f\\\"      chunk_{i} = {{1'b0, minuend[{end-1}:{start}]}} - {{1'b0, subtrahend[{end-1}:{start}]}};\\\\n\\\"\n    for i, (start, end) in enumerate(fields):\n        width = end - start\n        if i < len(fields)-1:\n            definition += f'      borrow[{i+1}] = chunk_{i}[{width}]'\n            if i:\n                definition += f' || ((minuend[{end-1}:{start}] == subtrahend[{end-1}:{start}]) && borrow[{i}])'\n            definition += ';\\\\n'\n        definition += f'      restoring_trial[{end-1}:{start}] = chunk_{i}[{width-1}:0]'\n        if i:\n            definition += f\\\" - {width}'(borrow[{i}])\\\"\n        definition += ';\\\\n'\n    definition += '    end\\\\n  endfunction\\\\n\\\\n'\n    s = s[:a] + definition + s[a:]\n    return s.replace('shifted - {3\\\\'b0, divisor}', 'restoring_trial(shifted, {3\\\\'b0, divisor})') \\\\\n        .replace('shifted - {2\\\\'b0, divisor, 1\\\\'b0}', 'restoring_trial(shifted, {2\\\\'b0, divisor, 1\\\\'b0})') \\\\\n        .replace('shifted - {1\\\\'b0, triple_divisor}', 'restoring_trial(shifted, {1\\\\'b0, triple_divisor})')\n\ncases = {'radix16': radix16, 'grouped8': lambda s: grouped_subtract(s, 8), 'grouped12': lambda s: gr