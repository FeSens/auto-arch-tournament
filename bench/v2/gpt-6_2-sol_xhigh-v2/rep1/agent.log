{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"/srv/hwebench/tmp/7cb5c576/3a36c2c9/bench-r7.MzUGbH/cores/bench/obj_dir/cosim_sim /srv/hwebench/tmp/7cb5c576/3a36c2c9/bench-r7.MzUGbH/bench/programs/coremark.elf 50000000 --istall --dstall | python3 -c '\nimport re, sys\nfrom collections import Counter\ncount = Counter()\npattern = re.compile(r\\\"\"'^'\"\\\\{\\\\\\\"order\\\\\\\":\\\\d+,\\\\\\\"cycle\\\\\\\":(\\\\d+),\\\\\\\"insn\\\\\\\":(\\\\d+)\\\")\nprevious_insn = 0\nfor line in sys.stdin:\n    m = pattern.match(line)\n    if not m: continue\n    cycle, insn = map(int, m.groups())\n    if cycle < 14899: continue\n    if cycle > 4002820: break\n    op, w, rd = previous_insn & 127, previous_insn >> 12 & 7, previous_insn >> 7 & 31\n    raw_rs1, raw_rs2 = insn >> 15 & 31, insn >> 20 & 31\n    next_op, f3, f7 = insn & 127, insn >> 12 & 7, insn >> 25\n    if next_op == 0x33:\n        family = \\\"mul\\\" if f7 == 1 else \\\"shift\\\" if f3 in (1, 5) else \\\"alu\\\"\n    elif next_op == 0x13:\n        family = \\\"shift\\\" if f3 in (1, 5) else \\\"alu\\\"\n    else:\n        family = {3:\\\"load\\\",0x23:\\\"store\\\",0x63:\\\"branch\\\",0x67:\\\"jalr\\\"}.get(next_op, \\\"other\\\")\n    if op == 3 and rd and rd in (raw_rs1, raw_rs2):\n        real_rs1 = next_op in (3,0x13,0x23,0x33,0x63,0x67)\n        real_rs2 = next_op in (0x23,0x33,0x63)\n        useful = (rd == raw_rs1 and real_rs1) or (rd == raw_rs2 and real_rs2)\n        count[(\\\"word\\\" if w == 2 else \\\"narrow\\\", family, useful)] += 1\n    if next_op == 0x23: count[\\\"stores\\\"] += 1\n    if next_op == 3: count[\\\"loads\\\"] += 1\n    count[\\\"instructions\\\"] += 1\n    previous_insn = insn\nprint(*count.most_common(), sep=\\\"\\\\n\\\")\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
