{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c 'mkdir -p \"$TMPDIR/bench-lane-probe\"\ncat > \"$TMPDIR/bench-lane-probe/probe.py\" <<'\"'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\ntarget = Path('cores/bench/rtl')\nkind = sys.argv[2]\nout = Path(sys.argv[1]) / kind\nif out.exists():\n    raise FileExistsError(out)\nshutil.copytree(target, out)\ndef edit(file, old, new):\n    path = out / (file + '.sv')\n    source = path.read_text()\n    assert source.count(old) == 1, (file, old)\n    path.write_text(source.replace(old, new))\n\nedit('core_pkg', '    logic [1:0]  ex_match;', '    result_sel_t ex_lane_rs1;\\\\n    result_sel_t ex_lane_rs2;\\\\n    logic [1:0]  ex_match;')\nedit('core_pkg', '    logic        mem_misalign;', '    logic        mem_misalign;\\\\n    logic        writer;')\nedit('ex_stage', '  output ex_mem_t             out,', '  output ex_mem_t             out,\\\\n  output result_sel_t         result_kind,')\nedit('ex_stage', '  result_sel_t result_sel;\\\\n', '')\nedit('ex_stage', '      reg_q.result_sel     <= ex_ready ? result_sel : \\\\'0;',\n     '      reg_q.result_sel     <= ex_ready ? result_kind : \\\\'0;\\\\n'\n     '      reg_q.writer         <= ex_ready && mem_ctrl.reg_write && \"'!mem_misalign;'\"')\nex_path = out / 'ex_stage.sv'\nex_path.write_text(ex_path.read_text().replace('assign result_sel.', 'assign result_kind.'))\nedit('mem_stage', '  assign write_en = in.ctrl.reg_write && \"'!in.mem_misalign;'\"', '  assign write_en = in.writer;')\n\nedit('id_stage', '  input  logic [4:0]        ex_rd,', '  input  logic [4:0]        ex_rd,\\\\n  input  result_sel_t       ex_kind,')\nedit('id_stage', '      reg_q.ctrl          <= ctrl_decoded;',\n     '      reg_q.ex_lane_rs1  <= (rs1_addr \"'!= 5'\"\\\\'d0 && rs1_addr == ex_rd) ? ex_kind : \\\\'0;\\\\n'\n     '      reg_q.ex_lane_rs2  <= (rs2_addr \"'!= 5'\"\\\\'d0 && rs2_addr == ex_rd) ? ex_kind : \\\\'0;\\\\n'\n     '      reg_q.ctrl          <= ctrl_decoded;')\nedit('id_stage', '        reg_q.ex_match  <= \\\\'0;', '        reg_q.ex_match  <= \\\\'0;\\\\n        reg_q.ex_lane_rs1 <= \\\\'0;\\\\n        reg_q.ex_lane_rs2 <= \\\\'0;')\nedit('core', '  fwd_sel_t    fwd_rs1_sel, fwd_rs2_sel;', '  fwd_sel_t    fwd_rs1_sel, fwd_rs2_sel;\\\\n  result_sel_t ex_result_kind;')\nedit('core', '    .ex_rd            (id_ex_w.rd),', '    .ex_rd            (id_ex_w.rd),\\\\n    .ex_kind          (ex_result_kind),')\nedit('core', '    .out              (ex_mem_w),', '    .out              (ex_mem_w),\\\\n    .result_kind      (ex_result_kind),')\n\nif kind == 'tags':\n    edit('core', '    .ex_mem_sel  (ex_mem_w.result_sel),', '    .ex_lane_rs1  (id_ex_w.ex_lane_rs1),\\\\n    .ex_lane_rs2  (id_ex_w.ex_lane_rs2),')\n    edit('forward_unit', '  input  result_sel_t ex_mem_sel,', '  input  result_sel_t ex_lane_rs1,\\\\n  input  result_sel_t ex_lane_rs2,')\n    edit('forward_unit', 'younger[0] ? ex_mem_sel', 'ex_mem_w_en ? ex_lane_rs1')\n    edit('forward_unit', 'younger[1] ? ex_mem_sel', 'ex_mem_w_en ? ex_lane_rs2')\nelif kind == 'selects':\n    edit('ex_stage', '  output result_sel_t         result_kind,', '  output result_sel_t         result_kind,\\\\n  output logic                issue_writer,')\n    edit('ex_stage', '  // ── EX/MEM register', '  assign issue_writer = in.valid && \"'!squash_candidate && mem_ctrl.reg_write && !mem_misalign;'\"\\\\n\\\\n  // ── EX/MEM register')\n    edit('core_pkg', '    result_sel_t ex_lane_rs1;\\\\n    result_sel_t ex_lane_rs2;', '    fwd_sel_t fwd_rs1;\\\\n    fwd_sel_t fwd_rs2;')\n    # Replacing whole packed fields means the legacy dependency bits are unused.\n    edit('core_pkg', '''    logic [1:0]  ex_match;      // {rs2, rs1}, producer advances to EX/MEM\n    logic [1:0]  mem_match;     // {rs2, rs1}, producer advances to MEM/WB\n''', '')\n    edit('id_stage', '  input  result_sel_t       ex_kind,', '  input  result_sel_t       ex_kind,\\\\n  input  logic              ex_writer,\\\\n  input  logic              mem_writer,')\n    edit('id_stage', '  logic corrected_q;', '''  logic corrected_q;\n  logic young_rs1, young_rs2, old_rs1, old_rs2;\n\n  assign young_rs1 = ex_writer && rs1_addr \"'!= 5'\"'d0 && rs1_addr == ex_rd;\n  assign young_rs2 = ex_writer && rs2_addr \"'!= 5'\"'d0 && rs2_addr == ex_rd;\n  assign old_rs1 = mem_writer && rs1_addr \"'!= 5'\"'d0 && rs1_addr == mem_rd;\n  assign old_rs2 = mem_writer && rs2_addr \"'!= 5'\"'d0 && rs2_addr == mem_rd;''')\n    edit('id_stage', '''      reg_q.ex_match      <= {rs2_addr \"'!= 5'\"'b0 && rs2_addr == ex_rd,\n                              rs1_addr \"'!= 5'\"'b0 && rs1_addr == ex_rd};\n      reg_q.mem_match     <= {rs2_addr \"'!= 5'\"'b0 && rs2_addr == mem_rd,\n                              rs1_addr \"'!= 5'\"'b0 && rs1_addr == mem_rd};\n      reg_q.ex_lane_rs1  <= (rs1_addr \"'!= 5'\"'d0 && rs1_addr == ex_rd) ? ex_kind : '0;\n      reg_q.ex_lane_rs2  <= (rs2_addr \"'!= 5'\"'d0 && rs2_addr == ex_rd) ? ex_kind : '0;''', '''      reg_q.fwd_rs1.result <= young_rs1 ? ex_kind : '0;\n      reg_q.fwd_rs2.result <= young_rs2 ? ex_kind : '0;\n      reg_q.fwd_rs1.wb <= \"'!young_rs1 && old_rs1;\n      reg_q.fwd_rs2.wb <= !young_rs2 && old_rs2;\n      reg_q.fwd_rs1.regfile <= !young_rs1 && !old_rs1;\n      reg_q.fwd_rs2.regfile <= !young_rs2 && !old_rs2;'\"''')\n    edit('id_stage', '''        reg_q.ex_match  <= '0;\n        reg_q.ex_lane_rs1 <= '0;\n        reg_q.ex_lane_rs2 <= '0;\n        reg_q.mem_match <= replay_load_match;''', '''        reg_q.fwd_rs1 <= {6'b0, replay_load_match[0], \"'!replay_load_match[0]};\n        reg_q.fwd_rs2 <= {6'\"'b0, replay_load_match[1], \"'!replay_load_match[1]};'\"''')\n    edit('core', '  result_sel_t ex_result_kind;', '  result_sel_t ex_result_kind;\\\\n  logic ex_issue_writer;')\n    edit('core', '    .ex_kind          (ex_result_kind),', '    .ex_kind          (ex_result_kind),\\\\n    .ex_writer        (ex_issue_writer),\\\\n    .mem_writer       (mem_write_en),')\n    edit('core', '    .result_kind      (ex_result_kind),', '    .result_kind      (ex_result_kind),\\\\n    .issue_writer     (ex_issue_writer),')\n    edit('core', '''  forward_unit u_fwd (\n    .ex_match    (id_ex_w.ex_match),\n    .mem_match   (id_ex_w.mem_match),\n    .ex_mem_w_en (mem_write_en),\n    .ex_mem_sel  (ex_mem_w.result_sel),\n    .mem_wb_w_en (mem_wb_w.reg_write),\n    .fwd_rs1     (fwd_rs1_sel),\n    .fwd_rs2     (fwd_rs2_sel)\n  );''', '''  assign fwd_rs1_sel = id_ex_w.fwd_rs1;\n  assign fwd_rs2_sel = id_ex_w.fwd_rs2;''')\n\nprint(out)\nPY\npython3 \\\"\"'$TMPDIR/bench-lane-probe/probe.py\" \"$TMPDIR/bench-lane-probe\" tags\npython3 \"$TMPDIR/bench-lane-probe/probe.py\" \"$TMPDIR/bench-lane-probe\" selects'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
