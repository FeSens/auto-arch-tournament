{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c 'cat > \"$TMPDIR/r8s1-probe/prototype.py\" <<'\"'PY'\nfrom pathlib import Path\n\nrtl = Path('cores/bench/rtl')\n\ndef edit(name, pairs):\n    path = rtl / (name + '.sv')\n    s = path.read_text()\n    for old, new in pairs:\n        assert old in s, (name, old)\n        s = s.replace(old, new, 1)\n    path.write_text(s)\n\nedit('core_pkg', [\n    ('    logic [1:0]  ex_match;', '    logic [1:0]  source_use;\\\\n    logic [1:0]  ex_match;'),\n])\nedit('id_stage', [\n    ('  input  logic              hold,', '''  input  logic              hold,\n  input  logic              replay_accept,\n  input  logic [1:0]        replay_match,\n  input  logic [31:0]       replay_rs1,\n  input  logic [31:0]       replay_rs2,'''),\n    ('  ctrl_t ctrl_decoded;', '''  logic [1:0] source_use;\n  always_comb begin\n    case (in.instr[6:0])\n      7'b0110011, 7'b1100011, 7'b0100011: source_use = 2'b11;\n      7'b0010011, 7'b0000011, 7'b1100111: source_use = 2'b01;\n      default: source_use = 2'b00;\n    endcase\n  end\n\n  ctrl_t ctrl_decoded;'''),\n    ('      reg_q.ex_match      <=', '      reg_q.source_use    <= source_use;\\\\n      reg_q.ex_match      <='),\n    ('''    end else if (same_index_update) begin\n      // Keep the repaired metadata for a candidate held past the write.\n      reg_q.btb_hit       <= btb_hit;\n      reg_q.btb_counter   <= btb_counter;\n    end''', '''    end else begin\n      if (same_index_update) begin\n        reg_q.btb_hit       <= btb_hit;\n        reg_q.btb_counter   <= btb_counter;\n      end\n      if (replay_accept) begin\n        reg_q.rs1_val   <= replay_rs1;\n        reg_q.rs2_val   <= replay_rs2;\n        reg_q.ex_match  <= '0;\n        reg_q.mem_match <= replay_match;\n      end\n    end'''),\n])\nedit('hazard_unit', [\n    ('  input  logic       div_wait,', '  input  logic       load_wait,\\\\n  input  logic       div_wait,'),\n    ('dmem