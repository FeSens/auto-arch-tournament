{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/bash -c \"cat > '/srv/hwebench/tmp/7cb5c576/e5d98d7d/bench-r6s1.n0jgHWRx/queue.py' <<'PY'\nfrom pathlib import Path\nimport shutil\nimport sys\n\np = Path(sys.argv[1])\nshutil.copytree(sys.argv[2], p)\ndepth = int(sys.argv[3])\n\ndef edit(name, *replacements):\n    f = p / (name + '.sv')\n    t = f.read_text()\n    for a,b in replacements:\n        assert a in t, a\n        t = t.replace(a,b,1)\n    f.write_text(t)\n\nedit('core_pkg',\n    ('logic [31:0] pc_plus4;\\\\n    logic [31:0] instr;', 'logic [31:0] pc_plus4;\\\\n    logic [31:0] predicted_pc;\\\\n    logic [31:0] instr;'),\n    ('logic [31:0] direct_target;','logic [31:0] direct_target;\\\\n    logic [31:0] predicted_pc;\\\\n    logic        fence_i;'))\nedit('core',\n    ('  logic        fetch_ready, hold_id;', '  logic        fetch_ready, hold_id, issue_ready;'),\n    ('    .advance_fetch    (fetch_ready && \"'!hold_id),'\"','    .imem_ready       (fetch_ready),\\\\n    .hold_id          (hold_id),\\\\n    .issue_ready      (issue_ready),'),\n    ('    .fetch_ready      (fetch_ready),','    .fetch_ready      (issue_ready),'),\n    ('    .fetch_pc         (io_imemAddr),\\\\n',''))\nedit('id_stage',\n    ('      reg_q.direct_target <= direct_target;', '      reg_q.direct_target <= direct_target;\\\\n      reg_q.predicted_pc <= in.predicted_pc;\\\\n      reg_q.fence_i <= in.instr[14:12] == 3\\\\'b001 && in.instr[6:0] == 7\\\\'b0001111;'))\nedit('ex_stage',\n    ('  input  logic [31:0]        fetch_pc,\\\\n',''),\n    ('fetch_pc == target', 'in.predicted_pc == target'),\n    ('fetch_pc == in.pc_plus4', 'in.predicted_pc == in.pc_plus4 && \"'!in.fence_i'\"'))\nedit('if_stage',\n    ('  input  logic              advance_fetch,','  input  logic              imem_ready,\\\\n  input  logic              hold_id,\\\\n  output logic              issue_ready,'),\n    ('  logic [31:0] pc_plus4, predicted_pc;','  logic [31:0]