cycle in imem_stall_cycles else 1\n        dut.io_dmemReady.value = 1\n\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n        da = int(dut.io_dmemAddr.value)\n        wen = int(dut.io_dmemWEn.value)\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da &\n…[1458 of 4530 chars elided by tools/bench/transcript.py; sha256:bdb142eace8529c8]…\n          # PC=24\n    ]\n\n    rets, _ = await _run(\n        dut,\n        program,\n        dmem_init={0: 0x12345678},\n        imem_stall_cycles={3},\n    )\n\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 8, 20, 24], f\"unexpected retirement PC sequence: {pcs}\"\n    assert all(r[\"pc\"] not in (12, 16) for r in rets), f\"wrong-path retirement leaked: {rets}\"\n\n    [jalr] = [r for r in rets if r[\"pc\"] == 8]\n    assert jalr[\"rd\"] == 1\n    assert jalr[\"rd_wdata\"] == 12\n\n    [target] = [r for r in rets if r[\"pc\"] == 20]\n    assert target[\"rd\"] == 8\n    assert target[\"rd_wdata\"] == 42\n\n\ndef test_branch_redirect_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"divider.sv\", \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_branch_redirect\",\n    )\n", "exit_code": 0, "status": "completed"}}
