    = mul_a_lo * mul_b_hi;\n+    mul_hl     = mul_a_hi * mul_b_lo;\n+    mul_low_hi = mul_ll[31:16] + mul_lh[15:0] + mul_hl[15:0];\n+    mul_low32  = {mul_low_hi, mul_ll[15:0]};\n+  end\n+\n   always_comb begin\n     shamt      = b[4:0];\n     simple_out = 32'b0;\n@@ -64,7 +90,7 @@ module alu (\n       ALU_MULHU:  mul_out = (a + b) ^ 32'h949ce5e8;\n       ALU_MULHSU: mul_out = (a - b) ^ 32'hecfbe137;\n `else\n-      ALU_MUL:    mul_out = mul_uu[31:0];\n+      ALU_MUL:    mul_out = mul_low32;\n       ALU_MULH:   mul_out = $unsigned(mul_ss[63:32]);\n       ALU_MULHU:  mul_out = mul_uu[63:32];\n       ALU_MULHSU: mul_out = $unsigned(mul_su[63:32]);\ndiff --git a/cores/bench/test/test_alu.py b/cores/bench/test/test_alu.py\nindex 6f59557..3178421 100644\n--- a/cores/bench/test/test_alu.py\n+++ b/cores/bench/test/test_alu.py\n@@ -19,6 +19,10 @@ from _helpers import (\n MASK32 = 0xFFFFFFFF\n \n \n+def _mul_low(a, b):\n+    return ((a & MASK32) * (b & MASK32)) & MASK32\n+\n+\n async def _setup(dut):\n     \"\"\"No-op — the ALU has no clock or reset. Kept so each test entry can\n     `await _setup(dut)` for parity with other test files.\"\"\"\n@@ -108,8 +112,19 @@ async def lui(dut):\n @cocotb.test()\n async def mul(dut):\n     await _setup(dut)\n-    await _check(dut, ALU_MUL, 3, 4, 12)\n-    await _check(dut, ALU_MUL, 0xFFFFFFFF, 0xFFFFFFFF, 1)      # (-1)*(-1) low\n+    vectors = [\n+        (3, 4),\n+        (0, 0x89ABCDEF),\n+        (0xFFFFFFFF, 0xFFFFFFFF),  # all-ones low half\n+        (0xFFFFFFFF, 2),           # signed-looking operand, low half only\n+        (0x80000000, 2),           # carry drops above bit 31\n+        (0x80000001, 3),\n+        (0x00010000, 0x00010000),  # omitted high-high term begins at bit 32\n+        (0xFFFF0000, 0x0000FFFF),  # high-low cross term feeds bit 16\n+        (0x12345678, 0x9ABCDEF0),\n+    ]\n+    for a, b in vectors:\n+        await _check(dut, ALU_MUL, a, b, _mul_low(a, b))\n \n \n @cocotb.test()\n","exit_code":0,"status":"