{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/test/test_branch_redirect.py\"", "aggregated_output": "\"\"\"Focused redirect recovery tests for rtl/core.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef JALR(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef EBREAK():           return 0x00100073\n\n\nasync def _run(dut, program, *, dmem_init=None, imem_stall_cycles=frozenset(), max_cycles=80):\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n\n    for cycle in range(max_cycles):\n        ia = int(dut.io_imemAddr.value)\n        da = int(dut.io_dmemAddr.value)\n        dut.io_imemData.value = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        dut.io_imemReady.value = 0 if cycle in imem_stall_cycles else 1\n        dut.io_dmemReady.value = 1\n\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n        da = int(dut.io_dmemAddr.value)\n        wen = int(dut.io_dmemWEn.value)\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da &\n…[1458 of 4530 chars elided by tools/bench/transcript.py; sha256:bdb142eace8529c8]…\n          # PC=24\n    ]\n\n    rets, _ = await _run(\n        dut,\n        program,\n        dmem_init={0: 0x12345678},\n        imem_stall_cycles={3},\n    )\n\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 8, 20, 24], f\"unexpected retirement PC sequence: {pcs}\"\n    assert all(r[\"pc\"] not in (12, 16) for r in rets), f\"wrong-path retirement leaked: {rets}\"\n\n    [jalr] = [r for r in rets if r[\"pc\"] == 8]\n    assert jalr[\"rd\"] == 1\n    assert jalr[\"rd_wdata\"] == 12\n\n    [target] = [r for r in rets if r[\"pc\"] == 20]\n    assert target[\"rd\"] == 8\n    assert target[\"rd_wdata\"] == 42\n\n\ndef test_branch_redirect_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"divider.sv\", \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_branch_redirect\",\n    )\n", "exit_code": 0, "status": "completed"}}
