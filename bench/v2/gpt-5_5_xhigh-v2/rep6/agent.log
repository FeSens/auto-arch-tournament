, \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\ncores/bench/test/test_imm_gen.py:7:from _helpers import run_cocotb\ncores/bench/test/test_imm_gen.py:84:    run_cocotb(toplevel=\"imm_gen\",\ncores/bench/test/test_divider.py:10:    run_cocotb,\ncores/bench/test/test_divider.py:121:    run_cocotb(toplevel=\"divider\",\ncores/bench/test/_helpers.py:50:def run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\ncores/bench/test/test_branch_redirect.py:8:from _helpers import run_cocotb\ncores/bench/test/test_branch_redirect.py:122:    run_cocotb(\ncores/bench/test/test_alu.py:16:    run_cocotb,\ncores/bench/test/test_alu.py:143:    run_cocotb(toplevel=\"alu\",\ncores/bench/test/test_decoder.py:14:    run_cocotb,\ncores/bench/test/test_decoder.py:333:    run_cocotb(toplevel=\"decoder\",\ncores/bench/test/test_reg_file.py:9:from _helpers import run_cocotb\ncores/bench/test/test_reg_file.py:97:    run_cocotb(toplevel=\"reg_file\",\ncores/bench/test/test_pipeline.py:15:from _helpers import run_cocotb\ncores/bench/test/test_pipeline.py:367:    run_cocotb(\n","exit_code":0,"status":"completed"}}
