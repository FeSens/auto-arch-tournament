{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' formal/checks_si.cfg\"","aggregated_output":"[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' formal/wrapper_si.sv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' formal/wrapper_si.sv\"","aggregated_output":"// riscv-formal wrapper for single-issue (`nret 1`) cores. Same shape and\n// memory model as wrapper.sv, but instantiates `core` with only the\n// channel-0 RVFI port set — no `_1` ports. The single-issue path produces\n// only ch0 checks; checks_si.cfg sets `nret 1` so genchecks does not\n// emit any `_ch1` tasks (no PREUNSAT-as-pass tally needed). Selected by\n// the orchestrator when cores/<target>/core.yaml declares nret: 1.\n`include \"rvfi_macros.vh\"\n\nmodule rvfi_wrapper (\n    input clock,\n    input reset,\n    `RVFI_OUTPUTS\n);\n    // Solver picks any 32-bit instruction each cycle.\n    (* keep *) `rvformal_rand_reg [31:0] imem_data;\n\n    // 8 KiB dmem (2048 words).\n    reg [31:0] dmem [0:2047];\n\n    wire [31:0] imem_addr;\n    wire [31:0] dmem_addr;\n    wire [31:0] dmem_wdata;\n    wire [3:0]  dmem_wen;\n    wire        dmem_ren;\n\n    always @(posedge clock) begin\n        if (dmem_wen[0]) dmem[dmem_addr[12:2]][7:0]   <= dmem_wdata[7:0];\n        if (dmem_wen[1]) dmem[dmem_addr[12:2]][15:8]  <= dmem_wdata[15:8];\n        if (dmem_wen[2]) dmem[dmem_addr[12:2]][23:16] <= dmem_wdata[23:16];\n        if (dmem_wen[3]) dmem[dmem_addr[12:2]][31:24] <= dmem_wdata[31:24];\n    end\n\n    core uut (\n        .clock              (clock),\n        .reset              (reset),\n        .io_imemAddr        (imem_addr),\n        .io_imemData        (imem_data),\n        .io_imemReady       (1'b1),\n        .io_dmemAddr        (dmem_addr),\n        .io_dmemWData       (dmem_wdata),\n        .io_dmemRData       (dmem[dmem_addr[12:2]]),\n        .io_dmemWEn         (dmem_wen),\n        .io_dmemREn         (dmem_ren),\n        .io_dmemReady       (1'b1),\n        // Channel 0 — the only retirement channel. With nret=1 in\n        // checks_si.cfg, every rvfi_* signal here is sized for a single\n        