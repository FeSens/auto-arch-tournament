{"type": "item.started", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('formal/riscv-formal/cores/bench-wBipV49QR/checks/reg_ch0/engine_0/trace.vcd')\n# Codes of interest from the VCD header.\nkeys = {\n    'n108':'dready','n110':'dwen','n109':'dwdata','n106':'daddr','n107':'drdata',\n    'n134':'valid','n124':'order','n115':'insn','n125':'pc','n127':'rd','n128':'rddata','n133':'trap',\n    'n129':'rs1','n130':'rs1data','n131':'rs2','n132':'rs2data','n121':'memwdata','n122':'memwmask','n118':'memaddr',\n    'n147':'stall_if','n146':'stall_id','n145':'stall_ex','n103':'hold_wb','n101':'fwd1','n102':'fwd2',\n    'n222':'loadhaz','n224':'rs1_need','n225':'rs2_need','n217':'if_rs1','n219':'if_rs2','n218':'if_opcode',\n    'n313':'wb_fwd_en','n312':'wb_fwd_rd','n311':'wb_fwd_data','n302':'store_fwd','n303':'store_data',\n    'n298':'mem_dwen','n297':'mem_dwdata','n295':'mem_daddr',\n}\nvals={v:'x' for v in keys.values()}\ntime=0\nlast_valid='0'\n\ndef bint(v):\n    if v in ('x','z') or 'x' in v or 'z' in v: return v\n    return int(v,2)\n\ndef fmt(v, width=None):\n    x=bint(v)\n    if isinstance(x,str): return x\n    if width: return f'0x{x:0{width}x}'\n    return str(x)\n\ninteresting=[]\nwith p.open() as f:\n    in_header=True\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line == '\"'$enddefinitions $end'\"':\n            in_header=False\n            continue\n        if in_header: continue\n        if line.startswith('#'):\n            # print at every timestamp where current valid is high? VCD changes before timestamp reflect previous? We'll print on valid rising separately.\n            time=int(line[1:])\n            continue\n        if line.startswith('b'):\n            val, code = line[1:].split()\n        else:\n            val, code = line[0], line[1:]\n        if code in keys:\n            name=keys[code]\n            old=vals.get(name,'x')\n            vals[name]=val\n            if name == 'valid' and val == '1' and old \"'!= '\"'1':\n                interesting.append((time, dict(vals)))\n\nprint('Retirements:')\nfor time, v in interesting:\n    print(f\\\"t={time:>3} order={fmt(v['order'])} pc={fmt(v['pc'],8)} insn={fmt(v['insn'],8)} trap={fmt(v['trap'])} rd={fmt(v['rd'])} rddata={fmt(v['rddata'],8)} rs1=x{fmt(v['rs1'])}:{fmt(v['rs1data'],8)} rs2=x{fmt(v['rs2'])}:{fmt(v['rs2data'],8)} mem[{fmt(v['memwmask'])}]@{fmt(v['memaddr'],8)}={fmt(v['memwdata'],8)}\\\")\n\n# Print compact per-time rows for pipeline controls at all timestamp boundaries by reparsing snapshots.\nvals={v:'x' for v in keys.values()}\nrows=[]; time=0\nwith p.open() as f:\n    in_header=True\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line == '\"'$enddefinitions $end'\"': in_header=False; continue\n        if in_header: continue\n        if line.startswith('#'):\n            if time or rows:\n                rows.append((time, dict(vals)))\n            time=int(line[1:]); continue\n        if line.startswith('b'):\n            val, code = line[1:].split()\n        else:\n            val, code = line[0], line[1:]\n        if code in keys: vals[keys[code]]=val\nrows.append((time, dict(vals)))\nprint('\\\\nTimeline:')\nfor time,v in rows:\n    if time > 22: break\n    print(f\\\"t={time:>2} pc={fmt(v['pc'],8)} insn={fmt(v['insn'],8)} v={fmt(v['valid'])} ord={fmt(v['order'])} rd=x{fmt(v['rd'])}:{fmt(v['rddata'],8)} dRdy={fmt(v['dready'])} dwen={fmt(v['dwen'])} daddr={fmt(v['daddr'],8)} dw={fmt(v['dwdata'],8)} st_if/id/ex={fmt(v['stall_if'])}/{fmt(v['stall_id'])}/{fmt(v['stall_ex'])} hold={fmt(v['hold_wb'])} loadhaz={fmt(v['loadhaz'])} need={fmt(v['rs1_need'])}/{fmt(v['rs2_need'])} ifop={fmt(v['if_opcode'])} ifrs=x{fmt(v['if_rs1'])}/x{fmt(v['if_rs2'])} fwd={fmt(v['fwd1'])}/{fmt(v['fwd2'])} wb=x{fmt(v['wb_fwd_rd'])}:{fmt(v['wb_fwd_data'],8)} we={fmt(v['wb_fwd_en'])} sfwd={fmt(v['store_fwd'])} sdata={fmt(v['store_data'],8)}\\\")\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
