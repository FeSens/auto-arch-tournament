{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/if_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              btb_update_valid,\n  input  logic [31:0]       btb_update_pc,\n  input  logic [31:0]       btb_update_target,\n  input  logic              btb_update_taken,\n  input  logic              btb_update_is_jump,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam int BTB_ENTRIES = 16;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] predicted_pc_next;\n\n  logic [BTB_ENTRIES-1:0] btb_valid;\n  logic [25:0]            btb_tag    [0:BTB_ENTRIES-1];\n  logic [31:0]            btb_target [0:BTB_ENTRIES-1];\n  logic [1:0]             btb_ctr    [0:BTB_ENTRIES-1];\n\n  logic [3:0]  lookup_idx;\n  logic [25:0] lookup_tag;\n  logic        lookup_hit;\n  logic        lookup_taken;\n\n  logic [3:0]  update_idx;\n  logic [25:0] update_tag;\n  logic        update_same_entry;\n  logic [1:0]  update_ctr_next;\n\n  always_comb begin\n…[1307 of 4379 chars elided by tools/bench/transcript.py; sha256:7db6ecfabe8de8b0]…\nution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc        <= RESET_PC;\n      btb_valid <= '0;\n      for (int i = 0; i < BTB_ENTRIES; i++) begin\n        btb_tag[i]    <= '0;\n        btb_target[i] <= '0;\n        btb_ctr[i]    <= 2'b00;\n      end\n    end else begin\n      if (btb_update_valid) begin\n        btb_valid[update_idx]  <= 1'b1;\n        btb_tag[update_idx]    <= update_tag;\n        btb_target[update_idx] <= btb_update_target;\n        btb_ctr[update_idx]    <= update_ctr_next;\n      end\n\n      if      (redirect) pc <= redirect_target;\n      else if (!stall)   pc <= next_pc;\n    end\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc                = pc;\n    out.predicted_pc_next = predicted_pc_next;\n    out.instr             = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid             = !(flush || redirect);\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
