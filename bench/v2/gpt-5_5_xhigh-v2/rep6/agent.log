{"type": "item.completed", "item": {"id": "item_39", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/rtl/muldiv_unit.sv\"", "aggregated_output": "// rtl/muldiv_unit.sv\n//\n// Sequential RV32M function unit. The common EX ALU no longer contains\n// multiplier or divider logic; M-extension instructions start this unit and\n// wait in EX until done goes high.\n//\n// Handshake:\n//   start  : sampled when busy=0 and done=0; latches op/lhs/rhs.\n//   done   : result is valid and held stable until accept.\n//   accept : consumer captured result this cycle; clears done on the edge.\n//\n// Normal builds use iterative shift-add multiply and restoring unsigned\n// divide with signed pre/post-processing. RISCV_FORMAL_ALTOPS builds return\n// the riscv-formal alternative arithmetic formulas after one cycle.\nmodule muldiv_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] lhs,\n  input  logic [31:0] rhs,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n\n  logic        busy_q;\n  logic        done_q;\n  logic        mode_mul_q;\n  logic [31:0] result_q;\n\n  logic [5:0]  count_q;\n\n  logic [63:0] mul_product_q;\n  logic [63:0] mul_multiplicand_q;\n  logic [31:0] mul_multiplier_q;\n  logic        mul_neg_q;\n  logic        mul_high_q;\n\n  logic [31:0] div_divisor_q;\n  logic [31:0] div_dividend_q;\n  logic [31:0] div_quotient_q;\n  logic [32:0] div_remainder_q;\n  logic        div_quotient_neg_q;\n  logic        div_remainder_neg_q;\n  logic        div_want_rem_q;\n\n  logic op_is_mul;\n  logic op_is_div;\n  logic op_is_rem;\n  logic op_is_divrem;\n  logic mul_lhs_signed;\n  logic mul_rhs_signed;\n  logic div_signed;\n  logic lhs_neg;\n  logic rhs_neg;\n  logic [31:0] lhs_mag;\n  logic [31:0] rhs_mag;\n\n  always_comb begin\n    op_is_mul     = (op == ALU_MUL)  || (op ==