{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_divider.py\"", "aggregated_output": "\"\"\"Unit tests for rtl/divider.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\ndef _s32(value: int) -> int:\n    value &= MASK32\n    return value - (1 << 32) if value & (1 << 31) else value\n\n\ndef _rv32_mulh(op: int, a: int, b: int) -> int:\n    a &= MASK32\n    b &= MASK32\n    if op == ALU_MULH:\n        product = _s32(a) * _s32(b)\n    elif op == ALU_MULHSU:\n        product = _s32(a) * b\n    else:\n        product = a * b\n    return (product >> 32) & MASK32\n\n\ndef _rv32_divrem(op: int, a: int, b: int) -> int:\n    a &= MASK32\n    b &= MASK32\n    if op in (ALU_DIV, ALU_REM):\n        sa = _s32(a)\n        sb = _s32(b)\n        if b == 0:\n            return MASK32 if op == ALU_DIV else a\n        if a == 0x80000000 and b == MASK32:\n            return 0x80000000 if op == ALU_DIV else 0\n        q_abs = abs(sa) // abs(sb)\n        q = -q_abs if (sa < 0) ^ (sb < 0) else q_abs\n        r = sa - q * sb\n        return (q if op == ALU_DIV else r) & MASK32\n\n    if b == 0:\n        return MASK32 if op == ALU_DIVU else a\n    return ((a // b) if op == ALU_DIVU else (a % b)) & MASK32\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.op.value = ALU_DIVU\n    dut.a.value = 0\n    dut.b.value = 1\n    await RisingEdge(dut.clock)\n    await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n\n\nasync def _run_one(dut, op: int, a: int, b: int, expected: int, max_cycles: int = 40):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await RisingEdge(dut.clock)\n    dut.start.value = 0\n\n    for cycle in range(max_cycles):\n        await Timer(1, \"ns\")\n        if int(dut.done.value):\n            actual = int(dut.result.value) & MASK32\n            assert actual == (expected & MASK32), (\n                f\"op={op} a=0x{a & \n…[1185 of 4257 chars elided by tools/bench/transcript.py; sha256:f8c464bdaa7656e8]…\n0x80000000, 0xFFFFFFFF),\n        (ALU_DIVU, 0xFFFFFFFF, 2),\n        (ALU_DIVU, 100, 7),\n        (ALU_DIVU, 42, 0),\n        (ALU_REM, 10, 3),\n        (ALU_REM, 0xFFFFFFF6, 3),\n        (ALU_REM, 10, 0xFFFFFFFD),\n        (ALU_REM, 0xDEADBEEF, 0),\n        (ALU_REM, 0x80000000, 0xFFFFFFFF),\n        (ALU_REMU, 7, 3),\n        (ALU_REMU, 0xCAFEBABE, 0),\n    ]\n\n    for op, a, b in vectors:\n        await _run_one(dut, op, a, b, _rv32_divrem(op, a, b))\n\n\n@cocotb.test()\nasync def back_to_back_real_divides(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n\n    for op, a, b in [\n        (ALU_DIVU, 100, 7),\n        (ALU_DIVU, 0xFFFFFFFF, 2),\n        (ALU_DIV, 0xFFFFFFFC, 2),\n        (ALU_REM, 10, 3),\n        (ALU_REMU, 7, 3),\n    ]:\n        cycles = await _run_one(dut, op, a, b, _rv32_divrem(op, a, b))\n        assert cycles >= 32\n\n\ndef test_divider_runner():\n    run_cocotb(toplevel=\"divider\",\n               sources=[\"core_pkg.sv\", \"divider.sv\"],\n               test_module=\"test_divider\")\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"sed -n '1,130p' cores/bench/rtl/alu.sv\"","aggregated_output":"// rtl/alu.sv\n//\n// RV32IM combinational ALU. RV32I operations and low-half MUL stay on the\n// single-cycle execute path. MULH/MULHU/MULHSU and DIV/DIVU/REM/REMU are\n// handled by the slow M-unit in ex_stage.sv, keeping the high-product and\n// divide paths off the hot ALU timing rail.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] simple_out,\n  output logic [31:0] mul_out,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n  logic        [31:0] div_alt_out;\n\n  always_comb begin\n    shamt      = b[4:0];\n    simple_out = 32'b0;\n    case (op)\n      ALU_ADD:  simple_out = a + b;\n      ALU_SUB:  simple_out = a - b;\n      ALU_AND:  simple_out = a & b;\n      ALU_OR:   simple_out = a | b;\n      ALU_XOR:  simple_out = a ^ b;\n      ALU_SLT:  simple_out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU: simple_out = {31'b0, a < b};\n      ALU_SLL:  simple_out = a << shamt;\n      ALU_SRL:  simple_out = a >> shamt;\n      ALU_SRA:  simple_out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:  simple_out = b;\n      default:  simple_out = 32'b0;\n    endcase\n  end\n\n  // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations are\n  // substituted for tractable algebraic stand-ins so bitwuzla can solve the\n  // BMC inside the 20-step depth budget. The Verilator/cocotb/cosim builds\n  // leave ALTOPS undefined and run the real arithmetic.\n  always_comb begin\n    mul_uu  = {32'b0, a} * {32'b0, b};\n    mul_out = 32'b0;\n    case (op)\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    mul_out = (a + b) ^ 32'h5876063e;\n`else\n      ALU_MUL:    mul_out = a * b;\n`endif\n      default:    mul_out = 32'b0;\n    endcase\n  end\n\n  always_comb begin\n    div_alt_out = 32'b0;\n`ifdef RISCV_FORMAL_ALTOPS\n    case (op)\n      ALU_DIV:  div_alt_out = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU: div_alt_out = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:  div_alt_out = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU: div_alt_out = (a - b) ^ 32'h3138d0e1;\n      default:  div_alt_out = 32'b0;\n    endcase\n`endif\n  end\n\n  // Legacy combined output for the standalone ALU tests. The core datapath\n  // consumes simple_out/mul_out directly and gets DIV/REM from divider.sv.\n  always_comb begin\n    case (op)\n      ALU_MUL:    out = mul_out;\n      ALU_DIV,\n      ALU_DIVU,\n      ALU_REM,\n      ALU_REMU:   out = div_alt_out;\n      default:    out = simple_out;\n    endcase\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
