{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('formal/riscv-formal/cores/bench-wke0NW0Ut/checks/reg_ch0/engine_0/trace.vcd')\n# codes for checker_inst rvfi (n23..n42) and top rvfi duplicate (n48..n67)\ncodes = { 'clk':'n16','valid':'n42','order':'n32','insn':'n23','trap':'n41','rd':'n35','rdw':'n36','rs1':'n37','rs1v':'n38','rs2':'n39','rs2v':'n40','pc':'n33','pcn':'n34', 'regshadow':'n19','regwritten':'n20','insn_order':'n17','reg_index':'n18'}\nvals={c:'x' for c in codes.values()}\ntime=0\nrecords=[]\n\ndef parse_val(s):\n    if s in ('x','z'): return None\n    if any(ch in s for ch in 'xz'): return None\n    return int(s,2)\n\ndef commit(t):\n    if vals.get(codes['clk']) == '1':\n        valid=parse_val(vals.get(codes['valid'],'0'))\n        if valid==1:\n            rec={k:parse_val(vals.get(c,'x')) for k,c in codes.items() if k\"'!='\"'clk'}\n            rec['time']=t\n            records.append(rec)\n\nlast_time=None\nfor line in p.read_text(errors='ignore').splitlines():\n    if not line: continue\n    if line[0]=='#':\n        # commit previous time block after all assignments processed; done when next time starts\n        if last_time is not None:\n            commit(last_time)\n        last_time=int(line[1:])\n    elif line[0]=='b':\n        bits, code=line[1:].split()\n        if code in vals: vals[code]=bits\n    elif line[0] in '01xz':\n        bit=line[0]; code=line[1:]\n        if code in vals: vals[code]=bit\nif last_time is not None: commit(last_time)\n\n# Dedup repeated high half-cycle commits by time? Print all.\n\ndef sext(v,bits):\n    if v is None: return None\n    if v & (1<<(bits-1)): return v-(1<<bits)\n    return v\n\ndef disasm(i):\n    if i is None: return 'x'\n    op=i&0x7f; rd=(i>>7)&31; f3=(i>>12)&7; rs1=(i>>15)&31; rs2=(i>>20)&31; f7=(i>>25)&0x7f\n    if i==0x00100073: return 'ebreak'\n    if op==0x33:\n        m={(0,0):'add',(0x20,0):'sub',(0,1):'sll',(0,2):'slt',(0,3):'sltu',(0,4):'xor',(0,5):'srl',(0x20,5):'sra',(0,6):'or',(0,7):'and',(1,0):'mul',(1,1):'mulh',(1,2):'mulhsu',(1,3):'mulhu',(1,4):'div',(1,5):'divu',(1,6):'rem',(1,7):'remu'}\n        return f\\\"{m.get((f7,f3),'op?')} x{rd},x{rs1},x{rs2}\\\"\n    if op==0x13:\n        imm=sext((i>>20)&0xfff,12); m={0:'addi',2:'slti',3:'sltiu',4:'xori',6:'ori',7:'andi',1:'slli',5:'srli/srai'}\n        return f\\\"{m.get(f3,'opi?')} x{rd},x{rs1},{imm}\\\"\n    if op==0x03:\n        imm=sext((i>>20)&0xfff,12); m={0:'lb',1:'lh',2:'lw',4:'lbu',5:'lhu'}\n        return f\\\"{m.get(f3,'load?')} x{rd},{imm}(x{rs1})\\\"\n    if op==0x23:\n        imm=sext(((i>>25)<<5)|((i>>7)&31),12); m={0:'sb',1:'sh',2:'sw'}\n        return f\\\"{m.get(f3,'store?')} x{rs2},{imm}(x{rs1})\\\"\n    if op==0x63:\n        imm=sext(((i>>31)&1)<<12 | ((i>>7)&1)<<11 | ((i>>25)&0x3f)<<5 | ((i>>8)&0xf)<<1,13); m={0:'beq',1:'bne',4:'blt',5:'bge',6:'bltu',7:'bgeu'}\n        return f\\\"{m.get(f3,'br?')} x{rs1},x{rs2},{imm}\\\"\n    if op==0x6f:\n        imm=sext(((i>>31)&1)<<20 | ((i>>12)&0xff)<<12 | ((i>>20)&1)<<11 | ((i>>21)&0x3ff)<<1,21)\n        return f\\\"jal x{rd},{imm}\\\"\n    if op==0x67:\n        imm=sext((i>>20)&0xfff,12); return f\\\"jalr x{rd},x{rs1},{imm}\\\"\n    if op==0x37: return f\\\"lui x{rd},0x{i & 0xfffff000:08x}\\\"\n    if op==0x17: return f\\\"auipc x{rd},0x{i & 0xfffff000:08x}\\\"\n    return f\\\"0x{i:08x}\\\"\n\nseen=set()\nfor r in records:\n    key=(r['order'], r['time'])\n    # print all high samples but there is one per posedge likely\n    print(f\\\"t={r['time']:3} ord={r['order']} pc={r['pc']:08x} insn={r['insn']:08x} {disasm(r['insn']):24} trap={r['trap']} rd=x{r['rd']} rdw={r['rdw']:08x} rs1=x{r['rs1']}:{r['rs1v']:08x} rs2=x{r['rs2']}:{r['rs2v']:08x} shadow={r['regshadow'] if r['regshadow'] is None else format(r['regshadow'],'08x')} written={r['regwritten']} targetord={r['insn_order']} regidx={r['reg_index']}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
