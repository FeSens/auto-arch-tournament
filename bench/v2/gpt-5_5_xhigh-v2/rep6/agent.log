- file: rtl/core.sv\n    description: \"Wire the WB destination, write-enable, and decode source addresses into the new zero-hit predictor/interlock path.\"\n  - file: test/test_wb_zero_hit_predictor.py\n    description: \"Cover distance-three producer-consumer dependencies, x0 immunity, simultaneous bus stalls, redirects, and normal no-hit decode without extra bubbles.\"\n","exit_code":0,"status":"completed"}}
