{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds an independent fetch PC plus a tiny\n// first-word-fall-through FIFO between imem and decode. The fetch side accepts\n// a returned instruction whenever imem_ready is high and space is available,\n// including while ID/EX is held by dmem or divider stalls. The decode side\n// pops one entry only when ID actually captures it.\n//\n// Redirect flushes every queued sequential instruction and restarts fetch at\n// the resolved target. This is only a skid/prefetch buffer, not prediction.\n//\n// Latency:        output is combinational from FIFO head or imem bypass.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              decode_consume,   // ID captured out this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam int FIFO_DEPTH = 4;\n  localparam int PTR_W = 2;\n\n  logic [31:0] fetch_pc_q;\n  logic [31:0] pc_fifo_q    [0:FIFO_DEPTH-1];\n  logic [31:0] instr_fifo_q [0:FIFO_DEPTH-1];\n  logic [PTR_W-1:0] rd_ptr_q;\n  logic [PTR_W-1:0] wr_ptr_q;\n  logic [PTR_W:0]   count_q;\n\n  logic fifo_valid;\n  logic bypass_valid;\n  logic pop_fifo;\n  logic accept_fetch;\n  logic store_fetch;\n\n  assign fifo_valid   = (count_q != '0);\n  assign bypass_valid = (count_q == '0) && imem_ready && !redirect && !reset;\n  assign pop_fifo     = decode_consume && fifo_valid;\n  assign accept_fetch = imem_ready && !redirect && ((count_q < FIFO_DEPTH[PTR_W:0]) || pop_fifo);\n  assign store_fetch  = accept_fetch && !(decode_consume && !fifo_valid);\n\n  // Redirect overrides all queue updates. When a redirect and imem_ready\n  // coincide, the returned instruction still belongs to the old sequential\n  // stream and is deliberately dropped.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      fetch_pc_q <= RESET_PC;\n      rd_ptr_q   <= '0;\n      wr_ptr_q   <= '0;\n      count_q    <= '0;\n    end else if (redirect) begin\n      fetch_pc_q <= redirect_target;\n      rd_ptr_q   <= '0;\n      wr_ptr_q   <= '0;\n      count_q    <= '0;\n    end else begin\n      if (store_fetch) begin\n        pc_fifo_q[wr_ptr_q]    <= fetch_pc_q;\n        instr_fifo_q[wr_ptr_q] <= imem_data;\n        wr_ptr_q               <= wr_ptr_q + {{(PTR_W-1){1'b0}}, 1'b1};\n      end\n\n      if (pop_fifo) begin\n        rd_ptr_q <= rd_ptr_q + {{(PTR_W-1){1'b0}}, 1'b1};\n      end\n\n      case ({store_fetch, pop_fifo})\n        2'b10:   count_q <= count_q + {{PTR_W{1'b0}}, 1'b1};\n        2'b01:   count_q <= count_q - {{PTR_W{1'b0}}, 1'b1};\n        default: count_q <= count_q;\n      endcase\n\n      if (accept_fetch) begin\n        fetch_pc_q <= fetch_pc_q + 32'd4;\n      end\n    end\n  end\n\n  assign imem_addr = fetch_pc_q;\n\n  always_comb begin\n    if (fifo_valid) begin\n      out.pc    = pc_fifo_q[rd_ptr_q];\n      out.instr = instr_fifo_q[rd_ptr_q];\n      out.valid = !redirect && !reset;\n    end else if (bypass_valid) begin\n      out.pc    = fetch_pc_q;\n      out.instr = imem_data;\n      out.valid = 1'b1;\n    end else begin\n      out.pc    = fetch_pc_q;\n      out.instr = 32'h0000_0013; // ADDI x0,x0,0\n      out.valid = 1'b0;\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
