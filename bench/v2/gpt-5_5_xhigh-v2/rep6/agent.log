iority the redirect target would be silently dropped, the\n    40\t  // PC would hold its old (wrong-path) value, and execution would\n    41\t  // resume on the wrong path once the bus unstalls. Verified by the\n    42\t  // VexRiscv-binary CoreMark sweep with --istall enabled.\n    43\t  always_ff @(posedge clock) begin\n    44\t    if      (reset)    pc <= RESET_PC;\n    45\t    else if (redirect) pc <= redirect_target;\n    46\t    else if (!stall)   pc <= next_pc;\n    47\t  end\n    48\t\n    49\t  assign imem_addr = pc;\n    50\t\n    51\t  always_comb begin\n    52\t    out.pc    = pc;\n    53\t    out.instr = flush ? 32'h0000_0013 : imem_data;\n    54\t    out.valid = !flush;\n    55\t  end\n    56\t\n    57\tendmodule\n","exit_code":0,"status":"completed"}}
