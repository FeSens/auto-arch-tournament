{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"sed -n '1,240p' cores/bench/rtl/mul_pipe.sv\"","aggregated_output":"// rtl/mul_pipe.sv\n//\n// One-bubble RV32M multiply sidecar. EX captures already-forwarded operands\n// and holds ID/EX for one cycle; the DSP cone then starts from these sidecar\n// registers and feeds the existing EX/MEM WB_SEL_MUL rail.\nmodule mul_pipe (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        clear,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        valid,\n  output logic [31:0] result,\n  output logic [31:0] captured_a,\n  output logic [31:0] captured_b\n);\n\n  logic        valid_q;\n  logic [4:0]  op_q;\n  logic [31:0] a_q;\n  logic [31:0] b_q;\n\n  // mul_ss/mul_su low halves are unused (only MULH/MULHSU read the high half).\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [63:0] mul_ss;\n  logic        [63:0] mul_uu;\n  logic signed [63:0] mul_su;\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      valid_q <= 1'b0;\n      op_q    <= 5'b0;\n      a_q     <= 32'b0;\n      b_q     <= 32'b0;\n    end else if (start) begin\n      valid_q <= 1'b1;\n      op_q    <= op;\n      a_q     <= a;\n      b_q     <= b;\n    end else if (clear) begin\n      valid_q <= 1'b0;\n    end\n  end\n\n  always_comb begin\n    mul_ss = $signed({{32{a_q[31]}}, a_q}) * $signed({{32{b_q[31]}}, b_q});\n    mul_uu = {32'b0, a_q} * {32'b0, b_q};\n    mul_su = $signed({{32{a_q[31]}}, a_q}) * $signed({32'b0, b_q});\n\n    result = 32'b0;\n    if (valid_q) begin\n      case (op_q)\n`ifdef RISCV_FORMAL_ALTOPS\n        ALU_MUL:    result = (a_q + b_q) ^ 32'h5876063e;\n        ALU_MULH:   result = (a_q + b_q) ^ 32'hf6583fb7;\n        ALU_MULHU:  result = (a_q + b_q) ^ 32'h949ce5e8;\n        ALU_MULHSU: result = (a_q - b_q) ^ 32'hecfbe137;\n`else\n        ALU_MUL:    result = mul_uu[31:0];\n        ALU_MULH:   result = $unsigned(mul_ss[63:32]);\n        ALU_MULHU:  result = mul_uu[63:32];\n        ALU_MULHSU: result = $unsigned(mul_su[63:32]);\n`endif\n        default:    result = 32'b0;\n      endcase\n    end\n  end\n\n  assign valid      = valid_q;\n  assign captured_a = a_q;\n  assign captured_b = b_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
