{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom collections import Counter, defaultdict\nfrom test.cosim.reference import RV32IM, MASK\n\nclass Probe(RV32IM):\n    def __init__(self):\n        super().__init__()\n        self.active = False\n        self.started = False\n        self.stopped = False\n    def _note(self, addr):\n        if addr == 0x10000100:\n            self.active = True; self.started = True\n        elif addr == 0x10000104:\n            self.active = False; self.stopped = True\n    def wb(self, addr, v):\n        self._note(addr)\n        super().wb(addr, v)\n    def whw(self, addr, v):\n        self._note(addr)\n        super().whw(addr, v)\n    def ww(self, addr, v):\n        self._note(addr)\n        super().ww(addr, v)\n\ndef sx(v,b): return v - (1<<b) if v >> (b-1) else v\ncpu = Probe(); cpu.load_elf('bench/programs/coremark.elf')\ncounts = Counter(); total = Counter(); nontaken = Counter(); targets = {}; instrs = {}; active_insns=0\nall_counts = Counter();\nfor i in range(20_000_000):\n    pc = cpu.pc\n    instr = cpu.rw(pc)\n    op = instr & 0x7f\n    imm_b = sx(((instr>>31)<<12)|(((instr>>7)&1)<<11)|(((instr>>25)&0x3f)<<5)|(((instr>>8)&0xf)<<1),13)\n    target = (pc + imm_b) & MASK\n    was_active = cpu.active\n    r = cpu.step()\n    if r is None: break\n    if was_active:\n        active_insns += 1\n        if op == 0x63 and target < pc:\n            total[(pc,target)] += 1\n            targets[pc]=target; instrs[pc]=instr\n            if r['npc'] == target:\n                counts[(pc,target)] += 1\n            else:\n                nontaken[(pc,target)] += 1\n    if op == 0x63 and target < pc and r['npc'] == target:\n        all_counts[(pc,target)] += 1\n    if instr == 0x00100073 or cpu.stopped:\n        # continue after stop maybe prints; stop branch profiling\n        if cpu.stopped:\n            break\nprint('retired', cpu.retired, 'active_insns', active_insns, 'started', cpu.started, 'stopped', cpu.stopped, 'pc', hex(cpu.pc))\nprint('top active backward conditional branches:')\nfor (pc,t), c in counts.most_common(40):\n    print(f'pc=0x{pc:08x} target=0x{t:08x} taken={c} total={total[(pc,t)]} nt={nontaken[(pc,t)]} instr=0x{instrs[pc]:08x}')\nprint('top all taken backward conditionals:')\nfor (pc,t), c in all_counts.most_common(20):\n    print(f'pc=0x{pc:08x} target=0x{t:08x} taken={c}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
