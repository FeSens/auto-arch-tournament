{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -c \"sed -n '1,260p' cores/bench/test/test_divider.py\"","aggregated_output":"\"\"\"Unit tests for rtl/divider.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\ndef _s32(value: int) -> int:\n    value &= MASK32\n    return value - (1 << 32) if value & (1 << 31) else value\n\n\ndef _rv32_divrem(op: int, a: int, b: int) -> int:\n    a &= MASK32\n    b &= MASK32\n    if op in (ALU_DIV, ALU_REM):\n        sa = _s32(a)\n        sb = _s32(b)\n        if b == 0:\n            return MASK32 if op == ALU_DIV else a\n        if a == 0x80000000 and b == MASK32:\n            return 0x80000000 if op == ALU_DIV else 0\n        q_abs = abs(sa) // abs(sb)\n        q = -q_abs if (sa < 0) ^ (sb < 0) else q_abs\n        r = sa - q * sb\n        return (q if op == ALU_DIV else r) & MASK32\n\n    if b == 0:\n        return MASK32 if op == ALU_DIVU else a\n    return ((a // b) if op == ALU_DIVU else (a % b)) & MASK32\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.op.value = ALU_DIVU\n    dut.a.value = 0\n    dut.b.value = 1\n    await RisingEdge(dut.clock)\n    await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n\n\nasync def _run_one(dut, op: int, a: int, b: int, expected: int, max_cycles: int = 40):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await RisingEdge(dut.clock)\n    dut.start.value = 0\n\n    for cycle in range(max_cycles):\n        await Timer(1, \"ns\")\n        if int(dut.done.value):\n            actual = int(dut.result.value) & MASK32\n            assert actual == (expected & MASK32), (\n                f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n                f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n            )\n            await RisingEdge(dut.clock)\n            return cycle + 1\n        await RisingEdge(dut.clock)\n\n    raise AssertionError(f\"divider did not finish within {max_cycles} cycles\")\n\n\n@cocotb.test()\nasync def rv32m_divrem_vectors(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n\n    vectors = [\n        (ALU_DIV, 10, 3),\n        (ALU_DIV, 0xFFFFFFFC, 2),\n        (ALU_DIV, 7, 0xFFFFFFFE),\n        (ALU_DIV, 123, 0),\n        (ALU_DIV, 0, 0),\n        (ALU_DIV, 0x80000000, 0xFFFFFFFF),\n        (ALU_DIVU, 0xFFFFFFFF, 2),\n        (ALU_DIVU, 100, 7),\n        (ALU_DIVU, 42, 0),\n        (ALU_REM, 10, 3),\n        (ALU_REM, 0xFFFFFFF6, 3),\n        (ALU_REM, 10, 0xFFFFFFFD),\n        (ALU_REM, 0xDEADBEEF, 0),\n        (ALU_REM, 0x80000000, 0xFFFFFFFF),\n        (ALU_REMU, 7, 3),\n        (ALU_REMU, 0xCAFEBABE, 0),\n    ]\n\n    for op, a, b in vectors:\n        await _run_one(dut, op, a, b, _rv32_divrem(op, a, b))\n\n\n@cocotb.test()\nasync def back_to_back_real_divides(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n\n    for op, a, b in [\n        (ALU_DIVU, 100, 7),\n        (ALU_DIVU, 0xFFFFFFFF, 2),\n        (ALU_DIV, 0xFFFFFFFC, 2),\n        (ALU_REM, 10, 3),\n        (ALU_REMU, 7, 3),\n    ]:\n        cycles = await _run_one(dut, op, a, b, _rv32_divrem(op, a, b))\n        assert cycles >= 32\n\n\ndef test_divider_runner():\n    run_cocotb(toplevel=\"divider\",\n               sources=[\"core_pkg.sv\", \"divider.sv\"],\n               test_module=\"test_divider\")\n","exit_code":0,"status":"completed"}}
