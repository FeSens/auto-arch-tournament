{"type": "item.completed", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/core.sv cores/bench/rtl/hazard_unit.sv cores/bench/rtl/reg_file.sv'", "aggregated_output": "diff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex a9dc7eb..2146c61 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -6,7 +6,7 @@\n //   |    |     ^\n //   |    +-----+    forward_unit drives EX-stage rs1/rs2 muxes\n //   |               from EX/MEM and MEM/WB\n-//   +- stall <- hazard_unit (load-use)\n+//   +- stall <- hazard_unit (load-use / WB-to-ID predictor miss)\n //\n // IO port names use the `io_*` Chisel-emit prefix so the existing\n // formal/wrapper_si.sv and test/cosim/main.cpp bindings carry through\n@@ -188,6 +188,8 @@ module core (\n     .id_ex_rd       (id_ex_w.rd),\n     .if_id_rs1      (if_id_w.instr[19:15]),\n     .if_id_rs2      (if_id_w.instr[24:20]),\n+    .wb_w_en        (wb_w_en),\n+    .wb_rd          (wb_w_addr),\n     .redirect       (redirect),\n     .imem_ready     (io_imemReady),\n     .dmem_ready     (io_dmemReady),\ndiff --git a/cores/bench/rtl/hazard_unit.sv b/cores/bench/rtl/hazard_unit.sv\nindex e3d5898..296ed1e 100644\n--- a/cores/bench/rtl/hazard_unit.sv\n+++ b/cores/bench/rtl/hazard_unit.sv\n@@ -1,7 +1,8 @@\n // rtl/hazard_unit.sv\n //\n // Detects the hazards the textbook 5-stage doesn't cover via forwarding:\n-// load-use, dmem backpressure, and multi-cycle EX operations.\n+// load-use, WB-to-ID zero-hit predictor misses, dmem backpressure, and\n+// multi-cycle EX operations.\n //\n // Outputs:\n //   stall_if / stall_id : freeze the PC reg and the IF/ID combinational\n@@ -10,9 +11,9 @@\n //                          instruction (imem backpressure).\n //   flush_id            : on EX redirect, kill the instruction in ID before\n //                          it can enter EX.\n-//   flush_id            : also kills ID's own register on load-use to\n-//                          inject a single-cycle bubble between LOAD\n-//                          and the dependent instruction.\n+//   flush_id            : also kills ID's own register on load-use or a\n+//                          WB-to-ID match to inject a single-cycle bubble\n+//                          before the dependent i\n…[3741 of 6813 chars elided by tools/bench/transcript.py; sha256:a6fd481de21ee25d]…\na\n-//     and lets the ID stage see WB-stage writes within the same cycle\n-//     without an extra forwarding mux.\n+//   - No same-cycle write-first bypass. A WB-to-ID match is predicted not\n+//     to happen; hazard_unit inserts one bubble on a miss so ID rereads the\n+//     just-written architectural value on the following cycle.\n //\n // The reset clears all 32 registers. Distributed-LUT or flop inference is\n // fine here; explicit BRAM attribution lives on the larger imem/dmem\n@@ -40,19 +39,8 @@ module reg_file (\n   end\n \n   always_comb begin\n-    if (rs1_addr == 5'b0)\n-      rs1_data = 32'b0;\n-    else if (w_en && w_addr == rs1_addr)\n-      rs1_data = w_data;\n-    else\n-      rs1_data = regs[rs1_addr];\n-\n-    if (rs2_addr == 5'b0)\n-      rs2_data = 32'b0;\n-    else if (w_en && w_addr == rs2_addr)\n-      rs2_data = w_data;\n-    else\n-      rs2_data = regs[rs2_addr];\n+    rs1_data = (rs1_addr == 5'b0) ? 32'b0 : regs[rs1_addr];\n+    rs2_data = (rs2_addr == 5'b0) ? 32'b0 : regs[rs2_addr];\n   end\n \n endmodule\n", "exit_code": 0, "status": "completed"}}
