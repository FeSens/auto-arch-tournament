bench/rtl/if_stage.sv b/cores/bench/rtl/if_stage.sv\nindex 8b2daa3..e26358c 100644\n--- a/cores/bench/rtl/if_stage.sv\n+++ b/cores/bench/rtl/if_stage.sv\n@@ -5,9 +5,11 @@\n // flop in this microarchitecture, the next-stage's ID/EX register\n // captures everything one cycle later.\n //\n-// On flush or redirect, the instruction word remains the raw imem data and\n-// only the valid bit is cleared. ID turns invalid fetches into zero bubbles;\n-// hazard logic also gates source comparisons with this valid bit.\n+// On flush, the instruction word remains the raw imem data and only the valid\n+// bit is cleared. ID turns invalid fetches into zero bubbles; hazard logic\n+// also gates source comparisons with this valid bit. Redirect squashing is\n+// owned by the ID/EX flush path in hazard_unit; fetch only gives redirect\n+// priority for the PC register update.\n //\n // Latency:        PC-reg update is synchronous; output is combinational.\n // RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n@@ -30,7 +32,7 @@ module if_stage (\n   logic [31:0] next_pc;\n \n   always_comb begin\n-    next_pc = redirect ? redirect_target : pc + 32'd4;\n+    next_pc = pc + 32'd4;\n   end\n \n   // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n@@ -50,7 +52,7 @@ module if_stage (\n   always_comb begin\n     out.pc    = pc;\n     out.instr = imem_data;\n-    out.valid = !(flush || redirect);\n+    out.valid = !flush;\n   end\n \n endmodule\n","exit_code":0,"status":"completed"}}
