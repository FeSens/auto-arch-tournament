{"type": "item.completed", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,280p' cores/bench/test/test_redirect_flush.py\"", "aggregated_output": "\"\"\"Redirect flush regressions with imem/dmem backpressure.\n\nThe IF/ID boundary is combinational in this core, so EX redirects are\nsupposed to squash the decoded wrong-path instruction only through the\nID/EX flush path. These tests keep an older STORE in MEM while a redirecting\ninstruction is in EX, then sweep imem and dmem stalls on that same cycle.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    b12 = (imm >> 12) & 1\n    b105 = (imm >> 5) & 0x3F\n    b41 = (imm >> 1) & 0xF\n    b11 = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    b20 = (imm >> 20) & 1\n    b101 = (imm >> 1) & 0x3FF\n    b11 = (imm >> 11) & 1\n    b1912 = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm, rs1, 0b000, rd, 0b0010011)\ndef SW(rs2, rs1, imm): return _s(imm, rs2, rs1, 0b010, 0b0100011)\ndef BEQ(rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL(rd, imm): return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm): return _i(imm, rs1, 0b000, rd, 0b1100111)\ndef EBREAK(): return 0x00100073\n\n\n…[5463 of 8535 chars elided by tools/bench/transcript.py; sha256:41f95d16b32b0daf]…\n= [\n        ADDI(1, 0, 7),         # PC=0\n        ADDI(2, 0, 20),        # PC=4, JALR target\n        SW(1, 0, 0),           # PC=8, held in MEM for dmem-stall cases\n        JALR(5, 2, 0),         # PC=12, taken to PC=20\n        ADDI(10, 0, 111),      # PC=16, decoded wrong-path instruction\n        ADDI(11, 0, 42),       # PC=20\n        EBREAK(),              # PC=24\n    ]\n    await _sweep_stalls(\n        dut,\n        program,\n        expected_pcs=[0, 4, 8, 12, 20, 24],\n        redirect_pc=12,\n        target_pc=20,\n        wrong_pc=16,\n    )\n\n\ndef test_redirect_flush_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"mulh_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_redirect_flush\",\n    )\n", "exit_code": 0, "status": "completed"}}
