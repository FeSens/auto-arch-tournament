{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/alu.sv\"", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM combinational ALU. Low-half MUL remains in this one-cycle hot lane.\n// Real MULH/MULHU/MULHSU and DIV/REM arithmetic is intentionally outside this\n// module: ex_stage routes those operations through cold sidecar units. Under\n// RISCV_FORMAL_ALTOPS the formal substitute formulas remain here to match\n// riscv-formal's ALTOPS spec.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic [4:0]  shamt;\n\n  logic        sub_mode;\n  logic [31:0] addsub_b;\n  logic [32:0] addsub_ext;\n  logic [31:0] addsub_result;\n  logic        sub_carry_out;\n  logic        slt_signed;\n  logic        slt_unsigned;\n  logic [31:0] arith_result;\n\n  logic [31:0] logic_result;\n  logic [31:0] shift_result;\n  logic [31:0] mul_result;\n\n  logic        arith_family;\n  logic        logic_family;\n  logic        shift_family;\n  logic        lui_family;\n  logic        mul_family;\n\n`ifndef RISCV_FORMAL_ALTOPS\n  logic [31:0] mul_lo;\n`else\n  logic [31:0] altops_const;\n`endif\n\n  always_comb begin\n    shamt = b[4:0];\n\n    sub_mode = (op == ALU_SUB)  || (op == ALU_SLT) ||\n               (op == ALU_SLTU);\n\n`ifndef RISCV_FORMAL_ALTOPS\n    mul_lo = a * b;\n`else\n    case (op)\n      ALU_MUL:    altops_const = 32'h5876063e;\n      ALU_MULH:   altops_const = 32'hf6583fb7;\n      ALU_MULHU:  altops_const = 32'h949ce5e8;\n      ALU_MULHSU: altops_const = 32'hecfbe137;\n      ALU_DIV:    altops_const = 32'h7f8529ec;\n      ALU_DIVU:   altops_const = 32'h10e8fd70;\n      ALU_REM:    altops_const = 32'h8da68fa5;\n      ALU_REMU:   altops_const = 32'h3138d0e1;\n      default:    altops_const = 32'b0;\n    endcase\n\n    sub_mode = sub_mode ||\n               (op == ALU_MULHSU) || (op == ALU_DIV)  ||\n               (op == ALU_DIVU)   || (op == ALU_REM)  ||\n               (op == ALU_REMU);\n`endif\n\n    addsub_b       = sub_mode ? ~b : b;\n    addsub_ext     = {1'b0, a} + {1'b0, addsub_b} + {32'b0, sub_mode};\n    addsub_result  = addsub_ext[31:0];\n    sub_carry_out  = addsub_ext[32];\n    slt_signed     = (a[31] ^ b[31]) ? a[31] : addsub_result[31];\n    slt_unsigned   = ~sub_carry_out;\n\n    case (op)\n      ALU_SLT:  arith_result = {31'b0, slt_signed};\n      ALU_SLTU: arith_result = {31'b0, slt_unsigned};\n      default:  arith_result = addsub_result;\n    endcase\n\n    case (op)\n      ALU_AND:  logic_result = a & b;\n      ALU_OR:   logic_result = a | b;\n      default:  logic_result = a ^ b;\n    endcase\n\n    case (op)\n      ALU_SLL:  shift_result = a << shamt;\n      ALU_SRA:  shift_result = $unsigned($signed(a) >>> shamt);\n      default:  shift_result = a >> shamt;\n    endcase\n\n`ifdef RISCV_FORMAL_ALTOPS\n    mul_result = addsub_result ^ altops_const;\n`else\n    mul_result = (op == ALU_MUL) ? mul_lo : 32'b0;\n`endif\n\n    arith_family = (op == ALU_ADD) || (op == ALU_SUB) ||\n                   (op == ALU_SLT) || (op == ALU_SLTU);\n    logic_family = (op == ALU_AND) || (op == ALU_OR)  || (op == ALU_XOR);\n    shift_family = (op == ALU_SLL) || (op == ALU_SRL) || (op == ALU_SRA);\n    lui_family   = (op == ALU_LUI);\n    mul_family   = (op == ALU_MUL)    || (op == ALU_MULH) ||\n                   (op == ALU_MULHU)  || (op == ALU_MULHSU) ||\n                   (op == ALU_DIV)    || (op == ALU_DIVU) ||\n                   (op == ALU_REM)    || (op == ALU_REMU);\n\n    case (op)\n      default: begin\n        case (1'b1)\n          arith_family: out = arith_result;\n          logic_family: out = logic_result;\n          shift_family: out = shift_result;\n          lui_family:   out = b;\n          mul_family:   out = mul_result;\n          default:      out = 32'b0;\n        endcase\n      end\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
