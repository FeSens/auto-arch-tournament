ds.\n+\"\"\"\n from __future__ import annotations\n \n import cocotb\n@@ -40,12 +43,31 @@ async def _read(dut, rs1, rs2):\n \n \n @cocotb.test()\n-async def reset_clears_all(dut):\n+async def startup_initializes_registers(dut):\n     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n-    await _reset(dut)\n+    dut.reset.value    = 0\n+    dut.w_en.value     = 0\n+    dut.w_addr.value   = 0\n+    dut.w_data.value   = 0\n+    dut.rs1_addr.value = 0\n+    dut.rs2_addr.value = 0\n+    dut.rvfi_rs1_addr.value = 0\n+    dut.rvfi_rs2_addr.value = 0\n+    await Timer(1, \"ns\")\n     for r in range(32):\n         rs1, _ = await _read(dut, r, 0)\n-        assert rs1 == 0, f\"x{r} after reset = 0x{rs1:08x}\"\n+        assert rs1 == 0, f\"x{r} at startup = 0x{rs1:08x}\"\n+\n+\n+@cocotb.test()\n+async def reset_does_not_clear_nonzero_registers(dut):\n+    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n+    await _reset(dut)\n+    await _write(dut, 6, 0x13579BDF)\n+    await _reset(dut)\n+    rs1, rs2 = await _read(dut, 6, 0)\n+    assert rs1 == 0x13579BDF\n+    assert rs2 == 0\n \n \n @cocotb.test()\n@@ -95,6 +117,24 @@ async def two_read_ports(dut):\n     assert rs2 == 0xBBBBBBBB\n \n \n+@cocotb.test()\n+async def rvfi_raw_reads_do_not_bypass_own_writeback(dut):\n+    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n+    await _reset(dut)\n+    await _write(dut, 8, 0x11112222)\n+\n+    dut.rs1_addr.value = 8\n+    dut.rvfi_rs1_addr.value = 8\n+    dut.w_en.value     = 1\n+    dut.w_addr.value   = 8\n+    dut.w_data.value   = 0x33334444\n+    await Timer(1, \"ns\")\n+\n+    assert int(dut.rs1_data.value) == 0x33334444\n+    assert int(dut.rvfi_rs1_data.value) == 0x11112222\n+    dut.w_en.value = 0\n+\n+\n def test_reg_file_runner():\n     run_cocotb(toplevel=\"reg_file\",\n                sources=[\"reg_file.sv\"],\n","exit_code":0,"status":"completed"}}
