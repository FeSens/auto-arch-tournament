{"type": "item.completed", "item": {"id": "item_32", "type": "command_execution", "command": "/bin/bash -c 'tail -80 cores/bench/test/test_pipeline.py && tail -60 cores/bench/test/test_hazard.py'", "aggregated_output": "        ADD(4, 3, 3),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=80)\n    by_pc = {r[\"pc\"]: r for r in rets}\n    assert by_pc[4][\"rd_wdata\"] == 1\n    assert by_pc[8][\"rd_wdata\"] == 2\n    assert by_pc[4][\"rs1_rdata\"] == 0xFFFFFFFF\n    assert by_pc[4][\"rs2_rdata\"] == 0xFFFFFFFF\n\n\n@cocotb.test()\nasync def high_multiply_sidecar_retire_and_forward(dut):\n    program = [\n        ADDI(1, 0, -1),\n        ADDI(2, 0, 2),\n        MUL(3, 1, 1),\n        MULH(4, 1, 2),\n        ADD(5, 4, 2),\n        MULHU(6, 1, 1),\n        MULHSU(7, 1, 1),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=180)\n    by_pc = {r[\"pc\"]: r for r in rets}\n    assert by_pc[8][\"rd_wdata\"] == 1\n    assert by_pc[12][\"rd_wdata\"] == 0xFFFFFFFF\n    assert by_pc[16][\"rd_wdata\"] == 1\n    assert by_pc[20][\"rd_wdata\"] == 0xFFFFFFFE\n    assert by_pc[24][\"rd_wdata\"] == 0xFFFFFFFF\n\n\n@cocotb.test()\nasync def iterative_div_retire_and_forward(dut):\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIV(3, 1, 2),\n        ADD(4, 3, 2),\n        REM(5, 1, 2),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=160)\n    by_pc = {r[\"pc\"]: r for r in rets}\n    assert by_pc[8][\"rd_wdata\"] == 14\n    assert by_pc[12][\"rd_wdata\"] == 21\n    assert by_pc[16][\"rd_wdata\"] == 2\n    assert by_pc[8][\"rs1_rdata\"] == 100\n    assert by_pc[8][\"rs2_rdata\"] == 7\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"mulh_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n    assert int(dut.stall_id.value) == 0\n    assert int(dut.flush_id.value) == 0\n\n\n@cocotb.test()\nasync def true_load_use_hazards_stall(dut):\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 5\n    dut.if_id_rs1.value = 5\n    dut.if_id_uses_rs1.value = 1\n    await _settle(dut)\n    assert int(dut.stall_if.value) == 1\n    assert int(dut.stall_id.value) == 1\n    assert int(dut.flush_id.value) == 1\n\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 6\n    dut.if_id_rs2.value = 6\n    dut.if_id_uses_rs2.value = 1\n    await _settle(dut)\n    assert int(dut.stall_if.value) == 1\n    assert int(dut.stall_id.value) == 1\n    assert int(dut.flush_id.value) == 1\n\n\n@cocotb.test()\nasync def immediate_rs2_bitfield_does_not_stall(dut):\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 7\n    dut.if_id_rs1.value = 1\n    dut.if_id_rs2.value = 7\n    dut.if_id_uses_rs1.value = 1\n    dut.if_id_uses_rs2.value = 0\n    await _settle(dut)\n    _assert_no_load_stall(dut)\n\n\n@cocotb.test()\nasync def invalid_if_id_work_does_not_stall(dut):\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 9\n    dut.if_id_rs1.value = 9\n    dut.if_id_rs2.value = 9\n    dut.if_id_valid.value = 0\n    dut.