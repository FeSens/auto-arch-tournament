ench/test/test_mulh_unit.py:    await _check(dut, ALU_MULHSU, 7, 3, 0)\ncores/bench/test/test_mulh_unit.py:    await _check(dut, ALU_MULH, 0xFFFFFFFE, 2, 0xFFFFFFFF)\ncores/bench/test/test_mulh_unit.py:    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\ncores/bench/test/test_mulh_unit.py:    awa\n…[10840 of 13912 chars elided by tools/bench/transcript.py; sha256:eff72e3fb9a7f043]…\n 5'd4;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_SLT    = 5'd5;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_SLTU   = 5'd6;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_SLL    = 5'd7;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_SRL    = 5'd8;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_SRA    = 5'd9;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_LUI    = 5'd10;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_MUL    = 5'd11;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_MULH   = 5'd12;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_MULHU  = 5'd13;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_MULHSU = 5'd14;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_DIV    = 5'd15;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_DIVU   = 5'd16;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_REM    = 5'd17;\ncores/bench/rtl/core_pkg.sv:  localparam logic [4:0] ALU_REMU   = 5'd18;\n", "exit_code": 0, "status": "completed"}}
