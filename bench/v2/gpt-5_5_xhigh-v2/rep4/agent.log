{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds a sequential fetch PC and a small\n// fall-through prefetch FIFO. The IF/ID payload is combinational: it is the\n// FIFO head when queued work exists, or the current imem word as a direct\n// empty-queue bypass when io_imemReady is high.\n//\n// The backend stall input stops only dequeue into decode. Fetch can continue\n// enqueueing behind the held head while the backend waits on dmem, DIV/REM,\n// or a load-use bubble. Redirect flushes all queued wrong-path work and\n// restarts the fetch PC at the target.\n//\n// Latency:        fetch PC / FIFO updates are synchronous; output is\n//                 combinational with a zero-wait empty-queue bypass.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // backend cannot dequeue\n  input  logic              flush,            // kill queued/current fetch\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  input  logic              imem_ready,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam int FIFO_DEPTH = 4;\n  localparam logic [2:0] FIFO_DEPTH_COUNT = 3'd4;\n\n  logic [31:0] fetch_pc_q;\n  fetch_entry_t fifo_q [0:FIFO_DEPTH-1];\n  logic [2:0] count_q;\n\n  logic kill_fetch;\n  logic fifo_empty;\n  logic fifo_full;\n  logic queue_pop;\n  logic bypass_used;\n  logic space_after_pop;\n  logic fetch_accept;\n  logic fetch_to_fifo;\n  logic [2:0] count_after_pop;\n  logic [2:0] count_next;\n  logic [2:0] push_index;\n\n  always_comb begin\n    kill_fetch      = flush || redirect;\n    fifo_empty      = (count_q == 3'd0);\n    fifo_full       = (count_q == FIFO_DEPTH_COUNT);\n\n    queue_pop       = !kill_fetch && !stall && !fifo_empty;\n    bypass_used     = !kill_fetch && !stall && fifo_empty && imem_ready;\n    space_after_pop = !fifo_full || queue_pop;\n    fetch_accept    = !kill_fetch && imem_ready && space_after_pop;\n    fetch_to_fifo   = fetch_accept && !bypass_used;\n\n    count_after_pop = count_q - {2'b0, queue_pop};\n    count_next      = count_after_pop + {2'b0, fetch_to_fifo};\n    push_index      = count_after_pop;\n  end\n\n  // Redirect must override any backend stall. A branch/jump in EX may resolve\n  // while an older memory op is holding the backend; the fetch queue is wrong\n  // path in that case and must be discarded immediately.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      fetch_pc_q <= RESET_PC;\n      count_q    <= 3'd0;\n    end else if (kill_fetch) begin\n      fetch_pc_q <= redirect ? redirect_target : fetch_pc_q;\n      count_q    <= 3'd0;\n    end else begin\n      if (fetch_accept) begin\n        fetch_pc_q <= fetch_pc_q + 32'd4;\n      end\n\n      if (queue_pop) begin\n        for (int i = 0; i < FIFO_DEPTH-1; i++) begin\n          fifo_q[i] <= fifo_q[i+1];\n        end\n      end\n\n      if (fetch_to_fifo) begin\n        fifo_q[push_index] <= '{pc: fetch_pc_q, instr: imem_data};\n      end\n\n      count_q <= count_next;\n    end\n  end\n\n  assign imem_addr = fetch_pc_q;\n\n  always_comb begin\n    if (!fifo_empty) begin\n      out.pc    = fifo_q[0].pc;\n      out.instr = fifo_q[0].instr;\n    end else begin\n      out.pc    = fetch_pc_q;\n      out.instr = imem_data;\n    end\n    out.valid = !kill_fetch && (!fifo_empty || imem_ready);\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
