{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/direct_predictor.sv\"","aggregated_output":"// rtl/direct_predictor.sv\n//\n// Tiny exact-PC direct-control predictor.  The table is intentionally small\n// and direct-mapped so IF lookup is one full-tag compare plus a target mux.\n// Training is sampled into registered table state; a same-cycle EX outcome\n// cannot feed the IF lookup combinationally.\nmodule direct_predictor (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [31:0] lookup_pc,\n  output logic        lookup_taken,\n  output logic [31:0] lookup_target,\n\n  input  logic        train_valid,\n  input  logic        train_taken,\n  input  logic        train_is_jal,\n  input  logic [31:0] train_pc,\n  input  logic [31:0] train_target\n);\n\n`ifdef RISCV_FORMAL_ALIGNED_MEM\n  always_comb begin\n    lookup_taken  = 1'b0;\n    lookup_target = 32'b0;\n  end\n`else\n  logic        valid_q  [0:1];\n  logic [1:0]  conf_q   [0:1];\n  logic [31:0] tag_q    [0:1];\n  logic [31:0] target_q [0:1];\n\n  logic lookup_idx;\n  logic train_idx;\n  logic lookup_match;\n  logic train_match;\n  logic train_backward;\n  logic train_alloc;\n\n  always_comb begin\n    lookup_idx     = lookup_pc[2];\n    train_idx      = train_pc[2];\n    lookup_match   = valid_q[lookup_idx] && (tag_q[lookup_idx] == lookup_pc);\n    train_match    = valid_q[train_idx] && (tag_q[train_idx] == train_pc);\n    train_backward = (train_target < train_pc);\n    train_alloc    = train_is_jal || (train_taken && train_backward);\n\n    lookup_taken  = lookup_match && conf_q[lookup_idx][1];\n    lookup_target = target_q[lookup_idx];\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      valid_q[0]  <= 1'b0;\n      valid_q[1]  <= 1'b0;\n      conf_q[0]   <= 2'b00;\n      conf_q[1]   <= 2'b00;\n      tag_q[0]    <= 32'b0;\n      tag_q[1]    <= 32'b0;\n      target_q[0] <= 32'b0;\n      target_q[1] <= 32'b0;\n    end else if (train_valid) begin\n      if (train_alloc) begin\n        valid_q[train_idx]  <= 1'b1;\n        tag_q[train_idx]    <= train_pc;\n        target_q[train_idx] <= {train_target[31:2], 2'b00};\n        if (train_match && conf_q[train_idx] != 2'b11)\n          conf_q[train_idx] <= conf_q[train_idx] + 2'b01;\n        else\n          conf_q[train_idx] <= 2'b11;\n      end else if (!train_taken && train_match) begin\n        if (conf_q[train_idx] != 2'b00)\n          conf_q[train_idx] <= conf_q[train_idx] - 2'b01;\n        if (conf_q[train_idx] == 2'b01)\n          valid_q[train_idx] <= 1'b0;\n      end\n    end\n  end\n`endif\n\nendmodule\n","exit_code":0,"status":"completed"}}
