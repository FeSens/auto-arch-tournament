core.sv:9://   +- stall <- hazard_unit (load-use)\ncores/bench/rtl/core.sv:35:  input  logic        io_imemReady,\ncores/bench/rtl/core.sv:74:  if_id_t  if_id_w;\ncores/bench/rtl/core.sv:80:  logic       stall_if, stall_id, flush_if, flush_id;\ncores/bench/rtl/core.sv:99:  if_stage u_if (\ncores/bench/rtl/core.sv:102:    .stall           (stall_if),\ncores/bench/rtl/core.sv:103:    .flush           (flush_if),\ncores/bench/rtl/core.sv:108:    .out             (if_id_w)\ncores/bench/rtl/core.sv:112:  id_stage u_id (\ncores/bench/rtl/core.sv:117:    .in       (if_id_w),\ncores/bench/rtl/core.sv:176:  hazard_unit u_hazard (\ncores/bench/rtl/core.sv:179:    .if_id_rs1      (if_id_w.instr[19:15]),\ncores/bench/rtl/core.sv:180:    .if_id_rs2      (if_id_w.instr[24:20]),\ncores/bench/rtl/core.sv:182:    .imem_ready     (io_imemReady),\ncores/bench/rtl/core.sv:186:    .stall_if       (stall_if),\ncores/bench/rtl/core.sv:188:    .flush_if       (flush_if),\n","exit_code":0,"status":"completed"}}
