{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"nl -ba cores/bench/rtl/hazard_unit.sv | sed -n '1,190p'\"", "aggregated_output": "     1\t// rtl/hazard_unit.sv\n     2\t//\n     3\t// Detects the only data hazard the textbook 5-stage doesn't cover via\n     4\t// forwarding: load-use. A LOAD in EX produces its data only after MEM,\n     5\t// so a valid instruction immediately behind it that consumes the LOAD's\n     6\t// rd must be stalled by exactly one cycle.\n     7\t//\n     8\t// Outputs:\n     9\t//   stall_if / stall_id : freeze the PC reg and the IF/ID combinational\n    10\t//                          payload (cleared by ID's flush input).\n    11\t//   flush_if / flush_id : on EX redirect, kill the two in-flight\n    12\t//                          instructions ahead of the redirect target.\n    13\t//   flush_id            : also kills ID's own register on load-use to\n    14\t//                          inject a single-cycle bubble between LOAD\n    15\t//                          and the dependent instruction.\n    16\t//   ex_busy             : long-latency EX op in progress; freeze IF/ID and\n    17\t//                          ID/EX while EX emits bubbles until the result is\n    18\t//                          ready.\n    19\t//\n    20\t// Latency:        combinational.\n    21\t// RVFI fields:    n/a (governs validity of subsequent retirements).\n    22\tmodule hazard_unit (\n    23\t  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n    24\t  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n    25\t  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n    26\t  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n    27\t  input  logic       if_id_valid,       // IF/ID has a real fetched insn\n    28\t  input  logic       if_id_uses_rs1,    // decoded next insn consumes rs1\n    29\t  input  logic       if_id_uses_rs2,    // decoded next insn consumes rs2\n    30\t  input  logic       redirect,          // EX has resolved a branch/jump\n    31\t  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n    32\t  // random ~22% stall in vex_main.cpp). When low, the correspo\n…[2233 of 5305 chars elided by tools/bench/transcript.py; sha256:a15f6265b080547a]…\nle      (1-cycle stall between LOAD + use)\n    75\t    //   - redirect    -> bubble      (kill wrong-path)\n    76\t    //   - otherwise   -> capture\n    77\t    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    78\t    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    79\t    // we want bubble (not hold).\n    80\t    stall_id      = dmem_stall || ex_busy || load_use_hazard;\n    81\t    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !ex_busy;\n    82\t    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    83\t    // bus delivers).\n    84\t    stall_ex_mem  = dmem_stall;\n    85\t    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    86\t    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    87\t    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    88\t    // double-retire / double-write the regfile.\n    89\t    hold_mem_wb   = dmem_stall;\n    90\t  end\n    91\t\n    92\tendmodule\n", "exit_code": 0, "status": "completed"}}
