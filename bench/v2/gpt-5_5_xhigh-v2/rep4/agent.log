{"type": "item.completed", "item": {"id": "item_17", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,190p' cores/bench/test/test_memory_address_lane.py\"", "aggregated_output": "\"\"\"Focused memory effective-address lane tests for rtl/core.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm &= 0xFFF\n    return (((imm >> 5) & 0x7F) << 25) | ((rs2 & 0x1F) << 20) \\\n         | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((imm & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm, rs1, 0b000, rd, 0b0010011)\ndef LB  (rd, rs1, imm): return _i(imm, rs1, 0b000, rd, 0b0000011)\ndef LH  (rd, rs1, imm): return _i(imm, rs1, 0b001, rd, 0b0000011)\ndef LW  (rd, rs1, imm): return _i(imm, rs1, 0b010, rd, 0b0000011)\ndef LBU (rd, rs1, imm): return _i(imm, rs1, 0b100, rd, 0b0000011)\ndef LHU (rd, rs1, imm): return _i(imm, rs1, 0b101, rd, 0b0000011)\ndef SB  (rs2, rs1, imm): return _s(imm, rs2, rs1, 0b000, 0b0100011)\ndef SH  (rs2, rs1, imm): return _s(imm, rs2, rs1, 0b001, 0b0100011)\ndef SW  (rs2, rs1, imm): return _s(imm, rs2, rs1, 0b010, 0b0100011)\ndef EBREAK(): return 0x00100073\n\n\nasync def _run(dut, program, dmem_init=None, max_cycles=160):\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n        ia = int(dut.io_imemAddr.value)\n        da = int(dut.io_dmemAddr.value)\n        wen = int(dut.io_dmemWEn.value)\n\n        if wen:\n            wd\n…[2517 of 5589 chars elided by tools/bench/transcript.py; sha256:04b6dac9f136b8e5]…\n   assert by_pc[24][\"rd_wdata\"] == 0x0000FFFE\n    assert by_pc[24][\"mem_rmask\"] == 0b1100\n\n    assert by_pc[32][\"mem_addr\"] == 0x104\n    assert by_pc[32][\"mem_wmask\"] == 0b1111\n    assert by_pc[36][\"rd_wdata\"] == 0x123\n    assert by_pc[36][\"mem_rmask\"] == 0b1111\n\n    for pc in (40, 44, 48, 52):\n        assert by_pc[pc][\"trap\"] == 1\n        assert by_pc[pc][\"mem_addr\"] == 0\n        assert by_pc[pc][\"mem_rmask\"] == 0\n        assert by_pc[pc][\"mem_wmask\"] == 0\n\n    assert dmem[0x100] == 0xFFFE0304\n    assert dmem[0x104] == 0x00000123\n\n\ndef test_memory_address_lane_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mul_unit.sv\", \"div_unit.sv\", \"mulh_unit.sv\",\n            \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_memory_address_lane\",\n    )\n", "exit_code": 0, "status": "completed"}}
