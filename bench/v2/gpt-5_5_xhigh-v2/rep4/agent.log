{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"sed -n '1,120p' cores/bench/rtl/alu.sv && sed -n '1,120p' cores/bench/rtl/shift_unit.sv\"","aggregated_output":"// rtl/alu.sv\n//\n// RV32IM combinational ALU. Real shifts, MUL/MULH/MULHU/MULHSU, and DIV/REM\n// arithmetic are intentionally outside this module: ex_stage routes those\n// operations through sidecar units. Under RISCV_FORMAL_ALTOPS the formal\n// multiply/divide substitute formulas remain here to match riscv-formal's\n// ALTOPS spec.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB) and branch resolution.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  always_comb begin\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_LUI:    out = b;\n\n      // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations\n      // are substituted for tractable algebraic stand-ins so bitwuzla\n      // can solve the BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined; all real\n      // M-extension arithmetic is supplied by sidecars through ex_stage.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\n`else\n      ALU_MUL:    out = 32'b0;\n      ALU_MULH:   out = 32'b0;\n      ALU_MULHU:  out = 32'b0;\n      ALU_MULHSU: out = 32'b0;\n      ALU_DIV:    out = 32'b0;\n      ALU_DIVU:   out = 32'b0;\n      ALU_REM:    out = 32'b0;\n      ALU_REMU:   out = 32'b0;\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n// rtl/shift_unit.sv\n//\n// Registered RV32I shifter sidecar. EX starts this unit for SLL/SRL/SRA\n// register and immediate forms, then holds the instruction for one cycle while\n// the variable-shift result is captured outside the hot ALU result cone.\nmodule shift_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        accept,\n  input  logic [4:0]  op,\n  input  logic [31:0] lhs,\n  input  logic [31:0] rhs,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n\n  logic        done_q;\n  logic [31:0] result_q;\n\n  logic [4:0]  shamt;\n  logic [31:0] result_d;\n\n  always_comb begin\n    shamt = rhs[4:0];\n    case (op)\n      ALU_SLL:  result_d = lhs << shamt;\n      ALU_SRL:  result_d = lhs >> shamt;\n      ALU_SRA:  result_d = $unsigned($signed(lhs) >>> shamt);\n      default:  result_d = 32'b0;\n    endcase\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      done_q   <= 1'b0;\n      result_q <= 32'b0;\n    end else begin\n      if (accept && done_q) begin\n        done_q <= 1'b0;\n      end\n\n      if (start && !done_q) begin\n        result_q <= result_d;\n        done_q   <= 1'b1;\n      end\n    end\n  end\n\n  assign busy   = 1'b0;\n  assign done   = done_q;\n  assign result = result_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
