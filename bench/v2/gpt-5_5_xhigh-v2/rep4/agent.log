{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '1,140p' cores/bench/test/test_mul_unit.py\"","aggregated_output":"\"\"\"Unit tests for rtl/mul_unit.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.lhs.value = 0\n    dut.rhs.value = 0\n    for _ in range(2):\n        await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n\n\nasync def _check(dut, a, b, expected):\n    dut.lhs.value = a & MASK32\n    dut.rhs.value = b & MASK32\n    dut.start.value = 1\n    dut.accept.value = 0\n    await RisingEdge(dut.clock)\n    dut.start.value = 0\n\n    await Timer(1, \"ns\")\n    assert int(dut.done.value) == 1\n    actual = int(dut.result.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n    dut.accept.value = 1\n    await RisingEdge(dut.clock)\n    dut.accept.value = 0\n    await Timer(1, \"ns\")\n    assert int(dut.done.value) == 0\n\n\n@cocotb.test()\nasync def low_half_vectors(dut):\n    await _setup(dut)\n    await _check(dut, 3, 4, 12)\n    await _check(dut, 0xFFFFFFFF, 0xFFFFFFFF, 1)\n    await _check(dut, 0x80000000, 2, 0)\n    await _check(dut, 0x12345678, 0x9ABCDEF0, 0x242D2080)\n\n\n@cocotb.test()\nasync def back_to_back_multiplies(dut):\n    await _setup(dut)\n    await _check(dut, 7, 9, 63)\n    await _check(dut, 0xFFFF0001, 0x10001, 1)\n    await _check(dut, 0, 0xDEADBEEF, 0)\n\n\ndef test_mul_unit_runner():\n    run_cocotb(\n        toplevel=\"mul_unit\",\n        sources=[\"core_pkg.sv\", \"mul_unit.sv\"],\n        test_module=\"test_mul_unit\",\n    )\n","exit_code":0,"status":"completed"}}
