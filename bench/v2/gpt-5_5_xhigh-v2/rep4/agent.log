{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/alu.sv\"","aggregated_output":"// rtl/alu.sv\n//\n// RV32IM combinational ALU. Real MUL/MULH/MULHU/MULHSU and DIV/REM arithmetic\n// is intentionally outside this module: ex_stage routes those operations\n// through sidecar units. Under RISCV_FORMAL_ALTOPS the formal substitute\n// formulas remain here to match riscv-formal's ALTOPS spec.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB) and branch resolution.\nmodule alu (\n  input  logic [5:0]  lane,\n  input  logic        exec_sub,\n  input  logic [1:0]  exec_logic,\n  input  logic        exec_sr,\n  input  logic        exec_sra,\n  input  logic        exec_sltu,\n  input  logic [2:0]  exec_m_op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic [4:0]  shamt;\n  logic [31:0] addsub_result;\n  logic [31:0] logic_result;\n  logic [31:0] shift_result;\n  logic [31:0] slt_result;\n  logic [31:0] imm_result;\n  logic [31:0] m_alt_result;\n  logic [31:0] m_alt_addsub;\n  logic [31:0] m_alt_xor;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    addsub_result = exec_sub ? (a - b) : (a + b);\n\n    case (exec_logic)\n      EX_LOGIC_OR:  logic_result = a | b;\n      EX_LOGIC_AND: logic_result = a & b;\n      default:      logic_result = a ^ b;\n    endcase\n\n    if (exec_sr) begin\n      shift_result = exec_sra ? $unsigned($signed(a) >>> shamt)\n                              : (a >> shamt);\n    end else begin\n      shift_result = a << shamt;\n    end\n\n    slt_result = {31'b0, exec_sltu ? (a < b)\n                                   : ($signed(a) < $signed(b))};\n    imm_result = b;\n\n    // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations\n    // are substituted for tractable algebraic stand-ins so bitwuzla\n    // can solve the BMC inside the 20-step depth budget. The same\n    // substitution must appear in the riscv-formal spec (insn_*.v).\n    // The Verilator/cocotb/cosim builds leave ALTOPS undefined; all real\n    // M-extension arithmetic is supplied by sidecars through ex_stage.\n`ifdef RISCV_FORMAL_ALTOPS\n    case (exec_m_op)\n      3'd0: begin\n        m_alt_addsub = a + b;\n        m_alt_xor    = 32'h5876063e;\n      end\n      3'd1: begin\n        m_alt_addsub = a + b;\n        m_alt_xor    = 32'hf6583fb7;\n      end\n      3'd2: begin\n        m_alt_addsub = a - b;\n        m_alt_xor    = 32'hecfbe137;\n      end\n      3'd3: begin\n        m_alt_addsub = a + b;\n        m_alt_xor    = 32'h949ce5e8;\n      end\n      3'd4: begin\n        m_alt_addsub = a - b;\n        m_alt_xor    = 32'h7f8529ec;\n      end\n      3'd5: begin\n        m_alt_addsub = a - b;\n        m_alt_xor    = 32'h10e8fd70;\n      end\n      3'd6: begin\n        m_alt_addsub = a - b;\n        m_alt_xor    = 32'h8da68fa5;\n      end\n      default: begin\n        m_alt_addsub = a - b;\n        m_alt_xor    = 32'h3138d0e1;\n      end\n    endcase\n`else\n    case (exec_m_op)\n      3'd0, 3'd1, 3'd2, 3'd3,\n      3'd4, 3'd5, 3'd6, 3'd7: begin\n        m_alt_addsub = 32'b0;\n        m_alt_xor    = 32'b0;\n      end\n      default: begin\n        m_alt_addsub = 32'b0;\n        m_alt_xor    = 32'b0;\n      end\n    endcase\n`endif\n    m_alt_result = m_alt_addsub ^ m_alt_xor;\n\n    out = ({32{lane[EX_LANE_ADDSUB]}} & addsub_result)\n        | ({32{lane[EX_LANE_LOGIC]}}  & logic_result)\n        | ({32{lane[EX_LANE_SHIFT]}}  & shift_result)\n        | ({32{lane[EX_LANE_SLT]}}    & slt_result)\n        | ({32{lane[EX_LANE_IMM]}}    & imm_result)\n        | ({32{lane[EX_LANE_M_ALT]}}  & m_alt_result);\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
