{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -c \"sed -n '1,200p' cores/bench/test/test_ahead_direct_predictor.py\"","aggregated_output":"\"\"\"Focused unit tests for rtl/ahead_direct_predictor.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _reset(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.lookup_en.value = 0\n    dut.lookup_pc.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_target.value = 0\n    for _ in range(2):\n        await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _train(dut, pc, target):\n    dut.train_valid.value = 1\n    dut.train_pc.value = pc\n    dut.train_target.value = target\n    await RisingEdge(dut.clock)\n    dut.train_valid.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _lookup(dut, pc):\n    dut.lookup_en.value = 1\n    dut.lookup_pc.value = pc\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.lookup_en.value = 0\n    return int(dut.lookup_hit.value), int(dut.lookup_target.value)\n\n\n@cocotb.test()\nasync def registered_lookup_hits_one_cycle_after_request(dut):\n    await _reset(dut)\n    await _train(dut, 0x20, 0x13)\n\n    assert int(dut.lookup_hit.value) == 0\n    hit, target = await _lookup(dut, 0x20)\n    assert hit == 1\n    assert target == 0x10\n\n\n@cocotb.test()\nasync def exact_pc_tags_do_not_alias(dut):\n    await _reset(dut)\n    await _train(dut, 0x20, 0x10)\n\n    hit, _ = await _lookup(dut, 0x24)\n    assert hit == 0\n\n\n@cocotb.test()\nasync def lookup_result_holds_when_disabled(dut):\n    await _reset(dut)\n    await _train(dut, 0x40, 0x08)\n\n    hit, target = await _lookup(dut, 0x40)\n    assert (hit, target) == (1, 0x08)\n\n    dut.lookup_en.value = 0\n    dut.lookup_pc.value = 0x80\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    assert int(dut.lookup_hit.value) == 1\n    assert int(dut.lookup_target.value) == 0x08\n\n\ndef test_ahead_direct_predictor_runner():\n    run_cocotb(\n        toplevel=\"ahead_direct_predictor\",\n        sources=[\"ahead_direct_predictor.sv\"],\n        test_module=\"test_ahead_direct_predictor\",\n    )\n","exit_code":0,"status":"completed"}}
