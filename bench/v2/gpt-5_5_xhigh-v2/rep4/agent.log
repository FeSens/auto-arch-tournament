1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[11135 of 14207 chars elided by tools/bench/transcript.py; sha256:4dfb3bb1da215846]…\n\n    ]\n    rets, _ = await _run(dut, program, max_cycles=180)\n    by_pc = {r[\"pc\"]: r for r in rets}\n    assert by_pc[8][\"rd_wdata\"] == 1\n    assert by_pc[12][\"rd_wdata\"] == 0xFFFFFFFF\n    assert by_pc[16][\"rd_wdata\"] == 1\n    assert by_pc[20][\"rd_wdata\"] == 0xFFFFFFFE\n    assert by_pc[24][\"rd_wdata\"] == 0xFFFFFFFF\n\n\n@cocotb.test()\nasync def iterative_div_retire_and_forward(dut):\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIV(3, 1, 2),\n        ADD(4, 3, 2),\n        REM(5, 1, 2),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=160)\n    by_pc = {r[\"pc\"]: r for r in rets}\n    assert by_pc[8][\"rd_wdata\"] == 14\n    assert by_pc[12][\"rd_wdata\"] == 21\n    assert by_pc[16][\"rd_wdata\"] == 2\n    assert by_pc[8][\"rs1_rdata\"] == 100\n    assert by_pc[8][\"rs2_rdata\"] == 7\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n", "exit_code": 0, "status": "completed"}}
