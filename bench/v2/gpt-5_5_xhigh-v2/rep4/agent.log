{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_loop_predictor.py\"","aggregated_output":"\"\"\"Focused unit tests for rtl/loop_predictor.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _settle():\n    await Timer(1, \"ns\")\n\n\ndef _defaults(dut):\n    dut.lookup_pc.value = 0\n    dut.predict_fire.value = 0\n    dut.predict_pc.value = 0\n    dut.predict_target.value = 0\n    dut.resolve_valid.value = 0\n    dut.train_valid.value = 0\n    dut.train_pc.value = 0\n    dut.train_taken.value = 0\n    dut.train_backward.value = 0\n    dut.train_target.value = 0\n\n\nasync def _start(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    _defaults(dut)\n    await RisingEdge(dut.clock)\n    await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n    await _settle()\n\n\nasync def _train_taken_backward(dut, pc=0x20, target=0x10):\n    dut.train_valid.value = 1\n    dut.train_pc.value = pc\n    dut.train_taken.value = 1\n    dut.train_backward.value = 1\n    dut.train_target.value = target\n    await RisingEdge(dut.clock)\n    dut.train_valid.value = 0\n    await _settle()\n\n\n@cocotb.test()\nasync def reset_train_predict_and_resolve(dut):\n    await _start(dut)\n\n    dut.lookup_pc.value = 0x20\n    await _settle()\n    assert int(dut.lookup_hit.value) == 0\n    assert int(dut.outstanding_valid.value) == 0\n\n    await _train_taken_backward(dut)\n    dut.lookup_pc.value = 0x20\n    await _settle()\n    assert int(dut.lookup_hit.value) == 1\n    assert int(dut.lookup_target.value) == 0x10\n\n    dut.predict_fire.value = 1\n    dut.predict_pc.value = 0x20\n    dut.predict_target.value = 0x13  # scoreboard stores aligned target\n    await RisingEdge(dut.clock)\n    dut.predict_fire.value = 0\n    await _settle()\n    assert int(dut.outstanding_valid.value) == 1\n    assert int(dut.outstanding_pc.value) == 0x20\n    assert int(dut.outstanding_target.value) == 0x10\n    assert int(dut.lookup_hit.value) == 0\n\n    dut.resolve_valid.value = 1\n    await RisingEdge(dut.clock)\n    dut.resolve_valid.value = 0\n    await _settle()\n    assert int(dut.outstanding_valid.value) == 0\n    assert int(dut.lookup_hit.value) == 1\n\n\n@cocotb.test()\nasync def loop_exit_decrements_confidence(dut):\n    await _start(dut)\n    await _train_taken_backward(dut)\n\n    dut.lookup_pc.value = 0x20\n    await _settle()\n    assert int(dut.lookup_hit.value) == 1\n\n    dut.train_valid.value = 1\n    dut.train_pc.value = 0x20\n    dut.train_taken.value = 0\n    dut.train_backward.value = 0\n    dut.train_target.value = 0x24\n    await RisingEdge(dut.clock)\n    dut.train_valid.value = 0\n    await _settle()\n    assert int(dut.lookup_hit.value) == 0\n\n\ndef test_loop_predictor_runner():\n    run_cocotb(\n        toplevel=\"loop_predictor\",\n        sources=[\"loop_predictor.sv\"],\n        test_module=\"test_loop_predictor\",\n    )\n","exit_code":0,"status":"completed"}}
