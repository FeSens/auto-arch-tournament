  dut.ex_mem_w_en.value = 1\n    dut.mem_wb_rd.value = 6\n    dut.mem_wb_w_en.value = 1\n    await _settle(dut)\n    assert int(dut.fwd_rs1.value) == 0\n    assert int(dut.fwd_rs2.value) == 0\n\n\n@cocotb.test()\nasync def x0_never_forwards(dut):\n    _defaults(dut)\n    dut.id_ex_rs1.value = 0\n    dut.id_ex_rs2.value = 0\n    dut.id_ex_uses_rs1.value = 1\n    dut.id_ex_uses_rs2.value = 1\n    dut.ex_mem_rd.value = 0\n    dut.ex_mem_w_en.value = 1\n    dut.mem_wb_rd.value = 0\n    dut.mem_wb_w_en.value = 1\n    await _settle(dut)\n    assert int(dut.fwd_rs1.value) == 0\n    assert int(dut.fwd_rs2.value) == 0\n\n\ndef test_forward_unit_runner():\n    run_cocotb(\n        toplevel=\"forward_unit\",\n        sources=[\"forward_unit.sv\"],\n        test_module=\"test_forward_unit\",\n    )\n","exit_code":0,"status":"completed"}}
