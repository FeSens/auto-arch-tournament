{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"sed -n '1,240p' cores/bench/test/test_hazard.py\"","aggregated_output":"\"\"\"Focused unit tests for rtl/hazard_unit.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _settle(dut):\n    await Timer(1, \"ns\")\n\n\ndef _defaults(dut):\n    dut.id_ex_mem_read.value = 0\n    dut.id_ex_rd.value = 0\n    dut.if_id_rs1.value = 0\n    dut.if_id_rs2.value = 0\n    dut.if_id_valid.value = 1\n    dut.if_id_uses_rs1.value = 0\n    dut.if_id_uses_rs2.value = 0\n    dut.redirect.value = 0\n    dut.imem_ready.value = 1\n    dut.dmem_ready.value = 1\n    dut.ex_mem_mem_op.value = 0\n    dut.ex_busy.value = 0\n\n\ndef _assert_no_load_stall(dut):\n    assert int(dut.stall_if.value) == 0\n    assert int(dut.stall_id.value) == 0\n    assert int(dut.flush_id.value) == 0\n\n\n@cocotb.test()\nasync def true_load_use_hazards_stall(dut):\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 5\n    dut.if_id_rs1.value = 5\n    dut.if_id_uses_rs1.value = 1\n    await _settle(dut)\n    assert int(dut.stall_if.value) == 1\n    assert int(dut.stall_id.value) == 1\n    assert int(dut.flush_id.value) == 1\n\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 6\n    dut.if_id_rs2.value = 6\n    dut.if_id_uses_rs2.value = 1\n    await _settle(dut)\n    assert int(dut.stall_if.value) == 1\n    assert int(dut.stall_id.value) == 1\n    assert int(dut.flush_id.value) == 1\n\n\n@cocotb.test()\nasync def immediate_rs2_bitfield_does_not_stall(dut):\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 7\n    dut.if_id_rs1.value = 1\n    dut.if_id_rs2.value = 7\n    dut.if_id_uses_rs1.value = 1\n    dut.if_id_uses_rs2.value = 0\n    await _settle(dut)\n    _assert_no_load_stall(dut)\n\n\n@cocotb.test()\nasync def invalid_if_id_work_does_not_stall(dut):\n    _defaults(dut)\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 9\n    dut.if_id_rs1.value = 9\n    dut.if_id_rs2.value = 9\n    dut.if_id_valid.value = 0\n    dut.if_id_uses_rs1.value = 1\n    dut.if_id_uses_rs2.value = 1\n    await _settle(dut)\n    _assert_no_load_stall(dut)\n\n\ndef test_hazard_runner():\n    run_cocotb(\n        toplevel=\"hazard_unit\",\n        sources=[\"hazard_unit.sv\"],\n        test_module=\"test_hazard\",\n    )\n","exit_code":0,"status":"completed"}}
