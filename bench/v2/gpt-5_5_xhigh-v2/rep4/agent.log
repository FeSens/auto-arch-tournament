y ? add1_c1[7:0] : add1_c0[7:0];\n  assign add1_carry = add0_carry ? add1_c1[8]   : add1_c0[8];\n  assign add2_sum   = add1_carry ? add2_c1[7:0] : add2_c0[7:0];\n  assign add2_carry = add1_carry ? add2_c1[8]   : add2_c0[8];\n  assign add3_sum   = add2_carry ? add3_c1[7:0] : add3_c0[7\n…[1593 of 4665 chars elided by tools/bench/transcript.py; sha256:92725077ca51746f]…\nhe BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined; all real\n      // M-extension arithmetic is supplied by sidecars through ex_stage.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = add_result ^ 32'h5876063e;\n      ALU_MULH:   out = add_result ^ 32'hf6583fb7;\n      ALU_MULHU:  out = add_result ^ 32'h949ce5e8;\n      ALU_MULHSU: out = sub_result ^ 32'hecfbe137;\n      ALU_DIV:    out = sub_result ^ 32'h7f8529ec;\n      ALU_DIVU:   out = sub_result ^ 32'h10e8fd70;\n      ALU_REM:    out = sub_result ^ 32'h8da68fa5;\n      ALU_REMU:   out = sub_result ^ 32'h3138d0e1;\n`else\n      ALU_MUL:    out = 32'b0;\n      ALU_MULH:   out = 32'b0;\n      ALU_MULHU:  out = 32'b0;\n      ALU_MULHSU: out = 32'b0;\n      ALU_DIV:    out = 32'b0;\n      ALU_DIVU:   out = 32'b0;\n      ALU_REM:    out = 32'b0;\n      ALU_REMU:   out = 32'b0;\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
