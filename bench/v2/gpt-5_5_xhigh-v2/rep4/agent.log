{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/if_stage.sv && sed -n '1,140p' cores/bench/rtl/hazard_unit.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register and the IF/ID pipeline\n// register so decode consumes a stable instruction rather than the\n// same-cycle imem_data / redirect mux output.\n//\n// Redirect updates the PC immediately, even when the rest of the pipeline\n// is stalled. Wrong-path IF/ID contents are killed by clearing valid. On\n// imem backpressure, PC holds the fetch address and IF/ID loads a bubble\n// unless a downstream stall must preserve the current decoded instruction.\n//\n// Latency:        1 cycle fetch register (IF/ID).\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              pc_stall,         // hold PC (except redirect)\n  input  logic              if_id_hold,       // hold IF/ID register\n  input  logic              if_id_flush,      // clear IF/ID valid\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              imem_ready,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam logic [31:0] NOP      = 32'h0000_0013;\n\n  logic [31:0] pc;\n  if_id_t      if_id_q;\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc      <= RESET_PC;\n      if_id_q <= '0;\n    end else begin\n      if      (redirect)  pc <= redirect_target;\n      else if (!pc_stall) pc <= pc + 32'd4;\n\n      if (if_id_flush || redirect) b\n…[4159 of 7231 chars elided by tools/bench/transcript.py; sha256:b0b5f5431ce6f7a8]…\n  -> hold        (preserve in-flight pipeline state)\n    //   - ex_busy     -> hold        (DIV/REM still owns EX)\n    //   - load_use    -> bubble      (1-cycle stall between LOAD + use)\n    //   - redirect    -> bubble      (kill wrong-path)\n    //   - otherwise   -> capture\n    // dmem_stall takes precedence over load_use's bubble: re-evaluate\n    // load_use next cycle when the bus unblocks. flush_id is 1 only when\n    // we want bubble (not hold).\n    stall_id      = dmem_stall || ex_busy;\n    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !ex_busy;\n    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    // bus delivers).\n    stall_ex_mem  = dmem_stall;\n    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    // double-retire / double-write the regfile.\n    hold_mem_wb   = dmem_stall;\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
