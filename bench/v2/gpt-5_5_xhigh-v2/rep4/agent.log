{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/reg_file.sv\"","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two replicated architectural banks, one per execution read port.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// Reset deliberately does not clear the architectural banks. Only x0 has a\n// reset-visible architectural value, and it is enforced by the read muxes.\n// Dropping the full-array reset lets FPGA synthesis map each read-port bank\n// as shallow distributed RAM or a local mux tree instead of resettable storage\n// feeding two wide read muxes.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  // RVFI-only raw read ports for the retiring instruction's source fields.\n  // Unlike the execution read ports above, these do not apply the same-cycle\n  // write bypass: RVFI reports source data before the retiring instruction's\n  // own writeback.\n  input  logic [4:0]  rvfi_rs1_addr,\n  input  logic [4:0]  rvfi_rs2_addr,\n  output logic [31:0] rvfi_rs1_data,\n  output logic [31:0] rvfi_rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  logic [31:0] rs1_bank [0:31];\n  logic [31:0] rs2_bank [0:31];\n\n  always_ff @(posedge clock) begin\n    if (!reset && w_en && w_addr != 5'b0) begin\n      rs1_bank[w_addr] <= w_data;\n      rs2_bank[w_addr] <= w_data;\n    end\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = rs1_bank[rs1_addr];\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = rs2_bank[rs2_addr];\n\n    rvfi_rs1_data = (rvfi_rs1_addr == 5'b0) ? 32'b0 : rs1_bank[rvfi_rs1_addr];\n    rvfi_rs2_data = (rvfi_rs2_addr == 5'b0) ? 32'b0 : rs2_bank[rvfi_rs2_addr];\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
