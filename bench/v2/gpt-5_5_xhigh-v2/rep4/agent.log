{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '1,280p' cores/bench/test/test_mulh_unit.py\"","aggregated_output":"\"\"\"Unit tests for rtl/mulh_unit.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.accept.value = 0\n    dut.op.value = ALU_MULH\n    dut.lhs.value = 0\n    dut.rhs.value = 0\n    for _ in range(2):\n        await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n\n\nasync def _check(dut, op, a, b, expected):\n    dut.op.value = op\n    dut.lhs.value = a & MASK32\n    dut.rhs.value = b & MASK32\n    dut.start.value = 1\n    dut.accept.value = 0\n    await RisingEdge(dut.clock)\n    dut.start.value = 0\n\n    for _ in range(40):\n        await Timer(1, \"ns\")\n        if int(dut.done.value):\n            actual = int(dut.result.value) & MASK32\n            assert actual == (expected & MASK32), (\n                f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n                f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n            )\n            dut.accept.value = 1\n            await RisingEdge(dut.clock)\n            dut.accept.value = 0\n            await Timer(1, \"ns\")\n            assert int(dut.done.value) == 0\n            return\n        await RisingEdge(dut.clock)\n\n    assert False, f\"mulh timed out for op={op} a=0x{a:08x} b=0x{b:08x}\"\n\n\n@cocotb.test()\nasync def mulh_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 0xFFFFFFFF, 0xFFFFFFFF, 0)\n\n\n@cocotb.test()\nasync def mulhu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n    await _check(dut, ALU_MULHU, 1, 1, 0)\n\n\n@cocotb.test()\nasync def mulhsu_signed_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n    await _check(dut, ALU_MULHSU, 7, 3, 0)\n\n\n@cocotb.test()\nasync def back_to_back_high_multiplies(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULH, 0xFFFFFFFE, 2, 0xFFFFFFFF)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n\n\ndef test_mulh_unit_runner():\n    run_cocotb(\n        toplevel=\"mulh_unit\",\n        sources=[\"core_pkg.sv\", \"mulh_unit.sv\"],\n        test_module=\"test_mulh_unit\",\n    )\n","exit_code":0,"status":"completed"}}
