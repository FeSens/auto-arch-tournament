{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/ahead_direct_predictor.sv\"","aggregated_output":"// rtl/ahead_direct_predictor.sv\n//\n// Tiny fully-associative direct-control predictor. The lookup result is\n// registered for the PC that IF will fetch on the next cycle, so the IF PC\n// update mux consumes only a flop-fed hit/target pair.\nmodule ahead_direct_predictor (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic        lookup_en,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0] lookup_pc,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic        lookup_hit,\n  output logic [31:0] lookup_target,\n\n  input  logic        train_valid,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0] train_pc,\n  input  logic [31:0] train_target\n  /* verilator lint_on UNUSEDSIGNAL */\n);\n\n  logic [3:0]  valid_q;\n  logic [29:0] tag_q    [0:3];\n  logic [29:0] target_q [0:3];\n  logic [1:0]  conf_q   [0:3];\n  logic [1:0]  replace_q;\n\n  logic        hit_comb;\n  logic [1:0]  hit_idx;\n  logic [29:0] lookup_tag;\n\n  logic        train_match;\n  logic [1:0]  train_match_idx;\n  logic [29:0] train_tag;\n  logic [29:0] train_target_aligned;\n\n  logic        lookup_hit_q;\n  logic [31:0] lookup_target_q;\n\n  always_comb begin\n    lookup_tag = lookup_pc[31:2];\n    hit_comb   = 1'b0;\n    hit_idx    = 2'b00;\n\n    for (int i = 0; i < 4; i++) begin\n      if (!hit_comb && valid_q[i] && (tag_q[i] == lookup_tag) && conf_q[i][1]) begin\n        hit_comb = 1'b1;\n        hit_idx  = i[1:0];\n      end\n    end\n\n    train_tag            = train_pc[31:2];\n    train_target_aligned = train_target[31:2];\n    train_match          = 1'b0;\n    train_match_idx      = 2'b00;\n\n    for (int i = 0; i < 4; i++) begin\n      if (!train_match && valid_q[i] && (tag_q[i] == train_tag)) begin\n        train_match     = 1'b1;\n        train_match_idx = i[1:0];\n      end\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      valid_q         <= 4'b0000;\n      tag_q[0]        <= 30'b0;\n      tag_q[1]        <= 30'b0;\n      tag_q[2]        <= 30'b0;\n      tag_q[3]        <= 30'b0;\n      target_q[0]     <= 30'b0;\n      target_q[1]     <= 30'b0;\n      target_q[2]     <= 30'b0;\n      target_q[3]     <= 30'b0;\n      conf_q[0]       <= 2'b00;\n      conf_q[1]       <= 2'b00;\n      conf_q[2]       <= 2'b00;\n      conf_q[3]       <= 2'b00;\n      replace_q       <= 2'b00;\n      lookup_hit_q    <= 1'b0;\n      lookup_target_q <= 32'b0;\n    end else begin\n      if (lookup_en) begin\n        lookup_hit_q    <= hit_comb;\n        lookup_target_q <= hit_comb ? {target_q[hit_idx], 2'b00} : 32'b0;\n      end\n\n      if (train_valid) begin\n        if (train_match) begin\n          target_q[train_match_idx] <= train_target_aligned;\n          if (conf_q[train_match_idx] != 2'b11) begin\n            conf_q[train_match_idx] <= conf_q[train_match_idx] + 2'b01;\n          end\n        end else begin\n          valid_q[replace_q]  <= 1'b1;\n          tag_q[replace_q]    <= train_tag;\n          target_q[replace_q] <= train_target_aligned;\n          conf_q[replace_q]   <= 2'b10;\n          replace_q           <= replace_q + 2'b01;\n        end\n      end\n    end\n  end\n\n  assign lookup_hit    = lookup_hit_q;\n  assign lookup_target = lookup_target_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
