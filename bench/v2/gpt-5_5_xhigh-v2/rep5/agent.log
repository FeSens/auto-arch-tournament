{"type": "item.started", "item": {"id": "item_30", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nvcd=Path('formal/riscv-formal/cores/bench-wcFGfGEsi/checks/reg_ch0/engine_0/trace.vcd')\nids={\n'clock':'n97','reset':'n147','imemAddr':'n119','imemData':'n120','imemReady':'n121','dmemReady':'n116',\n'id_ex':'n112','ex1':'n173','exmem':'n101','memwb':'n143',\n'id_rs1':'n242','id_rs2':'n243','id_valid':'n244','raw':'n249','id_ex1':'n245','id_exmemload':'n246',\n'stall_id':'n154','bubble':'n96','stall_exmem':'n153','hold_wb':'n111',\n'fwd1':'n109','fwd2':'n110','fwd1n':'n217','fwd2n':'n219','idn_valid':'n222','idn_rs1':'n220','idn_rs2':'n221','ex1_adv':'n208','exmem_adv':'n212',\n'ex1_rd':'n99','ex1_rw':'n100','ex1_mr':'n98','exmem_rd':'n214','exmem_rw':'n215','exmem_mr':'n213','memwb_rd':'n223','memwb_rw':'n225','memwb_stays':'n224',\n'rs1_sel':'n190','rs2_sel':'n191','alu_result':'n156','wb_en':'n351','wb_addr':'n349','wb_data':'n350','rf_x27':'n403',\n'rvfi_valid':'n142','rvfi_order':'n132','rvfi_insn':'n123','rvfi_rd':'n135','rvfi_rddata':'n136','rvfi_rs1':'n137','rvfi_rs1data':'n138','rvfi_rs2':'n139','rvfi_rs2data':'n140','rvfi_pc':'n133','rvfi_trap':'n141',\n}\nrev={v:k for k,v in ids.items()}\nvals={k:'x' for k in ids}\n\ndef b2i(s):\n    if s in ('x','z'): return None\n    if any(c in s for c in 'xz'): return None\n    return int(s,2)\n\ndef get(k): return b2i(vals.get(k,'x'))\n\ndef sx(v,b): return v-(1<<b) if v is not None and (v>>(b-1))&1 else v\n\ndef dec(insn):\n    if insn is None: return 'x'\n    opcode=insn&0x7f; rd=(insn>>7)&31; f3=(insn>>12)&7; rs1=(insn>>15)&31; rs2=(insn>>20)&31; f7=(insn>>25)&127\n    if opcode==0x03:\n        return f\\\"lw/lb rd=x{rd} rs1=x{rs1} imm={sx(insn>>20,12)} f3={f3}\\\"\n    if opcode==0x13:\n        return f\\\"opimm rd=x{rd} rs1=x{rs1} imm={sx(insn>>20,12)} f3={f3} f7={f7}\\\"\n    if opcode==0x33:\n        return f\\\"op rd=x{rd} rs1=x{rs1} rs2=x{rs2} f3={f3} f7={f7}\\\"\n    if opcode==0x23:\n        imm=sx(((insn>>25)<<5)|rd,12); return f\\\"store rs2=x{rs2} rs1=x{rs1} imm={imm} f3={f3}\\\"\n    if opcode==0x6f:\n        imm=sx(((insn>>31)<<20)|(((insn>>12)&255)<<12)|(((insn>>20)&1)<<11)|(((insn>>21)&1023)<<1),21); return f\\\"jal x{rd},{imm}\\\"\n    return f\\\"insn {insn:08x}\\\"\n\ndef unpack_id(v):\n    if v is None: return None\n    valid=v&1; instr=(v>>1)&0xffffffff; ctrl=(v>>33)&((1<<22)-1); rs2=(v>>55)&31; rs1=(v>>60)&31; rd=(v>>65)&31; imm=(v>>70)&0xffffffff; rs2v=(v>>102)&0xffffffff; rs1v=(v>>134)&0xffffffff; pc=(v>>166)&0xffffffff\n    return pc,instr,valid,rd,rs1,rs2,rs1v,rs2v,imm,ctrl\n\ndef unpack_ex1(v):\n    if v is None: return None\n    valid=v&1; instr=(v>>1)&0xffffffff; ctrl=(v>>33)&((1<<22)-1); rs2=(v>>55)&31; rs1=(v>>60)&31; rd=(v>>65)&31\n    jump_mis=(v>>70)&1; branch_mis=(v>>71)&1; jump_target=(v>>72)&0xffffffff; branch_target=(v>>104)&0xffffffff; branch_cond=(v>>136)&1\n    alu_b=(v>>137)&0xffffffff; alu_a=(v>>169)&0xffffffff; imm=(v>>201)&0xffffffff; rs2v=(v>>233)&0xffffffff; rs1v=(v>>265)&0xffffffff; pc=(v>>297)&0xffffffff\n    return pc,instr,valid,rd,rs1,rs2,rs1v,rs2v,alu_a,alu_b,imm\n\ndef unpack_exmem(v):\n    if v is None: return None\n    valid=v&1; instr=(v>>1)&0xffffffff; ctrl=(v>>33)&((1<<22)-1); branch_target=(v>>55)&0xffffffff; branch_taken=(v>>87)&1; pc_next=(v>>88)&0xffffffff; rs2v=(v>>120)&0xffffffff; rs1v=(v>>152)&0xffffffff; rs2=(v>>184)&31; rs1=(v>>189)&31; rd=(v>>194)&31; write_data=(v>>199)&0xffffffff; alu_result=(v>>231)&0xffffffff; pc=(v>>263)&0xffffffff\n    return pc,instr,valid,rd,rs1,rs2,rs1v,rs2v,alu_result,write_data,ctrl\n\ndef unpack_memwb(v):\n    if v is None: return None\n    valid=v&1; instr=(v>>1)&0xffffffff; ctrl=(v>>33)&((1<<22)-1); mem_rmask=(v>>55)&15; mem_wmask=(v>>59)&15; mem_wdata=(v>>63)&0xffffffff; mem_rdata=(v>>95)&0xffffffff; mem_addr=(v>>127)&0xffffffff; pc_next=(v>>159)&0xffffffff; rs2v=(v>>191)&0xffffffff; rs1v=(v>>223)&0xffffffff; rs2=(v>>255)&31; rs1=(v>>260)&31; rd=(v>>265)&31; read_data=(v>>270)&0xffffffff; alu_result=(v>>302)&0xffffffff; pc=(v>>334)&0xffffffff\n    return pc,instr,valid,rd,rs1,rs2,rs1v,rs2v,alu_result,read_data,ctrl\n\nlast_clock=0; t=0; cycle=0\nfor line in vcd.read_text().splitlines():\n    if not line: continue\n    if line[0]=='#':\n        t=int(line[1:]); continue\n    if line.startswith('\"'$'\"'): continue\n    if line[0]=='b':\n        parts=line.split();\n        if len(parts)\"'!=2: continue\n        bits, idd=parts[0][1:], parts[1]\n        if idd in rev: vals[rev[idd]]=bits\n    else:\n        val=line[0]; idd=line[1:]\n        if idd in rev: vals[rev[idd]]=val\n    clk=get('\"'clock')\n    if clk==1 and last_clock==0:\n        # after processing clock transition, values before nba? VCD has same-time updates later too, so this fires too early. We'll print at falling edge instead.\n        pass\n    last_clock=clk if clk is not None else last_clock\n\n# second pass: collect snapshot at end of each timestamp, print when clock high timestamp.\nvals={k:'x' for k in ids}; snaps=[]; curtime=0\ndef apply(line):\n    if line.startswith('b'):\n        p=line.split();\n        if len(p)==2 and p[1] in rev: vals[rev[p[1]]]=p[0][1:]\n    elif line and not line.startswith('\"'$'\"') and line[0] in '01xz':\n        if line[1:] in rev: vals[rev[line[1:]]]=line[0]\nlast_time=None; changes=[]\ntexts=vcd.read_text().splitlines()\n# process by time block\nblocks=[]; cur=[]; cur_t=0\nfor line in texts:\n    if line.startswith('#'):\n        if cur or cur_t==0: blocks.append((cur_t,cur)); cur=[]\n        cur_t=int(line[1:])\n    else:\n        cur.append(line)\nblocks.append((cur_t,cur))\nvals={k:'x' for k in ids}\nprev_clk=0\nfor time, block in blocks:\n    for line in block: apply(line)\n    clk=get('clock')\n    # snapshot after all same-time changes on rising edge\n    if clk==1 and prev_clk==0:\n        idd=unpack_id(get('id_ex')); ex1=unpack_ex1(get('ex1')); exm=unpack_exmem(get('exmem')); m