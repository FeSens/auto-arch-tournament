{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/branch_predictor.sv\"","aggregated_output":"// rtl/branch_predictor.sv\n//\n// Tiny next-PC predictor for the IF stage. Direct JALs are predicted taken\n// from their J-immediate. Conditional branches use a 64-entry 2-bit\n// saturating BHT indexed by pc[7:2]. JAL/JALR target misalignment traps are\n// resolved in EX, so IF only predicts aligned direct targets.\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [31:0] fetch_pc,\n  input  logic [31:0] fetch_instr,\n  output logic        predicted_taken,\n  output logic [31:0] predicted_target,\n  output logic [31:0] predicted_next_pc,\n\n  input  logic        update_valid,\n  input  logic [31:0] update_pc,\n  input  logic        update_taken\n);\n\n  localparam int BHT_ENTRIES = 64;\n\n  logic [1:0] bht [0:BHT_ENTRIES-1];\n\n  logic [5:0] fetch_idx;\n  logic [5:0] update_idx;\n  logic [1:0] counter;\n\n  logic [6:0] opcode;\n  logic [2:0] funct3;\n  logic       is_jal;\n  logic       is_branch_opcode;\n  logic       is_valid_branch;\n  logic [31:0] imm;\n  logic [31:0] target;\n  logic        target_aligned;\n\n  assign fetch_idx = fetch_pc[7:2];\n  assign update_idx = update_pc[7:2];\n\n  imm_gen u_imm (\n    .instr (fetch_instr),\n    .imm   (imm)\n  );\n\n  always_comb begin\n    opcode = fetch_instr[6:0];\n    funct3 = fetch_instr[14:12];\n\n    is_jal           = (opcode == 7'b1101111);\n    is_branch_opcode = (opcode == 7'b1100011);\n    is_valid_branch  = is_branch_opcode && (funct3 != 3'd2) && (funct3 != 3'd3);\n\n    counter        = bht[fetch_idx];\n    target         = fetch_pc + imm;\n    target_aligned = (target[1:0] == 2'b00);\n\n    predicted_taken  = target_aligned && (is_jal || (is_valid_branch && counter[1]));\n    predicted_target = predicted_taken ? target : (fetch_pc + 32'd4);\n    predicted_next_pc = predicted_t