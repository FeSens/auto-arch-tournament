der.py:126:    await _check_div(dut, ALU_DIVU, 100, 7, 14)\ncores/bench/test/test_iter_divider.py:127:    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\ncores/bench/test/test_iter_divider.py:128:    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)\ncores/bench/test/t\n…[2483 of 5555 chars elided by tools/bench/transcript.py; sha256:15a5191d23bf32be]…\n0_core_pkg.sv:27:  localparam logic [4:0] ALU_DIVU   = 5'd16;\ncores/bench/rtl/00_core_pkg.sv:28:  localparam logic [4:0] ALU_REM    = 5'd17;\ncores/bench/rtl/00_core_pkg.sv:29:  localparam logic [4:0] ALU_REMU   = 5'd18;\ncores/bench/rtl/ex_stage.sv:16://                 holds EX1/EX2 until iter_divider reports valid.\ncores/bench/rtl/ex_stage.sv:136:               && ((ex1_q.ctrl.alu_op == ALU_DIV)  ||\ncores/bench/rtl/ex_stage.sv:137:                   (ex1_q.ctrl.alu_op == ALU_DIVU) ||\ncores/bench/rtl/ex_stage.sv:138:                   (ex1_q.ctrl.alu_op == ALU_REM)  ||\ncores/bench/rtl/ex_stage.sv:139:                   (ex1_q.ctrl.alu_op == ALU_REMU));\ncores/bench/rtl/ex_stage.sv:148:  iter_divider u_divider (\ncores/bench/rtl/core_pkg.sv:36:  localparam logic [4:0] ALU_DIV    = 5'd15;\ncores/bench/rtl/core_pkg.sv:37:  localparam logic [4:0] ALU_DIVU   = 5'd16;\ncores/bench/rtl/core_pkg.sv:38:  localparam logic [4:0] ALU_REM    = 5'd17;\ncores/bench/rtl/core_pkg.sv:39:  localparam logic [4:0] ALU_REMU   = 5'd18;\n", "exit_code": 0, "status": "completed"}}
