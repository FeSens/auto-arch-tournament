{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_branch_retime.py\"", "aggregated_output": "\"\"\"Focused branch/jump resolve tests for the EX1/EX2 retime.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    b12 = (imm >> 12) & 1\n    b105 = (imm >> 5) & 0x3F\n    b41 = (imm >> 1) & 0xF\n    b11 = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    b20 = (imm >> 20) & 1\n    b101 = (imm >> 1) & 0x3FF\n    b11 = (imm >> 11) & 1\n    b1912 = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm, rs1, 0b000, rd, 0b0010011)\ndef BEQ(rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef BNE(rs1, rs2, imm): return _b(imm, rs2, rs1, 0b001, 0b1100011)\ndef JAL(rd, imm): return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm): return _i(imm, rs1, 0b000, rd, 0b1100111)\ndef EBREAK(): return 0x00100073\n\n\nasync def _run(dut, program, max_cycles=120):\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    retirements = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n        ia = int(dut.io_imemAddr.value)\n        if int(dut.io_rvfi_valid_0.value):\n            rec = {\n                \"cycle\": cycle,\n            \n…[2703 of 5775 chars elided by tools/bench/transcript.py; sha256:07275db8a38b21ee]…\ncotb.test()\nasync def misaligned_jal_traps_without_redirect(dut):\n    bad_insn = JAL(1, 2)\n    rets = await _run(dut, [bad_insn, EBREAK()])\n    bad = _one(rets, bad_insn)\n    assert bad[\"trap\"] == 1\n    assert bad[\"pc_next\"] == 4\n    assert bad[\"rd\"] == 0 and bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def misaligned_jalr_traps_without_redirect(dut):\n    bad_insn = JALR(1, 5, 0)\n    rets = await _run(dut, [ADDI(5, 0, 14), bad_insn, EBREAK()])\n    bad = _one(rets, bad_insn)\n    assert bad[\"trap\"] == 1\n    assert bad[\"pc_next\"] == 8\n    assert bad[\"rd\"] == 0 and bad[\"rd_wdata\"] == 0\n\n\ndef test_branch_retime_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"iter_divider.sv\", \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_branch_retime\",\n    )\n", "exit_code": 0, "status": "completed"}}
