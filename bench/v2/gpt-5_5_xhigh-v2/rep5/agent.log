{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"nl -ba cores/bench/rtl/hazard_unit.sv | sed -n '1,45p'\"","aggregated_output":"     1\t// rtl/hazard_unit.sv\n     2\t//\n     3\t// Hazards for the two-stage execute pipeline:\n     4\t//   - A consumer in ID/EX cannot enter EX1 while its producer is still in\n     5\t//     EX2, because EX1 latches operands before the EX2/MEM result exists.\n     6\t//   - A consumer in ID/EX cannot enter EX1 while a matching LOAD is in\n     7\t//     EX/MEM, because EX/MEM carries only the load address. The load data is\n     8\t//     forwardable once registered in MEM/WB.\n     9\t//   - Registered long-op state and dmem stalls hold the execute payloads in\n    10\t//     place. Divider ready/valid stays local to EX.\n    11\t//\n    12\t// Redirects kill the frontend plus the next EX1 payload. If an older dmem\n    13\t// stall prevents the redirecting instruction from advancing to EX/MEM, EX1\n    14\t// holds the redirecting instruction and the redirect replays until the hold\n    15\t// clears.\n    16\tmodule hazard_unit (\n    17\t  input  logic       id_ex_valid,\n    18\t  input  logic [4:0] id_ex_rs1,\n    19\t  input  logic [4:0] id_ex_rs2,\n    20\t  input  logic [4:0] ex1_rd,\n    21\t  input  logic       ex1_reg_write,\n    22\t  input  logic       ex1_mem_read,\n    23\t  input  logic [4:0] ex_mem_rd,\n    24\t  input  logic       ex_mem_reg_write,\n    25\t  input  logic       ex_mem_mem_read,\n    26\t  input  logic       redirect,\n    27\t  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n    28\t  // random ~22% stall in vex_main.cpp). When low, the corresponding\n    29\t  // memory request is NOT serviced this cycle.\n    30\t  input  logic       imem_ready,\n    31\t  input  logic       dmem_ready,\n    32\t  input  logic       ex_stage_stall,   // registered long-op hold state\n    33\t  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n    34\t  // would actually be holding up). Computed at top level from the\n    35\t  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n    36\t  input  logic       ex_mem_mem_op,\n    37\t  output logic       stall_if,          // PC reg holds unless redirect overrides\n    38\t  output logic       stall_id,          // ID/EX register holds\n    39\t  output logic       flush_if,          // IF/ID comb output -> NOP\n    40\t  output logic       flush_id,          // ID/EX register captures '0\n    41\t  output logic       stall_ex_mem,      // EX/MEM register holds\n    42\t  output logic       hold_mem_wb,       // MEM/WB clears valid only\n    43\t  output logic       flush_ex1,         // EX1/EX2 register captures '0\n    44\t  output logic       bubble_ex1         // EX1 bubble while ID/EX is held\n    45\t);\n","exit_code":0,"status":"completed"}}
