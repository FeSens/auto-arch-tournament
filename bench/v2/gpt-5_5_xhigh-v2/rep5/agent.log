{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"sed -n '1,130p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Static direct predictor: backward conditional branches and direct JALs\n// steer the next PC in IF. EX later redirects only for prediction recovery.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic [31:0] b_imm;\n  logic [31:0] j_imm;\n  logic [31:0] branch_target;\n  logic [31:0] jal_target;\n  logic        branch_opcode;\n  logic        branch_funct3_valid;\n  logic        jal_opcode;\n  logic        branch_predict_taken;\n  logic        jal_predict_taken;\n  logic        pred_taken;\n\n  always_comb begin\n    b_imm = {{19{imem_data[31]}}, imem_data[31], imem_data[7],\n             imem_data[30:25], imem_data[11:8], 1'b0};\n    j_imm = {{11{imem_data[31]}}, imem_data[31], imem_data[19:12],\n             imem_data[20], imem_data[30:21], 1'b0};\n\n    branch_target = pc + b_imm;\n    jal_target    = pc + j_imm;\n\n    branch_opcode       = (imem_data[6:0] == 7'b1100011);\n    branch_funct3_valid = (imem_data[14:12] != 3'd2) && (imem_data[14:12] != 3'd3);\n    jal_opcode          = (imem_data[6:0] == 7'b1101111);\n\n    branch_predict_taken = branch_opcode && branch_funct3_valid\n                         && imem_data[31]\n                         && (branch_target[1:0] == 2'b00);\n    jal_predict_taken    = jal_opcode && (jal_target[1:0] == 2'b00);\n    pred_taken           = branch_predict_taken || jal_predict_taken;\n\n    if (redirect)\n      next_pc = redirect_target;\n    else if (jal_predict_taken)\n      next_pc = jal_target;\n    else if (branch_predict_taken)\n      next_pc = branch_target;\n    else\n      next_pc = pc + 32'd4;\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if      (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc         = pc;\n    out.instr      = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.pred_taken = !(flush || redirect) && pred_taken;\n    out.valid      = !(flush || redirect);\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"sed -n '55,115p' cores/bench/rtl/core_pkg.sv && sed -n '45,90p' cores/bench/rtl/00_core_pkg.sv\"","aggregated_output":"  typedef struct packed {\n    logic [4:0] alu_op;\n    logic       alu_src;     // 0 = rs2 value, 1 = immediate\n    logic [2:0] branch_op;\n    logic       is_branch;\n    logic       is_jump;\n    logic       is_jalr;\n    logic       is_lui;\n    logic       is_auipc;\n    logic       mem_read;\n    logic       mem_write;\n    logic [1:0] mem_width;   // 0 = byte, 1 = half, 2 = word\n    logic       mem_sext;    // sign-extend load result\n    logic       reg_write;\n    logic       mem_to_reg;  // 1 = write loaded data, 0 = write ALU result\n    logic       is_illegal;  // default-true in decoder; cleared inside\n                              // validated opcode/funct arms only.\n  } ctrl_t;\n\n  // IF -> ID combinational bundle (no register; PC reg sits in if_stage).\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic        pred_taken; // IF static direct branch/JAL prediction.\n    logic        valid;\n  } if_id_t;\n\n  // ID/EX register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] imm;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        pred_taken;\n    logic        valid;\n  } id_ex_t;\n\n  // EX/MEM register payload.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] write_data;     // raw rs2 (post-forward), pre byte replication\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;        // post-forward rs1 used by EX\n    logic [31:0] rs2_val;        // post-forward rs2 used by EX\n    logic [31:0] pc_next;        // resolved next-PC (target / pc+4)\n    logic        branch_taken;\n    logic [31:0] branch_target;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n    logic       is_jump;\n    logic       is_jalr;\n    logic       is_lui;\n    logic       is_auipc;\n    logic       mem_read;\n    logic       mem_write;\n    logic [1:0] mem_width;\n    logic       mem_sext;\n    logic       reg_write;\n    logic       mem_to_reg;\n    logic       is_illegal;\n  } ctrl_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic        pred_taken;\n    logic        valid;\n  } if_id_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] imm;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        pred_taken;\n    logic        valid;\n  } id_ex_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] write_data;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic        branch_taken;\n    logic [31:0] branch_target;\n","exit_code":0,"status":"completed"}}
