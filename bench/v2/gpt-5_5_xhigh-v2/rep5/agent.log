{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_iter_divider.py\"","aggregated_output":"\"\"\"Unit tests for rtl/iter_divider.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import ClockCycles, RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, units=\"ns\").start())\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.consume.value = 0\n    dut.op.value = 0\n    dut.a.value = 0\n    dut.b.value = 0\n    await ClockCycles(dut.clock, 2)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n\n\nasync def _check_div(dut, op, a, b, expected):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await RisingEdge(dut.clock)\n    dut.start.value = 0\n\n    for _ in range(40):\n        await Timer(1, \"ns\")\n        if int(dut.valid.value):\n            break\n        await RisingEdge(dut.clock)\n\n    assert int(dut.valid.value), f\"divider did not finish op={op}\"\n    actual = int(dut.result.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n    dut.consume.value = 1\n    await RisingEdge(dut.clock)\n    dut.consume.value = 0\n    await Timer(1, \"ns\")\n    assert not int(dut.valid.value)\n\n\n@cocotb.test()\nasync def div_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 10, 3, 3)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)\n    await _check_div(dut, ALU_DIV, 7, 0xFFFFFFFE, 0xFFFFFFFD)\n\n\n@cocotb.test()\nasync def div_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 123, 0, 0xFFFFFFFF)\n    await _check_div(dut, ALU_DIV, 0, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def div_overflow(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 0x80000000, 0xFFFFFFFF, 0x80000000)\n\n\n@cocotb.test()\nasync def divu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n\n\n@cocotb.test()\nasync def divu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 42, 0, 0xFFFFFFFF)\n\n\n@cocotb.test()\nasync def rem_signed(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REM, 0xFFFFFFF6, 3, 0xFFFFFFFF)\n    await _check_div(dut, ALU_REM, 10, 0xFFFFFFFD, 1)\n\n\n@cocotb.test()\nasync def rem_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 0xDEADBEEF, 0, 0xDEADBEEF)\n\n\n@cocotb.test()\nasync def rem_overflow(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REM, 0x80000000, 0xFFFFFFFF, 0)\n\n\n@cocotb.test()\nasync def remu(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def remu_by_zero(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_REMU, 0xCAFEBABE, 0, 0xCAFEBABE)\n\n\n@cocotb.test()\nasync def back_to_back_divides(dut):\n    await _setup(dut)\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\ndef test_iter_divider_runner():\n    run_cocotb(toplevel=\"iter_divider\",\n               sources=[\"core_pkg.sv\", \"iter_divider.sv\"],\n               test_module=\"test_iter_divider\")\n","exit_code":0,"status":"completed"}}
