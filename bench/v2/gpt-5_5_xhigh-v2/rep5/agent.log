{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/return_stack.sv\"","aggregated_output":"// rtl/return_stack.sv\n//\n// Four-entry return-address stack. IF only consumes the registered top entry;\n// EX updates the stack when calls/returns resolve. On overflow, the oldest\n// entry is dropped so the most recent four call return addresses are retained.\nmodule return_stack (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        push,\n  input  logic [31:0] push_addr,\n  input  logic        pop,\n  output logic        top_valid,\n  output logic [31:0] top_addr\n);\n\n  logic [31:0] stack_q [0:3];\n  logic [2:0]  depth_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      depth_q    <= 3'd0;\n      stack_q[0] <= 32'b0;\n      stack_q[1] <= 32'b0;\n      stack_q[2] <= 32'b0;\n      stack_q[3] <= 32'b0;\n    end else if (push && pop) begin\n      if (depth_q == 3'd0) begin\n        stack_q[0] <= push_addr;\n        depth_q    <= 3'd1;\n      end else begin\n        case (depth_q)\n          3'd1:    stack_q[0] <= push_addr;\n          3'd2:    stack_q[1] <= push_addr;\n          3'd3:    stack_q[2] <= push_addr;\n          default: stack_q[3] <= push_addr;\n        endcase\n      end\n    end else if (push) begin\n      case (depth_q)\n        3'd0: begin\n          stack_q[0] <= push_addr;\n          depth_q    <= 3'd1;\n        end\n        3'd1: begin\n          stack_q[1] <= push_addr;\n          depth_q    <= 3'd2;\n        end\n        3'd2: begin\n          stack_q[2] <= push_addr;\n          depth_q    <= 3'd3;\n        end\n        3'd3: begin\n          stack_q[3] <= push_addr;\n          depth_q    <= 3'd4;\n        end\n        default: begin\n          stack_q[0] <= stack_q[1];\n          stack_q[1] <= stack_q[2];\n          stack_q[2] <= stack_q[3];\n          stack_q[3] <= push_addr;\n          depth_q    <= 3'd4;\n        end\n      endcase\n    end else if (pop && depth_q != 3'd0) begin\n      depth_q <= depth_q - 3'd1;\n    end\n  end\n\n  always_comb begin\n    top_valid = (depth_q != 3'd0);\n    case (depth_q)\n      3'd1:    top_addr = stack_q[0];\n      3'd2:    top_addr = stack_q[1];\n      3'd3:    top_addr = stack_q[2];\n      3'd4:    top_addr = stack_q[3];\n      default: top_addr = 32'b0;\n    endcase\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
