{"type": "item.completed", "item": {"id": "item_63", "type": "command_execution", "command": "/bin/bash -c \"git diff -- cores/bench/rtl/mem_stage.sv | sed -n '1,260p'\"", "aggregated_output": "diff --git a/cores/bench/rtl/mem_stage.sv b/cores/bench/rtl/mem_stage.sv\nindex eb40d73..28e820e 100644\n--- a/cores/bench/rtl/mem_stage.sv\n+++ b/cores/bench/rtl/mem_stage.sv\n@@ -1,8 +1,9 @@\n // rtl/mem_stage.sv\n //\n-// Memory access stage. Drives the dmem read/write ports combinationally\n-// from the EX/MEM register, and sign/zero-extends the loaded data into\n-// the MEM/WB register.\n+// Memory access stage. Loads use the live EX/MEM address when the store\n+// request register is empty. Stores first enter the one-entry request\n+// register; that register is the only source that drives dmem write\n+// enables/address/data, preserving the byte-lane RAM inference pattern.\n //\n // Byte-lane discipline:\n //   - Write data is replicated across all four byte lanes; the\n@@ -39,10 +40,20 @@ module mem_stage (\n   input  logic [31:0]        dmem_rdata,\n   output logic [3:0]         dmem_wen,\n   output logic               dmem_ren,\n+  input  logic               dmem_ready,\n+  output logic               lsu_stall,\n   // MEM/WB register output\n   output mem_wb_t  out\n );\n \n+  typedef struct packed {\n+    logic        valid;\n+    logic        mmio;\n+    logic [31:0] addr;\n+    logic [31:0] wdata;\n+    logic [3:0]  wmask;\n+  } store_req_t;\n+\n   logic [31:0] wdata_rep;\n   logic [3:0]  byte_mask;\n   logic [31:0] aligned_addr;\n@@ -64,6 +75,20 @@ module mem_stage (\n   logic mem_op;\n   ctrl_t ctrl_with_trap;\n \n+  store_req_t store_req_q;\n+  logic       store_req_drain;\n+  logic       store_req_free;\n+  logic       addr_is_ram;\n+  logic       live_store_req;\n+  logic       live_store_ram;\n+  logic       live_store_mmio;\n+  logic       live_load;\n+  logic       live_ordered;\n+  logic       live_mem_misalign;\n+  logic       ram_store_enqueue;\n+  logic       mmio_store_enqueue;\n+  logic       mmio_store_done;\n+\n   always_comb begin\n     // Byte/halfword replication for stores.\n     case (in.ctrl.mem_width)\n@@ -92,11 +117,52 @@ module mem_stage (\n       ctrl_with_trap.reg_write  = 1'b0;\n     end\n \n-    // Combinational dmem outputs — gated \n…[2704 of 5776 chars elided by tools/bench/transcript.py; sha256:9da9075d1f46637a]…\n_q <= '0;\n+      end\n+      if (mmio_store_enqueue) begin\n+        store_req_q.valid <= 1'b1;\n+        store_req_q.mmio  <= 1'b1;\n+        store_req_q.addr  <= in.alu_result;\n+        store_req_q.wdata <= wdata_rep;\n+        store_req_q.wmask <= byte_mask;\n+      end\n+\n       // Clear valid (no double-retire / no double-regfile-write), but\n       // KEEP every other field. Forwarding from MEM/WB to a stalled\n       // dependent in ID/EX needs the held LOAD's rd/read_data/ctrl\n       // alive for as many cycles as the dmem stall lasts.\n       reg_q.valid <= 1'b0;\n     end else begin\n+      if (store_req_drain) begin\n+        store_req_q <= '0;\n+      end\n+      if (ram_store_enqueue) begin\n+        store_req_q.valid <= 1'b1;\n+        store_req_q.mmio  <= 1'b0;\n+        store_req_q.addr  <= in.alu_result;\n+        store_req_q.wdata <= wdata_rep;\n+        store_req_q.wmask <= byte_mask;\n+      end\n+\n       reg_q.pc         <= in.pc;\n       reg_q.alu_result <= in.alu_result;\n       reg_q.read_data  <= load_data;\n", "exit_code": 0, "status": "completed"}}
