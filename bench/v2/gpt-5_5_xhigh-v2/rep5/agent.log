impact:\n  fitness_delta_pct: 5\n  confidence: medium\nchanges:\n  - file: rtl/core_pkg.sv\n    description: \"Add is_divrem, div_signed, and div_wants_remainder fields to ctrl_t so the long-op class is predicted once in decode and carried in the existing control payload.\"\n  - file: rtl/00_core_pkg.sv\n    description: \"Mirror the new ctrl_t fields in the alphabetical build-order shim.\"\n  - file: rtl/decoder.sv\n    description: \"Drive the exact divide/remainder class predictor bits only for legal DIV/DIVU/REM/REMU encodings while preserving illegal-default decoder behavior.\"\n  - file: rtl/id_stage.sv\n    description: \"Latch the new predictor bits with the decoded control word without changing source, immediate, or RVFI metadata handling.\"\n  - file: rtl/ex_stage.sv\n    description: \"Use the registered is_divrem predictor bit for divider start, capture, consume, and global stall generation instead of re-comparing the ALU op each cycle.\"\n  - file: rtl/iter_divider.sv\n    description: \"Replace internal ALU-op decoding with explicit div_signed and div_wants_remainder inputs so the divider no longer sits on a 5-bit op-decode timing cone.\"\n  - file: test/test_div_class_predictor.py\n    description: \"Add focused DIV/DIVU/REM/REMU vectors and dependent-consumer cases to verify the predecoded class bits preserve RV32M behavior under stalls.\"\n","exit_code":0,"status":"completed"}}
