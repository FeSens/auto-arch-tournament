{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/reg_file.sv\"","aggregated_output":"// rtl/reg_file.sv\n//\n// 32 x 32 RV32I integer register file.\n//   - x0 hardwired to zero (writes silently dropped, reads always 0).\n//   - Two combinational read ports.\n//   - Single synchronous write port.\n//   - Write-first bypass: a same-cycle write to the read address returns\n//     the new value. This matches the prior Chisel core's RegFile.scala\n//     and lets the ID stage see WB-stage writes within the same cycle\n//     without an extra forwarding mux.\n//\n// Runtime reset intentionally does not touch the storage array. The register\n// contents are deterministically initialized for simulation and FPGA memory\n// init inference, avoiding a reset mux/enable term on every stored bit.\n//\n// Latency:        write = 1 cycle (synchronous), read = combinational.\n// RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\nmodule reg_file (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [4:0]  rs1_addr,\n  input  logic [4:0]  rs2_addr,\n  output logic [31:0] rs1_data,\n  output logic [31:0] rs2_data,\n\n  input  logic        w_en,\n  input  logic [4:0]  w_addr,\n  input  logic [31:0] w_data\n);\n\n  logic [31:0] regs [1:31];\n\n  initial begin\n    for (int i = 1; i < 32; i++) regs[i] = 32'b0;\n  end\n\n  always_ff @(posedge clock) begin\n    if (w_en && w_addr != 5'b0) begin\n      regs[w_addr] <= w_data;\n    end\n  end\n\n  always_comb begin\n    if (rs1_addr == 5'b0)\n      rs1_data = 32'b0;\n    else if (w_en && w_addr == rs1_addr)\n      rs1_data = w_data;\n    else\n      rs1_data = regs[rs1_addr];\n\n    if (rs2_addr == 5'b0)\n      rs2_data = 32'b0;\n    else if (w_en && w_addr == rs2_addr)\n      rs2_data = w_data;\n    else\n      rs2_data = regs[rs2_addr];\n  end\n\n  /* verilator lint_off UNUSED */\n  logic unused_reset;\n  assign unused_reset = reset;\n  /* verilator lint_on UNUSED */\n\nendmodule\n","exit_code":0,"status":"completed"}}
