{"type": "item.completed", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/hazard_unit.sv cores/bench/rtl/core.sv cores/bench/rtl/id_stage.sv'", "aggregated_output": "diff --git a/cores/bench/rtl/core.sv b/cores/bench/rtl/core.sv\nindex 51ffdd1..cb68282 100644\n--- a/cores/bench/rtl/core.sv\n+++ b/cores/bench/rtl/core.sv\n@@ -176,8 +176,9 @@ module core (\n   hazard_unit u_hazard (\n     .id_ex_mem_read (id_ex_w.ctrl.mem_read),\n     .id_ex_rd       (id_ex_w.rd),\n-    .if_id_rs1      (if_id_w.instr[19:15]),\n-    .if_id_rs2      (if_id_w.instr[24:20]),\n+    .fetch_opcode   (io_imemData[6:0]),\n+    .fetch_rs1      (io_imemData[19:15]),\n+    .fetch_rs2      (io_imemData[24:20]),\n     .redirect       (redirect),\n     .imem_ready     (io_imemReady),\n     .dmem_ready     (io_dmemReady),\ndiff --git a/cores/bench/rtl/hazard_unit.sv b/cores/bench/rtl/hazard_unit.sv\nindex fd3c1de..2e8a4ee 100644\n--- a/cores/bench/rtl/hazard_unit.sv\n+++ b/cores/bench/rtl/hazard_unit.sv\n@@ -2,7 +2,10 @@\n //\n // Detects the data hazards the textbook 5-stage doesn't cover via\n // forwarding:\n-//   - load-use: a LOAD in EX produces its data only after MEM.\n+//   - load-use: a LOAD in EX produces its data only after MEM. The\n+//     comparison is opcode-qualified against the raw fetched instruction\n+//     so immediate bits in instructions without rs1/rs2 operands do not\n+//     request false bubbles.\n //   - EX arithmetic hold: iterative DIV/REM keeps its instruction in EX\n //     until the divider result is ready.\n //\n@@ -20,8 +23,9 @@\n module hazard_unit (\n   input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n   input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n-  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n-  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n+  input  logic [6:0] fetch_opcode,      // raw imem_data[6:0]\n+  input  logic [4:0] fetch_rs1,         // raw imem_data[19:15]\n+  input  logic [4:0] fetch_rs2,         // raw imem_data[24:20]\n   input  logic       redirect,          // EX has resolved a branch/jump\n   // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n   // random ~22% stal\n…[2445 of 5517 chars elided by tools/bench/transcript.py; sha256:bf1efcd155a65760]…\n   end\n+        7'b0010011,     // OP-IMM\n+        7'b0000011,     // LOAD\n+        7'b1100111: begin // JALR\n+          instr_uses_rs1 = 1'b1;\n+        end\n+        7'b0100011,     // STORE\n+        7'b1100011: begin // BRANCH\n+          instr_uses_rs1 = 1'b1;\n+          instr_uses_rs2 = 1'b1;\n+        end\n+        default: begin\n+          instr_uses_rs1 = 1'b0;\n+          instr_uses_rs2 = 1'b0;\n+        end\n+      endcase\n+    end\n+  end\n+\n+  assign rs1_addr = instr_uses_rs1 ? in.instr[19:15] : 5'b0;\n+  assign rs2_addr = instr_uses_rs2 ? in.instr[24:20] : 5'b0;\n \n   ctrl_t ctrl_decoded;\n   always_comb begin\n@@ -98,8 +130,8 @@ module id_stage (\n       reg_q.rs2_val  <= rs2_data;\n       reg_q.imm      <= imm;\n       reg_q.rd       <= in.instr[11:7];\n-      reg_q.rs1_addr <= in.instr[19:15];\n-      reg_q.rs2_addr <= in.instr[24:20];\n+      reg_q.rs1_addr <= rs1_addr;\n+      reg_q.rs2_addr <= rs2_addr;\n       reg_q.ctrl     <= ctrl_decoded;\n       reg_q.instr    <= in.instr;\n       reg_q.valid    <= in.valid;\n", "exit_code": 0, "status": "completed"}}
