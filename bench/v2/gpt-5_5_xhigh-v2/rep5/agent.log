{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"sed -n '1,240p' cores/bench/test/test_execute_retime.py\"","aggregated_output":"\"\"\"Focused coverage for EX1 ALU operand preselection.\n\nThese tests make unused instruction fields alias live producer registers so\noperand-selection bugs show up as wrong RVFI writeback or memory addresses.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADD, ADDI, EBREAK, LW, SW, _by_insn, _run\n\n\ndef _u(imm20, rd, opcode):\n    return ((imm20 & 0xFFFFF) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef AUIPC(rd, imm20): return _u(imm20, rd, 0b0010111)\n\n\nCORE_SOURCES = [\n    \"core_pkg.sv\",\n    \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n    \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n    \"iter_divider.sv\", \"mem_stage.sv\", \"wb_stage.sv\",\n    \"hazard_unit.sv\", \"forward_unit.sv\",\n    \"core.sv\",\n]\n\n\n@cocotb.test()\nasync def auipc_uses_registered_pc_operand(dut):\n    \"\"\"AUIPC must use PC as ALU A even when instr[19:15] forwards a value.\"\"\"\n    auipc = AUIPC(1, 0x28)  # instr[19:15] aliases x5; imm is 0x00028000.\n    program = [\n        ADDI(5, 0, 77),\n        auipc,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [r] = _by_insn(rets, auipc)\n    assert r[\"rd\"] == 1\n    assert r[\"rd_wdata\"] == 0x00028004, (\n        f\"AUIPC should write pc+imm=0x00028004, got 0x{r['rd_wdata']:08x}\"\n    )\n\n\n@cocotb.test()\nasync def op_imm_uses_registered_immediate_operand(dut):\n    \"\"\"OP-IMM must use imm as ALU B even when instr[24:20] forwards a value.\"\"\"\n    addi_imm7 = ADDI(1, 0, 7)  # instr[24:20] aliases x7.\n    program = [\n        ADDI(7, 0, 99),\n        addi_imm7,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [r] = _by_insn(rets, addi_imm7)\n    assert r[\"rd_wdata\"] == 7, (\n        f\"ADDI should use immediate 7, got 0x{r['rd_wdata']:08x}\"\n    )\n\n\n@cocotb.test()\nasync def load_store_addresses_use_registered_immediate_operand(dut):\n    \"\"\"Store and load addresses must use forwarded rs1 plus the latched imm.\"\"\"\n    store = SW(8, 1, 8)\n    load = LW(2, 1, 8)  # instr[24:20] aliases x8.\n    program = [\n        ADDI(1, 0, 64),\n        ADDI(8, 0, 11),\n        store,\n        load,\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [rs] = _by_insn(rets, store)\n    [rl] = _by_insn(rets, load)\n    assert rs[\"trap\"] == 0\n    assert rs[\"mem_addr\"] == 72\n    assert dmem.get(72) == 11, f\"store should land at 72, dmem={dmem}\"\n    assert rl[\"trap\"] == 0\n    assert rl[\"mem_addr\"] == 72\n    assert rl[\"rd_wdata\"] == 11\n\n\n@cocotb.test()\nasync def r_type_uses_registered_forwarded_operands(dut):\n    \"\"\"R-type ALU ops consume both forwarded operands after EX1 preselection.\"\"\"\n    add = ADD(3, 1, 2)\n    program = [\n        ADDI(1, 0, 20),\n        ADDI(2, 0, 22),\n        add,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [r] = _by_insn(rets, add)\n    assert r[\"rs1_rdata\"] == 20\n    assert r[\"rs2_rdata\"] == 22\n    assert r[\"rd_wdata\"] == 42\n\n\ndef test_execute_retime_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=CORE_SOURCES,\n        test_module=\"test_execute_retime\",\n    )\n","exit_code":0,"status":"completed"}}
