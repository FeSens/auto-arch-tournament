h.\nexpected_impact:\n  fitness_delta_pct: 6\n  confidence: medium\nchanges:\n  - file: rtl/ex_stage.sv\n    description: \"Replace the live divider-valid-driven global stall with a pessimistic registered long-op hold predictor; copy DIV/REM metadata into a local sidecar and inject the exact result after a registered completion wakeup.\"\n  - file: rtl/hazard_unit.sv\n    description: \"Treat the execute long-op stall input as registered hold state so divider busy/valid no longer fans combinationally into IF, ID, and regfile read control.\"\n  - file: rtl/core.sv\n    description: \"Wire or rename the execute stall signal as needed while preserving the nret=1 top-level IO and existing RVFI retirement boundary.\"\n  - file: test/test_div_stall_predictor.py\n    description: \"Add directed DIV/REM tests with dependent consumers plus imem and dmem stalls to verify no lost result, double retirement, or stale forwarding after the registered hold predictor releases.\"\n","exit_code":0,"status":"completed"}}
