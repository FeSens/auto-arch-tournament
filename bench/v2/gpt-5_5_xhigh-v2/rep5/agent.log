 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b011\n…[6937 of 10009 chars elided by tools/bench/transcript.py; sha256:e6fdbab9454ae021]…\n, got 0x{r2['rd_wdata']:08x}\"\n\n\n@cocotb.test()\nasync def divider_stall_forwards_to_dependent(dut):\n    \"\"\"DIV holds EX1/EX2 until complete; the dependent ADD consumes the result.\"\"\"\n    program = [\n        ADDI(1, 0, 20),\n        ADDI(2, 0, 3),\n        DIV (3, 1, 2),\n        ADD (4, 3, 2),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=120)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    [r4] = _by_insn(rets, ADD(4, 3, 2))\n    assert r3[\"rd_wdata\"] == 6\n    assert r4[\"rd_wdata\"] == 9\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n", "exit_code": 0, "status": "completed"}}
