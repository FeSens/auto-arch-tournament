{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/iter_mulh.sv\"","aggregated_output":"// rtl/iter_mulh.sv\n//\n// Small iterative high-half multiplier for RV32M MULH/MULHU/MULHSU. The\n// common ALU keeps only low-half MUL; EX holds high-multiply instructions\n// here until this unit reports a stable result.\n//\n// Contract:\n//   - Assert start for one cycle while the unit is idle.\n//   - valid stays high with result stable until consume is asserted.\n//   - start is ignored unless the unit is idle.\n//\n// Latency:        33 cycles (start edge + 32 shift/add steps).\n// RVFI fields:    none directly; ex_stage captures result into EX/MEM.\nmodule iter_mulh (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        consume,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        valid,\n  output logic [31:0] result\n);\n\n  typedef enum logic [1:0] {\n    MULH_IDLE = 2'd0,\n    MULH_RUN  = 2'd1,\n    MULH_DONE = 2'd2\n  } mulh_state_t;\n\n  mulh_state_t state_q;\n\n  logic [63:0] acc_q;\n  logic [63:0] multiplicand_q;\n  logic [31:0] multiplier_q;\n  logic [5:0]  count_q;\n  logic        negate_q;\n  logic [31:0] result_q;\n\n  logic        start_b_signed;\n  logic        start_negate;\n  logic [31:0] start_abs_a;\n  logic [31:0] start_abs_b;\n\n  logic [63:0] addend;\n  logic [63:0] acc_next;\n  logic [63:0] product_next;\n\n  always_comb begin\n    start_b_signed = (op == ALU_MULH);\n    start_negate   = ((op == ALU_MULH)   && (a[31] ^ b[31])) ||\n                     ((op == ALU_MULHSU) &&  a[31]);\n    start_abs_a    = ((op == ALU_MULH) || (op == ALU_MULHSU)) && a[31]\n                   ? (~a + 32'd1)\n                   : a;\n    start_abs_b    = start_b_signed && b[31]\n                   ? (~b + 32'd1)\n                   : b;\n\n    addend       = multiplier_q[0] ? multiplicand_q : 64'b0;\n    acc_next     = acc_q + addend;\n    product_next = negate_q ? (~acc_next + 64'd1) : acc_next;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state_q        <= MULH_IDLE;\n      acc_q          <= 64'b0;\n      multiplicand_q <= 64'b0;\n      multiplier_q   <= 32'b0;\n      count_q        <= 6'b0;\n      negate_q       <= 1'b0;\n      result_q       <= 32'b0;\n    end else begin\n      if (state_q == MULH_DONE && consume) begin\n        state_q <= MULH_IDLE;\n      end else if (state_q == MULH_IDLE && start) begin\n        acc_q          <= 64'b0;\n        multiplicand_q <= {32'b0, start_abs_a};\n        multiplier_q   <= start_abs_b;\n        count_q        <= 6'b0;\n        negate_q       <= start_negate;\n        state_q        <= MULH_RUN;\n      end else if (state_q == MULH_RUN) begin\n        acc_q          <= acc_next;\n        multiplicand_q <= {multiplicand_q[62:0], 1'b0};\n        multiplier_q   <= {1'b0, multiplier_q[31:1]};\n        count_q        <= count_q + 6'd1;\n\n        if (count_q == 6'd31) begin\n          result_q <= product_next[63:32];\n          state_q  <= MULH_DONE;\n        end\n      end\n    end\n  end\n\n  assign busy   = (state_q == MULH_RUN);\n  assign valid  = (state_q == MULH_DONE);\n  assign result = result_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
