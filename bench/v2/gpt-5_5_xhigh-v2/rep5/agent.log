_delta_pct\": 25, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/alu.sv\", \"description\": \"Remove hardware / and % operators from the combinational ALU and leave only fast one-cycle operations plus the existing RISCV_FORMAL_ALTOPS behavior.\"}, {\"file\": \"rtl/ex_stage.sv\", \"description\": \"Detect DIV/DIVU/REM/REMU, launch an iterative divide operation, hold EX/MEM until the result is ready\n…[90862 of 93934 chars elided by tools/bench/transcript.py; sha256:69429198ce78f3f4]…\n 33.702], \"perturbations\": [[0, 32.62, 34], [1, 33.702, 32], [2, 33.702, 32]], \"lutram\": 8, \"bsram\": 6, \"dsp\": 6, \"critical_path\": {\"from\": \"cpu/u_rf/regs_regs_0_0_s\", \"to\": \"cpu/u_if/pc_30_s1\", \"slack_ns\": -25.656, \"arrival_ns\": 35.95, \"logic_cells\": 88, \"modules\": [\"clock_ibuf\", \"cpu/u_id\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_id\", \"cpu/u_id/u_decoder\", \"cpu/u_id/u_imm\", \"cpu/u_id\", \"cpu/u_if\"]}, \"logic_levels\": 34, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-10-04T03:42:42.612673Z\", \"slot\": 2, \"round_id\": 6, \"lesson\": \"- 2026-10-04 hyp-20261004-003-r6s2 (regression, -29.45%): Decode-stage static direct-control prediction still regressed because the ID `predict_redirect`/`pred_target` feedback into IF plus EX `resolved_next_pc` versus `predicted_next_pc` validation moved timing pressure into decode and recovery control, so avoiding IF tables is not enough if prediction still widens the PC-update path.\"}\n", "exit_code": 0, "status": "completed"}}
