{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"sed -n '1,140p' cores/bench/rtl/branch_predictor.sv\"","aggregated_output":"// rtl/branch_predictor.sv\n//\n// Tiny direct-mapped BTB/BHT. Fetch reads it by PC only; EX trains it with\n// resolved control-flow outcomes and targets. No instruction bits enter the\n// fetch next-PC cone.\nmodule branch_predictor (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [31:0] lookup_pc,\n  output logic        predict_taken,\n  output logic [31:0] predict_target,\n\n  input  logic        update_valid,\n  input  logic [31:0] update_pc,\n  input  logic        update_is_branch,\n  input  logic        update_taken,\n  input  logic [31:0] update_target\n);\n\n  localparam int INDEX_BITS = 4;\n  localparam int ENTRIES    = 1 << INDEX_BITS;\n  localparam int TAG_BITS   = 32 - INDEX_BITS - 2;\n\n  logic                 valid_q  [0:ENTRIES-1];\n  logic [TAG_BITS-1:0]  tag_q    [0:ENTRIES-1];\n  logic [31:0]          target_q [0:ENTRIES-1];\n  logic [1:0]           ctr_q    [0:ENTRIES-1];\n\n  logic [INDEX_BITS-1:0] lookup_index;\n  logic [TAG_BITS-1:0]   lookup_tag;\n  logic                  lookup_hit;\n\n  logic [INDEX_BITS-1:0] update_index;\n  logic [TAG_BITS-1:0]   update_tag;\n  logic                  update_hit;\n\n  always_comb begin\n    lookup_index = lookup_pc[INDEX_BITS+1:2];\n    lookup_tag   = lookup_pc[31:INDEX_BITS+2];\n    lookup_hit   = valid_q[lookup_index] && (tag_q[lookup_index] == lookup_tag);\n\n    predict_taken  = lookup_hit && ctr_q[lookup_index][1];\n    predict_target = target_q[lookup_index];\n\n    update_index = update_pc[INDEX_BITS+1:2];\n    update_tag   = update_pc[31:INDEX_BITS+2];\n    update_hit   = valid_q[update_index] && (tag_q[update_index] == update_tag);\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      for (int i = 0; i < ENTRIES; i++) begin\n        valid_q[i]  <= 1'b0;\n        tag_q[i]    <= '0;\n        target_q[i] <= 32'b0;\n        ctr_q[i]    <= 2'b00;\n      end\n    end else if (update_valid) begin\n      if (update_is_branch) begin\n        if (update_taken) begin\n          valid_q[update_index]  <= 1'b1;\n          tag_q[update_index]    <= update_tag;\n          target_q[update_index] <= update_target;\n          if (update_hit) begin\n            case (ctr_q[update_index])\n              2'b00:   ctr_q[update_index] <= 2'b01;\n              2'b01:   ctr_q[update_index] <= 2'b10;\n              default: ctr_q[update_index] <= 2'b11;\n            endcase\n          end else begin\n            ctr_q[update_index] <= 2'b10;\n          end\n        end else if (update_hit) begin\n          case (ctr_q[update_index])\n            2'b11:   ctr_q[update_index] <= 2'b10;\n            2'b10:   ctr_q[update_index] <= 2'b01;\n            default: ctr_q[update_index] <= 2'b00;\n          endcase\n        end\n      end else begin\n        valid_q[update_index]  <= 1'b1;\n        tag_q[update_index]    <= update_tag;\n        target_q[update_index] <= update_target;\n        ctr_q[update_index]    <= 2'b11;\n      end\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
