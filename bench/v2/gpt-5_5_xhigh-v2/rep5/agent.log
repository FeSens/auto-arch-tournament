{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"sed -n '1,24p' cores/bench/rtl/m_unit.sv\"","aggregated_output":"// rtl/m_unit.sv\n//\n// Multi-cycle RV32M execution unit. The core starts one operation with\n// start=1 while busy=0/done=0, then holds the EX instruction until done=1.\n// The result remains stable with done for one cycle.\n//\n// MUL* uses a small registered pipeline:\n//   raw operands -> signed magnitude -> 16x16 partial products -> 64-bit sum\n// DIV*/REM* uses a 32-step restoring divider after signed pre-processing.\nmodule m_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n\n  localparam logic [2:0] S_IDLE      = 3'd0;\n  localparam logic [2:0] S_MUL_ABS   = 3'd1;\n  localparam logic [2:0] S_MUL_PART  = 3'd2;\n","exit_code":0,"status":"completed"}}
