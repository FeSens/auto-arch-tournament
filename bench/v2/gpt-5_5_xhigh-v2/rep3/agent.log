{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"nl -ba cores/bench/rtl/if_stage.sv | sed -n '1,120p'\"","aggregated_output":"     1\t// rtl/if_stage.sv\n     2\t//\n     3\t// Instruction fetch stage. Holds the PC register; the IF/ID payload\n     4\t// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n     5\t// flop in this microarchitecture, the next-stage's ID/EX register\n     6\t// captures everything one cycle later.\n     7\t//\n     8\t// On flush or redirect, the instruction emitted to ID is forced to NOP\n     9\t// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n    10\t// observing a real rs1/rs2 from a wrong-path instruction and inserting\n    11\t// a spurious load-use stall the cycle after a taken branch.\n    12\t//\n    13\t// Latency:        PC-reg update is synchronous; output is combinational.\n    14\t// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n    15\t//                 EX-stage redirect).\n    16\tmodule if_stage (\n    17\t  input  logic              clock,\n    18\t  input  logic              reset,\n    19\t  input  logic              stall,            // hold PC (load-use)\n    20\t  input  logic              flush,            // emit NOP into ID this cycle\n    21\t  input  logic              redirect,         // EX has resolved a branch/jump\n    22\t  input  logic [31:0]       redirect_target,\n    23\t  output logic [31:0]       imem_addr,\n    24\t  input  logic [31:0]       imem_data,\n    25\t  output if_id_t  out\n    26\t);\n    27\t\n    28\t  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n    29\t\n    30\t  logic [31:0] pc;\n    31\t  logic [31:0] next_pc;\n    32\t\n    33\t  always_comb begin\n    34\t    next_pc = redirect ? redirect_target : pc + 32'd4;\n    35\t  end\n    36\t\n    37\t  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n    38\t  // redirect on the same cycle as imem_stall or dmem_stall — without\n    39\t  // this priority the redirect target would be silently dropped, the\n    40\t  // PC would hold its old (wrong-path) value, and execution would\n    41\t  // resume on the wrong path once the bus unstalls. Verified by the\n    42\t  // VexRiscv-binary CoreMark sweep with --istall enabled.\n    43\t  always_ff @(posedge clock) begin\n    44\t    if      (reset)    pc <= RESET_PC;\n    45\t    else if (redirect) pc <= redirect_target;\n    46\t    else if (!stall)   pc <= next_pc;\n    47\t  end\n    48\t\n    49\t  assign imem_addr = pc;\n    50\t\n    51\t  always_comb begin\n    52\t    out.pc    = pc;\n    53\t    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    54\t    out.valid = !(flush || redirect);\n    55\t  end\n    56\t\n    57\tendmodule\n","exit_code":0,"status":"completed"}}
