{"type": "item.completed", "item": {"id": "item_107", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_hazard_unit.py && sed -n '200,235p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Focused tests for rtl/hazard_unit.sv load-use source masking.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\n\n\nasync def _poke(\n    dut,\n    *,\n    rd=5,\n    rs1=0,\n    rs2=0,\n    uses_rs1=1,\n    uses_rs2=1,\n    mem_read=1,\n    fetch_valid=1,\n    fetch_kill=0,\n    redirect=0,\n    dmem_ready=1,\n    ex_mem_mem_op=0,\n    div_busy=0,\n):\n    dut.id_ex_mem_read.value = mem_read\n    dut.id_ex_rd.value = rd\n    dut.fetch_rs1.value = rs1\n    dut.fetch_rs2.value = rs2\n    dut.fetch_uses_rs1.value = uses_rs1\n    dut.fetch_uses_rs2.value = uses_rs2\n    dut.fetch_valid.value = fetch_valid\n    dut.fetch_kill.value = fetch_kill\n    dut.redirect.value = redirect\n    dut.dmem_ready.value = dmem_ready\n    dut.ex_mem_mem_op.value = ex_mem_mem_op\n    dut.div_busy.value = div_busy\n    await Timer(1, \"ns\")\n\n\ndef _assert_load_use_outputs(dut, expected):\n    assert int(dut.stall_if.value) == expected\n    assert int(dut.stall_id.value) == expected\n    assert int(dut.flush_id.value) == expected\n    assert int(dut.flush_if.value) == 0\n    assert int(dut.stall_ex_mem.value) == 0\n    assert int(dut.hold_mem_wb.value) == 0\n\n\n@cocotb.test()\nasync def one_source_opcodes_ignore_rs2_field(dut):\n    \"\"\"LOAD, OP-IMM, and JALR-style consumers stall on rs1, not raw rs2.\"\"\"\n    await _poke(dut, rd=5, rs1=0, rs2=5, uses_rs1=1, uses_rs2=0)\n    _assert_load_use_outputs(dut, 0)\n\n    await _poke(dut, rd=5, rs1=5, rs2=0, uses_rs1=1, uses_rs2=0)\n    _assert_load_use_outputs(dut, 1)\n\n\n@cocotb.test()\nasync def zero_source_opcodes_do_not_load_use_stall(dut):\n    \"\"\"LUI, AUIPC, JAL, and FENCE-style opcodes consume neither raw field.\"\"\"\n    await _poke(dut, rd=7, rs1=7, rs2=7, uses_rs1=0, uses_rs2=0)\n    _assert_load_use_outputs(dut, 0)\n\n\n@cocotb.test()\nasync def two_source_opcodes_stall_on_either_operand(dut):\n    \"\"\"OP, STORE, and BRANCH-style consumers still stall on rs1 or rs2.\"\"\"\n    await _poke(dut, rd=9, rs1=9, rs2=0, uses_rs1=1, uses_rs2=1)\n    _assert_load_use_outputs(dut, 1)\n\n    await _poke(dut, rd=9, rs1=0, rs2=9, uses_rs1=1, uses_rs2=1)\n    _assert_load_use_outputs(dut, 1)\n\n\n@cocotb.test()\nasync def x0_load_destination_never_stalls(dut):\n    await _poke(dut, rd=0, rs1=0, rs2=0, uses_rs1=1, uses_rs2=1)\n    _assert_load_use_outputs(dut, 0)\n\n\ndef test_hazard_unit_runner():\n    run_cocotb(\n        toplevel=\"hazard_unit\",\n        sources=[\"hazard_unit.sv\"],\n        test_module=\"test_hazard_unit\",\n    )\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def op_imm_raw_rs2_match_does_not_stall(dut):\n    \"\"\"ADDI's imm[4:0] matching a LOAD rd must not add a false bubble.\"\"\"\n    async def addi_retire_cycle(imm):\n        program = [\n            LW(5, 0, 0),        # rd=x5\n            ADDI(6, 0, imm),    # imm[4:0] may look like raw rs2=x5\n            EBREAK(),\n        ]\n        rets, _ = await _run(dut, program, dmem_init={0: 0x12345678})\n        [ret] = _by_insn(rets, ADDI(6, 0, imm))\n        return ret[\"cycle\"]\n\n    false_match_cycle = await addi_retire_cycle(5)\n    independent_cycle = await addi_retire_cycle(6)\n    assert false_match_cycle == independent_cycle, (\n        f\"false raw-rs2 match added a bubble: {false_match_cycle} != {independent_cycle}\"\n    )\n\n\n@cocotb.test()\nasync def divu_stalls_and_forwards(dut):\n    \"\"\"DIVU is iterative, then the dependent ADDI must see its result.\"\"\"\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIVU(3, 1, 2),\n        ADDI(4, 3, 1),\n", "exit_code": 0, "status": "completed"}}
{"type":"item.completed","item":{"id":"item_108","type":"agent_message","text":"Implemented opcode-aware load-use stalls for `cores/bench`.\n\nChanged:\n- Added fetch opcode source-use masking in `rtl/core.sv`.\n- Gated `hazard_unit` load-use compares with `fetch_uses_rs1/rs2`.\n- Added MEM load-data forwarding and misaligned-memory forwarding gating to keep raw RVFI source data correct without restoring false bubbles.\n- Added focused `test/test_hazard_unit.py` cases and an end-to-end OP-IMM false-rs2 pipeline test.\n- Wrote `cores/bench/implementation_notes.md`.\n\nChecks:\n- `verilator --lint-only ...`: pass\n- `pytest -q cores/bench/test/test_hazard_unit.py cores/bench/test/test_pipeline.py`: pass\n- `RTL_DIR=cores/bench/rtl CORE_NAME=bench bash formal/run_all.sh`: pass, 53/53\n- `NRET=1 make cosim TARGET=bench`: pass, 2 ELFs tested\n\nNote: bare `make cosim TARGET=bench` defaulted the local build script to `NRET=2` and failed to compile against this `nret: 1` core; rerunning with `NRET=1` matched `core.yaml` and passed."}}
