{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"nl -ba cores/bench/rtl/hazard_unit.sv | sed -n '1,180p'\"", "aggregated_output": "     1\t// rtl/hazard_unit.sv\n     2\t//\n     3\t// Detects the only data hazard the textbook 5-stage doesn't cover via\n     4\t// forwarding: load-use. A LOAD in EX produces its data only after MEM,\n     5\t// so an instruction immediately behind that consumes the LOAD's rd\n     6\t// must be stalled by exactly one cycle.\n     7\t//\n     8\t// Outputs:\n     9\t//   stall_if / stall_id : freeze the PC reg and the IF/ID combinational\n    10\t//                          payload (cleared by ID's flush input).\n    11\t//   flush_if / flush_id : on EX redirect, kill the two in-flight\n    12\t//                          instructions ahead of the redirect target.\n    13\t//   flush_id            : also kills ID's own register on load-use to\n    14\t//                          inject a single-cycle bubble between LOAD\n    15\t//                          and the dependent instruction.\n    16\t//\n    17\t// Latency:        combinational.\n    18\t// RVFI fields:    n/a (governs validity of subsequent retirements).\n    19\tmodule hazard_unit (\n    20\t  input  logic       id_ex_mem_read,    // ID/EX.ctrl.mem_read (LOAD in EX)\n    21\t  input  logic [4:0] id_ex_rd,          // ID/EX.rd            (LOAD's dest)\n    22\t  input  logic [4:0] if_id_rs1,         // IF/ID instr[19:15]  (next rs1)\n    23\t  input  logic [4:0] if_id_rs2,         // IF/ID instr[24:20]  (next rs2)\n    24\t  input  logic       redirect,          // EX has resolved a branch/jump\n    25\t  // Bus backpressure (default-1 in zero-wait testbenches; VexRiscv-style\n    26\t  // random ~22% stall in vex_main.cpp). When low, the corresponding\n    27\t  // memory request is NOT serviced this cycle.\n    28\t  input  logic       imem_ready,\n    29\t  input  logic       dmem_ready,\n    30\t  // EX/MEM has a memory op in flight (the LOAD/STORE the dmem stall\n    31\t  // would actually be holding up). Computed at top level from the\n    32\t  // EX/MEM register's ctrl.mem_read | ctrl.mem_write.\n    33\t  input  logic       ex_mem_mem_op,\n    34\t  // Iterative divider in EX is working on the instructi\n…[1746 of 4818 chars elided by tools/bench/transcript.py; sha256:0f26fee6120af081]…\n  (kill wrong-path)\n    68\t    //   - div_busy    -> hold        (preserve DIV/REM in EX)\n    69\t    //   - otherwise   -> capture\n    70\t    // dmem_stall/div_busy take precedence over load_use's bubble:\n    71\t    // re-evaluate load_use next cycle when the hold reason clears.\n    72\t    // flush_id is 1 only when we want bubble (not hold).\n    73\t    stall_id      = dmem_stall || div_busy || load_use_hazard;\n    74\t    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !div_busy;\n    75\t    // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n    76\t    // bus delivers).\n    77\t    stall_ex_mem  = dmem_stall;\n    78\t    // MEM/WB register: on dmem_stall the previously-retired instruction's\n    79\t    // data fields stay alive for forwarding (e.g. a held BNE needs the\n    80\t    // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n    81\t    // double-retire / double-write the regfile.\n    82\t    hold_mem_wb   = dmem_stall;\n    83\t  end\n    84\t\n    85\tendmodule\n", "exit_code": 0, "status": "completed"}}
