84:    result = run_cosim(\nMakefile:1:.PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\nMakefile:53:CORE_TARGETS := lint test cosim cosim-build formal formal-deep fpga next loop\nMakefile:79:\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\nMakefile:112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\nMakefile:113:\tpython3 -m tools.eval.cosim . $(TARGET)\nMakefile:115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\nMakefile:116:\tbash test/cosim/build.sh\nMakefile:137:fpga: cosim-build bench/programs/coremark.elf\nMakefile:178:\trm -rf test/cosim/sim_build sim_build out\ntest/cosim/build.sh:2:# Build the Verilator-based cosim binary that drives `core` against an ELF\ntest/cosim/build.sh:3:# program. Produces $OBJ_DIR/cosim_sim (default: test/cosim/obj_dir/cosim_sim).\ntest/cosim/build.sh:13:COSIM_DIR=\"$REPO_ROOT/test/cosim\"\ntest/cosim/build.sh:15:  echo \"ERROR: test/cosim/build.sh requires RTL_DIR and OBJ_DIR env vars.\" >&2\ntest/cosim/build.sh:16:  echo \"  Example: RTL_DIR=cores/v1/rtl OBJ_DIR=cores/v1/obj_dir bash test/cosim/build.sh\" >&2\ntest/cosim/build.sh:20:# NRET picks which RVFI port set main.cpp expects on `core`.\ntest/cosim/build.sh:24:NRET=\"${NRET:-2}\"\ntest/cosim/build.sh:55:  -CFLAGS \"-DNRET=$NRET\" \\\ntest/cosim/build.sh:58:  -o cosim_sim\ntest/cosim/build.sh:60:echo \"Built: $OBJ_DIR/cosim_sim\"\n","exit_code":0,"status":"completed"}}
