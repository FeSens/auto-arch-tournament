y:74:    Stores get applied to the Python-side dmem dict so subsequent loads\ncores/bench/test/test_pipeline.py:77:    Returns (retirements, dmem) where retirements is a list of dicts\ncores/bench/test/test_pipeline.py:78:    sampled on every cycle that rvfi_valid=1.\ncores/bench/test/te\n…[5521 of 8593 chars elided by tools/bench/transcript.py; sha256:931e93f44ea58985]…\n361:    rets, _ = await _run(dut, program)\ncores/bench/test/test_pipeline.py:370:    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\ncores/bench/test/test_pipeline.py:375:    rets, _ = await _run(dut, program)\ncores/bench/test/test_pipeline.py:382:    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\ncores/bench/test/test_pipeline.py:384:    rets, _ = await _run(dut, program, max_cycles=20)\ncores/bench/test/test_pipeline.py:390:async def rvfi_order_strictly_monotonic(dut):\ncores/bench/test/test_pipeline.py:391:    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\ncores/bench/test/test_pipeline.py:399:    rets, _ = await _run(dut, program)\ncores/bench/test/test_pipeline.py:404:def test_pipeline_runner():\ncores/bench/test/test_pipeline.py:405:    run_cocotb(\ncores/bench/test/test_div_unit.py:10:    run_cocotb,\ncores/bench/test/test_div_unit.py:135:def test_div_unit_runner():\ncores/bench/test/test_div_unit.py:136:    run_cocotb(\n", "exit_code": 0, "status": "completed"}}
