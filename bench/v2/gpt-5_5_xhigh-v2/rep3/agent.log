{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/alu.sv\"", "aggregated_output": "// rtl/alu.sv\n//\n// RV32IM combinational ALU. Hardware multiplier stays on the combinational\n// path; DIV/REM-class operations are handled by div_unit in ex_stage so the\n// common EX path does not carry a full divider/remainder network.\n//\n// RV32IM division semantics (overridden from straight `signed /`):\n//   DIV  by 0       -> -1   (all ones)\n//   DIVU by 0       -> 0xFFFFFFFF\n//   DIV  INT_MIN/-1 -> INT_MIN  (no trap, defined overflow)\n//   REM  by 0       -> dividend\n//   REMU by 0       -> dividend\n//   REM  INT_MIN/-1 -> 0\n//\n// Latency:        combinational (0 cycles). DIV/REM real hardware latency\n//                 is provided by div_unit, not this module.\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n  logic               addsub_is_sub;\n  logic               addsub_sel;\n  logic        [31:0] addsub_b;\n  logic        [31:0] addsub_result;\n  logic        [31:0] residual_result;\n\n  // 64-bit products, computed once and selected per op.\n  // mul_ss/mul_su low halves are unused (only MULH/MULHSU read the high\n  // half). Verilator's UNUSEDSIGNAL is silenced locally — the unused\n  // bits are dead-code-eliminated by Yosys.\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [63:0] mul_ss;  // signed*signed\n  logic        [63:0] mul_uu;  // unsigned*unsigned (both halves used)\n  logic signed [63:0] mul_su;  // signed*unsigned (a signed, b unsigned)\n  /* verilator lint_on UNUSEDSIGNAL */\n\n  assign shamt         = b[4:0];\n  assign addsub_is_sub = op[0];\n  assign addsub_sel    = (op[4:1] == 4'b0000);\n  assign addsub_b      = b ^ {32{addsub_is_sub}};\n  assign addsub_result = a + addsub_b + {31'b0, addsub_is_sub};\n  assign out           = addsub_sel ? addsub_result : residual_result;\n\n  always_comb begin\n    mul_ss = $signed({{32{a[31]}}, a}) * $signed({{32{b[31]}}, b});\n    mul_uu = {32'b0, a} * {32'b0, b};\n    mul_su = $signed({{32{a[31]}}, a}) * $signed({32'b0, b});\n\n    residual_result = 32'b0;\n    case (op)\n      ALU_AND:    residual_result = a & b;\n      ALU_OR:     residual_result = a | b;\n      ALU_XOR:    residual_result = a ^ b;\n      ALU_SLT:    residual_result = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   residual_result = {31'b0, a < b};\n      ALU_SLL:    residual_result = a << shamt;\n      ALU_SRL:    residual_result = a >> shamt;\n      ALU_SRA:    residual_result = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    residual_result = b;\n\n      // M-extension. Under RISCV_FORMAL_ALTOPS the hardware operations\n      // are substituted for tractable algebraic stand-ins so bitwuzla\n      // can solve the BMC inside the 20-step depth budget. The same\n      // substitution must appear in the riscv-formal spec (insn_*.v).\n      // The Verilator/cocotb/cosim builds leave ALTOPS undefined and\n      // run the real arithmetic.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    residual_result = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   residual_result = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  residual_result = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: residual_result = (a - b) ^ 32'hecfbe137;\n      ALU_DIV:    residual_result = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU:   residual_result = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:    residual_result = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU:   residual_result = (a - b) ^ 32'h3138d0e1;\n`else\n      ALU_MUL:    residual_result = mul_uu[31:0];\n      ALU_MULH:   residual_result = $unsigned(mul_ss[63:32]);\n      ALU_MULHU:  residual_result = mul_uu[63:32];\n      ALU_MULHSU: residual_result = $unsigned(mul_su[63:32]);\n      // Real DIV/REM operations are multi-cycle in ex_stage. Keep these\n      // opcodes benign here so they cannot infer a combinational divider.\n      ALU_DIV,\n      ALU_DIVU,\n      ALU_REM,\n      ALU_REMU:   residual_result = 32'b0;\n`endif\n      default:    residual_result = 32'b0;\n    endcase\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
