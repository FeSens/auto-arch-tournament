branch instructions.\nexpected_impact:\n  fitness_delta_pct: 5\n  confidence: low\nchanges:\n  - file: rtl/core_pkg.sv\n    description: \"Add a single predicted_jal_x0 bit to id_ex_t so EX can identify aligned non-link JALs already redirected by decode.\"\n  - file: rtl/id_stage.sv\n    description: \"Detect valid aligned JAL rd=x0 instructions on ID accept, compute the early target, and emit the prediction marker without changing other instruction classes.\"\n  - file: rtl/if_stage.sv\n    description: \"Add a decode-predict redirect input that updates the PC to the early JAL x0 target while preserving existing reset, stall, and EX redirect priorities.\"\n  - file: rtl/ex_stage.sv\n    description: \"Suppress the normal EX jump redirect only for marked predicted JAL x0 instructions, while keeping RVFI pc_next, misaligned-target traps, and link-writing JAL behavior exact.\"\n  - file: rtl/core.sv\n    description: \"Wire the early JAL x0 target and marker between ID, IF, and EX under the existing nret=1 top-level IO contract.\"\n  - file: test/test_pipeline.py\n    description: \"Add focused coverage for predicted aligned JAL x0, ordinary JAL with link write, JALR fallback, and misaligned JAL trap behavior.\"\n","exit_code":0,"status":"completed"}}
