{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/mulh_unit.sv\"","aggregated_output":"// rtl/mulh_unit.sv\n//\n// Multi-cycle RV32M high-half multiplier for MULH, MULHU, and MULHSU.\n// One start pulse captures operands, the next cycle performs an unsigned\n// product from registered operands, the following cycle applies the high-half\n// signed correction when needed, then done/result stay high until the caller\n// clears them after accepting the result.\n//\n// Latency:        3 EX hold cycles from start to result handoff.\n// RVFI fields:    feeds rd_wdata through ex_stage's normal EX/MEM register.\nmodule mulh_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic        clear,\n  input  logic [4:0]  op,\n  input  logic [31:0] lhs,\n  input  logic [31:0] rhs,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n\n  logic        active_q;\n  logic        correct_phase_q;\n  logic        done_q;\n  logic [31:0] result_q;\n  logic [4:0]  op_q;\n  logic [31:0] lhs_q;\n  logic [31:0] rhs_q;\n  logic [31:0] product_high_q;\n\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [63:0] unsigned_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic        lhs_signed;\n  logic        rhs_signed;\n  logic [31:0] lhs_correction;\n  logic [31:0] rhs_correction;\n  logic [31:0] corrected_high;\n\n  always_comb begin\n    unsigned_product = {32'b0, lhs_q} * {32'b0, rhs_q};\n\n    lhs_signed = (op_q == ALU_MULH) || (op_q == ALU_MULHSU);\n    rhs_signed = (op_q == ALU_MULH);\n\n    lhs_correction = (lhs_signed && lhs_q[31]) ? rhs_q : 32'b0;\n    rhs_correction = (rhs_signed && rhs_q[31]) ? lhs_q : 32'b0;\n    corrected_high = product_high_q - lhs_correction - rhs_correction;\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      active_q        <= 1'b0;\n      correct_phase_q <= 1'b0;\n      done_q          <= 1'b0;\n      result_q        <= 32'b0;\n      op_q            <= ALU_MULHU;\n      lhs_q           <= 32'b0;\n      rhs_q           <= 32'b0;\n      product_high_q  <= 32'b0;\n    end else if (clear) begin\n      done_q <= 1'b0;\n    end else if (active_q) begin\n      if (correct_phase_q) begin\n        active_q        <= 1'b0;\n        correct_phase_q <= 1'b0;\n        done_q          <= 1'b1;\n        result_q        <= corrected_high;\n      end else begin\n        correct_phase_q <= 1'b1;\n        product_high_q  <= unsigned_product[63:32];\n      end\n    end else if (start && !done_q) begin\n      active_q        <= 1'b1;\n      correct_phase_q <= 1'b0;\n      done_q          <= 1'b0;\n      op_q            <= op;\n      lhs_q           <= lhs;\n      rhs_q           <= rhs;\n    end\n  end\n\n  assign busy   = active_q;\n  assign done   = done_q;\n  assign result = result_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
