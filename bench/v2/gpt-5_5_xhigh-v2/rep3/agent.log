alid    (fetch_valid_for_hazard),\n    .fetch_kill     (fetch_kill_for_hazard),\n    .redirect       (redirect),\n    .dmem_ready     (io_dmemReady),\n    .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\n    .div_busy       (ex_div_busy),\n    .stall_if       (stall_if),\n    .stall_id       (stall_id),\n    .flush_if       (flush_if),\n    .flush_id       (flush_id),\n","exit_code":0,"status":"completed"}}
