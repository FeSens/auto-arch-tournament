ess_delta_pct: 5\n  confidence: medium\nchanges:\n  - file: rtl/core_pkg.sv\n    description: \"Add a registered final writeback-data field to mem_wb_t, or replace the WB-only alu_result/read_data fields with that final value while preserving RVFI memory metadata.\"\n  - file: rtl/mem_stage.sv\n    description: \"Select and latch the final rd writeback value at the MEM/WB boundary, and retain it during dmem hold cycles for MEM/WB forwarding.\"\n  - file: rtl/wb_stage.sv\n    description: \"Drive w_data directly from the registered MEM/WB writeback value so WB no longer contains a live mem_to_reg data mux.\"\n  - file: rtl/core.sv\n    description: \"Forward the registered WB value into EX and RVFI rd_wdata through the existing wiring without changing any top-level ports.\"\n  - file: test/test_pipeline.py\n    description: \"Add focused RAW tests for ALU results, loads, and dmem-stalled load-use forwarding to catch stale registered writeback values.\"\n","exit_code":0,"status":"completed"}}
