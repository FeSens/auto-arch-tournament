{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_posted_store_predictor.py\"","aggregated_output":"\"\"\"Focused tests for the one-entry posted-store buffer.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADDI, LW, SW, EBREAK, _by_insn, _run\n\n\ndef LUI(rd, imm20):\n    return ((imm20 & 0xFFFFF) << 12) | ((rd & 0x1F) << 7) | 0b0110111\n\n\n@cocotb.test()\nasync def stalled_ram_store_retires_once_while_alu_continues(dut):\n    stalls_left = 3\n\n    def stall_word0(_cycle, dut):\n        nonlocal stalls_left\n        if int(dut.io_dmemWEn.value) and int(dut.io_dmemAddr.value) == 0 and stalls_left:\n            stalls_left -= 1\n            return 0\n        return 1\n\n    sw = SW(1, 0, 0)\n    add = ADDI(2, 0, 7)\n    program = [\n        ADDI(1, 0, 0x44),\n        sw,\n        add,\n        ADDI(3, 2, 1),\n        EBREAK(),\n    ]\n\n    rets, dmem = await _run(dut, program, dmem_ready_fn=stall_word0, max_cycles=80)\n    store_rets = _by_insn(rets, sw)\n    assert len(store_rets) == 1\n    [r_sw] = store_rets\n    [r_add] = _by_insn(rets, add)\n    assert r_add[\"cycle\"] <= r_sw[\"cycle\"] + 2\n    assert dmem.get(0) == 0x44\n    assert stalls_left == 0\n\n\n@cocotb.test()\nasync def younger_load_waits_for_posted_store_drain(dut):\n    stalls_left = 2\n\n    def stall_word0(_cycle, dut):\n        nonlocal stalls_left\n        if int(dut.io_dmemWEn.value) and int(dut.io_dmemAddr.value) == 0 and stalls_left:\n            stalls_left -= 1\n            return 0\n        return 1\n\n    sw = SW(1, 0, 0)\n    lw = LW(2, 0, 0)\n    program = [\n        ADDI(1, 0, 0x66),\n        sw,\n        lw,\n        EBREAK(),\n    ]\n\n    rets, dmem = await _run(dut, program, dmem_ready_fn=stall_word0, max_cycles=80)\n    [r_sw] = _by_insn(rets, sw)\n    [r_lw] = _by_insn(rets, lw)\n    assert r_lw[\"cycle\"] > r_sw[\"cycle\"] + 1\n    assert r_lw[\"rd_wdata\"] == 0x66\n    assert dmem.get(0) == 0x66\n    assert stalls_left == 0\n\n\n@cocotb.test()\nasync def marker_mmio_store_is_not_posted(dut):\n    stalls_left = 3\n    first_marker_cycle = None\n    marker_addr = 0x10000100\n\n    def stall_marker(cycle, dut):\n        nonlocal stalls_left, first_marker_cycle\n        if int(dut.io_dmemWEn.value) and int(dut.io_dmemAddr.value) == marker_addr:\n            if first_marker_cycle is None:\n                first_marker_cycle = cycle\n            if stalls_left:\n                stalls_left -= 1\n                return 0\n        return 1\n\n    marker_store = SW(2, 1, 0x100)\n    program = [\n        LUI(1, 0x10000),\n        ADDI(2, 0, 1),\n        marker_store,\n        ADDI(3, 0, 9),\n        EBREAK(),\n    ]\n\n    rets, _ = await _run(dut, program, dmem_ready_fn=stall_marker, max_cycles=100)\n    [r_marker] = _by_insn(rets, marker_store)\n    [r_after] = _by_insn(rets, ADDI(3, 0, 9))\n    assert first_marker_cycle is not None\n    assert r_marker[\"cycle\"] >= first_marker_cycle + 3\n    assert r_after[\"cycle\"] > r_marker[\"cycle\"]\n    assert stalls_left == 0\n\n\ndef test_posted_store_predictor_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"div_unit.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_posted_store_predictor\",\n    )\n","exit_code":0,"status":"completed"}}
