{"type": "item.completed", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/if_stage.sv\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// A tiny direct-mapped BTB predicts recurring taken control flow. The\n// predicted next PC is carried with the instruction so EX can recover\n// only when the prediction differs from the resolved next PC.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              btb_update,\n  input  logic [31:0]       btb_update_pc,\n  input  logic [31:0]       btb_update_target,\n  input  logic              btb_update_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam int BTB_ENTRIES = 8;\n  localparam int BTB_INDEX_BITS = 3;\n  localparam int BTB_TAG_BITS = 32 - 2 - BTB_INDEX_BITS;\n\n  logic [31:0] pc;\n  logic [31:0] pc_plus4;\n  logic [31:0] next_pc;\n\n  logic                    btb_valid  [0:BTB_ENTRIES-1];\n  logic [BTB_TAG_BITS-1:0] btb_tag    [0:BTB_ENTRIES-1];\n  logic [31:0]             btb_target [0:BTB_ENTRIES-1];\n  logic [1:0]              btb_ctr    [0:BTB_ENT\n…[1471 of 4543 chars elided by tools/bench/transcript.py; sha256:ecc7e13c6a3a0b4a]…\n]  <= 1'b1;\n        btb_tag[update_idx]    <= update_tag;\n        btb_target[update_idx] <= btb_update_target;\n        if (!btb_valid[update_idx] || btb_tag[update_idx] != update_tag) begin\n          btb_ctr[update_idx] <= btb_update_taken ? 2'b10 : 2'b01;\n        end else if (btb_update_taken) begin\n          btb_ctr[update_idx] <= (btb_ctr[update_idx] == 2'b11)\n                               ? 2'b11\n                               : (btb_ctr[update_idx] + 2'b01);\n        end else begin\n          btb_ctr[update_idx] <= (btb_ctr[update_idx] == 2'b00)\n                               ? 2'b00\n                               : (btb_ctr[update_idx] - 2'b01);\n        end\n      end\n\n      if      (redirect) pc <= redirect_target;\n      else if (!stall)   pc <= next_pc;\n    end\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc           = pc;\n    out.pred_next_pc = next_pc;\n    out.instr        = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid        = !(flush || redirect);\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
