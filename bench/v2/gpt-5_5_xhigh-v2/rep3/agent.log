{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"sed -n '174,205p' cores/bench/rtl/core.sv\"","aggregated_output":"    .w_data (wb_w_data)\n  );\n\n  // ── Hazard / forwarding ───────────────────────────────────────────────\n  // Load-use detection intentionally looks at the raw fetch word instead\n  // of if_id_w.instr. if_id_w.instr is still muxed to NOP on flush for ID,\n  // but keeping the hazard compare off that mux shortens the EX redirect\n  // control loop.\n  assign fetch_valid_for_hazard = io_imemReady;\n  assign fetch_kill_for_hazard  = redirect;\n\n  hazard_unit u_hazard (\n    .id_ex_mem_read (id_ex_w.ctrl.mem_read),\n    .id_ex_rd       (id_ex_w.rd),\n    .fetch_rs1      (io_imemData[19:15]),\n    .fetch_rs2      (io_imemData[24:20]),\n    .fetch_valid    (fetch_valid_for_hazard),\n    .fetch_kill     (fetch_kill_for_hazard),\n    .redirect       (redirect),\n    .dmem_ready     (io_dmemReady),\n    .ex_mem_mem_op  (ex_mem_w.ctrl.mem_read | ex_mem_w.ctrl.mem_write),\n    .div_busy       (ex_div_busy),\n    .stall_if       (stall_if),\n    .stall_id       (stall_id),\n    .flush_if       (flush_if),\n    .flush_id       (flush_id),\n    .stall_ex_mem   (stall_ex_mem),\n    .hold_mem_wb    (hold_mem_wb)\n  );\n\n  forward_unit u_fwd (\n    .id_ex_rs1   (id_ex_w.rs1_addr),\n","exit_code":0,"status":"completed"}}
