{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nvcd=Path('/srv/hwebench/clones/gpt-5_5_xhigh-v2-rep3/formal/riscv-formal/cores/bench-w0byaTqjY/checks/pc_fwd_ch0/engine_0/trace.vcd')\n# signals of interest as they appear under top testbench.UUT.wrapper.uut\nnames={\n 'n155':'order','n156':'pc','n157':'pc_next','n165':'valid','n168':'train_valid','n166':'train_pc','n167':'train_target','n171':'redirect','n172':'redirect_target',\n 'n313':'if_redirect','n314':'if_redirect_target','n309':'if_train_valid','n307':'if_train_pc','n308':'if_train_target'\n}\nvals={k:'x' for k in names}\ntime=0\nrows=[]\nwith vcd.open() as f:\n    in_defs=True\n    for line in f:\n        line=line.strip()\n        if not line: continue\n        if line.startswith('#'):\n            # record previous time snapshot\n            if time:\n                rows.append((time, vals.copy()))\n            time=int(line[1:])\n        elif line[0] in '01xz':\n            val=line[0]; code=line[1:]\n            if code in vals: vals[code]=val\n        elif line[0]=='b':\n            parts=line.split()\n            if len(parts)==2:\n                val=parts[0][1:]; code=parts[1]\n                if code in vals: vals[code]=val\n# append final\nrows.append((time, vals.copy()))\nprint('retirements:')\nlast_valid='0'\nfor t,v in rows:\n    if v['valid']=='1':\n        def hx(bits):\n            if any(c in bits for c in 'xz'): return bits\n            return f\\\"0x{int(bits,2):08x}\\\" if len(bits)<=32 else str(int(bits,2))\n        print(t, 'ord', hx(v['order']), 'pc', hx(v['pc']), 'next', hx(v['pc_next']), 'redir', v['redirect'], hx(v['redirect_target']), 'train', v['train_valid'], hx(v['train_target']))\nprint('events:')\nfor t,v in rows:\n    if v['redirect']=='1' or v['train_valid']=='1':\n        def hx(bits):\n            if any(c in bits for c in 'xz'): return bits\n            return f\\\"0x{int(bits,2