{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c 'nl -ba cores/bench/rtl/id_stage.sv'", "aggregated_output": "     1\t// rtl/id_stage.sv\n     2\t//\n     3\t// Decode stage. Combinationally drives the regfile read ports and the\n     4\t// ID/EX register's next-state from the IF/ID combinational bundle plus\n     5\t// the regfile read data. The ID/EX register is owned by this module so\n     6\t// the decoded view of instruction n is latched by end of cycle n+1.\n     7\t//\n     8\t// Latency:        1 cycle (ID/EX register clocked here).\n     9\t// RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata, insn,\n    10\t//                 trap (via ctrl.is_illegal).\n    11\tmodule id_stage (\n    12\t  input  logic              clock,\n    13\t  input  logic              reset,\n    14\t  input  logic              stall,\n    15\t  input  logic              flush,\n    16\t  input  if_id_t  in,\n    17\t  // regfile read interface\n    18\t  output logic [4:0]        rs1_addr,\n    19\t  output logic [4:0]        rs2_addr,\n    20\t  input  logic [31:0]       rs1_data,\n    21\t  input  logic [31:0]       rs2_data,\n    22\t  // ID/EX register output\n    23\t  output id_ex_t  out\n    24\t);\n    25\t\n    26\t  // ── Combinational decode ────────────────────────────────────────────────\n    27\t  logic [4:0]  dec_alu_op;\n    28\t  logic        dec_alu_src;\n    29\t  logic [2:0]  dec_branch_op;\n    30\t  logic        dec_is_branch;\n    31\t  logic        dec_is_jump;\n    32\t  logic        dec_is_jalr;\n    33\t  logic        dec_is_lui;\n    34\t  logic        dec_is_auipc;\n    35\t  logic        dec_mem_read;\n    36\t  logic        dec_mem_write;\n    37\t  logic [1:0]  dec_mem_width;\n    38\t  logic        dec_mem_sext;\n    39\t  logic        dec_reg_write;\n    40\t  logic        dec_mem_to_reg;\n    41\t  logic        dec_is_illegal;\n    42\t\n    43\t  decoder u_decoder (\n    44\t