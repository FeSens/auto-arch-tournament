ctrl.is_jump && (jump_target[1:0] != 2'b00);\n+    misalign_jump   = in.valid && in.ctrl.is_jump && (jump_target[1:0] != 2'b00);\n     misalign_fault  = misalign_branch || misalign_jump;\n \n     ctrl_with_trap = in.ctrl;\n@@ -178,8 +178,8 @@ module ex_stage (\n     end\n   end\n \n-  assign redirect        = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\n-  assign redirect_\n…[2298 of 5370 chars elided by tools/bench/transcript.py; sha256:33c99d990fa2785f]…\n.sv\n@@ -5,10 +5,9 @@\n // flop in this microarchitecture, the next-stage's ID/EX register\n // captures everything one cycle later.\n //\n-// On flush or redirect, the instruction emitted to ID is forced to NOP\n-// (`0x00000013` = ADDI x0,x0,0). The hazard unit receives raw fetch\n-// source fields separately and gates them with explicit valid/kill inputs,\n-// so this correctness mux is not on the load-use compare path.\n+// On flush or redirect, the payload is marked invalid while the raw imem\n+// word still flows through. ID converts invalid payloads into ID/EX bubbles,\n+// keeping redirect/imem-stall control off the full 32-bit instruction path.\n //\n // Latency:        PC-reg update is synchronous; output is combinational.\n // RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n@@ -50,7 +49,7 @@ module if_stage (\n \n   always_comb begin\n     out.pc    = pc;\n-    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n+    out.instr = imem_data;\n     out.valid = !(flush || redirect);\n   end\n \n", "exit_code": 0, "status": "completed"}}
