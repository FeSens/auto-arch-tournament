{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/branch_fill_predictor.sv\"","aggregated_output":"// rtl/branch_fill_predictor.sv\n//\n// Tiny branch-target instruction cache for direct JAL/conditional branch\n// targets. Lookup is performed while the branch is in ID; EX later consumes\n// only the registered hit/instruction sideband, keeping cache compares out of\n// the redirect cycle.\nmodule branch_fill_predictor (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic        pre_valid,\n  input  logic [31:0] pre_pc,\n  input  logic [31:0] pre_target,\n  output logic        pre_hit,\n  output logic [31:0] pre_instr,\n\n  input  logic        train_valid,\n  input  logic [31:0] train_pc,\n  input  logic [31:0] train_target,\n\n  input  logic        fetch_valid,\n  input  logic [31:0] fetch_pc,\n  input  logic [31:0] fetch_instr\n);\n\n  logic [1:0]  entry_valid_q;\n  logic [31:0] entry_pc_q     [0:1];\n  logic [31:0] entry_target_q [0:1];\n  logic [31:0] entry_instr_q  [0:1];\n  logic        replace_way_q;\n\n  logic        pending_valid_q;\n  logic [31:0] pending_pc_q;\n  logic [31:0] pending_target_q;\n\n  logic hit0;\n  logic hit1;\n  logic fill_due;\n  logic fill_match0;\n  logic fill_match1;\n  logic fill_way;\n  logic fill_new_entry;\n\n  always_comb begin\n    hit0 = pre_valid && entry_valid_q[0]\n        && entry_pc_q[0] == pre_pc\n        && entry_target_q[0] == pre_target;\n    hit1 = pre_valid && entry_valid_q[1]\n        && entry_pc_q[1] == pre_pc\n        && entry_target_q[1] == pre_target;\n\n    pre_hit   = hit0 || hit1;\n    pre_instr = hit0 ? entry_instr_q[0] :\n                hit1 ? entry_instr_q[1] :\n                       32'b0;\n\n    fill_due = pending_valid_q && fetch_valid && fetch_pc == pending_target_q;\n    fill_match0 = entry_valid_q[0] && entry_pc_q[0] == pending_pc_q\n               && entry_target_q[0] == pending_target_q;\n    fill_match1 = entry_valid_q[1] && entry_pc_q[1] == pending_pc_q\n               && entry_target_q[1] == pending_target_q;\n    if (fill_match0) begin\n      fill_way = 1'b0;\n    end else if (fill_match1) begin\n      fill_way = 1'b1;\n    end else begin\n      fill_way = replace_way_q;\n    end\n    fill_new_entry = !(fill_match0 || fill_match1);\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      entry_valid_q   <= 2'b00;\n      entry_pc_q[0]   <= 32'b0;\n      entry_pc_q[1]   <= 32'b0;\n      entry_target_q[0] <= 32'b0;\n      entry_target_q[1] <= 32'b0;\n      entry_instr_q[0]  <= 32'b0;\n      entry_instr_q[1]  <= 32'b0;\n      replace_way_q   <= 1'b0;\n      pending_valid_q <= 1'b0;\n      pending_pc_q    <= 32'b0;\n      pending_target_q <= 32'b0;\n    end else begin\n      if (fill_due) begin\n        if (fill_way == 1'b0) begin\n          entry_valid_q[0]  <= 1'b1;\n          entry_pc_q[0]     <= pending_pc_q;\n          entry_target_q[0] <= pending_target_q;\n          entry_instr_q[0]  <= fetch_instr;\n        end else begin\n          entry_valid_q[1]  <= 1'b1;\n          entry_pc_q[1]     <= pending_pc_q;\n          entry_target_q[1] <= pending_target_q;\n          entry_instr_q[1]  <= fetch_instr;\n        end\n        pending_valid_q <= 1'b0;\n        if (fill_new_entry) begin\n          replace_way_q <= ~replace_way_q;\n        end\n      end\n\n      if (train_valid) begin\n        pending_valid_q <= 1'b1;\n        pending_pc_q    <= train_pc;\n        pending_target_q <= train_target;\n      end\n    end\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
