{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"sed -n '1,130p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register and a real one-entry IF/ID\n// slot. The slot captures pc+instr only when the instruction bus is ready,\n// holds through downstream stalls, and is invalidated on redirects/flushes.\n//\n// When ID consumes the slot but imem is not ready with a replacement, the\n// slot is cleared to an invalid NOP. This lets older pipeline stages keep\n// moving during fetch backpressure without retiring the same instruction\n// twice.\n//\n// Latency:        PC-reg and IF/ID update are synchronous.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC and IF/ID slot\n  input  logic              flush,            // clear IF/ID slot\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              imem_ready,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n  localparam logic [31:0] NOP      = 32'h0000_0013;\n\n  logic [31:0] pc;\n  if_id_t if_id_q;\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc      <= RESET_PC;\n      if_id_q <= '0;\n    end else if (redirect) begin\n      pc      <= redirect_target;\n      if_id_q <= '0;\n    end else if (flush) begin\n      if_id_q <= '0;\n    end else if (!stall) begin\n      if (imem_ready) begin\n        if_id_q.pc    <= pc;\n        if_id_q.instr <= imem_data;\n        if_id_q.valid <= 1'b1;\n        pc            <= pc + 32'd4;\n      end else begin\n        if_id_q.pc    <= pc;\n        if_id_q.instr <= NOP;\n        if_id_q.valid <= 1'b0;\n      end\n    end\n  end\n\n  assign imem_addr = pc;\n  assign out       = if_id_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
