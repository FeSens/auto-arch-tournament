{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/loop_predictor.sv\"","aggregated_output":"// rtl/loop_predictor.sv\n//\n// Single-entry learned loop-backedge predictor. EX trains the entry with a\n// resolved taken backward conditional branch; IF only performs a registered\n// PC compare and selects the registered target on hit.\nmodule loop_predictor (\n  input  logic        clock,\n  input  logic        reset,\n\n  input  logic [31:0] fetch_pc,\n  output logic        hit,\n  output logic [31:0] target,\n\n  input  logic        train_valid,\n  input  logic [31:0] train_branch_pc,\n  input  logic [31:0] train_target\n);\n\n  logic        valid_q;\n  logic [31:0] branch_pc_q;\n  logic [31:0] target_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      valid_q     <= 1'b0;\n      branch_pc_q <= 32'b0;\n      target_q    <= 32'b0;\n    end else if (train_valid) begin\n      valid_q     <= 1'b1;\n      branch_pc_q <= train_branch_pc;\n      target_q    <= train_target;\n    end\n  end\n\n  assign hit    = valid_q && (fetch_pc == branch_pc_q);\n  assign target = target_q;\n\nendmodule\n","exit_code":0,"status":"completed"}}
