ndcase\n+          simple_add = (funct7 == 7'b0000000 && funct3 == 3'd0);\n         end\n       end\n \n@@ -110,7 +113,10 @@ module decoder (\n           reg_write  = 1'b1;\n           alu_src    = 1'b1;\n           case (funct3)\n-            3'd0:    alu_op = ALU_ADD;\n+            3'd0: begin\n+              alu_op     = ALU_ADD;\n+              simple_add = 1'b1;\n+            end\n             \n…[4845 of 7917 chars elided by tools/bench/transcript.py; sha256:57d7071fa8269b34]…\nd_stage.sv b/cores/bench/rtl/id_stage.sv\nindex 5a1bb68..e85c34e 100644\n--- a/cores/bench/rtl/id_stage.sv\n+++ b/cores/bench/rtl/id_stage.sv\n@@ -26,6 +26,7 @@ module id_stage (\n   // ── Combinational decode ────────────────────────────────────────────────\n   logic [4:0]  dec_alu_op;\n   logic        dec_alu_src;\n+  logic        dec_simple_add;\n   logic [2:0]  dec_branch_op;\n   logic        dec_is_branch;\n   logic        dec_is_jump;\n@@ -44,6 +45,7 @@ module id_stage (\n     .instr      (in.instr),\n     .alu_op     (dec_alu_op),\n     .alu_src    (dec_alu_src),\n+    .simple_add (dec_simple_add),\n     .branch_op  (dec_branch_op),\n     .is_branch  (dec_is_branch),\n     .is_jump    (dec_is_jump),\n@@ -71,6 +73,7 @@ module id_stage (\n   always_comb begin\n     ctrl_decoded.alu_op     = dec_alu_op;\n     ctrl_decoded.alu_src    = dec_alu_src;\n+    ctrl_decoded.simple_add = dec_simple_add;\n     ctrl_decoded.branch_op  = dec_branch_op;\n     ctrl_decoded.is_branch  = dec_is_branch;\n     ctrl_decoded.is_jump    = dec_is_jump;\n", "exit_code": 0, "status": "completed"}}
