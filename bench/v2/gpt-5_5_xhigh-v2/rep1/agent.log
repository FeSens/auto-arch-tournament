{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"nl -ba cores/bench/rtl/if_stage.sv | sed -n '1,90p'\"","aggregated_output":"     1\t// rtl/if_stage.sv\n     2\t//\n     3\t// Instruction fetch stage. Holds the PC register; the IF/ID payload\n     4\t// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n     5\t// flop in this microarchitecture, the next-stage's ID/EX register\n     6\t// captures everything one cycle later.\n     7\t//\n     8\t// Fetched instruction bits stay raw. Flush/redirect/imem stalls are carried\n     9\t// by `valid`, and ID is responsible for turning invalid entries into bubbles.\n    10\t// This keeps EX redirect / imem_ready control out of the instruction-bit path\n    11\t// that feeds decode and load-use comparison.\n    12\t//\n    13\t// Latency:        PC-reg update is synchronous; output is combinational.\n    14\t// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n    15\t//                 EX-stage redirect).\n    16\tmodule if_stage (\n    17\t  input  logic              clock,\n    18\t  input  logic              reset,\n    19\t  input  logic              stall,            // hold PC (load-use)\n    20\t  input  logic              redirect,         // EX has resolved a branch/jump\n    21\t  input  logic [31:0]       redirect_target,\n    22\t  input  logic              id_predict_redirect,\n    23\t  input  logic [31:0]       id_predict_target,\n    24\t  output logic [31:0]       imem_addr,\n    25\t  input  logic [31:0]       imem_data,\n    26\t  input  logic              imem_ready,\n    27\t  output if_id_t  out\n    28\t);\n    29\t\n    30\t  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n    31\t\n    32\t  logic [31:0] pc;\n    33\t  logic [31:0] next_pc;\n    34\t\n    35\t  always_comb begin\n    36\t    next_pc = id_predict_redirect ? id_predict_target : pc + 32'd4;\n    37\t  end\n    38\t\n    39\t  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n    40\t  // redirect on the same cycle as imem_stall or dmem_stall — without\n    41\t  // this priority the redirect target would be silently dropped, the\n    42\t  // PC would hold its old (wrong-path) value, and execution would\n    43\t  // resume on the wrong path once the bus unstalls. Verified by the\n    44\t  // VexRiscv-binary CoreMark sweep with --istall enabled.\n    45\t  always_ff @(posedge clock) begin\n    46\t    if      (reset)    pc <= RESET_PC;\n    47\t    else if (redirect) pc <= redirect_target;\n    48\t    else if (!stall)   pc <= next_pc;\n    49\t  end\n    50\t\n    51\t  assign imem_addr = pc;\n    52\t\n    53\t  always_comb begin\n    54\t    out.pc    = pc;\n    55\t    out.instr = imem_data;\n    56\t    out.valid = imem_ready && !redirect;\n    57\t  end\n    58\t\n    59\tendmodule\n","exit_code":0,"status":"completed"}}
