.sv:45:    else if (redirect) pc <= redirect_target;\ncores/bench/rtl/if_stage.sv:54:    out.valid = imem_ready && !redirect;\ncores/bench/rtl/ex_stage.sv:4:// MEM/WB), runs the ALU, resolves branches, computes the redirect\ncores/bench/rtl/ex_stage.sv:25:  output logic               long_stall,    // DIV/REM in progress in EX\ncores/bench/rtl/ex_stage.sv:26:  output logic               redirect,\ncores/bench/rtl/ex_stage.sv:27:  output logic [31:0]        redirect_target\ncores/bench/rtl/ex_stage.sv:86:    long_stall  = is_mdiv_op && !mdiv_accept;\ncores/bench/rtl/ex_stage.sv:153:  // instruction, suppress the redirect (PC stays linear), and clear\ncores/bench/rtl/ex_stage.sv:173:  assign redirect        = (branch_taken || in.ctrl.is_jump) && !misalign_fault;\ncores/bench/rtl/ex_stage.sv:174:  assign redirect_target = in.ctrl.is_jump ? jump_target : branch_target;\ncores/bench/rtl/ex_stage.sv:219:      // consistent with the suppressed redirect.\ncores/bench/rtl/core.sv:20://                 redirect).\ncores/bench/rtl/core.sv:82:  logic       ex_long_stall;\ncores/bench/rtl/core.sv:85:  // EX redirect\ncores/bench/rtl/core.sv:86:  logic        redirect;\ncores/bench/rtl/core.sv:87:  logic [31:0] redirect_target;\ncores/bench/rtl/core.sv:103:    .redirect        (redirect),\ncores/bench/rtl/core.sv:104:    .redirect_target (redirect_target),\ncores/bench/rtl/core.sv:148:    .long_stall      (ex_long_stall),\ncores/bench/rtl/core.sv:149:    .redirect        (redirect),\ncores/bench/rtl/core.sv:150:    .redirect_target (redirect_target)\ncores/bench/rtl/core.sv:183:    .redirect       (redirect),\ncores/bench/rtl/core.sv:187:    .ex_long_stall  (ex_long_stall),\n","exit_code":0,"status":"completed"}}
