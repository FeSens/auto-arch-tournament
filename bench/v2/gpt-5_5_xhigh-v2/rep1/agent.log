{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/bash -c \"sed -n '260,620p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\n@cocotb.test()\nasync def taken_redirect_with_imem_stall_poison(dut):\n    \"\"\"Taken redirect plus fetch backpressure must not retire raw wrong-path bits.\"\"\"\n    poison = ADDI(10, 0, 77)\n    program = [\n        BEQ(0, 0, 8),          # PC=0; taken; skip PC=4\n        ADDI(1, 0, 99),        # PC=4; wrong-path\n        ADDI(2, 0, 42),        # PC=8; target\n        EBREAK(),\n    ]\n    ready = [1, 1, 0, 1, 1, 0, 1, 1, 1]\n    rets, _ = await _run(dut, program, imem_ready=ready, imem_poison=poison)\n    assert not _by_insn(rets, poison), f\"poisoned invalid fetch retired: {rets}\"\n    assert not _by_insn(rets, ADDI(1, 0, 99)), f\"wrong-path instruction retired: {rets}\"\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected redirect PC sequence under imem stall: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def load_use_survives_imem_stall_poison(dut):\n    \"\"\"Load-use detection should still fire only for valid IF/ID entries.\"\"\"\n    poison = ADD(2, 1, 4)\n    program = [\n        ADDI(3, 0, 0x123),\n        ADDI(4, 0, 0x100),\n        SW  (3, 0, 0),\n        LW  (1, 0, 0),\n        ADD (2, 1, 4),\n        EBREAK(),\n    ]\n    ready = [1, 1, 0, 1, 1, 0, 1, 1, 1, 1]\n    rets, dmem = await _run(dut, program, imem_ready=ready, imem_poison=poison)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wr