{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys, json\nfrom pathlib import Path\nsys.path.insert(0, str(Path('test/cosim').resolve()))\nimport run_cosim\nelf='bench/programs/coremark.elf'\nsim='cores/bench/obj_dir/cosim_sim'\nref, ref_completed, ref_reason = run_cosim.run_reference(elf, max_insns=2000000)\nprint('ref', len(ref), ref_completed, ref_reason)\nsim_trace, sim_completed, sim_rc, sim_stderr = run_cosim.run_verilator(sim, elf, maxcycles=3000000, timeout=120, sim_flags=('--istall','--dstall'))\nprint('sim', len(sim_trace), sim_completed, sim_rc, sim_stderr[-120:])\nres = run_cosim.compare(ref, sim_trace, ref_completed=False, sim_completed=sim_completed, ref_reason='bounded')\nprint(json.dumps(res, indent=2))\nif not res.get('passed'):\n    i=res.get('divergence_at')\n    if isinstance(i,int):\n        print('around ref')\n        for r in ref[max(0,i-3):i+3]: print(r)\n        print('around sim')\n        for r in sim_trace[max(0,i-3):i+3]: print(r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
