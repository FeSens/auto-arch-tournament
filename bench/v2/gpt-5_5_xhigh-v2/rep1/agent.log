{"type": "item.completed", "item": {"id": "item_84", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_direct_redirect_fold.py && sed -n '1,120p' cores/bench/implementation_notes.md\"", "aggregated_output": "\"\"\"Directed checks for registered direct redirect folding.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADDI, BEQ, EBREAK, JAL, JALR, _by_insn, _run\n\n\ndef _cycles(retirements, insn):\n    return [r[\"cycle\"] for r in _by_insn(retirements, insn)]\n\n\ndef _assert_no_double_retire(retirements):\n    orders = [r[\"order\"] for r in retirements]\n    assert orders == list(range(orders[0], orders[0] + len(orders)))\n\n\n@cocotb.test()\nasync def taken_branch_folds_target_slot(dut):\n    target = ADDI(2, 0, 42)\n    wrong = ADDI(1, 0, 99)\n    program = [BEQ(0, 0, 8), wrong, target, EBREAK()]\n    rets, _ = await _run(dut, program)\n\n    [branch_cycle] = _cycles(rets, BEQ(0, 0, 8))\n    [target_cycle] = _cycles(rets, target)\n    assert target_cycle == branch_cycle + 1\n    assert not _by_insn(rets, wrong)\n    assert [r[\"pc\"] for r in rets] == [0, 8, 12]\n    _assert_no_double_retire(rets)\n\n\n@cocotb.test()\nasync def jal_folds_and_advances_pc_to_target_plus_4(dut):\n    target = ADDI(3, 0, 42)\n    wrong = ADDI(2, 0, 99)\n    program = [JAL(1, 8), wrong, target, EBREAK()]\n    rets, _ = await _run(dut, program)\n\n    [jal] = _by_insn(rets, JAL(1, 8))\n    [target_ret] = _by_insn(rets, target)\n    assert target_ret[\"cycle\"] == jal[\"cycle\"] + 1\n    assert target_ret[\"pc\"] == 8\n    assert target_ret[\"pc_next\"] == 12\n    assert not _by_insn(rets, wrong)\n    _assert_no_double_retire(rets)\n\n\n@cocotb.test()\nasync def jalr_uses_conservative_redirect_path(dut):\n    target = ADDI(7, 0, 42)\n    wrong = ADDI(6, 0, 99)\n    program = [\n        ADDI(5, 0, 12),\n        JALR(1, 5, 0),\n        wrong,\n        target,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n\n    [jalr] = _by_insn(rets, JALR(1, 5, 0))\n    [target_ret] = _by_insn(rets, target)\n    assert target_ret[\"cycle\"] >= jalr[\"cycle\"] + 2\n    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 16]\n    assert not _by_insn(rets, wrong)\n    _assert_no_double_retire(rets)\n\n\n@cocotb.test()\nasync def imem_not_ready_blocks_branch_fold(dut\n…[1628 of 4700 chars elided by tools/bench/transcript.py; sha256:7cb402a8c10d49be]…\n stalls exposed a stale folded instruction\n  after a dmem hold released. The fix is to drive the direct target address\n  whenever a direct redirect is eligible, even if the fold cannot be accepted\n  until the hold clears. Acceptance remains gated by dmem/imem readiness.\n- Added directed cocotb tests in `test_direct_redirect_fold.py` for folded\n  branches/JALs, JALR fallback, imem-not-ready fallback, target+4 PC advance,\n  and no double retirement.\n\nVerification status:\n\n- `verilator --lint-only -Wall -Wno-MULTITOP -sv +incdir+cores/bench/rtl cores/bench/rtl/*.sv`: pass\n- `pytest -q cores/bench/test`: pass (7 passed)\n- `RTL_DIR=cores/bench/rtl CORE_NAME=bench bash formal/run_all.sh`: pass (53 passed, 0 failed)\n- `NRET=1 make cosim TARGET=bench`: pass\n\nNote: plain `make cosim TARGET=bench` in this checkout invoked the cosim build\nwith its default `NRET=2` and failed to compile against this `nret: 1` core's\nsingle RVFI channel. Supplying `NRET=1` matches `cores/bench/core.yaml` and the\nformal wrapper selection.\n", "exit_code": 0, "status": "completed"}}
