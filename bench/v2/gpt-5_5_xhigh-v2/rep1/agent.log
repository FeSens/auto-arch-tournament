ext = depth_after_pop;\n\n    if (push) begin\n      top_next   = push_addr;\n      next_next  = (depth_after_pop == 2'd0) ? 32'b0 : top_after_pop;\n      depth_next = (depth_after_pop == 2'd0) ? 2'd1 : 2'd2;\n    end\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      top_q   <= 32'b0;\n      next_q  <= 32'b0;\n      depth_q <= 2'd0;\n    end \n…[6337 of 9409 chars elided by tools/bench/transcript.py; sha256:b9903f728f8c249b]…\n rets] == [0, 4, 16, 20, 8, 12]\n    _assert_pc_chain(rets)\n    [ret] = _by_pc(rets, 20)\n    [target] = _by_pc(rets, 8)\n    assert target[\"cycle\"] > ret[\"cycle\"] + 1\n\n\n@cocotb.test()\nasync def misaligned_return_jalr_traps_without_redirect(dut):\n    program = [\n        ADDI(1, 0, 6),\n        JALR(0, 1, 0),\n        ADDI(2, 0, 1),\n        EBREAK(),\n    ]\n    rets = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12]\n    _assert_pc_chain(rets)\n    [ret] = _by_pc(rets, 4)\n    assert ret[\"trap\"] == 1\n    assert ret[\"pc_next\"] == 8\n\n\ndef test_return_fold_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"mdiv_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"return_fold_predictor.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_return_fold\",\n    )\n", "exit_code": 0, "status": "completed"}}
