\n // Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n //\n // Latency:        combinational.\ndiff --git a/cores/bench/test/test_pipeline.py b/cores/bench/test/test_pipeline.py\nindex 5674d06..c1b76c8 100644\n--- a/cores/bench/test/test_pipeline.py\n+++ b/cores/bench/test/test_pipeline.py\n@@ -75,6 +75,7 @@\n…[3865 of 6937 chars elided by tools/bench/transcript.py; sha256:841d04a692b14c9a]…\n2[\"cycle\"] > r1[\"cycle\"], f\"dependent retired before load data was available: {rets}\"\n+\n+\n+@cocotb.test()\n+async def load_followed_by_false_source_does_not_take_load_address(dut):\n+    \"\"\"ADDI's imm[4:0] may alias a load rd, but the instruction must ignore it.\"\"\"\n+    # imm=0x021 gives instruction bits [24:20] == 1. The old EX/MEM load\n+    # bypass advertisement could select the load's address for rs2 here, but\n+    # ADDI must use the immediate operand and retire x2 = 0x30 + 0x21.\n+    program = [\n+        ADDI(3, 0, 0x30),\n+        LW  (1, 0, 0),\n+        ADDI(2, 3, 0x021),\n+        EBREAK(),\n+    ]\n+    rets, _ = await _run(dut, program, dmem_init={0: 0x00000ABC})\n+    [r1] = _by_insn(rets, LW(1, 0, 0))\n+    [r2] = _by_insn(rets, ADDI(2, 3, 0x021))\n+    assert r1[\"rd_wdata\"] == 0xABC\n+    assert r2[\"rs1_rdata\"] == 0x30\n+    assert r2[\"rd_wdata\"] == 0x51\n+\n+\n @cocotb.test()\n async def imem_stall_poison_fetch_bubbles(dut):\n     \"\"\"Invalid fetch cycles must not retire or decode poisoned instruction bits.\"\"\"\n", "exit_code": 0, "status": "completed"}}
