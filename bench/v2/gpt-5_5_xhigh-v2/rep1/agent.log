{"type": "item.completed", "item": {"id": "item_57", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,240p' cores/bench/test/test_mulh_unit.py\"", "aggregated_output": "\"\"\"Focused cocotb tests for rtl/mulh_unit.sv.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import (\n    ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\ndef _u32(value):\n    return value & MASK32\n\n\ndef _s32(value):\n    value &= MASK32\n    return value - (1 << 32) if value & 0x80000000 else value\n\n\ndef _mulh(a, b):\n    return (_s32(a) * _s32(b) >> 32) & MASK32\n\n\ndef _mulhu(a, b):\n    return (_u32(a) * _u32(b) >> 32) & MASK32\n\n\ndef _mulhsu(a, b):\n    return (_s32(a) * _u32(b) >> 32) & MASK32\n\n\nasync def _setup(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.op.value = ALU_MULH\n    dut.a.value = 0\n    dut.b.value = 0\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n\n\nasync def _check(dut, op, a, b, expected, max_cycles=40):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.start.value = 1\n    await RisingEdge(dut.clock)\n    await Timer(1, \"ns\")\n    dut.start.value = 0\n\n    for _ in range(max_cycles):\n        if int(dut.done.value):\n            actual = int(dut.result.value) & MASK32\n            assert actual == (expected & MASK32), (\n                f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n                f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n            )\n            assert int(dut.busy.value) == 0\n            await RisingEdge(dut.clock)\n            await Timer(1, \"ns\")\n            assert int(dut.done.value) == 0\n            return\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n    raise AssertionError(\n        f\"mulh_unit did not finish op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x}\"\n    )\n\n\n@cocotb.test()\nasync def mulh_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULH, 0x80000000, 2, 0xFFFFFFFF)\n    await _check(dut, ALU_MULH, 0x80000000, 0x80000000, 0x40000000)\n    await _check(dut, ALU_MULH, 0x7FFFFFFF, 0xFFFFFFFF, _mulh(0x7FFFFFFF, 0xFFFFFFFF))\n    await _check(dut, ALU_MULH, 1, 1, 0)\n\n\n@cocotb.test()\nasync def mulhu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 2, 1)\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE)\n    await _check(dut, ALU_MULHU, 0x12345678, 0x9ABCDEF0, _mulhu(0x12345678, 0x9ABCDEF0))\n\n\n@cocotb.test()\nasync def mulhsu_mixed_signedness(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULHSU, 0x80000000, 0xFFFFFFFF, 0x80000000)\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF)\n    await _check(dut, ALU_MULHSU, 0xFEDCBA98, 0x76543210, _mulhsu(0xFEDCBA98, 0x76543210))\n\n\n@cocotb.test()\nasync def high_half_corner_vectors(dut):\n    await _setup(dut)\n    vectors = [\n        (0x00000000, 0xFFFFFFFF),\n        (0x00000001, 0xFFFFFFFF),\n        (0xFFFFFFFF, 0x00000002),\n        (0x80000000, 0x00000002),\n        (0x80000000, 0xFFFFFFFF),\n        (0x7FFFFFFF, 0xFFFFFFFF),\n        (0x80000000, 0x80000000),\n        (0xFFFFFFFF, 0xFFFFFFFF),\n        (0x12345678, 0x9ABCDEF0),\n        (0xFEDCBA98, 0x76543210),\n    ]\n    for a, b in vectors:\n        await _check(dut, ALU_MULH, a, b, _mulh(a, b))\n        await _check(dut, ALU_MULHU, a, b, _mulhu(a, b))\n        await _check(dut, ALU_MULHSU, a, b, _mulhsu(a, b))\n\n\n@cocotb.test()\nasync def back_to_back_operations(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MULH, 0x80000000, 2, _mulh(0x80000000, 2))\n    await _check(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, _mulhu(0xFFFFFFFF, 0xFFFFFFFF))\n    await _check(dut, ALU_MULHSU, 0xFFFFFFFF, 0x80000000, _mulhsu(0xFFFFFFFF, 0x80000000))\n\n\ndef test_mulh_unit_runner():\n    run_cocotb(toplevel=\"mulh_unit\",\n               sources=[\"core_pkg.sv\", \"mulh_unit.sv\"],\n               test_module=\"test_mulh_unit\")\n", "exit_code": 0, "status": "completed"}}
