{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c \"sed -n '1,220p' cores/bench/rtl/mulh_unit.sv\"","aggregated_output":"// rtl/mulh_unit.sv\n//\n// Iterative RV32M high-half multiplier for MULH/MULHU/MULHSU. Low-half MUL\n// remains in the combinational ALU; this unit is started only by ex_stage for\n// the high-half variants and uses the same long-stall protocol as mdiv_unit.\n//\n// Latency:        RISCV_FORMAL_ALTOPS completes one cycle after start; real\n//                 arithmetic completes after 32 shift-add steps.\n// RVFI fields:    feeds rd_wdata for MULH* through the EX/MEM register.\nmodule mulh_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        done,\n  output logic [31:0] result\n);\n\n  function automatic logic [31:0] neg32(input logic [31:0] value);\n    neg32 = ~value + 32'd1;\n  endfunction\n\n`ifdef RISCV_FORMAL_ALTOPS\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      busy   <= 1'b0;\n      done   <= 1'b0;\n      result <= 32'b0;\n    end else begin\n      busy <= 1'b0;\n      done <= 1'b0;\n      if (start) begin\n        case (op)\n          ALU_MULH:   result <= (a + b) ^ 32'hf6583fb7;\n          ALU_MULHU:  result <= (a + b) ^ 32'h949ce5e8;\n          ALU_MULHSU: result <= (a - b) ^ 32'hecfbe137;\n          default:    result <= 32'b0;\n        endcase\n        done <= 1'b1;\n      end\n    end\n  end\n`else\n  logic [63:0] accum_q;\n  logic [63:0] multiplicand_q;\n  logic [31:0] multiplier_q;\n  logic [5:0]  count_q;\n  logic        negate_q;\n\n  logic        a_signed;\n  logic        b_signed;\n  logic [31:0] abs_a;\n  logic [31:0] abs_b;\n  logic        product_neg;\n  logic [63:0] addend;\n  logic [63:0] accum_next;\n  logic [63:0] product_mag;\n  logic [31:0] product_high;\n\n  always_comb begin\n    a_signed    = (op == ALU_MULH) || (op == ALU_MULHSU);\n    b_signed    = (op == ALU_MULH);\n    abs_a       = (a_signed && a[31]) ? neg32(a) : a;\n    abs_b       = (b_signed && b[31]) ? neg32(b) : b;\n    product_neg = (a_signed && a[31]) ^ (b_signed && b[31]);\n\n    addend         = multiplier_q[0] ? multiplicand_q : 64'b0;\n    accum_next     = accum_q + addend;\n    product_mag    = accum_next;\n    product_high   = negate_q\n                   ? (~product_mag[63:32] + {31'b0, product_mag[31:0] == 32'b0})\n                   : product_mag[63:32];\n  end\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      busy           <= 1'b0;\n      done           <= 1'b0;\n      result         <= 32'b0;\n      accum_q        <= 64'b0;\n      multiplicand_q <= 64'b0;\n      multiplier_q   <= 32'b0;\n      count_q        <= 6'b0;\n      negate_q       <= 1'b0;\n    end else begin\n      done <= 1'b0;\n\n      if (start && !busy) begin\n        busy           <= 1'b1;\n        accum_q        <= 64'b0;\n        multiplicand_q <= {32'b0, abs_a};\n        multiplier_q   <= abs_b;\n        count_q        <= 6'b0;\n        negate_q       <= product_neg;\n      end else if (busy) begin\n        accum_q        <= accum_next;\n        multiplicand_q <= {multiplicand_q[62:0], 1'b0};\n        multiplier_q   <= {1'b0, multiplier_q[31:1]};\n\n        if (count_q == 6'd31) begin\n          busy   <= 1'b0;\n          done   <= 1'b1;\n          result <= product_high;\n        end else begin\n          count_q <= count_q + 6'd1;\n        end\n      end\n    end\n  end\n`endif\n\nendmodule\n","exit_code":0,"status":"completed"}}
