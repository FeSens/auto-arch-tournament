{"type": "item.completed", "item": {"id": "item_53", "type": "command_execution", "command": "/bin/bash -c \"nl -ba cores/bench/rtl/id_stage.sv | sed -n '1,115p'\"", "aggregated_output": "     1\t// rtl/id_stage.sv\n     2\t//\n     3\t// Decode stage. Combinationally drives the regfile read ports and the\n     4\t// ID/EX register's next-state from the IF/ID combinational bundle plus\n     5\t// the regfile read data. The ID/EX register is owned by this module so\n     6\t// the decoded view of instruction n is latched by end of cycle n+1.\n     7\t//\n     8\t// Latency:        1 cycle (ID/EX register clocked here).\n     9\t// RVFI fields:    feeds rs1_addr, rs1_rdata, rs2_addr, rs2_rdata, insn,\n    10\t//                 trap (via ctrl.is_illegal).\n    11\tmodule id_stage (\n    12\t  input  logic              clock,\n    13\t  input  logic              reset,\n    14\t  input  logic              stall,\n    15\t  input  logic              flush,\n    16\t  input  if_id_t  in,\n    17\t  // regfile read interface\n    18\t  output logic [4:0]        rs1_addr,\n    19\t  output logic [4:0]        rs2_addr,\n    20\t  input  logic [31:0]       rs1_data,\n    21\t  input  logic [31:0]       rs2_data,\n    22\t  // Static decode-stage prediction for legal backward conditional branches.\n    23\t  output logic              predict_redirect,\n    24\t  output logic [31:0]       predict_target,\n    25\t  // ID/EX register output\n    26\t  output id_ex_t  out\n    27\t);\n    28\t\n    29\t  // ── Combinational decode ────────────────────────────────────────────────\n    30\t  logic [4:0]  dec_alu_op;\n    31\t  logic        dec_alu_src;\n    32\t  logic [2:0]  dec_branch_op;\n    33\t  logic        dec_is_branch;\n    34\t  logic        dec_is_jump;\n    35\t  logic        dec_is_jalr;\n    36\t  logic        dec_is_lui;\n    37\t  logic        dec_is_auipc;\n    38\t  logic        dec_mem_read;\n    39\t  logic        dec_mem_write;\n    40\t  logic [1:0]  dec_mem