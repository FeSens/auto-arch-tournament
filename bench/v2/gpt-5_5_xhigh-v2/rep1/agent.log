     (reset)    pc <= RESET_PC;\n    else if (redirect) pc <= redirect_target;\n    else if (!stall)   pc <= next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.instr = imem_data;\n    out.valid = imem_ready && !redirect;\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
