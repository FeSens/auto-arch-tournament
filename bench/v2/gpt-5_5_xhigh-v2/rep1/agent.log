{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/00_core_pkg_first.sv\"","aggregated_output":"// rtl/00_core_pkg_first.sv\n//\n// Wildcard-only lint shim. Some commands pass rtl/*.sv directly, which sorts\n// core.sv before core_pkg.sv and exposes typedefs before declaration. This\n// guarded copy gives those commands an alphabetically first declaration file;\n// ordered builds still pass core_pkg.sv first and this file becomes a no-op.\n`ifndef CORE_PKG_DEFINED\n`define CORE_PKG_DEFINED\n\n  localparam logic [4:0] ALU_ADD    = 5'd0;\n  localparam logic [4:0] ALU_SUB    = 5'd1;\n  localparam logic [4:0] ALU_AND    = 5'd2;\n  localparam logic [4:0] ALU_OR     = 5'd3;\n  localparam logic [4:0] ALU_XOR    = 5'd4;\n  localparam logic [4:0] ALU_SLT    = 5'd5;\n  localparam logic [4:0] ALU_SLTU   = 5'd6;\n  localparam logic [4:0] ALU_SLL    = 5'd7;\n  localparam logic [4:0] ALU_SRL    = 5'd8;\n  localparam logic [4:0] ALU_SRA    = 5'd9;\n  localparam logic [4:0] ALU_LUI    = 5'd10;\n  localparam logic [4:0] ALU_MUL    = 5'd11;\n  localparam logic [4:0] ALU_MULH   = 5'd12;\n  localparam logic [4:0] ALU_MULHU  = 5'd13;\n  localparam logic [4:0] ALU_MULHSU = 5'd14;\n  localparam logic [4:0] ALU_DIV    = 5'd15;\n  localparam logic [4:0] ALU_DIVU   = 5'd16;\n  localparam logic [4:0] ALU_REM    = 5'd17;\n  localparam logic [4:0] ALU_REMU   = 5'd18;\n\n  localparam logic [2:0] BR_BEQ  = 3'd0;\n  /* verilator lint_off UNUSEDPARAM */\n  localparam logic [2:0] BR_BNE  = 3'd1;\n  localparam logic [2:0] BR_BLT  = 3'd4;\n  localparam logic [2:0] BR_BGE  = 3'd5;\n  localparam logic [2:0] BR_BLTU = 3'd6;\n  localparam logic [2:0] BR_BGEU = 3'd7;\n  /* verilator lint_on UNUSEDPARAM */\n\n  typedef struct packed {\n    logic [4:0] alu_op;\n    logic       alu_src;\n    logic [2:0] branch_op;\n    logic       is_branch;\n    logic       is_jump;\n    logic       is_jalr;\n    logic       is_lui;\n    logic       is_auipc;\n    logic       mem_read;\n    logic       mem_write;\n    logic [1:0] mem_width;\n    logic       mem_sext;\n    logic       reg_write;\n    logic       mem_to_reg;\n    logic       is_illegal;\n  } ctrl_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic        valid;\n  } if_id_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] imm;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } id_ex_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] write_data;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic        branch_taken;\n    logic [31:0] branch_target;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] read_data;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;\n    logic [31:0] mem_rdata;\n    logic [31:0] mem_wdata;\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n","exit_code":0,"status":"completed"}}
