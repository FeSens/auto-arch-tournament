      is_auipc;\n    logic       mem_read;\n    logic       mem_write;\n    logic [1:0] mem_width;\n    logic       mem_sext;\n    logic       reg_write;\n    logic       mem_to_reg;\n    logic       is_illegal;\n  } ctrl_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] instr;\n    logic        valid;\n  } if_id_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] imm;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } id_ex_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] write_data;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic        branch_taken;\n    logic [31:0] branch_target;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } ex_mem_t;\n\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] alu_result;\n    logic [31:0] read_data;\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;\n    logic [31:0] mem_rdata;\n    logic [31:0] mem_wdata;\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n","exit_code":0,"status":"completed"}}
