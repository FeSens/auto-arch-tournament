{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/id_stage.sv cores/bench/test/test_direct_jal_predictor.py'", "aggregated_output": "diff --git a/cores/bench/rtl/id_stage.sv b/cores/bench/rtl/id_stage.sv\nindex d04686e..1cb9fbb 100644\n--- a/cores/bench/rtl/id_stage.sv\n+++ b/cores/bench/rtl/id_stage.sv\n@@ -66,12 +66,18 @@ module id_stage (\n   logic [31:0] imm;\n   imm_gen u_imm (.instr(in.instr), .imm(imm));\n \n+  logic [31:0] jal_imm;\n   logic [31:0] jal_target;\n-  assign jal_target = in.pc + imm;\n+  logic        jal_opcode;\n+  logic        id_accept;\n+\n+  assign jal_imm = {{11{in.instr[31]}}, in.instr[31], in.instr[19:12],\n+                    in.instr[20], in.instr[30:21], 1'b0};\n+  assign jal_target = in.pc + jal_imm;\n+  assign jal_opcode = (in.instr[6:0] == 7'b1101111);\n+  assign id_accept  = in.valid && !hold && !bubble;\n   assign decode_jal_redirect =\n-      in.valid && !hold && !bubble &&\n-      dec_is_jump && !dec_is_jalr && !dec_is_illegal &&\n-      (jal_target[1:0] == 2'b00);\n+      id_accept && jal_opcode && (jal_target[1:0] == 2'b00);\n   assign decode_jal_redirect_target = jal_target;\n \n   // Regfile read addresses come straight from the IF/ID instruction — these\ndiff --git a/cores/bench/test/test_direct_jal_predictor.py b/cores/bench/test/test_direct_jal_predictor.py\nindex 5c23472..1b80046 100644\n--- a/cores/bench/test/test_direct_jal_predictor.py\n+++ b/cores/bench/test/test_direct_jal_predictor.py\n@@ -24,6 +24,7 @@ def _j(imm, rd, opcode):\n \n def ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\n def JAL(rd, imm):       return _j(imm, rd, 0b1101111)\n+def JALR(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\n def EBREAK():           return 0x00100073\n \n \n@@ -92,6 +93,27 @@ async def direct_jal_redirects_from_decode(dut):\n     assert pcs == [0, 8, 12], f\"wrong-path PC retired after direct JAL: {pcs}\"\n \n \n+@cocotb.test()\n+async def direct_jal_redirects_forward_and_backward_with_link(dut):\n+    program = [\n+        JAL(1, 12),\n+        EBREAK(),\n+        ADDI(2, 0, 99),\n+        JAL(5, -8),\n+    ]\n+    fetch_addrs, retirements = await _run_trace(dut, program)\n+\n+    assert fetch_addrs[:2] == [12, 4], (\n+        f\"forward then backward aligned JALs should redirect in decode, \"\n+        f\"got fetch trace {fetch_addrs[:5]}\"\n+    )\n+    pcs = [r[\"pc\"] for r in retirements]\n+    assert pcs == [0, 12, 4], f\"unexpected retirement PCs for JAL pair: {pcs}\"\n+    first, second = retirements[0], retirements[1]\n+    assert first[\"rd\"] == 1 and first[\"rd_wdata\"] == 4, f\"bad forward link: {first}\"\n+    assert second[\"rd\"] == 5 and second[\"rd_wdata\"] == 16, f\"bad backward link: {second}\"\n+\n+\n @cocotb.test()\n async def aligned_direct_jal_has_no_ex_duplicate_redirect(dut):\n     program = [\n@@ -128,6 +150,44 @@ async def misaligned_direct_jal_traps_in_ex(dut):\n     assert jal[\"rd\"] == 0 and jal[\"rd_wdata\"] == 0\n \n \n+@cocotb.test()\n+async def illegal_non_jal_opcode_does_not_redirect(dut):\n+    bad_non_jal = (JAL(1, 8) & ~0x7F) | 0b1101011\n+    program = [\n+        bad_non_jal,\n+        EBREAK(),\n+        ADDI(3, 0, 42),\n+    ]\n+    fetch_addrs, retirements = await _run_trace(dut, program)\n+\n+    assert fetch_addrs[0] == 4, (\n+        f\"reserved non-JAL opcode must fetch sequentially, got {fetch_addrs[:4]}\"\n+    )\n+    bad = retirements[0]\n+    assert bad[\"pc\"] == 0 and bad[\"trap\"] == 1, f\"reserved opcode should trap: {bad}\"\n+    assert [r[\"pc\"] for r in retirements] == [0, 4]\n+\n+\n+@cocotb.test()\n+async def jalr_still_waits_for_ex_redirect(dut):\n+    program = [\n+        ADDI(5, 0, 12),\n+        JALR(1, 5, 0),\n+        ADDI(6, 0, 99),\n+        ADDI(7, 0, 42),\n+        EBREAK(),\n+    ]\n+    fetch_addrs, retirements = await _run_trace(dut, program)\n+\n+    assert fetch_addrs[1] == 8, (\n+  