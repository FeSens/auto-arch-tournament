{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"sed -n '1,180p' cores/bench/rtl/if_stage.sv\"","aggregated_output":"// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is marked invalid.\n// The instruction payload itself stays as the memory data so redirect/imem\n// bubble signals do not sit on the wide IF/ID-to-ID/EX payload mux path.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // hold PC (load-use)\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // EX has resolved a branch/jump\n  input  logic [31:0]       redirect_target,\n  input  logic              pred_update_valid,\n  input  logic [31:0]       pred_update_pc,\n  input  logic [31:0]       pred_update_target,\n  input  logic              pred_invalidate_valid,\n  input  logic [31:0]       pred_invalidate_pc,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] next_pc;\n  logic        pred_entry_valid;\n  logic [31:0] pred_entry_pc;\n  logic [31:0] pred_entry_target;\n  logic        pred_hit;\n\n  always_comb begin\n    pred_hit = pred_entry_valid && (pred_entry_pc == pc);\n    next_pc  = redirect ? redirect_target\n             : pred_hit ? pred_entry_target\n                        : (pc + 32'd4);\n  end\n\n  // Redirect must override stall: a BRANCH/JAL/JALR in EX may fire\n  // redirect on the same cycle as imem_stall or dmem_stall — without\n  // this priority the redirect target would be silently dropped, the\n  // PC would hold its old (wrong-path) value, and execution would\n  // resume on the wrong path once the bus unstalls. Verified by the\n  // VexRiscv-binary CoreMark sweep with --istall enabled.\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc                <= RESET_PC;\n      pred_entry_valid  <= 1'b0;\n      pred_entry_pc     <= 32'b0;\n      pred_entry_target <= 32'b0;\n    end else begin\n      if (pred_update_valid) begin\n        pred_entry_valid  <= 1'b1;\n        pred_entry_pc     <= pred_update_pc;\n        pred_entry_target <= pred_update_target;\n      end else if (pred_invalidate_valid &&\n                   pred_entry_valid &&\n                   (pred_entry_pc == pred_invalidate_pc)) begin\n        pred_entry_valid <= 1'b0;\n      end\n\n      if      (redirect) pc <= redirect_target;\n      else if (!stall)   pc <= next_pc;\n    end\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc         = pc;\n    out.instr      = imem_data;\n    out.pred_pc    = pred_entry_target;\n    out.pred_valid = pred_hit && !(flush || redirect);\n    out.valid      = !(flush || redirect);\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
