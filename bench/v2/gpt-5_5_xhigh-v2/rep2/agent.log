{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('formal/riscv-formal/cores/bench-woxsWcHdU/checks/pc_fwd_ch0/engine_0/trace.vcd')\nselect = {\n 'n45':'cyc','n46':'rst','n67':'rvv','n57':'ord','n58':'rv_pc','n59':'rv_npc','n48':'rv_insn','n60':'rv_rd','n61':'rv_wdata','n66':'trap',\n 'n96':'bub_exa','n97':'bub_id','n99':'ex_busy','n104':'flush_if','n107':'hold_id','n109':'id_m','n143':'redir','n144':'redir_t','n151':'stall_exmem','n152':'stall_if','n117':'imemAddr','n118':'imemData','n119':'imemReady','n114':'dmemReady',\n 'n110':'id_ex','n165':'exa','n188':'exmem','n324':'memwb','n150':'rvfi_q'\n}\nvals={}\ncurtime=None\nrecords=[]\nheader=True\nfor line in p.read_text().splitlines():\n    if line.startswith('\"'$enddefinitions'\"'):\n        header=False\n        continue\n    if header: continue\n    if line.startswith('#'):\n        if curtime is not None:\n            records.append((curtime, vals.copy()))\n        curtime=int(line[1:])\n    elif line.startswith('b'):\n        bits, code=line[1:].split()\n        if code in select:\n            vals[code]=bits\n    elif line and line[0] in '01xz':\n        val=line[0]; code=line[1:]\n        if code in select:\n            vals[code]=val\nif curtime is not None: records.append((curtime, vals.copy()))\n\ndef bv(v):\n    if v is None: return None\n    if any(c in v for c in 'xz'): return None\n    return int(v,2)\n\ndef hx(v,w=8):\n    if v is None: return 'x'\n    if any(c in v for c in 'xz'): return 'x'+v\n    return f'{int(v,2):0{w}x}'\n\ndef fields(bits, spec):\n    if bits is None or any(c in bits for c in 'xz') or len(bits)\"'!=sum(w for _,w in spec): return None\n    pos=0; d={}\n    for name,w in spec:\n        d[name]=int(bits[pos:pos+w],2); pos+=w\n    return d\nctrl=[('\"'alu_op',5),('alu_src',1),('branch_op',3),('is_branch',1),('is_jump',1),('is_jalr',1),('is_lui',1),('is_auipc',1),('mem_read',1),('mem_write',1),('mem_width',2),('mem_sext',1),('reg_write',1),('mem_to_reg',1),('is_illegal',1)]\nid_spec=[('pc',32),('rs1',32),('rs2',32),('imm',32),('rd',5),('ra1',5),('ra2',5)]+[(f'c_{n}',w) for n,w in ctrl]+[('insn',32),('valid',1)]\nex_spec=[('pc',32),('alu',32),('wdata',32),('rd',5),('ra1',5),('ra2',5),('rs1',32),('rs2',32),('pc_next',32),('bt',1),('btgt',32)]+[(f'c_{n}',w) for n,w in ctrl]+[('insn',32),('valid',1)]\nwb_spec=[('pc',32),('alu',32),('read',32),('rd',5),('ra1',5),('ra2',5),('rs1',32),('rs2',32),('pc_next',32),('mem_addr',32),('mem_rdata',32),('mem_wdata',32),('wmask',4),('rmask',4)]+[(f'c_{n}',w) for n,w in ctrl]+[('insn',32),('valid',1)]\n# print records at integer smt time changes maybe all #\nlast_smt=None\nfor t,r in records:\n    cyc=bv(r.get('n45'))\n    # VCD contains many deltas; print when cycle changes or rv valid/redir\n    if cyc is None: continue\n    rv=bv(r.get('n67'))\n    red=bv(r.get('n143'))\n    # print all times with new cyc? one line after values settled\n    if cyc\"'!=last_smt:\n        last_smt=cyc\n        idf=fields(r.get('\"'n110'),id_spec); exa=fields(r.get('n165'),id_spec); exm=fields(r.get('n188'),ex_spec); wb=fields(r.get('n324'),wb_spec)\n        print('\\\\ncyc',cyc,'t',t,'rst',bv(r.get('n46')),'rvv',rv,'ord',bv(r.get('n57')),'trap',bv(r.get('n66')))\n        print('  rv pc',hx(r.get('n58')),'npc',hx(r.get('n59')),'insn',hx(r.get('n48')),'rd',bv(r.get('n60')),'wd',hx(r.get('n61')))\n        print('  ctl stall_if',bv(r.get('n152')),'hold_id',bv(r.get('n107')),'bub_id',bv(r.get('n97')),'bub_exa',bv(r.get('n96')),'redir',red,'rt',hx(r.get('n144')))\n        print('  if pc',hx(r.get('n117')),'idata',hx(r.get('n118')))\n        for nm,d in [('ID',idf),('EXA',exa),('EXM',exm),('WB',wb)]:\n            if not d: print(' ',nm,'x'); continue\n            print(f\\\"  {nm} v{d['valid']} pc {d['pc']:08x} insn {d['insn']:08x} rd {d.get('rd',0)} pc_next {d.get('pc_next',0):08x} alu {d.get('alu',0):08x} ctrl_rw {d.get('c_reg_write',0)} mr {d.get('c_mem_read',0)} mw {d.get('c_mem_write',0)} br {d.get('c_is_branch',0)} j {d.get('c_is_jump',0)} ill {d.get('c_is_illegal',0)}\\\")\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
