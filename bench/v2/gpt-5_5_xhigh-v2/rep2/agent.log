{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"sed -n '85,190p' cores/bench/rtl/core.sv\"","aggregated_output":"\n  // EX redirect\n  logic        redirect;\n  logic [31:0] redirect_target;\n\n  // Decode-stage redirect: direct JAL or a last-taken branch hit.\n  logic        decode_redirect;\n  logic [31:0] decode_redirect_target;\n\n  // Single-entry last-taken conditional branch predictor.\n  logic        bp_valid_q;\n  logic [31:0] bp_pc_q;\n  logic [31:0] bp_instr_q;\n  logic [31:0] bp_target_q;\n  logic        bp_train_valid;\n  logic [31:0] bp_train_pc;\n  logic [31:0] bp_train_instr;\n  logic [31:0] bp_train_target;\n\n  // regfile interface (driven by ID + WB stages)\n  logic [4:0]  rs1_addr_w;\n  logic [4:0]  rs2_addr_w;\n  logic [31:0] rs1_data_w;\n  logic [31:0] rs2_data_w;\n  logic        wb_w_en;\n  logic [4:0]  wb_w_addr;\n  logic [31:0] wb_w_data;\n\n  // ── IF ────────────────────────────────────────────────────────────────\n  if_stage u_if (\n    .clock           (clock),\n    .reset           (reset),\n    .imem_ready      (io_imemReady),\n    .decode_pop      (if_pop),\n    .redirect        (redirect),\n    .redirect_target (redirect_target),\n    .decode_redirect        (decode_redirect),\n    .decode_redirect_target (decode_redirect_target),\n    .imem_addr       (io_imemAddr),\n    .imem_data       (io_imemData),\n    .out             (if_id_w)\n  );\n\n  // ── ID + regfile ──────────────────────────────────────────────────────\n  id_stage u_id (\n    .clock    (clock),\n    .reset    (reset),\n    .hold     (hold_id),\n    .bubble   (bubble_id),\n    .in       (if_id_w),\n    .rs1_addr (rs1_addr_w),\n    .rs2_addr (rs2_addr_w),\n    .rs1_data (rs1_data_w),\n    .rs2_data (rs2_data_w),\n    .decode_redirect        (decode_redirect),\n    .decode_redirect_target (decode_redirect_target),\n    .bp_valid (bp_valid_q),\n    .bp_pc    (bp_pc_q),\n    .bp_instr (bp_instr_q),\n    .bp_target(bp_target_q),\n    .out      (id_ex_w)\n  );\n\n  reg_file u_rf (\n    .clock    (clock),\n    .reset    (reset),\n    .rs1_addr (rs1_addr_w),\n    .rs2_addr (rs2_addr_w),\n    .rs1_data (rs1_data_w),\n    .rs2_data (rs2_data_w),\n    .w_en     (wb_w_en),\n    .w_addr   (wb_w_addr),\n    .w_data   (wb_w_data)\n  );\n\n  // ── EX ────────────────────────────────────────────────────────────────\n  ex_stage u_ex (\n    .clock           (clock),\n    .reset           (reset),\n    .stall           (stall_ex_mem),\n    .in              (id_ex_w),\n    .fwd_rs1_sel     (fwd_rs1_sel),\n    .fwd_rs2_sel     (fwd_rs2_sel),\n    .fwd_ex_mem      (ex_mem_w.alu_result),  // EX/MEM-registered ALU result\n    .fwd_mem_wb      (wb_w_data),            // WB-stage's write-mux output\n    .out             (ex_mem_w),\n    .busy            (ex_busy),\n    .redirect        (redirect),\n    .redirect_target (redirect_target),\n    .bp_train_valid  (bp_train_valid),\n    .bp_train_pc     (bp_train_pc),\n    .bp_train_instr  (bp_train_instr),\n    .bp_train_target (bp_train_target)\n  );\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      bp_valid_q  <= 1'b0;\n      bp_pc_q     <= 32'b0;\n      bp_instr_q  <= 32'b0;\n      bp_target_q <= 32'b0;\n    end else if (bp_train_valid) begin\n      bp_valid_q  <= 1'b1;\n      bp_pc_q     <= bp_train_pc;\n      bp_instr_q  <= bp_train_instr;\n      bp_target_q <= bp_train_target;\n","exit_code":0,"status":"completed"}}
