{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_direct_jal_predictor.py\"", "aggregated_output": "\"\"\"Focused tests for the metadata-free direct-JAL decode redirect.\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    b20 = (imm >> 20) & 1\n    b101 = (imm >> 1) & 0x3FF\n    b11 = (imm >> 11) & 1\n    b1912 = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef JAL(rd, imm):       return _j(imm, rd, 0b1101111)\ndef EBREAK():           return 0x00100073\n\n\nasync def _run_trace(dut, program, max_cycles=40):\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    fetch_addrs = []\n    retirements = []\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")\n\n        ia = int(dut.io_imemAddr.value)\n        fetch_addrs.append(ia)\n\n        if int(dut.io_rvfi_valid_0.value):\n            retired = {\n                \"cycle\": cycle,\n                \"insn\": int(dut.io_rvfi_insn_0.value),\n                \"pc\": int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\": int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\": int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\": int(dut.io_rvfi_rd_wdata_0.value),\n                \"trap\": int(dut.io_rvfi_trap_0.value),\n            }\n            retirements.append(retired)\n            if retired[\"insn\"] \n…[1296 of 4368 chars elided by tools/bench/transcript.py; sha256:2ff14d5a0d192f86]…\nate-redirect bubble: {target}\"\n\n\n@cocotb.test()\nasync def misaligned_direct_jal_traps_in_ex(dut):\n    program = [\n        JAL(1, 2),\n        ADDI(2, 0, 7),\n        EBREAK(),\n    ]\n    fetch_addrs, retirements = await _run_trace(dut, program)\n\n    assert fetch_addrs[0] == 4, (\n        f\"misaligned JAL must not use the decode redirect, got fetch trace {fetch_addrs[:4]}\"\n    )\n    jal = retirements[0]\n    assert jal[\"pc\"] == 0 and jal[\"trap\"] == 1, f\"misaligned JAL should trap in EX: {jal}\"\n    assert jal[\"pc_next\"] == 4\n    assert jal[\"rd\"] == 0 and jal[\"rd_wdata\"] == 0\n\n\ndef test_direct_jal_predictor_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"muldiv_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_direct_jal_predictor\",\n    )\n", "exit_code": 0, "status": "completed"}}
