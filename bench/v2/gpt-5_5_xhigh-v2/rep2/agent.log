queue (storebuf_enqueue),\n+    .storebuf_addr    (storebuf_addr),\n+    .storebuf_wdata   (storebuf_wdata),\n+    .storebuf_wmask   (storebuf_wmask),\n+    .mem_block        (mem_stage_block),\n+    .out              (mem_wb_w)\n+  );\n+\n+  store_buffer u_store_buffer (\n+    .clock         (clock),\n+    .reset         (reset),\n+    .enqueue       (storebuf_enqueue),\n+    .enqueue_addr \n…[8180 of 11252 chars elided by tools/bench/transcript.py; sha256:0a87eed95ca00636]…\n;\n+    dmem_ren   = stage_load_req;\n+\n+    storebuf_enqueue = bufferable_store && !dmem_ready && !storebuf_busy;\n+    storebuf_addr    = {mem_addr[31:2], 2'b00};\n+    storebuf_wdata   = wdata_rep;\n+    storebuf_wmask   = byte_mask;\n \n     // Load extraction: shift right then sign/zero-extend the low N bits.\n     shifted   = dmem_rdata >> (mem_addr[1:0] * 8);\n@@ -146,8 +177,8 @@ module mem_stage (\n       reg_q.mem_addr   <= aligned_addr;\n       reg_q.mem_rdata  <= dmem_rdata;\n       reg_q.mem_wdata  <= wdata_rep;\n-      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n-      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n+      reg_q.mem_wmask  <= stage_store_req ? byte_mask : 4'b0000;\n+      reg_q.mem_rmask  <= stage_load_req  ? byte_mask : 4'b0000;\n       reg_q.ctrl       <= ctrl_with_trap;\n       reg_q.instr      <= in.instr;\n       reg_q.valid      <= in.valid;\ndiff --git a/cores/bench/test/test_pipeline.py b/cores/bench/test/test_pipeline.py\n", "exit_code": 0, "status": "completed"}}
