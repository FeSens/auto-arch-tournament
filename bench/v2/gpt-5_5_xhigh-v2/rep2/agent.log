{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/bash -c 'git diff -- cores/bench/rtl/reg_file.sv cores/bench/test/test_reg_file.py cores/bench/test/test_regfile_timing.py'", "aggregated_output": "diff --git a/cores/bench/rtl/reg_file.sv b/cores/bench/rtl/reg_file.sv\nindex 9dd38a4..be55510 100644\n--- a/cores/bench/rtl/reg_file.sv\n+++ b/cores/bench/rtl/reg_file.sv\n@@ -3,17 +3,17 @@\n // 32 x 32 RV32I integer register file.\n //   - x0 hardwired to zero (writes silently dropped, reads always 0).\n //   - Two combinational read ports.\n-//   - Single synchronous write port.\n-//   - Write-first bypass: a same-cycle write to the read address returns\n-//     the new value. This matches the prior Chisel core's RegFile.scala\n-//     and lets the ID stage see WB-stage writes within the same cycle\n-//     without an extra forwarding mux.\n+//   - Single write port committed on the falling clock edge.\n+//   - Write-first architectural timing is provided by the local two-phase\n+//     schedule: MEM/WB appears after a rising edge, writes on the following\n+//     falling edge, and decode captures the already-updated array on the\n+//     next rising edge.\n //\n // The reset clears all 32 registers. Distributed-LUT or flop inference is\n // fine here; explicit BRAM attribution lives on the larger imem/dmem\n // declarations in soc.sv (phase 5).\n //\n-// Latency:        write = 1 cycle (synchronous), read = combinational.\n+// Latency:        write = half cycle (negedge), read = combinational.\n // RVFI fields:    feeds rs1_rdata, rs2_rdata, rd_wdata.\n module reg_file (\n   input  logic        clock,\n@@ -31,7 +31,7 @@ module reg_file (\n \n   logic [31:0] regs [0:31];\n \n-  always_ff @(posedge clock) begin\n+  always_ff @(negedge clock) begin\n     if (reset) begin\n       for (int i = 0; i < 32; i++) regs[i] <= 32'b0;\n     end else if (w_en && w_addr != 5'b0) begin\n@@ -40,19 +40,8 @@ module reg_file (\n   end\n \n   always_comb begin\n-    if (rs1_addr == 5'b0)\n-      rs1_data = 32'b0;\n-    else if (w_en && w_addr == rs1_addr)\n-      rs1_data = w_data;\n-    else\n-      rs1_data = regs[rs1_addr];\n-\n-    if (rs2_addr == 5'b0)\n-      rs2_data = 32'b0;\n-    else if (w_en && w_addr == rs2_addr)\n-      rs2_data = w_data;\n-    else\n-      rs2_data = regs[rs2_addr];\n+    rs1_data = (rs1_addr == 5'b0) ? 32'b0 : regs[rs1_addr];\n+    rs2_data = (rs2_addr == 5'b0) ? 32'b0 : regs[rs2_addr];\n   end\n \n endmodule\ndiff --git a/cores/bench/test/test_reg_file.py b/cores/bench/test/test_reg_file.py\nindex 0cf54bf..e075b09 100644\n--- a/cores/bench/test/test_reg_file.py\n+++ b/cores/bench/test/test_reg_file.py\n@@ -1,10 +1,10 @@\n-\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, write-first\n-bypass, and the synchronous-reset-clears-all property.\"\"\"\n+\"\"\"Unit tests for rtl/reg_file.sv. Covers x0 hardwiring, falling-edge\n+write timing, and the synchronous-reset-clears-all property.\"\"\"\n from __future__ import annotations\n \n import cocotb\n from cocotb.clock import Clock\n-from cocotb.triggers import RisingEdge, Timer\n+from cocotb.triggers import FallingEdge, RisingEdge, Timer\n \n from _helpers import run_cocotb\n \n@@ -26,7 +26,7 @@ async def _write(dut, addr, data):\n     dut.w_en.value   = 1\n     dut.w_addr.value = addr\n     dut.w_data.value = data\n-    await RisingEdge(dut.clock)\n+    await FallingEdge(dut.clock)\n     dut.w_en.value = 0\n \n \n@@ -67,16 +67,19 @@ async def x0_hardwired(dut):\n \n \n @cocotb.test()\n-async def write_first_bypass(dut):\n+async def write_commits_on_falling_edge(dut):\n     cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n     await _reset(dut)\n-    # Combinational read of an addr that is being written this cycle:\n-    # bypass returns the new write data.\n+    # The read ports are pure array reads: the write data is not visible\n+    # combinationally before the falling-edge write phase.\n     dut.rs1_addr.value = 7\n     dut.w_en.value     = 1\n     dut.w_addr.value   = 7\n     dut.w_data.value   = 0x12345678\n     await Timer(1, \"ns\")\n+    assert int(dut.rs1_data.value) == 0\n+    await FallingEdge(dut.clock)\n+    await Timer(1, \"ns\")\n     assert int(dut.rs1_data.value) == 0x12345678\n     dut.w_en.value = 0\n \n", "exit_code": 0, "status": "completed"}}
