{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -c \"sed -n '1,140p' cores/bench/rtl/alu.sv\"","aggregated_output":"// rtl/alu.sv\n//\n// RV32I combinational ALU. Real RV32M arithmetic is intentionally kept out\n// of this cone and handled by muldiv_unit.sv so ADD/branch/address timing\n// does not cross the multiplier/divider. Under RISCV_FORMAL_ALTOPS only, the\n// M opcodes still return riscv-formal's lightweight substitute operations.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata (via EX/MEM/WB), branch resolution, mem_addr.\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_ADD:    out = a + b;\n      ALU_SUB:    out = a - b;\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      // M-extension stand-ins for riscv-formal fast mode. Real hardware\n      // builds route M ops through muldiv_unit instead.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n","exit_code":0,"status":"completed"}}
