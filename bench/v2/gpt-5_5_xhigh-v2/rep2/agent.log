 logic        push_is_branch;\n  logic        push_is_jal;\n  logic        push_pred_valid;\n\n  assign fifo_valid   = (count_q != 2'd0);\n  assign bypass_valid = (count_q == 2'd0) && imem_ready && !redirect;\n  assign out_valid    = !redirect && (fifo_valid || bypass_valid);\n  assign \n…[3652 of 6724 chars elided by tools/bench/transcript.py; sha256:1fdc619feb04b956]…\nta;\n            pred1_q       <= push_pred_valid;\n            pred_next1_q  <= push_pred_next_pc;\n            count_q       <= 2'd2;\n          end\n        end\n\n        default: begin\n          if (do_pop && do_push) begin\n            pc0_q         <= pc1_q;\n            instr0_q      <= instr1_q;\n            pred0_q       <= pred1_q;\n            pred_next0_q  <= pred_next1_q;\n            pc1_q         <= fetch_pc_q;\n            instr1_q      <= imem_data;\n            pred1_q       <= push_pred_valid;\n            pred_next1_q  <= push_pred_next_pc;\n            count_q       <= 2'd2;\n          end else if (do_pop) begin\n            pc0_q         <= pc1_q;\n            instr0_q      <= instr1_q;\n            pred0_q       <= pred1_q;\n            pred_next0_q  <= pred_next1_q;\n            pc1_q         <= 32'b0;\n            instr1_q      <= 32'b0;\n            pred1_q       <= 1'b0;\n            pred_next1_q  <= 32'b0;\n            count_q       <= 2'd1;\n          end\n        end\n      endcase\n    end\n  end\n\nendmodule\n", "exit_code": 0, "status": "completed"}}
