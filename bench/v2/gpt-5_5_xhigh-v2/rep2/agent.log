{"type": "item.completed", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,120p' cores/bench/rtl/alu.sv && sed -n '1,90p' cores/bench/test/test_alu.py\"", "aggregated_output": "// rtl/alu.sv\n//\n// RV32I combinational ALU for the non-add operations. ADD/SUB/AUIPC results\n// are selected in ex_stage.sv through dedicated carry-chain paths so ordinary\n// integer writes avoid this wider shift/compare/logic mux. Real RV32M\n// arithmetic is intentionally kept out of this cone and handled by\n// muldiv_unit.sv; under RISCV_FORMAL_ALTOPS only, the M opcodes still return\n// riscv-formal's lightweight substitute operations.\n//\n// Latency:        combinational (0 cycles).\n// RVFI fields:    feeds rd_wdata for non-add ALU ops (via EX/MEM/WB).\nmodule alu (\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic [31:0] out\n);\n\n  logic        [4:0]  shamt;\n\n  always_comb begin\n    shamt = b[4:0];\n\n    case (op)\n      ALU_AND:    out = a & b;\n      ALU_OR:     out = a | b;\n      ALU_XOR:    out = a ^ b;\n      ALU_SLT:    out = {31'b0, $signed(a) < $signed(b)};\n      ALU_SLTU:   out = {31'b0, a < b};\n      ALU_SLL:    out = a << shamt;\n      ALU_SRL:    out = a >> shamt;\n      ALU_SRA:    out = $unsigned($signed(a) >>> shamt);\n      ALU_LUI:    out = b;\n\n      // M-extension stand-ins for riscv-formal fast mode. Real hardware\n      // builds route M ops through muldiv_unit instead.\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL:    out = (a + b) ^ 32'h5876063e;\n      ALU_MULH:   out = (a + b) ^ 32'hf6583fb7;\n      ALU_MULHU:  out = (a + b) ^ 32'h949ce5e8;\n      ALU_MULHSU: out = (a - b) ^ 32'hecfbe137;\n      ALU_DIV:    out = (a - b) ^ 32'h7f8529ec;\n      ALU_DIVU:   out = (a - b) ^ 32'h10e8fd70;\n      ALU_REM:    out = (a - b) ^ 32'h8da68fa5;\n      ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n\"\"\"Unit tests for rtl/alu.sv.\n\nThe generic ALU is purely combinational and intentionally contains only the\nnon-add RV32I operations in hardware builds. ADD/SUB/AUIPC are selected from\ndedicated EX-stage adders, while RV32M arithmetic is covered by test_muldiv.py\nagainst rtl/muldiv_unit.sv.\n\"\"\"\nfrom __future__ import annotation\n…[1193 of 4265 chars elided by tools/bench/transcript.py; sha256:2dc474b624005be5]…\n await _check(dut, ALU_SLT, 0x7FFFFFFF, 0x80000000, 0)     # MAX > MIN\n\n\n@cocotb.test()\nasync def sltu_unsigned(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n    await _check(dut, ALU_SLTU, 0, 1, 1)\n\n\n@cocotb.test()\nasync def sll(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLL, 1, 4, 16)\n    await _check(dut, ALU_SLL, 1, 31, 0x80000000)\n    await _check(dut, ALU_SLL, 1, 0x20, 1)                    # shamt = b[4:0] = 0\n\n\n@cocotb.test()\nasync def srl(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRL, 0x80000000, 1, 0x40000000)\n    await _check(dut, ALU_SRL, 0x80000000, 31, 1)\n    await _check(dut, ALU_SRL, 0xFFFFFFFF, 0x25, 0x07FFFFFF)   # shamt masked\n\n\n@cocotb.test()\nasync def sra(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRA, 0x80000000, 1, 0xC0000000)\n    await _check(dut, ALU_SRA, 0x80000000, 31, 0xFFFFFFFF)\n    await _check(dut, ALU_SRA, 0x7FFFFFFF, 1, 0x3FFFFFFF)\n\n\n@cocotb.test()\nasync def lui(dut):\n    await _setup(dut)\n", "exit_code": 0, "status": "completed"}}
