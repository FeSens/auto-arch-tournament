{"type": "assistant", "message": {"model": "claude-sonnet-5-5", "id": "msg_011CfbEsCbRAMtwSi99xseu3", "type": "message", "role": "assistant", "content": [{"type": "tool_use", "id": "toolu_01FEw9mUvCke3Kq1aaPtR4Gy", "name": "Write", "input": {"file_path": "/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-002-r1s1/cores/bench/test/test_muldiv.py", "content": "\"\"\"Unit tests for rtl/muldiv.sv (multi-cycle RV32M unit).\n\nProtocol under test (what ex_stage drives):\n  - While IDLE the unit samples op/a/b every cycle; it leaves IDLE on the\n    first cycle `start` is high. `start` may stay high while busy.\n  - `done` goes high in the DONE state with `result` valid; the unit returns\n    to IDLE the cycle after DONE unless `hold` is asserted.\n  - a_lat / b_lat are the operands latched at the start cycle and stay valid\n    through DONE, even after the a/b inputs change.\n\nEvery M op is checked bit-exactly against a Python model of RV32M for\n>= 30 vectors (random + corner cases: x/0, INT_MIN/-1, signed corners).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, FallingEdge\n\nfrom _helpers import (\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32  = 0xFFFFFFFF\nINT_MIN = 0x80000000\nINT_MAX = 0x7FFFFFFF\n\n# Cycles from the start cycle S to the first DONE cycle (start at S => done\n# is observed high S+MUL_LAT cycles later). Bounded, not exact, so a faster\n# implementation does not fail the test.\nMUL_MAX_LAT = 6\nDIV_MAX_LAT = 40\n\n\ndef _s(x: int) -> int:\n    x &= MASK32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef ref(op: int, a: int, b: int) -> int:\n    \"\"\"RV32M reference model.\"\"\"\n    a &= MASK32\n    b &= MASK32\n    if op == ALU_MUL:\n        return (a * b) & MASK32\n    if op == ALU_MULH:\n        return ((_s(a) * _s(b)) >> 32) & MASK32\n    if op == ALU_MULHU:\n        return ((a * b) >> 32) & MASK32\n    if op == ALU_MULHSU:\n        return ((_s(a) * b) >> 32) & MASK32\n    if op == ALU_DIV:\n        if b == 0:\n            return MASK32\n        if a == INT_MIN and b == MASK32:\n            return INT_MIN\n        q = abs(_s(a)) // abs(_s(b))\n        return (-q if (_s(a) < 0) != (_s(b) < 0) else q) & MASK32\n    if op == ALU_DIVU:\n        return MASK32 if b == 0 else (a // b) & MASK32\n    if op == ALU_REM:\n        if b == 0:\n            return a\n        if a == INT_MIN and b == MASK32:\n            return 0\n        r = abs(_s(a)) % abs(_s(b))\n        return (-r if _s(a) < 0 else r) & MASK32\n    if op == ALU_REMU:\n        return a if b == 0 else (a % b) & MASK32\n    raise ValueError(op)\n\n\nOP_NAME = {\n    ALU_MUL: \"mul\", ALU_MULH: \"mulh\", ALU_MULHU: \"mulhu\",\n    ALU_MULHSU: \"mulhsu\", ALU_DIV: \"div\", ALU_DIVU: \"divu\",\n    ALU_REM: \"rem\", ALU_REMU: \"remu\",\n}\n\nCORNERS = [\n    0, 1, 2, 3, 7, 0xFF, 0x10000, 0xFFFF, 0x7FFF,\n    INT_MAX, INT_MIN, INT_MIN + 1, MASK32, MASK32 - 1,\n    0x80008000, 0xDEADBEEF, 0x12345678, 0xCAFEBABE, 0x55555555, 0xAAAAAAAA,\n]\n\n\ndef vectors(op: int, n_random: int = 30, seed: int = 0xC0DE) -> list[tuple[int, int]]:\n    rng = random.Random(seed ^ (op * 7919))\n    vecs: list[tuple[int, int]] = []\n    # Directed corner cases.\n    vecs += [(a, 0) for a in (0, 1, 123, INT_MIN, MASK32, 0xDEADBEEF)]   # x/0\n    vecs += [(INT_MIN, MASK32), (INT_MIN, 1), (INT_MAX, MASK32),\n             (MASK32, MASK32), (MASK32, 1), (1, MASK32), (0, MASK32),\n             (INT_MIN, INT_MIN), (INT_MAX, INT_MIN), (INT_MIN, INT_MAX),\n             (7, 0xFFFFFFFE), (0xFFFFFFFC, 2), (0xFFFFFFF6, 3), (10, 0xFFFFFFFD),\n             (10, 3), (100, 7), (0xFFFFFFFF, 2), (3, 4)]\n    # Cross product of corner values (covers sign/zero-extension paths).\n    for a in CORNERS:\n        for b in CORNERS[::3]:\n            vecs.append((a, b))\n    # Random operands, including small divisors and mixed magnitudes.\n    for _ in range(n_random):\n        a = rng.getrandbits(32)\n        b = rng.getrandbits(rng.choice((4, 8, 16, 24, 32)))\n        if rng.random() < 0.5:\n            b = (-b) & MASK32\n        vecs.append((a, b))\n    return vecs\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.hold.value  = 0\n    dut.op.value    = 0\n    dut.a.value     = 0\n    dut.b.value     = 0\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await FallingEdge(dut.clock)\n\n\nasync def run_op(dut, op, a, b, max_lat, hold_cycles=0, scramble=True):\n    \"\"\"Issue one op the way ex_stage does and return (result, latency).\n\n    Drive inputs mid-cycle (falling edge), assert `start` for the S cycle and\n    keep it high (as EX does) until done, then wait for the unit to go idle.\n    After S the a/b inputs are scrambled: only the latched copies may count.\n    \"\"\"\n    dut.op.value    = op\n    dut.a.value     = a & MASK32\n    dut.b.value     = b & MASK32\n    dut.start.value = 1\n    dut.hold.value  = 0\n    await RisingEdge(dut.clock)      # S edge: operands latched\n    await FallingEdge(dut.clock)\n    lat = 1\n    while int(dut.done.value) == 0:\n        if scramble:\n            dut.a.value = random.getrandbits(32)\n            dut.b.value = random.getrandbits(32)\n        assert lat <= max_lat, (\n            f\"{OP_NAME[op]} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x}: \"\n            f\"no done after {lat} cycles (bound {max_lat})\")\n        await RisingEdge(dut.clock)\n        await FallingEdge(dut.clock)\n        lat += 1\n    # DONE cycle: result and latched operands must be valid.\n    res = int(dut.result.value)\n    assert int(dut.a_lat.value) == (a & MASK32), \"a_lat lost the operand\"\n    assert int(dut.b_lat.value) == (b & MASK32), \"b_lat lost the operand\"\n    # dmem-stall style hold: result must stay put and done stay high.\n    dut.hold.value = 1\n    for _ in range(hold_cycles):\n        await RisingEdge(dut.clock)\n        await FallingEdge(dut.clock)\n        assert int(dut.done.value) == 1, \"done dropped while held\"\n        assert int(dut.result.value) == res, \"result changed while held\"\n        assert int(dut.a_lat.value) == (a & MASK32)\n        assert int(dut.b_lat.value) == (b & MASK32)\n    # Consumer takes the result at the end of this cycle.\n    dut.hold.value  = 0\n    dut.start.value = 0\n    await RisingEdge(dut.clock)\n    await FallingEdge(dut.clock)\n    assert int(dut.done.value) == 0, \"unit did not return to IDLE after DONE\"\n    return res, lat\n\n\nasync def check_op(dut, op, vecs, max_lat, **kw):\n    for a, b in vecs:\n        exp = ref(op, a, b)\n        got, _ = await run_op(dut, op, a, b, max_lat, **kw)\n        assert got == exp, (\n            f\"{OP_NAME[op]} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x}: \"\n            f\"expected 0x{exp:08x} got 0x{got:08x}\")\n\n\nasync def _start(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n\n\ndef _mk_test(op: int, max_lat: int):\n    async def body(dut):\n        await _start(dut)\n        vecs = vectors(op)\n        assert len(vecs) >= 30\n        await check_op(dut, op, vecs, max_lat)\n    body.__name__ = OP_NAME[op]\n    return cocotb.test()(body)\n\n\nmul    = _mk_test(ALU_MUL,    MUL_MAX_LAT)\nmulh   = _mk_test(ALU_MULH,   MUL_MAX_LAT)\nmulhu  = _mk_test(ALU_MULHU,  MUL_MAX_LAT)\nmulhsu = _mk_test(ALU_MULHSU, MUL_MAX_LAT)\ndiv    = _mk_test(ALU_DIV,    DIV_MAX_LAT)\ndivu   = _mk_test(ALU_DIVU,   DIV_MAX_LAT)\nrem    = _mk_test(ALU_REM,    DIV_MAX_LAT)\nremu   = _mk_test(ALU_REMU,   DIV_MAX_LAT)\n\n\n@cocotb.test()\nasync def explicit_corner_cases(dut):\n    \"\"\"Hand-written spec vectors, independent of the Python model.\"\"\"\n    await _start(dut)\n    cases = [\n        (ALU_MUL,    0xFFFFFFFF, 0xFFFFFFFF, 1),\n        (ALU_MULH,   INT_MIN,    2,          0xFFFFFFFF),\n        (ALU_MULH,   INT_MIN,    INT_MIN,    0x40000000),\n        (ALU_MULHU,  0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE),\n        (ALU_MULHSU, INT_MIN,    0xFFFFFFFF, 0x80000000),\n        (ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF),\n        (ALU_DIV,    123,        0,          0xFFFFFFFF),\n        (ALU_DIV,    INT_MIN,    0xFFFFFFFF, INT_MIN),\n        (ALU_DIV,    7,          0xFFFFFFFE, 0xFFFFFFFD),\n        (ALU_DIVU,   42,         0,          0xFFFFFFFF),\n        (ALU_DIVU,   0xFFFFFFFF, 2,          0x7FFFFFFF),\n        (ALU_REM,    0xDEADBEEF, 0,          0xDEADBEEF),\n        (ALU_REM,    INT_MIN,    0xFFFFFFFF, 0),\n        (ALU_REM,    0xFFFFFFF6, 3,          0xFFFFFFFF),\n        (ALU_REM,    10,         0xFFFFFFFD, 1),\n        (ALU_REMU,   0xCAFEBABE, 0,          0xCAFEBABE),\n        (ALU_REMU,   7,          3,          1),\n    ]\n    for op, a, b, exp in cases:\n        lat = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n        got, _ = await run_op(dut, op, a, b, lat)\n        assert got == exp, (f\"{OP_NAME[op]} 0x{a:08x},0x{b:08x}: \"\n                            f\"expected 0x{exp:08x} got 0x{got:08x}\")\n\n\n@cocotb.test()\nasync def back_to_back_mixed(dut):\n    \"\"\"Consecutive ops of different kinds: no state carry-over.\"\"\"\n    await _start(dut)\n    rng = random.Random(1234)\n    ops = [ALU_MUL, ALU_DIVU, ALU_MULH, ALU_REM, ALU_MULHSU, ALU_DIV,\n           ALU_MULHU, ALU_REMU]\n    for i in range(80):\n        op = ops[i % len(ops)] if i < 40 else rng.choice(ops)\n        a = rng.getrandbits(32)\n        b = rng.getrandbits(32) if rng.random() < 0.8 else rng.choice(CORNERS)\n        lat = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n        got, _ = await run_op(dut, op, a, b, lat)\n        assert got == ref(op, a, b), (\n            f\"{OP_NAME[op]} a=0x{a:08x} b=0x{b:08x}: \"\n            f\"expected 0x{ref(op, a, b):08x} got 0x{got:08x}\")\n\n\n@cocotb.test()\nasync def hold_keeps_result(dut):\n    \"\"\"A held DONE (dmem stall coinciding with DONE) keeps the result.\"\"\"\n    await _start(dut)\n    rng = random.Random(99)\n    for op in (ALU_MUL, ALU_MULHU, ALU_DIV, ALU_REMU):\n        for _ in range(4):\n            a, b = rng.getrandbits(32), rng.getrandbits(32)\n            lat = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n            got, _ = await run_op(dut, op, a, b, lat, hold_cycles=5)\n            assert got == ref(op, a, b)\n\n\n@cocotb.test()\nasync def idle_sampling_and_late_start(dut):\n    \"\"\"Operands are sampled every IDLE cycle; the unit only commits on the\n    first cycle `start` is high (EX stalled by dmem before that).\"\"\"\n    await _start(dut)\n    for _ in range(4):\n        dut.op.value    = ALU_MUL\n        dut.a.value     = random.getrandbits(32)\n        dut.b.value     = random.getrandbits(32)\n        dut.start.value = 0\n        await RisingEdge(dut.clock)\n        await FallingEdge(dut.clock)\n        assert int(dut.done.value) == 0, \"unit left IDLE without start\"\n    got, _ = await run_op(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, MUL_MAX_LAT)\n    assert got == 0xFFFFFFFE\n\n\n@cocotb.test()\nasync def latency_is_bounded(dut):\n    \"\"\"Report and bound the latency of each op class.\"\"\"\n    await _start(dut)\n    for op in OP_NAME:\n        _, lat = await run_op(dut, op, 0x12345678, 0x00000357, 64)\n        bound = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n        dut._log.info(f\"{OP_NAME[op]}: done {lat} cycles after start\")\n        assert lat <= bound\n\n\ndef test_muldiv_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"muldiv\",\n               sources=[\"core_pkg.sv\", \"muldiv.sv\"],\n               test_module=\"test_muldiv\")\n"}, "caller": {"type": "direct"}}], "container": null, "stop_reason": null, "stop_sequence": null, "stop_details": null, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 235, "cache_read_input_tokens": 129557, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 235}, "output_tokens": 32, "service_tier": "standard", "inference_geo": "not_available"}, "input_transformations": [], "diagnostics": null, "context_management": null}, "parent_tool_use_id": null, "session_id": "21120814-0eb2-43dc-b8ac-434b292b2c39", "uuid": "1e24b500-bc79-4333-8963-6d1e60651fdf", "timestamp": "2026-10-01T08:58:00.010Z", "request_id": "req_011CfbEsC8dcisDdDVQmpRb9"}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01FEw9mUvCke3Kq1aaPtR4Gy", "type": "tool_result", "content": "File created successfully at: /srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-002-r1s1/cores/bench/test/test_muldiv.py (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "21120814-0eb2-43dc-b8ac-434b292b2c39", "uuid": "2ce15515-9940-4b58-80c8-a7f7ee98e19d", "timestamp": "2026-10-01T08:58:00.020Z", "tool_use_result": {"type": "create", "filePath": "/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-002-r1s1/cores/bench/test/test_muldiv.py", "content": "\"\"\"Unit tests for rtl/muldiv.sv (multi-cycle RV32M unit).\n\nProtocol under test (what ex_stage drives):\n  - While IDLE the unit samples op/a/b every cycle; it leaves IDLE on the\n    first cycle `start` is high. `start` may stay high while busy.\n  - `done` goes high in the DONE state with `result` valid; the unit returns\n    to IDLE the cycle after DONE unless `hold` is asserted.\n  - a_lat / b_lat are the operands latched at the start cycle and stay valid\n    through DONE, even after the a/b inputs change.\n\nEvery M op is checked bit-exactly against a Python model of RV32M for\n>= 30 vectors (random + corner cases: x/0, INT_MIN/-1, signed corners).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, FallingEdge\n\nfrom _helpers import (\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32  = 0xFFFFFFFF\nINT_MIN = 0x80000000\nINT_MAX = 0x7FFFFFFF\n\n# Cycles from the start cycle S to the first DONE cycle (start at S => done\n# is observed high S+MUL_LAT cycles later). Bounded, not exact, so a faster\n# implementation does not fail the test.\nMUL_MAX_LAT = 6\nDIV_MAX_LAT = 40\n\n\ndef _s(x: int) -> int:\n    x &= MASK32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef ref(op: int, a: int, b: int) -> int:\n    \"\"\"RV32M reference model.\"\"\"\n    a &= MASK32\n    b &= MASK32\n    if op == ALU_MUL:\n        return (a * b) & MASK32\n    if op == ALU_MULH:\n        return ((_s(a) * _s(b)) >> 32) & MASK32\n    if op == ALU_MULHU:\n        return ((a * b) >> 32) & MASK32\n    if op == ALU_MULHSU:\n        return ((_s(a) * b) >> 32) & MASK32\n    if op == ALU_DIV:\n        if b == 0:\n            return MASK32\n        if a == INT_MIN and b == MASK32:\n            return INT_MIN\n        q = abs(_s(a)) // abs(_s(b))\n        return (-q if (_s(a) < 0) != (_s(b) < 0) else q) & MASK32\n    if op == ALU_DIVU:\n        return MASK32 if b == 0 else (a // b) & MASK32\n    if op == ALU_REM:\n        if b == 0:\n            return a\n        if a == INT_MIN and b == MASK32:\n            return 0\n        r = abs(_s(a)) % abs(_s(b))\n        return (-r if _s(a) < 0 else r) & MASK32\n    if op == ALU_REMU:\n        return a if b == 0 else (a % b) & MASK32\n    raise ValueError(op)\n\n\nOP_NAME = {\n    ALU_MUL: \"mul\", ALU_MULH: \"mulh\", ALU_MULHU: \"mulhu\",\n    ALU_MULHSU: \"mulhsu\", ALU_DIV: \"div\", ALU_DIVU: \"divu\",\n    ALU_REM: \"rem\", ALU_REMU: \"remu\",\n}\n\nCORNERS = [\n    0, 1, 2, 3, 7, 0xFF, 0x10000, 0xFFFF, 0x7FFF,\n    INT_MAX, INT_MIN, INT_MIN + 1, MASK32, MASK32 - 1,\n    0x80008000, 0xDEADBEEF, 0x12345678, 0xCAFEBABE, 0x55555555, 0xAAAAAAAA,\n]\n\n\ndef vectors(op: int, n_random: int = 30, seed: int = 0xC0DE) -> list[tuple[int, int]]:\n    rng = random.Random(seed ^ (op * 7919))\n    vecs: list[tuple[int, int]] = []\n    # Directed corner cases.\n    vecs += [(a, 0) for a in (0, 1, 123, INT_MIN, MASK32, 0xDEADBEEF)]   # x/0\n    vecs += [(INT_MIN, MASK32), (INT_MIN, 1), (INT_MAX, MASK32),\n             (MASK32, MASK32), (MASK32, 1), (1, MASK32), (0, MASK32),\n             (INT_MIN, INT_MIN), (INT_MAX, INT_MIN), (INT_MIN, INT_MAX),\n             (7, 0xFFFFFFFE), (0xFFFFFFFC, 2), (0xFFFFFFF6, 3), (10, 0xFFFFFFFD),\n             (10, 3), (100, 7), (0xFFFFFFFF, 2), (3, 4)]\n    # Cross product of corner values (covers sign/zero-extension paths).\n    for a in CORNERS:\n        for b in CORNERS[::3]:\n            vecs.append((a, b))\n    # Random operands, including small divisors and mixed magnitudes.\n    for _ in range(n_random):\n        a = rng.getrandbits(32)\n        b = rng.getrandbits(rng.choice((4, 8, 16, 24, 32)))\n        if rng.random() < 0.5:\n            b = (-b) & MASK32\n        vecs.append((a, b))\n    return vecs\n\n\nasync def _reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.hold.value  = 0\n    dut.op.value    = 0\n    dut.a.value     = 0\n    dut.b.value     = 0\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n    dut.reset.value = 0\n    await FallingEdge(dut.clock)\n\n\nasync def run_op(dut, op, a, b, max_lat, hold_cycles=0, scramble=True):\n    \"\"\"Issue one op the way ex_stage does and return (result, latency).\n\n    Drive inputs mid-cycle (falling edge), assert `start` for the S cycle and\n    keep it high (as EX does) until done, then wait for the unit to go idle.\n    After S the a/b inputs are scrambled: only the latched copies may count.\n    \"\"\"\n    dut.op.value    = op\n    dut.a.value     = a & MASK32\n    dut.b.value     = b & MASK32\n    dut.start.value = 1\n    dut.hold.value  = 0\n    await RisingEdge(dut.clock)      # S edge: operands latched\n    await FallingEdge(dut.clock)\n    lat = 1\n    while int(dut.done.value) == 0:\n        if scramble:\n            dut.a.value = random.getrandbits(32)\n            dut.b.value = random.getrandbits(32)\n        assert lat <= max_lat, (\n            f\"{OP_NAME[op]} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x}: \"\n            f\"no done after {lat} cycles (bound {max_lat})\")\n        await RisingEdge(dut.clock)\n        await FallingEdge(dut.clock)\n        lat += 1\n    # DONE cycle: result and latched operands must be valid.\n    res = int(dut.result.value)\n    assert int(dut.a_lat.value) == (a & MASK32), \"a_lat lost the operand\"\n    assert int(dut.b_lat.value) == (b & MASK32), \"b_lat lost the operand\"\n    # dmem-stall style hold: result must stay put and done stay high.\n    dut.hold.value = 1\n    for _ in range(hold_cycles):\n        await RisingEdge(dut.clock)\n        await FallingEdge(dut.clock)\n        assert int(dut.done.value) == 1, \"done dropped while held\"\n        assert int(dut.result.value) == res, \"result changed while held\"\n        assert int(dut.a_lat.value) == (a & MASK32)\n        assert int(dut.b_lat.value) == (b & MASK32)\n    # Consumer takes the result at the end of this cycle.\n    dut.hold.value  = 0\n    dut.start.value = 0\n    await RisingEdge(dut.clock)\n    await FallingEdge(dut.clock)\n    assert int(dut.done.value) == 0, \"unit did not return to IDLE after DONE\"\n    return res, lat\n\n\nasync def check_op(dut, op, vecs, max_lat, **kw):\n    for a, b in vecs:\n        exp = ref(op, a, b)\n        got, _ = await run_op(dut, op, a, b, max_lat, **kw)\n        assert got == exp, (\n            f\"{OP_NAME[op]} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x}: \"\n            f\"expected 0x{exp:08x} got 0x{got:08x}\")\n\n\nasync def _start(dut):\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n    await _reset(dut)\n\n\ndef _mk_test(op: int, max_lat: int):\n    async def body(dut):\n        await _start(dut)\n        vecs = vectors(op)\n        assert len(vecs) >= 30\n        await check_op(dut, op, vecs, max_lat)\n    body.__name__ = OP_NAME[op]\n    return cocotb.test()(body)\n\n\nmul    = _mk_test(ALU_MUL,    MUL_MAX_LAT)\nmulh   = _mk_test(ALU_MULH,   MUL_MAX_LAT)\nmulhu  = _mk_test(ALU_MULHU,  MUL_MAX_LAT)\nmulhsu = _mk_test(ALU_MULHSU, MUL_MAX_LAT)\ndiv    = _mk_test(ALU_DIV,    DIV_MAX_LAT)\ndivu   = _mk_test(ALU_DIVU,   DIV_MAX_LAT)\nrem    = _mk_test(ALU_REM,    DIV_MAX_LAT)\nremu   = _mk_test(ALU_REMU,   DIV_MAX_LAT)\n\n\n@cocotb.test()\nasync def explicit_corner_cases(dut):\n    \"\"\"Hand-written spec vectors, independent of the Python model.\"\"\"\n    await _start(dut)\n    cases = [\n        (ALU_MUL,    0xFFFFFFFF, 0xFFFFFFFF, 1),\n        (ALU_MULH,   INT_MIN,    2,          0xFFFFFFFF),\n        (ALU_MULH,   INT_MIN,    INT_MIN,    0x40000000),\n        (ALU_MULHU,  0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFE),\n        (ALU_MULHSU, INT_MIN,    0xFFFFFFFF, 0x80000000),\n        (ALU_MULHSU, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF),\n        (ALU_DIV,    123,        0,          0xFFFFFFFF),\n        (ALU_DIV,    INT_MIN,    0xFFFFFFFF, INT_MIN),\n        (ALU_DIV,    7,          0xFFFFFFFE, 0xFFFFFFFD),\n        (ALU_DIVU,   42,         0,          0xFFFFFFFF),\n        (ALU_DIVU,   0xFFFFFFFF, 2,          0x7FFFFFFF),\n        (ALU_REM,    0xDEADBEEF, 0,          0xDEADBEEF),\n        (ALU_REM,    INT_MIN,    0xFFFFFFFF, 0),\n        (ALU_REM,    0xFFFFFFF6, 3,          0xFFFFFFFF),\n        (ALU_REM,    10,         0xFFFFFFFD, 1),\n        (ALU_REMU,   0xCAFEBABE, 0,          0xCAFEBABE),\n        (ALU_REMU,   7,          3,          1),\n    ]\n    for op, a, b, exp in cases:\n        lat = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n        got, _ = await run_op(dut, op, a, b, lat)\n        assert got == exp, (f\"{OP_NAME[op]} 0x{a:08x},0x{b:08x}: \"\n                            f\"expected 0x{exp:08x} got 0x{got:08x}\")\n\n\n@cocotb.test()\nasync def back_to_back_mixed(dut):\n    \"\"\"Consecutive ops of different kinds: no state carry-over.\"\"\"\n    await _start(dut)\n    rng = random.Random(1234)\n    ops = [ALU_MUL, ALU_DIVU, ALU_MULH, ALU_REM, ALU_MULHSU, ALU_DIV,\n           ALU_MULHU, ALU_REMU]\n    for i in range(80):\n        op = ops[i % len(ops)] if i < 40 else rng.choice(ops)\n        a = rng.getrandbits(32)\n        b = rng.getrandbits(32) if rng.random() < 0.8 else rng.choice(CORNERS)\n        lat = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n        got, _ = await run_op(dut, op, a, b, lat)\n        assert got == ref(op, a, b), (\n            f\"{OP_NAME[op]} a=0x{a:08x} b=0x{b:08x}: \"\n            f\"expected 0x{ref(op, a, b):08x} got 0x{got:08x}\")\n\n\n@cocotb.test()\nasync def hold_keeps_result(dut):\n    \"\"\"A held DONE (dmem stall coinciding with DONE) keeps the result.\"\"\"\n    await _start(dut)\n    rng = random.Random(99)\n    for op in (ALU_MUL, ALU_MULHU, ALU_DIV, ALU_REMU):\n        for _ in range(4):\n            a, b = rng.getrandbits(32), rng.getrandbits(32)\n            lat = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n            got, _ = await run_op(dut, op, a, b, lat, hold_cycles=5)\n            assert got == ref(op, a, b)\n\n\n@cocotb.test()\nasync def idle_sampling_and_late_start(dut):\n    \"\"\"Operands are sampled every IDLE cycle; the unit only commits on the\n    first cycle `start` is high (EX stalled by dmem before that).\"\"\"\n    await _start(dut)\n    for _ in range(4):\n        dut.op.value    = ALU_MUL\n        dut.a.value     = random.getrandbits(32)\n        dut.b.value     = random.getrandbits(32)\n        dut.start.value = 0\n        await RisingEdge(dut.clock)\n        await FallingEdge(dut.clock)\n        assert int(dut.done.value) == 0, \"unit left IDLE without start\"\n    got, _ = await run_op(dut, ALU_MULHU, 0xFFFFFFFF, 0xFFFFFFFF, MUL_MAX_LAT)\n    assert got == 0xFFFFFFFE\n\n\n@cocotb.test()\nasync def latency_is_bounded(dut):\n    \"\"\"Report and bound the latency of each op class.\"\"\"\n    await _start(dut)\n    for op in OP_NAME:\n        _, lat = await run_op(dut, op, 0x12345678, 0x00000357, 64)\n        bound = DIV_MAX_LAT if op >= ALU_DIV else MUL_MAX_LAT\n        dut._log.info(f\"{OP_NAME[op]}: done {lat} cycles after start\")\n        assert lat <= bound\n\n\ndef test_muldiv_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"muldiv\",\n               sources=[\"core_pkg.sv\", \"muldiv.sv\"],\n               test_module=\"test_muldiv\")\n", "structuredPatch": [], "originalFile": null, "userModified": false}}
