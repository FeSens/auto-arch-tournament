 begin\n        if (b == 32'b0)\n          out = 32'hFFFFFFFF;\n        else if (a == 32'h80000000 && b == 32'hFFFFFFFF)\n          out = 32'h80000000;\n        else\n          out = $unsigned($signed(a) / $signed(b));\n      end\n      ALU_DIVU: out = (b == 32'b0) ? 32'hFFFFFFFF : (a / b);\n      ALU_REM: begin\n        if (b == 32'b0)\n          out = a;\n        else if (a == 32'h80000000 && b == 32'hFFFFFFFF)\n          out = 32'b0;\n        else\n          out = $unsigned($signed(a) % $signed(b));\n      end\n      ALU_REMU: out = (b == 32'b0) ? a : (a % b);\n`endif\n      default:  out = 32'b0;\n    endcase\n  end\n\nendmodule\n", "structuredPatch": [{"oldStart": 55, "oldLines": 28, "newStart": 55, "newLines": 9, "lines": ["       ALU_REM:    out = (a - b) ^ 32'h8da68fa5;", "       ALU_REMU:   out = (a - b) ^ 32'h3138d0e1;", " `else", "-      ALU_MUL:    out = mul_uu[31:0];", "-      ALU_MULH:   out = $unsigned(mul_ss[63:32]);", "-      ALU_MULHU:  out = mul_uu[63:32];", "-      ALU_MULHSU: out = $unsigned(mul_su[63:32]);", "-      ALU_DIV: begin", "-        if (b == 32'b0)", "-          out = 32'hFFFFFFFF;", "-        else if (a == 32'h80000000 && b == 32'hFFFFFFFF)", "-          out = 32'h80000000;", "-        else", "-          out = $unsigned($signed(a) / $signed(b));", "-      end", "-      ALU_DIVU: out = (b == 32'b0) ? 32'hFFFFFFFF : (a / b);", "-      ALU_REM: begin", "-        if (b == 32'b0)", "-          out = a;", "-        else if (a == 32'h80000000 && b == 32'hFFFFFFFF)", "-          out = 32'b0;", "-        else", "-          out = $unsigned($signed(a) % $signed(b));", "-      end", "-      ALU_REMU: out = (b == 32'b0) ? a : (a % b);", "+      // Real build: M ops are NOT computed here. ex_stage routes them to", "+      // the multi-cycle muldiv unit and overrides alu_result with its", "+      // result, so they fall through to the default (0).", " `endif", "       default:  out = 32'b0;", "     endcase"]}], "userModified": false, "replaceAll": 