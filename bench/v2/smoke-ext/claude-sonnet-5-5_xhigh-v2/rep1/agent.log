     md_busy,       // M-op in EX, result not ready\n  output logic               redirect,\n  output logic [31:0]        redirect_target\n);\n\n  // ── Operand forwarding muxes ───────────────────────────────────────────\n  logic [31:0] rs1;\n  logic [31:0] rs2;\n\n  always_comb begin\n    case (fwd_rs1_sel)\n      2'd1:    rs1 = fwd_ex_mem;\n      2'd2:    rs1 = fwd_mem_wb;\n      default: rs1 = in.rs1_val;\n    endcase\n    case (fwd_rs2_sel)\n      2'd1:    rs2 = fwd_ex_mem;\n      2'd2:    rs2 = fwd_mem_wb;\n      default: rs2 = in.rs2_val;\n    endcase\n  end\n\n  // ── ALU operand selection ─────────────────────────────────────────────\n  logic [31:0] alu_a;\n  logic [31:0] alu_b;\n  always_comb begin\n    alu_a = in.ctrl.is_auipc ? in.pc  : rs1;\n    alu_b = in.ctrl.alu_src  ? in.imm : rs2;\n  end\n\n  logic [31:0] alu_result;\n  alu u_alu (\n    .op  (in.ctrl.alu_op),\n    .a   (alu_a),\n    .b   (alu_b),\n    .out (alu_result)\n  );\n\n  // ── Multi-cycle M extension ───────────────────────────────────────────\n  // M ops (alu_op >= ALU_MUL; the decoder emits >= 11 only for legal M\n  // ops, bubbles/NOPs decode to ADD) are executed by the muldiv unit. The\n  // op sits in EX with md_busy=1 (hazard_unit holds IF and ID/EX, EX/MEM\n  // captures bubbles) until muldiv reaches DONE; it leaves EX in the DONE\n  // cycle (unless a dmem stall holds EX/MEM). muldiv samples the forwarded\n  // operands while IDLE and only leaves IDLE on the first non-stalled\n  // cycle, so after that ONLY its latched operands are valid.\n  //\n  // Under RISCV_FORMAL_ALTOPS the M ops are combinational stand-ins in\n  // alu.sv, so the stall path is compiled out and the formal build never\n  // stalls.\n  logic        is_md_op;\n  logic [31:0] md_result;\n  logic [31:0] md_a;\n  logic [31:0] md_b;\n  logic [31:0] ex_result;   // ALU or muldiv result\n  logic [31:0] ex_rs1_val;  // rs1 as reported to RVFI\n  logic [31:0] ex_rs2_val;  // rs2 as reported to RVFI / store data\n\n`ifde