{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfbEwsR9DfwAibxwmfwmb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DDfJEXX7QCYanamENpNS4k","name":"Edit","input":{"replace_all":false,"file_path":"/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py","old_string":"        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0 ... use -36 below\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIV (10, 3, 3),         # back-to-back dependent divide: 14/14 = 1\n        DIVU(11, 10, 9),        # x10 EX/MEM forward; 1 / 0xFFFFFFFF = 0\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7) and (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIV(10, 3, 3))\n    assert r10[\"rd_wdata\"] == 1 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (14, 14)\n    [r11] = _by_insn(rets, DIVU(11, 10, 9))\n    assert r11[\"rd_wdata\"] == 0 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)","new_string":"        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIVU(10, 9, 2),         # DIV right behind a DIV: x9 from EX/MEM\n        DIV (11, 10, 10),       # again back-to-back: x10/x10 = 1\n        REMU(12, 11, 9),        # x11 from EX/MEM, x9 from the regfile: 1 % 0xFFFFFFFF\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=1000)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7)\n    assert (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIVU(10, 9, 2))\n    u10 = _div_ref(\"divu\", M32, 7)\n    assert r10[\"rd_wdata\"] == u10 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (M32, 7)\n    [r11] = _by_insn(rets, DIV(11, 10, 10))\n    assert r11[\"rd_wdata\"] == 1 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (u10, u10)\n    [r12] = _by_insn(rets, REMU(12, 11, 9))\n    assert r12[\"rd_wdata\"] == 1 and (r12[\"rs1_rdata\"], r12[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4890,"cache_read_input_tokens":151422,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4890},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5d95b1c8-e000-48b7-87d2-6f9a2fb11b69","uuid":"33f582fb-f47c-4ace-bea8-bb8107eabeae","timestamp":"2026-10-01T08:58:50.869Z","request_id":"req_011CfbEwrmT4E6bnKxjRRNCm"}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01DDfJEXX7QCYanamENpNS4k", "type": "tool_result", "content": "The file /srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "5d95b1c8-e000-48b7-87d2-6f9a2fb11b69", "uuid": "4a19f37a-fb07-4de8-bec0-05c4e116a4b2", "timestamp": "2026-10-01T08:58:50.879Z", "tool_use_result": {"filePath": "/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py", "oldString": "        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0 ... use -36 below\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIV (10, 3, 3),         # back-to-back dependent divide: 14/14 = 1\n        DIVU(11, 10, 9),        # x10 EX/MEM forward; 1 / 0xFFFFFFFF = 0\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7) and (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIV(10, 3, 3))\n    assert r10[\"rd_wdata\"] == 1 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (14, 14)\n    [r11] = _by_insn(rets, DIVU(11, 10, 9))\n    assert r11[\"rd_wdata\"] == 0 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)", "newString": "        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIVU(10, 9, 2),         # DIV right behind a DIV: x9 from EX/MEM\n        DIV (11, 10, 10),       # again back-to-back: x10/x10 = 1\n        REMU(12, 11, 9),        # x11 from EX/MEM, x9 from the regfile: 1 % 0xFFFFFFFF\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=1000)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7)\n    assert (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIVU(10, 9, 2))\n    u10 = _div_ref(\"divu\", M32, 7)\n    assert r10[\"rd_wdata\"] == u10 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (M32, 7)\n    [r11] = _by_insn(rets, DIV(11, 10, 10))\n    assert r11[\"rd_wdata\"] == 1 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (u10, u10)\n    [r12] = _by_insn(rets, REMU(12, 11, 9))\n    assert r12[\"rd_wdata\"] == 1 and (r12[\"rs1_rdata\"], r12[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)", "originalFile": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef MULOP(f3, rd, rs1, rs2): return _r(0b0000001, rs2, rs1, f3, rd, 0b0110011)  # M-ext\ndef MUL  (rd, rs1, rs2): return MULOP(0b000, rd, rs1, rs2)\ndef DIV  (rd, rs1, rs2): return MULOP(0b100, rd, rs1, rs2)\ndef DIVU (rd, rs1, rs2): return MULOP(0b101, rd, rs1, rs2)\ndef REM  (rd, rs1, rs2): return MULOP(0b110, rd, rs1, rs2)\ndef REMU (rd, rs1, rs2): return MULOP(0b111, rd, rs1, rs2)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    `stall_seed` (default None = zero-wait buses) enables a random ~22%\n    not-ready pattern on both imem and dmem, seeded for reproducibility.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    rng = random.Random(stall_seed) if stall_seed is not None else None\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        if rng is not None:\n            dut.io_imemReady.value = 0 if rng.random() < 0.22 else 1\n            dut.io_dmemReady.value = 0 if rng.random() < 0.22 else 1\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\n    cores report rd_addr = instr[11:7] regardless of trap and let the\n    verifier ignore it on trap=1; both are accepted by riscv-formal.\n    Our reference.py and DUT both follow the zeroed-on-trap convention,\n    so cosim stays in lockstep.\"\"\"\n    program = [\n        0xFFFFFFFF,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    bad = next(r for r in rets if r[\"insn\"] == 0xFFFFFFFF)\n    assert bad[\"trap\"] == 1\n    assert bad[\"rd\"] == 0\n    assert bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def ecall_traps(dut):\n    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n    program = [\n        ECALL(),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [re] = _by_insn(rets, ECALL())\n    assert re[\"trap\"] == 1\n\n\n@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\nM32 = 0xFFFFFFFF\n\n\ndef _s32(x):\n    x &= M32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef _div_ref(kind, a, b):\n    \"\"\"RV32M DIV/DIVU/REM/REMU reference ('div','divu','rem','remu').\"\"\"\n    a &= M32\n    b &= M32\n    if kind == \"divu\":\n        return M32 if b == 0 else a // b\n    if kind == \"remu\":\n        return a if b == 0 else a % b\n    sa, sb = _s32(a), _s32(b)\n    if kind == \"div\":\n        if b == 0:\n            return M32\n        if a == 0x80000000 and b == M32:\n            return 0x80000000\n        q = abs(sa) // abs(sb)\n        return (-q if (sa < 0) != (sb < 0) else q) & M32\n    if b == 0:\n        return a\n    if a == 0x80000000 and b == M32:\n        return 0\n    r = abs(sa) % abs(sb)\n    return (-r if sa < 0 else r) & M32\n\n\ndef _check_orders(rets):\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets))), (\n        f\"rvfi_order not strictly +1: {orders}\"\n    )\n\n\n@cocotb.test()\nasync def div_then_dependent_add(dut):\n    \"\"\"DIV x3 = 100/7; ADD x4,x3,x3 consumes the DIV result straight from\n    EX/MEM, ADD x5,x4,x3 from MEM/WB + EX/MEM; nothing may retire out of\n    order while EX is parked on the divide.\"\"\"\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIV (3, 1, 2),          # 14\n        ADD (4, 3, 3),          # 28  (EX/MEM forward of the divider result)\n        ADD (5, 4, 3),          # 42\n        ADDI(6, 0, 1),          # independent instruction behind the dependents\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=400)\n    [rd] = _by_insn(rets, DIV(3, 1, 2))\n    assert rd[\"rd\"] == 3 and rd[\"rd_wdata\"] == 14\n    assert rd[\"rs1_rdata\"] == 100 and rd[\"rs2_rdata\"] == 7\n    [r4] = _by_insn(rets, ADD(4, 3, 3))\n    [r5] = _by_insn(rets, ADD(5, 4, 3))\n    assert r4[\"rd_wdata\"] == 28, f\"x4 got 0x{r4['rd_wdata']:x}\"\n    assert r5[\"rd_wdata\"] == 42, f\"x5 got 0x{r5['rd_wdata']:x}\"\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 20, 24]\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def producer_then_div_forwarding(dut):\n    \"\"\"Both DIV operands arrive via forwarding at the latch cycle: rs1 from\n    EX/MEM (producer immediately ahead), rs2 from MEM/WB. By the time the\n    divide finishes the forward selects have fallen back to 0 — the stale\n    ID/EX regfile value would be wrong, so the latched operands must win.\n    RVFI rs1/rs2_rdata must report the forwarded values.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(1, 0, 100),\n        DIV (3, 1, 2),          # x1 from EX/MEM, x2 from MEM/WB -> 14\n        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0 ... use -36 below\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIV (10, 3, 3),         # back-to-back dependent divide: 14/14 = 1\n        DIVU(11, 10, 9),        # x10 EX/MEM forward; 1 / 0xFFFFFFFF = 0\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7) and (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIV(10, 3, 3))\n    assert r10[\"rd_wdata\"] == 1 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (14, 14)\n    [r11] = _by_insn(rets, DIVU(11, 10, 9))\n    assert r11[\"rd_wdata\"] == 0 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_corner_cases_in_pipeline(dut):\n    \"\"\"By-zero and INT_MIN/-1 through the whole pipeline (LUI builds INT_MIN).\"\"\"\n    program = [\n        0x800000B7,             # LUI x1, 0x80000  -> x1 = INT_MIN\n        ADDI(2, 0, -1),         # x2 = -1\n        DIV (3, 1, 2),          # INT_MIN / -1 -> INT_MIN\n        REM (4, 1, 2),          # INT_MIN % -1 -> 0\n        DIV (5, 1, 0),          # /0 -> all ones\n        REM (6, 1, 0),          # %0 -> dividend\n        DIVU(7, 1, 0),          # /0 -> all ones\n        REMU(8, 2, 0),          # %0 -> dividend (0xFFFFFFFF)\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, REM(4, 1, 2))[0][\"rd_wdata\"] == 0\n    assert _by_insn(rets, DIV(5, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REM(6, 1, 0))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, DIVU(7, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REMU(8, 2, 0))[0][\"rd_wdata\"] == M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def load_then_div(dut):\n    \"\"\"LW then DIV: (a) DIV consumes the load (load-use stall, then MEM/WB\n    forward), (b) DIV sits right behind an independent LW so the divide\n    start coincides with the load in EX/MEM (dmem-stall start guard).\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),          # mem[0] = -13\n        LW  (1, 0, 0),          # x1 = -13\n        DIV (3, 1, 2),          # load-use into DIV: -13/7 = -1\n        LW  (5, 0, 0),          # independent load right before the next DIV\n        REM (6, 4, 2),          # -13 % 7 = -6\n        SW  (6, 0, 4),          # store the divider result\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),          # load-use into DIVU\n        ADD (9, 8, 3),          # dependent on both divides\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, max_cycles=1000)\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q\n    assert _by_insn(rets, REM(6, 4, 2))[0][\"rd_wdata\"] == r\n    assert dmem.get(4) == r\n    assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u\n    assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_with_random_bus_stalls(dut):\n    \"\"\"The load/div/store mix above under random ~22% imem+dmem stalls, for\n    several seeds. Checks every retirement field the DIV path touches and\n    that rvfi_order stays strictly +1.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),\n        LW  (1, 0, 0),\n        DIV (3, 1, 2),\n        LW  (5, 0, 0),\n        REM (6, 4, 2),\n        SW  (6, 0, 4),\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),\n        ADD (9, 8, 3),\n        MUL (10, 8, 2),         # MUL right behind a divide (shared multiplier)\n        DIV (11, 10, 2),        # dependent divide\n        EBREAK(),\n    ]\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    m = (u * 7) & M32\n    d = _div_ref(\"div\", m, 7)\n    for seed in range(12):\n        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed)\n        tag = f\"seed={seed}\"\n        assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q, tag\n        d3 = _by_insn(rets, DIV(3, 1, 2))[0]\n        assert (d3[\"rs1_rdata\"], d3[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        d6 = _by_insn(rets, REM(6, 4, 2))[0]\n        assert d6[\"rd_wdata\"] == r, tag\n        assert (d6[\"rs1_rdata\"], d6[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        assert dmem.get(4) == r, tag\n        assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u, tag\n        assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32, tag\n        assert _by_insn(rets, MUL(10, 8, 2))[0][\"rd_wdata\"] == m, tag\n        assert _by_insn(rets, DIV(11, 10, 2))[0][\"rd_wdata\"] == d, tag\n        assert [x[\"pc\"] for x in rets] == [4 * i for i in range(len(program))], tag\n        _check_orders(rets)\n        # Reset between seeds so every run starts from the same state.\n        dut.reset.value = 1\n        for _ in range(3):\n            await RisingEdge(dut.clock)\n        dut.reset.value = 0\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "structuredPatch": [{"oldStart": 433, "oldLines": 26, "newStart": 433, "newLines": 31, "lines": ["         ADDI(1, 0, 100),", "         DIV (3, 1, 2),          # x1 from EX/MEM, x2 from MEM/WB -> 14", "         ADDI(6, 0, -35),", "-        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0 ... use -36 below", "+        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0", "         ADDI(8, 0, -36),", "         REM (9, 8, 2),          # -36 % 7 = -1", "-        DIV (10, 3, 3),         # back-to-back dependent divide: 14/14 = 1", "-        DIVU(11, 10, 9),        # x10 EX/MEM forward; 1 / 0xFFFFFFFF = 0", "+        DIVU(10, 9, 2),         # DIV right behind a DIV: x9 from EX/MEM", "+        DIV (11, 10, 10),       # again back-to-back: x10/x10 = 1", "+        REMU(12, 11, 9),        # x11 from EX/MEM, x9 from the regfile: 1 % 0xFFFFFFFF", "         EBREAK(),", "     ]", "-    rets, _ = await _run(dut, program, max_cycles=800)", "+    rets, _ = await _run(dut, program, max_cycles=1000)", "     [r3] = _by_insn(rets, DIV(3, 1, 2))", "     assert r3[\"rd_wdata\"] == 14", "     assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)", "     [r7] = _by_insn(rets, REM(7, 6, 2))", "-    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7) and (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)", "+    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7)", "+    assert (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)", "     [r9] = _by_insn(rets, REM(9, 8, 2))", "     assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32", "     assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)", "-    [r10] = _by_insn(rets, DIV(10, 3, 3))", "-    assert r10[\"rd_wdata\"] == 1 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (14, 14)", "-    [r11] = _by_insn(rets, DIVU(11, 10, 9))", "-    assert r11[\"rd_wdata\"] == 0 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (1, M32)", "+    [r10] = _by_insn(rets, DIVU(10, 9, 2))", "+    u10 = _div_ref(\"divu\", M32, 7)", "+    assert r10[\"rd_wdata\"] == u10 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (M32, 7)", "+    [r11] = _by_insn(rets, DIV(11, 10, 10))", "+    assert r11[\"rd_wdata\"] == 1 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (u10, u10)", "+    [r12] = _by_insn(rets, REMU(12, 11, 9))", "+    assert r12[\"rd_wdata\"] == 1 and (r12[\"rs1_rdata\"], r12[\"rs2_rdata\"]) == (1, M32)", "     _check_orders(rets)", " ", " "]}], "userModified": false, "replaceAll": false}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfbEwsR9DfwAibxwmfwmb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013L5KnRqn6TdpQnQrM3QMYV","name":"Edit","input":{"replace_all":false,"file_path":"/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py","old_string":"        _check_orders(rets)\n        # Reset between seeds so every run starts from the same state.\n        dut.reset.value = 1\n        for _ in range(3):\n            await RisingEdge(dut.clock)\n        dut.reset.value = 0\n","new_string":"        _check_orders(rets)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4890,"cache_read_input_tokens":151422,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4890},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5d95b1c8-e000-48b7-87d2-6f9a2fb11b69","uuid":"bae9a564-22e9-4218-bd1b-41945a349f89","timestamp":"2026-10-01T08:58:52.108Z","request_id":"req_011CfbEwrmT4E6bnKxjRRNCm"}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_013L5KnRqn6TdpQnQrM3QMYV", "type": "tool_result", "content": "The file /srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "5d95b1c8-e000-48b7-87d2-6f9a2fb11b69", "uuid": "145079c4-070c-4255-a30c-1879c3dd6550", "timestamp": "2026-10-01T08:58:52.122Z", "tool_use_result": {"filePath": "/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py", "oldString": "        _check_orders(rets)\n        # Reset between seeds so every run starts from the same state.\n        dut.reset.value = 1\n        for _ in range(3):\n            await RisingEdge(dut.clock)\n        dut.reset.value = 0\n", "newString": "        _check_orders(rets)\n", "originalFile": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef MULOP(f3, rd, rs1, rs2): return _r(0b0000001, rs2, rs1, f3, rd, 0b0110011)  # M-ext\ndef MUL  (rd, rs1, rs2): return MULOP(0b000, rd, rs1, rs2)\ndef DIV  (rd, rs1, rs2): return MULOP(0b100, rd, rs1, rs2)\ndef DIVU (rd, rs1, rs2): return MULOP(0b101, rd, rs1, rs2)\ndef REM  (rd, rs1, rs2): return MULOP(0b110, rd, rs1, rs2)\ndef REMU (rd, rs1, rs2): return MULOP(0b111, rd, rs1, rs2)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    `stall_seed` (default None = zero-wait buses) enables a random ~22%\n    not-ready pattern on both imem and dmem, seeded for reproducibility.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    rng = random.Random(stall_seed) if stall_seed is not None else None\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        if rng is not None:\n            dut.io_imemReady.value = 0 if rng.random() < 0.22 else 1\n            dut.io_dmemReady.value = 0 if rng.random() < 0.22 else 1\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\n    cores report rd_addr = instr[11:7] regardless of trap and let the\n    verifier ignore it on trap=1; both are accepted by riscv-formal.\n    Our reference.py and DUT both follow the zeroed-on-trap convention,\n    so cosim stays in lockstep.\"\"\"\n    program = [\n        0xFFFFFFFF,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    bad = next(r for r in rets if r[\"insn\"] == 0xFFFFFFFF)\n    assert bad[\"trap\"] == 1\n    assert bad[\"rd\"] == 0\n    assert bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def ecall_traps(dut):\n    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n    program = [\n        ECALL(),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [re] = _by_insn(rets, ECALL())\n    assert re[\"trap\"] == 1\n\n\n@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\nM32 = 0xFFFFFFFF\n\n\ndef _s32(x):\n    x &= M32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef _div_ref(kind, a, b):\n    \"\"\"RV32M DIV/DIVU/REM/REMU reference ('div','divu','rem','remu').\"\"\"\n    a &= M32\n    b &= M32\n    if kind == \"divu\":\n        return M32 if b == 0 else a // b\n    if kind == \"remu\":\n        return a if b == 0 else a % b\n    sa, sb = _s32(a), _s32(b)\n    if kind == \"div\":\n        if b == 0:\n            return M32\n        if a == 0x80000000 and b == M32:\n            return 0x80000000\n        q = abs(sa) // abs(sb)\n        return (-q if (sa < 0) != (sb < 0) else q) & M32\n    if b == 0:\n        return a\n    if a == 0x80000000 and b == M32:\n        return 0\n    r = abs(sa) % abs(sb)\n    return (-r if sa < 0 else r) & M32\n\n\ndef _check_orders(rets):\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets))), (\n        f\"rvfi_order not strictly +1: {orders}\"\n    )\n\n\n@cocotb.test()\nasync def div_then_dependent_add(dut):\n    \"\"\"DIV x3 = 100/7; ADD x4,x3,x3 consumes the DIV result straight from\n    EX/MEM, ADD x5,x4,x3 from MEM/WB + EX/MEM; nothing may retire out of\n    order while EX is parked on the divide.\"\"\"\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIV (3, 1, 2),          # 14\n        ADD (4, 3, 3),          # 28  (EX/MEM forward of the divider result)\n        ADD (5, 4, 3),          # 42\n        ADDI(6, 0, 1),          # independent instruction behind the dependents\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=400)\n    [rd] = _by_insn(rets, DIV(3, 1, 2))\n    assert rd[\"rd\"] == 3 and rd[\"rd_wdata\"] == 14\n    assert rd[\"rs1_rdata\"] == 100 and rd[\"rs2_rdata\"] == 7\n    [r4] = _by_insn(rets, ADD(4, 3, 3))\n    [r5] = _by_insn(rets, ADD(5, 4, 3))\n    assert r4[\"rd_wdata\"] == 28, f\"x4 got 0x{r4['rd_wdata']:x}\"\n    assert r5[\"rd_wdata\"] == 42, f\"x5 got 0x{r5['rd_wdata']:x}\"\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 20, 24]\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def producer_then_div_forwarding(dut):\n    \"\"\"Both DIV operands arrive via forwarding at the latch cycle: rs1 from\n    EX/MEM (producer immediately ahead), rs2 from MEM/WB. By the time the\n    divide finishes the forward selects have fallen back to 0 — the stale\n    ID/EX regfile value would be wrong, so the latched operands must win.\n    RVFI rs1/rs2_rdata must report the forwarded values.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(1, 0, 100),\n        DIV (3, 1, 2),          # x1 from EX/MEM, x2 from MEM/WB -> 14\n        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIVU(10, 9, 2),         # DIV right behind a DIV: x9 from EX/MEM\n        DIV (11, 10, 10),       # again back-to-back: x10/x10 = 1\n        REMU(12, 11, 9),        # x11 from EX/MEM, x9 from the regfile: 1 % 0xFFFFFFFF\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=1000)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7)\n    assert (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIVU(10, 9, 2))\n    u10 = _div_ref(\"divu\", M32, 7)\n    assert r10[\"rd_wdata\"] == u10 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (M32, 7)\n    [r11] = _by_insn(rets, DIV(11, 10, 10))\n    assert r11[\"rd_wdata\"] == 1 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (u10, u10)\n    [r12] = _by_insn(rets, REMU(12, 11, 9))\n    assert r12[\"rd_wdata\"] == 1 and (r12[\"rs1_rdata\"], r12[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_corner_cases_in_pipeline(dut):\n    \"\"\"By-zero and INT_MIN/-1 through the whole pipeline (LUI builds INT_MIN).\"\"\"\n    program = [\n        0x800000B7,             # LUI x1, 0x80000  -> x1 = INT_MIN\n        ADDI(2, 0, -1),         # x2 = -1\n        DIV (3, 1, 2),          # INT_MIN / -1 -> INT_MIN\n        REM (4, 1, 2),          # INT_MIN % -1 -> 0\n        DIV (5, 1, 0),          # /0 -> all ones\n        REM (6, 1, 0),          # %0 -> dividend\n        DIVU(7, 1, 0),          # /0 -> all ones\n        REMU(8, 2, 0),          # %0 -> dividend (0xFFFFFFFF)\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, REM(4, 1, 2))[0][\"rd_wdata\"] == 0\n    assert _by_insn(rets, DIV(5, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REM(6, 1, 0))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, DIVU(7, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REMU(8, 2, 0))[0][\"rd_wdata\"] == M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def load_then_div(dut):\n    \"\"\"LW then DIV: (a) DIV consumes the load (load-use stall, then MEM/WB\n    forward), (b) DIV sits right behind an independent LW so the divide\n    start coincides with the load in EX/MEM (dmem-stall start guard).\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),          # mem[0] = -13\n        LW  (1, 0, 0),          # x1 = -13\n        DIV (3, 1, 2),          # load-use into DIV: -13/7 = -1\n        LW  (5, 0, 0),          # independent load right before the next DIV\n        REM (6, 4, 2),          # -13 % 7 = -6\n        SW  (6, 0, 4),          # store the divider result\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),          # load-use into DIVU\n        ADD (9, 8, 3),          # dependent on both divides\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, max_cycles=1000)\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q\n    assert _by_insn(rets, REM(6, 4, 2))[0][\"rd_wdata\"] == r\n    assert dmem.get(4) == r\n    assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u\n    assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_with_random_bus_stalls(dut):\n    \"\"\"The load/div/store mix above under random ~22% imem+dmem stalls, for\n    several seeds. Checks every retirement field the DIV path touches and\n    that rvfi_order stays strictly +1.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),\n        LW  (1, 0, 0),\n        DIV (3, 1, 2),\n        LW  (5, 0, 0),\n        REM (6, 4, 2),\n        SW  (6, 0, 4),\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),\n        ADD (9, 8, 3),\n        MUL (10, 8, 2),         # MUL right behind a divide (shared multiplier)\n        DIV (11, 10, 2),        # dependent divide\n        EBREAK(),\n    ]\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    m = (u * 7) & M32\n    d = _div_ref(\"div\", m, 7)\n    for seed in range(12):\n        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed)\n        tag = f\"seed={seed}\"\n        assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q, tag\n        d3 = _by_insn(rets, DIV(3, 1, 2))[0]\n        assert (d3[\"rs1_rdata\"], d3[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        d6 = _by_insn(rets, REM(6, 4, 2))[0]\n        assert d6[\"rd_wdata\"] == r, tag\n        assert (d6[\"rs1_rdata\"], d6[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        assert dmem.get(4) == r, tag\n        assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u, tag\n        assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32, tag\n        assert _by_insn(rets, MUL(10, 8, 2))[0][\"rd_wdata\"] == m, tag\n        assert _by_insn(rets, DIV(11, 10, 2))[0][\"rd_wdata\"] == d, tag\n        assert [x[\"pc\"] for x in rets] == [4 * i for i in range(len(program))], tag\n        _check_orders(rets)\n        # Reset between seeds so every run starts from the same state.\n        dut.reset.value = 1\n        for _ in range(3):\n            await RisingEdge(dut.clock)\n        dut.reset.value = 0\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "structuredPatch": [{"oldStart": 558, "oldLines": 11, "newStart": 558, "newLines": 6, "lines": ["         assert _by_insn(rets, DIV(11, 10, 2))[0][\"rd_wdata\"] == d, tag", "         assert [x[\"pc\"] for x in rets] == [4 * i for i in range(len(program))], tag", "         _check_orders(rets)", "-        # Reset between seeds so every run starts from the same state.", "-        dut.reset.value = 1", "-        for _ in range(3):", "-            await RisingEdge(dut.clock)", "-        dut.reset.value = 0", " ", " ", " def test_pipeline_runner():"]}], "userModified": false, "replaceAll": false}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfbEwsR9DfwAibxwmfwmb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RLe54Fkgb1aeHDqrraE4oi","name":"Edit","input":{"replace_all":false,"file_path":"/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py","old_string":"        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed)","new_string":"        # _run() resets the DUT itself; only start the clock once per test.\n        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed,\n                                start_clock=(seed == 0))"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4890,"cache_read_input_tokens":151422,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4890},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5d95b1c8-e000-48b7-87d2-6f9a2fb11b69","uuid":"2aa1a9f4-e1b0-4d84-a99e-f91ee461065e","timestamp":"2026-10-01T08:58:53.738Z","request_id":"req_011CfbEwrmT4E6bnKxjRRNCm"}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01RLe54Fkgb1aeHDqrraE4oi", "type": "tool_result", "content": "The file /srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "5d95b1c8-e000-48b7-87d2-6f9a2fb11b69", "uuid": "389cef27-7769-485e-bae8-b3ada351d5b5", "timestamp": "2026-10-01T08:58:53.751Z", "tool_use_result": {"filePath": "/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py", "oldString": "        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed)", "newString": "        # _run() resets the DUT itself; only start the clock once per test.\n        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed,\n                                start_clock=(seed == 0))", "originalFile": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef MULOP(f3, rd, rs1, rs2): return _r(0b0000001, rs2, rs1, f3, rd, 0b0110011)  # M-ext\ndef MUL  (rd, rs1, rs2): return MULOP(0b000, rd, rs1, rs2)\ndef DIV  (rd, rs1, rs2): return MULOP(0b100, rd, rs1, rs2)\ndef DIVU (rd, rs1, rs2): return MULOP(0b101, rd, rs1, rs2)\ndef REM  (rd, rs1, rs2): return MULOP(0b110, rd, rs1, rs2)\ndef REMU (rd, rs1, rs2): return MULOP(0b111, rd, rs1, rs2)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    `stall_seed` (default None = zero-wait buses) enables a random ~22%\n    not-ready pattern on both imem and dmem, seeded for reproducibility.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    rng = random.Random(stall_seed) if stall_seed is not None else None\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        if rng is not None:\n            dut.io_imemReady.value = 0 if rng.random() < 0.22 else 1\n            dut.io_dmemReady.value = 0 if rng.random() < 0.22 else 1\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\n    cores report rd_addr = instr[11:7] regardless of trap and let the\n    verifier ignore it on trap=1; both are accepted by riscv-formal.\n    Our reference.py and DUT both follow the zeroed-on-trap convention,\n    so cosim stays in lockstep.\"\"\"\n    program = [\n        0xFFFFFFFF,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    bad = next(r for r in rets if r[\"insn\"] == 0xFFFFFFFF)\n    assert bad[\"trap\"] == 1\n    assert bad[\"rd\"] == 0\n    assert bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def ecall_traps(dut):\n    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n    program = [\n        ECALL(),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [re] = _by_insn(rets, ECALL())\n    assert re[\"trap\"] == 1\n\n\n@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\nM32 = 0xFFFFFFFF\n\n\ndef _s32(x):\n    x &= M32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef _div_ref(kind, a, b):\n    \"\"\"RV32M DIV/DIVU/REM/REMU reference ('div','divu','rem','remu').\"\"\"\n    a &= M32\n    b &= M32\n    if kind == \"divu\":\n        return M32 if b == 0 else a // b\n    if kind == \"remu\":\n        return a if b == 0 else a % b\n    sa, sb = _s32(a), _s32(b)\n    if kind == \"div\":\n        if b == 0:\n            return M32\n        if a == 0x80000000 and b == M32:\n            return 0x80000000\n        q = abs(sa) // abs(sb)\n        return (-q if (sa < 0) != (sb < 0) else q) & M32\n    if b == 0:\n        return a\n    if a == 0x80000000 and b == M32:\n        return 0\n    r = abs(sa) % abs(sb)\n    return (-r if sa < 0 else r) & M32\n\n\ndef _check_orders(rets):\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets))), (\n        f\"rvfi_order not strictly +1: {orders}\"\n    )\n\n\n@cocotb.test()\nasync def div_then_dependent_add(dut):\n    \"\"\"DIV x3 = 100/7; ADD x4,x3,x3 consumes the DIV result straight from\n    EX/MEM, ADD x5,x4,x3 from MEM/WB + EX/MEM; nothing may retire out of\n    order while EX is parked on the divide.\"\"\"\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIV (3, 1, 2),          # 14\n        ADD (4, 3, 3),          # 28  (EX/MEM forward of the divider result)\n        ADD (5, 4, 3),          # 42\n        ADDI(6, 0, 1),          # independent instruction behind the dependents\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=400)\n    [rd] = _by_insn(rets, DIV(3, 1, 2))\n    assert rd[\"rd\"] == 3 and rd[\"rd_wdata\"] == 14\n    assert rd[\"rs1_rdata\"] == 100 and rd[\"rs2_rdata\"] == 7\n    [r4] = _by_insn(rets, ADD(4, 3, 3))\n    [r5] = _by_insn(rets, ADD(5, 4, 3))\n    assert r4[\"rd_wdata\"] == 28, f\"x4 got 0x{r4['rd_wdata']:x}\"\n    assert r5[\"rd_wdata\"] == 42, f\"x5 got 0x{r5['rd_wdata']:x}\"\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 20, 24]\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def producer_then_div_forwarding(dut):\n    \"\"\"Both DIV operands arrive via forwarding at the latch cycle: rs1 from\n    EX/MEM (producer immediately ahead), rs2 from MEM/WB. By the time the\n    divide finishes the forward selects have fallen back to 0 — the stale\n    ID/EX regfile value would be wrong, so the latched operands must win.\n    RVFI rs1/rs2_rdata must report the forwarded values.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(1, 0, 100),\n        DIV (3, 1, 2),          # x1 from EX/MEM, x2 from MEM/WB -> 14\n        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIVU(10, 9, 2),         # DIV right behind a DIV: x9 from EX/MEM\n        DIV (11, 10, 10),       # again back-to-back: x10/x10 = 1\n        REMU(12, 11, 9),        # x11 from EX/MEM, x9 from the regfile: 1 % 0xFFFFFFFF\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=1000)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7)\n    assert (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIVU(10, 9, 2))\n    u10 = _div_ref(\"divu\", M32, 7)\n    assert r10[\"rd_wdata\"] == u10 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (M32, 7)\n    [r11] = _by_insn(rets, DIV(11, 10, 10))\n    assert r11[\"rd_wdata\"] == 1 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (u10, u10)\n    [r12] = _by_insn(rets, REMU(12, 11, 9))\n    assert r12[\"rd_wdata\"] == 1 and (r12[\"rs1_rdata\"], r12[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_corner_cases_in_pipeline(dut):\n    \"\"\"By-zero and INT_MIN/-1 through the whole pipeline (LUI builds INT_MIN).\"\"\"\n    program = [\n        0x800000B7,             # LUI x1, 0x80000  -> x1 = INT_MIN\n        ADDI(2, 0, -1),         # x2 = -1\n        DIV (3, 1, 2),          # INT_MIN / -1 -> INT_MIN\n        REM (4, 1, 2),          # INT_MIN % -1 -> 0\n        DIV (5, 1, 0),          # /0 -> all ones\n        REM (6, 1, 0),          # %0 -> dividend\n        DIVU(7, 1, 0),          # /0 -> all ones\n        REMU(8, 2, 0),          # %0 -> dividend (0xFFFFFFFF)\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, REM(4, 1, 2))[0][\"rd_wdata\"] == 0\n    assert _by_insn(rets, DIV(5, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REM(6, 1, 0))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, DIVU(7, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REMU(8, 2, 0))[0][\"rd_wdata\"] == M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def load_then_div(dut):\n    \"\"\"LW then DIV: (a) DIV consumes the load (load-use stall, then MEM/WB\n    forward), (b) DIV sits right behind an independent LW so the divide\n    start coincides with the load in EX/MEM (dmem-stall start guard).\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),          # mem[0] = -13\n        LW  (1, 0, 0),          # x1 = -13\n        DIV (3, 1, 2),          # load-use into DIV: -13/7 = -1\n        LW  (5, 0, 0),          # independent load right before the next DIV\n        REM (6, 4, 2),          # -13 % 7 = -6\n        SW  (6, 0, 4),          # store the divider result\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),          # load-use into DIVU\n        ADD (9, 8, 3),          # dependent on both divides\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, max_cycles=1000)\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q\n    assert _by_insn(rets, REM(6, 4, 2))[0][\"rd_wdata\"] == r\n    assert dmem.get(4) == r\n    assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u\n    assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_with_random_bus_stalls(dut):\n    \"\"\"The load/div/store mix above under random ~22% imem+dmem stalls, for\n    several seeds. Checks every retirement field the DIV path touches and\n    that rvfi_order stays strictly +1.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),\n        LW  (1, 0, 0),\n        DIV (3, 1, 2),\n        LW  (5, 0, 0),\n        REM (6, 4, 2),\n        SW  (6, 0, 4),\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),\n        ADD (9, 8, 3),\n        MUL (10, 8, 2),         # MUL right behind a divide (shared multiplier)\n        DIV (11, 10, 2),        # dependent divide\n        EBREAK(),\n    ]\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    m = (u * 7) & M32\n    d = _div_ref(\"div\", m, 7)\n    for seed in range(12):\n        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed)\n        tag = f\"seed={seed}\"\n        assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q, tag\n        d3 = _by_insn(rets, DIV(3, 1, 2))[0]\n        assert (d3[\"rs1_rdata\"], d3[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        d6 = _by_insn(rets, REM(6, 4, 2))[0]\n        assert d6[\"rd_wdata\"] == r, tag\n        assert (d6[\"rs1_rdata\"], d6[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        assert dmem.get(4) == r, tag\n        assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u, tag\n        assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32, tag\n        assert _by_insn(rets, MUL(10, 8, 2))[0][\"rd_wdata\"] == m, tag\n        assert _by_insn(rets, DIV(11, 10, 2))[0][\"rd_wdata\"] == d, tag\n        assert [x[\"pc\"] for x in rets] == [4 * i for i in range(len(program))], tag\n        _check_orders(rets)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "structuredPatch": [{"oldStart": 543, "oldLines": 7, "newStart": 543, "newLines": 9, "lines": ["     m = (u * 7) & M32", "     d = _div_ref(\"div\", m, 7)", "     for seed in range(12):", "-        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed)", "+        # _run() resets the DUT itself; only start the clock once per test.", "+        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed,", "+                                start_clock=(seed == 0))", "         tag = f\"seed={seed}\"", "         assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q, tag", "         d3 = _by_insn(rets, DIV(3, 1, 2))[0]"]}], "userModified": false, "replaceAll": false}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfbEwsR9DfwAibxwmfwmb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013LxeKss6781NbeX4qpkU7T","name":"Edit","input":{"replace_all":false,"file_path":"/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py","old_string":"async def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None):","new_string":"async def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None,\n               start_clock=True):"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4890,"cache_read_input_tokens":151422,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4890},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5d95b1c8-e000-48b7-87d2-6f9a2fb11b69","uuid":"72d44891-8e44-4f7d-a6ba-e29a2fdb327f","timestamp":"2026-10-01T08:58:54.984Z","request_id":"req_011CfbEwrmT4E6bnKxjRRNCm"}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_013LxeKss6781NbeX4qpkU7T", "type": "tool_result", "content": "The file /srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "5d95b1c8-e000-48b7-87d2-6f9a2fb11b69", "uuid": "a47bf06b-40c7-465e-b59a-42de268bb50a", "timestamp": "2026-10-01T08:58:54.995Z", "tool_use_result": {"filePath": "/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py", "oldString": "async def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None):", "newString": "async def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None,\n               start_clock=True):", "originalFile": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef MULOP(f3, rd, rs1, rs2): return _r(0b0000001, rs2, rs1, f3, rd, 0b0110011)  # M-ext\ndef MUL  (rd, rs1, rs2): return MULOP(0b000, rd, rs1, rs2)\ndef DIV  (rd, rs1, rs2): return MULOP(0b100, rd, rs1, rs2)\ndef DIVU (rd, rs1, rs2): return MULOP(0b101, rd, rs1, rs2)\ndef REM  (rd, rs1, rs2): return MULOP(0b110, rd, rs1, rs2)\ndef REMU (rd, rs1, rs2): return MULOP(0b111, rd, rs1, rs2)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    `stall_seed` (default None = zero-wait buses) enables a random ~22%\n    not-ready pattern on both imem and dmem, seeded for reproducibility.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    rng = random.Random(stall_seed) if stall_seed is not None else None\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        if rng is not None:\n            dut.io_imemReady.value = 0 if rng.random() < 0.22 else 1\n            dut.io_dmemReady.value = 0 if rng.random() < 0.22 else 1\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\n    cores report rd_addr = instr[11:7] regardless of trap and let the\n    verifier ignore it on trap=1; both are accepted by riscv-formal.\n    Our reference.py and DUT both follow the zeroed-on-trap convention,\n    so cosim stays in lockstep.\"\"\"\n    program = [\n        0xFFFFFFFF,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    bad = next(r for r in rets if r[\"insn\"] == 0xFFFFFFFF)\n    assert bad[\"trap\"] == 1\n    assert bad[\"rd\"] == 0\n    assert bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def ecall_traps(dut):\n    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n    program = [\n        ECALL(),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [re] = _by_insn(rets, ECALL())\n    assert re[\"trap\"] == 1\n\n\n@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\nM32 = 0xFFFFFFFF\n\n\ndef _s32(x):\n    x &= M32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef _div_ref(kind, a, b):\n    \"\"\"RV32M DIV/DIVU/REM/REMU reference ('div','divu','rem','remu').\"\"\"\n    a &= M32\n    b &= M32\n    if kind == \"divu\":\n        return M32 if b == 0 else a // b\n    if kind == \"remu\":\n        return a if b == 0 else a % b\n    sa, sb = _s32(a), _s32(b)\n    if kind == \"div\":\n        if b == 0:\n            return M32\n        if a == 0x80000000 and b == M32:\n            return 0x80000000\n        q = abs(sa) // abs(sb)\n        return (-q if (sa < 0) != (sb < 0) else q) & M32\n    if b == 0:\n        return a\n    if a == 0x80000000 and b == M32:\n        return 0\n    r = abs(sa) % abs(sb)\n    return (-r if sa < 0 else r) & M32\n\n\ndef _check_orders(rets):\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets))), (\n        f\"rvfi_order not strictly +1: {orders}\"\n    )\n\n\n@cocotb.test()\nasync def div_then_dependent_add(dut):\n    \"\"\"DIV x3 = 100/7; ADD x4,x3,x3 consumes the DIV result straight from\n    EX/MEM, ADD x5,x4,x3 from MEM/WB + EX/MEM; nothing may retire out of\n    order while EX is parked on the divide.\"\"\"\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIV (3, 1, 2),          # 14\n        ADD (4, 3, 3),          # 28  (EX/MEM forward of the divider result)\n        ADD (5, 4, 3),          # 42\n        ADDI(6, 0, 1),          # independent instruction behind the dependents\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=400)\n    [rd] = _by_insn(rets, DIV(3, 1, 2))\n    assert rd[\"rd\"] == 3 and rd[\"rd_wdata\"] == 14\n    assert rd[\"rs1_rdata\"] == 100 and rd[\"rs2_rdata\"] == 7\n    [r4] = _by_insn(rets, ADD(4, 3, 3))\n    [r5] = _by_insn(rets, ADD(5, 4, 3))\n    assert r4[\"rd_wdata\"] == 28, f\"x4 got 0x{r4['rd_wdata']:x}\"\n    assert r5[\"rd_wdata\"] == 42, f\"x5 got 0x{r5['rd_wdata']:x}\"\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 20, 24]\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def producer_then_div_forwarding(dut):\n    \"\"\"Both DIV operands arrive via forwarding at the latch cycle: rs1 from\n    EX/MEM (producer immediately ahead), rs2 from MEM/WB. By the time the\n    divide finishes the forward selects have fallen back to 0 — the stale\n    ID/EX regfile value would be wrong, so the latched operands must win.\n    RVFI rs1/rs2_rdata must report the forwarded values.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(1, 0, 100),\n        DIV (3, 1, 2),          # x1 from EX/MEM, x2 from MEM/WB -> 14\n        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIVU(10, 9, 2),         # DIV right behind a DIV: x9 from EX/MEM\n        DIV (11, 10, 10),       # again back-to-back: x10/x10 = 1\n        REMU(12, 11, 9),        # x11 from EX/MEM, x9 from the regfile: 1 % 0xFFFFFFFF\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=1000)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7)\n    assert (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIVU(10, 9, 2))\n    u10 = _div_ref(\"divu\", M32, 7)\n    assert r10[\"rd_wdata\"] == u10 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (M32, 7)\n    [r11] = _by_insn(rets, DIV(11, 10, 10))\n    assert r11[\"rd_wdata\"] == 1 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (u10, u10)\n    [r12] = _by_insn(rets, REMU(12, 11, 9))\n    assert r12[\"rd_wdata\"] == 1 and (r12[\"rs1_rdata\"], r12[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_corner_cases_in_pipeline(dut):\n    \"\"\"By-zero and INT_MIN/-1 through the whole pipeline (LUI builds INT_MIN).\"\"\"\n    program = [\n        0x800000B7,             # LUI x1, 0x80000  -> x1 = INT_MIN\n        ADDI(2, 0, -1),         # x2 = -1\n        DIV (3, 1, 2),          # INT_MIN / -1 -> INT_MIN\n        REM (4, 1, 2),          # INT_MIN % -1 -> 0\n        DIV (5, 1, 0),          # /0 -> all ones\n        REM (6, 1, 0),          # %0 -> dividend\n        DIVU(7, 1, 0),          # /0 -> all ones\n        REMU(8, 2, 0),          # %0 -> dividend (0xFFFFFFFF)\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, REM(4, 1, 2))[0][\"rd_wdata\"] == 0\n    assert _by_insn(rets, DIV(5, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REM(6, 1, 0))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, DIVU(7, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REMU(8, 2, 0))[0][\"rd_wdata\"] == M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def load_then_div(dut):\n    \"\"\"LW then DIV: (a) DIV consumes the load (load-use stall, then MEM/WB\n    forward), (b) DIV sits right behind an independent LW so the divide\n    start coincides with the load in EX/MEM (dmem-stall start guard).\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),          # mem[0] = -13\n        LW  (1, 0, 0),          # x1 = -13\n        DIV (3, 1, 2),          # load-use into DIV: -13/7 = -1\n        LW  (5, 0, 0),          # independent load right before the next DIV\n        REM (6, 4, 2),          # -13 % 7 = -6\n        SW  (6, 0, 4),          # store the divider result\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),          # load-use into DIVU\n        ADD (9, 8, 3),          # dependent on both divides\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, max_cycles=1000)\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q\n    assert _by_insn(rets, REM(6, 4, 2))[0][\"rd_wdata\"] == r\n    assert dmem.get(4) == r\n    assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u\n    assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_with_random_bus_stalls(dut):\n    \"\"\"The load/div/store mix above under random ~22% imem+dmem stalls, for\n    several seeds. Checks every retirement field the DIV path touches and\n    that rvfi_order stays strictly +1.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),\n        LW  (1, 0, 0),\n        DIV (3, 1, 2),\n        LW  (5, 0, 0),\n        REM (6, 4, 2),\n        SW  (6, 0, 4),\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),\n        ADD (9, 8, 3),\n        MUL (10, 8, 2),         # MUL right behind a divide (shared multiplier)\n        DIV (11, 10, 2),        # dependent divide\n        EBREAK(),\n    ]\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    m = (u * 7) & M32\n    d = _div_ref(\"div\", m, 7)\n    for seed in range(12):\n        # _run() resets the DUT itself; only start the clock once per test.\n        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed,\n                                start_clock=(seed == 0))\n        tag = f\"seed={seed}\"\n        assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q, tag\n        d3 = _by_insn(rets, DIV(3, 1, 2))[0]\n        assert (d3[\"rs1_rdata\"], d3[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        d6 = _by_insn(rets, REM(6, 4, 2))[0]\n        assert d6[\"rd_wdata\"] == r, tag\n        assert (d6[\"rs1_rdata\"], d6[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        assert dmem.get(4) == r, tag\n        assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u, tag\n        assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32, tag\n        assert _by_insn(rets, MUL(10, 8, 2))[0][\"rd_wdata\"] == m, tag\n        assert _by_insn(rets, DIV(11, 10, 2))[0][\"rd_wdata\"] == d, tag\n        assert [x[\"pc\"] for x in rets] == [4 * i for i in range(len(program))], tag\n        _check_orders(rets)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "structuredPatch": [{"oldStart": 74, "oldLines": 7, "newStart": 74, "newLines": 8, "lines": [" ", " ", " # ── Harness ────────────────────────────────────────────────────────────────", "-async def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None):", "+async def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None,", "+               start_clock=True):", "     \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.", " ", "     imem is read combinationally each cycle from imemAddr; dmem similarly."]}], "userModified": false, "replaceAll": false}}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfbEwsR9DfwAibxwmfwmb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015JPKKPWVzKMRKJwrxdrkCS","name":"Edit","input":{"replace_all":false,"file_path":"/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py","old_string":"    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1","new_string":"    if start_clock:\n        cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4890,"cache_read_input_tokens":151422,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4890},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5d95b1c8-e000-48b7-87d2-6f9a2fb11b69","uuid":"5b6107e9-de47-4237-85a4-00da7d087366","timestamp":"2026-10-01T08:58:55.629Z","request_id":"req_011CfbEwrmT4E6bnKxjRRNCm"}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_015JPKKPWVzKMRKJwrxdrkCS", "type": "tool_result", "content": "The file /srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]}, "parent_tool_use_id": null, "session_id": "5d95b1c8-e000-48b7-87d2-6f9a2fb11b69", "uuid": "72d0cdf4-07be-4246-989b-e5af3ae33d38", "timestamp": "2026-10-01T08:58:55.642Z", "tool_use_result": {"filePath": "/srv/hwebench/clones/claude-sonnet-5-5_xhigh-v2-rep1/cores/bench/worktrees/hyp-20261001-001-r1s0/cores/bench/test/test_pipeline.py", "oldString": "    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1", "newString": "    if start_clock:\n        cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1", "originalFile": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport random\n\nimport cocotb\nfrom cocotb.clock import Clock\nfrom cocotb.triggers import RisingEdge, Timer\n\nfrom _helpers import run_cocotb\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n    return ((imm & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _s(imm, rs2, rs1, funct3, opcode):\n    imm_hi = (imm >> 5) & 0x7F\n    imm_lo = imm & 0x1F\n    return (imm_hi << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (imm_lo << 7) | (opcode & 0x7F)\n\n\ndef _b(imm, rs2, rs1, funct3, opcode):\n    # imm is a 13-bit signed number; bit 0 is implicitly zero.\n    b12  = (imm >> 12) & 1\n    b105 = (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b010, rd, 0b0000011)\ndef SW  (rs2, rs1, imm): return _s(imm & 0xFFF, rs2, rs1, 0b010, 0b0100011)\ndef BEQ (rs1, rs2, imm): return _b(imm, rs2, rs1, 0b000, 0b1100011)\ndef JAL (rd, imm):       return _j(imm, rd, 0b1101111)\ndef JALR(rd, rs1, imm):  return _i(imm & 0xFFF, rs1, 0b000, rd, 0b1100111)\ndef MULOP(f3, rd, rs1, rs2): return _r(0b0000001, rs2, rs1, f3, rd, 0b0110011)  # M-ext\ndef MUL  (rd, rs1, rs2): return MULOP(0b000, rd, rs1, rs2)\ndef DIV  (rd, rs1, rs2): return MULOP(0b100, rd, rs1, rs2)\ndef DIVU (rd, rs1, rs2): return MULOP(0b101, rd, rs1, rs2)\ndef REM  (rd, rs1, rs2): return MULOP(0b110, rd, rs1, rs2)\ndef REMU (rd, rs1, rs2): return MULOP(0b111, rd, rs1, rs2)\ndef NOP():               return ADDI(0, 0, 0)        # = 0x00000013\ndef EBREAK():            return 0x00100073\ndef ECALL():             return 0x00000073\n\n\n# ── Harness ────────────────────────────────────────────────────────────────\nasync def _run(dut, program, dmem_init=None, max_cycles=200, stall_seed=None,\n               start_clock=True):\n    \"\"\"Drive imem/dmem; capture RVFI retirements until EBREAK or max_cycles.\n\n    imem is read combinationally each cycle from imemAddr; dmem similarly.\n    Stores get applied to the Python-side dmem dict so subsequent loads\n    see the new value.\n\n    `stall_seed` (default None = zero-wait buses) enables a random ~22%\n    not-ready pattern on both imem and dmem, seeded for reproducibility.\n\n    Returns (retirements, dmem) where retirements is a list of dicts\n    sampled on every cycle that rvfi_valid=1.\n    \"\"\"\n    imem = {i * 4: instr & 0xFFFFFFFF for i, instr in enumerate(program)}\n    dmem = dict(dmem_init or {})\n    retirements: list[dict] = []\n    rng = random.Random(stall_seed) if stall_seed is not None else None\n\n    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())\n\n    dut.reset.value = 1\n    dut.io_imemData.value = 0\n    dut.io_dmemRData.value = 0\n    # Zero-wait bus model: ready always asserted. The stall-mode tests\n    # live in vex_main.cpp's --istall/--dstall flags, not in cocotb.\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await RisingEdge(dut.clock)\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    dut.io_imemData.value = imem.get(0, EBREAK())\n\n    for cycle in range(max_cycles):\n        await RisingEdge(dut.clock)\n        await Timer(1, \"ns\")  # let combinational signals settle\n\n        # Sample the post-edge state.\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        rvfi_v    = int(dut.io_rvfi_valid_0.value)\n\n        # Apply dmem write side effects.\n        if wen:\n            wdata = int(dut.io_dmemWData.value)\n            wa = da & ~3\n            old = dmem.get(wa, 0)\n            new = old\n            for i in range(4):\n                if (wen >> i) & 1:\n                    bv = (wdata >> (i * 8)) & 0xFF\n                    new = (new & ~(0xFF << (i * 8))) | (bv << (i * 8))\n            dmem[wa] = new\n\n        # Capture RVFI retirement.\n        if rvfi_v:\n            r = {\n                \"order\":     int(dut.io_rvfi_order_0.value),\n                \"insn\":      int(dut.io_rvfi_insn_0.value),\n                \"pc\":        int(dut.io_rvfi_pc_rdata_0.value),\n                \"pc_next\":   int(dut.io_rvfi_pc_wdata_0.value),\n                \"rd\":        int(dut.io_rvfi_rd_addr_0.value),\n                \"rd_wdata\":  int(dut.io_rvfi_rd_wdata_0.value),\n                \"rs1_addr\":  int(dut.io_rvfi_rs1_addr_0.value),\n                \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        if rng is not None:\n            dut.io_imemReady.value = 0 if rng.random() < 0.22 else 1\n            dut.io_dmemReady.value = 0 if rng.random() < 0.22 else 1\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r2[\"rd_wdata\"] == 8\n\n\n@cocotb.test()\nasync def load_use_stalls(dut):\n    \"\"\"SW x3 to mem; LW x1, 0(x0); ADD x2, x1, x4 — load-use must stall once.\n\n    All immediates kept inside the signed 12-bit positive range so ADDI's\n    sign-extension doesn't muddy the expected values.\n    \"\"\"\n    program = [\n        ADDI(3, 0, 0x123),     # x3 = 0x123\n        ADDI(4, 0, 0x100),     # x4 = 0x100\n        SW  (3, 0, 0),         # mem[0] = x3\n        LW  (1, 0, 0),         # x1 = mem[0]; uses x1 next cycle -> stall\n        ADD (2, 1, 4),         # x2 = x1 + x4 = 0x223\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def branch_taken_skips(dut):\n    \"\"\"BEQ x0, x0, +8 — the wrong-path instruction must NOT retire at all,\n    not merely retire with rd_wdata != 99. Asserting only the side effect\n    would let a wrong-path retirement with rd=0 / trap=1 / different data\n    pass silently.\"\"\"\n    program = [\n        BEQ(0, 0, 8),          # PC=0;  taken; skip the next instr\n        ADDI(1, 0, 99),        # PC=4;  SHOULD NEVER retire\n        ADDI(2, 0, 42),        # PC=8;  branch target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    # Strict: no retirement should originate from PC=4.\n    leaked = [r for r in rets if r[\"pc\"] == 4]\n    assert not leaked, f\"wrong-path retirement leaked from PC=4: {leaked}\"\n    # Strict: no retirement carries the skipped instruction word at all.\n    leaked_insn = [r for r in rets if r[\"insn\"] == ADDI(1, 0, 99)]\n    assert not leaked_insn, f\"skipped instr ADDI x1,99 retired: {leaked_insn}\"\n    # Sanity: the target instruction and the EBREAK do retire, in order.\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [r2] = _by_insn(rets, ADDI(2, 0, 42))\n    assert r2[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jal_writes_pc_plus_4(dut):\n    \"\"\"JAL x1, +8; verify the wrong-path slot does not retire and x1=PC+4.\"\"\"\n    program = [\n        JAL(1, 8),             # PC=0; x1 := 4; jump to PC=8\n        ADDI(2, 0, 99),        # PC=4 — wrong-path; must not retire\n        ADDI(3, 0, 42),        # PC=8 — target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 8, 12], f\"unexpected retirement PC sequence: {pcs}\"\n    [rj] = _by_insn(rets, JAL(1, 8))\n    assert rj[\"rd\"] == 1\n    assert rj[\"rd_wdata\"] == rj[\"pc\"] + 4\n    [r3] = _by_insn(rets, ADDI(3, 0, 42))\n    assert r3[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def jalr_target(dut):\n    \"\"\"ADDI x5,x0,12; JALR x1,x5,0; verify wrong-path slot doesn't retire.\"\"\"\n    program = [\n        ADDI(5, 0, 12),        # PC=0;  x5 := 12\n        JALR(1, 5, 0),         # PC=4;  jump to x5+0 = 12\n        ADDI(6, 0, 99),        # PC=8;  wrong-path\n        ADDI(7, 0, 42),        # PC=12; target\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    pcs = [r[\"pc\"] for r in rets]\n    assert pcs == [0, 4, 12, 16], f\"unexpected retirement PC sequence: {pcs}\"\n    [r7] = _by_insn(rets, ADDI(7, 0, 42))\n    assert r7[\"rd_wdata\"] == 42\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n\n    Project convention: when reg_write=0 (which the decoder forces on\n    illegal), rvfi_rd_addr and rvfi_rd_wdata are both reported as 0.\n    This is one valid RVFI interpretation (the spec says \"for\n    instructions that do not write rd, the value is 0\"). Some other\n    cores report rd_addr = instr[11:7] regardless of trap and let the\n    verifier ignore it on trap=1; both are accepted by riscv-formal.\n    Our reference.py and DUT both follow the zeroed-on-trap convention,\n    so cosim stays in lockstep.\"\"\"\n    program = [\n        0xFFFFFFFF,\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    bad = next(r for r in rets if r[\"insn\"] == 0xFFFFFFFF)\n    assert bad[\"trap\"] == 1\n    assert bad[\"rd\"] == 0\n    assert bad[\"rd_wdata\"] == 0\n\n\n@cocotb.test()\nasync def ecall_traps(dut):\n    \"\"\"ECALL retires with rvfi_trap=1 (project-specific: only EBREAK is legal).\"\"\"\n    program = [\n        ECALL(),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    [re] = _by_insn(rets, ECALL())\n    assert re[\"trap\"] == 1\n\n\n@cocotb.test()\nasync def ebreak_does_not_trap(dut):\n    \"\"\"EBREAK retires with rvfi_trap=0 — this is the project-specific halt marker.\"\"\"\n    program = [EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=20)\n    [re] = _by_insn(rets, EBREAK())\n    assert re[\"trap\"] == 0, f\"EBREAK should not trap; got trap={re['trap']}\"\n\n\n@cocotb.test()\nasync def rvfi_order_strictly_monotonic(dut):\n    \"\"\"A short stream must produce rvfi_order = 0,1,2,... with no gaps.\"\"\"\n    program = [\n        ADDI(1, 0, 1),\n        ADDI(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\nM32 = 0xFFFFFFFF\n\n\ndef _s32(x):\n    x &= M32\n    return x - (1 << 32) if x & 0x80000000 else x\n\n\ndef _div_ref(kind, a, b):\n    \"\"\"RV32M DIV/DIVU/REM/REMU reference ('div','divu','rem','remu').\"\"\"\n    a &= M32\n    b &= M32\n    if kind == \"divu\":\n        return M32 if b == 0 else a // b\n    if kind == \"remu\":\n        return a if b == 0 else a % b\n    sa, sb = _s32(a), _s32(b)\n    if kind == \"div\":\n        if b == 0:\n            return M32\n        if a == 0x80000000 and b == M32:\n            return 0x80000000\n        q = abs(sa) // abs(sb)\n        return (-q if (sa < 0) != (sb < 0) else q) & M32\n    if b == 0:\n        return a\n    if a == 0x80000000 and b == M32:\n        return 0\n    r = abs(sa) % abs(sb)\n    return (-r if sa < 0 else r) & M32\n\n\ndef _check_orders(rets):\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets))), (\n        f\"rvfi_order not strictly +1: {orders}\"\n    )\n\n\n@cocotb.test()\nasync def div_then_dependent_add(dut):\n    \"\"\"DIV x3 = 100/7; ADD x4,x3,x3 consumes the DIV result straight from\n    EX/MEM, ADD x5,x4,x3 from MEM/WB + EX/MEM; nothing may retire out of\n    order while EX is parked on the divide.\"\"\"\n    program = [\n        ADDI(1, 0, 100),\n        ADDI(2, 0, 7),\n        DIV (3, 1, 2),          # 14\n        ADD (4, 3, 3),          # 28  (EX/MEM forward of the divider result)\n        ADD (5, 4, 3),          # 42\n        ADDI(6, 0, 1),          # independent instruction behind the dependents\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=400)\n    [rd] = _by_insn(rets, DIV(3, 1, 2))\n    assert rd[\"rd\"] == 3 and rd[\"rd_wdata\"] == 14\n    assert rd[\"rs1_rdata\"] == 100 and rd[\"rs2_rdata\"] == 7\n    [r4] = _by_insn(rets, ADD(4, 3, 3))\n    [r5] = _by_insn(rets, ADD(5, 4, 3))\n    assert r4[\"rd_wdata\"] == 28, f\"x4 got 0x{r4['rd_wdata']:x}\"\n    assert r5[\"rd_wdata\"] == 42, f\"x5 got 0x{r5['rd_wdata']:x}\"\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16, 20, 24]\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def producer_then_div_forwarding(dut):\n    \"\"\"Both DIV operands arrive via forwarding at the latch cycle: rs1 from\n    EX/MEM (producer immediately ahead), rs2 from MEM/WB. By the time the\n    divide finishes the forward selects have fallen back to 0 — the stale\n    ID/EX regfile value would be wrong, so the latched operands must win.\n    RVFI rs1/rs2_rdata must report the forwarded values.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(1, 0, 100),\n        DIV (3, 1, 2),          # x1 from EX/MEM, x2 from MEM/WB -> 14\n        ADDI(6, 0, -35),\n        REM (7, 6, 2),          # x6 from EX/MEM -> -35 % 7 = 0\n        ADDI(8, 0, -36),\n        REM (9, 8, 2),          # -36 % 7 = -1\n        DIVU(10, 9, 2),         # DIV right behind a DIV: x9 from EX/MEM\n        DIV (11, 10, 10),       # again back-to-back: x10/x10 = 1\n        REMU(12, 11, 9),        # x11 from EX/MEM, x9 from the regfile: 1 % 0xFFFFFFFF\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=1000)\n    [r3] = _by_insn(rets, DIV(3, 1, 2))\n    assert r3[\"rd_wdata\"] == 14\n    assert (r3[\"rs1_rdata\"], r3[\"rs2_rdata\"]) == (100, 7)\n    [r7] = _by_insn(rets, REM(7, 6, 2))\n    assert r7[\"rd_wdata\"] == _div_ref(\"rem\", -35, 7)\n    assert (r7[\"rs1_rdata\"], r7[\"rs2_rdata\"]) == (-35 & M32, 7)\n    [r9] = _by_insn(rets, REM(9, 8, 2))\n    assert r9[\"rd_wdata\"] == _div_ref(\"rem\", -36, 7) == M32\n    assert (r9[\"rs1_rdata\"], r9[\"rs2_rdata\"]) == (-36 & M32, 7)\n    [r10] = _by_insn(rets, DIVU(10, 9, 2))\n    u10 = _div_ref(\"divu\", M32, 7)\n    assert r10[\"rd_wdata\"] == u10 and (r10[\"rs1_rdata\"], r10[\"rs2_rdata\"]) == (M32, 7)\n    [r11] = _by_insn(rets, DIV(11, 10, 10))\n    assert r11[\"rd_wdata\"] == 1 and (r11[\"rs1_rdata\"], r11[\"rs2_rdata\"]) == (u10, u10)\n    [r12] = _by_insn(rets, REMU(12, 11, 9))\n    assert r12[\"rd_wdata\"] == 1 and (r12[\"rs1_rdata\"], r12[\"rs2_rdata\"]) == (1, M32)\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_corner_cases_in_pipeline(dut):\n    \"\"\"By-zero and INT_MIN/-1 through the whole pipeline (LUI builds INT_MIN).\"\"\"\n    program = [\n        0x800000B7,             # LUI x1, 0x80000  -> x1 = INT_MIN\n        ADDI(2, 0, -1),         # x2 = -1\n        DIV (3, 1, 2),          # INT_MIN / -1 -> INT_MIN\n        REM (4, 1, 2),          # INT_MIN % -1 -> 0\n        DIV (5, 1, 0),          # /0 -> all ones\n        REM (6, 1, 0),          # %0 -> dividend\n        DIVU(7, 1, 0),          # /0 -> all ones\n        REMU(8, 2, 0),          # %0 -> dividend (0xFFFFFFFF)\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=800)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, REM(4, 1, 2))[0][\"rd_wdata\"] == 0\n    assert _by_insn(rets, DIV(5, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REM(6, 1, 0))[0][\"rd_wdata\"] == 0x80000000\n    assert _by_insn(rets, DIVU(7, 1, 0))[0][\"rd_wdata\"] == M32\n    assert _by_insn(rets, REMU(8, 2, 0))[0][\"rd_wdata\"] == M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def load_then_div(dut):\n    \"\"\"LW then DIV: (a) DIV consumes the load (load-use stall, then MEM/WB\n    forward), (b) DIV sits right behind an independent LW so the divide\n    start coincides with the load in EX/MEM (dmem-stall start guard).\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),          # mem[0] = -13\n        LW  (1, 0, 0),          # x1 = -13\n        DIV (3, 1, 2),          # load-use into DIV: -13/7 = -1\n        LW  (5, 0, 0),          # independent load right before the next DIV\n        REM (6, 4, 2),          # -13 % 7 = -6\n        SW  (6, 0, 4),          # store the divider result\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),          # load-use into DIVU\n        ADD (9, 8, 3),          # dependent on both divides\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program, max_cycles=1000)\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q\n    assert _by_insn(rets, REM(6, 4, 2))[0][\"rd_wdata\"] == r\n    assert dmem.get(4) == r\n    assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u\n    assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32\n    _check_orders(rets)\n\n\n@cocotb.test()\nasync def div_with_random_bus_stalls(dut):\n    \"\"\"The load/div/store mix above under random ~22% imem+dmem stalls, for\n    several seeds. Checks every retirement field the DIV path touches and\n    that rvfi_order stays strictly +1.\"\"\"\n    program = [\n        ADDI(2, 0, 7),\n        ADDI(4, 0, -13),\n        SW  (4, 0, 0),\n        LW  (1, 0, 0),\n        DIV (3, 1, 2),\n        LW  (5, 0, 0),\n        REM (6, 4, 2),\n        SW  (6, 0, 4),\n        LW  (7, 0, 4),\n        DIVU(8, 7, 2),\n        ADD (9, 8, 3),\n        MUL (10, 8, 2),         # MUL right behind a divide (shared multiplier)\n        DIV (11, 10, 2),        # dependent divide\n        EBREAK(),\n    ]\n    q = _div_ref(\"div\", -13, 7)\n    r = _div_ref(\"rem\", -13, 7)\n    u = _div_ref(\"divu\", r, 7)\n    m = (u * 7) & M32\n    d = _div_ref(\"div\", m, 7)\n    for seed in range(12):\n        # _run() resets the DUT itself; only start the clock once per test.\n        rets, dmem = await _run(dut, program, max_cycles=3000, stall_seed=seed,\n                                start_clock=(seed == 0))\n        tag = f\"seed={seed}\"\n        assert _by_insn(rets, DIV(3, 1, 2))[0][\"rd_wdata\"] == q, tag\n        d3 = _by_insn(rets, DIV(3, 1, 2))[0]\n        assert (d3[\"rs1_rdata\"], d3[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        d6 = _by_insn(rets, REM(6, 4, 2))[0]\n        assert d6[\"rd_wdata\"] == r, tag\n        assert (d6[\"rs1_rdata\"], d6[\"rs2_rdata\"]) == (-13 & M32, 7), tag\n        assert dmem.get(4) == r, tag\n        assert _by_insn(rets, DIVU(8, 7, 2))[0][\"rd_wdata\"] == u, tag\n        assert _by_insn(rets, ADD(9, 8, 3))[0][\"rd_wdata\"] == (u + q) & M32, tag\n        assert _by_insn(rets, MUL(10, 8, 2))[0][\"rd_wdata\"] == m, tag\n        assert _by_insn(rets, DIV(11, 10, 2))[0][\"rd_wdata\"] == d, tag\n        assert [x[\"pc\"] for x in rets] == [4 * i for i in range(len(program))], tag\n        _check_orders(rets)\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"divider.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "structuredPatch": [{"oldStart": 93, "oldLines": 7, "newStart": 93, "newLines": 8, "lines": ["     retirements: list[dict] = []", "     rng = random.Random(stall_seed) if stall_seed is not None else None", " ", "-    cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())", "+    if start_clock:", "+        cocotb.start_soon(Clock(dut.clock, 10, \"ns\").start())", " ", "     dut.reset.value = 1", "     dut.io_imemData.value = 0"]}], "userModified": false, "replaceAll": false}}
