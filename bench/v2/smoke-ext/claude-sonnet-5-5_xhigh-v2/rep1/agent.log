1\n    return saved\nfor tb in (4,5,6,7,8):\n    s=run(tb,4); print('bimodal',1<<tb,'saved/instr %.4f'%(s/cnt), 'pct of redirects %.1f'%(100*s/base_red))\nprint('no RAS 64', run(6,4,use_ras=False)/cnt)\nfor h in (2,4,6):\n    s=run(8,4,hist=h); print('gshare256 hist',h,'saved/instr %.4f'%(s/cnt))\nprint('ras 8', run(6,8)/cnt, 'ras 2', run(6,2)/cnt)\nEOF\npython3 $TMPDIR/pred.py $TMPDIR/ev.pkl","uuid":"6844e2b0-6c5c-46af-9dd5-cfcb43d9db39","session_id":"7b1e97de-d89b-4a8a-930a-7e570581fb2d"}
