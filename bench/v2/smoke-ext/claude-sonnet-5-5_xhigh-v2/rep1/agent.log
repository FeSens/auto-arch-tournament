(rtl_dir: Path) -> list[Path]:\n46:    srcs = sorted(rtl_dir.glob(\"*.sv\"))\n47:    pkg = rtl_dir / \"core_pkg.sv\"\n51:def project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n52:    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n148:def build(worktree: str | Path, rtl_dir: str | Path, bench_sv: str,\n150:    worktree, rtl_dir, outdir = Path(worktree).resolve(), Path(rtl_dir).resolve(), Path(outdir).resolve()\n153:    (outdir / \"build.tcl\").write_text(project_tcl(worktree, rtl_dir, bench_sv, place_option))\n170:def build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\n174:        futs = [ex.submit(build, worktree, rtl_dir, bench_sv, p,\n213:    res = build_all(wt, wt / \"cores\" / a.target / \"rtl\", _bench_sv(str(wt), a.target),\nformal/checks.cfg:26:# RISCV_FORMAL_ALTOPS — fast mode. Substitutes M-ext mul/div/rem with\nformal/checks.cfg:42:#   3. `make formal-deep` — same checks without ALTOPS. SLOW (~hours per\nformal/checks.cfg:45:`define RISCV_FORMAL_ALTOPS\nformal/checks-deep.cfg:26:# RISCV_FORMAL_ALTOPS — fast mode. Substitutes M-ext mul/div/rem with\nformal/checks-deep.cfg:42:#   3. `make formal-deep` — same checks without ALTOPS. SLOW (~hours per\nformal/checks_si.cfg:26:# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\nformal/checks_si.cfg:27:# the full rationale on what ALTOPS does and does not prove. M-extension\nformal/checks_si.cfg:29:`define RISCV_FORMAL_ALTOPS\nformal/run_all.sh:11:#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\nformal/run_all.sh:12:#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)", "is_error": false}]}, "parent_tool_use_id": null, "session_id": "5d95b1c8-e000-48b7-87d2-6f9a2fb11b69", "uuid": "13d35df1-c32b-4aca-a818-65eee783f65a", "timestamp": "2026-10-01T08:52:54.775Z", "tool_use_result": {"stdout": "62:  RTL_DIR    := cores/$(TARGET)/rtl\n77:\t@echo \"  make lint TARGET=v1     — verila