0) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b00100\n…[7688 of 10760 chars elided by tools/bench/transcript.py; sha256:526f919346c473d8]…\nets[3][\"cycle\"] - rets[2][\"cycle\"] == 1\n    assert rets[2][\"cycle\"] - rets[1][\"cycle\"] >= 32\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\nasync def _multiply_retime_case(dut, stalled):\n    \"\"\"All product forms feed the next EX instruction, memory, and recovery.\"\"\"\n    program = [\n        LUI(1, 0x80000000),\n        ADDI(2, 0, -1),\n        MULH(3, 1, 2),       # signed INT_MIN * -1: high = 0\n        MULHU(4, 1, 2),      # unsigned: high = 0x7fffffff\n        MULHSU(5, 1, 2),     # signed * unsigned: high = 0x80000000\n        MUL(6, 4, 5),        # consumes both preceding products\n        ADDI(7, 6, 1),       # consumes the low product immediately\n        MUL(8, 7, 2),\n        SW(8, 0, 0),         # store forwards the preceding product\n        LW(9, 0, 0),\n        BEQ(9, 8, 8),        # load-use and a taken correction\n        MUL(10, 1, 2),      # wrong path: must never retire\n        MUL(11, 8, 2),\n        ADDI(12, 11, -1),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(\n", "exit_code": 0, "status": "completed"}}
