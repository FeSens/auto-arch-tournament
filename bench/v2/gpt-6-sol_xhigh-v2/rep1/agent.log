ts\\ndirect unit tests and the RISCV_FORMAL_ALTOPS substitutes for formal checks,\\nwhile ensuring synthesis removes the unused combinational divider from core.\\nThe shorter timed EX path should raise Fmax enough to outweigh divide stalls.\\n\", \"expected_impact\": {\"fitness_delta_pct\": 35, \"confidence\": \"medium\"}, \"changes\": [{\"file\": \"rtl/ex_stage.sv\", \"description\": \"Add a s\n…[5949 of 9021 chars elided by tools/bench/transcript.py; sha256:df228a63035b81ca]…\nt and preserve all existing memory-stall and divide-stall controls.\"}, {\"file\": \"test/test_pipeline.py\", \"description\": \"Cover taken branches with apparent wrong-path load-use matches and simultaneous instruction or data stalls, checking the retirement sequence and memory effects.\"}], \"outcome\": \"regression\", \"fitness\": 109.49, \"delta_pct\": 19.92, \"vs_baseline\": 803.38, \"fmax_mhz\": 49.182, \"ipc_coremark\": 2e-06, \"cycles\": 4491817, \"iterations\": 10, \"lut4\": 2528, \"ff\": 663, \"seeds\": [49.587, 49.182, 49.182], \"perturbations\": [[0, 49.587, 13], [1, 49.182, 13], [2, 49.182, 13]], \"lutram\": 8, \"bsram\": 6, \"dsp\": 6, \"critical_path\": {\"from\": \"cpu/u_rf/regs_regs_0_0_s0\", \"to\": \"dmem_2_dmem_2_0_0_s\", \"slack_ns\": -15.167, \"arrival_ns\": 25.461, \"logic_cells\": 13, \"modules\": [\"clock_ibuf\", \"cpu/u_id\", \"cpu/u_ex\", \"cpu/u_ex/u_alu\", \"cpu/u_ex\"]}, \"logic_levels\": 13, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-09-29T10:46:48.141014Z\", \"slot\": 0, \"round_id\": 2}\n", "exit_code": 0, "status": "completed"}}
