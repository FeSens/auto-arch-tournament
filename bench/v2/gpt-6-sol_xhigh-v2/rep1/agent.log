{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -c \"sed -n '112,155p' cores/bench/rtl/mem_stage.sv && sed -n '1,45p' cores/bench/rtl/wb_stage.sv && sed -n '140,175p' cores/bench/rtl/core_pkg.sv\"","aggregated_output":"    endcase\n\n    // RVFI ALIGNED_MEM expects word-aligned mem_addr; mem_addr=0 if no access.\n    aligned_addr = (mem_op && !mem_misalign)\n                 ? {in.effective_addr[31:2], 2'b00}\n                 : 32'b0;\n  end\n  assign next_reg_write = ctrl_with_trap.reg_write;\n\n  // ── MEM/WB register ───────────────────────────────────────────────────\n  mem_wb_t reg_q;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      reg_q <= '0;\n    end else if (hold_wb) begin\n      // Clear valid (no double-retire / no double-regfile-write), but\n      // KEEP every other field. Forwarding from MEM/WB to a stalled\n      // dependent in ID/EX needs the held LOAD's rd/write_result/ctrl\n      // alive for as many cycles as the dmem stall lasts.\n      reg_q.valid <= 1'b0;\n    end else begin\n      reg_q.pc         <= in.pc;\n      reg_q.write_result <= in.ctrl.mem_to_reg ? load_data : selected_result;\n      reg_q.rd         <= in.rd;\n      reg_q.rs1_addr   <= in.rs1_addr;\n      reg_q.rs2_addr   <= in.rs2_addr;\n      reg_q.rs1_val    <= in.rs1_val;\n      reg_q.rs2_val    <= in.rs2_val;\n      reg_q.pc_next    <= resolved_pc;\n      reg_q.mem_addr   <= aligned_addr;\n      reg_q.mem_rdata  <= dmem_rdata;\n      reg_q.mem_wdata  <= wdata_rep;\n      reg_q.mem_wmask  <= (in.ctrl.mem_write && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.mem_rmask  <= (in.ctrl.mem_read  && !mem_misalign) ? byte_mask : 4'b0000;\n      reg_q.ctrl       <= ctrl_with_trap;\n      reg_q.instr      <= in.instr;\n      reg_q.valid      <= in.valid;\n    end\n  end\n\n  assign out = reg_q;\n\nendmodule\n// rtl/wb_stage.sv\n//\n// Write-back stage. The selected register value was captured in MEM/WB.\n// This stage drives the regfile write port; the regfile drops x0 writes.\n//\n// Latency:        combinational.\n// RVFI fields:    feeds rd_wdata (= w_data when w_en=1, else 0).\nmodule wb_stage (\n  // mem_wb_t fields beyond reg_write/rd/write_result\n  // (pc, mem_*, rs?_*, instr) are RVFI-only and read at top level.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  mem_wb_t  in,\n  /* verilator lint_on UNUSEDSIGNAL */\n  output logic               w_en,\n  output logic [4:0]         w_addr,\n  output logic [31:0]        w_data\n);\n\n  always_comb begin\n    w_en   = in.ctrl.reg_write && in.valid;\n    w_addr = in.rd;\n    w_data = in.write_result;\n  end\n\nendmodule\n    logic        valid;\n  } ex_mem_t;\n\n  // MEM/WB register payload — mirrors the RVFI-feeding contract.\n  typedef struct packed {\n    logic [31:0] pc;\n    logic [31:0] write_result;   // selected ALU/link or extended load value\n    logic [4:0]  rd;\n    logic [4:0]  rs1_addr;\n    logic [4:0]  rs2_addr;\n    logic [31:0] rs1_val;\n    logic [31:0] rs2_val;\n    logic [31:0] pc_next;\n    logic [31:0] mem_addr;       // word-aligned for RVFI ALIGNED_MEM\n    logic [31:0] mem_rdata;      // raw memory word\n    logic [31:0] mem_wdata;      // replicated byte-lane write data\n    logic [3:0]  mem_wmask;\n    logic [3:0]  mem_rmask;\n    ctrl_t       ctrl;\n    logic [31:0] instr;\n    logic        valid;\n  } mem_wb_t;\n\n`endif // CORE_PKG_DEFINED\n","exit_code":0,"status":"completed"}}
