signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b00100\n…[12918 of 15990 chars elided by tools/bench/transcript.py; sha256:e0fd03edf0cba820]…\n       # 40: wrong-path EX store\n        LW(10, 0, 0),          # 44\n        LW(11, 0, 4),          # 48\n        EBREAK(),              # 52\n    ]\n    initial = {0: 0x11223344, 4: 0x55667788}\n    rets, dmem = await _run(\n        dut, program, dmem_init=initial, max_cycles=180,\n        imem_stall_cycles={c for c in range(120) if c % 7 in (2, 3)}\n            if stalled else None,\n        dmem_stall_cycles={c for c in range(120) if c % 5 in (1, 2)}\n            if stalled else None,\n    )\n    _assert_rvfi_chain(rets, [0, 4, 8, 24, 36, 44, 48, 52])\n    assert dmem == initial, f\"wrong-path store changed memory: {dmem}\"\n    assert rets[3][\"pc_next\"] == 36\n    assert rets[4][\"pc_next\"] == 44\n    assert (rets[5][\"rd_wdata\"], rets[6][\"rd_wdata\"]) == (\n        initial[0], initial[4])\n\n\n@cocotb.test()\nasync def registered_recovery_squashes_younger_work(dut):\n    await _registered_recovery_case(dut, False)\n\n\n@cocotb.test()\nasync def registered_recovery_with_bus_stalls(dut):\n    await _registered_recovery_case(dut, True)\n\n", "exit_code": 0, "status": "completed"}}
