{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"sed -n '190,270p' cores/bench/test/test_pipeline.py\"","aggregated_output":"    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\ndef _assert_rvfi_chain(retirements, pcs):\n    \"\"\"Every retired instruction has one order and leads to the next PC.\"\"\"\n    assert [r[\"pc\"] for r in retirements] == pcs\n    assert [r[\"order\"] for r in retirements] == list(range(len(pcs)))\n    assert [r[\"pc_next\"] for r in retirements[:-1]] == pcs[1:]\n    assert all(r[\"trap\"] == 0 for r in retirements)\n\n\n@cocotb.test()\nasync def replay_short_loop_during_imem_stall(dut):\n    \"\"\"A warmed two-instruction loop keeps retiring with imem unavailable.\"\"\"\n    program = [\n        ADDI(1, 0, 0),\n        ADDI(2, 0, 20),\n        ADDI(1, 1, 1),\n        BNE(1, 2, -4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=180,\n                         imem_stall_cycles=set(range(12, 46)))\n    _assert_rvfi_chain(rets, [0, 4] + [pc for _ in range(20) for pc in (8, 12)] + [16])\n    assert sum(20 <= r[\"cycle\"] < 46 and r[\"pc\"] in (8, 12) for r in rets) >= 4\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 8] == list(range(1, 21))\n\n\n@cocotb.test()\nasync def replay_tag_collision_stalls_until_live_response(dut):\n    \"\"\"PC 0 and PC 64 share an index but must keep distinct upper tags.\"\"\"\n    program = [\n        ADDI(3, 3, 1),       # 0: second visit must execute this word\n        ADDI(1, 0, 64),      # 4\n        BEQ(3, 2, 8),        # 8: exit after PC 64 sets x2\n        JALR(0, 1, 0),       # 12\n        EBREAK(),           # 16\n    ] + [NOP()] * 11 + [\n        ADDI(2, 0, 2),       # 64: replaces PC 0 in the replay index\n        JAL(0, -68),        # 68: return to PC 0\n    ]\n    rets, _ = await _run(dut, program, max_cycles=110,\n                         imem_stall_cycles=set(range(6, 36)))\n    _assert_rvfi_chain(rets, [0, 4, 8, 12, 64, 68, 0, 4, 8, 16])\n    assert rets[6][\"cycle\"] >= 36\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 0] == [1, 2]\n\n\n@cocotb.test()\nasync def completed_code_store_invalidates_replay(dut):\n    \"\"\"A stored instruction replaces a cached JAL before the next visit.\"\"\"\n    replacement = ADDI(3, 0, 7)\n    program = [\n        JAL(0, 64),          # 0: fill the old PC 64 word\n        LW(1, 0, 128),       # 4: load the replacement instruction\n        SW(1, 0, 64),        # 8: overwrite PC 64\n        NOP(), NOP(), NOP(),\n        JAL(0, 40),          # 24: revisit PC 64 after store completion\n    ] + [NOP()] * 9 + [\n        JAL(0, -60),         # 64: old word jumps back to PC 4\n        EBREAK(),           # 68: reachable after the code store\n    ]\n    stalls_left = 8\n\n    def stall_after_store(_cycle, addr, imem, _dmem):\n        nonlocal stalls_left\n        if addr == 64 and imem[64] == replacement and stalls_left:\n            stalls_left -= 1\n            return True\n        return False\n\n    rets, dmem = await _run(\n        dut, program, dmem_init={128: replacement}, max_cycles=120,\n        imem_stall_when=stall_after_store, stores_update_imem=True,\n    )\n    _assert_rvfi_chain(rets, [0, 64, 4, 8, 12, 16, 20, 24, 64, 68])\n    assert stalls_left == 0\n    assert rets[-2][\"insn\"] == replacement\n    assert rets[-2][\"rd_wdata\"] == 7\n    assert dmem[64] == replacement\n","exit_code":0,"status":"completed"}}
