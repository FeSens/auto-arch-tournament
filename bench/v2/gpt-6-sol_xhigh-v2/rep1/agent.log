gned imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b00100\n…[9401 of 12473 chars elided by tools/bench/transcript.py; sha256:504de616c8ebc293]…\n           if stalled else None,\n        dmem_stall_cycles={c for c in range(80) if c % 5 == 2}\n            if stalled else None,\n    )\n    _assert_rvfi_chain(rets, [4 * i for i in range(len(program))])\n    assert {r[\"rd\"]: r[\"rd_wdata\"] for r in rets if r[\"rd\"]} == {\n        1: 0x55, 2: 0x58, 3: 0x0d, 4: 0x08, 5: 0x20,\n        6: 0x13, 7: 1, 8: 0xfffffff0, 9: 0xfffffffc, 10: 1,\n    }\n    if not stalled:\n        assert all(b[\"cycle\"] - a[\"cycle\"] == 1\n                   for a, b in zip(rets, rets[1:]))\n\n\n@cocotb.test()\nasync def registered_result_banks_forward(dut):\n    await _registered_result_banks_case(dut, False)\n\n\n@cocotb.test()\nasync def registered_result_banks_with_bus_stalls(dut):\n    await _registered_result_banks_case(dut, True)\n\n\n@cocotb.test()\nasync def forwarding_mem_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; NOP; ADDI x2, x1, 3 — rs1 forward from MEM/WB stage.\"\"\"\n    program = [ADDI(1, 0, 5), NOP(), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n", "exit_code": 0, "status": "completed"}}
