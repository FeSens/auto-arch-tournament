{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/bash -c \"sed -n '265,370p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    )\n    _assert_rvfi_chain(rets, [0, 64, 4, 8, 12, 16, 20, 24, 64, 68])\n    assert stalls_left == 0\n    assert rets[-2][\"insn\"] == replacement\n    assert rets[-2][\"rd_wdata\"] == 7\n    assert dmem[64] == replacement\n\n\n@cocotb.test()\nasync def iterative_divide_retirement(dut):\n    \"\"\"All divide forms, forwarded operands, consecutive divides and corners.\"\"\"\n    program = [\n        ADDI(1, 0, -20),\n        ADDI(2, 0, 3),\n        DIV(3, 1, 2),       # signed -20 / 3 rounds toward zero\n        ADDI(4, 3, 1),      # uses the just-completed quotient\n        REM(5, 1, 2),\n        DIVU(6, 1, 2),\n        REMU(7, 1, 2),\n        DIV(8, 1, 0),       # divide by zero\n        REM(9, 1, 0),\n        LUI(10, 0x80000000),\n        ADDI(11, 0, -1),\n        DIV(12, 10, 11),    # INT_MIN / -1\n        REM(13, 10, 11),\n        ADDI(14, 13, 7),    # dependent on final remainder\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=500)\n    assert [r[\"pc\"] for r in rets] == [4 * i for i in range(len(program))]\n    assert [r[\"order\"] for r in rets] == list(range(len(program)))\n    expected = {\n        3: 0xFFFFFFFA,\n        4: 0xFFFFFFFB,\n        5: 0xFFFFFFFE,\n        6: (0xFFFFFFEC // 3),\n        7: (0xFFFFFFEC % 3),\n        8: 0xFFFFFFFF,\n        9: 0xFFFFFFEC,\n        12: 0x80000000,\n        13: 0,\n        14: 7,\n    }\n    for rd, value in expected.items():\n        [ret] = [r for r in rets if r[\"rd\"] == rd]\n        assert ret[\"rd_wdata\"] == value, f\"x{rd}: {ret['rd_wdata']:#x} != {value:#x}\"\n        assert ret[\"trap\"] == 0\n    # Every DIV/REM must wait for its iterative result, and the younger\n    # instruction must retire exactly once after that wait.\n    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 1\n    assert rets[2][\"cycle\"] - rets[1][\"cycle\"] >= 32\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\nasync def _multiply_retime_case(dut, stalled):\n    \"\"\"All product forms feed the next EX instruction, memory, and recovery.\"\"\"\n    program = [\n        LUI(1, 0x80000000),\n        ADDI(2, 0, -1),\n        MULH(3, 1, 2),       # signed INT_MIN * -1: high = 0\n        MULHU(4, 1, 2),      # unsigned: high = 0x7fffffff\n        MULHSU(5, 1, 2),     # signed * unsigned: high = 0x80000000\n        MUL(6, 4, 5),        # consumes both preceding products\n        ADDI(7, 6, 1),       # consumes the low product immediately\n        MUL(8, 7, 2),\n        SW(8, 0, 0),         # store forwards the preceding product\n        LW(9, 0, 0),\n        BEQ(9, 8, 8),        # load-use and a taken correction\n        MUL(10, 1, 2),      # wrong path: must never retire\n        MUL(11, 8, 2),\n        ADDI(12, 11, -1),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(\n        dut, program, max_cycles=180,\n        imem_stall_cycles={c for c in range(100) if c % 7 in (2, 3)}\n            if stalled else None,\n        dmem_stall_cycles={c for c in range(100) if c % 4 in (1, 2)}\n            if stalled else None,\n    )\n    _assert_rvfi_chain(rets, [4 * i for i in range(11)] + [48, 52, 56])\n    assert dmem[0] == 0x7fffffff\n    assert {r[\"rd\"]: r[\"rd_wdata\"] for r in rets if r[\"rd\"]} == {\n        1: 0x80000000, 2: 0xffffffff, 3: 0,\n        4: 0x7fffffff, 5: 0x80000000, 6: 0x80000000,\n        7: 0x80000001, 8: 0x7fffffff, 9: 0x7fffffff,\n        11: 0x80000001, 12: 0x80000000,\n    }\n    assert rets[10][\"pc_next\"] == 48\n    if not stalled:\n        # The EX/MEM product bypass adds no cycle to dependent operations.\n        assert rets[5][\"cycle\"] - rets[4][\"cycle\"] == 1\n        assert rets[6][\"cycle\"] - rets[5][\"cycle\"] == 1\n\n\n@cocotb.test()\nasync def multiply_forwarding_and_recovery(dut):\n    await _multiply_ret