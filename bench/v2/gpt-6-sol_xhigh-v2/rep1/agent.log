{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -c \"sed -n '1,70p' cores/bench/rtl/forward_operand.sv; git diff --check; git status --short\"","aggregated_output":"// Select a registered EX/MEM result bank or the WB / held ID/EX value.\n// Exactly one enable is registered per operand at the ID/EX boundary.\nmodule forward_operand (\n  input  logic [14:0] enable,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  ex_mem_t     banks,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic [31:0] wb_value,\n  input  logic [31:0] held_value,\n  output logic [31:0] value\n);\n  logic [31:0] class_value;\n  logic [31:0] other_value;\n\n  assign class_value =\n      ({32{enable[FWD_SUB]}} & banks.sub_result) |\n      ({32{enable[FWD_LOGIC]}} & banks.logic_result) |\n      ({32{enable[FWD_SHIFT]}} & banks.shift_result) |\n      ({32{enable[FWD_COMPARE]}} & {31'b0, banks.compare_result}) |\n      ({32{enable[FWD_LUI]}} & banks.lui_result) |\n      ({32{enable[FWD_LINK]}} & banks.link_result);\n`ifdef RISCV_FORMAL_ALTOPS\n  assign other_value = {32{enable[FWD_ALT]}} & banks.alt_result;\n`else\n  assign other_value =\n      ({32{enable[FWD_MULHU]}} & banks.mulhu_result) |\n      ({32{enable[FWD_DIV]}} & banks.div_result);\n`endif\n  // ADD and multiply products stay directly connected to the final OR.\n  assign value = (class_value | other_value) |\n      ({32{enable[FWD_ADD]}} & banks.add_result) |\n`ifndef RISCV_FORMAL_ALTOPS\n      ({32{enable[FWD_MUL]}} & banks.mul_result) |\n      ({32{enable[FWD_MULH]}} & banks.mulh_result) |\n      ({32{enable[FWD_MULHSU]}} & banks.mulhsu_result) |\n`endif\n      ({32{enable[FWD_WB]}} & wb_value) |\n      ({32{enable[FWD_HELD]}} & held_value);\nendmodule\n M cores/bench/rtl/core.sv\n M cores/bench/rtl/core_pkg.sv\n M cores/bench/rtl/ex_stage.sv\n M cores/bench/rtl/forward_operand.sv\n M cores/bench/test/test_pipeline.py\n","exit_code":0,"status":"completed"}}
