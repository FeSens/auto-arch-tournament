20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b00100\n…[6666 of 9738 chars elided by tools/bench/transcript.py; sha256:ce6e0038039b2144]…\ncted = {\n        3: 0xFFFFFFFA,\n        4: 0xFFFFFFFB,\n        5: 0xFFFFFFFE,\n        6: (0xFFFFFFEC // 3),\n        7: (0xFFFFFFEC % 3),\n        8: 0xFFFFFFFF,\n        9: 0xFFFFFFEC,\n        12: 0x80000000,\n        13: 0,\n        14: 7,\n    }\n    for rd, value in expected.items():\n        [ret] = [r for r in rets if r[\"rd\"] == rd]\n        assert ret[\"rd_wdata\"] == value, f\"x{rd}: {ret['rd_wdata']:#x} != {value:#x}\"\n        assert ret[\"trap\"] == 0\n    # Every DIV/REM must wait for its iterative result, and the younger\n    # instruction must retire exactly once after that wait.\n    assert rets[3][\"cycle\"] - rets[2][\"cycle\"] == 1\n    assert rets[2][\"cycle\"] - rets[1][\"cycle\"] >= 32\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\nasync def _multiply_retime_case(dut, stalled):\n    \"\"\"All product forms feed the next EX instruction, memory, and recovery.\"\"\"\n    program = [\n        LUI(1, 0x80000000),\n        ADDI(2, 0, -1),\n        MULH(3, 1, 2),       # signed INT_MIN * -1: high = 0\n", "exit_code": 0, "status": "completed"}}
