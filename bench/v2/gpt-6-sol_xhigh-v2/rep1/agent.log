{"type": "item.completed", "item": {"id": "item_12", "type": "command_execution", "command": "/bin/bash -c \"sed -n '520,715p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "@cocotb.test()\nasync def trained_branch_direction_and_recovery(dut):\n    \"\"\"The same BNE is taken twice, then falls through after taken training.\"\"\"\n    program = [\n        ADDI(1, 0, 0),\n        ADDI(2, 0, 3),\n        ADDI(1, 1, 1),\n        BNE(1, 2, -4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 8, 12, 8, 12, 16]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert [r[\"pc_next\"] for r in rets if r[\"pc\"] == 12] == [8, 8, 16]\n    assert all(r[\"trap\"] == 0 for r in rets)\n    # The first taken branch changes its counter from weak not-taken to\n    # weak taken. Its next encounter reaches the target without recovery;\n    # the final not-taken outcome then needs a correction of its own.\n    first_taken_gap = rets[4][\"cycle\"] - rets[3][\"cycle\"]\n    trained_taken_gap = rets[6][\"cycle\"] - rets[5][\"cycle\"]\n    final_fallthrough_gap = rets[8][\"cycle\"] - rets[7][\"cycle\"]\n    assert trained_taken_gap < first_taken_gap\n    assert trained_taken_gap < final_fallthrough_gap\n\n\n@cocotb.test()\nasync def misaligned_control_targets_fall_through(dut):\n    \"\"\"Taken branch, JAL, and JALR faults retire once at sequential PCs.\"\"\"\n    program = [\n        BEQ(0, 0, 6),\n        JAL(1, 6),\n        ADDI(5, 0, 14),\n        JALR(1, 5, 0),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    assert [r[\"pc\"] for r in rets] == [0, 4, 8, 12, 16]\n    assert [r[\"pc_next\"] for r in rets] == [4, 8, 12, 16, 20]\n    assert [r[\"trap\"] for r in rets] == [1, 1, 0, 1, 0]\n    assert rets[1][\"rd\"] == rets[3][\"rd\"] == 0\n\n\n@cocotb.test()\nasync def branch_correction_during_both_bus_stalls(dut):\n    \"\"\"A branch held behind a store keeps i