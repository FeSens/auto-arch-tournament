branch_train_index),\n     .branch_train_taken (branch_train_taken)\n@@ -188,7 +187,7 @@ module core (\n     .id_ex_rd       (id_ex_w.rd),\n     .if_id_rs1      (if_id_w.instr[19:15]),\n     .if_id_rs2      (if_id_w.instr[24:20]),\n-    .redirect       (redirect),\n+    .redirect       (mem_correction),\n     .imem_ready     (io_imemReady),\n     .dmem_\n…[6592 of 9664 chars elided by tools/bench/transcript.py; sha256:1c527906c73ce90d]…\nes precedence over load_use's bubble: re-evaluate\n     // load_use next cycle when the bus unblocks. flush_id is 1 only when\n     // we want bubble (not hold).\n-    stall_id      = dmem_stall || divide_hold || load_use_hazard;\n-    flush_id      = (load_use_hazard || redirect) && !dmem_stall && !divide_hold;\n+    stall_id      = !redirect && (dmem_stall || divide_hold || load_use_hazard);\n+    flush_id      = redirect || (load_use_hazard && !dmem_stall && !divide_hold);\n     // EX/MEM register: holds on dmem_stall (LOAD waits in MEM until the\n     // bus delivers).\n-    stall_ex_mem  = dmem_stall;\n+    stall_ex_mem  = !redirect && dmem_stall;\n     // MEM/WB register: on dmem_stall the previously-retired instruction's\n     // data fields stay alive for forwarding (e.g. a held BNE needs the\n     // LOAD's load_data via fwd_mem_wb), but valid is cleared so we don't\n     // double-retire / double-write the regfile.\n-    hold_mem_wb   = dmem_stall;\n+    hold_mem_wb   = !redirect && dmem_stall;\n   end\n \n endmodule\n", "exit_code": 0, "status": "completed"}}
