{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,time,collections\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM(); cpu.load_elf('bench/programs/coremark.elf')\nactive=False; branches=[]; jalrs=0; insns=0; started=time.time()\nfor step in range(10000000):\n    r=cpu.step()\n    if r is None: break\n    if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True; continue\n    if r['mem_wmask'] and r['mem_addr']==0x10000104: break\n    if not active: continue\n    insns+=1\n    insn=r['insn']; op=insn&127\n    if op==0x63 and r['trap']==0: branches.append((r['pc'],int(r['npc']\"'!=r['\"'pc']+4)))\n    if op==0x67 and r['trap']==0: jalrs+=1\nelse: print('LIMIT')\nprint('retired',insns,'branches',len(branches),'jalrs',jalrs,'time',round(time.time()-started,1),flush=True)\nfor n in (32,64,128,256,512):\n    p=[1]*n; misses=0\n    for pc,taken in branches:\n        i=(pc>>2)&(n-1); v=p[i]\n        misses+=(v>>1)\"'!=taken\n        p[i]=min(3,v+1) if taken else max(0,v-1)\n    print('\"'bimodal',n,misses,round(100*misses/len(branches),2),flush=True)\nfor bits in (4,5,6,7,8,9):\n    n=1<<bits; p=[1]*n; hist=0; misses=0\n    for pc,taken in branches:\n        i=((pc>>2)\"'^hist)&(n-1); v=p[i]\n        misses+=(v>>1)!=taken\n        p[i]=min(3,v+1) if taken else max(0,v-1)\n        hist=((hist<<1)|taken)&(n-1)\n    print('\"'gshare',n,misses,round(100*misses/len(branches),2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
