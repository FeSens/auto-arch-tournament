0) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b00100\n…[7820 of 10892 chars elided by tools/bench/transcript.py; sha256:b918c50615cdb27a]…\nhain(rets, [0, 4, 8, 12, 64, 68, 0, 4, 8, 16])\n    assert rets[6][\"cycle\"] >= 36\n    assert [r[\"rd_wdata\"] for r in rets if r[\"pc\"] == 0] == [1, 2]\n\n\n@cocotb.test()\nasync def completed_code_store_invalidates_replay(dut):\n    \"\"\"A stored instruction replaces a cached JAL before the next visit.\"\"\"\n    replacement = ADDI(3, 0, 7)\n    program = [\n        JAL(0, 64),          # 0: fill the old PC 64 word\n        LW(1, 0, 128),       # 4: load the replacement instruction\n        SW(1, 0, 64),        # 8: overwrite PC 64\n        NOP(), NOP(), NOP(),\n        JAL(0, 40),          # 24: revisit PC 64 after store completion\n    ] + [NOP()] * 9 + [\n        JAL(0, -60),         # 64: old word jumps back to PC 4\n        EBREAK(),           # 68: reachable after the code store\n    ]\n    stalls_left = 8\n\n    def stall_after_store(_cycle, addr, imem, _dmem):\n        nonlocal stalls_left\n        if addr == 64 and imem[64] == replacement and stalls_left:\n            stalls_left -= 1\n            return True\n        return False\n", "exit_code": 0, "status": "completed"}}
