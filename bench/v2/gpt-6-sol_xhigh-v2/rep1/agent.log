gned imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b00100\n…[9453 of 12525 chars elided by tools/bench/transcript.py; sha256:40930e6942dbdce3]…\nQ(0, 0, 8),\n        ADDI(1, 0, 99),\n        ADDI(2, 0, 7),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program,\n                         imem_stall_cycles={1, 2, 3},\n                         dmem_stall_cycles={1, 2, 3})\n    assert [r[\"pc\"] for r in rets] == [0, 4, 12, 16]\n    assert [r[\"pc_next\"] for r in rets] == [4, 12, 16, 20]\n    assert [r[\"order\"] for r in rets] == list(range(len(rets)))\n    assert rets[2][\"rd_wdata\"] == 7\n\n\n@cocotb.test()\nasync def sw_lw_roundtrip(dut):\n    \"\"\"ADDI x1, 0xCAFE; SW x1; LW x2 — verify x2 sees the freshly stored word.\"\"\"\n    val = 0x123  # signed 12-bit fits\n    program = [\n        ADDI(1, 0, val),\n        SW  (1, 0, 0),\n        LW  (2, 0, 0),\n        EBREAK(),\n    ]\n    rets, dmem = await _run(dut, program)\n    [r2] = _by_insn(rets, LW(2, 0, 0))\n    assert r2[\"rd_wdata\"] == val, f\"x2 expected {val:#x}, got 0x{r2['rd_wdata']:x}\"\n    assert dmem.get(0) == val\n\n\n@cocotb.test()\nasync def illegal_traps(dut):\n    \"\"\"0xFFFFFFFF retires with rvfi_trap=1 and no rd write.\n", "exit_code": 0, "status": "completed"}}
