{"type": "item.completed", "item": {"id": "item_16", "type": "command_execution", "command": "/bin/bash -c \"sed -n '260,680p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    rets, dmem = await _run(\n        dut, program, max_cycles=180,\n        imem_stall_cycles={c for c in range(100) if c % 7 in (2, 3)}\n            if stalled else None,\n        dmem_stall_cycles={c for c in range(100) if c % 4 in (1, 2)}\n            if stalled else None,\n    )\n    _assert_rvfi_chain(rets, [4 * i for i in range(11)] + [48, 52, 56])\n    assert dmem[0] == 0x7fffffff\n    assert {r[\"rd\"]: r[\"rd_wdata\"] for r in rets if r[\"rd\"]} == {\n        1: 0x80000000, 2: 0xffffffff, 3: 0,\n        4: 0x7fffffff, 5: 0x80000000, 6: 0x80000000,\n        7: 0x80000001, 8: 0x7fffffff, 9: 0x7fffffff,\n        11: 0x80000001, 12: 0x80000000,\n    }\n    assert rets[10][\"pc_next\"] == 48\n    if not stalled:\n        # The EX/MEM product bypass adds no cycle to dependent operations.\n        assert rets[5][\"cycle\"] - rets[4][\"cycle\"] == 1\n        assert rets[6][\"cycle\"] - rets[5][\"cycle\"] == 1\n\n\n@cocotb.test()\nasync def multiply_forwarding_and_recovery(dut):\n    await _multiply_retime_case(dut, False)\n\n\n@cocotb.test()\nasync def multiply_forwarding_with_bus_stalls(dut):\n    await _multiply_retime_case(dut, True)\n\n\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n    \"\"\"ADDI x1, x0, 5; ADDI x2, x1, 3 — back-to-back rs1 forward from EX/MEM.\"\"\"\n    program = [ADDI(1, 0, 5), ADDI(2, 1, 3), EBREAK()]\n    rets, _ = await _run(dut, program)\n    [r1] = _by_insn(rets, ADDI(1, 0, 5))\n    [r2] = _by_insn(rets, ADDI(2, 1, 3))\n    assert r1[\"rd\"] == 1 and r1[\"rd_wdata\"] == 5\n    assert r2[\"rd\"] == 2 and r2[\"rd_wdata\"] == 8, (\n        f\"x2 should be x1+3=8 via EX->EX forward, got 0x{r2['rd_wdata']:08x}\"\n    )\n    # Order must be strict +1.\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(orders[0], orders[0] + len(rets)))\n\n\nasync def _registered_result_banks_case(dut, stalled):\n    \"\"\"Consecutive arithmetic, logic, compare, and shift results forward.\"\"\"\n    program = [\n        ADDI(1, 0, 0x55),\n        ADDI(2, 1, 3),\n        XOR(3, 2, 1),\n        AND(4, 3, 2),\n        SLLI(5, 4, 2),\n        SUB(6, 5, 3),\n        SLT(7, \n…[10727 of 13799 chars elided by tools/bench/transcript.py; sha256:f17ed92d0af2c0fb]…\n(2, 0, 2),\n        ADDI(3, 0, 3),\n        ADDI(4, 0, 4),\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program)\n    orders = [r[\"order\"] for r in rets]\n    assert orders == list(range(len(orders))), f\"order not monotonic +1: {orders}\"\n\n\ndef test_pipeline_runner():\n    sources = [\n        \"core_pkg.sv\",\n        \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n        \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n        \"mem_stage.sv\", \"wb_stage.sv\",\n        \"hazard_unit.sv\", \"forward_unit.sv\",\n        \"core.sv\",\n    ]\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"core\"\n    runner.build(\n        sources=[str(RTL / name) for name in sources],\n        hdl_toplevel=\"core\",\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[f\"+incdir+{RTL}\", \"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=\"core\",\n        test_module=\"test_pipeline\",\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
