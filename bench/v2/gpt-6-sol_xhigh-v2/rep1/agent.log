(11, 0, -1),\n        DIV(12, 10, 11),    # INT_MIN / -1\n        REM(13, 10, 11),\n        ADDI(14, 13, 7),    # dependent on final remainder\n        EBREAK(),\n    ]\n    rets, _ = await _run(dut, program, max_cycles=500)\n    assert [r[\"pc\"] for r in rets] == [4 * i for i in range(len(program))]\n   \n…[8422 of 11494 chars elided by tools/bench/transcript.py; sha256:70b3c97707372099]…\n    [r2] = _by_insn(rets, ADD(2, 1, 4))\n    assert r2[\"rd_wdata\"] == 0x223, f\"x2 expected 0x223, got 0x{r2['rd_wdata']:08x}\"\n    assert dmem[0] == 0x123, f\"mem[0] should hold 0x123, got {dmem[0]:#x}\"\n\n\n@cocotb.test()\nasync def forwarding_selects_survive_memory_stall_and_release(dut):\n    \"\"\"A held ALU consumer keeps both WB bypasses through a stalled load.\"\"\"\n    program = [\n        ADDI(1, 0, 9),\n        LW(2, 0, 0),\n        ADD(3, 1, 1),        # held in EX; both operands need retained WB data\n        ADD(4, 3, 2),        # consumes the released ALU and load results\n        SW(4, 0, 4),\n        LW(5, 0, 4),\n        BEQ(5, 4, 8),        # load-use bubble, then a taken redirect\n        ADDI(7, 0, 99),     # wrong path\n        DIV(6, 5, 1),\n        ADD(7, 6, 4),       # consumes the completed divider result\n        EBREAK(),\n    ]\n    rets, dmem = await _run(\n        dut, program, dmem_init={0: 13}, max_cycles=140,\n        imem_stall_cycles=set(range(5, 12)),\n        dmem_stall_cycles=set(range(0, 20)),\n    )\n", "exit_code": 0, "status": "completed"}}
