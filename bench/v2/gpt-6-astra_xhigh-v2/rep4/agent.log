c_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5)] + [\n    (name, 32) for name in (\"rs1_val\", \"rs2_val\", \"pc_next\", \"mem_addr\", \"mem_rdata\", \"mem_wdata\")\n] + [(\n…[8911 of 11983 chars elided by tools/bench/transcript.py; sha256:79fd6412c357a379]…\nem[\"rd\"], mem_ctrl[\"reg_write\"], wb[\"rd\"], wb_ctrl[\"reg_write\"])\n                for source in (\"rs1\", \"rs2\"))\n            assert sample[\"fwd\"] == expected, (sample, expected)\n        next_fwd = tuple(_forward_reference((fetched[\"instr\"] >> shift) & 31,\n            saved[\"rd\"], sample[\"next_ex_write\"], mem[\"rd\"], sample[\"next_wb_write\"])\n            for shift in (15, 20))\n        advancing = saved[\"valid\"] and not sample[\"stall_ex\"] and not sample[\"execute_wait\"]\n        # Original full-PC recovery predicate is the equivalence oracle.\n        assert sample[\"redirect\"] == bool(advancing and\n            sample[\"target\"] != saved[\"predicted_next_pc\"]), sample\n        assert fetched[\"instr\"] == (imem.get(ia, EBREAK()) if ir else NOP())\n        assert fetched[\"valid\"] == bool(ir and not sample[\"redirect\"])\n        assert int(dut.flush_if.value) == (not ir)\n        if sample[\"redirect\"]:\n            assert sample[\"flush_id\"] and not sample[\"stall_ex\"]\n        if trace is not None:\n            trace.append(sample)\n\n", "exit_code": 0, "status": "completed"}}
