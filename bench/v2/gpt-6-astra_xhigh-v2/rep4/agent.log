{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import parse_reports, summarize, critical_paths\nimport json, xml.etree.ElementTree as ET\nroot = Path('cores/bench/generated/timing')\nresults = [{\\\"place_option\\\": option, **parse_reports(root / f'gowin_p{option}')} for option in range(3)]\nsummary = summarize(results)\ncm = json.loads(Path('cores/bench/generated/coremark-validation.json').read_text())\nsummary['coremark'] = cm\nsummary['fitness_iter_s'] = summary['fmax_mhz'] * 1e6 * cm['iter_per_cycle']\nsummary['gain_percent'] = (summary['fitness_iter_s'] / 151.03 - 1) * 100\nsummary['acceptance_threshold'] = 157.97738\nsummary['exceeds_acceptance'] = summary['fitness_iter_s'] > 157.97738\nfor option in range(3):\n    build = root / f'gowin_p{option}'\n    resource = ET.parse(build / 'impl/gwsynthesis/core_bench_syn_rsc.xml').getroot()\n    cpu = next(node for node in resource.iter() if node.attrib.get('name') == 'cpu')\n    assert all('Bsram' not in node.attrib and 'T_Bsram' not in node.attrib for node in cpu.iter())\n    paths = critical_paths((build / 'impl/pnr/core_bench.tr').read_text(), 10000)\n    loop = [p for p in paths if any(name in p['to'] for name in ('/quotient_q', '/remainder_q'))]\n    print('option', option, 'reported loop paths', loop[:3])\n    assert not any('dmem' in p['from'] or 'bsram' in p['from'].lower() for p in loop)\nsummary['cpu_bsram'] = 0\nPath('cores/bench/generated/fitness-validation.json').write_text(json.dumps(summary, indent=2))\nprint(json.dumps(summary, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
