{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,260p' cores/bench/rtl/if_stage.sv\nrg --files cores/bench | head -100\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + prediction + valid) is combinational — no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // fetch not accepted\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // advancing EX recovery\n  input  logic [31:0]       redirect_target,\n  input  logic              branch_update,\n  // Only the table index bits are needed from the resolving branch PC.\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0]       branch_pc,\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic              branch_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [31:0] predicted_next_pc;\n  logic [31:0] direct_imm;\n  logic [31:0] direct_target;\n  logic        legal_branch;\n  logic        direct_jump;\n  logic [1:0]  counters [0:127];\n\n  // Untagged PC[8:2] bimodal direction table. Read-before-write is fine:\n  // both the PC and ID/EX capture the same pre-edge prediction.\n  // Update each counter locally: the table needs only its fetch read mux,\n  // rather than a second 128-way read mux for the saturating update.\n  for (genvar i = 0; i < 128; i++) begin : g_c\n…[1544 of 4616 chars elided by tools/bench/transcript.py; sha256:de486f2ae07c9d69]…\n   else if (!stall && !flush) pc <= predicted_next_pc;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out.pc    = pc;\n    out.predicted_next_pc = predicted_next_pc;\n    out.instr = (flush || redirect) ? 32'h0000_0013 : imem_data;\n    out.valid = !(flush || redirect);\n  end\n\nendmodule\ncores/bench/core.yaml\ncores/bench/rtl/decoder.sv\ncores/bench/rtl/forward_unit.sv\ncores/bench/rtl/imm_gen.sv\ncores/bench/rtl/mem_stage.sv\ncores/bench/rtl/alu.sv\ncores/bench/rtl/if_stage.sv\ncores/bench/rtl/reg_file.sv\ncores/bench/rtl/hazard_unit.sv\ncores/bench/rtl/id_stage.sv\ncores/bench/rtl/ex_stage.sv\ncores/bench/rtl/wb_stage.sv\ncores/bench/rtl/core.sv\ncores/bench/rtl/core_pkg.sv\ncores/bench/LESSONS.md\ncores/bench/CORE_PHILOSOPHY.md\ncores/bench/experiments/progress.png\ncores/bench/experiments/log.jsonl\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\n", "exit_code": 0, "status": "completed"}}
