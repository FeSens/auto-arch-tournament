{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nr=Path('cores/bench/generated/r6s1_research'); rtl=Path('cores/bench/rtl')\nfor name in ['core_pkg.sv','ex_stage.sv','mem_stage.sv']:\n (rtl/name).write_text((r/(name+'.original')).read_text())\n(r/'core.sv.original').write_text((rtl/'core.sv').read_text())\ns=(r/'alu.original.sv').read_text()\ns=s.replace('logic [1:0] dividend_prefix, quotient_prefix, remainder_prefix;','')\na=s.index('  assign dividend_prefix');b=s.index('  assign quotient_step[0]')\ns=s[:a]+s[b:]\ns=s.replace('quotient_step [0:5]','quotient_step [0:4]').replace('remainder_step [0:5]','remainder_step [0:4]').replace('trial [0:4]','trial [0:3]').replace('difference [0:4]','difference [0:3]').replace('i < 5','i < 4')\ns=s.replace('quotient_step[5]','quotient_step[4]').replace('remainder_step[5]','remainder_step[4]').replace(\\\"iteration == 3'd5\\\",\\\"iteration == 3'd7\\\").replace('{dividend_magnitude[29:0], quotient_prefix}','dividend_magnitude').replace(\\\"{30'b0, remainder_prefix}\\\",\\\"32'b0\\\")\n(rtl/'alu.sv').write_text(s)\ns=(rtl/'ex_stage.sv').read_text().replace('  output ex_mem_t  out,','  output ex_mem_t  out,\\\\n  output mem_wb_t divide_wb,')\ns=s.replace('end else if (execute_wait) begin','end else if (execute_wait || is_divide) begin')\ns=s.replace('  assign out = reg_q;','''  always_comb begin\n    divide_wb = '0;\n    divide_wb.pc = in.pc;\n    divide_wb.alu_result = alu_result;\n    divide_wb.rd = in.rd;\n    divide_wb.rs1_addr = in.rs1_addr;\n    divide_wb.rs2_addr = in.rs2_addr;\n    divide_wb.rs1_val = div_rs1_q;\n    divide_wb.rs2_val = div_rs2_q;\n    divide_wb.pc_next = in.pc + 32'd4;\n    divide_wb.ctrl = in.ctrl;\n    divide_wb.instr = in.instr;\n    divide_wb.valid = is_divide && advance;\n  end\n\n  assign out = reg_q;''')\n(rtl/'ex_stage.sv').write_text(s)\ns=(rtl/'core.sv').read_text().replace('  mem_wb_t mem_wb_w;','  mem_wb_t mem_wb_w;\\\\n  mem_wb_t divide_wb_w, retire_wb_w;\\\\n  assign retire_wb_w = divide_wb_w.valid ? divide_wb_w : mem_wb_w;')\ns=s.replace('.out             (ex_mem_w),','.out             (ex_mem_w),\\\\n    .divide_wb       (divide_wb_w),')\ns=s.replace('.in     (mem_wb_w)', '.in     (retire_wb_w)')\npos=s.index('  // ── RVFI')\ns=s[:pos]+s[pos:].replace('mem_wb_w','retire_wb_w')\n(rtl/'core.sv').write_text(s)\n(r/'test_alu.prefix4.py').write_text(Path('cores/bench/test/test_alu.py').read_text())\ns=(r/'test_alu.original.py').read_text().replace('range(6):','range(8):').replace('iteration == 5','iteration == 7').replace('iteration \"'!= 5'\"','iteration \"'!= 7'\"').replace('range(7):','range(9):')\nPath('cores/bench/test/test_alu.py').write_text(s)\nPY\nmake lint TARGET=bench\npython -m tools.eval.gowin bench --all-options > cores/bench/generated/r6s1_research/timing-direct.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
