))\n    pkg = rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[16770 of 19842 chars elided by tools/bench/transcript.py; sha256:9c0e010e3543c676]…\n   assert not held[\"valid\"] and held[\"alu_result\"] == expected\n1290:    dut.fwd_rs1_sel.value = 0\n1291:    dut.fwd_rs2_sel.value = 0\n1300:                dut.fwd_rs1_sel.value = source\n1347:                            alu_result=0xdeadbeef, write_data=0x1234abcd, ctrl=ctrl, rd=3)\n1356:                        assert out[\"alu_result\"] == 0xdeadbeef\n1367:                            assert out[\"read_data\"] == expected & MASK32\n1381:    dut.fwd_rs1_sel.value = 0\n1382:    dut.fwd_rs2_sel.value = 0\n1582:    dut.next_mem_wb_w_en.value = 0\n1584:    assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (0, 0)\n1593:        dut.next_mem_wb_w_en.value = 1\n1597:        assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (1, 2)\n1603:            assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (1, 2)\n1607:        assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (0, 0)\n1611:        assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (0, 0)\n1656:            \"mem_stage.sv\", \"wb_stage.sv\",\n", "exit_code": 0, "status": "completed"}}
