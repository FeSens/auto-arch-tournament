{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -c \"set -e\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/rtl/ex_stage.sv')\np.write_bytes(Path('/srv/hwebench/tmp/92f133a1/46322b65/r14-forward-backup/ex_stage.sv').read_bytes())\ns=p.read_text().replace('assign div_consume = is_divide && advance;', 'assign div_consume = div_done && \"'!normal_wb_valid && !stall && !reset;'\"')\np.write_text(s)\nPY\nmake lint TARGET=bench\npython3 -m tools.eval.gowin bench --all-options > /srv/hwebench/tmp/92f133a1/46322b65/r14-grant-timing.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
