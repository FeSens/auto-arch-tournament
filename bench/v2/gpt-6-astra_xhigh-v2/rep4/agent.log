{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport yaml\np=Path('cores/bench/rtl/core_pkg.sv');s=p.read_text().replace('logic [31:0] write_data;     // raw rs2','logic [31:0] effective_addr; // dedicated address-generator result\\\\n    logic [31:0] write_data;     // raw rs2');p.write_text(s)\np=Path('cores/bench/rtl/ex_stage.sv');s=p.read_text().replace('      reg_q.write_data    <= rs2;','      reg_q.effective_addr <= alu_a + alu_b;\\\\n      reg_q.write_data    <= rs2;');p.write_text(s)\np=Path('cores/bench/rtl/mem_stage.sv');s=p.read_text().replace('in.alu_result','in.effective_addr').replace('reg_q.alu_result <= in.effective_addr','reg_q.alu_result <= in.alu_result');p.write_text(s)\np=Path('cores/bench/experiments/hypotheses/hyp-20261002-002-r6s1.yaml'); d=yaml.safe_load(p.read_text())\nd['title']='Separate arithmetic completion from the memory pipeline'\nd['hypothesis']=d['hypothesis'].replace('Make one structural change: give the blocking divider a direct completion-\\\\nto-retirement route, and spend the reclaimed downstream cycles on eight\\\\niterations of four restoring steps. Ordinary instructions keep their current\\\\npipeline.', 'Make one structural change: specialize execution into an arithmetic\\\\ncompletion route and a dedicated effective-address pipeline. Give the\\\\nblocking divider a direct completion-to-retirement route, and spend its\\\\nreclaimed downstream cycles on eight iterations of four restoring steps.\\\\nOther instructions retain their current pipeline latency.')\nd['hypothesis']+='''\nComplete this path separation with a dedicated EX/MEM effective_addr field,\ncomputed by a simple forwarded base-plus-immediate adder independently of the\nselected general ALU result. MEM uses that field for dmem_addr, lane masks,\nmisalignment, load extraction and RVFI aligned memory address. Preserve the\nordinary ALU-result field for register writeback and bypassing. Non-memory\narithmetic results must not drive the physical data-memory address port.\nThis removes the register-file/multiplier-to-dmem path that becomes limiting\nafter the divider feedback is shortened. Preserve full 32-bit address\narithmetic, memory requests, byte lanes and existing memory-stall holds.\n'''\nd['changes'].insert(3,{'file':'rtl/core_pkg.sv','description':'Add a dedicated 32-bit effective_addr to EX/MEM, independent of the arithmetic result.'})\nd['changes'].insert(4,{'file':'rtl/mem_stage.sv','description':'Use the dedicated effective address for dmem addressing, alignment checks, byte lanes, load extraction and RVFI memory address. Preserve arithmetic writeback and every memory handshake.'})\nd['changes'][1]['description']+='\\\\nCapture effective_addr from a separate forwarded base-plus-immediate adder; do not derive it from the selected ALU/multiplier/divider result.'\np.write_text(yaml.safe_dump(d,sort_keys=False,width=84))\nPY\npython - <<'PY' > cores/bench/generated/r6s1_research/timing-separated.log 2>&1\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\nimport json\nwt=Path.cwd();r=build_all(wt,wt/'cores/bench/rtl','fpga/core_bench_si.sv',wt/'cores/bench/generated/r6s1_research/timing-separated')\nprint(json.dumps({'summary':summarize(r),'builds':r},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
