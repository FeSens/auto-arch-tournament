t is None:\n        return env\n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[21586 of 24658 chars elided by tools/bench/transcript.py; sha256:0645da4bd28fe87b]…\nL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DNRET=$NRET\" \\\n  \"${RTL_FILES[@]}\" \\\n  \"$COSIM_DIR/main.cpp\" \\\n  -o cosim_sim\n\necho \"Built: $OBJ_DIR/cosim_sim\"\n/srv/hwebench/tmp/92f133a1/afb1f242\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/venv/bin/pytest\n/srv/hwebench/toolchain/oss-cad-suite/bin/sby\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n/srv/hwebench/toolchain/oss-cad-suite/bin/bitwuzla\n/srv/hwebench/toolchain/bin/riscv32-unknown-elf-gcc\nls: cannot access '.toolchain': No such file or directory\n-rwxr-xr-x 1 nobody nogroup 24968 Jul 10  2025 /opt/gowin/IDE/bin/gw_sh\nlrwxrwxrwx 1 nobody nogroup    66 Oct  2 21:16 formal/riscv-formal -> /srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep4/formal/riscv-formal\n", "exit_code": 1, "status": "failed"}}
