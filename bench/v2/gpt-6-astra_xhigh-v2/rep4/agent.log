h and a load, but priority must not\n    # depend on removing raw wrong-path register addresses from decode.\n    for bits in range(128):\n        load, redirect, execute_wait, ir, dr, older, zero_rd = [\n            (bits >> bit) & 1 for bit in range(7)]\n        dut.id_ex_mem_read.value = load\n        dut.id_ex_rd.value = 0 if zero_rd else 5\n        dut.if_id_rs1.value = 5\n        dut.if_id_rs2.value = 0\n        dut.redirect.value = redirect\n        dut.execute_wait.value = execute_wait\n        dut.imem_ready.value = ir\n        dut.dmem_ready.value = dr\n        dut.ex_mem_mem_op.value = older\n        await Timer(1, \"ns\")\n        dhold = older and not dr\n        hazard = load and not zero_rd\n        assert int(dut.flush_if.value) == (not ir)\n        assert int(dut.stall_ex_mem.value) == dhold\n        assert int(dut.hold_mem_wb.value) == dhold\n        assert int(dut.stall_id.value) == bool(dhold or execute_wait or hazard)\n        assert int(dut.flush_id.value) == bool((redirect or hazard) and not dhold and not execute_wait)\n        assert int(dut.stall_if.value) == bool(hazard or not ir or dhold or execute_wait)\n\n\n@pytest.mark.parametrize(\"top,testcase\", [\n    (\"ex_stage\", \"unit_ex_token_equivalence\"),\n    (\"if_stage\", \"unit_if_guarded_token\"),\n    (\"id_stage\", \"unit_id_squash_beats_hold\"),\n    (\"hazard_unit\", \"unit_hazard_recovery_priority\"),\n    (\"mem_stage\", \"unit_mem_dedicated_address\"),\n])\ndef test_recovery_units_runner(top, testcase):\n    root = Path(__file__).resolve().parent.parent\n    sources = [root / \"rtl\" / \"core_pkg.sv\"] + sorted(\n        path for path in (root / \"rtl\").glob(\"*.sv\") if path.name != \"core_pkg.sv\")\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = root / \"sim_build\" / top\n    runner.build(sources=sources, hdl_toplevel=top, build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl