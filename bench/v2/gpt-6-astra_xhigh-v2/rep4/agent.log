sel.value = 2\n            dut.fwd_ex_mem.value = 0xfffffff1\n            dut.fwd_mem_wb.value = 7\n            dut[\"in\"].value = 0\n            await edge()\n            dut.reset.value = 0\n            insn = _r(1, 2, 1, funct3, rd, 0x33)\n            dut[\"in\"].value = _pack(ID_FIELDS, pc=0x80, predicted_next\n…[15868 of 18940 chars elided by tools/bench/transcript.py; sha256:d6461548ba1df5b1]…\n (0, 0)\n    dut.reset.value = 0\n    # Capture distinct selections, change every tag while held, then squash\n    # with capture disabled. Refill before testing reset plus capture.\n    for clear in (\"squash\", \"reset\"):\n        dut.capture.value = 1\n        dut.next_ex_mem_rd.value = 5\n        dut.next_mem_wb_rd.value = 7\n        dut.next_ex_mem_w_en.value = 1\n        dut.next_mem_wb_w_en.value = 1\n        dut.id_rs1.value = 5\n        dut.id_rs2.value = 7\n        await edge()\n        assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (1, 2)\n        dut.capture.value = 0\n        dut.id_rs1.value = 7\n        dut.id_rs2.value = 0\n        for _ in range(4):\n            await edge()\n            assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (1, 2)\n        dut[clear].value = 1\n        dut.capture.value = int(clear == \"reset\")\n        await edge()\n        assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (0, 0)\n        dut[clear].value = 0\n        dut.capture.value = 0\n        await edge()\n", "exit_code": 0, "status": "completed"}}
