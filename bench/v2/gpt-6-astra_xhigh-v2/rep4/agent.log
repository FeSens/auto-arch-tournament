arlier x5.\n    # JAL +2 falls through after its EX trap; misaligned LW loses ownership\n    # in MEM, including the delayed consumer behind its load-use bubble.\n    cases = [([ADDI(5, 0, 37), JAL(5, 2), ADD(6, 5, 5)], 4, 8, (2, 2)),\n             ([ADDI(5, 0, 37), JALR(5, 0, 2), ADD(6, 5, 5)], 4, 8, (2, 2)),\n             ([ADDI(5, 0, 37), NOP(), LW(5, 0, 0x102), ADD(6, 5, 5)],\n              8, 12, (0, 0)),\n    \n…[15600 of 18672 chars elided by tools/bench/transcript.py; sha256:e068607364603365]…\n(1, 5, 0),\n               2060: ADDI(2, 1, 7),\n               2064: BNE(0, 0, 2),  # untaken misaligned target is legal\n               2068: EBREAK()}\n    trace = []\n    rets, _ = await _run(dut, program, trace=trace)\n    _check_trace(trace, rets)\n    assert [r[\"pc\"] for r in rets] == list(program)\n    assert [r[\"pc\"] for r in rets if r[\"trap\"]] == [512, 1024, 1536, 2048, 2056]\n    assert all(r[\"rd\"] == 0 for r in rets if r[\"trap\"])\n    assert next(r for r in rets if r[\"pc\"] == 2060)[\"rd_wdata\"] == 7\n    assert [t[\"branch_pc\"] for t in trace if t[\"update\"]] == [0, 2064]\n\n\n@cocotb.test()\nasync def out_of_range_taken_alias_does_not_speculate(dut):\n    # PC 512 inherits a taken counter but its untaken branch points below\n    # zero. PC 0xffe00 inherits it too and points beyond the imem window.\n    program = {0: BEQ(0, 0, 512), 512: BNE(0, 0, -516),\n               516: JAL(0, 0x7FE00 - 516),\n               0x7FE00: BEQ(0, 0, 8), 0x7FE08: JAL(0, 0x7FFF8),\n               0xFFE00: BNE(0, 0, 512), 0xFFE04: EBREAK()}\n", "exit_code": 0, "status": "completed"}}
