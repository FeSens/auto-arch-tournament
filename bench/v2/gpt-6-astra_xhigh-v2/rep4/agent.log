t's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[19333 of 22405 chars elided by tools/bench/transcript.py; sha256:1719d2458925b85e]…\nvalue),\n                \"stall_id\": int(dut.stall_id.value),\n                \"flush_id\": int(dut.flush_id.value),\n                \"fwd\": (int(dut.fwd_rs1_sel.value), int(dut.fwd_rs2_sel.value)),\n                \"next_ex_write\": int(dut.next_ex_mem_w_en.value),\n                \"next_wb_write\": int(dut.next_mem_wb_w_en.value),\n        }\n        saved = _unpack(ID_FIELDS, sample[\"id_payload\"])\n        mem = _unpack(EX_FIELDS, sample[\"ex_payload\"])\n        mem_ctrl = _unpack(CTRL_FIELDS, mem[\"ctrl\"])\n        assert not (sample[\"normal_wb\"][\"valid\"] and sample[\"div_done\"]), \\\n            \"older WB coincides with divider completion\"\n        assert sample[\"completion\"][\"valid\"] == sample[\"div_consume\"]\n        assert int(dut.normal_wb_data.value) == sample[\"normal_wb\"][\"alu_result\"]\n        assert da == mem[\"effective_addr\"]\n        if not (mem_ctrl[\"mem_read\"] or mem_ctrl[\"mem_write\"]):\n            assert da == 0, \"non-memory arithmetic drove dmem address\"\n        fetched = _unpack(IF_FIELDS, sample[\"if_payload\"])\n", "exit_code": 0, "status": "completed"}}
