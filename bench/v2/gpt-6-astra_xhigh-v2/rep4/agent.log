eys=False,width=88)); jsonschema.validate(d,json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('VALID revised proposal')\nPY\nNRET=1 make cosim TARGET=bench > cores/bench/generated/r11_proto/cosim_radix16_grant.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
