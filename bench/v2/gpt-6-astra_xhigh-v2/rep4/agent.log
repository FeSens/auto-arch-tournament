row\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLT, 0xFFFFFFFF, 0, 1)             \n…[27240 of 30312 chars elided by tools/bench/transcript.py; sha256:520def743c2c8086]…\n512 inherits a taken counter but its untaken branch points below\n    # zero. PC 0xffe00 inherits it too and points beyond the imem window.\n    program = {0: BEQ(0, 0, 512), 512: BNE(0, 0, -516),\n               516: JAL(0, 0x7FE00 - 516),\n               0x7FE00: BEQ(0, 0, 8), 0x7FE08: JAL(0, 0x7FFF8),\n               0xFFE00: BNE(0, 0, 512), 0xFFE04: EBREAK()}\n    trace = []\n    rets, _ = await _run(dut, program, trace=trace)\n    _check_trace(trace, rets)\n    assert [r[\"pc\"] for r in rets] == list(program)\n    for t in trace:\n        if t[\"pc\"] in (512, 0xFFE00):\n            assert t[\"predicted\"] == t[\"pc\"] + 4\n\n\ndef test_pipeline_runner():\n    run_cocotb(\n        toplevel=\"core\",\n        sources=[\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ],\n        test_module=\"test_pipeline\",\n    )\n", "exit_code": 0, "status": "completed"}}
