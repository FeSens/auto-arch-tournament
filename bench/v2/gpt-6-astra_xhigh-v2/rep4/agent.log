{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"sed -n '1610,1695p' cores/bench/test/test_pipeline.py\"","aggregated_output":"        await edge()\n        assert (int(dut.fwd_rs1.value), int(dut.fwd_rs2.value)) == (0, 0)\n\n\n@pytest.mark.parametrize(\"top,testcase\", [\n    (\"forward_unit\", \"unit_forward_capture_priority\"),\n    (\"ex_stage\", \"unit_ex_token_equivalence\"),\n    (\"if_stage\", \"unit_if_guarded_token\"),\n    (\"id_stage\", \"unit_id_squash_beats_hold\"),\n    (\"hazard_unit\", \"unit_hazard_recovery_priority\"),\n    (\"mem_stage\", \"unit_mem_dedicated_address\"),\n])\ndef test_recovery_units_runner(top, testcase):\n    root = Path(__file__).resolve().parent.parent\n    sources = [root / \"rtl\" / \"core_pkg.sv\"] + sorted(\n        path for path in (root / \"rtl\").glob(\"*.sv\") if path.name != \"core_pkg.sv\")\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = root / \"sim_build\" / top\n    runner.build(sources=sources, hdl_toplevel=top, build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"])\n    runner.test(hdl_toplevel=top, test_module=\"test_pipeline\", test_filter=testcase,\n                test_dir=root / \"test\", build_dir=build)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_arithmetic_route_runner(altops):\n    root = Path(__file__).resolve().parent.parent\n    sources = [root / \"rtl\" / name for name in (\"core_pkg.sv\", \"alu.sv\", \"ex_stage.sv\")]\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = root / \"sim_build\" / (\"route_altops\" if altops else \"route\")\n    runner.build(sources=sources, hdl_toplevel=\"ex_stage\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"-DRISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"ex_stage\", test_module=\"test_pipeline\",\n                test_filter=r\"unit_ex_(divide_ownership|effective_address)\",\n                test_dir=root / \"test\", build_dir=build,\n                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_pipeline_runner(altops):\n    root = Path(__file__).resolve().parent.parent\n    sources = [\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ]\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = root / \"sim_build\" / (\"core_altops\" if altops else \"core\")\n    runner.build(sources=[root / \"rtl\" / s for s in sources],\n                 hdl_toplevel=\"core\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"-DRISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n                test_filter=r\"test_pipeline\\.(?!unit_)\",\n                test_dir=root / \"test\", build_dir=build,\n                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n","exit_code":0,"status":"completed"}}
