{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/predictor_probe')\n(p/'test_if_probe.py').write_text('''import random\nimport cocotb\nfrom cocotb.triggers import Timer\n\n@cocotb.test()\nasync def queue_model(d):\n    rng=random.Random(8102)\n    pc=0; q=[]; counters=[1]*128\n    coverage=dict(full_exchange=0,buffered_stall=0,boundary=0,redirect=0)\n    for cycle in range(6000):\n        reset=cycle==0 or cycle%997==0\n        ready=rng.random()<0.78\n        hold=rng.random()<0.43\n        redir=rng.random()<0.09\n        target=rng.choice([0,0xffffc,0x100000,0x80000000,0xfffffffc,2,rng.randrange(0,1000)*4])\n        insn=rng.getrandbits(32)\n        if rng.random()<0.6:\n            insn=(insn & ~127)|rng.choice([0x63,0x6f,0x67,0x13])\n        train=rng.random()<0.6\n        bpc=pc if rng.random()<0.45 else rng.getrandbits(32)\n        taken=rng.randrange(2)\n        avail=bool(q) or ready\n        branch=(insn&127)==0x63 and ((insn>>12)&7) not in (2,3)\n        jal=(insn&127)==0x6f\n        if jal:\n            imm=((insn>>31)<<20)|(((insn>>12)&255)<<12)|(((insn>>20)&1)<<11)|(((insn>>21)&1023)<<1)\n            if imm&(1<<20):imm-=1<<21\n        else:\n            imm=((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1)\n            if imm&(1<<12):imm-=1<<13\n        dt=(pc+imm)&0xffffffff\n        direct=(jal or (branch and counters[(pc>>2)&127]>=2)) and dt%4==0 and dt<0x100000\n        npc=dt if direct else (pc+4)&0xffffffff\n        raw=(pc,insn,int(direct),npc)\n        head=q[0] if q else raw\n        d.clock.value=0\n        d.reset.value=reset\n        d.bus_ready.value=ready\n        d.decode_hold.value=hold\n        d.flush.value=not avail\n        d.redirect.value=redir\n        d.redirect_target.value=target\n        d.imem_data.value=insn\n        d.branch_update.value=train\n        d.branch_pc.value=bpc\n        d.branch_taken.value=taken\n        await Timer(5,unit='ns')\n        if cycle:\n            assert int(d.imem_addr.value)==pc,(cycle,'pc')\n            assert int(d.available.value)==avail,(cycle,'avail')\n            hpc,hins,hdir,hnpc=head\n            packed=(hpc<<66)|(hnpc<<34)|(hdir<<33)|((hins if avail else 0x13)<<1)|int(avail and not redir)\n            assert int(d.out.value)==packed,(cycle,'out',hex(int(d.out.value)),hex(packed))\n        consume=avail and not hold\n        pop=bool(q) and consume\n        compact=pc%4==0 and pc<0xffffc\n        accept=ready and (len(q)<4 or pop) and (compact or (not q and consume))\n        append=accept and (bool(q) or not consume)\n        coverage['full_exchange']+=len(q)==4 and pop and append\n        coverage['buffered_stall']+=bool(q) and not ready and consume\n        coverage['boundary']+=not compact\n        coverage['redirect']+=redir\n        if reset:pc=0;q=[];counters=[1]*128\n        else:\n            if redir:pc=target;q=[]\n            else:\n                if pop:q.pop(0)\n                if append:q.append(raw)\n                if accept:pc=npc\n            if train:\n                ix=(bpc>>2)&127\n                counters[ix]=min(3,counters[ix]+1) if taken else max(0,counters[ix]-1)\n        d.clock.value=1\n        await Timer(5,unit='ns')\n    assert all(coverage.values()),coverage\n    d._log.info('Coverage: %s',coverage)\n''')\n(p/'run_if_probe.py').write_text('''from pathlib import Path\nfrom cocotb_tools.runner import get_runner\np=Path(__file__).resolve().parent\nr=get_runner('verilator')\nr.build(sources=[p/'rtl/core_pkg.sv',p/'rtl/if_stage.sv'],hdl_toplevel='if_stage',build_dir=p/'if_sim',build_args=['-Wall','-Wno-fatal','-Wno-style'])\nr.test(hdl_toplevel='if_stage',test_module='test_if_probe',test_dir=p,build_dir=p/'if_sim')\n''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
