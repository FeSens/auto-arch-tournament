{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\nMASK = (1 << 32) - 1\n\ndef tapered_divmod(a, b):\n    multiples = (b, 2*b, 3*b)\n    q = r = 0\n    for width in range(2, 33, 2):\n        t = (r << 2) | ((a >> (32-width)) & 3)\n        assert t < (1 << width)\n        digit, r = 0, t\n        for j, multiple in enumerate(multiples, 1):\n            mask = (1 << width)-1\n            trial = (t-(multiple & mask)) & ((1 << (width+1))-1)\n            if (multiple >> width) == 0 and (trial >> width) == 0:\n                digit, r = j, trial & mask\n        q = (q << 2) | digit\n    return (MASK, a) if b == 0 else (q, r)\n\ndef signed32(x):\n    return x-(1 << 32) if x & (1 << 31) else x\n\ndef signed_results(a, b):\n    sa, sb = signed32(a), signed32(b)\n    q, r = tapered_divmod(abs(sa), abs(sb))\n    if b == 0:\n        return MASK, a\n    if a == 0x80000000 and b == MASK:\n        return 0x80000000, 0\n    return ((-q if (sa < 0) \"'!= (sb < 0) else q) & MASK,\n            (-r if sa < 0 else r) & MASK)\n\nchecks = 0\nfor a in range(256):\n    for b in range(256):\n        expected = divmod(a, b) if b else (MASK, a)\n        assert tapered_divmod(a, b) == expected, (a, b)\n        checks += 1\nedges = {0, 1, 2, 3, MASK, MASK-1, 0x80000000, 0x7fffffff}\nfor k in range(32):\n    edges.update(((1 << k)-1, 1 << k, min(MASK, (1 << k)+1)))\npairs = [(a,b) for a in edges for b in edges]\nrng = Random(20261002)\npairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000))\nfor a, b in pairs:\n    assert tapered_divmod(a,b) == (divmod(a,b) if b else (MASK,a)), (a,b)\n    sa, sb = signed32(a), signed32(b)\n    if sb:\n        q = abs(sa)//abs(sb)\n        if (sa < 0) != (sb < 0): q = -q\n        expected = (q & MASK, (sa-q*sb) & MASK)\n    else:\n        expected = MASK, a\n    assert signed_results(a,b) == expected, (a,b)\n    checks += 2\nprint(f'\"'Tapered radix-4 arithmetic model passed {checks} unsigned/signed operand checks.')\nprint('This validates the proposed recurrence, not RTL synthesis or measured timing.')\nPY\n\ngit diff --check\ngit status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
