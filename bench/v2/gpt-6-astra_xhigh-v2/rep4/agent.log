{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nfrom sympy import symbols, SOPform, And, Or, Not, true, false\ns=Path('cores/bench/generated/r15_prefix_probe/original_alu.sv').read_text()\nxs=symbols('n3 n2 n1 n0 d3 d2 d1 d0')\ndef expr(x):\n if x==true:return \\\"1'b1\\\"\n if x==false:return \\\"1'b0\\\"\n if x.func==And:return '('+' & '.join(expr(a) for a in x.args)+')'\n if x.func==Or:return '('+' | '.join(expr(a) for a in x.args)+')'\n if x.func==Not:return '~'+expr(x.args[0])\n t=str(x);return ('quotient_q['+str(28+int(t[1]))+']') if t[0]=='n' else 'divisor_q['+t[1]+']'\nlines=[]\nfor kind in ('q','r'):\n for bit in range(4):\n  ons=[]\n  for n in range(16):\n   for d in range(16):\n    q,r=divmod(n,d) if d else (15,n)\n    if ((q if kind=='q' else r)>>bit)&1: ons.append(n*16+d)\n  e=SOPform(xs,ons)\n  lines.append(f'  assign prefix_{kind}[{bit}] = {expr(e)};')\nstart=s.index('  logic [3:0] prefix_r')\nend=s.index('  logic [31:0] quotient_step',start)\ns=s[:start]+'''  logic [3:0] prefix_r, prefix_q;\n'''+s[end:]\ns=s.replace('  logic [5:0] prefix_diff [0:3];\\\\n','')\nstart=s.index('  assign prefix_r[0]');end=s.index('  // Each later busy edge',start)\ns=s[:start]+'\\\\n'.join(lines)+'\\\\n\\\\n'+s[end:]\ns=s.replace(\\\"{quotient_q[27:0], prefix_q[4]}\\\",\\\"{quotient_q[27:0], divisor_high_zero ? prefix_q : 4'b0}\\\")\ns=s.replace(\\\"{28'b0, prefix_r[4]}\\\",\\\"{28'b0, divisor_high_zero ? prefix_r : quotient_q[31:28]}\\\")\nPath('cores/bench/rtl/alu.sv').write_text(s)\nPath('cores/bench/generated/r15_prefix_probe/boolean_alu.sv').write_text(s)\nprint('Wrote minimized bitwise prefix:',len('\\\\n'.join(lines)),'characters')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
