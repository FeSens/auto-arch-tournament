ult\", \"effective_addr\", \"write_data\")] + [\n    (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32),\n    (\"rs2_val\", 32), (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"is_multiply\", 1),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n \n…[16533 of 19605 chars elided by tools/bench/transcript.py; sha256:7a98d0d26b8dbcf9]…\nss failed\"\n        if sample[\"flush_id\"]:\n            assert int(dut.id_ex_w.value) == 0, \"squash left executable controls\"\n        elif sample[\"stall_id\"]:\n            assert int(dut.id_ex_w.value) == sample[\"id_payload\"], \"held prediction changed\"\n        else:\n            for field in (\"pc\", \"instr\", \"valid\", \"predicted_direct\", \"predicted_next_pc\"):\n                assert captured[field] == fetched[field], (field, captured, fetched)\n            assert captured[\"direct_is_fallthrough\"] == (captured[\"imm\"] == 4)\n            for field, expected in _recovery_tokens(captured[\"pc\"], captured[\"imm\"],\n                    fetched[\"predicted_direct\"], _unpack(CTRL_FIELDS, captured[\"ctrl\"])).items():\n                assert captured[field] == expected, (field, captured, fetched)\n        if stop_when is not None and stop_when(sample):\n            break\n        if rvfi_v and retirements[-1][\"insn\"] == EBREAK():\n            break\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n", "exit_code": 0, "status": "completed"}}
