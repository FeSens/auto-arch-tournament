{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Real RV32IM arithmetic and the eight-iteration divider handshake.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"ALTOPS\") == \"1\"\nALT_CONSTANT = {\n    ALU_MUL: 0x5876063e, ALU_MULH: 0xf6583fb7,\n    ALU_MULHU: 0x949ce5e8, ALU_MULHSU: 0xecfbe137,\n    ALU_DIV: 0x7f8529ec, ALU_DIVU: 0x10e8fd70,\n    ALU_REM: 0x8da68fa5, ALU_REMU: 0x3138d0e1,\n}\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef _alt(op, a, b):\n    value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n    return (value ^ ALT_CONSTANT[op]) & MASK32\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    if ALTOPS and op in ALT_CONSTANT:\n        expected = _alt(op, a, b)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.valu\n…[14617 of 17689 chars elided by tools/bench/transcript.py; sha256:271925985ac308bc]…\n   dut.reset.value = 0\n        for _ in range(10):\n            await _tick(dut)\n            assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n        await _check_div(dut, ALU_REM, 0xfffffff6, 3, MASK32)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_alu_runner(altops):\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    root = Path(__file__).resolve().parent.parent\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = root / \"sim_build\" / (\"alu_altops\" if altops else \"alu\")\n    runner.build(sources=[root / \"rtl\" / s for s in (\"core_pkg.sv\", \"alu.sv\")],\n                 hdl_toplevel=\"alu\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"-DRISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\",\n                test_dir=root / \"test\", build_dir=build,\n                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n", "exit_code": 0, "status": "completed"}}
