{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport subprocess,re\nbase=Path('cores/bench/generated/r15_isa_encoding_probe/rtl');base.mkdir(parents=True,exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n (base/p.name).write_bytes(subprocess.check_output(['git','show',f'HEAD:{p}']))\np=base/'core_pkg.sv';s=p.read_text()\nfor name,value in [('ALU_MUL',16),('ALU_MULH',17),('ALU_MULHU',19),('ALU_MULHSU',18),('ALU_DIV',20),('ALU_DIVU',21),('ALU_REM',22),('ALU_REMU',23)]:\n s,n=re.subn(r'(localparam logic \\\\[4:0\\\\] '+name+r'\\\\s*= 5\\\\x27d)\\\\d+',lambda m:m[1]+str(value),s);assert n==1\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
