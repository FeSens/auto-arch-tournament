 in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nEX_FIELDS = [(name, 32) for name in (\"pc\", \"alu_result\", \"effective_addr\", \"write_data\")] + [\n    (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32),\n    (\"rs2_val\", 32), (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"is_multiply\", 1),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n \n…[21810 of 24882 chars elided by tools/bench/transcript.py; sha256:00d8eb05b43d2081]…\nFFE00: BNE(0, 0, 512), 0xFFE04: EBREAK()}\n    trace = []\n    rets, _ = await _run(dut, program, trace=trace)\n    _check_trace(trace, rets)\n    assert [r[\"pc\"] for r in rets] == list(program)\n    for t in trace:\n        if t[\"pc\"] in (512, 0xFFE00):\n            assert t[\"predicted\"] == t[\"pc\"] + 4\n\n\ndef _is_div(insn):\n    return insn & 0xfe00007f == 0x02000033 and (insn >> 12) & 7 >= 4\n\n\ndef _div_reference(funct3, a, b):\n    if ALTOPS:\n        return ((a - b) ^ (0x7f8529ec, 0x10e8fd70, 0x8da68fa5,\n                           0x3138d0e1)[funct3 - 4]) & MASK32\n    if b == 0:\n        return a if funct3 >= 6 else MASK32\n    if funct3 in (4, 6):\n        a = a if a < 0x80000000 else a - (1 << 32)\n        b = b if b < 0x80000000 else b - (1 << 32)\n    quotient = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        quotient = -quotient\n    return (a - quotient * b if funct3 >= 6 else quotient) & MASK32\n\n\ndef _check_div_stream(rets, trace):\n    \"\"\"Check the whole retirement stream, including gaps adjacent to divides.\"\"\"\n", "exit_code": 0, "status": "completed"}}
