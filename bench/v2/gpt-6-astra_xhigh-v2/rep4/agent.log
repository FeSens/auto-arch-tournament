{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c 'tail -8 \"$TMPDIR/bench-final-tests.log\"; cat \"$TMPDIR/bench-full-cosim.log\"; rg -n '\"'\"'^place_option|''^score'\"' \\\"\"'$TMPDIR/bench-timing.log\"; git check-ignore cores/bench/implementation_notes.md; sed -n '\"'1,90p' cores/bench/test/test_alu.py\"","aggregated_output":"..............                                                           [100%]\n14 passed in 14.42s\n{\n  \"passed\": true,\n  \"elfs_tested\": 5\n}\n1:place_option 0: Fmax 52.142 MHz, 18 logic levels; logic 3746, registers 993, LUT-RAM 8, BSRAM 6, DSP 6\n13:place_option 1: Fmax 54.153 MHz, 14 logic levels; logic 3746, registers 993, LUT-RAM 8, BSRAM 6, DSP 6\n25:place_option 2: Fmax 54.153 MHz, 14 logic levels; logic 3746, registers 993, LUT-RAM 8, BSRAM 6, DSP 6\n37:score Fmax (median): 54.153 MHz\ncores/bench/implementation_notes.md\n\"\"\"Real RV32IM arithmetic and the eight-iteration divider handshake.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"ALTOPS\") == \"1\"\nALT_CONSTANT = {\n    ALU_MUL: 0x5876063e, ALU_MULH: 0xf6583fb7,\n    ALU_MULHU: 0x949ce5e8, ALU_MULHSU: 0xecfbe137,\n    ALU_DIV: 0x7f8529ec, ALU_DIVU: 0x10e8fd70,\n    ALU_REM: 0x8da68fa5, ALU_REMU: 0x3138d0e1,\n}\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef _alt(op, a, b):\n    value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n    return (value ^ ALT_CONSTANT[op]) & MASK32\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    if ALTOPS and op in ALT_CONSTANT:\n        expected = _alt(op, a, b)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value = 1\n    await _tick(dut)  # launch captures the full magnitude without arithmetic\n    assert int(dut.div_busy.value) and not int(dut.div_done.value)\n    for iteration in range(8):\n        # Even repeated requests, early consumes, and changed inputs cannot\n        # overwrite an operation. The stored op selects its final result.\n        dut.op.value = DIV_OPS[(iteration + 1) % 4]\n        dut.a.value = (a ^ (0x9e3779b9 * (iteration + 1))) & MASK32\n        dut.b.value = (b + iteration + 17) & MASK32\n        dut.div_consume.value = 1  # ignored even on the final iteration edge\n        await _tick(dut)\n        assert int(dut.div_done.value) == int(iteration == 7)\n        assert int(dut.div_busy.value) == int(iteration != 7)\n    dut.div_consume.value = 0\n    expected = _alt(op, a, b) if ALTOPS else expected & MASK32\n","exit_code":0,"status":"completed"}}
