{"type": "item.started", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/bash -c \"mkdir -p cores/bench/generated/two_probe/test\ncat > cores/bench/generated/two_probe/test/test_queue_probe.py <<'PY'\nimport random\nimport cocotb\nfrom cocotb.triggers import Timer\n\nMASK=(1<<32)-1\n\ndef sx(v,n): return v-(1<<n) if v>>(n-1) else v\n\ndef predict(pc, insn, counters):\n    op=insn&127; f=(insn>>12)&7\n    branch=op==99 and f not in (2,3)\n    jal=op==111\n    if jal:\n        imm=((insn>>31)<<20)|(((insn>>12)&255)<<12)|(((insn>>20)&1)<<11)|(((insn>>21)&1023)<<1)\n        imm=sx(imm,21)\n    else:\n        imm=((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1)\n        imm=sx(imm,13)\n    target=(pc+imm)&MASK\n    direct=(jal or (branch and counters[(pc>>2)&127]>=2)) and target<0x100000 and target%4==0\n    return ((target if direct else pc+4)&MASK, int(direct))\n\n@cocotb.test()\nasync def queue_protocol(dut):\n    rng=random.Random(773)\n    q=[]; pc=0; counters=[1]*128\n    dut.clock.value=0; dut.reset.value=1; dut.stall.value=0\n    dut.flush.value=0; dut.redirect.value=0; dut.redirect_target.value=0\n    dut.branch_update.value=0; dut.branch_pc.value=0; dut.branch_taken.value=0\n    dut.bus_ready.value=1; dut.imem_data.value=0x13\n    await Timer(5,unit='ns');dut.clock.value=1;await Timer(5,unit='ns')\n    dut.reset.value=0\n    boundary_cases=[0xffffc,0x100000,0xfffffffc,0xfffffffe,0x100002,0]\n    counts={'full_exchange':0,'empty_bypass':0,'buffered_stall':0,'boundary':0,'recovery':0}\n    for cycle in range(4000):\n        dut.clock.value=0\n        insn=rng.getrandbits(32)\n        if cycle%3==0:insn=(insn&~127)|99\n        elif cycle%3==1:insn=(insn&~127)|111\n        ready=rng.randrange(4)\"'!=0; hold=rng.randrange(3)==0\n        redirect=rng.randrange(11)==0 or cycle%29==0\n        target=boundary_cases[(cycle//29)%len(boundary_cases)] if cycle%29==0 else rng.randrange(256)*4\n        update=rng.randrange(3)==0; bpc=rng.randrange(128)*4; taken=rng.randrange(2)\n        avail=bool(q) or ready; consume=avail and not hold\n        boundary=pc>=0x100000 or pc%4!=0 or pc==0xffffc\n        accept=ready and (len(q)<2 or consume) and (not boundary or (not q and consume))\n        npc,bit=predict(pc,insn,counters)\n        raw=(pc,npc,bit,insn)\n        head=q[0] if q else raw\n        dut.imem_data.value=insn;dut.bus_ready.value=int(ready);dut.stall.value=int(hold)\n        dut.flush.value=int(not avail);dut.redirect.value=int(redirect);dut.redirect_target.value=target\n        dut.branch_update.value=int(update);dut.branch_pc.value=bpc;dut.branch_taken.value=taken\n        await Timer(5,unit='\"'ns')\n        assert int(dut.imem_addr.value)==pc\n        assert int(dut.available.value)==avail\n        val=int(dut.out.value)\n        valid=val&1;val>>=1\n        oi=val&MASK;val>>=32\n        ob=val&1;val>>=1\n        on=val&MASK;val>>=32\n        op=val\n        assert (op,on,ob,oi,valid)==(*head[:3],head[3] if avail else 0x13,int(avail and not redirect))\n        pop=bool(q) and consume\n        append=accept and (bool(q) or not consume)\n        counts['full_exchange']+=int(len(q)==2 and pop and append)\n        counts['empty_bypass']+=int(not q and accept and consume)\n        counts['buffered_stall']+=int(bool(q) and not ready and consume)\n        counts['boundary']+=int(boundary)\n        counts['recovery']+=int(redirect)\n        if update:counters[(bpc>>2)&127]=max(0,min(3,counters[(bpc>>2)&127]+(1 if taken else -1)))\n        if redirect:q=[];pc=target\n        else:\n            if pop:q.pop(0)\n            if append:q.append(raw)\n            if accept:pc=npc\n        dut.clock.value=1;await Timer(5,unit='ns')\n    assert all(v>10 for v in counts.values()),counts\n    dut._log.info('Coverage %s',counts)\nPY\npython - <<'PY' > cores/bench/generated/two_probe/queue_test.log 2>&1\nfrom pathlib import Path\nfrom cocotb_tools.runner import get_runner\nroot=Path('cores/bench/generated/two_probe').resolve()\nr=get_runner('verilator')\nr.build(sources=[root/'rtl/core_pkg.sv',root/'rtl/if_stage.sv'],hdl_toplevel='if_stage',build_dir=root/'queue_build',build_args=['-Wall','-Wno-fatal','-Wno-style'],always=True)\nr.test(hdl_toplevel='if_stage',test_module='test_queue_probe',test_dir=root/'test',build_dir=root/'queue_build')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
