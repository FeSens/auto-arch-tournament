{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_pipeline.py'", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nALTOPS = os.environ.get(\"ALTOPS\") == \"1\"\nMASK32 = 0xffffffff\nMUL_OPS = (11, 12, 13, 14)\n\n# Packed bundle layouts, MSB first. Keep widths explicit so these checks\n# observe the instruction's saved prediction, never a fresh BHT lookup.\nCTRL_FIELDS = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3)] + [\n    (name, 1) for name in (\"is_branch\", \"is_jump\", \"is_jalr\", \"is_lui\",\n                          \"is_auipc\", \"mem_read\", \"mem_write\")\n] + [(\"mem_width\", 2)] + [(name, 1) for name in\n    (\"mem_sext\", \"reg_write\", \"mem_to_reg\", \"is_illegal\")]\nIF_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"instr\", 32), (\"valid\", 1)]\nID_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"direct_is_fallthrough\", 1), (\"branch_prediction_xor\", 1),\n             (\"recovery_branch_check\", 1), (\"recovery_static_miss\", 1),\n             (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nEX_FIELDS = [(name, 32) for name in (\"pc\", \"alu_result\", \"effective_addr\", \"write_data\")] + [\n    (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32),\n    (\"rs2_val\", 32), (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"is_multiply\", 1),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n \n…[94967 of 98039 chars elided by tools/bench/transcript.py; sha256:6740e74fd7c18b42]…\ne])\ndef test_pipeline_runner(altops):\n    root = Path(__file__).resolve().parent.parent\n    sources = [\n            \"core_pkg.sv\",\n            \"alu.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ]\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = root / \"sim_build\" / (\"core_altops\" if altops else \"core\")\n    runner.build(sources=[root / \"rtl\" / s for s in sources],\n                 hdl_toplevel=\"core\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"-DRISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n                test_filter=r\"test_pipeline\\.(?!unit_)\",\n                test_dir=root / \"test\", build_dir=build,\n                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n", "exit_code": 0, "status": "completed"}}
