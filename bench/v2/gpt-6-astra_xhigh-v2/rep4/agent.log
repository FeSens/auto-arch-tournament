ite_data\")] + [\n    (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32),\n    (\"rs2_val\", 32), (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"is_multiply\", 1),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5)] + [\n    (name, 32) for name in (\"rs1_val\", \"rs2_val\", \"pc_\n…[13528 of 16600 chars elided by tools/bench/transcript.py; sha256:8b177b0381522bf7]…\n62:def test_arithmetic_route_runner(altops):\n1865:    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n1866:    build = root / \"sim_build\" / (\"route_altops\" if altops else \"route\")\n1867:    runner.build(sources=sources, hdl_toplevel=\"ex_stage\", build_dir=build, always=True,\n1869:                            ([\"-DRISCV_FORMAL_ALTOPS\"] if altops else []))\n1870:    runner.test(hdl_toplevel=\"ex_stage\", test_module=\"test_pipeline\",\n1873:                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n1876:@pytest.mark.parametrize(\"altops\", [False, True])\n1877:def test_pipeline_runner(altops):\n1887:    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n1888:    build = root / \"sim_build\" / (\"core_altops\" if altops else \"core\")\n1889:    runner.build(sources=[root / \"rtl\" / s for s in sources],\n1892:                            ([\"-DRISCV_FORMAL_ALTOPS\"] if altops else []))\n1893:    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\",\n1896:                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n", "exit_code": 0, "status": "completed"}}
