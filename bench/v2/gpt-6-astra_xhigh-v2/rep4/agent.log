{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport re, subprocess\nout=Path('cores/bench/generated/r15_prefix_probe')\nout.mkdir(parents=True,exist_ok=True)\noriginal=subprocess.check_output(['git','show','HEAD:cores/bench/rtl/alu.sv'],text=True)\ncurrent=Path('cores/bench/rtl/alu.sv').read_text()\ndef prefix_module(text,name,count):\n    decls=[]\n    for l in text.splitlines():\n        if l.strip().startswith('logic ') and ('prefix_' in l or 'divisor_high_zero' in l):\n            decls.append(l)\n    start=text.index('  assign divisor_high_zero')\n    end=text.index('  // Each later busy edge',start)\n    assignments=text[start:end]\n    if name=='old_prefix':\n        outputs='assign result = {prefix_q[4],prefix_r[4]};'\n    else:\n        outputs=\\\"assign result = divisor_high_zero ? {prefix_q[2],prefix_r[2]} : {4'b0,quotient_q[31:28]};\\\"\n    return f'module {name}(input [31:0] divisor_q, input [3:0] n, output [7:0] result);\\\\nwire [31:0] quotient_q={{n,28\\\\'b0}};\\\\n'+ '\\\\n'.join(decls)+'\\\\n'+assignments+outputs+'\\\\nendmodule\\\\n'\nmiter=prefix_module(original,'old_prefix',4)+prefix_module(current,'new_prefix',2)+'''\nmodule miter(input [31:0] d, input [3:0] n, output mismatch);\nwire [7:0] old_result, new_result;\nold_prefix a(.divisor_q(d),.n(n),.result(old_result));\nnew_prefix b(.divisor_q(d),.n(n),.result(new_result));\nassign mismatch = old_result \"'!= new_result;\nendmodule\n'\"'''\n(out/'miter.sv').write_text(miter)\n(out/'original_alu.sv').write_text(original)\nprint('Saved original RTL and extracted prefix miter')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
