n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[14501 of 17573 chars elided by tools/bench/transcript.py; sha256:85dc76e4d4a82745]…\neason\"] = res.get(\"reason\") or (\"; \".join(errs[:3])[:500] or \"no reports written\")\n    return {\"place_option\": place_option, **res}\n\n\ndef build_all(worktree, rtl_dir, bench_sv, gen_dir, env=None,\n              options=PLACE_OPTIONS) -> list[dict]:\n    from tools.eval._slots import eval_slot\n    with eval_slot(\"gowin\"), ThreadPoolExecutor(max_workers=len(options)) as ex:\n        futs = [ex.submit(build, worktree, rtl_dir, bench_sv, p,\n                          Path(gen_dir) / f\"gowin_p{p}\", env) for p in options]\n        return [f.result() for f in futs]\n\n\ndef summarize(results: list[dict]) -> dict:\n    \"\"\"Median Fmax over placement options; every option must fit (the flow\ntest/cosim/reference.py\ntest/cosim/main.cpp\ntest/cosim/build.sh\ntest/cosim/run_cosim.py\ntest/_helpers.py\ntest/conftest.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/conftest.py\ncores/bench/test/test_imm_gen.py\n", "exit_code": 0, "status": "completed"}}
