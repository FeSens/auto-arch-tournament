{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_alu.py')\ns=p.read_text()\nPath('cores/bench/generated/hyp_r8s1/test_alu.original.py').write_text(s)\ns+='''\n\n@cocotb.test()\nasync def radix16_bank_and_digit_vectors(dut):\n    await _setup(dut)\n    rng = random.Random(0x81)\n    pairs = set()\n    for d in range(17):\n        for nibble in range(16):\n            for suffix in (0, 0xfffffff, rng.getrandbits(28)):\n                pairs.add(((nibble << 28) | suffix, d))\n    for digit in range(16):\n        pairs.add((digit * 0x11111111, 1))\n    divisors = [MASK32, MASK32-1, 0x80000000, 0x80000001]\n    divisors += [(1 << b) + delta for b in range(32)\n                 for delta in (-1,0,1) if 0 <= (1 << b) + delta <= MASK32]\n    for d in divisors:\n        for a in (0,1,d,(d-1)&MASK32,(d+1)&MASK32,MASK32,rng.getrandbits(32)):\n            pairs.add((a,d))\n    for i in range(1000):\n        pairs.add((rng.getrandbits(32),rng.getrandbits(32)))\n    for index,(a,b) in enumerate(sorted(pairs)):\n        for op in DIV_OPS:\n            await _check_div(dut, op, a, b, _reference(op,a,b), hold=2 if index%97==0 else 0)\n'''\np.write_text(s)\nprint('Added temporary independent radix-16 coverage.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
