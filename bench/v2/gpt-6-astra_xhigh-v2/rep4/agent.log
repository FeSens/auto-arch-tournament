{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nb=Path('cores/bench'); snap=b/'generated/r11_proto/original'\nfor f in snap.glob('*.sv'): (b/'rtl'/f.name).write_bytes(f.read_bytes())\np=b/'rtl/alu.sv'; s=p.read_text()\ns=s.replace('  logic [33:0] dwide, twice, triple_q;', '''  logic [35:0] dwide;\n  logic [35:0] multiples_q [1:15];\n  logic [35:0] trial16;\n  logic [31:0] remainder16, quotient16;\n  logic [15:0] ge16, digit_select;\n  logic [3:0] digit16;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [36:0] diff16 [1:15];\n  /* verilator lint_on UNUSEDSIGNAL */''')\ns=s.replace('  logic [31:0] quotient_step [0:2];\\\\n  logic [31:0] remainder_step [0:2];\\\\n  logic [33:0] trial [0:1];\\\\n  logic [1:0] ge1, ge2, ge3, w0, w1, w2, w3;\\\\n','')\ns=s.replace('  logic [34:0] diff1 [0:1];\\\\n  logic [34:0] diff2 [0:1];\\\\n  logic [34:0] diff3 [0:1];\\\\n','')\ns=s.replace(\\\"  assign dwide = {2'b0, divisor_q};\\\\n  assign twice = dwide << 1;\\\", \\\"  assign dwide = {4'b0, divisor_q};\\\")\na=s.index('  // Each later busy edge'); e=s.index('  always_comb begin\\\\n    magnitude_result',a)\ns=s[:a]+'''  // One radix-16 digit: all divisor trials run in parallel.\n  assign trial16 = {remainder_q, quotient_q[31:28]};\n  assign ge16[0] = 1'b1;\n  for (genvar i = 1; i < 16; i++) begin : g_radix16_trial\n    assign diff16[i] = {1'b0, trial16} - {1'b0, multiples_q[i]};\n    assign ge16[i] = \"'!diff16[i][36];\n  end\n  for (genvar i = 0; i < 15; i++) begin : g_radix16_select\n    assign digit_select[i] = ge16[i] && !ge16[i+1];\n  end\n  assign digit_select[15] = ge16[15];\n  always_comb begin\n    remainder16 = trial16[31:0] & {32{digit_select[0]}};\n    digit16 = 4'\"'b0;\n    for (integer i = 1; i < 16; i++) begin\n      remainder16 = remainder16 | (diff16[i][31:0] & {32{digit_select[i]}});\n      digit16 = digit16 | (4'(i) & {4{digit_select[i]}});\n    end\n  end\n  assign quotient16 = {quotient_q[27:0], digit16};\n\n'''+s[e:]\ns=s.replace(\\\"      triple_q <= 34'b0;\\\", \\\"      for (integer i = 1; i < 16; i++) multiples_q[i] <= 36'b0;\\\")\ns=s.replace('        triple_q <= (dwide << 1) + dwide;', '''        multiples_q[1] <= dwide;\n        multiples_q[2] <= dwide << 1;\n        multiples_q[3] <= (dwide << 1) + dwide;\n        multiples_q[4] <= dwide << 2;\n        multiples_q[5] <= (dwide << 2) + dwide;\n        multiples_q[6] <= (dwide << 2) + (dwide << 1);\n        multiples_q[7] <= (dwide << 3) - dwide;\n        multiples_q[8] <= dwide << 3;\n        multiples_q[9] <= (dwide << 3) + dwide;\n        multiples_q[10] <= (dwide << 3) + (dwide << 1);\n        multiples_q[11] <= ((dwide << 3) \"'^ (dwide << 1) ''^ dwide)\n                        + (((((dwide << 3) & (dwide << 1))\n                            | ((dwide << 3) & dwide)\n                            | ((dwide << 1) & dwide))) << 1);\n        multiples_q[12] <= (dwide << 3) + (dwide << 2);\n        multiples_q[13] <= ((dwide << 3) ''^ (dwide << 2) ''^ dwide)\n                        + (((((dwide << 3) & (dwide << 2))\n                            | ((dwide << 3) & dwide)\n                            | ((dwide << 2) & dwide))) << 1);\n        multiples_q[14] <= (dwide << 4) - (dwide << 1);\n        multiples_q[15] <= (dwide << 4) - dwide;'\"''')\ns=s.replace('quotient_q <= quotient_step[2];','quotient_q <= quotient16;').replace('remainder_q <= remainder_step[2];','remainder_q <= remainder16;')\np.write_text(s)\nPY\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
