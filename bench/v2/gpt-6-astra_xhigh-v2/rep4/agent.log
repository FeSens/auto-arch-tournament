{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -c \"sed -n '1,85p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nALTOPS = os.environ.get(\"ALTOPS\") == \"1\"\nMASK32 = 0xffffffff\n\n# Packed bundle layouts, MSB first. Keep widths explicit so these checks\n# observe the instruction's saved prediction, never a fresh BHT lookup.\nCTRL_FIELDS = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3)] + [\n    (name, 1) for name in (\"is_branch\", \"is_jump\", \"is_jalr\", \"is_lui\",\n                          \"is_auipc\", \"mem_read\", \"mem_write\")\n] + [(\"mem_width\", 2)] + [(name, 1) for name in\n    (\"mem_sext\", \"reg_write\", \"mem_to_reg\", \"is_illegal\")]\nIF_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"instr\", 32), (\"valid\", 1)]\nID_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"direct_is_fallthrough\", 1), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nEX_FIELDS = [(name, 32) for name in (\"pc\", \"alu_result\", \"effective_addr\", \"write_data\")] + [\n    (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32),\n    (\"rs2_val\", 32), (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5)] + [\n    (name, 32) for name in (\"rs1_val\", \"rs2_val\", \"pc_next\", \"mem_addr\", \"mem_rdata\", \"mem_wdata\")\n] + [(\"mem_wmask\", 4), (\"mem_rmask\", 4), (\"ctrl\", sum(w for _, w in CTRL_FIELDS)),\n     (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, **values):\n    result = 0\n    for name, width in fields:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpack(fields, value):\n    result = {}\n    for name, width in reversed(fields):\n        result[name] = value & ((1 << width) - 1)\n        value >>= width\n    assert value == 0\n    return result\n\n\ndef _branch_condition(funct3, a, b):\n    sa = a if a < 0x80000000 else a - (1 << 32)\n    sb = b if b < 0x80000000 else b - (1 << 32)\n    return {0: a == b, 1: a != b, 4: sa < sb, 5: sa >= sb,\n            6: a < b, 7: a >= b}.get(funct3, False)\n\n\ndef _forward_reference(source, ex_rd, ex_write, wb_rd, wb_write):\n    \"\"\"Original combinational ownership rule; validity is deliberately absent.\"\"\"\n    if ex_write and ex_rd and ex_rd == source:\n        return 1\n    if wb_write and wb_rd and wb_rd == source:\n        return 2\n    return 0\n\n\n# ── RV32I instruction encoder helpers ──────────────────────────────────────\ndef _r(funct7, rs2, rs1, funct3, rd, opcode):\n    return ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef _i(imm, rs1, funct3, rd, opcode):\n","exit_code":0,"status":"completed"}}
