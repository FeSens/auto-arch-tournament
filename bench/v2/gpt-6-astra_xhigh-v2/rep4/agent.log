{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\n\nMASK = (1 << 32) - 1\ncounts = [set() for _ in range(11)]\n\ndef network(a, d):\n    q = r = 0\n    multiples = [k * d for k in range(8)]\n    for stage, w in enumerate(range(2, 33, 3)):\n        bits = 2 if stage == 0 else 3\n        kmax = (1 << bits) - 1\n        mask = (1 << w) - 1\n        t = (r << bits) | ((a >> (32 - w)) & kmax)\n        assert t <= mask\n        diff = [t] + [(t - (multiples[k] & mask)) & ((1 << (w+1))-1) for k in range(1, kmax+1)]\n        ge = [True] + [not (diff[k] >> w) and not (multiples[k] >> w) for k in range(1, kmax+1)] + [False]\n        onehot = [int(ge[k] and not ge[k+1]) for k in range(kmax+1)]\n        assert sum(onehot) == 1\n        r = digit = 0\n        for k in range(kmax+1):\n            r |= (diff[k] & mask) * onehot[k]\n            digit |= k * onehot[k]\n        counts[stage].add(digit)\n        q = (q << bits) | digit\n    return q, r\n\ndef signed(x):\n    return x if x < (1<<31) else x - (1<<32)\n\ndef verify(a, b):\n    q, r = network(a, b)\n    assert (q, r) == (divmod(a,b) if b else (MASK,a)), (a,b,q,r)\n    sa, sb = signed(a), signed(b)\n    q, r = network(abs(sa), abs(sb))\n    if (sa < 0) \"'!= (sb < 0):\n        q = -q\n    if sa < 0:\n        r = -r\n    if not b:\n        q, r = MASK, a\n    refq = abs(sa)//abs(sb) if sb else MASK\n    if sb and ((sa < 0) != (sb < 0)):\n        refq = -refq\n    refr = sa-refq*sb if sb else sa\n    assert (q & MASK, r & MASK) == (refq & MASK, refr & MASK), (a,b,q,r)\n\npairs = {(a,b) for a in range(128) for b in range(128)}\nedge = {0,1,2,3,7,8,9,MASK,1<<31,(1<<31)-1}\nfor w in range(1,33):\n    for offset in (-1,0,1):\n        edge.add(((1<<w)+offset) & MASK)\npairs.update((a,b) for a in edge for b in edge)\nfor w in range(2,33,3):\n    for k in range(1,8):\n        for off in (-1,0,1):\n            d = ((1 << w)//k + off) & MASK\n            for a in (((1<<w)-1) & MASK, (k*d-1) & MASK, (k*d) & MASK, (k*d+1) & MASK):\n                pairs.add((a,d))\nrng = Random(20261002)\npairs.update((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(20000))\nfor a,b in pairs:\n    verify(a,b)\nassert counts[0] == set(range(4))\nassert all(s == set(range(8)) for s in counts[1:])\nprint(f'\"'Algorithm model passed {len(pairs)} operand pairs in both unsigned and signed modes.')\nprint('All quotient digits exercised at every stage; high-bit guards and one-hot uniqueness checked.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\n\nMASK = (1 << 32) - 1\ncounts = [set() for _ in range(11)]\n\ndef network(a, d):\n    q = r = 0\n    multiples = [k * d for k in range(8)]\n    for stage, w in enumerate(range(2, 33, 3)):\n        bits = 2 if stage == 0 else 3\n        kmax = (1 << bits) - 1\n        mask = (1 << w) - 1\n        t = (r << bits) | ((a >> (32 - w)) & kmax)\n        assert t <= mask\n        diff = [t] + [(t - (multiples[k] & mask)) & ((1 << (w+1))-1) for k in range(1, kmax+1)]\n        ge = [True] + [not (diff[k] >> w) and not (multiples[k] >> w) for k in range(1, kmax+1)] + [False]\n        onehot = [int(ge[k] and not ge[k+1]) for k in range(kmax+1)]\n        assert sum(onehot) == 1\n        r = digit = 0\n        for k in range(kmax+1):\n            r |= (diff[k] & mask) * onehot[k]\n            digit |= k * onehot[k]\n        counts[stage].add(digit)\n        q = (q << bits) | digit\n    return q, r\n\ndef signed(x):\n    return x if x < (1<<31) else x - (1<<32)\n\ndef verify(a, b):\n    q, r = network(a, b)\n    assert (q, r) == (divmod(a,b) if b else (MASK,a)), (a,b,q,r)\n    sa, sb = signed(a), signed(b)\n    q, r = network(abs(sa), abs(sb))\n    if (sa < 0) \"'!= (sb < 0):\n        q = -q\n    if sa < 0:\n        r = -r\n    if not b:\n        q, r = MASK, a\n    refq = abs(sa)//abs(sb) if sb else MASK\n    if sb and ((sa < 0) != (sb < 0)):\n        refq = -refq\n    refr = sa-refq*sb if sb else sa\n    assert (q & MASK, r & MASK) == (refq & MASK, refr & MASK), (a,b,q,r)\n\npairs = {(a,b) for a in range(128) for b in range(128)}\nedge = {0,1,2,3,7,8,9,MASK,1<<31,(1<<31)-1}\nfor w in range(1,33):\n    for offset in (-1,0,1):\n        edge.add(((1<<w)+offset) & MASK)\npairs.update((a,b) for a in edge for b in edge)\nfor w in range(2,33,3):\n    for k in range(1,8):\n        for off in (-1,0,1):\n            d = ((1 << w)//k + off) & MASK\n            for a in (((1<<w)-1) & MASK, (k*d-1) & MASK, (k*d) & MASK, (k*d+1) & MASK):\n                pairs.add((a,d))\nrng = Random(20261002)\npairs.update((rng.getrandbits(32),rng.getrandbits(32)) for _ in range(20000))\nfor a,b in pairs:\n    verify(a,b)\nassert counts[0] == set(range(4))\nassert all(s == set(range(8)) for s in counts[1:])\nprint(f'\"'Algorithm model passed {len(pairs)} operand pairs in both unsigned and signed modes.')\nprint('All quotient digits exercised at every stage; high-bit guards and one-hot uniqueness checked.')\nPY\"","aggregated_output":"Algorithm model passed 45380 operand pairs in both unsigned and signed modes.\nAll quotient digits exercised at every stage; high-bit guards and one-hot uniqueness checked.\n","exit_code":0,"status":"completed"}}
