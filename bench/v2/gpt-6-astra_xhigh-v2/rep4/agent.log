{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,95p' cores/bench/test/conftest.py\nsed -n '1,100p' cores/bench/test/test_pipeline.py\nsed -n '200,278p' tools/eval/fpga.py\nsed -n '1,100p' tools/eval/_slots.py\"", "aggregated_output": "\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nALTOPS = os.environ.get(\"ALTOPS\") == \"1\"\nMASK32 = 0xffffffff\n\n# Packed bundle layouts, MSB first. Keep widths explicit so these checks\n# observe the instruction's saved prediction, never a fresh BHT lookup.\nCTRL_FIELDS = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3)] + [\n    (name, 1) for name in (\"is_branch\", \"is_jump\", \"is_jalr\", \"is_lui\",\n                          \"is_auipc\", \"mem_read\", \"mem_write\")\n] + [(\"mem_width\", 2)] + [(name, 1) for name in\n    (\"mem_sext\", \"reg_write\", \"mem_to_reg\", \"is_illegal\")]\nIF_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"instr\", 32), (\"valid\", 1)]\nID_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"direct_is_fallthrough\", 1), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\n\n\ndef _pack(fields, **values):\n    result = 0\n    for name, width in fields:\n        result = (result << width) | (values.get(name, 0) & ((1 << width) - 1))\n    return result\n\n\ndef _unpac\n…[7307 of 10379 chars elided by tools/bench/transcript.py; sha256:d0a504bd0e79b3f2]…\n   d = Path(lock_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    started, told = time.time(), False\n    while True:\n        for i in range(n):\n            f = open(d / f\"slot{i}.lock\", \"w\")\n            try:\n                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except BlockingIOError:\n                f.close()\n                continue\n            waited = time.time() - started\n            if waited > 60:\n                print(f\"  [eval] {what}: got host eval slot {i} after {waited:.0f}s\", flush=True)\n            try:\n                yield\n            finally:\n                fcntl.flock(f, fcntl.LOCK_UN)\n                f.close()\n            return\n        if not told:\n            print(f\"  [eval] {what}: waiting for a host eval slot ({n} busy)\", flush=True)\n            told = True\n        time.sleep(5)\n\n\ndef eval_jobs(default: str | None = None) -> str | None:\n    \"\"\"make -j for a formal run holding a slot (HARNESS_EVAL_JOBS).\"\"\"\n    return os.environ.get(\"HARNESS_EVAL_JOBS\") or default\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/92f133a1/3ee3cbb4/make_queue.py <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/92f133a1/3ee3cbb4')\nfor depth in [1,2,4]:\n dst=root/f'q{depth}'/'rtl'; shutil.copytree(Path('cores/bench/rtl'),dst,dirs_exist_ok=True)\n p=dst/'core.sv'; s=p.read_text()\n s=s.replace('logic       execute_wait;', 'logic       execute_wait;\\\\n  logic       fetch_available;')\n s=s.replace('.stall           (stall_if),','.stall           (stall_id),\\\\n    .imem_ready      (io_imemReady),\\\\n    .available       (fetch_available),')\n s=s.replace('.imem_ready     (io_imemReady)', '.imem_ready     (fetch_available)')\n p.write_text(s)\n p=dst/'if_stage.sv'; s=p.read_text()\n s=s.replace('input  logic              flush,', 'input  logic              imem_ready,\\\\n  output logic              available,\\\\n  input  logic              flush,')\n pos=s.index('  // Recovery overrides')\n s=s[:pos]+'''  localparam integer DEPTH = @DEPTH@;\n  localparam integer COUNT_W = \"'$clog2(DEPTH+1);\n  logic [COUNT_W-1:0] count;\n  logic [64:0] entries [0:DEPTH-1];\n  logic consume, pop, accept, append, bypass, boundary_hold;\n  logic [COUNT_W-1:0] append_index;\n  logic [31:0] head_pc, head_instr, head_imm;\n  logic head_prediction;\n\n  assign available = count != 0 || imem_ready;\n  assign consume = available && !stall;\n  assign pop = count != 0 && consume;\n  assign boundary_hold = pc == 32'\"'h000ffffc && (count \"'!= 0 || stall);\n  assign accept = imem_ready && ((count < DEPTH) || pop) && !boundary_hold;\n  assign bypass = count == 0 && consume;\n  assign append = accept && !bypass;\n  assign append_index = count - {{(COUNT_W-1){1'\"'b0}}, pop};\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      pc <= RESET_PC;\n      count <= 0;\n    end else if (redirect) begin\n      pc <= redirect_target;\n      count <= 0;\n    end else begin\n      if (accept) pc <= predicted_next_pc;\n      case ({append, pop})\n        2'b10: count <= count + 1'b1;\n        2'b01: count <= count - 1'b1;\n        default: ;\n      endcase\n    end\n  end\n  for (genvar j=0; j<DEPTH; j++) begin : g_queue\n    always_ff @(posedge clock) begin\n      if (append && append_index == COUNT_W'(j))\n        entries[j] <= {pc,imem_data,predicted_direct};\n      else if (pop) begin\n        if (j < DEPTH-1) entries[j] <= entries[j+1];\n      end\n    end\n  end\n  assign imem_addr = pc;\n  always_comb begin\n    head_pc = count \"'!= 0 ? entries[0][64:33] : pc;\n    head_instr = count != 0 ? entries[0][32:1] : imem_data;\n    head_prediction = count != 0 ? entries[0][0] : predicted_direct;\n    head_imm = head_instr[6:0] == 7'\"'b1101111\n               ? {{11{head_instr[31]}}, head_instr[31], head_instr[19:12],\n                  head_instr[20], head_instr[30:21], 1'b0}\n               : {{19{head_instr[31]}}, head_instr[31], head_instr[7],\n                  head_instr[30:25], head_instr[11:8], 1'b0};\n    out.pc = head_pc;\n    out.predicted_direct = head_prediction;\n    out.predicted_next_pc = head_prediction ? head_pc + head_imm : head_pc + 32'd4;\n    out.instr = flush ? 32'h00000013 : head_instr;\n    out.valid = \"'!(flush || redirect);\n  end\nendmodule\n'\"'''.replace('@DEPTH@',str(depth))\n p.write_text(s)\nprint('Created isolated queue prototypes')\nPY\npython3 /srv/hwebench/tmp/92f133a1/3ee3cbb4/make_queue.py\nNRET=1 RTL_DIR=/srv/hwebench/tmp/92f133a1/3ee3cbb4/q2/rtl OBJ_DIR=/srv/hwebench/tmp/92f133a1/3ee3cbb4/q2/obj bash test/cosim/build.sh > /srv/hwebench/tmp/92f133a1/3ee3cbb4/q2/build.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
