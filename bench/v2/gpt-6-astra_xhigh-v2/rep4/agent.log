n    (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32),\n    (\"rs2_val\", 32), (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5)] + [\n    (name, 32) for name in (\"rs1_val\", \"rs2_val\", \"pc_next\", \"mem_addr\", \"mem_rdata\", \"mem_wdata\")\n] + [(\n…[16800 of 19872 chars elided by tools/bench/transcript.py; sha256:a298920532889ed3]…\ntoken else (pc + 4) & MASK32)\n1461:async def unit_id_squash_beats_hold(dut):\n1480:                               predicted_direct=1, predicted_next_pc=0x104)\n1485:        assert _unpack(ID_FIELDS, saved)[\"predicted_direct\"] == 1\n1500:async def unit_hazard_recovery_priority(dut):\n1518:        hazard = load and not zero_rd\n1522:        assert int(dut.stall_id.value) == bool(dhold or execute_wait or hazard)\n1523:        assert int(dut.flush_id.value) == bool((redirect or hazard) and not dhold and not execute_wait)\n1524:        assert int(dut.stall_if.value) == bool(hazard or not ir or dhold or execute_wait)\n1528:async def unit_forward_capture_priority(dut):\n1579:    (\"if_stage\", \"unit_if_guarded_token\"),\n1581:    (\"hazard_unit\", \"unit_hazard_recovery_priority\"),\n1584:def test_recovery_units_runner(top, testcase):\n1597:def test_arithmetic_route_runner(altops):\n1612:def test_pipeline_runner(altops):\n1617:            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n1619:            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
