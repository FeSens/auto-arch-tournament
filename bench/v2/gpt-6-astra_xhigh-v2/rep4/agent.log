e(3)==0; bpc=rng.randrange(128)*4; taken=rng.randrange(2)\n        avail=bool(q) or ready; consume=avail and not hold\n        boundary=pc>=0x100000 or pc%4!=0 or pc==0xffffc\n        accept=ready and (len(q)<2 or consume) and (not boundary or (not q and consume))\n        npc,bit=predict(pc,insn,counters)\n        raw=(pc,npc,bit,insn)\n        head=q[0] if q else raw\n        dut.imem_data.value=insn;dut.bus_ready.value=int(ready);dut.stall.value=int(hold)\n        dut.flush.value=int(not avail);dut.redirect.value=int(redirect);dut.redirect_target.value=target\n        dut.branch_update.value=int(update);dut.branch_pc.value=bpc;dut.branch_taken.value=taken\n        await Timer(5,unit='\"'ns')\n        assert int(dut.imem_addr.value)==pc\n        assert int(dut.available.value)==avail\n        val=int(dut.out.value)\n        valid=val&1;val>>=1\n        oi=val&MASK;val>>=32\n        ob=val&1;val>>=1\n        on=val&MASK;val>>=32\n        op=val\n        assert (op,on,ob,oi,valid)==(*head[:3],head[3] if avail else 0x13,int(avail and not redirect))\n        pop=bool(q) and consume\n        append=accept and (bool(q) or not consume)\n        counts['full_exchange']+=int(len(q)==2 and pop and append)\n        counts['empty_bypass']+=int(not q and accept and consume)\n        counts['buffered_stall']+=int(bool(q) and not ready and consume)\n        counts['boundary']+=int(boundary)\n        counts['recovery']+=int(redirect)\n        if update:counters[(bpc>>2)&127]=max(0,min(3,counters[(bpc>>2)&127]+(1 if taken else -1)))\n        if redirect:q=[];pc=target\n        else:\n            if pop:q.pop(0)\n            if append:q.append(raw)\n            if accept:pc=npc\n        dut.clock.value=1;await Timer(5,unit='ns')\n    assert all(v>10 for v in counts.values()),counts\n    dut._log.info('Coverage %s',counts)\nPY\npython - <<'PY' > cores/bench/generated/two_probe/queue_test.log 2>&1\nfrom pathlib import Path\nfrom cocotb_tools.runner import get_runner\nroot=Path('cores/bench/generated/two_probe').resolve()\nr=get_runner('verilator')\nr.build(sources=[root/'rtl/core_pkg.sv',root/'rtl/if_stage.sv'],hdl_toplevel='if_stage',build_dir=root/'queue_build',build_args=['-Wall','-Wno-fatal','-Wno-style'],always=True)\nr.test(hdl_toplevel='if_stage',test_module='test_queue_probe',test_dir=root/'test',build_dir=root/'queue_build')\nPY\"", "aggregated_output": "", "exit_code": 0, "status": "completed"}}
