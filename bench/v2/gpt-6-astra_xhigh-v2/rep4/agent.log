afe_load(p.read_text());validate(d,json.loads(Path('schemas/hypothesis.schema.json').read_text()))\nprint('Schema valid:',d['id'],d['category'])\nPY\ncat cores/bench/generated/research_r13s0/shared_shift/timing.log\"", "aggregated_output": "Schema valid: hyp-20261003-001-r13s0 micro_opt\n[{'place_option': 1, 'placement_failed': False, 'fmax_mhz': 75.958, 'levels': 18, 'logic': 4975, 'regs': 1832, 'lutram': 0, 'bsram': 4, 'dsp': 6, 'critical_paths': [{'from': 'cpu/u_ex/u_alu/divisor_q_28_s0', 'to': 'cpu/u_ex/u_alu/quotient_q_0_s1', 'slack_ns': -8.165, 'arrival_ns': 18.46, 'logic_cells': 22, 'modules': ['clock_ibuf', 'cpu/u_ex/u_alu']}, {'from': 'cpu/u_fwd/fwd_rs2_1_s0', 'to': 'cpu/u_if/pc_2_s1', 'slack_ns': -8.161, 'arrival_ns': 18.455, 'logic_cells': 11, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_if']}, {'from': 'cpu/u_fwd/fwd_rs2_1_s0', 'to': 'cpu/u_if/counters[113]_0_s0', 'slack_ns': -8.158, 'arrival_ns': 18.452, 'logic_cells': 10, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_if']}, {'from': 'cpu/u_fwd/fwd_rs2_1_s0', 'to': 'cpu/u_if/counters[113]_1_s0', 'slack_ns': -8.158, 'arrival_ns': 18.452, 'logic_cells': 10, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_if']}, {'from': 'cpu/u_fwd/fwd_rs1_0_s0', 'to': 'cpu/u_ex/reg_q.alu_result_14_s0', 'slack_ns': -8.153, 'arrival_ns': 18.448, 'logic_cells': 13, 'modules': ['clock_ibuf', 'cpu/u_ex', 'cpu/u_ex/u_alu', 'cpu/u_ex']}]}]\n", "exit_code": 0, "status": "completed"}}
