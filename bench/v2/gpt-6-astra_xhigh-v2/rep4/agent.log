{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport os\nimport subprocess\nimport tempfile\nfrom pathlib import Path\nfrom tools.eval.fpga import run_coremark_ipc\nimport json\nresult = run_coremark_ipc('.', str(Path('cores/bench/obj_dir/cosim_sim').resolve()))\nprint(json.dumps(result, indent=2))\nPath(os.environ['TMPDIR'], 'divider-coremark.json').write_text(json.dumps(result, indent=2))\nassert result['completed'] and result['cycles'] == 4202272 and result['iterations'] == 10\nprint('Exact fitness:', 48.327 * 1_000_000 * result['iterations'] / result['cycles'])\nwith tempfile.TemporaryDirectory(dir=os.environ['TMPDIR'], prefix='divider-prefix-') as scratch:\n    miter = Path(scratch) / 'miter.sv'\n    miter.write_text('''module prefix_miter(input [31:0] a, d, output equal);\nwire [1:0] qp, rp;\nalu dut(.clock(1'b0), .reset(1'b0), .div_request(1'b0),\n        .div_consume(1'b0), .op(5'd16), .a(a), .b(d),\n        .quotient_prefix(qp), .remainder_prefix(rp));\nwire [31:0] q [0:2];\nwire [31:0] r [0:2];\nwire [32:0] trial [0:1];\nwire [33:0] diff [0:1];\nassign q[0] = a;\nassign r[0] = 0;\nfor (genvar i = 0; i < 2; i = i + 1) begin\n  assign trial[i] = {r[i], q[i][31]};\n  assign diff[i] = {1'b0, trial[i]} - {2'b0, d};\n  assign r[i+1] = diff[i][33] ? trial[i][31:0] : diff[i][31:0];\n  assign q[i+1] = {q[i][30:0], \"'!diff[i][33]};\nend\nassign equal = (q[2] == {a[29:0], qp}) && (r[2] == {30'\"'b0, rp});\nendmodule\n''')\n    script = f'read_verilog -sv -Icores/bench/rtl cores/bench/rtl/alu.sv; proc; expose alu/quotient_prefix alu/remainder_prefix; read_verilog -sv {miter}; hierarchy -top prefix_miter; flatten; opt; sat -verify -prove equal 1 -show-inputs'\n    proof = subprocess.run(['yosys', '-Q', '-T', '-p', script], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)\n    Path(os.environ['TMPDIR'], 'divider-prefix-proof.log').write_text(proof.stdout)\n    print(proof.stdout[-2500:])\n    assert proof.returncode == 0\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
