{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -c \"set -e\ncat > /srv/hwebench/tmp/92f133a1/46322b65/r14_address_equiv.v <<'EOF'\nmodule address_equiv(input [31:0] a,b,c,i, input [1:0] s, output ok);\nwire [31:0] chosen = s == 1 ? b : s == 2 ? c : a;\nwire [31:0] before_sum = chosen + i;\nwire [31:0] sa=a+i, sb=b+i, sc=c+i;\nwire [31:0] after_sum = s == 1 ? sb : s == 2 ? sc : sa;\nassign ok = before_sum == after_sum;\nendmodule\nEOF\nyosys -Q -T -p 'read_verilog /srv/hwebench/tmp/92f133a1/46322b65/r14_address_equiv.v; prep -top address_equiv; sat -verify -prove ok 1 -show-inputs' > /srv/hwebench/tmp/92f133a1/46322b65/r14-address-equiv.log\nrg 'SUCCESS|FAIL' /srv/hwebench/tmp/92f133a1/46322b65/r14-address-equiv.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
