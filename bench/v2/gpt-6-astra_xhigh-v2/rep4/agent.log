{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nout=Path('cores/bench/generated/research_r13s0/grouped_shift_miter.sv')\ns='''module grouped_shift_miter(input [31:0] a,b, input [1:0] kind, output ok);\nwire left = kind==0;\nwire fill = kind==2 && a[31];\nwire [31:0] rev_a,x,s1,s2,s3,y;\nwire [3:0] low,mid;\nfor(genvar k=0;k<32;k++) begin\n assign rev_a[k]=a[31-k];\n assign y[k]=left ? s3[31-k] : s3[k];\nend\nassign x=left ? rev_a:a;\nfor(genvar k=0;k<4;k++) begin\n assign low[k]=b[1:0]==2'(k);\n assign mid[k]=b[3:2]==2'(k);\nend\nassign s1=(x & {32{low[0]}})\n | ({fill,x[31:1]} & {32{low[1]}})\n | ({{2{fill}},x[31:2]} & {32{low[2]}})\n | ({{3{fill}},x[31:3]} & {32{low[3]}});\nassign s2=(s1 & {32{mid[0]}})\n | ({{4{fill}},s1[31:4]} & {32{mid[1]}})\n | ({{8{fill}},s1[31:8]} & {32{mid[2]}})\n | ({{12{fill}},s1[31:12]} & {32{mid[3]}});\nassign s3=b[4] ? {{16{fill}},s2[31:16]} : s2;\nreg [31:0] expected;\nalways @* case(kind)\n 0:expected=a << b[4:0];\n 1:expected=a >> b[4:0];\n 2:expected=\"'$signed(a) >>> b[4:0];\n default:expected=y;\nendcase\nassign ok=y==expected;\nendmodule\n'\"'''\nout.write_text(s)\nPY\nyosys -Q -T -p 'read_verilog -sv cores/bench/generated/research_r13s0/grouped_shift_miter.sv; prep -top grouped_shift_miter -flatten; sat -verify -prove ok 1 -show-inputs' > cores/bench/generated/research_r13s0/grouped-shift-equivalence.log 2>&1\nrg 'SUCCESS|FAIL' cores/bench/generated/research_r13s0/grouped-shift-equivalence.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
