    \"\"\"Distinguish all final quotient-bit pairs and unsigned borrow cases.\"\"\"\n    await _setup(dut)\n    pairs = []\n    for divisor in (1, 3, 7, 0x10001):\n        for low_bits in range(4):\n            quotient = 0x2340 | low_bits\n            for remainder in (0, divisor - 1):\n              \n…[3555 of 6627 chars elided by tools/bench/transcript.py; sha256:2e519707ca28b069]…\ntend((a, b) for a in sorted(dividends) if 0 <= a <= MASK32)\n    rng = random.Random(0x4FAB31C)\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(1200))\n    for index, (a, b) in enumerate(pairs):\n        for op in DIV_OPS:\n            await _check_div(dut, op, a, b, _reference(op, a, b),\n                             hold=2 if index % 97 == 0 else 0)\n\n\n@cocotb.test()\nasync def division_signed_deep_counterexamples(dut):\n    \"\"\"Keep architectural signed results for the unchanged deep-check traces.\"\"\"\n    await _setup(dut)\n    await _check_div(dut, ALU_DIV, 0xf1aea008, MASK32, 0x0e515ff8, hold=3)\n    await _check_div(dut, ALU_REM, 0x89001000, 0x3cffc000, 0xc5ffd000, hold=3)\n    for a, b in ((0xf1aea008, MASK32), (0x89001000, 0x3cffc000)):\n        for op in DIV_OPS:\n            await _check_div(dut, op, a, b, _reference(op, a, b))\n\n\n@cocotb.test()\nasync def reset_cancels_division(dut):\n    for edges in range(9):  # all eight iteration phases and completed-but-held\n        await _setup(dut)\n", "exit_code": 0, "status": "completed"}}
