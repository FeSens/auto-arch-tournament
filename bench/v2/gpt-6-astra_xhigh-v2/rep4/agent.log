{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -c \"sed -n '300,390p' cores/bench/test/test_alu.py\"","aggregated_output":"    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def division_vectors_and_completion_hold(dut):\n    await _setup(dut)\n    extremes = (0, 1, 2, 3, 0x7ffffffe, 0x7fffffff, 0x80000000,\n                0x80000001, 0xfffffffe, MASK32)\n    pairs = [(a, b) for a in extremes for b in extremes]\n    for bit in range(32):\n        pairs.extend([(MASK32, 1 << bit), (1 << bit, MASK32),\n                      (0x80000000, 1 << bit), ((1 << bit) - 1, 1 << bit)])\n    rng = random.Random(0xD1A1DE)\n    pairs.extend((rng.getrandbits(32), rng.getrandbits(32)) for _ in range(400))\n    for op in DIV_OPS:\n        for index, (a, b) in enumerate(pairs):\n            await _check_div(dut, op, a, b, _reference(op, a, b),\n                             hold=3 if index % 17 == 0 else 0)\n\n\n@cocotb.test()\nasync def reset_cancels_division(dut):\n    for edges in range(5):  # launch, each busy phase, and completed-but-held\n        await _setup(dut)\n        dut.op.value = ALU_DIV\n        dut.a.value = 0x80000000\n        dut.b.value = 3\n        dut.div_request.value = 1\n        await _tick(dut)\n        dut.div_request.value = 0\n        for _ in range(edges):\n            await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(6):\n            await _tick(dut)\n            assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n        await _check_div(dut, ALU_REM, 0xfffffff6, 3, MASK32)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_alu_runner(altops):\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    root = Path(__file__).resolve().parent.parent\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build = root / \"sim_build\" / (\"alu_altops\" if altops else \"alu\")\n    runner.build(sources=[root / \"rtl\" / s for s in (\"core_pkg.sv\", \"alu.sv\")],\n                 hdl_toplevel=\"alu\", build_dir=build, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"-DRISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu\",\n                test_dir=root / \"test\", build_dir=build,\n                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n","exit_code":0,"status":"completed"}}
