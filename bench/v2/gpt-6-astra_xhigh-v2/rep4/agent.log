{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/bash -c \"cat > /srv/hwebench/tmp/92f133a1/1c1fa12b/r9probe/test_queue.py <<'PY'\nfrom pathlib import Path\nimport os, random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nMASK=(1<<32)-1\n\ndef predict(pc,insn,counts):\n    op=insn&127\n    if op==0x6f:\n        imm=((insn>>31)<<20)|(((insn>>12)&255)<<12)|(((insn>>20)&1)<<11)|(((insn>>21)&1023)<<1)\n        if imm&(1<<20): imm-=1<<21\n    else:\n        imm=((insn>>31)<<12)|(((insn>>7)&1)<<11)|(((insn>>25)&63)<<5)|(((insn>>8)&15)<<1)\n        if imm&(1<<12): imm-=1<<13\n    target=(pc+imm)&MASK\n    direct=(op==0x6f or (op==0x63 and ((insn>>12)&7) not in (2,3) and counts[(pc>>2)&127]>=2)) and target%4==0 and target<0x100000\n    return (pc, target if direct else (pc+4)&MASK, int(direct), insn)\n\n@cocotb.test()\nasync def model(dut):\n    rng=random.Random(9183); pc=0; q=[]; counts=[1]*128\n    covers=dict(full=0,buffered_stall=0,recovery=0,boundary=0,replace=0)\n    for cycle in range(6000):\n        reset=cycle==0 or rng.randrange(250)==0\n        ready=rng.randrange(5)\"'!=0; hold=rng.randrange(2)==0\n        redirect=rng.randrange(12)==0\n        dest=rng.choice([rng.randrange(1024)*4,0xffff8,0xffffc,0x100000,0xfffffffc,0xfffffffe,0x82,0])\n        insn=rng.getrandbits(32)\n        insn=(insn&~127)|rng.choice([0x63,0x6f,0x67,0x13,0x23,0x03,0x33])\n        update=rng.randrange(3)==0; bpc=rng.choice([pc,rng.getrandbits(32)]); taken=rng.randrange(2)\n        available=bool(q) or ready\n        for name,val in dict(clock=0,reset=reset,bus_ready=ready,decode_hold=hold,flush=not available,redirect=redirect,redirect_target=dest,imem_data=insn,branch_update=update,branch_pc=bpc,branch_taken=taken).items():\n            getattr(dut,name).value=val\n        await Timer(2,'\"'ns')\n        if cycle:\n            assert int(dut.imem_addr.value)==pc,(cycle,hex(pc),hex(int(dut.imem_addr.value)))\n            assert int(dut.available.value)==available\n            bits=int(dut.out.value)\n            valid=bits&1; bits>>=1\n            outinsn=bits&MASK; bits>>=32\n            direct=bits&1; bits>>=1\n            nextpc=bits&MASK; bits>>=32\n            outpc=bits&MASK\n            expected=q[0] if q else predict(pc,insn,counts)\n            assert (outpc,nextpc,direct)==expected[:3],(cycle,expected,(outpc,nextpc,direct))\n            assert outinsn==(expected[3] if available else 0x13)\n            assert valid==(available and not redirect)\n        pop=bool(q) and available and not hold\n        compact=pc%4==0 and pc<0x100000 and pc\"'!=0xffffc\n        accept=ready and (len(q)<2 or pop) and (compact or (not q and available and not hold))\n        append=accept and (bool(q) or not (available and not hold))\n        oldlen=len(q); payload=predict(pc,insn,counts)\n        if not reset and not redirect:\n            covers['\"'full']+=oldlen==2 and pop and append\n            covers['buffered_stall']+=pop and not ready\n            covers['replace']+=oldlen==1 and pop and append\n            covers['boundary']+=not compact\n            if pop:q.pop(0)\n            if append:q.append(payload)\n            if accept:pc=payload[1]\n        elif reset:\n            pc=0;q=[]\n        else:\n            pc=dest;q=[];covers['recovery']+=1\n        if reset:counts=[1]*128\n        elif update:\n            index=(bpc>>2)&127\n            counts[index]=max(0,min(3,counts[index]+(1 if taken else -1)))\n        dut.clock.value=1\n        await Timer(2,'ns')\n        dut.clock.value=0\n    assert all(v>20 for v in covers.values()),covers\n    print('COVERAGE',covers)\n\nif __name__=='__main__':\n    root=Path.cwd();temp=Path(__file__).parent\n    r=get_runner('verilator')\n    r.build(sources=[root/'cores/bench/rtl/core_pkg.sv',root/'cores/bench/rtl/if_stage.sv'],hdl_toplevel='if_stage',build_dir=temp/'model_build',build_args=['-Wall','-Wno-fatal','-Wno