t(op, a, b)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value \n…[20973 of 24045 chars elided by tools/bench/transcript.py; sha256:93850a97cdbc0b52]…\n \"cycle\":     cycle,\n            }\n            assert r[\"order\"] == len(retirements), \"non-contiguous RVFI order\"\n            if retirements:\n                assert retirements[-1][\"pc_next\"] == r[\"pc\"], \"broken RVFI PC chain\"\n            assert r[\"insn\"] == imem.get(r[\"pc\"], EBREAK())\n            retirements.append(r)\n\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        captured = _unpack(ID_FIELDS, int(dut.id_ex_w.value))\n        if sample[\"flush_id\"]:\n            assert int(dut.id_ex_w.value) == 0, \"squash left executable controls\"\n        elif sample[\"stall_id\"]:\n            assert int(dut.id_ex_w.value) == sample[\"id_payload\"], \"held prediction changed\"\n        else:\n            for field in (\"pc\", \"instr\", \"valid\", \"predicted_direct\", \"predicted_next_pc\"):\n                assert captured[field] == fetched[field], (field, captured, fetched)\n            assert captured[\"direct_is_fallthrough\"] == (captured[\"imm\"] == 4)\n        if stop_when is not None and stop_when(sample):\n            break\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c \"cat formal/run_all.sh; sed -n '1,240p' tools/eval/gowin.py; rg -n 'def |coremark|argparse|random|stall' tools/eval/cosim.py tools/eval/fpga.py test/cosim/run_cosim.py\"", "aggregated_output": "#!/usr/bin/env bash\n# Run riscv-formal checks against the current $RTL_DIR/*.sv.\n# Requires: formal/riscv-formal cloned (manual clone or `git submodule init`).\n#\n# Stages every $RTL_DIR/*.sv plus wrapper.sv + the chosen checks config under\n# the riscv-formal tree, then runs sby -> bitwuzla via the framework's\n# generated makefile. Tallies PASS/FAIL by inspecting each task's\n# logfile.txt.\n#\n# Usage: bash formal/run_all.sh [checks-cfg-path]\n#   default: formal/checks.cfg       (fast, ALTOPS, used by orchestrator)\n#   deep   : formal/checks-deep.cfg  (no ALTOPS, proves M-ext arithmetic)\n#\n# Env vars (orchestrator-driven, override $1 and defaults):\n#   WRAPPER     — path to wrapper SV (default formal/wrapper.sv)\n#   CHECKS_CFG  — path to checks config (default formal/checks.cfg)\n# When BOTH are unset, the script auto-detects nret from\n# cores/$CORE_NAME/core.yaml: nret=1 routes to wrapper_si.sv +\n# checks_si.cfg; nret=2 (or absent) uses the defaults. Agents\n# invoking `bash formal/run_all.sh` directly therefore get the\n# right wrapper without needing to know the env-var plumbing.\nset -e\n\nif [ -z \"${RTL_DIR:-}\" ] || [ -z \"${CORE_NAME:-}\" ]; then\n  echo \"ERROR: formal/run_all.sh requires RTL_DIR and CORE_NAME env vars.\" >&2\n  echo \"  Example: RTL_DIR=cores/v1/rtl CORE_NAME=v1 bash formal/run_all.sh formal/checks.cfg\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_ROOT=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nRISCV_FORMAL=\"$SCRIPT_DIR/riscv-formal\"\n# Per-invocation work dir + log, unique among every process sharing this\n# riscv-formal checkout (the K concurrent agents of a run share it through\n# their worktrees' symlink). The name used to be \"$CORE_NAME-$$\", but an\n# agent's sandboxed shell runs in its own PID namespace where $$ is 2 or 3\n# for every agent, so siblings wrote into one dir and wiped each other's\n# checks mid-SBY (V2 incident 03). mktemp gives a unique name instead.\n# FORMAL_WORK_ID pins the suffix so tools/eval/formal.py can remove exactly\n# its own dir afterwards. genchecks.py derives @core\n…[24147 of 27219 chars elided by tools/bench/transcript.py; sha256:71fe549ce89392f0]…\n500:]}'\ntools/eval/fpga.py:286:            return False, f'coremark_reported_error: {uart[-500:]}'\ntools/eval/fpga.py:287:        return False, f'coremark_validation_marker_missing: {uart[-500:]}'\ntools/eval/fpga.py:299:            return False, f'coremark_{name}_mismatch: expected 0x{expected:04x}, got {got}'\ntools/eval/fpga.py:303:        return False, f'coremark_iterations_mismatch: expected {iterations}, got {reported_iterations}'\ntools/eval/fpga.py:306:def _bench_sv(worktree: str, target: str | None) -> str:\ntools/eval/fpga.py:314:def measure_fmax(worktree: str, target: str, pairs=None) -> dict:\ntools/eval/fpga.py:330:def run_fpga_eval(worktree: str, target: str | None = None) -> dict:\ntools/eval/fpga.py:333:    Verilator CoreMark run (with random memory stalls) for cycles.\ntools/eval/fpga.py:341:        'ipc_coremark': float,           — iter/cycle\ntools/eval/fpga.py:372:    cm = run_coremark_ipc(worktree, sim_bin, env=env)\ntools/eval/fpga.py:385:        'ipc_coremark':  round(cm['iter_per_cycle'], 6),\n", "exit_code": 0, "status": "completed"}}
