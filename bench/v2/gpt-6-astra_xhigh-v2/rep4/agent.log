{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,280p' cores/bench/test/test_pipeline.py; rg -n '\"'^async def|''^def |''^@|stall|divide|forward|trap'\"' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM->EX), branches, JAL, JALR,\nSW+LW roundtrip, load-use stall, and the trap discipline (illegal /\nECALL trap, EBREAK does NOT trap).\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nALTOPS = os.environ.get(\"ALTOPS\") == \"1\"\nMASK32 = 0xffffffff\n\n# Packed bundle layouts, MSB first. Keep widths explicit so these checks\n# observe the instruction's saved prediction, never a fresh BHT lookup.\nCTRL_FIELDS = [(\"alu_op\", 5), (\"alu_src\", 1), (\"branch_op\", 3)] + [\n    (name, 1) for name in (\"is_branch\", \"is_jump\", \"is_jalr\", \"is_lui\",\n                          \"is_auipc\", \"mem_read\", \"mem_write\")\n] + [(\"mem_width\", 2)] + [(name, 1) for name in\n    (\"mem_sext\", \"reg_write\", \"mem_to_reg\", \"is_illegal\")]\nIF_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"instr\", 32), (\"valid\", 1)]\nID_FIELDS = [(\"pc\", 32), (\"predicted_next_pc\", 32), (\"predicted_direct\", 1),\n             (\"direct_is_fallthrough\", 1), (\"rs1_val\", 32), (\"rs2_val\", 32),\n             (\"imm\", 32), (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5),\n             (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nEX_FIELDS = [(name, 32) for name in (\"pc\", \"alu_result\", \"effective_addr\", \"write_data\")] + [\n    (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5), (\"rs1_val\", 32),\n    (\"rs2_val\", 32), (\"pc_next\", 32), (\"branch_taken\", 1), (\"branch_target\", 32),\n    (\"ctrl\", sum(w for _, w in CTRL_FIELDS)), (\"instr\", 32), (\"valid\", 1)]\nWB_FIELDS = [(\"pc\", 32), (\"alu_result\", 32), (\"read_data\", 32),\n             (\"rd\", 5), (\"rs1_addr\", 5), (\"rs2_addr\", 5)] + [\n    (name, 32) for name in (\"rs1_val\", \"rs2_val\", \"pc_next\", \"mem_addr\", \"mem_rdata\", \"mem_wdata\")\n] + [(\n…[20701 of 23773 chars elided by tools/bench/transcript.py; sha256:40fa843c6eb4280c]…\nut.stall.value = 0\n1317:        dut.stall.value = 1\n1336:                    await edge()  # recovery must override stall\n1355:@cocotb.test()\n1356:async def unit_id_squash_beats_hold(dut):\n1365:    dut.stall.value = 0\n1376:        dut.stall.value = 0\n1382:        dut.stall.value = 1\n1394:@cocotb.test()\n1395:async def unit_hazard_recovery_priority(dut):\n1415:        assert int(dut.stall_ex_mem.value) == dhold\n1417:        assert int(dut.stall_id.value) == bool(dhold or execute_wait or hazard)\n1419:        assert int(dut.stall_if.value) == bool(hazard or not ir or dhold or execute_wait)\n1422:@pytest.mark.parametrize(\"top,testcase\", [\n1429:def test_recovery_units_runner(top, testcase):\n1441:@pytest.mark.parametrize(\"altops\", [False, True])\n1442:def test_arithmetic_route_runner(altops):\n1451:                test_filter=r\"unit_ex_(divide_ownership|effective_address)\",\n1456:@pytest.mark.parametrize(\"altops\", [False, True])\n1457:def test_pipeline_runner(altops):\n1464:            \"hazard_unit.sv\", \"forward_unit.sv\",\n", "exit_code": 0, "status": "completed"}}
