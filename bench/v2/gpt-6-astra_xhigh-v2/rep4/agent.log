{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nroot=Path('cores/bench')\nfor name in ('core_pkg.sv','if_stage.sv','id_stage.sv','ex_stage.sv'):\n p=root/'rtl'/name\n s=p.read_text().replace('direct_recovery_pc','direct_target_pc')\n if name=='core_pkg.sv':\n  s=s.replace('    logic [31:0] direct_target_pc;','    logic [31:0] direct_target_pc;\\\\n    logic [31:0] fallthrough_pc;')\n elif name=='if_stage.sv':\n  s=s.replace('    out.direct_target_pc = direct_target;','    out.direct_target_pc = direct_target;\\\\n    out.fallthrough_pc = pc + 32\\\\'d4;')\n elif name=='id_stage.sv':\n  s=s.replace('      reg_q.direct_target_pc <= in.direct_target_pc;','      reg_q.direct_target_pc <= in.direct_target_pc;\\\\n      reg_q.fallthrough_pc <= in.fallthrough_pc;')\n elif name=='ex_stage.sv':\n  s=s.replace(\\\"in.pc + 32'd4\\\",'in.fallthrough_pc')\n  s=s.replace('branch_target = in.pc + in.imm;','branch_target = in.direct_target_pc;')\n  s=s.replace(': (in.pc + in.imm);',': in.direct_target_pc;')\n p.write_text(s)\np=root/'test/test_pipeline.py'\ns=p.read_text().replace('direct_recovery_pc','direct_target_pc')\ns=s.replace('(\\\"direct_target_pc\\\", 32), (\\\"predicted_direct\\\", 1)','(\\\"direct_target_pc\\\", 32), (\\\"fallthrough_pc\\\", 32), (\\\"predicted_direct\\\", 1)')\ns=s.replace('\\\"predicted_next_pc\\\", \\\"direct_target_pc\\\")','\\\"predicted_next_pc\\\", \\\"direct_target_pc\\\", \\\"fallthrough_pc\\\")')\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
