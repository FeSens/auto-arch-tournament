{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\nroot=Path('cores/bench/rtl')\nfiles=['alu.sv','ex_stage.sv','mem_stage.sv','core.sv']\nPath('/tmp/r9s1_rtl_backup.json').write_text(json.dumps({f:(root/f).read_text() for f in files}))\np=root/'alu.sv'; s=p.read_text(); s=s.replace('module alu (','module alu #(parameter bit ENABLE_MULTIPLY = 1) (')\nstart=s.index('  // 64-bit products, computed once')\nend=s.index('  always_comb begin\\\\n    shamt',start)\ns=s[:start]+'''  logic [31:0] multiply_result;\n  generate if (ENABLE_MULTIPLY) begin : g_multiply\n    mul_unit u_mul (.op(op), .a(a), .b(b), .out(multiply_result));\n  end else begin : g_no_multiply\n    assign multiply_result = 32'b0;\n  end endgenerate\n\n'''+s[end:]\nstart=s.index('    mul_ss =');end=s.index('    case (op)',start);s=s[:start]+s[end:]\nstart=s.index('      // M-extension.');end=s.index('      ALU_DIV, ALU_DIVU',start)\ns=s[:start]+'''      ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU: out = multiply_result;\n'''+s[end:]\n# Keep the shared module in alu.sv so existing explicit unit-test source lists work.\ns+='''\nmodule mul_unit (\n  input logic [4:0] op,\n  input logic [31:0] a, b,\n  output logic [31:0] out\n);\n\"'`ifndef RISCV_FORMAL_ALTOPS\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [63:0] mul_ss, mul_su;\n  logic [63:0] mul_uu;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign mul_ss = $signed({{32{a[31]}}, a}) * $signed({{32{b[31]}}, b});\n  assign mul_uu = {32'\"'b0, a} * {32'b0, b};\n  assign mul_su = \"'$signed({{32{a[31]}}, a}) * $signed({32'\"'b0, b});\n\"'`endif\n  always_comb begin\n    case (op)\n`ifdef RISCV_FORMAL_ALTOPS\n      ALU_MUL: out = (a + b) ''^ 32'\"'h5876063e;\n      ALU_MULH: out = (a + b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU: out = (a + b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: out = (a - b) \"'^ 32'\"'hecfbe137;\n\"'`else\n      ALU_MUL: out = mu