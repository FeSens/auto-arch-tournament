re_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[19036 of 22108 chars elided by tools/bench/transcript.py; sha256:9dceaa03d7007fa5]…\n ALU_REMU) else MASK32\n    dividend, divisor = ((_signed(a), _signed(b)) if op in (ALU_DIV, ALU_REM)\n                         else (a, b))\n    if op in (ALU_REM, ALU_REMU):\n        remainder = abs(dividend) % abs(divisor)\n        return (-remainder if dividend < 0 else remainder) & MASK32\n    quotient = abs(dividend) // abs(divisor)\n    if (dividend < 0) != (divisor < 0):\n        quotient = -quotient\n    return quotient & MASK32\n\n\n@cocotb.test()\nasync def add(dut):\n    await _setup(dut)\n    await _check(dut, ALU_ADD, 5, 3, 8)\n    await _check(dut, ALU_ADD, 0xFFFFFFFF, 1, 0)  # wrap\n\n\n@cocotb.test()\nasync def sub(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SUB, 10, 3, 7)\n    await _check(dut, ALU_SUB, 0, 1, 0xFFFFFFFF)  # borrow\n\n\n@cocotb.test()\nasync def bitwise(dut):\n    await _setup(dut)\n    await _check(dut, ALU_AND, 0xFF, 0x0F, 0x0F)\n    await _check(dut, ALU_OR,  0xF0, 0x0F, 0xFF)\n    await _check(dut, ALU_XOR, 0xFF, 0x0F, 0xF0)\n\n\n@cocotb.test()\nasync def slt_signed(dut):\n    await _setup(dut)\n", "exit_code": 0, "status": "completed"}}
