{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/rtl/forward_unit.sv');s=p.read_text();s=s.replace('  input  logic [4:0] id_ex_rs1,\\\\n  input  logic [4:0] id_ex_rs2,','''  input logic match_ex_rs1, match_ex_rs2,\n  input logic match_wb_rs1, match_wb_rs2,''');s=s.replace('ex_mem_rd == id_ex_rs1','match_ex_rs1').replace('ex_mem_rd == id_ex_rs2','match_ex_rs2').replace('mem_wb_rd == id_ex_rs1','match_wb_rs1').replace('mem_wb_rd == id_ex_rs2','match_wb_rs2');p.write_text(s)\np=Path('cores/bench/rtl/core.sv');s=p.read_text();s=s.replace('  forward_unit u_fwd (\\\\n    .id_ex_rs1   (id_ex_w.rs1_addr),\\\\n    .id_ex_rs2   (id_ex_w.rs2_addr),','''  logic match_ex_rs1, match_ex_rs2, match_wb_rs1, match_wb_rs2;\n  always_ff @(posedge clock) begin\n    if (reset || flush_id) begin\n      match_ex_rs1 <= 1'b0;\n      match_ex_rs2 <= 1'b0;\n      match_wb_rs1 <= 1'b0;\n      match_wb_rs2 <= 1'b0;\n    end else if (\"'!stall_id) begin\n      match_ex_rs1 <= rs1_addr_w == id_ex_w.rd;\n      match_ex_rs2 <= rs2_addr_w == id_ex_w.rd;\n      match_wb_rs1 <= rs1_addr_w == ex_mem_w.rd;\n      match_wb_rs2 <= rs2_addr_w == ex_mem_w.rd;\n    end\n  end\n\n  forward_unit u_fwd (\n    .match_ex_rs1 (match_ex_rs1),\n    .match_ex_rs2 (match_ex_rs2),\n    .match_wb_rs1 (match_wb_rs1),\n    .match_wb_rs2 (match_wb_rs2),'\"''');p.write_text(s)\nPY\nmake lint TARGET=bench\npython3 -m tools.eval.gowin bench --all-options > /srv/hwebench/tmp/92f133a1/4e0ba974/r7s1-operands-timing.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
