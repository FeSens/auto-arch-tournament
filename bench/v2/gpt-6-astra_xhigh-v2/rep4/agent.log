{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/rtl/alu.sv');s=p.read_text()\nb=Path('cores/bench/generated/hyp_r8s1')\n(b/'alu.radix16.sv').write_text(s)\na=s.index('  logic [35:0] multiple_q [0:7];')\nz=s.index('  always_comb begin\\\\n    case ({divisor_q[3:0]',a)\ns=s[:a]+'''  logic [33:0] triple_q;\n  wire [33:0] dwide = {2'b0,divisor_q};\n  always_ff @(posedge clock) begin\n    if (reset) triple_q <= 34'b0;\n    else if (div_busy && iteration == 3'd0)\n      triple_q <= (dwide << 1) + dwide;\n  end\n  wire [31:0] radix_rem [0:2];\n  wire [31:0] radix_quo [0:2];\n  assign radix_rem[0] = remainder_q;\n  assign radix_quo[0] = quotient_q;\n  for (genvar step = 0; step < 2; step++) begin : g_radix4\n    wire [33:0] trial = {radix_rem[step],radix_quo[step][31:30]};\n    /* verilator lint_off UNUSEDSIGNAL */\n    wire [34:0] diff1 = {1'b0,trial} - {1'b0,dwide};\n    wire [34:0] diff2 = {1'b0,trial} - {1'b0,(dwide << 1)};\n    wire [34:0] diff3 = {1'b0,trial} - {1'b0,triple_q};\n    /* verilator lint_on UNUSEDSIGNAL */\n    wire [3:0] win;\n    wire ge1 = \"'!diff1[34];\n    wire ge2 = !diff2[34];\n    wire ge3 = !diff3[34];\n    assign win = {ge3,ge2 && !ge3,ge1 && !ge2,!ge1};\n    assign radix_rem[step+1] = (trial[31:0] & {32{win[0]}})\n                           | (diff1[31:0] & {32{win[1]}})\n                           | (diff2[31:0] & {32{win[2]}})\n                           | (diff3[31:0] & {32{win[3]}});\n    assign radix_quo[step+1] = {radix_quo[step][29:0],\n                              win[2] | win[3],win[1] | win[3]};\n  end\n  logic [7:0] first_table;\n  wire [7:0] first_result = |divisor_q[31:4]\n                        ? {4'\"'b0, quotient_q[31:28]} : first_table;\n'''+s[z:]\ns=s.replace(\\\"quotient_q <= {quotient_q[27:0],digit_tree[1]};\\\\n        remainder_q <= rem_tree[1];\\\",\\\"quotient_q <= radix_quo[2];\\\\n        remainder_q <= radix_rem[2];\\\")\np.write_text(s)\n(b/'timing.radix16.log').write_text((b/'timing.log').read_text())\nprint('Prepared smaller two-step radix-4 prototype with overlapped 3D bank setup.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
