ke_2d, take_3d;\n+    logic [1:0] digit;\n+\n+    // After W dividend bits, the partial dividend (and hence trial)\n+    // fits in W bits. Each step appends the next pair to the remainder.\n+    if (s == 0) begin : first\n+      assign trial = div_a[31:30];\n+    end else begin : following\n+      assign trial = {div_step[s-1].remainder, div_a[31-2*s -: 2]};\n+    end\n+\n+    // Three independent W+1-bit tri\n…[9151 of 12223 chars elided by tools/bench/transcript.py; sha256:8112a801eccba809]…\n261002-001-r1s0/cores/bench/test/test_alu.py\" lineno=\"275\" time=\"1.506779432296753\" sim_time_ns=\"131072.0\" ratio_time=\"86988.17968347872\" />\n    <testcase name=\"divmod_boundaries_and_signs\" classname=\"test_alu\" file=\"/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep4/cores/bench/worktrees/hyp-20261002-001-r1s0/cores/bench/test/test_alu.py\" lineno=\"283\" time=\"1.026543140411377\" sim_time_ns=\"132496.00000000003\" ratio_time=\"129070.0748795648\" />\n    <testcase name=\"divmod_radix4_thresholds\" classname=\"test_alu\" file=\"/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep4/cores/bench/worktrees/hyp-20261002-001-r1s0/cores/bench/test/test_alu.py\" lineno=\"298\" time=\"0.31568479537963867\" sim_time_ns=\"36000.0\" ratio_time=\"114037.80139840704\" />\n    <testcase name=\"divmod_random_full_width\" classname=\"test_alu\" file=\"/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep4/cores/bench/worktrees/hyp-20261002-001-r1s0/cores/bench/test/test_alu.py\" lineno=\"335\" time=\"0.3526580333709717\" sim_time_ns=\"40000.0\" ratio_time=\"113424.32672708404\" />\n", "exit_code": 0, "status": "completed"}}
