{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport json\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\nfrom tools.eval.fpga import validate_coremark_uart, parse_iterations\nfrom tools.eval.gowin import parse_reports, summarize\nroot = Path.cwd()\nmarker = json.loads((root / 'cores/bench/generated/coremark-local.log').read_text().splitlines()[-1])\niterations = parse_iterations(str(root))\nvalid, reason = validate_coremark_uart(marker['uart'], iterations)\nassert valid, reason\nassert marker['ebreak'] and not marker['maxcycles_hit'] and not marker['oob']\nassert marker['bench_bracketed'] and iterations == 10\ncycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nassert cycles == 4202272, cycles\nresults = [dict(place_option=p, **parse_reports(root / f'cores/bench/generated/timing/gowin_p{p}')) for p in range(3)]\ntiming = summarize(results)\nassert not timing['placement_failed']\nfitness = timing['fmax_mhz'] * 1e6 * iterations / cycles\nassert fitness > 85.42682, fitness\nprint(json.dumps({'cycles': cycles, 'iterations': iterations, 'fmax_mhz': timing['fmax_mhz'], 'placements_mhz': timing['seeds'], 'fitness': fitness, 'improvement_percent': (fitness / 81.67 - 1) * 100, 'logic': timing['lut4'], 'registers': timing['ff'], 'crc_uart_oob_markers': 'PASS'}, indent=2))\nfor path in sorted((root / 'cores/bench/test').glob('test_pipeline_runner*.result.xml')):\n    cases = ET.parse(path).findall('.//testcase')\n    assert cases and all(case.find('failure') is None and case.find('error') is None for case in cases)\n    print(f'{path.name}: {len(cases)} cocotb tests passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
