{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nfrom collections import defaultdict, deque\nreport = {}\nfor mode in ('real', 'altops'):\n    netlist = json.loads(Path(f'cores/bench/generated/divide_cone_{mode}.json').read_text())['modules']['core_bench']\n    nets, cells = netlist['netnames'], netlist['cells']\n    def bits(name):\n        return set(b for b in nets[name]['bits'] if isinstance(b, int))\n    edges = defaultdict(set)\n    flops = []\n    for name, c in cells.items():\n        if 'ff' in c['type']:\n            flops.append((name, c))\n            continue\n        outputs = {b for p, bs in c['connections'].items() if c['port_directions'][p] == 'output' for b in bs if isinstance(b, int)}\n        for p, bs in c['connections'].items():\n            if c['port_directions'][p] == 'input':\n                for b in bs:\n                    if isinstance(b, int):\n                        edges[b].update(outputs)\n    def cone(roots):\n        seen = set(roots)\n        pending = deque(roots)\n        while pending:\n            for b in edges[pending.popleft()] - seen:\n                seen.add(b)\n                pending.append(b)\n        return seen\n    ex_q = set(nets['cpu.u_ex.reg_q']['bits'][264:296])\n    ex_d = set()\n    ex_q_found = set()\n    for name, c in flops:\n        for q, d in zip(c['connections']['Q'], c['connections']['D']):\n            if q in ex_q:\n                ex_q_found.add(q)\n                ex_d.add(d)\n    assert len(ex_q_found) == 32, ex_q_found\n    result = bits('cpu.u_ex.div_result')\n    result_cone = cone(result)\n    alu = bits('cpu.u_ex.alu_result')\n    completion = set(nets['cpu.div_completion_w']['bits'][302:334])\n    assert len(result) == 32 and result == completion\n    assert not result_cone & alu\n    assert not result_cone & ex_d\n    state_names = ['alt_result'] if mode == 'altops' else [\n        'quotient_q', 'remainder_q', 'dividend_q', 'quotient_negative',\n        'remainder_negative', 'select_remainder', 'divide_zero', 'signed_overflow']\n    state = set().union(*(bits('cpu.u_ex.u_alu.' + n) for n in state_names))\n    state_cone = cone(state)\n    assert not state_cone & alu and not state_cone & ex_d\n    rf_q = set().union(*(bits(n) for n in nets if n.startswith('cpu.u_rf.g_word[') and n.endswith('.word_q')))\n    rf_d = {d for _, c in flops for q, d in zip(c['connections']['Q'], c['connections']['D']) if q in rf_q}\n    assert len(rf_q) == 31 * 32\n    assert result_cone & rf_d\n    report[mode] = {'ordinary_alu_result_bits_reachable': len(result_cone & alu),\n                    'ex_mem_result_D_bits_reachable': len(result_cone & ex_d),\n                    'divider_data_state_to_ex_mem_result_D_bits_reachable': len(state_cone & ex_d),\n                    'dedicated_completion_result_bits_preserved': len(completion),\n                    'register_file_D_bits_reachable': len(result_cone & rf_d),\n                    'method': 'Yosys optimized FPGA wrapper netlist; conservative combinational connectivity, stopping at registers. Gowin netlist encrypted; this is not vendor timing evidence.'}\nPath('cores/bench/generated/divide_cone_check.json').write_text(json.dumps(report, indent=2) + '\\\\n')\nprint(json.dumps(report, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
