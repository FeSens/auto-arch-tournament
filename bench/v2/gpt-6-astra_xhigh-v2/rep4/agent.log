 == [12, 16, 16, 16, 16, 12, ...]\n122:                                                            assert any(t[\"pc\"] == 520 and t[\"update\"] and t[\"branch_pc\"] == 8\n124:                                                        AssertionError: assert False\n132:                                                            assert any(t[\"stall_ex\"] and t[\"branch_pc\"] == 12 for t in trace)\n133:   \n…[1153 of 4225 chars elided by tools/bench/transcript.py; sha256:f2c105a5e97433ce]…\nme[\"branch_pc\"] == retirement[\"pc\"]\n182:                                                        AssertionError: assert 16 == 0\n185: 57880.02ns WARNING  ..memory_drains_and_fetch_can_wait assert 8 == 0\n191:                                                            assert launch[\"branch_pc\"] == consume[\"branch_pc\"] == retirement[\"pc\"]\n192:                                                        AssertionError: assert 8 == 0\n195: 58140.03ns WARNING  ..ider_pipeline_reset_cancellation assert 4 == 0\n201:                                                            assert launch[\"branch_pc\"] == consume[\"branch_pc\"] == retirement[\"pc\"]\n202:                                                        AssertionError: assert 4 == 0\n206: 58370.03ns WARNING  ..ers.divider_completion_consumers assert 8 == 0\n212:                                                            assert launch[\"branch_pc\"] == consume[\"branch_pc\"] == retirement[\"pc\"]\n213:                                                        AssertionError: assert 8 == 0\n", "exit_code": 0, "status": "completed"}}
