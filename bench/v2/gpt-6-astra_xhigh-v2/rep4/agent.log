{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nb=Path('/srv/hwebench/tmp/92f133a1/4e0ba974/r7s1-original')\nfor p in Path('cores/bench/rtl').glob('*.sv'):\n p.write_bytes((b/p.name).read_bytes())\nPath('cores/bench/test/test_pipeline.py').write_bytes((b/'test_pipeline.py').read_bytes())\np=Path('cores/bench/rtl/reg_file.sv');s=p.read_text();start=s.index('  logic [31:0] regs [0:31];');s=s[:start]+'''  logic [31:0] words [0:31];\n  logic [31:0] read1, read2;\n  assign words[0] = 32'b0;\n  for (genvar r = 1; r < 32; r++) begin : g_word\n    logic [31:0] data_q;\n    always_ff @(posedge clock) begin\n      if (reset) data_q <= 32'b0;\n      else if (w_en && w_addr == 5'(r)) data_q <= w_data;\n    end\n    assign words[r] = data_q;\n  end\n  always_comb begin\n    read1 = 32'b0;\n    read2 = 32'b0;\n    for (int r = 1; r < 32; r++) begin\n      read1 = read1 | (words[r] & {32{rs1_addr == 5'(r)}});\n      read2 = read2 | (words[r] & {32{rs2_addr == 5'(r)}});\n    end\n    rs1_data = rs1_addr == 0 ? 32'b0 :\n               (w_en && w_addr == rs1_addr) ? w_data : read1;\n    rs2_data = rs2_addr == 0 ? 32'b0 :\n               (w_en && w_addr == rs2_addr) ? w_data : read2;\n  end\nendmodule\n''';p.write_text(s)\nPY\nmake lint TARGET=bench\npython3 -m tools.eval.gowin bench --all-options > /srv/hwebench/tmp/92f133a1/4e0ba974/r7s1-regbank-timing.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
