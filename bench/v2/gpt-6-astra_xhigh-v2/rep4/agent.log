{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py cores/bench/test/conftest.py cores/bench/core.yaml'", "aggregated_output": "\"\"\"Real RV32IM arithmetic and the four-iteration divider handshake.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport random\nfrom pathlib import Path\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n)\n\nMASK32 = 0xFFFFFFFF\nALTOPS = os.environ.get(\"ALTOPS\") == \"1\"\nALT_CONSTANT = {\n    ALU_MUL: 0x5876063e, ALU_MULH: 0xf6583fb7,\n    ALU_MULHU: 0x949ce5e8, ALU_MULHSU: 0xecfbe137,\n    ALU_DIV: 0x7f8529ec, ALU_DIVU: 0x10e8fd70,\n    ALU_REM: 0x8da68fa5, ALU_REMU: 0x3138d0e1,\n}\nDIV_OPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\n\n\ndef _alt(op, a, b):\n    value = a + b if op in (ALU_MUL, ALU_MULH, ALU_MULHU) else a - b\n    return (value ^ ALT_CONSTANT[op]) & MASK32\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.div_request.value = 0\n    dut.div_consume.value = 0\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.div_done.value) and not int(dut.div_busy.value)\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    if ALTOPS and op in ALT_CONSTANT:\n        expected = _alt(op, a, b)\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0):\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_request.value\n…[9199 of 12271 chars elided by tools/bench/transcript.py; sha256:063c0e8540acdb26]…\n                test_dir=root / \"test\", build_dir=build,\n                extra_env={\"ALTOPS\": \"1\" if altops else \"0\"})\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\nname: bench\ndescription: Frozen LLM-benchmark fixture core. Identical RTL to baseline at the bench-fixture-v1\n  freeze point. The benchmark matrix clones from the bench-fixture-v1 orphan branch\n  and operates only on this directory.\nisa: rv32im\nnret: 1\ntarget_fpga: tang-nano-20k\ntargets:\n  fmax_mhz: 135\n  lut4: 10000\n  coremark_iter_s: 300\n  coremark_per_mhz: 2.2\ncurrent:\n  fmax_mhz: 31.417\n  lut4: 3819\n  ff: 885\n  coremark_iter_s: 2.0e-06\n  coremark_per_mhz: 0.0\n  source_id: hyp-20261002-002-r2s1\n  updated: '2026-10-02T18:06:35.443754Z'\n", "exit_code": 0, "status": "completed"}}
