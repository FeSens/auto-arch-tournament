{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"tail -3 /srv/hwebench/tmp/92f133a1/46322b65/r14-address-tests.log; tail -4 cores/bench/generated/timing/gowin_p1/gw.log; date -u '+%H:%M:%S'; rg -n '\"'^  logic|''^  assign'\"' cores/bench/rtl/ex_stage.sv | head -35\"","aggregated_output":"....[60%] Tech-Mapping Phase 0 completed\n[65%] Tech-Mapping Phase 1 completed\n[75%] Tech-Mapping Phase 2 completed\n[80%] Tech-Mapping Phase 3 completed\n02:02:28\n42:  logic [31:0] rs1;\n43:  logic [31:0] rs2;\n59:  logic [31:0] alu_a;\n60:  logic [31:0] alu_b;\n66:  logic [31:0] alu_result, div_result;\n67:  logic [31:0] effective_addr;\n68:  logic [31:0] address_sum, local_sum, ex_sum, wb_sum;\n69:  assign local_sum = in.rs1_val + in.imm;\n70:  assign ex_sum = fwd_ex_mem + in.imm;\n71:  assign wb_sum = fwd_mem_wb + in.imm;\n79:  logic is_divide, div_request, div_consume, div_busy, div_done;\n80:  logic is_multiply;\n81:  logic advance;\n82:  logic [31:0] div_rs1_q, div_rs2_q;\n84:  assign is_multiply = in.ctrl.alu_op == ALU_MUL || in.ctrl.alu_op == ALU_MULH\n86:  assign is_divide = in.valid && (in.ctrl.alu_op == ALU_DIV\n91:  assign div_request = is_divide && !reset && !stall && !div_busy && !div_done;\n94:  assign execute_wait = is_divide && (!div_done || normal_wb_valid);\n95:  assign advance = in.valid && !reset && !stall && !execute_wait;\n96:  assign div_consume = is_divide && advance;\n97:  assign effective_addr = address_sum;\n143:  logic        branch_cond, branch_base;\n144:  logic [31:0] branch_rs1, branch_rs2;\n145:  logic        branch_taken;\n146:  logic [31:0] branch_target;\n147:  logic [31:0] jump_target;\n149:  logic [31:0] jalr_sum;  // bit 0 deliberately dropped per RV JALR spec\n154:  assign branch_rs1 = {rs1[31] ^ !in.ctrl.branch_op[1], rs1[30:0]};\n155:  assign branch_rs2 = {rs2[31] ^ !in.ctrl.branch_op[1], rs2[30:0]};\n179:  logic misalign_branch;\n180:  logic misalign_jump;\n181:  logic misalign_fault;\n182:  logic direct_jal, direct_target_misaligned;\n194:  assign direct_jal = in.ctrl.is_jump && !in.ctrl.is_jalr;\n195:  assign direct_target_misaligned = branch_target[1:0] != 2'b00;\n","exit_code":0,"status":"completed"}}
