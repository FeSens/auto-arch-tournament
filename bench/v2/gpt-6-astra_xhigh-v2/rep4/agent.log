{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nr=Path('cores/bench/rtl');b=Path('/srv/hwebench/tmp/92f133a1/4d31a3eb/r14s2-probe')\nshutil.copyfile(r/'if_stage.sv',b/'onebit_if_stage.sv')\nshutil.copyfile(b/'if_stage.sv',r/'if_stage.sv')\np=r/'if_stage.sv';t=p.read_text();needle='  logic [1:0]  counters [0:127];'\nt=t.replace(needle,needle+'''\\\\n  logic train_valid;\\\\n  logic [6:0] train_index;\\\\n  logic train_taken;\\\\n  logic [1:0] read_counter;\\\\n  logic read_taken;\\\\n  always_ff @(posedge clock) begin\\\\n    if (reset) train_valid <= 1'b0;\\\\n    else train_valid <= branch_update;\\\\n    train_index <= branch_pc[8:2];\\\\n    train_taken <= branch_taken;\\\\n  end\\\\n  assign read_counter = counters[pc[8:2]];\\\\n  assign read_taken = train_valid && train_index == pc[8:2]\\\\n                      && (read_counter[1] \"'^ read_counter[0])'\"\\\\n                      ? train_taken : read_counter[1];\\\\n''')\nt=t.replace(\\\"branch_update && branch_pc[8:2] == 7'(i)\\\",\\\"train_valid && train_index == 7'(i)\\\").replace('if (branch_taken) begin','if (train_taken) begin').replace('(legal_branch && counters[pc[8:2]][1])','(legal_branch && read_taken)');p.write_text(t)\nprint('Prepared coherent write-behind training with unconditional payload capture.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
