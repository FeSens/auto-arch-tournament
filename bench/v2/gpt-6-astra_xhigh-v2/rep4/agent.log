(opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\ndef LW  (rd, rs1, imm): return _i(imm\n…[12407 of 15479 chars elided by tools/bench/transcript.py; sha256:021fa293136b0f87]…\nowin.py:180:    \"\"\"Median Fmax over placement options; every option must fit (the flow\ntools/eval/gowin.py:182:    failed = [r for r in results if r[\"placement_failed\"]]\ntools/eval/gowin.py:184:        return {\"placement_failed\": True,\ntools/eval/gowin.py:189:        \"placement_failed\": False,\ntools/eval/gowin.py:190:        \"fmax_mhz\": round(statistics.median(r[\"fmax_mhz\"] for r in results), 3),\ntools/eval/gowin.py:199:def main(argv=None) -> int:\ntools/eval/gowin.py:202:    import argparse, json\ntools/eval/gowin.py:204:    ap = argparse.ArgumentParser()\ntools/eval/gowin.py:209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\ntools/eval/gowin.py:216:        if r[\"placement_failed\"]:\ntools/eval/gowin.py:226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\ntools/eval/gowin.py:227:        print(f\"score Fmax (median): {summarize(res)['fmax_mhz']} MHz\")\ntools/eval/gowin.py:228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\n", "exit_code": 0, "status": "completed"}}
