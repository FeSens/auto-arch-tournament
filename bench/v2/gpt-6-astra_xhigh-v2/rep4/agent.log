ed <= full;\n          full <= 1'b0;\n        end\n        default: ;\n      endcase\n      if (pending_advance && consume) begin\n        pc <= head.predicted_next_pc;\n        pending_advance <= 1'b0;\n      end else if (accept) begin\n        if (ordinary_pc) pc <= predicted_next_pc;\n        else pending_advance <= 1'b1;\n      end\n    end\n  end\n\n  // Payload need not reset or squash: occupancy makes it unreachable.\n  // Append after the shift so a one-entry pop/push replaces the head;\n  // a full pop/push shifts the retained tail and appends into slot one.\n  always_comb begin\n    incoming.pc = pc;\n    incoming.instr = imem_data;\n    incoming.predicted_direct = predicted_direct;\n    incoming.predicted_next_pc = predicted_next_pc;\n    incoming.valid = 1'b1;\n  end\n\n  always_ff @(posedge clock) begin\n    if ((!occupied && accept) || (consume && (full || accept)))\n      head <= full ? tail : incoming;\n    if (accept && occupied && (full || !consume)) tail <= incoming;\n  end\n\n  assign imem_addr = pc;\n\n  always_comb begin\n    out = head;\n    if (!available) begin\n      out = '0;\n      out.instr = 32'h0000_0013;\n    end\n    out.valid = available;\n  end\n\nendmodule\n","exit_code":1,"status":"failed"}}
