{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -c \"sed -n '1135,1178p' cores/bench/test/test_pipeline.py\"","aggregated_output":"@cocotb.test()\nasync def unit_ex_effective_address(dut):\n    async def edge():\n        dut.clock.value = 0\n        await Timer(2, \"ns\")\n        dut.clock.value = 1\n        await Timer(2, \"ns\")\n        dut.clock.value = 0\n\n    dut.reset.value = 1\n    dut.stall.value = 0\n    dut.normal_wb_valid.value = 0\n    dut.fwd_rs1_sel.value = 0\n    dut.fwd_rs2_sel.value = 0\n    dut.fwd_ex_mem.value = 0\n    dut.fwd_mem_wb.value = 0\n    dut[\"in\"].value = 0\n    await edge()\n    dut.reset.value = 0\n    for base in (0, 1, 0x7fffffff, 0x80000000, 0xfffff800, MASK32):\n        for imm in (0, 1, 2047, -1, -2048):\n            for source in range(3):\n                dut.fwd_rs1_sel.value = source\n                dut.fwd_ex_mem.value = base\n                dut.fwd_mem_wb.value = base\n                for memory in (False, True):\n                    dut[\"in\"].value = _pack(ID_FIELDS, valid=1, rs1_val=base,\n                        rs2_val=0x1234567, imm=imm, ctrl=_pack(CTRL_FIELDS,\n                        alu_op=0 if memory else 11, alu_src=memory, reg_write=1,\n                        mem_read=memory, mem_to_reg=memory, mem_width=2))\n                    await edge()\n                    out = _unpack(EX_FIELDS, int(dut.out.value))\n                    assert out[\"effective_addr\"] == ((base + imm) & MASK32 if memory else 0)\n                    assert out[\"rs1_val\"] == base\n                    dut.stall.value = 1\n                    dut[\"in\"].value = 0\n                    await edge()\n                    assert _unpack(EX_FIELDS, int(dut.out.value)) == out\n                    dut.stall.value = 0\n\n\n@cocotb.test()\nasync def unit_mem_dedicated_address(dut):\n    \"\"\"Poison arithmetic results to check every memory use of effective_addr.\"\"\"\n","exit_code":0,"status":"completed"}}
