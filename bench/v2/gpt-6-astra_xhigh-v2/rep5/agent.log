(\"execute_wait\")\n776:        assert signal(\"branch_train\") == train, (cycle, active, train)\n780:            assert signal(\"branch_index\") == (active[0] >> 2) & 63\n781:            assert signal(\"branch_outcome\") == outcome\n782:        if signal(\"execute_wait\"):\n","exit_code":0,"status":"completed"}}
