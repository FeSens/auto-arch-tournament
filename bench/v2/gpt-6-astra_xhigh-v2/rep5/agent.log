{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/561ff4c6/7ebaeff3')\nbase=Path('cores/bench/rtl')\nfor name,both in [('r11s0-compare4',False),('r11s0-compare16',True)]:\n s=root/name/'rtl';shutil.copytree(base,s,dirs_exist_ok=True)\n p=s/'ex_stage.sv';t=p.read_text()\n start=t.index('    case (in.ctrl.branch_op)')\n end=t.index('    branch_taken',start)\n t=t[:start]+t[end:]\n marker='  always_comb begin\\\\n    branch_taken'\n src=['in.rs1_val','fwd_ex_mem','fwd_wb_alu','fwd_wb_load']\n srcb=['in.rs2_val','fwd_ex_mem','fwd_wb_alu','fwd_wb_load'] if both else ['rs2']\n n=16 if both else 4\n text='''  function automatic logic branch_compare(input logic [31:0] a, b, input logic [2:0] op);\n    case (op)\n      BR_BEQ: branch_compare = a == b;\n      BR_BNE: branch_compare = a \"'!= b;\n      BR_BLT: branch_compare = $signed(a) < $signed(b);\n      BR_BGE: branch_compare = $signed(a) >= $signed(b);\n      BR_BLTU: branch_compare = a < b;\n      BR_BGEU: branch_compare = a >= b;\n      default: branch_compare = 1'\"'b0;\n    endcase\n  endfunction\n'''\n text+=f'  wire [{n-1}:0] branch_terms;\\\\n'\n for i,a in enumerate(src):\n  for j,b in enumerate(srcb):\n   k=i*len(srcb)+j\n   qual=f'fwd_rs1_sel[{i}]'+(f' && fwd_rs2_sel[{j}]' if both else '')\n   text+=f'  assign branch_terms[{k}] = ({qual}) && branch_compare({a}, {b}, in.ctrl.branch_op);\\\\n'\n text+='  assign branch_cond = |branch_terms;\\\\n\\\\n'\n assert marker in t\n t=t.replace(marker,text+marker)\n p.write_text(t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
