{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/561ff4c6/10efe6cb/compare_predictors.py <<'PY'\nimport struct,collections\nbase='/srv/hwebench/tmp/561ff4c6/10efe6cb/'\ntrace=list(struct.iter_unpack('<IBB',open(base+'branch_trace.bin','rb').read()))\nresults=[]\nfor bits in (6,7,8,9,10,11):\n for hashmode in (0,1,2):\n  table=[1]*(1<<bits); mask=(1<<bits)-1; miss=total=0; sites=collections.Counter()\n  for pc,t,active in trace:\n   idx=((pc>>2)\"'^(pc>>(bits+2) if hashmode==1 else (pc>>10) if hashmode==2 else 0))&mask\n   pred=table[idx]>>1\n   if active: miss+=pred!=t; total+=1; sites[pc]+=pred!=t\n   table[idx]=min(3,table[idx]+1) if t else max(0,table[idx]-1)\n  results.append((miss,f'\"'bimodal{1<<bits}-hash{hashmode}'))\n  if bits==6 and hashmode==0: print('Baseline misses by site:',sites.most_common(18),flush=True)\nfor bits in (6,7,8,9,10):\n for hist in (3,4,6,8):\n  table=[1]*(1<<bits); mask=(1<<bits)-1; hmask=(1<<hist)-1; gh=miss=0\n  for pc,t,active in trace:\n   idx=((pc>>2)\"'^gh)&mask\n   pred=table[idx]>>1\n   if active: miss+=pred!=t\n   table[idx]=min(3,table[idx]+1) if t else max(0,table[idx]-1)\n   gh=((gh<<1)|t)&hmask\n  results.append((miss,f'\"'gshare{1<<bits}-h{hist}'))\nfor hist in (2,3,4,5,6,8):\n for sitesbits in (4,6,8):\n  lh=[0]*(1<<sitesbits); hmask=(1<<hist)-1; smask=(1<<sitesbits)-1\n  for phtmode in (0,1):\n   table=[1]*256; miss=0\n   for pc,t,active in trace:\n    site=(pc>>2)&smask\n    idx=(((pc>>2)<<hist)\"'^lh[site])&255 if phtmode==0 else ((pc>>2)''^lh[site])&255\n    pred=table[idx]>>1\n    if active: miss+=pred!=t\n    table[idx]=min(3,table[idx]+1) if t else max(0,table[idx]-1)\n    lh[site]=((lh[site]<<1)|t)&hmask\n   results.append((miss,f'\"'local256-sites{1<<sitesbits}-h{hist}-mode{phtmode}'))\nprint('Branches:',sum(a for _,_,a in trace))\nfor r in sorted(results): print(*r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
