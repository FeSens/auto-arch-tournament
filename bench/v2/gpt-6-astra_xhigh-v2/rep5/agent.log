 wrapper_si.sv + checks_si.cfg\"\n114:if [ ! -d \"$RISCV_FORMAL\" ]; then\n134:    for stale in \"$RISCV_FORMAL/cores/$CORE_NAME-\"*; do\n135:        [ \"$stale\" = \"$CORE_DIR\" ] && continue\n153:mkdir -p \"$CORE_DIR\"\n155:# deletes a module in rtl/ leaves a ghost copy in $CORE_DIR from the\n159:rm -f \"$CORE_DIR\"/*.sv\n160:cp \"$PROJECT_ROOT/$RTL_DIR\"/*.sv \"$CORE_DIR/\"\n161:cp \"$WRAPPER\"                   \"$CORE_DIR/wrapper.sv\"\n166:# right to add new modules, split a stage into multiple files, or rename\n170:STAGED_CFG=\"$CORE_DIR/checks.cfg\"\n174:    [ -f \"$CORE_DIR/core_pkg.sv\" ] && \\\n176:    for f in \"$CORE_DIR\"/*.sv; do\n186:# so cd-ing into $CORE_DIR (= $RISCV_FORMAL/cores/$CORE_NAME-<suffix>)\n187:# yields @core@=\"$CORE_NAME-<suffix>\". The [verilog-files] lines we just\n189:cd \"$CORE_DIR\"\n248:    echo \"Per-check logs in: $CORE_DIR/checks/<check>/logfile.txt\"\n","exit_code":0,"status":"completed"}}
