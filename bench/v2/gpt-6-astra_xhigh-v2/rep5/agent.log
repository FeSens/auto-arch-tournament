{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"mkdir -p /srv/hwebench/tmp/561ff4c6/b9a45337/microopt-r15; python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/561ff4c6/b9a45337/microopt-r15')\nr=base/'rtl'; shutil.copytree('cores/bench/rtl',r,dirs_exist_ok=True)\n(r/'block_carry_add.sv').write_text('''module block_carry_add #(parameter integer WIDTH=32, parameter integer BLOCK=8)(\n input wire [WIDTH-1:0] a,b,\n input wire cin,\n output wire [WIDTH-1:0] sum,\n output wire cout\n);\n localparam integer N=(WIDTH+BLOCK-1)/BLOCK;\n localparam integer LEVELS=\"'$clog2(N);\n wire [N-1:0] gp[0:LEVELS], gg[0:LEVELS];\n wire [N:0] carry;\n assign carry[0]=cin;\n generate for(genvar i=0;i<N;i=i+1) begin:g_block\n   localparam integer W=((WIDTH-i*BLOCK)>=BLOCK)?BLOCK:(WIDTH-i*BLOCK);\n   wire [W:0] s0,s1;\n   assign s0={1'\"'b0,a[i*BLOCK+:W]}+{1'b0,b[i*BLOCK+:W]};\n   assign s1={1'b0,a[i*BLOCK+:W]}+{1'b0,b[i*BLOCK+:W]}+{{W{1'b0}},1'b1};\n   assign gg[0][i]=s0[W];\n   assign gp[0][i]=&(a[i*BLOCK+:W]\"'^b[i*BLOCK+:W]);\n   assign sum[i*BLOCK+:W]=carry[i]?s1[W-1:0]:s0[W-1:0];\n   assign carry[i+1]=gg[LEVELS][i]|(gp[LEVELS][i]&cin);\n end\n for(genvar l=0;l<LEVELS;l=l+1) begin:g_level\n   for(genvar i=0;i<N;i=i+1) begin:g_prefix\n     if(i>=(1<<l)) begin:g_merge\n       assign gg[l+1][i]=gg[l][i]|(gp[l][i]&gg[l][i-(1<<l)]);\n       assign gp[l+1][i]=gp[l][i]&gp[l][i-(1<<l)];\n     end else begin:g_pass\n       assign gg[l+1][i]=gg[l][i];\n       assign gp[l+1][i]=gp[l][i];\n     end\n   end\n end endgenerate\n assign cout=carry[N];\nendmodule\n'\"''')\np=r/'alu.sv'; s=p.read_text(); s=s.replace('  always_comb begin\\\\n    shamt', '''  wire [31:0] short_add, short_sub;\n  block_carry_add #(.WIDTH(32)) u_short_add(.a(a),.b(b),.cin(1'b0),.sum(short_add),.cout());\n  block_carry_add #(.WIDTH(32)) u_short_sub(.a(a),.b(~b),.cin(1'b1),.sum(short_sub),.cout());\n  always_comb begin\n    shamt'''); s=s.