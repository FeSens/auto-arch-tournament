{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/rtl/div_unit.sv'","aggregated_output":"// Shared blocking RV32M divider. Service edges: capture, magnitudes,\n// four groups of eight restoring steps, sign correction, acceptance.\n// DONE persists under backpressure; reset cancels any pending operation.\nmodule div_unit (\n  input  logic        clock,\n  input  logic        reset,\n  input  logic        start,\n  input  logic [4:0]  op,\n  input  logic [31:0] a,\n  input  logic [31:0] b,\n  output logic        busy,\n  output logic        result_valid,\n  output logic [31:0] result,\n  input  logic        result_accept\n);\n  typedef enum logic [2:0] {\n    IDLE, PREP, STEP0, STEP1, STEP2, STEP3, SIGN, DONE\n  } state_t;\n  state_t state;\n  logic [31:0] a_q, b_q;\n  logic [4:0] op_q;\n\n`ifndef RISCV_FORMAL_ALTOPS\n  logic [31:0] quotient, remainder, divisor;\n  logic negate_q, negate_r, select_rem;\n  logic [31:0] q_step [0:8];\n  logic [31:0] r_step [0:8];\n  logic [32:0] difference [0:7];\n\n  // The extra subtraction bit detects borrow, including divisors with\n  // bit 31 set. Each selected remainder fits in 32 bits.\n  always_comb begin\n    q_step[0] = quotient;\n    r_step[0] = remainder;\n    for (int i = 0; i < 8; i++) begin\n      difference[i] = {r_step[i], q_step[i][31]} - {1'b0, divisor};\n      r_step[i+1] = difference[i][32]\n                  ? {r_step[i][30:0], q_step[i][31]} : difference[i][31:0];\n      q_step[i+1] = {q_step[i][30:0], !difference[i][32]};\n    end\n  end\n`endif\n\n  assign busy = state != IDLE;\n  assign result_valid = state == DONE;\n\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      state <= IDLE;\n      a_q <= '0;\n      b_q <= '0;\n      op_q <= '0;\n      result <= '0;\n`ifndef RISCV_FORMAL_ALTOPS\n      quotient <= '0;\n      remainder <= '0;\n      divisor <= '0;\n      negate_q <= 1'b0;\n      negate_r <= 1'b0;\n      select_rem <= 1'b0;\n`endif\n    end else begin\n      case (state)\n        IDLE: if (start) begin\n          a_q <= a;\n          b_q <= b;\n          op_q <= op;\n          state <= PREP;\n        end\n        PREP: begin\n`ifndef RISCV_FORMAL_ALTOPS\n          quotient <= ((op_q == ALU_DIV || op_q == ALU_REM) && a_q[31])\n                    ? -a_q : a_q;\n          divisor <= ((op_q == ALU_DIV || op_q == ALU_REM) && b_q[31])\n                   ? -b_q : b_q;\n          remainder <= '0;\n          negate_q <= (op_q == ALU_DIV) && (a_q[31] ^ b_q[31]);\n          negate_r <= (op_q == ALU_REM) && a_q[31];\n          select_rem <= op_q == ALU_REM || op_q == ALU_REMU;\n`endif\n          state <= STEP0;\n        end\n        STEP0, STEP1, STEP2, STEP3: begin\n`ifndef RISCV_FORMAL_ALTOPS\n          quotient <= q_step[8];\n          remainder <= r_step[8];\n`endif\n          case (state)\n            STEP0: state <= STEP1;\n            STEP1: state <= STEP2;\n            STEP2: state <= STEP3;\n            default: state <= SIGN;\n          endcase\n        end\n        SIGN: begin\n`ifdef RISCV_FORMAL_ALTOPS\n          // Same operands, latency and handshake as the real divider.\n          case (op_q)\n            ALU_DIV:  result <= (a_q - b_q) ^ 32'h7f8529ec;\n            ALU_DIVU: result <= (a_q - b_q) ^ 32'h10e8fd70;\n            ALU_REM:  result <= (a_q - b_q) ^ 32'h8da68fa5;\n            ALU_REMU: result <= (a_q - b_q) ^ 32'h3138d0e1;\n            default:  result <= '0;\n          endcase\n`else\n          // INT_MIN / -1 naturally gives 0x80000000 and remainder 0.\n          if (b_q == 0)\n            result <= select_rem ? a_q : 32'hffffffff;\n          else if (select_rem)\n            result <= negate_r ? -remainder : remainder;\n          else\n            result <= negate_q ? -quotient : quotient;\n`endif\n          state <= DONE;\n        end\n        DONE: if (result_accept) state <= IDLE;\n        default: state <= IDLE;\n      endcase\n    end\n  end\nendmodule\n","exit_code":0,"status":"completed"}}
