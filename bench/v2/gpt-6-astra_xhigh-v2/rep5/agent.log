= (imm >> 5)  & 0x3F\n    b41  = (imm >> 1)  & 0xF\n    b11  = (imm >> 11) & 1\n    return (b12 << 31) | (b105 << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) \\\n         | ((funct3 & 0x7) << 12) | (b41 << 8) | (b11 << 7) | (opcode & 0x7F)\n\n\ndef _j(imm, rd, opcode):\n    # 21-bit signed imm; bit 0 implicit zero.\n    b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return\n…[33974 of 37046 chars elided by tools/bench/transcript.py; sha256:8149c7f008858886]…\n\n    altops = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n    a = ((0x100 ^ 0x5876063e) - 1) if altops else 0x100\n    program = LI(1, a) + [ADDI(2, 0, 1), MUL(3, 1, 2), LW(4, 3, 0),\n                         MUL(5, 1, 2), SW(4, 5, 4), EBREAK()]\n    await _checked_div_program(dut, program, stalled=True)\n\n\n@cocotb.test()\nasync def multiplication_pipeline_arithmetic_and_reset(dut):\n    rng = random.Random(0xc5a1717)\n    pairs = [(0x80000000, 0xffffffff), (0xffffffff, 0xffffffff),\n             (0x8000ffff, 0xffff0001), (0xffff, 0xffff), (0, 0)]\n    pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(32)]\n    program = []\n    for a, b in pairs:\n        program += LI(1, a) + LI(2, b)\n        program += [MUL(3, 1, 2, f3) for f3 in range(4)]\n        program += [ADD(4, 3, 2)]\n    await _checked_div_program(dut, program + [EBREAK()], stalled=True)\n    for reset_at in range(1, 6):\n        await _checked_div_program(dut, [MUL(1, 0, 0), MUL(2, 1, 1), EBREAK()],\n                                   reset_at=reset_at)\n", "exit_code": 0, "status": "completed"}}
