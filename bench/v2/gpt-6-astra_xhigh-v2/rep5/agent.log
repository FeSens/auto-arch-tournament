{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/561ff4c6/8ba1bd50/r14_prefix_div');shutil.copytree('cores/bench/rtl',root/'rtl',dirs_exist_ok=True)\np=root/'rtl/div_unit.sv';s=p.read_text();needle='  // Each launch multiple is independently formed';start=s.index(needle)\ns=s[:start]+'''  // Nine short four-bit carry chains with a parallel group prefix.\n  function automatic [35:0] sub36(input logic [35:0] x, y);\n    logic [8:0] pg [0:4];\n    logic [8:0] gg [0:4];\n    logic [4:0] chunk [0:8];\n    logic [9:0] carry;\n    begin\n      for (int n=0;n<9;n++) begin\n        chunk[n] = {1'b0,x[4*n+:4]} + {1'b0,~y[4*n+:4]};\n        pg[0][n] = &(x[4*n+:4] \"'^ ~y[4*n+:4]);\n        gg[0][n] = chunk[n][4];\n      end\n      for (int stage=0;stage<4;stage++) begin\n        for (int n=0;n<9;n++) begin\n          if (n >= (1<<stage)) begin\n            pg[stage+1][n] = pg[stage][n] & pg[stage][n-(1<<stage)];\n            gg[stage+1][n] = gg[stage][n] | (pg[stage][n] & gg[stage][n-(1<<stage)]);\n          end else begin\n            pg[stage+1][n] = pg[stage][n];\n            gg[stage+1][n] = gg[stage][n];\n          end\n        end\n      end\n      carry[0] = 1'\"'b1;\n      for (int n=0;n<9;n++) begin\n        carry[n+1] = gg[4][n] | pg[4][n];\n        sub36[4*n+:4] = x[4*n+:4] + ~y[4*n+:4] + {3'b0,carry[n]};\n      end\n    end\n  endfunction\n\n''' +s[start:]\ns=s.replace(\\\"{1'b0, trial8} - {1'b0, multiples[k]}\\\",\\\"sub36({1'b0, trial8}, {1'b0, multiples[k]})\\\")\ns=s.replace(\\\"{1'b0, trial4} - {1'b0, multiples[k][33:0]}\\\",\\\"35'(sub36({2'b0, trial4}, {2'b0, multiples[k][33:0]}))\\\")\np.write_text(s)\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
