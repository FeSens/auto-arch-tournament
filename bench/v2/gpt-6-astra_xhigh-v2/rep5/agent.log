{"type": "item.completed", "item": {"id": "item_4", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_div_unit.py && cat cores/bench/core.yaml && cat Makefile'", "aggregated_output": "\"\"\"Exercise the actual sequential divider, with exact integer references.\"\"\"\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n\n\ndef reference(op, a, b, altops=ALTOPS):\n    a, b = a & MASK, b & MASK\n    if altops:\n        return ((a - b) ^ dict(zip(OPS, (\n            0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))[op]) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n        q = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            q = -q\n    else:\n        q = a // b\n    return (a - q * b if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value)\n    assert not int(dut.result_valid.value)\n\n\nasync def operation(dut, op, a, b, hold=0):\n    assert not int(dut.busy.value)\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    dut.start.value = 1\n    await tick(dut)  # capture, magnitudes and two bits, service edge 1\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n    dut.start.value = 0\n    # Live operands and operation may change while the captured work runs.\n    dut.a.value, dut.b.value, dut.op.value = 0x13579bdf, 0, ALU_REMU\n    for edge in range(2, 8):\n        # Neither busy starts nor premature accepts may disturb a group.\n        dut.start.value = edge % 2\n        dut.result_accept.value = int(\n…[11880 of 14952 chars elided by tools/bench/transcript.py; sha256:16af429c7db846cb]…\nree add \"$(WT_PATH)\" $(WT_BRANCH); \\\n\t  else \\\n\t    git worktree add -b $(WT_BRANCH) \"$(WT_PATH)\"; \\\n\t  fi; \\\n\t  [ -e \"$(WT_PATH)/formal/riscv-formal\" ] || ln -s \"$(CURDIR)/formal/riscv-formal\" \"$(WT_PATH)/formal/riscv-formal\"; \\\n\tfi\n\t@$(MAKE) -C \"$(WT_PATH)\" loop \\\n\t  WORKTREE= \\\n\t  TARGET=$(TARGET) N=$(N) K=$(K) AGENT=$(AGENT) \\\n\t  $(if $(strip $(BASE)),BASE=$(BASE),) \\\n\t  $(if $(strip $(COREMARK)),COREMARK=$(COREMARK),) \\\n\t  $(if $(strip $(LUT)),LUT=$(LUT),)\nelse\n\tAGENT_PROVIDER=$(AGENT) python3 -m tools.orchestrator $(ORCH_FLAGS) $(ORCH_TARGET_FLAG)\nendif\n\nreport:\n\tpython3 -m tools.orchestrator --report $(ORCH_TARGET_FLAG)\n\nclean:\n\trm -rf test/cosim/sim_build sim_build out\n\trm -rf experiments/worktrees\n\trm -f bench/programs/*.elf\n\trm -f test/*.result.xml\n\tfind test -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\n\tfind tools -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true\nifneq ($(strip $(TARGET)),)\n\trm -rf $(OBJ_DIR)\n\trm -rf $(GEN_DIR)\n\trm -rf cores/$(TARGET)/sim_build\nendif\n", "exit_code": 0, "status": "completed"}}
