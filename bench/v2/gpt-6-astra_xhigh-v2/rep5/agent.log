 )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n/srv/hwebench/tmp/561ff4c6/c95e94ef\n/srv/hwebench/bin/codex-pkg/codex-path:/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep5/.codex-home/tmp/arg0/codex-arg0QOGxhN:/srv/hwebench/bin:/srv/hwebench/venv/bin:/srv/hwebench/local/bin:/srv/hwebench/toolchain/oss-cad-suite/bin:/srv/hwebench/toolchain/bin:/srv/hwebench/venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\n","exit_code":1,"status":"failed"}}
