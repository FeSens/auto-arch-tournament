{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -c 'tail -65 cores/bench/test/test_pipeline.py'","aggregated_output":"               SW(8, 0, 0x108), MUL(9, 7, 8), DIV(10, 9, 7),\n               ADDI(7, 0, 93), LW(7, 0, 0x102), DIV(11, 7, 7, 6),\n               LW(7, 0, 0x102), NOP(), ADD(12, 7, 7),\n               _i(0, 0, 1, 7, 0x67), ADD(13, 7, 7),\n               ADDI(0, 0, 7), ADD(14, 0, 0), EBREAK()]\n    _, events = await _checked_source_replay(dut, program)\n    assert {s for e in events for s in e[\"sources\"]} >= {1, 2, 4, 8}\n    assert not any(e[\"replay\"] for e in events), \"known faulting load predicted as writer\"\n    _, stalled = await _checked_source_replay(dut, program, stalled=True,\n                                            dmem_stalls=range(11, 22))\n    assert any(e[\"held\"] and e[\"occupancy\"] == 2 for e in stalled)\n\n\n@cocotb.test()\nasync def canceled_link_consumers_replay_precisely(dut):\n    # The immediately older same-register writer must survive cancellation.\n    # Include both raw fields and immediate/PC substitutions; the immediate\n    # in ADDI names x7 as rs2 even though the ALU does not consume that value.\n    consumers = [ADD(8, 7, 7), ADDI(8, 0, 7),\n                 (7 << 20) | (7 << 15) | (8 << 7) | 0x17,\n                 BEQ(7, 7, 8), JALR(8, 7, 20 - 0x140), LW(8, 7, 0), SW(7, 7, 0),\n                 MUL(8, 7, 7), DIV(8, 7, 7), DIV(8, 7, 7, 6)]\n    for producer in (JAL(7, 2), JALR(7, 0, 2)):\n        for consumer in consumers:\n            program = [ADDI(7, 0, 0x100), ADDI(7, 0, 0x140), producer,\n                       consumer, ADDI(9, 0, 3), DIV(10, 7, 7, 6), EBREAK()]\n            rets, events = await _checked_source_replay(dut, program)\n            replay = [e for e in events if e[\"replay\"]]\n            assert len(replay) == 1 and replay[0][\"pc\"] == 12\n            assert [r[\"pc_rdata\"] for r in rets if r[\"trap\"]] == [8]\n            # The original ten-cycle liveness window remains unchanged,\n            # including a replay immediately before a DIV/REM launch.\n            for trigger in range(rets[-1][\"cycle\"] - 9):\n                assert any(trigger < r[\"cycle\"] <= trigger + 10 for r in rets)\n            start = replay[0][\"cycle\"]\n            _, blocked = await _checked_source_replay(\n                dut, program, imem_stalls=range(start, start + 4),\n                dmem_stalls=range(start - 1, start + 7))\n            assert any(e[\"replay\"] and not e[\"iready\"] for e in blocked)\n            await _checked_source_replay(dut, program, stalled=True)\n    # Speculative link data makes this branch false; the committed x7=0\n    # makes it true. The replay must precede either computed branch result.\n    program = [ADDI(7, 0, 0), JALR(7, 0, 2), BEQ(7, 0, 8),\n               SW(7, 0, 0x108), DIV(8, 7, 7, 6), EBREAK()]\n    rets, events = await _checked_source_replay(dut, program)\n    assert [r[\"pc_rdata\"] for r in rets] == [0, 4, 8, 16, 20]\n    assert [e[\"pc\"] for e in events if e[\"replay\"]] == [8]\n\n\n@cocotb.test()\nasync def replay_full_queue_and_reset(dut):\n    # Hold the canceling producer behind an older store. Once the store\n    # drains, the queued dependent DIV enters EX and must replay before\n    # launching, with a second token already waiting behind it.\n    program = [ADDI(7, 0, 0x140), SW(7, 0, 0x108), JALR(7, 0, 2),\n               DIV(8, 7, 7), SW(8, 0, 0x10c), MUL(9, 8, 7), EBREAK()]\n    rets, events = await _checked_source_replay(dut, program,\n                                               dmem_stalls=range(3, 10))\n    assert any(e[\"held\"] and e[\"occupancy\"] == 2 for e in events)\n    [replay] = [e for e in events if e[\"replay\"]]\n    assert replay[\"occupancy\"] > 0\n    assert len(rets) == len(program)\n    for cycle in (4, 8, replay[\"cycle\"], replay[\"cycle\"] + 2):\n        await _checked_source_replay(dut, program, dmem_stalls=range(3, 10),\n                                     reset_at=cycle)\n","exit_code":0,"status":"completed"}}
