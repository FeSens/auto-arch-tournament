{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/generated/predictor_probe/test/test_pipeline.py')\ns=p.read_text()+'''\n\n@cocotb.test()\nasync def predicted_source_cancellation_progress(dut):\n    altops = os.environ.get(\\\"DIV_ALTOPS\\\") == \\\"1\\\"\n    program = [ADDI(2, 0, 7)]\n    checks = []\n    traps = []\n    for fault in (JAL(7, 2), JALR(7, 0, 2), LW(7, 0, 0x102)):\n        for f3 in range(8):\n            program += [ADDI(7, 0, 55), ADDI(7, 0, 140)]\n            traps.append(len(program)*4)\n            program += [fault]\n            checks.append((len(program)*4, f3))\n            program += [DIV(8, 7, 2, f3) if f3 >= 4 else MUL(8, 7, 2, f3), ADD(9,8,8)]\n    rets, _ = await _run(dut,program+[EBREAK()],dmem_init={0x100:0xdeadbeef},max_cycles=2000)\n    assert [r['pc'] for r in rets] == list(range(0,(len(program)+1)*4,4))\n    assert [r['order'] for r in rets] == list(range(len(rets)))\n    assert [r['pc'] for r in rets if r['trap']] == traps\n    for pc,f3 in checks:\n        r=next(r for r in rets if r['pc']==pc)\n        expected=(div_reference(OPS[f3-4],140,7,altops) if f3>=4 else mul_reference(MUL_OPS[f3],140,7,altops))\n        assert r['rd_wdata']==expected\n        assert (r['rs1_rdata'],r['rs2_rdata'])==(140,7)\n    gaps=[b['cycle']-a['cycle'] for a,b in zip(rets,rets[1:])]\n    assert max(gaps)<=10,gaps\n    for trigger in range(rets[-1]['cycle']-9):\n        assert any(trigger<r['cycle']<=trigger+10 for r in rets)\n'''\np.write_text(s)\nPY\npytest -q cores/bench/generated/predictor_probe/test/test_pipeline.py -k test_pipeline_runner > cores/bench/generated/predictor_probe/pipeline3.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
