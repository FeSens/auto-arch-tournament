{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,json\nfrom collections import Counter\nfrom pathlib import Path\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nm=RV32IM();m.load_elf('/srv/hwebench/tmp/561ff4c6/1677bc4b/direct-target/coremark.elf')\ncounts=Counter(); ctrs=[1]*64; caches={n:[None]*n for n in [32,64,128,256]}; active=False\nwhile True:\n r=m.step()\n if r is None: break\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n if r['mem_wmask'] and r['mem_addr']==0x10000104: break\n pc,insn,npc=r['pc'],r['insn'],r['npc'];op=insn&127;idx=(pc>>2)&63\n if active: counts['instructions']+=1;counts['op_'+hex(op)]+=1\n direct=op in (0x63,0x6f) and not r['trap']\n if not direct: continue\n taken=op==0x6f or npc\"'!=pc+4\n pred=op==0x6f or ctrs[idx]>=2\n if active: counts['\"'direct']+=1;counts['baseline_direction_misses']+=pred\"'!=taken\n for n,cache in caches.items():\n  k=(pc>>2)&(n-1);hit=cache[k]==(pc,insn)\n  if active:\n   counts[f'\"'cache{n}_misses']+=not hit\n   counts[f'cache{n}_direction_misses']+=(pred and hit)\"'!=taken\n  cache[k]=(pc,insn)\n if op==0x63: ctrs[idx]=max(0,min(3,ctrs[idx]+(1 if taken else -1)))\nprint(json.dumps(dict(counts),indent=2))\nPath('\"'/srv/hwebench/tmp/561ff4c6/1677bc4b/direct-target/profile.json').write_text(json.dumps(dict(counts),indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
