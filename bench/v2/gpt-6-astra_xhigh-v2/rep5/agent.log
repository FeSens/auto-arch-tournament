{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"git diff --check; cat cores/bench/rtl/forward_unit.sv; sed -n '360,402p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "// rtl/forward_unit.sv\n//\n// Register dependency matches alongside ID/EX, then qualify them with\n// actual producer write controls in EX. Alignment traps can still\n// suppress a producer write after decode, so only addresses are matched.\n// One-hot source encoding: bit 0 = RF, bit 1 = EX/MEM, bit 2 = MEM/WB.\n//\n// Priority is EX/MEM > MEM/WB > none (younger writer wins, x0 always 0).\n//\n// Latency:        matches captured on the existing ID/EX edge.\n// RVFI fields:    n/a — feeds rs1_rdata / rs2_rdata via EX-stage muxes.\nmodule forward_unit (\n  input  logic       clock,\n  input  logic       reset,\n  input  logic       stall_id,\n  input  logic       flush_id,\n  input  logic       stall_ex_mem,\n  input  logic       id_valid,\n  input  logic [4:0] id_rs1,\n  input  logic [4:0] id_rs2,\n  input  logic [4:0] id_ex_rd,\n  input  logic [4:0] ex_mem_rd,\n  input  logic       ex_mem_w_en,\n  input  logic       mem_wb_w_en,\n  output logic [2:0] fwd_rs1,\n  output logic [2:0] fwd_rs2\n);\n\n  logic rs1_ex_match, rs2_ex_match;\n  logic rs1_wb_match, rs2_wb_match;\n  logic rs1_ex, rs2_ex, rs1_wb, rs2_wb;\n\n  always_ff @(posedge clock) begin\n    // Match the ID/EX reset/flush/hold/invalid priorities exactly.\n    if (reset || flush_id) begin\n      rs1_ex_match <= 1'b0;\n      rs2_ex_match <= 1'b0;\n      rs1_wb_match <= 1'b0;\n      rs2_wb_match <= 1'b0;\n    end else if (stall_id) begin\n      if (!stall_ex_mem) begin\n        // M wait: the old EX/MEM producer advances to WB and EX/MEM\n        // becomes a bubble. Never sample a held instruction's queue head.\n        rs1_wb_match <= rs1_ex_match;\n        rs2_wb_match <= rs2_ex_match;\n        rs1_ex_match <= 1'b0;\n        rs2_ex_match <= 1'b0;\n      end\n      // dmem hold retains both producer payloads and both match sets.\n    end else if (!id_valid) begin\n      rs1_ex_match <= 1'b0;\n      rs2_ex_match <= 1'b0;\n      rs1_wb_match <= 1'b0;\n      rs2_wb_match <= 1'b0;\n    end else begin\n      rs1_ex_match <= id_ex_rd != 0 && id_ex_rd == id_rs1;\n      rs2_ex_match <= id_ex_rd != 0 && id_ex_rd == id\n…[1172 of 4244 chars elided by tools/bench/transcript.py; sha256:6c7f1d195360d614]…\n = 0\n    dut.reset.value = 1\n    dut.io_imemReady.value = dut.io_dmemReady.value = 1\n    dut.io_imemData.value = NOP()\n    dut.io_dmemRData.value = 0\n    await tick(dut)\n    await tick(dut)\n    dut.reset.value = 0\n    for cycle in range(5000):\n        dut.clock.value = 0\n        if cycle == reset_at:\n            if reset_occupancy is not None:\n                assert int(dut.u_if.occupancy.value) == reset_occupancy\n            dut.reset.value = 1\n            await tick(dut)\n            assert int(dut.u_if.occupancy.value) == 0\n            assert int(dut.io_imemAddr.value) == 0\n            assert int(dut.id_ex_w.value) == 0\n            assert [int(c.value) for c in dut.u_if.counters] == [1] * 64\n            dut.reset.value = 0\n            # Replace the interrupted instruction stream: a stale division\n            # must never appear in this new retirement epoch.\n            program = [ADDI(9, 0, 77), EBREAK()]\n            regs, expected_pc = [0] * 32, 0\n            rets, accepted, expected_accesses = [], [], []\n", "exit_code": 0, "status": "completed"}}
