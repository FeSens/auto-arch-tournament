{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_hazard_unit.py'","aggregated_output":"\"\"\"Explicit correction/hold priorities with unmasked raw dependencies.\"\"\"\nimport itertools\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\n\n\n@cocotb.test()\nasync def correction_and_raw_dependency(dut):\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 5\n    dut.if_id_rs1.value = 5\n    dut.if_id_rs2.value = 5\n    dut.ex_mem_mem_op.value = 1\n    for valid, dready, wait, redirect in itertools.product((0, 1), repeat=4):\n        dut.head_valid.value = valid\n        dut.dmem_ready.value = dready\n        dut.execute_wait.value = wait\n        dut.redirect.value = redirect\n        await Timer(1, unit=\"ns\")\n        assert int(dut.decode_accept.value) == 0\n        assert int(dut.load_use_hazard.value) == valid\n        assert int(dut.stall_id.value) == int(valid or not dready or wait)\n        assert int(dut.flush_id.value) == int((valid or redirect) and dready and not wait)\n        assert int(dut.stall_ex_mem.value) == 1 - dready\n        assert int(dut.hold_mem_wb.value) == 1 - dready\n    # Removing the raw match must not affect correction's explicit flush.\n    dut.head_valid.value = dut.dmem_ready.value = 1\n    dut.execute_wait.value = 0\n    dut.redirect.value = 1\n    for rs1, rs2 in ((0, 0), (5, 0), (0, 5)):\n        dut.if_id_rs1.value, dut.if_id_rs2.value = rs1, rs2\n        await Timer(1, unit=\"ns\")\n        assert int(dut.flush_id.value) == 1\n        assert int(dut.decode_accept.value) == 0\n\n\n@cocotb.test()\nasync def head_acceptance_and_older_holds(dut):\n    # Bus ready is deliberately absent from this interface. A stored head\n    # has exactly the same acceptance rules as a ready empty-queue bypass.\n    dut.if_id_rs1.value = 5\n    dut.if_id_rs2.value = 6\n    for valid, load, rd, mem, dready, wait, redirect in itertools.product(\n            (0, 1), (0, 1), (0, 5, 6, 7), (0, 1), (0, 1), (0, 1), (0, 1)):\n        dut.head_valid.value = valid\n        dut.id_ex_mem_read.value, dut.id_ex_rd.value = load, rd\n        dut.ex_mem_mem_op.value, dut.dmem_ready.value = mem, dready\n        dut.execute_wait.value, dut.redirect.value = wait, redirect\n        await Timer(1, unit=\"ns\")\n        hazard = valid and load and rd in (5, 6)\n        hold = mem and not dready\n        assert int(dut.load_use_hazard.value) == hazard\n        assert int(dut.stall_id.value) == int(hold or wait or hazard)\n        assert int(dut.flush_id.value) == int((hazard or redirect) and not hold and not wait)\n        assert int(dut.decode_accept.value) == int(valid and not (hold or wait or hazard or redirect))\n        assert int(dut.stall_ex_mem.value) == hold\n        assert int(dut.hold_mem_wb.value) == hold\n\n\ndef test_hazard_unit_runner():\n    run_cocotb(\"hazard_unit\", [\"hazard_unit.sv\"], \"test_hazard_unit\")\n","exit_code":0,"status":"completed"}}
