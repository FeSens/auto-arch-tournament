{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,180p' cores/bench/test/conftest.py; sed -n '1,180p' cores/bench/test/test_div_unit.py; sed -n '1,130p' cores/bench/test/test_alu.py\"", "aggregated_output": "\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n\"\"\"Exercise the actual sequential divider, with exact integer references.\"\"\"\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n\n\ndef reference(op, a, b, altops=ALTOPS):\n    a, b = a & MASK, b & MASK\n    if altops:\n        return ((a - b) ^ dict(zip(OPS, (\n            0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))[op]) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n        q = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            q = -q\n    else:\n        q = a // b\n    return (a - q * b if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value)\n    assert not int(dut.result_valid.value)\n\n\nasync def operation(dut, op, a, b, hold=0):\n    assert not int(dut.busy.value)\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    dut.start.value = 1\n    await tick(dut)  # capture, magnitudes and two bits, service edge 1\n    assert int(dut.busy.value) and not int(dut.re\n…[8240 of 11312 chars elided by tools/bench/transcript.py; sha256:56075baf6c84f2b0]…\nut, ALU_SLTU, 0xFFFFFFFF, 0, 0)             # max > 0\n    await _check(dut, ALU_SLTU, 0, 1, 1)\n\n\n@cocotb.test()\nasync def sll(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SLL, 1, 4, 16)\n    await _check(dut, ALU_SLL, 1, 31, 0x80000000)\n    await _check(dut, ALU_SLL, 1, 0x20, 1)                    # shamt = b[4:0] = 0\n\n\n@cocotb.test()\nasync def srl(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRL, 0x80000000, 1, 0x40000000)\n    await _check(dut, ALU_SRL, 0x80000000, 31, 1)\n    await _check(dut, ALU_SRL, 0xFFFFFFFF, 0x25, 0x07FFFFFF)   # shamt masked\n\n\n@cocotb.test()\nasync def sra(dut):\n    await _setup(dut)\n    await _check(dut, ALU_SRA, 0x80000000, 1, 0xC0000000)\n    await _check(dut, ALU_SRA, 0x80000000, 31, 0xFFFFFFFF)\n    await _check(dut, ALU_SRA, 0x7FFFFFFF, 1, 0x3FFFFFFF)\n\n\n@cocotb.test()\nasync def lui(dut):\n    await _setup(dut)\n    await _check(dut, ALU_LUI, 0, 0x12345000, 0x12345000)\n\n\n@cocotb.test()\nasync def mul(dut):\n    await _setup(dut)\n    await _check(dut, ALU_MUL, 3, 4, 12)\n", "exit_code": 0, "status": "completed"}}
