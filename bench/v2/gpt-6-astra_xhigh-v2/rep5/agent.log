{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK = (1 << 32) - 1\n\ndef unsigned_array(a, b):\n    r, q = a, 0\n    for k in range(31, -1, -1):\n        w = 32 - k\n        lowmask = (1 << w) - 1\n        trial = ((r >> k) - (b & lowmask)) & ((1 << (w + 1)) - 1)\n        take = not (trial >> w) and not (b >> w)\n        if take:\n            q |= 1 << k\n            r = ((trial & lowmask) << k) | (r & ((1 << k) - 1))\n    return q, r\n\ndef proposed(a, b, signed):\n    neg_a = signed and bool(a & (1 << 31))\n    neg_b = signed and bool(b & (1 << 31))\n    aa = (-a & MASK) if neg_a else a\n    bb = (-b & MASK) if neg_b else b\n    q, r = unsigned_array(aa, bb)\n    q = (-q & MASK) if neg_a \"'!= neg_b else q\n    r = (-r & MASK) if neg_a else r\n    return (MASK, a) if b == 0 else (q, r)\n\ndef reference(a, b, signed):\n    if b == 0:\n        return MASK, a\n    aa = a - (1 << 32) if signed and a >> 31 else a\n    bb = b - (1 << 32) if signed and b >> 31 else b\n    q = abs(aa) // abs(bb)\n    if (aa < 0) != (bb < 0):\n        q = -q\n    return q & MASK, (aa - q * bb) & MASK\n\nedge = {0, 1, MASK, 0x80000000, 0x7fffffff}\nfor bit in range(32):\n    edge.update(((1 << bit) + delta) & MASK for delta in (-1, 0, 1))\nrng = random.Random(20261003)\npairs = [(a,b) for a in edge for b in edge]\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(20000)]\nfor a, b in pairs:\n    for signed in (False, True):\n        assert proposed(a,b,signed) == reference(a,b,signed), (hex(a),hex(b),signed)\nprint(f'\"'Proposed recurrence and sign handling match integer reference for {2 * len(pairs)} signed/unsigned operand cases; this is an algorithm check, not RTL or timing validation.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
