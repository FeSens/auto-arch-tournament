{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/test_div_unit.py | head -65; rg -n 'io_imemReady|assume|cover|stall|liveness' formal/wrapper_si.sv formal/checks_si.cfg; git diff --stat\"","aggregated_output":"\"\"\"Exercise the actual sequential divider, with exact integer references.\"\"\"\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n\n\ndef reference(op, a, b, altops=ALTOPS):\n    a, b = a & MASK, b & MASK\n    if altops:\n        return ((a - b) ^ dict(zip(OPS, (\n            0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))[op]) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n        q = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            q = -q\n    else:\n        q = a // b\n    return (a - q * b if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value)\n    assert not int(dut.result_valid.value)\n\n\nasync def operation(dut, op, a, b, hold=0):\n    assert not int(dut.busy.value)\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    dut.start.value = 1\n    await tick(dut)  # capture, magnitudes and two bits, service edge 1\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n    dut.start.value = 0\n    # Live operands and operation may change while the captured work runs.\n    dut.a.value, dut.b.value, dut.op.value = 0x13579bdf, 0, ALU_REMU\n    for edge in range(2, 8):\n        # Neither busy starts nor premature accepts may disturb a group.\n        dut.start.value = edge % 2\nformal/checks_si.cfg:16:# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\nformal/checks_si.cfg:18:# liveness — CPU makes forward progress under any symbolic stream\nformal/checks_si.cfg:20:cover      1    20\nformal/checks_si.cfg:22:liveness   1 10 20\nformal/checks_si.cfg:28:# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\nformal/checks_si.cfg:31:[cover]\nformal/checks_si.cfg:32:# Sanity cover: the CPU must retire at least one non-trapping instruction.\nformal/checks_si.cfg:33:always @* if (!reset) cover (rvfi_valid && !rvfi_trap);\nformal/wrapper_si.sv:38:        .io_imemReady       (1'b1),\n cores/bench/rtl/core.sv        |  5 +++--\n cores/bench/rtl/hazard_unit.sv | 19 +++++++++----------\n cores/bench/rtl/id_stage.sv    | 23 ++++++++++++++++++++---\n cores/bench/rtl/if_stage.sv    | 11 +++++------\n 4 files changed, 37 insertions(+), 21 deletions(-)\n","exit_code":0,"status":"completed"}}
