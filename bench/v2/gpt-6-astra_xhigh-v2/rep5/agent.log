{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,210p' cores/bench/test/test_if_stage.py && sed -n '1,160p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Fetch FIFO, direct predictor boundaries, metadata and PC priorities.\"\"\"\nimport random\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\nfrom test_div_unit import tick\nfrom test_pipeline import BEQ, JAL, JALR, LW, SW, DIV, ADDI, _b, _prediction_reference\n\n\ndef fields(dut):\n    bundle = int(dut.out.value)\n    return bundle >> 34, (bundle >> 2) & 0xffffffff, (bundle >> 1) & 1, bundle & 1\n\n\nasync def at_pc(dut, pc):\n    dut.redirect.value = 1\n    dut.redirect_target.value = pc\n    await tick(dut)\n    dut.redirect.value = 0\n    await Timer(1, unit=\"ns\")\n    assert int(dut.imem_addr.value) == pc\n\n\n@cocotb.test()\nasync def preedge_training_and_saturation(dut):\n    dut.reset.value = 1\n    dut.redirect.value = 0\n    dut.decode_accept.value = dut.imem_ready.value = 1\n    dut.redirect_target.value = 0\n    dut.imem_data.value = BEQ(0, 0, 16)\n    dut.branch_train.value = 1\n    dut.branch_index.value = 0\n    dut.branch_outcome.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    assert [int(c.value) for c in dut.counters] == [1] * 64\n    # Training 01 -> 10 must not bypass into this edge's fetch choice.\n    await Timer(1, unit=\"ns\")\n    assert fields(dut)[2] == 0\n    await tick(dut)\n    assert int(dut.imem_addr.value) == 4\n    assert int(dut.counters[0].value) == 2\n    dut.branch_train.value = 0\n    await at_pc(dut, 0)\n    # Training 10 -> 01 must still select the old taken prediction.\n    dut.branch_train.value = 1\n    dut.branch_outcome.value = 0\n    await Timer(1, unit=\"ns\")\n    assert fields(dut)[2] == 1\n    await tick(dut)\n    assert int(dut.imem_addr.value) == 16\n    assert int(dut.counters[0].value) == 1\n    # While fetch is held, independent advancing branch feedback still\n    # updates the *current* stored counter, saturating at each endpoint.\n    dut.imem_ready.value = 0\n    for outcome, expected in ((0, [0, 0, 0]), (1, [1, 2, 3, 3, 3])):\n        dut.branch_outcome.value = outcome\n        for count in expected:\n            await tick(dut)\n            assert int(dut.counters[0].va\n…[11281 of 14353 chars elided by tools/bench/transcript.py; sha256:3a23bdd832cbada1]…\n           \"rs1_rdata\": int(dut.io_rvfi_rs1_rdata_0.value),\n                \"rs2_addr\":  int(dut.io_rvfi_rs2_addr_0.value),\n                \"rs2_rdata\": int(dut.io_rvfi_rs2_rdata_0.value),\n                \"trap\":      int(dut.io_rvfi_trap_0.value),\n                \"mem_addr\":  int(dut.io_rvfi_mem_addr_0.value),\n                \"mem_wmask\": int(dut.io_rvfi_mem_wmask_0.value),\n                \"mem_wdata\": int(dut.io_rvfi_mem_wdata_0.value),\n                \"mem_rmask\": int(dut.io_rvfi_mem_rmask_0.value),\n                \"mem_rdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            retirements.append(r)\n            if r[\"insn\"] == EBREAK():\n                break\n\n        # Drive next cycle's imem fetch and dmem read combinationally.\n        dut.io_imemData.value  = imem.get(ia & ~3, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    return retirements, dmem\n", "exit_code": 0, "status": "completed"}}
