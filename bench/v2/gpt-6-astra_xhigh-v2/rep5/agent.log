{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/561ff4c6/a0b518c6/r12s0')\nrtl=root/'alu_masks'\nrtl.mkdir(exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'id_stage.sv'; s=p.read_text().replace('  output id_ex_t  out','  output logic alu_uses_pc, alu_uses_imm,\\\\n  output id_ex_t  out'); s=s.replace('  ctrl_t ctrl_decoded;', '  assign alu_uses_pc = dec_is_auipc;\\\\n  assign alu_uses_imm = dec_alu_src;\\\\n\\\\n  ctrl_t ctrl_decoded;');p.write_text(s)\np=rtl/'forward_unit.sv';s=p.read_text().replace('  input  logic       id_valid,','  input  logic       id_valid,\\\\n  input logic alu_uses_pc, alu_uses_imm,').replace('  output logic       prediction_failed','  output logic [4:0] alu_a_sel, alu_b_sel,\\\\n  output logic       prediction_failed')\ns=s.replace(\\\"      fwd_rs2 <= '0;\\\", \\\"      fwd_rs2 <= '0;\\\\n      alu_a_sel <= '0;\\\\n      alu_b_sel <= '0;\\\")\ns=s.replace('      // dmem hold retains', '''      if (\"'!stall_ex_mem) begin\n        if (!alu_a_sel[4])\n          alu_a_sel <= {1'\"'b0, alu_a_sel[1] && ex_mem_load,\n                        alu_a_sel[1] && \"'!ex_mem_load, 1'\"'b0, \"'!alu_a_sel[1]};\n        if (!alu_b_sel[4])\n          alu_b_sel <= {1'\"'b0, alu_b_sel[1] && ex_mem_load,\n                        alu_b_sel[1] && \"'!ex_mem_load, 1'\"'b0, \"'!alu_b_sel[1]};\n      end\n      // dmem hold retains'\"''')\ns=s.replace('      fwd_rs1 <= {rs1_wb', '''      alu_a_sel <= {alu_uses_pc, \"'!alu_uses_pc && rs1_wb && ex_mem_load,\n                    !alu_uses_pc && rs1_wb && !ex_mem_load,\n                    !alu_uses_pc && rs1_ex, !alu_uses_pc && !(rs1_ex || rs1_wb)};\n      alu_b_sel <= {alu_uses_imm, !alu_uses_imm && rs2_wb && ex_mem_load,\n                    !alu_uses_imm && rs2_wb && !ex_mem_load,\n                    !alu_uses_imm && rs2_ex, !alu_uses_imm && !(rs2_ex || rs2_wb)};\n      fwd_rs1 <= {rs1_wb'\"''');p.write_text(s)\np=rtl/'core.sv';s=p.read_text().replace('  // EX redirect','  logic alu_uses_pc, alu_uses_imm;\\\\n  logic [4:0] alu_a_sel, alu_b_sel;\\\\n\\\\n  // EX redirect',1)\ns=s.replace('    .out      (id_ex_w)', '    .alu_uses_pc(alu_uses_pc), .alu_uses_imm(alu_uses_imm),\\\\n    .out      (id_ex_w)')\ns=s.replace('    .fwd_rs1_sel     (fwd_rs1_sel),','    .alu_a_sel(alu_a_sel), .alu_b_sel(alu_b_sel),\\\\n    .fwd_rs1_sel     (fwd_rs1_sel),')\ns=s.replace('    .id_valid    (if_id_w.valid),','    .alu_uses_pc(alu_uses_pc), .alu_uses_imm(alu_uses_imm),\\\\n    .alu_a_sel(alu_a_sel), .alu_b_sel(alu_b_sel),\\\\n    .id_valid    (if_id_w.valid),');p.write_text(s)\np=rtl/'ex_stage.sv';s=p.read_text().replace('  input  logic               prediction_failed,','  input  logic [4:0]         alu_a_sel, alu_b_sel,\\\\n  input  logic               prediction_failed,')\na=s.index('    // Fold PC/immediate');b=s.index('\\\\n  logic [31:0] alu_result;',a)\ns=s[:a]+'''    alu_a = ((in.rs1_val & {32{alu_a_sel[0]}}) |\n             (fwd_ex_mem & {32{alu_a_sel[1]}})) |\n            ((fwd_wb_alu & {32{alu_a_sel[2]}}) |\n             (fwd_wb_load & {32{alu_a_sel[3]}})) |\n             (in.pc & {32{alu_a_sel[4]}});\n    alu_b = ((in.rs2_val & {32{alu_b_sel[0]}}) |\n             (fwd_ex_mem & {32{alu_b_sel[1]}})) |\n            ((fwd_wb_alu & {32{alu_b_sel[2]}}) |\n             (fwd_wb_load & {32{alu_b_sel[3]}})) |\n             (in.imm & {32{alu_b_sel[4]}});\n  end\n''' + s[b:];p.write_text(s)\nprint(rtl)\nPY\npython -u - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval.gowin import build\nroot=Path('/srv/hwebench/tmp/561ff4c6/a0b518c6/r12s0')\nr=build(Path.cwd(),root/'alu_masks','fpga/core_bench_si.sv',1,root/'masks_p1')\n(root/'masks.json').write_text(json.dumps(r,indent=2))\nprint(json.dumps(r,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
