{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"rg -n 'ex_stage.sv.*assert|f_seen_reset|alu_a_sel' formal/riscv-formal/cores/bench-wj54pliVG/checks/insn_add_ch0/model/design.log | head -15 && cat cores/bench/test/test_div_unit.py | head -n 65\"","aggregated_output":"694:     4/4: $0\\alu_a_sel[4:0]\n1163:Creating register for signal `\\forward_unit.\\alu_a_sel' using process `\\forward_unit.$proc$/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep5/formal/riscv-formal/cores/bench-wj54pliVG/../../cores/bench-wj54pliVG/forward_unit.sv:53$247'.\n1502:      Replacing known input bits on port B of cell $flatten\\wrapper.\\uut.\\u_fwd.$procmux$3072: \\wrapper.uut.u_fwd.alu_a_sel -> { 1'1 \\wrapper.uut.u_fwd.alu_a_sel [3:0] }\n\"\"\"Exercise the actual sequential divider, with exact integer references.\"\"\"\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n\n\ndef reference(op, a, b, altops=ALTOPS):\n    a, b = a & MASK, b & MASK\n    if altops:\n        return ((a - b) ^ dict(zip(OPS, (\n            0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))[op]) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n        q = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            q = -q\n    else:\n        q = a // b\n    return (a - q * b if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value