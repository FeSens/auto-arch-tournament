{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/561ff4c6/8ba1bd50')\noriginal=Path('cores/bench/rtl/div_unit.sv').read_text()\nfor name,bits in [('r14_div_16_2',(4,1)),('r14_div_4_8',(2,3))]:\n root=base/name;shutil.copytree('cores/bench/rtl',root/'rtl',dirs_exist_ok=True)\n b1,b2=bits;n1=1<<b1;n2=1<<b2\n s=original\n begin=s.index('  logic [34:0] divisor3');end=s.index('  logic [31:0] result_magnitude;',begin)\n decl=f'  logic [35:0] odd_multiple [0:{n1//2-1}];\\\\n  logic [35:0] multiple [1:{max(n1,n2)-1}];\\\\n'\n for stage,n in [(1,n1),(2,n2)]:\n  decl+=f'  logic [36:0] difference{stage} [1:{n-1}];\\\\n  logic [{n-1}:0] enable{stage};\\\\n  logic [{n-1}:1] fit{stage};\\\\n  logic [{(b1 if stage==1 else b2)-1}:0] digit{stage};\\\\n  logic [35:0] trial{stage};\\\\n'\n decl+='  logic [31:0] q_after, r_after, q_next, r_next;\\\\n'\n s=s[:begin]+decl+s[end:]\n begin=s.index('  // Each launch multiple');end=s.index('\\\\n\"'`endif'\"',begin)\n # Provision up to seven odd multiples for swapped grouping as well.\n maxn=max(n1,n2);oddcount=maxn//2\n s=s.replace(f'odd_multiple [0:{n1//2-1}]',f'odd_multiple [0:{oddcount-1}]')\n body=''\n for k in range(1,maxn):\n  odd=k;shift=0\n  while odd%2==0:odd//=2;shift+=1\n  body+=f'  assign multiple[{k}] = odd_multiple[{odd//2}] << {shift};\\\\n'\n body+='  always_comb begin\\\\n'\n for st,n,b in [(1,n1,b1),(2,n2,b2)]:\n  rr='remainder' if st==1 else 'r_after';qq='quotient' if st==1 else 'q_after';newr='r_after' if st==1 else 'r_next';newq='q_after' if st==1 else 'q_next'\n  body+=f\\\"    trial{st} = {{ {4-b}'b0, {rr}, {qq}[31:{32-b}] }};\\\\n\\\" if b<4 else f'    trial{st} = {{{rr}, {qq}[31:{32-b}]}};\\\\n'\n  for k in range(1,n):body+=f\\\"    difference{st}[{k}] = {{1'b0,trial{st}}} - {{1'b0,multiple[{k}]}};\\\\n    fit{st}[{k}] = \"'!difference{st}[{k}][36];'\"\\\\n\\\"\n  body+=f'    enable{st}[0] = \"'!fit{st}[1];'\"\\\\n'\n  for k in range(1,n-1):body+=f'    enable{st}[{k}] = fit{st}[{k}] && \"'!fit{st}[{k+1}];'\"\\\\n'\n  body+=f'    enable{st}[{n-1}] = fit{st}[{n-1}];\\\\n'\n  def tree(xs):\n   if len(xs)==1:return xs[0]\n   mid=len(xs)//2;return '('+tree(xs[:mid])+' | '+tree(xs[mid:])+')'\n  body+=f'    {newr} = '+tree([f'(trial{st}[31:0] & {{32{{enable{st}[0]}}}})']+[f'(difference{st}[{k}][31:0] & {{32{{enable{st}[{k}]}}}})' for k in range(1,n)])+';\\\\n'\n  for bit in range(b):body+=f'    digit{st}[{bit}] = '+tree([f'enable{st}[{k}]' for k in range(n) if k&(1<<bit)])+';\\\\n'\n  body+=f'    {newq} = {{{qq}[{31-b}:0],digit{st}}};\\\\n'\n body+='  end\\\\n';s=s[:begin]+body+s[end:]\n s=s.replace(\\\"      divisor3 <= '0;\\\\n      divisor5 <= '0;\\\\n      divisor7 <= '0;\\\",''.join(f\\\"      odd_multiple[{k}] <= '0;\\\\n\\\" for k in range(oddcount)))\n begin=s.index('          divisor3 <=');end=s.index('          negate_q <=',begin)\n setup=''\n for i in range(oddcount):\n  k=2*i+1;parts=[f\\\"({{4'b0,magnitude_b}} << {j})\\\" for j in range(4) if k&(1<<j)]\n  if k in (7,15):parts=[f\\\"({{4'b0,magnitude_b}} << {k.bit_length()}) - {{4'b0,magnitude_b}}\\\"]\n  setup+=f'          odd_multiple[{i}] <= '+ ' + '.join(parts)+';\\\\n'\n s=s[:begin]+setup+s[end:];(root/'rtl/div_unit.sv').write_text(s)\nprint('Prepared native-carry recurrence regroupings')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
