{"type": "item.completed", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/rtl/if_stage.sv && sed -n '65,115p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "// rtl/if_stage.sv\n//\n// Instruction fetch stage. Holds the PC register; the IF/ID payload\n// (pc + instr + valid) is *combinational* — there is no separate IF/ID\n// flop in this microarchitecture, the next-stage's ID/EX register\n// captures everything one cycle later.\n//\n// On flush or redirect, the instruction emitted to ID is forced to NOP\n// (`0x00000013` = ADDI x0,x0,0). This prevents the hazard unit from\n// observing a real rs1/rs2 from a wrong-path instruction and inserting\n// a spurious load-use stall the cycle after a taken branch.\n//\n// Latency:        PC-reg update is synchronous; output is combinational.\n// RVFI fields:    feeds pc_rdata (via ID/EX/MEM/WB) and pc_wdata (via\n//                 EX-stage redirect).\nmodule if_stage (\n  input  logic              clock,\n  input  logic              reset,\n  input  logic              stall,            // load-use or either bus holds fetch\n  input  logic              flush,            // emit NOP into ID this cycle\n  input  logic              redirect,         // advancing EX prediction correction\n  input  logic [31:0]       redirect_target,\n  input  logic              train_branch,\n  /* verilator lint_off UNUSEDSIGNAL */\n  input  logic [31:0]       train_pc,          // direction aliases by PC[7:2]\n  /* verilator lint_on UNUSEDSIGNAL */\n  input  logic              train_taken,\n  output logic [31:0]       imem_addr,\n  input  logic [31:0]       imem_data,\n  output if_id_t  out\n);\n\n  localparam logic [31:0] RESET_PC = 32'h0000_0000;\n\n  logic [31:0] pc;\n  logic [1:0] direction [0:63];\n  logic        fetch_branch;\n  logic        fetch_jal;\n  logic [31:0] target_imm;\n  logic [31:0] target_pc;\n  logic [31:0] predicted_next_pc;\n\n  // Only direction is stored. The raw fetched instruction supplies its\n  // own target, independently of the flush-masked IF/ID instruction.\n  // Thus aliasing cannot supply a stale target or create a flush feedback\n  // path through prediction. All additions retain the full 32-bit PC.\n  always_comb begin\n    fetch_branch = imem_data[6:0] ==\n…[2875 of 5947 chars elided by tools/bench/transcript.py; sha256:8c54c5be4edf9beb]…\n 0\n    dut.io_dmemRData.value = 0\n    dut.io_imemReady.value = 1\n    dut.io_dmemReady.value = 1\n    for _ in range(3):\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n\n    dut.reset.value = 0\n\n    for cycle in range(max_cycles):\n        ia        = int(dut.io_imemAddr.value)\n        da        = int(dut.io_dmemAddr.value)\n        wen       = int(dut.io_dmemWEn.value)\n        wdata     = int(dut.io_dmemWData.value)\n        assert ia % 4 == 0 and 0 <= ia < 0x100000, f\"unsafe fetch: {ia:#x}\"\n        request = {\"cycle\": cycle, \"pc\": ia, \"addr\": da, \"wen\": wen,\n                   \"ren\": int(dut.io_dmemREn.value), \"wdata\": wdata}\n        ir, dr = ready(cycle, request) if ready else (1, 1)\n        dut.io_imemReady.value = ir\n        dut.io_dmemReady.value = dr\n        dut.io_imemData.value = imem.get(ia, EBREAK())\n        dut.io_dmemRData.value = dmem.get(da & ~3, 0)\n        await Timer(5, \"ns\")\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n", "exit_code": 0, "status": "completed"}}
