    insn = insn[min(visits.get(ia, 0), len(insn) - 1)]\n        iready = (not stalled or rng.randrange(5) != 0) and cycle not in imem_stalls\n        # Even an unready bus presents real load/store encodings. Invalid\n        # decode controls must not leak into memory, forwarding or EX.\n        raw = insn if iready else (LW(7, 0, 0x700), SW(7, 0, 0x704),\n                                  DIV(7, 3, \n…[17474 of 20546 chars elided by tools/bench/transcript.py; sha256:d87ba4910968a635]…\net.value = 0\n            # Replace the interrupted instruction stream: a stale division\n            # must never appear in this new retirement epoch.\n            program = [ADDI(9, 0, 77), EBREAK()]\n            regs, expected_pc = [0] * 32, 0\n            rets, accepted, expected_accesses = [], [], []\n            mem, refmem = dict(initial_mem), dict(initial_mem)\n            held_request = None\n        dut.io_imemReady.value = int((not stalled or rng.randrange(5) != 0)\n                                    and cycle not in imem_stalls)\n        ia = int(dut.io_imemAddr.value)\n        dut.io_imemData.value = program[ia // 4] if ia // 4 < len(program) else EBREAK()\n        await Timer(1, unit=\"ns\")\n        da, wen, ren = (int(dut.io_dmemAddr.value), int(dut.io_dmemWEn.value),\n                        int(dut.io_dmemREn.value))\n        wd = int(dut.io_dmemWData.value)\n        request = (da, wen, ren, wd)\n        if held_request is not None:\n            assert request == held_request, \"stalled memory request changed\"\n", "exit_code": 0, "status": "completed"}}
