{"type": "item.completed", "item": {"id": "item_3", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/test_hazard_unit.py && sed -n '1,260p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "\"\"\"Explicit correction/hold priorities with unmasked raw dependencies.\"\"\"\nimport itertools\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom _helpers import run_cocotb\n\n\n@cocotb.test()\nasync def correction_and_raw_dependency(dut):\n    dut.id_ex_mem_read.value = 1\n    dut.id_ex_rd.value = 5\n    dut.if_id_rs1.value = 5\n    dut.if_id_rs2.value = 5\n    dut.ex_mem_mem_op.value = 1\n    for iready, dready, wait, redirect in itertools.product((0, 1), repeat=4):\n        dut.imem_ready.value = iready\n        dut.dmem_ready.value = dready\n        dut.execute_wait.value = wait\n        dut.redirect.value = redirect\n        await Timer(1, unit=\"ns\")\n        assert int(dut.stall_if.value) == 1\n        assert int(dut.stall_id.value) == 1\n        assert int(dut.flush_id.value) == int(dready and not wait)\n        assert int(dut.flush_if.value) == int(redirect or not iready)\n        assert int(dut.stall_ex_mem.value) == 1 - dready\n        assert int(dut.hold_mem_wb.value) == 1 - dready\n    # Removing the raw match must not affect correction's explicit flush.\n    dut.imem_ready.value = dut.dmem_ready.value = 1\n    dut.execute_wait.value = 0\n    dut.redirect.value = 1\n    for rs1, rs2 in ((0, 0), (5, 0), (0, 5)):\n        dut.if_id_rs1.value, dut.if_id_rs2.value = rs1, rs2\n        await Timer(1, unit=\"ns\")\n        assert int(dut.flush_id.value) == int(dut.flush_if.value) == 1\n\n\ndef test_hazard_unit_runner():\n    run_cocotb(\"hazard_unit\", [\"hazard_unit.sv\"], \"test_hazard_unit\")\n\"\"\"End-to-end pipeline tests for rtl/core.sv.\n\nDrives a minimal Python-side imem/dmem against the core's combinational\nfetch/load model and captures RVFI retirements. Covers the §8 phase-2\nacceptance set: forwarding (EX->EX, MEM