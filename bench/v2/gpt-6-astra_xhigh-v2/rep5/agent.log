{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/561ff4c6/10efe6cb/profile_loads.py <<'PY'\nimport subprocess,json,collections,pickle\nbase='/srv/hwebench/tmp/561ff4c6/10efe6cb/'\np=subprocess.Popen([base+'predictor_profile/cosim_sim','/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep5/bench/programs/coremark.elf','10000000','--istall','--dstall'],stdout=subprocess.PIPE,text=True)\nactive=False; prev=None; counts=collections.Counter(); pairs=[]; last={}; delta={}; hist=collections.defaultdict(collections.Counter)\nfor line in p.stdout:\n if not line.startswith('{'): continue\n r=json.loads(line)\n if r.get('mem_wmask') and r.get('mem_addr')==0x10000100: active=True\n if r.get('mem_wmask') and r.get('mem_addr')==0x10000104: active=False\n ins=r.get('insn',0); op=ins&127; pc=r.get('pc_rdata',0)\n if prev and prev['insn']&127==3 and prev['rd_addr']:\n  rd=prev['rd_addr']; uses1=op in (3,19,35,51,99,103) and ((ins>>15)&31)==rd\n  uses2=op in (35,51,99) and ((ins>>20)&31)==rd\n  rawuse=((ins>>15)&31)==rd or ((ins>>20)&31)==rd\n  if active and rawuse: counts['raw_hazards']+=1\n  if active and rawuse and not(uses1 or uses2): counts['false_hazards']+=1\n  if uses1 or uses2:\n   lp=prev['pc_rdata']; v=prev['rd_wdata']; old=last.get(lp); d=delta.get(lp)\n   if active:\n    counts['load_use']+=1; counts[f'consumer_{op}']+=1\n    counts['last_value_success']+=v==old\n    counts['stride_success']+=old is not None and d is not None and ((old+d)&0xffffffff)==v\n    hist[lp]['total']+=1; hist[lp]['last']+=v==old; hist[lp]['stride']+=old is not None and d is not None and ((old+d)&0xffffffff)==v\n   pairs.append((lp,pc,op,v,active))\n if prev and prev['insn']&127==3:\n  lp=prev['pc_rdata']; v=prev['rd_wdata']; old=last.get(lp)\n  if old is not None: delta[lp]=(v-old)&0xffffffff\n  last[lp]=v\n prev=r\np.wait()\nprint(json.dumps(dict(counts=counts,hot_loads=sorted(hist.items(),key=lambda x:-x[1]['total'])[:35]),indent=2))\nwith open(base+'load_pairs.pkl','wb') as f: pickle.dump(pairs,f)\nPY\npython /srv/hwebench/tmp/561ff4c6/10efe6cb/profile_loads.py > /srv/hwebench/tmp/561ff4c6/10efe6cb/load_summary.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
