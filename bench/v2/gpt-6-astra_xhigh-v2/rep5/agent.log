{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/561ff4c6/cb4fd697/r14_branch_sources')\nrtl=root/'rtl'\nrtl.mkdir(parents=True, exist_ok=True)\nfor p in Path('cores/bench/rtl').glob('*.sv'): shutil.copy2(p,rtl/p.name)\np=rtl/'ex_stage.sv'\ns=p.read_text()\nold='''  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = (rs1 == rs2);\n      BR_BNE:  branch_cond = (rs1 \"'!= rs2);\n      BR_BLT:  branch_cond = ($signed(rs1) <  $signed(rs2));\n      BR_BGE:  branch_cond = ($signed(rs1) >= $signed(rs2));\n      BR_BLTU: branch_cond = (rs1 <  rs2);\n      BR_BGEU: branch_cond = (rs1 >= rs2);\n      default: branch_cond = 1'\"'b0;\n    endcase\n'''\nnew='''  wire [31:0] branch_source [0:4];\n  wire branch_eq [0:4][0:4];\n  wire branch_ult [0:4][0:4];\n  wire [15:0] eq_terms, ult_terms, slt_terms;\n  wire selected_eq, selected_ult, selected_slt;\n  assign branch_source[0] = in.rs1_val;\n  assign branch_source[1] = in.rs2_val;\n  assign branch_source[2] = fwd_ex_mem;\n  assign branch_source[3] = fwd_wb_alu;\n  assign branch_source[4] = fwd_wb_load;\n  generate\n    for (genvar i=0;i<5;i++) begin : g_cmp_a\n      for (genvar j=0;j<5;j++) begin : g_cmp_b\n        if (i < j) begin : g_unique\n          assign branch_eq[i][j] = branch_source[i] == branch_source[j];\n          assign branch_ult[i][j] = branch_source[i] < branch_source[j];\n        end else if (i > j) begin : g_reverse\n          assign branch_eq[i][j] = branch_eq[j][i];\n          assign branch_ult[i][j] = \"'!(branch_eq[j][i] || branch_ult[j][i]);\n        end else begin : g_identical\n          assign branch_eq[i][j] = 1'\"'b1;\n          assign branch_ult[i][j] = 1'b0;\n        end\n      end\n    end\n    for (genvar i=0;i<4;i++) begin : g_pair_a\n      for (genvar j=0;j<4;j++) begin : g_pair_b\n        localparam integer A = i == 0 ? 0 : i+1;\n        localparam integer B = j == 0 ? 1 : j+1;\n        wire choose_pair = fwd_rs1_sel[i] && fwd_rs2_sel[j];\n        wire slt = (branch_source[A][31] \"'^ branch_source[B][31])\n                 ? branch_source[A][31] : branch_ult[A][B];\n        assign eq_terms[4*i+j] = choose_pair && branch_eq[A][B];\n        assign ult_terms[4*i+j] = choose_pair && branch_ult[A][B];\n        assign slt_terms[4*i+j] = choose_pair && slt;\n      end\n    end\n  endgenerate\n  assign selected_eq = |eq_terms;\n  assign selected_ult = |ult_terms;\n  assign selected_slt = |slt_terms;\n\n  always_comb begin\n    case (in.ctrl.branch_op)\n      BR_BEQ:  branch_cond = selected_eq;\n      BR_BNE:  branch_cond = !selected_eq;\n      BR_BLT:  branch_cond = selected_slt;\n      BR_BGE:  branch_cond = !selected_slt;\n      BR_BLTU: branch_cond = selected_ult;\n      BR_BGEU: branch_cond = !selected_ult;\n      default: branch_cond = 1'\"'b0;\n    endcase\n'''\nassert old in s\np.write_text(s.replace(old,new))\nprint(root)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
