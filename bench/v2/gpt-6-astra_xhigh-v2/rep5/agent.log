{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/561ff4c6/8ba1bd50/r14_alu_sources')\nfor name,operands in [('base_b','b'),('base_ab','ab')]:\n root=base/name;shutil.copytree(base/'rtl',root/'rtl',dirs_exist_ok=True)\n p=root/'rtl/core_pkg.sv';s=p.read_text();needle='  // ID/EX register payload.\\\\n  typedef struct packed {';assert needle in s\n s=s.replace(needle,needle+''.join('\\\\n    logic [31:0] alu_base_'+v+';' for v in operands));p.write_text(s)\n p=root/'rtl/id_stage.sv';s=p.read_text();extra=''\n if 'a' in operands:extra+='      reg_q.alu_base_a <= dec_is_auipc ? in.pc : rs1_data;\\\\n'\n if 'b' in operands:extra+='      reg_q.alu_base_b <= dec_alu_src ? imm : rs2_data;\\\\n'\n s=s.replace('      reg_q.pc       <= in.pc;',extra+'      reg_q.pc       <= in.pc;');p.write_text(s)\n p=root/'rtl/ex_stage.sv';s=p.read_text()\n for v in 'ab':\n  begin=s.index('    alu_'+v+' =');end=s.index(';',begin)+1\n  if v in operands:\n   replacement='''    alu_V = ((in.alu_base_V & {32{alu_V_sel[0]}}) |\n             (fwd_ex_mem & {32{alu_V_sel[1]}})) |\n            ((fwd_wb_alu & {32{alu_V_sel[2]}}) |\n             (fwd_wb_load & {32{alu_V_sel[3]}}));'''.replace('V',v)\n  else:\n   original=Path('cores/bench/rtl/ex_stage.sv').read_text();ob=original.index('    alu_'+v+' =');oe=original.index(';',ob)+1;replacement=original[ob:oe]\n  s=s[:begin]+replacement+s[end:]\n p.write_text(s)\n p=root/'rtl/forward_unit.sv';s=p.read_text()\n for v in operands:\n  raw='next_raw1' if v=='a' else 'next_raw2';over='id_auipc' if v=='a' else 'id_alu_src'\n  s=s.replace('alu_'+v+'_sel <= '+over+\\\" ? 5'b10000 : {1'b0,\\\"+raw+'};','alu_'+v+'_sel <= '+over+\\\" ? 5'b00001 : {1'b0,\\\"+raw+'};')\n p.write_text(s)\nprint('Prepared early base-operand capture variants')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
