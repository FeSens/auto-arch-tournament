addr.value) == 16\n    assert int(dut.counters[0].value) == 1\n    # While fetch is held, independent advancing branch feedback still\n    # updates the *current* stored counter, saturating at each endpoint.\n    dut.imem_ready.value = 0\n    for outcome, expected in ((0, [0, 0, 0]), (1, [1, 2, 3, 3, 3])):\n        dut.branch_outcome.value = outcome\n        for count in expected:\n            await tick(dut)\n            assert int(dut.counters[0].value) == count\n            assert fields(dut)[2] == 0\n    # Reset overrides a concurrent write and correction.\n    dut.reset.value = 1\n    dut.redirect.value = 1\n    dut.redirect_target.value = 0x400\n    await tick(dut)\n    assert int(dut.imem_addr.value) == 0\n    assert [int(c.value) for c in dut.counters] == [1] * 64\n\n\n@cocotb.test()\nasync def full_target_range_raw_decode_and_priority(dut):\n    dut.reset.value = 1\n    dut.redirect.value = 0\n    dut.decode_accept.value = dut.imem_ready.value = 1\n    dut.redirect_target.value = 0\n    dut.imem_data.value = 0\n    dut.branch_train.value = 0\n    dut.branch_index.value = 0\n    dut.branch_outcome.value = 1\n    await tick(dut)\n    dut.reset.value = 0\n    # Train all entries, so only legality/alignment/range gates decide.\n    dut.imem_ready.value = 0\n    dut.branch_train.value = 1\n    for index in range(64):\n        dut.branch_index.value = index\n        await tick(dut)\n    dut.branch_train.value = 0\n    dut.imem_ready.value = 1\n    cases = [\n        (0, BEQ(0, 0, 16), True, 16),\n        (0, BEQ(0, 0, -4), False, 4),\n        (0xffffc, BEQ(0, 0, 4), False, 0x100000),\n        (0xffff0, JAL(1, 16), False, 0xffff4),\n        (0xffff0, JAL(1, -0x80000), True, 0x7fff0),\n        (0, JAL(1, -0x100000), False, 4),\n        (0, JAL(1, 2), False, 4),\n        (0, BEQ(0, 0, 2), False, 4),\n        (0x100000, JAL(1, -16), False, 0x100004),\n\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import