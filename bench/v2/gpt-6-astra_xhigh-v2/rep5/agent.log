{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nfrom collections import Counter\nM=(1<<32)-1\nW35=(1<<35)-1\nrng=random.Random(0x202610030014)\ncorners=[0,1,2,3,4,7,15,16,31,32,33,0x3fffffff,0x40000000,0x40000001,0x7fffffff,0x80000000,0x80000001,0xfffffffd,0xfffffffe,M]\npairs=set((a,b) for a in corners for b in corners)\nfor bit in range(32):\n for off in (-1,0,1):\n  d=((1<<bit)+off)&M\n  for k in (1,2,3,4,7,15,31,32,33):\n   for delta in (-1,0,1):\n    a=k*d+delta\n    if 0<=a<=M:\n     for sa in (-1,1):\n      for sb in (-1,1): pairs.add(((sa*a)&M,(sb*d)&M))\nfor i in range(40000):\n a=rng.getrandbits(32)\n b=rng.getrandbits((i%32)+1) if i%2 else rng.getrandbits(32)\n pairs.add((a,b))\ndigits=Counter()\nsteps=0\nfor a,b in sorted(pairs):\n for signed in (False,True):\n  A=(-a)&M if signed and a>>31 else a\n  D=(-b)&M if signed and b>>31 else b\n  d1=((A>>31)-(D&1))&3\n  bit1=int(D>>1==0 and d1>>1==0)\n  r1=(d1&1) if bit1 else A>>31\n  d2=(((r1<<1)|((A>>30)&1))-(D&3))&7\n  bit2=int(D>>2==0 and d2>>2==0)\n  R=(d2&3) if bit2 else ((r1<<1)|((A>>30)&1))\n  Q=((A<<2)|bit1<<1|bit2)&M\n  for cycle in range(6):\n   qr,rr=Q,R\n   for j in range(5):\n    diff=(((rr<<1)|(qr>>31))-D)&((1<<33)-1)\n    take=int(diff>>32==0)\n    rr=(diff if take else ((rr<<1)|(qr>>31)))&M\n    qr=((qr<<1)|take)&M\n   for j in range(2):\n    T=(R<<2)|(Q>>30)\n    diffs=[(T-k*D)&W35 for k in (1,2,3)]\n    fits=[(v>>34)==0 for v in diffs]\n    en=[not any(fits),fits[0] and not fits[1] and not fits[2],fits[1] and not fits[2],fits[2]]\n    assert sum(en)==1\n    digit=sum(i*int(v) for i,v in enumerate(en))\n    result=sum((v&M)*int(e) for v,e in zip([T]+diffs,en))\n    if D:\n     assert 0<=T-digit*D<D\n     assert result==T-digit*D\n    R=result\n    Q=((Q<<2)|digit)&M\n    digits[digit]+=1\n    steps+=1\n   T=(R<<1)|(Q>>31)\n   diff=(T-D)&((1<<33)-1)\n   bit=int(diff>>32==0)\n   R=(diff if bit else T)&M\n   Q=((Q<<1)|bit)&M\n   assert (Q,R)==(qr,rr), (a,b,signed,cycle)\n   if D: assert R<D\n  if b==0:\n   q_out,r_out=M,a\n  else:\n   q_out=(-Q)&M if signed and ((a\"'^b)>>31) else Q\n   r_out=(-R)&M if signed and a>>31 else R\n  ai=a-(1<<32) if signed and a>>31 else a\n  bi=b-(1<<32) if signed and b>>31 else b\n  if bi==0:\n   q_ref,r_ref=M,a\n  else:\n   q_ref=abs(ai)//abs(bi)\n   if (ai<0)!=(bi<0):q_ref=-q_ref\n   r_ref=ai-q_ref*bi\n   q_ref&=M\n   r_ref&=M\n  assert (q_out,r_out)==(q_ref,r_ref), (a,b,signed)\nprint('\"'operand_pairs',len(pairs))\nprint('RV32M_result_checks',len(pairs)*4)\nprint('radix4_steps',steps)\nprint('digit_coverage',dict(sorted(digits.items())))\nprint('PASS: exact-width mixed-radix model matches independent integer reference and existing recurrence at all six group boundaries')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
