r rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\nchecks-deep.cfg\nchecks.cfg\nchecks_si.cfg\nriscv-formal\nrun_all.sh\nwrapper.sv\nwrapper_si.sv\n/srv/hwebench/tmp/561ff4c6/0815ea6c\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n/srv/hwebench/toolchain/oss-cad-suite/bin/sby\n","exit_code":0,"status":"completed"}}
