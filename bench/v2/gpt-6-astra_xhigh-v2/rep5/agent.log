test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fa\n…[6841 of 9913 chars elided by tools/bench/transcript.py; sha256:5015aa2dbca4ab09]…\nlder memory operation holds EX.\n1081:async def queue_correction_discards_complete_tokens(dut):\n1089:                    # alias at PC 512 while the older load holds it in EX.\n1113:                assert all(not r[\"trap\"] for r in rets)\n1117:                        e[\"ex\"][0] == branch_pc and e[\"older_hold\"]]\n1122:async def queue_repeated_pc_and_training_preserve_tokens(dut):\n1145:async def queue_reset_cancels_each_occupancy(dut):\n1148:            # The leading divide cannot retire before reset. Everything in\n1151:                                       reset_at=count + 1, reset_occupancy=count)\n1155:async def mixed_m_dependencies_operands_and_latency(dut):\n1171:async def multiplication_memory_branch_and_wrong_path(dut):\n1190:    # real and ALTOPS builds; check immediate memory-address forwarding.\n1191:    altops = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n1199:async def multiplication_pipeline_arithmetic_and_reset(dut):\n1210:    for reset_at in range(1, 6):\n1212:                                   reset_at=reset_at)\n", "exit_code": 0, "status": "completed"}}
