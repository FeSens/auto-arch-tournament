{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json\nfrom tools.eval.fpga import run_coremark_ipc\nfrom tools.eval.cosim import run_one\nfrom concurrent.futures import ThreadPoolExecutor\np=Path('/srv/hwebench/tmp/561ff4c6/b3f3014f/r7_operand_bank')\nbinary=str(p/'obj_dir/cosim_sim')\nroot=str(Path.cwd())\nr=run_coremark_ipc(root,binary)\n(p/'coremark.json').write_text(json.dumps(r,indent=2))\nfitness=r['iter_per_cycle']*64.003e6\nprint('CoreMark',json.dumps(r),'fitness',fitness,'delta',100*(fitness/142.52-1),flush=True)\nwith ThreadPoolExecutor(max_workers=4) as ex:\n jobs=[ex.submit(run_one,elf.resolve(),binary,root,sim_flags=flags) for elf in Path('bench/programs').glob('*.elf') if elf.name\"'!='\"'coremark.elf' for flags in [(),('--istall','--dstall')]]\n results=[f.result() for f in jobs]\n(p/'cosim.json').write_text(json.dumps(results,indent=2))\nprint('Cosim',json.dumps(results))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
