{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -c \"cat >> /srv/hwebench/tmp/561ff4c6/b3f3014f/r7_operand_bank/test/test_reg_file.py <<'PY'\n\n@cocotb.test()\nasync def all_pairs_random_writes_and_populated_reset(dut):\n    import random\n    rng = random.Random(7002)\n    model = [0] * 32\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.w_en.value = 0\n    dut.w_addr.value = 0\n    dut.w_data.value = 0\n    dut.rs1_addr.value = 0\n    dut.rs2_addr.value = 0\n    await Timer(2, 'ns')\n    dut.clock.value = 1\n    await Timer(2, 'ns')\n    dut.clock.value = 0\n    dut.reset.value = 0\n    for addr in range(32):\n        val = rng.getrandbits(32)\n        dut.w_en.value = 1\n        dut.w_addr.value = addr\n        dut.w_data.value = val\n        await Timer(2, 'ns')\n        dut.clock.value = 1\n        if addr:\n            model[addr] = val\n        await Timer(2, 'ns')\n        dut.clock.value = 0\n    dut.w_en.value = 0\n    for a in range(32):\n        for b in range(32):\n            dut.rs1_addr.value = a\n            dut.rs2_addr.value = b\n            await Timer(1, 'ns')\n            assert int(dut.rs1_data.value) == model[a]\n            assert int(dut.rs2_data.value) == model[b]\n    for step in range(2048):\n        a, b, w = (rng.randrange(32) for _ in range(3))\n        if step % 4 == 0:\n            a = b = w\n        val, en = rng.getrandbits(32), rng.randrange(2)\n        dut.rs1_addr.value = a\n        dut.rs2_addr.value = b\n        dut.w_en.value = en\n        dut.w_addr.value = w\n        dut.w_data.value = val\n        await Timer(2, 'ns')\n        def expected(addr):\n            return 0 if addr == 0 else val if en and addr == w else model[addr]\n        assert int(dut.rs1_data.value) == expected(a)\n        assert int(dut.rs2_data.value) == expected(b)\n        dut.clock.value = 1\n        if en and w:\n            model[w] = val\n        await Timer(2, 'ns')\n        dut.clock.value = 0\n    dut.w_en.value = 0\n    dut.reset.value = 1\n    await Timer(2, 'ns')\n    dut.clock.value = 1\n    await Timer(2, 'ns')\n    dut.clock.value = 0\n    dut.reset.value = 0\n    for addr in range(32):\n        dut.rs1_addr.value = addr\n        dut.rs2_addr.value = 31 - addr\n        await Timer(1, 'ns')\n        assert int(dut.rs1_data.value) == 0\n        assert int(dut.rs2_data.value) == 0\nPY\npython -m pytest --rootdir=. -q test/test_reg_file.py > pytest_rf_extended.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
