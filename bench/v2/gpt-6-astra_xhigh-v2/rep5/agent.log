{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"cat > /srv/hwebench/tmp/561ff4c6/10efe6cb/profile_predictor.py <<'PY'\nimport subprocess,json,struct,collections\nbase='/srv/hwebench/tmp/561ff4c6/10efe6cb/'\np=subprocess.Popen([base+'predictor_profile/cosim_sim','/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep5/bench/programs/coremark.elf','10000000','--istall','--dstall'],stdout=subprocess.PIPE,text=True)\nactive=False; start=stop=0; ops=collections.Counter(); sites=collections.Counter(); branches=[]; jumps=collections.Counter(); n=0\nfor line in p.stdout:\n if not line.startswith('{'): continue\n r=json.loads(line)\n if r.get('mem_wmask') and r.get('mem_addr')==0x10000100: active=True; start=r['cycle']\n if r.get('mem_wmask') and r.get('mem_addr')==0x10000104: active=False; stop=r['cycle']\n ins=r.get('insn',0); pc=r.get('pc_rdata',0)\n if ins&127==99:\n  taken=int(r['pc_wdata']\"'!=pc+4)\n  branches.append((pc,taken,active))\n if active:\n  n+=1; ops[ins&127]+=1\n  if ins&127==99: sites[pc]+=1\n  if ins&127==103: jumps[(pc,ins)]+=1\np.wait()\nwith open(base+'\"'branch_trace.bin','wb') as f:\n for r in branches: f.write(struct.pack('<IBB',*r))\nprint(json.dumps(dict(rc=p.returncode,start=start,stop=stop,cycles=stop-start,insns=n,ops=ops,branch_sites=len(sites),hot_sites=sites.most_common(25),jalr=jumps.most_common(20)),indent=2))\nPY\npython /srv/hwebench/tmp/561ff4c6/10efe6cb/profile_predictor.py > /srv/hwebench/tmp/561ff4c6/10efe6cb/profile_summary.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
