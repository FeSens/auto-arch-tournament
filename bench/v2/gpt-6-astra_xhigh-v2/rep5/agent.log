{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\np=Path('/srv/hwebench/tmp/561ff4c6/b3f3014f/r7_operand')\nshutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\nshutil.copytree('cores/bench/test',p/'test',dirs_exist_ok=True)\nf=p/'rtl/core.sv'\ns=f.read_text().replace('logic [1:0] fwd_rs1_sel, fwd_rs2_sel;', 'logic [2:0] fwd_rs1_sel, fwd_rs2_sel;')\ns=s.replace('    .id_ex_rs1   (id_ex_w.rs1_addr),\\\\n    .id_ex_rs2   (id_ex_w.rs2_addr),', '''    .clock       (clock),\n    .reset       (reset),\n    .stall_id    (stall_id),\n    .flush_id    (flush_id),\n    .stall_ex_mem(stall_ex_mem),\n    .if_id_rs1   (if_id_w.instr[19:15]),\n    .if_id_rs2   (if_id_w.instr[24:20]),\n    .id_ex_rd    (id_ex_w.rd),''')\nf.write_text(s)\nf=p/'rtl/ex_stage.sv'\ns=f.read_text().replace('logic [1:0]         fwd_rs1_sel','logic [2:0]         fwd_rs1_sel').replace('logic [1:0]         fwd_rs2_sel','logic [2:0]         fwd_rs2_sel')\na=s.index('  always_comb begin\\\\n    case (fwd_rs1_sel)')\nb=s.index('  logic [31:0] alu_result;',a)\ns=s[:a]+'''  assign rs1 = (in.rs1_val & {32{fwd_rs1_sel[0]}}) |\n               (fwd_ex_mem & {32{fwd_rs1_sel[1]}}) |\n               (fwd_mem_wb & {32{fwd_rs1_sel[2]}});\n  assign rs2 = (in.rs2_val & {32{fwd_rs2_sel[0]}}) |\n               (fwd_ex_mem & {32{fwd_rs2_sel[1]}}) |\n               (fwd_mem_wb & {32{fwd_rs2_sel[2]}});\n\n  logic [31:0] alu_a, alu_b;\n  assign alu_a = (in.pc & {32{in.ctrl.is_auipc}}) |\n                (in.rs1_val & {32{fwd_rs1_sel[0] && \"'!in.ctrl.is_auipc}}) |\n                (fwd_ex_mem & {32{fwd_rs1_sel[1] && !in.ctrl.is_auipc}}) |\n                (fwd_mem_wb & {32{fwd_rs1_sel[2] && !in.ctrl.is_auipc}});\n  assign alu_b = (in.imm & {32{in.ctrl.alu_src}}) |\n                (in.rs2_val & {32{fwd_rs2_sel[0] && !in.ctrl.alu_src}}) |\n                (fwd_ex_mem & {32{fwd_rs2_sel[1] && !in.ctrl.alu_src}}) |\n                (fwd_mem_wb & {32{fwd_rs2_sel[2] && !in.ctrl.alu_src}});\n\n'\"'''+s[b:]\nf.write_text(s)\n(p/'rtl/forward_unit.sv').write_text('''module forward_unit (\n  input logic clock, reset, stall_id, flush_id, stall_ex_mem,\n  input logic [4:0] if_id_rs1, if_id_rs2, id_ex_rd, ex_mem_rd,\n  input logic ex_mem_w_en, mem_wb_w_en,\n  input logic [4:0] mem_wb_rd,\n  output logic [2:0] fwd_rs1, fwd_rs2\n);\n  logic ex1_q, ex2_q, wb1_q, wb2_q;\n  always_ff @(posedge clock) begin\n    if (reset || flush_id) begin\n      ex1_q <= 0; ex2_q <= 0; wb1_q <= 0; wb2_q <= 0;\n    end else if (\"'!stall_id) begin\n      ex1_q <= if_id_rs1 == id_ex_rd && id_ex_rd != 0;\n      ex2_q <= if_id_rs2 == id_ex_rd && id_ex_rd != 0;\n      wb1_q <= if_id_rs1 == ex_mem_rd && ex_mem_rd != 0;\n      wb2_q <= if_id_rs2 == ex_mem_rd && ex_mem_rd != 0;\n    end else if (!stall_ex_mem) begin\n      wb1_q <= ex1_q; wb2_q <= ex2_q;\n      ex1_q <= 0; ex2_q <= 0;\n    end\n  end\n  always_comb begin\n    fwd_rs1[1] = ex1_q && ex_mem_w_en;\n    fwd_rs2[1] = ex2_q && ex_mem_w_en;\n    fwd_rs1[2] = wb1_q && mem_wb_w_en && !fwd_rs1[1];\n    fwd_rs2[2] = wb2_q && mem_wb_w_en && !fwd_rs2[1];\n    fwd_rs1[0] = !(fwd_rs1[1] || fwd_rs1[2]);\n    fwd_rs2[0] = !(fwd_rs2[1] || fwd_rs2[2]);\n  end\nendmodule\n'\"''')\nprint(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
