{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,220p' cores/bench/test/test_div_unit.py\"", "aggregated_output": "\"\"\"Exercise the actual sequential divider, with exact integer references.\"\"\"\nimport os\nimport random\n\nimport cocotb\nimport pytest\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD, ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU\n\nMASK = 0xffffffff\nOPS = (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU)\nALTOPS = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n\n\ndef reference(op, a, b, altops=ALTOPS):\n    a, b = a & MASK, b & MASK\n    if altops:\n        return ((a - b) ^ dict(zip(OPS, (\n            0x7f8529ec, 0x10e8fd70, 0x8da68fa5, 0x3138d0e1)))[op]) & MASK\n    if b == 0:\n        return a if op in (ALU_REM, ALU_REMU) else MASK\n    if op in (ALU_DIV, ALU_REM):\n        a = a - (1 << 32) if a >> 31 else a\n        b = b - (1 << 32) if b >> 31 else b\n        q = abs(a) // abs(b)\n        if (a < 0) != (b < 0):\n            q = -q\n    else:\n        q = a // b\n    return (a - q * b if op in (ALU_REM, ALU_REMU) else q) & MASK\n\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, unit=\"ns\")\n    dut.clock.value = 1\n    await Timer(5, unit=\"ns\")\n\n\nasync def reset(dut):\n    dut.reset.value = 1\n    dut.start.value = 0\n    dut.result_accept.value = 0\n    dut.op.value = ALU_DIV\n    dut.a.value = 0\n    dut.b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    assert not int(dut.busy.value)\n    assert not int(dut.result_valid.value)\n\n\nasync def operation(dut, op, a, b, hold=0):\n    assert not int(dut.busy.value)\n    dut.op.value, dut.a.value, dut.b.value = op, a & MASK, b & MASK\n    dut.start.value = 1\n    await tick(dut)  # capture, magnitudes and two bits, service edge 1\n    assert int(dut.busy.value) and not int(dut.result_valid.value)\n    dut.start.value = 0\n    # Live operands and operation may change while the captured work runs.\n    dut.a.value, dut.b.value, dut.op.value = 0x13579bdf, 0, ALU_REMU\n    for edge in range(2, 8):\n        # Neither busy starts nor premature accepts may disturb a group.\n        dut.start.value = edge % 2\n        dut.result_accept.value = int(\n…[4888 of 7960 chars elided by tools/bench/transcript.py; sha256:5dfa639285264bee]…\n.b.value = ALU_DIV, 0x80000000, 3\n        await tick(dut)\n        dut.start.value = 0\n        for _ in range(phase - 1):\n            await tick(dut)\n        await reset(dut)\n        for _ in range(9):\n            await tick(dut)\n            assert not int(dut.busy.value) and not int(dut.result_valid.value)\n        await operation(dut, ALU_REM, -123, 7)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_div_unit_runner(altops):\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / (\"div_unit_altops\" if altops else \"div_unit\")\n    runner.build(sources=[RTL / \"core_pkg.sv\", RTL / \"div_unit.sv\"],\n                 hdl_toplevel=\"div_unit\", build_dir=build_dir, always=True,\n                 build_args=[\"-Wall\", \"-Wno-UNUSEDPARAM\"] +\n                            ([\"+define+RISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"div_unit\", test_module=\"test_div_unit\",\n                test_dir=TEST_DIR, build_dir=build_dir,\n                extra_env={\"DIV_ALTOPS\": str(int(altops))})\n", "exit_code": 0, "status": "completed"}}
