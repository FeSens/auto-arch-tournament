{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"sed -n '360,395p' cores/bench/test/test_pipeline.py\"","aggregated_output":"\n\ndef _signed(value, bits=32):\n    return value - (1 << bits) if value & (1 << (bits - 1)) else value\n\n\nasync def _checked_div_program(dut, program, stalled=False, reset_at=None,\n                               imem_stalls=(), dmem_stalls=(), reset_occupancy=None):\n    \"\"\"Edge-accurate buses plus an independent retirement/memory scoreboard.\"\"\"\n    mask = 0xffffffff\n    altops = os.environ.get(\"DIV_ALTOPS\") == \"1\"\n    rng = random.Random(0x5a11)\n    regs = [0] * 32\n    initial_mem = {0x100: 400, 0x104: 7, 0x108: 0x80000000}\n    mem, refmem = dict(initial_mem), dict(initial_mem)\n    rets, accepted, expected_accesses = [], [], []\n    expected_pc = 0\n    held_request = None\n    request_stalls = 0\n    dut.reset.value = 1\n    dut.io_imemReady.value = dut.io_dmemReady.value = 1\n    dut.io_imemData.value = NOP()\n    dut.io_dmemRData.value = 0\n    await tick(dut)\n    await tick(dut)\n    dut.reset.value = 0\n    for cycle in range(5000):\n        dut.clock.value = 0\n        if cycle == reset_at:\n            if reset_occupancy is not None:\n                assert int(dut.u_if.occupancy.value) == reset_occupancy\n            dut.reset.value = 1\n            await tick(dut)\n            assert int(dut.u_if.occupancy.value) == 0\n            assert int(dut.io_imemAddr.value) == 0\n            assert int(dut.id_ex_w.value) == 0\n","exit_code":0,"status":"completed"}}
