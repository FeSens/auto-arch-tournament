{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/561ff4c6/af02a057/r10s0')\nfor name,both in [('cmp16',False),('cmp16both',True)]:\n p=base/name\n shutil.copytree('cores/bench/rtl',p/'rtl',dirs_exist_ok=True)\n shutil.copytree('cores/bench/test',p/'test',dirs_exist_ok=True)\n s=(p/'rtl/ex_stage.sv').read_text()\n a=s.index('  // ── Branch resolve')\n s=s[:a]+'''  logic cmp_eq, cmp_lt, cmp_ltu;\n  logic cmp_eq_hi, cmp_eq_lo, cmp_lt_hi, cmp_lt_lo;\n  assign cmp_eq_hi = rs1[31:16] == rs2[31:16];\n  assign cmp_eq_lo = rs1[15:0] == rs2[15:0];\n  assign cmp_lt_hi = rs1[31:16] < rs2[31:16];\n  assign cmp_lt_lo = rs1[15:0] < rs2[15:0];\n  assign cmp_eq = cmp_eq_hi && cmp_eq_lo;\n  assign cmp_ltu = cmp_lt_hi || (cmp_eq_hi && cmp_lt_lo);\n  assign cmp_lt = (rs1[31] \"'^ rs2[31]) ? rs1[31] : cmp_ltu;\n\n'\"''' + s[a:]\n s=s.replace('(rs1 == rs2)','cmp_eq').replace('(rs1 \"'!= rs2)'\"','\"'!cmp_eq'\"').replace('(\"'$signed(rs1) <  $signed(rs2))'\"','cmp_lt').replace('(\"'$signed(rs1) >= $signed(rs2))'\"','\"'!cmp_lt'\"').replace('(rs1 <  rs2)','cmp_ltu').replace('(rs1 >= rs2)','\"'!cmp_ltu'\"')\n (p/'rtl/ex_stage.sv').write_text(s)\n if both:\n  s=(p/'rtl/alu.sv').read_text()\n  a=s.index('  logic        [4:0]  shamt;')\n  s=s[:a]+'''  logic cmp_ltu, cmp_lt;\n  assign cmp_ltu = (a[31:16] < b[31:16]) ||\n                   ((a[31:16] == b[31:16]) && (a[15:0] < b[15:0]));\n  assign cmp_lt = (a[31] \"'^ b[31]) ? a[31] : cmp_ltu;\n\n'\"''' +s[a:]\n  s=s.replace(\\\"{31'b0, \"'$signed(a) < $signed(b)}\",\"{31'\"'b0, cmp_lt}\\\").replace(\\\"{31'b0, a < b}\\\",\\\"{31'b0, cmp_ltu}\\\")\n  (p/'rtl/alu.sv').write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
