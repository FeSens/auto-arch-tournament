ce_replay(dut, program)\n    assert [r[\"pc_rdata\"] for r in rets] == [0, 4, 8, 16, 20]\n    assert [e[\"pc\"] for e in events if e[\"replay\"]] == [8]\n\n\n@cocotb.test()\nasync def replay_full_queue_and_reset(dut):\n    # Hold the canceling producer behind an older store. Once the store\n    # drains, the queued dependent DIV enters EX and must replay before\n    # launching, with a second token already waiting behind it.\n    program = [ADDI(7, 0, 0x140), SW(7, 0, 0x108), JALR(7, 0, 2),\n               DIV(8, 7, 7), SW(8, 0, 0x10c), MUL(9, 8, 7), EBREAK()]\n    rets, events = await _checked_source_replay(dut, program,\n                                               dmem_stalls=range(3, 10))\n    assert any(e[\"held\"] and e[\"occupancy\"] == 2 for e in events)\n    [replay] = [e for e in events if e[\"replay\"]]\n    assert replay[\"occupancy\"] > 0\n    assert len(rets) == len(program)\n    for cycle in (4, 8, replay[\"cycle\"], replay[\"cycle\"] + 2):\n        await _checked_source_replay(dut, program, dmem_stalls=range(3, 10),\n                                     reset_at=cycle)\n","exit_code":0,"status":"completed"}}
