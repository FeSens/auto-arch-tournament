,\"expected_impact\",\"changes\"],\n  \"properties\": {\n    \"id\":       {\"type\": \"string\", \"pattern\": \"^hyp-[0-9]{8}-[0-9]{3}(-r[0-9]+s[0-9]+)?$\"},\n    \"title\":    {\"type\": \"string\", \"minLength\": 5},\n    \"category\": {\"type\": \"string\", \"enum\": [\"micro_opt\",\"structural\",\"extension\",\"predictor\",\"memory\"]},\n    \"motivation\":  {\"type\": \"string\", \"minLength\": 20},\n  \n…[101560 of 104632 chars elided by tools/bench/transcript.py; sha256:2985b09a76a41248]…\nline\": 844.31, \"fmax_mhz\": 48.089, \"ipc_coremark\": 2e-06, \"cycles\": 4201740, \"iterations\": 10, \"lut4\": 3290, \"ff\": 755, \"seeds\": [48.028, 48.089, 48.089], \"perturbations\": [[0, 48.028, 32], [1, 48.089, 31], [2, 48.089, 31]], \"lutram\": 8, \"bsram\": 6, \"dsp\": 6, \"critical_path\": {\"from\": \"cpu/u_ex/u_div/quotient_31_s1\", \"to\": \"cpu/u_ex/u_div/remainder_1_s1\", \"slack_ns\": -15.821, \"arrival_ns\": 26.115, \"logic_cells\": 163, \"modules\": [\"clock_ibuf\", \"cpu/u_ex/u_div\"]}, \"logic_levels\": 32, \"formal_passed\": true, \"cosim_passed\": true, \"error\": null, \"implementation_notes\": \"\", \"timestamp\": \"2026-10-03T05:10:44.909056Z\", \"slot\": 2, \"round_id\": 3, \"lesson\": \"- 2026-10-03 hyp-20261003-003-r3s2 (improvement, +11.19%): Deriving direct targets from the fetched instruction enables direction-only recovery with one predicted_taken bit, while raw-instruction decode with valid/ID/EX squashes removes the redirect-to-decode instruction-mask path, letting bimodal prediction improve CoreMark fitness alongside the retimed divider.\"}\n", "exit_code": 0, "status": "completed"}}
