al\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n    subprocess.run([\"yosys\", \"-Q\", \"-T\", \"-p\", script], check=True,\n                   capture_output=True, text=True)\n\n\ndef _transfer(insn, pc, a=0, b=0):\n    \"\"\"Independent archit\n…[22334 of 25406 chars elided by tools/bench/transcript.py; sha256:badaaa7769c449a1]…\nmem_stalls=range(start, start + 5),\n        imem_stalls=range(start + 2, start + 8))\n    assert [r[\"pc_rdata\"] for r in rets] == [0, 264, 280, 4] + [8] * 8\n    training = [e for e in events if e[\"train\"] and e[\"ex\"][0] == 8]\n    assert training[0][\"occupancy\"] == 2 and training[0][\"count\"] == 2\n    assert training[1][\"occupancy\"] == 1 and training[1][\"count\"] == 3\n    assert all(e[\"head\"] == (8, BEQ(0, 0, 0), True) for e in training[:2])\n    assert all(not e[\"iready\"] and e[\"consumed\"] for e in training[:2])\n    assert counters[2] == 3\n    assert sum(e[\"correction\"] for e in events) == 1  # only the cold warmup\n\n\n@cocotb.test()\nasync def queue_reset_cancels_each_occupancy(dut):\n    for count in (0, 1, 2):\n        for poison in (SW(0, 0, 0x710), DIV(20, 0, 0), MUL(21, 0, 0), 0xffffffff):\n            # The leading divide cannot retire before reset. Everything in\n            # either queue slot belongs to the cancelled retirement epoch.\n            await _checked_div_program(dut, [DIV(1, 0, 0), poison, poison],\n", "exit_code": 0, "status": "completed"}}
