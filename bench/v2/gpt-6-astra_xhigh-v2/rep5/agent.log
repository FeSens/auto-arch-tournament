{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nMASK=(1<<32)-1; MASK64=(1<<64)-1\nrng=random.Random(0x525331)\nboundary=[0,1,2,3,15,16,31,32,63,64,127,255,65535,65536,0x7fffffff,0x80000000,0x80000001,0xfffffffe,0xffffffff]\npairs=[(a,b) for a in boundary for b in boundary]+[(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(16000)]\ndef signed(a): return a-(1<<32) if a>>31 else a\ndef mul(a,b,sa,sb):\n ah=(a>>16)-(65536 if sa and a>>31 else 0); bh=(b>>16)-(65536 if sb and b>>31 else 0)\n al=a&65535; bl=b&65535\n ts=[al*bl,al*bh<<16,ah*bl<<16,ah*bh<<32]\n ts=[t&MASK64 for t in ts]\n s=ts[0]\"'^ts[1]''^ts[2]; c=((ts[0]&ts[1])|(ts[0]&ts[2])|(ts[1]&ts[2]))<<1&MASK64\n s2=s''^c''^ts[3]; c2=((s&c)|(s&ts[3])|(c&ts[3]))<<1&MASK64\n return (s2+c2)&MASK64\ndef step(r,q,d):\n trial=(r<<1)|(q>>31); bit=int(trial>=d)\n return (trial-d if bit else trial),((q<<1)|bit)&MASK\ndef div(a,b,sgn,rem):\n aa=signed(a) if sgn else a; bb=signed(b) if sgn else b\n ma=abs(aa); mb=abs(bb); q=ma; r=0\n for w in range(1,7):\n  trial=(r<<1)|(q>>31)\n  bit=int(mb>>w==0 and trial >= (mb&((1<<w)-1)))\n  r=trial-(mb&((1<<w)-1)) if bit else trial\n  q=((q<<1)|bit)&MASK\n for group in range(6):\n  for _ in range(4): r,q=step(r,q,mb)\n for _ in range(2): r,q=step(r,q,mb)\n if b==0: return a if rem else MASK\n x=r if rem else q\n if (aa<0 if rem else (aa<0) != (bb<0)): x=-x\n return x&MASK\nfor a,b in pairs:\n for sa,sb in [(False,False),(True,True),(True,False)]:\n  aa=signed(a) if sa else a; bb=signed(b) if sb else b\n  assert mul(a,b,sa,sb)==aa*bb&MASK64,(a,b,sa,sb)\n for sgn in [False,True]:\n  aa=signed(a) if sgn else a; bb=signed(b) if sgn else b\n  refq=abs(aa)//abs(bb) if b else -1\n  if b and ((aa<0)!=(bb<0)): refq=-refq\n  refr=aa-refq*bb if b else aa\n  assert div(a,b,sgn,False)==refq&MASK,(a,b,sgn,'\"'q')\n  assert div(a,b,sgn,True)==refr&MASK,(a,b,sgn,'r')\nprint('PASS:',len(pairs)*3,'signedness/product cases;',len(pairs)*4,'6+6*4+2 division/remainder cases')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
