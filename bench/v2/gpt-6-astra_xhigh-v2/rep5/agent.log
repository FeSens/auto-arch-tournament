g.sv\" ] && RTL_FILES+=(\"$RTL_DIR/core_pkg.sv\")\nfor f in \"$RTL_DIR\"/*.sv; do\n  [ \"$(basename \"$f\")\" = \"core_pkg.sv\" ] && continue\n  RTL_FILES+=(\"$f\")\ndone\n\nif [ ${#RTL_FILES[@]} -eq 0 ]; then\n  echo \"ERROR: no rtl/*.sv files found.\" >&2\n  exit 1\nfi\n\nverilator --cc --exe --build \\\n  -Mdir \"$OBJ_DIR\" \\\n  \"+incdir+$RTL_DIR\" \\\n  --top-module core \\\n  -Wall -Wno-fatal -Wno-style \\\n  -CFLAGS \"-DN\n…[4687 of 7759 chars elided by tools/bench/transcript.py; sha256:db56de3d8cff1e01]…\n char** argv) {\n62:    if(argc < 2) {\n63:        std::cerr << \"usage: sim <elf> [maxcycles] [--bench] [--istall] [--dstall] [--seed N]\\n\";\n66:    uint64_t maxcycles = argc > 2 ? atoll(argv[2]) : 50000000ULL;\n68:    // --istall: random ~22% imem-bus backpressure (VexRiscv-style).\n69:    // --dstall: same on dmem bus. The orchestrator's fitness eval\n74:    bool istall = false;\n75:    bool dstall = false;\n76:    for (int i = 1; i < argc; i++) {\n77:        if      (std::strcmp(argv[i], \"--bench\")  == 0) bench_mode = true;\n78:        else if (std::strcmp(argv[i], \"--istall\") == 0) istall     = true;\n79:        else if (std::strcmp(argv[i], \"--dstall\") == 0) dstall     = true;\n80:        else if (std::strcmp(argv[i], \"--seed\")   == 0 && i + 1 < argc)\n81:            lfsr_state_main = (uint32_t)atoll(argv[++i]);\n84:    ELF elf; elf.load(argv[1]);\n97:    Verilated::commandArgs(argc, argv);\n119:        top->io_imemReady = istall ? bus_accepts_main() : 1;\n120:        top->io_dmemReady = dstall ? bus_accepts_main() : 1;\n", "exit_code": 0, "status": "completed"}}
