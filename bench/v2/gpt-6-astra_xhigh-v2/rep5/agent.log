h Yosys.\nMakefile:137:fpga: cosim-build bench/programs/coremark.elf\nMakefile:141:\tpython3 -m tools.eval.gowin $(TARGET)\nMakefile:178:\trm -rf test/cosim/sim_build sim_build out\nMakefile:187:\trm -rf cores/$(TARGET)/sim_build\n","exit_code":0,"status":"completed"}}
