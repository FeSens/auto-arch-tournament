{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,json,collections,time\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\nc=RV32IM(); c.load_elf('/srv/hwebench/tmp/561ff4c6/58f795ad/predictor-coremark.elf')\nmodels={(n,kind):{} for n in (64,128,256,0) for kind in ('last','stride')}\ncounts=collections.Counter(); scores=collections.defaultdict(collections.Counter); pcs=collections.defaultdict(collections.Counter); rows=[]\nactive=False; prev=None; t=time.time()\nfor i in range(10000000):\n r=c.step(); op=r['insn']&127\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n if r['mem_wmask'] and r['mem_addr']==0x10000104: active=False\n if active:\n  counts['insns']+=1\n  if op==3: counts['loads']+=1\n  if prev and prev['op']==3 and prev['rd']:\n   rs1=(r['insn']>>15)&31; rs2=(r['insn']>>20)&31\n   use1=op in (3,0x13,0x23,0x33,0x63,0x67)\n   use2=op in (0x23,0x33,0x63)\n   dep=(use1 and prev['rd']==rs1) or (use2 and prev['rd']==rs2)\n   if dep:\n    counts['load_use']+=1; counts[f'use_{op:02x}']+=1\n    pcs[prev['pc']]['uses']+=1\n    rows.append((prev['pc'],prev['value'],op))\n    for key,(pred,conf) in prev['preds'].items():\n     s=scores[key]\n     s['all_correct']+=pred==prev['value']\n     if conf>=3:\n      s['conf_attempts']+=1; s['conf_correct']+=pred==prev['value']\n      s[f'conf_attempts_{op:02x}']+=1;s[f'conf_correct_{op:02x}']+=pred==prev['value']\n  if op==3 and r['rd']:\n   preds={}\n   for key,table in models.items():\n    n,kind=key; idx=(r['pc']>>2)%n if n else r['pc']\n    old=table.get(idx); match=old is not None and old[0]==r['pc']\n    pred=(old[1]+(old[2] if kind=='stride' else 0))&0xffffffff if match else None\n    conf=old[3] if match else 0\n    preds[key]=(pred,conf)\n    newconf=min(3,conf+1) if pred==r['rd_wdata'] else 0\n    table[idx]=(r['pc'],r['rd_wdata'],(r['rd_wdata']-old[1])&0xffffffff if match else 0,newconf)\n   prev=dict(op=op,rd