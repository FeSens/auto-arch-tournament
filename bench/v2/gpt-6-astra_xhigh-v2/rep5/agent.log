{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport array,collections,time\nv=array.array('I'); v.frombytes(open('/srv/hwebench/tmp/561ff4c6/3e1839b9/predictor/branches.bin','rb').read())\ntrace=[(x&0xfffff,(x>>30)&1,x>>31) for x in v]\nresults=[]\nfor bits in [6,7,8,9,10,12]:\n t=[1]*(1<<bits); mask=len(t)-1; misses=0; per=collections.Counter()\n for pc,a,roi in trace:\n  i=(pc>>2)&mask; wrong=(t[i]>>1)\"'!=a\n  if roi: misses+=wrong; per[pc]+=wrong\n  t[i]=min(3,t[i]+1) if a else max(0,t[i]-1)\n results.append(('\"'bimodal',bits,misses))\n if bits==6:\n  base=misses; print('bimodal64 hot misses',[(hex(p),n) for p,n in per.most_common(20)],flush=True)\nfor kind in ['global','local']:\n for hb in [4,6,8,10]:\n  for tb in [8,10,12]:\n   t=[1]*(1<<tb); h=[0]*64; g=0; misses=0; mask=len(t)-1; hm=(1<<hb)-1\n   for pc,a,roi in trace:\n    hi=(pc>>2)&63; hist=h[hi] if kind=='local' else g\n    i=((pc>>2)\"'^hist)&mask; wrong=(t[i]>>1)!=a\n    if roi: misses+=wrong\n    t[i]=min(3,t[i]+1) if a else max(0,t[i]-1)\n    if kind=='\"'local': h[hi]=((hist<<1)|a)&hm\n    else: g=((g<<1)|a)&hm\n   results.append((kind,hb,tb,misses))\nfor r in sorted(results,key=lambda r:r[-1]): print(r,'savings',base-r[-1],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
