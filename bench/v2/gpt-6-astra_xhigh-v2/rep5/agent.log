{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random,json\nfrom pathlib import Path\nMASK=(1<<32)-1\nrng=random.Random(0x84d171de)\nseen8=set(); seen4=set(); groups=0\n\ndef digit(q,r,d,bits):\n width=32+bits\n t=(r<<bits)|(q>>(32-bits))\n fits=[True]\n diffs=[t]\n for k in range(1,1<<bits):\n  diff=(t-k*d)&((1<<(width+1))-1)\n  fits.append(not (diff>>width)); diffs.append(diff)\n enables=[fits[k] and (k==(1<<bits)-1 or not fits[k+1]) for k in range(1<<bits)]\n assert sum(enables)==1\n k=enables.index(True)\n newr=diffs[k]&MASK\n if d: assert newr<d\n return ((q<<bits)|k)&MASK,newr,k\n\ndef pair(a,d):\n global groups\n q=a; r=0\n for _ in range(2):\n  q,r,_=digit(q,r,d,1)\n rq,rr=q,r\n for _ in range(6):\n  q,r,k=digit(q,r,d,3);seen8.add(k)\n  q,r,k=digit(q,r,d,2);seen4.add(k)\n  for _ in range(5):rq,rr,_=digit(rq,rr,d,1)\n  assert (q,r)==(rq,rr),(a,d,q,r,rq,rr)\n  groups+=1\n if d: assert (q,r)==divmod(a,d)\n else: assert q==MASK and r==a\n return q,r\n\ncorners=[0,1,2,3,4,7,8,15,16,31,32,63,64,255,256,0x1fffffff,0x20000000,0x3fffffff,0x40000000,0x55555555,0x7fffffff,0x80000000,0x80000001,0xffffffff]\npairs={(a,b) for a in corners for b in corners}\nfor b in corners:\n for k in range(1,9):\n  for shift in (0,5,10,15,20,25):\n   for delta in (-1,0,1):\n    a=(k*b<<shift)+delta\n    if 0<=a<=MASK:pairs.add((a,b))\nfor _ in range(15000):\n pairs.add((rng.getrandbits(32),rng.getrandbits(rng.randrange(1,33))))\nresults=0\nfor a,b in sorted(pairs):\n qu,ru=pair(a,b)\n assert qu==(MASK if b==0 else a//b)\n assert ru==(a if b==0 else a%b)\n sa=a-(1<<32) if a>>31 else a\n sb=b-(1<<32) if b>>31 else b\n qm,rm=pair(abs(sa),abs(sb))\n qs=(-qm if (sa<0)\"'!=(sb<0) else qm)&MASK\n rs=(-rm if sa<0 else rm)&MASK\n if sb==0: qs=MASK;rs=a\n refq=0 if sb==0 else abs(sa)//abs(sb)\n if (sa<0)!=(sb<0):refq=-refq\n assert qs==(MASK if sb==0 else refq&MASK)\n assert rs==((sa if sb==0 else sa-refq*sb)&MASK)\n results+=4\nout=dict(operand_pairs=len(pairs),rv32m_results=results,matching_group_boundaries=groups,radix8_digits=sorted(seen8),radix4_digits=sorted(seen4))\nPath('\"'/srv/hwebench/tmp/561ff4c6/b6eb4e55/r5s0-radix84/model_results.json').write_text(json.dumps(out,indent=2))\nprint(json.dumps(out))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
