{"type": "item.completed", "item": {"id": "item_13", "type": "command_execution", "command": "/bin/bash -c \"sed -n '550,630p' cores/bench/test/test_pipeline.py\"", "aggregated_output": "    await _checked_div_program(dut, program, stalled=True)\n\n\n@cocotb.test()\nasync def division_completion_bus_backpressure(dut):\n    program = LI(1, 0x80000001) + [ADDI(2, 0, -3), SW(1, 0, 0x110),\n               DIV(3, 1, 2), SW(3, 0, 0x114), LW(4, 0, 0x114),\n               DIV(5, 4, 2, 6), SW(5, 0, 0x118), EBREAK()]\n    ready_rets = await _checked_div_program(dut, program)\n    div_cycle = next(c for c, _, insn in ready_rets if insn == DIV(3, 1, 2))\n    # Sweep bus-not-ready across the last recurrence, DONE, EX/MEM\n    # acceptance and the following store. Memory acceptance remains\n    # exactly once even when the store waits for a long burst.\n    for offset in (-4, -3, -2, -1, 0, 1):\n        start = div_cycle + offset\n        await _checked_div_program(dut, program,\n                                   imem_stalls=range(start, start + 4),\n                                   dmem_stalls=range(start, start + 12))\n\n\n@cocotb.test()\nasync def taken_branch_division_progress_bound(dut):\n    # Consecutive taken branches followed immediately at the target by\n    # divisions maximize bubbles between retirement and capture. Nine\n    # cycles between retirements fits trigger=10 / check=20 unchanged.\n    program = [ADDI(1, 0, 123), ADDI(2, 0, 7)]\n    for f3 in range(4, 8):\n        program += [BEQ(0, 0, 8), DIV(25, 1, 2), DIV(3, 1, 2, f3)]\n    program += [DIV(4, 3, 2), DIV(5, 4, 2), EBREAK()]\n    rets = await _checked_div_program(dut, program)\n    gaps = [b[0] - a[0] for a, b in zip(rets, rets[1:])]\n    assert max(gaps) <= 9, gaps\n    # Apply the formal liveness window at every possible trigger point.\n    for trigger in range(rets[-1][0] - 9):\n        assert any(trigger < cycle <= trigger + 10 for cycle, _, _ in rets)\n\n\n@cocotb.test()\nasync def reset_during_division(dut):\n    # DIV enters EX after cycle zero: reset across launch, all six groups,\n    # held DONE and acceptance, cancelling the entire old retirement epoch.\n    for reset_at in range(1, 10):\n        await _checked_div_program(dut, [DIV(1, 0, 0), EBREAK()], reset_at=reset_at)\n\n\n@pytest.mark.parametrize(\"altops\", [False, True])\ndef test_pipeline_runner(altops):\n    sources = [\n            \"core_pkg.sv\",\n            \"alu.sv\", \"div_unit.sv\", \"decoder.sv\", \"imm_gen.sv\", \"reg_file.sv\",\n            \"if_stage.sv\", \"id_stage.sv\", \"ex_stage.sv\",\n            \"mem_stage.sv\", \"wb_stage.sv\",\n            \"hazard_unit.sv\", \"forward_unit.sv\",\n            \"core.sv\",\n        ]\n    runner = get_runner(\"verilator\")\n    build_dir = SIM_BUILD / (\"core_altops\" if altops else \"core\")\n    runner.build(sources=[RTL / s for s in sources], hdl_toplevel=\"core\",\n                 build_dir=build_dir, always=True,\n                 build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"] +\n                            ([\"+define+RISCV_FORMAL_ALTOPS\"] if altops else []))\n    runner.test(hdl_toplevel=\"core\", test_module=\"test_pipeline\", test_dir=TEST_DIR,\n                build_dir=build_dir, extra_env={\"DIV_ALTOPS\": str(int(altops))})\n\n\ndef test_core_has_no_combinational_divider():\n    \"\"\"Elaboration must remove / and %, not just mux their results away.\"\"\"\n    sources = [RTL / \"core_pkg.sv\"] + sorted(p for p in RTL.glob(\"*.sv\")\n                                              if p.name != \"core_pkg.sv\")\n    script = (\"read_verilog -sv \" + \" \".join(str(p) for p in sources) +\n              \"; hierarchy -top core; proc; opt; \"\n              \"select -assert-none t:$div t:$mod t:$divfloor t:$modfloor\")\n    subprocess.run([\"yosys\", \"-Q\", \"-T\", \"-p\", script], check=True,\n                   capture_output=True, text=True)\n\n\ndef _transfer(insn, pc, a=0, b=0):\n    \"\"\"Independent architectural direct/indirect transfer reference.\"\"\"\n    op, f3 = insn & 127, (insn >> 12) & 7\n    branch = op == 0x63 and f3 in (0, 1, 4, 5, 6, 7)\n    jump = op == 0x6f or (op == 0x67 and f3 == 0)\n", "exit_code": 0, "status": "completed"}}
