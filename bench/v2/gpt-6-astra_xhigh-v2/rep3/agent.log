{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom random import Random\n\ndef divide(a, b, width):\n    rem = quo = 0\n    for k in range(1, width + 1):\n        trial = (rem << 1) | ((a >> (width - k)) & 1)\n        difference = (trial - (b & ((1 << k) - 1))) & ((1 << (k + 1)) - 1)\n        accept = (b >> k) == 0 and (difference >> k) == 0\n        rem = (difference & ((1 << k) - 1)) if accept else trial\n        quo |= int(accept) << (width - k)\n    return quo, rem\n\nfor a in range(256):\n    for b in range(256):\n        expected = divmod(a, b) if b else (255, a)\n        assert divide(a, b, 8) == expected\n\nrng = Random(20261002)\nmask = (1 << 32) - 1\nedges = [0, 1, 2, 3, 0x7fffffff, 0x80000000, 0x80000001, mask]\npairs = [(a, b) for a in edges for b in edges]\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\nfor a, b in pairs:\n    expected = divmod(a, b) if b else (mask, a)\n    assert divide(a, b, 32) == expected\n    sa = a if a < (1 << 31) else a - (1 << 32)\n    sb = b if b < (1 << 31) else b - (1 << 32)\n    q, r = divide(abs(sa), abs(sb), 32)\n    q = (-q if (sa < 0) \"'!= (sb < 0) else q) & mask\n    r = (-r if sa < 0 else r) & mask\n    if sb == 0:\n        q, r = mask, a\n        eq, er = mask, a\n    else:\n        eq = abs(sa) // abs(sb)\n        eq = -eq if (sa < 0) != (sb < 0) else eq\n        er = sa - eq * sb\n    assert (q, r) == (eq & mask, er & mask)\nprint('\"'Divider recurrence sanity check passed: exhaustive 8-bit operands and 10,064 signed/unsigned 32-bit pairs. This does not validate RTL or timing.')\nPY\n\ngit status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
