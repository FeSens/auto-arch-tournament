{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"git status --short; sed -n '500,570p' cores/bench/test/test_pipeline.py\"","aggregated_output":"            (0x184, 0, 1), (0x108, 15, 0)]\n        if store_delay == 14:\n            [division] = _by_insn(rets, DIV(3, 8, 2))\n            # A completed divider must transfer immediately as the older\n            # store is accepted, then retire after the two remaining edges.\n            assert division[\"cycle\"] == effects[1][0] + 2\n\n\n@cocotb.test()\nasync def division_branch_and_consecutive_liveness(dut):\n    # No ordinary instructions between the branch and its target divide.\n    program = [BEQ(0, 0, 8), SW(0, 0, 0x100), DIVU(1, 0, 0),\n               REM(2, 1, 0), DIV(3, 1, 1), REMU(0, 2, 3), EBREAK()]\n    rets, _ = await _run(dut, program, max_cycles=80)\n    _check_div_program(rets, program, [0, 8, 12, 16, 20, 24], max_gap=10)\n    assert rets[1][\"cycle\"] - rets[0][\"cycle\"] == 10\n    assert all(rets[i][\"cycle\"] - rets[i - 1][\"cycle\"] == 9 for i in (2, 3, 4))\n\n\n@cocotb.test()\nasync def division_reset_cancels_execution(dut):\n    program = [ADDI(1, 0, 103), ADDI(2, 0, 7), DIV(3, 1, 2),\n               SW(3, 0, 0x100), EBREAK()]\n    restart = [ADDI(4, 0, -99), ADDI(5, 0, 5), REM(6, 4, 5),\n               DIVU(7, 0, 0), SW(6, 0, 0x104), EBREAK()]\n    for reset_at in (4, 7, 10):\n        effects = []\n        rets, memory = await _run(dut, program, max_cycles=100, effects=effects,\n                                  reset_at=reset_at, reset_program=restart)\n        expected = _check_div_program(rets, restart, list(range(0, 24, 4)), max_gap=10)\n        assert memory == expected\n        assert [(e[1], e[2], e[3]) for e in effects] == [(0x104, 15, 0)]\n\n\n@cocotb.test()\nasync def division_reset_cancels_sticky_completion(dut):\n    program = [ADDI(1, 0, 103), ADDI(2, 0, 7), SW(1, 0, 0x100),\n               DIV(3, 1, 2), SW(3, 0, 0x108), EBREAK()]