{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"cp cores/bench/test/test_alu.py cores/bench/generated/hypgen-radix16/test_alu.original.py\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_alu.py')\ns=p.read_text();pos=s.index('\\\\ndef test_alu_runner():')\nadd='''\n@cocotb.test()\nasync def div_radix16_digits_and_wide_multiples(dut):\n    await _setup(dut)\n    pairs = set()\n    divisors = [1, 2, 3, 5, 7, 11, 15, 16, 17, 31, 255, 256, 257,\n                0x0fffffff, 0x10000000, 0x10000001, 0x15555555,\n                0x55555555, 0x7fffffff, 0x80000000, 0xfffffffe, MASK32]\n    quotients = [0x01234567, 0x89abcdef, 0xfedcba98, 0x76543210]\n    quotients += [int(format(digit, 'x') * 8, 16) for digit in range(16)]\n    for b in divisors:\n        for k in range(16):\n            for delta in (-1, 0, 1):\n                a = k * b + delta\n                if 0 <= a <= MASK32:\n                    pairs.add((a, b))\n        for q in quotients:\n            for r in (0, 1, b // 2, b - 1):\n                a = q * b + r\n                if r < b and a <= MASK32:\n                    pairs.add((a, b))\n        for a in (0, 1, 0x7fffffff, 0x80000000, MASK32):\n            pairs.add((a,b))\n    for a, b in sorted(pairs):\n        for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n            await _check_div(dut, op, a, b, _division_reference(op, a, b),\n                             check_state=True, ready_early=True)\n        if a <= 0x80000000 and b <= 0x80000000:\n            for sa, sb in ((-a, b), (a, -b), (-a, -b)):\n                for op in (ALU_DIV, ALU_REM):\n                    await _check_div(dut, op, sa, sb,\n                                     _division_reference(op, sa, sb),\n                                     check_state=True, ready_early=True)\n\n'''\np.write_text(s[:pos]+add+s[pos:])\nprint('Added directed probe test')\nPY\npytest -q cores/bench/test/test_alu.py > cores/bench/generated/hypgen-radix16/digit-tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
