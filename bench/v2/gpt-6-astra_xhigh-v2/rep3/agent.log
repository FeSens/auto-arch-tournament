  return ia == 16 or cycle % 7 not in (2, 3), dready\n        effects = []\n        rets, memory = await _run(dut, program, initial, max_cycles=250,\n                                  ready=ready, effects=effects)\n        expected = _check_div_program(rets, program, list(range(0, 40, 4)), initial)\n        assert memory == expected\n        assert [(e[1], e[2], e[3]) for e in effects] == [\n            (0x180, 0, 1), (0x100, 15, 0), (0x104, 15, 0),\n            (0x184, 0, 1), (0x108, 15, 0)]\n        if store_delay >= 8:\n            [division] = _by_insn(rets, DIV(3, 8, 2))\n            # A completed divider must transfer immediately as the older\n            # store is accepted, then retire after the two remaining edges.\n            assert division[\"cycle\"] == effects[1][0] + 2\n\n\n@cocotb.test()\nasync def division_branch_and_consecutive_liveness(dut):\n    # No ordinary instructions between the branch and its target divide.\n....","exit_code":1,"status":"failed"}}
