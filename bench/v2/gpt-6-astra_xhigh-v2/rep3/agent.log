{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nm=json.loads(Path('cores/bench/generated/forwarding-cone.json').read_text())['modules']['core']\ndrivers={}\nfor name,c in m['cells'].items():\n    for port,bits in c['connections'].items():\n        if c['port_directions'][port]=='output':\n            for bit in bits:\n                drivers[bit]=(name,c)\ndef cone(bits):\n    pending=list(bits); visited=set(); cells=set(); leaves=set()\n    while pending:\n        b=pending.pop()\n        if b in visited or isinstance(b,str): continue\n        visited.add(b)\n        if b not in drivers: leaves.add(b); continue\n        name,c=drivers[b]\n        if 'dff' in c['type'].lower() or 'latch' in c['type'].lower():\n            leaves.add(b); continue\n        cells.add(name)\n        for port,pbits in c['connections'].items():\n            if c['port_directions'][port]=='input': pending.extend(pbits)\n    return visited,cells,leaves\nentry=m['netnames']['id_ex_w']['bits']\nnew,cells,leaves=cone(m['netnames']['ex_fwd_w_en']['bits'])\nold,_,_=cone([m['netnames']['u_ex.ctrl_with_trap']['bits'][2]])\nrs2=set(entry[-96:-64]); branch_op=set(entry[47:50])\nassert not new & rs2\nassert not new & branch_op\nassert old & rs2\nprint('EX forwarding cone: no registered rs2 or branch_op dependency; original trap-adjusted write control still depends on rs2.')\nfor net in ('u_ex.branch_cond','u_ex.branch_taken','u_ex.misalign_branch','u_ex.misalign_fault'):\n    assert not new.intersection(m['netnames'][net]['bits']),net\n    print(net, 'absent from fwd_w_en cone')\nprint('Combinational cells in fwd_w_en cone:',len(cells))\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import critical_paths\nfor p in range(3):\n    text=(Path(f'cores/bench/generated/timing/gowin_p{p}/impl/pnr/core_bench.tr')).read_text()\n    setup=text.split('3.3.1 Setup Analysis Report\\\\n')[-1].split('3.3.2 Hold Analysis Report\\\\n')[0]\n    paths=critical_paths(text,25)\n    forwarding=[x for x in paths if '/u_id/reg_q.rs' in x['to']]\n    print('Placement',p,':',len(paths),'full setup paths;',len(forwarding),'end at ID/EX source capture')\n    assert all(name not in setup for name in ('train_next','ctrl_with_trap.reg_write','branch_cond','misalign_branch'))\n    print('No branch-condition/training/trap-write cells in the 25 reported setup paths.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
