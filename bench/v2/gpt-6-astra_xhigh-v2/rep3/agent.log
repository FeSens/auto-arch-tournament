{"type": "item.completed", "item": {"id": "item_14", "type": "command_execution", "command": "/bin/bash -c \"sed -n '490,580p' cores/bench/test/test_alu.py && sed -n '74,234p' cores/bench/test/test_pipeline.py && sed -n '422,650p' cores/bench/test/test_pipeline.py && cat cores/bench/test/_helpers.py\"", "aggregated_output": "    combinational digit/remainder with integer divmod. Full transactions\n    elsewhere verify the controller's state capture and schedule.\n    \"\"\"\n    rng = random.Random(0x16D161DE)\n    divisors = set(range(1, 256))\n    for bit in range(1, 32):\n        divisors.update(((1 << bit) - 1, 1 << bit, (1 << bit) + 1))\n    divisors.update((MASK32, MASK32 - 1, 0xeeeeeeee, 0xaaaaaaaa))\n    divisors.update(rng.randrange(1, 1 << 32) for _ in range(512))\n    for divisor in sorted(divisors):\n        await _setup(dut)\n        dut.op.value = ALU_DIVU\n        dut.a.value, dut.b.value = MASK32, divisor\n        dut.m_a.value, dut.m_b.value = MASK32, divisor\n        dut.div_req_valid.value = 1\n        await _tick(dut)\n        dut.div_req_valid.value = 0\n        for k in range(1, 16):\n            assert int(dut.multiple_q[k].value) == k * divisor\n        # Capture must isolate every multiple from subsequent live inputs.\n        dut.op.value = ALU_REM\n        dut.a.value, dut.b.value = rng.getrandbits(32), rng.getrandbits(32)\n        dut.m_a.value, dut.m_b.value = rng.getrandbits(32), rng.getrandbits(32)\n        trials = {0, 16 * divisor - 1}\n        for digit in range(1, 16):\n            trials.update(digit * divisor + delta for delta in (-1, 0, 1))\n        for remainder in (0, divisor // 2, divisor - 1):\n            trials.update(16 * remainder + nibble for nibble in range(16))\n        trials.update(16 * rng.randrange(divisor) + rng.randrange(16) for _ in range(64))\n        for trial in sorted(trials):\n            if not 0 <= trial < 16 * divisor:\n                continue\n            dut.remainder_q.value = trial >> 4\n            dut.quotient_q.value = ((trial & 15) << 28) | rng.getrandbits(28)\n            await Timer(1, \"ns\")\n            digit, remainder = divmod(trial, divisor)\n            selected = int(dut.selected_digit.value)\n            assert selected == (remainder << 4) | digit, (divisor, trial, selected)\n            assert int(dut.digit_select.value) == 1 << digit\n\n\n@cocotb.test()\nasync def div_long_completed_backpressure\n…[21370 of 24442 chars elided by tools/bench/transcript.py; sha256:4461606037f34c5d]…\nBGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n", "exit_code": 0, "status": "completed"}}
