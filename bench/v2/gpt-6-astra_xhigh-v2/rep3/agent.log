 b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\nd\n…[7510 of 10582 chars elided by tools/bench/transcript.py; sha256:134e93f8e130ea5f]…\nrdata\": int(dut.io_rvfi_mem_rdata_0.value),\n                \"cycle\":     cycle,\n            }\n            assert captures, \"retirement without a valid ID/EX capture\"\n            assert captures.pop(0) == (r[\"pc\"], r[\"rs1_rdata\"], r[\"rs2_rdata\"]), \\\n                \"RVFI operands differ from the original ID/EX capture\"\n            retirements.append(r)\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        if rvfi_v and retirements[-1][\"insn\"] == EBREAK():\n            break\n    else:\n        raise AssertionError(f\"max_cycles={max_cycles} reached without EBREAK\")\n\n    _check_predictor_trace(predictor_trace)\n    assert [r[\"order\"] for r in retirements] == list(range(len(retirements)))\n    return retirements, dmem\n\n\ndef _by_insn(retirements, insn):\n    \"\"\"Return all retirements matching a specific instruction word.\"\"\"\n    return [r for r in retirements if r[\"insn\"] == insn]\n\n\n# ── Tests ──────────────────────────────────────────────────────────────────\n@cocotb.test()\nasync def forwarding_ex_to_ex(dut):\n", "exit_code": 0, "status": "completed"}}
