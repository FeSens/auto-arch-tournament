ut):\n    \"\"\"Keep RV32M signed semantics for operands from deep formal traces.\"\"\"\n    await _setup(dut)\n    a, b = 0xf942e578, 0xffc2e178  # -113056392 / -4005512\n", "exit_code": 0, "status": "completed"}}
