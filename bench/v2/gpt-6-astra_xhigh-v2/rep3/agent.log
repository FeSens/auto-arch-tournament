{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench');p=root/'rtl/alu.sv'\nshutil.copyfile(root/'generated/r9_radix32_original.sv',p)\ns=p.read_text()\na=s.index('    always_ff @(posedge clock) begin\\\\n      if (reset) multiple_q[k]');b=s.index('  assign digit_trial',a)\ns=s[:a]+'''    if (k % 2 == 0) begin : even_multiple\n      assign multiple_q[k] = multiple_q[k/2] << 1;\n    end else begin : odd_multiple\n      always_ff @(posedge clock) begin\n        if (reset) multiple_q[k] <= 37'b0;\n        else if (div_req_valid && div_req_ready) multiple_q[k] <= multiple_d;\n      end\n    end\n  end\n'''+s[b:]\np.write_text(s)\nPY\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench');p=root/'rtl/alu.sv'\nshutil.copyfile(root/'generated/r9_radix32_original.sv',p)\ns=p.read_text()\na=s.index('    always_ff @(posedge clock) begin\\\\n      if (reset) multiple_q[k]');b=s.index('  assign digit_trial',a)\ns=s[:a]+'''    if (k % 2 == 0) begin : even_multiple\n      assign multiple_q[k] = multiple_q[k/2] << 1;\n    end else begin : odd_multiple\n      always_ff @(posedge clock) begin\n        if (reset) multiple_q[k] <= 37'b0;\n        else if (div_req_valid && div_req_ready) multiple_q[k] <= multiple_d;\n      end\n    end\n  end\n'''+s[b:]\np.write_text(s)\nPY\nmake lint TARGET=bench\"","aggregated_output":"%Warning-UNUSEDSIGNAL: cores/bench/rtl/alu.sv:149:18: Signal is not used: 'multiple_d'\n                                                    : ... note: In instance 'core.u_ex.u_alu'\n  149 |     logic [36:0] multiple_d;\n      |                  ^~~~~~~~~~\n                       ... For warning description see https://verilator.org/warn/UNUSEDSIGNAL?v=5.047\n                       ... Use \"/* verilator lint_off UNUSEDSIGNAL */\" and lint_on around source to disable this message.\n%Warning-UNOPTFLAT: cores/bench/rtl/alu.sv:125:16: Signal unoptimizable: Circular combinational logic: 'core.u_ex.u_alu.multiple_q'\n  125 |   logic [36:0] multiple_q [1:31];\n      |                ^~~~~~~~~~\n                    ... For warning description see https://verilator.org/warn/UNOPTFLAT?v=5.047\n                    ... Use \"/* verilator lint_off UNOPTFLAT */\" and lint_on around source to disable this message.\n                    cores/bench/rtl/alu.sv:125:16:      Example path: core.u_ex.u_alu.multiple_q\n                    cores/bench/rtl/alu.sv:186:24:      Example path: ASSIGNW\n                    cores/bench/rtl/alu.sv:125:16:      Example path: core.u_ex.u_alu.multiple