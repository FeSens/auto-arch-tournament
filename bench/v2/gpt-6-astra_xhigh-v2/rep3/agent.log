{"type": "item.started", "item": {"id": "item_92", "type": "command_execution", "command": "/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfor n in ['alu.sv','ex_stage.sv']:\n (Path('cores/bench/rtl')/n).write_bytes((Path('cores/bench/generated/r6_munit_rtl')/n).read_bytes())\np=Path('cores/bench/test/test_alu.py')\ns=p.read_text().replace('    dut.div_req_valid.value = 0\\\\n    dut.div_result_ready.value = 0\\\\n','''    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    dut.mul_req_valid.value = 0\n    dut.mul_result_ready.value = 0\n    dut.mul_a.value = 0\n    dut.mul_b.value = 0\n''',1)\ns=s.replace('    \\\"\\\"\\\"Drive op/a/b and check the combinational result.\\\"\\\"\\\"\\\\n','''    \\\"\\\"\\\"Check combinational integer or registered multiply results.\\\"\\\"\\\"\n    if op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        await _check_mul(dut, op, a, b, expected)\n        return\n''')\ns+='''\n\nasync def _check_mul(dut, op, a, b, expected, hold=0):\n    assert int(dut.mul_req_ready.value)\n    assert not int(dut.mul_result_valid.value)\n    dut.op.value = op\n    dut.mul_a.value, dut.mul_b.value = a & MASK32, b & MASK32\n    dut.mul_req_valid.value = 1\n    dut.mul_result_ready.value = 1\n    await Timer(1, \\\"ns\\\")\n    assert not int(dut.mul_result_valid.value)\n    await _tick(dut)\n    dut.mul_result_ready.value = 0\n    assert int(dut.mul_result_valid.value)\n    assert not int(dut.mul_req_ready.value)\n    assert int(dut.mul_result.value) == expected & MASK32\n    for cycle in range(hold):\n        dut.op.value = ALU_ADD\n        dut.mul_a.value, dut.mul_b.value = cycle, cycle + 123\n        await _tick(dut)\n        assert int(dut.mul_result_valid.value)\n        assert not int(dut.mul_req_ready.value)\n        assert int(dut.mul_result.value) == expected & MASK32\n    dut.mul_req_valid.value = 0\n    dut.mul_result_ready.value = 1\n    await _tick(dut)\n    assert not int(dut.mul_result_valid.value)\n    assert int(dut.mul_req_ready.value)\n    dut.mul_result_ready.value = 0\n\n\n@cocotb.test()\nasync def probe_multiply_random_and_retention(dut):\n    await _setup(dut)\n    rng = random.Random(20261002)\n    values = [0,1,2,0x7fffffff,0x80000000,0xfffffffe,0xffffffff]\n    pairs = [(a,b) for a in values for b in values]\n    pairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(512)]\n    for op in (ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU):\n        for i,(a,b) in enumerate(pairs):\n            av=a-(1<<32) if a>>31 and op in (ALU_MULH,ALU_MULHSU) else a\n            bv=b-(1<<32) if b>>31 and op==ALU_MULH else b\n            expected=av*bv\n            if op\"'!=ALU_MUL: expected >>= 32\n            await _check_mul(dut,op,a,b,expected,hold=9 if i%23==0 else 0)\n    dut.op.value = ALU_MULH\n    dut.mul_a.value,dut.mul_b.value=0x80000000,0xffffffff\n    dut.mul_req_valid.value=1\n    await _tick(dut)\n    dut.mul_req_valid.value=0\n    dut.reset.value=1\n    await Timer(1,\"ns\")\n    assert not int(dut.mul_result_valid.value)\n    await _tick(dut)\n    dut.reset.value=0\n    for _ in range(3):\n        await _tick(dut)\n        assert not int(dut.mul_result_valid.value)\n\n\n@cocotb.test()\nasync def probe_parallel_prefix_boundaries(dut):\n    await _setup(dut)\n    divisors=list(range(18))+[(-i)&MASK32 for i in range(1,18)]+[0x80000000,0xffff0001]\n    for hi in range(16):\n        for lo in (0,1,0xfffffff):\n            a=(hi<<28)|lo\n            for b in divisors:\n                for op in (ALU_DIV,ALU_DIVU,ALU_REM,ALU_REMU):\n                    await _check_div(dut,op,a,b,_division_reference(op,a,b),check_state=True)\n'\"'''\np.write_text(s)\np=Path('cores/bench/test/test_alu_altops.py')\ns=p.read_text().replace('from test_alu import _setup, _tick','from test_alu import _setup, _tick, _check_mul\\\\nfrom _helpers import ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU')\ns+='''\\\\n\\\\n@cocotb.test()\nasync def probe_multiply_altops(dut):\n    await _setup(dut)\n    for op,mask in ((ALU_MUL,0x5876063e),(ALU_MULH,0xf6583fb7),(ALU_MULHU,0x949ce5e8),(ALU_MULHSU,0xecfbe137)):\n        for a,b in ((0,0),(0xffffffff,0x80000000),(0x12345678,0x87654321)):\n            expected=((a-b) if op==ALU_MULHSU else (a+b)) \"'^ mask\n            await _check_mul(dut,op,a,b,expected,hold=6)\n'\"'''\np.write_text(s)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
