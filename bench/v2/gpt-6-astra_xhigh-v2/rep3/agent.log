{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger and multiply operations remain combinational. DIV/REM use the\nlaunch-prefix/seven-iteration request/result interface, with registered,\nsticky completion and the original earliest t8 result handshake.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0, check_state=False,\n                     ready_early=False):\n    \"\"\"Check t0 launch, t1..t7 iterations, and t8 consumption or retention.\"\"\"\n    assert int(dut.div_req_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    dut.div_result_ready.value = int(ready_early)\n    await _tick(dut)  # t0 accepts operands and computes the first four bits\n    dut.div_req_valid.value = 0\n    if check_state:\n        a_bits, b_bits = a & MASK32, b & MASK32\n        signed = op\n…[10563 of 13635 chars elided by tools/bench/transcript.py; sha256:781822361763222c]…\n\n    await _check_div(dut, ALU_DIVU, a, b, 0, check_state=True)\n    await _check_div(dut, ALU_REMU, a, b, a, check_state=True)\n\n\n@cocotb.test()\nasync def div_reset_cancels_pending_and_completed(dut):\n    for cycles in (0, 3, 6, 7, 8, 12):\n        await _setup(dut)\n        dut.op.value = ALU_DIV\n        dut.a.value = 0x80000000\n        dut.b.value = 13\n        dut.div_req_valid.value = 1\n        await _tick(dut)\n        dut.div_req_valid.value = 0\n        for _ in range(cycles):\n            await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(10):\n            await _tick(dut)\n            assert not int(dut.div_result_valid.value)\n            assert int(dut.div_req_ready.value)\n        await _check_div(dut, ALU_REM, -103, 7, -5)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
