{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nimport json\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all,summarize\np=Path('/srv/hwebench/tmp/84625fbe/b372f1f5/r8-dualprefix-probe')\nr=build_all(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',p/'timing')\n(p/'timing.json').write_text(json.dumps(r,indent=2)); print(json.dumps(summarize(r),indent=2),flush=True)\nPY\"","aggregated_output":"{\n  \"placement_failed\": false,\n  \"fmax_mhz\": 76.961,\n  \"seeds\": [\n    75.397,\n    76.961,\n    76.961\n  ],\n  \"perturbations\": [\n    [\n      0,\n      75.397,\n      11\n    ],\n    [\n      1,\n      76.961,\n      11\n    ],\n    [\n      2,\n      76.961,\n      11\n    ]\n  ],\n  \"lut4\": 5048,\n  \"ff\": 1933,\n  \"lutram\": 0,\n  \"bsram\": 4,\n  \"dsp\": 6,\n  \"logic_levels\": 11,\n  \"critical_path\": {\n    \"from\": \"cpu/u_id/reg_q.pc_8_s0\",\n    \"to\": \"cpu/u_ex/u_alu/mul_uu_63_s0\",\n    \"slack_ns\": -8.263,\n    \"arrival_ns\": 18.337,\n    \"logic_cells\": 23,\n    \"modules\": [\n      \"clock_ibuf\",\n      \"cpu/u_ex\",\n      \"cpu/u_ex/u_alu\",\n      \"cpu/u_ex\",\n      \"cpu/u_id\"\n    ]\n  }\n}\n","exit_code":0,"status":"completed"}}
