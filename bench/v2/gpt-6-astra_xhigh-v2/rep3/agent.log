'want_remainder_q <= divide_remainder;');p.write_text(s)\nr=build_all(Path('.'),variant,'fpga/core_bench_si.sv',g/'predecode/timing',options=(0,));(g/'predecode/results.json').write_text(json.dumps(r,indent=2));print(json.dumps(r))\nPY\"","aggregated_output":"[{\"place_option\": 0, \"placement_failed\": false, \"fmax_mhz\": 69.794, \"levels\": 17, \"logic\": 5201, \"regs\": 2226, \"lutram\": 0, \"bsram\": 4, \"dsp\": 6, \"critical_paths\": [{\"from\": \"cpu/u_id/reg_q.rs2_val_2_s0\", \"to\": \"cpu/u_ex/u_alu/remainder_q_1_s1\", \"slack_ns\": -9.328, \"arrival_ns\": 19.622, \"logic_cells\": 20, \"modules\": [\"clock_ibuf\", \"cpu/u_ex/u_alu\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_ex/u_alu/mul_uu_63_s0\", \"slack_ns\": -9.323, \"arrival_ns\": 19.429, \"logic_cells\": 37, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_ex\", \"cpu/u_id\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_ex/u_alu/mult_5_s1\", \"slack_ns\": -9.311, \"arrival_ns\": 19.417, \"logic_cells\": 38, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_ex\", \"cpu/u_id\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_0_s0\", \"to\": \"cpu/u_ex/u_alu/mult_5_s1\", \"slack_ns\": -9.311, \"arrival_ns\": 19.416, \"logic_cells\": 38, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_ex\", \"cpu/u_id\"]}, {\"from\": \"cpu/u_id/reg_q.rs2_val_4_s0\", \"to\": \"cpu/u_ex/u_alu/multiple_q[13]_35_s0\", \"slack_ns\": -9.299, \"arrival_ns\": 19.594, \"logic_cells\": 16, \"modules\": [\"clock_ibuf\", \"cpu/u_ex/u_alu\"]}]}]\n","exit_code":0,"status":"completed"}}
