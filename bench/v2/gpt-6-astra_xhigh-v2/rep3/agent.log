{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor\nimport json, os, shutil, subprocess, tempfile\nfrom tools.eval.fpga import validate_coremark_uart, parse_iterations\nwith tempfile.TemporaryDirectory(prefix='carry-select-baseline-', dir=os.environ['TMPDIR']) as tmp:\n    root = Path(tmp)\n    rtl = root / 'rtl'\n    shutil.copytree('cores/bench/rtl', rtl)\n    original = subprocess.run(['git', 'show', 'HEAD:cores/bench/rtl/alu.sv'], check=True, capture_output=True).stdout\n    (rtl / 'alu.sv').write_bytes(original)\n    obj = root / 'obj_dir'\n    env = dict(os.environ, RTL_DIR=str(rtl), OBJ_DIR=str(obj), NRET='1')\n    result = subprocess.run(['bash', 'test/cosim/build.sh'], env=env, capture_output=True, text=True)\n    assert result.returncode == 0, result.stdout[-3000:] + result.stderr[-3000:]\n    def run(seed):\n        result = subprocess.run([str(obj / 'cosim_sim'), str(Path('bench/programs/coremark.elf').resolve()), '50000000', '--bench', '--istall', '--dstall', '--seed', str(seed)], capture_output=True, text=True, timeout=600)\n        marker = json.loads(result.stdout.splitlines()[-1])\n        assert result.returncode == 0 and marker['ebreak'] and not marker['oob'] and marker['bench_bracketed'], marker\n        valid, reason = validate_coremark_uart(marker['uart'], parse_iterations('.'))\n        assert valid, reason\n        cycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\n        expected = 3978988 if seed == 0xdeadbeef else 3981099\n        assert cycles == expected, (cycles, expected)\n        return {'original_RTL_seed': hex(seed), 'cycles': cycles, 'candidate_cycles_identical': True, 'checks': 'CRC/UART/bounds/markers PASS'}\n    with ThreadPoolExecutor(max_workers=2) as pool:\n        for result in pool.map(run, (0xdeadbeef, 0x12345678)):\n            print(json.dumps(result), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
