{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/84625fbe/aeb2bec3/r6s0_probe')\nrtl=root/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\np=rtl/'alu.sv'\ns=p.read_text()\na=s.index('  // 64-bit products')\nb=s.index('    case (op)',a)\ns=s[:a]+'''\"'`ifndef RISCV_FORMAL_ALTOPS\n  logic mul_signed_a, mul_signed_b;\n  logic signed [32:0] mul_a, mul_b;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic signed [65:0] mul_product;\n  /* verilator lint_on UNUSEDSIGNAL */\n  assign mul_signed_a = (op == ALU_MULH || op == ALU_MULHSU);\n  assign mul_signed_b = (op == ALU_MULH);\n  assign mul_a = $signed({mul_signed_a && a[31], a});\n  assign mul_b = $signed({mul_signed_b && b[31], b});\n  assign mul_product = mul_a * mul_b;\n`endif\n\n  always_comb begin\n    shamt = b[4:0];\n\n'\"'''+s[b:]\ns=s.replace('''      ALU_MUL:    out = mul_uu[31:0];\n      ALU_MULH:   out = \"'$unsigned(mul_ss[63:32]);\n      ALU_MULHU:  out = mul_uu[63:32];\n      ALU_MULHSU: out = $unsigned(mul_su[63:32]);'\"''','''      ALU_MUL:    out = mul_product[31:0];\n      ALU_MULH, ALU_MULHU, ALU_MULHSU: out = mul_product[63:32];''')\np.write_text(s)\nprint(root)\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.gowin import build_all, summarize\nimport json\nroot=Path('/srv/hwebench/tmp/84625fbe/aeb2bec3/r6s0_probe')\nresults=build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'timing_results.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(summarize(results),indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
