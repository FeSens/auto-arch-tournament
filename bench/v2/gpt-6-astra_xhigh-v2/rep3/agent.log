{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"cat > cores/bench/test/test_r7_probe.py <<'PY'\nfrom pathlib import Path\nimport os\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\nfrom _helpers import RTL, TEST_DIR, SIM_BUILD\n\nasync def tick(dut):\n    dut.clock.value = 0\n    await Timer(5, 'ns')\n    dut.clock.value = 1\n    await Timer(5, 'ns')\n    dut.clock.value = 0\n\n@cocotb.test()\nasync def prefix_division_probe(dut):\n    alt = os.environ.get('R7_ALT') == '1'\n    mask = 0xffffffff\n    dut.reset.value = 1\n    dut.clock.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    dut.op.value = 0\n    dut.a.value = 123\n    dut.b.value = 456\n    dut.m_a.value = 0\n    dut.m_b.value = 0\n    await tick(dut)\n    dut.reset.value = 0\n    await Timer(1, 'ns')\n    consts = {15:0x7f8529ec,16:0x10e8fd70,17:0x8da68fa5,18:0x3138d0e1}\n    divisors = [0] + list(range(1,18)) + [(-x)&mask for x in range(1,18)] + [0x80000000,0x10000001,0xfffffff0]\n    count = 0\n    for nibble in range(16):\n        for lo in (0,1,0xfffffff):\n            a=(nibble<<28)|lo\n            for b in divisors:\n                for op in range(15,19):\n                    signed=op in (15,17)\n                    sa=a-(1<<32) if signed and a>>31 else a\n                    sb=b-(1<<32) if signed and b>>31 else b\n                    q=abs(sa)//abs(sb) if sb else mask\n                    if sb and ((sa<0) \"'!= (sb<0)): q=-q\n                    expected=(q if op in (15,16) else (sa-q*sb if sb else sa))&mask\n                    if alt: expected=((a-b)''^consts[op])&mask\n                    assert int(dut.div_req_ready.value)\n                    dut.m_a.value=a\n                    dut.m_b.value=b\n                    dut.op.value=op\n                    dut.div_req_valid.value=1\n                    await tick(dut)\n                    if not alt:\n                        n=(abs(sa)>>28)&15\n                        d=abs(sb)\n                        q4=n//d if d else 0\n                        r4=n%d if d else n\n                        assert int(dut.quotient_q.value) == (((abs(sa)&0xfffffff)<<4)|q4)\n                        assert int(dut.remainder_q.value) == r4\n                    dut.div_req_valid.value=0\n                    dut.m_a.value=123456\n                    dut.m_b.value=987654\n                    for edge in range(7):\n                        assert not int(dut.div_result_valid.value)\n                        await tick(dut)\n                    assert int(dut.div_result_valid.value)\n                    assert int(dut.div_result.value)==expected, (op,a,b,expected,int(dut.div_result.value))\n                    if count%17==0:\n                        for _ in range(5):\n                            await tick(dut)\n                            assert int(dut.div_result_valid.value)\n                            assert int(dut.div_result.value)==expected\n                    dut.div_result_ready.value=1\n                    await tick(dut)\n                    dut.div_result_ready.value=0\n                    assert not int(dut.div_result_valid.value)\n                    count+=1\n    dut._log.info('\"'Checked %d division and prefix vectors; ALTOPS=%s',count,alt)\n\ndef test_r7_real():\n    run(False)\n\ndef test_r7_alt():\n    run(True)\n\ndef run(alt):\n    runner=get_runner('verilator')\n    build=SIM_BUILD/('r7_alt' if alt else 'r7_real')\n    runner.build(sources=[str(RTL/n) for n in ('core_pkg.sv','alu.sv')],hdl_toplevel='alu',build_dir=str(build),always=True,defines={'RISCV_FORMAL_ALTOPS':1} if alt else {},build_args=['-Wall','-Wno-fatal','-Wno-style'])\n    runner.test(hdl_toplevel='alu',test_module='test_r7_probe',test_dir=str(TEST_DIR),build_dir=str(build),extra_env={'R7_ALT':'1' if alt else '0'})\nPY\npytest -q cores/bench/test/test_r7_probe.py > cores/bench/generated/r7probe/divider_probe.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
