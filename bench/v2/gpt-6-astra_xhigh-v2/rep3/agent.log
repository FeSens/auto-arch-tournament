{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/test/conftest.py; sed -n '1,200p' test/cosim/reference.py; rg -n 'coremark|trace|argparse' test/cosim/run_cosim.py Makefile\"", "aggregated_output": "\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n#!/usr/bin/env python3\n\"\"\"RV32IM reference interpreter for the cosim. Mirrors the DUT's trap\ndiscipline so cosim traces stay aligned across illegal / misaligned\nencodings.\n\nTrap policy (matches rtl/decoder.sv default-illegal + rtl/ex_stage.sv +\nrtl/mem_stage.sv misalign traps):\n\n  - Reserved R-type:        funct7=0x20 with fn3 ∈ {1,2,3,4,6,7}\n  - Reserved OP-IMM shifts: SLLI/SRLI/SRAI with disallowed funct7\n  - Reserved LOAD funct3:   3, 6, 7\n  - Reserved STORE funct3:  3..7\n  - Reserved BRANCH funct3: 2, 3\n  - JALR funct3 != 0\n  - Non-EBREAK SYSTEM:      ECALL, CSR ops, MRET, …\n  - Unknown opcode (AMO etc.)\n  - Misaligned LH/LHU/LW/SH/SW\n  - Misaligned BRANCH (taken) / JAL / JALR target\n\nOn trap the retirement is reported with rvfi_trap=1, rd_addr=0,\nrd_wdata=0, mem_*=0, npc=pc+4. The DUT's mem_stage / ex_stage match\nthis on the same encodings.\n\nModifications to this file require explicit user approval.\"\"\"\nimport struct, sys\nfrom dataclasses import dataclass, field\nfrom typing import Optional\n\nXLEN = 32\nMASK = (1 << XLEN) - 1\nMEM_BYTES = 1 << 20  # 1 MiB\n\n# MMIO UART. Writes are consumed by the testbench. Reads are undefined\n# and are flagged as oob_access (sticky); main.cpp does the same.\nUART_BASE = 0x10000000\nUART_MASK = 0xFFF00000\n\n@dataclass\nclass RV32IM:\n    mem: bytearray = field(default_factory=lambda: bytearray(MEM_BYTES))\n    regs: list = field(default_factory=lambda: [0] * 32)\n    pc: int = 0\n    retired: int = 0\n    oob_access: bool = False\n    uart_buf: bytearray = field(default_factory=bytearray)\n\n    def load_elf(self, path: str):\n        data = open(path, 'rb').read()\n        assert data[:4] == b'\\x7fELF'\n        e_phoff     = struct.unpack_f\n…[7911 of 10983 chars elided by tools/bench/transcript.py; sha256:84a2b6bbbb655938]…\nrun_cosim.py:31:        trace.append(r)\ntest/cosim/run_cosim.py:33:            return trace, True, None\ntest/cosim/run_cosim.py:34:    return trace, False, 'reference_max_insns_without_ebreak'\ntest/cosim/run_cosim.py:41:def compare(ref_trace, sim_trace, ref_completed=True, sim_completed=True,\ntest/cosim/run_cosim.py:43:    for i, (ref, sim) in enumerate(zip(ref_trace, sim_trace)):\ntest/cosim/run_cosim.py:90:        return {'passed': False, 'divergence_at': len(ref_trace),\ntest/cosim/run_cosim.py:93:        return {'passed': False, 'divergence_at': len(sim_trace),\ntest/cosim/run_cosim.py:96:    if len(ref_trace) != len(sim_trace):\ntest/cosim/run_cosim.py:97:        return {'passed': False, 'divergence_at': min(len(ref_trace),len(sim_trace)),\ntest/cosim/run_cosim.py:99:                'expected': len(ref_trace), 'got': len(sim_trace)}\ntest/cosim/run_cosim.py:100:    return {'passed': True, 'retired': len(ref_trace)}\ntest/cosim/run_cosim.py:104:    # --dstall to run the trace comparison under bus backpressure).\n", "exit_code": 0, "status": "completed"}}
