  b20    = (imm >> 20) & 1\n    b101   = (imm >> 1)  & 0x3FF\n    b11    = (imm >> 11) & 1\n    b1912  = (imm >> 12) & 0xFF\n    return (b20 << 31) | (b101 << 21) | (b11 << 20) | (b1912 << 12) \\\n         | ((rd & 0x1F) << 7) | (opcode & 0x7F)\n\n\ndef ADDI(rd, rs1, imm): return _i(imm & 0xFFF, rs1, 0b000, rd, 0b0010011)\ndef ADD (rd, rs1, rs2): return _r(0, rs2, rs1, 0b000, rd, 0b0110011)\nd\n…[13156 of 16228 chars elided by tools/bench/transcript.py; sha256:55849bfe61b4ea5f]…\nranch and not fault\n971:async def agree_warmup_reversal_and_bubble_free_loop(dut):\n1004:async def agree_aliases_use_saved_prediction_and_current_counter(dut):\n1032:async def agree_held_branch_release_overrides_unavailable_fetch(dut):\n1034:    # Negative branch targets are wrong-path stores on the taken prediction.\n1037:            branch = BEQ(1, 0, -8) if backwards else BEQ(1, 1, 8)\n1039:                       LW(2, 0, 0x180) if load else SW(1, 0, 0x100), branch,\n1066:async def agree_dependencies_divide_and_adjacent_transfers(dut):\n1098:async def agree_reserved_encodings_alignment_and_reset(dut):\n1134:    # Reset cancels a resolving branch behind an unaccepted older store.\n1147:async def agree_all_branch_conditions_and_correctly_predicted_holds(dut):\n1150:            branch = _b(8, 2, 1, funct3, 0x63)\n1151:            program = [ADDI(1, 0, a), ADDI(2, 0, b), branch, ADD(3, 1, 2), EBREAK()]\n1152:            taken = _direct_control(branch, 8, a & 0xffffffff, b & 0xffffffff)[4]\n1180:def test_pipeline_runner():\n", "exit_code": 0, "status": "completed"}}
