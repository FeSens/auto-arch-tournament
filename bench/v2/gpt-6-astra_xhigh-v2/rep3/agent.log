env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[21216 of 24288 chars elided by tools/bench/transcript.py; sha256:905ae1687691ad2e]…\net: str | None) -> str:\n    \"\"\"The FPGA wrapper for the core's RVFI width (nret).\"\"\"\n    if target is None:\n        return \"fpga/core_bench.sv\"\n    nret = read_nret(Path(worktree) / \"cores\" / target / \"core.yaml\")\ncores/bench/test/test_imm_gen.py\ncores/bench/test/conftest.py\ncores/bench/test/test_if_stage.py\ncores/bench/test/test_pipeline.py\ncores/bench/test/_helpers.py\ncores/bench/test/test_decoder.py\ncores/bench/test/test_reg_file.py\ncores/bench/test/test_alu_altops.py\ncores/bench/test/test_alu.py\ntest/cosim/reference.py\ntest/cosim/main.cpp\ntest/cosim/build.sh\ntest/cosim/run_cosim.py\ntest/conftest.py\ntest/_helpers.py\nlrwxrwxrwx 1 nobody nogroup 66 Oct  2 13:21 formal/riscv-formal -> /srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep3/formal/riscv-formal\n/srv/hwebench/tmp/84625fbe/6bc6513d\n/srv/hwebench/toolchain/oss-cad-suite/bin/verilator\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n/srv/hwebench/toolchain/oss-cad-suite/bin/sby\n/srv/hwebench/toolchain/oss-cad-suite/bin/bitwuzla\n/srv/hwebench/venv/bin/pytest\n", "exit_code": 0, "status": "completed"}}
