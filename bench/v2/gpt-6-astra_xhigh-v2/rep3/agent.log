1\",\ntools/eval/gowin.py:75:def critical_paths(tr_text: str, n: int = 5) -> list[dict]:\ntools/eval/gowin.py:76:    \"\"\"The n worst setup paths: endpoints, delay, logic cells and the\ntools/eval/gowin.py:77:    modules the path crosses (in order), from Gowin's timing report.\"\"\"\ntools/eval/gowin.py:114:        return {\"placement_failed\": True, \"fmax_mhz\": None, \"reason\": \"no Fmax in timing report\"}\ntools/eval/gowin.py:124:        \"critical_paths\": critical_paths(t),\ntools/eval/gowin.py:155:    # Plain threads and blocking waits, no asyncio: agents run `make timing`\ntools/eval/gowin.py:195:        \"critical_path\": (ref.get(\"critical_paths\") or [None])[0],\ntools/eval/gowin.py:200:    \"\"\"`make timing TARGET=<core>`: the vendor timing the evaluator scores,\ntools/eval/gowin.py:201:    with the worst paths, for agents' own checks.\"\"\"\ntools/eval/gowin.py:214:                                wt / \"cores\" / a.target / \"generated\" / \"timing\", options=opts)\ntools/eval/gowin.py:221:        tr = (wt / \"cores\" / a.target / \"generated\" / \"timing\" / f\"gowin_p{r['place_option']}\" / \"impl/pnr/core_bench.tr\")\ntools/eval/gowin.py:222:        for i, p in enumerate(critical_paths(tr.read_text(errors=\"replace\"), a.paths), 1):\ncores/bench/experiments/.gitkeep\ncores/bench/experiments/log.jsonl\ncores/bench/experiments/progress.png\n","exit_code":0,"status":"completed"}}
