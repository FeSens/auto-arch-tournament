{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/bash -c 'cat cores/bench/test/test_alu.py\ncat cores/bench/test/test_alu_altops.py'", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger and multiply operations remain combinational. DIV/REM use the\nlaunch-prefix/seven-iteration request/result interface, with registered,\nsticky completion and the original earliest t8 result handshake.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.m_a.value = 0\n    dut.m_b.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected, *, m_a=None, m_b=None):\n    \"\"\"Drive both operand pairs and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    dut.m_a.value = (a if m_a is None else m_a) & MASK32\n    dut.m_b.value = (b if m_b is None else m_b) & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"m_a={int(dut.m_a.value):#x} m_b={int(dut.m_b.value):#x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0, check_state=False,\n                     ready_early=False, integer_operands=None):\n    \"\"\"Check t0 launch, t1..t7 iterations, and t8 consumption or retention.\"\"\"\n    assert int(dut.div_req_ready.value)\n    dut.op.value = op\n    int_a, int_b = (a, b) if integer_operands is Non\n…[25298 of 28370 chars elided by tools/bench/transcript.py; sha256:b0bcc390db189322]…\n       assert not int(dut.div_result_valid.value)\n        assert not int(dut.div_req_ready.value)\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(10):\n            await _tick(dut)\n            assert not int(dut.div_result_valid.value)\n            assert int(dut.div_req_ready.value)\n        await _check_div(dut, ALU_REM, 0x87654321, 13,\n                         (0x87654321 - 13) ^ 0x8da68fa5, ready_early=True,\n                         integer_operands=(42, 0))\n\n\ndef test_alu_altops_runner():\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[str(RTL / name) for name in (\"core_pkg.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1},\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu_altops\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir))\n", "exit_code": 0, "status": "completed"}}
