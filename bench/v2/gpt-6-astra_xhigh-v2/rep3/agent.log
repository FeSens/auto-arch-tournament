{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c 'cat cores/bench/test/test_alu_altops.py'","aggregated_output":"\"\"\"Check the formal arithmetic substitutions with the real divider schedule.\"\"\"\nfrom __future__ import annotations\n\nimport os\n\nimport cocotb\nfrom cocotb.triggers import Timer\nfrom cocotb_tools.runner import get_runner\n\nfrom _helpers import ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU, RTL, TEST_DIR, SIM_BUILD\nfrom test_alu import _setup, _tick\n\n\n@cocotb.test()\nasync def altops_formulas_and_completion_schedule(dut):\n    await _setup(dut)\n    formulas = ((ALU_DIV, 0x7f8529ec), (ALU_DIVU, 0x10e8fd70),\n                (ALU_REM, 0x8da68fa5), (ALU_REMU, 0x3138d0e1))\n    for op, xor_mask in formulas:\n        for a, b in ((0, 0), (0x80000000, 0xffffffff), (0xffffff99, 7),\n                     (0x76543210, 0x12345678), (0x89abcdef, 0)):\n            for hold in (0, 64):\n                assert int(dut.div_req_ready.value)\n                dut.op.value, dut.a.value, dut.b.value = op, a, b\n                dut.div_req_valid.value = 1\n                dut.div_result_ready.value = 1\n                await _tick(dut)  # t0\n                for edge in range(1, 8):\n                    assert not int(dut.div_result_valid.value), edge\n                    assert not int(dut.div_req_ready.value)\n                    # Leave requests asserted and replace their operands:\n                    # the outstanding operation must retain its t0 capture.\n                    dut.op.value = ALU_REMU\n                    dut.a.value, dut.b.value = edge, edge * 13\n                    await _tick(dut)\n                expected = ((a - b) ^ xor_mask) & 0xffffffff\n                assert int(dut.div_result_valid.value)\n                assert not int(dut.busy_q.value) and int(dut.done_q.value)\n                assert int(dut.div_result.value) == expected\n                dut.div_result_ready.value = 0\n                for cycle in range(hold):\n                    dut.a.value, dut.b.value = cycle, cycle + 1\n                    await _tick(dut)\n                    assert int(dut.div_result_valid.value)\n                    assert not int(dut.div_req_ready.value)\n                    assert int(dut.div_result.value) == expected\n                dut.div_result_ready.value = 1\n                await _tick(dut)  # t8, or after the blocked completion\n                assert not int(dut.div_result_valid.value)\n                assert int(dut.div_req_ready.value)\n                dut.div_req_valid.value = 0\n\n\n@cocotb.test()\nasync def altops_reset_cancels_active_and_completed(dut):\n    for edges in (0, 6, 7, 8, 64):\n        await _setup(dut)\n        dut.op.value = ALU_DIV\n        dut.a.value, dut.b.value = 0x80000000, 0xffffffff\n        dut.div_req_valid.value = 1\n        await _tick(dut)\n        dut.div_req_valid.value = 0\n        for _ in range(edges):\n            await _tick(dut)\n        dut.reset.value = 1\n        await Timer(1, \"ns\")\n        assert not int(dut.div_result_valid.value)\n        assert not int(dut.div_req_ready.value)\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(10):\n            await _tick(dut)\n            assert not int(dut.div_result_valid.value)\n            assert int(dut.div_req_ready.value)\n\n\ndef test_alu_altops_runner():\n    runner = get_runner(os.environ.get(\"SIM\", \"verilator\"))\n    build_dir = SIM_BUILD / \"alu_altops\"\n    runner.build(\n        sources=[str(RTL / name) for name in (\"core_pkg.sv\", \"alu.sv\")],\n        hdl_toplevel=\"alu\", build_dir=str(build_dir), always=True,\n        defines={\"RISCV_FORMAL_ALTOPS\": 1},\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(hdl_toplevel=\"alu\", test_module=\"test_alu_altops\",\n                test_dir=str(TEST_DIR), build_dir=str(build_dir))\n","exit_code":0,"status":"completed"}}
