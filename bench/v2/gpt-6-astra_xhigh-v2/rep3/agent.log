{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -c \"python -u - <<'PY'\nfrom tools.eval.gowin import build\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nimport json\nwt=Path.cwd(); root=wt/'cores/bench/generated/micro_probe'\nwith ThreadPoolExecutor(max_workers=2) as ex:\n fs={ex.submit(build,wt,root/n/'rtl','fpga/core_bench_si.sv',1,root/n/'timing'):n for n in ['onehot_fwd','no_x0_gate']}\n for f in as_completed(fs):\n  r=f.result(); n=fs[f]; (root/n/'result.json').write_text(json.dumps(r,indent=2)); print(n,json.dumps(r),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
