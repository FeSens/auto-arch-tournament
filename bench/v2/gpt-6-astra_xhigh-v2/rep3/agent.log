{"type": "item.completed", "item": {"id": "item_55", "type": "command_execution", "command": "/bin/bash -c \"cat cores/bench/generated/r13s2_probe/timing_banked_word.log; sed -n '1,115p' cores/bench/test/test_if_stage.py; sed -n '1,110p' formal/run_all.sh; sed -n '1,100p' tools/eval/formal.py\"", "aggregated_output": "\"\"\"Elastic fetch conservation with arbitrary responses, holds and training.\"\"\"\nimport random\n\nimport cocotb\nfrom cocotb.triggers import Timer\n\nfrom _helpers import run_cocotb\nfrom test_pipeline import ADDI, BEQ, JAL, NOP, _b, _direct_control\n\n\n@cocotb.test()\nasync def fixed_head_queue_conservation(dut):\n    rng = random.Random(0x4f1f0)\n    pc, queue, counters = 0, [], [2] * 16\n    initialized = False\n    accepted = consumed = discarded = 0\n    occupancies, simultaneous, resets, redirects = set(), set(), set(), set()\n    bypasses = held_accepts = stalled_issues = full_holds = 0\n\n    async def step(ready=1, hold=0, insn=None, redirect=0, target=0,\n                   reset=0, train=0, index=0, agree=0):\n        nonlocal pc, initialized, counters, accepted, consumed, discarded\n        nonlocal bypasses, held_accepts, stalled_issues, full_holds\n        if insn is None:\n            insn = ADDI(1 + rng.randrange(31), rng.randrange(32), rng.randrange(-2048, 2048))\n        dut.clock.value = 0\n        dut.reset.value = reset\n        dut.stall.value = hold\n        dut.imem_ready.value = ready\n        dut.imem_data.value = insn\n        dut.redirect.value = redirect\n        dut.redirect_target.value = target\n        dut.train_valid.value = train\n        dut.train_index.value = index\n        dut.train_agree.value = agree\n        await Timer(5, unit=\"ns\")\n        branch, jal, _, predicted_target, _ = _direct_control(insn, pc)\n        prediction = not (predicted_target & 3) and (jal or\n                     (branch and (counters[(pc >> 2) & 15] >> 1 == insn >> 31)))\n        raw = (pc, insn, int(prediction), ready)\n        selected = queue[0] if queue else raw\n        old_count = len(queue)\n        if initialized:\n            assert int(dut.imem_addr.value) == pc\n            assert int(dut.count_q.value) == old_count\n            assert int(dut.out.value) == (selected[0] << 34 | selected[1] << 2 |\n                                           selected[2] << 1 | selected[3])\n            actual = [((int(dut.agree_msb_q.value) >> i) & 1)\n…[10769 of 13841 chars elided by tools/bench/transcript.py; sha256:13dafe6b811d9fc8]…\nenv[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"CORE_NAME\"] = target\n    nret = read_nret(worktree_path / \"cores\" / target / \"core.yaml\")\n    if nret == 1:\n        env[\"WRAPPER\"] = str(worktree_path / \"formal\" / \"wrapper_si.sv\")\n        env[\"CHECKS_CFG\"] = str(worktree_path / \"formal\" / \"checks_si.cfg\")\n    return env\n\n\ndef _cleanup_formal_workdir(worktree_path: Path, core_name: str | None,\n                            work_id: str) -> None:\n    \"\"\"Remove this run's riscv-formal work dir once the tally is parsed.\n\n    run_formal() pins the dir name through FORMAL_WORK_ID, so this removes\n    exactly `formal/riscv-formal/cores/<CORE_NAME>-<work_id>` and nothing\n    else: never a concurrent agent self-check's dir (formal/run_all.sh\n    names those with mktemp and reaps its own leftovers by flock). An SBY\n    work dir runs to 100+ MB, one per slot eval, so it must not be left.\n\n    Guard: BENCH_KEEP_FORMAL_WORKDIR=1 skips cleanup entirely (debugging).\n    formal/last_run-<work_id>.log is kept either way.\n    \"\"\"\n", "exit_code": 0, "status": "completed"}}
