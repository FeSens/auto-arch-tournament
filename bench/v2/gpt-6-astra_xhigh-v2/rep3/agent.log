ady.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & \n…[11406 of 14478 chars elided by tools/bench/transcript.py; sha256:4ac24a0b884d171c]…\n\n    await _check_div(dut, ALU_DIVU, a, b, 0, check_state=True)\n    await _check_div(dut, ALU_REMU, a, b, a, check_state=True)\n\n\n@cocotb.test()\nasync def div_reset_cancels_pending_and_completed(dut):\n    for cycles in (0, 3, 6, 7, 8, 12):\n        await _setup(dut)\n        dut.op.value = ALU_DIV\n        dut.a.value = 0x80000000\n        dut.b.value = 13\n        dut.div_req_valid.value = 1\n        await _tick(dut)\n        dut.div_req_valid.value = 0\n        for _ in range(cycles):\n            await _tick(dut)\n        dut.reset.value = 1\n        await _tick(dut)\n        dut.reset.value = 0\n        for _ in range(10):\n            await _tick(dut)\n            assert not int(dut.div_result_valid.value)\n            assert int(dut.div_req_ready.value)\n        await _check_div(dut, ALU_REM, -103, 7, -5)\n\n\ndef test_alu_runner():\n    \"\"\"pytest entry — runs every @cocotb.test() above under Verilator.\"\"\"\n    run_cocotb(toplevel=\"alu\",\n               sources=[\"core_pkg.sv\", \"alu.sv\"],\n               test_module=\"test_alu\")\n", "exit_code": 0, "status": "completed"}}
