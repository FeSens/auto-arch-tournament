{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, os\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart, parse_iterations\nfrom tools.eval.gowin import parse_reports, summarize\nwt = Path.cwd()\nlines = (Path(os.environ['TMPDIR']) / 'routing-coremark.jsonl').read_text().splitlines()\nmarker = json.loads(lines[-1])\nprint(json.dumps(marker, indent=2))\nassert marker['ebreak'] and not marker['oob'] and marker['bench_bracketed']\niterations = parse_iterations(str(wt))\nvalid, reason = validate_coremark_uart(marker['uart'], iterations)\nassert valid, reason\ncycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nassert cycles > 0\nfp = summarize([dict(place_option=p, **parse_reports(wt / 'cores/bench/generated/timing' / f'gowin_p{p}')) for p in (0, 1, 2)])\nfitness = fp['fmax_mhz'] * 1_000_000 * iterations / cycles\nprint(json.dumps(dict(**fp, cycles=cycles, iterations=iterations, fitness=fitness, improvement_percent=100*(fitness/152.61-1), exceeds_threshold=fitness>159.63006), indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
