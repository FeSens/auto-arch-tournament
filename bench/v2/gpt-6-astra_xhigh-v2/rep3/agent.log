{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/84625fbe/dd8a7533/magnitude_probe')\nshutil.copytree('cores/bench/rtl',root/'rtl',dirs_exist_ok=True)\np=root/'rtl/alu.sv'\ns=p.read_text()\ns=s.replace(\\\"  assign dividend_magnitude = signed_op && m_a[31] ? (32'b0 - m_a) : m_a;\\\\n  assign divisor_magnitude = signed_op && m_b[31] ? (32'b0 - m_b) : m_b;\\\",'''  assign dividend_magnitude[0] = m_a[0];\n  assign divisor_magnitude[0] = m_b[0];\n  for (genvar k = 1; k < 32; k++) begin : magnitude_bit\n    assign dividend_magnitude[k] = m_a[k] \"'^ (signed_op && m_a[31] && (|m_a[k-1:0]));\n    assign divisor_magnitude[k] = m_b[k] ''^ (signed_op && m_b[31] && (|m_b[k-1:0]));\n  end'\"''')\np.write_text(s)\nshutil.copytree('cores/bench/test',root/'test',dirs_exist_ok=True)\nPY\npython -u - <<'PY'\nfrom tools.eval import gowin\nfrom pathlib import Path\nimport json\nroot=Path('/srv/hwebench/tmp/84625fbe/dd8a7533/magnitude_probe')\nresults=gowin.build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'timing.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(gowin.summarize(results),indent=2), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
