(digit * divisor + delta for delta in (-1, 0, 1))\n        for remainder in (0, divisor // 2, divisor - 1):\n            trials.update(32 * remainder + digit for digit in range(32))\n        trials.update(32 * rng.randrange(divisor) + rng.randrange(32) for _ in range(64))\n        for trial in sorted(trials):\n            if not 0 <= trial < 32 * divisor:\n                continue\n            dut.remainder_q.value = trial >> 5\n            dut.quotient_q.value = ((trial & 31) << 27) | rng.getrandbits(27)\n            await Timer(1, \"ns\")\n            digit, remainder = divmod(trial, divisor)\n            selected = int(dut.selected_digit.value)\n            assert selected == (remainder << 5) | digit, (divisor, trial, selected)\n            assert int(dut.digit_select.value) == 1 << digit\n            for k in range(1, 32):\n                assert int(dut.multiple_q[k].value) == k * divisor\n                assert int(dut.difference[k].value) == (trial - k * divisor) & ((1 << 38) - 1)\n\n\n@cocotb.test()\nasync def div_long_completed_backpressure(dut):\n    await _setup(dut)\n192886.03ns INFO     cocotb.regression                  test_alu.div_random_and_corners passed\n192886.03ns INFO     cocotb.regression                  running test_alu.div_launch_prefix_and_registered_completion (29/34)\n                                                            Exercise narrow-prefix borrow and the full-divisor qualification.\n2134449.03ns INFO     cocotb.regression                  test_alu.div_launch_prefix_and_registered_completion passed\n2134449.03ns INFO     cocotb.regression                  running test_alu.div_radix32_thresholds_and_wide_multiples (30/34)\n                                                             Retain every old vector and cover all 32 digits and 37-bit multiples.\nmake: Leaving directory '/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep3/cores/bench/worktrees/hyp-20261002-001-r12s0-hypgen/cores/bench/generated/hyp-r12s0-digitmux/obj_dir'\n- V e