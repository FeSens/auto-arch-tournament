{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"python - <<'PY' > /srv/hwebench/tmp/84625fbe/7d724467/r8s2-simple-probes-sim.log 2>&1\nimport os,subprocess,json\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nfrom tools.eval.fpga import validate_coremark_uart\n\ndef probe(kind):\n root=Path('/srv/hwebench/tmp/84625fbe/7d724467')/f'r8s2-{kind}-probe'\n env=os.environ.copy();env.update(RTL_DIR=str(root/'rtl'),OBJ_DIR=str(root/'obj_dir'),NRET='1')\n r=subprocess.run(['bash','test/cosim/build.sh'],env=env,capture_output=True,text=True)\n if r.returncode: return {'probe':kind,'error':r.stdout[-500:]+r.stderr[-500:]}\n r=subprocess.run([str(root/'obj_dir/cosim_sim'),'bench/programs/coremark.elf','50000000','--bench','--istall','--dstall'],capture_output=True,text=True)\n (root/'coremark.log').write_text(r.stdout+r.stderr)\n d=json.loads(r.stdout.splitlines()[-1]);ok,reason=validate_coremark_uart(d.get('uart',''),10)\n return {'probe':kind,'rc':r.returncode,'crc_ok':ok,'reason':reason,'cycles':d['bench_stop_cycle']-d['bench_start_cycle'],'oob':d['oob'],'ebreak':d['ebreak']}\nwith ThreadPoolExecutor(max_workers=3) as ex:\n for f in as_completed([ex.submit(probe,k) for k in ('static','onebit','queuecentral')]): print(json.dumps(f.result()),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
