{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/84625fbe/aeb2bec3/r6s0_mraw/test/test_alu.py')\ns=p.read_text()+'''\n\n@cocotb.test()\nasync def independent_integer_and_m_operand_ports(dut):\n    await _setup(dut)\n    rng = random.Random(0x600)\n    boundary = [0,1,2,0xffff,0x10000,0x10001,0x7fffffff,\n                0x80000000,0x80000001,0xfffffffe,0xffffffff]\n    pairs = [(a,b) for a in boundary for b in boundary]\n    pairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(1000)]\n    for a,b in pairs:\n        sa = a - (1 << 32) if a >> 31 else a\n        sb = b - (1 << 32) if b >> 31 else b\n        dut.a.value = 123\n        dut.b.value = 456\n        dut.m_a.value = a\n        dut.m_b.value = b\n        for op,expected in [(ALU_MUL,a*b),(ALU_MULH,(sa*sb)>>32),\n                            (ALU_MULHU,(a*b)>>32),(ALU_MULHSU,(sa*b)>>32),\n                            (ALU_ADD,579),(ALU_XOR,123\"'^456)]:\n            dut.op.value = op\n            await Timer(1,\"ns\")\n            assert int(dut.out.value) == expected & MASK32\n    for a,b in pairs[:len(boundary)**2]:\n        for op in [ALU_DIV,ALU_DIVU,ALU_REM,ALU_REMU]:\n            dut.op.value = op\n            dut.a.value = 123\n            dut.b.value = 456\n            dut.m_a.value = a\n            dut.m_b.value = b\n            dut.div_req_valid.value = 1\n            dut.div_result_ready.value = 0\n            await _tick(dut)\n            dut.div_req_valid.value = 0\n            dut.m_a.value = 0x12345678\n            dut.m_b.value = 13\n            for _ in range(7):\n                assert not int(dut.div_result_valid.value)\n                await _tick(dut)\n            assert int(dut.div_result_valid.value)\n            assert int(dut.div_result.value) == _division_reference(op,a,b)\n            dut.div_result_ready.value = 1\n            await _tick(dut)\n            assert not int(dut.div_result_valid.value)\n            dut.div_result_ready.value = 0\n'\"'''\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
