{"type": "item.completed", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/bash -c \"sed -n '916,973p' cores/bench/test/test_pipeline.py && tail -n 4 /srv/hwebench/tmp/84625fbe/7d724467/r8s2-training-probes-timing.log && tail -n 4 /srv/hwebench/tmp/84625fbe/7d724467/r8s2-overlay-probe-tests.log\"", "aggregated_output": "def _check_predictor_trace(trace):\n    \"\"\"Check all 32 learned bits, captured predictions, and every PC edge.\n\n    The model starts at reset and learns from actual registered operands.\n    It uses the current counter for training and its pre-edge value for\n    fetch, including simultaneous aliases. Invalid payload is ignored.\n    \"\"\"\n    counters = [2] * 16\n    previous = None\n    for t in trace:\n        entry, bits = t[\"entry\"], t[\"bits\"]\n        ex_pc, a, b = [(entry >> (bits - 32 * n)) & 0xffffffff for n in (1, 2, 3)]\n        ex_insn = (entry >> 2) & 0xffffffff\n        prediction = (entry >> 1) & 1\n        actual = [(t[\"msb\"] >> i & 1) * 2 + (t[\"lsb\"] >> i & 1) for i in range(16)]\n        assert actual == counters, (t, actual, counters)\n        branch, jal, _, target, _ = _direct_control(t[\"raw\"], t[\"pc\"])\n        predicted = not target & 3 and (jal or (branch and\n                    (counters[(t[\"pc\"] >> 2) & 15] >> 1 == t[\"raw\"] >> 31)))\n        assert t[\"if_id\"] == (t[\"pc\"] << 34 | t[\"raw\"] << 2 |\n                              int(predicted) << 1 | t[\"ready\"]), t\n        branch, jal, jalr, actual_target, taken = _direct_control(ex_insn, ex_pc, a, b)\n        fault = taken and bool(actual_target & 3)\n        advance = bool(entry & 1) and not t[\"stall\"] and (branch or jal or jalr)\n        recover = advance and (bool(taken and not fault) != bool(prediction))\n        assert t[\"redirect\"] == recover, t\n        if recover:\n            assert t[\"target\"] == (actual_target if taken and not fault else ex_pc + 4), t\n        train = advance and branch and not fault\n        assert t[\"train\"] == train, t\n        if previous is not None:\n            p, next_pc, saved_prediction = previous\n            assert t[\"pc\"] == next_pc, (p, t)\n            if p[\"hold\"]:\n                assert entry == p[\"entry\"], \"prediction/payload changed while held\"\n            else:\n                assert entry & 1 == int(p[\"ready\"] and not p[\"load_use\"] and not p[\"redirect\"])\n                if not p[\"load_use\"]:\n                    assert pred\n…[2951 of 6023 chars elided by tools/bench/transcript.py; sha256:cf32645293ada8f4]…\n_val_15_s0\", \"to\": \"cpu/u_ex/u_alu/mul_uu_63_s0\", \"slack_ns\": -11.827, \"arrival_ns\": 21.932, \"logic_cells\": 23, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_ex\", \"cpu/u_id\"]}, {\"from\": \"cpu/u_id/reg_q.rs1_val_15_s0\", \"to\": \"cpu/u_ex/u_alu/mul_ss_63_s0\", \"slack_ns\": -11.809, \"arrival_ns\": 21.915, \"logic_cells\": 22, \"modules\": [\"clock_ibuf\", \"cpu/u_ex\", \"cpu/u_if\", \"cpu/u_ex\", \"cpu/u_id\"]}], \"probe\": \"r8s2-queued-probe\"}\n                                                        ************************************************************************************************************************************\n                                                        ** TESTS=30 PASS=30 FAIL=0 SKIP=0                                                          61130.03           0.88      69403.66  **\n                                                        ************************************************************************************************************************************\n- :0: Verilog $finish\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nfor kind in ('static','onebit','queuecentral'):\n root=Path('/srv/hwebench/tmp/84625fbe/7d724467')/f'r8s2-{kind}-probe'\n rtl=root/'rtl';shutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\n p=rtl/'if_stage.sv';s=p.read_text()\n if kind in ('static','onebit'):\n  start=s.index('  // Two bitplanes hold'); end=s.index('  // Raw predecode',start)\n  s=s[:start]+('''  always_ff @(posedge clock) begin\n    if (reset) agree_msb_q <= 16'hffff;\n    else if (train_valid) agree_msb_q[train_index] <= train_agree;\n  end\n\n''' if kind=='onebit' else '')+s[end:]\n  s=s.replace('  logic [1:0] train_counter, train_next;','')\n  s=s.replace('  logic [15:0] agree_msb_q, agree_lsb_q;', '  logic [15:0] agree_msb_q;' if kind=='onebit' else '')\n  if kind=='static':s=s.replace('(agree_msb_q[pc[5:2]] == imem_data[31])','imem_data[31]')\n else:\n  s=s.replace('train_valid','update_valid').replace('train_index','update_index').replace('train_agree','update_agree')\n  s=s.replace('input  logic              update_valid','input  logic              train_valid').replace('input  logic [3:0]        update_index','input  logic [3:0]        train_index').replace('input  logic              update_agree','input  logic              train_agree')\n  s=s.replace('  // Two bitplanes hold','''  logic update_valid, update_agree;\n  logic [3:0] update_index;\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      update_valid <= 1'b0;\n      update_index <= 4'b0;\n      update_agree <= 1'b0;\n    end else begin\n      update_valid <= train_valid;\n      update_index <= train_index;\n      update_agree <= train_agree;\n    end\n  end\n\n  // Two bitplanes hold''')\n p.write_text(s)\nPY\npython - <<'PY' > /srv/hwebench/tmp/84625fbe/7d724467/r8s2-simple-probes-timing.log 2>&1\nfrom pathlib import Path\nfrom tools.eval.gowin import build\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nimport json\nroots=[Path('/srv/hwebench/tmp/84625fbe/7d724467')/f'r8s2-{kind}-probe' for kind in ('static','onebit','queuecentral')]\nwith ThreadPoolExecutor(max_workers=3) as ex:\n fs={ex.submit(build,Path.cwd(),root/'rtl','fpga/core_bench_si.sv',0,root/'gowin_p0'):root.name for root in roots}\n for f in as_completed(fs):\n  r=f.result();r['probe']=fs[f];print(json.dumps(r),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
