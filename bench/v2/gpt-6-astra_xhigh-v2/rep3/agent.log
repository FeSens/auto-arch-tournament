\"m_a={int(dut.m_a.value):#x} m_b={int(dut.m_b.value):#x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0, check_state=False,\n                     ready_early=False, integer_operands=None):\n    \"\"\"Check t0 launch, t1..t7 iterations, and t8 consumption or retention.\"\"\"\n    as\n…[4328 of 7400 chars elided by tools/bench/transcript.py; sha256:bcf231aaef0555a0]…\n4)]\n    for a, b in pairs:\n        signed_a = a - (1 << 32) if a >> 31 else a\n        signed_b = b - (1 << 32) if b >> 31 else b\n        expected = ((ALU_ADD, a + b), (ALU_SUB, a - b),\n                    (ALU_AND, a & b), (ALU_OR, a | b), (ALU_XOR, a ^ b),\n                    (ALU_SLT, int(signed_a < signed_b)), (ALU_SLTU, int(a < b)),\n                    (ALU_SLL, a << (b & 31)), (ALU_SRL, a >> (b & 31)),\n                    (ALU_SRA, signed_a >> (b & 31)), (ALU_LUI, b))\n        for op, result in expected:\n            for m_a, m_b in ((a ^ MASK32, b ^ MASK32),\n                             (a ^ 0x80000001, b ^ 0x55555555)):\n                await _check(dut, op, a, b, result, m_a=m_a, m_b=m_b)\n        # The combinational default remains zero, including DIV/REM opcodes.\n        for op in range(ALU_DIV, 32):\n            await _check(dut, op, a, b, 0, m_a=a ^ MASK32, m_b=b ^ MASK32)\n\n\n@cocotb.test()\nasync def integer_operand_isolation(dut):\n    await _setup(dut)\n    await _check_integer_operand_isolation(dut)\n\n\n", "exit_code": 0, "status": "completed"}}
