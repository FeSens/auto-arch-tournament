{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json\nimport os\nimport subprocess\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart, parse_iterations\nsim = str(Path('cores/bench/obj_dir/cosim_sim').resolve())\nelf = str(Path('bench/programs/coremark.elf').resolve())\niterations = parse_iterations('.')\ndef check(seed):\n    result = subprocess.run([sim, elf, '50000000', '--bench', '--istall', '--dstall', '--seed', str(seed)], capture_output=True, text=True, timeout=600)\n    (Path(os.environ['TMPDIR']) / f'nibble-coremark-{seed:x}.jsonl').write_text(result.stdout)\n    records = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]\n    marker = records[-1]\n    assert result.returncode == 0, (seed, result.returncode, result.stderr)\n    assert marker['ebreak'] and not marker['oob'], marker\n    assert records[-2]['insn'] == 0x00100073, records[-2]\n    assert marker['bench_bracketed'], marker\n    cycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\n    assert cycles > 0, marker\n    valid, reason = validate_coremark_uart(marker['uart'], iterations)\n    assert valid, reason\n    assert 'Correct operation validated.' in marker['uart'], marker['uart']\n    if seed == 0xdeadbeef:\n        assert cycles == 3978988, cycles\n    return {'seed': hex(seed), 'passed': True, 'cycles': cycles, 'iterations': iterations, 'iter_per_cycle': iterations / cycles, 'start': marker['bench_start_cycle'], 'stop': marker['bench_stop_cycle'], 'crc_uart_bounds_markers': 'pass'}\nwith ThreadPoolExecutor(max_workers=2) as pool:\n    results = list(pool.map(check, (0xdeadbeef, 1)))\nprint(json.dumps(results, indent=2))\n(Path(os.environ['TMPDIR']) / 'nibble-coremark-validation.json').write_text(json.dumps(results, indent=2) + '\\\\n')\nPY\"","aggregated_output":"[\n  {\n    \"seed\": \"0xdeadbeef\",\n 