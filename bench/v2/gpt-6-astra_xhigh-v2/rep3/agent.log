{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport random\nMASK = (1 << 32) - 1\n\ndef proposed(a, b, signed, remainder):\n    sa = a - (1 << 32) if signed and a >> 31 else a\n    sb = b - (1 << 32) if signed and b >> 31 else b\n    aa, dd = abs(sa), abs(sb)\n    prefix = aa >> 28\n    q4, r4 = 0, prefix\n    if 0 < dd < 16:\n        q4, r4 = 0, 0\n        for bit in range(3, -1, -1):\n            trial = (r4 << 1) | ((prefix >> bit) & 1)\n            diff = (trial - dd) & 31\n            accept = not (diff & 16)\n            r4 = diff if accept else trial\n            q4 = (q4 << 1) | accept\n    q, r = ((aa << 4) | q4) & MASK, r4\n    for iteration in range(7):\n        for step in range(4):\n            trial = (r << 1) | (q >> 31)\n            take = trial >= dd\n            r = (trial - dd if take else trial) & MASK\n            q = ((q << 1) | take) & MASK\n    if not dd:\n        return a if remainder else MASK\n    if remainder:\n        return (-r if sa < 0 else r) & MASK\n    return (-q if (sa < 0) \"'!= (sb < 0) else q) & MASK\n\ndef ref(a, b, signed, remainder):\n    if not b:\n        return a if remainder else MASK\n    a = a - (1 << 32) if signed and a >> 31 else a\n    b = b - (1 << 32) if signed and b >> 31 else b\n    q = abs(a) // abs(b)\n    if (a < 0) != (b < 0):\n        q = -q\n    return (a - q * b if remainder else q) & MASK\n\nrng = random.Random(0xD171DE)\nedge = list(range(18)) + [MASK, MASK - 1, 0x80000000, 0x80000001, 0x7fffffff]\nedge += [((1 << i) + delta) & MASK for i in range(32) for delta in (-1, 0, 1)]\npairs = [(a, b) for a in edge for b in edge]\npairs += [((prefix << 28) | tail, b) for prefix in range(16) for tail in (0, 1, 0xfffffff) for b in edge]\npairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(10000)]\ncount = 0\nfor a, b in pairs:\n    for signed in (False, True):\n        for remainder in (False, True):\n            got = proposed(a, b, signed, remainder)\n            expected = ref(a, b, signed, remainder)\n            assert got == expected, (hex(a), hex(b), signed, remainder, hex(got), hex(expected))\n            count += 1\nprint(f'\"'Proposed launch-prefix and seven-iteration arithmetic model passed {count} cases.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
