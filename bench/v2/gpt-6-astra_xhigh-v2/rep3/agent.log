{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nimport sys,time,collections,json\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM();cpu.load_elf('bench/programs/coremark.elf')\non=False;counts=collections.Counter();sites=collections.Counter();tgts=collections.defaultdict(collections.Counter);sizes=(4,8,16,32,64);tables={s:[None]*s for s in sizes};correct=collections.Counter();total=0;start=time.time();branchtrace=[];jalrtrace=[]\nfor i in range(10000000):\n r=cpu.step();op=r['insn']&127\n if r['mem_wmask'] and r['mem_addr']==0x10000100:on=True; print('start',i,flush=True)\n if r['mem_wmask'] and r['mem_addr']==0x10000104:break\n if on:\n  counts[op]+=1\n  if op==0x67:\n   pc,npc=r['pc'],r['npc'];sites[pc]+=1;tgts[pc][npc]+=1;jalrtrace.append((pc,npc,r['insn']))\n  if op==0x63: branchtrace.append((r['pc'],r['insn'],r['npc']\"'!=(r['\"'pc']+4)))\n if op==0x67:\n  pc,npc=r['pc'],r['npc']\n  for s,table in tables.items():\n   idx=(pc>>2)&(s-1)\n   if on and table[idx]==(pc,npc):correct[s]+=1\n   table[idx]=(pc,npc)\n if r['insn']==0x00100073:break\n if i%500000==0: print('progress',i,'elapsed',time.time()-start,flush=True)\nprint(json.dumps({'retired':sum(counts.values()),'opcounts':dict(counts),'target_table_correct':dict(correct),'jalr_sites':[(hex(pc),n,[(hex(t),v) for t,v in tgts[pc].most_common()]) for pc,n in sites.most_common()],'elapsed':time.time()-start},indent=2))\nimport pathlib\np=pathlib.Path('cores/bench/generated');p.mkdir(exist_ok=True)\n(p/'predictor_profile.json').write_text(json.dumps({'branches':branchtrace,'jalrs':jalrtrace,'counts':dict(counts),'table_correct':dict(correct)}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
