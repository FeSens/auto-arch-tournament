n    env[\"RTL_DIR\"] = f\"cores/{target}/rtl\"\n    env[\"OBJ_DIR\"] = f\"cores/{target}/obj_dir\"\n    env[\"NRET\"] = str(read_nret(worktree_path / \"cores\" / target / \"core.yaml\"))\n    return env\n\n# Stall modes for the full-trace comparison. The stalled mode uses the same\n# bus backpressure as the fitness run, so logic that only acts while a\n# memory port stalls (which V2 now times and scores) is trace-checked too.\nTRACE_STALL_MODES = ((), (\"--istall\", \"--dstall\"))\n\n\ndef run_one(elf: Path, sim\n…[11685 of 14757 chars elided by tools/bench/transcript.py; sha256:90d6f0b3ef2a72f1]…\nesults],\ntools/eval/gowin.py:199:def main(argv=None) -> int:\ntools/eval/gowin.py:202:    import argparse, json\ntools/eval/gowin.py:204:    ap = argparse.ArgumentParser()\ntools/eval/gowin.py:209:                    help=\"build every placement option the evaluator uses (default: option 0 only)\")\ntools/eval/gowin.py:216:        if r[\"placement_failed\"]:\ntools/eval/gowin.py:226:    if len(res) > 1 and all(not r[\"placement_failed\"] for r in res):\ntools/eval/gowin.py:228:    return 0 if all(not r[\"placement_failed\"] for r in res) else 1\ntools/eval/gowin.py:231:if __name__ == \"__main__\":\nlrwxrwxrwx 1 nobody nogroup 66 Oct  2 17:37 formal/riscv-formal -> /srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep3/formal/riscv-formal\nls: cannot access '.toolchain': No such file or directory\n/srv/hwebench/tmp/84625fbe/69bc2799\n/srv/hwebench/toolchain/oss-cad-suite/bin/yosys\n/srv/hwebench/toolchain/oss-cad-suite/bin/sby\n/srv/hwebench/toolchain/oss-cad-suite/bin/bitwuzla\n M cores/bench/rtl/ex_stage.sv\n?? cores/bench/formal-local.log\n", "exit_code": 0, "status": "completed"}}
