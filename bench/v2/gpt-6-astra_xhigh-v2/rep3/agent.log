k[3:0]};\n  end\n  assign first_pair = (first_mask[0] | first_mask[1] | first_mask[2] | first_mask[3]) |\n                      (first_mask[4] | first_mask[5] | first_mask[6] | first_mask[7]) |\n                      (first_mask[8] | first_mask[9] | first_mask[10] | first_mask[11]) |\n                      (first_mask[12] | first_mask[13] | first_mask[14] | first_mask[15]);\n  assign second_pair = (second_mask[0] | second_mask[1] | second_mask[2] | second_mask[3]) |\n                       (second_mask[4] | second_mask[5] | second_mask[6] | second_mask[7]) |\n                       (second_mask[8] | second_mask[9] | second_mask[10] | second_mask[11]) |\n                       (second_mask[12] | second_mask[13] | second_mask[14] | second_mask[15]);\n\n'\"'''+s[a:]\na=s.index('      quotient_q <= {dividend_magnitude[27:0],')\nb=s.index('      quotient_negative_q <=',a)\ns=s[:a]+'''      quotient_q <= dividend_magnitude;\n      remainder_q <= 32'b0;\n'''+s[b:]\na=s.index('    end else if (busy_q) begin\\\\n      quotient_q <=')\nb=s.index('\\\\n    end\\\\n  end\\\\n\"'`endif'\"',a)\ns=s[:a]+'''    end else if (busy_q) begin\n      if (iteration_q == 3'b0) begin\n        quotient_q <= {quotient_q[23:0],first_pair[3:0],second_pair[3:0]};\n        remainder_q <= {24'b0,second_pair[11:4]};\n      end else begin\n        quotient_q <= {quotient_q[27:0], selected_digit[3:0]};\n        remainder_q <= selected_digit[35:4];\n      end'''+s[b:]\np.write_text(s)\nPY\npython -u - <<'PY'\nfrom tools.eval import gowin\nfrom pathlib import Path\nimport json\nroot=Path('/srv/hwebench/tmp/84625fbe/dd8a7533/prefix_pair_probe')\nresults=gowin.build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'timing.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(gowin.summarize(results),indent=2), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
