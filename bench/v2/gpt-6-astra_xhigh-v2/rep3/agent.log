{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/bash -c \"sed -n '1,300p' cores/bench/test/test_alu.py\"", "aggregated_output": "\"\"\"Unit tests for rtl/alu.sv.\n\nInteger and multiply operations remain combinational. DIV/REM use the\nclocked eight-iteration request/result interface, with sticky completion.\n\"\"\"\nfrom __future__ import annotations\n\nimport cocotb\nimport random\nfrom cocotb.triggers import Timer\n\nfrom _helpers import (\n    ALU_ADD, ALU_SUB, ALU_AND, ALU_OR, ALU_XOR,\n    ALU_SLT, ALU_SLTU, ALU_SLL, ALU_SRL, ALU_SRA,\n    ALU_LUI,\n    ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU,\n    ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU,\n    run_cocotb,\n)\n\nMASK32 = 0xFFFFFFFF\n\n\nasync def _setup(dut):\n    dut.clock.value = 0\n    dut.reset.value = 1\n    dut.op.value = ALU_ADD\n    dut.a.value = 0\n    dut.b.value = 0\n    dut.div_req_valid.value = 0\n    dut.div_result_ready.value = 0\n    await _tick(dut)\n    dut.reset.value = 0\n    await Timer(1, \"ns\")\n\n\nasync def _tick(dut):\n    dut.clock.value = 0\n    await Timer(5, \"ns\")\n    dut.clock.value = 1\n    await Timer(5, \"ns\")\n    dut.clock.value = 0\n\n\nasync def _check(dut, op, a, b, expected):\n    \"\"\"Drive op/a/b and check the combinational result.\"\"\"\n    dut.op.value = op\n    dut.a.value  = a & MASK32\n    dut.b.value  = b & MASK32\n    await Timer(1, \"ns\")\n    actual = int(dut.out.value) & MASK32\n    assert actual == (expected & MASK32), (\n        f\"op={op} a=0x{a & MASK32:08x} b=0x{b & MASK32:08x} \"\n        f\"expected=0x{expected & MASK32:08x} got=0x{actual:08x}\"\n    )\n\n\nasync def _check_div(dut, op, a, b, expected, hold=0):\n    \"\"\"Check the final-cycle bypass and retention without keeping inputs stable.\"\"\"\n    assert int(dut.div_req_ready.value)\n    dut.op.value = op\n    dut.a.value = a & MASK32\n    dut.b.value = b & MASK32\n    dut.div_req_valid.value = 1\n    dut.div_result_ready.value = 0\n    await _tick(dut)  # request acceptance; no quotient step on this edge\n    dut.div_req_valid.value = 0\n    for step in range(7):\n        assert not int(dut.div_result_valid.value), f\"early completion at {step}\"\n        assert not int(dut.div_req_ready.value)\n        # The divider and its RVFI operands must not depend on live\n…[6103 of 9175 chars elided by tools/bench/transcript.py; sha256:8dfd9763c9357539]…\nvides(dut):\n    \"\"\"Verify the FSM resets cleanly between consecutive iterative\n    divides — no carry-over of operands or state from the previous op.\n    \"\"\"\n    await _setup(dut)\n    # Every operation has the same eight-iteration latency.\n    await _check_div(dut, ALU_DIVU, 100, 7, 14)\n    await _check_div(dut, ALU_DIVU, 0xFFFFFFFF, 2, 0x7FFFFFFF)\n    await _check_div(dut, ALU_DIV, 0xFFFFFFFC, 2, 0xFFFFFFFE)  # -4/2 = -2\n    await _check_div(dut, ALU_REM, 10, 3, 1)\n    await _check_div(dut, ALU_REMU, 7, 3, 1)\n\n\n@cocotb.test()\nasync def div_random_and_corners(dut):\n    await _setup(dut)\n    rng = random.Random(0xD171DE)\n    corners = [0, 1, 2, 3, 7, 0x7fffffff, 0x80000000, 0x80000001,\n               0xfffffffe, 0xffffffff, 0x55555555, 0xaaaaaaaa]\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        pairs = [(a, b) for a in corners for b in corners]\n        pairs += [(rng.getrandbits(32), rng.getrandbits(32)) for _ in range(128)]\n        pairs += [(rng.getrandbits(32), 1 << bit) for bit in range(32)]\n", "exit_code": 0, "status": "completed"}}
