{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nimport random\nM=(1<<32)-1\n\ndef digit(r,q,d):\n t=(r<<2)|(q>>30)\n xs=[(t-k*d)&((1<<35)-1) for k in (1,2,3)]\n g1,g2,g3=[not (x>>34) for x in xs]\n sels=[not g1,g1 and not g2,g2 and not g3,g3]\n assert sum(sels)==1\n out_r=0\n for s,x in zip(sels,[t,*xs]):\n  if s: out_r |= x&M\n out_q=((q<<2)|((int(g2)<<1)|int(g3 or (g1 and not g2))))&M\n if d: assert out_r<d\n return out_r,out_q\n\ndef divide(a,d):\n r,q=0,a\n for _ in range(8):\n  r,q=digit(r,q,d)\n  r,q=digit(r,q,d)\n return (q,r) if d else (M,a)\n\nrng=random.Random(0x204)\nedges=[0,1,2,3,7,0x3fffffff,0x40000000,0x40000001,0x55555555,0x7fffffff,0x80000000,0x80000001,0xfffffffe,M]\npairs=[(a,d) for a in edges for d in edges]\nfor d in edges:\n for k in (1,2,3):\n  for offset in (-1,0,1):\n   a=k*d+offset\n   if 0<=a<=M: pairs.append((a,d))\npairs += [(rng.getrandbits(32),rng.getrandbits(32)) for _ in range(20000)]\nfor a,d in pairs:\n q,r=divide(a,d)\n assert (q,r)==((a//d,a%d) if d else (M,a)),(a,d,q,r)\n sa=a-(1<<32) if a>>31 else a\n sd=d-(1<<32) if d>>31 else d\n q,r=divide(abs(sa),abs(sd))\n if not sd: actual=(M,a)\n else: actual=(((-q if (sa<0)\"'!=(sd<0) else q)&M),((-r if sa<0 else r)&M))\n if not sd: expected=(M,a)\n else:\n  eq=abs(sa)//abs(sd)\n  if (sa<0)!=(sd<0): eq=-eq\n  expected=(eq&M,(sa-eq*sd)&M)\n assert actual==expected,(a,d,actual,expected)\nprint(f'\"'Proposal arithmetic model agrees with unsigned and signed quotient/remainder references for {len(pairs)} operand pairs; this is not an RTL or timing measurement.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
