{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('cores/bench/rtl'); base=Path('cores/bench/generated/r13s1_probe')\n# Save the measured full operand preparation trial, then construct two isolated variants.\nfor n in ['core_pkg.sv','id_stage.sv','ex_stage.sv']:\n (base/(n+'.operands')).write_text((root/n).read_text())\nfor variant in ['operand_b','pc_prepare']:\n dest=Path('cores/bench/generated')/('r13s1_'+variant+'_rtl');dest.mkdir(parents=True,exist_ok=True)\n for p in root.glob('*.sv'):\n  orig=base/(p.name+'.original')\n  s=orig.read_text() if orig.exists() else p.read_text()\n  if variant=='operand_b':\n   if p.name=='core_pkg.sv': s=s.replace('    logic [31:0] rs2_val;\\\\n    logic [31:0] imm;', '    logic [31:0] rs2_val;\\\\n    logic [31:0] alu_b;\\\\n    logic [31:0] imm;')\n   if p.name=='id_stage.sv': s=s.replace('        reg_q.rs2_val  <= rs2_resolved;', '        reg_q.rs2_val  <= rs2_resolved;\\\\n        reg_q.alu_b    <= dec_alu_src ? imm : rs2_resolved;')\n   if p.name=='ex_stage.sv': s=s.replace('    alu_b = in.ctrl.alu_src  ? in.imm : rs2;', '    alu_b = in.alu_b;')\n  else:\n   if p.name=='core_pkg.sv': s=s.replace('    logic [31:0] rs2_val;\\\\n    logic [31:0] imm;', '    logic [31:0] rs2_val;\\\\n    logic [31:0] pc_sequential;\\\\n    logic [31:0] pc_relative;\\\\n    logic [31:0] imm;')\n   if p.name=='id_stage.sv': s=s.replace('        reg_q.rs2_val  <= rs2_resolved;', '        reg_q.rs2_val  <= rs2_resolved;\\\\n        reg_q.pc_sequential <= in.pc + 32\\\\'d4;\\\\n        reg_q.pc_relative <= in.pc + imm;')\n   if p.name=='ex_stage.sv': s=s.replace('in.pc + 32\\\\'d4','in.pc_sequential').replace('in.pc + in.imm','in.pc_relative')\n  (dest/p.name).write_text(s)\n# Restore the working RTL while the isolated timing builds run.\nfor n in ['core_pkg.sv','id_stage.sv','ex_stage.sv']:\n (root/n).write_text((base/(n+'.original')).read_text())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
