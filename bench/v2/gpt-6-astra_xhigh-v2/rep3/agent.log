{"type": "item.started", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport json\nroot=Path('cores/bench/rtl')\nbackup=Path('/srv/hwebench/tmp/84625fbe/758d58de/r11s1_probe/rtl_backup.json')\nassert not backup.exists()\nfiles={p.name:p.read_text() for p in root.glob('*.sv')}\nbackup.write_text(json.dumps(files))\nalu=files['alu.sv']\nalu=alu.replace('output logic [31:0] out,','output logic [31:0] out,\\\\n  output logic [65:0] mul_product,')\na=alu.index('  // 64-bit products')\nb=alu.index('    case (op)',a)\nalu=alu[:a]+'''\"'`ifdef RISCV_FORMAL_ALTOPS\n  logic [31:0] alt_mul;\n  always_comb begin\n    case (op)\n      ALU_MUL:    alt_mul = (m_a + m_b) ''^ 32'\"'h5876063e;\n      ALU_MULH:   alt_mul = (m_a + m_b) \"'^ 32'\"'hf6583fb7;\n      ALU_MULHU:  alt_mul = (m_a + m_b) \"'^ 32'\"'h949ce5e8;\n      ALU_MULHSU: alt_mul = (m_a - m_b) \"'^ 32'\"'hecfbe137;\n      default: alt_mul = 32'b0;\n    endcase\n  end\n  assign mul_product = {2'b0,alt_mul,alt_mul};\n\"'`else\n  logic signed [32:0] mul_a, mul_b;\n  assign mul_a = $signed({((op == ALU_MULH || op == ALU_MULHSU) && m_a[31]),m_a});\n  assign mul_b = $signed({((op == ALU_MULH) && m_b[31]),m_b});\n  assign mul_product = mul_a * mul_b;\n`endif\n  always_comb begin\n    shamt = b[4:0];\n\n'\"'''+alu[b:]\na=alu.index('      // M-extension.')\nb=alu.index('      default:  out',a)\nalu=alu[:a]+alu[b:]\na=alu.index('  logic [31:0] divisor_q')\nb=alu.index('\\\\n\"'`endif'\"\\\\n\\\\n  // Identical',a)\nnew='''  logic [31:0] divisor_q, normalized_a_q, dividend_q, quotient_q, remainder_q;\n  logic quotient_negative_q, remainder_negative_q, want_remainder_q;\n  logic zero_divisor_q, signed_op;\n  logic [31:0] dividend_magnitude, divisor_magnitude;\n  logic small_divisor;\n  logic [1:0] prefix_quotient [0:2];\n  logic [1:0] prefix_remainder [0:2];\n  logic [1:0] prefix_shifted [0:1];\n  logic [2:0] prefix_trial [0:1];\n  logic [36:0] divisor_wide;\n  logic [36:0] multiple_q [1:31];\n  logic [36:0] digit_trial;\n  /* verilator lint_off UNUSEDSIGNAL */\n  logic [37:0] difference [1:31];\n  /* verilator lint_on UNUSEDSIGNAL */\n  logic [31:1] subtract_ok;\n  logic [31:0] digit_select;\n  logic [36:0] masked_digit [0:31];\n  logic [36:0] selected_digit;\n  logic [31:0] magnitude;\n  logic negate_result;\n\n  assign signed_op = (op == ALU_DIV || op == ALU_REM);\n  assign dividend_magnitude = signed_op && m_a[31] ? (32'b0-m_a) : m_a;\n  assign divisor_magnitude = signed_op && m_b[31] ? (32'b0-m_b) : m_b;\n  assign small_divisor = divisor_q[31:2] == 30'b0 && divisor_q[1:0] \"'!= 2'\"'b0;\n  assign prefix_quotient[0] = normalized_a_q[31:30];\n  assign prefix_remainder[0] = 2'b0;\n  for (genvar step=0; step<2; step++) begin : prefix_step\n    assign prefix_shifted[step] = {prefix_remainder[step][0],prefix_quotient[step][1]};\n    assign prefix_trial[step] = {1'b0,prefix_shifted[step]} - {1'b0,divisor_q[1:0]};\n    assign prefix_remainder[step+1] = prefix_trial[step][2] ? prefix_shifted[step] : prefix_trial[step][1:0];\n    assign prefix_quotient[step+1] = {prefix_quotient[step][0],\"'!prefix_trial[step][2]};\n  end\n  assign divisor_wide = {5'\"'b0,divisor_q};\n  assign multiple_q[1] = divisor_wide;\n'''\nfor k in range(2,32):\n n=k; shift=0; terms=[]\n while n:\n  if n&1:\n   d=2-(n%4);terms.append((d,shift));n-=d\n  n//=2;shift+=1\n positives=[f'(divisor_wide << {s})' for d,s in terms if d>0]\n negatives=[f'(divisor_wide << {s})' for d,s in terms if d<0]\n expr=' + '.join(positives)+''.join(' - '+t for t in negatives)\n new+=f'''  always_ff @(posedge clock) begin\n    if (reset) multiple_q[{k}] <= 37'b0;\n    else if (busy_q && iteration_q == 3'd0) multiple_q[{k}] <= {expr};\n  end\n'''\nnew+='''  assign digit_trial = {remainder_q,quotient_q[31:27]};\n  assign digit_select[0] = \"'!subtract_ok[1];\n  assign masked_digit[0] = {37{digit_select[0]}} & {digit_trial[31:0],5'\"'b0};\n  for (genvar k=1; k<=31; k++) begin : digit_candidate\n    assign difference[k] = {1'b0,digit_trial} - {1'b0,multiple_q[k]};\n    assign subtract_ok[k] = \"'!difference[k][37];\n    if (k==31) begin : last_digit\n      assign digit_select[k] = subtract_ok[k];\n    end else begin : middle_digit\n      assign digit_select[k] = subtract_ok[k] && !subtract_ok[k+1];\n    end\n    assign masked_digit[k] = {37{digit_select[k]}} & {difference[k][31:0],k[4:0]};\n  end\n'\"'''\nprev='masked_digit'\nfor width in (16,8,4,2):\n name=f'digit_or{width}'\n new+=f'''  logic [36:0] {name} [0:{width-1}];\n  for (genvar k=0; k<{width}; k++) begin : select{width}\n    assign {name}[k] = {prev}[2*k] | {prev}[2*k+1];\n  end\n'''\n prev=name\nnew+='''  assign selected_digit = digit_or2[0] | digit_or2[1];\n  always_comb begin\n    magnitude = want_remainder_q ? remainder_q : quotient_q;\n    negate_result = want_remainder_q ? remainder_negative_q : quotient_negative_q;\n    div_result = negate_result ? (32'b0-magnitude) : magnitude;\n    if (zero_divisor_q) div_result = want_remainder_q ? dividend_q : 32'hffffffff;\n  end\n  always_ff @(posedge clock) begin\n    if (reset) begin\n      divisor_q <= 0; normalized_a_q <= 0; dividend_q <= 0;\n      quotient_q <= 0; remainder_q <= 0;\n      quotient_negative_q <= 0; remainder_negative_q <= 0;\n      want_remainder_q <= 0; zero_divisor_q <= 0;\n    end else if (div_req_valid && div_req_ready) begin\n      divisor_q <= divisor_magnitude;\n      normalized_a_q <= dividend_magnitude;\n      dividend_q <= m_a;\n      quotient_negative_q <= signed_op && (m_a[31]\"'^m_b[31]);\n      remainder_negative_q <= signed_op && m_a[31];\n      want_remainder_q <= (op==ALU_REM || op==ALU_REMU);\n      zero_divisor_q <= (m_b==32'\"'b0);\n    end else if (busy_q && iteration_q == 3'd0) begin\n      quotient_q <= {normalized_a_q[29:0],small_divisor ? prefix_quotient[2] : 2'b0};\n      remainder_q <= {30'b0,small_divisor ? prefix_remainder[2] : normalized_a_q[31:30]};\n    end else if (busy_q) begin\n      quotient_q <= {quotient_q[26:0],selected_digit[4:0]};\n      remainder_q <= selected_digit[36:5];\n    end\n  end\n'''\nalu=alu[:a]+new+alu[b:]\n(root/'alu.sv').write_text(alu)\ns=files['core_pkg.sv'].replace('  // EX/MEM register payload.','  // EX/MEM register payload.')\ns=s.replace('    logic [31:0] write_data;','    logic [65:0] mul_product;\\\\n    logic is_multiply;\\\\n    logic mul_high;\\\\n    logic [31:0] write_data;')\n(root/'core_pkg.sv').write_text(s)\ns=files['ex_stage.sv']\ns=s.replace('  output logic               execute_wait,','  output logic               execute_wait,\\\\n  output logic               is_multiply,')\ns=s.replace('  logic [31:0] alu_result;','  logic [31:0] alu_result;\\\\n  logic [65:0] mul_product;\\\\n  assign is_multiply = in.valid && \"'!in.ctrl.is_illegal && (in.ctrl.alu_op >= ALU_MUL && in.ctrl.alu_op <= ALU_MULHSU);'\"')\ns=s.replace('    .out (alu_result),','    .out (alu_result),\\\\n    .mul_product (mul_product),')\ns=s.replace('assign fwd_w_en = in.valid && ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read'\"','assign fwd_w_en = in.valid && ctrl_with_trap.reg_write && \"'!in.ctrl.mem_read && !is_multiply'\"')\ns=s.replace('      reg_q.pc            <= in.pc;','      reg_q.pc            <= in.pc;\\\\n      reg_q.mul_product <= mul_product;\\\\n      reg_q.is_multiply <= is_multiply;\\\\n      reg_q.mul_high <= in.ctrl.alu_op \"'!= ALU_MUL;'\"')\n(root/'ex_stage.sv').write_text(s)\ns=files['mem_stage.sv'].replace('  logic [31:0] wdata_rep;','  logic [31:0] wdata_rep;\\\\n  logic [31:0] execution_result;\\\\n  assign execution_result = in.is_multiply ? (in.mul_high ? in.mul_product[63:32] : in.mul_product[31:0]) : in.alu_result;')\ns=s.replace('in.ctrl.mem_to_reg ? load_data : in.alu_result','in.ctrl.mem_to_reg ? load_data : execution_result')\ns=s.replace('reg_q.alu_result <= in.alu_result','reg_q.alu_result <= execution_result')\n(root/'mem_stage.sv').write_text(s)\ns=files['core.sv'].replace('  logic       execute_wait;','  logic       execute_wait;\\\\n  logic       ex_multiply;')\ns=s.replace('    .execute_wait    (execute_wait),','    .execute_wait    (execute_wait),\\\\n    .is_multiply     (ex_multiply),')\ns=s.replace('.id_ex_mem_read (id_ex_w.ctrl.mem_read)', '.id_ex_mem_read (id_ex_w.ctrl.mem_read || ex_multiply)')\n(root/'core.sv').write_text(s)\nprint('Temporary M-unit probe written; original RTL backed up.')\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}
