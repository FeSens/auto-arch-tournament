{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/conftest.py; sed -n '1,170p' cores/bench/test/_helpers.py; rg -n 'test:|pytest|formal:|cosim|coremark|timing' Makefile\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -c \"cat cores/bench/test/conftest.py; sed -n '1,170p' cores/bench/test/_helpers.py; rg -n 'test:|pytest|formal:|cosim|coremark|timing' Makefile\"","aggregated_output":"\"\"\"pytest configuration for cocotb unit tests.\n\nAdds this directory to sys.path so test_*.py modules can `import _helpers`\nduring pytest collection. Cocotb sets PYTHONPATH separately for the\nsimulator-side import.\n\"\"\"\nimport sys\nfrom pathlib import Path\n\n_HERE = Path(__file__).resolve().parent\nif str(_HERE) not in sys.path:\n    sys.path.insert(0, str(_HERE))\n\"\"\"Shared cocotb constants and runner helpers for unit tests.\n\nConstants mirror rtl/core_pkg.sv. If a localparam there changes, change\nthe matching value here.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\n# cocotb 2.x moved the runner from cocotb.runner to cocotb_tools.runner.\nfrom cocotb_tools.runner import get_runner\n\n# ── ALU encodings (rtl/core_pkg.sv) ────────────────────────────────────────\nALU_ADD    = 0\nALU_SUB    = 1\nALU_AND    = 2\nALU_OR     = 3\nALU_XOR    = 4\nALU_SLT    = 5\nALU_SLTU   = 6\nALU_SLL    = 7\nALU_SRL    = 8\nALU_SRA    = 9\nALU_LUI    = 10\nALU_MUL    = 11\nALU_MULH   = 12\nALU_MULHU  = 13\nALU_MULHSU = 14\nALU_DIV    = 15\nALU_DIVU   = 16\nALU_REM    = 17\nALU_REMU   = 18\n\n# ── BranchOp encodings (= funct3 of BRANCH opcode) ─────────────────────────\nBR_BEQ  = 0\nBR_BNE  = 1\nBR_BLT  = 4\nBR_BGE  = 5\nBR_BLTU = 6\nBR_BGEU = 7\n\n# ── Paths ──────────────────────────────────────────────────────────────────\nREPO_ROOT = Path(__file__).resolve().parent.parent\nRTL       = REPO_ROOT / \"rtl\"\nTEST_DIR  = REPO_ROOT / \"test\"\nSIM_BUILD = REPO_ROOT / \"sim_build\"\n\n\ndef run_cocotb(toplevel: str, sources: list[str], test_module: str) -> None:\n    \"\"\"Build the DUT under Verilator and run the given cocotb test_module.\n\n    `sources` is a list of bare filenames under rtl/. Order matters —\n    package files (e.g. core_pkg.sv) come first.\n    \"\"\"\n    sim = os.environ.get(\"SIM\", \"verilator\")\n    runner = get_runner(sim)\n    build_dir = SIM_BUILD / toplevel\n\n    runner.build(\n        sources=[str(RTL / s) for s in sources],\n        hdl_toplevel=toplevel,\n        build_dir=str(build_dir),\n        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n1:.PHONY: help lint test test-infra cosim formal fpga timing next loop report bench clean\n42:  ORCH_FLAGS += --coremark-target $(COREMARK)\n53:CORE_TARGETS := lint test cosim cosim-build formal formal-deep fpga next loop\n79:\t@echo \"  make cosim TARGET=v1    — RVFI cosim against Python ISS\"\n83:\t@echo \"  make timing TARGET=v1   — Gowin Fmax and worst paths (placement option 0)\"\n84:\t@echo \"  make bench              — build selftest + coremark ELFs\"\n106:test:\n107:\tpytest -v $(TEST_DIR)/\n110:\tpytest -v tools/\n112:cosim: cosim-build bench/programs/selftest.elf bench/programs/coremark.elf\n113:\tpython3 -m tools.eval.cosim . $(TARGET)\n115:cosim-build: $(wildcard $(RTL_DIR)/*.sv) test/cosim/main.cpp\n116:\tbash test/cosim/build.sh\n121:formal:\n135:# FPGA timing and area come from the vendor flow, Gowin EDA\n137:fpga: cosim-build bench/programs/coremark.elf\n140:timing:\n143:bench/programs/coremark.elf: bench/programs/Makefile bench/programs/crt0.S \\\n144:                              $(wildcard bench/programs/coremark/*.c) \\\n145:                              $(wildcard bench/programs/coremark/*.h) \\\n146:                              $(wildcard bench/programs/coremark/baremetal/*.c) \\\n147:                              $(wildcard bench/programs/coremark/baremetal/*.h)\n148:\t$(MAKE) -f bench/programs/Makefile bench/programs/coremark.elf\n178:\trm -rf test/cosim/sim_build sim_build out\n","exit_code":0,"status":"completed"}}
