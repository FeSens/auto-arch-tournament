{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys, collections, json, time\nsys.path.insert(0, 'test/cosim')\nfrom reference import RV32IM\nm=RV32IM(); m.load_elf('bench/programs/coremark.elf')\ncounts=collections.Counter(); pcs=collections.Counter(); ras=[]; active=False; start=time.time(); branches=[]; transfers=[]\nfor i in range(12000000):\n r=m.step()\n if r is None: raise RuntimeError('Unsupported instruction')\n ins=r['insn']; op=ins&127; rd=(ins>>7)&31; rs1=(ins>>15)&31\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True\n if r['mem_wmask'] and r['mem_addr']==0x10000104: active=False; break\n if active:\n  counts['instructions']+=1\n  if op==0x63:\n   counts['branch']+=1\n   branches.append([r['pc'],ins,r['npc']])\n  if op==0x6f: counts['jal']+=1\n  if op==0x67:\n   counts['jalr']+=1; pcs[(r['pc'],ins)]+=1\n   if rd==0 and rs1 in (1,5) and ins>>20==0:\n    counts['canonical_ret']+=1\n    if ras and ras[-1]==r['npc']: counts['ras_correct']+=1\n  if op in (0x63,0x67,0x6f): transfers.append([r['pc'],ins,r['npc']])\n if op==0x6f and rd in (1,5): ras.append((r['pc']+4)&0xffffffff)\n if op==0x67:\n  if rs1 in (1,5) and (rd not in (1,5) or rd\"'!=rs1):\n   if ras: ras.pop()\n  if rd in (1,5): ras.append((r['\"'pc']+4)&0xffffffff)\n if ins==0x00100073: break\nprint('seconds',time.time()-start, 'counts',json.dumps(counts), flush=True)\nprint('jalr PCs',[(hex(p),hex(ins),n) for (p,ins),n in pcs.most_common()], flush=True)\nfrom pathlib import Path\np=Path('/srv/hwebench/tmp/84625fbe/2e4a0e74/predictor_profile.json'); p.write_text(json.dumps({'counts':counts,'branches':branches,'transfers':transfers}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
