{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, subprocess\nfrom tools.eval.fpga import validate_coremark_uart\nresult = subprocess.run(['cores/bench/obj_dir/cosim_sim', 'bench/programs/coremark.elf', '50000000', '--bench', '--istall', '--dstall', '--seed', '1'], capture_output=True, text=True, timeout=600)\nassert result.returncode == 0, result.stderr\nmarker = json.loads(result.stdout.splitlines()[-1])\nassert marker['ebreak'] and not marker['oob'] and marker['bench_bracketed'], marker\nvalid, reason = validate_coremark_uart(marker['uart'], 10)\nassert valid, reason\ncycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\nassert cycles > 0\nprint(json.dumps({'seed': 1, 'passed': True, 'cycles': cycles, 'marker': marker}, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
