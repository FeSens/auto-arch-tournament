{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport sys,pickle,time\nsys.path.insert(0,'test/cosim')\nfrom reference import RV32IM\ncpu=RV32IM(); cpu.load_elf('/srv/hwebench/tmp/84625fbe/5e85a304/predictor_coremark.elf')\ntrace=[]; active=False; counted=0; begin=time.time()\nfor i in range(6000000):\n r=cpu.step()\n if r is None: raise RuntimeError('unsupported')\n if r['mem_wmask'] and r['mem_addr']==0x10000100: active=True; counted=0\n if active: counted+=1\n if r['insn']&127 in (0x63,0x6f,0x67): trace.append((r['pc'],r['insn'],r['npc'],active,i))\n if r['mem_wmask'] and r['mem_addr']==0x10000104: break\n if r['insn']==0x100073: break\npickle.dump((trace,counted),open('/srv/hwebench/tmp/84625fbe/5e85a304/predictor_trace.pkl','wb'))\nprint({'total_instructions':i+1,'marker_instructions':counted,'control_transfers':len(trace),'seconds':time.time()-begin,'oob':cpu.oob_access})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
