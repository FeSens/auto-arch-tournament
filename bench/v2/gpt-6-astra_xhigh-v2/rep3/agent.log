{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c \"python3 -u - <<'PY'\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor,as_completed\nfrom tools.eval.gowin import build\nimport shutil,json\nroot=Path('/srv/hwebench/tmp/84625fbe/2e4a0e74/predictor_tables');root.mkdir(exist_ok=True)\nvariants=['baseline','agree8','agree32','agree64']\nfor variant in variants:\n d=root/variant/'rtl';d.mkdir(parents=True,exist_ok=True)\n for f in Path('cores/bench/rtl').glob('*.sv'):shutil.copy2(f,d/f.name)\n if variant=='baseline':continue\n n=int(variant[5:]);bits=(n-1).bit_length()\n for name in ['core.sv','ex_stage.sv','if_stage.sv']:\n  p=d/name;s=p.read_text();s=s.replace('[3:0]  train_index',f'[{bits-1}:0]  train_index').replace('[3:0]         train_index',f'[{bits-1}:0]         train_index').replace('[3:0]        train_index',f'[{bits-1}:0]        train_index');s=s.replace('pc[5:2]',f'pc[{bits+1}:2]')\n  if name=='if_stage.sv':\n   s=s.replace('[15:0] agree_msb_q',f'[{n-1}:0] agree_msb_q').replace(\\\"16'hffff\\\",f\\\"{n}'h\\\"+'f'*(n//4)).replace(\\\"16'h0000\\\",f\\\"{n}'h\\\"+'0'*(n//4))\n  p.write_text(s)\ndef run(v):\n p=root/v;r=build(Path.cwd(),p/'rtl','fpga/core_bench_si.sv',1,p/'gowin_p1');(p/'timing_result.json').write_text(json.dumps(r));return v,r\nwith ThreadPoolExecutor(max_workers=4) as ex:\n fs=[ex.submit(run,v) for v in variants]\n for f in as_completed(fs):\n  v,r=f.result();print(v,json.dumps(r),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
