eq_ready) multiple_q[k] <= multiple_d;\n    end\n  end\n'''\ns=s[:a]+block+s[b:];p.write_text(s)\n# Adapt internal-state tests to the new radix without removing vectors.\np=root/'test/test_alu.py';shutil.copyfile(p,root/'generated/r9_operand_backup/test_alu.py');s=p.read_text()\ns=s.replace('        prefix = magnitude_a >> 28\\\\n        q4, r4 = divmod(prefix, magnitude_b) if magnitude_b else (0, prefix)\\\\n        assert int(dut.quotient_q.value) == ((magnitude_a << 4) & MASK32) | q4\\\\n        assert int(dut.remainder_q.value) == r4', '        assert int(dut.quotient_q.value) == magnitude_a\\\\n        assert int(dut.remainder_q.value) == 0')\ns=s.replace('        model_q = ((magnitude_a << 4) & MASK32) | q4\\\\n        model_r = r4','        model_q = magnitude_a\\\\n        model_r = 0')\ns=s.replace('divmod((model_r << 4) | (model_q >> 28), magnitude_b)', 'divmod((model_r << 5) | (model_q >> 30), magnitude_b)').replace('assert 0 <= digit <= 15', 'assert 0 <= digit <= 31').replace('((model_q << 4) & MASK32) | digit','((model_q << 5) & ((1 << 35) - 1)) | digit')\na=s.index('async def div_radix16_recurrence_invariant');b=s.index('@cocotb.test()',a)\nchunk=s[a:b].replace('radix16','radix32').replace('36-bit','37-bit').replace('range(1, 16)','range(1, 32)').replace('16 *','32 *').replace('range(16)','range(32)').replace('rng.randrange(16)','rng.randrange(32)').replace('trial >> 4','trial >> 5').replace('((trial & 15) << 28) | rng.getrandbits(28)','((trial & 31) << 30) | rng.getrandbits(30)').replace('(remainder << 4)','(remainder << 5)')\ns=s[:a]+chunk+s[b:];p.write_text(s)\nPY\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
