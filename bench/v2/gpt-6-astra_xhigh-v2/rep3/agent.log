{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/test/test_alu.py')\np.write_text(p.read_text()+'''\n\n@cocotb.test()\nasync def probe_independent_operand_pairs(dut):\n    await _setup(dut)\n    for op, expected in ((ALU_ADD, 16), (ALU_SUB, 10), (ALU_AND, 1),\n                         (ALU_OR, 15), (ALU_XOR, 14), (ALU_SLT, 0),\n                         (ALU_SLTU, 0), (ALU_SLL, 104), (ALU_SRL, 1),\n                         (ALU_SRA, 1), (ALU_LUI, 3)):\n        await _check(dut, op, 13, 3, expected)\n        dut.m_a.value, dut.m_b.value = 0x89abcdef, 0x87654321\n        await Timer(1, \\\"ns\\\")\n        assert int(dut.out.value) == expected\n    for a, b in ((0xffffffff, 7), (0x80000000, 0xffffffff),\n                 (0x80000000, 0x80000000), (0xdeadbeef, 0x12345678)):\n        sa = a - (1 << 32) if a >> 31 else a\n        sb = b - (1 << 32) if b >> 31 else b\n        for op, expected in ((ALU_MUL, a*b), (ALU_MULHU, (a*b)>>32),\n                             (ALU_MULH, (sa*sb)>>32), (ALU_MULHSU, (sa*b)>>32)):\n            await _check(dut, op, a, b, expected)\n            dut.a.value, dut.b.value = 0x1234, 0x5678\n            await Timer(1, \\\"ns\\\")\n            assert int(dut.out.value) == expected & MASK32\n    for op in (ALU_DIV, ALU_DIVU, ALU_REM, ALU_REMU):\n        for a, b in ((0x80000000, 0xffffffff), (0xfffffff9, 3),\n                     (0x12345678, 0), (0x76543210, 15)):\n            dut.a.value, dut.b.value = 0x11223344, 0x55667788\n            await _check_div(dut, op, a, b, _division_reference(op,a,b),\n                             hold=3, check_state=True)\n''')\np=Path('cores/bench/test/test_alu_altops.py')\np.write_text(p.read_text()+'''\n\n@cocotb.test()\nasync def probe_altops_independent_operand_pairs(dut):\n    from _helpers import ALU_MUL, ALU_MULH, ALU_MULHU, ALU_MULHSU\n    await _setup(dut)\n    dut.a.value, dut.b.value = 0x11223344, 0x55667788\n    a, b = 0xdeadbeef, 0x12345678\n    dut.m_a.value, dut.m_b.value = a, b\n    for op, mask, sub in ((ALU_MUL, 0x5876063e, False),\n                          (ALU_MULH, 0xf6583fb7, False),\n                          (ALU_MULHU, 0x949ce5e8, False),\n                          (ALU_MULHSU, 0xecfbe137, True)):\n        dut.op.value = op\n        await Timer(1, \\\"ns\\\")\n        expected = (((a-b) if sub else (a+b)) \"'^ mask) & 0xffffffff\n        assert int(dut.out.value) == expected\n'\"''')\nPY\npython3 -m pytest -q cores/bench/test/test_alu.py cores/bench/test/test_alu_altops.py > /srv/hwebench/tmp/84625fbe/5725a514/r7s0-isolation-tests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
