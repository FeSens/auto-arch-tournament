{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport json, os, subprocess\nfrom pathlib import Path\nfrom tools.eval.fpga import validate_coremark_uart, parse_iterations\nsim = Path('cores/bench/obj_dir/cosim_sim').resolve()\nelf = Path('bench/programs/coremark.elf').resolve()\niterations = parse_iterations('.')\nfor seed in (0xdeadbeef, 1):\n    result = subprocess.run([str(sim), str(elf), '50000000', '--bench', '--istall', '--dstall', '--seed', str(seed)], capture_output=True, text=True, check=True, timeout=600)\n    marker = json.loads(result.stdout.splitlines()[-1])\n    valid, reason = validate_coremark_uart(marker.get('uart', ''), iterations)\n    assert marker['ebreak'] and not marker['oob'] and marker['bench_bracketed'], marker\n    assert valid, reason\n    cycles = marker['bench_stop_cycle'] - marker['bench_start_cycle']\n    assert cycles > 0\n    Path(os.environ['TMPDIR'], f'coremark-{seed}.json').write_text(json.dumps(marker, indent=2))\n    print(json.dumps({'seed': hex(seed), 'passed': True, 'cycles': cycles, 'iterations': iterations, 'start': marker['bench_start_cycle'], 'stop': marker['bench_stop_cycle'], 'crc_uart_bounds_markers': 'pass'}), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
