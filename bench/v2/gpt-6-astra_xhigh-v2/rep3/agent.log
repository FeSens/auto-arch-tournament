n srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[12572 of 15644 chars elided by tools/bench/transcript.py; sha256:45c6ce86576b3ace]…\n 0, 2, 4, 12, 64))\n        insn = (BEQ(1, 2, offset) if kind == 0 else\n                JAL(3, offset) if kind == 1 else\n                _b(offset, 1, 2, 2, 0x63) if kind == 2 else\n                rng.getrandbits(32))\n        await step(ready=int(rng.random() >= .22), hold=int(rng.random() < .5),\n                   insn=insn, redirect=int(rng.random() < .06),\n                   target=4 * rng.randrange(256), reset=int(rng.random() < .015),\n                   train=int(rng.random() < .5), index=rng.randrange(16),\n                   agree=rng.randrange(2))\n    while queue:\n        await step(ready=0)\n    assert occupancies == resets == set(range(5))\n    assert redirects == {(n, r) for n in range(5) for r in (0, 1)}\n    assert simultaneous == {1, 2, 3}\n    assert min(bypasses, held_accepts, stalled_issues, full_holds) > 0\n    assert accepted == consumed + discarded\n\n\ndef test_if_stage_runner():\n    run_cocotb(toplevel=\"if_stage\", sources=[\"core_pkg.sv\", \"if_stage.sv\"],\n               test_module=\"test_if_stage\")\n", "exit_code": 0, "status": "completed"}}
