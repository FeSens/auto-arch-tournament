{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nbase=Path('/srv/hwebench/tmp/84625fbe/b372f1f5/r8-lutprefix-probe')\np=base.parent/'r8-dualprefix-probe';p.mkdir(exist_ok=True)\nshutil.copytree(base/'rtl',p/'rtl',dirs_exist_ok=True)\nf=p/'rtl/alu.sv';s=f.read_text();a=s.index('  logic negate_a, negate_b;');b=s.index('  logic [35:0] divisor_wide;',a)\ns=s[:a]+'''  logic [3:0] raw_n, signed_n, signed_d;\n  logic signed_small, unsigned_small;\n  logic [7:0] prefix_pair;\n  logic [3:0] initial_remainder;\n'''+s[b:]\na=s.index('  assign negate_a =');b=s.index('  // Every multiple comes',a)\nt='''  assign raw_n = m_a[31:28];\n  assign signed_n = m_a[31] ? (~m_a[31:28] + {3'b0,(m_a[27:0] == 28'b0)}) : m_a[31:28];\n  assign signed_d = m_b[31] ? (4'b0 - m_b[3:0]) : m_b[3:0];\n  assign unsigned_small = (m_b[3:0] \"'!= 4'\"'b0) && (m_b[31:4] == 28'b0);\n  assign signed_small = (m_b[3:0] \"'!= 4'\"'b0) &&\n      (m_b[31] ? (m_b[31:4] == 28'hfffffff) : (m_b[31:4] == 28'b0));\n  logic [7:0] prefix_value [0:1];\n  for (genvar mode=0; mode<2; mode++) begin : launch_prefix\n    logic [3:0] n, d;\n    logic [7:0] masked [0:15];\n    assign n = mode == 0 ? raw_n : signed_n;\n    assign d = mode == 0 ? m_b[3:0] : signed_d;\n'''\nfor d in range(16):\n t+=f'    begin : d{d}\\\\n      logic [7:0] value;\\\\n'\n for bit in range(8):\n  mask=sum((((((n%d)*16+n//d) if d else n*16)>>bit)&1)<<n for n in range(16))\n  t+=f\\\"      localparam logic [15:0] BIT{bit} = 16'h{mask:04x};\\\\n      assign value[{bit}] = BIT{bit}[n];\\\\n\\\"\n t+=f\\\"      assign masked[{d}] = {{8{{d == 4'd{d}}}}} & value;\\\\n    end\\\\n\\\"\nt+='    assign prefix_value[mode] = '+' | '.join(f'masked[{d}]' for d in range(16))+';\\\\n  end\\\\n'\nt+='''  wire [7:0] unsigned_pair = unsigned_small ? prefix_value[0] : {raw_n,4'b0};\n  wire [7:0] signed_pair = signed_small ? prefix_value[1] : {signed_n,4'b0};\n  assign prefix_pair = signed_op ? signed_pair : unsigned_pair;\n\n'''\ns=s[:a]+t+s[b:]\ns=s.replace(\\\"small_divisor ? prefix_pair[3:0] : 4'b0\\\",'prefix_pair[3:0]')\ns=s.replace('small_divisor ? prefix_pair[7:4]\\\\n                                           : leading_nibble','prefix_pair[7:4]')\ns=s.replace('  logic small_divisor;\\\\n','').replace('  logic [3:0] initial_remainder;\\\\n','')\nf.write_text(s);print(p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
