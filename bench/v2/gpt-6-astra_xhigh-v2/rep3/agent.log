{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom itertools import product\ncount=0\nfor valid, kind, rd_nonzero, src_match, iready, dready, mem_valid, mem_ctrl, divide_done in product((False,True), ('alu','load','branch','divide'), *[(False,True)]*7):\n    redirect=valid and kind=='branch'\n    wait=valid and kind=='divide' and not divide_done\n    mem_stall=not dready and mem_valid and mem_ctrl\n    old_fetch_mask=redirect or not iready\n    old_match=src_match and not old_fetch_mask\n    old_load_hazard=valid and kind=='load' and rd_nonzero and old_match\n    new_load_hazard=valid and kind=='load' and rd_nonzero and src_match and iready\n    old_hold=mem_stall or wait or old_load_hazard\n    old_flush=(old_load_hazard or redirect) and not mem_stall and not wait\n    old_id_valid=False if old_flush else valid if old_hold else not old_fetch_mask\n    new_id_valid=valid if mem_stall or wait else False if redirect or new_load_hazard else iready\n    old_pc_update='redirect' if redirect else 'hold' if old_load_hazard or not iready or mem_stall or wait else 'increment'\n    new_pc_update='redirect' if redirect else 'hold' if new_load_hazard or not iready or mem_stall or wait else 'increment'\n    assert old_load_hazard==new_load_hazard\n    assert old_id_valid==new_id_valid\n    assert old_pc_update==new_pc_update\n    count+=1\nprint(f'Abstract frontend transition check: {count} combinations passed; PC action and ID/EX validity match.')\nprint('Scope: disjoint legal instruction classes and arbitrary availability/hold controls; not RTL or timing verification.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
