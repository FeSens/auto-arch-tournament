        always=True,\n        build_args=[\"-Wall\", \"-Wno-fatal\", \"-Wno-style\"],\n    )\n    runner.test(\n        hdl_toplevel=toplevel,\n        test_module=test_module,\n        test_dir=str(TEST_DIR),\n        build_dir=str(build_dir),\n    )\n\"\"\"Host-wide slots for the harness's heavy evals (formal, Gowin builds).\n\nThree concurrent runs, each evaluating up to three slots, plus the agents'\nown self-checks, saturated the 2\n…[6654 of 9726 chars elided by tools/bench/transcript.py; sha256:3dd7ed3604e5f76a]…\n= accept and (bool(queue) or not consume)\n        t.update(accept=accept and not recover, pop=pop and not recover,\n                 push=push and not recover, consume=consume and not recover)\n        next_pc = t[\"pc\"]\n        if recover:\n            next_pc = t[\"target\"]\n            queue.clear()\n        else:\n            if pop:\n                queue.pop(0)\n            if push:\n                queue.append(raw)\n            if accept:\n                next_pc = target if predicted else (t[\"pc\"] + 4) & 0xffffffff\n        previous = t, next_pc, selected\n        if train:\n            index = (ex_pc >> 2) & 15\n            agrees = taken == bool(ex_insn >> 31)\n            assert (t[\"index\"], t[\"agree\"]) == (index, agrees), t\n            counters[index] = min(3, counters[index] + 1) if agrees else max(0, counters[index] - 1)\n\n\n@cocotb.test()\nasync def agree_warmup_reversal_and_bubble_free_loop(dut):\n    program = [ADDI(1, 0, 0), ADDI(2, 0, 3), BEQ(3, 0, 12),\n               ADDI(4, 0, 77), JAL(0, 28), ADDI(1, 1, 1),\n", "exit_code": 0, "status": "completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/84625fbe/c47585f8/predictor_thermometer')\nroot.mkdir(exist_ok=True)\nfor d in ('rtl','test'):\n shutil.copytree(Path('cores/bench')/d,root/d,dirs_exist_ok=True)\np=root/'rtl/if_stage.sv'\ns=p.read_text().replace('logic [15:0] agree_msb_q, agree_lsb_q;\\\\n  logic [1:0] train_counter, train_next;', 'logic [15:0] agree_msb_q, agree_low_q, agree_high_q;')\na=s.index('  // Two bitplanes hold sixteen saturating agree counters.')\nb=s.index('  // Raw predecode',a)\ns=s[:a]+'''  // Four thermometer states 000/001/011/111 encode the original 0/1/2/3.\n  // The middle bit is the original prediction MSB; all updates are local.\n  for (genvar entry = 0; entry < 16; entry++) begin : agree_entry\n    always_ff @(posedge clock) begin\n      if (reset) begin\n        agree_low_q[entry] <= 1'b1;\n        agree_msb_q[entry] <= 1'b1;\n        agree_high_q[entry] <= 1'b0;\n      end else if (train_valid && train_index == entry[3:0]) begin\n        agree_low_q[entry] <= train_agree | agree_msb_q[entry];\n        agree_msb_q[entry] <= train_agree ? agree_low_q[entry] : agree_high_q[entry];\n        agree_high_q[entry] <= train_agree & agree_msb_q[entry];\n      end\n    end\n  end\n\n'''+s[b:]\np.write_text(s)\nfor name,prefix in [('test_if_stage.py','dut'),('test_pipeline.py','dut.u_if')]:\n p=root/'test'/name\n s=p.read_text().replace(f'int({prefix}.agree_lsb_q.value)',f'(int({prefix}.agree_low_q.value) \"'^ int({prefix}.agree_msb_q.value) ''^ int({prefix}.agree_high_q.value))'\"')\n p.write_text(s)\nprint(root)\n# Exhaustive equivalence of the local state transition.\nenc=[0,1,3,7]\nfor state in range(4):\n for agree in (0,1):\n  old=enc[state]\n  new=((old<<1)|1)&7 if agree else old>>1\n  expected=min(3,state+1) if agree else max(0,state-1)\n  assert new==enc[expected]\n  assert (old>>1)&1==state>>1\nprint('All eight transitions and all four prediction mappings agree.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
