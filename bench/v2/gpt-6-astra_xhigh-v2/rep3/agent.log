t\t\tfor (channel_idx = 0; channel_idx < `RISCV_FORMAL_NRET; channel_idx=channel_idx+1) begin\n\t\t\t\tif (rvfi_valid[channel_idx] && rvfi_order[64*channel_idx +: 64] == insn_order+1) begin\n\t\t\t\t\tfound_next_insn = 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (trig) begin\n\t\t\t\tassume(rvfi_valid[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(!rvfi_halt[`RISCV_FORMAL_CHANNEL_IDX]);\n\t\t\t\tassume(insn_order == rvfi_order[64*`RISCV_FORMAL_CHANNEL_IDX +: 64]);\n\t\t\tend\n\t\t\tif (check) begin\n\t\t\t\tassert(found_next_insn);\n\t\t\tend\n\t\tend\n\tend\nendmodule\n[options]\nisa rv32im\nnret 1\nsolver bitwuzla\n\n[depth]\n# BMC depth per check. 2nd column (where present) is the k-induction prove\n# depth. Keep depths matched to the current pipeline so bugs within ~20\n# cycles of any symbolic instruction stream are exposed.\ninsn          20\nreg       10  20\npc_fwd    10  20\npc_bwd    10  20\ncausal    10  20\n# unique   — no two retirements share rvfi_order (catches double-retire)\n# cover    — sanity that the CPU retires (prevents vacuous-pass suites)\n# ill      — illegal instructions must trap; rvfi_trap from decoder.is_illegal\n# liveness — CPU makes forward progress under any symbolic stream\nunique     1 10 20\ncover      1    20\nill             20\nliveness   1 10 20\n\n[defines]\n`define RISCV_FORMAL_ALIGNED_MEM\n# RISCV_FORMAL_ALTOPS — fast mode. Same as checks.cfg. See checks.cfg for\n# the full rationale on what ALTOPS does and does not prove. M-extension\n# arithmetic correctness is covered by test/test_alu.py and `make formal-deep`.\n`define RISCV_FORMAL_ALTOPS\n\n[cover]\n# Sanity cover: the CPU must retire at least one non-trapping instruction.\nalways @* if (!reset) cover (rvfi_valid && !rvfi_trap);\n\n[verilog-files]\n# run_all.sh rebuilds this section from the actual rtl/ glob; the list\n# below is overwritten before genchecks runs. Kept as a placeholder so\n# the section is syntactically present for any reader inspecting the cfg.\n@basedir@/cores/@core@/core.sv\n@basedir@/cores/@core@/wrapper.sv\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport re,json\nfrom tools.eval.gowin import build_all\nbase=Path('cores/bench');g=base/'generated/r10_operand_probe';variant=g/'predecode/rtl';variant.mkdir(parents=True,exist_ok=True)\nfor p in (base/'rtl').glob('*.sv'):\n src=g/'original'/p.name\n (variant/p.name).write_bytes((src if src.exists() else p).read_bytes())\np=variant/'core_pkg.sv';s=p.read_text().replace('    logic [4:0] alu_op;', '    logic [4:0] alu_op;\\\\n    logic [14:0] alu_select;\\\\n    logic divide_signed;\\\\n    logic divide_remainder;');p.write_text(s)\np=variant/'id_stage.sv';s=p.read_text().replace('    ctrl_decoded.alu_op     = dec_alu_op;', '''    ctrl_decoded.alu_op     = dec_alu_op;\n    ctrl_decoded.alu_select = 15'b1 << dec_alu_op;\n    ctrl_decoded.divide_signed = dec_alu_op == ALU_DIV || dec_alu_op == ALU_REM;\n    ctrl_decoded.divide_remainder = dec_alu_op == ALU_REM || dec_alu_op == ALU_REMU;''');p.write_text(s)\np=variant/'ex_stage.sv';s=p.read_text().replace('    .op  (in.ctrl.alu_op),', '''    .op  (in.ctrl.alu_op),\n    .op_select (in.ctrl.alu_select),\n    .divide_signed (in.ctrl.divide_signed),\n    .divide_remainder (in.ctrl.divide_remainder),''');p.write_text(s)\np=variant/'alu.sv';s=p.read_text().replace('  input  logic [4:0]  op,','  input  logic [4:0]  op,\\\\n  input logic [14:0] op_select,\\\\n  input logic divide_signed, divide_remainder,');s=s.replace('    case (op)\\\\n      ALU_ADD:',\\\"    out = 32'b0;\\\\n    case (1'b1)\\\\n      op_select[ALU_ADD]:\\\",1)\nstart=s.index(\\\"    case (1'b1)\\\");end=s.index('  logic busy_q',start)\nchunk=s[start:end];chunk=re.sub(r'      (ALU_[A-Z0-9]+):',r'      op_select[\\\\1]:',chunk)\ns=s[:start]+chunk+s[end:];s=s.replace('assign signed_op = (op == ALU_DIV || op == ALU_REM);','assign signed_op = divide_signed;').replace('want_remainder_q <= (op == ALU_REM || op == ALU_REMU);','want_remainder_q <= divide_remainder;');p.write_text(s)\nr=build_all(Path('.'),variant,'fpga/core_bench_si.sv',g/'predecode/timing',options=(0,));(g/'predecode/results.json').write_text(json.dumps(r,indent=2));print(json.dumps(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
