cpu/u_ex\",\n        \"cpu/u_ex/u_alu\",\n        \"cpu/u_ex\",\n        \"cpu/u_id\"\n      ]\n    },\n    {\n      \"from\": \"cpu/u_id/reg_q.pc_3_s0\",\n      \"to\": \"cpu/u_ex/u_alu/mul_uu_63_s0\",\n      \"slack_ns\": -8.643,\n      \"arrival_ns\": 18.717,\n      \"logic_cells\": 34,\n      \"modules\": [\n        \"clock_ibuf\",\n        \"cpu/u_ex\",\n        \"cpu/u_ex/u_alu\",\n        \"cpu/u_ex\",\n        \"cpu/u_id\"\n      ]\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
