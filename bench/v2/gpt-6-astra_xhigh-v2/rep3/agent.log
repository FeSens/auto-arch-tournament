{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\nimport shutil\nroot=Path('/srv/hwebench/tmp/84625fbe/dd8a7533/auipc_probe')\nroot.mkdir(parents=True, exist_ok=True)\nrtl=root/'rtl'\nshutil.copytree('cores/bench/rtl',rtl,dirs_exist_ok=True)\ndef change(name, old, new):\n p=rtl/name\n s=p.read_text()\n assert old in s,(name,old)\n p.write_text(s.replace(old,new))\nchange('core_pkg.sv', '  // ── Branch operations', \\\"  localparam logic [4:0] ALU_AUIPC = 5'd19;\\\\n\\\\n  // ── Branch operations\\\")\nchange('decoder.sv', \\\"        is_auipc   = 1'b1;\\\", \\\"        is_auipc   = 1'b1;\\\\n        alu_op     = ALU_AUIPC;\\\")\nchange('ex_stage.sv', 'alu_a = in.ctrl.is_auipc ? in.pc  : rs1;', 'alu_a = rs1;')\nchange('ex_stage.sv', '    .b   (alu_b),', '    .b   (alu_b),\\\\n    .pc_relative_result (branch_target),')\nchange('alu.sv', '  input  logic [31:0] b,', '  input  logic [31:0] b,\\\\n  input  logic [31:0] pc_relative_result,')\nchange('alu.sv', '      ALU_LUI:    out = b;', '      ALU_LUI:    out = b;\\\\n      ALU_AUIPC:  out = pc_relative_result;')\nprint(root)\nPY\npython -u - <<'PY'\nfrom tools.eval import gowin\nfrom pathlib import Path\nimport json\nroot=Path('/srv/hwebench/tmp/84625fbe/dd8a7533/auipc_probe')\nresults=gowin.build_all(Path.cwd(),root/'rtl','fpga/core_bench_si.sv',root/'timing')\n(root/'timing.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(gowin.summarize(results),indent=2), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
