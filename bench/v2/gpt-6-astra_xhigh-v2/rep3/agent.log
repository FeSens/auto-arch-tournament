_setup(dut)\n    for op,mask in ((ALU_MUL,0x5876063e),(ALU_MULH,0xf6583fb7),(ALU_MULHU,0x949ce5e8),(ALU_MULHSU,0xecfbe137)):\n        for a,b in ((0,0),(0xffffffff,0x80000000),(0x12345678,0x87654321)):\n            expected=((a-b) if op==ALU_MULHSU else (a+b)) \"'^ mask\n            await _check_mul(dut,op,a,b,expected,hold=6)\n'\"'''\np.write_text(s)\nPY\"", "aggregated_output": "", "exit_code": 0, "status": "completed"}}
