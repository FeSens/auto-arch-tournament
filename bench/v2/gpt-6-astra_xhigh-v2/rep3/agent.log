{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\nfrom pathlib import Path\np=Path('cores/bench/rtl/if_stage.sv')\ns=p.read_text()\nPath('/srv/hwebench/tmp/84625fbe/186fdfda/headtail_binary.sv').write_text(s)\ns=s.replace('logic [1:0] tail_read_q, tail_write_q;', 'logic [2:0] tail_read_q, tail_write_q;\\\\n  logic [\"'$bits(raw_fetch)-1:0] tail_head;'\"')\ns=s.replace('  // Decode consumes one dedicated head register.', '''  assign tail_head = ({\"'$bits(raw_fetch){tail_read_q[0]}} & tail_q[0]) |\n                     ({$bits(raw_fetch){tail_read_q[1]}} & tail_q[1]) |\n                     ({$bits(raw_fetch){tail_read_q[2]}} & tail_q[2]);\n  for (genvar i = 0; i < 3; i++) begin : tail_entry\n    always_ff @(posedge clock)\n      if (tail_push && tail_write_q[i]) tail_q[i] <= raw_fetch;\n  end\n\n  // Decode consumes one dedicated head register.'\"''')\ns=s.replace('head_q <= tail_q[tail_read_q];','head_q <= tail_head;')\ns=s.replace('    if (tail_push) tail_q[tail_write_q] <= raw_fetch;\\\\n','')\ns=s.replace(\\\"tail_read_q <= 2'b0;\\\", \\\"tail_read_q <= 3'b001;\\\").replace(\\\"tail_write_q <= 2'b0;\\\", \\\"tail_write_q <= 3'b001;\\\")\ns=s.replace(\\\"tail_read_q <= tail_read_q == 2'd2 ? 2'd0 : tail_read_q + 2'd1;\\\", \\\"tail_read_q <= {tail_read_q[1:0], tail_read_q[2]};\\\")\ns=s.replace(\\\"tail_write_q <= tail_write_q == 2'd2 ? 2'd0 : tail_write_q + 2'd1;\\\", \\\"tail_write_q <= {tail_write_q[1:0], tail_write_q[2]};\\\")\np.write_text(s)\nPY\nmake lint TARGET=bench\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
