(5, \"ns\")\n        if predictor_trace is not None:\n            assert not int(dut.train_valid.value) and not int(dut.redirect.value)\n        dut.clock.value = 1\n        await Timer(5, \"ns\")\n        dut.clock.value = 0\n\n    # Deassert reset and prime the imem read for the first PC=0 fetch.\n    dut.reset.value = 0\n    for cycle in range(max_cycles):\n        dut.clock.value = 0\n        if cycle == reset_at:\n            if predictor_trace:\n\n…[20219 of 23291 chars elided by tools/bench/transcript.py; sha256:651e2a443de1376b]…\n trace if t[\"redirect\"]]\n                assert sync[\"target\"] == 12 and sync[\"ready\"] == release_ready\n                assert sync[\"cycle\"] == effects[1][0] and not sync[\"train\"]\n                if delay:\n                    assert sync[\"count\"] == 4\n                    assert (sync[\"if_id\"] >> 2) & 0xffffffff == program[3]\n                    assert all(not t[\"redirect\"] for t in trace if t[\"stall\"])\n\n    # Ordinary FENCE keeps its existing no-op retirement/issue timing.\n    program = [ADDI(1, 0, 42), SW(1, 0, 0x100), 0x0ff0000f,\n               ADD(2, 1, 1), EBREAK()]\n    trace = []\n    rets, memory = await _run(dut, program, predictor_trace=trace)\n    assert memory == _check_div_program(rets, program, list(range(0, 20, 4)))\n    assert not any(t[\"redirect\"] for t in trace)\n    assert all(b[\"cycle\"] == a[\"cycle\"] + 1 for a, b in zip(rets, rets[1:]))\n\n\n@cocotb.test()\nasync def registered_products_all_kinds_and_dependencies(dut):\n    \"\"\"Every product kind crosses MEM with exact operands and one use bubble.\"\"\"\n", "exit_code": 0, "status": "completed"}}
