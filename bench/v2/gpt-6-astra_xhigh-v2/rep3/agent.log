{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -c \"RTL_DIR=cores/bench/generated/bypass_probe/rtl OBJ_DIR=cores/bench/generated/bypass_probe/obj NRET=1 bash test/cosim/build.sh > cores/bench/generated/bypass_probe/cosim_build.log 2>&1\npython3 - <<'PY'\nfrom pathlib import Path\nfrom tools.eval.cosim import run_one,run_coremark_crc\nfrom concurrent.futures import ThreadPoolExecutor\nimport json, subprocess\np=Path('cores/bench/generated/bypass_probe'); b=str((p/'obj/cosim_sim').resolve());root=Path('/srv/hwebench/clones/gpt-6-astra_xhigh-v2-rep3')\ntasks=[(root/'bench/programs'/f,fl) for f in ['selftest.elf','random1.elf','random2.elf','random3.elf'] for fl in [(),('--istall','--dstall')]]\nwith ThreadPoolExecutor(max_workers=4) as pool:\n for result in pool.map(lambda x:run_one(x[0],b,'.',sim_flags=x[1]),tasks): print(json.dumps(result),flush=True)\nr=subprocess.run([b,str(root/'bench/programs/coremark.elf'),'50000000','--bench','--istall','--dstall'],capture_output=True,text=True)\n(p/'final_coremark.jsonl').write_text(r.stdout);d=json.loads(r.stdout.splitlines()[-1]);from tools.eval.fpga import validate_coremark_uart\nprint(json.dumps({'coremark_crc':validate_coremark_uart(d.get('uart',''),10),'cycles':d.get('bench_stop_cycle',0)-d.get('bench_start_cycle',0),'oob':d.get('oob'),'ebreak':d.get('ebreak')}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
