rtl_dir / \"core_pkg.sv\"\n    return ([pkg] if pkg in srcs else []) + [p for p in srcs if p != pkg]\n\n\ndef project_tcl(worktree: Path, rtl_dir: Path, bench_sv: str, place_option: int) -> str:\n    files = [*rtl_sources(rtl_dir), worktree / STALL_GEN, worktree / bench_sv,\n             worktree / CST, worktree / SDC]\n    return \"\\n\".join([\n        f\"set_device {PART} -device_version {DEVICE_VERSION}\",\n        *(f\"add_file {f}\" for f in fi\n…[22794 of 25866 chars elided by tools/bench/transcript.py; sha256:bd8453cc300957e2]…\n       _check_predictor_trace(trace)\n1201:        assert sum(t[\"train\"] for t in trace) == 1\n1223:                              predictor_trace=trace, effects=effects,\n1240:async def full_queue_branch_recovery_after_older_memory(dut):\n1242:        for load in (False, True):\n1244:                branch = BEQ(1, 0, -8) if backwards else BEQ(1, 1, 8)\n1246:                           LW(2, 0, 0x180) if load else SW(1, 0, 0x100), branch,\n1259:                    predictor_trace=trace, effects=effects, forbidden_stores=(0x1f0,),\n1266:                assert sum(t[\"train\"] for t in trace) == 1\n1267:                assert all(not t[\"redirect\"] and not t[\"train\"] for t in trace if t[\"stall\"])\n1268:                assert len(effects) == 1 and effects[0][1] == (0x180 if load else 0x100)\n1289:                    predictor_trace=trace, effects=effects, unified_memory=True,\n1299:                assert sync[\"cycle\"] == effects[1][0] and not sync[\"train\"]\n1309:    rets, memory = await _run(dut, program, predictor_trace=trace)\n", "exit_code": 0, "status": "completed"}}
